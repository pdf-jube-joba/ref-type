\module At(k: Degree);
\definition acyclic: ChainMaps.QuasiIsomorphism f -> Acyclic := \fun (quasi: ChainMaps.QuasiIsomorphism f)(z: Degree) =>
  \idelim previous (next z) = z \with k: Degree => \forall (q: \parent.\parent.\parent.At[C := complex, z := k].Homology) ->
    q = \parent.\parent.\parent.At[C := complex, z := k].zeroClass \by {
      base: At[k := next z].vanishing quasi, equality: previousNext z
    };
\definition quasiIsomorphism: Acyclic -> ChainMaps.QuasiIsomorphism f :=
  \fun (acyclic: Acyclic)(z: Degree) => \idelim previous (next z) = z
    \with k: Degree => ChainMaps.At[k := k].Bijective[f] \by {
      base: \idelim previous (next (next z)) = next z
        \with k: Degree => ChainMaps.At[k := previous k].Bijective[f] \by {
          base: At[k := next (next z)].bijective acyclic, equality: previousNext (next z)
        }, equality: previousNext z
    };
