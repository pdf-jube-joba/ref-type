\module Laws(k: Degree) {
  \import Modules.Laws[V := family.Carrier (previous k), space := family.space (previous k)] \as Target;
  \import algebra.Group[].Of[Carrier := family.Carrier (previous k), group := Target.additive] \as Group;
  \definition addition: \forall (x, y: family.Carrier k) ->
    #zero{(family.space (previous k))} = #add{(family.space (previous k))} #zero{(family.space (previous k))} #zero{(family.space (previous k))} :=
    \fun (x, y: family.Carrier k) => sym!{{family.Carrier (previous k)}} _ _ (Group.zeroLeft #zero{(family.space (previous k))});
  \definition scalar: \forall (a: R)(x: family.Carrier k) ->
    #zero{(family.space (previous k))} = #smul{(family.space (previous k))} a #zero{(family.space (previous k))} :=
    \fun (a: R)(x: family.Carrier k) => sym!{{family.Carrier (previous k)}} _ _ (Target.scaleZero a);
}
\definition differential: DifferentialData[family] := DifferentialData[family] {
  apply := \fun (k: Degree)(x: family.Carrier k) => #zero{(family.space (previous k))},
};
\definition complex: Complex := Complex {
  family := family, differential := differential,
  laws := DifferentialLaws[family, differential] {
    addition := \fun (k: Degree) => Laws[k := k].addition,
    scalar := \fun (k: Degree) => Laws[k := k].scalar,
    squareZero := \fun (k: Degree)(x: family.Carrier k) => \refl(#zero{(family.space (previous (previous k)))}),
  },
};
\module At(k: Degree);
