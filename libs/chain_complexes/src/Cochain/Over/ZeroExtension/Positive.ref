\import \parent.Index[z := Signed.Int^::ofNat n] \as Source;
\import \parent.Index[z := Signed.Int^::ofNat (N.Nat^::succ n)] \as Target;
\definition intro(x: C.family.Carrier n): Carrier (Signed.Int^::ofNat n) := \into[C.family.Carrier n](x, #carrier{Source.submodule}) \by { Logic.Or[_, _]::left Logic.True::intro };
\definition apply(x: Carrier (Signed.Int^::ofNat n)): Carrier (Signed.Int^::ofNat (N.Nat^::succ n)) :=
  \into[C.family.Carrier (N.Nat^::succ n)](#apply{C.differential} n x, #carrier{Target.submodule}) \by { Logic.Or[_, _]::left Logic.True::intro };
\definition addition: \forall (x, y: Carrier (Signed.Int^::ofNat n)) -> apply (#add{(space (Signed.Int^::ofNat n))} x y) = #add{(space (Signed.Int^::ofNat (N.Nat^::succ n)))} (apply x) (apply y) :=
  \fun (x, y: Carrier (Signed.Int^::ofNat n)) => #addition{C.laws} n x y;
\definition scalar: \forall (a: R)(x: Carrier (Signed.Int^::ofNat n)) -> apply (#smul{(space (Signed.Int^::ofNat n))} a x) = #smul{(space (Signed.Int^::ofNat (N.Nat^::succ n)))} a (apply x) :=
  \fun (a: R)(x: Carrier (Signed.Int^::ofNat n)) => #scalar{C.laws} n a x;
\import Modules.Hom[V := C.family.Carrier n, W := Carrier (Signed.Int^::ofNat n), source := C.family.space n, target := space (Signed.Int^::ofNat n)] \as Forward;
\import Modules.Hom[V := Carrier (Signed.Int^::ofNat n), W := C.family.Carrier n, source := space (Signed.Int^::ofNat n), target := C.family.space n] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := intro,
  addition := \fun (x, y: C.family.Carrier n) => \refl(#add{(C.family.space n)} x y),
  scalar := \fun (a: R)(x: C.family.Carrier n) => \refl(#smul{(C.family.space n)} a x),
};
\definition backward: Backward.Map := Backward.Map {
  apply := \fun (x: Carrier (Signed.Int^::ofNat n)) => x,
  addition := \fun (x, y: Carrier (Signed.Int^::ofNat n)) => \refl(#add{(C.family.space n)} x y),
  scalar := \fun (a: R)(x: Carrier (Signed.Int^::ofNat n)) => \refl(#smul{(C.family.space n)} a x),
};
\import Modules.Isomorphism[V := C.family.Carrier n, W := Carrier (Signed.Int^::ofNat n), source := C.family.space n, target := space (Signed.Int^::ofNat n)] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := \fun (x: C.family.Carrier n) => \refl(x),
  rightInverse := \fun (x: Carrier (Signed.Int^::ofNat n)) => \refl(x),
};
