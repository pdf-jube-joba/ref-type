\definition index: Signed.Int^ := Signed.Int^::negSucc n;
\import Internal.At[C := complex, z := index] \as H;
\import \parent.Negative[n := n] \as Negative;
\import Modules.Hom[V := H.Closed, W := H.Cohomology, source := H.cycleSpace, target := H.cohomologySpace] \as Projection;
\definition zero: \forall (h: H.Cohomology) -> h = H.zeroClass :=
  H.classInduction (\fun (h: H.Cohomology) => h = H.zeroClass)
    (\fun (x: H.Closed) => trans!{{H.Cohomology}} (H.classOf x) (H.classOf (#zero{H.cycleSpace})) H.zeroClass
      (congr!{{H.Closed} {H.Cohomology}} H.classOf x (#zero{H.cycleSpace}) (Negative.zero x))
      (Projection.zeroPreserved H.classLinear));
\import Modules.Zero[] \as Zero;
\import Modules.Hom[V := H.Cohomology, W := Zero.Carrier, source := H.cohomologySpace, target := Zero.moduleSpace] \as Forward;
\import Modules.Hom[V := Zero.Carrier, W := H.Cohomology, source := Zero.moduleSpace, target := H.cohomologySpace] \as Backward;
\import Modules.Isomorphism[V := H.Cohomology, W := Zero.Carrier, source := H.cohomologySpace, target := Zero.moduleSpace] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := Forward.zeroMap, backward := Backward.zeroMap,
  leftInverse := \fun (h: H.Cohomology) => sym!{{H.Cohomology}} _ _ (zero h),
  rightInverse := \fun (x: Zero.Carrier) => Zero.unique Zero.Carrier::zero x,
};
