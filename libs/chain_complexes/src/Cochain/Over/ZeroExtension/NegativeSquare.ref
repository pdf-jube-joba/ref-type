\import \parent.\parent.At[C := C, k := N.Nat^::zero] \as First;
\definition law: \forall (n: N.Nat^)(x: Carrier (Signed.Int^::negSucc n)) -> apply (Integers.next (Signed.Int^::negSucc n)) (apply (Signed.Int^::negSucc n) x) = #zero{(space (Integers.next (Integers.next (Signed.Int^::negSucc n))))} :=
  \induction (n: N.Nat^) \return \forall (x: Carrier (Signed.Int^::negSucc n)) -> apply (Integers.next (Signed.Int^::negSucc n)) (apply (Signed.Int^::negSucc n) x) = #zero{(space (Integers.next (Integers.next (Signed.Int^::negSucc n))))} \with {
    | zero: \fun (x: Carrier (Signed.Int^::negSucc N.Nat^::zero)) => First.differentialZero
    | succ: \fun (n: N.Nat^)(unused: _)(x: Carrier (Signed.Int^::negSucc (N.Nat^::succ n))) => \refl(#zero{(space (Integers.next (Signed.Int^::negSucc n)))})
  };
