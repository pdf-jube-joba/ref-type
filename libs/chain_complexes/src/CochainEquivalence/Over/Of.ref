\import Cochains.Map[C := C, D := D] \as Forward;
\import Cochains.Map[C := D, D := C] \as Backward;
\import Backward.Composition[B := C] \as LeftComposition;
\import Forward.Composition[B := D] \as RightComposition;
\import Cochains.End[C := C] \as SourceEnd;
\import Cochains.End[C := D] \as TargetEnd;
\import Cochains.Homotopy[C := C, D := C] \as LeftHomotopy;
\import Cochains.Homotopy[C := D, D := D] \as RightHomotopy;
\structure Equivalence: \Set {
  forward: Forward.Map,
  backward: Backward.Map,
  left: LeftHomotopy.Homotopy SourceEnd.identity (LeftComposition.compose backward forward),
  right: RightHomotopy.Homotopy TargetEnd.identity (RightComposition.compose forward backward),
}
\module With(e: Equivalence) {
  \import LeftHomotopy.With[f := SourceEnd.identity, g := LeftComposition.compose e.backward e.forward, h := e.left] \as Left;
  \import RightHomotopy.With[f := TargetEnd.identity, g := RightComposition.compose e.forward e.backward, h := e.right] \as Right;
  \module At(n: N.Nat^);
}
