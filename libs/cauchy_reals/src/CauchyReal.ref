/*
 * Cauchy reals over the concrete rational representatives from Arithmetic/Rat.ref.
 *
 * A real is not a chosen Cauchy sequence.  It is an actual equivalence
 * class: a subset of CauchySeq containing exactly the sequences equivalent
 * to one representative.  Kernel equality is therefore the right equality
 * for reals once extensionality of subsets of CauchySeq is supplied.
 */
\import std.Logic[].Proposition[] \as Logic;
\use Logic::either;
\import std.Data[].Nat[] \as N;
\import std.Data[].Nat[].Basic[].Prop[] \as NL;
\import std.Data[].Nat[].Order[].Prop[] \as NatOrder;
\import std.Arithmetic[].Rat[] \as Rational;
\import Rational.Fractions[] \as RationalFractions;
\import RationalFractions.Arithmetic[].Def[] \as RationalOperations;
\import RationalFractions.Arithmetic[].Prop[] \as RationalOperationsProp;
\import RationalFractions.Order[] \as RationalOrder;
\import std.Arithmetic[].Int[] \as Integer;
\import std.Logic[].Classical[] \as Classical;
\use Logic::and;
\import std.Logic[].Equality[] \as Equality;
\use Equality::sym;
\use Equality::congr;

\import Rational.Estimates[] \as Estimates;

\definition Rat: \Set := Estimates.Rat;

\definition zeroRat: Rat := Estimates.zeroRat;

\definition oneRat: Rat := Estimates.oneRat;

\definition addRat(x, y: Rat): Rat := Estimates.addRat x y;

\definition mulRat(x, y: Rat): Rat := Estimates.mulRat x y;

\definition negRat(x: Rat): Rat := Estimates.negRat x;

\definition subRat(x, y: Rat): Rat := Estimates.subRat x y;

\definition twoRat: Rat := Estimates.twoRat;

\definition halfRat: Rat := Estimates.halfRat;

\definition ltRat(x, y: Rat): \Prop := Estimates.ltRat x y;

\definition leNegReverse(x, y: Rat):
  RationalOperations.Le x y ->
  RationalOperations.Le (negRat y) (negRat x) := Estimates.leNegReverse x y;

\definition leAddRight(x, y, z: Rat):
  RationalOperations.Le x y ->
  RationalOperations.Le (addRat x z) (addRat y z) := Estimates.leAddRight x y z;

\definition leAddLeft(z, x, y: Rat):
  RationalOperations.Le x y ->
  RationalOperations.Le (addRat z x) (addRat z y) := Estimates.leAddLeft z x y;

\definition leAdd(x, y, u, v: Rat):
  RationalOperations.Le x y -> RationalOperations.Le u v ->
  RationalOperations.Le (addRat x u) (addRat y v) := Estimates.leAdd x y u v;

\definition leRespects(x, x2, y, y2: Rat):
  RationalFractions.FractionEq x x2 -> RationalFractions.FractionEq y y2 ->
  RationalOperations.Le x y ->
  RationalOperations.Le x2 y2 := Estimates.leRespects x x2 y y2;

\definition ltOfSubPositive(x, y: Rat):
  ltRat zeroRat (subRat y x) ->
  ltRat x y := Estimates.ltOfSubPositive x y;

\definition absNat(x: Integer.Int^): N.Nat^ := Estimates.absNat x;

\definition absInteger(x: Integer.Int^): Integer.Int^ := Estimates.absInteger x;

\definition magnitudeInteger(x: Integer.Int^): Integer.Int^ := Estimates.magnitudeInteger x;

\definition naturalLtConstructors(a, b: N.Nat^):
  NL.Lt a b ->
  Integer.IntegerLt (Integer.Int^::ofNat a) (Integer.Int^::ofNat b) := \fun (ab: _) =>
    Estimates.naturalLtConstructors a b ab;

\definition zeroLtConstructorSucc(n: N.Nat^):
  Integer.IntegerLt Integer.zeroInteger
      (Integer.Int^::ofNat (N.Nat^::succ n)) := Estimates.zeroLtConstructorSucc n;

\definition negConstructorEq(n: N.Nat^):
  Integer.negInteger (Integer.Int^::ofNat (N.Nat^::succ n)) =
    Integer.Int^::negSucc n := Estimates.negConstructorEq n;

\definition magnitudeOfNat(n: N.Nat^):
  magnitudeInteger (Integer.Int^::ofNat n) =
    Integer.Int^::ofNat (N.Nat^::succ n) := Estimates.magnitudeOfNat n;

\definition magnitudeOfNegSucc(n: N.Nat^):
  magnitudeInteger (Integer.Int^::negSucc n) =
    Integer.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n)) := Estimates.magnitudeOfNegSucc n;

\definition belowMagnitude:
  \forall (x: Integer.Int^) ->
    Integer.IntegerLt x (magnitudeInteger x) := Estimates.belowMagnitude;

\definition magnitude(x: Rat): Rat := Estimates.magnitude x;

\definition belowMagnitudeRat(x: Rat): ltRat x (magnitude x) := Estimates.belowMagnitudeRat x;

\definition zeroWithDenominator(x: Rat): Rat := Estimates.zeroWithDenominator x;

\definition magnitudeNumeratorPositive(x: Rat):
  Integer.IntegerLt Integer.zeroInteger (#numerator{(magnitude x)}) := Estimates.magnitudeNumeratorPositive x;

\definition integerMulZeroLeft:
  \forall (x: Integer.Integer) -> Integer.mulInteger Integer.zeroInteger x = Integer.zeroInteger := Estimates.integerMulZeroLeft;

\definition integerMulOneRight:
  \forall (x: Integer.Integer) -> Integer.mulInteger x Integer.oneInteger = x := Estimates.integerMulOneRight;

\definition positiveOfNumerator(e: Rat):
  Integer.IntegerLt Integer.zeroInteger (#numerator{e}) ->
  ltRat zeroRat e := \fun (positive: _) =>
    Estimates.positiveOfNumerator e positive;

\definition magnitudePositive(x: Rat): ltRat zeroRat (magnitude x) := Estimates.magnitudePositive x;

\definition bound(x: Rat): Rat := Estimates.bound x;

\definition magnitudeLtBound(x: Rat): ltRat (magnitude x) (bound x) := Estimates.magnitudeLtBound x;

\definition negMagnitudeLtBound(x: Rat): ltRat (magnitude (negRat x)) (bound x) := Estimates.negMagnitudeLtBound x;

\definition belowBound(x: Rat): ltRat x (bound x) := Estimates.belowBound x;

\definition negBoundBelow(x: Rat): ltRat (negRat (bound x)) x := Estimates.negBoundBelow x;

\definition negBelowBound(x: Rat): ltRat (negRat x) (bound x) := Estimates.negBelowBound x;

\definition boundPositive(x: Rat): ltRat zeroRat (bound x) := Estimates.boundPositive x;

\definition Nat: \Set := Estimates.Nat;

\definition NatLe(lower, upper: Nat): \Prop := Estimates.NatLe lower upper;

\definition Positive(eps: Rat): \Prop := Estimates.Positive eps;

\definition twoPositive: Positive twoRat := Estimates.twoPositive;

\definition twoNonzero: RationalFractions.NumeratorNonZero twoRat := Estimates.twoNonzero;

\definition twoTimesHalf:
  RationalFractions.FractionEq
    (mulRat twoRat halfRat) oneRat := Estimates.twoTimesHalf;

\definition halfPositive: Positive halfRat := Estimates.halfPositive;

\definition halfDouble:
  RationalFractions.FractionEq
    (addRat halfRat halfRat) oneRat := Estimates.halfDouble;

\definition half(eps: Rat): Rat := Estimates.half eps;

\definition halfPositiveOf(eps: Rat):
  Positive eps ->
  Positive (half eps) := Estimates.halfPositiveOf eps;

\definition halfDoubleOf(eps: Rat):
  RationalFractions.FractionEq
    (addRat (half eps) (half eps)) eps := Estimates.halfDoubleOf eps;

\definition Close(x, y: Rat) (eps: Rat): \Prop := Estimates.Close x y eps;

\definition closeZeroOfBound(x: Rat): Close x zeroRat (bound x) := Estimates.closeZeroOfBound x;

\definition ltBoundOfCloseZero(x, B: Rat):
  Close x zeroRat B ->
  ltRat x B := Estimates.ltBoundOfCloseZero x B;

\definition negLtBoundOfCloseZero(x, B: Rat):
  Close x zeroRat B ->
  ltRat (negRat x) B := Estimates.negLtBoundOfCloseZero x B;

\definition mulUpperBound(a, d, A, E: Rat):
  Positive A -> Positive E ->
  Close a zeroRat A -> Close d zeroRat E ->
  ltRat (mulRat a d) (mulRat A E) := Estimates.mulUpperBound a d A E;

\definition closeNegRat(x, y, eps: Rat):
  Close x y eps ->
  Close (negRat x) (negRat y) eps := Estimates.closeNegRat x y eps;

\definition closeMulZero(a, d, A, E: Rat):
  Positive A -> Positive E ->
  Close a zeroRat A -> Close d zeroRat E ->
  Close (mulRat a d) zeroRat (mulRat A E) := Estimates.closeMulZero a d A E;

\definition subTriangle(x, y, z: Rat):
  RationalFractions.FractionEq
    (subRat x z) (addRat (subRat x y) (subRat y z)) := Estimates.subTriangle x y z;

\definition closeRefl(x, eps: Rat):
  Positive eps ->
  Close x x eps := Estimates.closeRefl x eps;

\definition closeOfFractionEq(x, y, eps: Rat):
  RationalFractions.FractionEq x y -> Positive eps ->
  Close x y eps := Estimates.closeOfFractionEq x y eps;

\definition subRespects(x, x2, y, y2: Rat):
  RationalFractions.FractionEq x x2 -> RationalFractions.FractionEq y y2 ->
  RationalFractions.FractionEq (subRat x y) (subRat x2 y2) := Estimates.subRespects x x2 y y2;

\definition negAddRaw(x, y: Rat):
  RationalFractions.FractionEq
    (negRat (addRat x y)) (addRat (negRat x) (negRat y)) := Estimates.negAddRaw x y;

\definition negSub(x, y: Rat):
  RationalFractions.FractionEq
    (negRat (subRat x y)) (subRat y x) := Estimates.negSub x y;

\definition closeRespects(x, x2, y, y2, eps: Rat):
  RationalFractions.FractionEq x x2 -> RationalFractions.FractionEq y y2 ->
  Close x y eps ->
  Close x2 y2 eps := Estimates.closeRespects x x2 y y2 eps;

\definition closeDifferenceZero(x, y, eps: Rat):
  Close x y eps ->
  Close (subRat x y) zeroRat eps := Estimates.closeDifferenceZero x y eps;

\definition closeOfDifferenceZero(x, y, eps: Rat):
  Close (subRat x y) zeroRat eps ->
  Close x y eps := Estimates.closeOfDifferenceZero x y eps;

\definition subMulLeft(a, b, d: Rat):
  RationalFractions.FractionEq
    (subRat (mulRat a b) (mulRat a d))
    (mulRat a (subRat b d)) := Estimates.subMulLeft a b d;

\definition closeMulLeft(a, b, d, A, E: Rat):
  Positive A -> Positive E ->
  Close a zeroRat A -> Close b d E ->
  Close (mulRat a b) (mulRat a d) (mulRat A E) := Estimates.closeMulLeft a b d A E;

\definition closeMulRight(a, c, d, D, E: Rat):
  Positive D -> Positive E ->
  Close d zeroRat D -> Close a c E ->
  Close (mulRat a d) (mulRat c d) (mulRat D E) := Estimates.closeMulRight a c d D E;

\definition positiveAdd(x, y: Rat):
  Positive x -> Positive y ->
  Positive (addRat x y) := Estimates.positiveAdd x y;

\definition fractionMulAddRight(x, y, z: Rat):
  RationalFractions.FractionEq
      (mulRat (addRat x y) z)
      (addRat (mulRat x z) (mulRat y z)) := Estimates.fractionMulAddRight x y z;

\definition fractionMulSubRight(x, y, z: Rat):
  RationalFractions.FractionEq
      (mulRat (subRat x y) z)
      (subRat (mulRat x z) (mulRat y z)) := Estimates.fractionMulSubRight x y z;

\definition reciprocalLeftLaw(x: Rat):
  RationalFractions.NumeratorNonZero x ->
  RationalFractions.FractionEq
      (mulRat (RationalOperations.reciprocal x) x) oneRat := Estimates.reciprocalLeftLaw x;

\definition reciprocalMulProductLeft(x, y: Rat):
  RationalFractions.NumeratorNonZero x ->
  RationalFractions.FractionEq
      (mulRat (RationalOperations.reciprocal x) (mulRat x y)) y := Estimates.reciprocalMulProductLeft x y;

\definition reciprocalMulProductRight(x, y: Rat):
  RationalFractions.NumeratorNonZero y ->
  RationalFractions.FractionEq
      (mulRat (RationalOperations.reciprocal y) (mulRat x y)) x := Estimates.reciprocalMulProductRight x y;

\definition reciprocalDifferenceScaled(x, y: Rat):
  RationalFractions.NumeratorNonZero x ->
  RationalFractions.NumeratorNonZero y ->
  RationalFractions.FractionEq
      (mulRat
        (subRat (RationalOperations.reciprocal x)
          (RationalOperations.reciprocal y))
        (mulRat x y))
      (subRat y x) := Estimates.reciprocalDifferenceScaled x y;

\definition positiveProductLower(r, x, y: Rat):
  Positive r -> RationalOperations.Le r x ->
  RationalOperations.Le r y ->
  Logic.And[Positive (mulRat x y),
      RationalOperations.Le (mulRat r r) (mulRat x y)] := Estimates.positiveProductLower r x y;

\definition positiveProductLowerTwo(r, s, x, y: Rat):
  Positive r -> Positive s ->
  RationalOperations.Le r x -> RationalOperations.Le s y ->
  Logic.And[Positive (mulRat x y),
      RationalOperations.Le (mulRat r s) (mulRat x y)] := Estimates.positiveProductLowerTwo r s x y;

\definition negativeProductLower(r, x, y: Rat):
  Positive r -> RationalOperations.Le x (negRat r) ->
  RationalOperations.Le y (negRat r) ->
  Logic.And[Positive (mulRat x y),
      RationalOperations.Le (mulRat r r) (mulRat x y)] := Estimates.negativeProductLower r x y;

\definition reciprocalRadius(r, eps: Rat): Rat := Estimates.reciprocalRadius r eps;

\definition reciprocalRadiusPositive(r, eps: Rat):
  Positive r -> Positive eps ->
  Positive (reciprocalRadius r eps) := Estimates.reciprocalRadiusPositive r eps;

\definition closeReciprocalWithProductLower(x, y, r, eps: Rat):
  Positive eps -> Positive (mulRat x y) ->
  RationalOperations.Le (mulRat r r) (mulRat x y) ->
  RationalFractions.NumeratorNonZero x ->
  RationalFractions.NumeratorNonZero y ->
  Close x y (reciprocalRadius r eps) ->
  Close (RationalOperations.reciprocal x)
      (RationalOperations.reciprocal y) eps := Estimates.closeReciprocalWithProductLower x y r eps;

\definition scale(A, D: Rat): Rat := Estimates.scale A D;

\definition scalePositive(A, D: Rat):
  Positive A -> Positive D ->
  Positive (scale A D) := Estimates.scalePositive A D;

\definition inverseScale(A, D: Rat): Rat := Estimates.inverseScale A D;

\definition scaleInverse(A, D: Rat):
  Positive A -> Positive D ->
  RationalFractions.FractionEq
      (mulRat (scale A D) (inverseScale A D)) oneRat := Estimates.scaleInverse A D;

\definition inverseScalePositive(A, D: Rat):
  Positive A -> Positive D ->
  Positive (inverseScale A D) := Estimates.inverseScalePositive A D;

\definition productRadius(A, D, eps: Rat): Rat := Estimates.productRadius A D eps;

\definition productRadiusPositive(A, D, eps: Rat):
  Positive A -> Positive D ->
  Positive eps ->
  Positive (productRadius A D eps) := Estimates.productRadiusPositive A D eps;

\definition scaledProductRadius(A, D, eps: Rat):
  Positive A -> Positive D ->
  RationalFractions.FractionEq
      (addRat
        (mulRat A (productRadius A D eps))
        (mulRat D (productRadius A D eps)))
      (half eps) := Estimates.scaledProductRadius A D eps;

\definition halfLt(eps: Rat):
  Positive eps ->
  ltRat (half eps) eps := Estimates.halfLt eps;

\definition closeWiden(x, y, eps, delta: Rat):
  Close x y eps -> ltRat eps delta ->
  Close x y delta := Estimates.closeWiden x y eps delta;

\definition ltOfNotLe(x, y: Rat):
  Logic.Not (RationalOperations.Le x y) ->
  ltRat y x := Estimates.ltOfNotLe x y;

\definition notCloseDirection(a, r: Rat):
  Logic.Not (Close a zeroRat r) ->
  Logic.Or[
      RationalOperations.Le r a,
      RationalOperations.Le a (negRat r)] := \fun (notClose: _) =>
    Estimates.notCloseDirection a r notClose;

\definition lowerOfClose(a, n, r: Rat):
  RationalOperations.Le r a -> Close n a (half r) ->
  ltRat (half r) n := Estimates.lowerOfClose a n r;

\definition upperOfClose(a, n, r: Rat):
  RationalOperations.Le a (negRat r) -> Close n a (half r) ->
  ltRat n (negRat (half r)) := Estimates.upperOfClose a n r;

\definition negAdd(x, y: Rat):
  RationalFractions.FractionEq
    (negRat (addRat x y)) (addRat (negRat x) (negRat y)) := Estimates.negAdd x y;

\definition subAdd(x, y, u, v: Rat):
  RationalFractions.FractionEq
    (subRat (addRat x u) (addRat y v))
    (addRat (subRat x y) (subRat u v)) := Estimates.subAdd x y u v;

\definition closeAddHalf(x, y, u, v, eps: Rat):
  Close x y (half eps) -> Close u v (half eps) ->
  Close (addRat x u) (addRat y v) eps := Estimates.closeAddHalf x y u v eps;

\definition closeTransHalf(x, y, z, eps: Rat):
  Close x y (half eps) -> Close y z (half eps) ->
  Close x z eps := Estimates.closeTransHalf x y z eps;

\definition closeTransAdd(x, y, z, eps, delta: Rat):
  Close x y eps -> Close y z delta ->
  Close x z (addRat eps delta) := Estimates.closeTransAdd x y z eps delta;

\definition closeMulBounded(a, b, c, d, A, D, E: Rat):
  Positive A -> Positive D ->
  Positive E -> Close a zeroRat A ->
  Close d zeroRat D -> Close a c E -> Close b d E ->
  Close (mulRat a b) (mulRat c d)
      (addRat (mulRat A E) (mulRat D E)) := Estimates.closeMulBounded a b c d A D E;

\definition closeMulScaled(a, b, c, d, A, D, eps: Rat):
  Positive A -> Positive D ->
  Positive eps -> Close a zeroRat A ->
  Close d zeroRat D -> Close a c (productRadius A D eps) ->
  Close b d (productRadius A D eps) ->
  Close (mulRat a b) (mulRat c d) eps := Estimates.closeMulScaled a b c d A D eps;

\definition byContradiction(P: \Prop):
  (Logic.Not P -> Logic.False) ->
  P :=
  \fun (h: Logic.Not P -> Logic.False) =>
    either!{
      P "or" {Logic.Not P} "either" P
      "lt:" {\fun (p: P) => p}
      "rt:" {\fun (notP: Logic.Not P) => Logic.falseElim P (h notP)}
    }
      (Classical.excludedMiddle P);

\definition Sequence: \Set := Nat -> Rat;

/* N witnesses that all entries after N are eps-close. */
\definition CauchyAt(seq: Sequence) (eps: Rat) (N: Nat): \Prop :=
    \forall (m, n: Nat) -> NatLe N m -> NatLe N n ->
      Close (seq m) (seq n) eps;

\definition IsCauchy(seq: Sequence): \Prop :=
    \forall (eps: Rat) -> Positive eps ->
      \exists { N : Nat \where CauchyAt seq eps N };

\structure CauchySeq: \Set {
  sequence: Sequence,
  cauchy: IsCauchy sequence,
}

\import std.Logic[].Rel[] \as Rel;

\definition at(x: CauchySeq) (n: Nat): Rat := #sequence{x} n;

/* The difference of two representatives tends to zero. */
\definition EquivalentAt(x, y: CauchySeq) (eps: Rat) (N: Nat): \Prop :=
    \forall (n: Nat) -> NatLe N n ->
      Close (at x n) (at y n) eps;

\definition Equivalent(x, y: CauchySeq): \Prop :=
    \forall (eps: Rat) -> Positive eps ->
      \exists { N : Nat \where EquivalentAt x y eps N };

/* The diagonal of the Cauchy estimate already proves reflexivity. */
\definition equivalentRefl(x: CauchySeq) (eps: Rat):
  Positive eps ->
  \exists { k : Nat \where EquivalentAt x x eps k } :=
  \block {
    \fun (positive: Positive eps) \then
    \takefrom k: \Cast[Nat] ({ k : Nat \where CauchyAt (#sequence{x}) eps k }) \by #cauchy{x} eps positive \then
    \return \exact(
        \into[Nat](k, { j : Nat \where EquivalentAt x x eps j }) \by { \fun (n: Nat) => \fun (kn: NatLe k n) =>
            (\bysub(Nat, { j : Nat \where CauchyAt (#sequence{x}) eps j }, k)) n n kn kn },
        \Cast[Nat] ({ j : Nat \where EquivalentAt x x eps j }))
  };

\definition closeSym(x, y, eps: Rat):
  Close x y eps ->
  Close y x eps := Estimates.closeSym x y eps;

\definition equivalentSym(x, y: CauchySeq):
  Equivalent x y ->
  Equivalent y x :=
  \fun (xy: Equivalent x y) (eps: Rat) (positive: Positive eps) =>
      \block {
        \takefrom N: \Cast[Nat] ({ k : Nat \where EquivalentAt x y eps k }) \by xy eps positive \then
        \return \exact(
            \into[Nat](N, { k : Nat \where EquivalentAt y x eps k }) \by { (\fun (n: Nat) => \fun (Nn: NatLe N n) =>
                closeSym (at x n) (at y n) eps
                  ((\bysub(
                    Nat, { k : Nat \where EquivalentAt x y eps k }, N))
                    n Nn)) },
            \Cast[Nat] ({ k : Nat \where EquivalentAt y x eps k }))
      };

\definition commonBound(m, n: Nat): Nat := NatOrder.commonBound m n;
\definition leftLeCommonBound(m, n: Nat): NatLe m (commonBound m n) :=
  NatOrder.leftLeCommonBound m n;
\definition rightLeCommonBound(m, n: Nat): NatLe n (commonBound m n) :=
  NatOrder.rightLeCommonBound m n;

\definition equivalentTrans(x, y, z: CauchySeq):
  Equivalent x y -> Equivalent y z ->
  Equivalent x z :=
  \fun (xy: Equivalent x y) (yz: Equivalent y z) (eps: Rat) (positive: Positive eps) =>
      \block {
        \takefrom M: \Cast[Nat] ({ k : Nat \where EquivalentAt x y (half eps) k }) \by xy (half eps) (halfPositiveOf eps positive) \then
        \takefrom N: \Cast[Nat] ({ k : Nat \where EquivalentAt y z (half eps) k }) \by yz (half eps) (halfPositiveOf eps positive) \then
        \return \exact(
            \into[Nat](commonBound M N,
              { k : Nat \where EquivalentAt x z eps k }) \by {
                \fun (n: Nat) => \fun (bound: NatLe (commonBound M N) n) =>
                  closeTransHalf (at x n) (at y n) (at z n) eps
                    ((\bysub(Nat,
                      { k : Nat \where EquivalentAt x y (half eps) k }, M))
                      n (NL.leTrans M (commonBound M N) n (leftLeCommonBound M N) bound))
                    ((\bysub(Nat,
                      { k : Nat \where EquivalentAt y z (half eps) k }, N))
                      n (NL.leTrans N (commonBound M N) n (rightLeCommonBound M N) bound)) },
            \Cast[Nat] ({ k : Nat \where EquivalentAt x z eps k }))
      };

\module Sequences;
\module Quotient;
\module Order;
\module Completeness;
