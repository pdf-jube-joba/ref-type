\import topology.Topology[Carrier := A] \as Source;
\import topology.Continuity[A := A, B := K] \as Components;
\import topology.Continuity[A := A, B := Carrier] \as Maps;
\import topology.Maps[A := A, B := Carrier] \as Generated;
\import std.Logic[].Equality[] \as Equality;
\use Equality::sym;
\definition continuous: \forall (source: Source.Topology) (scalar: Scalars.Topology) (f: A -> Carrier) ->
  (\forall (i: I) -> Components.Continuous source scalar (\fun (x: A) => f x i)) ->
  Maps.Continuous source (topology scalar) f :=
  \fun (source: _) (scalar: _) (f: _) (components: _) => Generated.generatedContinuous source f (Basis scalar) (\block {
    \fun (W: \Pow Carrier) (member: Space.FamilyMember (Basis scalar) W) \then
    \takefrom witness: Witness[scalar, W] \by member \then
    \return \idelim Subbasic #index{witness} #openSet{witness} = W
      \with V: \Pow Carrier => Source.IsOpenIn source (Maps.Preimage f V)
      \by { base: components #index{witness} #openSet{witness} #open{witness},
        equality: sym!{\Pow Carrier} _ _ #same{witness} }
  });
