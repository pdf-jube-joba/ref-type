\import real.Analysis[] \as Real;
\import real.Analysis[].Algebra[] \as Algebra;
\import topology.RealLine[] \as Line;
\import topology.Product[A := Real.Real, B := Real.Real] \as Product;
\import Product.Maps[] \as Projections;
\import topology.RealFunctions[A := Product.CarrierSet] \as Binary;
\import Binary.Product[] \as Multiplication;
\import topology.RealFunctions[A := Real.Real] \as Unary;
\import topology.Maps[A := Real.Real, B := Real.Real].Identity[] \as Identity;
\import std.Alg[].Alg[] \as Alg;
\import std.Alg[].Field[] \as Fields;
\import std.Alg[].Ring[] \as Ring;
\import std.Data[].Pair[] \as Pair;
\import topological_algebra.Topology[K := Real.Real] \as Top;
\import topology.Topology[Carrier := Real.Real] \as Space;
\definition Carrier: \Set := Real.Real;
\definition topology: Space.Topology := Line.topology;
\definition group: Alg.CommutativeGroup[Real.Real] :=
  Ring.additiveGroup Real.Real (Ring.commutativeRingAsRing Real.Real (Fields.fieldAsCommutativeRing Real.Real Algebra.field));
\definition data: Top.AdditiveGroupData := Top.AdditiveGroupData { topology := Line.topology, group := group };
\definition additiveGroup: Top.AdditiveGroup := \into[Top.AdditiveGroupData](data, Top.AdditiveGroup) \by {
  Top.AdditiveLaws[Line.topology, group] {
    addition := Binary.sumContinuous (Product.topology Line.topology Line.topology)
      (Pair.first Real.Real Real.Real) (Pair.second Real.Real Real.Real)
      (Projections.firstContinuous Line.topology Line.topology) (Projections.secondContinuous Line.topology Line.topology),
    inverse := Unary.negContinuous Line.topology (\fun (x: Real.Real) => x) (Identity.continuous Line.topology),
  }
};
\definition ring: Ring.CommutativeRing[Real.Real] := Fields.fieldAsCommutativeRing Real.Real Algebra.field;
\definition topologicalRing: Top.TopologicalRing := \into[Top.RingData](
  Top.RingData { topology := Line.topology, ring := ring }, Top.TopologicalRing) \by {
    Top.RingLaws[Line.topology, ring] {
      addition := Binary.sumContinuous (Product.topology Line.topology Line.topology)
        (Pair.first Real.Real Real.Real) (Pair.second Real.Real Real.Real)
        (Projections.firstContinuous Line.topology Line.topology) (Projections.secondContinuous Line.topology Line.topology),
      negation := Unary.negContinuous Line.topology (\fun (x: Real.Real) => x) (Identity.continuous Line.topology),
      multiplication := Multiplication.continuous (Product.topology Line.topology Line.topology)
        (Pair.first Real.Real Real.Real) (Pair.second Real.Real Real.Real)
        (Projections.firstContinuous Line.topology Line.topology) (Projections.secondContinuous Line.topology Line.topology),
    }
  };
