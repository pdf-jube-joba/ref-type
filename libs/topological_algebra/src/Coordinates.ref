\import topology.Topology[Carrier := K] \as Scalars;
\import topology.Topology[Carrier := I -> K] \as Space;
\import topology.Continuity[A := I -> K, B := K] \as Evaluation;
\import std.Logic[].Proposition[] \as Logic;
\definition Carrier: \Set := I -> K;
\definition evaluate(i: I) (v: Carrier): K := v i;
\definition Subbasic(i: I) (U: \Pow K): \Pow Carrier := { v: Carrier \where \In[K] U (v i) };
\structure Witness[scalar: Scalars.Topology, W: \Pow Carrier]: \Set {
  index: I,
  openSet: \Pow K,
  open: Scalars.IsOpenIn scalar openSet,
  same: W = Subbasic index openSet,
}
\definition Basis(scalar: Scalars.Topology): \Pow (\Pow Carrier) := { W: \Pow Carrier \where \exists Witness[scalar, W] };
\definition topology(scalar: Scalars.Topology): Space.Topology := Space.generated (Basis scalar);
\definition evaluationContinuous: \forall (scalar: Scalars.Topology) (i: I) ->
  Evaluation.Continuous (topology scalar) scalar (evaluate i) :=
  \fun (scalar: _) (i: I) (U: _) (open: _) => Space.generatedBasisOpen (Basis scalar) (Subbasic i U)
    (\exact(Witness[scalar, Subbasic i U] { index := i, openSet := U, open := open, same := \refl(Subbasic i U) }, Witness[scalar, Subbasic i U]));
\module Universal(A: \Set);
\module Update;
