\import topology.Product[A := Carrier, B := Carrier] \as BinaryProduct;
\import BinaryProduct.Maps[] \as BinaryProjections;
\import \parent.Functions[A := BinaryProduct.CarrierSet] \as BinaryFunctions;
\import \parent.Functions[A := Carrier] \as UnaryFunctions;
\import topology.Maps[A := Carrier, B := Carrier].Identity[] \as Identity;
\import std.Alg[].Ring[] \as Rings;
\import Scalar.Algebra[] \as Algebra;
\import std.Data[].Pair[] \as Pair;
\import topological_algebra.Topology[K := Carrier] \as Top;
\definition topologicalRing: Top.TopologicalRing := \into[Top.RingData](
  Top.RingData { topology := topology, ring := Algebra.commutativeRing }, Top.TopologicalRing) \by {
    Top.RingLaws[topology, Algebra.commutativeRing] {
      addition := BinaryFunctions.additionContinuous (BinaryProduct.topology topology topology)
        (Pair.first Carrier Carrier) (Pair.second Carrier Carrier)
        (BinaryProjections.firstContinuous topology topology) (BinaryProjections.secondContinuous topology topology),
      negation := UnaryFunctions.negationContinuous topology (\fun (z: Carrier) => z) (Identity.continuous topology),
      multiplication := BinaryFunctions.multiplicationContinuous (BinaryProduct.topology topology topology)
        (Pair.first Carrier Carrier) (Pair.second Carrier Carrier)
        (BinaryProjections.firstContinuous topology topology) (BinaryProjections.secondContinuous topology topology),
    }
  };
