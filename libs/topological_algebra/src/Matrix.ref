\import topology.Topology[Carrier := K] \as Scalars;
\import topological_algebra.Coordinates[K := K, I := J] \as Rows;
\import topological_algebra.Coordinates[K := Rows.Carrier, I := I] \as Matrices;
\import topology.Topology[Carrier := Matrices.Carrier] \as Space;
\import topology.Continuity[A := Matrices.Carrier, B := K] \as Evaluation;
\import topology.Composition[A := Matrices.Carrier, B := Rows.Carrier, C := K] \as Compose;
\definition Carrier: \Set := I -> J -> K;
\definition topology(scalar: Scalars.Topology): Space.Topology := Matrices.topology (Rows.topology scalar);
\definition entry(i: I) (j: J) (matrix: Carrier): K := matrix i j;
\definition entryContinuous: \forall (scalar: Scalars.Topology) (i: I) (j: J) ->
  Evaluation.Continuous (topology scalar) scalar (entry i j) :=
  \fun (scalar: _) (i: I) (j: J) => Compose.composeContinuous (topology scalar) (Rows.topology scalar) scalar
    (Matrices.evaluate i) (Rows.evaluate j) (Matrices.evaluationContinuous (Rows.topology scalar) i) (Rows.evaluationContinuous scalar j);
\module Universal(A: \Set);
