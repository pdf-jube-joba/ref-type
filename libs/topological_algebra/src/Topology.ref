\import topology.Topology[Carrier := K] \as Space;
\import topology.Product[A := K, B := K] \as Product;
\import topology.Continuity[A := Product.CarrierSet, B := K] \as Binary;
\import topology.Continuity[A := K, B := K] \as Unary;
\import std.Alg[].Alg[] \as Alg;
\import std.Alg[].Ring[] \as Ring;
\import std.Data[].Pair[] \as Pair;
\structure AdditiveLaws[space: Space.Topology, group: Alg.CommutativeGroup[K]]: \Prop {
  addition: Binary.Continuous (Product.topology space space) space
    (\fun (p: Product.CarrierSet) => #op{(#base{group})} (Pair.first K K p) (Pair.second K K p)),
  inverse: Unary.Continuous space space (#inv{(#base{group})}),
}
\structure AdditiveGroupData: \Set {
  topology: Space.Topology,
  group: Alg.CommutativeGroup[K],
}
\definition AdditiveGroup: \Set := \Cast[AdditiveGroupData] ({ data: AdditiveGroupData \where AdditiveLaws[#topology{data}, #group{data}] });
\structure RingLaws[space: Space.Topology, ring: Ring.CommutativeRing[K]]: \Prop {
  addition: Binary.Continuous (Product.topology space space) space
    (\fun (p: Product.CarrierSet) => #add{(#base{ring})} (Pair.first K K p) (Pair.second K K p)),
  negation: Unary.Continuous space space (#neg{(#base{ring})}),
  multiplication: Binary.Continuous (Product.topology space space) space
    (\fun (p: Product.CarrierSet) => #mul{(#base{ring})} (Pair.first K K p) (Pair.second K K p)),
}
\structure RingData: \Set {
  topology: Space.Topology,
  ring: Ring.CommutativeRing[K],
}
\definition TopologicalRing: \Set := \Cast[RingData] ({ data: RingData \where RingLaws[#topology{data}, #ring{data}] });
\definition ringLaws(ring: TopologicalRing): RingLaws[#topology{ring}, #ring{ring}] :=
  \bysub(RingData, TopologicalRing, ring);
\module Functions(A: \Set);
