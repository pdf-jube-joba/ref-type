\import real.DedekindReal[] \as R;
\import R.Arithmetic[].Def[] \as Op;
\import R.Arithmetic[].Prop[] \as Laws;
\import R.Order[] \as Order;
\import R.Completeness[] \as Complete;
\import topology.RealMetric[] \as Metric;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Nat;
\import N.Order[].Prop[] \as NatOrder;
\import std.Arithmetic[].Rat[].Estimates[] \as Q;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\use Equality.eq_reason;

\definition Real: \Set := R.Real;
\definition zero: Real := Op.zero;
\definition one: Real := Op.one;
\definition neg: Real -> Real := Op.neg;
\definition add: Real -> Real -> Real := Op.add;
\definition sub: Real -> Real -> Real := Op.sub;
\definition mul: Real -> Real -> Real := Laws.fieldMul;
\definition distance: Real -> Real -> Real := Metric.distance;
\definition half: Real := Op.ofRat Q.halfRat;
\definition midpoint(a, b: Real): Real := add a (mul half (sub b a));

\structure Interval: \Set {
  left: Real,
  right: Real,
  ordered: R.Le left right,
}

\module Estimates;
\module Division;
\module Sequence;
\module Riemann(interval: Interval);
\module Lebesgue(interval: Interval);
