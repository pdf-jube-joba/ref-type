\import algebraic_topology.Interval[] \as Interval;
\import algebraic_topology.Cylinder[A := A] \as Cylinder;
\import topology.Topology[Carrier := A] \as Source;
\definition Top: \Pow Cylinder.Carrier := { p: Cylinder.Carrier \where Cylinder.time p = Interval.end };
\import algebraic_topology.Collapse[A := Cylinder.Carrier, subset := Top] \as Quotient;
\import topology.Topology[Carrier := Quotient.Carrier] \as Space;
\definition Carrier: \Set := Quotient.Carrier;
\definition class: Cylinder.Carrier -> Carrier := Quotient.class;
\definition topology(source: Source.Topology): Space.Topology := Quotient.topology (Cylinder.topology source);
\definition base(x: A): Carrier := class (Cylinder.at Interval.start x);
\definition apex(x: A): Carrier := class (Cylinder.at Interval.end x);
\definition apexIndependent: \forall (x, y: A) -> apex x = apex y :=
  \fun (x, y: A) => Quotient.collapsed (Cylinder.at Interval.end x) (Cylinder.at Interval.end y)
    (\refl(Interval.end)) (\refl(Interval.end));
\module Contraction;
