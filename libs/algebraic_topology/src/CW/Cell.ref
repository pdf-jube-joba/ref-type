\import Euclidean.Dimension[n := #dimension{cell}] \as Model;
\import topology.Continuity[A := Model.Disk, B := A] \as Maps;
\import topology.Maps[A := Model.Disk, B := A] \as Images;
\definition Closure: \Pow A := Images.Image (#characteristic{cell}) ({ p: Model.Disk \where p = p });
\definition Interior: \Pow A := { x: A \where \exists { p: Model.Disk \where
  Logic.And[\In[Model.Coordinate] Model.Interior p, #characteristic{cell} p = x] } };
