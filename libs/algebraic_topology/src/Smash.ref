\import algebraic_topology.Pointed[A := A] \as Left;
\import algebraic_topology.Pointed[A := B] \as Right;
\import topology.Product[A := A, B := B] \as Product;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\module Of(left: Left.Space, right: Right.Space) {
  \definition Wedge: \Pow Product.CarrierSet := { p: Product.CarrierSet \where
    Logic.Or[Pair.first A B p = left.basepoint, Pair.second A B p = right.basepoint] };
  \import algebraic_topology.Collapse[A := Product.CarrierSet, subset := Wedge] \as Quotient;
  \import topology.Topology[Carrier := Quotient.Carrier] \as Space;
  \definition Carrier: \Set := Quotient.Carrier;
  \definition topology: Space.Topology := Quotient.topology (Product.topology left.topology right.topology);
  \definition class: Product.CarrierSet -> Carrier := Quotient.class;
  \definition basepoint: Carrier := class (Pair.pair A B left.basepoint right.basepoint);
  \definition leftCollapsed: \forall (y: B) -> class (Pair.pair A B left.basepoint y) = basepoint :=
    \fun (y: B) => Quotient.collapsed _ _ (Logic.Or[_, _]::left (\refl(left.basepoint))) (Logic.Or[_, _]::left (\refl(left.basepoint)));
  \definition rightCollapsed: \forall (x: A) -> class (Pair.pair A B x right.basepoint) = basepoint :=
    \fun (x: A) => Quotient.collapsed _ _ (Logic.Or[_, _]::right (\refl(right.basepoint))) (Logic.Or[_, _]::left (\refl(left.basepoint)));
}
