\import algebraic_topology.Interval[] \as Interval;
\import algebraic_topology.Cylinder[A := A] \as Cylinder;
\import topology.Topology[Carrier := A] \as Source;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality::sym;
\use Equality::trans;
\use Logic::either;
\definition AtStart(p: Cylinder.Carrier): \Prop := Cylinder.time p = Interval.start;
\definition AtEnd(p: Cylinder.Carrier): \Prop := Cylinder.time p = Interval.end;
\definition Edge(p, q: Cylinder.Carrier): \Prop :=
  Logic.Or[p = q, Logic.Or[Logic.And[AtStart p, AtStart q], Logic.And[AtEnd p, AtEnd q]]];
\import std.Logic[].Rel[].Closure[] \as Closure;
\definition Related: Cylinder.Carrier -> Cylinder.Carrier -> \Prop := Closure.EquivalenceClosure Cylinder.Carrier Edge;
\import topology.RelationQuotient[A := Cylinder.Carrier, relation := Related] \as Quotient;
\import topology.Topology[Carrier := Quotient.Carrier] \as Space;
\definition equivalence: Quotient.Laws := Quotient.Laws {
  refl := Closure.equivalenceClosureRefl Cylinder.Carrier Edge,
  sym := Closure.equivalenceClosureSym Cylinder.Carrier Edge,
  trans := Closure.equivalenceClosureTrans Cylinder.Carrier Edge,
};
\definition Carrier: \Set := Quotient.Carrier;
\definition class: Cylinder.Carrier -> Carrier := Quotient.class;
\definition topology(source: Source.Topology): Space.Topology := Quotient.topology (Cylinder.topology source);
\definition south(x: A): Carrier := class (Cylinder.at Interval.start x);
\definition north(x: A): Carrier := class (Cylinder.at Interval.end x);
\definition southIndependent: \forall (x, y: A) -> south x = south y :=
  \fun (x, y: A) => Quotient.relatedEqual equivalence _ _
    (Closure.equivalenceClosureOf Cylinder.Carrier Edge _ _ (Logic.Or[_, _]::right
      (Logic.Or[_, _]::left (Logic.And[_, _]::# (\refl(Interval.start)) (\refl(Interval.start))))));
\definition northIndependent: \forall (x, y: A) -> north x = north y :=
  \fun (x, y: A) => Quotient.relatedEqual equivalence _ _
    (Closure.equivalenceClosureOf Cylinder.Carrier Edge _ _ (Logic.Or[_, _]::right
      (Logic.Or[_, _]::right (Logic.And[_, _]::# (\refl(Interval.end)) (\refl(Interval.end))))));
\import topology.Topology[Carrier := Cylinder.Carrier] \as CylinderSpace;
\definition projectionContinuous: \forall (source: Source.Topology) ->
  \forall (U: \Pow Carrier) -> Space.IsOpenIn (topology source) U ->
  CylinderSpace.IsOpenIn (Cylinder.topology source) ({ p: Cylinder.Carrier \where \In[Carrier] U (class p) }) := \fun (source: _) => Quotient.projectionContinuous (Cylinder.topology source);
\module Reduced(basepoint: A) {
  \definition Collapsed: \Pow Cylinder.Carrier := { p: Cylinder.Carrier \where
    Logic.Or[AtStart p, Logic.Or[AtEnd p, Cylinder.point p = basepoint]] };
  \import algebraic_topology.Collapse[A := Cylinder.Carrier, subset := Collapsed] \as ReducedQuotient;
  \import topology.Topology[Carrier := ReducedQuotient.Carrier] \as ReducedSpace;
  \definition Carrier: \Set := ReducedQuotient.Carrier;
  \definition topology(source: Source.Topology): ReducedSpace.Topology := ReducedQuotient.topology (Cylinder.topology source);
  \definition basepoint: Carrier := ReducedQuotient.class (Cylinder.at Interval.start basepoint);
  \definition equator(x: A): Carrier := ReducedQuotient.class (Cylinder.at Interval.middle x);
}
\module Maps(B: \Set);
