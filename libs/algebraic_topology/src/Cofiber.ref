\import algebraic_topology.Cone[A := A] \as Cone;
\import topology.Topology[Carrier := A] \as Source;
\import topology.Topology[Carrier := B] \as Target;
\import topology.Pushout[A := B, B := Cone.Carrier, C := A] \as Pushout;
\module Of(f: A -> B) {
  \import Pushout.Of[u := f, v := Cone.base] \as Attached;
  \import topology.Topology[Carrier := Attached.Carrier] \as Space;
  \definition Carrier: \Set := Attached.Carrier;
  \definition topology(source: Source.Topology) (target: Target.Topology): Space.Topology :=
    Attached.topology target (Cone.topology source);
  \definition inclusion: B -> Carrier := Attached.inl;
  \definition cone: Cone.Carrier -> Carrier := Attached.inr;
  \definition attached: \forall (x: A) -> inclusion (f x) = cone (Cone.base x) := Attached.glued;
}
