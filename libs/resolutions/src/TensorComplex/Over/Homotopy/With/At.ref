\import Modules.Tensor[V := P.family.Carrier n, W := N.Carrier, left := P.family.space n, right := N.space] \as Generators;
\import Modules.Tensor[V := Q.family.Carrier (Nat.Nat^::succ n), W := N.Carrier, left := Q.family.space (Nat.Nat^::succ n), right := N.space] \as Result;
\import Modules.Hom[V := P.family.Carrier n, W := Q.family.Carrier (Nat.Nat^::succ n), source := P.family.space n, target := Q.family.space (Nat.Nat^::succ n)] \as Linear;
\definition linear: Linear.Map := Linear.Map { apply := #apply{h} n, addition := #addition{h} n, scalar := #scalar{h} n };
\import Generators.Mapping[U := Q.family.Carrier (Nat.Nat^::succ n), Z := N.Carrier, targetLeft := Q.family.space (Nat.Nat^::succ n), targetRight := N.space] \as Mapping;
\definition map: Modules.MapBetween (Modules.Bundle { Carrier := Generators.Carrier, space := Generators.space }) (Modules.Bundle { Carrier := Result.Carrier, space := Result.space }) := Mapping.map linear Coefficients.identity;
\definition onTensor: \forall (x: P.family.Carrier n)(y: N.Carrier) -> #apply{map} (Generators.tensor x y) = Result.tensor (#apply{h} n x) y := Mapping.onTensor linear Coefficients.identity;
