\import Cochains.At[C := Source.complex, k := k] \as SourceH;
\import Cochains.At[C := Target.complex, k := k] \as TargetH;
\import Cochains.Map[C := Source.complex, D := Middle.complex].At[k := k] \as FirstMap;
\import Cochains.Map[C := Middle.complex, D := Target.complex].At[k := k] \as SecondMap;
\import Maps.At[k := k] \as DirectMap;
\definition onCohomology: \forall (f: Before.Map)(g: After.Map)(q: SourceH.Cohomology) ->
  #apply{(DirectMap.induced (direct f g))} q = #apply{(SecondMap.induced (second f))} (#apply{(FirstMap.induced (first g))} q) :=
  \fun (f: Before.Map)(g: After.Map)(q: SourceH.Cohomology) => trans!{TargetH.Cohomology} _ _ _
    (congr!{Maps.Map TargetH.Cohomology} (\fun (m: Maps.Map) => #apply{(DirectMap.induced m)} q) _ _ (law f g))
    (Composition.At[k := k].compositionOnCohomology (second f) (first g) q);
