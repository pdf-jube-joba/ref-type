\definition family: Chains.Family := Chains.Family {
  Carrier := \fun (n: Nat.Nat^) => C.family.Carrier n q,
  space := \fun (n: Nat.Nat^) => C.family.space n q,
};
\definition differential: Chains.DifferentialData[family] := Chains.DifferentialData[family] {
  apply := \fun (n: Nat.Nat^) => #apply{(C.differential.horizontal n q)},
};
\definition complex: Chains.Complex := Chains.Complex {
  family := family, differential := differential,
  laws := Chains.DifferentialLaws[family, differential] {
    addition := \fun (n: Nat.Nat^) => #addition{(C.differential.horizontal n q)},
    scalar := \fun (n: Nat.Nat^) => #scalar{(C.differential.horizontal n q)},
    squareZero := \fun (n: Nat.Nat^) => #horizontalZero{C.laws} n q,
  },
};
