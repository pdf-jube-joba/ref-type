\import Chains.ProjectiveResolution[M := M] \as Chosen;
\import \parent.Of[M := M, P := Chosen.complex] \as Of;
\definition resolution(projective: Modules.Projective M): Of.Resolution :=
  \into[Of.Data](Of.Data { augmentation := Chosen.augmentation }, { data: Of.Data \where Of.Laws[data] }) \by {
    Of.Laws[Of.Data { augmentation := Chosen.augmentation }] {
      projective := Chosen.projective projective, onto := Chosen.onto, killed := Chosen.augmentationKilled,
      augmentationExact := Chosen.augmentationExact, exact := Chosen.exact,
    }
  };
