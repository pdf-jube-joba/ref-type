\import Modules.Of[V := P.family.Carrier n, space := P.family.space n].Submodule[] \as Submodules;
\import Submodules.Of[S := kernel resolution n] \as Cycles;
\definition Carrier: \Set := Cycles.Carrier;
\definition space: Modules.Space Carrier := Cycles.moduleSpace;
\definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier, space := space };
\import Modules.Hom[V := P.family.Carrier (Nat.Nat^::succ n), W := Carrier, source := P.family.space (Nat.Nat^::succ n), target := space] \as Maps;
\definition projection: Maps.Map := Maps.Map {
  apply := \fun (x: P.family.Carrier (Nat.Nat^::succ n)) => \into[P.family.Carrier n](#apply{P.differential} n x, #carrier{(kernel resolution n)}) \by { kernelKilled resolution n x },
  addition := #addition{P.laws} n, scalar := #scalar{P.laws} n,
};
\definition onto: Modules.Surjective (term (Nat.Nat^::succ n)) bundle projection := \block {
  \fun (x: Carrier) \then
  \takefrom y: \Cast[P.family.Carrier (Nat.Nat^::succ n)] ({ y: P.family.Carrier (Nat.Nat^::succ n) \where #apply{P.differential} n y = x })
    \by kernelExact resolution n x (\bysub(P.family.Carrier n, #carrier{(kernel resolution n)}, x)) \then
  \return \exact(\into[P.family.Carrier (Nat.Nat^::succ n)](y, { y: P.family.Carrier (Nat.Nat^::succ n) \where #apply{projection} y = x }) \by {
    \bysub(P.family.Carrier (Nat.Nat^::succ n), { y: P.family.Carrier (Nat.Nat^::succ n) \where #apply{P.differential} n y = x }, y)
  }, \Cast[P.family.Carrier (Nat.Nat^::succ n)] ({ y: P.family.Carrier (Nat.Nat^::succ n) \where #apply{projection} y = x }))
};
\module ShortExact {
  \import Modules.Of[V := P.family.Carrier (Nat.Nat^::succ n), space := P.family.space (Nat.Nat^::succ n)].Submodule[] \as UpperSubmodules;
  \import UpperSubmodules.Of[S := kernel resolution (Nat.Nat^::succ n)] \as Upper;
  \definition left: Modules.Bundle := Modules.Bundle { Carrier := Upper.Carrier, space := Upper.moduleSpace };
  \definition middle: Modules.Bundle := term (Nat.Nat^::succ n);
  \import Modules.ShortExact[A := left, B := middle, C := bundle] \as Sequences;
  \definition ambient(x: Carrier): P.family.Carrier n := x;
  \definition zero: \forall (x: Upper.Carrier) -> #apply{projection} (#apply{Upper.inclusion} x) = #zero{space} :=
    \fun (x: Upper.Carrier) => \bysub(P.family.Carrier (Nat.Nat^::succ n),
      #carrier{(kernel resolution (Nat.Nat^::succ n))}, x);
  \definition kernelImage: \forall (x: P.family.Carrier (Nat.Nat^::succ n)) -> #apply{projection} x = #zero{space} ->
    \exists { y: Upper.Carrier \where #apply{Upper.inclusion} y = x } :=
    \fun (x: P.family.Carrier (Nat.Nat^::succ n))(closed: #apply{projection} x = #zero{space}) =>
      \exact(\into[Upper.Carrier](
        \into[P.family.Carrier (Nat.Nat^::succ n)](x, #carrier{(kernel resolution (Nat.Nat^::succ n))}) \by {
          congr!{Carrier {P.family.Carrier n}} ambient (#apply{projection} x) #zero{space} closed
        }, { y: Upper.Carrier \where #apply{Upper.inclusion} y = x }) \by { \refl(x) },
        \Cast[Upper.Carrier] ({ y: Upper.Carrier \where #apply{Upper.inclusion} y = x }));
  \definition sequence: Sequences.Sequence := Sequences.Sequence {
    inclusion := Upper.inclusion, projection := projection,
    injective := \fun (x, y: Upper.Carrier)(equal: _) => equal,
    onto := onto, zero := zero, kernelImage := kernelImage,
  };
}
