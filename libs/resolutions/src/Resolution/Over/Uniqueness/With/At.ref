\import Modules.Hom[V := P.family.Carrier n, W := Q.family.Carrier n, source := P.family.space n, target := Q.family.space n] \as Linear;
\import Modules.Hom[V := P.family.Carrier n, W := Q.family.Carrier (Nat.Nat^::succ n), source := P.family.space n, target := Q.family.space (Nat.Nat^::succ n)] \as HomotopyMaps;
\import Modules.Hom[V := Q.family.Carrier (Nat.Nat^::succ n), W := Q.family.Carrier n, source := Q.family.space (Nat.Nat^::succ n), target := Q.family.space n] \as Differential;
\import Modules.Hom[V := P.family.Carrier (Nat.Nat^::succ n), W := Q.family.Carrier (Nat.Nat^::succ n), source := P.family.space (Nat.Nat^::succ n), target := Q.family.space (Nat.Nat^::succ n)] \as NextLinear;
\import algebra.Group[].Of[Carrier := Q.family.Carrier n, group := Modules.Laws[V := Q.family.Carrier n, space := Q.family.space n].additive] \as Group;
\import algebra.Group[].Of[Carrier := Q.family.Carrier (Nat.Nat^::succ n), group := Modules.Laws[V := Q.family.Carrier (Nat.Nat^::succ n), space := Q.family.space (Nat.Nat^::succ n)].additive] \as NextGroup;
\definition Map: \Set := HomotopyMaps.Map;
\definition delta: Linear.Map := Linear.plus (Maps.At[n := n].linear f) (Linear.negative (Maps.At[n := n].linear g));
\definition nextDelta: NextLinear.Map := NextLinear.plus (Maps.At[n := Nat.Nat^::succ n].linear f) (NextLinear.negative (Maps.At[n := Nat.Nat^::succ n].linear g));
\definition differential: Differential.Map := Differential.Map {
  apply := #apply{Q.differential} n, addition := #addition{Q.laws} n, scalar := #scalar{Q.laws} n,
};
\definition deltaCommutes: \forall (x: P.family.Carrier (Nat.Nat^::succ n)) ->
  #apply{Q.differential} n (#apply{nextDelta} x) = #apply{delta} (#apply{P.differential} n x) :=
  \fun (x: P.family.Carrier (Nat.Nat^::succ n)) => trans!{{Q.family.Carrier n}} _ _ _
    (Differential.differencePreserved differential (#apply{f} (Nat.Nat^::succ n) x) (#apply{g} (Nat.Nat^::succ n) x))
    (congr2!{{Q.family.Carrier n} {Q.family.Carrier n} {Q.family.Carrier n}} Group.difference _ _ _ _ (#commutes{f} n x) (#commutes{g} n x));
\definition Invariant(h: Map): \Prop := \forall (x: P.family.Carrier (Nat.Nat^::succ n)) ->
  #apply{Q.differential} n (#apply{h} (#apply{P.differential} n x)) = #apply{delta} (#apply{P.differential} n x);
\import HomotopyMaps.Composition[U := P.family.Carrier (Nat.Nat^::succ n), domain := P.family.space (Nat.Nat^::succ n)] \as Composition;
\import Modules.Hom[V := P.family.Carrier (Nat.Nat^::succ n), W := P.family.Carrier n, source := P.family.space (Nat.Nat^::succ n), target := P.family.space n] \as SourceDifferential;
\definition sourceDifferential: SourceDifferential.Map := SourceDifferential.Map {
  apply := #apply{P.differential} n, addition := #addition{P.laws} n, scalar := #scalar{P.laws} n,
};
\definition residual(h: Map): NextLinear.Map := NextLinear.plus nextDelta (NextLinear.negative (Composition.compose h sourceDifferential));
\definition residualClosed: \forall (h: Map) -> Invariant h -> \forall (x: P.family.Carrier (Nat.Nat^::succ n)) ->
  #apply{Q.differential} n (#apply{(residual h)} x) = #zero{(Q.family.space n)} :=
  \fun (h: Map)(invariant: Invariant h)(x: P.family.Carrier (Nat.Nat^::succ n)) => trans!{{Q.family.Carrier n}} _ _ _
    (Differential.differencePreserved differential (#apply{nextDelta} x) (#apply{h} (#apply{P.differential} n x)))
    (trans!{{Q.family.Carrier n}} _ _ _
      (congr2!{{Q.family.Carrier n} {Q.family.Carrier n} {Q.family.Carrier n}} Group.difference _ _ _ _ (deltaCommutes x) (invariant x))
      (Group.inverseRight (#apply{delta} (#apply{P.differential} n x))));
\import Target.Syzygy[n := Nat.Nat^::succ n, resolution := q] \as Cycles;
\import Modules.Hom[V := P.family.Carrier (Nat.Nat^::succ n), W := Cycles.Carrier, source := P.family.space (Nat.Nat^::succ n), target := Cycles.space] \as Restricted;
\definition factor(h: Map)(invariant: Invariant h): Restricted.Map := Restricted.Map {
  apply := \fun (x: P.family.Carrier (Nat.Nat^::succ n)) => \into[Q.family.Carrier (Nat.Nat^::succ n)]
    (#apply{(residual h)} x, #carrier{(Target.kernel q (Nat.Nat^::succ n))}) \by { residualClosed h invariant x },
  addition := #addition{(residual h)}, scalar := #scalar{(residual h)},
};
\definition Lift(h: Map)(next: \parent.At[n := Nat.Nat^::succ n].Map): \Prop :=
  \forall (x: P.family.Carrier (Nat.Nat^::succ n)) -> #apply{Q.differential} (Nat.Nat^::succ n) (#apply{next} x) = #apply{(residual h)} x;
\definition existence: \forall (h: Map) -> Invariant h -> \exists { next: \parent.At[n := Nat.Nat^::succ n].Map \where Lift h next } :=
  \fun (h: Map)(invariant: Invariant h) => #projective{p} (Nat.Nat^::succ n)
    (Q.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) (Q.family.space (Nat.Nat^::succ (Nat.Nat^::succ n)))
    Cycles.Carrier Cycles.space Cycles.projection Cycles.onto (factor h invariant);
\definition successorInvariant: \forall (h: Map)(next: \parent.At[n := Nat.Nat^::succ n].Map) -> Lift h next -> \parent.At[n := Nat.Nat^::succ n].Invariant next :=
  \fun (h: Map)(next: \parent.At[n := Nat.Nat^::succ n].Map)(lift: Lift h next)(x: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) =>
    trans!{{Q.family.Carrier (Nat.Nat^::succ n)}} _ _ _ (lift (#apply{P.differential} (Nat.Nat^::succ n) x))
      (trans!{{Q.family.Carrier (Nat.Nat^::succ n)}} _ _ _
        (congr!{{Q.family.Carrier (Nat.Nat^::succ n)} {Q.family.Carrier (Nat.Nat^::succ n)}}
          (NextGroup.difference (#apply{nextDelta} (#apply{P.differential} (Nat.Nat^::succ n) x))) _ _
          (trans!{{Q.family.Carrier (Nat.Nat^::succ n)}} _ _ _
            (congr!{{P.family.Carrier n} {Q.family.Carrier (Nat.Nat^::succ n)}} (#apply{h}) _ _ (#squareZero{P.laws} n x)) (HomotopyMaps.zeroPreserved h)))
        (trans!{{Q.family.Carrier (Nat.Nat^::succ n)}} _ _ _
          (congr!{{Q.family.Carrier (Nat.Nat^::succ n)} {Q.family.Carrier (Nat.Nat^::succ n)}}
            (NextGroup.add (#apply{nextDelta} (#apply{P.differential} (Nat.Nat^::succ n) x))) _ _ NextGroup.negZero)
          (NextGroup.zeroRight (#apply{nextDelta} (#apply{P.differential} (Nat.Nat^::succ n) x)))));
\definition equation: \forall (h: Map)(next: \parent.At[n := Nat.Nat^::succ n].Map) -> Lift h next ->
  \forall (x: P.family.Carrier (Nat.Nat^::succ n)) -> #apply{nextDelta} x =
    NextGroup.add (#apply{Q.differential} (Nat.Nat^::succ n) (#apply{next} x)) (#apply{h} (#apply{P.differential} n x)) :=
  \fun (h: Map)(next: \parent.At[n := Nat.Nat^::succ n].Map)(lift: Lift h next)(x: P.family.Carrier (Nat.Nat^::succ n)) =>
    sym!{{Q.family.Carrier (Nat.Nat^::succ n)}} _ _ (trans!{{Q.family.Carrier (Nat.Nat^::succ n)}} _ _ _
      (congr!{{Q.family.Carrier (Nat.Nat^::succ n)} {Q.family.Carrier (Nat.Nat^::succ n)}}
        (\fun (y: Q.family.Carrier (Nat.Nat^::succ n)) => NextGroup.add y (#apply{h} (#apply{P.differential} n x))) _ _ (lift x))
      (NextGroup.addDifference (#apply{nextDelta} x) (#apply{h} (#apply{P.differential} n x))));
