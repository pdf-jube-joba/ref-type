\module At(n: Nat.Nat^);
\definition differential: Chains.DifferentialData[family] := Chains.DifferentialData[family] {
  apply := \fun (n: Nat.Nat^)(x: family.Carrier (Nat.Nat^::succ n)) => At[n := n].apply x,
};
\definition complex: Chains.Complex := Chains.Complex {
  family := family, differential := differential,
  laws := Chains.DifferentialLaws[family, differential] {
    addition := \fun (n: Nat.Nat^) => At[n := n].addition,
    scalar := \fun (n: Nat.Nat^) => At[n := n].scalar,
    squareZero := \fun (n: Nat.Nat^) => At[n := n].squareZero,
  },
};

\import Chains.Map[C := P, D := complex] \as Inclusions;
\import Chains.Map[C := complex, D := Q] \as Projections;
\definition inclusion: Inclusions.Map := Inclusions.Map {
  apply := \fun (n: Nat.Nat^) => #apply{At[n := n].inclusion},
  addition := \fun (n: Nat.Nat^) => #addition{At[n := n].inclusion},
  scalar := \fun (n: Nat.Nat^) => #scalar{At[n := n].inclusion},
  commutes := \fun (n: Nat.Nat^) => At[n := n].inclusionCommutes,
};
\definition projection: Projections.Map := Projections.Map {
  apply := \fun (n: Nat.Nat^) => #apply{At[n := n].projection},
  addition := \fun (n: Nat.Nat^) => #addition{At[n := n].projection},
  scalar := \fun (n: Nat.Nat^) => #scalar{At[n := n].projection},
  commutes := \fun (n: Nat.Nat^) => At[n := n].projectionCommutes,
};
