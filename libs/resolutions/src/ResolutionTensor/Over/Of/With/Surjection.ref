\import Original.Syzygy[n := n, resolution := q] \as Syzygy;
\import \parent.Kernel[n := n] \as Kernel;
\import \parent.\parent.Term[n := Nat.Nat^::succ n] \as Source;
\import Modules.Tensor[V := P.Carrier, W := Q.family.Carrier (Nat.Nat^::succ n), left := P.space, right := Q.family.space (Nat.Nat^::succ n)].Mapping[
  U := P.Carrier, Z := Syzygy.Carrier, targetLeft := P.space, targetRight := Syzygy.space] \as Mapping;
\definition map: Modules.MapBetween Source.bundle Kernel.bundle := Mapping.map Identity.identity Syzygy.projection;
\definition identityOnto: \forall (x: P.Carrier) -> \exists { y: P.Carrier \where #apply{Identity.identity} y = x } :=
  \fun (x: P.Carrier) => \exact(\into[P.Carrier](x, { y: P.Carrier \where #apply{Identity.identity} y = x }) \by { \refl(x) },
    \Cast[P.Carrier] ({ y: P.Carrier \where #apply{Identity.identity} y = x }));
\definition onto: Modules.Surjective Source.bundle Kernel.bundle map :=
  Mapping.Surjectivity[].onto Identity.identity Syzygy.projection identityOnto Syzygy.onto;
\definition onTensor: \forall (x: P.Carrier)(y: Q.family.Carrier (Nat.Nat^::succ n)) ->
  #apply{map} (Source.tensor x y) = Kernel.tensor x (#apply{Syzygy.projection} y) := Mapping.onTensor Identity.identity Syzygy.projection;
