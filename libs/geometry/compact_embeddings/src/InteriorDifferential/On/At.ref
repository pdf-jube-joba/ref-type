\import boundary_manifolds.Tangent[n := n].On[M := Inclusion.manifold].At[x := x] \as Domain;
\import boundary_manifolds.Tangent[n := n].On[M := M].At[x := x] \as Codomain;
\import boundary_manifolds.Differential[n := n, m := n].Between[M := Inclusion.manifold, N := M].At[f := Inclusion.map, x := x] \as D;
\module In(c: Interior.Chart, contains: TargetCharts.Contains c x);
\definition injective: \forall (u, v: Domain.Vector) -> D.value.apply u = D.value.apply v -> u = v := \block {
  \fun (u, v: Domain.Vector)(equal: _) \then
  \takefrom c: \Cast[TargetCharts.Chart] ({ c: TargetCharts.Chart \where Logic.And[\In[TargetCharts.Chart] M.atlas.charts c, TargetCharts.Contains c x] }) \by M.atlas.covers x \then
  \let data: Logic.And[\In[TargetCharts.Chart] M.atlas.charts c, TargetCharts.Contains c x] := \bysub(TargetCharts.Chart, { c: TargetCharts.Chart \where Logic.And[\In[TargetCharts.Chart] M.atlas.charts c, TargetCharts.Contains c x] }, c) \then
  \let chart: Interior.Chart := \into[TargetCharts.Chart](c, M.atlas.charts) \by { data.left } \then
  \return In[c := chart, contains := data.right].injective u v equal
};
\definition onto: \forall (w: Codomain.Vector) -> \exists ( v: Domain.Vector \where D.value.apply v = w ) := \block {
  \fun (w: Codomain.Vector) \then
  \takefrom c: \Cast[TargetCharts.Chart] ({ c: TargetCharts.Chart \where Logic.And[\In[TargetCharts.Chart] M.atlas.charts c, TargetCharts.Contains c x] }) \by M.atlas.covers x \then
  \let data: Logic.And[\In[TargetCharts.Chart] M.atlas.charts c, TargetCharts.Contains c x] := \bysub(TargetCharts.Chart, { c: TargetCharts.Chart \where Logic.And[\In[TargetCharts.Chart] M.atlas.charts c, TargetCharts.Contains c x] }, c) \then
  \let chart: Interior.Chart := \into[TargetCharts.Chart](c, M.atlas.charts) \by { data.left } \then
  \return In[c := chart, contains := data.right].onto w
};
