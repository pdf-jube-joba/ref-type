\import smooth_partitions.Manifold[n := n].On[M := M] \as Scalars;
\import smooth_partitions.Scalars[A := M.Point, space := M.space].Using[calculus := Scalars.calculus] \as Functions;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\import manifolds.Dimension[n := n].Atlas[M := M.Point, space := M.space] \as Atlas;
\import topology.Topology[Carrier := M.Point] \as Space;
\import Space.Closure[] \as Closure;
\import calculus.Real[].Multivariable[n := n] \as Model;
\import Model.Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\definition Chart: \Set := \Cast[Charts.Chart] M.atlas.charts;
\module Vector(m: N.Nat^);
\module At(c: Chart, b: Functions.Smooth, within: Space.Subset (Scalars.support b) c.domain);
