\import calculus.Real[].Multivariable[n := m].Open[] \as TargetOpen;
\import calculus.Maps[n := n, m := m] \as Calculus;
\definition data: Calculus.Data[c.image, TargetOpen.whole] := Calculus.Data[c.image, TargetOpen.whole] {
  apply := \fun (u: Open.Carrier c.image) => \into[target.Point](f (Charts.point c u), TargetOpen.whole.points) \by { \refl(f (Charts.point c u)) }
};
\definition coordinateMap: Calculus.Map c.image TargetOpen.whole := \into[Calculus.Data[c.image, TargetOpen.whole]](data, Calculus.Map c.image TargetOpen.whole) \by {
  Calculus.Laws[c.image, TargetOpen.whole, data] { smooth := \fun (i: Fin.Fin m) => regular i c }
};
\import manifolds.EuclideanMap[n := n, m := m].Between[U := c.image, V := TargetOpen.whole] \as CoordinateMaps;
\import manifolds.Dimension[n := m].Atlas[M := target.Point, space := target.space] \as TargetAtlas;
\import manifolds.Dimension[n := m].Chart[M := target.Point, space := target.space] \as TargetCharts;
\definition standard: \Cast[TargetCharts.Chart] target.atlas.charts := \into[TargetCharts.Chart](Euclidean.standard, target.atlas.charts) \by {
  TargetAtlas.includedInSaturation Euclidean.atlas Euclidean.standard (\refl(Euclidean.standard))
};
\import manifolds.ChartMap[n := m].On[M := target].At[chart := standard] \as Parametrization;
\import manifolds.Composition[n := n, m := m, l := m].Between[M := CoordinateMaps.source, N := CoordinateMaps.target, P := target] \as Compose;
\definition map: Plots.LocalMap c := Compose.compose (CoordinateMaps.map coordinateMap) Parametrization.map;
