\import manifolds.FromCharts[n := n, m := m].Between[M := M, N := target] \as Plots;
\module Local(c: Plots.SourceChart);
\definition maps: Plots.Family := \fun (c: Plots.SourceChart) => Local[c := c].map;
\definition agrees: Plots.Agreement f maps := \fun (c: Plots.SourceChart)(u: Open.Carrier c.image) => \refl(f (Charts.point c u));
\import Plots.On[f := f, maps := maps, agrees := agrees] \as Construct;
\definition map: Maps.Map := Construct.value;
