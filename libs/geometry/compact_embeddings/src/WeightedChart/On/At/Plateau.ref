\import Scalars.Neighborhood[c := c, U := U, open := open] \as Neighborhood;
\import manifolds.ChartRestriction[n := n].On[M := M].At[c := c, U := Neighborhood.domain, included := Neighborhood.included] \as Restricted;
\definition chart: Chart := Restricted.chart;
\definition pointOne[u: Open.Carrier chart.image]: b (Charts.point chart u) = Real.one :=
  oneOn (Charts.point chart u) (Neighborhood.point u);
\definition chartCoordinates[u: Open.Carrier chart.image]: coordinates (Charts.point chart u) = u :=
  trans!{{Model.Point}} _ _ _ (coordinatesAtOne (Charts.point chart u) (pointOne u)) (Geometry.coordinatePoint (Restricted.originalCoordinate u));
\module At(x: M.Point, inside: Space.Member U x);
