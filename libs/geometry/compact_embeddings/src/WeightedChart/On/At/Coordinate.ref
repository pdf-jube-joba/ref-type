\definition local[x: OnOpen.Carrier]: Real.Real := Real.mul (b x) (Charts.coordinate c x i);
\import OnOpen.ZeroExtension[f := local] \as Extend;
\definition value: M.Point -> Real.Real := Extend.value;
\definition inside[x: OnOpen.Carrier]: value x = local x := Extend.inside x;
\definition vanishes[x: OnOpen.Carrier]: Logic.Not (Space.Member (Scalars.support b) x) -> local x = Real.zero :=
  \fun (outside: _) => trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r (Charts.coordinate c x i)) _ _ (zeroAway x outside)) (Laws.fieldMulZeroLeft _);
\module Local(d: Chart);
\definition localSmooth: OnOpen.IsSmooth local := \fun (d: Chart) => Local[d := d].smooth;
\definition smooth: Scalars.IsSmooth value := Extend.Closed[F := Scalars.support b, closed := Closure.closed M.space (Scalars.Nonzero b), included := within, vanishes := vanishes].smooth localSmooth;
