\import OnOpen.InChart[c := d] \as Domain;
\import Charts.Transition[left := d, right := c] \as Transition;
\definition included: Open.Included Domain.domain Transition.domain := \fun (u: Model.Point)(member: _) => \block {
  \let v: Open.Carrier Domain.domain := \into[Model.Point](u, Domain.domain.points) \by { member } \then
  \return Transition.intro (Open.inclusion Domain.domain d.image Scalars.Neighborhood[c := d, U := c.domain, open := c.open].included v)
    (\bysub(M.Point, c.domain, Domain.point v))
};
\definition coordinateSmooth: Smooth.SmoothOn Domain.domain (\fun (u: Open.Carrier Domain.domain) => Charts.coordinate c (Domain.point u) i) :=
  Open.Restriction[].localSmooth Domain.domain Transition.domain included (\fun (u: Open.Carrier Transition.domain) => Transition.apply u i)
    (M.atlas.compatible d c (\bysub(Charts.Chart, M.atlas.charts, d)) (\bysub(Charts.Chart, M.atlas.charts, c)) i);
\definition smooth: Smooth.SmoothOn Domain.domain (Domain.coordinates local) := Smooth.Operations[].mulSmooth Domain.domain
  (\fun (u: Open.Carrier Domain.domain) => b (Domain.point u)) (\fun (u: Open.Carrier Domain.domain) => Charts.coordinate c (Domain.point u) i)
  (Domain.restrictSmooth b (Functions.regular b d)) coordinateSmooth;
