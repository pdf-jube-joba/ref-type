\import manifolds.Dimension[n := m].Examples[].Euclidean[] \as Euclidean;
\import manifolds.Dimension[n := m].Smooth[] \as Targets;
\definition target: Targets.Manifold := Euclidean.smoothManifold;
\import manifolds.SmoothMap[n := n, m := m].Between[M := M, N := Euclidean.smoothManifold] \as Maps;
\module Of(f: M.Point -> target.Point, regular: \forall (i: Fin.Fin m) -> Scalars.IsSmooth (\fun (x: M.Point) => f x i));
