\import Height.From[construction := result.collar].Of[width := result.width] \as H;
\import H.Compact[compact := compact] \as Built;
\import Height.Built[result := result, compact := compact] \as Public;
\definition map: boundary_manifolds.SmoothMap[n := dimension, m := One.dimension].Between[M := M, N := Neat.halfLine].Map := Public.map;
\import manifold_gluing.BoundaryInclusion[n := n].On[M := M].With[cover := cover] \as BoundaryModel;
\import boundary_manifolds.Product[n := n, m := One.dimension].Of[M := BoundaryModel.manifold, N := Time.manifold] \as Product;
\import Boundary.Build[cover := cover] \as OrdinaryBoundary;
\import boundary_manifolds.Boundaryless[n := n].Of[M := OrdinaryBoundary.manifold] \as ConvertedBoundary;
\definition radiusOuter: R.Lt H.radius H.outer := Order.ltTrans H.radius H.middle H.outer (Estimates.halfStrict H.middle H.middlePositive) H.middleSmall;
\definition bounded: R.Lt H.radius S.one := Order.ltTrans H.radius H.outer S.one radiusOuter H.outerBounded;
\definition within: \forall (t: Time.Point) -> R.Lt (Time.value t) H.radius -> \In[Time.Point] result.collar.regular.uniform.neighborhood t :=
  \fun (t: Time.Point)(small: _) => H.within t (Order.ltTrans (Time.value t) H.radius H.outer small radiusOuter);
\import manifold_gluing.CollarWindow[n := n].On[M := M].With[cover := cover].From[deformation := result.collar.deformation].Of[regular := result.collar.regular].At[
  a := H.radius, positive := H.radiusPositive, bounded := bounded, within := within] \as Window;
\import manifold_gluing.OpenManifold[n := dimension].On[M := Product.manifold].Within[U := Window.points, open := Window.open] \as Parameters;
\import manifold_gluing.CollarRestriction[n := n].On[M := M].With[cover := cover].From[deformation := result.collar.deformation].Of[regular := result.collar.regular].Within[
  V := Window.points, open := Window.open, inside := Window.inside] \as Collar;
\import manifold_gluing.OpenManifold[n := dimension].On[M := M].Within[U := Collar.image, open := Collar.imageOpen] \as Image;
\import manifold_gluing.ProductMaps[n := n, m := One.dimension].Of[M := BoundaryModel.manifold, N := Time.manifold] \as Projections;
\import \root.HeightNormal[n := n].TimeMap[] \as RayInclusion;
\import manifold_gluing.SmoothChainRule[n := dimension, m := One.dimension, l := One.dimension].Between[M := Product.manifold, N := Time.manifold, P := Neat.halfLine].Of[
  f := Projections.Second[].map, g := RayInclusion.map] \as ProductHeight;
\import manifold_gluing.SmoothChainRule[n := dimension, m := dimension, l := One.dimension].Between[M := Parameters.manifold, N := Product.manifold, P := Neat.halfLine].Of[
  f := Parameters.Inclusion[].map, g := ProductHeight.map] \as Projection;
\import manifold_gluing.SmoothChainRule[n := dimension, m := dimension, l := One.dimension].Between[M := Parameters.manifold, N := M, P := Neat.halfLine].Of[
  f := Collar.map, g := map] \as Composite;
\import boundary_manifolds.SmoothMap[n := dimension, m := One.dimension].Between[M := Parameters.manifold, N := Neat.halfLine] \as LocalMaps;
\import manifold_gluing.CollarWindow[n := n].On[M := M].With[cover := cover].From[deformation := result.collar.deformation].Of[regular := result.collar.regular].At[
  a := H.outer, positive := H.outerPositive, bounded := H.outerBounded, within := H.within] \as OriginalWindow;
\import manifold_gluing.OpenManifold[n := dimension].On[M := Product.manifold].Within[U := OriginalWindow.points, open := OriginalWindow.open] \as OriginalParameters;
\definition original[p: Parameters.Point]: OriginalParameters.Point := \into[Product.Point](p, OriginalWindow.points) \by {
  Order.ltTrans (Time.value (Product.second p)) H.radius H.outer (\bysub(Product.Point, Window.points, p)) radiusOuter
};
\definition formula[p: Parameters.Point]: LocalMaps.apply Composite.map p = LocalMaps.apply Projection.map p :=
  boundary_manifolds.Model[n := One.dimension].equality Neat.constraints Open.whole (LocalMaps.apply Composite.map p) (LocalMaps.apply Projection.map p)
    (\axiom:funext((LocalMaps.apply Composite.map p \of boundary_manifolds.Model[n := One.dimension].Point),
      (LocalMaps.apply Projection.map p \of boundary_manifolds.Model[n := One.dimension].Point), \fun (i: One.Index) =>
        trans!{S.Real} _ _ _ (congr!{One.Index S.Real} (\fun (j: One.Index) => LocalMaps.apply Composite.map p j) _ _ (std.Data[].FinSet[].singletonValue i))
          (trans!{S.Real} _ _ _ (Built.compatible (original p) (Order.leOfLt (Time.value (Product.second p)) H.radius (\bysub(Product.Point, Window.points, p))))
            (sym!{S.Real} _ _ (congr!{One.Index S.Real} (\fun (j: One.Index) => LocalMaps.apply Projection.map p j) _ _ (std.Data[].FinSet[].singletonValue i))))));
\definition equal: Composite.map = Projection.map := manifold_gluing.SmoothMapExt[n := dimension, m := One.dimension].Between[M := Parameters.manifold, N := Neat.halfLine].ext Composite.map Projection.map formula;
\import boundary_manifolds.SmoothMap[n := dimension, m := dimension].Between[M := Parameters.manifold, N := M] \as CollarMaps;
\import manifold_gluing.SmoothChainRule[n := dimension, m := dimension, l := dimension].Between[M := Parameters.manifold, N := Image.manifold, P := M].Of[
  f := Collar.diffeomorphism.forward, g := Image.Inclusion[].map] \as CollarChain;
\definition collarEqual: CollarChain.map = Collar.map := manifold_gluing.SmoothMapExt[n := dimension, m := dimension].Between[M := Parameters.manifold, N := M].ext CollarChain.map Collar.map
  (\fun (p: Parameters.Point) => \refl(CollarMaps.apply Collar.map p));
\import boundary_manifolds.Tangent[n := dimension].On[M := M] \as SourceTangent;
\import boundary_manifolds.Tangent[n := One.dimension].On[M := Neat.halfLine] \as TargetTangent;
\import boundary_manifolds.Differential[n := dimension, m := One.dimension].Between[M := M, N := Neat.halfLine] \as Derivative;
\import boundary_manifolds.Neat[n := dimension, m := One.dimension].Between[M := M, N := Neat.halfLine] \as Normal;
\definition Reflects[x: M.Point]: \Prop := \forall (v: SourceTangent.Vector x) -> TargetTangent.At[x := map.apply x].Cones[].Tangential (Derivative.At[f := map, x := x].value.apply v) -> SourceTangent.At[x := x].Cones[].Tangential v;
\module ProductAt(y: Product.Point);
\module At(p: Parameters.Point);
\module InteriorAt(x: M.Point, interior: Logic.Not boundary_manifolds.Tangent[n := dimension].On[M := M].At[x := x].Cones[].Boundary);
\module BoundaryAt(x: M.Point, boundary: boundary_manifolds.Tangent[n := dimension].On[M := M].At[x := x].Cones[].Boundary);

\definition boundary[x: M.Point]: Logic.PropEquiv[SourceTangent.At[x := x].Cones[].Boundary, TargetTangent.At[x := map.apply x].Cones[].Boundary] := Logic.PropEquiv[_, _] {
  ltr := \fun (member: _) => \root.Neat[n := n].LineAt[t := map.apply x].boundaryOfZero (Built.boundaryZero x member),
  rtl := \fun (member: _) => Built.zeroBoundary x (\root.Neat[n := n].LineAt[t := map.apply x].zeroOfBoundary member),
};
\definition normal[x: M.Point]: Normal.At[f := map, x := x].NormalOnto := Logic.orElim (SourceTangent.At[x := x].Cones[].Boundary) (Logic.Not SourceTangent.At[x := x].Cones[].Boundary)
  (Normal.At[f := map, x := x].NormalOnto) (Classical.excludedMiddle (SourceTangent.At[x := x].Cones[].Boundary))
  (\fun (b: _) => BoundaryAt[x := x, boundary := b].normal) (\fun (b: _) => InteriorAt[x := x, interior := b].normal);
\definition reflects[x: M.Point]: Reflects x := Logic.orElim (SourceTangent.At[x := x].Cones[].Boundary) (Logic.Not SourceTangent.At[x := x].Cones[].Boundary)
  (Reflects x) (Classical.excludedMiddle (SourceTangent.At[x := x].Cones[].Boundary))
  (\fun (b: _) => BoundaryAt[x := x, boundary := b].reflects) (\fun (b: _) => InteriorAt[x := x, interior := b].reflects);
