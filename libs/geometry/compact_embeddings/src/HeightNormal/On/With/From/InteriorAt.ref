\import SourceTangent.At[x := x] \as Domain;
\import TargetTangent.At[x := map.apply x] \as Codomain;
\definition allSource: \forall (v: Domain.Vector) -> Domain.Cones[].Tangential v := \block {
  \let all: \forall (v: Domain.Vector) -> Domain.Cones[].Inward v := Space.Finite[].doubleNegElim (\forall (v: Domain.Vector) -> Domain.Cones[].Inward v) interior \then
  \return \fun (v: Domain.Vector) => Logic.And[_, _]::# (all v) (all (Domain.Operations[].negative v))
};
\definition noBoundary: Logic.Not Codomain.Cones[].Boundary := \fun (b: _) => interior (Built.zeroBoundary x (\root.Neat[n := n].LineAt[t := map.apply x].zeroOfBoundary b));
\definition allTarget: \forall (v: Codomain.Vector) -> Codomain.Cones[].Tangential v := \block {
  \let all: \forall (v: Codomain.Vector) -> Codomain.Cones[].Inward v := topology.Topology[Carrier := Neat.halfLine.Point].Finite[].doubleNegElim (\forall (v: Codomain.Vector) -> Codomain.Cones[].Inward v) noBoundary \then
  \return \fun (v: Codomain.Vector) => Logic.And[_, _]::# (all v) (all (Codomain.Operations[].negative v))
};
\definition normal: Normal.At[f := map, x := x].NormalOnto := \fun (w: Codomain.Vector) => Logic.existsIntro[Domain.Vector,
  { v: Domain.Vector \where Codomain.Cones[].Tangential (Normal.At[f := map, x := x].difference v w) }] Domain.Operations[].origin
    (allTarget (Normal.At[f := map, x := x].difference Domain.Operations[].origin w));
\definition reflects: Reflects x := \fun (v: Domain.Vector)(tangent: _) => allSource v;
