\import std.Data[].Pair[] \as Pair;
\definition b: BoundaryModel.manifold.Point := ConvertedBoundary.forward (\into[M.Point](x, Boundary.points) \by { boundary });
\definition p: Parameters.Point := \into[Product.Point](Pair.pair BoundaryModel.manifold.Point Time.Point b Time.zero, Window.points) \by { H.radiusPositive };
\definition initial: Collar.map.apply p = x := Built.zeroValue b;
\definition normal: Normal.At[f := map, x := x].NormalOnto := \idelim Collar.map.apply p = x \with y: M.Point => Normal.At[f := map, x := y].NormalOnto \by {
  base: \parent.At[p := p].normal, equality: initial
};
\definition reflects: Reflects x := \idelim Collar.map.apply p = x \with y: M.Point => Reflects y \by {
  base: \parent.At[p := p].reflects, equality: initial
};
