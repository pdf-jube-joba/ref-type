\import boundary_manifolds.Model[n := One.dimension] \as Model;
\import calculus.Maps[n := One.dimension, m := One.dimension] \as Calculus;
\definition ambient: Calculus.Map Time.domain Open.whole := Calculus.Map[Time.domain, Open.whole] {
  apply := \fun (t: Open.Carrier Time.domain) => \into[Model.Point](t, Open.whole.points) \by { \refl(t \of Model.Point) },
  smooth := \fun (i: One.Index) => Open.Examples[].projectionSmooth Time.domain i,
};
\definition preserves: \forall (t: Time.Point) -> Model.Nonnegative Neat.constraints (Calculus.apply Time.domain Open.whole ambient t) :=
  \fun (t: Time.Point) => \bysub(Open.Carrier Time.domain, Model.region Time.constraints Time.domain, t);
\import boundary_manifolds.QuadrantMap[n := One.dimension, m := One.dimension].Of[C := Time.constraints, D := Neat.constraints, U := Time.domain, V := Open.whole, f := ambient, preserves := preserves] \as Construct;
\definition map: boundary_manifolds.SmoothMap[n := One.dimension, m := One.dimension].Between[M := Time.manifold, N := Neat.halfLine].Map := Construct.map;
\module At(t: Time.Point);
