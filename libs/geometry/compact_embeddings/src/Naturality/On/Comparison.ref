\import \root.Stabilization[n := n, a := left.dimension, b := right.dimension].On[M := M].Between[f := left.embedding, g := right.embedding] \as Family;
\import calculus.Blocks[n := left.dimension, m := right.dimension] \as Blocks;
\definition dimension: N.Nat^ := Blocks.dimension;
\import manifolds.Dimension[n := dimension].Examples[].Euclidean[] \as Target;
\import manifolds.Dimension[n := left.dimension].Examples[].Euclidean[] \as Left;
\import manifolds.Dimension[n := right.dimension].Examples[].Euclidean[] \as Right;
\import manifolds.SmoothMap[n := n, m := dimension].Between[M := M, N := Target.smoothManifold] \as Maps;
\import manifolds.SmoothMap[n := n, m := left.dimension].Between[M := M, N := Left.smoothManifold] \as LeftMaps;
\import manifolds.SmoothMap[n := n, m := right.dimension].Between[M := M, N := Right.smoothManifold] \as RightMaps;
\import manifolds.Immersion[n := n, m := dimension].Between[M := M, N := Target.smoothManifold] \as Embeddings;
\definition embedding[t: R.Real]: Embeddings.Embedding := Family.embedding t;
\definition formula[t: R.Real][x: M.Point]: Maps.apply (embedding t) x = Blocks.join
  (\fun (i: Fin.Fin left.dimension) => R.mul (R.sub R.one t) (LeftMaps.apply left.embedding x i))
  (\fun (i: Fin.Fin right.dimension) => R.mul t (RightMaps.apply right.embedding x i)) := \refl(Family.value t x);
\definition leftEndpoint[x: M.Point]: Maps.apply (embedding R.zero) x = Blocks.join (LeftMaps.apply left.embedding x) (\fun (i: Fin.Fin right.dimension) => R.zero) := Family.leftEndpoint x;
\definition rightEndpoint[x: M.Point]: Maps.apply (embedding R.one) x = Blocks.join (\fun (i: Fin.Fin left.dimension) => R.zero) (RightMaps.apply right.embedding x) := Family.rightEndpoint x;
\definition relativeEmbedding[t: R.Real]: Embeddings.Embedding := Family.Relative[].embeddingAt t;
\definition fixedLeft[t: R.Real]: dedekind_reals.DedekindReal[].Le t R.zero -> \forall (x: M.Point) -> Maps.apply (relativeEmbedding t) x =
  Blocks.join (LeftMaps.apply left.embedding x) (\fun (i: Fin.Fin right.dimension) => R.zero) := Family.Relative[].fixedLeft t;
\definition fixedRight[t: R.Real]: dedekind_reals.DedekindReal[].Le R.one t -> \forall (x: M.Point) -> Maps.apply (relativeEmbedding t) x =
  Blocks.join (\fun (i: Fin.Fin left.dimension) => R.zero) (RightMaps.apply right.embedding x) := Family.Relative[].fixedRight t;
