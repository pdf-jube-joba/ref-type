\import Functions.Selection[family := chartCover, S := Space.Whole] \as Selection;
\module Selected(bumps: Selection.CountableBumps);
\definition exists: \exists Result := \block {
  \takefrom bumps: Selection.CountableBumps \by Selection.countable M.secondCountable
    (\fun (x: M.Point)(member: Space.Member Space.Whole x) => Scalars.Bumps[family := chartCover].local cover x) \then
  \return Selected[bumps := bumps].exists
};
