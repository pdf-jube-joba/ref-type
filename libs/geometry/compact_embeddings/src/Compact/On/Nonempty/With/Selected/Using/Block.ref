\definition chart: Chart := charts k;
\definition within: Space.Subset (Scalars.support (bumps.values k).value) chart.domain :=
  \bysub(Chart, { c: Chart \where Space.Subset (Scalars.support (bumps.values k).value) c.domain }, charts k);
\import \root.WeightedChart[n := n].On[M := M].At[c := chart, b := (bumps.values k).value, within := within] \as Weighted;
\definition map: Maps.Map := Weighted.map;
\definition separates[x, y: M.Point]: Space.Member (bumps.values k).oneRegion x -> Maps.apply map x = Maps.apply map y -> x = y :=
  \fun (member: _) => Weighted.injectiveAtOne x y ((bumps.values k).oneOn x member);
\import Weighted.Plateau[U := (bumps.values k).oneRegion, open := (bumps.values k).regionOpen, oneOn := (bumps.values k).oneOn] \as Plateau;
\definition immerses[x: M.Point][inside: Space.Member (bumps.values k).oneRegion x]: _ := Plateau.At[x := x, inside := inside].immersion;
