\import manifolds.Dimension[n := d].Examples[].Euclidean[] \as Euclidean;
\import manifolds.Immersion[n := n, m := d].Between[M := M, N := Euclidean.smoothManifold] \as Embeddings;
\definition Embedding: \Set := Embeddings.Embedding;
\import manifolds.Dimension[n := d].Smooth[] \as Targets;
\definition target: Targets.Manifold := Euclidean.smoothManifold;
