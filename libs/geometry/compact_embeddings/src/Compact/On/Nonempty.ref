\module With(default: Chart);
\definition exists: (\exists M.Point) -> \exists Result := \block {
  \fun (nonempty: \exists M.Point) \then
  \takefrom x: M.Point \by nonempty \then
  \takefrom c: \Cast[Charts.Chart] ({ c: Charts.Chart \where Logic.And[Atlas.Member M.atlas c, Charts.Contains c x] }) \by M.atlas.covers x \then
  \let laws: Logic.And[Atlas.Member M.atlas c, Charts.Contains c x] := \bysub(Charts.Chart, { c: Charts.Chart \where Logic.And[Atlas.Member M.atlas c, Charts.Contains c x] }, c) \then
  \return With[default := \into[Charts.Chart](c, M.atlas.charts) \by { laws.left }].exists
};
