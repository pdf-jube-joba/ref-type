\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Logic.either;
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as Order;
\import Order.Arithmetic[].Prop[] \as Laws;
\import calculus.Blocks[n := a, m := b] \as Blocks;
\definition dimension: N.Nat^ := Blocks.dimension;
\import manifolds.Dimension[n := n].Smooth[] \as Sources;
\import manifolds.Dimension[n := a].Examples[].Euclidean[] \as Left;
\import manifolds.Dimension[n := b].Examples[].Euclidean[] \as Right;
\import manifolds.Dimension[n := dimension].Examples[].Euclidean[] \as Target;
\import linear_algebra.Euclidean[n := a].Blocks[m := b] \as LinearBlocks;
\import manifolds.EuclideanLinear[n := dimension, m := a].Of[L := LinearBlocks.leftMap] \as LeftProjection;
\import manifolds.EuclideanLinear[n := dimension, m := b].Of[L := LinearBlocks.rightMap] \as RightProjection;
\module Factor(p, q: N.Nat^);
\module Scale(d: N.Nat^);
\module On(M: Sources.Manifold);

\module Example;
