\import manifold_gluing.SmoothChainRule[n := p, m := q, l := r].Between[M := A, N := B, P := C].Of[f := f, g := g] \as FirstChain;
\import manifold_gluing.SmoothChainRule[n := p, m := q, l := s].Between[M := A, N := B, P := D].Of[f := f, g := h] \as SecondChain;
\definition first: boundary_manifolds.SmoothMap[n := p, m := r].Between[M := A, N := C].Map := FirstChain.map;
\definition second: boundary_manifolds.SmoothMap[n := p, m := s].Between[M := A, N := D].Map := SecondChain.map;
\module At(x: A.Point);
