\import manifold_gluing.CollarEmbedding[n := n].On[M := M].With[cover := cover] \as Collars;
\import manifold_gluing.BoundaryInclusion[n := n].On[M := M].With[cover := cover] \as BoundaryModel;
\import manifold_gluing.Parameter[] \as Time;
\import boundary_manifolds.Product[n := n, m := One.dimension].Of[M := BoundaryModel.manifold, N := Time.manifold] \as Product;
\import Boundary.Build[cover := cover] \as OrdinaryBoundary;
\import boundary_manifolds.Boundaryless[n := n].Of[M := OrdinaryBoundary.manifold] \as ConvertedBoundary;
\module From(construction: Collars.Construction);
\structure Result: \Set := {
  collar: Collars.Construction,
  width: Collars.From[deformation := collar.deformation].Of[regular := collar.regular].Width,
};
\definition exists[compact: Space.IsCompact M.space]: \exists Result := \block {
  \takefrom collar: Collars.Construction \by Collars.exists compact \then
  \takefrom width: Collars.From[deformation := collar.deformation].Of[regular := collar.regular].Width
    \by Collars.From[deformation := collar.deformation].Of[regular := collar.regular].existsWidth \then
  \return \exact(Result { collar := collar, width := width }, Result)
};
\module Built(result: Result, compact: Space.IsCompact M.space);
