\import \parent.From[construction := result.collar].Of[width := result.width].Compact[compact := compact] \as Construction;
\import boundary_manifolds.SmoothMap[n := Nat.add One.dimension n, m := One.dimension].Between[M := M, N := halfLine] \as Maps;
\definition map: Maps.Map := Construction.map;
\definition value[x: M.Point]: S.Real := Maps.apply map x One.index;
\definition zeroLocus: \forall (x: M.Point) -> Logic.PropEquiv[boundary_manifolds.Tangent[n := Nat.add One.dimension n].On[M := M].At[x := x].Cones[].Boundary, value x = S.zero] := Construction.zeroLocus;
\definition nonnegative: \forall (x: M.Point) -> R.Le S.zero (value x) := Construction.nonnegative;
