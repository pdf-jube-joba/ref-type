\import boundary_manifolds.Tangent[n := One.dimension].On[M := halfLine].At[x := t] \as Tangent;
\import LineManifolds.Chart[M := Ray.Point, space := Ray.topology] \as Charts;
\definition chart: Tangent.Chart := \into[Charts.Chart](Ray.chart, Tangent.Chart) \by {
  Tangent.ChartLaws[Ray.chart] { member := \refl(Ray.chart), contains := \refl(t) }
};
\definition boundaryOfZero: t One.index = S.zero -> Tangent.Cones[].Boundary := \fun (zero: t One.index = S.zero) =>
  Tangent.Cones[].boundaryOfCoordinate chart (Logic.existsIntro[One.Index, { i: One.Index \where LineModel.Active constraints t i }] One.index (Logic.And[_, _]::# (\refl(One.index)) zero));
\definition zeroOfBoundary: Tangent.Cones[].Boundary -> t One.index = S.zero := \block {
  \fun (boundary: Tangent.Cones[].Boundary) \then
  \takefrom i: \Cast[One.Index] ({ i: One.Index \where LineModel.Active constraints t i }) \by Tangent.Cones[].coordinateOfBoundary chart boundary \then
  \let active: LineModel.Active constraints t i := \bysub(One.Index, { i: One.Index \where LineModel.Active constraints t i }, i) \then
  \return trans!{S.Real} _ _ _ (congr!{One.Index S.Real} (\fun (j: One.Index) => t j) _ _ (sym!{One.Index} _ _ active.left)) active.right
};
\definition boundary: Logic.PropEquiv[Tangent.Cones[].Boundary, t One.index = S.zero] := Logic.PropEquiv[_, _] { ltr := zeroOfBoundary, rtl := boundaryOfZero };
