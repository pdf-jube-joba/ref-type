\import boundary_manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\import LineManifolds.Chart[M := Ray.Point, space := Ray.topology] \as TargetCharts;
\import boundary_manifolds.Model[n := n] \as Model;
\import calculus.Real[].Multivariable[n := n].Open[] \as SourceOpen;
\import calculus.Maps[n := n, m := One.dimension] \as Calculus;
\import boundary_manifolds.SmoothMap[n := n, m := One.dimension].Between[M := M, N := halfLine] \as Maps;
\definition function[x: M.Point]: Ray.Point := c;
\import manifold_gluing.LocalSmoothMap[n := n, m := One.dimension].Between[M := M, N := halfLine].Of[function := function] \as Local;
\module In(x: M.Point, chart: Local.SourceChart x);
\definition local: \forall (x: M.Point) -> \exists Local.Witness[x] := \block {
  \fun (x: M.Point) \then
  \takefrom chart: Local.SourceChart x \by M.atlas.covers x \then
  \return \exact(In[x := x, chart := chart].witness, Local.Witness[x])
};
\definition map: Maps.Map := Local.map (topology.Maps[A := M.Point, B := Ray.Point].constantContinuous M.space Ray.topology c) local;
