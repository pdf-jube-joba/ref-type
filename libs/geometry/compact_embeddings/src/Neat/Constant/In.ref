\definition right: Local.TargetChart (function x) := \into[TargetCharts.Chart](Ray.chart, Local.TargetChart (function x)) \by {
  Logic.And[_, _]::# (\refl(Ray.chart)) (\refl(c))
};
\definition ambient: Calculus.Map chart.image Open.whole := Calculus.Map[chart.image, Open.whole] {
  apply := \fun (u: SourceOpen.Carrier chart.image) => \into[LineModel.Point](c, Open.whole.points) \by { \refl(c \of LineModel.Point) },
  smooth := \fun (i: One.Index) => SourceOpen.Smooth[].Operations[].constantSmooth chart.image (c i),
};
\import Maps.At[function := function, left := chart, right := right, x := x, contains := Local.leftContains x chart] \as Extension;
\definition extension: Extension.Extension := Extension.Extension {
  neighborhood := chart.image,
  included := \fun (u: Model.Point)(member: \In[Model.Point] chart.image.points u) => member,
  contains := \bysub(Model.Point, chart.image.points, Extension.source),
  map := ambient,
  inside := \fun (u: Model.Carrier chart.constraints chart.image) => \refl(c),
  agrees := \fun (u: Model.Carrier chart.constraints chart.image) => \refl(c \of LineModel.Point),
};
\definition witness: Local.Witness[x] := Local.Witness[x] { left := chart, right := right, extension := extension };
