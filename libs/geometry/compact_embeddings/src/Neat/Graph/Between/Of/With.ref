\import boundary_manifolds.Neat[n := n, m := dimension].Between[M := M, N := target] \as Neat;
\module At(x: M.Point);
\definition laws: Neat.Laws[map] := Neat.Laws[map] {
  embedding := embedded,
  boundary := \fun (x: M.Point) => At[x := x].boundary,
  transverse := \fun (x: M.Point) => At[x := x].normal,
  reflects := \fun (x: M.Point)(v: Tangent.Vector x) => At[x := x].reflects v,
};
\definition neat: Neat.Embedding := \into[Maps.Map](map, Neat.Embedding) \by { laws };
