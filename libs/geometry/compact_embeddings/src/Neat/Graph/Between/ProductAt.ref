\import boundary_manifolds.Tangent[n := k].On[M := E].At[x := Product.first y] \as Left;
\import boundary_manifolds.Tangent[n := One.dimension].On[M := halfLine].At[x := Product.second y] \as Right;
\import boundary_manifolds.Tangent[n := dimension].On[M := target].At[x := y] \as Total;
\import manifold_gluing.ProductDifferential[n := k, m := One.dimension].Of[M := E, N := halfLine].At[x := y] \as Components;
\import manifold_gluing.ProductMaps[n := k, m := One.dimension].Of[M := E, N := halfLine] \as Projections;
\definition first: \forall (v: Total.Vector) -> Total.Cones[].Tangential v -> Left.Cones[].Tangential (Components.first v) :=
  manifold_gluing.DifferentialCones[n := dimension, m := k].Between[M := target, N := E].Of[f := Projections.First[].map].At[x := y].tangential;
\definition second: \forall (v: Total.Vector) -> Total.Cones[].Tangential v -> Right.Cones[].Tangential (Components.second v) :=
  manifold_gluing.DifferentialCones[n := dimension, m := One.dimension].Between[M := target, N := halfLine].Of[f := Projections.Second[].map].At[x := y].tangential;
\module In(c: Left.Chart, d: Right.Chart);
\definition join: \forall (v: Total.Vector) -> Left.Cones[].Tangential (Components.first v) -> Right.Cones[].Tangential (Components.second v) -> Total.Cones[].Tangential v := \block {
  \fun (v: Total.Vector)(left: Left.Cones[].Tangential (Components.first v))(right: Right.Cones[].Tangential (Components.second v)) \then
  \takefrom c: Left.Chart \by Left.chartExists \then
  \takefrom d: Right.Chart \by Right.chartExists \then
  \return In[c := c, d := d].join v left right
};
