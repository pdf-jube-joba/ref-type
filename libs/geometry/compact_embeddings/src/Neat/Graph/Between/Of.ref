\import manifold_gluing.ProductMaps[n := k, m := One.dimension].Of[M := E, N := halfLine].Pairing[p := n].From[P := M].Using[f := f, g := h] \as Pairing;
\definition map: Maps.Map := Pairing.map;
\import boundary_manifolds.Tangent[n := n].On[M := M] \as Tangent;
\import boundary_manifolds.Differential[n := n, m := dimension].Between[M := M, N := target] \as Differential;
\import topology.Topology[Carrier := M.Point] \as Space;
\import topology.Topology[Carrier := E.Point] \as FirstSpace;
\import topology.Topology[Carrier := Product.Point] \as TargetSpace;
\import topology.Continuity[A := M.Point, B := E.Point] \as FirstContinuous;
\import topology.Continuity[A := M.Point, B := Product.Point] \as Continuous;
\import topological_constructions.Product[A := E.Point, B := Ray.Point] \as ProductTopology;
\module At(x: M.Point);
\module First(laws: FirstEmbeddings.EmbeddingLaws[f]);
\module Compact(compact: Space.IsCompact M.space, immersion: Embeddings.IsImmersion map,
  injective: \forall (x, y: M.Point) -> Maps.apply map x = Maps.apply map y -> x = y);
\module With(embedded: Embeddings.EmbeddingLaws[map], noBoundary: NoBoundary, height: HeightLaws[h]);
