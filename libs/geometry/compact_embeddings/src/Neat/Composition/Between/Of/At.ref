\import boundary_manifolds.Tangent[n := n].On[M := M].At[x := x] \as Domain;
\import boundary_manifolds.Tangent[n := k].On[M := N].At[x := f.apply x] \as Middle;
\import boundary_manifolds.Tangent[n := l].On[M := P].At[x := map.apply x] \as Codomain;
\import boundary_manifolds.Differential[n := n, m := k].Between[M := M, N := N].At[f := f, x := x] \as Df;
\import boundary_manifolds.Differential[n := k, m := l].Between[M := N, N := P].At[f := g, x := f.apply x] \as Dg;
\import boundary_manifolds.Differential[n := n, m := l].Between[M := M, N := P].At[f := map, x := x] \as D;
\definition immersion: \forall (u, v: Domain.Vector) -> D.value.apply u = D.value.apply v -> u = v :=
  \fun (u, v: Domain.Vector)(same: D.value.apply u = D.value.apply v) => (First.embeddingLaws f).immersion x u v
    ((Second.embeddingLaws g).immersion (f.apply x) (Df.value.apply u) (Df.value.apply v)
      (trans!{Codomain.Vector} _ _ _ (sym!{Codomain.Vector} _ _ (Chain.At[x := x].pointwise u))
        (trans!{Codomain.Vector} _ _ _ same (Chain.At[x := x].pointwise v))));
