\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\import topology.Topology[Carrier := M.Point] \as Source;
\import topology.Topology[Carrier := N.Point] \as Target;
\import Source.Compactness[] \as SourceCompact;
\import Source.Finite[] \as SourceFinite;
\import Target.Compactness[] \as TargetCompact;
\import Target.Finite[] \as TargetFinite;
\import topology.Maps[A := M.Point, B := N.Point] \as Image;
\import topology.Compactness[A := M.Point, B := N.Point] \as Compact;
\import boundary_manifolds.SmoothMap[n := n, m := m].Between[M := M, N := N] \as Maps;
\import boundary_manifolds.Immersion[n := n, m := m].Between[M := M, N := N] \as Embeddings;
\module Of(f: Maps.Map, compact: Source.IsCompact M.space,
  injective: \forall (x, y: M.Point) -> Maps.apply f x = Maps.apply f y -> x = y);
