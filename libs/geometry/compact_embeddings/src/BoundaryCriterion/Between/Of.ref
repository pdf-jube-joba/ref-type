\definition continuous: topology.Continuity[A := M.Point, B := N.Point].Continuous M.space N.space (Maps.apply f) := f.continuous;
\module Open(S: \Pow M.Point, open: Source.IsOpenIn M.space S);
\definition openLift: \forall (S: \Pow M.Point) -> Source.IsOpenIn M.space S ->
  \exists ( U: \Pow N.Point \where Logic.And[Target.IsOpenIn N.space U, Image.Preimage (Maps.apply f) U = S] ) :=
  \fun (S: \Pow M.Point)(open: _) => Open[S := S, open := open].exists;
\definition embedding[immersion: Embeddings.IsImmersion f]: Embeddings.Embedding :=
  \into[Maps.Map](f, Embeddings.Embedding) \by {
    Embeddings.EmbeddingLaws[f] { immersion := immersion, injective := injective, openLift := openLift }
  };
