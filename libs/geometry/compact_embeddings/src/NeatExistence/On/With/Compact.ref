\import Doubles.Compact[compact := compact] \as Double;
\module Dimension(k: N.Nat^);
\definition Embedding[k: N.Nat^]: \Set := Dimension[k := k].Embedding;
\definition Compatible[k: N.Nat^][collar: Heights.Result][f: Embedding k]: \Prop := Dimension[k := k].Collar[collar := collar].Compatible f;
\structure Result: \Set := {
  dimension: N.Nat^,
  collar: Heights.Result,
  embedding: Embedding dimension,
  compatible: Compatible dimension collar embedding,
};
\module From(collar: Heights.Result, double: Double.Result);
\definition exists: \exists Result := \block {
  \takefrom collar: Heights.Result \by Heights.exists compact \then
  \takefrom double: Double.Result \by Double.exists \then
  \return From[collar := collar, double := double].exists
};
