\import Double.Using[result := double] \as DoubleModel;
\import \root.Bridge[n := dimension, m := dimension].Interior[M := DoubleModel.manifold, noBoundary := DoubleModel.noBoundary] \as Interior;
\import \root.Compact[n := dimension].On[M := Interior.ordinary] \as Closed;
\module Embedded(embedded: Closed.Result);
\definition exists: \exists Result := \block {
  \takefrom embedded: Closed.Result \by Closed.exists (Interior.Compact[].ordinaryCompact DoubleModel.compactManifold) \then
  \return \exact(Embedded[embedded := embedded].result, Result)
};
