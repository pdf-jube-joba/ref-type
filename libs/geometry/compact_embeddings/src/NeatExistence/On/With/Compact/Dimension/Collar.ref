\import Heights.From[construction := collar.collar].Of[width := collar.width].Compact[compact := compact] \as Height;
\import Height.Collapse[] \as Collapse;
\import manifold_gluing.BoundaryInclusion[n := n].On[M := M].With[cover := cover] \as BoundaryModel;
\import manifold_gluing.Parameter[] \as Time;
\import boundary_manifolds.Product[n := n, m := One.dimension].Of[M := BoundaryModel.manifold, N := Time.manifold] \as Parameters;
\import manifolds.Dimension[n := k].Examples[].Euclidean[] \as Ordinary;
\import boundary_manifolds.Boundaryless[n := k].Of[M := Ordinary.smoothManifold] \as Euclidean;
\import \root.Neat[n := n] \as HeightModel;
\import boundary_manifolds.Product[n := k, m := One.dimension].Of[M := Euclidean.manifold, N := HeightModel.halfLine] \as Product;
\definition radius: S.Real := Collapse.radius;
\definition positive: R.Lt S.zero radius := Collapse.positive;
\definition Compatible[f: Maps.Map]: \Prop := \forall (p: Collapse.parameters.Point) -> R.Le (Time.value (Parameters.second p)) radius ->
  Maps.apply f (Collapse.collarMap.apply p) = Pair.pair Euclidean.manifold.Point HeightModel.halfLine.Point
    (Product.first (Maps.apply f (Parameters.first p))) (\root.HeightNormal[n := n].TimeMap[].map.apply (Parameters.second p));
