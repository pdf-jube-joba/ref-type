\import std.Data[].Nat[].Basic[].Def[] \as Nat;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Classical[] \as Classical;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason;
\import real.Analysis[] \as S;
\import S.Algebra[] \as Algebra;
\import S.Estimates[] \as Estimates;
\import Estimates.Product[] \as Bounds;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import R.Order[] \as Order;
\import calculus.Real[].OneDimension[] \as One;
\import calculus.Real[].Multivariable[n := One.dimension].Open[] \as Open;
\import boundary_manifolds.Model[n := One.dimension] \as LineModel;
\import boundary_manifolds.Dimension[n := One.dimension] \as LineManifolds;
\definition constraints: LineModel.Constraints := LineModel.halfSpace One.index;
\import LineManifolds.Quadrant[C := constraints, U := Open.whole] \as Ray;
\definition halfLine: LineManifolds.Manifold := Ray.manifold;
\module Clamp(r: S.Real, positive: R.Lt S.zero r);
\import boundary_manifolds.Dimension[n := n] \as Models;
\module Constant(M: Models.Manifold, c: Ray.Point);
\import boundary_manifolds.Dimension[n := Nat.add One.dimension n] \as BoundaryModels;
\module Height(M: BoundaryModels.Manifold);
\module Graph(k: std.Data[].Nat[].Nat^);
\module LineAt(t: Ray.Point);
\module Composition(k, l: std.Data[].Nat[].Nat^);
