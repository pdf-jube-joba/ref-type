\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\import manifolds.Dimension[n := n].Smooth[] \as Models;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import calculus.Blocks[n := one, m := n] \as Blocks;
\definition dimension: N.Nat^ := Blocks.dimension;
\module On(M: Models.Manifold);
