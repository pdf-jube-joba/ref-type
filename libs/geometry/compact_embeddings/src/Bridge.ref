\import std.Data[].Nat[] \as Nat;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import manifolds.Dimension[n := n].Smooth[] \as Sources;
\import manifolds.Dimension[n := m].Smooth[] \as Targets;
\import boundary_manifolds.Dimension[n := n] \as BoundarySources;
\module Between(M: Sources.Manifold, N: Targets.Manifold);
\definition NoBoundary[M: BoundarySources.Manifold]: \Prop := \forall (x: M.Point) -> Logic.Not boundary_manifolds.Tangent[n := n].On[M := M].At[x := x].Cones[].Boundary;
\module Interior(M: BoundarySources.Manifold, noBoundary: NoBoundary M);
