\import std.Data[].Nat[] \as N;
\import N.Basic[].Def[] \as Nat;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import dedekind_reals.DedekindReal[] \as R;
\import calculus.Real[].OneDimension[] \as One;
\definition dimension: N.Nat^ := Nat.add One.dimension n;
\import boundary_manifolds.Dimension[n := n] \as Boundaries;
\import boundary_manifolds.Dimension[n := Nat.add One.dimension n] \as Models;
\import boundary_manifolds.Model[n := dimension] \as Model;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Open;
\import calculus.Maps[n := dimension, m := dimension] \as Calculus;
\import manifold_gluing.Parameter[] \as Time;
\module Insertion(epsilon: S.Real, positive: R.Lt S.zero epsilon, bounded: R.Le epsilon S.one);
\module Transport(M, P: Models.Manifold);
\module Factor(P, M, T: Models.Manifold);
\module On(M: Models.Manifold);
