\import manifolds.Dimension[n := dimension k].Examples[].Euclidean[] \as Euclidean;
\import manifolds.SmoothMap[n := n, m := dimension k].Between[M := M, N := Euclidean.smoothManifold] \as Maps;
\import manifolds.Differential[n := n, m := dimension k].Between[M := M, N := Euclidean.smoothManifold] \as D;
\definition Map: \Set := Maps.Map;
\definition Point: \Set := Euclidean.smoothManifold.Point;
\definition apply[f: Map]: M.Point -> Point := Maps.apply f;
\definition Immerses[f: Map][U: \Pow M.Point]: \Prop := \forall (x: M.Point) -> Space.Member U x -> \forall (u, v: Tangent.Vector x) ->
  D.At[f := f, x := x].value.apply u = D.At[f := f, x := x].value.apply v -> u = v;
