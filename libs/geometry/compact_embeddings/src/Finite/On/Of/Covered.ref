\import manifolds.Dimension[n := dimension k].Examples[].Euclidean[] \as Euclidean;
\definition injective: \forall (x, y: M.Point) -> apply k result.map x = apply k result.map y -> x = y :=
  \fun (x, y: M.Point) => result.separates x y (covers x (\refl(x)));
\import manifolds.Immersion[n := n, m := dimension k].Between[M := M, N := Euclidean.smoothManifold] \as Embeddings;
\definition immersion: Embeddings.IsImmersion result.map := \fun (x: M.Point) => result.immerses x (covers x (\refl(x)));
\definition embedding: Embeddings.Embedding := \root.CompactCriterion[n := n, m := dimension k].Between[M := M, N := Euclidean.smoothManifold].Of[
  f := result.map, compact := compact, injective := injective].embedding immersion;
