\import \root.Pair[n := n, a := dimension k, b := d].On[M := M].Of[f := previous.map, g := f k] \as Pair;
\definition result: Result[N.Nat^::succ k] := Result[N.Nat^::succ k] {
  map := Pair.map,
  separates := \fun (x, y: M.Point)(member: Space.Member (region (N.Nat^::succ k)) x)(equal: _) => either!{member {x = y}
    {\fun (old: _) => previous.separates x y old (Pair.leftEqual x y equal)}
    {\fun (new: _) => separates k x y new (Pair.rightEqual x y equal)}
  },
  immerses := \fun (x: M.Point)(member: Space.Member (region (N.Nat^::succ k)) x)(u, v: Tangent.Vector x)(equal: _) => either!{member {u = v}
    {\fun (old: _) => previous.immerses x old u v (Pair.At[x := x].leftEqual u v equal)}
    {\fun (new: _) => immerses k x new u v (Pair.At[x := x].rightEqual u v equal)}
  },
};
