\import manifolds.EuclideanPair[n := a, m := b].From[p := n].On[X := M].Of[f := f, g := g] \as Pair;
\definition map: Maps.Map := Pair.map;
\import manifolds.Composition[n := n, m := dimension, l := a].Between[M := M, N := Target.smoothManifold, P := Left.smoothManifold] \as LeftComposition;
\import manifolds.Composition[n := n, m := dimension, l := b].Between[M := M, N := Target.smoothManifold, P := Right.smoothManifold] \as RightComposition;
\definition leftComposite: LeftComposition.compose map left = f := LeftMaps.ext _ _
  (\axiom:funext((LeftMaps.apply (LeftComposition.compose map left)), (LeftMaps.apply f), \fun (x: M.Point) => Blocks.leftJoin (LeftMaps.apply f x) (RightMaps.apply g x)));
\definition rightComposite: RightComposition.compose map right = g := RightMaps.ext _ _
  (\axiom:funext((RightMaps.apply (RightComposition.compose map right)), (RightMaps.apply g), \fun (x: M.Point) => Blocks.rightJoin (LeftMaps.apply f x) (RightMaps.apply g x)));
\definition leftEqual[x, y: M.Point]: Maps.apply map x = Maps.apply map y -> LeftMaps.apply f x = LeftMaps.apply f y :=
  \fun (equal: _) => trans!{{LeftPoints.Point}} _ _ _ (sym!{{LeftPoints.Point}} _ _ (Blocks.leftJoin (LeftMaps.apply f x) (RightMaps.apply g x)))
    (trans!{{LeftPoints.Point}} _ _ _ (congr!{{TargetPoints.Point} {LeftPoints.Point}} Blocks.left _ _ equal) (Blocks.leftJoin (LeftMaps.apply f y) (RightMaps.apply g y)));
\definition rightEqual[x, y: M.Point]: Maps.apply map x = Maps.apply map y -> RightMaps.apply g x = RightMaps.apply g y :=
  \fun (equal: _) => trans!{{RightPoints.Point}} _ _ _ (sym!{{RightPoints.Point}} _ _ (Blocks.rightJoin (LeftMaps.apply f x) (RightMaps.apply g x)))
    (trans!{{RightPoints.Point}} _ _ _ (congr!{{TargetPoints.Point} {RightPoints.Point}} Blocks.right _ _ equal) (Blocks.rightJoin (LeftMaps.apply f y) (RightMaps.apply g y)));
\module At(x: M.Point);
