\import manifolds.Differential[n := n, m := dimension].Between[M := M, N := Target.smoothManifold].At[f := map, x := x] \as D;
\import manifolds.Differential[n := n, m := a].Between[M := M, N := Left.smoothManifold] \as LD;
\import manifolds.Differential[n := n, m := b].Between[M := M, N := Right.smoothManifold] \as RD;
\import manifolds.ImmersionComposition[n := n, m := dimension, l := a].Between[M := M, N := Target.smoothManifold, P := Left.smoothManifold].Of[f := map, g := left].At[x := x] \as LC;
\import manifolds.ImmersionComposition[n := n, m := dimension, l := b].Between[M := M, N := Target.smoothManifold, P := Right.smoothManifold].Of[f := map, g := right].At[x := x] \as RC;
\definition leftEqual[u, v: Tangent.Vector x]: D.value.apply u = D.value.apply v -> LD.At[f := f, x := x].value.apply u = LD.At[f := f, x := x].value.apply v :=
  \fun (equal: _) => \idelim LeftComposition.compose map left = f \with h: LeftMaps.Map => LD.At[f := h, x := x].value.apply u = LD.At[f := h, x := x].value.apply v \by {
    base: LC.fromFirstEquality u v equal, equality: leftComposite
  };
\definition rightEqual[u, v: Tangent.Vector x]: D.value.apply u = D.value.apply v -> RD.At[f := g, x := x].value.apply u = RD.At[f := g, x := x].value.apply v :=
  \fun (equal: _) => \idelim RightComposition.compose map right = g \with h: RightMaps.Map => RD.At[f := h, x := x].value.apply u = RD.At[f := h, x := x].value.apply v \by {
    base: RC.fromFirstEquality u v equal, equality: rightComposite
  };
