\import manifolds.Dimension[n := n].Examples[].Empty[] \as Model;
\import topology.Topology[Carrier := Model.Point] \as Space;
\import Space.Compactness[] \as Compact;
\definition compact: Space.IsCompact Model.smoothManifold.space := \idelim Space.Empty = Space.Whole \with U: \Pow Model.Point => Space.IsCompactIn Model.smoothManifold.space U \by {
  base: Compact.emptyCompact Model.smoothManifold.space,
  equality: \axiom:setext(Space.Empty, Space.Whole, \fun (x: Model.Point)(member: _) => \refl(x),
    \fun (x: Model.Point)(member: _) => Model.impossible x)
};
\import \root.Compact[n := n].On[M := Model.smoothManifold] \as Construction;
\definition exists: \exists Construction.Result := Construction.exists compact;
