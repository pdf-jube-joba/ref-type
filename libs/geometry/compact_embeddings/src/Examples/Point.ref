\import manifolds.Dimension[n := zero].Examples[].Euclidean[] \as Model;
\import manifolds.Dimension[n := one].Examples[].Euclidean[] \as Line;
\import topological_algebra.Euclidean[].Zero[] \as Singleton;
\import \root.Compact[n := zero].On[M := Model.smoothManifold] \as Construction;
\definition exists: \exists Construction.Result := Construction.exists smooth_partitions.Examples[].Point[].compact;
\import \root.WeightedChart[n := zero].On[M := Model.smoothManifold].Vector[m := one] \as IntoLine;
\import \root.WeightedChart[n := one].On[M := Line.smoothManifold].Vector[m := zero] \as FromLine;
\definition returnValue[x: Line.smoothManifold.Point]: Model.smoothManifold.Point := Singleton.origin;
\definition returnRegular: \forall (i: Fin.Fin zero) -> smooth_partitions.Manifold[n := one].On[M := Line.smoothManifold].IsSmooth (\fun (x: Line.smoothManifold.Point) => returnValue x i) :=
  \fun (i: Fin.Fin zero) => Logic.falseElim _ (Fin.zeroImpossible i (Fin.bound zero i));
\import FromLine.Of[f := returnValue, regular := returnRegular] \as Return;
\module At(a: R.Real);
\import \root.Stabilization[n := zero, a := one, b := one].On[M := Model.smoothManifold].Between[f := At[a := R.zero].embedding, g := At[a := R.one].embedding] \as Motion;
\import calculus.Blocks[n := one, m := one] \as Blocks;
\import manifolds.Dimension[n := Blocks.dimension].Examples[].Euclidean[] \as Plane;
\import manifolds.Immersion[n := zero, m := Blocks.dimension].Between[M := Model.smoothManifold, N := Plane.smoothManifold] \as PlaneEmbeddings;
\definition path[t: R.Real]: PlaneEmbeddings.Embedding := Motion.embedding t;
\definition relative[t: R.Real]: PlaneEmbeddings.Embedding := Motion.Relative[].embeddingAt t;
