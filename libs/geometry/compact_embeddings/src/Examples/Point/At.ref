\import smooth_partitions.Manifold[n := zero].On[M := Model.smoothManifold] \as Scalars;
\import calculus.Real[].Multivariable[n := zero].Open[].Smooth[].Operations[] \as Operations;
\definition value[x: Model.smoothManifold.Point][i: Fin.Fin one]: R.Real := a;
\definition regular: \forall (i: Fin.Fin one) -> Scalars.IsSmooth (\fun (x: Model.smoothManifold.Point) => value x i) :=
  \fun (i: Fin.Fin one)(c: Scalars.Chart) =>
    Operations.constantSmooth c.image a;
\import IntoLine.Of[f := value, regular := regular] \as Into;
\definition inverse[x: Model.smoothManifold.Point]: returnValue (value x) = x := Singleton.unique Singleton.origin x;
\import manifolds.EmbeddingRetraction[n := zero, m := one].Between[M := Model.smoothManifold, N := Line.smoothManifold].Of[f := Into.map, g := Return.map, left := inverse] \as Retraction;
\import manifolds.Immersion[n := zero, m := one].Between[M := Model.smoothManifold, N := Line.smoothManifold] \as Embeddings;
\definition embedding: Embeddings.Embedding := Retraction.embedding;
