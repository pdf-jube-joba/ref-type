\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\use Logic.either;
\import manifolds.Dimension[n := n].Smooth[] \as Sources;
\import manifolds.Dimension[n := d].Examples[].Euclidean[] \as Block;
\definition dimension: N.Nat^ -> N.Nat^ := \induction (k: N.Nat^) \return N.Nat^ \with {
  | zero: d
  | succ: \fun (k: N.Nat^)(previous: N.Nat^) => N.Basic[].Def[].add d previous
};
\module On(M: Sources.Manifold);
