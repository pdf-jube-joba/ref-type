\definition value[t: R.Real][x: M.Point]: Target.smoothManifold.Point := Blocks.join
  (\fun (i: Fin.Fin a) => R.mul (R.sub R.one t) (LeftMaps.apply f x i))
  (\fun (i: Fin.Fin b) => R.mul t (RightMaps.apply g x i));
\module At(t: R.Real);
\definition embedding[t: R.Real]: Embeddings.Embedding := At[t := t].embedding;
\definition formula[t: R.Real][x: M.Point]: Maps.apply (embedding t) x = value t x := \refl(value t x);
\definition leftEndpoint[x: M.Point]: value R.zero x = Blocks.join (LeftMaps.apply f x) (\fun (i: Fin.Fin b) => R.zero) :=
  congr!{{Left.smoothManifold.Point} {Right.smoothManifold.Point} {Target.smoothManifold.Point}} Blocks.join _ _ _ _
    (\axiom:funext((\fun (i: Fin.Fin a) => R.mul (R.sub R.one R.zero) (LeftMaps.apply f x i)), (LeftMaps.apply f x),
      \fun (i: Fin.Fin a) => trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (\fun (c: R.Real) => R.mul c (LeftMaps.apply f x i)) _ _ (Laws.subZeroRight R.one)) (Laws.fieldMulOneLeft (LeftMaps.apply f x i))))
    (\axiom:funext((\fun (i: Fin.Fin b) => R.mul R.zero (RightMaps.apply g x i)), (\fun (i: Fin.Fin b) => R.zero),
      \fun (i: Fin.Fin b) => Laws.fieldMulZeroLeft (RightMaps.apply g x i)));
\definition rightEndpoint[x: M.Point]: value R.one x = Blocks.join (\fun (i: Fin.Fin a) => R.zero) (RightMaps.apply g x) :=
  congr!{{Left.smoothManifold.Point} {Right.smoothManifold.Point} {Target.smoothManifold.Point}} Blocks.join _ _ _ _
    (\axiom:funext((\fun (i: Fin.Fin a) => R.mul (R.sub R.one R.one) (LeftMaps.apply f x i)), (\fun (i: Fin.Fin a) => R.zero),
      \fun (i: Fin.Fin a) => trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (\fun (c: R.Real) => R.mul c (LeftMaps.apply f x i)) _ _ (Laws.subSelf R.one)) (Laws.fieldMulZeroLeft (LeftMaps.apply f x i))))
    (\axiom:funext((\fun (i: Fin.Fin b) => R.mul R.one (RightMaps.apply g x i)), (RightMaps.apply g x),
      \fun (i: Fin.Fin b) => Laws.fieldMulOneLeft (RightMaps.apply g x i)));

\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\definition Chart: \Set := \Cast[Charts.Chart] M.atlas.charts;
\module Parameters(k: N.Nat^);
\module Relative;

\module Naturality(p: N.Nat^);

\module Linear;
