\import manifolds.SmoothMap[n := p, m := n].Between[M := P, N := M] \as InputsMaps;
\import manifolds.Immersion[n := p, m := a].Between[M := P, N := Left.smoothManifold] \as L;
\import manifolds.Immersion[n := p, m := b].Between[M := P, N := Right.smoothManifold] \as G;
\import manifolds.SmoothMap[n := p, m := a].Between[M := P, N := Left.smoothManifold] \as LMaps;
\import manifolds.SmoothMap[n := p, m := b].Between[M := P, N := Right.smoothManifold] \as GMaps;
\import manifolds.Composition[n := p, m := n, l := a].Between[M := P, N := M, P := Left.smoothManifold] \as LC;
\import manifolds.Composition[n := p, m := n, l := b].Between[M := P, N := M, P := Right.smoothManifold] \as GC;
\definition first: L.Embedding := \into[LMaps.Map](LC.compose h f, L.Embedding) \by {
  manifolds.ImmersionComposition[n := p, m := n, l := a].Between[M := P, N := M, P := Left.smoothManifold].embedding h f };
\definition second: G.Embedding := \into[GMaps.Map](GC.compose h g, G.Embedding) \by {
  manifolds.ImmersionComposition[n := p, m := n, l := b].Between[M := P, N := M, P := Right.smoothManifold].embedding h g };
\import \root.Stabilization[n := p, a := a, b := b].On[M := P].Between[f := first, g := second] \as Restricted;
\definition natural[t: R.Real][x: P.Point]: Restricted.value t x = value t (InputsMaps.apply h x) := \refl(value t (InputsMaps.apply h x));
\definition relative[t: R.Real][x: P.Point]:
  manifolds.SmoothMap[n := p, m := dimension].Between[M := P, N := Target.smoothManifold].apply (Restricted.Relative[].embeddingAt t) x =
  Maps.apply (\parent.\parent.\parent.Relative[].embeddingAt t) (InputsMaps.apply h x) := \refl(value (smooth_partitions.Exponential[].Step[].value t) (InputsMaps.apply h x));
