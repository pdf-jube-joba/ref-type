\import manifolds.Composition[n := n, m := dimension, l := a].Between[M := M, N := Target.smoothManifold, P := Left.smoothManifold] \as Compose;
\definition recover[x: M.Point]: LeftMaps.apply (Compose.compose map LeftProjection.map) x = LeftMaps.apply f x :=
  trans!{{Left.smoothManifold.Point}} _ _ _ (Blocks.leftJoin (LeftMaps.apply left x) (RightMaps.apply right x))
    (\axiom:funext((LeftMaps.apply left x), (LeftMaps.apply f x), \fun (i: Fin.Fin a) =>
      trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (\fun (s: R.Real) => R.mul (R.sub R.one s) (LeftMaps.apply f x i)) _ _ zero)
        (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (\fun (c: R.Real) => R.mul c (LeftMaps.apply f x i)) _ _ (Laws.subZeroRight R.one)) (Laws.fieldMulOneLeft (LeftMaps.apply f x i)))));
\definition equal: Compose.compose map LeftProjection.map = f := LeftMaps.ext (Compose.compose map LeftProjection.map) f (\axiom:funext((LeftMaps.apply (Compose.compose map LeftProjection.map)), (LeftMaps.apply f), recover));
\definition laws: Embeddings.EmbeddingLaws[map] := \root.Stabilization[n := n, a := a, b := b].Factor[p := dimension, q := a].Between[M := M, N := Target.smoothManifold, P := Left.smoothManifold].Of[
  f := map, g := LeftProjection.map, h := f, equal := equal].laws;
