\import Family.Local[c := c] \as Joint;
\import calculus.Blocks[n := One.dimension, m := n] \as DomainBlocks;
\import calculus.Real[].Multivariable[n := DomainBlocks.dimension].Open[] \as Open;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Output;
\import calculus.Maps[n := DomainBlocks.dimension, m := dimension] \as JointMaps;
\definition domain: Open.OpenSet := Joint.domain;
\definition map: JointMaps.Map domain Output.whole := Joint.map;
\import DomainBlocks.On[U := Time.whole, V := c.image] \as Product;
\definition formula[u: Open.Carrier domain]: JointMaps.apply domain Output.whole map u =
  value (clock (Product.leftPoint u)) (Charts.point c (Product.rightPoint u)) := Joint.formula u;
