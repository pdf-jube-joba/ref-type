\import manifolds.Composition[n := n, m := a, l := a].Between[M := M, N := Left.smoothManifold, P := Left.smoothManifold] \as LeftCompose;
\import manifolds.Composition[n := n, m := b, l := b].Between[M := M, N := Right.smoothManifold, P := Right.smoothManifold] \as RightCompose;
\definition left: LeftMaps.Map := LeftCompose.compose f \root.Stabilization[n := n, a := a, b := b].Scale[d := a].At[c := R.sub R.one t].map;
\definition right: RightMaps.Map := RightCompose.compose g \root.Stabilization[n := n, a := a, b := b].Scale[d := b].At[c := t].map;
\import manifolds.EuclideanPair[n := a, m := b].From[p := n].On[X := M].Of[f := left, g := right] \as Pair;
\definition map: Maps.Map := Pair.map;
\module Zero(zero: t = R.zero);
\module Nonzero(nonzero: Logic.Not (t = R.zero));
\definition laws: Embeddings.EmbeddingLaws[map] := either!{{(Classical.excludedMiddle (t = R.zero))} {Embeddings.EmbeddingLaws[map]}
  {\fun (zero: _) => Zero[zero := zero].laws}
  {\fun (nonzero: _) => Nonzero[nonzero := nonzero].laws}
};
\definition embedding: Embeddings.Embedding := \into[Maps.Map](map, Embeddings.Embedding) \by { laws };
