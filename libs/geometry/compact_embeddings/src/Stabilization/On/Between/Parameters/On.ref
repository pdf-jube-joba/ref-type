\definition embeddingAt[u: ParameterOpen.Carrier U]: Embeddings.Embedding := embedding (s u);
\definition formula[u: ParameterOpen.Carrier U][x: M.Point]: Maps.apply (embeddingAt u) x = value (s u) x := \refl(value (s u) x);
\module Local(c: Chart);
\definition fixedLeft[u: ParameterOpen.Carrier U]: s u = R.zero -> \forall (x: M.Point) ->
  Maps.apply (embeddingAt u) x = Blocks.join (LeftMaps.apply f x) (\fun (i: Fin.Fin b) => R.zero) :=
  \fun (zero: _)(x: M.Point) => trans!{{Target.smoothManifold.Point}} _ _ _
    (congr!{R.Real {Target.smoothManifold.Point}} (\fun (t: R.Real) => value t x) _ _ zero) (leftEndpoint x);
\definition fixedRight[u: ParameterOpen.Carrier U]: s u = R.one -> \forall (x: M.Point) ->
  Maps.apply (embeddingAt u) x = Blocks.join (\fun (i: Fin.Fin a) => R.zero) (RightMaps.apply g x) :=
  \fun (one: _)(x: M.Point) => trans!{{Target.smoothManifold.Point}} _ _ _
    (congr!{R.Real {Target.smoothManifold.Point}} (\fun (t: R.Real) => value t x) _ _ one) (rightEndpoint x);

\module Reparametrization(j: N.Nat^);
