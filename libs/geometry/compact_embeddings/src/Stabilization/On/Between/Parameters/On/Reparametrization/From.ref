\import ParameterMaps.Composition[U := V, V := U, f := r] \as Pullback;
\definition clock: NewOpen.Smooth[].Derivative[].Function V := Pullback.function s;
\import \root.Stabilization[n := n, a := a, b := b].On[M := M].Between[f := f, g := g].Parameters[k := j].On[U := V, s := clock] \as Reparametrized;
\definition natural[v: NewOpen.Carrier V][x: M.Point]: Maps.apply (Reparametrized.embeddingAt v) x =
  Maps.apply (embeddingAt (ParameterMaps.apply V U r v)) x := \refl(value (s (ParameterMaps.apply V U r v)) x);
