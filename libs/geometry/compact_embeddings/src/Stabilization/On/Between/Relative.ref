\import calculus.Real[].OneDimension[] \as One;
\import calculus.Real[].Multivariable[n := One.dimension].Open[] \as Time;
\import smooth_partitions.Exponential[].Step[] \as Step;
\definition clock: Time.Smooth[].Derivative[].Function Time.whole :=
  \into[Time.ScalarFunction Time.whole]((\fun (u: Time.Carrier Time.whole) => Step.value (u One.index)),
    { h: Time.ScalarFunction Time.whole \where Time.Smooth[].SmoothOn Time.whole h }) \by { Step.smooth };
\import \parent.Parameters[k := One.dimension].On[U := Time.whole, s := clock] \as Family;
\definition embeddingAt[t: R.Real]: Embeddings.Embedding := embedding (Step.value t);
\definition fixedLeft[t: R.Real]: Order.Le t R.zero -> \forall (x: M.Point) -> Maps.apply (embeddingAt t) x =
  Blocks.join (LeftMaps.apply f x) (\fun (i: Fin.Fin b) => R.zero) :=
  \fun (before: _)(x: M.Point) => trans!{{Target.smoothManifold.Point}} _ _ _
    (congr!{R.Real {Target.smoothManifold.Point}} (\fun (s: R.Real) => value s x) _ _ (Step.zeroOn t before)) (leftEndpoint x);
\definition fixedRight[t: R.Real]: Order.Le R.one t -> \forall (x: M.Point) -> Maps.apply (embeddingAt t) x =
  Blocks.join (\fun (i: Fin.Fin a) => R.zero) (RightMaps.apply g x) :=
  \fun (after: _)(x: M.Point) => trans!{{Target.smoothManifold.Point}} _ _ _
    (congr!{R.Real {Target.smoothManifold.Point}} (\fun (s: R.Real) => value s x) _ _ (Step.oneOn t after)) (rightEndpoint x);

\module InChart(c: Chart);
