\import calculus.Real[].OneDimension[] \as One;
\import calculus.Real[].Multivariable[n := One.dimension].Open[] \as Time;
\definition clock: Time.Smooth[].Derivative[].Function Time.whole :=
  \into[Time.ScalarFunction Time.whole]((\fun (u: Time.Carrier Time.whole) => u One.index),
    { h: Time.ScalarFunction Time.whole \where Time.Smooth[].SmoothOn Time.whole h }) \by { Time.Examples[].projectionSmooth Time.whole One.index };
\import \parent.Parameters[k := One.dimension].On[U := Time.whole, s := clock] \as Family;
\module InChart(c: Chart);
