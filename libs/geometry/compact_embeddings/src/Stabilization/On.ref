\import manifolds.SmoothMap[n := n, m := a].Between[M := M, N := Left.smoothManifold] \as LeftMaps;
\import manifolds.SmoothMap[n := n, m := b].Between[M := M, N := Right.smoothManifold] \as RightMaps;
\import manifolds.SmoothMap[n := n, m := dimension].Between[M := M, N := Target.smoothManifold] \as Maps;
\import manifolds.Immersion[n := n, m := a].Between[M := M, N := Left.smoothManifold] \as LeftEmbeddings;
\import manifolds.Immersion[n := n, m := b].Between[M := M, N := Right.smoothManifold] \as RightEmbeddings;
\import manifolds.Immersion[n := n, m := dimension].Between[M := M, N := Target.smoothManifold] \as Embeddings;
\module Between(f: LeftEmbeddings.Embedding, g: RightEmbeddings.Embedding);
