\import manifolds.SmoothMap[n := n, m := p].Between[M := M, N := N] \as F;
\import manifolds.SmoothMap[n := p, m := q].Between[M := N, N := P] \as G;
\import manifolds.SmoothMap[n := n, m := q].Between[M := M, N := P] \as H;
\import manifolds.Immersion[n := n, m := p].Between[M := M, N := N] \as First;
\import manifolds.Immersion[n := n, m := q].Between[M := M, N := P] \as Composite;
\import manifolds.Composition[n := n, m := p, l := q].Between[M := M, N := N, P := P] \as Compose;
\import topology.Topology[Carrier := M.Point] \as SourceSpace;
\import topology.Topology[Carrier := N.Point] \as MiddleSpace;
\import topology.Topology[Carrier := P.Point] \as TargetSpace;
\import topology.Continuity[A := M.Point, B := N.Point] \as FTopology;
\import topology.Continuity[A := N.Point, B := P.Point] \as GTopology;
\import topology.Continuity[A := M.Point, B := P.Point] \as HTopology;
\module Of(f: F.Map, g: G.Map, h: Composite.Embedding, equal: Compose.compose f g = h);
