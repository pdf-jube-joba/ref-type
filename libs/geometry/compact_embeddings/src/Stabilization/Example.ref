\import calculus.Real[].OneDimension[] \as One;
\import manifolds.Dimension[n := One.dimension].Examples[].Euclidean[] \as Line;
\import manifolds.SelfMap[n := One.dimension].Identity[M := Line.smoothManifold] \as Identity;
\import manifolds.EmbeddingRetraction[n := One.dimension, m := One.dimension].Between[M := Line.smoothManifold, N := Line.smoothManifold].Of[
  f := Identity.map, g := Identity.map, left := \fun (x: Line.smoothManifold.Point) => \refl(x)] \as Embedded;
\import \root.Stabilization[n := One.dimension, a := One.dimension, b := One.dimension].On[M := Line.smoothManifold].Between[f := Embedded.embedding, g := Embedded.embedding] \as Rotation;
\definition first[x: Line.smoothManifold.Point]: Rotation.value R.zero x = calculus.Blocks[n := One.dimension, m := One.dimension].join x (\fun (i: One.Index) => R.zero) := Rotation.leftEndpoint x;
\definition last[x: Line.smoothManifold.Point]: Rotation.value R.one x = calculus.Blocks[n := One.dimension, m := One.dimension].join (\fun (i: One.Index) => R.zero) x := Rotation.rightEndpoint x;
\import calculus.Blocks[n := One.dimension, m := One.dimension] \as Plane;
\import manifolds.Dimension[n := Plane.dimension].Examples[].Euclidean[] \as PlaneModel;
\import manifolds.SmoothMap[n := One.dimension, m := Plane.dimension].Between[M := Line.smoothManifold, N := PlaneModel.smoothManifold] \as PlaneMaps;
\definition stationaryFirst[t: R.Real]: Order.Le t R.zero -> \forall (x: Line.smoothManifold.Point) ->
  PlaneMaps.apply (Rotation.Relative[].embeddingAt t) x = Plane.join x (\fun (i: One.Index) => R.zero) := Rotation.Relative[].fixedLeft t;
