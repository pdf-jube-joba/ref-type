\import manifolds.Tangent[n := n].On[M := M].At[x := Source.backward x] \as Domain;
\import manifolds.Tangent[n := m].On[M := N].At[x := Ordinary.apply f (Source.backward x)] \as Codomain;
\module In(c: Domain.Chart, d: Codomain.Chart);
\definition exists: \exists Locality.Witness[x] := \block {
  \takefrom c: Domain.Chart \by Domain.chartExists \then
  \takefrom d: Codomain.Chart \by Codomain.chartExists \then
  \return \exact(In[c := c, d := d].witness, Locality.Witness[x])
};
