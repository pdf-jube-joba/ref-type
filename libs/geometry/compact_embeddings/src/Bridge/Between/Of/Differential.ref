\import manifolds.Tangent[n := n].On[M := M].At[x := Source.backward x] \as OldDomain;
\import manifolds.Tangent[n := m].On[M := N].At[x := Ordinary.apply f (Source.backward x)] \as OldCodomain;
\import boundary_manifolds.Tangent[n := n].On[M := source].At[x := x] \as Domain;
\import boundary_manifolds.Tangent[n := m].On[M := target].At[x := apply x] \as Codomain;
\module In(c: OldDomain.Chart, d: OldCodomain.Chart);
\definition injective[immersion: OldEmbeddings.IsImmersion f]: \forall (u, v: Domain.Vector) ->
  boundary_manifolds.Differential[n := n, m := m].Between[M := source, N := target].At[f := map, x := x].value.apply u =
  boundary_manifolds.Differential[n := n, m := m].Between[M := source, N := target].At[f := map, x := x].value.apply v -> u = v := \block {
    \fun (u, v: Domain.Vector)(same: _) \then
    \takefrom c: OldDomain.Chart \by OldDomain.chartExists \then
    \takefrom d: OldCodomain.Chart \by OldCodomain.chartExists \then
    \return In[c := c, d := d].injective immersion u v same
};
