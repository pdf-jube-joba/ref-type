\definition apply[x: source.Point]: target.Point := Target.forward (Ordinary.apply f (Source.backward x));
\import topology.Composition[A := source.Point, B := M.Point, C := N.Point] \as First;
\definition firstContinuous: topology.Continuity[A := source.Point, B := N.Point].Continuous source.space N.space
  (\fun (x: source.Point) => Ordinary.apply f (Source.backward x)) := First.composeContinuous source.space M.space N.space Source.backward (Ordinary.apply f)
    (topology.Homeomorphism[A := M.Point, B := source.Point].laws M.space source.space Source.comparison).backwardContinuous
    (\bysub(Ordinary.Data, { h: Ordinary.Data \where Ordinary.Continuous h }, f));
\definition continuous: topology.Continuity[A := source.Point, B := target.Point].Continuous source.space target.space apply :=
  topology.Composition[A := source.Point, B := N.Point, C := target.Point].composeContinuous source.space N.space target.space
    (\fun (x: source.Point) => Ordinary.apply f (Source.backward x)) Target.forward firstContinuous
    (topology.Homeomorphism[A := N.Point, B := target.Point].laws N.space target.space Target.comparison).forwardContinuous;
\import manifold_gluing.LocalSmoothMap[n := n, m := m].Between[M := source, N := target].Of[function := apply] \as Locality;
\module At(x: source.Point);
\definition local: \forall (x: source.Point) -> \exists Locality.Witness[x] := \fun (x: source.Point) => At[x := x].exists;
\definition map: Maps.Map := Locality.map continuous local;
\definition formula[x: source.Point]: Maps.apply map x = Target.forward (Ordinary.apply f (Source.backward x)) := \refl(apply x);
\module Differential(x: source.Point);
\module Embedded(laws: OldEmbeddings.EmbeddingLaws[f]);
