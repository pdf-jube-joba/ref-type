\import topology.Topology[Carrier := Interior.Point] \as OrdinarySpace;
\import topology.Maps[A := M.Point, B := Interior.Point] \as IntrinsicImage;
\definition onto: \forall (y: Interior.Point) -> \exists ( x: M.Point \where intrinsic x = y ) :=
  \fun (y: Interior.Point) => Logic.existsIntro[M.Point, { x: M.Point \where intrinsic x = y }] (y \of M.Point)
    (boundary_manifolds.Refinement[A := M.Point].equality Interior.points (intrinsic y) y (\refl(y \of M.Point)));
\import topology.Compactness[A := M.Point, B := Interior.Point] \as CompactImage;
\definition ordinaryCompact: Space.IsCompact M.space -> OrdinarySpace.IsCompact Interior.topology :=
  \fun (compactM: Space.IsCompact M.space) => CompactImage.surjectiveImage M.space Interior.topology intrinsic intrinsicContinuous onto compactM;
