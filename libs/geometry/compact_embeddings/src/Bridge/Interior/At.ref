\import Inclusion.InverseAt[x := apply x] \as Inverse;
\definition agrees: \forall (y: M.Point) -> apply y = Inverse.function y :=
  \fun (y: M.Point) => sym!{{target.Point}} _ _ (Inverse.inside (intrinsic y));
\definition Witness[h: M.Point -> target.Point]: \Set :=
  manifold_gluing.LocalSmoothMap[n := n, m := n].Between[M := M, N := target].Of[function := h].Witness[x];
\definition same: Inverse.function = apply := \axiom:funext(Inverse.function, apply,
  \fun (y: M.Point) => sym!{{target.Point}} _ _ (agrees y));
\definition exists: \exists Locality.Witness[x] :=
  \idelim Inverse.function = apply \with h: (M.Point -> target.Point) => \exists Witness h \by {
    base: Inverse.exists, equality: same
  };
