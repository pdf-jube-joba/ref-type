\import manifolds.SmoothMap[n := n, m := m].Between[M := M, N := N] \as Ordinary;
\import boundary_manifolds.Boundaryless[n := n].Of[M := M] \as Source;
\import boundary_manifolds.Boundaryless[n := m].Of[M := N] \as Target;
\definition source: BoundarySources.Manifold := Source.manifold;
\import boundary_manifolds.Dimension[n := m] \as BoundaryTargets;
\definition target: BoundaryTargets.Manifold := Target.manifold;
\import topology.Topology[Carrier := M.Point] \as OldSourceSpace;
\import topology.Topology[Carrier := N.Point] \as OldTargetSpace;
\import topology.Topology[Carrier := source.Point] \as SourceSpace;
\import topology.Topology[Carrier := target.Point] \as TargetSpace;
\import boundary_manifolds.Ambient[n := n].Over[M := M, S := OldSourceSpace.Whole] \as SourceConstruction;
\import boundary_manifolds.Ambient[n := m].Over[M := N, S := OldTargetSpace.Whole] \as TargetConstruction;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as OldSourceCharts;
\import manifolds.Dimension[n := m].Chart[M := N.Point, space := N.space] \as OldTargetCharts;
\import boundary_manifolds.Dimension[n := n].Chart[M := source.Point, space := source.space] \as SourceCharts;
\import boundary_manifolds.Dimension[n := m].Chart[M := target.Point, space := target.space] \as TargetCharts;
\import boundary_manifolds.SmoothMap[n := n, m := m].Between[M := source, N := target] \as Maps;
\import manifolds.Immersion[n := n, m := m].Between[M := M, N := N] \as OldEmbeddings;
\import boundary_manifolds.Immersion[n := n, m := m].Between[M := source, N := target] \as Embeddings;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import calculus.Real[].Multivariable[n := m].Open[] \as Output;
\import boundary_manifolds.Model[n := n] \as SourceModel;
\import boundary_manifolds.Model[n := m] \as TargetModel;
\import calculus.Maps[n := n, m := m] \as Calculus;
\module Of(f: Ordinary.Map);
