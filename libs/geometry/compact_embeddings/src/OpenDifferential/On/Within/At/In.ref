\import manifold_gluing.OpenManifoldCones[n := n].On[M := M].Within[U := U, open := open].At[x := x].In[patch := patch, contains := contains] \as Coordinates;
\import Domain.Coordinate[chart := Coordinates.left] \as Left;
\import Codomain.Coordinate[chart := Coordinates.right] \as Right;
\definition injective[u, v: Domain.Vector]: D.value.apply u = D.value.apply v -> u = v := \fun (equal: _) => Left.injective u v
  (trans!{{Model.Point}} _ _ _ (sym!{{Model.Point}} _ _ (Coordinates.coordinates u))
    (trans!{{Model.Point}} _ _ _ (congr!{{Codomain.Vector} {Model.Point}} Right.decode _ _ equal) (Coordinates.coordinates v)));
\definition inverse[w: Codomain.Vector]: Domain.Vector := Left.encode (Right.decode w);
\definition rightInverse[w: Codomain.Vector]: D.value.apply (inverse w) = w := Right.injective _ _
  (trans!{{Model.Point}} _ _ _ (Coordinates.coordinates (inverse w)) (Left.decodeEncode (Right.decode w)));
\definition onto[w: Codomain.Vector]: \exists ( v: Domain.Vector \where D.value.apply v = w ) :=
  Logic.existsIntro[Domain.Vector, { v: Domain.Vector \where D.value.apply v = w }] (inverse w) (rightInverse w);
