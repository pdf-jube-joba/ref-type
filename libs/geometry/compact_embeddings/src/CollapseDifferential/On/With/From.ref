\import Height.From[construction := result.collar].Of[width := result.width] \as H;
\import H.Compact[compact := compact] \as Built;
\import Height.Built[result := result, compact := compact] \as Public;
\definition map: boundary_manifolds.SmoothMap[n := NormalRoot.dimension, m := One.dimension].Between[M := M, N := Neat.halfLine].Map := Public.map;
\import manifold_gluing.BoundaryInclusion[n := n].On[M := M].With[cover := cover] \as BoundaryModel;
\import boundary_manifolds.Product[n := n, m := One.dimension].Of[M := BoundaryModel.manifold, N := Time.manifold] \as Product;
\import Boundary.Build[cover := cover] \as OrdinaryBoundary;
\import boundary_manifolds.Boundaryless[n := n].Of[M := OrdinaryBoundary.manifold] \as ConvertedBoundary;
\definition radiusOuter: R.Lt H.radius H.outer := Order.ltTrans H.radius H.middle H.outer (Estimates.halfStrict H.middle H.middlePositive) H.middleSmall;
\definition bounded: R.Lt H.radius S.one := Order.ltTrans H.radius H.outer S.one radiusOuter H.outerBounded;
\definition within: \forall (t: Time.Point) -> R.Lt (Time.value t) H.radius -> \In[Time.Point] result.collar.regular.uniform.neighborhood t :=
  \fun (t: Time.Point)(small: _) => H.within t (Order.ltTrans (Time.value t) H.radius H.outer small radiusOuter);
\import manifold_gluing.CollarWindow[n := n].On[M := M].With[cover := cover].From[deformation := result.collar.deformation].Of[regular := result.collar.regular].At[
  a := H.radius, positive := H.radiusPositive, bounded := bounded, within := within] \as Window;
\import manifold_gluing.OpenManifold[n := NormalRoot.dimension].On[M := Product.manifold].Within[U := Window.points, open := Window.open] \as Parameters;
\import manifold_gluing.CollarRestriction[n := n].On[M := M].With[cover := cover].From[deformation := result.collar.deformation].Of[regular := result.collar.regular].Within[
  V := Window.points, open := Window.open, inside := Window.inside] \as Collar;
\import manifold_gluing.OpenManifold[n := NormalRoot.dimension].On[M := M].Within[U := Collar.image, open := Collar.imageOpen] \as Image;
\import manifold_gluing.ProductMaps[n := n, m := One.dimension].Of[M := BoundaryModel.manifold, N := Time.manifold] \as Projections;
\import \root.HeightNormal[n := n].TimeMap[] \as RayInclusion;
\import manifold_gluing.SmoothChainRule[n := NormalRoot.dimension, m := One.dimension, l := One.dimension].Between[M := Product.manifold, N := Time.manifold, P := Neat.halfLine].Of[
  f := Projections.Second[].map, g := RayInclusion.map] \as ProductHeight;
\import manifold_gluing.SmoothChainRule[n := NormalRoot.dimension, m := NormalRoot.dimension, l := One.dimension].Between[M := Parameters.manifold, N := Product.manifold, P := Neat.halfLine].Of[
  f := Parameters.Inclusion[].map, g := ProductHeight.map] \as Projection;
\import manifold_gluing.SmoothChainRule[n := NormalRoot.dimension, m := NormalRoot.dimension, l := One.dimension].Between[M := Parameters.manifold, N := M, P := Neat.halfLine].Of[
  f := Collar.map, g := map] \as Composite;
\import boundary_manifolds.SmoothMap[n := NormalRoot.dimension, m := One.dimension].Between[M := Parameters.manifold, N := Neat.halfLine] \as LocalMaps;
\import manifold_gluing.CollarWindow[n := n].On[M := M].With[cover := cover].From[deformation := result.collar.deformation].Of[regular := result.collar.regular].At[
  a := H.outer, positive := H.outerPositive, bounded := H.outerBounded, within := H.within] \as OriginalWindow;
\import manifold_gluing.OpenManifold[n := NormalRoot.dimension].On[M := Product.manifold].Within[U := OriginalWindow.points, open := OriginalWindow.open] \as OriginalParameters;
\definition original[p: Parameters.Point]: OriginalParameters.Point := \into[Product.Point](p, OriginalWindow.points) \by {
  Order.ltTrans (Time.value (Product.second p)) H.radius H.outer (\bysub(Product.Point, Window.points, p)) radiusOuter
};
\definition formula[p: Parameters.Point]: LocalMaps.apply Composite.map p = LocalMaps.apply Projection.map p :=
  boundary_manifolds.Model[n := One.dimension].equality Neat.constraints Open.whole (LocalMaps.apply Composite.map p) (LocalMaps.apply Projection.map p)
    (\axiom:funext((LocalMaps.apply Composite.map p \of boundary_manifolds.Model[n := One.dimension].Point),
      (LocalMaps.apply Projection.map p \of boundary_manifolds.Model[n := One.dimension].Point), \fun (i: One.Index) =>
        trans!{S.Real} _ _ _ (congr!{One.Index S.Real} (\fun (j: One.Index) => LocalMaps.apply Composite.map p j) _ _ (std.Data[].FinSet[].singletonValue i))
          (trans!{S.Real} _ _ _ (Built.compatible (original p) (Order.leOfLt (Time.value (Product.second p)) H.radius (\bysub(Product.Point, Window.points, p))))
            (sym!{S.Real} _ _ (congr!{One.Index S.Real} (\fun (j: One.Index) => LocalMaps.apply Projection.map p j) _ _ (std.Data[].FinSet[].singletonValue i))))));
\definition equal: Composite.map = Projection.map := manifold_gluing.SmoothMapExt[n := NormalRoot.dimension, m := One.dimension].Between[M := Parameters.manifold, N := Neat.halfLine].ext Composite.map Projection.map formula;
\import boundary_manifolds.SmoothMap[n := NormalRoot.dimension, m := NormalRoot.dimension].Between[M := Parameters.manifold, N := M] \as CollarMaps;
\import manifold_gluing.SmoothChainRule[n := NormalRoot.dimension, m := NormalRoot.dimension, l := NormalRoot.dimension].Between[M := Parameters.manifold, N := Image.manifold, P := M].Of[
  f := Collar.diffeomorphism.forward, g := Image.Inclusion[].map] \as CollarChain;
\definition collarEqual: CollarChain.map = Collar.map := manifold_gluing.SmoothMapExt[n := NormalRoot.dimension, m := NormalRoot.dimension].Between[M := Parameters.manifold, N := M].ext CollarChain.map Collar.map
  (\fun (p: Parameters.Point) => \refl(CollarMaps.apply Collar.map p));

\import \root.HeightNormal[n := n].On[M := M].With[cover := cover].From[result := result, compact := compact] \as Normal;
\import Built.Collapse[] \as Collapse;
\import manifold_gluing.CollarRestriction[n := n].On[M := M].With[cover := cover].From[deformation := result.collar.deformation].Of[regular := result.collar.regular].Within[V := OriginalWindow.points, open := OriginalWindow.open, inside := OriginalWindow.inside] \as OuterCollar;
\import manifold_gluing.OpenManifold[n := NormalRoot.dimension].On[M := M].Within[U := OuterCollar.image, open := OuterCollar.imageOpen] \as OuterImage;
\import manifold_gluing.OpenCorestriction[n := NormalRoot.dimension, m := NormalRoot.dimension].Between[M := Parameters.manifold, N := Product.manifold].Into[U := OriginalWindow.points, open := OriginalWindow.open].Of[f := Parameters.Inclusion[].map, inside := \fun (p: Parameters.Point) => \bysub(Product.Point, OriginalWindow.points, original p)] \as IntoOuter;
\import manifold_gluing.SmoothChainRule[n := NormalRoot.dimension, m := NormalRoot.dimension, l := NormalRoot.dimension].Between[M := Parameters.manifold, N := OriginalParameters.manifold, P := OriginalParameters.manifold].Of[f := IntoOuter.map, g := Collapse.rho] \as Rho;
\import manifold_gluing.SmoothChainRule[n := NormalRoot.dimension, m := NormalRoot.dimension, l := NormalRoot.dimension].Between[M := Parameters.manifold, N := M, P := M].Of[f := Collar.map, g := Collapse.map] \as CollapseComposite;
\import manifold_gluing.SmoothChainRule[n := NormalRoot.dimension, m := NormalRoot.dimension, l := NormalRoot.dimension].Between[M := Parameters.manifold, N := OriginalParameters.manifold, P := M].Of[f := Rho.map, g := OuterCollar.map] \as CollapseFactored;
\definition collapseEqual: CollapseComposite.map = CollapseFactored.map := manifold_gluing.SmoothMapExt[n := NormalRoot.dimension, m := NormalRoot.dimension].Between[M := Parameters.manifold, N := M].ext CollapseComposite.map CollapseFactored.map (\fun (p: Parameters.Point) => Collapse.collarValue (original p));
\import manifold_gluing.SmoothChainRule[n := NormalRoot.dimension, m := NormalRoot.dimension, l := n].Between[M := OriginalParameters.manifold, N := Product.manifold, P := BoundaryModel.manifold].Of[f := OriginalParameters.Inclusion[].map, g := Projections.First[].map] \as OuterFirst;
\import manifold_gluing.SmoothChainRule[n := NormalRoot.dimension, m := NormalRoot.dimension, l := n].Between[M := Parameters.manifold, N := OriginalParameters.manifold, P := BoundaryModel.manifold].Of[f := Rho.map, g := OuterFirst.map] \as RhoFirst;
\import manifold_gluing.SmoothChainRule[n := NormalRoot.dimension, m := NormalRoot.dimension, l := n].Between[M := Parameters.manifold, N := Product.manifold, P := BoundaryModel.manifold].Of[f := Parameters.Inclusion[].map, g := Projections.First[].map] \as LocalFirst;
\definition firstEqual: RhoFirst.map = LocalFirst.map := manifold_gluing.SmoothMapExt[n := NormalRoot.dimension, m := n].Between[M := Parameters.manifold, N := BoundaryModel.manifold].ext RhoFirst.map LocalFirst.map (\fun (p: Parameters.Point) => Collapse.firstValue p);
\import boundary_manifolds.Tangent[n := NormalRoot.dimension].On[M := M] \as SourceTangent;
\import boundary_manifolds.Differential[n := NormalRoot.dimension, m := NormalRoot.dimension].Between[M := M, N := M] \as CollapseDerivative;
\import boundary_manifolds.Differential[n := NormalRoot.dimension, m := One.dimension].Between[M := M, N := Neat.halfLine] \as HeightDerivative;
\definition Joint[x: M.Point]: \Prop := \forall (u, v: SourceTangent.Vector x) -> CollapseDerivative.At[f := Collapse.map, x := x].value.apply u = CollapseDerivative.At[f := Collapse.map, x := x].value.apply v -> HeightDerivative.At[f := map, x := x].value.apply u = HeightDerivative.At[f := map, x := x].value.apply v -> u = v;
\module OuterAt(q: OriginalParameters.Point);
\module At(p: Parameters.Point);
\import manifold_gluing.OpenManifold[n := NormalRoot.dimension].On[M := M].Within[U := Space.Complement Collapse.support, open := Collapse.supportClosed] \as Outside;
\import manifold_gluing.SmoothChainRule[n := NormalRoot.dimension, m := NormalRoot.dimension, l := NormalRoot.dimension].Between[M := Outside.manifold, N := M, P := M].Of[f := Outside.Inclusion[].map, g := Collapse.map] \as OutsideCollapse;
\definition outsideEqual: OutsideCollapse.map = Outside.Inclusion[].map := manifold_gluing.SmoothMapExt[n := NormalRoot.dimension, m := NormalRoot.dimension].Between[M := Outside.manifold, N := M].ext OutsideCollapse.map Outside.Inclusion[].map (\fun (x: Outside.Point) => Collapse.unchanged x (\bysub(M.Point, Space.Complement Collapse.support, x)));
\module OutsideAt(x: Outside.Point);
\import OriginalWindow.Core[r := Collapse.supportTime, positive := \root.Neat[n := n].Clamp[r := Collapse.radius, positive := Collapse.positive].twicePositive, small := Collapse.supportOuter] \as Support;
\definition supportBounded: R.Lt Collapse.supportTime S.one := Order.ltTrans Collapse.supportTime H.outer S.one Collapse.supportOuter H.outerBounded;
\import manifold_gluing.CompactTimes[].At[a := Collapse.supportTime, positive := \root.Neat[n := n].Clamp[r := Collapse.radius, positive := Collapse.positive].twicePositive, bounded := supportBounded] \as Times;
\import topological_constructions.Product[A := BoundaryModel.manifold.Point, B := Times.Point] \as ClosedProduct;
\import topology.Topology[Carrier := ClosedProduct.CarrierSet] \as ClosedSpace;
\import topology.Maps[A := ClosedProduct.CarrierSet, B := M.Point] \as SupportImage;
\definition nearParameter[p: ClosedProduct.CarrierSet]: Parameters.Point := \into[Product.Point](Support.parameter p, Window.points) \by { R.leLtTrans _ Collapse.supportTime H.radius (Support.timeBound p) Collapse.supportSmall };
\definition supported[x: M.Point]: Space.Member Collapse.support x -> Joint x := \fun (member: _) => SupportImage.imageElim Support.function ClosedSpace.Whole x (Joint x)
  (\fun (p: ClosedProduct.CarrierSet)(whole: ClosedSpace.Member ClosedSpace.Whole p)(same: Support.function p = x) => \idelim Support.function p = x \with y: M.Point => Joint y \by { base: At[p := nearParameter p].joint, equality: same }) member;
\definition joint[x: M.Point]: Joint x := Logic.orElim (Space.Member Collapse.support x) (Logic.Not (Space.Member Collapse.support x)) (Joint x) (Classical.excludedMiddle (Space.Member Collapse.support x))
  (supported x) (\fun (outside: _) => OutsideAt[x := \into[M.Point](x, Space.Complement Collapse.support) \by { outside }].joint);
