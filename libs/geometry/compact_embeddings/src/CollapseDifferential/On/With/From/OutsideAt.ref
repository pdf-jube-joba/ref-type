\import boundary_manifolds.Tangent[n := NormalRoot.dimension].On[M := Outside.manifold].At[x := x] \as Domain;
\import boundary_manifolds.Differential[n := NormalRoot.dimension, m := NormalRoot.dimension].Between[M := Outside.manifold, N := M] \as D;
\import boundary_manifolds.SmoothMap[n := NormalRoot.dimension, m := NormalRoot.dimension].Between[M := Outside.manifold, N := M] \as Maps;
\import \root.OpenDifferential[n := NormalRoot.dimension].On[M := M].Within[U := Space.Complement Collapse.support, open := Collapse.supportClosed].At[x := x] \as OpenD;
\definition Injective[f: Maps.Map]: \Prop := \forall (u,v: Domain.Vector) -> D.At[f := f, x := x].value.apply u = D.At[f := f, x := x].value.apply v -> u = v;
\definition injective: Injective OutsideCollapse.map := \idelim Outside.Inclusion[].map = OutsideCollapse.map \with f: Maps.Map => Injective f \by { base: OpenD.injective, equality: sym!{{Maps.Map}} _ _ outsideEqual };
\import \root.JointTransfer[p := NormalRoot.dimension, q := NormalRoot.dimension, r := NormalRoot.dimension, s := One.dimension].Between[A := Outside.manifold, B := M, C := M, D := Neat.halfLine].Of[f := Outside.Inclusion[].map, g := Collapse.map, h := map].At[x := x] \as Transfer;
\definition local: Transfer.Joint := \fun (u,v: Domain.Vector)(same: _)(height: _) => injective u v same;
\definition joint: Joint x := Transfer.injective OpenD.onto local;
