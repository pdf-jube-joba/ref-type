\import boundary_manifolds.Tangent[n := NormalRoot.dimension].On[M := OriginalParameters.manifold].At[x := q] \as Domain;
\import boundary_manifolds.Tangent[n := NormalRoot.dimension].On[M := OuterImage.manifold].At[x := OuterCollar.forward q] \as Middle;
\import boundary_manifolds.Tangent[n := NormalRoot.dimension].On[M := M].At[x := OuterCollar.map.apply q] \as Target;
\import manifold_gluing.SmoothChainRule[n := NormalRoot.dimension, m := NormalRoot.dimension, l := NormalRoot.dimension].Between[M := OriginalParameters.manifold, N := OuterImage.manifold, P := M].Of[f := OuterCollar.diffeomorphism.forward, g := OuterImage.Inclusion[].map] \as Chain;
\import boundary_manifolds.SmoothMap[n := NormalRoot.dimension, m := NormalRoot.dimension].Between[M := OriginalParameters.manifold, N := M] \as Maps;
\import boundary_manifolds.Differential[n := NormalRoot.dimension, m := NormalRoot.dimension].Between[M := OriginalParameters.manifold, N := M] \as Derivative;
\definition equal: Chain.map = OuterCollar.map := manifold_gluing.SmoothMapExt[n := NormalRoot.dimension, m := NormalRoot.dimension].Between[M := OriginalParameters.manifold, N := M].ext Chain.map OuterCollar.map (\fun (p: OriginalParameters.Point) => \refl(OuterCollar.map.apply p));
\definition Injective[f: Maps.Map]: \Prop := \forall (u, v: Domain.Vector) -> Derivative.At[f := f, x := q].value.apply u = Derivative.At[f := f, x := q].value.apply v -> u = v;
\import \root.DiffeomorphismDifferential[n := NormalRoot.dimension, m := NormalRoot.dimension].Between[M := OriginalParameters.manifold, N := OuterImage.manifold].Of[d := OuterCollar.diffeomorphism].At[x := q] \as Diffeo;
\import \root.OpenDifferential[n := NormalRoot.dimension].On[M := M].Within[U := OuterCollar.image, open := OuterCollar.imageOpen].At[x := OuterCollar.forward q] \as Inclusion;
\definition chainInjective: Injective Chain.map := \fun (u, v: Domain.Vector)(same: _) => Diffeo.injective u v (Inclusion.injective _ _ (trans!{{Target.Vector}} _ _ _ (sym!{{Target.Vector}} _ _ (Chain.At[x := q].pointwise u)) (trans!{{Target.Vector}} _ _ _ same (Chain.At[x := q].pointwise v))));
\definition injective: Injective OuterCollar.map := \idelim Chain.map = OuterCollar.map \with f: Maps.Map => Injective f \by { base: chainInjective, equality: equal };
