\import boundary_manifolds.SmoothMap[n := dimension, m := dimension].Between[M := M, N := P] \as Maps;
\import manifold_gluing.ChartTransport[n := dimension].From[M := M].Into[A := P.Point, space := P.space, U := U, open := open, h := h] \as Charts;
\import Models.Chart[M := P.Point, space := P.space] \as TargetCharts;
\module Of(f: Maps.Map, values: \forall (x: M.Point) -> Maps.apply f x = (h.forward x \of P.Point),
  member: \forall (c: Charts.OldChart) -> \In[TargetCharts.Chart] P.atlas.charts Charts.In[c := c].chart);
