\import boundary_manifolds.Tangent[n := dimension].On[M := M].At[x := x] \as Domain;
\import boundary_manifolds.Tangent[n := dimension].On[M := P].At[x := Maps.apply f x] \as Codomain;
\import boundary_manifolds.Differential[n := dimension, m := dimension].Between[M := M, N := P].At[f := f, x := x] \as D;
\module In(c: Domain.Chart);
\definition injective: \forall (u, v: Domain.Vector) -> D.value.apply u = D.value.apply v -> u = v := \block {
  \fun (u, v: Domain.Vector)(equal: _) \then
  \takefrom c: Domain.Chart \by Domain.chartExists \then
  \return In[c := c].injective u v equal
};
