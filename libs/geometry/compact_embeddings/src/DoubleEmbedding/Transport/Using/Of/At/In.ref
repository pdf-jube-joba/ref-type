\import Models.Chart[M := M.Point, space := M.space] \as SourceCharts;
\definition old: Charts.OldChart := \into[SourceCharts.Chart](c, M.atlas.charts) \by { Domain.member c };
\import manifold_gluing.TransportDifferential[n := dimension].Between[M := M, N := P].From[U := U, open := open, h := h].For[f := f, values := values].At[
  x := x, c := old, contains := Domain.contains c, member := member old] \as Coordinates;
\definition injective[u, v: Domain.Vector]: D.value.apply u = D.value.apply v -> u = v := \fun (equal: _) => Domain.Coordinate[chart := Coordinates.left].injective u v
  (trans!{Model.Point} _ _ _ (sym!{Model.Point} _ _ (Coordinates.coordinates u))
    (trans!{Model.Point} _ _ _ (congr!{{Codomain.Vector} {Model.Point}} Codomain.Coordinate[chart := Coordinates.right].decode _ _ equal) (Coordinates.coordinates v)));
