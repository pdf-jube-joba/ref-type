\import boundary_manifolds.Tangent[n := dimension].On[M := Source.manifold].At[x := x] \as Domain;
\import boundary_manifolds.Tangent[n := dimension].On[M := SignedProduct.manifold].At[x := value x] \as Codomain;
\import boundary_manifolds.Differential[n := dimension, m := dimension].Between[M := Source.manifold, N := SignedProduct.manifold].At[f := map, x := x] \as D;
\module In(c: Product.LeftChart, contains: BoundaryCharts.Contains c (Product.first x));
\definition injective: \forall (u, v: Domain.Vector) -> D.value.apply u = D.value.apply v -> u = v := \block {
  \fun (u, v: Domain.Vector)(equal: _) \then
  \takefrom chosen: \Cast[BoundaryCharts.Chart] ({ c: BoundaryCharts.Chart \where Logic.And[\In[BoundaryCharts.Chart] B.atlas.charts c, BoundaryCharts.Contains c (Product.first x)] }) \by B.atlas.covers (Product.first x) \then
  \let laws: Logic.And[\In[BoundaryCharts.Chart] B.atlas.charts chosen, BoundaryCharts.Contains chosen (Product.first x)] := \bysub(BoundaryCharts.Chart, { c: BoundaryCharts.Chart \where Logic.And[\In[BoundaryCharts.Chart] B.atlas.charts c, BoundaryCharts.Contains c (Product.first x)] }, chosen) \then
  \let c: Product.LeftChart := \into[BoundaryCharts.Chart](chosen, B.atlas.charts) \by { laws.left } \then
  \return In[c := c, contains := laws.right].injective u v equal
};
