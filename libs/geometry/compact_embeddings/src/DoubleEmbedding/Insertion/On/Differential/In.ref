\import \parent.\parent.At[x := x, c := c, contains := contains] \as Original;
\module Using(representative: Source.In[c := Original.original].Representative);
\definition injective: \forall (u, v: Domain.Vector) -> D.value.apply u = D.value.apply v -> u = v := \block {
  \fun (u, v: Domain.Vector)(equal: _) \then
  \takefrom representative: Source.In[c := Original.original].Representative \by Source.In[c := Original.original].exists \then
  \return Using[representative := representative].injective u v equal
};
