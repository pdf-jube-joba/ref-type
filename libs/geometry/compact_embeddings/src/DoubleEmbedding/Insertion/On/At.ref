\import Product.In[c := c, d := timeChart] \as Original;
\import SignedProduct.In[c := c, d := signedChart] \as Target;
\definition original: Source.OldChart := \into[ProductCharts.Chart](Original.chart, Product.manifold.atlas.charts) \by {
  Logic.existsIntro[Product.Index, { i: Product.Index \where Original.chart = Product.chart i }] (Pair.pair Product.LeftChart Product.RightChart c timeChart) (\refl(Original.chart))
};
\definition destination: Local.TargetChart (value x) := \into[TargetCharts.Chart](Target.chart, Local.TargetChart (value x)) \by {
  Logic.And[_, _]::# (Logic.existsIntro[SignedProduct.Index, { i: SignedProduct.Index \where Target.chart = SignedProduct.chart i }] (Pair.pair SignedProduct.LeftChart SignedProduct.RightChart c signedChart) (\refl(Target.chart)))
    (Logic.And[_, _]::# contains (\refl(Signed.SmallTimes[].positive (time x))))
};
\module Using(representative: Source.In[c := original].Representative);
\definition exists: \exists Local.Witness[x] := \block {
  \takefrom representative: Source.In[c := original].Representative \by Source.In[c := original].exists \then
  \return \exact(Using[representative := representative].witness, Local.Witness[x])
};
