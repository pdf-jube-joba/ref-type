\import manifold_gluing.Double[n := n].On[M := M].With[cover := cover].Compact[compact := compact] \as Double;
\import manifold_gluing.CompactGluing[n := n].Between[M := M, N := M].With[leftCover := cover, rightCover := cover].Along[d := Identity.value].Compact[leftCompact := compact, rightCompact := compact] \as Original;
\module For(result: Double.Result);
\definition IsEmbedded[result: Double.Result]: \Prop := For[result := result].Immersion;
\definition Result: \Set := \Cast[Double.Result] ({ r: Double.Result \where IsEmbedded r });
\module Construction(c: Collars.Construction);
\module Using(result: Result);
\definition exists: \exists Result := \block {
  \takefrom c: Collars.Construction \by Collars.exists compact compact \then
  \return \exact(\into[Double.Result](Original.Build[c := c].result, Result) \by { Construction[c := c].immersion }, Result)
};
