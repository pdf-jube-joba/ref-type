\import \parent.For[result := result] \as OriginalResult;
\definition manifold: Models.Manifold := OriginalResult.manifold;
\definition compactManifold: topology.Topology[Carrier := manifold.Point].IsCompact manifold.space := OriginalResult.compactManifold;
\definition noBoundary[x: manifold.Point]: Logic.Not boundary_manifolds.Tangent[n := dimension].On[M := manifold].At[x := x].Cones[].Boundary := OriginalResult.noBoundary x;
\import boundary_manifolds.Immersion[n := dimension, m := dimension].Between[M := M, N := manifold] \as Embeddings;
\definition left: Embeddings.Embedding := OriginalResult.embedding (\bysub(Double.Result, { r: Double.Result \where IsEmbedded r }, result));
