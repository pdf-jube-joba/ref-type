\definition manifold: Models.Manifold := Double.manifold result;
\import boundary_manifolds.SmoothMap[n := dimension, m := dimension].Between[M := M, N := manifold] \as Maps;
\import boundary_manifolds.Immersion[n := dimension, m := dimension].Between[M := M, N := manifold] \as Embeddings;
\definition map: Maps.Map := Double.left result;
\definition Immersion: \Prop := Embeddings.IsImmersion map;
\definition injective[x, y: M.Point]: Maps.apply map x = Maps.apply map y -> x = y := \fun (equal: _) => Seam.leftInjective x y
  (trans!{{Seam.Point}} _ _ _ (sym!{{Seam.Point}} _ _ (result.leftValue x)) (trans!{{Seam.Point}} _ _ _ equal (result.leftValue y)));
\definition embedding[immersion: Immersion]: Embeddings.Embedding := \root.BoundaryCriterion[n := dimension, m := dimension].Between[M := M, N := manifold].Of[f := map, compact := compact, injective := injective].embedding immersion;
\definition compactManifold: topology.Topology[Carrier := manifold.Point].IsCompact manifold.space := Seam.compact compact compact;
\definition noBoundary[x: manifold.Point]: Logic.Not boundary_manifolds.Tangent[n := dimension].On[M := manifold].At[x := x].Cones[].Boundary := Double.noBoundary result x;
