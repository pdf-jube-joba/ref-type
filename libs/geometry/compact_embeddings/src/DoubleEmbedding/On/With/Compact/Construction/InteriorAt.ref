\import manifold_gluing.InteriorInclusion[n := dimension].On[M := M] \as Inclusion;
\import Interior.Build[] \as Ordinary;
\import boundary_manifolds.Boundaryless[n := dimension].Of[M := Ordinary.manifold] \as Converted;
\definition point: Inclusion.manifold.Point := Converted.forward (\into[M.Point](x, Interior.points) \by { interior });
\import manifold_gluing.InteriorPatches[n := n].Between[M := M, N := M].With[leftCover := cover, rightCover := cover].Along[d := Identity.value].Compact[leftCompact := compact, rightCompact := compact] \as Interiors;
\import Seam.Compact[leftCompact := compact, rightCompact := compact] \as Properties;
\import manifold_gluing.InteriorEmbedding[n := dimension].On[M := M, A := Seam.Point, space := Seam.topology, f := Seam.inl,
  compact := compact, hausdorff := Properties.hausdorff, continuous := Seam.inlContinuous, injective := Seam.leftInjective] \as Patch;
\import manifold_gluing.SmoothChainRule[n := dimension, m := dimension, l := dimension].Between[M := Inclusion.manifold, N := M, P := manifold].Of[f := Inclusion.map, g := Inclusions.left] \as Chain;
\import \root.DoubleEmbedding[n := n].Transport[M := Inclusion.manifold, P := manifold].Using[U := Patch.image, open := Interiors.leftOpen, h := Patch.homeomorphism].Of[
  f := Chain.map, values := \fun (p: Inclusion.manifold.Point) => \refl(Seam.inl p), member := Members.leftMember] \as Composite;
\import \root.DoubleEmbedding[n := n].Factor[P := Inclusion.manifold, M := M, T := manifold].Of[g := Inclusion.map, f := Inclusions.left].At[x := point] \as Factor;
\definition injective: ImmersionAt x := Factor.injective (\root.InteriorDifferential[n := dimension].On[M := M].At[x := point].onto) (Composite.immersion point);
