\import manifold_gluing.BoundaryInclusion[n := n].On[M := M].With[cover := cover] \as BoundaryModel;
\import manifold_gluing.DiffeomorphismIdentity[n := n].On[M := BoundaryModel.manifold] \as Identity;
\import manifold_gluing.SeamCollar[n := n].Between[M := M, N := M].With[leftCover := cover, rightCover := cover].Along[d := Identity.value] \as Collars;
\import manifold_gluing.BoundarySeam[n := n].Between[M := M, N := M].With[leftCover := cover, rightCover := cover].Along[d := Identity.value] \as Seam;
\module Compact(compact: Space.IsCompact M.space);
