\import manifolds.SmallAtlasSmoothMap[n := two, m := two].Between[M := Standard.smoothManifold, N := Standard.smoothManifold] \as Criterion;
\definition sourceAtlas: Criterion.SourceAtlas := \into[Atlases.Atlas](atlas, Criterion.SourceAtlas) \by { includedInStandard };
\definition targetAtlas: Criterion.TargetAtlas := \into[Atlases.Atlas](atlas, Criterion.TargetAtlas) \by { includedInStandard };
\import Criterion.On[source := sourceAtlas, target := targetAtlas] \as Small;
\import manifolds.SelfMap[n := two].Identity[M := Standard.smoothManifold] \as Identity;
\import Small.Of[f := Identity.continuous] \as Checked;
\definition condition: Checked.InSmallAtlas := \fun (left: Small.SourceChart)(right: Small.TargetChart) =>
  compatible left right (\bysub(Charts.Chart, #charts{atlas}, left)) (\bysub(Charts.Chart, #charts{atlas}, right));
\definition identity: manifolds.SmoothMap[n := two, m := two].Between[M := Standard.smoothManifold, N := Standard.smoothManifold].Map :=
  Checked.value condition;
\definition identityLaw: identity = Identity.map :=
  manifolds.SmoothMap[n := two, m := two].Between[M := Standard.smoothManifold, N := Standard.smoothManifold].ext identity Identity.map
    (\axiom:funext((\fun (x: Plane.Point) => x), (\fun (x: Plane.Point) => x), \fun (x: Plane.Point) => \refl(x)));
