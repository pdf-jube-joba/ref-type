\import manifolds.Presentation[n := two].On[M := Standard.smoothManifold].Of[atlas := Atlases.saturate atlas] \as Geometry;
\import differential_forms.Presentation[n := two].On[M := Standard.smoothManifold].Of[atlas := Atlases.saturate atlas] \as Comparison;
\definition same: Comparison.SameCharts := congr!{{Atlases.MaximalAtlas} {\Pow Charts.Chart}}
  (\fun (a: Atlases.MaximalAtlas) => #charts{a}) Standard.smoothManifold.atlas (Atlases.saturate atlas)
  (sym!{{Atlases.MaximalAtlas}} (Atlases.saturate atlas) Standard.smoothManifold.atlas sameSaturation);
\import differential_forms.Forms[n := two].On[M := Standard.smoothManifold] \as Original;
\import differential_forms.Forms[n := two].On[M := Geometry.N] \as Replacement;
\import real.Analysis[].Algebra[] \as Algebra;
\import linear_algebra.Field[].Space[K := real.Analysis[].Real, field := Algebra.field] \as Spaces;
\import Spaces.Isomorphism[V := Replacement.Form k, W := Original.Form k,
  source := Replacement.At[k := k].space, target := Original.At[k := k].space] \as Forms;
\definition forms: Forms.Isomorphism := Comparison.At[k := k].forms same;
\import Original.DeRham[].At[k := k] \as OriginalH;
\import Replacement.DeRham[].At[k := k] \as ReplacementH;
\import Spaces.Isomorphism[V := ReplacementH.H, W := OriginalH.H,
  source := ReplacementH.vectorSpace, target := OriginalH.vectorSpace] \as Cohomology;
\definition cohomology: Cohomology.Isomorphism := Comparison.At[k := k].cohomology same;
