\import differential_forms.Forms[n := two].On[M := Standard.smoothManifold] \as Global;
\import Small.At[k := k] \as Maps;
\definition restrictExtend: \forall (omega: Small.Form k) -> Maps.restrict (Maps.extend omega) = omega := Maps.leftInverse;
\definition extendRestrict: \forall (omega: Global.Form k) -> Maps.extend (Maps.restrict omega) = omega := Maps.rightInverse;
\definition uniqueExtension: \forall (omega: Small.Form k)(eta: Global.Form k) -> Maps.restrict eta = omega -> eta = Maps.extend omega :=
  \fun (omega: Small.Form k)(eta: Global.Form k)(same: Maps.restrict eta = omega) => Maps.injective eta (Maps.extend omega)
    (trans!{{Small.Form k}} _ omega _ same (sym!{{Small.Form k}} _ _ (Maps.leftInverse omega)));
\import real.Analysis[].Algebra[] \as Algebra;
\import linear_algebra.Field[].Space[K := real.Analysis[].Real, field := Algebra.field] \as Spaces;
\import Spaces.Isomorphism[V := Small.Form k, W := Global.Form k, source := Maps.space, target := Global.At[k := k].space] \as FormsIsomorphism;
\definition formsIsomorphism: FormsIsomorphism.Isomorphism := Maps.Linear[].isomorphism;
\import Small.DeRham[] \as SmallDeRham;
\import Global.DeRham[] \as GlobalDeRham;
\import Spaces.Isomorphism[V := SmallDeRham.Cohomology k, W := GlobalDeRham.Cohomology k,
  source := SmallDeRham.At[k := k].vectorSpace, target := GlobalDeRham.At[k := k].vectorSpace] \as CohomologyIsomorphism;
\definition cohomologyIsomorphism: CohomologyIsomorphism.Isomorphism := SmallDeRham.Comparison[k := k].isomorphism;
