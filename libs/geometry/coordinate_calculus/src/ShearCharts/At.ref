\import manifolds.Tangent[n := two].On[M := Standard.smoothManifold].At[x := x] \as Tangent;
\definition standardChart: Tangent.Chart := \into[Charts.Chart](Standard.standard, Tangent.Chart) \by {
  Tangent.ChartLaws[Standard.standard] {
    member := Atlases.includedInSaturation Standard.atlas Standard.standard (\refl(Standard.standard)), contains := \refl(x),
  }
};
\definition shearChart: Tangent.Chart := \into[Charts.Chart](shear, Tangent.Chart) \by {
  Tangent.ChartLaws[shear] { member := shearInMaximal, contains := \refl(x) }
};
\definition representativeChange: \forall (v: calculus.Real[].Multivariable[n := two].Point) ->
  Tangent.classOf standardChart v = Tangent.classOf shearChart (Tangent.transform standardChart shearChart v) :=
    \fun (v: calculus.Real[].Multivariable[n := two].Point) => #right{(Tangent.classCriterion
      (Tangent.Representative { chart := standardChart, vector := v })
      (Tangent.Representative { chart := shearChart, vector := Tangent.transform standardChart shearChart v }))}
      (\refl(Tangent.transform standardChart shearChart v));
