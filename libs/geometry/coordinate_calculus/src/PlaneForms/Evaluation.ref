\import Alternating.At[k := zero] \as Zero;
\import Exterior.Degrees[p := zero, q := one] \as Product;
\import Exterior.Bilinearity[p := zero, q := one] \as Bilinearity;
\import Exterior.UnitLaws[k := one] \as Unit;
\import Exterior.Components[k := one] \as Components;
\definition coordinateAsUnit: FunctionsToForms.apply X.function a = Zero.scale (a first) Exterior.unit :=
  Zero.ext (FunctionsToForms.apply X.function a) (Zero.scale (a first) Exterior.unit)
    (\fun (arguments: Multilinear.Arguments zero) =>
      sym!{{Reals.Real}} (Spaces.mul (a first) Spaces.one) (a first) (Spaces.mulOneRight (a first)));
\definition unitDy: Product.wedge Exterior.unit (dy a) = dy a :=
  Components.ext (Product.wedge Exterior.unit (dy a)) (dy a) (Unit.left (dy a));
\definition formula: \forall (arguments: Multilinear.Arguments one) ->
  xdy a arguments = Reals.mul (a first) (arguments (Fin.zero zero) second) :=
    \fun (arguments: Multilinear.Arguments one) =>
      trans!{{Reals.Real}} (xdy a arguments)
        (Product.wedge (Zero.scale (a first) Exterior.unit) (dy a) arguments)
        (Reals.mul (a first) (arguments (Fin.zero zero) second))
        (congr!{{Alternating.Form zero} {Reals.Real}}
          (\fun (omega: Alternating.Form zero) => Product.wedge omega (dy a) arguments)
          (FunctionsToForms.apply X.function a) (Zero.scale (a first) Exterior.unit) coordinateAsUnit)
        (trans!{{Reals.Real}}
          (Product.wedge (Zero.scale (a first) Exterior.unit) (dy a) arguments)
          (Spaces.mul (a first) (Product.wedge Exterior.unit (dy a) arguments))
          (Reals.mul (a first) (arguments (Fin.zero zero) second))
          (congr!{{Alternating.Form one} {Reals.Real}}
            (\fun (omega: Alternating.Form one) => omega arguments) _ _
            (Bilinearity.scalarLeft (a first) Exterior.unit (dy a)))
          (congr!{{Alternating.Form one} {Reals.Real}}
            (\fun (omega: Alternating.Form one) => Spaces.mul (a first) (omega arguments))
            (Product.wedge Exterior.unit (dy a)) (dy a) unitDy));
