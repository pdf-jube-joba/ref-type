\import Spaces.Sums[I := I] \as Values;
\definition sum[indices: List.List[I]][functions: I -> Function][x: Model.Carrier U]: C.Complex := Values.sum indices (\fun (i: I) => functions i x);
\definition smooth: \forall (indices: List.List[I])(functions: I -> Function) -> (\forall (i: I) -> Smooth (functions i)) -> Smooth (sum indices functions) :=
  \induction (indices: List.List[I]) \return \forall (functions: I -> Function) -> (\forall (i: I) -> Smooth (functions i)) -> Smooth (sum indices functions) \with {
    | nil: \fun (functions: I -> Function)(regular: _) => constant Op.zero
    | cons: \fun (head: I)(tail: List.List[I])(previous: _)(functions: I -> Function)(regular: _) =>
      plus (functions head) (sum tail functions) (regular head) (previous functions regular)
  };
