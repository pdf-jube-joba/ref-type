\import \parent.On[U := U] \as Source;
\import \parent.On[U := V] \as Target;
\definition smooth: \forall (f: Model.Carrier V -> C.Complex) -> Target.Smooth f -> Source.Smooth (\fun (x: Model.Carrier U) => f (Model.inclusion U V included x)) :=
  \fun (f: Model.Carrier V -> C.Complex)(regular: Target.Smooth f) => Source.SmoothLaws[\fun (x: Model.Carrier U) => f (Model.inclusion U V included x)] {
    real := Model.Restriction[].localSmooth U V included (\fun (x: Model.Carrier V) => C.re (f x)) regular.real,
    imaginary := Model.Restriction[].localSmooth U V included (\fun (x: Model.Carrier V) => C.im (f x)) regular.imaginary,
  };
