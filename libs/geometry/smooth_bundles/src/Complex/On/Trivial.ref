\import \root.Real[n := n, r := r].On[M := M].Trivial[] \as Cover;
\import \parent.Family[F := \fun (x: M.Point) => Vector, space := \fun (x: M.Point) => coordinates] \as Family;
\import Spaces.Eigen[V := Vector, space := coordinates] \as Eigen;
\definition identity: Spaces.Isomorphism[V := Vector, W := Vector, source := coordinates, target := coordinates].Isomorphism := Spaces.Isomorphism[V := Vector, W := Vector, source := coordinates, target := coordinates].Isomorphism {
  forward := Eigen.identity, backward := Eigen.identity,
  leftInverse := \fun (v: Vector) => \refl(v), rightInverse := \fun (v: Vector) => \refl(v),
};
\definition local[i: Cover.Index]: Family.Local := Family.Local { chart := i, frame := \fun (x: Charts.LocalPoint i) => identity };
\definition data: Family.Data[Cover.Index] := Family.Data[Cover.Index] { local := local, covers := Cover.covers };
\definition regular: Family.Using[I := Cover.Index, data := data].Regular := \fun (i, j: Cover.Index)(v: Vector)(a: Fin.Fin r) =>
  \root.ComplexCalculus[n := n].On[U := Charts.Transition[left := i, right := j].domain].constant (v a);
\definition bundle: Family.Bundle[Cover.Index] := Family.Bundle[Cover.Index] { atlas := data, regular := Family.Using[I := Cover.Index, data := data].realRegular regular };
