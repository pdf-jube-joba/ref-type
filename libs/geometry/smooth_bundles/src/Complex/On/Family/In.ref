\import Operations.RealScalars[V := F x, space := space x].Maps[W := Vector, target := coordinates] \as Restrict;
\import Operations.RealScalars[V := Vector, space := coordinates] \as CoordinateSpace;
\import RealOperations.LinearIsomorphisms[V := F x, W := Vector, source := realSpace x, target := CoordinateSpace.realSpace].After[U := Fin.Fin realRank -> R.Real, space := RealSpaces.Coordinates[I := Fin.Fin realRank].space] \as Compose;
\definition frame: Underlying.FrameAt x := Compose.compose (Restrict.isomorphism (local.frame x)) Coordinates.frame;
