\import \parent.Using[I := I, data := bundle.atlas] \as Atlas;
\import \root.Real[n := n, r := realRank].On[M := M].Family[F := F, space := realSpace] \as Real;
\definition forget: Real.Bundle[I] := Real.Bundle[I] { atlas := Atlas.realData, regular := bundle.regular };
\import Real.Of[I := I, bundle := forget] \as UnderlyingBundle;
\definition Point: \Set := Underlying.Point;
\definition totalDimension: N.Nat^ := calculus.Blocks[n := n, m := realRank].dimension;
\import manifolds.Dimension[n := totalDimension].Smooth[] \as TotalModels;
\definition manifold: TotalModels.Manifold := UnderlyingBundle.manifold;
\definition Section: \Set := UnderlyingBundle.Sections[].Section;
\definition zero: Section := UnderlyingBundle.Sections[].zero;
\definition projection: Point -> M.Point := Underlying.projection;

\import \parent.Using[I := I, data := bundle.atlas] \as ComplexAtlas;
\module Change(i, j: I);
\module Dual;

\module Paired(s: N.Nat^, G: M.Point -> \Set, otherSpace: \forall (x: M.Point) -> Spaces.VectorSpace (G x),
  otherFrame: \forall (i: I)(x: Charts.LocalPoint (bundle.atlas.local i).chart) -> Spaces.Isomorphism[V := G x, W := Fin.Fin s -> C.Complex, source := otherSpace x, target := Spaces.Coordinates[I := Fin.Fin s].space].Isomorphism);

\module Alternating(k: N.Nat^, enumeration: Operations.ExteriorIndices[n := r, k := k].Enumeration);
\module Exterior(k: N.Nat^, enumeration: Operations.ExteriorIndices[n := r, k := k].Enumeration);

\module Forget;

\module Metrics;

\module Frames;
\module Associated(s: N.Nat^, representation: \root.ComplexLinear[r := r].Representation[s := s].Representation);

\module Columns(enumeration: Operations.PairIndices[n := r, m := r].Enumeration);

\import Underlying.Using[I := I, data := ComplexAtlas.realData].Build[changes := bundle.regular].Zero[] \as Zero;
\module Sections;
\module Identity;
