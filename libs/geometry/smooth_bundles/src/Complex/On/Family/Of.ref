\import \parent.Using[I := I, data := bundle.atlas] \as Atlas;
\import \root.Real[n := n, r := realRank].On[M := M].Family[F := F, space := realSpace] \as Real;
\definition forget: Real.Bundle[I] := Real.Bundle[I] { atlas := Atlas.realData, regular := bundle.regular };
\import Real.Of[I := I, bundle := forget] \as UnderlyingBundle;
\definition Point: \Set := Underlying.Point;
\definition totalDimension: N.Nat^ := calculus.Blocks[n := n, m := realRank].dimension;
\import manifolds.Dimension[n := totalDimension].Smooth[] \as TotalModels;
\definition manifold: TotalModels.Manifold := UnderlyingBundle.manifold;
\definition Section: \Set := UnderlyingBundle.Sections[].Section;
\definition zero: Section := UnderlyingBundle.Sections[].zero;
\definition projection: Point -> M.Point := Underlying.projection;
