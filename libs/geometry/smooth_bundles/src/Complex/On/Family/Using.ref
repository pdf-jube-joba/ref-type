\definition local[i: I]: Underlying.Local := Underlying.Local {
  chart := (data.local i).chart,
  frame := \fun (x: Charts.LocalPoint (data.local i).chart) => \parent.In[local := data.local i, x := x].frame,
};
\definition realData: Underlying.Data[I] := Underlying.Data[I] { local := local, covers := data.covers };
