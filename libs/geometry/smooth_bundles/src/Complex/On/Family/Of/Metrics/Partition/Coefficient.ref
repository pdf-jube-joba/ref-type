\definition c: \Cast[Charts.Chart] M.atlas.charts := (bundle.atlas.local j).chart;
\import \root.ComplexCalculus[n := n].On[U := c.image] \as Current;
\import C.Def[] \as Op;
\definition vectors[x: Charts.LocalPoint c][l: Fin.Fin r]: F x := ((bundle.atlas.local j).frame x).backward.apply (Standard.vectors l);
\definition prefix[length: N.Nat^][u: Open.Carrier c.image]: C.Complex := (Construction.At[x := Charts.point c u].prefix length).dot (vectors (Charts.point c u) a) (vectors (Charts.point c u) b);
\module PrefixStep(length: N.Nat^, previous: Current.Smooth (prefix length));
\definition prefixSmooth: \forall (length: N.Nat^) -> Current.Smooth (prefix length) :=
  \induction (length: N.Nat^) \return Current.Smooth (prefix length) \with {
    | zero: Current.constant Op.zero
    | succ: \fun (length: N.Nat^)(previous: Current.Smooth (prefix length)) => PrefixStep[length := length, previous := previous].smooth
  };
\import Current.Locality[f := coefficient data j a b] \as Locally;
\module At(u: Open.Carrier c.image);
\definition smooth: Current.Smooth (coefficient data j a b) := Locally.smooth (\fun (u: Open.Carrier c.image) => At[u := u].existsPatch);
