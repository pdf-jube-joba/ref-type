\import calculus.Real[].Multivariable[n := d].Open[] \as Source;
\module On(U: Source.OpenSet, a, b: Source.Carrier U -> RealVector,
  left: \forall (j: Fin.Fin size) -> Source.Smooth[].SmoothOn U (\fun (x: Source.Carrier U) => a x j),
  right: \forall (j: Fin.Fin size) -> Source.Smooth[].SmoothOn U (\fun (x: Source.Carrier U) => b x j));
