\import Operations.PairIndices[n := r, m := s] \as PairIndices;
\import Operations.FiniteIndex[A := PairIndices.Pair, S := PairIndices.Whole, enumeration := enumeration] \as Coefficients;
\definition rank: N.Nat^ := Coefficients.rank;
\definition Fiber[x: M.Point]: \Set := Spaces.Tensor[V := F x, W := G x, left := space x, right := otherSpace x].Carrier;
\definition fiberSpace[x: M.Point]: Spaces.VectorSpace (Fiber x) := Spaces.Tensor[V := F x, W := G x, left := space x, right := otherSpace x].space;
\definition pure[x: M.Point][v: F x][w: G x]: Fiber x := Spaces.Tensor[V := F x, W := G x, left := space x, right := otherSpace x].tensor v w;
\import \root.Complex[n := n, r := rank].On[M := M].Family[F := Fiber, space := fiberSpace] \as Family;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\module In(i: I, x: Charts.LocalPoint (bundle.atlas.local i).chart);
\definition local[i: I]: Family.Local := Family.Local { chart := (bundle.atlas.local i).chart, frame := \fun (x: Charts.LocalPoint (bundle.atlas.local i).chart) => In[i := i, x := x].frame };
\definition data: Family.Data[I] := Family.Data[I] { local := local, covers := bundle.atlas.covers };
\import Family.Using[I := I, data := data] \as TensorAtlas;
\module Change(i, j: I);
\definition smooth: TensorAtlas.Regular := \fun (i, j: I) => Change[i := i, j := j].smooth;
\definition tensor: Family.Bundle[I] := Family.Bundle[I] { atlas := data, regular := TensorAtlas.realRegular smooth };
