\import Spaces.CoordinateSum[n := r, m := s] \as Coordinates;
\import Spaces.Coordinates[I := Fin.Fin r] \as FirstCoordinates;
\import Spaces.Coordinates[I := Fin.Fin s] \as SecondCoordinates;
\import Fin.Sum[m := r, n := s] \as Indices;
\definition rank: N.Nat^ := Coordinates.dimension;
\definition Fiber[x: M.Point]: \Set := Spaces.DirectSum[V := F x, W := G x, left := space x, right := otherSpace x].Carrier;
\definition fiberSpace[x: M.Point]: Spaces.VectorSpace (Fiber x) := Spaces.DirectSum[V := F x, W := G x, left := space x, right := otherSpace x].space;
\import \root.Complex[n := n, r := rank].On[M := M].Family[F := Fiber, space := fiberSpace] \as Family;
\definition frame[i: I][x: Charts.LocalPoint (bundle.atlas.local i).chart]: Family.FrameAt x := Coordinates.Of[V := F x, W := G x, firstSpace := space x, secondSpace := otherSpace x, first := (bundle.atlas.local i).frame x, second := otherFrame i x].isomorphism;
\definition local[i: I]: Family.Local := Family.Local { chart := (bundle.atlas.local i).chart, frame := frame i };
\definition data: Family.Data[I] := Family.Data[I] { local := local, covers := bundle.atlas.covers };
\import Family.Using[I := I, data := data] \as SumAtlas;
\module Change(i, j: I);
\definition smooth: SumAtlas.Regular := \fun (i, j: I) => Change[i := i, j := j].smooth;
\definition directSum: Family.Bundle[I] := Family.Bundle[I] { atlas := data, regular := SumAtlas.realRegular smooth };
