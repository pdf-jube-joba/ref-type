\import Result.Using[I := I, data := atlas].Change[i := i, j := j] \as Change;
\definition toReal: Change.Regular -> tangent_bundles.FrameBundle[n := n, r := \root.Complex[n := n, r := s].realRank].Over[M := M].Family[F := Fiber, space := Result.realSpace].Using[I := I, data := Result.Using[I := I, data := atlas].realData].Change[i := i, j := j].Regular := Change.toReal;
\import \parent.\parent.Frames[].Change[i := i, j := j] \as Source;
\import Charts.Transition[left := (bundle.atlas.local i).chart, right := (bundle.atlas.local j).chart] \as Base;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\definition represented[t: Open.Carrier Base.domain]: TargetGL.Carrier := representation.apply (Source.value t);
\definition regular: \root.ComplexLinear[r := s].Smooth[d := n].Regular Base.domain represented := laws.smooth n Base.domain Source.value Source.smooth;
\definition formula: \forall (t: Open.Carrier Base.domain)(v: Fin.Fin s -> C.Complex) -> (Change.matrix t).apply v = (represented t).forward.apply v :=
  \fun (t: Open.Carrier Base.domain)(v: Fin.Fin s -> C.Complex) => Glued.At[x := Change.x t].Frame[i := \parent.Local[i := i].index (Change.x t)].assembledValue v (\parent.Local[i := j].index (Change.y t));
\definition smooth: Change.Regular := \fun (v: Fin.Fin s -> C.Complex)(a: Fin.Fin s) =>
  \root.ComplexCalculus[n := n].On[U := Base.domain].equalSmooth (\fun (t: Open.Carrier Base.domain) => (represented t).forward.apply v a)
    (\fun (t: Open.Carrier Base.domain) => (Change.matrix t).apply v a)
    (\fun (t: Open.Carrier Base.domain) => sym!{C.Complex} _ _ (congr!{{Fin.Fin s -> C.Complex} C.Complex} (\fun (w: Fin.Fin s -> C.Complex) => w a) _ _ (formula t v)))
    (regular v a);
