\import Native.Pair[d := d].From[X := X].Of[f := f, g := g] \as Construct;
\definition map: manifolds.SmoothMap[n := d, m := productDimension].Between[M := X, N := productManifold].Map := Construct.map;
\definition formula: \forall (x: X.Point) -> manifolds.SmoothMap[n := d, m := productDimension].Between[M := X, N := productManifold].apply map x = make (First.apply f x) (Second.apply g x) := Construct.formula;
