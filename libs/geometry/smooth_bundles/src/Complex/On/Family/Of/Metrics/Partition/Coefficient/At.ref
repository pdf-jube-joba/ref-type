\definition x: M.Point := Charts.point c u;
\module Near(neighborhood: Functions.FiniteNeighborhood[partition.functions, x]);
\definition existsPatch: \exists \Cast[Locally.Patch] (Locally.Patches u) := \block {
  \takefrom neighborhood: Functions.FiniteNeighborhood[partition.functions, x] \by partition.locallyFinite x \then
  \return Logic.existsIntro[Locally.Patch, Locally.Patches u] (Near[neighborhood := neighborhood].patch) (Near[neighborhood := neighborhood].contains)
};
