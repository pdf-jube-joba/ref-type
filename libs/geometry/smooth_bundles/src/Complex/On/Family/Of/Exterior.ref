\import \parent.Dual[] \as Dual;
\import \root.Complex[n := n, r := r].On[M := M].Family[F := Dual.Fiber, space := Dual.fiberSpace].Of[I := I, bundle := Dual.dual].Alternating[k := k, enumeration := enumeration] \as Alternating;
\definition rank: N.Nat^ := Alternating.rank;
\definition Fiber: M.Point -> \Set := Alternating.Fiber;
\definition fiberSpace: \forall (x: M.Point) -> Spaces.VectorSpace (Fiber x) := Alternating.fiberSpace;
\import \root.Complex[n := n, r := rank].On[M := M].Family[F := Fiber, space := fiberSpace] \as Family;
\definition exterior: Family.Bundle[I] := Alternating.alternating;
