\import \root.Complex[n := n, r := s].On[M := M].Family[F := G, space := otherSpace] \as OtherFamily;
\definition otherLocal[i: I]: OtherFamily.Local := OtherFamily.Local { chart := (bundle.atlas.local i).chart, frame := otherFrame i };
\definition otherData: OtherFamily.Data[I] := OtherFamily.Data[I] { local := otherLocal, covers := bundle.atlas.covers };
\import OtherFamily.Using[I := I, data := otherData] \as OtherAtlas;
\module Using(regular: OtherAtlas.Regular);
