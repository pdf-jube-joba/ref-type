\definition index[x: Charts.LocalPoint (bundle.atlas.local i).chart]: Cocycle.Index x := \into[I](i, { j: I \where \In[M.Point] (bundle.atlas.local j).chart.domain x }) \by { \bysub(M.Point, (bundle.atlas.local i).chart.domain, x) };
\definition frame[x: Charts.LocalPoint (bundle.atlas.local i).chart]: Spaces.Isomorphism[V := Fiber x, W := Fin.Fin s -> C.Complex, source := fiberSpace x, target := Spaces.Coordinates[I := Fin.Fin s].space].Isomorphism := Glued.At[x := x].Frame[i := index x].isomorphism;
