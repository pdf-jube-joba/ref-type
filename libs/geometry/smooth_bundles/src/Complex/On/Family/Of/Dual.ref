\definition Fiber[x: M.Point]: \Set := Spaces.Dual[V := F x, source := space x].Carrier;
\definition fiberSpace[x: M.Point]: Spaces.VectorSpace (Fiber x) := Spaces.Dual[V := F x, source := space x].space;
\import \root.Complex[n := n, r := r].On[M := M].Family[F := Fiber, space := fiberSpace] \as Family;
\module In(i: I, x: Charts.LocalPoint (bundle.atlas.local i).chart);
\definition local[i: I]: Family.Local := Family.Local { chart := (bundle.atlas.local i).chart, frame := \fun (x: Charts.LocalPoint (bundle.atlas.local i).chart) => In[i := i, x := x].frame };
\definition data: Family.Data[I] := Family.Data[I] { local := local, covers := bundle.atlas.covers };
\import Family.Using[I := I, data := data] \as DualAtlas;
\module Change(i, j: I);
\definition regular: DualAtlas.Regular := \fun (i, j: I) => Change[i := i, j := j].smooth;
\definition dual: Family.Bundle[I] := Family.Bundle[I] { atlas := data, regular := DualAtlas.realRegular regular };
