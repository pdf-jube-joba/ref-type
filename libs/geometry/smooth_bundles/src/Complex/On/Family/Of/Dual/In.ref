\import Operations.DualFrame[V := F x, space := space x, n := r, frame := (bundle.atlas.local i).frame x] \as Frames;
\definition frame: Family.FrameAt x := Frames.isomorphism;
\definition evaluation: \forall (v: Vector)(w: F x) -> frame.backward.apply v w = Spaces.Sums[I := Fin.Fin r].sum (Fin.elements r)
  (\fun (a: Fin.Fin r) => Algebra.field.mul (v a) (((bundle.atlas.local i).frame x).forward.apply w a)) := Frames.evaluation;
