\import manifolds.Dimension[n := Matrix.size].Examples[].Euclidean[] \as Ambient;
\import manifolds.Composition[n := d, m := Matrix.size, l := Matrix.size].Between[M := X, N := Matrix.manifold, P := Ambient.smoothManifold] \as InclusionCompose;
\definition ambient: manifolds.SmoothMap[n := d, m := Matrix.size].Between[M := X, N := Ambient.smoothManifold].Map := InclusionCompose.compose g Matrix.inclusion;
\import Full.Universal[p := d].From[X := X].Of[f := f, g := ambient] \as Paired;
\import manifolds.SmoothMapCorestriction[n := d, m := dimension].Between[M := X, N := Full.manifold].Into[U := subset].Of[f := Paired.map,
  inside := \fun (x: X.Point) => \bysub(Matrix.RealVector, Matrix.domain.points, Second.apply g x)] \as Into;
\definition map: manifolds.SmoothMap[n := d, m := dimension].Between[M := X, N := source].Map := Into.map;
\definition formula: \forall (x: X.Point) -> manifolds.SmoothMap[n := d, m := dimension].Between[M := X, N := source].apply map x = make (First.apply f x) (Second.apply g x) := \fun (x: X.Point) => \refl(make (First.apply f x) (Second.apply g x));
