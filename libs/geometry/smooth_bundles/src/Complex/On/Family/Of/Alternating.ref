\import Operations.ExteriorIndices[n := r, k := k] \as Indices;
\import Operations.FiniteIndex[A := Indices.Tuple, S := Indices.set, enumeration := enumeration] \as Coefficients;
\definition rank: N.Nat^ := Coefficients.rank;
\definition Fiber[x: M.Point]: \Set := Spaces.Multilinear[V := F x, space := space x].Alternating[].Form k;
\definition fiberSpace[x: M.Point]: Spaces.VectorSpace (Fiber x) := Spaces.Multilinear[V := F x, space := space x].Alternating[].At[k := k].vectorSpace;
\import \root.Complex[n := n, r := rank].On[M := M].Family[F := Fiber, space := fiberSpace] \as Family;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\module In(i: I, x: Charts.LocalPoint (bundle.atlas.local i).chart);
\definition local[i: I]: Family.Local := Family.Local { chart := (bundle.atlas.local i).chart, frame := \fun (x: Charts.LocalPoint (bundle.atlas.local i).chart) => In[i := i, x := x].frame };
\definition data: Family.Data[I] := Family.Data[I] { local := local, covers := bundle.atlas.covers };
\import Family.Using[I := I, data := data] \as AlternatingAtlas;
\module Change(i, j: I);
\definition smooth: AlternatingAtlas.Regular := \fun (i, j: I) => Change[i := i, j := j].smooth;
\definition alternating: Family.Bundle[I] := Family.Bundle[I] { atlas := data, regular := AlternatingAtlas.realRegular smooth };
