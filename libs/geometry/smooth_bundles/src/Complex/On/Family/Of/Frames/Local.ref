\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\definition Base: \Set := Charts.LocalPoint (bundle.atlas.local i).chart;
\definition encode[x: Base][f: Fiber x]: GL.Carrier := GL.Frames[V := F x, space := space x].change f ((bundle.atlas.local i).frame x);
\definition decode[x: Base][g: GL.Carrier]: Fiber x := GL.Frames[V := F x, space := space x].act ((bundle.atlas.local i).frame x) g;
\definition decodeEncode: \forall (x: Base)(f: Fiber x) -> decode x (encode x f) = f :=
  \fun (x: Base)(f: Fiber x) => GL.Frames[V := F x, space := space x].transitive ((bundle.atlas.local i).frame x) f;
\definition encodeDecode: \forall (x: Base)(g: GL.Carrier) -> encode x (decode x g) = g :=
  \fun (x: Base)(g: GL.Carrier) => GL.ext _ _ (\fun (v: GL.Vector) => ((bundle.atlas.local i).frame x).rightInverse (g.forward.apply v));

\definition actionFormula: \forall (x: Base)(f: Fiber x)(g: GL.Carrier) -> encode x (GL.Frames[V := F x, space := space x].act f g) = GL.multiply (encode x f) g :=
  \fun (x: Base)(f: Fiber x)(g: GL.Carrier) => GL.ext (encode x (GL.Frames[V := F x, space := space x].act f g)) (GL.multiply (encode x f) g)
    (\fun (v: GL.Vector) => \refl(((bundle.atlas.local i).frame x).forward.apply (f.backward.apply (g.forward.apply v))));
\definition actionSmooth: \forall (d: N.Nat^)(U: calculus.Real[].Multivariable[n := d].Open[].OpenSet)(f, g: calculus.Real[].Multivariable[n := d].Open[].Carrier U -> GL.Carrier) ->
  \root.ComplexLinear[r := r].Smooth[d := d].Regular U f -> \root.ComplexLinear[r := r].Smooth[d := d].Regular U g ->
  \root.ComplexLinear[r := r].Smooth[d := d].Regular U (\fun (u: calculus.Real[].Multivariable[n := d].Open[].Carrier U) => GL.multiply (f u) (g u)) :=
  \fun (d: N.Nat^) => \root.ComplexLinear[r := r].Smooth[d := d].product;
