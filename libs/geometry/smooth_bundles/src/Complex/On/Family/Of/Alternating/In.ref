\import Operations.AlternatingFrame[V := F x, space := space x, n := r, frame := (bundle.atlas.local i).frame x, k := k, enumeration := enumeration] \as Frames;
\definition frame: Family.FrameAt x := Frames.isomorphism;
\import Spaces.Sums[I := Fin.Fin rank].Prop[] \as Sums;
\import Spaces.FiniteCoordinates[n := r].Exterior[] \as Exterior;
\definition evaluation: \forall (v: Fin.Fin rank -> C.Complex)(arguments: Fin.Fin k -> F x) -> frame.backward.apply v arguments =
  Spaces.Sums[I := Fin.Fin rank].sum (Fin.elements rank) (\fun (a: Fin.Fin rank) => Algebra.field.mul (v a)
    (Exterior.word k (Coefficients.enumerate a) (\fun (l: Fin.Fin k) => ((bundle.atlas.local i).frame x).forward.apply (arguments l)))) :=
  \fun (v: Fin.Fin rank -> C.Complex)(arguments: Fin.Fin k -> F x) => trans!{{C.Complex}}
    (frame.backward.apply v arguments)
    (Spaces.Sums[I := Fin.Fin rank].sum (Fin.elements rank) (\fun (a: Fin.Fin rank) => Algebra.field.mul (v a) (Frames.word a arguments)))
    (Spaces.Sums[I := Fin.Fin rank].sum (Fin.elements rank) (\fun (a: Fin.Fin rank) => Algebra.field.mul (v a)
      (Exterior.word k (Coefficients.enumerate a) (\fun (l: Fin.Fin k) => ((bundle.atlas.local i).frame x).forward.apply (arguments l)))))
    (Frames.evaluation v arguments)
    (Sums.congruent (Fin.elements rank)
      (\fun (a: Fin.Fin rank) => Algebra.field.mul (v a) (Frames.word a arguments))
      (\fun (a: Fin.Fin rank) => Algebra.field.mul (v a) (Exterior.word k (Coefficients.enumerate a) (\fun (l: Fin.Fin k) => ((bundle.atlas.local i).frame x).forward.apply (arguments l))))
      (\fun (a: Fin.Fin rank) => congr!{{C.Complex} {C.Complex}} (Algebra.field.mul (v a))
        (Frames.word a arguments) (Exterior.word k (Coefficients.enumerate a) (\fun (l: Fin.Fin k) => ((bundle.atlas.local i).frame x).forward.apply (arguments l))) (Frames.wordFormula a arguments)));
