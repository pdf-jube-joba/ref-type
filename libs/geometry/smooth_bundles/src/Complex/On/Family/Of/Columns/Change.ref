\import Result.Using[I := I, data := data].Change[i := i, j := j] \as New;
\import ComplexAtlas.Change[i := i, j := j] \as Old;
\import Charts.Transition[left := (bundle.atlas.local i).chart, right := (bundle.atlas.local j).chart] \as Base;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\definition columnVector[v: Fin.Fin rank -> C.Complex][b: Fin.Fin r]: Fin.Fin r -> C.Complex := \fun (a: Fin.Fin r) => v (Indices.index (pair a b));
\definition formula: \forall (v: Fin.Fin rank -> C.Complex)(a: Fin.Fin rank)(t: Open.Carrier Base.domain) -> (New.matrix t).apply v a = (Old.matrix t).apply (columnVector v (column (Indices.enumerate a))) (row (Indices.enumerate a)) := \fun (v: Fin.Fin rank -> C.Complex)(a: Fin.Fin rank)(t: Open.Carrier Base.domain) => \refl((New.matrix t).apply v a);
\definition smooth: New.Regular := \fun (v: Fin.Fin rank -> C.Complex)(a: Fin.Fin rank) => \parent.\parent.Change[i := i, j := j].evaluate (columnVector v (column (Indices.enumerate a))) (row (Indices.enumerate a));
