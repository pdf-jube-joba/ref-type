\import Scalars.Neighborhood[c := c, U := neighborhood.openSet, open := neighborhood.open] \as Region;
\import smooth_partitions.Countable[A := M.Point] \as Countable;
\definition tail: \forall (t: Open.Carrier Region.domain) -> Countable.TailZero (Functions.FamilyValues partition.functions)
  (Charts.point c (Open.inclusion Region.domain c.image Region.included t)) neighborhood.bound :=
  \fun (t: Open.Carrier Region.domain)(k: N.Nat^)(later: _) => Complement.Weighted[entry := entry k].zeroOffSupport
    (Charts.point c (Open.inclusion Region.domain c.image Region.included t))
    (neighborhood.avoids k later (Charts.point c (Open.inclusion Region.domain c.image Region.included t)) (Region.point t));
\definition formula: \forall (t: Open.Carrier Region.domain) -> coefficient data j a b (Open.inclusion Region.domain c.image Region.included t) = prefix neighborhood.bound (Open.inclusion Region.domain c.image Region.included t) :=
  \fun (t: Open.Carrier Region.domain) => Construction.At[x := Charts.point c (Open.inclusion Region.domain c.image Region.included t)].formula neighborhood.bound (tail t)
    (vectors (Charts.point c (Open.inclusion Region.domain c.image Region.included t)) a) (vectors (Charts.point c (Open.inclusion Region.domain c.image Region.included t)) b);
\import \root.ComplexCalculus[n := n].On[U := Region.domain] \as Calculus;
\import \root.ComplexCalculus[n := n].Restriction[U := Region.domain, V := c.image, included := Region.included] \as Restriction;
\definition patch: Locally.Patch := Locally.Patch { domain := Region.domain, included := Region.included,
  smooth := Calculus.equalSmooth (\fun (t: Open.Carrier Region.domain) => prefix neighborhood.bound (Open.inclusion Region.domain c.image Region.included t))
    (\fun (t: Open.Carrier Region.domain) => coefficient data j a b (Open.inclusion Region.domain c.image Region.included t))
    (\fun (t: Open.Carrier Region.domain) => sym!{{C.Complex}} _ _ (formula t)) (Restriction.smooth (prefix neighborhood.bound) (prefixSmooth neighborhood.bound)),
};
\definition contains: Locally.Contains patch u := Region.contains u neighborhood.contains;
