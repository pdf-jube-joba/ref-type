\import SumAtlas.Change[i := i, j := j] \as New;
\import ComplexAtlas.Change[i := i, j := j] \as Left;
\import OtherAtlas.Change[i := i, j := j] \as Right;
\import Charts.Transition[left := (bundle.atlas.local i).chart, right := (bundle.atlas.local j).chart] \as Base;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import \root.ComplexCalculus[n := n].On[U := Base.domain] \as Calculus;
\import Indices.Tuples[A := C.Complex] \as Tuples;
\definition atIndex: \forall (w: Fin.Fin rank -> C.Complex)(a: Indices.Index) -> Calculus.Smooth
  (\fun (t: Open.Carrier Base.domain) => Tuples.evaluate ((Left.matrix t).apply (Coordinates.left w)) ((Right.matrix t).apply (Coordinates.right w)) a) :=
  \fun (w: Fin.Fin rank -> C.Complex) => \induction (a: Indices.Index) \return Calculus.Smooth
    (\fun (t: Open.Carrier Base.domain) => Tuples.evaluate ((Left.matrix t).apply (Coordinates.left w)) ((Right.matrix t).apply (Coordinates.right w)) a) \with {
      | inl: \fun (b: Fin.Fin r) => \parent.\parent.\parent.\parent.Change[i := i, j := j].evaluate (Coordinates.left w) b
      | inr: \fun (b: Fin.Fin s) => regular i j (Coordinates.right w) b
    };
\definition smooth: New.Regular := \fun (w: Fin.Fin rank -> C.Complex)(a: Fin.Fin rank) => atIndex w (Indices.split a);
