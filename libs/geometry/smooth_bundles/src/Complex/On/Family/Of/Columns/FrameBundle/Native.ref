\import \parent.NativeGL[] \as Matrix;
\definition frameDimension: N.Nat^ := dimension;
\import manifolds.Dimension[n := frameDimension].Chart[M := Point, space := manifold.space] \as Charts;
\import manifolds.Dimension[n := frameDimension].Atlas[M := Point, space := manifold.space] \as Atlas;
\definition chart[i: I]: \Cast[Charts.Chart] manifold.atlas.charts := \into[Charts.Chart](Submanifold.restricted (Build.totalChart i), manifold.atlas.charts) \by {
  Atlas.includedInSaturation Submanifold.atlas (Submanifold.restricted (Build.totalChart i))
    (Logic.existsIntro[Submanifold.OriginalChart, { c: Submanifold.OriginalChart \where Submanifold.restricted c = Submanifold.restricted (Build.totalChart i) }]
      (Build.totalChart i) (\refl(Submanifold.restricted (Build.totalChart i))))
};
\definition covers: \forall (p: Point) -> \exists ( i: I \where Charts.Contains (chart i) p ) := \fun (p: Point) => bundle.atlas.covers p.base;
\module Local(i: I);

\module Action;
