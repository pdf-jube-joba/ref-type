\definition leftSmooth: \forall (j: Fin.Fin rank) -> \root.ComplexCalculus[n := d].On[U := U].Smooth (\fun (x: Source.Carrier U) => decode (a x) j) := \root.ComplexCoordinates[n := d, r := rank].On[U := U].decodeSmooth a left;
\definition rightSmooth: \forall (j: Fin.Fin rank) -> \root.ComplexCalculus[n := d].On[U := U].Smooth (\fun (x: Source.Carrier U) => decode (b x) j) := \root.ComplexCoordinates[n := d, r := rank].On[U := U].decodeSmooth b right;
\definition entrySmooth: \forall (i, j: Fin.Fin r) -> \root.ComplexCalculus[n := d].On[U := U].Smooth (\fun (x: Source.Carrier U) => Matrices.product (matrix (a x)) (matrix (b x)) i j) :=
  \fun (i, j: Fin.Fin r) => \root.ComplexCalculus[n := d].On[U := U].Sums[I := Fin.Fin r].smooth (Fin.elements r) (\fun (k: Fin.Fin r)(x: Source.Carrier U) => C.Algebra[].field.mul (matrix (a x) i k) (matrix (b x) k j))
    (\fun (k: Fin.Fin r) => \root.ComplexCalculus[n := d].On[U := U].times (\fun (x: Source.Carrier U) => matrix (a x) i k) (\fun (x: Source.Carrier U) => matrix (b x) k j)
      (leftSmooth (Indices.index (pair i k))) (rightSmooth (Indices.index (pair k j))));
\definition flatSmooth: \forall (j: Fin.Fin rank) -> \root.ComplexCalculus[n := d].On[U := U].Smooth (\fun (x: Source.Carrier U) => flatten (Matrices.product (matrix (a x)) (matrix (b x))) j) :=
  \fun (j: Fin.Fin rank) => entrySmooth (row (Indices.enumerate j)) (column (Indices.enumerate j));
\definition smooth: \forall (j: Fin.Fin size) -> Source.Smooth[].SmoothOn U (\fun (x: Source.Carrier U) => multiply (a x) (b x) j) := \root.ComplexCoordinates[n := d, r := rank].On[U := U].encodeSmooth (\fun (x: Source.Carrier U) => flatten (Matrices.product (matrix (a x)) (matrix (b x)))) flatSmooth;
