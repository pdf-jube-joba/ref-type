\import UnderlyingBundle.Sections[] \as UnderlyingSections;
\definition SmoothMap: \Set := UnderlyingSections.SmoothMap;
\definition Data: \Set := UnderlyingSections.Data;
\definition Section: \Set := UnderlyingSections.Section;
\definition apply: SmoothMap -> M.Point -> Point := UnderlyingSections.apply;
\definition total: Data -> M.Point -> Point := UnderlyingSections.total;
\definition Smooth: Data -> \Prop := UnderlyingSections.Smooth;
\definition regular: \forall (s: Section) -> Smooth s := \fun (s: Section) => UnderlyingSections.regular s;
\definition zeroData: Data := UnderlyingSections.zeroData;
\definition zero: Section := UnderlyingSections.zero;
\definition projection: \forall (s: Section)(x: M.Point) -> Underlying.projection (total s x) = x := UnderlyingSections.projection;
