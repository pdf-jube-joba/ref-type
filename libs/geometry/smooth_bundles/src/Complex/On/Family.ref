\definition realSpace[x: M.Point]: RealSpaces.VectorSpace (F x) := Operations.RealScalars[V := F x, space := space x].realSpace;
\definition FrameAt[x: M.Point]: \Set := Spaces.Isomorphism[V := F x, W := Vector, source := space x, target := coordinates].Isomorphism;
\structure Local: \Set := { chart: Chart, frame: \forall (x: Charts.LocalPoint chart) -> FrameAt x };
\structure Data[I: \Set]: \Set := {
  local: I -> Local,
  covers: \forall (x: M.Point) -> \exists ( i: I \where Charts.Contains (local i).chart x ),
};
\import tangent_bundles.FrameBundle[n := n, r := realRank].Over[M := M].Family[F := F, space := realSpace] \as Underlying;
\definition Point: \Set := Underlying.Point;
\definition include[x: M.Point][v: F x]: Point := Underlying.include x v;
\definition projection: Point -> M.Point := Underlying.projection;
\module In(local: Local, x: Charts.LocalPoint local.chart);
\module Using(I: \Set, data: Data[I]);
\structure Bundle[I: \Set]: \Set := {
  atlas: Data[I],
  regular: Underlying.Using[I := I, data := \root.Complex[n := n, r := r].On[M := M].Family[F := F, space := space].Using[I := I, data := atlas].realData].Changes,
};
\module Of(I: \Set, bundle: Bundle[I]);
