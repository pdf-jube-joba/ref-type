\import linear_algebra.Euclidean[n := r] \as E;
\import tangent_bundles.Trivial[n := n, r := r].On[M := M] \as Product;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\definition Index: \Set := \Cast[Charts.Chart] M.atlas.charts;
\definition chart[i: Index]: Index := i;
\definition covers: \forall (x: M.Point) -> \exists ( i: Index \where Charts.Contains i x ) := \block {
  \fun (x: M.Point) \then
  \takefrom c: \Cast[Charts.Chart] ({ c: Charts.Chart \where Logic.And[\In[Charts.Chart] M.atlas.charts c, Charts.Contains c x] }) \by M.atlas.covers x \then
  \let evidence: Logic.And[\In[Charts.Chart] M.atlas.charts c, Charts.Contains c x] := \bysub(Charts.Chart, { c: Charts.Chart \where Logic.And[\In[Charts.Chart] M.atlas.charts c, Charts.Contains c x] }, c) \then
  \return Logic.existsIntro[Index, { i: Index \where Charts.Contains i x }] (\into[Charts.Chart](c, M.atlas.charts) \by { evidence.left }) evidence.right
};
\import Product.Covered[I := Index, chart := chart, covers := covers] \as Covered;
\import \parent.Family[F := \fun (x: M.Point) => E.Vector, space := \fun (x: M.Point) => E.space] \as Family;
\definition bundle: Family.Bundle[Index] := Family.Bundle[Index] { atlas := Covered.data, regular := Covered.changes };
