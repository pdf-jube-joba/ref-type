\import Underlying.Using[I := I, data := bundle.atlas] \as Atlas;
\import Atlas.Build[changes := bundle.regular] \as Construction;
\definition manifold: TotalModel.Manifold := Construction.manifold;
\definition topology: topology.Structures[].Topology[Point] := Construction.topology;
\import Construction.Projection[] \as Projection;
\import Construction.Zero[] \as Zero;
\import Atlas.Addition[changes := bundle.regular] \as Addition;
\import Atlas.Scaling[changes := bundle.regular] \as Scaling;
\module Sections;
\module Identity;

\import bundle_operations.Operations[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Operations;
\module Reverse(i, j: I);
\module Dual;

\module Paired(s: N.Nat^, G: M.Point -> \Set, otherSpace: \forall (x: M.Point) -> Spaces.VectorSpace (G x),
  otherFrame: \forall (i: I)(x: manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space].LocalPoint (bundle.atlas.local i).chart) ->
    Underlying.ExtraFrameAt s G otherSpace x);

\module Alternating(k: N.Nat^, enumeration: Operations.ExteriorIndices[n := r, k := k].Enumeration);
\module Exterior(k: N.Nat^, enumeration: Operations.ExteriorIndices[n := r, k := k].Enumeration);

\module Forget;

\module Metrics;

\module Frames;
\module Associated(s: N.Nat^, representation: \root.RealLinear[r := r].Representation[s := s].Representation);

\module Columns(enumeration: Operations.PairIndices[n := r, m := r].Enumeration);
