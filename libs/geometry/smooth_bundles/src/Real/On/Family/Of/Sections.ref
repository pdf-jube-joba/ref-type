\import manifolds.SmoothMap[n := n, m := totalDimension].Between[M := M, N := manifold] \as Maps;
\definition SmoothMap: \Set := Maps.Map;
\definition apply: SmoothMap -> M.Point -> Point := Maps.apply;
\structure Data: \Set := { value: \forall (x: M.Point) -> F x };
\definition total[s: Data][x: M.Point]: Point := include x (s.value x);
\definition Smooth[s: Data]: \Prop := \exists ( map: Maps.Map \where Maps.apply map = total s );
\definition Section: \Set := \Cast[Data] ({ s: Data \where Smooth s });
\definition regular[s: Section]: Smooth s := \bysub(Data, Section, s);
\definition zeroData: Data := Data { value := \fun (x: M.Point) => (space x).zero };
\definition zero: Section := \into[Data](zeroData, Section) \by {
  Logic.existsIntro[Maps.Map, { map: Maps.Map \where Maps.apply map = total zeroData }] Zero.map Zero.apply
};
\definition projection: \forall (s: Section)(x: M.Point) -> Underlying.projection (total s x) = x :=
  \fun (s: Section)(x: M.Point) => \refl(x);
