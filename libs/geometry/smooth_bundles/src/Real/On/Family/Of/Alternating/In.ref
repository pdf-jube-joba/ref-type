\import Operations.AlternatingFrame[V := F x, space := space x, n := r, frame := (bundle.atlas.local i).frame x, k := k, enumeration := enumeration] \as Frames;
\definition frame: Total.FrameAt x := Frames.isomorphism;
\import Spaces.Sums[I := Fin.Fin rank].Prop[] \as Sums;
\import Spaces.FiniteCoordinates[n := r].Exterior[] \as Exterior;
\definition evaluation: \forall (v: Fin.Fin rank -> R.Real)(arguments: Fin.Fin k -> F x) -> frame.backward.apply v arguments =
  Spaces.Sums[I := Fin.Fin rank].sum (Fin.elements rank) (\fun (a: Fin.Fin rank) => R.mul (v a)
    (Exterior.word k (Coefficients.enumerate a) (\fun (l: Fin.Fin k) => ((bundle.atlas.local i).frame x).forward.apply (arguments l)))) :=
  \fun (v: Fin.Fin rank -> R.Real)(arguments: Fin.Fin k -> F x) => trans!{{R.Real}} _ _ _ (Frames.evaluation v arguments)
    (Sums.congruent (Fin.elements rank) _ _ (\fun (a: Fin.Fin rank) => congr!{{R.Real} {R.Real}} (R.mul (v a)) _ _ (Frames.wordFormula a arguments)));
