\import \root.Maps[n := n, r := r, s := r].On[M := M].Families[F := F, G := F, sourceSpace := space, targetSpace := space, I := I, J := I, source := bundle, target := bundle] \as Maps;
\definition data: Maps.Data := Maps.Data { fiber := \fun (x: M.Point) => Spaces.Eigen[V := F x, space := space x].identity };
\import manifolds.SelfMap[n := totalDimension].Identity[M := manifold] \as Identity;
\definition map: Maps.Map := \into[Maps.Data](data, Maps.Map) \by {
  Logic.existsIntro[Maps.TotalMap, { f: Maps.TotalMap \where Maps.totalApply f = Maps.total data }] Identity.map
    (\axiom:funext(Maps.totalApply Identity.map, Maps.total data, \fun (p: Point) => sym!{Point} _ _ (Underlying.eta p)))
};
