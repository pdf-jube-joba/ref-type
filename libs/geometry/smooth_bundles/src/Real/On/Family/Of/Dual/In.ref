\import Operations.DualFrame[V := F x, space := space x, n := r, frame := (bundle.atlas.local i).frame x] \as Dual;
\definition frame: Total.FrameAt x := Dual.isomorphism;
\definition evaluation: \forall (v: Fin.Fin r -> R.Real)(w: F x) -> frame.backward.apply v w = Spaces.Sums[I := Fin.Fin r].sum (Fin.elements r)
  (\fun (a: Fin.Fin r) => R.mul (v a) (((bundle.atlas.local i).frame x).forward.apply w a)) := Dual.evaluation;
