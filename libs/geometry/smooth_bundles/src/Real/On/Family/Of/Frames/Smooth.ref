\import \root.Real[n := n, r := r].On[M := M].Family[F := F, space := space].Of[I := I, bundle := bundle].Frames[] \as Original;
\import \parent.\parent.Columns[enumeration := enumeration].FrameBundle[] \as Construction;
\import manifolds.Dimension[n := Construction.dimension].Smooth[] \as Models;
\definition dimension: N.Nat^ := Construction.dimension;
\definition manifold: Models.Manifold := Construction.manifold;
\definition Point: \Set := Construction.Point;
\definition embed: Original.Point -> Point := Construction.embed;

\import Construction.NativeGL[] \as Group;
\definition groupDimension: N.Nat^ := Group.size;
\import manifolds.Dimension[n := groupDimension].Smooth[] \as GroupModels;
\definition groupManifold: GroupModels.Manifold := Group.manifold;
\definition GroupPoint: \Set := Group.Point;
\definition toGroupPoint: GL.Carrier -> GroupPoint := Group.toPoint;
\definition fromGroupPoint: GroupPoint -> GL.Carrier := Group.fromPoint;
\module Local(i: I);
\module Action;
