\import \root.Real[n := n, r := r].On[M := M].Family[F := F, space := space].Of[I := I, bundle := bundle].Columns[enumeration := enumeration].FrameBundle[].Native[].Local[i := i] \as Native;
\definition source: Models.Manifold := Native.source;
\definition target: Models.Manifold := Native.target;
\definition diffeomorphism: manifolds.Diffeomorphism[n := dimension, m := dimension].Between[M := source, N := target].Diffeomorphism := Native.diffeomorphism;
\definition groupMap: manifolds.SmoothMap[n := dimension, m := groupDimension].Between[M := target, N := groupManifold].Map := Native.groupMap;
\import manifolds.SmoothMap[n := dimension, m := dimension].Between[M := source, N := target] \as Maps;
\definition groupFormula: \forall (p: source.Point) -> calculus.Blocks[n := n, m := groupDimension].right (Maps.apply diffeomorphism.forward p) = toGroupPoint (Native.group p) := Native.forwardGroup;
\definition basePreserved: \forall (p: source.Point) -> manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space].point Native.c
  (calculus.Blocks[n := n, m := groupDimension].On[U := Native.c.image, V := Group.domain].leftPoint (Maps.apply diffeomorphism.forward p)) = p.base := Native.projectionPreserved;
