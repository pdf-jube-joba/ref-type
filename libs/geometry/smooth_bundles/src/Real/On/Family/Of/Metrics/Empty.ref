\definition impossible[x: M.Point]: Logic.False := \block {
  \takefrom i: \Cast[I] ({ i: I \where Charts.Contains (bundle.atlas.local i).chart x }) \by bundle.atlas.covers x \then
  \return noIndex (\exact(i, I))
};
\definition form[x: M.Point]: Form x := \root.HermitianForms[K := R.Real, field := R.Algebra[].field, scalar := linear_algebra.Hermitian[].Real[].scalar].On[V := F x, space := space x].zero;
\definition data: Data := Data {
  form := form,
  positive := \fun (x: M.Point) => Logic.falseElim (Positive x (form x)) (impossible x),
};
\definition metric: Metric := \into[Data](data, Metric) \by {
  \fun (i: I)(a, b: Fin.Fin r) => Logic.falseElim (Regularity.SmoothOn (bundle.atlas.local i).chart.image (coefficient data i a b)) (noIndex (\exact(i, I)))
};
