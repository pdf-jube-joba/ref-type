\definition originalAtlas: tangent_bundles.FrameBundle[n := n, r := r].Over[M := M].Family[F := F, space := space].Data[I] := bundle.atlas;
\import Operations.PairIndices[n := r, m := r] \as Pairs;
\import Operations.FiniteIndex[A := Pairs.Pair, S := Pairs.Whole, enumeration := enumeration] \as Indices;
\import std.Data[].Pair[] \as Pair;
\definition rank: N.Nat^ := Indices.rank;
\definition Fiber[x: M.Point]: \Set := Fin.Fin r -> F x;
\definition fiberSpace[x: M.Point]: Spaces.VectorSpace (Fiber x) := Spaces.DependentProduct[I := Fin.Fin r, F := \fun (j: Fin.Fin r) => F x, familySpace := \fun (j: Fin.Fin r) => space x].space;
\definition pair[a, b: Fin.Fin r]: Indices.Index := \into[Pairs.Pair](Pair.pair (Fin.Fin r) (Fin.Fin r) a b, Pairs.Whole) \by { \refl(Pair.pair (Fin.Fin r) (Fin.Fin r) a b) };
\definition row[a: Indices.Index]: Fin.Fin r := Pair.first (Fin.Fin r) (Fin.Fin r) a;
\definition column[a: Indices.Index]: Fin.Fin r := Pair.second (Fin.Fin r) (Fin.Fin r) a;
\import \root.Real[n := n, r := rank].On[M := M].Family[F := Fiber, space := fiberSpace] \as Result;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\module Local(i: I, x: Charts.LocalPoint (bundle.atlas.local i).chart);
\definition local[i: I]: tangent_bundles.FrameBundle[n := n, r := rank].Over[M := M].Family[F := Fiber, space := fiberSpace].Local := tangent_bundles.FrameBundle[n := n, r := rank].Over[M := M].Family[F := Fiber, space := fiberSpace].Local { chart := (bundle.atlas.local i).chart, frame := \fun (x: Charts.LocalPoint (bundle.atlas.local i).chart) => Local[i := i, x := x].frame };
\definition data: tangent_bundles.FrameBundle[n := n, r := rank].Over[M := M].Family[F := Fiber, space := fiberSpace].Data[I] := tangent_bundles.FrameBundle[n := n, r := rank].Over[M := M].Family[F := Fiber, space := fiberSpace].Data[I] { local := local, covers := bundle.atlas.covers };
\module Change(i, j: I);
\definition columnsBundle: Result.Bundle[I] := Result.Bundle[I] { atlas := data, regular := \fun (i, j: I) => Change[i := i, j := j].smooth };

\module FrameBundle;
