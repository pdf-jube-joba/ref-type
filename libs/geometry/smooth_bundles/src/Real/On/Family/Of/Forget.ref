\import vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Bundles;
\import Bundles.Family[X := M.Point, F := F] \as Continuous;
\definition embed[p: Continuous.Point]: Point := include p.base p.vector;
\definition recover[p: Point]: Continuous.Point := Continuous.include p.base p.vector;
\import topological_constructions.Induced[A := Continuous.Point, B := Point] \as Induced;
\definition totalTopology: topology.Topology[Carrier := Continuous.Point].Topology := Induced.topology topology embed;
\definition embedContinuous: topology.Continuity[A := Continuous.Point, B := Point].Continuous totalTopology topology embed := Induced.continuous topology embed;
\definition recoverContinuous: topology.Continuity[A := Point, B := Continuous.Point].Continuous topology totalTopology recover :=
  Induced.Universal[Z := Point].continuous topology topology embed recover
    (\idelim (\fun (p: Point) => p) = (\fun (p: Point) => embed (recover p))
      \with f: (Point -> Point) => topology.Continuity[A := Point, B := Point].Continuous topology topology f \by {
        base: topology.Maps[A := Point, B := Point].Identity[].continuous topology,
        equality: \axiom:funext((\fun (p: Point) => p), (\fun (p: Point) => embed (recover p)), \fun (p: Point) => sym!{Point} _ _ (Underlying.eta p))
      });
\definition homeomorphism: topology.Homeomorphism[A := Continuous.Point, B := Point].Homeomorphism[totalTopology, topology] :=
  topology.Homeomorphism[A := Continuous.Point, B := Point].Homeomorphism[totalTopology, topology] {
    forward := embed, backward := recover, leftInverse := Continuous.eta, rightInverse := Underlying.eta,
    forwardContinuous := embedContinuous, backwardContinuous := recoverContinuous,
  };
\definition data: Continuous.Data := Continuous.Data { baseSpace := M.space, totalSpace := totalTopology, space := space };
\import Continuous.With[data := data] \as Trivializations;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\import manifolds.Dimension[n := totalDimension].Chart[M := Point, space := topology] \as TotalCharts;
\import manifolds.SmoothMap[n := totalDimension, m := n].Between[M := manifold, N := M] \as BaseMaps;
\definition projectionContinuous: topology.Continuity[A := Continuous.Point, B := M.Point].Continuous totalTopology M.space Continuous.projection :=
  topology.Composition[A := Continuous.Point, B := Point, C := M.Point].composeContinuous totalTopology topology M.space embed Underlying.projection embedContinuous
    (\bysub(BaseMaps.Data, { f: BaseMaps.Data \where BaseMaps.Continuous f }, Projection.map));
\module Local(i: I);
\definition forget: Continuous.Bundle := \into[Continuous.Data](data, Continuous.Bundle) \by {
  \fun (x: M.Point) => \block {
    \takefrom i: \Cast[I] ({ i: I \where Charts.Contains (bundle.atlas.local i).chart x }) \by bundle.atlas.covers x \then
    \return Logic.existsIntro[Trivializations.Chart, { c: Trivializations.Chart \where \In[M.Point] c.domain x }] (Local[i := i].chart)
      (\bysub(I, { i: I \where Charts.Contains (bundle.atlas.local i).chart x }, i))
  }
};
