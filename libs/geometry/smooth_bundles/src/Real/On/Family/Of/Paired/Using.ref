\definition second: OtherSmooth.Bundle[I] := OtherSmooth.Bundle[I] { atlas := Sum.otherData, regular := regular };
\import Sum.Build[firstChanges := bundle.regular, secondChanges := regular] \as SumConstruction;
\definition SumFiber: M.Point -> \Set := Sum.Fiber;
\definition sumSpace: \forall (x: M.Point) -> Spaces.VectorSpace (SumFiber x) := Sum.fiberSpace;
\import \root.Real[n := n, r := Sum.rank].On[M := M].Family[F := SumFiber, space := sumSpace] \as SumFamily;
\definition directSum: SumFamily.Bundle[I] := SumFamily.Bundle[I] { atlas := Sum.sumData, regular := SumConstruction.changes };
\module Tensor(enumeration: Operations.PairIndices[n := r, m := s].Enumeration);
