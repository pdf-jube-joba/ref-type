\definition Fiber[x: M.Point]: \Set := Spaces.Dual[V := F x, source := space x].Carrier;
\definition fiberSpace[x: M.Point]: Spaces.VectorSpace (Fiber x) := Spaces.Dual[V := F x, source := space x].space;
\import \root.Real[n := n, r := r].On[M := M].Family[F := Fiber, space := fiberSpace] \as Family;
\import tangent_bundles.FrameBundle[n := n, r := r].Over[M := M].Family[F := Fiber, space := fiberSpace] \as Total;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\module In(i: I, x: Charts.LocalPoint (bundle.atlas.local i).chart);
\definition local[i: I]: Total.Local := Total.Local { chart := (bundle.atlas.local i).chart, frame := \fun (x: Charts.LocalPoint (bundle.atlas.local i).chart) => In[i := i, x := x].frame };
\definition data: Total.Data[I] := Total.Data[I] { local := local, covers := bundle.atlas.covers };
\import Total.Using[I := I, data := data] \as DualAtlas;
\module Change(i, j: I);
\definition changes: DualAtlas.Changes := \fun (i, j: I)(a, b: Fin.Fin r) => Change[i := i, j := j].smooth a b;
\definition dual: Family.Bundle[I] := Family.Bundle[I] { atlas := data, regular := changes };
