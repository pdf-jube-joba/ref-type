\import tangent_bundles.FrameBundle[n := n, r := s].Over[M := M].Family[F := Fiber, space := fiberSpace].Using[I := I, data := atlas].Change[i := i, j := j] \as Change;
\import \parent.\parent.Frames[].Change[i := i, j := j] \as Source;
\import Charts.Transition[left := (bundle.atlas.local i).chart, right := (bundle.atlas.local j).chart] \as Base;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\definition represented[t: Open.Carrier Base.domain]: TargetGL.Carrier := representation.apply (Source.value t);
\definition regular: \root.RealLinear[r := s].Smooth[d := n].Regular Base.domain represented := laws.smooth n Base.domain Source.value Source.smooth;
\definition formula: \forall (t: Open.Carrier Base.domain)(v: Fin.Fin s -> R.Real) -> (Change.linear t).apply v = (represented t).forward.apply v :=
  \fun (t: Open.Carrier Base.domain)(v: Fin.Fin s -> R.Real) => Glued.At[x := Change.x t].Frame[i := \parent.Local[i := i].index (Change.x t)].assembledValue v (\parent.Local[i := j].index (Change.y t));
\definition smooth: Change.Regular := \fun (a, b: Fin.Fin s) =>
  smooth_partitions.Euclidean[n := n].smoothCongruent Base.domain (\fun (t: Open.Carrier Base.domain) => (represented t).forward.apply (R.FiniteSums[].Linear[].basis s b) a)
    (\fun (t: Open.Carrier Base.domain) => (Change.linear t).apply (R.FiniteSums[].Linear[].basis s b) a)
    (\fun (t: Open.Carrier Base.domain) => sym!{R.Real} _ _ (congr!{{Fin.Fin s -> R.Real} R.Real} (\fun (w: Fin.Fin s -> R.Real) => w a) _ _ (formula t (R.FiniteSums[].Linear[].basis s b))))
    (regular a b);
