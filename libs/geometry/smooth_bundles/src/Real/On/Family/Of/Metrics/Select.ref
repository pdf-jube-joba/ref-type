\definition Choice[k: N.Nat^]: \Set := \Cast[I] ({ i: I \where Base.Subset (Functions.support (partition.functions k)) (bundle.atlas.local i).chart.domain });
\definition existsChoice: \forall (k: N.Nat^) -> \exists Choice k := \fun (k: N.Nat^) => either!{{partition.refines k} {\exists Choice k}
  {\fun (member: Base.FamilyMember family (partition.targets k)) => \block {
    \takefrom i: \Cast[I] ({ i: I \where (bundle.atlas.local i).chart.domain = partition.targets k }) \by member \then
    \return Logic.existsIntro[I, { i: I \where Base.Subset (Functions.support (partition.functions k)) (bundle.atlas.local i).chart.domain }] i
      (\fun (x: M.Point)(inside: _) => \idelim partition.targets k = (bundle.atlas.local i).chart.domain \with U: \Pow M.Point => Base.Member U x \by {
        base: partition.subordinate k x inside, equality: sym!{{\Pow M.Point}} _ _ (\bysub(I, { i: I \where (bundle.atlas.local i).chart.domain = partition.targets k }, i))
      })
  }}
  {\fun (empty: partition.targets k = Base.Empty) => Logic.existsIntro[I, { i: I \where Base.Subset (Functions.support (partition.functions k)) (bundle.atlas.local i).chart.domain }] default
    (\fun (x: M.Point)(inside: _) => Logic.falseElim (Base.Member (bundle.atlas.local default).chart.domain x)
      (\idelim partition.targets k = Base.Empty \with U: \Pow M.Point => Base.Member U x \by { base: partition.subordinate k x inside, equality: empty }))}};
\definition exists: \exists Selection partition := \axiom:classicalIndefiniteChoice(N.Nat^, Choice, existsChoice);
