\definition c: \Cast[Charts.Chart] M.atlas.charts := (bundle.atlas.local j).chart;
\definition vectors[x: Charts.LocalPoint c][l: Fin.Fin r]: F x := ((bundle.atlas.local j).frame x).backward.apply (Standard.vectors l);
\definition prefix[length: N.Nat^][u: Open.Carrier c.image]: R.Real := (Construction.At[x := Charts.point c u].prefix length).dot (vectors (Charts.point c u) a) (vectors (Charts.point c u) b);
\module PrefixStep(length: N.Nat^, previous: Regularity.SmoothOn c.image (prefix length));
\definition prefixSmooth: \forall (length: N.Nat^) -> Regularity.SmoothOn c.image (prefix length) :=
  \induction (length: N.Nat^) \return Regularity.SmoothOn c.image (prefix length) \with {
    | zero: SmoothOperations.constantSmooth c.image R.zero
    | succ: \fun (length: N.Nat^)(previous: Regularity.SmoothOn c.image (prefix length)) => PrefixStep[length := length, previous := previous].smooth
  };
\import Open.LocalSmooth[U := c.image, f := coefficient data j a b] \as Local;
\module At(u: Open.Carrier c.image);
\definition smooth: Regularity.SmoothOn c.image (coefficient data j a b) := Local.smooth (\fun (u: Open.Carrier c.image) => At[u := u].existsPatch);
