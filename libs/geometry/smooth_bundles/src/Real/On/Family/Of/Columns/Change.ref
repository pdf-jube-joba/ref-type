\import tangent_bundles.FrameBundle[n := n, r := rank].Over[M := M].Family[F := Fiber, space := fiberSpace].Using[I := I, data := data].Change[i := i, j := j] \as New;
\import Atlas.Change[i := i, j := j] \as Old;
\import Charts.Transition[left := (bundle.atlas.local i).chart, right := (bundle.atlas.local j).chart] \as Base;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\definition columnVector[v: Fin.Fin rank -> R.Real][b: Fin.Fin r]: Fin.Fin r -> R.Real := \fun (a: Fin.Fin r) => v (Indices.index (pair a b));
\definition formula: \forall (v: Fin.Fin rank -> R.Real)(a: Fin.Fin rank)(t: Open.Carrier Base.domain) -> (New.linear t).apply v a = (Old.linear t).apply (columnVector v (column (Indices.enumerate a))) (row (Indices.enumerate a)) := \fun (v: Fin.Fin rank -> R.Real)(a: Fin.Fin rank)(t: Open.Carrier Base.domain) => \refl((New.linear t).apply v a);
\definition smooth: New.Regular := \fun (a, b: Fin.Fin rank) => calculus.MatrixFamily[d := n, p := r, q := r].evaluate Base.domain Old.linear (bundle.regular i j) (columnVector (R.FiniteSums[].Linear[].basis rank b) (column (Indices.enumerate a))) (row (Indices.enumerate a));
