\import Frames.Family[F := F, space := space] \as Underlying;
\definition Point: \Set := Underlying.Point;
\definition include[x: M.Point][v: F x]: Point := Underlying.include x v;
\definition projection: Point -> M.Point := Underlying.projection;
\structure Bundle[I: \Set]: \Set := {
  atlas: Underlying.Data[I],
  regular: Underlying.Using[I := I, data := atlas].Changes,
};
\module Of(I: \Set, bundle: Bundle[I]);
