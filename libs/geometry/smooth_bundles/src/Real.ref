\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as R;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real (R.Algebra[].field)] \as Spaces;
\import manifolds.Dimension[n := n].Smooth[] \as BaseModel;
\definition totalDimension: N.Nat^ := calculus.Blocks[n := n, m := r].dimension;
\import manifolds.Dimension[n := totalDimension].Smooth[] \as TotalModel;
\module On(M: BaseModel.Manifold);
