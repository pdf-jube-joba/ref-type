\import std.Data[].Nat[] \as N;
\definition zero: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zero;
\import manifolds.Dimension[n := zero].Examples[].Euclidean[] \as Base;
\import \root.Real[n := zero, r := zero].On[M := Base.smoothManifold].Trivial[] \as Real;
\import linear_algebra.Euclidean[n := zero] \as Empty;
\import \root.Real[n := zero, r := zero].On[M := Base.smoothManifold].Family[F := \fun (x: calculus.Real[].Multivariable[n := zero].Point) => Empty.Vector, space := \fun (x: calculus.Real[].Multivariable[n := zero].Point) => Empty.space].Of[I := Real.Index, bundle := Real.bundle] \as RealBundle;
\definition realZeroMetric: \exists RealBundle.Metrics[].Metric := RealBundle.Metrics[].existsMetric;
\import \root.Complex[n := zero, r := zero].On[M := Base.smoothManifold] \as ComplexBase;
\import ComplexBase.Trivial[] \as Complex;
\import linear_algebra.Commutative[K := complex.Complex[].Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing complex.Complex[].Complex (complex.Complex[].Algebra[].field)] \as Spaces;
\import \root.Complex[n := zero, r := zero] \as ComplexModel;
\import ComplexBase.Family[F := \fun (x: calculus.Real[].Multivariable[n := zero].Point) => ComplexModel.Vector, space := \fun (x: calculus.Real[].Multivariable[n := zero].Point) => ComplexModel.coordinates].Of[I := Real.Index, bundle := Complex.bundle] \as ComplexBundle;
\definition complexZeroMetric: \exists ComplexBundle.Metrics[].Metric := ComplexBundle.Metrics[].existsMetric;
\definition realStandard: \root.RealLinear[r := one].Representation[s := one].Representation := \root.RealLinear[r := one].standard;
\definition complexStandard: \root.ComplexLinear[r := one].Representation[s := one].Representation := \root.ComplexLinear[r := one].standard;
