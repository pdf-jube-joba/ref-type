\definition nonnegative: Forms.Nonnegative form := \block {
  \fun (v: F x) \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where Logic.And[Countable.TailZero (weight parts) x n, Countable.prefix (weight parts) x n = R.one] }) \by total x \then
  \let tail: Countable.TailZero (weight parts) x n := (\bysub(N.Nat^, { n: N.Nat^ \where Logic.And[Countable.TailZero (weight parts) x n, Countable.prefix (weight parts) x n = R.one] }, n)).left \then
  \return Order.leReplaceRight R.zero (conjugation.realPart ((prefix n).dot v v)) (conjugation.realPart (form.dot v v))
    (sym!{{R.Real}} _ _ (congr!{K {R.Real}} conjugation.realPart _ _ (formula n tail v v))) (prefixNonnegative n v)
};
\definition definite: \forall (v: F x) -> form.dot v v = field.zero -> v = (bundle.space x).zero := \block {
  \fun (v: F x)(zero: _) \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where Logic.And[Countable.TailZero (weight parts) x n, Countable.prefix (weight parts) x n = R.one] }) \by total x \then
  \let law: Logic.And[Countable.TailZero (weight parts) x n, Countable.prefix (weight parts) x n = R.one] := \bysub(N.Nat^, { n: N.Nat^ \where Logic.And[Countable.TailZero (weight parts) x n, Countable.prefix (weight parts) x n = R.one] }, n) \then
  \let scaledZero: (bundle.space x).smul (conjugation.embed (Countable.prefix (weight parts) x n)) v = (bundle.space x).zero := prefixKernel n v (trans!{K} _ _ _ (sym!{K} _ _ (formula n law.left v v)) zero) \then
  \let scalarOne: conjugation.embed (Countable.prefix (weight parts) x n) = field.one := trans!{K} _ _ _ (congr!{{R.Real} K} conjugation.embed _ _ law.right) conjugation.embedOne \then
  \return trans!{{F x}} _ _ _ (sym!{{F x}} _ _ ((bundle.space x).scalarOne v))
    (trans!{{F x}} _ _ _ (congr!{K {F x}} (\fun (a: K) => (bundle.space x).smul a v) _ _ (sym!{K} _ _ scalarOne)) scaledZero)
};
\definition value: Geometry.Inner[V := F x, space := bundle.space x].Positive[form] := Geometry.Inner[V := F x, space := bundle.space x].Positive[form] { nonnegative := nonnegative, definite := definite };
