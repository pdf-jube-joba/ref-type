\import Forms.SumZero[h := prefix n, g := \parent.\parent.Term[k := n].form, left := prefixNonnegative n, right := \parent.\parent.Term[k := n].nonnegative, v := v, equal := equal] \as Split;
\definition value: (bundle.space x).smul (conjugation.embed (Countable.prefix (weight parts) x (N.Nat^::succ n))) v = (bundle.space x).zero :=
  trans!{{F x}} _ _ _
    (congr!{K {F x}} (\fun (a: K) => (bundle.space x).smul a v) _ _ (conjugation.embedAdd (Countable.prefix (weight parts) x n) (weight parts n x)))
    (trans!{{F x}} _ _ _ ((bundle.space x).scalarAdd (conjugation.embed (Countable.prefix (weight parts) x n)) (conjugation.embed (weight parts n x)) v)
      (trans!{{F x}} _ _ _ (congr!{{F x} {F x} {F x}} (bundle.space x).add _ _ _ _ (previous v Split.leftZero) (\parent.\parent.Term[k := n].kernel v Split.rightZero)) (Laws.zeroLeft (bundle.space x).zero)));
