\import Complements.For[X := X, F := F, bundle := bundle] \as Complement;
\import Bundles.Family[X := X, F := F] \as Family;
\import topology.Topology[Carrier := X] \as Base;
\import smooth_partitions.Countable[A := X] \as Countable;
\definition Entry: \Set := Complement.WeightedChart;
\definition weight[parts: N.Nat^ -> Entry][k: N.Nat^][x: X]: R.Real := (parts k).weight x;
\definition Normalized[parts: N.Nat^ -> Entry]: \Prop := \forall (x: X) -> \exists ( n: N.Nat^ \where Logic.And[
  Countable.TailZero (weight parts) x n, Countable.prefix (weight parts) x n = R.one] );
\module Using(parts: N.Nat^ -> Entry, total: Normalized parts);
