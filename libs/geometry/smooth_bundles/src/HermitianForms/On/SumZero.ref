\definition a: R.Real := scalar.realPart (h.dot v v);
\definition b: R.Real := scalar.realPart (g.dot v v);
\definition total: R.add a b = R.zero := trans!{{R.Real}} _ _ _ (sym!{{R.Real}} _ _ (plusReal h g v))
  (trans!{{R.Real}} _ _ _ (congr!{K {R.Real}} scalar.realPart _ _ equal) Geometry.reZero);
\definition leftUpper: Order.Le a (R.add a b) := Order.leReplaceLeft (R.add a R.zero) a _ (RealLaws.addZeroRight a)
  (Estimates.addLe a R.zero a b (Order.leRefl a) (right v));
\definition rightUpper: Order.Le b (R.add a b) := Order.leReplaceLeft (R.add R.zero b) b _ (RealLaws.addZeroLeft b)
  (Estimates.addLe R.zero b a b (left v) (Order.leRefl b));
\definition leftZero: h.dot v v = field.zero := trans!{K} _ _ _ (selfReal h v)
  (trans!{K} _ _ _ (congr!{{R.Real} K} scalar.embed _ _ (Order.leAntisym a R.zero (Order.leReplaceRight a (R.add a b) R.zero total leftUpper) (left v))) scalar.embedZero);
\definition rightZero: g.dot v v = field.zero := trans!{K} _ _ _ (selfReal g v)
  (trans!{K} _ _ _ (congr!{{R.Real} K} scalar.embed _ _ (Order.leAntisym b R.zero (Order.leReplaceRight b (R.add a b) R.zero total rightUpper) (right v))) scalar.embedZero);
