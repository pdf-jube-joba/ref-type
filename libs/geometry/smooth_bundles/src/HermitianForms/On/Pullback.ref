\definition value: Form := Inner.Form {
  dot := \fun (v, w: V) => form.dot (map.apply v) (map.apply w),
  symmetric := \fun (v, w: V) => form.symmetric (map.apply v) (map.apply w),
  zeroRight := \fun (v: V) => trans!{K} _ _ _ (congr!{W K} (form.dot (map.apply v)) _ _ map.preservesZero) (form.zeroRight (map.apply v)),
  addRight := \fun (u, v, w: V) => trans!{K} _ _ _ (congr!{W K} (form.dot (map.apply u)) _ _ (map.preservesAdd v w)) (form.addRight (map.apply u) (map.apply v) (map.apply w)),
  scaleRight := \fun (a: K)(v, w: V) => trans!{K} _ _ _ (congr!{W K} (form.dot (map.apply v)) _ _ (map.preservesScale a w)) (form.scaleRight a (map.apply v) (map.apply w)),
};
