\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as R;
\import complex.Complex[] \as C;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real (R.Algebra[].field)] \as Real;
\import bundle_operations.Operations[].Scalars[].RealCoordinates[n := r] \as Coordinates;
\import Fin.Sum[m := r, n := r] \as Indices;
\import Indices.Tuples[A := R.Real] \as Tuples;
\definition rank: N.Nat^ := Coordinates.dimension;
\definition Vector: \Set := Fin.Fin r -> C.Complex;
\definition RealVector: \Set := Fin.Fin rank -> R.Real;
\definition encode: Vector -> RealVector := Coordinates.frame.forward.apply;
\definition decode: RealVector -> Vector := Coordinates.frame.backward.apply;
\import bundle_operations.Operations[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Operations;
\import Operations.RealScalars[V := Vector, space := linear_algebra.Commutative[K := C.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing C.Complex (C.Algebra[].field)].Coordinates[I := Fin.Fin r].space] \as Restricted;
\import Real.Isomorphism[V := Vector, W := RealVector, source := Restricted.realSpace, target := Real.Coordinates[I := Fin.Fin rank].space] \as Iso;
\definition decodeEncode: \forall (v: Vector) -> decode (encode v) = v := (Iso.laws Coordinates.frame).leftInverse;
\definition encodeDecode: \forall (v: RealVector) -> encode (decode v) = v := (Iso.laws Coordinates.frame).rightInverse;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\module On(U: Open.OpenSet);
