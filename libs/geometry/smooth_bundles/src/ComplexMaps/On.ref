\module Families(F, G: M.Point -> \Set,
  sourceSpace: \forall (x: M.Point) -> Spaces.VectorSpace (F x), targetSpace: \forall (x: M.Point) -> Spaces.VectorSpace (G x),
  I, J: \Set,
  source: \root.Complex[n := n, r := r].On[M := M].Family[F := F, space := sourceSpace].Bundle[I],
  target: \root.Complex[n := n, r := s].On[M := M].Family[F := G, space := targetSpace].Bundle[J]);
