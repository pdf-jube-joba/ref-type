\definition fiber[x: M.Point]: Spaces.Linear[V := F x, W := H x, source := sourceSpace x, target := rangeSpace x].Map :=
  Spaces.Linear[V := G x, W := H x, source := targetSpace x, target := rangeSpace x].Composition[U := F x, domain := sourceSpace x].compose (g.fiber x) (f.fiber x);
\definition data: Result.Data := Result.Data { fiber := fiber };
\definition smooth: Result.Smooth data := \block {
  \takefrom a: \Cast[Total.Map] ({ a: Total.Map \where Total.apply a = total f }) \by regular f \then
  \takefrom b: \Cast[Next.TotalMap] ({ b: Next.TotalMap \where Next.totalApply b = Next.total g }) \by Next.regular g \then
  \let left: Total.apply a = total f := \bysub(Total.Map, { a: Total.Map \where Total.apply a = total f }, a) \then
  \let right: Next.totalApply b = Next.total g := \bysub(Next.TotalMap, { b: Next.TotalMap \where Next.totalApply b = Next.total g }, b) \then
  \return Logic.existsIntro[Result.TotalMap, { h: Result.TotalMap \where Result.totalApply h = Result.total data }] (Compose.compose a b)
    (\axiom:funext(Result.totalApply (Compose.compose a b), Result.total data, \fun (p: Source.Point) =>
      trans!{{RangePoint}} _ _ _
        (congr!{{Target.Point} {RangePoint}} (Next.totalApply b) _ _ (congr!{{Source.Point -> Target.Point} {Target.Point}} (\fun (h: Source.Point -> Target.Point) => h p) _ _ left))
        (congr!{{Target.Point -> RangePoint} {RangePoint}} (\fun (h: Target.Point -> RangePoint) => h (total f p)) _ _ right)))
};
\definition map: Result.Map := \into[Result.Data](data, Result.Map) \by { smooth };
\definition formula: \forall (x: M.Point)(v: F x) -> (map.fiber x).apply v = (g.fiber x).apply ((f.fiber x).apply v) :=
  \fun (x: M.Point)(v: F x) => \refl((g.fiber x).apply ((f.fiber x).apply v));
