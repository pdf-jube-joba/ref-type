\definition data: Right.Data := Right.Data { value := \fun (x: M.Point) => (a.fiber x).apply (s.value x) };
\definition value: Right.Section := \into[Right.Data](data, Right.Section) \by { \block {
  \takefrom f: \Cast[Total.Map] ({ f: Total.Map \where Total.apply f = total a }) \by regular a \then
  \takefrom g: \Cast[Left.SmoothMap] ({ g: Left.SmoothMap \where Left.apply g = Left.total s }) \by Left.regular s \then
  \let equal: Right.apply (Composition.compose g f) = Right.total (data) := \axiom:funext(Right.apply (Composition.compose g f), Right.total data, \fun (x: M.Point) =>
    trans!{{Target.Point}} _ _ _
      (congr!{{Source.Point} {Target.Point}} (Total.apply f) _ _ (congr!{{M.Point -> Source.Point} {Source.Point}} (\fun (h: M.Point -> Source.Point) => h x) _ _ (\bysub(Left.SmoothMap, { g: Left.SmoothMap \where Left.apply g = Left.total s }, g))))
      (congr!{{Source.Point -> Target.Point} {Target.Point}} (\fun (h: Source.Point -> Target.Point) => h (Left.total s x)) _ _ (\bysub(Total.Map, { f: Total.Map \where Total.apply f = total a }, f)))) \then
  \return Logic.existsIntro[Right.SmoothMap, { h: Right.SmoothMap \where Right.apply h = Right.total (data) }] (Composition.compose g f) equal
} };
