\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import \root.ComplexCalculus[n := d].On[U := Open.whole] \as Calculus;
\definition Regular[U: Open.OpenSet][f: Open.Carrier U -> GL.Carrier]: \Prop := \root.ComplexMatrix[d := d, p := r, q := r].On[U := U, A := \fun (x: Open.Carrier U) => (f x).forward].Regular;
\definition product: \forall (U: Open.OpenSet)(f, g: Open.Carrier U -> GL.Carrier) -> Regular U f -> Regular U g -> Regular U (\fun (x: Open.Carrier U) => GL.multiply (f x) (g x)) :=
  \fun (U: Open.OpenSet)(f, g: Open.Carrier U -> GL.Carrier)(fl: Regular U f)(gl: Regular U g)(v: GL.Vector) =>
    \root.ComplexMatrix[d := d, p := r, q := r].On[U := U, A := \fun (x: Open.Carrier U) => (f x).forward].action fl
      (\fun (x: Open.Carrier U) => (g x).forward.apply v) (gl v);
\module Inverse(U: Open.OpenSet, f: Open.Carrier U -> GL.Carrier, regular: Regular U f);
\definition inverse: \forall (U: Open.OpenSet)(f: Open.Carrier U -> GL.Carrier) -> Regular U f -> Regular U (\fun (x: Open.Carrier U) => GL.inverse (f x)) :=
  \fun (U: Open.OpenSet)(f: Open.Carrier U -> GL.Carrier)(regular: Regular U f) => Inverse[U := U, f := f, regular := regular].regular;
