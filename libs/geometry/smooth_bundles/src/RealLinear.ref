\import real.Analysis[] \as R;
\import \root.GeneralLinear[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar, n := r] \as GL;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\module Smooth(d: N.Nat^);
\module Representation(s: N.Nat^);

\import \root.RealLinear[r := r].Representation[s := r] \as Standard;
\definition standard: Standard.Representation := \into[Standard.Data](Standard.Data { apply := \fun (g: GL.Carrier) => g }, Standard.Representation) \by {
  Standard.Laws[Standard.Data { apply := \fun (g: GL.Carrier) => g }] {
    identity := \refl(GL.identity), product := \fun (u, v: GL.Carrier) => \refl(GL.multiply u v),
    smooth := \fun (d: N.Nat^)(U: calculus.Real[].Multivariable[n := d].Open[].OpenSet)(f: calculus.Real[].Multivariable[n := d].Open[].Carrier U -> GL.Carrier)(regular: \root.RealLinear[r := r].Smooth[d := d].Regular U f) => regular,
  }
};
