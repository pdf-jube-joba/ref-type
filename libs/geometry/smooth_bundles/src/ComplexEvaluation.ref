\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import complex.Complex[] \as C;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing C.Complex (C.Algebra[].field)] \as Spaces;
\import Spaces.Coordinates[I := Fin.Fin r] \as Vectors;
\import Spaces.Multilinear[V := Vectors.Vector, space := Vectors.space] \as Multilinear;
\import Multilinear.Alternating[] \as Alternating;
\import Spaces.FiniteCoordinates[n := r] \as Basis;
\import Fin.Tuples[A := Vectors.Vector] \as Arguments;
\import Fin.Tuples[A := Fin.Fin r] \as Indices;
\import Indices.Mapping[B := Vectors.Vector] \as Mapping;
\import Fin.Empty[A := Fin.Fin r] \as Empty;
\import Alternating.DegreeZero[] \as Scalars;
\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\module On(U: Open.OpenSet);
