\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as R;
\import complex.Complex[] \as C;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing C.Complex (C.Algebra[].field)] \as Complex;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real (R.Algebra[].field)] \as Real;
\import bundle_operations.Operations[].Scalars[].RealCoordinates[n := p] \as SourceCoordinates;
\import bundle_operations.Operations[].Scalars[].RealCoordinates[n := q] \as TargetCoordinates;
\import \root.ComplexCoordinates[n := d, r := p] \as Source;
\import \root.ComplexCoordinates[n := d, r := q] \as Target;
\import Complex.Linear[V := Source.Vector, W := Target.Vector, source := Complex.Coordinates[I := Fin.Fin p].space, target := Complex.Coordinates[I := Fin.Fin q].space] \as Matrices;
\import bundle_operations.Operations[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Operations;
\import Operations.RealScalars[V := Source.Vector, space := Complex.Coordinates[I := Fin.Fin p].space] \as SourceSpace;
\import Operations.RealScalars[V := Target.Vector, space := Complex.Coordinates[I := Fin.Fin q].space] \as TargetSpace;
\import SourceSpace.Maps[W := Target.Vector, target := Complex.Coordinates[I := Fin.Fin q].space] \as Restrict;
\import Real.Linear[V := Source.Vector, W := Target.Vector, source := SourceSpace.realSpace, target := TargetSpace.realSpace].Composition[U := Source.RealVector, domain := Real.Coordinates[I := Fin.Fin Source.rank].space] \as Before;
\import Real.Linear[V := Target.Vector, W := Target.RealVector, source := TargetSpace.realSpace, target := Real.Coordinates[I := Fin.Fin Target.rank].space].Composition[U := Source.RealVector, domain := Real.Coordinates[I := Fin.Fin Source.rank].space] \as After;
\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\module On(U: Open.OpenSet, A: Open.Carrier U -> Matrices.Map);
