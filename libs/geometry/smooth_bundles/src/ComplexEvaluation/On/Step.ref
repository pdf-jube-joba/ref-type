\import Multilinear.Contraction[k := k] \as Contract;
\import Contract.Expansion[I := Fin.Fin r, b := Basis.basis] \as Expansion;
\definition contracted[i: Fin.Fin r]: Family k := \fun (x: Open.Carrier U) => Contract.apply (omega x) (Basis.vectors i);
\definition coefficients: CoefficientSmooth (N.Nat^::succ k) omega -> \forall (i: Fin.Fin r) -> CoefficientSmooth k (contracted i) :=
  \fun (regular: CoefficientSmooth (N.Nat^::succ k) omega)(i: Fin.Fin r)(indices: Fin.Fin k -> Fin.Fin r) =>
    equalSmooth (\fun (x: Open.Carrier U) => omega x (\fun (j: Fin.Fin (N.Nat^::succ k)) => Basis.vectors (Indices.extend k i indices j)))
      (\fun (x: Open.Carrier U) => contracted i x (\fun (j: Fin.Fin k) => Basis.vectors (indices j)))
      (\fun (x: Open.Carrier U) => congr!{{Multilinear.Arguments (N.Nat^::succ k)} {C.Complex}} (omega x) _ _ (Mapping.extendMap k Basis.vectors i indices))
      (regular (Indices.extend k i indices));
\definition law: Law k -> \forall (arguments: VariableArguments (N.Nat^::succ k)) ->
  CoefficientSmooth (N.Nat^::succ k) omega -> ArgumentSmooth (N.Nat^::succ k) arguments ->
  Calculus.Smooth (\fun (x: Open.Carrier U) => omega x (arguments x)) := \block {
  \fun (previous: Law k)(arguments: VariableArguments (N.Nat^::succ k))(regular: CoefficientSmooth (N.Nat^::succ k) omega)
    (argumentRegular: ArgumentSmooth (N.Nat^::succ k) arguments) \then
  \let head: Open.Carrier U -> Vectors.Vector := \fun (x: Open.Carrier U) => arguments x (Fin.zero k) \then
  \let tail: VariableArguments k := \fun (x: Open.Carrier U)(j: Fin.Fin k) => arguments x (Fin.succ k j) \then
  \let term: Fin.Fin r -> Calculus.Function := \fun (i: Fin.Fin r)(x: Open.Carrier U) => Spaces.mul (head x i) (contracted i x (tail x)) \then
  \return equalSmooth (Sums.sum (Fin.elements r) term) (\fun (x: Open.Carrier U) => omega x (arguments x))
    (\fun (x: Open.Carrier U) => trans!{{C.Complex}} _ _ _ (sym!{{C.Complex}} _ _ (Expansion.law (omega x) (head x) (tail x)))
      (congr!{{Multilinear.Arguments (N.Nat^::succ k)} {C.Complex}} (omega x) (Arguments.extend k (head x) (tail x)) (arguments x) (Arguments.recover k (arguments x))))
    (Sums.smooth (Fin.elements r) term (\fun (i: Fin.Fin r) => Calculus.times
      (\fun (x: Open.Carrier U) => head x i) (\fun (x: Open.Carrier U) => contracted i x (tail x))
      (argumentRegular (Fin.zero k) i) (previous (contracted i) tail (coefficients regular i)
        (\fun (j: Fin.Fin k) => argumentRegular (Fin.succ k j)))))
};
