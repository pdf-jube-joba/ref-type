\import Original.On[M := M].Of[i := i] \as Normal;
\import \root.Real[n := n, r := k].On[M := M].Family[F := Normal.Fiber, space := Normal.fiberSpace] \as Family;
\definition bundle: Family.Bundle[Normal.Local] := Family.Bundle[Normal.Local] { atlas := Normal.framesData, regular := Normal.changes };
\import Family.Of[I := Normal.Local, bundle := bundle] \as Smooth;
\import manifolds.Dimension[n := Original.ambientDimension].Smooth[] \as TotalModels;
\definition manifold: TotalModels.Manifold := Smooth.manifold;
\definition topologyEquality: Smooth.topology = Normal.topology := \refl(Smooth.topology);
\definition projectionPreserved: \forall (p: Family.Point) -> Family.projection p = Normal.projection p :=
  \fun (p: Family.Point) => \refl(p.base);
\module Splitting;
\module Stabilization;
