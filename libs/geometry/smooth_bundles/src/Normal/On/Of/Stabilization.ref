\import normal_bundles.Stabilization[n := n, k := k] \as Dimensions;
\import Dimensions.On[M := M].Of[i := i] \as Stabilization;
\import normal_bundles.Dimension[n := n, k := std.Data[].Nat[].Nat^::succ k] \as Next;
\import manifolds.Immersion[n := n, m := Dimensions.newDimension].Between[M := M, N := Next.ambient] \as Immersions;
\definition immersion: Immersions.Immersion := Stabilization.immersion;

\import Original.On[M := M].Of[i := i] \as Old;
\import Next.On[M := M].Of[i := immersion] \as New;
\import tangent_bundles.ScalarProduct[n := Dimensions.oldDimension].On[M := Old.manifold] \as ScalarSum;
\import ScalarSum.Covered[I := Old.Local, chart := Old.totalChart, covers := Old.chartCover] \as Target;
\definition sourceDimension: std.Data[].Nat[].Nat^ := Dimensions.newDimension;
\definition targetDimension: std.Data[].Nat[].Nat^ := Dimensions.sumDimension;
\import manifolds.Dimension[n := sourceDimension].Smooth[] \as SourceModels;
\import manifolds.Dimension[n := targetDimension].Smooth[] \as TargetModels;
\definition sourceManifold: SourceModels.Manifold := New.manifold;
\definition targetManifold: TargetModels.Manifold := Target.manifold;
\definition diffeomorphism: manifolds.Diffeomorphism[n := sourceDimension, m := targetDimension].Between[M := sourceManifold, N := targetManifold].Diffeomorphism := Stabilization.diffeomorphism;
\definition basePreserved: \forall (p: New.Point) -> (manifolds.SmoothMap[n := sourceDimension, m := targetDimension].Between[M := sourceManifold, N := targetManifold].apply diffeomorphism.forward p).base.base = p.base := \fun (p: New.Point) => \refl(p.base);
\import manifolds.Tangent[n := n].On[M := M] \as Tangent;
\definition splittingCompatibility: \forall (x: M.Point)(t: Tangent.Vector x)(w: Old.Fiber x)(a: real.Analysis[].Real) ->
  New.Splitting[].forward (New.Splitting[].include x t (Stabilization.At[x := x].newNormal w a)) =
    Stabilization.stabilizeProduct (Old.Splitting[].forward (Old.Splitting[].include x t w)) a := Stabilization.splittingCompatibility;
