\import normal_bundles.Stabilization[n := n, k := k] \as Dimensions;
\import Dimensions.On[M := M].Of[i := i] \as Stabilization;
\import normal_bundles.Dimension[n := n, k := std.Data[].Nat[].Nat^::succ k] \as Next;
\import manifolds.Immersion[n := n, m := Dimensions.newDimension].Between[M := M, N := Next.ambient] \as Immersions;
\definition immersion: Immersions.Immersion := Stabilization.immersion;
