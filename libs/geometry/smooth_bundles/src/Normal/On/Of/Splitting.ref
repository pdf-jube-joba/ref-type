\import Normal.Splitting[] \as Splitting;
\definition Source: \Set := Splitting.Point;
\definition Target: \Set := Splitting.ProductPoint;
\definition dimension: std.Data[].Nat[].Nat^ := Splitting.dimension;
\definition diffeomorphism: manifolds.Diffeomorphism[n := dimension, m := dimension].Between[M := Splitting.manifold, N := Splitting.productManifold].Diffeomorphism := Splitting.diffeomorphism;
\definition forward: Source -> Target := Splitting.forward;
\definition backward: Target -> Source := Splitting.inverse;
\definition basePreserved: \forall (p: Source) -> (forward p).base = p.base := \fun (p: Source) => \refl(p.base);
