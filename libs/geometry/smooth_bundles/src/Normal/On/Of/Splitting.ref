\import Normal.Splitting[] \as Splitting;
\definition Source: \Set := Splitting.Point;
\definition Target: \Set := Splitting.ProductPoint;
\definition dimension: std.Data[].Nat[].Nat^ := Splitting.dimension;
\definition diffeomorphism: manifolds.Diffeomorphism[n := dimension, m := dimension].Between[M := Splitting.manifold, N := Splitting.productManifold].Diffeomorphism := Splitting.diffeomorphism;
\definition forward: Source -> Target := Splitting.forward;
\definition backward: Target -> Source := Splitting.inverse;
\definition basePreserved: \forall (p: Source) -> (forward p).base = p.base := \fun (p: Source) => \refl(p.base);

\import manifolds.Tangent[n := n].On[M := M] \as Tangent;
\import tangent_bundles.FrameBundle[n := n, r := n].Over[M := M].Family[F := Tangent.Vector, space := \fun (x: M.Point) => Tangent.space x].Using[I := Normal.Local, data := Splitting.tangentData].Sum[s := k, G := Normal.Fiber, otherSpace := Normal.fiberSpace, otherFrame := Splitting.normalFrame] \as Sum;
\import \root.Real[n := n, r := n].On[M := M].Family[F := Tangent.Vector, space := \fun (x: M.Point) => Tangent.space x] \as TangentFamily;
\definition tangent: TangentFamily.Bundle[Normal.Local] := TangentFamily.Bundle[Normal.Local] { atlas := Splitting.tangentData, regular := Splitting.tangentChanges };
\import TangentFamily.Of[I := Normal.Local, bundle := tangent].Paired[s := k, G := Normal.Fiber, otherSpace := Normal.fiberSpace, otherFrame := Splitting.normalFrame].Using[regular := Normal.changes] \as Pair;
\import \root.Real[n := n, r := Sum.rank].On[M := M].Family[F := Sum.Fiber, space := Sum.fiberSpace] \as SumFamily;
\definition directSum: SumFamily.Bundle[Normal.Local] := Pair.directSum;
\definition sumTopology: SumFamily.Of[I := Normal.Local, bundle := directSum].topology = Splitting.manifold.space := \refl(Splitting.manifold.space);
