\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import calculus.MatrixFamily[d := d, p := r, q := r] \as Matrices;
\definition Regular[U: Open.OpenSet][f: Open.Carrier U -> GL.Carrier]: \Prop := Matrices.Regular U (\fun (x: Open.Carrier U) => (f x).forward);
\definition product: \forall (U: Open.OpenSet)(f, g: Open.Carrier U -> GL.Carrier) -> Regular U f -> Regular U g -> Regular U (\fun (x: Open.Carrier U) => GL.multiply (f x) (g x)) :=
  \fun (U: Open.OpenSet)(f, g: Open.Carrier U -> GL.Carrier)(fl: Regular U f)(gl: Regular U g)(i, j: Fin.Fin r) =>
    Matrices.action U (\fun (x: Open.Carrier U) => (f x).forward) fl (\fun (x: Open.Carrier U) => (g x).forward.apply (R.FiniteSums[].Linear[].basis r j)) (\fun (a: Fin.Fin r) => gl a j) i;
\definition inverse: \forall (U: Open.OpenSet)(f: Open.Carrier U -> GL.Carrier) -> Regular U f -> Regular U (\fun (x: Open.Carrier U) => GL.inverse (f x)) :=
  \fun (U: Open.OpenSet)(f: Open.Carrier U -> GL.Carrier)(fl: Regular U f) =>
    calculus.InverseFamily[d := d, r := r].regular U (\fun (x: Open.Carrier U) => (f x).forward) (\fun (x: Open.Carrier U) => (f x).backward)
      (\fun (x: Open.Carrier U) => (f x).leftInverse) (\fun (x: Open.Carrier U) => (f x).rightInverse) fl;
