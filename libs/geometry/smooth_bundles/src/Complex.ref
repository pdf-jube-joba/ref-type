\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as R;
\import complex.Complex[] \as C;
\import linear_algebra.Hermitian[].Complex[] \as Hermitian;
\import C.Algebra[] \as Algebra;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing C.Complex Algebra.field] \as Spaces;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real (R.Algebra[].field)] \as RealSpaces;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Algebra.field, conjugation := Hermitian.scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Operations;
\import bundle_operations.Operations[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as RealOperations;
\import bundle_operations.Operations[].Scalars[].RealCoordinates[n := r] \as Coordinates;
\definition realRank: N.Nat^ := Coordinates.dimension;
\definition Vector: \Set := Fin.Fin r -> C.Complex;
\definition coordinates: Spaces.VectorSpace Vector := Spaces.Coordinates[I := Fin.Fin r].space;
\import manifolds.Dimension[n := n].Smooth[] \as Base;
\module On(M: Base.Manifold);
