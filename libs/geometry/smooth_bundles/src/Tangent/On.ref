\import tangent_bundles.Dimension[n := n].On[M := M] \as Original;
\import manifolds.Tangent[n := n].On[M := M] \as Tangent;
\import \root.Real[n := n, r := n].On[M := M].Family[F := Tangent.Vector, space := \fun (x: M.Point) => Tangent.space x] \as Family;
\import Original.Frames[] \as Frames;
\definition bundle: Family.Bundle[Original.Chart] := Family.Bundle[Original.Chart] {
  atlas := Frames.framesData, regular := Frames.changes,
};
\import Family.Of[I := Original.Chart, bundle := bundle] \as Smooth;
\import manifolds.Dimension[n := calculus.Blocks[n := n, m := n].dimension].Smooth[] \as TotalModels;
\definition manifold: TotalModels.Manifold := Smooth.manifold;
\definition comparison: manifolds.Diffeomorphism[n := calculus.Blocks[n := n, m := n].dimension, m := calculus.Blocks[n := n, m := n].dimension].Between[M := Original.manifold, N := Smooth.manifold].Diffeomorphism := Original.FrameComparison[].diffeomorphism;
\definition basePreserved: \forall (p: Original.Point) -> Family.projection (Original.FrameComparison[].to p) = Original.projection p :=
  \fun (p: Original.Point) => \refl(p.base);
