\import Bundles.Family[X := Carrier, F := (\fun (x: Carrier) => G x)] \as RestrictedTarget;
\import Bundles.Morphisms[X := Carrier, Y := Carrier, F := (\fun (x: Carrier) => F x), G := (\fun (x: Carrier) => G x), source := sourceBundle, target := targetBundle, f := (\fun (x: Carrier) => x)] \as Maps;
\definition value[p: TotalPoint]: Target.Point := Target.include p.base ((map.fiber (base p)).apply p.vector);
\definition continuous: topology.Continuity[A := TotalPoint, B := Target.Point].Continuous localTopology target.totalSpace value :=
  topology.Composition[A := TotalPoint, B := RestrictedTarget.Point, C := Target.Point].composeContinuous localTopology targetBundle.totalSpace target.totalSpace
    (\fun (p: TotalPoint) => Maps.total map (point p)) TargetPullback.map
    (topology.Composition[A := TotalPoint, B := RestrictedSource.Point, C := RestrictedTarget.Point].composeContinuous localTopology sourceBundle.totalSpace targetBundle.totalSpace point (Maps.total map) pointContinuous (Maps.continuous map)) TargetPullback.mapContinuous;
