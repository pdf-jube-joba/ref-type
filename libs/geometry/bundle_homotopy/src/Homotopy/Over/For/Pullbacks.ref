\import topology.Continuity[A := X, B := Y] \as Continuity;
\definition Map: \Set := \Cast[X -> Y] ({ f: X -> Y \where Continuity.Continuous source bundle.baseSpace f });
\definition regular[f: Map]: Continuity.Continuous source bundle.baseSpace f := \bysub(X -> Y, Map, f);
\definition Fiber[f: Map][x: X]: \Set := F (f x);
\definition bundleAt[f: Map]: Bundles.Family[X := X, F := Fiber f].Bundle := Original.Of[bundle := bundle].Pullback[Y := X, source := source, f := f].pulled (regular f);
\definition Isomorphism[f: Map][g: Map]: \Set := Bundles.Isomorphisms[X := X, F := Fiber f, G := Fiber g, source := bundleAt f, target := bundleAt g].Isomorphism;
\import algebraic_topology.Homotopy[A := X, B := Y] \as H;
\module Along(f, g: Map, h: H.Homotopy[source, bundle.baseSpace, f, g]);
\definition homotopic: \forall (f, g: Map) -> H.Homotopic source bundle.baseSpace f g -> \exists Isomorphism f g := \block {
  \fun (f, g: Map)(related: _) \then
  \takefrom h: H.Homotopy[source, bundle.baseSpace, f, g] \by related \then
  \return Along[f := f, g := g, h := h].isomorphismExists
};

\definition Fixed[A: \Pow X][f: Map][g: Map][iso: Isomorphism f g]: \Prop :=
  \forall (x: X) -> \In[X] A x -> \forall (v: F (f x)) -> Original.include (g x) ((iso.forward.fiber x).apply v) = Original.include (f x) v;
\structure RelativeIsomorphism[A: \Pow X, f: Map, g: Map]: \Set := { value: Isomorphism f g, fixed: Fixed A f g value };
\module Relative(f, g: Map, A: \Pow X, h: H.RelativeHomotopy[source, bundle.baseSpace, A, f, g],
  embedding: Complements.For[X := Y, F := F, bundle := bundle].Embedding);
\definition relativeHomotopic: topology.Topology[Carrier := Y].IsCompact bundle.baseSpace -> topology.Topology[Carrier := Y].IsT2 bundle.baseSpace ->
  \forall (f, g: Map)(A: \Pow X) -> H.RelativeHomotopic source bundle.baseSpace A f g -> \exists RelativeIsomorphism[A, f, g] := \block {
  \fun (compactTarget: _)(hausdorffTarget: _)(f, g: Map)(A: \Pow X)(related: _) \then
  \takefrom h: H.RelativeHomotopy[source, bundle.baseSpace, A, f, g] \by related \then
  \takefrom embedding: Complements.For[X := Y, F := F, bundle := bundle].Embedding \by Complements.For[X := Y, F := F, bundle := bundle].embeddingExists compactTarget hausdorffTarget \then
  \let result: \exists RelativeIsomorphism[A, f, g] := Relative[f := f, g := g, A := A, h := h, embedding := embedding].isomorphismExists \then
  \return result
};
