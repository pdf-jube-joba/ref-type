\definition inside: \forall (y: Y) -> \In[Y] chart.domain (constant y) := \fun (y: Y) => \bysub(Charts.Chart, { c: Charts.Chart \where \In[Y] c.domain point }, chart);
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ChartPullback[X := Y, F := F, bundle := bundle, chart := chart,
  Y := Y, source := bundle.baseSpace, f := constant, continuous := Pullbacks.regular constant, inside := inside] \as Constant;
\import Operations.IsomorphismComposition[X := Y, F := F, G := Pullbacks.Fiber identity, H := Pullbacks.Fiber constant, source := bundle, middle := Pullbacks.bundleAt identity, target := Pullbacks.bundleAt constant] \as First;
\import Operations.IsomorphismComposition[X := Y, F := F, G := Pullbacks.Fiber constant, H := (\fun (y: Y) => Vector chart.dimension), source := bundle, middle := Pullbacks.bundleAt constant,
  target := Bundles.Trivial[X := Y, n := chart.dimension, baseSpace := bundle.baseSpace].bundle] \as Second;
\definition firstExists: \exists Bundles.Isomorphisms[X := Y, F := F, G := Pullbacks.Fiber identity, source := bundle, target := Pullbacks.bundleAt identity].Isomorphism :=
  \exact(Identity.isomorphism, Bundles.Isomorphisms[X := Y, F := F, G := Pullbacks.Fiber identity, source := bundle, target := Pullbacks.bundleAt identity].Isomorphism);
\definition lastExists: \exists Bundles.Isomorphisms[X := Y, F := Pullbacks.Fiber constant, G := (\fun (y: Y) => Vector chart.dimension), source := Pullbacks.bundleAt constant,
  target := Bundles.Trivial[X := Y, n := chart.dimension, baseSpace := bundle.baseSpace].bundle].Isomorphism :=
  \exact(Constant.isomorphism, Bundles.Isomorphisms[X := Y, F := Pullbacks.Fiber constant, G := (\fun (y: Y) => Vector chart.dimension), source := Pullbacks.bundleAt constant, target := Bundles.Trivial[X := Y, n := chart.dimension, baseSpace := bundle.baseSpace].bundle].Isomorphism);
\definition comparisonExists: \exists Bundles.Isomorphisms[X := Y, F := F, G := (\fun (y: Y) => Vector chart.dimension), source := bundle,
  target := Bundles.Trivial[X := Y, n := chart.dimension, baseSpace := bundle.baseSpace].bundle].Isomorphism :=
  Second.exists (First.exists firstExists (Pullbacks.Along[f := identity, g := constant, h := contraction].isomorphismExists)) lastExists;
\definition exists: \exists Result := \block {
  \takefrom iso: Bundles.Isomorphisms[X := Y, F := F, G := (\fun (y: Y) => Vector chart.dimension), source := bundle,
    target := Bundles.Trivial[X := Y, n := chart.dimension, baseSpace := bundle.baseSpace].bundle].Isomorphism \by comparisonExists \then
  \return \exact(Result { dimension := chart.dimension, isomorphism := iso }, Result)
};
