\definition function[x: X]: Y := h (Cylinder.at t x);
\definition continuous: Continuity.Continuous source bundle.baseSpace function := topology.Composition[A := X, B := Cylinder.Carrier, C := Y].composeContinuous
  source (Cylinder.topology source) bundle.baseSpace (Cylinder.at t) h (Cylinder.atContinuous source t) regularH;
\definition at: Map := \into[X -> Y](function, Map) \by { continuous };
\import Original.Of[bundle := bundle].PullbackComposition[Y := Cylinder.Carrier, Z := X, first := Cylinder.topology source, second := source, f := h, g := Cylinder.at t].Of[fRegular := regularH, gRegular := Cylinder.atContinuous source t] \as Composition;
\definition comparison: Bundles.Isomorphisms[X := X, F := Fiber at, G := (\fun (x: X) => Model.Endpoint[t := t].Fiber x), source := bundleAt at, target := Model.Endpoint[t := t].bundle].Isomorphism := Composition.isomorphism;
