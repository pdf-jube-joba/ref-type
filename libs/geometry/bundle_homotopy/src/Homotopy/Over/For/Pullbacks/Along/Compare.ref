\import Model.Endpoint[t := I.start] \as NativeStart;
\import Model.Endpoint[t := I.end] \as NativeFinish;
\import Operations.IsomorphismComposition[X := X, F := Fiber Start.at, G := NativeStart.Fiber, H := NativeFinish.Fiber,
  source := bundleAt Start.at, middle := NativeStart.bundle, target := NativeFinish.bundle] \as First;
\import Operations.IsomorphismComposition[X := X, F := Fiber Start.at, G := NativeFinish.Fiber, H := Fiber Finish.at,
  source := bundleAt Start.at, middle := NativeFinish.bundle, target := bundleAt Finish.at] \as Second;
\import Bundles.Isomorphisms[X := X, F := Fiber Finish.at, G := NativeFinish.Fiber, source := bundleAt Finish.at, target := NativeFinish.bundle] \as Reverse;
\definition value: Isomorphism Start.at Finish.at := Second.compose (First.compose Start.comparison iso) (Reverse.inverse Finish.comparison);
