\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := X] \as Cylinder;
\definition regularH: topology.Continuity[A := Cylinder.Carrier, B := Y].Continuous (Cylinder.topology source) bundle.baseSpace h := (H.laws source bundle.baseSpace f g h).continuous;
\import Original.Of[bundle := bundle].Pullback[Y := Cylinder.Carrier, source := Cylinder.topology source, f := h] \as Pulled;
\definition pulledBundle: Bundles.Family[X := Cylinder.Carrier, F := (\fun (p: Cylinder.Carrier) => F (h p))].Bundle := Pulled.pulled regularH;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Cylinder[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff,
  F := (\fun (p: Cylinder.Carrier) => F (h p)), bundle := pulledBundle, sameBase := \refl(Cylinder.topology source)] \as Model;
\module Endpoint(t: I.Carrier);
\import Endpoint[t := I.start] \as Start;
\import Endpoint[t := I.end] \as Finish;
\module Compare(iso: Model.Isomorphism);
\definition rawExists: \exists Isomorphism Start.at Finish.at := \block {
  \takefrom iso: Model.Isomorphism \by Model.endpointIsomorphismExists \then
  \return \exact(Compare[iso := iso].value, Isomorphism Start.at Finish.at)
};
\definition startEquality: Start.at = f := \axiom:funext(Start.at, f, (H.laws source bundle.baseSpace f g h).start);
\definition endEquality: Finish.at = g := \axiom:funext(Finish.at, g, (H.laws source bundle.baseSpace f g h).end);
\definition isomorphismExists: \exists Isomorphism f g := \block {
  \let first: \exists Isomorphism f Finish.at := \idelim Start.at = f \with u: Map => \exists Isomorphism u Finish.at \by {
    base: rawExists, equality: startEquality
  } \then
  \return \idelim Finish.at = g \with v: Map => \exists Isomorphism f v \by { base: first, equality: endEquality }
};
