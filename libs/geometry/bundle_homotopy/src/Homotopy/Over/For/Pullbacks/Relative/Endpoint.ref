\definition function[x: X]: Y := h (Cylinder.at t x);
\definition continuous: Continuity.Continuous source bundle.baseSpace function := topology.Composition[A := X, B := Cylinder.Carrier, C := Y].composeContinuous
  source (Cylinder.topology source) bundle.baseSpace (Cylinder.at t) h (Cylinder.atContinuous source t) regularH;
\definition at: Map := \into[X -> Y](function, Map) \by { continuous };
\import Presented.Pullback[Y := X, source := source, f := at, continuous := continuous] \as Pullback;
\import Motion.Slice[t := t] \as Target;
\definition comparison: Bundles.Isomorphisms[X := X, F := Fiber at, G := Target.Fiber, source := bundleAt at, target := Target.bundle].Isomorphism := Pullback.isomorphism;
\definition forwardFormula: \forall (x: X)(v: Fiber at x) -> \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projections[n := n].valueOf ((comparison.forward.fiber x).apply v) = (embedding.map.fiber (at x)).apply v := Pullback.forwardFormula;
\definition backwardFormula: \forall (x: X)(v: Target.Fiber x) -> (embedding.map.fiber (at x)).apply ((comparison.backward.fiber x).apply v) =
  \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projections[n := n].valueOf v := Pullback.backwardFormula;
