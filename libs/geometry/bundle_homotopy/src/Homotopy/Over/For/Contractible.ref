\import \parent.Pullbacks[X := Y, source := bundle.baseSpace, compact := compact, hausdorff := hausdorff] \as Pullbacks;
\definition identity: Pullbacks.Map := \into[Y -> Y]((\fun (y: Y) => y), Pullbacks.Map) \by { topology.Maps[A := Y, B := Y].Identity[].continuous bundle.baseSpace };
\definition constant: Pullbacks.Map := \into[Y -> Y]((\fun (y: Y) => point), Pullbacks.Map) \by { topology.Maps[A := Y, B := Y].constantContinuous bundle.baseSpace bundle.baseSpace point };
\import Original.With[data := bundle] \as Charts;
\import Original.Of[bundle := bundle].PullbackIdentity[] \as Identity;
\structure Result: \Set := {
  dimension: N.Nat^,
  isomorphism: Bundles.Isomorphisms[X := Y, F := F, G := (\fun (y: Y) => Vector dimension), source := bundle,
    target := Bundles.Trivial[X := Y, n := dimension, baseSpace := bundle.baseSpace].bundle].Isomorphism
};
\module WithChart(chart: \Cast[Charts.Chart] ({ c: Charts.Chart \where \In[Y] c.domain point }));
\definition exists: \exists Result := \block {
  \takefrom chart: \Cast[Charts.Chart] ({ c: Charts.Chart \where \In[Y] c.domain point }) \by Original.Of[bundle := bundle].locallyTrivial point \then
  \let result: \exists Result := WithChart[chart := chart].exists \then
  \return result
};
