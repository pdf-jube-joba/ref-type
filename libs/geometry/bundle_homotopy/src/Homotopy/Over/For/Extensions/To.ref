\definition targetBaseContinuous: topology.Continuity[A := Cylinder.CarrierSet, B := Y].Continuous topology target.baseSpace base :=
  \idelim bundle.baseSpace = target.baseSpace \with t: topology.Topology[Carrier := Y].Topology => topology.Continuity[A := Cylinder.CarrierSet, B := Y].Continuous topology t base \by { base: baseContinuous, equality: sameBase };
\definition targetSubBaseContinuous: topology.Continuity[A := SubCylinder.CarrierSet, B := Y].Continuous subTopology target.baseSpace subBase :=
  \idelim bundle.baseSpace = target.baseSpace \with t: topology.Topology[Carrier := Y].Topology => topology.Continuity[A := SubCylinder.CarrierSet, B := Y].Continuous subTopology t subBase \by { base: subBaseContinuous, equality: sameBase };
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].PullbackIsomorphism[X := Y, F := F, G := G, first := bundle, second := target, iso := initialIso,
  Y := Cylinder.CarrierSet, source := topology, f := base, regularFirst := baseContinuous, regularSecond := targetBaseContinuous] \as GlobalInitial;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].PullbackIsomorphism[X := Y, F := F, G := G, first := bundle, second := target, iso := initialIso,
  Y := SubCylinder.CarrierSet, source := subTopology, f := subBase, regularFirst := subBaseContinuous, regularSecond := targetSubBaseContinuous] \as SubInitial;
\import Bundles.Isomorphisms[X := SubCylinder.CarrierSet, F := SubFiber, G := (\fun (z: SubCylinder.CarrierSet) => G (subBase z)), source := subBundle, target := SubInitial.secondBundle] \as PartialIsomorphisms;
\import Bundles.Isomorphisms[X := Cylinder.CarrierSet, F := Fiber, G := (\fun (z: Cylinder.CarrierSet) => G (base z)), source := cylinderBundle, target := GlobalInitial.secondBundle] \as GlobalIsomorphisms;
\module Problem(a: PartialIsomorphisms.Isomorphism,
  agrees: \forall (y: Subset)(v: F y) -> (a.forward.fiber (Pair.pair I.Carrier Subset I.start y)).apply v = (initialIso.forward.fiber y).apply v);
