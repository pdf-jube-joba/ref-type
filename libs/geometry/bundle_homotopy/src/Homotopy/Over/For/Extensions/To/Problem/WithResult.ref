\import Operations.IsomorphismComposition[X := Cylinder.CarrierSet, F := Fiber, G := Fiber, H := (\fun (z: Cylinder.CarrierSet) => G (base z)), source := cylinderBundle, middle := cylinderBundle, target := GlobalInitial.secondBundle] \as Compose;
\definition isomorphism: GlobalIsomorphisms.Isomorphism := Compose.compose result.value GlobalInitial.isomorphism;
\definition value: Result := Result {
  value := isomorphism,
  initial := \fun (y: Y)(v: F y) => congr!{{F y} {G y}} (initialIso.forward.fiber y).apply _ _ (result.initial y v),
  extends := \fun (t: I.Carrier)(y: Subset)(v: F y) => trans!{{G y}} _ _ _
    (congr!{{F y} {G y}} (initialIso.forward.fiber y).apply _ _ (result.extends t y v))
    ((\bysub(OriginalIso.Data, OriginalIso.Isomorphism, initialIso)).rightInverse y ((a.forward.fiber (Pair.pair I.Carrier Subset t y)).apply v))
};
