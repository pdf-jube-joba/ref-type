\structure Result: \Set := {
  value: Global.Isomorphism,
  initial: \forall (y: Y)(v: F y) -> (value.forward.fiber (Pair.pair I.Carrier Y I.start y)).apply v = v,
  extends: \forall (t: I.Carrier)(y: Subset)(v: F y) -> (value.forward.fiber (Pair.pair I.Carrier Y t y)).apply v = (a.forward.fiber (Pair.pair I.Carrier Subset t y)).apply v
};
\import Complements.For[X := Y, F := F, bundle := bundle] \as Embeddings;
\module Using(embedding: Embeddings.Embedding);
\definition exists: \exists Result := \block {
  \takefrom embedding: Embeddings.Embedding \by Embeddings.embeddingExists compact hausdorff \then
  \let result: \exists Result := Using[embedding := embedding].exists \then
  \return result
};
