\import Bundles.Family[X := X, F := F].Of[bundle := first].Pullback[Y := Y, source := source, f := f] \as First;
\import Bundles.Family[X := X, F := G].Of[bundle := second].Pullback[Y := Y, source := source, f := f] \as Second;
\definition firstBundle: Bundles.Family[X := Y, F := \fun (y: Y) => F (f y)].Bundle := First.pulled regularFirst;
\definition secondBundle: Bundles.Family[X := Y, F := \fun (y: Y) => G (f y)].Bundle := Second.pulled regularSecond;
\import Bundles.ArrowLaws[X := X, Y := X, F := F, G := G, source := first, target := second, f := \fun (x: X) => x].Pullback[Z := Y, space := source, g := f].Of[a := iso.forward, regular := regularFirst] \as Forward;
\import Bundles.ArrowLaws[X := X, Y := X, F := G, G := F, source := second, target := first, f := \fun (x: X) => x].Pullback[Z := Y, space := source, g := f].Of[a := iso.backward, regular := regularSecond] \as Backward;
\import Bundles.Isomorphisms[X := Y, F := (\fun (y: Y) => F (f y)), G := (\fun (y: Y) => G (f y)), source := firstBundle, target := secondBundle] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := Forward.map, backward := Backward.map,
  leftInverse := \fun (y: Y)(v: F (f y)) => (\bysub(Bundles.Isomorphisms[X := X, F := F, G := G, source := first, target := second].Data,
    Bundles.Isomorphisms[X := X, F := F, G := G, source := first, target := second].Isomorphism, iso)).leftInverse (f y) v,
  rightInverse := \fun (y: Y)(v: G (f y)) => (\bysub(Bundles.Isomorphisms[X := X, F := F, G := G, source := first, target := second].Data,
    Bundles.Isomorphisms[X := X, F := F, G := G, source := first, target := second].Isomorphism, iso)).rightInverse (f y) v,
};
