\import Operations.CocycleFromAtlas[X := X, I := I, F := F, bundle := bundle, charts := charts] \as Original;
\definition domain[i: I]: \Pow X := (charts i).domain;
\definition dimension[i: I]: N.Nat^ := (charts i).dimension;
\import Operations.Cocycle[X := X, I := I, baseSpace := bundle.baseSpace, domain := domain, dimension := dimension] \as Cocycles;
\definition center[x: X][i: Cocycles.Index x]: \Cast[X] (domain i) := \into[X](x, domain i) \by { \bysub(I, { i: I \where \In[X] (domain i) x }, i) };
\module With(cocycle: Cocycles.Cocycle, regular: Cocycles.With[cocycle := cocycle].Regular,
  transition: \forall (x: X)(i, j: Cocycles.Index x)(v: Vector (dimension i)) -> (cocycle.transition x i j).forward.apply v =
    ((charts j).frame (center x j)).forward.apply (((charts i).frame (center x i)).backward.apply v));
