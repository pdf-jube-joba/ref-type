\definition map[x: X]: Carrier := value (a x) (nonzero x);
\definition matrixRegular: Hermitian.At[n := n].Families[X := X].Matrix[m := n].Regular source (\fun (x: X) => map x) :=
  \fun (v: Vector n) => Hermitian.At[n := n].Families[X := X].scale source a (\fun (x: X) => v) regular (Hermitian.At[n := n].Families[X := X].constant source v);
\definition continuous: topology.Continuity[A := X, B := Carrier].Continuous source topology map := Units.Family[X := X, source := source, H := map].continuous matrixRegular;
