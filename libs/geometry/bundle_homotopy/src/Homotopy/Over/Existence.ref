\definition map[f: A -> B]: (\exists A) -> \exists B := \block {
  \fun (exists: \exists A) \then
  \takefrom a: A \by exists \then
  \return \exact(f a, B)
};
\definition bind[f: A -> \exists B]: (\exists A) -> \exists B := \block {
  \fun (exists: \exists A) \then
  \takefrom a: A \by exists \then
  \let result: \exists B := f a \then
  \return result
};
