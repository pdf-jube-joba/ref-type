\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ClosedMaps[X := X, F := F, G := G, baseSpace := baseSpace, source := source, target := target,
  sourceBase := sourceBase, targetBase := targetBase, C := C, D := D, closedC := closedC, closedD := closedD, covers := covers] \as Forward;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ClosedMaps[X := X, F := G, G := F, baseSpace := baseSpace, source := target, target := source,
  sourceBase := targetBase, targetBase := sourceBase, C := C, D := D, closedC := closedC, closedD := closedD, covers := covers] \as Backward;
\import Forward.Side[S := C] \as Left;
\import Forward.Side[S := D] \as Right;
\module With(left: Left.Isomorphism, right: Right.Isomorphism,
  agrees: \forall (x: X)(inC: \In[X] C x)(inD: \In[X] D x)(v: F x) ->
    (left.forward.fiber (\into[X](x, C) \by { inC })).apply v = (right.forward.fiber (\into[X](x, D) \by { inD })).apply v);
