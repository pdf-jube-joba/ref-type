\import Motion.Slice[t := s] \as First;
\import Motion.Slice[t := r] \as Second;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projections[n := n].Gap[X := X, baseSpace := baseSpace,
  P := (\fun (x: X) => First.projection x), Q := (\fun (x: X) => Second.projection x), regularP := First.regular, regularQ := Second.regular] \as LocalGap;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ProjectionComparison[n := n, X := X, baseSpace := baseSpace,
  P := (\fun (x: X) => First.projection x), Q := (\fun (x: X) => Second.projection x), regularP := First.regular, regularQ := Second.regular,
  H := LocalGap.h, regularH := LocalGap.regular, nonsingular := nonzero s r insideS insideR, intertwines := LocalGap.intertwines] \as Comparison;
\definition isomorphism: Motion.Isomorphism s r := Comparison.isomorphism;
\definition fixed: Motion.Fixed s r isomorphism := \fun (x: X)(inside: \In[X] A x)(v: First.Fiber x) =>
    LocalGap.onImage x v (\bysub(Vector n, { v: Vector n \where (First.projection x).map.apply v = v }, v)) (stationary x inside s r);
\definition relativeIsomorphism: Motion.RelativeIsomorphism[s, r] := Motion.RelativeIsomorphism[s, r] { value := isomorphism, fixed := fixed };
