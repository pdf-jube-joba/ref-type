\import Spaces.Linear[V := Vector n, W := Vector n, source := coordinates n, target := coordinates n] \as End;
\import End.Operations[] \as Operations;
\import End.Composition[U := Vector n, domain := coordinates n] \as Compose;
\import Spaces.Laws[V := Vector n, space := coordinates n] \as Laws;
\import Native.OnProjection[P := P] \as Source;
\import Native.OnProjection[P := Q] \as Target;
\definition h: End.Map := Operations.plus (Compose.compose Q.map P.map) (Compose.compose Target.complement.map Source.complement.map);
\definition left: \forall (v: Vector n) -> Q.map.apply (h.apply v) = Q.map.apply (P.map.apply v) :=
  \fun (v: Vector n) => trans!{{Vector n}} _ _ _ (Q.map.preservesAdd (Q.map.apply (P.map.apply v)) (Target.complement.map.apply (Source.complement.map.apply v)))
    (trans!{{Vector n}} _ _ _ (congr!{{Vector n} {Vector n} {Vector n}} (coordinates n).add _ _ _ _
      (Q.idempotent (P.map.apply v)) (Target.annihilates (Source.complement.map.apply v))) (Laws.zeroRight (Q.map.apply (P.map.apply v))));
\definition right: \forall (v: Vector n) -> h.apply (P.map.apply v) = Q.map.apply (P.map.apply v) :=
  \fun (v: Vector n) => trans!{{Vector n}} _ _ _
    (congr!{{Vector n} {Vector n} {Vector n}} (coordinates n).add _ _ _ _
      (congr!{{Vector n} {Vector n}} Q.map.apply _ _ (P.idempotent v))
      (trans!{{Vector n}} _ _ _ (congr!{{Vector n} {Vector n}} Target.complement.map.apply _ _ (Source.annihilatesRight v)) Target.complement.map.preservesZero))
    (Laws.zeroRight (Q.map.apply (P.map.apply v)));
\definition intertwines: \forall (v: Vector n) -> Q.map.apply (h.apply v) = h.apply (P.map.apply v) :=
  \fun (v: Vector n) => trans!{{Vector n}} _ _ _ (left v) (sym!{{Vector n}} _ _ (right v));

\definition killsFixed: \forall (v: Vector n) -> P.map.apply v = v -> Source.complement.map.apply v = (coordinates n).zero :=
  \fun (v: Vector n)(fixed: _) => trans!{{Vector n}} _ _ _
    (congr!{{Vector n} {Vector n}} Source.complement.map.apply _ _ (sym!{{Vector n}} _ _ fixed)) (Source.annihilatesRight v);
\definition onImage: \forall (v: Vector n) -> P.map.apply v = v -> P.map = Q.map -> h.apply v = v :=
  \fun (v: Vector n)(fixed: _)(same: _) => eq_reason_in!{{Vector n} _
    "=" { (coordinates n).add (Q.map.apply v) (coordinates n).zero } "by" {
      congr!{{Vector n} {Vector n} {Vector n}} (coordinates n).add _ _ _ _ (congr!{{Vector n} {Vector n}} Q.map.apply _ _ fixed)
        (trans!{{Vector n}} _ _ _ (congr!{{Vector n} {Vector n}} Target.complement.map.apply _ _ (killsFixed v fixed)) Target.complement.map.preservesZero)
    }
    "=" _ "by" { Laws.zeroRight (Q.map.apply v) }
    "=" { P.map.apply v } "by" { congr!{End.Map {Vector n}} (\fun (f: End.Map) => f.apply v) _ _ (sym!{End.Map} _ _ same) }
    "=" _ "by" { fixed }
  };
