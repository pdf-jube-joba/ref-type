\import \parent.Operators[].Units[] \as Units;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ProjectionComparison[n := n, X := X, baseSpace := baseSpace, P := P, Q := Q,
  regularP := regularP, regularQ := regularQ, H := (\fun (x: X) => Units.identity),
  regularH := (\fun (v: Vector n) => Native.Families[X := X].constant baseSpace v),
  nonsingular := (\fun (x: X) => \bysub(End.Map, Units.Invertible, Units.identity)),
  intertwines := (\fun (x: X)(v: Vector n) => congr!{End.Map {Vector n}} (\fun (h: End.Map) => h.apply v) _ _ (sym!{End.Map} _ _ (same x)))] \as Comparison;
\import Complements.Projection[X := X, n := n, baseSpace := baseSpace, P := P, regular := regularP] \as Source;
\import Complements.Projection[X := X, n := n, baseSpace := baseSpace, P := Q, regular := regularQ] \as Target;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Source.Fiber, G := Target.Fiber, source := Source.bundle, target := Target.bundle].Isomorphism := Comparison.isomorphism;
\definition formula: \forall (x: X)(v: Source.Fiber x) -> valueOf ((isomorphism.forward.fiber x).apply v) = valueOf v := \fun (x: X)(v: Source.Fiber x) => \refl(valueOf v);
