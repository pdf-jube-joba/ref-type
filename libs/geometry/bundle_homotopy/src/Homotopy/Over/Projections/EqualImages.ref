\import \parent.Operators[].Units[] \as Units;
\definition identityRegular: Native.Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => Units.identity) :=
  \fun (v: Vector n) => Native.Families[X := X].constant baseSpace v;
\definition nonsingular: \forall (x: X) -> matrix_invariants.Field[K := K, field := field].At[n := n].Nonzero (Native.Square[].entries Units.identity) :=
  \fun (x: X) => \bysub(End.Map, Units.Invertible, Units.identity);
\definition intertwines: \forall (x: X)(v: Vector n) -> (Q x).map.apply v = (P x).map.apply v :=
  \fun (x: X)(v: Vector n) => congr!{End.Map {Vector n}} (\fun (h: End.Map) => h.apply v) _ _ (sym!{End.Map} _ _ (same x));
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ProjectionComparison[n := n, X := X, baseSpace := baseSpace, P := P, Q := Q,
  regularP := regularP, regularQ := regularQ, H := (\fun (x: X) => Units.identity), regularH := identityRegular, nonsingular := nonsingular, intertwines := intertwines] \as Comparison;
\import Complements.Projection[X := X, n := n, baseSpace := baseSpace, P := P, regular := regularP] \as Source;
\import Complements.Projection[X := X, n := n, baseSpace := baseSpace, P := Q, regular := regularQ] \as Target;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Source.Fiber, G := Target.Fiber, source := Source.bundle, target := Target.bundle].Isomorphism := Comparison.isomorphism;
\definition formula: \forall (x: X)(v: Source.Fiber x) -> valueOf ((isomorphism.forward.fiber x).apply v) = valueOf v := \fun (x: X)(v: Source.Fiber x) => \refl(valueOf v);
