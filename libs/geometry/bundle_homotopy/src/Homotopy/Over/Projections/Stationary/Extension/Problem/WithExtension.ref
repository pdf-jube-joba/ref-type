\import algebraic_topology.Homotopy[A := X, B := Units.Carrier] \as Homotopies;
\definition laws: Cofibration.ExtensionLaws[baseSpace, Units.topology, problem, h] := \bysub(Homotopies.Family, Cofibration.Extension[baseSpace, Units.topology, problem], h);
\import \parent.\parent.\parent.\parent.Moved[X := Cylinder.CarrierSet, baseSpace := topology, P := projection, regular := projectionRegular, H := h, continuous := laws.continuous] \as Moving;
\module OnSubset(t: I.Carrier, x: Subset);
\module AtStart(x: X);
\definition stationary: \forall (x: X) -> \In[X] A x -> \forall (s, t: I.Carrier) ->
  (Moving.projection (Pair.pair I.Carrier X s x)).map = (Moving.projection (Pair.pair I.Carrier X t x)).map := \block {
  \fun (x: X)(inside: \In[X] A x)(s, t: I.Carrier) \then
  \let point: Subset := \into[X](x, A) \by { inside } \then
  \return trans!{End.Map} _ _ _ (OnSubset[t := s, x := point].projectionEqual) (sym!{End.Map} _ _ (OnSubset[t := t, x := point].projectionEqual))
};
\import \parent.\parent.\parent.\parent.Isotopy[X := X, baseSpace := baseSpace, compact := compact, P := Moving.projection, regular := Moving.projectionRegular, A := A, stationary := stationary] \as Motion;
\module Compare(iso: Motion.RelativeIsomorphism I.start I.end);
\definition exists: \exists Result := \block {
  \takefrom iso: Motion.RelativeIsomorphism I.start I.end \by Motion.isomorphismExists \then
  \let result: Result := Compare[iso := iso].result \then
  \return \exact(result, Result)
};
