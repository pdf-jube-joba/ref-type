\definition point: Cylinder.CarrierSet := Pair.pair I.Carrier X I.start x;
\import Spaces.Isomorphism[V := Fiber point, W := Fiber point, source := bundle.space point, target := bundle.space point] \as Linear;
\import Spaces.Eigen[V := Fiber point, space := bundle.space point] \as Eigen;
\definition identity: Linear.Isomorphism := Linear.Isomorphism { forward := Eigen.identity, backward := Eigen.identity, leftInverse := (\fun (v: Fiber point) => \refl(v)), rightInverse := (\fun (v: Fiber point) => \refl(v)) };
\definition formula: \forall (v: Fiber point) -> (h point).apply v = valueOf v :=
  \fun (v: Fiber point) => congr!{{Units.Carrier} {Vector n}} (\fun (m: Units.Carrier) => m.apply v) _ _ (laws.initial x);
\definition projectionEqual: (Moving.projection point).map = (projection point).map := Moving.At[x := point].Preserves[b := identity, same := formula].projectionEqual;
