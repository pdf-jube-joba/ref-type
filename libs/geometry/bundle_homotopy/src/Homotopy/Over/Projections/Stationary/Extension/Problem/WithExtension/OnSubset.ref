\definition point: Cylinder.CarrierSet := Pair.pair I.Carrier X t x;
\definition subPoint: SubCylinder.CarrierSet := Pair.pair I.Carrier Subset t x;
\import Spaces.Isomorphism[V := Fiber point, W := Fiber point, source := bundle.space point, target := bundle.space point] \as Linear;
\definition aIso: Linear.Isomorphism := Linear.Isomorphism {
  forward := a.forward.fiber subPoint, backward := a.backward.fiber subPoint,
  leftInverse := (\bysub(PartialAutomorphisms.Data, PartialAutomorphisms.Isomorphism, a)).leftInverse subPoint,
  rightInverse := (\bysub(PartialAutomorphisms.Data, PartialAutomorphisms.Isomorphism, a)).rightInverse subPoint
};
\definition formula: \forall (v: Fiber point) -> (h point).apply v = valueOf (aIso.forward.apply v) :=
  \fun (v: Fiber point) => trans!{{Vector n}} _ _ _
    (congr!{{Units.Carrier} {Vector n}} (\fun (m: Units.Carrier) => m.apply v) _ _ (laws.extends t x)) (Ambient.At[x := subPoint].onImage v);
\definition projectionEqual: (Moving.projection point).map = (projection point).map := Moving.At[x := point].Preserves[b := aIso, same := formula].projectionEqual;
