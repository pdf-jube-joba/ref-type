\import topological_algebra.Coordinates[K := Vector n, I := Fin.Fin n] \as Columns;
\import topological_algebra.Coordinates[K := K, I := Fin.Fin n] \as Coordinates;
\definition columns[f: End.Map][j: Fin.Fin n]: Vector n := f.apply (Geometry.Finite[n := n].basis j);
\import topological_constructions.Induced[A := End.Map, B := Fin.Fin n -> Vector n] \as Induced;
\definition topology: topology.Topology[Carrier := End.Map].Topology := Induced.topology (Columns.topology (coordinateTopology n)) columns;
\definition columnContinuous: \forall (j: Fin.Fin n) -> topology.Continuity[A := End.Map, B := Vector n].Continuous topology (coordinateTopology n) (\fun (f: End.Map) => columns f j) :=
  \fun (j: Fin.Fin n) => topology.Composition[A := End.Map, B := Fin.Fin n -> Vector n, C := Vector n].composeContinuous topology (Columns.topology (coordinateTopology n)) (coordinateTopology n) columns (\fun (f: Fin.Fin n -> Vector n) => f j)
    (Induced.continuous (Columns.topology (coordinateTopology n)) columns) (Columns.evaluationContinuous (coordinateTopology n) j);
\module Family(X: \Set, source: topology.Topology[Carrier := X].Topology, H: X -> End.Map);
\definition operatorTopology: topology.Topology[Carrier := End.Map].Topology := topology;
\module Units;

\module FromMorphism(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology,
  h: Bundles.Morphisms[X := X, Y := X, F := (\fun (x: X) => Vector n), G := (\fun (x: X) => Vector n),
    source := Bundles.Trivial[X := X, n := n, baseSpace := baseSpace].bundle,
    target := Bundles.Trivial[X := X, n := n, baseSpace := baseSpace].bundle, f := (\fun (x: X) => x)].Map);

\module Evaluation(Y: \Set, source: topology.Topology[Carrier := Y].Topology, H: Y -> End.Map,
  regular: Native.Families[X := Y].Matrix[m := n].Regular source H,
  v: Y -> Vector n, vectorRegular: topology.Continuity[A := Y, B := Vector n].Continuous source (coordinateTopology n) v);
