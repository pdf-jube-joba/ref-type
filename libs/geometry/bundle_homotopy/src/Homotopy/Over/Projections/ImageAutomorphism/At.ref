\import Native.OnProjection[P := P x] \as Algebra;
\import Spaces.Laws[V := Vector n, space := coordinates n] \as Laws;
\definition formula: \forall (v: Vector n) -> (value x).apply v = (coordinates n).add
  (valueOf ((a.forward.fiber x).apply ((Image.projectMap.fiber x).apply v))) (Algebra.complement.map.apply v) := \fun (v: Vector n) => \refl((value x).apply v);
\definition onImage: \forall (v: Image.Fiber x) -> (value x).apply v = valueOf ((a.forward.fiber x).apply v) :=
  \fun (v: Image.Fiber x) => trans!{{Vector n}} _ _ _
    (congr!{{Vector n} {Vector n} {Vector n}} (coordinates n).add _ _ _ _
      (congr!{{Image.Fiber x} {Vector n}} (\fun (w: Image.Fiber x) => (a.forward.fiber x).apply w) _ _ (\bysub(Vector n, Image.Image x, v)))
      (\parent.\parent.Between[P := P x, Q := P x].killsFixed v (\bysub(Vector n, Image.Image x, v))))
    (Laws.zeroRight ((a.forward.fiber x).apply v));
\definition identity[fixed: \forall (v: Image.Fiber x) -> (a.forward.fiber x).apply v = v]: value x = Units.identity :=
  End.ext (value x) Units.identity (\axiom:funext((value x).apply, Units.identity.apply, \fun (v: Vector n) =>
    trans!{{Vector n}} _ _ _
      (congr!{{Vector n} {Vector n} {Vector n}} (coordinates n).add _ _ _ _
        (congr!{{Image.Fiber x} {Vector n}} (\fun (w: Image.Fiber x) => w) _ _ (fixed ((Image.projectMap.fiber x).apply v))) (\refl(Algebra.complement.map.apply v)))
      (Algebra.splitting v)));
