\import algebraic_topology.Interval[] \as I;
\import topological_constructions.Product[A := I.Carrier, B := X] \as Cylinder;
\definition topology: topology.Topology[Carrier := Cylinder.CarrierSet].Topology := Cylinder.topology I.topology baseSpace;
\definition base[z: Cylinder.CarrierSet]: X := Pair.second I.Carrier X z;
\definition time[z: Cylinder.CarrierSet]: I.Carrier := Pair.first I.Carrier X z;
\definition projection[z: Cylinder.CarrierSet]: Native.Projection := P (base z);
\definition projectionRegular: Native.Families[X := Cylinder.CarrierSet].Matrix[m := n].Regular topology (\fun (z: Cylinder.CarrierSet) => (projection z).map) :=
  \fun (v: Vector n)(i: Fin.Fin n) => topology.Composition[A := Cylinder.CarrierSet, B := X, C := K].composeContinuous topology baseSpace scalar.topological.space base
    (\fun (x: X) => (P x).map.apply v i) (Cylinder.Maps[].secondContinuous I.topology baseSpace) (regular v i);
\import Complements.Projection[X := Cylinder.CarrierSet, n := n, baseSpace := topology, P := projection, regular := projectionRegular] \as Image;
\definition Fiber[z: Cylinder.CarrierSet]: \Set := Image.Fiber z;
\definition bundle: Bundles.Family[X := Cylinder.CarrierSet, F := Fiber].Bundle := Image.bundle;
\import Bundles.Isomorphisms[X := Cylinder.CarrierSet, F := Fiber, G := Fiber, source := bundle, target := bundle] \as Automorphisms;
\module Extension(A: \Pow X, cofibration: algebraic_topology.Cofibration[A := X, subset := A].IsCofibration baseSpace);
