\import algebraic_topology.Interval[] \as I;
\import topology.Topology[Carrier := I.Carrier] \as Time;
\import topology.Topology[Carrier := X] \as Base;
\import topological_constructions.Product[A := I.Carrier, B := X] \as Cylinder;
\definition topology: topology.Topology[Carrier := Cylinder.CarrierSet].Topology := Cylinder.topology I.topology baseSpace;
\import Hermitian.At[n := n].Families[X := Cylinder.CarrierSet].Matrix[m := n] \as Maps;
\module Reindex(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> Cylinder.CarrierSet,
  continuous: topology.Continuity[A := Y, B := Cylinder.CarrierSet].Continuous source topology f);
\module Slice(t: I.Carrier);
\definition Isomorphism[s: I.Carrier][t: I.Carrier]: \Set := Bundles.Isomorphisms[X := X,
  F := (\fun (x: X) => Slice[t := s].Fiber x), G := (\fun (x: X) => Slice[t := t].Fiber x), source := Slice[t := s].bundle, target := Slice[t := t].bundle].Isomorphism;
\definition Fixed[s: I.Carrier][t: I.Carrier][iso: Isomorphism s t]: \Prop :=
  \forall (x: X) -> \In[X] A x -> \forall (v: Slice[t := s].Fiber x) -> valueOf ((iso.forward.fiber x).apply v) = valueOf v;
\structure RelativeIsomorphism[s: I.Carrier, t: I.Carrier]: \Set := { value: Isomorphism s t, fixed: Fixed s t value };
\definition Related[s: I.Carrier][t: I.Carrier]: \Prop := \exists RelativeIsomorphism[s, t];
\definition transitive: \forall (r, s, t: I.Carrier) -> Related r s -> Related s t -> Related r t := \block {
  \fun (r, s, t: I.Carrier)(first: _)(second: _) \then
  \takefrom a: RelativeIsomorphism[r, s] \by first \then
  \takefrom b: RelativeIsomorphism[s, t] \by second \then
  \return \exact(RelativeIsomorphism[r, t] {
    value := Operations.IsomorphismComposition[X := X, F := (\fun (x: X) => Slice[t := r].Fiber x), G := (\fun (x: X) => Slice[t := s].Fiber x), H := (\fun (x: X) => Slice[t := t].Fiber x),
      source := Slice[t := r].bundle, middle := Slice[t := s].bundle, target := Slice[t := t].bundle].compose a.value b.value,
    fixed := \fun (x: X)(inside: \In[X] A x)(v: Slice[t := r].Fiber x) => trans!{{Vector n}} _ _ _ (b.fixed x inside ((a.value.forward.fiber x).apply v)) (a.fixed x inside v),
  }, RelativeIsomorphism[r, t])
};
\import spectral_splitting.Spectral[].IntervalRelations[R := Related] \as Relations;
\module Uniform;
\definition endpointComparisonExists: Related I.start I.end := Relations.endpoints transitive Uniform[].local;
\definition endpointIsomorphismExists: \exists Isomorphism I.start I.end := \block {
  \takefrom iso: RelativeIsomorphism[I.start, I.end] \by endpointComparisonExists \then
  \return \exact(iso.value, Isomorphism I.start I.end)
};
