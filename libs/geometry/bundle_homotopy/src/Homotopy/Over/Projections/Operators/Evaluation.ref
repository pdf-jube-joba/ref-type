\import Native.Families[X := Y].Matrix[m := n] \as Matrices;
\definition components: Matrices.Components source H := \fun (j, i: Fin.Fin n) => regular (Geometry.Finite[n := n].basis j) i;
\definition vectors: Native.Families[X := Y].Continuous source v := \fun (i: Fin.Fin n) =>
  topology.Composition[A := Y, B := Vector n, C := K].composeContinuous source (coordinateTopology n) scalar.topological.space v (\fun (w: Vector n) => w i) vectorRegular (Coordinates.evaluationContinuous scalar.topological.space i);
\definition continuous: topology.Continuity[A := Y, B := Vector n].Continuous source (coordinateTopology n) (\fun (y: Y) => (H y).apply (v y)) :=
  Coordinates.Universal[A := Y].continuous source scalar.topological.space _ (Matrices.evaluate source H v components vectors);
