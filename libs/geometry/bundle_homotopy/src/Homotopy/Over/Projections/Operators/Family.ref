\import Native.Families[X := X].Matrix[m := n] \as Maps;
\definition continuous: Maps.Regular source H -> topology.Continuity[A := X, B := End.Map].Continuous source topology H :=
  \fun (regular: _) => Induced.Universal[Z := X].continuous source (Columns.topology (coordinateTopology n)) columns H
    (Columns.Universal[A := X].continuous source (coordinateTopology n) (\fun (x: X) => columns (H x))
      (\fun (j: Fin.Fin n) => Coordinates.Universal[A := X].continuous source scalar.topological.space (\fun (x: X) => columns (H x) j) (regular (Geometry.Finite[n := n].basis j))));
\definition regular: topology.Continuity[A := X, B := End.Map].Continuous source topology H -> Maps.Regular source H :=
  \fun (continuous: _) => Maps.regularOfComponents source H (\fun (j, i: Fin.Fin n) =>
    topology.Composition[A := X, B := Vector n, C := K].composeContinuous source (coordinateTopology n) scalar.topological.space (\fun (x: X) => columns (H x) j) (\fun (v: Vector n) => v i)
      (topology.Composition[A := X, B := End.Map, C := Vector n].composeContinuous source topology (coordinateTopology n) H (\fun (f: End.Map) => columns f j) continuous (columnContinuous j))
      (Coordinates.evaluationContinuous scalar.topological.space i));
