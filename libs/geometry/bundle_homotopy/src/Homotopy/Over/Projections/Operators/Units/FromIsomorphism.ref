\import Bundles.Trivial[X := X, n := n, baseSpace := baseSpace] \as Trivial;
\import Bundles.Isomorphisms[X := X, F := (\fun (x: X) => Vector n), G := (\fun (x: X) => Vector n), source := Trivial.bundle, target := Trivial.bundle] \as Isomorphisms;
\definition value[x: X]: Carrier := \into[End.Map](iso.forward.fiber x, Invertible) \by {
  Square.LeftInverse[f := iso.forward.fiber x, g := iso.backward.fiber x, left := (\bysub(Isomorphisms.Data, Isomorphisms.Isomorphism, iso)).leftInverse x].nonzero
};
\definition continuous: topology.Continuity[A := X, B := Carrier].Continuous baseSpace topology value :=
  \parent.Family[X := X, source := baseSpace, H := value].continuous (\parent.\parent.FromMorphism[X := X, baseSpace := baseSpace, h := iso.forward].regular);
\definition formula: \forall (x: X)(v: Vector n) -> (value x).apply v = (iso.forward.fiber x).apply v := \fun (x: X)(v: Vector n) => \refl((value x).apply v);
