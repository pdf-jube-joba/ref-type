\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projections[n := n].Operators[] \as Operators;
\definition regular: topology.Continuity[A := X, B := Carrier].Continuous source topology H -> Native.Families[X := X].Matrix[m := n].Regular source (\fun (x: X) => H x) :=
  \fun (continuous: _) => Operators.Family[X := X, source := source, H := (\fun (x: X) => H x)].regular
    (topology.Composition[A := X, B := Carrier, C := End.Map].composeContinuous source topology operatorTopology H include continuous inclusionContinuous);
\definition continuous: Native.Families[X := X].Matrix[m := n].Regular source (\fun (x: X) => H x) -> topology.Continuity[A := X, B := Carrier].Continuous source topology H :=
  \fun (regular: _) => topology.Continuity[A := X, B := End.Map].Corestriction[S := Invertible].corestrictContinuous source operatorTopology H
    (Operators.Family[X := X, source := source, H := (\fun (x: X) => H x)].continuous regular);
