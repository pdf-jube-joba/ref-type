\import Complements.For[X := X, F := F, bundle := bundle].FromEmbedding[embedding := embedding].Image[] \as Original;
\definition n: N.Nat^ := embedding.dimension;
\definition projection[x: X]: Hermitian.At[n := n].Projection := Original.projection x;
\definition regular: Hermitian.At[n := n].Families[X := X].Matrix[m := n].Regular bundle.baseSpace (\fun (x: X) => (projection x).map) := Original.regular;
\definition ImageFiber[x: X]: \Set := Original.ImageFiber x;
\definition imageBundle: Bundles.Family[X := X, F := ImageFiber].Bundle := Original.imageBundle;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := F, G := ImageFiber, source := bundle, target := imageBundle].Isomorphism := Original.isomorphism;
\module Pullback(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  continuous: topology.Continuity[A := Y, B := X].Continuous source bundle.baseSpace f);
