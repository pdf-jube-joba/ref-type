\import Motion.Endpoint[t := t] \as Native;
\definition inclusion: X -> Cylinder.CarrierSet := Native.inclusion;
\definition continuous: topology.Continuity[A := X, B := Cylinder.CarrierSet].Continuous baseSpace topology inclusion := Native.continuous;
\definition at[x: Overlap]: Units.Carrier := G (Pair.pair I.Carrier Overlap t x);
\definition regularAt: topology.Continuity[A := Overlap, B := Units.Carrier].Continuous overlapTopology Units.topology at :=
  topology.Composition[A := Overlap, B := Parameters.CarrierSet, C := Units.Carrier].composeContinuous overlapTopology parameterTopology Units.topology (\fun (x: Overlap) => Pair.pair I.Carrier Overlap t x) G
    (Parameters.Universal[X := Overlap].pairContinuous overlapTopology I.topology overlapTopology (\fun (x: Overlap) => t) (\fun (x: Overlap) => x)
      (topology.Maps[A := Overlap, B := I.Carrier].constantContinuous overlapTopology I.topology t) (topology.Maps[A := Overlap, B := Overlap].Identity[].continuous overlapTopology)) regular;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Clutching[n := n, X := X, baseSpace := baseSpace, U := U, V := V, openU := openU, openV := openV, covers := covers].With[g := at, continuous := regularAt] \as Slice;
\definition containedU: \forall (x: \Cast[X] U) -> \In[Cylinder.CarrierSet] UC (inclusion x) := \fun (x: \Cast[X] U) => \bysub(X, U, x);
\definition containedV: \forall (x: \Cast[X] V) -> \In[Cylinder.CarrierSet] VC (inclusion x) := \fun (x: \Cast[X] V) => \bysub(X, V, x);
\import Construction.AlongCover[Y := X, source := baseSpace, f := inclusion, continuousF := continuous,
  UY := U, VY := V, openUY := openU, openVY := openV, covered := covers, containedU := containedU, containedV := containedV] \as Pullback;
\definition Fiber[x: X]: \Set := Slice.Fiber x;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Slice.bundle;
\definition Comparison: \Set := Bundles.Isomorphisms[X := X, F := Native.Fiber, G := Fiber, source := Native.bundle, target := bundle].Isomorphism;
\definition comparisonExists: \exists Comparison := Pullback.isomorphismExists;
