\import Motion.Endpoint[t := I.start] \as NativeStart;
\import Motion.Endpoint[t := I.end] \as NativeFinish;
\import Bundles.Isomorphisms[X := X, F := NativeStart.Fiber, G := Start.Fiber, source := NativeStart.bundle, target := Start.bundle] \as Reverse;
\import Operations.IsomorphismComposition[X := X, F := Start.Fiber, G := NativeStart.Fiber, H := NativeFinish.Fiber, source := Start.bundle, middle := NativeStart.bundle, target := NativeFinish.bundle] \as First;
\import Operations.IsomorphismComposition[X := X, F := Start.Fiber, G := NativeFinish.Fiber, H := Finish.Fiber, source := Start.bundle, middle := NativeFinish.bundle, target := Finish.bundle] \as Second;
\definition value[first: Start.Comparison][motion: Motion.Isomorphism][last: Finish.Comparison]: Isomorphism := Second.compose (First.compose (Reverse.inverse first) motion) last;
