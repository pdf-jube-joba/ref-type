\definition leftPoint: \Cast[X] U := \into[X](x, U) \by { (\bysub(X, overlap, x)).left };
\definition rightPoint: \Cast[X] V := \into[X](x, V) \by { (\bysub(X, overlap, x)).right };
\definition leftIndex: Cocycles.Index x := \into[B.Bool^](B.Bool^::false, Cocycles.Index x) \by { (\bysub(X, overlap, x)).left };
\definition rightIndex: Cocycles.Index x := \into[B.Bool^](B.Bool^::true, Cocycles.Index x) \by { (\bysub(X, overlap, x)).right };
\definition transition: \forall (v: Vector n) -> ((chart B.Bool^::true).frame rightPoint).forward.apply (((chart B.Bool^::false).frame leftPoint).backward.apply v) = (g x).apply v :=
  \fun (v: Vector n) => trans!{{Vector n}} _ _ _ (Constructed.At[x := x].Frame[i := leftIndex].assembledValue v rightIndex)
    (congr!{{Units.Carrier} {Vector n}} (\fun (h: Units.Carrier) => h.apply v) _ _ (Extend.inside g Units.identity x));
