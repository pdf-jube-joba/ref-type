\definition Carrier: \Set := \Cast[X] S;
\definition topology: topology.Topology[Carrier := Carrier].Topology := topology.Topology[Carrier := X].Subspace[S := S].topology baseSpace;
\definition include[x: Carrier]: X := x;
\definition continuous: topology.Continuity[A := Carrier, B := X].Continuous topology baseSpace include :=
  topology.Continuity[A := X, B := X].Restriction[S := S].restrictContinuous baseSpace baseSpace (\fun (x: X) => x)
    (topology.Maps[A := X, B := X].Identity[].continuous baseSpace);
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ChartPullback[X := X, F := Fiber, bundle := bundle, chart := chart i,
  Y := Carrier, source := topology, f := include, continuous := continuous, inside := inside] \as Source;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ChartPullback[X := X, F := Other.Fiber, bundle := Other.bundle, chart := Other.chart i,
  Y := Carrier, source := topology, f := include, continuous := continuous, inside := inside] \as Target;
\import Bundles.Isomorphisms[X := Carrier, F := (\fun (x: Carrier) => Fiber x), G := (\fun (x: Carrier) => Vector n), source := Source.pulledBundle, target := Bundles.Trivial[X := Carrier, n := n, baseSpace := topology].bundle] \as SourceComparison;
\import Bundles.Isomorphisms[X := Carrier, F := (\fun (x: Carrier) => Other.Fiber x), G := (\fun (x: Carrier) => Vector n), source := Target.pulledBundle, target := Bundles.Trivial[X := Carrier, n := n, baseSpace := topology].bundle] \as TargetComparison;
\definition sourceBundle: Bundles.Family[X := Carrier, F := (\fun (x: Carrier) => Fiber x)].Bundle := Source.pulledBundle;
\definition targetBundle: Bundles.Family[X := Carrier, F := (\fun (x: Carrier) => Other.Fiber x)].Bundle := Target.pulledBundle;
\definition Isomorphism: \Set := Bundles.Isomorphisms[X := Carrier, F := (\fun (x: Carrier) => Fiber x), G := (\fun (x: Carrier) => Other.Fiber x), source := sourceBundle, target := targetBundle].Isomorphism;
\module WithMatrix(H: Carrier -> Units.Carrier, regular: topology.Continuity[A := Carrier, B := Units.Carrier].Continuous topology Units.topology H);
\module FromIsomorphism(iso: Bundles.Isomorphisms[X := X, F := Fiber, G := Other.Fiber, source := bundle, target := Other.bundle].Isomorphism);
