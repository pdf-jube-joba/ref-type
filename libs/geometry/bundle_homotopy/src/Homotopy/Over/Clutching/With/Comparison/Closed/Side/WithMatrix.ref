\import Units.BundleFamily[X := Carrier, baseSpace := topology, H := H, continuousH := regular] \as Matrix;
\import Operations.IsomorphismComposition[X := Carrier, F := (\fun (x: Carrier) => Fiber x), G := (\fun (x: Carrier) => Vector n), H := (\fun (x: Carrier) => Vector n),
  source := sourceBundle, middle := Bundles.Trivial[X := Carrier, n := n, baseSpace := topology].bundle, target := Bundles.Trivial[X := Carrier, n := n, baseSpace := topology].bundle] \as First;
\import Operations.IsomorphismComposition[X := Carrier, F := (\fun (x: Carrier) => Fiber x), G := (\fun (x: Carrier) => Vector n), H := (\fun (x: Carrier) => Other.Fiber x),
  source := sourceBundle, middle := Bundles.Trivial[X := Carrier, n := n, baseSpace := topology].bundle, target := targetBundle] \as Second;
\definition isomorphism: Isomorphism := Second.compose (First.compose Source.isomorphism Matrix.isomorphism) (TargetComparison.inverse Target.isomorphism);
\definition sourcePoint[x: Carrier]: \Cast[X] (domain i) := \into[X](x, domain i) \by { inside x };
\definition formula: \forall (x: Carrier)(v: Fiber x) -> (isomorphism.forward.fiber x).apply v = ((Other.chart i).frame (sourcePoint x)).backward.apply ((H x).apply (((chart i).frame (sourcePoint x)).forward.apply v)) := \fun (x: Carrier)(v: Fiber x) => \refl((isomorphism.forward.fiber x).apply v);
