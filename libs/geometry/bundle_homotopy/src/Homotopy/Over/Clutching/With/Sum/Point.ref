\definition after[i: B.Bool^][j: B.Bool^][v: Vector Block.total]: Vector Block.total := Coordinates.join
  (PairSpace.make ((change x i j).forward.apply (PairSpace.first (Coordinates.split v))) ((Other.change x i j).forward.apply (PairSpace.second (Coordinates.split v))));
\definition rawEqual: \forall (i, j: B.Bool^) -> \In[X] (domain i) x -> \In[X] (domain j) x -> \forall (v: Vector Block.total) -> (New.change x i j).forward.apply v = after i j v :=
  B.cases2 (\fun (i, j: B.Bool^) => \In[X] (domain i) x -> \In[X] (domain j) x -> \forall (v: Vector Block.total) -> (New.change x i j).forward.apply v = after i j v)
    (\fun (first: \In[X] U x)(second: \In[X] U x)(v: Vector Block.total) => sym!{{Vector Block.total}} _ _ ((Spaces.Isomorphism[V := PairSpace.Carrier, W := Vector Block.total, source := PairSpace.space, target := coordinates Block.total].laws Coordinates.isomorphism).rightInverse v))
    (\fun (first: \In[X] U x)(second: \In[X] V x)(v: Vector Block.total) => trans!{{Vector Block.total}} _ _ _
      (congr!{{TotalUnits.Carrier} {Vector Block.total}} (\fun (h: TotalUnits.Carrier) => h.apply v) _ _ (globalEquality (\into[X](x, overlap) \by { Logic.And[_, _]::# first second })))
      (Block.formula (global x) (Other.global x) v))
    (\fun (first: \In[X] V x)(second: \In[X] U x)(v: Vector Block.total) => trans!{{Vector Block.total}} _ _ _
      (congr!{{TotalUnits.Carrier} {Vector Block.total}} (\fun (h: TotalUnits.Carrier) => (TotalUnits.inverse h).apply v) _ _ (globalEquality (\into[X](x, overlap) \by { Logic.And[_, _]::# second first })))
      (Block.inverseFormula (global x) (Other.global x) v))
    (\fun (first: \In[X] V x)(second: \In[X] V x)(v: Vector Block.total) => sym!{{Vector Block.total}} _ _ ((Spaces.Isomorphism[V := PairSpace.Carrier, W := Vector Block.total, source := PairSpace.space, target := coordinates Block.total].laws Coordinates.isomorphism).rightInverse v));
