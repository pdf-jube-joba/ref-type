\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Clutching[n := m, X := X, baseSpace := baseSpace, U := U, V := V, openU := openU, openV := openV, covers := covers].Identity[] \as Line;
\import \parent.Sum[m := m, h := Line.identity, continuousH := Line.continuous] \as Added;
\import Bundles.Trivial[X := X, n := m, baseSpace := baseSpace] \as Trivial;
\import Operations.DirectSum[X := X, F := Fiber, G := (\fun (x: X) => Vector m), left := bundle, right := Trivial.bundle] \as Sum;
\definition SumFiber[x: X]: \Set := Sum.Fiber x;
\definition sumBundle: Bundles.Family[X := X, F := SumFiber].Bundle := Sum.bundle (\refl(baseSpace));
\import Operations.DirectSumIsomorphisms[X := X, F := Fiber, G := (\fun (x: X) => Vector m), A := Fiber, B := Line.Fiber,
  first := bundle, second := Trivial.bundle, newFirst := bundle, newSecond := Line.bundle, sameSource := \refl(baseSpace), sameTarget := \refl(baseSpace)] \as AddComparison;
\import Operations.IdentityIsomorphism[X := X, F := Fiber, bundle := bundle] \as Identity;
\import Bundles.Isomorphisms[X := X, F := Fiber, G := Fiber, source := bundle, target := bundle] \as Self;
\definition fixedExists: \exists Self.Isomorphism := \exact(Identity.isomorphism, Self.Isomorphism);
\import Operations.IsomorphismComposition[X := X, F := SumFiber, G := Added.SumFiber, H := Added.NewFiber, source := sumBundle, middle := Added.sumBundle, target := Added.newBundle] \as Compose;
\definition StableFiber[x: X]: \Set := Added.NewFiber x;
\definition stableBundle: Bundles.Family[X := X, F := StableFiber].Bundle := Added.newBundle;
\definition Isomorphism: \Set := Bundles.Isomorphisms[X := X, F := SumFiber, G := StableFiber, source := sumBundle, target := stableBundle].Isomorphism;
\definition isomorphismExists: \exists Isomorphism := Compose.exists (AddComparison.exists fixedExists Line.isomorphismExists) Added.isomorphismExists;
