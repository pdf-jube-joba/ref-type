\definition point[p: Point]: \Cast[X] overlap := \into[X](base p, overlap) \by { both p };
\definition pointContinuous: topology.Continuity[A := Point, B := \Cast[X] overlap].Continuous source overlapTopology point :=
  topology.Continuity[A := Point, B := X].Corestriction[S := overlap].corestrictContinuous source baseSpace point baseContinuous;
\definition h[p: Point]: Units.Carrier := g (point p);
\definition hContinuous: topology.Continuity[A := Point, B := Units.Carrier].Continuous source Units.topology h :=
  topology.Composition[A := Point, B := \Cast[X] overlap, C := Units.Carrier].composeContinuous source overlapTopology Units.topology point g pointContinuous continuous;
\definition globalEquality: (\fun (p: Point) => global (base p)) = h :=
  \axiom:funext((\fun (p: Point) => global (base p)), h, \fun (p: Point) => Extend.inside g Units.identity (point p));
\definition globalContinuous: topology.Continuity[A := Point, B := Units.Carrier].Continuous source Units.topology (\fun (p: Point) => global (base p)) :=
  \idelim h = (\fun (p: Point) => global (base p)) \with f: (Point -> Units.Carrier) => topology.Continuity[A := Point, B := Units.Carrier].Continuous source Units.topology f \by {
    base: hContinuous, equality: sym!{{Point -> Units.Carrier}} _ _ globalEquality
  };
\definition forward: topology.Continuity[A := Point, B := End.Map].Continuous source Operators.topology (\fun (p: Point) => global (base p)) :=
  topology.Composition[A := Point, B := Units.Carrier, C := End.Map].composeContinuous source Units.topology Operators.topology (\fun (p: Point) => global (base p)) Units.include globalContinuous Units.inclusionContinuous;
\definition backward: topology.Continuity[A := Point, B := End.Map].Continuous source Operators.topology (\fun (p: Point) => Units.inverse (global (base p))) :=
  topology.Composition[A := Point, B := Units.Carrier, C := End.Map].composeContinuous source Units.topology Operators.topology (\fun (p: Point) => global (base p)) Units.inverse globalContinuous Units.inverseContinuous;
