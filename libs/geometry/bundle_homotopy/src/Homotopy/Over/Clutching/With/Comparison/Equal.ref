\definition cocyclesEqual: cocycle = Other.cocycle := congr!{{Overlap -> Units.Carrier} {Cocycles.Cocycle}}
  (\fun (f: Overlap -> Units.Carrier) => \parent.\parent.\parent.Raw[g := f].cocycle) g h same;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].FromCharts[X := X, I := B.Bool^, F := Fiber, bundle := bundle, charts := chart] \as From;
\definition transitions: \forall (x: X)(i, j: Cocycles.Index x)(v: Vector n) -> (Other.cocycle.transition x i j).forward.apply v =
  ((chart j).frame (From.center x j)).forward.apply (((chart i).frame (From.center x i)).backward.apply v) :=
  \fun (x: X)(i, j: Cocycles.Index x)(v: Vector n) => trans!{{Vector n}} _ _ _
    (congr!{Cocycles.Data {Vector n}} (\fun (c: Cocycles.Data) => (c.transition x i j).forward.apply v) _ _ (sym!{{Cocycles.Data}} _ _ cocyclesEqual))
    (sym!{{Vector n}} _ _ (Constructed.At[x := x].Frame[i := i].assembledValue v j));
\import From.With[cocycle := Other.cocycle, regular := Other.regular, transition := transitions] \as Comparison;
\definition exists: \exists Isomorphism := \block {
  \takefrom result: Comparison.For[c := Other.cocycle, r := Other.regular].Result \by Comparison.exists \then
  \return \exact(result.value, Isomorphism)
};
