\import Positive.WithMatrix[H := gauge.positive, regular := gauge.positiveContinuous] \as Left;
\import Negative.WithMatrix[H := gauge.negative, regular := gauge.negativeContinuous] \as Right;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ClosedCover[X := X, F := Fiber, G := Other.Fiber, baseSpace := baseSpace,
  source := bundle, target := Other.bundle, sourceBase := \refl(baseSpace), targetBase := \refl(baseSpace), C := C, D := D,
  closedC := closedC, closedD := closedD, covers := covered] \as Glue;
\module At(x: X, inC: \In[X] C x, inD: \In[X] D x);
\definition agrees: \forall (x: X)(inC: \In[X] C x)(inD: \In[X] D x)(v: Fiber x) ->
  (Left.isomorphism.forward.fiber (\into[X](x, C) \by { inC })).apply v = (Right.isomorphism.forward.fiber (\into[X](x, D) \by { inD })).apply v :=
  \fun (x: X)(inC: _)(inD: _) => At[x := x, inC := inC, inD := inD].agrees;
\definition value: Isomorphism := Glue.With[left := Left.isomorphism, right := Right.isomorphism, agrees := agrees].isomorphism;
