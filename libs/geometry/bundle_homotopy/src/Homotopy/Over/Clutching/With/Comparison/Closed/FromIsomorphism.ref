\import Positive.FromIsomorphism[iso := iso] \as Left;
\import Negative.FromIsomorphism[iso := iso] \as Right;
\module At(x: X, inC: \In[X] C x, inD: \In[X] D x);
\definition compatible: \forall (x: X)(inC: \In[X] C x)(inD: \In[X] D x)(v: Vector n) ->
  (Right.value (\into[X](x, D) \by { inD })).apply ((g (overlapPoint x inC inD)).apply v) =
  (h (overlapPoint x inC inD)).apply ((Left.value (\into[X](x, C) \by { inC })).apply v) :=
  \fun (x: X)(inC: _)(inD: _) => At[x := x, inC := inC, inD := inD].compatible;
\definition value: Gauge := Gauge { positive := Left.value, negative := Right.value, positiveContinuous := Left.regular, negativeContinuous := Right.regular, compatible := compatible };
