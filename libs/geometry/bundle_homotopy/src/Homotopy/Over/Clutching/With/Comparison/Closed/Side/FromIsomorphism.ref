\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].PullbackIsomorphism[X := X, F := Fiber, G := Other.Fiber, first := bundle, second := Other.bundle, iso := iso,
  Y := Carrier, source := topology, f := include, regularFirst := continuous, regularSecond := continuous] \as Pulled;
\import Operations.IsomorphismComposition[X := Carrier, F := (\fun (x: Carrier) => Vector n), G := (\fun (x: Carrier) => Fiber x), H := (\fun (x: Carrier) => Other.Fiber x),
  source := Bundles.Trivial[X := Carrier, n := n, baseSpace := topology].bundle, middle := sourceBundle, target := targetBundle] \as First;
\import Operations.IsomorphismComposition[X := Carrier, F := (\fun (x: Carrier) => Vector n), G := (\fun (x: Carrier) => Other.Fiber x), H := (\fun (x: Carrier) => Vector n),
  source := Bundles.Trivial[X := Carrier, n := n, baseSpace := topology].bundle, middle := targetBundle, target := Bundles.Trivial[X := Carrier, n := n, baseSpace := topology].bundle] \as Second;
\definition isomorphism: Bundles.Isomorphisms[X := Carrier, F := (\fun (x: Carrier) => Vector n), G := (\fun (x: Carrier) => Vector n), source := Bundles.Trivial[X := Carrier, n := n, baseSpace := topology].bundle, target := Bundles.Trivial[X := Carrier, n := n, baseSpace := topology].bundle].Isomorphism :=
  Second.compose (First.compose (SourceComparison.inverse Source.isomorphism) Pulled.isomorphism) Target.isomorphism;
\import Units.FromIsomorphism[X := Carrier, baseSpace := topology, iso := isomorphism] \as Matrix;
\definition value[x: Carrier]: Units.Carrier := Matrix.value x;
\definition regular: topology.Continuity[A := Carrier, B := Units.Carrier].Continuous topology Units.topology value := Matrix.continuous;
\definition point[x: Carrier]: \Cast[X] (domain i) := \into[X](x, domain i) \by { inside x };
\definition formula: \forall (x: Carrier)(v: Vector n) -> (value x).apply v = ((Other.chart i).frame (point x)).forward.apply ((iso.forward.fiber x).apply (((chart i).frame (point x)).backward.apply v)) := \fun (x: Carrier)(v: Vector n) => \refl((value x).apply v);
