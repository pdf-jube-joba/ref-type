\definition UY: \Pow Y := { y: Y \where \In[X] U (f y) };
\definition VY: \Pow Y := { y: Y \where \In[X] V (f y) };
\definition openUY: topology.Topology[Carrier := Y].IsOpenIn source UY := continuousF U openU;
\definition openVY: topology.Topology[Carrier := Y].IsOpenIn source VY := continuousF V openV;
\definition covered: \forall (y: Y) -> Logic.Or[\In[Y] UY y, \In[Y] VY y] := \fun (y: Y) => covers (f y);
\definition overlapY: \Pow Y := { y: Y \where Logic.And[\In[Y] UY y, \In[Y] VY y] };
\definition OverlapY: \Set := \Cast[Y] overlapY;
\definition overlapTopologyY: topology.Topology[Carrier := OverlapY].Topology := topology.Topology[Carrier := Y].Subspace[S := overlapY].topology source;
\definition overlapMap[y: OverlapY]: \Cast[X] overlap := \into[X](f y, overlap) \by { \bysub(Y, overlapY, y) };
\definition overlapContinuous: topology.Continuity[A := OverlapY, B := \Cast[X] overlap].Continuous overlapTopologyY overlapTopology overlapMap :=
  topology.Continuity[A := OverlapY, B := X].Corestriction[S := overlap].corestrictContinuous overlapTopologyY baseSpace overlapMap
    (topology.Continuity[A := Y, B := X].Restriction[S := overlapY].restrictContinuous source baseSpace f continuousF);
\definition pulledG[y: OverlapY]: Units.Carrier := g (overlapMap y);
\definition pulledContinuous: topology.Continuity[A := OverlapY, B := Units.Carrier].Continuous overlapTopologyY Units.topology pulledG :=
  topology.Composition[A := OverlapY, B := \Cast[X] overlap, C := Units.Carrier].composeContinuous overlapTopologyY overlapTopology Units.topology overlapMap g overlapContinuous continuous;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Clutching[n := n, X := Y, baseSpace := source, U := UY, V := VY, openU := openUY, openV := openVY, covers := covered].With[g := pulledG, continuous := pulledContinuous] \as Other;
\import Bundles.Family[X := X, F := Fiber].Of[bundle := bundle].Pullback[Y := Y, source := source, f := f] \as Pulled;
\definition PulledFiber[y: Y]: \Set := Fiber (f y);
\definition pulledBundle: Bundles.Family[X := Y, F := PulledFiber].Bundle := Pulled.pulled continuousF;
\definition charts[i: B.Bool^]: Bundles.Family[X := Y, F := PulledFiber].With[data := pulledBundle].Chart := Pulled.In[c := chart i].trivialization continuousF;
\import std.Set[].Extension[A := Y, B := Units.Carrier, domain := overlapY] \as ExtendY;
\definition globalEquality: \forall (y: OverlapY) -> Other.global y = global (f y) := \fun (y: OverlapY) =>
  trans!{{Units.Carrier}} _ _ _ (ExtendY.inside pulledG Units.identity y) (sym!{{Units.Carrier}} _ _ (Extend.inside g Units.identity (overlapMap y)));
\definition domainY[i: B.Bool^]: \Pow Y := (charts i).domain;
\module Point(y: Y);
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].FromCharts[X := Y, I := B.Bool^, F := PulledFiber, bundle := pulledBundle, charts := charts] \as From;
\definition transitions: \forall (y: Y)(i, j: Operations.Cocycle[X := Y, I := B.Bool^, baseSpace := source, domain := domainY, dimension := dimension].Index y)(v: Vector n) ->
  (Other.cocycle.transition y i j).forward.apply v = ((charts j).frame (From.center y j)).forward.apply (((charts i).frame (From.center y i)).backward.apply v) :=
  \fun (y: Y)(i, j: Operations.Cocycle[X := Y, I := B.Bool^, baseSpace := source, domain := domainY, dimension := dimension].Index y)(v: Vector n) =>
    trans!{{Vector n}} _ _ _ (Point[y := y].rawEqual i j (\bysub(B.Bool^, { i: B.Bool^ \where \In[Y] (domainY i) y }, i)) (\bysub(B.Bool^, { i: B.Bool^ \where \In[Y] (domainY i) y }, j)) v)
      (sym!{{Vector n}} _ _ (Constructed.At[x := f y].Frame[i := i].assembledValue v j));
\import From.With[cocycle := Other.cocycle, regular := Other.regular, transition := transitions] \as Comparison;
\definition OtherFiber[y: Y]: \Set := Other.Fiber y;
\definition otherBundle: Bundles.Family[X := Y, F := OtherFiber].Bundle := Other.bundle;
\definition Isomorphism: \Set := Bundles.Isomorphisms[X := Y, F := PulledFiber, G := OtherFiber, source := pulledBundle, target := otherBundle].Isomorphism;
\definition isomorphismExists: \exists Isomorphism := \block {
  \takefrom result: Comparison.For[c := Other.cocycle, r := Other.regular].Result \by Comparison.exists \then
  \return \exact(result.value, Isomorphism)
};
