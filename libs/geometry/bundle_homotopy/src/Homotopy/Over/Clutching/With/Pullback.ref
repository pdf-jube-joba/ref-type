\definition UY: \Pow Y := { y: Y \where \In[X] U (f y) };
\definition VY: \Pow Y := { y: Y \where \In[X] V (f y) };
\definition openUY: topology.Topology[Carrier := Y].IsOpenIn source UY := continuousF U openU;
\definition openVY: topology.Topology[Carrier := Y].IsOpenIn source VY := continuousF V openV;
\definition covered: \forall (y: Y) -> Logic.Or[\In[Y] UY y, \In[Y] VY y] := \fun (y: Y) => covers (f y);
\definition containedU: \forall (y: \Cast[Y] UY) -> \In[X] U (f y) := \fun (y: \Cast[Y] UY) => \bysub(Y, UY, y);
\definition containedV: \forall (y: \Cast[Y] VY) -> \In[X] V (f y) := \fun (y: \Cast[Y] VY) => \bysub(Y, VY, y);
\import \parent.AlongCover[Y := Y, source := source, f := f, continuousF := continuousF, UY := UY, VY := VY, openUY := openUY, openVY := openVY, covered := covered, containedU := containedU, containedV := containedV] \as Along;
\definition PulledFiber[y: Y]: \Set := Along.PulledFiber y;
\definition pulledBundle: Bundles.Family[X := Y, F := PulledFiber].Bundle := Along.pulledBundle;
\definition OtherFiber[y: Y]: \Set := Along.OtherFiber y;
\definition otherBundle: Bundles.Family[X := Y, F := OtherFiber].Bundle := Along.otherBundle;
\definition Isomorphism: \Set := Bundles.Isomorphisms[X := Y, F := PulledFiber, G := OtherFiber, source := pulledBundle, target := otherBundle].Isomorphism;
\definition isomorphismExists: \exists Isomorphism := Along.isomorphismExists;
