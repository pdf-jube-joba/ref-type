\definition positive: Positive.Carrier := \into[X](x, C) \by { inC };
\definition negative: Negative.Carrier := \into[X](x, D) \by { inD };
\definition point: Overlap := overlapPoint x inC inD;
\import \parent.\parent.\parent.\parent.Boundary[x := point] \as SourceFrame;
\import Other.Boundary[x := point] \as TargetFrame;
\definition agrees: \forall (v: Fiber x) -> (Left.isomorphism.forward.fiber positive).apply v = (Right.isomorphism.forward.fiber negative).apply v :=
  \fun (v: Fiber x) => Spaces.Isomorphism[V := Other.Fiber x, W := Vector n, source := Other.bundle.space x, target := coordinates n].injective
    ((Other.chart B.Bool^::true).frame TargetFrame.rightPoint) _ _ (eq_reason_in!{{Vector n} _
      "=" { (h point).apply ((gauge.positive positive).apply (((chart B.Bool^::false).frame SourceFrame.leftPoint).forward.apply v)) } "by" {
        TargetFrame.transition ((gauge.positive positive).apply (((chart B.Bool^::false).frame SourceFrame.leftPoint).forward.apply v))
      }
      "=" { (gauge.negative negative).apply ((g point).apply (((chart B.Bool^::false).frame SourceFrame.leftPoint).forward.apply v)) } "by" {
        sym!{{Vector n}} _ _ (gauge.compatible x inC inD (((chart B.Bool^::false).frame SourceFrame.leftPoint).forward.apply v))
      }
      "=" { (gauge.negative negative).apply (((chart B.Bool^::true).frame SourceFrame.rightPoint).forward.apply v) } "by" {
        congr!{{Vector n} {Vector n}} (gauge.negative negative).apply _ _ (sym!{{Vector n}} _ _ (SourceFrame.onFiber v))
      }
      "=" _ "by" {
        sym!{{Vector n}} _ _ ((Spaces.Isomorphism[V := Other.Fiber x, W := Vector n, source := Other.bundle.space x, target := coordinates n].laws ((Other.chart B.Bool^::true).frame TargetFrame.rightPoint)).rightInverse
          ((gauge.negative negative).apply (((chart B.Bool^::true).frame SourceFrame.rightPoint).forward.apply v)))
      }
    });
