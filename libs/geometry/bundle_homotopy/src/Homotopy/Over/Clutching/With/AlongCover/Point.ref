\definition rawEqual: \forall (i, j: B.Bool^) -> \In[Y] (domainY i) y -> \In[Y] (domainY j) y -> \forall (v: Vector n) ->
  (Other.change y i j).forward.apply v = (change (f y) i j).forward.apply v :=
  B.cases2 (\fun (i, j: B.Bool^) => \In[Y] (domainY i) y -> \In[Y] (domainY j) y -> \forall (v: Vector n) -> (Other.change y i j).forward.apply v = (change (f y) i j).forward.apply v)
    (\fun (first: \In[Y] UY y)(second: \In[Y] UY y)(v: Vector n) => \refl(v))
    (\fun (first: \In[Y] UY y)(second: \In[Y] VY y)(v: Vector n) =>
      congr!{{Units.Carrier} {Vector n}} (\fun (h: Units.Carrier) => h.apply v) _ _ (globalEquality (\into[Y](y, overlapY) \by { Logic.And[_, _]::# first second })))
    (\fun (first: \In[Y] VY y)(second: \In[Y] UY y)(v: Vector n) =>
      congr!{{Units.Carrier} {Vector n}} (\fun (h: Units.Carrier) => (Units.inverse h).apply v) _ _ (globalEquality (\into[Y](y, overlapY) \by { Logic.And[_, _]::# second first })))
    (\fun (first: \In[Y] VY y)(second: \In[Y] VY y)(v: Vector n) => \refl(v));
