\import \parent.\parent.With[g := h, continuous := continuousH] \as Other;
\definition Isomorphism: \Set := Bundles.Isomorphisms[X := X, F := Fiber, G := Other.Fiber, source := bundle, target := Other.bundle].Isomorphism;
\module Equal(same: g = h);
\definition ofEquality: g = h -> \exists Isomorphism := \fun (same: g = h) => Equal[same := same].exists;
\module Closed(C, D: \Pow X, closedC: Base.IsClosedIn baseSpace C, closedD: Base.IsClosedIn baseSpace D,
  covered: \forall (x: X) -> Logic.Or[\In[X] C x, \In[X] D x],
  insideC: \forall (x: \Cast[X] C) -> \In[X] U x, insideD: \forall (x: \Cast[X] D) -> \In[X] V x);
