\import \parent.\parent.With[g := h, continuous := continuousH] \as Other;
\definition Isomorphism: \Set := Bundles.Isomorphisms[X := X, F := Fiber, G := Other.Fiber, source := bundle, target := Other.bundle].Isomorphism;
\module For(f: Overlap -> Units.Carrier, regularF: topology.Continuity[A := Overlap, B := Units.Carrier].Continuous overlapTopology Units.topology f);
\definition ofEquality: g = h -> \exists Isomorphism := \fun (same: g = h) =>
  (\idelim g = h \with f: (Overlap -> Units.Carrier) => \forall (regularF: topology.Continuity[A := Overlap, B := Units.Carrier].Continuous overlapTopology Units.topology f) ->
    \exists For[f := f, regularF := regularF].Result \by {
      base: \fun (regularF: topology.Continuity[A := Overlap, B := Units.Carrier].Continuous overlapTopology Units.topology g) => \exact(Bundles.Isomorphisms[X := X, F := Fiber, G := Fiber, source := bundle, target := bundle].Isomorphism {
        forward := Bundles.Identity[X := X, F := Fiber, bundle := bundle].map,
        backward := Bundles.Identity[X := X, F := Fiber, bundle := bundle].map,
        leftInverse := \fun (x: X)(v: Fiber x) => \refl(v), rightInverse := \fun (x: X)(v: Fiber x) => \refl(v),
      }, Bundles.Isomorphisms[X := X, F := Fiber, G := Fiber, source := bundle, target := bundle].Isomorphism),
      equality: same
    }) continuousH;
\module Closed(C, D: \Pow X, closedC: Base.IsClosedIn baseSpace C, closedD: Base.IsClosedIn baseSpace D,
  covered: \forall (x: X) -> Logic.Or[\In[X] C x, \In[X] D x],
  insideC: \forall (x: \Cast[X] C) -> \In[X] U x, insideD: \forall (x: \Cast[X] D) -> \In[X] V x);
