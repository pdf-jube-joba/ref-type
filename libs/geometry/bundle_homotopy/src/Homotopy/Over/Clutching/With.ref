\import std.Set[].Extension[A := X, B := Units.Carrier, domain := overlap] \as Extend;
\import Spaces.Isomorphism[V := Vector n, W := Vector n, source := coordinates n, target := coordinates n] \as Linear;
\import \parent.Raw[g := g] \as Raw;
\definition global: X -> Units.Carrier := Raw.global;
\definition identity: Linear.Isomorphism := Raw.identity;
\definition inverse: Units.Carrier -> Linear.Isomorphism := Raw.inverse;
\definition change: X -> B.Bool^ -> B.Bool^ -> Linear.Isomorphism := Raw.change;
\definition identityLaw: \forall (x: X)(i: B.Bool^)(v: Vector n) -> (change x i i).forward.apply v = v := Raw.identityLaw;
\definition compositionLaw: \forall (x: X)(i, j, k: B.Bool^)(v: Vector n) -> (change x j k).forward.apply ((change x i j).forward.apply v) = (change x i k).forward.apply v := Raw.compositionLaw;
\definition data: Cocycles.Data := Raw.data;
\definition cocycle: Cocycles.Cocycle := Raw.cocycle;
\import Cocycles.With[cocycle := cocycle] \as Constructed;
\definition Fiber[x: X]: \Set := Constructed.Fiber x;
\module Regularity;

\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Constructed.Construction[].bundle Regularity[].regular;
\import Operations.Atlas[X := X, I := B.Bool^, F := Fiber, baseSpace := baseSpace, space := Constructed.fiberSpace].Using[chart := Constructed.chart] \as Atlas;
\definition chart[i: B.Bool^]: Bundles.Family[X := X, F := Fiber].With[data := bundle].Chart :=
  Atlas.Local[i := i].trivialization (Constructed.Construction[].compatible Regularity[].regular);
\module Boundary(x: Overlap);

\definition regular: Constructed.Regular := Regularity[].regular;
\module Pullback(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  continuousF: topology.Continuity[A := Y, B := X].Continuous source baseSpace f);

\module AlongCover(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  continuousF: topology.Continuity[A := Y, B := X].Continuous source baseSpace f,
  UY, VY: \Pow Y, openUY: topology.Topology[Carrier := Y].IsOpenIn source UY, openVY: topology.Topology[Carrier := Y].IsOpenIn source VY,
  covered: \forall (y: Y) -> Logic.Or[\In[Y] UY y, \In[Y] VY y],
  containedU: \forall (y: \Cast[Y] UY) -> \In[X] U (f y), containedV: \forall (y: \Cast[Y] VY) -> \In[X] V (f y));

\module Sum(m: N.Nat^,
  h: Overlap -> \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projections[n := m].Operators[].Units[].Carrier,
  continuousH: topology.Continuity[A := Overlap, B := \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projections[n := m].Operators[].Units[].Carrier].Continuous overlapTopology
    \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projections[n := m].Operators[].Units[].topology h);
\module Stabilize(m: N.Nat^);

\module Comparison(h: Overlap -> Units.Carrier, continuousH: topology.Continuity[A := Overlap, B := Units.Carrier].Continuous overlapTopology Units.topology h);
