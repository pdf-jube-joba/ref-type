\import Bundles.Family[X := Y, F := F] \as Original;
\module Pullbacks(X: \Set, source: topology.Topology[Carrier := X].Topology, compact: topology.Topology[Carrier := X].IsCompact source,
  hausdorff: topology.Topology[Carrier := X].IsT2 source);

\module Extensions(A: \Pow Y,
  cofibration: algebraic_topology.Cofibration[A := Y, subset := A].IsCofibration bundle.baseSpace,
  compact: topology.Topology[Carrier := Y].IsCompact bundle.baseSpace,
  hausdorff: topology.Topology[Carrier := Y].IsT2 bundle.baseSpace);

\module Contractible(compact: topology.Topology[Carrier := Y].IsCompact bundle.baseSpace,
  hausdorff: topology.Topology[Carrier := Y].IsT2 bundle.baseSpace, point: Y,
  contraction: algebraic_topology.Homotopy[A := Y, B := Y].Homotopy[bundle.baseSpace, bundle.baseSpace, (\fun (y: Y) => y), (\fun (y: Y) => point)]);
