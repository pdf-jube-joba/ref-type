\import Hermitian.At[n := n] \as Native;
\import Spaces.Linear[V := Vector n, W := Vector n, source := coordinates n, target := coordinates n] \as End;
\definition valueOf[v: Vector n]: Vector n := v;
\module Between(P, Q: Native.Projection);
\definition diagonal: \forall (P: Native.Projection)(v: Vector n) -> Between[P := P, Q := P].h.apply v = v :=
  \fun (P: Native.Projection)(v: Vector n) => trans!{{Vector n}} _ _ _
    (congr!{{Vector n} {Vector n} {Vector n}} (coordinates n).add _ _ _ _ (P.idempotent v) ((Native.OnProjection[P := P].complement).idempotent v)) (Native.OnProjection[P := P].splitting v);
\module Gap(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology, P, Q: X -> Native.Projection,
  regularP: Native.Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (P x).map),
  regularQ: Native.Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (Q x).map));
\module Homotopy(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact baseSpace,
  P: Pair.Times^[algebraic_topology.Interval[].Carrier, X] -> Native.Projection,
  regular: Native.Families[X := Pair.Times^[algebraic_topology.Interval[].Carrier, X]].Matrix[m := n].Regular
    (topological_constructions.Product[A := algebraic_topology.Interval[].Carrier, B := X].topology algebraic_topology.Interval[].topology baseSpace)
    (\fun (p: Pair.Times^[algebraic_topology.Interval[].Carrier, X]) => (P p).map),
  A: \Pow X, stationary: \forall (x: X) -> \In[X] A x -> \forall (s, t: algebraic_topology.Interval[].Carrier) ->
    (P (Pair.pair algebraic_topology.Interval[].Carrier X s x)).map = (P (Pair.pair algebraic_topology.Interval[].Carrier X t x)).map);
\module Operators;

\module ImageAutomorphism(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology,
  P: X -> Native.Projection, regular: Native.Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (P x).map),
  a: Bundles.Isomorphisms[X := X, F := Complements.Projection[X := X, n := n, baseSpace := baseSpace, P := P, regular := regular].Fiber,
    G := Complements.Projection[X := X, n := n, baseSpace := baseSpace, P := P, regular := regular].Fiber,
    source := Complements.Projection[X := X, n := n, baseSpace := baseSpace, P := P, regular := regular].bundle,
    target := Complements.Projection[X := X, n := n, baseSpace := baseSpace, P := P, regular := regular].bundle].Isomorphism);

\module Moved(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology,
  P: X -> Native.Projection, regular: Native.Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (P x).map),
  H: X -> Operators[].Units[].Carrier,
  continuous: topology.Continuity[A := X, B := Operators[].Units[].Carrier].Continuous baseSpace Operators[].Units[].topology H);

\module EqualImages(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology,
  P, Q: X -> Native.Projection,
  regularP: Native.Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (P x).map),
  regularQ: Native.Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (Q x).map),
  same: \forall (x: X) -> (P x).map = (Q x).map);
\module Isotopy(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact baseSpace,
  P: Pair.Times^[algebraic_topology.Interval[].Carrier, X] -> Native.Projection,
  regular: Native.Families[X := Pair.Times^[algebraic_topology.Interval[].Carrier, X]].Matrix[m := n].Regular
    (topological_constructions.Product[A := algebraic_topology.Interval[].Carrier, B := X].topology algebraic_topology.Interval[].topology baseSpace)
    (\fun (p: Pair.Times^[algebraic_topology.Interval[].Carrier, X]) => (P p).map),
  A: \Pow X, stationary: \forall (x: X) -> \In[X] A x -> \forall (s, t: algebraic_topology.Interval[].Carrier) ->
    (P (Pair.pair algebraic_topology.Interval[].Carrier X s x)).map = (P (Pair.pair algebraic_topology.Interval[].Carrier X t x)).map);
