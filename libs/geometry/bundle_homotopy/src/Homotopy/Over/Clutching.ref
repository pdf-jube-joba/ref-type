\import std.Data[].Bool[] \as B;
\import topology.Topology[Carrier := X] \as Base;
\import \parent.Projections[n := n].Operators[].Units[] \as Units;
\definition domain: B.Bool^ -> \Pow X := \induction (b: B.Bool^) \return \Pow X \with { | false: U | true: V };
\definition dimension[i: B.Bool^]: N.Nat^ := n;
\definition overlap: \Pow X := { x: X \where Logic.And[\In[X] U x, \In[X] V x] };
\definition Overlap: \Set := \Cast[X] overlap;
\definition overlapTopology: topology.Topology[Carrier := Overlap].Topology := Base.Subspace[S := overlap].topology baseSpace;
\import Operations.Cocycle[X := X, I := B.Bool^, baseSpace := baseSpace, domain := domain, dimension := dimension] \as Cocycles;
\module With(g: Overlap -> Units.Carrier,
  continuous: topology.Continuity[A := Overlap, B := Units.Carrier].Continuous overlapTopology Units.topology g);
