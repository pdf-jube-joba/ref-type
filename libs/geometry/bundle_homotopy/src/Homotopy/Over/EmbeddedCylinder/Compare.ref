\import \parent.Endpoint[t := I.start] \as Start;
\import \parent.Endpoint[t := I.end] \as Finish;
\import Motion.Slice[t := I.start] \as NativeStart;
\import Motion.Slice[t := I.end] \as NativeFinish;
\import Operations.IsomorphismComposition[X := X, F := Start.Fiber, G := NativeStart.Fiber, H := NativeFinish.Fiber,
  source := Start.bundle, middle := NativeStart.bundle, target := NativeFinish.bundle] \as First;
\import Operations.IsomorphismComposition[X := X, F := Start.Fiber, G := NativeFinish.Fiber, H := Finish.Fiber,
  source := Start.bundle, middle := NativeFinish.bundle, target := Finish.bundle] \as Second;
\import Bundles.Isomorphisms[X := X, F := Finish.Fiber, G := NativeFinish.Fiber, source := Finish.bundle, target := NativeFinish.bundle] \as Reverse;
\definition value: Isomorphism := Second.compose (First.compose Start.comparison iso) (Reverse.inverse Finish.comparison);
