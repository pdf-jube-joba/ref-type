\import Bundles.Family[X := X, F := F] \as Source;
\import Bundles.Family[X := X, F := G] \as Target;
\definition projectionContinuous: topology.Continuity[A := Source.Point, B := X].Continuous source.totalSpace baseSpace Source.projection :=
  \idelim source.baseSpace = baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Continuity[A := Source.Point, B := X].Continuous source.totalSpace t Source.projection \by {
    base: Source.Of[bundle := source].projectionContinuous, equality: sourceBase
  };
\definition sourceRegular: topology.Continuity[A := X, B := X].Continuous baseSpace source.baseSpace (\fun (x: X) => x) :=
  \idelim baseSpace = source.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Continuity[A := X, B := X].Continuous baseSpace t (\fun (x: X) => x) \by {
    base: topology.Maps[A := X, B := X].Identity[].continuous baseSpace, equality: sym!{{topology.Topology[Carrier := X].Topology}} _ _ sourceBase
  };
\definition targetRegular: topology.Continuity[A := X, B := X].Continuous baseSpace target.baseSpace (\fun (x: X) => x) :=
  \idelim baseSpace = target.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Continuity[A := X, B := X].Continuous baseSpace t (\fun (x: X) => x) \by {
    base: topology.Maps[A := X, B := X].Identity[].continuous baseSpace, equality: sym!{{topology.Topology[Carrier := X].Topology}} _ _ targetBase
  };
\module Side(S: \Pow X);
\import Side[S := C] \as Left;
\import Side[S := D] \as Right;
\module With(fiber: \forall (x: X) -> Spaces.Linear[V := F x, W := G x, source := source.space x, target := target.space x].Map,
  left: Left.Map, right: Right.Map,
  matchesLeft: \forall (x: \Cast[X] C)(v: F x) -> (fiber x).apply v = (left.fiber x).apply v,
  matchesRight: \forall (x: \Cast[X] D)(v: F x) -> (fiber x).apply v = (right.fiber x).apply v);
