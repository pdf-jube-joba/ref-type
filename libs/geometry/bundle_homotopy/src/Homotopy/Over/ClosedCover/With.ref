\module At(x: X);
\definition chosen[x: X]: At[x := x].Candidate := \choice At[x := x].Candidate \by { existence: At[x := x].exists, uniqueness: At[x := x].unique };
\definition forward[x: X]: Spaces.Linear[V := F x, W := G x, source := source.space x, target := target.space x].Map := (chosen x).forward;
\definition backward[x: X]: Spaces.Linear[V := G x, W := F x, source := target.space x, target := source.space x].Map := (chosen x).backward;
\definition matchesLeftForward: \forall (x: \Cast[X] C)(v: F x) -> (forward x).apply v = (left.forward.fiber x).apply v :=
  \fun (x: \Cast[X] C)(v: F x) => congr!{{Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].Isomorphism} {G x}}
    (\fun (iso: Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].Isomorphism) => iso.forward.apply v) _ _
    ((At[x := x].conditions (chosen x)).left (\bysub(X, C, x)));
\definition matchesRightForward: \forall (x: \Cast[X] D)(v: F x) -> (forward x).apply v = (right.forward.fiber x).apply v :=
  \fun (x: \Cast[X] D)(v: F x) => congr!{{Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].Isomorphism} {G x}}
    (\fun (iso: Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].Isomorphism) => iso.forward.apply v) _ _
    ((At[x := x].conditions (chosen x)).right (\bysub(X, D, x)));
\definition matchesLeftBackward: \forall (x: \Cast[X] C)(v: G x) -> (backward x).apply v = (left.backward.fiber x).apply v :=
  \fun (x: \Cast[X] C)(v: G x) => congr!{{Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].Isomorphism} {F x}}
    (\fun (iso: Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].Isomorphism) => iso.backward.apply v) _ _
    ((At[x := x].conditions (chosen x)).left (\bysub(X, C, x)));
\definition matchesRightBackward: \forall (x: \Cast[X] D)(v: G x) -> (backward x).apply v = (right.backward.fiber x).apply v :=
  \fun (x: \Cast[X] D)(v: G x) => congr!{{Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].Isomorphism} {F x}}
    (\fun (iso: Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].Isomorphism) => iso.backward.apply v) _ _
    ((At[x := x].conditions (chosen x)).right (\bysub(X, D, x)));
\definition isomorphism: Bundles.Isomorphisms[X := X, F := F, G := G, source := source, target := target].Isomorphism :=
  Bundles.Isomorphisms[X := X, F := F, G := G, source := source, target := target].Isomorphism {
    forward := Forward.With[fiber := forward, left := left.forward, right := right.forward, matchesLeft := matchesLeftForward, matchesRight := matchesRightForward].map,
    backward := Backward.With[fiber := backward, left := left.backward, right := right.backward, matchesLeft := matchesLeftBackward, matchesRight := matchesRightBackward].map,
    leftInverse := (\fun (x: X) => (Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].laws (chosen x)).leftInverse),
    rightInverse := (\fun (x: X) => (Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].laws (chosen x)).rightInverse)
  };
