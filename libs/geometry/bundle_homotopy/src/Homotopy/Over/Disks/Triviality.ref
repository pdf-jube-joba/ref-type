\import Disk.Compactness[] \as Compactness;
\import Disk.Contraction[] \as Contraction;
\import topology.Topology[Carrier := Disk.Disk] \as Space;
\definition compact: Space.IsCompact bundle.baseSpace := \idelim Disk.diskTopology = bundle.baseSpace \with t: Space.Topology => Space.IsCompact t \by { base: Compactness.compact, equality: sym!{{Space.Topology}} _ _ sameBase };
\definition diskHausdorff: Space.IsT2 Disk.diskTopology := topology.Topology[Carrier := Disk.Coordinate].Subspace[S := Disk.ClosedBall].Properties[].hausdorff Disk.topology Compactness.hausdorff;
\definition hausdorff: Space.IsT2 bundle.baseSpace := \idelim Disk.diskTopology = bundle.baseSpace \with t: Space.Topology => Space.IsT2 t \by { base: diskHausdorff, equality: sym!{{Space.Topology}} _ _ sameBase };
\import algebraic_topology.Homotopy[A := Disk.Disk, B := Disk.Disk] \as Homotopies;
\definition contraction: Homotopies.Homotopy[bundle.baseSpace, bundle.baseSpace, (\fun (v: Disk.Disk) => v), (\fun (v: Disk.Disk) => Contraction.origin)] :=
  \idelim Disk.diskTopology = bundle.baseSpace \with t: Space.Topology => Homotopies.Homotopy[t, t, (\fun (v: Disk.Disk) => v), (\fun (v: Disk.Disk) => Contraction.origin)] \by {
    base: Contraction.homotopy, equality: sym!{{Space.Topology}} _ _ sameBase
  };
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].For[Y := Disk.Disk, F := F, bundle := bundle].Contractible[compact := compact, hausdorff := hausdorff, point := Contraction.origin, contraction := contraction] \as Constructed;
\definition Result: \Set := Constructed.Result;
\definition exists: \exists Result := Constructed.exists;
