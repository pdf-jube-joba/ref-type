\import PositiveSide.WithMatrix[H := gauge.positive, regular := gauge.positiveContinuous] \as Left;
\import NegativeSide.WithMatrix[H := gauge.negative, regular := gauge.negativeContinuous] \as Right;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ClosedCover[X := Sphere.Sphere, F := Fiber, G := Other.Fiber, baseSpace := Sphere.sphereTopology,
  source := bundle, target := Other.bundle, sourceBase := \refl(Sphere.sphereTopology), targetBase := \refl(Sphere.sphereTopology), C := Cover.PositiveHalf, D := Cover.NegativeHalf,
  closedC := Cover.positiveClosed, closedD := Cover.negativeClosed, covers := Cover.halvesCover] \as Glue;
\module At(x: Sphere.Sphere, inPositive: \In[Sphere.Sphere] Cover.PositiveHalf x, inNegative: \In[Sphere.Sphere] Cover.NegativeHalf x);
\definition agrees: \forall (x: Sphere.Sphere)(inPositive: \In[Sphere.Sphere] Cover.PositiveHalf x)(inNegative: \In[Sphere.Sphere] Cover.NegativeHalf x)(v: Fiber x) ->
  (Left.isomorphism.forward.fiber (\into[Sphere.Sphere](x, Cover.PositiveHalf) \by { inPositive })).apply v = (Right.isomorphism.forward.fiber (\into[Sphere.Sphere](x, Cover.NegativeHalf) \by { inNegative })).apply v :=
  \fun (x: Sphere.Sphere)(inPositive: _)(inNegative: _) => At[x := x, inPositive := inPositive, inNegative := inNegative].agrees;
\definition value: Isomorphism := Glue.With[left := Left.isomorphism, right := Right.isomorphism, agrees := agrees].isomorphism;
