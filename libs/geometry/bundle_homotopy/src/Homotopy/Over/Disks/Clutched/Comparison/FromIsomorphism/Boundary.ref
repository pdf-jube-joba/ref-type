\definition x: Sphere.Sphere := Splitting.equator s;
\definition inPositive: \In[Sphere.Sphere] Cover.PositiveHalf x := R.leReplaceRight Real.zero Real.zero (head x) (sym!{Real.Real} _ _ (Splitting.equatorHead s)) (R.leRefl Real.zero);
\definition inNegative: \In[Sphere.Sphere] Cover.NegativeHalf x := R.leReplaceLeft Real.zero (head x) Real.zero (sym!{Real.Real} _ _ (Splitting.equatorHead s)) (R.leRefl Real.zero);
\definition positive: PositiveSide.Carrier := \into[Sphere.Sphere](x, Cover.PositiveHalf) \by { inPositive };
\definition negative: NegativeSide.Carrier := \into[Sphere.Sphere](x, Cover.NegativeHalf) \by { inNegative };
\definition positiveEquality: positiveDisk (Halves.boundaryInclusion s) = Left.value positive :=
  congr!{{PositiveSide.Carrier} {Units.Carrier}} Left.value (Cover.positivePoint (Halves.boundaryInclusion s)) positive (Halves.positiveBoundary s);
\definition negativeEquality: negativeDisk (Halves.boundaryInclusion s) = Right.value negative :=
  congr!{{NegativeSide.Carrier} {Units.Carrier}} Right.value (Cover.negativePoint (Halves.boundaryInclusion s)) negative (Halves.negativeBoundary s);
\definition atBoundary: \forall (v: Vector n) -> (Right.value negative).apply ((g s).apply v) = (g2 s).apply ((Left.value positive).apply v) :=
  \fun (v: Vector n) => \idelim boundary (Cover.overlapPoint x inPositive inNegative) = s \with t: Disk.Sphere =>
    (Right.value negative).apply ((g t).apply v) = (g2 t).apply ((Left.value positive).apply v) \by {
      base: compatible x inPositive inNegative v, equality: boundaryEquator s
    };
\definition diskLaw: \forall (v: Vector n) -> (negativeDisk (Halves.boundaryInclusion s)).apply ((g s).apply v) = (g2 s).apply ((positiveDisk (Halves.boundaryInclusion s)).apply v) :=
  \fun (v: Vector n) => trans!{{Vector n}} _ _ _ (congr!{{Units.Carrier} {Vector n}} (\fun (h: Units.Carrier) => h.apply ((g s).apply v)) _ _ negativeEquality)
    (trans!{{Vector n}} _ _ _ (atBoundary v) (congr!{{Vector n} {Vector n}} (g2 s).apply _ _ (congr!{{Units.Carrier} {Vector n}} (\fun (h: Units.Carrier) => h.apply v) _ _ (sym!{{Units.Carrier}} _ _ positiveEquality))));
