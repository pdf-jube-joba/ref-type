\definition positive: Positive.Carrier := \into[Sphere.Sphere](x, Cover.PositiveHalf) \by { inPositive };
\definition negative: Negative.Carrier := \into[Sphere.Sphere](x, Cover.NegativeHalf) \by { inNegative };
\definition point: Overlap := Cover.overlapPoint x inPositive inNegative;
\import \parent.\parent.\parent.FrameChange[x := point] \as SourceFrame;
\import Other.FrameChange[x := point] \as TargetFrame;
\definition agrees: \forall (v: Fiber x) -> (Left.isomorphism.forward.fiber positive).apply v = (Right.isomorphism.forward.fiber negative).apply v :=
  \fun (v: Fiber x) => Spaces.Isomorphism[V := Other.Fiber x, W := Vector n, source := Other.bundle.space x, target := coordinates n].injective
    ((Other.chart B.Bool^::true).frame TargetFrame.rightPoint) _ _ (eq_reason_in!{{Vector n} _
      "=" { (g2 (boundary point)).apply ((gauge.positive positive).apply (((chart B.Bool^::false).frame SourceFrame.leftPoint).forward.apply v)) } "by" {
        TargetFrame.formula ((gauge.positive positive).apply (((chart B.Bool^::false).frame SourceFrame.leftPoint).forward.apply v))
      }
      "=" { (gauge.negative negative).apply ((g (boundary point)).apply (((chart B.Bool^::false).frame SourceFrame.leftPoint).forward.apply v)) } "by" {
        sym!{{Vector n}} _ _ (gauge.compatible x inPositive inNegative (((chart B.Bool^::false).frame SourceFrame.leftPoint).forward.apply v))
      }
      "=" { (gauge.negative negative).apply (((chart B.Bool^::true).frame SourceFrame.rightPoint).forward.apply v) } "by" {
        congr!{{Vector n} {Vector n}} (gauge.negative negative).apply _ _ (sym!{{Vector n}} _ _ (SourceFrame.onFiber v))
      }
      "=" _ "by" {
        sym!{{Vector n}} _ _ ((Spaces.Isomorphism[V := Other.Fiber x, W := Vector n, source := Other.bundle.space x, target := coordinates n].laws ((Other.chart B.Bool^::true).frame TargetFrame.rightPoint)).rightInverse
          ((gauge.negative negative).apply (((chart B.Bool^::true).frame SourceFrame.rightPoint).forward.apply v)))
      }
    });
