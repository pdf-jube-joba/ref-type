\definition leftPoint: \Cast[Sphere.Sphere] U := \into[Sphere.Sphere](x, U) \by { (\bysub(Sphere.Sphere, overlap, x)).left };
\definition rightPoint: \Cast[Sphere.Sphere] V := \into[Sphere.Sphere](x, V) \by { (\bysub(Sphere.Sphere, overlap, x)).right };
\definition formula: \forall (v: Vector n) -> ((chart B.Bool^::true).frame rightPoint).forward.apply (((chart B.Bool^::false).frame leftPoint).backward.apply v) = (g (boundary x)).apply v := Construction.Boundary[x := x].transition;
\definition onFiber: \forall (v: Fiber x) -> ((chart B.Bool^::true).frame rightPoint).forward.apply v = (g (boundary x)).apply (((chart B.Bool^::false).frame leftPoint).forward.apply v) :=
  \fun (v: Fiber x) => trans!{{Vector n}} _ _ _
    (congr!{{Fiber x} {Vector n}} ((chart B.Bool^::true).frame rightPoint).forward.apply _ _ (sym!{{Fiber x}} _ _
      ((Spaces.Isomorphism[V := Fiber x, W := Vector n, source := bundle.space x, target := coordinates n].laws ((chart B.Bool^::false).frame leftPoint)).leftInverse v)))
    (formula (((chart B.Bool^::false).frame leftPoint).forward.apply v));
