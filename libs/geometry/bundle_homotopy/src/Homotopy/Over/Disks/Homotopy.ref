\import algebraic_topology.Interval[] \as I;
\import Sphere.Compactness[] \as Compactness;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projections[n := n].Operators[].Units[] \as Units;
\import topological_constructions.Product[A := I.Carrier, B := Disk.Sphere] \as Parameters;
\import topological_constructions.Product[A := I.Carrier, B := Overlap] \as OverlapParameters;
\definition parameter[p: OverlapParameters.CarrierSet]: Parameters.CarrierSet := Pair.pair I.Carrier Disk.Sphere (Pair.first I.Carrier Overlap p) (boundary (Pair.second I.Carrier Overlap p));
\definition parameterContinuous: topology.Continuity[A := OverlapParameters.CarrierSet, B := Parameters.CarrierSet].Continuous
  (OverlapParameters.topology I.topology overlapTopology) (Parameters.topology I.topology Disk.sphereTopology) parameter :=
  Parameters.Universal[X := OverlapParameters.CarrierSet].pairContinuous (OverlapParameters.topology I.topology overlapTopology) I.topology Disk.sphereTopology
    (\fun (p: OverlapParameters.CarrierSet) => Pair.first I.Carrier Overlap p) (\fun (p: OverlapParameters.CarrierSet) => boundary (Pair.second I.Carrier Overlap p))
    (OverlapParameters.Maps[].firstContinuous I.topology overlapTopology)
    (topology.Composition[A := OverlapParameters.CarrierSet, B := Overlap, C := Disk.Sphere].composeContinuous
      (OverlapParameters.topology I.topology overlapTopology) overlapTopology Disk.sphereTopology
      (\fun (p: OverlapParameters.CarrierSet) => Pair.second I.Carrier Overlap p) boundary (OverlapParameters.Maps[].secondContinuous I.topology overlapTopology) boundaryContinuous);
\definition transition[p: OverlapParameters.CarrierSet]: Units.Carrier := G (parameter p);
\definition transitionContinuous: topology.Continuity[A := OverlapParameters.CarrierSet, B := Units.Carrier].Continuous
  (OverlapParameters.topology I.topology overlapTopology) Units.topology transition :=
  topology.Composition[A := OverlapParameters.CarrierSet, B := Parameters.CarrierSet, C := Units.Carrier].composeContinuous
    (OverlapParameters.topology I.topology overlapTopology) (Parameters.topology I.topology Disk.sphereTopology) Units.topology parameter G parameterContinuous regular;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Clutching[n := n, X := Sphere.Sphere, baseSpace := Sphere.sphereTopology,
  U := U, V := V, openU := openU, openV := openV, covers := covers].Homotopy[compact := Compactness.sphere, hausdorff := Compactness.sphereHausdorff,
  G := transition, regular := transitionContinuous] \as Constructed;
\definition Isomorphism: \Set := Constructed.Isomorphism;
\definition isomorphismExists: \exists Isomorphism := Constructed.isomorphismExists;
