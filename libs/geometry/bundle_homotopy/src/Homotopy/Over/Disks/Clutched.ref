\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projections[n := n].Operators[].Units[] \as Units;
\definition transition[x: Overlap]: Units.Carrier := g (boundary x);
\definition transitionContinuous: topology.Continuity[A := Overlap, B := Units.Carrier].Continuous overlapTopology Units.topology transition :=
  topology.Composition[A := Overlap, B := Disk.Sphere, C := Units.Carrier].composeContinuous overlapTopology Disk.sphereTopology Units.topology boundary g boundaryContinuous continuous;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Clutching[n := n, X := Sphere.Sphere, baseSpace := Sphere.sphereTopology, U := U, V := V, openU := openU, openV := openV, covers := covers].With[g := transition, continuous := transitionContinuous] \as Construction;
\definition Fiber[x: Sphere.Sphere]: \Set := Construction.Fiber x;
\definition bundle: Bundles.Family[X := Sphere.Sphere, F := Fiber].Bundle := Construction.bundle;

\import std.Data[].Bool[] \as B;
\import \parent.Hemispheres[] \as Halves;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ChartPullback[X := Sphere.Sphere, F := Fiber, bundle := bundle, chart := Construction.chart B.Bool^::false,
  Y := Disk.Disk, source := Disk.diskTopology, f := Halves.positive, continuous := Halves.positiveContinuous, inside := Halves.positiveInU] \as PositiveChart;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ChartPullback[X := Sphere.Sphere, F := Fiber, bundle := bundle, chart := Construction.chart B.Bool^::true,
  Y := Disk.Disk, source := Disk.diskTopology, f := Halves.negative, continuous := Halves.negativeContinuous, inside := Halves.negativeInV] \as NegativeChart;
\definition positiveTrivialization: Bundles.Isomorphisms[X := Disk.Disk, F := (\fun (v: Disk.Disk) => Fiber (Halves.positive v)), G := (\fun (v: Disk.Disk) => Vector n),
  source := PositiveChart.pulledBundle, target := Bundles.Trivial[X := Disk.Disk, n := n, baseSpace := Disk.diskTopology].bundle].Isomorphism := PositiveChart.isomorphism;
\definition negativeTrivialization: Bundles.Isomorphisms[X := Disk.Disk, F := (\fun (v: Disk.Disk) => Fiber (Halves.negative v)), G := (\fun (v: Disk.Disk) => Vector n),
  source := NegativeChart.pulledBundle, target := Bundles.Trivial[X := Disk.Disk, n := n, baseSpace := Disk.diskTopology].bundle].Isomorphism := NegativeChart.isomorphism;

\definition chart[i: B.Bool^]: Bundles.Family[X := Sphere.Sphere, F := Fiber].With[data := bundle].Chart := Construction.chart i;
\module FrameChange(x: Overlap);
\module Comparison(g2: Disk.Sphere -> Units.Carrier,
  continuous2: topology.Continuity[A := Disk.Sphere, B := Units.Carrier].Continuous Disk.sphereTopology Units.topology g2);
