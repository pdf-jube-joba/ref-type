\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projections[n := n].Operators[].Units[] \as Units;
\definition transition[x: Overlap]: Units.Carrier := g (boundary x);
\definition transitionContinuous: topology.Continuity[A := Overlap, B := Units.Carrier].Continuous overlapTopology Units.topology transition :=
  topology.Composition[A := Overlap, B := Disk.Sphere, C := Units.Carrier].composeContinuous overlapTopology Disk.sphereTopology Units.topology boundary g boundaryContinuous continuous;
\import \root.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Clutching[n := n, X := Sphere.Sphere, baseSpace := Sphere.sphereTopology, U := U, V := V, openU := openU, openV := openV, covers := covers].With[g := transition, continuous := transitionContinuous] \as Construction;
\definition Fiber[x: Sphere.Sphere]: \Set := Construction.Fiber x;
\definition bundle: Bundles.Family[X := Sphere.Sphere, F := Fiber].Bundle := Construction.bundle;
