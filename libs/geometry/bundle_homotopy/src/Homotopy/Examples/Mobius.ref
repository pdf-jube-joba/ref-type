\import algebraic_topology.Euclidean[].Dimension[n := one] \as E;
\import R.Algebra[] \as Algebra;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\definition coefficient[s: E.Sphere]: R.Real := s (Fin.zero zero);
\definition unit: \forall (s: E.Sphere) -> R.mul (coefficient s) (coefficient s) = R.one := \fun (s: E.Sphere) =>
  trans!{R.Real} _ _ _ (sym!{R.Real} _ _ (Laws.addZeroRight (R.mul (coefficient s) (coefficient s)))) (\bysub(E.Coordinate, E.Boundary, s));
\definition nonzero: \forall (s: E.Sphere) -> Logic.Not (coefficient s = R.zero) := \fun (s: E.Sphere)(equal: _) => Laws.zeroNeOne
  (trans!{R.Real} _ _ _ (sym!{R.Real} _ _ (Laws.fieldMulZeroLeft R.zero)) (trans!{R.Real} _ _ _ (congr!{R.Real R.Real R.Real} R.mul _ _ _ _ (sym!{R.Real} _ _ equal) (sym!{R.Real} _ _ equal)) (unit s)));
\definition regular: topology.Continuity[A := E.Sphere, B := R.Real].Continuous E.sphereTopology metric_spaces.RealLine[].topology coefficient := E.Splitting[].Equator[].coordinateContinuous (Fin.zero zero);
\import Real.ScalarUnits[n := one].Family[X := E.Sphere, source := E.sphereTopology, a := coefficient, regular := regular, nonzero := nonzero] \as Transition;
\import Real.Disks[d := one].Clutched[n := one, g := Transition.map, continuous := Transition.continuous] \as Construction;
\definition Fiber[x: algebraic_topology.Euclidean[].Dimension[n := two].Sphere]: \Set := Construction.Fiber x;
\definition bundle: vector_bundles.Bundles[].Over[K := R.Real, field := Algebra.field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].Family[X := algebraic_topology.Euclidean[].Dimension[n := two].Sphere, F := Fiber].Bundle := Construction.bundle;
