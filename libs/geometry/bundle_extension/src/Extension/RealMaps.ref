\import \root.Extension[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].Morphisms[X := X, subset := subset, F := F, G := G, source := source, target := target, baseSpace := baseSpace, sourceSame := sourceSame, same := same] \as Native;
\import bundle_complements.Complements[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Complements;
\import Complements.For[X := X, F := F, bundle := source] \as SourceEmbeddings;
\import Complements.For[X := X, F := G, bundle := target] \as TargetEmbeddings;
\definition MapOnSubset: \Set := Native.MapOnSubset;
\definition Result[h: MapOnSubset]: \Set := Native.Extension[h];
\module With(h: MapOnSubset, first: SourceEmbeddings.Embedding, second: TargetEmbeddings.Embedding);
\definition extend[h: MapOnSubset]: topology.Topology[Carrier := X].IsCompact baseSpace -> topology.Topology[Carrier := X].IsT2 baseSpace ->
  topology.Topology[Carrier := X].IsClosedIn baseSpace subset -> \exists Result[h] := \block {
  \fun (compact: _)(hausdorff: _)(closed: _) \then
  \let sourceCompact: topology.Topology[Carrier := X].IsCompact source.baseSpace := \idelim baseSpace = source.baseSpace
    \with t: topology.Topology[Carrier := X].Topology => topology.Topology[Carrier := X].IsCompact t \by { base: compact, equality: sourceSame } \then
  \let sourceHausdorff: topology.Topology[Carrier := X].IsT2 source.baseSpace := \idelim baseSpace = source.baseSpace
    \with t: topology.Topology[Carrier := X].Topology => topology.Topology[Carrier := X].IsT2 t \by { base: hausdorff, equality: sourceSame } \then
  \takefrom first: SourceEmbeddings.Embedding \by SourceEmbeddings.embeddingExists sourceCompact sourceHausdorff \then
  \let targetCompact: topology.Topology[Carrier := X].IsCompact target.baseSpace := \idelim baseSpace = target.baseSpace
    \with t: topology.Topology[Carrier := X].Topology => topology.Topology[Carrier := X].IsCompact t \by { base: compact, equality: trans!{{topology.Topology[Carrier := X].Topology}} baseSpace source.baseSpace target.baseSpace sourceSame same } \then
  \let targetHausdorff: topology.Topology[Carrier := X].IsT2 target.baseSpace := \idelim baseSpace = target.baseSpace
    \with t: topology.Topology[Carrier := X].Topology => topology.Topology[Carrier := X].IsT2 t \by { base: hausdorff, equality: trans!{{topology.Topology[Carrier := X].Topology}} baseSpace source.baseSpace target.baseSpace sourceSame same } \then
  \takefrom second: TargetEmbeddings.Embedding \by TargetEmbeddings.embeddingExists targetCompact targetHausdorff \then
  \return With[h := h, first := first, second := second].exists compact hausdorff closed
};
