\import Spectral.Conjugation[].At[n := n].On[A := complexExtension.value x, off := Recovered.off x, real := Lift.conjugation (e.value x)] \as Reality;
\import Lift.Restrict[P := Recovered.projection x, real := Reality.natural, idempotent := Recovered.idempotent x] \as Restriction;
\definition projection: Idempotents.Projection := Idempotents.Projection { map := Restriction.map, idempotent := Restriction.realIdempotent };
