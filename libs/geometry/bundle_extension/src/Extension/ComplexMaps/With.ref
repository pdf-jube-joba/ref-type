\import Native.Through[h := h, first := first, second := second] \as Through;
\import \root.Extension[].Complex[A := X, source := source.baseSpace, subset := subset].Matrices[m := first.dimension, n := second.dimension] \as Entries;
\definition input: Entries.Function := Entries.Function { value := Through.input, continuous := Through.inputContinuous };
\definition exists: topology.Topology[Carrier := X].IsCompact source.baseSpace -> topology.Topology[Carrier := X].IsT2 source.baseSpace ->
  topology.Topology[Carrier := X].IsClosedIn source.baseSpace subset -> \exists Result[h] := \block {
  \fun (compact: _)(hausdorff: _)(closed: _) \then
  \takefrom e: Entries.Extension[input] \by Entries.tietze input compact hausdorff closed \then
  \let coordinates: Through.CoordinatesExtension := Through.CoordinatesExtension { value := e.value, continuous := e.continuous, extends := e.extends } \then
  \return \exact(Through.With[e := coordinates].extension, Result[h])
};
