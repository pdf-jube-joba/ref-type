\import \parent.Morphisms[X := X, subset := subset, F := F, G := G, source := source, target := target, baseSpace := source.baseSpace, sourceSame := \refl(source.baseSpace), same := same] \as Forward;
\import \parent.Morphisms[X := X, subset := subset, F := G, G := F, source := target, target := source, baseSpace := source.baseSpace, sourceSame := same, same := sym!{{topology.Topology[Carrier := X].Topology}} source.baseSpace target.baseSpace same] \as Backward;
\import topology.Topology[Carrier := X] \as Base;
\definition topology: Base.Topology := source.baseSpace;
\import Base.Subspace[S := subset] \as Subspace;
\import Bundles.Isomorphisms[X := Subspace.CarrierSet, F := (\fun (x: Subspace.CarrierSet) => F x), G := (\fun (x: Subspace.CarrierSet) => G x),
  source := Forward.restrictedSource, target := Forward.restrictedTarget] \as Original;
\definition firstRestriction: Bundles.Family[X := Subspace.CarrierSet, F := (\fun (x: Subspace.CarrierSet) => F x)].Bundle := Forward.restrictedSource;
\definition secondRestriction: Bundles.Family[X := Subspace.CarrierSet, F := (\fun (x: Subspace.CarrierSet) => G x)].Bundle := Forward.restrictedTarget;
\definition OnSubset: \Set := Original.Isomorphism;
\module Neighborhood(U: \Pow X);
\structure Extension[a: OnSubset]: \Set := {
  domain: \Pow X,
  open: Base.IsOpenIn topology domain,
  contains: Base.Subset subset domain,
  isomorphism: Neighborhood[U := domain].Isomorphism,
  extends: \forall (x: Subspace.CarrierSet)(v: F x) ->
    (isomorphism.forward.fiber (\into[X](x, domain) \by { contains x (\bysub(X, subset, x)) })).apply v = (a.forward.fiber x).apply v,
};
\import Complements.For[X := X, F := F, bundle := source] \as SourceEmbeddings;
\import Complements.For[X := X, F := G, bundle := target] \as TargetEmbeddings;
\module Through(a: OnSubset, h: Forward.Extension[a.forward], g: Backward.Extension[a.backward], first: SourceEmbeddings.Embedding, second: TargetEmbeddings.Embedding);
\module With(a: OnSubset, e: Extension[a]);
