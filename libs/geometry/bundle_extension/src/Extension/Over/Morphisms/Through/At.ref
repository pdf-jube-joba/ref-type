\import Spaces.Linear[V := G x, W := Bundles.Vector n, source := target.space x, target := Bundles.coordinates n].Composition[U := F x, domain := source.space x] \as Encode;
\import Spaces.Linear[V := F x, W := Bundles.Vector n, source := source.space x, target := Bundles.coordinates n].Composition[U := Bundles.Vector m, domain := Bundles.coordinates m] \as Complete;
\definition map: CoordinateMaps.Map := Complete.compose (Encode.compose (second.map.fiber x) (h.fiber x)) (First.project.fiber x);
