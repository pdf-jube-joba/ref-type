\import Family.Of[bundle := bundle].PullbackComposition[Y := Point, Z := Y, first := space, second := baseSpace, f := inclusion, g := f].Of[fRegular := continuous, gRegular := regular] \as Composition;
\import Complements.PulledIsomorphism[X := Point, Y := Y, F := (\fun (x: Point) => F x), G := (\fun (x: Point) => F x), source := restricted, target := restricted,
  base := baseSpace, f := f, sourceRegular := regular, targetRegular := regular] \as Pullback;
\import bundle_operations.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Operations;
\definition iso: Bundles.Isomorphisms[X := Y, F := (\fun (y: Y) => F (f y)), G := (\fun (y: Y) => F (f y)), source := Composition.direct, target := Composition.direct].Isomorphism :=
  Operations.IsomorphismComposition[X := Y, F := (\fun (y: Y) => F (f y)), G := (\fun (y: Y) => F (f y)), H := (\fun (y: Y) => F (f y)),
    source := Composition.direct, middle := Composition.nested, target := Composition.direct].compose Composition.isomorphism
    (Operations.IsomorphismComposition[X := Y, F := (\fun (y: Y) => F (f y)), G := (\fun (y: Y) => F (f y)), H := (\fun (y: Y) => F (f y)),
      source := Composition.nested, middle := Composition.nested, target := Composition.direct].compose (Pullback.isomorphism isomorphism)
      (Bundles.Isomorphisms[X := Y, F := (\fun (y: Y) => F (f y)), G := (\fun (y: Y) => F (f y)), source := Composition.direct, target := Composition.nested].inverse Composition.isomorphism));
\definition forwardFormula[y: Y][v: F (f y)]: (iso.forward.fiber y).apply v = (t.fiber (f y)).apply v := \refl((t.fiber (f y)).apply v);
\definition left[y: Y][v: F (f y)]: (iso.backward.fiber y).apply ((t.fiber (f y)).apply v) = v := iso.leftInverse y v;
\definition right[y: Y][v: F (f y)]: (t.fiber (f y)).apply ((iso.backward.fiber y).apply v) = v := iso.rightInverse y v;
