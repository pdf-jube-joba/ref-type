\import \parent.\parent.Equations[x := x] \as Proof;
\import Spaces.Linear[V := F x, W := F x, source := bundle.space x, target := bundle.space x] \as Endomorphisms;
\import Spaces.Linear[V := Bundles.Vector n, W := F x, source := Bundles.coordinates n, target := bundle.space x].Composition[U := Bundles.Vector n, domain := Bundles.coordinates n] \as Last;
\import Spaces.Linear[V := Bundles.Vector n, W := F x, source := Bundles.coordinates n, target := bundle.space x].Composition[U := F x, domain := bundle.space x] \as First;
\definition backward: Endomorphisms.Map := First.compose (Last.compose (Retraction.project.fiber x) (inverse x)) (embedding.map.fiber x);
\definition left[v: F x]: backward.apply ((t.fiber x).apply v) = v := trans!{{F x}} _ _ _
  (congr!{{Bundles.Vector n} {F x}} (\fun (w: Bundles.Vector n) => (Retraction.project.fiber x).apply ((inverse x).apply w)) _ _ (sym!{{Bundles.Vector n}} _ _ (Proof.fullInclusion v)))
  (trans!{{F x}} _ _ _ (congr!{{Bundles.Vector n} {F x}} (Retraction.project.fiber x).apply _ _ (inverseLeft x ((embedding.map.fiber x).apply v))) (Retraction.retraction x v));
\definition right[v: F x]: (t.fiber x).apply (backward.apply v) = v := trans!{{F x}} _ _ _
  (sym!{{F x}} _ _ (Proof.projectFull ((inverse x).apply ((embedding.map.fiber x).apply v))))
  (trans!{{F x}} _ _ _ (congr!{{Bundles.Vector n} {F x}} (Retraction.project.fiber x).apply _ _ (inverseRight x ((embedding.map.fiber x).apply v))) (Retraction.retraction x v));
