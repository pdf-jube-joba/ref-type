\definition Point: \Set := \Cast[X] d.value;
\definition space: topology.Topology[Carrier := Point].Topology := Base.Subspace[S := d.value].topology topology;
\definition map[x: Point]: OpenPoint := \into[X](x, U) \by { d.within x (\bysub(X, d.value, x)) };
\definition regular: topology.Continuity[A := Point, B := OpenPoint].Continuous space openSpace map :=
  topology.Continuity[A := Point, B := X].Corestriction[S := U].corestrictContinuous space topology map
    (topology.Continuity[A := Point, B := X].Corestriction[S := d.value].inclusionContinuous topology);
\definition sourceRegular: topology.Continuity[A := Point, B := OpenPoint].Continuous space source.baseSpace map :=
  \idelim openSpace = source.baseSpace \with t: topology.Topology[Carrier := OpenPoint].Topology => topology.Continuity[A := Point, B := OpenPoint].Continuous space t map \by {
    base: regular, equality: sym!{{topology.Topology[Carrier := OpenPoint].Topology}} _ _ sameSource
  };
\definition targetRegular: topology.Continuity[A := Point, B := OpenPoint].Continuous space target.baseSpace map :=
  \idelim openSpace = target.baseSpace \with t: topology.Topology[Carrier := OpenPoint].Topology => topology.Continuity[A := Point, B := OpenPoint].Continuous space t map \by {
    base: regular, equality: sym!{{topology.Topology[Carrier := OpenPoint].Topology}} _ _ sameTarget
  };
\definition first: Bundles.Family[X := Point, F := (\fun (x: Point) => F (map x))].Bundle := Bundles.Family[X := OpenPoint, F := F].Of[bundle := source].Pullback[Y := Point, source := space, f := map].pulled sourceRegular;
\definition second: Bundles.Family[X := Point, F := (\fun (x: Point) => G (map x))].Bundle := Bundles.Family[X := OpenPoint, F := G].Of[bundle := target].Pullback[Y := Point, source := space, f := map].pulled targetRegular;
\definition Isomorphism: \Set := Bundles.Isomorphisms[X := Point, F := (\fun (x: Point) => F (map x)), G := (\fun (x: Point) => G (map x)), source := first, target := second].Isomorphism;
