\import Bundles.Family[X := OpenPoint, F := G].Of[bundle := target].PullbackComposition[Y := ClosedPoint, Z := Local.Point,
  first := closedSpace, second := Local.space, f := toOpen, g := toCompact].Of[fRegular := targetRegular, gRegular := compactContinuous] \as Composition;
\definition nested: Bundles.Family[X := Local.Point, F := (\fun (x: Local.Point) => G (Local.map x))].Bundle := Composition.nested;
\definition comparison: Bundles.Isomorphisms[X := Local.Point, F := (\fun (x: Local.Point) => G (Local.map x)), G := (\fun (x: Local.Point) => G (Local.map x)), source := Local.second, target := nested].Isomorphism := Composition.isomorphism;
