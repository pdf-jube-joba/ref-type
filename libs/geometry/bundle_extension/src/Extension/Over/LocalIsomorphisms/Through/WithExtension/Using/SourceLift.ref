\import Bundles.Family[X := OpenPoint, F := F].Of[bundle := source].PullbackComposition[Y := ClosedPoint, Z := Local.Point,
  first := closedSpace, second := Local.space, f := toOpen, g := toCompact].Of[fRegular := sourceRegular, gRegular := compactContinuous] \as Composition;
\definition nested: Bundles.Family[X := Local.Point, F := (\fun (x: Local.Point) => F (Local.map x))].Bundle := Composition.nested;
\definition comparison: Bundles.Isomorphisms[X := Local.Point, F := (\fun (x: Local.Point) => F (Local.map x)), G := (\fun (x: Local.Point) => F (Local.map x)), source := Local.first, target := nested].Isomorphism := Composition.isomorphism;
