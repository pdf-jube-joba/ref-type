\definition originalInclusion[x: OriginalPoint]: OpenPoint := x;
\definition originalContinuous: topology.Continuity[A := OriginalPoint, B := OpenPoint].Continuous originalSpace source.baseSpace originalInclusion :=
  topology.Continuity[A := OriginalPoint, B := OpenPoint].Corestriction[S := boundary].inclusionContinuous source.baseSpace;
\import Bundles.Family[X := OpenPoint, F := F].Of[bundle := source].PullbackComposition[Y := ClosedPoint, Z := SmallPoint,
  first := closedSpace, second := smallSpace, f := toOpen, g := inclusion].Of[fRegular := sourceRegular, gRegular := inclusionContinuous] \as Closed;
\import Bundles.Family[X := OpenPoint, F := F].Of[bundle := source].PullbackComposition[Y := OriginalPoint, Z := SmallPoint,
  first := originalSpace, second := smallSpace, f := originalInclusion, g := boundaryMap].Of[fRegular := originalContinuous, gRegular := boundaryContinuous] \as Original;
\import bundle_operations.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Operations;
\definition comparison: Bundles.Isomorphisms[X := SmallPoint, F := (\fun (x: SmallPoint) => F (toOpen x)), G := (\fun (x: SmallPoint) => F (toOpen x)), source := Closed.nested, target := Original.nested].Isomorphism :=
  Operations.IsomorphismComposition[X := SmallPoint, F := (\fun (x: SmallPoint) => F (toOpen x)), G := (\fun (x: SmallPoint) => F (toOpen x)), H := (\fun (x: SmallPoint) => F (toOpen x)),
    source := Closed.nested, middle := Closed.direct, target := Original.nested].compose
    (Bundles.Isomorphisms[X := SmallPoint, F := (\fun (x: SmallPoint) => F (toOpen x)), G := (\fun (x: SmallPoint) => F (toOpen x)), source := Closed.direct, target := Closed.nested].inverse Closed.isomorphism) Original.isomorphism;
\definition closed: Bundles.Family[X := SmallPoint, F := (\fun (x: SmallPoint) => F (toOpen x))].Bundle := Closed.nested;
\definition original: Bundles.Family[X := SmallPoint, F := (\fun (x: SmallPoint) => F (toOpen x))].Bundle := Original.nested;
