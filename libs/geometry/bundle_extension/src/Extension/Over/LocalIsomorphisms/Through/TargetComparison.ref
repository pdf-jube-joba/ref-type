\definition originalInclusion[x: OriginalPoint]: OpenPoint := x;
\definition originalContinuous: topology.Continuity[A := OriginalPoint, B := OpenPoint].Continuous originalSpace target.baseSpace originalInclusion :=
  \idelim source.baseSpace = target.baseSpace \with t: topology.Topology[Carrier := OpenPoint].Topology => topology.Continuity[A := OriginalPoint, B := OpenPoint].Continuous originalSpace t originalInclusion \by {
    base: topology.Continuity[A := OriginalPoint, B := OpenPoint].Corestriction[S := boundary].inclusionContinuous source.baseSpace, equality: sameBase
  };
\import Bundles.Family[X := OpenPoint, F := G].Of[bundle := target].PullbackComposition[Y := ClosedPoint, Z := SmallPoint,
  first := closedSpace, second := smallSpace, f := toOpen, g := inclusion].Of[fRegular := targetRegular, gRegular := inclusionContinuous] \as Closed;
\import Bundles.Family[X := OpenPoint, F := G].Of[bundle := target].PullbackComposition[Y := OriginalPoint, Z := SmallPoint,
  first := originalSpace, second := smallSpace, f := originalInclusion, g := boundaryMap].Of[fRegular := originalContinuous, gRegular := boundaryContinuous] \as Original;
\import bundle_operations.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Operations;
\definition comparison: Bundles.Isomorphisms[X := SmallPoint, F := (\fun (x: SmallPoint) => G (toOpen x)), G := (\fun (x: SmallPoint) => G (toOpen x)), source := Closed.nested, target := Original.nested].Isomorphism :=
  Operations.IsomorphismComposition[X := SmallPoint, F := (\fun (x: SmallPoint) => G (toOpen x)), G := (\fun (x: SmallPoint) => G (toOpen x)), H := (\fun (x: SmallPoint) => G (toOpen x)),
    source := Closed.nested, middle := Closed.direct, target := Original.nested].compose
    (Bundles.Isomorphisms[X := SmallPoint, F := (\fun (x: SmallPoint) => G (toOpen x)), G := (\fun (x: SmallPoint) => G (toOpen x)), source := Closed.direct, target := Closed.nested].inverse Closed.isomorphism) Original.isomorphism;
\definition closed: Bundles.Family[X := SmallPoint, F := (\fun (x: SmallPoint) => G (toOpen x))].Bundle := Closed.nested;
\definition original: Bundles.Family[X := SmallPoint, F := (\fun (x: SmallPoint) => G (toOpen x))].Bundle := Original.nested;
