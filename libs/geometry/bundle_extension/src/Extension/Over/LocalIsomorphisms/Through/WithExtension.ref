\module Using(l: Compact.LocalWitness[e.domain]);
\definition exists: \exists Extension[a] := \block {
  \takefrom l: Compact.LocalWitness[e.domain] \by Compact.lift e.domain e.open
    (\fun (x: \Cast[X] subset) => e.contains (\into[X](x, w.envelope) \by { Compact.contains x (\bysub(X, subset, x)) }) (\bysub(X, subset, x))) \then
  \return \exact(Using[l := l].extension, Extension[a])
};
