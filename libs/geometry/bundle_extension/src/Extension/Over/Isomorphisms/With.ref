\import \parent.Neighborhood[U := e.domain] \as Local;
\definition embed[x: Subspace.CarrierSet]: Local.Point := \into[X](x, e.domain) \by { e.contains x (\bysub(X, subset, x)) };
\module Pullback(Y: \Set, space: topology.Topology[Carrier := Y].Topology, f: Y -> Local.Point,
  regular: topology.Continuity[A := Y, B := Local.Point].Continuous space Local.space f);
\module Stabilize(n: N.Nat^);
