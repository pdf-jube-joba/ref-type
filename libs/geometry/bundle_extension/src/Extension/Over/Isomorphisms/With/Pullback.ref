\import Bundles.Family[X := Local.Point, F := (\fun (x: Local.Point) => F x)].Of[bundle := Local.first].Pullback[Y := Y, source := space, f := f] \as First;
\import Bundles.Family[X := Local.Point, F := (\fun (x: Local.Point) => G x)].Of[bundle := Local.second].Pullback[Y := Y, source := space, f := f] \as Second;
\import Complements.PulledIsomorphism[X := Local.Point, Y := Y, F := (\fun (x: Local.Point) => F x), G := (\fun (x: Local.Point) => G x),
  source := Local.first, target := Local.second, base := space, f := f, sourceRegular := regular, targetRegular := regular] \as Pulled;
\definition isomorphism: Bundles.Isomorphisms[X := Y, F := (\fun (y: Y) => F (f y)), G := (\fun (y: Y) => G (f y)), source := First.pulled regular, target := Second.pulled regular].Isomorphism := Pulled.isomorphism e.isomorphism;
\definition restricted: \Pow Y := { y: Y \where Base.Member subset (f y) };
\definition onSubset[y: \Cast[Y] restricted][v: F (f y)]: (isomorphism.forward.fiber y).apply v = (a.forward.fiber (\into[X](f y, subset) \by { \bysub(Y, restricted, y) })).apply v :=
  e.extends (\into[X](f y, subset) \by { \bysub(Y, restricted, y) }) v;
