\import bundle_operations.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Operations;
\import Bundles.Trivial[X := Local.Point, n := n, baseSpace := Local.space] \as Trivial;
\import Operations.DirectSumIsomorphisms[X := Local.Point, F := (\fun (x: Local.Point) => F x), G := (\fun (_: Local.Point) => Bundles.Vector n),
  A := (\fun (x: Local.Point) => G x), B := (\fun (_: Local.Point) => Bundles.Vector n), first := Local.first, second := Trivial.bundle,
  newFirst := Local.second, newSecond := Trivial.bundle, sameSource := \refl(Local.space), sameTarget := \refl(Local.space)] \as Sums;
\definition isomorphism: Bundles.Isomorphisms[X := Local.Point,
  F := (\fun (x: Local.Point) => Pair.Times^[F x, Bundles.Vector n]), G := (\fun (x: Local.Point) => Pair.Times^[G x, Bundles.Vector n]), source := Sums.sourceBundle, target := Sums.targetBundle].Isomorphism :=
  Sums.isomorphism e.isomorphism (Operations.IdentityIsomorphism[X := Local.Point, F := (\fun (_: Local.Point) => Bundles.Vector n), bundle := Trivial.bundle].isomorphism);
\definition onSubset[x: Subspace.CarrierSet][v: F x][w: Bundles.Vector n]: (isomorphism.forward.fiber (embed x)).apply (Pair.pair (F x) (Bundles.Vector n) v w) =
  Pair.pair (G x) (Bundles.Vector n) ((a.forward.fiber x).apply v) w := Pair.Prop[A := G x, B := Bundles.Vector n].pairCong _ _ _ _ (e.extends x v) (\refl(w));
