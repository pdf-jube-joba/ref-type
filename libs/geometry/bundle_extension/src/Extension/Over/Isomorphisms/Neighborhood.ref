\definition Point: \Set := \Cast[X] U;
\definition space: topology.Topology[Carrier := Point].Topology := Base.Subspace[S := U].topology topology;
\definition inclusion[x: Point]: X := x;
\definition continuous: topology.Continuity[A := Point, B := X].Continuous space source.baseSpace inclusion :=
  topology.Continuity[A := Point, B := X].Corestriction[S := U].inclusionContinuous topology;
\definition targetContinuous: topology.Continuity[A := Point, B := X].Continuous space target.baseSpace inclusion :=
  \idelim source.baseSpace = target.baseSpace \with t: Base.Topology => topology.Continuity[A := Point, B := X].Continuous space t inclusion \by { base: continuous, equality: same };
\definition first: Bundles.Family[X := Point, F := (\fun (x: Point) => F x)].Bundle := Bundles.Family[X := X, F := F].Of[bundle := source].Pullback[Y := Point, source := space, f := inclusion].pulled continuous;
\definition second: Bundles.Family[X := Point, F := (\fun (x: Point) => G x)].Bundle := Bundles.Family[X := X, F := G].Of[bundle := target].Pullback[Y := Point, source := space, f := inclusion].pulled targetContinuous;
\definition Isomorphism: \Set := Bundles.Isomorphisms[X := Point, F := (\fun (x: Point) => F x), G := (\fun (x: Point) => G x), source := first, target := second].Isomorphism;
