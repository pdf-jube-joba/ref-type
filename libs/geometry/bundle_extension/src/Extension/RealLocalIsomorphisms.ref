\import \root.Extension[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].LocalIsomorphisms[X := X, topology := topology, subset := subset, U := U, inside := inside,
  F := F, G := G, source := source, target := target, sameSource := sameSource, sameTarget := sameTarget] \as Native;
\import \root.Extension[].CompactNeighborhood[X := X, topology := topology, subset := subset, U := U] \as Shrinking;
\definition OnSubset: \Set := Native.OnSubset;
\definition Result[a: OnSubset]: \Set := Native.Extension[a];
\module With(a: OnSubset, w: Shrinking.Witness);
\definition extend[a: OnSubset]: topology.Topology[Carrier := X].IsCompact topology -> topology.Topology[Carrier := X].IsT2 topology ->
  topology.Topology[Carrier := X].IsClosedIn topology subset -> topology.Topology[Carrier := X].IsOpenIn topology U -> \exists Result[a] := \block {
  \fun (compact: _)(hausdorff: _)(closed: _)(open: _) \then
  \takefrom w: Shrinking.Witness \by Shrinking.exists compact hausdorff closed open inside \then
  \return With[a := a, w := w].exists compact hausdorff closed
};
