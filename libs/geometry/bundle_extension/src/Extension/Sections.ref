\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Bundles;
\import bundle_complements.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Complements;
\import Bundles.Family[X := A, F := F] \as Family;
\import topology.Topology[Carrier := A] \as Space;
\import Space.Subspace[S := subset] \as Subspace;
\definition source: Space.Topology := bundle.baseSpace;
\structure Section: \Set := {
  value: \forall (x: Subspace.CarrierSet) -> F x,
  continuous: topology.Continuity[A := Subspace.CarrierSet, B := Family.Point].Continuous (Subspace.topology source) bundle.totalSpace
    (\fun (x: Subspace.CarrierSet) => Family.include x (value x)),
};
\structure Extension[s: Section]: \Set := {
  value: \forall (x: A) -> F x,
  continuous: topology.Continuity[A := A, B := Family.Point].Continuous source bundle.totalSpace
    (\fun (x: A) => Family.include x (value x)),
  extends: \forall (x: Subspace.CarrierSet) -> value x = s.value x,
};
\import Complements.For[X := A, F := F, bundle := bundle] \as Embeddings;
\module Through(s: Section, embedding: Embeddings.Embedding);
