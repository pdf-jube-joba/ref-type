\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Bundles;
\import bundle_complements.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Complements;
\import linear_algebra.Commutative[K := K, scalarRing := Fields.fieldAsCommutativeRing K field] \as Spaces;
\import hermitian_frames.Hermitian[].Over[K := K, field := field, scalar := conjugation, topological := scalar.topological] \as Hermitian;
\module Rectangular(m, n: N.Nat^);
\module Retraction(X: \Set, F: X -> \Set, bundle: Bundles.Family[X := X, F := F].Bundle,
  embedding: Complements.For[X := X, F := F, bundle := bundle].Embedding);
\module Morphisms(X: \Set, subset: \Pow X, F, G: X -> \Set,
  source: Bundles.Family[X := X, F := F].Bundle, target: Bundles.Family[X := X, F := G].Bundle,
  same: source.baseSpace = target.baseSpace);
\module Endomorphisms(X: \Set, F: X -> \Set, bundle: Bundles.Family[X := X, F := F].Bundle,
  t: Bundles.Morphisms[X := X, Y := X, F := F, G := F, source := bundle, target := bundle, f := \fun (x: X) => x].Map,
  embedding: Complements.For[X := X, F := F, bundle := bundle].Embedding);
