\import topology.Topology[Carrier := X] \as Base;
\import Base.Urysohn[] \as Normal;
\definition Witness: \Set := Normal.ShrinkData[topology, subset, U];
\definition exists: Base.IsCompact topology -> Base.IsT2 topology -> Base.IsClosedIn topology subset -> Base.IsOpenIn topology U -> Base.Subset subset U -> \exists Witness :=
  \fun (compact: _)(hausdorff: _)(closed: _)(open: _)(contains: _) => Normal.shrink topology (Base.Compactness[].compactHausdorffNormal topology compact hausdorff) subset U closed open contains;
\module With(w: Witness);
