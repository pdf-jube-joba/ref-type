\definition value[x: A]: F x := (project.fiber x).apply (e.value x);
\definition ambient[x: A]: AmbientFamily.Point := AmbientFamily.include x (e.value x);
\definition ambientContinuous: topology.Continuity[A := A, B := AmbientFamily.Point].Continuous source Ambient.topology ambient :=
  Complements.TrivialMaps[X := A, n := n, baseSpace := source].Into[Y := A, source := source].continuous
    (\fun (x: A) => x) e.value (topology.Maps[A := A, B := A].Identity[].continuous source) e.continuous;
\definition continuous: topology.Continuity[A := A, B := Family.Point].Continuous source bundle.totalSpace
  (\fun (x: A) => Family.include x (value x)) :=
  topology.Composition[A := A, B := AmbientFamily.Point, C := Family.Point].composeContinuous source Ambient.topology bundle.totalSpace
    ambient (Retraction.total project) ambientContinuous (Retraction.continuous project);
\definition extends[x: Subspace.CarrierSet]: value x = s.value x := trans!{{F x}} _ _ _
  (congr!{{Bundles.Vector n} {F x}} (project.fiber x).apply _ _ (e.extends x)) (retraction x (s.value x));
\definition extension: Extension[s] := Extension[s] { value := value, continuous := continuous, extends := extends };
