\import \root.Extension[].Sections[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar,
  A := A, subset := subset, F := F, bundle := bundle] \as Native;
\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].For[X := A, F := F, bundle := bundle] \as Embeddings;
\module With(s: Native.Section, embedding: Embeddings.Embedding);
\definition extend[s: Native.Section]: topology.Topology[Carrier := A].IsCompact bundle.baseSpace -> topology.Topology[Carrier := A].IsT2 bundle.baseSpace ->
  topology.Topology[Carrier := A].IsClosedIn bundle.baseSpace subset -> \exists Native.Extension[s] := \block {
  \fun (compact: _)(hausdorff: _)(closed: _) \then
  \takefrom embedding: Embeddings.Embedding \by Embeddings.embeddingExists compact hausdorff \then
  \return With[s := s, embedding := embedding].exists compact hausdorff closed
};
