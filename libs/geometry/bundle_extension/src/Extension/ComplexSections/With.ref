\import Native.Through[s := s, embedding := embedding] \as Through;
\import \root.Extension[].Complex[A := A, source := bundle.baseSpace, subset := subset].Components[I := Fin.Fin embedding.dimension] \as Entries;
\definition input: Entries.Function := Entries.Function {
  value := Through.encoded,
  continuous := Through.componentContinuous,
};
\definition exists: topology.Topology[Carrier := A].IsCompact bundle.baseSpace -> topology.Topology[Carrier := A].IsT2 bundle.baseSpace ->
  topology.Topology[Carrier := A].IsClosedIn bundle.baseSpace subset -> \exists Native.Extension[s] := \block {
  \fun (compact: _)(hausdorff: _)(closed: _) \then
  \takefrom e: Entries.Extension[input] \by Entries.tietze input compact hausdorff closed \then
  \let coordinates: Through.CoordinatesExtension := Through.CoordinatesExtension {
    value := e.value,
    continuous := topological_algebra.Coordinates[K := C.Complex, I := Fin.Fin embedding.dimension].Universal[A := A].continuous
      bundle.baseSpace topological_algebra.Complex[].topology e.value e.continuous,
    extends := \fun (x: \Cast[A] subset) => \axiom:funext(e.value x, Through.encoded x, e.extends x),
  } \then
  \return \exact(Through.FromCoordinates[e := coordinates].extension, Native.Extension[s])
};
