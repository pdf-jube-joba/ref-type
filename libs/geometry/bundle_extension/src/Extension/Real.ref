\import topology.Topology[Carrier := A] \as Space;
\import Space.Subspace[S := subset] \as Subspace;
\import Subspace.Open[] \as Image;
\import Subspace.Closed[] \as Closed;
\import topology.Topology[Carrier := Subspace.CarrierSet] \as Sub;
\import metric_spaces.RealFunctions[A := A] \as Functions;
\import metric_spaces.RealFunctions[A := Subspace.CarrierSet] \as SubFunctions;
\import SubFunctions.Comparison[] \as Comparison;
\structure Function: \Set := {
  value: Subspace.CarrierSet -> R.Real,
  continuous: SubFunctions.Continuous (Subspace.topology source) value,
};
\module Separation(f: Function, lower, upper: R.Real);
\module Approximation(f: Function, r: R.Real);
