\definition zero: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zero;
\definition Point: \Set := Fin.Fin one;
\definition point: Point := Fin.zero zero;
\import topology.Topology[Carrier := Point] \as Base;
\definition singletonWhole: Base.Singleton point = Base.Whole := \axiom:setext(Base.Singleton point, Base.Whole,
  (\fun (x: Point)(_: x = point) => \refl(x)),
  (\fun (x: Point)(_: x = x) => Fin.singletonValue x));
\definition compact: Base.IsCompact Base.Discrete := \idelim Base.Singleton point = Base.Whole
  \with S: \Pow Point => Base.IsCompactIn Base.Discrete S \by {
    base: Base.Compactness[].singletonCompact Base.Discrete point, equality: singletonWhole
  };
\definition hausdorff: Base.IsT2 Base.Discrete := \fun (x, y: Point)(different: Logic.Not (x = y)) =>
  Logic.falseElim (\exists ( U: \Pow Point \where Base.RegularChoice[Base.Discrete, Base.Singleton y, x, U] ))
    (different (trans!{Point} x point y (Fin.singletonValue x) (sym!{Point} _ _ (Fin.singletonValue y))));
\definition closed: Base.IsClosedIn Base.Discrete Base.Whole := Base.IndexedIntersections[].wholeClosed Base.Discrete;
\module Real(n: N.Nat^);
\module Complex(n: N.Nat^);
\definition realLine: \exists Real[n := one].Result := Real[n := one].extension;
\definition complexLine: \exists Complex[n := one].Result := Complex[n := one].extension;
\definition realZero: \exists Real[n := zero].Result := Real[n := zero].extension;
\definition complexZero: \exists Complex[n := zero].Result := Complex[n := zero].extension;
