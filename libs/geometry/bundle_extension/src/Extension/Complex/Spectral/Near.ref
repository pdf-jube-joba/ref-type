\definition Base: \Set := \Cast[A] (domain f e);
\import Space.Subspace[S := domain f e] \as Neighborhood;
\definition topology: topology.Topology[Carrier := Base].Topology := Neighborhood.topology source;
\definition matrix[x: Base]: Entries.Matrix := e.value x;
\import Matrices.Characteristic[].Families[X := Base, source := topology] \as Families;
\definition regular: Families.Regular matrix := \fun (i, j: Fin.Fin n) =>
  topology.Continuity[A := A, B := C.Complex].Restriction[S := domain f e].restrictContinuous source Scalars.topology
    (\fun (x: A) => e.value x i j) (e.continuous i j);
\definition off[x: Base]: Matrices.Splitting[A := matrix x].OffSpectrum := \bysub(A, domain f e, x);
\import Matrices.Continuous[X := Base, source := topology, A := matrix, regular := regular, off := off] \as Recovery;
\import std.Alg[].Field[] \as Fields;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := Fields.fieldAsCommutativeRing C.Complex C.Algebra[].field] \as Spaces;
\import Spaces.Coordinates[I := Fin.Fin n] \as Coordinates;
\import Spaces.Linear[V := Matrices.Vector, W := Matrices.Vector, source := Coordinates.space, target := Coordinates.space] \as End;
\import hermitian_frames.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := linear_algebra.Hermitian[].Complex[].scalar, topological := hermitian_frames.Hermitian[].Complex[].topological].At[n := n].Families[X := Base].Matrix[m := n] \as Maps;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition projection[x: Base]: End.Map := Recovery.projection x;
\definition idempotent[x: Base]: \forall (v: Matrices.Vector) -> (projection x).apply ((projection x).apply v) = (projection x).apply v :=
  Matrices.Splitting[A := matrix x].Separated[off := off x].idempotent;
\definition projectionRegular: Maps.Regular topology projection := Recovery.projectionRegular;
\definition Fiber[x: Base]: \Set := Recovery.Bundle[].Fiber x;
\definition bundle: Bundles.Family[X := Base, F := Fiber].Bundle := Recovery.Bundle[].bundle;
