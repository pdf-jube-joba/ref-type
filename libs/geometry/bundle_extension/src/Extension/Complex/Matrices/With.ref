\definition value[x: A][i: Fin.Fin n][j: Fin.Fin m]: C.Complex := e.value x (Pair.Times^[Fin.Fin n, Fin.Fin m]::pair i j);
\definition continuous[i: Fin.Fin n][j: Fin.Fin m]: Maps.Continuous source Scalars.topology (\fun (x: A) => value x i j) := e.continuous (Pair.Times^[Fin.Fin n, Fin.Fin m]::pair i j);
\definition extends[x: Subspace.CarrierSet]: value x = f.value x := \axiom:funext(value x, f.value x,
  \fun (i: Fin.Fin n) => \axiom:funext(value x i, f.value x i,
    \fun (j: Fin.Fin m) => e.extends x (Pair.Times^[Fin.Fin n, Fin.Fin m]::pair i j)));
\definition extension: Extension[f] := Extension[f] { value := value, continuous := continuous, extends := extends };
