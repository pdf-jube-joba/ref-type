\definition originalRegular: topology.Continuity[A := Y, B := Subspace.CarrierSet].Continuous space bundle.baseSpace f :=
  \idelim Subspace.topology source = bundle.baseSpace \with t: topology.Topology[Carrier := Subspace.CarrierSet].Topology => topology.Continuity[A := Y, B := Subspace.CarrierSet].Continuous space t f \by {
    base: regular, equality: sym!{{topology.Topology[Carrier := Subspace.CarrierSet].Topology}} (bundle.baseSpace) (Subspace.topology source) same
  };
\import Bundles.Family[X := Subspace.CarrierSet, F := F].Of[bundle := bundle].Pullback[Y := Y, source := space, f := f] \as Original;
\import Bundles.Family[X := Base, F := Fiber].Of[bundle := extended].PullbackComposition[Y := Subspace.CarrierSet, Z := Y,
  first := Subspace.topology source, second := space, f := embed, g := f].Of[fRegular := embedContinuous, gRegular := regular] \as Composition;
\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].PulledIsomorphism[X := Subspace.CarrierSet, Y := Y,
  F := F, G := (\fun (x: Subspace.CarrierSet) => Fiber (embed x)), source := bundle, target := restricted, base := space, f := f,
  sourceRegular := originalRegular, targetRegular := regular] \as Pulled;
\definition original: Bundles.Family[X := Y, F := (\fun (y: Y) => F (f y))].Bundle := Original.pulled originalRegular;
\definition pulled: Bundles.Family[X := Y, F := (\fun (y: Y) => Fiber (embed (f y)))].Bundle := Composition.direct;
\definition isomorphism: Bundles.Isomorphisms[X := Y, F := (\fun (y: Y) => F (f y)), G := (\fun (y: Y) => Fiber (embed (f y))), source := original, target := pulled].Isomorphism :=
  Operations.IsomorphismComposition[X := Y, F := (\fun (y: Y) => F (f y)), G := (\fun (y: Y) => Fiber (embed (f y))), H := (\fun (y: Y) => Fiber (embed (f y))),
    source := original, middle := Composition.nested, target := pulled].compose (Pulled.isomorphism comparison)
    (Bundles.Isomorphisms[X := Y, F := (\fun (y: Y) => Fiber (embed (f y))), G := (\fun (y: Y) => Fiber (embed (f y))), source := pulled, target := Composition.nested].inverse Composition.isomorphism);
\definition formula[y: Y][v: F (f y)]: (isomorphism.forward.fiber y).apply v = (comparison.forward.fiber (f y)).apply v := \refl((comparison.forward.fiber (f y)).apply v);
