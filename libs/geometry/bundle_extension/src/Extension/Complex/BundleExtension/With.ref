\definition r: Representatives.Representative := w.representative;
\import \parent.\parent.Projections[n := r.presentation.dimension, P := projector r.presentation, regular := r.presentation.regular].With[e := w.extension] \as Extended;
\definition domain: \Pow A := Extended.domain;
\definition open: Space.IsOpenIn source domain := Extended.open;
\definition contains: Space.Subset subset domain := Extended.contains;
\definition Base: \Set := Extended.Base;
\definition topology: topology.Topology[Carrier := Base].Topology := Extended.topology;
\definition embed[x: Subspace.CarrierSet]: Base := Extended.embed x;
\definition Fiber[x: Base]: \Set := Extended.Fiber x;
\definition extended: Bundles.Family[X := Base, F := Fiber].Bundle := Extended.bundle;
\import Bundles.Family[X := Base, F := Fiber].Of[bundle := extended].Pullback[Y := Subspace.CarrierSet, source := Subspace.topology source, f := embed] \as Restriction;
\definition restricted: Bundles.Family[X := Subspace.CarrierSet, F := (\fun (x: Subspace.CarrierSet) => Fiber (embed x))].Bundle := Restriction.pulled Extended.embedContinuous;
\import bundle_operations.Operations[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Operations;
\definition comparison: Bundles.Isomorphisms[X := Subspace.CarrierSet, F := F, G := (\fun (x: Subspace.CarrierSet) => Fiber (embed x)), source := bundle, target := restricted].Isomorphism :=
  Operations.IsomorphismComposition[X := Subspace.CarrierSet, F := F, G := Presentations.Fiber r.presentation,
    H := (\fun (x: Subspace.CarrierSet) => Fiber (embed x)), source := bundle, middle := Presentations.bundle r.presentation, target := restricted].compose r.isomorphism Extended.comparison;
\definition embedContinuous: topology.Continuity[A := Subspace.CarrierSet, B := Base].Continuous (Subspace.topology source) topology embed := Extended.embedContinuous;
\module Pullback(Y: \Set, space: topology.Topology[Carrier := Y].Topology, f: Y -> Subspace.CarrierSet,
  regular: topology.Continuity[A := Y, B := Subspace.CarrierSet].Continuous space (Subspace.topology source) f);
