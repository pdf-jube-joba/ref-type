\definition addDistance[a, b, c: R.Real]: D.Le (R.distance (R.add a b) (R.add a c)) (R.distance b c) :=
  D.leReplaceRight _ (R.add (R.distance a a) (R.distance b c)) (R.distance b c)
    (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (\fun (x: R.Real) => R.add x (R.distance b c)) _ _ (Distance.distanceSelf a))
      (Laws.addZeroLeft (R.distance b c))) (Estimates.distanceAdd a b a c);
\definition subtract[a, b, c: R.Real]: D.Le (R.distance a (R.add b c)) (R.distance (R.sub a b) c) :=
  D.leReplaceLeft (R.distance (R.add b (R.sub a b)) (R.add b c)) (R.distance a (R.add b c)) _
    (congr!{R.Real R.Real} (\fun (x: R.Real) => R.distance x (R.add b c)) _ _ (Estimates.addSubCancel a b))
    (addDistance b (R.sub a b) c);
\definition increment[a, c: R.Real]: D.Le (R.distance a (R.add a c)) (R.distance R.zero c) :=
  D.leReplaceLeft (R.distance (R.add a R.zero) (R.add a c)) (R.distance a (R.add a c)) _
    (congr!{R.Real R.Real} (\fun (x: R.Real) => R.distance x (R.add a c)) _ _ (Laws.addZeroRight a))
    (addDistance a R.zero c);
\definition residual[a, b: R.Real]: R.distance R.zero (R.sub a b) = R.distance a b :=
  trans!{R.Real} _ _ _ (Distance.distanceSymmetric R.zero (R.sub a b)) (Estimates.distanceDifference a b);
