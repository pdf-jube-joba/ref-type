\import Native.Through[a := a, w := w] \as Local;
\import Shrinking.With[w := w] \as Compact;
\import \root.Extension[].RealIsomorphisms[X := Local.ClosedPoint, subset := Local.closedSubset, F := (\fun (x: Local.ClosedPoint) => F (Local.toOpen x)), G := (\fun (x: Local.ClosedPoint) => G (Local.toOpen x)),
  source := Local.first, target := Local.second, same := \refl(Local.closedSpace)] \as ExtensionAPI;
\definition exists: topology.Topology[Carrier := X].IsCompact topology -> topology.Topology[Carrier := X].IsT2 topology ->
  topology.Topology[Carrier := X].IsClosedIn topology subset -> \exists Result[a] := \block {
  \fun (compact: _)(hausdorff: _)(closed: _) \then
  \takefrom e: ExtensionAPI.Result[Local.reduced] \by ExtensionAPI.extend Local.reduced (Compact.compact compact) (Compact.hausdorff hausdorff) (Compact.subsetClosed closed) \then
  \return Local.WithExtension[e := e].exists
};
