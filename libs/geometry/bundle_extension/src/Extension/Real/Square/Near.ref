\definition Base: \Set := \Cast[A] (domain f e);
\import Space.Subspace[S := domain f e] \as Neighborhood;
\definition topology: topology.Topology[Carrier := Base].Topology := Neighborhood.topology source;
\definition value[x: Base]: Inversion.Nonsingular := \into[M.Matrix](e.value x, Inversion.Nonsingular) \by {
  \bysub(A, domain f e, x)
};
\import Hermitian.Square[].Families[X := Base] \as LocalFamilies;
\definition regular: LocalFamilies.Regular topology (\fun (x: Base) => value x) :=
  \fun (i, j: Fin.Fin n) => topology.Continuity[A := A, B := R.Real].Restriction[S := domain f e].restrictContinuous source hermitian_frames.Hermitian[].Real[].topological.space
    (\fun (x: A) => e.value x i j) (e.continuous i j);
\definition inverse[x: Base]: M.Matrix := Inversion.formula (value x);
\definition inverseRegular: LocalFamilies.Regular topology inverse := LocalFamilies.inverseRegular topology (\fun (x: Base) => value x) regular
  (\fun (x: Base) => \bysub(M.Matrix, Inversion.Nonsingular, value x));
\definition laws[x: Base]: M.Operations[].InverseLaws[value x, inverse x] := M.Operations[].inverseLaws (value x) (Inversion.inverse (value x));
