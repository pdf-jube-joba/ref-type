\import \root.Extension[].Real[A := Point, source := Base.Discrete, subset := Base.Whole].Matrices[m := n, n := n] \as Entries;
\import \root.Extension[].Real[A := Point, source := Base.Discrete, subset := Base.Whole].Square[n := n] \as Square;
\import std.Alg[].Field[] \as Fields;
\import matrix_invariants.Ring[K := R.Real, scalars := Fields.fieldAsCommutativeRing R.Real R.Algebra[].field].At[n := n] \as M;
\import matrix_invariants.Field[K := R.Real, field := R.Algebra[].field].At[n := n] \as Inversion;
\import metric_spaces.RealFunctions[A := \Cast[Point] Base.Whole] \as Functions;
\definition identity: Entries.Function := Entries.Function {
  value := \fun (_: \Cast[Point] Base.Whole) => M.identity,
  continuous := \fun (i, j: Fin.Fin n) => Functions.constantContinuous
    (Base.Subspace[S := Base.Whole].topology Base.Discrete) (M.identity i j),
};
\definition nonzero[x: \Cast[Point] Base.Whole]: Inversion.Nonzero (identity.value x) :=
  \fun (zero: _) => R.Algebra[].field.nontrivial
    (trans!{R.Real} R.zero (M.determinant M.identity) R.one (sym!{R.Real} _ _ zero) M.atIdentity);
\definition Result: \Set := Square.Witness[identity];
\definition extension: \exists Result := Square.exists identity compact hausdorff closed nonzero;
