\import \root.Extension[].Real[A := Point, source := Base.Discrete, subset := Base.Whole].Matrices[m := n, n := n] \as Entries;
\import \root.Extension[].Real[A := Point, source := Base.Discrete, subset := Base.Whole].Square[n := n] \as Square;
\import matrix_invariants.Real[].At[n := n] \as Matrices;
\import metric_spaces.RealFunctions[A := \Cast[Point] Base.Whole] \as Functions;
\definition identity: Entries.Function := Entries.Function {
  value := \fun (_: \Cast[Point] Base.Whole) => Matrices.Matrix.identity,
  continuous := \fun (i, j: Fin.Fin n) => Functions.constantContinuous
    (Base.Subspace[S := Base.Whole].topology Base.Discrete) (Matrices.Matrix.identity i j),
};
\definition nonzero[x: \Cast[Point] Base.Whole]: Matrices.Inversion.Nonzero (identity.value x) :=
  \fun (zero: _) => R.Algebra[].field.nontrivial
    (trans!{R.Real} R.zero (Matrices.Matrix.determinant Matrices.Matrix.identity) R.one (sym!{R.Real} _ _ zero) Matrices.Matrix.atIdentity);
\definition extension: \exists Square.Witness[identity] := Square.exists identity compact hausdorff closed nonzero;
