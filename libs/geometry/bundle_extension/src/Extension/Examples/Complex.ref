\import complex.Complex[] \as C;
\import \root.Extension[].Complex[A := Point, source := Base.Discrete, subset := Base.Whole].Matrices[m := n, n := n] \as Entries;
\import \root.Extension[].Complex[A := Point, source := Base.Discrete, subset := Base.Whole].Square[n := n] \as Square;
\import matrix_invariants.Complex[].At[n := n] \as Matrices;
\import topology.Maps[A := \Cast[Point] Base.Whole, B := C.Complex] \as Functions;
\definition identity: Entries.Function := Entries.Function {
  value := \fun (_: \Cast[Point] Base.Whole) => Matrices.Matrix.identity,
  continuous := \fun (i, j: Fin.Fin n) => Functions.constantContinuous
    (Base.Subspace[S := Base.Whole].topology Base.Discrete) topological_algebra.Complex[].topology (Matrices.Matrix.identity i j),
};
\definition nonzero[x: \Cast[Point] Base.Whole]: Matrices.Inversion.Nonzero (identity.value x) :=
  \fun (zero: _) => C.Algebra[].field.nontrivial
    (trans!{C.Complex} C.Algebra[].field.zero (Matrices.Matrix.determinant Matrices.Matrix.identity) C.Algebra[].field.one
      (sym!{C.Complex} _ _ zero) Matrices.Matrix.atIdentity);
\definition extension: \exists Square.Witness[identity] := Square.exists identity compact hausdorff closed nonzero;
