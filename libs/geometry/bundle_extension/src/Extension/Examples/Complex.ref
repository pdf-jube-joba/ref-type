\import complex.Complex[] \as C;
\import \root.Extension[].Complex[A := Point, source := Base.Discrete, subset := Base.Whole].Matrices[m := n, n := n] \as Entries;
\import \root.Extension[].Complex[A := Point, source := Base.Discrete, subset := Base.Whole].Square[n := n] \as Square;
\import std.Alg[].Field[] \as Fields;
\import matrix_invariants.Ring[K := C.Complex, scalars := Fields.fieldAsCommutativeRing C.Complex C.Algebra[].field].At[n := n] \as M;
\import matrix_invariants.Field[K := C.Complex, field := C.Algebra[].field].At[n := n] \as Inversion;
\import topology.Maps[A := \Cast[Point] Base.Whole, B := C.Complex] \as Functions;
\definition identity: Entries.Function := Entries.Function {
  value := \fun (_: \Cast[Point] Base.Whole) => M.identity,
  continuous := \fun (i, j: Fin.Fin n) => Functions.constantContinuous
    (Base.Subspace[S := Base.Whole].topology Base.Discrete) topological_algebra.Complex[].topology (M.identity i j),
};
\definition nonzero[x: \Cast[Point] Base.Whole]: Inversion.Nonzero (identity.value x) :=
  \fun (zero: _) => C.Algebra[].field.nontrivial
    (trans!{C.Complex} C.Algebra[].field.zero (M.determinant M.identity) C.Algebra[].field.one
      (sym!{C.Complex} _ _ zero) M.atIdentity);
\definition Result: \Set := Square.Witness[identity];
\definition extension: \exists Result := Square.exists identity compact hausdorff closed nonzero;
