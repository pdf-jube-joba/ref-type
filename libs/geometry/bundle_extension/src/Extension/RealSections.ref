\import \root.Extension[].Sections[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar,
  A := A, subset := subset, F := F, bundle := bundle] \as Native;
\module With(s: Native.Section, embedding: Native.Embeddings.Embedding);
\definition extend[s: Native.Section]: topology.Topology[Carrier := A].IsCompact bundle.baseSpace -> topology.Topology[Carrier := A].IsT2 bundle.baseSpace ->
  topology.Topology[Carrier := A].IsClosedIn bundle.baseSpace subset -> \exists Native.Extension[s] := \block {
  \fun (compact: _)(hausdorff: _)(closed: _) \then
  \takefrom embedding: Native.Embeddings.Embedding \by Native.Embeddings.embeddingExists compact hausdorff \then
  \return With[s := s, embedding := embedding].exists compact hausdorff closed
};
