\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as D;
\import D.Order[] \as Order;
\import D.Arithmetic[].Prop[] \as Laws;
\import R.Algebra[] \as Algebra;
\import R.Distance[] \as Distance;
\import R.Estimates[] \as Estimates;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\use Equality.eq_reason_in;
\import std.Data[].Nat[] \as N;
\import N.Basic[].Def[] \as NatOp;
\import N.Basic[].Prop[] \as Nat;
\import N.Order[].Prop[] \as NatOrder;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Pair[] \as Pair;
\import std.Alg[].Field[] \as Fields;
\import complex.Complex[] \as C;
\module RealLinear(n: N.Nat^);
\module Radii(r: R.Real);
\module Translation;
\module MetricBudget(A: \Set, metric: metric_spaces.MetricSpace[Carrier := A].Metric, s: N.Nat^ -> A, b: N.Nat^ -> R.Real);
\module Correction(r: R.Real);
\module Real(A: \Set, source: topology.Topology[Carrier := A].Topology, subset: \Pow A);
\module Complex(A: \Set, source: topology.Topology[Carrier := A].Topology, subset: \Pow A);
\module Examples;
\module Sections(K: \Set, field: Fields.Field[K], conjugation: linear_algebra.Hermitian[].Scalar[K, field],
  scalar: vector_bundles.Bundles[].Scalar[K, field, conjugation], A: \Set, subset: \Pow A,
  F: A -> \Set, bundle: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := A, F := F].Bundle);
\import vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as RealBundles;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as ComplexBundles;
\module RealSections(A: \Set, subset: \Pow A, F: A -> \Set, bundle: RealBundles.Family[X := A, F := F].Bundle);
\module ComplexSections(A: \Set, subset: \Pow A, F: A -> \Set, bundle: ComplexBundles.Family[X := A, F := F].Bundle);
\import bundle_complements.Complements[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as RealComplements;
\import hermitian_frames.Hermitian[].Over[K := R.Real, field := R.Algebra[].field, scalar := linear_algebra.Hermitian[].Real[].scalar, topological := hermitian_frames.Hermitian[].Real[].topological] \as RealHermitian;
\module RealProjections(A: \Set, source: topology.Topology[Carrier := A].Topology, subset: \Pow A, n: N.Nat^,
  P: (\Cast[A] subset) -> RealComplements.Idempotents[n := n].Projection,
  regular: RealHermitian.At[n := n].Families[X := \Cast[A] subset].Matrix[m := n].Regular
    (topology.Topology[Carrier := A].Subspace[S := subset].topology source) (\fun (x: \Cast[A] subset) => (P x).map));
\module RealBundleExtension(A: \Set, source: topology.Topology[Carrier := A].Topology, subset: \Pow A, F: (\Cast[A] subset) -> \Set,
  bundle: RealBundles.Family[X := \Cast[A] subset, F := F].Bundle,
  same: bundle.baseSpace = topology.Topology[Carrier := A].Subspace[S := subset].topology source);
