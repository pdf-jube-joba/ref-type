\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import real.Analysis[] \as R;
\import complex.Complex[] \as C;
\import C.Def[] \as Op;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing C.Complex C.Algebra[].field] \as Spaces;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real R.Algebra[].field] \as Reals;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := linear_algebra.Hermitian[].Complex[].scalar].Sums[] \as Sums;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import smooth_bundles.ComplexCoordinates[n := n, r := r] \as Coordinates;
\definition realRank: N.Nat^ := Coordinates.rank;
\module On(U: Open.OpenSet);

\import Spaces.Coordinates[I := Fin.Fin r] \as Vectors;
\import Reals.Coordinates[I := Fin.Fin realRank] \as RealVectors;
\import Spaces.Linear[V := Vectors.Vector, W := Vectors.Vector, source := Vectors.space, target := Vectors.space] \as End;
\import Reals.Linear[V := RealVectors.Vector, W := RealVectors.Vector, source := RealVectors.space, target := RealVectors.space] \as RealEnd;
\import \root.Complex[n := n, r := r].Structure[] \as Structure;
\import bundle_operations.Operations[].Scalars[].RealCoordinates[n := r] \as RealCoordinates;
\import bundle_operations.Operations[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].RealScalars[V := Vectors.Vector, space := Vectors.space] \as Restricted;
\module Linearization(A: RealEnd.Map, commuting: \forall (v: RealVectors.Vector) -> A.apply (Structure.J.apply v) = Structure.J.apply (A.apply v));
\module Transport(U, V: Open.OpenSet);
