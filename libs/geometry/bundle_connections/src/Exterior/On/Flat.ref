\import \parent.Of[connection := Local.flat, k := k, enumeration := enumeration] \as Exterior;
\import R.FiniteSums[] \as Sums;
\definition coefficient: \forall (i: Fin.Fin n)(a, b: Fin.Fin Exterior.rank) -> Exterior.coefficient i a b = Functions.origin :=
  \fun (i: Fin.Fin n)(a, b: Fin.Fin Exterior.rank) => Functions.ext (Exterior.coefficient i a b) Functions.origin
    (\fun (x: Open.Carrier U) => trans!{{R.Real}} _ _ _
      (Sums.congruent k (\fun (slot: Fin.Fin k) => Sums.sum r (\fun (c: Fin.Fin r) => R.mul (Exterior.entry a b slot c) R.zero))
        (\fun (slot: Fin.Fin k) => R.zero)
        (\fun (slot: Fin.Fin k) => trans!{{R.Real}} _ _ _
          (Sums.congruent r (\fun (c: Fin.Fin r) => R.mul (Exterior.entry a b slot c) R.zero) (\fun (c: Fin.Fin r) => R.zero)
            (\fun (c: Fin.Fin r) => Spaces.mulZeroRight (Exterior.entry a b slot c))) (Sums.zeroSum r)))
      (Sums.zeroSum k));
