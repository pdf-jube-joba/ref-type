\import euclidean_forms.Euclidean[n := n].On[U := U] \as Scalar;
\definition Form[k: N.Nat^]: \Set := Fin.Fin r -> Scalar.Form k;
\structure Connection: \Set := { matrix: Fin.Fin r -> Fin.Fin r -> Scalar.Form one };
\definition flat: Connection := Connection { matrix := \fun (a, b: Fin.Fin r) => Scalar.At[k := one].zero };
\module At(k: N.Nat^);
\module Covariant(k: N.Nat^, connection: Connection);
\module Coordinates(connection: \root.Local[n := n, r := r].On[U := U].Connection);
\module Identity;
\module Coefficients(connection: Connection);
