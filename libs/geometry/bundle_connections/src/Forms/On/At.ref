\import Scalar.At[k := k] \as Values;
\definition plus[omega, eta: Form k]: Form k := \fun (a: Fin.Fin r) => Values.plus (omega a) (eta a);
\definition scale[c: R.Real][omega: Form k]: Form k := \fun (a: Fin.Fin r) => Values.scale c (omega a);
\definition origin: Form k := \fun (a: Fin.Fin r) => Values.zero;
