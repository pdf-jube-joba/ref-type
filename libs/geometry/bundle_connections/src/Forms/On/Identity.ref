\import calculus.Identity[n := n] \as Identity;
\import \root.Pullback[n := n, m := n, r := r].Between[U := U, V := U, f := Identity.map U] \as Pull;
\import euclidean_forms.Euclidean[n := n].Identity[U := U] \as ScalarIdentity;
\definition form: \forall (k: N.Nat^)(omega: Form k) -> Pull.form k omega = omega :=
  \fun (k: N.Nat^)(omega: Form k) => \axiom:funext(Pull.form k omega, omega, \fun (a: Fin.Fin r) => ScalarIdentity.law k (omega a));
\definition matrix: \forall (A: Connection)(a, b: Fin.Fin r) -> (Pull.connection A).matrix a b = A.matrix a b :=
  \fun (A: Connection)(a, b: Fin.Fin r) => ScalarIdentity.law one (A.matrix a b);
