\import linear_algebra.Commutative[K := C.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing C.Complex Algebra.field] \as Spaces;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := Algebra.field, scalar := linear_algebra.Hermitian[].Complex[].scalar] \as Geometry;
\import Geometry.Finite[n := r] \as E;
\import Geometry.Inner[V := E.Vector, space := E.space] \as Inner;
\import Spaces.Linear[V := E.Vector, W := E.Vector, source := E.space, target := E.space] \as End;
\import Spaces.Eigen[V := E.Vector, space := E.space] \as Eigen;
\import Spaces.Laws[V := E.Vector, space := E.space] \as VectorLaws;
