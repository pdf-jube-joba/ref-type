\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import real.Analysis[] \as R;
\import complex.Complex[] \as C;
\import C.Def[] \as Op;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing C.Complex C.Algebra[].field] \as Spaces;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real R.Algebra[].field] \as RealSpaces;
\import smooth_bundles.ComplexCoordinates[n := n, r := r] \as Coordinates;
\import bundle_operations.Operations[].Scalars[].RealCoordinates[n := r] \as RealCoordinates;
\import bundle_operations.Operations[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Operations;
\definition realRank: N.Nat^ := Coordinates.rank;
\import Spaces.Coordinates[I := Fin.Fin r] \as Vectors;
\import RealSpaces.Coordinates[I := Fin.Fin realRank] \as RealVectors;
\import Operations.RealScalars[V := Vectors.Vector, space := Vectors.space] \as Restricted;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\module Structure;
\import manifolds.Dimension[n := n].Smooth[] \as Manifolds;
\module On(M: Manifolds.Manifold);
\module Transport(U, V: Open.OpenSet);

\import linear_algebra.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := linear_algebra.Hermitian[].Complex[].scalar] \as Hermitian;
\module RealMetric(V: \Set, space: Spaces.VectorSpace V, h: Hermitian.Inner[V := V, space := space].Form);

\module Conjugation;
