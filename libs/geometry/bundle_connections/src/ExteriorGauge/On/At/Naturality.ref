\import \parent.Algebra[] \as Algebra;
\import \parent.Tangent[] \as Tangent;
\import Spaces.Sums[I := Fin.Fin rank] \as Coefficients;
\definition gauge: \forall (T: Matrix.Matrix0)(i: Fin.Fin n)(x: Open.Carrier U)(A, B: Algebra.Numeric) ->
  Algebra.product (Tangent.eval T x) A = Tangent.plus (Tangent.partial T i x) (Algebra.product B (Tangent.eval T x)) ->
  \forall (a, b: Fin.Fin rank) ->
  Coefficients.sum (Fin.elements rank) (\fun (c: Fin.Fin rank) => R.mul (representation T a c x) (Tangent.action A c b)) =
  R.add (Derivatives.apply i (representation T a b) x) (Coefficients.sum (Fin.elements rank) (\fun (c: Fin.Fin rank) => R.mul (Tangent.action B a c) (representation T c b x))) :=
  \fun (T: Matrix.Matrix0)(i: Fin.Fin n)(x: Open.Carrier U)(A, B: Algebra.Numeric)(compatible: _)(a, b: Fin.Fin rank) => trans!{{R.Real}}
    (Coefficients.sum (Fin.elements rank) (\fun (c: Fin.Fin rank) => R.mul (representation T a c x) (Tangent.action A c b)))
    (R.add (Tangent.value (Tangent.eval T x) (Tangent.partial T i x) a b) (Coefficients.sum (Fin.elements rank) (\fun (c: Fin.Fin rank) => R.mul (Tangent.action B a c) (representation T c b x))))
    (R.add (Derivatives.apply i (representation T a b) x) (Coefficients.sum (Fin.elements rank) (\fun (c: Fin.Fin rank) => R.mul (Tangent.action B a c) (representation T c b x))))
    (\parent.Jet[i := i, x := x].gauge (Tangent.eval T x) A B (Tangent.partial T i x) compatible a b)
    (congr!{{R.Real} {R.Real}} (\fun (z: R.Real) => R.add z (Coefficients.sum (Fin.elements rank) (\fun (c: Fin.Fin rank) => R.mul (Tangent.action B a c) (representation T c b x))))
      _ _ (sym!{{R.Real}} _ _ (Tangent.differential T i a b x)));
