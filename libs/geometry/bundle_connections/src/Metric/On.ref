\import Smooth.Algebra[U := U] \as Functions;
\import Smooth.Derivative[].Linear[U := U] \as Derivatives;
\definition Family: \Set := Open.Carrier U -> Inner.Form;
\definition Coefficient[h: Family][a, b: Fin.Fin r][x: Open.Carrier U]: R.Real := (h x).dot (E.basis a) (E.basis b);
\structure Metric: \Set := {
  form: Family,
  positive: \forall (x: Open.Carrier U) -> Inner.Positive[form x],
  smooth: \forall (a, b: Fin.Fin r) -> Smooth.SmoothOn U (Coefficient form a b),
};
\module Of(metric: Metric);
\module Standard;
