\import linear_algebra.Euclidean[n := r] \as Real;
\import std.Data[].Bool[] \as Bool;
\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as NatLaws;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\import Spaces.Coordinates[I := Fin.Fin r].Kronecker[] \as Delta;
\definition equal: \forall (i: Fin.Fin r) -> Real.basis i = E.basis i :=
  \fun (i: Fin.Fin r) => \axiom:funext(Real.basis i, E.basis i, \fun (j: Fin.Fin r) =>
    either!{{Classical.excludedMiddle (i = j)} {Real.basis i j = E.basis i j}
      {\fun (same: i = j) => trans!{{R.Real}} _ _ _
        (congr!{{Bool.Bool^} {R.Real}} (\fun (b: Bool.Bool^) => Bool.ite R.Real b R.one R.zero) _ _
          (NatLaws.eqbTrueOfEq j i (sym!{{Fin.Fin r}} _ _ same)))
        (sym!{{R.Real}} _ _ (Delta.equal i j same))}
      {\fun (different: Logic.Not (i = j)) => trans!{{R.Real}} _ _ _
        (congr!{{Bool.Bool^} {R.Real}} (\fun (b: Bool.Bool^) => Bool.ite R.Real b R.one R.zero) _ _
          (NatLaws.eqbFalseOfNe j i (\fun (same: j = i) => different (sym!{{Fin.Fin r}} _ _ same))))
        (sym!{{R.Real}} _ _ (Delta.different i j different))}});
