\definition chart: \Cast[Charts.Chart] M.atlas.charts := (bundle.atlas.local i).chart;
\import \root.ComplexMetric[n := n, r := r].On[U := chart.image] \as Local;
\module At(u: Open.Carrier chart.image);
\definition form[u: Open.Carrier chart.image]: Inner.Form := At[u := u].form;
\definition positive: \forall (u: Open.Carrier chart.image) -> Inner.Positive[form u] := \fun (u: Open.Carrier chart.image) => At[u := u].positive;
\definition smooth: \forall (a, b: Fin.Fin r) -> smooth_bundles.ComplexCalculus[n := n].On[U := chart.image].Smooth
  (\fun (u: Open.Carrier chart.image) => (form u).dot (E.basis a) (E.basis b)) :=
  \fun (a, b: Fin.Fin r) => (\bysub(Metrics.Data, { h: Metrics.Data \where Metrics.Smooth h }, metric)) i a b;
\definition local: Local.Metric := Local.Coefficients[form := form, positive := positive, smooth := smooth].metric;
\definition connection: Local.Connection := Local.Of[metric := local].connection;
