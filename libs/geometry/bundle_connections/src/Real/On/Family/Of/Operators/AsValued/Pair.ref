\import \parent.\parent.OnePair[i := i, j := j] \as Original;
\import Target.Pair[i := i, j := j] \as New;
\import \parent.\parent.\parent.Pair[i := i, j := j] \as Gauge;
\import Charts.Transition[left := chart i, right := chart j] \as Transition;
\import Euclidean.On[U := Transition.domain] \as Scalar;
\import \root.MatrixCalculus[n := n, r := r].On[U := Transition.domain] \as Matrices;
\import Spaces.FiniteCoordinateEnumeration[] \as Enumeration;
\definition law: Target.Pair[i := i, j := j].Compatible (omega i) (omega j) :=
  \fun (a: Fin.Fin r) => Scalar.ext one (New.action (omega i) a) (New.target (omega j) a)
    (\fun (u: Open.Carrier Transition.domain)(arguments: Fin.Fin one -> Fin.Fin n -> R.Real) => trans!{{R.Real}} _ _ _
      (New.value (omega i) a u arguments)
      (trans!{{R.Real}} _ _ _
        (Enumeration.sumLaw r (\fun (b: Fin.Fin r) => R.mul (Gauge.transition a b u) (New.source (omega i) b u arguments)))
        (trans!{{R.Real}} _ _ _
          (sym!{{R.Real}} _ _ (Matrices.value01 Gauge.transition (Original.source (omega i)) a a u arguments))
          (congr!{{Scalar.Form one} {R.Real}} (\fun (alpha: Scalar.Form one) => alpha u arguments) _ _
            ((\bysub(OneData, { w: OneData \where OneCompatible w }, omega)) i j a a)))));
