\import Scalars.Neighborhood[c := c, U := neighborhood.openSet, open := neighborhood.open] \as Region;
\definition tail: \forall (t: Open.Carrier Region.domain) -> Tail (Open.inclusion Region.domain c.image Region.included t) neighborhood.bound :=
  \fun (t: Open.Carrier Region.domain)(k: N.Nat^)(later: _) =>
    \parent.\parent.\parent.Term[k := k, j := j, a := a, b := b].zeroOffSupport (Open.inclusion Region.domain c.image Region.included t)
      (neighborhood.avoids k later (Charts.point c (Open.inclusion Region.domain c.image Region.included t)) (Region.point t));
\definition patch: Local.Patch := Local.Patch { domain := Region.domain, included := Region.included,
  smooth := smooth_partitions.Euclidean[n := n].smoothCongruent Region.domain
    (Open.restrict Region.domain c.image Region.included (\fun (v: Open.Carrier c.image) => prefix v neighborhood.bound arguments))
    (Open.restrict Region.domain c.image Region.included f)
    (\fun (t: Open.Carrier Region.domain) => sym!{{R.Real}} _ _
      (congr!{{Alternating.Form one} {R.Real}} (\fun (omega: Alternating.Form one) => omega arguments) _ _
        (formula (Open.inclusion Region.domain c.image Region.included t) neighborhood.bound (tail t))))
    (Open.Restriction[].localSmooth Region.domain c.image Region.included
      (\fun (v: Open.Carrier c.image) => prefix v neighborhood.bound arguments) (prefixSmooth arguments neighborhood.bound))
};
\definition contains: Local.Contains patch u := Region.contains u neighborhood.contains;
