\import Bundle.Dual[] \as Dual;
\import Bundle.Exterior[k := k, enumeration := enumeration] \as Exterior;
\import \root.Real[n := n, r := Exterior.rank].On[M := M].Family[F := Exterior.Fiber, space := Exterior.fiberSpace].Of[I := I, bundle := Exterior.exterior] \as Result;
\import smooth_bundles.Real[n := n, r := r].On[M := M].Family[F := Dual.Fiber, space := Dual.fiberSpace].Of[I := I, bundle := Dual.dual] \as DualBundle;
\import DualBundle.Alternating[k := k, enumeration := enumeration] \as Alternating;
\module Pair(i, j: I);
\module Forms(U: Open.OpenSet);
\definition data: Result.Data := \fun (i: I) => \root.Forms[n := n, r := Exterior.rank].On[U := (chart i).image].Connection {
  matrix := Forms[U := (chart i).image].lift ((connection i).matrix)
};
\module Transport(i, j: I);
\definition compatibility: Result.Compatible data := \fun (i, j: I) => Transport[i := i, j := j].law;
\definition value: Result.Connection := \into[Result.Data](data, Result.Connection) \by { compatibility };
