\import euclidean_forms.Euclidean[n := n].On[U := (chart i).image] \as LocalForms;
\import Open.Smooth[].Algebra[U := (chart i).image] \as Functions;
\import \root.TensorIndex[r := r, s := Alternating.rank].Using[enumeration := enumeration] \as Indices;
\definition coefficient[a: Fin.Fin Forms.rank]: Functions.Function := LocalForms.coefficient one (omega i (Indices.row a)) (Alternating.indices (Indices.col a));
\module At(u: Open.Carrier (chart i).image);
\definition formula: \forall (a: Fin.Fin Forms.rank)(u: Open.Carrier (chart i).image) -> FormSections.coefficient (data omega) i a u = coefficient a u :=
  \fun (a: Fin.Fin Forms.rank)(u: Open.Carrier (chart i).image) => At[u := u].formula a;
\definition regular: \forall (a: Fin.Fin Forms.rank) -> Open.Smooth[].SmoothOn (chart i).image (FormSections.coefficient (data omega) i a) :=
  \fun (a: Fin.Fin Forms.rank) => smooth_partitions.Euclidean[n := n].smoothCongruent (chart i).image (coefficient a) (FormSections.coefficient (data omega) i a)
    (\fun (u: Open.Carrier (chart i).image) => sym!{{R.Real}} _ _ (formula a u)) (\bysub(Open.ScalarFunction (chart i).image, Functions.Predicate, coefficient a));
