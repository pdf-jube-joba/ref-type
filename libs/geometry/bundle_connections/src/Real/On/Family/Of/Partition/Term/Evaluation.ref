\definition f[u: Open.Carrier c.image]: R.Real := value u arguments;
\import Open.LocalSmooth[U := c.image, f := f] \as Local;
\definition smooth: Smooth.SmoothOn c.image f := Local.smooth (\fun (u: Open.Carrier c.image) =>
  either!{{Classical.excludedMiddle (Base.Member d.domain (Charts.point c u))} {\exists \Cast[Local.Patch] (Local.Patches u)}
    {\fun (member: _) => Logic.existsIntro[Local.Patch, Local.Patches u]
      (Local.Patch { domain := Transition.domain, included := Gauge.included,
        smooth := Scalar.smoothOfEqual (Scalar.evaluate one expression arguments) (Open.restrict Transition.domain c.image Gauge.included f)
          (\fun (t: Open.Carrier Transition.domain) => sym!{{R.Real}} _ _
            (congr!{{Alternating.Form one} {R.Real}} (\fun (omega: Alternating.Form one) => omega arguments) _ _ (inside t)))
          (\bysub(Open.ScalarFunction Transition.domain, { g: Open.ScalarFunction Transition.domain \where Smooth.SmoothOn Transition.domain g }, Scalar.evaluate one expression arguments))
      }) (Transition.intro u member)}
    {\fun (outside: _) => Logic.existsIntro[Local.Patch, Local.Patches u]
      (Local.Patch { domain := Away.domain, included := Away.included,
        smooth := smooth_partitions.Euclidean[n := n].smoothCongruent Away.domain (\fun (t: Open.Carrier Away.domain) => R.zero)
          (Open.restrict Away.domain c.image Away.included f)
          (\fun (t: Open.Carrier Away.domain) => sym!{{R.Real}} _ _
            (congr!{{Alternating.Form one} {R.Real}} (\fun (omega: Alternating.Form one) => omega arguments) _ _
              (zeroOffSupport (Open.inclusion Away.domain c.image Away.included t) (Away.point t))))
          (SmoothOperations.constantSmooth Away.domain R.zero)
      }) (Away.contains u (\fun (member: _) => outside (included (Charts.point c u) member)))}});
