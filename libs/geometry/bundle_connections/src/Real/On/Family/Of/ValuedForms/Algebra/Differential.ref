\import \root.GlobalForms[n := n, r := r].OnManifold[M := M].Family[F := F, space := space].Of[I := I, bundle := bundle].At[k := k] \as D;
\import \parent.\parent.\parent.ValuedForms[k := N.Nat^::succ k].Algebra[] \as Target;
\module Local(A: Connection, i: I);
\definition addition: \forall (A: Connection)(omega, eta: Form) -> D.apply A (plus omega eta) = Target.plus (D.apply A omega) (D.apply A eta) :=
  \fun (A: Connection)(omega, eta: Form) => \axiom:funext(D.apply A (plus omega eta), Target.plus (D.apply A omega) (D.apply A eta),
    \fun (i: I) => Local[A := A, i := i].addition (omega i) (eta i));
\definition scalar: \forall (A: Connection)(c: R.Real)(omega: Form) -> D.apply A (scale c omega) = Target.scale c (D.apply A omega) :=
  \fun (A: Connection)(c: R.Real)(omega: Form) => \axiom:funext(D.apply A (scale c omega), Target.scale c (D.apply A omega),
    \fun (i: I) => Local[A := A, i := i].scalar c (omega i));
