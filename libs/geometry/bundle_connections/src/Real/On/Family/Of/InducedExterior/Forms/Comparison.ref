\import \root.Forms[n := n, r := r].On[U := U] \as OriginalForms;
\definition connection: OriginalForms.Connection := OriginalForms.Connection { matrix := A };
\import OriginalForms.Coefficients[connection := connection] \as Coefficients;
\import \root.Exterior[n := n, r := r].On[U := U].Of[connection := Coefficients.local, k := k, enumeration := enumeration] \as Local;
\import Open.Smooth[].Algebra[U := U] \as Functions;
\definition coefficient: \forall (i: Fin.Fin n)(a, b: Fin.Fin Exterior.rank) -> Scalar.coefficient one (lift A a b) (\fun (slot: Fin.Fin one) => i) = Local.coefficient i a b :=
  \fun (i: Fin.Fin n)(a, b: Fin.Fin Exterior.rank) => Functions.ext
    (Scalar.coefficient one (lift A a b) (\fun (slot: Fin.Fin one) => i)) (Local.coefficient i a b)
    (\fun (u: Open.Carrier U) => value A a b u (\fun (slot: Fin.Fin one) => Spaces.FiniteCoordinates[n := n].vectors i));
