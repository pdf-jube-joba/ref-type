\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\import Spaces.Multilinear[V := Vectors.Vector, space := Vectors.space] \as Multilinear;
\import Multilinear.Alternating[] \as Alternating;
\import Alternating.At[k := one] \as Covectors;
\import Open.Smooth[] \as Smooth;
\import Smooth.Operations[] \as SmoothOperations;
\module Term(k: N.Nat^, j: I, a, b: Fin.Fin r);

\import N.Basic[].Prop[] \as Nat;
\import N.Basic[].Def[] \as Arithmetic;
\import N.Order[].Prop[] \as NaturalOrder;
\import Spaces.Laws[V := Alternating.Form one, space := Covectors.vectorSpace] \as CovectorLaws;
\module Entry(j: I, a, b: Fin.Fin r);
\definition matrix[j: I][a, b: Fin.Fin r]: Euclidean.On[U := (chart j).image].Form one := Entry[j := j, a := a, b := b].form;
\definition data: Data := \fun (j: I) => \root.Forms[n := n, r := r].On[U := (chart j).image].Connection { matrix := matrix j };
\module Pair(k: N.Nat^, i, j: I);
\module Gluing(i, j: I);
\definition compatible: Compatible data := \fun (i, j: I) => Gluing[i := i, j := j].compatible;
\definition connection: Connection := \into[Data](data, Connection) \by { compatible };
