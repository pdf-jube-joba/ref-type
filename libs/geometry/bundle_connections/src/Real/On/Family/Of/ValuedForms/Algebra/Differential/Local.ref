\import \root.Forms[n := n, r := r].On[U := (chart i).image] \as Forms;
\import Forms.Covariant[k := k, connection := A i] \as Local;
\definition addition: \forall (omega, eta: Forms.Form k) -> Local.apply (Forms.At[k := k].plus omega eta) = Forms.At[k := N.Nat^::succ k].plus (Local.apply omega) (Local.apply eta) := Local.addition;
\definition scalar: \forall (c: R.Real)(omega: Forms.Form k) -> Local.apply (Forms.At[k := k].scale c omega) = Forms.At[k := N.Nat^::succ k].scale c (Local.apply omega) := Local.scalar;
