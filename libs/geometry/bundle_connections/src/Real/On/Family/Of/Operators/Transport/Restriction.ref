\import \root.Real[n := n, r := r].Transport[U := U, V := V].Restriction[included := included] \as Raw;
\import Euclidean.Restriction[U := U, V := V] \as Forms;
\definition product: \forall (A: Target.Matrix1)(s: Target.Matrix0)(a, b: Fin.Fin r) ->
  Raw.matrix1 (Target.product10 A s) a b = Source.product10 (Raw.matrix1 A) (Raw.matrix0 s) a b :=
  \fun (A: Target.Matrix1)(s: Target.Matrix0)(a, b: Fin.Fin r) => trans!{{SourceForms.Form one}} _ _ _
    (Raw.sum r (\fun (c: Fin.Fin r) => TargetOne.multiply (s c b) (A a c)))
    (Source.sum1Congruent r _ _ (\fun (c: Fin.Fin r) => Raw.multiply (s c b) (A a c)));
\definition law: \forall (A: Target.Matrix1)(s: Target.Matrix0) -> Raw.matrix1 (TargetOperator.covariant A s) = SourceOperator.covariant (Raw.matrix1 A) (Raw.matrix0 s) :=
  \fun (A: Target.Matrix1)(s: Target.Matrix0) => SourceOperator.ext _ _ (\fun (a, b: Fin.Fin r) => trans!{{SourceForms.Form one}} _ _ _
    ((Forms.At[k := one].map included).preservesAdd (Target.differential (s a b)) (Target.product10 A s a b))
    (congr!{{SourceForms.Form one} {SourceForms.Form one} {SourceForms.Form one}} SourceOne.plus _ _ _ _ (Raw.differential (s a b)) (product A s a b)));
