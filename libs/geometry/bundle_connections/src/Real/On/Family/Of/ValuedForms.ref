\definition LocalForm[i: I]: \Set := Fin.Fin r -> Euclidean.On[U := (chart i).image].Form k;
\definition Data: \Set := \forall (i: I) -> LocalForm i;
\module Pair(i, j: I);
\definition Compatible[omega: Data]: \Prop := \forall (i, j: I) -> Pair[i := i, j := j].Compatible (omega i) (omega j);
\definition Form: \Set := \Cast[Data] ({ omega: Data \where Compatible omega });
\definition compatible[omega: Form]: Compatible omega := \bysub(Data, Form, omega);
\module TensorPoint(x: M.Point, omega: Form);
\module TensorForms(enumeration: bundle_operations.Operations[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].ExteriorIndices[n := n, k := k].Enumeration);
\module Algebra;
