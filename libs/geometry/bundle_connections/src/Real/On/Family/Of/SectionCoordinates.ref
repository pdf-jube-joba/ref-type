\import Bundle.Sections[] \as Sections;
\import Atlas.Build[changes := bundle.regular] \as Construction;
\import calculus.Blocks[n := n, m := r] \as Blocks;
\import manifolds.SmoothMap[n := n, m := Blocks.dimension].Between[M := M, N := Bundle.manifold] \as Maps;
\definition Section: \Set := Sections.Section;
\definition coefficient[s: Sections.Data][i: I][a: Fin.Fin r][u: Open.Carrier (chart i).image]: R.Real :=
  ((bundle.atlas.local i).frame (Charts.point (chart i) u)).forward.apply (s.value (Charts.point (chart i) u)) a;
\module OfMap(s: Section, map: Maps.Map, same: Maps.apply map = Sections.total s);
\definition smooth: \forall (s: Section)(i: I)(a: Fin.Fin r) -> Open.Smooth[].SmoothOn (chart i).image (coefficient s i a) :=
  \fun (s: Section)(i: I)(a: Fin.Fin r) => \block {
    \takefrom map: \Cast[Maps.Map] ({ map: Maps.Map \where Maps.apply map = Sections.total s }) \by Sections.regular s \then
    \return OfMap[s := s, map := map, same := \bysub(Maps.Map, { map: Maps.Map \where Maps.apply map = Sections.total s }, map)].smooth i a
  };
\definition local[s: Section][i: I][a: Fin.Fin r]: Open.Smooth[].Algebra[U := (chart i).image].Function :=
  \into[Open.ScalarFunction (chart i).image](coefficient s i a, { f: Open.ScalarFunction (chart i).image \where Open.Smooth[].SmoothOn (chart i).image f }) \by { smooth s i a };
\module Pair(s: Section, i: I, j: I);

\definition Regular[s: Sections.Data]: \Prop := \forall (i: I)(a: Fin.Fin r) -> Open.Smooth[].SmoothOn (chart i).image (coefficient s i a);
\module FromRegular(s: Sections.Data, regular: Regular s);
\module Algebra;
