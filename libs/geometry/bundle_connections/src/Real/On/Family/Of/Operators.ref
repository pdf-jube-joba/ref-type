\import \parent.SectionCoordinates[] \as Sections;
\module Calculus(U: Open.OpenSet);
\module Transport(U, V: Open.OpenSet);

\definition LocalForm[i: I]: \Set := Fin.Fin r -> Euclidean.On[U := (chart i).image].Form one;
\definition OneData: \Set := \forall (i: I) -> LocalForm i;
\module OnePair(i, j: I);
\definition OneCompatible[omega: OneData]: \Prop := \forall (i, j: I) -> OnePair[i := i, j := j].Compatible (omega i) (omega j);
\definition OneForm: \Set := \Cast[OneData] ({ omega: OneData \where OneCompatible omega });
\definition sectionMatrix[s: Sections.Section][i: I]: \root.MatrixCalculus[n := n, r := r].On[U := (chart i).image].Matrix0 :=
  \fun (a, b: Fin.Fin r) => Sections.local s i a;
\definition covariantData[A: Connection][s: Sections.Section][i: I][a: Fin.Fin r]: Euclidean.On[U := (chart i).image].Form one :=
  Calculus[U := (chart i).image].covariant ((A i).matrix) (sectionMatrix s i) a a;
\module CovariantPair(A: Connection, s: Sections.Section, i, j: I);
\definition covariantCompatible: \forall (A: Connection)(s: Sections.Section) -> OneCompatible (covariantData A s) :=
  \fun (A: Connection)(s: Sections.Section)(i, j: I) => CovariantPair[A := A, s := s, i := i, j := j].law;
\definition covariant[A: Connection][s: Sections.Section]: OneForm :=
  \into[OneData](covariantData A s, { omega: OneData \where OneCompatible omega }) \by { covariantCompatible A s };
\module Laws;
\module Coordinates(A: Connection, i: I);
\module TensorCoordinates(x: M.Point, W: \Set, target: Spaces.VectorSpace W, frame: Spaces.Isomorphism[V := F x, W := Fin.Fin r -> R.Real, source := space x, target := Spaces.Coordinates[I := Fin.Fin r].space].Isomorphism);
\module TensorPoint(x: M.Point, omega: OneForm);
\module TensorForms(enumeration: bundle_operations.Operations[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].ExteriorIndices[n := n, k := one].Enumeration);
\module AsValued;
\module DegreeZero;
