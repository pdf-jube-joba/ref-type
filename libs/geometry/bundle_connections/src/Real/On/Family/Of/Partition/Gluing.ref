\definition c: \Cast[Charts.Chart] M.atlas.charts := chart i;
\definition d: \Cast[Charts.Chart] M.atlas.charts := chart j;
\import \parent.\parent.Pair[i := i, j := j] \as Gauge;
\import Charts.Transition[left := c, right := d] \as Transition;
\import Euclidean.On[U := Transition.domain] \as Scalar;
\import Euclidean.Pullback[m := n, U := Transition.domain, V := d.image, f := Gauge.map] \as Pull;
\import \root.MatrixCalculus[n := n, r := r].On[U := Transition.domain] \as Matrices;
\import smooth_partitions.Countable[A := M.Point] \as Countable;
\import R.FiniteSums[] \as Sums;
\import R.Algebra[] \as ArithmeticLaws;
\use Equality.eq_reason_in;
\module At(u: Open.Carrier Transition.domain, arguments: Multilinear.Arguments one);
\definition compatible: Gauge.Compatible (data i) (data j) := \fun (a, b: Fin.Fin r) => Scalar.ext one
  (Gauge.left (data i) a b) (Gauge.right (data j) a b)
  (\fun (u: Open.Carrier Transition.domain)(arguments: Multilinear.Arguments one) => At[u := u, arguments := arguments].law a b);
