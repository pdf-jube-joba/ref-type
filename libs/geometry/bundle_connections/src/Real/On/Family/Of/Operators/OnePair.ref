\import \parent.\parent.Pair[i := i, j := j] \as Gauge;
\import Charts.Transition[left := chart i, right := chart j] \as Transition;
\import \root.MatrixCalculus[n := n, r := r].On[U := Transition.domain] \as Matrices;
\import Euclidean.Restriction[U := Transition.domain, V := (chart i).image] \as Restrict;
\import Euclidean.Pullback[m := n, U := Transition.domain, V := (chart j).image, f := Gauge.map] \as Pull;
\definition source[omega: LocalForm i]: Matrices.Matrix1 := \fun (a, b: Fin.Fin r) => Restrict.apply one Gauge.included (omega a);
\definition target[omega: LocalForm j]: Matrices.Matrix1 := \fun (a, b: Fin.Fin r) => Pull.apply one (omega a);
\definition Compatible[left: LocalForm i][right: LocalForm j]: \Prop := \forall (a, b: Fin.Fin r) ->
  Matrices.product01 Gauge.transition (source left) a b = target right a b;
