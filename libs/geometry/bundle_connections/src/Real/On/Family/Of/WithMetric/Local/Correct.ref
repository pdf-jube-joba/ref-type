\import \root.MetricCorrection[n := n, r := r].On[U := (chart i).image].Of[g := g, q := q, A := A, symmetric := symmetric, inverse := right] \as Correction;
\definition value: LocalConnection i := \root.Forms[n := n, r := r].On[U := (chart i).image].Connection { matrix := Correction.value };
\definition compatible: Transpose.Compatible g value.matrix := Correction.compatibility;
