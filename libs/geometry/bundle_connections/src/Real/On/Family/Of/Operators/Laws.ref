\import Sections.Algebra[] \as SectionAlgebra;
\import smooth_partitions.Manifold[n := n].On[M := M] \as ScalarCalculus;
\import smooth_partitions.Scalars[A := M.Point, space := M.space].Using[calculus := ScalarCalculus.calculus] \as Scalars;
\definition plus[omega, eta: OneData][i: I][a: Fin.Fin r]: Euclidean.On[U := (chart i).image].Form one :=
  Euclidean.On[U := (chart i).image].At[k := one].plus (omega i a) (eta i a);
\definition multiply[f: Scalars.Smooth][omega: OneData][i: I][a: Fin.Fin r]: Euclidean.On[U := (chart i).image].Form one :=
  Euclidean.On[U := (chart i).image].At[k := one].multiply (SectionAlgebra.scalarLocal f i) (omega i a);
\definition tensor[f: Scalars.Smooth][s: Sections.Section][i: I][a: Fin.Fin r]: Euclidean.On[U := (chart i).image].Form one :=
  Euclidean.On[U := (chart i).image].At[k := one].multiply (Sections.local s i a)
    (\root.MatrixCalculus[n := n, r := r].On[U := (chart i).image].differential (SectionAlgebra.scalarLocal f i));
\module In(i: I);
\definition addition: \forall (A: Connection)(s, t: Sections.Section) ->
  covariantData A (SectionAlgebra.plus s t) = plus (covariant A s) (covariant A t) :=
  \fun (A: Connection)(s, t: Sections.Section) => \axiom:funext(covariantData A (SectionAlgebra.plus s t), plus (covariant A s) (covariant A t),
    \fun (i: I) => \axiom:funext(covariantData A (SectionAlgebra.plus s t) i, plus (covariant A s) (covariant A t) i, \fun (a: Fin.Fin r) => In[i := i].addition A s t a));
\definition leibniz: \forall (A: Connection)(f: Scalars.Smooth)(s: Sections.Section) ->
  covariantData A (SectionAlgebra.multiply f s) = plus (tensor f s) (multiply f (covariant A s)) :=
  \fun (A: Connection)(f: Scalars.Smooth)(s: Sections.Section) => \axiom:funext(covariantData A (SectionAlgebra.multiply f s), plus (tensor f s) (multiply f (covariant A s)),
    \fun (i: I) => \axiom:funext(covariantData A (SectionAlgebra.multiply f s) i, plus (tensor f s) (multiply f (covariant A s)) i, \fun (a: Fin.Fin r) => In[i := i].leibniz A f s a));
