\import manifolds.FromCharts[n := n, m := Blocks.dimension].Between[M := M, N := Bundle.manifold].Covered[I := I, chart := chart, covers := bundle.atlas.covers] \as Gluing;
\module In(i: I);
\definition maps: Gluing.Family := \fun (i: I) => In[i := i].map;
\definition agrees: Gluing.Agreement (Sections.total s) maps := \fun (i: I) => In[i := i].agrees;
\import Gluing.Of[f := Sections.total s, maps := maps, agrees := agrees] \as Glued;
\definition smooth: Sections.Smooth s := Logic.existsIntro[Maps.Map, { f: Maps.Map \where Maps.apply f = Sections.total s }] Glued.value Glued.apply;
\definition section: Section := \into[Sections.Data](s, Section) \by { smooth };
