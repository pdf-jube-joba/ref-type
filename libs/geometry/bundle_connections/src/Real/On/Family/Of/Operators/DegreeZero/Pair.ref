\import Target.Pair[i := i, j := j] \as New;
\import \parent.\parent.\parent.SectionCoordinates[].Pair[s := s, i := i, j := j] \as SectionPair;
\import \parent.\parent.\parent.Pair[i := i, j := j] \as Gauge;
\import Charts.Transition[left := chart i, right := chart j] \as Transition;
\import Euclidean.On[U := Transition.domain] \as Scalar;
\import \root.MatrixCalculus[n := n, r := r].On[U := Transition.domain] \as Matrices;
\import Spaces.FiniteCoordinateEnumeration[] \as Enumeration;
\definition law: New.Compatible (data s i) (data s j) :=
  \fun (a: Fin.Fin r) => Scalar.ext zero (New.action (data s i) a) (New.target (data s j) a)
    (\fun (u: Open.Carrier Transition.domain)(arguments: Fin.Fin zero -> Fin.Fin n -> R.Real) => trans!{{R.Real}} _ _ _
      (New.value (data s i) a u arguments)
      (trans!{{R.Real}} _ _ _
        (Enumeration.sumLaw r (\fun (b: Fin.Fin r) => R.mul (Gauge.transition a b u) (New.source (data s i) b u arguments)))
        (congr!{{Matrices.Matrix0} {R.Real}} (\fun (T: Matrices.Matrix0) => T a a u) _ _ (sym!{{Matrices.Matrix0}} _ _ SectionPair.transformation))));
