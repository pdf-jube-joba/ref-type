\definition f[u: Open.Carrier c.image]: R.Real := value u arguments;
\import Open.LocalSmooth[U := c.image, f := f] \as Local;
\module Near(u: Open.Carrier c.image, neighborhood: Functions.FiniteNeighborhood[partition.functions, Charts.point c u]);
\definition smooth: Smooth.SmoothOn c.image f := Local.smooth (\block {
  \fun (u: Open.Carrier c.image) \then
  \takefrom neighborhood: Functions.FiniteNeighborhood[partition.functions, Charts.point c u] \by partition.locallyFinite (Charts.point c u) \then
  \return Logic.existsIntro[Local.Patch, Local.Patches u] (Near[u := u, neighborhood := neighborhood].patch)
    (Near[u := u, neighborhood := neighborhood].contains)
});
