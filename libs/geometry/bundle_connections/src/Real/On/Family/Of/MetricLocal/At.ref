\definition x: Charts.LocalPoint (chart i) := Charts.point (chart i) u;
\definition frame: _ := (bundle.atlas.local i).frame x;
\import smooth_bundles.HermitianForms[K := R.Real, field := R.Algebra[].field, scalar := linear_algebra.Hermitian[].Real[].scalar].On[V := E.Vector, space := E.space].Pullback[W := F x, target := space x, form := metric.form x, map := frame.backward] \as Pull;
\import linear_algebra.Hermitian[].Over[K := R.Real, field := R.Algebra[].field, scalar := linear_algebra.Hermitian[].Real[].scalar].Inner[V := E.Vector, space := E.space] \as Inner;
\definition form: Inner.Form := Pull.value;
\definition positive: Inner.Positive[form] := Inner.Positive[form] {
  nonnegative := \fun (v: E.Vector) => (metric.positive x).nonnegative (frame.backward.apply v),
  definite := \fun (v: E.Vector)(zero: form.dot v v = R.zero) =>
    trans!{{E.Vector}} _ _ _ (sym!{{E.Vector}} _ _ (frame.rightInverse v))
      (trans!{{E.Vector}} _ _ _
        (congr!{{F x} {E.Vector}} frame.forward.apply _ _ ((metric.positive x).definite (frame.backward.apply v) zero))
        frame.forward.preservesZero),
};
