\definition plusData[omega, eta: Data][i: I][a: Fin.Fin r]: Euclidean.On[U := (chart i).image].Form k :=
  Euclidean.On[U := (chart i).image].At[k := k].plus (omega i a) (eta i a);
\definition scaleData[c: R.Real][omega: Data][i: I][a: Fin.Fin r]: Euclidean.On[U := (chart i).image].Form k :=
  Euclidean.On[U := (chart i).image].At[k := k].scale c (omega i a);
\module Pair(i, j: I);
\definition plus[omega, eta: Form]: Form := \into[Data](plusData omega eta, Form) \by {
  \fun (i, j: I) => Pair[i := i, j := j].addition omega eta
};
\definition scale[c: R.Real][omega: Form]: Form := \into[Data](scaleData c omega, Form) \by {
  \fun (i, j: I) => Pair[i := i, j := j].scalar c omega
};
\module Differential;
