\import PairedBundle.Tensor[enumeration := enumeration] \as Tensor;
\import \root.Real[n := n, r := Tensor.rank].On[M := M].Family[F := Tensor.Fiber, space := Tensor.fiberSpace].Of[I := I, bundle := Tensor.tensor] \as Result;
\definition data: Result.Data := \fun (i: I) => \root.Forms[n := n, r := Tensor.rank].On[U := (chart i).image].Connection {
  matrix := \root.TensorGauge[n := n, r := r, s := s].On[U := (chart i).image].Indexed[enumeration := enumeration].lift ((connection i).matrix) ((other i).matrix)
};
\module Pair(i, j: I);
\module Transport(i, j: I);
\definition compatibility: Result.Compatible data := \fun (i, j: I) => Transport[i := i, j := j].law;
\definition value: Result.Connection := \into[Result.Data](data, Result.Connection) \by { compatibility };
