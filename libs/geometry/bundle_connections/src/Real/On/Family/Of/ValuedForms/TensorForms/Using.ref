\import Alternating.Tensor[enumeration := enumeration] \as Forms;
\import \root.Real[n := n, r := Forms.rank].On[M := M].Family[F := Forms.Fiber, space := Forms.fiberSpace].Of[I := I, bundle := Forms.bundle].SectionCoordinates[] \as FormSections;
\import smooth_bundles.Real[n := n, r := Forms.rank].On[M := M].Family[F := Forms.Fiber, space := Forms.fiberSpace].Of[I := I, bundle := Forms.bundle].Sections[] \as NativeSections;
\definition data[omega: Form]: NativeSections.Data := NativeSections.Data { value := \fun (x: M.Point) => \parent.\parent.TensorPoint[x := x, omega := omega].value };
\module In(omega: Form, i: I);
\definition regular: \forall (omega: Form) -> FormSections.Regular (data omega) :=
  \fun (omega: Form)(i: I) => In[omega := omega, i := i].regular;
\definition form[omega: Form]: Forms.Form := FormSections.FromRegular[s := data omega, regular := regular omega].section;
