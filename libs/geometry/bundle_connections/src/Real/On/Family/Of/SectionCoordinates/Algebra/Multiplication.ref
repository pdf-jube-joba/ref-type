\definition data: Sections.Data := Sections.Data { value := \fun (x: M.Point) => (space x).smul (f x) (s.value x) };
\definition formula: \forall (i: I)(a: Fin.Fin r)(u: Open.Carrier (chart i).image) -> coefficient data i a u = R.mul (f (Charts.point (chart i) u)) (coefficient s i a u) :=
  \fun (i: I)(a: Fin.Fin r)(u: Open.Carrier (chart i).image) => congr!{{Fin.Fin r -> R.Real} {R.Real}} (\fun (v: Fin.Fin r -> R.Real) => v a) _ _
    (((bundle.atlas.local i).frame (Charts.point (chart i) u)).forward.preservesScale (f (Charts.point (chart i) u)) (s.value (Charts.point (chart i) u)));
\definition regular: Regular data := \fun (i: I)(a: Fin.Fin r) => smooth_partitions.Euclidean[n := n].smoothCongruent (chart i).image
  (\fun (u: Open.Carrier (chart i).image) => R.mul (f (Charts.point (chart i) u)) (coefficient s i a u)) (coefficient data i a)
  (\fun (u: Open.Carrier (chart i).image) => sym!{{R.Real}} _ _ (formula i a u))
  (Open.Smooth[].Operations[].mulSmooth (chart i).image (\fun (u: Open.Carrier (chart i).image) => f (Charts.point (chart i) u))
    (coefficient s i a) (Scalars.regular f (chart i)) (smooth s i a));
\definition section: Section := \parent.\parent.FromRegular[s := data, regular := regular].section;
