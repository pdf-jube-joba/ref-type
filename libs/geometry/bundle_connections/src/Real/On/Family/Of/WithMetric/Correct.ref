\definition data: Data := \fun (i: I) => \parent.Local[i := i].Correct[A := (connection i).matrix].value;
\module Pair(i, j: I);
\definition gluing: Compatible data := \fun (i, j: I) => Pair[i := i, j := j].compatible;
\definition underlying: Connection := \into[Data](data, Connection) \by { gluing };
\definition value: CompatibleConnection := \into[Connection](underlying, CompatibleConnection) \by {
  \fun (i: I) => \parent.Local[i := i].Correct[A := (connection i).matrix].compatible
};
