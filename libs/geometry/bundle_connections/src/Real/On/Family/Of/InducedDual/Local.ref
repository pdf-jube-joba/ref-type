\import \root.Forms[n := n, r := r].On[U := (chart i).image] \as Forms;
\import Forms.Coefficients[connection := connection i] \as Original;
\import Forms.Coefficients[connection := value i] \as Dual;
\import \root.Local[n := n, r := r].On[U := (chart i).image] \as Local;
\import Local.Dual[connection := Original.local] \as Model;
\definition comparison: Dual.local = Model.dual := \refl(Model.dual);
\import Local.Of[connection := Dual.local] \as Operator;
\import Local.Of[connection := Original.local] \as OriginalOperator;
\import Open.Smooth[].Algebra[U := (chart i).image] \as Functions;
\definition pairing: \forall (j: Fin.Fin n)(s, t: Local.Section) ->
  Functions.plus (Local.pair (Operator.partial j s) t) (Local.pair s (OriginalOperator.partial j t)) = Open.Smooth[].Derivative[].Linear[U := (chart i).image].apply j (Local.pair s t) := Model.pairing;
