\import Bundle.Dual[] \as Dual;
\import \root.Real[n := n, r := r].On[M := M].Family[F := Dual.Fiber, space := Dual.fiberSpace].Of[I := I, bundle := Dual.dual] \as Target;
\definition data: Target.Data := \fun (i: I) => \root.Forms[n := n, r := r].On[U := (chart i).image].Connection {
  matrix := \fun (a, b: Fin.Fin r) => Euclidean.On[U := (chart i).image].At[k := one].scale (R.neg R.one) ((connection i).matrix b a)
};
\module Pair(i, j: I);
\definition compatibility: Target.Compatible data := \fun (i, j: I) => Pair[i := i, j := j].law;
\definition value: Target.Connection := \into[Target.Data](data, Target.Connection) \by { compatibility };
\module Local(i: I);
