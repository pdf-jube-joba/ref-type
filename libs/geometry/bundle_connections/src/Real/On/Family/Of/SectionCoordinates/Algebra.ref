\import smooth_partitions.Manifold[n := n].On[M := M] \as ScalarCalculus;
\import smooth_partitions.Scalars[A := M.Point, space := M.space].Using[calculus := ScalarCalculus.calculus] \as Scalars;
\module Addition(s, t: Section);
\module Multiplication(f: Scalars.Smooth, s: Section);
\definition plus[s, t: Section]: Section := Addition[s := s, t := t].section;
\definition multiply[f: Scalars.Smooth][s: Section]: Section := Multiplication[f := f, s := s].section;
\definition localAdd: \forall (s, t: Section)(i: I)(a: Fin.Fin r) -> local (plus s t) i a = Open.Smooth[].Algebra[U := (chart i).image].plus (local s i a) (local t i a) :=
  \fun (s, t: Section)(i: I)(a: Fin.Fin r) => Open.Smooth[].Algebra[U := (chart i).image].ext _ _ (Addition[s := s, t := t].formula i a);
\definition scalarLocal[f: Scalars.Smooth][i: I]: Open.Smooth[].Algebra[U := (chart i).image].Function :=
  \into[Open.ScalarFunction (chart i).image]((\fun (u: Open.Carrier (chart i).image) => f (Charts.point (chart i) u)),
    Open.Smooth[].Algebra[U := (chart i).image].Predicate) \by { Scalars.regular f (chart i) };
\definition localMultiply: \forall (f: Scalars.Smooth)(s: Section)(i: I)(a: Fin.Fin r) ->
  local (multiply f s) i a = Open.Smooth[].Algebra[U := (chart i).image].product (scalarLocal f i) (local s i a) :=
  \fun (f: Scalars.Smooth)(s: Section)(i: I)(a: Fin.Fin r) => Open.Smooth[].Algebra[U := (chart i).image].ext _ _ (Multiplication[f := f, s := s].formula i a);
