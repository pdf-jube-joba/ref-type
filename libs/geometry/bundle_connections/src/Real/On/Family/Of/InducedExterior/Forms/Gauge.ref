\import \root.ExteriorGauge[n := n, r := r].On[U := U].At[k := k, enumeration := enumeration] \as Representation;
\import Representation.Algebra[] \as Algebra;
\import Representation.Tangent[] \as Tangent;
\import Representation.Expansion[] \as Expansion;
\import Spaces.FiniteCoordinateEnumeration[] \as Enumeration;
\import Spaces.FiniteCoordinates[n := n] \as BaseBasis;
\import Spaces.Sums[I := Fin.Fin r] \as EntrySums;
\import Spaces.Sums[I := Fin.Fin Exterior.rank] \as CoefficientSums;
\import Spaces.Sums[I := Fin.Fin k].Prop[] \as SlotLaws;
\import Spaces.Sums[I := Fin.Fin Exterior.rank].Prop[] \as CoefficientLaws;
\import Open.Smooth[].Algebra[U := U] \as Functions;
\import Open.Smooth[].Derivative[].Linear[U := U] \as Derivatives;
\definition basis[i: Fin.Fin n]: TangentMultilinear.Arguments one := \fun (slot: Fin.Fin one) => BaseBasis.vectors i;
\definition formValue[C: Matrix.Matrix1][x: Open.Carrier U][v: TangentMultilinear.Arguments one]: Algebra.Numeric := \fun (a, b: Fin.Fin r) => C a b x v;
\definition liftValue: \forall (C: Matrix.Matrix1)(a, b: Fin.Fin Exterior.rank)(x: Open.Carrier U)(v: TangentMultilinear.Arguments one) ->
  lift C a b x v = Tangent.action (formValue C x v) a b :=
  \fun (C: Matrix.Matrix1)(a, b: Fin.Fin Exterior.rank)(x: Open.Carrier U)(v: TangentMultilinear.Arguments one) => eq_reason_in!{{R.Real} { lift C a b x v }
    "=" { Sums.sum k (\fun (slot: Fin.Fin k) => Sums.sum r (\fun (c: Fin.Fin r) => R.mul (entry a b slot c) (C (Coordinates.enumerate a slot) c x v))) } "by" { value C a b x v }
    "=" { Spaces.Sums[I := Fin.Fin k].sum (Fin.elements k) (\fun (slot: Fin.Fin k) => Sums.sum r (\fun (c: Fin.Fin r) => R.mul (entry a b slot c) (C (Coordinates.enumerate a slot) c x v))) } "by" {
      sym!{{R.Real}} _ _ (Enumeration.sumLaw k (\fun (slot: Fin.Fin k) => Sums.sum r (\fun (c: Fin.Fin r) => R.mul (entry a b slot c) (C (Coordinates.enumerate a slot) c x v)))) }
    "=" { Spaces.Sums[I := Fin.Fin k].sum (Fin.elements k) (\fun (slot: Fin.Fin k) => EntrySums.sum (Fin.elements r) (\fun (c: Fin.Fin r) => R.mul (entry a b slot c) (C (Coordinates.enumerate a slot) c x v))) } "by" {
      SlotLaws.congruent (Fin.elements k)
        (\fun (slot: Fin.Fin k) => Sums.sum r (\fun (c: Fin.Fin r) => R.mul (entry a b slot c) (C (Coordinates.enumerate a slot) c x v)))
        (\fun (slot: Fin.Fin k) => EntrySums.sum (Fin.elements r) (\fun (c: Fin.Fin r) => R.mul (entry a b slot c) (C (Coordinates.enumerate a slot) c x v)))
        (\fun (slot: Fin.Fin k) => sym!{{R.Real}} _ _ (Enumeration.sumLaw r (\fun (c: Fin.Fin r) => R.mul (entry a b slot c) (C (Coordinates.enumerate a slot) c x v)))) }
    "=" _ "by" { sym!{{R.Real}} _ _ (Expansion.actionExpansion (formValue C x v) a b) }
  };
\definition differentialBasis: \forall (f: Functions.Function)(i: Fin.Fin n)(x: Open.Carrier U) -> Matrix.differential f x (basis i) = Derivatives.apply i f x :=
  \fun (f: Functions.Function)(i: Fin.Fin n)(x: Open.Carrier U) => eq_reason_in!{{R.Real} { Matrix.differential f x (basis i) }
    "=" { Sums.sum n (\fun (j: Fin.Fin n) => R.mul (Derivatives.apply j f x) (BaseBasis.vectors i j)) } "by" { Scalar.FunctionDifferential[].law f x (basis i) }
    "=" { Spaces.Sums[I := Fin.Fin n].sum (Fin.elements n) (\fun (j: Fin.Fin n) => R.mul (Derivatives.apply j f x) (BaseBasis.vectors i j)) } "by" {
      sym!{{R.Real}} _ _ (Enumeration.sumLaw n (\fun (j: Fin.Fin n) => R.mul (Derivatives.apply j f x) (BaseBasis.vectors i j))) }
    "=" _ "by" { BaseBasis.dualReconstruction (\fun (j: Fin.Fin n) => Derivatives.apply j f x) i }
  };
\definition product01: \forall (C: Matrix.Matrix1)(a, b: Fin.Fin r)(x: Open.Carrier U)(v: TangentMultilinear.Arguments one) -> Matrix.product01 T C a b x v = Algebra.product (Tangent.eval T x) (formValue C x v) a b :=
  \fun (C: Matrix.Matrix1)(a, b: Fin.Fin r)(x: Open.Carrier U)(v: TangentMultilinear.Arguments one) => trans!{{R.Real}} _ _ _
    (Matrix.value01 T C a b x v) (sym!{{R.Real}} _ _ (Enumeration.sumLaw r (\fun (c: Fin.Fin r) => R.mul (T a c x) (C c b x v))));
\definition product10: \forall (C: Matrix.Matrix1)(a, b: Fin.Fin r)(x: Open.Carrier U)(v: TangentMultilinear.Arguments one) -> Matrix.product10 C T a b x v = Algebra.product (formValue C x v) (Tangent.eval T x) a b :=
  \fun (C: Matrix.Matrix1)(a, b: Fin.Fin r)(x: Open.Carrier U)(v: TangentMultilinear.Arguments one) => trans!{{R.Real}} _ _ _
    (Matrix.value10 C T a b x v) (sym!{{R.Real}} _ _ (Enumeration.sumLaw r (\fun (c: Fin.Fin r) => R.mul (C a c x v) (T c b x))));
\definition numericGauge: \forall (i: Fin.Fin n)(x: Open.Carrier U) -> Algebra.product (Tangent.eval T x) (formValue A x (basis i)) =
  Tangent.plus (Tangent.partial T i x) (Algebra.product (formValue B x (basis i)) (Tangent.eval T x)) :=
  \fun (i: Fin.Fin n)(x: Open.Carrier U) => Tangent.ext _ _ (\fun (a, b: Fin.Fin r) => eq_reason_in!{{R.Real} _
    "=" { Matrix.product01 T A a b x (basis i) } "by" { sym!{{R.Real}} _ _ (product01 A a b x (basis i)) }
    "=" { Matrix.plus (Matrix.dMatrix T) (Matrix.product10 B T) a b x (basis i) } "by" {
      congr!{{Matrix.Matrix1} {R.Real}} (\fun (C: Matrix.Matrix1) => C a b x (basis i)) _ _ compatible }
    "=" _ "by" { congr!{{R.Real} {R.Real} {R.Real}} R.add _ _ _ _ (differentialBasis (T a b) i x) (product10 B a b x (basis i)) }
  });
\definition leftValue: \forall (a, b: Fin.Fin Exterior.rank)(x: Open.Carrier U)(v: TangentMultilinear.Arguments one) ->
  ResultMatrix.product01 (Representation.representation T) (lift A) a b x v = CoefficientSums.sum (Fin.elements Exterior.rank)
    (\fun (c: Fin.Fin Exterior.rank) => R.mul (Representation.representation T a c x) (Tangent.action (formValue A x v) c b)) :=
  \fun (a, b: Fin.Fin Exterior.rank)(x: Open.Carrier U)(v: TangentMultilinear.Arguments one) => eq_reason_in!{{R.Real} _
    "=" _ "by" { ResultMatrix.value01 (Representation.representation T) (lift A) a b x v }
    "=" { CoefficientSums.sum (Fin.elements Exterior.rank) (\fun (c: Fin.Fin Exterior.rank) => R.mul (Representation.representation T a c x) (lift A c b x v)) } "by" {
      sym!{{R.Real}} _ _ (Enumeration.sumLaw Exterior.rank (\fun (c: Fin.Fin Exterior.rank) => R.mul (Representation.representation T a c x) (lift A c b x v))) }
    "=" _ "by" { CoefficientLaws.congruent (Fin.elements Exterior.rank)
      (\fun (c: Fin.Fin Exterior.rank) => R.mul (Representation.representation T a c x) (lift A c b x v))
      (\fun (c: Fin.Fin Exterior.rank) => R.mul (Representation.representation T a c x) (Tangent.action (formValue A x v) c b))
      (\fun (c: Fin.Fin Exterior.rank) => congr!{{R.Real} {R.Real}} (R.mul (Representation.representation T a c x)) _ _ (liftValue A c b x v)) }
  };
\definition rightValue: \forall (a, b: Fin.Fin Exterior.rank)(x: Open.Carrier U)(v: TangentMultilinear.Arguments one) ->
  ResultMatrix.product10 (lift B) (Representation.representation T) a b x v = CoefficientSums.sum (Fin.elements Exterior.rank)
    (\fun (c: Fin.Fin Exterior.rank) => R.mul (Tangent.action (formValue B x v) a c) (Representation.representation T c b x)) :=
  \fun (a, b: Fin.Fin Exterior.rank)(x: Open.Carrier U)(v: TangentMultilinear.Arguments one) => eq_reason_in!{{R.Real} _
    "=" _ "by" { ResultMatrix.value10 (lift B) (Representation.representation T) a b x v }
    "=" { CoefficientSums.sum (Fin.elements Exterior.rank) (\fun (c: Fin.Fin Exterior.rank) => R.mul (lift B a c x v) (Representation.representation T c b x)) } "by" {
      sym!{{R.Real}} _ _ (Enumeration.sumLaw Exterior.rank (\fun (c: Fin.Fin Exterior.rank) => R.mul (lift B a c x v) (Representation.representation T c b x))) }
    "=" _ "by" { CoefficientLaws.congruent (Fin.elements Exterior.rank)
      (\fun (c: Fin.Fin Exterior.rank) => R.mul (lift B a c x v) (Representation.representation T c b x))
      (\fun (c: Fin.Fin Exterior.rank) => R.mul (Tangent.action (formValue B x v) a c) (Representation.representation T c b x))
      (\fun (c: Fin.Fin Exterior.rank) => congr!{{R.Real} {R.Real}} (\fun (z: R.Real) => R.mul z (Representation.representation T c b x)) _ _ (liftValue B a c x v)) }
  };
\definition basisLaw: \forall (a, b: Fin.Fin Exterior.rank)(i: Fin.Fin n)(x: Open.Carrier U) ->
  ResultMatrix.product01 (Representation.representation T) (lift A) a b x (basis i) =
  ResultMatrix.plus (ResultMatrix.dMatrix (Representation.representation T)) (ResultMatrix.product10 (lift B) (Representation.representation T)) a b x (basis i) :=
  \fun (a, b: Fin.Fin Exterior.rank)(i: Fin.Fin n)(x: Open.Carrier U) => eq_reason_in!{{R.Real} _
    "=" _ "by" { leftValue a b x (basis i) }
    "=" { R.add (Derivatives.apply i (Representation.representation T a b) x) (CoefficientSums.sum (Fin.elements Exterior.rank) (\fun (c: Fin.Fin Exterior.rank) => R.mul (Tangent.action (formValue B x (basis i)) a c) (Representation.representation T c b x))) } "by" {
      Representation.Naturality[].gauge T i x (formValue A x (basis i)) (formValue B x (basis i)) (numericGauge i x) a b }
    "=" _ "by" { congr!{{R.Real} {R.Real} {R.Real}} R.add _ _ _ _
      (sym!{{R.Real}} _ _ (differentialBasis (Representation.representation T a b) i x)) (sym!{{R.Real}} _ _ (rightValue a b x (basis i))) }
  };
\definition law: ResultMatrix.product01 (Representation.representation T) (lift A) =
  ResultMatrix.plus (ResultMatrix.dMatrix (Representation.representation T)) (ResultMatrix.product10 (lift B) (Representation.representation T)) := \block {
  \let left: ResultMatrix.Matrix1 := ResultMatrix.product01 (Representation.representation T) (lift A) \then
  \let right: ResultMatrix.Matrix1 := ResultMatrix.plus (ResultMatrix.dMatrix (Representation.representation T)) (ResultMatrix.product10 (lift B) (Representation.representation T)) \then
  \return \axiom:funext(left, right, \fun (a: Fin.Fin Exterior.rank) => \axiom:funext(left a, right a, \fun (b: Fin.Fin Exterior.rank) =>
    Scalar.coefficientExt one (left a b) (right a b) (\fun (indices: Fin.Fin one -> Fin.Fin n) => Functions.ext
      (Scalar.coefficient one (left a b) indices) (Scalar.coefficient one (right a b) indices) (\fun (x: Open.Carrier U) => \block {
        \let args: TangentMultilinear.Arguments one := \fun (slot: Fin.Fin one) => BaseBasis.vectors (indices slot) \then
        \let same: args = basis (indices (Fin.zero zero)) := \axiom:funext(args, basis (indices (Fin.zero zero)), \fun (slot: Fin.Fin one) =>
          congr!{{Fin.Fin one} {TangentVectors.Vector}} (\fun (j: Fin.Fin one) => BaseBasis.vectors (indices j)) _ _ (Euclidean.Covector[i := indices (Fin.zero zero)].uniqueIndex slot)) \then
        \return eq_reason_in!{{R.Real} { left a b x args }
          "=" { left a b x (basis (indices (Fin.zero zero))) } "by" { congr!{{TangentMultilinear.Arguments one} {R.Real}} (left a b x) _ _ same }
          "=" { right a b x (basis (indices (Fin.zero zero))) } "by" { basisLaw a b (indices (Fin.zero zero)) x }
          "=" { right a b x args } "by" { sym!{{R.Real}} _ _ (congr!{{TangentMultilinear.Arguments one} {R.Real}} (right a b x) _ _ same) }
        }
      }))))
};
