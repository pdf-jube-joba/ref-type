\import \parent.\parent.ValuedForms[k := zero] \as Target;
\definition data[s: Sections.Section][i: I][a: Fin.Fin r]: Euclidean.On[U := (chart i).image].Form zero :=
  Euclidean.On[U := (chart i).image].DegreeZero[].apply (Sections.local s i a);
\module Pair(s: Sections.Section, i, j: I);
\definition value[s: Sections.Section]: Target.Form := \into[Target.Data](data s, Target.Form) \by { \fun (i, j: I) => Pair[s := s, i := i, j := j].law };
\module Local(A: Connection, i: I);
\import \root.GlobalForms[n := n, r := r].OnManifold[M := M].Family[F := F, space := space].Of[I := I, bundle := bundle].At[k := zero] \as Exterior;
\import \parent.AsValued[] \as OneForms;
\definition comparison: \forall (A: Connection)(s: Sections.Section) -> Exterior.apply A (value s) = OneForms.value (covariant A s) :=
  \fun (A: Connection)(s: Sections.Section) => \axiom:funext(Exterior.apply A (value s), OneForms.value (covariant A s),
    \fun (i: I) => \axiom:funext(Exterior.apply A (value s) i, OneForms.value (covariant A s) i, \fun (a: Fin.Fin r) => Local[A := A, i := i].comparison s a));
