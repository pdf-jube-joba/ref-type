\import \root.Metric[n := n, r := r] \as LocalMetric;
\import LocalMetric.On[U := (chart i).image] \as Local;
\import linear_algebra.Hermitian[].Over[K := R.Real, field := R.Algebra[].field, scalar := linear_algebra.Hermitian[].Real[].scalar].Finite[n := r] \as E;
\module At(u: Open.Carrier (chart i).image);
\definition local: Local.Metric := Local.Metric {
  form := \fun (u: Open.Carrier (chart i).image) => At[u := u].form,
  positive := \fun (u: Open.Carrier (chart i).image) => At[u := u].positive,
  smooth := \fun (a, b: Fin.Fin r) => (\bysub(Metrics.Data, { h: Metrics.Data \where Metrics.Smooth h }, metric)) i a b,
};
\definition connection: \root.Local[n := n, r := r].On[U := (chart i).image].Connection :=
  Local.Of[metric := local].Compatible[].connection;
\definition formConnection: LocalConnection i := \root.Forms[n := n, r := r].On[U := (chart i).image].Coordinates[connection := connection].value;
