\import Bundles.Of[I := I, bundle := bundle] \as Bundle;
\import \root.Real[n := n, r := realRank].On[M := M].Family[F := F, space := Bundles.realSpace].Of[I := I, bundle := Bundle.forget] \as Underlying;

\import smooth_bundles.Complex[n := n, r := r].On[M := M].Family[F := F, space := space].Using[I := I, data := bundle.atlas] \as Atlas;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\definition chart[i: I]: \Cast[Charts.Chart] M.atlas.charts := (bundle.atlas.local i).chart;
\definition ComplexLocal[i: I]: \Set := \root.ComplexMatrices[n := n, r := r].On[U := (chart i).image].Matrix1;
\definition ComplexData: \Set := \forall (i: I) -> ComplexLocal i;
\module Pair(i, j: I);
\definition ComplexCompatible[data: ComplexData]: \Prop := \forall (i, j: I) -> Pair[i := i, j := j].ComplexCompatible (data i) (data j);

\module In(i: I);
\definition ComplexLinear[connection: Underlying.Connection]: \Prop := \forall (i: I) -> In[i := i].ComplexLinear (connection i);
\definition Connection: \Set := \Cast[Underlying.Connection] ({ connection: Underlying.Connection \where ComplexLinear connection });
\definition forget[connection: Connection]: Underlying.Connection := connection;
\definition complexLinear[connection: Connection]: ComplexLinear connection := \bysub(Underlying.Connection, Connection, connection);
\module Project(connection: Underlying.Connection);
\definition existsConnection: \exists Connection := \block {
  \takefrom connection: Underlying.Connection \by Underlying.existsConnection \then
  \return \exact(Project[connection := connection].value, Connection)
};
\import Bundle.Metrics[] \as Metrics;
\module WithMetric(metric: Metrics.Metric);

\module Operators;
\module InducedDual(connection: Connection);

\module InducedPaired(s: N.Nat^, G: M.Point -> \Set, otherSpace: \forall (x: M.Point) -> Spaces.VectorSpace (G x),
  otherFrame: \forall (i: I)(x: Charts.LocalPoint (bundle.atlas.local i).chart) -> Spaces.Isomorphism[V := G x, W := Fin.Fin s -> C.Complex, source := otherSpace x, target := Spaces.Coordinates[I := Fin.Fin s].space].Isomorphism);
\module InducedExterior(k: N.Nat^, enumeration: Operations.ExteriorIndices[n := r, k := k].Enumeration, connection: Connection);

\module Coefficients(connection: Connection);

\module FromCoefficients(data: ComplexData, compatible: ComplexCompatible data);
\module Restore(connection: Connection);
