\import \root.ComplexMetric[n := n, r := r].OnManifold[M := M].Family[F := F, space := space].Of[I := I, bundle := bundle].Local[metric := metric, i := i] \as Native;
\import RealSpaces.FiniteCoordinates[n := realRank] \as Basis;
\definition smooth: \forall (a, b: Fin.Fin realRank) -> Open.Smooth[].SmoothOn (chart i).image (RealMetrics.coefficient data i a b) :=
  \fun (a, b: Fin.Fin realRank) => (Native.local.smooth (Coordinates.decode (Basis.vectors a)) (Coordinates.decode (Basis.vectors b))).real;
