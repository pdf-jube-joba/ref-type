\import \root.Complex[n := n, r := r].Structure[].On[U := (chart i).image] \as Structure;
\import \root.MatrixCalculus[n := n, r := realRank].On[U := (chart i).image] \as Matrices;
\definition ComplexLinear[connection: Underlying.LocalConnection i]: \Prop :=
  Matrices.product01 Structure.matrix connection.matrix = Matrices.product10 connection.matrix Structure.matrix;
\definition project[connection: Underlying.LocalConnection i]: Underlying.LocalConnection i :=
  \root.Forms[n := n, r := realRank].On[U := (chart i).image].Connection { matrix := Structure.project connection.matrix };
\definition complexLinear[connection: Underlying.LocalConnection i]: ComplexLinear (project connection) := Structure.commutes connection.matrix;
