\import PairedBundle.Tensor[enumeration := enumeration] \as Tensor;
\import \root.Complex[n := n, r := Tensor.rank].On[M := M].Family[F := Tensor.Fiber, space := Tensor.fiberSpace].Of[I := I, bundle := Tensor.tensor] \as Result;
\import smooth_bundles.Complex[n := n, r := Tensor.rank].On[M := M].Family[F := Tensor.Fiber, space := Tensor.fiberSpace] \as TensorBundles;
