\import PairedBundle.Tensor[enumeration := enumeration] \as Tensor;
\import \root.Complex[n := n, r := Tensor.rank].On[M := M].Family[F := Tensor.Fiber, space := Tensor.fiberSpace].Of[I := I, bundle := Tensor.tensor] \as Result;
\import smooth_bundles.Complex[n := n, r := Tensor.rank].On[M := M].Family[F := Tensor.Fiber, space := Tensor.fiberSpace] \as TensorBundles;
\import TensorBundles.Of[I := I, bundle := Tensor.tensor] \as TensorBundle;
\definition targetRank: N.Nat^ := smooth_bundles.ComplexCoordinates[n := n, r := Tensor.rank].rank;
\import \root.Real[n := n, r := targetRank].On[M := M].Family[F := Tensor.Fiber, space := TensorBundles.realSpace].Of[I := I, bundle := TensorBundle.forget] \as ResultUnderlying;
\module Coefficients(i, j: I);
\import \parent.\parent.\parent.Coefficients[connection := connection] \as FirstCoefficients;
\import Other.Coefficients[connection := other] \as SecondCoefficients;
\definition data: Result.ComplexData := \fun (i: I) =>
  \root.ComplexTensorGauge[r := r, s := s].Dimension[n := n].On[U := (chart i).image].Indexed[enumeration := enumeration].lift (FirstCoefficients.data i) (SecondCoefficients.data i);
\module Pair(i, j: I);
\definition compatibility: Result.ComplexCompatible data := \fun (i, j: I) => Pair[i := i, j := j].law;
\import Result.FromCoefficients[data := data, compatible := compatibility] \as Construction;
\definition value: Result.Connection := Construction.value;
\definition coefficients: Result.Coefficients[connection := value].data = data := Construction.extracted;
