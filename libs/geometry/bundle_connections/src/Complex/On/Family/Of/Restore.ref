\import \parent.Coefficients[connection := connection] \as Extracted;
\import \parent.FromCoefficients[data := Extracted.data, compatible := Extracted.compatible] \as Rebuilt;
\module Local(i: I);
\definition equality: Rebuilt.value = connection := Underlying.ext (forget Rebuilt.value) (forget connection) (\fun (i: I) => Local[i := i].law);
