\definition realData: Underlying.Data := \fun (i: I) => \root.Forms[n := n, r := realRank].On[U := (chart i).image].Connection {
  matrix := \root.ComplexMatrices[n := n, r := r].On[U := (chart i).image].Encoding[].encode1 (data i)
};
\module Pair(i, j: I);
\definition realCompatible: Underlying.Compatible realData := \fun (i, j: I) => Pair[i := i, j := j].law;
\definition underlying: Underlying.Connection := \into[Underlying.Data](realData, Underlying.Connection) \by { realCompatible };
\definition value: Connection := \into[Underlying.Connection](underlying, Connection) \by {
  \fun (i: I) => \root.ComplexMatrices[n := n, r := r].On[U := (chart i).image].Commutation[].matrix
    (\root.ComplexMatrices[n := n, r := r].On[U := (chart i).image].Encoding[].encode1 (data i))
    (\root.ComplexMatrices[n := n, r := r].On[U := (chart i).image].RecoveryProducts[].encodedCommutes1 (data i))
};
\import \parent.Coefficients[connection := value] \as Extracted;
\definition extracted: Extracted.data = data := \axiom:funext(Extracted.data, data, \fun (i: I) =>
  \root.ComplexMatrices[n := n, r := r].On[U := (chart i).image].RecoveryProducts[].roundTrip1 (data i));
