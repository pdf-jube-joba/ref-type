\import \root.Complex[n := n, r := r].Conjugation[].On[U := U] \as Conjugation;
\import \root.MatrixCalculus[n := n, r := realRank].On[U := U] \as Matrix;
\import \root.Induced[n := n, r := realRank].On[U := U] \as Induced;
\import Matrix.ConstantChange[Q := Conjugation.matrix, P := Conjugation.matrix, left := Conjugation.squareMatrix, right := Conjugation.squareMatrix,
  constantQ := Conjugation.constant, constantP := Conjugation.constant] \as Change;
\definition dual[A: Matrix.Matrix1]: Matrix.Matrix1 := Change.form (Induced.dual A);
\definition transpose[T: Matrix.Matrix0]: Matrix.Matrix0 := Change.scalar (Induced.transpose0 T);
