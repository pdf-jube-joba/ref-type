\definition data: Underlying.Data := \fun (i: I) => \parent.In[i := i].project (connection i);
\module Pair(i, j: I);
\definition compatible: Underlying.Compatible data := \fun (i, j: I) => Pair[i := i, j := j].compatible;
\definition underlying: Underlying.Connection := \into[Underlying.Data](data, Underlying.Connection) \by { compatible };
\definition value: Connection := \into[Underlying.Connection](underlying, Connection) \by {
  \fun (i: I) => \parent.In[i := i].complexLinear (connection i)
};
