\import Underlying.Pair[i := i, j := j] \as Gauge;
\import Charts.Transition[left := chart i, right := chart j] \as Transition;
\import Atlas.Change[i := i, j := j] \as Change;
\import \root.Complex[n := n, r := r].Structure[] \as ComplexStructure;
\import ComplexStructure.On[U := Transition.domain] \as Structure;
\import \root.MatrixCalculus[n := n, r := realRank].On[U := Transition.domain] \as Matrices;
\import Open.Smooth[].Algebra[U := Transition.domain] \as Functions;
\import R.FiniteSums[].Linear[] \as Finite;
\definition commutation: Matrices.product00 Gauge.transition Structure.matrix = Matrices.product00 Structure.matrix Gauge.transition :=
  \axiom:funext(Matrices.product00 Gauge.transition Structure.matrix, Matrices.product00 Structure.matrix Gauge.transition, \fun (a: Fin.Fin realRank) =>
    \axiom:funext(Matrices.product00 Gauge.transition Structure.matrix a, Matrices.product00 Structure.matrix Gauge.transition a, \fun (b: Fin.Fin realRank) =>
      Functions.ext (Matrices.product00 Gauge.transition Structure.matrix a b) (Matrices.product00 Structure.matrix Gauge.transition a b)
        (\fun (u: Open.Carrier Transition.domain) => eq_reason_in!{{R.Real} _
          "=" _ "by" { sym!{{R.Real}} _ _ (Structure.evaluate (ComplexStructure.realify (Change.matrix u)) (ComplexStructure.J.apply (Finite.basis realRank b)) a) }
          "=" _ "by" { congr!{{RealVectors.Vector} {R.Real}} (\fun (v: RealVectors.Vector) => v a) _ _ (ComplexStructure.commutes (Change.matrix u) (Finite.basis realRank b)) }
          "=" _ "by" { Structure.evaluate ComplexStructure.J ((ComplexStructure.realify (Change.matrix u)).apply (Finite.basis realRank b)) a }
        })));
