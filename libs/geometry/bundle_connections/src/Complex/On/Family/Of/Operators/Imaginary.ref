\definition data: NativeSections.Data := NativeSections.Data {
  value := \fun (x: M.Point) => (space x).smul Op.i (s.value x)
};
\module In(i: I);
\definition regular: Sections.Regular data := \fun (i: I)(a: Fin.Fin realRank) => In[i := i].regular a;
\definition value: Section := Sections.FromRegular[s := data, regular := regular].section;
