\import \root.Real[n := n, r := realRank].Transport[U := U, V := V].Restriction[included := included] \as Maps;
\import euclidean_forms.Euclidean[n := n].Restriction[U := U, V := V] \as Forms;
\definition transpose: \forall (A: Target.Matrix1) -> Maps.matrix1 (TargetInduced.dual A) = SourceInduced.dual (Maps.matrix1 A) :=
  \fun (A: Target.Matrix1) => Linear.ext (Maps.matrix1 (TargetInduced.dual A)) (SourceInduced.dual (Maps.matrix1 A))
    (\fun (a, b: Fin.Fin realRank) => (Forms.At[k := one].map included).preservesScale (R.neg R.one) (A b a));
\definition dual: \forall (A: Target.Matrix1) -> Maps.matrix1 (TargetLocal.dual A) = SourceLocal.dual (Maps.matrix1 A) :=
  \fun (A: Target.Matrix1) => eq_reason_in!{{Source.Matrix1} _
    "=" _ "by" { Maps.product10 (Target.product01 TargetK.matrix (TargetInduced.dual A)) TargetK.matrix }
    "=" _ "by" { congr!{{Source.Matrix1} {Source.Matrix1}} (\fun (B: Source.Matrix1) => Source.product10 B SourceK.matrix) _ _ (Maps.product01 TargetK.matrix (TargetInduced.dual A)) }
    "=" _ "by" { congr!{{Source.Matrix1} {Source.Matrix1}} (\fun (B: Source.Matrix1) => Source.product10 (Source.product01 SourceK.matrix B) SourceK.matrix) _ _ (transpose A) }
  };
