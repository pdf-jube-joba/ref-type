\import RealCompatible.Local[i := i] \as Metric;
\import \root.Complex[n := n, r := r].Structure[].On[U := (chart i).image] \as Structure;
\import \root.LeviCivita[n := n].Gauge[r := realRank, U := (chart i).image] \as Gauge;
\import \root.MetricCorrection[n := n, r := realRank].On[U := (chart i).image].Complex[g := Metric.g, J := Structure.matrix,
  square := Structure.squareMatrix, constant := Structure.constant, orthogonal := \parent.\parent.Orthogonal[i := i].law] \as Preserve;
\definition compatible: RealCompatible.MetricCompatible A := \bysub(Underlying.Connection, RealCompatible.CompatibleConnection, A);
\definition law: Gauge.Compatible Metric.g (Projection.value i).matrix := Preserve.preserves (A i).matrix (compatible i);
