\import Bundle.Dual[] \as Dual;
\import Bundle.Exterior[k := k, enumeration := enumeration] \as Exterior;
\import \root.Complex[n := n, r := Exterior.rank].On[M := M].Family[F := Exterior.Fiber, space := Exterior.fiberSpace].Of[I := I, bundle := Exterior.exterior] \as Result;
\import smooth_bundles.Complex[n := n, r := Exterior.rank].On[M := M].Family[F := Exterior.Fiber, space := Exterior.fiberSpace] \as ExteriorBundles;
\import smooth_bundles.Complex[n := n, r := r].On[M := M].Family[F := Dual.Fiber, space := Dual.fiberSpace].Of[I := I, bundle := Dual.dual] \as DualBundle;
\import DualBundle.Alternating[k := k, enumeration := enumeration] \as Alternating;
\module Coefficients(i, j: I);
\import \parent.Coefficients[connection := connection] \as OriginalCoefficients;
\definition data: Result.ComplexData := \fun (i: I) =>
  \root.ComplexExteriorGauge[n := n, r := r].On[U := (chart i).image].At[k := k, enumeration := enumeration].Forms[].lift (OriginalCoefficients.data i);
\module Pair(i, j: I);
\definition compatibility: Result.ComplexCompatible data := \fun (i, j: I) => Pair[i := i, j := j].law;
\import Result.FromCoefficients[data := data, compatible := compatibility] \as Construction;
\definition value: Result.Connection := Construction.value;
\definition coefficients: Result.Coefficients[connection := value].data = data := Construction.extracted;
