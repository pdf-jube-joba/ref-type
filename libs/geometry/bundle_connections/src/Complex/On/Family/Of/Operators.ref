\import Underlying.SectionCoordinates[] \as Sections;
\import Bundle.Sections[] \as NativeSections;
\import Underlying.Operators[] \as RealOperators;
\definition Section: \Set := Sections.Section;
\definition OneForm: \Set := RealOperators.OneForm;
\definition covariant[A: Connection][s: Section]: OneForm := RealOperators.covariant (forget A) s;
\module Imaginary(s: Section);
\definition imaginary[s: Section]: Section := Imaginary[s := s].value;
\module Local(A: Connection, s: Section, i: I);
