\import \root.ComplexMatrices[n := n, r := r].On[U := (chart i).image] \as Matrices;
\import Matrices.RecoveryProducts[] \as Products;
\import Matrices.Commutation[] \as Commutation;
\import \root.Forms[n := n, r := realRank].On[U := (chart i).image] \as Forms;
\import \root.MatrixCalculus[n := n, r := realRank].On[U := (chart i).image] \as RealMatrices;
\definition eta: \forall (A: Forms.Connection) -> Forms.Connection { matrix := A.matrix } = A :=
  \induction (A: Forms.Connection) \return Forms.Connection { matrix := A.matrix } = A \with {
    | # : \fun (matrix: RealMatrices.Matrix1) => \refl(Forms.Connection { matrix := matrix })
  };
\definition law: Rebuilt.value i = connection i := trans!{{Forms.Connection}} _ _ _
  (congr!{{RealMatrices.Matrix1} {Forms.Connection}} (\fun (A: RealMatrices.Matrix1) => Forms.Connection { matrix := A }) _ _
    (Products.reconstruction1 (connection i).matrix (Commutation.form (connection i).matrix (complexLinear connection i))))
  (eta (connection i));
