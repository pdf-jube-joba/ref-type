\import Bundle.Metrics[] \as Metrics;
\import smooth_bundles.Real[n := n, r := realRank].On[M := M].Family[F := F, space := Bundles.realSpace].Of[I := I, bundle := Bundle.forget].Metrics[] \as RealMetrics;
\module At(x: M.Point);
\definition data: RealMetrics.Data := RealMetrics.Data {
  form := \fun (x: M.Point) => At[x := x].form,
  positive := \fun (x: M.Point) => At[x := x].positive,
};
\module Local(i: I);
\definition smooth: RealMetrics.Smooth data := \fun (i: I)(a, b: Fin.Fin realRank) => Local[i := i].smooth a b;
\definition realMetric: RealMetrics.Metric := \into[RealMetrics.Data](data, { h: RealMetrics.Data \where RealMetrics.Smooth h }) \by { smooth };
\module Orthogonal(i: I);

\import Underlying.WithMetric[metric := realMetric] \as RealCompatible;
\definition MetricCompatible[A: Connection]: \Prop := RealCompatible.MetricCompatible (forget A);
\definition CompatibleConnection: \Set := \Cast[Connection] ({ A: Connection \where MetricCompatible A });
\module Project(A: RealCompatible.CompatibleConnection);
\definition existsCompatible: \exists CompatibleConnection := \block {
  \takefrom A: RealCompatible.CompatibleConnection \by RealCompatible.existsCompatible \then
  \return \exact(Project[A := A].value, CompatibleConnection)
};
