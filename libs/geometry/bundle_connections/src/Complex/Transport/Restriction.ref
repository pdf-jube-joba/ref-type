\import \root.Real[n := n, r := realRank].Transport[U := U, V := V].Restriction[included := included] \as Maps;
\definition twist: \forall (A: Target.Matrix1) -> Maps.matrix1 (TargetProjection.twist A) = SourceProjection.twist (Maps.matrix1 A) :=
  \fun (A: Target.Matrix1) => eq_reason_in!{{Source.Matrix1} _
    "=" _ "by" { Maps.scale (R.neg R.one) (Target.product10 (Target.product01 TargetStructure.matrix A) TargetStructure.matrix) }
    "=" _ "by" { congr!{{Source.Matrix1} {Source.Matrix1}} (SourceLinear.scale (R.neg R.one)) _ _
      (Maps.product10 (Target.product01 TargetStructure.matrix A) TargetStructure.matrix) }
    "=" _ "by" { congr!{{Source.Matrix1} {Source.Matrix1}} (\fun (X: Source.Matrix1) => SourceLinear.scale (R.neg R.one) (Source.product10 X SourceStructure.matrix)) _ _
      (Maps.product01 TargetStructure.matrix A) }
  };
\definition project: \forall (A: Target.Matrix1) -> Maps.matrix1 (TargetStructure.project A) = SourceStructure.project (Maps.matrix1 A) :=
  \fun (A: Target.Matrix1) => eq_reason_in!{{Source.Matrix1} _
    "=" _ "by" { Maps.scale R.half (Target.plus A (TargetProjection.twist A)) }
    "=" _ "by" { congr!{{Source.Matrix1} {Source.Matrix1}} (SourceLinear.scale R.half) _ _ (Maps.plus A (TargetProjection.twist A)) }
    "=" _ "by" { congr!{{Source.Matrix1} {Source.Matrix1}} (\fun (X: Source.Matrix1) => SourceLinear.scale R.half (Source.plus (Maps.matrix1 A) X)) _ _ (twist A) }
  };
