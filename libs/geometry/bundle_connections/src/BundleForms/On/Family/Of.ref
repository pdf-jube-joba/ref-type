\definition baseBundle: Bundles.Bundle[I] := bundle;
\import manifolds.Tangent[n := n].On[M := M] \as Tangent;
\import smooth_bundles.Tangent[n := n].On[M := M] \as Standard;
\import smooth_bundles.Real[n := n, r := n].On[M := M].Family[F := Tangent.Vector, space := Tangent.space] \as TangentBundles;
\import tangent_bundles.FrameBundle[n := n, r := n].Over[M := M].Family[F := Tangent.Vector, space := Tangent.space] \as TangentFrames;
\definition tangentData: TangentFrames.Data[I] := TangentFrames.Data[I] {
  local := \fun (i: I) => Standard.bundle.atlas.local (bundle.atlas.local i).chart,
  covers := bundle.atlas.covers,
};
\definition tangent: TangentBundles.Bundle[I] := TangentBundles.Bundle[I] {
  atlas := tangentData,
  regular := \fun (i, j: I) => Standard.bundle.regular (bundle.atlas.local i).chart (bundle.atlas.local j).chart,
};
\module Alternating(k: N.Nat^, enumeration: Operations.ExteriorIndices[n := n, k := k].Enumeration);
