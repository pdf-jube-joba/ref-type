\import Tensor.In[i := i, x := x] \as Native;
\definition first: std.Data[].FinSet[].Fin rank -> std.Data[].FinSet[].Fin r := Native.first;
\definition second: std.Data[].FinSet[].Fin rank -> std.Data[].FinSet[].Fin Alternating.rank := Native.second;
\definition coefficient: \forall (a: std.Data[].FinSet[].Fin rank) -> Spaces.Linear[V := Fiber x, W := R.Real, source := fiberSpace x, target := Spaces.scalarSpace].Map := Native.coefficient;
\definition onPure: \forall (a: std.Data[].FinSet[].Fin rank)(v: F x)(w: Alternating.Fiber x) -> (coefficient a).apply (pure x v w) =
  R.mul (((baseBundle.atlas.local i).frame x).forward.apply v (first a)) (((Alternating.alternating.atlas.local i).frame x).forward.apply w (second a)) := Native.onPure;
