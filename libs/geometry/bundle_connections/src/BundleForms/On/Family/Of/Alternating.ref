\import TangentBundles.Of[I := I, bundle := tangent].Alternating[k := k, enumeration := enumeration] \as Alternating;
\import Bundles.Of[I := I, bundle := bundle].Paired[s := Alternating.rank, G := Alternating.Fiber, otherSpace := Alternating.fiberSpace,
  otherFrame := \fun (i: I) => (Alternating.alternating.atlas.local i).frame].Using[regular := Alternating.alternating.regular] \as Paired;
\module Tensor(enumeration: Operations.PairIndices[n := r, m := Alternating.rank].Enumeration);
\definition rank: N.Nat^ := Alternating.rank;
\definition Fiber: M.Point -> \Set := Alternating.Fiber;
\definition fiberSpace: \forall (x: M.Point) -> Spaces.VectorSpace (Fiber x) := Alternating.fiberSpace;
\import Operations.ExteriorIndices[n := n, k := k] \as Indices;
\import Operations.FiniteIndex[A := Indices.Tuple, S := Indices.set, enumeration := enumeration] \as Coordinates;
\definition indices: std.Data[].FinSet[].Fin rank -> Indices.Tuple := Coordinates.ambientEnumerate;
