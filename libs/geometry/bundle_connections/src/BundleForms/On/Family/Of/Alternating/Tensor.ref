\import Paired.Tensor[enumeration := enumeration] \as Tensor;
\definition rank: N.Nat^ := Tensor.rank;
\definition Fiber: M.Point -> \Set := Tensor.Fiber;
\definition fiberSpace: \forall (x: M.Point) -> Spaces.VectorSpace (Fiber x) := Tensor.fiberSpace;
\import smooth_bundles.Real[n := n, r := rank].On[M := M].Family[F := Fiber, space := fiberSpace] \as Bundle;
\definition bundle: Bundle.Bundle[I] := Tensor.tensor;
\import Bundle.Of[I := I, bundle := bundle].Sections[] \as Sections;
\definition Form: \Set := Sections.Section;
\definition zero: Form := Sections.zero;
\definition pure[x: M.Point][v: F x][alpha: Alternating.Fiber x]: Fiber x := Tensor.pure x v alpha;
\module At(i: I, x: manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space].LocalPoint (bundle.atlas.local i).chart);
