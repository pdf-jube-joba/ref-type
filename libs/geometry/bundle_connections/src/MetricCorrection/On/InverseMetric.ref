\import \parent.Matrices[] \as Matrices;
\definition value: M.Matrix0 := M.product00 p (Transpose.transpose0 S);
\definition K: M.Matrix0 := M.product00 (Transpose.transpose0 T) h;
\definition law: M.product00 value K = Algebra.identity := eq_reason_in!{M.Matrix0 _
  "=" _ "by" { Matrices.assoc p (Transpose.transpose0 S) K }
  "=" _ "by" { congr!{M.Matrix0 M.Matrix0} (M.product00 p) _ _ (sym!{M.Matrix0} _ _ (Matrices.assoc (Transpose.transpose0 S) (Transpose.transpose0 T) h)) }
  "=" _ "by" { congr!{M.Matrix0 M.Matrix0} (\fun (X: M.Matrix0) => M.product00 p (M.product00 X h)) _ _ (sym!{M.Matrix0} _ _ (Matrices.transpose T S)) }
  "=" _ "by" { congr!{M.Matrix0 M.Matrix0} (\fun (X: M.Matrix0) => M.product00 p (M.product00 (Transpose.transpose0 X) h)) _ _ rightT }
  "=" _ "by" { congr!{M.Matrix0 M.Matrix0} (\fun (X: M.Matrix0) => M.product00 p (M.product00 X h)) _ _ Matrices.transposeIdentity }
  "=" _ "by" { congr!{M.Matrix0 M.Matrix0} (M.product00 p) _ _ (Matrices.identityLeft h) }
  "=" _ "by" leftH
};
