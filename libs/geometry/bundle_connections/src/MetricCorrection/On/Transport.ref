\definition tT: M.Matrix0 := Transpose.transpose0 T;
\definition tB: M.Matrix1 := Transpose.transpose1 B;
\definition dT: M.Matrix1 := M.dMatrix T;
\definition dtT: M.Matrix1 := M.dMatrix tT;
\definition L1: M.Matrix1 := M.product10 (M.product10 dtT h) T;
\definition L2: M.Matrix1 := M.product10 (M.product01 tT (M.product10 tB h)) T;
\definition R1: M.Matrix1 := M.product01 (M.product00 tT h) dT;
\definition R2: M.Matrix1 := M.product01 (M.product00 tT h) (M.product10 B T);
\definition left: M.product10 (Transpose.transpose1 A) (Transpose.metric T h) = M.plus L1 L2 := eq_reason_in!{M.Matrix1 _
  "=" _ "by" { sym!{M.Matrix1} _ _ (Algebra.assoc100 (Transpose.transpose1 A) (M.product00 tT h) T) }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 X T) _ _
    (sym!{M.Matrix1} _ _ (Algebra.assoc100 (Transpose.transpose1 A) tT h)) }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 (M.product10 X h) T) _ _
    (sym!{M.Matrix1} _ _ (Transpose.transpose01 T A)) }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 (M.product10 (Transpose.transpose1 X) h) T) _ _ gauge }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 (M.product10 X h) T) _ _
    (trans!{M.Matrix1} _ _ _ (Transpose.transposeAdd dT (M.product10 B T))
      (congr!{M.Matrix1 M.Matrix1} (M.plus dtT) _ _ (Transpose.transpose10 B T))) }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 X T) _ _
    (Linear.rightAdd dtT (M.product01 tT tB) h) }
  "=" _ "by" { Linear.rightAdd (M.product10 dtT h) (M.product10 (M.product01 tT tB) h) T }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (M.plus L1) _ _
    (congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 X T) _ _ (Algebra.assoc010 tT tB h)) }
};

\definition middle: M.Matrix1 := M.product10 (M.product01 tT (M.dMatrix h)) T;
\definition derivative: M.dMatrix (Transpose.metric T h) = M.plus (M.plus L1 middle) R1 := eq_reason_in!{M.Matrix1 _
  "=" _ "by" { M.productRule (M.product00 tT h) T }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.plus (M.product10 X T) R1) _ _ (M.productRule tT h) }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.plus X R1) _ _
    (Linear.rightAdd (M.product10 dtT h) (M.product01 tT (M.dMatrix h)) T) }
};
