\import \root.MatrixCalculus[n := n, r := r].On[U := U] \as Source;
\import \root.MatrixCalculus[n := n, r := r].On[U := V] \as Target;
\import Source.Linearity[] \as SourceLinear;
\import Target.Linearity[] \as TargetLinear;
\import \root.MetricCorrection[n := n, r := r].On[U := U] \as SourceCorrection;
\import \root.MetricCorrection[n := n, r := r].On[U := V] \as TargetCorrection;
\import \root.LeviCivita[n := n].Gauge[r := r, U := U] \as SourceTranspose;
\import \root.LeviCivita[n := n].Gauge[r := r, U := V] \as TargetTranspose;
\import Spaces.Laws[V := Source.Matrix1, space := SourceLinear.space] \as SourceLaws;
\import Spaces.Laws[V := Target.Matrix1, space := TargetLinear.space] \as TargetLaws;
\module Pull(f: calculus.Maps[n := n, m := n].Map U V);
\module Restriction(included: Open.Included U V);
