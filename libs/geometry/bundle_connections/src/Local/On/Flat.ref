\import \root.Local[n := n, r := r].On[U := U] \as LocalCoordinates;
\import \parent.Of[connection := flat] \as Operator;
\import Spaces.Laws[V := Functions.Function, space := Functions.vectorSpace] \as Laws;
\definition correction: \forall (i: Fin.Fin n)(s: Section)(a: Fin.Fin r) -> Operator.correction i s a = Functions.origin :=
  \fun (i: Fin.Fin n)(s: Section)(a: Fin.Fin r) => Functions.ext (Operator.correction i s a) Functions.origin (\fun (x: Open.Carrier U) => trans!{{R.Real}} _ _ _
    (Sums.congruent r (\fun (b: Fin.Fin r) => R.mul R.zero (s b x)) (\fun (b: Fin.Fin r) => R.zero) (\fun (b: Fin.Fin r) => Spaces.mulZeroLeft (s b x))) (Sums.zeroSum r));
\definition partial: \forall (i: Fin.Fin n)(s: Section) -> Operator.partial i s = LocalCoordinates.partial i s :=
  \fun (i: Fin.Fin n)(s: Section) => \axiom:funext(Operator.partial i s, LocalCoordinates.partial i s, \fun (a: Fin.Fin r) => trans!{{Functions.Function}} _ _ _
    (congr!{{Functions.Function} {Functions.Function}} (Functions.plus (Derivatives.apply i (s a))) _ _ (correction i s a)) (Laws.zeroRight (Derivatives.apply i (s a))));
\definition constant[v: Fin.Fin r -> R.Real]: Section := \fun (a: Fin.Fin r) => Functions.constant (v a);
\definition constantParallel: \forall (i: Fin.Fin n)(v: Fin.Fin r -> R.Real) -> Operator.partial i (constant v) = (\fun (a: Fin.Fin r) => Functions.origin) :=
  \fun (i: Fin.Fin n)(v: Fin.Fin r -> R.Real) => trans!{Section} _ _ _ (partial i (constant v))
    (\axiom:funext(LocalCoordinates.partial i (constant v), (\fun (a: Fin.Fin r) => Functions.origin), \fun (a: Fin.Fin r) => Derivatives.constant i (v a)));
