\definition fr: RealFunctions.Function := Functions.real f;
\definition fi: RealFunctions.Function := Functions.imaginary f;
\definition gr: RealFunctions.Function := Functions.real g;
\definition gi: RealFunctions.Function := Functions.imaginary g;
\definition real: (differential (functionProduct f g)).real = (add (multiply g (differential f)) (multiply f (differential g))).real := eq_reason_in!{{Scalar.Form one} _
  "=" _ "by" { congr!{{RealFunctions.Function} {Scalar.Form one}} RealMatrices.differential _ _ (realProduct f g) }
  "=" _ "by" { RealMatrices.dAdd (RealFunctions.product fr gr) (RealFunctions.vectorSpace.neg (RealFunctions.product fi gi)) }
  "=" _ "by" { congr!{{Scalar.Form one} {Scalar.Form one} {Scalar.Form one}} Forms.plus _ _ _ _ (RealMatrices.dProduct fr gr)
    (trans!{{Scalar.Form one}} _ _ _ (dNegative (RealFunctions.product fi gi)) (congr!{{Scalar.Form one} {Scalar.Form one}} Forms.space.neg _ _ (RealMatrices.dProduct fi gi))) }
  "=" _ "by" { Scalar.ext one _ _ (\fun (x: Open.Carrier U)(v: Multilinear.Arguments one) => R.Algebra[].subAdd
    (R.mul (gr x) (RealMatrices.differential fr x v)) (R.mul (fr x) (RealMatrices.differential gr x v))
    (R.mul (gi x) (RealMatrices.differential fi x v)) (R.mul (fi x) (RealMatrices.differential gi x v))) }
};
\definition imaginary: (differential (functionProduct f g)).imaginary = (add (multiply g (differential f)) (multiply f (differential g))).imaginary := eq_reason_in!{{Scalar.Form one} _
  "=" _ "by" { congr!{{RealFunctions.Function} {Scalar.Form one}} RealMatrices.differential _ _ (imaginaryProduct f g) }
  "=" _ "by" { RealMatrices.dAdd (RealFunctions.product fr gi) (RealFunctions.product fi gr) }
  "=" _ "by" { congr!{{Scalar.Form one} {Scalar.Form one} {Scalar.Form one}} Forms.plus _ _ _ _ (RealMatrices.dProduct fr gi) (RealMatrices.dProduct fi gr) }
  "=" _ "by" { Scalar.ext one _ _ (\fun (x: Open.Carrier U)(v: Multilinear.Arguments one) =>
    trans!{{R.Real}} _ _ _
      (R.Algebra[].addFour (R.mul (gi x) (RealMatrices.differential fr x v)) (R.mul (fr x) (RealMatrices.differential gi x v))
        (R.mul (gr x) (RealMatrices.differential fi x v)) (R.mul (fi x) (RealMatrices.differential gr x v)))
      (congr!{{R.Real} {R.Real}} (\fun (z: R.Real) => R.add z (R.add (R.mul (fr x) (RealMatrices.differential gi x v)) (R.mul (fi x) (RealMatrices.differential gr x v)))) _ _
        (Reals.addComm (R.mul (gi x) (RealMatrices.differential fr x v)) (R.mul (gr x) (RealMatrices.differential fi x v))))) }
};
