\import \parent.Numeric[] \as Numeric;
\import \root.Complex[n := n, r := r].Structure[].On[U := U] \as J;
\import RealMatrices.Associativity[] \as Algebra;
\definition scalar: \forall (A: RealMatrices.Matrix0) -> RealMatrices.product00 J.matrix A = RealMatrices.product00 A J.matrix ->
  \forall (x: Open.Carrier U) -> Numeric.Commuting (Algebra.eval0 A x) :=
  \fun (A: RealMatrices.Matrix0)(law: _)(x: Open.Carrier U) => Numeric.fromMatrix (Algebra.eval0 A x)
    (congr!{{RealMatrices.Matrix0} {Numeric.RealMatrix}} (\fun (B: RealMatrices.Matrix0) => Algebra.eval0 B x) _ _ law);
\definition form: \forall (A: RealMatrices.Matrix1) -> RealMatrices.product01 J.matrix A = RealMatrices.product10 A J.matrix ->
  \forall (x: Open.Carrier U)(v: Multilinear.Arguments one) -> Numeric.Commuting (Algebra.eval1 A x v) :=
  \fun (A: RealMatrices.Matrix1)(law: _)(x: Open.Carrier U)(v: Multilinear.Arguments one) => Numeric.fromMatrix (Algebra.eval1 A x v)
    (eq_reason_in!{{Numeric.RealMatrix} _
      "=" _ "by" { sym!{{Numeric.RealMatrix}} _ _ (Algebra.eval01 J.matrix A x v) }
      "=" _ "by" { congr!{{RealMatrices.Matrix1} {Numeric.RealMatrix}} (\fun (B: RealMatrices.Matrix1) => Algebra.eval1 B x v) _ _ law }
      "=" _ "by" { Algebra.eval10 A J.matrix x v }
    });
\definition matrix: \forall (A: RealMatrices.Matrix1) -> (\forall (x: Open.Carrier U)(v: Multilinear.Arguments one) -> Numeric.Commuting (Algebra.eval1 A x v)) ->
  RealMatrices.product01 J.matrix A = RealMatrices.product10 A J.matrix :=
  \fun (A: RealMatrices.Matrix1)(law: _) => Algebra.ext (RealMatrices.product01 J.matrix A) (RealMatrices.product10 A J.matrix)
    (\fun (x: Open.Carrier U)(v: Multilinear.Arguments one) => eq_reason_in!{{Numeric.RealMatrix} _
      "=" _ "by" { Algebra.eval01 J.matrix A x v }
      "=" _ "by" { Numeric.toMatrix (Algebra.eval1 A x v) (law x v) }
      "=" _ "by" { sym!{{Numeric.RealMatrix}} _ _ (Algebra.eval10 A J.matrix x v) }
    });
