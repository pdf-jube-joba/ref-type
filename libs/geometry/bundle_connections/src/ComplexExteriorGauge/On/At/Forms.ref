\import \parent.Algebra[] \as Algebra;
\import \parent.Tangent[] \as Tangent;
\import \parent.Expansion[] \as Expansion;
\import \parent.Naturality[] \as Naturality;
\import \root.ComplexMatrices[n := n, r := rank].On[U := U] \as ResultMatrix;
\import real.Analysis[] \as R;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real R.Algebra[].field] \as Reals;
\import Reals.Coordinates[I := Fin.Fin n] \as TangentVectors;
\import Reals.Multilinear[V := TangentVectors.Vector, space := TangentVectors.space] \as TangentMultilinear;
\import euclidean_forms.Euclidean[n := n].On[U := U] \as Scalar;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := linear_algebra.Hermitian[].Complex[].scalar].Sums[] \as Sums;
\definition entry: Fin.Fin rank -> Fin.Fin rank -> Fin.Fin k -> Fin.Fin r -> C.Complex := Expansion.coefficient;
\definition rawLift[A: Matrix.Matrix1][a, b: Fin.Fin rank]: Matrix.OneForm := Matrix.sum k (\fun (slot: Fin.Fin k) =>
  Matrix.sum r (\fun (c: Fin.Fin r) => Matrix.multiply (Functions.constant (entry a b slot c)) (A (Coordinates.enumerate a slot) c)));
\definition lift[A: Matrix.Matrix1][a, b: Fin.Fin rank]: ResultMatrix.OneForm := ResultMatrix.OneForm { real := (rawLift A a b).real, imaginary := (rawLift A a b).imaginary };
\definition value: \forall (A: Matrix.Matrix1)(a, b: Fin.Fin rank)(x: Open.Carrier U)(v: TangentMultilinear.Arguments one) ->
  ResultMatrix.evaluate (lift A a b) x v = Sums.sum k (\fun (slot: Fin.Fin k) => Sums.sum r (\fun (c: Fin.Fin r) => Op.mul (entry a b slot c) (Matrix.evaluate (A (Coordinates.enumerate a slot) c) x v))) :=
  \fun (A: Matrix.Matrix1)(a, b: Fin.Fin rank)(x: Open.Carrier U)(v: TangentMultilinear.Arguments one) => trans!{{C.Complex}} _ _ _
    (Matrix.valueSum k (\fun (slot: Fin.Fin k) => Matrix.sum r (\fun (c: Fin.Fin r) => Matrix.multiply (Functions.constant (entry a b slot c)) (A (Coordinates.enumerate a slot) c))) x v)
    (Sums.congruent k
      (\fun (slot: Fin.Fin k) => Matrix.evaluate (Matrix.sum r (\fun (c: Fin.Fin r) => Matrix.multiply (Functions.constant (entry a b slot c)) (A (Coordinates.enumerate a slot) c))) x v)
      (\fun (slot: Fin.Fin k) => Sums.sum r (\fun (c: Fin.Fin r) => Op.mul (entry a b slot c) (Matrix.evaluate (A (Coordinates.enumerate a slot) c) x v)))
      (\fun (slot: Fin.Fin k) => Matrix.valueSum r (\fun (c: Fin.Fin r) => Matrix.multiply (Functions.constant (entry a b slot c)) (A (Coordinates.enumerate a slot) c)) x v));
\module Gauge(T: Matrix.Matrix0, A, B: Matrix.Matrix1, compatible: Matrix.product01 T A = Matrix.plus (Matrix.dMatrix T) (Matrix.product10 B T));
