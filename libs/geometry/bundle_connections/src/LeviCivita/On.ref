\import Smooth.Algebra[U := U] \as Functions;
\import Smooth.Derivative[].Linear[U := U] \as Derivatives;
\definition Index: \Set := Fin.Fin n;
\definition Matrix: \Set := Index -> Index -> Functions.Function;
\definition Tensor: \Set := Index -> Index -> Index -> Functions.Function;
\structure MetricCoefficients: \Set := {
  value: Matrix,
  symmetric: \forall (i, j: Index) -> value i j = value j i,
};
\module Of(metric: MetricCoefficients);
\module Riemannian(metric: \root.Metric[n := n, r := n].On[U := U].Metric);
\module Euclidean;
