\import calculus.Maps[n := n, m := n] \as Maps;
\import Maps.Composition[U := U, V := V, f := map] \as Pull;
\import \root.Local[n := n, r := n].On[U := U] \as Source;
\import \root.Local[n := n, r := n].On[U := V] \as Target;
\import Smooth.Algebra[U := U] \as Functions;
\import Smooth.Derivative[].Linear[U := U] \as Derivatives;
\definition Index: \Set := Fin.Fin n;
\definition jacobian[a, i: Index]: Functions.Function := Derivatives.apply i (Maps.coordinateFunction U V map a);
\definition hessian: \forall (a, i, j: Index) -> Derivatives.apply i (jacobian a j) = Derivatives.apply j (jacobian a i) :=
  \fun (a, i, j: Index) => Smooth.Mixed[].commute U (Maps.coordinateFunction U V map a) j i;
\module Transform(connection: Target.Connection, inverse: Source.Matrix);
\module MetricPullback;
\import \root.Metric[n := n, r := n].On[U := U] \as SourceMetrics;
\import \root.Metric[n := n, r := n].On[U := V] \as TargetMetrics;
\module Riemannian(sourceMetric: SourceMetrics.Metric, targetMetric: TargetMetrics.Metric, inverse: Source.Matrix);
