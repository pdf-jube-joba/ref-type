\definition cancel: \forall (a, b: R.Real) -> R.sub (R.add a b) b = a :=
  \fun (a, b: R.Real) => eq_reason_in!{{R.Real} _
    "=" _ "by" { Laws.addAssoc a b (R.neg b) }
    "=" _ "by" { congr!{{R.Real} {R.Real}} (R.add a) _ _ (Laws.addNegRight b) }
    "=" _ "by" { Laws.addZeroRight a }
  };
\definition doubled: \forall (a, b, c: R.Real) ->
  R.sub (R.add (R.add a b) (R.add a c)) (R.add b c) = R.add a a :=
  \fun (a, b, c: R.Real) => trans!{{R.Real}} _ _ _
    (congr!{{R.Real} {R.Real}} (\fun (x: R.Real) => R.sub x (R.add b c)) _ _ (Algebra.addFour a b a c))
    (cancel (R.add a a) (R.add b c));
\definition paired: \forall (a, b, c: R.Real) ->
  R.add (R.sub (R.add a b) c) (R.sub (R.add a c) b) = R.add a a :=
  \fun (a, b, c: R.Real) => eq_reason_in!{{R.Real} _
    "=" _ "by" { sym!{{R.Real}} _ _ (Algebra.subAdd (R.add a b) (R.add a c) c b) }
    "=" _ "by" { congr!{{R.Real} {R.Real}} (R.sub (R.add (R.add a b) (R.add a c))) _ _ (Laws.addComm c b) }
    "=" _ "by" { doubled a b c }
  };
\definition halfDouble: \forall (a: R.Real) -> R.mul R.half (R.add a a) = a :=
  \fun (a: R.Real) => trans!{{R.Real}} _ _ _ (Laws.fieldMulAdd R.half a a) (Estimates.halfTwice a);
\definition koszul: \forall (a, b, c: R.Real) ->
  R.add (R.mul R.half (R.sub (R.add a b) c)) (R.mul R.half (R.sub (R.add a c) b)) = a :=
  \fun (a, b, c: R.Real) => eq_reason_in!{{R.Real} _
    "=" _ "by" { sym!{{R.Real}} _ _ (Laws.fieldMulAdd R.half (R.sub (R.add a b) c) (R.sub (R.add a c) b)) }
    "=" _ "by" { congr!{{R.Real} {R.Real}} (R.mul R.half) _ _ (paired a b c) }
    "=" _ "by" { halfDouble a }
  };
