\definition term[i, j, a, l, b: Index]: Functions.Function := Functions.product (jacobian l i)
  (Functions.product (Pull.function (connection.coefficient l a b)) (jacobian b j));
\definition correction[i, j, a: Index]: Functions.Function := Source.sum n (\fun (l: Index) => Source.sum n (term i j a l));
\definition covariantJacobian[i, j, a: Index]: Functions.Function := Functions.plus (Derivatives.apply i (jacobian a j)) (correction i j a);
\definition coefficient[i, a, j: Index]: Functions.Function := Source.sum n (\fun (b: Index) => Functions.product (inverse a b) (covariantJacobian i j b));
\definition value: Source.Connection := Source.Connection { coefficient := coefficient };
\definition TorsionFree: \Prop := \forall (i, j, a: Index) -> connection.coefficient i a j = connection.coefficient j a i;
\module Torsion(torsionFree: TorsionFree);
\module Forms;
