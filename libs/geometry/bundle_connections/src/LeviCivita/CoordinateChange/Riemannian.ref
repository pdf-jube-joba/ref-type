\import \root.LeviCivita[n := n].On[U := U].Riemannian[metric := sourceMetric] \as SourceLC;
\import \root.LeviCivita[n := n].On[U := V].Riemannian[metric := targetMetric] \as TargetLC;
\import \root.Metric[n := n, r := n].On[U := U].Of[metric := sourceMetric] \as SourceMetric;
\import \root.Metric[n := n, r := n].On[U := V].Of[metric := targetMetric] \as TargetMetric;
\import \root.MatrixCalculus[n := n, r := n].On[U := U] \as M;
\import \root.LeviCivita[n := n].Gauge[r := n, U := U] \as Gauge;
\import \root.Real[n := n, r := n].Transport[U := U, V := V].Pull[f := map] \as Transport;
\import \parent.Transform[connection := TargetLC.connection, inverse := inverse] \as Transform;
\import Transform.Forms[] \as Formula;
\import \root.Forms[n := n, r := n].On[U := U].Coordinates[connection := SourceLC.connection] \as SourceForms;
\import \root.Forms[n := n, r := n].On[U := V].Coordinates[connection := TargetLC.connection] \as TargetForms;
\definition RightInverse: \Prop := M.product00 jacobian inverse = M.Associativity[].identity;
\definition MetricLaw: \Prop := SourceMetric.coefficient = Gauge.metric jacobian (Transport.matrix0 TargetMetric.coefficient);
\module With(rightInverse: RightInverse, metricLaw: MetricLaw);
\definition naturality: RightInverse -> MetricLaw -> M.product01 jacobian SourceForms.matrix =
  M.plus (M.dMatrix jacobian) (M.product10 (Transport.matrix1 TargetForms.matrix) jacobian) :=
  \fun (rightInverse: RightInverse)(metricLaw: MetricLaw) => With[rightInverse := rightInverse, metricLaw := metricLaw].naturality;
