\definition tJ: M.Matrix0 := transpose0 J;
\definition tB: M.Matrix1 := transpose1 B;
\definition dJ: M.Matrix1 := M.dMatrix J;
\definition dtJ: M.Matrix1 := M.dMatrix tJ;
\definition L1: M.Matrix1 := M.product10 (M.product10 dtJ h) J;
\definition L2: M.Matrix1 := M.product10 (M.product01 tJ (M.product10 tB h)) J;
\definition R1: M.Matrix1 := M.product01 (M.product00 tJ h) dJ;
\definition R2: M.Matrix1 := M.product01 (M.product00 tJ h) (M.product10 B J);
\definition left: M.product10 (transpose1 A) (metric J h) = M.plus L1 L2 := eq_reason_in!{M.Matrix1 _
  "=" _ "by" { sym!{M.Matrix1} _ _ (Products.assoc100 (transpose1 A) (M.product00 tJ h) J) }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 X J) _ _
    (sym!{M.Matrix1} _ _ (Products.assoc100 (transpose1 A) tJ h)) }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 (M.product10 X h) J) _ _
    (sym!{M.Matrix1} _ _ (transpose01 J A)) }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 (M.product10 (transpose1 X) h) J) _ _ gauge }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 (M.product10 X h) J) _ _
    (trans!{M.Matrix1} _ _ _ (transposeAdd dJ (M.product10 B J))
      (congr!{M.Matrix1 M.Matrix1} (M.plus dtJ) _ _ (transpose10 B J))) }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 X J) _ _
    (rightDistribute dtJ (M.product01 tJ tB) h) }
  "=" _ "by" { rightDistribute (M.product10 dtJ h) (M.product10 (M.product01 tJ tB) h) J }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (M.plus L1) _ _
    (congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 X J) _ _ (Products.assoc010 tJ tB h)) }
};
\definition right: M.product01 (metric J h) A = M.plus R1 R2 := eq_reason_in!{M.Matrix1 _
  "=" _ "by" { Products.assoc001 (M.product00 tJ h) J A }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (M.product01 (M.product00 tJ h)) _ _ gauge }
  "=" _ "by" { Products.distribute (M.product00 tJ h) dJ (M.product10 B J) }
};
\definition middle: M.product10 (M.product01 tJ (M.dMatrix h)) J = M.plus L2 R2 := eq_reason_in!{M.Matrix1 _
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 (M.product01 tJ X) J) _ _ compatible }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 X J) _ _
    (Products.distribute tJ (M.product10 tB h) (M.product01 h B)) }
  "=" _ "by" { rightDistribute (M.product01 tJ (M.product10 tB h)) (M.product01 tJ (M.product01 h B)) J }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (M.plus L2) _ _
    (trans!{M.Matrix1} _ _ _
      (congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.product10 X J) _ _
        (sym!{M.Matrix1} _ _ (Products.assoc001 tJ h B)))
      (Products.assoc010 (M.product00 tJ h) B J)) }
};
\definition derivative: M.dMatrix (metric J h) = M.plus (M.plus L1 L2) (M.plus R1 R2) := eq_reason_in!{M.Matrix1 _
  "=" _ "by" { M.productRule (M.product00 tJ h) J }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.plus (M.product10 X J) R1) _ _ (M.productRule tJ h) }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.plus X R1) _ _
    (rightDistribute (M.product10 dtJ h) (M.product01 tJ (M.dMatrix h)) J) }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.plus (M.plus L1 X) R1) _ _ middle }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (\fun (X: M.Matrix1) => M.plus X R1) _ _ (sym!{M.Matrix1} _ _ (plusAssoc L1 L2 R2)) }
  "=" _ "by" { plusAssoc (M.plus L1 L2) R2 R1 }
  "=" _ "by" { congr!{M.Matrix1 M.Matrix1} (M.plus (M.plus L1 L2)) _ _ (plusComm R2 R1) }
};
\definition preservation: Compatible (metric J h) A := trans!{M.Matrix1} _ _ _ derivative
  (congr!{M.Matrix1 M.Matrix1 M.Matrix1} M.plus _ _ _ _ (sym!{M.Matrix1} _ _ left) (sym!{M.Matrix1} _ _ right));
