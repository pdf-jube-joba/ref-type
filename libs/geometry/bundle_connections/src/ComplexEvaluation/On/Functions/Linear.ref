\import Open.Smooth[].Algebra[U := U] \as RealFunctions;
\import Open.Smooth[].Derivative[].Linear[U := U] \as Derivatives;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real R.Algebra[].field] \as Reals;
\definition realPlus: \forall (f, g: Function) -> Native.real (plus f g) = RealFunctions.plus (Native.real f) (Native.real g) :=
  \fun (f, g: Function) => RealFunctions.ext _ _ (\fun (x: Open.Carrier U) => \refl(R.add (C.re (f x)) (C.re (g x))));
\definition imaginaryPlus: \forall (f, g: Function) -> Native.imaginary (plus f g) = RealFunctions.plus (Native.imaginary f) (Native.imaginary g) :=
  \fun (f, g: Function) => RealFunctions.ext _ _ (\fun (x: Open.Carrier U) => \refl(R.add (C.im (f x)) (C.im (g x))));
\definition addition: \forall (i: Fin.Fin n)(f, g: Function) -> derivative i (plus f g) = plus (derivative i f) (derivative i g) :=
  \fun (i: Fin.Fin n)(f, g: Function) => ext _ _ (\fun (x: Open.Carrier U) => C.Prop[].ext _ _
    (trans!{{R.Real}} _ _ _ (congr!{{RealFunctions.Function} {R.Real}} (\fun (h: RealFunctions.Function) => Derivatives.apply i h x) _ _ (realPlus f g))
      (congr!{{RealFunctions.Function} {R.Real}} (\fun (h: RealFunctions.Function) => h x) _ _ (Derivatives.addition i (Native.real f) (Native.real g))))
    (trans!{{R.Real}} _ _ _ (congr!{{RealFunctions.Function} {R.Real}} (\fun (h: RealFunctions.Function) => Derivatives.apply i h x) _ _ (imaginaryPlus f g))
      (congr!{{RealFunctions.Function} {R.Real}} (\fun (h: RealFunctions.Function) => h x) _ _ (Derivatives.addition i (Native.imaginary f) (Native.imaginary g)))));
\definition constant: \forall (i: Fin.Fin n)(c: C.Complex) -> derivative i (\parent.constant c) = origin :=
  \fun (i: Fin.Fin n)(c: C.Complex) => ext _ _ (\fun (x: Open.Carrier U) => C.Prop[].ext _ _
    (trans!{{R.Real}} _ _ _ (congr!{{RealFunctions.Function} {R.Real}} (\fun (h: RealFunctions.Function) => Derivatives.apply i h x)
      (Native.real (\parent.constant c)) (RealFunctions.constant (C.re c)) (RealFunctions.ext _ _ (\fun (y: Open.Carrier U) => \refl(C.re c))))
      (congr!{{RealFunctions.Function} {R.Real}} (\fun (h: RealFunctions.Function) => h x) _ _ (Derivatives.constant i (C.re c))))
    (trans!{{R.Real}} _ _ _ (congr!{{RealFunctions.Function} {R.Real}} (\fun (h: RealFunctions.Function) => Derivatives.apply i h x)
      (Native.imaginary (\parent.constant c)) (RealFunctions.constant (C.im c)) (RealFunctions.ext _ _ (\fun (y: Open.Carrier U) => \refl(C.im c))))
      (congr!{{RealFunctions.Function} {R.Real}} (\fun (h: RealFunctions.Function) => h x) _ _ (Derivatives.constant i (C.im c)))));
\import Reals.FiniteCoordinates[n := n] \as BaseBasis;
\import Reals.FiniteCoordinateEnumeration[] \as Enumeration;
\import Reals.Coordinates[I := Fin.Fin n] \as BaseVectors;
\import Reals.Multilinear[V := BaseVectors.Vector, space := BaseVectors.space] \as BaseMultilinear;
\import \root.MatrixCalculus[n := n, r := r].On[U := U] \as RealMatrix;
\import euclidean_forms.Euclidean[n := n].On[U := U] \as Scalar;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition basis[i: Fin.Fin n]: BaseMultilinear.Arguments one := \fun (slot: Fin.Fin one) => BaseBasis.vectors i;
\definition realDifferential: \forall (f: RealFunctions.Function)(i: Fin.Fin n)(x: Open.Carrier U) -> RealMatrix.differential f x (basis i) = Derivatives.apply i f x :=
  \fun (f: RealFunctions.Function)(i: Fin.Fin n)(x: Open.Carrier U) => eq_reason_in!{{R.Real} _
    "=" { R.FiniteSums[].sum n (\fun (j: Fin.Fin n) => R.mul (Derivatives.apply j f x) (BaseBasis.vectors i j)) } "by" { Scalar.FunctionDifferential[].law f x (basis i) }
    "=" { Reals.Sums[I := Fin.Fin n].sum (Fin.elements n) (\fun (j: Fin.Fin n) => R.mul (Derivatives.apply j f x) (BaseBasis.vectors i j)) } "by" {
      sym!{{R.Real}} _ _ (Enumeration.sumLaw n (\fun (j: Fin.Fin n) => R.mul (Derivatives.apply j f x) (BaseBasis.vectors i j))) }
    "=" _ "by" { BaseBasis.dualReconstruction (\fun (j: Fin.Fin n) => Derivatives.apply j f x) i }
  };
\definition differentialBasis: \forall (f: Function)(i: Fin.Fin n)(x: Open.Carrier U) -> Matrices.evaluate (Matrices.differential f) x (basis i) = derivative i f x :=
  \fun (f: Function)(i: Fin.Fin n)(x: Open.Carrier U) => C.Prop[].ext _ _ (realDifferential (Native.real f) i x) (realDifferential (Native.imaginary f) i x);
\definition product: \forall (i: Fin.Fin n)(f, g: Function) -> derivative i (\parent.product f g) = plus (\parent.product (derivative i f) g) (\parent.product f (derivative i g)) :=
  \fun (i: Fin.Fin n)(f, g: Function) => ext _ _ (\fun (x: Open.Carrier U) => eq_reason_in!{{C.Complex} _
    "=" { Matrices.evaluate (Matrices.differential (\parent.product f g)) x (basis i) } "by" { sym!{{C.Complex}} _ _ (differentialBasis (\parent.product f g) i x) }
    "=" { Op.add (Op.mul (g x) (Matrices.evaluate (Matrices.differential f) x (basis i))) (Op.mul (f x) (Matrices.evaluate (Matrices.differential g) x (basis i))) } "by" {
      congr!{{Matrices.OneForm} {C.Complex}} (\fun (h: Matrices.OneForm) => Matrices.evaluate h x (basis i)) _ _ (Matrices.Algebra[].dProduct f g) }
    "=" { Op.add (Op.mul (g x) (derivative i f x)) (Op.mul (f x) (derivative i g x)) } "by" { congr!{{C.Complex} {C.Complex} {C.Complex}} Op.add _ _ _ _
      (congr!{{C.Complex} {C.Complex}} (Op.mul (g x)) _ _ (differentialBasis f i x)) (congr!{{C.Complex} {C.Complex}} (Op.mul (f x)) _ _ (differentialBasis g i x)) }
    "=" _ "by" { congr!{{C.Complex} {C.Complex}} (\fun (z: C.Complex) => Op.add z (Op.mul (f x) (derivative i g x))) _ _ (Spaces.mulComm (g x) (derivative i f x)) }
  });
\definition scalar: \forall (i: Fin.Fin n)(c: C.Complex)(f: Function) -> derivative i (scale c f) = scale c (derivative i f) :=
  \fun (i: Fin.Fin n)(c: C.Complex)(f: Function) => trans!{Function} _ _ _ (product i (\parent.constant c) f)
    (ext _ _ (\fun (x: Open.Carrier U) => eq_reason_in!{{C.Complex} _
      "=" { Op.add (Op.mul Op.zero (f x)) (Op.mul c (derivative i f x)) } "by" { congr!{{C.Complex} {C.Complex}} (\fun (z: C.Complex) => Op.add (Op.mul z (f x)) (Op.mul c (derivative i f x))) _ _
        (congr!{Function {C.Complex}} (\fun (h: Function) => h x) _ _ (constant i c)) }
      "=" { Op.add Op.zero (Op.mul c (derivative i f x)) } "by" { congr!{{C.Complex} {C.Complex}} (\fun (z: C.Complex) => Op.add z (Op.mul c (derivative i f x))) _ _ (Spaces.mulZeroLeft (f x)) }
      "=" _ "by" { Spaces.addZeroLeft (Op.mul c (derivative i f x)) }
    }));

\definition apply: Fin.Fin n -> Function -> Function := derivative;
