\use std.Logic[].Equality[].eq_reason_in;

\import Spaces.Sums[I := Fin.Fin r] \as CoordinateSums;
\import CoordinateSums.Prop[] \as CoordinateLaws;
\import Spaces.Sums[I := Fin.Fin k] \as SlotSums;
\import SlotSums.Prop[] \as SlotLaws;
\import Spaces.Sums[I := Fin.Fin (N.Nat^::succ k)] \as NextSlots;
\import SlotLaws.Mapping[J := Fin.Fin (N.Nat^::succ k)] \as SlotMapping;
\import CoordinateLaws.Exchange[J := Fin.Fin k] \as Exchange;
\import Spaces.Laws[V := C.Complex, space := Spaces.scalarSpace] \as Scalars;
\definition coefficientTerm[j: Fin.Fin r]: C.Complex := Spaces.mul (head arguments j x) (D.apply i (contracted j) x (Contract.tail arguments x));
\definition headTerm[j: Fin.Fin r]: C.Complex := Spaces.mul (Partials.derivative U (head arguments j) i x) (coefficient arguments j x);
\definition tailTerm[j: Fin.Fin r][slot: Fin.Fin k]: C.Complex := Spaces.mul (head arguments j x)
  (contracted j x (Multilinear.update k (Contract.tail arguments x) slot (TailD.apply i (Contract.tail arguments) x slot)));
\definition coefficientSum: C.Complex := CoordinateSums.sum (Fin.elements r) coefficientTerm;
\definition headSum: C.Complex := CoordinateSums.sum (Fin.elements r) headTerm;
\definition tailSum: C.Complex := SlotSums.sum (Fin.elements k) (\fun (slot: Fin.Fin k) => CoordinateSums.sum (Fin.elements r) (\fun (j: Fin.Fin r) => tailTerm j slot));
\definition coefficientIdentity: NextD.apply i omega x (arguments x) = coefficientSum :=
  eq_reason_in!{{C.Complex} _
    "=" _ "by" { congr!{{Multilinear.Arguments (N.Nat^::succ k)} {C.Complex}} (NextD.apply i omega x)
      (arguments x) (Arguments.extend k (arguments x (Fin.zero k)) (Contract.tail arguments x))
      (sym!{{Multilinear.Arguments (N.Nat^::succ k)}} (Arguments.extend k (arguments x (Fin.zero k)) (Contract.tail arguments x)) (arguments x) (Arguments.recover k (arguments x))) }
    "=" _ "by" { Expansion.law (NextD.apply i omega x) (arguments x (Fin.zero k)) (Contract.tail arguments x) }
    "=" _ "by" { CoordinateLaws.congruent (Fin.elements r)
        (\fun (j: Fin.Fin r) => Spaces.mul (head arguments j x) (Contract.apply (NextD.apply i omega) (Basis.vectors j) x (Contract.tail arguments x))) coefficientTerm
        (\fun (j: Fin.Fin r) => congr!{{C.Complex} {C.Complex}} (Spaces.mul (head arguments j x))
          (Contract.apply (NextD.apply i omega) (Basis.vectors j) x (Contract.tail arguments x)) (D.apply i (contracted j) x (Contract.tail arguments x))
          (congr!{{RegularFamily k} {C.Complex}} (\fun (family: RegularFamily k) => family x (Contract.tail arguments x))
            (Contract.apply (NextD.apply i omega) (Basis.vectors j)) (D.apply i (contracted j))
            (sym!{{RegularFamily k}} (D.apply i (contracted j)) (Contract.apply (NextD.apply i omega) (Basis.vectors j)) (Contract.derivative i omega (Basis.vectors j))))) }
  };
\definition headUpdate: Multilinear.update (N.Nat^::succ k) (arguments x) (Fin.zero k) (ArgumentD.apply i arguments x (Fin.zero k)) =
  Arguments.extend k (ArgumentD.apply i arguments x (Fin.zero k)) (Contract.tail arguments x) :=
  trans!{{Multilinear.Arguments (N.Nat^::succ k)}}
    _ _ _
    (congr!{{Multilinear.Arguments (N.Nat^::succ k)} {Multilinear.Arguments (N.Nat^::succ k)}}
      (\fun (values: Multilinear.Arguments (N.Nat^::succ k)) => Multilinear.update (N.Nat^::succ k) values (Fin.zero k) (ArgumentD.apply i arguments x (Fin.zero k)))
      (arguments x) (Arguments.extend k (arguments x (Fin.zero k)) (Contract.tail arguments x))
      (sym!{{Multilinear.Arguments (N.Nat^::succ k)}} (Arguments.extend k (arguments x (Fin.zero k)) (Contract.tail arguments x)) (arguments x) (Arguments.recover k (arguments x))))
    (Updates.extendHead k (arguments x (Fin.zero k)) (Contract.tail arguments x) (ArgumentD.apply i arguments x (Fin.zero k)));
\definition headIdentity: slotTerm (N.Nat^::succ k) omega arguments i x (Fin.zero k) = headSum :=
  trans!{{C.Complex}} _ _ _
    (congr!{{Multilinear.Arguments (N.Nat^::succ k)} {C.Complex}} (omega x)
      _ _ headUpdate)
    (Expansion.law (omega x) (ArgumentD.apply i arguments x (Fin.zero k)) (Contract.tail arguments x));
\definition tailIdentity: \forall (slot: Fin.Fin k) -> slotTerm (N.Nat^::succ k) omega arguments i x (Fin.succ k slot) =
  CoordinateSums.sum (Fin.elements r) (\fun (j: Fin.Fin r) => tailTerm j slot) :=
  \fun (slot: Fin.Fin k) => trans!{{C.Complex}} _ _ _
    (congr!{{Multilinear.Arguments (N.Nat^::succ k)} {C.Complex}} (omega x)
      _ _
      (trans!{{Multilinear.Arguments (N.Nat^::succ k)}}
        _ _ _
        (congr!{{Vectors.Vector} {Multilinear.Arguments (N.Nat^::succ k)}}
          (\fun (v: Vectors.Vector) => Multilinear.update (N.Nat^::succ k) (arguments x) (Fin.succ k slot) v)
          (ArgumentD.apply i arguments x (Fin.succ k slot)) (TailD.apply i (Contract.tail arguments) x slot)
          (sym!{{Vectors.Vector}} (TailD.apply i (Contract.tail arguments) x slot) (ArgumentD.apply i arguments x (Fin.succ k slot)) (tailDerivative i arguments x slot)))
        (sym!{{Multilinear.Arguments (N.Nat^::succ k)}}
          _ _
          (tailUpdate arguments x slot (TailD.apply i (Contract.tail arguments) x slot)))))
    (Expansion.law (omega x) (arguments x (Fin.zero k)) (Multilinear.update k (Contract.tail arguments x) slot (TailD.apply i (Contract.tail arguments) x slot)));
\definition slotsIdentity: NextSlots.sum (Fin.elements (N.Nat^::succ k)) (slotTerm (N.Nat^::succ k) omega arguments i x) = Spaces.add headSum tailSum :=
  congr!{{C.Complex} {C.Complex} {C.Complex}} Spaces.add
    _ _ _ _
    headIdentity
    (trans!{{C.Complex}}
      _ _ _
      (SlotMapping.sumMap (Fin.elements k) (Fin.succ k) (slotTerm (N.Nat^::succ k) omega arguments i x))
      (SlotLaws.congruent (Fin.elements k) (\fun (slot: Fin.Fin k) => slotTerm (N.Nat^::succ k) omega arguments i x (Fin.succ k slot))
        (\fun (slot: Fin.Fin k) => CoordinateSums.sum (Fin.elements r) (\fun (j: Fin.Fin r) => tailTerm j slot)) tailIdentity));
\definition termDerivative: DifferentiationLaw k -> \forall (j: Fin.Fin r) -> derivativeTerm i arguments j x =
  Spaces.add (headTerm j) (Spaces.add (coefficientTerm j) (SlotSums.sum (Fin.elements k) (tailTerm j))) :=
  \fun (previous: DifferentiationLaw k)(j: Fin.Fin r) => congr!{{C.Complex} {C.Complex}} (Spaces.add (headTerm j))
    _ _
    (eq_reason_in!{{C.Complex} _
      "=" _ "by" { congr!{{C.Complex} {C.Complex}} (Spaces.mul (head arguments j x))
        (Partials.derivative U (coefficient arguments j) i x) (derivativeValue k (contracted j) (Contract.tail arguments) i x)
        (previous (contracted j) (Contract.tail arguments) i x) }
      "=" _ "by" { Spaces.mulAdd (head arguments j x) (D.apply i (contracted j) x (Contract.tail arguments x)) (SlotSums.sum (Fin.elements k) (slotTerm k (contracted j) (Contract.tail arguments) i x)) }
      "=" _ "by" { congr!{{C.Complex} {C.Complex}} (Spaces.add (coefficientTerm j))
          _ _
          (sym!{{C.Complex}} _ _
            (SlotLaws.multiplyLeft (Fin.elements k) (head arguments j x) (slotTerm k (contracted j) (Contract.tail arguments) i x))) }
    });
\definition sumDerivative: DifferentiationLaw k -> CoordinateSums.sum (Fin.elements r) (\fun (j: Fin.Fin r) => derivativeTerm i arguments j x) =
  Spaces.add headSum (Spaces.add coefficientSum tailSum) := \block {
  \fun (previous: DifferentiationLaw k) \then
  \let nested: Fin.Fin r -> C.Complex := \fun (j: Fin.Fin r) => SlotSums.sum (Fin.elements k) (tailTerm j) \then
  \return eq_reason!{
    {CoordinateSums.sum (Fin.elements r) (\fun (j: Fin.Fin r) => derivativeTerm i arguments j x)}
    "=" {CoordinateSums.sum (Fin.elements r) (\fun (j: Fin.Fin r) => Spaces.add (headTerm j) (Spaces.add (coefficientTerm j) (nested j)))} "by" {
      CoordinateLaws.congruent (Fin.elements r) (\fun (j: Fin.Fin r) => derivativeTerm i arguments j x)
        (\fun (j: Fin.Fin r) => Spaces.add (headTerm j) (Spaces.add (coefficientTerm j) (nested j))) (termDerivative previous)}
    "=" {Spaces.add headSum (CoordinateSums.sum (Fin.elements r) (\fun (j: Fin.Fin r) => Spaces.add (coefficientTerm j) (nested j)))} "by" {
      CoordinateLaws.additive (Fin.elements r) headTerm (\fun (j: Fin.Fin r) => Spaces.add (coefficientTerm j) (nested j))}
    "=" {Spaces.add headSum (Spaces.add coefficientSum (CoordinateSums.sum (Fin.elements r) nested))} "by" {
      congr!{{C.Complex} {C.Complex}} (Spaces.add headSum) _ _ (CoordinateLaws.additive (Fin.elements r) coefficientTerm nested)}
    "=" {Spaces.add headSum (Spaces.add coefficientSum tailSum)} "by" {
      congr!{{C.Complex} {C.Complex}} (\fun (v: C.Complex) => Spaces.add headSum (Spaces.add coefficientSum v)) _ _
        (Exchange.exchange (Fin.elements r) (Fin.elements k) tailTerm)}
  }
};
\definition law: DifferentiationLaw k -> Partials.derivative U (variableEvaluation (N.Nat^::succ k) omega arguments) i x =
  derivativeValue (N.Nat^::succ k) omega arguments i x := \block {
  \fun (previous: DifferentiationLaw k) \then
  \return eq_reason!{
    {Partials.derivative U (variableEvaluation (N.Nat^::succ k) omega arguments) i x}
    "=" {CoordinateSums.sum (Fin.elements r) (\fun (j: Fin.Fin r) => derivativeTerm i arguments j x)} "by" {
      congr!{{Functions.Function} {C.Complex}} (\fun (f: Functions.Function) => f x)
        (Partials.derivative U (variableEvaluation (N.Nat^::succ k) omega arguments) i) (Sums.function (Fin.elements r) (derivativeTerm i arguments)) (derivative i arguments)}
    "=" {Spaces.add headSum (Spaces.add coefficientSum tailSum)} "by" {sumDerivative previous}
    "=" {Spaces.add (Spaces.add headSum coefficientSum) tailSum} "by" {sym!{{C.Complex}} _ _ (Scalars.assoc headSum coefficientSum tailSum)}
    "=" {Spaces.add (Spaces.add coefficientSum headSum) tailSum} "by" {congr!{{C.Complex} {C.Complex}} (\fun (v: C.Complex) => Spaces.add v tailSum) _ _ (Scalars.comm headSum coefficientSum)}
    "=" {Spaces.add coefficientSum (Spaces.add headSum tailSum)} "by" {Scalars.assoc coefficientSum headSum tailSum}
    "=" {derivativeValue (N.Nat^::succ k) omega arguments i x} "by" {
      sym!{{C.Complex}} (derivativeValue (N.Nat^::succ k) omega arguments i x) (Spaces.add coefficientSum (Spaces.add headSum tailSum))
        (congr!{{C.Complex} {C.Complex} {C.Complex}} Spaces.add
          _ _ _ _
          coefficientIdentity slotsIdentity)}
  }
};
