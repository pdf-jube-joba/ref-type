\import \root.ComplexMetric[n := n, r := r].On[U := U] \as Native;
\import \root.ComplexMatrices[n := n, r := r].On[U := U] \as Matrices;
\definition Predicate: \Pow Calculus.Function := { f: Calculus.Function \where Calculus.Smooth f };
\definition Function: \Set := Native.Function;
\definition regular: \forall (f: Function) -> Calculus.Smooth f := Native.regular;
\definition constant[c: C.Complex]: Function := \into[Calculus.Function]((\fun (x: Open.Carrier U) => c), Function) \by { Calculus.constant c };
\definition origin: Function := constant Op.zero;
\definition plus[f, g: Function]: Function := \into[Calculus.Function]((\fun (x: Open.Carrier U) => Op.add (f x) (g x)), Function) \by { Calculus.plus f g (regular f) (regular g) };
\definition product[f, g: Function]: Function := Matrices.functionProduct f g;
\definition scale[c: C.Complex][f: Function]: Function := product (constant c) f;
\definition ext: \forall (f, g: Function) -> (\forall (x: Open.Carrier U) -> f x = g x) -> f = g :=
  \fun (f, g: Function)(same: _) => \axiom:funext(f, g, same);
\definition derivative: Fin.Fin n -> Function -> Function := Native.derivative;
\module Linear;
