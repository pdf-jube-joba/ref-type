\definition derivative[ignored: Open.OpenSet][f: Functions.Function][i: Fin.Fin n]: Functions.Function := Functions.derivative i f;
\definition partial[ignored: Open.OpenSet][f: Functions.Function][i: Fin.Fin n]: Calculus.Function := derivative ignored f i;
\definition partialSmooth: \forall (ignored: Open.OpenSet)(f: Functions.Function)(i: Fin.Fin n) -> Calculus.Smooth (partial ignored f i) :=
  \fun (ignored: Open.OpenSet)(f: Functions.Function)(i: Fin.Fin n) => Functions.regular (derivative ignored f i);
