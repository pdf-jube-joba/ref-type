
\import Functions.Linear[] \as Linear;
\definition function[i: Fin.Fin n][omega: RegularFamily k][x: Open.Carrier U]: Multilinear.Function k :=
  \fun (arguments: Multilinear.Arguments k) => Partials.derivative U (evaluate k omega arguments) i x;
\definition evaluationAddition: \forall (omega: RegularFamily k)(arguments: Multilinear.Arguments k)(j: Fin.Fin k)(v, w: Vectors.Vector) ->
  evaluate k omega (Multilinear.update k arguments j (Vectors.plus v w)) =
    Functions.plus (evaluate k omega (Multilinear.update k arguments j v)) (evaluate k omega (Multilinear.update k arguments j w)) :=
  \fun (omega: RegularFamily k)(arguments: Multilinear.Arguments k)(j: Fin.Fin k)(v, w: Vectors.Vector) => Functions.ext
    (evaluate k omega (Multilinear.update k arguments j (Vectors.plus v w)))
    (Functions.plus (evaluate k omega (Multilinear.update k arguments j v)) (evaluate k omega (Multilinear.update k arguments j w)))
    (\fun (x: Open.Carrier U) => (\bysub(Multilinear.Function k, Multilinear.MultilinearForm k, omega x)).addition arguments j v w);
\definition evaluationScalar: \forall (omega: RegularFamily k)(arguments: Multilinear.Arguments k)(j: Fin.Fin k)(a: C.Complex)(v: Vectors.Vector) ->
  evaluate k omega (Multilinear.update k arguments j (Vectors.scale a v)) = Functions.scale a (evaluate k omega (Multilinear.update k arguments j v)) :=
  \fun (omega: RegularFamily k)(arguments: Multilinear.Arguments k)(j: Fin.Fin k)(a: C.Complex)(v: Vectors.Vector) => Functions.ext
    (evaluate k omega (Multilinear.update k arguments j (Vectors.scale a v))) (Functions.scale a (evaluate k omega (Multilinear.update k arguments j v)))
    (\fun (x: Open.Carrier U) => (\bysub(Multilinear.Function k, Multilinear.MultilinearForm k, omega x)).scalar arguments j a v);
\definition linear: \forall (i: Fin.Fin n)(omega: RegularFamily k)(x: Open.Carrier U) -> Multilinear.Laws[k, function i omega x] :=
  \fun (i: Fin.Fin n)(omega: RegularFamily k)(x: Open.Carrier U) => Multilinear.Laws[k, function i omega x] {
    addition := \fun (arguments: Multilinear.Arguments k)(j: Fin.Fin k)(v, w: Vectors.Vector) =>
      trans!{{C.Complex}} _ _ _
        (congr!{{Functions.Function} {C.Complex}} (\fun (h: Functions.Function) => Partials.derivative U h i x)
          _ _ (evaluationAddition omega arguments j v w))
        (congr!{{Functions.Function} {C.Complex}} (\fun (h: Functions.Function) => h x)
          _ _
          (Linear.addition i (evaluate k omega (Multilinear.update k arguments j v)) (evaluate k omega (Multilinear.update k arguments j w)))),
    scalar := \fun (arguments: Multilinear.Arguments k)(j: Fin.Fin k)(a: C.Complex)(v: Vectors.Vector) =>
      trans!{{C.Complex}} _ _ _
        (congr!{{Functions.Function} {C.Complex}} (\fun (h: Functions.Function) => Partials.derivative U h i x)
          _ _ (evaluationScalar omega arguments j a v))
        (congr!{{Functions.Function} {C.Complex}} (\fun (h: Functions.Function) => h x)
          _ _
          (Linear.scalar i a (evaluate k omega (Multilinear.update k arguments j v)))),
  };
\definition value[i: Fin.Fin n][omega: RegularFamily k][x: Open.Carrier U]: Multilinear.MultilinearForm k :=
  \into[Multilinear.Function k](function i omega x, Multilinear.MultilinearForm k) \by { linear i omega x };
\definition apply[i: Fin.Fin n][omega: RegularFamily k]: RegularFamily k :=
  \into[Family k](value i omega, { result: Family k \where CoefficientSmooth k result }) \by {
    \fun (indices: Fin.Fin k -> Fin.Fin r) => equalSmooth
      (Partials.partial U (evaluate k omega (\fun (j: Fin.Fin k) => Basis.vectors (indices j))) i)
      (\fun (x: Open.Carrier U) => value i omega x (\fun (j: Fin.Fin k) => Basis.vectors (indices j)))
      (\fun (x: Open.Carrier U) => \refl(value i omega x (\fun (j: Fin.Fin k) => Basis.vectors (indices j))))
      (Partials.partialSmooth U (evaluate k omega (\fun (j: Fin.Fin k) => Basis.vectors (indices j))) i)
  };
\definition evaluation: \forall (i: Fin.Fin n)(omega: RegularFamily k)(arguments: Multilinear.Arguments k) ->
  evaluate k (apply i omega) arguments = Partials.derivative U (evaluate k omega arguments) i :=
  \fun (i: Fin.Fin n)(omega: RegularFamily k)(arguments: Multilinear.Arguments k) => Functions.ext
    (evaluate k (apply i omega) arguments) (Partials.derivative U (evaluate k omega arguments) i)
    (\fun (x: Open.Carrier U) => \refl(function i omega x arguments));
