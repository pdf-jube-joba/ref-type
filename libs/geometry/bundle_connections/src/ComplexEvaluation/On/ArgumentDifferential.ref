
\definition coordinate[arguments: RegularArguments k][slot: Fin.Fin k][j: Fin.Fin r]: Functions.Function :=
  \into[Calculus.Function]((\fun (x: Open.Carrier U) => arguments x slot j), { h: Calculus.Function \where Calculus.Smooth h }) \by {
    (\bysub(VariableArguments k, { arguments: VariableArguments k \where ArgumentSmooth k arguments }, arguments)) slot j
  };
\definition apply[i: Fin.Fin n][arguments: RegularArguments k]: RegularArguments k :=
  \into[VariableArguments k]((\fun (x: Open.Carrier U)(slot: Fin.Fin k)(j: Fin.Fin r) => Partials.derivative U (coordinate arguments slot j) i x),
    { result: VariableArguments k \where ArgumentSmooth k result }) \by {
      \fun (slot: Fin.Fin k)(j: Fin.Fin r) => equalSmooth (Partials.partial U (coordinate arguments slot j) i)
        (\fun (x: Open.Carrier U) => Partials.derivative U (coordinate arguments slot j) i x)
        (\fun (x: Open.Carrier U) => \refl(Partials.derivative U (coordinate arguments slot j) i x))
        (Partials.partialSmooth U (coordinate arguments slot j) i)
    };
