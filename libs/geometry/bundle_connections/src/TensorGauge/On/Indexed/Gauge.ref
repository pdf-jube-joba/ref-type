\module At(x: Open.Carrier U, v: Multilinear.Arguments one);
\definition law: Target.product01 (tensor0 T S) (lift A B) = Target.plus (Target.dMatrix (tensor0 T S)) (Target.product10 (lift C D) (tensor0 T S)) :=
  Algebra.ext (Target.product01 (tensor0 T S) (lift A B)) (Target.plus (Target.dMatrix (tensor0 T S)) (Target.product10 (lift C D) (tensor0 T S)))
    (\fun (x: Open.Carrier U)(v: Multilinear.Arguments one) => At[x := x, v := v].law);
