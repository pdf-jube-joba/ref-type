\import Bundles.Of[I := I, bundle := bundle] \as Original;
\import \root.PullbackGlobal[n := n, m := m, r := realRank].Between[X := X, Y := Y].Family[F := F, space := Bundles.realSpace].Of[I := I, bundle := Original.forget, f := f] \as Underlying;
\definition Index: \Set := Underlying.Index;
\definition Fiber[x: X.Point]: \Set := F (Maps.apply f x);
\definition fiberSpace[x: X.Point]: Spaces.VectorSpace (Fiber x) := space (Maps.apply f x);
\import smooth_bundles.Complex[n := n, r := r].On[M := X].Family[F := Fiber, space := fiberSpace] \as Result;
\definition local[i: Index]: Result.Local := Result.Local {
  chart := i.chart,
  frame := \fun (x: manifolds.Dimension[n := n].Chart[M := X.Point, space := X.space].LocalPoint i.chart) =>
    (bundle.atlas.local i.target).frame (Underlying.targetPoint i x),
};
\definition atlas: Result.Data[Index] := Result.Data[Index] { local := local, covers := Underlying.covers };
\definition pullback: Result.Bundle[Index] := Result.Bundle[Index] { atlas := atlas, regular := Underlying.pullback.regular };
\import \root.Complex[n := m, r := r].On[M := Y].Family[F := F, space := space].Of[I := I, bundle := bundle] \as OriginalConnection;
\module Connection(A: OriginalConnection.Connection);
