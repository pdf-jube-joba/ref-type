\import \root.MatrixCalculus[n := n, r := realRank].On[U := i.chart.image] \as Source;
\import \root.MatrixCalculus[n := m, r := realRank].On[U := (bundle.atlas.local i.target).chart.image] \as TargetMatrices;
\import \root.Complex[n := n, r := r].Structure[].On[U := i.chart.image] \as SourceJ;
\import \root.Complex[n := m, r := r].Structure[].On[U := (bundle.atlas.local i.target).chart.image] \as TargetJ;
\import \root.PullbackGlobal[n := n, m := m, r := realRank].Transport[U := i.chart.image, V := (bundle.atlas.local i.target).chart.image, f := Underlying.In[i := i].map] \as Pull;
\definition complexLinear: Source.product01 SourceJ.matrix (Real.value i).matrix = Source.product10 (Real.value i).matrix SourceJ.matrix := eq_reason_in!{{Source.Matrix1} _
  "=" _ "by" { sym!{{Source.Matrix1}} _ _ (Pull.product01 TargetJ.matrix (A i.target).matrix) }
  "=" _ "by" { congr!{{TargetMatrices.Matrix1} {Source.Matrix1}} Pull.matrix1 _ _ (OriginalConnection.complexLinear A i.target) }
  "=" _ "by" { Pull.product10 (A i.target).matrix TargetJ.matrix }
};
