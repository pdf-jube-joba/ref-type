\import \root.ComplexTensorIndex[r := r, s := s].Using[enumeration := enumeration] \as Index;
\import \root.ComplexMatrices[n := n, r := Index.rank].On[U := U] \as Target;
\import Target.Algebra[] \as Algebra;
\import Left.Algebra[] \as LeftAlgebra;
\import Right.Algebra[] \as RightAlgebra;
\import \root.ComplexTensorGauge[r := r, s := s].Numeric[] \as Numeric;
\import real.Analysis[] \as R;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real R.Algebra[].field] \as Reals;
\import Reals.Coordinates[I := Fin.Fin n] \as Vectors;
\import Reals.Multilinear[V := Vectors.Vector, space := Vectors.space] \as Multilinear;
\definition embed[A: Numeric.Matrix][a, b: Fin.Fin Index.rank]: Z.Complex := A (Index.row a) (Index.col a) (Index.row b) (Index.col b);
\definition product: \forall (A, B: Numeric.Matrix) -> Algebra.product (embed A) (embed B) = embed (Numeric.product A B) :=
  \fun (A, B: Numeric.Matrix) => Algebra.numericExt (Algebra.product (embed A) (embed B)) (embed (Numeric.product A B))
    (\fun (a, b: Fin.Fin Index.rank) => Index.sum (\fun (i: Fin.Fin r)(j: Fin.Fin s) => Op.mul (A (Index.row a) (Index.col a) i j) (B i j (Index.row b) (Index.col b))));
\definition tensor0[A: Left.Matrix0][B: Right.Matrix0][a, b: Fin.Fin Index.rank]: Functions.Function :=
  Left.functionProduct (A (Index.row a) (Index.row b)) (B (Index.col a) (Index.col b));
\definition fromLeft[A: Left.OneForm]: Target.OneForm := Target.OneForm { real := A.real, imaginary := A.imaginary };
\definition fromRight[A: Right.OneForm]: Target.OneForm := Target.OneForm { real := A.real, imaginary := A.imaginary };
\definition tensor01[A: Left.Matrix0][B: Right.Matrix1][a, b: Fin.Fin Index.rank]: Target.OneForm :=
  Target.multiply (A (Index.row a) (Index.row b)) (fromRight (B (Index.col a) (Index.col b)));
\definition tensor10[A: Left.Matrix1][B: Right.Matrix0][a, b: Fin.Fin Index.rank]: Target.OneForm :=
  Target.multiply (B (Index.col a) (Index.col b)) (fromLeft (A (Index.row a) (Index.row b)));
\definition leftIdentity: Left.Matrix0 := \fun (a, b: Fin.Fin r) => LeftAlgebra.constant (L.identity a b);
\definition rightIdentity: Right.Matrix0 := \fun (a, b: Fin.Fin s) => RightAlgebra.constant (Rg.identity a b);
\definition lift[A: Left.Matrix1][B: Right.Matrix1]: Target.Matrix1 := Target.plus (tensor10 A rightIdentity) (tensor01 leftIdentity B);
\definition differential: \forall (A: Left.Matrix0)(B: Right.Matrix0) -> Target.dMatrix (tensor0 A B) = Target.plus (tensor10 (Left.dMatrix A) B) (tensor01 A (Right.dMatrix B)) :=
  \fun (A: Left.Matrix0)(B: Right.Matrix0) => \axiom:funext(Target.dMatrix (tensor0 A B), Target.plus (tensor10 (Left.dMatrix A) B) (tensor01 A (Right.dMatrix B)),
    \fun (a: Fin.Fin Index.rank) => \axiom:funext(Target.dMatrix (tensor0 A B) a, Target.plus (tensor10 (Left.dMatrix A) B) (tensor01 A (Right.dMatrix B)) a,
      \fun (b: Fin.Fin Index.rank) => Algebra.dProduct (A (Index.row a) (Index.row b)) (B (Index.col a) (Index.col b))));
\module At(x: Open.Carrier U, v: Multilinear.Arguments one);
\module Gauge(T: Left.Matrix0, A, C: Left.Matrix1, S: Right.Matrix0, B, D: Right.Matrix1,
  first: Left.product01 T A = Left.plus (Left.dMatrix T) (Left.product10 C T),
  second: Right.product01 S B = Right.plus (Right.dMatrix S) (Right.product10 D S));
