\import \root.MatrixCalculus[n := n, r := rank].On[U := (Underlying.chart i).image] \as Matrices;
\import Matrices.Linearity[] \as Linear;
\import Structure.On[U := (Underlying.chart i).image] \as J;
\import \root.GlobalForms[n := n, r := rank].On[U := (Underlying.chart i).image].Gauge[k := k] \as Gauge;
\import \root.GlobalForms[n := n, r := rank].On[U := (Underlying.chart i).image].Action[k := k] \as Action;
\import \root.GlobalForms[n := n, r := rank].On[U := (Underlying.chart i).image].Action[k := next] \as NextAction;
\definition gauge: Matrices.product01 J.matrix ((Connections.forget A i).matrix) = Matrices.plus (Matrices.dMatrix J.matrix) (Matrices.product10 ((Connections.forget A i).matrix) J.matrix) :=
  trans!{{Matrices.Matrix1}} _ _ _ (Connections.complexLinear A i)
    (sym!{{Matrices.Matrix1}} _ _ (trans!{{Matrices.Matrix1}} _ _ _
      (congr!{{Matrices.Matrix1} {Matrices.Matrix1}} (\fun (B: Matrices.Matrix1) => Matrices.plus B (Matrices.product10 ((Connections.forget A i).matrix) J.matrix)) _ _ J.constant)
      (Spaces.Laws[V := Matrices.Matrix1, space := Linear.space].zeroLeft (Matrices.product10 ((Connections.forget A i).matrix) J.matrix))));
\definition law: Gauge.covariant ((Connections.forget A i).matrix) (Action.apply J.matrix (omega i)) = NextAction.apply J.matrix (Gauge.covariant ((Connections.forget A i).matrix) (omega i)) :=
  Gauge.law J.matrix ((Connections.forget A i).matrix) ((Connections.forget A i).matrix) gauge (omega i);
