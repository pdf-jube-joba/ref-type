\import euclidean_forms.Euclidean[n := n].Pullback[m := m, U := U, V := V, f := f] \as Pull;
\definition apply[k: N.Nat^][omega: Target.Form k]: Source.Form k := \fun (a: Fin.Fin r) => Pull.apply k (omega a);
\definition connection[A: Target.Connection]: Source.Connection := Source.Connection {
  matrix := \fun (a, b: Fin.Fin r) => Pull.apply one (A.matrix a b),
};
\module At(k: N.Nat^, A: Target.Connection);
\module Constant(k: N.Nat^, T: Fin.Fin r -> Fin.Fin r -> R.Real);
