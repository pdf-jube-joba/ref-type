\definition next: N.Nat^ := N.Nat^::succ k;
\import Source.Covariant[k := k, connection := connection A] \as SourceD;
\import Target.Covariant[k := k, connection := A] \as TargetD;
\import SourceScalar.At[k := next] \as SourceSpace;
\import TargetScalar.At[k := next] \as TargetSpace;
\import SourceScalar.Regrade[k := Nat.add one k, l := next] \as Degree;
\import Spaces.Sums[I := Fin.Fin r].Vector[V := SourceScalar.Form next, space := SourceSpace.space] \as SourceSums;
\import Spaces.Sums[I := Fin.Fin r].Vector[V := TargetScalar.Form next, space := TargetSpace.space].Mapping[W := SourceScalar.Form next, target := SourceSpace.space] \as Mapping;
\definition term: \forall (a, b: Fin.Fin r)(omega: Target.Form k) ->
  SourceD.term a b (apply k omega) = Pull.apply next (TargetD.term a b omega) :=
  \fun (a, b: Fin.Fin r)(omega: Target.Form k) => eq_reason_in!{{SourceScalar.Form next} _
    "=" _ "by" { congr!{{SourceScalar.Form (Nat.add one k)} {SourceScalar.Form next}}
      (\fun (value: SourceScalar.Form (Nat.add one k)) => Degree.cast value SourceScalar.ExteriorDerivative[k := k].degree) _ _
      (sym!{{SourceScalar.Form (Nat.add one k)}} _ _ (Pull.Product[p := one, q := k].law (A.matrix a b) (omega b))) }
    "=" _ "by" { Pull.Regrade[k := Nat.add one k, l := next].law
      (TargetScalar.Wedge[p := one, q := k].apply (A.matrix a b) (omega b)) TargetScalar.ExteriorDerivative[k := k].degree }
  };
\definition correction: \forall (omega: Target.Form k)(a: Fin.Fin r) ->
  SourceD.correction (apply k omega) a = Pull.apply next (TargetD.correction omega a) :=
  \fun (omega: Target.Form k)(a: Fin.Fin r) => trans!{{SourceScalar.Form next}} _ _ _
    (SourceSums.congruent (Fin.elements r) (\fun (b: Fin.Fin r) => SourceD.term a b (apply k omega))
      (\fun (b: Fin.Fin r) => Pull.apply next (TargetD.term a b omega)) (\fun (b: Fin.Fin r) => term a b omega))
    (sym!{{SourceScalar.Form next}} _ _ (Mapping.law Pull.At[k := next].map (Fin.elements r) (\fun (b: Fin.Fin r) => TargetD.term a b omega)));
\definition law: \forall (omega: Target.Form k) -> SourceD.apply (apply k omega) = apply next (TargetD.apply omega) :=
  \fun (omega: Target.Form k) => \axiom:funext(SourceD.apply (apply k omega), apply next (TargetD.apply omega),
    \fun (a: Fin.Fin r) => trans!{{SourceScalar.Form next}} _ _ _
      (congr!{{SourceScalar.Form next} {SourceScalar.Form next} {SourceScalar.Form next}} SourceSpace.plus _ _ _ _
        (Pull.Naturality[k := k].law (omega a)) (correction omega a))
      (sym!{{SourceScalar.Form next}} _ _ (Pull.At[k := next].addition (TargetScalar.ExteriorDerivative[k := k].apply (omega a)) (TargetD.correction omega a))));
