\import SourceScalar.At[k := k] \as SourceSpace;
\import TargetScalar.At[k := k] \as TargetSpace;
\import \root.GlobalForms[n := n, r := r].On[U := U].Action[k := k] \as SourceAction;
\import \root.GlobalForms[n := m, r := r].On[U := V].Action[k := k] \as TargetAction;
\import \root.MatrixCalculus[n := n, r := r].On[U := U] \as SourceMatrices;
\import \root.MatrixCalculus[n := m, r := r].On[U := V] \as TargetMatrices;
\import Spaces.Multilinear[V := Fin.Fin n -> R.Real, space := Spaces.Coordinates[I := Fin.Fin n].space] \as Multilinear;
\import Spaces.Sums[I := Fin.Fin r].Vector[V := SourceScalar.Form k, space := SourceSpace.space] \as Sums;
\import Spaces.Sums[I := Fin.Fin r].Vector[V := TargetScalar.Form k, space := TargetSpace.space].Mapping[W := SourceScalar.Form k, target := SourceSpace.space] \as Mapping;
\definition matrix[T: TargetMatrices.Matrix0][a, b: Fin.Fin r]: Open.Smooth[].Algebra[U := U].Function := Pull.DegreeZero[].compose (T a b);
\definition law: \forall (T: TargetMatrices.Matrix0)(omega: Target.Form k) -> apply k (TargetAction.apply T omega) = SourceAction.apply (matrix T) (apply k omega) :=
  \fun (T: TargetMatrices.Matrix0)(omega: Target.Form k) => \axiom:funext(apply k (TargetAction.apply T omega), SourceAction.apply (matrix T) (apply k omega),
    \fun (a: Fin.Fin r) => trans!{{SourceScalar.Form k}} _ _ _
      (Mapping.law Pull.At[k := k].map (Fin.elements r) (\fun (b: Fin.Fin r) => TargetSpace.multiply (T a b) (omega b)))
      (Sums.congruent (Fin.elements r) _ _ (\fun (b: Fin.Fin r) => SourceScalar.ext k _ _
        (\fun (x: Open.Carrier U)(v: Multilinear.Arguments k) => \refl(R.mul (matrix T a b x) (Pull.apply k (omega b) x v))))));
