\import complex.Complex[] \as C;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing C.Complex C.Algebra[].field] \as ComplexSpaces;
\import smooth_bundles.ComplexCoordinates[n := n, r := r] \as Coordinates;
\definition rank: N.Nat^ := Coordinates.rank;
\import \root.Complex[n := n, r := r].Structure[] \as Structure;
\definition coefficients[a, b: Fin.Fin rank]: R.Real := Structure.J.apply (R.FiniteSums[].Linear[].basis rank b) a;
\module On(M: Model.Manifold);
