\definition law: \forall (omega: Scalar.Form k)(same: k = l) ->
  Scalar.ExteriorDerivative[k := l].apply (Scalar.Regrade[k := k, l := l].cast omega same) =
  Scalar.Regrade[k := N.Nat^::succ k, l := N.Nat^::succ l].cast (Scalar.ExteriorDerivative[k := k].apply omega)
    (congr!{{N.Nat^} {N.Nat^}} N.Nat^::succ k l same) :=
  \fun (omega: Scalar.Form k)(same: k = l) =>
    (\idelim k = l \with j: _ => \forall (kj: k = j) ->
      Scalar.ExteriorDerivative[k := j].apply (Scalar.Regrade[k := k, l := j].cast omega kj) =
      Scalar.Regrade[k := N.Nat^::succ k, l := N.Nat^::succ j].cast (Scalar.ExteriorDerivative[k := k].apply omega)
        (congr!{{N.Nat^} {N.Nat^}} N.Nat^::succ k j kj)
    \by { base: \fun (kk: k = k) => trans!{{Scalar.Form (N.Nat^::succ k)}} _ _ _
      (congr!{{Scalar.Form k} {Scalar.Form (N.Nat^::succ k)}} Scalar.ExteriorDerivative[k := k].apply _ _ (Scalar.RegradeIdentity[k := k].law omega kk))
      (sym!{{Scalar.Form (N.Nat^::succ k)}} _ _ (Scalar.RegradeIdentity[k := N.Nat^::succ k].law (Scalar.ExteriorDerivative[k := k].apply omega) _)), equality: same }) same;
