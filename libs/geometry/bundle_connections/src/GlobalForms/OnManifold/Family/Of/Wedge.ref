\definition total: N.Nat^ := Nat.add p q;
\import Bundle.ValuedForms[k := p] \as Source;
\import Bundle.ValuedForms[k := total] \as Target;
\definition local[omega: Source.Form][eta: ScalarForms.Form q][i: I]: Target.LocalForm i :=
  \root.GlobalForms[n := n, r := r].On[U := (Bundle.chart i).image].Wedge[p := p, q := q].apply (omega i) (eta (Bundle.chart i));
\module Pair(omega: Source.Form, eta: ScalarForms.Form q, i: I, j: I);
\definition compatible: \forall (omega: Source.Form)(eta: ScalarForms.Form q) -> Target.Compatible (local omega eta) :=
  \fun (omega: Source.Form)(eta: ScalarForms.Form q)(i, j: I) => Pair[omega := omega, eta := eta, i := i, j := j].law;
\definition apply[omega: Source.Form][eta: ScalarForms.Form q]: Target.Form :=
  \into[Target.Data](local omega eta, { value: Target.Data \where Target.Compatible value }) \by { compatible omega eta };
\module Leibniz(A: Bundle.Connection, omega: Source.Form, eta: ScalarForms.Form q);
