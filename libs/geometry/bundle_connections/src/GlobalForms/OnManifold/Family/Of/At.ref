\definition next: N.Nat^ := N.Nat^::succ k;
\import Bundle.ValuedForms[k := k] \as Source;
\import Bundle.ValuedForms[k := next] \as Target;
\module Local(A: Bundle.Connection, i: I);
\definition local[A: Bundle.Connection][omega: Source.Form][i: I]: Target.LocalForm i :=
  Local[A := A, i := i].apply (omega i);
\module Pair(A: Bundle.Connection, omega: Source.Form, i: I, j: I);
\definition compatible: \forall (A: Bundle.Connection)(omega: Source.Form) -> Target.Compatible (local A omega) :=
  \fun (A: Bundle.Connection)(omega: Source.Form)(i, j: I) => Pair[A := A, omega := omega, i := i, j := j].law;
\definition apply[A: Bundle.Connection][omega: Source.Form]: Target.Form :=
  \into[Target.Data](local A omega, { value: Target.Data \where Target.Compatible value }) \by { compatible A omega };
\import bundle_operations.Operations[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Operations;
\module Native(enumeration: Operations.ExteriorIndices[n := n, k := next].Enumeration);
