\definition next: N.Nat^ := N.Nat^::succ total;
\import Bundle.ValuedForms[k := next] \as Result;
\import \parent.\parent.At[k := total] \as D;
\import \parent.\parent.At[k := p] \as LeftD;
\definition rightHandSide[i: I]: Result.LocalForm i :=
  \root.Forms[n := n, r := r].On[U := (Bundle.chart i).image].At[k := next].plus
    (\root.GlobalForms[n := n, r := r].On[U := (Bundle.chart i).image].Leibniz[p := p, q := q, connection := A i].left (LeftD.apply A omega i) (eta (Bundle.chart i)))
    (\root.Forms[n := n, r := r].On[U := (Bundle.chart i).image].At[k := next].scale (Spaces.Sign[].value p)
      (\root.GlobalForms[n := n, r := r].On[U := (Bundle.chart i).image].Leibniz[p := p, q := q, connection := A i].right (omega i) (ScalarForms.ExteriorDerivative[k := q].apply eta (Bundle.chart i))));
\definition law: D.apply A (apply omega eta) = rightHandSide :=
  \axiom:funext(D.apply A (apply omega eta), rightHandSide, \fun (i: I) =>
    \root.GlobalForms[n := n, r := r].On[U := (Bundle.chart i).image].Leibniz[p := p, q := q, connection := A i].law (omega i) (eta (Bundle.chart i)));
