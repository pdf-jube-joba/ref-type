\import \root.Forms[n := n, r := r].On[U := U] \as Source;
\import \root.Forms[n := n, r := r].On[U := V] \as Target;
\import euclidean_forms.Euclidean[n := n].On[U := U] \as SourceScalar;
\import euclidean_forms.Euclidean[n := n].On[U := V] \as TargetScalar;
\import euclidean_forms.Euclidean[n := n].Restriction[U := U, V := V] \as Pull;
\definition apply[k: N.Nat^][omega: Target.Form k]: Source.Form k := \fun (a: Fin.Fin r) => Pull.apply k included (omega a);
\definition connection[A: Target.Connection]: Source.Connection := Source.Connection { matrix := \fun (a, b: Fin.Fin r) => Pull.apply one included (A.matrix a b) };
\module At(k: N.Nat^, A: Target.Connection);
\module Constant(k: N.Nat^, T: Fin.Fin r -> Fin.Fin r -> R.Real);
