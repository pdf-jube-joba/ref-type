\import Maps.Composition[U := U, V := V, f := f].After[l := l, W := W, g := g] \as Composition;
\import \root.Forms[n := l, r := r].On[U := W] \as Final;
\import \root.Pullback[n := m, m := l, r := r].Between[U := V, V := W, f := g] \as Outer;
\import \root.Pullback[n := n, m := l, r := r].Between[U := U, V := W, f := Composition.compose] \as Composite;
\import Pull.After[l := l, W := W, g := g] \as ScalarComposition;
\definition formLaw: \forall (k: N.Nat^)(omega: Final.Form k) -> Composite.form k omega = form k (Outer.form k omega) :=
  \fun (k: N.Nat^)(omega: Final.Form k) => \axiom:funext(Composite.form k omega, form k (Outer.form k omega),
    \fun (a: Fin.Fin r) => ScalarComposition.law k (omega a));
\definition matrixLaw: \forall (A: Final.Connection)(a, b: Fin.Fin r) -> (Composite.connection A).matrix a b = (connection (Outer.connection A)).matrix a b :=
  \fun (A: Final.Connection)(a, b: Fin.Fin r) => ScalarComposition.law one (A.matrix a b);
