\import \root.Forms[n := n, r := r].On[U := U] \as Source;
\import \root.Forms[n := m, r := r].On[U := V] \as Target;
\import euclidean_forms.Euclidean[n := n].Pullback[m := m, U := U, V := V, f := f] \as Pull;
\import euclidean_forms.Euclidean[n := n].On[U := U] \as SourceScalar;
\import euclidean_forms.Euclidean[n := m].On[U := V] \as TargetScalar;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition form[k: N.Nat^][omega: Target.Form k]: Source.Form k := \fun (a: Fin.Fin r) => Pull.apply k (omega a);
\definition connection[A: Target.Connection]: Source.Connection := Source.Connection { matrix := \fun (a, b: Fin.Fin r) => Pull.apply one (A.matrix a b) };
\module Naturality(k: N.Nat^, A: Target.Connection);
\module After(l: N.Nat^, W: Reals.OpenSpace l, g: calculus.Maps[n := m, m := l].Map V W);
