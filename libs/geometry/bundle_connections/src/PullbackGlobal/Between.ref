\import manifolds.SmoothMap[n := n, m := m].Between[M := X, N := Y] \as Maps;
\import manifolds.Dimension[n := n].Chart[M := X.Point, space := X.space] \as SourceCharts;
\import manifolds.Dimension[n := m].Chart[M := Y.Point, space := Y.space] \as TargetCharts;
\definition Chart: \Set := \Cast[SourceCharts.Chart] X.atlas.charts;
\module Family(F: Y.Point -> \Set, space: \forall (y: Y.Point) -> Spaces.VectorSpace (F y));
