\import \root.GlobalForms[n := m, r := r].OnManifold[M := Y].Family[F := F, space := space].Of[I := I, bundle := bundle].At[k := k] \as OriginalD;
\import \root.GlobalForms[n := n, r := r].OnManifold[M := X].Family[F := Fiber, space := fiberSpace].Of[I := Index, bundle := pullback].At[k := k] \as ResultD;
\definition law: \forall (omega: OriginalForms.Form) ->
  \parent.\parent.Valued[k := Nat.Nat^::succ k].apply (OriginalD.apply connection omega) = ResultD.apply value (apply omega) :=
  \fun (omega: OriginalForms.Form) => \axiom:funext(\parent.\parent.Valued[k := Nat.Nat^::succ k].apply (OriginalD.apply connection omega), ResultD.apply value (apply omega),
    \fun (i: Index) => \parent.\parent.In[i := i].Naturality[k := k].law (omega i.target));
