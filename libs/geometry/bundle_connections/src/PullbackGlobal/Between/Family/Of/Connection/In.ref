\import \parent.\parent.In[i := i] \as Coordinates;
\import \root.Pullback[n := n, m := m, r := r].Between[U := i.chart.image, V := (bundle.atlas.local i.target).chart.image, f := Coordinates.map] \as Local;
\import \root.Forms[n := n, r := r].On[U := i.chart.image] \as SourceForms;
\import \root.Forms[n := m, r := r].On[U := (bundle.atlas.local i.target).chart.image] \as TargetForms;
\definition form[k: Nat.Nat^]: TargetForms.Form k -> SourceForms.Form k := Local.form k;
\module Naturality(k: Nat.Nat^) {
  \import TargetForms.Covariant[k := k, connection := connection i.target] \as Original;
  \import SourceForms.Covariant[k := k, connection := value i] \as Pulled;
  \definition law: \forall (omega: TargetForms.Form k) -> form (Nat.Nat^::succ k) (Original.apply omega) = Pulled.apply (form k omega) :=
    Local.Naturality[k := k, A := connection i.target].law;
}
