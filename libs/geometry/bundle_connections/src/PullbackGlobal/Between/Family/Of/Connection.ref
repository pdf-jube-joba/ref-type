\import \root.Real[n := n, r := r].On[M := X].Family[F := Fiber, space := fiberSpace].Of[I := Index, bundle := pullback] \as ResultConnection;
\definition data[i: Index]: ResultConnection.LocalConnection i :=
  \root.Pullback[n := n, m := m, r := r].Between[U := i.chart.image, V := (bundle.atlas.local i.target).chart.image, f := \parent.In[i := i].map].connection (connection i.target);
\module Pair(i, j: Index);
\definition value: ResultConnection.Connection := \into[ResultConnection.Data](data, { data: ResultConnection.Data \where ResultConnection.Compatible data }) \by {
  \fun (i, j: Index) => Pair[i := i, j := j].compatible
};
\module In(i: Index);
