\import \parent.\parent.Pair[i := i, j := j] \as Geometry;
\import \parent.\parent.\parent.Change[i := i, j := j] \as Change;
\import OriginalConnection.Pair[i := i.target, j := j.target] \as Old;
\import ResultConnection.Pair[i := i, j := j] \as New;
\import OriginalForms.Pair[i := i.target, j := j.target] \as OldForms;
\import ResultForms.Pair[i := i, j := j] \as NewForms;
\import SourceCharts.Transition[left := i.chart, right := j.chart] \as Domain;
\import TargetCharts.Transition[left := (bundle.atlas.local i.target).chart, right := (bundle.atlas.local j.target).chart] \as TargetDomain;
\import euclidean_forms.Euclidean[n := n].Pullback[m := m, U := Domain.domain, V := TargetDomain.domain, f := Change.map] \as Pull;
\import euclidean_forms.Euclidean[n := n].On[U := Domain.domain] \as Scalar;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\import Spaces.Multilinear[V := Vectors.Vector, space := Vectors.space] \as Multilinear;
\import Spaces.Coordinates[I := Fin.Fin m] \as TargetVectors;
\import Spaces.Linear[V := Vectors.Vector, W := TargetVectors.Vector, source := Vectors.space, target := TargetVectors.space] \as Tangent;
\import \root.GlobalForms[n := n, r := r].On[U := Domain.domain].Action[k := k] \as Action;
\import \root.GlobalForms[n := n, r := r].Between[m := m, U := Domain.domain, V := TargetDomain.domain].Pull[f := Change.map].Matrix[k := k] \as Transport;
\definition source: \forall (a: Fin.Fin r) -> Pull.apply k (OldForms.source (omega i.target) a) = NewForms.source (local omega i) a :=
  \fun (a: Fin.Fin r) => Scalar.ext k _ _ (\fun (u: SourceOpen.Carrier Domain.domain)(arguments: Multilinear.Arguments k) =>
    congr!{{Tangent.Map} {R.Real}} (\fun (d: Tangent.Map) => omega i.target a (\parent.\parent.\parent.In[i := i].map.apply (Domain.leftCoordinate u))
      (\fun (q: Fin.Fin k) => d.apply (arguments q))) _ _ (Geometry.sourceJacobian u));
\import calculus.Maps[n := n, m := m].Composition[U := Domain.domain, V := TargetDomain.domain, f := Change.map].After[l := m, W := (bundle.atlas.local j.target).chart.image, g := Old.map] \as OldComposite;
\import calculus.Maps[n := n, m := n].Composition[U := Domain.domain, V := j.chart.image, f := New.map].After[l := m, W := (bundle.atlas.local j.target).chart.image, g := \parent.\parent.\parent.In[i := j].map] \as NewComposite;
\import euclidean_forms.Euclidean[n := n].Pullback[m := m, U := Domain.domain, V := TargetDomain.domain, f := Change.map].After[l := m, W := (bundle.atlas.local j.target).chart.image, g := Old.map] \as OldPull;
\import euclidean_forms.Euclidean[n := n].Pullback[m := n, U := Domain.domain, V := j.chart.image, f := New.map].After[l := m, W := (bundle.atlas.local j.target).chart.image, g := \parent.\parent.\parent.In[i := j].map] \as NewPull;
\definition target: \forall (a: Fin.Fin r) -> Pull.apply k (OldForms.target (omega j.target) a) = NewForms.target (local omega j) a :=
  \fun (a: Fin.Fin r) => eq_reason_in!{{Scalar.Form k} _
    "=" _ "by" { sym!{{Scalar.Form k}} _ _ (OldPull.law k (omega j.target a)) }
    "=" _ "by" { congr!{{calculus.Maps[n := n, m := m].Map Domain.domain (bundle.atlas.local j.target).chart.image} {Scalar.Form k}}
      (\fun (g: calculus.Maps[n := n, m := m].Map Domain.domain (bundle.atlas.local j.target).chart.image) =>
        euclidean_forms.Euclidean[n := n].Pullback[m := m, U := Domain.domain, V := (bundle.atlas.local j.target).chart.image, f := g].apply k (omega j.target a)) _ _ Geometry.sameMap }
    "=" _ "by" { NewPull.law k (omega j.target a) }
  };
\definition law: NewForms.Compatible (local omega i) (local omega j) :=
  \fun (a: Fin.Fin r) => eq_reason_in!{{Scalar.Form k} _
    "=" _ "by" { congr!{{Fin.Fin r -> Scalar.Form k} {Scalar.Form k}} (\fun (eta: Fin.Fin r -> Scalar.Form k) => Action.apply New.transition eta a) _ _
      (\axiom:funext(NewForms.source (local omega i), (\fun (b: Fin.Fin r) => Pull.apply k (OldForms.source (omega i.target) b)), \fun (b: Fin.Fin r) => sym!{{Scalar.Form k}} _ _ (source b))) }
    "=" _ "by" { congr!{{\root.MatrixCalculus[n := n, r := r].On[U := Domain.domain].Matrix0} {Scalar.Form k}}
      (\fun (T: \root.MatrixCalculus[n := n, r := r].On[U := Domain.domain].Matrix0) => Action.apply T (\fun (b: Fin.Fin r) => Pull.apply k (OldForms.source (omega i.target) b)) a) _ _ (sym!{{\root.MatrixCalculus[n := n, r := r].On[U := Domain.domain].Matrix0}} _ _ Geometry.transition) }
    "=" _ "by" { sym!{{Scalar.Form k}} _ _ (congr!{{Fin.Fin r -> Scalar.Form k} {Scalar.Form k}} (\fun (eta: Fin.Fin r -> Scalar.Form k) => eta a) _ _ (Transport.law Old.transition (OldForms.source (omega i.target)))) }
    "=" _ "by" { congr!{{euclidean_forms.Euclidean[n := m].On[U := TargetDomain.domain].Form k} {Scalar.Form k}} (Pull.apply k) _ _ (OriginalForms.compatible omega i.target j.target a) }
    "=" _ "by" { target a }
  };
