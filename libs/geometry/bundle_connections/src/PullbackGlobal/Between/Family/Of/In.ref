\definition c: Chart := i.chart;
\definition d: \Cast[TargetCharts.Chart] Y.atlas.charts := (bundle.atlas.local i.target).chart;
\import Maps.Coordinates[f := f, left := c, right := d] \as Coordinates;
\definition included: SourceOpen.Included c.image Coordinates.domain := \fun (u: Fin.Fin n -> R.Real)(member: _) =>
  Coordinates.intro (\into[Fin.Fin n -> R.Real](u, c.image.points) \by { member })
    (i.inside (SourceCharts.point c (\into[Fin.Fin n -> R.Real](u, c.image.points) \by { member })));
\definition smooth: Coordinates.Smooth := (\bysub(Maps.ContinuousMap, { g: Maps.ContinuousMap \where Maps.Chartwise g }, f)) c d
  (\bysub(SourceCharts.Chart, X.atlas.charts, c)) (\bysub(TargetCharts.Chart, Y.atlas.charts, d));
\import calculus.Maps[n := n, m := m].Restriction[U := c.image, V := Coordinates.domain, W := d.image] \as Restrict;
\definition map: calculus.Maps[n := n, m := m].Map c.image d.image := Restrict.input included (Coordinates.map smooth);
\definition returnsPoint: \forall (u: SourceOpen.Carrier c.image) -> TargetCharts.point d (map.apply u) = Maps.apply f (SourceCharts.point c u) :=
  \fun (u: SourceOpen.Carrier c.image) => Coordinates.returnsPoint (SourceOpen.inclusion c.image Coordinates.domain included u);
