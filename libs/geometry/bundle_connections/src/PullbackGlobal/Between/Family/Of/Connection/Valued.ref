\import OriginalConnection.ValuedForms[k := k] \as OriginalForms;
\import ResultConnection.ValuedForms[k := k] \as ResultForms;
\definition local[omega: OriginalForms.Form][i: Index]: ResultForms.LocalForm i := \parent.In[i := i].form k (omega i.target);
\module Pair(omega: OriginalForms.Form, i: Index, j: Index);
\definition compatible: \forall (omega: OriginalForms.Form) -> ResultForms.Compatible (local omega) :=
  \fun (omega: OriginalForms.Form)(i, j: Index) => Pair[omega := omega, i := i, j := j].law;
\definition apply[omega: OriginalForms.Form]: ResultForms.Form :=
  \into[ResultForms.Data](local omega, { value: ResultForms.Data \where ResultForms.Compatible value }) \by { compatible omega };
\module Naturality;
