\import Level.Smooth[regular := regular].At[x := x] \as Kernel;
\import manifolds.Tangent[n := one].On[M := fiber].At[x := x] \as Tangent;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real Algebra.field].Isomorphism[V := Tangent.Vector, W := Kernel.Kernel, source := Tangent.space, target := Kernel.kernelSpace] \as Isomorphisms;
\definition identification: \exists Isomorphisms.Isomorphism := Kernel.identificationExists;
