\import \root.Euclidean[n := N.Nat^::zero] \as EmptyCoordinates;
\import calculus.Real[].Multivariable[n := N.Nat^::zero].Open[] \as Open;
\definition point: Open.Carrier Open.whole := \into[EmptyCoordinates.Point]((\fun (i: Fin.Fin N.Nat^::zero) => R.zero), Open.whole.points) \by { \refl(\fun (i: Fin.Fin N.Nat^::zero) => R.zero) };
\definition identity: calculus.Maps[n := N.Nat^::zero, m := N.Nat^::zero].Map Open.whole Open.whole := calculus.Identity[n := N.Nat^::zero].map Open.whole;
\import matrix_invariants.Ring[K := R.Real, scalars := std.Alg[].Field[].fieldAsCommutativeRing R.Real Algebra.field].At[n := N.Nat^::zero] \as Matrix;
\definition nonzero: EmptyCoordinates.InverseFunction[U := Open.whole, f := identity, a := point].Nonsingular :=
  \fun (zero: Matrix.determinant (EmptyCoordinates.Jacobian[U := Open.whole, f := identity].entries point) = R.zero) => Laws.zeroNeOne
    (trans!{R.Real} _ _ _ (sym!{R.Real} _ _ zero) (\refl(R.one)));
\definition inverseExists: \exists EmptyCoordinates.LocalInverse[Open.whole, identity, point] := EmptyCoordinates.InverseFunction[U := Open.whole, f := identity, a := point].localExistence nonzero;
