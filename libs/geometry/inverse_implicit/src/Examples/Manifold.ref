\import manifolds.Dimension[n := std.Data[].Nat[].Basic[].Def[].add one one].Examples[].Euclidean[].Subspace[U := Graph.domain] \as Domain;
\import manifolds.Dimension[n := one].Examples[].Euclidean[].Subspace[U := Line.whole] \as Codomain;
\import manifolds.Dimension[n := std.Data[].Nat[].Basic[].Def[].add one one].Smooth[] \as SourceModels;
\import manifolds.Dimension[n := one].Smooth[] \as TargetModels;
\definition source: SourceModels.Manifold := Domain.smoothManifold;
\definition target: TargetModels.Manifold := Codomain.smoothManifold;
\import manifolds.SmoothMap[n := std.Data[].Nat[].Basic[].Def[].add one one, m := one].Between[M := source, N := target] \as ManifoldMaps;
\definition function: ManifoldMaps.Map := manifolds.EuclideanMap[n := std.Data[].Nat[].Basic[].Def[].add one one, m := one].Between[U := Graph.domain, V := Line.whole].map parabolaFunction;
\definition zero: target.Point := \into[Fin.Fin one -> R.Real](Scalars.origin, Line.whole.points) \by { \refl(Scalars.origin) };
\import Plane.RegularValue[M := source, T := target] \as Regular;
\import Regular.Of[f := function, y := zero] \as Level;
\import manifolds.Tangent[n := std.Data[].Nat[].Basic[].Def[].add one one].On[M := source] \as SourceTangent;
\import manifolds.Tangent[n := one].On[M := target] \as TargetTangent;
\import manifolds.Differential[n := std.Data[].Nat[].Basic[].Def[].add one one, m := one].Between[M := source, N := target] \as Differential;
\module At(x: source.Point);
\definition regular: Level.Regular := \fun (x: Level.Fiber) => At[x := x].surjective;
\definition fiber: TargetModels.Manifold := Level.manifold regular;
\import manifolds.Immersion[n := one, m := std.Data[].Nat[].Basic[].Def[].add one one].Between[M := fiber, N := source] \as Immersions;
\definition inclusion: Immersions.Embedding := Level.Smooth[regular := regular].embedding;
\module Tangent(x: Level.Fiber);
