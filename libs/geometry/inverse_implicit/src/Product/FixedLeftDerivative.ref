\import Split.FixedLeft[U := U, V := V, c := c] \as Section;
\import calculus.Vector[n := m, m := dimension] \as Vector;
\import calculus.Maps[n := m, m := dimension] \as Maps;
\definition affine: \forall (p: RightPoint) -> Split.join c p = Coordinates.addPoint (Split.join c RightCoordinates.origin) (vertical.apply p) :=
  \fun (p: RightPoint) => Split.fixedLeftAffine c p;
\definition function: Vector.Function U := \fun (p: RightOpen.Carrier U) => Maps.apply U V (Section.map included) p;
\definition same: Vector.affine U (Split.join c RightCoordinates.origin) vertical = function :=
  \axiom:funext(Vector.affine U (Split.join c RightCoordinates.origin) vertical, function, \fun (p: RightOpen.Carrier U) => sym!{Point} _ _ (affine p));
\definition vectorLaw: \forall (a: RightOpen.Carrier U) -> Vector.HasDifferentialAt U function a vertical :=
  \fun (a: RightOpen.Carrier U) => \idelim Vector.affine U (Split.join c RightCoordinates.origin) vertical = function \with f: Vector.Function U => Vector.HasDifferentialAt U f a vertical \by {
    base: Vector.affineDifferential U (Split.join c RightCoordinates.origin) vertical a, equality: same
  };
\definition jacobian: \forall (a: RightOpen.Carrier U) -> Maps.Differential[U := U, V := V, f := Section.map included, a := a].value = vertical :=
  \fun (a: RightOpen.Carrier U) => Vector.Differential[U := U, f := function, a := a, d := Maps.Differential[U := U, V := V, f := Section.map included, a := a].value].uniqueness
    vertical Maps.Differential[U := U, V := V, f := Section.map included, a := a].vectorLaw (vectorLaw a);
