\definition center: Open.Carrier local.target := \into[Point](Maps.apply U Open.whole augmented a, local.target.points) \by { local.containsImage };
\module Rectangle(rectangle: \root.Product[n := n, m := m].Rectangle[local.target, center]);
\definition localExistence: \exists Solution := \block {
  \takefrom rectangle: \root.Product[n := n, m := m].Rectangle[local.target, center] \by \root.Product[n := n, m := m].Neighborhood[U := local.target, a := center].rectangleExists \then
  \return \exact(Rectangle[rectangle := rectangle].solution, Solution)
};
