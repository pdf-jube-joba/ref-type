\import SourceTangent.At[x := x] \as Domain;
\import TargetTangent.At[x := Maps.apply f x] \as Codomain;
\import Differential.At[f := f, x := x] \as Derivative;
\module InCharts(left: Domain.Chart, right: Codomain.Chart);
\definition existence: Regular -> \exists ( slice: Slice \where Charts.Contains slice.source x ) := \block {
  \fun (regular: Regular) \then
  \takefrom left: Domain.Chart \by Domain.chartExists \then
  \takefrom right: Codomain.Chart \by Codomain.chartExists \then
  \return InCharts[left := left, right := right].existence regular
};
