\import Differential.At[f := f, x := x] \as GlobalDifferential;
\import Maps.Coordinates[f := f, left := left, right := right] \as Coordinates;
\import Derivative.InCharts[left := left, right := right] \as Derivative;
\import calculus.Maps[n := dimension, m := m] \as Calculus;
\definition coordinateMap: Calculus.Map Coordinates.domain right.image := Derivative.coordinateMap;
\import Calculus.Corestriction[U := Coordinates.domain, V := right.image, W := RightOpen.whole, f := coordinateMap,
  inside := \fun (u: Open.Carrier Coordinates.domain) => \refl(Calculus.apply Coordinates.domain right.image coordinateMap u)] \as Corestriction;
\definition function: Calculus.Map Coordinates.domain RightOpen.whole := Corestriction.map;
\definition point: Open.Carrier Coordinates.domain := Derivative.point;
\import \root.Product[n := n, m := m].Submersion[U := Coordinates.domain, f := function, a := point] \as Submersion;
\import Domain.Coordinate[chart := left] \as SourceCoordinates;
\import Codomain.Coordinate[chart := right] \as TargetCoordinates;
\definition surjective: Regular -> Submersion.Surjective := \block {
  \fun (regular: Regular)(w: RightPoint) \then
  \takefrom u: \Cast[Domain.Vector] ({ u: Domain.Vector \where GlobalDifferential.value.apply u = TargetCoordinates.encode w })
    \by regular x (TargetCoordinates.encode w) \then
  \let mapsTo: GlobalDifferential.value.apply u = TargetCoordinates.encode w := \bysub(Domain.Vector, { u: Domain.Vector \where GlobalDifferential.value.apply u = TargetCoordinates.encode w }, u) \then
  \let v: Point := SourceCoordinates.decode u \then
  \return Logic.existsIntro[Point, { v: Point \where Submersion.differential.apply v = w }] v (eq_reason_in!{RightPoint _
    "=" _ "by" { congr!{{calculus.Vector[n := dimension, m := m].LinearMap} RightPoint} (\fun (L: calculus.Vector[n := dimension, m := m].LinearMap) => L.apply v) _ _ (Corestriction.differential point) }
    "=" _ "by" { sym!{RightPoint} _ _ (GlobalDifferential.coordinates left right u) }
    "=" _ "by" { congr!{{Codomain.Vector} RightPoint} TargetCoordinates.decode _ _ mapsTo }
    "=" w "by" { TargetCoordinates.decodeEncode w }
  })
};
\module WithLocal(local: Submersion.LocalForm);
\definition existence: Regular -> \exists ( slice: Slice \where Charts.Contains slice.source x ) := \block {
  \fun (regular: Regular) \then
  \takefrom local: Submersion.LocalForm \by Submersion.localExistence (surjective regular) \then
  \return WithLocal[local := local].existence
};
