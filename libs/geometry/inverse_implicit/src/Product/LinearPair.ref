\import topological_algebra.Euclidean[].Dimension[n := d] \as Source;
\definition map: calculus.Vector[n := d, m := dimension].LinearMap := calculus.Vector[n := d, m := dimension].LinearMap {
  apply := \fun (v: Source.Point) => Split.join (left.apply v) (right.apply v),
  preservesAdd := \fun (v, w: Source.Point) => trans!{Point} _ _ _
    (congr!{LeftPoint RightPoint Point} Split.join _ _ _ _ (left.preservesAdd v w) (right.preservesAdd v w)) (joinAdd (left.apply v) (left.apply w) (right.apply v) (right.apply w)),
  preservesScale := \fun (c: Real)(v: Source.Point) => trans!{Point} _ _ _
    (congr!{LeftPoint RightPoint Point} Split.join _ _ _ _ (left.preservesScale c v) (right.preservesScale c v)) (joinScale c (left.apply v) (right.apply v)),
};
