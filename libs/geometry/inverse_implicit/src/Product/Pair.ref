\import calculus.Maps[n := d, m := dimension] \as Result;
\import calculus.Maps[n := d, m := n] \as Left;
\import calculus.Maps[n := d, m := m] \as Right;
\import calculus.Real[].Multivariable[n := d].Open[] \as Source;
\import Source.Analysis[] \as Analysis;
\import calculus.Real[].Multivariable[n := d].Space[].Linear[] \as ScalarLinear;
\import calculus.Vector[n := d, m := dimension] \as Vector;
\import calculus.Blocks[n := n, m := m].Pair[d := d].On[U := U, V := LeftOpen.whole, W := RightOpen.whole, f := f, g := g] \as Pair;
\definition map: Result.Map U Open.whole := Result.Corestriction[U := U, V := Split.product LeftOpen.whole RightOpen.whole, W := Open.whole, f := Pair.map,
  inside := \fun (x: Source.Carrier U) => \refl(Split.join (Left.apply U LeftOpen.whole f x) (Right.apply U RightOpen.whole g x))].map;
\module At(a: Source.Carrier U);
