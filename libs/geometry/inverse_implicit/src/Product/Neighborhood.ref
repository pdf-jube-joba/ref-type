\import Scalars.Estimates[] \as Bounds;
\import Scalars.Distance[] \as Distance;
\import topological_algebra.Euclidean[].Dimension[n := dimension].Norm[] \as Norm;
\import \root.Euclidean[n := n] \as Left;
\import \root.Euclidean[n := m] \as Right;
\module At(rho: Real, ball: Open.BallInside[U.points, a, rho]);
\definition rectangleExists: \exists Rectangle[U, a] := \block {
  \takefrom rho: \Cast[Real] ({ r: Real \where Open.BallInside[U.points, a, r] }) \by U.open a (\bysub(Point, U.points, a)) \then
  \return \exact(At[rho := rho, ball := \bysub(Real, { r: Real \where Open.BallInside[U.points, a, r] }, rho)].rectangle, Rectangle[U, a])
};
