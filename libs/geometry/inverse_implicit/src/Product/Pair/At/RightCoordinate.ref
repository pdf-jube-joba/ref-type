\definition rowEquality: Vector.row candidate (Indices.right j) = calculus.Vector[n := d, m := m].row RightD.value j :=
  ScalarLinear.ext _ _ (\axiom:funext((Vector.row candidate (Indices.right j)).apply, (calculus.Vector[n := d, m := m].row RightD.value j).apply,
    \fun (v: topological_algebra.Euclidean[].Dimension[n := d].Point) => Tuples.atRight (LeftD.value.apply v) (RightD.value.apply v) j));
\definition functionEquality: (\fun (x: Source.Carrier U) => Result.apply U Open.whole map x (Indices.right j)) =
  (\fun (x: Source.Carrier U) => Right.apply U RightOpen.whole g x j) :=
  \axiom:funext((\fun (x: Source.Carrier U) => Result.apply U Open.whole map x (Indices.right j)), (\fun (x: Source.Carrier U) => Right.apply U RightOpen.whole g x j),
    \fun (x: Source.Carrier U) => Tuples.atRight (Left.apply U LeftOpen.whole f x) (Right.apply U RightOpen.whole g x) j);
\definition law: Analysis.HasDifferentialAt U (\fun (x: Source.Carrier U) => Result.apply U Open.whole map x (Indices.right j)) a (Vector.row candidate (Indices.right j)) :=
  \idelim (\fun (x: Source.Carrier U) => Right.apply U RightOpen.whole g x j) = (\fun (x: Source.Carrier U) => Result.apply U Open.whole map x (Indices.right j))
    \with h: Source.ScalarFunction U => Analysis.HasDifferentialAt U h a (Vector.row candidate (Indices.right j)) \by {
    base: \idelim calculus.Vector[n := d, m := m].row RightD.value j = Vector.row candidate (Indices.right j)
      \with L: calculus.Real[].Multivariable[n := d].Differential[].Def[].LinearMap => Analysis.HasDifferentialAt U (\fun (x: Source.Carrier U) => Right.apply U RightOpen.whole g x j) a L \by {
      base: RightD.vectorLaw j, equality: sym!{{calculus.Real[].Multivariable[n := d].Differential[].Def[].LinearMap}} _ _ rowEquality
    }, equality: sym!{{Source.ScalarFunction U}} _ _ functionEquality
  };
