\definition rowEquality: Vector.row candidate (Indices.left j) = calculus.Vector[n := d, m := n].row LeftD.value j :=
  ScalarLinear.ext _ _ (\axiom:funext((Vector.row candidate (Indices.left j)).apply, (calculus.Vector[n := d, m := n].row LeftD.value j).apply,
    \fun (v: topological_algebra.Euclidean[].Dimension[n := d].Point) => Tuples.atLeft (LeftD.value.apply v) (RightD.value.apply v) j));
\definition functionEquality: (\fun (x: Source.Carrier U) => Result.apply U Open.whole map x (Indices.left j)) =
  (\fun (x: Source.Carrier U) => Left.apply U LeftOpen.whole f x j) :=
  \axiom:funext((\fun (x: Source.Carrier U) => Result.apply U Open.whole map x (Indices.left j)), (\fun (x: Source.Carrier U) => Left.apply U LeftOpen.whole f x j),
    \fun (x: Source.Carrier U) => Tuples.atLeft (Left.apply U LeftOpen.whole f x) (Right.apply U RightOpen.whole g x) j);
\definition law: Analysis.HasDifferentialAt U (\fun (x: Source.Carrier U) => Result.apply U Open.whole map x (Indices.left j)) a (Vector.row candidate (Indices.left j)) :=
  \idelim (\fun (x: Source.Carrier U) => Left.apply U LeftOpen.whole f x j) = (\fun (x: Source.Carrier U) => Result.apply U Open.whole map x (Indices.left j))
    \with h: Source.ScalarFunction U => Analysis.HasDifferentialAt U h a (Vector.row candidate (Indices.left j)) \by {
    base: \idelim calculus.Vector[n := d, m := n].row LeftD.value j = Vector.row candidate (Indices.left j)
      \with L: calculus.Real[].Multivariable[n := d].Differential[].Def[].LinearMap => Analysis.HasDifferentialAt U (\fun (x: Source.Carrier U) => Left.apply U LeftOpen.whole f x j) a L \by {
      base: LeftD.vectorLaw j, equality: sym!{{calculus.Real[].Multivariable[n := d].Differential[].Def[].LinearMap}} _ _ rowEquality
    }, equality: sym!{{Source.ScalarFunction U}} _ _ functionEquality
  };
