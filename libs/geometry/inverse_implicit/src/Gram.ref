\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import linear_algebra.Euclidean[n := n] \as Source;
\import linear_algebra.Euclidean[n := m] \as Target;
\import calculus.Real[].Multivariable[n := N.Nat^::zero].Open[] \as Open;
\import calculus.GramSchmidt[d := N.Nat^::zero, q := m].On[U := Open.whole] \as Smooth;
\import Smooth.Rank[p := n] \as Rank;
\definition point: Open.Carrier Open.whole := \into[calculus.Real[].Multivariable[n := N.Nat^::zero].Point]
  ((\fun (i: std.Data[].FinSet[].Fin N.Nat^::zero) => real.Analysis[].zero), Open.whole.points) \by { \refl(\fun (i: std.Data[].FinSet[].Fin N.Nat^::zero) => real.Analysis[].zero) };
\definition existence: \forall (A: linear_algebra.Commutative[K := real.Analysis[].Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing real.Analysis[].Real real.Analysis[].Algebra[].field].Linear[V := Source.Vector, W := Target.Vector, source := Source.space, target := Target.space].Map) ->
  Target.Gram[k := n].Injective A -> \exists Target.Gram[k := n].Factorization[A] := \block {
  \fun (A: linear_algebra.Commutative[K := real.Analysis[].Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing real.Analysis[].Real real.Analysis[].Algebra[].field].Linear[V := Source.Vector, W := Target.Vector, source := Source.space, target := Target.space].Map)(injective: _) \then
  \takefrom factors: Rank.Factors[\fun (x: Open.Carrier Open.whole) => A] \by Smooth.exists n (\fun (x: Open.Carrier Open.whole) => A)
    (\fun (i: std.Data[].FinSet[].Fin m)(j: std.Data[].FinSet[].Fin n) => Open.Smooth[].Operations[].constantSmooth Open.whole (A.apply (Source.basis j) i))
    (\fun (x: Open.Carrier Open.whole) => injective) \then
  \return \exact(factors.value point, Target.Gram[k := n].Factorization[A])
};
