\definition input: Open.Carrier U := Open.inclusion Restriction.domain U sourceIncluded x;
\definition y: Open.Carrier smallProduct := Coordinates.apply Restriction.domain smallProduct Restriction.forward x;
\definition z: ImageOpen.Carrier local.values := Blocks.On[U := parameters, V := local.values].rightPoint y;
\definition image: TargetOpen.Carrier TargetChange.target := \into[TargetPoint](Maps.apply U TargetOpen.whole f input, TargetChange.target.points) \by { imageInside x };
\definition coordinate: TargetOpen.Carrier Graph.domain := TargetMaps.apply TargetChange.target Graph.domain TargetChange.backward image;
\definition graphCoordinate: coordinate = Graph.graphPoint z := \block {
  \let raw: splitting.coordinate.apply (Maps.apply U TargetOpen.whole f input) = splitting.coordinate.apply (Sections.apply local.values TargetOpen.whole section z) :=
    congr!{TargetPoint TargetPoint} splitting.coordinate.apply _ _ (imageEquation x) \then
  \return trans!{TargetPoint} _ _ _ raw (trans!{TargetPoint} _ _ _ (sym!{TargetPoint} _ _ (TargetBlocks.recover (splitting.coordinate.apply (Sections.apply local.values TargetOpen.whole section z))))
    (congr!{ImagePoint TargetPoint} (TargetBlocks.join (Transverse.apply local.values TransverseOpen.whole transverse z)) _ _
      (trans!{ImagePoint} _ _ _ (splitting.projection (Sections.apply local.values TargetOpen.whole section z)) (sectionProjection z))))
};
\definition formula: TargetMaps.apply TargetChange.target Graph.domain targetCoordinates.forward image = TargetBlocks.join topological_algebra.Euclidean[].Dimension[n := l].Def[].origin (Blocks.right y) :=
  trans!{TargetPoint} _ _ _ (congr!{{TargetOpen.Carrier Graph.domain} TargetPoint} (\fun (p: TargetOpen.Carrier Graph.domain) => Graph.minus p) _ _ graphCoordinate) (Graph.onGraph z);
