\definition z: ImageOpen.Carrier local.values := Blocks.On[U := parameters, V := local.values].rightPoint y;
\definition p: ParameterOpen.Carrier local.parameters := ParameterOpen.inclusion parameters local.parameters parameterIncluded (Blocks.On[U := parameters, V := local.values].leftPoint y);
\import \parent.\parent.Section[z := z] \as Section;
\import Blocks.FixedRight[U := local.parameters, V := product, c := z] \as Cut;
\definition same: Cut.apply Section.included p = Open.inclusion smallProduct product productIncluded y := Blocks.recover y;
\definition equation: Maps.apply product TargetOpen.whole transformed (Open.inclusion smallProduct product productIncluded y) = Sections.apply local.values TargetOpen.whole section z :=
  trans!{TargetPoint} _ _ _ (congr!{{Open.Carrier product} TargetPoint} (Maps.apply product TargetOpen.whole transformed) _ _ (sym!{{Open.Carrier product}} _ _ same))
    (Section.constant rho ball p (R.ltLeTrans _ radius rho
      (Parameter.ofBall baseParameter radius (Blocks.On[U := parameters, V := local.values].leftPoint y)) (Bounds.halfBelow rho (R.Order[].leOfLt _ _ ball.positive))));
