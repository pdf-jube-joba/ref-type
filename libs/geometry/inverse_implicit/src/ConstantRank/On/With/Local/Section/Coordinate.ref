\import ParameterOpen.C1[].Bounded[U := local.parameters, f := component j, g := gradient j, a := baseParameter, x := p] \as MeanValue;
\definition constant: ParameterOpen.BallInside[local.parameters.points, baseParameter, rho] ->
  R.Lt (topological_algebra.Euclidean[].Dimension[n := k].Def[].pointDistance p baseParameter) rho -> component j p = component j baseParameter := \block {
  \fun (ball: _)(near: _) \then
  \let bound: R.Le (Scalars.distance (component j p) (component j baseParameter)) Scalars.zero := R.leReplaceRight _ _ _
    (trans!{Real} _ _ _ (congr!{Real Real} (\fun (s: Real) => Scalars.mul s MeanValue.radius) _ _ (Laws.fieldMulZeroRight MeanValue.count)) (Laws.fieldMulZeroLeft MeanValue.radius))
    (MeanValue.estimate rho Scalars.zero ball near (R.leRefl Scalars.zero)
      (\fun (i: Fin.Fin k) => Partials.partialLaw local.parameters (component j) i)
      (\fun (q: ParameterOpen.Carrier local.parameters)(i: Fin.Fin k)(within: _) => R.leReplaceLeft Scalars.zero _ Scalars.zero
        (sym!{Real} _ _ (trans!{Real} _ _ _ (congr!{Real Real} (\fun (s: Real) => Scalars.distance s Scalars.zero) _ _ (gradientZero q j i)) (Scalars.Distance[].distanceSelf Scalars.zero))) (R.leRefl Scalars.zero))) \then
  \return Scalars.Distance[].distanceSeparated (component j p) (component j baseParameter)
    (R.leAntisym _ _ bound (Scalars.Distance[].distanceNonnegative (component j p) (component j baseParameter)))
};
