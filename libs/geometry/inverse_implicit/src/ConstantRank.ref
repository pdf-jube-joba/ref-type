\use std.Logic[].Equality[].eq_reason_in;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.sym;
\use Equality.trans;
\import real.Analysis[] \as Scalars;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import Scalars.Algebra[] \as Algebra;
\import \root.Product[n := k, m := r] \as Source;
\import \root.Product[n := l, m := r] \as Target;
\definition sourceDimension: N.Nat^ := Source.dimension;
\definition targetDimension: N.Nat^ := Target.dimension;
\import calculus.Real[].Multivariable[n := sourceDimension].Open[] \as Open;
\import calculus.Real[].Multivariable[n := targetDimension].Open[] \as TargetOpen;
\import calculus.Real[].Multivariable[n := r].Open[] \as ImageOpen;
\import calculus.Maps[n := sourceDimension, m := targetDimension] \as Maps;
\import calculus.Maps[n := sourceDimension, m := r] \as Submersions;
\import calculus.Vector[n := sourceDimension, m := targetDimension] \as Differentials;
\import calculus.Vector[n := targetDimension, m := r] \as Projections;
\import \root.Rank[n := sourceDimension, m := targetDimension, r := r] \as Rank;
\import linear_algebra.Euclidean[n := targetDimension] \as Ambient;
\import linear_algebra.Euclidean[n := r] \as Image;
\definition Real: \Set := Scalars.Real;
\definition Point: \Set := topological_algebra.Euclidean[].Dimension[n := sourceDimension].Point;
\definition TargetPoint: \Set := topological_algebra.Euclidean[].Dimension[n := targetDimension].Point;
\definition ImagePoint: \Set := Image.Vector;
\import calculus.Blocks[n := k, m := r] \as SourceBlocks;
\import calculus.Blocks[n := l, m := r] \as TargetBlocks;
\import calculus.Real[].Multivariable[n := k].Open[] \as ParameterOpen;
\import calculus.Real[].Multivariable[n := l].Open[] \as TransverseOpen;
\module On(U: Open.OpenSet, f: Maps.Map U TargetOpen.whole, a: Open.Carrier U);
