\import std.Logic[].Proposition[] \as Logic;
\import topological_algebra.Euclidean[].Dimension[n := n] \as Source;
\import topological_algebra.Euclidean[].Dimension[n := m] \as Target;
\import topological_algebra.Euclidean[].Dimension[n := r] \as Image;
\import calculus.Vector[n := n, m := m] \as Maps;
\import calculus.Vector[n := n, m := r] \as Coordinates;
\import calculus.Vector[n := r, m := m] \as Images;
\structure Witness[L: Maps.LinearMap]: \Set := {
  image: Images.LinearMap,
  coordinate: Coordinates.LinearMap,
  imageInjective: \forall (v, w: Image.Point) -> image.apply v = image.apply w -> v = w,
  coordinateSurjective: \forall (w: Image.Point) -> \exists ( v: Source.Point \where coordinate.apply v = w ),
  formula: \forall (v: Source.Point) -> L.apply v = image.apply (coordinate.apply v),
};
\definition HasRank[L: Maps.LinearMap]: \Prop := \exists Witness[L];
