\definition Left: \Prop := \forall (v: Point) -> e.apply (d.apply v) = v;
\definition Right: \Prop := \forall (v: Point) -> d.apply (e.apply v) = v;
\import calculus.LinearMap[n := n, m := n].On[U := Open.whole, L := e] \as InverseLinear;
\import SmoothMaps.Preimage[U := Open.whole, W := Open.whole, V := U, f := InverseLinear.map] \as Preimage;
\definition target: Open.OpenSet := Preimage.domain;
\definition backward: SmoothMaps.Map target U := Preimage.map;
\definition forwardWhole: SmoothMaps.Map U Open.whole := calculus.LinearMap[n := n, m := n].On[U := U, L := d].map;
\module With(left: Left, right: Right);
