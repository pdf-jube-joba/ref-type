\definition image: Open.Carrier V := SmoothMaps.apply U V f.forward x;
\definition forward: Vector.LinearMap := SmoothMaps.Differential[U := U, V := V, f := f.forward, a := x].value;
\definition backward: Vector.LinearMap := SmoothMaps.Differential[U := V, V := U, f := f.backward, a := image].value;
\definition left: \forall (v: Point) -> backward.apply (forward.apply v) = v :=
  \fun (v: Point) => congr!{{Vector.LinearMap} Point} (\fun (L: Vector.LinearMap) => L.apply v) _ _
    (Diffeomorphisms.Differential[U := U, V := V, f := f, a := x].inverseJacobian);
\definition inverse: Diffeomorphisms.Diffeomorphism V U := Diffeomorphisms.Inverse[U := U, V := V, f := f].inverse;
\definition right: \forall (v: Point) -> forward.apply (backward.apply v) = v :=
  \fun (v: Point) => trans!{Point} _ _ _
    (sym!{Point} _ _ (congr!{{Open.Carrier U} Point} (\fun (a: Open.Carrier U) => SmoothMaps.Differential[U := U, V := V, f := f.forward, a := a].value.apply (backward.apply v)) _ _ (f.leftInverse x)))
    (congr!{{Vector.LinearMap} Point} (\fun (L: Vector.LinearMap) => L.apply v) _ _ (Diffeomorphisms.Differential[U := V, V := U, f := inverse, a := image].inverseJacobian));
