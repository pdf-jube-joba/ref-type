\definition point: Open.Carrier Jacobian.domain := \into[Point](a, Jacobian.domain.points) \by { Jacobian.intro a nonzero };
\import \parent.\parent.Normalization[U := Jacobian.domain, f := Jacobian.restricted, a := point, B := Jacobian.inverse] \as Construction;
\import \parent.\parent.Jacobian[U := Jacobian.domain, f := Jacobian.restricted] \as Restricted;
\definition left: Construction.Left := \fun (x: Open.Carrier Jacobian.domain)(v: Point) =>
  trans!{Point} _ _ _ (congr!{Point Point} (Jacobian.inverse x).apply _ _
    (congr!{{Vector.LinearMap} Point} (\fun (L: Vector.LinearMap) => L.apply v) _ _ (Jacobian.restrictionDifferential x))) (Jacobian.left x v);
\definition right: Construction.Right := \fun (x: Open.Carrier Jacobian.domain)(v: Point) =>
  trans!{Point} _ _ _ (congr!{{Vector.LinearMap} Point} (\fun (L: Vector.LinearMap) => L.apply ((Jacobian.inverse x).apply v)) _ _ (Jacobian.restrictionDifferential x)) (Jacobian.right x v);
\definition localExistence: \exists LocalInverse[U, f, a] := \block {
  \takefrom local: LocalInverse[Jacobian.domain, Jacobian.restricted, point] \by Construction.With[left := left, right := right].localExistence \then
  \let included: Open.Included local.domain U := \fun (x: Point)(member: _) => Jacobian.included x (local.included x member) \then
  \return \exact(LocalInverse[U, f, a] {
    domain := local.domain, target := local.target, included := included,
    contains := local.contains, containsImage := local.containsImage, equivalence := local.equivalence,
    forward := local.forward,
  }, LocalInverse[U, f, a])
};
