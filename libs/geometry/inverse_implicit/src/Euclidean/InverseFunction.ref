\import \parent.Jacobian[U := U, f := f] \as Jacobian;
\import matrix_invariants.Field[K := Real, field := Algebra.field].At[n := n] \as Inversion;
\definition Nonsingular: \Prop := Inversion.Nonzero (Jacobian.entries a);
\module At(nonzero: Nonsingular);
\definition localExistence: Nonsingular -> \exists LocalInverse[U, f, a] :=
  \fun (nonzero: Nonsingular) => At[nonzero := nonzero].localExistence;
