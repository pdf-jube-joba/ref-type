\definition partial: Open.ScalarFunction U := Partials.derivative U (SmoothMaps.coordinateFunction U Open.whole f j) i;
\definition value: \forall (x: Open.Carrier U) -> (differential x).apply (Coordinates.basis i) j = partial x :=
  \fun (x: Open.Carrier U) => sym!{Real} _ _ (Uniqueness.partialUnique U (SmoothMaps.coordinateFunction U Open.whole f j) i x _ _
    (Partials.partialLaw U (SmoothMaps.coordinateFunction U Open.whole f j) i x)
    (Analysis.Differential[U := U, f := SmoothMaps.coordinateFunction U Open.whole f j, a := x, d := Vector.row (differential x) j].Partial[i := i].law
      (SmoothMaps.Differential[U := U, V := Open.whole, f := f, a := x].vectorLaw j)));
\definition smooth: Smooth.SmoothOn U (\fun (x: Open.Carrier U) => (differential x).apply (linear_algebra.Euclidean[n := n].basis i) j) :=
  \idelim partial = (\fun (x: Open.Carrier U) => (differential x).apply (linear_algebra.Euclidean[n := n].basis i) j)
    \with h: Open.ScalarFunction U => Smooth.SmoothOn U h \by {
      base: Partials.partialSmooth U (SmoothMaps.coordinateFunction U Open.whole f j) i,
      equality: \axiom:funext(partial, (\fun (x: Open.Carrier U) => (differential x).apply (linear_algebra.Euclidean[n := n].basis i) j),
        \fun (x: Open.Carrier U) => sym!{Real} _ _ (value x))
    };
\definition entriesValue: \forall (x: Open.Carrier U) -> entries x j i = (differential x).apply (linear_algebra.Euclidean[n := n].basis i) j :=
  \fun (x: Open.Carrier U) => sym!{Real} _ _ (Matrix.Operations[].entry _ _ (Comparison.entriesComparison (differential x)) j i);
\definition continuous: Families.Continuous Topology.topology (\fun (x: Open.Carrier U) => entries x j i) :=
  Families.transport Topology.topology (\fun (x: Open.Carrier U) => (differential x).apply (linear_algebra.Euclidean[n := n].basis i) j) (\fun (x: Open.Carrier U) => entries x j i)
    (\fun (x: Open.Carrier U) => sym!{Real} _ _ (entriesValue x)) (Continuity.topological _ (Properties.continuous U _ smooth));
