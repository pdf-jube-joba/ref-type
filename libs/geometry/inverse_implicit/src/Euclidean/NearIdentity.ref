\import metric_spaces.MetricSpace[Carrier := Point] \as Metrics;
\import Metrics.Complete[metric := Space.Completeness[].metric] \as Complete;
\definition residual[x: Open.Carrier U]: Point := Coordinates.subPoint x (f x);
\structure Control: \Prop := {
  positive: R.Lt Scalars.zero r,
  inside: \forall (x: Point) -> R.Le (distance x a) r -> \In[Point] U.points x,
  contraction: \forall (x, y: Open.Carrier U) -> R.Le (distance x a) r -> R.Le (distance y a) r ->
    R.Le (distance (residual x) (residual y)) (Scalars.mul Scalars.half (distance x y)),
};
\definition clipped[control: Control][x: Point]: Open.Carrier U := \into[Point](Clip.value a r x, U.points) \by {
  control.inside (Clip.value a r x) (Clip.bounded a r x (Order.leOfLt _ _ control.positive))
};
\module For(control: Control);
