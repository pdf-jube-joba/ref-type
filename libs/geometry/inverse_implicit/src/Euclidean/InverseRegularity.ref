\import Open.Analysis[] \as Analysis;
\import Open.Smooth[] \as Smooth;
\import Smooth.Properties[] \as Properties;
\import Smooth.Derivative[] \as Partials;
\import \parent.Jacobian[U := U, f := f] \as Jacobian;
\structure Hypotheses: \Prop := {
  right: \forall (y: Open.Carrier V) -> SmoothMaps.apply U Open.whole f (g y) = y,
  lipschitz: \forall (y, z: Open.Carrier V) -> R.Le (distance (g y) (g z)) (Scalars.add (distance y z) (distance y z)),
  left: \forall (x: Open.Carrier U)(v: Point) -> (B x).apply ((Jacobian.differential x).apply v) = v,
  rightLinear: \forall (x: Open.Carrier U)(v: Point) -> (Jacobian.differential x).apply ((B x).apply v) = v,
};
\module With(hypotheses: Hypotheses);
