\import \parent.\parent.\parent.LinearChange[U := local.target, d := center, e := B a] \as Change;
\import Change.With[left := left a, right := right a] \as Coordinates;
\definition equivalence: Diffeomorphisms.Diffeomorphism local.domain Change.target := Diffeomorphisms.Composition[U := local.domain, V := local.target, f := local.equivalence].After[l := n, W := Change.target, g := Coordinates.equivalence].compose;
\definition imageEquation: center.apply (SmoothMaps.apply U Open.whole normalized a) = SmoothMaps.apply U Open.whole f a := right a (SmoothMaps.apply U Open.whole f a);
\definition containsImage: \In[Point] Change.target.points (SmoothMaps.apply U Open.whole f a) :=
  \idelim center.apply (SmoothMaps.apply U Open.whole normalized a) = SmoothMaps.apply U Open.whole f a \with p: Point => \In[Point] Change.target.points p \by {
    base: Coordinates.inside (\into[Point](SmoothMaps.apply U Open.whole normalized a, local.target.points) \by { local.containsImage }), equality: imageEquation
  };
\definition forward: \forall (x: Open.Carrier local.domain) -> SmoothMaps.apply local.domain Change.target equivalence.forward x = SmoothMaps.apply U Open.whole f (Open.inclusion local.domain U local.included x) :=
  \fun (x: Open.Carrier local.domain) => trans!{Point} _ _ _ (congr!{Point Point} center.apply _ _ (local.forward x))
    (right a (SmoothMaps.apply U Open.whole f (Open.inclusion local.domain U local.included x)));
\definition localInverse: LocalInverse[U, f, a] := LocalInverse[U, f, a] {
  domain := local.domain, target := Change.target, included := local.included,
  contains := local.contains, containsImage := containsImage, equivalence := equivalence, forward := forward,
};
