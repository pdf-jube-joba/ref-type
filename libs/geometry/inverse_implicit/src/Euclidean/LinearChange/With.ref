\definition inside: \forall (x: Open.Carrier U) -> \In[Point] target.points (d.apply x) := \block {
  \fun (x: Open.Carrier U) \then
  \let y: Open.Carrier Open.whole := SmoothMaps.apply U Open.whole forwardWhole x \then
  \return Preimage.intro y (\idelim x = e.apply (d.apply x) \with z: Point => \In[Point] U.points z \by {
    base: \bysub(Point, U.points, x), equality: sym!{Point} _ _ (left x)
  })
};
\definition forward: SmoothMaps.Map U target := SmoothMaps.Corestriction[U := U, V := Open.whole, W := target, f := forwardWhole, inside := inside].map;
\definition data: Diffeomorphisms.Data[U, target] := Diffeomorphisms.Data[U, target] { forward := forward, backward := backward };
\definition equivalence: Diffeomorphisms.Diffeomorphism U target := \into[Diffeomorphisms.Data[U, target]](data,
  { data: Diffeomorphisms.Data[U, target] \where Diffeomorphisms.Laws[U, target, data] }) \by {
  Diffeomorphisms.Laws[U, target, data] {
  leftInverse := \fun (x: Open.Carrier U) => left x,
  rightInverse := \fun (y: Open.Carrier target) => right y,
  }
};
