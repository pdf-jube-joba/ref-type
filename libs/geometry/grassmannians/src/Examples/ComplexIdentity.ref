\import complex.Complex[] \as C;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := H.Complex[].scalar].Finite[n := n] \as E;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := Fields.fieldAsCommutativeRing C.Complex C.Algebra[].field].Eigen[V := E.Vector, space := E.space] \as Eigen;
\import H.Over[K := C.Complex, field := C.Algebra[].field, scalar := H.Complex[].scalar, topological := H.Complex[].topological].At[n := n] \as At;
\definition projection: At.Projection := At.Projection { map := Eigen.identity, selfAdjoint := \fun (v, w: At.Vector) => \refl(At.dot v w), idempotent := \fun (v: At.Vector) => \refl(v) };
\import At.OnProjection[P := projection].Rank[k := n] \as Rank;
\definition basis: Rank.Basis := Rank.Basis { value := Eigen.identity, coordinate := Eigen.identity, leftInverse := \fun (v: At.Vector) => \refl(v), reconstruction := \fun (v: At.Vector) => \refl(v) };
\import \root.Complex[n := n, k := n] \as Original;
\import Original.Model[] \as Model;
\definition originalPoint: Original.Grassmannian := \into[At.Projection](projection, Original.points) \by { \exact(basis, Rank.Basis) };
\definition point: Model.Carrier := Model.fromOriginal originalPoint;
