\import std.Data[].Nat[] \as N;
\import std.Alg[].Field[] \as Fields;
\import hermitian_frames.Hermitian[] \as H;
\import complex.Complex[] \as C;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := H.Complex[].scalar] \as Geometry;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := Fields.fieldAsCommutativeRing C.Complex C.Algebra[].field] \as Spaces;
\import Geometry.Finite[n := m] \as E;
\import Geometry.Finite[n := N.Nat^::zero] \as Empty;
\import Spaces.Linear[V := Empty.Vector, W := E.Vector, source := Empty.space, target := E.space].Operations[] \as ZeroMaps;
\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := H.Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Finite[n := m] \as Finite;
\definition emptyFrame: Finite.Orthonormal[N.Nat^::zero] := Finite.Orthonormal[N.Nat^::zero] {
  value := ZeroMaps.zeroMap, isometry := \fun (v, w: Empty.Vector) => E.form.zeroRight E.space.zero
};
\import Finite.Frame[k := N.Nat^::zero, frame := emptyFrame] \as Zero;
\import \root.Complex[n := m, k := N.Nat^::zero] \as OldZero;
\import OldZero.Model[] \as ZeroModel;
\definition zero: ZeroModel.Carrier := ZeroModel.fromOriginal (\into[H.Over[K := C.Complex, field := C.Algebra[].field, scalar := H.Complex[].scalar, topological := H.Complex[].topological].At[n := m].Projection](Zero.projection, OldZero.points) \by { \exact(Zero.basis, H.Over[K := C.Complex, field := C.Algebra[].field, scalar := H.Complex[].scalar, topological := H.Complex[].topological].At[n := m].OnProjection[P := Zero.projection].Rank[k := N.Nat^::zero].Basis) });
\import Spaces.Eigen[V := E.Vector, space := E.space] \as Eigen;
\import H.Over[K := C.Complex, field := C.Algebra[].field, scalar := H.Complex[].scalar, topological := H.Complex[].topological].At[n := m] \as At;
\definition identity: At.Projection := At.Projection { map := Eigen.identity, selfAdjoint := \fun (v, w: E.Vector) => \refl(E.dot v w), idempotent := \fun (v: E.Vector) => \refl(v) };
\import At.OnProjection[P := identity].Rank[k := m] \as Rank;
\definition basis: Rank.Basis := Rank.Basis { value := Eigen.identity, coordinate := Eigen.identity, leftInverse := \fun (v: E.Vector) => \refl(v), reconstruction := \fun (v: E.Vector) => \refl(v) };
\import \root.Complex[n := m, k := m] \as OldFull;
\import OldFull.Model[] \as FullModel;
\definition full: FullModel.Carrier := FullModel.fromOriginal (\into[At.Projection](identity, OldFull.points) \by { \exact(basis, Rank.Basis) });
