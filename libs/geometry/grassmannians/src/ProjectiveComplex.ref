\import std.Data[].Nat[] \as N;
\import hermitian_frames.Hermitian[] \as H;
\import complex.Complex[] \as C;
\import \root.Complex[n := n, k := N.Nat^::succ N.Nat^::zero] \as G;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := H.Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition Space: \Set := G.Grassmannian;
\definition topology: topology.Topology[Carrier := Space].Topology := G.topology;
\definition Line[p: Space]: \Set := G.Fiber p;
\definition lineBundle: Bundles.Family[X := Space, F := Line].Bundle := G.bundle;
\definition Complement[p: Space]: \Set := G.ComplementFiber p;
\definition complementBundle: Bundles.Family[X := Space, F := Complement].Bundle := G.complementBundle;
