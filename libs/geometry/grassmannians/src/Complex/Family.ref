\definition map[y: Y]: Grassmannian := \into[At.Projection](P y, points) \by { rank y };
\import Matrices.Universal[A := Y] \as MatrixMaps;
\import Induced.Universal[Z := Y] \as Into;
\definition continuous: topology.Continuity[A := Y, B := Grassmannian].Continuous source topology map :=
  Into.continuous source (Matrices.topology H.Complex[].topological.space) entries map
    (MatrixMaps.continuous source H.Complex[].topological.space (\fun (y: Y) => entries (map y))
      (\fun (i, j: Fin.Fin n) => regularP (E.basis j) i));
\import \parent.Pullback[Y := Y, source := source, f := map, continuous := continuous] \as Pullback;
