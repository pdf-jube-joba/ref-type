\import At.OnProjection[P := p].Rank[k := k] \as OldRank;
\import At.OnProjection[P := asProjection p.map p.selfAdjoint p.idempotent].Rank[k := k] \as NewRank;
\definition rank: NewRank.HasRank := \block {
  \takefrom b: OldRank.Basis \by \bysub(At.Projection, Original.points, p) \then
  \return \exact(NewRank.Basis { value := b.value, coordinate := b.coordinate, leftInverse := b.leftInverse, reconstruction := b.reconstruction }, NewRank.Basis)
};
