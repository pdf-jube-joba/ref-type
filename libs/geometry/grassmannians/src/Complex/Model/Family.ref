\import Original.Family[Y := Y, source := source, P := P, regularP := regularP, rank := rankP] \as OriginalFamily;
\definition map[y: Y]: Carrier := fromOriginal (OriginalFamily.map y);
\definition continuous: topology.Continuity[A := Y, B := Carrier].Continuous source topology map :=
  topology.Composition[A := Y, B := Original.Grassmannian, C := Carrier].composeContinuous source Original.topology topology OriginalFamily.map fromOriginal OriginalFamily.continuous fromOriginalContinuous;
\import \parent.Pullback[Y := Y, source := source, f := map, continuous := continuous] \as Natural;
\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := H.Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Projection[X := Y, n := n, baseSpace := source, P := P, regular := regularP] \as Actual;
\import UniversalBundle.Pullback[Y := Y, source := source, f := map, regularBase := continuous] \as Pullback;
\definition isomorphism: Bundles.Isomorphisms[X := Y, F := \fun (y: Y) => Fiber (map y), G := Actual.Fiber, source := Pullback.firstBundle, target := Actual.bundle].Isomorphism := Natural.isomorphism;
