\definition evaluate[p: Carrier]: C.Complex := entries p i j;
\definition continuous: topology.Continuity[A := Carrier, B := C.Complex].Continuous topology H.Complex[].topological.space evaluate :=
  topology.Composition[A := Carrier, B := Matrices.Carrier, C := C.Complex].composeContinuous topology (Matrices.topology H.Complex[].topological.space) H.Complex[].topological.space entries (Matrices.entry i j) entriesContinuous (Matrices.entryContinuous H.Complex[].topological.space i j);
\import uniform_approximation.Approximation[].Separation[].Pullback[A := Carrier, B := C.Complex, source := topology, target := H.Complex[].topological.space, f := evaluate, continuous := continuous] \as Pullback;
\definition separate: \forall (p, q: Carrier) -> Logic.Not (entries p i j = entries q i j) -> \exists (U: \Pow Carrier \where Space.RegularChoice[topology, Space.Singleton q, p, U]) := Pullback.separate separated;
