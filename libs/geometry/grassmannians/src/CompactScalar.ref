\import real.Analysis[] \as R;
\import complex.Complex[] \as C;
\import metric_spaces.RealLine[] \as Line;
\import topology.Topology[Carrier := R.Real] \as RealSpace;
\import topology.Topology[Carrier := C.Complex] \as ComplexSpace;
\import topological_constructions.Product[A := R.Real, B := R.Real] \as Product;
\import Product.Compactness[] \as ProductCompact;
\definition realBox: \Pow R.Real := Line.ClosedInterval (R.neg R.one) R.one;
\definition realCompact: RealSpace.IsCompactIn Line.topology realBox := Line.CompactIntervals[].intervalCompact (R.neg R.one) R.one;
\definition complexBox: \Pow C.Complex := Product.Rectangle realBox realBox;
\definition complexCompact: ComplexSpace.IsCompactIn topological_algebra.Complex[].topology complexBox :=
  ProductCompact.productCompactIn Line.topology Line.topology realBox realBox realCompact realCompact;
