\import Tautological.Pullback[Y := Y, source := source, f := f, regularBase := continuous] \as Natural;
\definition isomorphism: Bundles.Isomorphisms[X := Y, F := \fun (y: Y) => Fiber (f y), G := \fun (y: Y) => Fiber (f y), source := Natural.firstBundle, target := Natural.secondBundle].Isomorphism := Natural.isomorphism;
