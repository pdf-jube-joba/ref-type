\definition evaluate[p: Carrier]: R.Real := entries p i j;
\definition continuous: topology.Continuity[A := Carrier, B := R.Real].Continuous topology H.Real[].topological.space evaluate :=
  topology.Composition[A := Carrier, B := Matrices.Carrier, C := R.Real].composeContinuous topology (Matrices.topology H.Real[].topological.space) H.Real[].topological.space entries (Matrices.entry i j) entriesContinuous (Matrices.entryContinuous H.Real[].topological.space i j);
\import topological_constructions.Separation[].Pullback[A := Carrier, B := R.Real, source := topology, target := H.Real[].topological.space, f := evaluate, continuous := continuous] \as Pullback;
\definition separate: \forall (p, q: Carrier) -> Logic.Not (entries p i j = entries q i j) -> \exists (U: \Pow Carrier \where Space.RegularChoice[topology, Space.Singleton q, p, U]) := Pullback.separate separated;
