\import Spaces.Coordinates[I := Fin.Fin r].Kronecker[] \as Delta;
\import At.Families[X := R.Real].Matrix[m := r] \as Matrices;
\definition coordinateFormula: \forall (i: Fin.Fin r)(j: Fin.Fin n) -> (b.basis.coordinate.apply (E.basis j)) i = H.Real[].scalar.conjugate (b.basis.value.apply (Domain.basis i) j) :=
  \fun (i: Fin.Fin r)(j: Fin.Fin n) => trans!{R.Real} _ _ _ (sym!{R.Real} _ _ (Domain.dotBasis i (b.basis.coordinate.apply (E.basis j))))
    (trans!{R.Real} _ _ _ (sym!{R.Real} _ _ (b.adjoint (Domain.basis i) (E.basis j)))
      (trans!{R.Real} _ _ _ (E.symmetric (b.basis.value.apply (Domain.basis i)) (E.basis j))
        (congr!{R.Real R.Real} H.Real[].scalar.conjugate _ _ (E.dotBasis j (b.basis.value.apply (Domain.basis i))))));
\definition diagonal: \forall (j: Fin.Fin n) -> P.map.apply (E.basis j) j =
  Sums.sum r (\fun (i: Fin.Fin r) => Spaces.mul (H.Real[].scalar.conjugate (b.basis.value.apply (Domain.basis i) j)) (b.basis.value.apply (Domain.basis i) j)) :=
  \fun (j: Fin.Fin n) => trans!{R.Real} _ _ _
    (congr!{{E.Vector} R.Real} (\fun (v: E.Vector) => v j) _ _ (sym!{{E.Vector}} _ _ (b.basis.reconstruction (E.basis j))))
    (trans!{R.Real} _ _ _ (Matrices.Expansion[A := b.basis.value, v := b.basis.coordinate.apply (E.basis j), i := j].formula)
      (Sums.congruent r _ _ (\fun (i: Fin.Fin r) => congr!{R.Real R.Real} (\fun (c: R.Real) => Spaces.mul c (b.basis.value.apply (Domain.basis i) j)) _ _ (coordinateFormula i j))));
\definition traceFormula: trace P = count r := trans!{R.Real} _ _ _ (Sums.congruent n _ _ diagonal)
  (trans!{R.Real} _ _ _ (Sums.exchange n r (\fun (j: Fin.Fin n)(i: Fin.Fin r) => Spaces.mul (H.Real[].scalar.conjugate (b.basis.value.apply (Domain.basis i) j)) (b.basis.value.apply (Domain.basis i) j)))
    (Sums.congruent r _ (\fun (_: Fin.Fin r) => Spaces.one) (\fun (i: Fin.Fin r) => trans!{R.Real} _ _ _ (b.isometry (Domain.basis i) (Domain.basis i))
      (trans!{R.Real} _ _ _ (Domain.dotBasis i (Domain.basis i)) (Delta.self i)))));
