\import Geometry.Finite[n := r] \as Domain;
\import At.OnProjection[P := P].Rank[k := r] \as Rank;
\module With(b: Rank.Frame);
\definition rankTrace: Rank.HasRank -> trace P = count r := \block {
  \fun (rank: Rank.HasRank) \then
  \takefrom b: Rank.Frame \by Rank.frameExists rank \then
  \return With[b := b].traceFormula
};
