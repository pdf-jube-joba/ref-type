\import std.Logic[].Equality[] \as Eq;
\use Eq.sym;
\use Eq.trans;
\use Eq.congr;
\import Spaces.Linear[V := Domain.Vector, W := Domain.Vector, source := Domain.space, target := Domain.space] \as Small;
\import Small.Composition[U := Domain.Vector, domain := Domain.space] \as Compose;
\import Spaces.Linear[V := Domain.Vector, W := E.Vector, source := Domain.space, target := E.space].Composition[U := Domain.Vector, domain := Domain.space] \as ToAmbient;
\import Spaces.Linear[V := E.Vector, W := Domain.Vector, source := E.space, target := Domain.space].Composition[U := Domain.Vector, domain := Domain.space] \as ToSmall;
\import linear_algebra.Hermitian[].Over[K := R.Real, field := R.Algebra[].field, scalar := H.Real[].scalar].Inner[V := E.Vector, space := E.space].Of[h := E.form] \as Inner;
\import H.Over[K := R.Real, field := R.Algebra[].field, scalar := H.Real[].scalar, topological := H.Real[].topological].At[n := k] \as SmallAt;
\import SmallAt.Square[] \as Square;
\definition coordinateMap: Small.Map := ToSmall.compose (Ortho.Point[x := t].basis).coordinate center.value;
\definition D: Small.Map := ToSmall.compose center.coordinate (factors.value t).frame;
\definition dLeft: \forall (v: Domain.Vector) -> D.apply ((factors.value t).change.forward.apply v) = v :=
  \fun (v: Domain.Vector) => trans!{{Domain.Vector}} _ _ _
    (congr!{{E.Vector} {Domain.Vector}} center.coordinate.apply _ _ (sym!{{E.Vector}} _ _ ((factors.value t).formula v))) (centerFormula t v);
\definition dRight: \forall (v: Domain.Vector) -> (factors.value t).change.forward.apply (D.apply v) = v :=
  Square.leftInverseRight (factors.value t).change.forward D dLeft;
\definition baseProjectionZero: \forall (v: Domain.Vector) -> (Model.projection a).map.apply (t.apply v) = E.space.zero :=
  \fun (v: Domain.Vector) => trans!{{E.Vector}} _ _ _ (sym!{{E.Vector}} _ _ (center.reconstruction (t.apply v)))
    (trans!{{E.Vector}} _ _ _ (congr!{{Domain.Vector} {E.Vector}} center.value.apply _ _ (zeroCondition t v)) center.value.preservesZero);
\definition orthogonal: \forall (v, w: Domain.Vector) -> E.dot (center.value.apply v) (t.apply w) = R.Algebra[].field.zero :=
  \fun (v, w: Domain.Vector) => trans!{R.Real} _ _ _
    (congr!{{E.Vector} R.Real} (\fun (u: E.Vector) => E.dot u (t.apply w)) _ _ (sym!{{E.Vector}} _ _ (At.OnProjection[P := Model.projection a].Rank[k := k].fixed center v)))
    (trans!{R.Real} _ _ _ ((Model.projection a).selfAdjoint (center.value.apply v) (t.apply w))
      (trans!{R.Real} _ _ _ (congr!{{E.Vector} R.Real} (E.dot (center.value.apply v)) _ _ (baseProjectionZero w)) (E.form.zeroRight (center.value.apply v))));
\definition projectionCenterZero: \forall (v: Domain.Vector) -> coordinateMap.apply v = Domain.space.zero -> (Ortho.projection t).map.apply (center.value.apply v) = E.space.zero :=
  \fun (v: Domain.Vector)(zero: _) => trans!{{E.Vector}} _ _ _ (sym!{{E.Vector}} _ _ ((Ortho.Point[x := t].basis).reconstruction (center.value.apply v)))
    (trans!{{E.Vector}} _ _ _ (congr!{{Domain.Vector} {E.Vector}} (factors.value t).frame.apply _ _ zero) (factors.value t).frame.preservesZero);
\import At.OnProjection[P := Ortho.projection t].Rank[k := k] \as PointRank;
\definition fixedGraph: \forall (v: Domain.Vector) -> (Ortho.projection t).map.apply ((family t).apply v) = (family t).apply v :=
  \fun (v: Domain.Vector) => trans!{{E.Vector}} _ _ _
    (congr!{{E.Vector} {E.Vector}} (Ortho.projection t).map.apply _ _ ((factors.value t).formula v))
    (trans!{{E.Vector}} _ _ _ (PointRank.fixed (Ortho.Point[x := t].basis) ((factors.value t).change.forward.apply v))
      (sym!{{E.Vector}} _ _ ((factors.value t).formula v)));
\definition cZero: \forall (v: Domain.Vector) -> coordinateMap.apply v = Domain.space.zero -> v = Domain.space.zero := \block {
  \fun (v: Domain.Vector)(zero: coordinateMap.apply v = Domain.space.zero) \then
  \let dotZero: E.dot (center.value.apply v) ((family t).apply v) = R.Algebra[].field.zero :=
    trans!{R.Real} _ _ _ (congr!{{E.Vector} R.Real} (E.dot (center.value.apply v)) _ _ (sym!{{E.Vector}} _ _ (fixedGraph v)))
      (trans!{R.Real} _ _ _ (sym!{R.Real} _ _ ((Ortho.projection t).selfAdjoint (center.value.apply v) ((family t).apply v)))
        (trans!{R.Real} _ _ _ (congr!{{E.Vector} R.Real} (\fun (u: E.Vector) => E.dot u ((family t).apply v)) _ _ (projectionCenterZero v zero)) (Inner.zeroLeft ((family t).apply v)))) \then
  \let dotGraph: E.dot (center.value.apply v) ((family t).apply v) = E.dot (center.value.apply v) (center.value.apply v) :=
    trans!{R.Real} _ _ _ (E.form.addRight (center.value.apply v) (center.value.apply v) (t.apply v))
      (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (Spaces.add (E.dot (center.value.apply v) (center.value.apply v))) _ _ (orthogonal v v))
        (Spaces.addZeroRight (E.dot (center.value.apply v) (center.value.apply v)))) \then
  \let baseZero: center.value.apply v = E.space.zero := E.positive.definite (center.value.apply v) (trans!{R.Real} _ _ _ (sym!{R.Real} _ _ dotGraph) dotZero) \then
  \return trans!{{Domain.Vector}} _ _ _ (sym!{{Domain.Vector}} _ _ (center.leftInverse v))
    (trans!{{Domain.Vector}} _ _ _ (congr!{{E.Vector} {Domain.Vector}} center.coordinate.apply _ _ baseZero) center.coordinate.preservesZero)
};
\definition cInjective: \forall (v, w: Domain.Vector) -> coordinateMap.apply v = coordinateMap.apply w -> v = w := Small.injectiveOfZeroKernel coordinateMap cZero;

\import linear_algebra.Hermitian[].Over[K := R.Real, field := R.Algebra[].field, scalar := H.Real[].scalar].Inner[V := Domain.Vector, space := Domain.space].Of[h := Domain.form].Gram[k := k] \as Gram;
\import SmallAt.Forms[h := Domain.form].Gram[k := k] \as GramExistence;
\definition domainMember: \In[Model.Carrier] domain (value t) := \block {
  \takefrom factor: Gram.Factorization[coordinateMap] \by GramExistence.exists coordinateMap cInjective Domain.positive \then
  \let inverse: Small.Map := Gram.Of[A := coordinateMap, factor := factor].inverse \then
  \let back: Small.Map := Compose.compose inverse (factors.value t).change.forward \then
  \let forward: Small.Map := Old.comparison (toOriginal (value t)) \then
  \let left: \forall (v: Domain.Vector) -> back.apply (forward.apply v) = v := \fun (v: Domain.Vector) =>
    trans!{{Domain.Vector}} _ _ _ (congr!{{Domain.Vector} {Domain.Vector}} inverse.apply _ _ (dRight (coordinateMap.apply v))) (Gram.Of[A := coordinateMap, factor := factor].inverseOnImage v) \then
  \return Square.LeftInverse[f := forward, g := back, left := left].nonzero
};
