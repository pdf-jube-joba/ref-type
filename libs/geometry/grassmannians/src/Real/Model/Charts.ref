\import std.Logic[].Proposition[] \as Logic;
\import H.Over[K := R.Real, field := R.Algebra[].field, scalar := H.Real[].scalar, topological := H.Real[].topological].At[n := n] \as Native;
\definition exists: \forall (a: Carrier) -> \exists (center: Native.OnProjection[P := projection a].Rank[k := k].Basis \where
  \exists \root.Real[n := n, k := k].Model[].Graph[a := a, center := center].Reconstruction[].ChartHomeomorphism) := \block {
  \fun (a: Carrier) \then
  \takefrom center: Native.OnProjection[P := projection a].Rank[k := k].Basis \by rank a \then
  \return Logic.existsIntro[Native.OnProjection[P := projection a].Rank[k := k].Basis,
    { center: Native.OnProjection[P := projection a].Rank[k := k].Basis \where \exists \root.Real[n := n, k := k].Model[].Graph[a := a, center := center].Reconstruction[].ChartHomeomorphism }]
    center \root.Real[n := n, k := k].Model[].Graph[a := a, center := center].Reconstruction[].homeomorphismExists
};
