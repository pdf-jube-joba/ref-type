\import std.Data[].Nat[] \as N;
\import \root.Real[n := N.Nat^::zero, k := N.Nat^::zero] \as RealZero;
\import \root.Complex[n := N.Nat^::zero, k := N.Nat^::zero] \as ComplexZero;
\definition realZeroSpace: \Set := RealZero.Grassmannian;
\definition complexZeroSpace: \Set := ComplexZero.Grassmannian;
\import std.Alg[].Field[] \as Fields;
\import hermitian_frames.Hermitian[] \as H;

\import real.Analysis[] \as R;
\import linear_algebra.Hermitian[].Over[K := R.Real, field := R.Algebra[].field, scalar := H.Real[].scalar].Finite[n := N.Nat^::zero] \as RealE;
\import linear_algebra.Commutative[K := R.Real, scalarRing := Fields.fieldAsCommutativeRing R.Real R.Algebra[].field].Eigen[V := RealE.Vector, space := RealE.space] \as RealEigen;
\import H.Over[K := R.Real, field := R.Algebra[].field, scalar := H.Real[].scalar, topological := H.Real[].topological].At[n := N.Nat^::zero] \as RealAt;
\definition realProjection: RealAt.Projection := RealAt.Projection { map := RealEigen.identity, selfAdjoint := \fun (v, w: RealAt.Vector) => \refl(RealAt.dot v w), idempotent := \fun (v: RealAt.Vector) => \refl(v) };
\import RealAt.OnProjection[P := realProjection].Rank[k := N.Nat^::zero] \as RealRank;
\definition realBasis: RealRank.Basis := RealRank.Basis { value := RealEigen.identity, coordinate := RealEigen.identity, leftInverse := \fun (v: RealAt.Vector) => \refl(v), reconstruction := \fun (v: RealAt.Vector) => \refl(v) };
\definition realPoint: RealZero.Grassmannian := \into[RealAt.Projection](realProjection, RealZero.Grassmannian) \by { \exact(realBasis, RealRank.Basis) };

\import complex.Complex[] \as C;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := H.Complex[].scalar].Finite[n := N.Nat^::zero] \as ComplexE;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := Fields.fieldAsCommutativeRing C.Complex C.Algebra[].field].Eigen[V := ComplexE.Vector, space := ComplexE.space] \as ComplexEigen;
\import H.Over[K := C.Complex, field := C.Algebra[].field, scalar := H.Complex[].scalar, topological := H.Complex[].topological].At[n := N.Nat^::zero] \as ComplexAt;
\definition complexProjection: ComplexAt.Projection := ComplexAt.Projection { map := ComplexEigen.identity, selfAdjoint := \fun (v, w: ComplexAt.Vector) => \refl(ComplexAt.dot v w), idempotent := \fun (v: ComplexAt.Vector) => \refl(v) };
\import ComplexAt.OnProjection[P := complexProjection].Rank[k := N.Nat^::zero] \as ComplexRank;
\definition complexBasis: ComplexRank.Basis := ComplexRank.Basis { value := ComplexEigen.identity, coordinate := ComplexEigen.identity, leftInverse := \fun (v: ComplexAt.Vector) => \refl(v), reconstruction := \fun (v: ComplexAt.Vector) => \refl(v) };
\definition complexPoint: ComplexZero.Grassmannian := \into[ComplexAt.Projection](complexProjection, ComplexZero.Grassmannian) \by { \exact(complexBasis, ComplexRank.Basis) };
\module RealIdentity(n: N.Nat^);
\module ComplexIdentity(n: N.Nat^);
\import RealIdentity[n := N.Nat^::succ N.Nat^::zero] \as RealOne;
\import ComplexIdentity[n := N.Nat^::succ N.Nat^::zero] \as ComplexOne;
\definition realProjectivePoint: \root.ProjectiveReal[n := N.Nat^::succ N.Nat^::zero].Space := RealOne.point;
\definition complexProjectivePoint: \root.ProjectiveComplex[n := N.Nat^::succ N.Nat^::zero].Space := ComplexOne.point;
