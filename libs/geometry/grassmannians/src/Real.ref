\import hermitian_frames.Hermitian[] \as H;
\import real.Analysis[] \as R;
\import H.Over[K := R.Real, field := R.Algebra[].field, scalar := H.Real[].scalar, topological := H.Real[].topological].At[n := n] \as At;
\definition points: \Pow At.Projection := { p: At.Projection \where At.OnProjection[P := p].Rank[k := k].HasRank };
\definition Grassmannian: \Set := \Cast[At.Projection] points;
