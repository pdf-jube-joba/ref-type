\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[].Sum[m := n, n := k] \as Indices;
\definition ambientDimension: N.Nat^ := Indices.total;
\import manifolds.Dimension[n := n].Smooth[] \as Models;
\import manifolds.Dimension[n := ambientDimension].Examples[].Euclidean[] \as EuclideanManifold;
\import manifolds.Dimension[n := ambientDimension].Smooth[] \as AmbientModels;
\definition ambient: AmbientModels.Manifold := EuclideanManifold.smoothManifold;
\import manifolds.Immersion[n := n, m := ambientDimension] \as Immersions;
\module On(M: Models.Manifold);
