\definition x: Mprime.Point := manifolds.SmoothMap[n := n, m := n].Between[M := M, N := Mprime].apply h.backward p.base;
\definition moved: Target.Fiber (BaseMaps.apply h.forward x) := \into[E.Vector](p.vector, (Target.At[x := BaseMaps.apply h.forward x].subspace).carrier) \by {
  \idelim p.base = BaseMaps.apply h.forward x \with y: M.Point => \forall (v: TargetTangent.Vector y) -> E.dot p.vector (Target.At[x := y].differential.apply v) = R.zero \by {
    base: \bysub(E.Vector, (Target.At[x := p.base].subspace).carrier, p.vector), equality: sym!{{M.Point}} _ _ ((Diffeomorphisms.laws h).rightInverse p.base)
  }
};
\definition value: Source.Fiber x := \parent.At[x := x].pull moved;
