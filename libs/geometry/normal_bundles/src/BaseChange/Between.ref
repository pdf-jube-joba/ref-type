\import manifolds.Immersion[n := n, m := ambientDimension].Between[M := M, N := ambient] \as Immersions;
\import manifolds.Immersion[n := n, m := ambientDimension].Between[M := Mprime, N := ambient] \as CompositeImmersions;
\import manifolds.SmoothMap[n := n, m := n].Between[M := Mprime, N := M] \as BaseMaps;
\import manifolds.SmoothMap[n := n, m := ambientDimension].Between[M := M, N := ambient] \as AmbientMaps;
\import manifolds.SmoothMap[n := n, m := ambientDimension].Between[M := Mprime, N := ambient] \as CompositeMaps;
\import manifolds.Diffeomorphism[n := n, m := n].Between[M := Mprime, N := M] \as Diffeomorphisms;
\module Of(i: Immersions.Immersion, h: Diffeomorphisms.Diffeomorphism);
