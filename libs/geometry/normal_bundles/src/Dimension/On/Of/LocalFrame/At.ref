\import Spaces.Linear[V := Fiber x, W := NormalVectors.Vector, source := fiberSpace x, target := NormalVectors.space] \as Forward;
\import Spaces.Linear[V := NormalVectors.Vector, W := Fiber x, source := NormalVectors.space, target := fiberSpace x] \as Backward;
\import Spaces.Isomorphism[V := Fiber x, W := NormalVectors.Vector, source := fiberSpace x, target := NormalVectors.space] \as Isomorphisms;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (w: Fiber x) => (local.encode x).apply w,
  preservesAdd := \fun (v, w: Fiber x) => (local.encode x).preservesAdd v w,
  preservesScale := \fun (a: R.Real)(w: Fiber x) => (local.encode x).preservesScale a w,
};
\definition backward: Backward.Map := Backward.Map {
  apply := \fun (v: NormalVectors.Vector) => \into[E.Vector]((local.decode x).apply v, (\parent.\parent.At[x := x].subspace).carrier) \by { local.image x v },
  preservesAdd := \fun (v, w: NormalVectors.Vector) => (local.decode x).preservesAdd v w,
  preservesScale := \fun (a: R.Real)(w: NormalVectors.Vector) => (local.decode x).preservesScale a w,
};
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := \fun (w: Fiber x) => local.reconstruction x w,
  rightInverse := \fun (v: NormalVectors.Vector) => local.leftInverse x v,
};
