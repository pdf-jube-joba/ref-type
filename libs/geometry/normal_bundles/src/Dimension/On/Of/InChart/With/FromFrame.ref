\definition neighborhood: Open.OpenSet := normal.neighborhood.domain;
\definition input[u: Open.Carrier neighborhood]: Open.Carrier domain := Open.inclusion neighborhood domain normal.neighborhood.included u;
\import manifolds.ChartRestriction[n := n].On[M := M].At[c := chart, U := neighborhood, included := normal.neighborhood.included] \as Final;
\definition baseChart: Chart := Final.chart;
\definition decode[u: Open.Carrier neighborhood]: Decoders.Map := (normal.frame.value u).value;
\definition encode[u: Open.Carrier neighborhood]: Encoders.Map := (normal.frame.value u).coordinate;
\import NormalFrames.Frames[k := k, U := neighborhood, P := \fun (u: Open.Carrier neighborhood) => Projections.normal (input u)] \as Framed;
\definition decodeRegular: DecodeMatrix.Regular neighborhood decode := normal.frame.regular;
\definition encodeRegular: EncodeMatrix.Regular neighborhood encode := Framed.coordinates normal.frame;
\module AtBase(x: Charts.LocalPoint baseChart);
\module Coefficients;
\definition local: Local := Local {
  chart := baseChart,
  decode := \fun (x: Charts.LocalPoint baseChart) => decode (Charts.coordinate baseChart x),
  encode := \fun (x: Charts.LocalPoint baseChart) => encode (Charts.coordinate baseChart x),
  isometry := \fun (x: Charts.LocalPoint baseChart) => AtBase[x := x].isometry,
  leftInverse := \fun (x: Charts.LocalPoint baseChart) => (normal.frame.value (Charts.coordinate baseChart x)).leftInverse,
  image := \fun (x: Charts.LocalPoint baseChart) => AtBase[x := x].image,
  reconstruction := \fun (x: Charts.LocalPoint baseChart) => AtBase[x := x].reconstruction,
  decodeSmooth := Coefficients[].decodeSmooth, encodeSmooth := Coefficients[].encodeSmooth,
};
\definition contains: Charts.Contains local.chart (Charts.point chart a) := Final.pointMember
  (\into[BaseCoordinates.Point](a, neighborhood.points) \by { normal.contains });
