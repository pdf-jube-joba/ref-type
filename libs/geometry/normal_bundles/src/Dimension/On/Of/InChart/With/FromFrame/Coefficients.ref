\definition decodeFormula: \forall (i: Fin.Fin ambientDimension)(j: Fin.Fin k) ->
  (\fun (u: Open.Carrier neighborhood) => (decode (Charts.coordinate baseChart (Charts.point baseChart u))).apply (NormalVectors.basis j) i) =
  (\fun (u: Open.Carrier neighborhood) => (decode u).apply (NormalVectors.basis j) i) :=
  \fun (i: Fin.Fin ambientDimension)(j: Fin.Fin k) => \axiom:funext(
    (\fun (u: Open.Carrier neighborhood) => (decode (Charts.coordinate baseChart (Charts.point baseChart u))).apply (NormalVectors.basis j) i),
    (\fun (u: Open.Carrier neighborhood) => (decode u).apply (NormalVectors.basis j) i),
    \fun (u: Open.Carrier neighborhood) => congr!{{Open.Carrier neighborhood} {R.Real}} (\fun (v: Open.Carrier neighborhood) => (decode v).apply (NormalVectors.basis j) i) _ _ (Charts.Of[chart := baseChart].coordinatePoint u));
\definition encodeFormula: \forall (i: Fin.Fin k)(j: Fin.Fin ambientDimension) ->
  (\fun (u: Open.Carrier neighborhood) => (encode (Charts.coordinate baseChart (Charts.point baseChart u))).apply (E.basis j) i) =
  (\fun (u: Open.Carrier neighborhood) => (encode u).apply (E.basis j) i) :=
  \fun (i: Fin.Fin k)(j: Fin.Fin ambientDimension) => \axiom:funext(
    (\fun (u: Open.Carrier neighborhood) => (encode (Charts.coordinate baseChart (Charts.point baseChart u))).apply (E.basis j) i),
    (\fun (u: Open.Carrier neighborhood) => (encode u).apply (E.basis j) i),
    \fun (u: Open.Carrier neighborhood) => congr!{{Open.Carrier neighborhood} {R.Real}} (\fun (v: Open.Carrier neighborhood) => (encode v).apply (E.basis j) i) _ _ (Charts.Of[chart := baseChart].coordinatePoint u));
\definition decodeSmooth: DecodeMatrix.Regular neighborhood (\fun (u: Open.Carrier neighborhood) => decode (Charts.coordinate baseChart (Charts.point baseChart u))) :=
  \fun (i: Fin.Fin ambientDimension)(j: Fin.Fin k) => \idelim
    (\fun (u: Open.Carrier neighborhood) => (decode u).apply (NormalVectors.basis j) i) =
    (\fun (u: Open.Carrier neighborhood) => (decode (Charts.coordinate baseChart (Charts.point baseChart u))).apply (NormalVectors.basis j) i)
    \with f: Open.ScalarFunction neighborhood => Open.Smooth[].SmoothOn neighborhood f \by {
      base: decodeRegular i j, equality: sym!{{Open.ScalarFunction neighborhood}} _ _ (decodeFormula i j)
    };
\definition encodeSmooth: EncodeMatrix.Regular neighborhood (\fun (u: Open.Carrier neighborhood) => encode (Charts.coordinate baseChart (Charts.point baseChart u))) :=
  \fun (i: Fin.Fin k)(j: Fin.Fin ambientDimension) => \idelim
    (\fun (u: Open.Carrier neighborhood) => (encode u).apply (E.basis j) i) =
    (\fun (u: Open.Carrier neighborhood) => (encode (Charts.coordinate baseChart (Charts.point baseChart u))).apply (E.basis j) i)
    \with f: Open.ScalarFunction neighborhood => Open.Smooth[].SmoothOn neighborhood f \by {
      base: encodeRegular i j, equality: sym!{{Open.ScalarFunction neighborhood}} _ _ (encodeFormula i j)
    };
