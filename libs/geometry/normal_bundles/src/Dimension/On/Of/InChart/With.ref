\import Rank.Projections[A := matrix, factors := factors] \as Projections;
\import calculus.ProjectionFrames[d := n, q := ambientDimension] \as NormalFrames;
\module At(u: Open.Carrier domain);
\definition normalRank: \forall (u: Open.Carrier domain) -> E.trace (Projections.normal u) = E.naturalCount k := \fun (u: Open.Carrier domain) => At[u := u].rank;
\module FromFrame(a: Open.Carrier domain, normal: NormalFrames.Local[k, domain, Projections.normal, a]);
\definition exists: \forall (a: Open.Carrier domain) -> \exists ( patch: Local \where Charts.Contains patch.chart (Charts.point chart a) ) := \block {
  \fun (a: Open.Carrier domain) \then
  \takefrom normal: NormalFrames.Local[k, domain, Projections.normal, a] \by NormalFrames.exists k domain Projections.normal Projections.normalRegular normalRank a \then
  \return Logic.existsIntro[Local, { patch: Local \where Charts.Contains patch.chart (Charts.point chart a) }]
    (FromFrame[a := a, normal := normal].local) (FromFrame[a := a, normal := normal].contains)
};
