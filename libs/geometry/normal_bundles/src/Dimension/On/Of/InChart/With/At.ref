\import E.Gram[k := n].Of[A := matrix u, factor := factors.value u] \as Algebra;
\definition rank: E.trace (Projections.normal u) = E.naturalCount k := trans!{{R.Real}} _ _ _ Algebra.normalTrace
  (trans!{{R.Real}} _ _ _
    (congr!{std.Data[].Nat[].Nat^ {R.Real}} (\fun (d: std.Data[].Nat[].Nat^) => R.sub (E.naturalCount d) (E.naturalCount n)) _ _ (std.Data[].Nat[].Basic[].Prop[].addComm k n))
    (linear_algebra.Real[].Dimension[].difference n k));
