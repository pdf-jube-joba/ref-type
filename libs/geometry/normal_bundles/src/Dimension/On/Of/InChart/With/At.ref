\use std.Logic[].Equality[].eq_reason_in;
\import E.Gram[k := n].Of[A := matrix u, factor := factors.value u] \as Algebra;
\definition rank: E.trace (Projections.normal u) = E.naturalCount k := eq_reason_in!{{R.Real} _
  "=" _ "by" Algebra.normalTrace
  "=" _ "by" { congr!{std.Data[].Nat[].Nat^ {R.Real}} (\fun (d: std.Data[].Nat[].Nat^) => R.sub (E.naturalCount d) (E.naturalCount n)) _ _ (std.Data[].Nat[].Basic[].Prop[].addComm k n) }
  "=" _ "by" { linear_algebra.Real[].Dimension[].difference n k }
};
