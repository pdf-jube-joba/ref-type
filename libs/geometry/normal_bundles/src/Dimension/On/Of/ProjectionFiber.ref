\import Family.Fiber[x := x] \as Literal;
\definition Carrier: \Set := Literal.Carrier;
\definition vectorSpace: Spaces.VectorSpace Carrier := Literal.vectorSpace;
\definition isomorphism: Spaces.Isomorphism[V := Carrier, W := Fiber x, source := vectorSpace, target := fiberSpace x].Isomorphism := Literal.isomorphism;
\definition include[w: Fiber x]: Carrier := Literal.encode w;
\definition inverseFormula: \forall (w: Fiber x) -> isomorphism.backward.apply w = include w := Literal.inverseFormula;
