\import manifolds.SmoothMap[n := p, m := n].Between[M := X, N := M] \as BaseMaps;
\import manifolds.SmoothMap[n := p, m := ambientDimension].Between[M := X, N := ambient] \as VectorMaps;
\definition Normal[f: BaseMaps.Map][g: VectorMaps.Map]: \Prop := \forall (x: X.Point)(v: Tangent.Vector (BaseMaps.apply f x)) ->
  E.dot (VectorMaps.apply g x) (\parent.\parent.At[x := BaseMaps.apply f x].differential.apply v) = R.zero;
\module Of(f: BaseMaps.Map, g: VectorMaps.Map, normal: Normal f g);
