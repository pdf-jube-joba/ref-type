\import \parent.\parent.\parent.Splitting[] \as Split;
\import Split.Retraction[] \as Retraction;
\import tangent_bundles.Trivial[n := n, r := ambientDimension].On[M := M].Covered[I := Local, chart := \fun (patch: Local) => patch.chart, covers := covers] \as Trivial;
\definition apply[x: X.Point]: Point := include (BaseMaps.apply f x)
  (\into[E.Vector](VectorMaps.apply g x, (\parent.\parent.\parent.At[x := BaseMaps.apply f x].subspace).carrier) \by { normal x });
\import Trivial.Universal[p := p].From[X := X].Of[f := f, g := g] \as Pair;
\import manifolds.Composition[n := p, m := Split.dimension, l := ambientDimension].Between[M := X, N := Split.productManifold, P := manifold] \as Compose;
\definition raw: manifolds.SmoothMap[n := p, m := ambientDimension].Between[M := X, N := manifold].Map := Compose.compose Pair.map Retraction.retraction;
\import manifolds.SmoothMap[n := p, m := ambientDimension].Between[M := X, N := manifold] \as Maps;
\definition equality: Maps.apply raw = apply := \axiom:funext((Maps.apply raw), apply, \fun (x: X.Point) => Retraction.retracts (apply x));
\import Maps.Named[f := raw, function := apply, same := equality] \as Named;
\definition map: Maps.Map := Named.map;
\definition formula: Maps.apply map = apply := Named.formula;
