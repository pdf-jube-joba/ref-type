\definition field[x: M.Point]: Spaces.Linear[V := Sum.Fiber x, W := Fiber x, source := Sum.fiberSpace x, target := fiberSpace x].Map :=
  Spaces.Linear[V := Sum.Fiber x, W := Fiber x, source := Sum.fiberSpace x, target := fiberSpace x].Map {
    apply := std.Data[].Pair[].second (Tangent.Vector x) (Fiber x),
    preservesAdd := \fun (v, w: Sum.Fiber x) => \refl((fiberSpace x).add (std.Data[].Pair[].second (Tangent.Vector x) (Fiber x) v) (std.Data[].Pair[].second (Tangent.Vector x) (Fiber x) w)),
    preservesScale := \fun (a: R.Real)(v: Sum.Fiber x) => \refl((fiberSpace x).smul a (std.Data[].Pair[].second (Tangent.Vector x) (Fiber x) v)),
  };
\import SumAtlas.Morphism[s := k, G := Fiber, otherSpace := fiberSpace, otherFrame := normalFrame, field := field] \as Morphism;
\module Regular(patch: Local, a: Fin.Fin k, b: Fin.Fin ambientDimension);
\definition regular: Morphism.Regular := \fun (patch: Local)(a: Fin.Fin k)(b: Fin.Fin ambientDimension) => Regular[patch := patch, a := a, b := b].smooth;
\import Morphism.Build[firstChanges := SumConstruction.changes, secondChanges := changes, regular := regular] \as Construct;
\definition map: manifolds.SmoothMap[n := dimension, m := ambientDimension].Between[M := manifold, N := normalManifold].Map := Construct.map;
\definition apply: Point -> Family.Point := Construct.apply;
