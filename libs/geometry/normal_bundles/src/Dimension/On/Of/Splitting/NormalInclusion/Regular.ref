\import Spaces.CoordinateSum[n := n, m := k] \as Coordinates;
\definition vector: E.Vector := Coordinates.join SourceVectors.space.zero (NormalVectors.basis b);
\definition formula: \forall (u: Open.Carrier patch.chart.image) -> (Morphism.matrix patch u).apply (NormalVectors.basis b) a = vector a :=
  \fun (u: Open.Carrier patch.chart.image) => congr!{{E.Vector} {R.Real}} (\fun (v: E.Vector) => v a) _ _
    (congr!{{SourceVectors.Vector} {NormalVectors.Vector} {E.Vector}} Coordinates.join _ _ _ _
      (TangentBundle.Frames[].At[c := patch.chart, x := Charts.point patch.chart u].isomorphism.forward.preservesZero)
      ((Spaces.Isomorphism[V := Fiber (Charts.point patch.chart u), W := NormalVectors.Vector, source := fiberSpace (Charts.point patch.chart u), target := NormalVectors.space].laws (normalFrame patch (Charts.point patch.chart u))).rightInverse (NormalVectors.basis b)));
\definition smooth: Open.Smooth[].SmoothOn patch.chart.image (\fun (u: Open.Carrier patch.chart.image) => (Morphism.matrix patch u).apply (NormalVectors.basis b) a) :=
  \idelim (\fun (u: Open.Carrier patch.chart.image) => vector a) = (\fun (u: Open.Carrier patch.chart.image) => (Morphism.matrix patch u).apply (NormalVectors.basis b) a)
    \with f: Open.ScalarFunction patch.chart.image => Open.Smooth[].SmoothOn patch.chart.image f \by {
      base: Open.Smooth[].Operations[].constantSmooth patch.chart.image (vector a),
      equality: \axiom:funext((\fun (u: Open.Carrier patch.chart.image) => vector a), (\fun (u: Open.Carrier patch.chart.image) => (Morphism.matrix patch u).apply (NormalVectors.basis b) a),
        \fun (u: Open.Carrier patch.chart.image) => sym!{{R.Real}} _ _ (formula u))
    };
