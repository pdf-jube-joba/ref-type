\definition field[x: M.Point]: Spaces.Linear[V := Fiber x, W := Sum.Fiber x, source := fiberSpace x, target := Sum.fiberSpace x].Map :=
  Spaces.Linear[V := Fiber x, W := Sum.Fiber x, source := fiberSpace x, target := Sum.fiberSpace x].Map {
    apply := \fun (v: Fiber x) => std.Data[].Pair[].pair (Tangent.Vector x) (Fiber x) (Tangent.space x).zero v,
    preservesAdd := \fun (v, w: Fiber x) => std.Data[].Pair[].Prop[A := Tangent.Vector x, B := Fiber x].pairCong _ _ _ _
      (sym!{{Tangent.Vector x}} _ _ (Spaces.Laws[V := Tangent.Vector x, space := Tangent.space x].zeroLeft (Tangent.space x).zero)) (\refl((fiberSpace x).add v w)),
    preservesScale := \fun (a: R.Real)(v: Fiber x) => std.Data[].Pair[].Prop[A := Tangent.Vector x, B := Fiber x].pairCong _ _ _ _
      (sym!{{Tangent.Vector x}} _ _ (Spaces.Laws[V := Tangent.Vector x, space := Tangent.space x].scaleZero a)) (\refl((fiberSpace x).smul a v)),
  };
\import Atlas.Morphism[s := ambientDimension, G := Sum.Fiber, otherSpace := Sum.fiberSpace,
  otherFrame := \fun (patch: Local)(x: Charts.LocalPoint patch.chart) => Sum.At[i := patch, x := x].isomorphism, field := field] \as Morphism;
\module Regular(patch: Local, a: Fin.Fin ambientDimension, b: Fin.Fin k);
\definition regular: Morphism.Regular := \fun (patch: Local)(a: Fin.Fin ambientDimension)(b: Fin.Fin k) => Regular[patch := patch, a := a, b := b].smooth;
\import Morphism.Build[firstChanges := changes, secondChanges := SumConstruction.changes, regular := regular] \as Construct;
\definition map: manifolds.SmoothMap[n := ambientDimension, m := dimension].Between[M := normalManifold, N := manifold].Map := Construct.map;
\definition apply: Family.Point -> Point := Construct.apply;
