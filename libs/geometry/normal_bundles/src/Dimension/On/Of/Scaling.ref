\import Atlas.Scaling[changes := changes] \as Scaling;
\definition Domain: \Set := Scaling.Domain;
\import manifolds.Dimension[n := Scaling.sourceDimension].Smooth[] \as Models;
\definition domainManifold: Models.Manifold := Scaling.domainManifold;
\definition make[a: R.Real][x: M.Point][v: Fiber x]: Domain := Scaling.make a x v;
\definition apply: Domain -> Point := Scaling.apply;
\definition map: manifolds.SmoothMap[n := Scaling.sourceDimension, m := ambientDimension].Between[M := domainManifold, N := manifold].Map := Scaling.smoothMap;
