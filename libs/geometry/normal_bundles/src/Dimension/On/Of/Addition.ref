\import Atlas.Addition[changes := changes] \as Addition;
\definition Domain: \Set := Addition.Domain;
\import manifolds.Dimension[n := Addition.sourceDimension].Smooth[] \as Models;
\definition domainManifold: Models.Manifold := Addition.domainManifold;
\definition make[x: M.Point][v, w: Fiber x]: Domain := Addition.make x v w;
\definition apply: Domain -> Point := Addition.apply;
\definition map: manifolds.SmoothMap[n := Addition.sourceDimension, m := ambientDimension].Between[M := domainManifold, N := manifold].Map := Addition.smoothMap;
