\import \parent.Splitting[] \as Split;
\import Split.Retraction[] \as Retraction;
\import tangent_bundles.Trivial[n := n, r := ambientDimension].On[M := M].Covered[I := Local, chart := \fun (patch: Local) => patch.chart, covers := covers] \as Trivial;
\import Trivial.Vector[] \as Vector;
\import manifolds.Composition[n := ambientDimension, m := Split.dimension, l := ambientDimension].Between[M := manifold, N := Split.productManifold, P := ambient] \as Compose;
\import manifolds.SmoothMap[n := ambientDimension, m := ambientDimension].Between[M := manifold, N := ambient] \as Maps;
\definition raw: Maps.Map := Compose.compose Retraction.inclusion Vector.map;
\definition equality: Maps.apply raw = ambientVector := \axiom:funext((Maps.apply raw), ambientVector,
  \fun (p: Point) => congr!{{Split.ProductPoint} {E.Vector}} (\fun (q: Split.ProductPoint) => q.vector) _ _ (Retraction.inclusionFormula p));
\import Maps.Named[f := raw, function := ambientVector, same := equality] \as Named;
\definition map: Maps.Map := Named.map;
