\definition function: Open.Smooth[].SmoothFunction second.chart.image := \into[Open.ScalarFunction second.chart.image](
  (\fun (u: Open.Carrier second.chart.image) => (second.encode (Charts.point second.chart u)).apply (E.basis b) a), Open.Smooth[].SmoothFunction second.chart.image) \by { second.encodeSmooth a b };
\definition equality: (\fun (u: Open.Carrier Base.domain) => function (Base.apply u)) =
  (\fun (u: Open.Carrier Base.domain) => (target u).apply (E.basis b) a) :=
  \axiom:funext((\fun (u: Open.Carrier Base.domain) => function (Base.apply u)),
    (\fun (u: Open.Carrier Base.domain) => (target u).apply (E.basis b) a),
    \fun (u: Open.Carrier Base.domain) => congr!{{Charts.LocalPoint second.chart} {R.Real}}
      (\fun (x: Charts.LocalPoint second.chart) => (second.encode x).apply (E.basis b) a) _ _
      (Charts.Of[chart := second.chart].pointCoordinate (Base.overlapPoint u)));
\definition smooth: Open.Smooth[].SmoothOn Base.domain (\fun (u: Open.Carrier Base.domain) => (target u).apply (E.basis b) a) :=
  \idelim (\fun (u: Open.Carrier Base.domain) => function (Base.apply u)) =
    (\fun (u: Open.Carrier Base.domain) => (target u).apply (E.basis b) a)
    \with f: Open.ScalarFunction Base.domain => Open.Smooth[].SmoothOn Base.domain f \by { base: Along.smooth function, equality: equality };
