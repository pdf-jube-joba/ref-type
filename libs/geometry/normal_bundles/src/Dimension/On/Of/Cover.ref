\definition localPoint: Charts.LocalPoint c := \into[M.Point](x, c.domain) \by { inside };
\import \parent.InChart[c := c] \as Coordinates;
\definition parameter: Open.Carrier Coordinates.domain := \into[BaseCoordinates.Point](Charts.coordinate c localPoint, Coordinates.domain.points) \by {
  Maps.Coordinates[f := i, left := c, right := EuclideanManifold.standard].intro (Charts.coordinate c localPoint) (\refl(Maps.apply i (Charts.point c (Charts.coordinate c localPoint))))
};
\definition pointEquality: Charts.point Coordinates.chart parameter = x := Charts.Of[chart := c].pointCoordinate localPoint;
\import calculus.GramSchmidt[d := n, q := ambientDimension].On[U := Coordinates.domain] \as Gram;
\import Gram.Rank[p := n] \as Rank;
\definition exists: \exists ( patch: Local \where Charts.Contains patch.chart x ) := \block {
  \takefrom factors: Rank.Factors[Coordinates.matrix] \by Gram.exists n Coordinates.matrix Coordinates.matrixRegular Coordinates.injective \then
  \takefrom patch: \Cast[Local] ({ patch: Local \where Charts.Contains patch.chart (Charts.point Coordinates.chart parameter) })
    \by Coordinates.With[factors := factors].exists parameter \then
  \return Logic.existsIntro[Local, { patch: Local \where Charts.Contains patch.chart x }] patch
    (\idelim Charts.point Coordinates.chart parameter = x \with y: M.Point => Charts.Contains patch.chart y \by {
      base: \bysub(Local, { patch: Local \where Charts.Contains patch.chart (Charts.point Coordinates.chart parameter) }, patch), equality: pointEquality
    })
};
