\use std.Logic[].Equality[].eq_reason_in;
\definition p: Sum.Carrier := Splitting.isomorphism.backward.apply w;
\definition equation: Quotient.class w = Quotient.class (projection.apply w) := eq_reason_in!{Carrier _
  "=" _ "by" { congr!{{E.Vector} Carrier} Quotient.class _ _ (sym!{{E.Vector}} _ _ (splittingLaws.rightInverse w)) }
  "=" _ "by" { Quotient.projection.preservesAdd (differential.apply (Sum.first p)) (Sum.second p) }
  "=" _ "by" { congr!{Carrier Carrier} (\fun (q: Carrier) => quotientSpace.add q (Quotient.class (Sum.second p))) _ _ (classDifferential (Sum.first p)) }
  "=" _ "by" { Spaces.Laws[V := Carrier, space := quotientSpace].zeroLeft (Quotient.class (Sum.second p)) }
};
