\definition p: Sum.Carrier := Splitting.isomorphism.backward.apply w;
\definition equation: Quotient.class w = Quotient.class (projection.apply w) := trans!{Carrier} _ _ _
  (congr!{{E.Vector} Carrier} Quotient.class _ _ (sym!{{E.Vector}} _ _ (splittingLaws.rightInverse w)))
  (trans!{Carrier} _ _ _ (Quotient.projection.preservesAdd (differential.apply (Sum.first p)) (Sum.second p))
    (trans!{Carrier} _ _ _ (congr!{Carrier Carrier} (\fun (q: Carrier) => quotientSpace.add q (Quotient.class (Sum.second p))) _ _ (classDifferential (Sum.first p)))
      (Spaces.Laws[V := Carrier, space := quotientSpace].zeroLeft (Quotient.class (Sum.second p)))));
