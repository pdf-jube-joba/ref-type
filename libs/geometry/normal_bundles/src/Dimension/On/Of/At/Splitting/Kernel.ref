\use std.Logic[].Equality[].eq_reason_in;
\definition v: E.Vector := differential.apply (Sum.first p);
\definition w: Fiber := Sum.second p;
\definition cross: E.dot v w = R.zero := trans!{{R.Real}} _ _ _ (E.symmetric v w)
  ((\bysub(E.Vector, subspace.carrier, w)) (Sum.first p));
\definition energy: E.dot v (forward.apply p) = E.squared v := eq_reason_in!{{R.Real} _
  "=" _ "by" { E.form.addRight v v w }
  "=" _ "by" { congr!{{R.Real} {R.Real}} (R.add (E.squared v)) _ _ cross }
  "=" _ "by" { Spaces.addZeroRight (E.squared v) }
};
\definition squareZero: E.squared v = R.zero := eq_reason_in!{{R.Real} _
  "=" _ "by" { sym!{{R.Real}} _ _ energy }
  "=" _ "by" { congr!{{E.Vector} {R.Real}} (E.dot v) _ _ same }
  "=" _ "by" { E.form.zeroRight v }
};
\definition vectorZero: v = E.space.zero := E.separated v squareZero;
\definition tangentZero: Sum.first p = (Tangent.space x).zero := injective _ _ (trans!{{E.Vector}} _ _ _ vectorZero (sym!{{E.Vector}} _ _ differential.preservesZero));
\definition normalZero: w = space.zero := trans!{{E.Vector}} _ _ _
  (sym!{{E.Vector}} _ _ (trans!{{E.Vector}} _ _ _ (congr!{{E.Vector} {E.Vector}} (\fun (v: E.Vector) => E.space.add v w) _ _ vectorZero) (Laws.zeroLeft w))) same;
\definition zero: p = Sum.space.zero := Pairs.ext p Sum.space.zero tangentZero normalZero;
