\import Gram.Of[A := Coordinate.matrix parameter, factor := factor] \as Algebra;
\definition normal[w: E.Vector]: Fiber := \into[E.Vector](Algebra.normal.map.apply w, subspace.carrier) \by {
  \fun (v: Tangent.Vector x) => trans!{{R.Real}} _ _ _
    (congr!{{E.Vector} {R.Real}} (E.dot (Algebra.normal.map.apply w)) _ _ (comparison v))
    (Algebra.normalOrthogonal w (Source.forward.apply v))
};
\definition value[w: E.Vector]: Sum.Carrier := Sum.make (Source.backward.apply (Algebra.inverse.apply w)) (normal w);
\definition equation: \forall (w: E.Vector) -> forward.apply (value w) = w := \fun (w: E.Vector) => trans!{{E.Vector}} _ _ _
  (congr!{{E.Vector} {E.Vector}} (\fun (v: E.Vector) => E.space.add v (normal w)) _ _ (backwardComparison (Algebra.inverse.apply w))) (Algebra.splitting w);
\definition exists: \forall (w: E.Vector) -> \exists ( p: Sum.Carrier \where forward.apply p = w ) :=
  \fun (w: E.Vector) => Logic.existsIntro[Sum.Carrier, { p: Sum.Carrier \where forward.apply p = w }] (value w) (equation w);
