\import std.Data[].List[] \as Lists;
\import Spaces.Sums[I := I] \as Values;
\definition sum[indices: Lists.List[I]][f: I -> Functions.Function]: Functions.Function :=
  \into[Open.ScalarFunction Open.whole]((\fun (x: Open.Carrier Open.whole) => Values.sum indices (\fun (i: I) => f i x)), Smooth.SmoothFunction Open.whole) \by {
    Smooth.Sums[].Listed[I := I].smooth Open.whole indices f (\fun (i: I) => \bysub(Open.ScalarFunction Open.whole, Smooth.SmoothFunction Open.whole, f i))
  };
\definition summation: \forall (indices: Lists.List[I])(f: I -> Functions.Function)(v: Vector) -> tangent (sum indices f) v = Values.sum indices (\fun (i: I) => tangent (f i) v) :=
  \induction (indices: Lists.List[I]) \return \forall (f: I -> Functions.Function)(v: Vector) -> tangent (sum indices f) v = Values.sum indices (\fun (i: I) => tangent (f i) v) \with {
    | nil: \fun (f: I -> Functions.Function)(v: Vector) => constant R.zero v
    | cons: \fun (i: I)(tail: Lists.List[I])(previous: _)(f: I -> Functions.Function)(v: Vector) => trans!{{R.Real}} _ _ _
      (addition (f i) (sum tail f) v) (congr!{{R.Real} {R.Real}} (R.add (tangent (f i) v)) _ _ (previous f v))
  };
