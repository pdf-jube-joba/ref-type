\definition firstFirst: h.form (first.apply v) (first.apply w) = R.mul (R.mul (Higher.coefficient data.sign) (Split.head v)) (Split.head w) :=
  eq_reason_in!{{R.Real} _
    "=" _ "by" { h.scaleLeft (R.mul Normalize.factor (Split.head v)) Split.first (first.apply w) }
    "=" _ "by" { congr!{{R.Real} {R.Real}} (R.mul (R.mul Normalize.factor (Split.head v))) _ _
      (h.scaleRight (R.mul Normalize.factor (Split.head w)) Split.first Split.first) }
    "=" _ "by" { sym!{{R.Real}} _ _ (Arithmetic.fieldMulAssoc (R.mul Normalize.factor (Split.head v)) (R.mul Normalize.factor (Split.head w)) q) }
    "=" _ "by" { congr!{{R.Real} {R.Real}} (\fun (a: R.Real) => R.mul a q) _ _ (Algebra.mulFour Normalize.factor (Split.head v) Normalize.factor (Split.head w)) }
    "=" _ "by" { Arithmetic.fieldMulAssoc (R.mul Normalize.factor Normalize.factor) (R.mul (Split.head v) (Split.head w)) q }
    "=" _ "by" { Algebra.mulSwap (R.mul Normalize.factor Normalize.factor) (R.mul (Split.head v) (Split.head w)) q }
    "=" _ "by" { congr!{{R.Real} {R.Real}} (R.mul (R.mul (Split.head v) (Split.head w))) _ _ Normalize.normalized }
    "=" _ "by" { Arithmetic.fieldMulComm (R.mul (Split.head v) (Split.head w)) (Higher.coefficient data.sign) }
    "=" _ "by" { sym!{{R.Real}} _ _ (Arithmetic.fieldMulAssoc (Higher.coefficient data.sign) (Split.head v) (Split.head w)) }
  };
\definition firstResidual: h.form (first.apply v) (residual.apply (rest.apply w)) = R.zero :=
  trans!{{R.Real}} _ _ _ (h.scaleLeft (R.mul Normalize.factor (Split.head v)) Split.first (residual.apply (rest.apply w)))
    (trans!{{R.Real}} _ _ _ (congr!{{R.Real} {R.Real}} (R.mul (R.mul Normalize.factor (Split.head v))) _ _ (orthogonal (rest.apply w)))
      (Arithmetic.fieldMulZeroRight (R.mul Normalize.factor (Split.head v))));
\definition residualFirst: h.form (residual.apply (rest.apply v)) (first.apply w) = R.zero :=
  trans!{{R.Real}} _ _ _ (h.scaleRight (R.mul Normalize.factor (Split.head w)) (residual.apply (rest.apply v)) Split.first)
    (trans!{{R.Real}} _ _ _ (congr!{{R.Real} {R.Real}} (R.mul (R.mul Normalize.factor (Split.head w))) _ _ (orthogonalLeft (rest.apply v)))
      (Arithmetic.fieldMulZeroRight (R.mul Normalize.factor (Split.head w))));
\definition formula: h.form (forward.apply v) (forward.apply w) = Higher.standard sign v w := eq_reason_in!{{R.Real} _
  "=" _ "by" { h.addLeft (first.apply v) (residual.apply (rest.apply v)) (forward.apply w) }
  "=" _ "by" { congr!{{R.Real} {R.Real} {R.Real}} R.add _ _ _ _
    (h.addRight (first.apply v) (first.apply w) (residual.apply (rest.apply w)))
    (h.addRight (residual.apply (rest.apply v)) (first.apply w) (residual.apply (rest.apply w))) }
  "=" _ "by" { congr!{{R.Real} {R.Real} {R.Real}} R.add _ _ _ _
    (trans!{{R.Real}} _ _ _ (congr!{{R.Real} {R.Real} {R.Real}} R.add _ _ _ _ firstFirst firstResidual)
      (Arithmetic.addZeroRight (R.mul (R.mul (Higher.coefficient data.sign) (Split.head v)) (Split.head w))))
    (trans!{{R.Real}} _ _ _ (congr!{{R.Real} {R.Real} {R.Real}} R.add _ _ _ _ residualFirst (lower.formula (Split.tail v) (Split.tail w)))
      (Arithmetic.addZeroLeft (Lower.standard lower.sign (Split.tail v) (Split.tail w)))) }
  "=" _ "by" { sym!{{R.Real}} _ _ (standardSplit v w) }
};
