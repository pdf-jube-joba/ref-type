\import \root.Inertia[n := N.Nat^::zero] \as Empty;
\import Spaces.Isomorphism[V := Empty.Vector, W := Empty.Vector, source := Empty.space, target := Empty.space] \as EmptyIsomorphisms;
\import Spaces.Eigen[V := Empty.Vector, space := Empty.space] \as EmptyEigen;
\definition normalForm[h: Empty.Form]: Empty.NormalForm[h] := Empty.NormalForm[h] {
  sign := \fun (i: Fin.Fin N.Nat^::zero) => Bool.Bool^::false,
  change := EmptyIsomorphisms.Isomorphism {
    forward := EmptyEigen.identity, backward := EmptyEigen.identity,
    leftInverse := \fun (v: Empty.Vector) => \refl(v), rightInverse := \fun (v: Empty.Vector) => \refl(v),
  },
  formula := \fun (v, w: Empty.Vector) => trans!{{R.Real}} _ _ _
    (congr!{{Empty.Vector} {R.Real}} (\fun (x: Empty.Vector) => h.form x w) _ _
      (Sums.Linear[].emptyVector v)) (h.zeroLeft w),
};
