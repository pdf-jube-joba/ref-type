\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition two: N.Nat^ := N.Nat^::succ one;
\import \root.Inertia[n := N.Nat^::zero] \as Empty;
\import Empty.Index[] \as EmptyIndex;
\import \root.Inertia[n := one] \as Line;
\import Line.Index[] \as LineIndex;
\import \root.Inertia[n := two] \as Plane;
\import Plane.Index[] \as PlaneIndex;
\definition emptySigns: Empty.Signs := \fun (i: Fin.Fin N.Nat^::zero) => Bool.Bool^::false;
\definition negativeLine: Line.Signs := \fun (i: Fin.Fin one) => Bool.Bool^::true;
\definition saddle: Plane.Signs := Fin.Tuples[A := Bool.Bool^].extend one Bool.Bool^::true (\fun (i: Fin.Fin one) => Bool.Bool^::false);
\definition saddleHead: saddle (Fin.zero one) = Bool.Bool^::true :=
  Fin.Tuples[A := Bool.Bool^].atZero one Bool.Bool^::true (\fun (i: Fin.Fin one) => Bool.Bool^::false);
\definition saddleTail: saddle (Fin.succ one (Fin.zero N.Nat^::zero)) = Bool.Bool^::false :=
  Fin.Tuples[A := Bool.Bool^].atSuccessor one Bool.Bool^::true (\fun (i: Fin.Fin one) => Bool.Bool^::false) (Fin.zero N.Nat^::zero);
\definition saddleNegativeCount: PlaneIndex.negative saddle = one :=
  congr!{{Bool.Bool^} {Bool.Bool^} {N.Nat^}}
    (\fun (a, b: Bool.Bool^) => Bool.ite N.Nat^ a (N.Nat^::succ (Bool.ite N.Nat^ b one N.Nat^::zero)) (Bool.ite N.Nat^ b one N.Nat^::zero))
    _ _ _ _ saddleHead saddleTail;
\definition saddlePositiveCount: PlaneIndex.positive saddle = one :=
  congr!{{Bool.Bool^} {Bool.Bool^} {N.Nat^}}
    (\fun (a, b: Bool.Bool^) => Bool.ite N.Nat^ (Bool.Neg.specification a)
      (N.Nat^::succ (Bool.ite N.Nat^ (Bool.Neg.specification b) one N.Nat^::zero))
      (Bool.ite N.Nat^ (Bool.Neg.specification b) one N.Nat^::zero))
    _ _ _ _ saddleHead saddleTail;
\definition emptyNegative: EmptyIndex.negativeIndex (EmptyIndex.standardClassified emptySigns) = N.Nat^::zero :=
  EmptyIndex.negativeIndexStandard emptySigns;
\definition emptyPositive: EmptyIndex.positiveIndex (EmptyIndex.standardClassified emptySigns) = N.Nat^::zero :=
  EmptyIndex.positiveIndexStandard emptySigns;
\definition lineNegative: LineIndex.negativeIndex (LineIndex.standardClassified negativeLine) = one :=
  LineIndex.negativeIndexStandard negativeLine;
\definition linePositive: LineIndex.positiveIndex (LineIndex.standardClassified negativeLine) = N.Nat^::zero :=
  LineIndex.positiveIndexStandard negativeLine;
\definition saddleNegative: PlaneIndex.negativeIndex (PlaneIndex.standardClassified saddle) = one :=
  trans!{{N.Nat^}} _ _ _ (PlaneIndex.negativeIndexStandard saddle) saddleNegativeCount;
\definition saddlePositive: PlaneIndex.positiveIndex (PlaneIndex.standardClassified saddle) = one :=
  trans!{{N.Nat^}} _ _ _ (PlaneIndex.positiveIndexStandard saddle) saddlePositiveCount;
