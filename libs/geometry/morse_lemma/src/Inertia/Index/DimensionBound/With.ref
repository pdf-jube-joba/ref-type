\import Target.Gram[k := k].Of[A := A, factor := factor] \as Image;
\definition traceNonnegative: Ordered.Le R.zero (Target.trace Image.normal) := Sums.nonnegative l
  (\fun (i: Fin.Fin l) => Image.normal.map.apply (Target.basis i) i)
  (Target.OnProjection[P := Image.normal].diagonalNonnegative);
\definition differenceNonnegative: Ordered.Le R.zero (R.sub (Dimension.naturalScalar l) (Dimension.naturalScalar k)) :=
  Ordered.leReplaceRight R.zero _ _ Image.normalTrace traceNonnegative;
\definition bound: Ordered.Le (Dimension.naturalScalar k) (Dimension.naturalScalar l) :=
  Ordered.leReplaceRight _ _ _
    (trans!{{R.Real}} _ _ _ (Arithmetic.addComm (Dimension.naturalScalar k) (R.sub (Dimension.naturalScalar l) (Dimension.naturalScalar k)))
      (R.Distance[].subAddCancel (Dimension.naturalScalar l) (Dimension.naturalScalar k)))
    (Ordered.leReplaceLeft _ _ _ (Arithmetic.addZeroRight (Dimension.naturalScalar k))
      (Arithmetic.addMonotoneLeft R.zero (R.sub (Dimension.naturalScalar l) (Dimension.naturalScalar k)) (Dimension.naturalScalar k) differenceNonnegative));
