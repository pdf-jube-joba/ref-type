\import linear_algebra.Euclidean[n := negative s] \as Source;
\import linear_algebra.Euclidean[n := negative t] \as Target;
\import E.Resolution[] \as Resolution;
\import Spaces.Linear[V := Source.Vector, W := Vector, source := Source.space, target := E.space] \as Inclusions;
\import Spaces.Linear[V := Vector, W := Target.Vector, source := E.space, target := Target.space] \as Coordinates;
\import Spaces.Linear[V := Source.Vector, W := Target.Vector, source := Source.space, target := Target.space] \as Maps;
\module With(congruent: Congruent s t C, sourceFrame: Resolution.Frame (negative s) (projection s), targetFrame: Resolution.Frame (negative t) (projection t));
\definition bound: Congruent s t C -> Ordered.Le (Dimension.naturalScalar (negative s)) (Dimension.naturalScalar (negative t)) := \block {
  \fun (congruent: Congruent s t C) \then
  \takefrom sourceFrame: Resolution.Frame (negative s) (projection s) \by negativeFrameExists s \then
  \takefrom targetFrame: Resolution.Frame (negative t) (projection t) \by negativeFrameExists t \then
  \return With[congruent := congruent, sourceFrame := sourceFrame, targetFrame := targetFrame].bound
};
