\import \parent.Of[h := h] \as FormIndex;
\definition laws: NonsingularLaws[h] := \bysub(Form, { h: Form \where NonsingularLaws[h] }, h);
\definition Negative: \Set := \Cast[N.Nat^] ({ k: N.Nat^ \where FormIndex.HasNegative k });
\definition Positive: \Set := \Cast[N.Nat^] ({ k: N.Nat^ \where FormIndex.HasPositive k });
\definition negativeExists: \exists Negative := \block {
  \takefrom k: Negative \by FormIndex.negativeExists laws.symmetric laws.nondegenerate \then
  \return \exact(k, Negative)
};
\definition positiveExists: \exists Positive := \block {
  \takefrom k: Positive \by FormIndex.positiveExists laws.symmetric laws.nondegenerate \then
  \return \exact(k, Positive)
};
\definition negativeUnique: \forall (k, l: Negative) -> k = l := \fun (k, l: Negative) => FormIndex.negativeDetermined k l
  (\bysub(N.Nat^, { k: N.Nat^ \where FormIndex.HasNegative k }, k)) (\bysub(N.Nat^, { k: N.Nat^ \where FormIndex.HasNegative k }, l));
\definition positiveUnique: \forall (k, l: Positive) -> k = l := \fun (k, l: Positive) => FormIndex.positiveDetermined k l
  (\bysub(N.Nat^, { k: N.Nat^ \where FormIndex.HasPositive k }, k)) (\bysub(N.Nat^, { k: N.Nat^ \where FormIndex.HasPositive k }, l));
\definition negative: Negative := \choice Negative \by { existence: negativeExists, uniqueness: negativeUnique };
\definition positive: Positive := \choice Positive \by { existence: positiveExists, uniqueness: positiveUnique };
\definition negativeLaw: FormIndex.HasNegative negative := \bysub(N.Nat^, { k: N.Nat^ \where FormIndex.HasNegative k }, negative);
\definition positiveLaw: FormIndex.HasPositive positive := \bysub(N.Nat^, { k: N.Nat^ \where FormIndex.HasPositive k }, positive);
