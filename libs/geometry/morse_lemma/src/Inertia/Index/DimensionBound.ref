\import linear_algebra.Euclidean[n := k] \as Source;
\import linear_algebra.Euclidean[n := l] \as Target;
\import Spaces.Linear[V := Source.Vector, W := Target.Vector, source := Source.space, target := Target.space] \as Maps;
\definition Injective[A: Maps.Map]: \Prop := Target.Gram[k := k].Injective A;
\module With(A: Maps.Map, factor: Target.Gram[k := k].Factorization[A]);
\definition bound: \forall (A: Maps.Map) -> Injective A -> Ordered.Le (Dimension.naturalScalar k) (Dimension.naturalScalar l) := \block {
  \fun (A: Maps.Map)(injective: Injective A) \then
  \takefrom factor: Target.Gram[k := k].Factorization[A] \by inverse_implicit.Gram[n := k, m := l].existence A injective \then
  \return With[A := A, factor := factor].bound
};
