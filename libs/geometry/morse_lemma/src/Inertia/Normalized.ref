\definition coordinates[v: Vector]: Vector := normal.change.backward.apply v;
\definition formula: \forall (v, w: Vector) -> h.form v w = standard normal.sign (coordinates v) (coordinates w) :=
  \fun (v, w: Vector) => trans!{{R.Real}} _ _ _
    (congr!{Vector Vector {R.Real}} h.form _ _ _ _
      (sym!{Vector} _ _ ((Isomorphisms.laws normal.change).rightInverse v))
      (sym!{Vector} _ _ ((Isomorphisms.laws normal.change).rightInverse w)))
    (normal.formula (coordinates v) (coordinates w));
\definition nondegenerate: Nondegenerate h := \fun (v: Vector)(zero: \forall (w: Vector) -> h.form v w = R.zero) =>
  trans!{Vector} _ _ _ (sym!{Vector} _ _ ((Isomorphisms.laws normal.change).rightInverse v))
    (trans!{Vector} _ _ _ (congr!{Vector Vector} normal.change.forward.apply _ _
      (standardNondegenerate normal.sign (coordinates v) (\fun (w: Vector) => eq_reason_in!{{R.Real} _
        "=" _ "by" { sym!{{R.Real}} _ _ (normal.formula (coordinates v) w) }
        "=" _ "by" { congr!{Vector {R.Real}} (\fun (x: Vector) => h.form x (normal.change.forward.apply w)) _ _ ((Isomorphisms.laws normal.change).rightInverse v) }
        "=" _ "by" { zero (normal.change.forward.apply w) }
      }))) normal.change.forward.preservesZero);
