\import Normalization.On[U := U] \as Family;
\import Family.At[A := A, a := a] \as At;
\definition Regular: \Prop := Family.Regular A;
\definition Symmetric: \Prop := At.SymmetricFamily;
\structure Local: \Set := {
  domain: Open.OpenSet,
  included: Open.Included domain U,
  contains: \In[Point] domain.points a,
  center: Index.NonsingularForm,
  centerForm: center = Forms.form (A a),
  forms: Open.Carrier domain -> Index.NonsingularForm,
  formFormula: \forall (x: Open.Carrier domain) -> forms x = Forms.form (A (Open.inclusion domain U included x)),
  negativeConstant: \forall (x: Open.Carrier domain) -> Index.negativeIndex (forms x) = Index.negativeIndex center,
  positiveConstant: \forall (x: Open.Carrier domain) -> Index.positiveIndex (forms x) = Index.positiveIndex center,
};
\module With(regular: Regular, symmetric: Symmetric, nonzero: Inversion.Nonzero (A a), local: At.InvertibleLocal);
\definition localExistence: Regular -> Symmetric -> Inversion.Nonzero (A a) -> \exists Local := \block {
  \fun (regular: Regular)(symmetric: Symmetric)(nonzero: Inversion.Nonzero (A a)) \then
  \takefrom local: At.InvertibleLocal \by At.localInvertibleExistence regular symmetric nonzero \then
  \return \exact(With[regular := regular, symmetric := symmetric, nonzero := nonzero, local := local].value, Local)
};
