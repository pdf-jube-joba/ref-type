\use std.Logic[].Equality[].eq_reason_in;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as R;
\import calculus.Blocks[n := p, m := n] \as Split;
\import Fin.Sum[m := p, n := n] \as Indices;
\definition dimension: N.Nat^ := Split.dimension;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Open;
\import calculus.Real[].Multivariable[n := p].Open[] \as Parameters;
\import calculus.Real[].Multivariable[n := n].Open[] \as Fibers;
\import Open.Smooth[] \as Smooth;
\import Smooth.Derivative[] \as Partials;
\import calculus.Maps[n := dimension, m := n] \as Gradients;
\import calculus.Maps[n := p, m := n] \as Branches;
\import calculus.Maps[n := p, m := dimension] \as Graphs;
\import inverse_implicit.Product[n := p, m := n] \as Inverse;
\definition Point: \Set := Fin.Fin dimension -> R.Real;
\definition Parameter: \Set := Fin.Fin p -> R.Real;
\definition Vector: \Set := Fin.Fin n -> R.Real;
\definition zero: Vector := linear_algebra.Euclidean[n := n].space.zero;
\module Basis;
\module Function(U: Open.OpenSet, f: Smooth.SmoothFunction U);
