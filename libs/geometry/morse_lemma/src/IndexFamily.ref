/* Inertia is locally constant on smooth nonsingular symmetric matrix families. */
\use std.Logic[].Equality[].eq_reason_in;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as R;
\import R.Algebra[] \as Algebra;
\import linear_algebra.Euclidean[n := n] \as E;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real Algebra.field] \as Spaces;
\import Spaces.Isomorphism[V := E.Vector, W := E.Vector, source := E.space, target := E.space] \as Isomorphisms;
\import matrix_invariants.Ring[K := R.Real, scalars := std.Alg[].Field[].fieldAsCommutativeRing R.Real Algebra.field].At[n := n] \as Matrices;
\import matrix_invariants.Field[K := R.Real, field := Algebra.field].At[n := n] \as Inversion;
\import \root.Inertia[n := n] \as Inertia;
\import Inertia.Index[] \as Index;
\import \root.MatrixForm[n := n] \as Forms;
\import \root.Normalization[d := d, n := n] \as Normalization;
\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\definition Point: \Set := Fin.Fin d -> R.Real;
\module On(U: Open.OpenSet, A: Open.Carrier U -> Matrices.Matrix, a: Open.Carrier U);
