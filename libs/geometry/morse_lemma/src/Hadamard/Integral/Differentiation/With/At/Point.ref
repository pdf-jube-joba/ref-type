\definition Lower[s: Real]: \Prop := R.Le (Distance.min (b i) z) s;
\definition Upper[s: Real]: \Prop := R.Le s (Distance.max (b i) z);
\definition distanceBound: \forall (s: Real) -> Lower s -> Upper s -> R.Le (Scalars.distance s (b i)) (Scalars.distance z (b i)) :=
  \fun (s: Real)(lower: _)(upper: _) => Bounds.betweenDistance (b i) z s lower upper;
\definition contains: \forall (s: Real) -> Lower s -> Upper s -> \In[Point] U.points (Coordinates.replace b i s) :=
  \fun (s: Real)(lower: _)(upper: _) => ball.included (Coordinates.replace b i s)
    (R.leLtTrans _ _ rho (R.leReplaceLeft (Scalars.distance s (b i)) (Coordinates.pointDistance (Coordinates.replace b i s) b) _
      (sym!{Real} _ _ (SpaceLaws.replaceDistance b i s)) (distanceBound s lower upper))
      (R.ltLeTrans _ radius rho near (Distance.minRight delta rho)));
\module Fiber(t: Time);
