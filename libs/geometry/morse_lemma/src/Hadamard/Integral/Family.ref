\import Open.Topology[].Of[U := U] \as Source;
\definition X: \Set := Open.Carrier U;
\import topological_constructions.Product[A := X, B := Time] \as ProductSpace;
\import std.Data[].Pair[] \as Pair;
\definition Joint: \Set := ProductSpace.CarrierSet;
\definition jointTopology: topology.Topology[Carrier := Joint].Topology := ProductSpace.topology Source.topology topology;
\definition apply[p: Joint]: Real := g (Pair.second X Time p) (Pair.first X Time p);
\import metric_spaces.RealFunctions[A := Joint] \as JointFunctions;
\definition JointContinuous: \Prop := JointFunctions.Continuous jointTopology apply;
\module With(continuous: JointContinuous);
