\import \parent.Family[g := g] \as G;
\import \parent.Family[g := h] \as H;
\import calculus.Real[].Derivative[].Def[] \as Derivatives;
\import Scalars.Algebra[] \as Algebra;
\import Scalars.Inverse[] \as Inverse;
\import calculus.Real[].Multivariable[n := n].Space[].Prop[] \as SpaceLaws;
\definition PartialLaw: \Prop := \forall (t: Time) -> Analysis.HasPartialDerivative U (g t) i (h t);
\definition reverseSlope: \forall (f: Real -> Real)(l, r: Real) -> Logic.Not (r = l) -> Derivatives.slope f r l = Derivatives.slope f l r :=
  \fun (f: Real -> Real)(l, r: Real)(different: _) => eq_reason_in!{Real _
    "=" _ "by" { congr!{Real Real Real} Scalars.mul _ _ _ _
      (sym!{Real} _ _ (Algebra.negSub (f r) (f l)))
      (congr!{Real Real} Laws.fieldInv _ _ (sym!{Real} _ _ (Algebra.negSub r l))) }
    "=" _ "by" { congr!{Real Real} (Scalars.mul (Scalars.neg (Scalars.sub (f r) (f l)))) _ _
      (Inverse.inverseNeg (Scalars.sub r l) (\fun (zero: Scalars.sub r l = Scalars.zero) => different (Distance.subZeroEq r l zero))) }
    "=" _ "by" { Laws.fieldMulNegBoth (Scalars.sub (f r) (f l)) (Laws.fieldInv (Scalars.sub r l)) }
  };
\module With(continuousG: G.JointContinuous, continuousH: H.JointContinuous);
