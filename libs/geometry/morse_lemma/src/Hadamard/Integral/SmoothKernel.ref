/* All parameter derivatives are continuous jointly with the integration variable. */
\structure Kernel: \Set := {
  jet: Smooth.Directions -> Time -> Open.ScalarFunction U,
  joint: \forall (directions: Smooth.Directions) -> \parent.Family[g := jet directions].JointContinuous,
  partial: \forall (directions: Smooth.Directions)(i: Index)(t: Time) ->
    Analysis.HasPartialDerivative U (jet directions t) i (jet (Smooth.Directions::cons i directions) t),
};
\module Of(kernel: Kernel);
