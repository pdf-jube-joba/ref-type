\import Maps.Composition[U := domain, V := U, f := map] \as Composition;
\definition function: TotalSmooth.SmoothFunction domain := Composition.function g;
\definition speed[z: Total.Carrier domain]: Real := Sums.sum n (\fun (i: Index) =>
  Scalars.mul (Partials.derivative U g i (Maps.apply domain U map z)) (displacement i z));
\definition speedSmooth: TotalSmooth.SmoothOn domain speed := TotalSmooth.Sums[].smooth domain n
  (\fun (i: Index)(z: Total.Carrier domain) => Scalars.mul (Partials.derivative U g i (Maps.apply domain U map z)) (displacement i z))
  (\fun (i: Index) => Operations.mulSmooth domain (Composition.scalar (Partials.derivative U g i)) (displacement i)
    (Composition.smooth (Partials.derivative U g i)) (\bysub(Total.ScalarFunction domain, { h: Total.ScalarFunction domain \where TotalSmooth.SmoothOn domain h }, displacement i)));
\definition speedFunction: TotalSmooth.SmoothFunction domain := \into[Total.ScalarFunction domain](speed,
  { h: Total.ScalarFunction domain \where TotalSmooth.SmoothOn domain h }) \by { speedSmooth };
\module At(z: Total.Carrier domain);
\definition timePartial: Analysis.HasPartialDerivative domain function timeIndex speed := \fun (z: Total.Carrier domain) => At[z := z].timePartial;
