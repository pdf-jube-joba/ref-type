\import Maps.Differential[U := domain, V := U, f := map, a := z] \as Differential;
\import calculus.Vector[n := dimension, m := n] \as Vector;
\definition timeDifferential: Differential.value.apply (TotalCoordinates.basis timeIndex) = displacementVector z :=
  \axiom:funext(Differential.value.apply (TotalCoordinates.basis timeIndex), displacementVector z, \fun (i: Index) =>
    Analysis.Properties[].partialUnique domain (component i) timeIndex z _ _
      (Analysis.Differential[U := domain, f := component i, a := z, d := Vector.row Differential.value i].Partial[i := timeIndex].law (Differential.vectorLaw i))
      (componentPartial i z));
