\import Maps.Differential[U := domain, V := U, f := map, a := z] \as Differential;
\import Smooth.Differential[] \as Outer;
\import calculus.Vector[n := dimension, m := n].Chain[U := domain, V := U,
  f := Maps.apply domain U map, a := z, d := Differential.value, g := g,
  e := Outer.value U g (Maps.apply domain U map z)] \as Chain;
\definition timePartial: Analysis.HasPartialDerivativeAt domain function timeIndex z (speed z) :=
  \idelim Chain.differential.apply (TotalCoordinates.basis timeIndex) = speed z
    \with d: Real => Analysis.HasPartialDerivativeAt domain function timeIndex z d \by {
      base: Analysis.Differential[U := domain, f := function, a := z, d := Chain.differential].Partial[i := timeIndex].law
        (Chain.law Differential.vectorLaw (Outer.law U g (Maps.apply domain U map z))),
      equality: congr!{Point Real} (Outer.value U g (Maps.apply domain U map z)).apply _ _ (timeDifferential z)
    };
