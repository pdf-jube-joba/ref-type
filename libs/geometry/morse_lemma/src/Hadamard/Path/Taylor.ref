\import integration.Real[].Riemann[interval := Average.interval].Continuous[] \as Closed;
\import calculus.Real[].Derivative[].Def[] \as Derivative;
\import calculus.Real[].Derivative[].Prop[] \as Basic;
\import calculus.Real[].Derivative[].Operations[] \as Derivatives;
\import calculus.Real[].Derivative[].Product[] \as ProductDerivative;
\import Average.Algebra[] \as Integrals;
\import Average.Weight[] \as Weight;
\import metric_spaces.RealFunctions[A := Time] \as TimeFunctions;
\definition weighted: Average.Function := \into[Time -> Real]((\fun (t: Time) => Scalars.mul (Weight.function t) (e t)),
  { h: Time -> Real \where Average.IsContinuous h }) \by {
  TimeFunctions.Product[].continuous Average.topology Weight.function e
    (\bysub(Time -> Real, { h: Time -> Real \where Average.IsContinuous h }, Weight.function))
    (\bysub(Time -> Real, { h: Time -> Real \where Average.IsContinuous h }, e))
};
\definition ContinuousG: \Prop := Closed.IsContinuous g;
\definition ContinuousD: \Prop := Closed.IsContinuous d;
\definition First: \Prop := \forall (t: Real) -> R.Lt Scalars.zero t -> R.Lt t Scalars.one -> Derivative.HasDerivativeAt g t (d t);
\definition Second: \Prop := \forall (t: Real) -> R.Lt Scalars.zero t -> R.Lt t Scalars.one -> Derivative.HasDerivativeAt d t (Average.extend e t);
\module With(continuousD: ContinuousD);
\definition law: ContinuousG -> ContinuousD -> First -> Second ->
  g Scalars.one = Scalars.add (g Scalars.zero) (Scalars.add (d Scalars.zero) (Average.value weighted)) :=
  \fun (continuousG: ContinuousG)(continuousD: ContinuousD) => With[continuousD := continuousD].law continuousG;
