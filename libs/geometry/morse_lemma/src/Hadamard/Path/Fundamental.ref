\import integration.Real[].Riemann[interval := Average.interval].Continuous[] \as ContinuousFunctions;
\import ContinuousFunctions.Of[f := Average.asFunction h] \as Integral;
\import Integral.Uniqueness[g := g] \as Uniqueness;
\import calculus.Real[].Derivative[].Def[] \as Derivatives;
\definition Continuous: \Prop := ContinuousFunctions.IsContinuous g;
\definition Derivative: \Prop := \forall (t: Real) -> R.Lt Scalars.zero t -> R.Lt t Scalars.one ->
  Derivatives.HasDerivativeAt g t (Average.extend h t);
\definition law: Continuous -> Derivative -> g Scalars.one = Scalars.add (g Scalars.zero) (Average.value h) :=
  \fun (continuous: Continuous)(derivative: Derivative) => trans!{Real} _ _ _
    (Uniqueness.agrees continuous derivative Scalars.one Average.interval.ordered (R.leRefl Scalars.one))
    (congr!{Real Real} (Scalars.add (g Scalars.zero)) _ _ Integral.primitiveRight);
