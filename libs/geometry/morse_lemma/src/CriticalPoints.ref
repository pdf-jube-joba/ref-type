\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import \root.Euclidean[n := n].Function[U := U, f := f] \as Function;
\import \root.Inertia[n := n] \as Inertia;
\import Inertia.Index[] \as Index;
\import \root.MatrixForm[n := n] \as MatrixForms;
\definition NondegeneratePoint: \Set := \Cast[Open.Carrier U] ({ x: Open.Carrier U \where Function.Nondegenerate x });
\definition classified[x: NondegeneratePoint]: Index.NonsingularForm :=
  \into[Inertia.Form](Function.hessianForm x, Index.NonsingularForm) \by {
    Index.NonsingularLaws[Function.hessianForm x] {
      symmetric := Function.hessianFormSymmetric x,
      nondegenerate := Function.hessianFormNondegenerate x (\bysub(Open.Carrier U, NondegeneratePoint, x)),
    }
  };
\definition index[x: NondegeneratePoint]: N.Nat^ := Index.negativeIndex (classified x);
\definition coindex[x: NondegeneratePoint]: N.Nat^ := Index.positiveIndex (classified x);
\module At(a: Open.Carrier U);
