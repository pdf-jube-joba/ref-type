\use std.Logic[].Equality[].eq_reason_in;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.sym;
\use Equality.trans;
\import real.Analysis[] \as R;
\import R.Algebra[] \as Algebra;
\import dedekind_reals.DedekindReal[] \as Reals;
\import Reals.Arithmetic[].Prop[] \as Laws;
\import calculus.Real[].Multivariable[n := n] \as Calculus;
\import Calculus.Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\import Smooth.Derivative[] \as Partials;
\import Smooth.Differential[] \as Differentials;
\import Open.Analysis[] \as Analysis;
\import calculus.Maps[n := n, m := n] \as Maps;
\import linear_algebra.Euclidean[n := n] \as E;
\import linear_algebra.Commutative[K := R.Real,
  scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real Algebra.field] \as Spaces;
\import Spaces.Linear[V := E.Vector, W := E.Vector, source := E.space, target := E.space] \as Linear;
\import Spaces.Form[V := E.Vector, space := E.space] \as Forms;
\import matrix_invariants.Ring[K := R.Real,
  scalars := std.Alg[].Field[].fieldAsCommutativeRing R.Real Algebra.field].At[n := n] \as Matrix;
\import Matrix.Representation[] \as Representation;
\import matrix_invariants.Field[K := R.Real, field := Algebra.field].At[n := n] \as Inversion;
\definition Real: \Set := R.Real;
\definition Point: \Set := E.Vector;
\definition Coordinate: \Set := Fin.Fin n;
\module Function(U: Open.OpenSet, f: Smooth.SmoothFunction U);
