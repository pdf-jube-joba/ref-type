\import \root.IndexFamily[d := n, n := n].On[U := U, A := Function.hessianEntries, a := a] \as Family;
\definition symmetric: Family.Symmetric := \fun (x: Open.Carrier U)(i, j: Fin.Fin n) => eq_reason_in!{{real.Analysis[].Real} _
  "=" _ "by" { Function.hessianEntriesValue x i j }
  "=" _ "by" { Function.hessianSymmetric x i j }
  "=" _ "by" { sym!{{real.Analysis[].Real}} _ _ (Function.hessianEntriesValue x j i) }
};
\definition locallyConstant: Function.Nondegenerate a -> \exists Family.Local :=
  Family.localExistence Function.hessianEntriesRegular symmetric;
\definition isolated: Function.Nondegenerate a -> Function.Critical a -> \exists Function.IsolatingNeighborhood[a] := Function.isolated a;
