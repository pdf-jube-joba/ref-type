\import Homotopies.Differential[U := domain, V := U, f := map, a := z] \as Jacobian;
\import calculus.Vector[n := totalDimension, m := dimension] \as Vectors;
\definition law: Jacobian.value.apply (TotalCoordinates.basis timeIndex) = pointValue z :=
  \axiom:funext(Jacobian.value.apply (TotalCoordinates.basis timeIndex), pointValue z, \fun (k: Fin.Fin dimension) =>
    Analysis.Properties[].partialUnique domain (\fun (z: Total.Carrier domain) => Homotopies.apply domain U map z k) timeIndex z _ _
      (Analysis.Differential[U := domain, f := (\fun (z: Total.Carrier domain) => Homotopies.apply domain U map z k), a := z, d := Vectors.row Jacobian.value k].Partial[i := timeIndex].law
        (Jacobian.vectorLaw k)) (componentPartial k z));
