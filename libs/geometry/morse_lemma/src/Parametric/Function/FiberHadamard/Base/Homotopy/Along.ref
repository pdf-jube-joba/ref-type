\import Homotopies.Composition[U := domain, V := U, f := map] \as Composition;
\definition function: TotalSmooth.SmoothFunction domain := Composition.function g;
\definition coefficient[i: Index]: TotalSmooth.SmoothFunction domain := Composition.function (Partials.derivative U g (Indices.right i));
\import TotalSmooth.Algebra[U := domain] \as Algebra;
\definition term[i: Index]: TotalSmooth.SmoothFunction domain := Algebra.product (coefficient i) (shiftFunction (Indices.right i));
\definition speed[z: Total.Carrier domain]: Real := Sums.sum n (\fun (i: Index) => term i z);
\definition speedSmooth: TotalSmooth.SmoothOn domain speed := TotalSmooth.Sums[].smooth domain n
  (\fun (i: Index)(z: Total.Carrier domain) => term i z)
  (\fun (i: Index) => \bysub(Total.ScalarFunction domain, { h: Total.ScalarFunction domain \where TotalSmooth.SmoothOn domain h }, term i));
\definition speedFunction: TotalSmooth.SmoothFunction domain := \into[Total.ScalarFunction domain](speed, { h: Total.ScalarFunction domain \where TotalSmooth.SmoothOn domain h }) \by { speedSmooth };
\module At(z: Total.Carrier domain);
\definition timePartial: Analysis.HasPartialDerivative domain function timeIndex speed := \fun (z: Total.Carrier domain) => At[z := z].law;
