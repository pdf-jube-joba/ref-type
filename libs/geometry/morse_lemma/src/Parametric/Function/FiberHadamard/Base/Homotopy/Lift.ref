\definition function[z: Total.Carrier domain]: Real := g (basePoint z);
\import calculus.Real[].Derivative[].Prop[] \as Derivatives;
\definition partial: Analysis.HasPartialDerivative domain function timeIndex (\fun (z: Total.Carrier domain) => R.zero) :=
  \fun (z: Total.Carrier domain) => Analytic.sectionPartial domain function z timeIndex (\fun (t: Real) => function z) R.zero
    (\refl(function z))
    (\fun (t: Real)(y: Total.Carrier domain)(replaced: y = TotalCoordinates.replace z timeIndex t) =>
      sym!{Real} _ _ (congr!{{Open.Carrier baseDomain} Real} g _ _ (sameBase z y t replaced)))
    (Derivatives.constantDerivative (function z) (z timeIndex));
