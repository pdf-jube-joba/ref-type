\import calculus.Maps[n := Paths.dimension, m := dimension] \as HomotopyMaps;
\import Homotopy.Along[g := f] \as First;
\import Homotopy.Second[] \as Second;
\import Paths.Slice[W := domain, b := base, Z := Homotopy.domain, inside := inside, h := First.function] \as FirstSlice;
\import Paths.Slice[W := domain, b := base, Z := Homotopy.domain, inside := inside, h := First.speedFunction] \as SpeedSlice;
\import Paths.Slice[W := domain, b := base, Z := Homotopy.domain, inside := inside, h := Second.function] \as SecondSlice;
\import FirstSlice.Curve[x := x] \as Curve;
\import SpeedSlice.Curve[x := x] \as Speed;
\definition point[t: Paths.Time]: Total.Carrier Homotopy.domain := FirstSlice.point x t;
\definition mapFormula: \forall (t: Paths.Time) -> HomotopyMaps.apply Homotopy.domain U Homotopy.map (point t) =
  Coordinates.addPoint (Base.origin (basePoint x)) (Coordinates.scale t (Base.displacement (basePoint x))) := Homotopy.joinValue (basePoint x);
\definition baseAtPoint: \forall (t: Paths.Time) -> Homotopy.basePoint (point t) = basePoint x :=
  \fun (t: Paths.Time) => TimeSplit.leftJoin x (Paths.time t);
\definition clockAtPoint: \forall (t: Paths.Time) -> point t Homotopy.timeIndex = t :=
  \fun (t: Paths.Time) => Fin.Sum[m := dimension, n := One.dimension].Tuples[A := Real].atRight x (Paths.time t) One.index;
\definition deltaAtPoint: \forall (t: Paths.Time)(i: Index) -> Homotopy.shiftFunction (Indices.right i) (point t) = delta x i :=
  \fun (t: Paths.Time)(i: Index) => trans!{Real} _ _ _
    (congr!{{Open.Carrier Base.domain} Real} (\fun (v: Open.Carrier Base.domain) => Base.displacement v (Indices.right i))
      (Homotopy.basePoint (point t)) (basePoint x) (baseAtPoint t)) (Base.rightDisplacement (basePoint x) i);
\definition originPoint: Point := Base.origin (basePoint x);
\definition zeroTime: Paths.Time := \into[Real](R.zero, metric_spaces.RealLine[].ClosedInterval R.zero R.one) \by {
  Logic.And[_, _]::# (D.leRefl R.zero) Average.interval.ordered
};
\definition oneTime: Paths.Time := \into[Real](R.one, metric_spaces.RealLine[].ClosedInterval R.zero R.one) \by {
  Logic.And[_, _]::# Average.interval.ordered (D.leRefl R.one)
};
\definition atZero: HomotopyMaps.apply Homotopy.domain U Homotopy.map (point zeroTime) = originPoint := trans!{Point} _ _ _ (mapFormula zeroTime)
  (\axiom:funext(Coordinates.addPoint originPoint (Coordinates.scale R.zero (Base.displacement (basePoint x))), originPoint,
    \fun (k: Fin.Fin dimension) => trans!{Real} _ _ _ (congr!{Real Real} (R.add (originPoint k)) _ _ (Laws.fieldMulZeroLeft (Base.displacement (basePoint x) k))) (Laws.addZeroRight (originPoint k))));
\definition atOne: HomotopyMaps.apply Homotopy.domain U Homotopy.map (point oneTime) = x := trans!{Point} (HomotopyMaps.apply Homotopy.domain U Homotopy.map (point oneTime)) (Coordinates.addPoint originPoint (Coordinates.scale R.one (Base.displacement (basePoint x)))) x (mapFormula oneTime)
  (\axiom:funext(Coordinates.addPoint originPoint (Coordinates.scale R.one (Base.displacement (basePoint x))), x,
    \fun (k: Fin.Fin dimension) => trans!{Real} _ _ _
      (congr!{Real Real} (R.add (originPoint k)) _ _ (Laws.fieldMulOneLeft (Base.displacement (basePoint x) k))) (Bounds.addSubCancel (x k) (originPoint k))));
\module Equations;
\module Weighted;
\module Center(centered: x = Graphs.apply branch.parameters U branch.graph (Projections.apply domain branch.parameters parameter x));
