\definition hessian: Smooth.SmoothFunction U := Partials.derivative U (Partials.derivative U f (Indices.right i)) (Indices.right j);
\definition function: TotalSmooth.SmoothFunction Homotopy.domain := Algebra.product weight (Pullback.function hessian);
\import Paths.Slice[W := domain, b := base, Z := Homotopy.domain, inside := inside, h := function] \as Slice;
\import Slice.Joint[] \as Joint;
\definition average: Smooth.SmoothFunction domain := Joint.average;
\definition section[x: Open.Carrier domain]: Average.Function := Joint.section x;
