\import \root.IndexFamily[d := dimension, n := n].On[U := U, A := hessianEntries, a := a] \as Family;
\definition symmetric: Family.Symmetric := \fun (x: Open.Carrier U)(i, j: Fin.Fin n) => eq_reason_in!{{R.Real} _
  "=" _ "by" { \parent.At[a := x].entriesValue i j }
  "=" _ "by" { hessianSymmetric x i j }
  "=" _ "by" { sym!{{R.Real}} _ _ (\parent.At[a := x].entriesValue j i) }
};
\definition locallyConstant: Nondegenerate a -> \exists Family.Local := Family.localExistence hessianEntriesRegular symmetric;
