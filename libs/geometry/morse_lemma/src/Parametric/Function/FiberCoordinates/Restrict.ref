\definition source[x: Open.Carrier V]: Open.Carrier domain := Open.inclusion V domain subset x;
\definition contained: Open.Included V U := \fun (x: Point)(inside: \In[Point] V.points x) => included x (subset x inside);
\definition point: Open.Carrier V := \into[Point](a, V.points) \by { containsPoint };
\import Gradients.Restriction[U := V, V := domain, W := Fibers.whole] \as Restriction;
\definition restricted: Gradients.Map V Fibers.whole := Restriction.input subset map;
\definition atCenter: Gradients.apply V Fibers.whole restricted point = zero := atBase;
\definition derivative: FullLinear.LinearMap := Gradients.Differential[U := V, V := Fibers.whole, f := restricted, a := point].value;
\definition verticalLaw: \forall (w: Vector) -> derivative.apply (Inverse.vertical.apply w) = w :=
  \fun (w: Vector) => trans!{Vector} _ _ _
    (congr!{{FullLinear.LinearMap} Vector} (\fun (L: FullLinear.LinearMap) => L.apply (Inverse.vertical.apply w)) _ _ (Restriction.differential subset map point))
    (vertical w);
