\import Inertia.Index[] \as Index;
\import MatrixForm.HalfCongruence[] \as Scaling;
\definition symmetry: MatrixForm.Symmetric (hessianEntries a) := \fun (i, j: Fin.Fin n) => eq_reason_in!{{R.Real} _
  "=" _ "by" { \parent.\parent.At[a := a].entriesValue i j }
  "=" _ "by" { hessianSymmetric a i j }
  "=" _ "by" { sym!{{R.Real}} _ _ (\parent.\parent.At[a := a].entriesValue j i) }
};
\definition negative: \forall (nonzero: Nondegenerate a) -> Index.negative local.normal.sign =
  Index.negativeIndex Scaling.On[A := hessianEntries a, symmetry := symmetry, nonzero := nonzero].raw :=
  \fun (nonzero: Nondegenerate a) => Scaling.normalNegative (hessianEntries a) symmetry nonzero local.normal;
\definition positive: \forall (nonzero: Nondegenerate a) -> Index.positive local.normal.sign =
  Index.positiveIndex Scaling.On[A := hessianEntries a, symmetry := symmetry, nonzero := nonzero].raw :=
  \fun (nonzero: Nondegenerate a) => Scaling.normalPositive (hessianEntries a) symmetry nonzero local.normal;
