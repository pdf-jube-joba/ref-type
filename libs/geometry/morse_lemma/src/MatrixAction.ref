\use std.Logic[].Equality[].eq_reason_in;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as R;
\import R.FiniteSums[] \as Sums;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Arithmetic;
\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import calculus.Real[].Multivariable[n := n].Open[] \as Target;
\import Open.Smooth[] \as Smooth;
\import Smooth.Differential[] \as Differential;
\import Smooth.Derivative[] \as Partials;
\import calculus.Maps[n := d, m := n] \as Maps;
\import calculus.MatrixFamily[d := d, p := n, q := n] \as Matrix;
\import linear_algebra.Euclidean[n := d] \as Domain;
\import linear_algebra.Euclidean[n := n] \as E;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real R.Algebra[].field] \as Spaces;
\import Spaces.Linear[V := E.Vector, W := E.Vector, source := E.space, target := E.space] \as End;
\import Spaces.Linear[V := Domain.Vector, W := E.Vector, source := Domain.space, target := E.space] \as Linear;
\import End.Composition[U := Domain.Vector, domain := Domain.space] \as Compose;
\module FiniteSum(U: Open.OpenSet);
\module On(U: Open.OpenSet, A: Open.Carrier U -> End.Map, regular: Matrix.Regular U A, v: Maps.Map U Target.whole);
