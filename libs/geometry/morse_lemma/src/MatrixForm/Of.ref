\import inverse_implicit.Euclidean[n := n].LinearInverse[d := Matrices.linear A] \as LinearInverse;
\definition nondegenerate: Inversion.Nonzero A -> Forms.Nondegenerate (form A) := \block {
  \fun (nonzero: Inversion.Nonzero A) \then
  \let B: Matrices.Operations[].Inverse A := Inversion.inverse (\into[Matrix](A, Inversion.Nonsingular) \by { nonzero }) \then
  \let inverse: Matrices.Operations[].Inverse (Representation.entries (Matrices.linear A)) :=
    \idelim A = Representation.entries (Matrices.linear A) \with C: Matrix => Matrices.Operations[].Inverse C \by {
      base: B, equality: sym!{Matrix} _ _ (Representation.entriesLinear A)
    } \then
  \fun (v: Vector)(annihilates: \forall (w: Vector) -> (form A).form v w = R.zero) \then
  \let zero: (Matrices.linear A).apply v = E.space.zero := E.separated ((Matrices.linear A).apply v) (annihilates ((Matrices.linear A).apply v)) \then
  \return eq_reason_in!{Vector v
    "=" _ "by" { sym!{Vector} _ _ (LinearInverse.left inverse v) }
    "=" _ "by" { congr!{Vector Vector} (LinearInverse.inverse inverse).apply _ _ zero }
    "=" _ "by" { (LinearInverse.inverse inverse).preservesZero }
  }
};
