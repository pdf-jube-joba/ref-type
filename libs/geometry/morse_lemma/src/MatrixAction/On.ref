\definition vectorSmooth: \forall (i: Fin.Fin n) -> Smooth.SmoothOn U (\fun (x: Open.Carrier U) => v.apply x i) :=
  (\bysub(Maps.Data[U, Target.whole], { data: Maps.Data[U, Target.whole] \where Maps.Laws[U, Target.whole, data] }, v)).smooth;
\import Matrix.Action[U := U, A := A, regular := regular, v := v.apply, smooth := vectorSmooth] \as Action;
\definition data: Maps.Data[U, Target.whole] := Maps.Data[U, Target.whole] {
  apply := \fun (x: Open.Carrier U) => \into[E.Vector]((A x).apply (v.apply x), Target.whole.points) \by { \refl((A x).apply (v.apply x)) },
};
\definition map: Maps.Map U Target.whole := \into[Maps.Data[U, Target.whole]](data,
  { f: Maps.Data[U, Target.whole] \where Maps.Laws[U, Target.whole, f] }) \by {
    Maps.Laws[U, Target.whole, data] { smooth := Action.smooth }
  };
\definition formula: \forall (x: Open.Carrier U) -> map.apply x = (A x).apply (v.apply x) := \fun (x: Open.Carrier U) => \refl((A x).apply (v.apply x));
\module At(a: Open.Carrier U);
