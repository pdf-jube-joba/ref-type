/* Local smooth congruence of nonsingular symmetric forms. */
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.sym;
\use Equality.trans;
\use Equality.eq_reason_in;
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as Order;
\import \root.MatrixCoordinates[n := n] \as Coordinates;
\import matrix_invariants.Ring[K := R.Real, scalars := std.Alg[].Field[].fieldAsCommutativeRing R.Real R.Algebra[].field].At[n := n] \as Matrices;
\import Matrices.Operations[] \as MatrixLaws;
\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\import R.Algebra[] \as Algebra;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real Algebra.field] \as Spaces;
\import Spaces.Matrix[I := Fin.Fin n, J := Fin.Fin n] \as Arrays;
\import Spaces.Sums[I := Fin.Fin n] \as Sums;
\import Sums.Prop[] \as SumLaws;
\import linear_algebra.Euclidean[n := Coordinates.dimension] \as E;
\import Spaces.Linear[V := E.Vector, W := E.Vector, source := E.space, target := E.space] \as Linear;
\import Linear.Operations[] \as LinearOperations;
\import calculus.Real[].Multivariable[n := Coordinates.dimension].Open[] \as Flat;
\import calculus.Maps[n := Coordinates.dimension, m := Coordinates.dimension] \as Maps;
\import Coordinates.Calculus[] \as Calculus;
\import Flat.Smooth[].Algebra[U := Flat.whole] \as Functions;
\definition two: R.Real := R.add R.one R.one;
\definition Symmetric[A: Matrices.Matrix]: \Prop := \forall (i, j: Fin.Fin n) -> A i j = A j i;
\module Left(B: Matrices.Matrix);
\module Polynomial(B: Matrices.Matrix);
\module Congruence(B: Matrices.Matrix);
\module On(U: Open.OpenSet);
