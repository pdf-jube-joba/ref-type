\definition finalIncluded: Open.Included local.domain U := \fun (x: Point)(member: _) => included x (local.included x member);
\definition finalContains: \In[Point] local.domain.points a := local.contains;
\definition finalPoint: Open.Carrier local.domain := \into[Point](a, local.domain.points) \by { finalContains };
\definition containsOrigin: \In[Point] local.target.points E.space.zero := \idelim coordinatesValue origin = E.space.zero
  \with y: Point => \In[Point] local.target.points y \by { base: local.containsImage, equality: coordinatesZero };
\definition value: Local := Local {
  normal := normal, domain := local.domain, target := local.target, included := finalIncluded,
  contains := finalContains, containsOrigin := containsOrigin, equivalence := local.equivalence,
  center := \fun (i: Fin.Fin n) => trans!{{R.Real}} _ _ _
    (congr!{Point {R.Real}} (\fun (y: Point) => y i) _ _ (local.forward finalPoint))
    (congr!{Point {R.Real}} (\fun (y: Point) => y i) _ _ coordinatesZero),
  formula := \fun (x: Open.Carrier local.domain) => trans!{{R.Real}} _ _ _ (quadraticFormula (Open.inclusion local.domain domain local.included x))
    (congr!{Point Point {R.Real}} (\fun (v, w: Point) => R.add (f a) (Inertia.standard normal.sign v w)) _ _ _ _
      (sym!{Point} _ _ (local.forward x)) (sym!{Point} _ _ (local.forward x))),
};
