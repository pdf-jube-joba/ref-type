\import Inertia.Index[] \as Index;
\import MatrixForm.HalfCongruence[] \as Scaling;
\definition symmetry: MatrixForm.Symmetric (Function.hessianEntries a) := \fun (i, j: Fin.Fin n) => eq_reason_in!{{R.Real} _
  "=" _ "by" { Function.hessianEntriesValue a i j }
  "=" _ "by" { Function.hessianSymmetric a i j }
  "=" _ "by" { sym!{{R.Real}} _ _ (Function.hessianEntriesValue a j i) }
};
\definition negative: \forall (nonzero: Function.Nondegenerate a) -> Index.negative local.normal.sign =
  Index.negativeIndex Scaling.On[A := Function.hessianEntries a, symmetry := symmetry, nonzero := nonzero].raw :=
  \fun (nonzero: Function.Nondegenerate a) => Scaling.normalNegative (Function.hessianEntries a) symmetry nonzero local.normal;
\definition positive: \forall (nonzero: Function.Nondegenerate a) -> Index.positive local.normal.sign =
  Index.positiveIndex Scaling.On[A := Function.hessianEntries a, symmetry := symmetry, nonzero := nonzero].raw :=
  \fun (nonzero: Function.Nondegenerate a) => Scaling.normalPositive (Function.hessianEntries a) symmetry nonzero local.normal;
