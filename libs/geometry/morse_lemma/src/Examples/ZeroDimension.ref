\import calculus.Real[].Multivariable[n := N.Nat^::zero].Open[] \as Open;
\definition point: Open.Carrier Open.whole := \into[Fin.Fin N.Nat^::zero -> R.Real]((\fun (i: Fin.Fin N.Nat^::zero) => R.zero), Open.whole.points) \by {
  \refl(\fun (i: Fin.Fin N.Nat^::zero) => R.zero)
};
\definition function: Open.Smooth[].SmoothFunction Open.whole := Open.Smooth[].Algebra[U := Open.whole].constant R.one;
\import \root.Euclidean[n := N.Nat^::zero].Function[U := Open.whole, f := function] \as Morse;
\definition critical: Morse.Critical point := \fun (i: Fin.Fin N.Nat^::zero) => Logic.falseElim _ (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i));
\definition nondegenerate: Morse.Nondegenerate point := \fun (zero: _) => Laws.zeroNeOne (sym!{{R.Real}} _ _ zero);
\definition isolated: \exists Morse.IsolatingNeighborhood[point] := Morse.isolated point nondegenerate critical;
\import \root.NormalForm[n := N.Nat^::zero, U := Open.whole, f := function, a := point] \as Coordinates;
\definition normalFormExists: \exists Coordinates.Local := Coordinates.localExistence critical nondegenerate;
