\import \parent.\parent.Left[B := P] \as Other;
\definition left: \forall (v: E.Vector) -> Other.value.apply (value.apply v) = v :=
  \fun (v: E.Vector) => eq_reason_in!{{E.Vector} _
    "=" _ "by" { congr!{{Matrices.Matrix} {E.Vector}} (\fun (A: Matrices.Matrix) => Coordinates.pack (Matrices.product P A)) _ _ (unpackValue v) }
    "=" _ "by" { congr!{{Matrices.Matrix} {E.Vector}} Coordinates.pack _ _ (sym!{{Matrices.Matrix}} _ _ (MatrixLaws.associative P B (Coordinates.unpack v))) }
    "=" _ "by" { congr!{{Matrices.Matrix} {E.Vector}} (\fun (A: Matrices.Matrix) => Coordinates.pack (Matrices.product A (Coordinates.unpack v))) _ _ ((MatrixLaws.inverseLaws B P).left) }
    "=" _ "by" { congr!{{Matrices.Matrix} {E.Vector}} Coordinates.pack _ _ (MatrixLaws.leftIdentity (Coordinates.unpack v)) }
    "=" _ "by" { Coordinates.packUnpack v }
  };
\definition right: \forall (v: E.Vector) -> value.apply (Other.value.apply v) = v :=
  \fun (v: E.Vector) => eq_reason_in!{{E.Vector} _
    "=" _ "by" { congr!{{Matrices.Matrix} {E.Vector}} (\fun (A: Matrices.Matrix) => Coordinates.pack (Matrices.product B A)) _ _ (Other.unpackValue v) }
    "=" _ "by" { congr!{{Matrices.Matrix} {E.Vector}} Coordinates.pack _ _ (sym!{{Matrices.Matrix}} _ _ (MatrixLaws.associative B P (Coordinates.unpack v))) }
    "=" _ "by" { congr!{{Matrices.Matrix} {E.Vector}} (\fun (A: Matrices.Matrix) => Coordinates.pack (Matrices.product A (Coordinates.unpack v))) _ _ ((MatrixLaws.inverseLaws B P).right) }
    "=" _ "by" { congr!{{Matrices.Matrix} {E.Vector}} Coordinates.pack _ _ (MatrixLaws.leftIdentity (Coordinates.unpack v)) }
    "=" _ "by" { Coordinates.packUnpack v }
  };
