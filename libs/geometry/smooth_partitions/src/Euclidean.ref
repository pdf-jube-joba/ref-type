\import std.Data[].Nat[].Basic[].Prop[] \as Nat;
\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Classical[] \as Classical;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason;
\use Logic.either;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import calculus.Real[].Multivariable[n := n] \as Model;
\import Model.Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\import Open.Restriction[] \as Restriction;
\import Open.Topology[] \as Topology;
\import Smooth.Operations[] \as Operations;
\import topology.Topology[Carrier := Model.Point] \as Space;
\import Space.Closure[] \as Closure;
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as Ambient;
\definition Function: \Set := Model.Point -> Real.Real;
\definition IsSmooth[f: Function]: \Prop := Smooth.SmoothOn Open.whole (Restriction.function Open.whole f);
\definition Nonzero[f: Function]: \Pow Model.Point := { x: Model.Point \where Logic.Not (f x = Real.zero) };
\definition support[f: Function]: \Pow Model.Point := Closure.closure Ambient.topology (Nonzero f);
\definition smoothCongruent: \forall (U: Open.OpenSet)(f, g: Open.ScalarFunction U) ->
  (\forall (x: Open.Carrier U) -> f x = g x) -> Smooth.SmoothOn U f -> Smooth.SmoothOn U g :=
  \fun (U: _)(f, g: _)(equal: _)(smooth: _) => \idelim f = g
    \with h: Open.ScalarFunction U => Smooth.SmoothOn U h \by {
      base: smooth, equality: \axiom:funext(f, g, equal)
    };
\module ZeroExtension(U: Open.OpenSet, f: Open.ScalarFunction U);
\import \root.Countable[A := Model.Point] \as Countable;
\module LocallyFinite(f: Countable.Family);
\module Products;
\definition Positive: \Set := \Cast[Real.Real] ({ r: Real.Real \where R.Lt Real.zero r });
\module LocalBump(a: Model.Point, q: Positive);
\module ScalarCalculus;
\module CompactCutoff(K: \Pow Model.Point, U: Open.OpenSet);
\module Jets(f: Function);
