\import Calculus.OneDimension[] \as One;
\import Calculus.Multivariable[n := One.dimension] \as Model;
\import Model.Open[] \as Open;
\import topological_algebra.Euclidean[].Dimension[n := One.dimension] \as Euclidean;
\import Euclidean.Norm[] \as Norm;
\import Euclidean.Def[] \as Coordinates;
\import differential_equations.Euclidean[n := One.dimension] \as ODE;
\import std.Set[].Extension[A := ODE.Vector, B := ODE.Vector, domain := Open.whole.points] \as DomainExtension;
\import calculus.Identity[n := One.dimension] \as Identity;
\definition initial: Open.Carrier Open.whole := \into[Model.Point]((\fun (i: One.Index) => Real.one), Open.whole.points) \by { \refl(\fun (i: One.Index) => Real.one) };
\import ODE.Smooth[U := Open.whole, field := Identity.map Open.whole, a := initial] \as Equation;
\definition halfPositive: R.Lt Real.zero Real.half := R.ltReplaceRight Real.zero (Real.mul Real.half Real.one) Real.half
  (Algebra.mulOneRight Real.half) (Estimates.halfOfPositive Real.one Product.onePositive);
\definition halfBelow: R.Le Real.half Real.one := R.leReplaceLeft (Real.mul Real.half Real.one) Real.half Real.one
  (Algebra.mulOneRight Real.half) (Estimates.halfBelow Real.one Laws.oneNonnegative);
\definition subtractHalf: Real.sub Real.one Real.half = Real.half := trans!{Scalar} _ _ _
  (congr!{Scalar Scalar} (Real.sub Real.one) _ _ (sym!{Scalar} _ _ (Algebra.mulOneRight Real.half)))
  (trans!{Scalar} _ _ _ (Inverse.halfComplement Real.one) (Algebra.mulOneRight Real.half));
\module Of(solution: Equation.LocalSolution);
\definition existsPatch: \exists Patch := \block {
  \takefrom solution: Equation.LocalSolution \by Equation.localExistence \then
  \return Of[solution := solution].existsPatch
};
