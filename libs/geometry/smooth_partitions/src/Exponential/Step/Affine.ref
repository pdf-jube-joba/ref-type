\definition map: Maps.Map Open.whole Open.whole := Maps.Map[Open.whole, Open.whole] {
  apply := \fun (x: Open.Carrier Open.whole) => \into[Model.Point]((\fun (i: One.Index) => Real.add a (Real.mul b (x One.index))), Open.whole.points) \by { \refl(\fun (i: One.Index) => Real.add a (Real.mul b (x One.index))) },
  smooth := \fun (i: One.Index) => Operations.addSmooth Open.whole (\fun (x: Open.Carrier Open.whole) => a)
    (\fun (x: Open.Carrier Open.whole) => Real.mul b (x One.index)) (Operations.constantSmooth Open.whole a)
    (Operations.scaleSmooth Open.whole b (\fun (x: Open.Carrier Open.whole) => x One.index) (Examples.projectionSmooth Open.whole One.index)),
};
\import Maps.Composition[U := Open.whole, V := Open.whole, f := map] \as Composition;
\definition step: Partials.Function Open.whole := \into[Open.ScalarFunction Open.whole]((\fun (x: Open.Carrier Open.whole) => value (x One.index)),
  { f: Open.ScalarFunction Open.whole \where Smooth.SmoothOn Open.whole f }) \by { smooth };
\definition smoothPullback: Smooth.SmoothOn Open.whole (\fun (x: Open.Carrier Open.whole) => value (Real.add a (Real.mul b (x One.index)))) := Composition.smooth step;
