\import \root.Exponential[].Interval[a := Real.sub t Real.one, b := Real.zero] \as Interval;
\definition derivative: Derivatives.HasDerivativeAt (function p) t (function (next p) t) :=
  \idelim Real.zero = function (next p) t \with d: Scalar => Derivatives.HasDerivativeAt (function p) t d \by {
    base: Interval.localDerivative (\fun (u: Scalar) => Real.zero) (function p) t Real.zero
      (Logic.And[_, _]::#
        (R.ltReplaceRight (Real.sub t Real.one) (Real.add t Real.zero) t (Laws.addZeroRight t)
          (Laws.ltAddLeft t (Real.neg Real.one) Real.zero (Laws.negativeNegOfPositive Real.one Product.onePositive))) negative)
      (\fun (u: Scalar)(inside: Interval.Contains u) => sym!{Scalar} _ _ (negativeAgreement p u inside.right)) (Basic.constantDerivative Real.zero t),
    equality: sym!{Scalar} _ _ (negativeAgreement (next p) t negative)
  };
