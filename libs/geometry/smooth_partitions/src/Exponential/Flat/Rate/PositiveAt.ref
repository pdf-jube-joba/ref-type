\definition inverseT: Scalar := Laws.fieldInv t;
\definition inverseTPositive: R.Lt Real.zero inverseT := Product.invPositive t positive;
\definition exponent: Scalar := Real.mul c inverseT;
\definition exponentPositive: R.Lt Real.zero exponent := Product.mulPositive c inverseT cPositive inverseTPositive;
\definition inverseExponent: Laws.fieldInv exponent = Real.mul inverseCoefficient t := sym!{Scalar} _ _
  (Inverse.inverseUnique exponent (Real.mul inverseCoefficient t) (Inverse.positiveNonzero exponent exponentPositive)
    (trans!{Scalar} _ _ _ (Algebra.mulFour inverseCoefficient t c inverseT)
      (trans!{Scalar} _ _ _
        (congr!{Scalar Scalar Scalar} Real.mul _ _ _ _ (Laws.fieldInverseNonzero c (Inverse.positiveNonzero c cPositive))
          (trans!{Scalar} _ _ _ (Laws.fieldMulComm t inverseT) (Laws.fieldInverseNonzero t (Inverse.positiveNonzero t positive))))
        (Laws.fieldMulOneLeft Real.one))));
\definition upper: R.Le (value t) (Real.mul inverseCoefficient t) := R.leReplace
  (Laws.fieldInv (Exp.value exponent)) (value t) (Laws.fieldInv exponent) (Real.mul inverseCoefficient t)
  (sym!{Scalar} _ _ (trans!{Scalar} _ _ _ (positiveValue t positive) (Exp.negative exponent))) inverseExponent
  (Inverse.invAntitone exponent (Exp.value exponent) exponentPositive (Exp.positive exponent) (Exp.linearLower exponent exponentPositive));
\definition estimate: R.Le (Real.distance (value t) Real.zero) (Real.mul inverseCoefficient (Real.distance t Real.zero)) := R.leReplace
  (value t) (Real.distance (value t) Real.zero) (Real.mul inverseCoefficient t) (Real.mul inverseCoefficient (Real.distance t Real.zero))
  (sym!{Scalar} _ _ (magnitudeNonnegative (value t) (nonnegative t)))
  (congr!{Scalar Scalar} (Real.mul inverseCoefficient) _ _ (sym!{Scalar} _ _ (magnitudeNonnegative t (Order.leOfLt _ _ positive)))) upper;
\definition scaledUpper: R.Le (Real.mul inverseT (value t)) inverseCoefficient :=
  R.leReplaceRight (Real.mul inverseT (value t)) (Real.mul inverseT (Real.mul inverseCoefficient t)) inverseCoefficient
    (trans!{Scalar} _ _ _ (Algebra.mulSwap inverseT inverseCoefficient t)
      (trans!{Scalar} _ _ _ (congr!{Scalar Scalar} (Real.mul inverseCoefficient) _ _ (Laws.fieldInverseNonzero t (Inverse.positiveNonzero t positive))) (Algebra.mulOneRight inverseCoefficient)))
    (Estimates.mulMonotone inverseT (value t) (Real.mul inverseCoefficient t) (Order.leOfLt _ _ inverseTPositive) upper);
