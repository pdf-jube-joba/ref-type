\import \parent.\parent.Interval[a := Real.neg patch.radius, b := patch.radius] \as Interval;
\definition derivative: Derivatives.HasDerivativeAt value t (value t) := \idelim patch.value t = value t
  \with d: Scalar => Derivatives.HasDerivativeAt value t d \by {
    base: Interval.localDerivative (patch.value) value t (patch.value t) inside
      (\fun (x: Scalar)(member: _) => sym!{Scalar} _ _ (law x patch member)) (patch.derivative t inside),
    equality: sym!{Scalar} _ _ (law t patch inside)
  };
