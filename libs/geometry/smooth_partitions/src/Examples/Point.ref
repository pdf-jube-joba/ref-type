\import manifolds.Dimension[n := N.Nat^::zero].Examples[].Euclidean[] \as Model;
\import topological_algebra.Euclidean[].Zero[] \as Point;
\import topology.Topology[Carrier := Point.Point] \as Space;
\import Space.Compactness[] \as Compact;
\import \root.Manifold[n := N.Nat^::zero].On[M := Model.smoothManifold] \as Manifold;
\import \root.Scalars[A := Point.Point, space := Model.smoothManifold.space].Using[calculus := Manifold.calculus] \as Functions;
\definition compact: Space.IsCompact Model.smoothManifold.space := \idelim Space.Singleton Point.origin = Space.Whole
  \with S: \Pow Point.Point => Space.IsCompactIn Model.smoothManifold.space S \by {
    base: Compact.singletonCompact Model.smoothManifold.space Point.origin,
    equality: \axiom:setext(Space.Singleton Point.origin, Space.Whole, \fun (x: Point.Point)(member: _) => \refl(x), \fun (x: Point.Point)(member: _) => Point.unique x Point.origin)
  };
\definition family: \Pow (\Pow Point.Point) := { U: \Pow Point.Point \where U = Space.Whole };
\definition cover: Space.IsOpenCover[Model.smoothManifold.space, family, Space.Whole] := Space.IsOpenCover[Model.smoothManifold.space, family, Space.Whole] {
  open := \fun (U: \Pow Point.Point)(equal: U = Space.Whole) => \idelim Space.Whole = U \with V: \Pow Point.Point => Space.IsOpenIn Model.smoothManifold.space V \by {
    base: (Space.topologyLaws Model.smoothManifold.space).wholeOpen, equality: sym!{{\Pow Point.Point}} _ _ equal
  },
  covers := \fun (x: Point.Point)(member: _) => Space.unionMemberOf family Space.Whole x (\refl(Space.Whole)) (\refl(x)),
};
\definition finitePartition: \exists Functions.FinitePartition[family] := Manifold.Partitions[family := family].existsFinitePartition compact cover;
\module Sections;
