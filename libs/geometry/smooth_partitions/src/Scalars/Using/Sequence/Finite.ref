\definition total[x: A]: Countable.prefix values x k = Real.one := eq_reason!{
  {Countable.prefix values x k} "=" {Real.add (Countable.prefix values x k) Real.zero} "by" {sym!{Real.Real} _ _ (Laws.addZeroRight _)}
  "=" {Real.add (Countable.prefix values x k) (residue k x)} "by" {congr!{Real.Real Real.Real} (Real.add (Countable.prefix values x k)) _ _
    (sym!{Real.Real} _ _ (\parent.FiniteCover[S := Space.Whole].residueZero k x (covered x (\refl(x)))))}
  "=" Real.one "by" {normalization k x}
};
\definition partition: FinitePartition[family] := FinitePartition[family] {
  size := k, functions := part, targets := \fun (i: N.Nat^) => (bumps i).openSet,
  refines := \fun (i: N.Nat^)(bound: _) => (bumps i).inCover,
  subordinate := \fun (i: N.Nat^)(bound: _) => Space.subsetTrans _ _ _ (partSupport i) (bumps i).supportWithin,
  lower := \parent.Bounds[].partLower, upper := \parent.Bounds[].partUpper, total := total,
};
