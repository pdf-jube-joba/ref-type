\definition emptyClosed: Space.IsClosedIn space Space.Empty := \idelim Space.Whole = Space.Complement Space.Empty
  \with U: \Pow A => Space.IsOpenIn space U \by {
    base: (Space.topologyLaws space).wholeOpen,
    equality: \axiom:setext(Space.Whole, Space.Complement Space.Empty,
      \fun (x: A)(whole: _)(empty: Logic.False) => empty, \fun (x: A)(member: _) => \refl(x))
  };
\definition zeroSupport: support (constant Real.zero) = Space.Empty := \axiom:setext(support (constant Real.zero), Space.Empty,
  Closure.least space (Nonzero (constant Real.zero)) Space.Empty emptyClosed
    (\fun (x: A)(nonzero: Logic.Not (Real.zero = Real.zero)) => nonzero (\refl(Real.zero))),
  \fun (x: A)(empty: Logic.False) => Logic.falseElim _ empty);
\definition bump[family: \Pow (\Pow A)]: Bump[family] := Bump[family] {
  value := constant Real.zero, openSet := Space.Empty, inCover := Logic.Or[_, _]::right (\refl(Space.Empty)),
  supportWithin := \fun (x: A)(member: _) => \idelim support (constant Real.zero) = Space.Empty \with U: \Pow A => Space.Member U x \by { base: member, equality: zeroSupport },
  supportCompact := \idelim Space.Empty = support (constant Real.zero) \with U: \Pow A => Space.IsCompactIn space U \by {
    base: Compact.emptyCompact space, equality: sym!{{\Pow A}} _ _ zeroSupport
  },
  oneRegion := Space.Empty, regionOpen := (Space.topologyLaws space).emptyOpen,
  oneOn := \fun (x: A)(empty: Logic.False) => Logic.falseElim _ empty,
  lower := \fun (x: A) => R.leRefl Real.zero, upper := \fun (x: A) => Laws.oneNonnegative,
};
