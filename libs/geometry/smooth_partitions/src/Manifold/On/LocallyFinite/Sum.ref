\import Countable.Sum[f := f, finite := pointwiseFinite local] \as Sum;
\import \parent.\parent.Locality[f := Sum.value] \as Local;
\definition value: Function := Sum.value;
\definition smooth: (\forall (k: N.Nat^) -> IsSmooth (f k)) -> IsSmooth value := \fun (regular: _) => Local.smooth (\block {
  \fun (x: M.Point) \then
  \takefrom neighborhood: Neighborhood x \by local x \then
  \return \exact(Local.Patch[x] {
    openSet := neighborhood.openSet, open := neighborhood.open, contains := neighborhood.contains,
    value := \fun (y: M.Point) => Countable.prefix f y neighborhood.bound,
    smooth := prefixSmooth regular neighborhood.bound,
    agrees := \fun (y: M.Point)(member: Space.Member neighborhood.openSet y) => Sum.law y neighborhood.bound (neighborhood.vanishes y member),
  }, Local.Patch x)
});
