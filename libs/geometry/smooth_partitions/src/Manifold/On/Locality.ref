\structure Patch[x: M.Point]: \Set := {
  openSet: \Pow M.Point,
  open: Space.IsOpenIn M.space openSet,
  contains: Space.Member openSet x,
  value: Function,
  smooth: IsSmooth value,
  agrees: \forall (y: M.Point) -> Space.Member openSet y -> f y = value y,
};
\module InChart(c: Chart);
\definition smooth: (\forall (x: M.Point) -> \exists Patch x) -> IsSmooth f :=
  \fun (local: _)(c: Chart) => InChart[c := c].smooth local;
