\import Real.Estimates[] \as Estimates;
\import Real.Algebra[] \as Algebra;
\import topological_algebra.Euclidean[].Dimension[n := n].Norm[] \as Norm;
\import topological_algebra.Euclidean[].Dimension[n := n].Def[] \as Coordinates;
\definition q: Euclidean.Positive := \into[Real.Real](Real.mul Real.half (Real.mul Real.half r), { q: Real.Real \where R.Lt Real.zero q }) \by {
  Estimates.halfOfPositive (Real.mul Real.half r) (Estimates.halfOfPositive r ball.positive)
};
\import Euclidean.LocalBump[a := a, q := q] \as LocalBump;
\definition radiusEquality: LocalBump.radius = Real.mul Real.half r := trans!{Real.Real} _ _ _
  (Laws.fieldMulAdd q Real.one Real.one)
  (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ (Algebra.mulOneRight q) (Algebra.mulOneRight q)) (Estimates.halfTwice (Real.mul Real.half r)));
\definition envelopeWithin: AmbientSpace.Subset LocalBump.envelope Neighborhood.domain.points := \fun (u: Model.Point)(member: AmbientSpace.Member LocalBump.envelope u) =>
  ball.included u (R.leLtTrans _ _ _
    (R.leReplaceLeft (Coordinates.pointDistance a u) (Coordinates.pointDistance u a) LocalBump.radius (Norm.distanceSymmetric a u) member)
    (R.ltReplaceLeft (Real.mul Real.half r) LocalBump.radius r (sym!{Real.Real} _ _ radiusEquality) (Estimates.halfStrict r ball.positive)));
\definition included: AmbientSpace.Subset LocalBump.envelope c.image.points := \fun (u: Model.Point)(member: AmbientSpace.Member LocalBump.envelope u) => Neighborhood.included u (envelopeWithin u member);
\import \parent.\parent.\parent.ChartBump[c := c, a := a, q := q, included := included] \as Global;
\import Global.Region[] \as Region;
\definition supportWithin: Space.Subset (support Global.value) U := \fun (y: M.Point)(supported: Space.Member (support Global.value) y) => \block {
  \let member: Space.Member Global.envelope y := Global.supportWithin y supported \then
  \takefrom u: \Cast[\Cast[Model.Point] LocalBump.envelope] ({ u: \Cast[Model.Point] LocalBump.envelope \where Logic.And[u = u, Global.imagePoint u = y] }) \by member \then
  \let equal: Global.imagePoint u = y := (\bysub(\Cast[Model.Point] LocalBump.envelope,
    { u: \Cast[Model.Point] LocalBump.envelope \where Logic.And[u = u, Global.imagePoint u = y] }, u)).right \then
  \let v: Open.Carrier Neighborhood.domain := \into[Model.Point](u, Neighborhood.domain.points) \by { envelopeWithin u (\bysub(Model.Point, LocalBump.envelope, u)) } \then
  \return \idelim Global.imagePoint u = y \with z: M.Point => Space.Member U z \by { base: Neighborhood.point v, equality: equal }
};
\definition bump: Functions.Bump[family] := Functions.Bump[family] {
  value := \into[Function](Global.value, calculus.smooth) \by { Global.smooth },
  openSet := U, inCover := Logic.Or[_, _]::left member,
  supportWithin := supportWithin, supportCompact := Global.supportCompact,
  oneRegion := Region.region, regionOpen := Region.open, oneOn := Region.oneOn,
  lower := Global.lower, upper := Global.upper,
};
\definition existsBump: \exists ( b: Functions.Bump[family] \where Space.Member b.oneRegion x ) := Logic.existsIntro[Functions.Bump[family], { b: Functions.Bump[family] \where Space.Member b.oneRegion x }] bump
  (\idelim Charts.point c a = x \with y: M.Point => Space.Member Region.region y \by { base: Region.center a (\refl(a)), equality: Geometry.pointCoordinate x });
