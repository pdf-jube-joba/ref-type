\import \parent.\parent.Neighborhood[c := c, U := U, open := open] \as Neighborhood;
\import Charts.Of[chart := c] \as Geometry;
\definition a: Open.Carrier c.image := Charts.coordinate c x;
\definition inNeighborhood: AmbientSpace.Member Neighborhood.domain.points a := Neighborhood.contains a
  (\idelim x = Charts.point c a \with y: M.Point => Space.Member U y \by { base: inside, equality: sym!{M.Point} _ _ (Geometry.pointCoordinate x) });
\module Radius(r: Real.Real, ball: Open.BallInside[Neighborhood.domain.points, a, r]);
\definition existsBump: \exists ( b: Functions.Bump[family] \where Space.Member b.oneRegion x ) := \block {
  \takefrom r: \Cast[Real.Real] ({ r: Real.Real \where Open.BallInside[Neighborhood.domain.points, a, r] }) \by Neighborhood.domain.open a inNeighborhood \then
  \return Radius[r := r, ball := \bysub(Real.Real, { r: Real.Real \where Open.BallInside[Neighborhood.domain.points, a, r] }, r)].existsBump
};
