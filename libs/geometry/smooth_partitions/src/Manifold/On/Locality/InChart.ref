\import Open.LocalSmooth[U := c.image, f := coordinates c f] \as Local;
\module At(u: Open.Carrier c.image, patch: Patch (Charts.point c u));
\definition smooth: (\forall (x: M.Point) -> \exists Patch x) -> Smooth.SmoothOn c.image (coordinates c f) :=
  \fun (local: _) => Local.smooth (\block {
    \fun (u: Open.Carrier c.image) \then
    \takefrom patch: Patch (Charts.point c u) \by local (Charts.point c u) \then
    \return At[u := u, patch := patch].existsPatch
  });
