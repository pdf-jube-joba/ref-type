\import \parent.\parent.\parent.Neighborhood[c := c, U := patch.openSet, open := patch.open] \as Neighborhood;
\definition value: Local.Patch := Local.Patch {
  domain := Neighborhood.domain, included := Neighborhood.included,
  smooth := Euclidean.smoothCongruent Neighborhood.domain
    (Open.restrict Neighborhood.domain c.image Neighborhood.included (coordinates c patch.value))
    (Open.restrict Neighborhood.domain c.image Neighborhood.included (coordinates c f))
    (\fun (v: Open.Carrier Neighborhood.domain) => sym!{Real.Real} _ _ (patch.agrees (Charts.point c (Open.inclusion Neighborhood.domain c.image Neighborhood.included v)) (Neighborhood.point v)))
    (Restriction.localSmooth Neighborhood.domain c.image Neighborhood.included (coordinates c patch.value) (patch.smooth c)),
};
\definition existsPatch: \exists \Cast[Local.Patch] (Local.Patches u) := Logic.existsIntro[Local.Patch, Local.Patches u] value (Neighborhood.contains u patch.contains);
