\definition patch: Local.Patch := Local.Patch {
  domain := Transition.domain, included := includedOverlap,
  smooth := Euclidean.smoothCongruent Transition.domain (Composition.scalar bumpFunction)
    (Open.restrict Transition.domain other.image includedOverlap (coordinates other value))
    (\fun (v: Open.Carrier Transition.domain) => sym!{Real.Real} _ _ (inside (Transition.overlapPoint v))) (Composition.smooth bumpFunction),
};
\definition existsPatch: \exists \Cast[Local.Patch] (Local.Patches u) := Logic.existsIntro[Local.Patch, Local.Patches u] patch (Transition.intro u member);
