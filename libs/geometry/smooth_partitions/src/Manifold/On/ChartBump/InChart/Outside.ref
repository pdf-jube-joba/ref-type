\import \parent.\parent.\parent.Neighborhood[c := other, U := Space.Complement envelope, open := envelopeClosed] \as Neighborhood;
\definition patch: Local.Patch := Local.Patch {
  domain := Neighborhood.domain, included := Neighborhood.included,
  smooth := Euclidean.smoothCongruent Neighborhood.domain (\fun (v: Open.Carrier Neighborhood.domain) => Real.zero)
    (Open.restrict Neighborhood.domain other.image Neighborhood.included (coordinates other value))
    (\fun (v: Open.Carrier Neighborhood.domain) => sym!{Real.Real} _ _ (zeroAway (Charts.point other (Open.inclusion Neighborhood.domain other.image Neighborhood.included v)) (Neighborhood.point v)))
    (Operations.constantSmooth Neighborhood.domain Real.zero),
};
\definition existsPatch: \exists \Cast[Local.Patch] (Local.Patches u) := Logic.existsIntro[Local.Patch, Local.Patches u] patch
  (Neighborhood.contains u (\fun (member: Space.Member envelope (Charts.point other u)) => outside (envelopeWithin (Charts.point other u) member)));
