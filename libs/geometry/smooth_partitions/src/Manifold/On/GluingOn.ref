\definition intersection: \Pow M.Point := Space.Intersection V U;
\definition intersectionOpen: Space.IsOpenIn M.space intersection := (Space.topologyLaws M.space).intersectionOpen V U openV openU;
\import \parent.OnOpen[U := V, open := openV] \as Target;
\import \parent.OnOpen[U := intersection, open := intersectionOpen] \as Source;
\definition ZeroAway: \Prop := \forall (x: M.Point) -> Logic.Not (Space.Member F x) -> f x = Real.zero;
\module InChart(c: Chart);
\definition smooth: Source.IsSmooth (Source.restrict f) -> ZeroAway -> Target.IsSmooth (Target.restrict f) :=
  \fun (regular: _)(zero: _)(c: Chart) => InChart[c := c].smooth (regular c) zero;
