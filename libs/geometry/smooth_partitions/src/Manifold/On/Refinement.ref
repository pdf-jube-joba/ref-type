\import N.Basic[].Prop[] \as Nat;
\import Functions.Refinement[family := family, partition := partition] \as Refinement;
\import \parent.Continuity[] \as Continuity;
\definition region: N.Nat^ -> \Pow M.Point := Refinement.region;
\definition open[k: N.Nat^]: Space.IsOpenIn M.space (region k) := Refinement.open k
  (Continuity.continuous (partition.functions k) (\bysub(Function, calculus.smooth, partition.functions k)));
\definition covers: \forall (x: M.Point) -> \exists ( k: N.Nat^ \where Space.Member (region k) x ) := Refinement.covers;
\definition within[k: N.Nat^]: Space.Subset (region k) (partition.targets k) := Refinement.within k;
\definition locallyFinite: \forall (x: M.Point) -> \exists ( neighborhood: Functions.FiniteNeighborhood[partition.functions, x] \where
  \forall (k: N.Nat^) -> Nat.Le neighborhood.bound k -> Space.Disjoint neighborhood.openSet (region k) ) := Refinement.locallyFinite;
\definition target[k: N.Nat^]: (\exists \Cast[M.Point] (region k)) ->
  \exists ( U: \Pow M.Point \where Logic.And[Space.FamilyMember family U, Space.Subset (region k) U] ) := Refinement.target k;
