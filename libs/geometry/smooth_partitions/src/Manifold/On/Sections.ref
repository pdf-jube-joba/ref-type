\import std.Data[].FinSet[] \as Fin;
\definition Vector[r: N.Nat^]: \Set := Fin.Fin r -> Real.Real;
\structure Section: \Set := { value: \forall (x: M.Point) -> F x };
\structure Frame: \Set := {
  domain: \Pow M.Point,
  open: Space.IsOpenIn M.space domain,
  rank: N.Nat^,
  coordinate: \forall (x: M.Point) -> F x -> Vector rank,
  inverse: \forall (x: M.Point) -> Vector rank -> F x,
  leftInverse: \forall (x: M.Point) -> Space.Member domain x -> \forall (v: F x) -> inverse x (coordinate x v) = v,
  rightInverse: \forall (x: M.Point) -> Space.Member domain x -> \forall (v: Vector rank) -> coordinate x (inverse x v) = v,
  zero: \forall (x: M.Point)(i: Fin.Fin rank) -> coordinate x (zero x) i = Real.zero,
};
\structure Atlas: \Set := {
  frames: \Pow Frame,
  covers: \forall (x: M.Point) -> \exists ( frame: Frame \where Logic.And[\In[Frame] frames frame, Space.Member frame.domain x] ),
};
\module Over(atlas: Atlas);
