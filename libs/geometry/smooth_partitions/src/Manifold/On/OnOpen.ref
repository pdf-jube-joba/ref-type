\definition GlobalSmooth[f: M.Point -> Real.Real]: \Prop := \forall (c: Chart) -> Smooth.SmoothOn c.image (\fun (u: Open.Carrier c.image) => f (Charts.point c u));
\definition Carrier: \Set := \Cast[M.Point] U;
\definition Function: \Set := Carrier -> Real.Real;
\definition restrict[f: M.Point -> Real.Real][x: Carrier]: Real.Real := f x;
\module InChart(c: Chart);
\definition IsSmooth[f: Function]: \Prop := \forall (c: Chart) -> Smooth.SmoothOn (InChart[c := c].domain) (InChart[c := c].coordinates f);
\definition restrictSmooth: \forall (f: M.Point -> Real.Real) -> GlobalSmooth f -> IsSmooth (restrict f) :=
  \fun (f: _)(regular: _)(c: Chart) => InChart[c := c].restrictSmooth f (regular c);
\module ZeroExtension(f: Function);
\definition congruent[f, g: Function]: (\forall (x: Carrier) -> f x = g x) -> IsSmooth f -> IsSmooth g :=
  \fun (equal: _)(regular: _)(c: Chart) => Euclidean.smoothCongruent (InChart[c := c].domain)
    (InChart[c := c].coordinates f) (InChart[c := c].coordinates g)
    (\fun (u: Open.Carrier (InChart[c := c].domain)) => equal (InChart[c := c].point u)) (regular c);
