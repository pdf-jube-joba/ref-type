\import Functions.Selection[family := family, S := Space.Whole] \as Selection;
\import \parent.Bumps[family := family] \as Bumps;
\definition existsPartition: Space.IsOpenCover[M.space, family, Space.Whole] -> \exists Functions.SmoothPartition[family] := \block {
  \fun (cover: _) \then
  \takefrom selected: Selection.CountableBumps \by Selection.countable M.secondCountable (\fun (x: M.Point)(member: _) => Bumps.local cover x) \then
  \return \exact(Functions.Sequence[family := family, bumps := selected.values].Partition[covering := \fun (x: M.Point) => selected.covers x (\refl(x))].partition,
    Functions.SmoothPartition[family])
};
\definition existsFinitePartition: Space.IsCompact M.space -> Space.IsOpenCover[M.space, family, Space.Whole] -> \exists Functions.FinitePartition[family] := \block {
  \fun (compact: _)(cover: _) \then
  \takefrom selected: Selection.CountableBumps \by Selection.countable M.secondCountable (\fun (x: M.Point)(member: _) => Bumps.local cover x) \then
  \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Space.Subset Space.Whole (Functions.Sequence[family := family, bumps := selected.values].FiniteCover[S := Space.Whole].region k) })
    \by Functions.Sequence[family := family, bumps := selected.values].FiniteCover[S := Space.Whole].prefixExists compact (selected.covers) \then
  \return \exact(Functions.Sequence[family := family, bumps := selected.values].Finite[k := k, covered :=
    \bysub(N.Nat^, { k: N.Nat^ \where Space.Subset Space.Whole (Functions.Sequence[family := family, bumps := selected.values].FiniteCover[S := Space.Whole].region k) }, k)].partition,
    Functions.FinitePartition[family])
};
