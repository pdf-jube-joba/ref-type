\module At(c: Chart, x: Charts.LocalPoint c, U: \Pow M.Point, member: Space.FamilyMember family U, open: Space.IsOpenIn M.space U, inside: Space.Member U x);
\definition local: Space.IsOpenCover[M.space, family, Space.Whole] -> Functions.LocalBumps family := \block {
  \fun (cover: _)(x: M.Point) \then
  \takefrom c: \Cast[Charts.Chart] ({ c: Charts.Chart \where Logic.And[Atlas.Member M.atlas c, Charts.Contains c x] }) \by M.atlas.covers x \then
  \let data: Logic.And[Atlas.Member M.atlas c, Charts.Contains c x] := \bysub(Charts.Chart, { c: Charts.Chart \where Logic.And[Atlas.Member M.atlas c, Charts.Contains c x] }, c) \then
  \let chart: Chart := \into[Charts.Chart](c, M.atlas.charts) \by { data.left } \then
  \let localPoint: Charts.LocalPoint chart := \into[M.Point](x, chart.domain) \by { data.right } \then
  \return Space.unionMemberElim family x (\exists ( b: Functions.Bump[family] \where Space.Member b.oneRegion x ))
    (\fun (U: \Pow M.Point)(member: Space.FamilyMember family U)(inside: Space.Member U x) =>
      At[c := chart, x := localPoint, U := U, member := member, open := cover.open U member, inside := inside].existsBump) (cover.covers x (\refl(x)))
};
