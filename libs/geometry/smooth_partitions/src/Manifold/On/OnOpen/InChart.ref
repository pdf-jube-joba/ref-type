\import \parent.\parent.Neighborhood[c := c, U := U, open := open] \as Neighborhood;
\definition domain: Open.OpenSet := Neighborhood.domain;
\definition point[u: Open.Carrier domain]: Carrier := \into[M.Point](Charts.point c (Open.inclusion domain c.image Neighborhood.included u), U) \by { Neighborhood.point u };
\definition coordinates[f: Function][u: Open.Carrier domain]: Real.Real := f (point u);
\definition restrictSmooth[f: M.Point -> Real.Real]: Smooth.SmoothOn c.image (\fun (u: Open.Carrier c.image) => f (Charts.point c u)) ->
  Smooth.SmoothOn domain (coordinates (restrict f)) :=
  \fun (regular: _) => Restriction.localSmooth domain c.image Neighborhood.included (\fun (u: Open.Carrier c.image) => f (Charts.point c u)) regular;
