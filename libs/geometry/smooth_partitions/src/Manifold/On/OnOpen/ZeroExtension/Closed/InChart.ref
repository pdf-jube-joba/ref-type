\import \parent.\parent.\parent.InChart[c := c] \as Original;
\import \parent.\parent.\parent.\parent.Neighborhood[c := c, U := U, open := open] \as Neighborhood;
\import \parent.\parent.\parent.\parent.Neighborhood[c := c, U := Space.Complement F, open := closed] \as Away;
\import Open.LocalSmooth[U := c.image, f := (\fun (u: Open.Carrier c.image) => value (Charts.point c u))] \as Local;
\module Inside(u: Open.Carrier c.image, member: Space.Member U (Charts.point c u));
\module Outside(u: Open.Carrier c.image, outside: Logic.Not (Space.Member U (Charts.point c u)));
\definition smooth: Smooth.SmoothOn Original.domain (Original.coordinates f) -> Smooth.SmoothOn c.image (\fun (u: Open.Carrier c.image) => value (Charts.point c u)) :=
  \fun (regular: _) => Local.smooth (\fun (u: Open.Carrier c.image) => either!{{(Classical.excludedMiddle (Space.Member U (Charts.point c u)))} {\exists \Cast[Local.Patch] (Local.Patches u)}
    {\fun (member: _) => Inside[u := u, member := member].existsPatch regular}
    {\fun (outside: _) => Outside[u := u, outside := outside].existsPatch}
  });
