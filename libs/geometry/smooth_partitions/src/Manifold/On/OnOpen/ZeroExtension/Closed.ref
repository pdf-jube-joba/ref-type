\definition zeroAway[x: M.Point]: Logic.Not (Space.Member F x) -> value x = Real.zero := \fun (outside: _) =>
  either!{{(Classical.excludedMiddle (Space.Member U x))} {value x = Real.zero}
    {\fun (member: _) => \block {
      \let y: Carrier := \into[M.Point](x, U) \by { member } \then
      \return trans!{Real.Real} _ _ _ (inside y) (vanishes y outside)
    }}
    {\fun (notMember: _) => Extension.outside f Real.zero x notMember}
  };
\module InChart(c: Chart);
\definition smooth: IsSmooth f -> GlobalSmooth value := \fun (regular: _)(c: Chart) => InChart[c := c].smooth (regular c);
