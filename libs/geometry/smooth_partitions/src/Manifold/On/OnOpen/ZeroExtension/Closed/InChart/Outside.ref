\definition patch: Local.Patch := Local.Patch {
  domain := Away.domain, included := Away.included,
  smooth := Euclidean.smoothCongruent Away.domain (\fun (v: Open.Carrier Away.domain) => Real.zero)
    (Open.restrict Away.domain c.image Away.included (\fun (v: Open.Carrier c.image) => value (Charts.point c v)))
    (\fun (v: Open.Carrier Away.domain) => sym!{Real.Real} _ _ (zeroAway (Charts.point c (Open.inclusion Away.domain c.image Away.included v)) (Away.point v)))
    (Operations.constantSmooth Away.domain Real.zero),
};
\definition existsPatch: \exists \Cast[Local.Patch] (Local.Patches u) := Logic.existsIntro[Local.Patch, Local.Patches u] patch
  (Away.contains u (\fun (member: Space.Member F (Charts.point c u)) => outside (included (Charts.point c u) member)));
