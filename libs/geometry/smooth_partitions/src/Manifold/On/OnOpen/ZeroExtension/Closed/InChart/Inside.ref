\definition existsPatch: Smooth.SmoothOn Original.domain (Original.coordinates f) -> \exists \Cast[Local.Patch] (Local.Patches u) := \block {
  \fun (regular: _) \then
  \let patch: Local.Patch := Local.Patch {
    domain := Original.domain, included := Neighborhood.included,
    smooth := Euclidean.smoothCongruent Original.domain (Original.coordinates f)
      (Open.restrict Original.domain c.image Neighborhood.included (\fun (v: Open.Carrier c.image) => value (Charts.point c v)))
      (\fun (v: Open.Carrier Original.domain) => sym!{Real.Real} _ _ (inside (Original.point v))) regular,
  } \then
  \return Logic.existsIntro[Local.Patch, Local.Patches u] patch (Neighborhood.contains u member)
};
