\definition GlobalSmooth[s: Section]: \Prop := \forall (frame: Frame) -> \In[Frame] atlas.frames frame -> \forall (i: Fin.Fin frame.rank) -> \parent.InFrame[frame := frame].Regular s i;
\definition Carrier: \Set := \Cast[M.Point] U;
\structure LocalSection: \Set := { value: \forall (x: Carrier) -> F x };
\module InFrame(frame: Frame);
\definition IsSmooth[s: LocalSection]: \Prop := \forall (frame: Frame) -> \In[Frame] atlas.frames frame ->
  \forall (i: Fin.Fin frame.rank) -> InFrame[frame := frame].Regular s i;
\module ZeroExtension(s: LocalSection);
