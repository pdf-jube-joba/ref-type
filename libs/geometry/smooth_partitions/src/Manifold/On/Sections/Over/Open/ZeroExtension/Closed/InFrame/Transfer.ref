\definition equal[x: Source.Carrier]: Source.restrict coefficient x = Original.coordinate s i x :=
  congr!{{F x} Real.Real} (\fun (v: F x) => frame.coordinate x v i) _ _
    (inside (\into[M.Point](x, U) \by { (\bysub(M.Point, Space.Intersection frame.domain U, x)).right }));
\definition smooth: Original.Regular s i -> Source.IsSmooth (Source.restrict coefficient) :=
  \fun (regular: _) => Source.congruent (Original.coordinate s i) (Source.restrict coefficient)
    (\fun (x: Source.Carrier) => sym!{Real.Real} _ _ (equal x)) regular;
