\import \parent.\parent.\parent.OnOpen[U := frame.domain, open := frame.open] \as Domain;
\definition coordinate[s: Section][i: Fin.Fin frame.rank][x: Domain.Carrier]: Real.Real := frame.coordinate x (s.value x) i;
\definition Regular[s: Section][i: Fin.Fin frame.rank]: \Prop := Domain.IsSmooth (coordinate s i);
