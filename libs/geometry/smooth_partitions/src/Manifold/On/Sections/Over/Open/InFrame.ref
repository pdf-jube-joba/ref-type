\definition intersection: \Pow M.Point := Space.Intersection frame.domain U;
\definition intersectionOpen: Space.IsOpenIn M.space intersection := (Space.topologyLaws M.space).intersectionOpen frame.domain U frame.open open;
\import \parent.\parent.\parent.\parent.OnOpen[U := intersection, open := intersectionOpen] \as Domain;
\definition point[x: Domain.Carrier]: Carrier := \into[M.Point](x, U) \by { (\bysub(M.Point, intersection, x)).right };
\definition coordinate[s: LocalSection][i: Fin.Fin frame.rank][x: Domain.Carrier]: Real.Real := frame.coordinate x (s.value (point x)) i;
\definition Regular[s: LocalSection][i: Fin.Fin frame.rank]: \Prop := Domain.IsSmooth (coordinate s i);
