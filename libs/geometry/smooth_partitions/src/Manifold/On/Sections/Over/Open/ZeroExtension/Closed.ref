\definition zeroAway[x: M.Point]: Logic.Not (Space.Member F0 x) -> value x = zero x := \fun (away: _) =>
  either!{{(Classical.excludedMiddle (Member x))} {value x = zero x}
    {\fun (member: _) => trans!{{F x}} _ _ _ (inside (point x member)) (vanishes (point x member) away)}
    {\fun (absent: _) => outside x absent}
  };
\module InFrame(frame: Frame, i: Fin.Fin frame.rank);
\definition smooth: IsSmooth s -> GlobalSmooth section := \fun (regular: _)(frame: Frame)(member: \In[Frame] atlas.frames frame)(i: Fin.Fin frame.rank) =>
  InFrame[frame := frame, i := i].smooth (regular frame member i);
