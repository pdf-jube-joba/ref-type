\import \parent.\parent.\parent.InFrame[frame := frame] \as Original;
\import \parent.\parent.\parent.\parent.\parent.\parent.OnOpen[U := Space.Intersection frame.domain U,
  open := (Space.topologyLaws M.space).intersectionOpen frame.domain U frame.open open] \as Source;
\definition coefficient[x: M.Point]: Real.Real := frame.coordinate x (value x) i;
\import \parent.\parent.\parent.\parent.\parent.\parent.GluingOn[V := frame.domain, U := U, openV := frame.open, openU := open, F := F0, closed := closed, included := included, f := coefficient] \as Gluing;
\module Transfer;
\definition smooth: Original.Regular s i -> \parent.\parent.\parent.\parent.InFrame[frame := frame].Regular section i :=
  \fun (regular: _) => Gluing.smooth (Transfer[].smooth regular)
    (\fun (x: M.Point)(away: _) => trans!{Real.Real} _ _ _
      (congr!{{F x} Real.Real} (\fun (v: F x) => frame.coordinate x v i) _ _ (zeroAway x away)) (frame.zero x i));
