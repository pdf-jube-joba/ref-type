\definition subset: Charts.OpenSubset := \into[\Pow M.Point](U, { U: \Pow M.Point \where Space.IsOpenIn M.space U }) \by { open };
\import Charts.Restricted[U := subset].Of[chart := c] \as Restricted;
\import AmbientSpace.Subspace[S := c.image.points].Open[] \as OpenImage;
\definition domain: Open.OpenSet := Restricted.image;
\definition included: Open.Included domain c.image := \fun (x: Model.Point)(member: AmbientSpace.Member domain.points x) => OpenImage.imageIncluded Restricted.overlap x member;
\definition contains[u: Open.Carrier c.image]: Space.Member U (Charts.point c u) -> AmbientSpace.Member domain.points u :=
  OpenImage.imageMember Restricted.overlap u;
\definition point[u: Open.Carrier domain]: Space.Member U (Charts.point c (Open.inclusion domain c.image included u)) := Restricted.backwardMember u;
