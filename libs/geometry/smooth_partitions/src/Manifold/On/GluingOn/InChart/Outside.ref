\definition existsPatch: ZeroAway -> \exists \Cast[Local.Patch] (Local.Patches u) := \block {
  \fun (zero: _) \then
  \let patch: Local.Patch := Local.Patch {
    domain := Away.domain, included := awayIncluded,
    smooth := Euclidean.smoothCongruent Away.domain (\fun (v: Open.Carrier Away.domain) => Real.zero)
      (Open.restrict Away.domain TargetChart.domain awayIncluded (TargetChart.coordinates (Target.restrict f)))
      (\fun (v: Open.Carrier Away.domain) => sym!{Real.Real} _ _ (zero (Charts.point c (Open.inclusion Away.domain c.image Away.included v)) (Away.point v).right))
      (Operations.constantSmooth Away.domain Real.zero),
  } \then
  \return Logic.existsIntro[Local.Patch, Local.Patches u] patch
    (Away.contains (Open.inclusion TargetChart.domain c.image TargetNeighborhood.included u)
      (Logic.And[_, _]::# (\bysub(M.Point, V, TargetChart.point u)) (\fun (member: Space.Member F (TargetChart.point u)) => outside (included (TargetChart.point u) member))))
};
