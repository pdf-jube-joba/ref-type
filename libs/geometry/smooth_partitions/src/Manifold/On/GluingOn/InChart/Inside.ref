\definition existsPatch: Smooth.SmoothOn SourceChart.domain (SourceChart.coordinates (Source.restrict f)) -> \exists \Cast[Local.Patch] (Local.Patches u) := \block {
  \fun (regular: _) \then
  \let patch: Local.Patch := Local.Patch {
    domain := SourceChart.domain, included := sourceIncluded,
    smooth := Euclidean.smoothCongruent SourceChart.domain (SourceChart.coordinates (Source.restrict f))
      (Open.restrict SourceChart.domain TargetChart.domain sourceIncluded (TargetChart.coordinates (Target.restrict f)))
      (\fun (v: Open.Carrier SourceChart.domain) => \refl(SourceChart.coordinates (Source.restrict f) v)) regular,
  } \then
  \return Logic.existsIntro[Local.Patch, Local.Patches u] patch
    (SourceNeighborhood.contains (Open.inclusion TargetChart.domain c.image TargetNeighborhood.included u)
      (Logic.And[_, _]::# (\bysub(M.Point, V, TargetChart.point u)) member))
};
