\import metric_spaces.RealLine[] \as Line;
\import topology.Continuity[A := M.Point, B := Real.Real] \as Maps;
\module InChart(c: Chart, f: Function);
\definition continuous: \forall (f: Function) -> IsSmooth f -> Maps.Continuous M.space Line.topology f :=
  \fun (f: Function)(regular: IsSmooth f)(W: \Pow Real.Real)(open: topology.Topology[Carrier := Real.Real].IsOpenIn Line.topology W) =>
    Space.openOfNeighborhoods M.space (Maps.Preimage f W) (\block {
      \fun (x: M.Point)(member: Space.Member (Maps.Preimage f W) x) \then
      \takefrom chart: \Cast[Charts.Chart] ({ c: Charts.Chart \where Logic.And[Atlas.Member M.atlas c, Charts.Contains c x] }) \by M.atlas.covers x \then
      \let data: Logic.And[Atlas.Member M.atlas chart, Charts.Contains chart x] := \bysub(Charts.Chart, { c: Charts.Chart \where Logic.And[Atlas.Member M.atlas c, Charts.Contains c x] }, chart) \then
      \let c: Chart := \into[Charts.Chart](chart, M.atlas.charts) \by { data.left } \then
      \return InChart[c := c, f := f].neighborhood x data.right W open member (regular c)
    });
