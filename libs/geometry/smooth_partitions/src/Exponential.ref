\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Classical[] \as Classical;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason;
\use Logic.either;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import R.Order[] \as Order;
\import Real.Estimates[] \as Estimates;
\import Estimates.Product[] \as Product;
\import Real.Distance[] \as Distance;
\import Real.Algebra[] \as Algebra;
\import Real.Inverse[] \as Inverse;
\import calculus.Real[] \as Calculus;
\import Calculus.Derivative[].Def[] \as Derivatives;
\import Calculus.Derivative[].Operations[] \as DerivativeOperations;
\import Calculus.Derivative[].Prop[] \as Basic;
\import Calculus.Derivative[].Product[] \as Products;
\import Calculus.Derivative[].Chain[] \as Chain;
\import Calculus.Limit[].Def[] \as Limits;
\import Calculus.Limit[].Operations[] \as LimitOperations;
\definition Scalar: \Set := Real.Real;
\definition Positive: \Set := \Cast[Scalar] ({ x: Scalar \where R.Lt Real.zero x });
\definition Inside[r, t: Scalar]: \Prop := Logic.And[R.Lt (Real.neg r) t, R.Lt t r];
\structure Patch: \Set := {
  radius: Positive,
  value: Scalar -> Scalar,
  positive: \forall (t: Scalar) -> R.Lt Real.zero (value t),
  atZero: value Real.zero = Real.one,
  derivative: \forall (t: Scalar) -> Inside radius t -> Derivatives.HasDerivativeAt value t (value t),
};
\module Interval(a, b: Scalar);
\module Seed;
\module Double(patch: Patch);
\module Pair(left, right: Patch);
\module Growing(seed: Patch);
\module Global;
\module Flat;
\module Step;
\module Plateau;
