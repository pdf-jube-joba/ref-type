\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Classical[] \as Classical;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason;
\use Logic.either;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import topology.Topology[Carrier := A] \as Space;
\import Space.Closure[] \as Closure;
\import Space.Compactness[] \as Compact;
\import Space.Finite[] \as Finite;
\import Space.Countability[] \as Countability;
\import Real.Estimates[] \as Estimates;
\import Real.Algebra[] \as Algebra;
\import R.Order[] \as Order;
\import calculus.Real[].Derivative[].Operations[] \as Derivatives;
\import N.Basic[].Prop[] \as Nat;
\import N.Basic[].Def[] \as Arithmetic;
\definition Function: \Set := A -> Real.Real;
\structure Calculus: \Set := {
  smooth: \Pow Function,
  constant: \forall (c: Real.Real) -> \In[Function] smooth (\fun (x: A) => c),
  plus: \forall (f, g: Function) -> \In[Function] smooth f -> \In[Function] smooth g -> \In[Function] smooth (\fun (x: A) => Real.add (f x) (g x)),
  times: \forall (f, g: Function) -> \In[Function] smooth f -> \In[Function] smooth g -> \In[Function] smooth (\fun (x: A) => Real.mul (f x) (g x)),
};
\module Using(calculus: Calculus);
