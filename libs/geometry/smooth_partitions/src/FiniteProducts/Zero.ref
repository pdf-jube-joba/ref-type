\definition law: \forall (n: N.Nat^)(f: Fin.Fin n -> Real.Real)(i: Fin.Fin n) -> f i = Real.zero -> product n f = Real.zero :=
  \induction (n: N.Nat^) \return \forall (f: Fin.Fin n -> Real.Real)(i: Fin.Fin n) -> f i = Real.zero -> product n f = Real.zero \with {
    | zero: \fun (f: Fin.Fin N.Nat^::zero -> Real.Real)(i: Fin.Fin N.Nat^::zero)(zero: f i = Real.zero) =>
      Logic.falseElim (product N.Nat^::zero f = Real.zero) (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i))
    | succ: \fun (n: N.Nat^)(previous: \forall (f: Fin.Fin n -> Real.Real)(i: Fin.Fin n) -> f i = Real.zero -> product n f = Real.zero)
      (f: Fin.Fin (N.Nat^::succ n) -> Real.Real) =>
      Fin.cases n (\fun (i: Fin.Fin (N.Nat^::succ n)) => f i = Real.zero -> product (N.Nat^::succ n) f = Real.zero)
        (\fun (zero: f (Fin.zero n) = Real.zero) => trans!{Real.Real} _ _ _
          (congr!{Real.Real Real.Real} (\fun (x: Real.Real) => Real.mul x (product n (\fun (j: Fin.Fin n) => f (Fin.succ n j)))) _ _ zero)
          (Laws.fieldMulZeroLeft (product n (\fun (j: Fin.Fin n) => f (Fin.succ n j)))))
        (\fun (i: Fin.Fin n)(zero: f (Fin.succ n i) = Real.zero) => trans!{Real.Real} _ _ _
          (congr!{Real.Real Real.Real} (Real.mul (f (Fin.zero n))) _ _ (previous (\fun (j: Fin.Fin n) => f (Fin.succ n j)) i zero))
          (Laws.fieldMulZeroRight (f (Fin.zero n))))
  };
