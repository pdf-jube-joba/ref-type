\import \root.Scalars[A := Model.Point, space := Ambient.topology] \as Scalars;
\definition calculus: Scalars.Calculus := Scalars.Calculus {
  smooth := { f: Function \where IsSmooth f },
  constant := \fun (c: Real.Real) => Operations.constantSmooth Open.whole c,
  plus := \fun (f, g: Function)(left: IsSmooth f)(right: IsSmooth g) => Operations.addSmooth Open.whole
    (Restriction.function Open.whole f) (Restriction.function Open.whole g) left right,
  times := \fun (f, g: Function)(left: IsSmooth f)(right: IsSmooth g) => Operations.mulSmooth Open.whole
    (Restriction.function Open.whole f) (Restriction.function Open.whole g) left right,
};
\import Scalars.Using[calculus := calculus] \as Functions;
\module Bumps(family: \Pow (\Pow Model.Point));
