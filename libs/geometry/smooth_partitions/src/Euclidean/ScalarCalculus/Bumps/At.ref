\definition domain: Open.OpenSet := Topology.ofOpen U open;
\module Radius(r: Real.Real, ball: Open.BallInside[U, x, r]);
\definition existsBump: \exists ( b: Functions.Bump[family] \where Space.Member b.oneRegion x ) := \block {
  \takefrom r: \Cast[Real.Real] ({ r: Real.Real \where Open.BallInside[U, x, r] }) \by domain.open x inside \then
  \return Radius[r := r, ball := \bysub(Real.Real, { r: Real.Real \where Open.BallInside[U, x, r] }, r)].existsBump
};
