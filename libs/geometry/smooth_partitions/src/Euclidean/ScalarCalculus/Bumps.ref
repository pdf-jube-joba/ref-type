\import Real.Estimates[] \as Estimates;
\import Real.Estimates[].Product[] \as Bounds;
\import Real.Distance[] \as Distance;
\import metric_spaces.MetricSpace[Carrier := Model.Point] \as Metrics;
\import Metrics.Topology[] \as MetricTopology;
\import topological_algebra.Euclidean[].Dimension[n := n].Norm[] \as Norm;
\import topological_algebra.Euclidean[].Dimension[n := n].Def[] \as Coordinates;
\module At(x: Model.Point, U: \Pow Model.Point, member: Space.FamilyMember family U, open: Space.IsOpenIn Ambient.topology U, inside: Space.Member U x);
\definition local: Space.IsOpenCover[Ambient.topology, family, Space.Whole] -> Functions.LocalBumps family :=
  \fun (cover: _)(x: Model.Point) => Space.unionMemberElim family x (\exists ( b: Functions.Bump[family] \where Space.Member b.oneRegion x ))
    (\fun (U: \Pow Model.Point)(member: Space.FamilyMember family U)(inside: Space.Member U x) =>
      At[x := x, U := U, member := member, open := cover.open U member, inside := inside].existsBump) (cover.covers x (\refl(x)));
