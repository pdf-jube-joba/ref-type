\import \root.FiniteProducts[] \as Products;
\import std.Data[].FinSet[] \as Fin;
\definition value[U: Open.OpenSet][m: N.Nat^][functions: Fin.Fin m -> Open.ScalarFunction U][x: Open.Carrier U]: Real.Real :=
  Products.product m (\fun (i: Fin.Fin m) => functions i x);
\definition smooth: \forall (U: Open.OpenSet)(m: N.Nat^)(functions: Fin.Fin m -> Open.ScalarFunction U) ->
  (\forall (i: Fin.Fin m) -> Smooth.SmoothOn U (functions i)) -> Smooth.SmoothOn U (value U m functions) :=
  \fun (U: Open.OpenSet) => \induction (m: N.Nat^) \return \forall (functions: Fin.Fin m -> Open.ScalarFunction U) ->
    (\forall (i: Fin.Fin m) -> Smooth.SmoothOn U (functions i)) -> Smooth.SmoothOn U (value U m functions) \with {
      | zero: \fun (functions: _)(regular: _) => Operations.constantSmooth U Real.one
      | succ: \fun (m: N.Nat^)(previous: _)(functions: _)(regular: _) => Operations.mulSmooth U (functions (Fin.zero m))
        (value U m (\fun (i: Fin.Fin m) => functions (Fin.succ m i))) (regular (Fin.zero m))
        (previous (\fun (i: Fin.Fin m) => functions (Fin.succ m i)) (\fun (i: Fin.Fin m) => regular (Fin.succ m i)))
    };
