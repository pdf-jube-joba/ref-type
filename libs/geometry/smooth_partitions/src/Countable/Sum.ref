\definition value[x: A]: Real.Real := \choice SumValue f x \by { existence: existsSum f x (finite x), uniqueness: uniqueSum f x (finite x) };
\definition law[x: A]: SumLaw f x (value x) := \bysub(Real.Real, { y: Real.Real \where SumLaw f x y },
  \choice SumValue f x \by { existence: existsSum f x (finite x), uniqueness: uniqueSum f x (finite x) });
