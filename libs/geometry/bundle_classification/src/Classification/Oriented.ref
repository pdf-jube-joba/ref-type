\import real.Analysis[] \as R;
\import vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := hermitian_frames.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Bundles;
\import bundle_operations.Operations[].Over[K := R.Real, field := R.Algebra[].field, conjugation := hermitian_frames.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Operations;
\import \parent.Over[K := R.Real, field := R.Algebra[].field, conjugation := hermitian_frames.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Theory;
\import hermitian_frames.Hermitian[].Over[K := R.Real, field := R.Algebra[].field, scalar := hermitian_frames.Hermitian[].Real[].scalar, topological := vector_bundles.Bundles[].Real[].scalar.topological] \as Hermitian;
\module On(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology, k: N.Nat^);
\module For(X: \Set, F: X -> \Set, bundle: Bundles.Family[X := X, F := F].Bundle, k: N.Nat^);
\module Sum(X: \Set, F, G: X -> \Set, left: Bundles.Family[X := X, F := F].Bundle, right: Bundles.Family[X := X, F := G].Bundle,
  same: left.baseSpace = right.baseSpace, k, l: N.Nat^,
  first: Theory.For[X := X, F := F, bundle := left].AtRank[k := k].Classifier,
  second: Theory.For[X := X, F := G, bundle := right].AtRank[k := l].Classifier);
\module Stabilization(X: \Set, F: X -> \Set, bundle: Bundles.Family[X := X, F := F].Bundle, k, n: N.Nat^,
  classifier: Theory.For[X := X, F := F, bundle := bundle].AtRank[k := k].Classifier);
\module WhitneySum(X: \Set, F, G: X -> \Set, left: Bundles.Family[X := X, F := F].Bundle, right: Bundles.Family[X := X, F := G].Bundle,
  same: left.baseSpace = right.baseSpace, k, l: N.Nat^,
  leftRank: Theory.For[X := X, F := F, bundle := left].AtRank[k := k].HasRank,
  rightRank: Theory.For[X := X, F := G, bundle := right].AtRank[k := l].HasRank,
  leftOrientation: \root.Classification[].Oriented[].For[X := X, F := F, bundle := left, k := k].Orientation,
  rightOrientation: \root.Classification[].Oriented[].For[X := X, F := G, bundle := right, k := l].Orientation);
\module Trivial(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology, n: N.Nat^);
\module StandardStabilization(X: \Set, F: X -> \Set, bundle: Bundles.Family[X := X, F := F].Bundle, k, n: N.Nat^,
  sourceRank: Theory.For[X := X, F := F, bundle := bundle].AtRank[k := k].HasRank,
  sourceOrientation: \root.Classification[].Oriented[].For[X := X, F := F, bundle := bundle, k := k].Orientation);
