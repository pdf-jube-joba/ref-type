\import real.Analysis[] \as R;
\import vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := hermitian_frames.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Bundles;
\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := X] \as Cylinder;
\import Bundles.Family[X := X, F := L] \as Original;
\import Original.Of[bundle := source].Pullback[Y := Cylinder.Carrier, source := Cylinder.topology source.baseSpace, f := Cylinder.point] \as Pull;
\definition pulled: Bundles.Family[X := Cylinder.Carrier, F := (\fun (z: Cylinder.Carrier) => L (Cylinder.point z))].Bundle := Pull.pulled (Cylinder.pointContinuous source.baseSpace);
\import Bundles.Family[X := Cylinder.Carrier, F := (\fun (z: Cylinder.Carrier) => L (Cylinder.point z))] \as PulledFamily;
\import Bundles.Family[X := Cylinder.Carrier, F := D] \as TargetFamily;
\import Bundles.Isomorphisms[X := Cylinder.Carrier, F := (\fun (z: Cylinder.Carrier) => L (Cylinder.point z)), G := D, source := pulled, target := target] \as Isos;
