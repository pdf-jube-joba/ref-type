\import Family.Of[bundle := bundle].Pullback[Y := Y, source := source, f := f] \as Pull;
\definition pulled: Bundles.Family[X := Y, F := (\fun (y: Y) => F (f y))].Bundle := Pull.pulled continuous;
\import Bundles.Family[X := Y, F := (\fun (y: Y) => F (f y))] \as PulledFamily;
\import \root.Classification[].Orientations[X := Y, F := (\fun (y: Y) => F (f y)), bundle := pulled] \as New;
\definition positive: \Pow PulledFamily.Point := { p: PulledFamily.Point \where Positive orientation.positive (f p.base) p.vector };
\definition data: New.Data := New.Data { positive := positive };
\definition orientationOnPullback: New.Orientation := \into[New.Data](data, New.Orientation) \by {
  New.Laws[data] {
    open := Pull.mapContinuous orientation.positive (laws orientation).open,
    nonzero := \fun (y: Y) => (laws orientation).nonzero (f y),
    inhabited := \fun (y: Y) => (laws orientation).inhabited (f y),
    signs := \fun (y: Y) => (laws orientation).signs (f y),
    disjoint := \fun (y: Y) => (laws orientation).disjoint (f y),
    scale := \fun (y: Y) => (laws orientation).scale (f y),
    ray := \fun (y: Y) => (laws orientation).ray (f y)
  }
};
