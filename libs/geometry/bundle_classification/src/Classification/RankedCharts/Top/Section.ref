\import Operations.Chart[X := X, F := Forms.Fiber, bundle := Forms.alternating, chart := chart] \as ChartMaps;
\definition value[x: \Cast[X] c.domain]: Forms.Fiber x := (chart.frame x).backward.apply a;
\definition regular: topology.Continuity[A := \Cast[X] c.domain, B := FormFamily.Point].Continuous (Subspace.topology bundle.baseSpace) Forms.alternating.totalSpace
  (\fun (x: \Cast[X] c.domain) => FormFamily.include x (value x)) :=
  ChartMaps.Maps[Y := \Cast[X] c.domain, source := Subspace.topology bundle.baseSpace].pointContinuous
    (\fun (x: \Cast[X] c.domain) => x) (\fun (_: \Cast[X] c.domain) => a)
    (topology.Maps[A := \Cast[X] c.domain, B := \Cast[X] c.domain].Identity[].continuous (Subspace.topology bundle.baseSpace))
    (topology.Maps[A := \Cast[X] c.domain, B := RealBundles.Vector dimension].constantContinuous (Subspace.topology bundle.baseSpace) (RealBundles.coordinateTopology dimension) a);
\definition point[x: \Cast[X] c.domain]: LocalTotal := \into[FormFamily.Point](FormFamily.include x (value x), Forms.Domain basisTuple) \by { \bysub(X, c.domain, x) };
\import topology.Continuity[A := \Cast[X] c.domain, B := FormFamily.Point].Corestriction[S := Forms.Domain basisTuple] \as IntoLocal;
\definition pointContinuous: topology.Continuity[A := \Cast[X] c.domain, B := LocalTotal].Continuous (Subspace.topology bundle.baseSpace) localTopology point :=
  IntoLocal.corestrictContinuous (Subspace.topology bundle.baseSpace) Forms.alternating.totalSpace point regular;
\definition coefficientValue[x: \Cast[X] c.domain]: R.Real := coefficient (point x);
\definition coefficientRegular: topology.Continuity[A := \Cast[X] c.domain, B := R.Real].Continuous (Subspace.topology bundle.baseSpace) vector_bundles.Bundles[].Real[].scalar.topological.space coefficientValue :=
  topology.Composition[A := \Cast[X] c.domain, B := LocalTotal, C := R.Real].composeContinuous (Subspace.topology bundle.baseSpace) localTopology vector_bundles.Bundles[].Real[].scalar.topological.space point coefficient pointContinuous coefficientContinuous;
