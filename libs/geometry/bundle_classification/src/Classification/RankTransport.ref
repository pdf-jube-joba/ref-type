\import linear_algebra.Commutative[K := RealNumbers.Real, scalarRing := Fields.fieldAsCommutativeRing RealNumbers.Real RealNumbers.Algebra[].field] \as Spaces;
\import RealBundles.Isomorphisms[X := X, F := F, G := G, source := source, target := target] \as Isos;
\definition laws: Isos.Laws[iso] := \bysub(Isos.Data, Isos.Isomorphism, iso);
\module At(x: X, frame: RealBundles.Family[X := X, F := F].Of[bundle := source].Frame n x);
\definition rank: \forall (x: X) -> \exists RealBundles.Family[X := X, F := G].Of[bundle := target].Frame n x := \fun (x: X) => \block {
  \takefrom frame: RealBundles.Family[X := X, F := F].Of[bundle := source].Frame n x \by original x \then
  \return \exact(At[x := x, frame := frame].frame, RealBundles.Family[X := X, F := G].Of[bundle := target].Frame n x)
};
