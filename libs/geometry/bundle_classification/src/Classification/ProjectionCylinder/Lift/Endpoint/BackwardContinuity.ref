\definition base[p: FinishFamily.Point]: Cylinder.Carrier := at p.base;
\definition baseContinuous: topology.Continuity[A := FinishFamily.Point, B := Cylinder.Carrier].Continuous Finish.bundle.totalSpace (Cylinder.topology baseSpace) base :=
  topology.Composition[A := FinishFamily.Point, B := X, C := Cylinder.Carrier].composeContinuous Finish.bundle.totalSpace baseSpace (Cylinder.topology baseSpace) FinishFamily.projection at
    (FinishFamily.Of[bundle := Finish.bundle].projectionContinuous) (Cylinder.atContinuous baseSpace I.end);
\definition lift[p: FinishFamily.Point]: ImageFamily.Point := ImageFamily.include (base p) p.vector;
\definition liftContinuous: topology.Continuity[A := FinishFamily.Point, B := ImageFamily.Point].Continuous Finish.bundle.totalSpace Image.bundle.totalSpace lift :=
  Image.Universal[Y := FinishFamily.Point, source := Finish.bundle.totalSpace].continuous lift baseContinuous
    (Complements.Projection[X := X, n := n, baseSpace := baseSpace, P := Finish.projection, regular := Finish.regular].vectorContinuous);
\import Bundles.Morphisms[X := Cylinder.Carrier, Y := Cylinder.Carrier, F := Image.Fiber, G := (\fun (z: Cylinder.Carrier) => Start.Fiber (Cylinder.point z)), source := Image.bundle, target := PullStart.firstBundle, f := (\fun (z: Cylinder.Carrier) => z)] \as Maps;
\definition total[p: FinishFamily.Point]: PulledFamily.Point := Maps.total isomorphism.backward (lift p);
\definition totalContinuous: topology.Continuity[A := FinishFamily.Point, B := PulledFamily.Point].Continuous Finish.bundle.totalSpace Pull.topology total :=
  topology.Composition[A := FinishFamily.Point, B := ImageFamily.Point, C := PulledFamily.Point].composeContinuous Finish.bundle.totalSpace Image.bundle.totalSpace Pull.topology lift (Maps.total isomorphism.backward) liftContinuous (Maps.continuous isomorphism.backward);
\definition continuous: topology.Continuity[A := FinishFamily.Point, B := StartFamily.Point].Continuous Finish.bundle.totalSpace Start.bundle.totalSpace (Backward.total backwardData) :=
  topology.Composition[A := FinishFamily.Point, B := PulledFamily.Point, C := StartFamily.Point].composeContinuous Finish.bundle.totalSpace Pull.topology Start.bundle.totalSpace total Pull.map totalContinuous Pull.mapContinuous;
