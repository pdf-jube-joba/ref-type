\import Bundles.Family[X := X, F := Finish.Fiber] \as FinishFamily;
\import Bundles.Family[X := Cylinder.Carrier, F := Image.Fiber] \as ImageFamily;
\import Bundles.Family[X := Cylinder.Carrier, F := (\fun (z: Cylinder.Carrier) => Start.Fiber (Cylinder.point z))] \as PulledFamily;
\definition at[x: X]: Cylinder.Carrier := Cylinder.at I.end x;
\import Bundles.Morphisms[X := X, Y := X, F := Start.Fiber, G := Finish.Fiber, source := Start.bundle, target := Finish.bundle, f := (\fun (x: X) => x)] \as Forward;
\import Bundles.Morphisms[X := X, Y := X, F := Finish.Fiber, G := Start.Fiber, source := Finish.bundle, target := Start.bundle, f := (\fun (x: X) => x)] \as Backward;
\definition forwardData: Forward.Data := Forward.Data { fiber := \fun (x: X) => isomorphism.forward.fiber (at x) };
\definition backwardData: Backward.Data := Backward.Data { fiber := \fun (x: X) => isomorphism.backward.fiber (at x) };
\module ForwardContinuity;
\module BackwardContinuity;
\definition forward: Forward.Map := \into[Forward.Data](forwardData, Forward.Map) \by { ForwardContinuity[].continuous };
\definition backward: Backward.Map := \into[Backward.Data](backwardData, Backward.Map) \by { BackwardContinuity[].continuous };
\definition value: Bundles.Isomorphisms[X := X, F := Start.Fiber, G := Finish.Fiber, source := Start.bundle, target := Finish.bundle].Isomorphism :=
  Bundles.Isomorphisms[X := X, F := Start.Fiber, G := Finish.Fiber, source := Start.bundle, target := Finish.bundle].Isomorphism {
    forward := forward, backward := backward, leftInverse := \fun (x: X) => laws.leftInverse (at x), rightInverse := \fun (x: X) => laws.rightInverse (at x)
  };
