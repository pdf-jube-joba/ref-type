\import complex.Complex[] \as R;
\import \parent.Over[K := R.Complex, field := R.Algebra[].field, conjugation := hermitian_frames.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Theory;
\import Theory.On[X := X, baseSpace := baseSpace] \as Classes;
\import hermitian_frames.Hermitian[].Over[K := R.Complex, field := R.Algebra[].field, scalar := hermitian_frames.Hermitian[].Complex[].scalar, topological := vector_bundles.Bundles[].Complex[].scalar.topological] \as Hermitian;
\module Finite(n, k: N.Nat^, f: X -> grassmannians.Complex[n := n, k := k].Model[].Carrier,
  continuous: topology.Continuity[A := X, B := grassmannians.Complex[n := n, k := k].Model[].Carrier].Continuous baseSpace grassmannians.Complex[n := n, k := k].Model[].topology f);
\module Between(p, q: Classes.Presentation, iso: Classes.Isomorphism p q, k: N.Nat^,
