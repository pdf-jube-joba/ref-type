\import \root.Classification[].Oriented[].Sum[X := X, F := F, G := G, left := left, right := right, same := same, k := k, l := l,
  first := newFirst, second := newSecond].With[orientation := orientation, classifier := classifier] \as Other;
\definition independent: \forall (compact: topology.Topology[Carrier := X].IsCompact left.baseSpace) ->
  Oriented.Compact[compact := compact].class after = Oriented.Compact[compact := compact].class Other.after :=
  \fun (compact: _) => trans!{Oriented.Compact[compact := compact].Classes} _ _ _
    (sym!{Oriented.Compact[compact := compact].Classes} _ _ (naturality compact)) (Other.naturality compact);
