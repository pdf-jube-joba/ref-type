\import Sum.With[orientation := orientation, classifier := classifier] \as Compare;
\import \root.Classification[].Oriented[].On[X := X, baseSpace := bundle.baseSpace, k := Sum.rank] \as Oriented;
\definition before: Oriented.Object := Compare.before;
\definition after: Oriented.Object := Compare.after;
\definition naturality: \forall (compact: topology.Topology[Carrier := X].IsCompact bundle.baseSpace) ->
  Oriented.Compact[compact := compact].class before = Oriented.Compact[compact := compact].class after := Compare.naturality;
