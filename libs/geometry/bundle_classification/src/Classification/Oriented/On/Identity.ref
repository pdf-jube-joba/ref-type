\import \parent.Between[a := a, b := a] \as Isos;
\definition plain: Bundles.Isomorphisms[X := X, F := Plain.Fiber a.projection, G := Plain.Fiber a.projection, source := Plain.bundle a.projection, target := Plain.bundle a.projection].Isomorphism := Operations.IdentityIsomorphism[X := X, F := Plain.Fiber a.projection, bundle := Plain.bundle a.projection].isomorphism;
\import Isos.Along[iso := plain] \as Along;
\import \root.Classification[].Determinants[X := X, F := Plain.Fiber a.projection, G := Plain.Fiber a.projection, source := Plain.bundle a.projection, target := Plain.bundle a.projection, same := \refl(baseSpace), k := k, iso := plain] \as Determinants;
\import \root.Classification[].Orientations[X := X, F := DeterminantFiber a.projection, bundle := determinantBundle a.projection] \as Cones;
\definition same: \forall (x: X)(alpha: DeterminantFiber a.projection x) -> (Determinants.isomorphism.forward.fiber x).apply alpha = alpha :=
  \fun (x: X)(alpha: DeterminantFiber a.projection x) => \axiom:funext((Determinants.isomorphism.forward.fiber x).apply alpha, alpha,
    \fun (v: Fin.Fin k -> Plain.Fiber a.projection x) => congr!{{Fin.Fin k -> Plain.Fiber a.projection x} {R.Real}} alpha _ _
      (\axiom:funext((\fun (i: Fin.Fin k) => v i), v, \fun (i: Fin.Fin k) => \refl(v i))));
\definition preserves: Along.Preserves := \fun (x: X)(alpha: DeterminantFiber a.projection x) => Logic.PropEquiv[_, _] {
  ltr := \fun (positive: _) => \idelim alpha = (Determinants.isomorphism.forward.fiber x).apply alpha \with beta: DeterminantFiber a.projection x => Cones.Positive a.orientation.positive x beta \by { base: positive, equality: sym!{{DeterminantFiber a.projection x}} _ _ (same x alpha) },
  rtl := \fun (positive: _) => \idelim (Determinants.isomorphism.forward.fiber x).apply alpha = alpha \with beta: DeterminantFiber a.projection x => Cones.Positive a.orientation.positive x beta \by { base: positive, equality: same x alpha }
};
\definition value: Isos.Isomorphism := Isos.Isomorphism { value := plain, preserves := preserves };
