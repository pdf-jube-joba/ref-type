\import \root.Classification[].Determinants[X := X, F := Plain.Fiber a.projection, G := Plain.Fiber b.projection,
  source := Plain.bundle a.projection, target := Plain.bundle b.projection, same := \refl(baseSpace), k := k, iso := iso] \as Determinants;
\import \root.Classification[].Orientations[X := X, F := DeterminantFiber a.projection, bundle := determinantBundle a.projection] \as First;
\import \root.Classification[].Orientations[X := X, F := DeterminantFiber b.projection, bundle := determinantBundle b.projection] \as Second;
\definition Preserves: \Prop := \forall (x: X)(alpha: DeterminantFiber b.projection x) ->
  Logic.PropEquiv[Second.Positive b.orientation.positive x alpha, First.Positive a.orientation.positive x ((Determinants.isomorphism.forward.fiber x).apply alpha)];
