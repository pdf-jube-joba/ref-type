\import Plain.Between[p := a.projection, q := b.projection] \as Raw;
\import \root.Classification[].Oriented[].On[X := X, baseSpace := baseSpace, k := k].Between[a := a, b := b] \as Oriented;
\module Along(w: Raw.Witness);
\definition Cone[w: Raw.Witness]: \Set := Along[w := w].Cone;
\structure Data: \Set := { raw: Raw.Witness, orientation: Cone raw };
\structure Laws[data: Data]: \Prop := {
  rank: Along[w := data.raw].Ranked,
  start: Along[w := data.raw].StartCompatible data.orientation,
  end: Along[w := data.raw].EndCompatible data.orientation,
};
\definition Homotopy: \Set := \Cast[Data] ({ d: Data \where Laws[d] });
\module FromHomotopy(h: Homotopy);
\module FromIsomorphism(iso: Oriented.Isomorphism);
