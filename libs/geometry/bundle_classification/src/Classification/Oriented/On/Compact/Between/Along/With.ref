\import \root.Classification[].ProjectionCylinder[X := X, baseSpace := baseSpace, compact := compact, n := dimension, P := w.data.projection, regular := w.data.regular] \as CylinderModel;
\module Lift(lift: CylinderModel.LiftType);
\definition isomorphismExists: \exists Oriented.Isomorphism := \block {
  \takefrom lift: CylinderModel.LiftType \by CylinderModel.liftExists \then
  \return \exact(Lift[lift := lift].value, Oriented.Isomorphism)
};
