\import BundlesAt.Pullback[Y := Y, source := source, f := f, continuous := continuous] \as Native;
\import \root.Classification[].Oriented[].On[X := Y, baseSpace := source, k := k] \as Target;
\import Target.Compact[compact := sourceCompact] \as TargetClasses;
\definition preserves: \forall (a, b: Object) -> Homotopic a b -> TargetClasses.Homotopic (Native.object a) (Native.object b) :=
  \fun (a, b: Object)(related: _) => TargetClasses.isomorphicHomotopic (Native.object a) (Native.object b) (Native.respects a b (homotopicIsomorphic a b related));
\import Quotient.Maps[B := TargetClasses.Classes] \as Descend;
\definition respectsClasses: Descend.Respects (\fun (a: Object) => TargetClasses.class (Native.object a)) :=
  \fun (a, b: Object)(related: _) => (TargetClasses.classCriterion (Native.object a) (Native.object b)).rtl (Native.respects a b (homotopicIsomorphic a b related));
\definition map: Classes -> TargetClasses.Classes := Descend.value equivalence (\fun (a: Object) => TargetClasses.class (Native.object a)) respectsClasses;
\definition onClass: \forall (a: Object) -> map (class a) = TargetClasses.class (Native.object a) := Descend.onClass equivalence (\fun (a: Object) => TargetClasses.class (Native.object a)) respectsClasses;
