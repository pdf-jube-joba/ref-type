\import Bundles.Isomorphisms[X := X, F := Plain.Fiber a.projection, G := Plain.Fiber b.projection, source := Plain.bundle a.projection, target := Plain.bundle b.projection] \as PlainIsos;
\module Along(iso: PlainIsos.Isomorphism);
\definition Preserves[iso: PlainIsos.Isomorphism]: \Prop := Along[iso := iso].Preserves;
\structure Isomorphism: \Set := { value: PlainIsos.Isomorphism, preserves: Preserves value };
