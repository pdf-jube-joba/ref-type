\import \parent.Between[a := a, b := c] \as Result;
\definition plain: Bundles.Isomorphisms[X := X, F := Plain.Fiber a.projection, G := Plain.Fiber c.projection, source := Plain.bundle a.projection, target := Plain.bundle c.projection].Isomorphism :=
  Operations.IsomorphismComposition[X := X, F := Plain.Fiber a.projection, G := Plain.Fiber b.projection, H := Plain.Fiber c.projection, source := Plain.bundle a.projection, middle := Plain.bundle b.projection, target := Plain.bundle c.projection].compose first.value second.value;
\import Result.Along[iso := plain] \as Along;
\import \root.Classification[].Determinants[X := X, F := Plain.Fiber b.projection, G := Plain.Fiber c.projection, source := Plain.bundle b.projection, target := Plain.bundle c.projection, same := \refl(baseSpace), k := k, iso := second.value] \as Second;
\definition preserves: Along.Preserves := \fun (x: X)(alpha: DeterminantFiber c.projection x) => Logic.PropEquiv[_, _] {
  ltr := \fun (positive: _) => (first.preserves x ((Second.isomorphism.forward.fiber x).apply alpha)).ltr ((second.preserves x alpha).ltr positive),
  rtl := \fun (positive: _) => (second.preserves x alpha).rtl ((first.preserves x ((Second.isomorphism.forward.fiber x).apply alpha)).rtl positive)
};
\definition value: Result.Isomorphism := Result.Isomorphism { value := plain, preserves := preserves };
