\import \parent.\parent.On[X := Y, baseSpace := source, k := k] \as Target;
\import bundle_complements.Complements[].Over[K := R.Real, field := R.Algebra[].field, conjugation := hermitian_frames.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].Representations[X := X, baseSpace := baseSpace].Pullback[Y := Y, source := source, f := f, regularBase := continuous] \as Native;
\module At(a: Object);
\definition object[a: Object]: Target.Object := At[a := a].object;
\module Between(a, b: Object, iso: \root.Classification[].Oriented[].On[X := X, baseSpace := baseSpace, k := k].Between[a := a, b := b].Isomorphism);
\definition respects: \forall (a, b: Object) -> Isomorphic a b -> Target.Isomorphic (object a) (object b) := \fun (a, b: Object)(exists: _) => \block {
  \takefrom iso: \root.Classification[].Oriented[].On[X := X, baseSpace := baseSpace, k := k].Between[a := a, b := b].Isomorphism \by exists \then
  \return \exact(Between[a := a, b := b, iso := iso].value, Target.Between[a := object a, b := object b].Isomorphism)
};
