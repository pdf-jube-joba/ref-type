\import \parent.Trivial[X := X, baseSpace := bundle.baseSpace, n := n] \as Standard;
\import Bundles.Trivial[X := X, n := n, baseSpace := bundle.baseSpace] \as Trivial;
\import \parent.WhitneySum[X := X, F := F, G := (\fun (_: X) => Theory.Vector n), left := bundle, right := Trivial.bundle, same := \refl(bundle.baseSpace), k := k, l := n,
  leftRank := sourceRank, rightRank := Standard.rank, leftOrientation := sourceOrientation, rightOrientation := Standard.orientation] \as Sum;
\definition rank: N.Nat^ := Sum.rank;
\definition Fiber[x: X]: \Set := Sum.Fiber x;
\definition stabilizedBundle: Bundles.Family[X := X, F := Fiber].Bundle := Sum.bundle;
\definition orientation: \root.Classification[].Oriented[].For[X := X, F := Fiber, bundle := stabilizedBundle, k := rank].Orientation := Sum.orientation;
\definition hasRank: Theory.For[X := X, F := Fiber, bundle := stabilizedBundle].AtRank[k := rank].HasRank := Sum.sumRank;
\definition SumClassifier: \Set := \root.Classification[].Oriented[].For[X := X, F := Fiber, bundle := stabilizedBundle, k := rank].Classifier;
\definition classificationExists: topology.Topology[Carrier := X].IsCompact bundle.baseSpace -> topology.Topology[Carrier := X].IsT2 bundle.baseSpace ->
  \exists \root.Classification[].Oriented[].For[X := X, F := Fiber, bundle := stabilizedBundle, k := rank].With[orientation := orientation].Representative := Sum.classificationExists;
\module Classifying(classifier: Theory.For[X := X, F := F, bundle := bundle].AtRank[k := k].Classifier);
