\import \root.Classification[].Oriented[].WhitneySum[X := X, F := F, G := G, left := left, right := right, same := same, k := k, l := l,
  leftRank := leftRank, rightRank := rightRank, leftOrientation := leftOrientation, rightOrientation := rightOrientation].InFrames[
    x := p.base, a := c.left.frame (Chart.leftPoint (center p)), b := c.right.frame (Chart.rightPoint (center p))] \as Frames;
\definition gamma: Forms.Fiber p.base := (map p).vector;
\definition point: SumTop.LocalTotal := \into[Family.Point](map p, { q: Family.Point \where Base.Member Chart.domain q.base }) \by { \bysub(InputFamily.Point, domain c, p) };
\definition coefficientEquality: SumTop.coefficient point = coefficient p :=
  Frames.coefficientProduct (firstPoint p).vector (secondPoint p).vector;
\definition coordinates: (SumTop.chart.frame (center p)).forward.apply gamma = vector p :=
  \axiom:funext((SumTop.chart.frame (center p)).forward.apply gamma, vector p,
    \fun (i: Fin.Fin SumTop.dimension) => trans!{R.Real} _ _ _ (SumTop.coordinateFormula point i) coefficientEquality);
\definition formula: model p = map p := congr!{{Forms.Fiber p.base} Family.Point} (Family.include p.base) _ _
  (trans!{{Forms.Fiber p.base}} _ _ _ (congr!{{Bundles.Vector SumTop.dimension} {Forms.Fiber p.base}} (SumTop.chart.frame (center p)).backward.apply _ _ (sym!{{Bundles.Vector SumTop.dimension}} _ _ coordinates))
    ((SumTop.chart.frame (center p)).leftInverse gamma));
