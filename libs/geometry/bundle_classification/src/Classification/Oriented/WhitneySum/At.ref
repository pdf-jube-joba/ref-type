\import \root.Classification[].DeterminantProduct[V := F x, W := G x, left := left.space x, right := right.space x, n := k, m := l, first := leftRank x, second := rightRank x] \as Product;
\definition product[alpha: First.DeterminantFiber x][beta: Second.DeterminantFiber x]: Forms.Fiber x := Product.product alpha beta;
\definition formula: \forall (alpha: First.DeterminantFiber x)(beta: Second.DeterminantFiber x)(u: Fin.Fin k -> F x)(v: Fin.Fin l -> G x) ->
  product alpha beta (Product.concatenate u v) = R.mul (alpha u) (beta v) := Product.formula;
\definition scaleLeft: \forall (a: R.Real)(alpha: First.DeterminantFiber x)(beta: Second.DeterminantFiber x) ->
  product ((First.determinantBundle.space x).smul a alpha) beta = (Forms.fiberSpace x).smul a (product alpha beta) := Product.Laws[].scaleLeft;
\definition scaleRight: \forall (a: R.Real)(alpha: First.DeterminantFiber x)(beta: Second.DeterminantFiber x) ->
  product alpha ((Second.determinantBundle.space x).smul a beta) = (Forms.fiberSpace x).smul a (product alpha beta) := Product.Laws[].scaleRight;
\definition nonzero: \forall (alpha: First.DeterminantFiber x)(beta: Second.DeterminantFiber x) ->
  Logic.Not (alpha = (First.determinantBundle.space x).zero) -> Logic.Not (beta = (Second.determinantBundle.space x).zero) -> Logic.Not (product alpha beta = (Forms.fiberSpace x).zero) := Product.Laws[].nonzero;
