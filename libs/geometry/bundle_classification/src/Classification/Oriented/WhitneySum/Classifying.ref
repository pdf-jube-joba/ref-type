\import Theory.For[X := X, F := F, bundle := left].AtRank[k := k] \as FirstPlain;
\import Theory.For[X := X, F := G, bundle := right].AtRank[k := l] \as SecondPlain;
\definition LeftFiber[x: X]: \Set := FirstPlain.Fiber first.data x;
\definition RightFiber[x: X]: \Set := SecondPlain.Fiber second.data x;
\definition leftBundle: Bundles.Family[X := X, F := LeftFiber].Bundle := FirstPlain.imageBundle first.data;
\definition rightBundle: Bundles.Family[X := X, F := RightFiber].Bundle := SecondPlain.imageBundle second.data;
\import First.With[orientation := leftOrientation].From[classifier := first] \as LeftClassified;
\import Second.With[orientation := rightOrientation].From[classifier := second] \as RightClassified;
\import \root.Classification[].RankTransport[X := X, F := F, G := LeftFiber, source := left, target := leftBundle, n := k, iso := first.comparison, original := leftRank] \as LeftRank;
\import \root.Classification[].RankTransport[X := X, F := G, G := RightFiber, source := right, target := rightBundle, n := l, iso := second.comparison, original := rightRank] \as RightRank;
\import \parent.Mapping[A := LeftFiber, B := RightFiber, newLeft := leftBundle, newRight := rightBundle,
  leftSame := \refl(left.baseSpace), rightSame := \refl(right.baseSpace), newLeftRank := LeftRank.rank, newRightRank := RightRank.rank,
  newLeftOrientation := LeftClassified.object.orientation, newRightOrientation := RightClassified.object.orientation, f := first.comparison, g := second.comparison] \as Mapping;
\import Mapping.With[first := LeftClassified.preserves, second := RightClassified.preserves] \as Natural;
\import \root.Classification[].Oriented[].WhitneySum[X := X, F := LeftFiber, G := RightFiber, left := leftBundle, right := rightBundle, same := Mapping.targetSame, k := k, l := l,
  leftRank := LeftRank.rank, rightRank := RightRank.rank, leftOrientation := LeftClassified.object.orientation, rightOrientation := RightClassified.object.orientation] \as Target;
\definition preserves: Mapping.Preserves := Natural.preserves;
\module WithSum(classifier: SumClassifiers.Classifier);
