\import topology.Topology[Carrier := Family.Point] \as Total;
\import topology.Topology[Carrier := X] \as Base;
\module Neighborhood(p: Family.Point, w: Witness[p.base, p.vector], c: LeftAtlas.Local k, d: RightAtlas.Local l,
  inLeft: Base.Member c.domain p.base, inRight: Base.Member d.domain p.base,
  leftEnumeration: Operations.ExteriorIndices[n := k, k := k].Enumeration,
  rightEnumeration: Operations.ExteriorIndices[n := l, k := l].Enumeration,
  sumEnumeration: Operations.ExteriorIndices[n := rank, k := rank].Enumeration);
\definition open: Total.IsOpenIn Forms.alternating.totalSpace positive := Total.openOfNeighborhoods Forms.alternating.totalSpace positive (\fun (p: Family.Point)(member: _) => \block {
  \takefrom w: Witness[p.base, p.vector] \by member \then
  \takefrom c: \Cast[LeftAtlas.Local k] ({ c: LeftAtlas.Local k \where Base.Member c.domain p.base }) \by LeftAtlas.covers p.base \then
  \takefrom d: \Cast[RightAtlas.Local l] ({ d: RightAtlas.Local l \where Base.Member d.domain p.base }) \by RightAtlas.covers p.base \then
  \takefrom a: Operations.ExteriorIndices[n := k, k := k].Enumeration \by Operations.ExteriorIndices[n := k, k := k].existsEnumeration \then
  \takefrom b: Operations.ExteriorIndices[n := l, k := l].Enumeration \by Operations.ExteriorIndices[n := l, k := l].existsEnumeration \then
  \takefrom s: Operations.ExteriorIndices[n := rank, k := rank].Enumeration \by Operations.ExteriorIndices[n := rank, k := rank].existsEnumeration \then
  \return Neighborhood[p := p, w := w, c := c, d := d,
    inLeft := \bysub(LeftAtlas.Local k, { c: LeftAtlas.Local k \where Base.Member c.domain p.base }, c),
    inRight := \bysub(RightAtlas.Local l, { d: RightAtlas.Local l \where Base.Member d.domain p.base }, d),
    leftEnumeration := a, rightEnumeration := b, sumEnumeration := s].exists
});
