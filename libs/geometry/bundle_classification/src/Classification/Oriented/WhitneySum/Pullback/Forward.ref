\definition positive: Positive (f y) gamma := \exact(Witness[f y, gamma] {
  first := witness.first, second := witness.second,
  leftPositive := (FirstPull.criterion y witness.first).ltr witness.leftPositive,
  rightPositive := (SecondPull.criterion y witness.second).ltr witness.rightPositive,
  value := trans!{{Forms.Fiber (f y)}} _ _ _ witness.value (productEquality y witness.first witness.second)
}, Witness[f y, gamma]);
