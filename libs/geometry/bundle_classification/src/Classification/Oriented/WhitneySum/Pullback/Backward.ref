\definition positive: Target.Positive y gamma := \exact(Target.Witness[y, gamma] {
  first := witness.first, second := witness.second,
  leftPositive := (FirstPull.criterion y witness.first).rtl witness.leftPositive,
  rightPositive := (SecondPull.criterion y witness.second).rtl witness.rightPositive,
  value := trans!{{Target.DeterminantFiber y}} _ _ _ witness.value (sym!{{Target.DeterminantFiber y}} _ _ (productEquality y witness.first witness.second))
}, Target.Witness[y, gamma]);
