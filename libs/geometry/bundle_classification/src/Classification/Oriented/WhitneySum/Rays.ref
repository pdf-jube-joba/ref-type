\import \parent.At[x := x] \as Point;
\definition exists: \exists ( a: R.Real \where Logic.And[Order.Lt R.zero a, delta = (Forms.fiberSpace x).smul a gamma] ) := \block {
  \takefrom a: \Cast[R.Real] ({ a: R.Real \where Logic.And[Order.Lt R.zero a, second.first = (First.determinantBundle.space x).smul a first.first] })
    \by (LeftCones.laws leftOrientation).ray x first.first second.first first.leftPositive second.leftPositive \then
  \takefrom b: \Cast[R.Real] ({ b: R.Real \where Logic.And[Order.Lt R.zero b, second.second = (Second.determinantBundle.space x).smul b first.second] })
    \by (RightCones.laws rightOrientation).ray x first.second second.second first.rightPositive second.rightPositive \then
  \let pa: Logic.And[Order.Lt R.zero a, second.first = (First.determinantBundle.space x).smul a first.first] :=
    \bysub(R.Real, { a: R.Real \where Logic.And[Order.Lt R.zero a, second.first = (First.determinantBundle.space x).smul a first.first] }, a) \then
  \let pb: Logic.And[Order.Lt R.zero b, second.second = (Second.determinantBundle.space x).smul b first.second] :=
    \bysub(R.Real, { b: R.Real \where Logic.And[Order.Lt R.zero b, second.second = (Second.determinantBundle.space x).smul b first.second] }, b) \then
  \let equation: delta = (Forms.fiberSpace x).smul (R.mul a b) gamma := trans!{{Forms.Fiber x}} _ _ _ second.value
    (trans!{{Forms.Fiber x}} _ _ _ (congr!{{First.DeterminantFiber x} {Second.DeterminantFiber x} {Forms.Fiber x}} (product x) _ _ _ _ pa.right pb.right)
      (trans!{{Forms.Fiber x}} _ _ _ (Point.scaleLeft a first.first ((Second.determinantBundle.space x).smul b first.second))
        (trans!{{Forms.Fiber x}} _ _ _ (congr!{{Forms.Fiber x} {Forms.Fiber x}} ((Forms.fiberSpace x).smul a) _ _ (Point.scaleRight b first.first first.second))
          (trans!{{Forms.Fiber x}} _ _ _ (sym!{{Forms.Fiber x}} _ _ ((Forms.fiberSpace x).scalarAssoc a b (product x first.first first.second)))
            (congr!{{Forms.Fiber x} {Forms.Fiber x}} ((Forms.fiberSpace x).smul (R.mul a b)) _ _ (sym!{{Forms.Fiber x}} _ _ first.value)))))) \then
  \return Logic.existsIntro[R.Real, { a: R.Real \where Logic.And[Order.Lt R.zero a, delta = (Forms.fiberSpace x).smul a gamma] }]
    (R.mul a b) (Logic.And[_, _]::# (Bounds.mulPositive a b pa.left pb.left) equation)
};
