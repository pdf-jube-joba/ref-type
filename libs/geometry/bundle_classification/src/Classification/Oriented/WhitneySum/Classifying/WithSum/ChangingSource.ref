\import \root.Classification[].Oriented[].WhitneySum[X := X, F := F, G := G, left := left, right := right, same := same, k := k, l := l,
  leftRank := leftRank, rightRank := rightRank, leftOrientation := leftOrientation, rightOrientation := rightOrientation].Classifying[first := first, second := second].WithSum[classifier := other] \as Other;
\import SumClassifiers.With[orientation := orientation].Compare[first := classifier, second := other] \as SourceCompare;
\definition independent: \forall (compact: topology.Topology[Carrier := X].IsCompact left.baseSpace) ->
  Oriented.Compact[compact := compact].class object = Oriented.Compact[compact := compact].class Other.object :=
  \fun (compact: _) => trans!{Oriented.Compact[compact := compact].Classes} _ _ _
    (sym!{Oriented.Compact[compact := compact].Classes} _ _ (naturality compact))
    (trans!{Oriented.Compact[compact := compact].Classes} _ _ _
      ((Oriented.Compact[compact := compact].classCriterion before Other.before).rtl
        (\exact(SourceCompare.isomorphism, Oriented.Between[a := before, b := Other.before].Isomorphism)))
      (Other.naturality compact));
