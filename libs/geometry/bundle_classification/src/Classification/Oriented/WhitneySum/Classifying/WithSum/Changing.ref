\import \root.Classification[].Oriented[].WhitneySum[X := X, F := F, G := G, left := left, right := right, same := same, k := k, l := l,
  leftRank := leftRank, rightRank := rightRank, leftOrientation := leftOrientation, rightOrientation := rightOrientation].Classifying[first := newFirst, second := newSecond].WithSum[classifier := classifier] \as Other;
\definition independent: \forall (compact: topology.Topology[Carrier := X].IsCompact left.baseSpace) ->
  Oriented.Compact[compact := compact].class object = Oriented.Compact[compact := compact].class Other.object :=
  \fun (compact: _) => trans!{Oriented.Compact[compact := compact].Classes} _ _ _
    (sym!{Oriented.Compact[compact := compact].Classes} _ _ (naturality compact)) (Other.naturality compact);
