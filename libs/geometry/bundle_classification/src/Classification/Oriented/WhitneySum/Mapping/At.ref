\import \root.Classification[].DeterminantProduct[V := F x, W := G x, left := left.space x, right := right.space x, n := k, m := l,
  first := leftRank x, second := rightRank x].Mapping[A := A x, B := B x, targetLeft := newLeft.space x, targetRight := newRight.space x,
    targetFirst := newLeftRank x, targetSecond := newRightRank x, f := f.forward.fiber x, g := g.forward.fiber x] \as Mapping;
\definition naturality: \forall (alpha: TargetFirst.DeterminantFiber x)(beta: TargetSecond.DeterminantFiber x) ->
  product x ((FirstDet.isomorphism.forward.fiber x).apply alpha) ((SecondDet.isomorphism.forward.fiber x).apply beta) =
    (SumDet.isomorphism.forward.fiber x).apply (Target.product x alpha beta) := Mapping.naturality;
