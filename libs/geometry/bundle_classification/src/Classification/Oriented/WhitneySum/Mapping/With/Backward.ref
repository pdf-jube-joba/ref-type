\definition alpha: TargetFirst.DeterminantFiber x := (FirstDet.isomorphism.backward.fiber x).apply w.first;
\definition beta: TargetSecond.DeterminantFiber x := (SecondDet.isomorphism.backward.fiber x).apply w.second;
\definition firstPositive: FirstCones.Positive newLeftOrientation.positive x alpha := (first x alpha).rtl
  (\idelim w.first = (FirstDet.isomorphism.forward.fiber x).apply alpha \with z: First.DeterminantFiber x => LeftCones.Positive leftOrientation.positive x z \by {
    base: w.leftPositive, equality: sym!{{First.DeterminantFiber x}} _ _ (firstLaws.rightInverse x w.first)
  });
\definition secondPositive: SecondCones.Positive newRightOrientation.positive x beta := (second x beta).rtl
  (\idelim w.second = (SecondDet.isomorphism.forward.fiber x).apply beta \with z: Second.DeterminantFiber x => RightCones.Positive rightOrientation.positive x z \by {
    base: w.rightPositive, equality: sym!{{Second.DeterminantFiber x}} _ _ (secondLaws.rightInverse x w.second)
  });
\definition pulled: (SumDet.isomorphism.forward.fiber x).apply gamma = (SumDet.isomorphism.forward.fiber x).apply (Target.product x alpha beta) :=
  trans!{{Forms.Fiber x}} _ _ _ w.value
    (trans!{{Forms.Fiber x}} _ _ _ (congr!{{First.DeterminantFiber x} {Second.DeterminantFiber x} {Forms.Fiber x}} (product x) _ _ _ _
      (sym!{{First.DeterminantFiber x}} _ _ (firstLaws.rightInverse x w.first)) (sym!{{Second.DeterminantFiber x}} _ _ (secondLaws.rightInverse x w.second)))
      (productNaturality x alpha beta));
\definition equality: gamma = Target.product x alpha beta := trans!{{Target.DeterminantFiber x}} _ _ _ (sym!{{Target.DeterminantFiber x}} _ _ (sumLaws.leftInverse x gamma))
  (trans!{{Target.DeterminantFiber x}} _ _ _ (congr!{{Forms.Fiber x} {Target.DeterminantFiber x}} (SumDet.isomorphism.backward.fiber x).apply _ _ pulled) (sumLaws.leftInverse x (Target.product x alpha beta)));
\definition positive: Target.Positive x gamma := \exact(Target.Witness[x, gamma] { first := alpha, second := beta, leftPositive := firstPositive, rightPositive := secondPositive, value := equality }, Target.Witness[x, gamma]);
