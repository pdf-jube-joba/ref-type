\import Theory.For[X := X, F := F, bundle := bundle].AtRank[k := k] \as Plain;
\import Operations.Alternating[X := X, F := F, bundle := bundle, k := k] \as Determinant;
\import \root.Classification[].Orientations[X := X, F := Determinant.Fiber, bundle := Determinant.alternating] \as Cones;
\import \parent.On[X := X, baseSpace := bundle.baseSpace, k := k] \as Target;
\definition Orientation: \Set := Cones.Orientation;
\definition Classifier: \Set := Plain.Classifier;
\definition DeterminantFiber[x: X]: \Set := Determinant.Fiber x;
\definition determinantBundle: Bundles.Family[X := X, F := DeterminantFiber].Bundle := Determinant.alternating;
\module With(orientation: Cones.Orientation);
