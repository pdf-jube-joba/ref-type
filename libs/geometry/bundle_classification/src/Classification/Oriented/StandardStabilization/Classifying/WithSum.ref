\import Natural.WithSum[classifier := classifier] \as Compare;
\import \root.Classification[].Oriented[].On[X := X, baseSpace := bundle.baseSpace, k := rank] \as Classes;
\definition before: Classes.Object := Compare.before;
\definition object: Classes.Object := Compare.object;
\definition isomorphism: Classes.Between[a := before, b := object].Isomorphism := Compare.isomorphism;
\definition naturality: \forall (compact: topology.Topology[Carrier := X].IsCompact bundle.baseSpace) -> Classes.Compact[compact := compact].class before = Classes.Compact[compact := compact].class object := Compare.naturality;
\definition homotopy: \forall (compact: topology.Topology[Carrier := X].IsCompact bundle.baseSpace) -> Classes.Compact[compact := compact].Homotopic before object := Compare.homotopy;
