\module From(classifier: Plain.Classifier);
\definition Comparison[object: Target.Object]: \Set := Bundles.Isomorphisms[X := X, F := F, G := Theory.On[X := X, baseSpace := bundle.baseSpace].Fiber object.projection,
  source := bundle, target := Theory.On[X := X, baseSpace := bundle.baseSpace].bundle object.projection].Isomorphism;
\module Along(object: Target.Object, comparison: Comparison object);
\definition Preserves[object: Target.Object][comparison: Comparison object]: \Prop := Along[object := object, comparison := comparison].Preserves;
\structure Representative: \Set := { object: Target.Object, comparison: Comparison object, preserves: Preserves object comparison };
\definition exists: topology.Topology[Carrier := X].IsCompact bundle.baseSpace -> topology.Topology[Carrier := X].IsT2 bundle.baseSpace -> Plain.HasRank -> \exists Representative :=
  \fun (compact: _)(hausdorff: _)(rank: Plain.HasRank) => \block {
    \takefrom classifier: Plain.Classifier \by Plain.exists compact hausdorff rank \then
    \return \exact(Representative { object := From[classifier := classifier].object, comparison := classifier.comparison, preserves := From[classifier := classifier].preserves }, Representative)
  };
\module Compare(first, second: Plain.Classifier);
\module Pullback(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  continuous: topology.Continuity[A := Y, B := X].Continuous source bundle.baseSpace f);
