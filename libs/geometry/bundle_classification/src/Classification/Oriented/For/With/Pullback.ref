\import Bundles.Family[X := X, F := F].Of[bundle := bundle].Pullback[Y := Y, source := source, f := f] \as Pull;
\definition Fiber[y: Y]: \Set := F (f y);
\definition pulledBundle: Bundles.Family[X := Y, F := Fiber].Bundle := Pull.pulled continuous;
\import Determinant.Pullback[Y := Y, source := source, f := f, regular := continuous] \as FormsPull;
\import Cones.Pullback[Y := Y, source := source, f := f, continuous := continuous, orientation := orientation] \as ConePull;
\definition DeterminantFiber[y: Y]: \Set := Determinant.Fiber (f y);
\definition determinantBundle: Bundles.Family[X := Y, F := DeterminantFiber].Bundle := FormsPull.secondBundle;
\import Bundles.Isomorphisms[X := Y, F := DeterminantFiber, G := DeterminantFiber, source := FormsPull.firstBundle, target := FormsPull.secondBundle] \as Isos;
\import \root.Classification[].Orientations[X := Y, F := DeterminantFiber, bundle := FormsPull.firstBundle].Along[G := DeterminantFiber, target := FormsPull.secondBundle,
  iso := Isos.inverse FormsPull.isomorphism, orientation := ConePull.orientationOnPullback] \as Transport;
\import \root.Classification[].Orientations[X := Y, F := DeterminantFiber, bundle := FormsPull.secondBundle] \as New;
\definition orientationOnPullback: New.Orientation := Transport.orientationOnTarget;
\definition criterion: \forall (y: Y)(alpha: DeterminantFiber y) ->
  Logic.PropEquiv[New.Positive orientationOnPullback.positive y alpha, Cones.Positive orientation.positive (f y) alpha] :=
  \fun (y: Y)(alpha: DeterminantFiber y) => Logic.PropEquiv[_, _] { ltr := \fun (positive: _) => positive, rtl := \fun (positive: _) => positive };
\definition rank: Plain.HasRank -> Theory.For[X := Y, F := Fiber, bundle := pulledBundle].AtRank[k := k].HasRank :=
  \fun (original: Plain.HasRank)(y: Y) => original (f y);
