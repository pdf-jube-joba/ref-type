\definition presentation: Theory.On[X := X, baseSpace := bundle.baseSpace].Presentation := Theory.On[X := X, baseSpace := bundle.baseSpace].Presentation {
  dimension := classifier.data.dimension, projection := classifier.data.projection, regular := classifier.data.regular
};
\definition projection: Target.Projection := \into[Theory.On[X := X, baseSpace := bundle.baseSpace].Presentation](presentation, Target.Projection) \by { classifier.rank };
\import \root.Classification[].Determinants[X := X, F := F, G := Theory.On[X := X, baseSpace := bundle.baseSpace].Fiber projection,
  source := bundle, target := Theory.On[X := X, baseSpace := bundle.baseSpace].bundle projection, same := \refl(bundle.baseSpace), k := k, iso := classifier.comparison] \as Determinants;
\import Cones.Along[G := Target.DeterminantFiber projection, target := Target.determinantBundle projection, iso := Determinants.isomorphism, orientation := orientation] \as Transport;
\definition object: Target.Object := Target.Object { projection := projection, orientation := Transport.orientationOnTarget };
\definition preserves: \forall (x: X)(alpha: Target.DeterminantFiber projection x) ->
  Logic.PropEquiv[\root.Classification[].Orientations[X := X, F := Target.DeterminantFiber projection, bundle := Target.determinantBundle projection].Positive object.orientation.positive x alpha,
    Cones.Positive orientation.positive x ((Determinants.isomorphism.forward.fiber x).apply alpha)] :=
  \fun (x: X)(alpha: Target.DeterminantFiber projection x) => Logic.PropEquiv[_, _] { ltr := \fun (p: _) => p, rtl := \fun (p: _) => p };
