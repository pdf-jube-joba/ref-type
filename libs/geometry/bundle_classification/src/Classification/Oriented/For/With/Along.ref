\import \root.Classification[].Determinants[X := X, F := F, G := Theory.On[X := X, baseSpace := bundle.baseSpace].Fiber object.projection,
  source := bundle, target := Theory.On[X := X, baseSpace := bundle.baseSpace].bundle object.projection, same := \refl(bundle.baseSpace), k := k, iso := comparison] \as Determinants;
\import \root.Classification[].Orientations[X := X, F := Target.DeterminantFiber object.projection, bundle := Target.determinantBundle object.projection] \as New;
\definition Preserves: \Prop := \forall (x: X)(alpha: Target.DeterminantFiber object.projection x) -> Logic.PropEquiv[New.Positive object.orientation.positive x alpha,
  Cones.Positive orientation.positive x ((Determinants.isomorphism.forward.fiber x).apply alpha)];
