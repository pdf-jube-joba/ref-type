\import Operations.DirectSum[X := X, F := F, G := G, left := left, right := right] \as Source;
\definition SourceFiber[x: X]: \Set := Source.Fiber x;
\definition sourceBundle: Bundles.Family[X := X, F := Source.Fiber].Bundle := Source.bundle same;
\import Theory.For[X := X, F := F, bundle := left].AtRank[k := k] \as First;
\import Theory.For[X := X, F := G, bundle := right].AtRank[k := l] \as Second;
\definition LeftFiber[x: X]: \Set := First.Fiber first.data x;
\definition RightFiber[x: X]: \Set := Second.Fiber second.data x;
\definition leftBundle: Bundles.Family[X := X, F := LeftFiber].Bundle := First.imageBundle first.data;
\definition rightBundle: Bundles.Family[X := X, F := RightFiber].Bundle := Second.imageBundle second.data;
\import Operations.DirectSumIsomorphisms[X := X, F := F, G := G, A := LeftFiber, B := RightFiber,
  first := left, second := right, newFirst := leftBundle, newSecond := rightBundle, sameSource := same, sameTarget := same] \as Sums;
\definition TargetFiber[x: X]: \Set := Sums.TargetFiber x;
\definition targetBundle: Bundles.Family[X := X, F := TargetFiber].Bundle := Sums.targetBundle;
\definition comparison: Bundles.Isomorphisms[X := X, F := Source.Fiber, G := TargetFiber, source := sourceBundle, target := targetBundle].Isomorphism := Sums.isomorphism first.comparison second.comparison;
\import Fin.Sum[m := k, n := l] \as Rank;
\definition rank: N.Nat^ := Rank.total;
\import \root.Classification[].Oriented[].For[X := X, F := Source.Fiber, bundle := sourceBundle, k := rank] \as Original;
\module With(orientation: Original.Orientation, classifier: Original.Classifier);
