\import \root.Classification[].TopForms[V := V, space := left, n := n, frame := a] \as LeftTop;
\import \root.Classification[].TopForms[V := W, space := right, n := m, frame := b] \as RightTop;
\import \root.Classification[].ScalarSigns[] \as Signs;
\definition nonzero: \forall (alpha: LeftForm)(beta: RightForm) -> Logic.Not (alpha = LeftForms.vectorSpace.zero) -> Logic.Not (beta = RightForms.vectorSpace.zero) -> Logic.Not (product alpha beta = formSpace.zero) :=
  \fun (alpha: LeftForm)(beta: RightForm)(na: _)(nb: _)(zero: _) => Signs.nonzeroProduct (LeftTop.coefficient alpha) (RightTop.coefficient beta)
    (LeftTop.coefficientNonzero alpha na) (RightTop.coefficientNonzero beta nb)
    (trans!{R.Real} _ _ _ (sym!{R.Real} _ _ (formula alpha beta LeftTop.arguments RightTop.arguments))
      (congr!{Form R.Real} (\fun (gamma: Form) => gamma (concatenate LeftTop.arguments RightTop.arguments)) _ _ zero));
