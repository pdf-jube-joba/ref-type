\import \root.Classification[].TopForms[V := V, space := left, n := n, frame := a].DirectSum[W := W, right := right, m := m, other := b].Factorization[] \as Finite;
\definition product[alpha: LeftForm][beta: RightForm]: Form := Finite.product alpha beta;
\definition formula: \forall (alpha: LeftForm)(beta: RightForm) -> Formula alpha beta (product alpha beta) := Finite.productFormula;
\definition exists: \forall (alpha: LeftForm)(beta: RightForm) -> \exists Value alpha beta :=
  \fun (alpha: LeftForm)(beta: RightForm) => \exact(\into[Form](product alpha beta, Value alpha beta) \by { formula alpha beta }, Value alpha beta);
\definition unique: \forall (gamma, delta: Form) ->
  (\forall (u: Fin.Fin n -> V)(v: Fin.Fin m -> W) -> gamma (concatenate u v) = delta (concatenate u v)) -> gamma = delta := Finite.unique;
