\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Bundles;
\import bundle_complements.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Complements;
\import bundle_operations.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Operations;
\import bundle_homotopy.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Homotopy;
\import linear_algebra.Commutative[K := K, scalarRing := Fields.fieldAsCommutativeRing K field] \as Spaces;
\import linear_algebra.Hermitian[].Over[K := K, field := field, scalar := conjugation] \as Geometry;
\import hermitian_frames.Hermitian[].Over[K := K, field := field, scalar := conjugation, topological := scalar.topological] \as Hermitian;
\definition Vector[n: N.Nat^]: \Set := Bundles.Vector n;
\definition coordinates[n: N.Nat^]: Spaces.VectorSpace (Vector n) := Bundles.coordinates n;
\definition coordinateTopology[n: N.Nat^]: topology.Topology[Carrier := Vector n].Topology := Bundles.coordinateTopology n;
\module For(X: \Set, F: X -> \Set, bundle: Bundles.Family[X := X, F := F].Bundle);
\module VectorFunctions(n: N.Nat^, Y: \Set, source: topology.Topology[Carrier := Y].Topology);
\module ImageMaps(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology, n, m: N.Nat^,
  P: X -> Hermitian.At[n := n].Projection, Q: X -> Hermitian.At[n := m].Projection,
  regularP: Hermitian.At[n := n].Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (P x).map),
  regularQ: Hermitian.At[n := m].Families[X := X].Matrix[m := m].Regular baseSpace (\fun (x: X) => (Q x).map));
\module Padding(n, m: N.Nat^);
\module On(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology);
\module ProjectionIdentity(n: N.Nat^, V: \Set, space: Spaces.VectorSpace V,
  e: Spaces.Linear[V := V, W := Vector n, source := space, target := coordinates n].Map,
  injective: \forall (v, w: V) -> e.apply v = e.apply w -> v = w,
  Q: Hermitian.At[n := n].Projection, preimage: Vector n -> V,
  fixes: \forall (v: V) -> Q.map.apply (e.apply v) = e.apply v,
  covers: \forall (z: Vector n) -> e.apply (preimage z) = Q.map.apply z);
\module ProjectionFrames(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology, n, k: N.Nat^,
  P: X -> Hermitian.At[n := n].Projection,
  regular: Hermitian.At[n := n].Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (P x).map));
\module TrivialFamily(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology, n, m: N.Nat^,
  map: Bundles.Morphisms[X := X, Y := X, F := (\fun (_: X) => Vector n), G := (\fun (_: X) => Vector m),
    source := Bundles.Trivial[X := X, n := n, baseSpace := baseSpace].bundle, target := Bundles.Trivial[X := X, n := m, baseSpace := baseSpace].bundle, f := (\fun (x: X) => x)].Map);
\module Frames(n, k: N.Nat^);
\module Framed(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology, k: N.Nat^);
\module ProjectionSpace(n: N.Nat^);
\module FrameSum(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology, k, l: N.Nat^,
  p: \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Framed[X := X, baseSpace := baseSpace, k := k].Presentation,
  q: \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Framed[X := X, baseSpace := baseSpace, k := l].Presentation);
\module FrameStabilization(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology, k, n: N.Nat^,
  p: \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Framed[X := X, baseSpace := baseSpace, k := k].Presentation);
