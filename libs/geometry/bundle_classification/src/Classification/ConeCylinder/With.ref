\definition laws: Isos.Laws[iso] := \bysub(Isos.Data, Isos.Isomorphism, iso);
\module At(x: X, alpha: L x, nonzero: Logic.Not (alpha = (source.space x).zero));
\definition signs: \forall (x: X)(alpha: L x) -> Logic.Not (alpha = (source.space x).zero) ->
  Logic.PropEquiv[Cones.Positive orientation.positive (Cylinder.at I.start x) ((iso.forward.fiber (Cylinder.at I.start x)).apply alpha),
    Cones.Positive orientation.positive (Cylinder.at I.end x) ((iso.forward.fiber (Cylinder.at I.end x)).apply alpha)] :=
  \fun (x: X)(alpha: L x)(nz: _) => At[x := x, alpha := alpha, nonzero := nz].signs;
