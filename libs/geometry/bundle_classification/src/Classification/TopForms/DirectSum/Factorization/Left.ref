\import \parent.\parent.Arguments[] \as Updates;
\import LeftTop.Restrict[U := Sum.Carrier, target := Sum.space, total := rank, slot := Indices.left,
  injective := (\fun (i, j: Fin.Fin n) => Indices.leftInjective i j), inclusion := inLeft,
  extend := (\fun (u: Fin.Fin n -> V) => concatenate u v),
  at := (\fun (u: Fin.Fin n -> V)(i: Fin.Fin n) => Tuples.atLeft (\fun (j: Fin.Fin n) => inLeft.apply (u j)) (\fun (j: Fin.Fin m) => inRight.apply (v j)) i),
  update := (\fun (u: Fin.Fin n -> V)(i: Fin.Fin n)(w: V) => Updates.updateLeft u v i w)] \as Restriction;
\definition form[alpha: TotalTop.Form]: Form := Restriction.form alpha;
