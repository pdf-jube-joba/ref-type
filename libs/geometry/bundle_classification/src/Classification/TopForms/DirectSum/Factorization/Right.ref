\import \parent.\parent.Arguments[] \as Updates;
\import RightTop.Restrict[U := Sum.Carrier, target := Sum.space, total := rank, slot := Indices.right,
  injective := (\fun (i, j: Fin.Fin m) => Indices.rightInjective i j), inclusion := inRight,
  extend := (\fun (v: Fin.Fin m -> W) => concatenate u v),
  at := (\fun (v: Fin.Fin m -> W)(i: Fin.Fin m) => Tuples.atRight (\fun (j: Fin.Fin n) => inLeft.apply (u j)) (\fun (j: Fin.Fin m) => inRight.apply (v j)) i),
  update := (\fun (v: Fin.Fin m -> W)(i: Fin.Fin m)(w: W) => Updates.updateRight u v i w)] \as Restriction;
\definition form[alpha: TotalTop.Form]: RightTop.Form := Restriction.form alpha;
