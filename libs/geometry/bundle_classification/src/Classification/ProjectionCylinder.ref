\import real.Analysis[] \as R;
\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := X] \as Cylinder;
\import \parent.Over[K := R.Real, field := R.Algebra[].field, conjugation := hermitian_frames.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Theory;
\import vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := hermitian_frames.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Bundles;
\import bundle_operations.Operations[].Over[K := R.Real, field := R.Algebra[].field, conjugation := hermitian_frames.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Operations;
\import bundle_complements.Complements[].Over[K := R.Real, field := R.Algebra[].field, conjugation := hermitian_frames.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Complements;
\import bundle_homotopy.Homotopy[].Over[K := R.Real, field := R.Algebra[].field, conjugation := hermitian_frames.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Homotopy;
\import RealHermitian.At[n := n] \as Native;
\definition stationary: \forall (x: X) -> \In[X] (topology.Topology[Carrier := X].Empty) x -> \forall (s, t: I.Carrier) -> (P (Cylinder.at s x)).map = (P (Cylinder.at t x)).map :=
  \fun (x: X)(empty: Logic.False)(s, t: I.Carrier) => Logic.falseElim _ empty;
\import Homotopy.Projections[n := n].Homotopy[X := X, baseSpace := baseSpace, compact := compact, P := P, regular := regular, A := topology.Topology[Carrier := X].Empty, stationary := stationary] \as Motion;
\import Homotopy.Projections[n := n].Isotopy[X := X, baseSpace := baseSpace, compact := compact, P := P, regular := regular, A := topology.Topology[Carrier := X].Empty, stationary := stationary] \as Isotopy;
\import Motion.Slice[t := I.start] \as Start;
\import Motion.Slice[t := I.end] \as Finish;
\import Complements.Projection[X := Cylinder.Carrier, n := n, baseSpace := Cylinder.topology baseSpace, P := P, regular := regular] \as Image;
\module Lift(lift: Isotopy.RelativeIsomorphism[I.start, I.end]);
\definition LiftType: \Set := Isotopy.RelativeIsomorphism[I.start, I.end];
\definition liftExists: \exists LiftType := Isotopy.isomorphismExists;
