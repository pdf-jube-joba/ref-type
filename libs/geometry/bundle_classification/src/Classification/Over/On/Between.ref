\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := X] \as Cylinder;
\definition n: N.Nat^ := p.dimension;
\definition m: N.Nat^ := q.dimension;
\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Padding[n := n, m := m] \as Pad;
\definition dimension: N.Nat^ := Pad.dimension;
\import Hermitian.At[n := dimension] \as Native;
\structure Data: \Set := {
  projection: Cylinder.Carrier -> Native.Projection,
  regular: Native.Families[X := Cylinder.Carrier].Matrix[m := dimension].Regular (Cylinder.topology baseSpace) (\fun (z: Cylinder.Carrier) => (projection z).map),
};
\definition Start[data: Data]: \Prop := \forall (x: X) -> (data.projection (Cylinder.at I.start x)).map = (Pad.leftProjection (p.projection x)).map;
\definition End[data: Data]: \Prop := \forall (x: X) -> (data.projection (Cylinder.at I.end x)).map = (Pad.rightProjection (q.projection x)).map;
\structure Witness: \Set := { data: Data, start: Start data, end: End data };
\definition Homotopic: \Prop := \exists Witness;
\module With(w: Witness);
\module FromIsomorphism(iso: Isomorphism p q);
