\import Homotopy.Projections[n := dimension].Homotopy[X := X, baseSpace := baseSpace, compact := compact, P := w.data.projection, regular := w.data.regular,
  A := topology.Topology[Carrier := X].Empty, stationary := stationary] \as Motion;
\import Motion.Slice[t := I.start] \as StartSlice;
\import Motion.Slice[t := I.end] \as EndSlice;
\module Left;
\module Right;
\definition isomorphismExists: \exists Isomorphism p q := \block {
  \takefrom iso: Motion.Isomorphism I.start I.end \by Motion.endpointIsomorphismExists \then
  \let first: Bundles.Isomorphisms[X := X, F := Fiber p, G := StartSlice.Fiber, source := bundle p, target := StartSlice.bundle].Isomorphism := Left[].isomorphism \then
  \let second: Bundles.Isomorphisms[X := X, F := Fiber q, G := EndSlice.Fiber, source := bundle q, target := EndSlice.bundle].Isomorphism := Right[].isomorphism \then
  \let comparison: Bundles.Isomorphisms[X := X, F := Fiber p, G := EndSlice.Fiber, source := bundle p, target := EndSlice.bundle].Isomorphism :=
    Operations.IsomorphismComposition[X := X, F := Fiber p, G := StartSlice.Fiber, H := EndSlice.Fiber, source := bundle p, middle := StartSlice.bundle, target := EndSlice.bundle].compose first iso \then
  \return \exact(Operations.IsomorphismComposition[X := X, F := Fiber p, G := EndSlice.Fiber, H := Fiber q, source := bundle p, middle := EndSlice.bundle, target := bundle q].compose comparison
    (Bundles.Isomorphisms[X := X, F := Fiber q, G := EndSlice.Fiber, source := bundle q, target := EndSlice.bundle].inverse second), Isomorphism p q)
};
