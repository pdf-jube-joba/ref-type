\definition B[x: X]: Spaces.Linear[V := Vector dimension, W := Vector m, source := coordinates dimension, target := coordinates m].Map := Pad.second;
\definition BRegular: Hermitian.At[n := m].Families[X := X].Matrix[m := dimension].Regular baseSpace B := Hermitian.At[n := m].Families[X := X].Matrix[m := dimension].constant baseSpace Pad.second;
\definition left: \forall (x: X)(v: Vector m) -> (B x).apply ((Padding.B x).apply v) = (q.projection x).map.apply v :=
  \fun (x: X)(v: Vector m) => Pad.secondRight ((q.projection x).map.apply v);
\definition right: \forall (x: X)(v: Vector dimension) -> (Padding.B x).apply ((B x).apply v) = (EndSlice.projection x).map.apply v :=
  \fun (x: X)(v: Vector dimension) => congr!{{Native.Map} {Vector dimension}} (\fun (f: Native.Map) => f.apply v) _ _ (sym!{Native.Map} _ _ (w.end x));
\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ImageMaps[X := X, baseSpace := baseSpace, n := m, m := dimension,
  P := q.projection, Q := EndSlice.projection, regularP := q.regular, regularQ := EndSlice.regular].Compare[A := Padding.B, B := B, regularA := Padding.BRegular, regularB := BRegular, left := left, right := right] \as Comparison;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Fiber q, G := EndSlice.Fiber, source := bundle q, target := EndSlice.bundle].Isomorphism := Comparison.isomorphism;
