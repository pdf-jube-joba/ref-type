\import Pad.Families[X := X, baseSpace := baseSpace, P := p.projection, Q := q.projection, regularP := p.regular, regularQ := q.regular] \as Padding;
\definition stationary: \forall (x: X) -> \In[X] (topology.Topology[Carrier := X].Empty) x -> \forall (s, t: I.Carrier) -> (w.data.projection (Cylinder.at s x)).map = (w.data.projection (Cylinder.at t x)).map :=
  \fun (x: X)(empty: Logic.False)(s, t: I.Carrier) => Logic.falseElim _ empty;
\module Compact(compact: topology.Topology[Carrier := X].IsCompact baseSpace);
