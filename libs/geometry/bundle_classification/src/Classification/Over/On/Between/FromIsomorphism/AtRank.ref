\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ProjectionFrames[X := X, baseSpace := baseSpace, n := n, k := k, P := p.projection, regular := p.regular] \as Frames;
\definition pulledFrames: \forall (z: Cylinder.Carrier) -> \exists Bundles.Family[X := Cylinder.Carrier, F := (\fun (z: Cylinder.Carrier) => Fiber p (Cylinder.point z))].Of[bundle := Interpolation.pulledBundle].Frame k z :=
  \fun (z: Cylinder.Carrier) => Frames.frames rank (Cylinder.point z);
\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].For[X := Cylinder.Carrier, F := (\fun (z: Cylinder.Carrier) => Fiber p (Cylinder.point z)), bundle := Interpolation.pulledBundle].AtRank[k := k].WithEmbedding[embedding := Interpolation.embedding] \as Ranked;
\definition hasRank: \forall (z: Cylinder.Carrier) -> Native.OnProjection[P := witness.data.projection z].Rank[k := k].HasRank := Ranked.rank pulledFrames;
