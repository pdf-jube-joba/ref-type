\definition B[x: X]: Spaces.Linear[V := Vector dimension, W := Vector n, source := coordinates dimension, target := coordinates n].Map := Pad.first;
\definition BRegular: Hermitian.At[n := n].Families[X := X].Matrix[m := dimension].Regular baseSpace B := Hermitian.At[n := n].Families[X := X].Matrix[m := dimension].constant baseSpace Pad.first;
\definition left: \forall (x: X)(v: Vector n) -> (B x).apply ((Padding.A x).apply v) = (p.projection x).map.apply v :=
  \fun (x: X)(v: Vector n) => Pad.firstLeft ((p.projection x).map.apply v);
\definition right: \forall (x: X)(v: Vector dimension) -> (Padding.A x).apply ((B x).apply v) = (StartSlice.projection x).map.apply v :=
  \fun (x: X)(v: Vector dimension) => congr!{{Native.Map} {Vector dimension}} (\fun (f: Native.Map) => f.apply v) _ _ (sym!{Native.Map} _ _ (w.start x));
\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ImageMaps[X := X, baseSpace := baseSpace, n := n, m := dimension,
  P := p.projection, Q := StartSlice.projection, regularP := p.regular, regularQ := StartSlice.regular].Compare[A := Padding.A, B := B, regularA := Padding.ARegular, regularB := BRegular, left := left, right := right] \as Comparison;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Fiber p, G := StartSlice.Fiber, source := bundle p, target := StartSlice.bundle].Isomorphism := Comparison.isomorphism;
