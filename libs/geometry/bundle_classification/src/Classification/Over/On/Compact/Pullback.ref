\import Representations.Pullback[Y := Y, source := source, f := f, regularBase := continuous] \as Native;
\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].On[X := Y, baseSpace := source] \as Target;
\import Target.Compact[compact := sourceCompact] \as TargetClasses;
\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].On[X := X, baseSpace := baseSpace].Compact[compact := compact] \as SourceClasses;
\definition map[C: Classes]: TargetClasses.Classes := TargetClasses.fromBundles (Native.map (toBundles C));
\definition naturality: \forall (C: Classes) -> TargetClasses.toBundles (map C) = Native.map (toBundles C) :=
  \fun (C: Classes) => TargetClasses.rightInverse (Native.map (toBundles C));
\definition onClass: \forall (p: Presentation) -> map (class p) = TargetClasses.class (Native.presentation p) :=
  \fun (p: Presentation) => trans!{TargetClasses.Classes} _ _ _
    (congr!{Representations.Classes TargetClasses.Classes} (\fun (C: Representations.Classes) => TargetClasses.fromBundles (Native.map C)) _ _ (SourceClasses.onClass p))
    (trans!{TargetClasses.Classes} _ _ _
      (congr!{Complements.Representations[X := Y, baseSpace := source].Classes TargetClasses.Classes} TargetClasses.fromBundles _ _ (Native.onClass p))
      (TargetClasses.fromOnClass (Native.presentation p)));
\definition preserves: \forall (p, q: Presentation) -> Homotopic p q -> Target.Homotopic (Native.presentation p) (Native.presentation q) :=
  \fun (p, q: Presentation)(related: _) => Target.isomorphicHomotopic (Native.presentation p) (Native.presentation q) (Native.respects p q (homotopicIsomorphic p q related));
