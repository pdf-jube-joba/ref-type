\definition same: left.baseSpace = right.baseSpace := trans!{{topology.Topology[Carrier := X].Topology}} _ _ _ leftSame (sym!{{topology.Topology[Carrier := X].Topology}} _ _ rightSame);
\import Operations.DirectSum[X := X, F := F, G := G, left := left, right := right] \as Sum;
\definition sumBundle: Bundles.Family[X := X, F := Sum.Fiber].Bundle := Sum.bundle same;
\import Representations.Of[F := F, original := left, same := leftSame] \as First;
\import Representations.Of[F := G, original := right, same := rightSame] \as Second;
\import Representations.Of[F := Sum.Fiber, original := sumBundle, same := leftSame] \as Result;
\definition compactLeft: topology.Topology[Carrier := X].IsCompact left.baseSpace := \idelim baseSpace = left.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Topology[Carrier := X].IsCompact t \by { base: compact, equality: sym!{{topology.Topology[Carrier := X].Topology}} _ _ leftSame };
\definition t2Left: topology.Topology[Carrier := X].IsT2 left.baseSpace := \idelim baseSpace = left.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Topology[Carrier := X].IsT2 t \by { base: hausdorff, equality: sym!{{topology.Topology[Carrier := X].Topology}} _ _ leftSame };
\definition compactRight: topology.Topology[Carrier := X].IsCompact right.baseSpace := \idelim baseSpace = right.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Topology[Carrier := X].IsCompact t \by { base: compact, equality: sym!{{topology.Topology[Carrier := X].Topology}} _ _ rightSame };
\definition t2Right: topology.Topology[Carrier := X].IsT2 right.baseSpace := \idelim baseSpace = right.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Topology[Carrier := X].IsT2 t \by { base: hausdorff, equality: sym!{{topology.Topology[Carrier := X].Topology}} _ _ rightSame };
\definition firstClass: Classes := fromBundles (First.class compactLeft t2Left);
\definition secondClass: Classes := fromBundles (Second.class compactRight t2Right);
\definition value: Classes := fromBundles (Result.class compactLeft t2Left);
\module WithRepresentatives(p, q: Presentation, first: First.Isomorphism p, second: Second.Isomorphism q);
\definition naturality: \parent.Addition[].add firstClass secondClass = value := \block {
  \takefrom a: Complements.For[X := X, F := F, bundle := left].Embedding \by Complements.For[X := X, F := F, bundle := left].embeddingExists compactLeft t2Left \then
  \takefrom b: Complements.For[X := X, F := G, bundle := right].Embedding \by Complements.For[X := X, F := G, bundle := right].embeddingExists compactRight t2Right \then
  \return WithRepresentatives[p := First.FromEmbedding[embedding := a].presentation, q := Second.FromEmbedding[embedding := b].presentation,
    first := First.FromEmbedding[embedding := a].isomorphism, second := Second.FromEmbedding[embedding := b].isomorphism].equation
};
