\import Quotient.Binary[C := Presentation, B := Classes, OtherEquivalent := Homotopic] \as Descend;
\definition onRepresentatives[p, q: Presentation]: Classes := \parent.Add[p := p, q := q].value;
\definition respects: Descend.Respects onRepresentatives := \fun (p, r, q, s: Presentation)(first: Homotopic p r)(second: Homotopic q s) => \block {
  \takefrom a: Isomorphism p r \by homotopicIsomorphic p r first \then
  \takefrom b: Isomorphism q s \by homotopicIsomorphic q s second \then
  \return \parent.Add[p := p, q := q].Comparing[r := r, s := s, first := a, second := b].equality
};
\definition add: Classes -> Classes -> Classes := Descend.value equivalence equivalence onRepresentatives respects;
\definition onClasses: \forall (p, q: Presentation) -> add (class p) (class q) = onRepresentatives p q := Descend.onClass equivalence equivalence onRepresentatives respects;
