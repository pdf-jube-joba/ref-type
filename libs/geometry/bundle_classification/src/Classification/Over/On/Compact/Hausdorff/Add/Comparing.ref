\import \parent.\parent.Add[p := r, q := s] \as Other;
\import Operations.DirectSumIsomorphisms[X := X, F := Fiber p, G := Fiber q, A := Fiber r, B := Fiber s,
  first := bundle p, second := bundle q, newFirst := bundle r, newSecond := bundle s, sameSource := \refl(baseSpace), sameTarget := \refl(baseSpace)] \as Sums;
\import Representations.Comparison[F := Sum.Fiber, G := Sums.TargetFiber, first := sumBundle, second := Other.sumBundle, firstSame := \refl(baseSpace), secondSame := \refl(baseSpace)] \as Comparison;
\definition equality: value = Other.value := congr!{Representations.Classes Classes} fromBundles _ _ (Comparison.isomorphicEqual compact hausdorff compact hausdorff (Sums.isomorphism first second));
