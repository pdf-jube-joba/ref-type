\import \parent.\parent.Add[p := p, q := q] \as Added;
\import \parent.\parent.Addition[] \as Addition;
\definition firstEquality: firstClass = class p := trans!{Classes} _ _ _
  (congr!{Representations.Classes Classes} fromBundles _ _ ((First.classification compactLeft t2Left p).rtl (\exact(first, First.Isomorphism p)))) (fromOnClass p);
\definition secondEquality: secondClass = class q := trans!{Classes} _ _ _
  (congr!{Representations.Classes Classes} fromBundles _ _ ((Second.classification compactRight t2Right q).rtl (\exact(second, Second.Isomorphism q)))) (fromOnClass q);
\import Operations.DirectSumIsomorphisms[X := X, F := F, G := G, A := Fiber p, B := Fiber q,
  first := left, second := right, newFirst := bundle p, newSecond := bundle q, sameSource := same, sameTarget := \refl(baseSpace)] \as Sums;
\import Representations.Comparison[F := Sum.Fiber, G := Sums.TargetFiber, first := sumBundle, second := Added.sumBundle, firstSame := leftSame, secondSame := \refl(baseSpace)] \as Comparison;
\definition resultEquality: value = Added.value := congr!{Representations.Classes Classes} fromBundles _ _ (Comparison.isomorphicEqual compactLeft t2Left compact hausdorff (Sums.isomorphism first second));
\definition equation: Addition.add firstClass secondClass = value := trans!{Classes} _ _ _ (congr!{Classes Classes Classes} Addition.add _ _ _ _ firstEquality secondEquality)
  (trans!{Classes} _ _ _ (Addition.onClasses p q) (sym!{Classes} _ _ resultEquality));
