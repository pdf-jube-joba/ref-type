\import Operations.DirectSum[X := X, F := Fiber p, G := Fiber q, left := bundle p, right := bundle q] \as Sum;
\definition sumBundle: Bundles.Family[X := X, F := Sum.Fiber].Bundle := Sum.bundle (\refl(baseSpace));
\import Representations.Of[F := Sum.Fiber, original := sumBundle, same := \refl(baseSpace)] \as BundleClass;
\definition value: Classes := fromBundles (BundleClass.class compact hausdorff);
\module Comparing(r, s: Presentation, first: Isomorphism p r, second: Isomorphism q s);
