\import Bundles.Trivial[X := X, n := n, baseSpace := baseSpace] \as Standard;
\import \parent.\parent.Sum[F := F, G := (\fun (_: X) => Vector n), left := bundle, right := Standard.bundle, leftSame := same, rightSame := \refl(baseSpace)] \as Sum;
\definition naturality: map Sum.firstClass = Sum.value := Sum.naturality;
