\import Representations.Of[F := F, original := original, same := same] \as Original;
\definition class[compactOriginal: topology.Topology[Carrier := X].IsCompact original.baseSpace][hausdorff: topology.Topology[Carrier := X].IsT2 original.baseSpace]: Classes := fromBundles (Original.class compactOriginal hausdorff);
\definition classification: \forall (compactOriginal: topology.Topology[Carrier := X].IsCompact original.baseSpace)(hausdorff: topology.Topology[Carrier := X].IsT2 original.baseSpace)(p: Presentation) ->
  Logic.PropEquiv[class compactOriginal hausdorff = Quotient.class p, Original.Represents p] :=
    \fun (compactOriginal: _)(hausdorff: _)(p: Presentation) => Logic.PropEquiv[class compactOriginal hausdorff = Quotient.class p, Original.Represents p] {
      ltr := \fun (equal: _) => (Original.classification compactOriginal hausdorff p).ltr
        (trans!{Representations.Classes} _ _ _ (congr!{Classes Representations.Classes} toBundles _ _ equal) (onClass p)),
      rtl := \fun (represented: _) => trans!{Classes} _ _ _
        (congr!{Representations.Classes Classes} fromBundles _ _ ((Original.classification compactOriginal hausdorff p).rtl represented))
        (fromOnClass p)
    };
