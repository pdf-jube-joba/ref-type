\definition map: X -> Carrier := P;
\definition continuous: topology.Continuity[A := X, B := Carrier].Continuous source topology map :=
  Induced.Universal[Z := X].continuous source (Matrix.topology scalar.topological.space) entries map
    (Matrix.Universal[A := X].continuous source scalar.topological.space (\fun (x: X) => entries (P x))
      (\fun (i, j: Fin.Fin n) => regularP (Geometry.Finite[n := n].basis j) i));
\import Universal.Pullback[Y := X, source := source, f := map, regularBase := continuous] \as Pulled;
\import Complements.Projection[X := X, n := n, baseSpace := source, P := P, regular := regularP] \as Image;
\import Bundles.Family[X := Carrier, F := Fiber].Of[bundle := bundle].Pullback[Y := X, source := source, f := map] \as OriginalPull;
\definition pulled: Bundles.Family[X := X, F := (\fun (x: X) => Fiber (map x))].Bundle := OriginalPull.pulled continuous;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := (\fun (x: X) => Fiber (map x)), G := Image.Fiber, source := pulled, target := Image.bundle].Isomorphism := Pulled.isomorphism;
