\import topological_algebra.Coordinates[K := K, I := Fin.Fin n] \as Coordinates;
\definition Continuous[v: Y -> Vector n]: \Prop := topology.Continuity[A := Y, B := Vector n].Continuous source (coordinateTopology n) v;
\definition component: \forall (v: Y -> Vector n) -> Continuous v -> \forall (i: Fin.Fin n) -> topology.Continuity[A := Y, B := K].Continuous source scalar.topological.space (\fun (y: Y) => v y i) :=
  \fun (v: _)(continuous: _)(i: Fin.Fin n) => topology.Composition[A := Y, B := Vector n, C := K].composeContinuous source (coordinateTopology n) scalar.topological.space v (\fun (w: Vector n) => w i) continuous (Coordinates.evaluationContinuous scalar.topological.space i);
\definition scale: \forall (a: Y -> K)(v: Y -> Vector n) -> topology.Continuity[A := Y, B := K].Continuous source scalar.topological.space a -> Continuous v -> Continuous (\fun (y: Y) => (coordinates n).smul (a y) (v y)) :=
  \fun (a: _)(v: _)(aContinuous: _)(vContinuous: _) => Coordinates.Universal[A := Y].continuous source scalar.topological.space (\fun (y: Y) => (coordinates n).smul (a y) (v y))
    (\fun (i: Fin.Fin n) => topological_algebra.Topology[K := K].Functions[A := Y].multiplicationContinuous source scalar.topological.space
      (Fields.fieldAsCommutativeRing K field) scalar.topological.ring a (\fun (y: Y) => v y i) aContinuous (component v vContinuous i));
