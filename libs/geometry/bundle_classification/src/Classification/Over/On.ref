\import Complements.Representations[X := X, baseSpace := baseSpace] \as Representations;
\definition Presentation: \Set := Representations.Presentation;
\definition Fiber[p: Presentation][x: X]: \Set := Representations.Fiber p x;
\definition bundle[p: Presentation]: Bundles.Family[X := X, F := Fiber p].Bundle := Representations.bundle p;
\definition Isomorphism[p, q: Presentation]: \Set := Representations.Isomorphism p q;
\definition Equivalent[p, q: Presentation]: \Prop := Representations.Equivalent p q;
\module Between(p, q: Presentation);
\definition Homotopic[p, q: Presentation]: \Prop := Between[p := p, q := q].Homotopic;
\definition isomorphicHomotopic: \forall (p, q: Presentation) -> Equivalent p q -> Homotopic p q :=
  \fun (p, q: Presentation)(exists: _) => \block {
    \takefrom iso: Isomorphism p q \by exists \then
    \return Between[p := p, q := q].FromIsomorphism[iso := iso].homotopic
  };
\module Compact(compact: topology.Topology[Carrier := X].IsCompact baseSpace);
