\definition preserves: Preserves A := \fun (x: X)(v: Vector n)(fixed: _) => trans!{{Vector m}} _ _ _
  (sym!{{Vector m}} _ _ (right x ((A x).apply v)))
  (trans!{{Vector m}} _ _ _ (congr!{{Vector n} {Vector m}} (A x).apply _ _ (left x v)) (congr!{{Vector n} {Vector m}} (A x).apply _ _ fixed));
\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ImageMaps[X := X, baseSpace := baseSpace, n := m, m := n, P := Q, Q := P, regularP := regularQ, regularQ := regularP] \as Reverse;
\definition preservesReverse: Reverse.Preserves B := \fun (x: X)(v: Vector m)(fixed: _) => trans!{{Vector n}} _ _ _
  (sym!{{Vector n}} _ _ (left x ((B x).apply v)))
  (trans!{{Vector n}} _ _ _ (congr!{{Vector m} {Vector n}} (B x).apply _ _ (right x v)) (congr!{{Vector m} {Vector n}} (B x).apply _ _ fixed));
\import \parent.From[A := A, regular := regularA, preserves := preserves] \as Forward;
\import Reverse.From[A := B, regular := regularB, preserves := preservesReverse] \as Backward;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Source.Fiber, G := Target.Fiber, source := Source.bundle, target := Target.bundle].Isomorphism :=
  Bundles.Isomorphisms[X := X, F := Source.Fiber, G := Target.Fiber, source := Source.bundle, target := Target.bundle].Isomorphism {
    forward := Forward.map, backward := Backward.map,
    leftInverse := \fun (x: X)(v: Source.Fiber x) => trans!{{Vector n}} _ _ _ (left x v) (\bysub(Vector n, Source.Image x, v)),
    rightInverse := \fun (x: X)(v: Target.Fiber x) => trans!{{Vector m}} _ _ _ (right x v) (\bysub(Vector m, Target.Image x, v))
  };
