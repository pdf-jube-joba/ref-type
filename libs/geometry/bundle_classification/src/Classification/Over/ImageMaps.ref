\import Complements.Projection[X := X, n := n, baseSpace := baseSpace, P := P, regular := regularP] \as Source;
\import Complements.Projection[X := X, n := m, baseSpace := baseSpace, P := Q, regular := regularQ] \as Target;
\import Spaces.Linear[V := Vector n, W := Vector m, source := coordinates n, target := coordinates m] \as Linear;
\definition Family: \Set := X -> Linear.Map;
\definition Regular[A: Family]: \Prop := Hermitian.At[n := m].Families[X := X].Matrix[m := n].Regular baseSpace A;
\definition Preserves[A: Family]: \Prop := \forall (x: X)(v: Vector n) -> (P x).map.apply v = v -> (Q x).map.apply ((A x).apply v) = (A x).apply v;
\import Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := Target.Fiber, source := Source.bundle, target := Target.bundle, f := (\fun (x: X) => x)] \as Maps;
\module From(A: Family, regular: Regular A, preserves: Preserves A);
\definition ReverseFamily: \Set := X -> Spaces.Linear[V := Vector m, W := Vector n, source := coordinates m, target := coordinates n].Map;
\module Compare(A: Family, B: ReverseFamily, regularA: Regular A,
  regularB: Hermitian.At[n := n].Families[X := X].Matrix[m := m].Regular baseSpace B,
  left: \forall (x: X)(v: Vector n) -> (B x).apply ((A x).apply v) = (P x).map.apply v,
  right: \forall (x: X)(v: Vector m) -> (A x).apply ((B x).apply v) = (Q x).map.apply v);
