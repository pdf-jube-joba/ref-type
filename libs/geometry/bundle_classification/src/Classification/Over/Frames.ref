\import Spaces.Linear[V := Vector k, W := Vector n, source := coordinates k, target := coordinates n] \as Linear;
\definition Injective[A: Linear.Map]: \Prop := \forall (v, w: Vector k) -> A.apply v = A.apply w -> v = w;
\definition Carrier: \Set := \Cast[Linear.Map] ({ A: Linear.Map \where Injective A });
\import topological_algebra.Matrix[K := K, I := Fin.Fin n, J := Fin.Fin k] \as Matrix;
\definition entries[A: Carrier]: Matrix.Carrier := \fun (i: Fin.Fin n)(j: Fin.Fin k) => A.apply (Geometry.Finite[n := k].basis j) i;
\import topological_constructions.Induced[A := Carrier, B := Matrix.Carrier] \as Induced;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Induced.topology (Matrix.topology scalar.topological.space) entries;
\module Family(X: \Set, source: topology.Topology[Carrier := X].Topology, A: X -> Linear.Map,
  regular: Hermitian.At[n := n].Families[X := X].Matrix[m := k].Regular source A,
  injective: \forall (x: X) -> Injective (A x));
