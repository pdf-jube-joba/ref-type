\definition map[x: X]: Carrier := \into[Linear.Map](A x, Carrier) \by { injective x };
\definition continuous: topology.Continuity[A := X, B := Carrier].Continuous source topology map :=
  Induced.Universal[Z := X].continuous source (Matrix.topology scalar.topological.space) entries map
    (Matrix.Universal[A := X].continuous source scalar.topological.space (\fun (x: X) => entries (map x))
      (\fun (i: Fin.Fin n)(j: Fin.Fin k) => regular (Geometry.Finite[n := k].basis j) i));
\import Complements.CoordinateEmbedding[X := X, m := k, n := n, baseSpace := source, A := A, regular := regular, injective := injective] \as Embedded;
\import Complements.For[X := X, F := (\fun (_: X) => Vector k), bundle := Bundles.Trivial[X := X, n := k, baseSpace := source].bundle].FromEmbedding[embedding := Embedded.embedding].Image[] \as Image;
\definition Fiber[x: X]: \Set := Image.ImageFiber x;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Image.imageBundle;
\definition framing: Bundles.Isomorphisms[X := X, F := (\fun (_: X) => Vector k), G := Fiber, source := Bundles.Trivial[X := X, n := k, baseSpace := source].bundle, target := bundle].Isomorphism := Image.isomorphism;
