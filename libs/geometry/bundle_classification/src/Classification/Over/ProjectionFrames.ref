\import Complements.Projection[X := X, n := n, baseSpace := baseSpace, P := P, regular := regular] \as Image;
\import Bundles.Family[X := X, F := Image.Fiber].Of[bundle := Image.bundle] \as Family;
\module At(x: X, basis: Hermitian.At[n := n].OnProjection[P := P x].Rank[k := k].Basis);
\definition frames: (\forall (x: X) -> Hermitian.At[n := n].OnProjection[P := P x].Rank[k := k].HasRank) -> \forall (x: X) -> \exists Family.Frame k x :=
  \fun (rank: _)(x: X) => \block {
    \takefrom basis: Hermitian.At[n := n].OnProjection[P := P x].Rank[k := k].Basis \by rank x \then
    \return \exact(At[x := x, basis := basis].frame, Family.Frame k x)
  };
