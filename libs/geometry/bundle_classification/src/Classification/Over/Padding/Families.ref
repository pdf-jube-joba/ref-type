\import Spaces.Linear[V := Vector n, W := Vector dimension, source := coordinates n, target := coordinates dimension].Composition[U := Vector n, domain := coordinates n] \as LeftCompose;
\import Spaces.Linear[V := Vector m, W := Vector dimension, source := coordinates m, target := coordinates dimension].Composition[U := Vector m, domain := coordinates m] \as RightCompose;
\definition A[x: X]: Spaces.Linear[V := Vector n, W := Vector dimension, source := coordinates n, target := coordinates dimension].Map := LeftCompose.compose left (P x).map;
\definition B[x: X]: Spaces.Linear[V := Vector m, W := Vector dimension, source := coordinates m, target := coordinates dimension].Map := RightCompose.compose right (Q x).map;
\import topological_algebra.Coordinates[K := K, I := Fin.Fin n] \as LeftCoordinates;
\import topological_algebra.Coordinates[K := K, I := Fin.Fin m] \as RightCoordinates;
\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].VectorFunctions[n := dimension, Y := X, source := baseSpace] \as Vectors;
\definition AVector: \forall (v: Vector n) -> Vectors.Continuous (\fun (x: X) => (A x).apply v) :=
  \fun (v: Vector n) => topology.Composition[A := X, B := Vector n, C := Vector dimension].composeContinuous baseSpace (coordinateTopology n) (coordinateTopology dimension)
    (\fun (x: X) => (P x).map.apply v) left.apply (LeftCoordinates.Universal[A := X].continuous baseSpace scalar.topological.space (\fun (x: X) => (P x).map.apply v) (regularP v)) leftContinuous;
\definition BVector: \forall (v: Vector m) -> Vectors.Continuous (\fun (x: X) => (B x).apply v) :=
  \fun (v: Vector m) => topology.Composition[A := X, B := Vector m, C := Vector dimension].composeContinuous baseSpace (coordinateTopology m) (coordinateTopology dimension)
    (\fun (x: X) => (Q x).map.apply v) right.apply (RightCoordinates.Universal[A := X].continuous baseSpace scalar.topological.space (\fun (x: X) => (Q x).map.apply v) (regularQ v)) rightContinuous;
\definition ARegular: TotalAt.Families[X := X].Matrix[m := n].Regular baseSpace A := \fun (v: Vector n) => Vectors.component _ (AVector v);
\definition BRegular: TotalAt.Families[X := X].Matrix[m := m].Regular baseSpace B := \fun (v: Vector m) => Vectors.component _ (BVector v);
\definition leftRegular: TotalAt.Families[X := X].Matrix[m := dimension].Regular baseSpace (\fun (x: X) => (leftProjection (P x)).map) := \fun (v: Vector dimension) => ARegular (first.apply v);
\definition rightRegular: TotalAt.Families[X := X].Matrix[m := dimension].Regular baseSpace (\fun (x: X) => (rightProjection (Q x)).map) := \fun (v: Vector dimension) => BRegular (second.apply v);
