\definition n: N.Nat^ := classifier.presentation.dimension;
\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ProjectionSpace[n := n] \as Space;
\import Space.Family[X := X, source := bundle.baseSpace, P := classifier.presentation.projection, regularP := classifier.presentation.regular] \as Family;
\definition map: X -> Space.Carrier := Family.map;
\definition continuous: topology.Continuity[A := X, B := Space.Carrier].Continuous bundle.baseSpace Space.topology map := Family.continuous;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := F, G := (\fun (x: X) => Space.Fiber (map x)), source := bundle, target := Family.pulled].Isomorphism :=
  Operations.IsomorphismComposition[X := X, F := F, G := Representations.Fiber classifier.presentation, H := (\fun (x: X) => Space.Fiber (map x)), source := bundle,
    middle := Representations.bundle classifier.presentation, target := Family.pulled].compose classifier.isomorphism
      (Bundles.Isomorphisms[X := X, F := (\fun (x: X) => Space.Fiber (map x)), G := Representations.Fiber classifier.presentation, source := Family.pulled, target := Representations.bundle classifier.presentation].inverse Family.isomorphism);
