\import Complements.Representations[X := X, baseSpace := bundle.baseSpace] \as Representations;
\import Representations.Representing[F := F, original := bundle] \as Data;
\import Representations.Of[F := F, original := bundle, same := \refl(bundle.baseSpace)] \as Construction;
\definition Classifier: \Set := Data.Representative;
\definition exists: topology.Topology[Carrier := X].IsCompact bundle.baseSpace -> topology.Topology[Carrier := X].IsT2 bundle.baseSpace -> \exists Classifier :=
  \fun (compact: _)(hausdorff: _) => \block {
    \takefrom e: Original.Embedding \by Original.embeddingExists compact hausdorff \then
    \return \exact(Construction.FromEmbedding[embedding := e].representative, Classifier)
  };
\module From(classifier: Classifier);
