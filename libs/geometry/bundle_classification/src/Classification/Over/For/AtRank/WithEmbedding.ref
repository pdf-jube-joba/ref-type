\import Original.FromEmbedding[embedding := embedding].Image[] \as Image;
\definition n: N.Nat^ := embedding.dimension;
\import Hermitian.At[n := n] \as Native;
\module At(x: X, frame: Family.Frame k x);
\definition rank: HasRank -> \forall (x: X) -> Native.OnProjection[P := Image.projection x].Rank[k := k].HasRank :=
  \fun (hasRank: HasRank)(x: X) => \block {
    \takefrom frame: Family.Frame k x \by hasRank x \then
    \return \exact(At[x := x, frame := frame].basis, Native.OnProjection[P := Image.projection x].Rank[k := k].Basis)
  };
\definition projection: X -> Native.Projection := Image.projection;
\definition regular: Native.Families[X := X].Matrix[m := n].Regular bundle.baseSpace (\fun (x: X) => (projection x).map) := Image.regular;
\definition comparison: Bundles.Isomorphisms[X := X, F := F, G := Image.ImageFiber, source := bundle, target := Image.imageBundle].Isomorphism := Image.isomorphism;
