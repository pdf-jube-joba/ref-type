\import \parent.Addition[l := n] \as Addition;
\definition map[C: Classes]: Addition.ResultClasses := Addition.add C (Addition.rightClass Addition.rightStandard);
\definition onClass: \forall (p: Presentation) -> map (class p) = Addition.onRepresentatives p Addition.rightStandard :=
  \fun (p: Presentation) => Addition.onClasses p Addition.rightStandard;
\module For(F: X -> \Set, bundle: Bundles.Family[X := X, F := F].Bundle, same: bundle.baseSpace = baseSpace,
  framing: Bundles.Isomorphisms[X := X, F := (\fun (_: X) => Vector k), G := F, source := Bundles.Trivial[X := X, n := k, baseSpace := baseSpace].bundle, target := bundle].Isomorphism);
