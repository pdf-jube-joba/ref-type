\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Framed[X := X, baseSpace := baseSpace, k := l] \as Right;
\import Fin.Sum[m := k, n := l] \as Rank;
\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Framed[X := X, baseSpace := baseSpace, k := Rank.total] \as Target;
\import Quotient.Binary[C := Right.Presentation, B := Target.Classes, OtherEquivalent := Right.Homotopic] \as Descend;
\definition onRepresentatives[p: Presentation][q: Right.Presentation]: Target.Classes :=
  Target.class (\root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].FrameSum[X := X, baseSpace := baseSpace, k := k, l := l, p := p, q := q].presentation);
\definition respects: Descend.Respects onRepresentatives :=
  \fun (p, r: Presentation)(q, s: Right.Presentation)(_: Homotopic p r)(_: Right.Homotopic q s) => Target.uniqueClass _ _;
\definition add: Classes -> Right.Classes -> Target.Classes := Descend.value equivalence Right.equivalence onRepresentatives respects;
\definition onClasses: \forall (p: Presentation)(q: Right.Presentation) -> add (class p) (Right.class q) = onRepresentatives p q :=
  Descend.onClass equivalence Right.equivalence onRepresentatives respects;
\definition ResultClasses: \Set := Target.Classes;
\definition resultClass[p: Target.Presentation]: ResultClasses := Target.class p;
\definition rightStandard: Right.Presentation := Right.standard;
\definition rightClass[p: Right.Presentation]: Right.Classes := Right.class p;
\module For(F, G: X -> \Set, left: Bundles.Family[X := X, F := F].Bundle, right: Bundles.Family[X := X, F := G].Bundle,
  leftSame: left.baseSpace = baseSpace, rightSame: right.baseSpace = baseSpace,
  leftFrame: Bundles.Isomorphisms[X := X, F := (\fun (_: X) => Vector k), G := F, source := Bundles.Trivial[X := X, n := k, baseSpace := baseSpace].bundle, target := left].Isomorphism,
  rightFrame: Bundles.Isomorphisms[X := X, F := (\fun (_: X) => Vector l), G := G, source := Bundles.Trivial[X := X, n := l, baseSpace := baseSpace].bundle, target := right].Isomorphism);
