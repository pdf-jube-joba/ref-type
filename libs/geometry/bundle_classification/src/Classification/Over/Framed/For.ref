\import Complements.For[X := X, F := F, bundle := bundle] \as Original;
\definition Embedding: \Set := Original.Embedding;
\definition originalFraming: Bundles.Isomorphisms[X := X, F := (\fun (_: X) => Vector k), G := F, source := Bundles.Trivial[X := X, n := k, baseSpace := bundle.baseSpace].bundle, target := bundle].Isomorphism :=
  \idelim baseSpace = bundle.baseSpace \with t: topology.Topology[Carrier := X].Topology =>
    Bundles.Isomorphisms[X := X, F := (\fun (_: X) => Vector k), G := F, source := Bundles.Trivial[X := X, n := k, baseSpace := t].bundle, target := bundle].Isomorphism \by { base: framing, equality: sym!{{topology.Topology[Carrier := X].Topology}} _ _ same };
\module FromEmbedding(embedding: Original.Embedding);
\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Framed[X := X, baseSpace := baseSpace, k := k] \as Classifying;
\definition class: Classifying.Classes := Classifying.class Classifying.standard;
\definition classification: \forall (embedding: Original.Embedding) -> Classifying.class (FromEmbedding[embedding := embedding].presentation) = class :=
  \fun (embedding: Original.Embedding) => Classifying.uniqueClass _ _;
\definition independent: \forall (first, second: Original.Embedding) ->
  Classifying.class (FromEmbedding[embedding := first].presentation) = Classifying.class (FromEmbedding[embedding := second].presentation) :=
  \fun (first, second: Original.Embedding) => trans!{Classifying.Classes} _ _ _ (classification first) (sym!{Classifying.Classes} _ _ (classification second));
\definition presentation[embedding: Original.Embedding]: Presentation := FromEmbedding[embedding := embedding].presentation;
\module Pullback(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  continuous: topology.Continuity[A := Y, B := X].Continuous source baseSpace f);
\definition exists: topology.Topology[Carrier := X].IsCompact bundle.baseSpace -> topology.Topology[Carrier := X].IsT2 bundle.baseSpace -> \exists Presentation :=
  \fun (compact: _)(hausdorff: _) => \block {
    \takefrom e: Original.Embedding \by Original.embeddingExists compact hausdorff \then
    \return \exact(FromEmbedding[embedding := e].presentation, Presentation)
  };
