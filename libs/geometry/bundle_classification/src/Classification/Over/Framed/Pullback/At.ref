\definition regular: Hermitian.At[n := p.data.dimension].Families[X := Y].Matrix[m := k].Regular source (\fun (y: Y) => p.data.frame (f y)) :=
  \fun (v: Vector k)(i: Fin.Fin p.data.dimension) => topology.Composition[A := Y, B := X, C := K].composeContinuous source baseSpace scalar.topological.space f
    (\fun (x: X) => (p.data.frame x).apply v i) continuous (p.regular v i);
\definition presentation: Target.Presentation := Target.Presentation { data := Target.Data { dimension := p.data.dimension, frame := (\fun (y: Y) => p.data.frame (f y)) }, regular := regular, injective := \fun (y: Y) => p.injective (f y) };
\definition formula: \forall (y: Y)(v: Vector k) -> (presentation.data.frame y).apply v = (p.data.frame (f y)).apply v := \fun (y: Y)(v: Vector k) => \refl((p.data.frame (f y)).apply v);
