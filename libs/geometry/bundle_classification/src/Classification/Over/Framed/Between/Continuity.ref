\import Operations.TrivialPullback[X := X, Y := Cylinder.Carrier, n := k, original := baseSpace, base := Cylinder.topology baseSpace, f := Cylinder.point, regular := Cylinder.pointContinuous baseSpace] \as Pull;
\import Bundles.Trivial[X := Cylinder.Carrier, n := k, baseSpace := Cylinder.topology baseSpace] \as Source;
\import Bundles.Trivial[X := Cylinder.Carrier, n := dimension, baseSpace := Cylinder.topology baseSpace] \as Target;
\import Bundles.Morphisms[X := Cylinder.Carrier, Y := Cylinder.Carrier, F := (\fun (_: Cylinder.Carrier) => Vector k), G := (\fun (_: Cylinder.Carrier) => Vector k), source := Source.bundle, target := Pull.pulled, f := (\fun (z: Cylinder.Carrier) => z)].Composition[Z := Cylinder.Carrier, H := (\fun (_: Cylinder.Carrier) => Vector dimension), range := Target.bundle, g := (\fun (z: Cylinder.Carrier) => z)] \as Compose;
\definition map: Bundles.Morphisms[X := Cylinder.Carrier, Y := Cylinder.Carrier, F := (\fun (_: Cylinder.Carrier) => Vector k), G := (\fun (_: Cylinder.Carrier) => Vector dimension), source := Source.bundle, target := Target.bundle, f := (\fun (z: Cylinder.Carrier) => z)].Map := Compose.compose Pull.isomorphism.backward Interpolation.map;
\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TrivialFamily[X := Cylinder.Carrier, baseSpace := Cylinder.topology baseSpace, n := k, m := dimension, map := map] \as Family;
\definition regular: Hermitian.At[n := dimension].Families[X := Cylinder.Carrier].Matrix[m := k].Regular (Cylinder.topology baseSpace) family := Family.regular;
