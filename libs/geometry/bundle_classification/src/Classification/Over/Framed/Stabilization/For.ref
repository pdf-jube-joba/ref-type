\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Framed[X := X, baseSpace := baseSpace, k := k].For[F := F, bundle := bundle, same := same, framing := framing] \as Original;
\definition naturality: \forall (embedding: Original.Embedding) -> map Original.class =
  Addition.resultClass (\root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].FrameStabilization[X := X, baseSpace := baseSpace, k := k, n := n, p := Original.FromEmbedding[embedding := embedding].presentation].presentation) :=
  \fun (embedding: Original.Embedding) => trans!{Addition.ResultClasses} _ _ _
    (congr!{Classes Addition.ResultClasses} map _ _ (sym!{Classes} _ _ (Original.classification embedding)))
    (onClass (Original.FromEmbedding[embedding := embedding].presentation));
