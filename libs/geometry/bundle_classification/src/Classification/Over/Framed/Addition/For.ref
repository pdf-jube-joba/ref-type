\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Framed[X := X, baseSpace := baseSpace, k := k].For[F := F, bundle := left, same := leftSame, framing := leftFrame] \as First;
\import Right.For[F := G, bundle := right, same := rightSame, framing := rightFrame] \as Second;
\definition naturality: \forall (first: First.Embedding)(second: Second.Embedding) ->
  add First.class Second.class = onRepresentatives (First.FromEmbedding[embedding := first].presentation) (Second.FromEmbedding[embedding := second].presentation) :=
  \fun (first: First.Embedding)(second: Second.Embedding) => trans!{Target.Classes} _ _ _
    (congr!{Classes Right.Classes Target.Classes} add _ _ _ _ (sym!{Classes} _ _ (First.classification first)) (sym!{Right.Classes} _ _ (Second.classification second)))
    (onClasses (First.FromEmbedding[embedding := first].presentation) (Second.FromEmbedding[embedding := second].presentation));
