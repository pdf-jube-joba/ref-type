\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Framed[X := Y, baseSpace := source, k := k] \as Target;
\import Classifying.Pullback[Y := Y, source := source, f := f, continuous := continuous] \as Pull;
\definition naturality: \forall (embedding: Original.Embedding) -> Pull.map class =
  Target.class (Pull.presentation (presentation embedding)) :=
  \fun (embedding: Original.Embedding) => trans!{Target.Classes} _ _ _
    (congr!{Classifying.Classes Target.Classes} Pull.map _ _ (sym!{Classifying.Classes} _ _ (classification embedding)))
    (Pull.onClass (presentation embedding));
