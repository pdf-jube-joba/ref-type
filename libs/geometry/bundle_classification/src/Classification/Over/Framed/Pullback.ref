\import \root.Classification[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Framed[X := Y, baseSpace := source, k := k] \as Target;
\module At(p: Presentation);
\definition presentation[p: Presentation]: Target.Presentation := At[p := p].presentation;
\import Quotient.Maps[B := Target.Classes] \as Descend;
\definition respects: Descend.Respects (\fun (p: Presentation) => Target.class (presentation p)) :=
  \fun (p, q: Presentation)(_: Homotopic p q) => Target.uniqueClass (Target.class (presentation p)) (Target.class (presentation q));
\definition map: Classes -> Target.Classes := Descend.value equivalence (\fun (p: Presentation) => Target.class (presentation p)) respects;
\definition onClass: \forall (p: Presentation) -> map (class p) = Target.class (presentation p) := Descend.onClass equivalence (\fun (p: Presentation) => Target.class (presentation p)) respects;
