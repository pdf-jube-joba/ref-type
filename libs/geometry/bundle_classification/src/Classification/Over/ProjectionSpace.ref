\import Hermitian.At[n := n] \as Native;
\import topological_algebra.Matrix[K := K, I := Fin.Fin n, J := Fin.Fin n] \as Matrix;
\definition Carrier: \Set := Native.Projection;
\definition entries[P: Carrier]: Matrix.Carrier := \fun (i, j: Fin.Fin n) => P.map.apply (Geometry.Finite[n := n].basis j) i;
\import topological_constructions.Induced[A := Carrier, B := Matrix.Carrier] \as Induced;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Induced.topology (Matrix.topology scalar.topological.space) entries;
\definition regular: Native.Families[X := Carrier].Matrix[m := n].Regular topology (\fun (P: Carrier) => P.map) :=
  Native.Families[X := Carrier].Matrix[m := n].regularOfComponents topology (\fun (P: Carrier) => P.map)
    (\fun (j, i: Fin.Fin n) => topology.Composition[A := Carrier, B := Matrix.Carrier, C := K].composeContinuous topology (Matrix.topology scalar.topological.space) scalar.topological.space entries (Matrix.entry i j)
      (Induced.continuous (Matrix.topology scalar.topological.space) entries) (Matrix.entryContinuous scalar.topological.space i j));
\import Complements.Projection[X := Carrier, n := n, baseSpace := topology, P := (\fun (P: Carrier) => P), regular := regular] \as Universal;
\definition Fiber[P: Carrier]: \Set := Universal.Fiber P;
\definition bundle: Bundles.Family[X := Carrier, F := Fiber].Bundle := Universal.bundle;
\module Family(X: \Set, source: topology.Topology[Carrier := X].Topology, P: X -> Carrier,
  regularP: Native.Families[X := X].Matrix[m := n].Regular source (\fun (x: X) => (P x).map));
