\import Spaces.Linear[V := Image.Fiber x, W := Vector k, source := Image.fiberSpace x, target := coordinates k] \as Forward;
\import Spaces.Linear[V := Vector k, W := Image.Fiber x, source := coordinates k, target := Image.fiberSpace x] \as Backward;
\definition frame: Family.Frame k x := Spaces.Isomorphism[V := Image.Fiber x, W := Vector k, source := Image.fiberSpace x, target := coordinates k].Isomorphism {
  forward := Forward.Map { apply := \fun (v: Image.Fiber x) => basis.coordinate.apply v, preservesAdd := \fun (v, w: Image.Fiber x) => basis.coordinate.preservesAdd v w, preservesScale := \fun (a: K)(v: Image.Fiber x) => basis.coordinate.preservesScale a v },
  backward := Backward.Map { apply := \fun (v: Vector k) => \into[Vector n](basis.value.apply v, Image.Image x) \by { Hermitian.At[n := n].OnProjection[P := P x].Rank[k := k].fixed basis v }, preservesAdd := basis.value.preservesAdd, preservesScale := basis.value.preservesScale },
  leftInverse := \fun (v: Image.Fiber x) => trans!{{Vector n}} _ _ _ (basis.reconstruction v) (\bysub(Vector n, Image.Image x, v)),
  rightInverse := basis.leftInverse
};
