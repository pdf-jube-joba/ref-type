\import Bundles.Trivial[X := X, n := n, baseSpace := baseSpace] \as Trivial;
\import bundle_complements.Complements[].Over[K := R.Real, field := R.Algebra[].field, conjugation := hermitian_frames.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].For[X := X, F := (\fun (_: X) => Theory.Vector n), bundle := Trivial.bundle] \as Embeddings;
\definition embedding: Embeddings.Embedding := Embeddings.Embedding { dimension := n, map := Bundles.Identity[X := X, F := (\fun (_: X) => Theory.Vector n), bundle := Trivial.bundle].map, injective := \fun (x: X)(v, w: Theory.Vector n)(same: v = w) => same };
\import Theory.For[X := X, F := (\fun (_: X) => Theory.Vector n), bundle := Trivial.bundle].AtRank[k := n] \as Classifiers;
\definition rank: Classifiers.HasRank := \fun (x: X) => \exact(Trivial.identity, Bundles.Family[X := X, F := (\fun (_: X) => Theory.Vector n)].Of[bundle := Trivial.bundle].Frame n x);
\import Classifiers.WithEmbedding[embedding := embedding] \as Finite;
\definition classifier: Classifiers.Classifier := Classifiers.Classifier { data := Classifiers.Data { dimension := n, projection := Finite.projection, regular := Finite.regular }, rank := Finite.rank rank, comparison := Finite.comparison };
\import \root.Classification[].Real[X := X, F := (\fun (_: X) => Theory.Vector n), bundle := Trivial.bundle, k := n].From[classifier := classifier] \as Classifying;
\definition map: X -> grassmannians.Real[n := n, k := n].Model[].Carrier := Classifying.map;
\definition continuous: topology.Continuity[A := X, B := grassmannians.Real[n := n, k := n].Model[].Carrier].Continuous baseSpace grassmannians.Real[n := n, k := n].Model[].topology map := Classifying.continuous;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := (\fun (_: X) => Theory.Vector n), G := (\fun (x: X) => grassmannians.Real[n := n, k := n].Model[].Fiber (map x)), source := Trivial.bundle, target := Classifying.pulled].Isomorphism := Classifying.isomorphism;
\import Theory.Framed[X := X, baseSpace := baseSpace, k := n] \as Framed;
\import Framed.At[p := Framed.standard] \as FrameMap;
\import Framed.Between[p := Framed.standard, q := Framed.standard] \as FrameMotion;
\definition stableFrameHomotopy: \exists Framed.Between[p := Framed.standard, q := Framed.standard].Concordance := Framed.allHomotopic Framed.standard Framed.standard;
