\import \root.Classification[].Examples[].Trivial[X := X, baseSpace := baseSpace, n := m] \as Right;
\import Bundles.Trivial[X := X, n := m, baseSpace := baseSpace] \as RightBundle;
\import Theory.Framed[X := X, baseSpace := baseSpace, k := m].For[F := (\fun (_: X) => Theory.Vector m), bundle := RightBundle.bundle, same := \refl(baseSpace), framing := Right.standardFraming] \as RightClass;
\import Framed.Addition[l := m] \as Addition;
\import Addition.For[F := (\fun (_: X) => Theory.Vector n), G := (\fun (_: X) => Theory.Vector m), left := Trivial.bundle, right := RightBundle.bundle,
  leftSame := \refl(baseSpace), rightSame := \refl(baseSpace), leftFrame := standardFraming, rightFrame := Right.standardFraming] \as Sum;
\definition sumNaturality: Addition.add FramedClass.class RightClass.class = Addition.onRepresentatives (FramedClass.presentation embedding) (RightClass.presentation Right.embedding) :=
  Sum.naturality embedding Right.embedding;
\import Framed.Stabilization[n := m] \as Stabilization;
\import Stabilization.For[F := (\fun (_: X) => Theory.Vector n), bundle := Trivial.bundle, same := \refl(baseSpace), framing := standardFraming] \as Stable;
\import Theory.FrameStabilization[X := X, baseSpace := baseSpace, k := n, n := m, p := FramedClass.presentation embedding] \as Matrix;
\definition stabilizationNaturality: Stabilization.map FramedClass.class = Addition.resultClass Matrix.presentation := Stable.naturality embedding;
\module Oriented;
