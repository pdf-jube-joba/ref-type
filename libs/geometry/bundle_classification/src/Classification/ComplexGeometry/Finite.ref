\import grassmannians.Complex[n := n, k := k].Model[] \as Model;
\definition projection[x: X]: Hermitian.At[n := n].Projection := Model.projection (f x);
\definition regular: Hermitian.At[n := n].Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (projection x).map) :=
  \fun (v: Theory.Vector n)(i: Fin.Fin n) => topology.Composition[A := X, B := Model.Carrier, C := R.Complex].composeContinuous baseSpace Model.topology vector_bundles.Bundles[].Complex[].scalar.topological.space f
    (\fun (a: Model.Carrier) => (Model.projection a).map.apply v i) continuous (Model.regular v i);
\definition presentation: Classes.Presentation := Classes.Presentation { dimension := n, projection := projection, regular := regular };
\definition rank: \forall (x: X) -> Hermitian.At[n := n].OnProjection[P := projection x].Rank[k := k].HasRank := \fun (x: X) => Model.rank (f x);
