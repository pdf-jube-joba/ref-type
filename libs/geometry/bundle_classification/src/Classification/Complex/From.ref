\import grassmannians.Complex[n := classifier.data.dimension, k := k].Model[] \as Model;
\import Model.Family[Y := X, source := bundle.baseSpace, P := classifier.data.projection, regularP := classifier.data.regular, rankP := classifier.rank] \as Family;
\definition map: X -> Model.Carrier := Family.map;
\definition continuous: topology.Continuity[A := X, B := Model.Carrier].Continuous bundle.baseSpace Model.topology map := Family.continuous;
\import Bundles.Family[X := Model.Carrier, F := Model.Fiber].Of[bundle := Model.bundle].Pullback[Y := X, source := bundle.baseSpace, f := map] \as Pullback;
\definition pulled: Bundles.Family[X := X, F := (\fun (x: X) => Model.Fiber (map x))].Bundle := Pullback.pulled continuous;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := F, G := (\fun (x: X) => Model.Fiber (map x)), source := bundle, target := pulled].Isomorphism :=
  Operations.IsomorphismComposition[X := X, F := F,
    G := Complements.Projection[X := X, n := classifier.data.dimension, baseSpace := bundle.baseSpace, P := classifier.data.projection, regular := classifier.data.regular].Fiber,
    H := (\fun (x: X) => Model.Fiber (map x)), source := bundle,
    middle := Complements.Projection[X := X, n := classifier.data.dimension, baseSpace := bundle.baseSpace, P := classifier.data.projection, regular := classifier.data.regular].bundle,
    target := pulled].compose classifier.comparison
      (Bundles.Isomorphisms[X := X, F := (\fun (x: X) => Model.Fiber (map x)),
        G := Complements.Projection[X := X, n := classifier.data.dimension, baseSpace := bundle.baseSpace, P := classifier.data.projection, regular := classifier.data.regular].Fiber,
        source := pulled, target := Complements.Projection[X := X, n := classifier.data.dimension, baseSpace := bundle.baseSpace, P := classifier.data.projection, regular := classifier.data.regular].bundle].inverse Family.isomorphism);
