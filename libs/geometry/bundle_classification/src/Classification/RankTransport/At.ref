\definition fiber: Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].Isomorphism :=
  Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].Isomorphism {
    forward := iso.forward.fiber x, backward := iso.backward.fiber x, leftInverse := laws.leftInverse x, rightInverse := laws.rightInverse x
  };
\definition frame: RealBundles.Family[X := X, F := G].Of[bundle := target].Frame n x :=
  Spaces.Isomorphism[V := F x, W := RealBundles.Vector n, source := source.space x, target := RealBundles.coordinates n].Composition[U := G x, domain := target.space x].compose frame
    (Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].inverse fiber);
