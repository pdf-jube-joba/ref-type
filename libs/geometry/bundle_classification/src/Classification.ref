\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\import std.Alg[].Field[] \as Fields;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\module Over(K: \Set, field: Fields.Field[K], conjugation: linear_algebra.Hermitian[].Scalar[K, field], scalar: vector_bundles.Bundles[].Scalar[K, field, conjugation]);
\module Real(X: \Set, F: X -> \Set, bundle: vector_bundles.Bundles[].Over[K := real.Analysis[].Real, field := real.Analysis[].Algebra[].field, conjugation := hermitian_frames.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].Family[X := X, F := F].Bundle, k: N.Nat^);
\module Complex(X: \Set, F: X -> \Set, bundle: vector_bundles.Bundles[].Over[K := complex.Complex[].Complex, field := complex.Complex[].Algebra[].field, conjugation := hermitian_frames.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Family[X := X, F := F].Bundle, k: N.Nat^);
\module RealGeometry(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology);
\module ComplexGeometry(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology);
\import real.Analysis[] \as RealNumbers;
\import vector_bundles.Bundles[].Over[K := RealNumbers.Real, field := RealNumbers.Algebra[].field, conjugation := hermitian_frames.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as RealBundles;
\module Orientations(X: \Set, F: X -> \Set, bundle: RealBundles.Family[X := X, F := F].Bundle);
\module Determinants(X: \Set, F, G: X -> \Set, source: RealBundles.Family[X := X, F := F].Bundle, target: RealBundles.Family[X := X, F := G].Bundle,
  same: source.baseSpace = target.baseSpace, k: N.Nat^, iso: RealBundles.Isomorphisms[X := X, F := F, G := G, source := source, target := target].Isomorphism);
\module Oriented;
\module ScalarSigns;
\module TopForms(V: \Set, space: linear_algebra.Commutative[K := RealNumbers.Real, scalarRing := Fields.fieldAsCommutativeRing RealNumbers.Real RealNumbers.Algebra[].field].VectorSpace V,
  n: N.Nat^, frame: RealBundles.Dimension[V := V, space := space].Frame n);
\module DeterminantProduct(V, W: \Set,
  left: linear_algebra.Commutative[K := RealNumbers.Real, scalarRing := Fields.fieldAsCommutativeRing RealNumbers.Real RealNumbers.Algebra[].field].VectorSpace V,
  right: linear_algebra.Commutative[K := RealNumbers.Real, scalarRing := Fields.fieldAsCommutativeRing RealNumbers.Real RealNumbers.Algebra[].field].VectorSpace W,
  n, m: N.Nat^, first: \exists RealBundles.Dimension[V := V, space := left].Frame n, second: \exists RealBundles.Dimension[V := W, space := right].Frame m);
\module RankedCharts(X: \Set, F: X -> \Set, bundle: RealBundles.Family[X := X, F := F].Bundle, n: N.Nat^,
  rank: \forall (x: X) -> \exists RealBundles.Family[X := X, F := F].Of[bundle := bundle].Frame n x);
\module ConeCylinder(X: \Set, L: X -> \Set, source: RealBundles.Family[X := X, F := L].Bundle,
  D: algebraic_topology.Cylinder[A := X].Carrier -> \Set,
  target: RealBundles.Family[X := algebraic_topology.Cylinder[A := X].Carrier, F := D].Bundle);
\import hermitian_frames.Hermitian[].Over[K := RealNumbers.Real, field := RealNumbers.Algebra[].field, scalar := hermitian_frames.Hermitian[].Real[].scalar, topological := vector_bundles.Bundles[].Real[].scalar.topological] \as RealHermitian;
\module ProjectionCylinder(X: \Set, baseSpace: topology.Topology[Carrier := X].Topology, compact: topology.Topology[Carrier := X].IsCompact baseSpace, n: N.Nat^,
  P: algebraic_topology.Cylinder[A := X].Carrier -> RealHermitian.At[n := n].Projection,
  regular: RealHermitian.At[n := n].Families[X := algebraic_topology.Cylinder[A := X].Carrier].Matrix[m := n].Regular
    (algebraic_topology.Cylinder[A := X].topology baseSpace) (\fun (z: algebraic_topology.Cylinder[A := X].Carrier) => (P z).map));
\module Examples;
