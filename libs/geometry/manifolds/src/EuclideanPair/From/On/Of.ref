\definition apply[x: X.Point]: target.Point := Blocks.join (FirstMaps.apply f x) (SecondMaps.apply g x);
\import \root.FromCharts[n := p, m := dimension].Between[M := X, N := target] \as Plots;
\module Local(c: Plots.SourceChart);
\definition maps: Plots.Family := \fun (c: Plots.SourceChart) => Local[c := c].map;
\definition agrees: Plots.Agreement apply maps := \fun (c: Plots.SourceChart)(u: Open.Carrier c.image) => \refl(apply (Charts.point c u));
\import Plots.On[f := apply, maps := maps, agrees := agrees] \as Construct;
\definition map: \root.SmoothMap[n := p, m := dimension].Between[M := X, N := target].Map := Construct.value;
