\import \root.SmoothMap[n := p, m := n].Between[M := X, N := First.smoothManifold] \as FirstMaps;
\import \root.SmoothMap[n := p, m := m].Between[M := X, N := Second.smoothManifold] \as SecondMaps;
\import \root.Dimension[n := p].Chart[M := X.Point, space := X.space] \as Charts;
\import calculus.Real[].Multivariable[n := n].Open[] \as FirstOpen;
\import calculus.Real[].Multivariable[n := m].Open[] \as SecondOpen;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as TargetOpen;
\import \root.Dimension[n := n].Atlas[M := First.smoothManifold.Point, space := First.smoothManifold.space] \as FirstAtlas;
\import \root.Dimension[n := m].Atlas[M := Second.smoothManifold.Point, space := Second.smoothManifold.space] \as SecondAtlas;
\module Of(f: FirstMaps.Map, g: SecondMaps.Map);
