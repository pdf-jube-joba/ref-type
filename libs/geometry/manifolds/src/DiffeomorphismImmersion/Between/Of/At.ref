\import \root.Tangent[n := m].On[M := N] \as Target;
\import \root.Tangent[n := n].On[M := M] \as Source;
\import real.Analysis[] \as R;
\import linear_algebra.Field[].Space[K := R.Real, field := R.Algebra[].field] \as Spaces;
\import Spaces.Isomorphism[V := Source.Vector x, W := Target.Vector (Forward.apply d.forward x), source := Source.space x, target := Target.space (Forward.apply d.forward x)] \as Isomorphisms;
\import \root.DiffeomorphismDifferential[n := n, m := m].Between[M := M, N := N].Of[d := d].At[x := x] \as Differential;
\definition injective: \forall (u, v: Source.Vector x) ->
  \root.Differential[n := n, m := m].Between[M := M, N := N].At[f := d.forward, x := x].value.apply u =
  \root.Differential[n := n, m := m].Between[M := M, N := N].At[f := d.forward, x := x].value.apply v -> u = v := Isomorphisms.injective Differential.isomorphism;
