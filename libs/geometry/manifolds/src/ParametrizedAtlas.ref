/* The topology and charts determined by countably many local coordinates. */
\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import Open.Topology[] \as OpenTopology;
\import topology.Topology[Carrier := A] \as Space;
\definition Domain[S: \Pow A]: \Set := \Cast[A] S;
\structure Patch: \Set := {
  domain: \Pow A,
  image: Open.OpenSet,
  point: Open.Carrier image -> Domain domain,
  coordinate: Domain domain -> Open.Carrier image,
  pointCoordinate: \forall (x: Domain domain) -> point (coordinate x) = x,
  coordinatePoint: \forall (x: Open.Carrier image) -> coordinate (point x) = x,
};
\structure Family: \Set := {
  patch: N.Nat^ -> Patch,
  covers: \forall (x: A) -> \exists ( i: N.Nat^ \where \In[A] ((patch i).domain) x ),
};
\definition value[p: Patch][x: Open.Carrier p.image]: A := p.point x;
\definition pointInjective: \forall (p: Patch)(x, y: Open.Carrier p.image) -> value p x = value p y -> x = y := \block {
  \fun (p: Patch)(x, y: Open.Carrier p.image)(same: _) \then
  \let localSame: p.point x = p.point y := same \then
  \return trans!{{Open.Carrier p.image}} _ _ _ (sym!{{Open.Carrier p.image}} _ _ (p.coordinatePoint x))
    (trans!{{Open.Carrier p.image}} _ _ _ (congr!{{Domain p.domain} {Open.Carrier p.image}} p.coordinate _ _ localSame) (p.coordinatePoint y))
};
\module Read(d: N.Nat^);
\module On(family: Family);
