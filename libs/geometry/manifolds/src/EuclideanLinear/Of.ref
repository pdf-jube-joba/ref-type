\import calculus.LinearMap[n := n, m := m].On[U := Open.whole, L := L] \as Calculus;
\import Global.Of[f := Calculus.map] \as Full;
\definition map: Maps.Map := Full.map;
\definition Injective: \Prop := \forall (v, w: Source.Vector) -> L.apply v = L.apply w -> v = w;
\module At(x: Global.source.Point);
\definition immersion[injective: Injective]: Immersions.Immersion := \into[Maps.Map](map, Immersions.Immersion) \by {
  \fun (x: Global.source.Point) => At[x := x].injective injective
};
