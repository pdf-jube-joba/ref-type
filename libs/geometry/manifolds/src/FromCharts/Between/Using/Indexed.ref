\definition IndexedFamily: \Set := \forall (i: I) -> LocalMap (chart i);
\definition IndexedAgreement[f: Function][maps: IndexedFamily]: \Prop := \forall (i: I)(x: Open.Carrier (chart i).image) ->
  \root.SmoothMap[n := n, m := m].Between[M := parameterManifold (chart i), N := N].apply (maps i) x = f (SourceCharts.point (chart i) x);
\module Of(f: Function, maps: IndexedFamily, agrees: IndexedAgreement f maps);
