\import \root.SmoothMap[n := n, m := m].Between[M := parameterManifold c, N := N] \as LocalMaps;
\definition law[g: Values c]: \forall (x: Open.Carrier c.image) -> LocalMaps.apply g x = f (SourceCharts.point c x) :=
  \bysub(LocalMap c, { g: LocalMap c \where \forall (x: Open.Carrier c.image) -> LocalMaps.apply g x = f (SourceCharts.point c x) }, g);
\definition uniqueness: \forall (g, h: Values c) -> g = h := \fun (g, h: Values c) => LocalMaps.ext g h
  (\axiom:funext((LocalMaps.apply g), (LocalMaps.apply h), \fun (x: Open.Carrier c.image) => trans!{{N.Point}} _ _ _ (law g x) (sym!{{N.Point}} _ _ (law h x))));
\definition chosen: Values c := \choice Values c \by { existence: existence c, uniqueness: uniqueness };
\definition agrees: \forall (x: Open.Carrier c.image) -> LocalMaps.apply chosen x = f (SourceCharts.point c x) := law chosen;
