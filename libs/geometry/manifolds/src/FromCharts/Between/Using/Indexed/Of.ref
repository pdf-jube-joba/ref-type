\definition Values[c: SourceChart]: \Set := \Cast[LocalMap c] ({ g: LocalMap c \where
  \forall (x: Open.Carrier c.image) -> \root.SmoothMap[n := n, m := m].Between[M := parameterManifold c, N := N].apply g x = f (SourceCharts.point c x) });
\definition existence: \forall (c: SourceChart) -> \exists Values c := \block {
  \fun (c: SourceChart) \then
  \takefrom i: \Cast[I] ({ i: I \where chart i = c }) \by exhaustive c \then
  \return \idelim chart i = c \with d: SourceChart => \exists Values d \by {
    base: Logic.existsIntro[LocalMap (chart i), { g: LocalMap (chart i) \where
      \forall (x: Open.Carrier (chart i).image) -> \root.SmoothMap[n := n, m := m].Between[M := parameterManifold (chart i), N := N].apply g x = f (SourceCharts.point (chart i) x) }]
      (maps i) (agrees i),
    equality: \bysub(I, { i: I \where chart i = c }, i)
  }
};
\module Local(c: SourceChart);
\definition family[c: SourceChart]: LocalMap c := Local[c := c].chosen;
\definition agreement: Agreement f family := \fun (c: SourceChart) => Local[c := c].agrees;
\import \parent.\parent.On[f := f, maps := family, agrees := agreement] \as Construct;
\definition value: Maps.Map := Construct.value;
\definition apply: Maps.apply value = f := Construct.apply;
