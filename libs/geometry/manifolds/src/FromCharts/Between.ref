\import \root.Dimension[n := n].Chart[M := M.Point, space := M.space] \as SourceCharts;
\import \root.Dimension[n := m].Chart[M := N.Point, space := N.space] \as TargetCharts;
\import \root.Dimension[n := n].Atlas[M := M.Point, space := M.space] \as SourceAtlases;
\import \root.Dimension[n := m].Atlas[M := N.Point, space := N.space] \as TargetAtlases;
\import \root.SmoothMap[n := n, m := m].Between[M := M, N := N] \as Maps;
\import \root.SmallAtlasSmoothMap[n := n, m := m].Between[M := M, N := N] \as Small;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\import Open.Restriction[] \as Restriction;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import topology.Topology[Carrier := M.Point] \as SourceTopology;
\import topology.Topology[Carrier := N.Point] \as TargetTopology;
\import topology.Continuity[A := M.Point, B := N.Point] \as Continuity;
\definition SourceChart: \Set := \Cast[SourceCharts.Chart] M.atlas.charts;
\definition parameterManifold[c: SourceChart]: Sources.Manifold := \root.Dimension[n := n].Examples[].Euclidean[].Subspace[U := c.image].smoothManifold;
\definition LocalMap[c: SourceChart]: \Set := \root.SmoothMap[n := n, m := m].Between[M := parameterManifold c, N := N].Map;
\definition Family: \Set := \forall (c: SourceChart) -> LocalMap c;
\definition Function: \Set := M.Point -> N.Point;
\definition Agreement[f: Function][maps: Family]: \Prop := \forall (c: SourceChart)(x: Open.Carrier c.image) ->
  \root.SmoothMap[n := n, m := m].Between[M := parameterManifold c, N := N].apply (maps c) x = f (SourceCharts.point c x);
\module On(f: Function, maps: Family, agrees: Agreement f maps);
\module Using(source: Small.SourceAtlas);
\module Covered(I: \Set, chart: I -> SourceChart,
  covers: \forall (x: M.Point) -> \exists ( i: I \where SourceCharts.Contains (chart i) x ));
