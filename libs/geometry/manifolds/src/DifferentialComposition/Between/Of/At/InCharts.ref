\use std.Logic[].Equality[].eq_reason_in;
\import FirstD.InCharts[left := left, right := middle] \as FirstLocal;
\import SecondD.InCharts[left := middle, right := right] \as SecondLocal;
\import CompositeD.InCharts[left := left, right := right] \as CompositeLocal;
\import \root.Dimension[n := n].Chart[M := M.Point, space := M.space] \as SourceCharts;
\import \root.Dimension[n := m].Chart[M := N.Point, space := N.space] \as MiddleCharts;
\import \root.Dimension[n := l].Chart[M := P.Point, space := P.space] \as TargetCharts;
\definition sourceChart: Composition.SourceChart := \into[SourceCharts.Chart](left, M.atlas.charts) \by { A.member left };
\definition middleChart: Composition.MiddleChart := \into[MiddleCharts.Chart](middle, N.atlas.charts) \by { B.member middle };
\definition targetChart: Composition.TargetChart := \into[TargetCharts.Chart](right, P.atlas.charts) \by { C.member right };
\import \root.CompositionDifferential[n := n, m := m, l := l].Between[M := M, N := N, P := P].Of[f := f, g := g].InCharts[left := sourceChart, middle := middleChart, right := targetChart] \as Data;
\import Composition.Coordinates[left := left, right := right].Patch[middle := middleChart] \as Patch;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\definition point: Open.Carrier Data.domain := \into[calculus.Real[].Multivariable[n := n].Point](A.coordinate left, Data.domain.points) \by {
  Patch.contains CompositeLocal.point FirstLocal.containsImage
};
\import Data.At[a := point] \as Chain;
\import calculus.Maps[n := m, m := l] \as Calculus;
\import calculus.Real[].Multivariable[n := m].Open[] \as MiddleOpen;
\definition intermediate: MiddleOpen.Carrier SecondLocal.domain := Patch.intermediate point;
\definition pointAgreement: intermediate = SecondLocal.point := FirstLocal.coordinateAgreement;
\import std.Data[].FinSet[] \as Fin;
\import Spaces.Coordinates[I := Fin.Fin n] \as AV;
\import Spaces.Coordinates[I := Fin.Fin m] \as BV;
\import Spaces.Coordinates[I := Fin.Fin l] \as CV;
\import Spaces.Linear[V := BV.Vector, W := CV.Vector, source := BV.space, target := CV.space] \as SecondMaps;
\import SecondMaps.Composition[U := AV.Vector, domain := AV.space] \as LocalCompose;
\import Spaces.Linear[V := AV.Vector, W := CV.Vector, source := AV.space, target := CV.space] \as ResultMaps;
\definition secondAgreement: Calculus.Differential[U := SecondLocal.domain, V := right.image, f := Data.secondMap, a := intermediate].value = SecondLocal.jacobian :=
  congr!{{MiddleOpen.Carrier SecondLocal.domain} {SecondMaps.Map}} SecondLocal.jacobianAt intermediate SecondLocal.point pointAgreement;
\definition jacobian: CompositeLocal.jacobian = LocalCompose.compose SecondLocal.jacobian FirstLocal.jacobian :=
  trans!{{ResultMaps.Map}} _ _ _ Chain.law
    (congr!{{SecondMaps.Map} {ResultMaps.Map}} (\fun (d: SecondMaps.Map) => LocalCompose.compose d FirstLocal.jacobian) _ _ secondAgreement);
\import A.Coordinate[chart := left] \as AC;
\import B.Coordinate[chart := middle] \as BC;
\import C.Coordinate[chart := right] \as CC;
\definition pointwise: \forall (v: A.Vector) -> CompositeD.value.apply v = composite.apply v :=
  \fun (v: A.Vector) => CC.injective (CompositeD.value.apply v) (composite.apply v)
    (eq_reason_in!{{CV.Vector} _
      "=" _ "by" { CompositeD.coordinates left right v }
      "=" _ "by" { congr!{{ResultMaps.Map} {CV.Vector}} (\fun (d: ResultMaps.Map) => d.apply (AC.decode v)) _ _ jacobian }
      "=" _ "by" { congr!{{BV.Vector} {CV.Vector}} (SecondLocal.jacobian.apply) _ _ (sym!{{BV.Vector}} _ _ (FirstD.coordinates left middle v)) }
      "=" _ "by" { sym!{{CV.Vector}} _ _ (SecondD.coordinates middle right (FirstD.value.apply v)) }
    });
