\import \root.Dimension[n := n].Examples[].Euclidean[] \as Source;
\import \root.Dimension[n := m].Examples[].Euclidean[] \as Target;
\import \root.Dimension[n := n].Smooth[] \as SourceModel;
\import \root.Dimension[n := m].Smooth[] \as TargetModel;
\definition source: SourceModel.Manifold := Source.smoothManifold;
\definition target: TargetModel.Manifold := Target.smoothManifold;
\import calculus.Real[].Multivariable[n := n].Open[] \as SourceOpen;
\import calculus.Real[].Multivariable[n := m].Open[] \as TargetOpen;
\import calculus.Maps[n := n, m := m] \as Calculus;
\import \root.SmoothMap[n := n, m := m].Between[M := source, N := target] \as Maps;
\import \root.SmallAtlasSmoothMap[n := n, m := m].Between[M := source, N := target] \as Small;
\import \root.Dimension[n := n].Chart[M := source.Point, space := source.space] \as SourceCharts;
\import \root.Dimension[n := m].Chart[M := target.Point, space := target.space] \as TargetCharts;
\import \root.Dimension[n := n].Atlas[M := source.Point, space := source.space] \as SourceAtlases;
\import \root.Dimension[n := m].Atlas[M := target.Point, space := target.space] \as TargetAtlases;
\definition sourceAtlas: Small.SourceAtlas := \into[SourceAtlases.Atlas](Source.atlas, Small.SourceAtlas) \by {
  \fun (c: SourceCharts.Chart)(member: _) => SourceAtlases.includedInSaturation Source.atlas c member
};
\definition targetAtlas: Small.TargetAtlas := \into[TargetAtlases.Atlas](Target.atlas, Small.TargetAtlas) \by {
  \fun (c: TargetCharts.Chart)(member: _) => TargetAtlases.includedInSaturation Target.atlas c member
};
\import Small.On[source := sourceAtlas, target := targetAtlas] \as SmallAtlas;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\module Of(f: Calculus.Map SourceOpen.whole TargetOpen.whole);
