\import topology.Topology[Carrier := Parameter j] \as Source;
\import topology.Topology[Carrier := Parameter i] \as Target;
\import topology.Topology[Carrier := std.Data[].FinSet[].Fin n -> real.Analysis[].Real] \as Ambient;
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as Euclidean;
\import Ambient.Subspace[S := (patch j).image.points] \as SourceSubspace;
\definition containsImage[a: Parameter j][y: Parameter i][inW: \In[Parameter i] W y][same: point i y = point j a]:
  \In[A] (Image i W) (point j a) := Logic.existsIntro[Parameter i,
    { z: Parameter i \where Logic.And[\In[Parameter i] W z, point i z = point j a] }] y (Logic.And[_, _]::# inW same);
\module At(a: Parameter j);
\definition open: Source.IsOpenIn (parameterTopology j) (Pullback j (Image i W)) := Source.openOfNeighborhoods (parameterTopology j)
  (Pullback j (Image i W)) (\fun (a: Parameter j)(member: _) => At[a := a].neighborhood member);
