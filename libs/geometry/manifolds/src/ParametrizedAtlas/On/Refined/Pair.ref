\import Charts.Transition[left := Construction.chart j, right := Construction.chart i] \as Transition;
\import Open.Smooth[] \as Smooth;
\import Open.Restriction[] \as Restriction;
\import calculus.Maps[n := n, m := n] \as Maps;
\module At(a: Open.Carrier Transition.domain);
\module Component(k: std.Data[].FinSet[].Fin n) {
  \import Open.LocalSmooth[U := Transition.domain, f := \fun (x: Open.Carrier Transition.domain) => Transition.apply x k] \as Local;
  \definition smooth: Smooth.SmoothOn Transition.domain (\fun (x: Open.Carrier Transition.domain) => Transition.apply x k) := Local.smooth
    (\fun (a: Open.Carrier Transition.domain) => \parent.At[a := a].localSmooth k);
}
\definition compatible: Atlases.Compatible (Construction.chart j) (Construction.chart i) := \fun (k: std.Data[].FinSet[].Fin n) => Component[k := k].smooth;
