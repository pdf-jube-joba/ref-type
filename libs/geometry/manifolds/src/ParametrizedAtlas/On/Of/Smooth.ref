\definition compatible: \forall (c, d: Charts.Chart) -> \In[Charts.Chart] charts c -> \In[Charts.Chart] charts d -> Atlases.Compatible c d := \block {
  \fun (c, d: Charts.Chart)(left: _)(right: _) \then
  \takefrom i: \Cast[N.Nat^] ({ i: N.Nat^ \where c = chart i }) \by left \then
  \takefrom j: \Cast[N.Nat^] ({ j: N.Nat^ \where d = chart j }) \by right \then
  \return \idelim chart i = c \with a: Charts.Chart => Atlases.Compatible a d \by {
    base: \idelim chart j = d \with b: Charts.Chart => Atlases.Compatible (chart i) b \by {
      base: changes i j, equality: sym!{{Charts.Chart}} _ _ (\bysub(N.Nat^, { j: N.Nat^ \where d = chart j }, j))
    },
    equality: sym!{{Charts.Chart}} _ _ (\bysub(N.Nat^, { i: N.Nat^ \where c = chart i }, i))
  }
};
\definition atlas: Atlases.Atlas := Atlases.Atlas { charts := charts, covers := Covers, compatible := compatible };
\import \root.Dimension[n := n].Smooth[] \as SmoothModel;
\import SmoothModel.From[M := A, space := topology, atlas := atlas] \as Construction;
\definition manifold[hausdorff: Space.IsT2 topology]: SmoothModel.Manifold := Construction.manifold hausdorff secondCountable;
