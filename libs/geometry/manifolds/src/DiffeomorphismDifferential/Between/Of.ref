\definition f: Forward.Map := d.forward;
\definition g: Backward.Map := d.backward;
\definition SourceChart: \Set := \Cast[SourceCharts.Chart] (M.atlas.charts);
\definition TargetChart: \Set := \Cast[TargetCharts.Chart] (N.atlas.charts);
\module Local(left: SourceChart, right: TargetChart);
\import real.Analysis[] \as Reals;
\import Reals.Algebra[] \as Algebra;
\import linear_algebra.Commutative[K := Reals.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Reals.Real (Algebra.field)] \as Spaces;
\import \root.Tangent[n := n].On[M := M] \as SourceTangent;
\import \root.Tangent[n := m].On[M := N] \as TargetTangent;
\module At(x: M.Point);
