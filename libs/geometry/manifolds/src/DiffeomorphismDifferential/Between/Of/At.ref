\import SourceTangent.At[x := x] \as Source;
\import TargetTangent.At[x := Forward.apply f x] \as Target;
\import \root.Differential[n := n, m := m].Between[M := M, N := N].At[f := f, x := x] \as Differential;
\import Spaces.Linear[V := Source.Vector, W := Target.Vector, source := Source.space, target := Target.space] \as ForwardMaps;
\import Spaces.Linear[V := Target.Vector, W := Source.Vector, source := Target.space, target := Source.space] \as BackwardMaps;
\module InCharts(left: Source.Chart, right: Target.Chart);
\structure InverseLaws[inverse: BackwardMaps.Map]: \Prop {
  leftInverse: \forall (v: Source.Vector) -> inverse.apply (Differential.value.apply v) = v,
  rightInverse: \forall (w: Target.Vector) -> Differential.value.apply (inverse.apply w) = w,
}
\definition Values: \Set := \Cast[BackwardMaps.Map] ({ inverse: BackwardMaps.Map \where InverseLaws[inverse] });
\definition existence: \exists Values := \block {
  \takefrom left: Source.Chart \by Source.chartExists \then
  \takefrom right: Target.Chart \by Target.chartExists \then
  \return \exact(\into[BackwardMaps.Map](InCharts[left := left, right := right].inverse, Values) \by {
    InverseLaws[InCharts[left := left, right := right].inverse] {
      leftInverse := InCharts[left := left, right := right].leftInverse,
      rightInverse := InCharts[left := left, right := right].rightInverse,
    }
  }, Values)
};
\definition uniqueness: \forall (f, g: Values) -> f = g :=
  \fun (f, g: Values) => BackwardMaps.ext f g (\axiom:funext((f.apply), (g.apply), \fun (w: Target.Vector) =>
    trans!{{Source.Vector}} (f.apply w) (f.apply (Differential.value.apply (g.apply w))) (g.apply w)
      (congr!{{Target.Vector} {Source.Vector}} (f.apply) w (Differential.value.apply (g.apply w))
        (sym!{{Target.Vector}} _ _ ((\bysub(BackwardMaps.Map, Values, g)).rightInverse w)))
      ((\bysub(BackwardMaps.Map, Values, f)).leftInverse (g.apply w))));
\definition chosen: Values := \choice Values \by { existence: existence, uniqueness: uniqueness };
\definition inverse: BackwardMaps.Map := chosen;
\import Spaces.Isomorphism[V := Source.Vector, W := Target.Vector, source := Source.space, target := Target.space] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := Differential.value, backward := inverse,
  leftInverse := (\bysub(BackwardMaps.Map, Values, chosen)).leftInverse,
  rightInverse := (\bysub(BackwardMaps.Map, Values, chosen)).rightInverse,
};
