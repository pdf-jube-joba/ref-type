\import std.Data[].Nat[] \as N;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\import calculus.Blocks[n := n, m := m] \as Blocks;
\definition dimension: N.Nat^ := Blocks.dimension;
\import \root.Dimension[n := n].Examples[].Euclidean[] \as First;
\import \root.Dimension[n := m].Examples[].Euclidean[] \as Second;
\import \root.Dimension[n := dimension].Examples[].Euclidean[] \as Target;
\import \root.Dimension[n := dimension].Smooth[] \as Targets;
\definition target: Targets.Manifold := Target.smoothManifold;
\module From(p: N.Nat^);
