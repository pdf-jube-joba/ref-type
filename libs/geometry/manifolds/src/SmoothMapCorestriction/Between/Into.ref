\import \root.OpenSubmanifold[n := m].On[M := N].In[U := U] \as Restricted;
\definition manifold: Targets.Manifold := Restricted.manifold;
\import \root.SmoothMap[n := n, m := m].Between[M := M, N := manifold] \as Maps;
\import \root.SmallAtlasSmoothMap[n := n, m := m].Between[M := M, N := manifold] \as Small;
\import \root.Dimension[n := m].Chart[M := manifold.Point, space := manifold.space] \as Charts;
\import \root.Dimension[n := m].Atlas[M := manifold.Point, space := manifold.space] \as Atlases;
\module Of(f: OriginalMaps.Map, inside: \forall (x: M.Point) -> \In[N.Point] U (OriginalMaps.apply f x));
