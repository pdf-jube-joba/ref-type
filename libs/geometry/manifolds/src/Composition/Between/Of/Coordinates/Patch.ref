\import First.Coordinates[f := f, left := left, right := middle] \as LocalFirst;
\import Second.Coordinates[f := g, left := middle, right := right] \as LocalSecond;
\definition firstIncluded: Open.Included (domains middle) LocalFirst.domain := Open.intersectionLeft LocalFirst.domain Direct.domain;
\definition firstPoint[x: Open.Carrier (domains middle)]: Open.Carrier LocalFirst.domain := Open.inclusion (domains middle) LocalFirst.domain firstIncluded x;
\definition directPoint[x: Open.Carrier (domains middle)]: Open.Carrier Direct.domain := Open.inclusion (domains middle) Direct.domain (included middle) x;
\definition contains: \forall (x: Open.Carrier Direct.domain) -> MiddleCharts.Contains middle (First.apply f (SourceCharts.point left (Direct.leftCoordinate x))) ->
  \In[Reals.Multivariable[n := n].Point] ((domains middle).points) x :=
  \fun (x: Open.Carrier Direct.domain)(member: MiddleCharts.Contains middle (First.apply f (SourceCharts.point left (Direct.leftCoordinate x)))) =>
    Logic.And[\In[Reals.Multivariable[n := n].Point] (LocalFirst.domain.points) x, \In[Reals.Multivariable[n := n].Point] (Direct.domain.points) x]::#
      (LocalFirst.intro (Direct.leftCoordinate x) member) (\bysub(Reals.Multivariable[n := n].Point, Direct.domain.points, x));
\definition inRight: \forall (x: Open.Carrier (domains middle)) -> TargetCharts.Contains right (Second.apply g (MiddleCharts.point middle (LocalFirst.apply (firstPoint x)))) :=
  \fun (x: Open.Carrier (domains middle)) => \idelim First.apply f (SourceCharts.point left (LocalFirst.leftCoordinate (firstPoint x))) =
    MiddleCharts.point middle (LocalFirst.apply (firstPoint x)) \with y: N.Point => TargetCharts.Contains right (Second.apply g y) \by {
      base: Direct.inRightDomain (directPoint x),
      equality: sym!{{N.Point}} _ _ (LocalFirst.returnsPoint (firstPoint x))
    };
\definition intermediate[x: Open.Carrier (domains middle)]: Reals.Multivariable[n := m].Open[].Carrier LocalSecond.domain :=
  \into[Reals.Multivariable[n := m].Point](LocalFirst.apply (firstPoint x), LocalSecond.domain.points) \by {
    LocalSecond.intro (LocalFirst.apply (firstPoint x)) (inRight x)
  };
\definition firstData: FirstCalculus.Data[domains middle, LocalSecond.domain] := FirstCalculus.Data[domains middle, LocalSecond.domain] { apply := intermediate };
\definition firstMap[leftMember: \In[SourceCharts.Chart] M.atlas.charts left]: FirstCalculus.Map (domains middle) LocalSecond.domain :=
  \into[FirstCalculus.Data[domains middle, LocalSecond.domain]](firstData,
    { h: FirstCalculus.Data[domains middle, LocalSecond.domain] \where FirstCalculus.Laws[domains middle, LocalSecond.domain, h] }) \by {
      FirstCalculus.Laws[domains middle, LocalSecond.domain, firstData] {
        smooth := \fun (i: Fin.Fin m) => Restriction.localSmooth (domains middle) LocalFirst.domain firstIncluded
          (\fun (x: Open.Carrier LocalFirst.domain) => LocalFirst.apply x i)
          ((\bysub(First.ContinuousMap, { h: First.ContinuousMap \where First.Chartwise h }, f)) left middle leftMember
            (\bysub(MiddleCharts.Chart, N.atlas.charts, middle)) i),
      }
    };
\definition secondMap[rightMember: \In[TargetCharts.Chart] P.atlas.charts right]: SecondCalculus.Map LocalSecond.domain right.image :=
  LocalSecond.map ((\bysub(Second.ContinuousMap, { h: Second.ContinuousMap \where Second.Chartwise h }, g)) middle right
    (\bysub(MiddleCharts.Chart, N.atlas.charts, middle)) rightMember);
\definition compose[leftMember: \In[SourceCharts.Chart] M.atlas.charts left][rightMember: \In[TargetCharts.Chart] P.atlas.charts right]: CompositeCalculus.Map (domains middle) right.image :=
  FirstCalculus.Composition[U := domains middle, V := LocalSecond.domain, f := firstMap leftMember].After[l := l, W := right.image, g := secondMap rightMember].compose;
\definition coordinateAgreement: \forall (x: Open.Carrier (domains middle)) -> LocalSecond.apply (intermediate x) = Direct.apply (directPoint x) :=
  \fun (x: Open.Carrier (domains middle)) => congr!{{TargetCharts.LocalPoint right} {Reals.Multivariable[n := l].Open[].Carrier right.image}} (TargetCharts.coordinate right)
    (LocalSecond.point (intermediate x)) (Direct.point (directPoint x))
    (congr!{{N.Point} {P.Point}} (Second.apply g) _ _ (LocalFirst.returnsPoint (firstPoint x)));
\definition regular: \In[SourceCharts.Chart] M.atlas.charts left -> \In[TargetCharts.Chart] P.atlas.charts right -> \forall (i: Fin.Fin l) ->
  Smooth.SmoothOn (domains middle) (Open.restrict (domains middle) Direct.domain (included middle) (\fun (x: Open.Carrier Direct.domain) => Direct.apply x i)) :=
  \fun (leftMember: \In[SourceCharts.Chart] M.atlas.charts left)(rightMember: \In[TargetCharts.Chart] P.atlas.charts right)(i: Fin.Fin l) =>
    \idelim (\fun (x: Open.Carrier (domains middle)) => CompositeCalculus.apply (domains middle) right.image (compose leftMember rightMember) x i) =
      (\fun (x: Open.Carrier (domains middle)) => Direct.apply (directPoint x) i)
      \with h: Open.ScalarFunction (domains middle) => Smooth.SmoothOn (domains middle) h \by {
        base: (compose leftMember rightMember).smooth i,
        equality: \axiom:funext((\fun (x: Open.Carrier (domains middle)) => CompositeCalculus.apply (domains middle) right.image (compose leftMember rightMember) x i),
          (\fun (x: Open.Carrier (domains middle)) => Direct.apply (directPoint x) i),
          \fun (x: Open.Carrier (domains middle)) => congr!{{Reals.Multivariable[n := l].Point} {Reals.Real}} (\fun (v: Reals.Multivariable[n := l].Point) => v i)
            (LocalSecond.apply (intermediate x)) (Direct.apply (directPoint x)) (coordinateAgreement x))
      };
