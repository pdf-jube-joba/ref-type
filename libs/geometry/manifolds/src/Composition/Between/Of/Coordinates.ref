\import Composite.Coordinates[f := continuous, left := left, right := right] \as Direct;
\definition firstDomain[middle: MiddleChart]: Open.OpenSet := First.Coordinates[f := f, left := left, right := middle].domain;
\definition domains[middle: MiddleChart]: Open.OpenSet := Open.intersection (firstDomain middle) Direct.domain;
\definition included[middle: MiddleChart]: Open.Included (domains middle) Direct.domain := Open.intersectionRight (firstDomain middle) Direct.domain;
\module Patch(middle: MiddleChart);
\definition Covers: \Prop := \forall (x: Open.Carrier Direct.domain) -> \exists ( middle: MiddleChart \where \In[Reals.Multivariable[n := n].Point] ((domains middle).points) x );
\definition covers: Covers := \block {
  \fun (x: Open.Carrier Direct.domain) \then
  \takefrom middle: \Cast[MiddleCharts.Chart] ({ middle: MiddleCharts.Chart \where
    Logic.And[\In[MiddleCharts.Chart] N.atlas.charts middle, MiddleCharts.Contains middle (First.apply f (SourceCharts.point left (Direct.leftCoordinate x)))] })
    \by N.atlas.covers (First.apply f (SourceCharts.point left (Direct.leftCoordinate x))) \then
  \let witness: Logic.And[\In[MiddleCharts.Chart] N.atlas.charts middle, MiddleCharts.Contains middle (First.apply f (SourceCharts.point left (Direct.leftCoordinate x)))] :=
    \bysub(MiddleCharts.Chart, { middle: MiddleCharts.Chart \where
      Logic.And[\In[MiddleCharts.Chart] N.atlas.charts middle, MiddleCharts.Contains middle (First.apply f (SourceCharts.point left (Direct.leftCoordinate x)))] }, middle) \then
  \let chosen: MiddleChart := \into[MiddleCharts.Chart](middle, N.atlas.charts) \by { witness.left } \then
  \return Logic.existsIntro[MiddleChart, { middle: MiddleChart \where \In[Reals.Multivariable[n := n].Point] ((domains middle).points) x }] chosen
    (Patch[middle := chosen].contains x (witness.right))
};
\module Component(i: Fin.Fin l) {
  \import Open.SmoothCover[I := MiddleChart, U := Direct.domain, domains := domains, f := \fun (x: Open.Carrier Direct.domain) => Direct.apply x i] \as Cover;
  \definition regular: \In[SourceCharts.Chart] M.atlas.charts left -> \In[TargetCharts.Chart] P.atlas.charts right ->
    Smooth.SmoothOn Direct.domain (\fun (x: Open.Carrier Direct.domain) => Direct.apply x i) :=
    \fun (leftMember: \In[SourceCharts.Chart] M.atlas.charts left)(rightMember: \In[TargetCharts.Chart] P.atlas.charts right) =>
      Cover.smooth included covers (\fun (middle: MiddleChart) => \parent.Patch[middle := middle].regular leftMember rightMember i);
}
\definition regular: \In[SourceCharts.Chart] M.atlas.charts left -> \In[TargetCharts.Chart] P.atlas.charts right -> Direct.Smooth :=
  \fun (leftMember: \In[SourceCharts.Chart] M.atlas.charts left)(rightMember: \In[TargetCharts.Chart] P.atlas.charts right)(i: Fin.Fin l) =>
    Component[i := i].regular leftMember rightMember;
