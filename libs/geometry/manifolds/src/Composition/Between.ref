\import \root.SmoothMap[n := n, m := m].Between[M := M, N := N] \as First;
\import \root.SmoothMap[n := m, m := l].Between[M := N, N := P] \as Second;
\import \root.SmoothMap[n := n, m := l].Between[M := M, N := P] \as Composite;
\module Of(f: First.Map, g: Second.Map);

\definition compose(f: First.Map)(g: Second.Map): Composite.Map := Of[f := f, g := g].map;
\definition pointwise: \forall (f: First.Map)(g: Second.Map)(x: M.Point) -> Composite.apply (compose f g) x = Second.apply g (First.apply f x) :=
  \fun (f: First.Map)(g: Second.Map)(x: M.Point) => \refl(Second.apply g (First.apply f x));
