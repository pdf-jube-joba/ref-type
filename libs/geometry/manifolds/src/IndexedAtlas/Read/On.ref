/* A local lift through a coordinate parametrization. */
\structure Witness: \Set := {
  domain: Source.OpenSet,
  included: Source.Included domain U,
  contains: \In[calculus.Real[].Multivariable[n := d].Point] domain.points a,
  lift: Maps.Map domain p.image,
  agrees: \forall (x: Source.Carrier domain) -> value p (Maps.apply domain p.image lift x) =
    f (Source.inclusion domain U included x),
};
