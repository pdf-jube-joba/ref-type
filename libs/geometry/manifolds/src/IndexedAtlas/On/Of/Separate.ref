\import topology.Topology[Carrier := Parameter i] \as Parameters;
\definition leftPoint: Domain (patch i).domain := \into[A](x, (patch i).domain) \by { inLeft };
\definition rightPoint: Domain (patch i).domain := \into[A](y, (patch i).domain) \by { inRight };
\definition a: Parameter i := (patch i).coordinate leftPoint;
\definition b: Parameter i := (patch i).coordinate rightPoint;
\definition leftLaw: point i a = x := (patch i).pointCoordinate leftPoint;
\definition rightLaw: point i b = y := (patch i).pointCoordinate rightPoint;
\definition distinct: Logic.Not (a = b) := \fun (same: a = b) => different
  (trans!{A} _ _ _ (sym!{A} _ _ leftLaw) (trans!{A} _ _ _ (congr!{{Parameter i} A} (point i) _ _ same) rightLaw));
\definition hausdorff: Parameters.IsT2 (parameterTopology i) := Ambient.Subspace[S := (patch i).image.points].Properties[].hausdorff Euclidean.topology Euclidean.hausdorff;
\module Neighborhood(U: \Pow (Parameter i), left: Parameters.RegularChoice[parameterTopology i, Parameters.Singleton b, a, U]);
\definition neighborhood: \exists ( U: \Pow A \where Space.RegularChoice[topology, Space.Singleton y, x, U] ) := \block {
  \takefrom U: \Cast[\Pow (Parameter i)] ({ U: \Pow (Parameter i) \where Parameters.RegularChoice[parameterTopology i, Parameters.Singleton b, a, U] }) \by hausdorff a b distinct \then
  \return Neighborhood[U := U, left := \bysub(\Pow (Parameter i),
    { U: \Pow (Parameter i) \where Parameters.RegularChoice[parameterTopology i, Parameters.Singleton b, a, U] }, U)].exists
};
