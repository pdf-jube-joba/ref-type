\import topology.Maps[A := A, B := B].Separate[source := topology, target := baseSpace, f := projection,
  continuous := continuous, hausdorff := hausdorff] \as OverBase;
\definition separated: Space.IsT2 topology := \fun (p, q: A)(different: _) =>
  either!{{(Classical.excludedMiddle (projection p = projection q))}
    {\exists ( U: \Pow A \where Space.RegularChoice[topology, Space.Singleton q, p, U] )}
    {\fun (same: projection p = projection q) => \block {
      \takefrom i: \Cast[I] ({ i: I \where \In[B] (domains i) (projection p) }) \by laws.covers (projection p) \then
      \let inside: \In[B] (domains i) (projection p) := \bysub(I, { i: I \where \In[B] (domains i) (projection p) }, i) \then
      \let inOther: \In[B] (domains i) (projection q) := \idelim projection p = projection q \with x: B => \In[B] (domains i) x \by { base: inside, equality: same } \then
      \return \root.IndexedAtlas[n := n, A := A, I := I].On[family := family].Of[openEmbeddings := openEmbeddings].Separate[
        i := i, x := p, y := q, inLeft := laws.fiber i p inside, inRight := laws.fiber i q inOther, different := different].neighborhood
    }}
    {\fun (different: Logic.Not (projection p = projection q)) => OverBase.neighborhood p q different}
  };
