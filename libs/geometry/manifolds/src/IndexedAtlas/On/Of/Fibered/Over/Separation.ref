\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\module With(hausdorff: BaseTopology.IsT2 baseSpace, continuous: BaseContinuity.Continuous topology baseSpace projection);
\definition hausdorff: BaseTopology.IsT2 baseSpace -> BaseContinuity.Continuous topology baseSpace projection -> Space.IsT2 topology :=
  \fun (hausdorff: BaseTopology.IsT2 baseSpace)(continuous: BaseContinuity.Continuous topology baseSpace projection) => With[hausdorff := hausdorff, continuous := continuous].separated;
