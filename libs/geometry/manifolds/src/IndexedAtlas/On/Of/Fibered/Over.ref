\module Countability;
\definition secondCountable: BaseTopology.IsSecondCountable baseSpace -> Space.IsSecondCountable topology := Countability[].secondCountable;
\import topology.Continuity[A := A, B := B] \as BaseContinuity;
\module Separation;
\definition hausdorff: BaseTopology.IsT2 baseSpace -> BaseContinuity.Continuous topology baseSpace projection -> Space.IsT2 topology := Separation[].hausdorff;
