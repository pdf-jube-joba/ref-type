\definition covers: \forall (p: A) -> \exists ( j: N.Nat^ \where \In[A] (TotalCoordinates.optionalDomain (choices j)) p ) :=
  \fun (p: A) => Lindelof.indexedUnionElim selected (projection p)
    (\exists ( j: N.Nat^ \where \In[A] (TotalCoordinates.optionalDomain (choices j)) p ))
    (\fun (j: N.Nat^)(inside: \In[B] (selected j) (projection p)) =>
      Logic.existsIntro[N.Nat^, { j: N.Nat^ \where \In[A] (TotalCoordinates.optionalDomain (choices j)) p }] j
        (liftDomain (choices j) p (\idelim selected j = optionalDomain (choices j)
          \with U: \Pow B => \In[B] U (projection p) \by {
          base: inside, equality: sym!{\Pow B} _ _ (\bysub(Options.Option[I],
            { o: Options.Option[I] \where optionalDomain o = selected j }, choices j))
        }))) (laws.right (projection p) (\refl((projection p))));
\definition cover: TotalCoordinates.CountableCover := TotalCoordinates.CountableCover {
  index := \fun (j: N.Nat^) => choices j, covers := covers,
};
