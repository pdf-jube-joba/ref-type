\definition laws: Space.NormalPartner[topology, Space.Singleton y, Image i U, Image i V] :=
  Space.NormalPartner[topology, Space.Singleton y, Image i U, Image i V] {
    open := openEmbeddings i V right.open,
    covers := \fun (z: A)(same: z = y) => \idelim point i b = z \with t: A => \In[A] (Image i V) t \by {
      base: \parent.\parent.\parent.At[i := i].imageMember V b (right.covers b (\refl(b))),
      equality: trans!{A} _ _ _ rightLaw (sym!{A} _ _ same)
    },
    disjoint := \fun (z: A)(inU: _)(inV: _) => \parent.\parent.\parent.At[i := i].imageElim U z Logic.False
      (\fun (u: Parameter i)(um: _)(ue: point i u = z) => \parent.\parent.\parent.At[i := i].imageElim V z Logic.False
        (\fun (v: Parameter i)(vm: _)(ve: point i v = z) => right.disjoint u um
          (\idelim v = u \with w: Parameter i => \In[Parameter i] V w \by {
            base: vm, equality: pointInjective (patch i) v u (trans!{A} _ _ _ ve (sym!{A} _ _ ue))
          })) inV) inU,
  };
