\module Partner(V: \Pow (Parameter i), right: Parameters.NormalPartner[parameterTopology i, Parameters.Singleton b, U, V]);
\definition exists: \exists ( W: \Pow A \where Space.RegularChoice[topology, Space.Singleton y, x, W] ) := \block {
  \takefrom V: \Cast[\Pow (Parameter i)] ({ V: \Pow (Parameter i) \where Parameters.NormalPartner[parameterTopology i, Parameters.Singleton b, U, V] }) \by left.partner \then
  \return Logic.existsIntro[\Pow A, { W: \Pow A \where Space.RegularChoice[topology, Space.Singleton y, x, W] }] (Image i U)
    (Space.RegularChoice[topology, Space.Singleton y, x, Image i U] {
      open := openEmbeddings i U left.open,
      contains := \idelim point i a = x \with z: A => \In[A] (Image i U) z \by {
        base: \parent.\parent.At[i := i].imageMember U a left.contains, equality: leftLaw
      },
      partner := Logic.existsIntro[\Pow A, { W: \Pow A \where Space.NormalPartner[topology, Space.Singleton y, Image i U, W] }]
        (Image i V) (Partner[V := V, right := \bysub(\Pow (Parameter i),
          { V: \Pow (Parameter i) \where Parameters.NormalPartner[parameterTopology i, Parameters.Singleton b, U, V] }, V)].laws),
    })
};
