/* Countability and separation when each coordinate domain contains whole fibers. */
\import topology.Topology[Carrier := B] \as BaseTopology;
\structure Laws: \Prop := {
  open: \forall (i: I) -> BaseTopology.IsOpenIn baseSpace (domains i),
  covers: \forall (x: B) -> \exists ( i: I \where \In[B] (domains i) x ),
  fiber: \forall (i: I)(x: A) -> \In[B] (domains i) (projection x) -> \In[A] (patch i).domain x,
};
\module Over(laws: Laws);
