\import \parent.\parent.\parent.\parent.Read[d := n].On[p := patch i, U := (patch j).image, f := point j, a := Transition.leftCoordinate a] \as Reads;
\module WithLift(witness: Reads.Witness);
\module Component(k: std.Data[].FinSet[].Fin n) {
  \import Open.LocalSmooth[U := Transition.domain, f := \fun (x: Open.Carrier Transition.domain) => Transition.apply x k] \as Local;
  \definition exists: \exists \Cast[Local.Patch] (Local.Patches a) := \block {
    \takefrom witness: Reads.Witness \by transitions i j (Transition.leftCoordinate a) (Transition.inRightDomain a) \then
    \return \exact(\into[Local.Patch](\parent.WithLift[witness := witness].Component[k := k].patch, Local.Patches a) \by {
      Logic.And[_, _]::# (\bysub(std.Data[].FinSet[].Fin n -> real.Analysis[].Real, Transition.domain.points, a)) witness.contains
    }, \Cast[Local.Patch] (Local.Patches a))
  };
}
\definition localSmooth: \forall (k: std.Data[].FinSet[].Fin n) ->
  \exists \Cast[Open.LocalSmooth[U := Transition.domain, f := \fun (x: Open.Carrier Transition.domain) => Transition.apply x k].Patch]
    (Open.LocalSmooth[U := Transition.domain, f := \fun (x: Open.Carrier Transition.domain) => Transition.apply x k].Patches a) :=
  \fun (k: std.Data[].FinSet[].Fin n) => Component[k := k].exists;
