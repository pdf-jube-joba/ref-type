\import \root.Dimension[n := n].Chart[M := A, space := topology] \as Charts;
\import \root.Dimension[n := n].Topological[] \as Topological;
\module At(i: I);
\definition chart[i: I]: Charts.Chart := At[i := i].chart;
\definition charts: \Pow Charts.Chart := { c: Charts.Chart \where \exists ( i: I \where c = chart i ) };
\import \root.Dimension[n := n].Atlas[M := A, space := topology] \as Atlases;
\definition Covers: \forall (x: A) -> \exists ( c: Charts.Chart \where Logic.And[\In[Charts.Chart] charts c, Charts.Contains c x] ) := \block {
  \fun (x: A) \then
  \takefrom i: \Cast[I] ({ i: I \where \In[A] ((patch i).domain) x }) \by family.covers x \then
  \return Logic.existsIntro[Charts.Chart, { c: Charts.Chart \where Logic.And[\In[Charts.Chart] charts c, Charts.Contains c x] }] (chart i)
    (Logic.And[_, _]::# (Logic.existsIntro[I, { j: I \where chart i = chart j }] i (\refl(chart i)))
      (\bysub(I, { i: I \where \In[A] ((patch i).domain) x }, i)))
};
\definition SmoothChanges: \Prop := \forall (i, j: I) -> Atlases.Compatible (chart i) (chart j);
\module Smooth(changes: SmoothChanges);

\import std.Data[].Option[] \as Options;
\definition optionalDomain: Options.Option[I] -> \Pow A :=
  \induction (index: Options.Option[I]) \return \Pow A \with {
    | none: Space.Empty
    | some: \fun (i: I) => (patch i).domain
  };
\structure CountableCover: \Set := {
  index: N.Nat^ -> Options.Option[I],
  covers: \forall (x: A) -> \exists ( j: N.Nat^ \where \In[A] (optionalDomain (index j)) x ),
};
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as Euclidean;
\import topological_algebra.Euclidean[].Dimension[n := n].Countability[] \as EuclideanBasis;
\import topology.Topology[Carrier := std.Data[].FinSet[].Fin n -> real.Analysis[].Real] \as Ambient;
\definition LocalBasis[i: I]: \Set := \Cast[N.Nat^ -> \Pow (Parameter i)]
  ({ b: N.Nat^ -> \Pow (Parameter i) \where topology.Topology[Carrier := Parameter i].IsCountableBasis[parameterTopology i, b] });
\definition basisExists: \forall (i: I) -> \exists LocalBasis i := \fun (i: I) =>
  Ambient.Subspace[S := (patch i).image.points].Properties[].secondCountable Euclidean.topology EuclideanBasis.secondCountable;
\module Countability(cover: CountableCover, bases: \forall (i: I) -> LocalBasis i);
\definition secondCountable: \forall (cover: CountableCover) -> Space.IsSecondCountable topology := \block {
  \fun (cover: CountableCover) \then
  \takefrom bases: (\forall (i: I) -> LocalBasis i) \by \axiom:classicalIndefiniteChoice(I,
    (\fun (i: I) => LocalBasis i), basisExists) \then
  \return Countability[cover := cover, bases := bases].secondCountable
};
\module Separate(i: I, x, y: A, inLeft: \In[A] (patch i).domain x, inRight: \In[A] (patch i).domain y, different: Logic.Not (x = y));
\module Fibered(B: \Set, baseSpace: topology.Structures[].Topology[B], projection: A -> B, domains: I -> \Pow B);
