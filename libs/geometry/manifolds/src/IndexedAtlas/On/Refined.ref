\module Image(i, j: I, W: \Pow (Parameter i), openW: topology.Topology[Carrier := Parameter i].IsOpenIn (parameterTopology i) W);
\definition openEmbeddings: OpenEmbeddings := \fun (i: I)(W: \Pow (Parameter i))(openW: _)(j: I) =>
  Image[i := i, j := j, W := W, openW := openW].open;
\import \parent.Of[openEmbeddings := openEmbeddings] \as Construction;
\import \root.Dimension[n := n].Chart[M := A, space := topology] \as Charts;
\import \root.Dimension[n := n].Atlas[M := A, space := topology] \as Atlases;
\module Pair(i, j: I);
\definition smoothChanges: Construction.SmoothChanges := \fun (i, j: I) => Pair[i := j, j := i].compatible;
\import Construction.Smooth[changes := smoothChanges] \as SmoothConstruction;
\import \root.Dimension[n := n].Smooth[] \as Model;
\definition manifold[hausdorff: Space.IsT2 topology][secondCountable: Space.IsSecondCountable topology]: Model.Manifold := SmoothConstruction.manifold hausdorff secondCountable;
