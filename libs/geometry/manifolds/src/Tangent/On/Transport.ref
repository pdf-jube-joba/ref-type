\import std.Logic[].Equality[].Transport[A := M.Point] \as EqualityTransport;
\definition ChartFamily[p: M.Point]: \Set := \parent.At[x := p].Chart;
\definition chart[c: ChartFamily x]: ChartFamily y := EqualityTransport.cast ChartFamily x y same c;
\definition vector[v: Vector x]: Vector y := EqualityTransport.cast Vector x y same v;
\definition decode[p: M.Point][c: ChartFamily p][v: Vector p]: Vectors.Vector := \parent.At[x := p].Coordinate[chart := c].decode v;
\definition coordinates: \forall (c: ChartFamily x)(v: Vector x) -> decode y (chart c) (vector v) = decode x c v :=
  (\idelim x = y \with p: M.Point => \forall (equal: x = p)(c: ChartFamily x)(v: Vector x) ->
    decode p (EqualityTransport.cast ChartFamily x p equal c) (EqualityTransport.cast Vector x p equal v) = decode x c v \by {
      base: \fun (equal: x = x)(c: ChartFamily x)(v: Vector x) =>
        congr!{{ChartFamily x} {Vector x} {Vectors.Vector}} (decode x) _ _ _ _
          (EqualityTransport.castRefl ChartFamily x c) (EqualityTransport.castRefl Vector x v),
      equality: same
    }) same;
\definition underlying: \forall (c: ChartFamily x) -> chart c = c :=
  (\idelim x = y \with p: M.Point => \forall (equal: x = p)(c: ChartFamily x) ->
    EqualityTransport.cast ChartFamily x p equal c = c \by {
      base: \fun (equal: x = x)(c: ChartFamily x) => EqualityTransport.castRefl ChartFamily x c,
      equality: same
    }) same;
