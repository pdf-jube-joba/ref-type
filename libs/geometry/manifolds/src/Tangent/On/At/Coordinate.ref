\import Quotient.Maps[B := Vectors.Vector] \as Descend;
\definition ofRepresentative(v: Representative): Vectors.Vector := transform v.chart chart v.vector;
\definition respects: Descend.Respects ofRepresentative :=
  \fun (u, v: Representative)(equal: Equivalent u v) => trans!{{Vectors.Vector}} _ _ _
      (composition u.chart v.chart chart u.vector)
      (congr!{{Vectors.Vector} {Vectors.Vector}} (transform v.chart chart) (transform u.chart v.chart u.vector) v.vector (sym!{{Vectors.Vector}} v.vector (transform u.chart v.chart u.vector) equal));
\definition decode(v: Vector): Vectors.Vector := Descend.value Equivalence.equivalence ofRepresentative respects v;
\definition encode(v: Vectors.Vector): Vector := classOf chart v;
\definition decodeClass: \forall (v: Representative) -> decode (Quotient.class v) = ofRepresentative v := Descend.onClass Equivalence.equivalence ofRepresentative respects;
\definition decodeEncode: \forall (v: Vectors.Vector) -> decode (encode v) = v :=
  \fun (v: Vectors.Vector) => trans!{{Vectors.Vector}} (decode (encode v)) (transform chart chart v) v
    (decodeClass (Representative { chart := chart, vector := v })) (identity chart v);
\definition encodeDecode: \forall (v: Vector) -> encode (decode v) = v := Quotient.induction (\fun (v: Vector) => encode (decode v) = v)
  (\fun (v: Representative) => trans!{Vector} (encode (decode (Quotient.class v))) (classOf chart (ofRepresentative v)) (Quotient.class v)
    (congr!{{Vectors.Vector} Vector} encode (decode (Quotient.class v)) (ofRepresentative v) (decodeClass v))
    (sym!{Vector} (Quotient.class v) (classOf chart (ofRepresentative v))
      (Quotient.classOfEq Equivalence.equivalence v (Representative { chart := chart, vector := ofRepresentative v }) (\refl(ofRepresentative v)))));
\definition injective: \forall (u, v: Vector) -> decode u = decode v -> u = v :=
  \fun (u, v: Vector)(equal: decode u = decode v) => trans!{Vector} u (encode (decode u)) v
    (sym!{Vector} (encode (decode u)) u (encodeDecode u)) (trans!{Vector} (encode (decode u)) (encode (decode v)) v (congr!{{Vectors.Vector} Vector} encode (decode u) (decode v) equal) (encodeDecode v));
