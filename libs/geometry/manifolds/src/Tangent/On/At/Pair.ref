\import Charts.Transition[left := left, right := right] \as Transition;
\import \root.Dimension[n := n].Atlas[M := M.Point, space := M.space].Pair[left := left, right := right] \as Smooth;
\import Charts.Of[chart := left] \as LeftGeometry;
\definition compatible: Smooth.Compatible := M.atlas.compatible left right (member left) (member right);
\definition map: Maps.Map Transition.domain right.image := Smooth.smoothMap compatible;
\definition point: Open.Carrier Transition.domain := Transition.commonPoint (localPoint left) (contains right);
\definition jacobian: Linear.Map := Maps.Differential[U := Transition.domain, V := right.image, f := map, a := point].value;
\definition coordinateAgreement: Maps.apply Transition.domain right.image map point = coordinate right :=
  congr!{{Charts.LocalPoint right} {Open.Carrier right.image}} (Charts.coordinate right) (Transition.overlapPoint point) (localPoint right)
    (LeftGeometry.pointCoordinate (localPoint left));
\definition valueAt[a: Open.Carrier Transition.domain]: Linear.Map := Maps.Differential[U := Transition.domain, V := right.image, f := map, a := a].value;
