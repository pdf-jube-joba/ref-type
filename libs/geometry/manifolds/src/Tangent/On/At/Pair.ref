\import Charts.Transition[left := left, right := right] \as Transition;
\import \root.Dimension[n := n].Atlas[M := M.Point, space := M.space].Pair[left := left, right := right] \as Smooth;
\import Charts.Of[chart := left] \as LeftGeometry;
\definition compatible: Smooth.Compatible := #compatible{M.atlas} left right (member left) (member right);
\definition map: Maps.Map Transition.domain #image{right} := Smooth.smoothMap compatible;
\definition point: Open.Carrier Transition.domain := Transition.commonPoint (localPoint left) (contains right);
\definition jacobian: Linear.Map := Maps.Differential[U := Transition.domain, V := #image{right}, f := map, a := point].value;
\definition coordinateAgreement: Maps.apply Transition.domain #image{right} map point = coordinate right :=
  congr!{{Charts.LocalPoint right} {Open.Carrier #image{right}}} (Charts.coordinate right) (Transition.overlapPoint point) (localPoint right)
    (LeftGeometry.pointCoordinate (localPoint left));
\definition valueAt(a: Open.Carrier Transition.domain): Linear.Map := Maps.Differential[U := Transition.domain, V := #image{right}, f := map, a := a].value;
