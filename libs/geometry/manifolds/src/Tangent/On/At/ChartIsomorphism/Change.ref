\import \parent.\parent.Coordinate[chart := other] \as Other;
\definition coordinates: \forall (v: Vector) -> Other.decode v = transform chart other (Coordinate.decode v) :=
  Quotient.induction (\fun (v: Vector) => Other.decode v = transform chart other (Coordinate.decode v))
    (\fun (v: Representative) => eq_reason!{
      {Other.decode (Quotient.class v)} "=" {transform #chart{v} other #vector{v}} "by" {Other.decodeClass v}
      "=" {transform chart other (transform #chart{v} chart #vector{v})} "by" {composition #chart{v} chart other #vector{v}}
      "=" {transform chart other (Coordinate.decode (Quotient.class v))} "by" {congr!{{Vectors.Vector} {Vectors.Vector}} (transform chart other) _ _ (sym!{{Vectors.Vector}} _ _ (Coordinate.decodeClass v))}
    });
