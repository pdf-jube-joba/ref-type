
\import Spaces.Dual[V := Vector, source := space] \as Covectors;
\import Spaces.Dual[V := Vectors.Vector, source := Vectors.space] \as CoordinateCovectors;
\import \parent.ChartIsomorphism[chart := chart] \as Coordinates;
\import \parent.Coordinate[chart := chart] \as Coordinate;
\import Covectors.Precomposition[W := Vectors.Vector, target := Vectors.space] \as Encode;
\import CoordinateCovectors.Precomposition[W := Vector, target := space] \as Decode;
\import Spaces.Isomorphism[V := Covectors.Carrier, W := CoordinateCovectors.Carrier, source := Covectors.space, target := CoordinateCovectors.space] \as Iso;
\definition forward: Spaces.Linear[V := Covectors.Carrier, W := CoordinateCovectors.Carrier, source := Covectors.space, target := CoordinateCovectors.space].Map := Decode.map Coordinates.backward;
\definition backward: Spaces.Linear[V := CoordinateCovectors.Carrier, W := Covectors.Carrier, source := CoordinateCovectors.space, target := Covectors.space].Map := Encode.map Coordinates.forward;
\definition leftInverse: \forall (f: Covectors.Carrier) -> #apply{backward} (#apply{forward} f) = f :=
  \fun (f: Covectors.Carrier) => Covectors.ext (#apply{backward} (#apply{forward} f)) f
    (\fun (v: Vector) => congr!{{Vector} {Real.Real}} f (Coordinate.encode (Coordinate.decode v)) v (Coordinate.encodeDecode v));
\definition rightInverse: \forall (f: CoordinateCovectors.Carrier) -> #apply{forward} (#apply{backward} f) = f :=
  \fun (f: CoordinateCovectors.Carrier) => CoordinateCovectors.ext (#apply{forward} (#apply{backward} f)) f
    (\fun (v: Vectors.Vector) => congr!{{Vectors.Vector} {Real.Real}} f (Coordinate.decode (Coordinate.encode v)) v (Coordinate.decodeEncode v));
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism { forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse };
