\definition add[u, v: Representative]: Representative := Representative {
  chart := u.chart, vector := Vectors.plus u.vector (transform v.chart u.chart v.vector),
};
\definition scale[c: Real.Real][v: Representative]: Representative := Representative { chart := v.chart, vector := Vectors.scale c v.vector };
\definition zero[chart: Chart]: Representative := Representative { chart := chart, vector := Vectors.origin };
\definition addRespects: Quotient.BinaryRespects add :=
  \fun (x, y, u, v: Representative)(first: Equivalent x y)(second: Equivalent u v) => eq_reason!{
    {Vectors.plus y.vector (transform v.chart y.chart v.vector)}
    "=" {Vectors.plus (transform x.chart y.chart x.vector) (transform v.chart y.chart (transform u.chart v.chart u.vector))} "by" {
      congr!{{Vectors.Vector} {Vectors.Vector} {Vectors.Vector}} Vectors.plus _ _ _ _ first
        (congr!{{Vectors.Vector} {Vectors.Vector}} (transform v.chart y.chart) _ _ second)}
    "=" {Vectors.plus (transform x.chart y.chart x.vector) (transform u.chart y.chart u.vector)} "by" {
      congr!{{Vectors.Vector} {Vectors.Vector}} (Vectors.plus (transform x.chart y.chart x.vector)) _ _
        (sym!{{Vectors.Vector}} _ _ (composition u.chart v.chart y.chart u.vector))}
    "=" {Vectors.plus (transform x.chart y.chart x.vector) (transform x.chart y.chart (transform u.chart x.chart u.vector))} "by" {
      congr!{{Vectors.Vector} {Vectors.Vector}} (Vectors.plus (transform x.chart y.chart x.vector)) _ _
        (composition u.chart x.chart y.chart u.vector)}
    "=" {transform x.chart y.chart (Vectors.plus x.vector (transform u.chart x.chart u.vector))} "by" {
      sym!{{Vectors.Vector}} _ _ ((jacobian x.chart y.chart).preservesAdd x.vector (transform u.chart x.chart u.vector))}
  };
\definition scaleRespects: \forall (c: Real.Real) -> Quotient.UnaryRespects (scale c) :=
  \fun (c: Real.Real)(u, v: Representative)(equal: Equivalent u v) => trans!{{Vectors.Vector}} _ _ _
      (congr!{{Vectors.Vector} {Vectors.Vector}} (Vectors.scale c) _ _ equal)
      (sym!{{Vectors.Vector}} _ _ ((jacobian u.chart v.chart).preservesScale c u.vector));
\definition zeroRelated: \forall (left, right: Chart) -> Equivalent (zero left) (zero right) :=
  \fun (left, right: Chart) => sym!{{Vectors.Vector}} _ _ (jacobian left right).preservesZero;
