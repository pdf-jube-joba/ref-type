\import Maps.Coordinates[f := continuous, left := Source.standard, right := right] \as Direct;
\import Charts.Transition[left := chart, right := right] \as Transition;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import Open.Restriction[] \as Restriction;
\definition included: Open.Included Direct.domain Transition.domain := \fun (x: topological_algebra.Euclidean[].Dimension[n := n].Point)(member: _) => \block {
  \let p: Open.Carrier Direct.domain := \into[topological_algebra.Euclidean[].Dimension[n := n].Point](x, Direct.domain.points) \by { member } \then
  \return Transition.intro (Direct.leftCoordinate p) (Direct.inRightDomain p)
};
\definition smooth: Atlases.Member M.atlas right -> Direct.Smooth :=
  \fun (rightMember: _)(i: std.Data[].FinSet[].Fin n) => Restriction.localSmooth Direct.domain Transition.domain included
    (\fun (x: Open.Carrier Transition.domain) => Transition.apply x i)
    (M.atlas.compatible chart right (\bysub(Charts.Chart, M.atlas.charts, chart)) rightMember i);
