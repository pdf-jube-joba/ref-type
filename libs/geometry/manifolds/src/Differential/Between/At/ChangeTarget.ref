\import \parent.InCharts[left := left, right := before] \as Before;
\import \parent.InCharts[left := left, right := after] \as After;
\import \root.SelfMap[n := m].Identity[M := N] \as Identity;
\import \root.Composition[n := n, m := m, l := m].Between[M := M, N := N, P := N].Of[f := f, g := Identity.map] \as Composition;
\definition sourceChart: Composition.SourceChart := \into[SourceCharts.Chart](left, M.atlas.charts) \by { Domain.member left };
\definition middleChart: Composition.MiddleChart := \into[TargetCharts.Chart](before, N.atlas.charts) \by { Codomain.member before };
\definition targetChart: Composition.TargetChart := \into[TargetCharts.Chart](after, N.atlas.charts) \by { Codomain.member after };
\import \root.CompositionDifferential[n := n, m := m, l := m].Between[M := M, N := N, P := N].Of[f := f, g := Identity.map].InCharts[left := sourceChart, middle := middleChart, right := targetChart] \as CompositionData;
\import Composition.Coordinates[left := left, right := after].Patch[middle := middleChart] \as Patch;
\definition point: Open.Carrier CompositionData.domain :=
  \into[SourceVectors.Vector](Domain.coordinate left, CompositionData.domain.points) \by {
    Patch.contains After.point Before.containsImage
  };
\import CompositionData.At[a := point] \as Chain;
\import Codomain.Pair[left := before, right := after] \as TargetChange;
\import TargetCharts.Transition[left := before, right := after] \as TargetTransition;
\import calculus.Real[].Multivariable[n := m].Open[] \as TargetOpen;
\import calculus.Maps[n := m, m := m] \as TargetMaps;
\import Spaces.Linear[V := TargetVectors.Vector, W := TargetVectors.Vector, source := TargetVectors.space, target := TargetVectors.space] \as End;
\definition intermediate: TargetOpen.Carrier TargetTransition.domain := Patch.intermediate point;
\definition pointAgreement: intermediate = TargetChange.point := Before.coordinateAgreement;
\definition secondAgreement: TargetMaps.Differential[U := TargetTransition.domain, V := after.image,
  f := CompositionData.secondMap, a := intermediate].value = Codomain.jacobian before after :=
    congr!{{TargetOpen.Carrier TargetTransition.domain} {End.Map}} TargetChange.valueAt
      intermediate TargetChange.point pointAgreement;
\import Spaces.Linear[V := SourceVectors.Vector, W := TargetVectors.Vector, source := SourceVectors.space, target := TargetVectors.space] \as Jacobians;
\import End.Composition[U := SourceVectors.Vector, domain := SourceVectors.space] \as Compose;
\definition jacobian: After.jacobian = Compose.compose (Codomain.jacobian before after) Before.jacobian :=
  trans!{{Jacobians.Map}} _ _ _
    Chain.law
    (congr!{{End.Map} {Jacobians.Map}} (\fun (d: End.Map) => Compose.compose d Before.jacobian)
      _ _ secondAgreement);
\import Codomain.Coordinate[chart := after] \as Coordinates;
\import Codomain.ChartIsomorphism[chart := before].Change[other := after] \as Changes;
\definition coordinateEquality: \forall (v: Domain.Vector) ->
  Coordinates.decode (After.value.apply v) = Coordinates.decode (Before.value.apply v) :=
    \fun (v: Domain.Vector) => trans!{{TargetVectors.Vector}}
      _ _ _
      (trans!{{TargetVectors.Vector}} _ _ _
        (After.coordinateLaw v)
        (congr!{{Jacobians.Map} {TargetVectors.Vector}}
          (\fun (d: Jacobians.Map) => d.apply (Domain.Coordinate[chart := left].decode v)) _ _ jacobian))
      (sym!{{TargetVectors.Vector}} _ _
        (trans!{{TargetVectors.Vector}} _ _ _
          (Changes.coordinates (Before.value.apply v))
          (congr!{{TargetVectors.Vector} {TargetVectors.Vector}} (Codomain.transform before after) _ _ (Before.coordinateLaw v))));
\definition law: After.value = Before.value := Linear.ext After.value Before.value
  (\axiom:funext((After.value.apply), (Before.value.apply),
    \fun (v: Domain.Vector) => Coordinates.injective (After.value.apply v) (Before.value.apply v) (coordinateEquality v)));
