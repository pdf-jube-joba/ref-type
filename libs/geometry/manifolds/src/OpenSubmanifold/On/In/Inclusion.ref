\import \root.SmoothMap[n := n, m := n].Between[M := manifold, N := M] \as Maps;
\import topology.Continuity[A := Point, B := M.Point].Corestriction[S := U] \as Topology;
\definition data: Maps.Data := Maps.Data { apply := \fun (x: Point) => x };
\definition continuous: Maps.ContinuousMap := \into[Maps.Data](data, { f: Maps.Data \where Maps.Continuous f }) \by {
  Topology.inclusionContinuous M.space
};
\module Coordinates(left: Charts.Chart, right: Original.Chart);
\definition regular: Maps.Chartwise continuous :=
  \fun (left: Charts.Chart)(right: Original.Chart) => Coordinates[left := left, right := right].regular;
\definition map: Maps.Map := \into[Maps.ContinuousMap](continuous, { f: Maps.ContinuousMap \where Maps.Chartwise f }) \by { regular };
\definition pointwise: \forall (x: Point) -> Maps.apply map x = x := \fun (x: Point) => \refl(x);
\module Differential;
