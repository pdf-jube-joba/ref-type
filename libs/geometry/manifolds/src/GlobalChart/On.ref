\import \root.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\import \root.Dimension[n := n].Atlas[M := M.Point, space := M.space] \as Atlases;
\definition Chart: \Set := \Cast[Charts.Chart] M.atlas.charts;
\module At(chart: Chart, contains: \forall (x: M.Point) -> Charts.Contains chart x);
