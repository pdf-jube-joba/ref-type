\import Maps.Coordinates[f := continuous, left := left, right := Target.standard] \as Direct;
\import Charts.Transition[left := left, right := chart] \as Transition;
\definition included: Open.Included Direct.domain Transition.domain := \fun (x: calculus.Real[].Multivariable[n := n].Point)(member: _) => \block {
  \let u: Open.Carrier Direct.domain := \into[calculus.Real[].Multivariable[n := n].Point](x, Direct.domain.points) \by { member } \then
  \return Transition.intro (Direct.leftCoordinate u) (contains (Charts.point left (Direct.leftCoordinate u)))
};
\definition smooth: Direct.Smooth := \fun (i: std.Data[].FinSet[].Fin n) => Open.Restriction[].localSmooth Direct.domain Transition.domain included
  (\fun (u: Open.Carrier Transition.domain) => Transition.apply u i)
  (M.atlas.compatible left chart (\bysub(Charts.Chart, M.atlas.charts, left)) (\bysub(Charts.Chart, M.atlas.charts, chart)) i);
