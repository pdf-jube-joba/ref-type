\definition SourceChart: \Set := \Cast[SourceCharts.Chart] (#charts{source});
\definition TargetChart: \Set := \Cast[TargetCharts.Chart] (#charts{target});
\definition sourceMember(c: SourceChart): SourceAtlases.Member M.atlas c :=
  (\bysub(SourceAtlases.Atlas, SourceAtlas, source)) c (\bysub(SourceCharts.Chart, #charts{source}, c));
\definition targetMember(c: TargetChart): TargetAtlases.Member N.atlas c :=
  (\bysub(TargetAtlases.Atlas, TargetAtlas, target)) c (\bysub(TargetCharts.Chart, #charts{target}, c));
\structure Patch: \Set {
  left: SourceChart,
  right: TargetChart,
}
\module Of(f: Maps.ContinuousMap);
