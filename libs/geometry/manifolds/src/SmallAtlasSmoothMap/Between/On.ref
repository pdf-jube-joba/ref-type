\definition SourceChart: \Set := \Cast[SourceCharts.Chart] (source.charts);
\definition TargetChart: \Set := \Cast[TargetCharts.Chart] (target.charts);
\definition sourceMember[c: SourceChart]: SourceAtlases.Member M.atlas c :=
  (\bysub(SourceAtlases.Atlas, SourceAtlas, source)) c (\bysub(SourceCharts.Chart, source.charts, c));
\definition targetMember[c: TargetChart]: TargetAtlases.Member N.atlas c :=
  (\bysub(TargetAtlases.Atlas, TargetAtlas, target)) c (\bysub(TargetCharts.Chart, target.charts, c));
\structure Patch: \Set := {
  left: SourceChart,
  right: TargetChart,
};
\module Of(f: Maps.ContinuousMap);
