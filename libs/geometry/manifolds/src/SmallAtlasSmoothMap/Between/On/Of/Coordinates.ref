\import Maps.Coordinates[f := f, left := left, right := right] \as Direct;
\definition domains(p: Patch): Open.OpenSet := Open.intersection
  (Open.intersection Direct.domain SourceCharts.Transition[left := left, right := p.left].domain)
  Maps.Coordinates[f := f, left := left, right := p.right].domain;
\definition included(p: Patch): Open.Included (domains p) Direct.domain :=
  \fun (a: calculus.Real[].Multivariable[n := n].Point)(member: \In[calculus.Real[].Multivariable[n := n].Point] ((domains p).points) a) => (member.left).left;
\module InPatch(p: Patch);
\definition Covers: \Prop := \forall (a: Open.Carrier Direct.domain) ->
  \exists { p: Patch \where \In[calculus.Real[].Multivariable[n := n].Point] ((domains p).points) a };
\definition covers: Covers := \block {
  \fun (a: Open.Carrier Direct.domain) \then
  \let x: M.Point := SourceCharts.point left (Direct.leftCoordinate a) \then
  \takefrom s: \Cast[SourceCharts.Chart] ({ c: SourceCharts.Chart \where Logic.And[SourceAtlases.Member source c, SourceCharts.Contains c x] }) \by source.covers x \then
  \takefrom t: \Cast[TargetCharts.Chart] ({ c: TargetCharts.Chart \where Logic.And[TargetAtlases.Member target c, TargetCharts.Contains c (f.apply x)] }) \by target.covers (f.apply x) \then
  \let slaw: Logic.And[SourceAtlases.Member source s, SourceCharts.Contains s x] := \bysub(SourceCharts.Chart,
    { c: SourceCharts.Chart \where Logic.And[SourceAtlases.Member source c, SourceCharts.Contains c x] }, s) \then
  \let tlaw: Logic.And[TargetAtlases.Member target t, TargetCharts.Contains t (f.apply x)] := \bysub(TargetCharts.Chart,
    { c: TargetCharts.Chart \where Logic.And[TargetAtlases.Member target c, TargetCharts.Contains c (f.apply x)] }, t) \then
  \let p: Patch := Patch { left := \into[SourceCharts.Chart](s, source.charts) \by { slaw.left },
    right := \into[TargetCharts.Chart](t, target.charts) \by { tlaw.left } } \then
  \let directMember: \In[calculus.Real[].Multivariable[n := n].Point] (Direct.domain.points) a :=
    \bysub(calculus.Real[].Multivariable[n := n].Point, Direct.domain.points, a) \then
  \let sourceMember: \In[calculus.Real[].Multivariable[n := n].Point] ((SourceCharts.Transition[left := left, right := p.left].domain).points) a :=
    SourceCharts.Transition[left := left, right := p.left].intro (Direct.leftCoordinate a) (slaw.right) \then
  \let targetMember: \In[calculus.Real[].Multivariable[n := n].Point] ((Maps.Coordinates[f := f, left := left, right := p.right].domain).points) a :=
    Maps.Coordinates[f := f, left := left, right := p.right].intro (Direct.leftCoordinate a) (tlaw.right) \then
  \return Logic.existsIntro[Patch, { p: Patch \where \In[calculus.Real[].Multivariable[n := n].Point] ((domains p).points) a }] p
    (Logic.And[
      Logic.And[\In[calculus.Real[].Multivariable[n := n].Point] (Direct.domain.points) a,
        \In[calculus.Real[].Multivariable[n := n].Point] ((SourceCharts.Transition[left := left, right := p.left].domain).points) a],
      \In[calculus.Real[].Multivariable[n := n].Point] ((Maps.Coordinates[f := f, left := left, right := p.right].domain).points) a]::#
      (Logic.And[\In[calculus.Real[].Multivariable[n := n].Point] (Direct.domain.points) a,
        \In[calculus.Real[].Multivariable[n := n].Point] ((SourceCharts.Transition[left := left, right := p.left].domain).points) a]::# directMember sourceMember)
      targetMember)
};
\module Component(i: Fin.Fin m) {
  \import Open.SmoothCover[I := Patch, U := Direct.domain, domains := domains, f := \fun (a: Open.Carrier Direct.domain) => Direct.apply a i] \as Cover;
  \definition regular: InSmallAtlas -> SourceAtlases.Member M.atlas left -> TargetAtlases.Member N.atlas right ->
    Smooth.SmoothOn Direct.domain (\fun (a: Open.Carrier Direct.domain) => Direct.apply a i) :=
      \fun (condition: InSmallAtlas)(leftMember: SourceAtlases.Member M.atlas left)(rightMember: TargetAtlases.Member N.atlas right) =>
        Cover.smooth included covers (\fun (p: Patch) => \parent.InPatch[p := p].regular condition leftMember rightMember i);
}
\definition regular: InSmallAtlas -> SourceAtlases.Member M.atlas left -> TargetAtlases.Member N.atlas right -> Direct.Smooth :=
  \fun (condition: InSmallAtlas)(leftMember: SourceAtlases.Member M.atlas left)(rightMember: TargetAtlases.Member N.atlas right)(i: Fin.Fin m) =>
    Component[i := i].regular condition leftMember rightMember;
