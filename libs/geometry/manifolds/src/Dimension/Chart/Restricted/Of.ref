\import Source.Subspace[S := chart.domain] \as OldDomain;
\import topology.Topology[Carrier := LocalPoint chart] \as OldDomainTopology;
\import topology.Topology[Carrier := Open.Carrier chart.image] \as OldImageTopology;
\import topology.Topology[Carrier := Coordinates.Point] \as Ambient;
\import Ambient.Subspace[S := (chart.image).points].Open[] \as OpenImage;
\import topology.Continuity[A := Open.Carrier chart.image, B := LocalPoint chart] \as Inverse;
\import topology.Homeomorphism[A := LocalPoint chart, B := Open.Carrier chart.image] \as Homeomorphisms;
\import \parent.\parent.Of[chart := chart] \as Geometry;
\definition domains: \Pow Point := Subspace.Trace chart.domain;
\definition overlap: \Pow (Open.Carrier chart.image) := Inverse.Preimage (point chart) (OldDomain.Trace U);
\definition openU: Source.IsOpenIn space U := \bysub(\Pow M, OpenSubset, U);
\definition overlapOpen: OldImageTopology.IsOpenIn (imageTopology chart.image) overlap :=
  (Homeomorphisms.laws (domainTopology chart.domain) (imageTopology chart.image) chart.coordinates).backwardContinuous
    (OldDomain.Trace U) (OldDomain.traceOpen space U openU);
\definition points: \Pow Coordinates.Point := OpenImage.image overlap;
\definition pointsOpen: Ambient.IsOpenIn Euclidean.topology points :=
  OpenImage.imageOpen Euclidean.topology (OpenTopology.open chart.image) overlap overlapOpen;
\definition image: Open.OpenSet := OpenTopology.ofOpen points pointsOpen;
\definition Domain: \Set := Charts.Domain domains;
\definition oldPoint(x: Domain): LocalPoint chart :=
  \into[M](x, chart.domain) \by { \bysub(Point, domains, x) };
\definition oldCoordinate(x: Open.Carrier image): Open.Carrier chart.image :=
  \into[Coordinates.Point](x, (chart.image).points) \by { OpenImage.imageIncluded overlap x (\bysub(Coordinates.Point, points, x)) };
\definition forwardMember: \forall (x: Domain) -> \In[Coordinates.Point] points (coordinate chart (oldPoint x)) :=
  \fun (x: Domain) => OpenImage.imageMember overlap (coordinate chart (oldPoint x))
    (\idelim oldPoint x = point chart (coordinate chart (oldPoint x)) \with y: LocalPoint chart => \In[M] U y \by {
      base: \bysub(M, U, x),
      equality: sym!{{LocalPoint chart}} (point chart (coordinate chart (oldPoint x))) (oldPoint x) (Geometry.pointCoordinate (oldPoint x))
    });
\definition forward(x: Domain): Open.Carrier image :=
  \into[Coordinates.Point](coordinate chart (oldPoint x), points) \by { forwardMember x };
\definition backwardMember: \forall (x: Open.Carrier image) -> \In[M] U (point chart (oldCoordinate x)) :=
  \fun (x: Open.Carrier image) => OpenImage.imageElim overlap x (\In[M] U (point chart (oldCoordinate x)))
    (\fun (y: Open.Carrier chart.image)(member: OldImageTopology.Member overlap y)(same: y = x) =>
      \idelim y = oldCoordinate x \with z: Open.Carrier chart.image => \In[M] U (point chart z) \by {
        base: member, equality: same
      }) (\bysub(Coordinates.Point, points, x));
\definition backward(x: Open.Carrier image): Domain :=
  \into[Point](\into[M](point chart (oldCoordinate x), U) \by { backwardMember x }, domains) \by {
    \bysub(M, chart.domain, point chart (oldCoordinate x))
  };
\definition leftInverse: \forall (x: Domain) -> backward (forward x) = x :=
  \fun (x: Domain) => Geometry.pointCoordinate (oldPoint x);
\definition rightInverse: \forall (x: Open.Carrier image) -> forward (backward x) = x :=
  \fun (x: Open.Carrier image) => Geometry.coordinatePoint (oldCoordinate x);
\definition oldDomainTopology: topology.Structures[].Topology[LocalPoint chart] := domainTopology chart.domain;
\module Continuity;
\import Continuity[] \as Continuous;
\definition value: Charts.Chart := Charts.Chart {
  domain := domains, image := image,
  coordinates := topology.Homeomorphism[A := Domain, B := Open.Carrier image].Homeomorphism[Charts.domainTopology domains, Charts.imageTopology image] {
    forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
    forwardContinuous := Continuous.forwardContinuous, backwardContinuous := Continuous.backwardContinuous,
  },
  open := Subspace.traceOpen space chart.domain chart.open,
};
