\import Source.Subspace[S := left.domain] \as LeftDomain;
\import topology.Topology[Carrier := LocalPoint left] \as Local;
\import topology.Topology[Carrier := Open.Carrier left.image] \as Image;
\import topology.Topology[Carrier := Coordinates.Point] \as AmbientImage;
\import AmbientImage.Subspace[S := (left.image).points] \as ImageSubspace;
\import ImageSubspace.Open[] \as OpenImage;
\import topology.Homeomorphism[A := LocalPoint left, B := Open.Carrier left.image] \as Homeomorphisms;
\import topology.Continuity[A := Open.Carrier left.image, B := LocalPoint left] \as Inverse;
\definition overlap: \Pow (Open.Carrier left.image) := Inverse.Preimage (point left) (LeftDomain.Trace right.domain);
\definition overlapOpen: Image.IsOpenIn (imageTopology left.image) overlap :=
  (Homeomorphisms.laws (domainTopology left.domain) (imageTopology left.image) left.coordinates).backwardContinuous
    (LeftDomain.Trace right.domain) (LeftDomain.traceOpen space right.domain right.open);
\definition points: \Pow Coordinates.Point := OpenImage.image overlap;
\definition pointsOpen: AmbientImage.IsOpenIn Euclidean.topology points :=
  OpenImage.imageOpen Euclidean.topology (OpenTopology.open left.image) overlap overlapOpen;
\definition domain: Open.OpenSet := OpenTopology.ofOpen points pointsOpen;
\definition intro: \forall (x: Open.Carrier left.image) -> Contains right (point left x) -> \In[Coordinates.Point] (domain.points) x :=
  \fun (x: Open.Carrier left.image)(member: Contains right (point left x)) => OpenImage.imageMember overlap x member;
\definition commonPoint[p: LocalPoint left][inRight: Contains right p]: Open.Carrier domain :=
  \into[Coordinates.Point](coordinate left p, domain.points) \by {
    intro (coordinate left p)
      (\idelim p = point left (coordinate left p) \with q: M => Contains right q \by {
        base: inRight, equality: sym!{M} (point left (coordinate left p)) p (\parent.Of[chart := left].pointCoordinate p)
      })
  };
\definition inLeftImage: \forall (x: Open.Carrier domain) -> \In[Coordinates.Point] ((left.image).points) x :=
  \fun (x: _) => OpenImage.imageIncluded overlap x (\bysub(Coordinates.Point, points, x));
\definition leftCoordinate[x: Open.Carrier domain]: Open.Carrier left.image :=
  \into[Coordinates.Point](x, (left.image).points) \by { inLeftImage x };
\definition inRightDomain: \forall (x: Open.Carrier domain) -> Source.Member right.domain (point left (leftCoordinate x)) :=
  \fun (x: _) => OpenImage.imageElim overlap x (Source.Member right.domain (point left (leftCoordinate x)))
    (\fun (y: Open.Carrier left.image)(member: Image.Member overlap y)(equal: y = x) =>
      \idelim y = leftCoordinate x \with z: Open.Carrier left.image => Source.Member right.domain (point left z)
        \by { base: member, equality: equal }) (\bysub(Coordinates.Point, points, x));
\definition overlapPoint[x: Open.Carrier domain]: LocalPoint right :=
  \into[M](point left (leftCoordinate x), right.domain) \by { inRightDomain x };
\definition apply[x: Open.Carrier domain]: Open.Carrier right.image := coordinate right (overlapPoint x);
\definition vector[x: Open.Carrier domain]: Coordinates.Point := apply x;
\definition returnsPoint: \forall (x: Open.Carrier domain) -> point right (apply x) = point left (leftCoordinate x) :=
  \fun (x: _) => \parent.Of[chart := right].pointCoordinate (overlapPoint x);
