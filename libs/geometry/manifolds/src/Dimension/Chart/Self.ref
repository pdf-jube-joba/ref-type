\import \parent.Transition[left := chart, right := chart] \as Transition;
\import \parent.Of[chart := chart] \as ChartLaws;
\definition vectorIdentity: \forall (x: Open.Carrier Transition.domain) -> Transition.vector x = x :=
  \fun (x: Open.Carrier Transition.domain) => ChartLaws.coordinatePoint (Transition.leftCoordinate x);
