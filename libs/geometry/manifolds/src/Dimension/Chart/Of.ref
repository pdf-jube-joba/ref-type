\import topology.Homeomorphism[A := LocalPoint chart, B := Open.Carrier chart.image] \as Homeomorphisms;
\definition coordinatePoint: \forall (x: Open.Carrier chart.image) -> coordinate chart (point chart x) = x :=
  (Homeomorphisms.laws (domainTopology chart.domain) (imageTopology chart.image) chart.coordinates).rightInverse;
\definition pointCoordinate: \forall (x: LocalPoint chart) -> point chart (coordinate chart x) = x :=
  (Homeomorphisms.laws (domainTopology chart.domain) (imageTopology chart.image) chart.coordinates).leftInverse;
\definition coordinateInjective: \forall (x, y: LocalPoint chart) -> coordinate chart x = coordinate chart y -> x = y :=
  \fun (x, y: _)(same: _) => trans!{{LocalPoint chart}} x (point chart (coordinate chart x)) y
    (sym!{{LocalPoint chart}} _ _ (pointCoordinate x))
    (trans!{{LocalPoint chart}} _ _ _ (congr!{{Open.Carrier chart.image} {LocalPoint chart}} (point chart) _ _ same) (pointCoordinate y));
