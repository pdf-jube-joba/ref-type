\use std.Logic[].Equality[].eq_reason_in;
\import topology.Homeomorphism[A := LocalPoint chart, B := Open.Carrier chart.image] \as Homeomorphisms;
\definition coordinatePoint: \forall (x: Open.Carrier chart.image) -> coordinate chart (point chart x) = x :=
  (Homeomorphisms.laws (domainTopology chart.domain) (imageTopology chart.image) chart.coordinates).rightInverse;
\definition pointCoordinate: \forall (x: LocalPoint chart) -> point chart (coordinate chart x) = x :=
  (Homeomorphisms.laws (domainTopology chart.domain) (imageTopology chart.image) chart.coordinates).leftInverse;
\definition coordinateInjective: \forall (x, y: LocalPoint chart) -> coordinate chart x = coordinate chart y -> x = y :=
  \fun (x, y: _)(same: _) => eq_reason_in!{{LocalPoint chart} x
    "=" { point chart (coordinate chart x) } "by" { sym!{{LocalPoint chart}} _ _ (pointCoordinate x) }
    "=" _ "by" { congr!{{Open.Carrier chart.image} {LocalPoint chart}} (point chart) _ _ same }
    "=" _ "by" { pointCoordinate y }
  };
\definition pointInjective: \forall (x, y: Open.Carrier chart.image) -> point chart x = point chart y -> x = y :=
  \fun (x, y: Open.Carrier chart.image)(same: _) => eq_reason_in!{{Open.Carrier chart.image} _
    "=" _ "by" { sym!{{Open.Carrier chart.image}} _ _ (coordinatePoint x) }
    "=" _ "by" { congr!{{LocalPoint chart} {Open.Carrier chart.image}} (coordinate chart) _ _ same }
    "=" _ "by" { coordinatePoint y }
  };
