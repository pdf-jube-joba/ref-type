\import topology.Homeomorphism[A := LocalPoint chart, B := Open.Carrier #image{chart}] \as Homeomorphisms;
\definition coordinatePoint: \forall (x: Open.Carrier #image{chart}) -> coordinate chart (point chart x) = x :=
  #rightInverse{(Homeomorphisms.laws (domainTopology #domain{chart}) (imageTopology #image{chart}) #coordinates{chart})};
\definition pointCoordinate: \forall (x: LocalPoint chart) -> point chart (coordinate chart x) = x :=
  #leftInverse{(Homeomorphisms.laws (domainTopology #domain{chart}) (imageTopology #image{chart}) #coordinates{chart})};
\definition coordinateInjective: \forall (x, y: LocalPoint chart) -> coordinate chart x = coordinate chart y -> x = y :=
  \fun (x, y: _)(same: _) => trans!{{LocalPoint chart}} x (point chart (coordinate chart x)) y
    (sym!{{LocalPoint chart}} _ _ (pointCoordinate x))
    (trans!{{LocalPoint chart}} _ _ _ (congr!{{Open.Carrier #image{chart}} {LocalPoint chart}} (point chart) _ _ same) (pointCoordinate y));
