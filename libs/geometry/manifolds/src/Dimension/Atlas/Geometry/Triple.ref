\import Charts.Cocycle[left := left, middle := middle, right := right] \as Geometry;
\import Charts.Transition[left := left, right := middle] \as First;
\import Charts.Transition[left := middle, right := right] \as Second;
\import Charts.Transition[left := left, right := right] \as Direct;
\import \parent.\parent.Cocycle[left := left, middle := middle, right := right] \as Cocycle;
\import \parent.\parent.Pair[left := left, right := middle] \as FirstPair;
\import \parent.\parent.Pair[left := middle, right := right] \as SecondPair;
\import \parent.\parent.Pair[left := left, right := right] \as DirectPair;
\import calculus.Maps[n := n, m := n] \as Maps;
\import calculus.Vector[n := n, m := n] \as Vector;
\definition firstCompatible: Compatible left middle := #compatible{atlas} left middle (member left) (member middle);
\definition secondCompatible: Compatible middle right := #compatible{atlas} middle right (member middle) (member right);
\definition directCompatible: Compatible left right := #compatible{atlas} left right (member left) (member right);
\definition firstFull: Maps.Map First.domain #image{middle} := FirstPair.smoothMap firstCompatible;
\definition first: Maps.Map Geometry.domain Second.domain := Cocycle.firstMap firstCompatible;
\definition firstRestricted: Maps.Map Geometry.domain #image{middle} :=
  Maps.Restriction[U := Geometry.domain, V := First.domain, W := #image{middle}].input Geometry.firstIncluded firstFull;
\definition second: Maps.Map Second.domain #image{right} := SecondPair.smoothMap secondCompatible;
\definition directFull: Maps.Map Direct.domain #image{right} := DirectPair.smoothMap directCompatible;
\definition direct: Maps.Map Geometry.domain #image{right} :=
  Maps.Restriction[U := Geometry.domain, V := Direct.domain, W := #image{right}].input Geometry.directIncluded directFull;
\import Maps.Composition[U := Geometry.domain, V := Second.domain, f := first].After[l := n, W := #image{right}, g := second] \as Composition;
\definition composite: Maps.Map Geometry.domain #image{right} := Composition.compose;
\definition agreement: \forall (x: Open.Carrier Geometry.domain) -> Maps.apply Geometry.domain #image{right} composite x = Maps.apply Geometry.domain #image{right} direct x :=
  Geometry.coordinateAgreement;
\definition Point: \Set := Open.Carrier Geometry.domain;
\import real.Analysis[].Algebra[] \as Algebra;
\import linear_algebra.Field[].Space[K := Real.Real, field := Algebra.field] \as Spaces;
\import Spaces.Coordinates[I := Coordinates.Coordinate] \as CoordinateSpace;
\import Spaces.Linear[V := CoordinateSpace.Vector, W := CoordinateSpace.Vector, source := CoordinateSpace.space, target := CoordinateSpace.space] \as Endomorphisms;
\import Endomorphisms.Composition[U := CoordinateSpace.Vector, domain := CoordinateSpace.space] \as LinearComposition;
\definition compose(d, e: Vector.LinearMap): Vector.LinearMap := LinearComposition.compose d e;
\module At(a: Point);
