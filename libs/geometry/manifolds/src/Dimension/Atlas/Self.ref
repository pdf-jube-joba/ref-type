\import Charts.Self[chart := chart] \as Geometry;
\import Charts.Transition[left := chart, right := chart] \as Transition;
\import \parent.Pair[left := chart, right := chart] \as Pair;
\import Open.Examples[] \as Examples;
\import calculus.Maps[n := n, m := n] \as Maps;
\definition compatible: Compatible chart chart := \fun (i: Coordinates.Coordinate) =>
  \idelim (\fun (x: Open.Carrier Transition.domain) => x i) = (\fun (x: Open.Carrier Transition.domain) => Transition.vector x i)
    \with f: Open.ScalarFunction Transition.domain => Analysis.SmoothOn Transition.domain f \by {
      base: Examples.projectionSmooth Transition.domain i,
      equality: \axiom:funext((\fun (x: Open.Carrier Transition.domain) => x i),
        (\fun (x: Open.Carrier Transition.domain) => Transition.vector x i),
        \fun (x: Open.Carrier Transition.domain) => sym!{Real.Real} (Transition.vector x i) (x i)
          (congr!{Coordinates.Point Real.Real} (\fun (v: Coordinates.Point) => v i) (Transition.vector x) x (Geometry.vectorIdentity x)))
    };
\definition map: Maps.Map Transition.domain #image{chart} := Pair.smoothMap compatible;
\definition Point: \Set := Open.Carrier Transition.domain;
\module At(a: Point);
