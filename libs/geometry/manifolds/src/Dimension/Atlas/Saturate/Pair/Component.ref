\import Open.SmoothCover[I := ChartsIn, U := Direct.domain, domains := domains, f := \fun (x: Open.Carrier Direct.domain) => Direct.vector x i] \as Cover;
\definition smooth: Compatibility[atlas, left] -> Compatibility[atlas, right] -> Analysis.SmoothOn Direct.domain (\fun (x: Open.Carrier Direct.domain) => Direct.vector x i) :=
  \fun (leftCompatible: Compatibility[atlas, left])(rightCompatible: Compatibility[atlas, right]) => Cover.smooth included covers
    (\fun (chart: ChartsIn) => regular leftCompatible rightCompatible chart i);
