\import Charts.Transition[left := left, right := chart] \as First;
\import \parent.\parent.\parent.Cocycle[left := left, middle := chart, right := right] \as Geometry;
\definition contains: \forall (x: Open.Carrier Direct.domain) -> Charts.Contains chart (Direct.overlapPoint x) ->
  \In[Coordinates.Point] ((domains chart).points) x :=
  \fun (x: Open.Carrier Direct.domain)(inChart: Charts.Contains chart (Direct.overlapPoint x)) =>
    Logic.And[\In[Coordinates.Point] (First.domain.points) x, \In[Coordinates.Point] (Direct.domain.points) x]::#
      (First.intro (Direct.leftCoordinate x) inChart) (\bysub(Coordinates.Point, Direct.domain.points, x));
\definition regular: Compatible left chart -> Compatible chart right -> \forall (i: Coordinates.Coordinate) ->
  Analysis.SmoothOn (domains chart) (Open.restrict (domains chart) Direct.domain (included chart) (\fun (x: Open.Carrier Direct.domain) => Direct.vector x i)) :=
  Geometry.regular;
