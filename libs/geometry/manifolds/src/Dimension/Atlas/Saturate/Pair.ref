\import Charts.Transition[left := left, right := right] \as Direct;
\definition domains(chart: ChartsIn): Open.OpenSet := Charts.Cocycle[left := left, middle := chart, right := right].domain;
\definition included: \forall (chart: ChartsIn) -> Open.Included (domains chart) Direct.domain :=
  \fun (chart: ChartsIn) => Open.intersectionRight (Charts.Transition[left := left, right := chart].domain) Direct.domain;
\definition Covers: \Prop := \forall (x: Open.Carrier Direct.domain) -> \exists { chart: ChartsIn \where \In[Coordinates.Point] ((domains chart).points) x };
\module Patch(chart: ChartsIn);
\definition covers: Covers := \block {
  \fun (x: Open.Carrier Direct.domain) \then
  \takefrom chart: \Cast[Charts.Chart] ({ chart: Charts.Chart \where Logic.And[Member atlas chart, Charts.Contains chart (Direct.overlapPoint x)] })
    \by atlas.covers (Direct.overlapPoint x) \then
  \let witness: Logic.And[Member atlas chart, Charts.Contains chart (Direct.overlapPoint x)] := \bysub(Charts.Chart,
    { chart: Charts.Chart \where Logic.And[Member atlas chart, Charts.Contains chart (Direct.overlapPoint x)] }, chart) \then
  \let chosen: ChartsIn := \into[Charts.Chart](chart, atlas.charts) \by { witness.left } \then
  \return Logic.existsIntro[ChartsIn, { chart: ChartsIn \where \In[Coordinates.Point] ((domains chart).points) x }] chosen
    (Patch[chart := chosen].contains x (witness.right))
};
\definition regular: Compatibility[atlas, left] -> Compatibility[atlas, right] -> \forall (chart: ChartsIn)(i: Coordinates.Coordinate) ->
  Analysis.SmoothOn (domains chart) (Open.restrict (domains chart) Direct.domain (included chart) (\fun (x: Open.Carrier Direct.domain) => Direct.vector x i)) :=
  \fun (leftCompatible: Compatibility[atlas, left])(rightCompatible: Compatibility[atlas, right])(chart: ChartsIn)(i: Coordinates.Coordinate) =>
    Patch[chart := chart].regular (leftCompatible.forward chart (\bysub(Charts.Chart, atlas.charts, chart)))
      (rightCompatible.backward chart (\bysub(Charts.Chart, atlas.charts, chart))) i;
\module Component(i: Coordinates.Coordinate);
\definition compatible: Compatibility[atlas, left] -> Compatibility[atlas, right] -> Compatible left right :=
  \fun (leftCompatible: Compatibility[atlas, left])(rightCompatible: Compatibility[atlas, right])(i: Coordinates.Coordinate) =>
    Component[i := i].smooth leftCompatible rightCompatible;
