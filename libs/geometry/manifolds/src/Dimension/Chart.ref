\import topology.Topology[Carrier := M] \as Source;
\import \parent.ChartData[M := M, space := space] \as Core;
\definition Domain(points: \Pow M): \Set := Core.Domain points;
\definition domainTopology(points: \Pow M): topology.Topology[Carrier := Domain points].Topology := Core.domainTopology points;
\definition imageTopology(U: Open.OpenSet): topology.Topology[Carrier := Open.Carrier U].Topology := Core.imageTopology U;
\definition Data: \Set := Core.Data;
\definition Laws(data: Data): \Prop := Core.Laws[data];
\definition Chart: \Set := Core.Chart;
\definition Contains(chart: Chart)(x: M): \Prop := Core.Contains chart x;
\definition LocalPoint(chart: Chart): \Set := Core.LocalPoint chart;
\definition coordinate(chart: Chart)(x: LocalPoint chart): Open.Carrier #image{chart} := Core.coordinate chart x;
\definition point(chart: Chart)(x: Open.Carrier #image{chart}): LocalPoint chart := Core.point chart x;
\module Of(chart: Chart);
\module Transition(left, right: Chart);
\module Cocycle(left, middle, right: Chart);
\module Self(chart: Chart);

\definition OpenSubset: \Set := \Cast[\Pow M] ({ U: \Pow M \where Source.IsOpenIn space U });
\module Restricted(U: OpenSubset);
