\import \root.Dimension[n := n].Chart[M := M.Point, space := M.space] \as BaseCharts;
\definition BaseChart: \Set := \Cast[BaseCharts.Chart] M.atlas.charts;
\definition domain[c: BaseChart]: \Pow A := { x: A \where BaseCharts.Contains c (projection x) };
\definition parameter[c: BaseChart]: Open.OpenSet := Blocks.product c.image FiberOpen.whole;
\definition Domain[c: BaseChart]: \Set := \Cast[A] (domain c);
\structure Local: \Set := {
  baseChart: BaseChart,
  point: Open.Carrier (parameter baseChart) -> Domain baseChart,
  coordinate: Domain baseChart -> Open.Carrier (parameter baseChart),
  pointCoordinate: \forall (x: Domain baseChart) -> point (coordinate x) = x,
  coordinatePoint: \forall (u: Open.Carrier (parameter baseChart)) -> coordinate (point u) = u,
  projectionFormula: \forall (u: Open.Carrier (parameter baseChart)) -> projection (point u) =
    BaseCharts.point baseChart (Blocks.On[U := baseChart.image, V := FiberOpen.whole].leftPoint u),
};
\structure Data: \Set := {
  local: I -> Local,
  covers: \forall (x: M.Point) -> \exists ( i: I \where BaseCharts.Contains (local i).baseChart x ),
};
\module Using(data: Data);
