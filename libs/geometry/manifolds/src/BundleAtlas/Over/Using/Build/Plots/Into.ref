\import BasicCharts.Smooth[changes := AtlasConstruction.smoothChanges] \as SmallAtlas;
\import \root.SmallAtlasSmoothMap[n := dimension, m := m].Between[M := manifold, N := N] \as Small;
\import \root.Dimension[n := dimension].Atlas[M := A, space := topology] \as TotalAtlases;
\import \root.Dimension[n := dimension].Chart[M := A, space := topology] \as TotalCharts;
\definition small: Small.SourceAtlas := \into[TotalAtlases.Atlas](SmallAtlas.atlas, Small.SourceAtlas) \by {
  \fun (c: TotalCharts.Chart)(member: _) => TotalAtlases.includedInSaturation SmallAtlas.atlas c member
};
\import \root.FromCharts[n := dimension, m := m].Between[M := manifold, N := N].Using[source := small] \as FromSmall;
\definition chart[c: I]: FromSmall.SourceChart := \into[TotalCharts.Chart](BasicCharts.chart c, small.charts) \by {
  Logic.existsIntro[I, { d: I \where BasicCharts.chart c = BasicCharts.chart d }] c (\refl(BasicCharts.chart c))
};
\definition exhaustive: \forall (c: FromSmall.SourceChart) -> \exists ( i: I \where chart i = c ) := \block {
  \fun (c: FromSmall.SourceChart) \then
  \takefrom i: \Cast[I] ({ i: I \where c = BasicCharts.chart i }) \by \bysub(TotalCharts.Chart, small.charts, c) \then
  \return Logic.existsIntro[I, { i: I \where chart i = c }] i
    (sym!{{TotalCharts.Chart}} _ _ (\bysub(I, { i: I \where c = BasicCharts.chart i }, i)))
};
\import FromSmall.Indexed[I := I, chart := chart, exhaustive := exhaustive] \as Indexed;
\definition LocalMap[c: I]: \Set := FromSmall.LocalMap (chart c);
\definition Family: \Set := \forall (c: I) -> LocalMap c;
\definition Agreement[f: A -> N.Point][maps: Family]: \Prop := Indexed.IndexedAgreement f maps;
\module Of(f: A -> N.Point, maps: Family, agrees: Agreement f maps);
