\import \root.IndexedAtlas[n := dimension, A := A, I := I] \as Parameters;
\definition patch[i: I]: Parameters.Patch := Parameters.Patch {
  domain := domain (data.local i).baseChart, image := parameter (data.local i).baseChart,
  point := (data.local i).point, coordinate := (data.local i).coordinate,
  pointCoordinate := (data.local i).pointCoordinate, coordinatePoint := (data.local i).coordinatePoint,
};
\definition family: Parameters.Family := Parameters.Family {
  patch := patch, covers := \fun (x: A) => data.covers (projection x),
};
\import Parameters.On[family := family] \as CoordinateTopology;
\definition topology: topology.Structures[].Topology[A] := CoordinateTopology.topology;
\module Build(transitions: CoordinateTopology.Transitions);
