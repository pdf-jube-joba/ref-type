\import \root.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\import \root.Dimension[n := n].Atlas[M := M.Point, space := M.space] \as Atlas;
\definition Chart: \Set := \Cast[Charts.Chart] M.atlas.charts;
\module At(c: Chart, U: Open.OpenSet, included: Open.Included U c.image);
