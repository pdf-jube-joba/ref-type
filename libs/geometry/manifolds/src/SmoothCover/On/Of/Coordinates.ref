\import Maps.Coordinates[f := continuousMap, left := Source.standard, right := right] \as Global;
\import Open.Smooth[] \as Smooth;
\module InPatch(i: I);
\definition regular: Global.Smooth := \block {
  \fun (j: std.Data[].FinSet[].Fin m) \then
  \let function: Open.ScalarFunction Global.domain := \fun (x: Open.Carrier Global.domain) => Global.apply x j \then
  \return Open.LocalSmooth[U := Global.domain, f := function].smooth (\block {
    \fun (a: Open.Carrier Global.domain) \then
    \takefrom i: \Cast[I] ({ i: I \where \In[Reals.Multivariable[n := n].Point] ((domains i).points) (Global.leftCoordinate a) })
      \by covers (Global.leftCoordinate a) \then
    \let patch: Open.LocalSmooth[U := Global.domain, f := function].Patch := Open.LocalSmooth[U := Global.domain, f := function].Patch {
      domain := InPatch[i := i].domain,
      included := InPatch[i := i].inGlobal,
      smooth := InPatch[i := i].smooth j,
    } \then
    \return Logic.existsIntro[Open.LocalSmooth[U := Global.domain, f := function].Patch, Open.LocalSmooth[U := Global.domain, f := function].Patches a] patch
      (Logic.And[_, _]::# (\bysub(Reals.Multivariable[n := n].Point, Global.domain.points, a))
        (\bysub(I, { i: I \where \In[Reals.Multivariable[n := n].Point] ((domains i).points) (Global.leftCoordinate a) }, i)))
  })
};
