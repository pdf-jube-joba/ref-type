\import \root.Immersion[n := n, m := m].Between[M := M, N := N] \as First;
\import \root.Immersion[n := m, m := l].Between[M := N, N := P] \as Second;
\import \root.Immersion[n := n, m := l].Between[M := M, N := P] \as Composite;
\import \root.SmoothMap[n := n, m := m].Between[M := M, N := N] \as FirstMaps;
\import \root.SmoothMap[n := m, m := l].Between[M := N, N := P] \as SecondMaps;
\import \root.Composition[n := n, m := m, l := l].Between[M := M, N := N, P := P] \as Compose;
\import \root.Tangent[n := n].On[M := M] \as Tangent;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\module Of(f: FirstMaps.Map, g: SecondMaps.Map);
\definition immersion: \forall (f: FirstMaps.Map)(g: SecondMaps.Map) -> First.IsImmersion f -> Second.IsImmersion g -> Composite.IsImmersion (Compose.compose f g) :=
  \fun (f: FirstMaps.Map)(g: SecondMaps.Map) => Of[f := f, g := g].immersion;
\import std.Logic[].Proposition[] \as Logic;
\import topology.Topology[Carrier := M.Point] \as SourceTopology;
\import topology.Topology[Carrier := N.Point] \as MiddleTopology;
\import topology.Topology[Carrier := P.Point] \as TargetTopology;
\import topology.Continuity[A := M.Point, B := N.Point] \as F;
\import topology.Continuity[A := N.Point, B := P.Point] \as G;
\import topology.Continuity[A := M.Point, B := P.Point] \as GF;
\module Embeddings(f: First.Embedding, g: Second.Embedding);
\definition embedding: \forall (f: First.Embedding)(g: Second.Embedding) -> Composite.EmbeddingLaws[Compose.compose f g] :=
  \fun (f: First.Embedding)(g: Second.Embedding) => Embeddings[f := f, g := g].laws;

\definition firstOfComposite: \forall (f: FirstMaps.Map)(g: SecondMaps.Map) -> Composite.IsImmersion (Compose.compose f g) -> First.IsImmersion f :=
  \fun (f: FirstMaps.Map)(g: SecondMaps.Map) => Of[f := f, g := g].firstOfComposite;
