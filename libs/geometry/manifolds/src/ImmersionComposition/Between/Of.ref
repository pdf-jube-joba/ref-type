\import \root.DifferentialComposition[n := n, m := m, l := l].Between[M := M, N := N, P := P].Of[f := f, g := g] \as Differential;
\import \root.Differential[n := n, m := m].Between[M := M, N := N] \as FirstD;
\module At(x: M.Point);
\definition immersion: First.IsImmersion f -> Second.IsImmersion g -> Composite.IsImmersion (Compose.compose f g) :=
  \fun (first: First.IsImmersion f)(second: Second.IsImmersion g)(x: M.Point)(u, v: Tangent.Vector x)(same: _) =>
    first x u v (second (FirstMaps.apply f x) (FirstD.At[f := f, x := x].value.apply u) (FirstD.At[f := f, x := x].value.apply v) (At[x := x].equality u v same));

\definition firstOfComposite: Composite.IsImmersion (Compose.compose f g) -> First.IsImmersion f :=
  \fun (immersion: Composite.IsImmersion (Compose.compose f g))(x: M.Point)(u, v: Tangent.Vector x)(same: _) =>
    immersion x u v (At[x := x].fromFirstEquality u v same);
