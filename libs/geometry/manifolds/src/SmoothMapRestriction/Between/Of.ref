\module On(U: Charts.OpenSubset) {
  \import \root.OpenSubmanifold[n := n].On[M := M].In[U := U] \as Submanifold;
  \definition manifold: Source.Manifold := Submanifold.manifold;
  \import \root.SmoothMap[n := n, m := m].Between[M := manifold, N := N] \as RestrictedMaps;
  \definition map: RestrictedMaps.Map := \root.Composition[n := n, m := n, l := m].Between[M := manifold, N := M, P := N].compose Submanifold.Inclusion[].map f;
  \definition pointwise: \forall (x: Submanifold.Point) -> RestrictedMaps.apply map x = Maps.apply f x :=
    \fun (x: Submanifold.Point) => \refl(Maps.apply f x);
}
