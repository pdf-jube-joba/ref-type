\import std.Logic[].Equality[] \as Equality;
\import \root.Composition[n := n, m := m, l := l].Between[M := M, N := N, P := P] \as Head;
\import \root.Composition[n := n, m := l, l := r].Between[M := M, N := P, P := Q] \as Left;
\import \root.Composition[n := m, m := l, l := r].Between[M := N, N := P, P := Q] \as Tail;
\import \root.Composition[n := n, m := m, l := r].Between[M := M, N := N, P := Q] \as Right;
\import \root.SmoothMap[n := n, m := r].Between[M := M, N := Q] \as Result;
\definition associative: (Left.compose (Head.compose f g) h) = (Right.compose f (Tail.compose g h)) := Result.ext (Left.compose (Head.compose f g) h) (Right.compose f (Tail.compose g h))
  (\axiom:funext(Result.apply (Left.compose (Head.compose f g) h), Result.apply (Right.compose f (Tail.compose g h)), \fun (x: M.Point) => \refl(Result.apply (Left.compose (Head.compose f g) h) x)));
