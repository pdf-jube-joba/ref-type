\import SourceTopology.Subspace[S := left.domain] \as LeftDomain;
\import topology.Topology[Carrier := SourceCharts.LocalPoint left] \as Local;
\import topology.Topology[Carrier := SourceOpen.Carrier left.image] \as Image;
\import topology.Topology[Carrier := SourceCoordinates.Point] \as Ambient;
\import Ambient.Subspace[S := (left.image).points] \as ImageSubspace;
\import ImageSubspace.Open[] \as OpenImage;
\import topology.Continuity[A := SourceOpen.Carrier left.image, B := SourceCharts.LocalPoint left] \as Inverse;
\import topology.Homeomorphism[A := SourceCharts.LocalPoint left, B := SourceOpen.Carrier left.image] \as Homeomorphisms;
\definition preimage: \Pow M.Point := Continuity.Preimage (f.apply) right.domain;
\definition preimageOpen: SourceTopology.IsOpenIn M.space preimage :=
  (\bysub(Data, { data: Data \where Continuous data }, f)) right.domain right.open;
\definition overlap: \Pow (SourceOpen.Carrier left.image) := Inverse.Preimage (SourceCharts.point left) (LeftDomain.Trace preimage);
\definition overlapOpen: Image.IsOpenIn (SourceCharts.imageTopology left.image) overlap :=
  (Homeomorphisms.laws (SourceCharts.domainTopology left.domain) (SourceCharts.imageTopology left.image) left.coordinates).backwardContinuous
    (LeftDomain.Trace preimage) (LeftDomain.traceOpen M.space preimage preimageOpen);
\definition points: \Pow SourceCoordinates.Point := OpenImage.image overlap;
\definition pointsOpen: Ambient.IsOpenIn Euclidean.topology points :=
  OpenImage.imageOpen Euclidean.topology (OpenTopology.open left.image) overlap overlapOpen;
\definition domain: SourceOpen.OpenSet := OpenTopology.ofOpen points pointsOpen;
\definition intro: \forall (x: SourceOpen.Carrier left.image) -> TargetCharts.Contains right (f.apply (SourceCharts.point left x)) ->
  \In[SourceCoordinates.Point] (domain.points) x :=
  \fun (x: SourceOpen.Carrier left.image)(member: TargetCharts.Contains right (f.apply (SourceCharts.point left x))) => OpenImage.imageMember overlap x member;
\definition inLeftImage: \forall (x: SourceOpen.Carrier domain) -> \In[SourceCoordinates.Point] ((left.image).points) x :=
  \fun (x: SourceOpen.Carrier domain) => OpenImage.imageIncluded overlap x (\bysub(SourceCoordinates.Point, points, x));
\definition leftCoordinate[x: SourceOpen.Carrier domain]: SourceOpen.Carrier left.image :=
  \into[SourceCoordinates.Point](x, (left.image).points) \by { inLeftImage x };
\definition inRightDomain: \forall (x: SourceOpen.Carrier domain) -> TargetCharts.Contains right (f.apply (SourceCharts.point left (leftCoordinate x))) :=
  \fun (x: SourceOpen.Carrier domain) => OpenImage.imageElim overlap x
    (TargetCharts.Contains right (f.apply (SourceCharts.point left (leftCoordinate x))))
    (\fun (y: SourceOpen.Carrier left.image)(member: Image.Member overlap y)(same: y = x) =>
      \idelim y = leftCoordinate x \with z: SourceOpen.Carrier left.image => TargetCharts.Contains right (f.apply (SourceCharts.point left z)) \by {
        base: member, equality: same
      }) (\bysub(SourceCoordinates.Point, points, x));
\definition point[x: SourceOpen.Carrier domain]: TargetCharts.LocalPoint right :=
  \into[N.Point](f.apply (SourceCharts.point left (leftCoordinate x)), right.domain) \by { inRightDomain x };
\definition apply[x: SourceOpen.Carrier domain]: TargetOpen.Carrier right.image := TargetCharts.coordinate right (point x);
\definition returnsPoint: \forall (x: SourceOpen.Carrier domain) -> TargetCharts.point right (apply x) = f.apply (SourceCharts.point left (leftCoordinate x)) :=
  \fun (x: SourceOpen.Carrier domain) => \root.Dimension[n := m].Chart[M := N.Point, space := N.space].Of[chart := right].pointCoordinate (point x);
\definition Smooth: \Prop := \forall (i: std.Data[].FinSet[].Fin m) -> SourceSmooth.SmoothOn domain (\fun (x: SourceOpen.Carrier domain) => apply x i);
\import calculus.Maps[n := n, m := m] \as Calculus;
\definition data: Calculus.Data[domain, right.image] := Calculus.Data[domain, right.image] { apply := apply };
\definition map[smooth: Smooth]: Calculus.Map domain right.image := \into[Calculus.Data[domain, right.image]](data,
  { f: Calculus.Data[domain, right.image] \where Calculus.Laws[domain, right.image, f] }) \by {
    Calculus.Laws[domain, right.image, data] { smooth := smooth }
  };
