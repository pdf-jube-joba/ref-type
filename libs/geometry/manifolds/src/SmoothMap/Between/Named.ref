/* Give a proved-smooth map its specified pointwise presentation. */
\definition data: Data := Data { apply := function };
\definition dataEquality: f = data := trans!{Data} _ _ _ (sym!{Data} _ _ (dataEta f))
  (congr!{{M.Point -> N.Point} Data} Data::# _ _ same);
\definition continuous: Continuous data := \idelim f = data \with g: Data => Continuous g \by {
  base: \bysub(Data, { g: Data \where Continuous g }, f), equality: dataEquality
};
\definition continuousMap: ContinuousMap := \into[Data](data, { g: Data \where Continuous g }) \by { continuous };
\definition chartwise: Chartwise continuousMap := \idelim f = continuousMap \with g: ContinuousMap => Chartwise g \by {
  base: \bysub(ContinuousMap, { g: ContinuousMap \where Chartwise g }, f), equality: dataEquality
};
\definition map: Map := \into[ContinuousMap](continuousMap, { g: ContinuousMap \where Chartwise g }) \by { chartwise };
\definition formula: apply map = function := \refl(function);
