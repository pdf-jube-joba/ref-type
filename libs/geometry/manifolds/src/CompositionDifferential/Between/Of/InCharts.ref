\import Composition.Coordinates[left := left, right := right] \as Coordinates;
\import Coordinates.Patch[middle := middle] \as Patch;
\import First.Coordinates[f := f, left := left, right := middle] \as LocalFirst;
\import Second.Coordinates[f := g, left := middle, right := right] \as LocalSecond;
\import Composite.Coordinates[f := map, left := left, right := right] \as Direct;
\definition leftMember: \In[SourceCharts.Chart] M.atlas.charts left := \bysub(SourceCharts.Chart, M.atlas.charts, left);
\definition rightMember: \In[TargetCharts.Chart] P.atlas.charts right := \bysub(TargetCharts.Chart, P.atlas.charts, right);
\definition middleMember: \In[MiddleCharts.Chart] N.atlas.charts middle := \bysub(MiddleCharts.Chart, N.atlas.charts, middle);
\definition domain: Open.OpenSet := Coordinates.domains middle;
\definition firstMap: FirstCalculus.Map domain LocalSecond.domain := Patch.firstMap leftMember;
\definition secondMap: SecondCalculus.Map LocalSecond.domain right.image := Patch.secondMap rightMember;
\definition compositeMap: CompositeCalculus.Map domain right.image := Patch.compose leftMember rightMember;
\definition directMap: CompositeCalculus.Map Direct.domain right.image :=
  Direct.map ((\bysub(Composite.ContinuousMap, { h: Composite.ContinuousMap \where Composite.Chartwise h }, map))
    left right leftMember rightMember);
\definition originalFirst: FirstCalculus.Map LocalFirst.domain middle.image :=
  LocalFirst.map ((\bysub(First.ContinuousMap, { h: First.ContinuousMap \where First.Chartwise h }, f))
    left middle leftMember middleMember);
\import CompositeCalculus.Restriction[U := domain, V := Direct.domain, W := right.image] \as DirectRestriction;
\definition restrictedDirect: CompositeCalculus.Map domain right.image := DirectRestriction.input (Coordinates.included middle) directMap;
\import FirstCalculus.Restriction[U := domain, V := LocalFirst.domain, W := middle.image] \as FirstRestriction;
\definition restrictedFirst: FirstCalculus.Map domain middle.image := FirstRestriction.input Patch.firstIncluded originalFirst;
\module At(a: Open.Carrier domain);
