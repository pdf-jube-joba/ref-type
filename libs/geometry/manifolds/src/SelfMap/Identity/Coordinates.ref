\import Maps.Coordinates[f := continuous, left := left, right := right] \as Local;
\import \root.Dimension[n := n].AtlasData[M := M.Point, space := M.space] \as Atlas;
\definition law: \In[Charts.Chart] M.atlas.charts left -> \In[Charts.Chart] M.atlas.charts right -> Local.Smooth :=
  \fun (leftMember: \In[Charts.Chart] M.atlas.charts left)(rightMember: \In[Charts.Chart] M.atlas.charts right) =>
    M.atlas.compatible left right leftMember rightMember;
