\import Maps.Coordinates[f := continuous, left := left, right := right] \as Local;
\import \root.Dimension[n := n].AtlasData[M := M.Point, space := M.space] \as Atlas;
\definition law: \In[Charts.Chart] #charts{M.atlas} left -> \In[Charts.Chart] #charts{M.atlas} right -> Local.Smooth :=
  \fun (leftMember: \In[Charts.Chart] #charts{M.atlas} left)(rightMember: \In[Charts.Chart] #charts{M.atlas} right) =>
    #compatible{M.atlas} left right leftMember rightMember;
