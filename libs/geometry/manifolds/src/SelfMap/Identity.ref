\import \root.SmoothMap[n := n, m := n].Between[M := M, N := M] \as Maps;
\import \root.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\import topology.Maps[A := M.Point, B := M.Point].Identity[] \as Topology;
\definition data: Maps.Data := Maps.Data { apply := \fun (x: M.Point) => x };
\definition continuous: Maps.ContinuousMap := \into[Maps.Data](data, { f: Maps.Data \where Maps.Continuous f }) \by {
  Topology.continuous M.space
};
\module Coordinates(left, right: Charts.Chart);
\definition regular: Maps.Chartwise continuous := \fun (left, right: Charts.Chart) => Coordinates[left := left, right := right].law;
\definition map: Maps.Map := \into[Maps.ContinuousMap](continuous, { f: Maps.ContinuousMap \where Maps.Chartwise f }) \by { regular };
\definition pointwise: \forall (x: M.Point) -> Maps.apply map x = x := \fun (x: M.Point) => \refl(x);
\import \root.Diffeomorphism[n := n, m := n].Between[M := M, N := M] \as Diffeomorphisms;
\definition diffeomorphism: Diffeomorphisms.Diffeomorphism := Diffeomorphisms.Diffeomorphism {
  forward := map, backward := map,
  leftInverse := \fun (x: M.Point) => \refl(x),
  rightInverse := \fun (x: M.Point) => \refl(x),
};
