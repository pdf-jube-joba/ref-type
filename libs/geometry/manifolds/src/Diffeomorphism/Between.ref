\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import std.Data[].Nat[] \as Naturals;
\import \root.SmoothMap[n := n, m := m].Between[M := M, N := N] \as Forward;
\import \root.SmoothMap[n := m, m := n].Between[M := N, N := M] \as Backward;
\structure Data: \Set := {
  forward: Forward.Map,
  backward: Backward.Map,
};
\structure Laws[data: Data]: \Prop := {
  leftInverse: \forall (x: M.Point) -> Backward.apply data.backward (Forward.apply data.forward x) = x,
  rightInverse: \forall (y: N.Point) -> Forward.apply data.forward (Backward.apply data.backward y) = y,
};
\definition Diffeomorphism: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition laws[d: Diffeomorphism]: Laws[d] := \bysub(Data, { data: Data \where Laws[data] }, d);
\module Of(d: Diffeomorphism);
