\import \root.Diffeomorphism[n := m, m := n].Between[M := N, N := M] \as Reverse;
\definition inverse: Reverse.Diffeomorphism := Reverse.Diffeomorphism {
  forward := #backward{d}, backward := #forward{d}, leftInverse := #rightInverse{(laws d)}, rightInverse := #leftInverse{(laws d)},
};
\definition injective: \forall (x, y: M.Point) -> Forward.apply #forward{d} x = Forward.apply #forward{d} y -> x = y :=
  \fun (x, y: M.Point)(same: Forward.apply #forward{d} x = Forward.apply #forward{d} y) =>
    trans!{{M.Point}} x (Backward.apply #backward{d} (Forward.apply #forward{d} x)) y
      (sym!{{M.Point}} (Backward.apply #backward{d} (Forward.apply #forward{d} x)) x (#leftInverse{(laws d)} x))
      (trans!{{M.Point}} (Backward.apply #backward{d} (Forward.apply #forward{d} x)) (Backward.apply #backward{d} (Forward.apply #forward{d} y)) y
        (congr!{{N.Point} {M.Point}} (Backward.apply #backward{d}) (Forward.apply #forward{d} x) (Forward.apply #forward{d} y) same) (#leftInverse{(laws d)} y));
