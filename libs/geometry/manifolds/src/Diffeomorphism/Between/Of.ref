\import \root.Diffeomorphism[n := m, m := n].Between[M := N, N := M] \as Reverse;
\definition inverse: Reverse.Diffeomorphism := Reverse.Diffeomorphism {
  forward := d.backward, backward := d.forward, leftInverse := (laws d).rightInverse, rightInverse := (laws d).leftInverse,
};
\definition injective: \forall (x, y: M.Point) -> Forward.apply d.forward x = Forward.apply d.forward y -> x = y :=
  \fun (x, y: M.Point)(same: Forward.apply d.forward x = Forward.apply d.forward y) =>
    trans!{{M.Point}} x (Backward.apply d.backward (Forward.apply d.forward x)) y
      (sym!{{M.Point}} (Backward.apply d.backward (Forward.apply d.forward x)) x ((laws d).leftInverse x))
      (trans!{{M.Point}} (Backward.apply d.backward (Forward.apply d.forward x)) (Backward.apply d.backward (Forward.apply d.forward y)) y
        (congr!{{N.Point} {M.Point}} (Backward.apply d.backward) (Forward.apply d.forward x) (Forward.apply d.forward y) same) ((laws d).leftInverse y));
