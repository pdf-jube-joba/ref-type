\use std.Logic[].Equality[].eq_reason_in;
\import \root.Diffeomorphism[n := m, m := n].Between[M := N, N := M] \as Reverse;
\definition inverse: Reverse.Diffeomorphism := Reverse.Diffeomorphism {
  forward := d.backward, backward := d.forward, leftInverse := (laws d).rightInverse, rightInverse := (laws d).leftInverse,
};
\definition injective: \forall (x, y: M.Point) -> Forward.apply d.forward x = Forward.apply d.forward y -> x = y :=
  \fun (x, y: M.Point)(same: Forward.apply d.forward x = Forward.apply d.forward y) =>
    eq_reason_in!{{M.Point} x
      "=" { Backward.apply d.backward (Forward.apply d.forward x) } "by" { sym!{{M.Point}} (Backward.apply d.backward (Forward.apply d.forward x)) x ((laws d).leftInverse x) }
      "=" { Backward.apply d.backward (Forward.apply d.forward y) } "by" { congr!{{N.Point} {M.Point}} (Backward.apply d.backward) (Forward.apply d.forward x) (Forward.apply d.forward y) same }
      "=" y "by" { (laws d).leftInverse y }
    };
