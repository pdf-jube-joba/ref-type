\use std.Logic[].Equality[].eq_reason_in;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as R;
\import R.Algebra[] \as Arithmetic;
\import linear_algebra.Field[].Space[K := R.Real, field := Arithmetic.field] \as Spaces;
\import Spaces.CoordinateLine[] \as Line;
\import Spaces.Sign[] \as Sign;
\import Spaces.Laws[V := R.Real, space := Spaces.scalarSpace] \as ScalarLaws;
\definition one: N.Nat^ := Line.one;
\definition two: N.Nat^ := N.Nat^::succ one;
\definition z: Fin.Fin one := Fin.zero N.Nat^::zero;
\import linear_algebra.Euclidean[n := one] \as E;
\import E.Blocks[m := one] \as Blocks;
\import linear_algebra.Euclidean[n := two] \as A;
\import manifolds.Dimension[n := one].Examples[].Euclidean[] \as Source;
\import manifolds.Dimension[n := two].Examples[].Euclidean[] \as Target;
\import manifolds.Dimension[n := one].Smooth[] \as SourceModel;
\import manifolds.Dimension[n := two].Smooth[] \as TargetModel;
\definition M: SourceModel.Manifold := Source.smoothManifold;
\definition ambient: TargetModel.Manifold := Target.smoothManifold;
\import manifolds.SmoothMap[n := one, m := two].Between[M := M, N := ambient] \as Maps;
\import calculus.Real[].Multivariable[n := one].Open[] \as Open;
\import calculus.Real[].Multivariable[n := two].Open[] \as AmbientOpen;
\module Curve;
\definition map: Maps.Map := Curve[].map;
\import manifolds.EuclideanLinear[n := two, m := one].Of[L := Blocks.leftMap] \as Projection;
\import manifolds.EmbeddingRetraction[n := one, m := two].Between[M := M, N := ambient].Of[f := map, g := Projection.map,
  left := \fun (x: M.Point) => Blocks.leftJoin x (Line.forward.apply (R.mul (x z) (x z)))] \as Embedded;
\definition embedding: manifolds.Immersion[n := one, m := two].Between[M := M, N := ambient].Embedding := Embedded.embedding;
\definition immersion: manifolds.Immersion[n := one, m := two].Between[M := M, N := ambient].Immersion :=
  manifolds.Immersion[n := one, m := two].Between[M := M, N := ambient].asImmersion embedding;
\import normal_bundles.Dimension[n := one, k := one].On[M := M].Of[i := immersion] \as Normal;
\import \root.Euclidean[n := one] \as Base;
\import tangent_bundles.Dimension[n := one].On[M := M] \as Tangent;
\definition twice[t: R.Real]: R.Real := R.add t t;
\definition direction[x: M.Point]: A.Vector := Blocks.join (Line.forward.apply (R.neg (twice (x z)))) (Line.forward.apply R.one);
\definition scaled[x: M.Point][a: R.Real]: A.Vector := A.space.smul a (direction x);


\definition dotLine: \forall (v, w: E.Vector) -> E.dot v w = R.mul (v z) (w z) :=
  \fun (v, w: E.Vector) => Spaces.addZeroRight (R.mul (v z) (w z));
\definition solveZero: \forall (a, b: R.Real) -> R.add a b = R.zero -> a = R.neg b :=
  \fun (a, b: R.Real)(same: _) => ScalarLaws.cancelLeft b a (R.neg b)
    (eq_reason_in!{{R.Real} _
      "=" _ "by" { Spaces.addComm b a }
      "=" _ "by" same
      "=" _ "by" { sym!{{R.Real}} _ _ (Spaces.addNegRight b) }
    });
\module At(x: M.Point);

\module Trivialization;
\module Functor;
