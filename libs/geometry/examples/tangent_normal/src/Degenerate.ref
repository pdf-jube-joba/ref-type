\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as R;
\definition zero: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zero;
\import \root.Euclidean[n := zero] \as Base;
\import tangent_bundles.Dimension[n := zero].On[M := Base.M] \as Tangent;
\import manifolds.Tangent[n := zero].On[M := Base.M] \as Intrinsic;
\module At(x: Base.M.Point);
\definition tangentZero: \forall (p: Tangent.Point) -> p = Tangent.zero p.base :=
  \fun (p: Tangent.Point) => trans!{{Tangent.Point}} _ _ _ (sym!{{Tangent.Point}} _ _ (Tangent.eta p))
    (congr!{{Intrinsic.Vector p.base} {Tangent.Point}} (Tangent.include p.base) _ _ (At[x := p.base].zero p.vector));
\import \root.CoordinateInclusion[n := one, k := zero] \as CodimensionZero;
\import normal_bundles.Dimension[n := one, k := zero].On[M := CodimensionZero.M].Of[i := CodimensionZero.immersion] \as Normal;
\import linear_algebra.Euclidean[n := one] \as E;
\definition codimensionZero: \forall (x: CodimensionZero.M.Point)(w: Normal.Fiber x) -> Normal.ambientVector (Normal.include x w) = E.space.zero :=
  \fun (x: CodimensionZero.M.Point)(w: Normal.Fiber x) => \axiom:funext((Normal.ambientVector (Normal.include x w)), E.space.zero,
    \fun (i: Fin.Fin one) => congr!{{E.Vector} {R.Real}} (\fun (v: E.Vector) => v i) _ _ (CodimensionZero.At[x := x].leftZero w));
\import \root.CoordinateInclusion[n := zero, k := zero] \as Origin;
\import normal_bundles.Dimension[n := zero, k := zero].On[M := Origin.M].Of[i := Origin.immersion] \as OriginNormal;
\definition originNormalZero: \forall (x: Origin.M.Point)(w: OriginNormal.Fiber x) -> OriginNormal.ambientVector (OriginNormal.include x w) = linear_algebra.Euclidean[n := zero].space.zero :=
  \fun (x: Origin.M.Point)(w: OriginNormal.Fiber x) =>
    \axiom:funext((OriginNormal.ambientVector (OriginNormal.include x w)), linear_algebra.Euclidean[n := zero].space.zero,
      \fun (i: Fin.Fin zero) => Logic.falseElim _ (Fin.zeroImpossible i (Fin.bound zero i)));
