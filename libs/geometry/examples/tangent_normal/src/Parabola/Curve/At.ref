\import Calculus.Differential[U := Open.whole, V := AmbientOpen.whole, f := calculusMap, a := a] \as D;
\import Fin.Sum[m := one, n := one] \as Indices;
\import Indices.Tuples[A := R.Real] \as Tuples;
\definition projection[i: Fin.Fin one]: Functions.Function := \into[Open.ScalarFunction Open.whole]((\fun (x: Open.Carrier Open.whole) => x i), Functions.Predicate) \by { Open.Examples[].projectionSmooth Open.whole i };
\definition leftComponent: \forall (i: Fin.Fin one) -> D.component (Indices.left i) = projection i :=
  \fun (i: Fin.Fin one) => \axiom:funext((D.component (Indices.left i)), (projection i),
    \fun (x: Open.Carrier Open.whole) => Tuples.atLeft x (Line.forward.apply (Functions.product t t x)) i);
\definition rightComponent: \forall (i: Fin.Fin one) -> D.component (Indices.right i) = Functions.product t t :=
  \fun (i: Fin.Fin one) => \axiom:funext((D.component (Indices.right i)), (Functions.product t t),
    \fun (x: Open.Carrier Open.whole) => Tuples.atRight x (Line.forward.apply (Functions.product t t x)) i);
\definition projectionD: \forall (i: Fin.Fin one)(v: E.Vector) -> (ScalarD.value Open.whole (projection i) a).apply v = v i :=
  \fun (i: Fin.Fin one)(v: E.Vector) => congr!{{E.Vector} {R.Real}} (\fun (w: E.Vector) => w i) _ _
    (congr!{{calculus.Vector[n := one, m := one].LinearMap} {E.Vector}} (\fun (L: calculus.Vector[n := one, m := one].LinearMap) => L.apply v) _ _ (Identity.At[U := Open.whole, a := a].differential));
\definition left: \forall (v: E.Vector) -> Blocks.left (D.value.apply v) = v :=
  \fun (v: E.Vector) => \axiom:funext((Blocks.left (D.value.apply v)), v, \fun (i: Fin.Fin one) => trans!{{R.Real}} _ _ _
    (congr!{{Functions.Function} {R.Real}} (\fun (f: Functions.Function) => (ScalarD.value Open.whole f a).apply v) _ _ (leftComponent i)) (projectionD i v));
\definition right: \forall (v: E.Vector) -> Blocks.right (D.value.apply v) = Line.forward.apply (R.mul (R.add (a z) (a z)) (v z)) :=
  \fun (v: E.Vector) => \axiom:funext((Blocks.right (D.value.apply v)), (Line.forward.apply (R.mul (R.add (a z) (a z)) (v z))), \fun (i: Fin.Fin one) =>
    trans!{{R.Real}} _ _ _ (congr!{{Functions.Function} {R.Real}} (\fun (f: Functions.Function) => (ScalarD.value Open.whole f a).apply v) _ _ (rightComponent i))
      (trans!{{R.Real}} _ _ _ (ScalarD.Operations[U := Open.whole].product t t a v)
        (trans!{{R.Real}} _ _ _ (congr2!{{R.Real} {R.Real} {R.Real}} R.add _ _ _ _
          (congr!{{R.Real} {R.Real}} (R.mul (a z)) _ _ (projectionD z v))
          (congr!{{R.Real} {R.Real}} (R.mul (a z)) _ _ (projectionD z v)))
          (sym!{{R.Real}} _ _ (Spaces.addMul (a z) (a z) (v z))))));
\definition formula: \forall (v: E.Vector) -> D.value.apply v = Blocks.join v (Line.forward.apply (R.mul (R.add (a z) (a z)) (v z))) :=
  \fun (v: E.Vector) => trans!{{A.Vector}} _ _ _ (sym!{{A.Vector}} _ _ (Blocks.recover (D.value.apply v)))
    (congr2!{{E.Vector} {E.Vector} {A.Vector}} Blocks.join _ _ _ _ (left v) (right v));
