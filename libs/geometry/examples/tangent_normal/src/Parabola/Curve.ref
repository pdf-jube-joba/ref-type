\import Open.Smooth[] \as Smooth;
\import Smooth.Algebra[U := Open.whole] \as Functions;
\import Smooth.Differential[] \as ScalarD;
\import calculus.Maps[n := one, m := one] \as LineMaps;
\definition t: Functions.Function := \into[Open.ScalarFunction Open.whole]((\fun (x: Open.Carrier Open.whole) => x z), Functions.Predicate) \by {
  Open.Examples[].projectionSmooth Open.whole z
};
\definition square: LineMaps.Map Open.whole Open.whole := \into[LineMaps.Data[Open.whole, Open.whole]](LineMaps.Data[Open.whole, Open.whole] {
  apply := \fun (x: Open.Carrier Open.whole) => \into[E.Vector](Line.forward.apply (Functions.product t t x), Open.whole.points) \by { \refl(Line.forward.apply (Functions.product t t x)) }
}, { f: LineMaps.Data[Open.whole, Open.whole] \where LineMaps.Laws[Open.whole, Open.whole, f] }) \by {
  LineMaps.Laws[Open.whole, Open.whole, LineMaps.Data[Open.whole, Open.whole] { apply := \fun (x: Open.Carrier Open.whole) => \into[E.Vector](Line.forward.apply (Functions.product t t x), Open.whole.points) \by { \refl(Line.forward.apply (Functions.product t t x)) } }] {
    smooth := \fun (i: Fin.Fin one) => \bysub(Open.ScalarFunction Open.whole, Functions.Predicate, Functions.product t t)
  }
};
\import calculus.Identity[n := one] \as Identity;
\import calculus.Blocks[n := one, m := one].Pair[d := one].On[U := Open.whole, V := Open.whole, W := Open.whole, f := Identity.map Open.whole, g := square] \as Pair;
\import calculus.Maps[n := one, m := two] \as Calculus;
\definition data: Calculus.Data[Open.whole, AmbientOpen.whole] := Calculus.Data[Open.whole, AmbientOpen.whole] {
  apply := \fun (x: Open.Carrier Open.whole) => \into[A.Vector](Pair.value x, AmbientOpen.whole.points) \by { \refl(Pair.value x) }
};
\definition calculusMap: Calculus.Map Open.whole AmbientOpen.whole := \into[Calculus.Data[Open.whole, AmbientOpen.whole]](data,
  { f: Calculus.Data[Open.whole, AmbientOpen.whole] \where Calculus.Laws[Open.whole, AmbientOpen.whole, f] }) \by {
    Calculus.Laws[Open.whole, AmbientOpen.whole, data] { smooth := Pair.smooth }
  };
\import manifolds.EuclideanGlobal[n := one, m := two].Of[f := calculusMap] \as Full;
\definition map: Maps.Map := Full.map;
\definition formula: \forall (x: M.Point) -> Maps.apply map x = Blocks.join x (Line.forward.apply (R.mul (x z) (x z))) :=
  \fun (x: M.Point) => \refl(Maps.apply map x);
\module At(a: Open.Carrier Open.whole);
