\definition local: manifolds.Dimension[n := N.Nat^::zero].Chart[M := Base.M.Point, space := Base.M.space].LocalPoint Base.standard :=
  \into[Base.M.Point](x, Base.standard.domain) \by { \refl(x) };
\import Tangent.InChart[chart := Base.standard].At[x := local] \as Coordinates;
\definition coordinateZero: \forall (v: Intrinsic.Vector x) -> Coordinates.decode v = linear_algebra.Euclidean[n := N.Nat^::zero].space.zero :=
  \fun (v: Intrinsic.Vector x) => \axiom:funext((Coordinates.decode v), linear_algebra.Euclidean[n := N.Nat^::zero].space.zero,
    \fun (i: Fin.Fin N.Nat^::zero) => Logic.falseElim _ (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i)));
\definition zero: \forall (v: Intrinsic.Vector x) -> v = (Intrinsic.space x).zero := \fun (v: Intrinsic.Vector x) => trans!{{Intrinsic.Vector x}} _ _ _
  (sym!{{Intrinsic.Vector x}} _ _ (Coordinates.encodeDecode v))
  (trans!{{Intrinsic.Vector x}} _ _ _ (congr!{{linear_algebra.Euclidean[n := N.Nat^::zero].Vector} {Intrinsic.Vector x}} Coordinates.encode _ _ (coordinateZero v)) Coordinates.zero);
