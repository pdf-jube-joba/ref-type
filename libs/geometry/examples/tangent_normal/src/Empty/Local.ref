\import Maps.Coordinates[f := continuous, left := left, right := right] \as Coordinates;
\module Component(i: std.Data[].FinSet[].Fin Dimension.ambientDimension) {
  \import Open.LocalSmooth[U := Coordinates.domain, f := \fun (u: Open.Carrier Coordinates.domain) => Coordinates.apply u i] \as Local;
  \definition smooth: Open.Smooth[].SmoothOn Coordinates.domain (\fun (u: Open.Carrier Coordinates.domain) => Coordinates.apply u i) :=
    Local.smooth (\fun (u: Open.Carrier Coordinates.domain) => Logic.falseElim _ (Empty.impossible (Charts.point left (Coordinates.leftCoordinate u))));
}
\definition smooth: Coordinates.Smooth := \fun (i: std.Data[].FinSet[].Fin Dimension.ambientDimension) => Component[i := i].smooth;
