\import Normal.Splitting[] \as Split;
\definition point[x: M.Point][v: manifolds.Tangent[n := n].On[M := M].Vector x][a: F.Vector]: Split.Point :=
  Split.include x v (\into[A.Vector](normalInclusion.apply a, (Normal.At[x := x].subspace).carrier) \by { \parent.At[x := x].normal a });
\definition formula: \forall (x: M.Point)(v: manifolds.Tangent[n := n].On[M := M].Vector x)(a: F.Vector) ->
  (Split.forward (point x v a)).vector = A.space.add (Normal.At[x := x].differential.apply v) (normalInclusion.apply a) :=
  \fun (x: M.Point)(v: manifolds.Tangent[n := n].On[M := M].Vector x)(a: F.Vector) => \refl(A.space.add (Normal.At[x := x].differential.apply v) (normalInclusion.apply a));
\import normal_bundles.Stabilization[n := n, k := k].On[M := M].Of[i := immersion] \as Stable;
\import normal_bundles.Dimension[n := n, k := N.Nat^::succ k].On[M := M].Of[i := Stable.immersion].Splitting[] \as NewSplit;
\definition stabilization: \forall (x: M.Point)(v: manifolds.Tangent[n := n].On[M := M].Vector x)(w: Normal.Fiber x)(a: R.Real) ->
  NewSplit.forward (NewSplit.include x v (Stable.At[x := x].newNormal w a)) = Stable.stabilizeProduct (Split.forward (Split.include x v w)) a :=
  Stable.splittingCompatibility;
