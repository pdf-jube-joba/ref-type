
\import linear_algebra.Commutative[K := K, scalarRing := Fields.fieldAsCommutativeRing K field] \as Spaces;
\definition Vector[n: N.Nat^]: \Set := Fin.Fin n -> K;
\definition coordinates[n: N.Nat^]: Spaces.VectorSpace (Vector n) := Spaces.Coordinates[I := Fin.Fin n].space;
\definition scalarTopology: topology.Topology[Carrier := K].Topology := scalar.topological.space;
\definition coordinateTopology[n: N.Nat^]: topology.Topology[Carrier := Vector n].Topology := topological_algebra.Coordinates[K := K, I := Fin.Fin n].topology scalarTopology;
\module Dimension(V: \Set, space: Spaces.VectorSpace V);
\module Family(X: \Set, F: X -> \Set);

\module Morphisms(X, Y: \Set, F: X -> \Set, G: Y -> \Set,
  source: \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F].Bundle,
  target: \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := G].Bundle, f: X -> Y);

\module Identity(X: \Set, F: X -> \Set, bundle: \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F].Bundle);
\module Isomorphisms(X: \Set, F, G: X -> \Set,
  source: \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F].Bundle,
  target: \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := G].Bundle);
\module Trivial(X: \Set, n: N.Nat^, baseSpace: topology.Topology[Carrier := X].Topology);
\module TwoRanks(n, m: N.Nat^);
\module ArrowLaws(X, Y: \Set, F: X -> \Set, G: Y -> \Set,
  source: \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F].Bundle,
  target: \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := G].Bundle, f: X -> Y);
