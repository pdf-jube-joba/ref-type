
\import complex.Complex[] \as C;
\import C.Algebra[] \as Algebra;
\import linear_algebra.Complex[].Dimension[] \as Dimension;
\definition scalar: Scalar[C.Complex, Algebra.field, linear_algebra.Hermitian[].Complex[].scalar] := Scalar[C.Complex, Algebra.field, linear_algebra.Hermitian[].Complex[].scalar] {
  topological := Hermitian.Complex[].topological, naturalInjective := Dimension.injective,
};
