
\definition center: B.Bool^ := B.Bool^::true;
\definition domain: \Pow B.Bool^ := Base.Singleton center;
\import Spaces.Isomorphism[V := Vector n, W := Vector n, source := coordinates n, target := coordinates n] \as LinearIsomorphisms;
\definition identity: LinearIsomorphisms.Isomorphism := LinearIsomorphisms.Isomorphism {
  forward := Spaces.FiniteCoordinates[n := n].identity, backward := Spaces.FiniteCoordinates[n := n].identity,
  leftInverse := \fun (v: Vector n) => \refl(v), rightInverse := \fun (v: Vector n) => \refl(v),
};
\definition frame[y: \Cast[B.Bool^] domain]: Charts.Frame n y :=
  \idelim center = y \with b: B.Bool^ => Charts.Frame n b \by { base: identity, equality: sym!{B.Bool^} _ _ (\bysub(B.Bool^, domain, y)) };
\definition chart: Charts.ChartData := Charts.ChartData { domain := domain, dimension := n, frame := frame };
\import Charts.In[c := chart] \as Local;
\import Base.Subspace[S := domain] \as BaseSubspace;
\import Total.Subspace[S := { p: Family.Point \where Base.Member domain p.base }] \as TotalSubspace;
\import Sum.Universal[C := Vector n] \as Reading;
\definition read: Sum.Carrier -> Vector n := Reading.copair (\fun (v: Vector n) => v) (\fun (v: Vector m) => (coordinates n).zero);
\definition readContinuous: topology.Continuity[A := Sum.Carrier, B := Vector n].Continuous (Sum.topology (coordinateTopology n) (coordinateTopology m)) (coordinateTopology n) read :=
  Reading.continuous (coordinateTopology n) (coordinateTopology m) (coordinateTopology n) (\fun (v: Vector n) => v) (\fun (v: Vector m) => (coordinates n).zero) (topology.Maps[A := Vector n, B := Vector n].Identity[].continuous (coordinateTopology n)) (topology.Maps[A := Vector m, B := Vector n].constantContinuous (coordinateTopology m) (coordinateTopology n) (coordinates n).zero);
\definition frameAtCenter: \forall (equal: center = center) -> frame (\into[B.Bool^](center, domain) \by { equal }) = identity :=
  \fun (equal: center = center) => \transporteq center \with b: B.Bool^ => Charts.Frame n b \by { base: identity };
\definition coordinate: \forall (y: Local.BasePoint)(v: Fiber y) -> (frame y).forward.apply v = read (inject y v) :=
  \fun (y: Local.BasePoint) => (\idelim center = y \with b: B.Bool^ => \forall (equal: b = center)(v: Fiber b) ->
    (frame (\into[B.Bool^](b, domain) \by { equal })).forward.apply v = read (inject b v) \by {
      base: \fun (equal: center = center)(v: Fiber center) => congr!{LinearIsomorphisms.Data {Vector n}} (\fun (h: LinearIsomorphisms.Data) => h.forward.apply v) _ _ (frameAtCenter equal), equality: sym!{B.Bool^} _ _ (\bysub(B.Bool^, domain, y))
    }) (\bysub(B.Bool^, domain, y));
\definition inverse: \forall (y: Local.BasePoint)(v: Vector n) -> Family.include y ((frame y).backward.apply v) = Family.include center v :=
  \fun (y: Local.BasePoint) => (\idelim center = y \with b: B.Bool^ => \forall (equal: b = center)(v: Vector n) ->
    Family.include b ((frame (\into[B.Bool^](b, domain) \by { equal })).backward.apply v) = Family.include center v \by {
      base: \fun (equal: center = center)(v: Vector n) => congr!{LinearIsomorphisms.Data Family.Point} (\fun (h: LinearIsomorphisms.Data) => Family.include center (h.backward.apply v)) _ _ (frameAtCenter equal), equality: sym!{B.Bool^} _ _ (\bysub(B.Bool^, domain, y))
    }) (\bysub(B.Bool^, domain, y));
\import topology.Composition[A := Family.Point, B := Sum.Carrier, C := Vector n] \as Read;
\definition vectorContinuous: topology.Continuity[A := Family.Point, B := Vector n].Continuous topology (coordinateTopology n) (\fun (p: Family.Point) => read (embedding p)) :=
  Read.composeContinuous topology (Sum.topology (coordinateTopology n) (coordinateTopology m)) (coordinateTopology n) embedding read embeddingContinuous readContinuous;
\import topology.Continuity[A := Family.Point, B := B.Bool^].Restriction[S := { p: Family.Point \where Base.Member domain p.base }] \as RestrictBase;
\import topology.Continuity[A := Family.Point, B := Vector n].Restriction[S := { p: Family.Point \where Base.Member domain p.base }] \as RestrictVector;
\import topology.Continuity[A := Local.TotalPoint, B := B.Bool^].Corestriction[S := domain] \as IntoBase;
\import topological_constructions.Product[A := Local.BasePoint, B := Vector n] \as Product;
\import Product.Universal[X := Local.TotalPoint] \as Pairing;
\definition localVector[p: Local.TotalPoint]: Vector n := (frame (Local.base p)).forward.apply p.vector;
\definition localVectorContinuous: topology.Continuity[A := Local.TotalPoint, B := Vector n].Continuous Local.localTopology (coordinateTopology n) localVector :=
  \idelim (\fun (p: Local.TotalPoint) => read (embedding p)) = localVector \with f: (Local.TotalPoint -> Vector n) => topology.Continuity[A := Local.TotalPoint, B := Vector n].Continuous Local.localTopology (coordinateTopology n) f \by {
    base: RestrictVector.restrictContinuous topology (coordinateTopology n) (\fun (p: Family.Point) => read (embedding p)) vectorContinuous,
    equality: \axiom:funext((\fun (p: Local.TotalPoint) => read (embedding p)), localVector, \fun (p: Local.TotalPoint) => sym!{{Vector n}} _ _ (coordinate (Local.base p) p.vector))
  };
\definition forwardContinuous: topology.Continuity[A := Local.TotalPoint, B := Local.ProductPoint].Continuous Local.localTopology Local.productTopology Local.forward :=
  Pairing.pairContinuous Local.localTopology (BaseSubspace.topology Base.Discrete) (coordinateTopology n) Local.base localVector
    (IntoBase.corestrictContinuous Local.localTopology Base.Discrete (\fun (p: Local.TotalPoint) => Local.base p) (RestrictBase.restrictContinuous topology Base.Discrete Family.projection projectionContinuous)) localVectorContinuous;
\definition include[v: Vector n]: Family.Point := Family.include center v;
\definition inclusionContinuous: topology.Continuity[A := Vector n, B := Family.Point].Continuous (coordinateTopology n) topology include :=
  Induced.Universal[Z := Vector n].continuous (coordinateTopology n) (Sum.topology (coordinateTopology n) (coordinateTopology m)) embedding include (Sum.inlContinuous (coordinateTopology n) (coordinateTopology m));
\import Product.Maps[] \as Projections;
\import topology.Composition[A := Local.ProductPoint, B := Vector n, C := Family.Point] \as Include;
\definition model[p: Local.ProductPoint]: Family.Point := include (Pair.second Local.BasePoint (Vector n) p);
\definition backward[p: Local.ProductPoint]: Family.Point := Local.backward p;
\definition backwardContinuous: topology.Continuity[A := Local.ProductPoint, B := Family.Point].Continuous Local.productTopology topology backward :=
  \idelim model = backward \with f: (Local.ProductPoint -> Family.Point) => topology.Continuity[A := Local.ProductPoint, B := Family.Point].Continuous Local.productTopology topology f \by {
    base: Include.composeContinuous Local.productTopology (coordinateTopology n) topology (Pair.second Local.BasePoint (Vector n)) include (Projections.secondContinuous (BaseSubspace.topology Base.Discrete) (coordinateTopology n)) inclusionContinuous,
    equality: \axiom:funext(model, backward, \fun (p: Local.ProductPoint) => sym!{Family.Point} _ _ (inverse (Pair.first Local.BasePoint (Vector n) p) (Pair.second Local.BasePoint (Vector n) p)))
  };
\import topology.Continuity[A := Local.ProductPoint, B := Family.Point].Corestriction[S := { p: Family.Point \where Base.Member domain p.base }] \as IntoLocal;
\definition laws: Local.Laws := Local.Laws {
  baseOpen := Base.discreteOpen domain,
  totalOpen := projectionContinuous domain (Base.discreteOpen domain),
  forwardContinuous := forwardContinuous,
  backwardContinuous := IntoLocal.corestrictContinuous Local.productTopology topology (\fun (p: Local.ProductPoint) => Local.backward p) backwardContinuous,
};
\definition trivialization: Charts.Chart := \into[Charts.ChartData](chart, Charts.Chart) \by { laws };
