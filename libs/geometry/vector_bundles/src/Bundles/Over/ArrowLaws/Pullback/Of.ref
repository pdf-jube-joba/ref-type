\definition targetRegular: TargetPullback.BaseContinuous := BaseComposition.composeContinuous space source.baseSpace target.baseSpace g f regular (baseContinuous a);
\import \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Z, F := \fun (z: Z) => F (g z)] \as PulledSource;
\import \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := Z, Y := Z, F := \fun (z: Z) => F (g z), G := \fun (z: Z) => G (f (g z)), source := SourcePullback.pulled regular, target := TargetPullback.pulled targetRegular, f := \fun (z: Z) => z] \as PulledMaps;
\definition data: PulledMaps.Data := PulledMaps.Data { fiber := \fun (z: Z) => a.fiber (g z) };
\import topology.Composition[A := PulledSource.Point, B := Source.Point, C := Target.Point] \as Compose;
\definition map: PulledMaps.Map := \into[PulledMaps.Data](data, PulledMaps.Map) \by {
  TargetPullback.Universal[Z := PulledSource.Point].continuous SourcePullback.topology (PulledMaps.total data) SourcePullback.projectionContinuous
    (Compose.composeContinuous SourcePullback.topology source.totalSpace target.totalSpace SourcePullback.map (Maps.total a) SourcePullback.mapContinuous (Maps.continuous a))
};
\definition formula: \forall (z: Z)(v: F (g z)) -> (map.fiber z).apply v = (a.fiber (g z)).apply v := \fun (z: Z)(v: F (g z)) => \refl((a.fiber (g z)).apply v);
