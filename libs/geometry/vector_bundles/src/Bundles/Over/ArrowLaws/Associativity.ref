\import Maps.Composition[Z := Z, H := H, range := middle, g := g] \as First;
\import \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := Y, Y := Z, F := G, G := H, source := target, target := middle, f := g] \as SecondMaps;
\import \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := Z, Y := W, F := H, G := J, source := middle, target := range, f := h] \as ThirdMaps;
\import SecondMaps.Composition[Z := W, H := J, range := range, g := h] \as Second;
\import Maps.Composition[Z := W, H := J, range := range, g := \fun (y: Y) => h (g y)] \as Right;
\import \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := Z, F := F, G := H, source := source, target := middle, f := \fun (x: X) => g (f x)].Composition[Z := W, H := J, range := range, g := h] \as Left;
\definition associative: \forall (a: Maps.Map)(b: SecondMaps.Map)(c: ThirdMaps.Map)(x: X)(v: F x) ->
  ((Left.compose (First.compose a b) c).fiber x).apply v = ((Right.compose a (Second.compose b c)).fiber x).apply v :=
  \fun (a: Maps.Map)(b: SecondMaps.Map)(c: ThirdMaps.Map)(x: X)(v: F x) => \refl((c.fiber (g (f x))).apply ((b.fiber (f x)).apply ((a.fiber x).apply v)));
