\import \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := Y, Y := Z, F := G, G := H, source := target, target := range, f := g] \as After;
\import \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := Z, F := F, G := H, source := source, target := range, f := \fun (x: X) => g (f x)] \as Composite;
\import \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Z, F := H] \as Range;
\definition data[a: Map][b: After.Map]: Composite.Data := Composite.Data {
  fiber := \fun (x: X) => Spaces.Linear[V := G (f x), W := H (g (f x)), source := target.space (f x), target := range.space (g (f x))].Composition[U := F x, domain := source.space x].compose (b.fiber (f x)) (a.fiber x),
};
\definition formula: \forall (a: Map)(b: After.Map)(p: Source.Point) -> Composite.total (data a b) p = After.total b (total a p) :=
  \fun (a: Map)(b: After.Map)(p: Source.Point) => \refl(After.total b (total a p));
\import topology.Composition[A := Source.Point, B := Target.Point, C := Range.Point] \as Compose;
\definition compose[a: Map][b: After.Map]: Composite.Map := \into[Composite.Data](data a b, Composite.Map) \by {
  Compose.composeContinuous source.totalSpace target.totalSpace range.totalSpace (total a) (After.total b) (continuous a) (After.continuous b)
};
