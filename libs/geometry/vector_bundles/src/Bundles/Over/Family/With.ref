\definition Frame[n: N.Nat^][x: X]: \Set := Spaces.Isomorphism[V := F x, W := Vector n, source := data.space x, target := coordinates n].Isomorphism;
\structure ChartData: \Set := {
  domain: \Pow X,
  dimension: N.Nat^,
  frame: \forall (x: \Cast[X] domain) -> Frame dimension x,
};
\module In(c: ChartData);
\definition Chart: \Set := \Cast[ChartData] ({ c: ChartData \where \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F].With[data := data].In[c := c].Laws });
\definition LocallyTrivial: \Prop := \forall (x: X) -> \exists ( c: Chart \where Base.Member c.domain x );
