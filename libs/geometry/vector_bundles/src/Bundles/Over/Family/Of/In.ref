\import Local.In[c := c] \as Coordinates;
\import Base.Subspace[S := c.domain] \as BaseSubspace;
\import topological_constructions.Product[A := Coordinates.BasePoint, B := Vector c.dimension] \as Product;
\import Product.Maps[] \as Projections;
\import topology.Composition[A := Coordinates.TotalPoint, B := Coordinates.ProductPoint, C := Coordinates.BasePoint] \as First;
\import topology.Composition[A := Coordinates.TotalPoint, B := Coordinates.BasePoint, C := X] \as Inclusion;
\definition projectionContinuous: topology.Continuity[A := Coordinates.TotalPoint, B := X].Continuous Coordinates.localTopology bundle.baseSpace (\fun (p: Coordinates.TotalPoint) => projection p) :=
  Inclusion.composeContinuous Coordinates.localTopology (BaseSubspace.topology bundle.baseSpace) bundle.baseSpace
    (\fun (p: Coordinates.TotalPoint) => Pair.first Coordinates.BasePoint (Vector c.dimension) (Coordinates.forward p))
    (\fun (x: Coordinates.BasePoint) => x)
    (First.composeContinuous Coordinates.localTopology Coordinates.productTopology (BaseSubspace.topology bundle.baseSpace)
      (\fun (p: Coordinates.TotalPoint) => Coordinates.forward p) (Pair.first Coordinates.BasePoint (Vector c.dimension))
      (chartLaws c).forwardContinuous (Projections.firstContinuous (BaseSubspace.topology bundle.baseSpace) (coordinateTopology c.dimension)))
    (\fun (U: \Pow X)(open: _) => BaseSubspace.traceOpen bundle.baseSpace U open);
