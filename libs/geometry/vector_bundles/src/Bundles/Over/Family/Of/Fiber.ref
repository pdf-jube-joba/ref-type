\definition domain: \Pow Point := { p: Point \where p.base = x };
\definition Carrier: \Set := \Cast[Point] domain;
\definition same[p: Carrier]: p.base = x := \bysub(Point, domain, p);
\definition decode[p: Carrier]: F x := Transport.cast F p.base x (same p) p.vector;
\definition encode[v: F x]: Carrier := \into[Point](include x v, domain) \by { \refl(x) };
\definition decodeEncode: \forall (v: F x) -> decode (encode v) = v := \fun (v: F x) => Transport.castRefl F x v;
\definition encodeDecode: \forall (p: Carrier) -> encode (decode p) = p := \fun (p: Carrier) => trans!{Point} _ _ _
  (includeTransport p.base x (same p) p.vector) (eta p);
\import Spaces.Pullback[V := Carrier, W := F x, target := bundle.space x] \as Transfer;
\definition bijection: Transfer.Bijection := Transfer.Bijection { forward := decode, backward := encode, leftInverse := encodeDecode, rightInverse := decodeEncode };
\import Transfer.Of[bijection := bijection] \as Pullback;
\definition vectorSpace: Spaces.VectorSpace Carrier := Pullback.space;
\definition isomorphism: Spaces.Isomorphism[V := Carrier, W := F x, source := vectorSpace, target := bundle.space x].Isomorphism := Pullback.isomorphism;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Total.Subspace[S := domain].topology bundle.totalSpace;
