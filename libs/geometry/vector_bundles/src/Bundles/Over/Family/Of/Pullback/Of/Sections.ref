\import \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F].Of[bundle := bundle].Sections[] \as Source;
\import Pulled.Sections[] \as Target;
\import topology.Composition[A := Y, B := X, C := Point] \as Compose;
\definition data[s: Source.Section]: Target.SectionData := Target.SectionData { value := \fun (y: Y) => s.value (f y) };
\definition pullback[s: Source.Section]: Target.Section := \into[Target.SectionData](data s, Target.Section) \by {
  \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F].Of[bundle := bundle].Pullback[Y := Y, source := source, f := f].Universal[Z := Y].continuous source (Target.total (data s))
    (topology.Maps[A := Y, B := Y].Identity[].continuous source)
    (Compose.composeContinuous source bundle.baseSpace bundle.totalSpace f (Source.total s) regular (Source.continuous s))
};
\definition formula: \forall (s: Source.Section)(y: Y) -> (pullback s).value y = s.value (f y) := \fun (s: Source.Section)(y: Y) => \refl(s.value (f y));
