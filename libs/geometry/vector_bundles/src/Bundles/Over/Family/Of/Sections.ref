\structure SectionData: \Set := { value: \forall (x: X) -> F x };
\definition total[s: SectionData][x: X]: Point := include x (s.value x);
\definition Section: \Set := \Cast[SectionData] ({ s: SectionData \where topology.Continuity[A := X, B := Point].Continuous bundle.baseSpace bundle.totalSpace (total s) });
\definition continuous: \forall (s: Section) -> topology.Continuity[A := X, B := Point].Continuous bundle.baseSpace bundle.totalSpace (total s) :=
  \fun (s: Section) => \bysub(SectionData, Section, s);
\definition section: \forall (s: Section)(x: X) -> projection (total s x) = x := \fun (s: Section)(x: X) => \refl(x);
\definition zeroData: SectionData := SectionData { value := \fun (x: X) => (bundle.space x).zero };
\module In(c: Local.Chart);
\definition LocallyRegular[s: SectionData]: \Prop := \forall (c: Local.Chart) -> In[c := c].Regular s;
\import topology.Continuity[A := X, B := Point].Covered[I := Local.Chart, domains := \fun (c: Local.Chart) => c.domain] \as Covered;
\definition regular: \forall (s: SectionData) -> LocallyRegular s -> topology.Continuity[A := X, B := Point].Continuous bundle.baseSpace bundle.totalSpace (total s) :=
  \fun (s: SectionData)(local: LocallyRegular s) => Covered.continuous bundle.baseSpace bundle.totalSpace (total s)
    (\fun (c: Local.Chart) => (chartLaws c).baseOpen) locallyTrivial (\fun (c: Local.Chart) => In[c := c].continuous s (local c));
\definition zero: Section := \into[SectionData](zeroData, Section) \by { regular zeroData (\fun (c: Local.Chart) => In[c := c].zeroRegular) };
