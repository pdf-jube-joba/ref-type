\import \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F] \as Family;
\import \root.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := F, G := F, source := bundle, target := bundle, f := \fun (x: X) => x] \as Maps;
\definition data: Maps.Data := Maps.Data {
  fiber := \fun (x: X) => Spaces.Linear[V := F x, W := F x, source := bundle.space x, target := bundle.space x].Map {
    apply := \fun (v: F x) => v, preservesAdd := \fun (v, w: F x) => \refl((bundle.space x).add v w),
    preservesScale := \fun (a: K)(v: F x) => \refl((bundle.space x).smul a v),
  },
};
\definition totalIdentity: \forall (p: Family.Point) -> Maps.total data p = p := Family.eta;
\definition map: Maps.Map := \into[Maps.Data](data, Maps.Map) \by {
  \idelim (\fun (p: Family.Point) => p) = Maps.total data \with f: (Family.Point -> Family.Point) => topology.Continuity[A := Family.Point, B := Family.Point].Continuous bundle.totalSpace bundle.totalSpace f \by {
    base: topology.Maps[A := Family.Point, B := Family.Point].Identity[].continuous bundle.totalSpace,
    equality: \axiom:funext((\fun (p: Family.Point) => p), Maps.total data, \fun (p: Family.Point) => sym!{Family.Point} _ _ (totalIdentity p))
  }
};
\definition onFiber: \forall (x: X)(v: F x) -> (map.fiber x).apply v = v := \fun (x: X)(v: F x) => \refl(v);
