
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].List[] \as Lists;
\import std.Data[].Pair[] \as Pair;
\import std.Alg[].Field[] \as Fields;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import hermitian_frames.Hermitian[] \as Hermitian;
\definition natural[K: \Set][field: Fields.Field[K]]: N.Nat^ -> K :=
  \induction (n: N.Nat^) \return K \with {
    | zero: field.zero
    | succ: \fun (n: N.Nat^)(previous: K) => field.add field.one previous
  };
\structure Scalar[K: \Set, field: Fields.Field[K], conjugation: linear_algebra.Hermitian[].Scalar[K, field]]: \Set := {
  topological: Hermitian.ScalarTopology[K, field, conjugation],
  naturalInjective: \forall (n, m: N.Nat^) -> natural K field n = natural K field m -> n = m,
};
\module Real;
\module Complex;
\module Over(K: \Set, field: Fields.Field[K], conjugation: linear_algebra.Hermitian[].Scalar[K, field], scalar: \root.Bundles[].Scalar[K, field, conjugation]);
\module Examples;
