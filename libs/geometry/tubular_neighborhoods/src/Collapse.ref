\import std.Data[].Nat[] \as Nat;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import topology.Topology[Carrier := A] \as Space;
\import thom_spaces.Thom[].Collapse[A := D,source := disk,subset := sphere] \as Thom;
\structure Chart: \Set := {
  shell: \Pow A, closed: Space.IsClosedIn space shell,
  core: \Pow A, open: Space.IsOpenIn space core, included: Space.Subset core shell,
  read: \Cast[A] shell -> D,
  continuous: topology.Continuity[A := \Cast[A] shell,B := D].Continuous (Space.Subspace[S := shell].topology space) disk read,
  seam: \forall (x: \Cast[A] shell) -> Logic.Not (Space.Member core x) -> \In[D] sphere (read x),
};
\module Of(c: Chart);
