\import std.Data[].Nat[] \as Nat;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as O;
\import topology.Topology[Carrier := A] \as S;
\import topology.Topology[Carrier := N] \as T;
\import metric_spaces.RealLine[] \as Line;
\definition ball: \Pow N := { v: N \where O.Le (squared v) R.one };
\definition Disk: \Set := \Cast[N] ball;
\definition disk: topology.Structures[].Topology[Disk] := T.Subspace[S := ball].topology normals;
\definition sphere: \Pow Disk := { v: Disk \where squared v = R.one };
\import \root.Collapse[A := A,D := Disk,space := space,disk := disk,sphere := sphere] \as Collapse;
\structure Coordinates: \Set := {
  tube: \Pow A, open: S.IsOpenIn space tube, read: \Cast[A] tube -> N,
  continuous: topology.Continuity[A := \Cast[A] tube,B := N].Continuous (S.Subspace[S := tube].topology space) normals read,
};
\module On(c: Coordinates, sizeContinuous: metric_spaces.RealFunctions[A := N].Continuous normals squared);
