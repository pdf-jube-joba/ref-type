\import dedekind_reals.DedekindReal[] \as O;
\import O.Arithmetic[].Prop[] \as Field;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Bool[] \as Bool;
\import Nat.Basic[].Def[] \as N;
\import Nat.Basic[].Prop[] \as NL;
\import manifolds.Tangent[n := n].On[M := M] \as Tangent;
\definition height[x: M.Point]: R.Real := Maps.apply e x j;
\definition test[i: Fin.Fin d]: Bool.Bool^ := N.eqb i j;
\definition entry[x: M.Point][i: Fin.Fin d]: R.Real := Bool.ite R.Real (test i) (height x) R.one;
\definition weight[x: M.Point][i: Fin.Fin d]: R.Real := R.mul (entry x i) (entry x i);
\definition action[x: M.Point]: End.LinearMap := End.LinearMap {
  apply := \fun (v: E.Vector)(i: Fin.Fin d) => R.mul (weight x i) (v i),
  preservesAdd := \fun (v,w: E.Vector) => \axiom:funext(
    (\fun (i: Fin.Fin d) => R.mul (weight x i) (R.add (v i) (w i))),
    (\fun (i: Fin.Fin d) => R.add (R.mul (weight x i) (v i)) (R.mul (weight x i) (w i))),
    \fun (i: Fin.Fin d) => Field.fieldMulAdd (weight x i) (v i) (w i)),
  preservesScale := \fun (a: R.Real)(v: E.Vector) => \axiom:funext(
    (\fun (i: Fin.Fin d) => R.mul (weight x i) (R.mul a (v i))),
    (\fun (i: Fin.Fin d) => R.mul a (R.mul (weight x i) (v i))),
    \fun (i: Fin.Fin d) => R.Algebra[].mulSwap (weight x i) a (v i)),
};
\definition vertical[x: M.Point]: entry x j = height x :=
  congr!{{Bool.Bool^} {R.Real}} (\fun (b: Bool.Bool^) => Bool.ite R.Real b (height x) R.one) _ _ (NL.eqbRefl j);
\definition scaled[x: M.Point][w: E.Vector][i: Fin.Fin d]: R.Real := R.mul (entry x i) (w i);
\definition energy[x: M.Point][w: E.Vector]: E.dot w ((action x).apply w) = E.squared (scaled x w) :=
  R.FiniteSums[].congruent d _ _ (\fun (i: Fin.Fin d) => trans!{{R.Real}} _ _ _
    (R.Algebra[].mulSwap (w i) (weight x i) (w i))
    (sym!{{R.Real}} _ _ (R.Algebra[].mulFour (entry x i) (w i) (entry x i) (w i))));
\definition cancel[a,b: R.Real][nonzero: Logic.Not (a = R.zero)][vanishes: R.mul a b = R.zero]: b = R.zero := eq_reason_in!{{R.Real} b
  "=" _ "by" { sym!{{R.Real}} _ _ (Field.fieldMulOneLeft b) }
  "=" _ "by" { congr!{{R.Real} {R.Real}} (\fun (q: R.Real) => R.mul q b) _ _ (sym!{{R.Real}} _ _ (Field.fieldInverseNonzero _ nonzero)) }
  "=" _ "by" { Field.fieldMulAssoc _ _ _ }
  "=" _ "by" { congr!{{R.Real} {R.Real}} (R.mul (Field.fieldInv a)) _ _ vanishes }
  "=" _ "by" { Field.fieldMulZeroRight _ }
};
\definition Transverse: \Prop := \forall (x: M.Point) -> height x = R.zero ->
  \exists ( v: Tangent.Vector x \where Logic.Not ((Normal.At[x := x].differential.apply v) j = R.zero) );
\module InChart(b: Normal.Local);
\module Kernel(x: M.Point,w: Normal.Fiber x,vanishes: E.dot w ((action x).apply w) = R.zero);
\module Crossing(transverse: Transverse);
