\definition endpoint[p: Normal.Point]: E.Vector := E.space.add (Maps.apply e p.base) ((lift.action p.base).apply (Normal.ambientVector p));
\definition atZero[x: M.Point]: endpoint (zero x) = Maps.apply e x := trans!{{E.Vector}} _ _ _
  (congr!{{E.Vector} {E.Vector}} (E.space.add (Maps.apply e x)) _ _ (lift.action x).preservesZero) (Laws.zeroRight _);
\import manifolds.FromCharts[n := d, m := d].Between[M := Normal.manifold, N := Bundle.ambient].Covered[I := Normal.Local, chart := Normal.totalChart, covers := Normal.chartCover] \as Plots;
\import manifolds.Dimension[n := d].Chart[M := E.Vector, space := Bundle.ambient.space] \as TargetCharts;
\import manifolds.Dimension[n := d].Atlas[M := E.Vector, space := Bundle.ambient.space] \as TargetAtlas;
\definition standard: \Cast[TargetCharts.Chart] Bundle.ambient.atlas.charts := \into[TargetCharts.Chart](Ambient.standard, Bundle.ambient.atlas.charts) \by {
  TargetAtlas.includedInSaturation Ambient.atlas Ambient.standard (\refl(Ambient.standard))
};
\import \root.Shrinking[A := Normal.Point, B := E.Vector, source := Normal.topology, target := Bundle.ambient.space, f := endpoint] \as Shrink;
\structure Patch: \Set := {
  chart: \Cast[TotalCharts.Chart] Normal.manifold.atlas.charts, image: Open.OpenSet, change: Diff.Diffeomorphism chart.image image,
  formula: \forall (p: TotalCharts.LocalPoint chart) -> C.apply chart.image image change.forward (TotalCharts.coordinate chart p) = endpoint p,
};
\module Local(p: Patch);
\module Frame(b: Normal.Local);
\definition plots: Plots.Family := \fun (b: Normal.Local) => Frame[b := b].plot;
\import Plots.Of[f := endpoint, maps := plots, agrees := \fun (b: Normal.Local)(u: Open.Carrier (Normal.totalChart b).image) => \refl(endpoint (TotalCharts.point (Normal.totalChart b) u))] \as Built;
\definition map: TotalMaps.Map := TotalMaps.Named[f := Built.value,function := endpoint,same := Built.apply].map;
\definition continuous: topology.Continuity[A := Normal.Point, B := E.Vector].Continuous Normal.topology Bundle.ambient.space endpoint :=
  \idelim TotalMaps.apply map = endpoint \with g: (Normal.Point -> E.Vector) => topology.Continuity[A := Normal.Point, B := E.Vector].Continuous Normal.topology Bundle.ambient.space g \by {
    base: \bysub(TotalMaps.Data, { g: TotalMaps.Data \where TotalMaps.Continuous g }, map), equality: \refl(endpoint)
  };
\module InverseOn(V: Open.OpenSet) {
  \import Ambient.Subspace[U := V] \as Source;
  \import manifolds.SmoothMap[n := d,m := d].Between[M := Source.smoothManifold,N := Normal.manifold] \as Maps;
  \definition Map: \Set := Maps.Map;
  \definition continuous[f: Map]: topology.Continuity[A := Open.Carrier V,B := Normal.Point].Continuous
    (Open.Topology[].Of[U := V].topology) Normal.topology f.apply :=
    \bysub(Maps.Data,{ g: Maps.Data \where Maps.Continuous g },f);
}
\definition InverseMap[V: Open.OpenSet]: \Set := InverseOn[V := V].Map;
\structure Neighborhood: \Set := {
  domain: \Pow Normal.Point, open: S.IsOpenIn Normal.topology domain,
  section: \forall (x: M.Point) -> S.Member domain (zero x),
  image: Open.OpenSet, inverse: InverseMap image,
  into: \forall (q: \Cast[Normal.Point] domain) -> T.Member image.points (endpoint q),
  back: \forall (y: Open.Carrier image) -> S.Member domain (inverse.apply y),
  left: \forall (q: \Cast[Normal.Point] domain) -> inverse.apply (\into[E.Vector](endpoint q,image.points) \by { into q }) = q,
  right: \forall (y: Open.Carrier image) -> endpoint (inverse.apply y) = y,
};
\module Disk;
\module Inside(t: Neighborhood);
\module Restriction(t: Neighborhood);
\structure DiskNeighborhood: \Set := {
  tube: Neighborhood, width: Inside[t := tube].Width,
  collapse: E.Vector -> Disk[].Thom,
  continuous: topology.Continuity[A := E.Vector,B := Disk[].Thom].Continuous Bundle.ambient.space Disk[].thomTopology collapse,
  law: Disk[].CollapseLaw[width.radius,collapse],
};
\module Compact(compact: BaseSpace.IsCompact M.space);
\module Compare(left,right: Neighborhood, first: \parent.Inside[t := left].Width,second: \parent.Inside[t := right].Width,compact: BaseSpace.IsCompact M.space);

