\import manifolds.ChartRestriction[n := d].On[M := Normal.manifold].At[c := Normal.totalChart b,U := local.domain,included := local.included] \as Restricted;
\definition patch: Patch := Patch {
  chart := Restricted.chart, image := local.target, change := local.equivalence,
  formula := \fun (p: TotalCharts.LocalPoint Restricted.chart) => trans!{{E.Vector}} _ _ _ (local.forward (Restricted.forward p))
    (congr!{Normal.Point {E.Vector}} endpoint _ _ (Restricted.leftInverse p)),
};
\definition center: Open.Carrier local.domain := \into[E.Vector](z,local.domain.points) \by { local.contains };
\definition contains: S.Member patch.chart.domain (zero x) :=
  \idelim TotalCharts.point (Normal.totalChart b) z = zero x \with p: Normal.Point => S.Member patch.chart.domain p \by {
    base: Restricted.pointMember center,
    equality: tangent_bundles.FrameBundle[n := n,r := k].Over[M := M].Family[F := Normal.Fiber,space := Normal.fiberSpace].Using[I := Normal.Local,data := Normal.framesData].Build[changes := Normal.changes].Zero[].Local[i := b].agrees u
  };
