\import E.Gram[k := d].Of[A := derivative,factor := factor] \as Decomposition;
\import matrix_invariants.Ring[K := R.Real,scalars := std.Alg[].Field[].fieldAsCommutativeRing R.Real R.Algebra[].field].At[n := d] \as Matrix;
\import Matrix.Representation[] \as Rep;
\import Inverse.OneSided[d := Decomposition.inverse,e := derivative] \as LeftInverse;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Field;
\definition nonzero: Inverse.InverseFunction[U := P.domain,f := coordinateMap,a := z].Nonsingular :=
  \fun (vanishes: _) => Field.zeroNeOne (eq_reason_in!{{R.Real} R.zero
    "=" _ "by" { sym!{{R.Real}} _ _ (Field.fieldMulZeroRight (Matrix.determinant (Rep.entries Decomposition.inverse))) }
    "=" _ "by" { congr!{{R.Real} {R.Real}} (R.mul (Matrix.determinant (Rep.entries Decomposition.inverse))) _ _ (sym!{{R.Real}} _ _ vanishes) }
    "=" _ "by" { sym!{{R.Real}} _ _ (Matrix.multiplicative _ _) }
    "=" _ "by" { congr!{Matrix.Matrix {R.Real}} Matrix.determinant _ _ (LeftInverse.product Decomposition.leftInverse) }
    "=" _ "by" { Matrix.atIdentity }
  });
