\import \parent.Family[radius := \fun (s: I.Carrier) => r,regular := metric_spaces.RealFunctions[A := I.Carrier].constantContinuous I.topology r,
  positive := \fun (s: I.Carrier) => positive,within := \fun (s: I.Carrier) => within,compact := compact] \as Constant;
\definition chart: Collapse.Chart := Constant.Slice[s := I.start].chart;
\definition collapse: E.Vector -> D.Thom := Collapse.Of[c := chart].map;
\definition continuous: topology.Continuity[A := E.Vector,B := D.Thom].Continuous Bundle.ambient.space D.thomTopology collapse := Collapse.Of[c := chart].continuous;
\definition law: D.CollapseLaw[r,collapse] := Constant.Slice[s := I.start].law;
