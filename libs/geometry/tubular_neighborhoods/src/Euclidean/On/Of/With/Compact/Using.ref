\module Window(p: Patch);
\definition windows: \Pow (\Pow E.Vector) := { V: \Pow E.Vector \where \exists ( p: Patch \where (Window[p := p].domain).points = V ) };
\definition image: Open.OpenSet := Open.Topology[].ofOpen (T.Union windows) ((T.topologyLaws Bundle.ambient.space).unionOpen windows (\block {
  \fun (V: \Pow E.Vector)(h: _) \then
  \takefrom p: \Cast[Patch] ({ p: Patch \where (Window[p := p].domain).points = V }) \by h \then
  \return \idelim (Window[p := p].domain).points = V \with W: \Pow E.Vector => T.IsOpenIn Bundle.ambient.space W \by {
    base: Open.Topology[].open Window[p := p].domain, equality: \bysub(Patch,{ p: Patch \where (Window[p := p].domain).points = V },p)
  }
}));
\definition within[p: Patch]: Open.Included Window[p := p].domain image := \fun (y: E.Vector)(inside: _) => T.unionMemberOf windows _ y
  (Logic.existsIntro[Patch,{ q: Patch \where (Window[p := q].domain).points = (Window[p := p].domain).points }] p (\refl((Window[p := p].domain).points))) inside;
\import manifolds.SmoothCover[n := d,m := d].On[U := image,N := Normal.manifold,I := Patch,domains := \fun (p: Patch) => Window[p := p].domain] \as Cover;
\definition covers: Cover.Covers := \fun (y: Open.Carrier image) => T.unionMemberElim windows y _
  (\block {
    \fun (V: \Pow E.Vector)(h: _)(member: _) \then
    \takefrom p: \Cast[Patch] ({ p: Patch \where (Window[p := p].domain).points = V }) \by h \then
    \return Logic.existsIntro[Patch,{ p: Patch \where \In[E.Vector] (Window[p := p].domain).points y }] p
      (\idelim V = (Window[p := p].domain).points \with W: \Pow E.Vector => T.Member W y \by {
        base: member,equality: sym!{{\Pow E.Vector}} _ _ (\bysub(Patch,{ p: Patch \where (Window[p := p].domain).points = V },p))
      })
  }) (\bysub(E.Vector,image.points,y));
\definition Preimage[y: E.Vector]: \Set := \Cast[Normal.Point] ({ q: Normal.Point \where Logic.And[S.Member tube.domain q,endpoint q = y] });
\definition preimage[y: Open.Carrier image]: \exists Preimage y := \block {
  \takefrom p: \Cast[Patch] ({ p: Patch \where T.Member (Window[p := p].domain).points y }) \by covers y \then
  \let v: Open.Carrier Window[p := p].domain := \into[E.Vector](y,(Window[p := p].domain).points) \by { \bysub(Patch,{ p: Patch \where T.Member (Window[p := p].domain).points y },p) } \then
  \return \exact(\into[Normal.Point](Window[p := p].undo v,Preimage y) \by { Logic.And[_, _]::# (Window[p := p].inside v) (Window[p := p].equation v) },Preimage y)
};
\definition unique[y: E.Vector][a,b: Preimage y]: a = b := \block {
  \let ha: Logic.And[S.Member tube.domain a,endpoint a = y] := \bysub(Normal.Point,Preimage y,a) \then
  \let hb: Logic.And[S.Member tube.domain b,endpoint b = y] := \bysub(Normal.Point,Preimage y,b) \then
  \return tube.injective a b ha.left hb.left (trans!{{E.Vector}} _ _ _ ha.right (sym!{{E.Vector}} _ _ hb.right))
};
\definition selected[y: Open.Carrier image]: Preimage y := \choice Preimage y \by { existence: preimage y, uniqueness: unique y };
\definition backward[y: Open.Carrier image]: Normal.Point := selected y;
\definition inverseLaw[y: Open.Carrier image]: Logic.And[S.Member tube.domain (backward y), endpoint (backward y) = y] := \bysub(Normal.Point,Preimage y,selected y);
\definition agree: Cover.Agreement backward (\fun (p: Patch) => Window[p := p].map) within := \fun (p: Patch)(y: Open.Carrier Window[p := p].domain) =>
  tube.injective _ _ (inverseLaw (Open.inclusion _ _ (within p) y)).left (Window[p := p].inside y)
    (trans!{{E.Vector}} _ _ _ (inverseLaw (Open.inclusion _ _ (within p) y)).right (sym!{{E.Vector}} _ _ (Window[p := p].equation y)));
\definition smoothInverse: InverseMap image := Cover.Of[f := backward,maps := \fun (p: Patch) => Window[p := p].map,included := within,agrees := agree,covers := covers].value;
\definition domain: \Pow Normal.Point := S.Intersection tube.domain ({ q: Normal.Point \where T.Member image.points (endpoint q) });
\definition open: S.IsOpenIn Normal.topology domain := (S.topologyLaws Normal.topology).intersectionOpen _ _ tube.open (continuous image.points (Open.Topology[].open image));
\definition section[x: M.Point]: S.Member domain (zero x) := \block {
  \takefrom p: \Cast[Patch] ({ p: Patch \where S.Member p.chart.domain (zero x) }) \by patchAt x \then
  \let q: TotalCharts.LocalPoint p.chart := \into[Normal.Point](zero x,p.chart.domain) \by { \bysub(Patch,{ p: Patch \where S.Member p.chart.domain (zero x) },p) } \then
  \let member: S.Member tube.domain (zero x) := tube.covers (zero x) (Z.imageMember zero BaseSpace.Whole x (\refl(x))) \then
  \let inWindow: T.Member (Window[p := p].domain).points (endpoint (zero x)) := Window[p := p].forwardMember q member \then
  \let inImage: T.Member image.points (endpoint (zero x)) := within p (endpoint (zero x)) inWindow \then
  \return Logic.And[S.Member tube.domain (zero x),T.Member image.points (endpoint (zero x))]::# member inImage
};
\definition forward[q: \Cast[Normal.Point] domain]: Open.Carrier image := \into[E.Vector](endpoint q,image.points) \by { (\bysub(Normal.Point,domain,q)).right };
\definition left[q: \Cast[Normal.Point] domain]: backward (forward q) = q := tube.injective _ _ (inverseLaw (forward q)).left
  (\bysub(Normal.Point,domain,q)).left (inverseLaw (forward q)).right;
\definition right[y: Open.Carrier image]: endpoint (backward y) = y := (inverseLaw y).right;

\definition neighborhood: Neighborhood := Neighborhood {
  domain := domain, open := open, section := section, image := image, inverse := smoothInverse,
  into := \fun (q: \Cast[Normal.Point] domain) => (\bysub(Normal.Point,domain,q)).right,
  back := \fun (y: Open.Carrier image) => Logic.And[_, _]::# (inverseLaw y).left
    (\idelim y = endpoint (backward y) \with v: E.Vector => T.Member image.points v \by {
      base: \bysub(E.Vector,image.points,y), equality: sym!{{E.Vector}} _ _ (right y)
    }), left := left, right := right,
};
