\import algebraic_topology.Cylinder[A := D.Point] \as Disks;
\definition ambient: topology.Structures[].Topology[Cylinder.Carrier] := Cylinder.topology Bundle.ambient.space;
\definition source: topology.Structures[].Topology[Disks.Carrier] := Disks.topology D.topology;
\import topology.Topology[Carrier := Cylinder.Carrier] \as A;
\import topology.Topology[Carrier := Disks.Carrier] \as B;
\import topology.Maps[A := Disks.Carrier,B := Cylinder.Carrier] \as Sets;
\import topological_constructions.Product[A := I.Carrier,B := E.Vector] \as Product;
\import \root.DiskImage[A := Cylinder.Carrier,N := Normal.Point,space := ambient,normals := Normal.topology,squared := D.squared] \as Model;
\definition scaled[p: Disks.Carrier]: Normal.Point := D.scale (radius (Disks.time p)) (Disks.point p);
\definition radiusContinuous: metric_spaces.RealFunctions[A := Disks.Carrier].Continuous source (\fun (p: Disks.Carrier) => radius (Disks.time p)) :=
  topology.Composition[A := Disks.Carrier,B := I.Carrier,C := R.Real].composeContinuous _ _ _ Disks.time radius (Disks.timeContinuous D.topology) regular;
\definition pointContinuous: topology.Continuity[A := Disks.Carrier,B := Normal.Point].Continuous source Normal.topology (\fun (p: Disks.Carrier) => Disks.point p) :=
  topology.Composition[A := Disks.Carrier,B := D.Point,C := Normal.Point].composeContinuous _ _ _ Disks.point (\fun (q: D.Point) => q) (Disks.pointContinuous D.topology) D.inclusion;
\definition scaledContinuous: topology.Continuity[A := Disks.Carrier,B := Normal.Point].Continuous source Normal.topology scaled :=
  D.Family[X := Disks.Carrier,source := source,a := \fun (p: Disks.Carrier) => radius (Disks.time p),q := \fun (p: Disks.Carrier) => Disks.point p,
    scalar := radiusContinuous,regular := pointContinuous].continuous;
\definition place[p: Disks.Carrier]: Cylinder.Carrier := Cylinder.at (Disks.time p) (endpoint (scaled p));
\definition placeContinuous: topology.Continuity[A := Disks.Carrier,B := Cylinder.Carrier].Continuous source ambient place :=
  Product.Universal[X := Disks.Carrier].pairContinuous source I.topology Bundle.ambient.space Disks.time (\fun (p: Disks.Carrier) => endpoint (scaled p))
    (Disks.timeContinuous D.topology) (topology.Composition[A := Disks.Carrier,B := Normal.Point,C := E.Vector].composeContinuous _ _ _ scaled endpoint scaledContinuous continuous);
\definition tube: \Pow Cylinder.Carrier := { p: Cylinder.Carrier \where T.Member t.image.points (Cylinder.point p) };
\definition tubeOpen: A.IsOpenIn ambient tube := Cylinder.pointContinuous Bundle.ambient.space t.image.points (Open.Topology[].open t.image);
\import A.Subspace[S := tube] \as U;
\definition space: topology.Structures[].Topology[U.CarrierSet] := U.topology ambient;
\definition y[p: U.CarrierSet]: Open.Carrier t.image := \into[E.Vector](Cylinder.point p,t.image.points) \by { \bysub(Cylinder.Carrier,tube,p) };
\definition multiplier[s: I.Carrier]: R.Real := Field.fieldInv (radius s);
\definition times[s: I.Carrier]: R.mul (multiplier s) (radius s) = R.one := Field.fieldInverseNonzero _ (R.Inverse[].positiveNonzero _ (positive s));
\definition read[p: U.CarrierSet]: Normal.Point := D.scale (multiplier (Cylinder.time p)) (t.inverse.apply (y p));
\definition inc: topology.Continuity[A := U.CarrierSet,B := Cylinder.Carrier].Continuous space ambient (\fun (p: U.CarrierSet) => p) :=
  topology.Continuity[A := Cylinder.Carrier,B := Cylinder.Carrier].Corestriction[S := tube].inclusionContinuous ambient;
\definition scalarContinuous: metric_spaces.RealFunctions[A := U.CarrierSet].Continuous space (\fun (p: U.CarrierSet) => multiplier (Cylinder.time p)) :=
  topology.Composition[A := U.CarrierSet,B := I.Carrier,C := R.Real].composeContinuous _ _ _ _ multiplier
    (topology.Composition[A := U.CarrierSet,B := Cylinder.Carrier,C := I.Carrier].composeContinuous _ _ _ _ Cylinder.time inc (Cylinder.timeContinuous Bundle.ambient.space))
    (metric_spaces.RealFunctions[A := I.Carrier].Reciprocal[].continuousPositive I.topology radius regular positive);
\definition yContinuous: topology.Continuity[A := U.CarrierSet,B := Open.Carrier t.image].Continuous space (Open.Topology[].Of[U := t.image].topology) y :=
  topology.Continuity[A := U.CarrierSet,B := E.Vector].Corestriction[S := t.image.points].corestrictContinuous _ _ y
    (topology.Composition[A := U.CarrierSet,B := Cylinder.Carrier,C := E.Vector].composeContinuous _ _ _ _ Cylinder.point inc (Cylinder.pointContinuous Bundle.ambient.space));
\definition inverseRegular: topology.Continuity[A := U.CarrierSet,B := Normal.Point].Continuous space Normal.topology (\fun (p: U.CarrierSet) => t.inverse.apply (y p)) :=
  topology.Composition[A := U.CarrierSet,B := Open.Carrier t.image,C := Normal.Point].composeContinuous _ _ _ y t.inverse.apply yContinuous inverseContinuous;
\definition coords: Model.Coordinates := Model.Coordinates {
  tube := tube,open := tubeOpen,read := read,continuous := D.Family[X := U.CarrierSet,source := space,
    a := \fun (p: U.CarrierSet) => multiplier (Cylinder.time p),q := \fun (p: U.CarrierSet) => t.inverse.apply (y p),scalar := scalarContinuous,
    regular := inverseRegular].continuous,
};
\import Model.On[c := coords,sizeContinuous := D.continuous] \as Region;
\definition placed[p: Disks.Carrier]: U.CarrierSet := \into[Cylinder.Carrier](place p,tube) \by {
  t.into (\into[Normal.Point](scaled p,t.domain) \by { within (Disks.time p) (Disks.point p) })
};
\definition readPlace[p: Disks.Carrier]: read (placed p) = Disks.point p := trans!{Normal.Point} _ _ _
  (congr!{Normal.Point Normal.Point} (D.scale (multiplier (Disks.time p))) _ _
    (t.left (\into[Normal.Point](scaled p,t.domain) \by { within (Disks.time p) (Disks.point p) })))
  (D.cancel _ _ (Disks.point p) (times (Disks.time p)));
\definition placeRead[p: U.CarrierSet][bounded: O.Le (D.squared (read p)) R.one]:
  place (Disks.at (Cylinder.time p) (\into[Normal.Point](read p,D.closedBall) \by { bounded })) = p :=
  Pair.Prop[A := I.Carrier,B := E.Vector].ext
    (place (Disks.at (Cylinder.time p) (\into[Normal.Point](read p,D.closedBall) \by { bounded }))) p
    (\refl(Cylinder.time p)) (trans!{{E.Vector}} _ _ _
    (congr!{Normal.Point {E.Vector}} endpoint _ _ (D.cancel _ _ (t.inverse.apply (y p))
      (trans!{{R.Real}} _ _ _ (Field.fieldMulComm _ _) (times (Cylinder.time p))))) (t.right (y p)));
\definition boundedReads: \Pow U.CarrierSet := { p: U.CarrierSet \where O.Le (D.squared (read p)) R.one };
\definition placeInShell[p: Disks.Carrier]: A.Member Region.shell (place p) :=
  U.Open[].imageMember boundedReads (placed p) (\idelim Disks.point p = read (placed p) \with v: Normal.Point => O.Le (D.squared v) R.one \by {
    base: \bysub(Normal.Point,D.closedBall,Disks.point p),equality: sym!{Normal.Point} _ _ (readPlace p)
  });
\definition shellEq: Sets.Image place B.Whole = Region.shell := \axiom:setext((Sets.Image place B.Whole),Region.shell,
  \fun (x: Cylinder.Carrier)(h: A.Member (Sets.Image place B.Whole) x) =>
    Sets.imageElim place B.Whole x (A.Member Region.shell x) (\fun (p: Disks.Carrier)(w: _)(same: place p = x) =>
      \idelim place p = x \with q: Cylinder.Carrier => A.Member Region.shell q \by { base: placeInShell p,equality: same }) h,
  \fun (x: Cylinder.Carrier)(h: A.Member Region.shell x) => U.Open[].imageElim boundedReads x (A.Member (Sets.Image place B.Whole) x)
    (\fun (p: U.CarrierSet)(bound: O.Le (D.squared (read p)) R.one)(same: p = x) => \block {
      \let q: Disks.Carrier := Disks.at (Cylinder.time p) (\into[Normal.Point](read p,D.closedBall) \by { bound }) \then
      \let samePlace: place q = x := trans!{Cylinder.Carrier} (place q) p x (placeRead p bound) same \then
      \return \idelim place q = x \with z: Cylinder.Carrier => A.Member (Sets.Image place B.Whole) z \by {
        base: Sets.imageMember place B.Whole q (\refl(q)),equality: samePlace
      }
    }) h);
\definition shellClosed: A.IsClosedIn ambient Region.shell := \idelim Sets.Image place B.Whole = Region.shell \with F: \Pow Cylinder.Carrier => A.IsClosedIn ambient F \by {
  base: A.Compactness[].compactClosed ambient (topological_constructions.Separation[].Product[A := I.Carrier,B := E.Vector].On[left := I.topology,
    right := Bundle.ambient.space,leftHausdorff := I.hausdorff,rightHausdorff := Bundle.ambient.hausdorff].hausdorff) _
    (topology.Compactness[A := Disks.Carrier,B := Cylinder.Carrier].continuousImage source ambient place placeContinuous B.Whole
      (topological_constructions.Product[A := I.Carrier,B := D.Point].Compactness[].productCompact I.topology D.topology I.compact (D.compact compact))), equality: shellEq
};
\import \root.Collapse[A := Cylinder.Carrier,D := D.Point,space := ambient,disk := D.topology,sphere := D.boundary].Of[c := Region.chart shellClosed] \as Joint;
\module Slice(s: I.Carrier) {
  \import Joint.Pullback[X := E.Vector,source := Bundle.ambient.space,f := Cylinder.at s,regular := Cylinder.atContinuous Bundle.ambient.space s] \as Slice;
  \definition chart: Collapse.Chart := Slice.pulled;
  \definition natural: (\fun (x: E.Vector) => Joint.map (Cylinder.at s x)) = Collapse.Of[c := chart].map := Slice.natural;
  \definition collapse: E.Vector -> D.Thom := Collapse.Of[c := chart].map;
  \definition law: D.CollapseLaw[radius s,collapse] := D.CollapseLaw[radius s,collapse] {
    disk := \block {
      \fun (v: D.Point) \then
      \let p: Disks.Carrier := Disks.at s v \then
      \let member: \In[E.Vector] chart.shell (D.embedded (radius s) v) := \idelim Sets.Image place B.Whole = Region.shell \with F: \Pow Cylinder.Carrier =>
        \In[Cylinder.Carrier] F (place p) \by { base: Sets.imageMember place B.Whole p (\refl(p)),equality: shellEq } \then
      \let shellPoint: \Cast[E.Vector] chart.shell := \into[E.Vector](D.embedded (radius s) v,chart.shell) \by { member } \then
      \let decoded: D.Point := chart.read shellPoint \then
      \let decodes: decoded = v := boundary_manifolds.Refinement[A := Normal.Point].equality D.closedBall decoded v (readPlace p) \then
      \return trans!{D.Thom} _ _ _ (Collapse.Of[c := chart].onDisk shellPoint)
        (congr!{{D.Point} D.Thom} D.class decoded v decodes)
    },
    outside := \fun (x: E.Vector)(absent: _) => Collapse.Of[c := chart].onExterior x (\fun (inner: _) => \block {
      \let p: Cylinder.Carrier := Cylinder.at s x \then
      \let member: \In[Cylinder.Carrier] (Sets.Image place B.Whole) p := \idelim Region.shell = Sets.Image place B.Whole \with F: \Pow Cylinder.Carrier =>
        \In[Cylinder.Carrier] F p \by { base: chart.included x inner,equality: sym!{{\Pow Cylinder.Carrier}} _ _ shellEq } \then
      \return Sets.imageElim place B.Whole p Logic.False (\fun (q: Disks.Carrier)(w: _)(same: _) => absent (Disks.point q)
        (trans!{{E.Vector}} _ _ _ (congr!{{I.Carrier} {E.Vector}} (\fun (t: I.Carrier) => D.embedded (radius t) (Disks.point q)) _ _
          (sym!{{I.Carrier}} _ _ (congr!{Cylinder.Carrier {I.Carrier}} Cylinder.time _ _ same))) (congr!{Cylinder.Carrier {E.Vector}} Cylinder.point _ _ same))) member
    })
  };

}
\definition homotopy: algebraic_topology.Homotopy[A := E.Vector,B := D.Thom].Homotopy[Bundle.ambient.space,D.thomTopology,
  Collapse.Of[c := Slice[s := I.start].chart].map,Collapse.Of[c := Slice[s := I.end].chart].map] :=
  \into[Cylinder.Carrier -> D.Thom](Joint.map,algebraic_topology.Homotopy[A := E.Vector,B := D.Thom].Homotopy[Bundle.ambient.space,D.thomTopology,
    Collapse.Of[c := Slice[s := I.start].chart].map,Collapse.Of[c := Slice[s := I.end].chart].map]) \by {
    algebraic_topology.Homotopy[A := E.Vector,B := D.Thom].Laws[Bundle.ambient.space,D.thomTopology,
      Collapse.Of[c := Slice[s := I.start].chart].map,Collapse.Of[c := Slice[s := I.end].chart].map,Joint.map] {
      continuous := Joint.continuous,start := \fun (x: E.Vector) => congr!{{E.Vector -> D.Thom} D.Thom}
        (\fun (f: E.Vector -> D.Thom) => f x) _ _ (Slice[s := I.start].natural),
      end := \fun (x: E.Vector) => congr!{{E.Vector -> D.Thom} D.Thom}
        (\fun (f: E.Vector -> D.Thom) => f x) _ _ (Slice[s := I.end].natural),
    }
  };
\definition embeddings: algebraic_topology.Homotopy[A := D.Point,B := E.Vector].Homotopy[D.topology,Bundle.ambient.space,
  D.embedded (radius I.start),D.embedded (radius I.end)] :=
  \into[Disks.Carrier -> E.Vector](\fun (p: Disks.Carrier) => endpoint (scaled p),
    algebraic_topology.Homotopy[A := D.Point,B := E.Vector].Homotopy[D.topology,Bundle.ambient.space,D.embedded (radius I.start),D.embedded (radius I.end)]) \by {
    algebraic_topology.Homotopy[A := D.Point,B := E.Vector].Laws[D.topology,Bundle.ambient.space,
      D.embedded (radius I.start),D.embedded (radius I.end),\fun (p: Disks.Carrier) => endpoint (scaled p)] {
      continuous := topology.Composition[A := Disks.Carrier,B := Normal.Point,C := E.Vector].composeContinuous _ _ _ scaled endpoint scaledContinuous continuous,
      start := \fun (v: D.Point) => \refl(D.embedded (radius I.start) v),end := \fun (v: D.Point) => \refl(D.embedded (radius I.end) v),
    }
  };
\definition sliceInjective[s: I.Carrier][v,w: D.Point][same: embeddings (Disks.at s v) = embeddings (Disks.at s w)]: v = w := \block {
  \let first: U.CarrierSet := placed (Disks.at s v) \then
  \let second: U.CarrierSet := placed (Disks.at s w) \then
  \let samePlace: (first \of Cylinder.Carrier) = (second \of Cylinder.Carrier) :=
    Pair.Prop[A := I.Carrier,B := E.Vector].ext first second (\refl(s)) same \then
  \let sameRead: read first = read second := congr!{U.CarrierSet Normal.Point} read first second
    (boundary_manifolds.Refinement[A := Cylinder.Carrier].equality tube first second samePlace) \then
  \return boundary_manifolds.Refinement[A := Normal.Point].equality D.closedBall v w
    (trans!{Normal.Point} _ _ _ (sym!{Normal.Point} _ _ (readPlace (Disks.at s v)))
      (trans!{Normal.Point} _ _ _ sameRead (readPlace (Disks.at s w))))
};
