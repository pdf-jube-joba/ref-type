\import \parent.Disk[] \as D;
\import dedekind_reals.DedekindReal[] \as O;
\definition common: R.Real := R.Distance[].min first.radius second.radius;
\definition positive: O.Lt R.zero common := R.Estimates[].Product[].minPositive _ _ first.positive second.positive;
\import \parent.Inside[t := left].Interpolate[w := first,a := first.radius,b := common,ap := first.positive,bp := positive,
  aw := O.leRefl first.radius,bw := R.Distance[].minLeft first.radius second.radius,compact := compact] \as First;
\import \parent.Inside[t := right].Interpolate[w := second,a := common,b := second.radius,ap := positive,bp := second.positive,
  aw := R.Distance[].minRight first.radius second.radius,bw := O.leRefl second.radius,compact := compact] \as Second;
\definition middle: First.last = Second.first := D.unique common _ _ First.lastLaw Second.firstLaw;
\import algebraic_topology.Homotopy[A := E.Vector,B := D.Thom] \as H;
\definition compare[f,g: E.Vector -> D.Thom][hf: D.CollapseLaw[first.radius,f]][hg: D.CollapseLaw[second.radius,g]]:
  H.Homotopy[Bundle.ambient.space,D.thomTopology,f,g] := \block {
  \let h: H.Homotopy[Bundle.ambient.space,D.thomTopology,First.first,Second.first] :=
    \idelim First.last = Second.first \with k: (E.Vector -> D.Thom) => H.Homotopy[Bundle.ambient.space,D.thomTopology,First.first,k] \by { base: First.homotopy,equality: middle } \then
  \let path: H.Homotopy[Bundle.ambient.space,D.thomTopology,First.first,Second.last] := H.Concatenation[].concatenate _ _ _ _ _ h Second.homotopy \then
  \return \idelim Second.last = g \with k: (E.Vector -> D.Thom) => H.Homotopy[Bundle.ambient.space,D.thomTopology,f,k] \by {
    base: \idelim First.first = f \with j: (E.Vector -> D.Thom) => H.Homotopy[Bundle.ambient.space,D.thomTopology,j,Second.last] \by {
      base: path,equality: D.unique _ _ _ First.firstLaw hf
    },equality: D.unique _ _ _ Second.lastLaw hg
  }
};
\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := D.Point] \as Disks;
\import algebraic_topology.Homotopy[A := D.Point,B := E.Vector] \as Paths;
\definition Track: \Set := \Cast[Paths.Homotopy[D.topology,Bundle.ambient.space,D.embedded first.radius,D.embedded second.radius]]
  ({ h: Paths.Homotopy[D.topology,Bundle.ambient.space,D.embedded first.radius,D.embedded second.radius] \where
    \forall (s: I.Carrier)(v,w: D.Point) -> h (Disks.at s v) = h (Disks.at s w) -> v = w });
\definition embeddings: \exists Track := Logic.orElim _ _ _ (O.Order[].leTotal first.radius second.radius)
  (\fun (le: _) => \exact(\parent.Inside[t := right].Interpolate[w := second,a := first.radius,b := second.radius,
    ap := first.positive,bp := second.positive,aw := le,bw := O.leRefl second.radius,compact := compact].embeddings,Track))
  (\fun (le: _) => \exact(\parent.Inside[t := left].Interpolate[w := first,a := first.radius,b := second.radius,
    ap := first.positive,bp := second.positive,aw := O.leRefl first.radius,bw := le,compact := compact].embeddings,Track));
