\import Blocks.On[U := b.chart.image, V := FiberOpen.whole] \as P;
\import Normal.InChart[c := b.chart] \as Coordinates;
\import calculus.Maps[n := n, m := d] \as BaseMaps;
\import calculus.Maps[n := d, m := n] \as ToBase;
\import ToBase.Composition[U := P.domain, V := b.chart.image, f := P.leftMap] \as Pull;
\definition at[u: BaseOpen.Carrier b.chart.image]: Charts.LocalPoint b.chart := Charts.point b.chart u;
\definition baseMap: BaseMaps.Map b.chart.image Open.whole :=
  BaseMaps.Restriction[U := b.chart.image, V := Coordinates.domain, W := Open.whole].input Coordinates.wholeIncluded Coordinates.coordinateMap;
\definition frame[a: Charts.LocalPoint b.chart]: calculus.Vector[n := k,m := d].LinearMap := ComposeFrame.compose (lift.action a) (b.decode a);
\definition matrix[z: Open.Carrier P.domain]: calculus.Vector[n := k, m := d].LinearMap := frame (at (P.leftPoint z));
\import calculus.MatrixFamily[d := d, p := k, q := d] \as Matrices;
\definition matrixSmooth: Matrices.Regular P.domain matrix := \fun (i: _)(j: _) => Pull.smooth
  (\into[BaseOpen.ScalarFunction b.chart.image](\fun (u: BaseOpen.Carrier b.chart.image) => (frame (at u)).apply (Fiber.basis j) i, BaseOpen.Smooth[].SmoothFunction b.chart.image) \by { lift.smooth b i j });
\definition function[z: Open.Carrier P.domain]: E.Vector := endpoint (TotalCharts.point (Normal.totalChart b) z);
\definition data: C.Data[P.domain, Open.whole] := C.Data[P.domain, Open.whole] {
  apply := \fun (z: Open.Carrier P.domain) => Open.Whole[].point (function z)
};
\definition coordinateMap: C.Map P.domain Open.whole := \into[C.Data[P.domain,Open.whole]](data,C.Map P.domain Open.whole) \by {
  C.Laws[P.domain,Open.whole,data] { smooth := \fun (i: _) => Open.Smooth[].Operations[].addSmooth P.domain _ _
    (Pull.smooth (BaseMaps.coordinateFunction b.chart.image Open.whole baseMap i))
    (Matrices.action P.domain matrix matrixSmooth (\fun (z: Open.Carrier P.domain) => Blocks.right z) (\fun (j: _) => P.rightMap.smooth j) i) }
};
\import manifolds.EuclideanMap[n := d,m := d].Between[U := P.domain,V := Open.whole] \as CoordinateMaps;
\import manifolds.ChartMap[n := d].On[M := Bundle.ambient].At[chart := standard] \as Standard;
\import manifolds.Composition[n := d,m := d,l := d].Between[M := CoordinateMaps.source,N := CoordinateMaps.target,P := Bundle.ambient] \as Compose;
\definition plot: manifolds.SmoothMap[n := d,m := d].Between[M := CoordinateMaps.source,N := Bundle.ambient].Map := Compose.compose (CoordinateMaps.map coordinateMap) Standard.map;
\definition joined[u: BaseOpen.Carrier b.chart.image][w: Fiber.Vector]: function (P.joinPoint u (FiberOpen.Whole[].point w)) =
  E.space.add (Maps.apply e (at u)) ((frame (at u)).apply w) :=
  congr!{Normal.Point {E.Vector}} endpoint _ _ (tangent_bundles.FrameBundle[n := n,r := k].Over[M := M].Family[F := Normal.Fiber,space := Normal.fiberSpace].Using[I := Normal.Local,data := Normal.framesData].InChart[i := b].pointJoined u (FiberOpen.Whole[].point w));
\module At(u: BaseOpen.Carrier b.chart.image);
