\import Normal.InChart[c := b.chart] \as Chart;
\import calculus.Maps[n := n,m := d] \as Coordinates;
\definition U: BaseOpen.OpenSet := b.chart.image;
\definition point: BaseOpen.Carrier U -> M.Point := Charts.point b.chart;
\definition h: BaseOpen.Smooth[].SmoothOn U (\fun (u: BaseOpen.Carrier U) => height (point u)) :=
  (Coordinates.Restriction[U := U,V := Chart.domain,W := Open.whole].input Chart.wholeIncluded Chart.coordinateMap).smooth j;
\definition smoothEntry[i: Fin.Fin d]: BaseOpen.Smooth[].SmoothOn U (\fun (u: BaseOpen.Carrier U) => entry (point u) i) :=
  Bool.cases (\fun (b: Bool.Bool^) => BaseOpen.Smooth[].SmoothOn U (\fun (u: BaseOpen.Carrier U) => Bool.ite R.Real b (height (point u)) R.one))
    (BaseOpen.Smooth[].Operations[].constantSmooth U R.one) h (test i);
\definition smooth: calculus.MatrixFamily[d := n,p := k,q := d].Regular U
  (\fun (u: BaseOpen.Carrier U) => ComposeFrame.compose (action (point u)) (b.decode (Charts.point b.chart u))) :=
  \fun (i: _)(l: _) => BaseOpen.Smooth[].Operations[].mulSmooth U _ _
    (BaseOpen.Smooth[].Operations[].mulSmooth U _ _ (smoothEntry i) (smoothEntry i)) (b.decodeSmooth i l);
