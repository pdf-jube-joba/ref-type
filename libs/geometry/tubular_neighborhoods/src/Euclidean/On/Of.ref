\import Bundle.On[M := M].Of[i := Embeddings.asImmersion e] \as Normal;
\import topology.Topology[Carrier := Normal.Point] \as S;
\import topology.Topology[Carrier := E.Vector] \as T;
\import manifolds.Dimension[n := d].Chart[M := Normal.Point, space := Normal.topology] \as TotalCharts;
\import manifolds.SmoothMap[n := d, m := d].Between[M := Normal.manifold, N := Bundle.ambient] \as TotalMaps;
\definition zero[x: M.Point]: Normal.Point := Normal.Zero[].value x;
\import calculus.Vector[n := d,m := d] \as End;
\import Linear.Linear[V := E.Vector,W := E.Vector,source := E.space,target := E.space].Composition[U := Fiber.Vector,domain := Fiber.space] \as ComposeFrame;
\structure Lift: \Set := {
  action: M.Point -> End.LinearMap,
  smooth: \forall (b: Normal.Local) -> calculus.MatrixFamily[d := n,p := k,q := d].Regular b.chart.image
    (\fun (u: BaseOpen.Carrier b.chart.image) => ComposeFrame.compose (action (Charts.point b.chart u)) (b.decode (Charts.point b.chart u))),
  definite: \forall (x: M.Point)(v: Normal.Fiber x) -> E.dot v ((action x).apply v) = R.zero -> v = E.space.zero,
};
\definition straight: Lift := Lift {
  action := \fun (x: M.Point) => calculus.Identity[n := d].linear,
  smooth := \fun (b: Normal.Local) => b.decodeSmooth, definite := \fun (x: M.Point)(v: Normal.Fiber x) => E.separated v,
};
\module With(lift: Lift);
\module Stabilized;
\module Neat(j: std.Data[].FinSet[].Fin d);
\definition tubularNeighborhood[compact: BaseSpace.IsCompact M.space]: \exists With[lift := straight].DiskNeighborhood :=
  With[lift := straight].Compact[compact := compact].diskNeighborhood;
\import boundary_manifolds.Dimension[n := n] \as BoundaryModels;
\module HalfSpace(p: Nat.Nat^, dimension: compact_embeddings.HalfSpace[k := p].dimension = d, B: BoundaryModels.Manifold);
