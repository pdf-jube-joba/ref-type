\use Equality.eq_reason_in;
\import normal_bundles.Dimension[n := n, k := k] \as Bundle;
\definition d: Nat.Nat^ := Bundle.ambientDimension;
\import manifolds.Dimension[n := n].Smooth[] \as Models;
\import manifolds.Dimension[n := d].Examples[].Euclidean[] \as Ambient;
\import manifolds.Immersion[n := n, m := d] \as Immersions;
\import calculus.Blocks[n := n, m := k] \as Blocks;
\import inverse_implicit.Product[n := n, m := k] \as Directions;
\import inverse_implicit.Euclidean[n := d] \as Inverse;
\import calculus.Real[].Multivariable[n := n].Open[] \as BaseOpen;
\import calculus.Real[].Multivariable[n := k].Open[] \as FiberOpen;
\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import linear_algebra.Euclidean[n := d] \as E;
\import linear_algebra.Euclidean[n := n] \as Base;
\import linear_algebra.Euclidean[n := k] \as Fiber;
\import real.Analysis[] \as R;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real R.Algebra[].field] \as Linear;
\import Linear.Laws[V := E.Vector, space := E.space] \as Laws;
\import calculus.Maps[n := d, m := d] \as C;
\import calculus.Diffeomorphism[n := d, m := d] \as Diff;
\module On(M: Models.Manifold);
