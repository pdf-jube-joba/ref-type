\import \parent.\parent.\parent.InChart[chart := c] \as Local;
\import Local.At[x := Charts.point c u] \as Fiber;
\definition law: manifolds.SmoothMap[n := n, m := dimension].Between[M := FromCharts.parameterManifold c, N := manifold].apply map u = zero (Charts.point c u) :=
  trans!{Point} _ _ _ (Local.pointJoined u (\into[Vector](origin, Open.whole.points) \by { \refl(origin) }))
    (congr!{{Tangent.Vector (Charts.point c u)} Point} (include (Charts.point c u)) _ _ Fiber.zero);
