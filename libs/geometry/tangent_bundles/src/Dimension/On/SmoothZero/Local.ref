\definition origin: Vector := \fun (i: std.Data[].FinSet[].Fin n) => Real.zero;
\import Blocks.On[U := c.image, V := Open.whole] \as Product;
\import Blocks.FixedRight[U := c.image, V := Product.domain, c := origin] \as Zero;
\definition included: Zero.Included := \fun (x: Open.Carrier c.image) =>
  \bysub(TotalVector, Product.domain.points, Product.joinPoint x (\into[Vector](origin, Open.whole.points) \by { \refl(origin) }));
\import manifolds.EuclideanMap[n := n, m := dimension].Between[U := c.image, V := Product.domain] \as Coordinates;
\import manifolds.ChartMap[n := dimension].On[M := manifold].At[chart := chart c] \as Parametrization;
\import manifolds.Composition[n := n, m := dimension, l := dimension].Between[M := Coordinates.source, N := Coordinates.target, P := manifold] \as Compose;
\definition map: FromCharts.LocalMap c := Compose.compose (Coordinates.map (Zero.map included)) Parametrization.map;
\module At(u: Open.Carrier c.image);
\definition agrees: \forall (u: Open.Carrier c.image) ->
  manifolds.SmoothMap[n := n, m := dimension].Between[M := FromCharts.parameterManifold c, N := manifold].apply map u = zero (Charts.point c u) :=
  \fun (u: Open.Carrier c.image) => At[u := u].law;
