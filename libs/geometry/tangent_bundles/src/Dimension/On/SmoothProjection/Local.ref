\import Blocks.On[U := c.image, V := Open.whole] \as Product;
\import manifolds.EuclideanMap[n := dimension, m := n].Between[U := Product.domain, V := c.image] \as CoordinateMaps;
\import manifolds.ChartMap[n := n].On[M := M].At[chart := c] \as BaseParametrization;
\import manifolds.Composition[n := dimension, m := n, l := n].Between[M := CoordinateMaps.source, N := CoordinateMaps.target, P := M] \as Compose;
\definition map: Plots.LocalMap c := Compose.compose (CoordinateMaps.map Product.leftMap) BaseParametrization.map;
