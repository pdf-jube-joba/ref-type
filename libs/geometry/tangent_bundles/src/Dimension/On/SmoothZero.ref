\import manifolds.FromCharts[n := n, m := dimension].Between[M := M, N := manifold] \as FromCharts;
\module Local(c: Chart);
\definition maps[c: FromCharts.SourceChart]: FromCharts.LocalMap c := Local[c := c].map;
\definition agrees: FromCharts.Agreement zero maps := \fun (c: Chart)(u: Open.Carrier c.image) => Local[c := c].agrees u;
\import FromCharts.On[f := zero, maps := maps, agrees := agrees] \as Construct;
\import manifolds.SmoothMap[n := n, m := dimension].Between[M := M, N := manifold] \as Maps;
\definition map: Maps.Map := Construct.value;
\definition apply: Maps.apply map = zero := Construct.apply;
