\import Parametrizations.Read[d := dimension].On[p := \parent.\parent.InChart[chart := left].patch,
  U := \parent.\parent.InChart[chart := right].image, f := \fun (u: TotalOpen.Carrier \parent.\parent.InChart[chart := right].image) => \parent.\parent.InChart[chart := right].point u, a := a] \as Reads;
\definition witness: Reads.Witness := Reads.Witness {
  domain := domain, included := included,
  contains := Logic.And[_, _]::# (Base.intro (Blocks.On[U := right.image, V := Open.whole].leftPoint a) inside) (\refl(Blocks.right a)),
  lift := Lift.map,
  agrees := \fun (z: TotalOpen.Carrier domain) => \parent.At[z := z].agrees,
};
