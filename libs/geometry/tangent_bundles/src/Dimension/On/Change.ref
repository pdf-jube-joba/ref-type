/* A transition in the base and its tangent lift. */
\import Charts.Transition[left := right, right := left] \as Base;
\import manifolds.Dimension[n := n].Atlas[M := M.Point, space := M.space].Pair[left := right, right := left] \as BaseAtlas;
\definition compatible: BaseAtlas.Compatible := M.atlas.compatible right left
  (\bysub(Charts.Chart, M.atlas.charts, right)) (\bysub(Charts.Chart, M.atlas.charts, left));
\import calculus.Maps[n := n, m := n] \as Maps;
\definition baseMap: Maps.Map Base.domain left.image := BaseAtlas.smoothMap compatible;
\import Maps.Tangent[U := Base.domain, V := left.image, f := baseMap] \as Lift;
\import Blocks.On[U := Base.domain, V := Open.whole] \as Overlap;
\definition domain: TotalOpen.OpenSet := Overlap.domain;
\definition included: TotalOpen.Included domain \parent.InChart[chart := right].image :=
  \fun (z: TotalVector)(inside: _) => Logic.And[_, _]::#
    (Base.inLeftImage (\into[Vector](Blocks.left z, Base.domain.points) \by { inside.left })) (\refl(Blocks.right z));
\definition source[z: TotalOpen.Carrier domain]: TotalOpen.Carrier \parent.InChart[chart := right].image :=
  TotalOpen.inclusion domain \parent.InChart[chart := right].image included z;
\definition target[z: TotalOpen.Carrier domain]: TotalOpen.Carrier \parent.InChart[chart := left].image := Lift.point z;
\module At(z: TotalOpen.Carrier domain);
\definition Parameter: \Set := TotalOpen.Carrier \parent.InChart[chart := right].image;
\definition Inside[a: Parameter]: \Prop := \In[Point] \parent.InChart[chart := left].domain (\parent.InChart[chart := right].point a);
\module Read(a: Parameter, inside: Inside a);
