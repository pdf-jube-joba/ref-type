\import \parent.Frames[] \as Frames;
\import \root.FrameBundle[n := n, r := n].Over[M := M].Family[F := Tangent.Vector, space := \fun (x: M.Point) => Tangent.space x].Using[I := Chart, data := Frames.framesData] \as Framed;
\import Framed.Addition[changes := Frames.changes] \as Generic;
\definition Domain: \Set := Generic.Domain;
\definition domainDimension: N.Nat^ := Generic.sourceDimension;
\import manifolds.Dimension[n := domainDimension].Smooth[] \as DomainModel;
\definition domainManifold: DomainModel.Manifold := Generic.domainManifold;
\definition apply[p: Domain]: Point := include p.base ((Tangent.space p.base).add
  (std.Data[].Pair[].first (Tangent.Vector p.base) (Tangent.Vector p.base) p.vector)
  (std.Data[].Pair[].second (Tangent.Vector p.base) (Tangent.Vector p.base) p.vector));
\definition make[x: M.Point][v, w: Tangent.Vector x]: Domain := Generic.make x v w;
\import \parent.FrameComparison[] \as Comparison;
\import manifolds.Composition[n := domainDimension, m := dimension, l := dimension].Between[M := domainManifold, N := Comparison.otherManifold, P := manifold] \as Compose;
\import manifolds.SmoothMap[n := domainDimension, m := dimension].Between[M := domainManifold, N := manifold] \as Maps;
\definition map: Maps.Map := Compose.compose Generic.smoothMap Comparison.backwardMap;
\definition agreement: Maps.apply map = apply := \refl(apply);
