\import Charts.Transition[left := c, right := d] \as Base;
\import manifolds.Dimension[n := n].Atlas[M := M.Point, space := M.space].Pair[left := c, right := d] \as BaseAtlas;
\import calculus.Maps[n := n, m := n] \as Calculus;
\definition baseMap: Calculus.Map Base.domain d.image := BaseAtlas.smoothMap
  (M.atlas.compatible c d (\bysub(Charts.Chart, M.atlas.charts, c)) (\bysub(Charts.Chart, M.atlas.charts, d)));
\import Atlas.Change[i := c, j := d] \as Matrix;
\import Real.FiniteSums[].Linear[] \as Finite;
\module At(t: Open.Carrier Base.domain);
\definition smooth: \forall (a, b: std.Data[].FinSet[].Fin n) -> Matrix.CoefficientSmooth a b :=
  \fun (a, b: std.Data[].FinSet[].Fin n) => \idelim
    (\fun (t: Open.Carrier Base.domain) => Calculus.FixedDifferential[U := Base.domain, V := d.image, f := baseMap, v := Finite.basis n b].value a t) = Matrix.coefficient a b
    \with f: Open.ScalarFunction Base.domain => Open.Smooth[].SmoothOn Base.domain f \by {
      base: Calculus.FixedDifferential[U := Base.domain, V := d.image, f := baseMap, v := Finite.basis n b].smooth a,
      equality: \axiom:funext((\fun (t: Open.Carrier Base.domain) => Calculus.FixedDifferential[U := Base.domain, V := d.image, f := baseMap, v := Finite.basis n b].value a t),
        (Matrix.coefficient a b), \fun (t: Open.Carrier Base.domain) => sym!{{Real.Real}} _ _ (At[t := t].coefficient a b))
    };
