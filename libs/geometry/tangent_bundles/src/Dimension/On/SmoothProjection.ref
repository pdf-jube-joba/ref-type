\import \parent.Plots[m := n].Into[N := M] \as Plots;
\module Local(c: Chart);
\definition family[c: Chart]: Plots.LocalMap c := Local[c := c].map;
\definition agreement: Plots.Agreement projection family := \fun (c: Chart)(z: TotalOpen.Carrier \parent.InChart[chart := c].image) => \refl(projection (\parent.InChart[chart := c].point z));
\import Plots.Of[f := projection, maps := family, agrees := agreement] \as Construct;
\import manifolds.SmoothMap[n := dimension, m := n].Between[M := manifold, N := M] \as Maps;
\definition map: Maps.Map := Construct.map;
\definition apply: Maps.apply map = projection := Construct.apply;
