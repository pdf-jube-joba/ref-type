\import linear_algebra.Field[].Space[K := Real.Real, field := Real.Algebra[].field] \as Spaces;
\import Total.Fiber[x := x] \as Fiber;
\definition Carrier: \Set := Fiber.Carrier;
\definition vectorSpace: Spaces.VectorSpace Carrier := Fiber.vectorSpace;
\definition isomorphism: Spaces.Isomorphism[V := Carrier, W := Tangent.Vector x, source := vectorSpace, target := Tangent.space x].Isomorphism := Fiber.isomorphism;
\definition include[v: Tangent.Vector x]: Carrier := Fiber.encode v;
\definition inverseFormula: \forall (v: Tangent.Vector x) -> isomorphism.backward.apply v = include v := Fiber.inverseFormula;
