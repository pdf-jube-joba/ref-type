\import \root.FrameBundle[n := n, r := n].Over[M := M].Family[F := Tangent.Vector, space := \fun (x: M.Point) => Tangent.space x] \as Family;
\module At(c: Chart, x: Charts.LocalPoint c);
\definition local[c: Chart]: Family.Local := Family.Local { chart := c, frame := \fun (x: Charts.LocalPoint c) => At[c := c, x := x].isomorphism };
\definition framesData: Family.Data[Chart] := Family.Data[Chart] { local := local, covers := data.covers };
\import Family.Using[I := Chart, data := framesData] \as Atlas;
\module Change(c, d: Chart);
\definition changes: Atlas.Changes := \fun (c, d: Chart)(a, b: std.Data[].FinSet[].Fin n) => Change[c := c, d := d].smooth a b;
