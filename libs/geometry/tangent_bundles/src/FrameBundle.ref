/* Shared coordinate construction for the tangent, normal, and sum spaces. */
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as Real;
\import linear_algebra.Commutative[K := Real.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Real.Real (Real.Algebra[].field)] \as Spaces;
\import Spaces.Coordinates[I := Fin.Fin r] \as Vectors;
\import manifolds.Dimension[n := n].Smooth[] \as BaseModel;
\import calculus.Real[].Multivariable[n := n].Open[] \as BaseOpen;
\import calculus.Real[].Multivariable[n := r].Open[] \as FiberOpen;
\import calculus.Blocks[n := n, m := r] \as Blocks;
\definition dimension: N.Nat^ := Blocks.dimension;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Open;
\module Over(M: BaseModel.Manifold);
