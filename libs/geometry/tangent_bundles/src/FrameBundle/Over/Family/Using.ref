\import manifolds.BundleAtlas[n := n, r := r, A := Point, I := I].Over[M := M, projection := projection] \as Bundle;
\definition chart[i: I]: Chart := (data.local i).chart;
\module InChart(i: I);
\definition local[i: I]: Bundle.Local := Bundle.Local {
  baseChart := chart i, point := InChart[i := i].point, coordinate := InChart[i := i].coordinate,
  pointCoordinate := InChart[i := i].pointCoordinate, coordinatePoint := InChart[i := i].coordinatePoint,
  projectionFormula := \fun (u: Open.Carrier InChart[i := i].image) => \refl(projection (InChart[i := i].point u)),
};
\definition bundleData: Bundle.Data := Bundle.Data { local := local, covers := data.covers };
\import Bundle.Using[data := bundleData] \as Products;
\module Change(i, j: I);
\definition Changes: \Prop := \forall (i, j: I)(a, b: Fin.Fin r) -> Change[i := i, j := j].CoefficientSmooth a b;
\module Build(changes: Changes);
\module Sum(s: N.Nat^, G: M.Point -> \Set, otherSpace: \forall (x: M.Point) -> Spaces.VectorSpace (G x),
  otherFrame: \forall (i: I)(x: Charts.LocalPoint (chart i)) -> ExtraFrameAt s G otherSpace x);
\module Addition(changes: Changes);
\module Scaling(changes: Changes);
\module Morphism(s: N.Nat^, G: M.Point -> \Set, otherSpace: \forall (x: M.Point) -> Spaces.VectorSpace (G x),
  otherFrame: \forall (i: I)(x: Charts.LocalPoint (chart i)) -> ExtraFrameAt s G otherSpace x,
  field: \forall (x: M.Point) -> Spaces.Linear[V := F x, W := G x, source := space x, target := otherSpace x].Map);
