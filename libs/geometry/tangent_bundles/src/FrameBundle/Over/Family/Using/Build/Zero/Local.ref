\import \parent.\parent.\parent.InChart[i := i] \as Coordinate;
\import Blocks.On[U := (baseChart i).image, V := FiberOpen.whole] \as Product;
\import Blocks.FixedRight[U := (baseChart i).image, V := Product.domain, c := Vectors.space.zero] \as Zero;
\definition included: Zero.Included := \fun (x: BaseOpen.Carrier (baseChart i).image) =>
  \bysub(calculus.Real[].Multivariable[n := dimension].Point, Product.domain.points,
    Product.joinPoint x (\into[Vectors.Vector](Vectors.space.zero, FiberOpen.whole.points) \by { \refl(Vectors.space.zero) }));
\import manifolds.EuclideanMap[n := n, m := dimension].Between[U := (baseChart i).image, V := Product.domain] \as Coordinates;
\import manifolds.ChartMap[n := dimension].On[M := manifold].At[chart := totalChart i] \as Parametrization;
\import manifolds.Composition[n := n, m := dimension, l := dimension].Between[M := Coordinates.source, N := Coordinates.target, P := manifold] \as Compose;
\definition map: manifolds.SmoothMap[n := n, m := dimension].Between[M := Coordinates.source, N := manifold].Map := Compose.compose (Coordinates.map (Zero.map included)) Parametrization.map;
\definition agrees: \forall (u: BaseOpen.Carrier (baseChart i).image) ->
  manifolds.SmoothMap[n := n, m := dimension].Between[M := Coordinates.source, N := manifold].apply map u = zero (Charts.point (baseChart i) u) :=
  \fun (u: BaseOpen.Carrier (baseChart i).image) => trans!{Point} _ _ _
    (Coordinate.pointJoined u (\into[Vectors.Vector](Vectors.space.zero, FiberOpen.whole.points) \by { \refl(Vectors.space.zero) }))
    (congr!{{F (Charts.point (baseChart i) u)} Point} (include (Charts.point (baseChart i) u)) _ _ (Coordinate.frame (Charts.point (baseChart i) u)).backward.preservesZero);
