\import \parent.Plots[m := n].Into[N := M] \as Plots;
\module Local(i: I);
\definition maps[i: I]: Plots.LocalMap i := Local[i := i].map;
\definition agrees: Plots.Agreement projection maps := \fun (i: I)(u: Open.Carrier \parent.\parent.InChart[i := i].image) => \refl(projection (\parent.\parent.InChart[i := i].point u));
\import Plots.Of[f := projection, maps := maps, agrees := agrees] \as Result;
\import manifolds.SmoothMap[n := dimension, m := n].Between[M := manifold, N := M] \as Maps;
\definition map: Maps.Map := Result.map;
\definition apply: Maps.apply map = projection := Result.apply;
