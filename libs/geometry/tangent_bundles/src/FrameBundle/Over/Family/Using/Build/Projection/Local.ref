\import \parent.\parent.\parent.InChart[i := i] \as Coordinate;
\import Blocks.On[U := (baseChart i).image, V := FiberOpen.whole] \as Product;
\import manifolds.EuclideanMap[n := dimension, m := n].Between[U := Product.domain, V := (baseChart i).image] \as Coordinates;
\import manifolds.ChartMap[n := n].On[M := M].At[chart := baseChart i] \as Parametrization;
\import manifolds.Composition[n := dimension, m := n, l := n].Between[M := Coordinates.source, N := Coordinates.target, P := M] \as Compose;
\definition map: Plots.LocalMap i := Compose.compose (Coordinates.map Product.leftMap) Parametrization.map;
