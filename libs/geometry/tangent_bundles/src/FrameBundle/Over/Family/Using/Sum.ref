\definition Fiber[x: M.Point]: \Set := Spaces.DirectSum[V := F x, W := G x, left := space x, right := otherSpace x].Carrier;
\definition fiberSpace[x: M.Point]: Spaces.VectorSpace (Fiber x) := Spaces.DirectSum[V := F x, W := G x, left := space x, right := otherSpace x].space;
\import Spaces.CoordinateSum[n := r, m := s] \as Coordinates;
\definition rank: N.Nat^ := Coordinates.dimension;
\import \root.FrameBundle[n := n, r := s].Over[M := M].Family[F := G, space := otherSpace] \as OtherFamily;
\definition otherLocal[i: I]: OtherFamily.Local := OtherFamily.Local { chart := chart i, frame := otherFrame i };
\definition otherData: OtherFamily.Data[I] := OtherFamily.Data[I] { local := otherLocal, covers := data.covers };
\import OtherFamily.Using[I := I, data := otherData] \as Other;
\import \root.FrameBundle[n := n, r := rank].Over[M := M].Family[F := Fiber, space := fiberSpace] \as SumFamily;
\module At(i: I, x: Charts.LocalPoint (chart i));
\definition local[i: I]: SumFamily.Local := SumFamily.Local { chart := chart i, frame := \fun (x: Charts.LocalPoint (chart i)) => At[i := i, x := x].isomorphism };
\definition sumData: SumFamily.Data[I] := SumFamily.Data[I] { local := local, covers := data.covers };
\import SumFamily.Using[I := I, data := sumData] \as Sum;
\module Build(firstChanges: Changes, secondChanges: Other.Changes);
