\import \parent.Build[changes := changes] \as BaseConstruction;
\import manifolds.Dimension[n := dimension].Smooth[] \as TotalModel;
\definition manifold: TotalModel.Manifold := BaseConstruction.manifold;
\import \parent.Sum[s := r, G := F, otherSpace := space, otherFrame := \fun (i: I)(x: Charts.LocalPoint (chart i)) => (data.local i).frame x] \as Double;
\import Double.Build[firstChanges := changes, secondChanges := changes] \as DoubleConstruction;
\import \root.FrameBundle[n := n, r := Double.rank].Over[M := M].Family[F := Double.Fiber, space := Double.fiberSpace] \as DoubleFamily;
\import DoubleFamily.Using[I := I, data := Double.sumData] \as Doubles;
\import Doubles.Build[changes := DoubleConstruction.changes] \as DoubleManifold;
\import manifolds.Dimension[n := calculus.Blocks[n := n, m := Double.rank].dimension].Smooth[] \as DomainModel;
\definition domainManifold: DomainModel.Manifold := DoubleManifold.manifold;
\definition Domain: \Set := DoubleFamily.Point;
\definition apply[p: Domain]: Point := include p.base ((space p.base).add
  (std.Data[].Pair[].first (F p.base) (F p.base) p.vector) (std.Data[].Pair[].second (F p.base) (F p.base) p.vector));
\definition make[x: M.Point][v, w: F x]: Domain := DoubleFamily.include x (std.Data[].Pair[].pair (F x) (F x) v w);
\definition sourceDimension: N.Nat^ := calculus.Blocks[n := n, m := Double.rank].dimension;
\import DoubleManifold.Plots[m := dimension].Into[N := manifold] \as Plot;
\module Local(i: I);
\definition maps[i: I]: Plot.LocalMap i := Local[i := i].map;
\definition agrees: Plot.Agreement apply maps := \fun (i: I)(u: calculus.Real[].Multivariable[n := sourceDimension].Open[].Carrier Doubles.InChart[i := i].image) => Local[i := i].agrees u;
\import Plot.Of[f := apply, maps := maps, agrees := agrees] \as Construct;
\import manifolds.SmoothMap[n := sourceDimension, m := dimension].Between[M := DoubleManifold.manifold, N := manifold] \as TotalMaps;
\definition smoothMap: TotalMaps.Map := Construct.map;
