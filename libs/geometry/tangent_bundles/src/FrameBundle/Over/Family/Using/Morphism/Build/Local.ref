\import \parent.\parent.\parent.InChart[i := i] \as Source;
\import Other.InChart[i := i] \as Target;
\import Matrix.Lift[U := (chart i).image, A := matrix i, regular := regular i] \as Lift;
\import manifolds.EuclideanMap[n := dimension, m := Lift.targetDimension].Between[U := Source.image, V := Target.image] \as Coordinates;
\import manifolds.ChartMap[n := Lift.targetDimension].On[M := TargetConstruction.manifold].At[chart := TargetConstruction.chart i] \as Parametrization;
\import manifolds.Composition[n := dimension, m := Lift.targetDimension, l := Lift.targetDimension].Between[M := Coordinates.source, N := Coordinates.target, P := TargetConstruction.manifold] \as Compose;
\definition map: Plots.LocalMap i := Compose.compose (Coordinates.map Lift.map) Parametrization.map;
\module At(z: Open.Carrier Source.image);
\definition agrees: \forall (z: Open.Carrier Source.image) -> manifolds.SmoothMap[n := dimension, m := Lift.targetDimension].Between[M := Coordinates.source, N := TargetConstruction.manifold].apply map z = apply (Source.point z) :=
  \fun (z: Open.Carrier Source.image) => At[z := z].agrees;
