\import \parent.\parent.Reverse[backward := backward] \as Backward;
\definition sourceDimension: N.Nat^ := calculus.Blocks[n := n, m := s].dimension;
\definition apply[p: OtherFamily.Point]: Point := include p.base ((backward p.base).apply p.vector);
\import TargetConstruction.Plots[m := dimension].Into[N := SourceConstruction.manifold] \as Plots;
\module Local(i: I);
\definition maps[i: I]: Plots.LocalMap i := Local[i := i].map;
\definition agrees: Plots.Agreement apply maps := \fun (i: I)(u: calculus.Real[].Multivariable[n := sourceDimension].Open[].Carrier Other.InChart[i := i].image) => Local[i := i].agrees u;
\import Plots.Of[f := apply, maps := maps, agrees := agrees] \as Result;
\import manifolds.SmoothMap[n := sourceDimension, m := dimension].Between[M := TargetConstruction.manifold, N := SourceConstruction.manifold] \as Maps;
\definition map: Maps.Map := Result.map;
\definition formula: Maps.apply map = apply := Result.apply;
\import manifolds.Diffeomorphism[n := dimension, m := sourceDimension].Between[M := SourceConstruction.manifold, N := TargetConstruction.manifold] \as Diffeomorphisms;
\definition diffeomorphism: Diffeomorphisms.Diffeomorphism := Diffeomorphisms.Diffeomorphism {
  forward := forwardMap, backward := map,
  leftInverse := \fun (p: Point) => trans!{Point} _ _ _
    (congr!{{F p.base} Point} (include p.base) _ _ (left p.base p.vector)) (eta p),
  rightInverse := \fun (p: OtherFamily.Point) => trans!{{OtherFamily.Point}} _ _ _
    (congr!{{G p.base} {OtherFamily.Point}} (OtherFamily.include p.base) _ _ (right p.base p.vector)) (OtherFamily.eta p),
};
