\use std.Logic[].Equality[].eq_reason_in;
\import calculus.Blocks[n := n, m := s] \as SourceBlocks;
\import calculus.Real[].Multivariable[n := s].Open[] \as SourceFiber;
\import SourceBlocks.On[U := (chart i).image, V := SourceFiber.whole] \as Product;
\definition u: BaseOpen.Carrier (chart i).image := Product.leftPoint z;
\definition x: Charts.LocalPoint (chart i) := Charts.point (chart i) u;
\definition v: Output.Vector := SourceBlocks.right z;
\definition w: F x := (backward x).apply (Source.encode x v);
\import Spaces.Isomorphism[V := F x, W := Vectors.Vector, source := space x, target := Vectors.space] \as Isomorphisms;
\definition vector: Target.encode x ((Backward.matrix i u).apply v) = w := (Isomorphisms.laws ((data.local i).frame x)).leftInverse w;
\definition agrees: manifolds.SmoothMap[n := sourceDimension, m := dimension].Between[M := Coordinates.source, N := SourceConstruction.manifold].apply map z = apply (Source.point z) :=
  eq_reason_in!{Point _
    "=" _ "by" { congr!{{calculus.Real[].Multivariable[n := dimension].Open[].Carrier Target.image} Point} Target.point _ _ (Lift.formula z) }
    "=" _ "by" { Target.pointJoined u (\into[Vectors.Vector]((Backward.matrix i u).apply v, FiberOpen.whole.points) \by { \refl((Backward.matrix i u).apply v) }) }
    "=" _ "by" { congr!{{F x} Point} (include x) _ _ vector }
  };
