\import \root.FrameBundle[n := n, r := s].Over[M := M].Family[F := G, space := otherSpace] \as OtherFamily;
\definition otherLocal[i: I]: OtherFamily.Local := OtherFamily.Local { chart := chart i, frame := otherFrame i };
\definition otherData: OtherFamily.Data[I] := OtherFamily.Data[I] { local := otherLocal, covers := data.covers };
\import OtherFamily.Using[I := I, data := otherData] \as Other;
\import Spaces.Coordinates[I := Fin.Fin s] \as Output;
\import Spaces.Linear[V := Vectors.Vector, W := Output.Vector, source := Vectors.space, target := Output.space] \as Linear;
\import calculus.MatrixFamily[d := n, p := r, q := s] \as Matrix;
\module At(i: I, x: Charts.LocalPoint (chart i));
\definition matrix[i: I][u: BaseOpen.Carrier (chart i).image]: Linear.Map := At[i := i, x := Charts.point (chart i) u].matrix;
\definition forwardMatrix[i: I][u: BaseOpen.Carrier (chart i).image]: Linear.Map := matrix i u;
\definition Regular: \Prop := \forall (i: I) -> Matrix.Regular (chart i).image (matrix i);
\module Reverse(backward: \forall (x: M.Point) -> Spaces.Linear[V := G x, W := F x, source := otherSpace x, target := space x].Map);
\module Build(firstChanges: Changes, secondChanges: Other.Changes, regular: Regular);
