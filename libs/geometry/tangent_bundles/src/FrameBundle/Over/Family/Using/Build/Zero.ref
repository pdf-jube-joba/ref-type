\definition zero[x: M.Point]: Point := include x ((space x).zero);
\import manifolds.FromCharts[n := n, m := dimension].Between[M := M, N := manifold].Covered[I := I, chart := baseChart, covers := data.covers] \as Plots;
\module Local(i: I);
\definition maps: Plots.Family := \fun (i: I) => Local[i := i].map;
\definition agrees: Plots.Agreement zero maps := \fun (i: I)(u: BaseOpen.Carrier (baseChart i).image) => Local[i := i].agrees u;
\import Plots.Of[f := zero, maps := maps, agrees := agrees] \as Result;
\import manifolds.SmoothMap[n := n, m := dimension].Between[M := M, N := manifold] \as Maps;
\definition map: Maps.Map := Result.value;
\definition apply: Maps.apply map = zero := Result.apply;
