\definition source: FrameAt x := (data.local i).frame x;
\definition target: OtherFamily.FrameAt x := otherFrame i x;
\import Spaces.Linear[V := F x, W := G x, source := space x, target := otherSpace x].Composition[U := Vectors.Vector, domain := Vectors.space] \as Before;
\import Spaces.Linear[V := G x, W := Output.Vector, source := otherSpace x, target := Output.space].Composition[U := Vectors.Vector, domain := Vectors.space] \as After;
\definition matrix: Linear.Map := After.compose target.forward (Before.compose (field x) source.backward);
