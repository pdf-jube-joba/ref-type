\import \parent.\parent.Build[changes := firstChanges] \as SourceConstruction;
\import Other.Build[changes := secondChanges] \as TargetConstruction;
\definition apply[p: Point]: OtherFamily.Point := OtherFamily.include p.base ((field p.base).apply p.vector);
\import SourceConstruction.Plots[m := calculus.Blocks[n := n, m := s].dimension].Into[N := TargetConstruction.manifold] \as Plots;
\module Local(i: I);
\definition maps[i: I]: Plots.LocalMap i := Local[i := i].map;
\definition agrees: Plots.Agreement apply maps := \fun (i: I)(u: Open.Carrier \parent.\parent.InChart[i := i].image) => Local[i := i].agrees u;
\import Plots.Of[f := apply, maps := maps, agrees := agrees] \as Result;
\import manifolds.SmoothMap[n := dimension, m := calculus.Blocks[n := n, m := s].dimension].Between[M := SourceConstruction.manifold, N := TargetConstruction.manifold] \as Maps;
\definition map: Maps.Map := Result.map;
\definition formula: Maps.apply map = apply := Result.apply;
\import manifolds.Dimension[n := dimension].Smooth[] \as SourceModels;
\import manifolds.Dimension[n := calculus.Blocks[n := n, m := s].dimension].Smooth[] \as TargetModels;
\definition sourceManifold: SourceModels.Manifold := SourceConstruction.manifold;
\definition targetManifold: TargetModels.Manifold := TargetConstruction.manifold;
\definition forwardMap: Maps.Map := map;
\module Inverse(backward: \forall (x: M.Point) -> Spaces.Linear[V := G x, W := F x, source := otherSpace x, target := space x].Map,
  inverseRegular: \parent.\parent.Reverse[backward := backward].Regular,
  left: \parent.\parent.Reverse[backward := backward].Left, right: \parent.\parent.Reverse[backward := backward].Right);
