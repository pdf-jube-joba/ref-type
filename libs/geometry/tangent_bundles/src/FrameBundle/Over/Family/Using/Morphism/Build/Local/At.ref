\import Blocks.On[U := (chart i).image, V := FiberOpen.whole] \as Product;
\definition u: BaseOpen.Carrier (chart i).image := Product.leftPoint z;
\definition x: Charts.LocalPoint (chart i) := Charts.point (chart i) u;
\definition v: Vectors.Vector := Blocks.right z;
\definition w: G x := (field x).apply (Source.encode x v);
\import Spaces.Isomorphism[V := G x, W := Output.Vector, source := otherSpace x, target := Output.space] \as Isomorphisms;
\definition coordinate: (matrix i u).apply v = Target.decode x w := \refl((matrix i u).apply v);
\definition vector: Target.encode x ((matrix i u).apply v) = w := (Isomorphisms.laws (otherFrame i x)).leftInverse w;
\definition agrees: manifolds.SmoothMap[n := dimension, m := Lift.targetDimension].Between[M := Coordinates.source, N := TargetConstruction.manifold].apply map z = apply (Source.point z) :=
  trans!{{OtherFamily.Point}} _ _ _ (congr!{{calculus.Real[].Multivariable[n := Lift.targetDimension].Open[].Carrier Target.image} {OtherFamily.Point}} Target.point _ _ (Lift.formula z))
    (trans!{{OtherFamily.Point}} _ _ _ (Target.pointJoined u (\into[Output.Vector]((matrix i u).apply v, calculus.Real[].Multivariable[n := s].Open[].whole.points) \by { \refl((matrix i u).apply v) }))
      (congr!{{G x} {OtherFamily.Point}} (OtherFamily.include x) _ _ vector));
