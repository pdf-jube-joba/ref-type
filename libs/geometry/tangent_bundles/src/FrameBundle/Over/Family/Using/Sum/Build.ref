\module Change(i, j: I);
\definition changes: Sum.Changes := \fun (i, j: I)(a, b: Fin.Fin rank) => Change[i := i, j := j].smooth a b;
\import Sum.Build[changes := changes] \as Construction;
\import manifolds.Dimension[n := calculus.Blocks[n := n, m := rank].dimension].Smooth[] \as TotalModel;
\definition manifold: TotalModel.Manifold := Construction.manifold;
