\import manifolds.Dimension[n := n].Atlas[M := M.Point, space := M.space].Pair[left := chart i, right := chart j] \as BaseAtlas;
\import calculus.Maps[n := n, m := n] \as Maps;
\definition baseMap: Maps.Map Base.domain (chart j).image := BaseAtlas.smoothMap
  (M.atlas.compatible (chart i) (chart j) (\bysub(Charts.Chart, M.atlas.charts, chart i)) (\bysub(Charts.Chart, M.atlas.charts, chart j)));
\definition matrix[a, b: Fin.Fin r]: Partials.Function Base.domain :=
  \into[BaseOpen.ScalarFunction Base.domain](coefficient a b, { f: BaseOpen.ScalarFunction Base.domain \where Smooth.SmoothOn Base.domain f }) \by { regular a b };
\import calculus.LinearFamily[n := n, m := n, p := r, q := r].On[U := Base.domain, V := (chart j).image, f := baseMap, matrix := matrix] \as Action;
\import Blocks.On[U := Base.domain, V := FiberOpen.whole] \as Overlap;
\definition domain: Open.OpenSet := Overlap.domain;
\definition included: Open.Included domain Source.image := \fun (z: calculus.Real[].Multivariable[n := dimension].Point)(inside: _) => Logic.And[_, _]::#
  (Base.inLeftImage (\into[calculus.Real[].Multivariable[n := n].Point](Blocks.left z, Base.domain.points) \by { inside.left })) (\refl(Blocks.right z));
\definition source[z: Open.Carrier domain]: Open.Carrier Source.image := Open.inclusion domain Source.image included z;
\module At(z: Open.Carrier domain);
\definition Parameter: \Set := Open.Carrier Source.image;
\definition Inside[a: Parameter]: \Prop := \In[Point] Target.domain (Source.point a);
\module Read(a: Parameter, inside: Inside a);
\module Evaluate(v: Vectors.Vector, k: Fin.Fin r);
