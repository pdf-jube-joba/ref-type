\import Construction.Plots[m := m].Into[N := N] \as Basic;
\definition LocalMap[i: I]: \Set := Basic.LocalMap i;
\definition Family: \Set := Basic.Family;
\definition Agreement[f: Point -> N.Point][maps: Family]: \Prop := Basic.Agreement f maps;
\module Of(f: Point -> N.Point, maps: Family, agrees: Agreement f maps);
