\import Spaces.Linear[V := Output.Vector, W := Vectors.Vector, source := Output.space, target := Vectors.space] \as Linear;
\import calculus.MatrixFamily[d := n, p := s, q := r] \as Matrix;
\definition Left: \Prop := \forall (x: M.Point)(v: F x) -> (backward x).apply ((field x).apply v) = v;
\definition Right: \Prop := \forall (x: M.Point)(w: G x) -> (field x).apply ((backward x).apply w) = w;
\module At(i: I, x: Charts.LocalPoint (chart i));
\definition matrix[i: I][u: BaseOpen.Carrier (chart i).image]: Linear.Map := At[i := i, x := Charts.point (chart i) u].matrix;
\definition Regular: \Prop := \forall (i: I) -> Matrix.Regular (chart i).image (matrix i);
\definition left: Left -> \forall (i: I)(u: BaseOpen.Carrier (chart i).image)(v: Vectors.Vector) -> (matrix i u).apply ((forwardMatrix i u).apply v) = v :=
  \fun (law: Left)(i: I)(u: BaseOpen.Carrier (chart i).image) => At[i := i, x := Charts.point (chart i) u].left law;
\definition right: Right -> \forall (i: I)(u: BaseOpen.Carrier (chart i).image)(v: Output.Vector) -> (forwardMatrix i u).apply ((matrix i u).apply v) = v :=
  \fun (law: Right)(i: I)(u: BaseOpen.Carrier (chart i).image) => At[i := i, x := Charts.point (chart i) u].right law;
