\import manifolds.IndexedAtlas[n := dimension, A := Point, I := I].Read[d := dimension].On[p := Products.patch j,
  U := Source.image, f := \fun (u: Open.Carrier Source.image) => Source.point u, a := a] \as Reads;
\definition witness: Reads.Witness := Reads.Witness {
  domain := domain, included := included,
  contains := Logic.And[_, _]::# (Base.intro (Blocks.On[U := (chart i).image, V := FiberOpen.whole].leftPoint a) inside) (\refl(Blocks.right a)),
  lift := Action.map,
  agrees := \fun (z: Open.Carrier domain) => \parent.At[z := z].agrees,
};
