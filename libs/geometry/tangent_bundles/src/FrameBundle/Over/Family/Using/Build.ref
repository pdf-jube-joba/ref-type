\import manifolds.IndexedAtlas[n := dimension, A := Point, I := I].On[family := Products.family] \as CoordinateTopology;
\definition transitions: CoordinateTopology.Transitions := \fun (j, i: I)(a: Open.Carrier \parent.InChart[i := i].image)(inside: _) =>
  \exact(\parent.Change[i := i, j := j].Smooth[regular := \fun (a, b: Fin.Fin r) => changes i j a b].Read[a := a, inside := inside].witness,
    manifolds.IndexedAtlas[n := dimension, A := Point, I := I].Read[d := dimension].On[p := Products.patch j,
      U := \parent.InChart[i := i].image, f := \fun (u: Open.Carrier \parent.InChart[i := i].image) => \parent.InChart[i := i].point u, a := a].Witness);
\import Products.Build[transitions := transitions] \as Construction;
\import manifolds.Dimension[n := dimension].Smooth[] \as TotalModel;
\definition manifold: TotalModel.Manifold := Construction.manifold;
\definition topology: topology.Structures[].Topology[Point] := Products.topology;
\definition totalDimension: N.Nat^ := Blocks.dimension;
\definition baseChart[i: I]: Chart := chart i;
\import manifolds.Dimension[n := dimension].Chart[M := Point, space := topology] \as TotalCharts;
\definition chart[i: I]: \Cast[TotalCharts.Chart] manifold.atlas.charts := Construction.chart i;
\definition totalChart[i: I]: \Cast[TotalCharts.Chart] manifold.atlas.charts := chart i;
\module Plots(m: N.Nat^);
\module Projection;
\module Zero;
