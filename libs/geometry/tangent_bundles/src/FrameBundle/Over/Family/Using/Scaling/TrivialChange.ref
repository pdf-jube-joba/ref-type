\import Charts.Transition[left := chart i, right := chart j] \as Base;
\import BaseOpen.Smooth[].Operations[] \as Operations;
\import Real.FiniteSums[].Linear[] \as Finite;
\definition smooth: \forall (a, b: Fin.Fin one) -> Trivial.Change[i := i, j := j].CoefficientSmooth a b :=
  \fun (a, b: Fin.Fin one) => Operations.constantSmooth Base.domain (Finite.basis one b (Fin.zero N.Nat^::zero));
