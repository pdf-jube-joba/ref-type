\use std.Logic[].Equality[].eq_reason_in;
\definition x: Charts.LocalPoint c := base p;
\definition y: Charts.LocalPoint c := Charts.point c (Charts.coordinate c x);
\definition same: x = y := sym!{{Charts.LocalPoint c}} _ _ (Geometry.pointCoordinate x);
\definition v: F y := Transport.cast F x y same p.vector;
\definition coordinates: decode y v = decode x p.vector := \parent.Move[x := x, y := y, same := same].coordinates p.vector;
\definition vector: encode y (decode x p.vector) = v := trans!{{F y}} _ _ _
  (congr!{{Vectors.Vector} {F y}} (encode y) _ _ (sym!{{Vectors.Vector}} _ _ coordinates)) (\parent.At[x := y].encodeDecode v);
\definition law: point (coordinate p) = p := eq_reason_in!{Point _
  "=" _ "by" { pointJoined (Charts.coordinate c x) (\into[Vectors.Vector](decode x p.vector, FiberOpen.whole.points) \by { \refl(decode x p.vector) }) }
  "=" _ "by" { congr!{{F y} Point} (include y) _ _ vector }
  "=" _ "by" { includeTransport x y same p.vector }
  "=" _ "by" { eta p }
};
