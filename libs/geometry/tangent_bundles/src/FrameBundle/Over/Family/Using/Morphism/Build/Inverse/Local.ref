\import Other.InChart[i := i] \as Source;
\import \parent.\parent.\parent.\parent.InChart[i := i] \as Target;
\import calculus.MatrixFamily[d := n, p := s, q := r].Lift[U := (chart i).image, A := Backward.matrix i, regular := inverseRegular i] \as Lift;
\import manifolds.EuclideanMap[n := sourceDimension, m := dimension].Between[U := Source.image, V := Target.image] \as Coordinates;
\import manifolds.ChartMap[n := dimension].On[M := SourceConstruction.manifold].At[chart := SourceConstruction.chart i] \as Parametrization;
\import manifolds.Composition[n := sourceDimension, m := dimension, l := dimension].Between[M := Coordinates.source, N := Coordinates.target, P := SourceConstruction.manifold] \as Compose;
\definition map: Plots.LocalMap i := Compose.compose (Coordinates.map Lift.map) Parametrization.map;
\module At(z: calculus.Real[].Multivariable[n := sourceDimension].Open[].Carrier Source.image);
\definition agrees: \forall (z: calculus.Real[].Multivariable[n := sourceDimension].Open[].Carrier Source.image) ->
  manifolds.SmoothMap[n := sourceDimension, m := dimension].Between[M := Coordinates.source, N := SourceConstruction.manifold].apply map z = apply (Source.point z) :=
  \fun (z: calculus.Real[].Multivariable[n := sourceDimension].Open[].Carrier Source.image) => At[z := z].agrees;
