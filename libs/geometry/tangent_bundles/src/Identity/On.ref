\import \root.Dimension[n := n].On[M := M] \as Bundle;
\import \root.Map[n := n, m := n].Between[M := M, N := M] \as Tangent;
\import manifolds.SelfMap[n := n].Identity[M := M] \as Identity;
\import manifolds.DifferentialIdentity[n := n].On[M := M] \as Differential;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.congr;
\definition pointwise: \forall (p: Bundle.Point) -> Tangent.apply Identity.map p = p :=
  \fun (p: Bundle.Point) => trans!{{Bundle.Point}} _ _ _
    (congr!{{manifolds.Tangent[n := n].On[M := M].Vector p.base} {Bundle.Point}} (Bundle.include p.base) _ _
      (Differential.At[x := p.base].pointwise p.vector)) (Bundle.eta p);
\definition law: Tangent.apply Identity.map = (\fun (p: Bundle.Point) => p) :=
  \axiom:funext((Tangent.apply Identity.map), (\fun (p: Bundle.Point) => p), pointwise);
\import manifolds.SmoothMap[n := Bundle.dimension, m := Bundle.dimension].Between[M := Bundle.manifold, N := Bundle.manifold] \as TotalMaps;
\import manifolds.SelfMap[n := Bundle.dimension].Identity[M := Bundle.manifold] \as TotalIdentity;
\definition smoothLaw: Tangent.Of[f := Identity.map].map = TotalIdentity.map :=
  TotalMaps.ext (Tangent.Of[f := Identity.map].map) TotalIdentity.map law;
