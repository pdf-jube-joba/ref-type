\use std.Logic[].Equality[].eq_reason_in;
\import \root.FrameBundle[n := n, r := one].Over[M := M].Family[F := \fun (x: M.Point) => R.Real, space := \fun (x: M.Point) => Spaces.scalarSpace] \as Family;
\definition Point: \Set := Family.Point;
\definition include: M.Point -> R.Real -> Point := Family.include;
\definition scalar[p: Point]: R.Real := p.vector;
\definition projection: Point -> M.Point := Family.projection;
\import \root.Trivial[n := n, r := one].On[M := M] \as Trivial;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\definition Chart: \Set := \Cast[Charts.Chart] M.atlas.charts;
\module Covered(I: \Set, chart: I -> Chart, covers: \forall (x: M.Point) -> \exists ( i: I \where Charts.Contains (chart i) x ));
\definition ext: \forall (p, q: Point) -> p.base = q.base -> p.vector = q.vector -> p = q :=
  \fun (p, q: Point)(base: _)(scalar: _) => eq_reason_in!{Point p
    "=" { include p.base p.vector } "by" { sym!{Point} _ _ (Family.eta p) }
    "=" _ "by" { congr!{{M.Point} {R.Real} Point} include p.base q.base p.vector q.vector base scalar }
    "=" _ "by" { Family.eta q }
  };
