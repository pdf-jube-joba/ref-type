\import Product.Universal[p := p].From[X := X].Of[f := f, g := g] \as Pair;
\import manifolds.Composition[n := p, m := dimension, l := dimension].Between[M := X, N := Product.manifold, P := manifold] \as Compose;
\definition map: manifolds.SmoothMap[n := p, m := dimension].Between[M := X, N := manifold].Map := Compose.compose Pair.map inverse;
