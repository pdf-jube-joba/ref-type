\import Product.Vector[] \as Vector;
\import manifolds.Dimension[n := one].Examples[].Euclidean[] \as Euclidean;
\import manifolds.Composition[n := dimension, m := dimension, l := one].Between[M := manifold, N := Product.manifold, P := Euclidean.smoothManifold] \as Compose;
\definition map: manifolds.SmoothMap[n := dimension, m := one].Between[M := manifold, N := Euclidean.smoothManifold].Map := Compose.compose forward Vector.map;
\definition formula: \forall (p: Point) -> manifolds.SmoothMap[n := dimension, m := one].Between[M := manifold, N := Euclidean.smoothManifold].apply map p = Line.forward.apply (scalar p) :=
  \fun (p: Point) => \refl(Line.forward.apply (scalar p));
