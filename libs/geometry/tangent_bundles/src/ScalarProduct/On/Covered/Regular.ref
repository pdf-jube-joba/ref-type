\definition formula: \forall (u: Open.Carrier (chart i).image) -> (Morphism.matrix i u).apply (E.basis b) a = E.basis b a :=
  \fun (u: Open.Carrier (chart i).image) => congr!{{E.Vector} {R.Real}} (\fun (v: E.Vector) => v a) _ _
    ((Spaces.Isomorphism[V := R.Real, W := E.Vector, source := Spaces.scalarSpace, target := E.space].laws Line.isomorphism).rightInverse (E.basis b));
\definition smooth: Open.Smooth[].SmoothOn (chart i).image (\fun (u: Open.Carrier (chart i).image) => (Morphism.matrix i u).apply (E.basis b) a) :=
  \idelim (\fun (u: Open.Carrier (chart i).image) => E.basis b a) = (\fun (u: Open.Carrier (chart i).image) => (Morphism.matrix i u).apply (E.basis b) a)
    \with f: Open.ScalarFunction (chart i).image => Open.Smooth[].SmoothOn (chart i).image f \by {
      base: Open.Smooth[].Operations[].constantSmooth (chart i).image (E.basis b a),
      equality: \axiom:funext((\fun (u: Open.Carrier (chart i).image) => E.basis b a), (\fun (u: Open.Carrier (chart i).image) => (Morphism.matrix i u).apply (E.basis b) a),
        \fun (u: Open.Carrier (chart i).image) => sym!{{R.Real}} _ _ (formula u))
    };
