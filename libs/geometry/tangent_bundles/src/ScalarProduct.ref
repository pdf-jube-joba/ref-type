\import real.Analysis[] \as R;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real (R.Algebra[].field)] \as Spaces;
\import Spaces.CoordinateLine[] \as Line;
\definition one: N.Nat^ := Line.one;
\definition dimension: N.Nat^ := calculus.Blocks[n := n, m := one].dimension;
\import linear_algebra.Euclidean[n := one] \as E;
\import manifolds.Dimension[n := n].Smooth[] \as BaseModels;
\import manifolds.Dimension[n := dimension].Smooth[] \as TotalModels;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\module On(M: BaseModels.Manifold);
