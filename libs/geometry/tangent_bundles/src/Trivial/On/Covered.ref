\definition local[i: I]: Family.Local := Family.Local { chart := chart i, frame := \fun (x: Charts.LocalPoint (chart i)) => identity };
\definition data: Family.Data[I] := Family.Data[I] { local := local, covers := covers };
\import Family.Using[I := I, data := data] \as Atlas;
\definition changes: Atlas.Changes := \fun (i, j: I)(a, b: Fin.Fin r) => BaseOpen.Smooth[].Operations[].constantSmooth
  Charts.Transition[left := chart i, right := chart j].domain (E.basis b a);
\import Atlas.Build[changes := changes] \as Construct;
\definition manifold: TotalModels.Manifold := Construct.manifold;
\module Vector;
\module Universal(p: N.Nat^);
\module Topology;

\import manifolds.Dimension[n := dimension].Chart[M := Point, space := manifold.space] \as TotalCharts;
\definition totalChart[i: I]: \Cast[TotalCharts.Chart] manifold.atlas.charts := Construct.totalChart i;
\definition chartCover: \forall (p: Point) -> \exists ( i: I \where TotalCharts.Contains (totalChart i) p ) := \fun (p: Point) => covers p.base;
