\import Blocks.On[U := (chart i).image, V := FiberOpen.whole] \as Product;
\import manifolds.EuclideanMap[n := dimension, m := r].Between[U := Product.domain, V := FiberOpen.whole] \as Coordinates;
\import manifolds.Dimension[n := r].Atlas[M := euclidean.Point, space := euclidean.space] \as EuclideanAtlases;
\definition standard: \Cast[manifolds.Dimension[n := r].Chart[M := euclidean.Point, space := euclidean.space].Chart] euclidean.atlas.charts :=
  \into[manifolds.Dimension[n := r].Chart[M := euclidean.Point, space := euclidean.space].Chart](Euclidean.standard, euclidean.atlas.charts) \by {
    EuclideanAtlases.includedInSaturation Euclidean.atlas Euclidean.standard (\refl(Euclidean.standard))
  };
\import manifolds.ChartMap[n := r].On[M := euclidean].At[chart := standard] \as Parametrization;
\import manifolds.Composition[n := dimension, m := r, l := r].Between[M := Coordinates.source, N := Coordinates.target, P := euclidean] \as Compose;
\definition map: Plots.LocalMap i := Compose.compose (Coordinates.map Product.rightMap) Parametrization.map;
