\import Construct.Plots[m := r].Into[N := euclidean] \as Plots;
\module Local(i: I);
\definition maps[i: I]: Plots.LocalMap i := Local[i := i].map;
\definition agrees: Plots.Agreement vector maps := \fun (i: I)(z: Open.Carrier Atlas.InChart[i := i].image) => \refl(vector (Atlas.InChart[i := i].point z));
\import Plots.Of[f := vector, maps := maps, agrees := agrees] \as Result;
\definition map: manifolds.SmoothMap[n := dimension, m := r].Between[M := manifold, N := euclidean].Map := Result.map;
