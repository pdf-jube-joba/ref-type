\definition agrees: manifolds.SmoothMap[n := p, m := dimension].Between[M := Coordinates.source, N := manifold].apply map u = apply (SourceCharts.point c (FirstCoordinates.leftCoordinate u)) :=
  trans!{Point} _ _ _ (Atlas.InChart[i := i].pointJoined (FirstCoordinates.apply u) (SecondCalculus.apply domain FiberOpen.whole second u))
    (congr!{{M.Point} Point} (\fun (x: M.Point) => include x (Second.apply g (SourceCharts.point c (FirstCoordinates.leftCoordinate u)))) _ _ (FirstCoordinates.returnsPoint u));
