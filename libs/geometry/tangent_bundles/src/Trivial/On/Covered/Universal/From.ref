\import manifolds.SmoothMap[n := p, m := n].Between[M := X, N := M] \as First;
\import manifolds.SmoothMap[n := p, m := r].Between[M := X, N := euclidean] \as Second;
\import manifolds.Dimension[n := p].Chart[M := X.Point, space := X.space] \as SourceCharts;
\import manifolds.Dimension[n := r].Chart[M := euclidean.Point, space := euclidean.space] \as FiberCharts;
\import manifolds.Dimension[n := r].Atlas[M := euclidean.Point, space := euclidean.space] \as FiberAtlas;
\module Of(f: First.Map, g: Second.Map);
