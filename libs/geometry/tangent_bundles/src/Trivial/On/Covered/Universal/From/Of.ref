\definition apply[x: X.Point]: Point := include (First.apply f x) (Second.apply g x);
\import manifolds.FromCharts[n := p, m := dimension].Between[M := X, N := manifold] \as Plots;
\module Local(c: Plots.SourceChart);
\definition maps: Plots.Family := \fun (c: Plots.SourceChart) => Local[c := c].map;
\definition agrees: Plots.Agreement apply maps := \fun (c: Plots.SourceChart)(u: SourceOpen.Carrier c.image) => Local[c := c].agrees u;
\import Plots.On[f := apply, maps := maps, agrees := agrees] \as Result;
\definition map: manifolds.SmoothMap[n := p, m := dimension].Between[M := X, N := manifold].Map := Result.value;
\definition formula: manifolds.SmoothMap[n := p, m := dimension].Between[M := X, N := manifold].apply map = apply := Result.apply;
