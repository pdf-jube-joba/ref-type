\import \root.FrameBundle[n := n, r := r].Over[M := M].Family[F := \fun (x: M.Point) => E.Vector, space := \fun (x: M.Point) => E.space] \as Family;
\definition Point: \Set := Family.Point;
\definition include: M.Point -> E.Vector -> Point := Family.include;
\definition projection: Point -> M.Point := Family.projection;
\definition vector[p: Point]: E.Vector := p.vector;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\definition Chart: \Set := \Cast[Charts.Chart] M.atlas.charts;
\import Spaces.Eigen[V := E.Vector, space := E.space] \as Identity;
\import Spaces.Isomorphism[V := E.Vector, W := E.Vector, source := E.space, target := E.space] \as Isomorphisms;
\definition identity: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := Identity.identity, backward := Identity.identity, leftInverse := \fun (v: E.Vector) => \refl(v), rightInverse := \fun (v: E.Vector) => \refl(v),
};
\module Covered(I: \Set, chart: I -> Chart, covers: \forall (x: M.Point) -> \exists ( i: I \where Charts.Contains (chart i) x ));
