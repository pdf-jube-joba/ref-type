\import Source.Plots[m := Target.dimension].Into[N := Target.manifold] \as Plots;
\module Local(c: Source.Chart);
\definition family[c: Source.Chart]: Plots.LocalMap c := Local[c := c].map;
\definition agrees: Plots.Agreement (apply f) family := \fun (c: Source.Chart)(z: Open.Carrier Source.InChart[chart := c].image) => \refl(apply f (Source.InChart[chart := c].point z));
\import Plots.Of[f := apply f, maps := family, agrees := agrees] \as Construct;
\import manifolds.SmoothMap[n := Source.dimension, m := Target.dimension].Between[M := Source.manifold, N := Target.manifold] \as TotalMaps;
\definition map: TotalMaps.Map := Construct.map;
\definition pointwise: TotalMaps.apply map = apply f := Construct.apply;
