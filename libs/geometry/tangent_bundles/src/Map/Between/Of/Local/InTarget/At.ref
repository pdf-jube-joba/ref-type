\definition t: BaseOpen.Carrier Coordinates.domain := Overlap.leftPoint z;
\definition w: Source.Vector := SourceBlocks.right z;
\definition x: M.Point := SourceCharts.point c (Coordinates.leftCoordinate t);
\definition a: N.Point := Maps.apply f x;
\definition b: TargetCharts.LocalPoint d := TargetCharts.point d (Coordinates.apply t);
\import Target.InChart[chart := d] \as TargetCoordinate;
\import SourceCoordinate.At[x := SourceCharts.point c (Coordinates.leftCoordinate t)] \as SourceFiber;
\import TargetCoordinate.At[x := b] \as TargetFiber;
\import manifolds.Tangent[n := m].On[M := N].At[x := a] \as Fiber;
\import Differential.At[f := f, x := x] \as D;
\definition targetChart: Fiber.Chart := \into[TargetCharts.Chart](d, Fiber.Chart) \by {
  Fiber.ChartLaws[d] { member := \bysub(TargetCharts.Chart, N.atlas.charts, d), contains := Coordinates.inRightDomain t }
};
\import D.InCharts[left := SourceFiber.tangentChart, right := targetChart] \as LocalD;
\definition inputEquality: LocalD.point = t := SourceCharts.Of[chart := c].coordinatePoint (Coordinates.leftCoordinate t);
\definition jacobian: LocalD.jacobian = Calculus.Differential[U := Coordinates.domain, V := d.image, f := coordinateMap, a := t].value :=
  congr!{{BaseOpen.Carrier Coordinates.domain} {calculus.Vector[n := n, m := m].LinearMap}}
    (\fun (u: BaseOpen.Carrier Coordinates.domain) => Calculus.Differential[U := Coordinates.domain, V := d.image, f := coordinateMap, a := u].value)
    LocalD.point t inputEquality;
\definition differential: calculus.Vector[n := n, m := m].LinearMap := Calculus.Differential[U := Coordinates.domain, V := d.image, f := coordinateMap, a := t].value;
\definition v: Fiber.Vector := D.value.apply (SourceFiber.encode w);
\import Fiber.Coordinate[chart := targetChart] \as Decode;
\definition coordinates: Decode.decode v = differential.apply w := trans!{{Target.Vector}} _ _ _
  (D.coordinates SourceFiber.tangentChart targetChart (SourceFiber.encode w))
  (trans!{{Target.Vector}} _ _ _ (congr!{{Source.Vector} {Target.Vector}} LocalD.jacobian.apply _ _ (SourceFiber.decodeEncode w))
    (congr!{{calculus.Vector[n := n, m := m].LinearMap} {Target.Vector}} (\fun (L: calculus.Vector[n := n, m := m].LinearMap) => L.apply w) _ _ jacobian));
\definition same: a = b := sym!{{N.Point}} _ _ (TargetCharts.Of[chart := d].pointCoordinate (Coordinates.point t));
\import manifolds.Tangent[n := m].On[M := N].Transport[x := a, y := b, same := same] \as Move;
\definition MovedVector: \Set := manifolds.Tangent[n := m].On[M := N].Vector b;
\definition moved: MovedVector := Move.vector v;
\definition chartSame: Move.chart targetChart = TargetFiber.tangentChart := Move.underlying targetChart;
\definition movedCoordinates: TargetFiber.decode moved = differential.apply w := trans!{{Target.Vector}} _ _ _
  (trans!{{Target.Vector}} _ _ _
    (congr!{{Move.ChartFamily b} {Target.Vector}} (\fun (e: Move.ChartFamily b) => Move.decode b e moved)
      TargetFiber.tangentChart (Move.chart targetChart) (sym!{{Move.ChartFamily b}} _ _ chartSame))
    (Move.coordinates targetChart v)) coordinates;
\definition vectorEquality: TargetFiber.encode (differential.apply w) = moved := trans!{MovedVector} _ _ _
  (congr!{{Target.Vector} MovedVector} TargetFiber.encode _ _ (sym!{{Target.Vector}} _ _ movedCoordinates)) (TargetFiber.encodeDecode moved);
\definition targetLeft: TargetBlocks.left (Lift.point z) = Coordinates.apply t := trans!{{Target.Vector}} _ _ _
  (congr!{{Target.TotalVector} {Target.Vector}} TargetBlocks.left _ _ (Lift.formula z))
  (TargetBlocks.leftJoin (Coordinates.apply t) (differential.apply w));
\definition targetRight: TargetBlocks.right (Lift.point z) = differential.apply w := trans!{{Target.Vector}} _ _ _
  (congr!{{Target.TotalVector} {Target.Vector}} TargetBlocks.right _ _ (Lift.formula z))
  (TargetBlocks.rightJoin (Coordinates.apply t) (differential.apply w));
\import TargetBlocks.On[U := d.image, V := TargetBaseOpen.whole] \as TargetProduct;
\definition expansion: TargetCoordinate.point (Lift.point z) = Target.include b (TargetFiber.encode (differential.apply w)) :=
  congr2!{{TargetBaseOpen.Carrier d.image} {Target.Vector} {Target.Point}} TargetCoordinate.assemble
    (TargetProduct.leftPoint (Lift.point z)) (Coordinates.apply t) (TargetBlocks.right (Lift.point z)) (differential.apply w) targetLeft targetRight;
\definition agrees: TargetCoordinate.point (Lift.point z) = apply f (SourceCoordinate.point (source z)) :=
  trans!{{Target.Point}} _ _ _ expansion (trans!{{Target.Point}} _ _ _
    (congr!{MovedVector {Target.Point}} (Target.include b) _ _ vectorEquality) (Target.includeTransport a b same v));
