\import \root.Dimension[n := n].On[M := M] \as Source;
\import \root.Dimension[n := m].On[M := N] \as Target;
\import manifolds.SmoothMap[n := n, m := m].Between[M := M, N := N] \as Maps;
\import manifolds.Differential[n := n, m := m].Between[M := M, N := N] \as Differential;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as Real;
\import calculus.Real[].Multivariable[n := n].Open[] \as BaseOpen;
\import calculus.Real[].Multivariable[n := m].Open[] \as TargetBaseOpen;
\import calculus.Real[].Multivariable[n := Source.dimension].Open[] \as Open;
\import calculus.Real[].Multivariable[n := Target.dimension].Open[] \as TargetOpen;
\import calculus.Blocks[n := n, m := n] \as SourceBlocks;
\import calculus.Blocks[n := m, m := m] \as TargetBlocks;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as SourceCharts;
\import manifolds.Dimension[n := m].Chart[M := N.Point, space := N.space] \as TargetCharts;
\definition apply[f: Maps.Map][p: Source.Point]: Target.Point := Target.include (Maps.apply f p.base) (Differential.At[f := f, x := p.base].value.apply p.vector);
\definition projection: \forall (f: Maps.Map)(p: Source.Point) -> Target.projection (apply f p) = Maps.apply f (Source.projection p) :=
  \fun (f: Maps.Map)(p: Source.Point) => \refl(Maps.apply f p.base);
\module Of(f: Maps.Map);
