\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\import real.Analysis[] \as R;
\import linear_algebra.Euclidean[n := r] \as E;
\import linear_algebra.Field[].Space[K := R.Real, field := R.Algebra[].field] \as Spaces;
\import manifolds.Dimension[n := n].Smooth[] \as Models;
\import manifolds.Dimension[n := r].Smooth[] \as EuclideanModels;
\import manifolds.Dimension[n := r].Examples[].Euclidean[] \as Euclidean;
\definition euclidean: EuclideanModels.Manifold := Euclidean.smoothManifold;
\import calculus.Real[].Multivariable[n := n].Open[] \as BaseOpen;
\import calculus.Real[].Multivariable[n := r].Open[] \as FiberOpen;
\import calculus.Blocks[n := n, m := r] \as Blocks;
\definition dimension: N.Nat^ := Blocks.dimension;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Open;
\import manifolds.Dimension[n := dimension].Smooth[] \as TotalModels;
\module On(M: Models.Manifold);
