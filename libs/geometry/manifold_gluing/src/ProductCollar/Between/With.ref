\import \root.BoundaryInclusion[n := n].On[M := M].With[cover := leftCover] \as LeftBase;
\import \root.BoundaryInclusion[n := m].On[M := N].With[cover := rightCover] \as RightBase;
\import \root.Parameter[] \as Time;
\import boundary_manifolds.Product[n := n, m := One.dimension].Of[M := LeftBase.manifold, N := Time.manifold] \as LeftParameter;
\import boundary_manifolds.Product[n := m, m := One.dimension].Of[M := RightBase.manifold, N := Time.manifold] \as RightParameter;
\module From(left: LeftTransverse.Result, right: RightTransverse.Result);
\module Compact(leftCompact: LeftSpace.IsCompact M.space, rightCompact: RightSpace.IsCompact N.space);
