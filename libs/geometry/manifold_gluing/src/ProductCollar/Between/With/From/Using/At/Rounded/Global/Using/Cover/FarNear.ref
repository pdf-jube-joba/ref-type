\import FarCharts.In[c := c] \as From;
\import NearCharts.In[c := d] \as To;
\definition start: From.Point := \into[Point](y, From.domain) \by { first };
\definition finish: To.Point := \into[Point](y, To.domain) \by { second };
\definition a: Far.Point := From.old start;
\definition sourceValue: (farHomeomorphism.forward a \of Point) = y := From.valueOld start;
\definition physicalValue: (a \of Product.Point) = (y \of Product.Point) := congr!{{Point} {Product.Point}} (\fun (p: Point) => p) _ _ sourceValue;
\definition member: Space.Member near a := \idelim (y \of Product.Point) = (a \of Product.Point) \with p: Product.Point => Space.Member near p \by {
  base: \bysub(Point, nearRegion, To.range finish), equality: sym!{{Product.Point}} _ _ physicalValue
};
\import \parent.\parent.FarTransition[x := a, member := member] \as Transition;
\import \root.LocalSmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n)].Between[M := Far.manifold, N := nearManifold].Of[function := Transition.function] \as Local;
\import \root.ChartCross[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n)].Between[M := Far.manifold, N := nearManifold].Into[A := Point, space := topology, U := farRegion, V := nearRegion, openU := farRegionOpen, openV := nearRegionOpen, h := farHomeomorphism, k := nearHomeomorphism].Along[f := Transition.function, x := a, W := Transition.W, openW := Transition.openW, inW := member, agrees := Transition.agrees] \as Cross;
\definition exists: \exists Charts.At[x := y, left := farChart c, right := nearChart d, inLeft := first].Extension := \block {
  \takefrom chosen: Local.Witness[a] \by Transition.exists \then
  \return Cross.Across[c := c, d := d, y := y, same := sourceValue, inLeft := first, inRight := second, chosen := chosen].exists
};
