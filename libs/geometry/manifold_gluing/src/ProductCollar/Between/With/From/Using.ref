\import \root.CollarEmbedding[n := n].On[M := M].With[cover := leftCover].From[deformation := left].Of[regular := leftRegular] \as LeftCollar;
\import \root.CollarEmbedding[n := m].On[M := N].With[cover := rightCover].From[deformation := right].Of[regular := rightRegular] \as RightCollar;
\import \root.CollarEmbedding[n := n].On[M := M].With[cover := leftCover].From[deformation := left] \as LeftMap;
\import \root.CollarEmbedding[n := m].On[M := N].With[cover := rightCover].From[deformation := right] \as RightMap;
\import boundary_manifolds.SmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := LeftParameter.manifold, N := M] \as LeftMaps;
\import boundary_manifolds.SmoothMap[n := Nat.add One.dimension m, m := Nat.add One.dimension m].Between[M := RightParameter.manifold, N := N] \as RightMaps;
\module At(leftWidth: LeftCollar.Width, rightWidth: RightCollar.Width);
