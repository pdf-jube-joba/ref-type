\definition firstSmall: R.Lt (Round.u (raw p)) Estimates.three := Order.byContradiction (R.Lt (Round.u (raw p)) Estimates.three) (\fun (notSmall: Logic.Not (R.Lt (Round.u (raw p)) Estimates.three)) =>
  R.ltNotLeReverse (value p) S.zero negative (Estimates.Far[x := raw p, quarter := quarter p, far := Logic.Or[R.Le Estimates.three (Round.u (raw p)), R.Le Estimates.three (Round.v (raw p))]::left (Order.leOfNotLtReverse Estimates.three (Round.u (raw p)) notSmall)].member));
\definition secondSmall: R.Lt (Round.v (raw p)) Estimates.three := Order.byContradiction (R.Lt (Round.v (raw p)) Estimates.three) (\fun (notSmall: Logic.Not (R.Lt (Round.v (raw p)) Estimates.three)) =>
  R.ltNotLeReverse (value p) S.zero negative (Estimates.Far[x := raw p, quarter := quarter p, far := Logic.Or[R.Le Estimates.three (Round.u (raw p)), R.Le Estimates.three (Round.v (raw p))]::right (Order.leOfNotLtReverse Estimates.three (Round.v (raw p)) notSmall)].member));
\structure Bounds: \Prop := { first: R.Le (firstTime p) Scale.inner, second: R.Le (secondTime p) Scale.inner, };
\definition bounds: Bounds := Bounds {
  first := Order.leOfLt (firstTime p) Scale.inner (Normalize.ofLt (firstTime p) Estimates.three (R.ltReplaceLeft (Round.u (raw p)) (first p) Estimates.three (Plane.first (first p) (second p)) firstSmall)),
  second := Order.leOfLt (secondTime p) Scale.inner (Normalize.ofLt (secondTime p) Estimates.three (R.ltReplaceLeft (Round.v (raw p)) (second p) Estimates.three (Plane.second (first p) (second p)) secondSmall)),
};
