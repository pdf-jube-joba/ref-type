\import \root.ProductMaps[n := Nat.add One.dimension n, m := Nat.add One.dimension m].Of[M := LeftModel.manifold, N := RightModel.manifold] \as Projections;
\import \root.ProductMaps[n := n, m := One.dimension].Of[M := LeftBase.manifold, N := Time.manifold] \as LeftProjections;
\import \root.ProductMaps[n := m, m := One.dimension].Of[M := RightBase.manifold, N := Time.manifold] \as RightProjections;
\definition left: boundary_manifolds.SmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add One.dimension n].Between[M := Source.manifold, N := LeftParameter.manifold].Map :=
  boundary_manifolds.MapComposition[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add One.dimension n, l := Nat.add One.dimension n].Between[M := Source.manifold, N := LeftModel.manifold, P := LeftParameter.manifold].Of[f := Projections.First[].map, g := LeftModel.Inclusion[].map].map;
\definition right: boundary_manifolds.SmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add One.dimension m].Between[M := Source.manifold, N := RightParameter.manifold].Map :=
  boundary_manifolds.MapComposition[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add One.dimension m, l := Nat.add One.dimension m].Between[M := Source.manifold, N := RightModel.manifold, P := RightParameter.manifold].Of[f := Projections.Second[].map, g := RightModel.Inclusion[].map].map;
\definition leftBase: boundary_manifolds.SmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := n].Between[M := Source.manifold, N := LeftBase.manifold].Map :=
  boundary_manifolds.MapComposition[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add One.dimension n, l := n].Between[M := Source.manifold, N := LeftParameter.manifold, P := LeftBase.manifold].Of[f := left, g := LeftProjections.First[].map].map;
\definition rightBase: boundary_manifolds.SmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := m].Between[M := Source.manifold, N := RightBase.manifold].Map :=
  boundary_manifolds.MapComposition[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add One.dimension m, l := m].Between[M := Source.manifold, N := RightParameter.manifold, P := RightBase.manifold].Of[f := right, g := RightProjections.First[].map].map;
\definition leftTime: boundary_manifolds.SmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := One.dimension].Between[M := Source.manifold, N := Time.manifold].Map :=
  boundary_manifolds.MapComposition[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add One.dimension n, l := One.dimension].Between[M := Source.manifold, N := LeftParameter.manifold, P := Time.manifold].Of[f := left, g := LeftProjections.Second[].map].map;
\definition rightTime: boundary_manifolds.SmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := One.dimension].Between[M := Source.manifold, N := Time.manifold].Map :=
  boundary_manifolds.MapComposition[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add One.dimension m, l := One.dimension].Between[M := Source.manifold, N := RightParameter.manifold, P := Time.manifold].Of[f := right, g := RightProjections.Second[].map].map;
\definition baseMap: boundary_manifolds.SmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add m n].Between[M := Source.manifold, N := Base.manifold].Map :=
  \root.ProductMaps[n := n, m := m].Of[M := LeftBase.manifold, N := RightBase.manifold].Pairing[p := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n)].From[P := Source.manifold].Using[f := leftBase, g := rightBase].map;
\import boundary_manifolds.Product[n := One.dimension, m := One.dimension].Of[M := Time.manifold, N := Time.manifold] \as Times;
\definition timeMap: boundary_manifolds.SmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add One.dimension One.dimension].Between[M := Source.manifold, N := Times.manifold].Map :=
  \root.ProductMaps[n := One.dimension, m := One.dimension].Of[M := Time.manifold, N := Time.manifold].Pairing[p := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n)].From[P := Source.manifold].Using[f := leftTime, g := rightTime].map;
\import \root.TimePlane[].At[q := Scale.q, positive := Scale.qPositive] \as NormalizeTimes;
\import \root.SupportedRounding[].Higher[n := Nats.Nat^::zero].Quarter[] \as Quarter;
\import boundary_manifolds.Dimension[n := Round.dimension].Quadrant[C := Quarter.constraints, U := RoundOpen.whole] \as WholeQuarter;
\definition normalMap: boundary_manifolds.SmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Round.dimension].Between[M := Source.manifold, N := WholeQuarter.manifold].Map :=
  boundary_manifolds.MapComposition[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add One.dimension One.dimension, l := Round.dimension].Between[M := Source.manifold, N := Times.manifold, P := WholeQuarter.manifold].Of[f := timeMap, g := NormalizeTimes.map].map;
\import boundary_manifolds.SmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add One.dimension One.dimension].Between[M := Source.manifold, N := Times.manifold] \as TimeMaps;
\import boundary_manifolds.SmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Round.dimension].Between[M := Source.manifold, N := WholeQuarter.manifold] \as NormalMaps;
\definition normalSame: \forall (p: Source.Point) -> (NormalMaps.apply normalMap p \of RoundModel.Point) = (raw p \of RoundModel.Point) := \fun (p: Source.Point) => NormalizeTimes.formula (TimeMaps.apply timeMap p);
\definition firstCoordinate: \forall (p: Source.Point) -> NormalMaps.apply normalMap p Round.firstNormal = first p := \fun (p: Source.Point) => trans!{S.Real} _ _ _ (congr!{{RoundModel.Point} S.Real} (\fun (x: RoundModel.Point) => x Round.firstNormal) _ _ (normalSame p)) (Plane.first (first p) (second p));
\definition secondCoordinate: \forall (p: Source.Point) -> NormalMaps.apply normalMap p Round.secondNormal = second p := \fun (p: Source.Point) => trans!{S.Real} _ _ _ (congr!{{RoundModel.Point} S.Real} (\fun (x: RoundModel.Point) => x Round.secondNormal) _ _ (normalSame p)) (Plane.second (first p) (second p));
\definition window: \forall (p: Source.Point) -> \In[RoundModel.Point] \root.RoundingWindow[].domain.points (NormalMaps.apply normalMap p) := \fun (p: Source.Point) => Logic.And[_, _]::#
  (R.ltReplaceLeft (first p) (NormalMaps.apply normalMap p Round.firstNormal) \root.RoundingScale[].four (sym!{S.Real} _ _ (firstCoordinate p)) (Normalize.lt (firstTime p) \root.RoundingScale[].four (\bysub(LeftParameter.Point, LeftWindow.points, Source.first p))))
  (R.ltReplaceLeft (second p) (NormalMaps.apply normalMap p Round.secondNormal) \root.RoundingScale[].four (sym!{S.Real} _ _ (secondCoordinate p)) (Normalize.lt (secondTime p) \root.RoundingScale[].four (\bysub(RightParameter.Point, RightWindow.points, Source.second p))));
\import \root.QuadrantFactor[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Round.dimension].From[M := Source.manifold, C := Quarter.constraints, U := RoundOpen.whole].Into[D := Quarter.constraints, V := \root.RoundingWindow[].domain].Of[f := normalMap, inside := window,
  nonnegative := \fun (p: Source.Point) => \bysub(RoundOpen.Carrier RoundOpen.whole, RoundModel.region Quarter.constraints RoundOpen.whole, NormalMaps.apply normalMap p)] \as Bounded;
\import boundary_manifolds.Dimension[n := Round.dimension].Quadrant[C := Quarter.constraints, U := \root.RoundingWindow[].domain] \as QuarterWindow;
\import boundary_manifolds.SmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Round.dimension].Between[M := Source.manifold, N := QuarterWindow.manifold] \as WindowMaps;
\definition map: WindowMaps.Map := Bounded.map;
\definition formula: \forall (p: Source.Point) -> (WindowMaps.apply map p \of RoundModel.Point) = (raw p \of RoundModel.Point) := normalSame;
