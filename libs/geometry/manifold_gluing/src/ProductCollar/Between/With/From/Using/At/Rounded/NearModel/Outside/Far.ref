\definition firstCoord: S.Real := CoordinateMaps.apply Coordinates.map p Round.firstNormal;
\definition secondCoord: S.Real := CoordinateMaps.apply Coordinates.map p Round.secondNormal;
\definition firstEqual: firstCoord = first p := Coordinates.firstCoordinate p;
\definition secondEqual: secondCoord = second p := Coordinates.secondCoordinate p;
\definition strict: ParameterSpace.Member points p := Logic.orElim (R.Lt Estimates.three firstCoord) (Logic.Not (R.Lt Estimates.three firstCoord)) (ParameterSpace.Member points p)
  (std.Logic[].Classical[].excludedMiddle (R.Lt Estimates.three firstCoord))
  (\fun (member: R.Lt Estimates.three firstCoord) => Logic.Or[_, _]::left member)
  (\fun (notFirst: Logic.Not (R.Lt Estimates.three firstCoord)) => Logic.orElim (R.Lt Estimates.three secondCoord) (Logic.Not (R.Lt Estimates.three secondCoord)) (ParameterSpace.Member points p)
    (std.Logic[].Classical[].excludedMiddle (R.Lt Estimates.three secondCoord))
    (\fun (member: R.Lt Estimates.three secondCoord) => Logic.Or[_, _]::right member)
    (\fun (notSecond: Logic.Not (R.Lt Estimates.three secondCoord)) => Logic.falseElim (ParameterSpace.Member points p) (far (coreOfTimes p
      (Normalize.ofLe (firstTime p) Estimates.three (R.leReplaceLeft firstCoord (first p) Estimates.three firstEqual (Order.leOfNotLtReverse firstCoord Estimates.three notFirst)))
      (Normalize.ofLe (secondTime p) Estimates.three (R.leReplaceLeft secondCoord (second p) Estimates.three secondEqual (Order.leOfNotLtReverse secondCoord Estimates.three notSecond)))))));
