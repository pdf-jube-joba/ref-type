\definition leftIntrinsic: LeftAtlas.Point := \into[M.Point](Product.first x, LeftAtlas.points) \by { leftBoundary };
\definition rightIntrinsic: RightAtlas.Point := \into[N.Point](Product.second x, RightAtlas.points) \by { rightBoundary };
\definition leftBase: LeftBase.manifold.Point := \into[LeftAtlas.Point](leftIntrinsic, topology.Topology[Carrier := LeftAtlas.Point].Whole) \by { \refl(leftIntrinsic) };
\definition rightBase: RightBase.manifold.Point := \into[RightAtlas.Point](rightIntrinsic, topology.Topology[Carrier := RightAtlas.Point].Whole) \by { \refl(rightIntrinsic) };
\definition leftParameter: LeftModel.Point := \into[LeftParameter.Point](Pair.pair LeftBase.manifold.Point Time.Point leftBase Time.zero, LeftWindow.points) \by { Scale.outerPositive };
\definition rightParameter: RightModel.Point := \into[RightParameter.Point](Pair.pair RightBase.manifold.Point Time.Point rightBase Time.zero, RightWindow.points) \by { Scale.outerPositive };
\definition parameter: Source.Point := Pair.pair LeftModel.Point RightModel.Point leftParameter rightParameter;
\import \root.InwardNeighborhood[n := n].On[M := M].With[cover := leftCover].From[h := left.homotopy, active := left.active] \as LeftCandidate;
\import \root.InwardNeighborhood[n := m].On[M := N].With[cover := rightCover].From[h := right.homotopy, active := right.active] \as RightCandidate;
\definition valueSame: (Parameterization.forward parameter \of Product.Point) = x := Pair.Prop[A := M.Point, B := N.Point].ext (Parameterization.forward parameter) x (LeftCandidate.neighborhood.initial leftBase) (RightCandidate.neighborhood.initial rightBase);
\definition coreMember: Space.Member core x := \idelim (Parameterization.forward parameter \of Product.Point) = x \with p: Product.Point => Space.Member core p \by {
  base: coreOfTimes parameter (Order.leOfLt S.zero Scale.inner Scale.innerPositive) (Order.leOfLt S.zero Scale.inner Scale.innerPositive), equality: valueSame
};
\definition firstZero: Round.u (raw parameter) = S.zero := trans!{S.Real} _ _ _ (Plane.first (first parameter) (second parameter)) (R.Arithmetic[].Prop[].fieldMulZeroRight Normalize.inverse);
\definition secondZero: Round.v (raw parameter) = S.zero := trans!{S.Real} _ _ _ (Plane.second (first parameter) (second parameter)) (R.Arithmetic[].Prop[].fieldMulZeroRight Normalize.inverse);
\definition negative: R.Lt (value parameter) S.zero := Round.ZeroNormal[x := raw parameter, firstZero := firstZero, secondZero := secondZero].definingNegative;
\import \parent.ParameterRegion[] \as Membership;
\definition removedMember: Space.Member removed x := \idelim (Parameterization.forward parameter \of Product.Point) = x \with p: Product.Point => Space.Member removed p \by {
  base: Membership.negativeRemoved parameter negative, equality: valueSame
};
