\import NearCharts.In[c := c] \as From;
\import FarCharts.In[c := d] \as To;
\definition start: From.Point := \into[Point](y, From.domain) \by { first };
\definition finish: To.Point := \into[Point](y, To.domain) \by { second };
\definition a: nearManifold.Point := From.old start;
\definition sourceValue: (nearHomeomorphism.forward a \of Point) = y := From.valueOld start;
\definition physicalValue: NearMaps.apply nearMap a = (y \of Product.Point) := trans!{{Product.Point}} _ _ _ (nearValue a) (congr!{{Point} {Product.Point}} (\fun (p: Point) => p) _ _ sourceValue);
\definition member: Space.Member far (NearMaps.apply nearMap a) := \idelim (y \of Product.Point) = NearMaps.apply nearMap a \with p: Product.Point => Space.Member far p \by {
  base: \bysub(Point, farRegion, To.range finish), equality: sym!{{Product.Point}} _ _ physicalValue
};
\import \parent.\parent.NearTransition[x := a, member := member] \as Transition;
\import \root.LocalSmoothMap[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n), m := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n)].Between[M := nearManifold, N := Far.manifold].Of[function := Transition.function] \as Local;
\import \root.ChartCross[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n)].Between[M := nearManifold, N := Far.manifold].Into[A := Point, space := topology, U := nearRegion, V := farRegion, openU := nearRegionOpen, openV := farRegionOpen, h := nearHomeomorphism, k := farHomeomorphism].Along[f := Transition.function, x := a, W := Transition.W, openW := Transition.openW, inW := member, agrees := Transition.agrees] \as Cross;
\definition exists: \exists Charts.At[x := y, left := nearChart c, right := farChart d, inLeft := first].Extension := \block {
  \takefrom chosen: Local.Witness[a] \by Transition.exists \then
  \return Cross.Across[c := c, d := d, y := y, same := sourceValue, inLeft := first, inRight := second, chosen := chosen].exists
};
