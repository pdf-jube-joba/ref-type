\definition inverseEqual: \forall (p: Source.Point)(y: Parameterization.Point) -> (y \of Product.Point) = (Parameterization.forward p \of Product.Point) -> Parameterization.backward y = p :=
  \fun (p: Source.Point)(y: Parameterization.Point)(same: (y \of Product.Point) = (Parameterization.forward p \of Product.Point)) => trans!{{Source.Point}} _ _ _
    (congr!{{Parameterization.Point} {Source.Point}} Parameterization.backward _ _ (boundary_manifolds.Refinement[A := Product.Point].equality near y (Parameterization.forward p) same)) (Parameterization.leftInverse p);
\definition negativeRemoved: \forall (p: Source.Point) -> R.Lt (value p) S.zero -> Space.Member removed (Parameterization.forward p) := \fun (p: Source.Point)(negative: R.Lt (value p) S.zero) => NearSpace.Open[].imageMember bad (Parameterization.forward p)
  (\idelim p = Parameterization.backward (Parameterization.forward p) \with q: Source.Point => R.Lt (value q) S.zero \by { base: negative, equality: sym!{{Source.Point}} _ _ (Parameterization.leftInverse p) });
\definition nonnegativeContains: \forall (p: Source.Point) -> R.Le S.zero (value p) -> Space.Member points (Parameterization.forward p) := \fun (p: Source.Point)(nonnegative: R.Le S.zero (value p))(member: Space.Member removed (Parameterization.forward p)) =>
  NearSpace.Open[].imageElim bad (Parameterization.forward p) Logic.False
    (\fun (y: Parameterization.Point)(negative: topology.Topology[Carrier := Parameterization.Point].Member bad y)(same: (y \of Product.Point) = (Parameterization.forward p \of Product.Point)) =>
      R.ltNotLeReverse (value p) S.zero (\idelim Parameterization.backward y = p \with q: Source.Point => R.Lt (value q) S.zero \by { base: negative, equality: inverseEqual p y same }) nonnegative) member;
\definition containsNonnegative: \forall (p: Source.Point) -> Space.Member points (Parameterization.forward p) -> R.Le S.zero (value p) := \fun (p: Source.Point)(member: Space.Member points (Parameterization.forward p)) => Order.leOfNotLtReverse S.zero (value p)
  (\fun (negative: R.Lt (value p) S.zero) => member (negativeRemoved p negative));
