\import \root.CollarStrip[n := n].On[M := M].With[cover := leftCover].From[deformation := left] \as LeftStrip;
\import \root.CollarStrip[n := m].On[M := N].With[cover := rightCover].From[deformation := right] \as RightStrip;
\module Using(leftRegular: LeftStrip.RegularUniform, rightRegular: RightStrip.RegularUniform);
