\import \root.ProductCollar[n := n, m := m].Between[M := M, N := N].With[leftCover := leftCover, rightCover := rightCover].From[left := left.deformation, right := right.deformation].Using[leftRegular := left.regular, rightRegular := right.regular].At[leftWidth := leftWidth, rightWidth := rightWidth].Rounded[].Global[leftCompact := leftCompact, rightCompact := rightCompact] \as Rounding;
\definition exists: \exists Result := \block {
  \takefrom atlas: Rounding.Result \by Rounding.exists \then
  \return \exact(Result { left := left, right := right, leftWidth := leftWidth, rightWidth := rightWidth, atlas := atlas }, Result)
};
