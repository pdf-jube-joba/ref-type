\import \root.CollarEmbedding[n := n].On[M := M].With[cover := leftCover].From[deformation := left.deformation].Of[regular := left.regular] \as Left;
\import \root.CollarEmbedding[n := m].On[M := N].With[cover := rightCover].From[deformation := right.deformation].Of[regular := right.regular] \as Right;
\module Widths(leftWidth: Left.Width, rightWidth: Right.Width);
\definition exists: \exists Result := \block {
  \takefrom leftWidth: Left.Width \by Left.existsWidth \then
  \takefrom rightWidth: Right.Width \by Right.existsWidth \then
  \return Widths[leftWidth := leftWidth, rightWidth := rightWidth].exists
};
