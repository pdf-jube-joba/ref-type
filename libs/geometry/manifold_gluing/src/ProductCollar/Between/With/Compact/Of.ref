\import boundary_manifolds.Dimension[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n)] \as Models;
\import \root.ProductCollar[n := n, m := m].Between[M := M, N := N].With[leftCover := leftCover, rightCover := rightCover].From[left := result.left.deformation, right := result.right.deformation].Using[leftRegular := result.left.regular, rightRegular := result.right.regular].At[leftWidth := result.leftWidth, rightWidth := result.rightWidth] \as Parameters;
\import Parameters.Rounded[] \as Rounding;
\import Rounding.Global[leftCompact := leftCompact, rightCompact := rightCompact] \as Atlas;
\definition manifold: Models.Manifold := Atlas.manifold result.atlas;
\definition compact: topology.Topology[Carrier := manifold.Point].IsCompact manifold.space := Rounding.compact leftCompact rightCompact;
\definition unchanged: Space.Subset (Space.Complement Parameters.core) Rounding.points := Rounding.unchanged;
\definition removesCorners: \forall (x: Product.Point) -> \In[M.Point] LeftAtlas.points (Product.first x) -> \In[N.Point] RightAtlas.points (Product.second x) -> Logic.Not (\In[Product.Point] Rounding.points x) :=
  \fun (x: Product.Point)(leftBoundary: \In[M.Point] LeftAtlas.points (Product.first x))(rightBoundary: \In[N.Point] RightAtlas.points (Product.second x))(member: \In[Product.Point] Rounding.points x) => member (Rounding.Corner[x := x, leftBoundary := leftBoundary, rightBoundary := rightBoundary].removedMember);
