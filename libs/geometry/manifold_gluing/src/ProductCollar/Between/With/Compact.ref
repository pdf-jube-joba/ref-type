\import \root.CollarEmbedding[n := n].On[M := M].With[cover := leftCover] \as LeftCollars;
\import \root.CollarEmbedding[n := m].On[M := N].With[cover := rightCover] \as RightCollars;
\structure Result: \Set := {
  left: LeftCollars.Construction,
  right: RightCollars.Construction,
  leftWidth: \root.CollarEmbedding[n := n].On[M := M].With[cover := leftCover].From[deformation := left.deformation].Of[regular := left.regular].Width,
  rightWidth: \root.CollarEmbedding[n := m].On[M := N].With[cover := rightCover].From[deformation := right.deformation].Of[regular := right.regular].Width,
  atlas: \root.ProductCollar[n := n, m := m].Between[M := M, N := N].With[leftCover := leftCover, rightCover := rightCover].From[left := left.deformation, right := right.deformation].Using[leftRegular := left.regular, rightRegular := right.regular].At[leftWidth := leftWidth, rightWidth := rightWidth].Rounded[].Global[leftCompact := leftCompact, rightCompact := rightCompact].Result,
};
\module Build(left: LeftCollars.Construction, right: RightCollars.Construction);
\definition exists: \exists Result := \block {
  \takefrom left: LeftCollars.Construction \by LeftCollars.exists leftCompact \then
  \takefrom right: RightCollars.Construction \by RightCollars.exists rightCompact \then
  \return Build[left := left, right := right].exists
};
\module Of(result: Result);
