\import Open.Analysis[].Section[U := U, f := f, a := a, i := i] \as Section;
\definition Closed[left, right: S.Real]: \Set := \Cast[S.Real] (metric_spaces.RealLine[].ClosedInterval left right);
\definition Within[left, right: S.Real]: \Prop := \forall (s: Closed left right) -> \In[calculus.Real[].Multivariable[n := n].Point] U.points (Coordinates.replace a i s);
\definition sample[left, right: S.Real][contains: Within left right][s: Closed left right]: Open.Carrier U :=
  \into[calculus.Real[].Multivariable[n := n].Point](Coordinates.replace a i s, U.points) \by { contains s };
\definition Positive[left, right: S.Real][contains: Within left right]: \Prop := \forall (s: Closed left right) -> R.Lt S.zero (g (sample left right contains s));
\module Interval(left, right: S.Real, contains: Within left right, positive: Positive left right contains);
