\import topology.Topology[Carrier := Model.Carrier C U] \as Space;
\import topology.Topology[Carrier := Open.Carrier U] \as OpenSpace;
\import OpenSpace.Subspace[S := Model.region C U] \as Region;
\import topology.Topology[Carrier := Model.Point].Subspace[S := U.points] \as Domain;
\definition include[V: Open.OpenSet][included: Open.Included V U][x: Model.Carrier C V]: Model.Carrier C U :=
  \into[Open.Carrier U](Open.inclusion V U included x, Model.region C U) \by { \bysub(Open.Carrier V, Model.region C V, x) };
\structure Neighborhood[W: \Pow (Model.Carrier C U), a: Model.Carrier C U]: \Set := {
  domain: Open.OpenSet,
  included: Open.Included domain U,
  contains: \In[Model.Point] domain.points a,
  within: \forall (u: Model.Carrier C domain) -> Space.Member W (include domain included u),
};
\module At(W: \Pow (Model.Carrier C U), open: Space.IsOpenIn (Model.regionTopology C U) W, a: Model.Carrier C U, inside: Space.Member W a);
