\import Source.At[x := x] \as Domain;
\import Target.At[x := Maps.apply f x] \as Codomain;
\import Domain.Operations[] \as SourceOperations;
\import Codomain.Operations[] \as TargetOperations;
\import Domain.Cones[] \as SourceCones;
\import Codomain.Cones[] \as TargetCones;
\import boundary_manifolds.Differential[n := n, m := m].Between[M := M, N := N].At[f := f, x := x] \as D;
\import D.Cones[] \as Cones;
\import real.Analysis[] \as S;
\definition tangential: \forall (v: Domain.Vector) -> SourceCones.Tangential v -> TargetCones.Tangential (D.value.apply v) := \fun (v: Domain.Vector)(member: SourceCones.Tangential v) => Logic.And[_, _]::# (Cones.preserves v member.left)
  (\idelim D.value.apply (SourceOperations.negative v) = TargetOperations.negative (D.value.apply v) \with w: Codomain.Vector => TargetCones.Inward w \by {
    base: Cones.preserves (SourceOperations.negative v) member.right, equality: D.value.preservesScale (S.neg S.one) v
  });
