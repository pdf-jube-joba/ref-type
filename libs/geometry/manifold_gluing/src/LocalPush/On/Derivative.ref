\import \root.DifferentialRules[n := sourceDimension].On[U := Input.whole] \as Rules;
\import Input.Smooth[].Algebra[U := Input.whole] \as Functions;
\import Input.Smooth[].Differential[] \as Scalar;
\import Scalar.Operations[U := Input.whole] \as Differentiation;
\definition timeIndex: Fin.Fin sourceDimension := Fin.Sum[m := dimension, n := One.dimension].right One.index;
\definition timeFunction: Functions.Function := Rules.projection timeIndex;
\definition bumpFunction: Functions.Function := \into[Input.ScalarFunction Input.whole](bump, Functions.Function) \by { bumpSmooth };
\definition timeBump: Functions.Function := Functions.product timeFunction bumpFunction;
\definition displacementFunction: Functions.Function := Functions.product (Functions.constant q) timeBump;
\definition spatialIndex[i: Fin.Fin dimension]: Fin.Fin sourceDimension := Fin.Sum[m := dimension, n := One.dimension].left i;
\definition component[i: Fin.Fin dimension]: Functions.Function := Functions.plus (Rules.projection (spatialIndex i)) (Functions.product displacementFunction (Functions.constant (unit i)));
\definition InputPoint: \Set := Fin.Fin sourceDimension -> S.Real;
\module At(z0: Input.Carrier Input.whole, zeroTime: time z0 = S.zero);
