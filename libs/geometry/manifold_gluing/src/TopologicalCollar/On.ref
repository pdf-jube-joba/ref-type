\definition source: topology.Structures[].Topology[Product.CarrierSet] := Product.topology parameterSpace boundarySpace;
\definition Image[S: \Pow A]: \Set := \Cast[A] S;
\definition imageTopology[S: \Pow A]: topology.Structures[].Topology[Image S] := Space.Subspace[S := S].topology space;
\structure Data: \Set := {
  image: \Pow A,
  open: Space.IsOpenIn space image,
  homeomorphism: topology.Homeomorphism[A := Product.CarrierSet, B := Image image].Homeomorphism[source, imageTopology image],
  fixed: \forall (b: B) -> (homeomorphism.forward (Pair.pair T B zero b) \of A) = inclusion b,
};
\module Of(c: Data);
\module Comparison(c, d: Data);
