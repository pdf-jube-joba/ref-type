\import topology.Topology[Carrier := Product.CarrierSet] \as ProductSpace;
\definition preimage: \Pow Product.CarrierSet := { p: Product.CarrierSet \where Space.Member U (apply p) };
\definition fibre: \forall (b: B) -> ProductSpace.Member preimage (Pair.pair T B zero b) :=
  \fun (b: B) => \idelim inclusion b = apply (Pair.pair T B zero b) \with x: A => Space.Member U x \by {
    base: contains b, equality: sym!{A} _ _ (c.fixed b)
  };
\definition existsNeighborhood: Boundary.IsCompact boundarySpace ->
  \exists Product.Compactness[].Tube[parameterSpace, zero, preimage, Boundary.Whole] :=
  \fun (compact: Boundary.IsCompact boundarySpace) => Product.Compactness[].tubeLemma parameterSpace boundarySpace Boundary.Whole compact zero preimage
    (continuous U open) (\fun (b: B)(whole: _) => fibre b);
