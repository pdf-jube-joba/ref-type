\import boundary_manifolds.Tangent[n := n].On[M := M].At[x := x].Cones[] \as Source;
\import boundary_manifolds.Tangent[n := m].On[M := N].At[x := Maps.apply d.forward x].Cones[] \as Target;
\import \root.TangentTransportCones[n := n].On[M := M].Along[x := boundary_manifolds.SmoothMap[n := m, m := n].Between[M := N, N := M].apply d.backward (Maps.apply d.forward x), y := x, same := (Diffeomorphisms.laws d).leftInverse x] \as Transport;
\definition boundary: Logic.PropEquiv[Source.Boundary, Target.Boundary] := Logic.PropEquiv[_, _] {
  ltr := Forward.At[x := x].boundary,
  rtl := \fun (member: Target.Boundary) => Transport.boundary (Backward.At[x := Maps.apply d.forward x].boundary member),
};
