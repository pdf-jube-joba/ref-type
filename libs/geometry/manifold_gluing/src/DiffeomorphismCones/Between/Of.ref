\import \root.SmoothLeftInverseCones[n := n, m := m].Between[M := M, N := N].From[f := d.forward, g := d.backward, inverse := (Diffeomorphisms.laws d).leftInverse] \as Forward;
\import \root.SmoothLeftInverseCones[n := m, m := n].Between[M := N, N := M].From[f := d.backward, g := d.forward, inverse := (Diffeomorphisms.laws d).rightInverse] \as Backward;
\module At(x: M.Point);
