\import \root.BoundaryInclusion[n := k].On[M := P].With[cover := pCover] \as PInclusion;
\import \root.BoundaryInclusion[n := k].On[M := Q].With[cover := qCover] \as QInclusion;
\import \root.Diffeomorphism[n := k, m := k].Between[M := PInclusion.manifold, N := QInclusion.manifold] \as TargetDiffeomorphisms;
\import boundary_manifolds.SmoothMap[n := k, m := k].Between[M := PInclusion.manifold, N := QInclusion.manifold] \as TargetBoundaryMaps;
\module Along(e: TargetDiffeomorphisms.Diffeomorphism);
