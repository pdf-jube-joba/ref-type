\definition fullMember: \In[N.Point] Right.image a := \block {
  \takefrom x: \Cast[RightImage.Input] ({ x: RightImage.Input \where RightMaps.apply RightMap.map x = a }) \by member \then
  \let regular: Right.Point := \into[RightProduct.Point](x, Right.domain) \by { rightIncluded x (\bysub(RightProduct.Point, rightDomain, x)) } \then
  \return Logic.existsIntro[Right.Point, { p: Right.Point \where RightMaps.apply RightMap.map p = a }] regular
    (\bysub(RightImage.Input, { x: RightImage.Input \where RightMaps.apply RightMap.map x = a }, x))
};
\definition collar: Right.ImagePoint := \into[N.Point](a, Right.image) \by { fullMember };
\definition input: Right.Point := Right.backward collar;
\definition small: R.Lt (Time.value (RightProduct.second input)) epsilon := \block {
  \takefrom x: \Cast[RightImage.Input] ({ x: RightImage.Input \where RightMaps.apply RightMap.map x = a }) \by member \then
  \let regular: Right.Point := \into[RightProduct.Point](x, Right.domain) \by { rightIncluded x (\bysub(RightProduct.Point, rightDomain, x)) } \then
  \return \idelim regular = input \with p: Right.Point => R.Lt (Time.value (RightProduct.second p)) epsilon \by {
    base: \bysub(RightProduct.Point, rightDomain, x), equality: Right.uniquePreimage collar regular (\bysub(RightImage.Input, { x: RightImage.Input \where RightMaps.apply RightMap.map x = a }, x))
  }
};
\definition smallInput: RightImage.Input := \into[RightProduct.Point](input, rightDomain) \by { small };
\import \parent.RightAt[x := smallInput] \as SignedPoint;
\definition point: Source.Point := SignedPoint.point;
\definition value: apply point = Gluing.inr a := trans!{{Gluing.Point}} _ _ _ SignedPoint.value
  (congr!{{N.Point} {Gluing.Point}} Gluing.inr _ _ (Right.rightValue collar));
