\import S.Distance[] \as Metric;
\definition epsilon: S.Real := Metric.min leftWidth.radius rightWidth.radius;
\definition positive: R.Lt S.zero epsilon := S.Estimates[].Product[].minPositive leftWidth.radius rightWidth.radius leftWidth.positive rightWidth.positive;
\definition bounded: R.Le epsilon S.one := R.leTrans epsilon leftWidth.radius S.one (Metric.minLeft leftWidth.radius rightWidth.radius) leftWidth.bounded;
\definition parameters: Parameters := Parameters {
  epsilon := epsilon, positive := positive, bounded := bounded,
  leftWithin := \fun (t: Time.Point)(small: _) => leftWidth.within t (R.ltLeTrans (Time.value t) epsilon leftWidth.radius small (Metric.minLeft leftWidth.radius rightWidth.radius)),
  rightWithin := \fun (t: Time.Point)(small: _) => rightWidth.within t (R.ltLeTrans (Time.value t) epsilon rightWidth.radius small (Metric.minRight leftWidth.radius rightWidth.radius)),
};
