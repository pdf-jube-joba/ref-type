\import real.Analysis[] \as S;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import R.Arithmetic[].Prop[] \as Laws;
\import std.Data[].Pair[] \as Pair;
\import \root.Parameter[] \as Time;
\import \root.CollarEmbedding[n := n].On[M := M].With[cover := leftCover].From[deformation := left].Of[regular := leftRegular] \as Left;
\import \root.CollarEmbedding[n := n].On[M := N].With[cover := rightCover].From[deformation := right].Of[regular := rightRegular] \as Right;
\structure Parameters: \Set := {
  epsilon: S.Real,
  positive: R.Lt S.zero epsilon,
  bounded: R.Le epsilon S.one,
  leftWithin: \forall (t: Time.Point) -> R.Lt (Time.value t) epsilon -> \In[Time.Point] leftRegular.uniform.neighborhood t,
  rightWithin: \forall (t: Time.Point) -> R.Lt (Time.value t) epsilon -> \In[Time.Point] rightRegular.uniform.neighborhood t,
};
\module At(epsilon: S.Real, positive: R.Lt S.zero epsilon, bounded: R.Le epsilon S.one,
  leftWithin: \forall (t: Time.Point) -> R.Lt (Time.value t) epsilon -> \In[Time.Point] leftRegular.uniform.neighborhood t,
  rightWithin: \forall (t: Time.Point) -> R.Lt (Time.value t) epsilon -> \In[Time.Point] rightRegular.uniform.neighborhood t);
\module FromWidths(leftWidth: Left.Width, rightWidth: Right.Width);
\definition existsParameters: \exists Parameters := \block {
  \takefrom leftWidth: Left.Width \by Left.existsWidth \then
  \takefrom rightWidth: Right.Width \by Right.existsWidth \then
  \return \exact(FromWidths[leftWidth := leftWidth, rightWidth := rightWidth].parameters, Parameters)
};
