\import TargetCollar.Image[].Compact[leftCompact := pCompact, rightCompact := qCompact].Cover[] \as TargetGluing;
\import TargetGluing.Inclusions[] \as TargetInclusions;
\structure Data: \Set := {
  left: SideLeftMaps.Map,
  right: SideRightMaps.Map,
  base: BaseMaps.Map,
  preserveLeft: \forall (b: LeftBoundary.manifold.Point)(t: Time.Point) -> R.Lt (Time.value t) epsilon ->
    SideLeftMaps.apply left (LeftMaps.apply LeftMap.map (Pair.pair LeftBoundary.manifold.Point Time.Point b t)) =
      PMaps.apply PMap.map (Pair.pair PInclusion.manifold.Point Time.Point (BaseMaps.apply base b) t),
  preserveRight: \forall (b: LeftBoundary.manifold.Point)(t: Time.Point) -> R.Lt (Time.value t) epsilon ->
    SideRightMaps.apply right (RightMaps.apply RightMap.map (Pair.pair RightBoundary.manifold.Point Time.Point (BoundaryMaps.apply d.forward b) t)) =
      QMaps.apply QMap.map (Pair.pair QInclusion.manifold.Point Time.Point (TargetBoundaryMaps.apply e.forward (BaseMaps.apply base b)) t),
};
\module Of(data: Data);
