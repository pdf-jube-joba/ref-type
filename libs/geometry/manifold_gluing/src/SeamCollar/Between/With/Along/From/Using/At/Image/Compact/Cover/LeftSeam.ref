\import LeftTransport.In[c := c] \as From;
\import SeamTransport.In[c := d] \as To;
\definition start: From.Point := \into[Gluing.Point](y, From.domain) \by { first };
\definition finish: To.Point := \into[Gluing.Point](y, To.domain) \by { second };
\definition a: LeftInside.manifold.Point := From.old start;
\definition sourceValue: Gluing.inl a = y := LeftPatch.classValue (From.range start);
\definition member: \In[M.Point] LeftImage.image a := Region.toLeft a
  (\idelim y = Gluing.inl a \with q: Gluing.Point => Target.Member image q \by {
    base: \bysub(Gluing.Point, image, To.range finish), equality: sym!{{Gluing.Point}} _ _ sourceValue
  });
\import \parent.\parent.LeftInverse[x := a, member := member] \as Transition;
\import \root.LocalSmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := LeftInside.manifold, N := Source.manifold].Of[function := Transition.function] \as Local;
\import \root.ChartCross[n := Nat.add One.dimension n].Between[M := LeftInside.manifold, N := Source.manifold].Into[
  A := Gluing.Point, space := Gluing.topology, U := LeftPatch.image, V := image, openU := Interiors.leftOpen, openV := open, h := LeftPatch.homeomorphism, k := homeomorphism].Along[
  f := Transition.function, x := a, W := Transition.W, openW := Transition.openW, inW := member, agrees := Transition.classValue] \as Cross;
\definition exists: \exists Charts.At[x := y, left := Interiors.leftChart c, right := Seam.chart d, inLeft := first].Extension := \block {
  \takefrom chosen: Local.Witness[a] \by Transition.exists \then
  \return Cross.Across[c := c, d := d, y := y, same := sourceValue, inLeft := first, inRight := second, chosen := chosen].exists
};
