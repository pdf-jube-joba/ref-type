\definition fullMember: \In[M.Point] Left.image a := \block {
  \takefrom x: \Cast[LeftImage.Input] ({ x: LeftImage.Input \where LeftMaps.apply LeftMap.map x = a }) \by member \then
  \let regular: Left.Point := \into[LeftProduct.Point](x, Left.domain) \by { leftIncluded x (\bysub(LeftProduct.Point, leftDomain, x)) } \then
  \return Logic.existsIntro[Left.Point, { p: Left.Point \where LeftMaps.apply LeftMap.map p = a }] regular
    (\bysub(LeftImage.Input, { x: LeftImage.Input \where LeftMaps.apply LeftMap.map x = a }, x))
};
\definition collar: Left.ImagePoint := \into[M.Point](a, Left.image) \by { fullMember };
\definition input: Left.Point := Left.backward collar;
\definition small: R.Lt (Time.value (LeftProduct.second input)) epsilon := \block {
  \takefrom x: \Cast[LeftImage.Input] ({ x: LeftImage.Input \where LeftMaps.apply LeftMap.map x = a }) \by member \then
  \let regular: Left.Point := \into[LeftProduct.Point](x, Left.domain) \by { leftIncluded x (\bysub(LeftProduct.Point, leftDomain, x)) } \then
  \return \idelim regular = input \with p: Left.Point => R.Lt (Time.value (LeftProduct.second p)) epsilon \by {
    base: \bysub(LeftProduct.Point, leftDomain, x), equality: Left.uniquePreimage collar regular (\bysub(LeftImage.Input, { x: LeftImage.Input \where LeftMaps.apply LeftMap.map x = a }, x))
  }
};
\definition smallInput: LeftImage.Input := \into[LeftProduct.Point](input, leftDomain) \by { small };
\import \parent.LeftAt[x := smallInput] \as SignedPoint;
\definition point: Source.Point := SignedPoint.point;
\definition value: apply point = Gluing.inl a := trans!{{Gluing.Point}} _ _ _ SignedPoint.value
  (congr!{{M.Point} {Gluing.Point}} Gluing.inl _ _ (Left.rightValue collar));
