\import LeftTransport.In[c := c] \as From;
\import RightTransport.In[c := d] \as To;
\definition start: From.Point := \into[Gluing.Point](y, From.domain) \by { first };
\definition finish: To.Point := \into[Gluing.Point](y, To.domain) \by { second };
\definition a: LeftInside.manifold.Point := From.old start;
\definition b: RightInside.manifold.Point := To.old finish;
\definition leftValue: Gluing.inl a = y := LeftPatch.classValue (From.range start);
\definition rightValue: Gluing.inr b = y := RightPatch.classValue (To.range finish);
\definition impossible: Logic.False := Sides.crossLeftImpossible a b (\bysub(M.Point, LeftInterior.points, a))
  (trans!{{Gluing.Point}} _ _ _ leftValue (sym!{{Gluing.Point}} _ _ rightValue));
