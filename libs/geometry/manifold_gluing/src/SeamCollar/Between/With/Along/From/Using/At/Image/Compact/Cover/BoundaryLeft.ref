\definition intrinsic: LeftAtlas.Point := \into[M.Point](a, LeftAtlas.points) \by { boundary };
\definition b: LeftBoundary.manifold.Point := \into[LeftAtlas.Point](intrinsic, topology.Topology[Carrier := LeftAtlas.Point].Whole) \by { \refl(intrinsic) };
\definition point: Source.Point := Pair.pair LeftBoundary.manifold.Point Signed.Point b Signed.zero;
\definition value: apply point = Gluing.inl a := trans!{{Gluing.Point}} _ _ _ (onLeft point (R.leRefl S.zero)) (Initial.leftInitial point Signed.plusAtZero);
\definition member: Target.Member image (Gluing.inl a) := \idelim apply point = Gluing.inl a \with y: Gluing.Point => Target.Member image y \by {
  base: included point, equality: value
};
