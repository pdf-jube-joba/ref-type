\definition outputEqual: LeftMaps.apply LeftMap.map (leftParameter p) = LeftMaps.apply LeftMap.map (leftParameter q) :=
  Gluing.leftInjective _ _ (trans!{{Gluing.Point}} _ _ _ (sym!{{Gluing.Point}} _ _ (onLeft p first)) (trans!{{Gluing.Point}} _ _ _ same (onLeft q second)));
\definition parameterEqual: leftParameter p = leftParameter q := Left.injective (leftPoint p) (leftPoint q) outputEqual;
\definition baseEqual: Source.first p = Source.first q := congr!{{LeftProduct.Point} {LeftBoundary.manifold.Point}} LeftProduct.first _ _ parameterEqual;
\definition plusEqual: plus p = plus q := congr!{{LeftProduct.Point} {Time.Point}} LeftProduct.second _ _ parameterEqual;
\definition minusEqual: minus p = minus q := trans!{{Time.Point}} _ _ _ (Signed.minusZero (Source.second p) first) (sym!{{Time.Point}} _ _ (Signed.minusZero (Source.second q) second));
\definition timeEqual: Source.second p = Source.second q := sameParts (Source.second p) (Source.second q) plusEqual minusEqual;
\definition law: p = q := Pair.Prop[A := LeftBoundary.manifold.Point, B := Signed.Point].ext p q baseEqual timeEqual;
