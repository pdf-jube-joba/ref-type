\definition range: LeftEmbedding.Point := \into[Gluing.Point](y, LeftEmbedding.image) \by { \bysub(Point, leftPart, y) };
\definition base: M.Point := LeftEmbedding.backward range;
\definition classValue: Gluing.inl base = (y \of Gluing.Point) := LeftEmbedding.rightInverse range;
\definition inImage: \In[M.Point] LeftImage.image base := Region.toLeft base
  (\idelim (y \of Gluing.Point) = Gluing.inl base \with p: Gluing.Point => Target.Member image p \by {
    base: \bysub(Gluing.Point, image, y), equality: sym!{{Gluing.Point}} _ _ classValue
  });
\definition fullMember: \In[M.Point] Left.image base := \block {
  \takefrom x: \Cast[LeftImage.Input] ({ x: LeftImage.Input \where LeftMaps.apply LeftMap.map x = base }) \by inImage \then
  \let regular: Left.Point := \into[LeftProduct.Point](x, Left.domain) \by { leftIncluded x (\bysub(LeftProduct.Point, leftDomain, x)) } \then
  \return Logic.existsIntro[Left.Point, { p: Left.Point \where LeftMaps.apply LeftMap.map p = base }] regular
    (\bysub(LeftImage.Input, { x: LeftImage.Input \where LeftMaps.apply LeftMap.map x = base }, x))
};
\definition collar: Left.ImagePoint := \into[M.Point](base, Left.image) \by { fullMember };
\definition input: Left.Point := Left.backward collar;
\definition small: R.Lt (Time.value (LeftProduct.second input)) epsilon := \block {
  \takefrom x: \Cast[LeftImage.Input] ({ x: LeftImage.Input \where LeftMaps.apply LeftMap.map x = base }) \by inImage \then
  \let regular: Left.Point := \into[LeftProduct.Point](x, Left.domain) \by { leftIncluded x (\bysub(LeftProduct.Point, leftDomain, x)) } \then
  \return \idelim regular = input \with p: Left.Point => R.Lt (Time.value (LeftProduct.second p)) epsilon \by {
    base: \bysub(LeftProduct.Point, leftDomain, x), equality: Left.uniquePreimage collar regular (\bysub(LeftImage.Input, { x: LeftImage.Input \where LeftMaps.apply LeftMap.map x = base }, x))
  }
};
\definition smallInput: LeftImage.Input := \into[LeftProduct.Point](input, leftDomain) \by { small };
\import \parent.\parent.LeftAt[x := smallInput] \as SignedPoint;
\definition point: Source.Point := SignedPoint.point;
\definition rightInverse: apply point = (y \of Gluing.Point) := trans!{{Gluing.Point}} _ _ _ SignedPoint.value
  (trans!{{Gluing.Point}} _ _ _ (congr!{{M.Point} {Gluing.Point}} Gluing.inl _ _ (Left.rightValue collar)) classValue);
