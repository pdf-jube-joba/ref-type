\definition Domain: \Set := Pasting.Left;
\definition source: topology.Structures[].Topology[Domain] := ImageSpace.Subspace[S := leftPart].topology topology;
\definition include: Domain -> Point := \fun (y: Domain) => y;
\definition includeContinuous: topology.Continuity[A := Domain, B := Point].Continuous source topology include :=
  topology.Continuity[A := Domain, B := Point].Corestriction[S := leftPart].inclusionContinuous topology;
\definition range[y: Domain]: LeftEmbedding.Point := \parent.OnLeft[y := y].range;
\definition rangeAmbient: topology.Continuity[A := Domain, B := Gluing.Point].Continuous source Gluing.topology (\fun (y: Domain) => range y) :=
  topology.Composition[A := Domain, B := Point, C := Gluing.Point].composeContinuous source topology Gluing.topology include (\fun (y: Point) => y) includeContinuous inclusionContinuous;
\definition rangeContinuous: topology.Continuity[A := Domain, B := LeftEmbedding.Point].Continuous source LeftEmbedding.topology range :=
  topology.Continuity[A := Domain, B := Gluing.Point].Corestriction[S := LeftEmbedding.image].corestrictContinuous source Gluing.topology range rangeAmbient;
\definition base[y: Domain]: M.Point := \parent.OnLeft[y := y].base;
\definition baseContinuous: topology.Continuity[A := Domain, B := M.Point].Continuous source M.space base :=
  topology.Composition[A := Domain, B := LeftEmbedding.Point, C := M.Point].composeContinuous source LeftEmbedding.topology M.space range LeftEmbedding.backward rangeContinuous LeftEmbedding.backwardContinuous;
\definition collar[y: Domain]: Left.ImagePoint := \parent.OnLeft[y := y].collar;
\definition collarContinuous: topology.Continuity[A := Domain, B := Left.ImagePoint].Continuous source Left.imageTopology collar :=
  topology.Continuity[A := Domain, B := M.Point].Corestriction[S := Left.image].corestrictContinuous source M.space collar baseContinuous;
\definition input[y: Domain]: Left.Point := \parent.OnLeft[y := y].input;
\definition inputContinuous: topology.Continuity[A := Domain, B := Left.Point].Continuous source Left.topology input :=
  topology.Composition[A := Domain, B := Left.ImagePoint, C := Left.Point].composeContinuous source Left.imageTopology Left.topology collar Left.backward collarContinuous Left.backwardContinuous;
\definition raw[y: Domain]: LeftProduct.Point := input y;
\definition rawContinuous: topology.Continuity[A := Domain, B := LeftProduct.Point].Continuous source LeftProduct.topology raw :=
  topology.Composition[A := Domain, B := Left.Point, C := LeftProduct.Point].composeContinuous source Left.topology LeftProduct.topology input (\fun (p: Left.Point) => p)
    inputContinuous (topology.Continuity[A := Left.Point, B := LeftProduct.Point].Corestriction[S := Left.domain].inclusionContinuous LeftProduct.topology);
\import topological_constructions.Product[A := LeftBoundary.manifold.Point, B := Time.Point] \as Product;
\definition boundary[y: Domain]: LeftBoundary.manifold.Point := LeftProduct.first (raw y);
\definition boundaryContinuous: topology.Continuity[A := Domain, B := LeftBoundary.manifold.Point].Continuous source LeftBoundary.manifold.space boundary :=
  topology.Composition[A := Domain, B := LeftProduct.Point, C := LeftBoundary.manifold.Point].composeContinuous source LeftProduct.topology LeftBoundary.manifold.space raw LeftProduct.first rawContinuous
    (Product.Maps[].firstContinuous LeftBoundary.manifold.space Time.manifold.space);
\definition time[y: Domain]: Time.Point := LeftProduct.second (raw y);
\definition timeContinuous: topology.Continuity[A := Domain, B := Time.Point].Continuous source Time.manifold.space time :=
  topology.Composition[A := Domain, B := LeftProduct.Point, C := Time.Point].composeContinuous source LeftProduct.topology Time.manifold.space raw LeftProduct.second rawContinuous
    (Product.Maps[].secondContinuous LeftBoundary.manifold.space Time.manifold.space);
\definition small[y: Domain]: Signed.SmallTimes[].Point := \into[Time.Point](time y, Signed.SmallTimes[].points) \by { \parent.OnLeft[y := y].small };
\definition smallContinuous: topology.Continuity[A := Domain, B := Signed.SmallTimes[].Point].Continuous source Signed.SmallTimes[].topology small :=
  topology.Continuity[A := Domain, B := Time.Point].Corestriction[S := Signed.SmallTimes[].points].corestrictContinuous source Time.manifold.space small timeContinuous;
\definition signed[y: Domain]: Signed.Point := Signed.SmallTimes[].positive (small y);
\definition signedContinuous: topology.Continuity[A := Domain, B := Signed.Point].Continuous source Signed.manifold.space signed :=
  topology.Composition[A := Domain, B := Signed.SmallTimes[].Point, C := Signed.Point].composeContinuous source Signed.SmallTimes[].topology Signed.manifold.space small Signed.SmallTimes[].positive smallContinuous Signed.SmallTimes[].positiveContinuous;
\definition continuous: topology.Continuity[A := Domain, B := Source.Point].Continuous source Source.topology leftBranch :=
  topological_constructions.Product[A := LeftBoundary.manifold.Point, B := Signed.Point].Universal[X := Domain].pairContinuous source LeftBoundary.manifold.space Signed.manifold.space boundary signed boundaryContinuous signedContinuous;
