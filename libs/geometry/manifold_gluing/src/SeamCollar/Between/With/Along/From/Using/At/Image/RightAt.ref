\import boundary_manifolds.SmoothMap[n := n, m := n].Between[M := RightBoundary.manifold, N := LeftBoundary.manifold] \as BackwardBoundaryMaps;
\definition time: Time.Point := RightProduct.second x;
\definition small: R.Lt (Time.value time) epsilon := \bysub(RightProduct.Point, rightDomain, x);
\definition base: LeftBoundary.manifold.Point := BackwardBoundaryMaps.apply d.backward (RightProduct.first x);
\definition point: Source.Point := Pair.pair LeftBoundary.manifold.Point Signed.Point base (Signed.negativePoint time small);
\definition member: Space.Member Negative point := Signed.nonpositiveNegative time;
\definition parameterEqual: rightParameter point = (x \of RightProduct.Point) := Pair.Prop[A := RightBoundary.manifold.Point, B := Time.Point].ext (rightParameter point) x
  ((Diffeomorphisms.laws d).rightInverse (RightProduct.first x)) (Signed.minusNegative time small);
\definition value: apply point = Gluing.inr (RightMaps.apply RightMap.map x) := trans!{{Gluing.Point}} _ _ _ (onRight point member)
  (congr!{{N.Point} {Gluing.Point}} Gluing.inr _ _ (congr!{{RightProduct.Point} N.Point} (RightMaps.apply RightMap.map) _ _ parameterEqual));
