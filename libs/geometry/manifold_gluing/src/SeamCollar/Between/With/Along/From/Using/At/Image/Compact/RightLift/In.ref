\import \parent.\parent.\parent.SmallRight[a := (p \of N.Point), member := member] \as Local;
\definition inputEqual: input p = (Local.input \of RightProduct.Point) := Inverse.inside Local.collar;
\definition time: Signed.SmallTimes[].Point := \into[Time.Point](RightProduct.second Local.input, Signed.SmallTimes[].points) \by { Local.small };
\definition liftEqual: lift Local.input = Local.point := congr!{{Signed.Point} {Source.Point}}
  (\fun (t: Signed.Point) => Pair.pair LeftBoundary.manifold.Point Signed.Point (BackwardBoundaryMaps.apply d.backward (RightProduct.first Local.input)) t) _ _ (Insert.Negative[].inside time);
\definition pointEqual: function p = Local.point := trans!{{Source.Point}} _ _ _ (congr!{{RightProduct.Point} {Source.Point}} lift _ _ inputEqual) liftEqual;
\definition value: apply (function p) = Gluing.inr p := trans!{{Gluing.Point}} _ _ _ (congr!{{Source.Point} {Gluing.Point}} apply _ _ pointEqual) Local.value;
