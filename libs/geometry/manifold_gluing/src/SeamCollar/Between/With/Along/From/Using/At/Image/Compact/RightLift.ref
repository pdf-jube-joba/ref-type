\import boundary_manifolds.SmoothMap[n := n, m := n].Between[M := RightBoundary.manifold, N := LeftBoundary.manifold] \as BackwardBoundaryMaps;
\import \parent.\parent.SmallRight[a := (x \of N.Point), member := member] \as Initial;
\import Right.InverseAt[y := Initial.collar] \as Inverse;
\import \root.SignedInsertion[].At[epsilon := epsilon, positive := positive, bounded := bounded] \as Insert;
\definition input[p: N.Point]: RightProduct.Point := Inverse.function p;
\definition lift[z: RightProduct.Point]: Source.Point := Pair.pair LeftBoundary.manifold.Point Signed.Point (boundary_manifolds.SmoothMap[n := n, m := n].Between[M := RightBoundary.manifold, N := LeftBoundary.manifold].apply d.backward (RightProduct.first z)) (Insert.Negative[].function (RightProduct.second z));
\definition function[p: N.Point]: Source.Point := lift (input p);
\import topology.Topology[Carrier := N.Point] \as InteriorSpace;
\definition W: \Pow N.Point := { p: N.Point \where \In[N.Point] RightImage.image p };
\definition openW: InteriorSpace.IsOpenIn N.space W := RightImage.open;
\module In(p: N.Point, member: InteriorSpace.Member W p);
\definition classValue: \forall (p: N.Point) -> InteriorSpace.Member W p -> apply (function p) = Gluing.inr p :=
  \fun (p: N.Point)(member: _) => In[p := p, member := member].value;
\definition sampleSmall: R.Lt (Time.value (RightProduct.second (input x))) epsilon :=
  \idelim (Initial.input \of RightProduct.Point) = input x \with z: RightProduct.Point => R.Lt (Time.value (RightProduct.second z)) epsilon \by {
    base: Initial.small, equality: sym!{{RightProduct.Point}} _ _ (Inverse.inside Initial.collar)
  };
\definition sampleTime: Signed.SmallTimes[].Point := \into[Time.Point](RightProduct.second (input x), Signed.SmallTimes[].points) \by { sampleSmall };
\import \root.LocalSmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := N, N := RightProduct.manifold].Of[function := input] \as InputLocal;
\import \root.LocalSmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := RightProduct.manifold, N := Source.manifold].Of[function := lift] \as LiftLocal;
\import \root.LocalSmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := N, N := Source.manifold].Of[function := function] \as Destination;
\import \root.SmoothWitness[n := n, m := n].Between[M := RightBoundary.manifold, N := LeftBoundary.manifold].Of[f := d.backward] \as BoundaryWitness;
\import \root.LocalSmoothMap[n := n, m := n].Between[M := RightBoundary.manifold, N := LeftBoundary.manifold].Of[function := BackwardBoundaryMaps.apply d.backward] \as BoundaryLocal;
\import \root.ProductLocalMap[n := n, m := One.dimension, p := n, q := One.dimension].Between[M := RightBoundary.manifold, N := Time.manifold, P := LeftBoundary.manifold, Q := Signed.manifold].Of[
  f := BackwardBoundaryMaps.apply d.backward, g := Insert.Negative[].function] \as ProductLocal;
\import \root.LocalSmoothCompose[n := Nat.add One.dimension n, m := Nat.add One.dimension n, l := Nat.add One.dimension n].Between[M := N, N := RightProduct.manifold, P := Source.manifold].From[f := input, g := lift] \as FinalComposition;
\definition exists: \exists Destination.Witness[x] := \block {
  \takefrom first: InputLocal.Witness[x] \by Inverse.exists \then
  \takefrom boundary: BoundaryLocal.Witness[RightProduct.first (input x)] \by BoundaryWitness.exists (RightProduct.first (input x)) \then
  \takefrom second: LiftLocal.Witness[input x] \by ProductLocal.At[x := input x, first := boundary, second := Insert.Negative[].At[t := sampleTime].witness].exists \then
  \return FinalComposition.At[x := x, chosen := first, next := second].exists
};
