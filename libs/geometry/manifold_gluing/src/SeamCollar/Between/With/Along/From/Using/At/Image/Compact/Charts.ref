\import \root.ChartTransport[n := Nat.add One.dimension n].From[M := Source.manifold].Into[A := Gluing.Point, space := Gluing.topology, U := image, open := open, h := homeomorphism] \as Transport;
\import Models.Chart[M := Gluing.Point, space := Gluing.topology] \as Charts;
\definition Index: \Set := Transport.OldChart;
\definition chart[c: Index]: Charts.Chart := Transport.In[c := c].chart;
\definition covers: \forall (y: Point) -> \exists (c: Index \where Charts.Contains (chart c) y) := Transport.covers;
\definition compatible: \forall (c, d: Index)(y: Gluing.Point)(first: Charts.Contains (chart c) y)(second: Charts.Contains (chart d) y) ->
  \exists Charts.At[x := y, left := chart c, right := chart d, inLeft := first].Extension :=
  \fun (c, d: Index)(y: Gluing.Point)(first: _)(second: _) => Transport.Pair[c := c, d := d, x := y, contains := first, otherContains := second].exists;
