\definition outputEqual: RightMaps.apply RightMap.map (rightParameter p) = RightMaps.apply RightMap.map (rightParameter q) :=
  Gluing.rightInjective _ _ (trans!{{Gluing.Point}} _ _ _ (sym!{{Gluing.Point}} _ _ (onRight p first)) (trans!{{Gluing.Point}} _ _ _ same (onRight q second)));
\definition parameterEqual: rightParameter p = rightParameter q := Right.injective (rightPoint p) (rightPoint q) outputEqual;
\definition rightBaseEqual: rightBase p = rightBase q := congr!{{RightProduct.Point} {RightBoundary.manifold.Point}} RightProduct.first _ _ parameterEqual;
\definition baseEqual: Source.first p = Source.first q := Diffeomorphisms.Of[d := d].injective (Source.first p) (Source.first q) rightBaseEqual;
\definition minusEqual: minus p = minus q := congr!{{RightProduct.Point} {Time.Point}} RightProduct.second _ _ parameterEqual;
\definition plusEqual: plus p = plus q := trans!{{Time.Point}} _ _ _ (Signed.plusZero (Source.second p) first) (sym!{{Time.Point}} _ _ (Signed.plusZero (Source.second q) second));
\definition timeEqual: Source.second p = Source.second q := sameParts (Source.second p) (Source.second q) plusEqual minusEqual;
\definition law: p = q := Pair.Prop[A := LeftBoundary.manifold.Point, B := Signed.Point].ext p q baseEqual timeEqual;
