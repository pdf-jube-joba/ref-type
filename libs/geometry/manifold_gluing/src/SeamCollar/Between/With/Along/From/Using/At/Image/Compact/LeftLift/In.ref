\import \parent.\parent.\parent.SmallLeft[a := (p \of M.Point), member := member] \as Local;
\definition inputEqual: input p = (Local.input \of LeftProduct.Point) := Inverse.inside Local.collar;
\definition time: Signed.SmallTimes[].Point := \into[Time.Point](LeftProduct.second Local.input, Signed.SmallTimes[].points) \by { Local.small };
\definition liftEqual: lift Local.input = Local.point := congr!{{Signed.Point} {Source.Point}}
  (\fun (t: Signed.Point) => Pair.pair LeftBoundary.manifold.Point Signed.Point (LeftProduct.first Local.input) t) _ _ (Insert.Positive[].inside time);
\definition pointEqual: function p = Local.point := trans!{{Source.Point}} _ _ _ (congr!{{LeftProduct.Point} {Source.Point}} lift _ _ inputEqual) liftEqual;
\definition value: apply (function p) = Gluing.inl p := trans!{{Gluing.Point}} _ _ _ (congr!{{Source.Point} {Gluing.Point}} apply _ _ pointEqual) Local.value;
