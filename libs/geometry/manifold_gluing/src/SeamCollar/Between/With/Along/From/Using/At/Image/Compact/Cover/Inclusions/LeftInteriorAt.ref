\definition initial: LeftInside.manifold.Point := LeftConverted.forward (\into[M.Point](x, LeftInterior.points) \by { interior });
\import LeftInside.InverseAt[x := initial] \as Inverse;
\definition function[p: M.Point]: Gluing.Point := Gluing.inl (Inverse.function p);
\import \root.LocalSmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := M, N := manifold].Of[function := function] \as Local;
\import \root.LocalSmoothPostcompose[n := Nat.add One.dimension n, m := Nat.add One.dimension n, l := Nat.add One.dimension n].Between[M := M, N := LeftInside.manifold, P := manifold].From[
  f := Inverse.function, g := LeftSmooth.map] \as Composition;
\definition equal: \forall (p: M.Point) -> \In[M.Point] LeftInterior.points p -> Gluing.inl p = function p :=
  \fun (p: M.Point)(member: _) => congr!{{M.Point} {Gluing.Point}} Gluing.inl _ _
    (sym!{{M.Point}} _ _ (congr!{{LeftInside.manifold.Point} {M.Point}} (\fun (z: LeftInside.manifold.Point) => z) _ _ (Inverse.inside (\into[M.Point](p, LeftInterior.points) \by { member }))));
\import \root.LocalSmoothTransfer[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := M, N := manifold].From[f := Gluing.inl, g := function] \as Transfer;
\definition exists: \exists LeftLocal.Witness[x] := \block {
  \takefrom inverse: Inverse.Witness \by Inverse.exists \then
  \takefrom composition: Local.Witness[x] \by Composition.At[x := x, chosen := inverse].exists \then
  \return Transfer.At[x := x, U := LeftInterior.points, open := Interiors.leftInteriorOpen, contains := interior, agrees := equal, chosen := composition].exists
};
