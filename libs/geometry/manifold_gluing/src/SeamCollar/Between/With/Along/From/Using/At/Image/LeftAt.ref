\definition time: Time.Point := LeftProduct.second x;
\definition small: R.Lt (Time.value time) epsilon := \bysub(LeftProduct.Point, leftDomain, x);
\definition point: Source.Point := Pair.pair LeftBoundary.manifold.Point Signed.Point (LeftProduct.first x) (Signed.positivePoint time small);
\definition member: Space.Member Positive point := Time.nonnegative time;
\definition parameterEqual: leftParameter point = (x \of LeftProduct.Point) := Pair.Prop[A := LeftBoundary.manifold.Point, B := Time.Point].ext (leftParameter point) x
  (\refl(LeftProduct.first x)) (Signed.plusPositive time small);
\definition value: apply point = Gluing.inl (LeftMaps.apply LeftMap.map x) := trans!{{Gluing.Point}} _ _ _ (onLeft point member)
  (congr!{{M.Point} {Gluing.Point}} Gluing.inl _ _ (congr!{{LeftProduct.Point} M.Point} (LeftMaps.apply LeftMap.map) _ _ parameterEqual));
