\import \parent.\parent.\parent.LeftLift[x := x, member := member] \as Lift;
\definition function[p: M.Point]: Gluing.Point := apply (Lift.function p);
\import \root.LocalSmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := M, N := manifold].Of[function := function] \as Local;
\import \root.LocalSmoothPostcompose[n := Nat.add One.dimension n, m := Nat.add One.dimension n, l := Nat.add One.dimension n].Between[M := M, N := Source.manifold, P := manifold].From[
  f := Lift.function, g := SeamSmooth.map] \as Composition;
\definition equal: \forall (p: M.Point) -> \In[M.Point] LeftImage.image p -> Gluing.inl p = function p :=
  \fun (p: M.Point)(member: _) => sym!{{Gluing.Point}} _ _ (Lift.classValue p member);
\import \root.LocalSmoothTransfer[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := M, N := manifold].From[f := Gluing.inl, g := function] \as Transfer;
\import \root.LocalSmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := M, N := Source.manifold].Of[function := Lift.function] \as LiftLocal;
\definition exists: \exists LeftLocal.Witness[x] := \block {
  \takefrom lift: LiftLocal.Witness[x] \by Lift.exists \then
  \takefrom composition: Local.Witness[x] \by Composition.At[x := x, chosen := lift].exists \then
  \return Transfer.At[x := x, U := LeftImage.image, open := LeftImage.open, contains := member, agrees := equal, chosen := composition].exists
};
