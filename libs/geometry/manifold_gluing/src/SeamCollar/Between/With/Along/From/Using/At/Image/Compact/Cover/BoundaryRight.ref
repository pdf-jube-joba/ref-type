\import boundary_manifolds.SmoothMap[n := n, m := n].Between[M := RightBoundary.manifold, N := LeftBoundary.manifold] \as BackwardMaps;
\definition intrinsic: RightAtlas.Point := \into[N.Point](a, RightAtlas.points) \by { boundary };
\definition b: RightBoundary.manifold.Point := \into[RightAtlas.Point](intrinsic, topology.Topology[Carrier := RightAtlas.Point].Whole) \by { \refl(intrinsic) };
\definition base: LeftBoundary.manifold.Point := BackwardMaps.apply d.backward b;
\definition point: Source.Point := Pair.pair LeftBoundary.manifold.Point Signed.Point base Signed.zero;
\definition value: apply point = Gluing.inr a := trans!{{Gluing.Point}} _ _ _ (onRight point (R.leRefl S.zero))
  (trans!{{Gluing.Point}} _ _ _ (Initial.rightInitial point Signed.minusAtZero)
    (congr!{{N.Point} {Gluing.Point}} Gluing.inr _ _ (congr!{{RightBoundary.manifold.Point} N.Point} RightBoundary.apply _ _ ((Diffeomorphisms.laws d).rightInverse b))));
\definition member: Target.Member image (Gluing.inr a) := \idelim apply point = Gluing.inr a \with y: Gluing.Point => Target.Member image y \by {
  base: included point, equality: value
};
