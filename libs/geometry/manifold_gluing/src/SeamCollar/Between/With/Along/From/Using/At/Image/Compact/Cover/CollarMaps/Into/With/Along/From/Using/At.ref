\import \root.SeamCollar[n := k].Between[M := P, N := Q].With[leftCover := pCover, rightCover := qCover].Along[d := e].From[
  left := p, right := q].Using[leftRegular := pRegular, rightRegular := qRegular].At[
  epsilon := epsilon, positive := positive, bounded := bounded, leftWithin := pWithin, rightWithin := qWithin] \as TargetCollar;
\import \root.BoundarySeam[n := k].Between[M := P, N := Q].With[leftCover := pCover, rightCover := qCover].Along[d := e] \as TargetSeam;
\import boundary_manifolds.Product[n := k, m := One.dimension].Of[M := PInclusion.manifold, N := Time.manifold] \as PProduct;
\import boundary_manifolds.Product[n := k, m := One.dimension].Of[M := QInclusion.manifold, N := Time.manifold] \as QProduct;
\import boundary_manifolds.Product[n := k, m := One.dimension].Of[M := PInclusion.manifold, N := Signed.manifold] \as TargetProduct;
\import \root.CollarEmbedding[n := k].On[M := P].With[cover := pCover].From[deformation := p] \as PMap;
\import \root.CollarEmbedding[n := k].On[M := Q].With[cover := qCover].From[deformation := q] \as QMap;
\import boundary_manifolds.SmoothMap[n := Nat.add One.dimension k, m := Nat.add One.dimension k].Between[M := PProduct.manifold, N := P] \as PMaps;
\import boundary_manifolds.SmoothMap[n := Nat.add One.dimension k, m := Nat.add One.dimension k].Between[M := QProduct.manifold, N := Q] \as QMaps;
\import boundary_manifolds.SmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension k].Between[M := M, N := P] \as SideLeftMaps;
\import boundary_manifolds.SmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension k].Between[M := N, N := Q] \as SideRightMaps;
\import boundary_manifolds.SmoothMap[n := n, m := k].Between[M := LeftBoundary.manifold, N := PInclusion.manifold] \as BaseMaps;
\module Compact(pCompact: topology.Topology[Carrier := P.Point].IsCompact P.space, qCompact: topology.Topology[Carrier := Q.Point].IsCompact Q.space);
