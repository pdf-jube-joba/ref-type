\definition sideEqual: leftValue p = rightValue q := trans!{{Gluing.Point}} _ _ _ (sym!{{Gluing.Point}} _ _ (onLeft p first)) (trans!{{Gluing.Point}} _ _ _ same (onRight q second));
\module Using(b: LeftBoundary.manifold.Point, endpoints: Logic.And[LeftMaps.apply LeftMap.map (leftParameter p) = LeftBoundary.apply b,
  RightMaps.apply RightMap.map (rightParameter q) = RightBoundary.apply (BoundaryMaps.apply d.forward b)]);
\definition law: p = q := \block {
  \takefrom b: \Cast[LeftBoundary.manifold.Point] ({ b: LeftBoundary.manifold.Point \where Logic.And[
    LeftMaps.apply LeftMap.map (leftParameter p) = LeftBoundary.apply b, RightMaps.apply RightMap.map (rightParameter q) = RightBoundary.apply (BoundaryMaps.apply d.forward b)] })
    \by (Gluing.crossCriterion (LeftMaps.apply LeftMap.map (leftParameter p)) (RightMaps.apply RightMap.map (rightParameter q))).ltr sideEqual \then
  \return Using[b := b, endpoints := \bysub(LeftBoundary.manifold.Point, { b: LeftBoundary.manifold.Point \where Logic.And[
    LeftMaps.apply LeftMap.map (leftParameter p) = LeftBoundary.apply b, RightMaps.apply RightMap.map (rightParameter q) = RightBoundary.apply (BoundaryMaps.apply d.forward b)] }, b)].law
};
