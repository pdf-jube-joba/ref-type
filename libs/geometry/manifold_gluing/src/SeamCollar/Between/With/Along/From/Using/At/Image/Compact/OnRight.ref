\definition range: RightEmbedding.Point := \into[Gluing.Point](y, RightEmbedding.image) \by { \bysub(Point, rightPart, y) };
\definition base: N.Point := RightEmbedding.backward range;
\definition classValue: Gluing.inr base = (y \of Gluing.Point) := RightEmbedding.rightInverse range;
\definition inImage: \In[N.Point] RightImage.image base := Region.toRight base
  (\idelim (y \of Gluing.Point) = Gluing.inr base \with p: Gluing.Point => Target.Member image p \by {
    base: \bysub(Gluing.Point, image, y), equality: sym!{{Gluing.Point}} _ _ classValue
  });
\definition fullMember: \In[N.Point] Right.image base := \block {
  \takefrom x: \Cast[RightImage.Input] ({ x: RightImage.Input \where RightMaps.apply RightMap.map x = base }) \by inImage \then
  \let regular: Right.Point := \into[RightProduct.Point](x, Right.domain) \by { rightIncluded x (\bysub(RightProduct.Point, rightDomain, x)) } \then
  \return Logic.existsIntro[Right.Point, { p: Right.Point \where RightMaps.apply RightMap.map p = base }] regular
    (\bysub(RightImage.Input, { x: RightImage.Input \where RightMaps.apply RightMap.map x = base }, x))
};
\definition collar: Right.ImagePoint := \into[N.Point](base, Right.image) \by { fullMember };
\definition input: Right.Point := Right.backward collar;
\definition small: R.Lt (Time.value (RightProduct.second input)) epsilon := \block {
  \takefrom x: \Cast[RightImage.Input] ({ x: RightImage.Input \where RightMaps.apply RightMap.map x = base }) \by inImage \then
  \let regular: Right.Point := \into[RightProduct.Point](x, Right.domain) \by { rightIncluded x (\bysub(RightProduct.Point, rightDomain, x)) } \then
  \return \idelim regular = input \with p: Right.Point => R.Lt (Time.value (RightProduct.second p)) epsilon \by {
    base: \bysub(RightProduct.Point, rightDomain, x), equality: Right.uniquePreimage collar regular (\bysub(RightImage.Input, { x: RightImage.Input \where RightMaps.apply RightMap.map x = base }, x))
  }
};
\definition smallInput: RightImage.Input := \into[RightProduct.Point](input, rightDomain) \by { small };
\import \parent.\parent.RightAt[x := smallInput] \as SignedPoint;
\definition point: Source.Point := SignedPoint.point;
\definition rightInverse: apply point = (y \of Gluing.Point) := trans!{{Gluing.Point}} _ _ _ SignedPoint.value
  (trans!{{Gluing.Point}} _ _ _ (congr!{{N.Point} {Gluing.Point}} Gluing.inr _ _ (Right.rightValue collar)) classValue);
