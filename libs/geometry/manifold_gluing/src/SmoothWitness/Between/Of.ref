\import \root.LocalSmoothMap[n := n, m := m].Between[M := M, N := N].Of[function := Maps.apply f] \as Local;
\import Sources.Chart[M := M.Point, space := M.space] \as SourceCharts;
\import Targets.Chart[M := N.Point, space := N.space] \as TargetCharts;
\module At(x: M.Point, left: Local.SourceChart x, right: Local.TargetChart (Maps.apply f x));
\definition exists: \forall (x: M.Point) -> \exists Local.Witness[x] := \block {
  \fun (x: M.Point) \then
  \takefrom left: Local.SourceChart x \by M.atlas.covers x \then
  \takefrom right: Local.TargetChart (Maps.apply f x) \by N.atlas.covers (Maps.apply f x) \then
  \return At[x := x, left := left, right := right].exists
};
