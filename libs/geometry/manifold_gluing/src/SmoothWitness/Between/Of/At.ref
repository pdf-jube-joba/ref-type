\import Maps.At[function := Maps.apply f, left := left, right := right, x := x, contains := Local.leftContains x left] \as At;
\definition exists: \exists Local.Witness[x] := \block {
  \takefrom extension: At.Extension \by f.smooth left right x (Local.leftContains x left) (Local.leftMember x left) (Local.rightMember (Maps.apply f x) right) (Local.rightContains (Maps.apply f x) right) \then
  \return \exact(Local.Witness[x] { left := left, right := right, extension := extension }, Local.Witness[x])
};
