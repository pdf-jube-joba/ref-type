\import \parent.ActiveRegion[] \as Region;
\import \root.TransverseHomotopy[n := Nat.add One.dimension n].On[M := M] \as Transverse;
\import Functions.LocalBump[a := a, q := q] \as Bump;
\import topological_algebra.Euclidean[].Dimension[n := dimension].Norm[] \as Norm;
\module At(p: Charts.LocalPoint c, near: \In[Charts.LocalPoint c] Region.local p);
\definition strict: \forall (x: M.Point) -> \In[M.Point] BoundaryAtlas.points x -> \In[M.Point] Region.domain x -> Transverse.StrictAt homotopy x :=
  \fun (x: M.Point)(boundary: _)(member: _) => topology.Topology[Carrier := M.Point].Subspace[S := c.domain].Open[].imageElim Region.local x (Transverse.StrictAt homotopy x)
    (\fun (p: Charts.LocalPoint c)(near: _)(same: p = x) => \idelim (p \of M.Point) = x \with y: M.Point => \In[M.Point] BoundaryAtlas.points y -> Transverse.StrictAt homotopy y \by {
      base: At[p := p, near := near].strict, equality: same
    } boundary) member;
\definition patch: Transverse.Patch := Transverse.Patch { patch := Region.patch, strict := strict };
\definition centerContains: \In[M.Point] patch.patch.domain (Charts.point c a) := Region.centerContains;
