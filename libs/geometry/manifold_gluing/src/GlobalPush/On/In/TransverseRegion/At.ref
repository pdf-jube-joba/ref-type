\import \parent.\parent.Jet[x := p] \as Jet;
\import \parent.\parent.Velocity[x := p] \as Velocity;
\definition bumpOne: Polynomial.bump (input Jet.zeroPoint) = S.one := trans!{S.Real} _ _ _
  (congr!{Model.Point S.Real} Bump.value _ _ (spatialFormula Jet.zeroPoint))
  (Bump.oneNear (Charts.coordinate c p) (R.ltReplaceLeft _ _ q (Norm.distanceSymmetric a (Charts.coordinate c p)) near));
\definition positive: R.Lt S.zero (Polynomial.bump (input Jet.zeroPoint)) := R.ltReplaceRight S.zero S.one (Polynomial.bump (input Jet.zeroPoint))
  (sym!{S.Real} _ _ bumpOne) S.Estimates[].Product[].onePositive;
\definition strict: \In[M.Point] BoundaryAtlas.points p -> Transverse.StrictAt homotopy p := \fun (boundary: _) => Velocity.strict boundary positive;
