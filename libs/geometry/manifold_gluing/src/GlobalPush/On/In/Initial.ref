\definition local: \forall (z: LocalPoint) -> Time.value (Product.second z) = S.zero -> partial z = Product.first z :=
  \fun (z: LocalPoint)(zero: _) => trans!{M.Point} _ _ _
    (congr!{{Model.Carrier c.constraints c.image} M.Point} (\fun (u: Model.Carrier c.constraints c.image) => Charts.point c u) (imagePoint z) (spatial z)
      (Model.equality c.constraints c.image (imagePoint z) (spatial z)
        (trans!{Model.Point} _ _ _ (Polynomial.atZero (input z) (trans!{S.Real} _ _ _ (timeFormula z) zero)) (spatialFormula z))))
    (Charts.pointCoordinate c (spatialPoint z));
\definition atZero: \forall (z: Product.Point) -> Time.value (Product.second z) = S.zero -> apply z = Product.first z :=
  \fun (z: Product.Point)(zero: _) => Logic.orElim (\In[Product.Point] localDomain z) (Logic.Not (\In[Product.Point] localDomain z)) (apply z = Product.first z)
    (Classical.excludedMiddle (\In[Product.Point] localDomain z))
    (\fun (member: _) => trans!{M.Point} _ _ _ (inside (\into[Product.Point](z, localDomain) \by { member }))
      (local (\into[Product.Point](z, localDomain) \by { member }) zero))
    (outside z);
\definition initial: \forall (x: M.Point) -> apply (Pair.pair M.Point Time.Point x Time.zero) = x :=
  \fun (x: M.Point) => atZero (Pair.pair M.Point Time.Point x Time.zero) (\refl(S.zero));
