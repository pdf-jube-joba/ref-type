\definition local: Charts.LocalPoint c := \into[M.Point](x, c.domain) \by { contains };
\definition a: Model.Carrier c.constraints c.image := Charts.coordinate c local;
\definition pointEquals: Charts.point c a = (x \of M.Point) := Charts.pointCoordinate c local;
\module With(r: S.Real, ball: Open.BallInside[c.image.points, a, r]);
\definition exists: \exists Centered[x] := \block {
  \takefrom r: \Cast[S.Real] ({ r: S.Real \where Open.BallInside[c.image.points, a, r] }) \by c.image.open a (\bysub(Model.Point, c.image.points, a)) \then
  \return \exact(With[r := r, ball := \bysub(S.Real, { r: S.Real \where Open.BallInside[c.image.points, a, r] }, r)].centered, Centered[x])
};
\definition localExists: \exists ( p: Homotopies.Patch \where \In[M.Point] p.domain x ) := \block {
  \takefrom r: \Cast[S.Real] ({ r: S.Real \where Open.BallInside[c.image.points, a, r] }) \by c.image.open a (\bysub(Model.Point, c.image.points, a)) \then
  \return With[r := r, ball := \bysub(S.Real, { r: S.Real \where Open.BallInside[c.image.points, a, r] }, r)].local
};
\definition transverseExists: \exists ( p: Transverse.Patch \where \In[M.Point] p.patch.domain x ) := \block {
  \takefrom r: \Cast[S.Real] ({ r: S.Real \where Open.BallInside[c.image.points, a, r] }) \by c.image.open a (\bysub(Model.Point, c.image.points, a)) \then
  \return With[r := r, ball := \bysub(S.Real, { r: S.Real \where Open.BallInside[c.image.points, a, r] }, r)].transverseLocal
};
