\import std.Data[].Nat[].Basic[].Def[] \as Nat;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import S.Distance[] \as Metric;
\import S.Estimates[] \as Estimates;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import calculus.Real[].OneDimension[] \as One;
\definition dimension: std.Data[].Nat[].Nat^ := Nat.add One.dimension n;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Open;
\import calculus.Real[].Multivariable[n := One.dimension].Open[] \as TimeOpen;
\import calculus.Maps[n := dimension, m := dimension] \as Maps;
\import calculus.Blocks[n := n, m := One.dimension] \as Blocks;
\import inverse_implicit.Product[n := n, m := One.dimension] \as Linear;
\import \root.NormalCoordinate[n := n] \as Normal;
\import topological_algebra.Euclidean[].Dimension[n := dimension].Def[] \as Coordinates;
\import topological_algebra.Euclidean[].Dimension[n := dimension].Topology[] \as Ambient;
\import topological_algebra.Euclidean[].Dimension[n := One.dimension].Def[] \as TimeCoordinates;
\import topological_algebra.Euclidean[].Dimension[n := One.dimension].Norm[] \as TimeNorm;
\definition Point: \Set := Fin.Fin dimension -> S.Real;
\definition LeftPoint: \Set := Fin.Fin n -> S.Real;
\definition TimePoint: \Set := One.Index -> S.Real;
\definition normal: Fin.Fin dimension := Normal.normal;
\module On(U: Open.OpenSet, f: Maps.Map U Open.whole, a: Open.Carrier U, zeroNormal: a normal = S.zero, fixed: \root.HalfSpaceJet[n := n].BoundaryFixed U f);
