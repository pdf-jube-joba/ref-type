\definition equal: union n f = Space.Union F := \axiom:setext(union n f, Space.Union F,
  (\block {
    \fun (x: A)(member: Space.Member (union n f) x) \then
    \takefrom i: \Cast[Fin.Fin n] ({ i: Fin.Fin n \where Space.Member (basis (f i)) x }) \by member \then
    \return Space.unionMemberOf F (sets i) x (membership i)
      (\idelim basis (f i) = sets i \with U: \Pow A => Space.Member U x \by {
        base: \bysub(Fin.Fin n, { i: Fin.Fin n \where Space.Member (basis (f i)) x }, i), equality: agrees i
      })
  }),
  (\fun (x: A)(member: Space.Member (Space.Union F) x) => Space.unionMemberElim F x (Space.Member (union n f) x) (\block {
    \fun (U: \Pow A)(inF: Space.FamilyMember F U)(inU: Space.Member U x) \then
    \takefrom i: \Cast[Fin.Fin n] ({ i: Fin.Fin n \where sets i = U }) \by ListIndex.occurrenceIndex U xs (enumeration.exhaustive U inF) \then
    \return Logic.existsIntro[Fin.Fin n, { i: Fin.Fin n \where Space.Member (basis (f i)) x }] i
      (\idelim U = basis (f i) \with V: \Pow A => Space.Member V x \by {
        base: inU, equality: sym!{{\Pow A}} _ _ (trans!{{\Pow A}} _ _ _ (agrees i) (\bysub(Fin.Fin n, { i: Fin.Fin n \where sets i = U }, i)))
      })
  }) member));
\definition exists: \exists (k: N.Nat^ \where sequence k = Space.Union F) := \block {
  \takefrom code: \Cast[N.Nat^] ({ code: N.Nat^ \where Powers.sequence naturals n code = f }) \by Powers.exhaustive naturals n f \then
  \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Pairs.enumerate k = Pair.natPair n code }) \by Pairs.exhaustive n code \then
  \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where sequence k = Space.Union F }] k
    (\idelim Pair.natPair n code = Pairs.enumerate k \with p: Pair.NatPair =>
      union (Pair.natPairFirst p) (Powers.sequence naturals (Pair.natPairFirst p) (Pair.natPairSecond p)) = Space.Union F \by {
        base: trans!{{\Pow A}} _ _ _ (congr!{{Fin.Fin n -> N.Nat^} {\Pow A}} (union n) _ _ (\bysub(N.Nat^, { code: N.Nat^ \where Powers.sequence naturals n code = f }, code))) equal,
        equality: sym!{Pair.NatPair} _ _ (\bysub(N.Nat^, { k: N.Nat^ \where Pairs.enumerate k = Pair.natPair n code }, k))
      })
};
