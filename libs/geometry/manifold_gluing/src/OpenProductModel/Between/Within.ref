\import \root.OpenManifold[n := n].On[M := M].Within[U := U, open := openU] \as Left;
\import \root.OpenManifold[n := m].On[M := N].Within[U := V, open := openV] \as Right;
\import boundary_manifolds.Product[n := n, m := m].Of[M := Left.manifold, N := Right.manifold] \as Source;
\import boundary_manifolds.Product[n := n, m := m].Of[M := M, N := N] \as Target;
\definition map: boundary_manifolds.SmoothMap[n := Nat.add m n, m := Nat.add m n].Between[M := Source.manifold, N := Target.manifold].Map :=
  \root.MapProduct[n := n, m := m, p := n, q := m].Between[M := Left.manifold, N := Right.manifold, P := M, Q := N].Of[f := Left.Inclusion[].map, g := Right.Inclusion[].map].map;
\definition include[x: Source.Point]: Target.Point := Pair.pair M.Point N.Point (Source.first x) (Source.second x);
\definition leftIdentity: topology.Homeomorphism[A := Left.Point, B := Left.Point].Homeomorphism[Left.topology, Left.topology] := topology.Homeomorphism[A := Left.Point, B := Left.Point].Homeomorphism[Left.topology, Left.topology] {
  forward := \fun (x: Left.Point) => x, backward := \fun (x: Left.Point) => x,
  leftInverse := \fun (x: Left.Point) => \refl(x), rightInverse := \fun (x: Left.Point) => \refl(x),
  forwardContinuous := topology.Maps[A := Left.Point, B := Left.Point].Identity[].continuous Left.topology,
  backwardContinuous := topology.Maps[A := Left.Point, B := Left.Point].Identity[].continuous Left.topology,
};
\definition rightIdentity: topology.Homeomorphism[A := Right.Point, B := Right.Point].Homeomorphism[Right.topology, Right.topology] := topology.Homeomorphism[A := Right.Point, B := Right.Point].Homeomorphism[Right.topology, Right.topology] {
  forward := \fun (x: Right.Point) => x, backward := \fun (x: Right.Point) => x,
  leftInverse := \fun (x: Right.Point) => \refl(x), rightInverse := \fun (x: Right.Point) => \refl(x),
  forwardContinuous := topology.Maps[A := Right.Point, B := Right.Point].Identity[].continuous Right.topology,
  backwardContinuous := topology.Maps[A := Right.Point, B := Right.Point].Identity[].continuous Right.topology,
};
\import \root.OpenProduct[A := M.Point, B := N.Point, X := Left.Point, Y := Right.Point].On[left := M.space, right := N.space, first := Left.topology, second := Right.topology].Within[U := U, V := V, openU := openU, openV := openV] \as Open;
\import Open.Through[h := leftIdentity, k := rightIdentity] \as Image;
\module InverseAt(x: Source.Point);
