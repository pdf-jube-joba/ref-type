\import Left.Inclusion[].InverseAt[x := Source.first x] \as FirstInverse;
\import Right.Inclusion[].InverseAt[x := Source.second x] \as SecondInverse;
\import \root.ProductLocalMap[n := n, m := m, p := n, q := m].Between[M := M, N := N, P := Left.manifold, Q := Right.manifold].Of[f := FirstInverse.function, g := SecondInverse.function] \as ProductLocal;
\definition function[p: Target.Point]: Source.Point := ProductLocal.function p;
\definition inside: \forall (p: Source.Point) -> function (include p) = p := \fun (p: Source.Point) => Pair.Prop[A := Left.Point, B := Right.Point].ext (function (include p)) p (FirstInverse.inside (Source.first p)) (SecondInverse.inside (Source.second p));
\import \root.LocalSmoothMap[n := Nat.add m n, m := Nat.add m n].Between[M := Target.manifold, N := Source.manifold].Of[function := function] \as Local;
\definition exists: \exists Local.Witness[include x] := \block {
  \takefrom first: FirstInverse.Witness \by FirstInverse.exists \then
  \takefrom second: SecondInverse.Witness \by SecondInverse.exists \then
  \return ProductLocal.At[x := include x, first := first, second := second].exists
};
