\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import boundary_manifolds.Dimension[n := n] \as Models;
\module On(M: Models.Manifold, A: \Set, space: topology.Structures[].Topology[A], f: M.Point -> A,
  compact: topology.Topology[Carrier := M.Point].IsCompact M.space, hausdorff: topology.Topology[Carrier := A].IsT2 space,
  continuous: topology.Continuity[A := M.Point, B := A].Continuous M.space space f, injective: \forall (x, y: M.Point) -> f x = f y -> x = y);
