\module Singleton(x: A);
\definition t1: Target.IsT1 target := \block {
  \fun (y: B) \then
  \takefrom x: \Cast[A] ({ x: A \where q x = y }) \by onto y \then
  \return \idelim q x = y \with z: B => Target.IsClosedIn target (Target.Singleton z) \by {
    base: Singleton[x := x].closed, equality: \bysub(A, { x: A \where q x = y }, x)
  }
};
\definition fibre[y: B]: \Pow A := Continuous.Preimage q (Target.Singleton y);
\definition fibreClosed: \forall (y: B) -> Source.IsClosedIn source (fibre y) :=
  \fun (y: B) => Continuous.closedPreimage source target q continuous (Target.Singleton y) (t1 y);
\definition normal: Source.IsNormal source := Source.Compactness[].compactHausdorffNormal source compact hausdorff;
\module Down(U: \Pow A, open: Source.IsOpenIn source U);
\module At(x, y: B, different: Logic.Not (x = y));
\definition separated: Target.IsT2 target := \fun (x, y: B)(different: _) => At[x := x, y := y, different := different].exists;
\module SecondCountable;
