\import \root.ClosedSurjection[A := A, B := B].On[source := source, target := target, q := q, continuous := continuous, onto := onto, compact := compact, hausdorff := hausdorff, closed := closed] \as Mapping;
\module WithBasis(basis: N.Nat^ -> \Pow A, laws: Source.IsCountableBasis[source, basis]);
\definition exists: Source.IsSecondCountable source -> Target.IsSecondCountable target := \block {
  \fun (countable: Source.IsSecondCountable source) \then
  \takefrom basis: \Cast[N.Nat^ -> \Pow A] ({ basis: N.Nat^ -> \Pow A \where Source.IsCountableBasis[source, basis] }) \by countable \then
  \return WithBasis[basis := basis, laws := \bysub(N.Nat^ -> \Pow A, { basis: N.Nat^ -> \Pow A \where Source.IsCountableBasis[source, basis] }, basis)].countable
};
