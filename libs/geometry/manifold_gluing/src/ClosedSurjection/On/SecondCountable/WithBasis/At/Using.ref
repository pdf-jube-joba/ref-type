\definition included: topology.Topology[Carrier := \Pow A].Subset finite Unions.indexed :=
  \fun (U: \Pow A)(member: Source.FamilyMember finite U) => familyIncluded U (selected.included U member);
\module With(k: N.Nat^, equal: Unions.sequence k = Source.Union finite);
\definition exists: \exists (k: N.Nat^ \where Logic.And[Target.Member (targetBasis k) y, Target.Subset (targetBasis k) V]) := \block {
  \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Unions.sequence k = Source.Union finite }) \by Unions.exhaustive finite included \then
  \return With[k := k, equal := \bysub(N.Nat^, { k: N.Nat^ \where Unions.sequence k = Source.Union finite }, k)].exists
};
