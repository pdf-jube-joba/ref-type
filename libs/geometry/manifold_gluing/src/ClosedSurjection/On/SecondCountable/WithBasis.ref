\import \root.FiniteBasisUnions[A := A].On[topology := source, basis := basis, laws := laws] \as Unions;
\definition targetBasis[k: N.Nat^]: \Pow B := Mapping.Down[U := Unions.sequence k, open := Unions.open k].points;
\definition open: \forall (k: N.Nat^) -> Target.IsOpenIn target (targetBasis k) := \fun (k: N.Nat^) => Mapping.Down[U := Unions.sequence k, open := Unions.open k].open;
\module At(V: \Pow B, openV: Target.IsOpenIn target V, y: B, member: Target.Member V y);
\definition refines: \forall (V: \Pow B) -> Target.IsOpenIn target V -> \forall (y: B) -> Target.Member V y ->
  \exists (k: N.Nat^ \where Logic.And[Target.Member (targetBasis k) y, Target.Subset (targetBasis k) V]) :=
  \fun (V: \Pow B)(openV: _)(y: B)(member: _) => At[V := V, openV := openV, y := y, member := member].exists;
\definition countable: Target.IsSecondCountable target := Logic.existsIntro[N.Nat^ -> \Pow B, { b: N.Nat^ -> \Pow B \where Target.IsCountableBasis[target, b] }] targetBasis
  (Target.IsCountableBasis[target, targetBasis] { open := open, refines := refines });
