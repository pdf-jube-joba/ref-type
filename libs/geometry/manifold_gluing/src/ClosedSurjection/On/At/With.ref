\import \parent.\parent.Down[U := U, open := choice.open] \as Left;
\module Using(V: \Pow A, partner: Source.NormalPartner[source, fibre y, U, V]);
\definition exists: \exists (U: \Pow B \where Target.RegularChoice[target, Target.Singleton y, x, U]) := \block {
  \takefrom V: \Cast[\Pow A] ({ V: \Pow A \where Source.NormalPartner[source, fibre y, U, V] }) \by choice.partner \then
  \return Using[V := V, partner := \bysub(\Pow A, { V: \Pow A \where Source.NormalPartner[source, fibre y, U, V] }, V)].exists
};
