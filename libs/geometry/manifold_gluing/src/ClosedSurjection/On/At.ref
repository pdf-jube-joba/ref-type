\definition disjoint: Source.Disjoint (fibre x) (fibre y) := \fun (p: A)(first: q p = x)(second: q p = y) => different (trans!{B} _ _ _ (sym!{B} _ _ first) second);
\module With(U: \Pow A, choice: Source.NormalChoice[source, fibre x, fibre y, U]);
\definition exists: \exists (U: \Pow B \where Target.RegularChoice[target, Target.Singleton y, x, U]) := \block {
  \takefrom U: \Cast[\Pow A] ({ U: \Pow A \where Source.NormalChoice[source, fibre x, fibre y, U] })
    \by normal (fibre x) (fibre y) (fibreClosed x) (fibreClosed y) disjoint \then
  \return With[U := U, choice := \bysub(\Pow A, { U: \Pow A \where Source.NormalChoice[source, fibre x, fibre y, U] }, U)].exists
};
