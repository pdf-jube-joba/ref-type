\definition image: \Pow B := Maps.Image q (Source.Complement U);
\definition points: \Pow B := Target.Complement image;
\definition open: Target.IsOpenIn target points := closed (Source.Complement U) (Source.Finite[].openComplementClosed source U open);
\definition contains: \forall (y: B) -> Source.Subset (fibre y) U -> Target.Member points y :=
  \fun (y: B)(covers: Source.Subset (fibre y) U)(member: Target.Member image y) => Maps.imageElim q (Source.Complement U) y Logic.False
    (\fun (p: A)(outside: Logic.Not (Source.Member U p))(same: q p = y) => outside (covers p same)) member;
\definition within: \forall (p: A) -> Target.Member points (q p) -> Source.Member U p :=
  \fun (p: A)(member: Target.Member points (q p)) => Logic.orElim (Source.Member U p) (Logic.Not (Source.Member U p)) (Source.Member U p)
    (Classical.excludedMiddle (Source.Member U p)) (\fun (inside: _) => inside)
    (\fun (outside: _) => Logic.falseElim (Source.Member U p) (member (Maps.imageMember q (Source.Complement U) p outside)));
