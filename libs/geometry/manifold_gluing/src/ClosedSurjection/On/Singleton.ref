\definition equal: Maps.Image q (Source.Singleton x) = Target.Singleton (q x) := \axiom:setext(Maps.Image q (Source.Singleton x), Target.Singleton (q x),
  \fun (y: B)(member: Target.Member (Maps.Image q (Source.Singleton x)) y) => Maps.imageElim q (Source.Singleton x) y (y = q x)
    (\fun (p: A)(same: p = x)(value: q p = y) => trans!{B} _ _ _ (sym!{B} _ _ value) (congr!{A B} q _ _ same)) member,
  \fun (y: B)(same: y = q x) => Logic.existsIntro[A, { p: A \where Logic.And[p = x, q p = y] }] x (Logic.And[_, _]::# (\refl(x)) (sym!{B} _ _ same)));
\definition closed: Target.IsClosedIn target (Target.Singleton (q x)) := \idelim Maps.Image q (Source.Singleton x) = Target.Singleton (q x)
  \with F: \Pow B => Target.IsClosedIn target F \by {
    base: closed (Source.Singleton x) (Source.Compactness[].hausdorffT1 source hausdorff x), equality: equal
  };
