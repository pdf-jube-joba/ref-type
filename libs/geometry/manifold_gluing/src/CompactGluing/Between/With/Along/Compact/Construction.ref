\import Collars.From[left := c.left, right := c.right].Using[leftRegular := c.leftRegular, rightRegular := c.rightRegular].At[
  epsilon := c.parameters.epsilon, positive := c.parameters.positive, bounded := c.parameters.bounded,
  leftWithin := c.parameters.leftWithin, rightWithin := c.parameters.rightWithin] \as Stage;
\import Stage.Image[].Compact[leftCompact := leftCompact, rightCompact := rightCompact].Cover[] \as Glued;
\definition atlas: Atlases.Atlas := Glued.manifold.atlas;
\import \root.SignedParameter[].At[epsilon := c.parameters.epsilon, positive := c.parameters.positive, bounded := c.parameters.bounded] \as Signed;
\import boundary_manifolds.Product[n := n, m := One.dimension].Of[M := LeftBoundary.manifold, N := Signed.manifold] \as Source;
\definition seamManifold: Models.Manifold := Source.manifold;
\definition SeamPoint: \Set := Source.Point;
\definition seamFunction[x: Source.Point]: Point := Stage.apply x;
\definition left: boundary_manifolds.SmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := M, N := ofAtlas atlas].Map := Glued.Inclusions[].left;
\definition right: boundary_manifolds.SmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := N, N := ofAtlas atlas].Map := Glued.Inclusions[].right;
\definition seam: boundary_manifolds.SmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := seamManifold, N := ofAtlas atlas].Map := Glued.Inclusions[].seam;
\definition noBoundary: \forall (x: Point) -> Logic.Not boundary_manifolds.Tangent[n := Nat.add One.dimension n].On[M := ofAtlas atlas].At[x := x].Cones[].Boundary := Glued.Interior[].noBoundary;

\definition SeamMap[other: Atlases.Atlas]: \Set := boundary_manifolds.SmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := seamManifold, N := ofAtlas other].Map;
\definition seamApply[other: Atlases.Atlas][f: SeamMap other][x: SeamPoint]: Point := boundary_manifolds.SmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := seamManifold, N := ofAtlas other].apply f x;
