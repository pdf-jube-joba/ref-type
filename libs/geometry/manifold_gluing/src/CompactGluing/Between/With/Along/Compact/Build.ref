\import Collars.From[left := c.left, right := c.right].Using[leftRegular := c.leftRegular, rightRegular := c.rightRegular].At[
  epsilon := c.parameters.epsilon, positive := c.parameters.positive, bounded := c.parameters.bounded,
  leftWithin := c.parameters.leftWithin, rightWithin := c.parameters.rightWithin].Image[].Compact[leftCompact := leftCompact, rightCompact := rightCompact].Cover[] \as Glued;
\definition result: Result := Result { atlas := Glued.manifold.atlas, noBoundary := Glued.Interior[].noBoundary };
