\import \parent.Construction[c := c] \as Constructed;
\definition result: Result := Result {
  collars := c, atlas := Constructed.atlas, atlasConstructed := \refl(Constructed.atlas),
  left := Constructed.left, right := Constructed.right, seam := Constructed.seam,
  leftValue := \fun (x: M.Point) => \refl(Seam.inl x),
  rightValue := \fun (x: N.Point) => \refl(Seam.inr x),
  seamValue := \fun (x: Constructed.seamManifold.Point) => \refl(Constructed.seamFunction x),
  noBoundary := Constructed.noBoundary,
};
