\import \root.BoundarySeam[n := n].Between[M := M, N := N].With[leftCover := leftCover, rightCover := rightCover].Along[d := d] \as Seam;
\import \root.SeamCollar[n := n].Between[M := M, N := N].With[leftCover := leftCover, rightCover := rightCover].Along[d := d] \as Collars;
\definition Point: \Set := Seam.Point;
\definition topology: topology.Structures[].Topology[Point] := Seam.topology;
\module Compact(leftCompact: LeftSpace.IsCompact M.space, rightCompact: RightSpace.IsCompact N.space);
