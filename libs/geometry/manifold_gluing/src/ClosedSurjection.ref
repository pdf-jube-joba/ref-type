\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Classical[] \as Classical;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import topology.Topology[Carrier := A] \as Source;
\import topology.Topology[Carrier := B] \as Target;
\import topology.Maps[A := A, B := B] \as Maps;
\import topology.Continuity[A := A, B := B] \as Continuous;
\import topological_constructions.Quotient[A := A, B := B] \as Surjections;
\module On(source: Source.Topology, target: Target.Topology, q: A -> B, continuous: Continuous.Continuous source target q,
  onto: Surjections.Surjective q, compact: Source.IsCompact source, hausdorff: Source.IsT2 source,
  closed: \forall (F: \Pow A) -> Source.IsClosedIn source F -> Target.IsClosedIn target (Maps.Image q F));
