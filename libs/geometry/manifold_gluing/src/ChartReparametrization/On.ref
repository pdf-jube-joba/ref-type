\import Models.Chart[M := M.Point, space := M.space] \as Charts;
\module Of(c: Charts.Chart, D: Model.Constraints, V: Open.OpenSet, d: Diffeomorphisms.Diffeomorphism c.image V,
  forward: \forall (x: Model.Carrier c.constraints c.image) -> Model.Nonnegative D (Calculus.apply c.image V d.forward x),
  backward: \forall (x: Model.Carrier D V) -> Model.Nonnegative c.constraints (Calculus.apply V c.image d.backward x));
