\import Charts.At[x := x, left := c, right := chart, inLeft := contains] \as Extension;
\definition extension: Extension.Extension := Extension.Extension {
  neighborhood := c.image, included := \fun (u: Model.Point)(member: _) => member, contains := \bysub(Model.Point, c.image.points, Extension.source), map := Forward.map,
  inside := \fun (u: Model.Carrier c.constraints c.image) => \bysub(M.Point, c.domain, Charts.point c u),
  agrees := \fun (u: Model.Carrier c.constraints c.image) => sym!{{Model.Point}} _ _ (congr!{{Model.Carrier c.constraints c.image} {Model.Point}} (\fun (p: Model.Carrier c.constraints c.image) => direct p) _ _ (Charts.coordinatePoint c u)),
};
