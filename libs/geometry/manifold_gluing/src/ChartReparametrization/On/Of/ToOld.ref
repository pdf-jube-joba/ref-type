\import Charts.At[x := x, left := chart, right := c, inLeft := contains] \as Extension;
\definition extension: Extension.Extension := Extension.Extension {
  neighborhood := V, included := \fun (u: Model.Point)(member: _) => member, contains := \bysub(Model.Point, V.points, Extension.source), map := Backward.map,
  inside := \fun (u: Model.Carrier D V) => \bysub(M.Point, c.domain, Charts.point c (inverse u)),
  agrees := \fun (u: Model.Carrier D V) => sym!{{Model.Point}} _ _ (congr!{{Model.Carrier c.constraints c.image} {Model.Point}} (\fun (p: Model.Carrier c.constraints c.image) => p) _ _ (Charts.coordinatePoint c (inverse u))),
};
