\import \root.QuadrantDiffeomorphism[n := n].Between[C := c.constraints, D := D, U := c.image, V := V].Of[d := d, forward := forward, backward := backward] \as Quarter;
\definition change: topology.Homeomorphism[A := Charts.LocalPoint c, B := Model.Carrier D V].Homeomorphism[Charts.domainTopology c.domain, Model.regionTopology D V] :=
  topology.Homeomorphism[A := Charts.LocalPoint c, B := Model.Carrier c.constraints c.image].Composition[C := Model.Carrier D V].compose (Charts.domainTopology c.domain) (Model.regionTopology c.constraints c.image) (Model.regionTopology D V) c.coordinates Quarter.homeomorphism;
\definition chart: Charts.Chart := Charts.Chart { domain := c.domain, image := V, constraints := D, open := c.open, coordinates := change };
\definition inverse[u: Model.Carrier D V]: Model.Carrier c.constraints c.image := Quarter.homeomorphism.backward u;
\definition direct[u: Model.Carrier c.constraints c.image]: Model.Carrier D V := Quarter.homeomorphism.forward u;
\import Calculus.Corestriction[U := V, V := c.image, W := Open.whole, f := d.backward, inside := \fun (u: Open.Carrier V) => \refl(Calculus.apply V c.image d.backward u \of Model.Point)] \as Backward;
\import Calculus.Corestriction[U := c.image, V := V, W := Open.whole, f := d.forward, inside := \fun (u: Open.Carrier c.image) => \refl(Calculus.apply c.image V d.forward u \of Model.Point)] \as Forward;
\module ToOld(x: M.Point, contains: Charts.Contains chart x);
\module FromOld(x: M.Point, contains: Charts.Contains c x);
