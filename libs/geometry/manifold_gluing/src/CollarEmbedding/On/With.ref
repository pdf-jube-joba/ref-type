\import \root.BoundaryInclusion[n := n].On[M := M].With[cover := cover] \as Inclusion;
\import boundary_manifolds.Product[n := n, m := One.dimension].Of[M := Inclusion.manifold, N := Time.manifold] \as Product;
\import topology.Topology[Carrier := Product.Point] \as Space;
\import topology.Topology[Carrier := M.Point] \as TargetSpace;
\import boundary_manifolds.SmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := Product.manifold, N := M] \as Maps;
\module From(deformation: Transverse.Result);
\structure Construction: \Set := {
  deformation: Transverse.Result,
  regular: \root.CollarStrip[n := n].On[M := M].With[cover := cover].From[deformation := deformation].RegularUniform,
};
\import \root.GlobalPush[n := n].On[M := M] \as Push;
\definition exists[compact: Target.IsCompact M.space]: \exists Construction := \block {
  \takefrom deformation: Transverse.Result \by Push.existsTransverse cover compact \then
  \takefrom regular: \root.CollarStrip[n := n].On[M := M].With[cover := cover].From[deformation := deformation].RegularUniform
    \by \root.CollarStrip[n := n].On[M := M].With[cover := cover].From[deformation := deformation].existsRegular compact \then
  \return \exact(Construction { deformation := deformation, regular := regular }, Construction)
};
