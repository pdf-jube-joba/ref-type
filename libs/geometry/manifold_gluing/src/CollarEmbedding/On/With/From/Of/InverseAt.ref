\import std.Set[].Extension[A := M.Point, B := Product.Point, domain := image] \as Extend;
\definition function: M.Point -> Product.Point := Extend.extend (\fun (z: ImagePoint) => backward z) (backward y);
\definition inside: \forall (z: ImagePoint) -> function z = (backward z \of Product.Point) := Extend.inside (\fun (z: ImagePoint) => backward z) (backward y);
\import \root.LocalSmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := M, N := Product.manifold].Of[function := function] \as Locality;
\definition Witness: \Set := Locality.Witness[y];
\module InPatch(b: Inclusion.manifold.Point, patch: Local.OpenPatch[b], member: Space.Member patch.patch.domain (backward y));
\definition exists: \exists Witness := Space.unionMemberElim Strip.patches (backward y) (\exists Witness) (\block {
  \fun (U: \Pow Product.Point)(member: Space.FamilyMember Strip.patches U)(inU: Space.Member U (backward y)) \then
  \takefrom b: \Cast[Inclusion.manifold.Point] ({ b: Inclusion.manifold.Point \where \exists (p: Local.OpenPatch[b] \where U = p.patch.domain) }) \by member \then
  \takefrom patch: \Cast[Local.OpenPatch[b]] ({ p: Local.OpenPatch[b] \where U = p.patch.domain }) \by \bysub(Inclusion.manifold.Point,
    { b: Inclusion.manifold.Point \where \exists (p: Local.OpenPatch[b] \where U = p.patch.domain) }, b) \then
  \let inPatch: Space.Member patch.patch.domain (backward y) := \idelim U = patch.patch.domain \with D: \Pow Product.Point => Space.Member D (backward y) \by {
    base: inU, equality: \bysub(Local.OpenPatch[b], { p: Local.OpenPatch[b] \where U = p.patch.domain }, patch)
  } \then
  \return InPatch[b := b, patch := patch, member := inPatch].exists
}) (regularPoint (backward y) (\bysub(Product.Point, domain, backward y)));
