\definition old: Half.OldChart := \into[Charts.Chart](c, M.atlas.charts) \by { Boundary.member c };
\import \root.HalfModel[n := Nat.add One.dimension n].On[M := M].Full[c := old, i := boundary_manifolds.Boundary[n := n].normal, same := Boundary.constraints c] \as Full;
\definition exists: \exists (d: Half.Data \where Half.Contains d x) := Logic.existsIntro[Half.Data, { d: Half.Data \where Half.Contains d x }] Full.data (Full.contains x contains);
