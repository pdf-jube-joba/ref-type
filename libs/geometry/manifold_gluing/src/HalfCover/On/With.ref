\module In(x: M.Point, c: Boundary.Chart, contains: Charts.Contains c x);
\definition cover: Half.Cover := \block {
  \fun (x: M.Point)(boundary: boundary_manifolds.Tangent[n := Nat.add One.dimension n].On[M := M].At[x := x].Cones[].Boundary) \then
  \let point: Boundary.Point := \into[M.Point](x, Boundary.points) \by { boundary } \then
  \takefrom c: \Cast[Boundary.Chart] ({ c: Boundary.Chart \where Charts.Contains c x }) \by boundaryCover point \then
  \return In[x := x, c := c, contains := \bysub(Boundary.Chart, { c: Boundary.Chart \where Charts.Contains c x }, c)].exists
};
