\import \root.OpenManifold[n := n].On[M := M].Within[U := U, open := open] \as Source;
\import \root.HalfModel[n := n].On[M := Source.manifold] \as Result;
\import Models.Chart[M := Source.Point, space := Source.topology] \as Charts;
\module With(originalCover: Half.Cover);

\definition LocalCover: \Prop := \forall (x: Source.Point) -> boundary_manifolds.Tangent[n := n].On[M := M].At[x := x].Cones[].Boundary -> \exists (d: Half.Data \where Half.Contains d x);
\module From(localCover: LocalCover);
