\import \root.HalfModel[n := n].On[M := M].In[data := d] \as Original;
\definition original: Original.Point := \into[M.Point](x, Original.domain) \by { member };
\definition patch: Source.Patch := Source.Patch { source := d.chart, representative := representative };
\import Source.For[patch := patch] \as Patch;
\definition old: Result.OldChart := \into[Charts.Chart](Patch.chart, Source.manifold.atlas.charts) \by {
  Logic.existsIntro[Source.Patch, { p: Source.Patch \where Patch.chart = Source.For[patch := p].chart }] patch (\refl(Patch.chart))
};
\definition domain: Open.OpenSet := Open.intersection d.source representative.domain;
\definition included: Open.Included domain Patch.image := Open.intersectionRight d.source representative.domain;
\definition input[u: Open.Carrier domain]: Open.Carrier d.source := Open.inclusion domain d.source (Open.intersectionLeft d.source representative.domain) u;
\definition data: Result.Data := Result.Data { chart := old, source := domain, included := included, normal := d.normal, equivalent := \fun (u: Open.Carrier domain) => d.equivalent (input u) };
\definition containsOld: Old.Contains d.chart x := \bysub(M.Point, d.chart.domain, Original.old original);
\definition local: Charts.LocalPoint Patch.chart := \into[Source.Point](x, Patch.domain) \by { containsOld };
\definition oldEqual: Patch.old local = Original.old original := boundary_manifolds.Refinement[A := M.Point].equality d.chart.domain (Patch.old local) (Original.old original) (\refl(x \of M.Point));
\definition rawEqual: (Charts.coordinate Patch.chart local \of Model.Point) = (Old.coordinate d.chart (Original.old original) \of Model.Point) := congr!{{Old.LocalPoint d.chart} {Model.Point}} (\fun (p: Old.LocalPoint d.chart) => Old.coordinate d.chart p) _ _ oldEqual;
\definition leftInside: \In[Model.Point] d.source.points (Charts.coordinate Patch.chart local) := \idelim (Old.coordinate d.chart (Original.old original) \of Model.Point) = (Charts.coordinate Patch.chart local \of Model.Point) \with u: Model.Point => \In[Model.Point] d.source.points u \by { base: Original.inside original, equality: sym!{{Model.Point}} _ _ rawEqual };
\import \root.ChartRestriction[n := n].On[M := Source.manifold].Of[c := old].Within[U := domain, included := included] \as Restriction;
\definition contains: Result.Contains data x := Restriction.containsFrom local (Logic.And[_, _]::# leftInside (\bysub(Model.Point, representative.domain.points, Charts.coordinate Patch.chart local)));
\definition exists: \exists (d: Result.Data \where Result.Contains d x) := Logic.existsIntro[Result.Data, { d: Result.Data \where Result.Contains d x }] data contains;
