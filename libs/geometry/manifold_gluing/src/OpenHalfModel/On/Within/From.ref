\module At(x: Source.Point, d: Half.Data, member: Half.Contains d x, representative: Source.In[c := d.chart].Representative);
\definition cover: Result.Cover := \block {
  \fun (x: Source.Point)(boundary: boundary_manifolds.Tangent[n := n].On[M := Source.manifold].At[x := x].Cones[].Boundary) \then
  \let original: boundary_manifolds.Tangent[n := n].On[M := M].At[x := x].Cones[].Boundary := \root.OpenManifoldCones[n := n].On[M := M].Within[U := U, open := open].At[x := x].boundary.ltr boundary \then
  \takefrom d: \Cast[Half.Data] ({ d: Half.Data \where Half.Contains d x }) \by localCover x original \then
  \takefrom representative: Source.In[c := d.chart].Representative \by Source.In[c := d.chart].exists \then
  \return At[x := x, d := d, member := \bysub(Half.Data, { d: Half.Data \where Half.Contains d x }, d), representative := representative].exists
};
