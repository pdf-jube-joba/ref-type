\import Models.Quadrant[C := C, U := U] \as Source;
\import Models.Quadrant[C := D, U := V] \as Target;
\module Of(d: Diffeomorphisms.Diffeomorphism U V,
  forward: \forall (x: Source.Point) -> Model.Nonnegative D (Calculus.apply U V d.forward x),
  backward: \forall (x: Target.Point) -> Model.Nonnegative C (Calculus.apply V U d.backward x));
