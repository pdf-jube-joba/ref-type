\definition radius: S.Real := Metric.min S.one r;
\definition positive: R.Lt S.zero radius := Estimates.minPositive S.one r Estimates.onePositive ball.positive;
\definition within: \forall (t: Time.Point) -> R.Lt (Time.value t) radius -> Space.Member W t := \block {
  \fun (t: Time.Point)(small: _) \then
  \let close: R.Lt (Coordinates.pointDistance t Time.zero) r := R.ltReplaceLeft (Time.value t) (Coordinates.pointDistance t Time.zero) r
    (sym!{S.Real} _ _ (distanceZero t)) (R.ltLeTrans (Time.value t) radius r small (Metric.minRight S.one r)) \then
  \let point: Model.Carrier Time.constraints neighborhood.domain := \into[Open.Carrier neighborhood.domain](\into[Model.Point](t, neighborhood.domain.points) \by { ball.included t close }, Model.region Time.constraints neighborhood.domain) \by {
    \bysub(Open.Carrier Time.domain, Model.region Time.constraints Time.domain, t)
  } \then
  \return neighborhood.within point
};
\definition width: Width := Width { radius := radius, positive := positive, bounded := Metric.minLeft S.one r, within := within };
