\module With(r: S.Real, ball: Open.BallInside[neighborhood.domain.points, Time.zero, r]);
\definition exists: \exists Width := \block {
  \takefrom r: \Cast[S.Real] ({ r: S.Real \where Open.BallInside[neighborhood.domain.points, Time.zero, r] })
    \by neighborhood.domain.open Time.zero neighborhood.contains \then
  \return \exact(With[r := r, ball := \bysub(S.Real, { r: S.Real \where Open.BallInside[neighborhood.domain.points, Time.zero, r] }, r)].width, Width)
};
