\import \root.QuadrantNeighborhood[n := One.dimension].On[C := Time.constraints, U := Time.domain] \as Neighborhoods;
\structure Width: \Set := {
  radius: S.Real,
  positive: R.Lt S.zero radius,
  bounded: R.Le radius S.one,
  within: \forall (t: Time.Point) -> R.Lt (Time.value t) radius -> Space.Member W t,
};
\module Using(neighborhood: Neighborhoods.Neighborhood[W, Time.zero]);
\definition exists: \exists Width := \block {
  \takefrom neighborhood: Neighborhoods.Neighborhood[W, Time.zero] \by Neighborhoods.At[W := W, open := open, a := Time.zero, inside := contains].exists \then
  \return Using[neighborhood := neighborhood].exists
};
