
\import boundary_manifolds.Boundary[n := n].Of[M := M] \as LeftAtlas;
\import boundary_manifolds.Boundary[n := m].Of[M := N] \as RightAtlas;
\import topology.Topology[Carrier := M.Point] \as LeftSpace;
\import topology.Topology[Carrier := N.Point] \as RightSpace;
\import boundary_manifolds.Product[n := Nat.add One.dimension n, m := Nat.add One.dimension m].Of[M := M, N := N] \as Product;
\import topology.Topology[Carrier := Product.Point] \as Space;
\module With(leftCover: LeftAtlas.Cover, rightCover: RightAtlas.Cover);
