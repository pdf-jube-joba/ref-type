
\import boundary_manifolds.Tangent[n := Nat.add One.dimension n].On[M := M].At[x := Product.first x].Cones[] \as Left;
\import boundary_manifolds.Tangent[n := Nat.add One.dimension m].On[M := N].At[x := Product.second x].Cones[] \as Right;
\definition noCorner: Logic.Not (Logic.And[Left.Boundary, Right.Boundary]) := \fun (both: Logic.And[Left.Boundary, Right.Boundary]) =>
 (\bysub(Product.Point, Global.far, x)) (Rounding.Corner[x := x, leftBoundary := both.left, rightBoundary := both.right].coreMember);
\definition cover: boundary_manifolds.Tangent[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n)].On[M := Product.manifold].At[x := x].Cones[].Boundary -> \exists (d: \root.HalfModel[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n)].On[M := Product.manifold].Data \where \root.HalfModel[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n)].On[M := Product.manifold].Contains d x) := Outside.At[x := x, noCorner := noCorner].exists;
