
\import \parent.From[result := result.construction] \as Construction;
\definition manifold: Models.Manifold := Construction.manifold result.rounded;
\definition boundaryCover: boundary_manifolds.Boundary[n := Nat.add m (Nat.add One.dimension n)].Of[M := manifold].Cover := result.rounded.boundaryCover;
\definition noHigherCorners: \root.OneActiveCharts[n := Nat.add One.dimension (Nat.add m (Nat.add One.dimension n))].On[M := manifold].Cover := result.rounded.noHigherCorners;
\import \root.ProductCollar[n := n, m := m].Between[M := M, N := N].With[leftCover := leftCover, rightCover := rightCover].From[left := result.construction.left.deformation, right := result.construction.right.deformation].Using[leftRegular := result.construction.left.regular, rightRegular := result.construction.right.regular].At[leftWidth := result.construction.leftWidth, rightWidth := result.construction.rightWidth] \as Parameters;
\import Parameters.Rounded[] \as Rounding;
\definition compact: topology.Topology[Carrier := manifold.Point].IsCompact manifold.space := Rounding.compact leftCompact rightCompact;
\definition unchanged: Space.Subset (Space.Complement Parameters.core) Rounding.points := Rounding.unchanged;
\definition removesCorners: \forall (x: Product.Point) -> \In[M.Point] LeftAtlas.points (Product.first x) -> \In[N.Point] RightAtlas.points (Product.second x) -> Logic.Not (\In[Product.Point] Rounding.points x) := Original.Of[result := result.construction].removesCorners;
