
\import \root.DimensionChange[n := Nat.add (Nat.add One.dimension m) (Nat.add One.dimension n)].On[M := Cover.manifold].At[m := Nat.add One.dimension (Nat.add m (Nat.add One.dimension n))] \as Changed;
\import \root.NormalizeHalfAtlas[n := Nat.add m (Nat.add One.dimension n)].On[M := Changed.manifold change.change].With[cover := change.cover] \as Normal;
\definition value: Result := Result { atlas := Normal.manifold.atlas, boundaryCover := Normal.boundaryCover, noHigherCorners := Normal.noHigherCorners };
