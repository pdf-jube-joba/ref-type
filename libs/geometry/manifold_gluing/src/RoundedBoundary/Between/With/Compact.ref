
\import \root.ProductCollar[n := n, m := m].Between[M := M, N := N].With[leftCover := leftCover, rightCover := rightCover].Compact[leftCompact := leftCompact, rightCompact := rightCompact] \as Original;
\module From(result: Original.Result);

\import boundary_manifolds.Dimension[n := Nat.add One.dimension (Nat.add m (Nat.add One.dimension n))] \as Models;
\definition Rounded[r: Original.Result]: \Set := From[result := r].Result;
\structure Result: \Set := { construction: Original.Result, rounded: Rounded construction, };
\definition exists: \exists Result := \block {
 \takefrom construction: Original.Result \by Original.exists \then
 \takefrom rounded: From[result := construction].Result \by From[result := construction].exists \then
 \return \exact(Result { construction := construction, rounded := rounded }, Result)
};
\module Of(result: Result);
