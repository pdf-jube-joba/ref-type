\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import topological_constructions.Coproduct[A := A, B := B] \as Sum;
\import topological_constructions.Pushout[A := A, B := B, C := C].Of[u := u, v := v] \as Pushout;
\definition Cross[a: A][b: B]: \Prop := \exists ( c: C \where Logic.And[a = u c, b = v c] );
\definition Normal[x, y: Sum.Carrier]: \Prop :=
  (\induction (p: Sum.Carrier) \return Sum.Carrier -> \Prop \with {
    | inl: \fun (a: A) => \induction (q: Sum.Carrier) \return \Prop \with {
      | inl: \fun (b: A) => a = b
      | inr: \fun (b: B) => Cross a b
    }
    | inr: \fun (a: B) => \induction (q: Sum.Carrier) \return \Prop \with {
      | inl: \fun (b: A) => Cross b a
      | inr: \fun (b: B) => a = b
    }
  }) x y;
\structure Injections: \Prop := {
  left: \forall (c, d: C) -> u c = u d -> c = d,
  right: \forall (c, d: C) -> v c = v d -> c = d,
};
\module Embedded(injections: Injections);
\module Map(D, E, F: \Set, s: F -> D, t: F -> E, left: A -> D, right: B -> E, seam: C -> F);
