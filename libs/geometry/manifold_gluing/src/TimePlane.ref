\import std.Data[].Nat[].Basic[].Def[] \as Nat;
\import std.Data[].Nat[] \as Nats;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import dedekind_reals.DedekindReal[] \as R;
\import calculus.Real[].OneDimension[] \as One;
\import \root.Parameter[] \as Time;
\import boundary_manifolds.Product[n := One.dimension, m := One.dimension] \as Products;
\import Products.Of[M := Time.manifold, N := Time.manifold] \as Product;
\import boundary_manifolds.Dimension[n := One.dimension].Chart[M := Time.Point, space := Time.manifold.space] \as TimeCharts;
\definition timeChart: Product.LeftChart := \into[TimeCharts.Chart](Time.chart, Time.manifold.atlas.charts) \by { Time.chartMember };
\import Product.In[c := timeChart, d := timeChart] \as Standard;
\import boundary_manifolds.Dimension[n := Nat.add One.dimension One.dimension].Chart[M := Product.Point, space := Product.topology] \as Charts;
\definition index: Product.Index := std.Data[].Pair[].pair Product.LeftChart Product.RightChart timeChart timeChart;
\definition member: \In[Charts.Chart] Product.manifold.atlas.charts Standard.chart := Logic.existsIntro[Product.Index, { i: Product.Index \where Standard.chart = Product.chart i }] index (\refl(Standard.chart));
\definition covers: \forall (x: Product.Point) -> Charts.Contains Standard.chart x := \fun (x: Product.Point) => Logic.And[_, _]::# (\refl(Product.first x)) (\refl(Product.second x));
\import \root.ChartModel[n := Nat.add One.dimension One.dimension].On[M := Product.manifold].At[c := Standard.chart, member := member, covers := covers] \as Chart;
\import boundary_manifolds.Dimension[n := Nat.add One.dimension One.dimension].Quadrant[C := Standard.C, U := Standard.image] \as Source;
\import boundary_manifolds.Model[n := Nat.add One.dimension One.dimension] \as Model;
\import calculus.Real[].Multivariable[n := Nat.add One.dimension One.dimension].Open[] \as Open;
\import calculus.Blocks[n := One.dimension, m := One.dimension] \as Blocks;
\import Fin.Sum[m := One.dimension, n := One.dimension] \as SourceIndices;
\import \root.SupportedRounding[].Higher[n := Nats.Nat^::zero] \as Round;
\import \root.SupportedRounding[].Higher[n := Nats.Nat^::zero].Quarter[] \as Quarter;
\import boundary_manifolds.Model[n := Round.dimension] \as TargetModel;
\import calculus.Real[].Multivariable[n := Round.dimension].Open[] \as Output;
\import calculus.Maps[n := Nat.add One.dimension One.dimension, m := Round.dimension] \as Calculus;
\import \root.NormalPlane[] \as Plane;
\import \root.Reflection[n := Nats.Nat^::zero] \as First;
\import Fin.Sum[m := First.dimension, n := One.dimension] \as TargetIndices;
\import TargetIndices.Tuples[A := S.Real] \as Tuples;
\module At(q: S.Real, positive: R.Lt S.zero q);
