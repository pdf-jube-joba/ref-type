\import Region.Boundary[a := (x \of FullOpen.Carrier FullOpen.whole), local := local] \as Patch;
\import manifolds.ChartRestriction[n := dimension].On[M := Region.ambient].At[c := Region.standard, U := local.domain, included := local.included] \as Restricted;
\definition contains: SourceCharts.Contains Construction.On[patch := Patch.patch].chart x := Restricted.pointMember (\into[FullModel.Point](x, local.domain.points) \by { local.contains });
\definition coordinatesIdentity: \forall (p: AmbientCharts.LocalPoint Patch.patch.source) -> (AmbientCharts.coordinate Patch.patch.source p \of FullModel.Point) = (p \of FullModel.Point) :=
  \fun (p: AmbientCharts.LocalPoint Patch.patch.source) => \refl(p \of FullModel.Point);
\definition witness: Local.Witness[x] := \parent.\parent.AtPatch[x := x, patch := Patch.patch, contains := contains, coordinatesIdentity := coordinatesIdentity].witness;
