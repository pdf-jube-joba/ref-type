\import Region.Interior[] \as Patch;
\import boundary_manifolds.Positive[n := dimension].On[U := FullOpen.whole, h := Maps.coordinateFunction FullOpen.whole Open.whole function One.index] \as Positive;
\import manifolds.ChartRestriction[n := dimension].On[M := Region.ambient].At[c := Region.standard, U := Positive.domain, included := Positive.included] \as Restricted;
\definition contains: SourceCharts.Contains Construction.On[patch := Patch.patch].chart x := Restricted.pointMember (\into[FullModel.Point](x, Positive.domain.points) \by { Positive.intro x positive });
\definition coordinatesIdentity: \forall (p: AmbientCharts.LocalPoint Patch.patch.source) -> (AmbientCharts.coordinate Patch.patch.source p \of FullModel.Point) = (p \of FullModel.Point) :=
  \fun (p: AmbientCharts.LocalPoint Patch.patch.source) => \refl(p \of FullModel.Point);
\definition exists: \exists Local.Witness[x] := \exact(\parent.AtPatch[x := x, patch := Patch.patch, contains := contains, coordinatesIdentity := coordinatesIdentity].witness, Local.Witness[x]);
