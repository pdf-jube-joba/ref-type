\import inverse_implicit.Product[n := First.dimension, m := One.dimension].Submersion[U := FullOpen.whole, f := function, a := (include x \of FullOpen.Carrier FullOpen.whole)] \as Submersion;
\module Using(local: Submersion.LocalForm);
\definition exists: \exists Local.Witness[x] := \block {
  \takefrom local: Submersion.LocalForm \by Submersion.localExistence (\parent.\parent.\parent.At[x := include x].surjective) \then
  \return \exact(Using[local := local].witness, Local.Witness[x])
};
