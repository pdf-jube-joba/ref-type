\definition sumZero: sum x = S.zero := trans!{S.Real} _ _ _ (congr!{S.Real S.Real S.Real} S.add _ _ _ _ firstZero secondZero) (Laws.addZeroLeft S.zero);
\definition definingNegative: R.Lt (defining x) S.zero := R.ltReplaceLeft (S.neg (profile x)) (defining x) S.zero
  (sym!{S.Real} _ _ (trans!{S.Real} _ _ _ (definingFormula x) (trans!{S.Real} _ _ _ (congr!{S.Real S.Real} (\fun (s: S.Real) => S.sub s (profile x)) _ _ sumZero) (Laws.addZeroLeft (S.neg (profile x))))))
  (Laws.negativeNegOfPositive (profile x) (Profile.strictlyPositive (Maps.apply FullOpen.whole Open.whole differenceMap x)));
