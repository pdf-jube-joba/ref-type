\import \parent.Estimates[] \as Estimates;
\definition quarter: Estimates.Quarter x := Estimates.Included[x := x, member := \bysub(FullOpen.Carrier FullOpen.whole, Region.points, x)].quarter;
\import boundary_manifolds.Tangent[n := dimension].On[M := manifold].At[x := x].Cones[] \as Cones;
\import Region.Build[regular := regular].At[x := x] \as Geometry;
\definition boundary: Logic.PropEquiv[Cones.Boundary, sum x = profile x] := Logic.PropEquiv[_, _] {
  ltr := \fun (boundary: Cones.Boundary) => Distance.subZeroEq (sum x) (profile x)
    (trans!{S.Real} _ _ _ (sym!{S.Real} _ _ (definingFormula x)) (Geometry.toZero boundary)),
  rtl := \fun (same: sum x = profile x) => Geometry.ofZero (trans!{S.Real} _ _ _ (definingFormula x)
    (trans!{S.Real} _ _ _ (congr!{S.Real S.Real} (\fun (a: S.Real) => S.sub a (profile x)) _ _ same) (Laws.subSelf (profile x)))),
};
