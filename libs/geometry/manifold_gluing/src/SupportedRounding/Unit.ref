\definition zero: Model.Point := \fun (i: One.Index) => S.zero;
\definition one: smooth_partitions.Euclidean[n := One.dimension].Positive := \into[S.Real](S.one, { q: S.Real \where R.Lt S.zero q }) \by { Bounds.onePositive };
\import smooth_partitions.Euclidean[n := One.dimension].LocalBump[a := zero, q := one] \as Bump;
\definition bump: F.Function := \into[Open.ScalarFunction Open.whole]((\fun (x: Open.Carrier Open.whole) => Bump.value x), F.Predicate) \by { Bump.smooth };
\definition coordinate: F.Function := Derivative.projection One.index;
\definition radicand: F.Function := F.plus (F.product coordinate coordinate) bump;
\definition bumpZero: Bump.value zero = S.one := Bump.oneNear zero
  (R.ltReplaceLeft S.zero (topological_algebra.Euclidean[].Dimension[n := One.dimension].Def[].pointDistance zero zero) S.one (sym!{S.Real} _ _ (Norm.distanceSelf zero)) Bounds.onePositive);
\module At(x: Open.Carrier Open.whole);
\definition positive: \forall (x: Open.Carrier Open.whole) -> R.Lt S.zero (radicand x) := \fun (x: Open.Carrier Open.whole) => At[x := x].positive;
\import Open.Smooth[].SquareRoot[U := Open.whole, f := radicand, positive := positive] \as Profile;
\definition function: F.Function := \into[Open.ScalarFunction Open.whole](Profile.value, F.Predicate) \by { Profile.smooth };
\definition value[x: Open.Carrier Open.whole]: S.Real := function x;
\definition square: \forall (x: Open.Carrier Open.whole) -> S.mul (value x) (value x) = radicand x := \fun (x: Open.Carrier Open.whole) => Root.squareOfNonnegative (radicand x) (Order.leOfLt S.zero (radicand x) (positive x));
\definition nonnegative: \forall (x: Open.Carrier Open.whole) -> R.Le S.zero (value x) := \fun (x: Open.Carrier Open.whole) => Root.nonnegative (radicand x);
\module Estimates;

\definition strictlyPositive: \forall (x: Open.Carrier Open.whole) -> R.Lt S.zero (value x) := \fun (x: Open.Carrier Open.whole) => Order.ltOfLeNotEq S.zero (value x) (nonnegative x)
  (\fun (same: S.zero = value x) => Order.ltNotEq S.zero (radicand x) (positive x) (trans!{S.Real} _ _ _ (sym!{S.Real} _ _ (Laws.fieldMulZeroLeft S.zero))
    (trans!{S.Real} _ _ _ (congr!{S.Real S.Real S.Real} S.mul S.zero (value x) S.zero (value x) same same) (square x))));
