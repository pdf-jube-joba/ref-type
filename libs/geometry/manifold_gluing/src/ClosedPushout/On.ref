\import Seam.Embedded[injections := injections] \as Embedded;
\definition Point: \Set := Pushout.Carrier;
\definition topology: topology.Structures[].Topology[Point] := Pushout.topology left right;
\import topology.Topology[Carrier := Point] \as Target;
\import topology.Maps[A := A, B := Point] \as LeftMaps;
\import topology.Maps[A := B, B := Point] \as RightMaps;
\module LeftImage(F: \Pow A, closed: Left.IsClosedIn left F);
\module RightImage(F: \Pow B, closed: Right.IsClosedIn right F);
\import topological_constructions.Coproduct[A := A, B := B] \as Sum;
\definition source: topology.Structures[].Topology[Sum.Carrier] := Sum.topology left right;
\import topology.Topology[Carrier := Sum.Carrier] \as Source;
\import topology.Maps[A := Sum.Carrier, B := Point] \as Maps;
\module Image(F: \Pow Sum.Carrier, closed: Source.IsClosedIn source F);
\definition ClosedMap: \Prop := \forall (F: \Pow Sum.Carrier) -> Source.IsClosedIn source F -> Target.IsClosedIn topology (Maps.Image Pushout.class F);
\definition closedMap: ClosedMap := \fun (F: \Pow Sum.Carrier)(closed: _) => Image[F := F, closed := closed].closedImage;
