\definition q: S.Real := Estimates.radius four epsilon;
\definition qPositive: R.Lt S.zero q := Estimates.radiusPositive four epsilon fourPositive positive;
\definition outer: S.Real := S.mul q four;
\definition inner: S.Real := S.mul q three;
\definition outerSmall: R.Lt outer epsilon := R.ltReplaceLeft (S.mul four q) outer epsilon (Laws.fieldMulComm four q) (Estimates.radiusSmall four epsilon fourPositive positive);
\definition outerBounded: R.Lt outer S.one := R.ltLeTrans outer epsilon S.one outerSmall bounded;
\definition innerPositive: R.Lt S.zero inner := Estimates.mulPositive q three qPositive threePositive;
\definition innerSmall: R.Lt inner outer := Estimates.mulStrict q three four qPositive threeLtFour;
\definition outerPositive: R.Lt S.zero outer := Order.ltTrans S.zero inner outer innerPositive innerSmall;
\definition innerBounded: R.Lt inner S.one := Order.ltTrans inner outer S.one innerSmall outerBounded;
