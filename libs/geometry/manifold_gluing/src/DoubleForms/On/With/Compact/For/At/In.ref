
\import Gluing.At[b := b].In[c := c] \as Forms;
\definition Form: \Set := Forms.Form;
\definition Arguments: \Set := Forms.Arguments;
\definition BoundaryForm: \Set := Forms.BoundaryForm;
\definition BoundaryArguments: \Set := Forms.BoundaryArguments;
\definition leftForm: Form -> Forms.CoordinateForm := Forms.leftForm;
\definition rightForm: Form -> Forms.CoordinateForm := Forms.rightForm;
\definition orientationSign: \forall (omega: Form)(arguments: Arguments) -> rightForm omega arguments = S.neg (leftForm omega arguments) := Forms.orientationSign;
\definition BoundaryOutputForm: \Set := Forms.BoundaryOutputForm;
\definition leftBoundary: BoundaryForm -> BoundaryOutputForm := Forms.leftBoundary;
\definition rightBoundary: BoundaryForm -> BoundaryOutputForm := Forms.rightBoundary;
\definition boundaryOpposite: \forall (omega: BoundaryForm)(arguments: BoundaryArguments) -> rightBoundary omega arguments = S.neg (leftBoundary omega arguments) := Forms.outwardOpposite;
\definition boundaryCancellation: \forall (omega: BoundaryForm)(arguments: BoundaryArguments) -> S.add (leftBoundary omega arguments) (rightBoundary omega arguments) = S.zero := Forms.boundaryCancellation;
