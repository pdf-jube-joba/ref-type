\import std.Data[].Nat[].Basic[].Def[] \as Nat;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import calculus.Real[].OneDimension[] \as One;
\definition dimension: std.Data[].Nat[].Nat^ := Nat.add One.dimension n;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Open;
\import calculus.Maps[n := dimension, m := dimension] \as Maps;
\import calculus.Diffeomorphism[n := dimension, m := dimension] \as Diffeomorphisms;
\import boundary_manifolds.Model[n := dimension] \as Model;
\import \root.NormalCoordinate[n := n] \as Normal;
\definition Point: \Set := Model.Point;
\definition normal: Model.Coordinate := Normal.normal;
\module On(U: Open.OpenSet, f: Maps.Map U Open.whole, a: Open.Carrier U, zeroNormal: a normal = S.zero, fixed: \root.HalfSpaceJet[n := n].BoundaryFixed U f);
