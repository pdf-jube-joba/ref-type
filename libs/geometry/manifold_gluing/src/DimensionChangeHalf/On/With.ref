\module At(m: Nat.Nat^);
\definition identity: At[m := n].Data := At[m := n].Data { change := Dimensions.identity, cover := cover };
\definition exists: \forall (m: Nat.Nat^) -> n = m -> \exists At[m := m].Data := \fun (m: Nat.Nat^)(same: n = m) =>
  \idelim n = m \with k: Nat.Nat^ => \exists \root.DimensionChangeHalf[n := n].On[M := M].With[cover := cover].At[m := k].Data \by {
    base: \exact(identity, At[m := n].Data), equality: same
  };
