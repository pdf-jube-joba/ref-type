\import Converted.InChart[c := c] \as Given;
\import Construction.On[patch := Given.patch] \as Patch;
\import boundary_manifolds.Tangent[n := n].On[M := Converted.manifold].At[x := x] \as T;
\definition chart: T.Chart := \into[Charts.Chart](Patch.chart, T.Chart) \by { T.ChartLaws[Patch.chart] {
  member := Logic.existsIntro[Construction.Adapted, { p: Construction.Adapted \where Patch.chart = Construction.On[patch := p].chart }] Given.patch (\refl(Patch.chart)), contains := contains,
} };
\definition witness: Free.At[x := x].Witness := \into[T.Chart](chart, { c: T.Chart \where c.constraints = boundary_manifolds.Model[n := n].unconstrained }) \by { \refl(boundary_manifolds.Model[n := n].unconstrained) };
