\import boundary_manifolds.Boundaryless[n := n].Of[M := M] \as Converted;
\import boundary_manifolds.Ambient[n := n].Over[M := M, S := topology.Topology[Carrier := M.Point].Whole] \as Construction;
\import \root.FreeCharts[n := n].On[M := Converted.manifold] \as Free;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Old;
\import boundary_manifolds.Dimension[n := n].Chart[M := Converted.manifold.Point, space := Converted.manifold.space] \as Charts;
\definition OldChart: \Set := \Cast[Old.Chart] M.atlas.charts;
\module In(x: Converted.manifold.Point, c: OldChart, contains: Old.Contains c x);
\definition cover: Free.Cover := \block {
  \fun (x: Converted.manifold.Point) \then
  \takefrom c: \Cast[Old.Chart] ({ c: Old.Chart \where Logic.And[\In[Old.Chart] M.atlas.charts c, Old.Contains c x] }) \by M.atlas.covers x \then
  \let laws: Logic.And[\In[Old.Chart] M.atlas.charts c, Old.Contains c x] := \bysub(Old.Chart, { c: Old.Chart \where Logic.And[\In[Old.Chart] M.atlas.charts c, Old.Contains c x] }, c) \then
  \let old: OldChart := \into[Old.Chart](c, M.atlas.charts) \by { laws.left } \then
  \return \exact(In[x := x, c := old, contains := laws.right].witness, Free.At[x := x].Witness)
};
