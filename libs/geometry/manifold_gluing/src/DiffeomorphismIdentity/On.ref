\import \root.Diffeomorphism[n := n, m := n].Between[M := M, N := M] \as Diffeomorphisms;
\import boundary_manifolds.MapIdentity[n := n].On[M := M] \as Identity;
\definition value: Diffeomorphisms.Diffeomorphism := Diffeomorphisms.Diffeomorphism {
  forward := Identity.map, backward := Identity.map,
  leftInverse := \fun (x: M.Point) => \refl(x), rightInverse := \fun (x: M.Point) => \refl(x),
};
