
\import Products.Of[M := M, N := N] \as Product;
\import LeftModels.Chart[M := M.Point, space := M.space] \as LeftCharts;
\import RightModels.Chart[M := N.Point, space := N.space] \as RightCharts;
\import \root.HalfModel[n := n].On[M := M] \as LeftHalf;
\import \root.HalfModel[n := m].On[M := N] \as RightHalf;
\import \root.HalfModel[n := Nat.add m n].On[M := Product.manifold] \as Result;
\module LeftBoundary(x: Product.Point, d: LeftHalf.Data, member: LeftHalf.Contains d (Product.first x), interior: Logic.Not (boundary_manifolds.Tangent[n := m].On[M := N].At[x := Product.second x].Cones[].Boundary));
\module RightBoundary(x: Product.Point, d: RightHalf.Data, member: RightHalf.Contains d (Product.second x), interior: Logic.Not (boundary_manifolds.Tangent[n := n].On[M := M].At[x := Product.first x].Cones[].Boundary));
\module With(leftCover: LeftHalf.Cover, rightCover: RightHalf.Cover);
