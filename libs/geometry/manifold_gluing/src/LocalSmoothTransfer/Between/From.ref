\import \root.LocalSmoothMap[n := n, m := m].Between[M := M, N := N].Of[function := f] \as Destination;
\import \root.LocalSmoothMap[n := n, m := m].Between[M := M, N := N].Of[function := g] \as Original;
\module At(x: M.Point, U: \Pow M.Point, open: topology.Topology[Carrier := M.Point].IsOpenIn M.space U,
  contains: \In[M.Point] U x, agrees: \forall (y: M.Point) -> \In[M.Point] U y -> f y = g y, chosen: Original.Witness[x]);
