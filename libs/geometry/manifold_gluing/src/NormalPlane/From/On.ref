\definition function[x: A]: Point := point (u x) (v x);
\definition coordinatesContinuous: \forall (i: Fin.Fin Second.dimension) -> Functions.Continuous space (\fun (x: A) => function x i) := \fun (i: Fin.Fin Second.dimension) =>
  (\induction (j: Outer.Index) \return Functions.Continuous space (\fun (x: A) => Tuples.evaluate (\fun (i: Fin.Fin First.dimension) => u x) (\fun (i: One.Index) => v x) j) \with {
    | inl: \fun (j: Fin.Fin First.dimension) => firstContinuous
    | inr: \fun (j: One.Index) => secondContinuous
  }) (Outer.split i);
\definition continuous: topology.Continuity[A := A, B := Point].Continuous space Ambient.topology function := \fun (U: \Pow Point)(open: _) => Universal.continuous space Line.topology function coordinatesContinuous U (Ambient.metricOpen U open);
