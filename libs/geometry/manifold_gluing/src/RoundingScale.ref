\import real.Analysis[] \as S;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import R.Arithmetic[].Prop[] \as Laws;
\import S.Algebra[] \as Algebra;
\import S.Estimates[].Product[] \as Estimates;
\import smooth_partitions.Exponential[].Plateau[] \as Plateau;
\definition three: S.Real := S.add Plateau.two S.one;
\definition four: S.Real := S.add Plateau.two Plateau.two;
\definition oneLtTwo: R.Lt S.one Plateau.two := R.ltReplaceLeft (S.add S.zero S.one) S.one Plateau.two (Laws.addZeroLeft S.one)
  (Laws.ltAddRight S.zero S.one S.one Estimates.onePositive);
\definition threeLtFour: R.Lt three four := Laws.ltAddLeft Plateau.two S.one Plateau.two oneLtTwo;
\definition threePositive: R.Lt S.zero three := R.ltLeTrans S.zero Plateau.two three Plateau.twoPositive (Algebra.leAddRight Plateau.two S.one Laws.oneNonnegative);
\definition fourPositive: R.Lt S.zero four := Order.ltTrans S.zero three four threePositive threeLtFour;
\module At(epsilon: S.Real, positive: R.Lt S.zero epsilon, bounded: R.Le epsilon S.one);
