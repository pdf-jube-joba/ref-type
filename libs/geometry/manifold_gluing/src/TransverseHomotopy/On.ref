\import \root.PushHomotopy[n := n].On[M := M] \as Homotopies;
\import \root.HomotopyVelocity[n := n].On[M := M] \as Velocity;
\import boundary_manifolds.Tangent[n := n].On[M := M] \as Tangent;
\import topology.Topology[Carrier := M.Point] \as Space;
\definition boundary: \Pow M.Point := { x: M.Point \where Tangent.At[x := x].Cones[].Boundary };
\definition StrictAt[h: Homotopies.Homotopy][x: M.Point]: \Prop := Logic.Not (Tangent.At[x := x].Cones[].Tangential (Velocity.Of[h := h].At[x := x].value));
\structure Patch: \Set := {
  patch: Homotopies.Patch,
  strict: \forall (x: M.Point) -> Space.Member boundary x -> Space.Member patch.domain x -> StrictAt patch.homotopy x,
};
\definition Local: \Prop := \forall (x: M.Point) -> Space.Member boundary x -> \exists ( p: Patch \where Space.Member p.patch.domain x );
\structure Result: \Set := {
  homotopy: Homotopies.Homotopy,
  strict: \forall (x: M.Point) -> Space.Member boundary x -> StrictAt homotopy x,
  active: \forall (x: M.Point) -> Space.Member boundary x -> Homotopies.Activates homotopy x,
};
\module Composition(first, second: Homotopies.Homotopy);
\module Compact(compact: Space.IsCompactIn M.space boundary, local: Local);
