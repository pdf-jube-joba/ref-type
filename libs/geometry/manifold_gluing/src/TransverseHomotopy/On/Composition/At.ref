\import Tangent.At[x := x] \as T;
\import T.Operations[] \as Operations;
\import T.Cones[] \as Cones;
\import Velocity.Of[h := first].At[x := x] \as First;
\import Velocity.Of[h := second].At[x := x] \as Second;
\import Velocity.Of[h := homotopy].At[x := x] \as Total;
\import \root.ConeAddition[n := n].On[M := M].At[x := x] \as ConesAdd;
\definition left: StrictAt first x -> StrictAt homotopy x := \fun (strict: _) =>
  \idelim Operations.plus First.value Second.value = Total.value \with v: T.Vector => Logic.Not (Cones.Tangential v) \by {
    base: ConesAdd.strictLeft First.value Second.value First.inward Second.inward strict,
    equality: sym!{{T.Vector}} _ _ Derivative.At[x := x].law
  };
\definition right: StrictAt second x -> StrictAt homotopy x := \fun (strict: _) =>
  \idelim Operations.plus First.value Second.value = Total.value \with v: T.Vector => Logic.Not (Cones.Tangential v) \by {
    base: ConesAdd.strictRight First.value Second.value First.inward Second.inward strict,
    equality: sym!{{T.Vector}} _ _ Derivative.At[x := x].law
  };
