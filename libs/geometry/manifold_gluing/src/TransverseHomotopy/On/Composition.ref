\import Homotopies.Composition[first := first, second := second] \as Composition;
\import \root.HomotopyCompositionVelocity[n := n].On[M := M].Of[first := first, second := second] \as Derivative;
\definition homotopy: Homotopies.Homotopy := Composition.homotopy;
\module At(x: M.Point);
\definition strictLeft: \forall (x: M.Point) -> StrictAt first x -> StrictAt homotopy x := \fun (x: M.Point) => At[x := x].left;
\definition strictRight: \forall (x: M.Point) -> StrictAt second x -> StrictAt homotopy x := \fun (x: M.Point) => At[x := x].right;
