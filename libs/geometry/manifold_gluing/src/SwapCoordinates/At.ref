\import Fin.Transposition[n := n, a := a, b := b] \as Indices;
\definition apply[x: Model.Point][i: Model.Coordinate]: S.Real := x (Indices.apply i);
\definition first: \forall (x: Model.Point) -> apply x a = x b := \fun (x: Model.Point) => congr!{{Model.Coordinate} S.Real} x _ _ Indices.onFirst;
\definition second: \forall (x: Model.Point) -> apply x b = x a := \fun (x: Model.Point) => congr!{{Model.Coordinate} S.Real} x _ _ Indices.onSecond;
\definition involution: \forall (x: Model.Point) -> apply (apply x) = x := \fun (x: Model.Point) => \axiom:funext(apply (apply x), x, \fun (i: Model.Coordinate) => congr!{{Model.Coordinate} S.Real} x _ _ (Indices.involution i));
\definition continuous: topology.Continuity[A := Model.Point, B := Model.Point].Continuous Ambient.topology Ambient.topology apply := \fun (U: \Pow Model.Point)(open: _) =>
  Universal.continuous Ambient.topology Line.topology apply (\fun (i: Model.Coordinate) => Ambient.coordinateContinuous (Indices.apply i)) U (Ambient.metricOpen U open);
\module On(U: Open.OpenSet);
