\definition V: Open.OpenSet := Open.Topology[].ofOpen ({ x: Model.Point \where \In[Model.Point] U.points (apply x) }) (continuous U.points (Open.Topology[].open U));
\definition forward[x: Open.Carrier U]: Open.Carrier V := \into[Model.Point](apply x, V.points) \by {
  \idelim (x \of Model.Point) = apply (apply x) \with y: Model.Point => \In[Model.Point] U.points y \by { base: \bysub(Model.Point, U.points, x), equality: sym!{{Model.Point}} _ _ (involution x) }
};
\definition backward[x: Open.Carrier V]: Open.Carrier U := \into[Model.Point](apply x, U.points) \by { \bysub(Model.Point, V.points, x) };
\definition forwardMap: Maps.Map U V := Maps.Map[U, V] { apply := forward, smooth := \fun (i: Model.Coordinate) => Open.Examples[].projectionSmooth U (Indices.apply i) };
\definition backwardMap: Maps.Map V U := Maps.Map[V, U] { apply := backward, smooth := \fun (i: Model.Coordinate) => Open.Examples[].projectionSmooth V (Indices.apply i) };
\definition data: Diffeomorphisms.Data[U, V] := Diffeomorphisms.Data[U, V] { forward := forwardMap, backward := backwardMap };
\definition diffeomorphism: Diffeomorphisms.Diffeomorphism U V := \into[Diffeomorphisms.Data[U, V]](data, Diffeomorphisms.Diffeomorphism U V) \by { Diffeomorphisms.Laws[U, V, data] {
  leftInverse := \fun (x: Open.Carrier U) => boundary_manifolds.Refinement[A := Model.Point].equality U.points (backward (forward x)) x (involution x),
  rightInverse := \fun (x: Open.Carrier V) => boundary_manifolds.Refinement[A := Model.Point].equality V.points (forward (backward x)) x (involution x),
} };
