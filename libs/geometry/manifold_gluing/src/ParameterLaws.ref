\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import calculus.Real[].OneDimension[] \as One;
\import boundary_manifolds.Model[n := One.dimension] \as Model;
\import \root.Parameter[] \as Time;
\definition equality: \forall (t, s: Time.Point) -> Time.value t = Time.value s -> t = s :=
  \fun (t, s: Time.Point)(same: _) => Model.equality Time.constraints Time.domain t s (\axiom:funext((t \of Model.Point), (s \of Model.Point),
    \fun (i: One.Index) => trans!{S.Real} _ _ _ (congr!{One.Index S.Real} (\fun (j: One.Index) => t j) _ _ (Fin.singletonValue i))
      (trans!{S.Real} _ _ _ same (sym!{S.Real} _ _ (congr!{One.Index S.Real} (\fun (j: One.Index) => s j) _ _ (Fin.singletonValue i))))));
\definition zero: \forall (t: Time.Point) -> Time.value t = S.zero -> t = Time.zero := \fun (t: Time.Point) => equality t Time.zero;
