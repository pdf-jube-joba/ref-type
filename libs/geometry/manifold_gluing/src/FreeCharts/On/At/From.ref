\definition constraints: c.constraints = Model.unconstrained := \bysub(T.Chart, { c: T.Chart \where c.constraints = Model.unconstrained }, c);
\definition nonnegative: \forall (u: Model.Point) -> Model.Nonnegative c.constraints u := \fun (u: Model.Point) => \idelim Model.unconstrained = c.constraints \with C: Model.Constraints => Model.Nonnegative C u \by { base: Model.unconstrainedNonnegative u, equality: sym!{{Model.Constraints}} _ _ constraints };
\definition noBoundary: Logic.Not T.Cones[].Boundary := \block {
  \fun (boundary: T.Cones[].Boundary) \then
  \takefrom i: \Cast[Model.Coordinate] ({ i: Model.Coordinate \where Model.Active c.constraints (T.coordinate c) i }) \by T.Cones[].coordinateOfBoundary c boundary \then
  \return \idelim c.constraints = Model.unconstrained \with C: Model.Constraints => \In[Model.Coordinate] C i \by { base: (\bysub(Model.Coordinate, { i: Model.Coordinate \where Model.Active c.constraints (T.coordinate c) i }, i)).left, equality: constraints }
};
