\import boundary_manifolds.SmoothMap[n := n, m := n].Between[M := M, N := M] \as Maps;
\import boundary_manifolds.Differential[n := n, m := n].Between[M := M, N := M] \as Differential;
\import boundary_manifolds.Tangent[n := n].On[M := M] \as Tangent;
\import boundary_manifolds.MapIdentity[n := n].On[M := M] \as Identity;
\import boundary_manifolds.DifferentialIdentity[n := n].On[M := M] \as DIdentity;
\import std.Logic[].Equality[].Transport[A := M.Point] \as Transport;
\module Of(f: Maps.Map, identity: \forall (x: M.Point) -> Maps.apply f x = x);
