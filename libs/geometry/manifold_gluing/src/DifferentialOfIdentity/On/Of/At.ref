\import Tangent.At[x := x] \as T;
\definition Property[g: Maps.Map]: \Prop := \forall (same: \forall (p: M.Point) -> Maps.apply g p = p)(v: T.Vector) ->
  Transport.cast Tangent.Vector (Maps.apply g x) x (same x) (Differential.At[f := g, x := x].value.apply v) = v;
\definition base: Property Identity.map := \fun (same: \forall (p: M.Point) -> Maps.apply Identity.map p = p)(v: T.Vector) => trans!{{T.Vector}} _ _ _
  (congr!{{T.Vector} {T.Vector}} (Transport.cast Tangent.Vector x x (same x)) _ _ (DIdentity.At[x := x].law v)) (Transport.castRefl Tangent.Vector x v);
\definition law: \forall (v: T.Vector) -> Transport.cast Tangent.Vector (Maps.apply f x) x (identity x) (Differential.At[f := f, x := x].value.apply v) = v :=
  (\idelim Identity.map = f \with g: Maps.Map => Property g \by { base: base, equality: equal }) identity;
