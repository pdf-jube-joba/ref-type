\import SourceCharts.At[x := x, left := left, right := chosen.left, inLeft := contains] \as First;
\import Maps.At[function := function, left := chosen.left, right := chosen.right, x := x, contains := (leftContains x chosen.left)] \as Middle;
\import TargetCharts.At[x := function x, left := chosen.right, right := right, inLeft := (rightContains (function x) chosen.right)] \as Last;
\import Maps.At[function := function, left := left, right := right, x := x, contains := contains] \as Result;
\module With(first: First.Extension, last: Last.Extension);
\definition existsExtension: \In[SourceCharts.Chart] M.atlas.charts left -> \In[TargetCharts.Chart] N.atlas.charts right -> \exists Result.Extension := \block {
  \fun (lm: _)(rm: _) \then
  \takefrom first: First.Extension \by M.atlas.compatible left chosen.left x contains (leftContains x chosen.left) lm (leftMember x chosen.left) \then
  \takefrom last: Last.Extension \by N.atlas.compatible chosen.right right (function x) (rightContains (function x) chosen.right) containsImage (rightMember (function x) chosen.right) rm \then
  \return \exact(With[first := first, last := last].extension, Result.Extension)
};
