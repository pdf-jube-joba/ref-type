\import \root.TransportInclusion[n := n].Between[M := M, N := N].On[U := U, open := open, h := h].With[member := member] \as Inclusion;
\import topology.Homeomorphism[A := M.Point, B := \Cast[N.Point] U] \as Homeos;
\module Of(f: Maps.Map, g: N.Point -> P.Point, agrees: \forall (p: M.Point) -> g (h.forward p) = Maps.apply f p);
