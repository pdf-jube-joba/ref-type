\import Inclusion.InverseAt[y := y] \as Inverse;
\definition function[p: N.Point]: P.Point := Maps.apply f (Inverse.function p);
\import \root.LocalSmoothMap[n := n, m := m].Between[M := N, N := P].Of[function := function] \as Local;
\import \root.LocalSmoothPostcompose[n := n, m := n, l := m].Between[M := N, N := M, P := P].From[f := Inverse.function, g := f] \as Composition;
\definition equal: \forall (p: N.Point) -> \In[N.Point] U p -> g p = function p := \block {
  \fun (p: N.Point)(member: _) \then
  \let z: \Cast[N.Point] U := \into[N.Point](p, U) \by { member } \then
  \return trans!{{P.Point}} _ _ _
    (congr!{{N.Point} {P.Point}} g _ _ (sym!{{N.Point}} _ _ ((Homeos.laws _ _ h).rightInverse z)))
    (trans!{{P.Point}} _ _ _ (agrees (h.backward z)) (congr!{{M.Point} {P.Point}} (Maps.apply f) _ _ (sym!{{M.Point}} _ _ (Inverse.inside z))))
};
\import \root.LocalSmoothTransfer[n := n, m := m].Between[M := N, N := P].From[f := g, g := function] \as Transfer;
\definition exists: \exists Destination.Witness[y] := \block {
  \takefrom inverse: Inverse.Witness \by Inverse.exists \then
  \takefrom composition: Local.Witness[y] \by Composition.At[x := (y \of N.Point), chosen := inverse].exists \then
  \return Transfer.At[x := (y \of N.Point), U := U, open := open, contains := \bysub(N.Point, U, y), agrees := equal, chosen := composition].exists
};
