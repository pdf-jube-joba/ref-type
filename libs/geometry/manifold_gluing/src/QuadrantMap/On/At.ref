\definition left: Local.SourceChart x := \into[SourceCharts.Chart](Source.chart, Local.SourceChart x) \by { Logic.And[_, _]::# (\refl(Source.chart)) (\refl(x)) };
\definition right: Local.TargetChart (function x) := \into[TargetCharts.Chart](Target.chart, Local.TargetChart (function x)) \by { Logic.And[_, _]::# (\refl(Target.chart)) (\refl(function x)) };
\import Maps.At[function := function, left := left, right := right, x := x, contains := Local.leftContains x left] \as Extension;
\definition extension: Extension.Extension := Extension.Extension {
  neighborhood := U, included := \fun (p: SourceModel.Point)(member: _) => member,
  contains := \bysub(SourceModel.Point, U.points, x), map := Corestriction.map,
  inside := \fun (u: SourceModel.Carrier C U) => \refl(function u),
  agrees := \fun (u: SourceModel.Carrier C U) => \refl(Calculus.apply U V f u \of TargetModel.Point),
};
\definition witness: Local.Witness[x] := Local.Witness[x] { left := left, right := right, extension := extension };
