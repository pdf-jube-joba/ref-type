\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import topology.Topology[Carrier := T] \as Parameters;
\import topology.Topology[Carrier := B] \as Base;
\import topology.Topology[Carrier := X] \as Target;
\import topological_constructions.Product[A := T, B := B] \as Product;
\definition Point: \Set := Product.CarrierSet;
\module On(parameterSpace: Parameters.Topology, baseSpace: Base.Topology, targetSpace: Target.Topology, zero: T, f: Point -> X);
