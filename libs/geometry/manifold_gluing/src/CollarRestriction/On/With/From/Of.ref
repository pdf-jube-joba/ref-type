\import \root.CollarEmbedding[n := n].On[M := M].With[cover := cover].From[deformation := deformation] \as Candidate;
\import \root.CollarEmbedding[n := n].On[M := M].With[cover := cover].From[deformation := deformation].Of[regular := regular] \as Collar;
\module Within(V: \Pow Product.Point, open: Space.IsOpenIn Product.topology V, inside: Space.Subset V Collar.domain);
