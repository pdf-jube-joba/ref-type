\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import topology.Topology[Carrier := A] \as Source;
\import topology.Topology[Carrier := B] \as Target;
\import topology.Maps[A := A, B := B] \as Maps;
\module On(source: Source.Topology, target: Target.Topology, f: A -> B,
  compact: Source.IsCompact source, hausdorff: Target.IsT2 target,
  continuous: topology.Continuity[A := A, B := B].Continuous source target f,
  injective: \forall (x, y: A) -> f x = f y -> x = y);
