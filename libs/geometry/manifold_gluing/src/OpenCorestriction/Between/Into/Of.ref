\definition function[x: M.Point]: Target.Point := \into[N.Point](Maps.apply f x, U) \by { inside x };
\import \root.LocalSmoothMap[n := n, m := m].Between[M := M, N := Target.manifold].Of[function := function] \as Local;
\import \root.LocalSmoothMap[n := n, m := m].Between[M := M, N := N].Of[function := Maps.apply f] \as SourceLocal;
\import boundary_manifolds.SmoothMap[n := n, m := m].Between[M := M, N := Target.manifold] \as Result;
\import \root.SmoothWitness[n := n, m := m].Between[M := M, N := N].Of[f := f] \as Witness;
\definition continuous: topology.Continuity[A := M.Point, B := Target.Point].Continuous M.space Target.topology function :=
  topology.Continuity[A := M.Point, B := N.Point].Corestriction[S := U].corestrictContinuous M.space N.space function f.continuous;
\module At(x: M.Point);
\definition local: \forall (x: M.Point) -> \exists Local.Witness[x] := \fun (x: M.Point) => At[x := x].exists;
\definition map: Result.Map := Local.map continuous local;
