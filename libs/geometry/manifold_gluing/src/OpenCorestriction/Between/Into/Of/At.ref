\import Target.Inclusion[].InverseAt[x := function x] \as Inverse;
\definition composite[p: M.Point]: Target.Point := Inverse.function (Maps.apply f p);
\import \root.LocalSmoothMap[n := n, m := m].Between[M := M, N := Target.manifold].Of[function := composite] \as CompositeLocal;
\import \root.LocalSmoothCompose[n := n, m := m, l := m].Between[M := M, N := N, P := Target.manifold].From[f := Maps.apply f, g := Inverse.function] \as Composition;
\import \root.LocalSmoothTransfer[n := n, m := m].Between[M := M, N := Target.manifold].From[f := function, g := composite] \as Transfer;
\definition agrees: \forall (p: M.Point) -> SourceSpace.Member SourceSpace.Whole p -> function p = composite p :=
  \fun (p: M.Point)(member: _) => sym!{Target.Point} _ _ (Inverse.inside (function p));
\definition exists: \exists Local.Witness[x] := \block {
  \takefrom first: SourceLocal.Witness[x] \by Witness.exists x \then
  \takefrom inverse: Inverse.Witness \by Inverse.exists \then
  \takefrom composite: CompositeLocal.Witness[x] \by Composition.At[x := x, chosen := first, next := inverse].exists \then
  \return Transfer.At[x := x, U := SourceSpace.Whole, open := (SourceSpace.topologyLaws M.space).wholeOpen, contains := \refl(x), agrees := agrees, chosen := composite].exists
};
