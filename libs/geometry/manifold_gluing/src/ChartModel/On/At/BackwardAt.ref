\definition left: BackwardLocal.SourceChart u := \into[TargetCharts.Chart](Target.chart, BackwardLocal.SourceChart u) \by { Logic.And[_, _]::# (\refl(Target.chart)) (\refl(u)) };
\definition right: BackwardLocal.TargetChart (backward u) := \into[Charts.Chart](c, BackwardLocal.TargetChart (backward u)) \by { Logic.And[_, _]::# member (covers (backward u)) };
\import Backward.At[function := backward, left := left, right := right, x := u, contains := BackwardLocal.leftContains u left] \as Extension;
\definition extension: Extension.Extension := Extension.Extension {
  neighborhood := c.image, included := \fun (u: Model.Point)(member: _) => member,
  contains := \bysub(Model.Point, c.image.points, Extension.source), map := identity,
  inside := \fun (u: Target.Point) => covers (backward u),
  agrees := \fun (u: Target.Point) => sym!{Model.Point} _ _ (congr!{{Target.Point} {Model.Point}} (\fun (v: Target.Point) => v) _ _ (rightInverse u)),
};
\definition witness: BackwardLocal.Witness[u] := BackwardLocal.Witness[u] { left := left, right := right, extension := extension };
