\definition left: ForwardLocal.SourceChart x := \into[Charts.Chart](c, ForwardLocal.SourceChart x) \by { Logic.And[_, _]::# member (covers x) };
\definition right: ForwardLocal.TargetChart (forward x) := \into[TargetCharts.Chart](Target.chart, ForwardLocal.TargetChart (forward x)) \by { Logic.And[_, _]::# (\refl(Target.chart)) (\refl(forward x)) };
\import Forward.At[function := forward, left := left, right := right, x := x, contains := ForwardLocal.leftContains x left] \as Extension;
\definition output[u: Target.Point]: TargetCharts.LocalPoint Target.chart := \into[Target.Point](forward (Charts.point c u), Target.chart.domain) \by { \refl(forward (Charts.point c u)) };
\definition extension: Extension.Extension := Extension.Extension {
  neighborhood := c.image, included := \fun (u: Model.Point)(member: _) => member,
  contains := \bysub(Model.Point, c.image.points, Extension.source), map := identity,
  inside := \fun (u: Target.Point) => \refl(forward (Charts.point c u)),
  agrees := \fun (u: Target.Point) => sym!{Model.Point} _ _ (congr!{{Target.Point} {Model.Point}} (\fun (u: Target.Point) => u) _ _ (rightInverse u)),
};
\definition witness: ForwardLocal.Witness[x] := ForwardLocal.Witness[x] { left := left, right := right, extension := extension };
