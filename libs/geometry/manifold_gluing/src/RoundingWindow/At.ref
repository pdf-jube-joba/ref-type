\import Open.Smooth[].Algebra[U := domain] \as F;
\import boundary_manifolds.Differentiation[n := Rounded.dimension].On[U := domain] \as Differentiation;
\module Normal(i: Model.Coordinate, constrained: \In[Model.Coordinate] Quarter.constraints i);
\definition firstConstrained: \In[Model.Coordinate] Quarter.constraints Rounded.firstNormal := Logic.Or[Rounded.firstNormal = Rounded.firstNormal, Rounded.firstNormal = Rounded.secondNormal]::left (\refl(Rounded.firstNormal));
\definition secondConstrained: \In[Model.Coordinate] Quarter.constraints Rounded.secondNormal := Logic.Or[Rounded.secondNormal = Rounded.firstNormal, Rounded.secondNormal = Rounded.secondNormal]::right (\refl(Rounded.secondNormal));
\import Normal[i := Rounded.firstNormal, constrained := firstConstrained] \as Left;
\import Normal[i := Rounded.secondNormal, constrained := secondConstrained] \as Right;
\definition leftMap: boundary_manifolds.SmoothMap[n := Rounded.dimension, m := One.dimension].Between[M := Window.manifold, N := Time.manifold].Map :=
  boundary_manifolds.MapComposition[n := Rounded.dimension, m := Rounded.dimension, l := One.dimension].Between[M := Window.manifold, N := QuarterWindow.manifold, P := Time.manifold].Of[f := QuarterFactor.map, g := Left.map].map;
\definition rightMap: boundary_manifolds.SmoothMap[n := Rounded.dimension, m := One.dimension].Between[M := Window.manifold, N := Time.manifold].Map :=
  boundary_manifolds.MapComposition[n := Rounded.dimension, m := Rounded.dimension, l := One.dimension].Between[M := Window.manifold, N := QuarterWindow.manifold, P := Time.manifold].Of[f := QuarterFactor.map, g := Right.map].map;
