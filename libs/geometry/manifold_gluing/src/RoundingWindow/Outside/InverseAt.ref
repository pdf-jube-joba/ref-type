\import Source.Inclusion[].InverseAt[x := x] \as Inverse;
\definition function[p: QuarterWindow.Point]: Window.Point := Maps.apply map (Inverse.function p);
\import \root.LocalSmoothMap[n := Rounded.dimension, m := Rounded.dimension].Between[M := QuarterWindow.manifold, N := Window.manifold].Of[function := function] \as Local;
\import \root.LocalSmoothPostcompose[n := Rounded.dimension, m := Rounded.dimension, l := Rounded.dimension].Between[M := QuarterWindow.manifold, N := Source.manifold, P := Window.manifold].From[f := Inverse.function, g := map] \as Compose;
\definition exists: \exists Local.Witness[x] := \block {
  \takefrom inverse: Inverse.Witness \by Inverse.exists \then
  \return Compose.At[x := (x \of QuarterWindow.Point), chosen := inverse].exists
};
\definition inside: \forall (p: Source.Point) -> function p = Maps.apply map p := \fun (p: Source.Point) => congr!{{Source.Point} {Window.Point}} (Maps.apply map) _ _ (Inverse.inside p);
