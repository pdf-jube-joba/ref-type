\definition law: Right.Member V y := \block {
  \takefrom c: \Cast[C] ({ c: C \where Logic.And[x = u c, y = v c] }) \by Embedded.crossOfEqual x y same \then
  \let endpoints: Logic.And[x = u c, y = v c] := \bysub(C, { c: C \where Logic.And[x = u c, y = v c] }, c) \then
  \return \idelim v c = y \with p: B => Right.Member V p \by {
    base: (matched c).ltr (\idelim x = u c \with q: A => Left.Member U q \by { base: member, equality: endpoints.left }),
    equality: sym!{B} _ _ endpoints.right
  }
};
