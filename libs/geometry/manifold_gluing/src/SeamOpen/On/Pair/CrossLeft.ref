\definition law: Left.Member U x := \block {
  \takefrom c: \Cast[C] ({ c: C \where Logic.And[x = u c, y = v c] }) \by Embedded.crossOfEqual x y same \then
  \let endpoints: Logic.And[x = u c, y = v c] := \bysub(C, { c: C \where Logic.And[x = u c, y = v c] }, c) \then
  \return \idelim u c = x \with p: A => Left.Member U p \by {
    base: (matched c).rtl (\idelim y = v c \with q: B => Right.Member V q \by { base: member, equality: endpoints.right }),
    equality: sym!{A} _ _ endpoints.left
  }
};
