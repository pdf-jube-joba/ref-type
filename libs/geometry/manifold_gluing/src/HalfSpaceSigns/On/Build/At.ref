\import Linear.Neighborhood[U := domain, a := point].At[rho := rho, ball := ball] \as Rectangle;
\definition neighborhood: Open.OpenSet := Blocks.product Rectangle.parameters Rectangle.values;
\definition inclusion: Open.Included neighborhood U := \fun (x: Point)(member: _) => included x (Rectangle.included x member);
\definition contains: \In[Point] neighborhood.points a := Logic.And[_, _]::# Rectangle.rectangle.containsLeft Rectangle.rectangle.containsRight;
\definition valuePositive: \forall (x: Open.Carrier neighborhood) -> R.Lt S.zero (partial (Open.inclusion neighborhood U inclusion x)) :=
  \fun (x: Open.Carrier neighborhood) => \root.HalfSpaceSigns[n := n].On[U := U, f := f, a := a, zeroNormal := zeroNormal, fixed := fixed].Build[positive := positive].valuePositive
    (Open.inclusion neighborhood domain Rectangle.included x);
\module Point(u: Open.Carrier neighborhood);
\definition patch: Patch := Patch {
  domain := neighborhood, included := inclusion, contains := contains,
  nonnegative := \fun (u: Open.Carrier neighborhood) => Point[u := u].nonnegative,
  vanishes := \fun (u: Open.Carrier neighborhood) => Point[u := u].vanishes,
};
