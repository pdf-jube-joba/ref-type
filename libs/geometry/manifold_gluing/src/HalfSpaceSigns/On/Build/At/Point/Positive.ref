\definition lower[s: Increasing.Closed S.zero t]: R.Le (Metric.min S.zero t) s := R.leTrans _ S.zero _ (Metric.minLeft S.zero t)
  (\bysub(S.Real, metric_spaces.RealLine[].ClosedInterval S.zero t, s)).left;
\definition upper[s: Increasing.Closed S.zero t]: R.Le s (Metric.max S.zero t) := R.leTrans _ t _
  (\bysub(S.Real, metric_spaces.RealLine[].ClosedInterval S.zero t, s)).right (Metric.maxRight S.zero t);
\definition contains: Increasing.Within S.zero t := \fun (s: Increasing.Closed S.zero t) => inclusion _ (curveInside s (lower s) (upper s));
\definition positiveSamples: Increasing.Positive S.zero t contains := \fun (s: Increasing.Closed S.zero t) => valuePositive (sample s (lower s) (upper s));
\import Increasing.Interval[left := S.zero, right := t, contains := contains, positive := positiveSamples] \as Interval;
\definition result: R.Lt S.zero output := R.ltReplaceRight S.zero (Section.value t) output timeValue
  (R.ltReplaceLeft (Section.value S.zero) S.zero (Section.value t) zeroValue (Interval.strictly positive));
