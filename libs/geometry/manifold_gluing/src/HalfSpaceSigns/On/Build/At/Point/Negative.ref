\definition lower[s: Increasing.Closed t S.zero]: R.Le (Metric.min S.zero t) s := R.leTrans _ t _ (Metric.minRight S.zero t)
  (\bysub(S.Real, metric_spaces.RealLine[].ClosedInterval t S.zero, s)).left;
\definition upper[s: Increasing.Closed t S.zero]: R.Le s (Metric.max S.zero t) := R.leTrans _ S.zero _
  (\bysub(S.Real, metric_spaces.RealLine[].ClosedInterval t S.zero, s)).right (Metric.maxLeft S.zero t);
\definition contains: Increasing.Within t S.zero := \fun (s: Increasing.Closed t S.zero) => inclusion _ (curveInside s (lower s) (upper s));
\definition positiveSamples: Increasing.Positive t S.zero contains := \fun (s: Increasing.Closed t S.zero) => valuePositive (sample s (lower s) (upper s));
\import Increasing.Interval[left := t, right := S.zero, contains := contains, positive := positiveSamples] \as Interval;
\definition result: R.Lt output S.zero := R.ltReplaceLeft (Section.value t) output S.zero timeValue
  (R.ltReplaceRight (Section.value t) (Section.value S.zero) S.zero zeroValue (Interval.strictly negative));
