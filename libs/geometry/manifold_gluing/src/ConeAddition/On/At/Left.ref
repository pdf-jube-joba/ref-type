\import Space.Coordinate[chart := c] \as Coordinates;
\definition zero: \forall (tangent: Cones.Tangential (Operations.plus u v))(i: Core.Coordinate) -> Core.Active c.constraints (Space.coordinate c) i -> S.add (Coordinates.decode u i) (Coordinates.decode v i) = S.zero :=
  \fun (tangent: _)(i: Core.Coordinate)(active: _) => trans!{S.Real} _ _ _
    (sym!{S.Real} _ _ (congr!{Core.Point S.Real} (\fun (w: Core.Point) => w i) _ _ (Space.CoordinateOperations[chart := c].addition u v)))
    (Cones.Lineality[c := c, v := Operations.plus u v].fromIntrinsic tangent i active);
\definition law: Cones.Tangential (Operations.plus u v) -> Core.Tangential c.constraints (Space.coordinate c) (Coordinates.decode u) :=
  \fun (tangent: _)(i: Core.Coordinate)(active: _) => R.leAntisym (Coordinates.decode u i) S.zero
    (R.leReplaceRight _ (S.add (Coordinates.decode u i) (Coordinates.decode v i)) S.zero (zero tangent i active)
      (R.leReplaceLeft (S.add (Coordinates.decode u i) S.zero) (Coordinates.decode u i) _ (Laws.addZeroRight _)
        (Laws.addMonotoneLeft S.zero (Coordinates.decode v i) (Coordinates.decode u i) (right c i active))))
    (left c i active);
