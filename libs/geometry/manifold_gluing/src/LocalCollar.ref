\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import dedekind_reals.DedekindReal[] \as R;
\import calculus.Real[].OneDimension[] \as One;
\import calculus.Blocks[n := n, m := One.dimension] \as Blocks;
\import inverse_implicit.Product[n := n, m := One.dimension] \as Product;
\import boundary_manifolds.Boundary[n := n] \as Boundary;
\definition dimension: N.Nat^ := Boundary.dimension;
\import boundary_manifolds.Dimension[n := std.Data[].Nat[].Basic[].Def[].add One.dimension n] \as Models;
\import boundary_manifolds.Model[n := dimension] \as Model;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Open;
\import calculus.Real[].Multivariable[n := n].Open[] \as Parameters;
\import calculus.Real[].Multivariable[n := One.dimension].Open[] \as Time;
\definition ParameterPoint: \Set := Fin.Fin n -> S.Real;
\definition TimePoint: \Set := One.Index -> S.Real;
\definition zero: TimePoint := \fun (i: One.Index) => S.zero;
\module On(M: Models.Manifold);
