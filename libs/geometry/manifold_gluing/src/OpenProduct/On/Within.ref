\import Left.Subspace[S := U] \as L;
\import Right.Subspace[S := V] \as R;
\definition image: \Pow Target.CarrierSet := Target.Rectangle U V;
\definition open: topology.Topology[Carrier := Target.CarrierSet].IsOpenIn (Target.topology left right) image := topology.Topology[Carrier := Target.CarrierSet].generatedBasisOpen (Target.Basis left right) image (Target.Universal[X := Target.CarrierSet].rectangleBasisMember left right U V openU openV);
\import topology.Topology[Carrier := Target.CarrierSet].Subspace[S := image] \as Image;
\module Through(h: topology.Homeomorphism[A := X, B := L.CarrierSet].Homeomorphism[first, L.topology left], k: topology.Homeomorphism[A := Y, B := R.CarrierSet].Homeomorphism[second, R.topology right]);
