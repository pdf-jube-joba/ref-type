\import std.Data[].Nat[] \as Nat;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import S.Distance[] \as Metric;
\import S.Estimates[] \as Bounds;
\import Bounds.Product[] \as Estimates;
\import dedekind_reals.DedekindReal[] \as R;
\import calculus.Real[].OneDimension[] \as One;
\import calculus.Real[].Multivariable[n := One.dimension].Open[] \as Open;
\import boundary_manifolds.Model[n := One.dimension] \as Model;
\import topological_algebra.Euclidean[].Dimension[n := One.dimension].Def[] \as Coordinates;
\import \root.Parameter[] \as Time;
\import \root.NormalCoordinate[n := One.dimension] \as Normal;
\definition constant: \forall (t: Time.Point) -> (t \of Model.Point) = Normal.constant (Time.value t) :=
  \fun (t: Time.Point) => \axiom:funext((t \of Model.Point), Normal.constant (Time.value t),
    \fun (i: One.Index) => congr!{One.Index S.Real} (\fun (j: One.Index) => t j) _ _ (Fin.singletonValue i));
\definition distanceZero: \forall (t: Time.Point) -> Coordinates.pointDistance t Time.zero = Time.value t :=
  \fun (t: Time.Point) => trans!{S.Real} _ _ _
    (congr!{Model.Point S.Real} (\fun (u: Model.Point) => Coordinates.pointDistance u Time.zero) _ _ (constant t))
    (trans!{S.Real} _ _ _ (Normal.constantDistance (Time.value t) S.zero)
      (trans!{S.Real} _ _ _ (Metric.distanceSymmetric (Time.value t) S.zero) (Estimates.absOfNonnegative (Time.value t) (Time.nonnegative t))));
\import topology.Topology[Carrier := Time.Point] \as Space;
\module In(W: \Pow Time.Point, open: Space.IsOpenIn Time.manifold.space W, contains: Space.Member W Time.zero);
