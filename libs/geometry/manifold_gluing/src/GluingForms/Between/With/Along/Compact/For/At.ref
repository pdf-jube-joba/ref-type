
\definition point: Source.Point := Pair.pair LeftBoundary.manifold.Point Signed.Point b Signed.zero;
\import boundary_manifolds.Tangent[n := n].On[M := LeftBoundary.manifold].At[x := b] \as Base;
\import boundary_manifolds.Tangent[n := One.dimension].On[M := Signed.manifold].At[x := Signed.zero] \as TimeTangent;
\import boundary_manifolds.Dimension[n := One.dimension].Quadrant[C := boundary_manifolds.Model[n := One.dimension].unconstrained, U := Signed.domain] \as Line;
\import boundary_manifolds.Dimension[n := One.dimension].Chart[M := Signed.Point, space := Signed.manifold.space] \as LineCharts;
\definition timeChart: TimeTangent.Chart := \into[LineCharts.Chart](Line.chart, TimeTangent.Chart) \by { TimeTangent.ChartLaws[Line.chart] { member := \refl(Line.chart), contains := \refl(Signed.zero) } };
\import boundary_manifolds.Tangent[n := Nat.add One.dimension n].On[M := Source.manifold].At[x := point] \as SourceTangent;
\import boundary_manifolds.Tangent[n := Nat.add One.dimension n].On[M := manifold].At[x := SeamMaps.apply result.seam point] \as Target;
\import boundary_manifolds.Differential[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := Source.manifold, N := manifold].At[f := result.seam, x := point] \as D;
\module In(c: Base.Chart);
