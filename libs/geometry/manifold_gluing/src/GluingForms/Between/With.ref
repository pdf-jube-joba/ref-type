
\import \root.BoundaryInclusion[n := n].On[M := M].With[cover := leftCover] \as LeftBoundary;
\import \root.BoundaryInclusion[n := n].On[M := N].With[cover := rightCover] \as RightBoundary;
\import \root.Diffeomorphism[n := n, m := n].Between[M := LeftBoundary.manifold, N := RightBoundary.manifold] \as Diffeomorphisms;
\module Along(d: Diffeomorphisms.Diffeomorphism);
