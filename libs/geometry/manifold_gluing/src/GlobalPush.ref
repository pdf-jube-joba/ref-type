\import std.Data[].Nat[] \as N;
\import N.Basic[].Def[] \as Nat;
\import std.Data[].Pair[] \as Pair;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import R.Order[] \as Order;
\import calculus.Real[].OneDimension[] \as One;
\definition dimension: N.Nat^ := Nat.add One.dimension n;
\import boundary_manifolds.Dimension[n := Nat.add One.dimension n] \as Models;
\import boundary_manifolds.Model[n := dimension] \as Model;
\import boundary_manifolds.Boundary[n := n] \as Boundary;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Open;
\import smooth_partitions.Euclidean[n := dimension] \as Functions;
\import \root.Parameter[] \as Time;
\module On(M: Models.Manifold);
