\module From(deformation: Transverse.Result);
\structure Construction: \Set := {
  deformation: Transverse.Result,
  result: From[deformation := deformation].Result,
};
\import \root.GlobalPush[n := n].On[M := M] \as Push;
\definition exists[compact: Target.IsCompact M.space]: \exists Construction := \block {
  \takefrom deformation: Transverse.Result \by Push.existsTransverse cover compact \then
  \takefrom result: From[deformation := deformation].Result \by From[deformation := deformation].exists compact \then
  \return \exact(Construction { deformation := deformation, result := result }, Construction)
};
