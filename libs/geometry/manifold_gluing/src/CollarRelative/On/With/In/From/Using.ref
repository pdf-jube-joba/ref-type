\import Source.Compactness[] \as Tubes;
\import topology.Topology[Carrier := Inclusion.manifold.Point] \as Base;
\module With(tube: Tubes.Tube[Time.manifold.space, Time.zero, preimage, Base.Whole]);
\definition exists: \exists Result := \block {
  \takefrom tube: Tubes.Tube[Time.manifold.space, Time.zero, preimage, Base.Whole]
    \by Tubes.tubeLemma Time.manifold.space Inclusion.manifold.space Base.Whole (Strips.compact compact) Time.zero preimage
      (Strip.continuous U open) (\fun (b: Inclusion.manifold.Point)(whole: _) => fibre b) \then
  \return \exact(With[tube := tube].result, Result)
};
