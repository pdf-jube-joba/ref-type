\import topology.Topology[Carrier := Time.Point] \as Parameters;
\definition neighborhood: \Pow Time.Point := Parameters.Intersection regular.uniform.neighborhood tube.neighborhood;
\import \root.CompactStrip[T := Time.Point, B := Inclusion.manifold.Point, X := M.Point].On[
  parameterSpace := Time.manifold.space, baseSpace := Inclusion.manifold.space, targetSpace := M.space, zero := Time.zero, f := Strip.apply] \as Uniforms;
\definition result: Result := Result {
  regular := Strip.RegularUniform {
    uniform := Uniforms.Uniform {
      neighborhood := neighborhood,
      open := (Parameters.topologyLaws Time.manifold.space).intersectionOpen regular.uniform.neighborhood tube.neighborhood regular.uniform.open tube.open,
      contains := Logic.And[_, _]::# regular.uniform.contains tube.contains,
      injective := \fun (t, s: Time.Point)(b, c: Inclusion.manifold.Point)(left: _)(right: _) => regular.uniform.injective t s b c left.left right.left,
    },
    regular := \fun (t: Time.Point)(b: Inclusion.manifold.Point)(member: _) => regular.regular t b member.left,
  },
  within := \fun (t: Time.Point)(b: Inclusion.manifold.Point)(member: _) => tube.within t member.right b (\refl(b)),
};
