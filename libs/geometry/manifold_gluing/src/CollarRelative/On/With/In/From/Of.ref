\import \root.CollarEmbedding[n := n].On[M := M].With[cover := cover].From[deformation := deformation].Of[regular := result.regular] \as Collar;
\definition imageWithin: TargetSpace.Subset Collar.image U := \block {
  \fun (y: M.Point)(member: TargetSpace.Member Collar.image y) \then
  \takefrom x: \Cast[Collar.Point] ({ x: Collar.Point \where Maps.apply Candidate.neighborhood.map x = y }) \by member \then
  \return \idelim Maps.apply Candidate.neighborhood.map x = y \with p: M.Point => TargetSpace.Member U p \by {
    base: result.within (Product.second x) (Product.first x) (\bysub(Product.Point, Collar.domain, x)),
    equality: \bysub(Collar.Point, { x: Collar.Point \where Maps.apply Candidate.neighborhood.map x = y }, x)
  }
};
