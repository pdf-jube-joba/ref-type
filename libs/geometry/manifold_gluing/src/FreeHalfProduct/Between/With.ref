
\module At(x: Product.Point, c: Free.At[x := Product.first x].Witness, d: Half.Data, member: Half.Contains d (Product.second x));
\definition cover: Result.Cover := \block {
 \fun (x: Product.Point)(boundary: boundary_manifolds.Tangent[n := Nat.add m n].On[M := Product.manifold].At[x := x].Cones[].Boundary) \then
 \takefrom c: Free.At[x := Product.first x].Witness \by leftCover (Product.first x) \then
 \let rightBoundary: boundary_manifolds.Tangent[n := m].On[M := N].At[x := Product.second x].Cones[].Boundary := Logic.orElim _ _ _ (Product.At[x := x].boundaryCriterion.ltr boundary)
  (\fun (left: boundary_manifolds.Tangent[n := n].On[M := M].At[x := Product.first x].Cones[].Boundary) => Logic.falseElim _ (Free.At[x := Product.first x].From[c := c].noBoundary left))
  (\fun (right: boundary_manifolds.Tangent[n := m].On[M := N].At[x := Product.second x].Cones[].Boundary) => right) \then
 \takefrom d: \Cast[Half.Data] ({ d: Half.Data \where Half.Contains d (Product.second x) }) \by rightCover (Product.second x) rightBoundary \then
 \return At[x := x, c := c, d := d, member := \bysub(Half.Data, { d: Half.Data \where Half.Contains d (Product.second x) }, d)].exists
};
