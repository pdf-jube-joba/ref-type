\import std.Logic[].Proposition[] \as Logic;
\import boundary_manifolds.Dimension[n := n] \as Sources;
\import boundary_manifolds.Dimension[n := m] \as Targets;
\import boundary_manifolds.Model[n := n] \as SourceModel;
\import boundary_manifolds.Model[n := m] \as TargetModel;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import calculus.Real[].Multivariable[n := m].Open[] \as Output;
\import calculus.Maps[n := n, m := m] \as Calculus;
\module On(C: SourceModel.Constraints, D: TargetModel.Constraints, U: Open.OpenSet, V: Output.OpenSet, f: Calculus.Map U V,
  nonnegative: \forall (x: SourceModel.Carrier C U) -> TargetModel.Nonnegative D (Calculus.apply U V f x));
