\import \root.SignedParameter[].At[epsilon := epsilon, positive := positive, bounded := bounded] \as Signed;
\import Signed.SmallTimes[] \as Small;
\import Models.Quadrant[C := Model.unconstrained, U := Signed.domain] \as Construction;
\import Models.Chart[M := Time.Point, space := Time.manifold.space] \as SourceCharts;
\import Models.Chart[M := Signed.Point, space := Signed.manifold.space] \as TargetCharts;
\import std.Set[].Extension[A := Time.Point, B := Signed.Point, domain := Small.points] \as Extend;
\module Positive;
\module Negative;
\definition upper: Open.OpenSet := Open.Topology[].ofOpen ({ u: Model.Point \where R.Lt (u One.index) epsilon })
  (Ambient.coordinateContinuous One.index (Rays.Below epsilon) (Rays.belowOpen epsilon));
\definition neighborhood: Open.OpenSet := Open.intersection Time.domain upper;
\definition included: Open.Included neighborhood Time.domain := Open.intersectionLeft Time.domain upper;
\definition original[u: Model.Carrier Time.constraints neighborhood]: Time.Point :=
  \into[Open.Carrier Time.domain](Open.inclusion neighborhood Time.domain included u, Model.region Time.constraints Time.domain) \by {
    \bysub(Open.Carrier neighborhood, Model.region Time.constraints neighborhood, u)
  };
\definition small: \forall (u: Model.Carrier Time.constraints neighborhood) -> R.Lt (Time.value (original u)) epsilon :=
  \fun (u: Model.Carrier Time.constraints neighborhood) => (\bysub(Model.Point, neighborhood.points, u)).right;
\definition smallInput[u: Model.Carrier Time.constraints neighborhood]: Small.Point := \into[Time.Point](original u, Small.points) \by { small u };
