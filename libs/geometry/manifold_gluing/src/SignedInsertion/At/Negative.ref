\definition function: Time.Point -> Signed.Point := Extend.extend Small.negative Signed.zero;
\definition inside: \forall (t: Small.Point) -> function t = Small.negative t := Extend.inside Small.negative Signed.zero;
\import \root.LocalSmoothMap[n := One.dimension, m := One.dimension].Between[M := Time.manifold, N := Signed.manifold].Of[function := function] \as Locality;
\import boundary_manifolds.SmoothMap[n := One.dimension, m := One.dimension].Between[M := Time.manifold, N := Signed.manifold] \as Maps;
\module At(t: Small.Point);
