\import boundary_manifolds.Product[n := n, m := m].Of[M := M, N := N] \as Source;
\import boundary_manifolds.Product[n := p, m := q].Of[M := P, N := Q] \as Target;
\import \root.ProductMaps[n := n, m := m].Of[M := M, N := N] \as Projections;
\import boundary_manifolds.SmoothMap[n := Nat.add m n, m := n].Between[M := Source.manifold, N := M] \as FirstMaps;
\import boundary_manifolds.SmoothMap[n := Nat.add m n, m := m].Between[M := Source.manifold, N := N] \as SecondMaps;
\import \root.SmoothWitness[n := Nat.add m n, m := n].Between[M := Source.manifold, N := M].Of[f := Projections.First[].map] \as FirstWitness;
\import \root.SmoothWitness[n := Nat.add m n, m := m].Between[M := Source.manifold, N := N].Of[f := Projections.Second[].map] \as SecondWitness;
\module Of(f: M.Point -> P.Point, g: N.Point -> Q.Point);
