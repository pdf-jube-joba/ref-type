\definition first[x: Source.Point]: P.Point := f (Source.first x);
\definition second[x: Source.Point]: Q.Point := g (Source.second x);
\definition function[x: Source.Point]: Target.Point := Pair.pair P.Point Q.Point (first x) (second x);
\import \root.LocalSmoothMap[n := n, m := p].Between[M := M, N := P].Of[function := f] \as FirstLocal;
\import \root.LocalSmoothMap[n := m, m := q].Between[M := N, N := Q].Of[function := g] \as SecondLocal;
\import \root.LocalSmoothMap[n := Nat.add m n, m := p].Between[M := Source.manifold, N := P].Of[function := first] \as LiftFirst;
\import \root.LocalSmoothMap[n := Nat.add m n, m := q].Between[M := Source.manifold, N := Q].Of[function := second] \as LiftSecond;
\import \root.LocalSmoothMap[n := Nat.add m n, m := Nat.add q p].Between[M := Source.manifold, N := Target.manifold].Of[function := function] \as Destination;
\module At(x: Source.Point, first: FirstLocal.Witness[Source.first x], second: SecondLocal.Witness[Source.second x]);
