\import \root.LocalSmoothCompose[n := Nat.add m n, m := n, l := p].Between[M := Source.manifold, N := M, P := P].From[f := Source.first, g := f] \as FirstComposition;
\import \root.LocalSmoothCompose[n := Nat.add m n, m := m, l := q].Between[M := Source.manifold, N := N, P := Q].From[f := Source.second, g := g] \as SecondComposition;
\import \root.LocalSmoothMap[n := Nat.add m n, m := n].Between[M := Source.manifold, N := M].Of[function := Source.first] \as ProjectionFirst;
\import \root.LocalSmoothMap[n := Nat.add m n, m := m].Between[M := Source.manifold, N := N].Of[function := Source.second] \as ProjectionSecond;
\definition exists: \exists Destination.Witness[x] := \block {
  \takefrom a: ProjectionFirst.Witness[x] \by FirstWitness.exists x \then
  \takefrom b: ProjectionSecond.Witness[x] \by SecondWitness.exists x \then
  \takefrom c: LiftFirst.Witness[x] \by FirstComposition.At[x := x, chosen := a, next := first].exists \then
  \takefrom d: LiftSecond.Witness[x] \by SecondComposition.At[x := x, chosen := b, next := second].exists \then
  \return \root.LocalSmoothPair[n := p, m := q].Of[M := P, N := Q].From[p := Nat.add m n].On[P := Source.manifold].Using[
    f := \root.ProductLocalMap[n := n, m := m, p := p, q := q].Between[M := M, N := N, P := P, Q := Q].Of[f := f, g := g].first,
    g := \root.ProductLocalMap[n := n, m := m, p := p, q := q].Between[M := M, N := N, P := P, Q := Q].Of[f := f, g := g].second].At[x := x, first := c, second := d].exists
};
