\import boundary_manifolds.SmoothMap[n := n, m := m].Between[M := M, N := N] \as Forward;
\import boundary_manifolds.SmoothMap[n := m, m := n].Between[M := N, N := M] \as Backward;
\import boundary_manifolds.Tangent[n := n].On[M := M] \as Source;
\import boundary_manifolds.Tangent[n := m].On[M := N] \as Target;
\module From(f: Forward.Map, g: Backward.Map, inverse: \forall (x: M.Point) -> Backward.apply g (Forward.apply f x) = x);
