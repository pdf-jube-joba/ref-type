\import boundary_manifolds.Tangent[n := n].On[M := M] \as Tangent;
\import std.Logic[].Equality[].Transport[A := M.Point] \as Transport;
\definition Inward[x: M.Point][v: Tangent.Vector x]: \Prop := Tangent.At[x := x].Cones[].Inward v;
\definition Tangential[x: M.Point][v: Tangent.Vector x]: \Prop := Tangent.At[x := x].Cones[].Tangential v;
\definition Boundary[x: M.Point]: \Prop := Tangent.At[x := x].Cones[].Boundary;
\module Along(x, y: M.Point, same: x = y);
