\import Tangent.Transport[x := x, y := y, same := same] \as Vectors;
\definition inward: \forall (v: Tangent.Vector x) -> Inward x v -> Inward y (Vectors.vector v) := \fun (v: Tangent.Vector x)(member: Inward x v) =>
  Transport.predicate Tangent.Vector Inward x y same v member;
\definition tangential: \forall (v: Tangent.Vector x) -> Tangential x v -> Tangential y (Vectors.vector v) := \fun (v: Tangent.Vector x)(member: Tangential x v) =>
  Transport.predicate Tangent.Vector Tangential x y same v member;
\definition boundary: Boundary x -> Boundary y := \fun (member: Boundary x) => \idelim x = y \with p: M.Point => Boundary p \by { base: member, equality: same };
