\definition domain: \Pow Source.CarrierSet := { p: Source.CarrierSet \where \In[Product.Point] patch.domain (swap p) };
\definition open: topology.Topology[Carrier := Source.CarrierSet].IsOpenIn source domain := swapContinuous patch.domain patch.open;
\definition contains: \In[Source.CarrierSet] domain (Pair.pair Time.Point Inclusion.manifold.Point Time.zero b) := patch.contains;
\definition injective: \forall (x, y: Source.CarrierSet) -> \In[Source.CarrierSet] domain x -> \In[Source.CarrierSet] domain y -> apply x = apply y -> x = y := \block {
  \fun (x, y: Source.CarrierSet)(left: _)(right: _)(same: _) \then
  \let equal: swap x = swap y := patch.injective (swap x) (swap y) left right same \then
  \return Pair.Prop[A := Time.Point, B := Inclusion.manifold.Point].ext x y
    (congr!{{Product.Point} Time.Point} Product.second _ _ equal)
    (congr!{{Product.Point} Inclusion.manifold.Point} Product.first _ _ equal)
};
\definition patch: Strip.Patch := Strip.Patch { domain := domain, open := open, injective := injective };
