\definition preimage: \Pow Source.CarrierSet := { p: Source.CarrierSet \where ProductSpace.Member region (swap p) };
\import Source.Compactness[] \as Tubes;
\module Using(tube: Tubes.Tube[Time.manifold.space, Time.zero, preimage, Base.Whole]);
\definition exists: \exists RegularUniform := \block {
  \takefrom tube: Tubes.Tube[Time.manifold.space, Time.zero, preimage, Base.Whole]
    \by Tubes.tubeLemma Time.manifold.space Inclusion.manifold.space Base.Whole (compact compactM) Time.zero preimage
      (swapContinuous region regionOpen) (\fun (b: Inclusion.manifold.Point)(whole: _) => centerMember b) \then
  \return \exact(Using[tube := tube].value, RegularUniform)
};
