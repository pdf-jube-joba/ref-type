\import topology.Topology[Carrier := Time.Point] \as Parameters;
\definition neighborhood: \Pow Time.Point := Parameters.Intersection uniform.neighborhood tube.neighborhood;
\definition value: RegularUniform := RegularUniform {
  uniform := Strip.Uniform {
    neighborhood := neighborhood,
    open := (Parameters.topologyLaws Time.manifold.space).intersectionOpen uniform.neighborhood tube.neighborhood uniform.open tube.open,
    contains := Logic.And[_, _]::# uniform.contains tube.contains,
    injective := \fun (t, s: Time.Point)(b, c: Inclusion.manifold.Point)(left: _)(right: _) => uniform.injective t s b c left.left right.left,
  },
  regular := \fun (t: Time.Point)(b: Inclusion.manifold.Point)(member: _) => tube.within t member.right b (\refl(b)),
};
