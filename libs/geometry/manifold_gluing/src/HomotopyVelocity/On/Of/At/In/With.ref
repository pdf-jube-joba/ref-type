\definition extension: Local.Extension := Local.Extension {
  neighborhood := e.neighborhood, included := e.included, contains := e.contains,
  map := e.map, inside := e.inside, agrees := e.agrees,
};
\definition derivative: Derivative.jacobian = Jet.derivative := trans!{{calculus.Vector[n := Nat.add One.dimension n, m := n].LinearMap}} _ _ _
  (Local.ofExtension Derivative.smooth extension)
  (sym!{{calculus.Vector[n := Nat.add One.dimension n, m := n].LinearMap}} _ _ (Original.ofExtension Jet.smooth e));
\definition law: Image.Coordinate[chart := imageChart].decode (Differential.value.apply vertical) = Jet.velocity :=
  trans!{Model.Point} _ _ _ (Differential.coordinates ProductChart.total imageChart vertical)
    (congr!{{calculus.Vector[n := Nat.add One.dimension n, m := n].LinearMap} Source.Point Model.Point}
      (\fun (d: calculus.Vector[n := Nat.add One.dimension n, m := n].LinearMap)(v: Source.Point) => d.apply v) _ _ _ _ derivative verticalCoordinates);
\definition allCoordinates: \forall (w: Domain.Vector) -> Image.Coordinate[chart := imageChart].decode (Differential.value.apply w) =
  Jet.derivative.apply (Domain.Coordinate[chart := ProductChart.total].decode w) :=
  \fun (w: Domain.Vector) => trans!{Model.Point} _ _ _ (Differential.coordinates ProductChart.total imageChart w)
    (congr!{{calculus.Vector[n := Nat.add One.dimension n, m := n].LinearMap} Model.Point}
      (\fun (j: calculus.Vector[n := Nat.add One.dimension n, m := n].LinearMap) => j.apply (Domain.Coordinate[chart := ProductChart.total].decode w)) _ _ derivative);
