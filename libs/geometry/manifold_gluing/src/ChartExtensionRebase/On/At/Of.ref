\definition sourceSame: Old.source = New.source := congr!{{Charts.LocalPoint left} {Model.Carrier left.constraints left.image}} (Charts.coordinate left) _ _
  (boundary_manifolds.Refinement[A := M.Point].equality left.domain Old.sourcePoint New.sourcePoint (\refl(x)));
\definition extension: New.Extension := New.Extension {
  neighborhood := e.neighborhood, included := e.included, map := e.map, inside := e.inside, agrees := e.agrees,
  contains := \idelim (Old.source \of Model.Point) = (New.source \of Model.Point) \with p: Model.Point => \In[Model.Point] e.neighborhood.points p \by {
    base: e.contains, equality: congr!{{Model.Carrier left.constraints left.image} {Model.Point}} (\fun (p: Model.Carrier left.constraints left.image) => p) _ _ sourceSame
  },
};
