\import boundary_manifolds.Dimension[n := m] \as Targets;
\import Targets.Atlas[M := M.Point, space := M.space] \as Atlases;
\definition ofAtlas[atlas: Atlases.Atlas]: Targets.Manifold := Targets.Manifold {
  Point := M.Point, space := M.space, atlas := atlas, hausdorff := M.hausdorff, secondCountable := M.secondCountable,
};
\definition Forward[atlas: Atlases.Atlas]: \Set := boundary_manifolds.SmoothMap[n := n, m := m].Between[M := M, N := ofAtlas atlas].Map;
\definition Backward[atlas: Atlases.Atlas]: \Set := boundary_manifolds.SmoothMap[n := m, m := n].Between[M := ofAtlas atlas, N := M].Map;
\definition forwardApply[atlas: Atlases.Atlas][f: Forward atlas][x: M.Point]: M.Point := boundary_manifolds.SmoothMap[n := n, m := m].Between[M := M, N := ofAtlas atlas].apply f x;
\definition backwardApply[atlas: Atlases.Atlas][f: Backward atlas][x: M.Point]: M.Point := boundary_manifolds.SmoothMap[n := m, m := n].Between[M := ofAtlas atlas, N := M].apply f x;
\structure Data: \Set := {
  atlas: Atlases.Atlas,
  forward: Forward atlas,
  backward: Backward atlas,
  forwardIdentity: \forall (x: M.Point) -> forwardApply atlas forward x = x,
  backwardIdentity: \forall (x: M.Point) -> backwardApply atlas backward x = x,
};
\definition manifold[data: Data]: Targets.Manifold := ofAtlas data.atlas;
