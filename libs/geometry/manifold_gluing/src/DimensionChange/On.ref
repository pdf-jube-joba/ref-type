\module At(m: Nat.Nat^);
\import boundary_manifolds.MapIdentity[n := n].On[M := M] \as Identity;
\definition identity: At[m := n].Data := At[m := n].Data {
  atlas := M.atlas, forward := Identity.map, backward := Identity.map,
  forwardIdentity := \fun (x: M.Point) => \refl(x), backwardIdentity := \fun (x: M.Point) => \refl(x),
};
\definition exists: \forall (m: Nat.Nat^) -> n = m -> \exists At[m := m].Data := \fun (m: Nat.Nat^)(same: n = m) =>
  \idelim n = m \with k: Nat.Nat^ => \exists \root.DimensionChange[n := n].On[M := M].At[m := k].Data \by {
    base: \exact(identity, At[m := n].Data), equality: same
  };
