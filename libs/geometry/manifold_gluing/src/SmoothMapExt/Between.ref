\import boundary_manifolds.SmoothMap[n := n, m := m].Between[M := M, N := N] \as Maps;
\definition eta: \forall (data: Maps.Data) -> Maps.Data::# data.apply = data := \induction (data: Maps.Data) \return Maps.Data::# data.apply = data \with {
  | # : \fun (function: M.Point -> N.Point) => \refl(Maps.Data::# function)
};
\definition ext: \forall (f, g: Maps.Map) -> (\forall (x: M.Point) -> Maps.apply f x = Maps.apply g x) -> f = g := \fun (f, g: Maps.Map)(same: \forall (x: M.Point) -> Maps.apply f x = Maps.apply g x) =>
  boundary_manifolds.Refinement[A := Maps.Data].equality ({ data: Maps.Data \where Maps.Laws[data] }) f g
    (trans!{{Maps.Data}} _ _ _ (sym!{{Maps.Data}} _ _ (eta f))
      (trans!{{Maps.Data}} _ _ _ (congr!{{M.Point -> N.Point} {Maps.Data}} Maps.Data::# _ _ (\axiom:funext(Maps.apply f, Maps.apply g, same))) (eta g)));
