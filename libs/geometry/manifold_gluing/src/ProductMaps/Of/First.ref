\definition data: FirstMaps.Data := FirstMaps.Data { apply := Product.first };
\module In(c: Product.LeftChart, d: Product.RightChart, right: LeftCharts.Chart, x: Product.Point,
  contains: Charts.Contains Product.In[c := c, d := d].chart x, inRight: LeftCharts.Contains right (Product.first x)) {
  \import Product.In[c := c, d := d] \as Patch;
  \import LeftCharts.At[x := Product.first x, left := c, right := right, inLeft := contains.left] \as Change;
  \import FirstMaps.At[function := Product.first, left := Patch.chart, right := right, x := x, contains := contains] \as Local;
  \module With(e: Change.Extension) {
    \import Change.Using[extension := e] \as Center;
    \import Blocks.On[U := e.neighborhood, V := d.image] \as Rectangle;
    \import calculus.Maps[n := dimension, m := n] \as Maps;
    \import Maps.Composition[U := Rectangle.domain, V := e.neighborhood, f := Rectangle.leftMap].After[l := n, W := LeftOpen.whole, g := e.map] \as Composition;
    \definition rightPoint: RightCharts.LocalPoint d := \into[N.Point](Product.second x, d.domain) \by { contains.right };
    \definition domain: Open.OpenSet := Rectangle.domain;
    \definition included: Open.Included domain Patch.image := \fun (u: Model.Point)(member: _) => Logic.And[_, _]::#
      (e.included (Blocks.left u) member.left) member.right;
    \definition input[u: Model.Carrier Patch.C domain]: Left.Carrier c.constraints e.neighborhood :=
      \into[LeftOpen.Carrier e.neighborhood](Rectangle.leftPoint u, Left.region c.constraints e.neighborhood) \by {
        Products.nonnegativeLeft c.constraints d.constraints u (\bysub(Open.Carrier domain, Model.region Patch.C domain, u))
      };
    \definition extension: Local.Extension := Local.Extension {
      neighborhood := domain, included := included,
      contains := \bysub(Model.Point, domain.points, Rectangle.joinPoint Center.center (RightCharts.coordinate d rightPoint)),
      map := Composition.compose,
      inside := \fun (u: Model.Carrier Patch.C domain) => e.inside (input u),
      agrees := \fun (u: Model.Carrier Patch.C domain) => e.agrees (input u),
    };
  }
  \definition existsExtension: \In[LeftCharts.Chart] M.atlas.charts right -> \exists Local.Extension := \block {
    \fun (member: _) \then
    \takefrom e: Change.Extension \by M.atlas.compatible c right (Product.first x) contains.left inRight
      (\bysub(LeftCharts.Chart, M.atlas.charts, c)) member \then
    \return \exact(With[e := e].extension, Local.Extension)
  };
}
\module At(left: Charts.Chart, right: LeftCharts.Chart, x: Product.Point, contains: Charts.Contains left x, inRight: LeftCharts.Contains right (Product.first x)) {
  \module With(i: Product.Index, same: left = Product.chart i) {
    \definition existsExtension: \In[LeftCharts.Chart] M.atlas.charts right ->
      \exists FirstMaps.At[function := Product.first, left := left, right := right, x := x, contains := contains].Extension :=
      \fun (member: _) => \idelim Product.chart i = left \with a: Charts.Chart => \forall (inside: Charts.Contains a x) ->
        \exists FirstMaps.At[function := Product.first, left := a, right := right, x := x, contains := inside].Extension \by {
          base: \fun (inside: _) => \root.ProductMaps[n := n, m := m].Of[M := M, N := N].First[].In[c := Pair.first Product.LeftChart Product.RightChart i,
            d := Pair.second Product.LeftChart Product.RightChart i, right := right, x := x, contains := inside, inRight := inRight].existsExtension member,
          equality: sym!{{Charts.Chart}} _ _ same
        } contains;
  }
  \definition existsExtension: \In[Charts.Chart] Product.manifold.atlas.charts left -> \In[LeftCharts.Chart] M.atlas.charts right ->
    \exists FirstMaps.At[function := Product.first, left := left, right := right, x := x, contains := contains].Extension := \block {
    \fun (sourceMember: _)(targetMember: _) \then
    \takefrom i: \Cast[Product.Index] ({ i: Product.Index \where left = Product.chart i }) \by sourceMember \then
    \return With[i := i, same := \bysub(Product.Index, { i: Product.Index \where left = Product.chart i }, i)].existsExtension targetMember
  };
}
\definition map: FirstMaps.Map := \into[FirstMaps.Data](data, FirstMaps.Map) \by {
  FirstMaps.Laws[data] {
    continuous := Topology.Maps[].firstContinuous M.space N.space,
    smooth := \fun (left: Charts.Chart)(right: LeftCharts.Chart)(x: Product.Point)(contains: _)(lm: _)(rm: _)(inRight: _) =>
      At[left := left, right := right, x := x, contains := contains, inRight := inRight].existsExtension lm rm,
  }
};
