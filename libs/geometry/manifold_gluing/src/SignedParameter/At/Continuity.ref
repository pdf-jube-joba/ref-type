\import metric_spaces.RealFunctions[A := Point] \as Functions;
\definition coordinate: Functions.Continuous manifold.space value := topology.Composition[A := Point, B := Model.Point, C := S.Real].composeContinuous
  manifold.space Ambient.topology Line.topology (\fun (t: Point) => t) (\fun (u: Model.Point) => u One.index)
  (Model.Topology[C := Model.unconstrained, U := domain].ambient) (Ambient.coordinateContinuous One.index);
\definition plusScalar: Functions.Continuous manifold.space positiveValue := Functions.Lattice[].maximumContinuous manifold.space (\fun (t: Point) => S.zero) value
  (Functions.constantContinuous manifold.space S.zero) coordinate;
\definition minusScalar: Functions.Continuous manifold.space negativeValue := Functions.Lattice[].maximumContinuous manifold.space (\fun (t: Point) => S.zero) (\fun (t: Point) => S.neg (value t))
  (Functions.constantContinuous manifold.space S.zero) (Functions.negContinuous manifold.space value coordinate);
\import topological_algebra.Coordinates[K := S.Real, I := One.Index].Universal[A := Point] \as Universal;
\definition plusAmbient: topology.Continuity[A := Point, B := Model.Point].Continuous manifold.space Ambient.topology (\fun (t: Point) => plus t) :=
  \fun (U: \Pow Model.Point)(open: _) => Universal.continuous manifold.space Line.topology (\fun (t: Point) => plus t) (\fun (i: One.Index) => plusScalar) U (Ambient.metricOpen U open);
\definition minusAmbient: topology.Continuity[A := Point, B := Model.Point].Continuous manifold.space Ambient.topology (\fun (t: Point) => minus t) :=
  \fun (U: \Pow Model.Point)(open: _) => Universal.continuous manifold.space Line.topology (\fun (t: Point) => minus t) (\fun (i: One.Index) => minusScalar) U (Ambient.metricOpen U open);
\definition plusContinuous: topology.Continuity[A := Point, B := Time.Point].Continuous manifold.space Time.manifold.space plus :=
  Model.Topology[C := Time.constraints, U := Time.domain].Into[X := Point, source := manifold.space, f := plus].continuous plusAmbient;
\definition minusContinuous: topology.Continuity[A := Point, B := Time.Point].Continuous manifold.space Time.manifold.space minus :=
  Model.Topology[C := Time.constraints, U := Time.domain].Into[X := Point, source := manifold.space, f := minus].continuous minusAmbient;
