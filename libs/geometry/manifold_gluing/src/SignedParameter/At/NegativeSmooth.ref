\import Models.Chart[M := Time.Point, space := Time.manifold.space] \as TimeCharts;
\import Models.Chart[M := Point, space := manifold.space] \as Charts;
\import \root.LocalSmoothMap[n := One.dimension, m := One.dimension].Between[M := manifold, N := Time.manifold].Of[function := minus] \as Locality;
\definition left: Locality.SourceChart t := \into[Charts.Chart](Construction.chart, Locality.SourceChart t) \by {
  Logic.And[_, _]::# (\refl(Construction.chart)) (\refl(t))
};
\definition right: Locality.TargetChart (minus t) := \into[TimeCharts.Chart](Time.chart, Locality.TargetChart (minus t)) \by {
  Logic.And[_, _]::# Time.chartMember (\refl(minus t))
};
\import boundary_manifolds.SmoothMap[n := One.dimension, m := One.dimension].Between[M := manifold, N := Time.manifold] \as Maps;
\import Maps.At[function := minus, left := left, right := right, x := t, contains := Locality.leftContains t left] \as Local;
\definition negativeDomain: Open.OpenSet := Open.Topology[].ofOpen ({ u: Model.Point \where R.Lt (u One.index) S.zero })
  (Ambient.coordinateContinuous One.index (Rays.Below S.zero) (Rays.belowOpen S.zero));
\definition neighborhood: Open.OpenSet := Open.intersection domain negativeDomain;
\import calculus.Maps[n := One.dimension, m := One.dimension] \as Calculus;
\definition reflection: Calculus.Map neighborhood Open.whole := Calculus.Map[neighborhood, Open.whole] {
  apply := \fun (u: Open.Carrier neighborhood) => \into[Model.Point]((\fun (i: One.Index) => S.neg (u i)), Open.whole.points) \by { \refl((\fun (i: One.Index) => S.neg (u i))) },
  smooth := \fun (i: One.Index) => Open.Smooth[].Operations[].negSmooth neighborhood (\fun (u: Open.Carrier neighborhood) => u i) (Open.Examples[].projectionSmooth neighborhood i),
};
\definition included: Open.Included neighborhood domain := Open.intersectionLeft domain negativeDomain;
\definition model[u: Model.Carrier Model.unconstrained neighborhood]: Point := \into[Open.Carrier domain](Open.inclusion neighborhood domain included u, Model.region Model.unconstrained domain) \by {
  Model.unconstrainedNonnegative u
};
\definition extension: Local.Extension := Local.Extension {
  neighborhood := neighborhood, included := included,
  contains := Logic.And[_, _]::# (\bysub(Model.Point, domain.points, t)) strict,
  map := reflection,
  inside := \fun (u: Model.Carrier Model.unconstrained neighborhood) => \refl(minus (model u)),
  agrees := \fun (u: Model.Carrier Model.unconstrained neighborhood) => sym!{Model.Point} _ _
    (minusReflection (model u) (Order.leOfLt (u One.index) S.zero (\bysub(Model.Point, neighborhood.points, u)).right)),
};
\definition witness: Locality.Witness[t] := Locality.Witness[t] { left := left, right := right, extension := extension };
