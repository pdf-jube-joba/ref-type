\import Local.Using[e := e] \as Extension;
\definition a: Open.Carrier e.neighborhood := Extension.center;
\definition zeroNormal: a Boundary.normal = S.zero := \root.CollarCoordinates[n := n].On[M := M].With[cover := cover].From[deformation := deformation].At[b := b, c := c, contains := contains].zeroNormal;
\module Boundary(u: Open.Carrier e.neighborhood, zero: u Boundary.normal = S.zero);
\definition fixed: \root.HalfSpaceJet[n := n].BoundaryFixed e.neighborhood e.map :=
  \fun (u: Open.Carrier e.neighborhood)(zero: _) => Boundary[u := u, zero := zero].law;
\module TimeDerivative;
\import \root.HalfSpaceInverse[n := n].On[U := e.neighborhood, f := e.map, a := a, zeroNormal := zeroNormal, fixed := fixed] \as Inversion;
\definition inverseExists: \exists Inversion.Patch := Inversion.exists TimeDerivative[].positive;
