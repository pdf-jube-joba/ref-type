\import std.Data[].Nat[] \as N;
\import N.Pair[].Def[] \as Pair;
\import N.Pair[].Enumeration[] \as Pairs;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].List[] \as Lists;
\import std.Data[].ListIndex[A := \Pow A] \as ListIndex;
\import Fin.FromList[A := \Pow A] \as FromList;
\import std.Set[].FiniteSubset[A := \Pow A] \as Finite;
\import Finite.Enumeration[] \as Enumeration;
\import std.Set[].Countability[A := N.Nat^] \as Count;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import topology.Topology[Carrier := A] \as Space;
\definition naturals: Count.Enumerator := Count.Enumerator {
  sequence := \fun (k: N.Nat^) => k,
  exhaustive := \fun (k: N.Nat^) => Logic.existsIntro[N.Nat^, { j: N.Nat^ \where j = k }] k (\refl(k)),
};
\import Count.FinitePowers[] \as Powers;
\definition length[k: N.Nat^]: N.Nat^ := Pair.natPairFirst (Pairs.enumerate k);
\definition values[k: N.Nat^]: Fin.Fin (length k) -> N.Nat^ := Powers.sequence naturals (length k) (Pair.natPairSecond (Pairs.enumerate k));
\module On(topology: Space.Topology, basis: N.Nat^ -> \Pow A, laws: Space.IsCountableBasis[topology, basis]);
