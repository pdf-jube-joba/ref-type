\import \root.LocalSmoothMap[n := n, m := n].Between[M := M, N := N].Of[function := f] \as Local;
\module At(c: LeftTransport.OldChart, d: RightTransport.OldChart,
  inLeft: LeftCharts.Contains c x, inRight: RightCharts.Contains d (f x), chosen: Local.Witness[x]);
\module Through(c: LeftTransport.OldChart, d: RightTransport.OldChart,
  inLeft: Charts.Contains LeftTransport.In[c := c].chart (h.forward x),
  inRight: Charts.Contains RightTransport.In[c := d].chart (h.forward x), chosen: Local.Witness[x]);
\module Across(c: LeftTransport.OldChart, d: RightTransport.OldChart, y: A, same: (h.forward x \of A) = y,
  inLeft: Charts.Contains LeftTransport.In[c := c].chart y,
  inRight: Charts.Contains RightTransport.In[c := d].chart y, chosen: Local.Witness[x]);
