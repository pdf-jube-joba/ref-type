\import LeftTransport.In[c := c] \as Left;
\import RightTransport.In[c := d] \as Right;
\definition targetContains: Charts.Contains Right.chart (h.forward x) := \idelim y = (h.forward x \of A) \with z: A => Charts.Contains Right.chart z \by {
  base: inRight, equality: sym!{A} _ _ same
};
\definition exists: \exists Charts.At[x := y, left := Left.chart, right := Right.chart, inLeft := inLeft].Extension :=
  \idelim (h.forward x \of A) = y \with z: A => \forall (contains: Charts.Contains Left.chart z) ->
    \exists Charts.At[x := z, left := Left.chart, right := Right.chart, inLeft := contains].Extension \by {
      base: \fun (contains: Charts.Contains Left.chart (h.forward x)) => \parent.Through[c := c, d := d, inLeft := contains, inRight := targetContains, chosen := chosen].exists,
      equality: same
    } inLeft;
