\import \root.ChartTransport[n := n].From[M := M].Into[A := A, space := space, U := U, open := openU, h := h] \as LeftTransport;
\import \root.ChartTransport[n := n].From[M := N].Into[A := A, space := space, U := V, open := openV, h := k] \as RightTransport;
\import Models.Chart[M := A, space := space] \as Charts;
\module Along(f: M.Point -> N.Point, x: M.Point, W: \Pow M.Point, openW: SourceSpace.IsOpenIn M.space W,
  inW: SourceSpace.Member W x, agrees: \forall (p: M.Point) -> SourceSpace.Member W p -> (k.forward (f p) \of A) = (h.forward p \of A));
