\import Models.Chart[M := M.Point, space := M.space] \as LeftCharts;
\import Models.Chart[M := N.Point, space := N.space] \as RightCharts;
\import boundary_manifolds.SmoothMap[n := n, m := n].Between[M := M, N := N] \as Maps;
\import topology.Topology[Carrier := M.Point] \as SourceSpace;
\module Into(A: \Set, space: topology.Structures[].Topology[A], U, V: \Pow A,
  openU: topology.Topology[Carrier := A].IsOpenIn space U, openV: topology.Topology[Carrier := A].IsOpenIn space V,
  h: topology.Homeomorphism[A := M.Point, B := \Cast[A] U].Homeomorphism[M.space, topology.Topology[Carrier := A].Subspace[S := U].topology space],
  k: topology.Homeomorphism[A := N.Point, B := \Cast[A] V].Homeomorphism[N.space, topology.Topology[Carrier := A].Subspace[S := V].topology space]);
