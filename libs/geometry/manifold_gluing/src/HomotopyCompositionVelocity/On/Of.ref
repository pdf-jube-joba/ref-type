\import Homotopies.Composition[first := first, second := second] \as Composite;
\import \root.PairDifferential[p := Nat.add One.dimension n, n := n, m := One.dimension].Between[P := Product.manifold, M := M, N := Time.manifold].Of[f := first.map, g := Projections.Second[].map] \as Lift;
\import \root.SmoothChainRule[n := Nat.add One.dimension n, m := Nat.add One.dimension n, l := n].Between[M := Product.manifold, N := Product.manifold, P := M].Of[f := Lift.map, g := second.map] \as Chain;
\definition secondVelocity[x: M.Point]: Tangent.Vector x := Velocity.Of[h := second].At[x := x].value;
\module At(x: M.Point);
