\import boundary_manifolds.Tangent[n := n].On[M := Inclusion.manifold].At[x := x] \as Domain;
\import boundary_manifolds.Tangent[n := Nat.add One.dimension n].On[M := M].At[x := Inclusion.apply x] \as Codomain;
\import boundary_manifolds.Differential[n := n, m := Nat.add One.dimension n].Between[M := Inclusion.manifold, N := M].At[f := Inclusion.map, x := x] \as Differential;
\definition apply[v: Domain.Vector]: Codomain.Vector := Differential.value.apply v;
\module In(c: Atlas.Chart, contains: Charts.Contains c x);
\definition injective: \forall (u, v: Domain.Vector) -> apply u = apply v -> u = v := \block {
  \fun (u, v: Domain.Vector)(same: _) \then
  \takefrom c: \Cast[Atlas.Chart] ({ c: Atlas.Chart \where Charts.Contains c x }) \by cover x \then
  \return In[c := c, contains := \bysub(Atlas.Chart, { c: Atlas.Chart \where Charts.Contains c x }, c)].injective u v same
};
\definition tangential: \forall (v: Domain.Vector) -> Codomain.Cones[].Tangential (apply v) := \block {
  \fun (v: Domain.Vector) \then
  \takefrom c: \Cast[Atlas.Chart] ({ c: Atlas.Chart \where Charts.Contains c x }) \by cover x \then
  \return In[c := c, contains := \bysub(Atlas.Chart, { c: Atlas.Chart \where Charts.Contains c x }, c)].tangential v
};
\definition ontoTangential: \forall (v: Codomain.Vector) -> Codomain.Cones[].Tangential v -> \exists ( u: Domain.Vector \where apply u = v ) := \block {
  \fun (v: Codomain.Vector)(tangential: _) \then
  \takefrom c: \Cast[Atlas.Chart] ({ c: Atlas.Chart \where Charts.Contains c x }) \by cover x \then
  \return In[c := c, contains := \bysub(Atlas.Chart, { c: Atlas.Chart \where Charts.Contains c x }, c)].onto v tangential
};
