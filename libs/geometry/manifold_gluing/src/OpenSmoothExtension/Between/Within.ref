\import \root.OpenManifold[n := n].On[M := M].Within[U := U, open := open] \as Source;
\import boundary_manifolds.SmoothMap[n := n, m := m].Between[M := Source.manifold, N := N] \as LocalMaps;
\import topology.Topology[Carrier := Source.Point] \as LocalSpace;
\import topological_constructions.Gluing[A := M.Point, B := N.Point] \as Gluing;
\module Of(f: LocalMaps.Map, g: GlobalMaps.Map, agrees: \forall (x: Source.Point) -> Logic.Not (Space.Member K x) -> LocalMaps.apply f x = GlobalMaps.apply g x);
