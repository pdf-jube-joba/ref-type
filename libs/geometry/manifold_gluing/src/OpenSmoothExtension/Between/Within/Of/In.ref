\import Source.Inclusion[].InverseAt[x := x] \as Inverse;
\definition composite[p: M.Point]: N.Point := LocalMaps.apply f (Inverse.function p);
\import \root.LocalSmoothMap[n := n, m := m].Between[M := M, N := N].Of[function := composite] \as CompositeLocal;
\import \root.LocalSmoothPostcompose[n := n, m := n, l := m].Between[M := M, N := Source.manifold, P := N].From[f := Inverse.function, g := f] \as Compose;
\import \root.LocalSmoothTransfer[n := n, m := m].Between[M := M, N := N].From[f := function, g := composite] \as Transfer;
\definition equal: \forall (p: M.Point) -> Space.Member U p -> function p = composite p := \fun (p: M.Point)(member: Space.Member U p) => trans!{{N.Point}} _ _ _ (inside (\into[M.Point](p, U) \by { member }))
  (congr!{{Source.Point} {N.Point}} (LocalMaps.apply f) _ _ (sym!{{Source.Point}} _ _ (Inverse.inside (\into[M.Point](p, U) \by { member }))));
\definition exists: \exists Local.Witness[x] := \block {
  \takefrom inverse: Inverse.Witness \by Inverse.exists \then
  \takefrom composite: CompositeLocal.Witness[x] \by Compose.At[x := (x \of M.Point), chosen := inverse].exists \then
  \return Transfer.At[x := (x \of M.Point), U := U, open := open, contains := \bysub(M.Point, U, x), agrees := equal, chosen := composite].exists
};
