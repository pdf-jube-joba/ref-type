\definition outside: \Pow M.Point := Space.Complement K;
\definition equal: \forall (p: M.Point) -> Space.Member outside p -> function p = GlobalMaps.apply g p := \fun (p: M.Point)(member: Space.Member outside p) => unchanged p member;
\definition exists: \exists Local.Witness[x] := Local.EqualNear[x := x, g := g, U := outside, open := closed, contains := missing, agrees := equal].exists;
