\import Products.Of[M := M, N := N] \as Product;
\import Models.Chart[M := Product.Point, space := Product.topology] \as Charts;
\import LeftModels.Chart[M := M.Point, space := M.space] \as LeftCharts;
\import RightModels.Chart[M := N.Point, space := N.space] \as RightCharts;
\import \root.HalfModel[n := Nat.add m n].On[M := Product.manifold] \as Half;
\module RightHalf(c: Product.LeftChart, d: Product.RightChart, U: LeftOpen.OpenSet, V: RightOpen.OpenSet,
  includedLeft: LeftOpen.Included U c.image, includedRight: RightOpen.Included V d.image,
  leftNonnegative: \forall (u: LeftOpen.Carrier U) -> Left.Nonnegative c.constraints u,
  normal: Right.Coordinate, rightEquivalent: \forall (u: RightOpen.Carrier V) -> Logic.PropEquiv[Right.Nonnegative d.constraints u, Right.Nonnegative (Right.halfSpace normal) u]);

\module LeftHalf(c: Product.LeftChart, d: Product.RightChart, U: LeftOpen.OpenSet, V: RightOpen.OpenSet,
  includedLeft: LeftOpen.Included U c.image, includedRight: RightOpen.Included V d.image,
  normal: Left.Coordinate, leftEquivalent: \forall (u: LeftOpen.Carrier U) -> Logic.PropEquiv[Left.Nonnegative c.constraints u, Left.Nonnegative (Left.halfSpace normal) u],
  rightNonnegative: \forall (u: RightOpen.Carrier V) -> Right.Nonnegative d.constraints u);
