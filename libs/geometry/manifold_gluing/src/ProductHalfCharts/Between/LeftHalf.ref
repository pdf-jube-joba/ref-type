\import Product.In[c := c, d := d] \as Original;
\definition source: Open.OpenSet := Blocks.product U V;
\definition included: Open.Included source Original.image := \fun (u: Model.Point)(member: \In[Model.Point] source.points u) => Logic.And[_, _]::# (includedLeft (Blocks.left u) member.left) (includedRight (Blocks.right u) member.right);
\definition old: Half.OldChart := \into[Charts.Chart](Original.chart, Product.manifold.atlas.charts) \by {
  Logic.existsIntro[Product.Index, { i: Product.Index \where Original.chart = Product.chart i }] (Pair.pair Product.LeftChart Product.RightChart c d) (\refl(Original.chart))
};
\definition index: Model.Coordinate := Indices.left normal;
\module At(u: Open.Carrier source);
\definition data: Half.Data := Half.Data { chart := old, source := source, included := included, normal := index, equivalent := \fun (u: Open.Carrier source) => At[u := u].equivalent };
\import \root.ChartRestriction[n := Nat.add m n].On[M := Product.manifold].Of[c := old].Within[U := source, included := included] \as Restriction;
\module Contains(p: Product.Point, leftContains: LeftCharts.Contains c (Product.first p), rightContains: RightCharts.Contains d (Product.second p),
  leftInside: \In[Left.Point] U.points (LeftCharts.coordinate c (\into[M.Point](Product.first p, c.domain) \by { leftContains })),
  rightInside: \In[Right.Point] V.points (RightCharts.coordinate d (\into[N.Point](Product.second p, d.domain) \by { rightContains })));
