\definition local: Charts.LocalPoint Original.chart := \into[Product.Point](p, Original.domain) \by { Logic.And[_, _]::# leftContains rightContains };
\definition raw: Model.Point := Charts.coordinate Original.chart local;
\definition leftInput: LeftCharts.LocalPoint c := \into[M.Point](Product.first p, c.domain) \by { leftContains };
\definition rightInput: RightCharts.LocalPoint d := \into[N.Point](Product.second p, d.domain) \by { rightContains };
\definition leftCoordinate: Blocks.left raw = (LeftCharts.coordinate c leftInput \of Left.Point) := Blocks.leftJoin (LeftCharts.coordinate c leftInput) (RightCharts.coordinate d rightInput);
\definition rightCoordinate: Blocks.right raw = (RightCharts.coordinate d rightInput \of Right.Point) := Blocks.rightJoin (LeftCharts.coordinate c leftInput) (RightCharts.coordinate d rightInput);
\definition inside: \In[Model.Point] source.points raw := Logic.And[_, _]::#
  (\idelim (LeftCharts.coordinate c leftInput \of Left.Point) = Blocks.left raw \with u: Left.Point => \In[Left.Point] U.points u \by { base: leftInside, equality: sym!{{Left.Point}} _ _ leftCoordinate })
  (\idelim (RightCharts.coordinate d rightInput \of Right.Point) = Blocks.right raw \with u: Right.Point => \In[Right.Point] V.points u \by { base: rightInside, equality: sym!{{Right.Point}} _ _ rightCoordinate });
\definition member: Half.Contains data p := Restriction.containsFrom local inside;
