\definition left: LeftOpen.Carrier U := \into[Left.Point](Blocks.left u, U.points) \by { (\bysub(Model.Point, source.points, u)).left };
\definition right: RightOpen.Carrier V := \into[Right.Point](Blocks.right u, V.points) \by { (\bysub(Model.Point, source.points, u)).right };
\definition equivalent: Logic.PropEquiv[Model.Nonnegative Original.C u, Model.Nonnegative (Model.halfSpace index) u] := Logic.PropEquiv[_, _] {
  ltr := \fun (member: Model.Nonnegative Original.C u) => Model.halfSpaceNonnegative index u
    (((leftEquivalent left).ltr (Products.nonnegativeLeft c.constraints d.constraints u member)) normal (\refl(normal))),
  rtl := \fun (member: Model.Nonnegative (Model.halfSpace index) u) => \idelim Blocks.join (Blocks.left u) (Blocks.right u) = (u \of Model.Point) \with p: Model.Point => Model.Nonnegative Original.C p \by {
    base: Products.nonnegativeJoin c.constraints d.constraints (Blocks.left u) (Blocks.right u)
      ((leftEquivalent left).rtl (Left.halfSpaceNonnegative normal (Blocks.left u) (member index (\refl(index))))) (rightNonnegative right), equality: Blocks.recover u
  },
};
