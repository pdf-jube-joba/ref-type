\import Charts.At[x := x, left := chart, right := c, inLeft := contains] \as Extension;
\definition extension: Extension.Extension := Extension.Extension {
  neighborhood := U, included := \fun (u: Model.Point)(member: _) => member, contains := \bysub(Model.Point, U.points, Extension.source), map := identity,
  inside := \fun (u: Model.Carrier c.constraints U) => \bysub(M.Point, c.domain, Charts.point c (input u)),
  agrees := \fun (u: Model.Carrier c.constraints U) => sym!{{Model.Point}} _ _ (congr!{{Model.Carrier c.constraints c.image} {Model.Point}} (\fun (p: Model.Carrier c.constraints c.image) => p) _ _ (Charts.coordinatePoint c (input u))),
};
