\import Charts.At[x := x, left := c, right := chart, inLeft := contains] \as Extension;
\definition local: Point := \into[M.Point](x, domain) \by { inRestricted };
\definition oldEqual: old local = Extension.sourcePoint := boundary_manifolds.Refinement[A := M.Point].equality c.domain (old local) Extension.sourcePoint (\refl(x));
\definition sourceIn: \In[Model.Point] U.points Extension.source := \idelim (Charts.coordinate c (old local) \of Model.Point) = (Extension.source \of Model.Point) \with u: Model.Point => \In[Model.Point] U.points u \by {
  base: inSource local, equality: congr!{{Charts.LocalPoint c} {Model.Point}} (\fun (p: Charts.LocalPoint c) => Charts.coordinate c p) _ _ oldEqual
};
\definition output[u: Model.Carrier c.constraints U]: Charts.LocalPoint chart := \into[M.Point](Charts.point c (input u), domain) \by { pointMember u };
\definition outputEqual: \forall (u: Model.Carrier c.constraints U) -> output u = point u := \fun (u: Model.Carrier c.constraints U) => \refl(point u);
\definition extension: Extension.Extension := Extension.Extension {
  neighborhood := U, included := included, contains := sourceIn, map := identity,
  inside := \fun (u: Model.Carrier c.constraints U) => pointMember u,
  agrees := \fun (u: Model.Carrier c.constraints U) => sym!{{Model.Point}} _ _ (congr!{{Model.Carrier c.constraints U} {Model.Point}} (\fun (p: Model.Carrier c.constraints U) => p) _ _ (rightInverse u)),
};
