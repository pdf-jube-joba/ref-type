\definition nonzero: Logic.Not (q = S.zero) := \fun (same: q = S.zero) => R.Order[].ltNotEq S.zero q positive (sym!{S.Real} _ _ same);
\definition inverse: S.Real := Laws.fieldInv q;
\definition inversePositive: R.Lt S.zero inverse := Product.invPositive q positive;
\definition value[t: S.Real]: S.Real := S.mul inverse t;
\definition cancel: \forall (t: S.Real) -> value (S.mul q t) = t := \fun (t: S.Real) => trans!{S.Real} _ _ _ (sym!{S.Real} _ _ (Laws.fieldMulAssoc inverse q t))
  (trans!{S.Real} _ _ _ (congr!{S.Real S.Real} (\fun (a: S.Real) => S.mul a t) _ _ (Laws.fieldInverseNonzero q nonzero)) (Laws.fieldMulOneLeft t));
\definition undo: \forall (t: S.Real) -> S.mul q (value t) = t := \fun (t: S.Real) => trans!{S.Real} _ _ _ (sym!{S.Real} _ _ (Laws.fieldMulAssoc q inverse t))
  (trans!{S.Real} _ _ _ (congr!{S.Real S.Real} (\fun (a: S.Real) => S.mul a t) _ _ (trans!{S.Real} _ _ _ (Laws.fieldMulComm q inverse) (Laws.fieldInverseNonzero q nonzero))) (Laws.fieldMulOneLeft t));
\definition nonnegative: \forall (t: S.Real) -> R.Le S.zero t -> R.Le S.zero (value t) := \fun (t: S.Real)(member: _) => Laws.fieldMulNonnegative inverse t (R.Order[].leOfLt S.zero inverse inversePositive) member;
\definition le: \forall (t, c: S.Real) -> R.Le t (S.mul q c) -> R.Le (value t) c := \fun (t, c: S.Real)(member: _) => R.leReplaceRight (value t) (value (S.mul q c)) c (cancel c) (Estimates.mulMonotone inverse t (S.mul q c) (R.Order[].leOfLt S.zero inverse inversePositive) member);
\definition lt: \forall (t, c: S.Real) -> R.Lt t (S.mul q c) -> R.Lt (value t) c := \fun (t, c: S.Real)(member: _) => R.ltReplaceRight (value t) (value (S.mul q c)) c (cancel c) (Product.mulStrict inverse t (S.mul q c) inversePositive member);
\definition ofLe: \forall (t, c: S.Real) -> R.Le (value t) c -> R.Le t (S.mul q c) := \fun (t, c: S.Real)(member: _) => R.leReplaceLeft (S.mul q (value t)) t (S.mul q c) (undo t) (Estimates.mulMonotone q (value t) c (R.Order[].leOfLt S.zero q positive) member);
\definition ofLt: \forall (t, c: S.Real) -> R.Lt (value t) c -> R.Lt t (S.mul q c) := \fun (t, c: S.Real)(member: _) => R.ltReplaceLeft (S.mul q (value t)) t (S.mul q c) (undo t) (Product.mulStrict q (value t) c positive member);
