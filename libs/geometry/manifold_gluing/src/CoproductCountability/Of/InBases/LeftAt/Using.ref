\definition pair: Pair.NatPair := Pair.natPair (N.Nat^::succ i) N.Nat^::zero;
\definition subset: Space.Subset (rectangle pair) U := \induction (p: Sum.Carrier) \return Space.Member (rectangle pair) p -> Space.Member U p \with {
  | inl: \fun (a: A)(member: Left.Member (l i) a) => data.right a member
  | inr: \fun (b: B)(member: Logic.False) => Logic.falseElim (Space.Member U (Sum.inr b)) member
};
\definition exists: \exists (k: N.Nat^ \where Logic.And[Space.Member (basis k) (Sum.inl x), Space.Subset (basis k) U]) := \block {
  \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Enumeration.enumerate k = pair }) \by Enumeration.exhaustive (N.Nat^::succ i) N.Nat^::zero \then
  \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Logic.And[Space.Member (basis k) (Sum.inl x), Space.Subset (basis k) U] }] k
    (\idelim pair = Enumeration.enumerate k \with p: Pair.NatPair => Logic.And[Space.Member (rectangle p) (Sum.inl x), Space.Subset (rectangle p) U] \by {
      base: Logic.And[_, _]::# data.left subset, equality: sym!{Pair.NatPair} _ _ (\bysub(N.Nat^, { k: N.Nat^ \where Enumeration.enumerate k = pair }, k))
    })
};
