\import topology.Maps[A := B, B := Sum.Carrier] \as Preimage;
\definition input: \Pow B := Preimage.Preimage Sum.inr U;
\module Using(i: N.Nat^, data: Logic.And[Right.Member (r i) x, Right.Subset (r i) input]);
\definition exists: \exists (k: N.Nat^ \where Logic.And[Space.Member (basis k) (Sum.inr x), Space.Subset (basis k) U]) := \block {
  \takefrom i: \Cast[N.Nat^] ({ i: N.Nat^ \where Logic.And[Right.Member (r i) x, Right.Subset (r i) input] }) \by rr.refines input openU.right x member \then
  \return Using[i := i, data := \bysub(N.Nat^, { i: N.Nat^ \where Logic.And[Right.Member (r i) x, Right.Subset (r i) input] }, i)].exists
};
