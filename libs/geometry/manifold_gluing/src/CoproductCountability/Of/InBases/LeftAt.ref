\import topology.Maps[A := A, B := Sum.Carrier] \as Preimage;
\definition input: \Pow A := Preimage.Preimage Sum.inl U;
\module Using(i: N.Nat^, data: Logic.And[Left.Member (l i) x, Left.Subset (l i) input]);
\definition exists: \exists (k: N.Nat^ \where Logic.And[Space.Member (basis k) (Sum.inl x), Space.Subset (basis k) U]) := \block {
  \takefrom i: \Cast[N.Nat^] ({ i: N.Nat^ \where Logic.And[Left.Member (l i) x, Left.Subset (l i) input] }) \by ll.refines input openU.left x member \then
  \return Using[i := i, data := \bysub(N.Nat^, { i: N.Nat^ \where Logic.And[Left.Member (l i) x, Left.Subset (l i) input] }, i)].exists
};
