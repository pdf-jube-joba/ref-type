\definition pair: Pair.NatPair := Pair.natPair N.Nat^::zero (N.Nat^::succ i);
\definition subset: Space.Subset (rectangle pair) U := \induction (p: Sum.Carrier) \return Space.Member (rectangle pair) p -> Space.Member U p \with {
  | inl: \fun (a: A)(member: Logic.False) => Logic.falseElim (Space.Member U (Sum.inl a)) member
  | inr: \fun (b: B)(member: Right.Member (r i) b) => data.right b member
};
\definition exists: \exists (k: N.Nat^ \where Logic.And[Space.Member (basis k) (Sum.inr x), Space.Subset (basis k) U]) := \block {
  \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Enumeration.enumerate k = pair }) \by Enumeration.exhaustive N.Nat^::zero (N.Nat^::succ i) \then
  \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Logic.And[Space.Member (basis k) (Sum.inr x), Space.Subset (basis k) U] }] k
    (\idelim pair = Enumeration.enumerate k \with p: Pair.NatPair => Logic.And[Space.Member (rectangle p) (Sum.inr x), Space.Subset (rectangle p) U] \by {
      base: Logic.And[_, _]::# data.left subset, equality: sym!{Pair.NatPair} _ _ (\bysub(N.Nat^, { k: N.Nat^ \where Enumeration.enumerate k = pair }, k))
    })
};
