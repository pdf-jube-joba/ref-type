\definition input[u: Model.Carrier c.constraints e.neighborhood]: Model.Carrier c.constraints c.image :=
  \into[Open.Carrier c.image](Open.inclusion e.neighborhood c.image e.included u, Model.region c.constraints c.image) \by {
    \bysub(Open.Carrier e.neighborhood, Model.region c.constraints e.neighborhood, u)
  };
\definition original[u: Model.Carrier c.constraints e.neighborhood]: M.Point := OldCharts.point c (input u);
\definition inside: \forall (u: Model.Carrier c.constraints e.neighborhood) -> Charts.Contains Right.chart (Charts.point Left.chart (input u)) :=
  \fun (u: Model.Carrier c.constraints e.neighborhood) => Right.inDomain (original u) (e.inside u);
\definition extension: New.Extension := New.Extension {
  neighborhood := e.neighborhood, included := e.included, contains := e.contains, map := e.map, inside := inside,
  agrees := \fun (u: Model.Carrier c.constraints e.neighborhood) => trans!{Model.Point} _ _ _ (e.agrees u) (sym!{Model.Point} _ _ (Right.coordinateLift (original u) (e.inside u))),
};
