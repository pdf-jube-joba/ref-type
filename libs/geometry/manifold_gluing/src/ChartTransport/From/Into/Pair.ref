\import \parent.In[c := c] \as Left;
\import \parent.In[c := d] \as Right;
\definition point: Left.Point := \into[A](x, Left.domain) \by { contains };
\definition other: Right.Point := \into[A](x, Right.domain) \by { otherContains };
\definition old: M.Point := Left.old point;
\definition inLeft: OldCharts.Contains c old := Left.contains point;
\definition inRight: OldCharts.Contains d old := Right.contains other;
\import OldCharts.At[x := old, left := c, right := d, inLeft := inLeft] \as Original;
\import Charts.At[x := x, left := Left.chart, right := Right.chart, inLeft := contains] \as New;
\module Using(e: Original.Extension);
\definition exists: \exists New.Extension := \block {
  \takefrom e: Original.Extension \by M.atlas.compatible c d old inLeft inRight (\bysub(OldCharts.Chart, M.atlas.charts, c)) (\bysub(OldCharts.Chart, M.atlas.charts, d)) \then
  \return \exact(Using[e := e].extension, New.Extension)
};
