\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\import boundary_manifolds.Model[n := n] \as Model;
\import boundary_manifolds.Tangent[n := n].On[M := M] \as Tangent;
\import Models.Chart[M := M.Point, space := M.space] \as Charts;
\import topology.Topology[Carrier := M.Point] \as Space;
\import Space.Compactness[] \as Compact;
\definition boundary: \Pow M.Point := { x: M.Point \where Tangent.At[x := x].Cones[].Boundary };
\definition interior: \Pow M.Point := Space.Complement boundary;
\definition Point: \Set := \Cast[M.Point] boundary;
\definition topology: topology.Structures[].Topology[Point] := Space.Subspace[S := boundary].topology M.space;
\definition Chart: \Set := \Cast[Charts.Chart] M.atlas.charts;
\module In(c: Chart);
\module At(x: M.Point, inside: Space.Member interior x);
\definition interiorOpen: Space.IsOpenIn M.space interior :=
  Space.openOfNeighborhoods M.space interior (\fun (x: M.Point)(inside: Space.Member interior x) => At[x := x, inside := inside].neighborhoodExists);
\definition closed: Space.IsClosedIn M.space boundary := interiorOpen;
\definition compact: Space.IsCompact M.space -> topology.Topology[Carrier := Point].IsCompact topology :=
  \fun (compact: Space.IsCompact M.space) => Space.Subspace[S := boundary].Properties[].compact M.space (Compact.closedCompact M.space compact boundary closed);
