\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import boundary_manifolds.Model[n := n] \as Source;
\import boundary_manifolds.Model[n := m] \as Middle;
\import boundary_manifolds.Model[n := l] \as Target;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import calculus.Real[].Multivariable[n := m].Open[] \as MiddleOpen;
\import calculus.Real[].Multivariable[n := l].Open[] \as Output;
\import calculus.Maps[n := n, m := m] \as FirstMaps;
\import calculus.Maps[n := m, m := l] \as SecondMaps;
\import calculus.Maps[n := n, m := l] \as Maps;
\import Sources.Chart[M := M.Point, space := M.space] \as SourceCharts;
\import Middles.Chart[M := N.Point, space := N.space] \as MiddleCharts;
\import Targets.Chart[M := P.Point, space := P.space] \as TargetCharts;
\definition function: M.Point -> P.Point := \fun (x: M.Point) => g (f x);
\import \root.LocalSmoothMap[n := n, m := m].Between[M := M, N := N].Of[function := f] \as Original;
\import \root.LocalSmoothMap[n := n, m := l].Between[M := M, N := P].Of[function := function] \as Destination;
\module Local(left: SourceCharts.Chart, right: TargetCharts.Chart, middle: MiddleCharts.Chart, x: M.Point,
  contains: SourceCharts.Contains left x, inMiddle: MiddleCharts.Contains middle (f x),
  p: First.At[function := f, left := left, right := middle, x := x, contains := contains].Extension,
  q: Second.At[function := g, left := middle, right := right, x := f x, contains := inMiddle].Extension);
\import \root.LocalSmoothMap[n := m, m := l].Between[M := N, N := P].Of[function := g] \as OriginalSecond;
\module At(x: M.Point, chosen: Original.Witness[x], next: OriginalSecond.Witness[f x]);
