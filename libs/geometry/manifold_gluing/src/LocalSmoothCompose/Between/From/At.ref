\definition left: Destination.SourceChart x := chosen.left;
\definition middle: Original.TargetChart (f x) := chosen.right;
\definition right: Destination.TargetChart (function x) := next.right;
\import Second.At[function := g, left := middle, right := right, x := f x, contains := Original.rightContains (f x) middle] \as Last;
\import OriginalSecond.Change[x := f x, left := middle, right := right,
  contains := Original.rightContains (f x) middle, containsImage := Destination.rightContains (function x) right, chosen := next] \as Adjust;
\module With(q: Last.Extension) {
  \import \root.LocalSmoothCompose[n := n, m := m, l := l].Between[M := M, N := N, P := P].From[f := f, g := g].Local[
    left := left, right := right, middle := middle, x := x, contains := Destination.leftContains x left,
    inMiddle := Original.rightContains (f x) middle, p := chosen.extension, q := q] \as Composition;
  \definition witness: Destination.Witness[x] := Destination.Witness[x] { left := left, right := right, extension := Composition.extension };
}
\definition exists: \exists Destination.Witness[x] := \block {
  \takefrom q: Last.Extension \by Adjust.existsExtension (Original.rightMember (f x) middle) (Destination.rightMember (function x) right) \then
  \return \exact(With[q := q].witness, Destination.Witness[x])
};
