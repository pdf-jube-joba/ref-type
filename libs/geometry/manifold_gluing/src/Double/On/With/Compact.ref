\import Gluing.Compact[leftCompact := compact, rightCompact := compact] \as Construction;
\definition Result: \Set := Construction.Result;
\definition manifold[result: Result]: Models.Manifold := Construction.manifold result;
\definition exists: \exists Result := Construction.exists;
\definition noBoundary: \forall (result: Result)(x: Point) -> Logic.Not boundary_manifolds.Tangent[n := Nat.add One.dimension n].On[M := manifold result].At[x := x].Cones[].Boundary :=
  \fun (result: Result)(x: Point) => result.noBoundary x;

\definition left[result: Result]: boundary_manifolds.SmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := M, N := manifold result].Map := result.left;
\definition right[result: Result]: boundary_manifolds.SmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := M, N := manifold result].Map := result.right;
