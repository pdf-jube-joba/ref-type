\import \root.BoundaryInclusion[n := n].On[M := M].With[cover := cover] \as BoundaryModel;
\import \root.DiffeomorphismIdentity[n := n].On[M := BoundaryModel.manifold] \as Identity;
\import \root.CompactGluing[n := n].Between[M := M, N := M].With[leftCover := cover, rightCover := cover].Along[d := Identity.value] \as Gluing;
\definition Point: \Set := Gluing.Point;
\definition topology: topology.Structures[].Topology[Point] := Gluing.topology;
\module Compact(compact: Space.IsCompact M.space);
