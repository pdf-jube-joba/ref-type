\import std.Data[].Nat[].Basic[].Def[] \as Nat;
\import std.Data[].Pair[] \as Pair;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import dedekind_reals.DedekindReal[] \as R;
\import calculus.Real[].OneDimension[] \as One;
\definition dimension: std.Data[].Nat[].Nat^ := Nat.add One.dimension n;
\import boundary_manifolds.Dimension[n := Nat.add One.dimension n] \as Models;
\import boundary_manifolds.Model[n := dimension] \as Model;
\import boundary_manifolds.Model[n := n] \as Parameters;
\import boundary_manifolds.Model[n := One.dimension] \as TimeModel;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Open;
\import calculus.Real[].Multivariable[n := One.dimension].Open[] \as TimeOpen;
\import calculus.Blocks[n := n, m := One.dimension] \as Blocks;
\import inverse_implicit.Product[n := n, m := One.dimension] \as Linear;
\import boundary_manifolds.Boundary[n := n] \as Boundary;
\import \root.Parameter[] \as Time;
\import \root.NormalCoordinate[n := n] \as Normal;
\module On(M: Models.Manifold);
