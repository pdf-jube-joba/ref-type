\import std.Set[].Extension[A := N.Point, B := M.Point, domain := U] \as Extend;
\definition function: N.Point -> M.Point := Extend.extend h.backward (h.backward y);
\definition inside: \forall (z: \Cast[N.Point] U) -> function z = h.backward z := Extend.inside h.backward (h.backward y);
\import \root.LocalSmoothMap[n := n, m := n].Between[M := N, N := M].Of[function := function] \as Locality;
\import boundary_manifolds.SmoothMap[n := n, m := n].Between[M := N, N := M] \as InverseMaps;
\definition Witness: \Set := Locality.Witness[y];
\module At(c: Transport.OldChart, contains: SourceCharts.Contains c (h.backward y));
\definition exists: \exists Witness := \block {
  \takefrom chosen: \Cast[SourceCharts.Chart] ({ c: SourceCharts.Chart \where Logic.And[\In[SourceCharts.Chart] M.atlas.charts c, SourceCharts.Contains c (h.backward y)] }) \by M.atlas.covers (h.backward y) \then
  \let laws: Logic.And[\In[SourceCharts.Chart] M.atlas.charts chosen, SourceCharts.Contains chosen (h.backward y)] := \bysub(SourceCharts.Chart,
    { c: SourceCharts.Chart \where Logic.And[\In[SourceCharts.Chart] M.atlas.charts c, SourceCharts.Contains c (h.backward y)] }, chosen) \then
  \let c: Transport.OldChart := \into[SourceCharts.Chart](chosen, M.atlas.charts) \by { laws.left } \then
  \return \exact(At[c := c, contains := laws.right].witness, Witness)
};
