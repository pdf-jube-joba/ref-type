\definition function[x: M.Point]: N.Point := h.forward x;
\import \root.LocalSmoothMap[n := n, m := n].Between[M := M, N := N].Of[function := function] \as Local;
\import topology.Homeomorphism[A := M.Point, B := \Cast[N.Point] U] \as Homeos;
\definition continuous: topology.Continuity[A := M.Point, B := N.Point].Continuous M.space N.space function :=
  topology.Composition[A := M.Point, B := \Cast[N.Point] U, C := N.Point].composeContinuous M.space (topology.Topology[Carrier := N.Point].Subspace[S := U].topology N.space) N.space
    h.forward (\fun (y: \Cast[N.Point] U) => y) (Homeos.laws _ _ h).forwardContinuous
    (topology.Continuity[A := \Cast[N.Point] U, B := N.Point].Corestriction[S := U].inclusionContinuous N.space);
\module At(x: M.Point, c: Transport.OldChart, contains: SourceCharts.Contains c x);
\definition local: \forall (x: M.Point) -> \exists Local.Witness[x] := \block {
  \fun (x: M.Point) \then
  \takefrom chosen: \Cast[SourceCharts.Chart] ({ c: SourceCharts.Chart \where Logic.And[\In[SourceCharts.Chart] M.atlas.charts c, SourceCharts.Contains c x] }) \by M.atlas.covers x \then
  \let laws: Logic.And[\In[SourceCharts.Chart] M.atlas.charts chosen, SourceCharts.Contains chosen x] := \bysub(SourceCharts.Chart,
    { c: SourceCharts.Chart \where Logic.And[\In[SourceCharts.Chart] M.atlas.charts c, SourceCharts.Contains c x] }, chosen) \then
  \let c: Transport.OldChart := \into[SourceCharts.Chart](chosen, M.atlas.charts) \by { laws.left } \then
  \return \exact(At[x := x, c := c, contains := laws.right].witness, Local.Witness[x])
};
\definition map: Maps.Map := Local.map continuous local;
\module InverseAt(y: \Cast[N.Point] U);
