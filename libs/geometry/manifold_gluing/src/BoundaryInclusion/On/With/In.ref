\import Atlas.In[c := c] \as Face;
\import manifolds.Dimension[n := n].Atlas[M := Atlas.Point, space := Atlas.topology] \as OrdinaryAtlas;
\definition originalMember: \In[OrdinaryCharts.Chart] Atlas.charts Face.chart :=
  Logic.existsIntro[Atlas.Chart, { d: Atlas.Chart \where Face.chart = Atlas.In[c := d].chart }] c (\refl(Face.chart));
\definition oldChart: Converted.OldChart := \into[OrdinaryCharts.Chart](Face.chart, BoundaryManifold.manifold.atlas.charts) \by {
  OrdinaryAtlas.includedInSaturation BoundaryManifold.atlas Face.chart originalMember
};
\import Converted.InChart[c := oldChart] \as Conversion;
\import Construction.On[patch := Conversion.patch] \as Patch;
\definition sourceMember: \In[SourceCharts.Chart] manifold.atlas.charts Patch.chart :=
  Logic.existsIntro[Construction.Adapted, { p: Construction.Adapted \where Patch.chart = Construction.On[patch := p].chart }] Conversion.patch (\refl(Patch.chart));
\definition left: Locality.SourceChart x := \into[SourceCharts.Chart](Patch.chart, Locality.SourceChart x) \by {
  Logic.And[_, _]::# sourceMember contains
};
\definition right: Locality.TargetChart (apply x) := \into[Charts.Chart](c, Locality.TargetChart (apply x)) \by {
  Logic.And[_, _]::# (Atlas.member c) contains
};
\import Maps.At[function := apply, left := left, right := right, x := x, contains := Locality.leftContains x left] \as Local;
\import inverse_implicit.Product[n := n, m := One.dimension] \as Linear;
\import calculus.LinearMap[n := n, m := Nat.add One.dimension n].On[U := Face.image, L := Linear.horizontal] \as Horizontal;
\definition included: Open.Included Face.image Patch.chart.image := \fun (u: Source.Point)(member: _) => member;
\definition raw[u: Source.Carrier Patch.chart.constraints Face.image]: Open.Carrier Face.image := u;
\definition target[u: Source.Carrier Patch.chart.constraints Face.image]: Charts.LocalPoint c := Face.pointValue (raw u);
\definition containsTarget: \forall (u: Source.Carrier Patch.chart.constraints Face.image) -> Charts.Contains c (apply (SourceCharts.point Patch.chart u)) :=
  \fun (u: Source.Carrier Patch.chart.constraints Face.image) => \bysub(M.Point, c.domain, target u);
\definition coordinateValue: \forall (u: Source.Carrier Patch.chart.constraints Face.image) ->
  (Charts.coordinate c (target u) \of Target.Point) = (calculus.Maps[n := n, m := Nat.add One.dimension n].apply Face.image Output.whole Horizontal.map u \of Target.Point) :=
  \fun (u: Source.Carrier Patch.chart.constraints Face.image) => Charts.coordinatePoint c (Face.coordinateInput (raw u));
\definition extension: Local.Extension := Local.Extension {
  neighborhood := Face.image, included := included,
  contains := \bysub(Source.Point, Face.image.points, SourceCharts.coordinate Patch.chart (\into[manifold.Point](x, Patch.chart.domain) \by { contains })),
  map := Horizontal.map,
  inside := containsTarget,
  agrees := \fun (u: Source.Carrier Patch.chart.constraints Face.image) => sym!{Target.Point} _ _ (coordinateValue u),
};
\definition witness: Locality.Witness[x] := Locality.Witness[x] { left := left, right := right, extension := extension };
