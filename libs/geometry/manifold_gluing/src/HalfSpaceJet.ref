\import std.Data[].Nat[].Basic[].Def[] \as Nat;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import S.Algebra[] \as Algebra;
\import S.Estimates[] \as Estimates;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import calculus.Real[].OneDimension[] \as One;
\definition dimension: std.Data[].Nat[].Nat^ := Nat.add One.dimension n;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Open;
\import calculus.Real[].Multivariable[n := n].Open[] \as LeftOpen;
\import calculus.Maps[n := dimension, m := dimension] \as Maps;
\import calculus.Maps[n := n, m := dimension] \as SliceMaps;
\import calculus.Blocks[n := n, m := One.dimension] \as Blocks;
\import inverse_implicit.Product[n := n, m := One.dimension] \as Linear;
\import topological_algebra.Euclidean[].Dimension[n := dimension].Def[] \as Coordinates;
\import topological_algebra.Euclidean[].Dimension[n := n].Def[] \as LeftCoordinates;
\import topological_algebra.Euclidean[].Dimension[n := One.dimension].Def[] \as TimeCoordinates;
\definition Point: \Set := Fin.Fin dimension -> S.Real;
\definition LeftPoint: \Set := Fin.Fin n -> S.Real;
\definition normal: Fin.Fin dimension := Fin.Sum[m := n, n := One.dimension].right One.index;
\definition zero: One.Index -> S.Real := \fun (i: One.Index) => S.zero;
\definition one: One.Index -> S.Real := \fun (i: One.Index) => S.one;
\definition BoundaryFixed[U: Open.OpenSet][f: Maps.Map U Open.whole]: \Prop := \forall (u: Open.Carrier U) -> u normal = S.zero -> (Maps.apply U Open.whole f u \of Point) = (u \of Point);
\module On(U: Open.OpenSet, f: Maps.Map U Open.whole, a: Open.Carrier U, zeroNormal: a normal = S.zero, fixed: BoundaryFixed U f);
