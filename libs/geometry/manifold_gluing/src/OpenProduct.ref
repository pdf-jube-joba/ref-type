\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import topology.Topology[Carrier := A] \as Left;
\import topology.Topology[Carrier := B] \as Right;
\import topology.Topology[Carrier := X] \as First;
\import topology.Topology[Carrier := Y] \as Second;
\import topological_constructions.Product[A := A, B := B] \as Target;
\import topological_constructions.Product[A := X, B := Y] \as Source;
\module On(left: Left.Topology, right: Right.Topology, first: First.Topology, second: Second.Topology);
