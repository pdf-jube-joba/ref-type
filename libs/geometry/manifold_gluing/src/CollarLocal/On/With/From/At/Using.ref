\import Coordinate.Using[e := e] \as Raw;
\import \root.HalfSpaceInverse[n := n].On[U := e.neighborhood, f := e.map, a := Raw.a, zeroNormal := Raw.zeroNormal, fixed := Raw.fixed] \as Inversion;
\module With(inverse: Inversion.Patch);
\definition exists: \exists Patch[b] := \block {
  \takefrom inverse: Inversion.Patch \by Raw.inverseExists \then
  \return \exact(With[inverse := inverse].patch, Patch[b])
};
\definition openExists: \exists OpenPatch[b] := \block {
  \takefrom inverse: Inversion.Patch \by Raw.inverseExists \then
  \return \exact(With[inverse := inverse].openPatch, OpenPatch[b])
};
