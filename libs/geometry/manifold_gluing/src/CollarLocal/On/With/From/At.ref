\import Coordinates.At[b := b, c := c, contains := contains] \as Coordinate;
\import Product.In[c := Coordinate.leftChart, d := Coordinate.timeChart] \as Chart;
\import Maps.At[function := Maps.apply map, left := Chart.chart, right := c, x := center b, contains := Coordinate.sourceContains] \as Local;
\module Using(e: Local.Extension);
\definition exists: \exists Patch[b] := \block {
  \takefrom e: Local.Extension \by Coordinate.smooth \then
  \return Using[e := e].exists
};
\definition openExists: \exists OpenPatch[b] := \block {
  \takefrom e: Local.Extension \by Coordinate.smooth \then
  \return Using[e := e].openExists
};
