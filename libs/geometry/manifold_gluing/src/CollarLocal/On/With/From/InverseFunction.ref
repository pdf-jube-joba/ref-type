\import std.Set[].Extension[A := M.Point, B := Product.Point, domain := range] \as Extend;
\definition function: M.Point -> Product.Point := Extend.extend backward (center b);
\definition inside: \forall (y: \Cast[M.Point] range) -> function y = backward y := Extend.inside backward (center b);
\import \root.LocalSmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := M, N := Product.manifold].Of[function := function] \as Locality;
\definition Witness[y: M.Point]: \Set := Locality.Witness[y];
