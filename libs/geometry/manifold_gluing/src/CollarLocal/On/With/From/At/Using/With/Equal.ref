\import calculus.Maps[n := Nat.add One.dimension n, m := Nat.add One.dimension n] \as Calculus;
\definition forwardEqual: Calculus.apply inverse.domain inverse.target inverse.change.forward (parameter x) = Calculus.apply inverse.domain inverse.target inverse.change.forward (parameter y) :=
  trans!{Model.Point} _ _ _ (forwardValue x)
    (trans!{Model.Point} _ _ _ (congr!{M.Point Model.Point} Total.coordinate _ _ same) (sym!{Model.Point} _ _ (forwardValue y)));
\definition parameterEqual: parameter x = parameter y := trans!{{Open.Carrier inverse.domain}} _ _ _
  (sym!{{Open.Carrier inverse.domain}} _ _ (inverse.change.leftInverse (parameter x)))
  (trans!{{Open.Carrier inverse.domain}} _ _ _
    (congr!{{Open.Carrier inverse.target} {Open.Carrier inverse.domain}} (Calculus.apply inverse.target inverse.domain inverse.change.backward) _ _ forwardEqual)
    (inverse.change.leftInverse (parameter y)));
\definition coordinateEqual: SourceCharts.coordinate Chart.chart (oldPoint x) = SourceCharts.coordinate Chart.chart (oldPoint y) :=
  Model.equality Chart.C Chart.image (SourceCharts.coordinate Chart.chart (oldPoint x)) (SourceCharts.coordinate Chart.chart (oldPoint y)) parameterEqual;
\definition law: (x \of Product.Point) = (y \of Product.Point) := trans!{{Product.Point}} _ _ _ (sym!{{Product.Point}} _ _ (SourceCharts.pointCoordinate Chart.chart (oldPoint x)))
  (trans!{{Product.Point}} _ _ _
    (congr!{{Model.Carrier Chart.C Chart.image} {Product.Point}} (\fun (u: Model.Carrier Chart.C Chart.image) => SourceCharts.point Chart.chart u) _ _ coordinateEqual)
    (SourceCharts.pointCoordinate Chart.chart (oldPoint y)));
