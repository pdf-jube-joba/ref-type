\import \root.CollarCoordinates[n := n].On[M := M].With[cover := cover].From[deformation := deformation] \as Coordinates;
\import boundary_manifolds.SmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := Product.manifold, N := M] \as Maps;
\definition map: Maps.Map := Coordinates.map;
\definition center[b: Inclusion.manifold.Point]: Product.Point := Pair.pair Inclusion.manifold.Point Time.Point b Time.zero;
\structure Patch[b: Inclusion.manifold.Point]: \Set := {
  domain: \Pow Product.Point,
  open: Space.IsOpenIn Product.topology domain,
  contains: Space.Member domain (center b),
  injective: \forall (x, y: Product.Point) -> Space.Member domain x -> Space.Member domain y -> Maps.apply map x = Maps.apply map y -> x = y,
};
\module InverseFunction(b: Inclusion.manifold.Point, range: \Pow M.Point, backward: \Cast[M.Point] range -> Product.Point);
\structure OpenPatch[b: Inclusion.manifold.Point]: \Set := {
  patch: Patch[b],
  range: \Pow M.Point,
  backward: \Cast[M.Point] range -> Product.Point,
  rangeOpen: topology.Topology[Carrier := M.Point].IsOpenIn M.space range,
  forwardIncluded: \forall (x: \Cast[Product.Point] patch.domain) -> \In[M.Point] range (Maps.apply map x),
  backwardInside: \forall (y: \Cast[M.Point] range) -> Space.Member patch.domain (backward y),
  rightInverse: \forall (y: \Cast[M.Point] range) -> Maps.apply map (backward y) = (y \of M.Point),
  localSmooth: \forall (y: \Cast[M.Point] range) -> \exists InverseFunction[b := b, range := range, backward := backward].Witness y,
  backwardContinuous: topology.Continuity[A := \Cast[M.Point] range, B := Product.Point].Continuous
    (topology.Topology[Carrier := M.Point].Subspace[S := range].topology M.space) Product.topology backward,
};
\module At(b: Inclusion.manifold.Point, c: Atlas.Chart, contains: Charts.Contains c b);
\definition local: \forall (b: Inclusion.manifold.Point) -> \exists Patch[b] := \block {
  \fun (b: Inclusion.manifold.Point) \then
  \takefrom c: \Cast[Atlas.Chart] ({ c: Atlas.Chart \where Charts.Contains c b }) \by cover b \then
  \return At[b := b, c := c, contains := \bysub(Atlas.Chart, { c: Atlas.Chart \where Charts.Contains c b }, c)].exists
};
\definition openLocal: \forall (b: Inclusion.manifold.Point) -> \exists OpenPatch[b] := \block {
  \fun (b: Inclusion.manifold.Point) \then
  \takefrom c: \Cast[Atlas.Chart] ({ c: Atlas.Chart \where Charts.Contains c b }) \by cover b \then
  \return At[b := b, c := c, contains := \bysub(Atlas.Chart, { c: Atlas.Chart \where Charts.Contains c b }, c)].openExists
};
