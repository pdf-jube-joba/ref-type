\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import R.Order[] \as Order;
\import calculus.Real[].OneDimension[] \as One;
\import \root.Reflection[n := n] \as First;
\import \root.Reflection[n := First.dimension] \as Second;
\definition dimension: N.Nat^ := Second.dimension;
\import Fin.Sum[m := First.dimension, n := One.dimension] \as Indices;
\definition firstNormal: Fin.Fin dimension := Indices.left First.normal;
\definition secondNormal: Fin.Fin dimension := Indices.right One.index;
\definition different: Logic.Not (firstNormal = secondNormal) := Indices.different First.normal One.index;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Open;
\import calculus.Real[].Multivariable[n := dimension].Space[].Def[] \as Coordinates;
\import calculus.Real[].Multivariable[n := dimension].Space[].Prop[] \as CoordinateLaws;
\import calculus.Real[].Multivariable[n := One.dimension].Open[] \as Line;
\import calculus.Maps[n := dimension, m := One.dimension] \as Maps;
\import topological_algebra.Euclidean[].Dimension[n := dimension].Topology[] \as Euclidean;
\import topology.Topology[Carrier := Fin.Fin dimension -> S.Real] \as Space;
\import metric_spaces.RealLine[].Rays[] \as Rays;
\definition points: \Pow (Fin.Fin dimension -> S.Real) := { x: Fin.Fin dimension -> S.Real \where R.Lt S.zero (x firstNormal) };
\definition domain: Open.OpenSet := Open.Topology[].ofOpen points
  (Euclidean.coordinateContinuous firstNormal (Rays.Above S.zero) (Rays.aboveOpen S.zero));
\definition Positive: \Set := \Cast[S.Real] ({ e: S.Real \where R.Lt S.zero e });
\module AtScale(epsilon: Positive);
