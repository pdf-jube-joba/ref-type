\import topology.Topology[Carrier := LeftBoundary.manifold.Point] \as BoundarySpace;
\definition boundaryCompact: BoundarySpace.IsCompact LeftBoundary.manifold.space := LeftInclusion.compact leftCompact;
\definition rightContinuous: topology.Continuity[A := LeftBoundary.manifold.Point, B := N.Point].Continuous LeftBoundary.manifold.space N.space right :=
  topology.Composition[A := LeftBoundary.manifold.Point, B := RightBoundary.manifold.Point, C := N.Point].composeContinuous
    LeftBoundary.manifold.space RightBoundary.manifold.space N.space (BoundaryMaps.apply d.forward) RightBoundary.apply d.forward.continuous RightBoundary.continuous;
\import \root.ClosedPushout[A := M.Point, B := N.Point, C := LeftBoundary.manifold.Point, u := left, v := right].On[
  left := M.space, right := N.space, boundary := LeftBoundary.manifold.space,
  leftHausdorff := M.hausdorff, rightHausdorff := N.hausdorff, compact := boundaryCompact,
  leftContinuous := LeftBoundary.continuous, rightContinuous := rightContinuous, injections := injections] \as Closed;
\definition source: topology.Structures[].Topology[Sum.Carrier] := Sum.topology M.space N.space;
\definition sourceCompact: topology.Topology[Carrier := Sum.Carrier].IsCompact source := Sum.Properties[left := M.space, right := N.space].compact leftCompact rightCompact;
\definition sourceHausdorff: topology.Topology[Carrier := Sum.Carrier].IsT2 source := Sum.Properties[left := M.space, right := N.space].hausdorff M.hausdorff N.hausdorff;
\import \root.ClosedSurjection[A := Sum.Carrier, B := Point].On[source := source, target := topology, q := Pushout.class,
  continuous := Quotient.projectionContinuous source, onto := Quotient.surjective, compact := sourceCompact, hausdorff := sourceHausdorff, closed := Closed.closedMap] \as Separation;
\definition hausdorff: topology.Topology[Carrier := Point].IsT2 topology := Separation.separated;
\definition t1: topology.Topology[Carrier := Point].IsT1 topology := Separation.t1;
\definition sourceCountable: topology.Topology[Carrier := Sum.Carrier].IsSecondCountable source :=
  \root.CoproductCountability[A := M.Point, B := N.Point].Of[left := M.space, right := N.space].secondCountable M.secondCountable N.secondCountable;
\definition secondCountable: topology.Topology[Carrier := Point].IsSecondCountable topology := Separation.SecondCountable[].exists sourceCountable;
