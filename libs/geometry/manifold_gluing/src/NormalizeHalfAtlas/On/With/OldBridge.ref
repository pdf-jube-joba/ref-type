\definition chosen: OldAt p := \into[Half.OldChart](c, { c: Half.OldChart \where Charts.Contains c p }) \by { \bysub(M.Point, c.domain, p) };
\import \root.ChartExtensionRebase[n := Nat.add One.dimension n].On[M := M].At[x := p, left := c, right := c,
  first := \bysub(M.Point, c.domain, p), second := oldContains p chosen].Of[e := Charts.Identity[c := c, x := p, member := \bysub(M.Point, c.domain, p)].extension] \as Change;
\definition value: Bridge[Indices.inl c, p] := Bridge[Indices.inl c, p] { old := chosen,
  toOld := Charts.Identity[c := c, x := p, member := \bysub(M.Point, c.domain, p)].extension, fromOld := Change.extension,
};
