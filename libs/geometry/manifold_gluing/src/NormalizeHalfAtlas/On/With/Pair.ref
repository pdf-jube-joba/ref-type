\definition localLeft: Charts.LocalPoint (chart i) := \into[M.Point](x, (chart i).domain) \by { first };
\definition localRight: Charts.LocalPoint (chart j) := \into[M.Point](x, (chart j).domain) \by { second };
\definition left: Bridge[i, localLeft] := bridge i localLeft;
\definition right: Bridge[j, localRight] := bridge j localRight;
\import \root.ChartExtensionRebase[n := Nat.add One.dimension n].On[M := M].At[x := x, left := chart i, right := left.old,
  first := \bysub(M.Point, (chart i).domain, localLeft), second := first].Of[e := left.toOld] \as First;
\import \root.ChartExtensionRebase[n := Nat.add One.dimension n].On[M := M].At[x := x, left := right.old, right := chart j,
  first := oldContains localRight right.old, second := oldContains x right.old].Of[e := right.fromOld] \as Second;
\module Using(old: Charts.At[x := x, left := left.old, right := right.old, inLeft := (oldContains x left.old)].Extension);
\definition exists: \exists Charts.At[x := x, left := chart i, right := chart j, inLeft := first].Extension := \block {
  \takefrom old: Charts.At[x := x, left := left.old, right := right.old, inLeft := (oldContains x left.old)].Extension \by M.atlas.compatible left.old right.old x (oldContains x left.old) (oldContains x right.old)
    (\bysub(Charts.Chart, M.atlas.charts, left.old)) (\bysub(Charts.Chart, M.atlas.charts, right.old)) \then
  \return \exact(Using[old := old].extension, Charts.At[x := x, left := chart i, right := chart j, inLeft := first].Extension)
};
