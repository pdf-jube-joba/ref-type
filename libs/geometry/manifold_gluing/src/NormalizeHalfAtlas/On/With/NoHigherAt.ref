\import boundary_manifolds.Tangent[n := Nat.add One.dimension n].On[M := manifold].At[x := x] \as T;
\definition Single[c: T.Chart]: \Prop := \forall (i, j: Model.Coordinate) -> Model.Active c.constraints (T.coordinate c) i -> Model.Active c.constraints (T.coordinate c) j -> i = j;
\definition Witness: \Set := \Cast[T.Chart] ({ c: T.Chart \where Single c });
\module Half(c: Boundary.Chart, contains: Charts.Contains c x);
\module Interior(interior: Logic.Not T.Cones[].Boundary);
\definition exists: \exists Witness := Logic.orElim T.Cones[].Boundary (Logic.Not T.Cones[].Boundary) (\exists Witness) (Classical.excludedMiddle T.Cones[].Boundary)
  (\block {
    \fun (boundary: T.Cones[].Boundary) \then
    \let point: Boundary.Point := \into[M.Point](x, Boundary.points) \by { boundary } \then
    \takefrom c: \Cast[Boundary.Chart] ({ c: Boundary.Chart \where Charts.Contains c x }) \by boundaryCover point \then
    \return \exact(Half[c := c, contains := \bysub(Boundary.Chart, { c: Boundary.Chart \where Charts.Contains c x }, c)].witness, Witness)
  })
  (\fun (interior: Logic.Not T.Cones[].Boundary) => Interior[interior := interior].exists);
