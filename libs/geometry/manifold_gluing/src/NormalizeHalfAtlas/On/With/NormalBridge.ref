\import \root.NormalHalfChart[n := n].On[M := M].In[data := d].At[x := p, contains := \bysub(M.Point, (chart (Indices.inr d)).domain, p)] \as Original;
\definition chosen: OldAt p := \into[Half.OldChart](d.chart, { c: Half.OldChart \where Charts.Contains c p }) \by { Original.oldContains };
\import \root.ChartExtensionRebase[n := Nat.add One.dimension n].On[M := M].At[x := p, left := d.chart, right := chart (Indices.inr d),
  first := Original.oldContains, second := oldContains p chosen].Of[e := Original.fromOld] \as Change;
\definition value: Bridge[Indices.inr d, p] := Bridge[Indices.inr d, p] { old := chosen, toOld := Original.toOld, fromOld := Change.extension };
