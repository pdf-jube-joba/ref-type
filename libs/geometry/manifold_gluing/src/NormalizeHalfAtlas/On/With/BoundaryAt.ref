\import boundary_manifolds.Tangent[n := Nat.add One.dimension n].On[M := M].At[x := x] \as Original;
\import boundary_manifolds.Tangent[n := Nat.add One.dimension n].On[M := manifold].At[x := x] \as New;
\module In(c: Half.OldChart, contains: Charts.Contains c x);
\definition oldBoundary: Original.Cones[].Boundary := \block {
  \takefrom c: \Cast[Charts.Chart] ({ c: Charts.Chart \where Logic.And[\In[Charts.Chart] M.atlas.charts c, Charts.Contains c x] }) \by M.atlas.covers x \then
  \let laws: Logic.And[\In[Charts.Chart] M.atlas.charts c, Charts.Contains c x] := \bysub(Charts.Chart, { c: Charts.Chart \where Logic.And[\In[Charts.Chart] M.atlas.charts c, Charts.Contains c x] }, c) \then
  \let old: Half.OldChart := \into[Charts.Chart](c, M.atlas.charts) \by { laws.left } \then
  \return In[c := old, contains := laws.right].boundary
};
\module From(d: Half.Data, contains: Half.Contains d x);
\definition exists: \exists (c: Boundary.Chart \where Charts.Contains c x) := \block {
  \takefrom d: \Cast[Half.Data] ({ d: Half.Data \where Half.Contains d x }) \by cover x oldBoundary \then
  \return From[d := d, contains := \bysub(Half.Data, { d: Half.Data \where Half.Contains d x }, d)].cover
};
