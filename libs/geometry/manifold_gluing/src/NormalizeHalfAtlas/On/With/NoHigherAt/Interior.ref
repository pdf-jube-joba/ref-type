\module In(c: T.Chart) {
  \definition witness: Witness := \into[T.Chart](c, { c: T.Chart \where Single c }) \by { \fun (i, j: Model.Coordinate)(first: Model.Active c.constraints (T.coordinate c) i)(second: Model.Active c.constraints (T.coordinate c) j) => Logic.falseElim (i = j) (interior (T.Cones[].boundaryOfCoordinate c (Logic.existsIntro[Model.Coordinate, { k: Model.Coordinate \where Model.Active c.constraints (T.coordinate c) k }] i first))) };
}
\definition exists: \exists Witness := \block { \takefrom c: T.Chart \by T.chartExists \then \return \exact(In[c := c].witness, Witness) };
