\definition chart: T.Chart := \into[Charts.Chart](c, T.Chart) \by { T.ChartLaws[c] { member := Boundary.member c, contains := contains } };
\definition index: Model.Coordinate := boundary_manifolds.Boundary[n := n].normal;
\definition selected: \forall (i: Model.Coordinate) -> \In[Model.Coordinate] c.constraints i -> i = index := \fun (i: Model.Coordinate)(member: \In[Model.Coordinate] c.constraints i) =>
  \idelim c.constraints = Model.halfSpace index \with C: Model.Constraints => \In[Model.Coordinate] C i \by { base: member, equality: Boundary.constraints c };
\definition witness: Witness := \into[T.Chart](chart, { c: T.Chart \where Single c }) \by { \fun (i, j: Model.Coordinate)(first: Model.Active chart.constraints (T.coordinate chart) i)(second: Model.Active chart.constraints (T.coordinate chart) j) => trans!{{Model.Coordinate}} _ _ _ (selected i first.left) (sym!{{Model.Coordinate}} _ _ (selected j second.left)) };
