\import Charts.Compose[x := x, left := chart i, middle := left.old, right := right.old, inLeft := first, inMiddle := (oldContains x left.old), inRight := (oldContains x right.old), first := First.extension, second := old] \as ComposedFirst;
\import Charts.Compose[x := x, left := chart i, middle := right.old, right := chart j, inLeft := first, inMiddle := (oldContains x right.old), inRight := second, first := ComposedFirst.extension, second := Second.extension] \as ComposedSecond;
\definition extension: Charts.At[x := x, left := chart i, right := chart j, inLeft := first].Extension := ComposedSecond.extension;
