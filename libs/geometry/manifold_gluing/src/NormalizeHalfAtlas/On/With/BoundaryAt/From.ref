\import \root.NormalHalfChart[n := n].On[M := M].In[data := d] \as Normalized;
\definition half: Boundary.Chart := \into[Charts.Chart](Normalized.chart, Boundary.Chart) \by { Boundary.HalfChartLaws[Normalized.chart] {
  member := Logic.existsIntro[Index, { i: Index \where Normalized.chart = chart i }] (Indices.inr d) (\refl(Normalized.chart)),
  constraints := \refl(boundary_manifolds.Model[n := Nat.add One.dimension n].halfSpace boundary_manifolds.Boundary[n := n].normal),
} };
\definition chart: \Cast[Boundary.Chart] ({ c: Boundary.Chart \where Charts.Contains c x }) := \into[Boundary.Chart](half, { c: Boundary.Chart \where Charts.Contains c x }) \by { contains };
\definition cover: \exists (c: Boundary.Chart \where Charts.Contains c x) := Logic.existsIntro[Boundary.Chart, { c: Boundary.Chart \where Charts.Contains c x }] half contains;
