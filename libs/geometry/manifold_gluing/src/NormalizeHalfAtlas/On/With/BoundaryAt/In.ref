\definition left: Original.Chart := \into[Charts.Chart](c, Original.Chart) \by { Original.ChartLaws[c] { member := \bysub(Charts.Chart, M.atlas.charts, c), contains := contains } };
\definition right: New.Chart := \into[Charts.Chart](c, New.Chart) \by { New.ChartLaws[c] { member := oldMember c, contains := contains } };
\definition boundary: Original.Cones[].Boundary := Original.Cones[].boundaryOfCoordinate left (New.Cones[].coordinateOfBoundary right (\bysub(M.Point, Boundary.points, x)));
