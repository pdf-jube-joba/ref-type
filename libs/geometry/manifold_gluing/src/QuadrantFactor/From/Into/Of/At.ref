\definition left: Local.SourceChart x := \into[SourceCharts.Chart](c, Local.SourceChart x) \by { Logic.And[_, _]::# (\bysub(SourceCharts.Chart, M.atlas.charts, c)) contains };
\definition right: Local.TargetChart (function x) := \into[Charts.Chart](Target.chart, Local.TargetChart (function x)) \by { Logic.And[_, _]::# (\refl(Target.chart)) (\refl(function x)) };
\import Maps.At[function := Maps.apply f, left := left, right := Original.chart, x := x, contains := Local.leftContains x left] \as Old;
\import Result.At[function := function, left := left, right := right, x := x, contains := Local.leftContains x left] \as New;
\module With(e: Old.Extension) {
  \definition extension: New.Extension := New.Extension {
    neighborhood := e.neighborhood, included := e.included, contains := e.contains, map := e.map,
    inside := \fun (u: SourceModel.Carrier c.constraints e.neighborhood) => \refl(function (SourceCharts.point c (\into[Open.Carrier c.image](Open.inclusion e.neighborhood c.image e.included u, SourceModel.region c.constraints c.image) \by { \bysub(Open.Carrier e.neighborhood, SourceModel.region c.constraints e.neighborhood, u) }))),
    agrees := e.agrees,
  };
  \definition witness: Local.Witness[x] := Local.Witness[x] { left := left, right := right, extension := extension };
}
\definition exists: \exists Local.Witness[x] := \block {
  \takefrom e: Old.Extension \by f.smooth left Original.chart x (Local.leftContains x left) (Local.leftMember x left) (\refl(Original.chart)) (\refl(Maps.apply f x)) \then
  \return \exact(With[e := e].witness, Local.Witness[x])
};
