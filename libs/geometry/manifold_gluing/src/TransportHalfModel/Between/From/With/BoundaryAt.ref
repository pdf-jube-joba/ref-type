
\import \root.BoundaryTransport[n := n].Between[M := M, N := N].From[U := U, open := open, h := h].At[c := c, y := y, member := chartMember c, contains := contains] \as Boundary;
\import Transport.In[c := c] \as Patch;
\definition rangeEqual: Patch.range Boundary.point = y := boundary_manifolds.Refinement[A := N.Point].equality U (Patch.range Boundary.point) y (\refl(y \of N.Point));
\definition pointEqual: Boundary.old = h.backward y := congr!{{\Cast[N.Point] U} {M.Point}} h.backward _ _ rangeEqual;
\definition boundary: boundary_manifolds.Tangent[n := n].On[M := N].At[x := y].Cones[].Boundary -> boundary_manifolds.Tangent[n := n].On[M := M].At[x := h.backward y].Cones[].Boundary := \fun (member: boundary_manifolds.Tangent[n := n].On[M := N].At[x := y].Cones[].Boundary) =>
 \idelim Boundary.old = h.backward y \with p: M.Point => boundary_manifolds.Tangent[n := n].On[M := M].At[x := p].Cones[].Boundary \by { base: Boundary.boundary member, equality: pointEqual };
