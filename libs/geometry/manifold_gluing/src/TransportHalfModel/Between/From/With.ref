
\module BoundaryAt(y: \Cast[N.Point] U, c: Transport.OldChart, contains: Charts.Contains Transport.In[c := c].chart y);
\definition boundary: \forall (y: \Cast[N.Point] U) -> boundary_manifolds.Tangent[n := n].On[M := N].At[x := y].Cones[].Boundary -> boundary_manifolds.Tangent[n := n].On[M := M].At[x := h.backward y].Cones[].Boundary := \block {
 \fun (y: \Cast[N.Point] U)(boundary: boundary_manifolds.Tangent[n := n].On[M := N].At[x := y].Cones[].Boundary) \then
 \takefrom c: \Cast[Transport.OldChart] ({ c: Transport.OldChart \where Charts.Contains Transport.In[c := c].chart y }) \by Transport.covers y \then
 \return BoundaryAt[y := y, c := c, contains := \bysub(Transport.OldChart, { c: Transport.OldChart \where Charts.Contains Transport.In[c := c].chart y }, c)].boundary boundary
};
\module At(y: \Cast[N.Point] U, d: Source.Data, member: Source.Contains d (h.backward y));
\definition cover: \forall (y: \Cast[N.Point] U) -> boundary_manifolds.Tangent[n := n].On[M := N].At[x := y].Cones[].Boundary -> \exists (d: Target.Data \where Target.Contains d y) := \block {
 \fun (y: \Cast[N.Point] U)(member: boundary_manifolds.Tangent[n := n].On[M := N].At[x := y].Cones[].Boundary) \then
 \takefrom d: \Cast[Source.Data] ({ d: Source.Data \where Source.Contains d (h.backward y) }) \by sourceCover (h.backward y) (boundary y member) \then
 \return At[y := y, d := d, member := \bysub(Source.Data, { d: Source.Data \where Source.Contains d (h.backward y) }, d)].exists
};
