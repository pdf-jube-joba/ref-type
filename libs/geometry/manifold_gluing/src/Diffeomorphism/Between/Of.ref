\import \root.Diffeomorphism[n := m, m := n].Between[M := N, N := M] \as Reverse;
\definition inverse: Reverse.Diffeomorphism := Reverse.Diffeomorphism {
  forward := d.backward, backward := d.forward,
  leftInverse := (laws d).rightInverse, rightInverse := (laws d).leftInverse,
};
\definition injective: \forall (x, y: M.Point) -> Forward.apply d.forward x = Forward.apply d.forward y -> x = y :=
  \fun (x, y: M.Point)(same: _) => trans!{M.Point} _ _ _ (sym!{M.Point} _ _ ((laws d).leftInverse x))
    (trans!{M.Point} _ _ _ (congr!{{N.Point} {M.Point}} (Backward.apply d.backward) _ _ same) ((laws d).leftInverse y));
\definition homeomorphism: topology.Homeomorphism[A := M.Point, B := N.Point].Homeomorphism[M.space, N.space] :=
  topology.Homeomorphism[A := M.Point, B := N.Point].Homeomorphism[M.space, N.space] {
    forward := Forward.apply d.forward, backward := Backward.apply d.backward,
    leftInverse := (laws d).leftInverse, rightInverse := (laws d).rightInverse,
    forwardContinuous := (\bysub(Forward.Data, Forward.Map, d.forward)).continuous,
    backwardContinuous := (\bysub(Backward.Data, Backward.Map, d.backward)).continuous,
  };
