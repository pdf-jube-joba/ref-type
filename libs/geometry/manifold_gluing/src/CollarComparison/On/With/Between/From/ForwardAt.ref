\import Left.InverseAt[y := x] \as Inverse;
\import \root.CollarEmbedding[n := n].On[M := M].With[cover := cover].From[deformation := right] \as RightMap;
\import \root.LocalSmoothPostcompose[n := Nat.add One.dimension n, m := Nat.add One.dimension n, l := Nat.add One.dimension n].Between[
  M := M, N := Product.manifold, P := M].From[f := Inverse.function, g := RightMap.map] \as Composition;
\definition function: M.Point -> M.Point := Composition.function;
\definition agrees: \forall (z: Left.ImagePoint) -> function z = (forward z \of M.Point) :=
  \fun (z: Left.ImagePoint) => congr!{{Product.Point} M.Point} (Maps.apply RightMap.map) _ _ (Inverse.inside z);
\import \root.LocalSmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := M, N := M].Of[function := function] \as Locality;
\definition exists: \exists Locality.Witness[x] := \block {
  \takefrom chosen: Inverse.Witness \by Inverse.exists \then
  \return Composition.At[x := (x \of M.Point), chosen := chosen].exists
};
