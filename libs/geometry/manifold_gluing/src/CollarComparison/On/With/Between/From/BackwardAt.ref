\import Right.InverseAt[y := y] \as Inverse;
\import \root.CollarEmbedding[n := n].On[M := M].With[cover := cover].From[deformation := left] \as LeftMap;
\import \root.LocalSmoothPostcompose[n := Nat.add One.dimension n, m := Nat.add One.dimension n, l := Nat.add One.dimension n].Between[
  M := M, N := Product.manifold, P := M].From[f := Inverse.function, g := LeftMap.map] \as Composition;
\definition function: M.Point -> M.Point := Composition.function;
\definition agrees: \forall (z: Right.ImagePoint) -> function z = (backward z \of M.Point) :=
  \fun (z: Right.ImagePoint) => congr!{{Product.Point} M.Point} (Maps.apply LeftMap.map) _ _ (Inverse.inside z);
\import \root.LocalSmoothMap[n := Nat.add One.dimension n, m := Nat.add One.dimension n].Between[M := M, N := M].Of[function := function] \as Locality;
\definition exists: \exists Locality.Witness[y] := \block {
  \takefrom chosen: Inverse.Witness \by Inverse.exists \then
  \return Composition.At[x := (y \of M.Point), chosen := chosen].exists
};
