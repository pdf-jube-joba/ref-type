\import \root.CollarStrip[n := n].On[M := M].With[cover := cover].From[deformation := left] \as LeftStrip;
\import \root.CollarStrip[n := n].On[M := M].With[cover := cover].From[deformation := right] \as RightStrip;
\module From(leftRegular: LeftStrip.RegularUniform, rightRegular: RightStrip.RegularUniform);
