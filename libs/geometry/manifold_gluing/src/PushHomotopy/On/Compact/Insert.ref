\definition oldIncluded[included: Included (Finite.Insert U Y)]: Included Y :=
  \fun (V: \Pow M.Point)(member: _) => included V (Logic.Or[_, _]::right member);
\module With(p: Patch, same: U = p.domain, h: Homotopy, works: Works Y h) {
  \import \root.PushHomotopy[n := n].On[M := M].Composition[first := h, second := p.homotopy] \as Composition;
  \definition homotopy: Homotopy := Composition.homotopy;
  \definition joined: Works (Finite.Insert U Y) Composition.homotopy :=
    \fun (x: M.Point)(member: _) => Space.unionMemberElim (Finite.Insert U Y) x (Activates Composition.homotopy x)
      (\fun (V: \Pow M.Point)(selected: _)(inside: _) => Logic.orElim (V = U) (Space.FamilyMember Y V) (Activates Composition.homotopy x) selected
        (\fun (equal: _) => Composition.activatesSecond x (p.activates x
          (\idelim V = p.domain \with W: \Pow M.Point => Space.Member W x \by {
            base: inside, equality: trans!{{\Pow M.Point}} _ _ _ equal same
          })))
        (\fun (old: _) => Composition.activatesFirst x (works x (Space.unionMemberOf Y V x old inside)))) member;
}
\definition law: \In[\Pow (\Pow M.Point)] Predicate (Finite.Insert U Y) := \block {
  \fun (included: Included (Finite.Insert U Y)) \then
  \takefrom p: \Cast[Patch] ({ p: Patch \where U = p.domain }) \by included U (Finite.inInsertNew U Y) \then
  \takefrom h: \Cast[Homotopy] ({ h: Homotopy \where Works Y h }) \by previous (oldIncluded included) \then
  \return Logic.existsIntro[Homotopy, { h: Homotopy \where Works (Finite.Insert U Y) h }]
    With[p := p, same := \bysub(Patch, { p: Patch \where U = p.domain }, p), h := h, works := \bysub(Homotopy, { h: Homotopy \where Works Y h }, h)].homotopy
    With[p := p, same := \bysub(Patch, { p: Patch \where U = p.domain }, p), h := h, works := \bysub(Homotopy, { h: Homotopy \where Works Y h }, h)].joined
};
