\import std.Data[].Nat[].Basic[].Def[] \as Nat;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.congr;
\import boundary_manifolds.Dimension[n := n] \as LeftModels;
\import boundary_manifolds.Dimension[n := m] \as RightModels;
\import boundary_manifolds.Model[n := n] \as Left;
\import boundary_manifolds.Model[n := m] \as Right;
\import boundary_manifolds.Model[n := Nat.add m n] \as Model;
\import boundary_manifolds.Product[n := n, m := m] \as Products;
\import Fin.Sum[m := n, n := m] \as Indices;
\definition impossible: \forall (i: Indices.Index) -> Products.Selected Left.unconstrained Right.unconstrained i -> Logic.False := \induction (i: Indices.Index) \return Products.Selected Left.unconstrained Right.unconstrained i -> Logic.False \with {
  | inl: \fun (i: Left.Coordinate)(member: Logic.False) => member
  | inr: \fun (i: Right.Coordinate)(member: Logic.False) => member
};
\definition empty: Products.constraints Left.unconstrained Right.unconstrained = Model.unconstrained := \axiom:setext(Products.constraints Left.unconstrained Right.unconstrained, Model.unconstrained,
  (\fun (i: Model.Coordinate)(member: \In[Model.Coordinate] (Products.constraints Left.unconstrained Right.unconstrained) i) => impossible (Indices.split i) member),
  (\fun (i: Model.Coordinate)(member: Logic.False) => Logic.falseElim (\In[Model.Coordinate] (Products.constraints Left.unconstrained Right.unconstrained) i) member));
\module Between(M: LeftModels.Manifold, N: RightModels.Manifold);
