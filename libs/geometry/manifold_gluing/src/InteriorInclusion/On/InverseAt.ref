\import std.Set[].Extension[A := M.Point, B := manifold.Point, domain := Interior.points] \as Extend;
\definition function: M.Point -> manifold.Point := Extend.extend Converted.forward x;
\definition inside: \forall (p: Interior.Point) -> function p = Converted.forward p := Extend.inside Converted.forward x;
\definition convertedRight: Converted.forward (Converted.backward x) = x :=
  (topology.Homeomorphism[A := Interior.Point, B := manifold.Point].laws Interior.topology manifold.space Converted.comparison).rightInverse x;
\definition initial: function x = x := trans!{{manifold.Point}} _ _ _ (inside x) convertedRight;
\import \root.LocalSmoothMap[n := n, m := n].Between[M := M, N := manifold].Of[function := function] \as Locality;
\definition Witness: \Set := Locality.Witness[x];
\module In(c: Interior.Chart, contains: TargetCharts.Contains c x);
\definition exists: \exists Witness := \block {
  \takefrom c: \Cast[TargetCharts.Chart] ({ c: TargetCharts.Chart \where Logic.And[\In[TargetCharts.Chart] M.atlas.charts c, TargetCharts.Contains c x] }) \by M.atlas.covers x \then
  \let data: Logic.And[\In[TargetCharts.Chart] M.atlas.charts c, TargetCharts.Contains c x] := \bysub(TargetCharts.Chart, { c: TargetCharts.Chart \where Logic.And[\In[TargetCharts.Chart] M.atlas.charts c, TargetCharts.Contains c x] }, c) \then
  \let chart: Interior.Chart := \into[TargetCharts.Chart](c, M.atlas.charts) \by { data.left } \then
  \return \exact(In[c := chart, contains := data.right].witness, Witness)
};
