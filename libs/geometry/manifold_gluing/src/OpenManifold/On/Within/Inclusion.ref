\definition apply[x: Point]: M.Point := x;
\import boundary_manifolds.SmoothMap[n := n, m := n].Between[M := manifold, N := M] \as Maps;
\import \root.LocalSmoothMap[n := n, m := n].Between[M := manifold, N := M].Of[function := apply] \as Local;
\definition continuous: topology.Continuity[A := Point, B := M.Point].Continuous topology M.space apply := topology.Continuity[A := Point, B := M.Point].Corestriction[S := U].inclusionContinuous M.space;
\module At(x: Point, patch: Patch, contains: Charts.Contains (chart patch) x);
\definition local: \forall (x: Point) -> \exists Local.Witness[x] := \block {
  \fun (x: Point) \then
  \takefrom patch: \Cast[Patch] ({ p: Patch \where Charts.Contains (chart p) x }) \by covers x \then
  \return \exact(At[x := x, patch := patch, contains := \bysub(Patch, { p: Patch \where Charts.Contains (chart p) x }, patch)].witness, Local.Witness[x])
};
\definition map: Maps.Map := Local.map continuous local;
\module InverseAt(x: Point);
