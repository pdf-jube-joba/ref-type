\import std.Set[].Extension[A := M.Point, B := Point, domain := U] \as Extend;
\definition function: M.Point -> Point := Extend.extend (\fun (p: Point) => p) x;
\definition inside: \forall (p: Point) -> function p = p := Extend.inside (\fun (p: Point) => p) x;
\import \root.LocalSmoothMap[n := n, m := n].Between[M := M, N := manifold].Of[function := function] \as Locality;
\import boundary_manifolds.SmoothMap[n := n, m := n].Between[M := M, N := manifold] \as InverseMaps;
\definition Witness: \Set := Locality.Witness[x];
\module In(patch: Patch, contains: Charts.Contains (chart patch) x);
\definition exists: \exists Witness := \block {
  \takefrom patch: \Cast[Patch] ({ p: Patch \where Charts.Contains (chart p) x }) \by covers x \then
  \return \exact(In[patch := patch, contains := \bysub(Patch, { p: Patch \where Charts.Contains (chart p) x }, patch)].witness, Witness)
};
