\import topology.Homeomorphism[A := Original.LocalPoint c, B := Model.Carrier c.constraints c.image] \as Homeos;
\definition inverseContinuous: topology.Continuity[A := Model.Carrier c.constraints c.image, B := M.Point].Continuous
  (Model.regionTopology c.constraints c.image) M.space (\fun (u: Model.Carrier c.constraints c.image) => Original.point c u) :=
  topology.Composition[A := Model.Carrier c.constraints c.image, B := Original.LocalPoint c, C := M.Point].composeContinuous
    (Model.regionTopology c.constraints c.image) (Original.domainTopology c.domain) M.space (Original.point c) (\fun (p: Original.LocalPoint c) => p)
    (Homeos.laws _ _ c.coordinates).backwardContinuous (topology.Continuity[A := Original.LocalPoint c, B := M.Point].Corestriction[S := c.domain].inclusionContinuous M.space);
\definition region: \Pow (Model.Carrier c.constraints c.image) := { u: Model.Carrier c.constraints c.image \where OriginalSpace.Member U (Original.point c u) };
\import \root.QuadrantOpen[n := n].On[C := c.constraints, U := c.image].At[W := region, open := inverseContinuous U open] \as Choice;
\definition Representative: \Set := Choice.Representative;
\definition exists: \exists Representative := Choice.exists;
