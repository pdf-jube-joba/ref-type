\definition c: OldChart := patch.source;
\definition image: Open.OpenSet := patch.representative.domain;
\import \parent.In[c := c] \as OriginalPatch;
\import \root.QuadrantOpen[n := n].On[C := c.constraints, U := c.image] \as Quarter;
\definition domain: \Pow Point := { p: Point \where Original.Contains c p };
\definition LocalPoint: \Set := \Cast[Point] domain;
\definition domainTopology: topology.Structures[].Topology[LocalPoint] := Charts.domainTopology domain;
\definition domainOpen: topology.Topology[Carrier := Point].IsOpenIn topology domain := Subspace.traceOpen M.space c.domain c.open;
\definition old[p: LocalPoint]: Original.LocalPoint c := \into[M.Point](p, c.domain) \by { \bysub(Point, domain, p) };
\definition inRegion: \forall (p: LocalPoint) -> \In[Model.Carrier c.constraints c.image] OriginalPatch.region (Original.coordinate c (old p)) :=
  \fun (p: LocalPoint) => \idelim (p \of M.Point) = (Original.point c (Original.coordinate c (old p)) \of M.Point)
    \with x: M.Point => OriginalSpace.Member U x \by {
      base: \bysub(M.Point, U, p), equality: sym!{{M.Point}} _ _ (Original.pointCoordinate c (old p))
    };
\definition coordinate[p: LocalPoint]: Model.Carrier c.constraints image :=
  \into[Open.Carrier image](\into[Model.Point](Original.coordinate c (old p), image.points) \by { patch.representative.captures (Original.coordinate c (old p)) (inRegion p) },
    Model.region c.constraints image) \by { \bysub(Open.Carrier c.image, Model.region c.constraints c.image, Original.coordinate c (old p)) };
\definition input[u: Model.Carrier c.constraints image]: Model.Carrier c.constraints c.image := Quarter.include image patch.representative.included u;
\definition value[u: Model.Carrier c.constraints image]: Point := \into[M.Point](Original.point c (input u), U) \by { patch.representative.within u };
\definition point[u: Model.Carrier c.constraints image]: LocalPoint := \into[Point](value u, domain) \by { \bysub(M.Point, c.domain, Original.point c (input u)) };
\definition inputCoordinate: \forall (p: LocalPoint) -> input (coordinate p) = Original.coordinate c (old p) :=
  \fun (p: LocalPoint) => Model.equality c.constraints c.image (input (coordinate p)) (Original.coordinate c (old p)) (\refl(Original.coordinate c (old p) \of Model.Point));
\definition leftInverse: \forall (p: LocalPoint) -> point (coordinate p) = p := \fun (p: LocalPoint) => boundary_manifolds.Refinement[A := Point].equality domain (point (coordinate p)) p
  (boundary_manifolds.Refinement[A := M.Point].equality U (point (coordinate p)) p
    (trans!{{M.Point}} _ _ _ (congr!{{Model.Carrier c.constraints c.image} {M.Point}} (\fun (u: Model.Carrier c.constraints c.image) => Original.point c u) _ _ (inputCoordinate p)) (Original.pointCoordinate c (old p))));
\definition oldPoint: \forall (u: Model.Carrier c.constraints image) -> old (point u) = Original.point c (input u) :=
  \fun (u: Model.Carrier c.constraints image) => boundary_manifolds.Refinement[A := M.Point].equality c.domain (old (point u)) (Original.point c (input u)) (\refl(Original.point c (input u) \of M.Point));
\definition rightInverse: \forall (u: Model.Carrier c.constraints image) -> coordinate (point u) = u := \fun (u: Model.Carrier c.constraints image) => Model.equality c.constraints image (coordinate (point u)) u
  (trans!{Model.Point} _ _ _ (congr!{{Original.LocalPoint c} {Model.Point}} (\fun (p: Original.LocalPoint c) => Original.coordinate c p) _ _ (oldPoint u))
    (congr!{{Model.Carrier c.constraints c.image} {Model.Point}} (\fun (p: Model.Carrier c.constraints c.image) => p) _ _ (Original.coordinatePoint c (input u))));
\module Continuity;
\definition chart: Charts.Chart := Charts.Chart {
  domain := domain, image := image, constraints := c.constraints, open := domainOpen,
  coordinates := topology.Homeomorphism[A := LocalPoint, B := Model.Carrier c.constraints image].Homeomorphism[domainTopology, Model.regionTopology c.constraints image] {
    forward := coordinate, backward := point, leftInverse := leftInverse, rightInverse := rightInverse,
    forwardContinuous := Continuity[].coordinateContinuous, backwardContinuous := Continuity[].pointContinuous,
  },
};
