\import \parent.For[patch := left] \as Left;
\import \parent.For[patch := right] \as Right;
\definition c: OldChart := left.source;
\definition d: OldChart := right.source;
\import Original.At[x := (x \of M.Point), left := c, right := d, inLeft := contains] \as Old;
\import Charts.At[x := x, left := Left.chart, right := Right.chart, inLeft := contains] \as New;
\definition originalPointEqual: Old.sourcePoint = Left.old New.sourcePoint := boundary_manifolds.Refinement[A := M.Point].equality c.domain Old.sourcePoint (Left.old New.sourcePoint) (\refl(x \of M.Point));
\definition sourceEqual: (Old.source \of Model.Point) = (New.source \of Model.Point) := congr!{{Original.LocalPoint c} {Model.Point}} (\fun (p: Original.LocalPoint c) => Original.coordinate c p) _ _ originalPointEqual;
\module Using(e: Old.Extension);
\definition exists: \exists New.Extension := \block {
  \takefrom e: Old.Extension \by M.atlas.compatible c d x contains otherContains (\bysub(Original.Chart, M.atlas.charts, c)) (\bysub(Original.Chart, M.atlas.charts, d)) \then
  \return \exact(Using[e := e].extension, New.Extension)
};
