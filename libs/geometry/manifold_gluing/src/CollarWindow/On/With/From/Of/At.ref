\definition times: \Pow Time.Point := { t: Time.Point \where R.Lt (Time.value t) a };
\definition timesOpen: topology.Topology[Carrier := Time.Point].IsOpenIn Time.manifold.space times := Model.Topology[C := Time.constraints, U := Time.domain].ambient ({ t: Model.Point \where R.Lt (t One.index) a })
  (Ambient.coordinateContinuous One.index (Line.Rays[].Below a) (Line.Rays[].belowOpen a));
\definition points: \Pow Product.Point := { p: Product.Point \where R.Lt (Time.value (Product.second p)) a };
\definition open: Space.IsOpenIn Product.topology points := topological_constructions.Product[A := Inclusion.manifold.Point, B := Time.Point].Maps[].secondContinuous Inclusion.manifold.space Time.manifold.space times timesOpen;
\definition inside: Space.Subset points Collar.domain := \fun (p: Product.Point)(member: Space.Member points p) => within (Product.second p) member;
\import \root.CollarRestriction[n := n].On[M := M].With[cover := cover].From[deformation := deformation].Of[regular := regular].Within[V := points, open := open, inside := inside] \as Window;
\definition image: \Pow M.Point := Window.image;
\definition imageOpen: Target.IsOpenIn M.space image := Window.imageOpen;
\module Core(r: S.Real, positive: R.Lt S.zero r, small: R.Lt r a);
