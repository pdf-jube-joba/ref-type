\import boundary_manifolds.Tangent[n := p].On[M := P].At[x := x] \as Domain;
\import boundary_manifolds.Tangent[n := n].On[M := M].At[x := f.apply x] \as LeftTangent;
\import boundary_manifolds.Tangent[n := m].On[M := N].At[x := g.apply x] \as RightTangent;
\import boundary_manifolds.Tangent[n := Nat.add m n].On[M := Product.manifold].At[x := Pairing.apply x] \as Codomain;
\import \root.ProductDifferential[n := n, m := m].Of[M := M, N := N].At[x := Pairing.apply x] \as ProductTangent;
\import boundary_manifolds.Differential[n := p, m := n].Between[M := P, N := M].At[f := f, x := x] \as D1;
\import boundary_manifolds.Differential[n := p, m := m].Between[M := P, N := N].At[f := g, x := x] \as D2;
\import boundary_manifolds.Differential[n := p, m := Nat.add m n].Between[M := P, N := Product.manifold].At[f := map, x := x] \as D;
\module InCharts(a: Domain.Chart, c: LeftTangent.Chart, d: RightTangent.Chart);
\definition law: \forall (v: Domain.Vector) -> D.value.apply v = ProductTangent.pair (D1.value.apply v) (D2.value.apply v) := \block {
  \fun (v: Domain.Vector) \then
  \takefrom a: Domain.Chart \by Domain.chartExists \then
  \takefrom c: LeftTangent.Chart \by LeftTangent.chartExists \then
  \takefrom d: RightTangent.Chart \by RightTangent.chartExists \then
  \return InCharts[a := a, c := c, d := d].law v
};
