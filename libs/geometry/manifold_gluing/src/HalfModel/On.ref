\import Models.Chart[M := M.Point, space := M.space] \as Charts;
\import boundary_manifolds.Tangent[n := n].On[M := M] \as Tangent;
\import topology.Topology[Carrier := M.Point] \as Space;
\definition OldChart: \Set := \Cast[Charts.Chart] M.atlas.charts;
\structure Data: \Set := {
  chart: OldChart,
  source: Open.OpenSet,
  included: Open.Included source chart.image,
  normal: Model.Coordinate,
  equivalent: \forall (u: Open.Carrier source) -> Logic.PropEquiv[Model.Nonnegative chart.constraints u, Model.Nonnegative (Model.halfSpace normal) u],
};
\module In(data: Data);
\definition Contains[data: Data][x: M.Point]: \Prop := \In[M.Point] \root.HalfModel[n := n].On[M := M].In[data := data].domain x;
\definition Cover: \Prop := \forall (x: M.Point) -> Tangent.At[x := x].Cones[].Boundary -> \exists (d: Data \where Contains d x);
\module Full(c: OldChart, i: Model.Coordinate, same: c.constraints = Model.halfSpace i);
