\definition equivalent: \forall (u: Open.Carrier c.image) -> Logic.PropEquiv[Model.Nonnegative c.constraints u, Model.Nonnegative (Model.halfSpace i) u] := \fun (u: Open.Carrier c.image) => Logic.PropEquiv[_, _] {
  ltr := \fun (member: Model.Nonnegative c.constraints u) => \idelim c.constraints = Model.halfSpace i \with C: Model.Constraints => Model.Nonnegative C u \by { base: member, equality: same },
  rtl := \fun (member: Model.Nonnegative (Model.halfSpace i) u) => \idelim Model.halfSpace i = c.constraints \with C: Model.Constraints => Model.Nonnegative C u \by { base: member, equality: sym!{{Model.Constraints}} _ _ same },
};
\definition data: Data := Data { chart := c, source := c.image, included := \fun (u: Model.Point)(member: _) => member, normal := i, equivalent := equivalent };
\import \root.ChartRestriction[n := n].On[M := M].Of[c := c].Within[U := c.image, included := \fun (u: Model.Point)(member: \In[Model.Point] c.image.points u) => member] \as Restriction;
\definition contains: \forall (x: M.Point) -> Charts.Contains c x -> Contains data x := \fun (x: M.Point)(member: Charts.Contains c x) => Restriction.containsFrom (\into[M.Point](x, c.domain) \by { member })
  (\bysub(Model.Point, c.image.points, Charts.coordinate c (\into[M.Point](x, c.domain) \by { member })));
