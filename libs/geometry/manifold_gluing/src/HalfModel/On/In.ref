\import \root.ChartRestriction[n := n].On[M := M].Of[c := data.chart].Within[U := data.source, included := data.included] \as Restriction;
\definition domain: \Pow M.Point := Restriction.domain;
\definition open: Space.IsOpenIn M.space domain := Restriction.domainOpen;
\definition Point: \Set := Restriction.Point;
\definition old[p: Point]: Charts.LocalPoint data.chart := Restriction.old p;
\definition inside: \forall (p: Point) -> \In[Model.Point] data.source.points (Charts.coordinate data.chart (old p)) := Restriction.inSource;
