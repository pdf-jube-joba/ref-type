\definition local: Restricted.Point := \into[M.Point](x, Restricted.domain) \by { contains };
\definition oldContains: Charts.Contains data.chart x := \bysub(M.Point, data.chart.domain, Restricted.old local);
\import Charts.Compose[x := x, left := chart, middle := Restricted.chart, right := data.chart, inLeft := contains, inMiddle := contains, inRight := oldContains,
  first := Reparametrized.ToOld[x := x, contains := contains].extension, second := Restricted.ToOld[x := x, contains := contains].extension] \as ToOld;
\import Charts.Compose[x := x, left := data.chart, middle := Restricted.chart, right := chart, inLeft := oldContains, inMiddle := contains, inRight := contains,
  first := Restricted.FromOld[x := x, contains := oldContains, inRestricted := contains].extension, second := Reparametrized.FromOld[x := x, contains := contains].extension] \as FromOld;
\definition toOld: Charts.At[x := x, left := chart, right := data.chart, inLeft := contains].Extension := ToOld.extension;
\definition fromOld: Charts.At[x := x, left := data.chart, right := chart, inLeft := oldContains].Extension := FromOld.extension;
