\import \parent.InCharts[c := c, d := d] \as InCharts;
\definition equals: \forall (u: LeftTangent.Vector)(v: RightTangent.Vector) -> pair u v = InCharts.pair u v :=
  \fun (u: LeftTangent.Vector)(v: RightTangent.Vector) => injective _ _
    (trans!{{LeftTangent.Vector}} _ _ _ (firstPair u v) (sym!{{LeftTangent.Vector}} _ _ (InCharts.firstPair u v)))
    (trans!{{RightTangent.Vector}} _ _ _ (secondPair u v) (sym!{{RightTangent.Vector}} _ _ (InCharts.secondPair u v)));
\definition pairCoordinates: \forall (u: LeftTangent.Vector)(v: RightTangent.Vector) ->
  Tangent.Coordinate[chart := InCharts.total].decode (pair u v) = Blocks.join (LeftTangent.Coordinate[chart := c].decode u) (RightTangent.Coordinate[chart := d].decode v) :=
  \fun (u: LeftTangent.Vector)(v: RightTangent.Vector) => trans!{Source.Point} _ _ _
    (congr!{{Tangent.Vector} Source.Point} Tangent.Coordinate[chart := InCharts.total].decode _ _ (equals u v))
    (Tangent.Coordinate[chart := InCharts.total].decodeEncode (Blocks.join (LeftTangent.Coordinate[chart := c].decode u) (RightTangent.Coordinate[chart := d].decode v)));
