\definition containsProduct: Charts.Contains halfChart p := Logic.And[_, _]::# contains (\refl(Product.second p));
\definition local: Charts.LocalPoint halfChart := \into[Product.Point](p, halfChart.domain) \by { containsProduct };
\import \root.HalfChartBoundary[n := n].On[M := Product.manifold].In[c := halfChart] \as Criterion;
\import calculus.Blocks[n := n, m := One.dimension] \as Blocks;
\definition coordinateNormal: Charts.coordinate halfChart local \root.HalfProduct[n := n].normal = Time.value (Product.second p) :=
  congr!{{One.Index -> real.Analysis[].Real} {real.Analysis[].Real}} (\fun (t: One.Index -> real.Analysis[].Real) => t One.index) _ _ (Blocks.rightJoin (BaseCharts.coordinate baseChart (Patch.leftPoint local)) (Product.second p));
\definition boundary: Logic.PropEquiv[\In[Product.Point] Boundary.points p, Time.value (Product.second p) = real.Analysis[].zero] := Logic.PropEquiv[_, _] {
  ltr := \fun (member: \In[Product.Point] Boundary.points p) => trans!{real.Analysis[].Real} _ _ _ (sym!{real.Analysis[].Real} _ _ coordinateNormal) (Criterion.normalZero local member),
  rtl := \fun (zero: Time.value (Product.second p) = real.Analysis[].zero) => Criterion.At[p := local].boundary (trans!{real.Analysis[].Real} _ _ _ coordinateNormal zero),
};
