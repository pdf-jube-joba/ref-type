\import Base.InChart[c := c] \as Converted;
\import BaseConstruction.On[patch := Converted.patch] \as BasePatch;
\definition baseChart: Product.LeftChart := \into[BaseCharts.Chart](BasePatch.chart, Base.manifold.atlas.charts) \by {
  Logic.existsIntro[BaseConstruction.Adapted, { p: BaseConstruction.Adapted \where BasePatch.chart = BaseConstruction.On[patch := p].chart }] Converted.patch (\refl(BasePatch.chart))
};
\definition timeChart: Product.RightChart := \into[TimeCharts.Chart](Time.chart, Time.manifold.atlas.charts) \by { Time.chartMember };
\import Product.In[c := baseChart, d := timeChart] \as Patch;
\definition index: Product.Index := Pair.pair Product.LeftChart Product.RightChart baseChart timeChart;
\definition chartMember: \In[Charts.Chart] Product.manifold.atlas.charts Patch.chart := Logic.existsIntro[Product.Index, { p: Product.Index \where Patch.chart = Product.chart p }] index (\refl(Patch.chart));
\definition halfChart: Boundary.Chart := \into[Charts.Chart](Patch.chart, Boundary.Chart) \by { Boundary.HalfChartLaws[Patch.chart] { member := chartMember, constraints := \root.HalfProduct[n := n].constraints } };
\module At(p: Product.Point, contains: OrdinaryCharts.Contains c (Product.first p));
