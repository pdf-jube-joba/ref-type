\import boundary_manifolds.Boundaryless[n := n].Of[M := B] \as Base;
\import boundary_manifolds.Ambient[n := n].Over[M := B, S := topology.Topology[Carrier := B.Point].Whole] \as BaseConstruction;
\import boundary_manifolds.Product[n := n, m := One.dimension].Of[M := Base.manifold, N := Time.manifold] \as Product;
\import Models.Chart[M := Product.Point, space := Product.topology] \as Charts;
\import BaseModels.Chart[M := Base.manifold.Point, space := Base.manifold.space] \as BaseCharts;
\import manifolds.Dimension[n := n].Chart[M := B.Point, space := B.space] \as OrdinaryCharts;
\import boundary_manifolds.Dimension[n := One.dimension].Chart[M := Time.Point, space := Time.manifold.space] \as TimeCharts;
\import boundary_manifolds.Boundary[n := n].Of[M := Product.manifold] \as Boundary;
\definition OldChart: \Set := \Cast[OrdinaryCharts.Chart] B.atlas.charts;
\module In(c: OldChart);
\definition cover: Boundary.Cover := \block {
  \fun (x: Boundary.Point) \then
  \takefrom c: \Cast[OrdinaryCharts.Chart] ({ c: OrdinaryCharts.Chart \where Logic.And[\In[OrdinaryCharts.Chart] B.atlas.charts c, OrdinaryCharts.Contains c (Product.first x)] }) \by B.atlas.covers (Product.first x) \then
  \let laws: Logic.And[\In[OrdinaryCharts.Chart] B.atlas.charts c, OrdinaryCharts.Contains c (Product.first x)] := \bysub(OrdinaryCharts.Chart, { c: OrdinaryCharts.Chart \where Logic.And[\In[OrdinaryCharts.Chart] B.atlas.charts c, OrdinaryCharts.Contains c (Product.first x)] }, c) \then
  \let old: OldChart := \into[OrdinaryCharts.Chart](c, B.atlas.charts) \by { laws.left } \then
  \return Logic.existsIntro[Boundary.Chart, { h: Boundary.Chart \where Charts.Contains h x }] In[c := old].halfChart (Logic.And[_, _]::# laws.right (\refl(Product.second x)))
};
