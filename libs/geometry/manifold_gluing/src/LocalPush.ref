\import R.Order[] \as Order;
\import \root.Reflection[n := n] \as Normal;
\definition dimension: N.Nat^ := Normal.dimension;
\import smooth_partitions.Euclidean[n := dimension] \as Functions;
\definition Point: \Set := Fin.Fin dimension -> S.Real;
\module On(a: Point, q: Functions.Positive);
