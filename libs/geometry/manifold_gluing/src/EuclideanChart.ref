\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as Euclidean;
\import topological_algebra.Euclidean[].Dimension[n := n].Countability[] \as Countability;
\definition Point: \Set := Open.Carrier Open.whole;
\definition ambient: topology.Structures[].Topology[Point] := Open.Topology[].Of[U := Open.whole].topology;
\module On(A: \Set, source: topology.Structures[].Topology[A], h: topology.Homeomorphism[A := A, B := Point].Homeomorphism[source, ambient]);
