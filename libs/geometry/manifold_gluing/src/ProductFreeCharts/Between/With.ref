\module At(x: Product.Point, c: LeftFree.At[x := Product.first x].Witness, d: RightFree.At[x := Product.second x].Witness);
\definition cover: Free.Cover := \block {
  \fun (x: Product.Point) \then \takefrom c: LeftFree.At[x := Product.first x].Witness \by leftCover (Product.first x) \then
  \takefrom d: RightFree.At[x := Product.second x].Witness \by rightCover (Product.second x) \then
  \return \exact(At[x := x, c := c, d := d].witness, Free.At[x := x].Witness)
};
