\import Products.Of[M := M, N := N] \as Product;
\import \root.FreeCharts[n := n].On[M := M] \as LeftFree;
\import \root.FreeCharts[n := m].On[M := N] \as RightFree;
\import \root.FreeCharts[n := Nat.add m n].On[M := Product.manifold] \as Free;
\import boundary_manifolds.Dimension[n := Nat.add m n].Chart[M := Product.Point, space := Product.topology] \as Charts;
\import LeftModels.Chart[M := M.Point, space := M.space] \as LeftCharts;
\import RightModels.Chart[M := N.Point, space := N.space] \as RightCharts;
\module With(leftCover: LeftFree.Cover, rightCover: RightFree.Cover);
