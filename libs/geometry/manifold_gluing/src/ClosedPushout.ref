\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import topology.Topology[Carrier := A] \as Left;
\import topology.Topology[Carrier := B] \as Right;
\import topology.Topology[Carrier := C] \as Boundary;
\import \root.Seam[A := A, B := B, C := C, u := u, v := v] \as Seam;
\import topological_constructions.Pushout[A := A, B := B, C := C].Of[u := u, v := v] \as Pushout;
\module On(left: Left.Topology, right: Right.Topology, boundary: Boundary.Topology,
  leftHausdorff: Left.IsT2 left, rightHausdorff: Right.IsT2 right, compact: Boundary.IsCompact boundary,
  leftContinuous: topology.Continuity[A := C, B := A].Continuous boundary left u,
  rightContinuous: topology.Continuity[A := C, B := B].Continuous boundary right v, injections: Seam.Injections);
