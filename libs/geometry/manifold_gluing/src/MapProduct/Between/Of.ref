\definition first: boundary_manifolds.SmoothMap[n := Nat.add m n, m := p].Between[M := Source.manifold, N := P].Map :=
  boundary_manifolds.MapComposition[n := Nat.add m n, m := n, l := p].Between[M := Source.manifold, N := M, P := P].Of[f := Projections.First[].map, g := f].map;
\definition second: boundary_manifolds.SmoothMap[n := Nat.add m n, m := q].Between[M := Source.manifold, N := Q].Map :=
  boundary_manifolds.MapComposition[n := Nat.add m n, m := m, l := q].Between[M := Source.manifold, N := N, P := Q].Of[f := Projections.Second[].map, g := g].map;
\definition map: boundary_manifolds.SmoothMap[n := Nat.add m n, m := Nat.add q p].Between[M := Source.manifold, N := Target.manifold].Map :=
  \root.ProductMaps[n := p, m := q].Of[M := P, N := Q].Pairing[p := Nat.add m n].From[P := Source.manifold].Using[f := first, g := second].map;
