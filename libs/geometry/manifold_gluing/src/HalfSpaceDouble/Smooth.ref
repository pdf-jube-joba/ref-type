\import \parent.Inverse[] \as Inverse;
\import \root.EuclideanChart[n := dimension].On[A := Point, source := topology, h := Inverse.homeomorphism] \as Construction;
\import manifolds.Dimension[n := dimension].Smooth[] \as Models;
\definition manifold: Models.Manifold := Construction.manifold;
\import manifolds.Dimension[n := dimension].Chart[M := Point, space := topology] \as Charts;
\definition chart: Charts.Chart := Construction.chart;
\definition coordinate[x: Point]: AmbientPoint := forward x;
\definition onLeft: \forall (x: Half) -> coordinate (Pushout.inl x) = reflect x := forwardLeft;
\definition onRight: \forall (x: Half) -> coordinate (Pushout.inr x) = x := forwardRight;
\definition inverse[x: AmbientPoint]: Point := Inverse.backward x;
\definition coordinateInverse: \forall (x: AmbientPoint) -> coordinate (inverse x) = x := Inverse.rightInverse;
\definition inverseCoordinate: \forall (x: Point) -> inverse (coordinate x) = x := Inverse.leftInverse;
