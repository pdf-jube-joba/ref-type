\definition existence: left = Domain.chart -> right = Codomain.chart ->
  \exists Maps.At[function := apply, left := left, right := right, x := x, contains := contains].Extension :=
  \fun (sameLeft: _)(sameRight: _) => \idelim Domain.chart = left \with c: SourceCharts.Chart => \forall (inside: SourceCharts.Contains c x) ->
    \exists Maps.At[function := apply, left := c, right := right, x := x, contains := inside].Extension \by {
      base: \fun (inside: _) => \idelim Codomain.chart = right \with d: TargetCharts.Chart =>
        \exists Maps.At[function := apply, left := Domain.chart, right := d, x := x, contains := inside].Extension \by {
          base: \exact(\parent.At[x := x, contains := inside].extension,
            Maps.At[function := apply, left := Domain.chart, right := Codomain.chart, x := x, contains := inside].Extension),
          equality: sym!{{TargetCharts.Chart}} _ _ sameRight
        }, equality: sym!{{SourceCharts.Chart}} _ _ sameLeft
    } contains;
