\import Maps.At[function := apply, left := Domain.chart, right := Codomain.chart, x := x, contains := contains] \as Local;
\import Calculus.Corestriction[U := U, V := V, W := Output.whole, f := f, inside := \fun (u: Open.Carrier U) => \refl(Calculus.apply U V f u)] \as Corestriction;
\definition extension: Local.Extension := Local.Extension {
  neighborhood := U, included := \fun (u: Source.Point)(inside: _) => inside,
  contains := \bysub(Source.Point, U.points, x), map := Corestriction.map,
  inside := \fun (u: Source.Carrier C U) => \refl(apply u),
  agrees := \fun (u: Source.Carrier C U) => \refl(Calculus.apply U V f u),
};
\definition jacobian: Local.Using[e := extension].jacobian = Calculus.Differential[U := U, V := V, f := f, a := x].value := Corestriction.differential x;
