\import Charts.At[x := x, left := left, right := right, inLeft := contains] \as Change;
\import Maps.At[function := \fun (x: M.Point) => x, left := left, right := right, x := x, contains := contains] \as Local;
\definition existence: \exists Change.Extension -> \exists Local.Extension := \block {
  \fun (compatible: \exists Change.Extension) \then
  \takefrom e: Change.Extension \by compatible \then
  \return \exact(Local.Extension {
    neighborhood := e.neighborhood, included := e.included, contains := e.contains, map := e.map, inside := e.inside, agrees := e.agrees,
  }, Local.Extension)
};
