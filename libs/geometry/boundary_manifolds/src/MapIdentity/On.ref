\import std.Logic[].Proposition[] \as Logic;
\import \root.SmoothMap[n := n, m := n].Between[M := M, N := M] \as Maps;
\import Models.Chart[M := M.Point, space := M.space] \as Charts;
\import topology.Maps[A := M.Point, B := M.Point].Identity[] \as Identity;
\definition data: Maps.Data := Maps.Data { apply := \fun (x: M.Point) => x };
\module At(left, right: Charts.Chart, x: M.Point, contains: Charts.Contains left x);
\definition map: Maps.Map := \into[Maps.Data](data, { data: Maps.Data \where Maps.Laws[data] }) \by {
  Maps.Laws[data] {
    continuous := Identity.continuous M.space,
    smooth := \fun (left, right: Charts.Chart)(x: M.Point)(contains: _)(lm: _)(rm: _)(inRight: _) => At[left := left, right := right, x := x, contains := contains].existence
      (M.atlas.compatible left right x contains inRight lm rm),
  }
};
