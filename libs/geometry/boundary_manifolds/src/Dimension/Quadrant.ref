\import \root.Dimension[n := n] \as Model;
\definition Point: \Set := Carrier C U;
\definition topology: topology.Structures[].Topology[Point] := regionTopology C U;
\import topology.Topology[Carrier := Point] \as Space;
\import Space.Subspace[S := Space.Whole] \as Whole;
\import \parent.Chart[M := Point, space := topology] \as Charts;
\import \parent.Atlas[M := Point, space := topology] \as Atlas;
\import topology.Continuity[A := Point, B := Point].Corestriction[S := Space.Whole] \as IntoWhole;
\import topology.Maps[A := Point, B := Point].Identity[] \as Identity;
\definition identity[x: Point]: Charts.Domain Space.Whole := \into[Point](x, Space.Whole) \by { \refl(x) };
\definition chart: Charts.Chart := Charts.Chart {
  domain := Space.Whole, image := U, constraints := C,
  coordinates := topology.Homeomorphism[A := Charts.Domain Space.Whole, B := Point].Homeomorphism[Charts.domainTopology Space.Whole, topology] {
    forward := \fun (x: Charts.Domain Space.Whole) => x, backward := identity,
    leftInverse := \fun (x: Charts.Domain Space.Whole) => \refl(x), rightInverse := \fun (x: Point) => \refl(x),
    forwardContinuous := Whole.traceOpen topology,
    backwardContinuous := IntoWhole.corestrictContinuous topology topology identity (Identity.continuous topology),
  },
  open := (Space.topologyLaws topology).wholeOpen,
};
\definition compatible: \forall (c, d: Charts.Chart)(x: Point)(left: Charts.Contains c x)(right: Charts.Contains d x) -> c = chart -> d = chart ->
  \exists Charts.At[x := x, left := c, right := d, inLeft := left].Extension :=
  \fun (c, d: Charts.Chart)(x: Point)(left: _)(right: _)(sameC: c = chart)(sameD: d = chart) =>
    \idelim chart = c \with p: Charts.Chart => \forall (contains: Charts.Contains p x) ->
      \exists Charts.At[x := x, left := p, right := d, inLeft := contains].Extension \by {
        base: \fun (contains: _) => \idelim chart = d \with q: Charts.Chart => \forall (included: Charts.Contains q x) ->
          \exists Charts.At[x := x, left := chart, right := q, inLeft := contains].Extension \by {
            base: \fun (included: _) => \exact(Charts.Identity[c := chart, x := x, member := contains].extension,
              Charts.At[x := x, left := chart, right := chart, inLeft := contains].Extension),
            equality: sym!{{Charts.Chart}} _ _ sameD
          } right,
        equality: sym!{{Charts.Chart}} _ _ sameC
      } left;
\definition atlas: Atlas.Atlas := Atlas.Atlas {
  charts := { c: Charts.Chart \where c = chart },
  covers := \fun (x: Point) => Logic.existsIntro[Charts.Chart, { c: Charts.Chart \where Logic.And[c = chart, Charts.Contains c x] }] chart
    (Logic.And[_, _]::# (\refl(chart)) (\refl(x))),
  compatible := compatible,
};
\import topology.Topology[Carrier := Open.Carrier U].Subspace[S := region C U].Properties[] \as Properties;
\import topology.Topology[Carrier := Core.Point].Subspace[S := U.points].Properties[] \as AmbientProperties;
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as Ambient;
\import topological_algebra.Euclidean[].Dimension[n := n].Countability[] \as Countability;
\definition manifold: Model.Manifold := Model.Manifold {
  Point := Point, space := topology, atlas := atlas,
  hausdorff := Properties.hausdorff (Open.Topology[].Of[U := U].topology) (AmbientProperties.hausdorff Ambient.topology Ambient.hausdorff),
  secondCountable := Properties.secondCountable (Open.Topology[].Of[U := U].topology) (AmbientProperties.secondCountable Ambient.topology Countability.secondCountable),
};
