\import \parent.Chart[M := M, space := space] \as Charts;
\structure Data: \Set := { charts: \Pow Charts.Chart, };
\definition Member[data: Data][c: Charts.Chart]: \Prop := \In[Charts.Chart] data.charts c;
\structure Laws[data: Data]: \Prop := {
  covers: \forall (x: M) -> \exists ( c: Charts.Chart \where Logic.And[Member data c, Charts.Contains c x] ),
  compatible: \forall (c, d: Charts.Chart)(x: M)(left: Charts.Contains c x)(right: Charts.Contains d x) -> Member data c -> Member data d ->
    \exists Charts.At[x := x, left := c, right := d, inLeft := left].Extension,
};
\definition Atlas: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
