\definition common: Open.OpenSet := Open.intersection leftExtension.neighborhood rightExtension.neighborhood;
\definition center: Carrier left.constraints common := \into[Open.Carrier common](\into[Point](source, common.points) \by {
  Logic.And[_, _]::# leftExtension.contains rightExtension.contains
}, region left.constraints common) \by { \bysub(Open.Carrier left.image, region left.constraints left.image, source) };
\import \root.Extensions[n := n, m := n].Local[C := left.constraints, U := leftExtension.neighborhood, V := rightExtension.neighborhood,
  f := leftExtension.map, g := rightExtension.map, a := center] \as Comparison;
\definition unique: \parent.Using[extension := leftExtension].jacobian = \parent.Using[extension := rightExtension].jacobian :=
  Comparison.unique (\fun (u: Carrier left.constraints common) => trans!{Point} _ _ _ (leftExtension.agrees
    (\into[Open.Carrier leftExtension.neighborhood](Open.inclusion common leftExtension.neighborhood (Open.intersectionLeft leftExtension.neighborhood rightExtension.neighborhood) u, region left.constraints leftExtension.neighborhood) \by {
      \bysub(Open.Carrier common, region left.constraints common, u)
    })) (sym!{Point} _ _ (rightExtension.agrees
      (\into[Open.Carrier rightExtension.neighborhood](\into[Point](u, rightExtension.neighborhood.points) \by {
        Open.intersectionRight leftExtension.neighborhood rightExtension.neighborhood u (\bysub(Point, common.points, u))
      }, region left.constraints rightExtension.neighborhood) \by { \bysub(Open.Carrier common, region left.constraints common, u) }))));
