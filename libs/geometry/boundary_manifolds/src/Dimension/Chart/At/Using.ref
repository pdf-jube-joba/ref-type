\definition center: Carrier left.constraints extension.neighborhood :=
  \into[Open.Carrier extension.neighborhood](\into[Point](source, extension.neighborhood.points) \by { extension.contains }, region left.constraints extension.neighborhood) \by {
    \bysub(Open.Carrier left.image, region left.constraints left.image, source)
  };
\definition jacobian: calculus.Vector[n := n, m := n].LinearMap := Maps.Differential[U := extension.neighborhood, V := Open.whole, f := extension.map, a := center].value;
\definition rightContains: Contains right x := \idelim point left source = (x \of M) \with p: M => Contains right p \by {
  base: extension.inside center, equality: pointCoordinate left sourcePoint
};
\definition targetPoint: LocalPoint right := \into[M](x, right.domain) \by { rightContains };
\definition target: Carrier right.constraints right.image := coordinate right targetPoint;
\definition returned: LocalPoint right := \into[M](point left source, right.domain) \by { extension.inside center };
\import std.Set[].Extension[A := M, B := Point, domain := right.domain] \as Extend;
\definition coordinateFunction[p: LocalPoint right]: Point := coordinate right p;
\definition centerValue: Maps.apply extension.neighborhood Open.whole extension.map center = target :=
  trans!{Point} _ _ _ (extension.agrees center) (trans!{Point} _ _ _
    (sym!{Point} _ _ (Extend.inside coordinateFunction Coordinates.origin returned))
    (trans!{Point} _ _ _
      (congr!{M Point} (Extend.extend coordinateFunction Coordinates.origin) _ _ (pointCoordinate left sourcePoint))
      (Extend.inside coordinateFunction Coordinates.origin targetPoint)));

\import \root.ConeMap[n := n, m := n].On[C := left.constraints, D := right.constraints, U := extension.neighborhood,
  V := Open.whole, f := extension.map, a := center] \as Cones;
\definition preserves: Cones.Preserves := \fun (u: Carrier left.constraints extension.neighborhood) =>
  \idelim coordinate right (\into[M](point left (\into[Open.Carrier left.image](Open.inclusion extension.neighborhood left.image extension.included u,
    region left.constraints left.image) \by { \bysub(Open.Carrier extension.neighborhood, region left.constraints extension.neighborhood, u) }), right.domain) \by { extension.inside u }) =
    Maps.apply extension.neighborhood Open.whole extension.map u \with p: Point => Nonnegative right.constraints p \by {
      base: \bysub(Open.Carrier right.image, region right.constraints right.image,
        coordinate right (\into[M](point left (\into[Open.Carrier left.image](Open.inclusion extension.neighborhood left.image extension.included u,
          region left.constraints left.image) \by { \bysub(Open.Carrier extension.neighborhood, region left.constraints extension.neighborhood, u) }), right.domain) \by { extension.inside u })),
      equality: sym!{Point} _ _ (extension.agrees u)
    };
\definition preservesCone: \forall (v: Point) -> Cone left.constraints source v -> Cone right.constraints target (jacobian.apply v) :=
  \fun (v: Point)(cone: _) => \idelim Maps.apply extension.neighborhood Open.whole extension.map center = (target \of Point)
    \with p: Point => Cone right.constraints p (jacobian.apply v) \by {
      base: Cones.preservesCone preserves v cone, equality: centerValue
    };
