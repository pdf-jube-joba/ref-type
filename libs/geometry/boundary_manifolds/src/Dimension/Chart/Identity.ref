\import \parent.At[x := x, left := c, right := c, inLeft := member] \as Change;
\import calculus.Maps[n := n, m := n] \as Maps;
\import calculus.Identity[n := n] \as Identity;
\import Maps.Corestriction[U := c.image, V := c.image, W := Open.whole, f := Identity.map c.image,
  inside := \fun (u: Open.Carrier c.image) => \refl(u)] \as Corestriction;
\definition extension: Change.Extension := Change.Extension {
  neighborhood := c.image, included := \fun (u: Point)(inside: _) => inside,
  contains := \bysub(Point, c.image.points, Change.source), map := Corestriction.map,
  inside := \fun (u: Carrier c.constraints c.image) => \bysub(M, c.domain, point c u),
  agrees := \fun (u: Carrier c.constraints c.image) => sym!{Point} _ _ (coordinatePoint c u),
};
