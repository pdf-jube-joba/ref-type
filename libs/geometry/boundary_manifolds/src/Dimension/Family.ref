\import \parent.Chart[M := A, space := space] \as Charts;
\import \parent.Atlas[M := A, space := space] \as Atlas;
\definition Cover: \Prop := \forall (x: A) -> \exists ( i: I \where Charts.Contains (chart i) x );
\definition Compatible: \Prop := \forall (i, j: I)(x: A)(contains: Charts.Contains (chart i) x) -> Charts.Contains (chart j) x ->
  \exists Charts.At[x := x, left := chart i, right := chart j, inLeft := contains].Extension;
\definition charts: \Pow Charts.Chart := { c: Charts.Chart \where \exists ( i: I \where c = chart i ) };
\module Using(cover: Cover, compatible: Compatible);
