\definition base: Base.manifold.Point := Pair.first Base.manifold.Point Interval.manifold.Point x;
\definition parameter: Interval.manifold.Point := Pair.second Base.manifold.Point Interval.manifold.Point x;
\import \root.Tangent[n := Product.dimension].On[M := manifold].At[x := x].Cones[] \as Cones;
\import Construction.At[x := x] \as ProductBoundary;
\import Interval.At[x := parameter] \as IntervalBoundary;
\definition criterion: Logic.PropEquiv[Cones.Boundary, Logic.Or[parameter = Interval.left, parameter = Interval.right]] := Logic.PropEquiv[_, _] {
  ltr := \fun (boundary: _) => Logic.orElim _ _ _ (ProductBoundary.boundaryCriterion.ltr boundary)
    (\fun (impossible: _) => Logic.falseElim _ (Base.At[x := base].noBoundary impossible)) IntervalBoundary.criterion.ltr,
  rtl := \fun (endpoint: _) => ProductBoundary.boundaryCriterion.rtl (Logic.Or[_, _]::right (IntervalBoundary.criterion.rtl endpoint)),
};
