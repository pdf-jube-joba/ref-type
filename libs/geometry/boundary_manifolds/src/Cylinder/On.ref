\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import \root.Boundaryless[n := n].Of[M := M] \as Base;
\import \root.Interval[] \as Interval;
\import \root.Product[n := n, m := \root.Disk[n := std.Data[].Nat[].Nat^::zero].dimension] \as Product;
\import Product.Of[M := Base.manifold, N := Interval.manifold] \as Construction;
\import \root.Dimension[n := Product.dimension] \as Corners;
\definition manifold: Corners.Manifold := Construction.manifold;
\definition left[x: M.Point]: manifold.Point := Pair.pair Base.manifold.Point Interval.manifold.Point (Base.forward x) Interval.left;
\definition right[x: M.Point]: manifold.Point := Pair.pair Base.manifold.Point Interval.manifold.Point (Base.forward x) Interval.right;
\module At(x: manifold.Point);
