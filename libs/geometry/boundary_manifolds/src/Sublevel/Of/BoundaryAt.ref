\definition cover: Product.Submersion[U := U, f := f, a := x].Surjective -> \exists ( p: Construction.Adapted \where Construction.ChartContains p x ) := \block {
  \fun (surjective: _) \then
  \takefrom local: Product.Submersion[U := U, f := f, a := x].LocalForm \by Product.Submersion[U := U, f := f, a := x].localExistence surjective \then
  \return With[local := local].cover
};
\module With(local: Product.Submersion[U := U, f := f, a := x].LocalForm) {
  \import \parent.\parent.Boundary[a := x, local := local] \as Boundary;
  \import Restriction.At[c := standard, U := local.domain, included := local.included] \as Restricted;
  \definition cover: \exists ( p: Construction.Adapted \where Construction.ChartContains p x ) :=
    Logic.existsIntro[Construction.Adapted, { p: Construction.Adapted \where Construction.ChartContains p x }] Boundary.patch
      (Restricted.pointMember (\into[Model.Point](x, local.domain.points) \by { local.contains }));
}
