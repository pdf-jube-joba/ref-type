\import manifolds.Dimension[n := One.dimension].Examples[].Euclidean[].Subspace[U := Line.whole] \as Target;
\import manifolds.Dimension[n := One.dimension].Smooth[] \as TargetModels;
\definition target: TargetModels.Manifold := Target.smoothManifold;
\import manifolds.SmoothMap[n := dimension, m := One.dimension].Between[M := ambient, N := target] \as Maps;
\definition function: Maps.Map := manifolds.EuclideanMap[n := dimension, m := One.dimension].Between[U := U, V := Line.whole].map f;
\definition zero: target.Point := \into[One.Index -> S.Real]((\fun (i: One.Index) => S.zero), Line.whole.points) \by { \refl(\fun (i: One.Index) => S.zero) };
\import Product.RegularValue[M := ambient, T := target].Of[f := function, y := zero] \as Level;
\import manifolds.Tangent[n := dimension].On[M := ambient] \as SourceTangent;
\import manifolds.Tangent[n := One.dimension].On[M := target] \as TargetTangent;
\import manifolds.Differential[n := dimension, m := One.dimension].Between[M := ambient, N := target] \as Differential;
\module At(x: Level.Fiber);
\definition isRegular: Level.Regular := \fun (x: Level.Fiber) => At[x := x].surjective;
\import manifolds.Dimension[n := n].Smooth[] \as FaceModels;
\definition manifold: FaceModels.Manifold := Level.manifold isRegular;
\import manifolds.Immersion[n := n, m := dimension].Between[M := manifold, N := ambient] \as Embeddings;
\definition embedding: Embeddings.Embedding := Level.Smooth[regular := isRegular].embedding;
\import tangent_bundles.Dimension[n := n].On[M := manifold] \as TangentBundle;
\definition bundle: TangentBundle.Point -> manifold.Point := TangentBundle.projection;
\import manifolds.Dimension[n := TangentBundle.dimension].Smooth[] \as BundleModels;
\definition bundleManifold: BundleModels.Manifold := TangentBundle.manifold;
\module Kernel(x: Level.Fiber);
