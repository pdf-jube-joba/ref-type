\import Restriction.At[c := standard, U := Positive.domain, included := Positive.included] \as Restricted;
\definition contains: Construction.ChartContains Interior.patch x := Restricted.pointMember (\into[Model.Point](x, Positive.domain.points) \by { Positive.intro x positive });
\import \parent.InPatch[p := Interior.patch, contains := contains] \as Patch;
\definition impossible: Cones.Boundary -> Logic.False := \block {
  \fun (boundary: _) \then
  \takefrom i: \Cast[Model.Coordinate] ({ i: Model.Coordinate \where Model.Active Patch.chart.constraints (Tangent.coordinate Patch.chart) i }) \by Cones.coordinateOfBoundary Patch.chart boundary \then
  \return (\bysub(Model.Coordinate, { i: Model.Coordinate \where Model.Active Patch.chart.constraints (Tangent.coordinate Patch.chart) i }, i)).left
};
