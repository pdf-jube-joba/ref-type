\import \root.Sublevel[n := n].Of[U := U, f := f].Boundary[a := x, local := local] \as Boundary;
\import Restriction.At[c := standard, U := local.domain, included := local.included] \as Restricted;
\definition contains: Construction.ChartContains Boundary.patch x := Restricted.pointMember (\into[Model.Point](x, local.domain.points) \by { local.contains });
\import \parent.InPatch[p := Boundary.patch, contains := contains] \as Patch;
\definition boundary: value x = S.zero -> Cones.Boundary := \fun (zero: _) => Cones.boundaryOfCoordinate Patch.chart
  (Logic.existsIntro[Model.Coordinate, { i: Model.Coordinate \where Model.Active Patch.chart.constraints (Tangent.coordinate Patch.chart) i }] normalIndex
    (Logic.And[_, _]::# (\refl(normalIndex))
      (trans!{S.Real} _ _ _ (sym!{S.Real} _ _ (Boundary.normal (\into[ambient.Point](x, Restricted.chart.domain) \by { contains }))) zero)));
