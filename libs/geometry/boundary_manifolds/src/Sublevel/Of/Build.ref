\definition manifold: Corners.Manifold := Construction.Build[cover := cover regular].manifold;
\module At(x: manifold.Point);

\import \root.Boundary[n := n] \as BoundaryConstruction;
\import \root.Dimension[n := std.Data[].Nat[].Basic[].Def[].add One.dimension n] \as BoundaryCorners;
\definition boundaryInput: BoundaryCorners.Manifold := BoundaryCorners.Manifold {
  Point := manifold.Point, space := manifold.space, atlas := manifold.atlas,
  hausdorff := manifold.hausdorff, secondCountable := manifold.secondCountable,
};
\import BoundaryConstruction.Of[M := boundaryInput] \as BoundaryAtlas;
\module BoundaryAt(x: BoundaryAtlas.Point);
\definition boundaryCover: BoundaryAtlas.Cover := \fun (x: BoundaryAtlas.Point) => BoundaryAt[x := x].cover;
\import manifolds.Dimension[n := n].Smooth[] \as BoundaryModel;
\definition boundary: BoundaryModel.Manifold := BoundaryAtlas.Build[cover := boundaryCover].manifold;
\import tangent_bundles.Dimension[n := n].On[M := boundary] \as BoundaryBundle;
\import manifolds.Dimension[n := BoundaryBundle.dimension].Smooth[] \as BundleModel;
\definition boundaryTangent: BundleModel.Manifold := BoundaryBundle.manifold;
