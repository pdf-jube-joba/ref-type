\import Level.Smooth[regular := isRegular].At[x := x] \as Kernel;
\import manifolds.Tangent[n := n].On[M := manifold].At[x := x] \as Tangent;
\import linear_algebra.Commutative[K := S.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing S.Real S.Algebra[].field].Isomorphism[V := Tangent.Vector, W := Kernel.Kernel, source := Tangent.space, target := Kernel.kernelSpace] \as Isomorphisms;
\definition identification: \exists Isomorphisms.Isomorphism := Kernel.identificationExists;
\import SourceTangent.At[x := x] \as AmbientTangent;
\import Differential.At[f := function, x := x] \as D;
\import TargetTangent.At[x := Maps.apply function x] \as TargetSpace;
\definition scalar[v: AmbientTangent.Vector]: S.Real := TargetSpace.Coordinate[chart := \parent.At[x := x].right].decode (D.value.apply v) One.index;
\definition Inward[v: AmbientTangent.Vector]: \Prop := R.Lt S.zero (scalar v);
\definition Outward[v: AmbientTangent.Vector]: \Prop := R.Lt (scalar v) S.zero;
\definition Tangential[v: AmbientTangent.Vector]: \Prop := scalar v = S.zero;
