\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Equality[] \as Equality;
\import real.Analysis[] \as S;
\import dedekind_reals.DedekindReal[] \as R;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition two: N.Nat^ := N.Nat^::succ one;
\import \root.Model[n := one] \as Line;
\import \root.Model[n := two] \as Plane;
\import calculus.Real[].Multivariable[n := one].Open[] \as Open;
\import calculus.Real[].Multivariable[n := two].Open[] \as PlaneOpen;
\definition nonnegative: Line.Constraints := { i: Line.Coordinate \where i = i };
\definition quadrant: Plane.Constraints := { i: Plane.Coordinate \where i = i };
\import \root.Dimension[n := one].Quadrant[C := nonnegative, U := Open.whole] \as HalfLine;
\import \root.Dimension[n := two].Quadrant[C := quadrant, U := PlaneOpen.whole] \as Quadrant;
\import \root.Dimension[n := one] \as LineModels;
\import \root.Dimension[n := two] \as PlaneModels;
\definition halfLine: LineModels.Manifold := HalfLine.manifold;
\definition planeQuadrant: PlaneModels.Manifold := Quadrant.manifold;
\definition neatIdentity: \root.Neat[n := one, m := one].Between[M := halfLine, N := halfLine].Embedding := \root.NeatIdentity[n := one].On[M := halfLine].map;
\import \root.Face[n := one, r := one].On[C := quadrant, U := PlaneOpen.whole] \as Face;
\definition boundaryFace: Face.IsBoundaryFace := \fun (j: Fin.Fin one) => \refl(std.Data[].FinSet[].Sum[m := one, n := one].right j);
\definition faceEmbedding: \root.Immersion[n := one, m := two].Between[M := Face.manifold, N := planeQuadrant].Embedding := Face.embedding;
\definition disk: PlaneModels.Manifold := \root.Disk[n := one].manifold;
\definition interval: LineModels.Manifold := \root.Interval[].manifold;
\import manifolds.Dimension[n := one].Examples[].Euclidean[] \as RealLine;
\import \root.Cylinder[n := one].On[M := RealLine.smoothManifold] \as Strip;
\definition strip: PlaneModels.Manifold := Strip.manifold;
\module Nonlinear;
\module EmptyCoordinates;
\definition globalBoundaryFace: \root.Face[n := one, r := one].Global[F := Face.manifold, M := planeQuadrant].Face := Face.globalFace boundaryFace;
\import manifolds.Dimension[n := one].Smooth[] \as OrdinaryLine;
\definition positiveLine: OrdinaryLine.Manifold := \root.Interior[n := one].Of[M := halfLine].Build[].manifold;
