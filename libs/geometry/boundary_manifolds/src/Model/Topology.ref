\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as Ambient;
\import topology.Continuity[A := Carrier C U, B := Open.Carrier U].Corestriction[S := region C U] \as Region;
\import topology.Continuity[A := Open.Carrier U, B := Point].Corestriction[S := U.points] \as OpenInclusion;
\definition local: topology.Continuity[A := Carrier C U, B := Open.Carrier U].Continuous (regionTopology C U) (Open.Topology[].Of[U := U].topology) (\fun (u: Carrier C U) => u) := Region.inclusionContinuous (Open.Topology[].Of[U := U].topology);
\definition ambient: topology.Continuity[A := Carrier C U, B := Point].Continuous (regionTopology C U) Ambient.topology (\fun (u: Carrier C U) => u) :=
  topology.Composition[A := Carrier C U, B := Open.Carrier U, C := Point].composeContinuous (regionTopology C U) (Open.Topology[].Of[U := U].topology) Ambient.topology
    (\fun (u: Carrier C U) => u) (\fun (u: Open.Carrier U) => u) local (OpenInclusion.inclusionContinuous Ambient.topology);
\module Into(X: \Set, source: topology.Structures[].Topology[X], f: X -> Carrier C U);
