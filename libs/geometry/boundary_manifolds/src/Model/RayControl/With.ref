\import Scalars.FiniteSums[].Bounds[] \as Minimum;
\definition radius: Real := Minimum.minimum n (\fun (i: Coordinate) => controls i);
\definition positive: R.Lt Scalars.zero radius := Minimum.positive n (\fun (i: Coordinate) => controls i)
  (\fun (i: Coordinate) => (\bysub(Real, { r: Real \where Control[i, r] }, controls i)).positive);
\definition included: \forall (t: Real) -> R.Lt Scalars.zero t -> R.Lt (Scalars.distance t Scalars.zero) radius -> Nonnegative C (path t) :=
  \fun (t: Real)(tp: _)(near: _)(i: Coordinate)(selected: _) => (\bysub(Real, { r: Real \where Control[i, r] }, controls i)).bound t tp
    (R.ltLeTrans _ _ _ near (Minimum.coordinate n (\fun (j: Coordinate) => controls j) i)) selected;
