\import topology.Continuity[A := X, B := Point].Corestriction[S := U.points] \as IntoOpen;
\import topology.Continuity[A := X, B := Open.Carrier U].Corestriction[S := region C U] \as IntoRegion;
\definition continuous: topology.Continuity[A := X, B := Point].Continuous source Ambient.topology (\fun (x: X) => f x) ->
  topology.Continuity[A := X, B := Carrier C U].Continuous source (regionTopology C U) f :=
  \fun (law: _) => IntoRegion.corestrictContinuous source (Open.Topology[].Of[U := U].topology) f
    (IntoOpen.corestrictContinuous source Ambient.topology (\fun (x: X) => f x) law);
