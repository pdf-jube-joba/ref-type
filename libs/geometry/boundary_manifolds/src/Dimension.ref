\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Classical[] \as Classical;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as Scalars;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import R.Order[] \as Order;
\import Scalars.Estimates[] \as Bounds;
\import Bounds.Product[] \as Product;
\import Scalars.Distance[] \as Metric;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import Open.Analysis[] \as Analysis;
\import calculus.Real[].Multivariable[n := n].Space[].Def[] \as Coordinates;
\import calculus.Real[].Multivariable[n := n].Space[].Prop[] \as CoordinateLaws;
\import \root.Model[n := n] \as Core;
\definition Real: \Set := Core.Real;
\definition Point: \Set := Core.Point;
\definition Coordinate: \Set := Core.Coordinate;
\definition Constraints: \Set := Core.Constraints;
\definition Nonnegative[C: Constraints][x: Point]: \Prop := Core.Nonnegative C x;
\definition quadrant[C: Constraints]: \Pow Point := Core.quadrant C;
\definition Carrier[C: Constraints][U: Open.OpenSet]: \Set := Core.Carrier C U;
\definition Active[C: Constraints][a: Point][i: Coordinate]: \Prop := Core.Active C a i;
\definition Cone[C: Constraints][a, v: Point]: \Prop := Core.Cone C a v;
\definition Tangential[C: Constraints][a, v: Point]: \Prop := Core.Tangential C a v;
\definition region[C: Constraints][U: Open.OpenSet]: \Pow (Open.Carrier U) := Core.region C U;
\definition regionTopology[C: Constraints][U: Open.OpenSet]: topology.Structures[].Topology[Carrier C U] := Core.regionTopology C U;
\module Chart(M: \Set, space: topology.Structures[].Topology[M]);
\module Atlas(M: \Set, space: topology.Structures[].Topology[M]);
\definition AtlasType[M: \Set][space: topology.Structures[].Topology[M]]: \Set := \root.Dimension[n := n].Atlas[M := M, space := space].Atlas;
\structure Manifold := {
  Point: \Set,
  space: topology.Structures[].Topology[Point],
  atlas: AtlasType Point space,
  hausdorff: topology.Topology[Carrier := Point].IsT2 space,
  secondCountable: topology.Topology[Carrier := Point].IsSecondCountable space,
};
\module Quadrant(C: Constraints, U: Open.OpenSet);
\module Family(A: \Set, space: topology.Structures[].Topology[A], I: \Set, chart: I -> \root.Dimension[n := n].Chart[M := A, space := space].Chart);
