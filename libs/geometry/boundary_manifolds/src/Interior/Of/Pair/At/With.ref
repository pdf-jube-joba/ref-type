\definition domain: Open.OpenSet := Open.intersection Transition.domain e.neighborhood;
\definition included: Open.Included domain Transition.domain := Open.intersectionLeft Transition.domain e.neighborhood;
\definition contains: \In[Model.Point] domain.points a := Logic.And[_, _]::# (\bysub(Model.Point, Transition.domain.points, a))
  (\idelim (Change.source \of Model.Point) = (a \of Model.Point) \with p: Model.Point => \In[Model.Point] e.neighborhood.points p \by { base: e.contains, equality: agreesAt });
\definition transitionPoint[x: Open.Carrier domain]: Open.Carrier Transition.domain := Open.inclusion domain Transition.domain included x;
\definition input[x: Open.Carrier domain]: Model.Carrier c.constraints e.neighborhood := \into[Open.Carrier e.neighborhood](
  Open.inclusion domain e.neighborhood (Open.intersectionRight Transition.domain e.neighborhood) x, Model.region c.constraints e.neighborhood) \by {
    \bysub(Open.Carrier c.image, Model.region c.constraints c.image, Left.coordinateInput (Transition.leftCoordinate (transitionPoint x)))
  };
\module Coordinate(i: Model.Coordinate);
