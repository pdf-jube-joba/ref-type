\import Open.LocalSmooth[U := Transition.domain, f := \fun (x: Open.Carrier Transition.domain) => Transition.vector x i] \as Local;
\definition smooth: Open.Smooth[].SmoothOn domain (Open.restrict domain Transition.domain included (\fun (x: Open.Carrier Transition.domain) => Transition.vector x i)) :=
  \idelim (\fun (x: Open.Carrier domain) => calculus.Maps[n := n, m := n].apply e.neighborhood Open.whole e.map (input x) i) =
    Open.restrict domain Transition.domain included (\fun (x: Open.Carrier Transition.domain) => Transition.vector x i) \with h: Open.ScalarFunction domain => Open.Smooth[].SmoothOn domain h \by {
      base: Open.Restriction[].localSmooth domain e.neighborhood (Open.intersectionRight Transition.domain e.neighborhood)
        (\fun (x: Open.Carrier e.neighborhood) => calculus.Maps[n := n, m := n].apply e.neighborhood Open.whole e.map x i) (e.map.smooth i),
      equality: \axiom:funext((\fun (x: Open.Carrier domain) => calculus.Maps[n := n, m := n].apply e.neighborhood Open.whole e.map (input x) i),
        Open.restrict domain Transition.domain included (\fun (x: Open.Carrier Transition.domain) => Transition.vector x i),
        \fun (x: Open.Carrier domain) => congr!{Model.Point Model.Real} (\fun (u: Model.Point) => u i) _ _ (e.agrees (input x)))
    };
\definition patch: Local.Patch := Local.Patch { domain := domain, included := included, smooth := smooth };
\definition exists: \exists \Cast[Local.Patch] (Local.Patches a) := Logic.existsIntro[Local.Patch, Local.Patches a] patch contains;
