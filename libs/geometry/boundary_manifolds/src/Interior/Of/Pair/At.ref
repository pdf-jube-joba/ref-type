\definition point: Charts.LocalPoint Left.chart := Charts.point Left.chart (Transition.leftCoordinate a);
\definition sourcePoint: OldCharts.LocalPoint c := \into[M.Point](point, c.domain) \by { \bysub(Point, Left.domain, point) };
\definition sourceContains: OldCharts.Contains c sourcePoint := \bysub(M.Point, c.domain, sourcePoint);
\definition targetContains: OldCharts.Contains d sourcePoint := Transition.inRightDomain a;
\import OldCharts.At[x := sourcePoint, left := c, right := d, inLeft := sourceContains] \as Change;
\definition agreesAt: (Change.source \of Model.Point) = (a \of Model.Point) := Charts.Of[chart := Left.chart].coordinatePoint (Transition.leftCoordinate a);
\definition compatible: \exists Change.Extension := M.atlas.compatible c d sourcePoint sourceContains targetContains (\bysub(OldCharts.Chart, M.atlas.charts, c)) (\bysub(OldCharts.Chart, M.atlas.charts, d));
\module With(e: Change.Extension);
\module Coordinate(i: Model.Coordinate) {
  \import Open.LocalSmooth[U := Transition.domain, f := \fun (x: Open.Carrier Transition.domain) => Transition.vector x i] \as Local;
  \definition exists: \exists \Cast[Local.Patch] (Local.Patches a) := \block {
    \takefrom e: Change.Extension \by compatible \then
    \return \parent.With[e := e].Coordinate[i := i].exists
  };
}
