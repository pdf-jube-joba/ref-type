\import \parent.In[c := c] \as Left;
\import \parent.In[c := d] \as Right;
\import Charts.Transition[left := Left.chart, right := Right.chart] \as Transition;
\module At(a: Open.Carrier Transition.domain);
\module Coordinate(i: Model.Coordinate) {
  \import Open.LocalSmooth[U := Transition.domain, f := \fun (x: Open.Carrier Transition.domain) => Transition.vector x i] \as Local;
  \definition local: Local.IsLocal := \fun (a: Open.Carrier Transition.domain) => \parent.At[a := a].Coordinate[i := i].exists;
  \definition smooth: Open.Smooth[].SmoothOn Transition.domain (\fun (x: Open.Carrier Transition.domain) => Transition.vector x i) := Local.smooth local;
}
\definition compatible: Atlas.Compatible Left.chart Right.chart := \fun (i: Model.Coordinate) => Coordinate[i := i].smooth;
