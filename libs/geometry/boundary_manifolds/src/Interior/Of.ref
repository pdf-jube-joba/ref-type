\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import \root.Model[n := n] \as Model;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import Models.Chart[M := M.Point, space := M.space] \as OldCharts;
\import \root.Tangent[n := n].On[M := M] \as Tangent;
\definition points: \Pow M.Point := { x: M.Point \where Logic.Not Tangent.At[x := x].Cones[].Boundary };
\definition Point: \Set := \Cast[M.Point] points;
\import topology.Topology[Carrier := M.Point] \as Space;
\import Space.Subspace[S := points] \as Subspace;
\definition topology: topology.Structures[].Topology[Point] := Subspace.topology M.space;
\import manifolds.Dimension[n := n].Chart[M := Point, space := topology] \as Charts;
\import manifolds.Dimension[n := n].Atlas[M := Point, space := topology] \as Atlas;
\definition Chart: \Set := \Cast[OldCharts.Chart] M.atlas.charts;
\module In(c: Chart);
\module Pair(c, d: Chart);
\definition charts: \Pow Charts.Chart := { a: Charts.Chart \where \exists ( c: Chart \where a = In[c := c].chart ) };
\module Build;
