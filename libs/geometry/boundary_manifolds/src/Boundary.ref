\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import calculus.Real[].OneDimension[] \as One;
\import calculus.Blocks[n := n, m := One.dimension] \as Blocks;
\import Fin.Sum[m := n, n := One.dimension] \as Indices;
\import inverse_implicit.Product[n := n, m := One.dimension] \as Product;
\definition dimension: N.Nat^ := Product.dimension;
\import \root.Dimension[n := std.Data[].Nat[].Basic[].Def[].add One.dimension n] \as Models;
\import \root.Model[n := dimension] \as Model;
\import \root.Model[n := n] \as Parameters;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Open;
\import calculus.Real[].Multivariable[n := n].Open[] \as ParameterOpen;
\definition normal: Model.Coordinate := Indices.right One.index;
\module Of(M: Models.Manifold);
