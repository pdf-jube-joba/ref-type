\import Source.At[x := x] \as Domain;
\import Target.At[x := Maps.apply f x] \as Codomain;
\import Codomain.Operations[] \as Operations;
\import Codomain.Cones[] \as Cones;
\import Differential.At[f := f, x := x] \as D;
\definition difference[v: Domain.Vector][w: Codomain.Vector]: Codomain.Vector := Operations.plus (D.value.apply v) (Operations.negative w);
\definition NormalOnto: \Prop := \forall (w: Codomain.Vector) -> \exists ( v: Domain.Vector \where Cones.Tangential (difference v w) );
\module Coordinates(c: Domain.Chart, d: Codomain.Chart);
