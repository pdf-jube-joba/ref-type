\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import S.Distance[] \as Metric;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Arithmetic;
\import \root.SmoothMap[n := n, m := m].Between[M := M, N := N] \as Maps;
\import \root.Immersion[n := n, m := m].Between[M := M, N := N] \as Immersions;
\import \root.Differential[n := n, m := m].Between[M := M, N := N] \as Differential;
\import \root.Tangent[n := n].On[M := M] \as Source;
\import \root.Tangent[n := m].On[M := N] \as Target;
\module At(f: Maps.Map, x: M.Point);
\structure Laws[f: Maps.Map]: \Prop := {
  embedding: Immersions.EmbeddingLaws[f],
  boundary: \forall (x: M.Point) -> Logic.PropEquiv[Source.At[x := x].Cones[].Boundary, Target.At[x := Maps.apply f x].Cones[].Boundary],
  transverse: \forall (x: M.Point) -> At[f := f, x := x].NormalOnto,
  reflects: \forall (x: M.Point)(v: Source.Vector x) -> Logic.PropEquiv[
    Source.At[x := x].Cones[].Tangential v, Target.At[x := Maps.apply f x].Cones[].Tangential (Differential.At[f := f, x := x].value.apply v)],
};
\definition Embedding: \Set := \Cast[Maps.Map] ({ f: Maps.Map \where Laws[f] });
