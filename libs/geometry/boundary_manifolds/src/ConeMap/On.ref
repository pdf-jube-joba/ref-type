\definition Preserves: \Prop := \forall (x: Source.Carrier C U) -> Target.Nonnegative D (Maps.apply U V f x);
\definition image: Target.Point := Maps.apply U V f a;
\definition derivative: calculus.Vector[n := n, m := m].LinearMap := Maps.Differential[U := U, V := V, f := f, a := a].value;
\module With(v: Source.Point, controls: Source.RayControl[C := C, a := a, v := v].Controls);
\definition preservesCone: Preserves -> \forall (v: Source.Point) -> Source.Cone C a v -> Target.Cone D image (derivative.apply v) := \block {
  \fun (preserves: Preserves)(v: Source.Point)(cone: _) \then
  \takefrom controls: Source.RayControl[C := C, a := a, v := v].Controls \by
    Source.RayControl[C := C, a := a, v := v].existsControls (\bysub(Open.Carrier U, Source.region C U, a)) cone \then
  \return With[v := v, controls := controls].law preserves
};
