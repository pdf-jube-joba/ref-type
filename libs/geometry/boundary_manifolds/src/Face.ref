\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import real.Analysis[] \as S;
\import calculus.Blocks[n := n, m := r] \as Blocks;
\import Fin.Sum[m := n, n := r] \as Indices;
\import Indices.Tuples[A := S.Real] \as Tuples;
\import inverse_implicit.Product[n := n, m := r] \as Linear;
\definition dimension: N.Nat^ := Blocks.dimension;
\import \root.Model[n := n] \as Source;
\import \root.Model[n := r] \as Normal;
\import \root.Model[n := dimension] \as Target;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as Output;
\import calculus.Maps[n := n, m := dimension] \as Maps;
\module On(C: Target.Constraints, U: Output.OpenSet);
\import \root.Dimension[n := n] \as FaceModels;
\import \root.Dimension[n := std.Data[].Nat[].Basic[].Def[].add r n] \as AmbientModels;
\module Global(F: FaceModels.Manifold, M: AmbientModels.Manifold);
