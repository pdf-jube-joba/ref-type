\import \parent.In[c := c] \as Left;
\import \parent.In[c := d] \as Right;
\import Charts.Transition[left := Left.chart, right := Right.chart] \as Transition;
\module At(a: ParameterOpen.Carrier Transition.domain);
\module Coordinate(i: Parameters.Coordinate) {
  \import ParameterOpen.LocalSmooth[U := Transition.domain, f := \fun (x: ParameterOpen.Carrier Transition.domain) => Transition.vector x i] \as Local;
  \definition local: Local.IsLocal := \fun (a: ParameterOpen.Carrier Transition.domain) => \parent.At[a := a].Coordinate[i := i].exists;
  \definition smooth: ParameterOpen.Smooth[].SmoothOn Transition.domain (\fun (x: ParameterOpen.Carrier Transition.domain) => Transition.vector x i) := Local.smooth local;
}
\definition compatible: Atlas.Compatible Left.chart Right.chart := \fun (i: Parameters.Coordinate) => Coordinate[i := i].smooth;
