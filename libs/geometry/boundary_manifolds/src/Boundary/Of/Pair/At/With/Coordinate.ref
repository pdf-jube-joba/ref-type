\import ParameterOpen.LocalSmooth[U := Transition.domain, f := \fun (x: ParameterOpen.Carrier Transition.domain) => Transition.vector x i] \as Local;
\definition smooth: ParameterOpen.Smooth[].SmoothOn domain (ParameterOpen.restrict domain Transition.domain included (\fun (x: ParameterOpen.Carrier Transition.domain) => Transition.vector x i)) :=
  \idelim (\fun (x: ParameterOpen.Carrier domain) => Maps.apply Preimage.domain ParameterOpen.whole Second.compose (preimagePoint x) i) =
    ParameterOpen.restrict domain Transition.domain included (\fun (x: ParameterOpen.Carrier Transition.domain) => Transition.vector x i)
      \with h: ParameterOpen.ScalarFunction domain => ParameterOpen.Smooth[].SmoothOn domain h \by {
        base: ParameterOpen.Restriction[].localSmooth domain Preimage.domain (ParameterOpen.intersectionRight Transition.domain Preimage.domain)
          (\fun (x: ParameterOpen.Carrier Preimage.domain) => Maps.apply Preimage.domain ParameterOpen.whole Second.compose x i) (Second.compose.smooth i),
        equality: \axiom:funext((\fun (x: ParameterOpen.Carrier domain) => Maps.apply Preimage.domain ParameterOpen.whole Second.compose (preimagePoint x) i),
          ParameterOpen.restrict domain Transition.domain included (\fun (x: ParameterOpen.Carrier Transition.domain) => Transition.vector x i),
          \fun (x: ParameterOpen.Carrier domain) => congr!{Model.Point S.Real} (\fun (u: Model.Point) => Blocks.left u i) _ _ (e.agrees (input x)))
      };
\definition patch: Local.Patch := Local.Patch { domain := domain, included := included, smooth := smooth };
\definition exists: \exists \Cast[Local.Patch] (Local.Patches a) := Logic.existsIntro[Local.Patch, Local.Patches a] patch contains;
