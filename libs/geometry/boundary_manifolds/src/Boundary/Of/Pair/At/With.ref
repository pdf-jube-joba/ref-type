\import inverse_implicit.Product[n := n, m := One.dimension] \as Linear;
\import calculus.Maps[n := n, m := dimension] \as InputMaps;
\import calculus.Maps[n := dimension, m := dimension] \as AmbientMaps;
\import calculus.Maps[n := dimension, m := n] \as Projections;
\import calculus.Maps[n := n, m := n] \as Maps;
\import calculus.LinearMap[n := n, m := dimension].On[U := ParameterOpen.whole, L := Linear.horizontal] \as Horizontal;
\import InputMaps.Preimage[U := ParameterOpen.whole, W := Open.whole, V := e.neighborhood, f := Horizontal.map] \as Preimage;
\definition source: ParameterOpen.Carrier ParameterOpen.whole := \into[Parameters.Point](a, ParameterOpen.whole.points) \by { \refl(a) };
\definition containsPreimage: \In[Parameters.Point] Preimage.domain.points a := Preimage.intro source
  (\idelim (Change.source \of Model.Point) = InputMaps.apply ParameterOpen.whole Open.whole Horizontal.map source \with u: Model.Point => \In[Model.Point] e.neighborhood.points u \by {
    base: e.contains,
    equality: OldCharts.coordinatePoint c (Left.coordinateInput (Transition.leftCoordinate a))
  });
\definition domain: ParameterOpen.OpenSet := ParameterOpen.intersection Transition.domain Preimage.domain;
\definition included: ParameterOpen.Included domain Transition.domain := ParameterOpen.intersectionLeft Transition.domain Preimage.domain;
\definition contains: \In[Parameters.Point] domain.points a := Logic.And[_, _]::# (\bysub(Parameters.Point, Transition.domain.points, a)) containsPreimage;
\definition transitionPoint[x: ParameterOpen.Carrier domain]: ParameterOpen.Carrier Transition.domain := ParameterOpen.inclusion domain Transition.domain included x;
\definition preimagePoint[x: ParameterOpen.Carrier domain]: ParameterOpen.Carrier Preimage.domain := ParameterOpen.inclusion domain Preimage.domain (ParameterOpen.intersectionRight Transition.domain Preimage.domain) x;
\definition input[x: ParameterOpen.Carrier domain]: Model.Carrier c.constraints e.neighborhood := \into[Open.Carrier e.neighborhood](Preimage.output (preimagePoint x), Model.region c.constraints e.neighborhood) \by {
  \bysub(Open.Carrier c.image, Model.region c.constraints c.image, Left.coordinateInput (Transition.leftCoordinate (transitionPoint x)))
};
\import InputMaps.Composition[U := Preimage.domain, V := e.neighborhood, f := Preimage.map].After[l := dimension, W := Open.whole, g := e.map] \as First;
\import calculus.LinearMap[n := dimension, m := n].On[U := Open.whole, L := Linear.leftLinear] \as LeftProjection;
\import InputMaps.Composition[U := Preimage.domain, V := Open.whole, f := First.compose].After[l := n, W := ParameterOpen.whole, g := LeftProjection.map] \as Second;
\module Coordinate(i: Parameters.Coordinate);
