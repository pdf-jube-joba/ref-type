\import Models.Chart[M := M.Point, space := M.space] \as OldCharts;
\import \root.Tangent[n := dimension].On[M := M] \as Tangent;
\definition points: \Pow M.Point := { x: M.Point \where Tangent.At[x := x].Cones[].Boundary };
\definition Point: \Set := \Cast[M.Point] points;
\import topology.Topology[Carrier := M.Point] \as Space;
\import Space.Subspace[S := points] \as Subspace;
\definition topology: topology.Structures[].Topology[Point] := Subspace.topology M.space;
\import manifolds.Dimension[n := n].Chart[M := Point, space := topology] \as Charts;
\import manifolds.Dimension[n := n].Atlas[M := Point, space := topology] \as Atlas;
\structure HalfChartLaws[c: OldCharts.Chart]: \Prop := {
  member: \In[OldCharts.Chart] M.atlas.charts c,
  constraints: c.constraints = Model.halfSpace normal,
};
\definition Chart: \Set := \Cast[OldCharts.Chart] ({ c: OldCharts.Chart \where HalfChartLaws[c] });
\definition member[c: Chart]: \In[OldCharts.Chart] M.atlas.charts c := (\bysub(OldCharts.Chart, Chart, c)).member;
\definition constraints[c: Chart]: c.constraints = Model.halfSpace normal := (\bysub(OldCharts.Chart, Chart, c)).constraints;
\module In(c: Chart);
\module Pair(c, d: Chart);
\definition Cover: \Prop := \forall (x: Point) -> \exists ( c: Chart \where OldCharts.Contains c x );
\definition charts: \Pow Charts.Chart := { a: Charts.Chart \where \exists ( c: Chart \where a = In[c := c].chart ) };
\module Build(cover: Cover);
