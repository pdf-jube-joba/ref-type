\import \parent.At[x := x] \as A;
\import \root.Dimension[n := n].Chart[M := Domain.Point, space := Domain.topology] \as SourceCharts;
\import \root.Dimension[n := dimension].Chart[M := Codomain.Point, space := Codomain.topology] \as TargetCharts;
\definition form: Global.LocalForm[embedding, x] := Global.LocalForm[embedding, x] {
  source := A.sourceChart, target := A.targetChart,
  sourceMember := \refl(Domain.chart), targetMember := \refl(Codomain.chart),
  contains := \refl(x), containsImage := \refl(SmoothMaps.apply inclusion x),
  constraints := \refl(constraints), normalSelected := selected,
  inside := \fun (p: SourceCharts.LocalPoint A.sourceChart) => \refl(SmoothMaps.apply inclusion p),
  formula := \fun (p: SourceCharts.LocalPoint A.sourceChart) => \refl(Blocks.join p (\fun (j: Normal.Coordinate) => S.zero)),
  image := \fun (q: TargetCharts.LocalPoint A.targetChart)(zero: Blocks.right q = (\fun (j: Normal.Coordinate) => S.zero)) =>
    Logic.existsIntro[SourceCharts.LocalPoint A.sourceChart, { p: SourceCharts.LocalPoint A.sourceChart \where SmoothMaps.apply inclusion p = q }]
      (\into[Domain.Point](inverse (\into[Codomain.Point](q, FacePoint) \by { zero }), A.sourceChart.domain) \by { \refl(inverse (\into[Codomain.Point](q, FacePoint) \by { zero })) })
      (rightInverse (\into[Codomain.Point](q, FacePoint) \by { zero })),
};
