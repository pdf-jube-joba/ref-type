\import Open.Topology[].Of[U := U] \as Local;
\import topology.Topology[Carrier := calculus.Real[].Multivariable[n := n].Point] \as Ambient;
\import Ambient.Subspace[S := U.points] \as Subspace;
\import Subspace.Open[] \as Lift;
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as Euclidean;
\definition preimage: \Pow (Open.Carrier U) := { x: Open.Carrier U \where R.Lt S.zero (h x) };
\definition open: topology.Topology[Carrier := Open.Carrier U].IsOpenIn Local.topology preimage :=
  Local.Continuity[].topological h (Open.Smooth[].Properties[].continuous U h (\bysub(Open.ScalarFunction U, { h: Open.ScalarFunction U \where Open.Smooth[].SmoothOn U h }, h)))
    (metric_spaces.RealLine[].Rays[].Above S.zero) (metric_spaces.RealLine[].Rays[].aboveOpen S.zero);
\definition points: \Pow (calculus.Real[].Multivariable[n := n].Point) := Lift.image preimage;
\definition domain: Open.OpenSet := Open.Topology[].ofOpen points (Lift.imageOpen Euclidean.topology (Open.Topology[].open U) preimage open);
\definition included: Open.Included domain U := Lift.imageIncluded preimage;
\definition input[x: Open.Carrier domain]: Open.Carrier U := Open.inclusion domain U included x;
\definition positive: \forall (x: Open.Carrier domain) -> R.Lt S.zero (h (input x)) :=
  \fun (x: Open.Carrier domain) => Lift.imageElim preimage x (R.Lt S.zero (h (input x)))
    (\fun (y: Open.Carrier U)(member: R.Lt S.zero (h y))(same: y = x) => \idelim y = input x \with p: Open.Carrier U => R.Lt S.zero (h p) \by {
      base: member, equality: same
    }) (\bysub(calculus.Real[].Multivariable[n := n].Point, points, x));
\definition intro[x: Open.Carrier U]: R.Lt S.zero (h x) -> \In[calculus.Real[].Multivariable[n := n].Point] domain.points x := Lift.imageMember preimage x;
