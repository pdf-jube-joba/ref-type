\use std.Logic[].Equality[].eq_reason_in;
\definition h: Homeomorphisms.Homeomorphism[M.space, topology] := witness.homeomorphism;
\definition inversePoint: \forall (x: M.Point) -> h.backward (point x) = x :=
  \fun (x: M.Point) => trans!{{M.Point}} _ _ _ (congr!{Image {M.Point}} h.backward _ _ (sym!{Image} _ _ (witness.formula x)))
    ((Homeomorphisms.laws M.space topology h).leftInverse x);
\definition injective: \forall (x, y: M.Point) -> Maps.apply f x = Maps.apply f y -> x = y :=
  \fun (x, y: M.Point)(same: _) => eq_reason_in!{{M.Point} x
    "=" { h.backward (point x) } "by" { sym!{{M.Point}} _ _ (inversePoint x) }
    "=" _ "by" { congr!{Image {M.Point}} h.backward (point x) (point y) same }
    "=" _ "by" { inversePoint y }
  };
\import topology.Continuity[A := Image, B := M.Point] \as Inverse;
\module Open(S: \Pow M.Point, open: SourceTopology.IsOpenIn M.space S);
\definition openLift: \forall (S: \Pow M.Point) -> SourceTopology.IsOpenIn M.space S ->
  \exists ( U: \Pow N.Point \where Logic.And[TargetTopology.IsOpenIn N.space U, Continuous.Preimage (Maps.apply f) U = S] ) :=
  \fun (S: \Pow M.Point)(open: _) => Open[S := S, open := open].exists;
