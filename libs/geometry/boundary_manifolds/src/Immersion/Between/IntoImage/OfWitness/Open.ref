\definition W: \Pow Image := Inverse.Preimage h.backward S;
\definition openW: topology.Topology[Carrier := Image].IsOpenIn topology W :=
  (Homeomorphisms.laws M.space topology h).backwardContinuous S open;
\module Lift(U: \Pow N.Point, equal: W = Subspace.Trace U) {
  \definition equality: Continuous.Preimage (Maps.apply f) U = S := \axiom:setext((Continuous.Preimage (Maps.apply f) U), S,
    \fun (x: M.Point)(member: _) => \idelim h.backward (point x) = x \with y: M.Point => \In[M.Point] S y \by {
      base: \idelim Subspace.Trace U = W \with V: \Pow Image => \In[Image] V (point x) \by { base: member, equality: sym!{{\Pow Image}} _ _ equal },
      equality: inversePoint x
    },
    \fun (x: M.Point)(member: _) => \idelim W = Subspace.Trace U \with V: \Pow Image => \In[Image] V (point x) \by {
      base: \idelim x = h.backward (point x) \with y: M.Point => \In[M.Point] S y \by { base: member, equality: sym!{{M.Point}} _ _ (inversePoint x) },
      equality: equal
    });
}
\definition exists: \exists ( U: \Pow N.Point \where Logic.And[TargetTopology.IsOpenIn N.space U, Continuous.Preimage (Maps.apply f) U = S] ) :=
  Subspace.openTraceElim N.space W _ (\fun (U: \Pow N.Point)(openU: _)(equal: _) =>
    Logic.existsIntro[\Pow N.Point, { U: \Pow N.Point \where Logic.And[TargetTopology.IsOpenIn N.space U, Continuous.Preimage (Maps.apply f) U = S] }] U
      (Logic.And[_, _]::# openU (Lift[U := U, equal := equal].equality))) (Subspace.openRepresentation N.space W openW);
