\module Lift(U: \Pow N.Point, openU: TargetTopology.IsOpenIn N.space U, same: Continuous.Preimage (Maps.apply f) U = S);
\definition open: topology.Topology[Carrier := Image].IsOpenIn imageTopology (Backward.Preimage (\fun (y: Image) => inverse y) S) := \block {
  \takefrom U: \Cast[\Pow N.Point] ({ U: \Pow N.Point \where Logic.And[TargetTopology.IsOpenIn N.space U, Continuous.Preimage (Maps.apply f) U = S] })
    \by (embeddingLaws f).openLift S openS \then
  \let law: Logic.And[TargetTopology.IsOpenIn N.space U, Continuous.Preimage (Maps.apply f) U = S] :=
    \bysub(\Pow N.Point, { U: \Pow N.Point \where Logic.And[TargetTopology.IsOpenIn N.space U, Continuous.Preimage (Maps.apply f) U = S] }, U) \then
  \return \idelim Subspace.Trace U = Backward.Preimage (\fun (y: Image) => inverse y) S
    \with W: \Pow Image => topology.Topology[Carrier := Image].IsOpenIn imageTopology W \by {
      base: Subspace.traceOpen N.space U law.left,
      equality: Lift[U := U, openU := law.left, same := law.right].equality
    }
};
