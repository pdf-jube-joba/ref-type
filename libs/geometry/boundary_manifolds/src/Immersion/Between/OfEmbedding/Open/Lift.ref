\definition equality: Subspace.Trace U = Backward.Preimage (\fun (y: Image) => inverse y) S :=
  \axiom:setext(Subspace.Trace U, Backward.Preimage (\fun (y: Image) => inverse y) S,
    \fun (y: Image)(inside: \In[N.Point] U y) => \idelim Continuous.Preimage (Maps.apply f) U = S
      \with V: \Pow M.Point => \In[M.Point] V (inverse y) \by {
        base: \idelim y = Maps.apply f (inverse y) \with z: N.Point => \In[N.Point] U z \by {
          base: inside, equality: sym!{{N.Point}} _ _ (rightInverse y)
        }, equality: same
      },
    \fun (y: Image)(inside: \In[M.Point] S (inverse y)) => \idelim Maps.apply f (inverse y) = y
      \with z: N.Point => \In[N.Point] U z \by {
        base: \idelim S = Continuous.Preimage (Maps.apply f) U \with V: \Pow M.Point => \In[M.Point] V (inverse y) \by {
          base: inside, equality: sym!{\Pow M.Point} _ _ same
        }, equality: rightInverse y
      });
