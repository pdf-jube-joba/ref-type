\definition existence: \In[SourceCharts.Chart] M.atlas.charts left -> \In[TargetCharts.Chart] P.atlas.charts right ->
  TargetCharts.Contains right (data.apply x) -> \exists Result.At[function := data.apply, left := left, right := right, x := x, contains := contains].Extension := \block {
  \fun (lm: _)(rm: _)(inRight: _) \then
  \takefrom middle: MiddleChart x \by N.atlas.covers (First.apply f x) \then
  \let laws: Logic.And[\In[MiddleCharts.Chart] N.atlas.charts middle, MiddleCharts.Contains middle (First.apply f x)] := \bysub(MiddleCharts.Chart, MiddleChart x, middle) \then
  \takefrom p: First.At[function := First.apply f, left := left, right := middle, x := x, contains := contains].Extension \by
    f.smooth left middle x contains lm laws.left laws.right \then
  \takefrom q: Second.At[function := Second.apply g, left := middle, right := right, x := First.apply f x, contains := laws.right].Extension \by
    g.smooth middle right (First.apply f x) laws.right laws.left rm inRight \then
  \return \exact(\parent.Local[left := left, right := right, middle := middle, x := x, contains := contains, inMiddle := laws.right, p := p, q := q].extension,
    Result.At[function := data.apply, left := left, right := right, x := x, contains := contains].Extension)
};
