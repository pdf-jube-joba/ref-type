\definition center: Source.Carrier left.constraints e.neighborhood := \into[Open.Carrier e.neighborhood](\into[Source.Point](source, e.neighborhood.points) \by { e.contains }, Source.region left.constraints e.neighborhood) \by {
  \bysub(Open.Carrier left.image, Source.region left.constraints left.image, source)
};
\definition jacobian: calculus.Vector[n := n, m := m].LinearMap := Maps.Differential[U := e.neighborhood, V := Output.whole, f := e.map, a := center].value;
\definition targetContains: TargetCharts.Contains right (function x) :=
  \idelim function (SourceCharts.point left source) = function x \with p: N.Point => TargetCharts.Contains right p \by {
    base: e.inside center, equality: congr!{M.Point N.Point} function _ _ (SourceCharts.pointCoordinate left local)
  };
\definition target: Target.Carrier right.constraints right.image := TargetCharts.coordinate right (\into[N.Point](function x, right.domain) \by { targetContains });
\import TargetCharts.Total[c := right] \as Right;
\definition centerValue: Maps.apply e.neighborhood Output.whole e.map center = target :=
  trans!{Target.Point} _ _ _ (e.agrees center)
    (trans!{Target.Point} _ _ _
      (sym!{Target.Point} _ _ (Right.coordinateInside (\into[N.Point](function (SourceCharts.point left source), right.domain) \by { e.inside center })))
      (trans!{Target.Point} _ _ _ (congr!{N.Point Target.Point} Right.coordinate _ _ (congr!{M.Point N.Point} function _ _ (SourceCharts.pointCoordinate left local)))
        (Right.coordinateInside (\into[N.Point](function x, right.domain) \by { targetContains }))));
\import \root.ConeMap[n := n, m := m].On[C := left.constraints, D := right.constraints, U := e.neighborhood, V := Output.whole, f := e.map, a := center] \as Cones;
\definition preserves: Cones.Preserves := \fun (u: Source.Carrier left.constraints e.neighborhood) =>
  \idelim TargetCharts.coordinate right (\into[N.Point](function (SourceCharts.point left (\into[Open.Carrier left.image](Open.inclusion e.neighborhood left.image e.included u,
    Source.region left.constraints left.image) \by { \bysub(Open.Carrier e.neighborhood, Source.region left.constraints e.neighborhood, u) })), right.domain) \by { e.inside u }) =
    Maps.apply e.neighborhood Output.whole e.map u \with p: Target.Point => Target.Nonnegative right.constraints p \by {
      base: \bysub(Output.Carrier right.image, Target.region right.constraints right.image,
        TargetCharts.coordinate right (\into[N.Point](function (SourceCharts.point left (\into[Open.Carrier left.image](Open.inclusion e.neighborhood left.image e.included u,
          Source.region left.constraints left.image) \by { \bysub(Open.Carrier e.neighborhood, Source.region left.constraints e.neighborhood, u) })), right.domain) \by { e.inside u })),
      equality: sym!{Target.Point} _ _ (e.agrees u)
    };
\definition preservesCone: \forall (v: Source.Point) -> Source.Cone left.constraints source v -> Target.Cone right.constraints target (jacobian.apply v) :=
  \fun (v: Source.Point)(cone: _) => \idelim Maps.apply e.neighborhood Output.whole e.map center = (target \of Target.Point)
    \with p: Target.Point => Target.Cone right.constraints p (jacobian.apply v) \by {
      base: Cones.preservesCone preserves v cone, equality: centerValue
    };
