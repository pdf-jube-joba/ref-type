\definition common: Open.OpenSet := Open.intersection p.neighborhood q.neighborhood;
\definition center: Source.Carrier left.constraints common := \into[Open.Carrier common](\into[Source.Point](source, common.points) \by {
  Logic.And[_, _]::# p.contains q.contains
}, Source.region left.constraints common) \by { \bysub(Open.Carrier left.image, Source.region left.constraints left.image, source) };
\import \root.Extensions[n := n, m := m].Local[C := left.constraints, U := p.neighborhood, V := q.neighborhood,
  f := p.map, g := q.map, a := center] \as Comparison;
\definition unique: \parent.Using[e := p].jacobian = \parent.Using[e := q].jacobian :=
  Comparison.unique (\fun (u: Source.Carrier left.constraints common) => trans!{Target.Point} _ _ _ (p.agrees
    (\into[Open.Carrier p.neighborhood](Open.inclusion common p.neighborhood (Open.intersectionLeft p.neighborhood q.neighborhood) u, Source.region left.constraints p.neighborhood) \by {
      \bysub(Open.Carrier common, Source.region left.constraints common, u)
    })) (sym!{Target.Point} _ _ (q.agrees
      (\into[Open.Carrier q.neighborhood](\into[Source.Point](u, q.neighborhood.points) \by {
        Open.intersectionRight p.neighborhood q.neighborhood u (\bysub(Source.Point, common.points, u))
      }, Source.region left.constraints q.neighborhood) \by { \bysub(Open.Carrier common, Source.region left.constraints common, u) }))));
