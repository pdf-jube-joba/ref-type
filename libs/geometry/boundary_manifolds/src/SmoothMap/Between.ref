\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import \root.Model[n := n] \as Source;
\import \root.Model[n := m] \as Target;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import calculus.Real[].Multivariable[n := m].Open[] \as Output;
\import calculus.Maps[n := n, m := m] \as Maps;
\import Sources.Chart[M := M.Point, space := M.space] \as SourceCharts;
\import Targets.Chart[M := N.Point, space := N.space] \as TargetCharts;
\import topology.Continuity[A := M.Point, B := N.Point] \as Continuity;
\module At(function: M.Point -> N.Point, left: SourceCharts.Chart, right: TargetCharts.Chart, x: M.Point, contains: SourceCharts.Contains left x);
\structure Data: \Set := { apply: M.Point -> N.Point, };
\structure Laws[data: Data]: \Prop := {
  continuous: Continuity.Continuous M.space N.space data.apply,
  smooth: \forall (left: SourceCharts.Chart)(right: TargetCharts.Chart)(x: M.Point)(contains: SourceCharts.Contains left x) ->
    \In[SourceCharts.Chart] M.atlas.charts left -> \In[TargetCharts.Chart] N.atlas.charts right -> TargetCharts.Contains right (data.apply x) ->
      \exists At[function := data.apply, left := left, right := right, x := x, contains := contains].Extension,
};
\definition Map: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition apply[f: Map]: M.Point -> N.Point := f.apply;
