\module InBases(l: N.Nat^ -> \Pow A, r: N.Nat^ -> \Pow B, ll: Left.IsCountableBasis[left, l], rr: Right.IsCountableBasis[right, r]);
\definition secondCountable: Left.IsSecondCountable left -> Right.IsSecondCountable right -> Space.IsSecondCountable (Product.topology left right) := \block {
  \fun (lc: _)(rc: _) \then
  \takefrom l: \Cast[N.Nat^ -> \Pow A] ({ l: N.Nat^ -> \Pow A \where Left.IsCountableBasis[left, l] }) \by lc \then
  \takefrom r: \Cast[N.Nat^ -> \Pow B] ({ r: N.Nat^ -> \Pow B \where Right.IsCountableBasis[right, r] }) \by rc \then
  \return InBases[l := l, r := r, ll := \bysub(N.Nat^ -> \Pow A, { l: N.Nat^ -> \Pow A \where Left.IsCountableBasis[left, l] }, l),
    rr := \bysub(N.Nat^ -> \Pow B, { r: N.Nat^ -> \Pow B \where Right.IsCountableBasis[right, r] }, r)].secondCountable
};
