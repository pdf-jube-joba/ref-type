\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Relation[] \as Relations;
\definition reflexive: \forall (v: Representative) -> Equivalent v v :=
  \fun (v: Representative) => sym!{{Vectors.Vector}} (transform v.chart v.chart v.vector) v.vector (identity v.chart v.vector);
\definition transitive: \forall (u, v, w: Representative) -> Equivalent u v -> Equivalent v w -> Equivalent u w :=
  \fun (u, v, w: Representative)(first: Equivalent u v)(second: Equivalent v w) => eq_reason_in!{{Vectors.Vector} _
    "=" _ "by" second
    "=" { transform v.chart w.chart (transform u.chart v.chart u.vector) } "by" { congr!{{Vectors.Vector} {Vectors.Vector}} (transform v.chart w.chart) v.vector (transform u.chart v.chart u.vector) first }
    "=" { transform u.chart w.chart u.vector } "by" { sym!{{Vectors.Vector}} (transform u.chart w.chart u.vector) (transform v.chart w.chart (transform u.chart v.chart u.vector)) (composition u.chart v.chart w.chart u.vector) }
  };
\definition symmetric: \forall (u, v: Representative) -> Equivalent u v -> Equivalent v u :=
  \fun (u, v: Representative)(equal: Equivalent u v) => eq_reason!{
    {u.vector} "=" {transform u.chart u.chart u.vector} "by" {sym!{{Vectors.Vector}} (transform u.chart u.chart u.vector) u.vector (identity u.chart u.vector)}
    "=" {transform v.chart u.chart (transform u.chart v.chart u.vector)} "by" {composition u.chart v.chart u.chart u.vector}
    "=" {transform v.chart u.chart v.vector} "by" {congr!{{Vectors.Vector} {Vectors.Vector}} (transform v.chart u.chart) (transform u.chart v.chart u.vector) v.vector (sym!{{Vectors.Vector}} v.vector (transform u.chart v.chart u.vector) equal)}
  };
\definition equivalence: Relations.Equivalence[Representative, Equivalent] := Relations.Equivalence[Representative, Equivalent] { refl := reflexive, sym := symmetric, trans := transitive };
