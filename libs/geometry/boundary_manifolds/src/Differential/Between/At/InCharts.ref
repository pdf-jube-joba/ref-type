\import Maps.At[function := Maps.apply f, left := left, right := right, x := x, contains := Domain.contains left] \as Local;
\definition smooth: \exists Local.Extension := f.smooth left right x (Domain.contains left) (Domain.member left) (Codomain.member right) (Codomain.contains right);
\definition jacobian: calculus.Vector[n := n, m := m].LinearMap := Local.derivative smooth;
\import Domain.ChartIsomorphism[chart := left] \as SourceCoordinates;
\import Codomain.ChartIsomorphism[chart := right] \as TargetCoordinates;
\import Spaces.Linear[V := SourceVectors.Vector, W := TargetVectors.Vector, source := SourceVectors.space, target := TargetVectors.space].Composition[U := Domain.Vector, domain := Domain.space] \as Before;
\definition coordinateDifferential: Spaces.Linear[V := Domain.Vector, W := TargetVectors.Vector, source := Domain.space, target := TargetVectors.space].Map := Before.compose jacobian SourceCoordinates.forward;
\import Spaces.Linear[V := TargetVectors.Vector, W := Codomain.Vector, source := TargetVectors.space, target := Codomain.space].Composition[U := Domain.Vector, domain := Domain.space] \as After;
\definition value: Linear.Map := After.compose TargetCoordinates.backward coordinateDifferential;
\import Domain.Coordinate[chart := left] \as Decode;
\import Codomain.Coordinate[chart := right] \as Encode;
\definition coordinateLaw: \forall (v: Domain.Vector) -> Encode.decode (value.apply v) = jacobian.apply (Decode.decode v) :=
  \fun (v: Domain.Vector) => Encode.decodeEncode (jacobian.apply (Decode.decode v));
