\definition c: LeftChart := Pair.first LeftChart RightChart i;
\definition d: RightChart := Pair.second LeftChart RightChart i;
\definition e: LeftChart := Pair.first LeftChart RightChart j;
\definition h: RightChart := Pair.second LeftChart RightChart j;
\definition leftContains: LeftCharts.Contains c (first x) := contains.left;
\definition rightContains: RightCharts.Contains d (second x) := contains.right;
\import LeftCharts.At[x := first x, left := c, right := e, inLeft := leftContains] \as L;
\import RightCharts.At[x := second x, left := d, right := h, inLeft := rightContains] \as R;
\import Charts.At[x := x, left := chart i, right := chart j, inLeft := contains] \as Total;
\module With(p: L.Extension, q: R.Extension);
\definition existence: \exists Total.Extension := \block {
  \takefrom p: L.Extension \by M.atlas.compatible c e (first x) leftContains otherContains.left (\bysub(LeftCharts.Chart, M.atlas.charts, c)) (\bysub(LeftCharts.Chart, M.atlas.charts, e)) \then
  \takefrom q: R.Extension \by N.atlas.compatible d h (second x) rightContains otherContains.right (\bysub(RightCharts.Chart, N.atlas.charts, d)) (\bysub(RightCharts.Chart, N.atlas.charts, h)) \then
  \return \exact(With[p := p, q := q].extension, Total.Extension)
};
