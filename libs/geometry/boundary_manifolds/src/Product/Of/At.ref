\import \root.Tangent[n := n].On[M := M].At[x := first x] \as LeftTangent;
\import \root.Tangent[n := m].On[M := N].At[x := second x] \as RightTangent;
\import \root.Tangent[n := dimension].On[M := manifold].At[x := x] \as Tangent;
\import LeftTangent.Cones[] \as LeftCones;
\import RightTangent.Cones[] \as RightCones;
\import Tangent.Cones[] \as Cones;
\module InCharts(c: LeftTangent.Chart, d: RightTangent.Chart);
\definition boundaryCriterion: Logic.PropEquiv[Cones.Boundary, Logic.Or[LeftCones.Boundary, RightCones.Boundary]] := \block {
  \takefrom c: LeftTangent.Chart \by LeftTangent.chartExists \then
  \takefrom d: RightTangent.Chart \by RightTangent.chartExists \then
  \return InCharts[c := c, d := d].criterion
};
