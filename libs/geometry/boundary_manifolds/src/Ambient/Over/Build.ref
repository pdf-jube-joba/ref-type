\definition covers: \forall (x: Point) -> \exists ( c: Charts.Chart \where Logic.And[\In[Charts.Chart] charts c, Charts.Contains c x] ) := \block {
  \fun (x: Point) \then
  \takefrom p: \Cast[Adapted] ({ p: Adapted \where Charts.Contains \parent.On[patch := p].chart x }) \by cover x \then
  \return Logic.existsIntro[Charts.Chart, { c: Charts.Chart \where Logic.And[\In[Charts.Chart] charts c, Charts.Contains c x] }] \parent.On[patch := p].chart
    (Logic.And[_, _]::# (Logic.existsIntro[Adapted, { q: Adapted \where \parent.On[patch := p].chart = \parent.On[patch := q].chart }] p (\refl(\parent.On[patch := p].chart)))
      (\bysub(Adapted, { p: Adapted \where Charts.Contains \parent.On[patch := p].chart x }, p)))
};
\module Given(c, d: Charts.Chart, p, q: Adapted, x: Point, left: Charts.Contains c x, right: Charts.Contains d x) {
  \definition extension: c = \parent.\parent.On[patch := p].chart -> d = \parent.\parent.On[patch := q].chart ->
    \exists Charts.At[x := x, left := c, right := d, inLeft := left].Extension :=
    \fun (sameC: _)(sameD: _) => \idelim \parent.\parent.On[patch := p].chart = c \with a: Charts.Chart => \forall (contains: Charts.Contains a x) ->
      \exists Charts.At[x := x, left := a, right := d, inLeft := contains].Extension \by {
        base: \fun (contains: _) => \idelim \parent.\parent.On[patch := q].chart = d \with b: Charts.Chart => \forall (included: Charts.Contains b x) ->
          \exists Charts.At[x := x, left := \parent.\parent.On[patch := p].chart, right := b, inLeft := contains].Extension \by {
            base: \fun (included: _) => \exact(\parent.\parent.Pair[left := p, right := q, x := x, inLeft := contains, inRight := included].extension,
              Charts.At[x := x, left := \parent.\parent.On[patch := p].chart, right := \parent.\parent.On[patch := q].chart, inLeft := contains].Extension),
            equality: sym!{{Charts.Chart}} _ _ sameD
          } right,
        equality: sym!{{Charts.Chart}} _ _ sameC
      } left;
}
\definition compatible: \forall (c, d: Charts.Chart)(x: Point)(left: Charts.Contains c x)(right: Charts.Contains d x) ->
  \In[Charts.Chart] charts c -> \In[Charts.Chart] charts d -> \exists Charts.At[x := x, left := c, right := d, inLeft := left].Extension := \block {
  \fun (c, d: Charts.Chart)(x: Point)(left: _)(right: _)(cm: _)(dm: _) \then
  \takefrom p: \Cast[Adapted] ({ p: Adapted \where c = \parent.On[patch := p].chart }) \by cm \then
  \takefrom q: \Cast[Adapted] ({ q: Adapted \where d = \parent.On[patch := q].chart }) \by dm \then
  \return Given[c := c, d := d, p := p, q := q, x := x, left := left, right := right].extension
    (\bysub(Adapted, { p: Adapted \where c = \parent.On[patch := p].chart }, p))
    (\bysub(Adapted, { q: Adapted \where d = \parent.On[patch := q].chart }, q))
};
\definition atlas: Atlas.Atlas := Atlas.Atlas { charts := charts, covers := covers, compatible := compatible };
\definition manifold: Corners.Manifold := Corners.Manifold {
  Point := Point, space := topology, atlas := atlas,
  hausdorff := Subspace.Properties[].hausdorff M.space M.hausdorff,
  secondCountable := Subspace.Properties[].secondCountable M.space M.secondCountable,
};
