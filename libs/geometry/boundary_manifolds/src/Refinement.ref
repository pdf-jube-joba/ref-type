\definition equality[S: \Pow A][a, b: \Cast[A] S]: (a \of A) = (b \of A) -> a = b :=
  \fun (same: (a \of A) = (b \of A)) =>
    (\idelim (a \of A) = (b \of A) \with x: A => \forall (member: \In[A] S x) -> a = (\into[A](x, S) \by { member }) \by {
      base: \fun (member: \In[A] S a) => \refl(a), equality: same
    }) (\bysub(A, S, b));
