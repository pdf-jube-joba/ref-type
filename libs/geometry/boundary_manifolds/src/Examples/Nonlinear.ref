\import calculus.Maps[n := one, m := one] \as Maps;
\definition square: Maps.Map Open.whole Open.whole := \into[Maps.Data[Open.whole, Open.whole]](Maps.Data[Open.whole, Open.whole] {
  apply := \fun (x: Open.Carrier Open.whole) => \into[Line.Point]((\fun (i: Line.Coordinate) => S.mul (x i) (x i)), Open.whole.points) \by { \refl(\fun (i: Line.Coordinate) => S.mul (x i) (x i)) },
}, { data: Maps.Data[Open.whole, Open.whole] \where Maps.Laws[Open.whole, Open.whole, data] }) \by {
  Maps.Laws[Open.whole, Open.whole, Maps.Data[Open.whole, Open.whole]::# (\fun (x: Open.Carrier Open.whole) => \into[Line.Point]((\fun (i: Line.Coordinate) => S.mul (x i) (x i)), Open.whole.points) \by { \refl(\fun (i: Line.Coordinate) => S.mul (x i) (x i)) })] {
    smooth := \fun (i: Line.Coordinate) => Open.Smooth[].Operations[].mulSmooth Open.whole (\fun (x: Open.Carrier Open.whole) => x i) (\fun (x: Open.Carrier Open.whole) => x i)
      (Open.Examples[].projectionSmooth Open.whole i) (Open.Examples[].projectionSmooth Open.whole i),
  }
};
\definition preserves: \forall (x: HalfLine.Point) -> Line.Nonnegative nonnegative (Maps.apply Open.whole Open.whole square x) :=
  \fun (x: HalfLine.Point)(i: Line.Coordinate)(selected: _) => S.Algebra[].squareNonnegative (x i);
\import \root.QuadrantMap[n := one, m := one].Of[C := nonnegative, D := nonnegative, U := Open.whole, V := Open.whole, f := square, preserves := preserves] \as Construction;
\import \root.SmoothMap[n := one, m := one].Between[M := HalfLine.manifold, N := HalfLine.manifold] \as Smooth;
\definition map: Smooth.Map := Construction.map;
\module At(x: HalfLine.Point) {
  \import Construction.At[x := x, contains := \refl(x)] \as Extension;
  \import Smooth.At[function := Construction.apply, left := HalfLine.chart, right := HalfLine.chart, x := x, contains := \refl(x)] \as Local;
  \definition derivative: Local.Using[e := Extension.extension].jacobian = Maps.Differential[U := Open.whole, V := Open.whole, f := square, a := x].value := Extension.jacobian;
}
