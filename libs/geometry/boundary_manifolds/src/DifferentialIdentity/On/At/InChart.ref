\import Charts.Identity[c := c, x := x, member := T.contains c] \as Change;
\import Maps.At[function := Maps.apply Identity.map, left := c, right := c, x := x, contains := T.contains c] \as Local;
\definition extension: Local.Extension := Local.Extension {
  neighborhood := Change.extension.neighborhood, included := Change.extension.included, contains := Change.extension.contains, map := Change.extension.map,
  inside := Change.extension.inside, agrees := Change.extension.agrees,
};
\import calculus.Identity[n := n] \as EuclideanIdentity;
\import Calculus.Corestriction[U := c.image, V := c.image, W := Open.whole, f := EuclideanIdentity.map c.image,
  inside := \fun (u: Open.Carrier c.image) => \refl(u)] \as Corestriction;
\definition matrix: D.InCharts[left := c, right := c].jacobian = EuclideanIdentity.linear :=
  trans!{{calculus.Vector[n := n, m := n].LinearMap}} _ _ _ (Local.ofExtension (D.InCharts[left := c, right := c].smooth) extension)
    (trans!{{calculus.Vector[n := n, m := n].LinearMap}} _ _ _ (Corestriction.differential (T.coordinate c))
      (EuclideanIdentity.At[U := c.image, a := T.coordinate c].differential));
\definition law: \forall (v: T.Vector) -> D.value.apply v = v := \fun (v: T.Vector) => T.Coordinate[chart := c].injective _ _
  (trans!{{calculus.Real[].Multivariable[n := n].Point}} _ _ _ (D.coordinates c c v)
    (congr!{{calculus.Vector[n := n, m := n].LinearMap} {calculus.Real[].Multivariable[n := n].Point}}
      (\fun (A: calculus.Vector[n := n, m := n].LinearMap) => A.apply (T.Coordinate[chart := c].decode v)) _ _ matrix));
