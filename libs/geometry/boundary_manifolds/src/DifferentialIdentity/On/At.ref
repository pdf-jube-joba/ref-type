\import Tangent.At[x := x] \as T;
\import Differential.At[f := Identity.map, x := x] \as D;
\module InChart(c: T.Chart);
\definition law: \forall (v: T.Vector) -> D.value.apply v = v := \block {
  \fun (v: T.Vector) \then
  \takefrom c: T.Chart \by T.chartExists \then
  \return InChart[c := c].law v
};
