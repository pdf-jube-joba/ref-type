\import \root.Model[n := n] \as Source;
\import \root.Model[n := m] \as Target;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import calculus.Real[].Multivariable[n := m].Open[] \as Output;
\import calculus.Maps[n := n, m := m] \as Calculus;
\module Of(C: Source.Constraints, D: Target.Constraints, U: Open.OpenSet, V: Output.OpenSet, f: Calculus.Map U V,
  preserves: \forall (x: Source.Carrier C U) -> Target.Nonnegative D (Calculus.apply U V f x));
