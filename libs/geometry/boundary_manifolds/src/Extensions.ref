\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\import \root.Model[n := n] \as Source;
\import \root.Model[n := m] \as Target;
\import calculus.Maps[n := n, m := m] \as Maps;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import calculus.Real[].Multivariable[n := m].Open[] \as Output;
\import calculus.Vector[n := n, m := m] \as Vector;
\module At(C: Source.Constraints, U: Open.OpenSet, f, g: Maps.Map U Output.whole, a: Source.Carrier C U);
\module Local(C: Source.Constraints, U, V: Open.OpenSet, f: Maps.Map U Output.whole, g: Maps.Map V Output.whole, a: Source.Carrier C (Open.intersection U V));
