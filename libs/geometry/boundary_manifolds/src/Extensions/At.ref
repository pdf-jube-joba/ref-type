\definition unique: (\forall (x: Source.Carrier C U) -> Maps.apply U Output.whole f x = Maps.apply U Output.whole g x) ->
  Maps.Differential[U := U, V := Output.whole, f := f, a := a].value = Maps.Differential[U := U, V := Output.whole, f := g, a := a].value := \block {
  \fun (agrees: _) \then
  \let d: Vector.LinearMap := Maps.Differential[U := U, V := Output.whole, f := f, a := a].value \then
  \let e: Vector.LinearMap := Maps.Differential[U := U, V := Output.whole, f := g, a := a].value \then
  \return Vector.ext d e (\axiom:funext(d.apply, e.apply, \fun (v: Source.Point) => \axiom:funext(d.apply v, e.apply v,
    \fun (j: Fin.Fin m) => congr!{calculus.Real[].Multivariable[n := n].Differential[].Def[].LinearMap Target.Real}
      (\fun (r: calculus.Real[].Multivariable[n := n].Differential[].Def[].LinearMap) => r.apply v) _ _
      (Source.Extension[C := C, U := U, f := \fun (x: Open.Carrier U) => Maps.apply U Output.whole f x j,
        g := \fun (x: Open.Carrier U) => Maps.apply U Output.whole g x j, a := a].differentialUnique (Vector.row d j) (Vector.row e j)
        (\fun (x: Source.Carrier C U) => congr!{Target.Point Target.Real} (\fun (z: Target.Point) => z j) _ _ (agrees x))
        (Maps.Differential[U := U, V := Output.whole, f := f, a := a].vectorLaw j)
        (Maps.Differential[U := U, V := Output.whole, f := g, a := a].vectorLaw j)))))
};
