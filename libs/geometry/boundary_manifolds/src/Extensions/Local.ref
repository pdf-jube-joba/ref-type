\definition common: Open.OpenSet := Open.intersection U V;
\definition leftPoint: Open.Carrier U := Open.inclusion common U (Open.intersectionLeft U V) a;
\definition rightPoint: Open.Carrier V := Open.inclusion common V (Open.intersectionRight U V) a;
\import Maps.Restriction[U := common, V := U, W := Output.whole] \as Left;
\import Maps.Restriction[U := common, V := V, W := Output.whole] \as Right;
\definition left: Maps.Map common Output.whole := Left.input (Open.intersectionLeft U V) f;
\definition right: Maps.Map common Output.whole := Right.input (Open.intersectionRight U V) g;
\definition unique: (\forall (x: Source.Carrier C common) -> Maps.apply common Output.whole left x = Maps.apply common Output.whole right x) ->
  Maps.Differential[U := U, V := Output.whole, f := f, a := leftPoint].value = Maps.Differential[U := V, V := Output.whole, f := g, a := rightPoint].value :=
  \fun (agrees: _) => trans!{{Vector.LinearMap}} _ _ _
    (sym!{{Vector.LinearMap}} _ _ (Left.differential (Open.intersectionLeft U V) f a))
    (trans!{{Vector.LinearMap}} _ _ _
      (\parent.At[C := C, U := common, f := left, g := right, a := a].unique agrees)
      (Right.differential (Open.intersectionRight U V) g a));
