\use Equality.trans;
\use Equality.congr;
\definition ambientOpen: \forall (U: \Pow X) -> Space.IsOpenIn ambient U -> Space.IsOpenIn topology U :=
  \fun (U: \Pow X)(open: _)(n: N.Nat^) =>
    \idelim Space.Subspace[S := stages n].topology ambient = spaces n
      \with T: topology.Topology[Carrier := Stage n].Topology => topology.Topology[Carrier := Stage n].IsOpenIn T (Trace n U) \by {
        base: Space.Subspace[S := stages n].traceOpen ambient U open,
        equality: sym!{{topology.Topology[Carrier := Stage n].Topology}} _ _ (induced n)
      };
\module At(n: N.Nat^);
\definition stageTopology: \forall (n: N.Nat^) -> spaces n = Space.Subspace[S := stages n].topology topology :=
  \fun (n: N.Nat^) => At[n := n].equal;
