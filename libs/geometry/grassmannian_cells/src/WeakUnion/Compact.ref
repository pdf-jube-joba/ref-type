\import N.Basic[].Prop[] \as Order;
\import N.Order[].Prop[] \as NatOrder;
\import std.Logic[].Classical[] \as Classical;
\import Space.Finite[] \as ClassicalSpace;
\use Logic.either;
\use Equality.trans;
\definition Bounded[S: \Pow X]: \Prop := \exists ( n: N.Nat^ \where Space.Subset S (stages n) );
\module Escaping(S: \Pow X, f: N.Nat^ -> X,
  inside: \forall (n: N.Nat^) -> \In[X] S (f n),
  outside: \forall (n: N.Nat^) -> Logic.Not (\In[X] (stages n) (f n)));
\module Unbounded(S: \Pow X, unbounded: Logic.Not (Bounded S));
\definition finiteStage: \forall (S: \Pow X) -> Space.IsCompactIn topology S -> Bounded S :=
  \fun (S: \Pow X)(compact: _) => ClassicalSpace.doubleNegElim (Bounded S)
    (\fun (unbounded: Logic.Not (Bounded S)) => Unbounded[S := S, unbounded := unbounded].contradiction compact);
\module Maps(Y: \Set, source: topology.Topology[Carrier := Y].Topology);
\module Spheres(d: N.Nat^, induced: \forall (n: N.Nat^) -> spaces n = Space.Subspace[S := stages n].topology topology);
