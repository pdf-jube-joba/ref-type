\definition Outside[n: N.Nat^]: \Set := \Cast[X]
  ({ x: X \where Logic.And[\In[X] S x, Logic.Not (\In[X] (stages n) x)] });
\definition exists: \forall (n: N.Nat^) -> \exists Outside n :=
  \fun (n: N.Nat^) => ClassicalSpace.doubleNegElim (\exists Outside n)
    (\fun (empty: Logic.Not (\exists Outside n)) => unbounded
      (Logic.existsIntro[N.Nat^, { n: N.Nat^ \where Space.Subset S (stages n) }] n
        (\fun (x: X)(member: \In[X] S x) => ClassicalSpace.doubleNegElim (\In[X] (stages n) x)
          (\fun (outside: _) => empty (\exact(\into[X](x, Outside n) \by { Logic.And[_, _]::# member outside }, Outside n))))));
\definition contradiction: Space.IsCompactIn topology S -> Logic.False := \block {
  \fun (compact: _) \then
  \takefrom f: \forall (n: N.Nat^) -> Outside n \by \axiom:classicalIndefiniteChoice(N.Nat^, Outside, exists) \then
  \return \parent.Escaping[S := S, f := \fun (n: N.Nat^) => f n,
    inside := \fun (n: N.Nat^) => (\bysub(X, Outside n, f n)).left,
    outside := \fun (n: N.Nat^) => (\bysub(X, Outside n, f n)).right].contradiction compact
};
