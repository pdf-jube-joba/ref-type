\definition map[y: Y]: Stage n := \into[X](f y, stages n) \by { lands y };
\definition agrees: \forall (y: Y) -> inclusion n (map y) = f y := \fun (y: Y) => \refl(f y);
\definition subspaceContinuous: topology.Continuity[A := Y, B := Stage n].Continuous source
  (Space.Subspace[S := stages n].topology topology) map :=
  Continuous.Corestriction[S := stages n].corestrictContinuous source topology map continuous;
