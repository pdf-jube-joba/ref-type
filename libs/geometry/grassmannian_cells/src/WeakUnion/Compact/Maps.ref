\import topology.Topology[Carrier := Y] \as Source;
\import topology.Maps[A := Y, B := X] \as Sets;
\import topology.Continuity[A := Y, B := X] \as Continuous;
\definition LandsIn[f: Y -> X][n: N.Nat^]: \Prop := \forall (y: Y) -> \In[X] (stages n) (f y);
\definition boundedImage: \forall (f: Y -> X) -> Continuous.Continuous source topology f -> Source.IsCompact source ->
  \exists ( n: N.Nat^ \where LandsIn f n ) := \block {
  \fun (f: Y -> X)(continuous: _)(compact: _) \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where Space.Subset (Sets.Image f Source.Whole) (stages n) })
    \by finiteStage (Sets.Image f Source.Whole)
      (topology.Compactness[A := Y, B := X].continuousImage source topology f continuous Source.Whole compact) \then
  \return Logic.existsIntro[N.Nat^, { n: N.Nat^ \where LandsIn f n }] n
    (\fun (y: Y) => (\bysub(N.Nat^, { n: N.Nat^ \where Space.Subset (Sets.Image f Source.Whole) (stages n) }, n))
      (f y) (Sets.imageMember f Source.Whole y (\refl(y))))
};
\module Into(f: Y -> X, continuous: Continuous.Continuous source topology f, n: N.Nat^, lands: LandsIn f n);
\module Embedded(induced: \forall (n: N.Nat^) -> spaces n = Space.Subspace[S := stages n].topology topology);
