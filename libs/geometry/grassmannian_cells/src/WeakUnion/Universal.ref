\import topology.Continuity[A := X, B := Y] \as Maps;
\definition continuous: \forall (f: X -> Y) -> Logic.PropEquiv[Maps.Continuous topology target f,
  \forall (n: N.Nat^) -> topology.Continuity[A := Stage n, B := Y].Continuous (spaces n) target (\fun (x: Stage n) => f x)] :=
  \fun (f: X -> Y) => Logic.PropEquiv[_, _] {
    ltr := \fun (regular: _)(n: N.Nat^)(U: \Pow Y)(open: _) => regular U open n,
    rtl := \fun (regular: _)(U: \Pow Y)(open: _)(n: N.Nat^) => regular n U open,
  };
