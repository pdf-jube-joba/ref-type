\import \root.Symbols[n := n, k := k] \as SourceSymbols;
\import \root.Symbols[n := Blocks.dimension, k := k] \as TargetSymbols;
\import \root.DecompositionReal[n := n, k := k] \as SourceDecomposition;
\import \root.DecompositionReal[n := Blocks.dimension, k := k] \as TargetDecomposition;
\import \root.CWReal[n := n, k := k] \as SourceCW;
\import \root.CWReal[n := Blocks.dimension, k := k] \as TargetCW;
\import \root.Symbols[n := n, k := k].Widen[m := m] \as Symbols;
\definition dimension[s: \root.Symbols[n := n, k := k].Symbol]: \root.Symbols[n := Blocks.dimension, k := k].realDimension (Symbols.map s) = \root.Symbols[n := n, k := k].realDimension s :=
  \refl(\root.Symbols[n := n, k := k].realDimension s);
\definition cellular: \forall (q: N.Nat^)(p: Source.Carrier) -> \In[Source.Carrier] (SourceCW.skeleton q) p -> \In[Target.Carrier] (TargetCW.skeleton q) (map p) := \block {
  \fun (q: N.Nat^)(p: Source.Carrier)(member: _) \then
  \takefrom w: SourceCW.SkeletalPoint[q, p] \by member \then
  \return \exact(TargetCW.SkeletalPoint[q, map p] {
    symbol := Symbols.map w.symbol,
    bound := \idelim \root.Symbols[n := n, k := k].realDimension w.symbol = \root.Symbols[n := Blocks.dimension, k := k].realDimension (Symbols.map w.symbol)
      \with d: N.Nat^ => N.Basic[].Prop[].Le d q \by { base: w.bound, equality: sym!{N.Nat^} _ _ (dimension w.symbol) },
    contains := \parent.Cells[symbol := w.symbol].preserves p w.contains,
  }, TargetCW.SkeletalPoint[q, map p])
};
\definition reflects: \forall (q: N.Nat^)(p: Source.Carrier) -> \In[Target.Carrier] (TargetCW.skeleton q) (map p) -> \In[Source.Carrier] (SourceCW.skeleton q) p := \block {
  \fun (q: N.Nat^)(p: Source.Carrier)(member: _) \then
  \takefrom w: TargetCW.SkeletalPoint[q, map p] \by member \then
  \takefrom s: \Cast[SourceSymbols.Symbol] ({ s: SourceSymbols.Symbol \where \In[Source.Carrier] (SourceDecomposition.cell s) p }) \by SourceDecomposition.covers p \then
  \let contains: \In[Source.Carrier] (SourceDecomposition.cell s) p := \bysub(SourceSymbols.Symbol,
    { s: SourceSymbols.Symbol \where \In[Source.Carrier] (SourceDecomposition.cell s) p }, s) \then
  \let same: w.symbol = Symbols.map s := TargetDecomposition.disjoint w.symbol (Symbols.map s) (map p) w.contains (\parent.Cells[symbol := s].preserves p contains) \then
  \return \exact(SourceCW.SkeletalPoint[q, p] {
    symbol := s,
    bound := \idelim \root.Symbols[n := Blocks.dimension, k := k].realDimension (Symbols.map s) = \root.Symbols[n := n, k := k].realDimension s
      \with d: N.Nat^ => N.Basic[].Prop[].Le d q \by {
        base: \idelim w.symbol = Symbols.map s \with t: TargetSymbols.Symbol => N.Basic[].Prop[].Le (TargetSymbols.realDimension t) q \by { base: w.bound, equality: same },
        equality: dimension s
      },
    contains := contains,
  }, SourceCW.SkeletalPoint[q, p])
};
\definition cellHomeomorphism[s: SourceSymbols.Symbol]: topology.Homeomorphism[A := \root.Real[n := n, k := k, symbol := s].Canonical[].Cell, B := \root.Real[n := Blocks.dimension, k := k, symbol := Symbols.map s].Canonical[].Cell].Homeomorphism[
  \root.Real[n := n, k := k, symbol := s].Canonical[].cellTopology, \root.Real[n := Blocks.dimension, k := k, symbol := Symbols.map s].Canonical[].cellTopology] := \parent.Cells[symbol := s].homeomorphism;
