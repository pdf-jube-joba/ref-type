\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Order;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import linear_algebra.Commutative[K := K, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing K field] \as Linear;
\import linear_algebra.Hermitian[].Over[K := K, field := field, scalar := scalar] \as Geometry;
\import Geometry.Finite[n := n] \as Ambient;
\import Linear.Laws[V := Ambient.Vector, space := Ambient.space] \as AmbientLaws;
\module At(k: N.Nat^);
\definition Existence[k: N.Nat^]: \Prop := \forall (A: At[k := k].Map) -> At[k := k].Injective A -> \exists At[k := k].Presentation A;
\module Zero;
\module Step(k: N.Nat^);
\definition exists: \forall (k: N.Nat^) -> Existence k :=
  \induction (k: N.Nat^) \return Existence k \with {
    | zero: \fun (A: At[k := N.Nat^::zero].Map)(injective: _) => \exact(Zero[].presentation A, At[k := N.Nat^::zero].Presentation A)
    | succ: \fun (k: N.Nat^)(previous: Existence k) => Step[k := k].exists previous
  };
