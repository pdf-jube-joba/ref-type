\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Order;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import linear_algebra.Commutative[K := K, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing K field] \as Linear;
\import linear_algebra.Hermitian[].Over[K := K, field := field, scalar := scalar] \as Geometry;
\import Geometry.Finite[n := n] \as Ambient;
\import Linear.Laws[V := Ambient.Vector, space := Ambient.space] \as AmbientLaws;
\module At(k: N.Nat^);
\definition Existence[k: N.Nat^]: \Prop := \forall (A: At[k := k].Map) -> At[k := k].Injective A -> \exists At[k := k].Presentation A;
\module Zero;
\module Step(k: N.Nat^);
\definition exists: \forall (k: N.Nat^) -> Existence k :=
  \induction (k: N.Nat^) \return Existence k \with {
    | zero: \fun (A: At[k := N.Nat^::zero].Map)(injective: _) => \exact(Zero[].presentation A, At[k := N.Nat^::zero].Presentation A)
    | succ: \fun (k: N.Nat^)(previous: Existence k) => Step[k := k].exists previous
  };
\definition normalFormExists[k: N.Nat^]: \forall (A: At[k := k].Map) ->
  At[k := k].Injective A -> \exists At[k := k].NormalForm[A] := \block {
  \fun (A: At[k := k].Map)(injective: At[k := k].Injective A) \then
  \takefrom d: At[k := k].Presentation A \by exists k A injective \then
  \takefrom permutation: Fin.Ordering[].Ordered k n d.pivot \by Fin.Ordering[].ordering n k d.pivot (At[k := k].pivotInjective d) \then
  \return \exact(At[k := k].Sorted[A := A, d := d, permutation := permutation].normalForm, At[k := k].NormalForm[A])
};
\definition rankBound[k: N.Nat^]: \forall (A: At[k := k].Map) -> At[k := k].Injective A -> Order.Le k n := \block {
  \fun (A: At[k := k].Map)(injection: At[k := k].Injective A) \then
  \takefrom d: At[k := k].Presentation A \by exists k A injection \then
  \return \root.FiniteCardinality[].bound k n d.pivot (At[k := k].pivotInjective d)
};
