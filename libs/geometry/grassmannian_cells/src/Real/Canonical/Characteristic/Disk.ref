\import Rotations.Parameters[] \as Parameters;
\import \root.CoordinateIndex[K := Numbers.Real, I := Fin.Fin (Symbols.dimension symbol), J := Symbols.Free symbol,
  scalar := H.Real[].topological.space, index := index] \as Reindex;
\definition chart: topology.Homeomorphism[A := Standard.Coordinate, B := Parameters.Coordinates].Homeomorphism[Standard.topology, Parameters.source] := Reindex.homeomorphism;
\definition chartZero: chart.forward Standard.Contraction[].zero = Parameters.zero := \refl(Parameters.zero);
\definition chartScale: \forall (a: Numbers.Real)(x: Standard.Coordinate) ->
  chart.forward (Standard.Contraction[].scale a x) = Parameters.scale a (chart.forward x) :=
  \fun (a: Numbers.Real)(x: Standard.Coordinate) => \refl(Parameters.scale a (chart.forward x));

\import Parameters.Disk[d := Symbols.realDimension symbol, chart := chart, chartZero := chartZero, chartScale := chartScale] \as Round;
\definition value: DiskData := DiskData {
  homeomorphism := Round.homeomorphism,
  forwardBoundary := Round.Boundary[].forward, backwardBoundary := Round.Boundary[].backward,
  interiorForward := Round.Boundary[].interiorForward, interiorBackward := Round.Boundary[].interiorBackward,
};
