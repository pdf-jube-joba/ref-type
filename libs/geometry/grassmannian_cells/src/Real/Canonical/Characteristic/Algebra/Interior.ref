\definition triangular: Triangular.At[k := k].Laws[symbol, columns] := Triangular.At[k := k].Laws[symbol, columns] {
  above := \fun (j: Fin.Fin k)(r: Fin.Fin n)(above: _) => trans!{Numbers.Real} _ _ _
    (congr!{{Ambient.Vector} Numbers.Real} (\fun (v: Ambient.Vector) => v r) _ _ (onBasis j)) (Rotations.above parameter j r above),
  diagonal := \fun (j: Fin.Fin k) => \exact(Triangular.At[k := k].Diagonal[symbol, columns, j] {
    value := Rotations.Column[j := j].radius parameter,
    positive := Rotations.Column[j := j].radiusPositive parameter (inside j),
    agrees := trans!{Numbers.Real} _ _ _ (congr!{{Ambient.Vector} Numbers.Real} (\fun (v: Ambient.Vector) => v (symbol.pivot j)) _ _ (onBasis j)) (Rotations.diagonal parameter j),
  }, Triangular.At[k := k].Diagonal[symbol, columns, j]),
};
\import \root.Reduction[K := Numbers.Real, field := Numbers.Algebra[].field, scalar := H.Real[].scalar, n := n].At[k := k] \as Reduction;
\import \root.Reduction[K := Numbers.Real, field := Numbers.Algebra[].field, scalar := H.Real[].scalar, n := n] \as Reductions;
\module Form(form: Reduction.NormalForm[columns]);
\definition belongs: \In[Grassmannian.Carrier] cell (map parameter) := \block {
  \takefrom form: Reduction.NormalForm[columns] \by Reductions.normalFormExists k columns
    (Ambient.OnProjection[P := Grassmannian.projection (map parameter)].Rank[k := k].injective Rank.value) \then
  \return Form[form := form].belongs
};
