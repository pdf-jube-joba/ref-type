\import Triangular.At[k := k].EchelonComparison[symbol := symbol, A := columns, triangular := triangular,
  other := form.symbol, B := form.matrix, contained := form.backward] \as Comparison;
\import \root.Real[n := n, k := k, symbol := form.symbol].Canonical[] \as Other;
\import \root.Echelon[K := Numbers.Real, field := Numbers.Algebra[].field, n := n, k := k, symbol := form.symbol] \as Echelon;
\import \root.DecompositionReal[n := n, k := k].At[p := map parameter].Using[basis := Rank.value, form := form] \as Image;
\definition otherCell: \In[Grassmannian.Carrier] Other.cell (map parameter) :=
  Logic.existsIntro[Echelon.Carrier, { B: Echelon.Carrier \where Other.map B = map parameter }] form.matrix Image.agrees;
\definition belongs: \In[Grassmannian.Carrier] cell (map parameter) :=
  \idelim form.symbol = symbol \with s: Symbols.Symbol => \In[Grassmannian.Carrier] (\root.Real[n := n, k := k, symbol := s].Canonical[].cell) (map parameter) \by {
    base: otherCell, equality: sym!{Symbols.Symbol} _ _ Comparison.equal
  };
