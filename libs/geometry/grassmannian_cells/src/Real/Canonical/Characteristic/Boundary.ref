\import \parent.Algebra[parameter := parameter] \as Algebra;
\import \root.Reduction[K := Numbers.Real, field := Numbers.Algebra[].field, scalar := H.Real[].scalar, n := n].At[k := k] \as Reduction;
\import \root.Reduction[K := Numbers.Real, field := Numbers.Algebra[].field, scalar := H.Real[].scalar, n := n] \as Reductions;
\module Decomposition(form: Reduction.NormalForm[Algebra.columns]);
\definition exists: Rotations.Boundary parameter -> \exists BoundaryImage[map parameter] := \block {
  \fun (boundary: _) \then
  \takefrom form: Reduction.NormalForm[Algebra.columns] \by Reductions.normalFormExists k Algebra.columns
    (Ambient.OnProjection[P := Grassmannian.projection (map parameter)].Rank[k := k].injective Algebra.basis) \then
  \return \exact(Decomposition[form := form].boundaryImage boundary, BoundaryImage[map parameter])
};
