\import \root.Real[n := n, k := k, symbol := symbol].Canonical[].Characteristic[] \as CharacteristicParent;
\definition map[x: Standard.Disk]: Grassmannian.Carrier := CharacteristicParent.map (disk.homeomorphism.forward x);
\definition continuous: topology.Continuity[A := Standard.Disk, B := Grassmannian.Carrier].Continuous Standard.diskTopology Grassmannian.topology map :=
  topology.Composition[A := Standard.Disk, B := Rotations.Carrier, C := Grassmannian.Carrier].composeContinuous
    Standard.diskTopology Rotations.topology Grassmannian.topology disk.homeomorphism.forward CharacteristicParent.map
    (topology.Homeomorphism[A := Standard.Disk, B := Rotations.Carrier].laws Standard.diskTopology Rotations.topology disk.homeomorphism).forwardContinuous CharacteristicParent.continuous;

\definition diskLaws: topology.Homeomorphism[A := Standard.Disk, B := Rotations.Carrier].Laws[Standard.diskTopology, Rotations.topology, disk.homeomorphism] :=
  topology.Homeomorphism[A := Standard.Disk, B := Rotations.Carrier].laws Standard.diskTopology Rotations.topology disk.homeomorphism;
\definition injective: \forall (p, q: Standard.Disk) -> \In[Standard.Coordinate] Standard.Interior p -> \In[Standard.Coordinate] Standard.Interior q -> map p = map q -> p = q :=
  \fun (p, q: Standard.Disk)(first: _)(second: _)(same: _) => trans!{{Standard.Disk}} _ _ _ (sym!{{Standard.Disk}} _ _ (diskLaws.leftInverse p))
    (trans!{{Standard.Disk}} _ _ _ (congr!{{Rotations.Carrier} {Standard.Disk}} disk.homeomorphism.backward _ _
      (CharacteristicParent.injectiveInterior (disk.homeomorphism.forward p) (disk.homeomorphism.forward q) (disk.interiorForward p first) (disk.interiorForward q second) same))
      (diskLaws.leftInverse q));
\definition clean: \forall (p, q: Standard.Disk) -> \In[Standard.Coordinate] Standard.Interior p -> map p = map q -> \In[Standard.Coordinate] Standard.Interior q :=
  \fun (p, q: Standard.Disk)(inside: _)(same: _) => \idelim disk.homeomorphism.backward (disk.homeomorphism.forward q) = q
    \with r: Standard.Disk => \In[Standard.Coordinate] Standard.Interior r \by {
      base: disk.interiorBackward (disk.homeomorphism.forward q) (CharacteristicParent.cellInterior (disk.homeomorphism.forward q)
        (\idelim map p = map q \with x: Grassmannian.Carrier => \In[Grassmannian.Carrier] cell x \by {
          base: CharacteristicParent.interiorCell (disk.homeomorphism.forward p) (disk.interiorForward p inside), equality: same
        })), equality: diskLaws.leftInverse q
    };

\import \root.CompactCell[A := Grassmannian.Carrier, space := Grassmannian.topology, hausdorff := Grassmannian.hausdorff,
  d := Symbols.realDimension symbol, f := map, continuous := continuous, injective := injective, clean := clean] \as Compact;
\definition cellData: algebraic_topology.CW[A := Grassmannian.Carrier].CellData := Compact.cell;
\definition cellLaws: algebraic_topology.CW[A := Grassmannian.Carrier].CellLaws[Grassmannian.topology, cellData] := Compact.laws;
\import algebraic_topology.CW[A := Grassmannian.Carrier] \as CW;
\definition interiorImage: CW.InteriorImage cellData = cell := \axiom:setext(CW.InteriorImage cellData, cell,
  \block {
    \fun (x: Grassmannian.Carrier)(member: _) \then
    \takefrom p: \Cast[Standard.Disk] ({ p: Standard.Disk \where Logic.And[\In[Standard.Coordinate] Standard.Interior p, map p = x] }) \by member \then
    \let data: Logic.And[\In[Standard.Coordinate] Standard.Interior p, map p = x] := \bysub(Standard.Disk,
      { p: Standard.Disk \where Logic.And[\In[Standard.Coordinate] Standard.Interior p, map p = x] }, p) \then
    \return \idelim map p = x \with y: Grassmannian.Carrier => \In[Grassmannian.Carrier] cell y \by {
      base: CharacteristicParent.interiorCell (disk.homeomorphism.forward p) (disk.interiorForward p data.left), equality: data.right
    }
  },
  \block {
    \fun (x: Grassmannian.Carrier)(member: _) \then
    \let point: Cell := \into[Grassmannian.Carrier](x, cell) \by { member } \then
    \takefrom parameter: InteriorPreimage[point] \by CharacteristicParent.interiorSurjective point \then
    \let p: Standard.Disk := disk.homeomorphism.backward parameter.parameter \then
    \return Logic.existsIntro[Standard.Disk, { q: Standard.Disk \where Logic.And[\In[Standard.Coordinate] Standard.Interior q, map q = x] }] p
      (Logic.And[_, _]::# (disk.interiorBackward parameter.parameter parameter.inside)
        (trans!{{Grassmannian.Carrier}} _ _ _ (congr!{{Rotations.Carrier} {Grassmannian.Carrier}} CharacteristicParent.map _ _ (diskLaws.rightInverse parameter.parameter)) parameter.image))
  });
\definition interiorHomeomorphism: topology.Homeomorphism[A := Compact.Interior[].DomainPoint, B := Compact.Interior[].TargetPoint].Homeomorphism[
  Compact.Interior[].source, Compact.Interior[].target] := Compact.Interior[].homeomorphism;
