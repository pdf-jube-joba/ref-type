\import Ambient.Families[X := Coordinates.Carrier].Orthonormalized[k := k, source := CoordinateSpace.topology, A := Coordinates.linear, factors := factors] \as Projection;
\import Grassmannian.Family[Y := Coordinates.Carrier, source := CoordinateSpace.topology, P := Projection.projection,
  regularP := Projection.regular, rankP := Projection.rank] \as Family;
\definition map: Coordinates.Carrier -> Grassmannian.Carrier := Family.map;
\module At(A: Coordinates.Carrier);
\definition image: \forall (A: Coordinates.Carrier)(v: Ambient.Vector) -> Logic.PropEquiv[
  (map A).map.apply v = v, \In[Ambient.Vector] (Coordinates.Image A) v] :=
  \fun (A: Coordinates.Carrier)(v: Ambient.Vector) => Logic.PropEquiv[_, _] {
    ltr := \fun (fixed: (map A).map.apply v = v) => Logic.existsIntro[Coordinates.CoordinateVector,
      { w: Coordinates.CoordinateVector \where (Coordinates.linear A).apply w = v }]
      (At[A := A].inverse v) (trans!{{Ambient.Vector}}
        ((Coordinates.linear A).apply (At[A := A].inverse v)) ((map A).map.apply v) v
        (At[A := A].reconstruction v) fixed),
    rtl := \block {
      \fun (member: \In[Ambient.Vector] (Coordinates.Image A) v) \then
      \takefrom w: \Cast[Coordinates.CoordinateVector] ({ w: Coordinates.CoordinateVector \where (Coordinates.linear A).apply w = v }) \by member \then
      \return \idelim (Coordinates.linear A).apply w = v \with z: Ambient.Vector => (map A).map.apply z = z \by {
        base: At[A := A].fixed w,
        equality: \bysub(Coordinates.CoordinateVector, { w: Coordinates.CoordinateVector \where (Coordinates.linear A).apply w = v }, w)
      }
    },
  };
\definition injective: \forall (A, B: Coordinates.Carrier) -> map A = map B -> A = B :=
  \fun (A, B: Coordinates.Carrier)(same: _) => Coordinates.containedUnique A B
    (\fun (v: Coordinates.CoordinateVector) => (image B ((Coordinates.linear A).apply v)).ltr
      (\idelim map A = map B \with p: Grassmannian.Carrier => p.map.apply ((Coordinates.linear A).apply v) = (Coordinates.linear A).apply v \by {
        base: At[A := A].fixed v, equality: same
      }));
\definition parametrization: Parametrization := Parametrization {
  map := map, continuous := Family.continuous, injective := injective, image := image,
};
