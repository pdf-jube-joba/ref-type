\import InnerLaws.Gram[k := k].Of[A := Coordinates.linear A, factor := factors.value A] \as Gram;
\definition reconstruction: \forall (v: Ambient.Vector) ->
  (Coordinates.linear A).apply (Gram.inverse.apply v) = (map A).map.apply v :=
  \fun (v: Ambient.Vector) => Gram.frameFormula (Gram.coordinates.apply v);
\definition fixed: \forall (v: Coordinates.CoordinateVector) ->
  (map A).map.apply ((Coordinates.linear A).apply v) = (Coordinates.linear A).apply v :=
  \fun (v: Coordinates.CoordinateVector) => trans!{{Ambient.Vector}} _ _ _
    (sym!{{Ambient.Vector}} _ _ (reconstruction ((Coordinates.linear A).apply v)))
    (congr!{{Coordinates.CoordinateVector} {Ambient.Vector}} (Coordinates.linear A).apply _ _ (Gram.inverseOnImage v));
\definition inverse: Ambient.Vector -> Coordinates.CoordinateVector := Gram.inverse.apply;
