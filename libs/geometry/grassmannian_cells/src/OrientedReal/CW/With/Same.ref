\import \parent.\parent.\parent.Lift[symbol := s, disk := disks s] \as Lift;
\import algebraic_topology.Euclidean[].Dimension[n := Symbols.realDimension s] \as Disk;
\definition equal: \forall (e: Carrier) -> \In[Carrier] (CW.InteriorImage (cell (Index::# s left))) e ->
  \In[Carrier] (CW.InteriorImage (cell (Index::# s right))) e -> cell (Index::# s left) = cell (Index::# s right) := \block {
  \fun (e: Carrier)(first: _)(second: _) \then
  \takefrom p: \Cast[Disk.Disk] ({ p: Disk.Disk \where Logic.And[\In[Disk.Coordinate] Disk.Interior p, Lift.map left p = e] }) \by first \then
  \takefrom q: \Cast[Disk.Disk] ({ q: Disk.Disk \where Logic.And[\In[Disk.Coordinate] Disk.Interior q, Lift.map right q = e] }) \by second \then
  \let a: Logic.And[\In[Disk.Coordinate] Disk.Interior p, Lift.map left p = e] := \bysub(Disk.Disk, { p: Disk.Disk \where Logic.And[\In[Disk.Coordinate] Disk.Interior p, Lift.map left p = e] }, p) \then
  \let b: Logic.And[\In[Disk.Coordinate] Disk.Interior q, Lift.map right q = e] := \bysub(Disk.Disk, { q: Disk.Disk \where Logic.And[\In[Disk.Coordinate] Disk.Interior q, Lift.map right q = e] }, q) \then
  \let sameImage: Lift.map left p = Lift.map right q := trans!{Carrier} _ _ _ a.right (sym!{Carrier} _ _ b.right) \then
  \let samePoint: p = q := Lift.baseInjective p q a.left b.left (congr!{Carrier {Base.Carrier}} projection _ _ sameImage) \then
  \let sameSign: left = right := Lift.signInjective p left right (trans!{Carrier} _ _ _ sameImage
    (congr!{{Disk.Disk} Carrier} (Lift.map right) _ _ (sym!{{Disk.Disk}} _ _ samePoint))) \then
  \return congr!{{Signs.Carrier} {CW.CellData}} (\fun (t: Signs.Carrier) => cell (Index::# s t)) _ _ sameSign
};
