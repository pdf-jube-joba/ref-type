\import \root.Real[n := n, k := k, symbol := a.symbol].Canonical[].Characteristic[] \as Characteristic;
\definition exists: \forall (p: Euclidean.Disk (cell a).dimension) ->
  \In[Euclidean.coordinateCarrier (cell a).dimension] (Euclidean.boundaryAt (cell a).dimension) p ->
  \exists CW.BoundaryWitness[cells, cell a, (cell a).characteristic p] := \block {
  \fun (p: Euclidean.Disk (cell a).dimension)(boundary: _) \then
  \let e: Carrier := (cell a).characteristic p \then
  \takefrom lower: Characteristic.BoundaryImage[e.base] \by Characteristic.boundaryLower ((disks a.symbol).homeomorphism.forward p) ((disks a.symbol).forwardBoundary p boundary) \then
  \takefrom w: \parent.\parent.\parent.Lift[symbol := lower.symbol, disk := disks lower.symbol].InteriorPreimage[e] \by
    \parent.\parent.\parent.Lift[symbol := lower.symbol, disk := disks lower.symbol].interiorOnto e lower.contains \then
  \return \exact(CW.BoundaryWitness[cells, cell a, e] {
    other := cell (Index::# lower.symbol w.sign), member := member (Index::# lower.symbol w.sign), lower := lower.lower,
    contains := \parent.Interior[a := Index::# lower.symbol w.sign].contains w.point w.inside e w.image,
  }, CW.BoundaryWitness[cells, cell a, e])
};
