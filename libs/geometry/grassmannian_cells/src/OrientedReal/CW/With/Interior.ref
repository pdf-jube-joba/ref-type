\import \parent.\parent.\parent.Lift[symbol := a.symbol, disk := disks a.symbol] \as Lift;
\import algebraic_topology.Euclidean[].Dimension[n := Symbols.realDimension a.symbol] \as Disk;
\definition contains: \forall (p: Disk.Disk) -> \In[Disk.Coordinate] Disk.Interior p -> \forall (e: Carrier) -> Lift.map a.sign p = e -> \In[Carrier] (CW.InteriorImage (cell a)) e :=
  \fun (p: Disk.Disk)(inside: _)(e: Carrier)(same: _) => Logic.existsIntro[Disk.Disk,
    { q: Disk.Disk \where Logic.And[\In[Disk.Coordinate] Disk.Interior q, Lift.map a.sign q = e] }] p (Logic.And[_, _]::# inside same);
\definition projects: \forall (e: Carrier) -> \In[Carrier] (CW.InteriorImage (cell a)) e -> \In[Base.Carrier] (Decomposition.cell a.symbol) e.base := \block {
  \fun (e: Carrier)(included: _) \then
  \takefrom p: \Cast[Disk.Disk] ({ p: Disk.Disk \where Logic.And[\In[Disk.Coordinate] Disk.Interior p, Lift.map a.sign p = e] }) \by included \then
  \let data: Logic.And[\In[Disk.Coordinate] Disk.Interior p, Lift.map a.sign p = e] := \bysub(Disk.Disk, { p: Disk.Disk \where Logic.And[\In[Disk.Coordinate] Disk.Interior p, Lift.map a.sign p = e] }, p) \then
  \return \idelim projection (Lift.map a.sign p) = e.base \with x: Base.Carrier => \In[Base.Carrier] (Decomposition.cell a.symbol) x \by {
    base: Lift.baseContains p data.left,
    equality: congr!{Carrier {Base.Carrier}} projection _ _ data.right
  }
};
