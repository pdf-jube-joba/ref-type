\import linear_algebra.Hermitian[].Over[K := R.Real, field := R.Algebra[].field, scalar := H.Real[].scalar].Finite[n := n] \as AmbientCoordinates;
\import Geometry.At[n := k].Families[X := X].Matrix[m := n] \as Coordinates;
\import matrix_invariants.Ring[K := R.Real, scalars := std.Alg[].Field[].fieldAsCommutativeRing R.Real R.Algebra[].field].At[n := k].Representation[] \as Representation;
\import matrix_invariants.Topological[K := R.Real, ring := topological_algebra.Real[].topologicalRing].At[n := k].Families[X := X] \as Determinants;
\definition entries[x: X][i, j: Fin.Fin k]: R.Real := (f x).basis.coordinate.apply ((g x).basis.value.apply (FrameCoordinates.basis j)) i;
\definition entriesContinuous: Determinants.Regular source entries := \fun (i, j: Fin.Fin k) =>
  Coordinates.evaluate source (\fun (x: X) => (f x).basis.coordinate) (\fun (x: X) => (g x).basis.value.apply (FrameCoordinates.basis j))
    (\fun (r: Fin.Fin n) => coordinates (AmbientCoordinates.basis r)) (regular (FrameCoordinates.basis j)) i;
\definition continuous: Signs.Functions[X := X].Continuous source (\fun (x: X) => transition (p x) (f x) (g x)) :=
  Signs.Functions[X := X].into source _ (Determinants.transport source
    (\fun (x: X) => matrix_invariants.Ring[K := R.Real, scalars := std.Alg[].Field[].fieldAsCommutativeRing R.Real R.Algebra[].field].At[n := k].determinant (entries x))
    (\fun (x: X) => transition (p x) (f x) (g x))
    (\fun (x: X) => Representation.determinantComparison (\parent.Change[p := p x, f := f x, g := g x].map))
    (Determinants.determinantContinuous source entries entriesContinuous));
