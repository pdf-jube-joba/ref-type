\import \root.CompactCell[A := Carrier, space := Atlas.topology, hausdorff := Atlas.hausdorff, d := Symbols.realDimension symbol,
  f := map s, continuous := continuous s, injective := injective s, clean := clean s] \as Compact;
\definition cell: algebraic_topology.CW[A := Carrier].CellData := Compact.cell;
\definition laws: algebraic_topology.CW[A := Carrier].CellLaws[Atlas.topology, cell] := Compact.laws;
\definition interiorHomeomorphism: topology.Homeomorphism[A := Compact.Interior[].DomainPoint, B := Compact.Interior[].TargetPoint].Homeomorphism[
  Compact.Interior[].source, Compact.Interior[].target] := Compact.Interior[].homeomorphism;
