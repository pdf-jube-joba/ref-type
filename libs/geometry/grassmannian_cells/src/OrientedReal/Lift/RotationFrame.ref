\import \root.Real[n := n, k := k, symbol := symbol].Canonical[].Pivot[] \as Pivot;
\import \root.Reflection[K := R.Real, field := R.Algebra[].field, scalar := H.Real[].scalar, topological := H.Real[].topological, n := n].Conjugation[P := Base.projection Pivot.base] \as Action;
\definition basis[A: Rotations.Carrier]: Ambient.OnProjection[P := Base.projection (Characteristic.map A)].Rank[k := k].Basis :=
  Action.Rank[k := k, u := Rotations.unitary A, basis := Pivot.basis].value;
\definition frame[A: Rotations.Carrier]: Frame (Characteristic.map A) :=
  \root.IsometricBasis[K := R.Real, field := R.Algebra[].field, scalar := H.Real[].scalar, topological := H.Real[].topological,
    n := n, k := k, P := Base.projection (Characteristic.map A)].frame (basis A) (Characteristic.Algebra[parameter := A].isometry);
\import Ambient.Families[X := Rotations.Carrier].Matrix[m := n] \as Forward;
\import Geometry.Functions[X := Rotations.Carrier] \as Functions;
\definition regular: Ambient.Families[X := Rotations.Carrier].Matrix[m := k].Regular Rotations.topology (\fun (A: Rotations.Carrier) => (frame A).basis.value) :=
  \fun (v: FrameCoordinates.Vector) => Forward.evaluate Rotations.topology (\fun (A: Rotations.Carrier) => (Rotations.unitary A).forward)
    (\fun (_: Rotations.Carrier) => Pivot.basis.value.apply v) Rotations.regular (\fun (i: Fin.Fin n) => Functions.constant Rotations.topology (Pivot.basis.value.apply v i));
\definition inverseRegular: Unitary.Families[X := Rotations.Carrier].Regular Rotations.topology (\fun (A: Rotations.Carrier) => Unitary.inverse (Rotations.unitary A)) :=
  Unitary.Families[X := Rotations.Carrier].reciprocal Rotations.topology Rotations.unitary Rotations.regular;
\definition coordinates: Geometry.At[n := k].Families[X := Rotations.Carrier].Matrix[m := n].Regular Rotations.topology (\fun (A: Rotations.Carrier) => (frame A).basis.coordinate) :=
  \fun (v: Ambient.Vector)(i: Fin.Fin k) => Forward.evaluate Rotations.topology (\fun (A: Rotations.Carrier) => (Rotations.unitary A).backward)
    (\fun (_: Rotations.Carrier) => v) inverseRegular (\fun (j: Fin.Fin n) => Functions.constant Rotations.topology (v j)) (symbol.pivot i);
