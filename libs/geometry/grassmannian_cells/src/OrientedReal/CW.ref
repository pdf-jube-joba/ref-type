\import \root.Symbols[n := n, k := k] \as Symbols;
\import \root.CWReal[n := n, k := k] \as Ordinary;
\import \parent.Atlas[] \as Atlas;
\import std.Data[].List[] \as Lists;
\import Lists.Membership[A := Symbols.Symbol] \as Members;
\import algebraic_topology.CW[A := Carrier] \as CW;
\import algebraic_topology.Euclidean[] \as Euclidean;
\import \root.FiniteCW[A := Carrier, space := Atlas.topology] \as Finite;
\import \root.DecompositionReal[n := n, k := k] \as Decomposition;
\structure Index: \Set := { symbol: Symbols.Symbol, sign: Signs.Carrier };
\definition indexEta: \forall (a: Index) -> Index::# a.symbol a.sign = a :=
  \induction (a: Index) \return Index::# a.symbol a.sign = a \with { | # : \fun (s: Symbols.Symbol)(t: Signs.Carrier) => \refl(Index::# s t) };
\import Lists.Membership[A := Index] \as IndexMembers;
\definition enumerate: Lists.List[Symbols.Symbol] -> Lists.List[Index] := Lists.foldr Symbols.Symbol (Lists.List[Index])
  (\fun (s: Symbols.Symbol)(tail: Lists.List[Index]) => Lists.List[Index]::cons (Index::# s Signs.positive) (Lists.List[Index]::cons (Index::# s Signs.negative) tail)) (Lists.List[Index]::nil);
\module Enumeration;
\module With(disks: Ordinary.Disks, symbols: Lists.List[Symbols.Symbol], exhaustive: \forall (s: Symbols.Symbol) -> Members.Occurs s symbols);
\definition exists: \exists CW.FiniteComplex[Atlas.topology] := \block {
  \takefrom disks: Ordinary.Disks \by Ordinary.disksExist \then
  \takefrom symbols: std.Set[].FiniteSubset[A := Symbols.Symbol].Enumeration[].DistinctEnumeration[Symbols.Enumeration[].whole] \by Symbols.Enumeration[].enumerationExists \then
  \let laws: std.Set[].FiniteSubset[A := Symbols.Symbol].Enumeration[].DistinctEnumerationLaws[Symbols.Enumeration[].whole, symbols] :=
    \bysub(Lists.List[Symbols.Symbol], std.Set[].FiniteSubset[A := Symbols.Symbol].Enumeration[].DistinctEnumeration[Symbols.Enumeration[].whole], symbols) \then
  \return \exact(Finite.build With[disks := disks, symbols := symbols, exhaustive := \fun (s: Symbols.Symbol) => laws.enumerates.exhaustive s (\refl(s))].presentation,
    CW.FiniteComplex[Atlas.topology])
};
