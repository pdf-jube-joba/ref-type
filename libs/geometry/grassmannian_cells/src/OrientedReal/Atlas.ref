\import topology.Topology[Carrier := Base.Carrier] \as BaseSpace;
\import topology.Topology[Carrier := Carrier] \as Space;
\import Ambient.Families[X := Base.Carrier].ProjectionFrames[k := k, source := Base.topology, P := Base.projection] \as LocalFrames;
\structure Patch: \Set := {
  domain: \Pow Base.Carrier,
  open: BaseSpace.IsOpenIn Base.topology domain,
  value: \forall (p: \Cast[Base.Carrier] domain) -> Frame p,
  regular: Ambient.Families[X := \Cast[Base.Carrier] domain].Matrix[m := k].Regular (BaseSpace.Subspace[S := domain].topology Base.topology) (\fun (p: \Cast[Base.Carrier] domain) => (value p).basis.value),
  coordinates: Geometry.At[n := k].Families[X := \Cast[Base.Carrier] domain].Matrix[m := n].Regular (BaseSpace.Subspace[S := domain].topology Base.topology) (\fun (p: \Cast[Base.Carrier] domain) => (value p).basis.coordinate),
};
\definition covers: \forall (p: Base.Carrier) -> \exists (c: Patch \where BaseSpace.Member c.domain p) := \block {
  \fun (p: Base.Carrier) \then
  \takefrom c: LocalFrames.Local[p] \by LocalFrames.exists Base.regular Base.rank p \then
  \let patch: Patch := Patch { domain := c.domain, open := c.open, value := c.value, regular := c.regular, coordinates := c.coordinates } \then
  \return Logic.existsIntro[Patch, { c: Patch \where BaseSpace.Member c.domain p }] patch c.contains
};
\definition Domain[c: Patch]: \Pow Carrier := { e: Carrier \where BaseSpace.Member c.domain e.base };
\definition evaluate[c: Patch][e: \Cast[Carrier] (Domain c)]: Signs.Carrier :=
  e.orientation.value (c.value (\into[Base.Carrier](e.base, c.domain) \by { \bysub(Carrier, Domain c, e) }));
\import bundle_operations.Operations[].Evaluations[K := Signs.Carrier, X := Base.Carrier, E := Carrier, I := Patch,
  scalarSpace := Signs.topology, baseSpace := Base.topology, projection := projection, domains := \fun (c: Patch) => c.domain,
  open := \fun (c: Patch) => c.open, evaluate := evaluate] \as Evaluations;
\definition topology: Space.Topology := Evaluations.topology;
\definition projectionContinuous: topology.Continuity[A := Carrier, B := Base.Carrier].Continuous topology Base.topology projection := Evaluations.projectionContinuous;
\module Family(X: \Set, source: topology.Topology[Carrier := X].Topology, p: X -> Base.Carrier,
  baseContinuous: topology.Continuity[A := X, B := Base.Carrier].Continuous source Base.topology p,
  frame: \forall (x: X) -> Frame (p x),
  regular: Ambient.Families[X := X].Matrix[m := k].Regular source (\fun (x: X) => (frame x).basis.value),
  coordinates: Geometry.At[n := k].Families[X := X].Matrix[m := n].Regular source (\fun (x: X) => (frame x).basis.coordinate));
\module In(c: Patch);
\module Hausdorff;
\definition hausdorff: Space.IsT2 topology := Hausdorff[].law;
\module Cover;
