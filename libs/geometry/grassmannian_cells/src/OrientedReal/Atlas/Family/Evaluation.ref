\import Evaluations.Universal[A := X].At[i := c, f := map signs] \as Test;
\definition subset: \Pow X := { x: X \where \In[Base.Carrier] c.domain (p x) };
\import Source.Subspace[S := subset] \as Subspace;
\definition Point: \Set := Subspace.CarrierSet;
\definition space: topology.Topology[Carrier := Point].Topology := Subspace.topology source;
\import topology.Topology[Carrier := Base.Carrier].Subspace[S := c.domain] \as Under;
\definition projected[x: Point]: Under.CarrierSet := \into[Base.Carrier](p x, c.domain) \by { \bysub(X, subset, x) };
\definition projectedContinuous: topology.Continuity[A := Point, B := Under.CarrierSet].Continuous space (Under.topology Base.topology) projected :=
  topology.Continuity[A := Point, B := Base.Carrier].Corestriction[S := c.domain].corestrictContinuous space Base.topology projected
    (topology.Continuity[A := X, B := Base.Carrier].Restriction[S := subset].restrictContinuous source Base.topology p baseContinuous);
\definition first[x: Point]: Frame (p x) := frame x;
\definition second[x: Point]: Frame (p x) := c.value (projected x);
\definition firstCoordinates: Geometry.At[n := k].Families[X := Point].Matrix[m := n].Regular space (\fun (x: Point) => (first x).basis.coordinate) :=
  \fun (v: Ambient.Vector)(i: Fin.Fin k) => topology.Continuity[A := X, B := R.Real].Restriction[S := subset].restrictContinuous source H.Real[].topological.space
    (\fun (x: X) => (frame x).basis.coordinate.apply v i) (coordinates v i);
\definition secondRegular: Ambient.Families[X := Point].Matrix[m := k].Regular space (\fun (x: Point) => (second x).basis.value) :=
  \fun (v: FrameCoordinates.Vector)(i: Fin.Fin n) => topology.Composition[A := Point, B := Under.CarrierSet, C := R.Real].composeContinuous
    space (Under.topology Base.topology) H.Real[].topological.space projected (\fun (u: Under.CarrierSet) => (c.value u).basis.value.apply v i)
    projectedContinuous (c.regular v i);
\definition signsContinuous: Signs.Functions[X := Point].Continuous space (\fun (x: Point) => signs x) :=
  topology.Continuity[A := X, B := Signs.Carrier].Restriction[S := subset].restrictContinuous source Signs.topology signs signContinuous;
\definition continuous: Test.Regular source := Signs.Functions[X := Point].product space (\fun (x: Point) => signs x)
  (\fun (x: Point) => transition (p x) (first x) (second x)) signsContinuous
  (\root.OrientedReal[n := n, k := k].TransitionFamily[X := Point, source := space, p := \fun (x: Point) => p x, f := first, g := second,
    coordinates := firstCoordinates, regular := secondRegular].continuous);
