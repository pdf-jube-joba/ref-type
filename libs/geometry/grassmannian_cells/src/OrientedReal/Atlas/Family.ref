\import \root.OrientedReal[n := n, k := k].Atlas[] \as Atlas;
\import bundle_operations.Operations[].Evaluations[K := Signs.Carrier, X := Base.Carrier, E := Carrier, I := Atlas.Patch,
  scalarSpace := Signs.topology, baseSpace := Base.topology, projection := projection, domains := \fun (c: Atlas.Patch) => c.domain,
  open := \fun (c: Atlas.Patch) => c.open, evaluate := Atlas.evaluate] \as Evaluations;
\import topology.Topology[Carrier := X] \as Source;
\definition map[signs: X -> Signs.Carrier][x: X]: Carrier := include (p x) (frame x) (signs x);
\module Evaluation(signs: X -> Signs.Carrier, signContinuous: Signs.Functions[X := X].Continuous source signs, c: Atlas.Patch);
\definition continuous: \forall (signs: X -> Signs.Carrier) -> Signs.Functions[X := X].Continuous source signs ->
  topology.Continuity[A := X, B := Carrier].Continuous source Atlas.topology (map signs) :=
  \fun (signs: X -> Signs.Carrier)(signContinuous: _) => Evaluations.Universal[A := X].continuous source (map signs) baseContinuous
    (\fun (c: Atlas.Patch) => Evaluation[signs := signs, signContinuous := signContinuous, c := c].continuous);
