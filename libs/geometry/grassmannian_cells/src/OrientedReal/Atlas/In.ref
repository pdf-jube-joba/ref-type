\import BaseSpace.Subspace[S := c.domain] \as Under;
\import Space.Subspace[S := Domain c] \as Over;
\import topology.Topology[Carrier := Signs.Carrier] \as SignSpace;
\import std.Data[].Pair[] \as Pair;
\import topological_constructions.Product[A := Under.CarrierSet, B := Signs.Carrier] \as Product;
\import Pair.Prop[A := Under.CarrierSet, B := Signs.Carrier] \as PairLaws;
\definition productTopology: topology.Topology[Carrier := Product.CarrierSet].Topology := Product.topology (Under.topology Base.topology) Signs.topology;
\definition base[e: Over.CarrierSet]: Under.CarrierSet := \into[Base.Carrier](e.base, c.domain) \by { \bysub(Carrier, Domain c, e) };
\definition forward[e: Over.CarrierSet]: Product.CarrierSet := Pair.pair Under.CarrierSet Signs.Carrier (base e) (evaluate c e);
\definition backward[p: Product.CarrierSet]: Over.CarrierSet := \into[Carrier]
  (include (Pair.first Under.CarrierSet Signs.Carrier p) (c.value (Pair.first Under.CarrierSet Signs.Carrier p)) (Pair.second Under.CarrierSet Signs.Carrier p), Domain c) \by {
    \bysub(Base.Carrier, c.domain, Pair.first Under.CarrierSet Signs.Carrier p)
  };
\definition leftInverse: \forall (e: Over.CarrierSet) -> backward (forward e) = e := \fun (e: Over.CarrierSet) => trans!{Carrier} _ _ _
  (congr!{{Orientation e.base} Carrier} (Carrier::# e.base) _ _ (reconstruct e.base (c.value (base e)) e.orientation)) (eta e);
\definition rightInverse: \forall (p: Product.CarrierSet) -> forward (backward p) = p := \fun (p: Product.CarrierSet) =>
  PairLaws.ext (forward (backward p)) p (\refl(Pair.first Under.CarrierSet Signs.Carrier p))
    (fromFrameAt (Pair.first Under.CarrierSet Signs.Carrier p) (c.value (Pair.first Under.CarrierSet Signs.Carrier p)) (Pair.second Under.CarrierSet Signs.Carrier p));
\definition baseContinuous: topology.Continuity[A := Over.CarrierSet, B := Under.CarrierSet].Continuous (Over.topology topology) (Under.topology Base.topology) base :=
  topology.Continuity[A := Over.CarrierSet, B := Base.Carrier].Corestriction[S := c.domain].corestrictContinuous (Over.topology topology) Base.topology base
    (topology.Continuity[A := Carrier, B := Base.Carrier].Restriction[S := Domain c].restrictContinuous topology Base.topology projection projectionContinuous);
\definition forwardContinuous: topology.Continuity[A := Over.CarrierSet, B := Product.CarrierSet].Continuous (Over.topology topology) productTopology forward :=
  Product.Universal[X := Over.CarrierSet].pairContinuous (Over.topology topology) (Under.topology Base.topology) Signs.topology base (evaluate c)
    baseContinuous (Evaluations.At[i := c].continuous);
\module Backward;
\definition backwardContinuous: topology.Continuity[A := Product.CarrierSet, B := Over.CarrierSet].Continuous productTopology (Over.topology topology) backward :=
  topology.Continuity[A := Product.CarrierSet, B := Carrier].Corestriction[S := Domain c].corestrictContinuous productTopology topology backward Backward[].continuous;
\definition homeomorphism: topology.Homeomorphism[A := Over.CarrierSet, B := Product.CarrierSet].Homeomorphism[Over.topology topology, productTopology] :=
  topology.Homeomorphism[A := Over.CarrierSet, B := Product.CarrierSet].Homeomorphism[Over.topology topology, productTopology] {
    forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
    forwardContinuous := forwardContinuous, backwardContinuous := backwardContinuous,
  };

\definition BasePoint: \Set := Under.CarrierSet;
\definition TotalPoint: \Set := Over.CarrierSet;
\definition ProductPoint: \Set := Product.CarrierSet;
\definition baseTopology: topology.Topology[Carrier := BasePoint].Topology := Under.topology Base.topology;
\definition totalTopology: topology.Topology[Carrier := TotalPoint].Topology := Over.topology topology;
\definition productExt: \forall (p, q: ProductPoint) -> Pair.first BasePoint Signs.Carrier p = Pair.first BasePoint Signs.Carrier q ->
  Pair.second BasePoint Signs.Carrier p = Pair.second BasePoint Signs.Carrier q -> p = q := PairLaws.ext;
