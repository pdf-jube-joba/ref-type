\import covering_spaces.Projection[E := Carrier, B := Base.Carrier, total := topology, base := Base.topology, projection := projection] \as Covering;
\module At(b: Base.Carrier, c: Patch, contains: BaseSpace.Member c.domain b);
\definition covering: Covering.Covering := Covering.Covering {
  continuous := projectionContinuous,
  local := \block {
    \fun (b: Base.Carrier) \then
    \takefrom c: \Cast[Patch] ({ c: Patch \where BaseSpace.Member c.domain b }) \by covers b \then
    \let contains: BaseSpace.Member c.domain b := \bysub(Patch, { c: Patch \where BaseSpace.Member c.domain b }, c) \then
    \return \exact(Covering.LocalChart[b] { neighborhood := c.domain, open := c.open, contains := contains,
      chart := At[b := b, c := c, contains := contains].chart,
    }, Covering.LocalChart[b])
  },
  surjective := \block {
    \fun (b: Base.Carrier) \then
    \takefrom f: Frame b \by frameExists b \then
    \return \exact(\into[Carrier](include b f Signs.positive, Covering.Fiber b) \by { \refl(b) }, Covering.Fiber b)
  },
};
\structure TwoSheets[b: Base.Carrier]: \Set := {
  bijection: std.Data[].Bijection[A := Signs.Carrier, B := Covering.Fiber b].Bijection,
};
\definition twoSheets: \forall (b: Base.Carrier) -> \exists TwoSheets[b] := \block {
  \fun (b: Base.Carrier) \then
  \takefrom c: \Cast[Patch] ({ c: Patch \where BaseSpace.Member c.domain b }) \by covers b \then
  \let contains: BaseSpace.Member c.domain b := \bysub(Patch, { c: Patch \where BaseSpace.Member c.domain b }, c) \then
  \return \exact(TwoSheets[b] { bijection := At[b := b, c := c, contains := contains].fiberBijection }, TwoSheets[b])
};
