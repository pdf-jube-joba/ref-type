\import \parent.\parent.In[c := c] \as Chart;
\import Covering.Around[b := b, U := c.domain] \as Around;
\import std.Data[].Pair[] \as Pair;
\import std.Data[].Bijection[A := Signs.Carrier, B := Covering.Fiber b] \as Bijections;
\definition center: Chart.BasePoint := \into[Base.Carrier](b, c.domain) \by { contains };
\definition over[e: Covering.Fiber b]: Chart.TotalPoint := \into[Carrier](e, Domain c) \by {
  \idelim b = e.base \with p: Base.Carrier => BaseSpace.Member c.domain p \by { base: contains, equality: sym!{{Base.Carrier}} _ _ (Covering.projectsTo b e) }
};
\definition read[e: Covering.Fiber b]: Signs.Carrier := evaluate c (over e);
\definition sheet[s: Signs.Carrier]: Covering.Fiber b := \into[Carrier](include b (c.value center) s, Covering.Fiber b) \by { \refl(b) };
\definition readSheet: \forall (s: Signs.Carrier) -> read (sheet s) = s := \fun (s: Signs.Carrier) => fromFrameAt b (c.value center) s;
\definition sheetRead: \forall (e: Covering.Fiber b) -> sheet (read e) = e := \fun (e: Covering.Fiber b) => eq_reason_in!{Carrier _
  "=" _ "by" { congr!{{Chart.ProductPoint} {Chart.TotalPoint}} Chart.backward _ _
    (Chart.productExt (Pair.pair Chart.BasePoint Signs.Carrier center (read e)) (Chart.forward (over e))
      (sym!{{Base.Carrier}} _ _ (Covering.projectsTo b e)) (\refl(read e))) }
  "=" _ "by" { Chart.leftInverse (over e) }
};
\definition fiberBijection: Bijections.Bijection := Bijections.Bijection { forward := sheet, backward := read, leftInverse := readSheet, rightInverse := sheetRead };
\import topology.Topology[Carrier := Covering.Fiber b] \as FiberSpace;
\definition sheetContinuous: topology.Continuity[A := Signs.Carrier, B := Covering.Fiber b].Continuous Signs.topology FiberSpace.Discrete sheet :=
  \fun (U: \Pow (Covering.Fiber b))(_ : _) => Signs.allOpen (topology.Maps[A := Signs.Carrier, B := Covering.Fiber b].Preimage sheet U);
\definition readContinuous: topology.Continuity[A := Covering.Fiber b, B := Signs.Carrier].Continuous FiberSpace.Discrete Signs.topology read :=
  \fun (U: \Pow Signs.Carrier)(_ : _) => FiberSpace.discreteOpen (topology.Maps[A := Covering.Fiber b, B := Signs.Carrier].Preimage read U);
\module Products;
\definition homeomorphism: topology.Homeomorphism[A := Chart.TotalPoint, B := Around.FiberProduct].Homeomorphism[Chart.totalTopology, Around.productTopology] :=
  topology.Homeomorphism[A := Chart.TotalPoint, B := Chart.ProductPoint].Composition[C := Around.FiberProduct].compose
    (Chart.totalTopology) Chart.productTopology Around.productTopology Chart.homeomorphism Products[].homeomorphism;
\definition chart: Around.Chart := \into[topology.Homeomorphism[A := Chart.TotalPoint, B := Around.FiberProduct].Data](homeomorphism, Around.Chart) \by {
  Around.ChartLaws[homeomorphism] { homeomorphism := topology.Homeomorphism[A := Chart.TotalPoint, B := Around.FiberProduct].laws
    (Chart.totalTopology) Around.productTopology homeomorphism, overBase := \fun (e: Chart.TotalPoint) => \refl(e.base), }
};
