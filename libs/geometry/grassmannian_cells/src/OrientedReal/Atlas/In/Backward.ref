\definition first[p: Product.CarrierSet]: Under.CarrierSet := Pair.first Under.CarrierSet Signs.Carrier p;
\definition second[p: Product.CarrierSet]: Signs.Carrier := Pair.second Under.CarrierSet Signs.Carrier p;
\definition firstContinuous: topology.Continuity[A := Product.CarrierSet, B := Under.CarrierSet].Continuous productTopology (Under.topology Base.topology) first :=
  Product.Maps[].firstContinuous (Under.topology Base.topology) Signs.topology;
\definition secondContinuous: Signs.Functions[X := Product.CarrierSet].Continuous productTopology second := Product.Maps[].secondContinuous (Under.topology Base.topology) Signs.topology;
\definition projected[p: Product.CarrierSet]: Base.Carrier := first p;
\definition projectedContinuous: topology.Continuity[A := Product.CarrierSet, B := Base.Carrier].Continuous productTopology Base.topology projected :=
  topology.Composition[A := Product.CarrierSet, B := Under.CarrierSet, C := Base.Carrier].composeContinuous productTopology (Under.topology Base.topology) Base.topology
    first (\fun (u: Under.CarrierSet) => u) firstContinuous
    (topology.Continuity[A := Product.CarrierSet, B := Base.Carrier].Corestriction[S := c.domain].inclusionContinuous Base.topology);
\definition frame[p: Product.CarrierSet]: Frame (projected p) := c.value (first p);
\definition regular: Ambient.Families[X := Product.CarrierSet].Matrix[m := k].Regular productTopology (\fun (p: Product.CarrierSet) => (frame p).basis.value) :=
  \fun (v: FrameCoordinates.Vector)(i: Fin.Fin n) => topology.Composition[A := Product.CarrierSet, B := Under.CarrierSet, C := R.Real].composeContinuous
    productTopology (Under.topology Base.topology) H.Real[].topological.space first (\fun (u: Under.CarrierSet) => (c.value u).basis.value.apply v i) firstContinuous (c.regular v i);
\definition coordinates: Geometry.At[n := k].Families[X := Product.CarrierSet].Matrix[m := n].Regular productTopology (\fun (p: Product.CarrierSet) => (frame p).basis.coordinate) :=
  \fun (v: Ambient.Vector)(i: Fin.Fin k) => topology.Composition[A := Product.CarrierSet, B := Under.CarrierSet, C := R.Real].composeContinuous
    productTopology (Under.topology Base.topology) H.Real[].topological.space first (\fun (u: Under.CarrierSet) => (c.value u).basis.coordinate.apply v i) firstContinuous (c.coordinates v i);
\definition continuous: topology.Continuity[A := Product.CarrierSet, B := Carrier].Continuous productTopology topology (\fun (p: Product.CarrierSet) => backward p) :=
  \parent.\parent.Family[X := Product.CarrierSet, source := productTopology, p := projected, baseContinuous := projectedContinuous, frame := frame,
    regular := regular, coordinates := coordinates].continuous second secondContinuous;
