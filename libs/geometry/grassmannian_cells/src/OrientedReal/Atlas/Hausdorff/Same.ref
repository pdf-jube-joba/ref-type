\import \parent.\parent.In[c := c] \as Chart;
\import Space.Subspace[S := Domain c] \as Subspace;
\import Subspace.Open[] \as Inclusion;
\import bundle_operations.Operations[].Subset[E := Carrier, U := Domain c] \as Subset;
\definition left: Chart.TotalPoint := \into[Carrier](e, Domain c) \by { first };
\definition right: Chart.TotalPoint := \into[Carrier](f, Domain c) \by { second };
\definition a: Signs.Carrier := evaluate c left;
\definition b: Signs.Carrier := evaluate c right;
\definition distinct: Logic.Not (a = b) := \fun (same: _) => different (eq_reason_in!{Carrier e
  "=" _ "by" { sym!{Carrier} _ _ (Chart.leftInverse left) }
  "=" _ "by" { congr!{{Chart.ProductPoint} {Chart.TotalPoint}} Chart.backward _ _
    (Chart.productExt (Chart.forward left) (Chart.forward right) sameBase same) }
  "=" _ "by" { Chart.leftInverse right }
});
\definition U: \Pow Carrier := Evaluations.Test c (topology.Topology[Carrier := Signs.Carrier].Singleton a);
\definition V: \Pow Carrier := Evaluations.Test c (topology.Topology[Carrier := Signs.Carrier].Singleton b);
\definition disjoint: Space.Disjoint U V := \fun (x: Carrier)(inU: _)(inV: _) =>
  Inclusion.imageElim (topology.Maps[A := Chart.TotalPoint, B := Signs.Carrier].Preimage (evaluate c) (topology.Topology[Carrier := Signs.Carrier].Singleton a)) x Logic.False
    (\fun (u: Chart.TotalPoint)(ua: evaluate c u = a)(ux: u = x) =>
      Inclusion.imageElim (topology.Maps[A := Chart.TotalPoint, B := Signs.Carrier].Preimage (evaluate c) (topology.Topology[Carrier := Signs.Carrier].Singleton b)) x Logic.False
        (\fun (v: Chart.TotalPoint)(vb: evaluate c v = b)(vx: v = x) => distinct (eq_reason_in!{{Signs.Carrier} a
          "=" _ "by" { sym!{{Signs.Carrier}} _ _ ua }
          "=" _ "by" { congr!{{Chart.TotalPoint} {Signs.Carrier}} (evaluate c) _ _ (Subset.equality u v (trans!{Carrier} _ _ _ ux (sym!{Carrier} _ _ vx))) }
          "=" _ "by" vb
        })) inV) inU;
\definition separate: \exists (W: \Pow Carrier \where Space.RegularChoice[topology, Space.Singleton f, e, W]) :=
  Logic.existsIntro[\Pow Carrier, { W: \Pow Carrier \where Space.RegularChoice[topology, Space.Singleton f, e, W] }] U
    (Space.RegularChoice[topology, Space.Singleton f, e, U] {
      open := Evaluations.testOpen c _ (Signs.allOpen _),
      contains := Inclusion.imageMember _ left (\refl(a)),
      partner := Logic.existsIntro[\Pow Carrier, { W: \Pow Carrier \where Space.NormalPartner[topology, Space.Singleton f, U, W] }] V
        (Space.NormalPartner[topology, Space.Singleton f, U, V] {
          open := Evaluations.testOpen c _ (Signs.allOpen _),
          covers := \fun (x: Carrier)(same: x = f) => \idelim f = x \with y: Carrier => Space.Member V y \by {
            base: Inclusion.imageMember _ right (\refl(b)), equality: sym!{Carrier} _ _ same
          }, disjoint := disjoint,
        }),
    });
