\import \parent.Atlas[] \as Atlas;
\import Atlas.Family[X := X, source := source, p := p, baseContinuous := baseContinuous,
  frame := frame, regular := regular, coordinates := coordinates] \as Family;
\definition map[signs: X -> Signs.Carrier][x: X]: Carrier := Family.map signs x;
\definition continuous: \forall (signs: X -> Signs.Carrier) -> Signs.Functions[X := X].Continuous source signs ->
  topology.Continuity[A := X, B := Carrier].Continuous source Atlas.topology (map signs) :=
  \fun (signs: X -> Signs.Carrier)(continuous: Signs.Functions[X := X].Continuous source signs) => Family.continuous signs continuous;
