\definition parameter: Carrier := Replace.value previous.parameter;
\definition headRotation: rotation parameter head = rotation single head := rotationCongruent parameter single head
  (trans!{{E.Vector}} _ _ _ (Replace.own previous.parameter) (sym!{{E.Vector}} _ _ (Replace.own origin)));
\definition tailSame: product parameter tail = product previous.parameter tail :=
  productCongruent tail parameter previous.parameter (\fun (j: Fin.Fin k)(member: _) => Replace.other previous.parameter j
    (\fun (same: j = head) => Natural.ltNe head j (ordered.left j member) (sym!{{Fin.Fin k}} _ _ same)));
\definition headFrame: (product parameter (Lists.List[Fin.Fin k]::cons head tail)).forward.apply (axis head) = F head :=
  trans!{{E.Vector}} _ _ _ (congr!{{E.Vector} {E.Vector}} (rotation parameter head).forward.apply _ _
    (\parent.\parent.\parent.HighStep[A := parameter, head := head, tail := tail, ordered := ordered].suffixFixes))
    (trans!{{E.Vector}} _ _ _ (congr!{{Unitary.Carrier} {E.Vector}} (\fun (u: Unitary.Carrier) => u.forward.apply (axis head)) _ _ headRotation) sendsHead);
\definition tailFrame: \forall (j: Fin.Fin k) -> Fin.Occurs k j tail ->
  (product parameter (Lists.List[Fin.Fin k]::cons head tail)).forward.apply (axis j) = F j :=
  \fun (j: Fin.Fin k)(member: _) => eq_reason_in!{{E.Vector} _
    "=" _ "by" { congr!{{Unitary.Carrier} {Unitary.Carrier} {E.Vector}}
      (\fun (u, v: Unitary.Carrier) => u.forward.apply (v.forward.apply (axis j))) _ _ _ _ headRotation tailSame }
    "=" _ "by" { congr!{{E.Vector} {E.Vector}} (rotation single head).forward.apply _ _ (previous.represents j member) }
    "=" _ "by" { (rotation single head).rightInverse (F j) }
  };
\definition value: Presentation[Lists.List[Fin.Fin k]::cons head tail, F] := Presentation[Lists.List[Fin.Fin k]::cons head tail, F] {
  parameter := parameter,
  interior := Replace.interior inside previous.parameter previous.interior,
  represents := \fun (j: Fin.Fin k)(member: _) => either!{member
    {(product parameter (Lists.List[Fin.Fin k]::cons head tail)).forward.apply (axis j) = F j}
    {\fun (same: j = head) => \idelim head = j \with i: Fin.Fin k =>
      (product parameter (Lists.List[Fin.Fin k]::cons head tail)).forward.apply (axis i) = F i \by {
        base: headFrame, equality: sym!{{Fin.Fin k}} _ _ same
      }}
    {\fun (old: _) => tailFrame j old}
  },
};
