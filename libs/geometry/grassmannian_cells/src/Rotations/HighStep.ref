\definition suffixFixes: (product A tail).forward.apply (axis head) = axis head :=
  fixes A tail (axis head) (\fun (i: Fin.Fin k)(member: _) => \parent.Column[j := i].fixesOtherAxis A head
    (\fun (same: head = i) => Natural.ltNe head i (ordered.left i member) same));
\definition atHead: \forall (r: Fin.Fin n) -> Natural.Le (symbol.pivot head) r ->
  (product A (Lists.List[Fin.Fin k]::cons head tail)).forward.apply (axis head) r =
    (rotation A head).forward.apply (axis head) r :=
  \fun (r: Fin.Fin n)(above: _) => congr!{{E.Vector} K} (\fun (v: E.Vector) => (rotation A head).forward.apply v r) _ _ suffixFixes;
\definition inTail: HighCoordinates A tail -> \forall (j: Fin.Fin k) -> Fin.Occurs k j tail ->
  \forall (r: Fin.Fin n) -> Natural.Le (symbol.pivot j) r ->
    (product A (Lists.List[Fin.Fin k]::cons head tail)).forward.apply (axis j) r =
      (rotation A j).forward.apply (axis j) r :=
  \fun (previous: HighCoordinates A tail)(j: Fin.Fin k)(member: _)(r: Fin.Fin n)(above: _) => trans!{K} _ _ _
    (\parent.Column[j := head].preservesAbove A r
      (Natural.ltLeTrans (symbol.pivot head) (symbol.pivot j) r (Symbols.increasing symbol head j (ordered.left j member)) above)
      ((product A tail).forward.apply (axis j)))
    (previous ordered.right j member r above);
