\import Linear.Coordinates[I := Fin.Fin k].Kronecker[] \as ColumnDelta;
\import N.Basic[].Prop[] \as Natural;
\import std.Logic[].Classical[] \as Classical;
\structure Height[F: Matrices.Carrier, j: Fin.Fin k]: \Set := {
  value: R.Real,
  positive: Order.Lt R.zero value,
  agrees: F j (symbol.pivot j) = Geometry.embed value,
};
\structure Adapted[indices: Lists.List[Fin.Fin k], F: Matrices.Carrier]: \Prop := {
  orthonormal: \forall (i, j: Fin.Fin k) -> Fin.Occurs k i indices -> Fin.Occurs k j indices -> E.dot (F i) (F j) = ColumnDelta.delta i j,
  above: \forall (j: Fin.Fin k) -> Fin.Occurs k j indices -> \forall (r: Fin.Fin n) -> Natural.Lt (symbol.pivot j) r -> F j r = Linear.zero,
  diagonal: \forall (j: Fin.Fin k) -> Fin.Occurs k j indices -> \exists Height[F, j],
  excluded: \forall (j: Fin.Fin k) -> Fin.Occurs k j indices -> \forall (i: Fin.Fin k) -> Logic.Not (Fin.Occurs k i indices) -> F j (symbol.pivot i) = Linear.zero,
};
\structure Presentation[indices: Lists.List[Fin.Fin k], F: Matrices.Carrier]: \Set := {
  parameter: Carrier,
  interior: Interior parameter,
  represents: \forall (j: Fin.Fin k) -> Fin.Occurs k j indices -> (product parameter indices).forward.apply (axis j) = F j,
};
\definition origin: Carrier := \into[Matrices.Carrier]((\fun (j: Fin.Fin k) => E.space.zero), Carrier) \by {
  ParameterLaws[(\fun (j: Fin.Fin k) => E.space.zero)] {
    support := \fun (j: Fin.Fin k)(r: Fin.Fin n)(outside: _) => \refl(Linear.zero),
    bounded := \fun (j: Fin.Fin k) => Order.leReplaceLeft R.zero (Inner.squared E.space.zero) R.one
      (sym!{R.Real} _ _ \parent.Parameters[].squaredZero) Order.Arithmetic[].Prop[].oneNonnegative,
  }
};
\definition originInterior: Interior origin := \fun (j: Fin.Fin k) => Order.ltReplaceLeft R.zero (Inner.squared E.space.zero) R.one
  (sym!{R.Real} _ _ \parent.Parameters[].squaredZero) R.Estimates[].Product[].onePositive;
\definition Existence[indices: Lists.List[Fin.Fin k]]: \Prop := Ordered.Ordered indices ->
  \forall (F: Matrices.Carrier) -> Adapted[indices, F] -> \exists Presentation[indices, F];
\module Step(head: Fin.Fin k, tail: Lists.List[Fin.Fin k], ordered: Ordered.Ordered (Lists.List[Fin.Fin k]::cons head tail),
  F: Matrices.Carrier, adapted: Adapted[Lists.List[Fin.Fin k]::cons head tail, F], height: Height[F, head]);
\definition exists: \forall (indices: Lists.List[Fin.Fin k]) -> Existence indices :=
  \induction (indices: Lists.List[Fin.Fin k]) \return Existence indices \with {
    | nil: \fun (ordered: _)(F: Matrices.Carrier)(adapted: _) => \exact(Presentation[Lists.List[Fin.Fin k]::nil, F] {
      parameter := origin, interior := originInterior,
      represents := \fun (j: Fin.Fin k)(empty: Logic.False) => Logic.falseElim _ empty,
    }, Presentation[Lists.List[Fin.Fin k]::nil, F])
    | cons: \block {
      \fun (head: Fin.Fin k)(tail: Lists.List[Fin.Fin k])(previous: Existence tail)(ordered: _)(F: Matrices.Carrier)(adapted: _) \then
      \takefrom height: Height[F, head] \by adapted.diagonal head (Logic.Or[_, _]::left (\refl(head))) \then
      \return Step[head := head, tail := tail, ordered := ordered, F := F, adapted := adapted, height := height].exists previous
    }
  };
