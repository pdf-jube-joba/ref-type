\import Reflection.Hemisphere[e := axis head, eUnit := axisUnit head] \as HeadHemisphere;
\import Reflection.Hemisphere[e := axis head, eUnit := axisUnit head].Disk[] \as HeadDisk;
\import \parent.\parent.Column[j := head] \as Head;
\definition headVector: HeadDisk.lift (Head.parameter A) = HeadDisk.lift (Head.parameter B) := eq_reason_in!{{E.Vector} _
  "=" _ "by" { sym!{{E.Vector}} _ _ (Head.sendsAxis A) }
  "=" _ "by" { sym!{{E.Vector}} _ _ (congr!{{E.Vector} {E.Vector}} (rotation A head).forward.apply _ _
    (\parent.\parent.HighStep[A := A, head := head, tail := tail, ordered := ordered].suffixFixes)) }
  "=" _ "by" { same head (Logic.Or[_, _]::left (\refl(head))) }
  "=" _ "by" { congr!{{E.Vector} {E.Vector}} (rotation B head).forward.apply _ _
    (\parent.\parent.HighStep[A := B, head := head, tail := tail, ordered := ordered].suffixFixes) }
  "=" _ "by" { Head.sendsAxis B }
};
\definition headSame: A head = B head := HeadDisk.injective (Head.parameter A) (Head.parameter B) headVector;
\definition rotationSame: rotation A head = rotation B head :=
  Head.congruent A B headSame;
\definition tailSame: Same A B tail := \fun (j: Fin.Fin k)(member: _) => eq_reason_in!{{E.Vector} _
  "=" _ "by" { sym!{{E.Vector}} _ _ ((rotation A head).leftInverse ((product A tail).forward.apply (axis j))) }
  "=" _ "by" { congr!{{E.Vector} {E.Vector}} (rotation A head).backward.apply _ _ (same j (Logic.Or[_, _]::right member)) }
  "=" _ "by" { congr!{{Unitary.Carrier} {E.Vector}} (\fun (u: Unitary.Carrier) => u.backward.apply ((rotation B head).forward.apply ((product B tail).forward.apply (axis j)))) _ _ rotationSame }
  "=" _ "by" { (rotation B head).leftInverse ((product B tail).forward.apply (axis j)) }
};
\definition recover: Recovered A B tail -> Recovered A B (Lists.List[Fin.Fin k]::cons head tail) :=
  \fun (previous: _)(j: Fin.Fin k)(member: _) => either!{member {A j = B j}
    {\fun (same: j = head) => \idelim head = j \with i: Fin.Fin k => A i = B i \by { base: headSame, equality: sym!{{Fin.Fin k}} _ _ same }}
    {\fun (old: _) => previous j old}
  };
