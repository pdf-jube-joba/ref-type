\import \root.Rotations[K := K, field := field, scalar := scalar, topological := topological, n := n, k := k, symbol := symbol].Parameters[] \as ParametersParent;
\definition squared: \forall (a: R.Real)(v: E.Vector) ->
  Inner.squared (E.space.smul (Geometry.embed a) v) = R.mul (R.mul a a) (Inner.squared v) :=
  \fun (a: R.Real)(v: E.Vector) => Geometry.embedInjective _ _ (eq_reason_in!{K _
    "=" _ "by" { sym!{K} _ _ (Inner.selfReal (E.space.smul (Geometry.embed a) v)) }
    "=" _ "by" { Inner.scaleLeft (Geometry.embed a) v (E.space.smul (Geometry.embed a) v) }
    "=" _ "by" { congr!{K K K} Linear.mul _ _ _ _ (scalar.conjugateReal a)
      (trans!{K} _ _ _ (E.scaleRight (Geometry.embed a) v v) (congr!{K K} (Linear.mul (Geometry.embed a)) _ _ (Inner.selfReal v))) }
    "=" _ "by" { sym!{K} _ _ (Linear.mulAssoc (Geometry.embed a) (Geometry.embed a) (Geometry.embed (Inner.squared v))) }
    "=" _ "by" { congr!{K K} (\fun (s: K) => Linear.mul s (Geometry.embed (Inner.squared v))) _ _ (sym!{K} _ _ (scalar.embedMul a a)) }
    "=" _ "by" { sym!{K} _ _ (scalar.embedMul (R.mul a a) (Inner.squared v)) }
  });
\definition gauge: \forall (a: R.Real)(z: Coordinates) -> ParametersParent.gauge (scale a z) = R.mul (R.mul a a) (ParametersParent.gauge z) :=
  \fun (a: R.Real)(z: Coordinates) => trans!{R.Real} _ _ _
    (Maximum.congruent (Fin.elements k) (columnSquared (scale a z)) (\fun (j: Fin.Fin k) => R.mul (R.mul a a) (columnSquared z j))
      (\fun (j: Fin.Fin k) => trans!{R.Real} _ _ _ (congr!{{E.Vector} R.Real} Inner.squared _ _ (fillScale a z j)) (squared a (fill z j))))
    (Maximum.scale (Fin.elements k) (R.mul a a) (R.Algebra[].squareNonnegative a) (columnSquared z));
