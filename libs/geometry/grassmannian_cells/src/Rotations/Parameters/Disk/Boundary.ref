\import \root.Rotations[K := K, field := field, scalar := scalar, topological := topological, n := n, k := k, symbol := symbol].Parameters[].Disk[d := d, chart := chart, chartZero := chartZero, chartScale := chartScale] \as DiskParent;
\import \root.Rotations[K := K, field := field, scalar := scalar, topological := topological, n := n, k := k, symbol := symbol] \as RotationsParent;
\definition ofGauge: \forall (A: Carrier) -> gauge (read A) = R.one -> Boundary A :=
  \fun (A: Carrier)(boundary: gauge (read A) = R.one) => either!{{(Maximum.attained (Fin.elements k) (columnSquared (read A)))} {Boundary A}
    {\fun (atZero: gauge (read A) = R.zero) => Logic.falseElim (Boundary A) (Order.Arithmetic[].Prop[].zeroNeOne
      (trans!{R.Real} R.zero (gauge (read A)) R.one (sym!{R.Real} _ _ atZero) boundary))}
    {\block {
      \fun (found: \exists Maximum.Attained[Fin.elements k, columnSquared (read A)]) \then
      \takefrom point: Maximum.Attained[Fin.elements k, columnSquared (read A)] \by found \then
      \return Logic.existsIntro[Fin.Fin k, { j: Fin.Fin k \where Inner.squared (A j) = R.one }] point.index
        (trans!{R.Real} _ _ _
          (sym!{R.Real} _ _ (congr!{{E.Vector} R.Real} Inner.squared _ _ (congr!{{Matrices.Carrier} {E.Vector}}
            (\fun (B: Matrices.Carrier) => B point.index) (fill (read A)) A (fillRead A))))
          (trans!{R.Real} _ _ _ (sym!{R.Real} _ _ point.same) boundary))
    }}
  };
\definition toGauge: \forall (A: Carrier) -> Boundary A -> gauge (read A) = R.one := \block {
  \fun (A: Carrier)(boundary: Boundary A) \then
  \takefrom j: \Cast[Fin.Fin k] ({ j: Fin.Fin k \where Inner.squared (A j) = R.one }) \by boundary \then
  \let same: columnSquared (read A) j = R.one := trans!{R.Real} _ _ _
    (congr!{{E.Vector} R.Real} Inner.squared _ _ (congr!{{Matrices.Carrier} {E.Vector}} (\fun (B: Matrices.Carrier) => B j) _ _ (fillRead A)))
    (\bysub(Fin.Fin k, { j: Fin.Fin k \where Inner.squared (A j) = R.one }, j)) \then
  \return Order.leAntisym _ R.one (readBound A)
    (Order.leReplaceLeft (columnSquared (read A) j) R.one _ same (upper (read A) j))
};
\definition forward: \forall (x: Standard.Disk) -> Standard.normSquared x = R.one -> Boundary (DiskParent.forward x) :=
  \fun (x: Standard.Disk)(boundary: _) => ofGauge (DiskParent.forward x)
    (trans!{R.Real} _ _ _ (congr!{Coordinates R.Real} gauge _ _ (readForward x)) (Round.forwardBoundary x boundary));
\definition backward: \forall (A: Carrier) -> Boundary A -> Standard.normSquared (DiskParent.backward A) = R.one :=
  \fun (A: Carrier)(boundary: _) => Round.backwardBoundary (intoRound A)
    (trans!{R.Real} _ _ _ (congr!{Coordinates R.Real} gauge _ _ (chartLaws.rightInverse (read A))) (toGauge A boundary));
\definition interiorForward: \forall (x: Standard.Disk) -> Order.Lt (Standard.normSquared x) R.one -> Interior (DiskParent.forward x) :=
  \fun (x: Standard.Disk)(inside: _)(j: Fin.Fin k) => Order.Order[].ltOfLeNotEq _ R.one ((laws (DiskParent.forward x)).bounded j)
    (\fun (boundary: _) => Order.Order[].ltNotEq _ R.one inside (trans!{R.Real} _ _ _
      (congr!{{Standard.Coordinate} R.Real} Standard.normSquared _ _ (sym!{{Standard.Disk}} _ _
        ((topology.Homeomorphism[A := Standard.Disk, B := Carrier].laws Standard.diskTopology RotationsParent.topology homeomorphism).leftInverse x)))
      (backward (DiskParent.forward x)
        (Logic.existsIntro[Fin.Fin k, { i: Fin.Fin k \where Inner.squared (DiskParent.forward x i) = R.one }] j boundary))));
\definition interiorBackward: \forall (A: Carrier) -> Interior A -> Order.Lt (Standard.normSquared (DiskParent.backward A)) R.one :=
  \fun (A: Carrier)(inside: _) => Order.Order[].ltOfLeNotEq _ R.one
    (\bysub(Standard.Coordinate, Standard.ClosedBall, DiskParent.backward A))
    (\block {
      \fun (onBoundary: _) \then
      \let member: Boundary A := \idelim DiskParent.forward (DiskParent.backward A) = A \with B: Carrier => Boundary B \by {
        base: forward (DiskParent.backward A) onBoundary,
        equality: (topology.Homeomorphism[A := Standard.Disk, B := Carrier].laws Standard.diskTopology RotationsParent.topology homeomorphism).rightInverse A
      } \then
      \takefrom j: \Cast[Fin.Fin k] ({ j: Fin.Fin k \where Inner.squared (A j) = R.one }) \by member \then
      \return Order.Order[].ltNotEq _ R.one (inside j) (\bysub(Fin.Fin k, { j: Fin.Fin k \where Inner.squared (A j) = R.one }, j))
    });
