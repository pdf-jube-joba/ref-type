\import std.Data[].List[] \as Lists;
\import Lists.Membership[A := I] \as Members;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Logic.either;
\import real.Analysis[] \as R;
\import R.Distance[] \as Distance;
\import dedekind_reals.DedekindReal[] \as Order;
\definition maximum[indices: Lists.List[I]][f: I -> R.Real]: R.Real :=
  Lists.foldr I R.Real (\fun (i: I)(rest: R.Real) => Distance.max (f i) rest) R.zero indices;
\definition nonnegative: \forall (indices: Lists.List[I])(f: I -> R.Real) -> Order.Le R.zero (maximum indices f) :=
  \induction (indices: Lists.List[I]) \return \forall (f: I -> R.Real) -> Order.Le R.zero (maximum indices f) \with {
    | nil: \fun (f: _) => Order.leRefl R.zero
    | cons: \fun (head: I)(tail: Lists.List[I])(previous: _)(f: _) =>
        Order.leTrans R.zero (maximum tail f) (maximum (Lists.List[I]::cons head tail) f) (previous f) (Distance.maxRight (f head) (maximum tail f))
  };
\definition upper: \forall (indices: Lists.List[I])(f: I -> R.Real)(i: I) -> Members.Occurs i indices -> Order.Le (f i) (maximum indices f) :=
  \induction (indices: Lists.List[I]) \return \forall (f: I -> R.Real)(i: I) -> Members.Occurs i indices -> Order.Le (f i) (maximum indices f) \with {
    | nil: \fun (f: _)(i: I)(empty: Logic.False) => Logic.falseElim _ empty
    | cons: \fun (head: I)(tail: Lists.List[I])(previous: _)(f: _)(i: I)(member: _) =>
        either!{member {Order.Le (f i) (maximum (Lists.List[I]::cons head tail) f)}
          {\fun (same: i = head) => Order.leReplaceLeft (f head) (f i) _ (sym!{R.Real} _ _ (congr!{I R.Real} f _ _ same)) (Distance.maxLeft (f head) (maximum tail f))}
          {\fun (old: _) => Order.leTrans (f i) (maximum tail f) _ (previous f i old) (Distance.maxRight (f head) (maximum tail f))}
        }
  };
\definition least: \forall (indices: Lists.List[I])(f: I -> R.Real)(b: R.Real) -> Order.Le R.zero b ->
  (\forall (i: I) -> Members.Occurs i indices -> Order.Le (f i) b) -> Order.Le (maximum indices f) b :=
  \induction (indices: Lists.List[I]) \return \forall (f: I -> R.Real)(b: R.Real) -> Order.Le R.zero b ->
    (\forall (i: I) -> Members.Occurs i indices -> Order.Le (f i) b) -> Order.Le (maximum indices f) b \with {
    | nil: \fun (f: _)(b: R.Real)(positive: _)(bounds: _) => positive
    | cons: \fun (head: I)(tail: Lists.List[I])(previous: _)(f: _)(b: R.Real)(positive: _)(bounds: _) =>
        Distance.maxLeast (f head) (maximum tail f) b (bounds head (Logic.Or[_, _]::left (\refl(head))))
          (previous f b positive (\fun (i: I)(old: _) => bounds i (Logic.Or[_, _]::right old)))
  };
\structure Attained[indices: Lists.List[I], f: I -> R.Real]: \Set := {
  index: I,
  member: Members.Occurs index indices,
  same: maximum indices f = f index,
};
\definition attained: \forall (indices: Lists.List[I])(f: I -> R.Real) ->
  Logic.Or[maximum indices f = R.zero, \exists Attained[indices, f]] :=
  \induction (indices: Lists.List[I]) \return \forall (f: I -> R.Real) ->
    Logic.Or[maximum indices f = R.zero, \exists Attained[indices, f]] \with {
    | nil: \fun (f: _) => Logic.Or[_, _]::left (\refl(R.zero))
    | cons: \fun (head: I)(tail: Lists.List[I])(previous: _)(f: _) =>
        either!{{(Order.Order[].leTotal (f head) (maximum tail f))}
          {Logic.Or[maximum (Lists.List[I]::cons head tail) f = R.zero, \exists Attained[Lists.List[I]::cons head tail, f]]}
          {\fun (less: _) => either!{{(previous f)}
            {Logic.Or[maximum (Lists.List[I]::cons head tail) f = R.zero, \exists Attained[Lists.List[I]::cons head tail, f]]}
            {\fun (zero: _) => Logic.Or[_, _]::left (trans!{R.Real} _ _ _ (Distance.maxOfLe (f head) (maximum tail f) less) zero)}
            {\block {
              \fun (found: \exists Attained[tail, f]) \then
              \takefrom point: Attained[tail, f] \by found \then
              \return Logic.Or[maximum (Lists.List[I]::cons head tail) f = R.zero,
                \exists Attained[Lists.List[I]::cons head tail, f]]::right (\exact(Attained[Lists.List[I]::cons head tail, f] {
                index := point.index, member := Logic.Or[_, _]::right point.member,
                same := trans!{R.Real} _ _ _ (Distance.maxOfLe (f head) (maximum tail f) less) point.same,
              }, Attained[Lists.List[I]::cons head tail, f]))
            }}
          }}
          {\fun (greater: _) => Logic.Or[_, _]::right (\exact(Attained[Lists.List[I]::cons head tail, f] {
            index := head, member := Logic.Or[_, _]::left (\refl(head)), same := Distance.maxOfGe (f head) (maximum tail f) greater,
          }, Attained[Lists.List[I]::cons head tail, f]))}
        }
  };
\definition zero: \forall (indices: Lists.List[I]) -> maximum indices (\fun (i: I) => R.zero) = R.zero :=
  \induction (indices: Lists.List[I]) \return maximum indices (\fun (i: I) => R.zero) = R.zero \with {
    | nil: \refl(R.zero)
    | cons: \fun (head: I)(tail: Lists.List[I])(previous: _) => trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (Distance.max R.zero) _ _ previous) (Distance.maxSame R.zero)
  };
\definition congruent: \forall (indices: Lists.List[I])(f, g: I -> R.Real) -> (\forall (i: I) -> f i = g i) -> maximum indices f = maximum indices g :=
  \fun (indices: Lists.List[I])(f, g: _)(same: _) => congr!{{I -> R.Real} R.Real} (maximum indices) _ _ (\axiom:funext(f, g, same));
\definition scale: \forall (indices: Lists.List[I])(a: R.Real) -> Order.Le R.zero a -> \forall (f: I -> R.Real) ->
  maximum indices (\fun (i: I) => R.mul a (f i)) = R.mul a (maximum indices f) :=
  \induction (indices: Lists.List[I]) \return \forall (a: R.Real) -> Order.Le R.zero a -> \forall (f: I -> R.Real) ->
    maximum indices (\fun (i: I) => R.mul a (f i)) = R.mul a (maximum indices f) \with {
    | nil: \fun (a: R.Real)(positive: _)(f: _) => sym!{R.Real} _ _ (Order.Arithmetic[].Prop[].fieldMulZeroRight a)
    | cons: \fun (head: I)(tail: Lists.List[I])(previous: _)(a: R.Real)(positive: _)(f: _) => trans!{R.Real} _ _ _
        (congr!{R.Real R.Real} (Distance.max (R.mul a (f head))) _ _ (previous a positive f))
        (sym!{R.Real} _ _ (R.Estimates[].Product[].mulMax a (f head) (maximum tail f) positive))
  };
\module Functions(X: \Set, source: topology.Topology[Carrier := X].Topology);
