\import \parent.\parent.Column[symbol := symbol, j := j] \as Rows;
\definition read[slot: Partition.Fiber j]: Rows.Row := Rows.read slot (\bysub(Free symbol, Partition.Fiber j, slot));
\definition write[row: Rows.Row]: Partition.Fiber j :=
  \into[Free symbol](Rows.slot row, Partition.Fiber j) \by { \refl(j) };
\definition readWrite: \forall (row: Rows.Row) -> read (write row) = row := \fun (row: Rows.Row) => \refl(row);
\definition writeRead: \forall (slot: Partition.Fiber j) -> write (read slot) = slot :=
  \fun (slot: Partition.Fiber j) => trans!{Slot} _ _ _
    (congr!{{Fin.Fin k} Slot} (Slot::# slot.row) _ _ (sym!{{Fin.Fin k}} _ _ (\bysub(Free symbol, Partition.Fiber j, slot))))
    (slotEta slot);
\definition exists: \exists std.Data[].Bijection[A := Fin.Fin (width symbol j), B := Partition.Fiber j].Bijection := \block {
  \takefrom rows: Rows.Bijection \by Rows.indexExists \then
  \return \exact(std.Data[].Bijection[A := Fin.Fin (width symbol j), B := Partition.Fiber j].Bijection {
    forward := \fun (i: Fin.Fin (width symbol j)) => write (rows.forward i),
    backward := \fun (slot: Partition.Fiber j) => rows.backward (read slot),
    leftInverse := \fun (i: Fin.Fin (width symbol j)) => trans!{{Fin.Fin (width symbol j)}} _ _ _
      (congr!{{Rows.Row} {Fin.Fin (width symbol j)}} rows.backward _ _ (readWrite (rows.forward i))) (rows.leftInverse i),
    rightInverse := \fun (slot: Partition.Fiber j) => trans!{Slot} _ _ _
      (congr!{{Rows.Row} {Partition.Fiber j}} write _ _ (rows.rightInverse (read slot))) (writeRead slot),
  }, std.Data[].Bijection[A := Fin.Fin (width symbol j), B := Partition.Fiber j].Bijection)
};
