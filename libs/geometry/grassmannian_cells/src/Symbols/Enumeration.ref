\import std.Set[].FiniteSubset[A := Fin.Fin k -> Fin.Fin n] \as Functions;
\import Functions.Image[B := Data] \as Image;
\import std.Set[].FiniteSubset[A := Data] \as DataSets;
\definition allData: \Pow Data := { d: Data \where d = d };
\definition represented: Image.Image Data::# ({ f: Fin.Fin k -> Fin.Fin n \where f = f }) = allData :=
  \axiom:setext(Image.Image Data::# ({ f: Fin.Fin k -> Fin.Fin n \where f = f }), allData,
    \fun (d: Data)(member: _) => \refl(d),
    \fun (d: Data)(member: _) => \exact(\into[Fin.Fin k -> Fin.Fin n](d.pivot,
      Image.Witness Data::# ({ f: Fin.Fin k -> Fin.Fin n \where f = f }) d) \by {
        Logic.And[_, _]::# (\refl(d.pivot)) (eta d)
      }, Image.Witness Data::# ({ f: Fin.Fin k -> Fin.Fin n \where f = f }) d));
\definition finiteData: DataSets.Finite allData :=
  \idelim Image.Image Data::# ({ f: Fin.Fin k -> Fin.Fin n \where f = f }) = allData
    \with U: \Pow Data => DataSets.Finite U \by {
      base: Image.imageFinite Data::# ({ f: Fin.Fin k -> Fin.Fin n \where f = f }) (Fin.Functions[n := n].finite k),
      equality: represented
    };
\import \root.FiniteRefinement[A := Data, S := { d: Data \where Increasing d }] \as Refined;
\import std.Set[].FiniteSubset[A := Symbol] \as Sets;
\definition whole: \Pow Symbol := { s: Symbol \where s = s };
\definition finite: Sets.Finite whole := Refined.finite finiteData;
\definition symbols: Sets.FiniteSubset := \into[\Pow Symbol](whole, Sets.FiniteSubsetSet) \by { finite };
\definition enumerationExists: \exists Sets.Enumeration[].DistinctEnumeration[whole] :=
  Sets.Enumeration[].existsDistinctEnumeration symbols;
