\import \root.FinitePartition[A := Free symbol, I := Fin.Fin k,
  label := \fun (slot: Free symbol) => slot.column, width := width symbol] \as Partition;
\definition slotEta: \forall (slot: Free symbol) -> Slot::# slot.row slot.column = slot :=
  \fun (slot: Free symbol) => \parent.FreeEnumeration[symbol := symbol].eta slot;
\module Fiber(j: Fin.Fin k);
\definition fibers: \forall (j: Fin.Fin k) ->
  \exists std.Data[].Bijection[A := Fin.Fin (width symbol j), B := Partition.Fiber j].Bijection :=
  \fun (j: Fin.Fin k) => Fiber[j := j].exists;
\definition Bijection: \Set := std.Data[].Bijection[A := Fin.Fin (dimension symbol), B := Free symbol].Bijection;
\definition exists: \exists Bijection := \block {
  \takefrom index: Partition.Index (Fin.elements k) \by Partition.exists fibers (Fin.elements k) (Fin.Enumeration[].distinct k) \then
  \return \exact(std.Data[].Bijection[A := Fin.Fin (dimension symbol), B := Free symbol].Bijection {
    forward := \fun (i: Fin.Fin (dimension symbol)) => index.forward i,
    backward := \fun (slot: Free symbol) => index.backward
      (\into[Free symbol](slot, Partition.Part (Fin.elements k)) \by { Fin.exhaustive k slot.column }),
    leftInverse := index.leftInverse,
    rightInverse := \fun (slot: Free symbol) => index.rightInverse
      (\into[Free symbol](slot, Partition.Part (Fin.elements k)) \by { Fin.exhaustive k slot.column }),
  }, Bijection)
};
\definition indexExists: \exists \root.FiniteIndex[A := Free symbol].Data := \block {
  \takefrom index: Bijection \by exists \then
  \return \exact(\root.FiniteIndex[A := Free symbol].Data { size := dimension symbol, value := index },
    \root.FiniteIndex[A := Free symbol].Data)
};
\definition cardinality: \forall (index: \root.FiniteIndex[A := Free symbol].Data) -> index.size = dimension symbol := \block {
  \fun (index: \root.FiniteIndex[A := Free symbol].Data) \then
  \takefrom standard: Bijection \by exists \then
  \return \root.FiniteCardinality[].equal index.size (dimension symbol)
    (std.Data[].Bijection[A := Fin.Fin index.size, B := Fin.Fin (dimension symbol)].Bijection {
      forward := \fun (i: Fin.Fin index.size) => standard.backward (index.value.forward i),
      backward := \fun (i: Fin.Fin (dimension symbol)) => index.value.backward (standard.forward i),
      leftInverse := \fun (i: Fin.Fin index.size) => trans!{{Fin.Fin index.size}} _ _ _
        (congr!{{Free symbol} {Fin.Fin index.size}} index.value.backward _ _ (standard.rightInverse (index.value.forward i))) (index.value.leftInverse i),
      rightInverse := \fun (i: Fin.Fin (dimension symbol)) => trans!{{Fin.Fin (dimension symbol)}} _ _ _
        (congr!{{Free symbol} {Fin.Fin (dimension symbol)}} standard.backward _ _ (index.value.rightInverse (standard.forward i))) (standard.leftInverse i),
    })
};
