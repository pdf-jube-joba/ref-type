\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].List[] \as Lists;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\use Logic.either;
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as Order;
\import hermitian_frames.Hermitian[].Over[K := K, field := field, scalar := scalar, topological := topological] \as Hermitian;
\import Hermitian.At[n := n] \as Ambient;
\import Ambient.Unitary[] \as Unitary;
\import linear_algebra.Hermitian[].Over[K := K, field := field, scalar := scalar] \as Geometry;
\import Geometry.Finite[n := n] \as E;
\import Geometry.Inner[V := E.Vector, space := E.space].Of[h := E.form] \as Inner;
\import linear_algebra.Commutative[K := K, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing K field] \as Linear;
\import Linear.Coordinates[I := Fin.Fin n].Kronecker[] \as Delta;
\import \root.Symbols[n := n, k := k] \as Symbols;
\import \root.Reflection[K := K, field := field, scalar := scalar, topological := topological, n := n] \as Reflection;
\import topological_algebra.Matrix[K := K, I := Fin.Fin k, J := Fin.Fin n] \as Matrices;
\definition Free[i: Fin.Fin n][j: Fin.Fin k]: \Prop := Symbols.FreeLaws[symbol, Symbols.Slot { row := i, column := j }];
\structure ParameterLaws[A: Matrices.Carrier]: \Prop := {
  support: \forall (j: Fin.Fin k)(i: Fin.Fin n) -> Logic.Not (Free i j) -> A j i = Linear.zero,
  bounded: \forall (j: Fin.Fin k) -> Order.Le (Inner.squared (A j)) R.one,
};
\definition Carrier: \Set := \Cast[Matrices.Carrier] ({ A: Matrices.Carrier \where ParameterLaws[A] });
\definition laws[A: Carrier]: ParameterLaws[A] := \bysub(Matrices.Carrier, Carrier, A);
\definition topology: topology.Topology[Carrier := Carrier].Topology :=
  topology.Topology[Carrier := Matrices.Carrier].Subspace[S := { A: Matrices.Carrier \where ParameterLaws[A] }].topology
    (Matrices.topology topological.space);
\definition entryContinuous: \forall (j: Fin.Fin k)(i: Fin.Fin n) ->
  topology.Continuity[A := Carrier, B := K].Continuous topology topological.space (\fun (A: Carrier) => A j i) :=
  \fun (j: Fin.Fin k)(i: Fin.Fin n) => topology.Composition[A := Carrier, B := Matrices.Carrier, C := K].composeContinuous
    topology (Matrices.topology topological.space) topological.space (\fun (A: Carrier) => A) (Matrices.entry j i)
    (topology.Continuity[A := Carrier, B := Matrices.Carrier].Corestriction[S := { A: Matrices.Carrier \where ParameterLaws[A] }].inclusionContinuous
      (Matrices.topology topological.space)) (Matrices.entryContinuous topological.space j i);
\definition axis[j: Fin.Fin k]: E.Vector := E.basis (symbol.pivot j);
\definition axisUnit: \forall (j: Fin.Fin k) -> E.dot (axis j) (axis j) = Linear.one :=
  \fun (j: Fin.Fin k) => trans!{K} _ _ _ (E.dotBasis (symbol.pivot j) (axis j)) (Delta.self (symbol.pivot j));
\definition pivotZero: \forall (A: Carrier)(i, j: Fin.Fin k) -> A j (symbol.pivot i) = Linear.zero :=
  \fun (A: Carrier)(i, j: Fin.Fin k) => (laws A).support j (symbol.pivot i)
    (\fun (free: Free (symbol.pivot i) j) => free.nonpivot i (\refl(symbol.pivot i)));
\module Column(j: Fin.Fin k);
\definition rotation[A: Carrier][j: Fin.Fin k]: Unitary.Carrier := Column[j := j].rotation A;
\definition product[A: Carrier][indices: Lists.List[Fin.Fin k]]: Unitary.Carrier :=
  Lists.foldr (Fin.Fin k) Unitary.Carrier (\fun (j: Fin.Fin k)(rest: Unitary.Carrier) => Unitary.multiply (rotation A j) rest)
    Unitary.identity indices;
\definition rotationCongruent: \forall (A, B: Carrier)(j: Fin.Fin k) -> A j = B j -> rotation A j = rotation B j :=
  \fun (A, B: Carrier)(j: Fin.Fin k)(same: _) => Column[j := j].congruent A B same;
\definition productCongruent: \forall (indices: Lists.List[Fin.Fin k])(A, B: Carrier) ->
  (\forall (j: Fin.Fin k) -> Fin.Occurs k j indices -> A j = B j) -> product A indices = product B indices :=
  \induction (indices: Lists.List[Fin.Fin k]) \return \forall (A, B: Carrier) ->
    (\forall (j: Fin.Fin k) -> Fin.Occurs k j indices -> A j = B j) -> product A indices = product B indices \with {
    | nil: \fun (A, B: Carrier)(same: _) => \refl(Unitary.identity)
    | cons: \fun (head: Fin.Fin k)(tail: Lists.List[Fin.Fin k])(previous: _)(A, B: Carrier)(same: _) =>
        congr!{{Unitary.Carrier} {Unitary.Carrier} {Unitary.Carrier}} Unitary.multiply _ _ _ _
          (rotationCongruent A B head (same head (Logic.Or[_, _]::left (\refl(head)))))
          (previous A B (\fun (j: Fin.Fin k)(member: _) => same j (Logic.Or[_, _]::right member)))
  };
\import Unitary.Families[X := Carrier] \as Families;
\definition productRegular: \forall (indices: Lists.List[Fin.Fin k]) -> Families.Regular topology (\fun (A: Carrier) => product A indices) :=
  \induction (indices: Lists.List[Fin.Fin k]) \return Families.Regular topology (\fun (A: Carrier) => product A indices) \with {
    | nil: \fun (j: Fin.Fin n) => Ambient.Families[X := Carrier].constant topology (E.basis j)
    | cons: \fun (j: Fin.Fin k)(tail: Lists.List[Fin.Fin k])(previous: _) =>
        Families.product topology (\fun (A: Carrier) => rotation A j) (\fun (A: Carrier) => product A tail)
          (Column[j := j].regular) previous
  };
\definition unitary[A: Carrier]: Unitary.Carrier := product A (Fin.elements k);
\definition regular: Families.Regular topology unitary := productRegular (Fin.elements k);
\definition continuous: topology.Continuity[A := Carrier, B := Unitary.Carrier].Continuous topology Unitary.topology unitary :=
  Families.continuous topology unitary regular;
\definition Interior[A: Carrier]: \Prop := \forall (j: Fin.Fin k) -> Order.Lt (Inner.squared (A j)) R.one;
\definition Boundary[A: Carrier]: \Prop := \exists (j: Fin.Fin k \where Inner.squared (A j) = R.one);
\definition fixes: \forall (A: Carrier)(indices: Lists.List[Fin.Fin k])(v: E.Vector) ->
  (\forall (j: Fin.Fin k) -> Lists.Membership[A := Fin.Fin k].Occurs j indices -> (rotation A j).forward.apply v = v) ->
  (product A indices).forward.apply v = v :=
  \fun (A: Carrier) => \induction (indices: Lists.List[Fin.Fin k]) \return \forall (v: E.Vector) ->
    (\forall (j: Fin.Fin k) -> Lists.Membership[A := Fin.Fin k].Occurs j indices -> (rotation A j).forward.apply v = v) ->
    (product A indices).forward.apply v = v \with {
      | nil: \fun (v: E.Vector)(all: _) => \refl(v)
      | cons: \fun (j: Fin.Fin k)(tail: Lists.List[Fin.Fin k])(previous: _)(v: E.Vector)(all: _) =>
          trans!{{E.Vector}} _ _ _
            (congr!{{E.Vector} {E.Vector}} (rotation A j).forward.apply _ _
              (previous v (\fun (i: Fin.Fin k)(member: _) => all i (Logic.Or[_, _]::right member))))
            (all j (Logic.Or[_, _]::left (\refl(j))))
    };
\import \root.FiniteOrder[].At[A := Fin.Fin k, value := \fun (i: Fin.Fin k) => i] \as Ordered;
\import N.Basic[].Prop[] \as Natural;
\definition HighCoordinates[A: Carrier][indices: Lists.List[Fin.Fin k]]: \Prop :=
  Ordered.Ordered indices -> \forall (j: Fin.Fin k) -> Fin.Occurs k j indices ->
  \forall (r: Fin.Fin n) -> Natural.Le (symbol.pivot j) r ->
    (product A indices).forward.apply (axis j) r = (rotation A j).forward.apply (axis j) r;
\module HighStep(A: Carrier, head: Fin.Fin k, tail: Lists.List[Fin.Fin k],
  ordered: Ordered.Ordered (Lists.List[Fin.Fin k]::cons head tail));
\definition highCoordinates: \forall (A: Carrier)(indices: Lists.List[Fin.Fin k]) -> HighCoordinates A indices :=
  \fun (A: Carrier) => \induction (indices: Lists.List[Fin.Fin k]) \return HighCoordinates A indices \with {
    | nil: \fun (ordered: _)(j: Fin.Fin k)(empty: Logic.False)(r: Fin.Fin n)(above: _) => Logic.falseElim _ empty
    | cons: \fun (head: Fin.Fin k)(tail: Lists.List[Fin.Fin k])(previous: HighCoordinates A tail)
      (ordered: Ordered.Ordered (Lists.List[Fin.Fin k]::cons head tail))(j: Fin.Fin k)(member: _) =>
        either!{member {\forall (r: Fin.Fin n) -> Natural.Le (symbol.pivot j) r ->
          (product A (Lists.List[Fin.Fin k]::cons head tail)).forward.apply (axis j) r = (rotation A j).forward.apply (axis j) r}
          {\fun (same: j = head) =>
            \idelim head = j \with i: Fin.Fin k => \forall (r: Fin.Fin n) -> Natural.Le (symbol.pivot i) r ->
              (product A (Lists.List[Fin.Fin k]::cons head tail)).forward.apply (axis i) r = (rotation A i).forward.apply (axis i) r \by {
                base: HighStep[A := A, head := head, tail := tail, ordered := ordered].atHead,
                equality: sym!{{Fin.Fin k}} _ _ same
              }}
          {\fun (old: _) => HighStep[A := A, head := head, tail := tail, ordered := ordered].inTail previous j old}
        }
  };
\definition diagonal: \forall (A: Carrier)(j: Fin.Fin k) ->
  (unitary A).forward.apply (axis j) (symbol.pivot j) = Geometry.embed (Column[j := j].radius A) :=
  \fun (A: Carrier)(j: Fin.Fin k) => trans!{K} _ _ _
    (highCoordinates A (Fin.elements k) (\root.FiniteOrder[].elements k) j (Fin.exhaustive k j) (symbol.pivot j) (Natural.leRefl (symbol.pivot j)))
    (Column[j := j].ownCoordinate A);
\definition above: \forall (A: Carrier)(j: Fin.Fin k)(r: Fin.Fin n) -> Natural.Lt (symbol.pivot j) r ->
  (unitary A).forward.apply (axis j) r = Linear.zero :=
  \fun (A: Carrier)(j: Fin.Fin k)(r: Fin.Fin n)(above: _) => trans!{K} _ _ _
    (highCoordinates A (Fin.elements k) (\root.FiniteOrder[].elements k) j (Fin.exhaustive k j) r
      (Natural.leTrans (symbol.pivot j) (N.Nat^::succ (symbol.pivot j)) r
        (Natural.leSelfSucc (symbol.pivot j)) (Natural.succLeOfLt r (symbol.pivot j) above)))
    (Column[j := j].axisAboveImage A r above);
\definition boundaryPivot: \forall (A: Carrier)(j: Fin.Fin k) -> Inner.squared (A j) = R.one ->
  (unitary A).forward.apply (axis j) (symbol.pivot j) = Linear.zero :=
  \fun (A: Carrier)(j: Fin.Fin k)(boundary: _) => trans!{K} _ _ _ (diagonal A j)
    (trans!{K} _ _ _ (congr!{R.Real K} Geometry.embed _ _ (Column[j := j].boundaryRadius A boundary)) scalar.embedZero);
\module Parameters;
\module Replace(j: Fin.Fin k, v: E.Vector,
  support: \forall (i: Fin.Fin n) -> Logic.Not (Free i j) -> v i = Linear.zero,
  bounded: Order.Le (Inner.squared v) R.one);
\module FrameInjectivity;
\module FromFrame;
