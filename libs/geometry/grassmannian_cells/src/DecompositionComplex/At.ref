\import Ambient.OnProjection[P := Grassmannian.projection p].Rank[k := k] \as Rank;
\module Using(basis: Rank.Basis, form: Reduction.NormalForm[basis.value]);
\definition exists: \exists Representation[p] := \block {
  \takefrom basis: Rank.Basis \by Grassmannian.rank p \then
  \takefrom form: Reduction.NormalForm[basis.value] \by Reductions.normalFormExists k basis.value (Rank.injective basis) \then
  \return \exact(Using[basis := basis, form := form].representation, Representation[p])
};
