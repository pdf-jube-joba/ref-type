\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Order;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].List[] \as Lists;
\import std.Data[].Bool[] \as Bool;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Logic.either;
\module At(A: \Set, value: A -> N.Nat^);
\module Successor(n: N.Nat^);
\definition elements: \forall (n: N.Nat^) ->
  At[A := Fin.Fin n, value := \fun (i: Fin.Fin n) => i].Ordered (Fin.elements n) :=
  \induction (n: N.Nat^) \return At[A := Fin.Fin n, value := \fun (i: Fin.Fin n) => i].Ordered (Fin.elements n) \with {
    | zero: Logic.True::intro
    | succ: \fun (n: N.Nat^)(previous: _) => Successor[n := n].ordered previous
  };
