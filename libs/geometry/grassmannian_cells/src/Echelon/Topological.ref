\import topological_algebra.Matrix[K := K, I := Fin.Fin n, J := Fin.Fin k] \as MatrixTopology;
\import topological_constructions.Induced[A := Carrier, B := Matrices.Matrix] \as Induced;
\definition topology: topology.Topology[Carrier := Carrier].Topology :=
  Induced.topology (MatrixTopology.topology scalar) (\fun (A: Carrier) => A);
\definition inclusionContinuous: topology.Continuity[A := Carrier, B := Matrices.Matrix].Continuous topology
  (MatrixTopology.topology scalar) (\fun (A: Carrier) => A) :=
  Induced.continuous (MatrixTopology.topology scalar) (\fun (A: Carrier) => A);
\definition entryContinuous: \forall (i: Fin.Fin n)(j: Fin.Fin k) ->
  topology.Continuity[A := Carrier, B := K].Continuous topology scalar (\fun (A: Carrier) => A i j) :=
  \fun (i: Fin.Fin n)(j: Fin.Fin k) => topology.Composition[A := Carrier, B := Matrices.Matrix, C := K].composeContinuous
    topology (MatrixTopology.topology scalar) scalar (\fun (A: Carrier) => A) (MatrixTopology.entry i j)
    inclusionContinuous (MatrixTopology.entryContinuous scalar i j);
\definition freeCoordinateContinuous: \forall (slot: Symbols.Free symbol) ->
  topology.Continuity[A := Carrier, B := K].Continuous topology scalar (\fun (A: Carrier) => freeCoordinates A slot) :=
  \fun (slot: Symbols.Free symbol) => entryContinuous slot.row slot.column;
