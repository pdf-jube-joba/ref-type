\definition forcedZero: \forall (i: Fin.Fin n)(j: Fin.Fin k) ->
  Logic.Not (Free i j) -> Logic.Not (i = symbol.pivot j) -> A i j = Linear.zero :=
  \fun (i: Fin.Fin n)(j: Fin.Fin k)(notFree: _)(notOwn: _) =>
    either!{{(Classical.excludedMiddle (\exists ( a: Fin.Fin k \where i = symbol.pivot a )))} {A i j = Linear.zero}
      {\block {
        \fun (exists: _) \then
        \takefrom a: \Cast[Fin.Fin k] ({ a: Fin.Fin k \where i = symbol.pivot a }) \by exists \then
        \let same: i = symbol.pivot a := \bysub(Fin.Fin k, { a: Fin.Fin k \where i = symbol.pivot a }, a) \then
        \return trans!{K} _ _ _ (congr!{{Fin.Fin n} K} (\fun (r: Fin.Fin n) => A r j) _ _ same)
          (trans!{K} _ _ _ ((laws A).pivot a j) (Delta.different a j
            (\fun (equal: a = j) => notOwn (trans!{{Fin.Fin n}} _ _ _ same (congr!{{Fin.Fin k} {Fin.Fin n}} symbol.pivot _ _ equal)))))
      }}
      {\fun (noPivot: _) => \match NatOrder.trichotomy i (symbol.pivot j) \in std.Logic[].Order[].Trichotomy
        \return (\fun (_: NatOrder.Trichotomy i (symbol.pivot j)) => A i j = Linear.zero) \with {
        | less before: Logic.falseElim _ (notFree (Symbols.FreeLaws[symbol, slot i j] {
            below := before,
            nonpivot := \fun (a: Fin.Fin k)(same: _) => noPivot
              (Logic.existsIntro[Fin.Fin k, { a: Fin.Fin k \where i = symbol.pivot a }] a same),
          }))
        | equal same: Logic.falseElim _ (notOwn same)
        | greater after: (laws A).above i j after
      }}
    };
\definition at: \forall (i: Fin.Fin n)(j: Fin.Fin k) -> fill (freeCoordinates A) i j = A i j :=
  \fun (i: Fin.Fin n)(j: Fin.Fin k) => either!{{(Classical.excludedMiddle (Free i j))} {fill (freeCoordinates A) i j = A i j}
    {\fun (free: _) => \parent.Entry[z := freeCoordinates A, i := i, j := j].laws.free free}
    {\fun (notFree: _) => either!{{(Classical.excludedMiddle (i = symbol.pivot j))} {fill (freeCoordinates A) i j = A i j}
      {\fun (same: _) => trans!{K} _ _ _ (\parent.Entry[z := freeCoordinates A, i := i, j := j].laws.pivot same)
        (sym!{K} _ _ (trans!{K} _ _ _ (congr!{{Fin.Fin n} K} (\fun (r: Fin.Fin n) => A r j) _ _ same)
          (trans!{K} _ _ _ ((laws A).pivot j j) (Delta.self j))))}
      {\fun (notOwn: _) => trans!{K} _ _ _ (\parent.Entry[z := freeCoordinates A, i := i, j := j].laws.otherwise notFree notOwn)
        (sym!{K} _ _ (forcedZero i j notFree notOwn))}
    }}
  };
