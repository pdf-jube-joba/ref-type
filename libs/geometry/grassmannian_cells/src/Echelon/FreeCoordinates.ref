\import std.Logic[].Classical[] \as Classical;
\import std.Data[].Nat[].Order[].Prop[] \as NatOrder;
\import Domain.Kronecker[] \as Delta;
\use Logic.either;
\definition Coordinates: \Set := Symbols.Free symbol -> K;
\definition slot[i: Fin.Fin n][j: Fin.Fin k]: Symbols.Slot := Symbols.Slot { row := i, column := j };
\definition Free[i: Fin.Fin n][j: Fin.Fin k]: \Prop := Symbols.FreeLaws[symbol, slot i j];
\definition freeSlot[i: Fin.Fin n][j: Fin.Fin k][free: Free i j]: Symbols.Free symbol :=
  \into[Symbols.Slot](slot i j, Symbols.Free symbol) \by { free };
\definition freeNotOwn: \forall (i: Fin.Fin n)(j: Fin.Fin k) -> Free i j -> Logic.Not (i = symbol.pivot j) :=
  \fun (i: Fin.Fin n)(j: Fin.Fin k)(free: Free i j) => free.nonpivot j;
\module Entry(z: Coordinates, i: Fin.Fin n, j: Fin.Fin k);
\definition matrix[z: Coordinates][i: Fin.Fin n][j: Fin.Fin k]: K := Entry[z := z, i := i, j := j].value;
\definition pivot: \forall (z: Coordinates)(a, j: Fin.Fin k) -> matrix z (symbol.pivot a) j = Basis.vectors a j :=
  \fun (z: Coordinates)(a, j: Fin.Fin k) => either!{{(Classical.excludedMiddle (a = j))} {matrix z (symbol.pivot a) j = Basis.vectors a j}
    {\fun (same: a = j) => trans!{K} _ _ _
      (Entry[z := z, i := symbol.pivot a, j := j].laws.pivot (congr!{{Fin.Fin k} {Fin.Fin n}} symbol.pivot _ _ same))
      (sym!{K} _ _ (Delta.equal a j same))}
    {\fun (different: Logic.Not (a = j)) => trans!{K} _ _ _
      (Entry[z := z, i := symbol.pivot a, j := j].laws.otherwise
        (\fun (free: Free (symbol.pivot a) j) => free.nonpivot a (\refl(symbol.pivot a)))
        (\fun (same: symbol.pivot a = symbol.pivot j) => different (Symbols.injective symbol a j same)))
      (sym!{K} _ _ (Delta.different a j different))}
  };
\definition above: \forall (z: Coordinates)(i: Fin.Fin n)(j: Fin.Fin k) -> Order.Lt (symbol.pivot j) i -> matrix z i j = Linear.zero :=
  \fun (z: Coordinates)(i: Fin.Fin n)(j: Fin.Fin k)(after: _) => Entry[z := z, i := i, j := j].laws.otherwise
    (\fun (free: Free i j) => NatOrder.ltAsym i (symbol.pivot j) free.below after)
    (\fun (same: i = symbol.pivot j) => Order.ltNe (symbol.pivot j) i after (sym!{{Fin.Fin n}} _ _ same));
\definition fill[z: Coordinates]: Carrier := \into[Matrices.Matrix](matrix z, Carrier) \by {
  Laws[matrix z] { pivot := pivot z, above := above z }
};
\definition slotEta: \forall (u: Symbols.Slot) -> slot u.row u.column = u :=
  \induction (u: Symbols.Slot) \return slot u.row u.column = u \with {
    | # : \fun (i: Fin.Fin n)(j: Fin.Fin k) => \refl(slot i j)
  };
\definition readFill: \forall (z: Coordinates) -> freeCoordinates (fill z) = z :=
  \fun (z: Coordinates) => \axiom:funext(freeCoordinates (fill z), z, \block {
    \fun (u: Symbols.Free symbol) \then
    \let free: Free u.row u.column :=
      \idelim u = slot u.row u.column \with s: Symbols.Slot => Symbols.FreeLaws[symbol, s] \by {
        base: \bysub(Symbols.Slot, Symbols.Free symbol, u), equality: sym!{{Symbols.Slot}} _ _ (slotEta u)
      } \then
    \return trans!{K} _ _ _ (Entry[z := z, i := u.row, j := u.column].laws.free free)
      (congr!{{Symbols.Free symbol} K} z (freeSlot u.row u.column free) u (slotEta u))
  });
\module Of(A: Carrier);
\definition fillRead: \forall (A: Carrier) -> fill (freeCoordinates A) = A :=
  \fun (A: Carrier) => \axiom:funext(fill (freeCoordinates A), A,
    \fun (i: Fin.Fin n) => \axiom:funext((fill (freeCoordinates A)) i, A i,
      \fun (j: Fin.Fin k) => Of[A := A].at i j));
\module Topological(scalar: topology.Topology[Carrier := K].Topology);
