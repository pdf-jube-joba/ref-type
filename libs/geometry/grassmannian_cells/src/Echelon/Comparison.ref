\import \root.Echelon[K := K, field := field, n := n, k := k, symbol := other] \as Other;
\import Symbols.Comparison[s := symbol, t := other] \as Indices;
\import std.Logic[].Classical[] \as Classical;
\import std.Data[].Nat[].Order[].Prop[] \as NaturalOrder;
\import Domain.Kronecker[] \as Delta;
\use Logic.either;
\definition Contained[A: Carrier][B: Other.Carrier]: \Prop :=
  \forall (v: Domain.Vector) -> \In[Ambient.Vector] (Other.Image B) ((linear A).apply v);
\module Column(A: Carrier, B: Other.Carrier, j: Fin.Fin k);
\definition included: \forall (A: Carrier)(B: Other.Carrier) -> Contained A B -> Indices.Included :=
  \fun (A: Carrier)(B: Other.Carrier)(contained: Contained A B)(j: Fin.Fin k) => Column[A := A, B := B, j := j].pivotExists contained;
\definition symbolUnique: \forall (A: Carrier)(B: Other.Carrier) -> Contained A B -> symbol = other :=
  \fun (A: Carrier)(B: Other.Carrier)(contained: Contained A B) => Indices.equal (included A B contained);
