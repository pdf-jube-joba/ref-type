\import hermitian_frames.Hermitian[].Over[K := K, field := field, scalar := scalar, topological := topological] \as Hermitian;
\import Hermitian.At[n := n] \as Ambient;
\import linear_algebra.Hermitian[].Over[K := K, field := field, scalar := scalar] \as Geometry;
\import Geometry.Finite[n := n] \as E;
\import linear_algebra.Commutative[K := K, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing K field] \as Spaces;
\import Spaces.Laws[V := E.Vector, space := E.space] \as Laws;
\import Spaces.Linear[V := E.Vector, W := E.Vector, source := E.space, target := E.space] \as End;
\import End.Operations[] \as Operations;
\import Spaces.Isomorphism[V := E.Vector, W := E.Vector, source := E.space, target := E.space] \as Isomorphisms;
\import Geometry.Inner[V := E.Vector, space := E.space].Of[h := E.form] \as Inner;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\definition negativeZero: E.space.neg E.space.zero = E.space.zero :=
  trans!{{E.Vector}} _ _ _ (sym!{{E.Vector}} _ _ (Laws.minusOneScale E.space.zero)) (Laws.scaleZero (Spaces.neg Spaces.one));
\definition negativeTwice: \forall (v: E.Vector) -> E.space.neg (E.space.neg v) = v :=
  \fun (v: E.Vector) => Laws.cancelLeft (E.space.neg v) (E.space.neg (E.space.neg v)) v
    (trans!{{E.Vector}} _ _ _ (Laws.comm (E.space.neg v) (E.space.neg (E.space.neg v)))
      (trans!{{E.Vector}} _ _ _ (Laws.inverseLeft (E.space.neg v)) (sym!{{E.Vector}} _ _ (Laws.inverseLeft v))));
\definition subtractSelf: \forall (v: E.Vector) -> Inner.subtract v v = E.space.zero :=
  \fun (v: E.Vector) => trans!{{E.Vector}} _ _ _ (Laws.comm v (E.space.neg v)) (Laws.inverseLeft v);
\definition subtractZero: \forall (v: E.Vector) -> Inner.subtract v E.space.zero = v :=
  \fun (v: E.Vector) => trans!{{E.Vector}} _ _ _ (congr!{{E.Vector} {E.Vector}} (E.space.add v) _ _ negativeZero) (Laws.zeroRight v);
\module At(P: Ambient.Projection);
\module Bisector(e, v: E.Vector, eUnit: E.dot e e = Spaces.one, vUnit: E.dot v v = Spaces.one,
  symmetric: E.dot e v = E.dot v e, nonzero: Logic.Not (E.space.add e v = E.space.zero));
\module Hemisphere(e: E.Vector, eUnit: E.dot e e = Spaces.one);
\module Families(X: \Set);
\module Conjugation(P: Ambient.Projection);
