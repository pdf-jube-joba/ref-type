\import Lists.Membership[A := B] \as TargetMembership;
\import \parent.\parent.At[A := B, value := other] \as Target;
\definition member: \forall (xs: Lists.List[A])(b: B) -> TargetMembership.Occurs b (Lists.map A B f xs) ->
  \exists (a: A \where Logic.And[Membership.Occurs a xs, f a = b]) :=
  \induction (xs: Lists.List[A]) \return \forall (b: B) -> TargetMembership.Occurs b (Lists.map A B f xs) ->
    \exists (a: A \where Logic.And[Membership.Occurs a xs, f a = b]) \with {
      | nil: \fun (b: B)(empty: Logic.False) => Logic.falseElim _ empty
      | cons: \fun (head: A)(tail: Lists.List[A])(previous: _)(b: B)(included: _) =>
          either!{included {\exists (a: A \where Logic.And[Membership.Occurs a (Lists.List[A]::cons head tail), f a = b])}
            {\fun (same: b = f head) => Logic.existsIntro[A,
              { a: A \where Logic.And[Membership.Occurs a (Lists.List[A]::cons head tail), f a = b] }] head
              (Logic.And[_, _]::# (Logic.Or[_, _]::left (\refl(head))) (sym!{B} _ _ same))}
            {\block {
              \fun (old: _) \then
              \takefrom a: \Cast[A] ({ a: A \where Logic.And[Membership.Occurs a tail, f a = b] }) \by previous b old \then
              \let data: Logic.And[Membership.Occurs a tail, f a = b] := \bysub(A,
                { a: A \where Logic.And[Membership.Occurs a tail, f a = b] }, a) \then
              \return Logic.existsIntro[A, { a: A \where Logic.And[Membership.Occurs a (Lists.List[A]::cons head tail), f a = b] }] a
                (Logic.And[_, _]::# (Logic.Or[_, _]::right data.left) data.right)
            }}
          }
    };
\definition ordered: \forall (xs: Lists.List[A]) -> Ordered xs -> Target.Ordered (Lists.map A B f xs) :=
  \induction (xs: Lists.List[A]) \return Ordered xs -> Target.Ordered (Lists.map A B f xs) \with {
    | nil: \fun (old: _) => Logic.True::intro
    | cons: \fun (head: A)(tail: Lists.List[A])
      (previous: Ordered tail -> Target.Ordered (Lists.map A B f tail))
      (old: Ordered (Lists.List[A]::cons head tail)) => Logic.And[_, _]::#
        (\block {
          \fun (b: B)(included: _) \then
          \takefrom a: \Cast[A] ({ a: A \where Logic.And[Membership.Occurs a tail, f a = b] }) \by member tail b included \then
          \let data: Logic.And[Membership.Occurs a tail, f a = b] := \bysub(A,
            { a: A \where Logic.And[Membership.Occurs a tail, f a = b] }, a) \then
          \return \idelim f a = b \with c: B => Order.Lt (other (f head)) (other c) \by {
            base: monotone head a (old.left a data.left), equality: data.right
          }
        }) (previous old.right)
  };
