\import Lists.Membership[A := A] \as Membership;
\definition Ordered[xs: Lists.List[A]]: \Prop :=
  (\induction (xs: Lists.List[A]) \return \Prop \with {
    | nil: Logic.True
    | cons: \fun (head: A)(tail: Lists.List[A])(previous: \Prop) =>
        Logic.And[\forall (a: A) -> Membership.Occurs a tail -> Order.Lt (value head) (value a), previous]
  }) xs;
\module Mapping(B: \Set, other: B -> N.Nat^, f: A -> B,
  monotone: \forall (a, b: A) -> Order.Lt (value a) (value b) -> Order.Lt (other (f a)) (other (f b)));
