\import \parent.At[k := N.Nat^::succ k] \as Higher;
\import \parent.At[k := k] \as Lower;
\import Geometry.Finite[n := k].Successor[] \as Split;
\import \root.Symbols[n := n, k := k] \as LowerSymbols;
\import Linear.Coordinates[I := Fin.Fin (N.Nat^::succ k)].Kronecker[] \as HigherDelta;
\import Linear.Coordinates[I := Fin.Fin k].Kronecker[] \as LowerDelta;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition firstBasis: Higher.basis (Fin.zero k) = Split.first :=
  \axiom:funext(Higher.basis (Fin.zero k), Split.first,
    Fin.cases k (\fun (i: Fin.Fin (N.Nat^::succ k)) => Higher.basis (Fin.zero k) i = Split.first i)
      (trans!{K} _ _ _ (HigherDelta.self (Fin.zero k)) (sym!{K} _ _ Split.firstHead))
      (\fun (i: Fin.Fin k) => trans!{K} _ _ _ (HigherDelta.different (Fin.zero k) (Fin.succ k i) (Natural.zeroNeSucc i))
        (sym!{K} _ _ (congr!{{Lower.Vector} K} (\fun (v: Lower.Vector) => v i) _ _ Split.firstTail))));
\definition successorEntries: \forall (i, j: Fin.Fin k) -> Higher.basis (Fin.succ k j) (Fin.succ k i) = Lower.basis j i :=
  \fun (i, j: Fin.Fin k) => either!{{(Classical.excludedMiddle (j = i))} {Higher.basis (Fin.succ k j) (Fin.succ k i) = Lower.basis j i}
    {\fun (same: _) => trans!{K} _ _ _ (HigherDelta.equal _ _ (congr!{{Fin.Fin k} {Fin.Fin (N.Nat^::succ k)}} (Fin.succ k) _ _ same)) (sym!{K} _ _ (LowerDelta.equal j i same))}
    {\fun (different: _) => trans!{K} _ _ _ (HigherDelta.different (Fin.succ k j) (Fin.succ k i)
      (\fun (same: Fin.succ k j = Fin.succ k i) => different (Natural.succInjective j i same))) (sym!{K} _ _ (LowerDelta.different j i different))}
  };
\definition successorBasis: \forall (j: Fin.Fin k) -> Higher.basis (Fin.succ k j) = Split.embedding.apply (Lower.basis j) :=
  \fun (j: Fin.Fin k) => Split.ext _ _
    (trans!{K} _ _ _ (HigherDelta.different (Fin.succ k j) (Fin.zero k) (Natural.succNeZero j))
      (sym!{K} _ _ (Split.joinHead Linear.zero (Lower.basis j))))
    (trans!{{Lower.Vector}} _ _ _ (\axiom:funext(Split.tail (Higher.basis (Fin.succ k j)), Lower.basis j, \fun (i: Fin.Fin k) => successorEntries i j))
      (sym!{{Lower.Vector}} _ _ (Split.joinTail Linear.zero (Lower.basis j))));
\module On(symbol: Higher.Symbol, A: Higher.Map, injective: Higher.Injective A, laws: Higher.Laws[symbol, A]);
\definition exists: Existence k -> Existence (N.Nat^::succ k) :=
  \fun (previous: Existence k)(symbol: Higher.Symbol)(A: Higher.Map)(injective: _)(laws: _) =>
    On[symbol := symbol, A := A, injective := injective, laws := laws].exists previous;
