\import \parent.At[k := N.Nat^::zero] \as Empty;
\definition exists: Existence N.Nat^::zero := \fun (symbol: Empty.Symbol)(A: Empty.Map)(injective: _)(laws: _) =>
  \exact(Empty.Factorization[symbol, A] {
    factor := Inner.Algorithm[].Zero[].factor A,
    triangular := Empty.Laws[symbol, (Inner.Algorithm[].Zero[].factor A).frame] {
      above := \fun (j: Fin.Fin N.Nat^::zero)(r: Fin.Fin n)(above: _) => Logic.falseElim _ (Fin.zeroImpossible j (Fin.bound N.Nat^::zero j)),
      diagonal := \fun (j: Fin.Fin N.Nat^::zero) => Logic.falseElim _ (Fin.zeroImpossible j (Fin.bound N.Nat^::zero j)),
    },
  }, Empty.Factorization[symbol, A]);
