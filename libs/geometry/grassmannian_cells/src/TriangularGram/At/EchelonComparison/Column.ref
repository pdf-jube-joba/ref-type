\definition term[v: Domain.Vector][i: Fin.Fin k]: K := Linear.mul (B (symbol.pivot j) i) (v i);
\definition zeroTerms: \forall (v: Domain.Vector) -> (Echelon.linear B).apply v = column A j ->
  (\forall (i: Fin.Fin k) -> Logic.Not (other.pivot i = symbol.pivot j)) -> \forall (i: Fin.Fin k) -> term v i = Linear.zero :=
  \fun (v: Domain.Vector)(same: _)(absent: _)(i: Fin.Fin k) => \match N.Order[].Prop[].trichotomy (other.pivot i) (symbol.pivot j)
    \in std.Logic[].Order[].Trichotomy \return (\fun (_: N.Order[].Prop[].Trichotomy (other.pivot i) (symbol.pivot j)) => term v i = Linear.zero) \with {
    | less below: trans!{K} _ _ _ (congr!{K K} (\fun (a: K) => Linear.mul a (v i)) _ _ ((Echelon.laws B).above (symbol.pivot j) i below)) (Linear.mulZeroLeft (v i))
    | equal equal: Logic.falseElim _ (absent i equal)
    | greater above: trans!{K} _ _ _ (congr!{K K} (Linear.mul (B (symbol.pivot j) i)) _ _
      (trans!{K} _ _ _ (sym!{K} _ _ (congr!{{Domain.Vector} K} (\fun (x: Domain.Vector) => x i) _ _ (Echelon.leftInverse B v)))
        (trans!{K} _ _ _ (congr!{{Ambient.Vector} K} (\fun (x: Ambient.Vector) => x (other.pivot i)) _ _ same) (triangular.above j (other.pivot i) above))))
      (Linear.mulZeroRight (B (symbol.pivot j) i))
  };
\definition exists: \exists (i: Fin.Fin k \where other.pivot i = symbol.pivot j) :=
  either!{{(Classical.excludedMiddle (\exists (i: Fin.Fin k \where other.pivot i = symbol.pivot j)))}
    {\exists (i: Fin.Fin k \where other.pivot i = symbol.pivot j)}
    {\fun (found: _) => found}
    {\block {
      \fun (none: _) \then
      \takefrom v: \Cast[Domain.Vector] ({ v: Domain.Vector \where (Echelon.linear B).apply v = column A j }) \by contained (Domain.basis j) \then
      \takefrom diagonal: Diagonal[symbol, A, j] \by triangular.diagonal j \then
      \let same: (Echelon.linear B).apply v = column A j := \bysub(Domain.Vector, { v: Domain.Vector \where (Echelon.linear B).apply v = column A j }, v) \then
      \let zero: column A j (symbol.pivot j) = Linear.zero := trans!{K} _ _ _
        (sym!{K} _ _ (congr!{{Ambient.Vector} K} (\fun (x: Ambient.Vector) => x (symbol.pivot j)) _ _ same))
        (trans!{K} _ _ _ (SumLaws.congruent (Fin.elements k) (term v) (\fun (i: Fin.Fin k) => Linear.zero)
          (zeroTerms v same (\fun (i: Fin.Fin k)(equal: _) => none (Logic.existsIntro[Fin.Fin k,
            { i: Fin.Fin k \where other.pivot i = symbol.pivot j }] i equal)))) (SumLaws.zeroSum (Fin.elements k))) \then
      \let valueZero: diagonal.value = R.zero := Geometry.embedInjective _ _
        (trans!{K} _ _ _ (sym!{K} _ _ diagonal.agrees) (trans!{K} _ _ _ zero (sym!{K} _ _ scalar.embedZero))) \then
      \return Logic.falseElim (\exists (i: Fin.Fin k \where other.pivot i = symbol.pivot j)) (Order.Order[].ltNotEq R.zero diagonal.value diagonal.positive (sym!{R.Real} _ _ valueZero))
    }}
  };
