\import Inner.Matrix[k := k, map := A] \as Matrix;
\import Linear.Linear[V := Domain.Vector, W := Domain.Vector, source := Domain.space, target := Domain.space] \as End;
\import Linear.Linear[V := Ambient.Vector, W := Domain.Vector, source := Ambient.space, target := Domain.space]
  .Composition[U := Domain.Vector, domain := Domain.space] \as Compose;
\import Linear.Eigen[V := Domain.Vector, space := Domain.space] \as Eigen;
\import \root.CoordinateMapExt[K := K, ring := std.Alg[].Field[].fieldAsCommutativeRing K field, n := k, k := k] \as Maps;
\definition composite: End.Map := Compose.compose Matrix.coordinates A;
\definition onBasis: \forall (j: Fin.Fin k) -> composite.apply (Domain.basis j) = Domain.basis j :=
  \fun (j: Fin.Fin k) => \axiom:funext(composite.apply (Domain.basis j), Domain.basis j, \fun (i: Fin.Fin k) =>
    trans!{K} _ _ _ (orthonormal i j) (Domain.dotBasis i (Domain.basis j)));
\definition leftInverse: \forall (v: Domain.Vector) -> Matrix.coordinates.apply (A.apply v) = v := Maps.ext composite Eigen.identity onBasis;
\definition isometry: \forall (v, w: Domain.Vector) -> Ambient.dot (A.apply v) (A.apply w) = Domain.dot v w :=
  \fun (v, w: Domain.Vector) => trans!{K} _ _ _ (Matrix.adjoint v (A.apply w))
    (congr!{{Domain.Vector} K} (Domain.dot v) _ _ (leftInverse w));
