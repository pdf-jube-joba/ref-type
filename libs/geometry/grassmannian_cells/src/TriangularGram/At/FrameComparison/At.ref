\import Linear.Coordinates[I := Fin.Fin k].Kronecker[] \as Delta;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition below: \forall (i: Fin.Fin k) -> Natural.Lt i j -> coefficient j i = Linear.zero :=
  \fun (i: Fin.Fin k)(less: _) => eq_reason_in!{K _
    "=" _ "by" { sym!{K} _ _ (Domain.dotBasis i (coefficient j)) }
    "=" _ "by" { sym!{K} _ _ (fIsometry (Domain.basis i) (coefficient j)) }
    "=" _ "by" { congr!{{Ambient.Vector} {Ambient.Vector} K} Ambient.dot _ _ _ _ (previous i less) (image j) }
    "=" _ "by" { gIsometry (Domain.basis i) (Domain.basis j) }
    "=" _ "by" { Domain.dotBasis i (Domain.basis j) }
    "=" _ "by" { Delta.different j i (\fun (same: _) => Natural.ltNe i j less (sym!{{Fin.Fin k}} _ _ same)) }
  };
\definition offDiagonal: \forall (i: Fin.Fin k) -> Logic.Not (i = j) -> coefficient j i = Linear.zero :=
  \fun (i: Fin.Fin k)(different: _) => \match N.Order[].Prop[].trichotomy i j \in std.Logic[].Order[].Trichotomy
    \return (\fun (_: N.Order[].Prop[].Trichotomy i j) => coefficient j i = Linear.zero) \with {
    | less before: below i before
    | equal same: Logic.falseElim _ (different same)
    | greater after: above j i after
  };
\definition coefficientVector: Domain.Vector := coefficient j;
\definition coordinateVector: coefficient j = Domain.space.smul (coefficient j j) (Domain.basis j) :=
  \axiom:funext(coefficientVector, Domain.space.smul (coefficient j j) (Domain.basis j), \fun (i: Fin.Fin k) =>
    either!{{(Classical.excludedMiddle (i = j))} {coefficient j i = Linear.mul (coefficient j j) (Domain.basis j i)}
      {\fun (same: _) => \idelim j = i \with r: Fin.Fin k => coefficient j r = Linear.mul (coefficient j j) (Domain.basis j r) \by {
        base: sym!{K} _ _ (trans!{K} _ _ _ (congr!{K K} (Linear.mul (coefficient j j)) _ _ (Delta.self j)) (Linear.mulOneRight (coefficient j j))),
        equality: sym!{{Fin.Fin k}} _ _ same
      }}
      {\fun (different: _) => trans!{K} _ _ _ (offDiagonal i different)
        (sym!{K} _ _ (trans!{K} _ _ _ (congr!{K K} (Linear.mul (coefficient j j)) _ _ (Delta.different j i
          (\fun (same: _) => different (sym!{{Fin.Fin k}} _ _ same)))) (Linear.mulZeroRight (coefficient j j))))}
    });
\definition scalarFormula: column g j = Ambient.space.smul (coefficient j j) (column f j) :=
  trans!{{Ambient.Vector}} _ _ _ (sym!{{Ambient.Vector}} _ _ (image j))
    (trans!{{Ambient.Vector}} _ _ _ (congr!{{Domain.Vector} {Ambient.Vector}} f.apply _ _ coordinateVector) (f.preservesScale (coefficient j j) (Domain.basis j)));
\module Diagonals(first: Diagonal[symbol, f, j], second: WeakDiagonal[symbol, g, j]);
\definition equal: column f j = column g j := \block {
  \takefrom first: Diagonal[symbol, f, j] \by fTriangular.diagonal j \then
  \takefrom second: WeakDiagonal[symbol, g, j] \by gTriangular.diagonal j \then
  \return Diagonals[first := first, second := second].equal
};
