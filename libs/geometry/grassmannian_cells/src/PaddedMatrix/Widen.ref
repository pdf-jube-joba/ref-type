\import \root.PaddedMatrix[K := K, zero := zero, n := n] \as PaddedMatrixParent;
\definition dimension: N.Nat^ := N.Basic[].Def[].add m n;
\import \root.PaddedMatrix[K := K, zero := zero, n := dimension] \as Target;
\definition matrix[A: Matrix]: Target.Matrix := Target.restrict (extend A);
\definition outsideSource: \forall (i, j: N.Nat^) -> Logic.Not (Target.Inside i j) -> Logic.Not (Inside i j) :=
  \fun (i, j: N.Nat^)(outside: _)(inside: Inside i j) => outside (Logic.And[_, _]::#
    (Order.ltLeTrans i n dimension inside.left (Order.leAddLeft m n))
    (Order.ltLeTrans j n dimension inside.right (Order.leAddLeft m n)));
\definition agrees: \forall (A: Matrix) -> Target.extend (matrix A) = extend A :=
  \fun (A: Matrix) => \axiom:funext(Target.extend (matrix A), extend A,
    \fun (i: N.Nat^) => \axiom:funext(Target.extend (matrix A) i, extend A i,
      \fun (j: N.Nat^) => either!{{(Classical.excludedMiddle (Target.Inside i j))} {Target.extend (matrix A) i j = extend A i j}
        {\fun (inside: Target.Inside i j) => Target.onFinite (matrix A) (Target.index i inside.left) (Target.index j inside.right)}
        {\fun (outside: _) => trans!{K} _ _ _ (Target.outside (matrix A) i j outside)
          (sym!{K} _ _ (PaddedMatrixParent.outside A i j (outsideSource i j outside)))}
      }));
