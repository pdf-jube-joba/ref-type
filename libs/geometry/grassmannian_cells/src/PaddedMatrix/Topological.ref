\import topological_algebra.Matrix[K := K, I := Fin.Fin n, J := Fin.Fin n] \as Finite;
\import topological_algebra.Matrix[K := K, I := N.Nat^, J := N.Nat^] \as Infinite;
\definition source: topology.Topology[Carrier := Matrix].Topology := Finite.topology scalar;
\definition target: topology.Topology[Carrier := InfiniteMatrix].Topology := Infinite.topology scalar;
\import topology.Continuity[A := Matrix, B := K] \as ScalarMaps;
\definition transport: \forall (f, g: Matrix -> K) -> (\forall (A: Matrix) -> f A = g A) ->
  ScalarMaps.Continuous source scalar f -> ScalarMaps.Continuous source scalar g :=
  \fun (f, g: Matrix -> K)(same: _)(continuous: _) => \idelim f = g \with h: (Matrix -> K) =>
    ScalarMaps.Continuous source scalar h \by { base: continuous, equality: \axiom:funext(f, g, same) };
\definition entryContinuous: \forall (i, j: N.Nat^) -> ScalarMaps.Continuous source scalar (\fun (A: Matrix) => extend A i j) :=
  \fun (i, j: N.Nat^) => either!{{(Classical.excludedMiddle (Inside i j))}
    {ScalarMaps.Continuous source scalar (\fun (A: Matrix) => extend A i j)}
    {\fun (inside: Inside i j) => transport (Finite.entry (index i inside.left) (index j inside.right)) (\fun (A: Matrix) => extend A i j)
      (\fun (A: Matrix) => sym!{K} _ _ (\parent.Entry[A := A, i := i, j := j].laws.inside inside.left inside.right))
      (Finite.entryContinuous scalar (index i inside.left) (index j inside.right))}
    {\fun (outside: Logic.Not (Inside i j)) => transport (\fun (_: Matrix) => zero) (\fun (A: Matrix) => extend A i j)
      (\fun (A: Matrix) => sym!{K} _ _ (\parent.Entry[A := A, i := i, j := j].laws.outside outside))
      (topology.Maps[A := Matrix, B := K].constantContinuous source scalar zero)}
  };
\definition continuous: topology.Continuity[A := Matrix, B := InfiniteMatrix].Continuous source target extend :=
  Infinite.Universal[A := Matrix].continuous source scalar extend entryContinuous;
\definition restrictContinuous: topology.Continuity[A := InfiniteMatrix, B := Matrix].Continuous target source restrict :=
  Finite.Universal[A := InfiniteMatrix].continuous target scalar restrict
    (\fun (i, j: Fin.Fin n) => Infinite.entryContinuous scalar i j);
