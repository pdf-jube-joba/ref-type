\import real.Analysis[] \as Numbers;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import hermitian_frames.Hermitian[] \as H;
\import H.Over[K := Numbers.Real, field := Numbers.Algebra[].field, scalar := H.Real[].scalar, topological := H.Real[].topological].At[n := n] \as Ambient;
\import linear_algebra.Hermitian[].Over[K := Numbers.Real, field := Numbers.Algebra[].field, scalar := H.Real[].scalar].Finite[n := k] \as Domain;
\import grassmannians.Real[n := n, k := k].Model[] \as Grassmannian;
\import \root.Symbols[n := n, k := k] \as Symbols;
\import \root.Reduction[K := Numbers.Real, field := Numbers.Algebra[].field, scalar := H.Real[].scalar, n := n].At[k := k] \as Reduction;
\import \root.Reduction[K := Numbers.Real, field := Numbers.Algebra[].field, scalar := H.Real[].scalar, n := n] \as Reductions;
\structure Representation[p: Grassmannian.Carrier]: \Set := {
  symbol: Symbols.Symbol,
  matrix: \root.Echelon[K := Numbers.Real, field := Numbers.Algebra[].field, n := n, k := k, symbol := symbol].Carrier,
  agrees: \root.Real[n := n, k := k, symbol := symbol].Canonical[].map matrix = p,
};
\module At(p: Grassmannian.Carrier);
\definition exists: \forall (p: Grassmannian.Carrier) -> \exists Representation[p] :=
  \fun (p: Grassmannian.Carrier) => At[p := p].exists;
\definition cell[symbol: Symbols.Symbol]: \Pow Grassmannian.Carrier := \root.Real[n := n, k := k, symbol := symbol].Canonical[].cell;
\definition covers: \forall (p: Grassmannian.Carrier) -> \exists (symbol: Symbols.Symbol \where \In[Grassmannian.Carrier] (cell symbol) p) := \block {
  \fun (p: Grassmannian.Carrier) \then
  \takefrom form: Representation[p] \by exists p \then
  \return Logic.existsIntro[Symbols.Symbol, { symbol: Symbols.Symbol \where \In[Grassmannian.Carrier] (cell symbol) p }] form.symbol
    (Logic.existsIntro[\root.Echelon[K := Numbers.Real, field := Numbers.Algebra[].field, n := n, k := k, symbol := form.symbol].Carrier,
      { A: \root.Echelon[K := Numbers.Real, field := Numbers.Algebra[].field, n := n, k := k, symbol := form.symbol].Carrier \where
        \root.Real[n := n, k := k, symbol := form.symbol].Canonical[].map A = p }] form.matrix form.agrees)
};
\definition disjoint: \forall (s, t: Symbols.Symbol)(p: Grassmannian.Carrier) ->
  \In[Grassmannian.Carrier] (cell s) p -> \In[Grassmannian.Carrier] (cell t) p -> s = t :=
  \fun (s, t: Symbols.Symbol) => \root.Real[n := n, k := k, symbol := s].Canonical[].Comparison[other := t].commonPoint;
