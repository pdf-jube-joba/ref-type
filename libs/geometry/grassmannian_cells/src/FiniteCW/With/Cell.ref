\import Euclidean.Dimension[n := cell.dimension] \as Model;
\import topology.Topology[Carrier := Model.Disk] \as Disk;
\import topology.Maps[A := Model.Disk, B := A] \as Images;
\definition closed: Space.IsClosedIn space (Bad cell U) := Space.Compactness[].compactClosed space data.hausdorff (Bad cell U)
  (topology.Compactness[A := Model.Disk, B := A].continuousImage Model.diskTopology space cell.characteristic laws.continuous
    (Disk.Complement (CW.Pullback cell U))
    (Disk.Compactness[].closedCompact Model.diskTopology Model.Compactness[].compact (Disk.Complement (CW.Pullback cell U))
      (Disk.Finite[].openComplementClosed Model.diskTopology (CW.Pullback cell U) open)));
