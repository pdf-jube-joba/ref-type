\import Elimination.At[A := A, pivot := maximum.index, column := column, nonzero := nonzero] \as Normal;
\import Elimination.Above[A := A, maximum := maximum] \as Support;
\module Using(lower: LowerRank.Presentation Normal.lower);
\definition exists: Existence k -> UpperRank.Injective A -> \exists UpperRank.Presentation A := \block {
  \fun (previous: Existence k)(injective: UpperRank.Injective A) \then
  \takefrom lower: LowerRank.Presentation Normal.lower \by previous Normal.lower (Normal.lowerInjective injective) \then
  \return \exact(Using[lower := lower].presentation, UpperRank.Presentation A)
};
