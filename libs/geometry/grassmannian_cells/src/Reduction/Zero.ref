\import \parent.At[k := N.Nat^::zero] \as Rank;
\import Geometry.Finite[n := N.Nat^::zero] \as Domain;
\definition data[A: Rank.Map]: Rank.Data := Rank.Data {
  pivot := Fin.Empty[A := Fin.Fin n].function,
  value := A,
};
\definition laws: \forall (A: Rank.Map) -> Rank.Laws[data A] :=
  \fun (A: Rank.Map) => Rank.Laws[data A] {
    coordinates := \fun (v: Domain.Vector) => Fin.Empty[A := K].unique (Rank.sample (data A) (A.apply v)) v,
    above := \fun (i: Fin.Fin n)(j: Fin.Fin N.Nat^::zero)(bound: _) => Logic.falseElim _ (Fin.zeroImpossible j (Fin.bound N.Nat^::zero j)),
  };
\definition frame[A: Rank.Map]: Rank.Carrier := \into[Rank.Data](data A, Rank.Carrier) \by { laws A };
\definition presentation[A: Rank.Map]: Rank.Presentation A := \into[Rank.Carrier](frame A, Rank.Presentation A) \by {
  Rank.ImageLaws[A, frame A] {
    forward := \fun (v: Domain.Vector) => Logic.existsIntro[Domain.Vector, { w: Domain.Vector \where A.apply w = A.apply v }] v (\refl(A.apply v)),
    backward := \fun (v: Domain.Vector) => Logic.existsIntro[Domain.Vector, { w: Domain.Vector \where A.apply w = A.apply v }] v (\refl(A.apply v)),
  }
};
