\import Geometry.Finite[n := k] \as Domain;
\import Linear.Linear[V := Domain.Vector, W := Ambient.Vector, source := Domain.space, target := Ambient.space] \as Maps;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\import Linear.Coordinates[I := Fin.Fin k].Kronecker[] \as Delta;
\definition Map: \Set := Maps.Map;
\definition Injective[A: Maps.Map]: \Prop := \forall (v, w: Domain.Vector) -> A.apply v = A.apply w -> v = w;
\structure Data: \Set := {
  pivot: Fin.Fin k -> Fin.Fin n,
  value: Maps.Map,
};
\definition sample[d: Data][v: Ambient.Vector][i: Fin.Fin k]: K := v (d.pivot i);
\structure Laws[d: Data]: \Prop := {
  coordinates: \forall (v: Domain.Vector) -> sample d (d.value.apply v) = v,
  above: \forall (i: Fin.Fin n)(j: Fin.Fin k) -> Order.Lt (d.pivot j) i -> d.value.apply (Domain.basis j) i = Linear.zero,
};
\definition Carrier: \Set := \Cast[Data] ({ d: Data \where Laws[d] });
\definition laws[d: Carrier]: Laws[d] := \bysub(Data, Carrier, d);
\definition injective: \forall (d: Carrier) -> Injective d.value :=
  \fun (d: Carrier)(v, w: Domain.Vector)(same: _) => trans!{{Domain.Vector}} _ _ _
    (sym!{{Domain.Vector}} _ _ ((laws d).coordinates v))
    (trans!{{Domain.Vector}} _ _ _ (congr!{{Ambient.Vector} {Domain.Vector}} (sample d) _ _ same) ((laws d).coordinates w));
\definition pivotInjective: \forall (d: Carrier)(i, j: Fin.Fin k) -> d.pivot i = d.pivot j -> i = j :=
  \fun (d: Carrier)(i, j: Fin.Fin k)(same: _) => either!{{(Classical.excludedMiddle (i = j))} {i = j}
    {\fun (equal: _) => equal}
    {\fun (different: Logic.Not (i = j)) => Logic.falseElim (i = j) (field.nontrivial
      (trans!{K} _ _ _ (sym!{K} _ _ (Delta.different i j different))
        (trans!{K} _ _ _
          (sym!{K} _ _ (congr!{{Domain.Vector} K} (\fun (v: Domain.Vector) => v j) _ _ ((laws d).coordinates (Domain.basis i))))
          (trans!{K} _ _ _
            (congr!{{Fin.Fin n} K} (d.value.apply (Domain.basis i)) _ _ (sym!{{Fin.Fin n}} _ _ same))
            (trans!{K} _ _ _ (congr!{{Domain.Vector} K} (\fun (v: Domain.Vector) => v i) _ _ ((laws d).coordinates (Domain.basis i))) (Delta.self i))))))}
  };
\structure ImageLaws[A: Maps.Map, d: Carrier]: \Prop := {
  forward: \forall (v: Domain.Vector) -> \exists (w: Domain.Vector \where A.apply w = d.value.apply v),
  backward: \forall (v: Domain.Vector) -> \exists (w: Domain.Vector \where d.value.apply w = A.apply v),
};
\definition Presentation[A: Maps.Map]: \Set := \Cast[Carrier] ({ d: Carrier \where ImageLaws[A, d] });
\definition image[A: Maps.Map][d: Presentation A]: ImageLaws[A, d] := \bysub(Carrier, Presentation A, d);
\import \root.Symbols[n := n, k := k] \as Symbols;
\structure NormalForm[A: Maps.Map]: \Set := {
  symbol: Symbols.Symbol,
  matrix: \root.Echelon[K := K, field := field, n := n, k := k, symbol := symbol].Carrier,
  forward: \forall (v: Domain.Vector) -> \exists (w: Domain.Vector \where A.apply w =
    (\root.Echelon[K := K, field := field, n := n, k := k, symbol := symbol].linear matrix).apply v),
  backward: \forall (v: Domain.Vector) -> \exists (w: Domain.Vector \where
    (\root.Echelon[K := K, field := field, n := n, k := k, symbol := symbol].linear matrix).apply w = A.apply v),
};
\module Sorted(A: Maps.Map, d: Presentation A, permutation: Fin.Ordering[].Ordered k n d.pivot);
