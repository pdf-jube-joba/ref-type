\import metric_spaces.RealFunctions[A := X] \as Reals;
\definition continuous: \forall (indices: Lists.List[I])(f: I -> X -> R.Real) ->
  (\forall (i: I) -> Reals.Continuous source (f i)) -> Reals.Continuous source (\fun (x: X) => maximum indices (\fun (i: I) => f i x)) :=
  \induction (indices: Lists.List[I]) \return \forall (f: I -> X -> R.Real) ->
    (\forall (i: I) -> Reals.Continuous source (f i)) -> Reals.Continuous source (\fun (x: X) => maximum indices (\fun (i: I) => f i x)) \with {
    | nil: \fun (f: _)(regular: _) => Reals.constantContinuous source R.zero
    | cons: \fun (head: I)(tail: Lists.List[I])
      (previous: \forall (f: I -> X -> R.Real) -> (\forall (i: I) -> Reals.Continuous source (f i)) ->
        Reals.Continuous source (\fun (x: X) => maximum tail (\fun (i: I) => f i x)))
      (f: I -> X -> R.Real)(regular: \forall (i: I) -> Reals.Continuous source (f i)) =>
        Reals.Lattice[].maximumContinuous source (f head) (\fun (x: X) => maximum tail (\fun (i: I) => f i x)) (regular head) (previous f regular)
  };
