\import algebraic_topology.Euclidean[].Dimension[n := N.Nat^::succ d] \as Sphere;
\import algebraic_topology.Interval[] \as Interval;
\import algebraic_topology.Cylinder[A := Sphere.Sphere] \as Cylinder;
\import \parent.Maps[Y := Sphere.Sphere, source := Sphere.sphereTopology] \as SphereMaps;
\import \parent.Maps[Y := Cylinder.Carrier, source := Cylinder.topology Sphere.sphereTopology] \as CylinderMaps;
\definition sphereMap: \forall (f: Sphere.Sphere -> Carrier) ->
  topology.Continuity[A := Sphere.Sphere, B := Carrier].Continuous Sphere.sphereTopology topology f -> \exists SphereMaps.Factorization[f] :=
  \fun (f: Sphere.Sphere -> Carrier)(continuous: _) => SphereMaps.exists f continuous Sphere.Compactness[].sphere;
\definition cylinderCompact: topology.Topology[Carrier := Cylinder.Carrier].IsCompact (Cylinder.topology Sphere.sphereTopology) :=
  topological_constructions.Product[A := Interval.Carrier, B := Sphere.Sphere].Compactness[].productCompact
    Interval.topology Sphere.sphereTopology Interval.compact Sphere.Compactness[].sphere;
\definition sphereFamily: \forall (h: Cylinder.Carrier -> Carrier) ->
  topology.Continuity[A := Cylinder.Carrier, B := Carrier].Continuous (Cylinder.topology Sphere.sphereTopology) topology h ->
  \exists CylinderMaps.Factorization[h] :=
  \fun (h: Cylinder.Carrier -> Carrier)(continuous: _) => CylinderMaps.exists h continuous cylinderCompact;
\import algebraic_topology.Homotopy[A := Sphere.Sphere, B := Carrier] \as Homotopies;
\definition sphereHomotopy: \forall (f, g: Sphere.Sphere -> Carrier)(h: Homotopies.Homotopy[Sphere.sphereTopology, topology, f, g]) ->
  \exists CylinderMaps.Factorization[h] :=
  \fun (f, g: Sphere.Sphere -> Carrier)(h: Homotopies.Homotopy[Sphere.sphereTopology, topology, f, g]) =>
    sphereFamily h (Homotopies.laws Sphere.sphereTopology topology f g h).continuous;
