\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Order;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\module At(n: N.Nat^, P: Fin.Fin n -> \Prop);
\definition Maximum[n: N.Nat^, P: Fin.Fin n -> \Prop]: \Set := At[n := n, P := P].Maximum;
\definition Existence[n: N.Nat^]: \Prop := \forall (P: Fin.Fin n -> \Prop) ->
  (\exists (i: Fin.Fin n \where P i)) -> \exists Maximum[n, P];
\definition zero: Existence N.Nat^::zero := \block {
  \fun (P: Fin.Fin N.Nat^::zero -> \Prop)(inhabited: _) \then
  \takefrom i: \Cast[Fin.Fin N.Nat^::zero] ({ i: Fin.Fin N.Nat^::zero \where P i }) \by inhabited \then
  \return Logic.falseElim (\exists Maximum[N.Nat^::zero, P]) (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i))
};
\module Step(n: N.Nat^, P: Fin.Fin (N.Nat^::succ n) -> \Prop);
\definition exists: \forall (n: N.Nat^) -> Existence n :=
  \induction (n: N.Nat^) \return Existence n \with {
    | zero: zero
    | succ: \fun (n: N.Nat^)(previous: Existence n)(P: Fin.Fin (N.Nat^::succ n) -> \Prop) =>
        Step[n := n, P := P].exists previous
  };
