\import std.Logic[].Classical[] \as Classical;
\definition open: Space.IsOpenIn topology (Space.Singleton a) := \block {
  \takefrom U: \Cast[\Pow Carrier] ({ U: \Pow Carrier \where Space.RegularChoice[topology, Space.Singleton (opposite a), a, U] }) \by hausdorff a (opposite a) (oppositeDifferent a) \then
  \let first: Space.RegularChoice[topology, Space.Singleton (opposite a), a, U] := \bysub(\Pow Carrier, { U: \Pow Carrier \where Space.RegularChoice[topology, Space.Singleton (opposite a), a, U] }, U) \then
  \takefrom V: \Cast[\Pow Carrier] ({ V: \Pow Carrier \where Space.NormalPartner[topology, Space.Singleton (opposite a), U, V] }) \by first.partner \then
  \let second: Space.NormalPartner[topology, Space.Singleton (opposite a), U, V] := \bysub(\Pow Carrier, { V: \Pow Carrier \where Space.NormalPartner[topology, Space.Singleton (opposite a), U, V] }, V) \then
  \let same: U = Space.Singleton a := \axiom:setext(U, Space.Singleton a,
    (\fun (b: Carrier)(member: _) => either!{{(Classical.excludedMiddle (b = a))} {b = a}
      {\fun (equal: _) => equal}
      {\fun (different: _) => Logic.falseElim (b = a) (second.disjoint b member (second.covers b
        (two a b (\fun (equal: a = b) => different (sym!{Carrier} _ _ equal)))))}}),
    (\fun (b: Carrier)(equal: b = a) => \idelim a = b \with c: Carrier => Space.Member U c \by { base: first.contains, equality: sym!{Carrier} _ _ equal })) \then
  \return \idelim U = Space.Singleton a \with W: \Pow Carrier => Space.IsOpenIn topology W \by { base: first.open, equality: same }
};
