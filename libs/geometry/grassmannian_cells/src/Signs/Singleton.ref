\import std.Logic[].Classical[] \as Classical;
\definition complement: Space.Complement (Space.Singleton (opposite a)) = Space.Singleton a :=
  \axiom:setext(Space.Complement (Space.Singleton (opposite a)), Space.Singleton a,
    (\fun (b: Carrier)(outside: Logic.Not (b = opposite a)) =>
      either!{{(Classical.excludedMiddle (b = a))} {b = a}
        {\fun (equal: b = a) => equal}
        {\fun (different: Logic.Not (b = a)) => Logic.falseElim (b = a)
          (outside (two a b (\fun (equal: a = b) => different (sym!{Carrier} _ _ equal))))}
      }),
    (\fun (b: Carrier)(equal: b = a)(equalOpposite: b = opposite a) =>
      oppositeDifferent a (trans!{Carrier} a b (opposite a) (sym!{Carrier} _ _ equal) equalOpposite)));
\definition open: Space.IsOpenIn topology (Space.Singleton a) :=
  \idelim Space.Complement (Space.Singleton (opposite a)) = Space.Singleton a
    \with U: \Pow Carrier => Space.IsOpenIn topology U \by {
      base: Space.Compactness[].hausdorffT1 topology hausdorff (opposite a),
      equality: complement
    };
