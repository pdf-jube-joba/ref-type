\import \root.Signs[] \as SignsParent;
\import topology.Topology[Carrier := X] \as Source;
\import metric_spaces.RealFunctions[A := X] \as RealFunctions;
\definition Continuous[source: Source.Topology][f: X -> Carrier]: \Prop := topology.Continuity[A := X, B := Carrier].Continuous source topology f;
\definition into: \forall (source: Source.Topology)(f: X -> Carrier) -> RealFunctions.Continuous source (\fun (x: X) => f x) -> Continuous source f :=
  \fun (source: Source.Topology)(f: X -> Carrier) => topology.Continuity[A := X, B := R.Real].Corestriction[S := predicate].corestrictContinuous source metric_spaces.RealLine[].topology f;
\definition real: \forall (source: Source.Topology)(f: X -> Carrier) -> Continuous source f -> RealFunctions.Continuous source (\fun (x: X) => f x) :=
  \fun (source: Source.Topology)(f: X -> Carrier)(regular: _) => topology.Composition[A := X, B := Carrier, C := R.Real].composeContinuous source topology metric_spaces.RealLine[].topology f
    (\fun (s: Carrier) => s) regular (topology.Continuity[A := X, B := R.Real].Corestriction[S := predicate].inclusionContinuous metric_spaces.RealLine[].topology);
\definition constant: \forall (source: Source.Topology)(s: Carrier) -> Continuous source (\fun (_: X) => s) :=
  \fun (source: Source.Topology)(s: Carrier) => topology.Maps[A := X, B := Carrier].constantContinuous source topology s;
\definition product: \forall (source: Source.Topology)(f, g: X -> Carrier) -> Continuous source f -> Continuous source g -> Continuous source (\fun (x: X) => SignsParent.product (f x) (g x)) :=
  \fun (source: Source.Topology)(f, g: X -> Carrier)(fc: _)(gc: _) => into source _
    (RealFunctions.Product[].continuous source (\fun (x: X) => f x) (\fun (x: X) => g x) (real source f fc) (real source g gc));
