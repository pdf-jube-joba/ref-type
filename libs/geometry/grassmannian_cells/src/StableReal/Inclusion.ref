\definition extra: N.Nat^ := Nat.sub m n;
\definition dimension: N.Nat^ := Nat.add extra n;
\definition dimensionEqual: dimension = m := trans!{N.Nat^} _ _ _ (Order.addComm extra n) (Order.addSubOfLe n m bound);
\import \root.AmbientReal[n := n, k := k, m := extra] \as Ambient;
\import Equality.Transport[A := N.Nat^] \as Transport;
\definition map[p: Finite n]: Finite m := Transport.cast Finite dimension m dimensionEqual (Ambient.map p);
\definition agrees: \forall (p: Finite n) -> padding m (map p) = padding n p :=
  \fun (p: Finite n) => trans!{Matrix} _ _ _
    (sym!{Matrix} _ _ (Transport.natural Finite (\fun (_: N.Nat^) => Matrix) padding dimension m dimensionEqual (Ambient.map p)))
    (trans!{Matrix} _ _ _ (Transport.Constant[C := Matrix].law dimension m (padding dimension (Ambient.map p)) dimensionEqual)
      (Ambient.Entries[].paddingCompatible p));
