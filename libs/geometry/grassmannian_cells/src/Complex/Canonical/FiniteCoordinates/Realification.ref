\import \root.ComplexCoordinates[n := data.dimension] \as Reals;
\definition value: RealData := RealData {
  complexDimension := data.dimension,
  dimensionFormula := data.dimensionFormula,
  homeomorphism := topology.Homeomorphism[
    A := EuclideanSpace.coordinateCarrier (N.Basic[].Def[].add data.dimension data.dimension),
    B := Coordinates data.dimension].Composition[C := Cell].compose
      EuclideanSpace.Dimension[n := N.Basic[].Def[].add data.dimension data.dimension].topology
      (topology data.dimension) cellTopology Reals.homeomorphism data.homeomorphism,
};
