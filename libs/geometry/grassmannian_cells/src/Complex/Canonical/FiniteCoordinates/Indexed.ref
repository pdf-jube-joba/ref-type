\import \root.CoordinateIndex[K := Numbers.Complex, I := Fin.Fin index.size, J := Symbols.Free symbol,
  scalar := H.Complex[].topological.space, index := index.value] \as Reindex;
\definition exists: \exists Data := \block {
  \takefrom chart: topology.Homeomorphism[A := Free.Coordinates, B := Cell].Homeomorphism[ParameterSpace.topology, cellTopology]
    \by Pivot[].homeomorphismExists \then
  \return \exact(Data {
    dimension := index.size,
    homeomorphism := topology.Homeomorphism[A := Coordinates index.size, B := Free.Coordinates].Composition[C := Cell].compose
      (topology index.size) ParameterSpace.topology cellTopology Reindex.homeomorphism chart,
  }, Data)
};
