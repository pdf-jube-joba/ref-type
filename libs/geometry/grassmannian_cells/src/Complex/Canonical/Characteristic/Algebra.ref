\import linear_algebra.Commutative[K := Numbers.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Numbers.Complex Numbers.Algebra[].field].Coordinates[I := Fin.Fin n].Kronecker[] \as PivotDelta;
\import Geometry.Finite[n := k] \as Domain;
\import Ambient.Unitary[] \as Unitary;
\import Action.Rank[k := k, u := Rotations.unitary parameter, basis := \parent.\parent.Pivot[].basis] \as Rank;
\definition columns: Triangular.At[k := k].Map := Rank.value.value;
\definition onBasis: \forall (j: Fin.Fin k) -> columns.apply (Domain.basis j) = frame parameter j :=
  \fun (j: Fin.Fin k) => congr!{{Ambient.Vector} {Ambient.Vector}} (Rotations.unitary parameter).forward.apply _ _ (\parent.\parent.Pivot[].onBasis j);
\import \parent.\parent.Pivot[] \as Pivot;
\import linear_algebra.Commutative[K := Numbers.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Numbers.Complex Numbers.Algebra[].field].Coordinates[I := Fin.Fin k].Kronecker[] \as SmallDelta;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition pivotOrthonormal: \forall (i, j: Fin.Fin k) -> Euclidean.dot (Pivot.basis.value.apply (Domain.basis i)) (Pivot.basis.value.apply (Domain.basis j)) = Domain.dot (Domain.basis i) (Domain.basis j) :=
  \fun (i, j: Fin.Fin k) => trans!{Numbers.Complex} _ _ _
    (congr!{{Ambient.Vector} {Ambient.Vector} Numbers.Complex} Euclidean.dot _ _ _ _ (Pivot.onBasis i) (Pivot.onBasis j))
    (trans!{Numbers.Complex} _ _ _ (Euclidean.dotBasis (symbol.pivot i) (Euclidean.basis (symbol.pivot j)))
      (trans!{Numbers.Complex} _ _ _
        (either!{{(Classical.excludedMiddle (j = i))} {PivotDelta.delta (symbol.pivot j) (symbol.pivot i) = SmallDelta.delta j i}
          {\fun (same: _) => trans!{Numbers.Complex} _ _ _ (PivotDelta.equal _ _ (congr!{{Fin.Fin k} {Fin.Fin n}} symbol.pivot _ _ same)) (sym!{Numbers.Complex} _ _ (SmallDelta.equal j i same))}
          {\fun (different: _) => trans!{Numbers.Complex} _ _ _ (PivotDelta.different _ _ (\fun (same: _) => different (Symbols.injective symbol j i same))) (sym!{Numbers.Complex} _ _ (SmallDelta.different j i different))}
        }) (sym!{Numbers.Complex} _ _ (Domain.dotBasis i (Domain.basis j)))));
\definition pivotIsometry: \forall (v, w: Domain.Vector) -> Euclidean.dot (Pivot.basis.value.apply v) (Pivot.basis.value.apply w) = Domain.dot v w :=
  Triangular.At[k := k].Columns[A := Pivot.basis.value, orthonormal := pivotOrthonormal].isometry;
\definition isometry: \forall (v, w: Domain.Vector) -> Euclidean.dot (columns.apply v) (columns.apply w) = Domain.dot v w :=
  \fun (v, w: Domain.Vector) => trans!{Numbers.Complex} _ _ _ (Unitary.isometry (Rotations.unitary parameter) (Pivot.basis.value.apply v) (Pivot.basis.value.apply w)) (pivotIsometry v w);
\definition fixed: \forall (v: Domain.Vector) -> (map parameter).map.apply (columns.apply v) = columns.apply v :=
  \fun (v: Domain.Vector) => trans!{{Ambient.Vector}} _ _ _ (sym!{{Ambient.Vector}} _ _ (Rank.value.reconstruction (columns.apply v)))
    (congr!{{Domain.Vector} {Ambient.Vector}} columns.apply _ _ (Rank.value.leftInverse v));


\definition weakTriangular: Triangular.At[k := k].WeakLaws[symbol, columns] := Triangular.At[k := k].WeakLaws[symbol, columns] {
  above := \fun (j: Fin.Fin k)(r: Fin.Fin n)(above: _) => trans!{Numbers.Complex} _ _ _
    (congr!{{Ambient.Vector} Numbers.Complex} (\fun (v: Ambient.Vector) => v r) _ _ (onBasis j)) (Rotations.above parameter j r above),
  diagonal := \fun (j: Fin.Fin k) => \exact(Triangular.At[k := k].WeakDiagonal[symbol, columns, j] {
    value := Rotations.Column[j := j].radius parameter,
    nonnegative := Rotations.Column[j := j].radiusNonnegative parameter,
    agrees := trans!{Numbers.Complex} _ _ _ (congr!{{Ambient.Vector} Numbers.Complex} (\fun (v: Ambient.Vector) => v (symbol.pivot j)) _ _ (onBasis j)) (Rotations.diagonal parameter j),
  }, Triangular.At[k := k].WeakDiagonal[symbol, columns, j]),
};
\module Interior(inside: Rotations.Interior parameter);

\definition basis: Ambient.OnProjection[P := Grassmannian.projection (map parameter)].Rank[k := k].Basis := Rank.value;
