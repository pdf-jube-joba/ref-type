\import Triangular.At[k := k].FlagComparison[symbol := symbol, A := Algebra.columns,
  injective := Ambient.OnProjection[P := Grassmannian.projection (map parameter)].Rank[k := k].injective Algebra.basis,
  above := Algebra.weakTriangular.above, other := form.symbol, B := form.matrix, contained := form.backward] \as Flags;
\import \root.Complex[n := n, k := k, symbol := form.symbol].Canonical[] \as Other;
\import \root.Echelon[K := Numbers.Complex, field := Numbers.Algebra[].field, n := n, k := k, symbol := form.symbol] \as Echelon;
\import \root.DecompositionComplex[n := n, k := k].At[p := map parameter].Using[basis := Algebra.basis, form := form] \as Image;
\definition contains: \In[Grassmannian.Carrier] Other.cell (map parameter) :=
  Logic.existsIntro[Echelon.Carrier, { B: Echelon.Carrier \where Other.map B = map parameter }] form.matrix Image.agrees;
\definition different: Rotations.Boundary parameter -> Logic.Not (form.symbol = symbol) :=
  \fun (boundary: _)(same: _) => boundaryAvoids parameter boundary
    (\idelim form.symbol = symbol \with s: Symbols.Symbol => \In[Grassmannian.Carrier] (\root.Complex[n := n, k := k, symbol := s].Canonical[].cell) (map parameter) \by {
      base: contains, equality: same
    });
\definition boundaryImage[boundary: Rotations.Boundary parameter]: BoundaryImage[map parameter] := BoundaryImage[map parameter] {
  symbol := form.symbol,
  lower := Symbols.Dimensions[s := form.symbol, t := symbol].complexStrict Flags.below (different boundary),
  contains := contains,
};
