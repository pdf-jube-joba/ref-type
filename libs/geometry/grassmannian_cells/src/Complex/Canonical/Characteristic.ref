\import \root.Complex[n := n, k := k, symbol := symbol].Canonical[] \as CanonicalParent;
\import \root.Rotations[K := Numbers.Complex, field := Numbers.Algebra[].field,
  scalar := H.Complex[].scalar, topological := H.Complex[].topological, n := n, k := k, symbol := symbol] \as Rotations;
\import \root.Reflection[K := Numbers.Complex, field := Numbers.Algebra[].field,
  scalar := H.Complex[].scalar, topological := H.Complex[].topological, n := n].Conjugation[P := Grassmannian.projection \parent.Pivot[].base] \as Action;
\import Action.Family[X := Rotations.Carrier, source := Rotations.topology, u := Rotations.unitary, continuous := Rotations.continuous] \as Family;
\definition projection[A: Rotations.Carrier]: Ambient.Projection := Action.projection (Rotations.unitary A);
\definition rank: \forall (A: Rotations.Carrier) -> Ambient.OnProjection[P := projection A].Rank[k := k].HasRank :=
  \fun (A: Rotations.Carrier) => Action.rank k (Rotations.unitary A) (Grassmannian.rank \parent.Pivot[].base);
\import Grassmannian.Family[Y := Rotations.Carrier, source := Rotations.topology, P := projection,
  regularP := Family.regular, rankP := rank] \as Projected;
\definition map: Rotations.Carrier -> Grassmannian.Carrier := Projected.map;
\definition continuous: topology.Continuity[A := Rotations.Carrier, B := Grassmannian.Carrier].Continuous
  Rotations.topology Grassmannian.topology map := Projected.continuous;
\definition frame[A: Rotations.Carrier][j: Fin.Fin k]: Ambient.Vector :=
  (Rotations.unitary A).forward.apply (Euclidean.basis (symbol.pivot j));
\definition fixesFrame: \forall (A: Rotations.Carrier)(j: Fin.Fin k) -> (map A).map.apply (frame A j) = frame A j :=
  \fun (A: Rotations.Carrier)(j: Fin.Fin k) => (Action.fixedImage (Rotations.unitary A) (frame A j)).rtl
    (\idelim Euclidean.basis (symbol.pivot j) = (Rotations.unitary A).backward.apply (frame A j)
      \with v: Euclidean.Vector => \parent.Pivot[].base.map.apply v = v \by {
        base: \parent.Pivot[].fixesBasis j,
        equality: sym!{{Euclidean.Vector}} _ _ ((Rotations.unitary A).leftInverse (Euclidean.basis (symbol.pivot j)))
      });

\import \root.Symbols[n := n, k := k] \as Symbols;
\import algebraic_topology.Euclidean[].Dimension[n := Symbols.complexDimension symbol] \as Standard;
\structure DiskData: \Set := {
  homeomorphism: topology.Homeomorphism[A := Standard.Disk, B := Rotations.Carrier].Homeomorphism[Standard.diskTopology, Rotations.topology],
  forwardBoundary: \forall (x: Standard.Disk) -> Standard.normSquared x = real.Analysis[].one -> Rotations.Boundary (homeomorphism.forward x),
  backwardBoundary: \forall (A: Rotations.Carrier) -> Rotations.Boundary A -> Standard.normSquared (homeomorphism.backward A) = real.Analysis[].one,
  interiorForward: \forall (x: Standard.Disk) -> dedekind_reals.DedekindReal[].Lt (Standard.normSquared x) real.Analysis[].one -> Rotations.Interior (homeomorphism.forward x),
  interiorBackward: \forall (A: Rotations.Carrier) -> Rotations.Interior A -> dedekind_reals.DedekindReal[].Lt (Standard.normSquared (homeomorphism.backward A)) real.Analysis[].one,
};
\module Disk(index: Symbols.FreeCount[symbol := symbol].Bijection);
\definition diskExists: \exists DiskData := \block {
  \takefrom index: Symbols.FreeCount[symbol := symbol].Bijection \by Symbols.FreeCount[symbol := symbol].exists \then
  \return \exact(Disk[index := index].value, DiskData)
};


\import \root.TriangularGram[K := Numbers.Complex, field := Numbers.Algebra[].field, scalar := H.Complex[].scalar, n := n] \as Triangular;
\definition triangularLaws: \forall (A: Coordinates.Carrier) -> Triangular.At[k := k].Laws[symbol, Coordinates.linear A] :=
  \fun (A: Coordinates.Carrier) => Triangular.At[k := k].Laws[symbol, Coordinates.linear A] {
    above := \fun (j: Fin.Fin k)(r: Fin.Fin n)(above: _) => trans!{Numbers.Complex} _ _ _ (Coordinates.onBasis A j r) ((Coordinates.laws A).above r j above),
    diagonal := \fun (j: Fin.Fin k) => \exact(Triangular.At[k := k].Diagonal[symbol, Coordinates.linear A, j] {
      value := real.Analysis[].one, positive := real.Analysis[].Estimates[].Product[].onePositive,
      agrees := trans!{Numbers.Complex} _ _ _ (Coordinates.onBasis A j (symbol.pivot j))
        (trans!{Numbers.Complex} _ _ _ ((Coordinates.laws A).pivot j j)
          (trans!{Numbers.Complex} _ _ _ (linear_algebra.Commutative[K := Numbers.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Numbers.Complex Numbers.Algebra[].field].Coordinates[I := Fin.Fin k].Kronecker[].self j) (sym!{Numbers.Complex} _ _ H.Complex[].scalar.embedOne))),
    }, Triangular.At[k := k].Diagonal[symbol, Coordinates.linear A, j]),
  };
\definition triangularFrameExists: \forall (A: Coordinates.Carrier) -> \exists Triangular.At[k := k].Factorization[symbol, Coordinates.linear A] :=
  \fun (A: Coordinates.Carrier) => Triangular.exists k symbol (Coordinates.linear A) (Coordinates.injective A) (triangularLaws A);
\module Frame(A: Coordinates.Carrier, factor: Triangular.At[k := k].Factorization[symbol, Coordinates.linear A]);

\structure InteriorPreimage[p: Cell]: \Set := {
  parameter: Rotations.Carrier,
  inside: Rotations.Interior parameter,
  image: map parameter = p,
};
\definition interiorSurjective: \forall (p: Cell) -> \exists InteriorPreimage[p] := \block {
  \fun (p: Cell) \then
  \takefrom A: \Cast[Coordinates.Carrier] ({ A: Coordinates.Carrier \where CanonicalParent.into A = p }) \by CanonicalParent.onto p \then
  \takefrom factor: Triangular.At[k := k].Factorization[symbol, Coordinates.linear A] \by triangularFrameExists A \then
  \takefrom presentation: Rotations.FromFrame[].Presentation[Fin.elements k, (\fun (j: Fin.Fin k) => Frame[A := A, factor := factor].frame j)]
    \by Frame[A := A, factor := factor].presentationExists \then
  \return \exact(InteriorPreimage[p] {
    parameter := presentation.parameter, inside := presentation.interior,
    image := trans!{{Grassmannian.Carrier}} _ _ _ (Frame[A := A, factor := factor].Using[presentation := presentation].mapEquality)
      (\bysub(Coordinates.Carrier, { A: Coordinates.Carrier \where CanonicalParent.into A = p }, A)),
  }, InteriorPreimage[p])
};

\module Algebra(parameter: Rotations.Carrier);
\module Compare(first, second: Rotations.Carrier, firstInside: Rotations.Interior first,
  same: map first = map second);
\definition injectiveInterior: \forall (first, second: Rotations.Carrier) -> Rotations.Interior first -> Rotations.Interior second -> map first = map second -> first = second :=
  \fun (first, second: Rotations.Carrier)(firstInside: _)(secondInside: _)(same: _) => Compare[first := first, second := second,
    firstInside := firstInside, same := same].equal;

\definition interiorCell: \forall (parameter: Rotations.Carrier) -> Rotations.Interior parameter -> \In[Grassmannian.Carrier] cell (map parameter) :=
  \fun (parameter: Rotations.Carrier)(inside: _) => Algebra[parameter := parameter].Interior[inside := inside].belongs;

\definition cellInterior: \forall (parameter: Rotations.Carrier) -> \In[Grassmannian.Carrier] cell (map parameter) -> Rotations.Interior parameter := \block {
  \fun (parameter: Rotations.Carrier)(member: _) \then
  \let p: Cell := \into[Grassmannian.Carrier](map parameter, cell) \by { member } \then
  \takefrom preimage: InteriorPreimage[p] \by interiorSurjective p \then
  \let same: preimage.parameter = parameter := Compare[first := preimage.parameter, second := parameter,
    firstInside := preimage.inside, same := preimage.image].equal \then
  \return \idelim preimage.parameter = parameter \with A: Rotations.Carrier => Rotations.Interior A \by { base: preimage.inside, equality: same }
};
\definition boundaryAvoids: \forall (parameter: Rotations.Carrier) -> Rotations.Boundary parameter -> Logic.Not (\In[Grassmannian.Carrier] cell (map parameter)) := \block {
  \fun (parameter: Rotations.Carrier)(boundary: _)(member: _) \then
  \takefrom j: \Cast[Fin.Fin k] ({ j: Fin.Fin k \where InnerLaws.squared (parameter j) = real.Analysis[].one }) \by boundary \then
  \return dedekind_reals.DedekindReal[].Order[].ltNotEq _ real.Analysis[].one (cellInterior parameter member j)
    (\bysub(Fin.Fin k, { j: Fin.Fin k \where InnerLaws.squared (parameter j) = real.Analysis[].one }, j))
};

\definition cellDimension: std.Data[].Nat[].Nat^ := Symbols.complexDimension symbol;
\structure BoundaryImage[p: Grassmannian.Carrier]: \Set := {
  symbol: Symbols.Symbol,
  lower: std.Data[].Nat[].Basic[].Prop[].Lt (Symbols.complexDimension symbol) cellDimension,
  contains: \In[Grassmannian.Carrier] (\root.Complex[n := n, k := k, symbol := symbol].Canonical[].cell) p,
};
\module Boundary(parameter: Rotations.Carrier);
\definition boundaryLower: \forall (parameter: Rotations.Carrier) -> Rotations.Boundary parameter -> \exists BoundaryImage[map parameter] :=
  \fun (parameter: Rotations.Carrier)(boundary: _) => Boundary[parameter := parameter].exists boundary;

\module StandardDisk(disk: DiskData);
