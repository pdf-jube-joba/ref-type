\module CompactCell(A: \Set, space: topology.Topology[Carrier := A].Topology,
  hausdorff: topology.Topology[Carrier := A].IsT2 space, d: std.Data[].Nat[].Nat^,
  f: algebraic_topology.Euclidean[].Disk d -> A,
  continuous: topology.Continuity[A := algebraic_topology.Euclidean[].Disk d, B := A].Continuous
    algebraic_topology.Euclidean[].Dimension[n := d].diskTopology space f,
  injective: \forall (p, q: algebraic_topology.Euclidean[].Disk d) ->
    \In[algebraic_topology.Euclidean[].coordinateCarrier d] (algebraic_topology.Euclidean[].interiorAt d) p ->
    \In[algebraic_topology.Euclidean[].coordinateCarrier d] (algebraic_topology.Euclidean[].interiorAt d) q -> f p = f q -> p = q,
  clean: \forall (p, q: algebraic_topology.Euclidean[].Disk d) ->
    \In[algebraic_topology.Euclidean[].coordinateCarrier d] (algebraic_topology.Euclidean[].interiorAt d) p -> f p = f q ->
    \In[algebraic_topology.Euclidean[].coordinateCarrier d] (algebraic_topology.Euclidean[].interiorAt d) q);
\module GaugeDisk(d: std.Data[].Nat[].Nat^, q: algebraic_topology.Euclidean[].coordinateCarrier d -> real.Analysis[].Real,
  continuous: metric_spaces.RealFunctions[A := algebraic_topology.Euclidean[].coordinateCarrier d].Continuous
    algebraic_topology.Euclidean[].Dimension[n := d].topology q,
  nonnegative: \forall (x: algebraic_topology.Euclidean[].coordinateCarrier d) -> dedekind_reals.DedekindReal[].Le real.Analysis[].zero (q x),
  zero: q algebraic_topology.Euclidean[].Dimension[n := d].Contraction[].zero = real.Analysis[].zero,
  definite: \forall (x: algebraic_topology.Euclidean[].coordinateCarrier d) -> q x = real.Analysis[].zero -> x = algebraic_topology.Euclidean[].Dimension[n := d].Contraction[].zero,
  homogeneous: \forall (a: real.Analysis[].Real)(x: algebraic_topology.Euclidean[].coordinateCarrier d) ->
    q (algebraic_topology.Euclidean[].Dimension[n := d].Contraction[].scale a x) = real.Analysis[].mul (real.Analysis[].mul a a) (q x));
