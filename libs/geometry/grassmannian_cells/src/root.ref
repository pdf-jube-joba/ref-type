\module Symbols(n, k: std.Data[].Nat[].Nat^);
\module Echelon(K: \Set, field: std.Alg[].Field[].Field[K], n, k: std.Data[].Nat[].Nat^,
  symbol: \root.Symbols[n := n, k := k].Symbol);
\module WeakUnion(X: \Set, stages: std.Data[].Nat[].Nat^ -> \Pow X,
  spaces: \forall (n: std.Data[].Nat[].Nat^) -> topology.Topology[Carrier := \Cast[X] (stages n)].Topology);
\module Real(n, k: std.Data[].Nat[].Nat^, symbol: \root.Symbols[n := n, k := k].Symbol);
\module Complex(n, k: std.Data[].Nat[].Nat^, symbol: \root.Symbols[n := n, k := k].Symbol);
\module RankTransportReal(n, a, b: std.Data[].Nat[].Nat^, same: a = b);
\module AmbientReal(n, k, m: std.Data[].Nat[].Nat^);
\module RankTransportComplex(n, a, b: std.Data[].Nat[].Nat^, same: a = b);
\module AmbientComplex(n, k, m: std.Data[].Nat[].Nat^);
\module ClosedEmbedding(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology,
  f: A -> B, compact: topology.Topology[Carrier := A].IsCompact source, hausdorff: topology.Topology[Carrier := B].IsT2 target,
  continuous: topology.Continuity[A := A, B := B].Continuous source target f,
  injective: \forall (x, y: A) -> f x = f y -> x = y);
\module ProjectionUniqueness(K: \Set, field: std.Alg[].Field[].Field[K],
  scalar: linear_algebra.Hermitian[].Scalar[K, field],
  topological: hermitian_frames.Hermitian[].ScalarTopology[K, field, scalar], n: std.Data[].Nat[].Nat^);
