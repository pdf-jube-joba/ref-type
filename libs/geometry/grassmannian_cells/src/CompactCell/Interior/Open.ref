\import topology.Continuity[A := Target.CarrierSet, B := Domain.CarrierSet] \as Reverse;
\module Trace(O: \Pow Model.Disk, diskOpen: DiskSpace.IsOpenIn Model.diskTopology O, same: U = Domain.Trace O);
\definition continuous: topology.Topology[Carrier := Target.CarrierSet].IsOpenIn target (Reverse.Preimage backward U) :=
  Domain.openTraceElim Model.diskTopology U
    (topology.Topology[Carrier := Target.CarrierSet].IsOpenIn target (Reverse.Preimage backward U))
    (\fun (O: \Pow Model.Disk)(diskOpen: _)(same: _) => Trace[O := O, diskOpen := diskOpen, same := same].continuous)
    (Domain.openRepresentation Model.diskTopology U open);
