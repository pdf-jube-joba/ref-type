\import \root.Real[n := n, k := k, symbol := s].Canonical[].Characteristic[] \as Characteristic;
\definition exists: \forall (p: Euclidean.Disk (cell s).dimension) ->
  \In[Euclidean.coordinateCarrier (cell s).dimension] (Euclidean.boundaryAt (cell s).dimension) p ->
  \exists CW.BoundaryWitness[cells, cell s, (cell s).characteristic p] := \block {
  \fun (p: Euclidean.Disk (cell s).dimension)(boundary: _) \then
  \takefrom w: Characteristic.BoundaryImage[Characteristic.map ((disks s).homeomorphism.forward p)] \by
    Characteristic.boundaryLower ((disks s).homeomorphism.forward p) ((disks s).forwardBoundary p boundary) \then
  \return \exact(CW.BoundaryWitness[cells, cell s, (cell s).characteristic p] {
    other := cell w.symbol, member := member w.symbol, lower := w.lower,
    contains := contains w.symbol ((cell s).characteristic p) w.contains,
  }, CW.BoundaryWitness[cells, cell s, (cell s).characteristic p])
};
