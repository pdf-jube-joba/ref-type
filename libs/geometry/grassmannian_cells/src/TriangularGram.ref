\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Natural;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as Order;
\import linear_algebra.Hermitian[].Over[K := K, field := field, scalar := scalar] \as Geometry;
\import Geometry.Finite[n := n] \as Ambient;
\import Geometry.Inner[V := Ambient.Vector, space := Ambient.space].Of[h := Ambient.form] \as Inner;
\import linear_algebra.Commutative[K := K, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing K field] \as Linear;
\import Linear.Laws[V := Ambient.Vector, space := Ambient.space] \as VectorLaws;
\definition negativeZero: Linear.neg Linear.zero = Linear.zero := trans!{K} _ _ _
  (sym!{K} _ _ (Linear.addZeroLeft (Linear.neg Linear.zero))) (Linear.addNegRight Linear.zero);
\module At(k: N.Nat^);
\definition Existence[k: N.Nat^]: \Prop := \forall (symbol: At[k := k].Symbol)(A: At[k := k].Map) ->
  At[k := k].Injective A -> At[k := k].Laws[symbol, A] -> \exists At[k := k].Factorization[symbol, A];
\module Zero;
\module Step(k: N.Nat^);
\definition exists: \forall (k: N.Nat^) -> Existence k :=
  \induction (k: N.Nat^) \return Existence k \with {
    | zero: Zero[].exists
    | succ: \fun (k: N.Nat^)(previous: Existence k) => Step[k := k].exists previous
  };
