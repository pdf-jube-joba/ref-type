\import Ambient.Unitary[] \as Unitary;
\import End.Composition[U := E.Vector, domain := E.space] \as Compose;
\import std.Data[].FinSet[] \as Fin;
\definition map[u: Unitary.Carrier]: End.Map := Compose.compose u.forward (Compose.compose P.map u.backward);
\definition projection[u: Unitary.Carrier]: Ambient.Projection := Ambient.Projection {
  map := map u,
  selfAdjoint := \fun (v, w: E.Vector) => eq_reason_in!{K _
    "=" _ "by" { Unitary.adjoint u (P.map.apply (u.backward.apply v)) w }
    "=" _ "by" { P.selfAdjoint (u.backward.apply v) (u.backward.apply w) }
    "=" _ "by" { Unitary.adjoint (Unitary.inverse u) v (P.map.apply (u.backward.apply w)) }
  },
  idempotent := \fun (v: E.Vector) => eq_reason_in!{{E.Vector} _
    "=" _ "by" { congr!{{E.Vector} {E.Vector}} (\fun (w: E.Vector) => u.forward.apply (P.map.apply w)) _ _
      (u.leftInverse (P.map.apply (u.backward.apply v))) }
    "=" _ "by" { congr!{{E.Vector} {E.Vector}} u.forward.apply _ _ (P.idempotent (u.backward.apply v)) }
  },
};
\module Rank(k: std.Data[].Nat[].Nat^, u: Unitary.Carrier, basis: Ambient.OnProjection[P := P].Rank[k := k].Basis);
\definition rank: \forall (k: std.Data[].Nat[].Nat^)(u: Unitary.Carrier) ->
  Ambient.OnProjection[P := P].Rank[k := k].HasRank -> Ambient.OnProjection[P := projection u].Rank[k := k].HasRank := \block {
  \fun (k: std.Data[].Nat[].Nat^)(u: Unitary.Carrier)(rank: _) \then
  \takefrom basis: Ambient.OnProjection[P := P].Rank[k := k].Basis \by rank \then
  \return \exact(Rank[k := k, u := u, basis := basis].value, Ambient.OnProjection[P := projection u].Rank[k := k].Basis)
};
\definition fixedImage: \forall (u: Unitary.Carrier)(v: E.Vector) -> Logic.PropEquiv[
  (projection u).map.apply v = v, P.map.apply (u.backward.apply v) = u.backward.apply v] :=
  \fun (u: Unitary.Carrier)(v: E.Vector) => Logic.PropEquiv[_, _] {
    ltr := \fun (fixed: (projection u).map.apply v = v) => trans!{{E.Vector}}
      (P.map.apply (u.backward.apply v)) (u.backward.apply ((projection u).map.apply v)) (u.backward.apply v)
      (sym!{{E.Vector}} _ _ (u.leftInverse (P.map.apply (u.backward.apply v))))
      (congr!{{E.Vector} {E.Vector}} u.backward.apply ((projection u).map.apply v) v fixed),
    rtl := \fun (fixed: P.map.apply (u.backward.apply v) = u.backward.apply v) => trans!{{E.Vector}}
      ((projection u).map.apply v) (u.forward.apply (u.backward.apply v)) v
      (congr!{{E.Vector} {E.Vector}} u.forward.apply (P.map.apply (u.backward.apply v)) (u.backward.apply v) fixed)
      (u.rightInverse v),
  };
\import Ambient.Families[X := Unitary.Carrier].Matrix[m := n] \as Matrices;
\import Unitary.Families[X := Unitary.Carrier] \as Families;
\definition identityRegular: Families.Regular Unitary.topology (\fun (u: Unitary.Carrier) => u) :=
  Families.regular Unitary.topology (\fun (u: Unitary.Carrier) => u)
    (topology.Maps[A := Unitary.Carrier, B := Unitary.Carrier].Identity[].continuous Unitary.topology);
\definition inverseRegular: Families.Regular Unitary.topology Unitary.inverse :=
  Families.reciprocal Unitary.topology (\fun (u: Unitary.Carrier) => u) identityRegular;
\definition components: Matrices.Components Unitary.topology map :=
  \fun (j: Fin.Fin n) => Matrices.evaluate Unitary.topology (\fun (u: Unitary.Carrier) => u.forward)
    (\fun (u: Unitary.Carrier) => P.map.apply (u.backward.apply (E.basis j))) identityRegular
    (Matrices.evaluate Unitary.topology (\fun (_: Unitary.Carrier) => P.map)
      (\fun (u: Unitary.Carrier) => u.backward.apply (E.basis j))
      (\fun (i: Fin.Fin n) => Matrices.constant Unitary.topology P.map (E.basis i)) (inverseRegular j));
\definition regular: Matrices.Regular Unitary.topology map := Matrices.regularOfComponents Unitary.topology map components;
\module Family(X: \Set, source: topology.Topology[Carrier := X].Topology, u: X -> Unitary.Carrier,
  continuous: topology.Continuity[A := X, B := Unitary.Carrier].Continuous source Unitary.topology u);
