\import \root.Reflection[K := K, field := field, scalar := scalar, topological := topological, n := n].Hemisphere[e := e, eUnit := eUnit].Disk[] \as DiskParent;
\import \root.Reflection[K := K, field := field, scalar := scalar, topological := topological, n := n].Hemisphere[e := e, eUnit := eUnit] \as HemisphereParent;
\definition h: R.Real := height v;
\definition u: E.Vector := read v;
\definition axial: E.Vector := E.space.smul (Geometry.embed h) e;
\import Inner.Unit[v := e, norm := eUnit] \as Axis;
\definition residual: u = Axis.residual.apply v :=
  congr!{K {E.Vector}} (\fun (a: K) => Inner.subtract v (E.space.smul a e)) _ _ (sym!{K} _ _ (HemisphereParent.laws v).real);
\definition orthogonal: E.dot e u = Spaces.zero :=
  trans!{K} _ _ _ (congr!{{E.Vector} K} (E.dot e) _ _ residual) (Axis.orthogonal v);
\definition reverseOrthogonal: E.dot u e = Spaces.zero := trans!{K} _ _ _ (E.symmetric u e)
  (trans!{K} _ _ _ (congr!{K K} Geometry.conj _ _ orthogonal) Geometry.conjugateZero);
\definition reconstruct: E.space.add u axial = v := Inner.subtractAdd v axial;
\definition cross: E.dot u axial = Spaces.zero := trans!{K} _ _ _ (E.scaleRight (Geometry.embed h) u e)
  (trans!{K} _ _ _ (congr!{K K} (Spaces.mul (Geometry.embed h)) _ _ reverseOrthogonal) (Spaces.mulZeroRight (Geometry.embed h)));
\definition reverseCross: E.dot axial u = Spaces.zero := trans!{K} _ _ _ (E.symmetric axial u)
  (trans!{K} _ _ _ (congr!{K K} Geometry.conj _ _ cross) Geometry.conjugateZero);
\definition axialSquare: E.dot axial axial = Geometry.embed (R.mul h h) := eq_reason_in!{K _
  "=" _ "by" { Inner.scaleLeft (Geometry.embed h) e axial }
  "=" _ "by" { congr!{K K K} Spaces.mul _ _ _ _ (scalar.conjugateReal h)
    (trans!{K} _ _ _ (E.scaleRight (Geometry.embed h) e e)
      (trans!{K} _ _ _ (congr!{K K} (Spaces.mul (Geometry.embed h)) _ _ eUnit) (Spaces.mulOneRight (Geometry.embed h)))) }
  "=" _ "by" { sym!{K} _ _ (scalar.embedMul h h) }
};
\definition normIdentity: R.add (Inner.squared u) (R.mul h h) = R.one := Geometry.embedInjective _ _ (eq_reason_in!{K _
  "=" _ "by" { scalar.embedAdd (Inner.squared u) (R.mul h h) }
  "=" _ "by" { congr!{K K K} Spaces.add _ _ _ _ (sym!{K} _ _ (Inner.selfReal u)) (sym!{K} _ _ axialSquare) }
  "=" _ "by" { congr!{K K K} Spaces.add _ _ _ _
    (sym!{K} _ _ (trans!{K} _ _ _ (E.addRight u u axial)
      (trans!{K} _ _ _ (congr!{K K} (Spaces.add (E.dot u u)) _ _ cross) (Spaces.addZeroRight (E.dot u u)))))
    (sym!{K} _ _ (trans!{K} _ _ _ (E.addRight axial u axial)
      (trans!{K} _ _ _ (congr!{K K} (\fun (a: K) => Spaces.add a (E.dot axial axial)) _ _ reverseCross) (Spaces.addZeroLeft (E.dot axial axial))))) }
  "=" _ "by" { sym!{K} _ _ (Inner.addLeft u axial (E.space.add u axial)) }
  "=" _ "by" { congr!{{E.Vector} {E.Vector} K} E.dot _ _ _ _ reconstruct reconstruct }
  "=" _ "by" { (HemisphereParent.laws v).unit }
  "=" _ "by" { sym!{K} _ _ scalar.embedOne }
});
\definition bounded: Order.Le (Inner.squared u) R.one := Order.leReplaceRight _ _ R.one normIdentity
  (R.Algebra[].leAddRight (Inner.squared u) (R.mul h h) (R.Algebra[].squareNonnegative h));
\definition disk: Disk := \into[E.Vector](u, Disk) \by { DiskLaws[u] { orthogonal := orthogonal, bounded := bounded } };
\definition complement: R.sub R.one (Inner.squared u) = R.mul h h :=
  sym!{R.Real} _ _ (Arithmetic.addSolveRight (R.mul h h) (Inner.squared u) R.one
    (trans!{R.Real} _ _ _ (Arithmetic.addComm (R.mul h h) (Inner.squared u)) normIdentity));
\definition radius: DiskParent.radius disk = h := Root.squaresInjective (DiskParent.radius disk) h
  (radiusNonnegative disk) (HemisphereParent.laws v).nonnegative (trans!{R.Real} _ _ _ (radiusSquared disk) complement);
\definition vector: DiskParent.vector disk = v := trans!{{E.Vector}} _ _ _
  (congr!{R.Real {E.Vector}} (\fun (a: R.Real) => E.space.add u (E.space.smul (Geometry.embed a) e)) _ _ radius) reconstruct;
\definition liftRead: lift disk = v := vector;
\definition rotation: (DiskParent.rotation disk).forward.apply e = v := trans!{{E.Vector}} _ _ _ (sendsAxis disk) vector;
\definition interior: Order.Lt R.zero h -> Order.Lt (Inner.squared u) R.one :=
  \fun (positive: _) => Order.Order[].ltOfLeNotEq _ R.one bounded (\fun (onBoundary: _) =>
    Order.Order[].ltNotEq R.zero h positive (sym!{R.Real} _ _ (trans!{R.Real} _ _ _ (sym!{R.Real} _ _ radius) (DiskParent.onBoundary disk onBoundary))));
