\import \root.Reflection[K := K, field := field, scalar := scalar, topological := topological, n := n].Hemisphere[e := e, eUnit := eUnit] \as HemisphereParent;
\import \root.Reflection[K := K, field := field, scalar := scalar, topological := topological, n := n] \as ReflectionParent;
\import R.SquareRoot[] \as Root;
\structure DiskLaws[u: E.Vector]: \Prop := {
  orthogonal: E.dot e u = Spaces.zero,
  bounded: Order.Le (Inner.squared u) R.one,
};
\definition Disk: \Set := \Cast[E.Vector] ({ u: E.Vector \where DiskLaws[u] });
\definition diskLaws[u: Disk]: DiskLaws[u] := \bysub(E.Vector, Disk, u);
\definition radius[u: Disk]: R.Real := Root.sqrt (R.sub R.one (Inner.squared u));
\definition radiusNonnegative: \forall (u: Disk) -> Order.Le R.zero (radius u) :=
  \fun (u: Disk) => Root.nonnegative (R.sub R.one (Inner.squared u));
\definition radiusSquared: \forall (u: Disk) -> R.mul (radius u) (radius u) = R.sub R.one (Inner.squared u) :=
  \fun (u: Disk) => Root.squareOfNonnegative (R.sub R.one (Inner.squared u))
    (R.Distance[].subNonnegative R.one (Inner.squared u) (diskLaws u).bounded);
\definition vector[u: Disk]: E.Vector := E.space.add u (E.space.smul (Geometry.embed (radius u)) e);
\definition reverseOrthogonal: \forall (u: Disk) -> E.dot u e = Spaces.zero :=
  \fun (u: Disk) => trans!{K} _ _ _ (E.symmetric u e)
    (trans!{K} _ _ _ (congr!{K K} Geometry.conj _ _ (diskLaws u).orthogonal) Geometry.conjugateZero);
\definition cross: \forall (u: Disk) -> E.dot u (E.space.smul (Geometry.embed (radius u)) e) = Spaces.zero :=
  \fun (u: Disk) => trans!{K} _ _ _ (E.scaleRight (Geometry.embed (radius u)) u e)
    (trans!{K} _ _ _ (congr!{K K} (Spaces.mul (Geometry.embed (radius u))) _ _ (reverseOrthogonal u))
      (Spaces.mulZeroRight (Geometry.embed (radius u))));
\definition scaledUnit: \forall (u: Disk) ->
  E.dot (E.space.smul (Geometry.embed (radius u)) e) (E.space.smul (Geometry.embed (radius u)) e) =
    Geometry.embed (R.mul (radius u) (radius u)) :=
  \fun (u: Disk) => eq_reason_in!{K _
    "=" _ "by" { Inner.scaleLeft (Geometry.embed (radius u)) e (E.space.smul (Geometry.embed (radius u)) e) }
    "=" _ "by" { congr!{K K K} Spaces.mul _ _ _ _ (scalar.conjugateReal (radius u))
      (trans!{K} _ _ _ (E.scaleRight (Geometry.embed (radius u)) e e)
        (trans!{K} _ _ _ (congr!{K K} (Spaces.mul (Geometry.embed (radius u))) _ _ eUnit)
          (Spaces.mulOneRight (Geometry.embed (radius u))))) }
    "=" _ "by" { sym!{K} _ _ (scalar.embedMul (radius u) (radius u)) }
  };
\definition unit: \forall (u: Disk) -> E.dot (vector u) (vector u) = Spaces.one :=
  \fun (u: Disk) => eq_reason_in!{K _
    "=" _ "by" { Inner.addLeft u (E.space.smul (Geometry.embed (radius u)) e) (vector u) }
    "=" _ "by" { congr!{K K K} Spaces.add _ _ _ _
      (trans!{K} _ _ _ (E.addRight u u (E.space.smul (Geometry.embed (radius u)) e))
        (trans!{K} _ _ _ (congr!{K K} (Spaces.add (E.dot u u)) _ _ (cross u)) (Spaces.addZeroRight (E.dot u u))))
      (trans!{K} _ _ _ (E.addRight (E.space.smul (Geometry.embed (radius u)) e) u (E.space.smul (Geometry.embed (radius u)) e))
        (trans!{K} _ _ _ (congr!{K K K} Spaces.add _ _ _ _
          (trans!{K} _ _ _ (E.symmetric (E.space.smul (Geometry.embed (radius u)) e) u)
            (trans!{K} _ _ _ (congr!{K K} Geometry.conj _ _ (cross u)) Geometry.conjugateZero))
          (scaledUnit u)) (Spaces.addZeroLeft (Geometry.embed (R.mul (radius u) (radius u)))))) }
    "=" _ "by" { congr!{K K K} Spaces.add _ _ _ _ (Inner.selfReal u)
      (congr!{R.Real K} Geometry.embed _ _ (radiusSquared u)) }
    "=" _ "by" { sym!{K} _ _ (scalar.embedAdd (Inner.squared u) (R.sub R.one (Inner.squared u))) }
    "=" _ "by" { congr!{R.Real K} Geometry.embed _ _ (R.Estimates[].addSubCancel R.one (Inner.squared u)) }
    "=" _ "by" { scalar.embedOne }
  };
\definition axisProduct: \forall (u: Disk) -> E.dot e (vector u) = Geometry.embed (radius u) :=
  \fun (u: Disk) => eq_reason_in!{K _
    "=" _ "by" { E.addRight e u (E.space.smul (Geometry.embed (radius u)) e) }
    "=" _ "by" { congr!{K K K} Spaces.add _ _ _ _ (diskLaws u).orthogonal
      (trans!{K} _ _ _ (E.scaleRight (Geometry.embed (radius u)) e e)
        (trans!{K} _ _ _ (congr!{K K} (Spaces.mul (Geometry.embed (radius u))) _ _ eUnit)
          (Spaces.mulOneRight (Geometry.embed (radius u))))) }
    "=" _ "by" { Spaces.addZeroLeft (Geometry.embed (radius u)) }
  };
\definition heightFormula: \forall (u: Disk) -> height (vector u) = radius u :=
  \fun (u: Disk) => trans!{R.Real} _ _ _ (congr!{K R.Real} scalar.realPart _ _ (axisProduct u)) (scalar.realEmbed (radius u));
\definition lift[u: Disk]: Carrier := \into[E.Vector](vector u, Carrier) \by {
  HemisphereLaws[vector u] {
    unit := unit u,
    real := trans!{K} _ _ _ (axisProduct u) (congr!{R.Real K} Geometry.embed _ _ (sym!{R.Real} _ _ (heightFormula u))),
    nonnegative := Order.leReplaceRight R.zero (radius u) (height (vector u)) (sym!{R.Real} _ _ (heightFormula u)) (radiusNonnegative u),
  }
};
\definition read[v: Carrier]: E.Vector := Inner.subtract v (E.space.smul (Geometry.embed (height v)) e);
\definition readLift: \forall (u: Disk) -> read (lift u) = u :=
  \fun (u: Disk) => trans!{{E.Vector}} _ _ _
    (congr!{R.Real {E.Vector}} (\fun (t: R.Real) => Inner.subtract (vector u) (E.space.smul (Geometry.embed t) e)) _ _ (heightFormula u))
    (trans!{{E.Vector}} _ _ _ (Laws.assoc u (E.space.smul (Geometry.embed (radius u)) e) (E.space.neg (E.space.smul (Geometry.embed (radius u)) e)))
      (trans!{{E.Vector}} _ _ _ (congr!{{E.Vector} {E.Vector}} (E.space.add u) _ _ (ReflectionParent.subtractSelf (E.space.smul (Geometry.embed (radius u)) e))) (Laws.zeroRight u)));
\definition injective: \forall (u, v: Disk) -> lift u = lift v -> u = v :=
  \fun (u, v: Disk)(same: _) => trans!{{E.Vector}} _ _ _ (sym!{{E.Vector}} _ _ (readLift u))
    (trans!{{E.Vector}} _ _ _ (congr!{Carrier {E.Vector}} read _ _ same) (readLift v));
\definition topology: topology.Topology[Carrier := Disk].Topology :=
  topology.Topology[Carrier := E.Vector].Subspace[S := { u: E.Vector \where DiskLaws[u] }].topology vectorTopology;
\import Ambient.Families[X := Disk] \as Vectors;
\import Hermitian.Functions[X := Disk] \as Functions;
\import metric_spaces.RealFunctions[A := Disk] \as Reals;
\definition inclusionContinuous: Vectors.Continuous topology (\fun (u: Disk) => u) :=
  \fun (i: Fin.Fin n) => topology.Composition[A := Disk, B := E.Vector, C := K].composeContinuous
    topology vectorTopology topological.space (\fun (u: Disk) => u) (Coordinates.evaluate i)
    (topology.Continuity[A := Disk, B := E.Vector].Corestriction[S := { u: E.Vector \where DiskLaws[u] }].inclusionContinuous vectorTopology)
    (Coordinates.evaluationContinuous topological.space i);
\definition squaredContinuous: Reals.Continuous topology (\fun (u: Disk) => Inner.squared u) :=
  Functions.realPart topology (\fun (u: Disk) => E.dot u u)
    (Vectors.dotContinuous topology (\fun (u: Disk) => u) (\fun (u: Disk) => u) inclusionContinuous inclusionContinuous);
\definition radiusContinuous: Reals.Continuous topology radius :=
  Reals.SquareRoot[].continuous topology (\fun (u: Disk) => R.sub R.one (Inner.squared u))
    (Reals.sumContinuous topology (\fun (_: Disk) => R.one) (\fun (u: Disk) => R.neg (Inner.squared u))
      (Reals.constantContinuous topology R.one)
      (Reals.negContinuous topology (\fun (u: Disk) => Inner.squared u) squaredContinuous));
\definition vectorContinuous: Vectors.Continuous topology vector :=
  Vectors.addition topology (\fun (u: Disk) => u) (\fun (u: Disk) => E.space.smul (Geometry.embed (radius u)) e)
    inclusionContinuous (Vectors.scale topology (\fun (u: Disk) => Geometry.embed (radius u)) (\fun (_: Disk) => e)
      (Functions.embedding topology radius radiusContinuous) (Vectors.constant topology e));
\definition liftContinuous: topology.Continuity[A := Disk, B := Carrier].Continuous topology HemisphereParent.topology lift :=
  topology.Continuity[A := Disk, B := E.Vector].Corestriction[S := { v: E.Vector \where HemisphereLaws[v] }].corestrictContinuous
    topology vectorTopology lift (Coordinates.Universal[A := Disk].continuous topology topological.space vector vectorContinuous);
\definition rotation[u: Disk]: Ambient.Unitary[].Carrier := HemisphereParent.rotation (lift u);
\definition rotationContinuous: topology.Continuity[A := Disk, B := Ambient.Unitary[].Carrier].Continuous topology Ambient.Unitary[].topology rotation :=
  topology.Composition[A := Disk, B := Carrier, C := Ambient.Unitary[].Carrier].composeContinuous topology HemisphereParent.topology Ambient.Unitary[].topology
    lift HemisphereParent.rotation liftContinuous HemisphereParent.continuous;
\definition sendsAxis: \forall (u: Disk) -> (rotation u).forward.apply e = vector u :=
  \fun (u: Disk) => HemisphereParent.sendsAxis (lift u);
\definition onBoundary: \forall (u: Disk) -> Inner.squared u = R.one -> radius u = R.zero :=
  \fun (u: Disk)(boundary: _) => trans!{R.Real} _ _ _
    (congr!{R.Real R.Real} Root.sqrt _ _ (trans!{R.Real} _ _ _
      (congr!{R.Real R.Real} (R.sub R.one) _ _ boundary) (Arithmetic.subSelf R.one))) Root.sqrtZero;
\definition boundaryVector: \forall (u: Disk) -> Inner.squared u = R.one -> vector u = u :=
  \fun (u: Disk)(boundary: _) => trans!{{E.Vector}} _ _ _
    (congr!{K {E.Vector}} (\fun (a: K) => E.space.add u (E.space.smul a e)) _ _
      (trans!{K} _ _ _ (congr!{R.Real K} Geometry.embed _ _ (onBoundary u boundary)) scalar.embedZero))
    (trans!{{E.Vector}} _ _ _ (congr!{{E.Vector} {E.Vector}} (E.space.add u) _ _ (Laws.zeroScale e)) (Laws.zeroRight u));
\module Inverse(v: Carrier);
