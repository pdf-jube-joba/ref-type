\definition regular: Ambient.Families[X := X].Matrix[m := n].Regular source (\fun (x: X) => map (u x)) :=
  \fun (v: E.Vector)(i: Fin.Fin n) => topology.Composition[A := X, B := Unitary.Carrier, C := K].composeContinuous
    source Unitary.topology topological.space u (\fun (q: Unitary.Carrier) => (map q).apply v i)
    continuous (\parent.regular v i);
