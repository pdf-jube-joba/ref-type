\import Geometry.Finite[n := k] \as Domain;
\import Spaces.Linear[V := Domain.Vector, W := E.Vector, source := Domain.space, target := E.space] \as Forward;
\import Spaces.Linear[V := E.Vector, W := Domain.Vector, source := E.space, target := Domain.space] \as Backward;
\definition value: Ambient.OnProjection[P := projection u].Rank[k := k].Basis :=
  Ambient.OnProjection[P := projection u].Rank[k := k].Basis {
    value := End.Composition[U := Domain.Vector, domain := Domain.space].compose u.forward basis.value,
    coordinate := Backward.Composition[U := E.Vector, domain := E.space].compose basis.coordinate u.backward,
    leftInverse := \fun (v: Domain.Vector) => trans!{{Domain.Vector}} _ _ _
      (congr!{{E.Vector} {Domain.Vector}} basis.coordinate.apply _ _ (u.leftInverse (basis.value.apply v))) (basis.leftInverse v),
    reconstruction := \fun (v: E.Vector) => congr!{{E.Vector} {E.Vector}} u.forward.apply _ _ (basis.reconstruction (u.backward.apply v)),
  };
