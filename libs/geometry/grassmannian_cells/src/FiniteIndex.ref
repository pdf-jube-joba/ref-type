\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].List[] \as Lists;
\import Fin.FromList[A := A] \as Tuples;
\import Fin.Tuples[A := A] \as Extend;
\import Lists.Membership[A := A] \as Membership;
\import Lists.Distinct[A := A] \as Distinct;
\import std.Set[].FiniteSubset[A := A] \as Sets;
\import Sets.Enumeration[] \as Enumeration;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Logic.either;
\definition Injective[xs: Lists.List[A]]: \Prop := \forall (i, j: Fin.Fin (Lists.length A xs)) ->
  Tuples.tuple xs i = Tuples.tuple xs j -> i = j;
\definition tupleOccurs: \forall (xs: Lists.List[A])(i: Fin.Fin (Lists.length A xs)) -> Membership.Occurs (Tuples.tuple xs i) xs :=
  \fun (xs: Lists.List[A])(i: Fin.Fin (Lists.length A xs)) =>
    \idelim Tuples.list (Lists.length A xs) (Tuples.tuple xs) = xs \with ys: Lists.List[A] =>
      Membership.Occurs (Tuples.tuple xs i) ys \by {
        base: Tuples.occurs (Lists.length A xs) (Tuples.tuple xs) i, equality: Tuples.listTuple xs
      };
\definition tupleOnto: \forall (xs: Lists.List[A])(a: A) -> Membership.Occurs a xs ->
  \exists (i: Fin.Fin (Lists.length A xs) \where Tuples.tuple xs i = a) :=
  \induction (xs: Lists.List[A]) \return \forall (a: A) -> Membership.Occurs a xs ->
    \exists (i: Fin.Fin (Lists.length A xs) \where Tuples.tuple xs i = a) \with {
      | nil: \fun (a: A)(empty: Logic.False) => Logic.falseElim _ empty
      | cons: \fun (head: A)(tail: Lists.List[A])(previous: _)(a: A)(member: _) =>
          either!{member {\exists (i: Fin.Fin (N.Nat^::succ (Lists.length A tail)) \where Tuples.tuple (Lists.List[A]::cons head tail) i = a)}
            {\fun (same: a = head) => Logic.existsIntro[Fin.Fin (N.Nat^::succ (Lists.length A tail)),
              { i: Fin.Fin (N.Nat^::succ (Lists.length A tail)) \where Tuples.tuple (Lists.List[A]::cons head tail) i = a }]
              (Fin.zero (Lists.length A tail)) (trans!{A} _ _ _ (Extend.atZero (Lists.length A tail) head (Tuples.tuple tail)) (sym!{A} _ _ same))}
            {\block {
              \fun (old: _) \then
              \takefrom i: \Cast[Fin.Fin (Lists.length A tail)] ({ i: Fin.Fin (Lists.length A tail) \where Tuples.tuple tail i = a })
                \by previous a old \then
              \return Logic.existsIntro[Fin.Fin (N.Nat^::succ (Lists.length A tail)),
                { j: Fin.Fin (N.Nat^::succ (Lists.length A tail)) \where Tuples.tuple (Lists.List[A]::cons head tail) j = a }]
                (Fin.succ (Lists.length A tail) i) (trans!{A} _ _ _ (Extend.atSuccessor (Lists.length A tail) head (Tuples.tuple tail) i)
                  (\bysub(Fin.Fin (Lists.length A tail), { i: Fin.Fin (Lists.length A tail) \where Tuples.tuple tail i = a }, i)))
            }}
          }
    };
\module Step(head: A, tail: Lists.List[A], fresh: Logic.Not (Membership.Occurs head tail), previous: Injective tail);
\definition tupleInjective: \forall (xs: Lists.List[A]) -> Distinct.Distinct xs -> Injective xs :=
  \fun (xs: Lists.List[A])(distinct: _) => distinct Injective
    (\fun (i, j: Fin.Fin N.Nat^::zero)(same: _) => Logic.falseElim _ (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i)))
    (\fun (head: A)(tail: Lists.List[A])(fresh: _)(previous: _) => Step[head := head, tail := tail, fresh := fresh, previous := previous].injective);
\structure Data: \Set := {
  size: N.Nat^,
  value: std.Data[].Bijection[A := Fin.Fin size, B := A].Bijection,
};
\module Of(xs: Lists.List[A], distinct: Distinct.Distinct xs, exhaustive: \forall (a: A) -> Membership.Occurs a xs);
\definition exists: Sets.Finite ({ a: A \where a = a }) -> \exists Data := \block {
  \fun (finite: _) \then
  \takefrom xs: Enumeration.DistinctEnumeration[({ a: A \where a = a })] \by
    Enumeration.existsDistinctEnumeration (\into[\Pow A](({ a: A \where a = a }), Sets.FiniteSubsetSet) \by { finite }) \then
  \let laws: Enumeration.DistinctEnumerationLaws[({ a: A \where a = a }), xs] :=
    \bysub(Lists.List[A], Enumeration.DistinctEnumeration[({ a: A \where a = a })], xs) \then
  \return \exact(Of[xs := xs, distinct := laws.distinct, exhaustive := \fun (a: A) => laws.enumerates.exhaustive a (\refl(a))].data, Data)
};
\definition foldedMembers[xs: Lists.List[A]]: \Pow A := Lists.foldr A (\Pow A)
  (\fun (head: A)(rest: \Pow A) => { x: A \where Logic.Or[x = head, \In[A] rest x] })
  ({ x: A \where Logic.False }) xs;
\definition foldMember: \forall (xs: Lists.List[A])(x: A) -> Membership.Occurs x xs -> \In[A] (foldedMembers xs) x :=
  \induction (xs: Lists.List[A]) \return \forall (x: A) -> Membership.Occurs x xs -> \In[A] (foldedMembers xs) x \with {
    | nil: \fun (x: A)(empty: Logic.False) => empty
    | cons: \fun (head: A)(tail: Lists.List[A])
      (previous: \forall (x: A) -> Membership.Occurs x tail -> \In[A] (foldedMembers tail) x)
      (x: A)(member: Membership.Occurs x (Lists.List[A]::cons head tail)) =>
      Logic.orElim[x = head, Membership.Occurs x tail, \In[A] (foldedMembers (Lists.List[A]::cons head tail)) x] member
        (\fun (same: x = head) => Logic.Or[x = head, \In[A] (foldedMembers tail) x]::left same)
        (\fun (old: Membership.Occurs x tail) => Logic.Or[x = head, \In[A] (foldedMembers tail) x]::right (previous x old))
  };
