\import \root.Euclidean[n := n] \as E;
\import \root.Euclidean[n := N.Nat^::succ n] \as Next;
\import E.SuccessorGeometry[] \as Geometry;
\import Geometry.Basis[] \as Basis;
\import \root.OrthogonalAtlas[].Step[n := n].Reflection[] \as Flip;
\import Next.Orientation[] \as Orientation;
\import E.Orientation[] \as LowerOrientation;
\import linear_algebra.Field[].Space[K := R.Real, field := R.Algebra[].field] \as Spaces;
\import Spaces.FiniteCoordinates[n := n] \as Base;
\import Spaces.FiniteCoordinates[n := N.Nat^::succ n] \as Higher;
\import Base.Top[] \as LowerTop;
\import Higher.Top[] \as Top;
\import Spaces.Multilinear[V := Next.Vector, space := Next.space] \as Multilinear;
\import Multilinear.Alternating[] \as Alternating;
\import Multilinear.Properties[] \as Updates;
\import Spaces.Laws[V := Next.Vector, space := Next.space] \as VectorLaws;
\import algebra.Groups[].On[G := Next.O, group := Next.orthogonalGroup] \as Group;
\import Fin.Tuples[A := Next.Vector] \as Tuples;
\import N.Basic[].Prop[] \as Natural;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Arithmetic;
\import R.Algebra[] \as Algebra;
\module First;
\module Reflection(v: Geometry.Sphere);
\module Extension(h: E.O);
\module Section(s: E.Vector);
\import \root.OrthogonalAtlas[].Step[n := n] \as MatrixCoordinates;
\definition assemblyDeterminant[s: E.Vector][h: E.O]: Orientation.determinant (MatrixCoordinates.assemble s h) = LowerOrientation.determinant h :=
  trans!{R.Real} _ _ _ (Orientation.multiplication Geometry.SphereSection[s := s].value Geometry.Extension[h := h].orthogonal)
    (trans!{R.Real} _ _ _ (congr2!{R.Real R.Real R.Real} R.mul _ _ _ _ Section[s := s].determinant Extension[h := h].determinant)
      (Arithmetic.fieldMulOneLeft (LowerOrientation.determinant h)));
\module On(previous: All n);
