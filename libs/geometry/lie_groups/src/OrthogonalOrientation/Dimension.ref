\import \root.Euclidean[n := n] \as E;
\import E.Orientation[] \as Orientation;
\import dedekind_reals.DedekindReal[].Order[] \as Order;
\import dedekind_reals.DedekindReal[] \as Reals;
\definition negativeOne: Reals.Lt (R.neg R.one) R.zero := Reals.ltReplaceRight (R.neg R.one) (R.neg R.zero) R.zero Arithmetic.negZero
  (Arithmetic.negStrictAntitone R.zero R.one R.Estimates[].Product[].onePositive);
\definition positiveIff: \forall (g: E.O) -> Logic.PropEquiv[Reals.Lt R.zero (Orientation.determinant g), Orientation.determinant g = R.one] :=
  \fun (g: E.O) => Logic.PropEquiv[_, _] {
    ltr := \fun (positive: Reals.Lt R.zero (Orientation.determinant g)) => either!{{(determinantSign n g)} {Orientation.determinant g = R.one}
      {\fun (same: Orientation.determinant g = R.one) => same}
      {\fun (negative: Orientation.determinant g = R.neg R.one) => Logic.falseElim (Orientation.determinant g = R.one)
        (Order.ltAsym R.zero (R.neg R.one) (\idelim Orientation.determinant g = R.neg R.one \with x: R.Real => Reals.Lt R.zero x \by {
          base: positive, equality: negative
        }) negativeOne)}
    },
    rtl := \fun (same: Orientation.determinant g = R.one) => \idelim R.one = Orientation.determinant g \with x: R.Real => Reals.Lt R.zero x \by {
      base: R.Estimates[].Product[].onePositive, equality: sym!{R.Real} _ _ same
    },
  };
