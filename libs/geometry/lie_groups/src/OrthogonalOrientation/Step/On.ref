\import \root.OrthogonalAtlas[] \as Atlases;
\import \root.OrthogonalAtlas[].Step[n := n] \as Coordinates;
\import Coordinates.On[previous := Atlases.atlasData n] \as Atlas;
\definition choiceSign: \forall (tag: N.Nat^) -> Sign (Orientation.determinant (Flip.choice tag)) :=
  \induction (tag: N.Nat^) \return Sign (Orientation.determinant (Flip.choice tag)) \with {
    | zero: Logic.Or[_, _]::left Orientation.atOne
    | succ: \fun (tag: N.Nat^)(_: _) => Logic.Or[_, _]::right \parent.First[].determinant
  };
\module Of(g: Next.O);
\definition law: All (N.Nat^::succ n) := \fun (g: Next.O) => Of[g := g].sign;
