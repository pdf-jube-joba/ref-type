\use std.Logic[].Equality[].eq_reason_in;
\import Next.PinRepresentation[].Positive[v := v] \as Representation;
\import \root.OrthogonalAtlas[].Step[n := n].Column[v := v] \as Column;
\import \parent.First[] \as First;
\definition Lifts: \Set := Column.Lifts;
\module Conjugation(h: Lifts);
\definition determinant: Orientation.determinant Representation.orthogonal = R.neg R.one := \block {
  \takefrom h: Lifts \by Column.exists \then
  \return eq_reason_in!{R.Real _
    "=" _ "by" { sym!{R.Real} _ _ (congr!{{Next.O} R.Real} Orientation.determinant _ _ (Conjugation[h := h].equal)) }
    "=" _ "by" { Orientation.conjugation h Flip.flip }
    "=" _ "by" First.determinant
  }
};
