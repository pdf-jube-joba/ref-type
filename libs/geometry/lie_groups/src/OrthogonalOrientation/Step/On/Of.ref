\use std.Logic[].Equality[].eq_reason_in;
\import Atlas.Cover[g := g] \as Cover;
\definition sign: Sign (Orientation.determinant g) := \block {
  \takefrom candidate: Cover.Candidate \by Cover.candidateExists \then
  \let q: Next.O := Flip.choice candidate.tag \then
  \let p: Coordinates.Parts := Coordinates.asPart (Coordinates.untranslate q g) candidate.admissible \then
  \let patchDeterminant: Orientation.determinant p = LowerOrientation.determinant (Coordinates.fiber p) := trans!{R.Real} _ _ _
    (sym!{R.Real} _ _ (congr!{{Next.O} R.Real} Orientation.determinant _ _ (Coordinates.reconstruct p)))
    (assemblyDeterminant (Coordinates.parameter p) (Coordinates.fiber p)) \then
  \let same: Orientation.determinant g = R.mul (Orientation.determinant q) (LowerOrientation.determinant (Coordinates.fiber p)) :=
    eq_reason_in!{R.Real _
      "=" _ "by" { sym!{R.Real} _ _ (congr!{{Next.O} R.Real} Orientation.determinant _ _ (Coordinates.translationUndo q g)) }
      "=" _ "by" { Orientation.multiplication q (Coordinates.untranslate q g) }
      "=" _ "by" { congr!{R.Real R.Real} (R.mul (Orientation.determinant q)) _ _ patchDeterminant }
    } \then
  \return \idelim R.mul (Orientation.determinant q) (LowerOrientation.determinant (Coordinates.fiber p)) = Orientation.determinant g
    \with x: R.Real => Sign x \by {
      base: signProduct (Orientation.determinant q) (LowerOrientation.determinant (Coordinates.fiber p)) (choiceSign candidate.tag) (previous (Coordinates.fiber p)),
      equality: sym!{R.Real} _ _ same
    }
};
