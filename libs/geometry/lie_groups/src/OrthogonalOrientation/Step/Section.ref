\use std.Logic[].Equality[].eq_reason_in;
\import Geometry.SphereSection[s := s] \as Coordinates;
\import Next.InnerProduct[].Normalization[v := Coordinates.nonzero] \as Normalized;
\import \parent.Reflection[v := Normalized.unit] \as Reflection;
\import \parent.First[] \as First;
\definition determinant: Orientation.determinant Coordinates.value = R.one := eq_reason_in!{R.Real _
  "=" _ "by" { Orientation.multiplication Normalized.reflection Flip.flip }
  "=" _ "by" { congr!{R.Real R.Real R.Real} R.mul _ _ _ _ Reflection.determinant First.determinant }
  "=" _ "by" { Arithmetic.fieldMulNegBoth R.one R.one }
  "=" _ "by" { Arithmetic.fieldMulOneLeft R.one }
};
