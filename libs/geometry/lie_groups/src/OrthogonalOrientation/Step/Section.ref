\import Geometry.SphereSection[s := s] \as Coordinates;
\import Next.InnerProduct[].Normalization[v := Coordinates.nonzero] \as Normalized;
\import \parent.Reflection[v := Normalized.unit] \as Reflection;
\import \parent.First[] \as First;
\definition determinant: Orientation.determinant Coordinates.value = R.one := trans!{R.Real} _ _ _
  (Orientation.multiplication Normalized.reflection Flip.flip)
  (trans!{R.Real} _ _ _ (congr2!{R.Real R.Real R.Real} R.mul _ _ _ _ Reflection.determinant First.determinant)
    (trans!{R.Real} _ _ _ (Arithmetic.fieldMulNegBoth R.one R.one) (Arithmetic.fieldMulOneLeft R.one)));
