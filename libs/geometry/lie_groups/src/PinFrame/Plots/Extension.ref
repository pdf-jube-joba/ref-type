\import Calculus.Step[n := n].On[previous := Calculus.operations n].At[U := U] \as Builder;
\import clifford.Euclidean[n := n].Successor[].NormalForm[].Operations[] \as AlgebraOperations;
\definition value[x: Open.Carrier U]: Next.Pin := Inclusion.pin (f x);
\definition plot: Higher.Plot U value := Builder.transfer (\fun (x: Open.Carrier U) => (f x).value)
  (\fun (x: Open.Carrier U) => Clifford.zero) (\fun (x: Open.Carrier U) => (value x).value)
  (\fun (x: Open.Carrier U) => AlgebraOperations.lower (f x).value) regular
  ((Calculus.operations n U).constant Clifford.zero);
