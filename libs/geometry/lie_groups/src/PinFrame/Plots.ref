/* Smoothness of the recursive Pin factors and their readings. */
\import std.Data[].FinSet[] \as Fin;
\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\import Smooth.Operations[] \as Functions;
\import \root.CliffordPlots[d := d] \as Calculus;
\import Calculus.Dimension[n := n] \as LowerAlgebra;
\import Calculus.Dimension[n := N.Nat^::succ n] \as HigherAlgebra;
\import E.Plots[d := d] \as Vectors;
\import E.PinPlots[d := d] \as Lower;
\import Next.Plots[d := d] \as Matrices;
\import Next.PinPlots[d := d] \as Higher;
\import clifford.Field[K := R.Real, field := Scalars.field].On[V := E.Vector, space := E.space].Of[form := E.form] \as Clifford;
\import clifford.Field[K := R.Real, field := Scalars.field].On[V := Next.Vector, space := Next.space].Of[form := Next.form] \as HigherClifford;
\import Next.InnerProduct[] \as InnerProduct;
\module Section(U: Open.OpenSet, s: Open.Carrier U -> E.Vector, regular: Vectors.Values U s);
\module Extension(U: Open.OpenSet, f: Open.Carrier U -> E.Pin, regular: Lower.Plot U f);
\module Read(U: Open.OpenSet, f: Open.Carrier U -> Parts, regular: Higher.Plot U (\fun (x: Open.Carrier U) => f x));
