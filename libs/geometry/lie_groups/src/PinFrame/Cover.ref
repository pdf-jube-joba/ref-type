\import Orthogonal.On[previous := \root.OrthogonalAtlas[].atlasData n].Cover[g := HigherRepresentation.map g] \as OrthogonalCover;
\structure Candidate: \Set := {
  tag: N.Nat^,
  admissible: Logic.Not (height (untranslate (Lifts.choice tag) g) = R.zero),
};
\definition image: \forall (tag: N.Nat^) -> HigherRepresentation.map (untranslate (Lifts.choice tag) g) =
  Orthogonal.untranslate (Orthogonal.Reflection[].choice tag) (HigherRepresentation.map g) := \fun (tag: N.Nat^) =>
  trans!{{Next.O}} _ _ _ (HigherRepresentation.multiplication (Group.inv (Lifts.choice tag)) g)
    (congr!{{Next.O} {Next.O}} (\fun (q: Next.O) => Isometries.mul q (HigherRepresentation.map g)) _ _
      (trans!{{Next.O}} _ _ _ (HigherRepresentation.inverseImage (Lifts.choice tag)) (congr!{{Next.O} {Next.O}} Isometries.inv _ _ (Lifts.choiceImage tag))));
\definition exists: \exists Candidate := \block {
  \takefrom c: OrthogonalCover.Candidate \by OrthogonalCover.candidateExists \then
  \return \exact(Candidate {
    tag := c.tag,
    admissible := \fun (zero: _) => c.admissible (trans!{R.Real} _ _ _
      (sym!{R.Real} _ _ (congr!{{Next.O} R.Real} Orthogonal.height _ _ (image c.tag))) zero),
  }, Candidate)
};
