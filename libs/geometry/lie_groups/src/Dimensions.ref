\import std.Data[].Nat[] \as N;
\import N.Basic[].Def[] \as Nat;
/* d(n+1) = n + d(n), the number of independent skew matrix entries. */
\definition orthogonal: N.Nat^ -> N.Nat^ := \induction (n: N.Nat^) \return N.Nat^ \with {
  | zero: N.Nat^::zero
  | succ: \fun (n, previous: N.Nat^) => Nat.add previous n
};
