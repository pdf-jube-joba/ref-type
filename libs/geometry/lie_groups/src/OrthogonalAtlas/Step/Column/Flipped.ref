\import Geometry.SphereCoordinates[v := flipped, nonzero := nonzero] \as Coordinates;
\import Geometry.SphereSection[s := Coordinates.parameter] \as Section;
\definition value: Next.O := Group.mul Flip.flip Section.value;
\definition firstColumn: value.value.apply first = v := trans!{Next.Vector} _ _ _
  (congr!{Next.Vector Next.Vector} Flip.flip.value.apply _ _ Coordinates.recovers) (Orthogonal.leftInverse Flip.flip v);
\definition exists: \exists Lifts := \exact(\into[Next.O](value, Lifts) \by { firstColumn }, Lifts);
