\import Geometry.SphereSection[s := E.space.zero] \as Reference;
\import Next.PinRepresentation[].Positive[v := Reference.firstUnit] \as Reflection;
\import R.Algebra[] \as Algebra;
\use Logic.either;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Arithmetic;
\import dedekind_reals.DedekindReal[] \as Order;
\definition flip: Next.O := Reflection.orthogonal;
\definition inverse: Group.inv flip = flip := \refl(flip);
\definition polar[x: Next.Vector]: R.Real := R.add (Next.dot first x) (Next.dot x first);
\definition polarValue: \forall (x: Next.Vector) -> polar x = R.add (Geometry.head x) (Geometry.head x) := \fun (x: Next.Vector) =>
  congr2!{R.Real R.Real R.Real} R.add _ _ _ _ (Geometry.firstDot x)
    (trans!{R.Real} _ _ _ (Next.symmetric x first) (Geometry.firstDot x));
\definition head: \forall (x: Next.Vector) -> Geometry.head (flip.value.apply x) = R.neg (Geometry.head x) := \fun (x: Next.Vector) =>
  trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (\fun (c: R.Real) => R.sub (Geometry.head x) (R.mul (polar x) c)) _ _ Geometry.firstHead)
    (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (R.sub (Geometry.head x)) _ _ (Algebra.mulOneRight (polar x)))
      (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (R.sub (Geometry.head x)) _ _ (polarValue x))
        (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (R.add (Geometry.head x)) _ _ (Arithmetic.negAdd (Geometry.head x) (Geometry.head x)))
          (trans!{R.Real} _ _ _ (sym!{R.Real} _ _ (Arithmetic.addAssoc (Geometry.head x) (R.neg (Geometry.head x)) (R.neg (Geometry.head x))))
            (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (\fun (c: R.Real) => R.add c (R.neg (Geometry.head x))) _ _ (Arithmetic.addNegRight (Geometry.head x)))
              (Arithmetic.addZeroLeft (R.neg (Geometry.head x))))))));
\definition complementary: \forall (g: Next.O) -> R.add (height g) (height (untranslate flip g)) = R.add R.one R.one := \fun (g: Next.O) =>
  trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (R.add (height g)) _ _
    (congr!{R.Real R.Real} (R.add R.one) _ _ (head (g.value.apply first))))
    (trans!{R.Real} _ _ _ (Algebra.addFour R.one (Geometry.head (g.value.apply first)) R.one (R.neg (Geometry.head (g.value.apply first))))
      (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} (R.add (R.add R.one R.one)) _ _ (Arithmetic.addNegRight (Geometry.head (g.value.apply first))))
        (Arithmetic.addZeroRight (R.add R.one R.one))));
\definition twoPositive: Order.Lt R.zero (R.add R.one R.one) := Order.ltLeTrans R.zero R.one (R.add R.one R.one) R.Estimates[].Product[].onePositive
  (Algebra.leAddRight R.one R.one (Order.Order[].leOfLt _ _ R.Estimates[].Product[].onePositive));
\definition twoNonzero: Logic.Not (R.add R.one R.one = R.zero) := R.Inverse[].positiveNonzero _ twoPositive;
\definition cannotBoth[g: Next.O][left: height g = R.zero][right: height (untranslate flip g) = R.zero]: Logic.False :=
  twoNonzero (trans!{R.Real} (R.add R.one R.one) (R.add (height g) (height (untranslate flip g))) R.zero
    (sym!{R.Real} _ _ (complementary g))
    (trans!{R.Real} _ (R.add R.zero R.zero) R.zero
      (congr2!{R.Real R.Real R.Real} R.add (height g) R.zero (height (untranslate flip g)) R.zero left right)
      (Arithmetic.addZeroLeft R.zero)));
\definition eitherHeight: \forall (g: Next.O) -> Logic.Or[Logic.Not (height g = R.zero), Logic.Not (height (untranslate flip g) = R.zero)] :=
  \fun (g: Next.O) => either!{{(std.Logic[].Classical[].excludedMiddle (height g = R.zero))}
    {Logic.Or[Logic.Not (height g = R.zero), Logic.Not (height (untranslate flip g) = R.zero)]}
    {\fun (zero: height g = R.zero) => Logic.Or[_, _]::right (\fun (other: height (untranslate flip g) = R.zero) => cannotBoth g zero other)}
    {\fun (nonzero: Logic.Not (height g = R.zero)) => Logic.Or[_, _]::left nonzero}
  };
\definition choice: N.Nat^ -> Next.O := \induction (k: N.Nat^) \return Next.O \with {
  | zero: Group.one
  | succ: \fun (k: N.Nat^)(_: Next.O) => flip
};
