\import \parent.Reflection[] \as Flip;
\import \root.Classical[].On[V := Next.Vector, space := Next.space].Orthogonal[form := Next.form] \as Orthogonal;
\use Logic.either;
\definition Lifts: \Set := \Cast[Next.O] ({ g: Next.O \where g.value.apply first = v });
\definition flipped: Geometry.Sphere := \into[Next.Vector](Flip.flip.value.apply v,
  { x: Next.Vector \where Next.dot x x = R.one }) \by {
    trans!{R.Real} _ _ _ (Orthogonal.preserves Flip.flip v v) (\bysub(Next.Vector, Geometry.Sphere, v))
  };
\module Direct(nonzero: Logic.Not (Flip.vectorHeight v = R.zero));
\module Flipped(nonzero: Logic.Not (Flip.vectorHeight flipped = R.zero));
\definition exists: \exists Lifts := either!{{(Flip.eitherVector v)} {\exists Lifts}
  {\fun (nonzero: Logic.Not (Flip.vectorHeight v = R.zero)) => Direct[nonzero := nonzero].exists}
  {\fun (nonzero: Logic.Not (Flip.vectorHeight flipped = R.zero)) => Flipped[nonzero := nonzero].exists}
};
