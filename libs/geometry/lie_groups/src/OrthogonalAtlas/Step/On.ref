\module Patch(i: N.Nat^);
\module Shift(i: N.Nat^, q: Next.O);
\import \parent.Reflection[] \as Reflection;
\import N.Pair[].Def[] \as Pair;
\import N.Pair[].Enumeration[] \as Pairs;
\import Next.Plots[d := Upper.dimension] \as Plots;
\definition charts[code: Pair.NatPair]: UpperCoordinates.Patch := Shift[i := Pair.natPairSecond code, q := Reflection.choice (Pair.natPairFirst code)].patch;
\definition patches[k: N.Nat^]: UpperCoordinates.Patch := charts (Pairs.enumerate k);
\module Cover(g: Next.O);
\definition family: UpperCoordinates.Family := UpperCoordinates.Family {
  patch := patches,
  covers := \fun (g: Next.O) => Cover[g := g].exists,
};
\module Readings(d: N.Nat^);
\definition data: Upper.Data := Upper.Data {
  family := family,
  parametrizations := \fun (k: N.Nat^) => Shift[i := Pair.natPairSecond (Pairs.enumerate k), q := Reflection.choice (Pair.natPairFirst (Pairs.enumerate k))].plot,
  readings := \fun (d: N.Nat^) => Readings[d := d].regular,
};
