\import Next.Plots[d := Upper.dimension] \as NextPlots;
\import E.Plots[d := Lower.dimension].Precomposition[e := Upper.dimension].On[U := image, V := lower.image,
  f := LowerCoordinates.value lower, h := Product.rightMap, regular := previous.parametrizations i] \as Fiber;
\import Geometry.Plots[d := Upper.dimension] \as GeometryPlots;
\definition parameterSmooth: \forall (j: Fin.Fin n) -> calculus.Real[].Multivariable[n := Upper.dimension].Open[].Smooth[].SmoothOn image
  (\fun (x: Parameter) => parameterValue x j) := \fun (j: Fin.Fin n) => Product.leftMap.smooth j;
\import GeometryPlots.Section[U := image, s := parameterValue, regular := parameterSmooth] \as Section;
\definition extension: NextPlots.Plot image (\fun (x: Parameter) => Geometry.Extension[h := lowerValue x].orthogonal) :=
  GeometryPlots.extension image lowerValue Fiber.plot;
\definition plot: NextPlots.Plot image value := NextPlots.multiplication image Section.value
  (\fun (x: Parameter) => Geometry.Extension[h := lowerValue x].orthogonal) Section.plot extension;
