/* The first-column patch over a fixed lower-dimensional coordinate chart. */
\definition lower: LowerCoordinates.Patch := previous.family.patch i;
\import Blocks.On[U := LeftOpen.whole, V := lower.image] \as Product;
\definition image: SourceOpen.OpenSet := Product.domain;
\definition Parameter: \Set := SourceOpen.Carrier image;
\structure Condition[g: Next.O]: \Prop := {
  nonzero: Logic.Not (height g = R.zero),
  contained: \In[E.O] lower.domain (fiber (asPart g nonzero)),
};
\definition domain: \Pow Next.O := { g: Next.O \where Condition[g] };
\definition Point: \Set := UpperCoordinates.Domain domain;
\definition parameterValue[x: Parameter]: E.Vector := Product.leftPoint x;
\definition lowerValue[x: Parameter]: E.O := lower.point (Product.rightPoint x);
\definition value[x: Parameter]: Next.O := assemble (parameterValue x) (lowerValue x);
\definition valueNonzero[x: Parameter]: Logic.Not (height (value x) = R.zero) := Geometry.SphereProduct[s := parameterValue x, h := lowerValue x].nonzero;
\definition recoveredParameter[x: Parameter]: parameter (asPart (value x) (valueNonzero x)) = parameterValue x :=
  Geometry.SphereProduct[s := parameterValue x, h := lowerValue x].recoversParameter;
\definition recoveredFiber[x: Parameter]: fiber (asPart (value x) (valueNonzero x)) = lowerValue x :=
  Geometry.SphereProduct[s := parameterValue x, h := lowerValue x].recoversFiber;
\definition point[x: Parameter]: Point := \into[Next.O](value x, domain) \by {
  Condition[value x] {
    nonzero := valueNonzero x,
    contained := \idelim lowerValue x = fiber (asPart (value x) (valueNonzero x)) \with g: E.O => \In[E.O] lower.domain g \by {
      base: \bysub(E.O, lower.domain, lower.point (Product.rightPoint x)),
      equality: sym!{{E.O}} _ _ (recoveredFiber x)
    },
  }
};
\definition part[g: Point]: Parts := asPart g (\bysub(Next.O, domain, g)).nonzero;
\definition lowerPoint[g: Point]: LowerCoordinates.Domain lower.domain := \into[E.O](fiber (part g), lower.domain) \by {
  (\bysub(Next.O, domain, g)).contained
};
\definition firstCoordinate[g: Point]: LeftOpen.Carrier LeftOpen.whole := \into[E.Vector](parameter (part g), LeftOpen.whole.points) \by {
  \refl(parameter (part g))
};
\definition coordinate[g: Point]: Parameter := Product.joinPoint (firstCoordinate g) (lower.coordinate (lowerPoint g));
\definition valueOnJoined: \forall (s: LeftOpen.Carrier LeftOpen.whole)(t: RightOpen.Carrier lower.image) ->
  value (Product.joinPoint s t) = assemble s (lower.point t) := \block {
  \fun (s: _)(t: _) \then
  \let headSame: parameterValue (Product.joinPoint s t) = s := Blocks.leftJoin s t \then
  \let tailSame: Product.rightPoint (Product.joinPoint s t) = t := Blocks.rightJoin s t \then
  \return congr2!{{E.Vector} {E.O} {Next.O}} assemble _ _ _ _ headSame
    (congr!{{RightOpen.Carrier lower.image} {LowerCoordinates.Domain lower.domain}} lower.point _ _ tailSame)
};
\definition pointCoordinate: \forall (g: Point) -> point (coordinate g) = g := \block {
  \fun (g: Point) \then
  \let lowerSame: lower.point (lower.coordinate (lowerPoint g)) = lowerPoint g := lower.pointCoordinate (lowerPoint g) \then
  \return trans!{{Next.O}} _ _ _ (valueOnJoined (firstCoordinate g) (lower.coordinate (lowerPoint g)))
    (trans!{{Next.O}} _ _ _ (congr!{{E.O} {Next.O}} (assemble (parameter (part g))) _ _ lowerSame) (reconstruct (part g)))
};
\definition coordinatePoint: \forall (x: Parameter) -> coordinate (point x) = x := \block {
  \fun (x: Parameter) \then
  \let lowerSame: lowerPoint (point x) = lower.point (Product.rightPoint x) := recoveredFiber x \then
  \let tailSame: lower.coordinate (lowerPoint (point x)) = Product.rightPoint x := trans!{{RightOpen.Carrier lower.image}} _ _ _
    (congr!{{LowerCoordinates.Domain lower.domain} {RightOpen.Carrier lower.image}} lower.coordinate _ _ lowerSame)
    (lower.coordinatePoint (Product.rightPoint x)) \then
  \return trans!{{FullVector}} _ _ _
    (congr2!{{E.Vector} {LowerVector} {FullVector}} Blocks.join _ _ _ _ (recoveredParameter x) tailSame) (Blocks.recover x)
};
\definition patch: UpperCoordinates.Patch := UpperCoordinates.Patch {
  domain := domain, image := image, point := point, coordinate := coordinate,
  pointCoordinate := pointCoordinate, coordinatePoint := coordinatePoint,
};
\module Smooth;
\module Reader(d: N.Nat^);
