\definition divided[x: Open.Carrier U]: Next.O := untranslate q (f x);
\definition dividedPlot: Plots.Plot U divided := Plots.multiplication U (\fun (x: Open.Carrier U) => Group.inv q) f
  (Plots.constant U (Group.inv q)) regular;
\import Base.Reader[d := d].On[U := U, f := divided, regular := dividedPlot, a := a, condition := inside] \as Reading;
\import UpperCoordinates.Read[d := d].On[p := Base.patch, U := U, f := divided, a := a] \as Reads;
\import UpperCoordinates.Read[d := d].On[p := patch, U := U, f := f, a := a] \as Result;
\module From(witness: Reads.Witness);
\definition exists: \exists Result.Witness := \block {
  \takefrom witness: Reads.Witness \by Reading.exists \then
  \return \exact(From[witness := witness].value, Result.Witness)
};
