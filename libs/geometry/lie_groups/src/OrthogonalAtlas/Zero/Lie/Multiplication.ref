\import manifolds.Dimension[n := k].Smooth[] \as Sources;
\module On(source: Sources.Manifold);
\definition smooth: \forall (source: Sources.Manifold) -> \root.Dimension[n := N.Nat^::zero].OnManifold[M := Geometry.manifold].Plots[group := E.orthogonalGroup, k := k].From[source := source].Condition :=
  \fun (source: Sources.Manifold) => On[source := source].smooth;
