\import \root.Smooth[n := k, m := N.Nat^::zero].Between[M := source, N := Geometry.manifold] \as Smooth;
\definition smooth: \forall (f, g: source.Point -> E.O) -> Smooth.IsSmooth f -> Smooth.IsSmooth g ->
  Smooth.IsSmooth (\fun (x: source.Point) => E.orthogonalGroup.op (f x) (g x)) :=
  \fun (f, g: _)(_: _)(_: _) => \idelim
    (\fun (x: source.Point) => E.orthogonalGroup.unit) = (\fun (x: source.Point) => E.orthogonalGroup.op (f x) (g x))
    \with h: (source.Point -> E.O) => Smooth.IsSmooth h \by {
      base: Smooth.Constant[c := E.orthogonalGroup.unit].smooth,
      equality: \axiom:funext((\fun (x: source.Point) => E.orthogonalGroup.unit), (\fun (x: source.Point) => E.orthogonalGroup.op (f x) (g x)),
        \fun (x: source.Point) => unique E.orthogonalGroup.unit (E.orthogonalGroup.op (f x) (g x)))
    };
