\import Atlas.On[data := data] \as Geometry;
\import \root.Dimension[n := N.Nat^::zero].OnManifold[M := Geometry.manifold] \as Groups;
\import \root.Smooth[n := N.Nat^::zero, m := N.Nat^::zero].Between[M := Geometry.manifold, N := Geometry.manifold] \as Smooth;
\definition inverseConstant: E.orthogonalGroup.inv = (\fun (x: E.O) => E.orthogonalGroup.unit) :=
  \axiom:funext(E.orthogonalGroup.inv, (\fun (x: E.O) => E.orthogonalGroup.unit), \fun (x: E.O) => unique (E.orthogonalGroup.inv x) E.orthogonalGroup.unit);
\definition inverseSmooth: Smooth.IsSmooth E.orthogonalGroup.inv := \idelim
  (\fun (x: E.O) => E.orthogonalGroup.unit) = E.orthogonalGroup.inv
  \with f: (E.O -> E.O) => Smooth.IsSmooth f \by {
    base: Smooth.Constant[c := E.orthogonalGroup.unit].smooth,
    equality: sym!{{E.O -> E.O}} _ _ inverseConstant
  };
\module Multiplication(k: N.Nat^);
\definition group: Groups.LieGroup := \into[std.Alg[].Alg[].Group[E.O]](E.orthogonalGroup,
  { group: std.Alg[].Alg[].Group[E.O] \where Groups.Laws[group] }) \by {
    Groups.Laws[E.orthogonalGroup] {
      inverse := inverseSmooth,
      multiplication := \fun (k: N.Nat^) => Multiplication[k := k].smooth,
    }
  };
