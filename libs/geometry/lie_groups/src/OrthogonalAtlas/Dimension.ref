\import \root.Euclidean[n := n] \as E;
\import E.Atlas[] \as Atlas;
\import Atlas.On[data := atlasData n] \as Geometry;
\import manifolds.Dimension[n := Atlas.dimension].Smooth[] \as Model;
\definition manifold: Model.Manifold := Geometry.manifold;
\definition group: std.Alg[].Alg[].Group[E.O] := E.orthogonalGroup;
\import \root.Dimension[n := Atlas.dimension].OnManifold[M := manifold] \as Groups;
\definition lieGroup: Groups.LieGroup := Geometry.Lie[].group;
