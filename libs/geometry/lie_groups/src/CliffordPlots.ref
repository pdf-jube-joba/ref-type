/* Smooth families in Clifford algebras, detected by scalar coefficients. */
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import real.Analysis[] \as R;
\import R.Algebra[] \as Scalars;
\import clifford.EuclideanCoordinates[] \as Coordinates;
\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\import Smooth.Operations[] \as Functions;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\definition smoothEqual[U: Open.OpenSet][f, g: Open.ScalarFunction U][same: \forall (x: Open.Carrier U) -> f x = g x]:
  Smooth.SmoothOn U f -> Smooth.SmoothOn U g := \fun (regular: _) => \idelim f = g
    \with h: Open.ScalarFunction U => Smooth.SmoothOn U h \by { base: regular, equality: \axiom:funext(f, g, same) };
\module Dimension(n: N.Nat^);
\definition All[n: N.Nat^]: \Prop := \forall (U: Open.OpenSet) -> Dimension[n := n].Laws[U];
\module Zero;
\module Step(n: N.Nat^);
\definition operations: \forall (n: N.Nat^) -> All n := \induction (n: N.Nat^) \return All n \with {
  | zero: Zero[].laws
  | succ: \fun (n: N.Nat^)(previous: All n) => Step[n := n].On[previous := previous].laws
};
\module VectorProjection;
