\use std.Logic[].Equality[].eq_reason_in;
/* Recursive local product coordinates for Euclidean Pin groups. */
\import std.Data[].Nat[] \as N;
\import real.Analysis[] \as R;
\import R.Algebra[] \as Scalars;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Logic.either;
\import \root.Euclidean[n := n] \as E;
\import \root.Euclidean[n := N.Nat^::succ n] \as Next;
\import E.SuccessorGeometry[] \as Geometry;
\import E.PinRepresentation[] \as Representation;
\import Next.PinRepresentation[] \as HigherRepresentation;
\import \root.OrthogonalAtlas[].Step[n := n] \as Orthogonal;
\import \root.PinSurjectivity[].Step[n := n] \as Lifts;
\import clifford.Euclidean[n := n].Successor[].Inclusion[] \as Embedding;
\import Embedding.Groups[] \as Inclusion;
\import clifford.Euclidean[n := n].Successor[].NormalForm[].Representation[] \as Recovery;
\import clifford.Field[K := R.Real, field := Scalars.field].On[V := E.Vector, space := E.space].Of[form := E.form].Pin[] \as LowerPin;
\import clifford.Field[K := R.Real, field := Scalars.field].On[V := Next.Vector, space := Next.space].Of[form := Next.form].Pin[] \as HigherPin;
\import algebra.Groups[].On[G := E.Pin, group := E.pinGroup] \as LowerGroup;
\import algebra.Groups[].On[G := Next.Pin, group := Next.pinGroup] \as Group;
\import algebra.Groups[].On[G := Next.O, group := Next.orthogonalGroup] \as Isometries;
\import algebra.Groups[].Units[A := E.CliffordAlgebra, ring := clifford.Euclidean[n := n].ring] \as LowerUnits;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Arithmetic;
\definition height[g: Next.Pin]: R.Real := Orthogonal.height (HigherRepresentation.map g);
\definition Admissible: \Pow Next.Pin := { g: Next.Pin \where Logic.Not (height g = R.zero) };
\definition Parts: \Set := \Cast[Next.Pin] Admissible;
\definition asPart[g: Next.Pin][nonzero: Logic.Not (height g = R.zero)]: Parts := \into[Next.Pin](g, Admissible) \by { nonzero };
\definition nonzero[g: Parts]: Logic.Not (height g = R.zero) := \bysub(Next.Pin, Admissible, g);
\definition parameterValue[g: Next.O]: E.Vector := E.space.smul (Arithmetic.fieldInv (Orthogonal.height g)) (Geometry.tail (g.value.apply Geometry.first));
\definition section[s: E.Vector]: Next.Pin := Lifts.Section[s := s].value;
\definition sectionImage[s: E.Vector]: HigherRepresentation.map (section s) = Geometry.SphereSection[s := s].value := Lifts.Section[s := s].image;
\definition assemble[s: E.Vector][h: E.Pin]: Next.Pin := Group.mul (section s) (Inclusion.pin h);
\definition assemblyImage[s: E.Vector][h: E.Pin]: HigherRepresentation.map (assemble s h) = Orthogonal.assemble s (Representation.map h) :=
  trans!{{Next.O}} _ _ _ (HigherRepresentation.multiplication (section s) (Inclusion.pin h))
    (congr!{{Next.O} {Next.O} {Next.O}} Isometries.mul _ _ _ _ (sectionImage s) (Geometry.PinExtension[g := h].law));
\definition translate[q, g: Next.Pin]: Next.Pin := Group.mul q g;
\definition untranslate[q, g: Next.Pin]: Next.Pin := Group.mul (Group.inv q) g;
\definition undoTranslation: \forall (q, g: Next.Pin) -> untranslate q (translate q g) = g := \fun (q, g: Next.Pin) =>
  eq_reason_in!{{Next.Pin} _
    "=" _ "by" { sym!{{Next.Pin}} _ _ (Group.assoc (Group.inv q) q g) }
    "=" _ "by" { congr!{{Next.Pin} {Next.Pin}} (\fun (x: Next.Pin) => Group.mul x g) _ _ (Group.invLeft q) }
    "=" _ "by" { Group.oneLeft g }
  };
\definition translationUndo: \forall (q, g: Next.Pin) -> translate q (untranslate q g) = g := \fun (q, g: Next.Pin) =>
  eq_reason_in!{{Next.Pin} _
    "=" _ "by" { sym!{{Next.Pin}} _ _ (Group.assoc q (Group.inv q) g) }
    "=" _ "by" { congr!{{Next.Pin} {Next.Pin}} (\fun (x: Next.Pin) => Group.mul x g) _ _ (Group.invRight q) }
    "=" _ "by" { Group.oneLeft g }
  };
\definition inclusionInjective: \forall (g, h: E.Pin) -> Inclusion.pin g = Inclusion.pin h -> g = h :=
  \fun (g, h: E.Pin)(same: _) => LowerUnits.ext g h (eq_reason_in!{E.CliffordAlgebra _
    "=" _ "by" { sym!{E.CliffordAlgebra} _ _ (Recovery.firstLower g.value) }
    "=" _ "by" { congr!{Next.CliffordAlgebra E.CliffordAlgebra} Recovery.left _ _
      (congr!{{Next.Pin} Next.CliffordAlgebra} (\fun (p: Next.Pin) => p.value) _ _ same) }
    "=" _ "by" { Recovery.firstLower h.value }
  });
\module On(g: Parts);
\definition parameter[g: Parts]: E.Vector := On[g := g].parameter;
\definition fiber[g: Parts]: E.Pin := On[g := g].fiber;
\definition reconstruct[g: Parts]: assemble (parameter g) (fiber g) = g := On[g := g].reconstruct;
\module Assembly(s: E.Vector, h: E.Pin);
\module Cover(g: Next.Pin);
\module Plots(d: N.Nat^);
