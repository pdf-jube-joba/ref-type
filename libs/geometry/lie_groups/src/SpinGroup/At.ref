\definition fixed: grading g = g := Parity.fixedWhenEven g even;
\definition different: Logic.Not (grading g = negative g) := \fun (same: _) => Parity.unitNonzero g
  (Vectors.oppositeSelfZero R.half g.value R.Estimates[].halfDouble
    (trans!{E.CliffordAlgebra} _ _ _ (sym!{E.CliffordAlgebra} _ _ (congr!{{E.Pin} E.CliffordAlgebra} (\fun (h: E.Pin) => h.value) _ _ fixed))
      (trans!{E.CliffordAlgebra} _ _ _ (congr!{{E.Pin} E.CliffordAlgebra} (\fun (h: E.Pin) => h.value) _ _ same) (Grading.minusValue g))));
