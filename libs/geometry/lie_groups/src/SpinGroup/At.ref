\use std.Logic[].Equality[].eq_reason_in;
\definition fixed: grading g = g := Parity.fixedWhenEven g even;
\definition different: Logic.Not (grading g = negative g) := \fun (same: _) => Parity.unitNonzero g
  (Vectors.oppositeSelfZero R.half g.value R.Estimates[].halfDouble
    (eq_reason_in!{E.CliffordAlgebra _
      "=" _ "by" { sym!{E.CliffordAlgebra} _ _ (congr!{{E.Pin} E.CliffordAlgebra} (\fun (h: E.Pin) => h.value) _ _ fixed) }
      "=" _ "by" { congr!{{E.Pin} E.CliffordAlgebra} (\fun (h: E.Pin) => h.value) _ _ same }
      "=" _ "by" { Grading.minusValue g }
    }));
