/* Recursive standard local coordinates on the real orthogonal groups. */
\import std.Data[].Nat[] \as N;
\module Zero;
\module Step(n: N.Nat^);
\definition Data[n: N.Nat^]: \Set := \root.Euclidean[n := n].Atlas[].Data;
\definition atlasData: \forall (n: N.Nat^) -> Data n := \induction (n: N.Nat^) \return Data n \with {
  | zero: Zero[].data
  | succ: \fun (n: N.Nat^)(previous: Data n) => Step[n := n].On[previous := previous].data
};
\module Dimension(n: N.Nat^);
