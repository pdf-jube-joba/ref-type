\import manifolds.SmoothMap[n := n, m := m].Between[M := M, N := N] \as Maps;
\definition Function: \Set := M.Point -> N.Point;
\definition WithFunction[f: Function]: \Set := \Cast[Maps.Map] ({ map: Maps.Map \where Maps.apply map = f });
\definition IsSmooth[f: Function]: \Prop := \exists WithFunction f;
\definition uniqueness: \forall (f: Function)(left, right: WithFunction f) -> left = right :=
  \fun (f: Function)(left, right: WithFunction f) => Maps.ext left right (trans!{Function} _ _ _
    (\bysub(Maps.Map, WithFunction f, left)) (sym!{Function} _ _ (\bysub(Maps.Map, WithFunction f, right))));
\definition chosen[f: Function][smooth: IsSmooth f]: WithFunction f :=
  \choice WithFunction f \by { existence: smooth, uniqueness: uniqueness f };
\definition map[f: Function][smooth: IsSmooth f]: Maps.Map := chosen f smooth;
\definition applyChosen: \forall (f: Function)(smooth: IsSmooth f) -> Maps.apply (map f smooth) = f :=
  \fun (f: Function)(smooth: IsSmooth f) => \bysub(Maps.Map, WithFunction f, chosen f smooth);
\definition ofMap: \forall (f: Maps.Map) -> IsSmooth (Maps.apply f) :=
  \fun (f: Maps.Map) => \exact(\into[Maps.Map](f, WithFunction (Maps.apply f)) \by { \refl(Maps.apply f) }, WithFunction (Maps.apply f));
\module Constant(c: N.Point);
