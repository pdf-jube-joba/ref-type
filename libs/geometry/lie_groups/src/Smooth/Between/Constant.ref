\import topology.Maps[A := M.Point, B := N.Point] \as Topology;
\import manifolds.Dimension[n := n].Chart[M := M.Point, space := M.space] \as SourceCharts;
\import manifolds.Dimension[n := m].Chart[M := N.Point, space := N.space] \as TargetCharts;
\import std.Logic[].Classical[] \as Classical;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import Open.Smooth[] \as Analysis;
\import Analysis.Operations[] \as Operations;
\import real.Analysis[] \as Reals;
\import std.Data[].FinSet[] \as Fin;
\definition data: Maps.Data := Maps.Data { apply := \fun (x: M.Point) => c };
\definition continuous: Maps.ContinuousMap := \into[Maps.Data](data, { f: Maps.Data \where Maps.Continuous f }) \by {
  Topology.constantContinuous M.space N.space c
};
\module Coordinates(left: SourceCharts.Chart, right: TargetCharts.Chart);
\definition regular: Maps.Chartwise continuous :=
  \fun (left: SourceCharts.Chart)(right: TargetCharts.Chart)(hl: _)(hr: _) => Coordinates[left := left, right := right].regular;
\definition map: Maps.Map := \into[Maps.ContinuousMap](continuous, { f: Maps.ContinuousMap \where Maps.Chartwise f }) \by { regular };
\definition smooth: IsSmooth (\fun (x: M.Point) => c) := ofMap map;
