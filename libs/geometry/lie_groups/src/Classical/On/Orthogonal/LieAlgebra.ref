\use std.Logic[].Equality[].eq_reason_in;
\import Spaces.Laws[V := V, space := space] \as Vectors;
\import Spaces.Laws[V := R.Real, space := Spaces.scalarSpace] \as ScalarLaws;
\import algebra.Group[].Of[Carrier := R.Real, group := std.Alg[].Ring[].ringModuleAsCommutativeGroup R.Real R.Real Spaces.ring Spaces.scalarSpace] \as Sum;
\import algebra.Group[].Of[Carrier := V, group := std.Alg[].Ring[].ringModuleAsCommutativeGroup R.Real V Spaces.ring space] \as VectorSum;
\import Spaces.Linear[V := V, W := R.Real, source := space, target := Spaces.scalarSpace] \as Functionals;
\import Functionals.Operations[] \as FunctionalOperations;
\definition right[y: V]: Functionals.Map := Functionals.Map {
  apply := \fun (x: V) => form.form x y,
  preservesAdd := \fun (x, z: V) => form.addLeft x z y,
  preservesScale := \fun (a: R.Real)(x: V) => form.scaleLeft a x y,
};
\definition left[x: V]: Functionals.Map := Functionals.Map {
  apply := form.form x,
  preservesAdd := form.addRight x,
  preservesScale := \fun (a: R.Real)(y: V) => form.scaleRight a x y,
};
\definition mapDifference: \forall (f: Functionals.Map)(x, y: V) -> f.apply (VectorSum.difference x y) = Sum.difference (f.apply x) (f.apply y) :=
  \fun (f: Functionals.Map)(x, y: V) => trans!{R.Real} _ _ _ (f.preservesAdd x (space.neg y))
    (congr!{R.Real R.Real} (R.add (f.apply x)) _ _ (FunctionalOperations.preservesNeg f y));
\definition Skew[A: End.Carrier]: \Prop := \forall (x, y: V) -> form.form (A.apply x) y = R.neg (form.form x (A.apply y));
\import Spaces.Subspace[V := End.Carrier, space := End.vectorSpace] \as Subspaces;
\definition subspace: Subspaces.Subspace := Subspaces.Subspace {
  carrier := { A: End.Carrier \where Skew A },
  containsZero := \fun (x, y: V) => trans!{R.Real} _ _ _ (form.zeroLeft y)
    (sym!{R.Real} _ _ (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} R.neg _ _ (form.zeroRight x)) Sum.negZero)),
  closedAdd := \fun (A, B: End.Carrier)(ha: Skew A)(hb: Skew B)(x, y: V) => eq_reason_in!{R.Real _
    "=" _ "by" { form.addLeft (A.apply x) (B.apply x) y }
    "=" _ "by" { congr!{R.Real R.Real R.Real} R.add _ _ _ _ (ha x y) (hb x y) }
    "=" _ "by" { sym!{R.Real} _ _ (Sum.negAdd (form.form x (A.apply y)) (form.form x (B.apply y))) }
    "=" _ "by" { congr!{R.Real R.Real} R.neg _ _ (sym!{R.Real} _ _ (form.addRight x (A.apply y) (B.apply y))) }
  },
  closedScale := \fun (a: R.Real)(A: End.Carrier)(ha: Skew A)(x, y: V) => eq_reason_in!{R.Real _
    "=" _ "by" { form.scaleLeft a (A.apply x) y }
    "=" _ "by" { congr!{R.Real R.Real} (R.mul a) _ _ (ha x y) }
    "=" _ "by" { ScalarLaws.scaleNegative a (form.form x (A.apply y)) }
    "=" _ "by" { congr!{R.Real R.Real} R.neg _ _ (sym!{R.Real} _ _ (form.scaleRight a x (A.apply y))) }
  },
};
\import lie_algebras.Field[K := R.Real, field := Scalars.field] \as Lie;
\import Lie.Associative[A := End.Carrier, algebra := End.algebra] \as Commutator;
\import Lie.On[V := End.Carrier, space := End.vectorSpace, lie := End.lie] \as AmbientLie;
\definition bracketApply: \forall (A, B: End.Carrier)(x: V) -> (Commutator.bracket A B).apply x =
  VectorSum.difference (A.apply (B.apply x)) (B.apply (A.apply x)) :=
  \fun (A, B: End.Carrier)(x: V) => congr!{V V} (space.add (A.apply (B.apply x))) _ _ (Vectors.minusOneScale (B.apply (A.apply x)));
\definition doubleSkew: \forall (A, B: End.Carrier) -> Skew A -> Skew B -> \forall (x, y: V) ->
  form.form (A.apply (B.apply x)) y = form.form x (B.apply (A.apply y)) :=
  \fun (A, B: End.Carrier)(ha: Skew A)(hb: Skew B)(x, y: V) => eq_reason_in!{R.Real _
    "=" _ "by" { ha (B.apply x) y }
    "=" _ "by" { congr!{R.Real R.Real} R.neg _ _ (hb x (A.apply y)) }
    "=" _ "by" { Sum.negNeg _ }
  };
\definition negateDifference: \forall (a, b: R.Real) -> R.neg (Sum.difference a b) = Sum.difference b a :=
  \fun (a, b: R.Real) => eq_reason_in!{R.Real _
    "=" _ "by" { Sum.negAdd a (R.neg b) }
    "=" _ "by" { congr!{R.Real R.Real} (R.add (R.neg a)) _ _ (Sum.negNeg b) }
    "=" _ "by" { Sum.comm (R.neg a) b }
  };
\definition closedBracket: \forall (A, B: End.Carrier) -> Skew A -> Skew B -> Skew (Commutator.bracket A B) :=
  \fun (A, B: End.Carrier)(ha: Skew A)(hb: Skew B)(x, y: V) => eq_reason!{
    {form.form ((Commutator.bracket A B).apply x) y}
    "=" {form.form (VectorSum.difference (A.apply (B.apply x)) (B.apply (A.apply x))) y} "by" {
      congr!{V R.Real} (\fun (v: V) => form.form v y) _ _ (bracketApply A B x)}
    "=" {Sum.difference (form.form (A.apply (B.apply x)) y) (form.form (B.apply (A.apply x)) y)} "by" {
      mapDifference (right y) (A.apply (B.apply x)) (B.apply (A.apply x))}
    "=" {Sum.difference (form.form x (B.apply (A.apply y))) (form.form x (A.apply (B.apply y)))} "by" {
      congr!{R.Real R.Real R.Real} Sum.difference _ _ _ _ (doubleSkew A B ha hb x y) (doubleSkew B A hb ha x y)}
    "=" {R.neg (Sum.difference (form.form x (A.apply (B.apply y))) (form.form x (B.apply (A.apply y))))} "by" {
      sym!{R.Real} _ _ (negateDifference _ _)}
    "=" {R.neg (form.form x (VectorSum.difference (A.apply (B.apply y)) (B.apply (A.apply y))))} "by" {
      congr!{R.Real R.Real} R.neg _ _ (sym!{R.Real} _ _ (mapDifference (left x) (A.apply (B.apply y)) (B.apply (A.apply y))))}
    "=" {R.neg (form.form x ((Commutator.bracket A B).apply y))} "by" {
      congr!{V R.Real} (\fun (v: V) => R.neg (form.form x v)) _ _ (sym!{V} _ _ (bracketApply A B y))}
  };
\definition subalgebra: AmbientLie.Subalgebra := AmbientLie.Subalgebra {
  subspace := subspace, closedBracket := closedBracket,
};
\import AmbientLie.Of[subalgebra := subalgebra] \as Restricted;
\definition Carrier: \Set := Restricted.Carrier;
\definition vectorSpace: Spaces.VectorSpace Carrier := Restricted.vectorSpace;
\definition lie: Lie.LieAlgebra Carrier vectorSpace := Restricted.algebra;
