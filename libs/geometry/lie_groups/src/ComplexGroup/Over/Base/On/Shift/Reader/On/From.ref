\definition value: Result.Witness := Result.Witness {
  domain := witness.domain, included := witness.included, contains := witness.contains, lift := witness.lift,
  agrees := \fun (x: Open.Carrier witness.domain) => trans!{{Carrier}} _ _ _
    (congr!{{Carrier} {Carrier}} (translate q) _ _ (witness.agrees x))
    (translationUndo q (f (Open.inclusion witness.domain U witness.included x))),
};
