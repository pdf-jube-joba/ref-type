
\import Lower.Plots[d := dimension].Precomposition[e := fullDimension].On[U := image, V := lower.image,
  f := LowerCoordinates.value lower, h := Product.rightMap, regular := previous.parametrizations i] \as Fiber;
\import Geometry.Plots[d := fullDimension] \as GeometryPlots;
\definition parameterSmooth: \forall (j: Fin.Fin Phase.one) -> calculus.Real[].Multivariable[n := fullDimension].Open[].Smooth[].SmoothOn image
  (\fun (x: Parameter) => parameterValue x j) := \fun (j: Fin.Fin Phase.one) => Product.leftMap.smooth j;
\import GeometryPlots.Assemble[U := image, s := parameterValue, g := lowerValue, parameters := parameterSmooth, regular := Fiber.plot] \as Assembly;
\definition plot: GeometryPlots.Plot image value := Assembly.plot;
