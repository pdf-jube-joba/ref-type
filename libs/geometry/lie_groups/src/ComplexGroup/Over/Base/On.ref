\module Patch(i: N.Nat^);
\module Shift(i: N.Nat^, q: Carrier);
\import Geometry.Shifts[] \as Reflection;
\import N.Pair[].Def[] \as Pair;
\import N.Pair[].Enumeration[] \as Pairs;
\import Geometry.Plots[d := fullDimension] \as Plots;
\definition charts[code: Pair.NatPair]: UpperCoordinates.Patch := Shift[i := Pair.natPairSecond code, q := Reflection.choice (Pair.natPairFirst code)].patch;
\definition patches[k: N.Nat^]: UpperCoordinates.Patch := charts (Pairs.enumerate k);
\module Cover(g: Carrier);
\definition family: UpperCoordinates.Family := UpperCoordinates.Family {
  patch := patches,
  covers := \fun (g: Carrier) => Cover[g := g].exists,
};
\module Readings(d: N.Nat^);
\definition data: Upper.Data := Upper.Data {
  family := family,
  parametrizations := \fun (k: N.Nat^) => Shift[i := Pair.natPairSecond (Pairs.enumerate k), q := Reflection.choice (Pair.natPairFirst (Pairs.enumerate k))].plot,
  readings := \fun (d: N.Nat^) => Readings[d := d].regular,
};

\import Upper.On[data := data] \as Manifold;
\import manifolds.Dimension[n := fullDimension].Smooth[] \as Model;
\definition manifold: Model.Manifold := Manifold.manifold;
\definition operations: Upper.Operations[Extension.group] := Upper.Operations[Extension.group] {
  inverse := \fun (d: N.Nat^) => Geometry.Plots[d := d].inverse,
  multiplication := \fun (d: N.Nat^) => Geometry.Plots[d := d].multiplication,
};
\definition lieGroup: \root.Dimension[n := fullDimension].OnManifold[M := manifold].LieGroup := Manifold.Lie[group := Extension.group, regular := operations].value;
