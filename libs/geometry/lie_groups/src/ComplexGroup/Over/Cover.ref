
\import \parent.Shifts[] \as Shifts;
\structure Candidate: \Set := {
  tag: N.Nat^,
  admissible: Logic.Not (height (untranslate (Shifts.choice tag) g) = R.zero),
};
\definition exists: \exists Candidate := either!{{(std.Logic[].Classical[].excludedMiddle (height g = R.zero))} {\exists Candidate}
  {\fun (zero: height g = R.zero) => \exact(Candidate {
    tag := N.Nat^::succ N.Nat^::zero,
    admissible := \fun (other: _) => Shifts.cannotBoth g zero other,
  }, Candidate)}
  {\fun (nonzero: Logic.Not (height g = R.zero)) => \exact(Candidate {
    tag := N.Nat^::zero,
    admissible := \fun (zero: _) => nonzero (trans!{R.Real} _ _ _
      (sym!{R.Real} _ _ (congr!{Carrier R.Real} height _ _ (Shifts.untranslateOne g))) zero),
  }, Candidate)}
};
