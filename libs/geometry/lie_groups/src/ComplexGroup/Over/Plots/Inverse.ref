
\definition a[x: Open.Carrier U]: E.Carrier := Representation.first (Rep.image (f x));
\definition b[x: Open.Carrier U]: E.Carrier := Representation.second (Rep.image (f x));
\definition laws: CliffordPlots.Laws[U] := Calculus.operations n U;
\definition realPlot: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Representation.first (Rep.image (Group.inv (f x)))) := CliffordPlots.congruent U
  (\fun (x: Open.Carrier U) => Representation.first (Algebra.inverse (Rep.image (f x)))) (\fun (x: Open.Carrier U) => Representation.first (Rep.image (Group.inv (f x))))
  (\fun (x: Open.Carrier U) => congr!{Representation.CarrierPair E.Carrier} Representation.first _ _ (sym!{Representation.CarrierPair} _ _ (Algebra.inversion (f x))))
  (laws.reversion a (real U f regular));
\definition imaginaryPlot: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Representation.second (Rep.image (Group.inv (f x)))) := CliffordPlots.congruent U
  (\fun (x: Open.Carrier U) => Representation.second (Algebra.inverse (Rep.image (f x)))) (\fun (x: Open.Carrier U) => Representation.second (Rep.image (Group.inv (f x))))
  (\fun (x: Open.Carrier U) => congr!{Representation.CarrierPair E.Carrier} Representation.second _ _ (sym!{Representation.CarrierPair} _ _ (Algebra.inversion (f x))))
  (laws.negative (\fun (x: Open.Carrier U) => Reverse.map (b x)) (laws.reversion b (imaginary U f regular)));
\definition plot: Plot U (\fun (x: Open.Carrier U) => Group.inv (f x)) := fromComponents U (\fun (x: Open.Carrier U) => Group.inv (f x)) realPlot imaginaryPlot;
