
\import calculus.Identity[n := d].Between[U := U, V := V] \as Inclusion;
\import \parent.Precomposition[e := d].On[U := U, V := V, f := f, h := Inclusion.map included, regular := regular] \as Pullback;
\definition value[x: Open.Carrier U]: Carrier := f (Open.inclusion U V included x);
\definition plot: Plot U value := Pullback.plot;
