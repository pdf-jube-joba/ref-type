
\import Maps.Composition[U := U, V := V, f := h] \as Composition;
\definition value[x: Source.Carrier U]: Carrier := f (Maps.apply U V h x);
\definition component[i: ComplexCoefficients.Index]: Functions.Function V := \into[Open.ScalarFunction V](
  (\fun (x: Open.Carrier V) => ComplexCoefficients.coefficient i (f x)),
  { g: Open.ScalarFunction V \where Smooth.SmoothOn V g }) \by { regular i };
\definition plot: \forall (i: ComplexCoefficients.Index) -> SourceSmooth.SmoothOn U
  (\fun (x: Source.Carrier U) => ComplexCoefficients.coefficient i (value x)) := \fun (i: ComplexCoefficients.Index) => Composition.smooth (component i);
