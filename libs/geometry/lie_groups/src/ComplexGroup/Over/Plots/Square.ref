
\definition a[x: Open.Carrier U]: E.Carrier := Representation.first (Rep.image (f x));
\definition b[x: Open.Carrier U]: E.Carrier := Representation.second (Rep.image (f x));
\definition laws: CliffordPlots.Laws[U] := Calculus.operations n U;
\definition ra: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Reverse.map (a x)) := laws.reversion a (real U f regular);
\definition rb: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Reverse.map (b x)) := laws.reversion b (imaginary U f regular);
\definition aa: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Clifford.mul (Reverse.map (a x)) (a x)) := laws.multiplication _ _ ra (real U f regular);
\definition bb: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Clifford.mul (Reverse.map (b x)) (b x)) := laws.multiplication _ _ rb (imaginary U f regular);
\definition ab: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Clifford.mul (Reverse.map (a x)) (b x)) := laws.multiplication _ _ ra (imaginary U f regular);
\definition ba: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Clifford.mul (Reverse.map (b x)) (a x)) := laws.multiplication _ _ rb (real U f regular);
\definition realRegular: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Squared.realQuadratic (Rep.image (f x))) := laws.addition _ _ aa (laws.negative _ bb);
\definition imaginaryRegular: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Squared.imaginaryQuadratic (Rep.image (f x))) := laws.addition _ _ ab ba;
\definition realSmooth: Smooth.SmoothOn U (\fun (x: Open.Carrier U) => C.re (Squared.base (f x))) := Calculus.smoothEqual U
  (\fun (x: Open.Carrier U) => Coefficients.ScalarPart[].read n (Squared.realQuadratic (Rep.image (f x)))) _
  (\fun (x: Open.Carrier U) => Squared.realFormula (f x)) (realRegular (Coefficients.ScalarPart[].first n));
\definition imaginarySmooth: Smooth.SmoothOn U (\fun (x: Open.Carrier U) => C.im (Squared.base (f x))) := Calculus.smoothEqual U
  (\fun (x: Open.Carrier U) => Coefficients.ScalarPart[].read n (Squared.imaginaryQuadratic (Rep.image (f x)))) _
  (\fun (x: Open.Carrier U) => Squared.imaginaryFormula (f x)) (imaginaryRegular (Coefficients.ScalarPart[].first n));
\definition heightSmooth: Smooth.SmoothOn U (\fun (x: Open.Carrier U) => height (f x)) := Functions.addSmooth U _ _ (Functions.constantSmooth U R.one) realSmooth;
