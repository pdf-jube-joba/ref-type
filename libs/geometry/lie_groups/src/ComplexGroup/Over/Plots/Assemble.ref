
\import Phase.Plots[d := d].Phase[U := U, s := s, regular := parameters] \as Root;
\definition value[x: Open.Carrier U]: Carrier := assemble (s x) (g x);
\definition realPlot: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Representation.first (Rep.image (value x))) := CliffordPlots.congruent U
  (\fun (x: Open.Carrier U) => Clifford.scale (C.re (Phase.phase (s x))) (Rep.value (g x))) _
  (\fun (x: Open.Carrier U) => sym!{E.Carrier} _ _ (congr!{Representation.CarrierPair E.Carrier} Representation.first _ _ (Rep.onClass (g x) (Phase.phase (s x)))))
  (scale U _ _ Root.real regular);
\definition imaginaryPlot: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Representation.second (Rep.image (value x))) := CliffordPlots.congruent U
  (\fun (x: Open.Carrier U) => Clifford.scale (C.im (Phase.phase (s x))) (Rep.value (g x))) _
  (\fun (x: Open.Carrier U) => sym!{E.Carrier} _ _ (congr!{Representation.CarrierPair E.Carrier} Representation.second _ _ (Rep.onClass (g x) (Phase.phase (s x)))))
  (scale U _ _ Root.imaginary regular);
\definition plot: Plot U value := fromComponents U value realPlot imaginaryPlot;
