
\definition a[x: Open.Carrier U]: E.Carrier := Representation.first (Rep.image (f x));
\definition b[x: Open.Carrier U]: E.Carrier := Representation.second (Rep.image (f x));
\definition c[x: Open.Carrier U]: E.Carrier := Representation.first (Rep.image (g x));
\definition e[x: Open.Carrier U]: E.Carrier := Representation.second (Rep.image (g x));
\definition laws: CliffordPlots.Laws[U] := Calculus.operations n U;
\definition ac: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Clifford.mul (a x) (c x)) := laws.multiplication a c (real U f left) (real U g right);
\definition be: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Clifford.mul (b x) (e x)) := laws.multiplication b e (imaginary U f left) (imaginary U g right);
\definition ae: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Clifford.mul (a x) (e x)) := laws.multiplication a e (real U f left) (imaginary U g right);
\definition bc: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Clifford.mul (b x) (c x)) := laws.multiplication b c (imaginary U f left) (real U g right);
\definition realPlot: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Representation.first (Rep.image (Group.mul (f x) (g x)))) := CliffordPlots.congruent U
  (\fun (x: Open.Carrier U) => Representation.first (Algebra.product (Rep.image (f x)) (Rep.image (g x))))
  (\fun (x: Open.Carrier U) => Representation.first (Rep.image (Group.mul (f x) (g x))))
  (\fun (x: Open.Carrier U) => congr!{Representation.CarrierPair E.Carrier} Representation.first _ _ (sym!{Representation.CarrierPair} _ _ (Algebra.multiplication (f x) (g x))))
  (laws.addition (\fun (x: Open.Carrier U) => Clifford.mul (a x) (c x)) (\fun (x: Open.Carrier U) => Clifford.neg (Clifford.mul (b x) (e x))) ac
    (laws.negative (\fun (x: Open.Carrier U) => Clifford.mul (b x) (e x)) be));
\definition imaginaryPlot: CliffordPlots.Plot U (\fun (x: Open.Carrier U) => Representation.second (Rep.image (Group.mul (f x) (g x)))) := CliffordPlots.congruent U
  (\fun (x: Open.Carrier U) => Representation.second (Algebra.product (Rep.image (f x)) (Rep.image (g x))))
  (\fun (x: Open.Carrier U) => Representation.second (Rep.image (Group.mul (f x) (g x))))
  (\fun (x: Open.Carrier U) => congr!{Representation.CarrierPair E.Carrier} Representation.second _ _ (sym!{Representation.CarrierPair} _ _ (Algebra.multiplication (f x) (g x))))
  (laws.addition (\fun (x: Open.Carrier U) => Clifford.mul (a x) (e x)) (\fun (x: Open.Carrier U) => Clifford.mul (b x) (c x)) ae bc);
\definition plot: Plot U (\fun (x: Open.Carrier U) => Group.mul (f x) (g x)) := fromComponents U (\fun (x: Open.Carrier U) => Group.mul (f x) (g x)) realPlot imaginaryPlot;
