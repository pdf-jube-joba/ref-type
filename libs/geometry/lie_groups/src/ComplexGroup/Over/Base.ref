
\import \root.ComplexGroup[n := n].Over[G := G, group := group, embedding := embedding, injective := injective, sign := sign, compatible := compatible] \as Geometry;
\import \root.CoefficientAtlas[G := G, I := BaseCoefficients.Index, n := dimension, coefficient := BaseCoefficients.coefficient, ext := BaseCoefficients.ext] \as Lower;
\import calculus.Blocks[n := Phase.one, m := dimension] \as Blocks;
\definition fullDimension: N.Nat^ := Blocks.dimension;
\import \root.CoefficientAtlas[G := Carrier, I := ComplexCoefficients.Index, n := fullDimension, coefficient := ComplexCoefficients.coefficient, ext := ComplexCoefficients.ext] \as Upper;
\import calculus.Real[].Multivariable[n := Phase.one].Open[] \as LeftOpen;
\import calculus.Real[].Multivariable[n := dimension].Open[] \as RightOpen;
\import calculus.Real[].Multivariable[n := fullDimension].Open[] \as SourceOpen;
\definition LowerVector: \Set := Fin.Fin dimension -> R.Real;
\definition FullVector: \Set := Fin.Fin fullDimension -> R.Real;
\import manifolds.ParametrizedAtlas[n := dimension, A := G] \as LowerCoordinates;
\import manifolds.ParametrizedAtlas[n := fullDimension, A := Carrier] \as UpperCoordinates;
\module On(previous: Lower.Data);
