
\definition squared: Squared.base (assemble s h) = Phase.base s := trans!{{Circle.Circle}} _ _ _ (Squared.onSquareClass h (Phase.phase s)) (Phase.phaseSquared s);
\definition nonzeroHeight: Logic.Not (height (assemble s h) = R.zero) := \fun (zero: _) => Phase.nonzeroBase s
  (trans!{R.Real} _ _ _ (sym!{R.Real} _ _ (congr!{{Circle.Circle} R.Real} Phase.height _ _ squared)) zero);
\definition part: Parts := asPart (assemble s h) nonzeroHeight;
\definition parameterEquation: parameter part = s := trans!{{(Fin.Fin Phase.one -> R.Real)}} _ _ _
  (congr!{{Circle.Circle} {(Fin.Fin Phase.one -> R.Real)}} Phase.parameter _ _ squared) (Phase.parameterBase s);
\definition rootEquation: root part = Phase.phase s := congr!{{(Fin.Fin Phase.one -> R.Real)} {Circle.Circle}} Phase.phase _ _ parameterEquation;
\definition fiberEquation: fiber part = h := fixedPhaseInjective (fiber part) h (root part)
  (trans!{Carrier} _ _ _ (reconstruct part) (congr!{{Circle.Circle} Carrier} (Extension.class h) _ _ (sym!{{Circle.Circle}} _ _ rootEquation)));
