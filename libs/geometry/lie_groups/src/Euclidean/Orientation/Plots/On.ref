\import calculus.Multilinear[n := n, d := d].On[U := U] \as Evaluation;
\definition arguments[x: Open.Carrier U][i: Fin.Fin n]: Vector := (f x).value.apply (Basis.vectors i);
\definition smooth: Smooth.SmoothOn U (\fun (x: Open.Carrier U) => determinant (f x)) :=
  Evaluation.evaluation n (Alternating.asMultilinear n Top.volume) arguments (\fun (slot, coordinate: Fin.Fin n) => regular (Basis.vectors slot) coordinate);
