\use std.Logic[].Equality[].eq_reason_in;
\import R.SquareRoot[] \as Root;
\import R.Inverse[] \as Inverse;
\definition positive: Order.Lt R.zero (squared v) := \bysub(Vector, { v: Vector \where Order.Lt R.zero (squared v) }, v);
\definition length: R.Real := Root.sqrt (squared v);
\definition lengthSquared: R.mul length length = squared v := Root.squareOfNonnegative (squared v) (nonnegative v);
\definition lengthNonzero: Logic.Not (length = R.zero) := \fun (same: _) => Order.Order[].ltNotEq R.zero (squared v) positive
  (sym!{R.Real} _ _ (eq_reason_in!{R.Real _
    "=" _ "by" { sym!{R.Real} _ _ lengthSquared }
    "=" _ "by" { congr!{R.Real R.Real} (\fun (x: R.Real) => R.mul x length) _ _ same }
    "=" _ "by" { Arithmetic.fieldMulZeroLeft length }
  }));
\definition factor: R.Real := Arithmetic.fieldInv length;
\definition normalized: Vector := space.smul factor v;
\definition inverseLength: R.mul factor length = R.one := Arithmetic.fieldInverseNonzero length lengthNonzero;
\definition inverseSquared: R.mul (R.mul factor factor) (squared v) = R.one := eq_reason_in!{R.Real _
  "=" _ "by" { congr!{R.Real R.Real} (R.mul (R.mul factor factor)) _ _ (sym!{R.Real} _ _ lengthSquared) }
  "=" _ "by" { Scalars.mulFour factor factor length length }
  "=" _ "by" { congr!{R.Real R.Real R.Real} R.mul _ _ _ _ inverseLength inverseLength }
  "=" _ "by" { Arithmetic.fieldMulOneLeft R.one }
};
\definition unitNorm: squared normalized = R.one := eq_reason_in!{R.Real _
  "=" _ "by" { form.scaleLeft factor v normalized }
  "=" _ "by" { congr!{R.Real R.Real} (R.mul factor) _ _ (form.scaleRight factor v v) }
  "=" _ "by" { sym!{R.Real} _ _ (Arithmetic.fieldMulAssoc factor factor (squared v)) }
  "=" _ "by" inverseSquared
};
\definition unit: CoveringGroups.Positive := \into[Vector](normalized, { v: Vector \where squared v = R.one }) \by { unitNorm };
\import \parent.\parent.PinRepresentation[].Positive[v := unit] \as Reflection;
\definition reflection: O := Reflection.orthogonal;
\definition inverseSquare: R.mul factor factor = Arithmetic.fieldInv (squared v) := Inverse.inverseUnique (squared v) (R.mul factor factor)
  (Inverse.positiveNonzero (squared v) positive) inverseSquared;
\module Formula;
