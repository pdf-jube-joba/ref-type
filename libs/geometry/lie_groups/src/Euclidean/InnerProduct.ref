\import dedekind_reals.DedekindReal[] \as Order;
\import Order.Arithmetic[].Prop[] \as Arithmetic;
\import std.Logic[].Proposition[] \as Logic;
\definition squared[v: Vector]: R.Real := dot v v;
\definition nonnegative: \forall (v: Vector) -> Order.Le R.zero (squared v) := \fun (v: Vector) =>
  Sums.nonnegative n (\fun (i: Fin.Fin n) => R.mul (v i) (v i)) (\fun (i: Fin.Fin n) => Scalars.squareNonnegative (v i));
\definition separated: \forall (v: Vector) -> squared v = R.zero -> v = space.zero := \fun (v: Vector)(same: _) => \axiom:funext(v, space.zero,
  \fun (i: Fin.Fin n) => Scalars.squareZero (v i) (Order.leAntisym _ _
    (Order.leReplaceRight _ (squared v) R.zero same (Sums.coordinateUpper n (\fun (j: Fin.Fin n) => R.mul (v j) (v j))
      (\fun (j: Fin.Fin n) => Scalars.squareNonnegative (v j)) i)) (Scalars.squareNonnegative (v i))));
\definition positive: \forall (v: Vector) -> Logic.Not (v = space.zero) -> Order.Lt R.zero (squared v) :=
  \fun (v: Vector)(nonzero: _) => Order.Order[].ltOfLeNotEq R.zero (squared v) (nonnegative v)
    (\fun (same: R.zero = squared v) => nonzero (separated v (sym!{R.Real} _ _ same)));
\definition Nonzero: \Set := \Cast[Vector] ({ v: Vector \where Order.Lt R.zero (squared v) });
\module Normalization(v: Nonzero);
