/* Local coordinates compatible with smooth matrix-valued families. */
\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import \root.Dimensions[] \as Dimensions;
\definition dimension: N.Nat^ := Dimensions.orthogonal n;
\import manifolds.ParametrizedAtlas[n := dimension, A := O] \as Coordinates;
\import \parent.Plots[d := dimension] \as Plots;
\module Tests(d: N.Nat^);
\structure Data: \Set := {
  family: Coordinates.Family,
  parametrizations: \forall (i: N.Nat^) -> Plots.Plot (family.patch i).image (Coordinates.value (family.patch i)),
  readings: \forall (d: N.Nat^) -> Tests[d := d].Regular family,
};
\module On(data: Data);
