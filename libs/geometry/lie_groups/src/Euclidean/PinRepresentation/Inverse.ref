\definition candidate: O := OrthogonalOperations.inv f;
\definition inverseProduct: Units.product (Units.inverse g) g = Units.unit := Units.ext _ _ g.left;
\definition value: Lifts (Units.inverse g) := \into[O](candidate, Lifts (Units.inverse g)) \by { \block {
  \fun (v: Vector) \then
  \let w: Vector := f.inverse.apply v \then
  \return trans!{CliffordAlgebra} _ _ _
    (congr!{Vector CliffordAlgebra} (\fun (x: Vector) => Grade.action (Units.inverse g) (Clifford.iota x)) _ _ (sym!{Vector} _ _ (Orthogonal.rightInverse f v)))
    (trans!{CliffordAlgebra} _ _ _ (congr!{CliffordAlgebra CliffordAlgebra} (Grade.action (Units.inverse g)) _ _ (sym!{CliffordAlgebra} _ _ (agrees g f w)))
      (trans!{CliffordAlgebra} _ _ _ (sym!{CliffordAlgebra} _ _ (Grade.actionProduct (Units.inverse g) g (Clifford.iota w)))
        (trans!{CliffordAlgebra} _ _ _ (congr!{{Units.Unit} CliffordAlgebra} (\fun (h: Units.Unit) => Grade.action h (Clifford.iota w)) _ _ inverseProduct)
          (Grade.actionOne (Clifford.iota w)))))
} };
