\use std.Logic[].Equality[].eq_reason_in;
\definition candidate: O := OrthogonalOperations.inv f;
\definition inverseProduct: Units.product (Units.inverse g) g = Units.unit := Units.ext _ _ g.left;
\definition value: Lifts (Units.inverse g) := \into[O](candidate, Lifts (Units.inverse g)) \by { \block {
  \fun (v: Vector) \then
  \let w: Vector := f.inverse.apply v \then
  \return eq_reason_in!{CliffordAlgebra _
    "=" _ "by" { congr!{Vector CliffordAlgebra} (\fun (x: Vector) => Grade.action (Units.inverse g) (Clifford.iota x)) _ _ (sym!{Vector} _ _ (Orthogonal.rightInverse f v)) }
    "=" _ "by" { congr!{CliffordAlgebra CliffordAlgebra} (Grade.action (Units.inverse g)) _ _ (sym!{CliffordAlgebra} _ _ (agrees g f w)) }
    "=" _ "by" { sym!{CliffordAlgebra} _ _ (Grade.actionProduct (Units.inverse g) g (Clifford.iota w)) }
    "=" _ "by" { congr!{{Units.Unit} CliffordAlgebra} (\fun (h: Units.Unit) => Grade.action h (Clifford.iota w)) _ _ inverseProduct }
    "=" _ "by" { Grade.actionOne (Clifford.iota w) }
  }
} };
