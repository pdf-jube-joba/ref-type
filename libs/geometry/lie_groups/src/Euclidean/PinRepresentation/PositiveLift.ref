\import \parent.Positive[v := v] \as Reflection;
\import CoveringGroups.Reflection[].Positive[v := v] \as CliffordReflection;
\definition element: Pin := \into[Units.Unit](CoveringGroups.positive v, CoveringGroups.predicate) \by {
  CoveringGroups.vectorInPin (CoveringGroups.positive v) (CoveringGroups.VectorGenerator::positive v)
};
\definition lift: Lifts (CoveringGroups.positive v) := \into[O](Reflection.orthogonal, Lifts (CoveringGroups.positive v)) \by { CliffordReflection.action };
\definition image: map element = Reflection.orthogonal := unique (CoveringGroups.positive v) (chosen element) lift;
