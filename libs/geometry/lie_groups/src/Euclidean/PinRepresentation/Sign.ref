\definition fixes: \forall (x: CliffordAlgebra) -> Grade.action Units.minusOne x = x := \block {
  \fun (x: CliffordAlgebra) \then
  \let grade: Grade.map (Clifford.neg Clifford.one) = Clifford.neg Clifford.one :=
    congr!{{Units.Unit} CliffordAlgebra} (\fun (g: Units.Unit) => g.value) _ _ Grade.unitSign \then
  \return trans!{CliffordAlgebra} _ _ _
    (congr!{CliffordAlgebra CliffordAlgebra} (\fun (a: CliffordAlgebra) => Clifford.mul (Clifford.mul a x) (Clifford.neg Clifford.one)) _ _ grade)
    (trans!{CliffordAlgebra} _ _ _
      (congr!{CliffordAlgebra CliffordAlgebra} (\fun (a: CliffordAlgebra) => Clifford.mul a (Clifford.neg Clifford.one)) _ _
        (trans!{CliffordAlgebra} _ _ _ (Units.negMul Clifford.one x)
          (congr!{CliffordAlgebra CliffordAlgebra} Clifford.neg _ _ (Clifford.ring.semiring.multiplicative.leftIdentity x))))
      (trans!{CliffordAlgebra} _ _ _ (Units.negNegMul x Clifford.one) (Clifford.ring.semiring.multiplicative.rightIdentity x)))
};
\definition value: Lifts Units.minusOne := \into[O](OrthogonalOperations.one, Lifts Units.minusOne) \by { \fun (v: Vector) => fixes (Clifford.iota v) };
