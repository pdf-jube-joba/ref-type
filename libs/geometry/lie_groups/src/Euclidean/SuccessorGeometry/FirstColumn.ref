/* Orthogonal factorization in the stereographic first-column patch. */
\definition column: Sphere := \into[Next.Vector](NextOrthogonal.action g first,
    { v: Next.Vector \where Next.dot v v = R.one }) \by {
  trans!{R.Real} _ _ _ (NextOrthogonal.preserves g first first) firstNorm
};
\import \parent.SphereCoordinates[v := column, nonzero := nonzero] \as Coordinates;
\definition parameter: Vector := Coordinates.parameter;
\import \parent.SphereSection[s := parameter] \as Section;
\definition correction: Next.O := NextOperations.mul (NextOperations.inv Section.value) g;
\definition fixes: NextOrthogonal.action correction first = first := trans!{Next.Vector} _ _ _
  (congr!{Next.Vector Next.Vector} Section.value.inverse.apply _ _ (sym!{Next.Vector} _ _ Coordinates.recovers))
  (NextOrthogonal.leftInverse Section.value first);
\import \parent.Stabilizer[g := correction, fixes := fixes] \as Restricted;
\definition fiber: O := Restricted.orthogonal;
\import \parent.Extension[h := fiber] \as Extended;
\import \parent.StabilizerExtension[g := correction, fixes := fixes] \as Reconstruction;
\definition reconstruct: NextOperations.mul Section.value Extended.orthogonal = g := trans!{Next.O} _ _ _
  (congr!{Next.O Next.O} (NextOperations.mul Section.value) _ _ Reconstruction.equal)
  (trans!{Next.O} _ _ _ (sym!{Next.O} _ _ (NextOperations.assoc Section.value (NextOperations.inv Section.value) g))
    (trans!{Next.O} _ _ _ (congr!{Next.O Next.O} (\fun (a: Next.O) => NextOperations.mul a g) _ _ (NextOperations.invRight Section.value))
      (NextOperations.oneLeft g)));
