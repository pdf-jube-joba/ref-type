\definition direction[x: Open.Carrier U]: Next.InnerProduct[].Nonzero := \parent.\parent.SphereSection[s := s x].nonzero;
\definition directionSmooth: NextPlots.Values U (\fun (x: Open.Carrier U) => direction x) := extendValues U
  (\fun (x: Open.Carrier U) => R.one) s (Functions.constantSmooth U R.one) regular;
\import NextPlots.Reflection[U := U, v := direction, regular := directionSmooth] \as Reflection;
\definition initial: Next.O := Next.PinRepresentation[].Positive[v := \parent.\parent.SphereSection[s := space.zero].firstUnit].orthogonal;
\definition value[x: Open.Carrier U]: Next.O := \parent.\parent.SphereSection[s := s x].value;
\definition plot: NextPlots.Plot U value := NextPlots.multiplication U Reflection.value (\fun (x: Open.Carrier U) => initial)
  Reflection.plot (NextPlots.constant U initial);
