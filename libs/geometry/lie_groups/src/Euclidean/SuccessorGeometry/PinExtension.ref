/* Compatibility of the Clifford inclusion with extension of isometries. */
\use Equality.eq_reason;
\import \root.Euclidean[n := n].PinRepresentation[] \as Representation;
\import Next.PinRepresentation[] \as HigherRepresentation;
\import clifford.Euclidean[n := n].Successor[].Inclusion[] \as Inclusion;
\import Inclusion.Groups[] \as Coverings;
\import clifford.Euclidean[n := n].Successor[].NormalForm[] \as Normal;
\import Normal.Grading[] \as Grading;
\import Normal.Commutation[] \as Commutation;
\import clifford.Field[K := R.Real, field := Scalars.field].On[V := Next.Vector, space := Next.space].Of[form := Next.form] \as HigherAlgebra;
\import HigherAlgebra.Grading[] \as HigherGrade;
\import algebra.Groups[].Units[A := NextEnd.Carrier, ring := NextEnd.ring] \as HigherIsometries;
\definition lifted: Next.Pin := Coverings.pin g;
\definition image: Next.O := HigherRepresentation.map lifted;
\definition firstAction: HigherGrade.action lifted (HigherAlgebra.iota first) = HigherAlgebra.iota first := eq_reason!{
  {HigherGrade.action lifted (HigherAlgebra.iota first)}
  "=" {HigherAlgebra.mul (HigherAlgebra.mul (Inclusion.map (Clifford.Grading[].map g.value)) (HigherAlgebra.iota first)) (Inclusion.map g.inverse)} "by" {
    congr!{Next.CliffordAlgebra Next.CliffordAlgebra} (\fun (x: Next.CliffordAlgebra) => HigherAlgebra.mul (HigherAlgebra.mul x (HigherAlgebra.iota first)) (Inclusion.map g.inverse)) _ _ (Grading.onLower g.value)}
  "=" {HigherAlgebra.mul (HigherAlgebra.mul (HigherAlgebra.iota first) (Inclusion.map g.value)) (Inclusion.map g.inverse)} "by" {
    congr!{Next.CliffordAlgebra Next.CliffordAlgebra} (\fun (x: Next.CliffordAlgebra) => HigherAlgebra.mul x (Inclusion.map g.inverse)) _ _ (sym!{Next.CliffordAlgebra} _ _ (Commutation.all g.value))}
  "=" {HigherAlgebra.mul (HigherAlgebra.iota first) (HigherAlgebra.mul (Inclusion.map g.value) (Inclusion.map g.inverse))} "by" {
    HigherAlgebra.ring.semiring.multiplicative.associative (HigherAlgebra.iota first) (Inclusion.map g.value) (Inclusion.map g.inverse)}
  "=" {HigherAlgebra.mul (HigherAlgebra.iota first) (Inclusion.map (Clifford.mul g.value g.inverse))} "by" {
    congr!{Next.CliffordAlgebra Next.CliffordAlgebra} (HigherAlgebra.mul (HigherAlgebra.iota first)) _ _ (sym!{Next.CliffordAlgebra} _ _ (Inclusion.laws.mul g.value g.inverse))}
  "=" {HigherAlgebra.mul (HigherAlgebra.iota first) HigherAlgebra.one} "by" {
    congr!{Next.CliffordAlgebra Next.CliffordAlgebra} (HigherAlgebra.mul (HigherAlgebra.iota first)) _ _
      (trans!{Next.CliffordAlgebra} _ _ _ (congr!{CliffordAlgebra Next.CliffordAlgebra} Inclusion.map _ _ g.right) Inclusion.laws.one)}
  "=" {HigherAlgebra.iota first} "by" {HigherAlgebra.ring.semiring.multiplicative.rightIdentity (HigherAlgebra.iota first)}
};
\definition fixes: image.value.apply first = first := Next.cliffordVectorInjective _ _
  (trans!{Next.CliffordAlgebra} _ _ _ (sym!{Next.CliffordAlgebra} _ _ (HigherRepresentation.onVector lifted first)) firstAction);
\definition embeddedAction: \forall (v: Vector) -> HigherGrade.action lifted (HigherAlgebra.iota (embed v)) = HigherAlgebra.iota (embed ((Representation.map g).value.apply v)) :=
  \fun (v: Vector) => eq_reason!{
    {HigherGrade.action lifted (HigherAlgebra.iota (embed v))}
    "=" {HigherAlgebra.mul (HigherAlgebra.mul (Inclusion.map (Clifford.Grading[].map g.value)) (Inclusion.map (Clifford.iota v))) (Inclusion.map g.inverse)} "by" {
      congr2!{Next.CliffordAlgebra Next.CliffordAlgebra Next.CliffordAlgebra} (\fun (x, y: Next.CliffordAlgebra) => HigherAlgebra.mul (HigherAlgebra.mul x y) (Inclusion.map g.inverse)) _ _ _ _
        (Grading.onLower g.value) (sym!{Next.CliffordAlgebra} _ _ (Inclusion.onVector v))}
    "=" {Inclusion.map (Clifford.Grading[].action g (Clifford.iota v))} "by" {
      sym!{Next.CliffordAlgebra} _ _ (trans!{Next.CliffordAlgebra} _ _ _ (Inclusion.laws.mul (Clifford.mul (Clifford.Grading[].map g.value) (Clifford.iota v)) g.inverse)
        (congr!{Next.CliffordAlgebra Next.CliffordAlgebra} (\fun (x: Next.CliffordAlgebra) => HigherAlgebra.mul x (Inclusion.map g.inverse)) _ _ (Inclusion.laws.mul (Clifford.Grading[].map g.value) (Clifford.iota v))))}
    "=" {Inclusion.map (Clifford.iota ((Representation.map g).value.apply v))} "by" {congr!{CliffordAlgebra Next.CliffordAlgebra} Inclusion.map _ _ (Representation.onVector g v)}
    "=" {HigherAlgebra.iota (embed ((Representation.map g).value.apply v))} "by" {Inclusion.onVector ((Representation.map g).value.apply v)}
  };
\definition onEmbed: \forall (v: Vector) -> image.value.apply (embed v) = embed ((Representation.map g).value.apply v) :=
  \fun (v: Vector) => Next.cliffordVectorInjective _ _
    (trans!{Next.CliffordAlgebra} _ _ _ (sym!{Next.CliffordAlgebra} _ _ (HigherRepresentation.onVector lifted (embed v))) (embeddedAction v));
\import \parent.Extension[h := Representation.map g] \as Extended;
\definition sameOnFirst: image.value.apply first = Extended.orthogonal.value.apply first := trans!{Next.Vector} _ _ _ fixes (sym!{Next.Vector} _ _ Extended.fixes);
\definition sameOnEmbed: \forall (v: Vector) -> image.value.apply (embed v) = Extended.orthogonal.value.apply (embed v) :=
  \fun (v: Vector) => trans!{Next.Vector} _ _ _ (onEmbed v) (sym!{Next.Vector} _ _ (Extended.onEmbed v));
\definition sameOnVector: \forall (v: Next.Vector) -> image.value.apply v = Extended.orthogonal.value.apply v := \fun (v: Next.Vector) =>
  trans!{Next.Vector} _ _ _ (congr!{Next.Vector Next.Vector} image.value.apply _ _ (sym!{Next.Vector} _ _ (decompose v)))
    (trans!{Next.Vector} _ _ _ (image.value.preservesAdd (Next.space.smul (head v) first) (embed (tail v)))
      (trans!{Next.Vector} _ _ _ (congr2!{Next.Vector Next.Vector Next.Vector} Next.space.add _ _ _ _
        (trans!{Next.Vector} _ _ _ (image.value.preservesScale (head v) first)
          (trans!{Next.Vector} _ _ _ (congr!{Next.Vector Next.Vector} (Next.space.smul (head v)) _ _ sameOnFirst)
            (sym!{Next.Vector} _ _ (Extended.orthogonal.value.preservesScale (head v) first))))
        (sameOnEmbed (tail v)))
        (trans!{Next.Vector} _ _ _ (sym!{Next.Vector} _ _ (Extended.orthogonal.value.preservesAdd (Next.space.smul (head v) first) (embed (tail v))))
          (congr!{Next.Vector Next.Vector} Extended.orthogonal.value.apply _ _ (decompose v)))));
\definition law: image = Extended.orthogonal := HigherIsometries.ext image Extended.orthogonal (NextEnd.ext image.value Extended.orthogonal.value sameOnVector);
