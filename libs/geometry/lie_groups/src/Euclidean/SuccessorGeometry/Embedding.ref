\definition addition: \forall (x, y: Vector) -> embed (space.add x y) = Next.space.add (embed x) (embed y) :=
  \fun (x, y: Vector) => Tuples.extensionality n (embed (space.add x y)) (Next.space.add (embed x) (embed y))
    (trans!{R.Real} _ _ _ (embedHead (space.add x y)) (sym!{R.Real} _ _ (trans!{R.Real} _ _ _
      (congr!{R.Real R.Real R.Real} R.add _ _ _ _ (embedHead x) (embedHead y)) (Arithmetic.addZeroLeft R.zero))))
    (\fun (i: Fin.Fin n) => trans!{R.Real} _ _ _ (Tuples.atSuccessor n R.zero (space.add x y) i)
      (sym!{R.Real} _ _ (congr!{R.Real R.Real R.Real} R.add _ _ _ _ (Tuples.atSuccessor n R.zero x i) (Tuples.atSuccessor n R.zero y i))));
\definition scalar: \forall (a: R.Real)(x: Vector) -> embed (space.smul a x) = Next.space.smul a (embed x) :=
  \fun (a: R.Real)(x: Vector) => Tuples.extensionality n (embed (space.smul a x)) (Next.space.smul a (embed x))
    (trans!{R.Real} _ _ _ (embedHead (space.smul a x)) (sym!{R.Real} _ _ (trans!{R.Real} _ _ _
      (congr!{R.Real R.Real} (R.mul a) _ _ (embedHead x)) (Arithmetic.fieldMulZeroRight a))))
    (\fun (i: Fin.Fin n) => trans!{R.Real} _ _ _ (Tuples.atSuccessor n R.zero (space.smul a x) i)
      (sym!{R.Real} _ _ (congr!{R.Real R.Real} (R.mul a) _ _ (Tuples.atSuccessor n R.zero x i))));
\definition map: Embeddings.Map := Embeddings.Map { apply := embed, preservesAdd := addition, preservesScale := scalar };
