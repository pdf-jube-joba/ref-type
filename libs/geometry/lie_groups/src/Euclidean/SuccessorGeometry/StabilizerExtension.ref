\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Stabilizer[g := g, fixes := fixes] \as Restriction;
\import \parent.Extension[h := Restriction.orthogonal] \as Extended;
\import \parent.Block[f := Restriction.orthogonal.value] \as Block;
\import algebra.Groups[].Units[A := NextEnd.Carrier, ring := NextEnd.ring] \as Units;
\definition pointwise: \forall (x: Next.Vector) -> Block.value x = g.value.apply x := \fun (x: Next.Vector) => eq_reason_in!{Next.Vector _
  "=" _ "by" { sym!{Next.Vector} _ _ (decompose (Block.value x)) }
  "=" _ "by" { congr!{Next.Vector Next.Vector Next.Vector} Next.space.add _ _ _ _
    (congr!{R.Real Next.Vector} (\fun (a: R.Real) => Next.space.smul a first) _ _ (Block.headValue x))
    (congr!{Vector Next.Vector} embed _ _ (Block.tailValue x)) }
  "=" _ "by" { sym!{Next.Vector} _ _ (Restriction.reconstruct x) }
};
\definition equal: Extended.orthogonal = g := Units.ext _ _ (NextEnd.ext Block.map g.value pointwise);
