\import \parent.Extension[h := h] \as Extended;
\import \parent.Stabilizer[g := Extended.orthogonal, fixes := Extended.fixes] \as Restricted;
\import \parent.Block[f := h.value] \as Block;
\import algebra.Groups[].Units[A := End.Carrier, ring := End.ring] \as Units;
\definition pointwise: \forall (x: Vector) -> Restricted.forward.apply x = h.value.apply x := \fun (x: Vector) => trans!{Vector} _ _ _
  (Block.tailValue (embed x)) (congr!{Vector Vector} h.value.apply _ _ (embedTail x));
\definition equal: Restricted.orthogonal = h := Units.ext _ _ (End.ext Restricted.forward h.value pointwise);
