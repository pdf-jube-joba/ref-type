/* Scalar-coordinate atlases for the Euclidean Pin group. */
\import \parent.PinCoordinates[] \as Coefficients;
\import \root.Dimensions[] \as Dimensions;
\definition dimension: std.Data[].Nat[].Nat^ := Dimensions.orthogonal n;
\import \root.CoefficientAtlas[G := Pin, I := Coefficients.Index, n := dimension, coefficient := Coefficients.coefficient, ext := Coefficients.ext] \as Frontend;
\definition Data: \Set := Frontend.Data;
\module On(data: Data);
