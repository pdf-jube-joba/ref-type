\import Maps.Composition[U := U, V := V, f := h] \as Composition;
\definition value[x: Source.Carrier U]: Pin := f (Maps.apply U V h x);
\definition component[i: Coordinates.Index n]: Functions.Function V := \into[Open.ScalarFunction V](
  (\fun (x: Open.Carrier V) => (Coordinates.coordinates n).read (f x).value i),
  { g: Open.ScalarFunction V \where Smooth.SmoothOn V g }) \by { regular i };
\definition plot: \forall (i: Coordinates.Index n) -> SourceSmooth.SmoothOn U
  (\fun (x: Source.Carrier U) => (Coordinates.coordinates n).read (value x).value i) :=
    \fun (i: Coordinates.Index n) => Composition.smooth (component i);
