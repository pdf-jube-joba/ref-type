\import Frontend.On[data := data] \as Geometry;
\definition operations: Frontend.Operations[pinGroup] := Frontend.Operations[pinGroup] {
  inverse := \fun (d: std.Data[].Nat[].Nat^) => \parent.\parent.PinPlots[d := d].inverse,
  multiplication := \fun (d: std.Data[].Nat[].Nat^) => \parent.\parent.PinPlots[d := d].multiplication,
};
\import Geometry.Lie[group := pinGroup, regular := operations] \as Construction;
\import manifolds.Dimension[n := dimension].Smooth[] \as Model;
\definition manifold: Model.Manifold := Geometry.manifold;
\import \root.Dimension[n := dimension].OnManifold[M := manifold] \as Groups;
\definition lieGroup: Groups.LieGroup := Construction.value;
