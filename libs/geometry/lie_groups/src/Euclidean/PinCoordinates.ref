/* Separating scalar coordinate functions on the Euclidean Pin group. */
\import clifford.EuclideanCoordinates[] \as Coordinates;
\import algebra.Groups[].Units[A := CliffordAlgebra, ring := Clifford.ring] \as Units;
\definition Index: \Set := Coordinates.Index n;
\definition coefficient[i: Index][g: Pin]: R.Real := (Coordinates.coordinates n).read g.value i;
\definition ext: \forall (g, h: Pin) -> (\forall (i: Index) -> coefficient i g = coefficient i h) -> g = h :=
  \fun (g, h: Pin)(same: _) => Units.ext g h (Coordinates.injective n g.value h.value
    (\axiom:funext((Coordinates.coordinates n).read g.value, (Coordinates.coordinates n).read h.value, same)));
