\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import \parent.\parent.Plots[d := d] \as Plots;
\definition Regular[family: Coordinates.Family]: \Prop := \forall (U: Open.OpenSet)(f: Open.Carrier U -> O) -> Plots.Plot U f ->
  \forall (i: N.Nat^)(a: Open.Carrier U) -> \In[O] ((family.patch i).domain) (f a) ->
    \exists Coordinates.Read[d := d].On[p := family.patch i, U := U, f := f, a := a].Witness;
