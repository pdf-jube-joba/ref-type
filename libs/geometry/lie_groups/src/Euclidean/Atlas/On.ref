\import Coordinates.On[family := data.family] \as Parameters;
\import topology.Topology[Carrier := O] \as Space;
\import topology.Topology[Carrier := R.Real] \as Reals;
\import topology.Continuity[A := O, B := R.Real] \as Continuous;
\import metric_spaces.RealLine[] \as Line;
\import metric_spaces.MetricSpace[Carrier := R.Real].Topology[].Hausdorff[] \as RealSeparation;
\import metric_spaces.RealMetric[] \as RealMetric;
\import calculus.Real[].Multivariable[n := dimension].Open[].Topology[] \as OpenTopology;
\import calculus.Real[].Multivariable[n := dimension].Open[].Smooth[].Properties[] \as SmoothProperties;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition transitions: Parameters.Transitions := \fun (i, j: N.Nat^)(a: Parameters.Parameter j)(inside: _) =>
  data.readings dimension (data.family.patch j).image (Parameters.point j) (data.parametrizations j) i a inside;
\import Parameters.Refined[transitions := transitions] \as Construction;
\definition topology: Space.Topology := Parameters.topology;
\definition coefficient[v: Vector][i: Fin.Fin n][g: O]: R.Real := g.value.apply v i;
\definition coefficientContinuous: \forall (v: Vector)(i: Fin.Fin n) -> Continuous.Continuous topology Line.topology (coefficient v i) :=
  \fun (v: Vector)(i: Fin.Fin n)(W: \Pow R.Real)(open: _)(j: N.Nat^) =>
    OpenTopology.Of[U := (data.family.patch j).image].Continuity[].topological
      (\fun (x: Parameters.Parameter j) => coefficient v i (Parameters.point j x))
      (SmoothProperties.continuous (data.family.patch j).image (\fun (x: Parameters.Parameter j) => coefficient v i (Parameters.point j x))
        (data.parametrizations j v i)) W open;
\import lie_algebras.Field[K := R.Real, field := Scalars.field].Endomorphisms[V := Vector, space := space] \as End;
\import algebra.Groups[].Units[A := End.Carrier, ring := End.ring] \as Units;
\structure Separates[g, h: O]: \Set := {
  vector: Vector,
  index: Fin.Fin n,
  different: Logic.Not (coefficient vector index g = coefficient vector index h),
};
\definition separates: \forall (g, h: O) -> Logic.Not (g = h) -> \exists Separates[g, h] :=
  \fun (g, h: O)(different: _) => either!{{(Classical.excludedMiddle (\exists Separates[g, h]))} {\exists Separates[g, h]}
    {\fun (exists: _) => exists}
    {\fun (none: _) => Logic.falseElim (\exists Separates[g, h]) (different (Units.ext g h (End.ext g.value h.value
      (\fun (v: Vector) => \axiom:funext(g.value.apply v, h.value.apply v, \fun (i: Fin.Fin n) =>
        either!{{(Classical.excludedMiddle (coefficient v i g = coefficient v i h))} {coefficient v i g = coefficient v i h}
          {\fun (same: _) => same}
          {\fun (unequal: _) => Logic.falseElim (coefficient v i g = coefficient v i h)
            (none (\exact(Separates[g, h] { vector := v, index := i, different := unequal }, Separates[g, h])))}
        })))))}
  };
\module Separate(g, h: O, witness: Separates[g, h]);
\definition hausdorff: Space.IsT2 topology := \block {
  \fun (g, h: O)(different: _) \then
  \takefrom witness: Separates[g, h] \by separates g h different \then
  \return Separate[g := g, h := h, witness := witness].neighborhood
};
\import manifolds.Dimension[n := dimension].Smooth[] \as Model;
\definition manifold: Model.Manifold := Construction.manifold hausdorff;
\import manifolds.ChartMap[n := dimension].On[M := manifold] \as ChartMaps;
\import manifolds.Dimension[n := dimension].Chart[M := O, space := topology] \as Charts;
\import manifolds.Dimension[n := dimension].Atlas[M := O, space := topology] \as Atlases;
\import Parameters.Of[openEmbeddings := Construction.openEmbeddings] \as BasicCharts;
\import BasicCharts.Smooth[changes := Construction.smoothChanges] \as SmallAtlas;
\definition chart[i: N.Nat^]: ChartMaps.ActiveChart := \into[Charts.Chart](BasicCharts.chart i, manifold.atlas.charts) \by {
  Atlases.includedInSaturation SmallAtlas.atlas (BasicCharts.chart i)
    (Logic.existsIntro[N.Nat^, { j: N.Nat^ \where BasicCharts.chart i = BasicCharts.chart j }] i (\refl(BasicCharts.chart i)))
};
\module Plot(d: N.Nat^);
