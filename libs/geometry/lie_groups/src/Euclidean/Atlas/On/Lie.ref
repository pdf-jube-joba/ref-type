\import algebra.Groups[].On[G := O, group := orthogonalGroup] \as Group;
\import \root.Dimension[n := dimension].OnManifold[M := manifold] \as Groups;
\import \parent.FromPlots[d := dimension].From[S := manifold] \as Check;
\import \root.Smooth[n := dimension, m := dimension].Between[M := manifold, N := manifold] \as Regularity;
\import manifolds.SelfMap[n := dimension].Identity[M := manifold] \as Identity;
\import \root.Euclidean[n := n].Plots[d := dimension] \as MatrixPlots;
\definition identitySmooth: Regularity.IsSmooth (\fun (x: O) => x) := Regularity.ofMap Identity.map;
\definition inverseSmooth: Regularity.IsSmooth Group.inv := Check.smooth Group.inv
  (\fun (c: Check.SourceChart) => MatrixPlots.inverse c.image (Check.chartValue (\fun (x: O) => x) c)
    (Check.ofSmooth (\fun (x: O) => x) identitySmooth c));
\module Products(d: N.Nat^);
\definition group: Groups.LieGroup := \into[std.Alg[].Alg[].Group[O]](orthogonalGroup,
  { g: std.Alg[].Alg[].Group[O] \where Groups.Laws[g] }) \by {
    Groups.Laws[orthogonalGroup] {
      inverse := inverseSmooth,
      multiplication := \fun (d: N.Nat^) => Products[d := d].smooth,
    }
  };
