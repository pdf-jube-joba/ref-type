\module Local(c: SourceChart);
\definition maps[c: SourceChart]: FromCharts.LocalMap c := Local[c := c].map;
\definition agrees: FromCharts.Agreement f maps := \fun (c: SourceChart)(x: Open.Carrier c.image) => \refl(f (SourceCharts.point c x));
\import FromCharts.On[f := f, maps := maps, agrees := agrees] \as Glued;
\definition map: Maps.Map := Glued.value;
\definition apply: Maps.apply map = f := Glued.apply;
