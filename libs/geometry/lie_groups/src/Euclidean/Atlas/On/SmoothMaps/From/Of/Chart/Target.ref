\import Maps.Coordinates[f := f, left := c, right := chart i] \as Local;
\definition regularCoordinates: Local.Smooth := (\bysub(Maps.ContinuousMap, { h: Maps.ContinuousMap \where Maps.Chartwise h }, f)) c (chart i)
  (\bysub(SourceCharts.Chart, S.atlas.charts, c)) (\bysub(Charts.Chart, manifold.atlas.charts, chart i));
\import \root.Euclidean[n := n].Plots[d := dimension].Precomposition[e := d].On[U := Local.domain, V := (data.family.patch i).image,
  f := Coordinates.value (data.family.patch i), h := Local.map regularCoordinates, regular := data.parametrizations i] \as Pulled;
\definition domain: Open.OpenSet := Local.domain;
\definition included: Open.Included domain c.image := \fun (x: calculus.Real[].Multivariable[n := d].Point)(member: _) =>
  Local.inLeftImage (\into[calculus.Real[].Multivariable[n := d].Point](x, domain.points) \by { member });
\definition contains[a: Open.Carrier c.image]: \In[O] ((data.family.patch i).domain) (value a) ->
  \In[calculus.Real[].Multivariable[n := d].Point] domain.points a := Local.intro a;
\definition returns: \forall (x: Open.Carrier domain) -> Pulled.value x = value (Local.leftCoordinate x) := \fun (x: Open.Carrier domain) => Local.returnsPoint x;
\definition regular: \forall (v: Vector)(j: Fin.Fin n) -> Smooth.SmoothOn domain (Open.restrict domain c.image included
  (\fun (x: Open.Carrier c.image) => (value x).value.apply v j)) := \fun (v: Vector)(j: Fin.Fin n) => \idelim
    (\fun (x: Open.Carrier domain) => (Pulled.value x).value.apply v j) = (\fun (x: Open.Carrier domain) => (value (Local.leftCoordinate x)).value.apply v j)
    \with h: Open.ScalarFunction domain => Smooth.SmoothOn domain h \by {
      base: Pulled.plot v j,
      equality: \axiom:funext((\fun (x: Open.Carrier domain) => (Pulled.value x).value.apply v j),
        (\fun (x: Open.Carrier domain) => (value (Local.leftCoordinate x)).value.apply v j), \fun (x: Open.Carrier domain) =>
          congr!{O R.Real} (coefficient v j) _ _ (returns x))
    };
