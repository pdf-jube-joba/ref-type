\definition value[x: Open.Carrier c.image]: O := Maps.apply f (SourceCharts.point c x);
\module Target(i: N.Nat^);
\module Component(v: Vector, j: Fin.Fin n) {
  \import Open.LocalSmooth[U := c.image, f := \fun (x: Open.Carrier c.image) => (value x).value.apply v j] \as Local;
  \definition smooth: Smooth.SmoothOn c.image (\fun (x: Open.Carrier c.image) => (value x).value.apply v j) := Local.smooth (\block {
    \fun (a: Open.Carrier c.image) \then
    \takefrom i: \Cast[N.Nat^] ({ i: N.Nat^ \where \In[O] ((data.family.patch i).domain) (value a) }) \by data.family.covers (value a) \then
    \let p: Local.Patch := Local.Patch {
      domain := \parent.Target[i := i].domain,
      included := \parent.Target[i := i].included,
      smooth := \parent.Target[i := i].regular v j,
    } \then
    \return \exact(\into[Local.Patch](p, Local.Patches a) \by {
      \parent.Target[i := i].contains a (\bysub(N.Nat^, { i: N.Nat^ \where \In[O] ((data.family.patch i).domain) (value a) }, i))
    }, \Cast[Local.Patch] (Local.Patches a))
  });
}
\definition plot: MatrixPlots.Plot c.image value := \fun (v: Vector)(j: Fin.Fin n) => Component[v := v, j := j].smooth;
