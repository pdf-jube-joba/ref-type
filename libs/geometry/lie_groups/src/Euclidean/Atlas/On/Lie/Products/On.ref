\import \parent.\parent.\parent.FromPlots[d := d].From[S := S] \as Check;
\import \root.Smooth[n := d, m := dimension].Between[M := S, N := manifold] \as Regularity;
\import \root.Euclidean[n := n].Plots[d := d] \as MatrixPlots;
\definition smooth: \forall (f, g: S.Point -> O) -> Regularity.IsSmooth f -> Regularity.IsSmooth g ->
  Regularity.IsSmooth (\fun (x: S.Point) => Group.mul (f x) (g x)) :=
  \fun (f, g: _)(left: _)(right: _) => Check.smooth (\fun (x: S.Point) => Group.mul (f x) (g x))
    (\fun (c: Check.SourceChart) => MatrixPlots.multiplication c.image (Check.chartValue f c) (Check.chartValue g c)
      (Check.ofSmooth f left c) (Check.ofSmooth g right c));
