\import Maps.Composition[U := U, V := V, f := h] \as Composition;
\definition value[x: Source.Carrier U]: O := f (Maps.apply U V h x);
\definition coefficient[v: Vector][i: Fin.Fin n]: Functions.Function V := \into[Open.ScalarFunction V](
  (\fun (x: Open.Carrier V) => (f x).value.apply v i), { g: Open.ScalarFunction V \where Smooth.SmoothOn V g }) \by { regular v i };
\definition plot: \forall (v: Vector)(i: Fin.Fin n) -> SourceSmooth.SmoothOn U (\fun (x: Source.Carrier U) => (value x).value.apply v i) :=
  \fun (v: Vector)(i: Fin.Fin n) => Composition.smooth (coefficient v i);
