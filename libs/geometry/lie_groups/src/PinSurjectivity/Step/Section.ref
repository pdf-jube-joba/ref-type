\import Geometry.SphereSection[s := s] \as Section;
\import Next.InnerProduct[].Normalization[v := Section.nonzero] \as Normalized;
\import HigherRepresentation.PositiveLift[v := Normalized.unit] \as Direction;
\import HigherRepresentation.PositiveLift[v := Section.firstUnit] \as First;
\definition value: Next.Pin := Pins.mul Direction.element First.element;
\definition image: HigherRepresentation.map value = Section.value := trans!{{Next.O}} _ _ _
  (HigherRepresentation.multiplication Direction.element First.element)
  (congr2!{{Next.O} {Next.O} {Next.O}} Orthogonal.mul _ _ _ _ Direction.image First.image);
