\use std.Logic[].Equality[].eq_reason_in;
\definition p: Step.Parts := Step.asPart (Step.untranslate (Flip.choice candidate.tag) g) candidate.admissible;
\definition parameter: E.Vector := Step.parameter p;
\definition fiber: E.O := Step.fiber p;
\definition liftImage: Representation.map lift = fiber := \bysub(E.Pin, { p: E.Pin \where Representation.map p = fiber }, lift);
\import \parent.Section[s := parameter] \as Section;
\import Geometry.PinExtension[g := lift] \as Extension;
\definition value: Next.Pin := Pins.mul (choice candidate.tag) (Pins.mul Section.value (Inclusion.pin lift));
\definition extendedImage: HigherRepresentation.map (Inclusion.pin lift) = Geometry.Extension[h := fiber].orthogonal :=
  trans!{{Next.O}} _ _ _ Extension.law
    (congr!{{E.O} {Next.O}} (\fun (h: E.O) => Geometry.Extension[h := h].orthogonal) _ _ liftImage);
\definition image: HigherRepresentation.map value = g :=
  eq_reason_in!{{Next.O} _
    "=" _ "by" { HigherRepresentation.multiplication (choice candidate.tag) (Pins.mul Section.value (Inclusion.pin lift)) }
    "=" _ "by" { congr!{{Next.O} {Next.O} {Next.O}} Orthogonal.mul _ _ _ _ (choiceImage candidate.tag)
      (trans!{{Next.O}} _ _ _ (HigherRepresentation.multiplication Section.value (Inclusion.pin lift))
        (congr!{{Next.O} {Next.O} {Next.O}} Orthogonal.mul _ _ _ _ Section.image extendedImage)) }
    "=" _ "by" { congr!{{Next.O} {Next.O}} (Step.translate (Flip.choice candidate.tag)) _ _ (Step.reconstruct p) }
    "=" _ "by" { Step.translationUndo (Flip.choice candidate.tag) g }
  };
