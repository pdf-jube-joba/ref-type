\import \parent.Dimension[n := N.Nat^::zero] \as D;
\import \root.Euclidean[n := N.Nat^::zero] \as E;
\import E.PinRepresentation[] \as Representation;
\import algebra.Groups[].On[G := E.Pin, group := E.pinGroup] \as Pin;
\import algebra.Groups[].On[G := E.O, group := E.orthogonalGroup] \as Orthogonal;
\definition law: D.Law := \fun (g: E.O) => \exact(\into[E.Pin](Pin.one, D.Lifts g) \by {
  trans!{{E.O}} _ _ _ Representation.atOne (\root.OrthogonalAtlas[].Zero[].unique Orthogonal.one g)
}, D.Lifts g);
