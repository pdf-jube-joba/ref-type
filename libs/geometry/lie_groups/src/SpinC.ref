
\import std.Data[].Nat[] \as N;
\import real.Analysis[] \as R;
\import R.Algebra[] \as Scalars;
\import \root.Euclidean[n := n] \as E;
\import clifford.Field[K := R.Real, field := Scalars.field].On[V := E.Vector, space := E.space].Of[form := E.form] \as Clifford;
\import Clifford.Pin[] \as Pins;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;

\import \root.SpinGroup[n := n] \as Base;
\import \root.ComplexGroup[n := n].Over[G := E.Spin, group := E.spinGroup, embedding := Base.embedding, injective := Base.embeddingInjective, sign := Pins.spinInvolution, compatible := Base.compatible] \as Extension;
\import Extension.Base[dimension := Base.dimension].On[previous := Base.atlasData] \as Construction;
\definition dimension: N.Nat^ := calculus.Blocks[n := \root.CircleGeometry[].one, m := Base.dimension].dimension;
\import manifolds.Dimension[n := dimension].Smooth[] \as Model;
\definition manifold: Model.Manifold := Construction.manifold;
\definition lieGroup: \root.Dimension[n := dimension].OnManifold[M := manifold].LieGroup := Construction.lieGroup;
\definition underlyingGroup: std.Alg[].Alg[].Group[E.SpinC] := lieGroup;
