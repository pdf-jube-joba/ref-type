\import real.Analysis[] \as Reals;
\import Reals.Estimates[] \as Estimates;
\import Estimates.Product[] \as Bounds;
\import dedekind_reals.DedekindReal[] \as R;
\import algebra.Groups[].On[G := G, group := group] \as Operations;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition Positive: \Set := \Cast[Reals.Real] ({ r: Reals.Real \where R.Lt Reals.zero r });
\structure LocalHom: \Set := {
  radius: Positive,
  value: Reals.Real -> G,
  atZero: value Reals.zero = Operations.one,
  addition: \forall (s, t: Reals.Real) -> R.Lt (Bounds.abs s) radius -> R.Lt (Bounds.abs t) radius ->
    R.Lt (Bounds.abs (Reals.add s t)) radius -> value (Reals.add s t) = Operations.mul (value s) (value t),
};
\module On(f: LocalHom);
