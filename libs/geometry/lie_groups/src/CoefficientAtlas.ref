/* Smooth groups from a parametrized atlas and separating scalar coordinates. */
\import std.Data[].Nat[] \as N;
\import real.Analysis[] \as R;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\definition dimension: N.Nat^ := n;
\import manifolds.ParametrizedAtlas[n := dimension, A := G] \as Coordinates;
\module Plots(d: N.Nat^);
\module Tests(d: N.Nat^);
\structure Operations[group: std.Alg[].Alg[].Group[G]]: \Prop := {
  inverse: \forall (d: N.Nat^) -> Tests[d := d].Inverse group,
  multiplication: \forall (d: N.Nat^) -> Tests[d := d].Multiplication group,
};
\import Plots[d := dimension] \as ParameterPlots;
\structure Data: \Set := {
  family: Coordinates.Family,
  parametrizations: \forall (i: N.Nat^) -> ParameterPlots.Plot (family.patch i).image (Coordinates.value (family.patch i)),
  readings: \forall (d: N.Nat^) -> Tests[d := d].Regular family,
};
\module On(data: Data);
