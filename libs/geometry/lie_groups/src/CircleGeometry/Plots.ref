\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\import E.Plots[d := d] \as Values;
\module Phase(U: Open.OpenSet, s: Open.Carrier U -> E.Vector, regular: Values.Values U s) {
  \import \root.PinFrame[n := one].Plots[d := d].Section[U := U, s := s, regular := regular] \as Section;
  \definition real: Smooth.SmoothOn U (\fun (x: Open.Carrier U) => C.re (phase (s x))) := Section.unitRegular (Fin.zero one);
  \definition imaginary: Smooth.SmoothOn U (\fun (x: Open.Carrier U) => C.im (phase (s x))) := Section.unitRegular (Fin.succ one (Fin.zero N.Nat^::zero));
}
