\use std.Logic[].Equality[].eq_reason_in;
\definition sphereHeight: R.add R.one (Geometry.head (sphere z)) = height z := congr!{R.Real R.Real} (R.add R.one) _ _ (headCoordinates z);
\definition sphereNonzero: Logic.Not (R.add R.one (Geometry.head (sphere z)) = R.zero) := \fun (zero: _) => nonzero
  (trans!{R.Real} _ _ _ (sym!{R.Real} _ _ sphereHeight) zero);
\import Geometry.SphereCoordinates[v := sphere z, nonzero := sphereNonzero] \as Inverse;
\definition parameterEquation: Inverse.parameter = parameter z := \axiom:funext(Inverse.parameter, parameter z,
  \fun (i: Fin.Fin one) => congr!{R.Real R.Real R.Real} R.mul _ _ _ _
    (congr!{R.Real R.Real} Arithmetic.fieldInv _ _ sphereHeight) (tailCoordinates z i));
\definition sphereEquation: \parent.Section[s := Inverse.parameter].firstColumn = sphere z := Inverse.recovers;
\definition law: base (parameter z) = z := eq_reason_in!{{Circle.Circle} _
  "=" _ "by" { congr!{E.Vector {Circle.Circle}} base _ _ (sym!{E.Vector} _ _ parameterEquation) }
  "=" _ "by" { congr!{{Geometry.Sphere} {Circle.Circle}} ofSphere _ _ sphereEquation }
  "=" _ "by" { rightInverse z }
};
