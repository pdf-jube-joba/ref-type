\use std.Logic[].Equality[].eq_reason_in;
\import Geometry.SphereSection[s := s] \as S;
\import S.Column[] \as Column;
\import Next.InnerProduct[].Normalization[v := S.nonzero] \as Normalized;
\definition unit: Geometry.Sphere := Normalized.unit;
\definition firstColumn: Geometry.Sphere := \into[Next.Vector](S.firstColumn, Geometry.Sphere) \by { S.firstUnitLength };
\definition phase: Circle.Circle := ofSphere unit;
\definition base: Circle.Circle := ofSphere firstColumn;
\definition real: C.re phase = Normalized.factor := trans!{R.Real} _ _ _
  (congr!{R.Real R.Real} (R.mul Normalized.factor) _ _ S.directionHead) (Scalars.mulOneRight Normalized.factor);
\definition imaginary: C.im phase = R.mul Normalized.factor (s (Fin.zero N.Nat^::zero)) :=
  congr!{R.Real R.Real} (R.mul Normalized.factor) _ _ (Tuples.atSuccessor one R.one s (Fin.zero N.Nat^::zero));
\definition factorSquared: R.mul Normalized.factor Normalized.factor = Column.inverse := trans!{R.Real} _ _ _ Normalized.inverseSquare
  (congr!{R.Real R.Real} Arithmetic.fieldInv _ _ S.squaredDirection);
\definition product: R.mul (C.re phase) (C.im phase) = R.mul Column.inverse (s (Fin.zero N.Nat^::zero)) :=
  eq_reason_in!{R.Real _
    "=" _ "by" { congr!{R.Real R.Real R.Real} R.mul _ _ _ _ real imaginary }
    "=" _ "by" { sym!{R.Real} _ _ (Arithmetic.fieldMulAssoc Normalized.factor Normalized.factor (s (Fin.zero N.Nat^::zero))) }
    "=" _ "by" { congr!{R.Real R.Real} (\fun (a: R.Real) => R.mul a (s (Fin.zero N.Nat^::zero))) _ _ factorSquared }
  };
\definition realSquare: C.re (Circle.square phase) = C.re base := eq_reason_in!{R.Real _
  "=" _ "by" { Circle.squaredReal phase }
  "=" _ "by" { congr!{R.Real R.Real} (R.add (R.neg R.one)) _ _
    (congr!{R.Real R.Real R.Real} R.add _ _ _ _
      (trans!{R.Real} _ _ _ (congr!{R.Real R.Real R.Real} R.mul _ _ _ _ real real) factorSquared)
      (trans!{R.Real} _ _ _ (congr!{R.Real R.Real R.Real} R.mul _ _ _ _ real real) factorSquared)) }
  "=" _ "by" { sym!{R.Real} _ _ Column.headValue }
};
\definition imaginarySquare: C.im (Circle.square phase) = C.im base :=
  eq_reason_in!{R.Real _
    "=" _ "by" { congr!{R.Real R.Real R.Real} R.add _ _ _ _ product
    (trans!{R.Real} _ _ _ (Arithmetic.fieldMulComm (C.im phase) (C.re phase)) product) }
    "=" _ "by" { sym!{R.Real} _ _ (Scalars.mulAddRight Column.inverse Column.inverse (s (Fin.zero N.Nat^::zero))) }
    "=" _ "by" { sym!{R.Real} _ _ (congr!{E.Vector R.Real} (\fun (v: E.Vector) => v (Fin.zero N.Nat^::zero)) _ _ Column.tailValue) }
  };
\definition square: Circle.square phase = base := ComplexLaws.ext _ _ realSquare imaginarySquare;
\definition nonzero: Logic.Not (height base = R.zero) := \fun (zero: _) => Column.coefficientNonzero
  (trans!{R.Real} _ _ _ (sym!{R.Real} _ _ Column.height) zero);
\definition recoversParameter: parameter base = s := \axiom:funext(parameter base, s,
  \fun (i: Fin.Fin one) => trans!{R.Real} _ _ _
    (congr!{E.Vector R.Real} (\fun (v: E.Vector) => v (Fin.zero N.Nat^::zero)) _ _ Column.recoverParameter)
    (congr!{{Fin.Fin one} R.Real} s _ _ (sym!{{Fin.Fin one}} _ _ (Fin.singletonValue i))));
