\import \parent.\parent.\parent.Components[U := U, f := f] \as Parts;
\definition left: Family := Parts.left;
\definition right: Family := Parts.right;
\definition leftPlot: Lower.Plot U left := Parts.leftPlot regular;
\definition rightPlot: Lower.Plot U right := Parts.rightPlot regular;
\definition negative: Upper.Plot U (\fun (x: Open.Carrier U) => Higher.neg (f x)) := transfer
  (\fun (x: Open.Carrier U) => Algebra.neg (left x)) (\fun (x: Open.Carrier U) => Algebra.neg (right x))
  (\fun (x: Open.Carrier U) => Higher.neg (f x))
  (\fun (x: Open.Carrier U) => trans!{Next.Carrier} _ _ _ (sym!{Next.Carrier} _ _ (Operations.negative (left x) (right x)))
    (congr!{Next.Carrier Next.Carrier} Higher.neg _ _ (Spanning.recover (f x))))
  (lower.negative left leftPlot) (lower.negative right rightPlot);
\definition grading: Upper.Plot U (\fun (x: Open.Carrier U) => HigherGrade.map (f x)) := transfer
  (\fun (x: Open.Carrier U) => Grade.map (left x)) (\fun (x: Open.Carrier U) => Algebra.neg (Grade.map (right x)))
  (\fun (x: Open.Carrier U) => HigherGrade.map (f x))
  (\fun (x: Open.Carrier U) => trans!{Next.Carrier} _ _ _ (sym!{Next.Carrier} _ _ (Grading.onValue (left x) (right x)))
    (congr!{Next.Carrier Next.Carrier} HigherGrade.map _ _ (Spanning.recover (f x))))
  (lower.grading left leftPlot)
  (lower.negative (\fun (x: Open.Carrier U) => Grade.map (right x)) (lower.grading right rightPlot));
\definition reversion: Upper.Plot U (\fun (x: Open.Carrier U) => HigherReverse.map (f x)) := transfer
  (\fun (x: Open.Carrier U) => Reverse.map (left x)) (\fun (x: Open.Carrier U) => Grade.map (Reverse.map (right x)))
  (\fun (x: Open.Carrier U) => HigherReverse.map (f x))
  (\fun (x: Open.Carrier U) => trans!{Next.Carrier} _ _ _ (sym!{Next.Carrier} _ _ (Reversion.onValue (left x) (right x)))
    (congr!{Next.Carrier Next.Carrier} HigherReverse.map _ _ (Spanning.recover (f x))))
  (lower.reversion left leftPlot)
  (lower.grading (\fun (x: Open.Carrier U) => Reverse.map (right x)) (lower.reversion right rightPlot));
