\import \parent.\parent.\parent.Components[U := U, f := f] \as First;
\import \parent.\parent.\parent.Components[U := U, f := g] \as Second;
\definition fl: Family := First.left;
\definition fr: Family := First.right;
\definition gl: Family := Second.left;
\definition gr: Family := Second.right;
\definition flPlot: Lower.Plot U fl := First.leftPlot left;
\definition frPlot: Lower.Plot U fr := First.rightPlot left;
\definition glPlot: Lower.Plot U gl := Second.leftPlot right;
\definition grPlot: Lower.Plot U gr := Second.rightPlot right;
\definition addition: Upper.Plot U (\fun (x: Open.Carrier U) => Higher.add (f x) (g x)) := transfer
  (\fun (x: Open.Carrier U) => Algebra.add (fl x) (gl x)) (\fun (x: Open.Carrier U) => Algebra.add (fr x) (gr x))
  (\fun (x: Open.Carrier U) => Higher.add (f x) (g x))
  (\fun (x: Open.Carrier U) => trans!{Next.Carrier} _ _ _ (sym!{Next.Carrier} _ _ (Operations.addition (fl x) (fr x) (gl x) (gr x)))
    (congr!{Next.Carrier Next.Carrier Next.Carrier} Higher.add _ _ _ _ (Spanning.recover (f x)) (Spanning.recover (g x))))
  (lower.addition fl gl flPlot glPlot) (lower.addition fr gr frPlot grPlot);
\definition ac: Family := \fun (x: Open.Carrier U) => Algebra.mul (fl x) (gl x);
\definition ad: Family := \fun (x: Open.Carrier U) => Algebra.mul (fl x) (gr x);
\definition bc: Family := \fun (x: Open.Carrier U) => Algebra.mul (fr x) (Grade.map (gl x));
\definition bd: Family := \fun (x: Open.Carrier U) => Algebra.mul (fr x) (Grade.map (gr x));
\definition multiplication: Upper.Plot U (\fun (x: Open.Carrier U) => Higher.mul (f x) (g x)) := transfer
  (\fun (x: Open.Carrier U) => Algebra.add (ac x) (bd x)) (\fun (x: Open.Carrier U) => Algebra.add (ad x) (bc x))
  (\fun (x: Open.Carrier U) => Higher.mul (f x) (g x))
  (\fun (x: Open.Carrier U) => trans!{Next.Carrier} _ _ _ (sym!{Next.Carrier} _ _ (Operations.multiplication (fl x) (fr x) (gl x) (gr x)))
    (congr!{Next.Carrier Next.Carrier Next.Carrier} Higher.mul _ _ _ _ (Spanning.recover (f x)) (Spanning.recover (g x))))
  (lower.addition ac bd (lower.multiplication fl gl flPlot glPlot)
    (lower.multiplication fr (\fun (x: Open.Carrier U) => Grade.map (gr x)) frPlot (lower.grading gr grPlot)))
  (lower.addition ad bc (lower.multiplication fl gr flPlot grPlot)
    (lower.multiplication fr (\fun (x: Open.Carrier U) => Grade.map (gl x)) frPlot (lower.grading gl glPlot)));
