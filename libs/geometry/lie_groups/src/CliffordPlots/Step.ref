\import clifford.Field[K := R.Real, field := Scalars.field].On[V := Next.Vector, space := Next.space].Of[form := Next.form] \as Higher;
\import Algebra.Grading[] \as Grade;
\import Algebra.Reversion[] \as Reverse;
