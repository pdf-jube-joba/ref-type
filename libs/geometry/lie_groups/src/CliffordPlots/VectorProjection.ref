/* Scalar coefficient plots also detect the vector retraction. */
\definition Law[n: N.Nat^]: \Prop := \forall (U: Open.OpenSet)(f: Open.Carrier U -> clifford.Euclidean[n := n].Carrier) ->
  \parent.Dimension[n := n].Plot U f -> \parent.Dimension[n := n].Values U
    (\fun (x: Open.Carrier U) => (Coordinates.Projection[].value n).read (f x));
\module Step(n: N.Nat^);
\definition law: \forall (n: N.Nat^) -> Law n := \induction (n: N.Nat^) \return Law n \with {
  | zero: \fun (U: Open.OpenSet)(f: Open.Carrier U -> clifford.Euclidean[n := N.Nat^::zero].Carrier)(regular: _)(i: Fin.Fin N.Nat^::zero) =>
    Logic.falseElim _ (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i))
  | succ: \fun (n: N.Nat^)(previous: Law n) => Step[n := n].law previous
};
