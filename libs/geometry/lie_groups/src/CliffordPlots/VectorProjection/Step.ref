\import clifford.Euclidean[n := n] \as E;
\import clifford.Euclidean[n := N.Nat^::succ n] \as Next;
\import \parent.\parent.Dimension[n := n] \as Lower;
\import \parent.\parent.Dimension[n := N.Nat^::succ n] \as Upper;
\import Fin.Tuples[A := R.Real] \as Tuples;
\import Coordinates.ScalarPart[] \as ScalarPart;
\import E.Successor[].NormalForm[].Representation[] \as Recovery;
\module On(previous: Law n, U: Open.OpenSet, f: Open.Carrier U -> Next.Carrier, regular: Upper.Plot U f);
\definition law: Law n -> Law (N.Nat^::succ n) := \fun (previous: Law n)(U: Open.OpenSet)(f: Open.Carrier U -> Next.Carrier)(regular: _) =>
  On[previous := previous, U := U, f := f, regular := regular].law;
