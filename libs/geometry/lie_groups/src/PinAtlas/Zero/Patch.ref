\definition points: \Pow E.Pin := { g: E.Pin \where g = center k };
\definition point[x: Open.Carrier Open.whole]: Coordinates.Domain points := \into[E.Pin](center k, points) \by { \refl(center k) };
\definition coordinate[g: Coordinates.Domain points]: Open.Carrier Open.whole := empty;
\definition patch: Coordinates.Patch := Coordinates.Patch {
  domain := points, image := Open.whole, point := point, coordinate := coordinate,
  pointCoordinate := \fun (g: Coordinates.Domain points) => sym!{{E.Pin}} _ _ (\bysub(E.Pin, { g: E.Pin \where g = center k }, g)),
  coordinatePoint := emptyUnique,
};
