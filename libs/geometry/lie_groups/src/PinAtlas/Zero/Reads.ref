\import calculus.Real[].Multivariable[n := d].Open[] \as Source;
\import Source.Smooth[] \as Smooth;
\import Smooth.Operations[] \as Functions;
\import E.PinPlots[d := d] \as Plots;
\module On(U: Source.OpenSet, f: Source.Carrier U -> E.Pin, regular: Plots.Plot U f, k: N.Nat^, a: Source.Carrier U, inside: \In[E.Pin] (\parent.\parent.Patch[k := k].patch).domain (f a));
\definition regular: Frontend.Tests[d := d].Regular family := \fun (U: Source.OpenSet)(f: Source.Carrier U -> E.Pin)(regular: Plots.Plot U f)(k: N.Nat^)(a: Source.Carrier U)(inside: _) =>
  \exact(On[U := U, f := f, regular := regular, k := k, a := a, inside := inside].witness,
    Coordinates.Read[d := d].On[p := \parent.Patch[k := k].patch, U := U, f := f, a := a].Witness);
