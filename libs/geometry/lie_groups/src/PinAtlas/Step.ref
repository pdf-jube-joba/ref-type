\import \root.Euclidean[n := n] \as E;
\import \root.Euclidean[n := N.Nat^::succ n] \as Next;
\import E.PinAtlas[] \as Lower;
\import Next.PinAtlas[] \as Upper;
\import \root.PinFrame[n := n] \as Geometry;
\import real.Analysis[] \as R;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\import std.Data[].FinSet[] \as Fin;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\import algebra.Groups[].On[G := Next.Pin, group := Next.pinGroup] \as Group;
\import calculus.Blocks[n := n, m := Lower.dimension] \as Blocks;
\import calculus.Real[].Multivariable[n := n].Open[] \as LeftOpen;
\import calculus.Real[].Multivariable[n := Lower.dimension].Open[] \as RightOpen;
\import calculus.Real[].Multivariable[n := Upper.dimension].Open[] \as SourceOpen;
\definition LowerVector: \Set := Fin.Fin Lower.dimension -> R.Real;
\definition FullVector: \Set := Fin.Fin Upper.dimension -> R.Real;
\import manifolds.ParametrizedAtlas[n := Lower.dimension, A := E.Pin] \as LowerCoordinates;
\import manifolds.ParametrizedAtlas[n := Upper.dimension, A := Next.Pin] \as UpperCoordinates;
\definition first: Next.Vector := E.SuccessorGeometry[].first;
\definition height[g: Next.Pin]: R.Real := Geometry.height g;
\definition Parts: \Set := Geometry.Parts;
\definition asPart[g: Next.Pin][nonzero: Logic.Not (height g = R.zero)]: Parts := Geometry.asPart g nonzero;
\definition nonzero[g: Parts]: Logic.Not (height g = R.zero) := Geometry.nonzero g;
\definition parameter[g: Parts]: E.Vector := Geometry.parameter g;
\definition fiber[g: Parts]: E.Pin := Geometry.fiber g;
\definition assemble[s: E.Vector][h: E.Pin]: Next.Pin := Geometry.assemble s h;
\definition reconstruct[g: Parts]: assemble (parameter g) (fiber g) = g := Geometry.reconstruct g;
\definition translate[q, g: Next.Pin]: Next.Pin := Geometry.translate q g;
\definition untranslate[q, g: Next.Pin]: Next.Pin := Geometry.untranslate q g;
\definition undoTranslation: \forall (q, g: Next.Pin) -> untranslate q (translate q g) = g := Geometry.undoTranslation;
\definition translationUndo: \forall (q, g: Next.Pin) -> translate q (untranslate q g) = g := Geometry.translationUndo;
\module Reflection;
\module On(previous: Lower.Data);
