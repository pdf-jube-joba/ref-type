\import Next.PinPlots[d := Upper.dimension] \as NextPlots;
\import E.PinPlots[d := Lower.dimension].Precomposition[e := Upper.dimension].On[U := image, V := lower.image,
  f := LowerCoordinates.value lower, h := Product.rightMap, regular := previous.parametrizations i] \as Fiber;
\import Geometry.Plots[d := Upper.dimension] \as GeometryPlots;
\definition parameterSmooth: \forall (j: Fin.Fin n) -> calculus.Real[].Multivariable[n := Upper.dimension].Open[].Smooth[].SmoothOn image
  (\fun (x: Parameter) => parameterValue x j) := \fun (j: Fin.Fin n) => Product.leftMap.smooth j;
\import GeometryPlots.Section[U := image, s := parameterValue, regular := parameterSmooth] \as Section;
\import GeometryPlots.Extension[U := image, f := lowerValue, regular := Fiber.plot] \as Extension;
\definition plot: NextPlots.Plot image value := NextPlots.multiplication image Section.value Extension.value Section.plot Extension.plot;
