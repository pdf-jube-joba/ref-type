\import Upper.Tests[d := d] \as Tests;
\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import Next.PinPlots[d := d] \as MatrixPlots;
\definition regular: Tests.Regular family := \fun (U: Open.OpenSet)(f: Open.Carrier U -> Next.Pin)(smooth: MatrixPlots.Plot U f)
  (k: N.Nat^)(a: Open.Carrier U)(inside: _) =>
    \parent.Shift[i := Pair.natPairSecond (Pairs.enumerate k), q := Reflection.choice (Pair.natPairFirst (Pairs.enumerate k))].Reader[d := d].On[
      U := U, f := f, regular := smooth, a := a, inside := inside].exists;
