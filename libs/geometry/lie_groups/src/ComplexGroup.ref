/* Concrete complex extensions, with stereographic phase and subgroup fibers. */
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Logic.either;
\import real.Analysis[] \as R;
\import R.Algebra[] \as Scalars;
\import complex.Complex[] \as C;
\import clifford.Circle[] \as Circle;
\import clifford.Euclidean[n := n] \as E;
\import clifford.Field[K := R.Real, field := Scalars.field].On[V := E.Vector, space := E.space].Of[form := E.form] \as Clifford;
\import Clifford.Pin[] \as Pins;
\import clifford.ComplexRepresentation[n := n] \as Representation;
\import clifford.EuclideanCoordinates[] \as Coefficients;
\import \root.CircleGeometry[] \as Phase;
\module Over(G: \Set, group: std.Alg[].Alg[].Group[G],
  embedding: algebra.Hom[A := G, B := Pins.Pin].GroupMap group Pins.group,
  injective: \forall (g, h: G) -> embedding g = embedding h -> g = h,
  sign: algebra.Groups[].On[G := G, group := group].CentralInvolution,
  compatible: embedding sign.element = Pins.sign);
