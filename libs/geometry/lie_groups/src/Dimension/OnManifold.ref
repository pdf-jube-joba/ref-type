\import \root.Smooth[n := n, m := n].Between[M := M, N := M] \as Regularity;
\module Plots(group: Alg.Group[M.Point], k: N.Nat^);
\structure Laws[group: Alg.Group[M.Point]]: \Prop := {
  inverse: Regularity.IsSmooth group.inv,
  multiplication: \forall (k: N.Nat^) -> Plots[group := group, k := k].Condition,
};
\definition LieGroup: \Set := \Cast[Alg.Group[M.Point]] ({ group: Alg.Group[M.Point] \where Laws[group] });
\module On(G: LieGroup);
