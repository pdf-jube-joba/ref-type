\import Composition.At[a := a] \as Chain;
\import CoordinateMaps.Differential[U := domain, V := chart.image, f := map, a := a] \as Differential;
\import Calculus.Differential[U := Joint.domain, V := chart.image, f := joint, a := point a] \as JointDifferential;
\import Section.At[a := a] \as SectionDerivative;
\definition linear: calculus.Vector[n := n, m := n].LinearMap := Differential.value;
\definition Parameters: \Set := topological_algebra.Euclidean[].Dimension[n := dimension].Point;
\definition pointwise: \forall (w: Vectors.Point) -> linear.apply w = JointDifferential.value.apply (Blocks.rightLinear.apply w) :=
  \fun (w: Vectors.Point) => trans!{Vectors.Point} _ _ _
    (congr!{{calculus.Vector[n := n, m := n].LinearMap} Vectors.Point} (\fun (d: calculus.Vector[n := n, m := n].LinearMap) => d.apply w) _ _ Chain.jacobian)
    (congr!{Parameters Vectors.Point} JointDifferential.value.apply _ _
      (congr!{{calculus.Vector[n := n, m := dimension].LinearMap} Parameters} (\fun (d: calculus.Vector[n := n, m := dimension].LinearMap) => d.apply w) _ _ SectionDerivative.law));
