/* The field at x is the differential of left translation applied to v. */
\definition coordinate: Open.Carrier chart.image := Open.inclusion domain chart.image inChart x;
\import \parent.\parent.Translation[g := coordinate] \as Left;
\import Left.At[a := Left.initial] \as Derivative;
\import Calculus.Differential[U := Joint.domain, V := chart.image, f := joint, a := jointPoint x] \as JointDerivative;
\import real.Analysis[].FiniteSums[] \as FiniteSums;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Arithmetic;
\definition jacobian: velocity x = JointDerivative.value.apply direction := \axiom:funext(velocity x, JointDerivative.value.apply direction,
  \fun (i: std.Data[].FinSet[].Fin n) => FiniteSums.congruent dimension
    (\fun (j: std.Data[].FinSet[].Fin dimension) => Reals.mul (direction j) (coefficient i j x))
    (\fun (j: std.Data[].FinSet[].Fin dimension) => Reals.mul (coefficient i j x) (direction j))
    (\fun (j: std.Data[].FinSet[].Fin dimension) => Arithmetic.fieldMulComm (direction j) (coefficient i j x)));
\definition value: velocity x = (translationDifferential coordinate).apply (TangentCoordinates.decode v) :=
  trans!{Vectors.Point} _ _ _ jacobian (sym!{Vectors.Point} _ _ (Derivative.pointwise (TangentCoordinates.decode v)));
