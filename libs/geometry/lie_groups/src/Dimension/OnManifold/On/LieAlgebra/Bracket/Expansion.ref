\use std.Logic[].Equality[].eq_reason_in;

\definition first: D.apply (E.apply (Functions.product f g)) = Functions.space.add
  (Functions.space.add (Functions.product (D.apply (E.apply f)) g) (Functions.product (E.apply f) (D.apply g)))
  (Functions.space.add (Functions.product (D.apply f) (E.apply g)) (Functions.product f (D.apply (E.apply g)))) :=
  eq_reason_in!{{Functions.Function} _
    "=" _ "by" { congr!{{Functions.Function} {Functions.Function}} D.apply _ _ (right.leibniz f g) }
    "=" _ "by" { D.preservesAdd (Functions.product (E.apply f) g) (Functions.product f (E.apply g)) }
    "=" _ "by" { congr!{{Functions.Function} {Functions.Function} {Functions.Function}} Functions.space.add _ _ _ _ (left.leibniz (E.apply f) g) (left.leibniz f (E.apply g)) }
  };
\definition second: E.apply (D.apply (Functions.product f g)) = Functions.space.add
  (Functions.space.add (Functions.product (E.apply (D.apply f)) g) (Functions.product (D.apply f) (E.apply g)))
  (Functions.space.add (Functions.product (E.apply f) (D.apply g)) (Functions.product f (E.apply (D.apply g)))) :=
  eq_reason_in!{{Functions.Function} _
    "=" _ "by" { congr!{{Functions.Function} {Functions.Function}} E.apply _ _ (left.leibniz f g) }
    "=" _ "by" { E.preservesAdd (Functions.product (D.apply f) g) (Functions.product f (D.apply g)) }
    "=" _ "by" { congr!{{Functions.Function} {Functions.Function} {Functions.Function}} Functions.space.add _ _ _ _ (right.leibniz (D.apply f) g) (right.leibniz f (D.apply g)) }
  };
\definition reduced: Sum.difference (D.apply (E.apply (Functions.product f g))) (E.apply (D.apply (Functions.product f g))) = Functions.space.add
  (Functions.product (Sum.difference (D.apply (E.apply f)) (E.apply (D.apply f))) g)
  (Functions.product f (Sum.difference (D.apply (E.apply g)) (E.apply (D.apply g)))) :=
  trans!{{Functions.Function}} _ _ _ (congr!{{Functions.Function} {Functions.Function} {Functions.Function}} Sum.difference _ _ _ _ first second)
    (Functions.ext _ _ (\fun (x: Point) => trans!{Reals.Real} _ _ _ (cancelMixed _ _ _ _ _ _)
      (congr!{Reals.Real Reals.Real Reals.Real} Reals.add _ _ _ _
        (sym!{Reals.Real} _ _ (Scalars.subMul _ _ _)) (sym!{Reals.Real} _ _ (Scalars.mulSub _ _ _)))));
\definition law: (Commutator.bracket D E).apply (Functions.product f g) = Functions.space.add
  (Functions.product ((Commutator.bracket D E).apply f) g) (Functions.product f ((Commutator.bracket D E).apply g)) :=
  eq_reason_in!{{Functions.Function} _
    "=" _ "by" { bracketApply D E (Functions.product f g) }
    "=" _ "by" reduced
    "=" _ "by" { congr!{{Functions.Function} {Functions.Function} {Functions.Function}} Functions.space.add _ _ _ _
        (congr!{{Functions.Function} {Functions.Function}} (\fun (h: Functions.Function) => Functions.product h g) _ _ (sym!{{Functions.Function}} _ _ (bracketApply D E f)))
        (congr!{{Functions.Function} {Functions.Function}} (Functions.product f) _ _ (sym!{{Functions.Function}} _ _ (bracketApply D E g))) }
  };
