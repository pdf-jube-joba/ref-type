
\definition leibniz: \forall (f, g: Functions.Function) -> (End.add D E).apply (Functions.product f g) = Functions.space.add
  (Functions.product ((End.add D E).apply f) g) (Functions.product f ((End.add D E).apply g)) := \fun (f, g: Functions.Function) =>
  trans!{{Functions.Function}} _ _ _ (congr2!{{Functions.Function} {Functions.Function} {Functions.Function}} Functions.space.add _ _ _ _ (left.leibniz f g) (right.leibniz f g))
    (Functions.ext _ _ (\fun (x: Point) => trans!{Reals.Real} _ _ _ (RealSum.four _ _ _ _)
      (congr2!{Reals.Real Reals.Real Reals.Real} Reals.add _ _ _ _
        (sym!{Reals.Real} _ _ (Scalars.mulAddRight (D.apply f x) (E.apply f x) (g x)))
        (sym!{Reals.Real} _ _ (Arithmetic.fieldMulAdd (f x) (D.apply g x) (E.apply g x))))));
\definition invariant: \forall (g: Point)(f: Functions.Function) -> (End.add D E).apply (Functions.pull g f) = Functions.pull g ((End.add D E).apply f) :=
  \fun (g: Point)(f: Functions.Function) => trans!{{Functions.Function}} _ _ _
    (congr2!{{Functions.Function} {Functions.Function} {Functions.Function}} Functions.space.add _ _ _ _ (left.invariant g f) (right.invariant g f))
    (sym!{{Functions.Function}} _ _ (pullAdd g (D.apply f) (E.apply f)));
\definition laws: Condition[End.add D E] := Condition[End.add D E] { leibniz := leibniz, invariant := invariant };
