\use std.Logic[].Equality[].eq_reason_in;

\definition leibniz: \forall (f, g: Functions.Function) -> (End.scale a D).apply (Functions.product f g) = Functions.space.add
  (Functions.product ((End.scale a D).apply f) g) (Functions.product f ((End.scale a D).apply g)) := \fun (f, g: Functions.Function) =>
  trans!{{Functions.Function}} _ _ _ (congr!{{Functions.Function} {Functions.Function}} (Functions.space.smul a) _ _ (regular.leibniz f g))
    (Functions.ext _ _ (\fun (x: Point) => trans!{Reals.Real} _ _ _ (Arithmetic.fieldMulAdd a _ _)
      (congr!{Reals.Real Reals.Real Reals.Real} Reals.add _ _ _ _
        (sym!{Reals.Real} _ _ (Arithmetic.fieldMulAssoc a (D.apply f x) (g x)))
        (eq_reason_in!{Reals.Real _
          "=" _ "by" { sym!{Reals.Real} _ _ (Arithmetic.fieldMulAssoc a (f x) (D.apply g x)) }
          "=" _ "by" { congr!{Reals.Real Reals.Real} (\fun (b: Reals.Real) => Reals.mul b (D.apply g x)) _ _ (Arithmetic.fieldMulComm a (f x)) }
          "=" _ "by" { Arithmetic.fieldMulAssoc (f x) a (D.apply g x) }
        }))));
\definition invariant: \forall (g: Point)(f: Functions.Function) -> (End.scale a D).apply (Functions.pull g f) = Functions.pull g ((End.scale a D).apply f) :=
  \fun (g: Point)(f: Functions.Function) => trans!{{Functions.Function}} _ _ _
    (congr!{{Functions.Function} {Functions.Function}} (Functions.space.smul a) _ _ (regular.invariant g f))
    (sym!{{Functions.Function}} _ _ (pullScale g a (D.apply f)));
\definition laws: Condition[End.scale a D] := Condition[End.scale a D] { leibniz := leibniz, invariant := invariant };
