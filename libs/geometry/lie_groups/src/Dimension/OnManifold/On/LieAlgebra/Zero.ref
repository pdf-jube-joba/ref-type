
\definition leibniz: \forall (f, g: Functions.Function) -> End.zero.apply (Functions.product f g) = Functions.space.add
  (Functions.product (End.zero.apply f) g) (Functions.product f (End.zero.apply g)) := \fun (f, g: Functions.Function) => Functions.ext _ _ (\fun (x: Point) =>
    sym!{Reals.Real} _ _ (trans!{Reals.Real} _ _ _ (congr2!{Reals.Real Reals.Real Reals.Real} Reals.add _ _ _ _
      (Arithmetic.fieldMulZeroLeft (g x)) (Arithmetic.fieldMulZeroRight (f x))) (Arithmetic.addZeroLeft Reals.zero)));
\definition invariant: \forall (g: Point)(f: Functions.Function) -> End.zero.apply (Functions.pull g f) = Functions.pull g (End.zero.apply f) :=
  \fun (g: Point)(f: Functions.Function) => Functions.ext _ _ (\fun (x: Point) => \refl(Reals.zero));
\definition laws: Condition[End.zero] := Condition[End.zero] { leibniz := leibniz, invariant := invariant };
