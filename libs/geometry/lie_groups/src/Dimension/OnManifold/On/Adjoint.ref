\import manifolds.Differential[n := n, m := n].Between[M := manifold, N := manifold].At[f := conjugation g, x := one] \as Differential;
\definition value: End.Map := \idelim Maps.apply (conjugation g) one = one
  \with x: Point => Spaces.Linear[V := TangentAtOne, W := Tangent.Vector x, source := tangentSpace, target := Tangent.space x].Map \by {
    base: Differential.value, equality: conjugationFixesOne g
  };
