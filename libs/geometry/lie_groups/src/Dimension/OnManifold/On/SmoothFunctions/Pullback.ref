
\definition function[f: Function][x: Point]: Reals.Real := f (Maps.apply map x);
\module Plot(k: N.Nat^, U: calculus.Real[].Multivariable[n := k].Open[].OpenSet);
\definition value[f: Function]: Function := \into[Raw](function f, subspace.carrier) \by {
  \fun (k: N.Nat^)(U: calculus.Real[].Multivariable[n := k].Open[].OpenSet)(h: \parent.Plots[k := k].On[U := U].Map) => Plot[k := k, U := U].law f h
};
