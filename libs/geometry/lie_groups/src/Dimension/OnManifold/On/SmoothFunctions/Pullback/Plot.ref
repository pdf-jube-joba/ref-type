
\import calculus.Real[].Multivariable[n := k].Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\import manifolds.Dimension[n := k].Examples[].Euclidean[].Subspace[U := U] \as Domain;
\import manifolds.SmoothMap[n := k, m := n].Between[M := Domain.smoothManifold, N := manifold] \as SourceMaps;
\import manifolds.Composition[n := k, m := n, l := n].Between[M := Domain.smoothManifold, N := manifold, P := manifold] \as Composition;
\definition law: \forall (f: Function)(h: SourceMaps.Map) -> Smooth.SmoothOn U
  (\fun (x: Open.Carrier U) => function f (SourceMaps.apply h x)) :=
    \fun (f: Function)(h: SourceMaps.Map) => (regular f) k U (Composition.compose h map);
