
\import Euclidean.Subspace[U := U] \as Domain;
\import manifolds.SmoothMap[n := k, m := n].Between[M := Domain.smoothManifold, N := manifold] \as Maps;
\definition Map: \Set := Maps.Map;
\definition apply: Map -> Open.Carrier U -> Point := Maps.apply;
\definition Condition[f: Raw]: \Prop := \forall (h: Maps.Map) -> Smooth.SmoothOn U (\fun (x: Open.Carrier U) => f (Maps.apply h x));
