
\import calculus.Real[].Multivariable[n := k].Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\import Smooth.Operations[] \as Operations;
\import manifolds.Dimension[n := k].Examples[].Euclidean[] \as Euclidean;
\module On(U: Open.OpenSet);
\definition Regular[f: Raw]: \Prop := \forall (U: Open.OpenSet) -> On[U := U].Condition f;
\definition constant: \forall (a: Reals.Real) -> Regular (\fun (x: Point) => a) :=
  \fun (a: Reals.Real)(U: Open.OpenSet)(h: On[U := U].Map) => Operations.constantSmooth U a;
\definition addition: \forall (f, g: Raw) -> Regular f -> Regular g -> Regular (\fun (x: Point) => Reals.add (f x) (g x)) :=
  \fun (f, g: Raw)(left: Regular f)(right: Regular g)(U: Open.OpenSet)(h: On[U := U].Map) => Operations.addSmooth U _ _ (left U h) (right U h);
\definition scalar: \forall (a: Reals.Real)(f: Raw) -> Regular f -> Regular (\fun (x: Point) => Reals.mul a (f x)) :=
  \fun (a: Reals.Real)(f: Raw)(regular: Regular f)(U: Open.OpenSet)(h: On[U := U].Map) => Operations.scaleSmooth U a _ (regular U h);
\definition multiplication: \forall (f, g: Raw) -> Regular f -> Regular g -> Regular (\fun (x: Point) => Reals.mul (f x) (g x)) :=
  \fun (f, g: Raw)(left: Regular f)(right: Regular g)(U: Open.OpenSet)(h: On[U := U].Map) => Operations.mulSmooth U _ _ (left U h) (right U h);
