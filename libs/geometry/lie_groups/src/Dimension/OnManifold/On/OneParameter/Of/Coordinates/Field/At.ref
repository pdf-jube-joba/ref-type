\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Translation[a := Inside.input a].Differential[] \as Dynamics;
\import VectorField.At[x := Inside.output a] \as FieldValue;
\import Maps.Differential[U := domain, V := chart.image, f := map, a := Inside.input a] \as Derivative;
\definition law: Derivative.value.apply unitVector = VectorField.velocity (Inside.output a) :=
  eq_reason_in!{Vectors.Point _
    "=" _ "by" Dynamics.law
    "=" _ "by" { congr!{Vectors.Point Vectors.Point} (Product.translationDifferential (Maps.apply domain chart.image map (Inside.input a))).apply _ _
      (trans!{Vectors.Point} _ _ _ (sym!{Vectors.Point} _ _ generatorCoordinates)
        (congr!{TangentAtOne Vectors.Point} TangentCoordinates.decode _ _ same)) }
    "=" _ "by" { sym!{Vectors.Point} _ _ FieldValue.value }
  };
