\import Product.VectorField[v := v, neighborhood := neighborhood] \as VectorField;
\import differential_equations.Euclidean[n := n].Smooth[U := VectorField.domain, field := VectorField.field, a := VectorField.initial] \as ODE;
\import Maps.Preimage[U := domain, W := chart.image, V := VectorField.domain, f := map] \as Inside;
\import topological_algebra.Euclidean[].Dimension[n := n] \as Vectors;
\import topological_algebra.Euclidean[].Dimension[n := lineDimension] \as Times;
\import dedekind_reals.DedekindReal[] \as R;
\definition containsZero: \In[Times.Point] Inside.domain.points zero := Inside.intro zero
  (\idelim AtOne.coordinate chart = Maps.apply domain chart.image map zero \with p: Vectors.Point => \In[Vectors.Point] VectorField.domain.points p \by {
    base: \bysub(Vectors.Point, VectorField.domain.points, VectorField.initial), equality: sym!{Vectors.Point} _ _ atZero
  });
\definition Radius: \Set := \Cast[Reals.Real] ({ r: Reals.Real \where LineOpen.BallInside[Inside.domain.points, zero, r] });
\definition radiusExists: \exists Radius := Inside.domain.open zero containsZero;
\module At(a: LineOpen.Carrier Inside.domain);
\module On(radius: Radius);
\definition localSolutionExists: \exists ODE.LocalSolution := \block {
  \takefrom radius: Radius \by radiusExists \then
  \return \exact(On[radius := radius].solution, ODE.LocalSolution)
};
