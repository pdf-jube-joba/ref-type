\import manifolds.Differential[n := lineDimension, m := n].Between[M := line, N := manifold].At[f := f.map, x := time Reals.zero] \as Differential;
\definition velocity: TangentAtOne := \idelim Curves.apply f.map (time Reals.zero) = one
  \with x: Point => Tangent.Vector x \by { base: Differential.value.apply unitVelocity, equality: f.atZero };
