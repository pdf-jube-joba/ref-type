\import \parent.Plots[d := n].From[S := submanifold] \as Check;
\import \root.Smooth[n := n, m := n].Between[M := submanifold, N := manifold] \as AmbientRegularity;
\import \root.Smooth[n := n, m := n].Between[M := submanifold, N := submanifold] \as LocalRegularity;
\import \root.SmoothComposition[n := n, m := n, l := n].Between[M := submanifold, N := manifold, P := manifold] \as Composition;
\definition ambient: AmbientRegularity.IsSmooth (\fun (x: Carrier) => inv x) := Composition.smooth inclusion inv inclusionSmooth G.inverse;
\definition smooth: LocalRegularity.IsSmooth Subgroup.inverse := Check.restrict Subgroup.inverse ambient;
