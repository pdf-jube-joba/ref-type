\definition chosen: AmbientMaps.Map := AmbientRegularity.map (underlying f) regular;
\definition pointwise: \forall (x: S.Point) -> AmbientMaps.apply chosen x = underlying f x := \fun (x: S.Point) =>
  congr!{{S.Point -> Point} Point} (\fun (h: S.Point -> Point) => h x) _ _ (AmbientRegularity.applyChosen (underlying f) regular);
\definition inside: \forall (x: S.Point) -> \In[Point] U (AmbientMaps.apply chosen x) := \fun (x: S.Point) =>
  \idelim underlying f x = AmbientMaps.apply chosen x \with y: Point => \In[Point] U y \by {
    base: \bysub(Point, U, f x), equality: sym!{Point} _ _ (pointwise x)
  };
\import manifolds.SmoothMapCorestriction[n := d, m := n].Between[M := S, N := manifold].Into[U := U].Of[f := chosen, inside := inside] \as Corestriction;
\definition map: LocalMaps.Map := Corestriction.map;
\definition apply: LocalMaps.apply map = f := \axiom:funext(LocalMaps.apply map, f, \fun (x: S.Point) => \block {
  \let same: LocalMaps.apply map x = f x := pointwise x \then
  \return same
});
\definition smooth: LocalRegularity.IsSmooth f := \exact(\into[LocalMaps.Map](map, LocalRegularity.WithFunction f) \by { apply }, LocalRegularity.WithFunction f);
