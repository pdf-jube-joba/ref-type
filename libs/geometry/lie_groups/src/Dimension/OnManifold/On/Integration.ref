\import \parent.OneParameter[] \as OneParameters;
\definition WithGenerator[v: TangentAtOne]: \Set := OneParameters.WithGenerator v;
\module InChart(chart: AtOne.Chart);
\definition exists: \exists WithGenerator v := \block {
  \takefrom chart: AtOne.Chart \by AtOne.chartExists \then
  \return InChart[chart := chart].exists
};
