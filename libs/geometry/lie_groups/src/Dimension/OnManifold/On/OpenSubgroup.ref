/* An open subgroup has the restricted manifold and smooth group operations. */
\import Operations.Subgroup[S := U, closed := closed] \as Subgroup;
\import manifolds.OpenSubmanifold[n := n].On[M := manifold].In[U := U] \as Geometry;
\import manifolds.Dimension[n := n].Smooth[] \as Models;
\definition submanifold: Models.Manifold := Geometry.manifold;
\definition Carrier: \Set := Subgroup.Carrier;
\definition subgroup: std.Alg[].Alg[].Group[Carrier] := Subgroup.group;
\definition inclusion[x: Carrier]: Point := x;
\import \root.Smooth[n := n, m := n].Between[M := submanifold, N := manifold] \as InclusionRegularity;
\definition inclusionSmooth: InclusionRegularity.IsSmooth inclusion := InclusionRegularity.ofMap Geometry.Inclusion[].map;
\import \root.Dimension[n := n].OnManifold[M := submanifold] \as Groups;
\module Plots(d: std.Data[].Nat[].Nat^);
\module Inverse;
\definition lieGroup: Groups.LieGroup := \into[std.Alg[].Alg[].Group[Carrier]](subgroup,
  { g: std.Alg[].Alg[].Group[Carrier] \where Groups.Laws[g] }) \by {
    Groups.Laws[subgroup] {
      inverse := Inverse[].smooth,
      multiplication := \fun (d: std.Data[].Nat[].Nat^) => Plots[d := d].smooth,
    }
  };
