\import Product.VectorField[v := v, neighborhood := neighborhood] \as Field;
\import differential_equations.Euclidean[n := n].Smooth[U := Field.domain, field := Field.field, a := Field.initial] \as ODE;
\structure Data: \Set := {
  solution: ODE.LocalSolution,
  regularity: ODE.Neighborhood,
  parameters: Field.LocalCurve[solution := solution].Uniform[regularity := regularity].Parameters,
};
\definition dataExists: \exists Data := \block {
  \takefrom solution: ODE.LocalSolution \by Field.localExistence \then
  \takefrom regularity: ODE.Neighborhood \by ODE.neighborhoodExists \then
  \takefrom parameters: Field.LocalCurve[solution := solution].Uniform[regularity := regularity].Parameters
    \by Field.LocalCurve[solution := solution].Uniform[regularity := regularity].parametersExist \then
  \return \exact(Data { solution := solution, regularity := regularity, parameters := parameters }, Data)
};
\module Of(data: Data);
\definition exists: \exists WithGenerator v := \block {
  \takefrom data: Data \by dataExists \then
  \return Of[data := data].exists
};
