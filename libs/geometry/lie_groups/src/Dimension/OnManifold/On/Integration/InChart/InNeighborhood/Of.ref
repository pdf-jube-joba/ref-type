\import Field.LocalCurve[solution := data.solution].Uniform[regularity := data.regularity].On[parameters := data.parameters].Homomorphism[].Smooth[] \as Constructed;
\definition exists: \exists WithGenerator v := \exact(\into[OneParameters.OneParameter](Constructed.oneParameter,
  { f: OneParameters.OneParameter \where OneParameters.generator f = v }) \by { Constructed.Generator[].generates }, WithGenerator v);
