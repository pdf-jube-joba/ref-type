\import \parent.\parent.LocalProduct[chart := chart] \as Product;
\import Types.Of[f := f].Coordinates[chart := chart] \as Left;
\import Types.Of[f := g].Coordinates[chart := chart] \as Right;
\definition leftGenerator: Types.generator f = v := \bysub(Types.OneParameter, { f: Types.OneParameter \where Types.generator f = v }, f);
\definition rightGenerator: Types.generator g = v := \bysub(Types.OneParameter, { g: Types.OneParameter \where Types.generator g = v }, g);
\module InNeighborhood(neighborhood: Product.Neighborhood);
\definition equal: f = g := \block {
  \takefrom neighborhood: Product.Neighborhood \by Product.neighborhoodExists \then
  \return InNeighborhood[neighborhood := neighborhood].equal
};
