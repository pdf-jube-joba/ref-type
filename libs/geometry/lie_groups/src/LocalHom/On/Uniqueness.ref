\definition dilation: \forall (n: N.Nat^)(t: Reals.Real) -> h t = Powers.value n (h (scale t n)) :=
  \induction (n: N.Nat^) \return \forall (t: Reals.Real) -> h t = Powers.value n (h (scale t n)) \with {
    | zero: \fun (t: Reals.Real) => congr!{Reals.Real G} h _ _ (sym!{Reals.Real} _ _ (Algebra.mulOneRight t))
    | succ: \fun (n: N.Nat^)(previous: \forall (t: Reals.Real) -> h t = Powers.value n (h (scale t n)))(t: Reals.Real) =>
      trans!{G} _ _ _ (previous t) (congr!{G G} (Powers.value n) _ _ (trans!{G} _ _ _
        (congr!{Reals.Real G} h _ _ (sym!{Reals.Real} _ _ (doubleScale t n)))
        (addition (scale t (N.Nat^::succ n)) (scale t (N.Nat^::succ n)))))
  };
\definition pointwise: \forall (t: Reals.Real) -> h t = value t := \block {
  \fun (t: Reals.Real) \then
  \takefrom n: \parent.At[t := t].Index \by \parent.At[t := t].eligibleExists \then
  \let eligible: \parent.At[t := t].Eligible n := \bysub(N.Nat^, { n: N.Nat^ \where \parent.At[t := t].Eligible n }, n) \then
  \return trans!{G} _ _ _ (dilation n t)
    (trans!{G} _ _ _ (congr!{G G} (Powers.value n) _ _ (localAgreement (scale t n) eligible))
      (sym!{G} _ _ (\parent.At[t := t].computes n eligible)))
};
\definition equal: h = value := \axiom:funext(h, value, pointwise);
