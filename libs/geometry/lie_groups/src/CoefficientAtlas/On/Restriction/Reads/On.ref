\import \parent.\parent.Patch[k := k] \as Patch;
\definition raw[x: Source.Carrier V]: G := f x;
\import Coordinates.Read[d := d].On[p := Patch.old, U := V, f := raw, a := a] \as Reading;
\import TargetCoordinates.Read[d := d].On[p := Patch.patch, U := V, f := f, a := a] \as Result;
\module From(witness: Reading.Witness);
\definition exists: \exists Result.Witness := \block {
  \takefrom witness: Reading.Witness \by data.readings d V raw regular k a inside \then
  \return \exact(From[witness := witness].value, Result.Witness)
};
