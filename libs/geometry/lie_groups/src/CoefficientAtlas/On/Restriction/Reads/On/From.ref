\definition W: Source.OpenSet := witness.domain;
\definition input[x: Source.Carrier W]: Source.Carrier V := Source.inclusion W V witness.included x;
\definition inside: \forall (x: Source.Carrier W) -> \In[calculus.Real[].Multivariable[n := dimension].Point] Patch.image.points (Maps.apply W Patch.old.image witness.lift x) :=
  \fun (x: Source.Carrier W) => Patch.intro (Maps.apply W Patch.old.image witness.lift x)
    (\idelim raw (input x) = Coordinates.value Patch.old (Maps.apply W Patch.old.image witness.lift x)
      \with h: G => \In[G] U h \by { base: \bysub(G, U, f (input x)), equality: sym!{G} _ _ (witness.agrees x) });
\import Maps.Corestriction[U := W, V := Patch.old.image, W := Patch.image, f := witness.lift, inside := inside] \as Restricted;
\definition value: Result.Witness := Result.Witness {
  domain := W, included := witness.included, contains := witness.contains, lift := Restricted.map,
  agrees := \fun (x: Source.Carrier W) => witness.agrees x,
};
