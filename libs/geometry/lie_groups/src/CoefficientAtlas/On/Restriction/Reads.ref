\import calculus.Real[].Multivariable[n := d].Open[] \as Source;
\import calculus.Maps[n := d, m := dimension] \as Maps;
\import Target.Plots[d := d] \as Plots;
\module On(V: Source.OpenSet, f: Source.Carrier V -> Carrier, regular: Plots.Plot V f, k: N.Nat^, a: Source.Carrier V,
  inside: \In[Carrier] (\parent.\parent.Patch[k := k].patch).domain (f a));
\definition regular: Target.Tests[d := d].Regular family := \fun (V: Source.OpenSet)(f: Source.Carrier V -> Carrier)(regular: Plots.Plot V f)(k: N.Nat^)(a: Source.Carrier V)(inside: _) =>
  On[V := V, f := f, regular := regular, k := k, a := a, inside := inside].exists;
