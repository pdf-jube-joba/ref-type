\import manifolds.EuclideanMap[n := d, m := dimension].Between[U := p.witness.domain, V := (data.family.patch p.index).image] \as Euclidean;
\import ChartMaps.At[chart := chart p.index] \as Parametrization;
\import manifolds.Composition[n := d, m := dimension, l := dimension].Between[M := Euclidean.source, N := Euclidean.target, P := manifold] \as Compose;
\definition map: Cover.LocalMap p := Compose.compose (Euclidean.map p.witness.lift) Parametrization.map;
