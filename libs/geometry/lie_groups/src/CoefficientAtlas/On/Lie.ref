\import algebra.Groups[].On[G := G, group := group] \as Group;
\import \root.Dimension[n := dimension].OnManifold[M := manifold] \as Groups;
\import \parent.FromPlots[d := dimension].From[S := manifold] \as Check;
\import \root.Smooth[n := dimension, m := dimension].Between[M := manifold, N := manifold] \as Regularity;
\import manifolds.SelfMap[n := dimension].Identity[M := manifold] \as Identity;
\import \root.CoefficientAtlas[G := G, I := I, n := n, coefficient := coefficient, ext := ext].Plots[d := dimension] \as MatrixPlots;
\definition identitySmooth: Regularity.IsSmooth (\fun (x: G) => x) := Regularity.ofMap Identity.map;
\definition inverseSmooth: Regularity.IsSmooth Group.inv := Check.smooth Group.inv
  (\fun (c: Check.SourceChart) => regular.inverse dimension c.image (Check.chartValue (\fun (x: G) => x) c)
    (Check.ofSmooth (\fun (x: G) => x) identitySmooth c));
\module Products(d: N.Nat^);
\definition value: Groups.LieGroup := \into[std.Alg[].Alg[].Group[G]](group,
  { g: std.Alg[].Alg[].Group[G] \where Groups.Laws[g] }) \by {
    Groups.Laws[group] {
      inverse := inverseSmooth,
      multiplication := \fun (d: N.Nat^) => Products[d := d].smooth,
    }
  };
