\import Maps.Composition[U := U, V := V, f := h] \as Composition;
\definition value[x: Source.Carrier U]: G := f (Maps.apply U V h x);
\definition component[i: I]: Functions.Function V := \into[Open.ScalarFunction V](
  (\fun (x: Open.Carrier V) => coefficient i (f x)), { g: Open.ScalarFunction V \where Smooth.SmoothOn V g }) \by { regular i };
\definition plot: \forall (i: I) -> SourceSmooth.SmoothOn U (\fun (x: Source.Carrier U) => coefficient i (value x)) :=
  \fun (i: I) => Composition.smooth (component i);
