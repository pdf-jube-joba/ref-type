\import calculus.Real[].Multivariable[n := d].Open[] \as Open;
\import \parent.Plots[d := d] \as Plots;
\definition Regular[family: Coordinates.Family]: \Prop := \forall (U: Open.OpenSet)(f: Open.Carrier U -> G) -> Plots.Plot U f ->
  \forall (i: N.Nat^)(a: Open.Carrier U) -> \In[G] ((family.patch i).domain) (f a) ->
    \exists Coordinates.Read[d := d].On[p := family.patch i, U := U, f := f, a := a].Witness;

\definition Inverse[group: std.Alg[].Alg[].Group[G]]: \Prop := \forall (U: Open.OpenSet)(f: Open.Carrier U -> G) -> Plots.Plot U f -> Plots.Plot U (\fun (x: Open.Carrier U) => group.inv (f x));
\definition Multiplication[group: std.Alg[].Alg[].Group[G]]: \Prop := \forall (U: Open.OpenSet)(f, g: Open.Carrier U -> G) -> Plots.Plot U f -> Plots.Plot U g -> Plots.Plot U (\fun (x: Open.Carrier U) => group.op (f x) (g x));
