\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorEquality[V := F x, W := G x, U := TargetReverse.Fiber (f x), left := left.space x, right := right.space x, target := TargetReverse.fiberSpace (f x)] \as Equality;
\definition leftNormal: \forall (v: F x)(w: G x) -> (firstPath.fiber x).apply (Source.pure x v w) = TargetReverse.pure (f x) ((b.fiber x).apply w) ((a.fiber x).apply v) :=
  \fun (v: F x)(w: G x) => trans!{{TargetReverse.Fiber (f x)}} _ _ _
    (congr!{{Target.Fiber (f x)} {TargetReverse.Fiber (f x)}} (TargetSwap.isomorphism.forward.fiber (f x)).apply _ _ (Mapping.onPure a b x v w))
    (TargetFlip.onPure (f x) ((a.fiber x).apply v) ((b.fiber x).apply w));
\definition rightNormal: \forall (v: F x)(w: G x) -> (secondPath.fiber x).apply (Source.pure x v w) = TargetReverse.pure (f x) ((b.fiber x).apply w) ((a.fiber x).apply v) :=
  \fun (v: F x)(w: G x) => trans!{{TargetReverse.Fiber (f x)}} _ _ _
    (congr!{{SourceReverse.Fiber x} {TargetReverse.Fiber (f x)}} ((ReverseMapping.map b a).fiber x).apply _ _ (SourceFlip.onPure x v w))
    (ReverseMapping.onPure b a x w v);
\definition equality: \forall (t: Source.Fiber x) -> (firstPath.fiber x).apply t = (secondPath.fiber x).apply t := Equality.pointwise (firstPath.fiber x) (secondPath.fiber x)
  (\fun (v: F x)(w: G x) => trans!{{TargetReverse.Fiber (f x)}} _ _ _ (leftNormal v w) (sym!{{TargetReverse.Fiber (f x)}} _ _ (rightNormal v w)));
