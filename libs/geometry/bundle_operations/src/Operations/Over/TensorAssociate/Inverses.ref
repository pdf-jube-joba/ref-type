\import Spaces.Linear[V := Right, W := Left, source := rightSpace, target := leftSpace].Composition[U := Left, domain := leftSpace] \as LeftComposition;
\import Spaces.Linear[V := Left, W := Right, source := leftSpace, target := rightSpace].Composition[U := Right, domain := rightSpace] \as RightComposition;
\definition leftIdentity: Spaces.Linear[V := Left, W := Left, source := leftSpace, target := leftSpace].Map := Spaces.Linear[V := Left, W := Left, source := leftSpace, target := leftSpace].Map {
  apply := \fun (t: Left) => t, preservesAdd := \fun (s, t: Left) => \refl(Source.plus s t), preservesScale := \fun (a: K)(t: Left) => \refl(Source.scale a t)
};
\definition rightIdentity: Spaces.Linear[V := Right, W := Right, source := rightSpace, target := rightSpace].Map := Spaces.Linear[V := Right, W := Right, source := rightSpace, target := rightSpace].Map {
  apply := \fun (t: Right) => t, preservesAdd := \fun (s, t: Right) => \refl(Target.plus s t), preservesScale := \fun (a: K)(t: Right) => \refl(Target.scale a t)
};
\definition leftInverse: \forall (t: Left) -> backward.apply (forward.apply t) = t :=
  \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorTripleEquality[V := V, W := W, U := U, T := Left, left := left, middle := middle, right := right, target := leftSpace].pointwise (LeftComposition.compose backward forward) leftIdentity
    (\fun (v: V)(w: W)(u: U) => trans!{Left} _ _ _ (congr!{Right Left} backward.apply _ _ (onLeftPure v w u)) (onRightPure v w u));
\definition rightInverse: \forall (t: Right) -> forward.apply (backward.apply t) = t :=
  \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorTripleEquality[V := V, W := W, U := U, T := Right, left := left, middle := middle, right := right, target := rightSpace].Right[].pointwise (RightComposition.compose forward backward) rightIdentity
    (\fun (v: V)(w: W)(u: U) => trans!{Right} _ _ _ (congr!{Left Right} forward.apply _ _ (onRightPure v w u)) (onLeftPure v w u));
