\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Zero[X := X, baseSpace := bundle.baseSpace] \as Zero;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumUnit[X := X, F := F, bundle := bundle] \as LeftUnit;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := F, G := \fun (x: X) => Zero.Fiber, left := bundle, right := Zero.bundle] \as RightSum;
\definition sum: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := RightSum.Fiber].Bundle := RightSum.bundle (\refl(bundle.baseSpace));
\import RightSum.Of[same := \refl(bundle.baseSpace)].Symmetry[] \as Swap;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismComposition[X := X, F := RightSum.Fiber,
  G := \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := \fun (x: X) => Zero.Fiber, G := F, left := Zero.bundle, right := bundle].Fiber,
  H := F, source := sum, middle := LeftUnit.sum, target := bundle] \as Composition;
\definition isomorphism: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := RightSum.Fiber, G := F, source := sum, target := bundle].Isomorphism := Composition.compose Swap.isomorphism LeftUnit.isomorphism;
\definition onPair: \forall (x: X)(v: F x)(z: Zero.Fiber) -> (isomorphism.forward.fiber x).apply (Pair.pair (F x) Zero.Fiber v z) = v := \fun (x: X)(v: F x)(z: Zero.Fiber) => \refl(v);
