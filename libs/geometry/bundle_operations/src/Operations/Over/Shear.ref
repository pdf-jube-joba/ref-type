\import \parent.DirectSum[X := X, F := F, G := G, left := left, right := right] \as Sum;
\definition bundle: Bundles.Family[X := X, F := Sum.Fiber].Bundle := Sum.bundle same;
\import Sum.Of[same := same] \as Projections;
\import Sum.Of[same := same].From[Y := X, H := Sum.Fiber, source := bundle, f := (\fun (x: X) => x)] \as Pairing;
\import Sum.Of[same := same].To[Y := X, H := F, target := left, f := (\fun (x: X) => x)] \as ToLeft;
\import Sum.Of[same := same].To[Y := X, H := G, target := right, f := (\fun (x: X) => x)] \as ToRight;
\import Bundles.Identity[X := X, F := F, bundle := left] \as LeftIdentity;
\import Bundles.Identity[X := X, F := G, bundle := right] \as RightIdentity;
\import \parent.MapOperations[X := X, F := F, G := G, source := left, target := right] \as Columns;
\import \parent.MapOperations[X := X, F := G, G := F, source := right, target := left] \as Rows;
\import Bundles.Morphisms[X := X, Y := X, F := Sum.Fiber, G := Sum.Fiber, source := bundle, target := bundle, f := (\fun (x: X) => x)] \as Maps;
\import Bundles.Isomorphisms[X := X, F := Sum.Fiber, G := Sum.Fiber, source := bundle, target := bundle] \as Isomorphisms;
\module Upper(h: Rows.Map, a: K);
\module Lower(h: Columns.Map, a: K);
