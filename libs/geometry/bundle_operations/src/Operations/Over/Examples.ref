\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].GaugeExample[] \as Gauge;
\import real.Analysis[] \as R;
\import metric_spaces.RealLine[] \as Line;
\definition F[x: R.Real]: \Set := Gauge.NewFiber x;
\definition bundle: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := R.Real, F := F].Bundle := Gauge.glued;
\definition zero: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zero;
\definition two: N.Nat^ := N.Nat^::succ one;
\definition square[x: R.Real]: R.Real := R.mul x x;
\definition squareContinuous: topology.Continuity[A := R.Real, B := R.Real].Continuous Line.topology Line.topology square := metric_spaces.RealFunctions[A := R.Real].Product[].continuous Line.topology (\fun (x: R.Real) => x) (\fun (x: R.Real) => x)
  (topology.Maps[A := R.Real, B := R.Real].Identity[].continuous Line.topology) (topology.Maps[A := R.Real, B := R.Real].Identity[].continuous Line.topology);
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := R.Real, F := F, G := F, left := bundle, right := bundle] \as DirectSum;
\import DirectSum.Of[same := \refl(Line.topology)].Pullback[Y := R.Real, source := Line.topology, f := square, regular := squareContinuous] \as DirectSumPullback;
\definition directsumPullback: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := R.Real, F := \fun (x: R.Real) => DirectSum.Fiber (square x), G := \fun (x: R.Real) => DirectSum.Fiber (square x), source := DirectSumPullback.firstBundle, target := DirectSumPullback.secondBundle].Isomorphism := DirectSumPullback.isomorphism;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := R.Real, F := F, G := F, left := bundle, right := bundle] \as Tensor;
\import Tensor.Of[same := \refl(Line.topology)].Pullback[Y := R.Real, source := Line.topology, f := square, regular := squareContinuous] \as TensorPullback;
\definition tensorPullback: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := R.Real, F := \fun (x: R.Real) => Tensor.Fiber (square x), G := \fun (x: R.Real) => Tensor.Fiber (square x), source := TensorPullback.firstBundle, target := TensorPullback.secondBundle].Isomorphism := TensorPullback.isomorphism;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Hom[X := R.Real, F := F, G := F, left := bundle, right := bundle] \as Hom;
\import Hom.Of[same := \refl(Line.topology)].Pullback[Y := R.Real, source := Line.topology, f := square, regular := squareContinuous] \as HomPullback;
\definition homPullback: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := R.Real, F := \fun (x: R.Real) => Hom.Fiber (square x), G := \fun (x: R.Real) => Hom.Fiber (square x), source := HomPullback.firstBundle, target := HomPullback.secondBundle].Isomorphism := HomPullback.isomorphism;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Dual[X := R.Real, F := F, bundle := bundle] \as Dual;
\import Dual.Pullback[Y := R.Real, source := Line.topology, f := square, regular := squareContinuous] \as DualPullback;
\definition dualPullback: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := R.Real, F := \fun (x: R.Real) => Dual.Fiber (square x), G := \fun (x: R.Real) => Dual.Fiber (square x), source := DualPullback.firstBundle, target := DualPullback.secondBundle].Isomorphism := DualPullback.isomorphism;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Exterior[X := R.Real, F := F, bundle := bundle, k := two] \as Exterior;
\import Exterior.Pullback[Y := R.Real, source := Line.topology, f := square, regular := squareContinuous] \as ExteriorPullback;
\definition exteriorPullback: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := R.Real, F := \fun (x: R.Real) => Exterior.Fiber (square x), G := \fun (x: R.Real) => Exterior.Fiber (square x), source := ExteriorPullback.firstBundle, target := ExteriorPullback.secondBundle].Isomorphism := ExteriorPullback.isomorphism;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Exterior[X := R.Real, F := F, bundle := bundle, k := zero] \as ExteriorZero;
\definition exteriorDegreeZero: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := R.Real, F := ExteriorZero.Fiber].Bundle := ExteriorZero.exterior;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Zero[X := R.Real, baseSpace := Line.topology] \as Zero;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := R.Real, F := F, G := \fun (x: R.Real) => Zero.Fiber, left := bundle, right := Zero.bundle] \as TensorZero;
\definition tensorWithZero: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := R.Real, F := TensorZero.Fiber].Bundle := TensorZero.bundle (\refl(Line.topology));
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Identity[X := R.Real, F := F, bundle := bundle] \as Identity;
\import Dual.Contramap[G := F, target := bundle, sameBase := \refl(Line.topology)] \as DualMapping;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Identity[X := R.Real, F := Dual.Fiber, bundle := Dual.dual] \as DualIdentity;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := R.Real, Y := R.Real, F := Dual.Fiber, G := Dual.Fiber, source := Dual.dual, target := Dual.dual, f := \fun (x: R.Real) => x] \as DualMaps;
\definition dualIdentity: DualMapping.map Identity.map = DualIdentity.map := DualMaps.ext (DualMapping.map Identity.map) DualIdentity.map (\fun (x: R.Real)(ell: Dual.Fiber x) => \axiom:funext((((DualMapping.map Identity.map).fiber x).apply ell), ell, \fun (v: F x) => \refl(ell v)));
\import Hom.Of[same := \refl(Line.topology)].Mapping[A := F, B := F, newLeft := bundle, newRight := bundle, sameLeft := \refl(Line.topology), sameRight := \refl(Line.topology)] \as HomMapping;
\definition homEvaluation: \forall (x: R.Real)(h: Hom.Fiber x)(v: F x) -> (((HomMapping.map Identity.map Identity.map).fiber x).apply h).apply v = h.apply v := HomMapping.evaluation Identity.map Identity.map;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorAssociatorNaturality[X := R.Real, A := F, B := F, C := F, D := F, E := F, F := F, first := bundle, second := bundle, third := bundle, newFirst := bundle, newSecond := bundle, newThird := bundle, sameSecond := \refl(Line.topology), sameThird := \refl(Line.topology), newSameSecond := \refl(Line.topology), newSameThird := \refl(Line.topology), a := Identity.map, b := Identity.map, c := Identity.map] \as TensorNaturality;
\definition tensorAssociatorNaturality: TensorNaturality.firstPath = TensorNaturality.secondPath := TensorNaturality.naturality;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumAssociatorNaturality[X := R.Real, A := F, B := F, C := F, D := F, E := F, F := F, first := bundle, second := bundle, third := bundle, newFirst := bundle, newSecond := bundle, newThird := bundle, sameSecond := \refl(Line.topology), sameThird := \refl(Line.topology), newSameSecond := \refl(Line.topology), newSameThird := \refl(Line.topology), a := Identity.map, b := Identity.map, c := Identity.map] \as DirectSumNaturality;
\definition directsumAssociatorNaturality: DirectSumNaturality.firstPath = DirectSumNaturality.secondPath := DirectSumNaturality.naturality;
\import Bundles.TwoRanks[n := zero, m := one] \as Mixed;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := std.Data[].Bool[].Bool^, F := Mixed.Fiber, G := Mixed.Fiber, left := Mixed.bundle, right := Mixed.bundle] \as MixedTensor;
\definition mixedRankTensor: Bundles.Family[X := std.Data[].Bool[].Bool^, F := MixedTensor.Fiber].Bundle := MixedTensor.bundle (\refl(topology.Topology[Carrier := std.Data[].Bool[].Bool^].Discrete));
\import Bundles.Trivial[X := Fin.Fin zero, n := one, baseSpace := topology.Topology[Carrier := Fin.Fin zero].Discrete] \as Empty;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := Fin.Fin zero, F := \fun (x: Fin.Fin zero) => Vector one, G := \fun (x: Fin.Fin zero) => Vector one, left := Empty.bundle, right := Empty.bundle] \as EmptySum;
\definition emptySum: Bundles.Family[X := Fin.Fin zero, F := EmptySum.Fiber].Bundle := EmptySum.bundle (\refl(topology.Topology[Carrier := Fin.Fin zero].Discrete));
\definition emptyTotal: \forall (p: Bundles.Family[X := Fin.Fin zero, F := EmptySum.Fiber].Point) -> Logic.False := \fun (p: Bundles.Family[X := Fin.Fin zero, F := EmptySum.Fiber].Point) => Fin.zeroImpossible p.base (Fin.bound zero p.base);
