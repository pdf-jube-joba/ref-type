\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F] \as Family;
\import Family.With[data := bundle] \as Charts;
\import Charts.In[c := c] \as Original;
\module At(x: \Cast[X] c.domain);
\definition chart: Charts.ChartData := Charts.ChartData { domain := c.domain, dimension := c.dimension, frame := \fun (x: \Cast[X] c.domain) => At[x := x].frame };
\import Charts.In[c := chart] \as Local;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].CoordinateGauge[X := X, U := c.domain, n := c.dimension, baseSpace := bundle.baseSpace, gauge := gauge] \as Coordinate;
\definition forward: Original.ProductPoint -> Original.ProductPoint := Coordinate.forward;
\definition backward: Original.ProductPoint -> Original.ProductPoint := Coordinate.backward;
\definition Regular: \Prop := Coordinate.Regular;
\definition trivialization[regular: Regular]: Charts.Chart := \into[Charts.ChartData](chart, Charts.Chart) \by {
  Local.Laws {
    baseOpen := (\bysub(Charts.ChartData, Charts.Chart, c)).baseOpen,
    totalOpen := (\bysub(Charts.ChartData, Charts.Chart, c)).totalOpen,
    forwardContinuous := topology.Composition[A := Original.TotalPoint, B := Original.ProductPoint, C := Original.ProductPoint].composeContinuous Original.localTopology Original.productTopology Original.productTopology Original.forward forward
      (\bysub(Charts.ChartData, Charts.Chart, c)).forwardContinuous regular.forward,
    backwardContinuous := topology.Composition[A := Original.ProductPoint, B := Original.ProductPoint, C := Original.TotalPoint].composeContinuous Original.productTopology Original.productTopology Original.localTopology backward Original.backward
      regular.backward (\bysub(Charts.ChartData, Charts.Chart, c)).backwardContinuous
  }
};
