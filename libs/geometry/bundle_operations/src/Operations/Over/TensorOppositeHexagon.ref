\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorHexagon[X := X, A := C, B := A, C := B, first := third, second := first, third := second, sameSecond := sym!{{topology.Topology[Carrier := X].Topology}} first.baseSpace third.baseSpace sameThird, sameThird := trans!{{topology.Topology[Carrier := X].Topology}} third.baseSpace first.baseSpace second.baseSpace (sym!{{topology.Topology[Carrier := X].Topology}} first.baseSpace third.baseSpace sameThird) sameSecond] \as Hexagon;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Hexagon.SourceFiber, G := Hexagon.TargetFiber, source := Hexagon.sourceBundle, target := Hexagon.targetBundle] \as Forward;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Hexagon.TargetFiber, G := Hexagon.SourceFiber, source := Hexagon.targetBundle, target := Hexagon.sourceBundle] \as Backward;
\definition direct: Backward.Isomorphism := Forward.inverse Hexagon.direct;
\definition through: Backward.Isomorphism := Forward.inverse Hexagon.path4;
\definition hexagon: direct = through := congr!{Forward.Isomorphism Backward.Isomorphism} Forward.inverse Hexagon.direct Hexagon.path4 Hexagon.hexagon;
