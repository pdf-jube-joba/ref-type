\definition left: \forall (v: V) -> backward.apply (forward.apply v) = v :=
  \fun (v: V) => trans!{{V}} _ _ _
    (congr!{{V} {V} {V}} even.add _ _ _ _ (c.e.preservesAdd (c.d.apply v) (k.apply v)) (h.preservesAdd (c.d.apply v) (k.apply v)))
    (trans!{{V}} _ _ _
      (congr!{{V} {V} {V}} even.add _ _ _ _
        (congr!{{V} {V} {V}} even.add _ _ _ _ (laws.squareEven v) (eK v))
        (congr!{{V} {V} {V}} even.add _ _ _ _ (hD v) (squareEven v)))
      (trans!{{V}} _ _ _ (congr!{{V} {V} {V}} even.add _ _ _ _ (Even.zeroLeft (c.e.apply (c.k.apply v))) (Even.zeroRight (c.h.apply (c.d.apply v)))) (laws.even v)));
\definition right: \forall (w: W) -> forward.apply (backward.apply w) = w :=
  \fun (w: W) => trans!{{W}} _ _ _
    (congr!{{W} {W} {W}} odd.add _ _ _ _ (c.d.preservesAdd (c.e.apply w) (h.apply w)) (k.preservesAdd (c.e.apply w) (h.apply w)))
    (trans!{{W}} _ _ _
      (congr!{{W} {W} {W}} odd.add _ _ _ _
        (congr!{{W} {W} {W}} odd.add _ _ _ _ (laws.squareOdd w) (dH w))
        (congr!{{W} {W} {W}} odd.add _ _ _ _ (kE w) (squareOdd w)))
      (trans!{{W}} _ _ _ (congr!{{W} {W} {W}} odd.add _ _ _ _ (Odd.zeroLeft (c.d.apply (c.h.apply w))) (Odd.zeroRight (c.k.apply (c.e.apply w)))) (laws.odd w)));
