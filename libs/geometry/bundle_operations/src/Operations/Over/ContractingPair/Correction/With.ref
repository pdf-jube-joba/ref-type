\definition inverseD: \forall (v: V) -> s.apply (c.d.apply v) = c.d.apply (r.apply v) :=
  \fun (v: V) => trans!{{W}} _ _ _
    (congr!{{V} {W}} (\fun (u: V) => s.apply (c.d.apply u)) _ _ (sym!{{V}} _ _ (rightEven v)))
    (trans!{{W}} _ _ _ (congr!{{W} {W}} s.apply _ _ (commutesD (r.apply v))) (leftOdd (c.d.apply (r.apply v))));
\definition inverseE: \forall (w: W) -> r.apply (c.e.apply w) = c.e.apply (s.apply w) :=
  \fun (w: W) => trans!{{V}} _ _ _
    (congr!{{W} {V}} (\fun (u: W) => r.apply (c.e.apply u)) _ _ (sym!{{W}} _ _ (rightOdd w)))
    (trans!{{V}} _ _ _ (congr!{{V} {V}} r.apply _ _ (commutesE (s.apply w))) (leftEven (c.e.apply (s.apply w))));
\definition h: Backward.Map := Backward.Composition[U := W, domain := odd].compose c.h s;
\definition k: Forward.Map := Forward.Composition[U := V, domain := even].compose c.k r;
\definition data: Data := Data { d := c.d, e := c.e, h := h, k := k };
\definition laws: Laws[data] := Laws[data] {
  squareEven := squareEven, squareOdd := squareOdd,
  even := \fun (v: V) => trans!{{V}} _ _ _
    (congr!{{W} {V}} (\fun (w: W) => even.add (c.e.apply (c.k.apply (r.apply v))) (c.h.apply w)) _ _ (inverseD v)) (rightEven v),
  odd := \fun (w: W) => trans!{{W}} _ _ _
    (congr!{{V} {W}} (\fun (v: V) => odd.add (c.d.apply (c.h.apply (s.apply w))) (c.k.apply v)) _ _ (inverseE w)) (rightOdd w)
};
\definition contraction: Pair := \into[Data](data, Pair) \by { laws };
