\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DualFrame[V := F x, space := bundle.space x, n := c.dimension, frame := c.frame x] \as DualFrame;
\definition frame: Spaces.Isomorphism[V := Fiber x, W := Vector c.dimension, source := fiberSpace x, target := coordinates c.dimension].Isomorphism := DualFrame.isomorphism;
\definition evaluation: \forall (v: Vector c.dimension)(w: F x) -> frame.backward.apply v w = Spaces.Sums[I := Fin.Fin c.dimension].sum (Fin.elements c.dimension) (\fun (i: Fin.Fin c.dimension) => field.mul (v i) ((c.frame x).forward.apply w i)) := DualFrame.evaluation;
