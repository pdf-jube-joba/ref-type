\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Along[X := X, F := F, bundle := bundle, Y := Y, source := source, base := base] \as Vectors;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Along[X := X, F := Fiber, bundle := dual, Y := Y, source := source, base := base] \as Covectors;
\definition value[ell: Covectors.Vectors][v: Vectors.Vectors][y: Y]: K := ell y (v y);
\module In(c: SourceCharts.Chart);
\import topology.Continuity[A := Y, B := K].Covered[I := SourceCharts.Chart, domains := Vectors.domain] \as Covered;
\definition continuous: \forall (ell: Covectors.Vectors)(v: Vectors.Vectors) -> Vectors.BaseContinuous -> Covectors.Continuous ell -> Vectors.Continuous v ->
  topology.Continuity[A := Y, B := K].Continuous source scalar.topological.space (value ell v) :=
  \fun (ell: Covectors.Vectors)(v: Vectors.Vectors)(baseRegular: _)(ellRegular: _)(vRegular: _) => Covered.continuous source scalar.topological.space (value ell v)
    (\fun (c: SourceCharts.Chart) => baseRegular c.domain (\bysub(SourceCharts.ChartData, SourceCharts.Chart, c)).baseOpen)
    (\fun (y: Y) => Source.Of[bundle := bundle].locallyTrivial (base y))
    (\fun (c: SourceCharts.Chart) => In[c := c].continuous ell v ellRegular vRegular);
