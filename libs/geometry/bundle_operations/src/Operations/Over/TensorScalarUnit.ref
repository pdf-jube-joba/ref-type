\import Spaces.Tensor[V := K, W := V, left := Spaces.scalarSpace, right := space] \as Tensor;
\import Spaces.Laws[V := V, space := space] \as Laws;
\definition bilinear: Tensor.BilinearLaws[V, space, space.smul] := Tensor.BilinearLaws[V, space, space.smul] {
  addLeft := space.scalarAdd, addRight := space.vectorAdd, scaleLeft := space.scalarAssoc,
  scaleRight := \fun (a, b: K)(v: V) => Laws.scaleComm b a v
};
\import Tensor.Universal[U := V, target := space] \as Universal;
\definition forward: Spaces.Linear[V := Tensor.Carrier, W := V, source := Tensor.space, target := space].Map := Universal.map space.smul bilinear;
\definition onPure: \forall (a: K)(v: V) -> forward.apply (Tensor.tensor a v) = space.smul a v := Universal.onTensor space.smul bilinear;
\import Spaces.Linear[V := V, W := Tensor.Carrier, source := space, target := Tensor.space] \as Backward;
\definition backward: Backward.Map := Backward.Map {
  apply := Tensor.tensor field.one,
  preservesAdd := Tensor.bilinear.addRight field.one,
  preservesScale := \fun (a: K)(v: V) => Tensor.bilinear.scaleRight a field.one v
};
\import Spaces.Linear[V := V, W := Tensor.Carrier, source := space, target := Tensor.space].Composition[U := Tensor.Carrier, domain := Tensor.space] \as Composition;
\definition identity: Spaces.Linear[V := Tensor.Carrier, W := Tensor.Carrier, source := Tensor.space, target := Tensor.space].Map := Spaces.Linear[V := Tensor.Carrier, W := Tensor.Carrier, source := Tensor.space, target := Tensor.space].Map {
  apply := \fun (t: Tensor.Carrier) => t, preservesAdd := \fun (s, t: Tensor.Carrier) => \refl(Tensor.plus s t), preservesScale := \fun (a: K)(t: Tensor.Carrier) => \refl(Tensor.scale a t)
};
\definition leftInverse: \forall (t: Tensor.Carrier) -> backward.apply (forward.apply t) = t :=
  \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorEquality[V := K, W := V, U := Tensor.Carrier, left := Spaces.scalarSpace, right := space, target := Tensor.space].pointwise (Composition.compose backward forward) identity
    (\fun (a: K)(v: V) => trans!{{Tensor.Carrier}} _ _ _ (congr!{V {Tensor.Carrier}} backward.apply _ _ (onPure a v))
      (trans!{{Tensor.Carrier}} _ _ _ (Tensor.bilinear.scaleRight a field.one v)
        (trans!{{Tensor.Carrier}} _ _ _ (sym!{{Tensor.Carrier}} _ _ (Tensor.bilinear.scaleLeft a field.one v))
          (congr!{K {Tensor.Carrier}} (\fun (a: K) => Tensor.tensor a v) _ _ (Spaces.mulOneRight a)))));
\definition rightInverse: \forall (v: V) -> forward.apply (backward.apply v) = v := \fun (v: V) => trans!{V} _ _ _ (onPure field.one v) (space.scalarOne v);
\definition isomorphism: Spaces.Isomorphism[V := Tensor.Carrier, W := V, source := Tensor.space, target := space].Isomorphism :=
  Spaces.Isomorphism[V := Tensor.Carrier, W := V, source := Tensor.space, target := space].Isomorphism { forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse };
