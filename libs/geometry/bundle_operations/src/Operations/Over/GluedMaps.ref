\import Bundles.Family[X := X, F := F] \as Source;
\import Bundles.Family[X := X, F := G] \as Target;
\import Bundles.Morphisms[X := X, Y := X, F := F, G := G, source := source, target := target, f := (\fun (x: X) => x)] \as Maps;
\import topology.Topology[Carrier := X] \as Base;
\use Logic.either;
\module Part(U: \Pow X);
\import Part[U := S] \as First;
\import Part[U := T] \as Second;
\module With(first: First.Map, second: Second.Map,
  compatible: \forall (x: X)(s: \In[X] S x)(t: \In[X] T x)(v: F x) ->
    (first.fiber (\into[X](x, S) \by { s })).apply v = (second.fiber (\into[X](x, T) \by { t })).apply v);
