\import Spaces.Blocks[V := F x, W := G x, left := left.space x, right := right.space x] \as Blocks;
\import Spaces.Isomorphism[V := Sum.Fiber x, W := Sum.Fiber x, source := Sum.fiberSpace x, target := Sum.fiberSpace x] \as LinearIsomorphisms;
\definition leftLaw: \forall (v: Sum.Fiber x) -> (backward.fiber x).apply ((forward.fiber x).apply v) = v := (LinearIsomorphisms.laws (Blocks.lowerIsomorphism (h.fiber x) a)).leftInverse;
\definition rightLaw: \forall (v: Sum.Fiber x) -> (forward.fiber x).apply ((backward.fiber x).apply v) = v := (LinearIsomorphisms.laws (Blocks.lowerIsomorphism (h.fiber x) a)).rightInverse;
