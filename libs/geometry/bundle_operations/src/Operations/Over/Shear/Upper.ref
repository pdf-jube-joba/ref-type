\definition forward: Maps.Map := Pairing.pair (ToLeft.copair LeftIdentity.map (Rows.scale a h)) Projections.secondMap;
\definition backward: Maps.Map := Pairing.pair (ToLeft.copair LeftIdentity.map (Rows.scale (field.neg a) h)) Projections.secondMap;
\module At(x: X);
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := \fun (x: X) => At[x := x].leftLaw,
  rightInverse := \fun (x: X) => At[x := x].rightLaw
};
