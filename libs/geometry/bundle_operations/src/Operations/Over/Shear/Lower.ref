\import \parent.\parent.MapOperations[X := X, F := Sum.Fiber, G := G, source := bundle, target := right] \as Values;
\import Bundles.Morphisms[X := X, Y := X, F := Sum.Fiber, G := F, source := bundle, target := left, f := (\fun (x: X) => x)].Composition[
  Z := X, H := G, range := right, g := (\fun (x: X) => x)] \as Apply;
\definition forward: Maps.Map := Pairing.pair Projections.firstMap (Values.add Projections.secondMap (Apply.compose Projections.firstMap (Columns.scale a h)));
\definition backward: Maps.Map := Pairing.pair Projections.firstMap (Values.add Projections.secondMap (Apply.compose Projections.firstMap (Columns.scale (field.neg a) h)));
\module At(x: X);
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := \fun (x: X) => At[x := x].leftLaw,
  rightInverse := \fun (x: X) => At[x := x].rightLaw
};
