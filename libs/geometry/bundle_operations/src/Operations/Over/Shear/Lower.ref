\definition forward: Maps.Map := Pairing.pair Projections.firstMap (ToRight.copair (Columns.scale a h) RightIdentity.map);
\definition backward: Maps.Map := Pairing.pair Projections.firstMap (ToRight.copair (Columns.scale (field.neg a) h) RightIdentity.map);
\module At(x: X);
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := \fun (x: X) => At[x := x].leftLaw,
  rightInverse := \fun (x: X) => At[x := x].rightLaw
};
