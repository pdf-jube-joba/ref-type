\import \parent.\parent.Sum[first := first, second := tail.odd] \as Sum;
\definition value: Parity[first] := Parity[first] {
  even := Sum.value, odd := tail.even, inclusion := Sum.firstInclusion,
  forward := Sum.To[target := tail.even].copair (compose first second tail.even differential tail.inclusion) tail.backward,
  backward := Sum.From[domain := tail.even].pair (zero tail.even first) tail.forward
};
