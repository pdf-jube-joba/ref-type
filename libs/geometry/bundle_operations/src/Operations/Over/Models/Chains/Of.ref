\definition parity: Parity[complex.head] := fold complex.head complex.data;
\definition squareZero: SquareZero complex := \bysub(Diagram, Complex, complex);
\definition Even[x: X]: \Set := Fiber parity.even.ranks x;
\definition Odd[x: X]: \Set := Fiber parity.odd.ranks x;
\definition even: Bundles.Family[X := X, F := Even].Bundle := bundle parity.even;
\definition odd: Bundles.Family[X := X, F := Odd].Bundle := bundle parity.odd;
\definition ExactAt[x: X]: \Prop := Logic.And[
  \forall (v: Even x) -> (parity.forward.fiber x).apply v = (odd.space x).zero ->
    \exists (w: Odd x \where (parity.backward.fiber x).apply w = v),
  \forall (w: Odd x) -> (parity.backward.fiber x).apply w = (even.space x).zero ->
    \exists (v: Even x \where (parity.forward.fiber x).apply v = w)];
