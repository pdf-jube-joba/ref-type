\import Bundles.Trivial[X := X, n := n, baseSpace := baseSpace] \as Trivial;
\definition data: Data := Data { ranks := (\fun (x: X) => n), totalSpace := Trivial.topology };
\definition value: Bundle := \into[Data](data, Bundle) \by {
  Bundles.Family[X := X, F := (\fun (x: X) => Vector n)].Of[bundle := Trivial.bundle].locallyTrivial
};
