\import \parent.Pullback[b := p, Y := Y, source := source, f := f, regular := regular] \as First;
\import \parent.Pullback[b := q, Y := Y, source := source, f := f, regular := regular] \as Second;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Models[X := Y, baseSpace := source] \as Target;
\definition map[a: Map p q]: Target.Map First.value Second.value :=
  Bundles.ArrowLaws[X := X, Y := X, F := Fiber p.ranks, G := Fiber q.ranks, source := bundle p, target := bundle q, f := (\fun (x: X) => x)]
    .Pullback[Z := Y, space := source, g := f].Of[a := a, regular := regular].map;
