\import Sum.Of[same := (\refl(baseSpace))].To[Y := X, H := Fiber target.ranks, target := bundle target, f := (\fun (x: X) => x)] \as Original;
\definition copair[a: Map first target][b: Map second target]: Map value target :=
  Bundles.Morphisms[X := X, Y := X, F := Fiber value.ranks, G := Sum.Fiber, source := bundle value, target := source, f := (\fun (x: X) => x)]
    .Composition[Z := X, H := Fiber target.ranks, range := bundle target, g := (\fun (x: X) => x)].compose isomorphism.backward (Original.copair a b);
