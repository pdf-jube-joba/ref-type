\import Sum.Of[same := (\refl(baseSpace))].From[Y := X, H := Fiber domain.ranks, source := bundle domain, f := (\fun (x: X) => x)] \as Original;
\definition pair[a: Map domain first][b: Map domain second]: Map domain value :=
  Bundles.Morphisms[X := X, Y := X, F := Fiber domain.ranks, G := Sum.Fiber, source := bundle domain, target := source, f := (\fun (x: X) => x)]
    .Composition[Z := X, H := Fiber value.ranks, range := bundle value, g := (\fun (x: X) => x)].compose (Original.pair a b) isomorphism.forward;
