\import Bundles.Family[X := X, F := F] \as Family;
\import Family.With[data := original] \as Charts;
\import topology.Topology[Carrier := X] \as Base;
\definition Choice[x: X]: \Set := \Cast[Charts.Chart] ({ c: Charts.Chart \where Base.Member c.domain x });
\definition choices: \exists (\forall (x: X) -> Choice x) :=
  \axiom:classicalIndefiniteChoice(X, Choice, Family.Of[bundle := original].locallyTrivial);
\structure Result: \Set := {
  model: Bundle,
  isomorphism: Bundles.Isomorphisms[X := X, F := F, G := Fiber model.ranks, source := original, target := bundle model].Isomorphism
};
\module With(selection: \forall (x: X) -> Choice x);
\definition existence: original.baseSpace = baseSpace -> \exists Result := \block {
  \fun (same: original.baseSpace = baseSpace) \then
  \takefrom selection: (\forall (x: X) -> Choice x) \by choices \then
  \return \idelim original.baseSpace = baseSpace \with t: Base.Topology =>
    \exists \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Models[X := X, baseSpace := t].From[F := F, original := original].Result
    \by { base: \exact(With[selection := selection].result, \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Models[X := X, baseSpace := original.baseSpace].From[F := F, original := original].Result), equality: same }
};
