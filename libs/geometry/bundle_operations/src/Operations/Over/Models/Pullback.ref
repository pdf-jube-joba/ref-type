\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Models[X := Y, baseSpace := source] \as Target;
\import Bundles.Family[X := X, F := Fiber b.ranks].Of[bundle := bundle b].Pullback[Y := Y, source := source, f := f] \as Pull;
\definition ranks[y: Y]: N.Nat^ := b.ranks (f y);
\definition data: Target.Data := Target.Data { ranks := ranks, totalSpace := (Pull.pulled regular).totalSpace };
\definition value: Target.Bundle := \into[Target.Data](data, Target.Bundle) \by {
  Bundles.Family[X := Y, F := (\fun (y: Y) => Fiber b.ranks (f y))].Of[bundle := Pull.pulled regular].locallyTrivial
};
