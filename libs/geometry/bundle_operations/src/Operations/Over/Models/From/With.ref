\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Operations;
\import Operations.Models[X := X, baseSpace := original.baseSpace] \as Native;
\definition ranks[x: X]: N.Nat^ := (selection x).dimension;
\definition frame[x: X]: Spaces.Isomorphism[V := F x, W := Vector (ranks x), source := original.space x, target := coordinates (ranks x)].Isomorphism :=
  (selection x).frame (\into[X](x, (selection x).domain) \by { \bysub(Charts.Chart, { c: Charts.Chart \where Base.Member c.domain x }, selection x) });
\import Operations.Transport[X := X, F := F, G := Native.Fiber ranks, source := original,
  space := (\fun (x: X) => coordinates (ranks x)), isomorphism := frame] \as Transport;
\definition data: Native.Data := Native.Data { ranks := ranks, totalSpace := Transport.topology };
\definition value: Native.Bundle := \into[Native.Data](data, Native.Bundle) \by {
  Bundles.Family[X := X, F := Native.Fiber ranks].Of[bundle := Transport.bundle].locallyTrivial
};
\definition result: Native.From[F := F, original := original].Result := Native.From[F := F, original := original].Result {
  model := value, isomorphism := Transport.Comparison[].comparison
};
