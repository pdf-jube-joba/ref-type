\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := F, G := G, source := source, target := middle] \as First;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := G, G := H, source := middle, target := target] \as Second;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := F, G := H, source := source, target := target] \as Result;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := F, G := G, source := source, target := middle, f := \fun (x: X) => x].Composition[Z := X, H := H, range := target, g := \fun (x: X) => x] \as Forward;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := H, G := G, source := target, target := middle, f := \fun (x: X) => x].Composition[Z := X, H := F, range := source, g := \fun (x: X) => x] \as Backward;
\definition compose[a: First.Isomorphism][b: Second.Isomorphism]: Result.Isomorphism := Result.Isomorphism {
  forward := Forward.compose a.forward b.forward,
  backward := Backward.compose b.backward a.backward,
  leftInverse := \fun (x: X)(v: F x) => trans!{{F x}} _ _ _
    (congr!{{G x} {F x}} (a.backward.fiber x).apply _ _ ((\bysub(Second.Data, Second.Isomorphism, b)).leftInverse x ((a.forward.fiber x).apply v)))
    ((\bysub(First.Data, First.Isomorphism, a)).leftInverse x v),
  rightInverse := \fun (x: X)(w: H x) => trans!{{H x}} _ _ _
    (congr!{{G x} {H x}} (b.forward.fiber x).apply _ _ ((\bysub(First.Data, First.Isomorphism, a)).rightInverse x ((b.backward.fiber x).apply w)))
    ((\bysub(Second.Data, Second.Isomorphism, b)).rightInverse x w)
};

\definition exists: (\exists First.Isomorphism) -> (\exists Second.Isomorphism) -> \exists Result.Isomorphism := \block {
  \fun (first: \exists First.Isomorphism)(second: \exists Second.Isomorphism) \then
  \takefrom a: First.Isomorphism \by first \then
  \takefrom b: Second.Isomorphism \by second \then
  \return \exact(compose a b, Result.Isomorphism)
};
