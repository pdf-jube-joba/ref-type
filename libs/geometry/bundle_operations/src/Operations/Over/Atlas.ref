/* The final topology is constructed from parametrizations, before any bundle
 * topology or local triviality has been supplied. */
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F] \as Family;
\import topology.Topology[Carrier := X] \as Base;
\import topology.Topology[Carrier := Family.Point] \as Total;
\definition auxiliary: Family.Data := Family.Data { baseSpace := baseSpace, totalSpace := Total.Discrete, space := space };
\import Family.With[data := auxiliary] \as Coordinates;
\definition Chart: \Set := Coordinates.ChartData;
\module In(c: Chart);
\module Using(chart: I -> \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Atlas[X := X, I := I, F := F, baseSpace := baseSpace, space := space].Chart);
