\import Spaces.Linear[V := Target.Fiber x, W := Source.Fiber x, source := Target.fiberSpace x, target := Source.fiberSpace x].Composition[U := Source.Fiber x, domain := Source.fiberSpace x] \as LeftComposition;
\import Spaces.Linear[V := Source.Fiber x, W := Target.Fiber x, source := Source.fiberSpace x, target := Target.fiberSpace x].Composition[U := Target.Fiber x, domain := Target.fiberSpace x] \as RightComposition;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Identity[X := X, F := Source.Fiber, bundle := sourceBundle] \as SourceIdentity;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Identity[X := X, F := Target.Fiber, bundle := targetBundle] \as TargetIdentity;
\definition leftInverse: \forall (t: Source.Fiber x) -> ((backward a b).fiber x).apply (((forward a b).fiber x).apply t) = t :=
  \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorEquality[V := F x, W := G x, U := Source.Fiber x, left := first.space x, right := second.space x, target := Source.fiberSpace x].pointwise
    (LeftComposition.compose ((backward a b).fiber x) ((forward a b).fiber x)) (SourceIdentity.map.fiber x)
    (\fun (v: F x)(w: G x) => trans!{{Source.Fiber x}} _ _ _
      (congr!{{Target.Fiber x} {Source.Fiber x}} ((backward a b).fiber x).apply _ _ (Forward.onPure a.forward b.forward x v w))
      (trans!{{Source.Fiber x}} _ _ _ (Backward.onPure a.backward b.backward x ((a.forward.fiber x).apply v) ((b.forward.fiber x).apply w))
        (congr!{{F x} {G x} {Source.Fiber x}} (Source.pure x) _ _ _ _ ((\bysub(Left.Data, Left.Isomorphism, a)).leftInverse x v) ((\bysub(Right.Data, Right.Isomorphism, b)).leftInverse x w))));
\definition rightInverse: \forall (t: Target.Fiber x) -> ((forward a b).fiber x).apply (((backward a b).fiber x).apply t) = t :=
  \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorEquality[V := A x, W := B x, U := Target.Fiber x, left := newFirst.space x, right := newSecond.space x, target := Target.fiberSpace x].pointwise
    (RightComposition.compose ((forward a b).fiber x) ((backward a b).fiber x)) (TargetIdentity.map.fiber x)
    (\fun (v: A x)(w: B x) => trans!{{Target.Fiber x}} _ _ _
      (congr!{{Source.Fiber x} {Target.Fiber x}} ((forward a b).fiber x).apply _ _ (Backward.onPure a.backward b.backward x v w))
      (trans!{{Target.Fiber x}} _ _ _ (Forward.onPure a.forward b.forward x ((a.backward.fiber x).apply v) ((b.backward.fiber x).apply w))
        (congr!{{A x} {B x} {Target.Fiber x}} (Target.pure x) _ _ _ _ ((\bysub(Left.Data, Left.Isomorphism, a)).rightInverse x v) ((\bysub(Right.Data, Right.Isomorphism, b)).rightInverse x w))));
