\structure Laws: \Prop := {
  addFirst: \forall (v, z: V)(w: W)(u: U) -> value (left.add v z) w u = target.add (value v w u) (value z w u),
  addSecond: \forall (v: V)(w, z: W)(u: U) -> value v (middle.add w z) u = target.add (value v w u) (value v z u),
  addThird: \forall (v: V)(w: W)(u, z: U) -> value v w (right.add u z) = target.add (value v w u) (value v w z),
  scaleFirst: \forall (a: K)(v: V)(w: W)(u: U) -> value (left.smul a v) w u = target.smul a (value v w u),
  scaleSecond: \forall (a: K)(v: V)(w: W)(u: U) -> value v (middle.smul a w) u = target.smul a (value v w u),
  scaleThird: \forall (a: K)(v: V)(w: W)(u: U) -> value v w (right.smul a u) = target.smul a (value v w u)
};
\module With(laws: Laws);
