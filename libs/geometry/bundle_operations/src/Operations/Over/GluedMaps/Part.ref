\definition A: \Set := \Cast[X] U;
\import Source.Of[bundle := source].Restriction[U := U] \as SourceRestriction;
\import Target.Of[bundle := target].Restriction[U := U] \as TargetRestriction;
\definition first: Bundles.Family[X := A, F := (\fun (x: A) => F x)].Bundle := SourceRestriction.restricted;
\definition second: Bundles.Family[X := A, F := (\fun (x: A) => G x)].Bundle := TargetRestriction.restricted;
\definition Map: \Set := Bundles.Morphisms[X := A, Y := A, F := (\fun (x: A) => F x), G := (\fun (x: A) => G x), source := first, target := second, f := (\fun (x: A) => x)].Map;
