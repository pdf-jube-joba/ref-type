\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorDistribution[X := X, F := A, G := B, H := C, left := first, middle := second, right := third, sameMiddle := sameSecond, sameRight := sameThird] \as Source;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorDistribution[X := X, F := D, G := E, H := F, left := newFirst, middle := newSecond, right := newThird, sameMiddle := newSameSecond, sameRight := newSameThird] \as Target;
\definition lastBase: second.baseSpace = third.baseSpace := trans!{{topology.Topology[Carrier := X].Topology}} _ _ _ (sym!{{topology.Topology[Carrier := X].Topology}} _ _ sameSecond) sameThird;
\definition newLastBase: newSecond.baseSpace = newThird.baseSpace := trans!{{topology.Topology[Carrier := X].Topology}} _ _ _ (sym!{{topology.Topology[Carrier := X].Topology}} _ _ newSameSecond) newSameThird;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := B, G := C, left := second, right := third] \as BC;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := E, G := F, left := newSecond, right := newThird] \as EF;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := A, G := B, left := first, right := second] \as AB;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := A, G := C, left := first, right := third] \as AC;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := D, G := E, left := newFirst, right := newSecond] \as DE;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := D, G := F, left := newFirst, right := newThird] \as DF;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := A, G := BC.Fiber, left := first, right := BC.bundle lastBase] \as SourceTensor;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := D, G := EF.Fiber, left := newFirst, right := EF.bundle newLastBase] \as TargetTensor;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := AB.Fiber, G := AC.Fiber, left := Source.firstBundle, right := Source.secondBundle] \as SourceSum;
\import BC.Of[same := lastBase].Mapping[Y := X, A := E, B := F, leftTarget := newSecond, rightTarget := newThird, f := \fun (x: X) => x, targetSame := newLastBase] \as SumMap;
\import AB.Of[same := sameSecond].Mapping[Y := X, A := D, B := E, leftTarget := newFirst, rightTarget := newSecond, f := \fun (x: X) => x].Of[targetSame := newSameSecond] \as FirstMap;
\import AC.Of[same := sameThird].Mapping[Y := X, A := D, B := F, leftTarget := newFirst, rightTarget := newThird, f := \fun (x: X) => x].Of[targetSame := newSameThird] \as SecondMap;
\import SourceTensor.Of[same := sameSecond].Mapping[Y := X, A := D, B := EF.Fiber, leftTarget := newFirst, rightTarget := EF.bundle newLastBase, f := \fun (x: X) => x].Of[targetSame := newSameSecond] \as InputMap;
\import SourceSum.Of[same := \refl(first.baseSpace)].Mapping[Y := X, A := DE.Fiber, B := DF.Fiber, leftTarget := Target.firstBundle, rightTarget := Target.secondBundle, f := \fun (x: X) => x, targetSame := \refl(newFirst.baseSpace)] \as OutputMap;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Target.SourceFiber, source := Source.sourceBundle, target := Target.sourceBundle, f := \fun (x: X) => x].Composition[Z := X, H := Target.TargetFiber, range := Target.targetBundle, g := \fun (x: X) => x] \as FirstPath;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Source.TargetFiber, source := Source.sourceBundle, target := Source.targetBundle, f := \fun (x: X) => x].Composition[Z := X, H := Target.TargetFiber, range := Target.targetBundle, g := \fun (x: X) => x] \as SecondPath;
\definition firstPath: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Target.TargetFiber, source := Source.sourceBundle, target := Target.targetBundle, f := \fun (x: X) => x].Map := FirstPath.compose (InputMap.map a (SumMap.map b c)) Target.isomorphism.forward;
\definition secondPath: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Target.TargetFiber, source := Source.sourceBundle, target := Target.targetBundle, f := \fun (x: X) => x].Map := SecondPath.compose Source.isomorphism.forward (OutputMap.map (FirstMap.map a b) (SecondMap.map a c));
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Target.TargetFiber, source := Source.sourceBundle, target := Target.targetBundle, f := \fun (x: X) => x] \as Result;
\module At(x: X);
\definition naturality: firstPath = secondPath := Result.ext firstPath secondPath (\fun (x: X) => At[x := x].equality);
