\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Zero[X := X, baseSpace := first.baseSpace] \as Line;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumAssociator[X := X, F := A, G := \fun (x: X) => Line.Fiber, H := B, left := first, middle := Line.bundle, right := second, sameMiddle := \refl(first.baseSpace), sameRight := sameBase] \as Associate;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := A, G := \fun (x: X) => Line.Fiber, left := first, right := Line.bundle] \as RightDirectSum;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := \fun (x: X) => Line.Fiber, G := B, left := Line.bundle, right := second] \as LeftDirectSum;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := A, G := B, left := first, right := second] \as Target;
\definition targetBundle: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Target.Fiber].Bundle := Target.bundle sameBase;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumUnitAtBase[X := X, F := B, bundle := second, baseSpace := first.baseSpace, sameBase := sameBase] \as LeftUnit;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumRightUnit[X := X, F := A, bundle := first] \as RightUnit;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IdentityIsomorphism[X := X, F := A, bundle := first] \as FirstIdentity;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IdentityIsomorphism[X := X, F := B, bundle := second] \as SecondIdentity;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumIsomorphisms[X := X, F := A, G := LeftDirectSum.Fiber, A := A, B := B, first := first, second := LeftUnit.sourceBundle, newFirst := first, newSecond := second, sameSource := \refl(first.baseSpace), sameTarget := sameBase] \as LeftLast;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumIsomorphisms[X := X, F := RightDirectSum.Fiber, G := B, A := A, B := B, first := RightUnit.sum, second := second, newFirst := first, newSecond := second, sameSource := sameBase, sameTarget := sameBase] \as Right;
\definition lastStep: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Associate.TargetFiber, G := Target.Fiber, source := Associate.targetBundle, target := targetBundle].Isomorphism := LeftLast.isomorphism FirstIdentity.isomorphism LeftUnit.isomorphism;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismComposition[X := X, F := Associate.SourceFiber, G := Associate.TargetFiber, H := Target.Fiber, source := Associate.sourceBundle, middle := Associate.targetBundle, target := targetBundle] \as Composition;
\definition leftPath: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Associate.SourceFiber, G := Target.Fiber, source := Associate.sourceBundle, target := targetBundle].Isomorphism := Composition.compose Associate.isomorphism lastStep;
\definition rightPath: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Associate.SourceFiber, G := Target.Fiber, source := Associate.sourceBundle, target := targetBundle].Isomorphism := Right.isomorphism RightUnit.isomorphism SecondIdentity.isomorphism;
\module At(x: X);
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismEquality[X := X, F := Associate.SourceFiber, G := Target.Fiber, source := Associate.sourceBundle, target := targetBundle] \as Equality;
\definition triangle: leftPath = rightPath := Equality.ext leftPath rightPath (\fun (x: X) => At[x := x].equality);
