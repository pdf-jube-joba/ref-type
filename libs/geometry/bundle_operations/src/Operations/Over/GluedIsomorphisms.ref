\import \parent.GluedMaps[X := X, F := F, G := G, source := source, target := target, S := S, T := T, closedS := closedS, closedT := closedT, covers := covers] \as Forward;
\definition targetClosedS: topology.Topology[Carrier := X].IsClosedIn target.baseSpace S :=
  \idelim source.baseSpace = target.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Topology[Carrier := X].IsClosedIn t S \by { base: closedS, equality: same };
\definition targetClosedT: topology.Topology[Carrier := X].IsClosedIn target.baseSpace T :=
  \idelim source.baseSpace = target.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Topology[Carrier := X].IsClosedIn t T \by { base: closedT, equality: same };
\import \parent.GluedMaps[X := X, F := G, G := F, source := target, target := source, S := S, T := T,
  closedS := targetClosedS, closedT := targetClosedT, covers := covers] \as Backward;
\import Forward.Part[U := S] \as First;
\import Forward.Part[U := T] \as Second;
\import Bundles.Isomorphisms[X := First.A, F := (\fun (x: First.A) => F x), G := (\fun (x: First.A) => G x), source := First.first, target := First.second] \as FirstMaps;
\import Bundles.Isomorphisms[X := Second.A, F := (\fun (x: Second.A) => F x), G := (\fun (x: Second.A) => G x), source := Second.first, target := Second.second] \as SecondMaps;
\module With(first: FirstMaps.Isomorphism, second: SecondMaps.Isomorphism,
  compatible: \forall (x: X)(s: \In[X] S x)(t: \In[X] T x)(v: F x) ->
    (first.forward.fiber (\into[X](x, S) \by { s })).apply v = (second.forward.fiber (\into[X](x, T) \by { t })).apply v);
