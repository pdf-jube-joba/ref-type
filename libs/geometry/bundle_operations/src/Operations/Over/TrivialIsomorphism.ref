\import Bundles.Trivial[X := X, n := n, baseSpace := base] \as Source;
\import Bundles.Trivial[X := X, n := m, baseSpace := base] \as Target;
\import \parent.TrivialMap[X := X, n := n, m := m, base := base, linear := linear.forward] \as Forward;
\import \parent.TrivialMap[X := X, n := m, m := n, base := base, linear := linear.backward] \as Backward;
\import Spaces.Isomorphism[V := Vector n, W := Vector m, source := coordinates n, target := coordinates m] \as Linear;
\import Bundles.Isomorphisms[X := X, F := (\fun (x: X) => Vector n), G := (\fun (x: X) => Vector m), source := Source.bundle, target := Target.bundle] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := Forward.map, backward := Backward.map,
  leftInverse := \fun (x: X)(v: Vector n) => (Linear.laws linear).leftInverse v,
  rightInverse := \fun (x: X)(v: Vector m) => (Linear.laws linear).rightInverse v
};
