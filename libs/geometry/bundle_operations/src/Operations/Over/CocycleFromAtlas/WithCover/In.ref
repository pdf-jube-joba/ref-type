\import Glued.Local[i := i] \as Local;
\definition data: LocalMaps.ChartData := LocalMaps.ChartData {
  domain := domain i, dimension := dimension i,
  sourceFrame := (charts i).frame, targetFrame := Local.chartData.frame
};
\definition sourceLaws: SourceCharts.In[c := LocalMaps.In[c := data].sourceChart].Laws := \idelim (charts i) = LocalMaps.In[c := data].sourceChart
  \with c: SourceCharts.ChartData => SourceCharts.In[c := c].Laws \by {
    base: \bysub(SourceCharts.ChartData, SourceCharts.Chart, charts i),
    equality: sym!{{SourceCharts.ChartData}} _ _ (chartEta (charts i))
  };
\definition chart: LocalMaps.Chart := \into[LocalMaps.ChartData](data, LocalMaps.Chart) \by {
  LocalMaps.In[c := data].Laws {
    source := sourceLaws,
    target := \bysub(Family.With[data := bundleFromCocycle].ChartData, Family.With[data := bundleFromCocycle].Chart, Local.trivialization compatible),
    alignment := \fun (x: \Cast[X] (domain i))(v: F x) => frameAlignment x (\into[I](i, { i: I \where Base.Member (domain i) x }) \by { \bysub(X, domain i, x) }) v
  }
};
