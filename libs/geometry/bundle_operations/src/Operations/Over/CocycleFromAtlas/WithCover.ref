\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Constructed.Fiber] \as Family;
\definition regular: Constructed.Regular := Constructed.regular (continuous covers);
\definition bundleFromCocycle: Family.Bundle := Constructed.Construction[].bundle regular;
\definition fiber[x: X]: Spaces.Isomorphism[V := F x, W := Constructed.Fiber x, source := bundle.space x, target := Constructed.fiberSpace x].Isomorphism := fiberIsomorphism x (covers x);
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].LocalMaps[X := X, F := F, G := Constructed.Fiber, source := bundle, target := bundleFromCocycle, fiber := \fun (x: X) => (fiber x).forward] \as LocalMaps;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].LocalIsomorphisms[X := X, F := F, G := Constructed.Fiber, source := bundle, target := bundleFromCocycle, fiber := fiber] \as Comparison;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Atlas[X := X, I := I, F := Constructed.Fiber, baseSpace := bundle.baseSpace, space := Constructed.fiberSpace].Using[chart := Constructed.chart] \as Glued;
\definition compatible: Glued.Compatible := Constructed.Construction[].compatible regular;
\module In(i: I);
\definition covered: LocalMaps.Covers := \fun (x: X) => \block {
  \takefrom i: Glue.Index x \by covers x \then
  \return Logic.existsIntro[LocalMaps.Chart, { c: LocalMaps.Chart \where Base.Member c.domain x }] (In[i := i].chart)
    (\bysub(I, { i: I \where Base.Member (domain i) x }, i))
};
\definition isomorphism: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := F, G := Constructed.Fiber, source := bundle, target := bundleFromCocycle].Isomorphism := Comparison.isomorphism (\refl(bundle.baseSpace)) covered;
