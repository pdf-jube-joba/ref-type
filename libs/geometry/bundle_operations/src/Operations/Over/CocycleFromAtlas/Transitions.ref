\module Change(i, j: Glue.Index x);
\definition transition[i: Glue.Index x][j: Glue.Index x]: Glue.Linear i j := Change[i := i, j := j].isomorphism;
\definition identity: \forall (i: Glue.Index x)(v: Vector (dimension i)) -> (transition i i).forward.apply v = v :=
  \fun (i: Glue.Index x) => (Spaces.Isomorphism[V := F x, W := Vector (dimension i), source := bundle.space x, target := coordinates (dimension i)].laws (frame x i)).rightInverse;
\definition composition: \forall (i, j, k: Glue.Index x)(v: Vector (dimension i)) -> (transition j k).forward.apply ((transition i j).forward.apply v) = (transition i k).forward.apply v :=
  \fun (i, j, k: Glue.Index x)(v: Vector (dimension i)) => congr!{{F x} {Vector (dimension k)}} (frame x k).forward.apply _ _
    ((Spaces.Isomorphism[V := F x, W := Vector (dimension j), source := bundle.space x, target := coordinates (dimension j)].laws (frame x j)).leftInverse ((frame x i).backward.apply v));
