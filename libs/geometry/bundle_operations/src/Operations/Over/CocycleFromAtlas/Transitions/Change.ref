\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].LinearIsomorphisms[V := F x, W := Vector (dimension i), source := bundle.space x, target := coordinates (dimension i)] \as Inverse;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].LinearIsomorphisms[V := Vector (dimension i), W := F x, source := coordinates (dimension i), target := bundle.space x].After[U := Vector (dimension j), space := coordinates (dimension j)] \as Composition;
\definition isomorphism: Glue.Linear i j := Composition.compose (Inverse.inverse (frame x i)) (frame x j);
