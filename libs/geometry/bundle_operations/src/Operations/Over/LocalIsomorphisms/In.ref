\definition laws: Forward.In[c := c].Laws := \bysub(Forward.ChartData, Forward.Chart, c);
\definition chart: Backward.ChartData := Backward.ChartData { domain := c.domain, dimension := c.dimension, sourceFrame := c.targetFrame, targetFrame := c.sourceFrame };
\definition alignment: \forall (x: \Cast[X] c.domain)(w: G x) -> (c.sourceFrame x).forward.apply ((fiber x).backward.apply w) = (c.targetFrame x).forward.apply w :=
  \fun (x: \Cast[X] c.domain)(w: G x) => trans!{{Vector c.dimension}} _ _ _
    (sym!{{Vector c.dimension}} _ _ (laws.alignment x ((fiber x).backward.apply w)))
    (congr!{{G x} {Vector c.dimension}} (c.targetFrame x).forward.apply _ _ ((Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := target.space x].laws (fiber x)).rightInverse w));
\definition inverseChart: Backward.Chart := \into[Backward.ChartData](chart, Backward.Chart) \by {
  Backward.In[c := chart].Laws { source := laws.target, target := laws.source, alignment := alignment }
};
