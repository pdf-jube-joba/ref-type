\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].CocycleFromAtlas[X := X, I := J, F := F, bundle := bundle, charts := changed regular] \as Rebuild;
\definition cocycle: NewGlue.Cocycle := Rebuild.cocycle;
\import NewGlue.With[cocycle := cocycle] \as New;
\definition Fiber[x: X]: \Set := New.Fiber x;
\definition cocycleContinuous: New.Continuous := Rebuild.continuous covers;
\definition cocycleRegular: New.Regular := New.regular cocycleContinuous;
\definition glued: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Fiber].Bundle := Rebuild.WithCover[covers := covers].bundleFromCocycle;
\definition comparison: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := F, G := Fiber, source := bundle, target := glued].Isomorphism := Rebuild.WithCover[covers := covers].isomorphism;
\definition transitionFormula: \forall (x: X)(j, k: NewGlue.Index x)(v: Vector (newDimension j)) -> (cocycle.transition x j k).forward.apply v =
  (gauge k (point x k)).forward.apply ((originalFrame x k).forward.apply ((originalFrame x j).backward.apply ((gauge j (point x j)).backward.apply v))) :=
  \fun (x: X)(j, k: NewGlue.Index x)(v: Vector (newDimension j)) => \refl((gauge k (point x k)).forward.apply ((originalFrame x k).forward.apply ((originalFrame x j).backward.apply ((gauge j (point x j)).backward.apply v))));
