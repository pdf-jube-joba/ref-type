\import std.Data[].List[] \as Lists;
\import Spaces.Sums[I := I] \as Sums;
\definition continuous: \forall (xs: Lists.List[I])(source: topology.Topology[Carrier := X].Topology)(f: I -> X -> K) ->
  (\forall (i: I) -> Existing.Continuous source (f i)) -> Existing.Continuous source (\fun (x: X) => Sums.sum xs (\fun (i: I) => f i x)) :=
  \induction (xs: Lists.List[I]) \return \forall (source: topology.Topology[Carrier := X].Topology)(f: I -> X -> K) ->
    (\forall (i: I) -> Existing.Continuous source (f i)) -> Existing.Continuous source (\fun (x: X) => Sums.sum xs (\fun (i: I) => f i x)) \with {
    | nil: \fun (source: _)(f: _)(regular: _) => Existing.constant source field.zero
    | cons: \fun (head: I)(tail: Lists.List[I])(previous: _)(source: _)(f: _)(regular: _) =>
      Existing.addition source (f head) (\fun (x: X) => Sums.sum tail (\fun (i: I) => f i x)) (regular head) (previous source f regular)
  };
