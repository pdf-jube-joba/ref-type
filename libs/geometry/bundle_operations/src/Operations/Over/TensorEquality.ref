\import Spaces.Tensor[V := V, W := W, left := left, right := right] \as Tensor;
\import Tensor.Universal[U := U, target := target] \as Universal;
\import std.Set[].Quotient[A := Tensor.Expression, Equivalent := Tensor.Related] \as Classes;
\import Spaces.Linear[V := Tensor.Carrier, W := U, source := Tensor.space, target := target] \as Maps;
\definition pointwise: \forall (a, b: Maps.Map) -> (\forall (v: V)(w: W) -> a.apply (Tensor.tensor v w) = b.apply (Tensor.tensor v w)) -> \forall (t: Tensor.Carrier) -> a.apply t = b.apply t :=
  \fun (a, b: Maps.Map)(agrees: _) => Classes.induction (\fun (t: Tensor.Carrier) => a.apply t = b.apply t)
    (\fun (expression: Tensor.Expression) => trans!{U} _ _ _
      (Universal.expressionUnique (\fun (v: V)(w: W) => b.apply (Tensor.tensor v w)) a agrees expression)
      (sym!{U} _ _ (Universal.expressionUnique (\fun (v: V)(w: W) => b.apply (Tensor.tensor v w)) b (\fun (v: V)(w: W) => \refl(b.apply (Tensor.tensor v w))) expression)));
\definition ext: \forall (a, b: Maps.Map) -> (\forall (v: V)(w: W) -> a.apply (Tensor.tensor v w) = b.apply (Tensor.tensor v w)) -> a = b :=
  \fun (a, b: Maps.Map)(agrees: _) => Maps.ext a b (\axiom:funext(a.apply, b.apply, pointwise a b agrees));
