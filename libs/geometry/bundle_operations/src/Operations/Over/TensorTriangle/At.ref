\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := RightTensor.Fiber, G := B, left := RightUnit.tensor, right := second] \as Source;
\definition input[v: A x][a: K][w: B x]: Associate.SourceFiber x := Source.pure x (RightTensor.pure x v a) w;
\definition leftNormal: \forall (v: A x)(a: K)(w: B x) -> (leftPath.forward.fiber x).apply (input v a w) = Target.pure x v ((second.space x).smul a w) :=
  \fun (v: A x)(a: K)(w: B x) => trans!{{Target.Fiber x}} _ _ _
    (congr!{{Associate.TargetFiber x} {Target.Fiber x}} (lastStep.forward.fiber x).apply _ _ (Associate.onPure x v a w))
    (trans!{{Target.Fiber x}} _ _ _ (LeftLast.onPure FirstIdentity.isomorphism LeftUnit.isomorphism x v (LeftTensor.pure x a w))
      (congr!{{B x} {Target.Fiber x}} (Target.pure x v) _ _ (LeftUnit.onPure x a w)));
\definition rightNormal: \forall (v: A x)(a: K)(w: B x) -> (rightPath.forward.fiber x).apply (input v a w) = Target.pure x ((first.space x).smul a v) w :=
  \fun (v: A x)(a: K)(w: B x) => trans!{{Target.Fiber x}} _ _ _
    (Right.onPure RightUnit.isomorphism SecondIdentity.isomorphism x (RightTensor.pure x v a) w)
    (congr!{{A x} {Target.Fiber x}} (\fun (v: A x) => Target.pure x v w) _ _ (RightUnit.onPure x v a));
\import Spaces.Tensor[V := A x, W := B x, left := first.space x, right := second.space x] \as Native;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorTripleEquality[V := A x, W := K, U := B x, T := Target.Fiber x, left := first.space x, middle := Spaces.scalarSpace, right := second.space x, target := Target.fiberSpace x] \as Triple;
\definition equality: \forall (t: Associate.SourceFiber x) -> (leftPath.forward.fiber x).apply t = (rightPath.forward.fiber x).apply t := Triple.pointwise (leftPath.forward.fiber x) (rightPath.forward.fiber x)
  (\fun (v: A x)(a: K)(w: B x) => trans!{{Target.Fiber x}} _ _ _ (leftNormal v a w)
    (trans!{{Target.Fiber x}} _ _ _ (Native.bilinear.scaleRight a v w)
      (trans!{{Target.Fiber x}} _ _ _ (sym!{{Target.Fiber x}} _ _ (Native.bilinear.scaleLeft a v w)) (sym!{{Target.Fiber x}} _ _ (rightNormal v a w)))));
