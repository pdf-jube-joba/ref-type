\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := G] \as Target;
\definition Linear[x: X]: \Set := Spaces.Linear[V := F x, W := G (f x), source := space x, target := target.space (f x)].Map;
\definition total[fiber: \forall (x: X) -> Linear x][p: Family.Point]: Target.Point := Target.include (f p.base) ((fiber p.base).apply p.vector);
\definition LocallyContinuous[fiber: \forall (x: X) -> Linear x]: \Prop := \forall (i: I) ->
  topology.Continuity[A := \parent.\parent.In[c := chart i].Parameter, B := Target.Point].Continuous (\parent.\parent.In[c := chart i].topology) target.totalSpace
    (\fun (p: \parent.\parent.In[c := chart i].Parameter) => total fiber (\parent.\parent.In[c := chart i].parameter p));
\definition continuous: \forall (fiber: \forall (x: X) -> Linear x) -> LocallyContinuous fiber ->
  topology.Continuity[A := Family.Point, B := Target.Point].Continuous topology target.totalSpace (total fiber) :=
  \fun (fiber: _)(regular: _) => \parent.Universal[Z := Target.Point].continuous target.totalSpace (total fiber) regular;
\module Of(compatible: Compatible) {
  \import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := Y, F := F, G := G, source := bundle compatible, target := target, f := f] \as Maps;
  \definition map[fiber: \forall (x: X) -> Linear x][regular: LocallyContinuous fiber]: Maps.Map :=
    \into[Maps.Data](Maps.Data { fiber := fiber }, Maps.Map) \by { continuous fiber regular };
}
