\import topology.Topology[Carrier := Z] \as Target;
\definition local[source: Target.Topology][f: Family.Point -> Z]: \Prop := \forall (i: I) ->
  topology.Continuity[A := \parent.\parent.In[c := chart i].Parameter, B := Z].Continuous (\parent.\parent.In[c := chart i].topology) source
    (\fun (p: \parent.\parent.In[c := chart i].Parameter) => f (\parent.\parent.In[c := chart i].parameter p));
\definition continuous: \forall (target: Target.Topology)(f: Family.Point -> Z) -> local target f -> topology.Continuity[A := Family.Point, B := Z].Continuous topology target f :=
  \fun (target: _)(f: _)(regular: local target f) => Generated.Universal[Z := Z].continuous target f regular;
