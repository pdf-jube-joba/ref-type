\definition baBase: second.baseSpace = first.baseSpace := sym!{{topology.Topology[Carrier := X].Topology}} _ _ sameSecond;
\definition bcBase: second.baseSpace = third.baseSpace := trans!{{topology.Topology[Carrier := X].Topology}} _ _ _ baBase sameThird;
\definition caBase: third.baseSpace = first.baseSpace := sym!{{topology.Topology[Carrier := X].Topology}} _ _ sameThird;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := A, G := B, left := first, right := second] \as AB;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := A, G := C, left := first, right := third] \as AC;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := B, G := C, left := second, right := third] \as BC;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := B, G := A, left := second, right := first] \as BA;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := C, G := A, left := third, right := first] \as CA;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := A, G := BC.Fiber, left := first, right := BC.bundle bcBase] \as Source;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumAssociator[X := X, F := A, G := B, H := C, left := first, middle := second, right := third, sameMiddle := sameSecond, sameRight := sameThird] \as ABC;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumAssociator[X := X, F := B, G := A, H := C, left := second, middle := first, right := third, sameMiddle := baBase, sameRight := bcBase] \as BAC;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumAssociator[X := X, F := B, G := C, H := A, left := second, middle := third, right := first, sameMiddle := bcBase, sameRight := baBase] \as BCA;
\import Source.Of[same := sameSecond].Symmetry[] \as Swap;
\import AB.Of[same := sameSecond].Symmetry[] \as SwapAB;
\import AC.Of[same := sameThird].Symmetry[] \as SwapAC;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := ABC.SourceFiber, G := ABC.TargetFiber, source := ABC.sourceBundle, target := ABC.targetBundle] \as ABCIsomorphisms;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := BCA.SourceFiber, G := BCA.TargetFiber, source := BCA.sourceBundle, target := BCA.targetBundle] \as BCAIsomorphisms;
\definition firstStep: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := ABC.TargetFiber, G := ABC.SourceFiber, source := ABC.targetBundle, target := ABC.sourceBundle].Isomorphism := ABCIsomorphisms.inverse ABC.isomorphism;
\definition lastStep: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := BCA.TargetFiber, G := BCA.SourceFiber, source := BCA.targetBundle, target := BCA.sourceBundle].Isomorphism := BCAIsomorphisms.inverse BCA.isomorphism;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IdentityIsomorphism[X := X, F := C, bundle := third] \as ThirdIdentity;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IdentityIsomorphism[X := X, F := B, bundle := second] \as SecondIdentity;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumIsomorphisms[X := X, F := AB.Fiber, G := C, A := BA.Fiber, B := C, first := AB.bundle sameSecond, second := third, newFirst := BA.bundle baBase, newSecond := third, sameSource := sameThird, sameTarget := bcBase] \as Second;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumIsomorphisms[X := X, F := B, G := AC.Fiber, A := B, B := CA.Fiber, first := second, second := AC.bundle sameThird, newFirst := second, newSecond := CA.bundle caBase, sameSource := baBase, sameTarget := bcBase] \as Fourth;
\definition secondStep: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := ABC.SourceFiber, G := BAC.SourceFiber, source := ABC.sourceBundle, target := BAC.sourceBundle].Isomorphism := Second.isomorphism SwapAB.isomorphism ThirdIdentity.isomorphism;
\definition fourthStep: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := BAC.TargetFiber, G := BCA.TargetFiber, source := BAC.targetBundle, target := BCA.targetBundle].Isomorphism := Fourth.isomorphism SecondIdentity.isomorphism SwapAC.isomorphism;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismComposition[X := X, F := ABC.TargetFiber, G := ABC.SourceFiber, H := BAC.SourceFiber, source := ABC.targetBundle, middle := ABC.sourceBundle, target := BAC.sourceBundle] \as Composition1;
\definition path1: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := ABC.TargetFiber, G := BAC.SourceFiber, source := ABC.targetBundle, target := BAC.sourceBundle].Isomorphism := Composition1.compose firstStep secondStep;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismComposition[X := X, F := ABC.TargetFiber, G := BAC.SourceFiber, H := BAC.TargetFiber, source := ABC.targetBundle, middle := BAC.sourceBundle, target := BAC.targetBundle] \as Composition2;
\definition path2: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := ABC.TargetFiber, G := BAC.TargetFiber, source := ABC.targetBundle, target := BAC.targetBundle].Isomorphism := Composition2.compose path1 BAC.isomorphism;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismComposition[X := X, F := ABC.TargetFiber, G := BAC.TargetFiber, H := BCA.TargetFiber, source := ABC.targetBundle, middle := BAC.targetBundle, target := BCA.targetBundle] \as Composition3;
\definition path3: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := ABC.TargetFiber, G := BCA.TargetFiber, source := ABC.targetBundle, target := BCA.targetBundle].Isomorphism := Composition3.compose path2 fourthStep;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismComposition[X := X, F := ABC.TargetFiber, G := BCA.TargetFiber, H := BCA.SourceFiber, source := ABC.targetBundle, middle := BCA.targetBundle, target := BCA.sourceBundle] \as Composition4;
\definition path4: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := ABC.TargetFiber, G := BCA.SourceFiber, source := ABC.targetBundle, target := BCA.sourceBundle].Isomorphism := Composition4.compose path3 lastStep;
\definition direct: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := ABC.TargetFiber, G := BCA.SourceFiber, source := ABC.targetBundle, target := BCA.sourceBundle].Isomorphism := Swap.isomorphism;
\module At(x: X);
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismEquality[X := X, F := ABC.TargetFiber, G := BCA.SourceFiber, source := ABC.targetBundle, target := BCA.sourceBundle] \as Equality;
\definition hexagon: direct = path4 := Equality.ext direct path4 (\fun (x: X) => At[x := x].equality);
\definition SourceFiber[x: X]: \Set := ABC.TargetFiber x;
\definition TargetFiber[x: X]: \Set := BCA.SourceFiber x;
\definition sourceBundle: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := SourceFiber].Bundle := ABC.targetBundle;
\definition targetBundle: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := TargetFiber].Bundle := BCA.sourceBundle;
