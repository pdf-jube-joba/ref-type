\import real.Analysis[] \as R;
\import std.Alg[].Ring[] \as Ring;
\import linear_algebra.Commutative[K := R.Real, scalarRing := Fields.fieldAsCommutativeRing R.Real (R.Algebra[].field)] \as Real;
\definition action[a: R.Real][v: V]: V := space.smul (conjugation.embed a) v;
\definition realSpace: Real.VectorSpace V := Ring.RingModule[R.Real, V, Real.ring] {
  zero := space.zero, add := space.add, neg := space.neg, smul := action, additive := space.additive,
  scalarOne := \fun (v: V) => trans!{V} _ _ _ (congr!{K V} (\fun (a: K) => space.smul a v) _ _ conjugation.embedOne) (space.scalarOne v),
  scalarAssoc := \fun (a, b: R.Real)(v: V) => trans!{V} _ _ _ (congr!{K V} (\fun (s: K) => space.smul s v) _ _ (conjugation.embedMul a b)) (space.scalarAssoc (conjugation.embed a) (conjugation.embed b) v),
  scalarAdd := \fun (a, b: R.Real)(v: V) => trans!{V} _ _ _ (congr!{K V} (\fun (s: K) => space.smul s v) _ _ (conjugation.embedAdd a b)) (space.scalarAdd (conjugation.embed a) (conjugation.embed b) v),
  vectorAdd := \fun (a: R.Real)(v, w: V) => space.vectorAdd (conjugation.embed a) v w
};
\module Maps(W: \Set, target: Spaces.VectorSpace W);
