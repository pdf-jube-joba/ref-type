\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ScalarLine[X := X, baseSpace := baseSpace] \as Line;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ScalarLine[X := X, baseSpace := bundle.baseSpace] \as TargetLine;
\import Line.Equality[space := bundle.baseSpace, sameBase := sameBase] \as LineChange;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorUnit[X := X, F := F, bundle := bundle] \as Unit;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := \fun (x: X) => K, G := F, left := Line.bundle, right := bundle] \as Source;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := \fun (x: X) => K, G := F, left := TargetLine.bundle, right := bundle] \as Target;
\definition sourceBundle: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Source.Fiber].Bundle := Source.bundle sameBase;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IdentityIsomorphism[X := X, F := F, bundle := bundle] \as Identity;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorIsomorphisms[X := X, F := \fun (x: X) => K, G := F, A := \fun (x: X) => K, B := F, first := Line.bundle, second := bundle, newFirst := TargetLine.bundle, newSecond := bundle, sameSource := sameBase, sameTarget := \refl(bundle.baseSpace)] \as Change;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismComposition[X := X, F := Source.Fiber, G := Target.Fiber, H := F, source := sourceBundle, middle := Unit.tensor, target := bundle] \as Composition;
\definition isomorphism: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Source.Fiber, G := F, source := sourceBundle, target := bundle].Isomorphism := Composition.compose (Change.isomorphism LineChange.isomorphism Identity.isomorphism) Unit.isomorphism;
\definition onPure: \forall (x: X)(a: K)(v: F x) -> (isomorphism.forward.fiber x).apply (Source.pure x a v) = (bundle.space x).smul a v :=
  \fun (x: X)(a: K)(v: F x) => trans!{{F x}} _ _ _ (congr!{{Target.Fiber x} {F x}} (Unit.forward.fiber x).apply _ _ (Change.onPure LineChange.isomorphism Identity.isomorphism x a v)) (Unit.onPure x a v);
