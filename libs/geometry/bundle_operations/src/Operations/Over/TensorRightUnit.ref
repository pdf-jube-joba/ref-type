\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ScalarLine[X := X, baseSpace := bundle.baseSpace] \as Line;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorUnit[X := X, F := F, bundle := bundle] \as LeftUnit;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := F, G := \fun (x: X) => K, left := bundle, right := Line.bundle] \as RightTensor;
\definition tensor: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := RightTensor.Fiber].Bundle := RightTensor.bundle (\refl(bundle.baseSpace));
\import RightTensor.Of[same := \refl(bundle.baseSpace)].Symmetry[] \as Swap;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismComposition[X := X, F := RightTensor.Fiber,
  G := \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := \fun (x: X) => K, G := F, left := Line.bundle, right := bundle].Fiber,
  H := F, source := tensor, middle := LeftUnit.tensor, target := bundle] \as Composition;
\definition isomorphism: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := RightTensor.Fiber, G := F, source := tensor, target := bundle].Isomorphism := Composition.compose Swap.isomorphism LeftUnit.isomorphism;
\import RightTensor.Of[same := \refl(bundle.baseSpace)].Transpose[] \as Flip;
\definition onPure: \forall (x: X)(v: F x)(a: K) -> (isomorphism.forward.fiber x).apply (RightTensor.pure x v a) = (bundle.space x).smul a v :=
  \fun (x: X)(v: F x)(a: K) => trans!{{F x}} _ _ _ (congr!{{\root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := \fun (x: X) => K, G := F, left := Line.bundle, right := bundle].Fiber x} {F x}} (LeftUnit.forward.fiber x).apply _ _ (Flip.onPure x v a)) (LeftUnit.onPure x a v);
