\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Hom[X := X, F := F, G := G, left := left, right := right].Of[same := same].Evaluation[].At[x := x] \as OldEvaluation;
\import Other.Of[same := newSame].Evaluation[].At[x := x] \as NewEvaluation;
\import Other.At[x := x] \as NewPhi;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Hom[X := X, F := F, G := G, left := left, right := right].At[x := x] \as OldPhi;
\import Spaces.Linear[V := NewTensor.Fiber x, W := B x, source := NewTensor.fiberSpace x, target := newRight.space x].Composition[U := Tensor.Fiber x, domain := Tensor.fiberSpace x] \as ComposeLeft;
\import Spaces.Linear[V := G x, W := B x, source := right.space x, target := newRight.space x].Composition[U := Tensor.Fiber x, domain := Tensor.fiberSpace x] \as ComposeRight;
\definition first: Spaces.Linear[V := Tensor.Fiber x, W := B x, source := Tensor.fiberSpace x, target := newRight.space x].Map := ComposeLeft.compose (NewEvaluation.operator v) ((TensorMapping.map (Contramap.map a) b).fiber x);
\definition second: Spaces.Linear[V := Tensor.Fiber x, W := B x, source := Tensor.fiberSpace x, target := newRight.space x].Map := ComposeRight.compose (b.fiber x) (OldEvaluation.operator ((a.fiber x).apply v));
\definition firstNormal: \forall (ell: Dual.Fiber x)(w: G x) -> first.apply (Tensor.pure x ell w) = (newRight.space x).smul (ell ((a.fiber x).apply v)) ((b.fiber x).apply w) :=
  \fun (ell: Dual.Fiber x)(w: G x) => trans!{{B x}} _ _ _
    (congr!{{NewTensor.Fiber x} {B x}} (NewEvaluation.operator v).apply _ _ (TensorMapping.onPure (Contramap.map a) b x ell w))
    (NewPhi.onPure (((Contramap.map a).fiber x).apply ell) ((b.fiber x).apply w) v);
\definition secondNormal: \forall (ell: Dual.Fiber x)(w: G x) -> second.apply (Tensor.pure x ell w) = (newRight.space x).smul (ell ((a.fiber x).apply v)) ((b.fiber x).apply w) :=
  \fun (ell: Dual.Fiber x)(w: G x) => trans!{{B x}} _ _ _
    (congr!{{G x} {B x}} (b.fiber x).apply _ _ (OldPhi.onPure ell w ((a.fiber x).apply v)))
    ((b.fiber x).preservesScale (ell ((a.fiber x).apply v)) w);
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorEquality[V := Dual.Fiber x, W := G x, U := B x, left := Dual.fiberSpace x, right := right.space x, target := newRight.space x] \as Equality;
\definition equality: \forall (t: Tensor.Fiber x) -> first.apply t = second.apply t := Equality.pointwise first second (\fun (ell: Dual.Fiber x)(w: G x) => trans!{{B x}} _ _ _ (firstNormal ell w) (sym!{{B x}} _ _ (secondNormal ell w)));
