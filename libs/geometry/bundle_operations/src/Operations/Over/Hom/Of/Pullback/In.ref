\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Hom[X := X, F := F, G := G, left := left, right := right].Of[same := same].In[c := c, d := d, enumeration := enumeration] \as Original;
\import HomPullback.In[c := Original.trivialization] \as First;
\import LeftPullback.In[c := c] \as LeftChart;
\import RightPullback.In[c := d] \as RightChart;
\import PulledHom.Of[same := \refl(source)].In[c := LeftChart.trivialization regular, d := RightChart.trivialization rightRegular, enumeration := enumeration] \as Second;
\definition data: Charts.ChartData := Charts.ChartData {
  domain := First.domain, dimension := First.chart.dimension,
  sourceFrame := First.chart.frame, targetFrame := Second.chart.frame
};
\definition chart: Charts.Chart := \into[Charts.ChartData](data, Charts.Chart) \by {
  Charts.In[c := data].Laws {
    source := First.laws regular,
    target := \bysub(vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := \fun (y: Y) => Fiber (f y)].With[data := secondBundle].ChartData,
      vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := \fun (y: Y) => Fiber (f y)].With[data := secondBundle].Chart, Second.trivialization),
    alignment := \fun (y: \Cast[Y] First.domain)(v: Fiber (f y)) => \refl((First.chart.frame y).forward.apply v)
  }
};
