\import Spaces.Linear[V := Fiber x, W := G x, source := fiberSpace x, target := right.space x] \as Evaluations;
\definition evaluation[v: F x]: Evaluations.Map := Evaluations.Map {
  apply := \fun (h: Fiber x) => h.apply v,
  preservesAdd := \fun (h, g: Fiber x) => \refl((right.space x).add (h.apply v) (g.apply v)),
  preservesScale := \fun (a: K)(h: Fiber x) => \refl((right.space x).smul a (h.apply v))
};
\import Evaluations.Composition[U := Tensor.Fiber x, domain := Tensor.fiberSpace x] \as Composition;
\definition operator[v: F x]: Spaces.Linear[V := Tensor.Fiber x, W := G x, source := Tensor.fiberSpace x, target := right.space x].Map := Composition.compose (evaluation v) (\root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Hom[X := X, F := F, G := G, left := left, right := right].At[x := x].forward);
