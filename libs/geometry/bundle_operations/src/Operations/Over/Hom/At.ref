\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorHom[V := F x, W := G x, source := left.space x, target := right.space x] \as Phi;
\import Spaces.Isomorphism[V := Tensor.Fiber x, W := Fiber x, source := Tensor.fiberSpace x, target := fiberSpace x] \as Isomorphisms;
\definition forward: Spaces.Linear[V := Tensor.Fiber x, W := Fiber x, source := Tensor.fiberSpace x, target := fiberSpace x].Map := Phi.forward;
\definition injective: \forall (a, b: Tensor.Fiber x) -> forward.apply a = forward.apply b -> a = b :=
  \fun (a, b: Tensor.Fiber x)(same: _) => \block {
    \takefrom c: \Cast[SourceCharts.Chart] ({ c: SourceCharts.Chart \where Base.Member c.domain x }) \by Source.Of[bundle := left].locallyTrivial x \then
    \let point: \Cast[X] c.domain := \into[X](x, c.domain) \by { \bysub(SourceCharts.Chart, { c: SourceCharts.Chart \where Base.Member c.domain x }, c) } \then
    \return Isomorphisms.injective (Phi.Finite[n := c.dimension, frame := c.frame point].isomorphism) a b same
  };
\definition onto: \forall (h: Fiber x) -> \exists ( t: Tensor.Fiber x \where forward.apply t = h ) :=
  \fun (h: Fiber x) => \block {
    \takefrom c: \Cast[SourceCharts.Chart] ({ c: SourceCharts.Chart \where Base.Member c.domain x }) \by Source.Of[bundle := left].locallyTrivial x \then
    \let point: \Cast[X] c.domain := \into[X](x, c.domain) \by { \bysub(SourceCharts.Chart, { c: SourceCharts.Chart \where Base.Member c.domain x }, c) } \then
    \return Isomorphisms.surjective (Phi.Finite[n := c.dimension, frame := c.frame point].isomorphism) h
  };
\definition onPure: \forall (ell: Dual.Fiber x)(w: G x)(v: F x) -> (forward.apply (Tensor.pure x ell w)).apply v = (right.space x).smul (ell v) w :=
  \fun (ell: Dual.Fiber x)(w: G x)(v: F x) => congr!{{Fiber x} {G x}} (\fun (h: Fiber x) => h.apply v) _ _ (Phi.onPure ell w);
