\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Transport[X := X, F := Tensor.Fiber, G := Fiber, source := Tensor.bundle same, space := fiberSpace, isomorphism := isomorphism] \as Change;
\definition hom: Family.Bundle := Change.bundle;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Tensor.Fiber, G := Fiber, source := Tensor.bundle same, target := hom] \as Isomorphisms;
\definition tensorHom: Isomorphisms.Isomorphism := Change.Comparison[].comparison;
\definition forwardContinuous: topology.Continuity[A := vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Tensor.Fiber].Point, B := Family.Point].Continuous Tensor.topology hom.totalSpace Change.forward := Change.forwardContinuous;
\definition inverseContinuous: topology.Continuity[A := Family.Point, B := vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Tensor.Fiber].Point].Continuous hom.totalSpace Tensor.topology Change.backward := Change.backwardContinuous;
\module In(c: SourceCharts.Chart,
  d: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := G].With[data := right].Chart,
  enumeration: \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].PairIndices[n := c.dimension, m := d.dimension].Enumeration);
\module Pullback(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  regular: topology.Continuity[A := Y, B := X].Continuous source left.baseSpace f);
\module Evaluation;
\module Section(value: \forall (x: X) -> Fiber x,
  regular: topology.Continuity[A := X, B := Family.Point].Continuous left.baseSpace hom.totalSpace
    (\fun (x: X) => Family.include x (value x)));
\module Mapping(A, B: X -> \Set, newLeft: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := A].Bundle, newRight: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := B].Bundle, sameLeft: left.baseSpace = newLeft.baseSpace, sameRight: left.baseSpace = newRight.baseSpace);
