\import topology.Topology[Carrier := X] \as Base;
\definition Index[x: X]: \Set := \Cast[I] ({ i: I \where Base.Member (domain i) x });
\definition Linear[i, j: I]: \Set := Spaces.Isomorphism[V := Vector (dimension i), W := Vector (dimension j), source := coordinates (dimension i), target := coordinates (dimension j)].Isomorphism;
\structure Data: \Set := { transition: \forall (x: X)(i, j: Index x) -> Linear i j };
\structure Laws[data: Data]: \Prop := {
  identity: \forall (x: X)(i: Index x)(v: Vector (dimension i)) -> (data.transition x i i).forward.apply v = v,
  composition: \forall (x: X)(i, j, k: Index x)(v: Vector (dimension i)) ->
    (data.transition x j k).forward.apply ((data.transition x i j).forward.apply v) = (data.transition x i k).forward.apply v,
};
\definition Cocycle: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module With(cocycle: \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Cocycle[X := X, I := I, baseSpace := baseSpace, domain := domain, dimension := dimension].Cocycle);
