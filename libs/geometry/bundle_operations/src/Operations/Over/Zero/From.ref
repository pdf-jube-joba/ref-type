\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F] \as Source;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := F, G := \fun (x: X) => Fiber, source := source, target := bundle, f := \fun (x: X) => x] \as Maps;
\definition data: Maps.Data := Maps.Data { fiber := \fun (x: X) => Spaces.Linear[V := F x, W := Fiber, source := source.space x, target := coordinates zero].Operations[].zeroMap };
\import Family.Of[bundle := bundle].Sections[] \as Sections;
\definition baseContinuous: topology.Continuity[A := Source.Point, B := X].Continuous source.totalSpace baseSpace Source.projection :=
  \idelim source.baseSpace = baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Continuity[A := Source.Point, B := X].Continuous source.totalSpace t Source.projection \by { base: Source.Of[bundle := source].projectionContinuous, equality: sameBase };
\definition map: Maps.Map := \into[Maps.Data](data, Maps.Map) \by {
  topology.Composition[A := Source.Point, B := X, C := Family.Point].composeContinuous source.totalSpace baseSpace bundle.totalSpace Source.projection (Sections.total Sections.zero) baseContinuous (Sections.continuous Sections.zero)
};
\definition unique: \forall (a: Maps.Map) -> a = map := \fun (a: Maps.Map) => Maps.ext a map (\fun (x: X)(v: F x) => Empty.unique ((a.fiber x).apply v) ((map.fiber x).apply v));
