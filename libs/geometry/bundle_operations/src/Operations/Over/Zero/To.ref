\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F] \as Target;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := \fun (x: X) => Fiber, G := F, source := bundle, target := target, f := \fun (x: X) => x] \as Maps;
\definition data: Maps.Data := Maps.Data { fiber := \fun (x: X) => Spaces.Linear[V := Fiber, W := F x, source := coordinates zero, target := target.space x].Operations[].zeroMap };
\import Target.Of[bundle := target].Sections[] \as Sections;
\definition baseContinuous: topology.Continuity[A := Family.Point, B := X].Continuous bundle.totalSpace target.baseSpace Family.projection :=
  \idelim baseSpace = target.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Continuity[A := Family.Point, B := X].Continuous bundle.totalSpace t Family.projection \by { base: Family.Of[bundle := bundle].projectionContinuous, equality: sameBase };
\definition map: Maps.Map := \into[Maps.Data](data, Maps.Map) \by {
  topology.Composition[A := Family.Point, B := X, C := Target.Point].composeContinuous bundle.totalSpace target.baseSpace target.totalSpace Family.projection (Sections.total Sections.zero) baseContinuous (Sections.continuous Sections.zero)
};
\definition unique: \forall (a: Maps.Map) -> a = map := \fun (a: Maps.Map) => Maps.ext a map (\fun (x: X)(v: Fiber) => trans!{{F x}} _ _ _
  (congr!{Fiber {F x}} (a.fiber x).apply v (coordinates zero).zero (Empty.unique v (coordinates zero).zero)) (a.fiber x).preservesZero);
