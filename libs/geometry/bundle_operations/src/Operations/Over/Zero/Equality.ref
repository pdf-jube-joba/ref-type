\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Zero[X := X, baseSpace := space] \as Other;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ZeroMap[X := X, F := \fun (x: X) => Fiber, G := \fun (x: X) => Fiber, source := bundle, target := Other.bundle, sameBase := sameBase] \as Forward;
\definition reverseBase: space = baseSpace := sym!{{topology.Topology[Carrier := X].Topology}} _ _ sameBase;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ZeroMap[X := X, F := \fun (x: X) => Fiber, G := \fun (x: X) => Fiber, source := Other.bundle, target := bundle, sameBase := reverseBase] \as Backward;
\definition isomorphism: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := \fun (x: X) => Fiber, G := \fun (x: X) => Fiber, source := bundle, target := Other.bundle].Isomorphism :=
  vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := \fun (x: X) => Fiber, G := \fun (x: X) => Fiber, source := bundle, target := Other.bundle].Isomorphism {
    forward := Forward.map, backward := Backward.map,
    leftInverse := \fun (x: X)(v: Fiber) => Empty.unique ((Backward.map.fiber x).apply ((Forward.map.fiber x).apply v)) v,
    rightInverse := \fun (x: X)(v: Fiber) => Empty.unique ((Forward.map.fiber x).apply ((Backward.map.fiber x).apply v)) v
  };
