\definition bcBase: second.baseSpace = third.baseSpace := trans!{{topology.Topology[Carrier := X].Topology}} _ _ _ (sym!{{topology.Topology[Carrier := X].Topology}} _ _ sameSecond) sameThird;
\definition bdBase: second.baseSpace = fourth.baseSpace := trans!{{topology.Topology[Carrier := X].Topology}} _ _ _ (sym!{{topology.Topology[Carrier := X].Topology}} _ _ sameSecond) sameFourth;
\definition cdBase: third.baseSpace = fourth.baseSpace := trans!{{topology.Topology[Carrier := X].Topology}} _ _ _ (sym!{{topology.Topology[Carrier := X].Topology}} _ _ sameThird) sameFourth;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := A, G := B, left := first, right := second] \as AB;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := B, G := C, left := second, right := third] \as BC;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := C, G := D, left := third, right := fourth] \as CD;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorAssociator[X := X, F := A, G := B, H := C, left := first, middle := second, right := third, sameMiddle := sameSecond, sameRight := sameThird] \as ABC;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorAssociator[X := X, F := B, G := C, H := D, left := second, middle := third, right := fourth, sameMiddle := bcBase, sameRight := bdBase] \as BCD;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorAssociator[X := X, F := AB.Fiber, G := C, H := D, left := AB.bundle sameSecond, middle := third, right := fourth, sameMiddle := sameThird, sameRight := sameFourth] \as LeftFirst;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorAssociator[X := X, F := A, G := B, H := CD.Fiber, left := first, middle := second, right := CD.bundle cdBase, sameMiddle := sameSecond, sameRight := sameThird] \as LeftSecond;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorAssociator[X := X, F := A, G := BC.Fiber, H := D, left := first, middle := BC.bundle bcBase, right := fourth, sameMiddle := sameSecond, sameRight := sameFourth] \as RightMiddle;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IdentityIsomorphism[X := X, F := D, bundle := fourth] \as FourthIdentity;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IdentityIsomorphism[X := X, F := A, bundle := first] \as FirstIdentity;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorIsomorphisms[X := X, F := ABC.SourceFiber, G := D, A := ABC.TargetFiber, B := D, first := ABC.sourceBundle, second := fourth, newFirst := ABC.targetBundle, newSecond := fourth, sameSource := sameFourth, sameTarget := sameFourth] \as RightFirst;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorIsomorphisms[X := X, F := A, G := BCD.SourceFiber, A := A, B := BCD.TargetFiber, first := first, second := BCD.sourceBundle, newFirst := first, newSecond := BCD.targetBundle, sameSource := sameSecond, sameTarget := sameSecond] \as RightLast;
\definition firstStep: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := LeftFirst.SourceFiber, G := RightFirst.TargetFiber, source := LeftFirst.sourceBundle, target := RightFirst.targetBundle].Isomorphism := RightFirst.isomorphism ABC.isomorphism FourthIdentity.isomorphism;
\definition lastStep: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := RightLast.SourceFiber, G := LeftSecond.TargetFiber, source := RightLast.sourceBundle, target := LeftSecond.targetBundle].Isomorphism := RightLast.isomorphism FirstIdentity.isomorphism BCD.isomorphism;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismComposition[X := X, F := LeftFirst.SourceFiber, G := LeftFirst.TargetFiber, H := LeftSecond.TargetFiber, source := LeftFirst.sourceBundle, middle := LeftFirst.targetBundle, target := LeftSecond.targetBundle] \as LeftComposition;
\definition leftPath: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := LeftFirst.SourceFiber, G := LeftSecond.TargetFiber, source := LeftFirst.sourceBundle, target := LeftSecond.targetBundle].Isomorphism := LeftComposition.compose LeftFirst.isomorphism LeftSecond.isomorphism;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismComposition[X := X, F := LeftFirst.SourceFiber, G := RightFirst.TargetFiber, H := RightMiddle.TargetFiber, source := LeftFirst.sourceBundle, middle := RightFirst.targetBundle, target := RightMiddle.targetBundle] \as RightComposition;
\definition middlePath: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := LeftFirst.SourceFiber, G := RightMiddle.TargetFiber, source := LeftFirst.sourceBundle, target := RightMiddle.targetBundle].Isomorphism := RightComposition.compose firstStep RightMiddle.isomorphism;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismComposition[X := X, F := LeftFirst.SourceFiber, G := RightMiddle.TargetFiber, H := LeftSecond.TargetFiber, source := LeftFirst.sourceBundle, middle := RightMiddle.targetBundle, target := LeftSecond.targetBundle] \as FinalComposition;
\definition rightPath: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := LeftFirst.SourceFiber, G := LeftSecond.TargetFiber, source := LeftFirst.sourceBundle, target := LeftSecond.targetBundle].Isomorphism := FinalComposition.compose middlePath lastStep;
\module At(x: X);
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismEquality[X := X, F := LeftFirst.SourceFiber, G := LeftSecond.TargetFiber, source := LeftFirst.sourceBundle, target := LeftSecond.targetBundle] \as Equality;
\definition pentagon: leftPath = rightPath := Equality.ext leftPath rightPath (\fun (x: X) => At[x := x].equality);
