\import Spaces.Laws[V := V, space := space] \as Laws;
\definition cross: \forall (v: V) -> p.apply (q.apply v) = space.zero :=
  \fun (v: V) => Laws.cancelLeft (p.apply v) (p.apply (q.apply v)) space.zero
    (trans!{{V}} _ _ _
      (congr!{{V} {V}} (\fun (a: V) => space.add a (p.apply (q.apply v))) _ _ (sym!{{V}} _ _ (idempotent v)))
      (trans!{{V}} _ _ _ (sym!{{V}} _ _ (p.preservesAdd (p.apply v) (q.apply v)))
        (trans!{{V}} _ _ _ (congr!{{V} {V}} p.apply _ _ (total v)) (sym!{{V}} _ _ (Laws.zeroRight (p.apply v))))));
