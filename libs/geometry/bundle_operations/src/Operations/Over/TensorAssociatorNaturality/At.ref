\definition input[v: A x][w: B x][u: C x]: Source.SourceFiber x := SourceLeft.pure x (AB.pure x v w) u;
\definition normal[v: A x][w: B x][u: C x]: Target.TargetFiber x := TargetRight.pure x ((a.fiber x).apply v) (EF.pure x ((b.fiber x).apply w) ((c.fiber x).apply u));
\definition leftNormal: \forall (v: A x)(w: B x)(u: C x) -> (firstPath.fiber x).apply (input v w u) = normal v w u :=
  \fun (v: A x)(w: B x)(u: C x) => trans!{{Target.TargetFiber x}} _ _ _
    (congr!{{Target.SourceFiber x} {Target.TargetFiber x}} (Target.isomorphism.forward.fiber x).apply _ _
      (trans!{{Target.SourceFiber x}} _ _ _ (LeftMap.onPure (FirstMap.map a b) c x (AB.pure x v w) u)
        (congr!{{DE.Fiber x} {Target.SourceFiber x}} (\fun (t: DE.Fiber x) => TargetLeft.pure x t ((c.fiber x).apply u)) _ _ (FirstMap.onPure a b x v w))))
    (Target.onPure x ((a.fiber x).apply v) ((b.fiber x).apply w) ((c.fiber x).apply u));
\definition rightNormal: \forall (v: A x)(w: B x)(u: C x) -> (secondPath.fiber x).apply (input v w u) = normal v w u :=
  \fun (v: A x)(w: B x)(u: C x) => trans!{{Target.TargetFiber x}} _ _ _
    (congr!{{Source.TargetFiber x} {Target.TargetFiber x}} ((RightMap.map a (LastMap.map b c)).fiber x).apply _ _ (Source.onPure x v w u))
    (trans!{{Target.TargetFiber x}} _ _ _ (RightMap.onPure a (LastMap.map b c) x v (BC.pure x w u))
      (congr!{{EF.Fiber x} {Target.TargetFiber x}} (TargetRight.pure x ((a.fiber x).apply v)) _ _ (LastMap.onPure b c x w u)));
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorTripleEquality[V := A x, W := B x, U := C x, T := Target.TargetFiber x, left := first.space x, middle := second.space x, right := third.space x, target := Target.targetBundle.space x] \as Equality;
\definition equality: \forall (t: Source.SourceFiber x) -> (firstPath.fiber x).apply t = (secondPath.fiber x).apply t := Equality.pointwise (firstPath.fiber x) (secondPath.fiber x) (\fun (v: A x)(w: B x)(u: C x) => trans!{{Target.TargetFiber x}} _ _ _ (leftNormal v w u) (sym!{{Target.TargetFiber x}} _ _ (rightNormal v w u)));
