\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].LineCoordinates[] \as Line;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Trivial[X := X, n := Line.one, baseSpace := baseSpace] \as Trivial;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].LinearIsomorphisms[V := K, W := Vector Line.one, source := Spaces.scalarSpace, target := coordinates Line.one] \as LinearIsomorphisms;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Transport[X := X, F := \fun (x: X) => Vector Line.one, G := \fun (x: X) => K,
  source := Trivial.bundle, space := \fun (x: X) => Spaces.scalarSpace, isomorphism := \fun (x: X) => LinearIsomorphisms.inverse Line.isomorphism] \as Change;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := \fun (x: X) => K] \as Family;
\definition bundle: Family.Bundle := Change.bundle;
\definition value[p: Family.Point]: K := p.vector;
\definition valueContinuous: topology.Continuity[A := Family.Point, B := K].Continuous bundle.totalSpace scalar.topological.space value :=
  topology.Composition[A := Family.Point, B := Vector Line.one, C := K].composeContinuous bundle.totalSpace (coordinateTopology Line.one) scalar.topological.space
    (\fun (p: Family.Point) => (Change.backward p).vector) Line.evaluate
    (topology.Composition[A := Family.Point, B := vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := \fun (x: X) => Vector Line.one].Point, C := Vector Line.one].composeContinuous
      bundle.totalSpace Trivial.topology (coordinateTopology Line.one) Change.backward (\fun (p: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := \fun (x: X) => Vector Line.one].Point) => p.vector) Change.backwardContinuous Trivial.vectorContinuous)
    Line.backwardContinuous;
\module Universal(Y: \Set);
\module Product;
\module Mapping(Y: \Set, space: topology.Topology[Carrier := Y].Topology, f: X -> Y, regular: topology.Continuity[A := X, B := Y].Continuous baseSpace space f);
\module Equality(space: topology.Topology[Carrier := X].Topology, sameBase: baseSpace = space);
\definition coordinateIsomorphism: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[
  X := X, F := (\fun (_: X) => Vector Line.one), G := (\fun (_: X) => K), source := Trivial.bundle, target := bundle].Isomorphism := Change.Comparison[].comparison;
