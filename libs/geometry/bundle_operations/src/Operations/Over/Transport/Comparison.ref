\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := F, G := G, source := source, target := bundle] \as Isomorphisms;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := F, G := G, source := source, target := bundle, f := \fun (x: X) => x] \as Forward;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := G, G := F, source := bundle, target := source, f := \fun (x: X) => x] \as Backward;
\definition forwardMap: Forward.Map := \into[Forward.Data](Forward.Data { fiber := \fun (x: X) => (isomorphism x).forward }, Forward.Map) \by { forwardContinuous };
\definition backwardMap: Backward.Map := \into[Backward.Data](Backward.Data { fiber := \fun (x: X) => (isomorphism x).backward }, Backward.Map) \by { backwardContinuous };
\definition comparison: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := forwardMap, backward := backwardMap,
  leftInverse := \fun (x: X) => (Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := space x].laws (isomorphism x)).leftInverse,
  rightInverse := \fun (x: X) => (Spaces.Isomorphism[V := F x, W := G x, source := source.space x, target := space x].laws (isomorphism x)).rightInverse
};
