\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].LinearIsomorphisms[V := F x, W := G x, source := source.space x, target := space x] \as Isomorphisms;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].LinearIsomorphisms[V := G x, W := F x, source := space x, target := source.space x].After[U := Vector c.dimension, space := coordinates c.dimension] \as Compose;
\definition frame: Spaces.Isomorphism[V := G x, W := Vector c.dimension, source := space x, target := coordinates c.dimension].Isomorphism := Compose.compose (Isomorphisms.inverse (isomorphism x)) (c.frame x);
