\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F] \as Source;
\import Source.With[data := bundle] \as SourceCharts;
\import topology.Topology[Carrier := X] \as Base;
\import Source.Of[bundle := bundle].Pullback[Y := Y, source := source, f := f] \as SourcePullback;
\import Family.Of[bundle := exterior].Pullback[Y := Y, source := source, f := f] \as ExteriorPullback;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Exterior[X := Y, F := \fun (y: Y) => F (f y), bundle := SourcePullback.pulled regular, k := k] \as PulledExterior;
\definition firstBundle: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := \fun (y: Y) => Fiber (f y)].Bundle := ExteriorPullback.pulled regular;
\definition secondBundle: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := \fun (y: Y) => Fiber (f y)].Bundle := PulledExterior.exterior;
\definition fiber[y: Y]: Spaces.Isomorphism[V := Fiber (f y), W := Fiber (f y), source := firstBundle.space y, target := secondBundle.space y].Isomorphism :=
  Spaces.Isomorphism[V := Fiber (f y), W := Fiber (f y), source := firstBundle.space y, target := secondBundle.space y].Isomorphism {
    forward := Spaces.Linear[V := Fiber (f y), W := Fiber (f y), source := firstBundle.space y, target := secondBundle.space y].Map {
      apply := \fun (v: Fiber (f y)) => v, preservesAdd := \fun (v, w: Fiber (f y)) => \refl((firstBundle.space y).add v w), preservesScale := \fun (a: K)(v: Fiber (f y)) => \refl((firstBundle.space y).smul a v)
    },
    backward := Spaces.Linear[V := Fiber (f y), W := Fiber (f y), source := secondBundle.space y, target := firstBundle.space y].Map {
      apply := \fun (v: Fiber (f y)) => v, preservesAdd := \fun (v, w: Fiber (f y)) => \refl((firstBundle.space y).add v w), preservesScale := \fun (a: K)(v: Fiber (f y)) => \refl((firstBundle.space y).smul a v)
    },
    leftInverse := \fun (v: Fiber (f y)) => \refl(v), rightInverse := \fun (v: Fiber (f y)) => \refl(v)
  };
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].LocalMaps[X := Y, F := \fun (y: Y) => Fiber (f y), G := \fun (y: Y) => Fiber (f y), source := firstBundle, target := secondBundle, fiber := \fun (y: Y) => (fiber y).forward] \as Charts;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].LocalIsomorphisms[X := Y, F := \fun (y: Y) => Fiber (f y), G := \fun (y: Y) => Fiber (f y), source := firstBundle, target := secondBundle, fiber := fiber] \as Comparison;
\module In(c: SourceCharts.Chart,
  enumeration: \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ExteriorIndices[n := c.dimension, k := k].Enumeration);
\definition covers: Charts.Covers := \fun (y: Y) => \block {
  \takefrom c: \Cast[SourceCharts.Chart] ({ c: SourceCharts.Chart \where Base.Member c.domain (f y) }) \by Source.Of[bundle := bundle].locallyTrivial (f y) \then
  \takefrom enumeration: \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ExteriorIndices[n := c.dimension, k := k].Enumeration
    \by \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ExteriorIndices[n := c.dimension, k := k].existsEnumeration \then
  \return Logic.existsIntro[Charts.Chart, { e: Charts.Chart \where topology.Topology[Carrier := Y].Member e.domain y }] (In[c := c, enumeration := enumeration].chart)
    (\bysub(SourceCharts.Chart, { c: SourceCharts.Chart \where Base.Member c.domain (f y) }, c))
};
\definition isomorphism: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := Y, F := \fun (y: Y) => Fiber (f y), G := \fun (y: Y) => Fiber (f y), source := firstBundle, target := secondBundle].Isomorphism := Comparison.isomorphism (\refl(source)) covers;
\definition onFiber: \forall (y: Y)(v: Fiber (f y)) -> (isomorphism.forward.fiber y).apply v = v := \fun (y: Y)(v: Fiber (f y)) => \refl(v);
\definition inverseOnFiber: \forall (y: Y)(v: Fiber (f y)) -> (isomorphism.backward.fiber y).apply v = v := \fun (y: Y)(v: Fiber (f y)) => \refl(v);
