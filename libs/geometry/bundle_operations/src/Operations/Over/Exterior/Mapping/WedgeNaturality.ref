\import Spaces.Dual[V := G x, source := target.space x] \as NewDual;
\import Spaces.Multilinear[V := NewDual.Carrier, space := NewDual.space].Alternating[].At[k := k] \as Values;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].WedgeAlgebra[V := F x, space := bundle.space x, k := k] \as OldWedge;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].WedgeAlgebra[V := G x, space := target.space x, k := k] \as NewWedge;
\definition naturality: ((map a).fiber x).apply (OldWedge.value v) = NewWedge.value (\fun (i: Fin.Fin k) => (a.fiber x).apply (v i)) :=
  Values.ext (((map a).fiber x).apply (OldWedge.value v)) (NewWedge.value (\fun (i: Fin.Fin k) => (a.fiber x).apply (v i))) (\fun (ell: Fin.Fin k -> NewDual.Carrier) => \refl(NewWedge.value (\fun (i: Fin.Fin k) => (a.fiber x).apply (v i)) ell));
