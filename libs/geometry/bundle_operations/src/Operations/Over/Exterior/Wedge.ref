\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F] \as Original;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Along[X := X, F := F, bundle := bundle, Y := Y, source := source, base := base] \as Vectors;
\definition Tuple: \Set := Fin.Fin k -> Vectors.Vectors;
\definition value[v: Tuple][y: Y]: Fiber (base y) := \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].WedgeAlgebra[V := F (base y), space := bundle.space (base y), k := k].value (\fun (i: Fin.Fin k) => v i y);
\definition total[v: Tuple][y: Y]: Family.Point := Family.include (base y) (value v y);
\import \root.Operations[].Evaluations[K := K, X := X, E := Family.Point, I := Alternating.TupleSection, scalarSpace := scalar.topological.space, baseSpace := bundle.baseSpace,
  projection := Family.projection, domains := Alternating.domains, open := \fun (s: Alternating.TupleSection) => s.open, evaluate := Alternating.evaluate] \as Tests;
\module At(s: Alternating.TupleSection);
\definition continuous: \forall (v: Tuple) -> Vectors.BaseContinuous -> (\forall (i: Fin.Fin k) -> Vectors.Continuous (v i)) ->
  topology.Continuity[A := Y, B := Family.Point].Continuous source exterior.totalSpace (total v) :=
  \fun (v: Tuple)(baseRegular: _)(regular: _) => Tests.Universal[A := Y].continuous source (total v) baseRegular
    (\fun (s: Alternating.TupleSection) => At[s := s].continuous v baseRegular regular);
