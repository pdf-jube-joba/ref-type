\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Dual[X := X, F := G, bundle := target] \as TargetDual;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Exterior[X := X, F := G, bundle := target, k := k] \as TargetExterior;
\import Dual.Contramap[G := G, target := target, sameBase := sameBase] \as DualMap;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Alternating[X := X, F := TargetDual.Fiber, bundle := TargetDual.dual, k := k].Contramap[G := Dual.Fiber, target := Dual.dual, sameBase := sym!{{topology.Topology[Carrier := X].Topology}} bundle.baseSpace target.baseSpace sameBase] \as AlternatingMap;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := F, G := G, source := bundle, target := target, f := \fun (x: X) => x] \as Original;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Fiber, G := TargetExterior.Fiber, source := exterior, target := TargetExterior.exterior, f := \fun (x: X) => x] \as Result;
\definition map[a: Original.Map]: Result.Map := AlternatingMap.map (DualMap.map a);
\definition evaluation: \forall (a: Original.Map)(x: X)(omega: Fiber x)(ell: Fin.Fin k -> TargetDual.Fiber x) -> ((map a).fiber x).apply omega ell =
  omega (\fun (i: Fin.Fin k) => Spaces.Dual[V := F x, source := bundle.space x].Precomposition[W := G x, target := target.space x].apply (a.fiber x) (ell i)) :=
  \fun (a: Original.Map)(x: X)(omega: Fiber x)(ell: Fin.Fin k -> TargetDual.Fiber x) => \refl(omega (\fun (i: Fin.Fin k) => Spaces.Dual[V := F x, source := bundle.space x].Precomposition[W := G x, target := target.space x].apply (a.fiber x) (ell i)));
\module WedgeNaturality(a: Original.Map, x: X, v: Fin.Fin k -> F x);
