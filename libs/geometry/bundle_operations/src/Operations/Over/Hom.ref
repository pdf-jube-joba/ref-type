\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F] \as Source;
\import Source.With[data := left] \as SourceCharts;
\import topology.Topology[Carrier := X] \as Base;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Dual[X := X, F := F, bundle := left] \as Dual;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := Dual.Fiber, G := G, left := Dual.dual, right := right] \as Tensor;
\definition Fiber[x: X]: \Set := commutative_algebra.Modules[R := K, ring := Fields.fieldAsCommutativeRing K field].HomSpace[V := F x, W := G x, source := left.space x, target := right.space x].Carrier;
\definition fiberSpace[x: X]: Spaces.VectorSpace (Fiber x) := commutative_algebra.Modules[R := K, ring := Fields.fieldAsCommutativeRing K field].HomSpace[V := F x, W := G x, source := left.space x, target := right.space x].space;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Fiber] \as Family;
\definition SameBase: \Prop := left.baseSpace = right.baseSpace;
\module At(x: X);
\definition isomorphism[x: X]: Spaces.Isomorphism[V := Tensor.Fiber x, W := Fiber x, source := Tensor.fiberSpace x, target := fiberSpace x].Isomorphism :=
  Spaces.Isomorphism[V := Tensor.Fiber x, W := Fiber x, source := Tensor.fiberSpace x, target := fiberSpace x].OfBijective[f := At[x := x].forward].isomorphism (At[x := x].injective) (At[x := x].onto);
\definition evaluation[x: X][h: Fiber x][v: F x]: G x := h.apply v;
\module Of(same: SameBase);
