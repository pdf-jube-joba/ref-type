\import topological_algebra.Coordinates[K := K, I := Index] \as Source;
\import topological_algebra.Coordinates[K := K, I := Fin.Fin rank] \as Target;
\definition topology: topology.Topology[Carrier := Raw.Vector].Topology := Source.topology scalar.topological.space;
\definition forwardContinuous: topology.Continuity[A := Raw.Vector, B := Vector rank].Continuous topology (coordinateTopology rank) encode :=
  Target.Universal[A := Raw.Vector].continuous topology scalar.topological.space encode (\fun (i: Fin.Fin rank) => Source.evaluationContinuous scalar.topological.space (enumerate i));
\definition backwardContinuous: topology.Continuity[A := Vector rank, B := Raw.Vector].Continuous (coordinateTopology rank) topology decode :=
  Source.Universal[A := Vector rank].continuous (coordinateTopology rank) scalar.topological.space decode (\fun (i: Index) => Target.evaluationContinuous scalar.topological.space (index i));
