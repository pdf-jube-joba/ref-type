\import Spaces.Linear[V := V, W := W, source := even, target := odd] \as Forward;
\import Spaces.Linear[V := W, W := V, source := odd, target := even] \as Backward;
\structure Data: \Set := { d: Forward.Map, e: Backward.Map, h: Backward.Map, k: Forward.Map };
\structure Laws[c: Data]: \Prop := {
  squareEven: \forall (v: V) -> c.e.apply (c.d.apply v) = even.zero,
  squareOdd: \forall (w: W) -> c.d.apply (c.e.apply w) = odd.zero,
  even: \forall (v: V) -> even.add (c.e.apply (c.k.apply v)) (c.h.apply (c.d.apply v)) = v,
  odd: \forall (w: W) -> odd.add (c.d.apply (c.h.apply w)) (c.k.apply (c.e.apply w)) = w
};
\definition Pair: \Set := \Cast[Data] ({ c: Data \where Laws[c] });
\module With(c: Pair);
\module Correction(c: Data,
  squareEven: \forall (v: V) -> c.e.apply (c.d.apply v) = even.zero,
  squareOdd: \forall (w: W) -> c.d.apply (c.e.apply w) = odd.zero);
\module Sums(d: Forward.Map, e: Backward.Map);

\module DirectSum(U, T: \Set, secondEven: Spaces.VectorSpace U, secondOdd: Spaces.VectorSpace T,
  first: Pair, second: \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar]
    .ContractingPair[V := U, W := T, even := secondEven, odd := secondOdd].Pair);

\module Transport(U, T: \Set, newEven: Spaces.VectorSpace U, newOdd: Spaces.VectorSpace T,
  c: Pair, positive: Spaces.Isomorphism[V := V, W := U, source := even, target := newEven].Isomorphism,
  negative: Spaces.Isomorphism[V := W, W := T, source := odd, target := newOdd].Isomorphism);
