\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IdentityFrame[n := n] \as Identity;
\definition gauge[x: \Cast[X] U]: Spaces.Isomorphism[V := Vector n, W := Vector n, source := coordinates n, target := coordinates n].Isomorphism := Identity.isomorphism;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].CoordinateGauge[X := X, U := U, n := n, baseSpace := baseSpace, gauge := gauge] \as Coordinate;
\definition continuous: topology.Continuity[A := Coordinate.Point, B := Coordinate.Point].Continuous Coordinate.topology Coordinate.topology Coordinate.forward :=
  \idelim (\fun (p: Coordinate.Point) => p) = Coordinate.forward \with f: (Coordinate.Point -> Coordinate.Point) => topology.Continuity[A := Coordinate.Point, B := Coordinate.Point].Continuous Coordinate.topology Coordinate.topology f \by {
    base: topology.Maps[A := Coordinate.Point, B := Coordinate.Point].Identity[].continuous Coordinate.topology,
    equality: \axiom:funext((\fun (p: Coordinate.Point) => p), Coordinate.forward, \fun (p: Coordinate.Point) => sym!{{Coordinate.Point}} _ _ (Pair.Prop[A := Coordinate.BasePoint, B := Vector n].eta p))
  };
\definition regular: Coordinate.Regular := Coordinate.Regular { forward := continuous, backward := continuous };
