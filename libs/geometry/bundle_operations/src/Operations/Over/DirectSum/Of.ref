\definition sum: Family.Bundle := bundle same;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Fiber, G := F, source := sum, target := left, f := \fun (x: X) => x] \as First;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Fiber, G := G, source := sum, target := right, f := \fun (x: X) => x] \as Second;
\definition firstData: First.Data := First.Data { fiber := \fun (x: X) => Spaces.Linear[V := Fiber x, W := F x, source := fiberSpace x, target := left.space x].Map {
  apply := Pair.first (F x) (G x), preservesAdd := \fun (v, w: Fiber x) => \refl((left.space x).add (Pair.first (F x) (G x) v) (Pair.first (F x) (G x) w)),
  preservesScale := \fun (a: K)(v: Fiber x) => \refl((left.space x).smul a (Pair.first (F x) (G x) v))
} };
\definition secondData: Second.Data := Second.Data { fiber := \fun (x: X) => Spaces.Linear[V := Fiber x, W := G x, source := fiberSpace x, target := right.space x].Map {
  apply := Pair.second (F x) (G x), preservesAdd := \fun (v, w: Fiber x) => \refl((right.space x).add (Pair.second (F x) (G x) v) (Pair.second (F x) (G x) w)),
  preservesScale := \fun (a: K)(v: Fiber x) => \refl((right.space x).smul a (Pair.second (F x) (G x) v))
} };
\definition firstMap: First.Map := \into[First.Data](firstData, First.Map) \by { firstContinuous };
\definition secondMap: Second.Map := \into[Second.Data](secondData, Second.Map) \by { secondContinuous };
\module From(Y: \Set, H: Y -> \Set,
  source: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := H].Bundle, f: Y -> X);
\module Pullback(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  regular: topology.Continuity[A := Y, B := X].Continuous source left.baseSpace f);
\module Symmetry;
\module Mapping(Y: \Set, A, B: Y -> \Set,
  leftTarget: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := A].Bundle,
  rightTarget: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := B].Bundle, f: X -> Y,
  targetSame: leftTarget.baseSpace = rightTarget.baseSpace);
\module Inclusions;
\module To(Y: \Set, H: Y -> \Set,
  target: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := H].Bundle, f: X -> Y);
