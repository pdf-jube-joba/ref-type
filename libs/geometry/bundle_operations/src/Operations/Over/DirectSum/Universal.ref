\definition continuous: \forall (source: topology.Topology[Carrier := Y].Topology)(f: Y -> Family.Point) ->
  topology.Continuity[A := Y, B := Left.Point].Continuous source left.totalSpace (\fun (y: Y) => first (f y)) ->
  topology.Continuity[A := Y, B := Right.Point].Continuous source right.totalSpace (\fun (y: Y) => second (f y)) ->
  topology.Continuity[A := Y, B := Family.Point].Continuous source topology f :=
  \fun (source: _)(f: _)(firstRegular: _)(secondRegular: _) => Induced.Universal[Z := Y].continuous source productTopology embedding f
    (Product.Universal[X := Y].pairContinuous source left.totalSpace right.totalSpace (\fun (y: Y) => first (f y)) (\fun (y: Y) => second (f y)) firstRegular secondRegular);
