\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := F, G := G, left := left, right := right].Of[same := same] \as Original;
\import Original.From[Y := X, H := F, source := left, f := \fun (x: X) => x] \as FromLeft;
\import Original.From[Y := X, H := G, source := right, f := \fun (x: X) => x] \as FromRight;
\definition reverseBase: right.baseSpace = left.baseSpace := sym!{{topology.Topology[Carrier := X].Topology}} _ _ same;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ZeroMap[X := X, F := F, G := G, source := left, target := right, sameBase := same] \as LeftZero;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ZeroMap[X := X, F := G, G := F, source := right, target := left, sameBase := reverseBase] \as RightZero;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Identity[X := X, F := F, bundle := left] \as LeftIdentity;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Identity[X := X, F := G, bundle := right] \as RightIdentity;
\definition first: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := F, G := Fiber, source := left, target := sum, f := \fun (x: X) => x].Map := FromLeft.pair LeftIdentity.map LeftZero.map;
\definition second: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := G, G := Fiber, source := right, target := sum, f := \fun (x: X) => x].Map := FromRight.pair RightZero.map RightIdentity.map;
\definition decomposition: \forall (x: X)(v: Fiber x) -> (fiberSpace x).add ((first.fiber x).apply (Pair.first (F x) (G x) v)) ((second.fiber x).apply (Pair.second (F x) (G x) v)) = v :=
  \fun (x: X)(v: Fiber x) => Pair.Prop[A := F x, B := G x].ext _ _ (Spaces.Laws[V := F x, space := left.space x].zeroRight (Pair.first (F x) (G x) v)) (Spaces.Laws[V := G x, space := right.space x].zeroLeft (Pair.second (F x) (G x) v));
