\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := F, G := G, left := left, right := right].Of[same := same] \as Original;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := G, G := F, left := right, right := left] \as Swapped;
\definition reverseBase: right.baseSpace = left.baseSpace := sym!{{topology.Topology[Carrier := X].Topology}} _ _ same;
\definition swapped: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Swapped.Fiber].Bundle := Swapped.bundle reverseBase;
\import Swapped.Of[same := reverseBase] \as Reverse;
\import Reverse.From[Y := X, H := Fiber, source := sum, f := \fun (x: X) => x] \as Forward;
\import Original.From[Y := X, H := Swapped.Fiber, source := swapped, f := \fun (x: X) => x] \as Backward;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Fiber, G := Swapped.Fiber, source := sum, target := swapped] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := Forward.pair secondMap firstMap,
  backward := Backward.pair Reverse.secondMap Reverse.firstMap,
  leftInverse := \fun (x: X) => Pair.Prop[A := F x, B := G x].eta,
  rightInverse := \fun (x: X) => Pair.Prop[A := G x, B := F x].eta
};
