\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].AlternatingFrame[V := F x, space := bundle.space x, n := c.dimension, frame := c.frame x, k := k, enumeration := enumeration] \as Frames;
\definition frame: Spaces.Isomorphism[V := Fiber x, W := Vector dimension, source := fiberSpace x, target := coordinates dimension].Isomorphism := Frames.isomorphism;
\import Spaces.Sums[I := Fin.Fin dimension] \as Sums;
\import Sums.Prop[] \as Laws;
\definition evaluation: \forall (v: Vector dimension)(arguments: Fin.Fin k -> F x) -> frame.backward.apply v arguments =
  Sums.sum (Fin.elements dimension) (\fun (i: Fin.Fin dimension) => field.mul (v i) (Spaces.FiniteCoordinates[n := c.dimension].Exterior[].word k (Coordinates.enumerate i) (\fun (j: Fin.Fin k) => (c.frame x).forward.apply (arguments j)))) :=
  \fun (v: Vector dimension)(arguments: Fin.Fin k -> F x) => trans!{K} _ _ _ (Frames.evaluation v arguments)
    (Laws.congruent (Fin.elements dimension)
      (\fun (i: Fin.Fin dimension) => field.mul (v i) (Frames.word i arguments))
      (\fun (i: Fin.Fin dimension) => field.mul (v i) (Spaces.FiniteCoordinates[n := c.dimension].Exterior[].word k (Coordinates.enumerate i) (\fun (j: Fin.Fin k) => (c.frame x).forward.apply (arguments j))))
      (\fun (i: Fin.Fin dimension) => congr!{K K} (field.mul (v i))
        (Frames.word i arguments) (Spaces.FiniteCoordinates[n := c.dimension].Exterior[].word k (Coordinates.enumerate i) (\fun (j: Fin.Fin k) => (c.frame x).forward.apply (arguments j))) (Frames.wordFormula i arguments)));
