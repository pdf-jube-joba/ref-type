\import Spaces.FiniteCoordinates[n := n] \as Coordinates;
\definition isomorphism: Spaces.Isomorphism[V := Vector n, W := Vector n, source := coordinates n, target := coordinates n].Isomorphism :=
  Spaces.Isomorphism[V := Vector n, W := Vector n, source := coordinates n, target := coordinates n].Isomorphism {
    forward := Coordinates.identity, backward := Coordinates.identity, leftInverse := \fun (v: Vector n) => \refl(v), rightInverse := \fun (v: Vector n) => \refl(v)
  };
