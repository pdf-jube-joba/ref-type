\import Spaces.Sums[I := I].Vector[V := Tensor.Carrier, space := Tensor.space] \as Values;
\import Spaces.Sums[I := I] \as Scalars;
\import Scalars.Prop[] \as Laws;
\import Values.Mapping[W := K, target := Spaces.scalarSpace] \as Mapping;
\definition formula: \forall (xs: std.Data[].List[].List[I])(v: I -> V)(w: I -> W)(p: Index) ->
  forward.apply (Values.sum xs (\fun (a: I) => Tensor.tensor (v a) (w a))) p = Scalars.sum xs (\fun (a: I) => outer (v a) (w a) p) :=
  \fun (xs: _)(v: _)(w: _)(p: Index) => trans!{K} _ _ _
    (Mapping.law (\parent.Recovery[].functional p) xs (\fun (a: I) => Tensor.tensor (v a) (w a)))
    (Laws.congruent xs (\fun (a: I) => forward.apply (Tensor.tensor (v a) (w a)) p) (\fun (a: I) => outer (v a) (w a) p)
      (\fun (a: I) => congr!{Coefficients.Vector K} (\fun (f: Coefficients.Vector) => f p) _ _ (Encode.onTensor outer bilinear (v a) (w a))));
\definition nested: \forall (xs: std.Data[].List[].List[I])(f: I -> Tensor.Carrier)(p: Index) ->
  forward.apply (Values.sum xs f) p = Scalars.sum xs (\fun (a: I) => forward.apply (f a) p) :=
  \fun (xs: _)(f: _)(p: Index) => Mapping.law (\parent.Recovery[].functional p) xs f;
