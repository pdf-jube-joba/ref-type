\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Zero[X := X, baseSpace := baseSpace] \as Line;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Zero[X := X, baseSpace := bundle.baseSpace] \as TargetLine;
\import Line.Equality[space := bundle.baseSpace, sameBase := sameBase] \as LineChange;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumUnit[X := X, F := F, bundle := bundle] \as Unit;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := \fun (x: X) => Line.Fiber, G := F, left := Line.bundle, right := bundle] \as Source;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := \fun (x: X) => Line.Fiber, G := F, left := TargetLine.bundle, right := bundle] \as Target;
\definition sourceBundle: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Source.Fiber].Bundle := Source.bundle sameBase;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IdentityIsomorphism[X := X, F := F, bundle := bundle] \as Identity;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumIsomorphisms[X := X, F := \fun (x: X) => Line.Fiber, G := F, A := \fun (x: X) => Line.Fiber, B := F, first := Line.bundle, second := bundle, newFirst := TargetLine.bundle, newSecond := bundle, sameSource := sameBase, sameTarget := \refl(bundle.baseSpace)] \as Change;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IsomorphismComposition[X := X, F := Source.Fiber, G := Target.Fiber, H := F, source := sourceBundle, middle := Unit.sum, target := bundle] \as Composition;
\definition isomorphism: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Source.Fiber, G := F, source := sourceBundle, target := bundle].Isomorphism := Composition.compose (Change.isomorphism LineChange.isomorphism Identity.isomorphism) Unit.isomorphism;
\definition onPair: \forall (x: X)(a: Line.Fiber)(v: F x) -> (isomorphism.forward.fiber x).apply (Pair.pair Line.Fiber (F x) a v) = v := \fun (x: X)(a: Line.Fiber)(v: F x) => \refl(v);
