\import \parent.MapOperations[X := X, F := F, G := F, source := bundle, target := bundle] \as Maps;
\import Bundles.Identity[X := X, F := F, bundle := bundle] \as Identity;
\definition map: Maps.Map := Maps.negative Identity.map;
\module At(x: X);
\import Bundles.Isomorphisms[X := X, F := F, G := F, source := bundle, target := bundle] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := map, backward := map,
  leftInverse := \fun (x: X) => At[x := x].inverse,
  rightInverse := \fun (x: X) => At[x := x].inverse
};
\definition formula: \forall (x: X)(v: F x) -> (map.fiber x).apply v = (bundle.space x).neg v := \fun (x: X) => At[x := x].formula;
