\definition equality: \forall (t: ABC.TargetFiber x) -> (direct.forward.fiber x).apply t = (path4.forward.fiber x).apply t :=
  \fun (t: ABC.TargetFiber x) => Pair.Prop[A := BC.Fiber x, B := A x].ext ((direct.forward.fiber x).apply t) ((path4.forward.fiber x).apply t)
    (sym!{{BC.Fiber x}} _ _ (Pair.Prop[A := B x, B := C x].eta (Pair.second (A x) (BC.Fiber x) t)))
    (\refl(Pair.first (A x) (BC.Fiber x) t));
