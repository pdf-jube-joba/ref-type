\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F] \as Source;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := G] \as Target;
\import Source.With[data := source] \as SourceCharts;
\import Target.With[data := target] \as TargetCharts;
\import topology.Topology[Carrier := X] \as Base;
\structure ChartData: \Set := {
  domain: \Pow X, dimension: N.Nat^,
  sourceFrame: \forall (x: \Cast[X] domain) -> Spaces.Isomorphism[V := F x, W := Vector dimension, source := source.space x, target := coordinates dimension].Isomorphism,
  targetFrame: \forall (x: \Cast[X] domain) -> Spaces.Isomorphism[V := G x, W := Vector dimension, source := target.space x, target := coordinates dimension].Isomorphism
};
\module In(c: ChartData);
\definition Chart: \Set := \Cast[ChartData] ({ c: ChartData \where \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].LocalMaps[X := X, F := F, G := G, source := source, target := target, fiber := fiber].In[c := c].Laws });
\definition domain[c: Chart]: \Pow Source.Point := { p: Source.Point \where Base.Member c.domain p.base };
\definition Covers: \Prop := \forall (x: X) -> \exists ( c: Chart \where Base.Member c.domain x );
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := F, G := G, source := source, target := target, f := \fun (x: X) => x] \as Maps;
\definition data: Maps.Data := Maps.Data { fiber := fiber };
\import topology.Continuity[A := Source.Point, B := Target.Point].Covered[I := Chart, domains := domain] \as Covered;
\definition continuous: \forall (sameBase: source.baseSpace = target.baseSpace) -> Covers -> topology.Continuity[A := Source.Point, B := Target.Point].Continuous source.totalSpace target.totalSpace (Maps.total data) :=
  \fun (sameBase: _)(covers: Covers) => Covered.continuous source.totalSpace target.totalSpace (Maps.total data)
    (\fun (c: Chart) => (\bysub(ChartData, Chart, c)).source.totalOpen)
    (\fun (p: Source.Point) => covers p.base)
    (\fun (c: Chart) => In[c := c].continuous sameBase (\bysub(ChartData, Chart, c)));
\definition map[sameBase: source.baseSpace = target.baseSpace][covers: Covers]: Maps.Map := \into[Maps.Data](data, Maps.Map) \by { continuous sameBase covers };
