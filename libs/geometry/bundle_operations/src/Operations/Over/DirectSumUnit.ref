\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Zero[X := X, baseSpace := bundle.baseSpace] \as Zero;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := \fun (x: X) => Zero.Fiber, G := F, left := Zero.bundle, right := bundle] \as Sum;
\definition sum: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Sum.Fiber].Bundle := Sum.bundle (\refl(bundle.baseSpace));
\import Sum.Of[same := \refl(bundle.baseSpace)] \as SumMaps;
\import SumMaps.From[Y := X, H := F, source := bundle, f := \fun (x: X) => x] \as Into;
\import Zero.From[F := F, source := bundle, sameBase := \refl(bundle.baseSpace)] \as ZeroMap;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Identity[X := X, F := F, bundle := bundle] \as Identity;
\import Fin.Empty[A := K] \as Empty;
\definition forward: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Sum.Fiber, G := F, source := sum, target := bundle, f := \fun (x: X) => x].Map := SumMaps.secondMap;
\definition backward: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := F, G := Sum.Fiber, source := bundle, target := sum, f := \fun (x: X) => x].Map := Into.pair ZeroMap.map Identity.map;
\definition isomorphism: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Sum.Fiber, G := F, source := sum, target := bundle].Isomorphism :=
  vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Sum.Fiber, G := F, source := sum, target := bundle].Isomorphism {
    forward := forward, backward := backward,
    leftInverse := \fun (x: X)(v: Sum.Fiber x) => Pair.Prop[A := Zero.Fiber, B := F x].ext ((backward.fiber x).apply ((forward.fiber x).apply v)) v
      (Empty.unique ((Zero.bundle.space x).zero) (Pair.first Zero.Fiber (F x) v)) (\refl(Pair.second Zero.Fiber (F x) v)),
    rightInverse := \fun (x: X)(v: F x) => \refl(v)
  };
\definition onPair: \forall (x: X)(z: Zero.Fiber)(v: F x) -> (forward.fiber x).apply (Pair.pair Zero.Fiber (F x) z v) = v := \fun (x: X)(z: Zero.Fiber)(v: F x) => \refl(v);
