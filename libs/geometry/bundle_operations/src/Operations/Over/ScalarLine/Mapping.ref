\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ScalarLine[X := Y, baseSpace := space] \as Other;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := \fun (y: Y) => K] \as Target;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := Y, F := \fun (x: X) => K, G := \fun (y: Y) => K, source := bundle, target := Other.bundle, f := f] \as Maps;
\definition scalarIdentity: Spaces.Linear[V := K, W := K, source := Spaces.scalarSpace, target := Spaces.scalarSpace].Map := Spaces.Linear[V := K, W := K, source := Spaces.scalarSpace, target := Spaces.scalarSpace].Map {
  apply := \fun (a: K) => a, preservesAdd := \fun (a, b: K) => \refl(field.add a b), preservesScale := \fun (a, b: K) => \refl(field.mul a b)
};
\definition data: Maps.Data := Maps.Data { fiber := \fun (x: X) => scalarIdentity };
\definition map: Maps.Map := \into[Maps.Data](data, Maps.Map) \by {
  Other.Universal[Y := Family.Point].continuous bundle.totalSpace (Maps.total data)
    (topology.Composition[A := Family.Point, B := X, C := Y].composeContinuous bundle.totalSpace baseSpace space Family.projection f Family.Of[bundle := bundle].projectionContinuous regular)
    valueContinuous
};
\definition onFiber: \forall (x: X)(a: K) -> (map.fiber x).apply a = a := \fun (x: X)(a: K) => \refl(a);
