\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ScalarLine[X := X, baseSpace := space] \as Other;
\definition forwardContinuous: topology.Continuity[A := X, B := X].Continuous baseSpace space (\fun (x: X) => x) :=
  \idelim baseSpace = space \with t: topology.Topology[Carrier := X].Topology => topology.Continuity[A := X, B := X].Continuous baseSpace t (\fun (x: X) => x) \by { base: topology.Maps[A := X, B := X].Identity[].continuous baseSpace, equality: sameBase };
\definition backwardContinuous: topology.Continuity[A := X, B := X].Continuous space baseSpace (\fun (x: X) => x) :=
  \idelim space = baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Continuity[A := X, B := X].Continuous space t (\fun (x: X) => x) \by { base: topology.Maps[A := X, B := X].Identity[].continuous space, equality: sym!{{topology.Topology[Carrier := X].Topology}} _ _ sameBase };
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ScalarLine[X := X, baseSpace := baseSpace].Mapping[Y := X, space := space, f := \fun (x: X) => x, regular := forwardContinuous] \as Forward;
\import Other.Mapping[Y := X, space := baseSpace, f := \fun (x: X) => x, regular := backwardContinuous] \as Backward;
\definition isomorphism: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := \fun (x: X) => K, G := \fun (x: X) => K, source := bundle, target := Other.bundle].Isomorphism :=
  vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := \fun (x: X) => K, G := \fun (x: X) => K, source := bundle, target := Other.bundle].Isomorphism {
    forward := Forward.map, backward := Backward.map, leftInverse := \fun (x: X)(a: K) => \refl(a), rightInverse := \fun (x: X)(a: K) => \refl(a)
  };
