\import topological_constructions.Product[A := X, B := K] \as Product;
\import Product.Maps[] \as Projections;
\definition forward[p: Family.Point]: Product.CarrierSet := Pair.pair X K p.base p.vector;
\definition backward[p: Product.CarrierSet]: Family.Point := Family.include (Pair.first X K p) (Pair.second X K p);
\definition topology: topology.Topology[Carrier := Product.CarrierSet].Topology := Product.topology baseSpace scalar.topological.space;
\definition forwardContinuous: topology.Continuity[A := Family.Point, B := Product.CarrierSet].Continuous bundle.totalSpace topology forward :=
  Product.Universal[X := Family.Point].pairContinuous bundle.totalSpace baseSpace scalar.topological.space Family.projection value (Family.Of[bundle := bundle].projectionContinuous) valueContinuous;
\definition backwardContinuous: topology.Continuity[A := Product.CarrierSet, B := Family.Point].Continuous topology bundle.totalSpace backward :=
  \parent.Universal[Y := Product.CarrierSet].continuous topology backward (Projections.firstContinuous baseSpace scalar.topological.space) (Projections.secondContinuous baseSpace scalar.topological.space);
\definition homeomorphism: topology.Homeomorphism[A := Family.Point, B := Product.CarrierSet].Homeomorphism[bundle.totalSpace, topology] :=
  topology.Homeomorphism[A := Family.Point, B := Product.CarrierSet].Homeomorphism[bundle.totalSpace, topology] {
    forward := forward, backward := backward, leftInverse := Family.eta, rightInverse := Pair.Prop[A := X, B := K].eta,
    forwardContinuous := forwardContinuous, backwardContinuous := backwardContinuous
  };
