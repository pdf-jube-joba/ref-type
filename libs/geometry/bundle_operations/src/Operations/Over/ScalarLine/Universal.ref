\import topological_constructions.Product[A := X, B := Vector Line.one] \as Product;
\import topological_algebra.Coordinates[K := K, I := Fin.Fin Line.one] \as Coordinates;
\definition continuous: \forall (source: topology.Topology[Carrier := Y].Topology)(f: Y -> Family.Point) ->
  topology.Continuity[A := Y, B := X].Continuous source baseSpace (\fun (y: Y) => (f y).base) ->
  topology.Continuity[A := Y, B := K].Continuous source scalar.topological.space (\fun (y: Y) => value (f y)) ->
  topology.Continuity[A := Y, B := Family.Point].Continuous source bundle.totalSpace f :=
  \fun (source: _)(f: _)(baseRegular: _)(valueRegular: _) => topological_constructions.Induced[A := Family.Point, B := vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := \fun (x: X) => Vector Line.one].Point].Universal[Z := Y].continuous
    source Trivial.topology Change.backward f
    (topology.Composition[A := Y, B := Product.CarrierSet, C := vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := \fun (x: X) => Vector Line.one].Point].composeContinuous source (Product.topology baseSpace (coordinateTopology Line.one)) Trivial.topology
      (\fun (y: Y) => Pair.pair X (Vector Line.one) (f y).base (Line.constant (value (f y)))) Trivial.backward
      (Product.Universal[X := Y].pairContinuous source baseSpace (coordinateTopology Line.one) (\fun (y: Y) => (f y).base) (\fun (y: Y) => Line.constant (value (f y))) baseRegular
        (Coordinates.Universal[A := Y].continuous source scalar.topological.space (\fun (y: Y) => Line.constant (value (f y))) (\fun (i: Fin.Fin Line.one) => valueRegular))) Trivial.backwardContinuous);
