\definition normal[v: A x][p: BC.Fiber x]: Target.TargetFiber x := Pair.pair (DE.Fiber x) (DF.Fiber x)
  (DE.pure x ((a.fiber x).apply v) ((b.fiber x).apply (Pair.first (B x) (C x) p)))
  (DF.pure x ((a.fiber x).apply v) ((c.fiber x).apply (Pair.second (B x) (C x) p)));
\definition leftNormal: \forall (v: A x)(p: BC.Fiber x) -> (firstPath.fiber x).apply (SourceTensor.pure x v p) = normal v p :=
  \fun (v: A x)(p: BC.Fiber x) => trans!{{Target.TargetFiber x}} _ _ _
    (congr!{{Target.SourceFiber x} {Target.TargetFiber x}} (Target.isomorphism.forward.fiber x).apply _ _ (InputMap.onPure a (SumMap.map b c) x v p))
    (Target.forwardOnPure x ((a.fiber x).apply v) (((SumMap.map b c).fiber x).apply p));
\definition rightNormal: \forall (v: A x)(p: BC.Fiber x) -> (secondPath.fiber x).apply (SourceTensor.pure x v p) = normal v p :=
  \fun (v: A x)(p: BC.Fiber x) => trans!{{Target.TargetFiber x}} _ _ _
    (congr!{{Source.TargetFiber x} {Target.TargetFiber x}} ((OutputMap.map (FirstMap.map a b) (SecondMap.map a c)).fiber x).apply _ _ (Source.forwardOnPure x v p))
    (Pair.Prop[A := DE.Fiber x, B := DF.Fiber x].pairCong _ _ _ _
      (FirstMap.onPure a b x v (Pair.first (B x) (C x) p)) (SecondMap.onPure a c x v (Pair.second (B x) (C x) p)));
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorEquality[V := A x, W := BC.Fiber x, U := Target.TargetFiber x, left := first.space x, right := BC.fiberSpace x, target := Target.targetBundle.space x] \as Equality;
\definition equality: \forall (t: Source.SourceFiber x) -> (firstPath.fiber x).apply t = (secondPath.fiber x).apply t := Equality.pointwise (firstPath.fiber x) (secondPath.fiber x) (\fun (v: A x)(p: BC.Fiber x) => trans!{{Target.TargetFiber x}} _ _ _ (leftNormal v p) (sym!{{Target.TargetFiber x}} _ _ (rightNormal v p)));
