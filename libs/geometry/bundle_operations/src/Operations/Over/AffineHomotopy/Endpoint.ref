\definition tStart: t (Cylinder.at I.start x) = field.zero := conjugation.embedZero;
\definition tEnd: t (Cylinder.at I.end x) = field.one := conjugation.embedOne;
\definition sStart: s (Cylinder.at I.start x) = field.one := trans!{{K}} _ _ _
  (congr!{{K} {K}} (\fun (a: K) => field.add field.one (field.neg a)) _ _ tStart)
  (trans!{{K}} _ _ _ (congr!{{K} {K}} (field.add field.one) _ _ Scalars.negZero) (Scalars.zeroRight field.one));
\definition sEnd: s (Cylinder.at I.end x) = field.zero := trans!{{K}} _ _ _
  (congr!{{K} {K}} (\fun (a: K) => field.add field.one (field.neg a)) _ _ tEnd) (Scalars.inverseRight field.one);
\import Spaces.Laws[V := G x, space := target.space x] \as Odd;
\definition start: \forall (v: F x) -> (map.fiber (Cylinder.at I.start x)).apply v = (first.fiber x).apply v :=
  \fun (v: F x) => trans!{{G x}} _ _ _
    (congr!{{K} {K} {G x}} (\fun (a, b: K) => (target.space x).add
      ((target.space x).smul a ((first.fiber x).apply v)) ((target.space x).smul b ((second.fiber x).apply v))) _ _ _ _ sStart tStart)
    (trans!{{G x}} _ _ _
      (congr!{{G x} {G x} {G x}} (target.space x).add _ _ _ _ ((target.space x).scalarOne ((first.fiber x).apply v)) (Odd.zeroScale ((second.fiber x).apply v)))
      (Odd.zeroRight ((first.fiber x).apply v)));
\definition end: \forall (v: F x) -> (map.fiber (Cylinder.at I.end x)).apply v = (second.fiber x).apply v :=
  \fun (v: F x) => trans!{{G x}} _ _ _
    (congr!{{K} {K} {G x}} (\fun (a, b: K) => (target.space x).add
      ((target.space x).smul a ((first.fiber x).apply v)) ((target.space x).smul b ((second.fiber x).apply v))) _ _ _ _ sEnd tEnd)
    (trans!{{G x}} _ _ _
      (congr!{{G x} {G x} {G x}} (target.space x).add _ _ _ _ (Odd.zeroScale ((first.fiber x).apply v)) ((target.space x).scalarOne ((second.fiber x).apply v)))
      (Odd.zeroLeft ((second.fiber x).apply v)));
