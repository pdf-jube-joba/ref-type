\import topology.Topology[Carrier := X] \as Base;
\definition newDomain[j: J]: \Pow X := domains j;
\definition newDimension[j: J]: N.Nat^ := (charts (refines j)).dimension;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Cocycle[X := X, I := J, baseSpace := bundle.baseSpace, domain := newDomain, dimension := newDimension] \as NewGlue;
\definition point[x: X][j: NewGlue.Index x]: \Cast[X] (domains j) := \into[X](x, domains j) \by { \bysub(J, { j: J \where Base.Member (newDomain j) x }, j) };
\definition originalPoint[x: X][j: NewGlue.Index x]: \Cast[X] (charts (refines j)).domain := \into[X](x, (charts (refines j)).domain) \by { contained j (point x j) };
\definition originalFrame[x: X][j: NewGlue.Index x]: Spaces.Isomorphism[V := F x, W := Vector (newDimension j), source := bundle.space x, target := coordinates (newDimension j)].Isomorphism := (charts (refines j)).frame (originalPoint x j);
\module At(j: J);
\definition Regular: \Prop := \forall (j: J) -> At[j := j].Regular;
\definition changed[regular: Regular][j: J]: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F].With[data := bundle].Chart := At[j := j].chart (regular j);
\definition Covers: \Prop := \forall (x: X) -> \exists NewGlue.Index x;
\module Using(regular: Regular, covers: Covers);
