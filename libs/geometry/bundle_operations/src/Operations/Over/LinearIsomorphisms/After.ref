\import Spaces.Isomorphism[V := W, W := U, source := target, target := space] \as Other;
\import Spaces.Isomorphism[V := V, W := U, source := source, target := space] \as Result;
\import Spaces.Linear[V := W, W := U, source := target, target := space].Composition[U := V, domain := source] \as Forward;
\import Spaces.Linear[V := W, W := V, source := target, target := source].Composition[U := U, domain := space] \as Backward;
\definition compose[first: Isomorphisms.Isomorphism][second: Other.Isomorphism]: Result.Isomorphism := Result.Isomorphism {
  forward := Forward.compose second.forward first.forward, backward := Backward.compose first.backward second.backward,
  leftInverse := \fun (v: V) => trans!{V} _ _ _ (congr!{W V} first.backward.apply _ _ ((Other.laws second).leftInverse (first.forward.apply v))) ((Isomorphisms.laws first).leftInverse v),
  rightInverse := \fun (u: U) => trans!{U} _ _ _ (congr!{W U} second.forward.apply _ _ ((Isomorphisms.laws first).rightInverse (second.backward.apply u))) ((Other.laws second).rightInverse u)
};
