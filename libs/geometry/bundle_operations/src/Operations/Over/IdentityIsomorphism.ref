\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Identity[X := X, F := F, bundle := bundle] \as Identity;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := F, G := F, source := bundle, target := bundle] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism { forward := Identity.map, backward := Identity.map, leftInverse := \fun (x: X)(v: F x) => \refl(v), rightInverse := \fun (x: X)(v: F x) => \refl(v) };
