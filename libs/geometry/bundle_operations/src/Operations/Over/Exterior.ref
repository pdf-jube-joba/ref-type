\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Dual[X := X, F := F, bundle := bundle] \as Dual;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Alternating[X := X, F := Dual.Fiber, bundle := Dual.dual, k := k] \as Alternating;
\definition Fiber[x: X]: \Set := Alternating.Fiber x;
\definition fiberSpace[x: X]: Spaces.VectorSpace (Fiber x) := Alternating.fiberSpace x;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Fiber] \as Family;
\definition exterior: Family.Bundle := Alternating.alternating;
\module Pullback(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  regular: topology.Continuity[A := Y, B := X].Continuous source bundle.baseSpace f);
\module Mapping(G: X -> \Set,
  target: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := G].Bundle,
  sameBase: bundle.baseSpace = target.baseSpace);
\module Wedge(Y: \Set, source: topology.Topology[Carrier := Y].Topology, base: Y -> X);
