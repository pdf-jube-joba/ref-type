\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Zero[X := X, baseSpace := source.baseSpace] \as Zero;
\import Zero.From[F := F, source := source, sameBase := \refl(source.baseSpace)] \as First;
\import Zero.To[F := G, target := target, sameBase := sameBase] \as Second;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := F, G := \fun (x: X) => Zero.Fiber, source := source, target := Zero.bundle, f := \fun (x: X) => x].Composition[Z := X, H := G, range := target, g := \fun (x: X) => x] \as Composition;
\definition map: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := F, G := G, source := source, target := target, f := \fun (x: X) => x].Map := Composition.compose First.map Second.map;
\definition onFiber: \forall (x: X)(v: F x) -> (map.fiber x).apply v = (target.space x).zero := \fun (x: X)(v: F x) => \refl((target.space x).zero);
