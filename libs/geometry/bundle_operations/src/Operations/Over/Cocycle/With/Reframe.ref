\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Cocycle[X := X, I := I, baseSpace := baseSpace, domain := domain, dimension := dimension].With[cocycle := cocycle] \as Original;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Atlas[X := X, I := I, F := Original.Fiber, baseSpace := baseSpace, space := Original.fiberSpace].Using[chart := Original.chart] \as Glued;
\definition originalBundle: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Original.Fiber].Bundle := Original.Construction[].bundle sourceRegular;
\definition compatible: Glued.Compatible := Original.Construction[].compatible sourceRegular;
\definition originalCharts[i: I]: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Original.Fiber].With[data := originalBundle].Chart := Glued.Local[i := i].trivialization compatible;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].AtlasChange[X := X, I := I, J := J, F := Original.Fiber, bundle := originalBundle, charts := originalCharts,
  refines := refines, domains := domains, opens := opens, contained := contained, gauge := gauge] \as Change;
\definition newDomain[j: J]: \Pow X := Change.newDomain j;
\definition newDimension[j: J]: N.Nat^ := Change.newDimension j;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Cocycle[X := X, I := J, baseSpace := baseSpace, domain := newDomain, dimension := newDimension] \as NewGlue;
\definition GaugeRegular: \Prop := Change.Regular;
\definition Covers: \Prop := Change.Covers;
\definition point[x: X][j: NewGlue.Index x]: \Cast[X] (domains j) := Change.point x j;
\definition oldIndex[x: X][j: NewGlue.Index x]: Index x := \into[I](refines j, { i: I \where Base.Member (domain i) x }) \by { contained j (point x j) };
\module Using(regular: GaugeRegular, covers: Covers);
