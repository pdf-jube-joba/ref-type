\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Fiber] \as Family;
\definition topology: topology.Topology[Carrier := Family.Point].Topology := Glued.topology;
\definition compatible: \forall (regular: Regular) -> Glued.Compatible := \fun (regular: Regular) => Glued.Compatible {
  openDomains := regular.openDomains, covers := regular.covers,
  transitions := \fun (i, j: I)(V: \Pow (\parent.Coordinates[i := i].Parameter))(open: _) => \idelim \parent.Overlap[i := i, j := j].Preimage V =
    topology.Maps[A := \parent.Coordinates[i := j].Parameter, B := Family.Point].Preimage (Atlas.In[c := chart j].parameter) (Atlas.In[c := chart i].Image V)
    \with U: \Pow (\parent.Coordinates[i := j].Parameter) => topology.Topology[Carrier := \parent.Coordinates[i := j].Parameter].IsOpenIn (\parent.Coordinates[i := j].topology) U \by {
      base: regular.transitions i j V open, equality: \parent.Overlap[i := i, j := j].preimageFormula V
    },
};
\definition bundle[regular: Regular]: Family.Bundle := Glued.bundle (compatible regular);
