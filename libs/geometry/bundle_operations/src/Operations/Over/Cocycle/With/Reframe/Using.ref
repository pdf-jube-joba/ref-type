\import Change.Using[regular := regular, covers := covers] \as Changed;
\definition newCocycle: NewGlue.Cocycle := Changed.cocycle;
\import NewGlue.With[cocycle := newCocycle] \as New;
\definition NewFiber[x: X]: \Set := New.Fiber x;
\definition cocycleContinuous: New.Continuous := Changed.cocycleContinuous;
\definition cocycleRegular: New.Regular := Changed.cocycleRegular;
\definition glued: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := NewFiber].Bundle := Changed.glued;
\definition comparison: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Original.Fiber, G := NewFiber, source := originalBundle, target := glued].Isomorphism := Changed.comparison;
\definition transitionFormula: \forall (x: X)(j, k: NewGlue.Index x)(v: Vector (newDimension j)) -> (newCocycle.transition x j k).forward.apply v =
  (gauge k (point x k)).forward.apply ((cocycle.transition x (oldIndex x j) (oldIndex x k)).forward.apply ((gauge j (point x j)).backward.apply v)) :=
  \fun (x: X)(j, k: NewGlue.Index x)(v: Vector (newDimension j)) => trans!{{Vector (newDimension k)}} _ _ _
    (Changed.transitionFormula x j k v)
    (congr!{{Vector (newDimension k)} {Vector (newDimension k)}} (gauge k (point x k)).forward.apply _ _
      (Original.At[x := x].Frame[i := oldIndex x j].assembledValue ((gauge j (point x j)).backward.apply v) (oldIndex x k)));
