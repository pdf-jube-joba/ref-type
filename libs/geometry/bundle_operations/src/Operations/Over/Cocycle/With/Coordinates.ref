\import Atlas.In[c := chart i] \as Local;
\definition Parameter: \Set := Local.Parameter;
\definition topology: topology.Topology[Carrier := Parameter].Topology := Local.topology;
\definition base[p: Parameter]: \Cast[X] (domain i) := Pair.first (\Cast[X] (domain i)) (Vector (dimension i)) p;
\definition vector[p: Parameter]: Vector (dimension i) := Pair.second (\Cast[X] (domain i)) (Vector (dimension i)) p;
