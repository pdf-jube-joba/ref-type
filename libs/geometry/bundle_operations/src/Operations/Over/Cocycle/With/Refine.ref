\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Cocycle[X := X, I := I, baseSpace := baseSpace, domain := domain, dimension := dimension].With[cocycle := cocycle] \as Original;
\definition identityGauge[j: J][x: \Cast[X] (domains j)]: Spaces.Isomorphism[V := Vector (dimension (refines j)), W := Vector (dimension (refines j)), source := coordinates (dimension (refines j)), target := coordinates (dimension (refines j))].Isomorphism :=
  \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IdentityFrame[n := dimension (refines j)].isomorphism;
\import Original.Reframe[sourceRegular := sourceRegular, J := J, refines := refines, domains := domains, opens := opens, contained := contained, gauge := identityGauge] \as Change;
\definition gaugeRegular: Change.GaugeRegular := \fun (j: J) => \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].IdentityGauge[X := X, U := domains j, n := dimension (refines j), baseSpace := baseSpace].regular;
\import Change.Using[regular := gaugeRegular, covers := covers] \as Changed;
\definition newDomain[j: J]: \Pow X := domains j;
\definition newDimension[j: J]: N.Nat^ := dimension (refines j);
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Cocycle[X := X, I := J, baseSpace := baseSpace, domain := newDomain, dimension := newDimension] \as NewGlue;
\definition newCocycle: NewGlue.Cocycle := Changed.newCocycle;
\import NewGlue.With[cocycle := newCocycle] \as New;
\definition NewFiber[x: X]: \Set := New.Fiber x;
\definition cocycleContinuous: New.Continuous := Changed.cocycleContinuous;
\definition cocycleRegular: New.Regular := Changed.cocycleRegular;
\definition originalBundle: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := Original.Fiber].Bundle := Change.originalBundle;
\definition glued: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := NewFiber].Bundle := Changed.glued;
\definition comparison: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Original.Fiber, G := NewFiber, source := originalBundle, target := glued].Isomorphism := Changed.comparison;
\definition oldIndex[x: X][j: NewGlue.Index x]: Index x := Change.oldIndex x j;
\definition transitionFormula: \forall (x: X)(j, k: NewGlue.Index x)(v: Vector (newDimension j)) -> (newCocycle.transition x j k).forward.apply v = (cocycle.transition x (oldIndex x j) (oldIndex x k)).forward.apply v := Changed.transitionFormula;
