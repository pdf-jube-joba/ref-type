\definition zero: N.Nat^ := N.Nat^::zero;
\definition Fiber: \Set := Vector zero;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Trivial[X := X, n := zero, baseSpace := baseSpace] \as Trivial;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := \fun (x: X) => Fiber] \as Family;
\definition bundle: Family.Bundle := Trivial.bundle;
\import Fin.Empty[A := K] \as Empty;
\module From(F: X -> \Set,
  source: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F].Bundle,
  sameBase: source.baseSpace = baseSpace);
\module To(F: X -> \Set,
  target: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F].Bundle,
  sameBase: baseSpace = target.baseSpace);
\module Equality(space: topology.Topology[Carrier := X].Topology, sameBase: baseSpace = space);
