\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F] \as Original;
\import Original.With[data := left].In[c := c] \as Coordinates;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Chart[X := X, F := F, bundle := left, chart := c] \as Chart;
\definition original[i: SourceParameters.Index][p: Point]: Coordinates.TotalPoint := \into[Original.Point](SourceParameters.left p i, { q: Original.Point \where Base.Member c.domain q.base }) \by {
  (\bysub(SourceParameters.Point, Domain, p)).left
};
\import topology.Continuity[A := SourceParameters.Point, B := Original.Point].Restriction[S := Domain] \as Restriction;
\definition coordinates[i: SourceParameters.Index][p: Point]: Vector c.dimension := Chart.Maps[Y := Point, source := topology].vector (original i) p;
\definition regular: \forall (i: SourceParameters.Index) -> topology.Continuity[A := Point, B := Vector c.dimension].Continuous topology (coordinateTopology c.dimension) (coordinates i) :=
  \fun (i: SourceParameters.Index) => Chart.Maps[Y := Point, source := topology].vectorContinuous (original i)
    (Restriction.restrictContinuous SourceParameters.topology left.totalSpace (\fun (p: SourceParameters.Point) => SourceParameters.left p i) (SourceParameters.Projection[].leftContinuous i));
\definition entry[i: SourceParameters.Index][j: Fin.Fin c.dimension][p: Point]: K := coordinates i p j;
\import topological_algebra.Coordinates[K := K, I := Fin.Fin c.dimension] \as Vectors;
\import topology.Composition[A := Point, B := Vector c.dimension, C := K] \as Evaluation;
\definition entryContinuous: \forall (i: SourceParameters.Index)(j: Fin.Fin c.dimension) -> topology.Continuity[A := Point, B := K].Continuous topology scalar.topological.space (entry i j) :=
  \fun (i: SourceParameters.Index)(j: Fin.Fin c.dimension) => Evaluation.composeContinuous topology (coordinateTopology c.dimension) scalar.topological.space (coordinates i) (\fun (v: Vector c.dimension) => v j) (regular i) (Vectors.evaluationContinuous scalar.topological.space j);
