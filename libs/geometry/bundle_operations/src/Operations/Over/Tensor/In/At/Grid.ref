\import Spaces.Sums[I := Fin.Fin r].Vector[V := Fiber x, space := fiberSpace x] \as Outer;
\import Spaces.Sums[I := Fin.Fin s].Vector[V := Fiber x, space := fiberSpace x] \as Inner;
\import Spaces.Sums[I := Fin.Fin r] \as Scalars;
\import Scalars.Prop[] \as Laws;
\import Spaces.Sums[I := Fin.Fin s] \as InnerScalars;
\definition value[v: Fin.Fin r -> Fin.Fin s -> F x][w: Fin.Fin r -> Fin.Fin s -> G x]: Fiber x := Outer.sum (Fin.elements r) (\fun (a: Fin.Fin r) => Inner.sum (Fin.elements s) (\fun (b: Fin.Fin s) => pure x (v a b) (w a b)));
\definition formula: \forall (v: Fin.Fin r -> Fin.Fin s -> F x)(w: Fin.Fin r -> Fin.Fin s -> G x)(p: Coefficients.Index) -> coefficient (value v w) p =
  Scalars.sum (Fin.elements r) (\fun (a: Fin.Fin r) => InnerScalars.sum (Fin.elements s) (\fun (b: Fin.Fin s) =>
    field.mul ((c.frame inLeft).forward.apply (v a b) (Pair.first (Fin.Fin c.dimension) (Fin.Fin d.dimension) p)) ((d.frame inRight).forward.apply (w a b) (Pair.second (Fin.Fin c.dimension) (Fin.Fin d.dimension) p)))) :=
  \fun (v: _)(w: _)(p: Coefficients.Index) => trans!{K} _ _ _
    (Frames.Sums[I := Fin.Fin r].nested (Fin.elements r) (\fun (a: Fin.Fin r) => Inner.sum (Fin.elements s) (\fun (b: Fin.Fin s) => pure x (v a b) (w a b))) p)
    (Laws.congruent (Fin.elements r) _ _ (\fun (a: Fin.Fin r) => Frames.Sums[I := Fin.Fin s].formula (Fin.elements s) (v a) (w a) p));
