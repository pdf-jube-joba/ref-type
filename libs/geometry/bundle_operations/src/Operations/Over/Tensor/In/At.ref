\definition inLeft: \Cast[X] c.domain := \into[X](x, c.domain) \by { (\bysub(X, domain, x)).left };
\definition inRight: \Cast[X] d.domain := \into[X](x, d.domain) \by { (\bysub(X, domain, x)).right };
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorFrame[V := F x, W := G x, left := left.space x, right := right.space x, n := c.dimension, m := d.dimension, first := c.frame inLeft, second := d.frame inRight] \as Frames;
\definition frame: Spaces.Isomorphism[V := Fiber x, W := Vector dimension, source := fiberSpace x, target := coordinates dimension].Isomorphism := Frames.Enumerated[enumeration := enumeration].frame;
\definition coefficient[t: Fiber x][p: Coefficients.Index]: K := Frames.forward.apply t p;
\module Grid(r, s: N.Nat^);
