\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := G] \as Original;
\import Original.With[data := right].In[c := d] \as Coordinates;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Chart[X := X, F := G, bundle := right, chart := d] \as Chart;
\definition original[i: SourceParameters.Index][p: Point]: Coordinates.TotalPoint := \into[Original.Point](SourceParameters.right p i, { q: Original.Point \where Base.Member d.domain q.base }) \by {
  (\bysub(SourceParameters.Point, Domain, p)).right
};
\import topology.Continuity[A := SourceParameters.Point, B := Original.Point].Restriction[S := Domain] \as Restriction;
\definition coordinates[i: SourceParameters.Index][p: Point]: Vector d.dimension := Chart.Maps[Y := Point, source := topology].vector (original i) p;
\definition regular: \forall (i: SourceParameters.Index) -> topology.Continuity[A := Point, B := Vector d.dimension].Continuous topology (coordinateTopology d.dimension) (coordinates i) :=
  \fun (i: SourceParameters.Index) => Chart.Maps[Y := Point, source := topology].vectorContinuous (original i)
    (Restriction.restrictContinuous SourceParameters.topology right.totalSpace (\fun (p: SourceParameters.Point) => SourceParameters.right p i) (SourceParameters.Projection[].rightContinuous i));
\definition entry[i: SourceParameters.Index][j: Fin.Fin d.dimension][p: Point]: K := coordinates i p j;
\import topological_algebra.Coordinates[K := K, I := Fin.Fin d.dimension] \as Vectors;
\import topology.Composition[A := Point, B := Vector d.dimension, C := K] \as Evaluation;
\definition entryContinuous: \forall (i: SourceParameters.Index)(j: Fin.Fin d.dimension) -> topology.Continuity[A := Point, B := K].Continuous topology scalar.topological.space (entry i j) :=
  \fun (i: SourceParameters.Index)(j: Fin.Fin d.dimension) => Evaluation.composeContinuous topology (coordinateTopology d.dimension) scalar.topological.space (coordinates i) (\fun (v: Vector d.dimension) => v j) (regular i) (Vectors.evaluationContinuous scalar.topological.space j);
