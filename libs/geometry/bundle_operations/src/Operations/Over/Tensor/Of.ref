\definition tensor: Family.Bundle := bundle same;
\module Universal(Y: \Set, H: Y -> \Set,
  target: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := H].Bundle, f: X -> Y);
\module Pure;
\module Mapping(Y: \Set, A, B: Y -> \Set,
  leftTarget: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := A].Bundle,
  rightTarget: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := B].Bundle, f: X -> Y);
\module Pullback(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  regular: topology.Continuity[A := Y, B := X].Continuous source left.baseSpace f);
\module Parametric(Y: \Set, source: topology.Topology[Carrier := Y].Topology, base: Y -> X, H: X -> \Set,
  target: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := H].Bundle,
  sameTarget: left.baseSpace = target.baseSpace);
\module Transpose;
\module Symmetry;
\module LinearFromPure(Y: \Set, H: Y -> \Set,
  target: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := H].Bundle, f: X -> Y);
