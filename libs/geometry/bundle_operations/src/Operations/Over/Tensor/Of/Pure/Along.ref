\definition Vectors: \Set := \forall (y: Y) -> F (base y);
\definition RightVectors: \Set := \forall (y: Y) -> G (base y);
\definition pair[v: Vectors][w: RightVectors][y: Y]: SourceFamily.Point := SourceFamily.include (base y) (Pair.pair (F (base y)) (G (base y)) (v y) (w y));
\definition total[v: Vectors][w: RightVectors][y: Y]: Family.Point := Family.include (base y) (pure (base y) (v y) (w y));
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := F, G := G, left := left, right := right].Of[same := same].Pure[] \as Pure;
\definition continuous: \forall (v: Vectors)(w: RightVectors) ->
  topology.Continuity[A := Y, B := Left.Point].Continuous source left.totalSpace (\fun (y: Y) => Left.include (base y) (v y)) ->
  topology.Continuity[A := Y, B := Right.Point].Continuous source right.totalSpace (\fun (y: Y) => Right.include (base y) (w y)) ->
  topology.Continuity[A := Y, B := Family.Point].Continuous source topology (total v w) :=
  \fun (v: Vectors)(w: RightVectors)(vc: _)(wc: _) => topology.Composition[A := Y, B := SourceFamily.Point, C := Family.Point].composeContinuous source Source.topology topology (pair v w) Pure.value
    (Source.Universal[Y := Y].continuous source (pair v w) vc wc) Pure.continuous;
