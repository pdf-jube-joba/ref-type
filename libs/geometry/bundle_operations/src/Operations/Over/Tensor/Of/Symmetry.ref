\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := F, G := G, left := left, right := right].Of[same := same].Transpose[] \as Forward;
\definition reverseBase: right.baseSpace = left.baseSpace := sym!{{topology.Topology[Carrier := X].Topology}} _ _ same;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := G, G := F, left := right, right := left] \as Other;
\import Other.Of[same := reverseBase].Transpose[] \as Backward;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Isomorphisms[X := X, F := Fiber, G := Other.Fiber, source := tensor, target := Other.bundle reverseBase] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := Forward.map, backward := Backward.map,
  leftInverse := \fun (x: X) => \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorFlip[V := F x, W := G x, left := left.space x, right := right.space x].Inverse[].leftInverse,
  rightInverse := \fun (x: X) => \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorFlip[V := F x, W := G x, left := left.space x, right := right.space x].Inverse[].rightInverse
};
