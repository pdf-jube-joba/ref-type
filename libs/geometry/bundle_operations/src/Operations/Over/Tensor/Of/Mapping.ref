\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := F, G := G, left := left, right := right] \as SourceSum;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := Y, F := A, G := B, left := leftTarget, right := rightTarget] \as TargetSum;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := Y, F := A, G := B, left := leftTarget, right := rightTarget] \as TargetTensor;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := \fun (x: X) => Pair.Times^[F x, G x]] \as SourcePair;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := \fun (y: Y) => Pair.Times^[A y, B y]] \as TargetPair;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := TargetTensor.Fiber] \as TargetFamily;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := Y, F := F, G := A, source := left, target := leftTarget, f := f] \as LeftMaps;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := Y, F := G, G := B, source := right, target := rightTarget, f := f] \as RightMaps;
\definition pair[a: LeftMaps.Map][b: RightMaps.Map][p: SourcePair.Point]: TargetPair.Point := TargetPair.include (f p.base)
  (Pair.pair (A (f p.base)) (B (f p.base)) ((a.fiber p.base).apply (Pair.first (F p.base) (G p.base) p.vector)) ((b.fiber p.base).apply (Pair.second (F p.base) (G p.base) p.vector)));
\definition pairContinuous: \forall (a: LeftMaps.Map)(b: RightMaps.Map) -> topology.Continuity[A := SourcePair.Point, B := TargetPair.Point].Continuous SourceSum.topology TargetSum.topology (pair a b) :=
  \fun (a: LeftMaps.Map)(b: RightMaps.Map) => TargetSum.Universal[Y := SourcePair.Point].continuous SourceSum.topology (pair a b)
    (topology.Composition[A := SourcePair.Point, B := Left.Point, C := vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := A].Point].composeContinuous SourceSum.topology left.totalSpace leftTarget.totalSpace SourceSum.first (LeftMaps.total a) SourceSum.firstContinuous (LeftMaps.continuous a))
    (topology.Composition[A := SourcePair.Point, B := Right.Point, C := vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := Y, F := B].Point].composeContinuous SourceSum.topology right.totalSpace rightTarget.totalSpace SourceSum.second (RightMaps.total b) SourceSum.secondContinuous (RightMaps.continuous b));
\module Of(targetSame: TargetTensor.SameBase);
