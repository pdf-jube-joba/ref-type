\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorFrame[V := F (base y), W := G (base y), left := left.space (base y), right := right.space (base y),
  n := p.first.dimension, m := p.second.dimension, first := p.first.frame (inLeft y), second := p.second.frame (inRight y)] \as Frames;
\import Frames.Enumerated[enumeration := p.enumeration] \as LocalFrame;
\import Spaces.Isomorphism[V := Fiber (base y), W := Vector Coordinates.rank, source := fiberSpace (base y), target := coordinates Coordinates.rank] \as Isomorphisms;
\definition formula: \forall (h: Operators)(t: Input.Vectors) -> (h y).apply (t y) = model h t y :=
  \fun (h: Operators)(t: Input.Vectors) => trans!{{H (base y)}} _ _ _
    (congr!{{Fiber (base y)} {H (base y)}} (h y).apply _ _ (sym!{{Fiber (base y)}} _ _ ((Isomorphisms.laws LocalFrame.frame).leftInverse (t y))))
    (Frames.Summation[U := H (base y), target := target.space (base y)].law (h y) (Coordinates.decode (Read.coordinate t y)));
