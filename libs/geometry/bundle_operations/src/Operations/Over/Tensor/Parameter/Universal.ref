\definition continuous: \forall (source: topology.Topology[Carrier := Y].Topology)(f: Y -> Point) ->
  topology.Continuity[A := Y, B := X].Continuous source leftBundle.baseSpace (\fun (y: Y) => (f y).base) ->
  (\forall (i: Index) -> topology.Continuity[A := Y, B := Left.Point].Continuous source leftBundle.totalSpace (\fun (y: Y) => left (f y) i)) ->
  (\forall (i: Index) -> topology.Continuity[A := Y, B := Right.Point].Continuous source rightBundle.totalSpace (\fun (y: Y) => right (f y) i)) ->
  topology.Continuity[A := Y, B := Point].Continuous source topology f :=
  \fun (source: _)(f: _)(baseRegular: _)(leftRegular: _)(rightRegular: _) => Induced.Universal[Z := Y].continuous source productSpace embedding f
    (Product.Universal[X := Y].pairContinuous source leftBundle.baseSpace powers (\fun (y: Y) => (f y).base) (\fun (y: Y) => Pair.pair LeftPower.Carrier RightPower.Carrier (left (f y)) (right (f y))) baseRegular
      (Powers.Universal[X := Y].pairContinuous source (LeftPower.topology leftBundle.totalSpace) (RightPower.topology rightBundle.totalSpace) (\fun (y: Y) => left (f y)) (\fun (y: Y) => right (f y))
        (LeftPower.Universal[A := Y].continuous source leftBundle.totalSpace (\fun (y: Y) => left (f y)) leftRegular)
        (RightPower.Universal[A := Y].continuous source rightBundle.totalSpace (\fun (y: Y) => right (f y)) rightRegular)));
