\import Spaces.Linear[V := V, W := W, source := space, target := target] \as Original;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].RealScalars[V := W, space := target] \as Other;
\import Real.Linear[V := V, W := W, source := realSpace, target := Other.realSpace] \as Maps;
\definition map[f: Original.Map]: Maps.Map := Maps.Map { apply := f.apply, preservesAdd := f.preservesAdd, preservesScale := \fun (a: R.Real)(v: V) => f.preservesScale (conjugation.embed a) v };
\import Spaces.Isomorphism[V := V, W := W, source := space, target := target] \as Isomorphisms;
\definition isomorphism[iso: Isomorphisms.Isomorphism]: Real.Isomorphism[V := V, W := W, source := realSpace, target := Other.realSpace].Isomorphism :=
  Real.Isomorphism[V := V, W := W, source := realSpace, target := Other.realSpace].Isomorphism {
    forward := map iso.forward,
    backward := Other.Maps[W := V, target := space].map iso.backward,
    leftInverse := (Isomorphisms.laws iso).leftInverse, rightInverse := (Isomorphisms.laws iso).rightInverse
  };
