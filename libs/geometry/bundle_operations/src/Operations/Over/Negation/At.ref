\import Spaces.Laws[V := F x, space := bundle.space x] \as Laws;
\import std.Alg[].Ring[] \as Rings;
\import algebra.Group[].Of[Carrier := F x, group := (Rings.ringModuleAsCommutativeGroup K (F x) Spaces.ring (bundle.space x))] \as Additive;
\definition formula: \forall (v: F x) -> (map.fiber x).apply v = (bundle.space x).neg v := Laws.minusOneScale;
\definition inverse: \forall (v: F x) -> (map.fiber x).apply ((map.fiber x).apply v) = v :=
  \fun (v: F x) => trans!{{F x}} _ _ _ (congr!{{F x} {F x}} (map.fiber x).apply _ _ (formula v))
    (trans!{{F x}} _ _ _ (formula ((bundle.space x).neg v)) (Additive.negNeg v));
