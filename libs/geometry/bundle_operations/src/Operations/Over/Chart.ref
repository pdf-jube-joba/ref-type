\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F] \as Family;
\import Family.With[data := bundle] \as Charts;
\import Charts.In[c := chart] \as Coordinates;
\import topology.Topology[Carrier := X] \as Base;
\import topology.Topology[Carrier := Family.Point] \as Total;
\import Base.Subspace[S := chart.domain] \as BaseSubspace;
\import Total.Subspace[S := { p: Family.Point \where Base.Member chart.domain p.base }] \as TotalSubspace;
\import topological_constructions.Product[A := Coordinates.BasePoint, B := Vector chart.dimension] \as Product;
\definition laws: Coordinates.Laws := \bysub(Charts.ChartData, Charts.Chart, chart);
\module Maps(Y: \Set, source: topology.Topology[Carrier := Y].Topology);
