\definition BasePoint: \Set := \Cast[X] U;
\definition Point: \Set := Pair.Times^[BasePoint, Vector n];
\definition topology: topology.Topology[Carrier := Point].Topology := topological_constructions.Product[A := BasePoint, B := Vector n].topology (topology.Topology[Carrier := X].Subspace[S := U].topology baseSpace) (coordinateTopology n);
\definition forward[p: Point]: Point := Pair.pair BasePoint (Vector n) (Pair.first BasePoint (Vector n) p) ((gauge (Pair.first BasePoint (Vector n) p)).forward.apply (Pair.second BasePoint (Vector n) p));
\definition backward[p: Point]: Point := Pair.pair BasePoint (Vector n) (Pair.first BasePoint (Vector n) p) ((gauge (Pair.first BasePoint (Vector n) p)).backward.apply (Pair.second BasePoint (Vector n) p));
\structure Regular: \Prop := {
  forward: topology.Continuity[A := Point, B := Point].Continuous topology topology forward,
  backward: topology.Continuity[A := Point, B := Point].Continuous topology topology backward
};
