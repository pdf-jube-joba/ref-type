\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].ScalarLine[X := X, baseSpace := source.baseSpace] \as Unit;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorUnit[X := X, F := F, bundle := source] \as Source;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorUnitAtBase[X := X, F := G, bundle := target, baseSpace := source.baseSpace, sameBase := sameBase] \as Target;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := \fun (x: X) => K, G := F, left := Unit.bundle, right := source] \as Domain;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Tensor[X := X, F := \fun (x: X) => K, G := G, left := Unit.bundle, right := target] \as Middle;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Identity[X := X, F := \fun (x: X) => K, bundle := Unit.bundle] \as Identity;
\import Domain.Of[same := \refl(source.baseSpace)].Mapping[Y := X, A := \fun (x: X) => K, B := G, leftTarget := Unit.bundle, rightTarget := target, f := \fun (x: X) => x].Of[targetSame := sameBase] \as Mapping;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Domain.Fiber, G := Middle.Fiber, source := Source.tensor, target := Target.sourceBundle, f := \fun (x: X) => x].Composition[Z := X, H := G, range := target, g := \fun (x: X) => x] \as First;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Domain.Fiber, G := F, source := Source.tensor, target := source, f := \fun (x: X) => x].Composition[Z := X, H := G, range := target, g := \fun (x: X) => x] \as Second;
\definition firstPath: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Domain.Fiber, G := G, source := Source.tensor, target := target, f := \fun (x: X) => x].Map := First.compose (Mapping.map Identity.map a) Target.isomorphism.forward;
\definition secondPath: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Domain.Fiber, G := G, source := Source.tensor, target := target, f := \fun (x: X) => x].Map := Second.compose Source.isomorphism.forward a;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Domain.Fiber, G := G, source := Source.tensor, target := target, f := \fun (x: X) => x] \as Result;
\module At(x: X);
\definition naturality: firstPath = secondPath := Result.ext firstPath secondPath (\fun (x: X) => At[x := x].equality);
