\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := F, G := G, left := left, right := right] \as Source;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := Y, F := A, G := B, left := targetLeft, right := targetRight] \as Target;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := G, G := F, left := right, right := left] \as SourceReverse;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := Y, F := B, G := A, left := targetRight, right := targetLeft] \as TargetReverse;
\definition sourceReverseSame: right.baseSpace = left.baseSpace := sym!{{topology.Topology[Carrier := X].Topology}} _ _ sourceSame;
\definition targetReverseSame: targetRight.baseSpace = targetLeft.baseSpace := sym!{{topology.Topology[Carrier := Y].Topology}} _ _ targetSame;
\import Source.Of[same := sourceSame].Symmetry[] \as SourceSwap;
\import Target.Of[same := targetSame].Symmetry[] \as TargetSwap;
\import Source.Of[same := sourceSame].Mapping[Y := Y, A := A, B := B, leftTarget := targetLeft, rightTarget := targetRight, f := f, targetSame := targetSame] \as Mapping;
\import SourceReverse.Of[same := sourceReverseSame].Mapping[Y := Y, A := B, B := A, leftTarget := targetRight, rightTarget := targetLeft, f := f, targetSame := targetReverseSame] \as ReverseMapping;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := Y, F := Source.Fiber, G := Target.Fiber, source := Source.bundle sourceSame, target := Target.bundle targetSame, f := f].Composition[Z := Y, H := TargetReverse.Fiber, range := TargetReverse.bundle targetReverseSame, g := \fun (y: Y) => y] \as First;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Source.Fiber, G := SourceReverse.Fiber, source := Source.bundle sourceSame, target := SourceReverse.bundle sourceReverseSame, f := \fun (x: X) => x].Composition[Z := Y, H := TargetReverse.Fiber, range := TargetReverse.bundle targetReverseSame, g := f] \as Second;
\definition firstPath: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := Y, F := Source.Fiber, G := TargetReverse.Fiber, source := Source.bundle sourceSame, target := TargetReverse.bundle targetReverseSame, f := \fun (x: X) => f x].Map := First.compose (Mapping.map a b) TargetSwap.isomorphism.forward;
\definition secondPath: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := Y, F := Source.Fiber, G := TargetReverse.Fiber, source := Source.bundle sourceSame, target := TargetReverse.bundle targetReverseSame, f := \fun (x: X) => f x].Map := Second.compose SourceSwap.isomorphism.forward (ReverseMapping.map b a);
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := Y, F := Source.Fiber, G := TargetReverse.Fiber, source := Source.bundle sourceSame, target := TargetReverse.bundle targetReverseSame, f := \fun (x: X) => f x] \as Result;
\definition naturality: firstPath = secondPath := Result.ext firstPath secondPath (\fun (x: X)(v: Source.Fiber x) => \refl((firstPath.fiber x).apply v));
