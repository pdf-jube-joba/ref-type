\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorAssociate[V := F x, W := G x, U := H x, left := left.space x, middle := middle.space x, right := right.space x] \as Associate;
\definition isomorphism: Spaces.Isomorphism[V := SourceTensor.Fiber x, W := TargetTensor.Fiber x, source := SourceTensor.fiberSpace x, target := TargetTensor.fiberSpace x].Isomorphism := Associate.isomorphism;
\definition forwardParameter[u: H x]: Spaces.Linear[V := First.Fiber x, W := TargetTensor.Fiber x, source := First.fiberSpace x, target := TargetTensor.fiberSpace x].Map := Associate.forwardParameter u;
\definition backwardParameter[v: F x]: Spaces.Linear[V := Last.Fiber x, W := SourceTensor.Fiber x, source := Last.fiberSpace x, target := SourceTensor.fiberSpace x].Map := Associate.backwardParameter v;
\definition forwardOnTensor: \forall (t: First.Fiber x)(u: H x) -> isomorphism.forward.apply (SourceTensor.pure x t u) = (forwardParameter u).apply t := Associate.forwardOnTensor;
\definition backwardOnTensor: \forall (v: F x)(t: Last.Fiber x) -> isomorphism.backward.apply (TargetTensor.pure x v t) = (backwardParameter v).apply t := Associate.backwardOnTensor;
\definition forwardOnPure: \forall (u: H x)(v: F x)(w: G x) -> (forwardParameter u).apply (First.pure x v w) = TargetTensor.pure x v (Last.pure x w u) := Associate.forwardParameterOnPure;
\definition backwardOnPure: \forall (v: F x)(w: G x)(u: H x) -> (backwardParameter v).apply (Last.pure x w u) = SourceTensor.pure x (First.pure x v w) u := Associate.backwardParameterOnPure;
