\import topology.Topology[Carrier := X] \as Base;
\definition A: \Set := \Cast[X] S;
\definition space: topology.Topology[Carrier := A].Topology := Base.Subspace[S := S].topology bundle.baseSpace;
\definition inclusion[x: A]: X := x;
\definition regular: topology.Continuity[A := A, B := X].Continuous space bundle.baseSpace inclusion := topology.Continuity[A := A, B := X].Corestriction[S := S].inclusionContinuous bundle.baseSpace;
\import Bundles.Family[X := X, F := F].Of[bundle := bundle].Pullback[Y := A, source := space, f := inclusion] \as Pull;
\definition Fiber[x: A]: \Set := F x;
\definition source: Bundles.Family[X := A, F := Fiber].Bundle := Pull.pulled regular;
\definition pulledChart: Bundles.Family[X := A, F := Fiber].With[data := source].Chart := Pull.In[c := chart].trivialization regular;
\definition covers: \forall (x: A) -> \In[A] pulledChart.domain x := \fun (x: A) => inside x (\bysub(X, S, x));
\import \parent.GlobalFrame[X := A, F := Fiber, bundle := source, chart := pulledChart, covers := covers] \as Frame;
\import \parent.TrivialPullback[X := X, Y := A, n := chart.dimension, original := bundle.baseSpace, base := space, f := inclusion, regular := regular] \as Trivial;
\definition target: Bundles.Family[X := A, F := (\fun (x: A) => Vector chart.dimension)].Bundle := Trivial.pulled;
\import Bundles.Isomorphisms[X := A, F := (\fun (x: A) => Vector chart.dimension), G := (\fun (x: A) => Vector chart.dimension),
  source := target, target := Bundles.Trivial[X := A, n := chart.dimension, baseSpace := space].bundle] \as Reverse;
\import \parent.IsomorphismComposition[X := A, F := Fiber, G := (\fun (x: A) => Vector chart.dimension), H := (\fun (x: A) => Vector chart.dimension),
  source := source, middle := Bundles.Trivial[X := A, n := chart.dimension, baseSpace := space].bundle, target := target] \as Composition;
\definition isomorphism: Composition.Isomorphism := Composition.compose Frame.isomorphism (Reverse.inverse Trivial.isomorphism);
\definition formula: \forall (x: A)(v: F x) -> (isomorphism.forward.fiber x).apply v =
  (chart.frame (\into[X](x, chart.domain) \by { inside x (\bysub(X, S, x)) })).forward.apply v := \fun (x: A)(v: F x) =>
    \refl((chart.frame (\into[X](x, chart.domain) \by { inside x (\bysub(X, S, x)) })).forward.apply v);
