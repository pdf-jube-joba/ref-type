\import Spaces.Tensor[V := V, W := W, left := left, right := right] \as Tensor;
\definition first[v: V]: Spaces.Linear[V := W, W := Tensor.Carrier, source := right, target := Tensor.space].Map := Spaces.Linear[V := W, W := Tensor.Carrier, source := right, target := Tensor.space].Map {
  apply := Tensor.tensor v, preservesAdd := Tensor.bilinear.addRight v, preservesScale := \fun (a: K)(w: W) => Tensor.bilinear.scaleRight a v w
};
\definition second[w: W]: Spaces.Linear[V := V, W := Tensor.Carrier, source := left, target := Tensor.space].Map := Spaces.Linear[V := V, W := Tensor.Carrier, source := left, target := Tensor.space].Map {
  apply := \fun (v: V) => Tensor.tensor v w, preservesAdd := \fun (v, z: V) => Tensor.bilinear.addLeft v z w, preservesScale := \fun (a: K)(v: V) => Tensor.bilinear.scaleLeft a v w
};
\definition zeroRight: \forall (v: V) -> Tensor.tensor v right.zero = Tensor.origin := \fun (v: V) => (first v).preservesZero;
\definition zeroLeft: \forall (w: W) -> Tensor.tensor left.zero w = Tensor.origin := \fun (w: W) => (second w).preservesZero;
