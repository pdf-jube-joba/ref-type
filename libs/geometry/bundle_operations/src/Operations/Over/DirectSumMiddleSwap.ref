\import topology.Topology[Carrier := X] \as Base;
\definition sameLast: third.baseSpace = fourth.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameThird) sameFourth;
\definition sameOuter: second.baseSpace = fourth.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameSecond) sameFourth;
\import \parent.DirectSum[X := X, F := F, G := G, left := first, right := second] \as AB;
\definition bundleAB: Bundles.Family[X := X, F := AB.Fiber].Bundle := AB.bundle sameSecond;
\import AB.Of[same := sameSecond] \as ABMaps;
\import \parent.DirectSum[X := X, F := H, G := I, left := third, right := fourth] \as CD;
\definition bundleCD: Bundles.Family[X := X, F := CD.Fiber].Bundle := CD.bundle sameLast;
\import CD.Of[same := sameLast] \as CDMaps;
\import \parent.DirectSum[X := X, F := F, G := H, left := first, right := third] \as AC;
\definition bundleAC: Bundles.Family[X := X, F := AC.Fiber].Bundle := AC.bundle sameThird;
\import AC.Of[same := sameThird] \as ACMaps;
\import \parent.DirectSum[X := X, F := G, G := I, left := second, right := fourth] \as BD;
\definition bundleBD: Bundles.Family[X := X, F := BD.Fiber].Bundle := BD.bundle sameOuter;
\import BD.Of[same := sameOuter] \as BDMaps;
\import \parent.DirectSum[X := X, F := AB.Fiber, G := CD.Fiber, left := bundleAB, right := bundleCD] \as Source;
\import \parent.DirectSum[X := X, F := AC.Fiber, G := BD.Fiber, left := bundleAC, right := bundleBD] \as Target;
\definition sourceBundle: Bundles.Family[X := X, F := Source.Fiber].Bundle := Source.bundle sameThird;
\definition targetBundle: Bundles.Family[X := X, F := Target.Fiber].Bundle := Target.bundle sameSecond;
\import Source.Of[same := sameThird] \as SourceMaps;
\import Target.Of[same := sameSecond] \as TargetMaps;
\import Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := AB.Fiber, source := sourceBundle, target := bundleAB, f := (\fun (x: X) => x)].Composition[
  Z := X, H := F, range := first, g := (\fun (x: X) => x)] \as SourceF;
\definition projectSourceF: Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := F, source := sourceBundle, target := first, f := (\fun (x: X) => x)].Map :=
  SourceF.compose SourceMaps.firstMap ABMaps.firstMap;
\import Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := AB.Fiber, source := sourceBundle, target := bundleAB, f := (\fun (x: X) => x)].Composition[
  Z := X, H := G, range := second, g := (\fun (x: X) => x)] \as SourceG;
\definition projectSourceG: Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := G, source := sourceBundle, target := second, f := (\fun (x: X) => x)].Map :=
  SourceG.compose SourceMaps.firstMap ABMaps.secondMap;
\import Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := CD.Fiber, source := sourceBundle, target := bundleCD, f := (\fun (x: X) => x)].Composition[
  Z := X, H := H, range := third, g := (\fun (x: X) => x)] \as SourceH;
\definition projectSourceH: Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := H, source := sourceBundle, target := third, f := (\fun (x: X) => x)].Map :=
  SourceH.compose SourceMaps.secondMap CDMaps.firstMap;
\import Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := CD.Fiber, source := sourceBundle, target := bundleCD, f := (\fun (x: X) => x)].Composition[
  Z := X, H := I, range := fourth, g := (\fun (x: X) => x)] \as SourceI;
\definition projectSourceI: Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := I, source := sourceBundle, target := fourth, f := (\fun (x: X) => x)].Map :=
  SourceI.compose SourceMaps.secondMap CDMaps.secondMap;
\import Bundles.Morphisms[X := X, Y := X, F := Target.Fiber, G := AC.Fiber, source := targetBundle, target := bundleAC, f := (\fun (x: X) => x)].Composition[
  Z := X, H := F, range := first, g := (\fun (x: X) => x)] \as TargetF;
\definition projectTargetF: Bundles.Morphisms[X := X, Y := X, F := Target.Fiber, G := F, source := targetBundle, target := first, f := (\fun (x: X) => x)].Map :=
  TargetF.compose TargetMaps.firstMap ACMaps.firstMap;
\import Bundles.Morphisms[X := X, Y := X, F := Target.Fiber, G := BD.Fiber, source := targetBundle, target := bundleBD, f := (\fun (x: X) => x)].Composition[
  Z := X, H := G, range := second, g := (\fun (x: X) => x)] \as TargetG;
\definition projectTargetG: Bundles.Morphisms[X := X, Y := X, F := Target.Fiber, G := G, source := targetBundle, target := second, f := (\fun (x: X) => x)].Map :=
  TargetG.compose TargetMaps.secondMap BDMaps.firstMap;
\import Bundles.Morphisms[X := X, Y := X, F := Target.Fiber, G := AC.Fiber, source := targetBundle, target := bundleAC, f := (\fun (x: X) => x)].Composition[
  Z := X, H := H, range := third, g := (\fun (x: X) => x)] \as TargetH;
\definition projectTargetH: Bundles.Morphisms[X := X, Y := X, F := Target.Fiber, G := H, source := targetBundle, target := third, f := (\fun (x: X) => x)].Map :=
  TargetH.compose TargetMaps.firstMap ACMaps.secondMap;
\import Bundles.Morphisms[X := X, Y := X, F := Target.Fiber, G := BD.Fiber, source := targetBundle, target := bundleBD, f := (\fun (x: X) => x)].Composition[
  Z := X, H := I, range := fourth, g := (\fun (x: X) => x)] \as TargetI;
\definition projectTargetI: Bundles.Morphisms[X := X, Y := X, F := Target.Fiber, G := I, source := targetBundle, target := fourth, f := (\fun (x: X) => x)].Map :=
  TargetI.compose TargetMaps.secondMap BDMaps.secondMap;
\import ACMaps.From[Y := X, H := Source.Fiber, source := sourceBundle, f := (\fun (x: X) => x)] \as IntoSourceAC;
\definition pairSourceAC: Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := AC.Fiber, source := sourceBundle, target := bundleAC, f := (\fun (x: X) => x)].Map :=
  IntoSourceAC.pair projectSourceF projectSourceH;
\import BDMaps.From[Y := X, H := Source.Fiber, source := sourceBundle, f := (\fun (x: X) => x)] \as IntoSourceBD;
\definition pairSourceBD: Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := BD.Fiber, source := sourceBundle, target := bundleBD, f := (\fun (x: X) => x)].Map :=
  IntoSourceBD.pair projectSourceG projectSourceI;
\import TargetMaps.From[Y := X, H := Source.Fiber, source := sourceBundle, f := (\fun (x: X) => x)] \as IntoTarget;
\import ABMaps.From[Y := X, H := Target.Fiber, source := targetBundle, f := (\fun (x: X) => x)] \as IntoTargetAB;
\definition pairTargetAB: Bundles.Morphisms[X := X, Y := X, F := Target.Fiber, G := AB.Fiber, source := targetBundle, target := bundleAB, f := (\fun (x: X) => x)].Map :=
  IntoTargetAB.pair projectTargetF projectTargetG;
\import CDMaps.From[Y := X, H := Target.Fiber, source := targetBundle, f := (\fun (x: X) => x)] \as IntoTargetCD;
\definition pairTargetCD: Bundles.Morphisms[X := X, Y := X, F := Target.Fiber, G := CD.Fiber, source := targetBundle, target := bundleCD, f := (\fun (x: X) => x)].Map :=
  IntoTargetCD.pair projectTargetH projectTargetI;
\import SourceMaps.From[Y := X, H := Target.Fiber, source := targetBundle, f := (\fun (x: X) => x)] \as IntoSource;
\definition forward: Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := Target.Fiber, source := sourceBundle, target := targetBundle, f := (\fun (x: X) => x)].Map := IntoTarget.pair pairSourceAC pairSourceBD;
\definition backward: Bundles.Morphisms[X := X, Y := X, F := Target.Fiber, G := Source.Fiber, source := targetBundle, target := sourceBundle, f := (\fun (x: X) => x)].Map := IntoSource.pair pairTargetAB pairTargetCD;
\import Bundles.Isomorphisms[X := X, F := Source.Fiber, G := Target.Fiber, source := sourceBundle, target := targetBundle] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := \fun (x: X)(v: Source.Fiber x) => Pair.Prop[A := AB.Fiber x, B := CD.Fiber x].ext _ v
    (Pair.Prop[A := F x, B := G x].eta (Pair.first (AB.Fiber x) (CD.Fiber x) v)) (Pair.Prop[A := H x, B := I x].eta (Pair.second (AB.Fiber x) (CD.Fiber x) v)),
  rightInverse := \fun (x: X)(v: Target.Fiber x) => Pair.Prop[A := AC.Fiber x, B := BD.Fiber x].ext _ v
    (Pair.Prop[A := F x, B := H x].eta (Pair.first (AC.Fiber x) (BD.Fiber x) v)) (Pair.Prop[A := G x, B := I x].eta (Pair.second (AC.Fiber x) (BD.Fiber x) v))
};
\definition SourceFiber[x: X]: \Set := Source.Fiber x;
\definition TargetFiber[x: X]: \Set := Target.Fiber x;
\definition formula: \forall (x: X)(v: F x)(w: G x)(u: H x)(z: I x) ->
  (forward.fiber x).apply (Pair.pair (AB.Fiber x) (CD.Fiber x) (Pair.pair (F x) (G x) v w) (Pair.pair (H x) (I x) u z)) =
    Pair.pair (AC.Fiber x) (BD.Fiber x) (Pair.pair (F x) (H x) v u) (Pair.pair (G x) (I x) w z) :=
  \fun (x: X)(v: F x)(w: G x)(u: H x)(z: I x) => \refl(Pair.pair (AC.Fiber x) (BD.Fiber x) (Pair.pair (F x) (H x) v u) (Pair.pair (G x) (I x) w z));
