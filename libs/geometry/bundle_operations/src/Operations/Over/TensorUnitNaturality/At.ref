\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TensorEquality[V := K, W := F x, U := G x, left := Spaces.scalarSpace, right := source.space x, target := target.space x] \as Equality;
\definition leftNormal: \forall (s: K)(v: F x) -> (firstPath.fiber x).apply (Domain.pure x s v) = (target.space x).smul s ((a.fiber x).apply v) :=
  \fun (s: K)(v: F x) => trans!{{G x}} _ _ _
    (congr!{{Middle.Fiber x} {G x}} (Target.isomorphism.forward.fiber x).apply _ _ (Mapping.onPure Identity.map a x s v))
    (Target.onPure x s ((a.fiber x).apply v));
\definition rightNormal: \forall (s: K)(v: F x) -> (secondPath.fiber x).apply (Domain.pure x s v) = (target.space x).smul s ((a.fiber x).apply v) :=
  \fun (s: K)(v: F x) => trans!{{G x}} _ _ _ (congr!{{F x} {G x}} (a.fiber x).apply _ _ (Source.onPure x s v)) ((a.fiber x).preservesScale s v);
\definition equality: \forall (t: Domain.Fiber x) -> (firstPath.fiber x).apply t = (secondPath.fiber x).apply t := Equality.pointwise (firstPath.fiber x) (secondPath.fiber x) (\fun (s: K)(v: F x) => trans!{{G x}} _ _ _ (leftNormal s v) (sym!{{G x}} _ _ (rightNormal s v)));
