\import Spaces.Tensor[V := V, W := W, left := left, right := right] \as Tensor;
\import Spaces.Linear[V := Tensor.Carrier, W := U, source := Tensor.space, target := target] \as Maps;
\definition value[h: Maps.Map][v: V][w: W]: U := h.apply (Tensor.tensor v w);
\definition laws[h: Maps.Map]: Tensor.BilinearLaws[U, target, value h] := Tensor.BilinearLaws[U, target, value h] {
  addLeft := \fun (v, z: V)(w: W) => trans!{U} _ _ _ (congr!{{Tensor.Carrier} U} h.apply _ _ (Tensor.bilinear.addLeft v z w)) (h.preservesAdd (Tensor.tensor v w) (Tensor.tensor z w)),
  addRight := \fun (v: V)(w, z: W) => trans!{U} _ _ _ (congr!{{Tensor.Carrier} U} h.apply _ _ (Tensor.bilinear.addRight v w z)) (h.preservesAdd (Tensor.tensor v w) (Tensor.tensor v z)),
  scaleLeft := \fun (a: K)(v: V)(w: W) => trans!{U} _ _ _ (congr!{{Tensor.Carrier} U} h.apply _ _ (Tensor.bilinear.scaleLeft a v w)) (h.preservesScale a (Tensor.tensor v w)),
  scaleRight := \fun (a: K)(v: V)(w: W) => trans!{U} _ _ _ (congr!{{Tensor.Carrier} U} h.apply _ _ (Tensor.bilinear.scaleRight a v w)) (h.preservesScale a (Tensor.tensor v w))
};
