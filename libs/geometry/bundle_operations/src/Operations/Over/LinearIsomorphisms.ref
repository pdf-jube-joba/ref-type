\import Spaces.Isomorphism[V := V, W := W, source := source, target := target] \as Isomorphisms;
\definition inverse[iso: Isomorphisms.Isomorphism]: Spaces.Isomorphism[V := W, W := V, source := target, target := source].Isomorphism :=
  Spaces.Isomorphism[V := W, W := V, source := target, target := source].Isomorphism {
    forward := iso.backward, backward := iso.forward, leftInverse := (Isomorphisms.laws iso).rightInverse, rightInverse := (Isomorphisms.laws iso).leftInverse
  };
\module After(U: \Set, space: Spaces.VectorSpace U);
