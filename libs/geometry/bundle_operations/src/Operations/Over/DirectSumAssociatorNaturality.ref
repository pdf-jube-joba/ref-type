\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumAssociator[X := X, F := A, G := B, H := C, left := first, middle := second, right := third, sameMiddle := sameSecond, sameRight := sameThird] \as Source;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSumAssociator[X := X, F := D, G := E, H := F, left := newFirst, middle := newSecond, right := newThird, sameMiddle := newSameSecond, sameRight := newSameThird] \as Target;
\definition lastBase: second.baseSpace = third.baseSpace := trans!{{topology.Topology[Carrier := X].Topology}} _ _ _ (sym!{{topology.Topology[Carrier := X].Topology}} _ _ sameSecond) sameThird;
\definition newLastBase: newSecond.baseSpace = newThird.baseSpace := trans!{{topology.Topology[Carrier := X].Topology}} _ _ _ (sym!{{topology.Topology[Carrier := X].Topology}} _ _ newSameSecond) newSameThird;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := A, G := B, left := first, right := second] \as AB;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := B, G := C, left := second, right := third] \as BC;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := D, G := E, left := newFirst, right := newSecond] \as DE;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := E, G := F, left := newSecond, right := newThird] \as EF;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := AB.Fiber, G := C, left := AB.bundle sameSecond, right := third] \as SourceLeft;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := A, G := BC.Fiber, left := first, right := BC.bundle lastBase] \as SourceRight;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := DE.Fiber, G := F, left := DE.bundle newSameSecond, right := newThird] \as TargetLeft;
\import \root.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].DirectSum[X := X, F := D, G := EF.Fiber, left := newFirst, right := EF.bundle newLastBase] \as TargetRight;
\import AB.Of[same := sameSecond].Mapping[Y := X, A := D, B := E, leftTarget := newFirst, rightTarget := newSecond, f := \fun (x: X) => x, targetSame := newSameSecond] \as FirstMap;
\import BC.Of[same := lastBase].Mapping[Y := X, A := E, B := F, leftTarget := newSecond, rightTarget := newThird, f := \fun (x: X) => x, targetSame := newLastBase] \as LastMap;
\import SourceLeft.Of[same := sameThird].Mapping[Y := X, A := DE.Fiber, B := F, leftTarget := DE.bundle newSameSecond, rightTarget := newThird, f := \fun (x: X) => x, targetSame := newSameThird] \as LeftMap;
\import SourceRight.Of[same := sameSecond].Mapping[Y := X, A := D, B := EF.Fiber, leftTarget := newFirst, rightTarget := EF.bundle newLastBase, f := \fun (x: X) => x, targetSame := newSameSecond] \as RightMap;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Target.SourceFiber, source := Source.sourceBundle, target := Target.sourceBundle, f := \fun (x: X) => x].Composition[Z := X, H := Target.TargetFiber, range := Target.targetBundle, g := \fun (x: X) => x] \as FirstPath;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Source.TargetFiber, source := Source.sourceBundle, target := Source.targetBundle, f := \fun (x: X) => x].Composition[Z := X, H := Target.TargetFiber, range := Target.targetBundle, g := \fun (x: X) => x] \as SecondPath;
\definition firstPath: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Target.TargetFiber, source := Source.sourceBundle, target := Target.targetBundle, f := \fun (x: X) => x].Map := FirstPath.compose (LeftMap.map (FirstMap.map a b) c) Target.isomorphism.forward;
\definition secondPath: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Target.TargetFiber, source := Source.sourceBundle, target := Target.targetBundle, f := \fun (x: X) => x].Map := SecondPath.compose Source.isomorphism.forward (RightMap.map a (LastMap.map b c));
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Target.TargetFiber, source := Source.sourceBundle, target := Target.targetBundle, f := \fun (x: X) => x] \as Result;
\definition naturality: firstPath = secondPath := Result.ext firstPath secondPath (\fun (x: X)(v: Source.SourceFiber x) => \refl((firstPath.fiber x).apply v));
