\definition Tuple: \Set := Fin.Fin k -> Fin.Fin n;
\import std.Set[].FiniteSubset[A := Tuple] \as Sets;
\definition Increasing: \Pow Tuple := { indices: Tuple \where Fin.Ordering[].Increasing k n indices };
\definition set: Sets.FiniteSubset := Sets.filter (Fin.Functions[n := n].value k) Increasing;
\import Sets.Enumeration[] \as Enumerations;
\definition Enumeration: \Set := Enumerations.DistinctEnumeration[set];
\definition existsEnumeration: \exists Enumeration := Enumerations.existsDistinctEnumeration set;
