\import topology.Topology[Carrier := Z] \as Target;
\definition Local[source: Target.Topology][f: E -> Z]: \Prop := \forall (i: I) -> topology.Continuity[A := P i, B := Z].Continuous (parameterSpaces i) source (\fun (p: P i) => f (parameter i p));
\definition continuous: \forall (target: Target.Topology)(f: E -> Z) -> Local target f -> topology.Continuity[A := E, B := Z].Continuous topology target f :=
  \fun (target: _)(f: _)(regular: Local target f)(U: \Pow Z)(open: _)(i: I) => regular i U open;
