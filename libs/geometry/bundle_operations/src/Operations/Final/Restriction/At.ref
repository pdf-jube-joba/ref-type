\import \root.Operations[].Final[I := I, E := E, P := P, parameterSpaces := parameterSpaces, parameter := parameter].Restriction[U := U] \as Local;
\import topology.Topology[Carrier := P i] \as Source;
\import topology.Maps[A := P i, B := E] \as Sets;
\definition Domain: \Pow (P i) := Sets.Preimage (Ambient.application i) U;
\definition Point: \Set := \Cast[P i] Domain;
\import Source.Subspace[S := Domain] \as Subspace;
\import Subspace.Open[] \as Into;
\definition topology: topology.Topology[Carrier := Point].Topology := Subspace.topology (parameterSpaces i);
\definition parameter[p: Point]: Local.Point := \into[E](Ambient.application i p, U) \by { \bysub(P i, Domain, p) };
\import topology.Maps[A := Point, B := Local.Point] \as Restricted;
\import \root.Operations[].Subset[E := E, U := U].Pullback[A := P i, f := Ambient.application i] \as Pullback;
\definition preimageImage: \forall (W: \Pow Local.Point) -> Sets.Preimage (Ambient.application i) (Inclusion.image W) = Into.image (Restricted.Preimage parameter W) := Pullback.preimageImage;
\definition open: \forall (W: \Pow Local.Point) -> topology.Topology[Carrier := Point].IsOpenIn topology (Restricted.Preimage parameter W) -> Source.IsOpenIn (parameterSpaces i) Domain ->
  Source.IsOpenIn (parameterSpaces i) (Sets.Preimage (Ambient.application i) (Inclusion.image W)) := Pullback.open (parameterSpaces i);
