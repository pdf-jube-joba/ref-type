\import topology.Topology[Carrier := Z] \as Target;
\definition continuous: \forall (target: Target.Topology)(f: Point -> Z) -> Total.IsOpenIn Ambient.topology U ->
  (\forall (i: I) -> topology.Continuity[A := \parent.At[i := i].Point, B := Z].Continuous (\parent.At[i := i].topology) target (\fun (p: \parent.At[i := i].Point) => f (\parent.At[i := i].parameter p))) ->
  topology.Continuity[A := Point, B := Z].Continuous topology target f :=
  \fun (target: _)(f: _)(openU: _)(regular: _)(V: \Pow Z)(openV: _) => open (topology.Maps[A := Point, B := Z].Preimage f V)
    (\fun (i: I) => regular i V openV) openU;
