\import \root.Operations[].Final[I := I, E := E, P := P, parameterSpaces := parameterSpaces, parameter := parameter] \as Ambient;
\import Total.Subspace[S := U] \as Subspace;
\import Subspace.Open[] \as Inclusion;
\definition Point: \Set := \Cast[E] U;
\import topology.Topology[Carrier := Point] \as Sub;
\definition topology: Sub.Topology := Subspace.topology Ambient.topology;
\import \root.Operations[].Subset[E := E, U := U] \as Subset;
\definition memberTransport: \forall (W: \Pow Point)(p, q: Point) -> Subset.forget p = Subset.forget q -> Sub.Member W p -> Sub.Member W q := Subset.memberTransport;
\definition traceImage: \forall (W: \Pow Point) -> Subspace.Trace (Inclusion.image W) = W := Subset.traceImage;
\module At(i: I);
\definition open: \forall (W: \Pow Point) ->
  (\forall (i: I) -> topology.Topology[Carrier := At[i := i].Point].IsOpenIn (At[i := i].topology)
    (topology.Maps[A := At[i := i].Point, B := Point].Preimage (At[i := i].parameter) W)) -> Total.IsOpenIn Ambient.topology U -> Sub.IsOpenIn topology W :=
  \fun (W: \Pow Point)(regular: _)(openU: _) => \idelim Subspace.Trace (Inclusion.image W) = W \with V: \Pow Point => Sub.IsOpenIn topology V \by {
    base: Subspace.traceOpen Ambient.topology (Inclusion.image W) (\fun (i: I) => At[i := i].open W (regular i) (openU i)), equality: traceImage W
  };
\module Universal(Z: \Set);
