\import topology.Topology[Carrier := E] \as Total;
\definition application[i: I][p: P i]: E := parameter i p;
\definition Raw: Total.TopologyData := Total.TopologyData { openSets := { U: \Pow E \where \forall (i: I) ->
  topology.Topology[Carrier := P i].IsOpenIn (parameterSpaces i) (topology.Maps[A := P i, B := E].Preimage (parameter i) U) } };
\module At(i: I);
\definition laws: Total.TopologyLaws[Raw] := Total.TopologyLaws[Raw] {
  emptyOpen := \fun (i: I) => (At[i := i].laws).emptyOpen,
  wholeOpen := \fun (i: I) => (At[i := i].laws).wholeOpen,
  unionOpen := \fun (family: \Pow (\Pow E))(open: \forall (U: \Pow E) -> Total.FamilyMember family U -> Total.IsOpen Raw U)(i: I) =>
    (At[i := i].laws).unionOpen family (\fun (U: \Pow E)(member: _) => open U member i),
  intersectionOpen := \fun (U, V: \Pow E)(openU: Total.IsOpen Raw U)(openV: Total.IsOpen Raw V)(i: I) => (At[i := i].laws).intersectionOpen U V (openU i) (openV i),
};
\definition topology: Total.Topology := \into[Total.TopologyData](Raw, Total.Topology) \by { laws };
\definition parameterContinuous: \forall (i: I) -> topology.Continuity[A := P i, B := E].Continuous (parameterSpaces i) topology (parameter i) :=
  \fun (i: I)(U: \Pow E)(open: Total.IsOpenIn topology U) => open i;
\module Universal(Z: \Set);
\module Restriction(U: \Pow E);
