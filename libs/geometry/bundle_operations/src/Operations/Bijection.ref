\import topological_constructions.Induced[A := B, B := A] \as Induced;
\definition topology: topology.Topology[Carrier := B].Topology := Induced.topology source backward;
\structure Laws: \Prop := {
  leftInverse: \forall (a: A) -> backward (forward a) = a,
  rightInverse: \forall (b: B) -> forward (backward b) = b
};
\definition composite[a: A]: A := backward (forward a);
\definition compositeContinuous: \forall (laws: Laws) -> topology.Continuity[A := A, B := A].Continuous source source composite :=
  \fun (laws: Laws) => \idelim (\fun (a: A) => a) = composite \with f: (A -> A) => topology.Continuity[A := A, B := A].Continuous source source f \by {
    base: topology.Maps[A := A, B := A].Identity[].continuous source,
    equality: \axiom:funext((\fun (a: A) => a), composite, \fun (a: A) => sym!{A} _ _ (laws.leftInverse a))
  };
\definition backwardContinuous: topology.Continuity[A := B, B := A].Continuous topology source backward := Induced.continuous source backward;
\definition forwardContinuous: \forall (laws: Laws) -> topology.Continuity[A := A, B := B].Continuous source topology forward :=
  \fun (laws: Laws) => Induced.Universal[Z := A].continuous source source backward forward (compositeContinuous laws);
\definition homeomorphism[laws: Laws]: topology.Homeomorphism[A := A, B := B].Homeomorphism[source, topology] := topology.Homeomorphism[A := A, B := B].Homeomorphism[source, topology] {
  forward := forward, backward := backward, leftInverse := laws.leftInverse, rightInverse := laws.rightInverse, forwardContinuous := forwardContinuous laws, backwardContinuous := backwardContinuous
};
