\import real.Analysis[] \as R;
\import complex.Complex[] \as C;
\import C.Def[] \as CD;
\import C.Prop[] \as CP;
\import C.Algebra[] \as CA;
\import R.Algebra[] \as RA;
\import linear_algebra.Hermitian[].Complex[] \as HC;
\import linear_algebra.Hermitian[].Real[] \as HR;
\import \root.Operations[].Over[K := C.Complex, field := CA.field, conjugation := HC.scalar, scalar := Bundles.Complex[].scalar] \as Complex;
\import \root.Operations[].Over[K := R.Real, field := RA.field, conjugation := HR.scalar, scalar := Bundles.Real[].scalar] \as Real;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := CA.field, conjugation := HC.scalar, scalar := Bundles.Complex[].scalar] \as ComplexBundles;
\import vector_bundles.Bundles[].Over[K := R.Real, field := RA.field, conjugation := HR.scalar, scalar := Bundles.Real[].scalar] \as RealBundles;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := Fields.fieldAsCommutativeRing C.Complex CA.field] \as ComplexSpaces;
\import linear_algebra.Commutative[K := R.Real, scalarRing := Fields.fieldAsCommutativeRing R.Real RA.field] \as RealSpaces;
\definition embedScale: \forall (a: R.Real)(z: C.Complex) -> CD.mul (CD.ofReal a) z = CD.scale a z :=
  \fun (a: R.Real)(z: C.Complex) => trans!{C.Complex} _ _ _
    (congr!{{C.Complex} {C.Complex}} (\fun (w: C.Complex) => CD.mul w z) _ _ (sym!{{C.Complex}} _ _ (CP.makeCong _ _ _ _ (RA.mulOneRight a) (RealSpaces.mulZeroRight a))))
    (trans!{C.Complex} _ _ _ (CP.scaleMulLeft a CD.one z) (congr!{{C.Complex} {C.Complex}} (CD.scale a) _ _ (CP.mulOneLeft z)));
\module RealCoordinates(n: N.Nat^);
\module Realification(X: \Set, F: X -> \Set, source: ComplexBundles.Family[X := X, F := F].Bundle);
\module ComplexTensor(V: \Set, source: RealSpaces.VectorSpace V);
\module Complexification(X: \Set, F: X -> \Set, source: RealBundles.Family[X := X, F := F].Bundle);
