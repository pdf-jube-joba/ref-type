\import Complex.RealScalars[V := F x, space := source.space x].Maps[W := Complex.Vector c.dimension, target := Complex.coordinates c.dimension] \as Restrict;
\import Complex.RealScalars[V := Complex.Vector c.dimension, space := Complex.coordinates c.dimension] \as CoordinateSpace;
\import Real.LinearIsomorphisms[V := F x, W := Complex.Vector c.dimension, source := space x, target := CoordinateSpace.realSpace].After[U := Real.Vector Coordinates.dimension, space := Real.coordinates Coordinates.dimension] \as Compose;
\definition frame: RealSpaces.Isomorphism[V := F x, W := Real.Vector Coordinates.dimension, source := space x, target := Real.coordinates Coordinates.dimension].Isomorphism := Compose.compose (Restrict.isomorphism (c.frame x)) Coordinates.frame;
