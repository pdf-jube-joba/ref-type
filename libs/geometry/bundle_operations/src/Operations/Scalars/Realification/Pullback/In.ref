\import \root.Operations[].Scalars[].Realification[X := X, F := F, source := source].In[c := c] \as Original;
\import OperationPullback.In[c := Original.trivialization] \as First;
\import SourcePullback.In[c := c] \as SourceChart;
\import Other.In[c := SourceChart.trivialization regular] \as Second;
\definition data: Charts.ChartData := Charts.ChartData {
  domain := First.domain, dimension := First.chart.dimension,
  sourceFrame := First.chart.frame, targetFrame := Second.chart.frame
};
\definition chart: Charts.Chart := \into[Charts.ChartData](data, Charts.Chart) \by {
  Charts.In[c := data].Laws {
    source := First.laws regular,
    target := \bysub(RealBundles.Family[X := Y, F := \fun (y: Y) => F (f y)].With[data := secondBundle].ChartData, RealBundles.Family[X := Y, F := \fun (y: Y) => F (f y)].With[data := secondBundle].Chart, Second.trivialization),
    alignment := \fun (y: \Cast[Y] First.domain)(v: F (f y)) => \refl((First.chart.frame y).forward.apply v)
  }
};
