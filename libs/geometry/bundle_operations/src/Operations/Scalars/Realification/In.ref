\import SourceCharts.In[c := c] \as Original;
\import \root.Operations[].Scalars[].RealCoordinates[n := c.dimension] \as Coordinates;
\module At(x: \Cast[X] c.domain);
\definition chart: Charts.ChartData := Charts.ChartData { domain := c.domain, dimension := Coordinates.dimension, frame := \fun (x: \Cast[X] c.domain) => At[x := x].frame };
\import Charts.In[c := chart] \as Local;
\definition original[p: Local.TotalPoint]: Original.TotalPoint := \into[Source.Point](backward p, { p: Source.Point \where Base.Member c.domain p.base }) \by { \bysub(Family.Point, { p: Family.Point \where Base.Member c.domain p.base }, p) };
\import topology.Continuity[A := Family.Point, B := Source.Point].Restriction[S := { p: Family.Point \where Base.Member c.domain p.base }] \as RestrictBackward;
\import topology.Continuity[A := Local.TotalPoint, B := Source.Point].Corestriction[S := { p: Source.Point \where Base.Member c.domain p.base }] \as IntoSource;
\definition originalContinuous: topology.Continuity[A := Local.TotalPoint, B := Original.TotalPoint].Continuous Local.localTopology Original.localTopology original :=
  IntoSource.corestrictContinuous Local.localTopology source.totalSpace original (RestrictBackward.restrictContinuous topology source.totalSpace backward backwardContinuous);
\import topological_constructions.Product[A := Local.BasePoint, B := Real.Vector Coordinates.dimension] \as RealProduct;
\import topological_constructions.Product[A := Original.BasePoint, B := Complex.Vector c.dimension] \as ComplexProduct;
\definition convert[p: Original.ProductPoint]: Local.ProductPoint := Pair.pair Local.BasePoint (Real.Vector Coordinates.dimension) (Pair.first Original.BasePoint (Complex.Vector c.dimension) p) (Coordinates.frame.forward.apply (Pair.second Original.BasePoint (Complex.Vector c.dimension) p));
\definition unconvert[p: Local.ProductPoint]: Original.ProductPoint := Pair.pair Original.BasePoint (Complex.Vector c.dimension) (Pair.first Local.BasePoint (Real.Vector Coordinates.dimension) p) (Coordinates.frame.backward.apply (Pair.second Local.BasePoint (Real.Vector Coordinates.dimension) p));
\definition convertContinuous: topology.Continuity[A := Original.ProductPoint, B := Local.ProductPoint].Continuous Original.productTopology Local.productTopology convert :=
  RealProduct.Universal[X := Original.ProductPoint].pairContinuous Original.productTopology (Base.Subspace[S := c.domain].topology source.baseSpace) (Real.coordinateTopology Coordinates.dimension)
    (Pair.first Original.BasePoint (Complex.Vector c.dimension)) (\fun (p: Original.ProductPoint) => Coordinates.frame.forward.apply (Pair.second Original.BasePoint (Complex.Vector c.dimension) p))
    (ComplexProduct.Maps[].firstContinuous (Base.Subspace[S := c.domain].topology source.baseSpace) (Complex.coordinateTopology c.dimension))
    (topology.Composition[A := Original.ProductPoint, B := Complex.Vector c.dimension, C := Real.Vector Coordinates.dimension].composeContinuous Original.productTopology (Complex.coordinateTopology c.dimension) (Real.coordinateTopology Coordinates.dimension)
      (Pair.second Original.BasePoint (Complex.Vector c.dimension)) Coordinates.frame.forward.apply (ComplexProduct.Maps[].secondContinuous (Base.Subspace[S := c.domain].topology source.baseSpace) (Complex.coordinateTopology c.dimension)) Coordinates.Topology[].forwardContinuous);
\definition unconvertContinuous: topology.Continuity[A := Local.ProductPoint, B := Original.ProductPoint].Continuous Local.productTopology Original.productTopology unconvert :=
  ComplexProduct.Universal[X := Local.ProductPoint].pairContinuous Local.productTopology (Base.Subspace[S := c.domain].topology source.baseSpace) (Complex.coordinateTopology c.dimension)
    (Pair.first Local.BasePoint (Real.Vector Coordinates.dimension)) (\fun (p: Local.ProductPoint) => Coordinates.frame.backward.apply (Pair.second Local.BasePoint (Real.Vector Coordinates.dimension) p))
    (RealProduct.Maps[].firstContinuous (Base.Subspace[S := c.domain].topology source.baseSpace) (Real.coordinateTopology Coordinates.dimension))
    (topology.Composition[A := Local.ProductPoint, B := Real.Vector Coordinates.dimension, C := Complex.Vector c.dimension].composeContinuous Local.productTopology (Real.coordinateTopology Coordinates.dimension) (Complex.coordinateTopology c.dimension)
      (Pair.second Local.BasePoint (Real.Vector Coordinates.dimension)) Coordinates.frame.backward.apply (RealProduct.Maps[].secondContinuous (Base.Subspace[S := c.domain].topology source.baseSpace) (Real.coordinateTopology Coordinates.dimension)) Coordinates.Topology[].backwardContinuous);
\definition localForwardContinuous: topology.Continuity[A := Local.TotalPoint, B := Local.ProductPoint].Continuous Local.localTopology Local.productTopology Local.forward :=
  topology.Composition[A := Local.TotalPoint, B := Original.ProductPoint, C := Local.ProductPoint].composeContinuous Local.localTopology Original.productTopology Local.productTopology
    (\fun (p: Local.TotalPoint) => Original.forward (original p)) convert
    (topology.Composition[A := Local.TotalPoint, B := Original.TotalPoint, C := Original.ProductPoint].composeContinuous Local.localTopology Original.localTopology Original.productTopology original Original.forward originalContinuous (\bysub(SourceCharts.ChartData, SourceCharts.Chart, c)).forwardContinuous) convertContinuous;
\import topology.Topology[Carrier := Source.Point].Subspace[S := { p: Source.Point \where Base.Member c.domain p.base }] \as SourceSubspace;
\definition originalBackward[p: Local.ProductPoint]: Source.Point := Original.backward (unconvert p);
\definition originalBackwardContinuous: topology.Continuity[A := Local.ProductPoint, B := Source.Point].Continuous Local.productTopology source.totalSpace originalBackward :=
  topology.Composition[A := Local.ProductPoint, B := Original.ProductPoint, C := Source.Point].composeContinuous Local.productTopology Original.productTopology source.totalSpace unconvert (\fun (p: Original.ProductPoint) => Original.backward p) unconvertContinuous
    (topology.Composition[A := Original.ProductPoint, B := Original.TotalPoint, C := Source.Point].composeContinuous Original.productTopology Original.localTopology source.totalSpace Original.backward (\fun (p: Original.TotalPoint) => p)
      (\bysub(SourceCharts.ChartData, SourceCharts.Chart, c)).backwardContinuous (\fun (U: \Pow Source.Point)(open: _) => SourceSubspace.traceOpen source.totalSpace U open));
\import topology.Continuity[A := Local.ProductPoint, B := Family.Point].Corestriction[S := { p: Family.Point \where Base.Member c.domain p.base }] \as IntoLocal;
\definition localBackwardContinuous: topology.Continuity[A := Local.ProductPoint, B := Local.TotalPoint].Continuous Local.productTopology Local.localTopology Local.backward :=
  IntoLocal.corestrictContinuous Local.productTopology topology Local.backward
    (topology.Composition[A := Local.ProductPoint, B := Source.Point, C := Family.Point].composeContinuous Local.productTopology source.totalSpace topology originalBackward forward originalBackwardContinuous forwardContinuous);
\definition trivialization: Charts.Chart := \into[Charts.ChartData](chart, Charts.Chart) \by {
  Local.Laws {
    baseOpen := (\bysub(SourceCharts.ChartData, SourceCharts.Chart, c)).baseOpen,
    totalOpen := backwardContinuous ({ p: Source.Point \where Base.Member c.domain p.base }) (\bysub(SourceCharts.ChartData, SourceCharts.Chart, c)).totalOpen,
    forwardContinuous := localForwardContinuous, backwardContinuous := localBackwardContinuous
  }
};
