\import ComplexBundles.Morphisms[X := X, Y := Y, F := F, G := G, source := source, target := target, f := f] \as Original;
\import \root.Operations[].Scalars[].Realification[X := Y, F := G, source := target] \as Other;
\import ComplexBundles.Family[X := Y, F := G] \as OriginalTarget;
\import RealBundles.Family[X := Y, F := G] \as Target;
\import RealBundles.Morphisms[X := X, Y := Y, F := F, G := G, source := bundle, target := Other.bundle, f := f] \as Result;
\definition data[a: Original.Map]: Result.Data := Result.Data {
  fiber := \fun (x: X) => Complex.RealScalars[V := F x, space := source.space x].Maps[W := G (f x), target := target.space (f x)].map (a.fiber x)
};
\definition map[a: Original.Map]: Result.Map := \into[Result.Data](data a, Result.Map) \by {
  topology.Composition[A := Family.Point, B := OriginalTarget.Point, C := Target.Point].composeContinuous topology target.totalSpace Other.topology
    (\fun (p: Family.Point) => Original.total a (backward p)) Other.forward
    (topology.Composition[A := Family.Point, B := Source.Point, C := OriginalTarget.Point].composeContinuous topology source.totalSpace target.totalSpace backward (Original.total a) backwardContinuous (Original.continuous a)) Other.forwardContinuous
};
\definition onFiber: \forall (a: Original.Map)(x: X)(v: F x) -> ((map a).fiber x).apply v = (a.fiber x).apply v := \fun (a: Original.Map)(x: X)(v: F x) => \refl((a.fiber x).apply v);
