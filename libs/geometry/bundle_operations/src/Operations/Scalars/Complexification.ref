\import RealBundles.Family[X := X, F := F] \as Source;
\import Source.With[data := source] \as SourceCharts;
\import Complex.ScalarLine[X := X, baseSpace := source.baseSpace] \as Constant;
\import \root.Operations[].Scalars[].Realification[X := X, F := \fun (x: X) => C.Complex, source := Constant.bundle] \as RealConstant;
\import Real.Tensor[X := X, F := F, G := \fun (x: X) => C.Complex, left := source, right := RealConstant.bundle] \as Tensor;
\definition Fiber[x: X]: \Set := \root.Operations[].Scalars[].ComplexTensor[V := F x, source := source.space x].Carrier;
\definition fiberSpace[x: X]: ComplexSpaces.VectorSpace (Fiber x) := \root.Operations[].Scalars[].ComplexTensor[V := F x, source := source.space x].space;
\definition pure[x: X][v: F x][z: C.Complex]: Fiber x := Tensor.pure x v z;
\import ComplexBundles.Family[X := X, F := Fiber] \as Family;
\import RealBundles.Family[X := X, F := Fiber] \as Underlying;
\definition forward[p: Underlying.Point]: Family.Point := Family.include p.base p.vector;
\definition backward[p: Family.Point]: Underlying.Point := Underlying.include p.base p.vector;
\definition Grid: \Set := Pair.Times^[N.Nat^, N.Nat^];
\definition Parameters[k: Grid]: \Set := Tensor.Parameter[n := Pair.first N.Nat^ N.Nat^ k, m := Pair.second N.Nat^ N.Nat^ k].Point;
\definition parameterSpace[k: Grid]: topology.Topology[Carrier := Parameters k].Topology := Tensor.Parameter[n := Pair.first N.Nat^ N.Nat^ k, m := Pair.second N.Nat^ N.Nat^ k].topology;
\definition parameter[k: Grid][p: Parameters k]: Family.Point := forward (Tensor.Parameter[n := Pair.first N.Nat^ N.Nat^ k, m := Pair.second N.Nat^ N.Nat^ k].value p);
\import \root.Operations[].Final[I := Grid, E := Family.Point, P := Parameters, parameterSpaces := parameterSpace, parameter := parameter] \as Final;
\definition topology: topology.Topology[Carrier := Family.Point].Topology := Final.topology;
\import topology.Topology[Carrier := X] \as Base;
\definition data: Family.Data := Family.Data { baseSpace := source.baseSpace, totalSpace := topology, space := fiberSpace };
\import Family.With[data := data] \as Charts;
\definition projectionContinuous: topology.Continuity[A := Family.Point, B := X].Continuous topology source.baseSpace Family.projection :=
  Final.Universal[Z := X].continuous source.baseSpace Family.projection (\fun (k: Grid) => Tensor.Parameter[n := Pair.first N.Nat^ N.Nat^ k, m := Pair.second N.Nat^ N.Nat^ k].Projection[].baseContinuous);
\module In(c: SourceCharts.Chart);
\definition bundle: Family.Bundle := \into[Family.Data](data, Family.Bundle) \by {
  \fun (x: X) => \block {
    \takefrom c: \Cast[SourceCharts.Chart] ({ c: SourceCharts.Chart \where Base.Member c.domain x }) \by Source.Of[bundle := source].locallyTrivial x \then
    \return Logic.existsIntro[Charts.Chart, { d: Charts.Chart \where Base.Member d.domain x }] (In[c := c].trivialization) (\bysub(SourceCharts.Chart, { c: SourceCharts.Chart \where Base.Member c.domain x }, c))
  }
};
\module UnderlyingTopology;
\module Maps(Y: \Set, G: Y -> \Set, target: RealBundles.Family[X := Y, F := G].Bundle, f: X -> Y);
\module Pullback(Y: \Set, baseSpace: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  regular: topology.Continuity[A := Y, B := X].Continuous baseSpace source.baseSpace f);
