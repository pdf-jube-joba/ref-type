\definition frame[x: \Cast[X] c.domain]: ComplexSpaces.Isomorphism[V := Fiber x, W := Complex.Vector c.dimension, source := fiberSpace x, target := Complex.coordinates c.dimension].Isomorphism :=
  \root.Operations[].Scalars[].ComplexTensor[V := F x, source := source.space x].Finite[n := c.dimension, frame := c.frame x].isomorphism;
\definition chart: Charts.ChartData := Charts.ChartData { domain := c.domain, dimension := c.dimension, frame := frame };
\import Charts.In[c := chart] \as Local;
\import Base.Subspace[S := c.domain] \as BaseSubspace;
\definition totalOpen: topology.Topology[Carrier := Family.Point].IsOpenIn topology ({ p: Family.Point \where Base.Member c.domain p.base }) :=
  projectionContinuous c.domain (\bysub(SourceCharts.ChartData, SourceCharts.Chart, c)).baseOpen;
\module Forward(r, s: N.Nat^);
\definition forwardContinuous: topology.Continuity[A := Local.TotalPoint, B := Local.ProductPoint].Continuous Local.localTopology Local.productTopology Local.forward :=
  Final.Restriction[U := { p: Family.Point \where Base.Member c.domain p.base }].Universal[Z := Local.ProductPoint].continuous Local.productTopology Local.forward totalOpen
    (\fun (grid: Grid) => Forward[r := Pair.first N.Nat^ N.Nat^ grid, s := Pair.second N.Nat^ N.Nat^ grid].regular);
\module Backward;
\import topology.Continuity[A := Local.ProductPoint, B := Family.Point].Corestriction[S := { p: Family.Point \where Base.Member c.domain p.base }] \as IntoLocal;
\definition trivialization: Charts.Chart := \into[Charts.ChartData](chart, Charts.Chart) \by {
  Local.Laws { baseOpen := (\bysub(SourceCharts.ChartData, SourceCharts.Chart, c)).baseOpen, totalOpen := totalOpen,
    forwardContinuous := forwardContinuous, backwardContinuous := IntoLocal.corestrictContinuous Local.productTopology topology Local.backward Backward[].continuous }
};
