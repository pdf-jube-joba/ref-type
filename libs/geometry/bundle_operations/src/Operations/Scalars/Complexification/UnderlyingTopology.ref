\import \root.Operations[].Final[I := Grid, E := Underlying.Point, P := Tensor.Parameters, parameterSpaces := Tensor.parameterSpace, parameter := Tensor.parameter] \as NativeFinal;
\definition forwardContinuous: topology.Continuity[A := Underlying.Point, B := Family.Point].Continuous Tensor.topology topology forward :=
  NativeFinal.Universal[Z := Family.Point].continuous topology forward (\fun (k: Grid) => Final.parameterContinuous k);
\definition backwardContinuous: topology.Continuity[A := Family.Point, B := Underlying.Point].Continuous topology Tensor.topology backward :=
  Final.Universal[Z := Underlying.Point].continuous Tensor.topology backward (\fun (k: Grid) => NativeFinal.parameterContinuous k);
\definition homeomorphism: topology.Homeomorphism[A := Underlying.Point, B := Family.Point].Homeomorphism[Tensor.topology, topology] := topology.Homeomorphism[A := Underlying.Point, B := Family.Point].Homeomorphism[Tensor.topology, topology] {
  forward := forward, backward := backward, leftInverse := Underlying.eta, rightInverse := Family.eta,
  forwardContinuous := forwardContinuous, backwardContinuous := backwardContinuous
};
