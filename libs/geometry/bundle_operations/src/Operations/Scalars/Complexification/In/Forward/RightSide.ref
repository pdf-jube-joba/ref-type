\import RealBundles.Family[X := X, F := \fun (x: X) => C.Complex] \as RealFamily;
\import ComplexBundles.Family[X := X, F := \fun (x: X) => C.Complex] \as ComplexFamily;
\import topology.Continuity[A := SourceParameters.Point, B := RealFamily.Point].Restriction[S := Domain] \as Restriction;
\definition realValue[i: SourceParameters.Index][p: Point]: RealFamily.Point := SourceParameters.right p i;
\definition complexValue[i: SourceParameters.Index][p: Point]: ComplexFamily.Point := RealConstant.backward (realValue i p);
\definition continuous: \forall (i: SourceParameters.Index) -> topology.Continuity[A := Point, B := C.Complex].Continuous topology topological_algebra.Complex[].topology (\fun (p: Point) => p.right i) :=
  \fun (i: SourceParameters.Index) => topology.Composition[A := Point, B := ComplexFamily.Point, C := C.Complex].composeContinuous topology Constant.bundle.totalSpace topological_algebra.Complex[].topology (complexValue i) Constant.value
    (topology.Composition[A := Point, B := RealFamily.Point, C := ComplexFamily.Point].composeContinuous topology RealConstant.topology Constant.bundle.totalSpace (realValue i) RealConstant.backward
      (Restriction.restrictContinuous SourceParameters.topology RealConstant.topology (\fun (p: SourceParameters.Point) => SourceParameters.right p i) (SourceParameters.Projection[].rightContinuous i)) RealConstant.backwardContinuous) Constant.valueContinuous;
