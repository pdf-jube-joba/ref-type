\import RealBundles.Family[X := X, F := F] \as Original;
\import Original.With[data := source].In[c := c] \as Coordinates;
\import Real.Chart[X := X, F := F, bundle := source, chart := c] \as Chart;
\definition original[i: SourceParameters.Index][p: Point]: Coordinates.TotalPoint := \into[Original.Point](SourceParameters.left p i, { q: Original.Point \where Base.Member c.domain q.base }) \by {
  \bysub(SourceParameters.Point, Domain, p)
};
\import topology.Continuity[A := SourceParameters.Point, B := Original.Point].Restriction[S := Domain] \as Restriction;
\definition coordinates[i: SourceParameters.Index][p: Point]: Real.Vector c.dimension := Chart.Maps[Y := Point, source := topology].vector (original i) p;
\definition regular: \forall (i: SourceParameters.Index) -> topology.Continuity[A := Point, B := Real.Vector c.dimension].Continuous topology (Real.coordinateTopology c.dimension) (coordinates i) :=
  \fun (i: SourceParameters.Index) => Chart.Maps[Y := Point, source := topology].vectorContinuous (original i)
    (Restriction.restrictContinuous SourceParameters.topology source.totalSpace (\fun (p: SourceParameters.Point) => SourceParameters.left p i) (SourceParameters.Projection[].leftContinuous i));
\definition entry[i: SourceParameters.Index][j: Fin.Fin c.dimension][p: Point]: R.Real := coordinates i p j;
\import topological_algebra.Coordinates[K := R.Real, I := Fin.Fin c.dimension] \as Vectors;
\import topology.Composition[A := Point, B := Real.Vector c.dimension, C := R.Real] \as Evaluation;
\definition entryContinuous: \forall (i: SourceParameters.Index)(j: Fin.Fin c.dimension) -> topology.Continuity[A := Point, B := R.Real].Continuous topology metric_spaces.RealLine[].topology (entry i j) :=
  \fun (i: SourceParameters.Index)(j: Fin.Fin c.dimension) => Evaluation.composeContinuous topology (Real.coordinateTopology c.dimension) metric_spaces.RealLine[].topology (coordinates i) (\fun (v: Real.Vector c.dimension) => v j) (regular i) (Vectors.evaluationContinuous metric_spaces.RealLine[].topology j);
