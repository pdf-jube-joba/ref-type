\import topological_constructions.Product[A := Local.BasePoint, B := Complex.Vector c.dimension] \as Product;
\import Product.Maps[] \as Projections;
\definition center[p: Local.ProductPoint]: Local.BasePoint := Pair.first Local.BasePoint (Complex.Vector c.dimension) p;
\definition base[p: Local.ProductPoint]: X := center p;
\definition centerContinuous: topology.Continuity[A := Local.ProductPoint, B := Local.BasePoint].Continuous Local.productTopology (BaseSubspace.topology source.baseSpace) center :=
  Projections.firstContinuous (BaseSubspace.topology source.baseSpace) (Complex.coordinateTopology c.dimension);
\definition baseContinuous: topology.Continuity[A := Local.ProductPoint, B := X].Continuous Local.productTopology source.baseSpace base :=
  topology.Composition[A := Local.ProductPoint, B := Local.BasePoint, C := X].composeContinuous Local.productTopology (BaseSubspace.topology source.baseSpace) source.baseSpace center (\fun (x: Local.BasePoint) => x) centerContinuous
    (\fun (U: \Pow X)(open: _) => BaseSubspace.traceOpen source.baseSpace U open);
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import Real.Tensor[X := X, F := F, G := \fun (x: X) => C.Complex, left := source, right := RealConstant.bundle].Parameter[n := c.dimension, m := one] \as GeneratingParameters;
\import Real.Chart[X := X, F := F, bundle := source, chart := c] \as SourceChart;
\definition basis[i: Fin.Fin c.dimension][p: Local.ProductPoint]: F (base p) := (c.frame (center p)).backward.apply (RealSpaces.FiniteCoordinates[n := c.dimension].vectors i);
\definition basisContinuous: \forall (i: Fin.Fin c.dimension) -> topology.Continuity[A := Local.ProductPoint, B := Source.Point].Continuous Local.productTopology source.totalSpace (\fun (p: Local.ProductPoint) => Source.include (base p) (basis i p)) :=
  \fun (i: Fin.Fin c.dimension) => SourceChart.Maps[Y := Local.ProductPoint, source := Local.productTopology].pointContinuous center (\fun (p: Local.ProductPoint) => RealSpaces.FiniteCoordinates[n := c.dimension].vectors i) centerContinuous
    (topology.Maps[A := Local.ProductPoint, B := Real.Vector c.dimension].constantContinuous Local.productTopology (Real.coordinateTopology c.dimension) (RealSpaces.FiniteCoordinates[n := c.dimension].vectors i));
\definition coefficient[i: Fin.Fin c.dimension][p: Local.ProductPoint]: C.Complex := Pair.second Local.BasePoint (Complex.Vector c.dimension) p i;
\import topological_algebra.Coordinates[K := C.Complex, I := Fin.Fin c.dimension] \as CoordinateTopology;
\definition coefficientContinuous: \forall (i: Fin.Fin c.dimension) -> topology.Continuity[A := Local.ProductPoint, B := C.Complex].Continuous Local.productTopology topological_algebra.Complex[].topology (coefficient i) :=
  \fun (i: Fin.Fin c.dimension) => topology.Composition[A := Local.ProductPoint, B := Complex.Vector c.dimension, C := C.Complex].composeContinuous Local.productTopology (Complex.coordinateTopology c.dimension) topological_algebra.Complex[].topology
    (Pair.second Local.BasePoint (Complex.Vector c.dimension)) (\fun (v: Complex.Vector c.dimension) => v i) (Projections.secondContinuous (BaseSubspace.topology source.baseSpace) (Complex.coordinateTopology c.dimension)) (CoordinateTopology.evaluationContinuous topological_algebra.Complex[].topology i);
\import ComplexBundles.Family[X := X, F := \fun (x: X) => C.Complex] \as ComplexFamily;
\import RealBundles.Family[X := X, F := \fun (x: X) => C.Complex] \as RealFamily;
\definition complexValue[i: Fin.Fin c.dimension][p: Local.ProductPoint]: ComplexFamily.Point := ComplexFamily.include (base p) (coefficient i p);
\definition realValue[i: Fin.Fin c.dimension][p: Local.ProductPoint]: RealFamily.Point := RealConstant.forward (complexValue i p);
\definition realContinuous: \forall (i: Fin.Fin c.dimension) -> topology.Continuity[A := Local.ProductPoint, B := RealFamily.Point].Continuous Local.productTopology RealConstant.topology (realValue i) :=
  \fun (i: Fin.Fin c.dimension) => topology.Composition[A := Local.ProductPoint, B := ComplexFamily.Point, C := RealFamily.Point].composeContinuous Local.productTopology Constant.bundle.totalSpace RealConstant.topology
    (complexValue i) RealConstant.forward (Constant.Universal[Y := Local.ProductPoint].continuous Local.productTopology (complexValue i) baseContinuous (coefficientContinuous i)) RealConstant.forwardContinuous;
\definition lift[p: Local.ProductPoint]: GeneratingParameters.Point := GeneratingParameters.Point {
  base := base p,
  left := \fun (i: GeneratingParameters.Index) => basis (Pair.first (Fin.Fin c.dimension) (Fin.Fin one) i) p,
  right := \fun (i: GeneratingParameters.Index) => coefficient (Pair.first (Fin.Fin c.dimension) (Fin.Fin one) i) p
};
\definition liftContinuous: topology.Continuity[A := Local.ProductPoint, B := GeneratingParameters.Point].Continuous Local.productTopology GeneratingParameters.topology lift :=
  GeneratingParameters.Universal[Y := Local.ProductPoint].continuous Local.productTopology lift baseContinuous
    (\fun (i: GeneratingParameters.Index) => basisContinuous (Pair.first (Fin.Fin c.dimension) (Fin.Fin one) i))
    (\fun (i: GeneratingParameters.Index) => realContinuous (Pair.first (Fin.Fin c.dimension) (Fin.Fin one) i));
\definition model[p: Local.ProductPoint]: Family.Point := parameter (Pair.pair N.Nat^ N.Nat^ c.dimension one) (lift p);
\definition modelContinuous: topology.Continuity[A := Local.ProductPoint, B := Family.Point].Continuous Local.productTopology topology model :=
  topology.Composition[A := Local.ProductPoint, B := GeneratingParameters.Point, C := Family.Point].composeContinuous Local.productTopology GeneratingParameters.topology topology lift
    (parameter (Pair.pair N.Nat^ N.Nat^ c.dimension one)) liftContinuous (Final.parameterContinuous (Pair.pair N.Nat^ N.Nat^ c.dimension one));
\definition formula: \forall (p: Local.ProductPoint) -> model p = Local.backward p :=
  \fun (p: Local.ProductPoint) => congr!{{Fiber (base p)} Family.Point} (Family.include (base p)) _ _
    (trans!{{Fiber (base p)}} _ _ _
      (RealSpaces.Sums[I := Fin.Fin c.dimension].Vector[V := Fiber (base p), space := Tensor.fiberSpace (base p)].congruent (Fin.elements c.dimension)
        (\fun (i: Fin.Fin c.dimension) => (Tensor.fiberSpace (base p)).add (pure (base p) (basis i p) (coefficient i p)) (Tensor.fiberSpace (base p)).zero)
        (\fun (i: Fin.Fin c.dimension) => pure (base p) (basis i p) (coefficient i p))
        (\fun (i: Fin.Fin c.dimension) => RealSpaces.Laws[V := Fiber (base p), space := Tensor.fiberSpace (base p)].zeroRight (pure (base p) (basis i p) (coefficient i p))))
      (sym!{{Fiber (base p)}} _ _ (\root.Operations[].Scalars[].ComplexTensor[V := F (base p), source := source.space (base p)].Finite[n := c.dimension, frame := c.frame (center p)].backwardFormula (Pair.second Local.BasePoint (Complex.Vector c.dimension) p))));
\definition backward[p: Local.ProductPoint]: Family.Point := Local.backward p;
\definition continuous: topology.Continuity[A := Local.ProductPoint, B := Family.Point].Continuous Local.productTopology topology backward :=
  \idelim model = backward \with f: (Local.ProductPoint -> Family.Point) => topology.Continuity[A := Local.ProductPoint, B := Family.Point].Continuous Local.productTopology topology f \by {
    base: modelContinuous, equality: \axiom:funext(model, backward, formula)
  };
