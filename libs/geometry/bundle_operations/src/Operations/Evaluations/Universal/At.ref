\import \root.Operations[].Subset[E := E, U := Domain i].Pullback[A := A, f := f] \as Pullback;
\definition Point: \Set := Pullback.Point;
\import Source.Subspace[S := Pullback.Domain] \as Subspace;
\definition value[p: Point]: K := evaluate i (Pullback.restricted p);
\definition Regular[source: Source.Topology]: \Prop := topology.Continuity[A := Point, B := K].Continuous (Subspace.topology source) scalarSpace value;
\definition open: \forall (source: Source.Topology)(V: \Pow K) -> Scalars.IsOpenIn scalarSpace V -> BaseContinuous source f -> Regular source -> Source.IsOpenIn source (Maps.Preimage f (Test i V)) :=
  \fun (source: _)(V: _)(openV: _)(baseRegular: _)(regular: _) => Pullback.open source (topology.Maps[A := \Cast[E] (Domain i), B := K].Preimage (evaluate i) V)
    (regular V openV) (baseRegular (domains i) (open i));
