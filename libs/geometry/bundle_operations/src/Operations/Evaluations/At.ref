\import Total.Subspace[S := Domain i] \as Subspace;
\import \root.Operations[].Subset[E := E, U := Domain i] \as Subset;
\import topology.Topology[Carrier := Point i] \as Sub;
\import topology.Maps[A := Point i, B := K] \as Maps;
\definition continuous: topology.Continuity[A := Point i, B := K].Continuous (Subspace.topology topology) scalarSpace (evaluate i) :=
  \fun (V: \Pow K)(open: _) => \idelim Subspace.Trace (Test i V) = Maps.Preimage (evaluate i) V \with W: \Pow (Point i) => Sub.IsOpenIn (Subspace.topology topology) W \by {
    base: Subspace.traceOpen topology (Test i V) (testOpen i V open), equality: Subset.traceImage (Maps.Preimage (evaluate i) V)
  };
