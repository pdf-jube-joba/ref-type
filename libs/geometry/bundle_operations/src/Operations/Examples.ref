\import real.Analysis[] \as R;
\import complex.Complex[] \as C;
\import metric_spaces.RealLine[] \as Line;
\import \root.Operations[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].Examples[] \as Real;
\import \root.Operations[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Examples[] \as Complex;
\import \root.Operations[].Scalars[].Complexification[X := R.Real, F := Real.F, source := Real.bundle] \as Complexification;
\import \root.Operations[].Scalars[].Realification[X := R.Real, F := Complex.F, source := Complex.bundle] \as Realification;
\import Complexification.Pullback[Y := R.Real, baseSpace := Line.topology, f := Real.square, regular := Real.squareContinuous] \as ComplexificationPullback;
\definition complexificationPullback: vector_bundles.Bundles[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Isomorphisms[X := R.Real, F := \fun (x: R.Real) => Complexification.Fiber (Real.square x), G := \fun (x: R.Real) => Complexification.Fiber (Real.square x), source := ComplexificationPullback.firstBundle, target := ComplexificationPullback.secondBundle].Isomorphism := ComplexificationPullback.isomorphism;
\import Realification.Pullback[Y := R.Real, baseSpace := Line.topology, f := Real.square, regular := Real.squareContinuous] \as RealificationPullback;
\definition realificationPullback: vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].Isomorphisms[X := R.Real, F := \fun (x: R.Real) => Complex.F (Real.square x), G := \fun (x: R.Real) => Complex.F (Real.square x), source := RealificationPullback.firstBundle, target := RealificationPullback.secondBundle].Isomorphism := RealificationPullback.isomorphism;
