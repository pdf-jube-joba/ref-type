\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import std.Alg[].Field[] \as Fields;
\import vector_bundles.Bundles[] \as Bundles;
\module Over(K: \Set, field: Fields.Field[K], conjugation: linear_algebra.Hermitian[].Scalar[K, field], scalar: Bundles.Scalar[K, field, conjugation]);
\module Final(I, E: \Set, P: I -> \Set,
  parameterSpaces: \forall (i: I) -> topology.Topology[Carrier := P i].Topology,
  parameter: \forall (i: I) -> P i -> E);
\module Subset(E: \Set, U: \Pow E);
\module Evaluations(K, X, E, I: \Set,
  scalarSpace: topology.Topology[Carrier := K].Topology, baseSpace: topology.Topology[Carrier := X].Topology,
  projection: E -> X, domains: I -> \Pow X,
  open: \forall (i: I) -> topology.Topology[Carrier := X].IsOpenIn baseSpace (domains i),
  evaluate: \forall (i: I) -> \Cast[E] ({ e: E \where \In[X] (domains i) (projection e) }) -> K);
\module Bijection(A, B: \Set, source: topology.Topology[Carrier := A].Topology, forward: A -> B, backward: B -> A);
\module Scalars;
\module Examples;
