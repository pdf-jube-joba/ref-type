\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Pair[] \as Pair;
\import std.Data[].List[] \as Lists;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Classical[] \as Classical;
\import std.Alg[].Field[] \as Fields;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Logic.either;
\module ZeroExtension(A, B: \Set, U, S: \Pow A,
  source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology,
  open: topology.Topology[Carrier := A].IsOpenIn source U,
  closed: topology.Topology[Carrier := A].IsClosedIn source S,
  within: topology.Topology[Carrier := A].Subset S U,
  f: \Cast[A] U -> B, default: B,
  regular: topology.Continuity[A := \Cast[A] U, B := B].Continuous (topology.Topology[Carrier := A].Subspace[S := U].topology source) target f,
  vanishes: \forall (a: \Cast[A] U) -> Logic.Not (topology.Topology[Carrier := A].Member S a) -> f a = default);
\module Over(K: \Set, field: Fields.Field[K], conjugation: linear_algebra.Hermitian[].Scalar[K, field], scalar: vector_bundles.Bundles[].Scalar[K, field, conjugation]);
