\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].CoordinateFamily[X := X, m := m, n := n, baseSpace := baseSpace, A := A, regular := regular] \as Family;
\definition bundle: Bundles.Family[X := X, F := \fun (x: X) => Vector m].Bundle := Family.bundle;
\definition map: Bundles.Morphisms[X := X, Y := X, F := \fun (x: X) => Vector m, G := \fun (x: X) => Vector n, source := bundle, target := Bundles.Trivial[X := X, n := n, baseSpace := baseSpace].bundle, f := \fun (x: X) => x].Map := Family.map;
\definition embedding: \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].For[X := X, F := \fun (x: X) => Vector m, bundle := bundle].Embedding :=
  \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].For[X := X, F := \fun (x: X) => Vector m, bundle := bundle].Embedding { dimension := n, map := map, injective := injective };
