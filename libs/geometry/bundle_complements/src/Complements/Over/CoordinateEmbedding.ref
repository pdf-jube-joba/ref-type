\import Bundles.Trivial[X := X, n := m, baseSpace := baseSpace] \as Source;
\import Bundles.Trivial[X := X, n := n, baseSpace := baseSpace] \as Target;
\import Bundles.Family[X := X, F := \fun (x: X) => Vector m] \as Family;
\import Bundles.Morphisms[X := X, Y := X, F := \fun (x: X) => Vector m, G := \fun (x: X) => Vector n, source := Source.bundle, target := Target.bundle, f := \fun (x: X) => x] \as Maps;
\import Hermitian.At[n := n].Families[X := Family.Point].Matrix[m := m] \as Matrices;
\import topological_algebra.Coordinates[K := K, I := Fin.Fin m] \as DomainCoordinates;
\import topological_algebra.Coordinates[K := K, I := Fin.Fin n] \as TargetCoordinates;
\definition baseContinuous: topology.Continuity[A := Family.Point, B := X].Continuous Source.topology baseSpace Family.projection := Family.Of[bundle := Source.bundle].projectionContinuous;
\definition components: Matrices.Components Source.topology (\fun (p: Family.Point) => A p.base) := \fun (j: Fin.Fin m)(i: Fin.Fin n) =>
  topology.Composition[A := Family.Point, B := X, C := K].composeContinuous Source.topology baseSpace scalar.topological.space Family.projection (\fun (x: X) => (A x).apply (Geometry.Finite[n := m].basis j) i) baseContinuous (regular (Geometry.Finite[n := m].basis j) i);
\definition vectors: Hermitian.At[n := m].Families[X := Family.Point].Continuous Source.topology (\fun (p: Family.Point) => p.vector) :=
  \fun (i: Fin.Fin m) => topology.Composition[A := Family.Point, B := Vector m, C := K].composeContinuous Source.topology (coordinateTopology m) scalar.topological.space (\fun (p: Family.Point) => p.vector) (\fun (v: Vector m) => v i) Source.vectorContinuous (DomainCoordinates.evaluationContinuous scalar.topological.space i);
\definition vectorContinuous: topology.Continuity[A := Family.Point, B := Vector n].Continuous Source.topology (coordinateTopology n) (\fun (p: Family.Point) => (A p.base).apply p.vector) :=
  TargetCoordinates.Universal[A := Family.Point].continuous Source.topology scalar.topological.space (\fun (p: Family.Point) => (A p.base).apply p.vector) (Matrices.evaluate Source.topology (\fun (p: Family.Point) => A p.base) (\fun (p: Family.Point) => p.vector) components vectors);
\definition data: Maps.Data := Maps.Data { fiber := A };
\definition map: Maps.Map := \into[Maps.Data](data, Maps.Map) \by {
  \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].TrivialMaps[X := X, n := n, baseSpace := baseSpace].Into[Y := Family.Point, source := Source.topology].continuous Family.projection (\fun (p: Family.Point) => (A p.base).apply p.vector) baseContinuous vectorContinuous
};
\definition bundle: Bundles.Family[X := X, F := \fun (x: X) => Vector m].Bundle := Source.bundle;
\definition embedding: \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].For[X := X, F := \fun (x: X) => Vector m, bundle := bundle].Embedding :=
  \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].For[X := X, F := \fun (x: X) => Vector m, bundle := bundle].Embedding { dimension := n, map := map, injective := injective };
