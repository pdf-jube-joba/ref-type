\import Bundles.Family[X := X, F := F].Of[bundle := source].Pullback[Y := Y, source := base, f := f] \as First;
\import Bundles.Family[X := X, F := G].Of[bundle := target].Pullback[Y := Y, source := base, f := f] \as Second;
\import Bundles.Isomorphisms[X := X, F := F, G := G, source := source, target := target] \as Original;
\import Bundles.Isomorphisms[X := Y, F := \fun (y: Y) => F (f y), G := \fun (y: Y) => G (f y), source := First.pulled sourceRegular, target := Second.pulled targetRegular] \as Result;
\definition isomorphism[iso: Original.Isomorphism]: Result.Isomorphism := Result.Isomorphism {
  forward := Bundles.ArrowLaws[X := X, Y := X, F := F, G := G, source := source, target := target, f := \fun (x: X) => x].Pullback[Z := Y, space := base, g := f].Of[a := iso.forward, regular := sourceRegular].map,
  backward := Bundles.ArrowLaws[X := X, Y := X, F := G, G := F, source := target, target := source, f := \fun (x: X) => x].Pullback[Z := Y, space := base, g := f].Of[a := iso.backward, regular := targetRegular].map,
  leftInverse := \fun (y: Y) => (\bysub(Original.Data, Original.Isomorphism, iso)).leftInverse (f y),
  rightInverse := \fun (y: Y) => (\bysub(Original.Data, Original.Isomorphism, iso)).rightInverse (f y)
};
\definition formula: \forall (iso: Original.Isomorphism)(y: Y)(v: F (f y)) -> ((isomorphism iso).forward.fiber y).apply v = (iso.forward.fiber (f y)).apply v := \fun (iso: Original.Isomorphism)(y: Y)(v: F (f y)) => \refl((iso.forward.fiber (f y)).apply v);
