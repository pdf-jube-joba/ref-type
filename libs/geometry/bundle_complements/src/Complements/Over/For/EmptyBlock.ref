\import Operations.ZeroMap[X := X, F := F, G := \fun (x: X) => Vector N.Nat^::zero, source := bundle, target := Ambient N.Nat^::zero, sameBase := \refl(bundle.baseSpace)] \as Zero;
\definition block: Block[Lists.List[WeightedChart]::nil] := Block[Lists.List[WeightedChart]::nil] {
  map := Zero.map,
  kernelMass := \fun (x: X)(v: F x)(zero: _) => trans!{{F x}} _ _ _
    (congr!{K {F x}} (\fun (a: K) => (bundle.space x).smul a v) _ _ conjugation.embedZero) (Spaces.Laws[V := F x, space := bundle.space x].zeroScale v)
};
