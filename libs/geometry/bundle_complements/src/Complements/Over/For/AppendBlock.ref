\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].For[X := X, F := F, bundle := bundle].Weighted[entry := head] \as Head;
\definition n: N.Nat^ := head.chart.dimension;
\definition m: N.Nat^ := dimension tail;
\import Operations.CoordinateSum[n := n, m := m] \as Coordinates;
\import Spaces.DirectSum[V := Vector n, W := Vector m, left := coordinates n, right := coordinates m] \as Sum;
\module At(x: X);
\import Bundles.Morphisms[X := X, Y := X, F := F, G := \fun (x: X) => Vector (dimension (Lists.List[WeightedChart]::cons head tail)), source := bundle, target := Ambient (dimension (Lists.List[WeightedChart]::cons head tail)), f := \fun (x: X) => x] \as Maps;
\definition data: Maps.Data := Maps.Data { fiber := \fun (x: X) => At[x := x].map };
\module Continuity;
\definition map: Maps.Map := \into[Maps.Data](data, Maps.Map) \by { Continuity[].regular };
\definition block: Block[Lists.List[WeightedChart]::cons head tail] := Block[Lists.List[WeightedChart]::cons head tail] {
  map := map,
  kernelMass := \fun (x: X) => At[x := x].kernelMass
};
