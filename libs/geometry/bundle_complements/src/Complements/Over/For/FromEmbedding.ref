\definition n: N.Nat^ := embedding.dimension;
\import Geometry.Finite[n := n] \as Euclidean;
\definition form[x: X]: Form x := Geometry.Inner[V := F x, space := bundle.space x].Form {
  dot := \fun (v, w: F x) => Euclidean.dot ((embedding.map.fiber x).apply v) ((embedding.map.fiber x).apply w),
  symmetric := \fun (v, w: F x) => Euclidean.form.symmetric ((embedding.map.fiber x).apply v) ((embedding.map.fiber x).apply w),
  zeroRight := \fun (v: F x) => trans!{K} _ _ _ (congr!{{Vector n} K} (Euclidean.dot ((embedding.map.fiber x).apply v)) _ _ (embedding.map.fiber x).preservesZero) (Euclidean.form.zeroRight ((embedding.map.fiber x).apply v)),
  addRight := \fun (u, v, w: F x) => trans!{K} _ _ _ (congr!{{Vector n} K} (Euclidean.dot ((embedding.map.fiber x).apply u)) _ _ ((embedding.map.fiber x).preservesAdd v w)) (Euclidean.form.addRight ((embedding.map.fiber x).apply u) ((embedding.map.fiber x).apply v) ((embedding.map.fiber x).apply w)),
  scaleRight := \fun (a: K)(v, w: F x) => trans!{K} _ _ _ (congr!{{Vector n} K} (Euclidean.dot ((embedding.map.fiber x).apply v)) _ _ ((embedding.map.fiber x).preservesScale a w)) (Euclidean.form.scaleRight a ((embedding.map.fiber x).apply v) ((embedding.map.fiber x).apply w))
};
\definition positive[x: X]: Positive x (form x) := Geometry.Inner[V := F x, space := bundle.space x].Positive[form x] {
  nonnegative := \fun (v: F x) => Euclidean.positive.nonnegative ((embedding.map.fiber x).apply v),
  definite := \fun (v: F x)(zero: _) => embedding.injective x v (bundle.space x).zero
    (trans!{{Vector n}} _ _ _ (Euclidean.positive.definite ((embedding.map.fiber x).apply v) zero) (sym!{{Vector n}} _ _ (embedding.map.fiber x).preservesZero))
};
\module Continuity;
\definition metric: Metric := Metric { form := form, positive := positive, continuous := Continuity[].continuous };
\module Image;
\module Complement;
