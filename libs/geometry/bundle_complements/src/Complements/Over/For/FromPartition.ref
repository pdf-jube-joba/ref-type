\definition block: Block[parts] := build parts;
\definition zeroKernel: \forall (x: X)(v: F x) -> (block.map.fiber x).apply v = (coordinates (dimension parts)).zero -> v = (bundle.space x).zero :=
  \fun (x: X)(v: F x)(zero: _) => trans!{{F x}} _ _ _ (sym!{{F x}} _ _ ((bundle.space x).scalarOne v))
    (trans!{{F x}} _ _ _
      (congr!{K {F x}} (\fun (a: K) => (bundle.space x).smul a v) _ _ (sym!{K} _ _ (trans!{K} _ _ _ (congr!{{R.Real} K} conjugation.embed _ _ (total x)) conjugation.embedOne)))
      (block.kernelMass x v zero));
\definition embedding: Embedding := Embedding {
  dimension := dimension parts, map := block.map,
  injective := \fun (x: X) => Spaces.Linear[V := F x, W := Vector (dimension parts), source := bundle.space x, target := coordinates (dimension parts)].injectiveOfZeroKernel (block.map.fiber x) (zeroKernel x)
};
