\definition domains: \Pow (\Pow X) := { U: \Pow X \where \exists ( c: Charts.Chart \where c.domain = U ) };
\definition cover: Base.IsOpenCover[bundle.baseSpace, domains, Base.Whole] := Base.IsOpenCover[bundle.baseSpace, domains, Base.Whole] {
  open := \fun (U: \Pow X)(member: _) => \block {
    \takefrom c: \Cast[Charts.Chart] ({ c: Charts.Chart \where c.domain = U }) \by member \then
    \return \idelim c.domain = U \with V: \Pow X => Base.IsOpenIn bundle.baseSpace V \by {
      base: (\bysub(Charts.ChartData, Charts.Chart, c)).baseOpen,
      equality: \bysub(Charts.Chart, { c: Charts.Chart \where c.domain = U }, c)
    }
  },
  covers := \fun (x: X)(whole: _) => \block {
    \takefrom c: \Cast[Charts.Chart] ({ c: Charts.Chart \where Base.Member c.domain x }) \by Family.Of[bundle := bundle].locallyTrivial x \then
    \return Base.unionMemberOf domains c.domain x (Logic.existsIntro[Charts.Chart, { d: Charts.Chart \where d.domain = c.domain }] c (\refl(c.domain)))
      (\bysub(Charts.Chart, { c: Charts.Chart \where Base.Member c.domain x }, c))
  }
};
\import Partitions.Of[source := bundle.baseSpace, family := domains] \as Partitions;
\structure Lift[parts: Lists.List[Partitions.Entry]]: \Set := {
  weighted: Lists.List[WeightedChart],
  agrees: \forall (x: X) -> mass weighted x = Partitions.sum parts x,
};
\definition liftsExist: \forall (parts: Lists.List[Partitions.Entry]) -> \exists Lift[parts] :=
  \induction (parts: Lists.List[Partitions.Entry]) \return \exists Lift[parts] \with {
    | nil: \exact(Lift[Lists.List[Partitions.Entry]::nil] { weighted := Lists.List[WeightedChart]::nil, agrees := \fun (x: X) => \refl(R.zero) }, Lift[Lists.List[Partitions.Entry]::nil])
    | cons: \fun (head: Partitions.Entry)(tail: Lists.List[Partitions.Entry])(ih: \exists Lift[tail]) => \block {
      \takefrom previous: Lift[tail] \by ih \then
      \takefrom chart: \Cast[Charts.Chart] ({ c: Charts.Chart \where c.domain = head.openSet }) \by head.inCover \then
      \let weighted: WeightedChart := WeightedChart {
        chart := chart, weight := head.value,
        supportWithin := \fun (x: X)(member: _) => \idelim head.openSet = chart.domain \with U: \Pow X => Base.Member U x \by {
          base: head.supportWithin x member,
          equality: sym!{{\Pow X}} _ _ (\bysub(Charts.Chart, { c: Charts.Chart \where c.domain = head.openSet }, chart))
        }
      } \then
      \return \exact(Lift[Lists.List[Partitions.Entry]::cons head tail] {
        weighted := Lists.List[WeightedChart]::cons weighted previous.weighted,
        agrees := \fun (x: X) => congr!{{R.Real} {R.Real}} (R.add (head.value x)) _ _ (previous.agrees x)
      }, Lift[Lists.List[Partitions.Entry]::cons head tail])
    }
  };
\definition embeddingExists: Base.IsCompact bundle.baseSpace -> Base.IsT2 bundle.baseSpace -> \exists Embedding :=
  \fun (compact: _)(hausdorff: _) => \block {
    \takefrom partition: Partitions.Partition \by Partitions.Construction[].existsPartition compact hausdorff cover \then
    \takefrom lift: Lift[partition.parts] \by liftsExist partition.parts \then
    \return \exact(\root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].For[X := X, F := F, bundle := bundle].FromPartition[parts := lift.weighted, total := \fun (x: X) => trans!{{R.Real}} (mass lift.weighted x) (Partitions.sum partition.parts x) R.one (lift.agrees x) (partition.total x)].embedding, Embedding)
  };
