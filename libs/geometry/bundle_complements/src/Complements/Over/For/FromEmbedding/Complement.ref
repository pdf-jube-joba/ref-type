\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].For[X := X, F := F, bundle := bundle].FromEmbedding[embedding := embedding].Image[] \as Image;
\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projection[X := X, n := n, baseSpace := bundle.baseSpace, P := Image.projection, regular := Image.regular].Complement[] \as Split;
\definition ComplementFiber[x: X]: \Set := Split.ComplementFiber x;
\definition complementBundle: Bundles.Family[X := X, F := ComplementFiber].Bundle := Split.complementBundle;
\import Operations.IdentityIsomorphism[X := X, F := ComplementFiber, bundle := complementBundle] \as Identity;
\import Operations.DirectSumIsomorphisms[X := X, F := F, G := ComplementFiber, A := Image.ImageFiber, B := ComplementFiber, first := bundle, second := complementBundle, newFirst := Image.imageBundle, newSecond := complementBundle, sameSource := \refl(bundle.baseSpace), sameTarget := \refl(bundle.baseSpace)] \as First;
\definition SourceFiber[x: X]: \Set := First.SourceFiber x;
\definition sumBundle: Bundles.Family[X := X, F := SourceFiber].Bundle := First.sourceBundle;
\definition first: Bundles.Isomorphisms[X := X, F := SourceFiber, G := First.TargetFiber, source := sumBundle, target := First.targetBundle].Isomorphism := First.isomorphism Image.isomorphism Identity.isomorphism;
\import Operations.IsomorphismComposition[X := X, F := SourceFiber, G := First.TargetFiber, H := \fun (x: X) => Vector n, source := sumBundle, middle := First.targetBundle, target := Ambient n] \as Composition;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := SourceFiber, G := \fun (x: X) => Vector n, source := sumBundle, target := Ambient n].Isomorphism := Composition.compose first Split.isomorphism;
\definition orthogonal: \forall (x: X)(v: F x)(w: ComplementFiber x) -> Euclidean.dot ((embedding.map.fiber x).apply v) w = field.zero :=
  \fun (x: X)(v: F x)(w: ComplementFiber x) => Split.orthogonal x ((Image.isomorphism.forward.fiber x).apply v) w;
