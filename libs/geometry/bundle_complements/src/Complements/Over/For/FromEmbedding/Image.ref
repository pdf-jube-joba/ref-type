\import Hermitian.At[n := n] \as Native;
\import Geometry.Inner[V := Vector n, space := coordinates n].Of[h := Euclidean.form] \as Inner;
\import Spaces.Linear[V := Vector n, W := Vector n, source := coordinates n, target := coordinates n] \as End;
\module At(x: X);
\definition projection[x: X]: Native.Projection := At[x := x].projection;
\definition domains[c: Charts.Chart]: \Pow X := c.domain;
\module In(chart: Charts.Chart);
\import topology.Continuity[A := X, B := K].Covered[I := Charts.Chart, domains := domains] \as Covered;
\definition regular: Native.Families[X := X].Matrix[m := n].Regular bundle.baseSpace (\fun (x: X) => (projection x).map) :=
  \fun (v: Vector n)(i: Fin.Fin n) => Covered.continuous bundle.baseSpace scalar.topological.space (\fun (x: X) => (projection x).map.apply v i)
    (\fun (c: Charts.Chart) => (\bysub(Charts.ChartData, Charts.Chart, c)).baseOpen)
    (\fun (x: X) => Family.Of[bundle := bundle].locallyTrivial x)
    (\fun (c: Charts.Chart) => In[chart := c].regular v i);
\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projection[X := X, n := n, baseSpace := bundle.baseSpace, P := projection, regular := regular] \as Projected;
\definition ImageFiber[x: X]: \Set := Projected.Fiber x;
\definition imageBundle: Bundles.Family[X := X, F := ImageFiber].Bundle := Projected.bundle;
\module Comparison;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := F, G := ImageFiber, source := bundle, target := imageBundle].Isomorphism := Comparison[].isomorphism;
