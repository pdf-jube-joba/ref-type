\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Finite[n := n].Range[V := F x, space := bundle.space x, f := embedding.map.fiber x, injective := embedding.injective x] \as Range;
\import Range.WithFrame[k := k, frame := chart.frame x] \as Coordinates;
\definition injection: \forall (v, w: Vector k) -> (A x).apply v = (A x).apply w -> v = w := Coordinates.injection;
\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].For[X := X, F := F, bundle := bundle].FromEmbedding[embedding := embedding].Image[].At[x := x] \as Original;
\definition comparison[factor: Inner.Gram[k := k].Factorization[A x]]: (projection x).map = Coordinates.Using[factor := factor].candidate := Range.unique Original.map (Coordinates.Using[factor := factor].candidate);
