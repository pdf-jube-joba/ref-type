\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].For[X := X, F := F, bundle := bundle].FromEmbedding[embedding := embedding].Image[].In[chart := chart] \as Original;
\definition Carrier: \Set := \Cast[TargetFamily.Point] (domains chart);
\definition source: topology.Topology[Carrier := Carrier].Topology := topology.Topology[Carrier := TargetFamily.Point].Subspace[S := domains chart].topology imageBundle.totalSpace;
\import Native.Forms[h := Euclidean.form].Families[X := Original.Carrier] \as Families;
\module With(factors: Families.Rank[k := chart.dimension].Factors[Original.A, Original.source]);
\definition regular: topology.Continuity[A := Carrier, B := Family.Point].Continuous source bundle.totalSpace (\fun (p: Carrier) => BackwardMaps.total backwardData p) := \block {
  \takefrom factors: Families.Rank[k := chart.dimension].Factors[Original.A, Original.source] \by Families.exists chart.dimension Original.source Original.A Original.matrixRegular Original.injection Euclidean.positive \then
  \return With[factors := factors].regular
};
