\definition k: N.Nat^ := chart.dimension;
\definition Carrier: \Set := \Cast[X] chart.domain;
\definition source: topology.Topology[Carrier := Carrier].Topology := Base.Subspace[S := chart.domain].topology bundle.baseSpace;
\definition A[x: Carrier]: Spaces.Linear[V := Vector k, W := Vector n, source := coordinates k, target := coordinates n].Map :=
  Spaces.Linear[V := F x, W := Vector n, source := bundle.space x, target := coordinates n].Composition[U := Vector k, domain := coordinates k].compose (embedding.map.fiber x) (chart.frame x).backward;
\module Continuity;
\definition matrixRegular: Native.Families[X := Carrier].Matrix[m := k].Regular source A := Continuity[].regular;
\module Point(x: Carrier);
\definition injection: \forall (x: Carrier)(v, w: Vector k) -> (A x).apply v = (A x).apply w -> v = w := \fun (x: Carrier) => Point[x := x].injection;
\import Native.Forms[h := Euclidean.form].Families[X := Carrier] \as Families;
\module With(factors: Families.Rank[k := k].Factors[A, source]);
\definition regular: Native.Families[X := Carrier].Matrix[m := n].Regular source (\fun (x: Carrier) => (projection x).map) :=
  \fun (v: Vector n)(i: Fin.Fin n) => \block {
    \takefrom factors: Families.Rank[k := k].Factors[A, source] \by Families.exists k source A Continuity[].regular injection Euclidean.positive \then
    \return With[factors := factors].regular v i
  };
