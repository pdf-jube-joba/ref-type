\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Finite[n := n].Range[V := F x, space := bundle.space x, f := embedding.map.fiber x, injective := embedding.injective x] \as Range;
\definition exists: \exists Range.Candidate := \block {
  \takefrom chart: \Cast[Charts.Chart] ({ c: Charts.Chart \where Base.Member c.domain x }) \by Family.Of[bundle := bundle].locallyTrivial x \then
  \let point: \Cast[X] chart.domain := \into[X](x, chart.domain) \by { \bysub(Charts.Chart, { c: Charts.Chart \where Base.Member c.domain x }, chart) } \then
  \return Range.WithFrame[k := chart.dimension, frame := chart.frame point].exists
};
\definition map: Range.Candidate := \choice Range.Candidate \by { existence: exists, uniqueness: Range.unique };
\definition conditions: Range.Conditions[map] := Range.conditions map;
\definition projection: Native.Projection := Native.Projection { map := map, selfAdjoint := conditions.selfAdjoint, idempotent := conditions.idempotent };
