\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Representations[X := Y, baseSpace := source] \as Target;
\module At(p: Presentation);
\definition presentation[p: Presentation]: Target.Presentation := At[p := p].presentation;
\module Between(p, q: Presentation);
\definition respects: \forall (p, q: Presentation) -> Equivalent p q -> Target.Equivalent (presentation p) (presentation q) :=
  \fun (p, q: Presentation)(related: _) => \block {
    \takefrom iso: Isomorphism p q \by related \then
    \return \exact(Between[p := p, q := q].isomorphism iso, Target.Isomorphism (presentation p) (presentation q))
  };
\import Quotient.Maps[B := Target.Classes] \as Descend;
\definition respectsClasses: Descend.Respects (\fun (p: Presentation) => Target.class (presentation p)) :=
  \fun (p, q: Presentation)(related: _) => Target.relatedEqual (presentation p) (presentation q) (respects p q related);
\definition map[C: Classes]: Target.Classes := Descend.value equivalence (\fun (p: Presentation) => Target.class (presentation p)) respectsClasses C;
\definition onClass: \forall (p: Presentation) -> map (class p) = Target.class (presentation p) := Descend.onClass equivalence (\fun (p: Presentation) => Target.class (presentation p)) respectsClasses;
\module Of(F: X -> \Set, original: Bundles.Family[X := X, F := F].Bundle, same: original.baseSpace = baseSpace);
