\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projection[X := X, n := p.dimension, baseSpace := baseSpace, P := p.projection, regular := p.regular] \as Image;
\definition Fiber[x: X]: \Set := Image.Fiber x;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Image.bundle;
