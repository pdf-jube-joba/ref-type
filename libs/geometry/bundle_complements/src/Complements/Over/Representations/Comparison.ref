\import \parent.Of[F := F, original := first, same := firstSame] \as First;
\import \parent.Of[F := G, original := second, same := secondSame] \as Second;
\import Bundles.Isomorphisms[X := X, F := F, G := G, source := first, target := second] \as Isos;
\definition representativesEqual: \forall (iso: Isos.Isomorphism) -> First.representatives = Second.representatives := \fun (iso: Isos.Isomorphism) =>
  \axiom:setext(First.representatives, Second.representatives,
    \fun (p: Presentation)(represented: First.Represents p) => \block {
      \takefrom a: First.Isomorphism p \by represented \then
      \return \exact(Operations.IsomorphismComposition[X := X, F := G, G := F, H := Fiber p, source := second, middle := first, target := bundle p].compose (Isos.inverse iso) a, Second.Isomorphism p)
    },
    \fun (p: Presentation)(represented: Second.Represents p) => \block {
      \takefrom b: Second.Isomorphism p \by represented \then
      \return \exact(Operations.IsomorphismComposition[X := X, F := F, G := G, H := Fiber p, source := first, middle := second, target := bundle p].compose iso b, First.Isomorphism p)
    });
\module Compact(firstCompact: topology.Topology[Carrier := X].IsCompact first.baseSpace, firstT2: topology.Topology[Carrier := X].IsT2 first.baseSpace,
  secondCompact: topology.Topology[Carrier := X].IsCompact second.baseSpace, secondT2: topology.Topology[Carrier := X].IsT2 second.baseSpace);
