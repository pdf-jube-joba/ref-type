\definition isomorphicEqual: \forall (iso: Isos.Isomorphism) -> First.class firstCompact firstT2 = Second.class secondCompact secondT2 := representativesEqual;
\definition equalIsomorphic: First.class firstCompact firstT2 = Second.class secondCompact secondT2 -> \exists Isos.Isomorphism := \fun (equal: _) => \block {
  \takefrom embedding: FirstOriginal.Embedding \by FirstOriginal.embeddingExists firstCompact firstT2 \then
  \let p: Presentation := First.FromEmbedding[embedding := embedding].presentation \then
  \let a: First.Isomorphism p := First.FromEmbedding[embedding := embedding].isomorphism \then
  \let represented: Second.Represents p := \idelim First.representatives = Second.representatives \with S: \Pow Presentation => \In[Presentation] S p \by { base: \exact(a, First.Isomorphism p), equality: equal } \then
  \takefrom b: Second.Isomorphism p \by represented \then
  \return \exact(Operations.IsomorphismComposition[X := X, F := F, G := Fiber p, H := G, source := first, middle := bundle p, target := second].compose a
    (Bundles.Isomorphisms[X := X, F := G, G := Fiber p, source := second, target := bundle p].inverse b), Isos.Isomorphism)
};
\definition criterion: Logic.PropEquiv[First.class firstCompact firstT2 = Second.class secondCompact secondT2, \exists Isos.Isomorphism] :=
  Logic.PropEquiv[First.class firstCompact firstT2 = Second.class secondCompact secondT2, \exists Isos.Isomorphism] {
    ltr := equalIsomorphic,
    rtl := \fun (exists: _) => \block { \takefrom iso: Isos.Isomorphism \by exists \then \return isomorphicEqual iso }
  };
