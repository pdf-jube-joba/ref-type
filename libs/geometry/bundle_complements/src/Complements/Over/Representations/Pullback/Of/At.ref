\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Representations[X := X, baseSpace := baseSpace].Pullback[Y := Y, source := source, f := f, regularBase := regularBase].At[p := p] \as Image;
\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].PulledIsomorphism[X := X, Y := Y, F := F, G := Fiber p, source := original, target := bundle p, base := source, f := f, sourceRegular := originalRegular, targetRegular := regularBase] \as PullIso;
\definition isomorphism[iso: Original.Isomorphism p]: Classified.Isomorphism (presentation p) :=
  Operations.IsomorphismComposition[X := Y, F := \fun (y: Y) => F (f y), G := \fun (y: Y) => Fiber p (f y), H := Target.Fiber (presentation p), source := pulled, middle := Image.pulledBundle, target := Target.bundle (presentation p)].compose (PullIso.isomorphism iso) Image.isomorphism;
