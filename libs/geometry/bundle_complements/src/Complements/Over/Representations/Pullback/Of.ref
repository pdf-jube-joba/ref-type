\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Representations[X := X, baseSpace := baseSpace].Of[F := F, original := original, same := same] \as Original;
\definition originalRegular: topology.Continuity[A := Y, B := X].Continuous source original.baseSpace f := \idelim baseSpace = original.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Continuity[A := Y, B := X].Continuous source t f \by { base: regularBase, equality: sym!{topology.Topology[Carrier := X].Topology} _ _ same };
\import Bundles.Family[X := X, F := F].Of[bundle := original].Pullback[Y := Y, source := source, f := f] \as Pull;
\definition pulled: Bundles.Family[X := Y, F := \fun (y: Y) => F (f y)].Bundle := Pull.pulled originalRegular;
\import Target.Of[F := \fun (y: Y) => F (f y), original := pulled, same := \refl(source)] \as Classified;
\module At(p: Presentation);
\definition naturality: \forall (compact: topology.Topology[Carrier := X].IsCompact original.baseSpace)(hausdorff: topology.Topology[Carrier := X].IsT2 original.baseSpace)
  (sourceCompact: topology.Topology[Carrier := Y].IsCompact source)(sourceT2: topology.Topology[Carrier := Y].IsT2 source) -> map (Original.class compact hausdorff) = Classified.class sourceCompact sourceT2 :=
  \fun (compact: _)(hausdorff: _)(sourceCompact: _)(sourceT2: _) => \block {
    \takefrom embedding: \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].For[X := X, F := F, bundle := original].Embedding
      \by \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].For[X := X, F := F, bundle := original].embeddingExists compact hausdorff \then
    \let p: Presentation := Original.FromEmbedding[embedding := embedding].presentation \then
    \let iso: Original.Isomorphism p := Original.FromEmbedding[embedding := embedding].isomorphism \then
    \return trans!{Target.Classes} _ _ _
      (congr!{Classes Target.Classes} map _ _ ((Original.classification compact hausdorff p).rtl (\exact(iso, Original.Isomorphism p))))
      (trans!{Target.Classes} _ _ _ (onClass p)
        (sym!{Target.Classes} _ _ ((Classified.classification sourceCompact sourceT2 (presentation p)).rtl (\exact(At[p := p].isomorphism iso, Classified.Isomorphism (presentation p))))))
  };
