\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Projection[X := X, n := p.dimension, baseSpace := baseSpace, P := p.projection, regular := p.regular].Pullback[Y := Y, source := source, f := f, regularBase := regularBase] \as Comparison;
\definition presentation: Target.Presentation := Target.Presentation { dimension := p.dimension, projection := \fun (y: Y) => p.projection (f y), regular := Comparison.composedRegular };
\definition pulledBundle: Bundles.Family[X := Y, F := \fun (y: Y) => Fiber p (f y)].Bundle := Comparison.firstBundle;
\definition isomorphism: Bundles.Isomorphisms[X := Y, F := \fun (y: Y) => Fiber p (f y), G := Target.Fiber presentation, source := pulledBundle, target := Target.bundle presentation].Isomorphism := Comparison.isomorphism;
