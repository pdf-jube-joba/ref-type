\import \parent.At[p := p] \as First;
\import \parent.At[p := q] \as Second;
\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].PulledIsomorphism[X := X, Y := Y, F := Fiber p, G := Fiber q, source := bundle p, target := bundle q, base := source, f := f, sourceRegular := regularBase, targetRegular := regularBase] \as Pull;
\definition middle[iso: Isomorphism p q]: Bundles.Isomorphisms[X := Y, F := Target.Fiber (presentation p), G := \fun (y: Y) => Fiber q (f y), source := Target.bundle (presentation p), target := Second.pulledBundle].Isomorphism :=
  Operations.IsomorphismComposition[X := Y, F := Target.Fiber (presentation p), G := \fun (y: Y) => Fiber p (f y), H := \fun (y: Y) => Fiber q (f y), source := Target.bundle (presentation p), middle := First.pulledBundle, target := Second.pulledBundle].compose
    (Bundles.Isomorphisms[X := Y, F := \fun (y: Y) => Fiber p (f y), G := Target.Fiber (presentation p), source := First.pulledBundle, target := Target.bundle (presentation p)].inverse First.isomorphism) (Pull.isomorphism iso);
\definition isomorphism[iso: Isomorphism p q]: Target.Isomorphism (presentation p) (presentation q) :=
  Operations.IsomorphismComposition[X := Y, F := Target.Fiber (presentation p), G := \fun (y: Y) => Fiber q (f y), H := Target.Fiber (presentation q), source := Target.bundle (presentation p), middle := Second.pulledBundle, target := Target.bundle (presentation q)].compose (middle iso) Second.isomorphism;
