\import Original.FromEmbedding[embedding := embedding].Image[] \as Image;
\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Representations[X := X, baseSpace := original.baseSpace] \as AtOriginal;
\import AtOriginal.Representing[F := F, original := original] \as OriginalData;
\import \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Representations[X := X, baseSpace := baseSpace].Representing[F := F, original := original] \as Data;
\definition originalRepresentative: OriginalData.Representative := OriginalData.Representative {
  presentation := AtOriginal.Presentation { dimension := embedding.dimension, projection := Image.projection, regular := Image.regular },
  isomorphism := Image.isomorphism
};
\definition representative: Data.Representative := \idelim original.baseSpace = baseSpace \with t: topology.Topology[Carrier := X].Topology =>
  \root.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Representations[X := X, baseSpace := t].Representing[F := F, original := original].Representative
  \by { base: originalRepresentative, equality: same };
\definition presentation: Presentation := representative.presentation;
\definition isomorphism: Isomorphism presentation := representative.isomorphism;
