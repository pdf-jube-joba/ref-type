\import Spaces.Linear[V := V, W := Vector n, source := space, target := coordinates n].Composition[U := Vector k, domain := coordinates k] \as Compose;
\definition A: Spaces.Linear[V := Vector k, W := Vector n, source := coordinates k, target := coordinates n].Map := Compose.compose f frame.backward;
\definition injection: \forall (v, w: Vector k) -> A.apply v = A.apply w -> v = w :=
  \fun (v, w: Vector k)(same: _) => trans!{{Vector k}} _ _ _ (sym!{{Vector k}} _ _ (frame.rightInverse v))
    (trans!{{Vector k}} _ _ _ (congr!{V {Vector k}} frame.forward.apply _ _ (injective (frame.backward.apply v) (frame.backward.apply w) same)) (frame.rightInverse w));
\module Using(factor: Inner.Gram[k := k].Factorization[A]);
\definition exists: \exists Candidate := \block {
  \takefrom factor: Inner.Gram[k := k].Factorization[A] \by Inner.Algorithm[].exists k A injection E.positive \then
  \return \exact(Using[factor := factor].candidate, Candidate)
};
