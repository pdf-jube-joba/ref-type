\import Inner.Gram[k := k].Of[A := A x, factor := factors.value x] \as Gram;
\definition coordinate: Spaces.Linear[V := Vector n, W := Vector k, source := E.space, target := Source.space].Map := Gram.coordinates;
\definition inverse: Spaces.Linear[V := Vector n, W := Vector k, source := E.space, target := Source.space].Map := Gram.inverse;
\definition changeFormula: \forall (v: Vector k) -> coordinate.apply ((A x).apply v) = (factors.value x).change.forward.apply v :=
  \fun (v: Vector k) => trans!{{Vector k}} _ _ _ (congr!{{Vector n} {Vector k}} coordinate.apply _ _ ((factors.value x).formula v)) (Gram.leftInverse ((factors.value x).change.forward.apply v));
\definition leftInverse: \forall (v: Vector k) -> inverse.apply ((A x).apply v) = v := Gram.inverseOnImage;
\definition reconstruction: \forall (v: Vector n) -> (A x).apply (inverse.apply v) = Gram.projection.apply v := \fun (v: Vector n) => Gram.frameFormula (Gram.coordinates.apply v);
