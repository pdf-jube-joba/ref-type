\definition k: N.Nat^ := previous.rank;
\definition w: Vector n := P.map.apply (E.basis head);
\definition Covered[rank: N.Nat^][frame: Orthonormal[rank]][i: Fin.Fin n]: \Prop := \exists ( v: Vector rank \where frame.value.apply v = P.map.apply (E.basis i) );
\definition coverage: \forall (rank: N.Nat^)(frame: Orthonormal[rank]) -> Covered rank frame head -> (\forall (i: Fin.Fin n) -> Members.Occurs i tail -> Covered rank frame i) -> \forall (i: Fin.Fin n) -> Members.Occurs i (Lists.List[Fin.Fin n]::cons head tail) -> Covered rank frame i :=
  \fun (rank: N.Nat^)(frame: Orthonormal[rank])(atHead: _)(atTail: _)(i: Fin.Fin n)(member: _) => either!{member {Covered rank frame i}
    {\fun (same: i = head) => \idelim head = i \with j: Fin.Fin n => Covered rank frame j \by { base: atHead, equality: sym!{{Fin.Fin n}} i head same }}
    {\fun (old: _) => atTail i old}};
\module Old(inside: \In[Vector n] (image k previous.frame) w);
\module New(outside: Logic.Not (\In[Vector n] (image k previous.frame) w));
\definition exists: \exists Result[Lists.List[Fin.Fin n]::cons head tail] :=
  either!{{(Classical.excludedMiddle (\In[Vector n] (image k previous.frame) w))} {\exists Result[Lists.List[Fin.Fin n]::cons head tail]}
    {\fun (inside: _) => \exact(Old[inside := inside].result, Result[Lists.List[Fin.Fin n]::cons head tail])}
    {\fun (outside: _) => \exact(New[outside := outside].result, Result[Lists.List[Fin.Fin n]::cons head tail])}};
