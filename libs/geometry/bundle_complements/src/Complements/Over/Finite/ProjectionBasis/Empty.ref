\definition zero: N.Nat^ := N.Nat^::zero;
\import Spaces.Linear[V := Vector zero, W := Vector n, source := coordinates zero, target := coordinates n].Operations[] \as Maps;
\definition frame: Orthonormal[zero] := Orthonormal[zero] {
  value := Maps.zeroMap,
  isometry := \fun (v, w: Vector zero) => E.form.zeroRight E.space.zero
};
\definition result: Result[Lists.List[Fin.Fin n]::nil] := Result[Lists.List[Fin.Fin n]::nil] {
  rank := zero, frame := frame,
  fixed := \fun (v: Vector zero) => P.map.preservesZero,
  covers := \fun (i: Fin.Fin n)(absent: Logic.False) => Logic.falseElim (\exists ( v: Vector zero \where frame.value.apply v = P.map.apply (E.basis i) )) absent
};
