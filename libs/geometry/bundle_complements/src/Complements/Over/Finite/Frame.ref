\import Operations.IdentityFrame[n := k] \as Identity;
\definition factor: Inner.Gram[k := k].Factorization[frame.value] := Inner.Gram[k := k].Factorization[frame.value] {
  frame := frame.value, isometry := frame.isometry, change := Identity.isomorphism,
  formula := \fun (v: Vector k) => \refl(frame.value.apply v)
};
\import Inner.Gram[k := k].Of[A := frame.value, factor := factor] \as Gram;
\definition coordinate: Spaces.Linear[V := Vector n, W := Vector k, source := coordinates n, target := coordinates k].Map := Gram.coordinates;
\definition leftInverse: \forall (v: Vector k) -> coordinate.apply (frame.value.apply v) = v := Gram.leftInverse;
\definition projection: Hermitian.At[n := n].Projection := Hermitian.At[n := n].Projection { map := Gram.projection, selfAdjoint := Gram.selfAdjoint, idempotent := Gram.idempotent };
\definition basis: Hermitian.At[n := n].OnProjection[P := projection].Rank[k := k].Basis := Hermitian.At[n := n].OnProjection[P := projection].Rank[k := k].Basis {
  value := frame.value, coordinate := coordinate, leftInverse := leftInverse, reconstruction := \fun (v: Vector n) => \refl(Gram.projection.apply v)
};
\definition adjoint: \forall (v: Vector k)(w: Vector n) -> E.dot (frame.value.apply v) w = Geometry.Finite[n := k].dot v (coordinate.apply w) := Gram.adjoint;
