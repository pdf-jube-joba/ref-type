\import Hermitian.At[n := n].Families[X := Y].Matrix[m := n] \as Maps;
\import topological_algebra.Coordinates[K := K, I := Fin.Fin n] \as Coordinates;
\definition components: Maps.Components source (\fun (y: Y) => M (f y)) :=
  \fun (j, i: Fin.Fin n) => topology.Composition[A := Y, B := X, C := K].composeContinuous source baseSpace scalar.topological.space f
    (\fun (x: X) => (M x).apply (Geometry.Finite[n := n].basis j) i) baseRegular (regular (Geometry.Finite[n := n].basis j) i);
\definition vector: Hermitian.At[n := n].Families[X := Y].Continuous source v :=
  \fun (i: Fin.Fin n) => topology.Composition[A := Y, B := Vector n, C := K].composeContinuous source (coordinateTopology n) scalar.topological.space v
    (\fun (w: Vector n) => w i) vectorRegular (Coordinates.evaluationContinuous scalar.topological.space i);
\definition continuous: topology.Continuity[A := Y, B := Vector n].Continuous source (coordinateTopology n) (\fun (y: Y) => (M (f y)).apply (v y)) :=
  Coordinates.Universal[A := Y].continuous source scalar.topological.space _ (Maps.evaluate source (\fun (y: Y) => M (f y)) v components vector);
