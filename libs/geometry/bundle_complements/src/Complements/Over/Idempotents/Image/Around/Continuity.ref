\import Native.Families[X := X] \as Families;
\definition complementRegular: Families.Matrix[m := n].Regular baseSpace (\fun (x: X) => (complement x).map) :=
  \fun (v: Vector n) => Families.addition baseSpace (\fun (x: X) => v) (\fun (x: X) => Euclidean.space.neg ((P x).map.apply v)) (Families.constant baseSpace v)
    (Families.negative baseSpace (\fun (x: X) => (P x).map.apply v) (regular v));
\definition hRegular: Families.Matrix[m := n].Regular baseSpace h :=
  \fun (v: Vector n) => Families.addition baseSpace (\fun (x: X) => (P x).map.apply ((P a).map.apply v)) (\fun (x: X) => (complement x).map.apply ((complement a).map.apply v))
    (regular ((P a).map.apply v)) (complementRegular ((complement a).map.apply v));
\definition entriesRegular: Native.Square[].Families[X := X].Regular baseSpace entries :=
  \fun (i, j: Fin.Fin n) => hRegular (Euclidean.basis j) i;
