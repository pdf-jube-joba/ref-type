\definition total[base: Y -> X][vector: Y -> Vector n][y: Y]: Family.Point := Family.include (base y) (vector y);
\definition pair[base: Y -> X][vector: Y -> Vector n][y: Y]: Product.CarrierSet := Pair.pair X (Vector n) (base y) (vector y);
\definition continuous: \forall (base: Y -> X)(vector: Y -> Vector n) -> topology.Continuity[A := Y, B := X].Continuous source baseSpace base -> topology.Continuity[A := Y, B := Vector n].Continuous source (coordinateTopology n) vector -> topology.Continuity[A := Y, B := Family.Point].Continuous source Trivial.topology (total base vector) :=
  \fun (base: _)(vector: _)(baseRegular: _)(vectorRegular: _) => topology.Composition[A := Y, B := Product.CarrierSet, C := Family.Point].composeContinuous source (Product.topology baseSpace (coordinateTopology n)) Trivial.topology (pair base vector) Trivial.backward
    (Product.Universal[X := Y].pairContinuous source baseSpace (coordinateTopology n) base vector baseRegular vectorRegular) Trivial.backwardContinuous;
