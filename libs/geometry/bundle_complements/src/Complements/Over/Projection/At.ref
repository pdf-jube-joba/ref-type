\import Spaces.Subspace[V := Vector n, space := coordinates n] \as Subspaces;
\definition subspace: Subspaces.Subspace := Subspaces.Subspace {
  carrier := Image x,
  containsZero := (P x).map.preservesZero,
  closedAdd := \fun (v, w: Vector n)(fixedV: _)(fixedW: _) => trans!{{Vector n}} _ _ _ ((P x).map.preservesAdd v w)
    (congr!{{Vector n} {Vector n} {Vector n}} (coordinates n).add _ _ _ _ fixedV fixedW),
  closedScale := \fun (a: K)(v: Vector n)(fixed: _) => trans!{{Vector n}} _ _ _ ((P x).map.preservesScale a v)
    (congr!{{Vector n} {Vector n}} ((coordinates n).smul a) _ _ fixed)
};
\definition space: Spaces.VectorSpace (Fiber x) := Subspaces.Of[subspace := subspace].induced;
\definition include: Spaces.Linear[V := Fiber x, W := Vector n, source := space, target := coordinates n].Map := Subspaces.Of[subspace := subspace].inclusion;
\definition project: Spaces.Linear[V := Vector n, W := Fiber x, source := coordinates n, target := space].Map := Spaces.Linear[V := Vector n, W := Fiber x, source := coordinates n, target := space].Map {
  apply := \fun (v: Vector n) => \into[Vector n]((P x).map.apply v, Image x) \by { (P x).idempotent v },
  preservesAdd := (P x).map.preservesAdd,
  preservesScale := (P x).map.preservesScale
};
