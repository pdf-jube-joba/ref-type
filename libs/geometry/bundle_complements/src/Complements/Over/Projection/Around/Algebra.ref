\definition centerValue: \forall (v: Vector n) -> (h a).apply v = v :=
  \fun (v: Vector n) => trans!{{Vector n}} _ _ _
    (congr!{{Vector n} {Vector n} {Vector n}} (coordinates n).add _ _ _ _ ((P a).idempotent v) ((complement a).idempotent v)) (Center.splitting v);
\definition leftValue: \forall (x: X)(v: Vector n) -> (P x).map.apply ((h x).apply v) = (P x).map.apply ((P a).map.apply v) :=
  \fun (x: X)(v: Vector n) => trans!{{Vector n}} _ _ _ ((P x).map.preservesAdd ((P x).map.apply ((P a).map.apply v)) ((complement x).map.apply ((complement a).map.apply v)))
    (trans!{{Vector n}} _ _ _ (congr!{{Vector n} {Vector n} {Vector n}} (coordinates n).add _ _ _ _
      ((P x).idempotent ((P a).map.apply v)) (Native.OnProjection[P := P x].annihilates ((complement a).map.apply v)))
      (Laws.zeroRight ((P x).map.apply ((P a).map.apply v))));
\definition rightValue: \forall (x: X)(v: Vector n) -> (h x).apply ((P a).map.apply v) = (P x).map.apply ((P a).map.apply v) :=
  \fun (x: X)(v: Vector n) => trans!{{Vector n}} _ _ _
    (congr!{{Vector n} {Vector n} {Vector n}} (coordinates n).add _ _ _ _
      (congr!{{Vector n} {Vector n}} (P x).map.apply _ _ ((P a).idempotent v))
      (trans!{{Vector n}} _ _ _ (congr!{{Vector n} {Vector n}} (complement x).map.apply _ _ (Center.annihilatesRight v)) (complement x).map.preservesZero))
    (Laws.zeroRight ((P x).map.apply ((P a).map.apply v)));
\definition intertwines: \forall (x: X)(v: Vector n) -> (P x).map.apply ((h x).apply v) = (h x).apply ((P a).map.apply v) :=
  \fun (x: X)(v: Vector n) => trans!{{Vector n}} _ _ _ (leftValue x v) (sym!{{Vector n}} _ _ (rightValue x v));
