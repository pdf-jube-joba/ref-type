\import Native.Square[].Families[X := Carrier] \as InversionFamilies;
\definition matrixRegular: InversionFamilies.Regular localSpace (\fun (x: Carrier) => matrix x) :=
  \fun (i, j: Fin.Fin n) => topology.Continuity[A := X, B := K].Restriction[S := domain].restrictContinuous baseSpace scalar.topological.space
    (\fun (x: X) => entries x i j) (entriesContinuous i j);
\definition inverseRegular: Native.Families[X := Carrier].Matrix[m := n].Regular localSpace inverse := InversionFamilies.inverseMaps localSpace matrix matrixRegular;
\definition forwardRegular: Native.Families[X := Carrier].Matrix[m := k].Regular localSpace forward :=
  \fun (v: Vector k)(i: Fin.Fin n) => topology.Continuity[A := X, B := K].Restriction[S := domain].restrictContinuous baseSpace scalar.topological.space
    (\fun (x: X) => (h x).apply (center.basis.value.apply v) i) (hContinuous (center.basis.value.apply v) i);
\import Hermitian.At[n := k].Families[X := Carrier].Matrix[m := n] \as Small;
\definition backwardRegular: Small.Regular localSpace backward :=
  \fun (v: Vector n) => Small.evaluate localSpace (\fun (x: Carrier) => center.basis.coordinate) (\fun (x: Carrier) => (inverse x).apply v)
    (\fun (j: Fin.Fin n) => Small.constant localSpace center.basis.coordinate (Euclidean.basis j)) (inverseRegular v);
