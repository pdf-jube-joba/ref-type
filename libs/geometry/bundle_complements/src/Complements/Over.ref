\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Bundles;
\import bundle_operations.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Operations;
\import linear_algebra.Commutative[K := K, scalarRing := Fields.fieldAsCommutativeRing K field] \as Spaces;
\import linear_algebra.Hermitian[].Over[K := K, field := field, scalar := conjugation] \as Geometry;
\import hermitian_frames.Hermitian[].Over[K := K, field := field, scalar := conjugation, topological := scalar.topological] \as Hermitian;
\import real.Analysis[] \as R;
\definition Vector[n: N.Nat^]: \Set := Bundles.Vector n;
\definition coordinates[n: N.Nat^]: Spaces.VectorSpace (Vector n) := Bundles.coordinates n;
\definition coordinateTopology[n: N.Nat^]: topology.Topology[Carrier := Vector n].Topology := Bundles.coordinateTopology n;
\module TrivialMaps(X: \Set, n: N.Nat^, baseSpace: topology.Topology[Carrier := X].Topology);
\module For(X: \Set, F: X -> \Set, bundle: vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Family[X := X, F := F].Bundle);
\module Finite(n: N.Nat^);
\module Projection(X: \Set, n: N.Nat^, baseSpace: topology.Topology[Carrier := X].Topology, P: X -> hermitian_frames.Hermitian[].Over[K := K, field := field, scalar := conjugation, topological := scalar.topological].At[n := n].Projection, regular: hermitian_frames.Hermitian[].Over[K := K, field := field, scalar := conjugation, topological := scalar.topological].At[n := n].Families[X := X].Matrix[m := n].Regular baseSpace (\fun (x: X) => (P x).map));
