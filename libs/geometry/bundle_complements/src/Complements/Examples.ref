\import real.Analysis[] \as R;
\import complex.Complex[] \as C;
\import std.Data[].Bool[] \as Bool;
\import \root.Complements[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as RealComplements;
\import \root.Complements[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as ComplexComplements;
\import RealComplements.Examples[] \as Real;
\import ComplexComplements.Examples[] \as Complex;
\import vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].TwoRanks[n := Real.zero, m := Real.one] \as RealMixed;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].TwoRanks[n := Complex.zero, m := Complex.one] \as ComplexMixed;
\import RealComplements.For[X := Bool.Bool^, F := RealMixed.Fiber, bundle := RealMixed.bundle] \as RealFor;
\import ComplexComplements.For[X := Bool.Bool^, F := ComplexMixed.Fiber, bundle := ComplexMixed.bundle] \as ComplexFor;
\definition realMovingClass: Real.Moving[].small.dimension = Real.one := Real.Moving[].smallDimension;
\definition complexMovingClass: Complex.Moving[].large.dimension = Complex.two := Complex.Moving[].largeDimension;
\definition realFiniteMetric: \exists RealFor.Metric := Real.FiniteBases[].mixedMetric;
\definition complexFiniteMetric: \exists ComplexFor.Metric := Complex.FiniteBases[].mixedMetric;
\definition complexFiniteClass: ComplexComplements.Representations[X := Bool.Bool^, baseSpace := topology.Topology[Carrier := Bool.Bool^].Discrete].Classes := Complex.FiniteBases[].mixedClass;
