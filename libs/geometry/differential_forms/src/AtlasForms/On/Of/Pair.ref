\import Charts.Transition[left := left, right := right] \as Transition;
\import Global.Pair[left := globalChart left, right := globalChart right] \as GlobalPair;
\definition transition: calculus.Maps[n := n, m := n].Map Transition.domain right.image := GlobalPair.transition;
\definition included: Open.Included Transition.domain left.image := GlobalPair.included;
\import Euclidean.Restriction[U := Transition.domain, V := left.image] \as Restriction;
\import Euclidean.Pullback[m := n, U := Transition.domain, V := right.image, f := transition] \as Pullback;
\definition restrict(k: N.Nat^)(omega: Family k): Euclidean.LocalForm Transition.domain k := Restriction.apply k included (omega left);
\definition transport(k: N.Nat^)(omega: Family k): Euclidean.LocalForm Transition.domain k := Pullback.apply k (omega right);
\definition Agreement(k: N.Nat^)(omega: Family k): \Prop := restrict k omega = transport k omega;
\module At(k: N.Nat^);
\module Differential(k: N.Nat^);
