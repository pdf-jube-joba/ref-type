\use std.Logic[].Equality[].eq_reason_in;
\definition cochainForward: Forward.Map := forward;
\definition cochainBackward: Backward.Map := backward;
\import Complexes.At[C := complex, k := k] \as Source;
\import Complexes.At[C := Global.DeRham[].complex, k := k] \as Target;
\import Forward.At[k := k] \as ForwardH;
\import Backward.At[k := k] \as BackwardH;
\import \parent.\parent.At[k := k] \as Forms;
\import Spaces.Linear[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace] \as ForwardMaps;
\import Spaces.Linear[V := Target.Cohomology, W := Source.Cohomology, source := Target.cohomologySpace, target := Source.cohomologySpace] \as BackwardMaps;
\definition forward: ForwardMaps.Map := ForwardMaps.Map {
  apply := (ForwardH.induced cochainForward).apply,
  preservesAdd := (ForwardH.induced cochainForward).addition,
  preservesScale := (ForwardH.induced cochainForward).scalar,
};
\definition backward: BackwardMaps.Map := BackwardMaps.Map {
  apply := (BackwardH.induced cochainBackward).apply,
  preservesAdd := (BackwardH.induced cochainBackward).addition,
  preservesScale := (BackwardH.induced cochainBackward).scalar,
};
\definition leftInverse: \forall (h: Source.Cohomology) -> backward.apply (forward.apply h) = h :=
  Source.classInduction (\fun (h: Source.Cohomology) => backward.apply (forward.apply h) = h)
    (\fun (omega: Source.CycleCarrier) => eq_reason_in!{{Source.Cohomology} _
      "=" { backward.apply (Target.classOf ((ForwardH.cyclesMap cochainForward).apply omega)) } "by" { congr!{{Target.Cohomology} {Source.Cohomology}} (backward.apply) _ _ (ForwardH.onClass cochainForward omega) }
      "=" { Source.classOf ((BackwardH.cyclesMap cochainBackward).apply ((ForwardH.cyclesMap cochainForward).apply omega)) } "by" { BackwardH.onClass cochainBackward ((ForwardH.cyclesMap cochainForward).apply omega) }
      "=" _ "by" { congr!{{Source.CycleCarrier} {Source.Cohomology}} Source.classOf
          ((BackwardH.cyclesMap cochainBackward).apply ((ForwardH.cyclesMap cochainForward).apply omega))
          omega (Forms.leftInverse omega) }
    });
\definition rightInverse: \forall (h: Target.Cohomology) -> forward.apply (backward.apply h) = h :=
  Target.classInduction (\fun (h: Target.Cohomology) => forward.apply (backward.apply h) = h)
    (\fun (omega: Target.CycleCarrier) => eq_reason_in!{{Target.Cohomology} _
      "=" { forward.apply (Source.classOf ((BackwardH.cyclesMap cochainBackward).apply omega)) } "by" { congr!{{Source.Cohomology} {Target.Cohomology}} (forward.apply) _ _ (BackwardH.onClass cochainBackward omega) }
      "=" { Target.classOf ((ForwardH.cyclesMap cochainForward).apply ((BackwardH.cyclesMap cochainBackward).apply omega)) } "by" { ForwardH.onClass cochainForward ((BackwardH.cyclesMap cochainBackward).apply omega) }
      "=" _ "by" { congr!{{Target.CycleCarrier} {Target.Cohomology}} Target.classOf
          ((ForwardH.cyclesMap cochainForward).apply ((BackwardH.cyclesMap cochainBackward).apply omega))
          omega (Forms.rightInverse omega) }
    });
\import Spaces.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace] \as Isomorphism;
\definition isomorphism: Isomorphism.Isomorphism := Isomorphism.Isomorphism {
  forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
};
