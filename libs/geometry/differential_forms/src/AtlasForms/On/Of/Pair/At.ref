\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.FamilySpace[k := k] \as Families;
\import Euclidean.On[U := Transition.domain].At[k := k] \as Target;
\import Spaces.Linear[V := Family k, W := Euclidean.LocalForm Transition.domain k, source := Families.space, target := Target.space] \as Linear;
\definition restriction: Linear.Map := Linear.Map {
  apply := restrict k,
  preservesAdd := \fun (omega, eta: Family k) => (Restriction.At[k := k].map included).preservesAdd (omega left) (eta left),
  preservesScale := \fun (a: Reals.Real)(omega: Family k) => (Restriction.At[k := k].map included).preservesScale a (omega left),
};
\definition pullback: Linear.Map := Linear.Map {
  apply := transport k,
  preservesAdd := \fun (omega, eta: Family k) => Pullback.At[k := k].addition (omega right) (eta right),
  preservesScale := \fun (a: Reals.Real)(omega: Family k) => Pullback.At[k := k].scalar a (omega right),
};
\definition zero: Agreement k Families.zero :=
  trans!{{Euclidean.LocalForm Transition.domain k}} (restrict k Families.zero) Target.zero (transport k Families.zero)
    restriction.preservesZero (sym!{{Euclidean.LocalForm Transition.domain k}} (transport k Families.zero) Target.zero pullback.preservesZero);
\definition addition: \forall (omega, eta: Family k) -> Agreement k omega -> Agreement k eta -> Agreement k (Families.plus omega eta) :=
  \fun (omega, eta: Family k)(first: Agreement k omega)(second: Agreement k eta) => eq_reason_in!{{Euclidean.LocalForm Transition.domain k} { restrict k (Families.plus omega eta) }
    "=" { Target.plus (restrict k omega) (restrict k eta) } "by" { restriction.preservesAdd omega eta }
    "=" { Target.plus (transport k omega) (transport k eta) } "by" { congr!{{Euclidean.LocalForm Transition.domain k} {Euclidean.LocalForm Transition.domain k} {Euclidean.LocalForm Transition.domain k}} Target.plus
        (restrict k omega) (transport k omega) (restrict k eta) (transport k eta) first second }
    "=" { transport k (Families.plus omega eta) } "by" { sym!{{Euclidean.LocalForm Transition.domain k}} (transport k (Families.plus omega eta)) (Target.plus (transport k omega) (transport k eta)) (pullback.preservesAdd omega eta) }
  };
\definition scalar: \forall (a: Reals.Real)(omega: Family k) -> Agreement k omega -> Agreement k (Families.scale a omega) :=
  \fun (a: Reals.Real)(omega: Family k)(equal: Agreement k omega) => eq_reason_in!{{Euclidean.LocalForm Transition.domain k} { restrict k (Families.scale a omega) }
    "=" { Target.scale a (restrict k omega) } "by" { restriction.preservesScale a omega }
    "=" { Target.scale a (transport k omega) } "by" { congr!{{Euclidean.LocalForm Transition.domain k} {Euclidean.LocalForm Transition.domain k}} (Target.scale a) (restrict k omega) (transport k omega) equal }
    "=" { transport k (Families.scale a omega) } "by" { sym!{{Euclidean.LocalForm Transition.domain k}} (transport k (Families.scale a omega)) (Target.scale a (transport k omega)) (pullback.preservesScale a omega) }
  };
