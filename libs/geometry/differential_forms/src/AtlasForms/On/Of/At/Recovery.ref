\use std.Logic[].Equality[].eq_reason_in;
\import Pointwise.Coordinates[chart := globalChart chart] \as Coordinates;
\import Charts.Of[chart := chart] \as Geometry;
\definition smallPoint[p: Charts.LocalPoint chart]: \parent.Point[x := p].LocalChart :=
  \into[Tangent.At[x := p].Chart](Coordinates.lift p, \parent.Point[x := p].LocalChart) \by { member chart };
\definition recover: \forall (omega: Form k) -> Coordinates.family (value omega) = omega chart :=
  \fun (omega: Form k) => \axiom:funext(Coordinates.family (value omega), omega chart,
    \fun (a: Open.Carrier chart.image) => trans!{{Multilinear.Alternating[].Form k}} _ _ _
      (\parent.Point[x := Charts.point chart a].recover omega (smallPoint (Charts.point chart a)))
      (congr!{{Open.Carrier chart.image} {Multilinear.Alternating[].Form k}} (omega chart) _ _ (Geometry.coordinatePoint a)));
\definition law: \forall (omega: Form k) -> restrict (extend omega) chart = omega chart :=
  \fun (omega: Form k) => eq_reason_in!{{Euclidean.On[U := chart.image].Family k} _
    "=" { Coordinates.family (Pointwise.value (extend omega)) } "by" { sym!{{Euclidean.On[U := chart.image].Family k}} _ _ (Coordinates.recover (extend omega)) }
    "=" { Coordinates.family (value omega) } "by" { congr!{{Global.PointFamily k} {Euclidean.On[U := chart.image].Family k}} Coordinates.family _ _ (evaluation omega) }
    "=" _ "by" { recover omega }
  };
