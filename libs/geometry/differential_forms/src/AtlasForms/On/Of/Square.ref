
\definition next: N.Nat^ := N.Nat^::succ k;
\definition twice: N.Nat^ := N.Nat^::succ next;
\import \parent.ExteriorDerivative[k := k] \as First;
\import \parent.ExteriorDerivative[k := next] \as Second;
\import \parent.At[k := twice] \as Result;
\definition law: \forall (omega: Form k) -> Second.apply (First.apply omega) = Result.zero :=
  \fun (omega: Form k) => ext twice (Second.apply (First.apply omega)) Result.zero
    (\fun (chart: Chart) => Euclidean.On[U := #image{chart}].Square[k := k].law (omega chart));
