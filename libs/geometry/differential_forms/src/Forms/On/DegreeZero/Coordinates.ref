
\import Charts.Of[chart := chart] \as Geometry;
\import Euclidean.On[U := chart.image].DegreeZero[] \as Local;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\import Spaces.Multilinear[V := Vectors.Vector, space := Vectors.space].Alternating[].DegreeZero[] \as Scalars;
\module At(a: Open.Carrier chart.image);
\definition law: \forall (omega: Form zero)(a: Open.Carrier chart.image) -> value omega (Charts.point chart a) = Local.function (omega chart) a :=
  \fun (omega: Form zero)(a: Open.Carrier chart.image) => At[a := a].law omega;

\definition localFunction[omega: Form zero]: Open.ScalarFunction chart.image :=
  \fun (a: Open.Carrier chart.image) => Local.function (omega chart) a;
\definition globalFunction[omega: Form zero]: Open.ScalarFunction chart.image :=
  \fun (a: Open.Carrier chart.image) => value omega (Charts.point chart a);
\definition regular: \forall (omega: Form zero) -> Open.Smooth[].SmoothOn chart.image (globalFunction omega) :=
  \fun (omega: Form zero) => Euclidean.On[U := chart.image].smoothOfEqual
    (localFunction omega) (globalFunction omega)
    (\fun (a: Open.Carrier chart.image) => sym!{{Reals.Real}}
      (globalFunction omega a) (localFunction omega a) (law omega a))
    (\bysub(Open.ScalarFunction chart.image,
      { h: Open.ScalarFunction chart.image \where Open.Smooth[].SmoothOn chart.image h }, Local.function (omega chart)));
