
\import Charts.Of[chart := chart] \as Geometry;
\import Euclidean.On[U := #image{chart}].DegreeZero[] \as Local;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\import Spaces.Multilinear[V := Vectors.Vector, space := Vectors.space].Alternating[].DegreeZero[] \as Scalars;
\module At(a: Open.Carrier #image{chart});
\definition law: \forall (omega: Form zero)(a: Open.Carrier #image{chart}) -> value omega (Charts.point chart a) = Local.function (omega chart) a :=
  \fun (omega: Form zero)(a: Open.Carrier #image{chart}) => At[a := a].law omega;

\definition localFunction(omega: Form zero): Open.ScalarFunction #image{chart} :=
  \fun (a: Open.Carrier #image{chart}) => Local.function (omega chart) a;
\definition globalFunction(omega: Form zero): Open.ScalarFunction #image{chart} :=
  \fun (a: Open.Carrier #image{chart}) => value omega (Charts.point chart a);
\definition regular: \forall (omega: Form zero) -> Open.Smooth[].SmoothOn #image{chart} (globalFunction omega) :=
  \fun (omega: Form zero) => Euclidean.On[U := #image{chart}].smoothOfEqual
    (localFunction omega) (globalFunction omega)
    (\fun (a: Open.Carrier #image{chart}) => sym!{{Reals.Real}}
      (globalFunction omega a) (localFunction omega a) (law omega a))
    (\bysub(Open.ScalarFunction #image{chart},
      { h: Open.ScalarFunction #image{chart} \where Open.Smooth[].SmoothOn #image{chart} h }, Local.function (omega chart)));
