
\definition x: M.Point := Charts.point chart a;
\import Tangent.At[x := x] \as Tangent;
\import Points.At[x := x] \as Point;
\import Spaces.Multilinear[V := Tangent.Vector, space := Tangent.space].Alternating[].DegreeZero[] \as TangentScalars;
\definition lifted: Tangent.Chart := Points.Coordinates[chart := chart].lift (Charts.point chart a);
\definition arguments: Fin.Fin zero -> Vectors.Vector := \fun (slot: Fin.Fin zero) => Tangent.Coordinate[chart := lifted].decode (TangentScalars.emptyArguments slot);
\definition law: \forall (omega: Form zero) -> value omega x = Local.function (omega chart) a :=
  \fun (omega: Form zero) => eq_reason!{
    {value omega x}
    "=" {omega chart (Charts.coordinate chart (Charts.point chart a)) arguments} "by" {
      congr!{{PointForm zero x} {Reals.Real}} (\fun (f: PointForm zero x) => f TangentScalars.emptyArguments)
        (Points.value omega x) (Point.ofChart omega lifted) (Point.inChart omega lifted)}
    "=" {omega chart a arguments} "by" {
      congr!{{Open.Carrier #image{chart}} {Reals.Real}} (\fun (p: Open.Carrier #image{chart}) => omega chart p arguments)
        (Charts.coordinate chart (Charts.point chart a)) a (Geometry.coordinatePoint a)}
    "=" {Local.function (omega chart) a} "by" {
      congr!{{Fin.Fin zero -> Vectors.Vector} {Reals.Real}} (omega chart a) arguments Scalars.emptyArguments (Scalars.argumentsUnique arguments)}
  };
