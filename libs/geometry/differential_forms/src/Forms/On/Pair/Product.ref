\use std.Logic[].Equality[].eq_reason_in;
\import Euclidean.On[U := Transition.domain].Wedge[p := p, q := q] \as Product;
\import Euclidean.On[U := left.image].Wedge[p := p, q := q] \as Left;
\import Euclidean.On[U := right.image].Wedge[p := p, q := q] \as Right;
\definition family[omega: Family p][eta: Family q]: Family (Nat.add p q) :=
  \fun (chart: Chart) => Euclidean.On[U := chart.image].Wedge[p := p, q := q].apply (omega chart) (eta chart);
\definition law: \forall (omega: Family p)(eta: Family q) -> Agreement p omega -> Agreement q eta -> Agreement (Nat.add p q) (family omega eta) :=
  \fun (omega: Family p)(eta: Family q)(first: Agreement p omega)(second: Agreement q eta) =>
    eq_reason_in!{{Euclidean.LocalForm Transition.domain (Nat.add p q)} _
      "=" _ "by" { Restriction.Product[p := p, q := q].law included (omega left) (eta left) }
      "=" _ "by" { congr!{{Euclidean.LocalForm Transition.domain p} {Euclidean.LocalForm Transition.domain q} {Euclidean.LocalForm Transition.domain (Nat.add p q)}} Product.apply
          (restrict p omega) (transport p omega) (restrict q eta) (transport q eta) first second }
      "=" _ "by" { sym!{{Euclidean.LocalForm Transition.domain (Nat.add p q)}} _ _ (Pullback.Product[p := p, q := q].law (omega right) (eta right)) }
    };
