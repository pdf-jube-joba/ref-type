\import \parent.\parent.Above[k := k] \as Forms;
\import N.Basic[].Prop[] \as Naturals;
\import Complexes.At[C := complex, k := k] \as H;
\definition exact: \forall (large: Naturals.Lt n k)(omega: Form k) -> Exact k omega :=
  \fun (large: Naturals.Lt n k)(omega: Form k) =>
    \idelim #zero{(space k)} = omega \with phi: Form k => Exact k phi \by {
      base: H.boundaryZero k,
      equality: sym!{{Form k}} omega (#zero{(space k)}) (Forms.zero large omega)
    };
\definition zero: \forall (large: Naturals.Lt n k)(h: H.Cohomology) -> h = H.zeroClass :=
  \fun (large: Naturals.Lt n k) => H.classInduction (\fun (h: H.Cohomology) => h = H.zeroClass)
    (\fun (omega: H.CycleCarrier) => H.boundaryClassZero omega (exact large omega));
