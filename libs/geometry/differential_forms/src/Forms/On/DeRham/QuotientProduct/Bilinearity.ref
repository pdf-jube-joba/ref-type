\definition cycleAddLeft: \forall (omega, omega2: Left.CycleCarrier)(eta: Right.CycleCarrier) -> cycle (Left.cycleSpace.add omega omega2) eta = Result.cycleSpace.add (cycle omega eta) (cycle omega2 eta) :=
  \fun (omega, omega2: Left.CycleCarrier)(eta: Right.CycleCarrier) => Wedge.additiveLeft omega omega2 eta;

\definition cycleScaleLeft: \forall (a: Reals.Real)(omega: Left.CycleCarrier)(eta: Right.CycleCarrier) -> cycle (Left.cycleSpace.smul a omega) eta = Result.cycleSpace.smul a (cycle omega eta) :=
  \fun (a: Reals.Real)(omega: Left.CycleCarrier)(eta: Right.CycleCarrier) => Wedge.scalarLeft a omega eta;

\definition cycleAddRight: \forall (omega: Left.CycleCarrier)(eta, eta2: Right.CycleCarrier) -> cycle omega (Right.cycleSpace.add eta eta2) = Result.cycleSpace.add (cycle omega eta) (cycle omega eta2) :=
  \fun (omega: Left.CycleCarrier)(eta, eta2: Right.CycleCarrier) => Wedge.additiveRight omega eta eta2;

\definition cycleScaleRight: \forall (a: Reals.Real)(omega: Left.CycleCarrier)(eta: Right.CycleCarrier) -> cycle omega (Right.cycleSpace.smul a eta) = Result.cycleSpace.smul a (cycle omega eta) :=
  \fun (a: Reals.Real)(omega: Left.CycleCarrier)(eta: Right.CycleCarrier) => Wedge.scalarRight a omega eta;

\definition classAddLeft: \forall (omega, omega2: Left.CycleCarrier)(eta: Right.CycleCarrier) -> apply (Left.cohomologySpace.add (Left.classOf omega) (Left.classOf omega2)) (Right.classOf eta) = Result.cohomologySpace.add (apply (Left.classOf omega) (Right.classOf eta)) (apply (Left.classOf omega2) (Right.classOf eta)) :=
  \fun (omega, omega2: Left.CycleCarrier)(eta: Right.CycleCarrier) => eq_reason!{
    {apply (Left.cohomologySpace.add (Left.classOf omega) (Left.classOf omega2)) (Right.classOf eta)}
    "=" {apply (Left.classOf (Left.cycleSpace.add omega omega2)) (Right.classOf eta)} "by" {congr!{{Left.Cohomology} {Result.Cohomology}} (\fun (h: Left.Cohomology) => apply h (Right.classOf eta)) (Left.cohomologySpace.add (Left.classOf omega) (Left.classOf omega2)) (Left.classOf (Left.cycleSpace.add omega omega2)) (sym!{{Left.Cohomology}} (Left.classOf (Left.cycleSpace.add omega omega2)) (Left.cohomologySpace.add (Left.classOf omega) (Left.classOf omega2)) (Left.classLinear.addition omega omega2))}
    "=" {Result.classOf (cycle (Left.cycleSpace.add omega omega2) eta)} "by" {onClass (Left.cycleSpace.add omega omega2) eta}
    "=" {Result.classOf (Result.cycleSpace.add (cycle omega eta) (cycle omega2 eta))} "by" {congr!{{Result.CycleCarrier} {Result.Cohomology}} Result.classOf _ _ (cycleAddLeft omega omega2 eta)}
    "=" {Result.cohomologySpace.add (Result.classOf (cycle omega eta)) (Result.classOf (cycle omega2 eta))} "by" {Result.classLinear.addition (cycle omega eta) (cycle omega2 eta)}
    "=" {Result.cohomologySpace.add (apply (Left.classOf omega) (Right.classOf eta)) (apply (Left.classOf omega2) (Right.classOf eta))} "by" {congr!{{Result.Cohomology} {Result.Cohomology} {Result.Cohomology}} (Result.cohomologySpace.add) _ _ _ _ (sym!{{Result.Cohomology}} _ _ (onClass omega eta)) (sym!{{Result.Cohomology}} _ _ (onClass omega2 eta))}
  };

\definition additiveLeft: \forall (h, h2: Left.Cohomology)(g: Right.Cohomology) -> apply (Left.cohomologySpace.add h h2) g = Result.cohomologySpace.add (apply h g) (apply h2 g) :=
  Left.classInduction (\fun (h: Left.Cohomology) => \forall (h2: Left.Cohomology)(g: Right.Cohomology) -> apply (Left.cohomologySpace.add h h2) g = Result.cohomologySpace.add (apply h g) (apply h2 g))
  (\fun (omega: Left.CycleCarrier) => Left.classInduction
    (\fun (h2: Left.Cohomology) => \forall (g: Right.Cohomology) -> apply (Left.cohomologySpace.add (Left.classOf omega) h2) g = Result.cohomologySpace.add (apply (Left.classOf omega) g) (apply h2 g))
    (\fun (omega2: Left.CycleCarrier) => Right.classInduction
      (\fun (g: Right.Cohomology) => apply (Left.cohomologySpace.add (Left.classOf omega) (Left.classOf omega2)) g = Result.cohomologySpace.add (apply (Left.classOf omega) g) (apply (Left.classOf omega2) g))
      (\fun (eta: Right.CycleCarrier) => classAddLeft omega omega2 eta)));

\definition classScaleLeft: \forall (a: Reals.Real)(omega: Left.CycleCarrier)(eta: Right.CycleCarrier) -> apply (Left.cohomologySpace.smul a (Left.classOf omega)) (Right.classOf eta) = Result.cohomologySpace.smul a (apply (Left.classOf omega) (Right.classOf eta)) :=
  \fun (a: Reals.Real)(omega: Left.CycleCarrier)(eta: Right.CycleCarrier) => eq_reason!{
    {apply (Left.cohomologySpace.smul a (Left.classOf omega)) (Right.classOf eta)}
    "=" {apply (Left.classOf (Left.cycleSpace.smul a omega)) (Right.classOf eta)} "by" {congr!{{Left.Cohomology} {Result.Cohomology}} (\fun (h: Left.Cohomology) => apply h (Right.classOf eta)) _ _ (sym!{{Left.Cohomology}} _ _ (Left.classLinear.scalar a omega))}
    "=" {Result.classOf (cycle (Left.cycleSpace.smul a omega) eta)} "by" {onClass (Left.cycleSpace.smul a omega) eta}
    "=" {Result.classOf (Result.cycleSpace.smul a (cycle omega eta))} "by" {congr!{{Result.CycleCarrier} {Result.Cohomology}} Result.classOf _ _ (cycleScaleLeft a omega eta)}
    "=" {Result.cohomologySpace.smul a (Result.classOf (cycle omega eta))} "by" {Result.classLinear.scalar a (cycle omega eta)}
    "=" {Result.cohomologySpace.smul a (apply (Left.classOf omega) (Right.classOf eta))} "by" {congr!{{Result.Cohomology} {Result.Cohomology}} (Result.cohomologySpace.smul a) _ _ (sym!{{Result.Cohomology}} _ _ (onClass omega eta))}
  };

\definition scalarLeft: \forall (a: Reals.Real)(h: Left.Cohomology)(g: Right.Cohomology) -> apply (Left.cohomologySpace.smul a h) g = Result.cohomologySpace.smul a (apply h g) :=
  \fun (a: Reals.Real) => Left.classInduction
    (\fun (h: Left.Cohomology) => \forall (g: Right.Cohomology) -> apply (Left.cohomologySpace.smul a h) g = Result.cohomologySpace.smul a (apply h g))
    (\fun (omega: Left.CycleCarrier) => Right.classInduction
      (\fun (g: Right.Cohomology) => apply (Left.cohomologySpace.smul a (Left.classOf omega)) g = Result.cohomologySpace.smul a (apply (Left.classOf omega) g))
      (\fun (eta: Right.CycleCarrier) => classScaleLeft a omega eta));

\definition classAddRight: \forall (eta, eta2: Right.CycleCarrier)(omega: Left.CycleCarrier) -> apply (Left.classOf omega) (Right.cohomologySpace.add (Right.classOf eta) (Right.classOf eta2)) = Result.cohomologySpace.add (apply (Left.classOf omega) (Right.classOf eta)) (apply (Left.classOf omega) (Right.classOf eta2)) :=
  \fun (eta, eta2: Right.CycleCarrier)(omega: Left.CycleCarrier) => eq_reason!{
    {apply (Left.classOf omega) (Right.cohomologySpace.add (Right.classOf eta) (Right.classOf eta2))}
    "=" {apply (Left.classOf omega) (Right.classOf (Right.cycleSpace.add eta eta2))} "by" {congr!{{Right.Cohomology} {Result.Cohomology}} (\fun (h: Right.Cohomology) => apply (Left.classOf omega) h) (Right.cohomologySpace.add (Right.classOf eta) (Right.classOf eta2)) (Right.classOf (Right.cycleSpace.add eta eta2)) (sym!{{Right.Cohomology}} (Right.classOf (Right.cycleSpace.add eta eta2)) (Right.cohomologySpace.add (Right.classOf eta) (Right.classOf eta2)) (Right.classLinear.addition eta eta2))}
    "=" {Result.classOf (cycle omega (Right.cycleSpace.add eta eta2))} "by" {onClass omega (Right.cycleSpace.add eta eta2)}
    "=" {Result.classOf (Result.cycleSpace.add (cycle omega eta) (cycle omega eta2))} "by" {congr!{{Result.CycleCarrier} {Result.Cohomology}} Result.classOf _ _ (cycleAddRight omega eta eta2)}
    "=" {Result.cohomologySpace.add (Result.classOf (cycle omega eta)) (Result.classOf (cycle omega eta2))} "by" {Result.classLinear.addition (cycle omega eta) (cycle omega eta2)}
    "=" {Result.cohomologySpace.add (apply (Left.classOf omega) (Right.classOf eta)) (apply (Left.classOf omega) (Right.classOf eta2))} "by" {congr!{{Result.Cohomology} {Result.Cohomology} {Result.Cohomology}} (Result.cohomologySpace.add) _ _ _ _ (sym!{{Result.Cohomology}} _ _ (onClass omega eta)) (sym!{{Result.Cohomology}} _ _ (onClass omega eta2))}
  };

\definition additiveRight: \forall (h, h2: Right.Cohomology)(g: Left.Cohomology) -> apply g (Right.cohomologySpace.add h h2) = Result.cohomologySpace.add (apply g h) (apply g h2) :=
  Right.classInduction (\fun (h: Right.Cohomology) => \forall (h2: Right.Cohomology)(g: Left.Cohomology) -> apply g (Right.cohomologySpace.add h h2) = Result.cohomologySpace.add (apply g h) (apply g h2))
  (\fun (eta: Right.CycleCarrier) => Right.classInduction
    (\fun (h2: Right.Cohomology) => \forall (g: Left.Cohomology) -> apply g (Right.cohomologySpace.add (Right.classOf eta) h2) = Result.cohomologySpace.add (apply g (Right.classOf eta)) (apply g h2))
    (\fun (eta2: Right.CycleCarrier) => Left.classInduction
      (\fun (g: Left.Cohomology) => apply g (Right.cohomologySpace.add (Right.classOf eta) (Right.classOf eta2)) = Result.cohomologySpace.add (apply g (Right.classOf eta)) (apply g (Right.classOf eta2)))
      (\fun (omega: Left.CycleCarrier) => classAddRight eta eta2 omega)));

\definition classScaleRight: \forall (a: Reals.Real)(eta: Right.CycleCarrier)(omega: Left.CycleCarrier) -> apply (Left.classOf omega) (Right.cohomologySpace.smul a (Right.classOf eta)) = Result.cohomologySpace.smul a (apply (Left.classOf omega) (Right.classOf eta)) :=
  \fun (a: Reals.Real)(eta: Right.CycleCarrier)(omega: Left.CycleCarrier) => eq_reason!{
    {apply (Left.classOf omega) (Right.cohomologySpace.smul a (Right.classOf eta))}
    "=" {apply (Left.classOf omega) (Right.classOf (Right.cycleSpace.smul a eta))} "by" {congr!{{Right.Cohomology} {Result.Cohomology}} (\fun (h: Right.Cohomology) => apply (Left.classOf omega) h) _ _ (sym!{{Right.Cohomology}} _ _ (Right.classLinear.scalar a eta))}
    "=" {Result.classOf (cycle omega (Right.cycleSpace.smul a eta))} "by" {onClass omega (Right.cycleSpace.smul a eta)}
    "=" {Result.classOf (Result.cycleSpace.smul a (cycle omega eta))} "by" {congr!{{Result.CycleCarrier} {Result.Cohomology}} Result.classOf _ _ (cycleScaleRight a omega eta)}
    "=" {Result.cohomologySpace.smul a (Result.classOf (cycle omega eta))} "by" {Result.classLinear.scalar a (cycle omega eta)}
    "=" {Result.cohomologySpace.smul a (apply (Left.classOf omega) (Right.classOf eta))} "by" {congr!{{Result.Cohomology} {Result.Cohomology}} (Result.cohomologySpace.smul a) _ _ (sym!{{Result.Cohomology}} _ _ (onClass omega eta))}
  };

\definition scalarRight: \forall (a: Reals.Real)(h: Right.Cohomology)(g: Left.Cohomology) -> apply g (Right.cohomologySpace.smul a h) = Result.cohomologySpace.smul a (apply g h) :=
  \fun (a: Reals.Real) => Right.classInduction
    (\fun (h: Right.Cohomology) => \forall (g: Left.Cohomology) -> apply g (Right.cohomologySpace.smul a h) = Result.cohomologySpace.smul a (apply g h))
    (\fun (eta: Right.CycleCarrier) => Left.classInduction
      (\fun (g: Left.Cohomology) => apply g (Right.cohomologySpace.smul a (Right.classOf eta)) = Result.cohomologySpace.smul a (apply g (Right.classOf eta)))
      (\fun (omega: Left.CycleCarrier) => classScaleRight a eta omega));
