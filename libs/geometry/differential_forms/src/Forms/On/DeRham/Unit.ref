\definition zero: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zero;
\import \parent.\parent.ExteriorDerivative[k := zero] \as Differential;
\import \parent.\parent.At[k := one] \as OneForms;
\import Complexes.At[C := complex, k := zero] \as H;
\import std.Data[].FinSet[] \as Fin;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\import Spaces.Exterior[V := Vectors.Vector, space := Vectors.space] \as Exterior;
\definition closed: Closed zero unit := ext one (Differential.apply unit) OneForms.zero
  (\fun (chart: Chart) => Euclidean.On[U := #image{chart}].ExteriorDerivative[k := zero].constant
    Exterior.unit);
\definition cycle: H.CycleCarrier := H.cycle unit closed;
\definition class: H.Cohomology := H.classOf cycle;
