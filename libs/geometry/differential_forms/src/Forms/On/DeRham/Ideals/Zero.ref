\definition total: N.Nat^ := Nat.add p q;
\import \parent.\parent.\parent.Wedge[p := p, q := q] \as Product;
\import \parent.\parent.\parent.At[k := p] \as Left;
\import \parent.\parent.\parent.At[k := q] \as Right;
\import \parent.\parent.\parent.At[k := total] \as Result;
\import Complexes.At[C := complex, k := total] \as Boundaries;
\definition left: \forall (omega: Form p)(eta: Form q) -> omega = Left.zero -> Exact total (Product.apply omega eta) :=
  \fun (omega: Form p)(eta: Form q)(equal: omega = Left.zero) =>
    \idelim Result.zero = Product.apply omega eta \with phi: Form total => Exact total phi \by {
      base: Boundaries.boundaryZero total,
      equality: sym!{{Form total}} (Product.apply omega eta) Result.zero
        (trans!{{Form total}} (Product.apply omega eta) (Product.apply Left.zero eta) Result.zero
          (congr!{{Form p} {Form total}} (\fun (alpha: Form p) => Product.apply alpha eta) omega Left.zero equal)
          (Product.zeroLeft eta))
    };
\definition right: \forall (omega: Form p)(eta: Form q) -> eta = Right.zero -> Exact total (Product.apply omega eta) :=
  \fun (omega: Form p)(eta: Form q)(equal: eta = Right.zero) =>
    \idelim Result.zero = Product.apply omega eta \with phi: Form total => Exact total phi \by {
      base: Boundaries.boundaryZero total,
      equality: sym!{{Form total}} (Product.apply omega eta) Result.zero
        (trans!{{Form total}} (Product.apply omega eta) (Product.apply omega Right.zero) Result.zero
          (congr!{{Form q} {Form total}} (Product.apply omega) eta Right.zero equal) (Product.zeroRight omega))
    };
