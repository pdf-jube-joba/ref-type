
\definition family(omega: Form k)(same: k = l): Family l :=
  \fun (chart: Chart) => Euclidean.On[U := #image{chart}].Regrade[k := k, l := l].cast (omega chart) same;
\definition compatible: \forall (omega: Form k)(same: k = l) -> Compatible l (family omega same) :=
  \fun (omega: Form k)(same: k = l)(left, right: Chart) => \parent.Pair[left := left, right := right].Regrade[k := k, l := l].law omega same
    ((\bysub(Family k, { omega: Family k \where Compatible k omega }, omega)) left right);
\definition cast(omega: Form k)(same: k = l): Form l := \into[Family l](family omega same, { result: Family l \where Compatible l result }) \by { compatible omega same };
\import \parent.At[k := k] \as Source;
\import \parent.At[k := l] \as Target;
\definition addition: \forall (omega, eta: Form k)(same: k = l) -> cast (Source.plus omega eta) same = Target.plus (cast omega same) (cast eta same) :=
  \fun (omega, eta: Form k)(same: k = l) => ext l (cast (Source.plus omega eta) same) (Target.plus (cast omega same) (cast eta same))
    (\fun (chart: Chart) => Euclidean.On[U := #image{chart}].Regrade[k := k, l := l].addition (omega chart) (eta chart) same);
\definition scalar: \forall (a: Reals.Real)(omega: Form k)(same: k = l) -> cast (Source.scale a omega) same = Target.scale a (cast omega same) :=
  \fun (a: Reals.Real)(omega: Form k)(same: k = l) => ext l (cast (Source.scale a omega) same) (Target.scale a (cast omega same))
    (\fun (chart: Chart) => Euclidean.On[U := #image{chart}].Regrade[k := k, l := l].scalar a (omega chart) same);
\import Spaces.Linear[V := Form k, W := Form l, source := Source.space, target := Target.space] \as Maps;
\definition map(same: k = l): Maps.Map := Maps.Map {
  apply := \fun (omega: Form k) => cast omega same,
  preservesAdd := \fun (omega, eta: Form k) => addition omega eta same,
  preservesScale := \fun (a: Reals.Real)(omega: Form k) => scalar a omega same,
};
\definition zero: \forall (same: k = l) -> cast Source.zero same = Target.zero :=
  \fun (same: k = l) => #preservesZero{(map same)};
