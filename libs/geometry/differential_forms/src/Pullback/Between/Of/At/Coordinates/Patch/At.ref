\use std.Logic[].Equality[].eq_reason_in;
\definition sourcePoint: SourceCharts.LocalPoint chart := SourceCharts.point chart (Coordinates.leftCoordinate a);
\definition targetPoint: TargetCharts.LocalPoint right := Coordinates.point a;
\definition leftChart: SourceTangent.At[x := sourcePoint].Chart := SourceCoordinates.lift sourcePoint;
\definition rightChart: TargetTangent.At[x := Maps.apply f sourcePoint].Chart := TargetPointwise.Coordinates[chart := right].lift targetPoint;
\import manifolds.Differential[n := n, m := m].Between[M := M, N := N].At[f := f, x := sourcePoint] \as Differential;
\import Differential.InCharts[left := leftChart, right := rightChart] \as InCharts;
\import SourceTangent.At[x := sourcePoint].Coordinate[chart := leftChart] \as Decode;
\import TargetTangent.At[x := Maps.apply f sourcePoint].Coordinate[chart := rightChart] \as Encode;
\definition coordinatePoint: InCharts.point = a := Geometry.coordinatePoint (Coordinates.leftCoordinate a);
\definition jacobianEquality: InCharts.jacobian = LocalPullback.jacobian a :=
  congr!{{Open.Carrier Coordinates.domain} {Spaces.Linear[V := SourceVectors.Vector, W := TargetVectors.Vector, source := SourceVectors.space, target := TargetVectors.space].Map}}
    InCharts.jacobianAt InCharts.point a coordinatePoint;
\definition derivative: \forall (v: SourceVectors.Vector) ->
  Encode.decode (Differential.value.apply (Decode.encode v)) = (LocalPullback.jacobian a).apply v :=
  \fun (v: SourceVectors.Vector) => eq_reason_in!{{TargetVectors.Vector} _
    "=" _ "by" { Differential.coordinates leftChart rightChart (Decode.encode v) }
    "=" { InCharts.jacobian.apply v } "by" { congr!{{SourceVectors.Vector} {TargetVectors.Vector}} (InCharts.jacobian.apply) _ _ (Decode.decodeEncode v) }
    "=" _ "by" { congr!{{Spaces.Linear[V := SourceVectors.Vector, W := TargetVectors.Vector, source := SourceVectors.space, target := TargetVectors.space].Map} {TargetVectors.Vector}}
        (\fun (d: Spaces.Linear[V := SourceVectors.Vector, W := TargetVectors.Vector, source := SourceVectors.space, target := TargetVectors.space].Map) => d.apply v)
        InCharts.jacobian (LocalPullback.jacobian a) jacobianEquality }
  };
\definition agreement: \forall (omega: TargetForms.Form k)(arguments: SourceMultilinear.Arguments k) ->
  SourceCoordinates.family (pointwise k omega) (Open.inclusion Coordinates.domain chart.image (included right) a) arguments =
    LocalPullback.apply k (omega right) a arguments :=
      \fun (omega: TargetForms.Form k)(arguments: SourceMultilinear.Arguments k) => trans!{{Reals.Real}}
        _ _ _
        (congr!{{TargetForms.PointForm k (Maps.apply f sourcePoint)} {Reals.Real}}
          (\fun (form: TargetForms.PointForm k (Maps.apply f sourcePoint)) => form
            (\fun (i: Fin.Fin k) => Differential.value.apply (Decode.encode (arguments i))))
          _ _
          (TargetPointwise.At[x := Maps.apply f sourcePoint].inChart omega rightChart))
        (congr!{{Fin.Fin k -> TargetVectors.Vector} {Reals.Real}}
          (omega right (Calculus.apply Coordinates.domain right.image coordinateMap a)) _ _
          (\axiom:funext((\fun (i: Fin.Fin k) => Encode.decode (Differential.value.apply (Decode.encode (arguments i)))),
            (\fun (i: Fin.Fin k) => (LocalPullback.jacobian a).apply (arguments i)),
            \fun (i: Fin.Fin k) => derivative (arguments i))));
