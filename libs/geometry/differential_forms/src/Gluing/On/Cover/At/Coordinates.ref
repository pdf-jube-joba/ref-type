\import Pointwise.Coordinates[chart := chart] \as Coordinates;
\import euclidean_forms.Euclidean[n := n].On[U := chart.image] \as Forms;
\module Patch(i: I);
\definition patches[i: I]: Open.OpenSet := Patch[i := i].image;
\definition included: \forall (i: I) -> Open.Included (patches i) chart.image :=
  \fun (i: I)(a: Vectors.Vector)(member: \In[Vectors.Vector] ((patches i).points) a) =>
    Patch[i := i].included a member;
\definition covered: Covers -> \forall (a: Open.Carrier chart.image) -> \exists ( i: I \where \In[Vectors.Vector] ((patches i).points) a ) := \block {
  \fun (covers: Covers)(a: Open.Carrier chart.image) \then
  \takefrom i: Indices (Charts.point chart a) \by covers (Charts.point chart a) \then
  \return Logic.existsIntro[I, { j: I \where \In[Vectors.Vector] ((patches j).points) a }] i
    (Patch[i := i].contains a (\bysub(I, { j: I \where \In[M.Point] (domains j) (Charts.point chart a) }, i)))
};
\definition regular: \forall (covers: Covers)(compatible: Compatible) -> Forms.SmoothFamily k (Coordinates.family (family covers compatible)) :=
  \fun (covers: Covers)(compatible: Compatible)(arguments: Multilinear.Arguments k) =>
    Open.SmoothCover[I := I, U := chart.image, domains := patches,
      f := \fun (a: Open.Carrier chart.image) => Coordinates.family (family covers compatible) a arguments].smooth included
      (covered covers) (\fun (i: I) => Patch[i := i].regular covers compatible arguments);
