\import manifolds.OpenSubmanifold[n := n].On[M := M].In[U := domains i] \as Submanifold;
\import \root.Forms[n := n].On[M := Submanifold.manifold] \as Local;
\import Local.Pointwise[k := k] \as LocalPointwise;
\import manifolds.Tangent[n := n].On[M := Submanifold.manifold] \as LocalTangent;
\import \root.Pullback[n := n, m := n].Between[M := Submanifold.manifold, N := M].Of[f := Submanifold.Inclusion[].map].At[k := k] \as Pullback;
\module AtPoint(x: Point i);
\definition law: \forall (covers: Covers)(compatible: Compatible) ->
  \root.Restriction[n := n].On[M := M].To[U := domains i].apply k (apply covers compatible) = forms i :=
    \fun (covers: Covers)(compatible: Compatible) => LocalPointwise.Algebra[].injective (Pullback.apply (apply covers compatible)) (forms i)
      (\axiom:funext(LocalPointwise.value (Pullback.apply (apply covers compatible)), LocalPointwise.value (forms i),
        \fun (x: Point i) => \axiom:funext(LocalPointwise.value (Pullback.apply (apply covers compatible)) x,
          LocalPointwise.value (forms i) x, AtPoint[x := x].agreement covers compatible)));
