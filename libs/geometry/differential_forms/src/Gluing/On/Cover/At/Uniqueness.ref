\definition law: \forall (covers: Covers)(compatible: Compatible)(omega: Global.Form k) ->
  (\forall (i: I) -> \root.Restriction[n := n].On[M := M].To[U := domains i].apply k omega = forms i) -> omega = apply covers compatible :=
    \fun (covers: Covers)(compatible: Compatible)(omega: Global.Form k)(same: _) => Pointwise.Algebra[].injective omega (apply covers compatible)
      (\axiom:funext(Pointwise.value omega, Pointwise.value (apply covers compatible), \fun (x: M.Point) =>
        \axiom:funext(Pointwise.value omega x, Pointwise.value (apply covers compatible) x, \block {
          \fun (arguments: Fin.Fin k -> Tangent.Vector x) \then
          \takefrom i: Indices x \by covers x \then
          \let local: Point i := point x i \then
          \let result: Pointwise.value omega x arguments = Pointwise.value (apply covers compatible) x arguments :=
            trans!{{Reals.Real}} _ (localValue x i arguments) _
            (\parent.Restriction[i := i].AtPoint[x := local].ambientAgreement omega (same i) arguments)
            (trans!{{Reals.Real}} _ (family covers compatible x arguments) _
              (sym!{{Reals.Real}} _ _ (congr!{{Global.PointForm k x} {Reals.Real}}
                (\fun (phi: Global.PointForm k x) => phi arguments) _ _ (agrees covers compatible x i)))
              (sym!{{Reals.Real}} _ _ (congr!{{Global.PointFamily k} {Reals.Real}}
                (\fun (phi: Global.PointFamily k) => phi x arguments) _ _ (evaluation covers compatible)))) \then
          \return result
        })));
