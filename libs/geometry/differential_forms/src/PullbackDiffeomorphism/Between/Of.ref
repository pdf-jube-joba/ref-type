\import \root.Pullback[n := n, m := m].Between[M := M, N := N].Of[f := #forward{d}] \as Forward;
\import \root.Pullback[n := m, m := n].Between[M := N, N := M].Of[f := #backward{d}] \as Backward;
\import manifolds.Composition[n := n, m := m, l := n].Between[M := M, N := N, P := M].Of[f := #forward{d}, g := #backward{d}] \as SourceComposite;
\import manifolds.Composition[n := m, m := n, l := m].Between[M := N, N := M, P := N].Of[f := #backward{d}, g := #forward{d}] \as TargetComposite;
\import manifolds.SelfMap[n := n].Identity[M := M] \as SourceIdentity;
\import manifolds.SelfMap[n := m].Identity[M := N] \as TargetIdentity;
\import manifolds.SmoothMap[n := n, m := n].Between[M := M, N := M] \as SourceMaps;
\import manifolds.SmoothMap[n := m, m := m].Between[M := N, N := N] \as TargetMaps;
\import \root.Pullback[n := n, m := n].Between[M := M, N := M] \as SourcePullback;
\import \root.Pullback[n := m, m := m].Between[M := N, N := N] \as TargetPullback;
\import \root.PullbackIdentity[n := n].On[M := M] \as SourceIdentityLaw;
\import \root.PullbackIdentity[n := m].On[M := N] \as TargetIdentityLaw;
\definition sourceComposite: SourceComposite.map = SourceIdentity.map := SourceMaps.ext SourceComposite.map SourceIdentity.map
  (\axiom:funext(SourceMaps.apply SourceComposite.map, SourceMaps.apply SourceIdentity.map, #leftInverse{(Diffeomorphisms.laws d)}));
\definition targetComposite: TargetComposite.map = TargetIdentity.map := TargetMaps.ext TargetComposite.map TargetIdentity.map
  (\axiom:funext(TargetMaps.apply TargetComposite.map, TargetMaps.apply TargetIdentity.map, #rightInverse{(Diffeomorphisms.laws d)}));
\module At(k: Naturals.Nat^);
