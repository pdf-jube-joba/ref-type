\import Reals.Multivariable[n := n].Differential[].Def[] \as ScalarMaps;
\import calculus.Vector[n := n, m := m].Chain[U := U, V := V, f := Maps.apply U V f, a := x, d := jacobian x, g := h,
  e := TargetDifferential.value V h (Maps.apply U V f x)] \as Chain;
\definition equality: SourceDifferential.value U (compose h) x = Chain.differential :=
  Open.Analysis[].Differential[U := U, f := compose h, a := x, d := SourceDifferential.value U (compose h) x].uniqueness
    Chain.differential (SourceDifferential.law U (compose h) x) (Composition.At[h := h, a := x].law);
\definition evaluate: \forall (v: Vectors.Vector) -> (SourceDifferential.value U (compose h) x).apply v =
  (TargetDifferential.value V h (Maps.apply U V f x)).apply ((jacobian x).apply v) :=
  \fun (v: Vectors.Vector) => congr!{{ScalarMaps.LinearMap} {Reals.Real}} (\fun (d: ScalarMaps.LinearMap) => d.apply v)
    (SourceDifferential.value U (compose h) x) Chain.differential equality;
