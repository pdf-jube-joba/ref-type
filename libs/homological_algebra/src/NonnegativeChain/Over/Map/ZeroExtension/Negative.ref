\import algebra.Module[].Over[R := R, ring := ring] \as Modules;
\import Modules.Laws[V := Target.Carrier (Signed.Int^::negSucc n), space := Target.space (Signed.Int^::negSucc n)] \as PointLaws;
\import algebra.Group[].Of[Carrier := Target.Carrier (Signed.Int^::negSucc n), group := PointLaws.additive] \as Group;
\definition addition: \forall (x, y: Source.Carrier (Signed.Int^::negSucc n)) ->
  #zero{(Target.space (Signed.Int^::negSucc n))} = #add{(Target.space (Signed.Int^::negSucc n))} #zero{(Target.space (Signed.Int^::negSucc n))} #zero{(Target.space (Signed.Int^::negSucc n))} :=
  \fun (x, y: Source.Carrier (Signed.Int^::negSucc n)) => sym!{{Target.Carrier (Signed.Int^::negSucc n)}} _ _ (Group.zeroLeft #zero{(Target.space (Signed.Int^::negSucc n))});
\definition scalar: \forall (a: R)(x: Source.Carrier (Signed.Int^::negSucc n)) ->
  #zero{(Target.space (Signed.Int^::negSucc n))} = #smul{(Target.space (Signed.Int^::negSucc n))} a #zero{(Target.space (Signed.Int^::negSucc n))} :=
  \fun (a: R)(x: Source.Carrier (Signed.Int^::negSucc n)) => sym!{{Target.Carrier (Signed.Int^::negSucc n)}} _ _ (PointLaws.scaleZero a);
