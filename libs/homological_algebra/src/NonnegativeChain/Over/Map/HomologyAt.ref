\import \parent.\parent.Homology[C := C].At[n := n] \as Source;
\import \parent.\parent.Homology[C := D].At[n := n] \as Target;
\import \parent.\parent.IntegerComparison[C := C].At[n := n] \as SourceComparison;
\import \parent.\parent.IntegerComparison[C := D].At[n := n] \as TargetComparison;
\import \parent.\parent.ZeroExtension[C := C] \as SourceExtension;
\import \parent.\parent.ZeroExtension[C := D] \as TargetExtension;
\import std.Arithmetic[].Int[] \as Signed;
\import \root.Chain[].Over[R := R, ring := ring] \as Integer;
\definition index: Signed.Int^ := Signed.Int^::ofNat n;
\import Integer.At[C := SourceExtension.complex, z := index] \as IntegerSource;
\import Integer.At[C := TargetExtension.complex, z := index] \as IntegerTarget;
\import Integer.Map[C := SourceExtension.complex, D := TargetExtension.complex].At[k := index] \as IntegerMap;
\import Modules.Hom[V := IntegerTarget.Homology, W := Target.Carrier, source := IntegerTarget.homologySpace, target := Target.space].Composition[U := IntegerSource.Homology, domain := IntegerSource.homologySpace] \as After;
\import Modules.Hom[V := IntegerSource.Homology, W := Target.Carrier, source := IntegerSource.homologySpace, target := Target.space].Composition[U := Source.Carrier, domain := Source.space] \as Before;
\module On(f: Map) {
  \import \parent.\parent.ZeroExtension[f := f] \as Extension;
  \definition middle: Modules.Hom[V := IntegerSource.Homology, W := Target.Carrier, source := IntegerSource.homologySpace, target := Target.space].Map :=
    After.compose (#backward{TargetComparison.isomorphism}) (IntegerMap.induced Extension.map);
  \definition map: Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map :=
    Before.compose middle (#forward{SourceComparison.isomorphism});
}
\definition induced(f: Map): Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map := On[f := f].map;
