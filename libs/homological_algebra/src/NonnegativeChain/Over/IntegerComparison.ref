\import std.Arithmetic[].Int[] \as Signed;
\import \parent.ZeroExtension[C := C] \as Extension;
\import \parent.Homology[C := C] \as Natural;
\import \root.Chain[].Over[R := R, ring := ring] \as Internal;
\module At(n: N.Nat^) {
  \import Natural.At[n := n] \as Source;
  \import Internal.At[C := Extension.complex, z := Signed.Int^::ofNat n] \as Target;
  \import Modules.Isomorphism[V := Source.Carrier, W := Target.Homology, source := Source.space, target := Target.homologySpace] \as Iso;
  \definition isomorphism: Iso.Isomorphism := (\induction (k: N.Nat^) \return Modules.Isomorphism[V := Natural.At[n := k].Carrier, W := Internal.At[C := Extension.complex, z := Signed.Int^::ofNat k].Homology, source := Natural.At[n := k].space, target := Internal.At[C := Extension.complex, z := Signed.Int^::ofNat k].homologySpace].Isomorphism \with {
    | zero: Extension.DegreeZeroHomology[].isomorphism
    | succ: \fun (k: N.Nat^)(before: _) => Extension.PositiveHomology[n := k].homologyIsomorphism
  }) n;
}
