\definition higher: N.Nat^ := N.Nat^::succ n;
\definition index: Signed.Int^ := Signed.Int^::ofNat higher;
\import Extended.At[s := sequence, k := index] \as Exact;
\import \root.Chain[].Over[R := R, ring := ring] \as Internal;
\import \parent.\parent.\parent.Homology[C := A].At[n := higher] \as HA;
\import \parent.\parent.\parent.Homology[C := B].At[n := higher] \as HB;
\import \parent.\parent.\parent.Homology[C := C].At[n := higher] \as HC;
\import \parent.\parent.\parent.Homology[C := A].At[n := n] \as HLowerA;
\import \parent.\parent.\parent.Homology[C := B].At[n := n] \as HLowerB;
\import Internal.At[C := Left.complex, z := index] \as IA;
\import Internal.At[C := Middle.complex, z := index] \as IB;
\import Internal.At[C := Right.complex, z := index] \as IC;
\import Internal.At[C := Left.complex, z := Signed.Int^::ofNat n] \as ILowerA;
\import Internal.At[C := Middle.complex, z := Signed.Int^::ofNat n] \as ILowerB;
\import \parent.\parent.\parent.IntegerComparison[C := A].At[n := higher] \as AComparison;
\import \parent.\parent.\parent.IntegerComparison[C := B].At[n := higher] \as BComparison;
\import \parent.\parent.\parent.IntegerComparison[C := C].At[n := higher] \as CComparison;
\import \parent.\parent.\parent.IntegerComparison[C := A].At[n := n] \as LowerAComparison;
\import \parent.\parent.\parent.IntegerComparison[C := B].At[n := n] \as LowerBComparison;
\definition a: Modules.Bundle := Modules.Bundle { Carrier := HA.Carrier, space := HA.space };
\definition b: Modules.Bundle := Modules.Bundle { Carrier := HB.Carrier, space := HB.space };
\definition c: Modules.Bundle := Modules.Bundle { Carrier := HC.Carrier, space := HC.space };
\definition d: Modules.Bundle := Modules.Bundle { Carrier := HLowerA.Carrier, space := HLowerA.space };
\definition e: Modules.Bundle := Modules.Bundle { Carrier := HLowerB.Carrier, space := HLowerB.space };
\definition ia: Modules.Bundle := Modules.Bundle { Carrier := IA.Homology, space := IA.homologySpace };
\definition ib: Modules.Bundle := Modules.Bundle { Carrier := IB.Homology, space := IB.homologySpace };
\definition ic: Modules.Bundle := Modules.Bundle { Carrier := IC.Homology, space := IC.homologySpace };
\definition id: Modules.Bundle := Modules.Bundle { Carrier := ILowerA.Homology, space := ILowerA.homologySpace };
\definition ie: Modules.Bundle := Modules.Bundle { Carrier := ILowerB.Homology, space := ILowerB.homologySpace };
\import Modules.Isomorphism[V := a.Carrier, W := ia.Carrier, source := a.space, target := ia.space].Inverse[] \as AInverse;
\import Modules.Isomorphism[V := b.Carrier, W := ib.Carrier, source := b.space, target := ib.space].Inverse[] \as BInverse;
\import Modules.Isomorphism[V := c.Carrier, W := ic.Carrier, source := c.space, target := ic.space].Inverse[] \as CInverse;
\import Modules.Isomorphism[V := d.Carrier, W := id.Carrier, source := d.space, target := id.space].Inverse[] \as DInverse;
\import Modules.Isomorphism[V := e.Carrier, W := ie.Carrier, source := e.space, target := ie.space].Inverse[] \as EInverse;
\definition aIsomorphism: Modules.Isomorphism[V := ia.Carrier, W := a.Carrier, source := ia.space, target := a.space].Isomorphism := AInverse.inverse AComparison.isomorphism;
\definition bIsomorphism: Modules.Isomorphism[V := ib.Carrier, W := b.Carrier, source := ib.space, target := b.space].Isomorphism := BInverse.inverse BComparison.isomorphism;
\definition cIsomorphism: Modules.Isomorphism[V := ic.Carrier, W := c.Carrier, source := ic.space, target := c.space].Isomorphism := CInverse.inverse CComparison.isomorphism;
\definition dIsomorphism: Modules.Isomorphism[V := id.Carrier, W := d.Carrier, source := id.space, target := d.space].Isomorphism := DInverse.inverse LowerAComparison.isomorphism;
\definition eIsomorphism: Modules.Isomorphism[V := ie.Carrier, W := e.Carrier, source := ie.space, target := e.space].Isomorphism := EInverse.inverse LowerBComparison.isomorphism;
\import Inclusion.HomologyAt[n := higher] \as InclusionNatural;
\import Projection.HomologyAt[n := higher] \as ProjectionNatural;
\import Inclusion.HomologyAt[n := n] \as InclusionLowerNatural;
\import Internal.Map[C := Left.complex, D := Middle.complex].At[k := index] \as InclusionInteger;
\import Internal.Map[C := Middle.complex, D := Right.complex].At[k := index] \as ProjectionInteger;
\import Internal.Map[C := Left.complex, D := Middle.complex].At[k := Signed.Int^::ofNat n] \as InclusionLowerInteger;
\import Modules.Hom[V := id.Carrier, W := d.Carrier, source := id.space, target := d.space].Composition[U := ic.Carrier, domain := ic.space] \as After;
\definition integerConnecting: Modules.MapBetween ic d := After.compose (#forward{dIsomorphism}) Exact.connecting;
\import Modules.Hom[V := ic.Carrier, W := d.Carrier, source := ic.space, target := d.space].Composition[U := c.Carrier, domain := c.space] \as Before;
\definition connecting: Modules.MapBetween c d := Before.compose integerConnecting (#backward{cIsomorphism});
\definition connectingCommutes: \forall (q: ic.Carrier) -> #apply{#forward{dIsomorphism}} (#apply{Exact.connecting} q) = #apply{connecting} (#apply{#forward{cIsomorphism}} q) :=
  \fun (q: ic.Carrier) => sym!{d.Carrier} _ _ (congr!{ic.Carrier d.Carrier} (#apply{integerConnecting}) _ _ (#leftInverse{cIsomorphism} q));
\module Exactness;
