\import \root.Chain[].Over[R := R, ring := ring] \as Internal;
\structure Commutative: \Prop {
  left: \forall (n: N.Nat^)(x: A.family.Carrier n) -> #apply{b} n (#apply{s.inclusion} n x) = #apply{t.inclusion} n (#apply{a} n x),
  right: \forall (n: N.Nat^)(x: B.family.Carrier n) -> #apply{t.projection} n (#apply{b} n x) = #apply{c} n (#apply{s.projection} n x),
}
\import \parent.\parent.With[s := s] \as SourceSequence;
\import Target.With[s := t] \as TargetSequence;
\import LeftMap.ZeroExtension[f := a] \as ExtendedLeft;
\import MiddleMap.ZeroExtension[f := b] \as ExtendedMiddle;
\import RightMap.ZeroExtension[f := c] \as ExtendedRight;
\import \parent.\parent.\parent.ZeroExtension[C := A] \as AL;
\import \parent.\parent.\parent.ZeroExtension[C := B] \as BL;
\import \parent.\parent.\parent.ZeroExtension[C := C] \as CL;
\import \parent.\parent.\parent.ZeroExtension[C := A1] \as AR;
\import \parent.\parent.\parent.ZeroExtension[C := B1] \as BR;
\import \parent.\parent.\parent.ZeroExtension[C := C1] \as CR;
\import Internal.ShortExact[A := AL.complex, B := BL.complex, C := CL.complex].Morphism[A1 := AR.complex, B1 := BR.complex, C1 := CR.complex].Diagram[s := SourceSequence.sequence, t := TargetSequence.sequence, a := ExtendedLeft.map, b := ExtendedMiddle.map, c := ExtendedRight.map] \as IntegerDiagram;
\definition integerCommutative: Commutative -> IntegerDiagram.Commutative := \fun (diagram: Commutative) => IntegerDiagram.Commutative {
  left := \induction (z: Signed.Int^) \return \forall (x: AL.Carrier z) -> #apply{ExtendedMiddle.map} z (#apply{SourceSequence.sequence.inclusion} z x) = #apply{TargetSequence.sequence.inclusion} z (#apply{ExtendedLeft.map} z x) \with {
    | ofNat: \fun (n: N.Nat^)(x: AL.Carrier (Signed.Int^::ofNat n)) => #left{diagram} n x
    | negSucc: \fun (n: N.Nat^)(x: AL.Carrier (Signed.Int^::negSucc n)) => \refl(#zero{(BR.space (Signed.Int^::negSucc n))})
  },
  right := \induction (z: Signed.Int^) \return \forall (x: BL.Carrier z) -> #apply{TargetSequence.sequence.projection} z (#apply{ExtendedMiddle.map} z x) = #apply{ExtendedRight.map} z (#apply{SourceSequence.sequence.projection} z x) \with {
    | ofNat: \fun (n: N.Nat^)(x: BL.Carrier (Signed.Int^::ofNat n)) => #right{diagram} n x
    | negSucc: \fun (n: N.Nat^)(x: BL.Carrier (Signed.Int^::negSucc n)) => \refl(#zero{(CR.space (Signed.Int^::negSucc n))})
  },
};
\module At(n: N.Nat^);
