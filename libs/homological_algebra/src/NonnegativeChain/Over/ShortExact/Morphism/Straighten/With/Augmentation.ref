\import Modules.Hom[V := B1.family.Carrier N.Nat^::zero, W := M.Carrier, source := B1.family.space N.Nat^::zero, target := M.space] \as Maps;
\import Modules.Laws[V := M.Carrier, space := M.space] \as Target;
\import algebra.Group[].Of[Carrier := M.Carrier, group := Target.additive] \as Group;
\definition Killed: \Prop := \forall (x: B1.family.Carrier (N.Nat^::succ N.Nat^::zero)) ->
  #apply{augmentation} (#apply{B1.differential} N.Nat^::zero x) = #zero{M.space};
\definition preserved: Killed -> \forall (x: B.family.Carrier N.Nat^::zero) ->
  #apply{augmentation} (#apply{middle} N.Nat^::zero x) = #apply{augmentation} (#apply{b} N.Nat^::zero x) :=
  \fun (killed: Killed)(x: B.family.Carrier N.Nat^::zero) => trans!{M.Carrier} _ _ _
    (Maps.differencePreserved augmentation (#apply{b} N.Nat^::zero x) (#apply{LiftedBoundary.map} N.Nat^::zero x))
    (trans!{M.Carrier} _ _ _
      (congr!{M.Carrier M.Carrier} (\fun (v: M.Carrier) => #add{M.space} (#apply{augmentation} (#apply{b} N.Nat^::zero x)) (#neg{M.space} v)) _ _
        (killed (#apply{lifted} N.Nat^::zero x)))
      (trans!{M.Carrier} _ _ _
        (congr!{M.Carrier M.Carrier} (#add{M.space} (#apply{augmentation} (#apply{b} N.Nat^::zero x))) _ _ Group.negZero)
        (Group.zeroRight (#apply{augmentation} (#apply{b} N.Nat^::zero x)))));
