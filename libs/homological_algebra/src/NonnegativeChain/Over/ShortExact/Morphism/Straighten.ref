\import \root.NonnegativeChain[].Over[R := R, ring := ring] \as Chains;
\import Chains.Map[C := B1, D := C1] \as TargetProjection;
\import Chains.Map[C := B, D := C1] \as RightMiddle;
\definition first: RightMiddle.Map := TargetProjection.Composition[B := B].compose t.projection b;
\definition last: RightMiddle.Map := RightMap.Composition[B := B].compose c s.projection;
\import Chains.Homotopy[C := B, D := C1] \as RightHomotopies;
\definition Sections: \Set := \forall (n: N.Nat^) -> Modules.Hom[V := C1.family.Carrier n, W := B1.family.Carrier n, source := C1.family.space n, target := B1.family.space n].Map;
\module With(sections: Sections, h: RightHomotopies.Homotopy first last);
