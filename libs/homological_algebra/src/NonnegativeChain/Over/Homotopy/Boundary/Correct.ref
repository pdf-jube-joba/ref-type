\definition boundary: Maps.Map := map;
\import \root.NonnegativeChain[].Over[R := R, ring := ring].Homotopy[C := C, D := D].Boundary[h := h] \as Boundaries;
\definition map: Maps.Map := Additive.difference f boundary;
\definition homotopy: Homotopy f map := \into[Data](h, { data: Data \where Laws[f, map, data] }) \by {
  Laws[f, map, h] {
    addition := #addition{h}, scalar := #scalar{h},
    zeroEquation := \fun (x: C.family.Carrier N.Nat^::zero) =>
      Boundaries.Degree[n := N.Nat^::zero].subtractDifference (#apply{f} N.Nat^::zero x) (#apply{boundary} N.Nat^::zero x),
    successorEquation := \fun (n: N.Nat^)(x: C.family.Carrier (N.Nat^::succ n)) =>
      Boundaries.Degree[n := N.Nat^::succ n].subtractDifference (#apply{f} (N.Nat^::succ n) x) (#apply{boundary} (N.Nat^::succ n) x),
  }
};
