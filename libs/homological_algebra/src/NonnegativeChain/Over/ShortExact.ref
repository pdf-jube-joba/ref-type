\import std.Arithmetic[].Int[] \as Signed;
\import \root.Integer[] \as Integers;
\import algebra.Module[].Over[R := R, ring := ring] \as Modules;
\import \parent.Map[C := A, D := B] \as Inclusion;
\import \parent.Map[C := B, D := C] \as Projection;
\structure Data: \Set { inclusion: Inclusion.Map, projection: Projection.Map }
\structure Laws[data: Data]: \Prop {
  injective: \forall (n: N.Nat^)(x, y: A.family.Carrier n) -> #apply{data.inclusion} n x = #apply{data.inclusion} n y -> x = y,
  onto: \forall (n: N.Nat^)(z: C.family.Carrier n) -> \exists { y: B.family.Carrier n \where #apply{data.projection} n y = z },
  zero: \forall (n: N.Nat^)(x: A.family.Carrier n) -> #apply{data.projection} n (#apply{data.inclusion} n x) = #zero{(C.family.space n)},
  kernelImage: \forall (n: N.Nat^)(y: B.family.Carrier n) -> #apply{data.projection} n y = #zero{(C.family.space n)} ->
    \exists { x: A.family.Carrier n \where #apply{data.inclusion} n x = y },
}
\definition Sequence: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module With(s: Sequence);


\module Morphism(A1, B1, C1: Complex);
