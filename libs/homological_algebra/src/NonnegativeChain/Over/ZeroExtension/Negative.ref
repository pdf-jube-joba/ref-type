\import \parent.Index[z := Signed.Int^::negSucc n] \as Source;
\import Modules.Laws[V := Carrier (Integers.previous (Signed.Int^::negSucc n)), space := space (Integers.previous (Signed.Int^::negSucc n))] \as Target;
