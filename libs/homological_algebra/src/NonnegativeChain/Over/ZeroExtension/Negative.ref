  \fun (x: Carrier (Signed.Int^::negSucc n)) => either!{Logic.False "or" {x = #zero{(C.family.space (N.Nat^::succ n))}} "either" {x = #zero{(space (Signed.Int^::negSucc n))}}
    "lt:" {\fun (false: Logic.False) => Logic.falseElim _ false}
    "rt:" {\fun (equal: x = #zero{(C.family.space (N.Nat^::succ n))}) => equal}
