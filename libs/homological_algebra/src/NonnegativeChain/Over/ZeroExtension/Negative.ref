  \fun (x, y: Carrier (Signed.Int^::negSucc n)) => sym!{{Carrier (Integers.previous (Signed.Int^::negSucc n))}} _ _ (TargetGroup.zeroLeft #zero{(space (Integers.previous (Signed.Int^::negSucc n)))});
\definition scalar: \forall (a: R)(x: Carrier (Signed.Int^::negSucc n)) -> apply (#smul{(space (Signed.Int^::negSucc n))} a x) = #smul{(space (Integers.previous (Signed.Int^::negSucc n)))} a (apply x) :=
