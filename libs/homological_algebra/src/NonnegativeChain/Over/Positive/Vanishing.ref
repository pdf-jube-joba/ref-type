\definition Trivial: \Prop := \forall (x: C.family.Carrier (N.Nat^::succ n)) -> x = #zero{(C.family.space (N.Nat^::succ n))};
\definition zeroCycle: Cycle := \into[C.family.Carrier (N.Nat^::succ n)](#zero{(C.family.space (N.Nat^::succ n))}, #carrier{cycles}) \by {
  Maps.zeroPreserved differential
};
\definition onCycles: Trivial -> \forall (x: Cycle) -> classOf x = zeroClass :=
  \fun (trivial: Trivial)(x: Cycle) => congr!{Cycle Homology} classOf x zeroCycle (trivial x);
\definition zero: Trivial -> \forall (q: Homology) -> q = zeroClass :=
  \fun (trivial: Trivial) => classInduction (\fun (q: Homology) => q = zeroClass) (onCycles trivial);
\import Modules.Zero[] \as Zero;
\import Modules.Hom[V := Homology, W := Zero.Carrier, source := homologySpace, target := Zero.moduleSpace] \as Forward;
\import Modules.Hom[V := Zero.Carrier, W := Homology, source := Zero.moduleSpace, target := homologySpace] \as Backward;
\import Modules.Isomorphism[V := Homology, W := Zero.Carrier, source := homologySpace, target := Zero.moduleSpace] \as Iso;
\definition isomorphism(trivial: Trivial): Iso.Isomorphism := Iso.Isomorphism {
  forward := Forward.zeroMap,
  backward := Backward.zeroMap,
  leftInverse := \fun (q: Homology) => sym!{Homology} q zeroClass (zero trivial q),
  rightInverse := \fun (q: Zero.Carrier) => Zero.unique Zero.Carrier::zero q,
};
