\import \parent.Term[p := p, q := q] \as Current;
\import \parent.Term[p := Nat.Nat^::succ p, q := q] \as HSource;
\import \parent.Term[p := p, q := Nat.Nat^::succ q] \as VSource;
\import Modules.Hom[V := C.family.Carrier (Nat.Nat^::succ p), W := C.family.Carrier p, source := C.family.space (Nat.Nat^::succ p), target := C.family.space p] \as HMaps;
\import Modules.Hom[V := D.family.Carrier (Nat.Nat^::succ q), W := D.family.Carrier q, source := D.family.space (Nat.Nat^::succ q), target := D.family.space q] \as VMaps;
\definition dh: HMaps.Map := HMaps.Map { apply := #apply{C.differential} p, addition := #addition{C.laws} p, scalar := #scalar{C.laws} p };
\definition dv: VMaps.Map := VMaps.Map { apply := #apply{D.differential} q, addition := #addition{D.laws} q, scalar := #scalar{D.laws} q };
\import Modules.End[V := C.family.Carrier p, space := C.family.space p] \as LeftIdentity;
\import Modules.End[V := D.family.Carrier q, space := D.family.space q] \as RightIdentity;
\import Modules.Tensor[V := C.family.Carrier (Nat.Nat^::succ p), W := D.family.Carrier q, left := C.family.space (Nat.Nat^::succ p), right := D.family.space q].Mapping[U := C.family.Carrier p, Z := D.family.Carrier q, targetLeft := C.family.space p, targetRight := D.family.space q] \as Horizontal;
\import Modules.Tensor[V := C.family.Carrier p, W := D.family.Carrier (Nat.Nat^::succ q), left := C.family.space p, right := D.family.space (Nat.Nat^::succ q)].Mapping[U := C.family.Carrier p, Z := D.family.Carrier q, targetLeft := C.family.space p, targetRight := D.family.space q] \as Vertical;
\definition horizontal: Modules.Hom[V := HSource.Carrier, W := Current.Carrier, source := HSource.space, target := Current.space].Map := Horizontal.map dh RightIdentity.identity;
\definition vertical: Modules.Hom[V := VSource.Carrier, W := Current.Carrier, source := VSource.space, target := Current.space].Map := Vertical.map LeftIdentity.identity dv;
\definition horizontalOnTensor: \forall (x: C.family.Carrier (Nat.Nat^::succ p))(y: D.family.Carrier q) -> #apply{horizontal} (HSource.tensor x y) = Current.tensor (#apply{C.differential} p x) y := Horizontal.onTensor dh RightIdentity.identity;
\definition verticalOnTensor: \forall (x: C.family.Carrier p)(y: D.family.Carrier (Nat.Nat^::succ q)) -> #apply{vertical} (VSource.tensor x y) = Current.tensor x (#apply{D.differential} q y) := Vertical.onTensor LeftIdentity.identity dv;
