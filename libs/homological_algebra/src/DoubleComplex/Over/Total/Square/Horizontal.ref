\definition sourceIndex: Index (Nat.Nat^::succ (Nat.Nat^::succ n)) := index (Nat.Nat^::succ (Nat.Nat^::succ n)) (Nat.Nat^::succ (Nat.Nat^::succ p)) q;
\definition middleQ: Second (Nat.Nat^::succ n) (Nat.Nat^::succ p) := PriorStep.lowerSecond (Nat.Nat^::succ p) q;
\definition middleIndex: Index (Nat.Nat^::succ n) := index (Nat.Nat^::succ n) (Nat.Nat^::succ p) middleQ;
\definition targetQ: Second n p := NextStep.lowerSecond p middleQ;
\definition targetIndex: Index n := index n p targetQ;
\import Modules.Hom[V := C.family.Carrier p q, W := Current.Carrier, source := C.family.space p q, target := Current.space] \as Maps;
\definition injection: Maps.Map := Current.Component[i := targetIndex].injection;
\definition zero: \forall (x: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ p)) q) ->
  #apply{NextStep.horizontalTotal} (#apply{PriorStep.horizontalTotal} (#apply{(Earlier.Component[i := sourceIndex].injection)} x)) = #zero{Current.space} :=
  \fun (x: C.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ p)) q) => trans!{Current.Carrier} _ _ _
    (congr!{Middle.Carrier Current.Carrier} (#apply{NextStep.horizontalTotal}) _ _ (PriorStep.horizontalOnInjection sourceIndex x))
    (trans!{Current.Carrier} _ _ _
      (NextStep.horizontalOnInjection middleIndex (#apply{(C.differential.horizontal (Nat.Nat^::succ p) q)} x))
      (trans!{Current.Carrier} _ _ _
        (congr!{{C.family.Carrier p q} Current.Carrier} (#apply{injection}) _ _ (#horizontalZero{C.laws} p q x))
        (Maps.zeroPreserved injection)));
