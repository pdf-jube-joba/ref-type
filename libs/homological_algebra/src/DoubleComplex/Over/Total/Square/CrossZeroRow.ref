\definition Closed: \Prop := Arithmetic.add (Nat.Nat^::succ p) Nat.Nat^::zero = Nat.Nat^::succ (Nat.Nat^::succ n);
\definition sourceP(closed: Closed): First (Nat.Nat^::succ (Nat.Nat^::succ n)) Nat.Nat^::zero :=
  \into[Nat.Nat^](Nat.Nat^::succ p, { r: Nat.Nat^ \where Arithmetic.add r Nat.Nat^::zero = Nat.Nat^::succ (Nat.Nat^::succ n) }) \by { closed };
\definition sourceIndex(closed: Closed): Index (Nat.Nat^::succ (Nat.Nat^::succ n)) := reverseIndex (Nat.Nat^::succ (Nat.Nat^::succ n)) Nat.Nat^::zero (sourceP closed);
\definition middleQ(closed: Closed): Second (Nat.Nat^::succ n) p :=
  \into[Nat.Nat^](Nat.Nat^::zero, { q: Nat.Nat^ \where Arithmetic.add p q = Nat.Nat^::succ n }) \by { Natural.succInjective p (Nat.Nat^::succ n) closed };
\definition middleIndex(closed: Closed): Index (Nat.Nat^::succ n) := index (Nat.Nat^::succ n) p (middleQ closed);
\definition horizontalVerticalZero: \forall (closed: Closed)(x: C.family.Carrier (Nat.Nat^::succ p) Nat.Nat^::zero) ->
  #apply{NextStep.horizontalTotal} (#apply{PriorStep.verticalTotal} (#apply{(Earlier.Component[i := sourceIndex closed].injection)} x)) = #zero{Current.space} :=
  \fun (closed: Closed)(x: C.family.Carrier (Nat.Nat^::succ p) Nat.Nat^::zero) => trans!{Current.Carrier} _ _ _
    (congr!{Middle.Carrier Current.Carrier} (#apply{NextStep.horizontalTotal}) _ _ (PriorStep.verticalOnInjection (sourceIndex closed) x))
    (FirstMaps.zeroPreserved NextStep.horizontalTotal);
\definition verticalHorizontalZero: \forall (closed: Closed)(x: C.family.Carrier (Nat.Nat^::succ p) Nat.Nat^::zero) ->
  #apply{NextStep.verticalTotal} (#apply{PriorStep.horizontalTotal} (#apply{(Earlier.Component[i := sourceIndex closed].injection)} x)) = #zero{Current.space} :=
  \fun (closed: Closed)(x: C.family.Carrier (Nat.Nat^::succ p) Nat.Nat^::zero) => trans!{Current.Carrier} _ _ _
    (congr!{Middle.Carrier Current.Carrier} (#apply{NextStep.verticalTotal}) _ _ (PriorStep.horizontalOnInjection (sourceIndex closed) x))
    (NextStep.verticalOnInjection (middleIndex closed) (#apply{(C.differential.horizontal p Nat.Nat^::zero)} x));
\definition antiCommutes: \forall (closed: Closed)(x: C.family.Carrier (Nat.Nat^::succ p) Nat.Nat^::zero) ->
  #apply{NextStep.horizontalTotal} (#apply{PriorStep.verticalTotal} (#apply{(Earlier.Component[i := sourceIndex closed].injection)} x)) =
  #neg{Current.space} (#apply{NextStep.verticalTotal} (#apply{PriorStep.horizontalTotal} (#apply{(Earlier.Component[i := sourceIndex closed].injection)} x))) :=
  \fun (closed: Closed)(x: C.family.Carrier (Nat.Nat^::succ p) Nat.Nat^::zero) => negativeZeros _ _ (horizontalVerticalZero closed x) (verticalHorizontalZero closed x);
