\definition Closed: \Prop := Arithmetic.add Nat.Nat^::zero (Nat.Nat^::succ q) = Nat.Nat^::succ (Nat.Nat^::succ n);
\definition sourceQ(closed: Closed): Second (Nat.Nat^::succ (Nat.Nat^::succ n)) Nat.Nat^::zero :=
  \into[Nat.Nat^](Nat.Nat^::succ q, { r: Nat.Nat^ \where Arithmetic.add Nat.Nat^::zero r = Nat.Nat^::succ (Nat.Nat^::succ n) }) \by { closed };
\definition sourceIndex(closed: Closed): Index (Nat.Nat^::succ (Nat.Nat^::succ n)) := index (Nat.Nat^::succ (Nat.Nat^::succ n)) Nat.Nat^::zero (sourceQ closed);
\definition middleP(closed: Closed): First (Nat.Nat^::succ n) q :=
  \into[Nat.Nat^](Nat.Nat^::zero, { p: Nat.Nat^ \where Arithmetic.add p q = Nat.Nat^::succ n }) \by { Natural.succInjective (Arithmetic.add Nat.Nat^::zero q) (Nat.Nat^::succ n) closed };
\definition middleIndex(closed: Closed): Index (Nat.Nat^::succ n) := reverseIndex (Nat.Nat^::succ n) q (middleP closed);
\definition horizontalVerticalZero: \forall (closed: Closed)(x: C.family.Carrier Nat.Nat^::zero (Nat.Nat^::succ q)) ->
  #apply{NextStep.horizontalTotal} (#apply{PriorStep.verticalTotal} (#apply{(Earlier.Component[i := sourceIndex closed].injection)} x)) = #zero{Current.space} :=
  \fun (closed: Closed)(x: C.family.Carrier Nat.Nat^::zero (Nat.Nat^::succ q)) => trans!{Current.Carrier} _ _ _
    (congr!{Middle.Carrier Current.Carrier} (#apply{NextStep.horizontalTotal}) _ _ (PriorStep.verticalOnInjection (sourceIndex closed) x))
    (NextStep.horizontalOnInjection (middleIndex closed) (#apply{(C.differential.vertical Nat.Nat^::zero q)} x));
\definition verticalHorizontalZero: \forall (closed: Closed)(x: C.family.Carrier Nat.Nat^::zero (Nat.Nat^::succ q)) ->
  #apply{NextStep.verticalTotal} (#apply{PriorStep.horizontalTotal} (#apply{(Earlier.Component[i := sourceIndex closed].injection)} x)) = #zero{Current.space} :=
  \fun (closed: Closed)(x: C.family.Carrier Nat.Nat^::zero (Nat.Nat^::succ q)) => trans!{Current.Carrier} _ _ _
    (congr!{Middle.Carrier Current.Carrier} (#apply{NextStep.verticalTotal}) _ _ (PriorStep.horizontalOnInjection (sourceIndex closed) x))
    (FirstMaps.zeroPreserved NextStep.verticalTotal);
\definition antiCommutes: \forall (closed: Closed)(x: C.family.Carrier Nat.Nat^::zero (Nat.Nat^::succ q)) ->
  #apply{NextStep.horizontalTotal} (#apply{PriorStep.verticalTotal} (#apply{(Earlier.Component[i := sourceIndex closed].injection)} x)) =
  #neg{Current.space} (#apply{NextStep.verticalTotal} (#apply{PriorStep.horizontalTotal} (#apply{(Earlier.Component[i := sourceIndex closed].injection)} x))) :=
  \fun (closed: Closed)(x: C.family.Carrier Nat.Nat^::zero (Nat.Nat^::succ q)) => negativeZeros _ _ (horizontalVerticalZero closed x) (verticalHorizontalZero closed x);
