\import std.Alg[].Ring[] \as Ring;
\import std.Data[].Nat[] \as Nat;
\import std.Logic[].Equality[] \as Equality;
\use Equality::trans;
\use Equality::sym;
\use Equality::congr;
\module Over(R: \Set, ring: Ring.CommutativeRing[R]) {
  \definition ordinaryRing: Ring.Ring[R] := Ring.commutativeRingAsRing R ring;
  \import algebra.Module[].Over[R := R, ring := ordinaryRing] \as Modules;
  \import algebra.Module[].Commutative[R := R, ring := ring] \as Algebra;
  \import \root.NonnegativeChain[].Over[R := R, ring := ordinaryRing] \as Chains;
  \import \root.Resolution[].Over[R := R, ring := ordinaryRing] \as Resolutions;
  \import \root.DoubleComplex[].Over[R := R, ring := ordinaryRing] \as Doubles;
  \module Of(P, N: Modules.Bundle, Q: Chains.Complex);
}
