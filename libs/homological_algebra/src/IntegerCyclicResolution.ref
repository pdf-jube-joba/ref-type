\import std.Data[].Nat[] \as Nat;
\import std.Arithmetic[].Int[] \as Int;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import std.Arithmetic[].IntAlgebra[].Calculation[] \as Arithmetic;
\import std.Arithmetic[].IntAlgebra[].IntegralDomain[] \as Domain;
\import std.Alg[].Ring[] \as Rings;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality::trans;
\use Equality::sym;
\use Equality::congr;
\definition integerRing: Rings.Ring[Int.Int^] := Rings.commutativeRingAsRing Int.Int^ IntegerRing.commutativeRing;
\import algebra.Module[].Over[R := Int.Int^, ring := Rings.commutativeRingAsRing Int.Int^ IntegerRing.commutativeRing] \as Modules;
\import \root.NonnegativeChain[].Over[R := Int.Int^, ring := Rings.commutativeRingAsRing Int.Int^ IntegerRing.commutativeRing] \as Chains;
\import \root.Resolution[].Over[R := Int.Int^, ring := Rings.commutativeRingAsRing Int.Int^ IntegerRing.commutativeRing] \as Resolutions;
\import algebra.Group[].Of[Carrier := Int.Int^, group := Modules.scalarGroup] \as ScalarGroup;
\module Positive(m: Nat.Nat^);
