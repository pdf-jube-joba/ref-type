\import \parent.\parent.Tor[A := Coefficient.bundle] \as Computation;
\import \root.Tor[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing].Of[M := Cyclic.bundle, N := Coefficient.bundle, P := complex].Positive[n := Nat.Nat^::zero] \as Derived;
\import Inclusion.Annihilator[] \as Annihilator;
\import Modules.Isomorphism[V := Cyclic.Carrier, W := Annihilator.bundle.Carrier, source := Cyclic.space, target := Annihilator.bundle.space].Inverse[] \as Reverse;
\definition annihilatorIsomorphism: Modules.Isomorphism[V := Annihilator.bundle.Carrier, W := Cyclic.Carrier, source := Annihilator.bundle.space, target := Cyclic.space].Isomorphism := Reverse.inverse (Annihilator.isomorphism multiplierNonzero coefficientNonzero);
\import Modules.Isomorphism[V := Derived.Carrier, W := Annihilator.bundle.Carrier, source := Derived.space, target := Annihilator.bundle.space].Composition[U := Cyclic.Carrier, final := Cyclic.space] \as Compose;
\definition isomorphism: Modules.Isomorphism[V := Derived.Carrier, W := Cyclic.Carrier, source := Derived.space, target := Cyclic.space].Isomorphism := Compose.compose annihilatorIsomorphism Computation.isomorphism;
