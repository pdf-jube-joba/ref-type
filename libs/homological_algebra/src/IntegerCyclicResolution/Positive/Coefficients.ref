\definition coefficientMultiplier: Int.Int^ := Int.Int^::ofNat (Nat.Nat^::succ k);
\import algebra.IntegerCyclic[d := Arithmetic.mul multiplier coefficientMultiplier] \as Coefficient;
\import Cyclic.Reduction[k := coefficientMultiplier] \as Reduction;
\import Cyclic.Inclusion[k := coefficientMultiplier] \as Inclusion;
\definition projection: Modules.Hom[V := Coefficient.Carrier, W := Cyclic.Carrier, source := Coefficient.space, target := Cyclic.space].Map := Reduction.map;
\definition inclusion: Modules.Hom[V := Cyclic.Carrier, W := Coefficient.Carrier, source := Cyclic.space, target := Coefficient.space].Map := Inclusion.map;
\import std.Arithmetic[].ExtendedEuclid[].Signed[] \as Signed;
\import Nat.Basic[].Prop[] \as Naturals;
\definition multiplierNonzero: Logic.Not (multiplier = Arithmetic.zero) :=
  \fun (equal: multiplier = Arithmetic.zero) => Naturals.zeroNeSucc m
    (sym!{Nat.Nat^} _ _ (congr!{Int.Int^ Nat.Nat^} Signed.absolute _ _ equal));
\definition coefficientNonzero: Logic.Not (coefficientMultiplier = Arithmetic.zero) :=
  \fun (equal: coefficientMultiplier = Arithmetic.zero) => Naturals.zeroNeSucc k
    (sym!{Nat.Nat^} _ _ (congr!{Int.Int^ Nat.Nat^} Signed.absolute _ _ equal));
\definition inclusionInjective: \forall (x, y: Cyclic.Carrier) -> #apply{inclusion} x = #apply{inclusion} y -> x = y := Inclusion.injective coefficientNonzero;
\definition projectionOnto: \forall (q: Cyclic.Carrier) -> \exists { x: Coefficient.Carrier \where #apply{projection} x = q } := Reduction.surjective;
\module Ext;
\module Tor;
