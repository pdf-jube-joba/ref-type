\import \parent.TensorHomology[A := A] \as Computation;
\import \root.Tor[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing].Of[M := Cyclic.bundle, N := A, P := complex] \as Derived;
\definition isomorphism: Modules.Isomorphism[V := Derived.Positive[n := Nat.Nat^::zero].Carrier, W := Computation.annihilator.Carrier, source := Derived.Positive[n := Nat.Nat^::zero].space, target := Computation.annihilator.space].Isomorphism := Computation.isomorphism;
\module Higher(n: Nat.Nat^) {
  \definition vanishing: \forall (q: Derived.Positive[n := Nat.Nat^::succ n].Carrier) -> q = #zero{(Derived.Positive[n := Nat.Nat^::succ n].space)} := Computation.Higher[n := n].vanishing;
}
