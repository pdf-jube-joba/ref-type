\definition degree: Nat.Nat^ := Nat.Nat^::succ (Nat.Nat^::succ n);
\import Modules.Tensor[V := family.Carrier degree, W := A.Carrier, left := family.space degree, right := A.space] \as Current;
\import Modules.End[V := Current.Carrier, space := Current.space] \as Identity;
\import Modules.Hom[V := Current.Carrier, W := Current.Carrier, source := Current.space, target := Current.space] \as Maps;
\import Current.Universal[U := Current.Carrier, target := Current.space] \as Equality;
\definition identityZero: Identity.identity = Maps.zeroMap := Equality.ext Identity.identity Maps.zeroMap
  (\fun (r: family.Carrier degree)(a: A.Carrier) => trans!{Current.Carrier} (Current.tensor r a) (Current.tensor (zero degree) a) (#zero{Current.space})
    (congr!{{family.Carrier degree} Current.Carrier} (\fun (x: family.Carrier degree) => Current.tensor x a) r (zero degree) (highZero n r)) (Current.tensorZeroLeft a));
\definition trivial: \forall (x: Current.Carrier) -> x = #zero{Current.space} :=
  \fun (x: Current.Carrier) => congr!{Maps.Map Current.Carrier} (\fun (f: Maps.Map) => #apply{f} x) Identity.identity Maps.zeroMap identityZero;
\import Derived.Positive[n := Nat.Nat^::succ n] \as Homology;
\definition vanishing: \forall (q: Homology.Carrier) -> q = Homology.zeroClass := Homology.vanishing trivial;
