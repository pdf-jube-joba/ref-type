\import \parent.Cohomology[A := A] \as Computation;
\import \root.Ext[].Over[R := Int.Int^, ring := IntegerRing.commutativeRing].Of[M := Cyclic.bundle, N := A, P := complex] \as Derived;
\import Modules.Of[V := A.Carrier, space := A.space].Submodule[].Quotient[S := Computation.multiples] \as Quotient;
\definition degree: Nat.Nat^ := Nat.Nat^::succ Nat.Nat^::zero;
\definition isomorphism: Modules.Isomorphism[V := Derived.At[n := degree].Carrier, W := Quotient.Carrier, source := Derived.At[n := degree].space, target := Quotient.moduleSpace].Isomorphism := Computation.isomorphism;
\module Higher(n: Nat.Nat^) {
  \definition vanishing: \forall (q: Derived.At[n := Nat.Nat^::succ (Nat.Nat^::succ n)].Carrier) -> q = #zero{(Derived.At[n := Nat.Nat^::succ (Nat.Nat^::succ n)].space)} := Computation.Higher[n := n].vanishing;
}
