\import std.Alg[].Ring[] \as Ring;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\module Over(R: \Set, ring: Ring.CommutativeRing[R]) {
  \import algebra.Module[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Modules;
  \import algebra.Module[].Commutative[R := R, ring := ring] \as Algebra;
  \import \root.Chain[] \as Degrees;
  \import Degrees.Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Chains;
  \import \root.HomComplex[].Over[R := R, ring := ring] \as HomComplex;
  \module On(C: Chains.Complex, A: Modules.Bundle) {
    \import HomComplex.Integer[P := C, N := A] \as Hom;
    \module At(z: Degrees.Degree);
  }
  \module Morphism(C, D: Chains.Complex, A, B: Modules.Bundle);
}
