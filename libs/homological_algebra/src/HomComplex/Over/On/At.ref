\import Algebra.HomSpace[V := P.family.Carrier n, W := N.Carrier, source := P.family.space n, target := N.space] \as HomSpace;
\import Modules.Hom[V := P.family.Carrier n, W := N.Carrier, source := P.family.space n, target := N.space] \as Maps;
\definition Carrier: \Set := Maps.Map;
\definition space: Modules.Space Carrier := HomSpace.space;
\definition ext: \forall (f, g: Carrier) -> (\forall (x: P.family.Carrier n) -> #apply{f} x = #apply{g} x) -> f = g := Maps.ext;
\definition zeroPreserved: \forall (f: Carrier) -> #apply{f} #zero{(P.family.space n)} = #zero{N.space} := Maps.zeroPreserved;
