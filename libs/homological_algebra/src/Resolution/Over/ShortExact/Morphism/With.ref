\import \root.Resolution[].Over[R := R, ring := ring] \as Resolutions;
\import Resolutions.Comparison[M := source.middle, N := target.middle, P := source.middleComplex, Q := target.middleComplex, f := #middle{f}] \as MiddleComparison;
\import Resolutions.Comparison[M := source.right, N := target.right, P := source.rightComplex, Q := target.rightComplex, f := #right{f}] \as RightComparison;
\definition MiddleLift: \Set := \Cast[Chains.Map[C := source.middleComplex, D := target.middleComplex].Map]
  ({ b: Chains.Map[C := source.middleComplex, D := target.middleComplex].Map \where MiddleComparison.Augmented source.middleResolution target.middleResolution b });
\definition RightLift: \Set := \Cast[Chains.Map[C := source.rightComplex, D := target.rightComplex].Map]
  ({ c: Chains.Map[C := source.rightComplex, D := target.rightComplex].Map \where RightComparison.Augmented source.rightResolution target.rightResolution c });
\definition Sections: \Set := \forall (n: Nat.Nat^) -> Modules.Hom[V := target.rightComplex.family.Carrier n, W := target.middleComplex.family.Carrier n, source := target.rightComplex.family.space n, target := target.middleComplex.family.space n].Map;
\definition Splits(sections: Sections): \Prop := \forall (n: Nat.Nat^)(x: target.rightComplex.family.Carrier n) ->
  #apply{target.chainSequence.projection} n (#apply{(sections n)} x) = x;
\module Selected(b: MiddleLift, c: RightLift, sections: Sections);
\definition Section(n: Nat.Nat^): \Set := \Cast[Modules.Hom[V := target.rightComplex.family.Carrier n, W := target.middleComplex.family.Carrier n, source := target.rightComplex.family.space n, target := target.middleComplex.family.space n].Map]
  ({ s: Modules.Hom[V := target.rightComplex.family.Carrier n, W := target.middleComplex.family.Carrier n, source := target.rightComplex.family.space n, target := target.middleComplex.family.space n].Map \where
    \forall (x: target.rightComplex.family.Carrier n) -> #apply{target.chainSequence.projection} n (#apply{s} x) = x });
\definition sectionExistence: \forall (n: Nat.Nat^) -> \exists Section n :=
  \fun (n: Nat.Nat^) => #projective{target.rightResolution} n
    (target.middleComplex.family.Carrier n) (target.middleComplex.family.space n)
    (target.rightComplex.family.Carrier n) (target.rightComplex.family.space n)
    (Chains.Map[C := target.middleComplex, D := target.rightComplex].At[n := n].linear target.chainSequence.projection)
    (#onto{target.chainSequence} n) (Modules.End[V := target.rightComplex.family.Carrier n, space := target.rightComplex.family.space n].identity);
\import Resolutions.Comparison[M := source.left, N := target.left, P := source.leftComplex, Q := target.leftComplex, f := #left{f}] \as LeftComparison;
\structure LiftData: \Set {
  left: Chains.Map[C := source.leftComplex, D := target.leftComplex].Map,
  middle: Chains.Map[C := source.middleComplex, D := target.middleComplex].Map,
  right: Chains.Map[C := source.rightComplex, D := target.rightComplex].Map,
}
\structure LiftLaws[data: LiftData]: \Prop {
  leftAugmented: LeftComparison.Augmented source.leftResolution target.leftResolution data.left,
  middleAugmented: MiddleComparison.Augmented source.middleResolution target.middleResolution data.middle,
  rightAugmented: RightComparison.Augmented source.rightResolution target.rightResolution data.right,
  diagram: Chains.ShortExact[A := source.leftComplex, B := source.middleComplex, C := source.rightComplex].Morphism[
    A1 := target.leftComplex, B1 := target.middleComplex, C1 := target.rightComplex].Diagram[
      s := source.chainSequence, t := target.chainSequence, a := data.left, b := data.middle, c := data.right].Commutative,
}
\definition Lift: \Set := \Cast[LiftData] ({ data: LiftData \where LiftLaws[data] });
\definition existence: \exists Lift := \block {
  \takefrom b: MiddleLift \by MiddleComparison.existence source.middleResolution target.middleResolution \then
  \takefrom c: RightLift \by RightComparison.existence source.rightResolution target.rightResolution \then
  \takefrom selected: \forall (n: Nat.Nat^) -> Section n \by \axiom:classicalIndefiniteChoice(Nat.Nat^, Section, sectionExistence) \then
  \let sections: Sections := \fun (n: Nat.Nat^) => selected n \then
  \let splits: Splits sections := \fun (n: Nat.Nat^) =>
    \bysub(Modules.Hom[V := target.rightComplex.family.Carrier n, W := target.middleComplex.family.Carrier n, source := target.rightComplex.family.space n, target := target.middleComplex.family.space n].Map,
      { s: Modules.Hom[V := target.rightComplex.family.Carrier n, W := target.middleComplex.family.Carrier n, source := target.rightComplex.family.space n, target := target.middleComplex.family.space n].Map \where
        \forall (x: target.rightComplex.family.Carrier n) -> #apply{target.chainSequence.projection} n (#apply{s} x) = x }, selected n) \then
  \takefrom h: Chains.Homotopy[C := source.middleComplex, D := target.rightComplex].Homotopy
    Selected[b := b, c := c, sections := sections].first Selected[b := b, c := c, sections := sections].last
    \by Selected[b := b, c := c, sections := sections].homotopyExistence \then
  \let data: LiftData := LiftData {
    left := Selected[b := b, c := c, sections := sections].Corrected[h := h].left splits,
    middle := Selected[b := b, c := c, sections := sections].Corrected[h := h].middle,
    right := c,
  } \then
  \return \exact(\into[LiftData](data, { data: LiftData \where LiftLaws[data] }) \by {
    LiftLaws[data] {
      leftAugmented := Selected[b := b, c := c, sections := sections].Corrected[h := h].augmentedLeft splits,
      middleAugmented := Selected[b := b, c := c, sections := sections].Corrected[h := h].augmentedMiddle,
      rightAugmented := Selected[b := b, c := c, sections := sections].rightAugmented,
      diagram := Selected[b := b, c := c, sections := sections].Corrected[h := h].diagram splits,
    }
  }, Lift)
};
