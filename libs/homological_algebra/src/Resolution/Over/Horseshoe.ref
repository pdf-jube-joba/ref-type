\import \parent.Of[M := A, P := P] \as LeftResolution;
\import \parent.Of[M := C, P := Q] \as RightResolution;
\import Modules.ShortExact[A := A, B := B, C := C] \as Sequences;
\import \parent.Tail[M := C, P := Q] \as RightTail;
\module At(n: Nat.Nat^) {
  \import Modules.Biproduct[V := P.family.Carrier n, W := Q.family.Carrier n, left := P.family.space n, right := Q.family.space n] \as Sum;
  \definition Carrier: \Set := Sum.Carrier;
  \definition space: Modules.Space Carrier := Sum.space;
  \definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier, space := space };
}
\definition family: Chains.Family := Chains.Family {
  Carrier := \fun (n: Nat.Nat^) => At[n := n].Carrier,
  space := \fun (n: Nat.Nat^) => At[n := n].space,
};
\import Chains.Map[C := RightTail.complex, D := P] \as Twists;
\module Twisted(t: Twists.Map);
\module With(sequence: Sequences.Sequence, p: LeftResolution.Resolution, q: RightResolution.Resolution);

\definition existence: \forall (sequence: Sequences.Sequence)(p: LeftResolution.Resolution)(q: RightResolution.Resolution) ->
  \exists With[sequence := sequence, p := p, q := q].Construction :=
  \fun (sequence: Sequences.Sequence)(p: LeftResolution.Resolution)(q: RightResolution.Resolution) => With[sequence := sequence, p := p, q := q].existence;
