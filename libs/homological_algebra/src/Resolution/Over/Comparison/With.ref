\module At(n: Nat.Nat^);
\definition Initial(g: At[n := Nat.Nat^::zero].Map): \Prop :=
  \forall (x: P.family.Carrier Nat.Nat^::zero) -> #apply{#augmentation{q}} (#apply{g} x) = #apply{f} (#apply{#augmentation{p}} x);
\import Coefficient.Composition[U := P.family.Carrier Nat.Nat^::zero, domain := P.family.space Nat.Nat^::zero] \as AugmentationComposition;
\definition initialExistence: \exists { g: At[n := Nat.Nat^::zero].Map \where Initial g } :=
  #projective{p} Nat.Nat^::zero (Q.family.Carrier Nat.Nat^::zero) (Q.family.space Nat.Nat^::zero) N.Carrier N.space
    (#augmentation{q}) (#onto{q}) (AugmentationComposition.compose f (#augmentation{p}));
\definition initialRespect: \forall (g: At[n := Nat.Nat^::zero].Map) -> Initial g -> At[n := Nat.Nat^::zero].Respects g :=
  \fun (g: At[n := Nat.Nat^::zero].Map)(initial: Initial g)(x: P.family.Carrier Nat.Nat^::zero)(closed: Source.Slot[n := Nat.Nat^::zero].Member (Source.kernel p Nat.Nat^::zero) x) =>
    trans!{N.Carrier} _ _ _ (initial x)
      (trans!{N.Carrier} _ _ _ (congr!{M.Carrier N.Carrier} (#apply{f}) _ _ closed) (Coefficient.zeroPreserved f));
\definition Stage(n: Nat.Nat^): \Set := \Cast[At[n := n].Map] ({ g: At[n := n].Map \where At[n := n].Respects g });
\structure Index: \Set { degree: Nat.Nat^, stage: Stage degree }
\definition NextValue(i: Index): \Set := \Cast[At[n := Nat.Nat^::succ i.degree].Map]
  ({ g: At[n := Nat.Nat^::succ i.degree].Map \where At[n := i.degree].Commutes i.stage g });
\definition nextExists: \forall (i: Index) -> \exists NextValue i :=
  \fun (i: Index) => At[n := i.degree].existence i.stage
    (\bysub(At[n := i.degree].Map, { g: At[n := i.degree].Map \where At[n := i.degree].Respects g }, i.stage));
\module Selected(initial: \Cast[\parent.At[n := Nat.Nat^::zero].Map] ({ g: \parent.At[n := Nat.Nat^::zero].Map \where Initial g }), selected: \forall (i: Index) -> NextValue i);
\definition existence: \exists { g: Maps.Map \where Augmented p q g } := \block {
  \takefrom initial: \Cast[At[n := Nat.Nat^::zero].Map] ({ g: At[n := Nat.Nat^::zero].Map \where Initial g }) \by initialExistence \then
  \takefrom selected: \forall (i: Index) -> NextValue i \by \axiom:classicalIndefiniteChoice(Index, NextValue, nextExists) \then
  \return \exact(\into[Maps.Map](Selected[initial := initial, selected := selected].map, { g: Maps.Map \where Augmented p q g }) \by {
    Selected[initial := initial, selected := selected].augmented
  }, \Cast[Maps.Map] ({ g: Maps.Map \where Augmented p q g }))
};
