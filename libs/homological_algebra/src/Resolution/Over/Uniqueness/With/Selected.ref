\definition stages: \forall (n: Nat.Nat^) -> Stage n := \induction (n: Nat.Nat^) \return Stage n \with {
  | zero: \into[\parent.At[n := Nat.Nat^::zero].Map](initial, { h: \parent.At[n := Nat.Nat^::zero].Map \where \parent.At[n := Nat.Nat^::zero].Invariant h }) \by {
      \fun (x: P.family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) =>
        (\bysub(\parent.At[n := Nat.Nat^::zero].Map, { h: \parent.At[n := Nat.Nat^::zero].Map \where Initial h }, initial)) (#apply{P.differential} Nat.Nat^::zero x)
    }
  | succ: \fun (n: Nat.Nat^)(stage: Stage n) => \into[\parent.At[n := Nat.Nat^::succ n].Map]
      (selected (Index { degree := n, stage := stage }), { h: \parent.At[n := Nat.Nat^::succ n].Map \where \parent.At[n := Nat.Nat^::succ n].Invariant h }) \by {
        \parent.At[n := n].successorInvariant stage (selected (Index { degree := n, stage := stage }))
          (\bysub(\parent.At[n := Nat.Nat^::succ n].Map, { h: \parent.At[n := Nat.Nat^::succ n].Map \where \parent.At[n := n].Lift stage h }, selected (Index { degree := n, stage := stage })))
      }
};
\definition data: Homotopies.Data := Homotopies.Data { apply := \fun (n: Nat.Nat^) => #apply{(stages n)} };
\definition laws: Homotopies.Laws[f, g, data] := Homotopies.Laws[f, g, data] {
  addition := \fun (n: Nat.Nat^) => #addition{(stages n)},
  scalar := \fun (n: Nat.Nat^) => #scalar{(stages n)},
  zeroEquation := \fun (x: P.family.Carrier Nat.Nat^::zero) => sym!{{Q.family.Carrier Nat.Nat^::zero}} _ _
    ((\bysub(\parent.At[n := Nat.Nat^::zero].Map, { h: \parent.At[n := Nat.Nat^::zero].Map \where Initial h }, initial)) x),
  successorEquation := \fun (n: Nat.Nat^) => \parent.At[n := n].equation (stages n) (stages (Nat.Nat^::succ n))
    (\bysub(\parent.At[n := Nat.Nat^::succ n].Map,
      { h: \parent.At[n := Nat.Nat^::succ n].Map \where \parent.At[n := n].Lift (stages n) h }, selected (Index { degree := n, stage := stages n }))),
};
\definition homotopy: Homotopies.Homotopy f g := \into[Homotopies.Data](data, { h: Homotopies.Data \where Homotopies.Laws[f, g, h] }) \by { laws };
