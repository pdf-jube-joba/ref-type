\import \parent.Of[M := M, P := P] \as Original;
\module At(n: Nat.Nat^);
\definition family: Chains.Family := Chains.Family {
  Carrier := \fun (n: Nat.Nat^) => P.family.Carrier (Nat.Nat^::succ n),
  space := \fun (n: Nat.Nat^) => P.family.space (Nat.Nat^::succ n),
};
\definition differential: Chains.DifferentialData[family] := Chains.DifferentialData[family] {
  apply := \fun (n: Nat.Nat^)(x: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) =>
    #neg{(P.family.space (Nat.Nat^::succ n))} (#apply{P.differential} (Nat.Nat^::succ n) x),
};
\definition complex: Chains.Complex := Chains.Complex {
  family := family, differential := differential,
  laws := Chains.DifferentialLaws[family, differential] {
    addition := \fun (n: Nat.Nat^) => At[n := n].addition,
    scalar := \fun (n: Nat.Nat^) => At[n := n].scalar,
    squareZero := \fun (n: Nat.Nat^) => At[n := n].squareZero,
  },
};
\module With(resolution: Original.Resolution);
