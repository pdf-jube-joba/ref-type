\import std.Alg[].Ring[] \as Ring;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import category.Category[] \as Cat;
\import category.Functor[] \as Functors;
\import category.Natural[] \as Natural;
\import \root.Chain[] \as Chain;
\module Over(R: \Set, ring: Ring.Ring[R]) {
  \import Chain.Over[R := R, ring := ring] \as Chains;
  \import algebra.Module[].Over[R := R, ring := ring] \as Modules;
  \module On(Index: \Set, A, B, C: Index -> Chains.Complex,
    sequences: \forall (x: Index) -> Chains.ShortExact[A := A x, B := B x, C := C x].Sequence);
}
