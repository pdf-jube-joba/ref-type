\definition zeroObject: Index := closure.objects.zero;
\definition zero: \forall (x, y: Index) -> Hom x y := \fun (x, y: Index) => Modules.Hom[V := family.Carrier x, W := family.Carrier y, source := family.space x, target := family.space y].zeroMap;
\module ZeroObject;
\module Biproduct(x, y: Index);
\definition additive: Additive.Additive := Additive.Additive {
  preadditive := preadditive, zero := ZeroObject[].object, biproduct := \fun (x, y: Index) => Biproduct[x := x, y := y].object,
};
\module Kernel(x, y: Index, f: Hom x y);
\module Cokernel(x, y: Index, f: Hom x y);
\module Monomorphism(x, y: Index, f: Hom x y);
\module Epimorphism(x, y: Index, f: Hom x y);
\module NormalMonomorphism(x, y: Index, f: Hom x y);
\module NormalEpimorphism(x, y: Index, f: Hom x y);
\definition abelian: Abelian.Abelian := Abelian.Abelian {
  additive := additive,
  kernel := \fun (x, y: Index)(f: Hom x y) => Kernel[x := x, y := y, f := f].object,
  cokernel := \fun (x, y: Index)(f: Hom x y) => Cokernel[x := x, y := y, f := f].object,
  normalMonomorphism := \fun (x, y: Index)(f: Hom x y)(mono: Abelian.Monomorphism[Index, Hom, categoryData] x y f) => NormalMonomorphism[x := x, y := y, f := f].normal mono,
  normalEpimorphism := \fun (x, y: Index)(f: Hom x y)(epi: Abelian.Epimorphism[Index, Hom, categoryData] x y f) => NormalEpimorphism[x := x, y := y, f := f].normal epi,
};
