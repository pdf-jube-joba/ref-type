\import Modules.Of[V := family.Carrier y, space := family.space y].Submodule[] \as Sub;
\import Sub.Image[U := family.Carrier x, source := family.space x] \as Image;
\definition submodule: Sub.Submodule := Image.image f;
\import Sub.Quotient[S := submodule] \as Quotient;
\definition Carrier: \Set := Quotient.Carrier;
\definition space: Modules.Space Carrier := Quotient.moduleSpace;
\definition projection: Modules.Hom[V := family.Carrier y, W := Carrier, source := family.space y, target := space].Map := Quotient.projection;
\definition class: family.Carrier y -> Carrier := Quotient.class;
\definition classZero: \forall (u: family.Carrier y) -> \In[family.Carrier y] (#carrier{submodule}) u -> class u = #zero{space} := Quotient.classZero;
\definition zeroClassMember: \forall (u: family.Carrier y) -> class u = #zero{space} -> \In[family.Carrier y] (#carrier{submodule}) u := Quotient.zeroClassMember;
\definition onto: \forall (q: Carrier) -> \exists { u: family.Carrier y \where class u = q } := Quotient.onto;
\definition imageMember: \forall (u: family.Carrier x) -> \In[family.Carrier y] (#carrier{submodule}) (#apply{f} u) := Image.member f;
\definition imageEliminate: \forall (u: family.Carrier y)(P: \Prop) -> (\forall (v: family.Carrier x) -> #apply{f} v = u -> P) -> \In[family.Carrier y] (#carrier{submodule}) u -> P := Image.eliminate f;
\module To(z: Index) {
  \import Quotient.To[W := family.Carrier z, target := family.space z] \as Descent;
  \definition Vanishes(g: Hom y z): \Prop := Descent.Vanishes g;
  \definition descend(g: Hom y z)(vanishes: Vanishes g): Modules.Hom[V := Carrier, W := family.Carrier z, source := space, target := family.space z].Map := Descent.descend g vanishes;
  \definition onClass: \forall (g: Hom y z)(vanishes: Vanishes g)(u: family.Carrier y) -> #apply{(descend g vanishes)} (class u) = #apply{g} u := Descent.onClass;
}
