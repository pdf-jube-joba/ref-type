\import std.Data[].Nat[] \as Nat;
\import std.Arithmetic[].Int[] \as Integers;
\import std.Alg[].Ring[] \as Ring;
\import std.Logic[].Equality[] \as Equality;
\use Equality::trans;
\use Equality::sym;
\use Equality::congr;
\use Equality::congr2;
\module Over(R: \Set, ring: Ring.CommutativeRing[R]) {
  \import algebra.Module[].Commutative[R := R, ring := ring] \as Algebra;
  \import algebra.Module[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Modules;
  \import \root.NonnegativeChain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Chains;
  \module ResolutionChange(M, N: Modules.Bundle, P, Q, S: Chains.Complex);
  \module ShortExactSecond(M, A, B, C: Modules.Bundle, P: Chains.Complex);
  \module LengthOne(K, L, M, N: Modules.Bundle);
  \module ShortExactFirst(A, B, C, N: Modules.Bundle, P, Q: Chains.Complex);
  \module Projective(M, N: Modules.Bundle, P: Chains.Complex);
  \module On(M, N: Modules.Bundle);
  \module Of(M, N: Modules.Bundle, P: Chains.Complex);
  \module DegreeZero(M, N: Modules.Bundle, P: Chains.Complex);
  \module Independence(M, N: Modules.Bundle, P, Q: Chains.Complex);
  \module Second(M, N, L: Modules.Bundle, P: Chains.Complex);
  \module First(M, L, N: Modules.Bundle, P, Q: Chains.Complex);
  \module FirstIdentity(M, N: Modules.Bundle, P: Chains.Complex);
  \module SecondIdentity(M, N: Modules.Bundle, P: Chains.Complex);
  \module FirstComposition(M, L, T, N: Modules.Bundle, P, Q, S: Chains.Complex);
  \module SecondComposition(M, N, L, T: Modules.Bundle, P: Chains.Complex);
}
