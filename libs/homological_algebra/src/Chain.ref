\import \parent.Integer[] \as Index;
\import std.Arithmetic[].Int[] \as Integers;
\import std.Data[].Nat[] \as N;
\import std.Alg[].Ring[] \as Ring;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality::sym;
\use Equality::trans;
\use Equality::congr;
\use Equality::congr2;
\use Equality::eq_reason;
\definition Degree: \Set := Index.Degree;
\definition next: Degree -> Degree := Index.next;
\definition previous: Degree -> Degree := Index.previous;
\definition nextPrevious: \forall (z: Degree) -> next (previous z) = z := Index.nextPrevious;
\definition previousNext: \forall (z: Degree) -> previous (next z) = z := Index.previousNext;
\use Logic::either;
\module Over(R: \Set, ring: Ring.Ring[R]);
