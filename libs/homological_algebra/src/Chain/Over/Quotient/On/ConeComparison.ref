\import \parent.\parent.\parent.End[C := C] \as OriginalEnd;
\import \parent.\parent.\parent.Cone[C := C, D := C].On[f := OriginalEnd.identity] \as IdentityCone;
\import \parent.\parent.\parent.Cone[C := C, D := D].On[f := f] \as Cone;
\import \parent.\parent.\parent.ConeIdentity[C := C] \as Contractible;
\module At(k: Degree);
\import \parent.\parent.\parent.Map[C := IdentityCone.complex, D := Cone.complex] \as Injection;
\definition injection: Injection.Map := Injection.Map {
  apply := \fun (k: Degree) => #apply{At[k := k].injection},
  addition := \fun (k: Degree) => #addition{At[k := k].injection},
  scalar := \fun (k: Degree) => #scalar{At[k := k].injection},
  commutes := \fun (k: Degree) => At[k := k].injectionCommutes,
};
\import \parent.\parent.\parent.Map[C := Cone.complex, D := complex] \as Projection;
\definition projection: Projection.Map := Projection.Map {
  apply := \fun (k: Degree) => #apply{At[k := k].projection},
  addition := \fun (k: Degree) => #addition{At[k := k].projection},
  scalar := \fun (k: Degree) => #scalar{At[k := k].projection},
  commutes := \fun (k: Degree) => At[k := k].projectionCommutes,
};
\definition Injective: \Prop := \forall (k: Degree)(x, y: C.family.Carrier k) -> #apply{f} k x = #apply{f} k y -> x = y;
\import \parent.\parent.\parent.ShortExact[A := IdentityCone.complex, B := Cone.complex, C := complex] \as Exact;
\definition sequence(injective: Injective): Exact.Sequence := Exact.Sequence {
  inclusion := injection, projection := projection,
  injective := \fun (k: Degree) => At[k := k].injective (injective k),
  onto := \fun (k: Degree) => At[k := k].onto,
  zero := \fun (k: Degree) => At[k := k].zero,
  kernelImage := \fun (k: Degree) => At[k := k].kernelImage,
};
\definition quasiIsomorphism: Injective -> Projection.QuasiIsomorphism projection :=
  \fun (injective: Injective) => Exact.quasiProjection (sequence injective)
    (\fun (k: Degree) => Contractible.Homology[k := k].vanishes);
