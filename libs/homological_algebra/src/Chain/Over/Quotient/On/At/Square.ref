\import \parent.\parent.At[k := previous k] \as After;
\import \parent.\parent.At[k := previous (previous k)] \as Last;
\definition law: \forall (q: Carrier) -> #apply{After.differential} (#apply{differential} q) = #zero{Last.space} :=
  Quotient.induction (\fun (q: Carrier) => #apply{After.differential} (#apply{differential} q) = #zero{Last.space})
    (\fun (x: D.family.Carrier k) => trans!{Last.Carrier} _ _ _
      (congr!{After.Carrier Last.Carrier} (#apply{After.differential}) _ _ (onClass x))
      (trans!{Last.Carrier} _ _ _ (After.onClass (#apply{D.differential} k x))
        (congr!{{D.family.Carrier (previous (previous k))} Last.Carrier} Last.class _ _ (#squareZero{D.laws} k x))));
