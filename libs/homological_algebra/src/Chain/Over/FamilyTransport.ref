\import std.Set[].Transport[I := Degree] \as Transport;
\definition forward(a, b: Degree)(same: a = b): Modules.Hom[V := F.Carrier a, W := F.Carrier b, source := F.space a, target := F.space b].Map :=
  Modules.Hom[V := F.Carrier a, W := F.Carrier b, source := F.space a, target := F.space b].Map {
    apply := Transport.cast F.Carrier a b same,
    addition := \fun (x, y: F.Carrier a) => Transport.binaryNatural F.Carrier F.Carrier F.Carrier (\fun (z: Degree) => #add{(F.space z)}) a b same x y,
    scalar := \fun (r: R)(x: F.Carrier a) => Transport.natural F.Carrier F.Carrier (\fun (z: Degree) => #smul{(F.space z)} r) a b same x,
  };
\definition isomorphism(a, b: Degree)(same: a = b): Modules.Isomorphism[V := F.Carrier a, W := F.Carrier b, source := F.space a, target := F.space b].Isomorphism :=
  Modules.Isomorphism[V := F.Carrier a, W := F.Carrier b, source := F.space a, target := F.space b].Isomorphism {
    forward := forward a b same, backward := forward b a (sym!{Degree} _ _ same),
    leftInverse := Transport.castInverse F.Carrier a b same,
    rightInverse := Transport.castInverse F.Carrier b a (sym!{Degree} _ _ same),
  };
