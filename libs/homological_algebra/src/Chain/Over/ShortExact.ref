\import \parent.Map[C := A, D := B] \as Inclusion;
\import \parent.Map[C := B, D := C] \as Projection;
\structure Data: \Set { inclusion: Inclusion.Map, projection: Projection.Map }
\structure Laws[data: Data]: \Prop {
  injective: \forall (k: Degree)(x, y: A.family.Carrier k) -> #apply{data.inclusion} k x = #apply{data.inclusion} k y -> x = y,
  onto: \forall (k: Degree)(z: C.family.Carrier k) -> \exists { y: B.family.Carrier k \where #apply{data.projection} k y = z },
  zero: \forall (k: Degree)(x: A.family.Carrier k) -> #apply{data.projection} k (#apply{data.inclusion} k x) = #zero{(C.family.space k)},
  kernelImage: \forall (k: Degree)(y: B.family.Carrier k) -> #apply{data.projection} k y = #zero{(C.family.space k)} ->
    \exists { x: A.family.Carrier k \where #apply{data.inclusion} k x = y },
}
\definition Sequence: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module At(s: Sequence, k: Degree);
\module Morphism(A1, B1, C1: Complex);

\module QuasiProjection(s: Sequence);

\definition quasiProjection: \forall (s: Sequence) ->
  (\forall (k: Degree)(q: \parent.At[C := A, z := k].Homology) -> q = \parent.At[C := A, z := k].zeroClass) -> Projection.QuasiIsomorphism s.projection :=
  \fun (s: Sequence) => QuasiProjection[s := s].quasiIsomorphism;
