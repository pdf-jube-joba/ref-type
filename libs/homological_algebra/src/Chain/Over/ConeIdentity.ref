\import \parent.End[C := C] \as Original;
\import \parent.Cone[C := C, D := C].On[f := Original.identity] \as Cone;
\import \parent.End[C := Cone.complex] \as End;
\import \parent.Homotopy[C := Cone.complex, D := Cone.complex] \as Homotopies;
\import std.Set[].Transport[I := Degree] \as Transport;
\definition contraction(k: Degree)(x: Cone.Carrier k): Cone.Carrier (next k) :=
  Modules.Biproduct[V := C.family.Carrier (next k), W := C.family.Carrier (previous (next k)),
    left := C.family.space (next k), right := C.family.space (previous (next k))].make
    (#zero{(C.family.space (next k))})
    (Transport.cast C.family.Carrier k (previous (next k)) (sym!{Degree} _ _ (previousNext k)) (Cone.At[k := k].first x));
\definition data: Homotopies.Data := Homotopies.Data { apply := contraction };
\module At(k: Degree);
\definition laws: Homotopies.Laws[End.identity, End.zeroMap, data] :=
  Homotopies.Laws[End.identity, End.zeroMap, data] {
    addition := \fun (k: Degree) => At[k := k].addition,
    scalar := \fun (k: Degree) => At[k := k].scalar,
    equation := \fun (k: Degree) => At[k := k].equation,
  };
\definition homotopy: Homotopies.Homotopy End.identity End.zeroMap :=
  \into[Homotopies.Data](data, { data: Homotopies.Data \where Homotopies.Laws[End.identity, End.zeroMap, data] }) \by { laws };
\module Homology(k: Degree);
