\import \parent.At[z := z] \as Term;
\import \parent.\parent.At[C := complex, z := z] \as H;
\import H.Vanishing[] \as Vanishing;
\definition trivial: Logic.Not (z = degree) -> \forall (x: Term.Carrier) -> x = #zero{Term.space} :=
  \fun (different: Logic.Not (z = degree))(x: Term.Carrier) =>
    either!{{z = degree} "or" {x = #zero{M.space}} "either" {x = #zero{Term.space}}
      "lt:" {\fun (same: z = degree) => Logic.falseElim _ (different same)}
      "rt:" {\fun (zero: x = #zero{M.space}) => zero}
    } (\bysub(M.Carrier, #carrier{Term.submodule}, x));
\definition vanishes: Logic.Not (z = degree) -> \forall (q: H.Homology) -> q = H.zeroClass :=
  \fun (different: Logic.Not (z = degree)) => Vanishing.zero (trivial different);
\import Modules.Zero[] \as Point;
\definition isomorphism(different: Logic.Not (z = degree)): Modules.Isomorphism[V := H.Homology, W := Point.Carrier,
  source := H.homologySpace, target := Point.moduleSpace].Isomorphism := Vanishing.isomorphism (trivial different);
