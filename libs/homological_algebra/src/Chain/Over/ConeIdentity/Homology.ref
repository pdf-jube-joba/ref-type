\import \parent.\parent.At[C := Cone.complex, z := k] \as H;
\import Homotopies.At[k := k] \as Invariance;
\definition vanishes: \forall (q: H.Homology) -> q = H.zeroClass :=
  \fun (q: H.Homology) => trans!{H.Homology} _ _ _
    (sym!{H.Homology} _ _ (End.At[k := k].identityOnHomology q))
    (trans!{H.Homology} _ _ _ (Invariance.onHomology End.identity End.zeroMap homotopy q) (End.At[k := k].zeroOnHomology q));
