\definition Acyclic: \Prop := \forall (k: Degree)(q: \parent.\parent.At[C := A, z := k].Homology) ->
  q = \parent.\parent.At[C := A, z := k].zeroClass;
\module At(k: Degree);
\definition quasiIsomorphism: Acyclic -> Projection.QuasiIsomorphism s.projection :=
  \fun (acyclic: Acyclic)(k: Degree) => At[k := k].bijective acyclic;
