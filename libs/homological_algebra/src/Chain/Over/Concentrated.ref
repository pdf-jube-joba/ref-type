\module At(z: Degree);
\definition Carrier(z: Degree): \Set := At[z := z].Carrier;
\definition space(z: Degree): Modules.Space (Carrier z) := At[z := z].space;
\definition family: Family := Family { Carrier := Carrier, space := space };
\import \parent.ZeroDifferential[family := family] \as ZeroDifferential;
\definition complex: Complex := ZeroDifferential.complex;
\module Center;
\module Away(z: Degree);
