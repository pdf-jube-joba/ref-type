\definition family: Family := Family {
  Carrier := \fun (k: Degree) => C.family.Carrier (previous k),
  space := \fun (k: Degree) => C.family.space (previous k),
};
\module At(k: Degree);
\definition apply(k: Degree)(x: C.family.Carrier (previous k)): C.family.Carrier (previous (previous k)) :=
  #neg{(C.family.space (previous (previous k)))} (#apply{C.differential} (previous k) x);
\definition addition: \forall (k: Degree)(x, y: C.family.Carrier (previous k)) ->
  apply k (#add{(C.family.space (previous k))} x y) = #add{(C.family.space (previous (previous k)))} (apply k x) (apply k y) :=
  \fun (k: Degree) => #addition{(At[k := k].negative)};
\definition scalar: \forall (k: Degree)(a: R)(x: C.family.Carrier (previous k)) ->
  apply k (#smul{(C.family.space (previous k))} a x) = #smul{(C.family.space (previous (previous k)))} a (apply k x) :=
  \fun (k: Degree) => #scalar{(At[k := k].negative)};
\definition squareZero: \forall (k: Degree)(x: C.family.Carrier (previous k)) ->
  apply (previous k) (apply k x) = #zero{(C.family.space (previous (previous (previous k))))} :=
  \fun (k: Degree) => At[k := k].squareZero;
\definition differential: DifferentialData[family] := DifferentialData[family] { apply := apply };
\definition complex: Complex := Complex {
  family := family, differential := differential,
  laws := DifferentialLaws[family, differential] { addition := addition, scalar := scalar, squareZero := squareZero },
};

\module Homology(k: Degree);
