\import algebra.Module[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Modules;
\import \root.Cochain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Cochains;
\import \root.DoubleComplex[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Degrees;
\structure Family {
  Carrier: Nat.Nat^ -> Nat.Nat^ -> \Set,
  space: \forall (p, q: Nat.Nat^) -> Modules.Space (Carrier p q),
}
\structure DifferentialData[F: Family]: \Set {
  horizontal: \forall (p, q: Nat.Nat^) -> Modules.Hom[V := F.Carrier p q, W := F.Carrier (Nat.Nat^::succ p) q,
    source := F.space p q, target := F.space (Nat.Nat^::succ p) q].Map,
  vertical: \forall (p, q: Nat.Nat^) -> Modules.Hom[V := F.Carrier p q, W := F.Carrier p (Nat.Nat^::succ q),
    source := F.space p q, target := F.space p (Nat.Nat^::succ q)].Map,
}
\structure DifferentialLaws[F: Family, d: DifferentialData[F]]: \Prop {
  horizontalZero: \forall (p, q: Nat.Nat^)(x: F.Carrier p q) ->
    #apply{(d.horizontal (Nat.Nat^::succ p) q)} (#apply{(d.horizontal p q)} x) = #zero{(F.space (Nat.Nat^::succ (Nat.Nat^::succ p)) q)},
  verticalZero: \forall (p, q: Nat.Nat^)(x: F.Carrier p q) ->
    #apply{(d.vertical p (Nat.Nat^::succ q))} (#apply{(d.vertical p q)} x) = #zero{(F.space p (Nat.Nat^::succ (Nat.Nat^::succ q)))},
  commute: \forall (p, q: Nat.Nat^)(x: F.Carrier p q) ->
    #apply{(d.horizontal p (Nat.Nat^::succ q))} (#apply{(d.vertical p q)} x) =
    #apply{(d.vertical (Nat.Nat^::succ p) q)} (#apply{(d.horizontal p q)} x),
}
\structure Complex {
  family: Family,
  differential: DifferentialData[family],
  laws: DifferentialLaws[family, differential],
}
\module Tensor(C, D: Cochains.Complex);
\module Total(C: Complex);
\module Map(C, D: Complex);
\module End(C: Complex);
\module TensorMapping(C, D, E, F: Cochains.Complex);
\module TensorZero(left, right: Cochains.Family);
\module HorizontalHomotopy(C, D: Complex);
\module HomotopyLeft(C, D, E: Cochains.Complex);
\module Transpose(C: Complex);
\module Swap(C: Complex);
\module TensorSymmetry(C, D: Cochains.Complex);
\module TensorIdentity(C, D: Cochains.Complex);
\module TensorComposition(A, B, C, E: Cochains.Complex);
\module TensorEquivalence(C, D, E: Cochains.Complex);
\module CycleProduct(C, D: Cochains.Complex, p, q: Nat.Nat^);
\module RightCycleBoundary(C, D: Cochains.Complex, p: Nat.Nat^);
\module CycleProductRightDescent(C, D: Cochains.Complex, p, q: Nat.Nat^);
\module CycleProductNaturality(C, D, E, F: Cochains.Complex, p, q: Nat.Nat^);
\module IndexedCycleProduct(C, D: Cochains.Complex, n: Nat.Nat^);
\module LeftCycleBoundary(C, D: Cochains.Complex, q: Nat.Nat^);
\module Exterior(C, D: Cochains.Complex, p, q: Nat.Nat^);
