\import Mapping.With[f := f, g := g] \as TensorMap;
\import TensorMap.Degree[p := p, q := q] \as TermMap;
\import Native.Total[f := TensorMap.map].Degree[n := n] \as TotalMap;
\definition onClass: \forall (x: SC.CycleCarrier)(y: SE.CycleCarrier) ->
  #apply{(Induced.induced TensorMap.total)} (Source.classOf x y) =
  Target.classOf (#apply{(Left.cyclesMap f)} x) (#apply{(Right.cyclesMap g)} y) :=
  \fun (x: SC.CycleCarrier)(y: SE.CycleCarrier) => trans!{H.Cohomology}
    (#apply{(Induced.induced TensorMap.total)} (Source.classOf x y))
    (H.classOf (#apply{(Induced.cyclesMap TensorMap.total)} (Source.cycle x y)))
    (Target.classOf (#apply{(Left.cyclesMap f)} x) (#apply{(Right.cyclesMap g)} y))
    (Induced.onClass TensorMap.total (Source.cycle x y))
    (H.equalClass (#apply{(Induced.cyclesMap TensorMap.total)} (Source.cycle x y))
      (Target.cycle (#apply{(Left.cyclesMap f)} x) (#apply{(Right.cyclesMap g)} y))
      (trans!{Current.Carrier}
        (#apply{TensorMap.total} n (Source.value x y))
        (#apply{Inclusion.injection} (#apply{TermMap.map} (STerm.tensor x y)))
        (Target.value (#apply{(Left.cyclesMap f)} x) (#apply{(Right.cyclesMap g)} y))
        (TotalMap.onInjection Source.index (STerm.tensor x y))
        (congr!{TTerm.Carrier Current.Carrier} (#apply{Inclusion.injection}) _ _ (TermMap.onTensor x y))));
\module RightDescent;
\module Exterior;
