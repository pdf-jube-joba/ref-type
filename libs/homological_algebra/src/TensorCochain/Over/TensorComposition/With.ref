\import \parent.\parent.Tensor[C := A, D := E] \as SourceTensor;
\import \parent.\parent.Tensor[C := B, D := E] \as MiddleTensor;
\import \parent.\parent.Tensor[C := C, D := E] \as TargetTensor;
\import \parent.\parent.Total[C := SourceTensor.complex] \as Source;
\import \parent.\parent.Total[C := MiddleTensor.complex] \as Middle;
\import \parent.\parent.Total[C := TargetTensor.complex] \as Target;
\definition identity: Cochains.Map[C := E, D := E].Map := Cochains.End[C := E].identity;
\definition composed: Cochains.Map[C := A, D := C].Map := Compose.compose g f;
\import \parent.\parent.TensorMapping[C := A, D := B, E := E, F := E].With[f := f, g := identity] \as F;
\import \parent.\parent.TensorMapping[C := B, D := C, E := E, F := E].With[f := g, g := identity] \as G;
\import \parent.\parent.TensorMapping[C := A, D := C, E := E, F := E].With[f := composed, g := identity] \as H;
\import \parent.\parent.Map[C := SourceTensor.complex, D := MiddleTensor.complex].Total[f := F.map] \as FT;
\import \parent.\parent.Map[C := MiddleTensor.complex, D := TargetTensor.complex].Total[f := G.map] \as GT;
\import \parent.\parent.Map[C := SourceTensor.complex, D := TargetTensor.complex].Total[f := H.map] \as HT;
\module Degree(n: Nat.Nat^);
\import Cochains.Map[C := Middle.complex, D := Target.complex].Composition[B := Source.complex] \as TotalComposition;
\import Cochains.Map[C := Source.complex, D := Target.complex] \as Maps;
\definition map: Maps.Map := H.total;
\definition equality: TotalComposition.compose G.total F.total = H.total :=
  Maps.ext (TotalComposition.compose G.total F.total) H.total (\fun (n: Nat.Nat^) => Degree[n := n].point);
