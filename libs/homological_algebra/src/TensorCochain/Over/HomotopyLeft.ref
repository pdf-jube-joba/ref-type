\import Cochains.Map[C := C, D := D] \as Maps;
\import Cochains.Homotopy[C := C, D := D] \as Homotopies;
\import \parent.Tensor[C := C, D := E] \as SourceTensor;
\import \parent.Tensor[C := D, D := E] \as TargetTensor;
\import \parent.Total[C := SourceTensor.complex] \as Source;
\import \parent.Total[C := TargetTensor.complex] \as Target;
\import Cochains.Homotopy[C := Source.complex, D := Target.complex] \as Result;
\module With(f, g: Maps.Map, h: Homotopies.Homotopy f g);
