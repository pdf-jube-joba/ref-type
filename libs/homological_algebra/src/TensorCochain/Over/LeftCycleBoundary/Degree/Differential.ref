\definition horizontal: \forall (a: C.family.Carrier p)(y: Right.CycleCarrier) ->
  #apply{Step.horizontal} (lift a y) = #apply{HInclusion.injection} (HTerm.tensor (#apply{C.differential} p a) y) :=
  \fun (a: C.family.Carrier p)(y: Right.CycleCarrier) => trans!{Current.Carrier} _ _ _
    (Step.horizontalOnInjection index (Term.tensor a y))
    (congr!{HTerm.Carrier Current.Carrier} (#apply{HInclusion.injection}) _ _ (Differential.horizontalOnTensor a y));
\definition vertical: \forall (a: C.family.Carrier p)(y: Right.CycleCarrier) ->
  #apply{Step.vertical} (lift a y) = #zero{Current.space} :=
  \fun (a: C.family.Carrier p)(y: Right.CycleCarrier) => trans!{Current.Carrier} _ _ _
    (Step.verticalOnInjection index (Term.tensor a y))
    (trans!{Current.Carrier} _ _ _
      (congr!{VTerm.Carrier Current.Carrier} (\fun (v: VTerm.Carrier) => #apply{VInclusion.injection} (#apply{(Sign.map p)} v)) _ _
        (trans!{VTerm.Carrier} _ _ _ (Differential.verticalOnTensor a y)
          (trans!{VTerm.Carrier} _ _ _
            (congr!{{D.family.Carrier (Nat.Nat^::succ q)} VTerm.Carrier} (VTerm.tensor a) _ _
              (\bysub(D.family.Carrier q, #carrier{Right.cycles}, y)))
            (VTerm.zeroRight a))))
      (trans!{Current.Carrier} _ _ _
        (congr!{VTerm.Carrier Current.Carrier} (#apply{VInclusion.injection}) _ _ (Signs.zeroPreserved (Sign.map p)))
        (VMaps.zeroPreserved VInclusion.injection)));
\definition value: \forall (a: C.family.Carrier p)(y: Right.CycleCarrier) ->
  #apply{Total.differential} n (lift a y) = #apply{HInclusion.injection} (HTerm.tensor (#apply{C.differential} p a) y) :=
  \fun (a: C.family.Carrier p)(y: Right.CycleCarrier) => trans!{Current.Carrier} _ _ _
    (congr2!{Current.Carrier Current.Carrier Current.Carrier} (#add{Current.space})
      (#apply{Step.horizontal} (lift a y)) (#apply{HInclusion.injection} (HTerm.tensor (#apply{C.differential} p a) y))
      (#apply{Step.vertical} (lift a y)) #zero{Current.space}
      (horizontal a y) (vertical a y))
    (Group.zeroRight (#apply{HInclusion.injection} (HTerm.tensor (#apply{C.differential} p a) y)));
