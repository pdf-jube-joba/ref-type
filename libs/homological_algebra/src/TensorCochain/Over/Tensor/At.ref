\import Modules.Tensor[V := C.family.Carrier p, W := D.family.Carrier q, left := C.family.space p, right := D.family.space q] \as Current;
\import Current.Mapping[U := C.family.Carrier (Nat.Nat^::succ p), Z := D.family.Carrier q,
  targetLeft := C.family.space (Nat.Nat^::succ p), targetRight := D.family.space q] \as H;
\import Current.Mapping[U := C.family.Carrier p, Z := D.family.Carrier (Nat.Nat^::succ q),
  targetLeft := C.family.space p, targetRight := D.family.space (Nat.Nat^::succ q)] \as V;
\import Modules.Hom[V := C.family.Carrier p, W := C.family.Carrier (Nat.Nat^::succ p), source := C.family.space p, target := C.family.space (Nat.Nat^::succ p)] \as Left;
\definition left: Left.Map := Left.Map { apply := #apply{C.differential} p, addition := #addition{C.laws} p, scalar := #scalar{C.laws} p };
\import Modules.Hom[V := D.family.Carrier q, W := D.family.Carrier (Nat.Nat^::succ q), source := D.family.space q, target := D.family.space (Nat.Nat^::succ q)] \as Right;
\definition right: Right.Map := Right.Map { apply := #apply{D.differential} q, addition := #addition{D.laws} q, scalar := #scalar{D.laws} q };
\import Modules.End[V := C.family.Carrier p, space := C.family.space p] \as LeftIdentity;
\import Modules.End[V := D.family.Carrier q, space := D.family.space q] \as RightIdentity;
\definition horizontal: Modules.Hom[V := Current.Carrier, W := \parent.Term[p := Nat.Nat^::succ p, q := q].Carrier, source := Current.space, target := \parent.Term[p := Nat.Nat^::succ p, q := q].space].Map := H.map left RightIdentity.identity;
\definition vertical: Modules.Hom[V := Current.Carrier, W := \parent.Term[p := p, q := Nat.Nat^::succ q].Carrier, source := Current.space, target := \parent.Term[p := p, q := Nat.Nat^::succ q].space].Map := V.map LeftIdentity.identity right;
\definition horizontalOnTensor: \forall (x: C.family.Carrier p)(y: D.family.Carrier q) ->
  #apply{horizontal} (Current.tensor x y) = \parent.Term[p := Nat.Nat^::succ p, q := q].tensor (#apply{C.differential} p x) y :=
  H.onTensor left RightIdentity.identity;
\definition verticalOnTensor: \forall (x: C.family.Carrier p)(y: D.family.Carrier q) ->
  #apply{vertical} (Current.tensor x y) = \parent.Term[p := p, q := Nat.Nat^::succ q].tensor x (#apply{D.differential} q y) :=
  V.onTensor LeftIdentity.identity right;
