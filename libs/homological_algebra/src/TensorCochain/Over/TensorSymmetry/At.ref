\import \parent.\parent.Swap[C := Original.complex].At[n := n] \as Swap;
\import Inverse.With[g := inverse].At[n := n] \as Symmetry;
\import \parent.\parent.Total[C := Original.complex] \as SourceTotal;
\import \parent.\parent.Total[C := Transposed.complex] \as MiddleTotal;
\import \parent.\parent.Total[C := Target.complex] \as TargetTotal;
\import Cochains.At[C := SourceTotal.complex, k := n] \as Source;
\import Cochains.At[C := MiddleTotal.complex, k := n] \as Middle;
\import Cochains.At[C := TargetTotal.complex, k := n] \as Final;
\import Modules.Isomorphism[V := Source.Cohomology, W := Middle.Cohomology,
  source := Source.cohomologySpace, target := Middle.cohomologySpace].Composition[
  U := Final.Cohomology, final := Final.cohomologySpace] \as Compose;
\definition isomorphism: Modules.Isomorphism[V := Source.Cohomology, W := Final.Cohomology,
  source := Source.cohomologySpace, target := Final.cohomologySpace].Isomorphism := Compose.compose Symmetry.isomorphism Swap.isomorphism;
