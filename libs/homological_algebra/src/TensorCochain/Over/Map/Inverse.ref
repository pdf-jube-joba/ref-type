\definition Data: \Set := \forall (p, q: Nat.Nat^) ->
  Modules.Hom[V := D.family.Carrier p q, W := C.family.Carrier p q, source := D.family.space p q, target := C.family.space p q].Map;
\structure Laws[data: Data]: \Prop {
  left: \forall (p, q: Nat.Nat^)(x: C.family.Carrier p q) -> #apply{(data p q)} (#apply{(f p q)} x) = x,
  right: \forall (p, q: Nat.Nat^)(x: D.family.Carrier p q) -> #apply{(f p q)} (#apply{(data p q)} x) = x,
}
\definition Inverse: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module With(g: Inverse);
