\import \parent.Map[C := C, D := D] \as Maps;
\definition Data: \Set := \forall (p, q: Nat.Nat^) ->
  Modules.Hom[V := C.family.Carrier (Nat.Nat^::succ p) q, W := D.family.Carrier p q,
    source := C.family.space (Nat.Nat^::succ p) q, target := D.family.space p q].Map;
\structure Laws[f, g: Maps.Map, h: Data]: \Prop {
  degreeZero: \forall (q: Nat.Nat^)(x: C.family.Carrier Nat.Nat^::zero q) ->
    #add{(D.family.space Nat.Nat^::zero q)} (#apply{(f Nat.Nat^::zero q)} x)
      (#neg{(D.family.space Nat.Nat^::zero q)} (#apply{(g Nat.Nat^::zero q)} x)) =
        #apply{(h Nat.Nat^::zero q)} (#apply{(C.differential.horizontal Nat.Nat^::zero q)} x),
  positive: \forall (p, q: Nat.Nat^)(x: C.family.Carrier (Nat.Nat^::succ p) q) ->
    #add{(D.family.space (Nat.Nat^::succ p) q)} (#apply{(f (Nat.Nat^::succ p) q)} x)
      (#neg{(D.family.space (Nat.Nat^::succ p) q)} (#apply{(g (Nat.Nat^::succ p) q)} x)) =
    #add{(D.family.space (Nat.Nat^::succ p) q)} (#apply{(D.differential.horizontal p q)} (#apply{(h p q)} x))
      (#apply{(h (Nat.Nat^::succ p) q)} (#apply{(C.differential.horizontal (Nat.Nat^::succ p) q)} x)),
  vertical: \forall (p, q: Nat.Nat^)(x: C.family.Carrier (Nat.Nat^::succ p) q) ->
    #apply{(D.differential.vertical p q)} (#apply{(h p q)} x) =
      #apply{(h p (Nat.Nat^::succ q))} (#apply{(C.differential.vertical (Nat.Nat^::succ p) q)} x),
}
\definition Homotopy(f, g: Maps.Map): \Set := \Cast[Data] ({ h: Data \where Laws[f, g, h] });

\module With(f, g: Maps.Map, h: Homotopy f g);
