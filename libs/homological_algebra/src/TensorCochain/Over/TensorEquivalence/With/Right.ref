\import Cochains.Map[C := C, D := D].Composition[B := D] \as Composition;
\definition identity: Cochains.Map[C := D, D := D].Map := Cochains.End[C := D].identity;
\definition composed: Cochains.Map[C := D, D := D].Map := Composition.compose e.forward e.backward;
\import \root.TensorCochain[].Over[R := R, ring := ring].HomotopyLeft[C := D, D := D, E := E].With[
  f := identity, g := composed, h := e.right] \as Transfer;
\import \root.TensorCochain[].Over[R := R, ring := ring].TensorIdentity[C := D, D := E] \as Identity;
\import \root.TensorCochain[].Over[R := R, ring := ring].TensorComposition[A := D, B := C, C := D, E := E].With[
  f := e.backward, g := e.forward] \as TensorComposition;
\import Cochains.Map[C := Target.complex, D := Target.complex] \as Maps;
\import Cochains.Homotopy[C := Target.complex, D := Target.complex] \as Homotopies;
\definition endIdentity: Maps.Map := Cochains.End[C := Target.complex].identity;
\import Cochains.Map[C := Source.complex, D := Target.complex].Composition[B := Target.complex] \as EndComposition;
\definition endComposed: Maps.Map := EndComposition.compose Forward.total Backward.total;
\definition data: Homotopies.Data := Transfer.homotopy;
\definition transferLaws: Homotopies.Laws[Identity.map, TensorComposition.map, data] :=
  \bysub(Homotopies.Data, { h: Homotopies.Data \where Homotopies.Laws[Identity.map, TensorComposition.map, h] }, Transfer.homotopy);
\definition laws: Homotopies.Laws[endIdentity, endComposed, data] := Homotopies.Laws[endIdentity, endComposed, data] {
  degreeZero := \fun (x: Target.family.Carrier Nat.Nat^::zero) => trans!{{Target.family.Carrier Nat.Nat^::zero}} _ _ _
    (congr2!{{Target.family.Carrier Nat.Nat^::zero} {Target.family.Carrier Nat.Nat^::zero} {Target.family.Carrier Nat.Nat^::zero}}
      (\fun (a, b: Target.family.Carrier Nat.Nat^::zero) => #add{(Target.family.space Nat.Nat^::zero)} a (#neg{(Target.family.space Nat.Nat^::zero)} b)) _ _ _ _
      (sym!{{Target.family.Carrier Nat.Nat^::zero}} _ _ (Identity.Degree[n := Nat.Nat^::zero].point x))
      (TensorComposition.Degree[n := Nat.Nat^::zero].point x))
    (#degreeZero{transferLaws} x),
  positive := \fun (n: Nat.Nat^)(x: Target.family.Carrier (Nat.Nat^::succ n)) => trans!{{Target.family.Carrier (Nat.Nat^::succ n)}} _ _ _
    (congr2!{{Target.family.Carrier (Nat.Nat^::succ n)} {Target.family.Carrier (Nat.Nat^::succ n)} {Target.family.Carrier (Nat.Nat^::succ n)}}
      (\fun (a, b: Target.family.Carrier (Nat.Nat^::succ n)) => #add{(Target.family.space (Nat.Nat^::succ n))} a (#neg{(Target.family.space (Nat.Nat^::succ n))} b)) _ _ _ _
      (sym!{{Target.family.Carrier (Nat.Nat^::succ n)}} _ _ (Identity.Degree[n := Nat.Nat^::succ n].point x))
      (TensorComposition.Degree[n := Nat.Nat^::succ n].point x))
    (#positive{transferLaws} n x),
};
\definition homotopy: Homotopies.Homotopy endIdentity endComposed :=
  \into[Homotopies.Data](data, { h: Homotopies.Data \where Homotopies.Laws[endIdentity, endComposed, h] }) \by { laws };
