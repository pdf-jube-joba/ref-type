\definition horizontal: \forall (x: Left.CycleCarrier)(a: D.family.Carrier q) ->
  #apply{Step.horizontal} (lift x a) = #zero{Current.space} :=
  \fun (x: Left.CycleCarrier)(a: D.family.Carrier q) => trans!{Current.Carrier}
    (#apply{Step.horizontal} (lift x a)) (#apply{HInclusion.injection} #zero{HTerm.space}) #zero{Current.space}
    (trans!{Current.Carrier} _ _ _ (Step.horizontalOnInjection index (#apply{(Sign.map p)} (Term.tensor x a)))
      (congr!{HTerm.Carrier Current.Carrier} (#apply{HInclusion.injection}) _ _
        (trans!{HTerm.Carrier} _ _ _ (HorizontalSign.naturality Differential.horizontal p (Term.tensor x a))
          (trans!{HTerm.Carrier} _ _ _
            (congr!{HTerm.Carrier HTerm.Carrier} (#apply{(HSign.map p)}) _ _
              (trans!{HTerm.Carrier} _ _ _ (Differential.horizontalOnTensor x a)
                (trans!{HTerm.Carrier} _ _ _
                  (congr!{{C.family.Carrier (Nat.Nat^::succ p)} HTerm.Carrier}
                    (\fun (v: C.family.Carrier (Nat.Nat^::succ p)) => HTerm.tensor v a) _ _
                    (\bysub(C.family.Carrier p, #carrier{Left.cycles}, x)))
                  (HTerm.zeroLeft a))))
            (HSigns.zeroPreserved (HSign.map p))))))
    (HMaps.zeroPreserved HInclusion.injection);
\definition vertical: \forall (x: Left.CycleCarrier)(a: D.family.Carrier q) ->
  #apply{Step.vertical} (lift x a) = #apply{VInclusion.injection} (VTerm.tensor x (#apply{D.differential} q a)) :=
  \fun (x: Left.CycleCarrier)(a: D.family.Carrier q) => trans!{Current.Carrier} _ _ _
    (Step.verticalOnInjection index (#apply{(Sign.map p)} (Term.tensor x a)))
    (congr!{VTerm.Carrier Current.Carrier} (#apply{VInclusion.injection}) _ _
      (trans!{VTerm.Carrier} _ _ _
        (congr!{VTerm.Carrier VTerm.Carrier} (#apply{(VSign.map p)}) _ _
          (VerticalSign.naturality Differential.vertical p (Term.tensor x a)))
        (trans!{VTerm.Carrier} _ _ _ (VSign.involutive p (#apply{Differential.vertical} (Term.tensor x a)))
          (Differential.verticalOnTensor x a))));
\definition value: \forall (x: Left.CycleCarrier)(a: D.family.Carrier q) ->
  #apply{Total.differential} n (lift x a) = #apply{VInclusion.injection} (VTerm.tensor x (#apply{D.differential} q a)) :=
  \fun (x: Left.CycleCarrier)(a: D.family.Carrier q) => trans!{Current.Carrier}
    (#apply{Total.differential} n (lift x a))
    (#add{Current.space} #zero{Current.space} (#apply{VInclusion.injection} (VTerm.tensor x (#apply{D.differential} q a))))
    (#apply{VInclusion.injection} (VTerm.tensor x (#apply{D.differential} q a)))
    (congr2!{Current.Carrier Current.Carrier Current.Carrier} (#add{Current.space})
      (#apply{Step.horizontal} (lift x a)) #zero{Current.space}
      (#apply{Step.vertical} (lift x a)) (#apply{VInclusion.injection} (VTerm.tensor x (#apply{D.differential} q a)))
      (horizontal x a) (vertical x a))
    (Group.zeroLeft (#apply{VInclusion.injection} (VTerm.tensor x (#apply{D.differential} q a))));
