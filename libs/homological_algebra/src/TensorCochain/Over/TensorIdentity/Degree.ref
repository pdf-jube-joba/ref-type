\import Total.Degree[n := n] \as TD;
\import InducedTotal.Degree[n := n] \as ID;
\module Component(p, q: Nat.Nat^) {
  \import Modules.Tensor[V := C.family.Carrier p, W := D.family.Carrier q, left := C.family.space p, right := D.family.space q] \as T;
  \import Induced.Degree[p := p, q := q] \as Map;
  \import Modules.End[V := T.Carrier, space := T.space] \as End;
  \import T.Universal[U := T.Carrier, target := T.space] \as Equality;
  \definition equality: Map.map = End.identity := Equality.ext Map.map End.identity Map.onTensor;
  \definition point: \forall (x: T.Carrier) -> #apply{Map.map} x = x :=
    \fun (x: T.Carrier) => congr!{{Modules.Hom[V := T.Carrier, W := T.Carrier, source := T.space, target := T.space].Map} T.Carrier}
      (\fun (f: Modules.Hom[V := T.Carrier, W := T.Carrier, source := T.space, target := T.space].Map) => #apply{f} x) _ _ equality;
}
\import Modules.End[V := TD.Carrier, space := TD.space] \as End;
\import Modules.DirectSum[Index := Degrees.Index n, family := TD.family].To[W := TD.Carrier, target := TD.space] \as Universal;
\definition equality: ID.map = End.identity := Universal.ext ID.map End.identity
  (\fun (i: Degrees.Index n)(x: Tensor.family.Carrier #first{i} #second{i}) =>
    trans!{TD.Carrier}
      (#apply{ID.map} (#apply{(TD.Component[i := i].injection)} x))
      (#apply{(TD.Component[i := i].injection)} (#apply{(Induced.data #first{i} #second{i})} x))
      (#apply{(TD.Component[i := i].injection)} x)
      (ID.onInjection i x)
      (congr!{{Tensor.family.Carrier #first{i} #second{i}} TD.Carrier}
        (#apply{(TD.Component[i := i].injection)}) (#apply{(Induced.data #first{i} #second{i})} x) x
        (Component[p := #first{i}, q := #second{i}].point x)));
\definition point: \forall (x: TD.Carrier) -> #apply{ID.map} x = x :=
  \fun (x: TD.Carrier) => congr!{{Modules.Hom[V := TD.Carrier, W := TD.Carrier, source := TD.space, target := TD.space].Map} TD.Carrier}
    (\fun (f: Modules.Hom[V := TD.Carrier, W := TD.Carrier, source := TD.space, target := TD.space].Map) => #apply{f} x) _ _ equality;
