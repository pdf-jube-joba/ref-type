\import \parent.Transpose[C := C] \as Transposed;
\import \parent.Total[C := C] \as Source;
\import \parent.Total[C := Transposed.complex] \as Target;
\definition index(n: Nat.Nat^)(i: Source.Index n): Target.Index n :=
  \into[Degrees.Pair](Degrees.Pair { first := #second{i}, second := #first{i} },
    { j: Degrees.Pair \where Arithmetic.add #first{j} #second{j} = n }) \by {
      trans!{Nat.Nat^} _ _ _ (Natural.addComm #second{i} #first{i}) (Degrees.degree n i)
    };
\module Degree(n: Nat.Nat^);
\module Step(n: Nat.Nat^);
\import Cochains.Map[C := Source.complex, D := Target.complex] \as Forward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (n: Nat.Nat^) => #apply{(Degree[n := n].forward)},
  addition := \fun (n: Nat.Nat^) => #addition{(Degree[n := n].forward)},
  scalar := \fun (n: Nat.Nat^) => #scalar{(Degree[n := n].forward)},
  commutes := \fun (n: Nat.Nat^) => Step[n := n].commutes,
};
\import Cochains.Map[C := Target.complex, D := Source.complex] \as Backward;
\definition backward: Backward.Map := Backward.Map {
  apply := \fun (n: Nat.Nat^) => #apply{(Degree[n := n].backward)},
  addition := \fun (n: Nat.Nat^) => #addition{(Degree[n := n].backward)},
  scalar := \fun (n: Nat.Nat^) => #scalar{(Degree[n := n].backward)},
  commutes := \fun (n: Nat.Nat^) => Step[n := n].backwardCommutes,
};
\module At(n: Nat.Nat^);
