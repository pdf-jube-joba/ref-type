\import SourceSequence.At[n := n] \as Source;
\import TargetSequence.At[n := n] \as TargetConnecting;
\import IntegerDiagram.At[k := Signed.Int^::ofNat n] \as IntegerNaturality;
\import ExtendedRight.Naturality[n := n] \as RightNaturality;
\import ExtendedLeft.Naturality[n := N.Nat^::succ n] \as LeftNaturality;
\import CL.PositiveCohomology[n := n] \as SourceComparison;
\import CR.PositiveCohomology[n := n] \as TargetComparison;
\import AL.PositiveCohomology[n := N.Nat^::succ n] \as SourceNext;
\import AR.PositiveCohomology[n := N.Nat^::succ n] \as TargetNext;
\import \parent.\parent.\parent.\parent.At[C := C, k := n] \as HC;
\import \parent.\parent.\parent.\parent.At[C := A1, k := N.Nat^::succ n] \as HA;
\import RightMap.At[k := n] \as Right;
\import LeftMap.At[k := N.Nat^::succ n] \as Left;
\import Internal.Map[C := CL.complex, D := CR.complex].At[k := Signed.Int^::ofNat n] \as IntegerRight;
\import Internal.Map[C := AL.complex, D := AR.complex].At[k := Integers.next (Signed.Int^::ofNat n)] \as IntegerLeft;
\import Internal.ShortExact[A := AL.complex, B := BL.complex, C := CL.complex].At[s := SourceSequence.sequence, k := Signed.Int^::ofNat n] \as IntegerSource;
\import Internal.ShortExact[A := AR.complex, B := BR.complex, C := CR.complex].At[s := TargetSequence.sequence, k := Signed.Int^::ofNat n] \as IntegerTarget;
\import Internal.At[C := CR.complex, z := Signed.Int^::ofNat n] \as HCR;
\import Internal.At[C := AR.complex, z := Integers.next (Signed.Int^::ofNat n)] \as HAR;
\definition naturality: Commutative -> \forall (q: HC.Cohomology) ->
  #apply{TargetConnecting.connecting} (#apply{(Right.induced c)} q) = #apply{(Left.induced a)} (#apply{Source.connecting} q) :=
  \fun (diagram: Commutative)(q: HC.Cohomology) => trans!{HA.Cohomology} _ _ _
    (congr!{HCR.Cohomology HA.Cohomology} (\fun (u: HCR.Cohomology) => #apply{TargetNext.forward} (#apply{IntegerTarget.connecting} u)) _ _
      (sym!{HCR.Cohomology} _ _ (RightNaturality.inverseCommutes q)))
    (trans!{HA.Cohomology} _ _ _
      (congr!{HAR.Cohomology HA.Cohomology} (#apply{TargetNext.forward}) _ _ (IntegerNaturality.naturality (integerCommutative diagram) (#apply{SourceComparison.backward} q)))
      (LeftNaturality.commutes (#apply{IntegerSource.connecting} (#apply{SourceComparison.backward} q))));
