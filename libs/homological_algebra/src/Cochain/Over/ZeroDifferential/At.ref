\import \parent.\parent.At[C := complex, k := k] \as Homology;
\definition allBoundariesZero: \forall (j: N.Nat^)(x: family.Carrier j) ->
  \In[family.Carrier j] (Homology.Boundaries j) x -> x = #zero{(family.space j)} :=
  \induction (j: N.Nat^) \return \forall (x: family.Carrier j) ->
    \In[family.Carrier j] (Homology.Boundaries j) x -> x = #zero{(family.space j)} \with {
    | zero: \fun (x: family.Carrier N.Nat^::zero)(closed: x = #zero{(family.space N.Nat^::zero)}) => closed
    | succ: \block {
      \fun (j: N.Nat^)(previous: \forall (x: family.Carrier j) -> \In[family.Carrier j] (Homology.Boundaries j) x -> x = #zero{(family.space j)})
        (x: family.Carrier (next j))(member: \In[family.Carrier (next j)] (Homology.Boundaries (next j)) x) \then
      \takefrom y: \Cast[family.Carrier j] ({ y: family.Carrier j \where #zero{(family.space (next j))} = x }) \by member \then
      \return sym!{{family.Carrier (next j)}} _ _
        (\bysub(family.Carrier j, { y: family.Carrier j \where #zero{(family.space (next j))} = x }, y))
    }
  };
\definition boundaryZero: \forall (x: family.Carrier k) ->
  \In[family.Carrier k] (#carrier{Homology.boundaries}) x -> x = #zero{(family.space k)} := allBoundariesZero k;
\import Modules.Hom[V := family.Carrier k, W := Homology.CycleCarrier, source := family.space k, target := Homology.cycleSpace] \as IntoCycles;
\definition cycles: IntoCycles.Map := IntoCycles.Map {
  apply := \fun (x: family.Carrier k) => Homology.cycle x (\refl(#zero{(family.space (next k))})),
  addition := \fun (x, y: family.Carrier k) => \refl(#add{(family.space k)} x y),
  scalar := \fun (a: R)(x: family.Carrier k) => \refl(#smul{(family.space k)} a x),
};
\import Modules.Hom[V := Homology.CycleCarrier, W := Homology.Cohomology, source := Homology.cycleSpace, target := Homology.cohomologySpace] \as Classes;
\import Classes.Composition[U := family.Carrier k, domain := family.space k] \as Composition;
\import Modules.Hom[V := family.Carrier k, W := Homology.Cohomology, source := family.space k, target := Homology.cohomologySpace] \as Forward;
\definition forward: Forward.Map := Composition.compose Homology.classLinear cycles;
\import Modules.Hom[V := Homology.CycleCarrier, W := family.Carrier k, source := Homology.cycleSpace, target := family.space k] \as Forget;
\definition forget: Forget.Map := Forget.Map {
  apply := \fun (x: Homology.CycleCarrier) => x,
  addition := \fun (x, y: Homology.CycleCarrier) => \refl(#add{(family.space k)} x y),
  scalar := \fun (a: R)(x: Homology.CycleCarrier) => \refl(#smul{(family.space k)} a x),
};
\import Modules.Of[V := Homology.CycleCarrier, space := Homology.cycleSpace].Submodule[].Quotient[S := Homology.boundariesInside] \as Quotient;
\import Quotient.To[W := family.Carrier k, target := family.space k] \as Descent;
\definition vanishes: Descent.Vanishes forget := \fun (x: Homology.CycleCarrier)(boundary: _) => boundaryZero x boundary;
\import Modules.Hom[V := Homology.Cohomology, W := family.Carrier k, source := Homology.cohomologySpace, target := family.space k] \as Backward;
\definition backward: Backward.Map := Descent.descend forget vanishes;
\definition leftInverse: \forall (x: family.Carrier k) -> #apply{backward} (#apply{forward} x) = x :=
  \fun (x: family.Carrier k) => Descent.onClass forget vanishes (#apply{cycles} x);
\definition rightInverse: \forall (q: Homology.Cohomology) -> #apply{forward} (#apply{backward} q) = q :=
  Homology.classInduction (\fun (q: Homology.Cohomology) => #apply{forward} (#apply{backward} q) = q)
    (\fun (x: Homology.CycleCarrier) => congr!{{family.Carrier k} Homology.Cohomology} (#apply{forward}) _ _ (Descent.onClass forget vanishes x));
\import Modules.Isomorphism[V := family.Carrier k, W := Homology.Cohomology, source := family.space k, target := Homology.cohomologySpace] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
};
