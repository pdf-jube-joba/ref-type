\definition Trivial: \Prop := \forall (x: C.family.Carrier k) -> x = #zero{(C.family.space k)};
\definition zeroCycleCarrier: CycleCarrier := \into[C.family.Carrier k](#zero{(C.family.space k)}, #carrier{cycles}) \by {
  Maps.zeroPreserved differential
};
\definition onCycleCarriers: Trivial -> \forall (x: CycleCarrier) -> classOf x = zeroClass :=
  \fun (trivial: Trivial)(x: CycleCarrier) => congr!{CycleCarrier Cohomology} classOf x zeroCycleCarrier (trivial x);
\definition zero: Trivial -> \forall (q: Cohomology) -> q = zeroClass :=
  \fun (trivial: Trivial) => classInduction (\fun (q: Cohomology) => q = zeroClass) (onCycleCarriers trivial);
\import Modules.Zero[] \as Zero;
\import Modules.Hom[V := Cohomology, W := Zero.Carrier, source := cohomologySpace, target := Zero.moduleSpace] \as Forward;
\import Modules.Hom[V := Zero.Carrier, W := Cohomology, source := Zero.moduleSpace, target := cohomologySpace] \as Backward;
\import Modules.Isomorphism[V := Cohomology, W := Zero.Carrier, source := cohomologySpace, target := Zero.moduleSpace] \as Iso;
\definition isomorphism(trivial: Trivial): Iso.Isomorphism := Iso.Isomorphism {
  forward := Forward.zeroMap,
  backward := Backward.zeroMap,
  leftInverse := \fun (q: Cohomology) => sym!{Cohomology} q zeroClass (zero trivial q),
  rightInverse := \fun (q: Zero.Carrier) => Zero.unique Zero.Carrier::zero q,
};
