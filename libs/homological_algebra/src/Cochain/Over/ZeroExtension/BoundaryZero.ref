\definition index: Signed.Int^ := Signed.Int^::ofNat N.Nat^::zero;
\import Internal.At[C := complex, z := index] \as H;
\import Modules.Of[V := Carrier index, space := space index].Submodule[] \as Submodules;
\import Submodules.Image[U := Carrier (Signed.Int^::negSucc N.Nat^::zero), source := space (Signed.Int^::negSucc N.Nat^::zero)] \as Images;
\definition onlyZero: \forall (x: Carrier index) -> Submodules.Member H.boundaries x -> x = #zero{(space index)} :=
  \fun (x: Carrier index)(boundary: Submodules.Member H.boundaries x) => Images.eliminate H.prior x (x = #zero{(space index)})
    (\fun (y: Carrier (Signed.Int^::negSucc N.Nat^::zero))(equal: #apply{H.prior} y = x) => sym!{{Carrier index}} (#zero{(space index)}) x equal) boundary;
\definition zeroBoundary: \forall (x: Carrier index) -> x = #zero{(space index)} -> Submodules.Member H.boundaries x :=
  \fun (x: Carrier index)(equal: x = #zero{(space index)}) => \idelim #zero{(space index)} = x
    \with y: Carrier index => Submodules.Member H.boundaries y \by { base: #zero{H.boundaries}, equality: sym!{{Carrier index}} x (#zero{(space index)}) equal };
