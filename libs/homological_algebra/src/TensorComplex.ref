\import std.Data[].Nat[] \as Nat;
\import std.Alg[].Ring[] \as Ring;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\module Over(R: \Set, ring: Ring.CommutativeRing[R]) {
  \import algebra.Module[].Commutative[R := R, ring := ring] \as Algebra;
  \import algebra.Module[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Modules;
  \import \root.NonnegativeChain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Chains;
  \import \root.Chain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as IntegerChains;
  \module Integer(P: IntegerChains.Complex, N: Modules.Bundle);
  \module On(P: Chains.Complex, N: Modules.Bundle);
  \module Mapping(P, Q: Chains.Complex, N, L: Modules.Bundle);
  \module Homotopy(P, Q: Chains.Complex, N: Modules.Bundle);
  \module End(P: Chains.Complex, N: Modules.Bundle);
  \module Composition(P, Q, T: Chains.Complex, N: Modules.Bundle);
  \module Square(A, B, C, D: Chains.Complex, N: Modules.Bundle);
  \module BifunctorComposition(P, Q, T: Chains.Complex, N, L, K: Modules.Bundle);
  \module Equivalence(P, Q: Chains.Complex, N: Modules.Bundle);
}
