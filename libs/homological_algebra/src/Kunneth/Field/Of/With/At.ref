\import Cochains.At[C := Total.complex, k := n] \as H0;
\import Tensors.Tensor[C := LeftHomology.complex, D := Right.complex] \as T1;
\import Tensors.Total[C := T1.complex] \as Total1;
\import Cochains.At[C := Total1.complex, k := n] \as H1;
\import Tensors.Tensor[C := Right.complex, D := LeftHomology.complex] \as T2;
\import Tensors.Total[C := T2.complex] \as Total2;
\import Cochains.At[C := Total2.complex, k := n] \as H2;
\import Tensors.Tensor[C := RightHomology.complex, D := LeftHomology.complex] \as T3;
\import Tensors.Total[C := T3.complex] \as Total3;
\import Cochains.At[C := Total3.complex, k := n] \as H3;
\import Cochains.At[C := HomologyTotal.complex, k := n] \as H4;
\import First.At[n := n] \as I1;
\import FirstSwap.At[n := n] \as I2;
\import Second.At[n := n] \as I3;
\import SecondSwap.At[n := n] \as I4;
\import HomologyTensor.At[n := n] \as Zero;
\import Modules.Isomorphism[V := HomologyTotal.family.Carrier n, W := H4.Cohomology,
  source := HomologyTotal.family.space n, target := H4.cohomologySpace].Inverse[] \as Reverse;
\import Modules.Isomorphism[V := H0.Cohomology, W := H1.Cohomology,
  source := H0.cohomologySpace, target := H1.cohomologySpace].Composition[
  U := H2.Cohomology, final := H2.cohomologySpace] \as Compose1;
\definition combined2: Modules.Isomorphism[V := H0.Cohomology, W := H2.Cohomology,
  source := H0.cohomologySpace, target := H2.cohomologySpace].Isomorphism :=
  Compose1.compose I2.isomorphism I1.isomorphism;
\import Modules.Isomorphism[V := H0.Cohomology, W := H2.Cohomology,
  source := H0.cohomologySpace, target := H2.cohomologySpace].Composition[
  U := H3.Cohomology, final := H3.cohomologySpace] \as Compose2;
\definition combined3: Modules.Isomorphism[V := H0.Cohomology, W := H3.Cohomology,
  source := H0.cohomologySpace, target := H3.cohomologySpace].Isomorphism :=
  Compose2.compose I3.isomorphism combined2;
\import Modules.Isomorphism[V := H0.Cohomology, W := H3.Cohomology,
  source := H0.cohomologySpace, target := H3.cohomologySpace].Composition[
  U := H4.Cohomology, final := H4.cohomologySpace] \as Compose3;
\definition combined4: Modules.Isomorphism[V := H0.Cohomology, W := H4.Cohomology,
  source := H0.cohomologySpace, target := H4.cohomologySpace].Isomorphism :=
  Compose3.compose I4.isomorphism combined3;
\import Modules.Isomorphism[V := H0.Cohomology, W := H4.Cohomology,
  source := H0.cohomologySpace, target := H4.cohomologySpace].Composition[
  U := HomologyTotal.family.Carrier n, final := HomologyTotal.family.space n] \as Compose;
\definition isomorphism: Modules.Isomorphism[V := H0.Cohomology, W := HomologyTotal.family.Carrier n,
  source := H0.cohomologySpace, target := HomologyTotal.family.space n].Isomorphism :=
  Compose.compose (Reverse.inverse Zero.isomorphism) combined4;
