\import LongExact.At[n := n] \as Exact;
\import \parent.\parent.\parent.Of[M := M, N := A, P := P].At[n := n] \as LeftTerm;
\import \parent.\parent.\parent.Of[M := M, N := B, P := P].At[n := n] \as MiddleTerm;
\import \parent.\parent.\parent.Of[M := M, N := C, P := P].At[n := n] \as RightTerm;
\import \parent.\parent.\parent.Of[M := M, N := A, P := P].At[n := Nat.Nat^::succ n] \as NextLeftTerm;
\import \parent.\parent.\parent.Of[M := M, N := B, P := P].At[n := Nat.Nat^::succ n] \as NextMiddleTerm;
\definition inclusion: Modules.MapBetween LeftTerm.bundle MiddleTerm.bundle := Inclusion.At[k := n].map sequence.inclusion;
\definition projection: Modules.MapBetween MiddleTerm.bundle RightTerm.bundle := Projection.At[k := n].map sequence.projection;
\definition nextInclusion: Modules.MapBetween NextLeftTerm.bundle NextMiddleTerm.bundle := Inclusion.At[k := Nat.Nat^::succ n].map sequence.inclusion;
\definition connecting: Modules.MapBetween RightTerm.bundle NextLeftTerm.bundle := Exact.connecting;
\definition inclusionProjectionZero: \forall (x: LeftTerm.Carrier) -> #apply{projection} (#apply{inclusion} x) = #zero{RightTerm.space} := Exact.Exactness[].inclusionProjectionZero;
\definition projectionConnectingZero: \forall (x: MiddleTerm.Carrier) -> #apply{connecting} (#apply{projection} x) = #zero{NextLeftTerm.space} := Exact.Exactness[].projectionConnectingZero;
\definition connectingInclusionZero: \forall (x: RightTerm.Carrier) -> #apply{nextInclusion} (#apply{connecting} x) = #zero{NextMiddleTerm.space} := Exact.Exactness[].connectingInclusionZero;
\definition exactAtB: \forall (x: MiddleTerm.Carrier) -> #apply{projection} x = #zero{RightTerm.space} -> \exists { y: LeftTerm.Carrier \where #apply{inclusion} y = x } := Exact.Exactness[].exactAtB;
\definition exactAtC: \forall (x: RightTerm.Carrier) -> #apply{connecting} x = #zero{NextLeftTerm.space} -> \exists { y: MiddleTerm.Carrier \where #apply{projection} y = x } := Exact.Exactness[].exactAtC;
\definition exactAtANext: \forall (x: NextLeftTerm.Carrier) -> #apply{nextInclusion} x = #zero{NextMiddleTerm.space} -> \exists { y: RightTerm.Carrier \where #apply{connecting} y = x } := Exact.Exactness[].exactAtANext;
