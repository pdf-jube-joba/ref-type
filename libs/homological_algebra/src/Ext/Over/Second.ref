\import \parent.Of[M := M, N := N, P := P] \as Source;
\import \parent.Of[M := M, N := L, P := P] \as Target;
\import \root.HomComplex[].Over[R := R, ring := ring] \as Hom;
\import Hom.On[P := P, N := N] \as SourceComplex;
\import Hom.On[P := P, N := L] \as TargetComplex;
\import Hom.Mapping[P := P, Q := P, N := N, L := L] \as Mapping;
\import Chains.End[C := P] \as ChainIdentity;
\import Modules.Hom[V := N.Carrier, W := L.Carrier, source := N.space, target := L.space] \as Coefficients;
\import \root.Cochain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Cochains;
\import Cochains.Map[C := SourceComplex.complex, D := TargetComplex.complex] \as CochainMaps;
\definition cochainMap(u: Coefficients.Map): CochainMaps.Map := Mapping.On[f := ChainIdentity.identity, u := u].map;
\module At(k: Nat.Nat^) {
  \import Source.At[n := k] \as SourceTerm;
  \import Target.At[n := k] \as TargetTerm;
  \import CochainMaps.At[k := k] \as Induced;
  \import Modules.Hom[V := SourceTerm.Carrier, W := TargetTerm.Carrier, source := SourceTerm.space, target := TargetTerm.space] \as Maps;
  \definition map(u: Coefficients.Map): Maps.Map := Induced.induced (cochainMap u);
  \import Cochains.At[C := SourceComplex.complex, k := k] \as SourceH;
  \import Cochains.At[C := TargetComplex.complex, k := k] \as TargetH;
  \definition onClass: \forall (u: Coefficients.Map)(x: SourceH.CycleCarrier) ->
    #apply{(map u)} (SourceH.classOf x) = TargetH.classOf (#apply{(Induced.cyclesMap (cochainMap u))} x) :=
    \fun (u: Coefficients.Map) => Induced.onClass (cochainMap u);
}
