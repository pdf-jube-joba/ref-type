\import \root.Resolution[].Over[R := R, ring := Ring.commutativeRingAsRing R ring].Of[M := M, P := P] \as Resolutions;
\import \root.HomComplex[].Over[R := R, ring := ring].On[P := P, N := N] \as Hom;
\import \root.Cochain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Cochains;
\definition Resolution: \Set := Resolutions.Resolution;
\module At(n: Nat.Nat^) {
  \import Cochains.At[C := Hom.complex, k := n] \as H;
  \definition Carrier: \Set := H.Cohomology;
  \definition space: Modules.Space Carrier := H.cohomologySpace;
  \definition CycleCarrier: \Set := H.CycleCarrier;
  \definition cycleSpace: Modules.Space CycleCarrier := H.cycleSpace;
  \definition cyclePredicate: \Pow (Hom.Carrier n) := #carrier{H.cycles};
  \definition boundariesInside: Modules.Of[V := CycleCarrier, space := cycleSpace].Submodule[].Submodule := H.boundariesInside;
  \definition classOf: CycleCarrier -> Carrier := H.classOf;
  \definition classInduction(P: Carrier -> \Prop): (\forall (x: CycleCarrier) -> P (classOf x)) -> \forall (q: Carrier) -> P q := H.classInduction P;
  \definition zeroClass: Carrier := H.zeroClass;
  \definition vanishing: (\forall (f: Hom.Carrier n) -> f = #zero{(Hom.space n)}) -> \forall (q: Carrier) -> q = zeroClass := H.Vanishing[].zero;
  \definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier, space := space };
}
\definition Ext(n: Nat.Nat^): \Set := At[n := n].Carrier;
