\import \parent.Of[M := M, N := N, P := P] \as Ext;
\import \root.Resolution[].Over[R := R, ring := Ring.commutativeRingAsRing R ring].Of[M := M, P := P] \as Resolutions;
\import \root.HomComplex[].Over[R := R, ring := ring].On[P := P, N := N] \as Hom;
\import \root.Cochain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Cochains;
\import Cochains.At[C := Hom.complex, k := Nat.Nat^::zero] \as H;
\import Cochains.DegreeZero[C := Hom.complex] \as Zero;
\import Algebra.HomSpace[V := M.Carrier, W := N.Carrier, source := M.space, target := N.space] \as Target;
\import Modules.Hom[V := M.Carrier, W := N.Carrier, source := M.space, target := N.space] \as Native;
\import Modules.SurjectiveDescent[A := Resolutions.term Nat.Nat^::zero, B := M, U := N] \as Descent;
\module With(resolution: Ext.Resolution);
\definition existence: \forall (resolution: Ext.Resolution) ->
  \exists Modules.Isomorphism[V := H.Cohomology, W := Target.Carrier, source := H.cohomologySpace, target := Target.space].Isomorphism :=
  \fun (resolution: Ext.Resolution) => \exact(With[resolution := resolution].isomorphism,
    Modules.Isomorphism[V := H.Cohomology, W := Target.Carrier, source := H.cohomologySpace, target := Target.space].Isomorphism);
