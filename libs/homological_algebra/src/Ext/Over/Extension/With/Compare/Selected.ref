\import Source.Chosen[lift := first] \as First;
\import Target.Chosen[lift := second] \as Second;
\import First.Representative[] \as FirstRepresentative;
\import Second.Representative[] \as SecondRepresentative;
\import \root.Ext[].Over[R := R, ring := ring].Extension[M := M, N := N, P := P].With[resolution := resolution].CompareRepresentatives[f := First.relation, g := Second.relation] \as Comparison;
\definition Correction: \Set := Comparison.Correction;
\definition correctionExistence: Quotient.class First.relation = Quotient.class Second.relation -> \exists Correction := Comparison.existence;
\module On(correction: Correction);
