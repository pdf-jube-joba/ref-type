\definition laws: Laws[e] := \bysub(Iso.Isomorphism, { e: Iso.Isomorphism \where Laws[e] }, e);
\module Chosen(first: Source.Lift);
\definition classEqual: Source.class = Target.class := \block {
  \takefrom first: Source.Lift \by Source.liftExistence \then
  \return Chosen[first := first].classEqual
};
