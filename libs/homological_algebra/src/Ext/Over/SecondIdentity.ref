\import \parent.Of[M := M, N := N, P := P] \as Ext;
\import \parent.Second[M := M, N := N, L := N, P := P] \as Action;
\import \root.HomComplex[].Over[R := R, ring := ring].End[P := P, N := N] \as HomIdentity;
\import Modules.End[V := N.Carrier, space := N.space] \as Coefficients;
\definition identity: \forall (k: Nat.Nat^)(q: Ext.At[n := k].Carrier) ->
  #apply{(Action.At[k := k].map Coefficients.identity)} q = q :=
  \fun (k: Nat.Nat^) => HomIdentity.At[k := k].onCohomology;
