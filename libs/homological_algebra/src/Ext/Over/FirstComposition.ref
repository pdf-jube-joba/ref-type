\import \parent.Of[M := T, N := N, P := S] \as Source;
\import \parent.Of[M := L, N := N, P := Q] \as Middle;
\import \parent.Of[M := M, N := N, P := P] \as Target;
\import \parent.First[M := M, L := L, N := N, P := P, Q := Q] \as First;
\import \parent.First[M := L, L := T, N := N, P := Q, Q := S] \as Second;
\import \parent.First[M := M, L := T, N := N, P := P, Q := S] \as Direct;
\import \root.Resolution[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Resolutions;
\import Resolutions.Of[M := M, P := P] \as SourceResolution;
\import Resolutions.Of[M := L, P := Q] \as MiddleResolution;
\import Resolutions.Of[M := T, P := S] \as TargetResolution;
\import Modules.Hom[V := M.Carrier, W := L.Carrier, source := M.space, target := L.space] \as Before;
\import Modules.Hom[V := L.Carrier, W := T.Carrier, source := L.space, target := T.space] \as After;
\import After.Composition[U := M.Carrier, domain := M.space] \as Coefficients;
\import Chains.Map[C := P, D := Q] \as ChainBefore;
\import Chains.Map[C := Q, D := S] \as ChainAfter;
\import ChainAfter.Composition[B := P] \as ChainComposition;
\import \root.HomComplex[].Over[R := R, ring := ring].Composition[P := P, Q := Q, T := S, N := N] \as Hom;
\import \root.HomComplex[].Over[R := R, ring := ring].On[P := P, N := N] \as FinalComplex;
\import \root.HomComplex[].Over[R := R, ring := ring].On[P := Q, N := N] \as MiddleComplex;
\import \root.HomComplex[].Over[R := R, ring := ring].On[P := S, N := N] \as InitialComplex;
\import \root.Cochain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Cochains;
\import Cochains.Map[C := MiddleComplex.complex, D := FinalComplex.complex] \as CochainBefore;
\import Cochains.Map[C := InitialComplex.complex, D := MiddleComplex.complex] \as CochainAfter;
\import Cochains.Map[C := InitialComplex.complex, D := FinalComplex.complex] \as CochainDirect;
\module With(p: SourceResolution.Resolution, q: MiddleResolution.Resolution, r: TargetResolution.Resolution, u: Before.Map, v: After.Map);
