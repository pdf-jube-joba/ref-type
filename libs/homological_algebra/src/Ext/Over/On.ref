\import \root.NonnegativeChain[].Over[R := R, ring := Algebra.ordinaryRing].CanonicalResolution[M := M] \as Canonical;
\import \root.Resolution[].Over[R := R, ring := Algebra.ordinaryRing].Of[M := M, P := Canonical.complex] \as Resolutions;
\definition resolution: Resolutions.Resolution := Resolutions.Resolution {
  augmentation := Canonical.augmentation, projective := Canonical.projective, onto := Canonical.onto,
  killed := Canonical.augmentationKilled, augmentationExact := Canonical.augmentationExact, exact := Canonical.exact,
};
\import \root.HomComplex[].Over[R := R, ring := ring] \as HomBase;
\import HomBase.On[P := Canonical.complex, N := N] \as Hom;
\import \root.Cochain[].Over[R := R, ring := Algebra.ordinaryRing] \as Cochains;
\definition complex: Cochains.Complex := Hom.complex;
\module At(n: Nat.Nat^) {
  \import Cochains.At[C := complex, k := n] \as Cohomology;
  \definition Carrier: \Set := Cohomology.Cohomology;
  \definition space: Modules.Space Carrier := Cohomology.cohomologySpace;
  \definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier, space := space };
}
\definition Ext(n: Nat.Nat^): \Set := At[n := n].Carrier;
