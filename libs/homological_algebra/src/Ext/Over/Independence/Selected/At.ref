\import Source.At[n := k] \as SourceTerm;
\import Target.At[n := k] \as TargetTerm;
\import \parent.\parent.\parent.First[M := M, L := M, N := N, P := Q, Q := P].At[k := k].With[p := q, q := p, f := Identity.identity] \as Forward;
\import \parent.\parent.\parent.First[M := M, L := M, N := N, P := P, Q := Q].At[k := k].With[p := p, q := q, f := Identity.identity] \as Backward;
\import \parent.\parent.\parent.FirstComposition[M := M, L := M, T := M, N := N, P := P, Q := Q, S := P].With[p := p, q := q, r := p, u := Identity.identity, v := Identity.identity].At[k := k] \as Left;
\import \parent.\parent.\parent.FirstComposition[M := M, L := M, T := M, N := N, P := Q, Q := P, S := Q].With[p := q, q := p, r := q, u := Identity.identity, v := Identity.identity].At[k := k] \as Right;
\import \parent.\parent.\parent.FirstIdentity[M := M, N := N, P := P].At[k := k, resolution := p] \as SourceIdentity;
\import \parent.\parent.\parent.FirstIdentity[M := M, N := N, P := Q].At[k := k, resolution := q] \as TargetIdentity;
\import Modules.Isomorphism[V := SourceTerm.Carrier, W := TargetTerm.Carrier, source := SourceTerm.space, target := TargetTerm.space] \as Iso;
\definition leftInverse: \forall (x: SourceTerm.Carrier) -> #apply{Backward.map} (#apply{Forward.map} x) = x :=
  \fun (x: SourceTerm.Carrier) => trans!{SourceTerm.Carrier} _ _ _
    (sym!{SourceTerm.Carrier} _ _ (Left.composition x)) (SourceIdentity.identity x);
\definition rightInverse: \forall (x: TargetTerm.Carrier) -> #apply{Forward.map} (#apply{Backward.map} x) = x :=
  \fun (x: TargetTerm.Carrier) => trans!{TargetTerm.Carrier} _ _ _
    (sym!{TargetTerm.Carrier} _ _ (Right.composition x)) (TargetIdentity.identity x);
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := Forward.map, backward := Backward.map, leftInverse := leftInverse, rightInverse := rightInverse,
};
