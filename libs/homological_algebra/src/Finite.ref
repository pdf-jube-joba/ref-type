\import std.Data[].Nat[] \as N;
\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as Bounds;
\import std.Data[].FinSet[] \as Indices;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import std.Arithmetic[].IntAlgebra[].Calculation[] \as Arithmetic;
\import std.Alg[].Ring[] \as Ring;
\import algebra.Module[].Over[R := I.Int^, ring := Ring.commutativeRingAsRing I.Int^ IntegerRing.commutativeRing] \as Modules;
\import algebra.Module[].Commutative[R := I.Int^, ring := IntegerRing.commutativeRing] \as Commutative;
\import algebra.IntegerMatrix[m := N.Nat^::zero, n := N.Nat^::zero] \as RuntimeMatrices;
\definition Runtime: \VType := RuntimeMatrices.Runtime;
\import algebra.Smith[] \as Smith;
\import Smith.Diagonalize[] \as Diagonalize;
\import algebra.IntegerBasis[] \as IntegerBasis;
\import std.Logic[].Equality[] \as Equality;
\import std.Program[] \as Programs;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\inductive Input: \VType :=
  | pair: N.Nat -> N.Nat -> N.Nat -> Runtime -> Runtime -> Input;
\inductive Calculation: \VType :=
  | result: N.Nat -> N.Nat -> Smith.SmithResult -> Smith.SmithResult -> Runtime -> Runtime -> Calculation;
\inductive CyclicFactors: \VType :=
  | empty: CyclicFactors
  | factor: I.Int -> CyclicFactors -> CyclicFactors;
\inductive FactorState: \VType :=
  | state: N.Nat -> CyclicFactors -> FactorState;
\module FactorListing;
\module Compute;
\module Pair(m, n, p: N.Nat^);
\module Mapping(m, n, p, r, s, t: N.Nat^,
  C: \parent.Pair[m := m, n := n, p := p].Complex, D: \parent.Pair[m := r, n := s, p := t].Complex);
\import RuntimeMatrices.Transpose[] \as NativeTranspose;
\definition nativeTranspose: \U(Runtime -> Runtime) := NativeTranspose.program;
\module Bounded;
\module Dual(m, n, p: N.Nat^, C: \parent.Pair[m := m, n := n, p := p].Complex);
