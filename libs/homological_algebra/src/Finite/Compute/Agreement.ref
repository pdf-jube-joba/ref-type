\definition transport: \forall (transition: Step.T^) -> step = transition -> \forall (proof: Programs.Terminates Input^ Calculation^ transition input) ->
  \run[Input^, Calculation^](transition, input) \by { proof } = execute input :=
  \fun (transition: Step.T^)(equal: step = transition) => \idelim step = transition \with action: Step.T^ =>
    \forall (proof: Programs.Terminates Input^ Calculation^ action input) -> \run[Input^, Calculation^](action, input) \by { proof } = execute input \by {
    base: \fun (proof: Programs.Terminates Input^ Calculation^ step input) => \refl(execute input), equality: equal
  };
\definition law: Evaluate.run^ input = execute input := transport Step.program^ (sym!{Step.T^} Step.program^ step Step.coherence) (certificate input);
