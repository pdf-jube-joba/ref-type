\import algebra.IntegerMatrix[m := m, n := n] \as Outgoing;
\import algebra.IntegerMatrix[m := n, n := p] \as Incoming;
\structure Data: \Set { outgoing: Runtime^, incoming: Runtime^ }
\structure Laws[data: Data]: \Prop {
  squareZero: \forall (v: Incoming.Vector) -> Outgoing.apply (Outgoing.reflect data.outgoing) (Incoming.apply (Incoming.reflect data.incoming) v) = #zero{Outgoing.codomain},
}
\definition Complex: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module Of(C: Complex);
