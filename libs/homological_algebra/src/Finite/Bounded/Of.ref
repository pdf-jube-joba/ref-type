\definition family: Chains.Family := Chains.Family { Carrier := Carrier C, space := space C };
\definition linear(z: Degree): Modules.Hom[V := Carrier C z, W := Carrier C (previous z), source := space C z, target := space C (previous z)].Map :=
  Commutative.Matrix[m := C.ranks (previous z), n := C.ranks z].linear
    (\fun (i: Indices.Fin (C.ranks (previous z)))(j: Indices.Fin (C.ranks z)) => C.boundary z i j);
\definition differential: Chains.DifferentialData[family] := Chains.DifferentialData[family] { apply := apply C };
\definition chain: Chains.Complex := Chains.Complex {
  family := family, differential := differential,
  laws := Chains.DifferentialLaws[family, differential] {
    addition := \fun (z: Degree) => #addition{(linear z)},
    scalar := \fun (z: Degree) => #scalar{(linear z)},
    squareZero := #squareZero{(\bysub(Data, { data: Data \where Laws[data] }, C))},
  },
};
\definition input(z: Degree): Input^ := Input^::pair (C.ranks (previous z)) (C.ranks z) (C.ranks (next z)) (C.boundary z) (C.boundary (next z));
\import \parent.\parent.Compute[] \as Computation;
\definition calculate(z: Degree): Calculation^ := Computation.Run.program^ (input z);
\module At(z: Degree);

\definition ComplexData: \Set := Data;
\definition ComplexLaws(data: ComplexData): \Prop := Laws[data];
\module BasisChange;

\module Dual;
