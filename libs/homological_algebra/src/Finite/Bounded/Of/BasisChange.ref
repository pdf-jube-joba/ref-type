\structure Data: \Set { forward: Degree -> Runtime^, backward: Degree -> Runtime^ }
\definition forward(data: Data)(z: Degree): Modules.Hom[V := Carrier C z, W := Carrier C z, source := space C z, target := space C z].Map :=
  Commutative.Matrix[m := C.ranks z, n := C.ranks z].linear
    (\fun (i, j: Indices.Fin (C.ranks z)) => data.forward z i j);
\definition backward(data: Data)(z: Degree): Modules.Hom[V := Carrier C z, W := Carrier C z, source := space C z, target := space C z].Map :=
  Commutative.Matrix[m := C.ranks z, n := C.ranks z].linear
    (\fun (i, j: Indices.Fin (C.ranks z)) => data.backward z i j);
\structure Laws[data: Data]: \Prop {
  leftInverse: \forall (z: Degree)(x: Carrier C z) -> #apply{(backward data z)} (#apply{(forward data z)} x) = x,
  rightInverse: \forall (z: Degree)(x: Carrier C z) -> #apply{(forward data z)} (#apply{(backward data z)} x) = x,
}
\definition Change: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition isomorphisms(change: Change)(z: Degree): Modules.Isomorphism[V := Carrier C z, W := Carrier C z, source := space C z, target := space C z].Isomorphism :=
  Modules.Isomorphism[V := Carrier C z, W := Carrier C z, source := space C z, target := space C z].Isomorphism {
    forward := forward change z, backward := backward change z,
    leftInverse := #leftInverse{change} z, rightInverse := #rightInverse{change} z,
  };
\module With(change: Change);
