\import \root.Chain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as IntegerChains;
\import Chains.ZeroExtension[C := Left.tensorComplex] \as LeftExtended;
\import Chains.ZeroExtension[C := Right.tensorComplex] \as RightExtended;
\import IntegerSequence.IntegerAt[k := k] \as Exact;
\definition leftFamily: IntegerChains.Family := IntegerChains.Family {
  Carrier := \fun (z: Integers.Int^) => LeftExtended.Carrier z,
  space := \fun (z: Integers.Int^) => LeftExtended.space z,
};
\definition leftDifferential: IntegerChains.DifferentialData[leftFamily] := IntegerChains.DifferentialData[leftFamily] {
  apply := \fun (z: Integers.Int^)(x: leftFamily.Carrier z) => LeftExtended.apply z x,
};
\definition leftComplex: IntegerChains.Complex := IntegerChains.Complex {
  family := leftFamily, differential := leftDifferential,
  laws := IntegerChains.DifferentialLaws[leftFamily, leftDifferential] {
    addition := \fun (z: Integers.Int^)(x, y: leftFamily.Carrier z) => LeftExtended.addition z x y,
    scalar := \fun (z: Integers.Int^)(a: R)(x: leftFamily.Carrier z) => LeftExtended.scalar z a x,
    squareZero := \fun (z: Integers.Int^)(x: leftFamily.Carrier z) => LeftExtended.squareZero z x,
  },
};
\definition rightFamily: IntegerChains.Family := IntegerChains.Family {
  Carrier := \fun (z: Integers.Int^) => RightExtended.Carrier z,
  space := \fun (z: Integers.Int^) => RightExtended.space z,
};
\definition rightDifferential: IntegerChains.DifferentialData[rightFamily] := IntegerChains.DifferentialData[rightFamily] {
  apply := \fun (z: Integers.Int^)(x: rightFamily.Carrier z) => RightExtended.apply z x,
};
\definition rightComplex: IntegerChains.Complex := IntegerChains.Complex {
  family := rightFamily, differential := rightDifferential,
  laws := IntegerChains.DifferentialLaws[rightFamily, rightDifferential] {
    addition := \fun (z: Integers.Int^)(x, y: rightFamily.Carrier z) => RightExtended.addition z x y,
    scalar := \fun (z: Integers.Int^)(a: R)(x: rightFamily.Carrier z) => RightExtended.scalar z a x,
    squareZero := \fun (z: Integers.Int^)(x: rightFamily.Carrier z) => RightExtended.squareZero z x,
  },
};
\import IntegerChains.At[C := rightComplex, z := k] \as Source;
\import IntegerChains.At[C := leftComplex, z := \root.Integer[].previous k] \as Target;
\definition connecting: Modules.MapBetween (Modules.Bundle { Carrier := Source.Homology, space := Source.homologySpace }) (Modules.Bundle { Carrier := Target.Homology, space := Target.homologySpace }) := Exact.connecting;
