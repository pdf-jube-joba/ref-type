\import \parent.Of[M := M, N := N, P := P] \as Tor;
\import Chains.End[C := Tor.tensorComplex] \as TensorIdentity;
\import Chains.Map[C := Tor.tensorComplex, D := Tor.tensorComplex] \as TensorMaps;
\import \root.TensorComplex[].Over[R := R, ring := ring].End[P := P, N := N] \as Tensor;
\import Modules.End[V := N.Carrier, space := N.space] \as Coefficients;
\import \parent.First[M := M, L := M, N := N, P := P, Q := P] \as Action;
\import Modules.End[V := M.Carrier, space := M.space] \as AugmentedIdentity;
\import Chains.End[C := P] \as ChainIdentity;
\import \root.Resolution[].Over[R := R, ring := Ring.commutativeRingAsRing R ring].Of[M := M, P := P] \as Resolutions;
\definition chainLaw: Action.chainMap ChainIdentity.identity = TensorIdentity.identity :=
  TensorMaps.ext (Action.chainMap ChainIdentity.identity) TensorIdentity.identity
    (\fun (n: Nat.Nat^) => Tensor.At[n := n].pointwise);
\module With(resolution: Resolutions.Resolution);
