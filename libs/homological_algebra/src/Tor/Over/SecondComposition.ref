\import \parent.Of[M := M, N := N, P := P] \as Source;
\import \parent.Of[M := M, N := L, P := P] \as Middle;
\import \parent.Of[M := M, N := T, P := P] \as Target;
\import \parent.Second[M := M, N := N, L := L, P := P] \as First;
\import \parent.Second[M := M, N := L, L := T, P := P] \as Second;
\import \parent.Second[M := M, N := N, L := T, P := P] \as Direct;
\import Modules.Hom[V := N.Carrier, W := L.Carrier, source := N.space, target := L.space] \as Before;
\import Modules.Hom[V := L.Carrier, W := T.Carrier, source := L.space, target := T.space] \as After;
\import After.Composition[U := N.Carrier, domain := N.space] \as Coefficients;
\import Chains.End[C := P] \as Identity;
\import \root.TensorComplex[].Over[R := R, ring := ring].BifunctorComposition[P := P, Q := P, T := P, N := N, L := L, K := T] \as TensorLaw;
\import Chains.Map[C := Source.tensorComplex, D := Target.tensorComplex] \as Maps;
\import Chains.Map[C := Middle.tensorComplex, D := Target.tensorComplex].Composition[B := Source.tensorComplex] \as Composition;
\definition chainLaw: \forall (u: Before.Map)(v: After.Map) ->
  Direct.chainMap (Coefficients.compose v u) = Composition.compose (Second.chainMap v) (First.chainMap u) :=
  \fun (u: Before.Map)(v: After.Map) => Maps.ext _ _
    (\fun (n: Nat.Nat^) => TensorLaw.At[n := n].pointwise Identity.identity Identity.identity u v);
\module DegreeZero;
\module Positive(n: Nat.Nat^);
