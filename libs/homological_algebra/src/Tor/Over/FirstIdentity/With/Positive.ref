\import Tor.At[n := Nat.Nat^::succ n] \as Term;
\import Modules.Hom[V := Term.Carrier, W := Term.Carrier, source := Term.space, target := Term.space] \as Linear;
\import TensorMaps.Positive[n := n] \as Induced;
\import Action.Positive[n := n].With[p := resolution, q := resolution, f := AugmentedIdentity.identity] \as Selected;
\definition map: Linear.Map := Selected.map;
\definition equality: map = Induced.induced (Action.chainMap ChainIdentity.identity) :=
  Selected.onComparison ChainIdentity.identity augmented;
\definition pointwise: \forall (q: Term.Carrier) ->
  #apply{map} q = #apply{(Induced.induced (Action.chainMap ChainIdentity.identity))} q :=
  \fun (q: Term.Carrier) => congr!{Linear.Map Term.Carrier}
    (\fun (f: Linear.Map) => #apply{f} q) _ _ equality;
\definition actualIdentity: \forall (q: Term.Carrier) ->
  #apply{(Induced.induced (Action.chainMap ChainIdentity.identity))} q = q :=
  \fun (q: Term.Carrier) => trans!{Term.Carrier} _ _ _
    (congr!{TensorMaps.Map Term.Carrier} (\fun (f: TensorMaps.Map) => #apply{(Induced.induced f)} q) _ _ chainLaw)
    (TensorIdentity.Positive[n := n].identityOnHomology q);
\definition identity: \forall (q: Term.Carrier) -> #apply{map} q = q :=
  \fun (q: Term.Carrier) => trans!{Term.Carrier} _ _ _ (pointwise q) (actualIdentity q);
