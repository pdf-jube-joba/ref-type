\import Resolutions.Comparison[M := M, N := L, P := P, Q := Q, f := u] \as CompareBefore;
\import Resolutions.Comparison[M := L, N := T, P := Q, Q := S, f := v] \as CompareAfter;
\import Resolutions.Comparison[M := M, N := T, P := P, Q := S, f := Coefficients.compose v u] \as CompareDirect;
\definition BeforeLift: \Set := \Cast[ChainBefore.Map] ({ g: ChainBefore.Map \where CompareBefore.Augmented p q g });
\definition AfterLift: \Set := \Cast[ChainAfter.Map] ({ h: ChainAfter.Map \where CompareAfter.Augmented q r h });
\definition compositeAugmented: \forall (g: BeforeLift)(h: AfterLift) ->
  CompareDirect.Augmented p r (ChainComposition.compose h g) :=
  \fun (g: BeforeLift)(h: AfterLift)(x: P.family.Carrier Nat.Nat^::zero) => trans!{T.Carrier} _ _ _
    ((\bysub(ChainAfter.Map, { h: ChainAfter.Map \where CompareAfter.Augmented q r h }, h)) (#apply{g} Nat.Nat^::zero x))
    (congr!{L.Carrier T.Carrier} (#apply{v}) _ _
      ((\bysub(ChainBefore.Map, { g: ChainBefore.Map \where CompareBefore.Augmented p q g }, g)) x));
\module DegreeZero;
\module Positive(n: Nat.Nat^);
