\import Source.At[n := Nat.Nat^::succ n] \as SourceTerm;
\import Target.At[n := Nat.Nat^::succ n] \as TargetTerm;
\import ForwardAction.Positive[n := n].With[p := p, q := q, f := Identity.identity] \as Forward;
\import BackwardAction.Positive[n := n].With[p := q, q := p, f := Identity.identity] \as Backward;
\import LeftComposition.Positive[n := n] \as Left;
\import RightComposition.Positive[n := n] \as Right;
\import SourceIdentity.Positive[n := n] \as SourceLaw;
\import TargetIdentity.Positive[n := n] \as TargetLaw;
\import Modules.Isomorphism[V := SourceTerm.Carrier, W := TargetTerm.Carrier, source := SourceTerm.space, target := TargetTerm.space] \as Iso;
\definition leftInverse: \forall (x: SourceTerm.Carrier) -> #apply{Backward.map} (#apply{Forward.map} x) = x :=
  \fun (x: SourceTerm.Carrier) => trans!{SourceTerm.Carrier} _ _ _
    (sym!{SourceTerm.Carrier} _ _ (Left.composition x)) (SourceLaw.identity x);
\definition rightInverse: \forall (x: TargetTerm.Carrier) -> #apply{Forward.map} (#apply{Backward.map} x) = x :=
  \fun (x: TargetTerm.Carrier) => trans!{TargetTerm.Carrier} _ _ _
    (sym!{TargetTerm.Carrier} _ _ (Right.composition x)) (TargetLaw.identity x);
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := Forward.map, backward := Backward.map, leftInverse := leftInverse, rightInverse := rightInverse,
};
