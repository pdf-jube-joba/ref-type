\import \parent.Of[M := M, N := N, P := P] \as Source;
\import \parent.Of[M := L, N := N, P := Q] \as Target;
\import \root.Resolution[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Resolutions;
\import Resolutions.Of[M := M, P := P] \as SourceResolution;
\import Resolutions.Of[M := L, P := Q] \as TargetResolution;
\import Modules.Hom[V := M.Carrier, W := L.Carrier, source := M.space, target := L.space] \as Coefficients;
\import Chains.Map[C := P, D := Q] \as ChainMaps;
\import Chains.Homotopy[C := P, D := Q] \as Homotopies;
\import \root.TensorComplex[].Over[R := R, ring := ring].Homotopy[P := P, Q := Q, N := N] \as Tensor;
\import \root.TensorComplex[].Over[R := R, ring := ring].Mapping[P := P, Q := Q, N := N, L := N] \as Actions;
\import Modules.End[V := N.Carrier, space := N.space] \as Identity;
\import Chains.Map[C := Source.tensorComplex, D := Target.tensorComplex] \as TensorMaps;
\import Chains.Homotopy[C := Source.tensorComplex, D := Target.tensorComplex] \as TensorHomotopies;
\definition chainMap(g: ChainMaps.Map): TensorMaps.Map := TensorMaps.Map {
  apply := #apply{(Actions.On[f := g, u := Identity.identity].map)},
  addition := #addition{(Actions.On[f := g, u := Identity.identity].map)},
  scalar := #scalar{(Actions.On[f := g, u := Identity.identity].map)},
  commutes := #commutes{(Actions.On[f := g, u := Identity.identity].map)},
};
\definition homotopyExistence: \forall (g, h: ChainMaps.Map)(t: Homotopies.Homotopy g h) ->
  \exists TensorHomotopies.Homotopy (chainMap g) (chainMap h) := \block {
  \fun (g, h: ChainMaps.Map)(t: Homotopies.Homotopy g h) \then
  \takefrom v: TensorHomotopies.Homotopy (chainMap g) (chainMap h) \by Tensor.existence g h t \then
  \return \exact(v, TensorHomotopies.Homotopy (chainMap g) (chainMap h))
};
\module DegreeZero;
\module Positive(n: Nat.Nat^);
\module With(p: SourceResolution.Resolution, q: TargetResolution.Resolution, f: Coefficients.Map);
