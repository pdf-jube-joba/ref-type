\import Tor.At[n := Nat.Nat^::succ n] \as Term;
\import TensorMaps.Positive[n := n] \as Induced;
\definition identity: \forall (q: Term.Carrier) -> #apply{(Action.Positive[n := n].map Coefficients.identity)} q = q :=
  \fun (q: Term.Carrier) => trans!{Term.Carrier} _ _ _
    (congr!{TensorMaps.Map Term.Carrier} (\fun (f: TensorMaps.Map) => #apply{(Induced.induced f)} q) _ _ chainLaw)
    (TensorIdentity.Positive[n := n].identityOnHomology q);
