\import \parent.\parent.\parent.At[n := n].Decomposition[].Selected[d := d n] \as Selected;
\import \parent.\parent.\parent.At[n := n].Outgoing[] \as Out;
\import \parent.\parent.Remainder[n := n] \as Remainder;
\import \parent.\parent.Degree[n := n] \as Term;
\import Modules.Laws[V := Carrier (C.ranks n), space := space (C.ranks n)] \as Vector;
\import algebra.Group[].Of[Carrier := Carrier (C.ranks n), group := Vector.additive] \as Group;
\definition decomposition: \forall (x: Carrier (C.ranks n)) ->
  Group.difference x (#apply{Term.inclusion} (#apply{Term.projection} x)) =
    Group.add (#apply{Remainder.ambient} x) (#apply{#outgoing{(d n)}} (#apply{Out.differential} x)) :=
  \fun (x: Carrier (C.ranks n)) => sym!{{Carrier (C.ranks n)}} _ _
    (Group.differencePlusSwap x (#apply{#outgoing{(d n)}} (#apply{Out.differential} x))
      (#apply{Term.inclusion} (#apply{Term.projection} x)));
