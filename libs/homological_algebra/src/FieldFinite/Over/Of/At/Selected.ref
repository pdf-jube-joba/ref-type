\import Into.Composition[U := H.CycleCarrier, domain := H.cycleSpace] \as Compose;
\import Modules.Hom[V := H.CycleCarrier, W := AmbientBoundary.Carrier, source := H.cycleSpace, target := AmbientBoundary.moduleSpace] \as Restrictions;
\definition restriction: Restrictions.Map := Restrictions.Map {
  apply := \fun (x: H.CycleCarrier) => #apply{r} x,
  addition := \fun (x, y: H.CycleCarrier) => #addition{r} x y,
  scalar := \fun (a: K)(x: H.CycleCarrier) => #scalar{r} a x,
};
\definition retraction: Modules.MapBetween cycleBundle boundaryBundle := Compose.compose into restriction;
\import Sequences.Splitting[sequence := sequence].FromRetraction[r := retraction] \as Split;
\definition retracts: Split.Retracts := \fun (x: Boundary.Carrier) =>
  congr!{AmbientBoundary.Carrier Boundary.Carrier} (#apply{into}) (#apply{r} (#apply{forget} x)) (#apply{forget} x)
    ((\bysub(BoundarySpace.Map, { r: BoundarySpace.Map \where BoundarySpace.Splits r }, r)) (#apply{forget} x));
\import Modules.ProjectiveLaws[].Retract[P := cohomologyBundle, Q := cycleBundle, inclusion := Split.section retracts, retraction := H.classLinear] \as Retract;
\definition projective: Modules.Projective cohomologyBundle := Retract.projective (Split.rightInverse retracts) cyclesProjective;
