\import Cochains.ZeroDifferential[family := homologyFamily] \as HomologyComplex;
\module Degree(n: N.Nat^) {
  \import \parent.\parent.At[n := n].Decomposition[].Selected[d := d n] \as Decomposition;
  \import Cochains.At[C := complex, k := n] \as H;
  \definition source: Modules.Bundle := Modules.Bundle { Carrier := Carrier (C.ranks n), space := space (C.ranks n) };
  \definition target: Modules.Bundle := Modules.Bundle { Carrier := H.Cohomology, space := H.cohomologySpace };
  \definition inclusion: Modules.MapBetween target source := Decomposition.inclusion;
  \definition projection: Modules.MapBetween source target := Decomposition.projection;
  \definition inverse: \forall (x: target.Carrier) -> #apply{projection} (#apply{inclusion} x) = x := Decomposition.represents;
  \definition projectionOnCycle: \forall (x: H.CycleCarrier) -> #apply{projection} x = H.classOf x :=
    \fun (x: H.CycleCarrier) => congr!{H.CycleCarrier H.Cohomology} H.classOf
      (#apply{Decomposition.cycles} x) x (Decomposition.onCycle x);
  \definition inclusionClosed: \forall (x: target.Carrier) -> #apply{(C.differential n)} (#apply{inclusion} x) = #zero{(space (C.ranks (N.Nat^::succ n)))} :=
    Decomposition.inclusionClosed;
  \import Modules.Hom[V := target.Carrier, W := source.Carrier, source := target.space, target := source.space] \as Inclusions;
  \definition inclusionZero: #apply{inclusion} #zero{target.space} = #zero{source.space} := Inclusions.zeroPreserved inclusion;
}
\module Boundary(n: N.Nat^) {
  \import Cochains.At[C := complex, k := N.Nat^::succ n] \as H;
  \import \parent.Degree[n := N.Nat^::succ n] \as NextDegree;
  \definition cycle(x: Carrier (C.ranks n)): H.CycleCarrier := H.cycle (#apply{(C.differential n)} x)
    (#squareZero{(\bysub(Data, { data: Data \where Laws[data] }, C))} n x);
  \definition member: \forall (x: Carrier (C.ranks n)) -> \In[Carrier (C.ranks (N.Nat^::succ n))] (#carrier{H.boundaries}) (#apply{(C.differential n)} x) :=
    \fun (x: Carrier (C.ranks n)) => \exact(\into[Carrier (C.ranks n)](x,
      { y: Carrier (C.ranks n) \where #apply{(C.differential n)} y = #apply{(C.differential n)} x }) \by { \refl(#apply{(C.differential n)} x) },
      \Cast[Carrier (C.ranks n)] ({ y: Carrier (C.ranks n) \where #apply{(C.differential n)} y = #apply{(C.differential n)} x }));
  \definition projectionZero: \forall (x: Carrier (C.ranks n)) -> #apply{NextDegree.projection} (#apply{(C.differential n)} x) = #zero{NextDegree.target.space} :=
    \fun (x: Carrier (C.ranks n)) => trans!{H.Cohomology} _ _ _
      (NextDegree.projectionOnCycle (cycle x)) (H.boundaryClassZero (cycle x) (member x));
}
\import Cochains.Map[C := HomologyComplex.complex, D := complex] \as Inclusions;
\definition inclusion: Inclusions.Map := Inclusions.Map {
  apply := \fun (n: N.Nat^) => #apply{(Degree[n := n].inclusion)},
  addition := \fun (n: N.Nat^) => #addition{(Degree[n := n].inclusion)},
  scalar := \fun (n: N.Nat^) => #scalar{(Degree[n := n].inclusion)},
  commutes := \fun (n: N.Nat^)(x: homologyFamily.Carrier n) => trans!{{family.Carrier (N.Nat^::succ n)}} _ _ _
    (Degree[n := n].inclusionClosed x) (sym!{{family.Carrier (N.Nat^::succ n)}} _ _ Degree[n := N.Nat^::succ n].inclusionZero),
};
\import Cochains.Map[C := complex, D := HomologyComplex.complex] \as Projections;
\definition projection: Projections.Map := Projections.Map {
  apply := \fun (n: N.Nat^) => #apply{(Degree[n := n].projection)},
  addition := \fun (n: N.Nat^) => #addition{(Degree[n := n].projection)},
  scalar := \fun (n: N.Nat^) => #scalar{(Degree[n := n].projection)},
  commutes := \fun (n: N.Nat^)(x: family.Carrier n) =>
    sym!{{homologyFamily.Carrier (N.Nat^::succ n)}} _ _ (Boundary[n := n].projectionZero x),
};
\module At(n: N.Nat^);
\module Remainder(n: N.Nat^);
\module Contraction;
\module Equivalence;
