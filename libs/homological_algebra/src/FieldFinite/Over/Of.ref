\definition family: Cochains.Family := Cochains.Family {
  Carrier := \fun (n: N.Nat^) => Carrier (C.ranks n),
  space := \fun (n: N.Nat^) => space (C.ranks n),
};
\definition differential: Cochains.DifferentialData[family] := Cochains.DifferentialData[family] {
  apply := \fun (n: N.Nat^) => #apply{(C.differential n)},
};
\definition complex: Cochains.Complex := Cochains.Complex {
  family := family, differential := differential,
  laws := Cochains.DifferentialLaws[family, differential] {
    addition := \fun (n: N.Nat^) => #addition{(C.differential n)},
    scalar := \fun (n: N.Nat^) => #scalar{(C.differential n)},
    squareZero := #squareZero{(\bysub(Data, { data: Data \where Laws[data] }, C))},
  },
};
\module At(n: N.Nat^);
\definition DegreeSplitting(n: N.Nat^): \Set := At[n := n].Decomposition[].Splitting;
\definition Splittings: \Set := \forall (n: N.Nat^) -> DegreeSplitting n;
\definition splittingExistence: \exists Splittings := \axiom:classicalIndefiniteChoice(N.Nat^, DegreeSplitting,
  \fun (n: N.Nat^) => At[n := n].Decomposition[].existence);
\module HomologyTerm(n: N.Nat^) {
  \import Cochains.At[C := complex, k := n] \as H;
  \definition Carrier: \Set := H.Cohomology;
  \definition space: Modules.Space Carrier := H.cohomologySpace;
}
\definition homologyFamily: Cochains.Family := Cochains.Family {
  Carrier := \fun (n: N.Nat^) => HomologyTerm[n := n].Carrier,
  space := \fun (n: N.Nat^) => HomologyTerm[n := n].space,
};
\module Split(d: Splittings);
