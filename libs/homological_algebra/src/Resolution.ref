\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality::trans;
\use Equality::sym;
\use Equality::congr;
\use Equality::congr2;
\import std.Data[].Nat[] \as Nat;
\import std.Alg[].Ring[] \as Ring;
\module Over(R: \Set, ring: Ring.Ring[R]) {
  \import algebra.Module[].Over[R := R, ring := ring] \as Modules;
  \import \root.NonnegativeChain[].Over[R := R, ring := ring] \as Chains;
  \module LengthOne(K, L, M: Modules.Bundle);
  \module Horseshoe(A, B, C: Modules.Bundle, P, Q: Chains.Complex);
  \module Tail(M: Modules.Bundle, P: Chains.Complex);
  \module Projective(M: Modules.Bundle);
  \module Of(M: Modules.Bundle, P: Chains.Complex);
  \module Comparison(M, N: Modules.Bundle, P, Q: Chains.Complex, f: Modules.Hom[V := M.Carrier, W := N.Carrier, source := M.space, target := N.space].Map);
  \module Uniqueness(M, N: Modules.Bundle, P, Q: Chains.Complex);
  \module Equivalence(M: Modules.Bundle, P, Q: Chains.Complex);
  \module ShortExact;
}
