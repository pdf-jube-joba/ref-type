\import Modules.Tensor[V := P.family.Carrier n, W := N.Carrier, left := P.family.space n, right := N.space] \as Current;
\import Modules.Tensor[V := P.family.Carrier (Nat.Nat^::succ n), W := N.Carrier, left := P.family.space (Nat.Nat^::succ n), right := N.space] \as Before;
\import Modules.Tensor[V := P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)), W := N.Carrier, left := P.family.space (Nat.Nat^::succ (Nat.Nat^::succ n)), right := N.space] \as Earlier;
\definition Carrier: \Set := Current.Carrier;
\definition space: Modules.Space Carrier := Current.space;
\import Modules.Hom[V := P.family.Carrier (Nat.Nat^::succ n), W := P.family.Carrier n, source := P.family.space (Nat.Nat^::succ n), target := P.family.space n] \as Source;
\definition original: Source.Map := Source.Map { apply := #apply{P.differential} n, addition := #addition{P.laws} n, scalar := #scalar{P.laws} n };
\import Modules.End[V := N.Carrier, space := N.space] \as Coefficient;
\import Before.Mapping[U := P.family.Carrier n, Z := N.Carrier, targetLeft := P.family.space n, targetRight := N.space] \as Mapping;
\import Modules.Hom[V := Before.Carrier, W := Carrier, source := Before.space, target := space] \as Maps;
\definition differential: Maps.Map := Mapping.map original Coefficient.identity;
\definition onTensor: \forall (x: P.family.Carrier (Nat.Nat^::succ n))(y: N.Carrier) ->
  #apply{differential} (Before.tensor x y) = Current.tensor (#apply{P.differential} n x) y := Mapping.onTensor original Coefficient.identity;
\import Modules.Hom[V := P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)), W := P.family.Carrier (Nat.Nat^::succ n), source := P.family.space (Nat.Nat^::succ (Nat.Nat^::succ n)), target := P.family.space (Nat.Nat^::succ n)] \as PriorOriginal;
\definition beforeOriginal: PriorOriginal.Map := PriorOriginal.Map {
  apply := #apply{P.differential} (Nat.Nat^::succ n), addition := #addition{P.laws} (Nat.Nat^::succ n), scalar := #scalar{P.laws} (Nat.Nat^::succ n),
};
\import Earlier.Mapping[U := P.family.Carrier (Nat.Nat^::succ n), Z := N.Carrier, targetLeft := P.family.space (Nat.Nat^::succ n), targetRight := N.space] \as PriorMapping;
\import Modules.Hom[V := Earlier.Carrier, W := Before.Carrier, source := Earlier.space, target := Before.space] \as BeforeMaps;
\definition beforeDifferential: BeforeMaps.Map := PriorMapping.map beforeOriginal Coefficient.identity;
\import Maps.Composition[U := Earlier.Carrier, domain := Earlier.space] \as Composition;
\import Earlier.Universal[U := Carrier, target := space] \as Equality;
\import Modules.Hom[V := Earlier.Carrier, W := Carrier, source := Earlier.space, target := space] \as SquareMaps;
\definition squareMapZero: Composition.compose differential beforeDifferential = SquareMaps.zeroMap :=
  Equality.ext (Composition.compose differential beforeDifferential) SquareMaps.zeroMap
    (\fun (x: P.family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)))(y: N.Carrier) => trans!{Carrier} _ _ _
      (congr!{Before.Carrier Carrier} (#apply{differential}) _ _ (PriorMapping.onTensor beforeOriginal Coefficient.identity x y))
      (trans!{Carrier} _ _ _ (onTensor (#apply{P.differential} (Nat.Nat^::succ n) x) y)
        (trans!{Carrier} _ _ _ (congr!{{P.family.Carrier n} Carrier} (\fun (v: P.family.Carrier n) => Current.tensor v y) _ _ (#squareZero{P.laws} n x))
          (Current.tensorZeroLeft y))));
\definition squareZero: \forall (x: Earlier.Carrier) -> #apply{differential} (#apply{beforeDifferential} x) = #zero{space} :=
  \fun (x: Earlier.Carrier) => congr!{SquareMaps.Map Carrier} (\fun (f: SquareMaps.Map) => #apply{f} x) _ _ squareMapZero;
