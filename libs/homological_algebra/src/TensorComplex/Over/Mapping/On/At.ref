\import Modules.Tensor[V := P.family.Carrier n, W := N.Carrier, left := P.family.space n, right := N.space] \as Before;
\import Modules.Tensor[V := Q.family.Carrier n, W := L.Carrier, left := Q.family.space n, right := L.space] \as After;
\import Before.Mapping[U := Q.family.Carrier n, Z := L.Carrier, targetLeft := Q.family.space n, targetRight := L.space] \as Mapping;
\definition map: Modules.MapBetween (Modules.Bundle { Carrier := Before.Carrier, space := Before.space }) (Modules.Bundle { Carrier := After.Carrier, space := After.space }) :=
  Mapping.map (ChainMaps.At[n := n].linear f) u;
\definition onTensor: \forall (x: P.family.Carrier n)(y: N.Carrier) -> #apply{map} (Before.tensor x y) = After.tensor (#apply{f} n x) (#apply{u} y) :=
  Mapping.onTensor (ChainMaps.At[n := n].linear f) u;
