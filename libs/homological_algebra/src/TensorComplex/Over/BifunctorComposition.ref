\import \parent.On[P := P, N := N] \as Source;
\import \parent.On[P := Q, N := L] \as Middle;
\import \parent.On[P := T, N := K] \as Target;
\import Chains.Map[C := P, D := Q] \as Before;
\import Chains.Map[C := Q, D := T] \as After;
\import After.Composition[B := P] \as Original;
\import Modules.Hom[V := N.Carrier, W := L.Carrier, source := N.space, target := L.space] \as CoefficientsBefore;
\import Modules.Hom[V := L.Carrier, W := K.Carrier, source := L.space, target := K.space] \as CoefficientsAfter;
\import CoefficientsAfter.Composition[U := N.Carrier, domain := N.space] \as Coefficients;
\import \parent.Mapping[P := P, Q := Q, N := N, L := L] \as First;
\import \parent.Mapping[P := Q, Q := T, N := L, L := K] \as Second;
\import \parent.Mapping[P := P, Q := T, N := N, L := K] \as Direct;
\import Chains.Map[C := Middle.complex, D := Target.complex].Composition[B := Source.complex] \as Composition;
\import Chains.Map[C := Source.complex, D := Target.complex] \as Maps;
\module At(n: Nat.Nat^) {
  \import Modules.Tensor[V := P.family.Carrier n, W := N.Carrier, left := P.family.space n, right := N.space] \as S;
  \import Modules.Tensor[V := T.family.Carrier n, W := K.Carrier, left := T.family.space n, right := K.space] \as D;
  \import S.Universal[U := D.Carrier, target := D.space] \as Universal;
  \import Modules.Hom[V := S.Carrier, W := D.Carrier, source := S.space, target := D.space] \as Native;
  \definition direct(f: Before.Map)(g: After.Map)(u: CoefficientsBefore.Map)(v: CoefficientsAfter.Map): Native.Map := Direct.On[f := Original.compose g f, u := Coefficients.compose v u].At[n := n].map;
  \definition composed(f: Before.Map)(g: After.Map)(u: CoefficientsBefore.Map)(v: CoefficientsAfter.Map): Native.Map := Native.Map {
    apply := #apply{(Composition.compose (Second.On[f := g, u := v].map) (First.On[f := f, u := u].map))} n,
    addition := #addition{(Composition.compose (Second.On[f := g, u := v].map) (First.On[f := f, u := u].map))} n,
    scalar := #scalar{(Composition.compose (Second.On[f := g, u := v].map) (First.On[f := f, u := u].map))} n,
  };
  \definition law: \forall (f: Before.Map)(g: After.Map)(u: CoefficientsBefore.Map)(v: CoefficientsAfter.Map) -> direct f g u v = composed f g u v :=
    \fun (f: Before.Map)(g: After.Map)(u: CoefficientsBefore.Map)(v: CoefficientsAfter.Map) => Universal.ext (direct f g u v) (composed f g u v)
      (\fun (x: P.family.Carrier n)(y: N.Carrier) => trans!{D.Carrier} _ _ _
        (Direct.On[f := Original.compose g f, u := Coefficients.compose v u].At[n := n].onTensor x y)
        (sym!{D.Carrier} _ _ (trans!{D.Carrier} _ _ _
          (congr!{{Middle.Carrier n} D.Carrier} (#apply{(Second.On[f := g, u := v].At[n := n].map)}) _ _
            (First.On[f := f, u := u].At[n := n].onTensor x y))
          (Second.On[f := g, u := v].At[n := n].onTensor (#apply{f} n x) (#apply{u} y)))));
  \definition pointwise: \forall (f: Before.Map)(g: After.Map)(u: CoefficientsBefore.Map)(v: CoefficientsAfter.Map)(x: S.Carrier) -> #apply{(direct f g u v)} x = #apply{(composed f g u v)} x :=
    \fun (f: Before.Map)(g: After.Map)(u: CoefficientsBefore.Map)(v: CoefficientsAfter.Map)(x: S.Carrier) => congr!{Native.Map D.Carrier} (\fun (h: Native.Map) => #apply{h} x) _ _ (law f g u v);
}
\definition law: \forall (f: Before.Map)(g: After.Map)(u: CoefficientsBefore.Map)(v: CoefficientsAfter.Map) -> Direct.On[f := Original.compose g f, u := Coefficients.compose v u].map =
  Composition.compose (Second.On[f := g, u := v].map) (First.On[f := f, u := u].map) :=
  \fun (f: Before.Map)(g: After.Map)(u: CoefficientsBefore.Map)(v: CoefficientsAfter.Map) => Maps.ext _ _ (\fun (n: Nat.Nat^) => At[n := n].pointwise f g u v);
