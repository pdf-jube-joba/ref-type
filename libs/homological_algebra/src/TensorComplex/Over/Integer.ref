\import \root.Chain[] \as Degrees;
\definition Degree: \Set := Degrees.Degree;
\definition previous: Degree -> Degree := Degrees.previous;
\module At(z: Degree) {
  \import Modules.Tensor[V := P.family.Carrier z, W := N.Carrier, left := P.family.space z, right := N.space] \as Native;
  \definition Carrier: \Set := Native.Carrier;
  \definition space: Modules.Space Carrier := Native.space;
  \definition tensor: P.family.Carrier z -> N.Carrier -> Carrier := Native.tensor;
}
\definition Carrier(z: Degree): \Set := At[z := z].Carrier;
\definition space(z: Degree): Modules.Space (Carrier z) := At[z := z].space;
\definition family: IntegerChains.Family := IntegerChains.Family { Carrier := Carrier, space := space };
\import Modules.End[V := N.Carrier, space := N.space] \as Coefficient;
\module Step(z: Degree);
\definition apply(z: Degree)(x: Carrier z): Carrier (previous z) := #apply{Step[z := z].differential} x;
\definition differential: IntegerChains.DifferentialData[family] := IntegerChains.DifferentialData[family] { apply := apply };
\definition complex: IntegerChains.Complex := IntegerChains.Complex {
  family := family, differential := differential,
  laws := IntegerChains.DifferentialLaws[family, differential] {
    addition := \fun (z: Degree) => #addition{Step[z := z].differential},
    scalar := \fun (z: Degree) => #scalar{Step[z := z].differential},
    squareZero := \fun (z: Degree) => Step[z := z].squareZero,
  },
};
\import IntegerChains.Prior[C := P] \as OriginalPrior;
\import IntegerChains.Prior[C := complex] \as TensorPrior;
\import std.Set[].Transport[I := Degree] \as Transport;
\definition priorOnTensor: \forall (z: Degree)(x: P.family.Carrier (Degrees.next z))(a: N.Carrier) ->
  TensorPrior.value z (At[z := Degrees.next z].tensor x a) = At[z := z].tensor (OriginalPrior.value z x) a :=
  \fun (z: Degree)(x: P.family.Carrier (Degrees.next z))(a: N.Carrier) => trans!{{Carrier z}} _ _ _
    (congr!{{Carrier (previous (Degrees.next z))} {Carrier z}}
      (Transport.cast Carrier (previous (Degrees.next z)) z (Degrees.previousNext z)) _ _
      (Step[z := Degrees.next z].onTensor x a))
    (Transport.natural P.family.Carrier Carrier (\fun (k: Degree)(v: P.family.Carrier k) => At[z := k].tensor v a)
      (previous (Degrees.next z)) z (Degrees.previousNext z) (#apply{P.differential} (Degrees.next z) x));
\module Homology(z: Degree) {
  \import IntegerChains.At[C := complex, z := z] \as Native;
  \definition Carrier: \Set := Native.Homology;
  \definition space: Modules.Space Carrier := Native.homologySpace;
  \definition Cycle: \Set := Native.Cycle;
  \definition cycleSpace: Modules.Space Cycle := Native.cycleSpace;
  \definition classOf: Cycle -> Carrier := Native.classOf;
}
