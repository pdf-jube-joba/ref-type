\import \parent.On[P := P, N := N] \as Tensor;
\import Chains.End[C := P] \as Original;
\import Modules.End[V := N.Carrier, space := N.space] \as Coefficients;
\import \parent.Mapping[P := P, Q := P, N := N, L := N].On[f := Original.identity, u := Coefficients.identity] \as Action;
\import Chains.Map[C := Tensor.complex, D := Tensor.complex] \as Maps;
\import Chains.End[C := Tensor.complex] \as Identity;
\module At(n: Nat.Nat^) {
  \import Modules.Tensor[V := P.family.Carrier n, W := N.Carrier, left := P.family.space n, right := N.space] \as T;
  \import T.Universal[U := T.Carrier, target := T.space] \as Universal;
  \import Modules.End[V := T.Carrier, space := T.space] \as Native;
  \import Modules.Hom[V := T.Carrier, W := T.Carrier, source := T.space, target := T.space] \as NativeMaps;
  \definition law: Action.At[n := n].map = Native.identity :=
    Universal.ext (Action.At[n := n].map) Native.identity (\fun (x: P.family.Carrier n)(y: N.Carrier) => Action.At[n := n].onTensor x y);
  \definition pointwise: \forall (x: T.Carrier) -> #apply{Action.map} n x = x :=
    \fun (x: T.Carrier) => congr!{NativeMaps.Map T.Carrier} (\fun (f: NativeMaps.Map) => #apply{f} x) _ _ law;
}
\definition law: Action.map = Identity.identity := Maps.ext Action.map Identity.identity (\fun (n: Nat.Nat^) => At[n := n].pointwise);
