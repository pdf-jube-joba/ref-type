\import Int.Math[].Specification[].Prop[].Multiplication[] \as Multiplication;
\definition oneExact: \forall (x: family.Carrier (Nat.Nat^::succ Nat.Nat^::zero)) -> apply Nat.Nat^::zero x = #zero{(family.space Nat.Nat^::zero)} ->
  \exists { y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)) \where apply (Nat.Nat^::succ Nat.Nat^::zero) y = x } :=
  \fun (x: family.Carrier (Nat.Nat^::succ Nat.Nat^::zero))(killed: apply Nat.Nat^::zero x = #zero{(family.space Nat.Nat^::zero)}) =>
    \exact(\into[family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero))](zero (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)),
      { y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)) \where apply (Nat.Nat^::succ Nat.Nat^::zero) y = x }) \by {
        sym!{Int.Int^} x Arithmetic.zero (Domain.positiveCancellation m x Arithmetic.zero
          (trans!{Int.Int^} (Arithmetic.mul multiplier x) Arithmetic.zero (Arithmetic.mul multiplier Arithmetic.zero) killed (sym!{Int.Int^} _ _ (Multiplication.mulZeroRight multiplier))))
      }, \Cast[family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero))] ({ y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ Nat.Nat^::zero)) \where apply (Nat.Nat^::succ Nat.Nat^::zero) y = x }));
\definition highExact: \forall (n: Nat.Nat^)(x: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n))) -> apply (Nat.Nat^::succ n) x = #zero{(family.space (Nat.Nat^::succ n))} ->
  \exists { y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ (Nat.Nat^::succ n))) \where apply (Nat.Nat^::succ (Nat.Nat^::succ n)) y = x } :=
  \fun (n: Nat.Nat^)(x: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)))(killed: _) =>
    \exact(\into[family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ (Nat.Nat^::succ n)))](zero (Nat.Nat^::succ (Nat.Nat^::succ (Nat.Nat^::succ n))),
      { y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ (Nat.Nat^::succ n))) \where apply (Nat.Nat^::succ (Nat.Nat^::succ n)) y = x }) \by {
        sym!{Int.Int^} _ _ (highZero n x)
      }, \Cast[family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ (Nat.Nat^::succ n)))] ({ y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ (Nat.Nat^::succ n))) \where apply (Nat.Nat^::succ (Nat.Nat^::succ n)) y = x }));
\definition exact: \forall (n: Nat.Nat^)(x: family.Carrier (Nat.Nat^::succ n)) -> apply n x = #zero{(family.space n)} -> \exists { y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where apply (Nat.Nat^::succ n) y = x } :=
  \induction (n: Nat.Nat^) \return \forall (x: family.Carrier (Nat.Nat^::succ n)) -> apply n x = #zero{(family.space n)} -> \exists { y: family.Carrier (Nat.Nat^::succ (Nat.Nat^::succ n)) \where apply (Nat.Nat^::succ n) y = x } \with {
    | zero: oneExact
    | succ: \fun (n: Nat.Nat^)(before: _) => highExact n
  };
