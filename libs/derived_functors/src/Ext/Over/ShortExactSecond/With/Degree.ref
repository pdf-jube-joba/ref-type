\definition term: Modules.Bundle := Modules.Bundle { Carrier := P.family.Carrier n, space := P.family.space n };
\import Algebra.ProjectiveHomShortExact[P := term, A := A, B := B, C := C].On[sequence := sequence] \as HomSequence;
\definition nativeSequence: Modules.ShortExact[A := Modules.Bundle { Carrier := Left.Carrier n, space := Left.space n }, B := Modules.Bundle { Carrier := Middle.Carrier n, space := Middle.space n }, C := Modules.Bundle { Carrier := Right.Carrier n, space := Right.space n }].Sequence := HomSequence.shortExact (#projective{resolution} n);
\definition injective: \forall (f, g: Left.Carrier n) -> #apply{data.inclusion} n f = #apply{data.inclusion} n g -> f = g := #injective{nativeSequence};
\definition onto: \forall (f: Right.Carrier n) -> \exists { g: Middle.Carrier n \where #apply{data.projection} n g = f } := #onto{nativeSequence};
\definition zero: \forall (f: Left.Carrier n) -> #apply{data.projection} n (#apply{data.inclusion} n f) = #zero{(Right.space n)} := #zero{nativeSequence};
\definition kernelImage: \forall (f: Middle.Carrier n) -> #apply{data.projection} n f = #zero{(Right.space n)} -> \exists { g: Left.Carrier n \where #apply{data.inclusion} n g = f } := #kernelImage{nativeSequence};
