\import Modules.ShortExact[A := A, B := B, C := C] \as Sequences;
\import resolutions.Resolution[].Over[R := R, ring := Ring.commutativeRingAsRing R ring].Of[M := M, P := P] \as Resolution;
\import resolutions.HomComplex[].Over[R := R, ring := ring] \as HomComplexes;
\import HomComplexes.On[P := P, N := A] \as Left;
\import HomComplexes.On[P := P, N := B] \as Middle;
\import HomComplexes.On[P := P, N := C] \as Right;
\import \parent.Second[M := M, N := A, L := B, P := P] \as Inclusion;
\import \parent.Second[M := M, N := B, L := C, P := P] \as Projection;
\import chain_complexes.Cochain[].Over[R := R, ring := Ring.commutativeRingAsRing R ring] \as Cochains;
\import Cochains.ShortExact[A := Left.complex, B := Middle.complex, C := Right.complex] \as Sequence;
\module With(sequence: Sequences.Sequence, resolution: Resolution.Resolution);
