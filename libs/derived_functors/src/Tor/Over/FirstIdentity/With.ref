\definition augmented: \forall (x: P.family.Carrier Nat.Nat^::zero) ->
  #apply{#augmentation{resolution}} (#apply{ChainIdentity.identity} Nat.Nat^::zero x) =
  #apply{AugmentedIdentity.identity} (#apply{#augmentation{resolution}} x) :=
  \fun (x: P.family.Carrier Nat.Nat^::zero) => \refl(#apply{#augmentation{resolution}} x);
\module DegreeZero;
\module Positive(n: Nat.Nat^);
