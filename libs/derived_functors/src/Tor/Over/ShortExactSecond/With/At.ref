\definition higher: Nat.Nat^ := Nat.Nat^::succ n;
\import LongExact.At[n := n] \as Exact;
\import Exact.Exactness[] \as Exactness;
\import Chains.Map[C := Left.tensorComplex, D := Middle.tensorComplex].HomologyAt[n := higher] \as InclusionMaps;
\import Chains.Map[C := Middle.tensorComplex, D := Right.tensorComplex].HomologyAt[n := higher] \as ProjectionMaps;
\import Chains.Map[C := Left.tensorComplex, D := Middle.tensorComplex].HomologyAt[n := n] \as NextMaps;
\definition inclusion: Modules.Hom[V := Left.At[n := higher].Carrier, W := Middle.At[n := higher].Carrier, source := Left.At[n := higher].space, target := Middle.At[n := higher].space].Map := InclusionMaps.induced tensorSequence.inclusion;
\definition projection: Modules.Hom[V := Middle.At[n := higher].Carrier, W := Right.At[n := higher].Carrier, source := Middle.At[n := higher].space, target := Right.At[n := higher].space].Map := ProjectionMaps.induced tensorSequence.projection;
\definition connecting: Modules.Hom[V := Right.At[n := higher].Carrier, W := Left.At[n := n].Carrier, source := Right.At[n := higher].space, target := Left.At[n := n].space].Map := Exact.connecting;
\definition nextInclusion: Modules.Hom[V := Left.At[n := n].Carrier, W := Middle.At[n := n].Carrier, source := Left.At[n := n].space, target := Middle.At[n := n].space].Map := NextMaps.induced tensorSequence.inclusion;
\definition inclusionProjectionZero: \forall (x: Left.At[n := higher].Carrier) -> #apply{projection} (#apply{inclusion} x) = #zero{(Right.At[n := higher].space)} := Exactness.inclusionProjectionZero;
\definition projectionConnectingZero: \forall (x: Middle.At[n := higher].Carrier) -> #apply{connecting} (#apply{projection} x) = #zero{(Left.At[n := n].space)} := Exactness.projectionConnectingZero;
\definition connectingInclusionZero: \forall (x: Right.At[n := higher].Carrier) -> #apply{nextInclusion} (#apply{connecting} x) = #zero{(Middle.At[n := n].space)} := Exactness.connectingInclusionZero;
\definition exactAtB: \forall (x: Middle.At[n := higher].Carrier) -> #apply{projection} x = #zero{(Right.At[n := higher].space)} -> \exists { y: Left.At[n := higher].Carrier \where #apply{inclusion} y = x } := Exactness.exactAtB;
\definition exactAtC: \forall (x: Right.At[n := higher].Carrier) -> #apply{connecting} x = #zero{(Left.At[n := n].space)} -> \exists { y: Middle.At[n := higher].Carrier \where #apply{projection} y = x } := Exactness.exactAtC;
\definition exactAtALower: \forall (x: Left.At[n := n].Carrier) -> #apply{nextInclusion} x = #zero{(Middle.At[n := n].space)} -> \exists { y: Right.At[n := higher].Carrier \where #apply{connecting} y = x } := Exactness.exactAtALower;
