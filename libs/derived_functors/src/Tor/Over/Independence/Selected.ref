\import Modules.End[V := M.Carrier, space := M.space] \as Identity;
\import \parent.\parent.First[M := M, L := M, N := N, P := P, Q := Q] \as ForwardAction;
\import \parent.\parent.First[M := M, L := M, N := N, P := Q, Q := P] \as BackwardAction;
\import \parent.\parent.FirstComposition[M := M, L := M, T := M, N := N, P := P, Q := Q, S := P].With[p := p, q := q, r := p, u := Identity.identity, v := Identity.identity] \as LeftComposition;
\import \parent.\parent.FirstComposition[M := M, L := M, T := M, N := N, P := Q, Q := P, S := Q].With[p := q, q := p, r := q, u := Identity.identity, v := Identity.identity] \as RightComposition;
\import \parent.\parent.FirstIdentity[M := M, N := N, P := P].With[resolution := p] \as SourceIdentity;
\import \parent.\parent.FirstIdentity[M := M, N := N, P := Q].With[resolution := q] \as TargetIdentity;
\module DegreeZero;
\module Positive(n: Nat.Nat^);
\module At(n: Nat.Nat^) {
  \definition isomorphism: Modules.Isomorphism[V := Source.At[n := n].Carrier, W := Target.At[n := n].Carrier,
    source := Source.At[n := n].space, target := Target.At[n := n].space].Isomorphism :=
    (\induction (k: Nat.Nat^) \return Modules.Isomorphism[V := Source.At[n := k].Carrier, W := Target.At[n := k].Carrier,
      source := Source.At[n := k].space, target := Target.At[n := k].space].Isomorphism \with {
      | zero: \parent.DegreeZero[].isomorphism
      | succ: \fun (k: Nat.Nat^)(previous: _) => \parent.Positive[n := k].isomorphism
    }) n;
}
