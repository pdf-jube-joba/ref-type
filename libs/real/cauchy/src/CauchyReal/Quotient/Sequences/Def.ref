\definition ConstSeq(a: Rat): Sequence := S.ConstSeq a;

\definition AddSeq(x, y: CauchySeq): Sequence := \fun (n: _) =>
    S.AddSeq x y n;

\definition MulSeq(x, y: CauchySeq): Sequence := \fun (n: _) =>
    S.MulSeq x y n;

\definition NegSeq(x: CauchySeq): Sequence := \fun (n: _) => negRat (at x n);

\definition constCauchy:
  \forall (a: Rat) ->
  IsCauchy (ConstSeq a) := S.constCauchy;
\definition addCauchy:
  \forall (x, y: CauchySeq) ->
  IsCauchy (AddSeq x y) := S.addCauchy;
\definition mulCauchy:
  \forall (x, y: CauchySeq) ->
  IsCauchy (MulSeq x y) := S.mulCauchy;
\definition negCauchy:
  \forall (x: CauchySeq) ->
  IsCauchy (NegSeq x) := S.negCauchy;

\definition ConstCauchy(a: Rat): CauchySeq :=
    CauchySeq { sequence := ConstSeq a,
 cauchy := constCauchy a };

\definition AddCauchy(x, y: CauchySeq): CauchySeq :=
    CauchySeq { sequence := AddSeq x y,
 cauchy := addCauchy x y };

\definition MulCauchy(x, y: CauchySeq): CauchySeq :=
    CauchySeq { sequence := MulSeq x y,
 cauchy := mulCauchy x y };

\definition NegCauchy(x: CauchySeq): CauchySeq :=
    CauchySeq { sequence := NegSeq x,
 cauchy := negCauchy x };
