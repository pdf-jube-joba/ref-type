\import \parent.Def[] \as Def;

\import std.Arithmetic[].Rat[].Estimates[] \as Estimates;
\import \parent.\parent.Cuts[].Prop[] \as CutLaws;
\import RationalFractions.Order[] \as RationalOrder;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Classical[] \as Classical;
\import \parent.\parent.Order[] \as CutOrder;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;

\definition ofRatMem (a, q: Rat) (qa: lt q a): mem (Def.ofRat a) q :=
  \idelim Cuts.RatLower a = underlying (Def.ofRat a)
    \with T: \Pow Rat => \In[Rat] T q
    \by { base: qa, equality: \refl(Cuts.RatLower a) };

\definition ofRatMemLt (a, q: Rat) (member: mem (Def.ofRat a) q): lt q a :=
  \idelim underlying (Def.ofRat a) = Cuts.RatLower a
    \with T: \Pow Rat => \In[Rat] T q
    \by { base: member, equality: \refl(Cuts.RatLower a) };

\definition addMem (x, y: Real) (q: Rat)
  (member: In (Cuts.SumLower x y) q): mem (Def.add x y) q :=
  \idelim Cuts.SumLower x y = underlying (Def.add x y)
    \with T: \Pow Rat => \In[Rat] T q
    \by { base: member, equality: \refl(Cuts.SumLower x y) };

\definition addMemLower (x, y: Real) (q: Rat)
  (member: mem (Def.add x y) q): In (Cuts.SumLower x y) q :=
  \idelim underlying (Def.add x y) = Cuts.SumLower x y
    \with T: \Pow Rat => \In[Rat] T q
    \by { base: member, equality: \refl(Cuts.SumLower x y) };

\definition negMem (x: Real) (q: Rat)
  (member: In (Cuts.NegLower x) q): mem (Def.neg x) q :=
  \idelim Cuts.NegLower x = underlying (Def.neg x)
    \with T: \Pow Rat => \In[Rat] T q
    \by { base: member, equality: \refl(Cuts.NegLower x) };

\definition negMemLower (x: Real) (q: Rat)
  (member: mem (Def.neg x) q): In (Cuts.NegLower x) q :=
  \idelim underlying (Def.neg x) = Cuts.NegLower x
    \with T: \Pow Rat => \In[Rat] T q
    \by { base: member, equality: \refl(Cuts.NegLower x) };

\definition mulMem (x, y: Real) (q: Rat)
  (member: In (Cuts.MulLower x y) q): mem (Def.mul x y) q :=
  \idelim Cuts.MulLower x y = underlying (Def.mul x y)
    \with T: \Pow Rat => \In[Rat] T q
    \by { base: member, equality: \refl(Cuts.MulLower x y) };

\definition mulMemLower (x, y: Real) (q: Rat)
  (member: mem (Def.mul x y) q): In (Cuts.MulLower x y) q :=
  \idelim underlying (Def.mul x y) = Cuts.MulLower x y
    \with T: \Pow Rat => \In[Rat] T q
    \by { base: member, equality: \refl(Cuts.MulLower x y) };

\definition invMem (x: Real) (q: Rat)
  (member: In (Cuts.InvLower x) q): mem (Def.inv x) q :=
  \idelim Cuts.InvLower x = underlying (Def.inv x)
    \with T: \Pow Rat => \In[Rat] T q
    \by { base: member, equality: \refl(Cuts.InvLower x) };

\definition invMemLower (x: Real) (q: Rat)
  (member: mem (Def.inv x) q): In (Cuts.InvLower x) q :=
  \idelim underlying (Def.inv x) = Cuts.InvLower x
    \with T: \Pow Rat => \In[Rat] T q
    \by { base: member, equality: \refl(Cuts.InvLower x) };

\definition ltOfRat (a, b: Rat) (ab: lt a b): Lt (Def.ofRat a) (Def.ofRat b) :=
  \block {
    \let q: Rat := RationalOperations.midpoint a b \then
    \let aq: lt a q := RationalOperationsProp.ltMidpoint a b ab \then
    \let qb: lt q b := RationalOperationsProp.midpointLt a b ab \then
    \return \exact(
      \into[Rat](q, { q : Rat \where Logic.And[Logic.Not (mem (Def.ofRat a) q), mem (Def.ofRat b) q] }) \by { Logic.And[
          Logic.Not (mem (Def.ofRat a) q), mem (Def.ofRat b) q]::# (\fun (qa: mem (Def.ofRat a) q) =>
            RationalOrder.ltIrrefl a
              (RationalOrder.ltTrans a q a aq (ofRatMemLt a q qa))) (ofRatMem b q qb) },
      \Cast[Rat] ({ q : Rat \where Logic.And[Logic.Not (mem (Def.ofRat a) q), mem (Def.ofRat b) q] }))
  };

\definition ofRatLt (a, b: Rat) (ab: Lt (Def.ofRat a) (Def.ofRat b)): lt a b :=
  \block {
    \takefrom q: \Cast[Rat] ({ q : Rat \where Logic.And[Logic.Not (mem (Def.ofRat a) q), mem (Def.ofRat b) q] }) \by ab \then
    \let nqa: Logic.Not (mem (Def.ofRat a) q) :=
      #left{(\bysub(Rat, { q : Rat \where Logic.And[Logic.Not (mem (Def.ofRat a) q), mem (Def.ofRat b) q] }, q))} \then
    \let qb: lt q b := ofRatMemLt b q
      (#right{(\bysub(Rat, { q : Rat \where Logic.And[Logic.Not (mem (Def.ofRat a) q), mem (Def.ofRat b) q] }, q))}) \then
    \return Logic.orElim (lt a b)
      (Logic.Or[RationalFractions.FractionEq a b, lt b a]) (lt a b)
      (\fun (h: lt a b) => h)
      (\fun (rest: Logic.Or[RationalFractions.FractionEq a b, lt b a]) =>
        Logic.orElim (RationalFractions.FractionEq a b) (lt b a)
          (lt a b)
          (\fun (same: RationalFractions.FractionEq a b) =>
            Logic.falseElim (lt a b)
              (nqa (ofRatMem a q
                (RationalOrder.ltReplaceRight q b a
                  (RationalFractions.fractionEqSym _ _ same) qb))))
          (\fun (ba: lt b a) =>
            Logic.falseElim (lt a b)
              (nqa (ofRatMem a q
                (RationalOrder.ltTrans q b a qb ba))))
          rest)
      (RationalOrder.trichotomy a b)
  };

\definition ofRatRespects (a, b: Rat)
  (ab: RationalFractions.FractionEq a b): Def.ofRat a = Def.ofRat b :=
  eqByExt (Def.ofRat a) (Def.ofRat b)
    (\fun (q: Rat) => \fun (qa: mem (Def.ofRat a) q) =>
      ofRatMem b q
        (RationalOrder.ltReplaceRight q a b ab (ofRatMemLt a q qa)))
    (\fun (q: Rat) => \fun (qb: mem (Def.ofRat b) q) =>
      ofRatMem a q
        (RationalOrder.ltReplaceRight q b a
          (RationalFractions.fractionEqSym _ _ ab) (ofRatMemLt b q qb)));

\definition notLtOfOfRatLe (a, b: Rat)
  (ab: Le (Def.ofRat a) (Def.ofRat b)): Logic.Not (lt b a) :=
  \fun (ba: lt b a) =>
    (ltNotLeReverse (Def.ofRat b) (Def.ofRat a) (ltOfRat b a ba)) ab;

\definition ofRatLeOfNotLt (a, b: Rat) (notBa: Logic.Not (lt b a)):
  Le (Def.ofRat a) (Def.ofRat b) :=
  CutOrder.leOfNotLtReverse (Def.ofRat a) (Def.ofRat b)
    (\fun (reverse: Lt (Def.ofRat b) (Def.ofRat a)) =>
      notBa (ofRatLt b a reverse));

\definition ofRatInjective (a, b: Rat) (same: Def.ofRat a = Def.ofRat b):
  RationalFractions.FractionEq a b :=
  Logic.orElim (lt a b)
    (Logic.Or[RationalFractions.FractionEq a b, lt b a])
    (RationalFractions.FractionEq a b)
    (\fun (ab: lt a b) =>
      Logic.falseElim (RationalFractions.FractionEq a b)
        ((ltNotLeReverse (Def.ofRat a) (Def.ofRat b) (ltOfRat a b ab))
          (leReplaceRight (Def.ofRat b) (Def.ofRat b) (Def.ofRat a)
            (sym!{Real} (Def.ofRat a) (Def.ofRat b) same)
            (leRefl (Def.ofRat b)))))
    (\fun (rest: Logic.Or[RationalFractions.FractionEq a b, lt b a]) =>
      Logic.orElim (RationalFractions.FractionEq a b) (lt b a)
        (RationalFractions.FractionEq a b)
        (\fun (ab: RationalFractions.FractionEq a b) => ab)
        (\fun (ba: lt b a) =>
          Logic.falseElim (RationalFractions.FractionEq a b)
            ((ltNotLeReverse (Def.ofRat b) (Def.ofRat a) (ltOfRat b a ba))
              (leReplaceRight (Def.ofRat a) (Def.ofRat a) (Def.ofRat b) same
                (leRefl (Def.ofRat a)))))
        rest)
    (RationalOrder.trichotomy a b);

\definition ofRatAddLe (a, b: Rat):
  Le (Def.add (Def.ofRat a) (Def.ofRat b)) (Def.ofRat (addRat a b)) :=
  \fun (q: Rat) => \fun (member: mem (Def.add (Def.ofRat a) (Def.ofRat b)) q) =>
    CutLaws.sumElim (Def.ofRat a) (Def.ofRat b) q
      (addMemLower (Def.ofRat a) (Def.ofRat b) q member)
      (mem (Def.ofRat (addRat a b)) q)
      (\fun (u, v: Rat) =>
        \fun (ua: mem (Def.ofRat a) u) => \fun (vb: mem (Def.ofRat b) v) =>
          \fun (quv: lt q (addRat u v)) =>
            ofRatMem (addRat a b) q
              (RationalOrder.ltTrans q (addRat u v) (addRat a b) quv
                (RationalOperationsProp.ltAdd u a v b
                  (ofRatMemLt a u ua) (ofRatMemLt b v vb))));

\definition leOfRatAdd (a, b: Rat):
  Le (Def.ofRat (addRat a b)) (Def.add (Def.ofRat a) (Def.ofRat b)) :=
  \fun (q: Rat) => \fun (member: mem (Def.ofRat (addRat a b)) q) =>
    \block {
      \let qab: lt q (addRat a b) := ofRatMemLt (addRat a b) q member \then
      \let u: Rat := RationalOperations.perturbLeft q a b \then
      \let ua: lt u a := RationalOperationsProp.perturbLeftLt q a b qab \then
      \let qub: lt q (addRat u b) :=
        RationalOperationsProp.ltPerturbedSum q a b qab \then
      \let qbu: lt q (addRat b u) :=
        RationalOrder.ltReplaceRight q (addRat u b) (addRat b u)
          (RationalOperationsProp.fractionAddComm u b) qub \then
      \let v: Rat := RationalOperations.perturbLeft q b u \then
      \let vb: lt v b := RationalOperationsProp.perturbLeftLt q b u qbu \then
      \let qvu: lt q (addRat v u) :=
        RationalOperationsProp.ltPerturbedSum q b u qbu \then
      \let quv: lt q (addRat u v) :=
        RationalOrder.ltReplaceRight q (addRat v u) (addRat u v)
          (RationalOperationsProp.fractionAddComm v u) qvu \then
      \return addMem (Def.ofRat a) (Def.ofRat b) q
        (CutLaws.sumIntro (Def.ofRat a) (Def.ofRat b) q u v
          (ofRatMem a u ua) (ofRatMem b v vb) quv)
    };

\definition ofRatAdd (a, b: Rat):
  Def.add (Def.ofRat a) (Def.ofRat b) = Def.ofRat (addRat a b) :=
  eqByExt (Def.add (Def.ofRat a) (Def.ofRat b)) (Def.ofRat (addRat a b))
    (ofRatAddLe a b) (leOfRatAdd a b);

\definition ofRatNegLe (a: Rat): Le (Def.neg (Def.ofRat a)) (Def.ofRat (negRat a)) :=
  \block {
    \fun (q: Rat) \then
    \fun (member: mem (Def.neg (Def.ofRat a)) q) \then
    \let lowerMember: In (Cuts.NegLower (Def.ofRat a)) q :=
      negMemLower (Def.ofRat a) q member \then
    \return CutLaws.negElim (Def.ofRat a) q lowerMember
      (mem (Def.ofRat (negRat a)) q)
      (\fun (r: Rat) =>
        \fun (nra: Logic.Not (mem (Def.ofRat a) r)) =>
          \fun (qnr: lt q (negRat r)) =>
            Logic.orElim (lt r a)
              (Logic.Or[RationalFractions.FractionEq r a, lt a r])
              (mem (Def.ofRat (negRat a)) q)
              (\fun (ra: lt r a) =>
                Logic.falseElim (mem (Def.ofRat (negRat a)) q)
                  (nra (ofRatMem a r ra)))
              (\fun (rest: Logic.Or[
                RationalFractions.FractionEq r a, lt a r]) =>
                Logic.orElim (RationalFractions.FractionEq r a) (lt a r)
                  (mem (Def.ofRat (negRat a)) q)
                  (\fun (same: RationalFractions.FractionEq r a) =>
                    ofRatMem (negRat a) q
                      (RationalOrder.ltReplaceRight q (negRat r) (negRat a)
                        (RationalOperationsProp.fractionNegRespects r a same) qnr))
                  (\fun (ar: lt a r) =>
                    ofRatMem (negRat a) q
                      (RationalOrder.ltTrans q (negRat r) (negRat a) qnr
                        (RationalOperationsProp.ltNegReverse a r ar)))
                  rest)
              (RationalOrder.trichotomy r a))
  };

\definition leOfRatNeg (a: Rat): Le (Def.ofRat (negRat a)) (Def.neg (Def.ofRat a)) :=
  \fun (q: Rat) => \fun (qa: mem (Def.ofRat (negRat a)) q) =>
    negMem (Def.ofRat a) q
      (CutLaws.negIntro (Def.ofRat a) q a
        (\fun (aa: mem (Def.ofRat a) a) =>
          RationalOrder.ltIrrefl a (ofRatMemLt a a aa))
        (ofRatMemLt (negRat a) q qa));

\definition ofRatNeg (a: Rat): Def.neg (Def.ofRat a) = Def.ofRat (negRat a) :=
  eqByExt (Def.neg (Def.ofRat a)) (Def.ofRat (negRat a))
    (ofRatNegLe a) (leOfRatNeg a);

\definition RationalBetween (x, y: Real): \Prop :=
  \exists { r : Rat \where Logic.And[Lt x (Def.ofRat r), Lt (Def.ofRat r) y] };

\definition rationalDensity (x, y: Real) (xy: Lt x y):
  RationalBetween x y :=
  \block {
    \takefrom q: \Cast[Rat] ({ q : Rat \where Logic.And[Logic.Not (mem x q), mem y q] }) \by xy \then
    \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.And[mem y r, lt q r] }) \by #rounded{y} q
      (#right{(\bysub(Rat, { q : Rat \where Logic.And[Logic.Not (mem x q), mem y q] }, q))}) \then
    \let nxq: Logic.Not (mem x q) :=
      #left{(\bysub(Rat, { q : Rat \where Logic.And[Logic.Not (mem x q), mem y q] }, q))} \then
    \let yr: mem y r :=
      #left{(\bysub(Rat, { r : Rat \where Logic.And[mem y r, lt q r] }, r))} \then
    \let qr: lt q r :=
      #right{(\bysub(Rat, { r : Rat \where Logic.And[mem y r, lt q r] }, r))} \then
    \let nxr: Logic.Not (mem x r) :=
      \fun (xr: mem x r) => nxq (#lower{x} q r qr xr) \then
    \let left: Lt x (Def.ofRat r) :=
      \exact(
        \into[Rat](q, { a : Rat \where Logic.And[Logic.Not (mem x a), mem (Def.ofRat r) a] }) \by { Logic.And[
            Logic.Not (mem x q), mem (Def.ofRat r) q]::# nxq (ofRatMem r q qr) },
        \Cast[Rat] ({ a : Rat \where Logic.And[Logic.Not (mem x a), mem (Def.ofRat r) a] })) \then
    \let right: Lt (Def.ofRat r) y :=
      \exact(
        \into[Rat](r, { a : Rat \where Logic.And[Logic.Not (mem (Def.ofRat r) a), mem y a] }) \by { Logic.And[
            Logic.Not (mem (Def.ofRat r) r), mem y r]::# (\fun (rr: mem (Def.ofRat r) r) =>
              RationalOrder.ltIrrefl r (ofRatMemLt r r rr)) yr },
        \Cast[Rat] ({ a : Rat \where Logic.And[Logic.Not (mem (Def.ofRat r) a), mem y a] })) \then
    \return \exact(
      \into[Rat](r, { r : Rat \where Logic.And[Lt x (Def.ofRat r), Lt (Def.ofRat r) y] }) \by { Logic.And[Lt x (Def.ofRat r), Lt (Def.ofRat r) y]::# left right },
      \Cast[Rat] ({ r : Rat \where Logic.And[Lt x (Def.ofRat r), Lt (Def.ofRat r) y] }))
  };

\definition RationallyBounded (x: Real): \Prop :=
  \exists { a : Rat \where \exists { b : Rat \where Logic.And[Lt (Def.ofRat a) x, Lt x (Def.ofRat b)] } };

\definition rationalBounds (x: Real): RationallyBounded x :=
  \block {
    \takefrom a: \Cast[Rat] ({ a : Rat \where mem x a }) \by #inhabited{x} \then
    \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.Not (mem x r) }) \by #proper{x} \then
    \let b: Rat := RationalOperations.above r \then
    \let lower: Lt (Def.ofRat a) x :=
      \exact(
        \into[Rat](a, { q : Rat \where Logic.And[Logic.Not (mem (Def.ofRat a) q), mem x q] }) \by { Logic.And[
            Logic.Not (mem (Def.ofRat a) a), mem x a]::# (\fun (aa: mem (Def.ofRat a) a) =>
              RationalOrder.ltIrrefl a (ofRatMemLt a a aa)) (\bysub(Rat, { a : Rat \where mem x a }, a)) },
        \Cast[Rat] ({ q : Rat \where Logic.And[Logic.Not (mem (Def.ofRat a) q), mem x q] })) \then
    \let upper: Lt x (Def.ofRat b) :=
      \exact(
        \into[Rat](r, { q : Rat \where Logic.And[Logic.Not (mem x q), mem (Def.ofRat b) q] }) \by { Logic.And[
            Logic.Not (mem x r), mem (Def.ofRat b) r]::# (\bysub(Rat,
              { r : Rat \where Logic.Not (mem x r) }, r)) (ofRatMem b r (RationalOperationsProp.ltAbove r)) },
        \Cast[Rat] ({ q : Rat \where Logic.And[Logic.Not (mem x q), mem (Def.ofRat b) q] })) \then
    \return \exact(
      \into[Rat](a, { a : Rat \where \exists { b : Rat \where Logic.And[Lt (Def.ofRat a) x, Lt x (Def.ofRat b)] } }) \by { \exact(
          \into[Rat](b, { b : Rat \where Logic.And[Lt (Def.ofRat a) x, Lt x (Def.ofRat b)] }) \by { Logic.And[Lt (Def.ofRat a) x, Lt x (Def.ofRat b)]::# lower upper },
          \Cast[Rat] ({ b : Rat \where Logic.And[Lt (Def.ofRat a) x, Lt x (Def.ofRat b)] })) },
      \Cast[Rat] ({ a : Rat \where \exists { b : Rat \where Logic.And[Lt (Def.ofRat a) x, Lt x (Def.ofRat b)] } }))
  };

\definition zeroNotOne: Logic.Not (Def.zero = Def.one) :=
  \fun (same: Def.zero = Def.one) =>
    RationalOrder.ltIrrefl zeroRat
      (ofRatMemLt zeroRat zeroRat
        (\idelim Def.one = Def.zero
          \with z: Real => mem z zeroRat
          \by { base: ofRatMem oneRat zeroRat RationalOrder.zeroLtOne, equality:
            sym!{Real} Def.zero Def.one same }));

\definition addZeroLeftLe (x: Real): Le (Def.add Def.zero x) x :=
  \fun (q: Rat) => \fun (member: mem (Def.add Def.zero x) q) =>
    CutLaws.sumElim Def.zero x q (addMemLower Def.zero x q member) (mem x q)
      (\fun (a, b: Rat) =>
        \fun (za: mem Def.zero a) => \fun (xb: mem x b) =>
          \fun (qab: lt q (addRat a b)) =>
            #lower{x} q b
              (RationalOrder.ltTrans q (addRat a b) b qab
                (RationalOrder.ltReplaceRight
                  (addRat a b) (addRat zeroRat b) b
                  (RationalOperationsProp.fractionAddZeroLeft b)
                  (RationalOperationsProp.ltAddRight a zeroRat b
                    (ofRatMemLt zeroRat a za)))) xb);

\definition leAddZeroLeft (x: Real): Le x (Def.add Def.zero x) :=
  \fun (q: Rat) => \fun (xq: mem x q) =>
    \block {
      \takefrom a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a, lt q a] }) \by #rounded{x} q xq \then
      \let xa: mem x a :=
        #left{(\bysub(Rat,
            { a : Rat \where Logic.And[mem x a, lt q a] }, a))} \then
      \let qa: lt q a :=
        #right{(\bysub(Rat,
            { a : Rat \where Logic.And[mem x a, lt q a] }, a))} \then
      \let b: Rat := RationalOperations.adjustment q a \then
      \return addMem Def.zero x q
        (CutLaws.sumIntro Def.zero x q b a
          (ofRatMem zeroRat b
            (RationalOperationsProp.adjustmentLtZero q a qa)) xa
          (RationalOrder.ltReplaceRight
            q (addRat a b) (addRat b a)
            (RationalOperationsProp.fractionAddComm a b)
            (RationalOperationsProp.ltAddAdjustment q a qa)))
    };

\definition addZeroLeft (x: Real): Def.add Def.zero x = x :=
  eqByExt (Def.add Def.zero x) x (addZeroLeftLe x) (leAddZeroLeft x);

\definition addCommLe (x, y: Real): Le (Def.add x y) (Def.add y x) :=
  \fun (q: Rat) => \fun (member: mem (Def.add x y) q) =>
    CutLaws.sumElim x y q (addMemLower x y q member) (mem (Def.add y x) q)
      (\fun (a, b: Rat) =>
        \fun (xa: mem x a) => \fun (yb: mem y b) =>
          \fun (qab: lt q (addRat a b)) =>
            addMem y x q
              (CutLaws.sumIntro y x q b a yb xa
                (RationalOrder.ltReplaceRight
                  q (addRat a b) (addRat b a)
                  (RationalOperationsProp.fractionAddComm a b) qab)));

\definition addComm (x, y: Real): Def.add x y = Def.add y x :=
  eqByExt (Def.add x y) (Def.add y x)
    (addCommLe x y) (addCommLe y x);

\definition addZeroRight (x: Real): Def.add x Def.zero = x :=
  trans!{Real} (Def.add x Def.zero) (Def.add Def.zero x) x
    (addComm x Def.zero) (addZeroLeft x);

\definition addMonotoneLeft (x, y, z: Real) (xy: Le x y):
  Le (Def.add z x) (Def.add z y) :=
  \fun (q: Rat) => \fun (member: mem (Def.add z x) q) =>
    CutLaws.sumElim z x q (addMemLower z x q member) (mem (Def.add z y) q)
      (\fun (a, b: Rat) =>
        \fun (za: mem z a) => \fun (xb: mem x b) =>
          \fun (qab: lt q (addRat a b)) =>
            addMem z y q
              (CutLaws.sumIntro z y q a b za (xy b xb) qab));

\definition addMonotoneRight (x, y, z: Real) (xy: Le x y):
  Le (Def.add x z) (Def.add y z) :=
  \fun (q: Rat) => \fun (member: mem (Def.add x z) q) =>
    CutLaws.sumElim x z q (addMemLower x z q member) (mem (Def.add y z) q)
      (\fun (a, b: Rat) =>
        \fun (xa: mem x a) => \fun (zb: mem z b) =>
          \fun (qab: lt q (addRat a b)) =>
            addMem y z q
              (CutLaws.sumIntro y z q a b (xy a xa) zb qab));

\definition negAntitone (x, y: Real) (xy: Le x y): Le (Def.neg y) (Def.neg x) :=
  \fun (q: Rat) => \fun (member: mem (Def.neg y) q) =>
    CutLaws.negElim y q (negMemLower y q member) (mem (Def.neg x) q)
      (\fun (r: Rat) =>
        \fun (yr: Logic.Not (mem y r)) =>
          \fun (qr: lt q (negRat r)) =>
            negMem x q
              (CutLaws.negIntro x q r
                (\fun (xr: mem x r) => yr (xy r xr)) qr));

\definition addAssocForward (x, y, z: Real):
  Le (Def.add (Def.add x y) z) (Def.add x (Def.add y z)) :=
  \fun (q: Rat) => \fun (member: mem (Def.add (Def.add x y) z) q) =>
    CutLaws.sumElim (Def.add x y) z q
      (addMemLower (Def.add x y) z q member) (mem (Def.add x (Def.add y z)) q)
      (\fun (s, c: Rat) =>
        \fun (xys: mem (Def.add x y) s) => \fun (zc: mem z c) =>
          \fun (qsc: lt q (addRat s c)) =>
            CutLaws.sumElim x y s (addMemLower x y s xys)
              (mem (Def.add x (Def.add y z)) q)
              (\fun (a, b: Rat) =>
                \fun (xa: mem x a) => \fun (yb: mem y b) =>
                  \fun (sab: lt s (addRat a b)) =>
                    addMem x (Def.add y z) q
                      (CutLaws.sumIntro x (Def.add y z) q a (addRat b c) xa
                      (addMem y z (addRat b c)
                        (CutLaws.sumContainsAdd y z b c yb zc))
                      (RationalOrder.ltReplaceRight
                        q (addRat (addRat a b) c)
                        (addRat a (addRat b c))
                        (RationalOperationsProp.fractionAddAssoc a b c)
                        (RationalOrder.ltTrans
                          q (addRat s c) (addRat (addRat a b) c) qsc
                          (RationalOperationsProp.ltAddRight
                            s (addRat a b) c sab))))));

\definition addAssocBackward (x, y, z: Real):
  Le (Def.add x (Def.add y z)) (Def.add (Def.add x y) z) :=
  \fun (q: Rat) => \fun (member: mem (Def.add x (Def.add y z)) q) =>
    CutLaws.sumElim x (Def.add y z) q
      (addMemLower x (Def.add y z) q member) (mem (Def.add (Def.add x y) z) q)
      (\fun (a, s: Rat) =>
        \fun (xa: mem x a) => \fun (yzs: mem (Def.add y z) s) =>
          \fun (qas: lt q (addRat a s)) =>
            CutLaws.sumElim y z s (addMemLower y z s yzs)
              (mem (Def.add (Def.add x y) z) q)
              (\fun (b, c: Rat) =>
                \fun (yb: mem y b) => \fun (zc: mem z c) =>
                  \fun (sbc: lt s (addRat b c)) =>
                    addMem (Def.add x y) z q
                      (CutLaws.sumIntro (Def.add x y) z q (addRat a b) c
                      (addMem x y (addRat a b)
                        (CutLaws.sumContainsAdd x y a b xa yb)) zc
                      (RationalOrder.ltReplaceRight
                        q (addRat a (addRat b c))
                        (addRat (addRat a b) c)
                        (RationalFractions.fractionEqSym _ _
                          (RationalOperationsProp.fractionAddAssoc a b c))
                        (RationalOrder.ltTrans
                          q (addRat a s) (addRat a (addRat b c)) qas
                          (RationalOperationsProp.ltAddLeft a
                            s (addRat b c) sbc))))));

\definition addAssoc (x, y, z: Real):
  Def.add (Def.add x y) z = Def.add x (Def.add y z) :=
  eqByExt (Def.add (Def.add x y) z) (Def.add x (Def.add y z))
    (addAssocForward x y z) (addAssocBackward x y z);

\definition negNegLe (x: Real): Le (Def.neg (Def.neg x)) x :=
  \fun (q: Rat) => \fun (member: mem (Def.neg (Def.neg x)) q) =>
    CutLaws.negElim (Def.neg x) q (negMemLower (Def.neg x) q member) (mem x q)
      (\fun (r: Rat) =>
        \fun (nr: Logic.Not (mem (Def.neg x) r)) =>
          \fun (qr: lt q (negRat r)) =>
            Logic.orElim (mem x q) (Logic.Not (mem x q)) (mem x q)
              (\fun (xq: mem x q) => xq)
              (\fun (nq: Logic.Not (mem x q)) =>
                Logic.falseElim (mem x q)
                  (nr (negMem x r
                    (CutLaws.negIntro x r q nq
                      (RationalOrder.ltReplaceLeft
                        (negRat (negRat r)) r (negRat q)
                        (RationalOperationsProp.fractionNegInvolutive r)
                        (RationalOperationsProp.ltNegReverse
                          q (negRat r) qr))))))
              (Classical.excludedMiddle (mem x q)));

\definition leNegNeg (x: Real): Le x (Def.neg (Def.neg x)) :=
  \fun (q: Rat) => \fun (xq: mem x q) =>
    \block {
      \takefrom a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a, lt q a] }) \by #rounded{x} q xq \then
      \let xa: mem x a :=
        #left{(\bysub(Rat,
            { a : Rat \where Logic.And[mem x a, lt q a] }, a))} \then
      \let qa: lt q a :=
        #right{(\bysub(Rat,
            { a : Rat \where Logic.And[mem x a, lt q a] }, a))} \then
      \let r: Rat := negRat a \then
      \let outside: Logic.Not (mem (Def.neg x) r) :=
        \fun (member: mem (Def.neg x) r) =>
          CutLaws.negElim x r (negMemLower x r member) Logic.False
            (\fun (s: Rat) =>
              \fun (ns: Logic.Not (mem x s)) =>
                \fun (rs: lt r (negRat s)) =>
                  ns (#lower{x} s a
                    (RationalOperationsProp.ltOfNegLtNeg a s rs) xa)) \then
      \return negMem (Def.neg x) q
        (CutLaws.negIntro (Def.neg x) q r outside
          (RationalOrder.ltReplaceRight q a (negRat r)
            (RationalFractions.fractionEqSym _ _
              (RationalOperationsProp.fractionNegInvolutive a)) qa))
    };

\definition negInvolutive (x: Real): Def.neg (Def.neg x) = x :=
  eqByExt (Def.neg (Def.neg x)) x (negNegLe x) (leNegNeg x);

\definition addNegLeftLe (x: Real): Le (Def.add (Def.neg x) x) Def.zero :=
  \fun (q: Rat) => \fun (member: mem (Def.add (Def.neg x) x) q) =>
    CutLaws.sumElim (Def.neg x) x q
      (addMemLower (Def.neg x) x q member) (mem Def.zero q)
      (\fun (a, b: Rat) =>
        \fun (na: mem (Def.neg x) a) => \fun (xb: mem x b) =>
          \fun (qab: lt q (addRat a b)) =>
            CutLaws.negElim x a (negMemLower x a na) (mem Def.zero q)
              (\fun (r: Rat) =>
                \fun (xr: Logic.Not (mem x r)) =>
                  \fun (arn: lt a (negRat r)) =>
                    ofRatMem zeroRat q
                      (RationalOrder.ltTrans q (addRat a b) zeroRat qab
                        (RationalOrder.ltReplaceRight
                          (addRat a b) (addRat (negRat r) r) zeroRat
                          (RationalOperationsProp.fractionAddNegLeft r)
                          (RationalOperationsProp.ltAdd a (negRat r) b r arn
                            (CutLaws.memberLtOutside x b r xb xr))))));

\definition leAddNegLeft (x: Real): Le Def.zero (Def.add (Def.neg x) x) :=
  \fun (q: Rat) => \fun (zq: mem Def.zero q) =>
    \block {
      \let qz: lt q zeroRat := ofRatMemLt zeroRat q zq \then
      \let m: Rat := RationalOperations.midpoint q zeroRat \then
      \let e: Rat := negRat m \then
      \let positive: lt zeroRat e :=
        RationalOperationsProp.ltNegReverse m zeroRat
          (RationalOperationsProp.midpointLt q zeroRat qz) \then
      \return
        \block {
          \takefrom l: \Cast[Rat] ({ l : Rat \where Logic.And[mem x l, Logic.Not (mem x (addRat l e))] }) \by CutLaws.bracket x e positive \then
          \let r: Rat := addRat l e \then
          \let xl: mem x l :=
            #left{(\bysub(Rat, { l : Rat \where Logic.And[mem x l, Logic.Not (mem x (addRat l e))] }, l))} \then
          \let xr: Logic.Not (mem x r) :=
            #right{(\bysub(Rat, { l : Rat \where Logic.And[mem x l, Logic.Not (mem x (addRat l e))] }, l))} \then
          \let targetEq: RationalFractions.FractionEq
              (addRat (negRat r) l) m :=
            RationalFractions.fractionEqTrans _ _ _
              (RationalOperationsProp.fractionNegAddLeft l e)
              (RationalOperationsProp.fractionNegInvolutive m) \then
          \let qtarget: lt q (addRat (negRat r) l) :=
            RationalOrder.ltReplaceRight q m
              (addRat (negRat r) l)
              (RationalFractions.fractionEqSym _ _ targetEq)
              (RationalOperationsProp.ltMidpoint q zeroRat qz) \then
          \let n: Rat := RationalOperations.perturbLeft q (negRat r) l \then
          \let nnr: lt n (negRat r) :=
            RationalOperationsProp.perturbLeftLt q (negRat r) l qtarget \then
          \let qnl: lt q (addRat n l) :=
            RationalOperationsProp.ltPerturbedSum q (negRat r) l qtarget \then
          \return addMem (Def.neg x) x q
            (CutLaws.sumIntro (Def.neg x) x q n l
              (negMem x n (CutLaws.negIntro x n r xr nnr)) xl qnl)
        }};

\definition addNegLeft (x: Real): Def.add (Def.neg x) x = Def.zero :=
  eqByExt (Def.add (Def.neg x) x) Def.zero (addNegLeftLe x) (leAddNegLeft x);

\definition addNegRight (x: Real): Def.add x (Def.neg x) = Def.zero :=
  trans!{Real} (Def.add x (Def.neg x)) (Def.add (Def.neg x) x) Def.zero
    (addComm x (Def.neg x)) (addNegLeft x);

\definition addNegCancelLeft (x, y: Real):
  Def.add (Def.neg x) (Def.add x y) = y :=
  trans!{Real}
    (Def.add (Def.neg x) (Def.add x y)) (Def.add (Def.add (Def.neg x) x) y) y
    (sym!{Real} (Def.add (Def.add (Def.neg x) x) y)
      (Def.add (Def.neg x) (Def.add x y)) (addAssoc (Def.neg x) x y))
    (trans!{Real} (Def.add (Def.add (Def.neg x) x) y) (Def.add Def.zero y) y
      (congr!{Real Real} (\fun (z: Real) => Def.add z y)
        (Def.add (Def.neg x) x) Def.zero (addNegLeft x))
      (addZeroLeft y));

\definition addNegCancelRight (x, y: Real):
  Def.add (Def.add y x) (Def.neg x) = y :=
  trans!{Real} (Def.add (Def.add y x) (Def.neg x))
    (Def.add y (Def.add x (Def.neg x))) y
    (addAssoc y x (Def.neg x))
    (trans!{Real} (Def.add y (Def.add x (Def.neg x))) (Def.add y Def.zero) y
      (congr!{Real Real} (Def.add y) (Def.add x (Def.neg x)) Def.zero (addNegRight x))
      (addZeroRight y));

\definition addCancelLeft (z, x, y: Real)
  (same: Def.add z x = Def.add z y): x = y :=
  trans!{Real} x (Def.add (Def.neg z) (Def.add z x)) y
    (sym!{Real} (Def.add (Def.neg z) (Def.add z x)) x (addNegCancelLeft z x))
    (trans!{Real} (Def.add (Def.neg z) (Def.add z x))
      (Def.add (Def.neg z) (Def.add z y)) y
      (congr!{Real Real} (Def.add (Def.neg z)) (Def.add z x) (Def.add z y) same)
      (addNegCancelLeft z y));

\definition addCancelRight (x, y, z: Real)
  (same: Def.add x z = Def.add y z): x = y :=
  addCancelLeft z x y
    (trans!{Real} (Def.add z x) (Def.add x z) (Def.add z y)
      (addComm z x)
      (trans!{Real} (Def.add x z) (Def.add y z) (Def.add z y)
        same (addComm y z)));

\definition negZero: Def.neg Def.zero = Def.zero :=
  trans!{Real} (Def.neg Def.zero) (Def.add (Def.neg Def.zero) Def.zero) Def.zero
    (sym!{Real} (Def.add (Def.neg Def.zero) Def.zero) (Def.neg Def.zero) (addZeroRight (Def.neg Def.zero)))
    (addNegLeft Def.zero);

\definition negInjective (x, y: Real) (same: Def.neg x = Def.neg y): x = y :=
  trans!{Real} x (Def.neg (Def.neg x)) y
    (sym!{Real} (Def.neg (Def.neg x)) x (negInvolutive x))
    (trans!{Real} (Def.neg (Def.neg x)) (Def.neg (Def.neg y)) y
      (congr!{Real Real} Def.neg (Def.neg x) (Def.neg y) same)
      (negInvolutive y));

\definition subSelf (x: Real): Def.sub x x = Def.zero := addNegRight x;

\definition subZeroRight (x: Real): Def.sub x Def.zero = x :=
  trans!{Real} (Def.add x (Def.neg Def.zero)) (Def.add x Def.zero) x
    (congr!{Real Real} (Def.add x) (Def.neg Def.zero) Def.zero negZero)
    (addZeroRight x);

\definition leAddCancelLeft (z, x, y: Real)
  (same: Le (Def.add z x) (Def.add z y)): Le x y :=
  leReplace (Def.add (Def.neg z) (Def.add z x)) x
    (Def.add (Def.neg z) (Def.add z y)) y
    (addNegCancelLeft z x) (addNegCancelLeft z y)
    (addMonotoneLeft (Def.add z x) (Def.add z y) (Def.neg z) same);

\definition leAddCancelRight (x, y, z: Real)
  (same: Le (Def.add x z) (Def.add y z)): Le x y :=
  leAddCancelLeft z x y
    (leReplace (Def.add x z) (Def.add z x) (Def.add y z) (Def.add z y)
      (addComm x z) (addComm y z) same);

\definition ltAddLeft (z, x, y: Real) (xy: Lt x y):
  Lt (Def.add z x) (Def.add z y) :=
  CutOrder.ltOfLeNotEq (Def.add z x) (Def.add z y)
    (addMonotoneLeft x y z (CutOrder.leOfLt x y xy))
    (\fun (same: Def.add z x = Def.add z y) =>
      CutOrder.ltNotEq x y xy (addCancelLeft z x y same));

\definition ltAddRight (x, y, z: Real) (xy: Lt x y):
  Lt (Def.add x z) (Def.add y z) :=
  ltReplaceRight (Def.add x z) (Def.add z y) (Def.add y z) (addComm z y)
    (ltReplaceLeft (Def.add z x) (Def.add x z) (Def.add z y)
      (addComm z x) (ltAddLeft z x y xy));

\definition ltAddCancelLeft (z, x, y: Real)
  (same: Lt (Def.add z x) (Def.add z y)): Lt x y :=
  CutOrder.ltOfLeNotEq x y
    (leAddCancelLeft z x y
      (CutOrder.leOfLt (Def.add z x) (Def.add z y) same))
    (\fun (xy: x = y) =>
      CutOrder.ltNotEq (Def.add z x) (Def.add z y) same
        (congr!{Real Real} (Def.add z) x y xy));

\definition ltAddCancelRight (x, y, z: Real)
  (same: Lt (Def.add x z) (Def.add y z)): Lt x y :=
  ltAddCancelLeft z x y
    (ltReplaceRight (Def.add z x) (Def.add y z) (Def.add z y) (addComm y z)
      (ltReplaceLeft (Def.add x z) (Def.add z x) (Def.add y z)
        (addComm x z) same));

\definition negStrictAntitone (x, y: Real) (xy: Lt x y): Lt (Def.neg y) (Def.neg x) :=
  CutOrder.ltOfLeNotEq (Def.neg y) (Def.neg x)
    (negAntitone x y (CutOrder.leOfLt x y xy))
    (\fun (same: Def.neg y = Def.neg x) =>
      CutOrder.ltNotEq x y xy
        (sym!{Real} y x (negInjective y x same)));

\definition mulCommLe (x, y: Real): Le (Def.mul x y) (Def.mul y x) :=
  \fun (q: Rat) => \fun (member: mem (Def.mul x y) q) =>
    CutLaws.productBelowElim x y q (mulMemLower x y q member)
      (mem (Def.mul y x) q)
      (\fun (a, b, c, d: Rat) =>
        \fun (xa: mem x a) => \fun (xb: Logic.Not (mem x b)) =>
        \fun (yc: mem y c) => \fun (yd: Logic.Not (mem y d)) =>
        \fun (ac: lt q (mulRat a c)) =>
        \fun (ad: lt q (mulRat a d)) =>
        \fun (bc: lt q (mulRat b c)) =>
        \fun (bd: lt q (mulRat b d)) =>
          mulMem y x q
            (Cuts.productBelowIntro y x q c d a b yc yd xa xb
              (RationalOrder.ltReplaceRight q (mulRat a c) (mulRat c a)
                (RationalOperationsProp.fractionMulComm a c) ac)
              (RationalOrder.ltReplaceRight q (mulRat b c) (mulRat c b)
                (RationalOperationsProp.fractionMulComm b c) bc)
              (RationalOrder.ltReplaceRight q (mulRat a d) (mulRat d a)
                (RationalOperationsProp.fractionMulComm a d) ad)
              (RationalOrder.ltReplaceRight q (mulRat b d) (mulRat d b)
                (RationalOperationsProp.fractionMulComm b d) bd)));

\definition mulComm (x, y: Real): Def.mul x y = Def.mul y x :=
  eqByExt (Def.mul x y) (Def.mul y x) (mulCommLe x y) (mulCommLe y x);

\definition mulOfRatLe (x, y: Rat):
  Le (Def.mul (Def.ofRat x) (Def.ofRat y)) (Def.ofRat (mulRat x y)) :=
  \fun (q: Rat) => \fun (member: mem (Def.mul (Def.ofRat x) (Def.ofRat y)) q) =>
    CutLaws.productBelowElim (Def.ofRat x) (Def.ofRat y) q
      (mulMemLower (Def.ofRat x) (Def.ofRat y) q member)
      (mem (Def.ofRat (mulRat x y)) q)
      (\fun (a, b, c, d: Rat) =>
        \fun (ax: mem (Def.ofRat x) a) =>
        \fun (bx: Logic.Not (mem (Def.ofRat x) b)) =>
        \fun (cy: mem (Def.ofRat y) c) =>
        \fun (dy: Logic.Not (mem (Def.ofRat y) d)) =>
        \fun (ac: lt q (mulRat a c)) =>
        \fun (ad: lt q (mulRat a d)) =>
        \fun (bc: lt q (mulRat b c)) =>
        \fun (bd: lt q (mulRat b d)) =>
          ofRatMem (mulRat x y) q
            (RationalOperationsProp.productInteriorAbove q a b c d x y
              (RationalOperationsProp.leOfLt a x (ofRatMemLt x a ax))
              (RationalOperationsProp.leOfNotLtReverse x b
                (\fun (reverse: lt b x) => bx (ofRatMem x b reverse)))
              (RationalOperationsProp.leOfLt c y (ofRatMemLt y c cy))
              (RationalOperationsProp.leOfNotLtReverse y d
                (\fun (reverse: lt d y) => dy (ofRatMem y d reverse)))
              ac ad bc bd));

\definition mulOneLeftLe (x: Real): Le (Def.mul Def.one x) x :=
  \fun (q: Rat) => \fun (member: mem (Def.mul Def.one x) q) =>
    CutLaws.productBelowElim Def.one x q (mulMemLower Def.one x q member)
      (mem x q)
      (\fun (a, b, c, d: Rat) =>
        \fun (aOne: mem Def.one a) =>
        \fun (bOne: Logic.Not (mem Def.one b)) =>
        \fun (xc: mem x c) => \fun (xd: Logic.Not (mem x d)) =>
        \fun (ac: lt q (mulRat a c)) =>
        \fun (ad: lt q (mulRat a d)) =>
        \fun (bc: lt q (mulRat b c)) =>
        \fun (bd: lt q (mulRat b d)) =>
          #lower{x} q c
            (RationalOrder.ltReplaceRight q (mulRat oneRat c) c
              (RationalOperationsProp.fractionMulOneLeft c)
              (RationalOperationsProp.productInteriorAbove
                q a b c d oneRat c
                (RationalOperationsProp.leOfLt a oneRat
                  (ofRatMemLt oneRat a aOne))
                (RationalOperationsProp.leOfNotLtReverse oneRat b
                  (\fun (reverse: lt b oneRat) =>
                    bOne (ofRatMem oneRat b reverse)))
                (RationalOperationsProp.leRefl c)
                (RationalOperationsProp.leOfLt c d
                  (CutLaws.memberLtOutside x c d xc xd))
                ac ad bc bd)) xc);

\definition leMulOneLeft (x: Real): Le x (Def.mul Def.one x) :=
  \fun (q: Rat) => \fun (xq: mem x q) =>
    \block {
      \takefrom c: \Cast[Rat] ({ c : Rat \where Logic.And[mem x c, lt q c] }) \by #rounded{x} q xq \then
      \takefrom d: \Cast[Rat] ({ d : Rat \where Logic.Not (mem x d) }) \by #proper{x} \then
      \takefrom a: \Cast[Rat] ({ a : Rat \where RationalOperations.ContractingFactorLaw[q, c, a] }) \by RationalOperationsProp.contractingFactor q c
        (#right{(\bysub(Rat, { c : Rat \where Logic.And[mem x c, lt q c] }, c))}) \then
      \let rounded: Logic.And[mem x c, lt q c] :=
        \bysub(Rat, { c : Rat \where Logic.And[mem x c, lt q c] }, c) \then
      \let xc: mem x c :=
        #left{rounded} \then
      \let qc: lt q c :=
        #right{rounded} \then
      \let xd: Logic.Not (mem x d) :=
        \bysub(Rat, { d : Rat \where Logic.Not (mem x d) }, d) \then
      \let cd: lt c d := CutLaws.memberLtOutside x c d xc xd \then
      \let factor: RationalOperations.ContractingFactorLaw[q, c, a] :=
        \bysub(Rat, { a : Rat \where RationalOperations.ContractingFactorLaw[q, c, a] }, a) \then
      \let aPositive: lt zeroRat a :=
        #positive{factor} \then
      \let aOne: lt a oneRat :=
        #belowOne{factor} \then
      \let qac: lt q (mulRat a c) :=
        #productAbove{factor} \then
      \let qad: lt q (mulRat a d) :=
        RationalOrder.ltTrans q (mulRat a c) (mulRat a d) qac
          (RationalOperationsProp.ltMulPositiveLeft a c d aPositive cd) \then
      \let qOneC: lt q (mulRat oneRat c) :=
        RationalOrder.ltReplaceRight q c (mulRat oneRat c)
          (RationalFractions.fractionEqSym _ _
            (RationalOperationsProp.fractionMulOneLeft c)) qc \then
      \let qOneD: lt q (mulRat oneRat d) :=
        RationalOrder.ltReplaceRight q d (mulRat oneRat d)
          (RationalFractions.fractionEqSym _ _
            (RationalOperationsProp.fractionMulOneLeft d))
          (RationalOrder.ltTrans q c d qc cd) \then
      \return mulMem Def.one x q
        (Cuts.productBelowIntro Def.one x q a oneRat c d
          (ofRatMem oneRat a aOne)
          (\fun (atOne: mem Def.one oneRat) =>
            RationalOrder.ltIrrefl oneRat
              (ofRatMemLt oneRat oneRat atOne))
          xc xd qac qad qOneC qOneD)
    };

\definition mulOneLeft (x: Real): Def.mul Def.one x = x :=
  eqByExt (Def.mul Def.one x) x (mulOneLeftLe x) (leMulOneLeft x);

\definition mulOneRight (x: Real): Def.mul x Def.one = x :=
  trans!{Real} (Def.mul x Def.one) (Def.mul Def.one x) x
    (mulComm x Def.one) (mulOneLeft x);

\definition mulZeroLeftLe (x: Real): Le (Def.mul Def.zero x) Def.zero :=
  \fun (q: Rat) => \fun (member: mem (Def.mul Def.zero x) q) =>
    CutLaws.productBelowElim Def.zero x q (mulMemLower Def.zero x q member)
      (mem Def.zero q)
      (\fun (a, b, c, d: Rat) =>
        \fun (aZero: mem Def.zero a) =>
        \fun (bZero: Logic.Not (mem Def.zero b)) =>
        \fun (xc: mem x c) => \fun (xd: Logic.Not (mem x d)) =>
        \fun (ac: lt q (mulRat a c)) =>
        \fun (ad: lt q (mulRat a d)) =>
        \fun (bc: lt q (mulRat b c)) =>
        \fun (bd: lt q (mulRat b d)) =>
          ofRatMem zeroRat q
            (RationalOrder.ltReplaceRight q (mulRat zeroRat c) zeroRat
              (RationalOperationsProp.fractionMulZeroLeft c)
              (RationalOperationsProp.productInteriorAbove
                q a b c d zeroRat c
                (RationalOperationsProp.leOfLt a zeroRat
                  (ofRatMemLt zeroRat a aZero))
                (RationalOperationsProp.leOfNotLtReverse zeroRat b
                  (\fun (reverse: lt b zeroRat) =>
                    bZero (ofRatMem zeroRat b reverse)))
                (RationalOperationsProp.leRefl c)
                (RationalOperationsProp.leOfLt c d
                  (CutLaws.memberLtOutside x c d xc xd))
                ac ad bc bd)));

\definition leMulZeroLeft (x: Real): Le Def.zero (Def.mul Def.zero x) :=
  \fun (q: Rat) => \fun (zeroQ: mem Def.zero q) =>
    \block {
      \takefrom u: \Cast[Rat] ({ u : Rat \where CutLaws.SymmetricBoundLaw[x, u] }) \by CutLaws.symmetricBound x \then
      \takefrom e: \Cast[Rat] ({ e : Rat \where Logic.And[lt zeroRat e,
          lt q (mulRat (negRat e) u)] }) \by RationalOperationsProp.smallNegativeProduct q u
        (ofRatMemLt zeroRat q zeroQ)
        (#positive{(\bysub(Rat, { u : Rat \where CutLaws.SymmetricBoundLaw[x, u] }, u))}) \then
      \let bound: CutLaws.SymmetricBoundLaw[x, u] :=
        \bysub(Rat, { u : Rat \where CutLaws.SymmetricBoundLaw[x, u] }, u) \then
      \let small: Logic.And[lt zeroRat e,
          lt q (mulRat (negRat e) u)] :=
        \bysub(Rat, { e : Rat \where Logic.And[lt zeroRat e,
            lt q (mulRat (negRat e) u)] }, e) \then
      \let qNegative: lt q zeroRat := ofRatMemLt zeroRat q zeroQ \then
      \let ePositive: lt zeroRat e :=
        #left{small} \then
      \let uPositive: lt zeroRat u :=
        #positive{bound} \then
      \let eNegative: lt (negRat e) zeroRat :=
        RationalOperationsProp.ltNegReverse zeroRat e ePositive \then
      \let uNegative: lt (negRat u) zeroRat :=
        RationalOperationsProp.ltNegReverse zeroRat u uPositive \then
      \let qac: lt q (mulRat (negRat e) (negRat u)) :=
        RationalOrder.ltTrans q zeroRat
          (mulRat (negRat e) (negRat u)) qNegative
          (RationalOperationsProp.zeroLtMulNegative
            (negRat e) (negRat u) eNegative uNegative) \then
      \let qad: lt q (mulRat (negRat e) u) :=
        #right{small} \then
      \let qbc: lt q (mulRat zeroRat (negRat u)) :=
        RationalOrder.ltReplaceRight q zeroRat
          (mulRat zeroRat (negRat u))
          (RationalFractions.fractionEqSym _ _
            (RationalOperationsProp.fractionMulZeroLeft (negRat u)))
          qNegative \then
      \let qbd: lt q (mulRat zeroRat u) :=
        RationalOrder.ltReplaceRight q zeroRat (mulRat zeroRat u)
          (RationalFractions.fractionEqSym _ _
            (RationalOperationsProp.fractionMulZeroLeft u)) qNegative \then
      \return mulMem Def.zero x q
        (Cuts.productBelowIntro Def.zero x q
          (negRat e) zeroRat (negRat u) u
          (ofRatMem zeroRat (negRat e) eNegative)
          (\fun (atZero: mem Def.zero zeroRat) =>
            RationalOrder.ltIrrefl zeroRat
              (ofRatMemLt zeroRat zeroRat atZero))
          (#inside{bound})
          (#outside{bound})
          qac qad qbc qbd)
    };

\definition mulZeroLeft (x: Real): Def.mul Def.zero x = Def.zero :=
  eqByExt (Def.mul Def.zero x) Def.zero (mulZeroLeftLe x) (leMulZeroLeft x);

\definition mulZeroRight (x: Real): Def.mul x Def.zero = Def.zero :=
  trans!{Real} (Def.mul x Def.zero) (Def.mul Def.zero x) Def.zero
    (mulComm x Def.zero) (mulZeroLeft x);

\definition zeroNeOne: Logic.Not (Def.zero = Def.one) :=
  CutOrder.ltNotEq Def.zero Def.one
    (ltOfRat zeroRat oneRat RationalOrder.zeroLtOne);

\definition mulOneRightLe (x: Real): Le (Def.mul x Def.one) x :=
  leReplaceLeft (Def.mul Def.one x) (Def.mul x Def.one) x (mulComm Def.one x)
    (mulOneLeftLe x);

\definition mulZeroRightLe (x: Real): Le (Def.mul x Def.zero) Def.zero :=
  leReplaceLeft (Def.mul Def.zero x) (Def.mul x Def.zero) Def.zero (mulComm Def.zero x)
    (mulZeroLeftLe x);

\definition invZero: Def.inv Def.zero = Def.zero :=
  eqByExt (Def.inv Def.zero) Def.zero
    (\fun (q: Rat) => \fun (member: mem (Def.inv Def.zero) q) =>
      Logic.orElim
        (Logic.And[underlying Def.zero = Cuts.RatLower zeroRat, lt q zeroRat])
        (Logic.And[Logic.Not (underlying Def.zero = Cuts.RatLower zeroRat),
          Cuts.ReciprocalBelow Def.zero q])
        (mem Def.zero q)
        (\fun (atZero: Logic.And[
          underlying Def.zero = Cuts.RatLower zeroRat, lt q zeroRat]) =>
          ofRatMem zeroRat q
            #right{atZero})
        (\fun (away: Logic.And[
          Logic.Not (underlying Def.zero = Cuts.RatLower zeroRat),
          Cuts.ReciprocalBelow Def.zero q]) =>
          Logic.falseElim (mem Def.zero q)
            (#left{away}
              (\refl(Cuts.RatLower zeroRat))))
        (invMemLower Def.zero q member))
    (\fun (q: Rat) => \fun (member: mem Def.zero q) =>
      invMem Def.zero q
        (Logic.Or[
          Logic.And[underlying Def.zero = Cuts.RatLower zeroRat, lt q zeroRat],
          Logic.And[Logic.Not (underlying Def.zero = Cuts.RatLower zeroRat),
            Cuts.ReciprocalBelow Def.zero q]]::left
          (Logic.And[
            underlying Def.zero = Cuts.RatLower zeroRat, lt q zeroRat]::# (\refl(Cuts.RatLower zeroRat)) (ofRatMemLt zeroRat q member))));

\definition nonnegativeMul (x, y: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y): Le Def.zero (Def.mul x y) :=
  \fun (q: Rat) => \fun (zeroQ: mem Def.zero q) =>
    \block {
      \takefrom u: \Cast[Rat] ({ u : Rat \where CutLaws.SymmetricBoundLaw[x, u] }) \by CutLaws.symmetricBound x \then
      \takefrom v: \Cast[Rat] ({ v : Rat \where CutLaws.SymmetricBoundLaw[y, v] }) \by CutLaws.symmetricBound y \then
      \takefrom e: \Cast[Rat] ({ e : Rat \where Logic.And[lt zeroRat e,
          lt q (mulRat (negRat e) v)] }) \by RationalOperationsProp.smallNegativeProduct q v
        (ofRatMemLt zeroRat q zeroQ)
        (#positive{(\bysub(Rat, { v : Rat \where CutLaws.SymmetricBoundLaw[y, v] }, v))}) \then
      \takefrom f: \Cast[Rat] ({ f : Rat \where Logic.And[lt zeroRat f,
          lt q (mulRat (negRat f) u)] }) \by RationalOperationsProp.smallNegativeProduct q u
        (ofRatMemLt zeroRat q zeroQ)
        (#positive{(\bysub(Rat, { u : Rat \where CutLaws.SymmetricBoundLaw[x, u] }, u))}) \then
      \let uLaw: CutLaws.SymmetricBoundLaw[x, u] :=
        \bysub(Rat, { u : Rat \where CutLaws.SymmetricBoundLaw[x, u] }, u) \then
      \let vLaw: CutLaws.SymmetricBoundLaw[y, v] :=
        \bysub(Rat, { v : Rat \where CutLaws.SymmetricBoundLaw[y, v] }, v) \then
      \let eLaw: Logic.And[lt zeroRat e,
          lt q (mulRat (negRat e) v)] :=
        \bysub(Rat, { e : Rat \where Logic.And[lt zeroRat e,
            lt q (mulRat (negRat e) v)] }, e) \then
      \let fLaw: Logic.And[lt zeroRat f,
          lt q (mulRat (negRat f) u)] :=
        \bysub(Rat, { f : Rat \where Logic.And[lt zeroRat f,
            lt q (mulRat (negRat f) u)] }, f) \then
      \let neNegative: lt (negRat e) zeroRat :=
        RationalOrder.ltReplaceRight (negRat e) (negRat zeroRat)
          zeroRat (RationalFractions.fractionEqRefl zeroRat)
          (RationalOperationsProp.ltNegReverse zeroRat e #left{eLaw}) \then
      \let nfNegative: lt (negRat f) zeroRat :=
        RationalOrder.ltReplaceRight (negRat f) (negRat zeroRat)
          zeroRat (RationalFractions.fractionEqRefl zeroRat)
          (RationalOperationsProp.ltNegReverse zeroRat f #left{fLaw}) \then
      \let acPositive: lt zeroRat (mulRat (negRat e) (negRat f)) :=
        RationalOperationsProp.zeroLtMulNegative
          (negRat e) (negRat f) neNegative nfNegative \then
      \let qNegative: lt q zeroRat := ofRatMemLt zeroRat q zeroQ \then
      \let ac: lt q (mulRat (negRat e) (negRat f)) :=
        RationalOrder.ltTrans q zeroRat
          (mulRat (negRat e) (negRat f)) qNegative acPositive \then
      \let ad: lt q (mulRat (negRat e) v) := #right{eLaw} \then
      \let bc: lt q (mulRat u (negRat f)) :=
        RationalOrder.ltReplaceRight q (mulRat (negRat f) u)
          (mulRat u (negRat f))
          (RationalOperationsProp.fractionMulComm (negRat f) u)
          #right{fLaw} \then
      \let bd: lt q (mulRat u v) :=
        RationalOrder.ltTrans q zeroRat (mulRat u v) qNegative
          (RationalOperationsProp.zeroLtMulPositive u v
            #positive{uLaw} #positive{vLaw}) \then
      \return mulMem x y q
        (Cuts.productBelowIntro x y q (negRat e) u (negRat f) v
          (zeroX (negRat e) (ofRatMem zeroRat (negRat e) neNegative))
          (#outside{uLaw})
          (zeroY (negRat f) (ofRatMem zeroRat (negRat f) nfNegative))
          (#outside{vLaw}) ac ad bc bd)
    };

\definition outsideNotNegative (x: Real) (zeroX: Le Def.zero x) (b: Rat)
  (outside: Logic.Not (mem x b)): Logic.Not (lt b zeroRat) :=
  \fun (negative: lt b zeroRat) =>
    outside (zeroX b (ofRatMem zeroRat b negative));

\definition positiveLeftFactor (a, b: Rat)
  (notNegative: Logic.Not (lt a zeroRat))
  (productPositive: lt zeroRat (mulRat a b)): lt zeroRat a := Estimates.positiveLeftFactor a b notNegative productPositive;

\definition positiveRightFactor (a, b: Rat)
  (notNegative: Logic.Not (lt b zeroRat))
  (productPositive: lt zeroRat (mulRat a b)): lt zeroRat b := Estimates.positiveRightFactor a b notNegative productPositive;

\definition nonnegativeMulIntro (x, y: Real) (q, a, b: Rat)
  (aPositive: lt zeroRat a) (xa: mem x a)
  (bPositive: lt zeroRat b) (yb: mem y b)
  (qab: lt q (mulRat a b)): mem (Def.mul x y) q :=
  \block {
    \takefrom c: \Cast[Rat] ({ c : Rat \where Logic.Not (mem x c) }) \by #proper{x} \then
    \takefrom d: \Cast[Rat] ({ d : Rat \where Logic.Not (mem y d) }) \by #proper{y} \then
    \let xc: Logic.Not (mem x c) :=
      \bysub(Rat, { c : Rat \where Logic.Not (mem x c) }, c) \then
    \let yd: Logic.Not (mem y d) :=
      \bysub(Rat, { d : Rat \where Logic.Not (mem y d) }, d) \then
    \let ac: lt a c := CutLaws.memberLtOutside x a c xa xc \then
    \let bd: lt b d := CutLaws.memberLtOutside y b d yb yd \then
    \let qad: lt q (mulRat a d) :=
      RationalOrder.ltTrans q (mulRat a b) (mulRat a d) qab
        (RationalOperationsProp.ltMulPositiveLeft a b d aPositive bd) \then
    \let qcb: lt q (mulRat c b) :=
      RationalOrder.ltTrans q (mulRat a b) (mulRat c b) qab
        (RationalOperationsProp.ltMulPositiveRight a c b bPositive ac) \then
    \let cPositive: lt zeroRat c :=
      RationalOrder.ltTrans zeroRat a c aPositive ac \then
    \let qcd: lt q (mulRat c d) :=
      RationalOrder.ltTrans q (mulRat c b) (mulRat c d) qcb
        (RationalOperationsProp.ltMulPositiveLeft c b d cPositive bd) \then
    \return mulMem x y q
      (Cuts.productBelowIntro x y q a c b d xa xc yb yd
        qab qad qcb qcd)
  };

\definition nonnegativeMulElim (x, y: Real) (q: Rat)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y)
  (qNonnegative: RationalOperations.Le zeroRat q)
  (member: mem (Def.mul x y) q) (P: \Prop)
  (use: \forall (a, b: Rat) -> lt zeroRat a -> mem x a ->
    lt zeroRat b -> mem y b -> lt q (mulRat a b) -> P): P :=
  CutLaws.productBelowElim x y q (mulMemLower x y q member) P
    (\fun (a, c, b, d: Rat) =>
      \fun (xa: mem x a) => \fun (xc: Logic.Not (mem x c)) =>
      \fun (yb: mem y b) => \fun (yd: Logic.Not (mem y d)) =>
      \fun (qab: lt q (mulRat a b)) =>
      \fun (qad: lt q (mulRat a d)) =>
      \fun (qcb: lt q (mulRat c b)) =>
      \fun (qcd: lt q (mulRat c d)) =>
        \block {
          \let cdPositive: lt zeroRat (mulRat c d) :=
            RationalOperationsProp.leLtTrans zeroRat q (mulRat c d)
              qNonnegative qcd \then
          \let cPositive: lt zeroRat c :=
            positiveLeftFactor c d (outsideNotNegative x zeroX c xc)
              cdPositive \then
          \let dPositive: lt zeroRat d :=
            positiveRightFactor c d (outsideNotNegative y zeroY d yd)
              cdPositive \then
          \let adPositive: lt zeroRat (mulRat a d) :=
            RationalOperationsProp.leLtTrans zeroRat q (mulRat a d)
              qNonnegative qad \then
          \let aPositive: lt zeroRat a :=
            RationalOperationsProp.positiveRightOfPositiveProduct d a dPositive
              (RationalOrder.ltReplaceRight zeroRat (mulRat a d)
                (mulRat d a) (RationalOperationsProp.fractionMulComm a d)
                adPositive) \then
          \let cbPositive: lt zeroRat (mulRat c b) :=
            RationalOperationsProp.leLtTrans zeroRat q (mulRat c b)
              qNonnegative qcb \then
          \let bPositive: lt zeroRat b :=
            RationalOperationsProp.positiveRightOfPositiveProduct c b cPositive
              cbPositive \then
          \return use a b aPositive xa bPositive yb qab
        });

\definition ContractRight (q, a, c: Rat): \Prop := Estimates.ContractRight q a c;

\definition contractRight (q, a, c: Rat)
  (aPositive: lt zeroRat a) (cPositive: lt zeroRat c)
  (qac: lt q (mulRat a c)): ContractRight q a c := Estimates.contractRight q a c aPositive cPositive qac;

\definition mulAssocNonnegativeForward (x, y, z: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y) (zeroZ: Le Def.zero z):
  Le (Def.mul (Def.mul x y) z) (Def.mul x (Def.mul y z)) :=
  \fun (q: Rat) => \fun (member: mem (Def.mul (Def.mul x y) z) q) =>
    Logic.orElim (RationalOperations.Le zeroRat q) (lt q zeroRat)
      (mem (Def.mul x (Def.mul y z)) q)
      (\fun (qNonnegative: RationalOperations.Le zeroRat q) =>
        nonnegativeMulElim (Def.mul x y) z q
          (nonnegativeMul x y zeroX zeroY) zeroZ qNonnegative member
          (mem (Def.mul x (Def.mul y z)) q)
          (\fun (s, c: Rat) => \fun (sPositive: lt zeroRat s) =>
            \fun (xys: mem (Def.mul x y) s) =>
            \fun (cPositive: lt zeroRat c) => \fun (zc: mem z c) =>
            \fun (qsc: lt q (mulRat s c)) =>
              nonnegativeMulElim x y s zeroX zeroY
                (RationalOperationsProp.leOfLt zeroRat s sPositive) xys
                (mem (Def.mul x (Def.mul y z)) q)
                (\fun (a, b: Rat) => \fun (aPositive: lt zeroRat a) =>
                  \fun (xa: mem x a) =>
                  \fun (bPositive: lt zeroRat b) => \fun (yb: mem y b) =>
                  \fun (sab: lt s (mulRat a b)) =>
                    \block {
                      \let qabcLeft: lt q (mulRat (mulRat a b) c) :=
                        RationalOrder.ltTrans q (mulRat s c)
                          (mulRat (mulRat a b) c) qsc
                          (RationalOperationsProp.ltMulPositiveRight s
                            (mulRat a b) c cPositive sab) \then
                      \let qabc: lt q (mulRat a (mulRat b c)) :=
                        RationalOrder.ltReplaceRight q
                          (mulRat (mulRat a b) c)
                          (mulRat a (mulRat b c))
                          (RationalOperationsProp.fractionMulAssoc a b c)
                          qabcLeft \then
                      \let bcPositive: lt zeroRat (mulRat b c) :=
                        RationalOperationsProp.zeroLtMulPositive b c
                          bPositive cPositive \then
                      \takefrom r: \Cast[Rat] ({ r : Rat \where
                          Estimates.ContractRightLaw[q, a, (mulRat b c), r] }) \by contractRight q a (mulRat b c)
                        aPositive bcPositive qabc \then
                      \let rLaw: Estimates.ContractRightLaw[q, a, (mulRat b c), r] :=
                        \bysub(Rat, { r : Rat \where
                          Estimates.ContractRightLaw[q, a, (mulRat b c), r] }, r) \then
                      \let yzr: mem (Def.mul y z) r :=
                        nonnegativeMulIntro y z r b c bPositive yb
                          cPositive zc (#below{rLaw}) \then
                      \return nonnegativeMulIntro x (Def.mul y z) q a r
                        aPositive xa #positive{rLaw} yzr
                        (#productAbove{rLaw})})))
      (\fun (qNegative: lt q zeroRat) =>
        (nonnegativeMul x (Def.mul y z) zeroX
          (nonnegativeMul y z zeroY zeroZ)) q
          (ofRatMem zeroRat q qNegative))
      (RationalOperationsProp.nonnegativeOrNegative q);

\definition mulAssocNonnegativeBackward (x, y, z: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y) (zeroZ: Le Def.zero z):
  Le (Def.mul x (Def.mul y z)) (Def.mul (Def.mul x y) z) :=
  \fun (q: Rat) => \fun (member: mem (Def.mul x (Def.mul y z)) q) =>
    Logic.orElim (RationalOperations.Le zeroRat q) (lt q zeroRat)
      (mem (Def.mul (Def.mul x y) z) q)
      (\fun (qNonnegative: RationalOperations.Le zeroRat q) =>
        nonnegativeMulElim x (Def.mul y z) q zeroX
          (nonnegativeMul y z zeroY zeroZ) qNonnegative member
          (mem (Def.mul (Def.mul x y) z) q)
          (\fun (a, s: Rat) => \fun (aPositive: lt zeroRat a) =>
            \fun (xa: mem x a) =>
            \fun (sPositive: lt zeroRat s) =>
            \fun (yzs: mem (Def.mul y z) s) =>
            \fun (qas: lt q (mulRat a s)) =>
              nonnegativeMulElim y z s zeroY zeroZ
                (RationalOperationsProp.leOfLt zeroRat s sPositive) yzs
                (mem (Def.mul (Def.mul x y) z) q)
                (\fun (b, c: Rat) => \fun (bPositive: lt zeroRat b) =>
                  \fun (yb: mem y b) =>
                  \fun (cPositive: lt zeroRat c) => \fun (zc: mem z c) =>
                  \fun (sbc: lt s (mulRat b c)) =>
                    \block {
                      \let qabcRight: lt q (mulRat a (mulRat b c)) :=
                        RationalOrder.ltTrans q (mulRat a s)
                          (mulRat a (mulRat b c)) qas
                          (RationalOperationsProp.ltMulPositiveLeft a s
                            (mulRat b c) aPositive sbc) \then
                      \let qabc: lt q (mulRat (mulRat a b) c) :=
                        RationalOrder.ltReplaceRight q
                          (mulRat a (mulRat b c))
                          (mulRat (mulRat a b) c)
                          (RationalFractions.fractionEqSym _ _
                            (RationalOperationsProp.fractionMulAssoc a b c))
                          qabcRight \then
                      \let abPositive: lt zeroRat (mulRat a b) :=
                        RationalOperationsProp.zeroLtMulPositive a b
                          aPositive bPositive \then
                      \let qcab: lt q (mulRat c (mulRat a b)) :=
                        RationalOrder.ltReplaceRight q
                          (mulRat (mulRat a b) c)
                          (mulRat c (mulRat a b))
                          (RationalOperationsProp.fractionMulComm
                            (mulRat a b) c) qabc \then
                      \takefrom r: \Cast[Rat] ({ r : Rat \where
                          Estimates.ContractRightLaw[q, c, (mulRat a b), r] }) \by contractRight q c (mulRat a b)
                        cPositive abPositive qcab \then
                      \let rLaw: Estimates.ContractRightLaw[q, c, (mulRat a b), r] :=
                        \bysub(Rat, { r : Rat \where
                          Estimates.ContractRightLaw[q, c, (mulRat a b), r] }, r) \then
                      \let xyr: mem (Def.mul x y) r :=
                        nonnegativeMulIntro x y r a b aPositive xa
                          bPositive yb (#below{rLaw}) \then
                      \let qrc: lt q (mulRat r c) :=
                        RationalOrder.ltReplaceRight q (mulRat c r)
                          (mulRat r c)
                          (RationalOperationsProp.fractionMulComm c r)
                          (#productAbove{rLaw}) \then
                      \return nonnegativeMulIntro (Def.mul x y) z q r c
                        #positive{rLaw} xyr cPositive zc qrc})))
      (\fun (qNegative: lt q zeroRat) =>
        (nonnegativeMul (Def.mul x y) z
          (nonnegativeMul x y zeroX zeroY) zeroZ) q
          (ofRatMem zeroRat q qNegative))
      (RationalOperationsProp.nonnegativeOrNegative q);

\definition mulAssocNonnegative (x, y, z: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y) (zeroZ: Le Def.zero z):
  Def.mul (Def.mul x y) z = Def.mul x (Def.mul y z) :=
  eqByExt (Def.mul (Def.mul x y) z) (Def.mul x (Def.mul y z))
    (mulAssocNonnegativeForward x y z zeroX zeroY zeroZ)
    (mulAssocNonnegativeBackward x y z zeroX zeroY zeroZ);

\definition nonnegativeOrNegativeReal (x: Real):
  Logic.Or[Le Def.zero x, Lt x Def.zero] :=
  Logic.orElim (Lt Def.zero x) (Logic.Or[Def.zero = x, Lt x Def.zero])
    (Logic.Or[Le Def.zero x, Lt x Def.zero])
    (\fun (positive: Lt Def.zero x) =>
      Logic.Or[Le Def.zero x, Lt x Def.zero]::left
        (CutOrder.leOfLt Def.zero x positive))
    (\fun (rest: Logic.Or[Def.zero = x, Lt x Def.zero]) =>
      Logic.orElim (Def.zero = x) (Lt x Def.zero)
        (Logic.Or[Le Def.zero x, Lt x Def.zero])
        (\fun (same: Def.zero = x) =>
          Logic.Or[Le Def.zero x, Lt x Def.zero]::left
            (leReplaceRight Def.zero Def.zero x same (leRefl Def.zero)))
        (\fun (negative: Lt x Def.zero) =>
          Logic.Or[Le Def.zero x, Lt x Def.zero]::right negative)
        rest)
    (CutOrder.ltTrichotomy Def.zero x);

\definition nonnegativeNegOfNegative (x: Real) (negative: Lt x Def.zero):
  Le Def.zero (Def.neg x) :=
  leReplaceLeft (Def.neg Def.zero) Def.zero (Def.neg x) negZero
    (negAntitone x Def.zero (CutOrder.leOfLt x Def.zero negative));

\record SignedMulSpec[x, y, value: Real]: \Prop := {
  nn: Le Def.zero x -> Le Def.zero y -> value = Def.mul x y,
  np: Le Def.zero x -> Lt y Def.zero -> value = Def.neg (Def.mul x (Def.neg y)),
  pn: Lt x Def.zero -> Le Def.zero y -> value = Def.neg (Def.mul (Def.neg x) y),
  pp: Lt x Def.zero -> Lt y Def.zero -> value = Def.mul (Def.neg x) (Def.neg y),
};

\definition signedMulSpecNN (x, y: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y): SignedMulSpec[x, y, Def.mul x y] :=
  SignedMulSpec[x, y, Def.mul x y]::#
    (\fun (_: Le Def.zero x) => \fun (_: Le Def.zero y) => \refl(Def.mul x y))
    (\fun (_: Le Def.zero x) => \fun (negativeY: Lt y Def.zero) =>
      Logic.falseElim _ ((ltNotLeReverse y Def.zero negativeY) zeroY))
    (\fun (negativeX: Lt x Def.zero) => \fun (_: Le Def.zero y) =>
      Logic.falseElim _ ((ltNotLeReverse x Def.zero negativeX) zeroX))
    (\fun (negativeX: Lt x Def.zero) => \fun (_: Lt y Def.zero) =>
      Logic.falseElim _ ((ltNotLeReverse x Def.zero negativeX) zeroX));

\definition signedMulSpecNP (x, y: Real)
  (zeroX: Le Def.zero x) (negativeY: Lt y Def.zero):
  SignedMulSpec[x, y, Def.neg (Def.mul x (Def.neg y))] :=
  SignedMulSpec[x, y, Def.neg (Def.mul x (Def.neg y))]::#
    (\fun (_: Le Def.zero x) => \fun (zeroY: Le Def.zero y) =>
      Logic.falseElim _ ((ltNotLeReverse y Def.zero negativeY) zeroY))
    (\fun (_: Le Def.zero x) => \fun (_: Lt y Def.zero) => \refl(Def.neg (Def.mul x (Def.neg y))))
    (\fun (negativeX: Lt x Def.zero) => \fun (_: Le Def.zero y) =>
      Logic.falseElim _ ((ltNotLeReverse x Def.zero negativeX) zeroX))
    (\fun (negativeX: Lt x Def.zero) => \fun (_: Lt y Def.zero) =>
      Logic.falseElim _ ((ltNotLeReverse x Def.zero negativeX) zeroX));

\definition signedMulSpecPN (x, y: Real)
  (negativeX: Lt x Def.zero) (zeroY: Le Def.zero y):
  SignedMulSpec[x, y, Def.neg (Def.mul (Def.neg x) y)] :=
  SignedMulSpec[x, y, Def.neg (Def.mul (Def.neg x) y)]::#
    (\fun (zeroX: Le Def.zero x) => \fun (_: Le Def.zero y) =>
      Logic.falseElim _ ((ltNotLeReverse x Def.zero negativeX) zeroX))
    (\fun (zeroX: Le Def.zero x) => \fun (_: Lt y Def.zero) =>
      Logic.falseElim _ ((ltNotLeReverse x Def.zero negativeX) zeroX))
    (\fun (_: Lt x Def.zero) => \fun (_: Le Def.zero y) => \refl(Def.neg (Def.mul (Def.neg x) y)))
    (\fun (_: Lt x Def.zero) => \fun (negativeY: Lt y Def.zero) =>
      Logic.falseElim _ ((ltNotLeReverse y Def.zero negativeY) zeroY));

\definition signedMulSpecPP (x, y: Real)
  (negativeX: Lt x Def.zero) (negativeY: Lt y Def.zero):
  SignedMulSpec[x, y, Def.mul (Def.neg x) (Def.neg y)] :=
  SignedMulSpec[x, y, Def.mul (Def.neg x) (Def.neg y)]::#
    (\fun (zeroX: Le Def.zero x) => \fun (_: Le Def.zero y) =>
      Logic.falseElim _ ((ltNotLeReverse x Def.zero negativeX) zeroX))
    (\fun (zeroX: Le Def.zero x) => \fun (_: Lt y Def.zero) =>
      Logic.falseElim _ ((ltNotLeReverse x Def.zero negativeX) zeroX))
    (\fun (_: Lt x Def.zero) => \fun (zeroY: Le Def.zero y) =>
      Logic.falseElim _ ((ltNotLeReverse y Def.zero negativeY) zeroY))
    (\fun (_: Lt x Def.zero) => \fun (_: Lt y Def.zero) =>
      \refl(Def.mul (Def.neg x) (Def.neg y)));

\definition SignedMulCandidates (x, y: Real): \Pow Real :=
  { value : Real \where SignedMulSpec[x, y, value] };

\definition SignedMulCandidate (x, y: Real): \Set :=
  \Cast[Real] (SignedMulCandidates x y);

\definition signedMulExists (x, y: Real):
  \exists SignedMulCandidate x y :=
  Logic.orElim (Le Def.zero x) (Lt x Def.zero)
    (\exists SignedMulCandidate x y)
    (\fun (zeroX: Le Def.zero x) =>
      Logic.orElim (Le Def.zero y) (Lt y Def.zero)
        (\exists SignedMulCandidate x y)
        (\fun (zeroY: Le Def.zero y) =>
          \exact(\into[Real](Def.mul x y, SignedMulCandidates x y) \by {
            signedMulSpecNN x y zeroX zeroY }, SignedMulCandidate x y))
        (\fun (negativeY: Lt y Def.zero) =>
          \exact(\into[Real](Def.neg (Def.mul x (Def.neg y)), SignedMulCandidates x y)
            \by { signedMulSpecNP x y zeroX negativeY },
            SignedMulCandidate x y))
        (nonnegativeOrNegativeReal y))
    (\fun (negativeX: Lt x Def.zero) =>
      Logic.orElim (Le Def.zero y) (Lt y Def.zero)
        (\exists SignedMulCandidate x y)
        (\fun (zeroY: Le Def.zero y) =>
          \exact(\into[Real](Def.neg (Def.mul (Def.neg x) y), SignedMulCandidates x y)
            \by { signedMulSpecPN x y negativeX zeroY },
            SignedMulCandidate x y))
        (\fun (negativeY: Lt y Def.zero) =>
          \exact(\into[Real](Def.mul (Def.neg x) (Def.neg y), SignedMulCandidates x y)
            \by { signedMulSpecPP x y negativeX negativeY },
            SignedMulCandidate x y))
        (nonnegativeOrNegativeReal y))
    (nonnegativeOrNegativeReal x);

\definition signedMulCandidatesUnique (x, y: Real):
  \forall (u, v: SignedMulCandidate x y) -> u = v :=

  \fun (u, v: SignedMulCandidate x y) =>
    Logic.orElim (Le Def.zero x) (Lt x Def.zero) (u = v)
      (\fun (zeroX: Le Def.zero x) =>
        Logic.orElim (Le Def.zero y) (Lt y Def.zero) (u = v)
          (\fun (zeroY: Le Def.zero y) =>
            trans!{Real} u (Def.mul x y) v
              (#nn{u} zeroX zeroY)
              (sym!{Real} v (Def.mul x y)
                (#nn{v} zeroX zeroY)))
          (\fun (negativeY: Lt y Def.zero) =>
            trans!{Real} u (Def.neg (Def.mul x (Def.neg y))) v
              (#np{u} zeroX negativeY)
              (sym!{Real} v (Def.neg (Def.mul x (Def.neg y)))
                (#np{v} zeroX negativeY)))
          (nonnegativeOrNegativeReal y))
      (\fun (negativeX: Lt x Def.zero) =>
        Logic.orElim (Le Def.zero y) (Lt y Def.zero) (u = v)
          (\fun (zeroY: Le Def.zero y) =>
            trans!{Real} u (Def.neg (Def.mul (Def.neg x) y)) v
              (#pn{u} negativeX zeroY)
              (sym!{Real} v (Def.neg (Def.mul (Def.neg x) y))
                (#pn{v} negativeX zeroY)))
          (\fun (negativeY: Lt y Def.zero) =>
            trans!{Real} u (Def.mul (Def.neg x) (Def.neg y)) v
              (#pp{u} negativeX negativeY)
              (sym!{Real} v (Def.mul (Def.neg x) (Def.neg y))
                (#pp{v} negativeX negativeY)))
          (nonnegativeOrNegativeReal y))
      (nonnegativeOrNegativeReal x);

\definition fieldMul (x, y: Real): Real :=
  \choice SignedMulCandidate x y
  \by { existence: signedMulExists x y, uniqueness: signedMulCandidatesUnique x y };

\definition fieldMulSpec (x, y: Real): SignedMulSpec[x, y, fieldMul x y] :=
  \bysub(Real, SignedMulCandidates x y,
    \choice SignedMulCandidate x y
      \by { existence: signedMulExists x y, uniqueness: signedMulCandidatesUnique x y });

\definition fieldMulNN (x, y: Real) (zeroX: Le Def.zero x) (zeroY: Le Def.zero y):
  fieldMul x y = Def.mul x y :=
  #nn{fieldMulSpec x y}
    zeroX zeroY;

\definition fieldMulNP (x, y: Real) (zeroX: Le Def.zero x) (negativeY: Lt y Def.zero):
  fieldMul x y = Def.neg (Def.mul x (Def.neg y)) :=
  #np{fieldMulSpec x y}
    zeroX negativeY;

\definition fieldMulPN (x, y: Real) (negativeX: Lt x Def.zero) (zeroY: Le Def.zero y):
  fieldMul x y = Def.neg (Def.mul (Def.neg x) y) :=
  #pn{fieldMulSpec x y}
    negativeX zeroY;

\definition fieldMulPP (x, y: Real) (negativeX: Lt x Def.zero) (negativeY: Lt y Def.zero):
  fieldMul x y = Def.mul (Def.neg x) (Def.neg y) :=
  #pp{fieldMulSpec x y}
    negativeX negativeY;

\definition zeroNonnegative: Le Def.zero Def.zero := leRefl Def.zero;
\definition oneNonnegative: Le Def.zero Def.one :=
  CutOrder.leOfLt Def.zero Def.one (ltOfRat zeroRat oneRat RationalOrder.zeroLtOne);

\definition fieldMulComm (x, y: Real): fieldMul x y = fieldMul y x :=

  Logic.orElim (Le Def.zero x) (Lt x Def.zero) (fieldMul x y = fieldMul y x)
    (\fun (zeroX: Le Def.zero x) =>
      Logic.orElim (Le Def.zero y) (Lt y Def.zero) (fieldMul x y = fieldMul y x)
        (\fun (zeroY: Le Def.zero y) =>
          trans!{Real} (fieldMul x y) (Def.mul x y) (fieldMul y x)
            (fieldMulNN x y zeroX zeroY)
            (trans!{Real} (Def.mul x y) (Def.mul y x) (fieldMul y x)
              (mulComm x y) (sym!{Real} _ _ (fieldMulNN y x zeroY zeroX))))
        (\fun (negativeY: Lt y Def.zero) =>
          trans!{Real} (fieldMul x y) (Def.neg (Def.mul x (Def.neg y))) (fieldMul y x)
            (fieldMulNP x y zeroX negativeY)
            (trans!{Real} (Def.neg (Def.mul x (Def.neg y))) (Def.neg (Def.mul (Def.neg y) x))
              (fieldMul y x)
              (congr!{Real Real} Def.neg _ _ (mulComm x (Def.neg y)))
              (sym!{Real} _ _ (fieldMulPN y x negativeY zeroX))))
        (nonnegativeOrNegativeReal y))
    (\fun (negativeX: Lt x Def.zero) =>
      Logic.orElim (Le Def.zero y) (Lt y Def.zero) (fieldMul x y = fieldMul y x)
        (\fun (zeroY: Le Def.zero y) =>
          trans!{Real} (fieldMul x y) (Def.neg (Def.mul (Def.neg x) y)) (fieldMul y x)
            (fieldMulPN x y negativeX zeroY)
            (trans!{Real} (Def.neg (Def.mul (Def.neg x) y)) (Def.neg (Def.mul y (Def.neg x)))
              (fieldMul y x)
              (congr!{Real Real} Def.neg _ _ (mulComm (Def.neg x) y))
              (sym!{Real} _ _ (fieldMulNP y x zeroY negativeX))))
        (\fun (negativeY: Lt y Def.zero) =>
          trans!{Real} (fieldMul x y) (Def.mul (Def.neg x) (Def.neg y)) (fieldMul y x)
            (fieldMulPP x y negativeX negativeY)
            (trans!{Real} (Def.mul (Def.neg x) (Def.neg y)) (Def.mul (Def.neg y) (Def.neg x))
              (fieldMul y x) (mulComm (Def.neg x) (Def.neg y))
              (sym!{Real} _ _ (fieldMulPP y x negativeY negativeX))))
        (nonnegativeOrNegativeReal y))
    (nonnegativeOrNegativeReal x);

\definition fieldMulOneLeft (x: Real): fieldMul Def.one x = x :=
  Logic.orElim (Le Def.zero x) (Lt x Def.zero) (fieldMul Def.one x = x)
    (\fun (zeroX: Le Def.zero x) =>
      trans!{Real} (fieldMul Def.one x) (Def.mul Def.one x) x
        (fieldMulNN Def.one x oneNonnegative zeroX) (mulOneLeft x))
    (\fun (negativeX: Lt x Def.zero) =>
      trans!{Real} (fieldMul Def.one x) (Def.neg (Def.mul Def.one (Def.neg x))) x
        (fieldMulNP Def.one x oneNonnegative negativeX)
        (trans!{Real} (Def.neg (Def.mul Def.one (Def.neg x))) (Def.neg (Def.neg x)) x
          (congr!{Real Real} Def.neg _ _ (mulOneLeft (Def.neg x)))
          (negInvolutive x)))
    (nonnegativeOrNegativeReal x);

\definition fieldMulZeroLeft (x: Real): fieldMul Def.zero x = Def.zero :=
  Logic.orElim (Le Def.zero x) (Lt x Def.zero) (fieldMul Def.zero x = Def.zero)
    (\fun (zeroX: Le Def.zero x) =>
      trans!{Real} (fieldMul Def.zero x) (Def.mul Def.zero x) Def.zero
        (fieldMulNN Def.zero x zeroNonnegative zeroX) (mulZeroLeft x))
    (\fun (negativeX: Lt x Def.zero) =>
      trans!{Real} (fieldMul Def.zero x) (Def.neg (Def.mul Def.zero (Def.neg x))) Def.zero
        (fieldMulNP Def.zero x zeroNonnegative negativeX)
        (trans!{Real} (Def.neg (Def.mul Def.zero (Def.neg x))) (Def.neg Def.zero) Def.zero
          (congr!{Real Real} Def.neg _ _ (mulZeroLeft (Def.neg x))) negZero))
    (nonnegativeOrNegativeReal x);

\definition fieldMulZeroRight (x: Real): fieldMul x Def.zero = Def.zero :=
  trans!{Real} (fieldMul x Def.zero) (fieldMul Def.zero x) Def.zero
    (fieldMulComm x Def.zero) (fieldMulZeroLeft x);

\definition negativeNegOfPositive (x: Real) (positive: Lt Def.zero x):
  Lt (Def.neg x) Def.zero :=
  ltReplaceRight (Def.neg x) (Def.neg Def.zero) Def.zero negZero
    (negStrictAntitone Def.zero x positive);

\definition fieldMulNegRight (x, y: Real):
  fieldMul x (Def.neg y) = Def.neg (fieldMul x y) :=
  Logic.orElim (Lt Def.zero y) (Logic.Or[Def.zero = y, Lt y Def.zero])
    (fieldMul x (Def.neg y) = Def.neg (fieldMul x y))
    (\fun (positiveY: Lt Def.zero y) =>
      \block {
        \let negativeNegY: Lt (Def.neg y) Def.zero :=
          negativeNegOfPositive y positiveY \then
        \let zeroY: Le Def.zero y := CutOrder.leOfLt Def.zero y positiveY \then
        \return Logic.orElim (Le Def.zero x) (Lt x Def.zero)
          (fieldMul x (Def.neg y) = Def.neg (fieldMul x y))
          (\fun (zeroX: Le Def.zero x) =>
            trans!{Real} (fieldMul x (Def.neg y)) (Def.neg (Def.mul x (Def.neg (Def.neg y))))
              (Def.neg (fieldMul x y))
              (fieldMulNP x (Def.neg y) zeroX negativeNegY)
              (trans!{Real} (Def.neg (Def.mul x (Def.neg (Def.neg y))))
                (Def.neg (Def.mul x y)) (Def.neg (fieldMul x y))
                (congr!{Real Real} Def.neg _ _
                  (congr!{Real Real} (Def.mul x) _ _ (negInvolutive y)))
                (congr!{Real Real} Def.neg _ _
                  (sym!{Real} _ _ (fieldMulNN x y zeroX zeroY)))))
          (\fun (negativeX: Lt x Def.zero) =>
            trans!{Real} (fieldMul x (Def.neg y)) (Def.mul (Def.neg x) (Def.neg (Def.neg y)))
              (Def.neg (fieldMul x y))
              (fieldMulPP x (Def.neg y) negativeX negativeNegY)
              (trans!{Real} (Def.mul (Def.neg x) (Def.neg (Def.neg y))) (Def.mul (Def.neg x) y)
                (Def.neg (fieldMul x y))
                (congr!{Real Real} (Def.mul (Def.neg x)) _ _ (negInvolutive y))
                (trans!{Real} (Def.mul (Def.neg x) y) (Def.neg (Def.neg (Def.mul (Def.neg x) y)))
                  (Def.neg (fieldMul x y))
                  (sym!{Real} _ _ (negInvolutive (Def.mul (Def.neg x) y)))
                  (congr!{Real Real} Def.neg _ _
                    (sym!{Real} _ _ (fieldMulPN x y negativeX zeroY))))))
          (nonnegativeOrNegativeReal x)
      })
    (\fun (rest: Logic.Or[Def.zero = y, Lt y Def.zero]) =>
      Logic.orElim (Def.zero = y) (Lt y Def.zero)
        (fieldMul x (Def.neg y) = Def.neg (fieldMul x y))
        (\fun (same: Def.zero = y) =>
          \idelim Def.zero = y
            \with t: Real => fieldMul x (Def.neg t) = Def.neg (fieldMul x t)
            \by { base:
              trans!{Real} (fieldMul x (Def.neg Def.zero)) (fieldMul x Def.zero)
                (Def.neg (fieldMul x Def.zero))
                (congr!{Real Real} (fieldMul x) _ _ negZero)
                (trans!{Real} (fieldMul x Def.zero) Def.zero
                  (Def.neg (fieldMul x Def.zero)) (fieldMulZeroRight x)
                  (sym!{Real} _ _
                    (trans!{Real} (Def.neg (fieldMul x Def.zero)) (Def.neg Def.zero) Def.zero
                      (congr!{Real Real} Def.neg _ _ (fieldMulZeroRight x)) negZero))),
              equality: same })
        (\fun (negativeY: Lt y Def.zero) =>
          \block {
            \let zeroNegY: Le Def.zero (Def.neg y) :=
              nonnegativeNegOfNegative y negativeY \then
            \return Logic.orElim (Le Def.zero x) (Lt x Def.zero)
              (fieldMul x (Def.neg y) = Def.neg (fieldMul x y))
              (\fun (zeroX: Le Def.zero x) =>
                trans!{Real} (fieldMul x (Def.neg y)) (Def.mul x (Def.neg y))
                  (Def.neg (fieldMul x y))
                  (fieldMulNN x (Def.neg y) zeroX zeroNegY)
                  (trans!{Real} (Def.mul x (Def.neg y))
                    (Def.neg (Def.neg (Def.mul x (Def.neg y)))) (Def.neg (fieldMul x y))
                    (sym!{Real} _ _ (negInvolutive (Def.mul x (Def.neg y))))
                    (congr!{Real Real} Def.neg _ _
                      (sym!{Real} _ _ (fieldMulNP x y zeroX negativeY)))))
              (\fun (negativeX: Lt x Def.zero) =>
                trans!{Real} (fieldMul x (Def.neg y)) (Def.neg (Def.mul (Def.neg x) (Def.neg y)))
                  (Def.neg (fieldMul x y))
                  (fieldMulPN x (Def.neg y) negativeX zeroNegY)
                  (congr!{Real Real} Def.neg _ _
                    (sym!{Real} _ _ (fieldMulPP x y negativeX negativeY))))
              (nonnegativeOrNegativeReal x)
          })
        rest)
    (CutOrder.ltTrichotomy Def.zero y);

\definition fieldMulNegLeft (x, y: Real):
  fieldMul (Def.neg x) y = Def.neg (fieldMul x y) :=
  trans!{Real} (fieldMul (Def.neg x) y) (fieldMul y (Def.neg x))
    (Def.neg (fieldMul x y)) (fieldMulComm (Def.neg x) y)
    (trans!{Real} (fieldMul y (Def.neg x)) (Def.neg (fieldMul y x))
      (Def.neg (fieldMul x y)) (fieldMulNegRight y x)
      (congr!{Real Real} Def.neg _ _ (fieldMulComm y x)));

\definition fieldMulNonnegative (x, y: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y): Le Def.zero (fieldMul x y) :=
  leReplaceRight Def.zero (Def.mul x y) (fieldMul x y)
    (sym!{Real} _ _ (fieldMulNN x y zeroX zeroY))
    (nonnegativeMul x y zeroX zeroY);

\definition fieldMulAssocNNN (x, y, z: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y) (zeroZ: Le Def.zero z):
  fieldMul (fieldMul x y) z = fieldMul x (fieldMul y z) :=
  trans!{Real} (fieldMul (fieldMul x y) z) (fieldMul (Def.mul x y) z)
    (fieldMul x (fieldMul y z))
    (congr!{Real Real} (\fun (t: Real) => fieldMul t z) _ _
      (fieldMulNN x y zeroX zeroY))
    (trans!{Real} (fieldMul (Def.mul x y) z) (Def.mul (Def.mul x y) z)
      (fieldMul x (fieldMul y z))
      (fieldMulNN (Def.mul x y) z (nonnegativeMul x y zeroX zeroY) zeroZ)
      (trans!{Real} (Def.mul (Def.mul x y) z) (Def.mul x (Def.mul y z))
        (fieldMul x (fieldMul y z))
        (mulAssocNonnegative x y z zeroX zeroY zeroZ)
        (trans!{Real} (Def.mul x (Def.mul y z)) (fieldMul x (Def.mul y z))
          (fieldMul x (fieldMul y z))
          (sym!{Real} _ _
            (fieldMulNN x (Def.mul y z) zeroX
              (nonnegativeMul y z zeroY zeroZ)))
          (congr!{Real Real} (fieldMul x) _ _
            (sym!{Real} _ _ (fieldMulNN y z zeroY zeroZ))))));

\definition fieldMulAssocNN (x, y, z: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y):
  fieldMul (fieldMul x y) z = fieldMul x (fieldMul y z) :=
  Logic.orElim (Le Def.zero z) (Lt z Def.zero)
    (fieldMul (fieldMul x y) z = fieldMul x (fieldMul y z))
    (\fun (zeroZ: Le Def.zero z) => fieldMulAssocNNN x y z zeroX zeroY zeroZ)
    (\fun (negativeZ: Lt z Def.zero) =>
      \block {
        \let nz: Real := Def.neg z \then
        \let zeroNz: Le Def.zero nz := nonnegativeNegOfNegative z negativeZ \then
        \let left: fieldMul (fieldMul x y) z =
            Def.neg (fieldMul (fieldMul x y) nz) :=
          trans!{Real} (fieldMul (fieldMul x y) z)
            (fieldMul (fieldMul x y) (Def.neg nz))
            (Def.neg (fieldMul (fieldMul x y) nz))
            (congr!{Real Real} (fieldMul (fieldMul x y)) _ _
              (sym!{Real} _ _ (negInvolutive z)))
            (fieldMulNegRight (fieldMul x y) nz) \then
        \let right: fieldMul x (fieldMul y z) =
            Def.neg (fieldMul x (fieldMul y nz)) :=
          trans!{Real} (fieldMul x (fieldMul y z))
            (fieldMul x (fieldMul y (Def.neg nz)))
            (Def.neg (fieldMul x (fieldMul y nz)))
            (congr!{Real Real} (fieldMul x) _ _
              (congr!{Real Real} (fieldMul y) _ _
                (sym!{Real} _ _ (negInvolutive z))))
            (trans!{Real} (fieldMul x (fieldMul y (Def.neg nz)))
              (fieldMul x (Def.neg (fieldMul y nz)))
              (Def.neg (fieldMul x (fieldMul y nz)))
              (congr!{Real Real} (fieldMul x) _ _
                (fieldMulNegRight y nz))
              (fieldMulNegRight x (fieldMul y nz))) \then
        \return trans!{Real} (fieldMul (fieldMul x y) z)
          (Def.neg (fieldMul (fieldMul x y) nz))
          (fieldMul x (fieldMul y z)) left
          (trans!{Real} (Def.neg (fieldMul (fieldMul x y) nz))
            (Def.neg (fieldMul x (fieldMul y nz)))
            (fieldMul x (fieldMul y z))
            (congr!{Real Real} Def.neg _ _
              (fieldMulAssocNNN x y nz zeroX zeroY zeroNz))
            (sym!{Real} _ _ right))
      })
    (nonnegativeOrNegativeReal z);

\definition fieldMulAssocN (x, y, z: Real) (zeroX: Le Def.zero x):
  fieldMul (fieldMul x y) z = fieldMul x (fieldMul y z) :=
  Logic.orElim (Le Def.zero y) (Lt y Def.zero)
    (fieldMul (fieldMul x y) z = fieldMul x (fieldMul y z))
    (\fun (zeroY: Le Def.zero y) => fieldMulAssocNN x y z zeroX zeroY)
    (\fun (negativeY: Lt y Def.zero) =>
      \block {
        \let ny: Real := Def.neg y \then
        \let zeroNy: Le Def.zero ny := nonnegativeNegOfNegative y negativeY \then
        \let left: fieldMul (fieldMul x y) z =
            Def.neg (fieldMul (fieldMul x ny) z) :=
          trans!{Real} (fieldMul (fieldMul x y) z)
            (fieldMul (fieldMul x (Def.neg ny)) z)
            (Def.neg (fieldMul (fieldMul x ny) z))
            (congr!{Real Real} (\fun (t: Real) => fieldMul (fieldMul x t) z)
              _ _ (sym!{Real} _ _ (negInvolutive y)))
            (trans!{Real} (fieldMul (fieldMul x (Def.neg ny)) z)
              (fieldMul (Def.neg (fieldMul x ny)) z)
              (Def.neg (fieldMul (fieldMul x ny) z))
              (congr!{Real Real} (\fun (t: Real) => fieldMul t z) _ _
                (fieldMulNegRight x ny))
              (fieldMulNegLeft (fieldMul x ny) z)) \then
        \let right: fieldMul x (fieldMul y z) =
            Def.neg (fieldMul x (fieldMul ny z)) :=
          trans!{Real} (fieldMul x (fieldMul y z))
            (fieldMul x (fieldMul (Def.neg ny) z))
            (Def.neg (fieldMul x (fieldMul ny z)))
            (congr!{Real Real} (fieldMul x) _ _
              (congr!{Real Real} (\fun (t: Real) => fieldMul t z) _ _
                (sym!{Real} _ _ (negInvolutive y))))
            (trans!{Real} (fieldMul x (fieldMul (Def.neg ny) z))
              (fieldMul x (Def.neg (fieldMul ny z)))
              (Def.neg (fieldMul x (fieldMul ny z)))
              (congr!{Real Real} (fieldMul x) _ _
                (fieldMulNegLeft ny z))
              (fieldMulNegRight x (fieldMul ny z))) \then
        \return trans!{Real} (fieldMul (fieldMul x y) z)
          (Def.neg (fieldMul (fieldMul x ny) z))
          (fieldMul x (fieldMul y z)) left
          (trans!{Real} (Def.neg (fieldMul (fieldMul x ny) z))
            (Def.neg (fieldMul x (fieldMul ny z)))
            (fieldMul x (fieldMul y z))
            (congr!{Real Real} Def.neg _ _ (fieldMulAssocNN x ny z zeroX zeroNy))
            (sym!{Real} _ _ right))
      })
    (nonnegativeOrNegativeReal y);

\definition fieldMulAssoc (x, y, z: Real):
  fieldMul (fieldMul x y) z = fieldMul x (fieldMul y z) :=
  Logic.orElim (Le Def.zero x) (Lt x Def.zero)
    (fieldMul (fieldMul x y) z = fieldMul x (fieldMul y z))
    (\fun (zeroX: Le Def.zero x) => fieldMulAssocN x y z zeroX)
    (\fun (negativeX: Lt x Def.zero) =>
      \block {
        \let nx: Real := Def.neg x \then
        \let zeroNx: Le Def.zero nx := nonnegativeNegOfNegative x negativeX \then
        \let left: fieldMul (fieldMul x y) z =
            Def.neg (fieldMul (fieldMul nx y) z) :=
          trans!{Real} (fieldMul (fieldMul x y) z)
            (fieldMul (fieldMul (Def.neg nx) y) z)
            (Def.neg (fieldMul (fieldMul nx y) z))
            (congr!{Real Real} (\fun (t: Real) => fieldMul (fieldMul t y) z)
              _ _ (sym!{Real} _ _ (negInvolutive x)))
            (trans!{Real} (fieldMul (fieldMul (Def.neg nx) y) z)
              (fieldMul (Def.neg (fieldMul nx y)) z)
              (Def.neg (fieldMul (fieldMul nx y) z))
              (congr!{Real Real} (\fun (t: Real) => fieldMul t z) _ _
                (fieldMulNegLeft nx y))
              (fieldMulNegLeft (fieldMul nx y) z)) \then
        \let right: fieldMul x (fieldMul y z) =
            Def.neg (fieldMul nx (fieldMul y z)) :=
          trans!{Real} (fieldMul x (fieldMul y z))
            (fieldMul (Def.neg nx) (fieldMul y z))
            (Def.neg (fieldMul nx (fieldMul y z)))
            (congr!{Real Real} (\fun (t: Real) => fieldMul t (fieldMul y z))
              _ _ (sym!{Real} _ _ (negInvolutive x)))
            (fieldMulNegLeft nx (fieldMul y z)) \then
        \return trans!{Real} (fieldMul (fieldMul x y) z)
          (Def.neg (fieldMul (fieldMul nx y) z))
          (fieldMul x (fieldMul y z)) left
          (trans!{Real} (Def.neg (fieldMul (fieldMul nx y) z))
            (Def.neg (fieldMul nx (fieldMul y z)))
            (fieldMul x (fieldMul y z))
            (congr!{Real Real} Def.neg _ _ (fieldMulAssocN nx y z zeroNx))
            (sym!{Real} _ _ right))
      })
    (nonnegativeOrNegativeReal x);

\definition addNonnegative (x, y: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y): Le Def.zero (Def.add x y) :=
  leReplaceLeft (Def.add Def.zero Def.zero) Def.zero (Def.add x y) (addZeroLeft Def.zero)
    (leTrans (Def.add Def.zero Def.zero) (Def.add x Def.zero) (Def.add x y)
      (addMonotoneRight Def.zero x Def.zero zeroX)
      (addMonotoneLeft Def.zero y x zeroY));

\definition positiveLeftMulBelow (x, y: Real) (q, a, b: Rat)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y)
  (aPositive: lt zeroRat a) (xa: mem x a) (yb: mem y b)
  (qab: lt q (mulRat a b)): mem (Def.mul x y) q :=
  \block {
    \let productNonnegative: Le Def.zero (Def.mul x y) :=
      nonnegativeMul x y zeroX zeroY \then
    \return Logic.orElim (lt zeroRat b)
    (Logic.Or[RationalFractions.FractionEq zeroRat b, lt b zeroRat])
    (mem (Def.mul x y) q)
    (\fun (bPositive: lt zeroRat b) =>
      nonnegativeMulIntro x y q a b aPositive xa bPositive yb qab)
    (\fun (rest: Logic.Or[
        RationalFractions.FractionEq zeroRat b, lt b zeroRat]) =>
      Logic.orElim (RationalFractions.FractionEq zeroRat b)
        (lt b zeroRat) (mem (Def.mul x y) q)
        (\fun (zeroB: RationalFractions.FractionEq zeroRat b) =>
          productNonnegative q
            (ofRatMem zeroRat q
              (RationalOrder.ltReplaceRight q (mulRat a b) zeroRat
                (RationalFractions.fractionEqTrans _ _ _
                  (RationalOperationsProp.fractionMulRespects a a b zeroRat
                    (RationalFractions.fractionEqRefl a)
                    (RationalFractions.fractionEqSym _ _ zeroB))
                  (RationalOperationsProp.fractionMulZeroRight a)) qab)))
        (\fun (bNegative: lt b zeroRat) =>
          productNonnegative q
            (ofRatMem zeroRat q
              (RationalOrder.ltTrans q (mulRat a b) zeroRat qab
                (RationalOperationsProp.mulLtZeroPositiveNegative a b
                  aPositive bNegative))))
        rest)
    (RationalOrder.trichotomy zeroRat b)
  };

\definition mulAddNonnegativeForward (x, y, z: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y) (zeroZ: Le Def.zero z):
  Le (Def.mul x (Def.add y z)) (Def.add (Def.mul x y) (Def.mul x z)) :=
  \fun (q: Rat) => \fun (member: mem (Def.mul x (Def.add y z)) q) =>
    Logic.orElim (RationalOperations.Le zeroRat q) (lt q zeroRat)
      (mem (Def.add (Def.mul x y) (Def.mul x z)) q)
      (\fun (qNonnegative: RationalOperations.Le zeroRat q) =>
        nonnegativeMulElim x (Def.add y z) q zeroX
          (addNonnegative y z zeroY zeroZ) qNonnegative member
          (mem (Def.add (Def.mul x y) (Def.mul x z)) q)
          (\fun (a, s: Rat) => \fun (aPositive: lt zeroRat a) =>
            \fun (xa: mem x a) => \fun (_: lt zeroRat s) =>
            \fun (yzs: mem (Def.add y z) s) =>
            \fun (qas: lt q (mulRat a s)) =>
              CutLaws.sumElim y z s (addMemLower y z s yzs)
                (mem (Def.add (Def.mul x y) (Def.mul x z)) q)
                (\fun (b, c: Rat) => \fun (yb: mem y b) =>
                  \fun (zc: mem z c) =>
                  \fun (sbc: lt s (addRat b c)) =>
                    \block {
                      \let qabc: lt q (mulRat a (addRat b c)) :=
                        RationalOrder.ltTrans q (mulRat a s)
                          (mulRat a (addRat b c)) qas
                          (RationalOperationsProp.ltMulPositiveLeft a s
                            (addRat b c) aPositive sbc) \then
                      \let qabac: lt q
                          (addRat (mulRat a b) (mulRat a c)) :=
                        RationalOrder.ltReplaceRight q
                          (mulRat a (addRat b c))
                          (addRat (mulRat a b) (mulRat a c))
                          (RationalOperationsProp.fractionMulAddLeft a b c) qabc \then
                      \let u: Rat := RationalOperations.perturbLeft q
                        (mulRat a b) (mulRat a c) \then
                      \let uab: lt u (mulRat a b) :=
                        RationalOperationsProp.perturbLeftLt q
                          (mulRat a b) (mulRat a c) qabac \then
                      \let quac: lt q (addRat u (mulRat a c)) :=
                        RationalOperationsProp.ltPerturbedSum q
                          (mulRat a b) (mulRat a c) qabac \then
                      \let qacu: lt q (addRat (mulRat a c) u) :=
                        RationalOrder.ltReplaceRight q
                          (addRat u (mulRat a c))
                          (addRat (mulRat a c) u)
                          (RationalOperationsProp.fractionAddComm u (mulRat a c))
                          quac \then
                      \let v: Rat := RationalOperations.perturbLeft q
                        (mulRat a c) u \then
                      \let vac: lt v (mulRat a c) :=
                        RationalOperationsProp.perturbLeftLt q (mulRat a c) u qacu \then
                      \let qvu: lt q (addRat v u) :=
                        RationalOperationsProp.ltPerturbedSum q (mulRat a c) u qacu \then
                      \let quv: lt q (addRat u v) :=
                        RationalOrder.ltReplaceRight q (addRat v u) (addRat u v)
                          (RationalOperationsProp.fractionAddComm v u) qvu \then
                      \return addMem (Def.mul x y) (Def.mul x z) q
                        (CutLaws.sumIntro (Def.mul x y) (Def.mul x z) q u v
                          (positiveLeftMulBelow x y u a b zeroX zeroY
                            aPositive xa yb uab)
                          (positiveLeftMulBelow x z v a c zeroX zeroZ
                            aPositive xa zc vac) quv)
                    })))
      (\fun (qNegative: lt q zeroRat) =>
        (addNonnegative (Def.mul x y) (Def.mul x z)
          (nonnegativeMul x y zeroX zeroY)
          (nonnegativeMul x z zeroX zeroZ)) q
          (ofRatMem zeroRat q qNegative))
      (RationalOperationsProp.nonnegativeOrNegative q);

\definition mulAddNonnegativeBackward (x, y, z: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y) (zeroZ: Le Def.zero z):
  Le (Def.add (Def.mul x y) (Def.mul x z)) (Def.mul x (Def.add y z)) :=
  \fun (q: Rat) => \fun (member: mem (Def.add (Def.mul x y) (Def.mul x z)) q) =>
    Logic.orElim (RationalOperations.Le zeroRat q) (lt q zeroRat)
      (mem (Def.mul x (Def.add y z)) q)
      (\fun (qNonnegative: RationalOperations.Le zeroRat q) =>
        CutLaws.sumElim (Def.mul x y) (Def.mul x z) q
          (addMemLower (Def.mul x y) (Def.mul x z) q member)
          (mem (Def.mul x (Def.add y z)) q)
          (\fun (u, v: Rat) => \fun (xyu: mem (Def.mul x y) u) =>
            \fun (xzv: mem (Def.mul x z) v) =>
            \fun (quv: lt q (addRat u v)) =>
              Logic.orElim (RationalOperations.Le zeroRat u)
                (lt u zeroRat) (mem (Def.mul x (Def.add y z)) q)
                (\fun (uNonnegative: RationalOperations.Le zeroRat u) =>
                  Logic.orElim (RationalOperations.Le zeroRat v)
                    (lt v zeroRat) (mem (Def.mul x (Def.add y z)) q)
                    (\fun (vNonnegative: RationalOperations.Le zeroRat v) =>
                      nonnegativeMulElim x y u zeroX zeroY uNonnegative xyu
                        (mem (Def.mul x (Def.add y z)) q)
                        (\fun (a, b: Rat) =>
                          \fun (aPositive: lt zeroRat a) =>
                          \fun (xa: mem x a) =>
                          \fun (bPositive: lt zeroRat b) =>
                          \fun (yb: mem y b) =>
                          \fun (uab: lt u (mulRat a b)) =>
                            nonnegativeMulElim x z v zeroX zeroZ
                              vNonnegative xzv
                              (mem (Def.mul x (Def.add y z)) q)
                              (\fun (c, d: Rat) =>
                                \fun (cPositive: lt zeroRat c) =>
                                \fun (xc: mem x c) =>
                                \fun (dPositive: lt zeroRat d) =>
                                \fun (zd: mem z d) =>
                                \fun (vcd: lt v (mulRat c d)) =>
                                  \block {
                                    \let qProducts: lt q (addRat
                                        (mulRat a b) (mulRat c d)) :=
                                      RationalOrder.ltTrans q (addRat u v)
                                        (addRat (mulRat a b) (mulRat c d))
                                        quv (RationalOperationsProp.ltAdd u
                                          (mulRat a b) v (mulRat c d)
                                          uab vcd) \then
                                    \let bdPositive: lt zeroRat
                                        (addRat b d) :=
                                      RationalOrder.ltReplaceLeft
                                        (addRat zeroRat zeroRat) zeroRat
                                        (addRat b d)
                                        (RationalOperationsProp.fractionAddZeroLeft
                                          zeroRat)
                                        (RationalOperationsProp.ltAdd zeroRat b
                                          zeroRat d bPositive dPositive) \then
                                    \let yzbd: mem (Def.add y z) (addRat b d) :=
                                      addMem y z (addRat b d)
                                        (CutLaws.sumContainsAdd y z b d yb zd) \then
                                    \return Logic.orElim (lt a c)
                                      (Logic.Or[
                                        RationalFractions.FractionEq a c,
                                        lt c a])
                                      (mem (Def.mul x (Def.add y z)) q)
                                      (\fun (ac: lt a c) =>
                                        \block {
                                          \let qcbcd: lt q (addRat
                                              (mulRat c b) (mulRat c d)) :=
                                            RationalOrder.ltTrans q
                                              (addRat (mulRat a b)
                                                (mulRat c d))
                                              (addRat (mulRat c b)
                                                (mulRat c d)) qProducts
                                              (RationalOperationsProp.ltAddRight
                                                (mulRat a b) (mulRat c b)
                                                (mulRat c d)
                                                (RationalOperationsProp.ltMulPositiveRight a c b
                                                    bPositive ac)) \then
                                          \let qcbd: lt q
                                              (mulRat c (addRat b d)) :=
                                            RationalOrder.ltReplaceRight q
                                              (addRat (mulRat c b)
                                                (mulRat c d))
                                              (mulRat c (addRat b d))
                                              (RationalFractions
                                                .fractionEqSym _ _
                                                  (RationalOperationsProp.fractionMulAddLeft c b d))
                                              qcbcd \then
                                          \return nonnegativeMulIntro x
                                            (Def.add y z) q c (addRat b d)
                                            cPositive xc bdPositive yzbd qcbd
                                        })
                                      (\fun (rest: Logic.Or[
                                          RationalFractions.FractionEq a c,
                                          lt c a]) =>
                                        Logic.orElim
                                          (RationalFractions.FractionEq a c)
                                          (lt c a)
                                          (mem (Def.mul x (Def.add y z)) q)
                                          (\fun (same: RationalFractions
                                              .FractionEq a c) =>
                                            \block {
                                              \let qabd: lt q (addRat
                                                  (mulRat a b)
                                                  (mulRat a d)) :=
                                                RationalOrder.ltReplaceRight q
                                                  (addRat (mulRat a b)
                                                    (mulRat c d))
                                                  (addRat (mulRat a b)
                                                    (mulRat a d))
                                                  (RationalOperationsProp.fractionAddRespects
                                                      (mulRat a b)
                                                      (mulRat a b)
                                                      (mulRat c d)
                                                      (mulRat a d)
                                                      (RationalFractions
                                                        .fractionEqRefl _)
                                                      (RationalOperationsProp.fractionMulRespects
                                                          c a d d
                                                          (RationalFractions
                                                            .fractionEqSym
                                                              _ _ same)
                                                          (RationalFractions
                                                            .fractionEqRefl d)))
                                                  qProducts \then
                                              \let qabdFactored: lt q
                                                  (mulRat a (addRat b d)) :=
                                                RationalOrder.ltReplaceRight q
                                                  (addRat (mulRat a b)
                                                    (mulRat a d))
                                                  (mulRat a (addRat b d))
                                                  (RationalFractions
                                                    .fractionEqSym _ _
                                                      (RationalOperationsProp.fractionMulAddLeft
                                                          a b d)) qabd \then
                                              \return nonnegativeMulIntro x
                                                (Def.add y z) q a (addRat b d)
                                                aPositive xa bdPositive yzbd
                                                qabdFactored
                                            })
                                          (\fun (ca: lt c a) =>
                                            \block {
                                              \let qab_ad: lt q (addRat
                                                  (mulRat a b)
                                                  (mulRat a d)) :=
                                                RationalOrder.ltTrans q
                                                  (addRat (mulRat a b)
                                                    (mulRat c d))
                                                  (addRat (mulRat a b)
                                                    (mulRat a d)) qProducts
                                                  (RationalOperationsProp.ltAddLeft
                                                    (mulRat a b)
                                                    (mulRat c d)
                                                    (mulRat a d)
                                                    (RationalOperationsProp.ltMulPositiveRight c a d
                                                        dPositive ca)) \then
                                              \let qabdFactored: lt q
                                                  (mulRat a (addRat b d)) :=
                                                RationalOrder.ltReplaceRight q
                                                  (addRat (mulRat a b)
                                                    (mulRat a d))
                                                  (mulRat a (addRat b d))
                                                  (RationalFractions
                                                    .fractionEqSym _ _
                                                      (RationalOperationsProp.fractionMulAddLeft
                                                          a b d)) qab_ad \then
                                              \return nonnegativeMulIntro x
                                                (Def.add y z) q a (addRat b d)
                                                aPositive xa bdPositive yzbd
                                                qabdFactored
                                            }) rest)
                                      (RationalOrder.trichotomy a c)
                                  })))
                    (\fun (vNegative: lt v zeroRat) =>
                      nonnegativeMulElim x y u zeroX zeroY uNonnegative xyu
                        (mem (Def.mul x (Def.add y z)) q)
                        (\fun (a, b: Rat) =>
                          \fun (aPositive: lt zeroRat a) =>
                          \fun (xa: mem x a) =>
                          \fun (bPositive: lt zeroRat b) =>
                          \fun (yb: mem y b) =>
                          \fun (uab: lt u (mulRat a b)) =>
                            \block {
                              \let qu: lt q u :=
                                RationalOrder.ltTrans q (addRat u v) u quv
                                  (RationalOrder.ltReplaceRight
                                    (addRat u v) (addRat u zeroRat) u
                                    (RationalOperationsProp.fractionAddZeroRight u)
                                    (RationalOperationsProp.ltAddLeft u v zeroRat
                                      vNegative)) \then
                              \let qab: lt q (mulRat a b) :=
                                RationalOrder.ltTrans q u (mulRat a b)
                                  qu uab \then
                              \takefrom r: \Cast[Rat] ({ r : Rat \where
                                  Estimates.ContractRightLaw[q, a, b, r] }) \by contractRight q a b aPositive bPositive
                                qab \then
                              \let rLaw: Estimates.ContractRightLaw[q, a, b, r] :=
                                \bysub(Rat, { r : Rat \where
                                  Estimates.ContractRightLaw[q, a, b, r] }, r) \then
                              \let e: Rat :=
                                RationalOperations.adjustment r b \then
                              \let eNegative: lt e zeroRat :=
                                RationalOperationsProp.adjustmentLtZero r b
                                  (#below{rLaw}) \then
                              \let ze: mem z e := zeroZ e
                                (ofRatMem zeroRat e eNegative) \then
                              \let yzr: mem (Def.add y z) r :=
                                addMem y z r
                                  (CutLaws.sumIntro y z r b e yb ze
                                    (RationalOperationsProp.ltAddAdjustment
                                      r b (#below{rLaw}))) \then
                              \return nonnegativeMulIntro x (Def.add y z)
                                q a r aPositive xa #positive{rLaw} yzr
                                (#productAbove{rLaw})}))
                    (RationalOperationsProp.nonnegativeOrNegative v))
                (\fun (uNegative: lt u zeroRat) =>
                  Logic.orElim (RationalOperations.Le zeroRat v)
                    (lt v zeroRat) (mem (Def.mul x (Def.add y z)) q)
                    (\fun (vNonnegative: RationalOperations.Le zeroRat v) =>
                      nonnegativeMulElim x z v zeroX zeroZ vNonnegative xzv
                        (mem (Def.mul x (Def.add y z)) q)
                        (\fun (a, d: Rat) =>
                          \fun (aPositive: lt zeroRat a) =>
                          \fun (xa: mem x a) =>
                          \fun (dPositive: lt zeroRat d) =>
                          \fun (zd: mem z d) =>
                          \fun (vad: lt v (mulRat a d)) =>
                            \block {
                              \let qv: lt q v :=
                                RationalOrder.ltTrans q (addRat u v) v quv
                                  (RationalOrder.ltReplaceRight
                                    (addRat u v) (addRat zeroRat v) v
                                    (RationalOperationsProp.fractionAddZeroLeft v)
                                    (RationalOperationsProp.ltAddRight u zeroRat v
                                      uNegative)) \then
                              \let qad: lt q (mulRat a d) :=
                                RationalOrder.ltTrans q v (mulRat a d)
                                  qv vad \then
                              \takefrom r: \Cast[Rat] ({ r : Rat \where
                                  Estimates.ContractRightLaw[q, a, d, r] }) \by contractRight q a d aPositive dPositive
                                qad \then
                              \let rLaw: Estimates.ContractRightLaw[q, a, d, r] :=
                                \bysub(Rat, { r : Rat \where
                                  Estimates.ContractRightLaw[q, a, d, r] }, r) \then
                              \let e: Rat :=
                                RationalOperations.adjustment r d \then
                              \let eNegative: lt e zeroRat :=
                                RationalOperationsProp.adjustmentLtZero r d
                                  (#below{rLaw}) \then
                              \let ye: mem y e := zeroY e
                                (ofRatMem zeroRat e eNegative) \then
                              \let red: lt r (addRat e d) :=
                                RationalOrder.ltReplaceRight r
                                  (addRat d e) (addRat e d)
                                  (RationalOperationsProp.fractionAddComm d e)
                                  (RationalOperationsProp.ltAddAdjustment r d
                                    (#below{rLaw})) \then
                              \let yzr: mem (Def.add y z) r :=
                                addMem y z r
                                  (CutLaws.sumIntro y z r e d ye zd red) \then
                              \return nonnegativeMulIntro x (Def.add y z)
                                q a r aPositive xa #positive{rLaw} yzr
                                (#productAbove{rLaw})}))
                    (\fun (vNegative: lt v zeroRat) =>
                      Logic.falseElim (mem (Def.mul x (Def.add y z)) q)
                        (RationalOrder.ltIrrefl zeroRat
                          (RationalOperationsProp.leLtTrans zeroRat q zeroRat
                            qNonnegative
                            (RationalOrder.ltTrans q (addRat u v) zeroRat
                              quv
                              (RationalOrder.ltReplaceRight
                                (addRat u v)
                                (addRat zeroRat zeroRat) zeroRat
                                (RationalOperationsProp.fractionAddZeroLeft
                                  zeroRat)
                                (RationalOperationsProp.ltAdd u zeroRat v zeroRat
                                  uNegative vNegative))))))
                    (RationalOperationsProp.nonnegativeOrNegative v))
                (RationalOperationsProp.nonnegativeOrNegative u)))
      (\fun (qNegative: lt q zeroRat) =>
        (nonnegativeMul x (Def.add y z) zeroX
          (addNonnegative y z zeroY zeroZ)) q
          (ofRatMem zeroRat q qNegative))
      (RationalOperationsProp.nonnegativeOrNegative q);

\definition mulAddNonnegative (x, y, z: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y) (zeroZ: Le Def.zero z):
  Def.mul x (Def.add y z) = Def.add (Def.mul x y) (Def.mul x z) :=
  eqByExt (Def.mul x (Def.add y z)) (Def.add (Def.mul x y) (Def.mul x z))
    (mulAddNonnegativeForward x y z zeroX zeroY zeroZ)
    (mulAddNonnegativeBackward x y z zeroX zeroY zeroZ);

\definition negAdd (x, y: Real):
  Def.neg (Def.add x y) = Def.add (Def.neg x) (Def.neg y) :=
  addCancelRight (Def.neg (Def.add x y)) (Def.add (Def.neg x) (Def.neg y)) (Def.add x y)
    (trans!{Real} (Def.add (Def.neg (Def.add x y)) (Def.add x y)) Def.zero
      (Def.add (Def.add (Def.neg x) (Def.neg y)) (Def.add x y))
      (addNegLeft (Def.add x y))
      (sym!{Real} (Def.add (Def.add (Def.neg x) (Def.neg y)) (Def.add x y)) Def.zero
        (trans!{Real} (Def.add (Def.add (Def.neg x) (Def.neg y)) (Def.add x y))
          (Def.add (Def.neg x) (Def.add (Def.neg y) (Def.add x y))) Def.zero
          (addAssoc (Def.neg x) (Def.neg y) (Def.add x y))
          (trans!{Real} (Def.add (Def.neg x) (Def.add (Def.neg y) (Def.add x y)))
            (Def.add (Def.neg x) (Def.add (Def.neg y) (Def.add y x))) Def.zero
            (congr!{Real Real} (Def.add (Def.neg x)) _ _
              (congr!{Real Real} (Def.add (Def.neg y)) _ _ (addComm x y)))
            (trans!{Real} (Def.add (Def.neg x) (Def.add (Def.neg y) (Def.add y x)))
              (Def.add (Def.neg x) (Def.add (Def.add (Def.neg y) y) x)) Def.zero
              (congr!{Real Real} (Def.add (Def.neg x)) _ _
                (sym!{Real} _ _ (addAssoc (Def.neg y) y x)))
              (trans!{Real} (Def.add (Def.neg x) (Def.add (Def.add (Def.neg y) y) x))
                (Def.add (Def.neg x) (Def.add Def.zero x)) Def.zero
                (congr!{Real Real} (Def.add (Def.neg x)) _ _
                  (congr!{Real Real} (\fun (t: Real) => Def.add t x) _ _
                    (addNegLeft y)))
                (trans!{Real} (Def.add (Def.neg x) (Def.add Def.zero x))
                  (Def.add (Def.neg x) x) Def.zero
                  (congr!{Real Real} (Def.add (Def.neg x)) _ _ (addZeroLeft x))
                  (addNegLeft x))))))));

\definition addSolveRight (a, b, c: Real) (same: Def.add a b = c):
  a = Def.add c (Def.neg b) :=
  addCancelRight a (Def.add c (Def.neg b)) b
    (trans!{Real} (Def.add a b) c (Def.add (Def.add c (Def.neg b)) b) same
      (sym!{Real} (Def.add (Def.add c (Def.neg b)) b) c
        (trans!{Real} (Def.add (Def.add c (Def.neg b)) b)
          (Def.add c (Def.add (Def.neg b) b)) c
          (addAssoc c (Def.neg b) b)
          (trans!{Real} (Def.add c (Def.add (Def.neg b) b)) (Def.add c Def.zero) c
            (congr!{Real Real} (Def.add c) _ _ (addNegLeft b))
            (addZeroRight c)))));

\definition negLeftFromSum (a, b, c: Real) (same: Def.add a b = c):
  Def.neg a = Def.add b (Def.neg c) :=
  addCancelLeft a (Def.neg a) (Def.add b (Def.neg c))
    (trans!{Real} (Def.add a (Def.neg a)) Def.zero (Def.add a (Def.add b (Def.neg c)))
      (addNegRight a)
      (sym!{Real} (Def.add a (Def.add b (Def.neg c))) Def.zero
        (trans!{Real} (Def.add a (Def.add b (Def.neg c)))
          (Def.add (Def.add a b) (Def.neg c)) Def.zero
          (sym!{Real} _ _ (addAssoc a b (Def.neg c)))
          (trans!{Real} (Def.add (Def.add a b) (Def.neg c))
            (Def.add c (Def.neg c)) Def.zero
            (congr!{Real Real} (\fun (t: Real) => Def.add t (Def.neg c)) _ _ same)
            (addNegRight c)))));

\definition fieldMulAddNN (x, y, z: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y) (zeroZ: Le Def.zero z):
  fieldMul x (Def.add y z) = Def.add (fieldMul x y) (fieldMul x z) :=
  trans!{Real} (fieldMul x (Def.add y z)) (Def.mul x (Def.add y z))
    (Def.add (fieldMul x y) (fieldMul x z))
    (fieldMulNN x (Def.add y z) zeroX
      (addNonnegative y z zeroY zeroZ))
    (trans!{Real} (Def.mul x (Def.add y z)) (Def.add (Def.mul x y) (Def.mul x z))
      (Def.add (fieldMul x y) (fieldMul x z))
      (mulAddNonnegative x y z zeroX zeroY zeroZ)
      (congr2!{Real Real Real} Def.add _ _ _ _
        (sym!{Real} _ _ (fieldMulNN x y zeroX zeroY))
        (sym!{Real} _ _ (fieldMulNN x z zeroX zeroZ))));

\definition fieldMulOfNegAsNeg (x, y: Real):
  fieldMul x y = Def.neg (fieldMul x (Def.neg y)) :=
  trans!{Real} (fieldMul x y) (fieldMul x (Def.neg (Def.neg y)))
    (Def.neg (fieldMul x (Def.neg y)))
    (congr!{Real Real} (fieldMul x) _ _
      (sym!{Real} _ _ (negInvolutive y)))
    (fieldMulNegRight x (Def.neg y));

\definition fieldMulAddNP (x, y, z: Real)
  (zeroX: Le Def.zero x) (zeroY: Le Def.zero y) (negativeZ: Lt z Def.zero):
  fieldMul x (Def.add y z) = Def.add (fieldMul x y) (fieldMul x z) :=
  \block {
    \let nz: Real := Def.neg z \then
    \let zeroNz: Le Def.zero nz := nonnegativeNegOfNegative z negativeZ \then
    \return Logic.orElim (Le Def.zero (Def.add y z)) (Lt (Def.add y z) Def.zero)
      (fieldMul x (Def.add y z) = Def.add (fieldMul x y) (fieldMul x z))
      (\fun (zeroSum: Le Def.zero (Def.add y z)) =>
        \block {
          \let expanded: fieldMul x y = Def.add
              (fieldMul x (Def.add y z)) (fieldMul x nz) :=
            trans!{Real} (fieldMul x y)
              (fieldMul x (Def.add (Def.add y z) nz))
              (Def.add (fieldMul x (Def.add y z)) (fieldMul x nz))
              (congr!{Real Real} (fieldMul x) _ _
                (sym!{Real} _ _ (addNegCancelRight z y)))
              (fieldMulAddNN x (Def.add y z) nz zeroX zeroSum zeroNz) \then
          \let solved: fieldMul x (Def.add y z) =
              Def.add (fieldMul x y) (Def.neg (fieldMul x nz)) :=
            addSolveRight (fieldMul x (Def.add y z)) (fieldMul x nz)
              (fieldMul x y) (sym!{Real} _ _ expanded) \then
          \return trans!{Real} (fieldMul x (Def.add y z))
            (Def.add (fieldMul x y) (Def.neg (fieldMul x nz)))
            (Def.add (fieldMul x y) (fieldMul x z)) solved
            (congr!{Real Real} (Def.add (fieldMul x y)) _ _
              (sym!{Real} _ _ (fieldMulOfNegAsNeg x z)))
        })
      (\fun (negativeSum: Lt (Def.add y z) Def.zero) =>
        \block {
          \let ns: Real := Def.neg (Def.add y z) \then
          \let zeroNs: Le Def.zero ns :=
            nonnegativeNegOfNegative (Def.add y z) negativeSum \then
          \let nsPlusY: Def.add ns y = nz :=
            addCancelRight (Def.add ns y) nz z
              (trans!{Real} (Def.add (Def.add ns y) z)
                (Def.add ns (Def.add y z)) (Def.add nz z)
                (addAssoc ns y z)
                (trans!{Real} (Def.add ns (Def.add y z)) Def.zero (Def.add nz z)
                  (addNegLeft (Def.add y z))
                  (sym!{Real} _ _ (addNegLeft z)))) \then
          \let expanded: fieldMul x nz =
              Def.add (fieldMul x ns) (fieldMul x y) :=
            trans!{Real} (fieldMul x nz) (fieldMul x (Def.add ns y))
              (Def.add (fieldMul x ns) (fieldMul x y))
              (congr!{Real Real} (fieldMul x) _ _
                (sym!{Real} _ _ nsPlusY))
              (fieldMulAddNN x ns y zeroX zeroNs zeroY) \then
          \let solved: Def.neg (fieldMul x ns) =
              Def.add (fieldMul x y) (Def.neg (fieldMul x nz)) :=
            negLeftFromSum (fieldMul x ns) (fieldMul x y)
              (fieldMul x nz) (sym!{Real} _ _ expanded) \then
          \return trans!{Real} (fieldMul x (Def.add y z))
            (Def.neg (fieldMul x ns))
            (Def.add (fieldMul x y) (fieldMul x z))
            (fieldMulOfNegAsNeg x (Def.add y z))
            (trans!{Real} (Def.neg (fieldMul x ns))
              (Def.add (fieldMul x y) (Def.neg (fieldMul x nz)))
              (Def.add (fieldMul x y) (fieldMul x z)) solved
              (congr!{Real Real} (Def.add (fieldMul x y)) _ _
                (sym!{Real} _ _ (fieldMulOfNegAsNeg x z))))
        })
      (nonnegativeOrNegativeReal (Def.add y z))
  };

\definition fieldMulAddN (x, y, z: Real) (zeroX: Le Def.zero x):
  fieldMul x (Def.add y z) = Def.add (fieldMul x y) (fieldMul x z) :=
  Logic.orElim (Le Def.zero y) (Lt y Def.zero)
    (fieldMul x (Def.add y z) = Def.add (fieldMul x y) (fieldMul x z))
    (\fun (zeroY: Le Def.zero y) =>
      Logic.orElim (Le Def.zero z) (Lt z Def.zero)
        (fieldMul x (Def.add y z) = Def.add (fieldMul x y) (fieldMul x z))
        (\fun (zeroZ: Le Def.zero z) =>
          fieldMulAddNN x y z zeroX zeroY zeroZ)
        (\fun (negativeZ: Lt z Def.zero) =>
          fieldMulAddNP x y z zeroX zeroY negativeZ)
        (nonnegativeOrNegativeReal z))
    (\fun (negativeY: Lt y Def.zero) =>
      Logic.orElim (Le Def.zero z) (Lt z Def.zero)
        (fieldMul x (Def.add y z) = Def.add (fieldMul x y) (fieldMul x z))
        (\fun (zeroZ: Le Def.zero z) =>
          trans!{Real} (fieldMul x (Def.add y z))
            (fieldMul x (Def.add z y))
            (Def.add (fieldMul x y) (fieldMul x z))
            (congr!{Real Real} (fieldMul x) _ _ (addComm y z))
            (trans!{Real} (fieldMul x (Def.add z y))
              (Def.add (fieldMul x z) (fieldMul x y))
              (Def.add (fieldMul x y) (fieldMul x z))
              (fieldMulAddNP x z y zeroX zeroZ negativeY)
              (addComm (fieldMul x z) (fieldMul x y))))
        (\fun (negativeZ: Lt z Def.zero) =>
          \block {
            \let ny: Real := Def.neg y \then
            \let nz: Real := Def.neg z \then
            \let zeroNy: Le Def.zero ny :=
              nonnegativeNegOfNegative y negativeY \then
            \let zeroNz: Le Def.zero nz :=
              nonnegativeNegOfNegative z negativeZ \then
            \let sumAsNeg: Def.add y z = Def.neg (Def.add ny nz) :=
              sym!{Real} (Def.neg (Def.add ny nz)) (Def.add y z)
                (trans!{Real} (Def.neg (Def.add ny nz))
                  (Def.add (Def.neg ny) (Def.neg nz)) (Def.add y z)
                  (negAdd ny nz)
                  (congr2!{Real Real Real} Def.add _ _ _ _
                    (negInvolutive y) (negInvolutive z))) \then
            \return trans!{Real} (fieldMul x (Def.add y z))
              (fieldMul x (Def.neg (Def.add ny nz)))
              (Def.add (fieldMul x y) (fieldMul x z))
              (congr!{Real Real} (fieldMul x) _ _ sumAsNeg)
              (trans!{Real} (fieldMul x (Def.neg (Def.add ny nz)))
                (Def.neg (fieldMul x (Def.add ny nz)))
                (Def.add (fieldMul x y) (fieldMul x z))
                (fieldMulNegRight x (Def.add ny nz))
                (trans!{Real} (Def.neg (fieldMul x (Def.add ny nz)))
                  (Def.neg (Def.add (fieldMul x ny) (fieldMul x nz)))
                  (Def.add (fieldMul x y) (fieldMul x z))
                  (congr!{Real Real} Def.neg _ _
                    (fieldMulAddNN x ny nz zeroX zeroNy zeroNz))
                  (trans!{Real}
                    (Def.neg (Def.add (fieldMul x ny) (fieldMul x nz)))
                    (Def.add (Def.neg (fieldMul x ny)) (Def.neg (fieldMul x nz)))
                    (Def.add (fieldMul x y) (fieldMul x z))
                    (negAdd (fieldMul x ny) (fieldMul x nz))
                    (congr2!{Real Real Real} Def.add _ _ _ _
                      (sym!{Real} _ _ (fieldMulOfNegAsNeg x y))
                      (sym!{Real} _ _ (fieldMulOfNegAsNeg x z))))))
          })
        (nonnegativeOrNegativeReal z))
    (nonnegativeOrNegativeReal y);

\definition fieldMulOfNegLeftAsNeg (x, y: Real):
  fieldMul x y = Def.neg (fieldMul (Def.neg x) y) :=
  trans!{Real} (fieldMul x y) (fieldMul (Def.neg (Def.neg x)) y)
    (Def.neg (fieldMul (Def.neg x) y))
    (congr!{Real Real} (\fun (t: Real) => fieldMul t y) _ _
      (sym!{Real} _ _ (negInvolutive x)))
    (fieldMulNegLeft (Def.neg x) y);

\definition fieldMulAdd (x, y, z: Real):
  fieldMul x (Def.add y z) = Def.add (fieldMul x y) (fieldMul x z) :=
  Logic.orElim (Le Def.zero x) (Lt x Def.zero)
    (fieldMul x (Def.add y z) = Def.add (fieldMul x y) (fieldMul x z))
    (\fun (zeroX: Le Def.zero x) => fieldMulAddN x y z zeroX)
    (\fun (negativeX: Lt x Def.zero) =>
      \block {
        \let nx: Real := Def.neg x \then
        \let zeroNx: Le Def.zero nx := nonnegativeNegOfNegative x negativeX \then
        \return trans!{Real} (fieldMul x (Def.add y z))
          (Def.neg (fieldMul nx (Def.add y z)))
          (Def.add (fieldMul x y) (fieldMul x z))
          (fieldMulOfNegLeftAsNeg x (Def.add y z))
          (trans!{Real} (Def.neg (fieldMul nx (Def.add y z)))
            (Def.neg (Def.add (fieldMul nx y) (fieldMul nx z)))
            (Def.add (fieldMul x y) (fieldMul x z))
            (congr!{Real Real} Def.neg _ _ (fieldMulAddN nx y z zeroNx))
            (trans!{Real} (Def.neg (Def.add (fieldMul nx y) (fieldMul nx z)))
              (Def.add (Def.neg (fieldMul nx y)) (Def.neg (fieldMul nx z)))
              (Def.add (fieldMul x y) (fieldMul x z))
              (negAdd (fieldMul nx y) (fieldMul nx z))
              (congr2!{Real Real Real} Def.add _ _ _ _
                (sym!{Real} _ _ (fieldMulOfNegLeftAsNeg x y))
                (sym!{Real} _ _ (fieldMulOfNegLeftAsNeg x z)))))
      })
    (nonnegativeOrNegativeReal x);

\definition notUnderlyingZeroOfPositive (x: Real) (positive: Lt Def.zero x):
  Logic.Not (underlying x = Cuts.RatLower zeroRat) :=
  \fun (same: underlying x = Cuts.RatLower zeroRat) =>
    \block {
      \takefrom q: \Cast[Rat] ({ q : Rat \where Logic.And[
          Logic.Not (mem Def.zero q), mem x q] }) \by positive \then
      \let separation: Logic.And[Logic.Not (mem Def.zero q), mem x q] :=
        \bysub(Rat, { q : Rat \where Logic.And[
          Logic.Not (mem Def.zero q), mem x q] }, q) \then
      \let qNegative: lt q zeroRat :=
        \idelim underlying x = Cuts.RatLower zeroRat
          \with L: \Pow Rat => \In[Rat] L q
          \by { base: #right{separation}, equality: same } \then
      \return #left{separation} (ofRatMem zeroRat q qNegative)
    };

\definition invNonnegativeOfPositive (x: Real) (positive: Lt Def.zero x):
  Le Def.zero (Def.inv x) :=
  \fun (q: Rat) => \fun (zeroQ: mem Def.zero q) =>
    \block {
      \takefrom t: \Cast[Rat] ({ t : Rat \where Logic.And[
          Logic.Not (mem Def.zero t), mem x t] }) \by positive \then
      \takefrom a: \Cast[Rat] ({ a : Rat \where Logic.And[
          mem x a, lt t a] }) \by #rounded{x} t
        (#right{(\bysub(Rat, { t : Rat \where Logic.And[
          Logic.Not (mem Def.zero t), mem x t] }, t))}) \then
      \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.Not (mem x b) }) \by #proper{x} \then
      \let separation: Logic.And[
          Logic.Not (mem Def.zero t), mem x t] :=
        \bysub(Rat, { t : Rat \where Logic.And[
          Logic.Not (mem Def.zero t), mem x t] }, t) \then
      \let rounded: Logic.And[mem x a, lt t a] :=
        \bysub(Rat, { a : Rat \where Logic.And[
          mem x a, lt t a] }, a) \then
      \let xb: Logic.Not (mem x b) :=
        \bysub(Rat, { b : Rat \where Logic.Not (mem x b) }, b) \then
      \let notNegativeT: Logic.Not (lt t zeroRat) :=
        \fun (negativeT: lt t zeroRat) =>
          #left{separation} (ofRatMem zeroRat t negativeT) \then
      \let aPositive: lt zeroRat a :=
        CutLaws.zeroLtOfNotNegativeLt t a notNegativeT
          #right{rounded} \then
      \let ab: lt a b :=
        CutLaws.memberLtOutside x a b #left{rounded} xb \then
      \let bPositive: lt zeroRat b :=
        RationalOrder.ltTrans zeroRat a b aPositive ab \then
      \let r: Rat := RationalOperations.reciprocal b \then
      \let law: RationalFractions.FractionEq
          (mulRat b r) oneRat :=
        RationalOperationsProp.fractionMulReciprocal b
          (RationalOperationsProp.numeratorNonZeroOfZeroLt b bPositive) \then
      \let rPositive: lt zeroRat r :=
        RationalOperationsProp.positiveOfPositiveProductOne b r
          bPositive law \then
      \let qr: lt q r :=
        RationalOrder.ltTrans q zeroRat r
          (ofRatMemLt zeroRat q zeroQ) rPositive \then
      \return invMem x q
        (Logic.Or[
          Logic.And[underlying x = Cuts.RatLower zeroRat, lt q zeroRat],
          Logic.And[Logic.Not (underlying x = Cuts.RatLower zeroRat),
            Cuts.ReciprocalBelow x q]]::right
          (Logic.And[
            Logic.Not (underlying x = Cuts.RatLower zeroRat),
            Cuts.ReciprocalBelow x q]::#
            (notUnderlyingZeroOfPositive x positive)
            (CutLaws.reciprocalBelowIntro x q a b r
              #left{rounded} xb
              (RationalOperationsProp.zeroLtMulPositive a b
                aPositive bPositive) law qr)))
    };

\definition mulInvPositiveLeOne (x: Real) (positive: Lt Def.zero x):
  Le (Def.mul (Def.inv x) x) Def.one :=
  \fun (q: Rat) => \fun (member: mem (Def.mul (Def.inv x) x) q) =>
    Logic.orElim (RationalOperations.Le zeroRat q) (lt q zeroRat)
      (mem Def.one q)
      (\fun (qNonnegative: RationalOperations.Le zeroRat q) =>
        nonnegativeMulElim (Def.inv x) x q
          (invNonnegativeOfPositive x positive)
          (CutOrder.leOfLt Def.zero x positive) qNonnegative member
          (mem Def.one q)
          (\fun (a, b: Rat) => \fun (aPositive: lt zeroRat a) =>
            \fun (inva: mem (Def.inv x) a) =>
            \fun (bPositive: lt zeroRat b) => \fun (xb: mem x b) =>
            \fun (qab: lt q (mulRat a b)) =>
              Logic.orElim
                (Logic.And[underlying x = Cuts.RatLower zeroRat,
                  lt a zeroRat])
                (Logic.And[Logic.Not (underlying x = Cuts.RatLower zeroRat),
                  Cuts.ReciprocalBelow x a])
                (mem Def.one q)
                (\fun (atZero: Logic.And[
                    underlying x = Cuts.RatLower zeroRat, lt a zeroRat]) =>
                  Logic.falseElim (mem Def.one q)
                    (RationalOrder.ltIrrefl zeroRat
                      (RationalOrder.ltTrans zeroRat a zeroRat
                        aPositive #right{atZero})))
                (\fun (away: Logic.And[
                    Logic.Not (underlying x = Cuts.RatLower zeroRat),
                    Cuts.ReciprocalBelow x a]) =>
                  CutLaws.reciprocalBelowElim x a #right{away}
                    (mem Def.one q)
                    (\fun (c, d, r: Rat) => \fun (xc: mem x c) =>
                      \fun (xd: Logic.Not (mem x d)) =>
                      \fun (_: lt zeroRat (mulRat c d)) =>
                      \fun (law: RationalFractions.FractionEq
                        (mulRat d r) oneRat) =>
                      \fun (ar: lt a r) =>
                        \block {
                          \let bd: lt b d :=
                            CutLaws.memberLtOutside x b d xb xd \then
                          \let dPositive: lt zeroRat d :=
                            RationalOrder.ltTrans zeroRat b d bPositive bd \then
                          \let rPositive: lt zeroRat r :=
                            RationalOperationsProp.positiveOfPositiveProductOne
                              d r dPositive law \then
                          \let abrd: lt (mulRat a b) (mulRat r d) :=
                            RationalOrder.ltTrans (mulRat a b)
                              (mulRat r b) (mulRat r d)
                              (RationalOperationsProp.ltMulPositiveRight
                                a r b bPositive ar)
                              (RationalOperationsProp.ltMulPositiveLeft
                                r b d rPositive bd) \then
                          \let rdOne: RationalFractions.FractionEq
                              (mulRat r d) oneRat :=
                            RationalFractions.fractionEqTrans _ _ _
                              (RationalOperationsProp.fractionMulComm r d) law \then
                          \return ofRatMem oneRat q
                            (RationalOrder.ltReplaceRight q (mulRat r d)
                              oneRat rdOne
                              (RationalOrder.ltTrans q (mulRat a b)
                                (mulRat r d) qab abrd))
                        }))
                (invMemLower x a inva)))
      (\fun (qNegative: lt q zeroRat) =>
        ofRatMem oneRat q
          (RationalOrder.ltTrans q zeroRat oneRat qNegative
            RationalOrder.zeroLtOne))
      (RationalOperationsProp.nonnegativeOrNegative q);

\definition oneLeMulInvPositive (x: Real) (positive: Lt Def.zero x):
  Le Def.one (Def.mul (Def.inv x) x) :=
  \fun (q: Rat) => \fun (oneQ: mem Def.one q) =>
    \block {
      \let qOne: lt q oneRat := ofRatMemLt oneRat q oneQ \then
      \return Logic.orElim (RationalOperations.Le zeroRat q)
        (lt q zeroRat) (mem (Def.mul (Def.inv x) x) q)
        (\fun (qNonnegative: RationalOperations.Le zeroRat q) =>
          \block {
            \takefrom t: \Cast[Rat] ({ t : Rat \where
                RationalOperations.ContractingFactorLaw[q, oneRat, t] }) \by RationalOperationsProp.contractingFactor q oneRat qOne \then
            \takefrom u: \Cast[Rat] ({ u : Rat \where Logic.And[
                Logic.Not (mem Def.zero u), mem x u] }) \by positive \then
            \takefrom a: \Cast[Rat] ({ a : Rat \where Logic.And[
                mem x a, lt u a] }) \by #rounded{x} u (#right{(\bysub(Rat,
              { u : Rat \where Logic.And[
                Logic.Not (mem Def.zero u), mem x u] }, u))}) \then
            \let tLaw: RationalOperations.ContractingFactorLaw[q, oneRat, t] :=
              \bysub(Rat, { t : Rat \where
                RationalOperations.ContractingFactorLaw[q, oneRat, t] }, t) \then
            \let separation: Logic.And[
                Logic.Not (mem Def.zero u), mem x u] :=
              \bysub(Rat, { u : Rat \where Logic.And[
                Logic.Not (mem Def.zero u), mem x u] }, u) \then
            \let rounded: Logic.And[mem x a, lt u a] :=
              \bysub(Rat, { a : Rat \where Logic.And[
                mem x a, lt u a] }, a) \then
            \let notNegativeU: Logic.Not (lt u zeroRat) :=
              \fun (uNegative: lt u zeroRat) =>
                #left{separation} (ofRatMem zeroRat u uNegative) \then
            \let aPositive: lt zeroRat a :=
              CutLaws.zeroLtOfNotNegativeLt u a notNegativeU
                #right{rounded} \then
            \let ta: lt (mulRat t a) a :=
              RationalOrder.ltReplaceRight (mulRat t a)
                (mulRat oneRat a) a
                (RationalOperationsProp.fractionMulOneLeft a)
                (RationalOperationsProp.ltMulPositiveRight t oneRat a
                  aPositive (#belowOne{tLaw})) \then
            \let adjustment: Rat :=
              RationalOperations.adjustment (mulRat t a) a \then
            \let adjustmentNegative: lt adjustment zeroRat :=
              RationalOperationsProp.adjustmentLtZero (mulRat t a) a ta \then
            \let e: Rat := negRat adjustment \then
            \let ePositive: lt zeroRat e :=
              \idelim negRat zeroRat = zeroRat
                \with z: Rat => lt z e
                \by { base:
                  RationalOperationsProp.ltNegReverse adjustment zeroRat
                    adjustmentNegative,
                  equality: RationalOperationsProp.fractionNegZero } \then
            \let base: lt (addRat (mulRat t a) e) a :=
              RationalOrder.ltReplaceRight
                (addRat (mulRat t a) e)
                (addRat (addRat a adjustment) e) a
                (RationalOperationsProp.fractionAddCancelRightSimplify
                  a adjustment)
                (RationalOperationsProp.ltAddRight (mulRat t a)
                  (addRat a adjustment) e
                  (RationalOperationsProp.ltAddAdjustment
                    (mulRat t a) a ta)) \then
            \takefrom c: \Cast[Rat] ({ c : Rat \where
                Logic.And[mem x c,
                  Logic.Not (mem x (addRat c e))] }) \by CutLaws.bracket x e ePositive \then
            \let bracketLaw: Logic.And[mem x c,
                Logic.Not (mem x (addRat c e))] :=
              \bysub(Rat, { c : Rat \where Logic.And[mem x c,
                Logic.Not (mem x (addRat c e))] }, c) \then
            \let d: Rat := addRat c e \then
            \let ad: lt a d := CutLaws.memberLtOutside x a d
              #left{rounded} #right{bracketLaw} \then
            \let dPositive: lt zeroRat d :=
              RationalOrder.ltTrans zeroRat a d aPositive ad \then
            \let tdc: lt (mulRat t d) c :=
              RationalOperationsProp.scaledBracketInterior t a c e
                (#belowOne{tLaw}) ad base \then
            \let tdPositive: lt zeroRat (mulRat t d) :=
              RationalOperationsProp.zeroLtMulPositive t d
                #positive{tLaw} dPositive \then
            \let cPositive: lt zeroRat c :=
              RationalOrder.ltTrans zeroRat (mulRat t d) c
                tdPositive tdc \then
            \let r: Rat := RationalOperations.reciprocal d \then
            \let law: RationalFractions.FractionEq
                (mulRat d r) oneRat :=
              RationalOperationsProp.fractionMulReciprocal d
                (RationalOperationsProp.numeratorNonZeroOfZeroLt d
                  dPositive) \then
            \let rPositive: lt zeroRat r :=
              RationalOperationsProp.positiveOfPositiveProductOne d r
                dPositive law \then
            \let tcr: lt t (mulRat c r) :=
              RationalOrder.ltReplaceLeft
                (mulRat (mulRat t d) r) t (mulRat c r)
                (RationalFractions.fractionEqTrans _ _ _
                  (RationalOperationsProp.fractionMulAssoc t d r)
                  (RationalFractions.fractionEqTrans _ _ _
                    (RationalOperationsProp.fractionMulRespects
                      t t (mulRat d r) oneRat
                      (RationalFractions.fractionEqRefl t) law)
                    (RationalOperationsProp.fractionMulOneRight t)))
                (RationalOperationsProp.ltMulPositiveRight
                  (mulRat t d) c r rPositive tdc) \then
            \let qt: lt q t :=
              RationalOrder.ltReplaceRight q (mulRat t oneRat) t
                (RationalOperationsProp.fractionMulOneRight t)
                (#productAbove{tLaw}) \then
            \let qcr: lt q (mulRat c r) :=
              RationalOrder.ltTrans q t (mulRat c r) qt tcr \then
            \takefrom s: \Cast[Rat] ({ s : Rat \where
                Estimates.ContractRightLaw[q, c, r, s] }) \by contractRight q c r cPositive rPositive qcr \then
            \let sLaw: Estimates.ContractRightLaw[q, c, r, s] :=
              \bysub(Rat, { s : Rat \where
                Estimates.ContractRightLaw[q, c, r, s] }, s) \then
            \let invs: mem (Def.inv x) s :=
              invMem x s
                (Logic.Or[
                  Logic.And[
                    underlying x = Cuts.RatLower zeroRat,
                    lt s zeroRat],
                  Logic.And[Logic.Not
                      (underlying x = Cuts.RatLower zeroRat),
                    Cuts.ReciprocalBelow x s]]::right
                  (Logic.And[Logic.Not
                      (underlying x = Cuts.RatLower zeroRat),
                    Cuts.ReciprocalBelow x s]::#
                    (notUnderlyingZeroOfPositive x positive)
                    (CutLaws.reciprocalBelowIntro x s c d r
                      #left{bracketLaw}
                      #right{bracketLaw}
                      (RationalOperationsProp.zeroLtMulPositive
                        c d cPositive dPositive)
                      law (#below{sLaw})))) \then
            \let qsc: lt q (mulRat s c) :=
              RationalOrder.ltReplaceRight q (mulRat c s)
                (mulRat s c)
                (RationalOperationsProp.fractionMulComm c s)
                (#productAbove{sLaw}) \then
            \return nonnegativeMulIntro (Def.inv x) x q s c
              #positive{sLaw} invs cPositive
              #left{bracketLaw} qsc
          })
        (\fun (qNegative: lt q zeroRat) =>
          (nonnegativeMul (Def.inv x) x
            (invNonnegativeOfPositive x positive)
            (CutOrder.leOfLt Def.zero x positive)) q
            (ofRatMem zeroRat q qNegative))
        (RationalOperationsProp.nonnegativeOrNegative q)
    };

\definition mulInvPositive (x: Real) (positive: Lt Def.zero x):
  Def.mul (Def.inv x) x = Def.one :=
  eqByExt (Def.mul (Def.inv x) x) Def.one
    (mulInvPositiveLeOne x positive)
    (oneLeMulInvPositive x positive);

\definition fieldMulInvPositive (x: Real) (positive: Lt Def.zero x):
  fieldMul (Def.inv x) x = Def.one :=
  trans!{Real} (fieldMul (Def.inv x) x) (Def.mul (Def.inv x) x) Def.one
    (fieldMulNN (Def.inv x) x (invNonnegativeOfPositive x positive)
      (CutOrder.leOfLt Def.zero x positive))
    (mulInvPositive x positive);

\record SignedInvSpec[x, value: Real]: \Prop := {
  nonnegative: Le Def.zero x -> value = Def.inv x,
  negative: Lt x Def.zero -> value = Def.neg (Def.inv (Def.neg x)),
};

\definition signedInvSpecNonnegative (x: Real) (zeroX: Le Def.zero x):
  SignedInvSpec[x, Def.inv x] :=
  SignedInvSpec[x, Def.inv x]::#
    (\fun (_: Le Def.zero x) => \refl(Def.inv x))
    (\fun (negativeX: Lt x Def.zero) =>
      Logic.falseElim _ ((ltNotLeReverse x Def.zero negativeX) zeroX));

\definition signedInvSpecNegative (x: Real) (negativeX: Lt x Def.zero):
  SignedInvSpec[x, Def.neg (Def.inv (Def.neg x))] :=
  SignedInvSpec[x, Def.neg (Def.inv (Def.neg x))]::#
    (\fun (zeroX: Le Def.zero x) =>
      Logic.falseElim _ ((ltNotLeReverse x Def.zero negativeX) zeroX))
    (\fun (_: Lt x Def.zero) => \refl(Def.neg (Def.inv (Def.neg x))));

\definition SignedInvCandidates (x: Real): \Pow Real :=
  { value : Real \where SignedInvSpec[x, value] };

\definition SignedInvCandidate (x: Real): \Set :=
  \Cast[Real] (SignedInvCandidates x);

\definition signedInvExists (x: Real): \exists SignedInvCandidate x :=
  Logic.orElim (Le Def.zero x) (Lt x Def.zero)
    (\exists SignedInvCandidate x)
    (\fun (zeroX: Le Def.zero x) =>
      \exact(
        \into[Real](Def.inv x, SignedInvCandidates x) \by {
          signedInvSpecNonnegative x zeroX },
        SignedInvCandidate x))
    (\fun (negativeX: Lt x Def.zero) =>
      \exact(
        \into[Real](Def.neg (Def.inv (Def.neg x)), SignedInvCandidates x) \by {
          signedInvSpecNegative x negativeX },
        SignedInvCandidate x))
    (nonnegativeOrNegativeReal x);

\definition signedInvCandidatesUnique (x: Real):
  \forall (u, v: SignedInvCandidate x) -> u = v :=
  \fun (u, v: SignedInvCandidate x) =>
    Logic.orElim (Le Def.zero x) (Lt x Def.zero) (u = v)
      (\fun (zeroX: Le Def.zero x) =>
        trans!{Real} u (Def.inv x) v
          (#nonnegative{u} zeroX)
          (sym!{Real} v (Def.inv x)
            (#nonnegative{v} zeroX)))
      (\fun (negativeX: Lt x Def.zero) =>
        trans!{Real} u (Def.neg (Def.inv (Def.neg x))) v
          (#negative{u} negativeX)
          (sym!{Real} v (Def.neg (Def.inv (Def.neg x)))
            (#negative{v} negativeX)))
      (nonnegativeOrNegativeReal x);

\definition fieldInv (x: Real): Real :=
  \choice SignedInvCandidate x
  \by { existence: signedInvExists x,
    uniqueness: signedInvCandidatesUnique x };

\definition fieldInvSpec (x: Real): SignedInvSpec[x, fieldInv x] :=
  \bysub(Real, SignedInvCandidates x,
    \choice SignedInvCandidate x
      \by { existence: signedInvExists x, uniqueness: signedInvCandidatesUnique x });

\definition fieldInvNonnegative (x: Real) (zeroX: Le Def.zero x):
  fieldInv x = Def.inv x :=
  #nonnegative{fieldInvSpec x} zeroX;

\definition fieldInvNegative (x: Real) (negativeX: Lt x Def.zero):
  fieldInv x = Def.neg (Def.inv (Def.neg x)) :=
  #negative{fieldInvSpec x} negativeX;

\definition fieldMulNegBoth (x, y: Real):
  fieldMul (Def.neg x) (Def.neg y) = fieldMul x y :=
  trans!{Real} (fieldMul (Def.neg x) (Def.neg y))
    (Def.neg (fieldMul x (Def.neg y))) (fieldMul x y)
    (fieldMulNegLeft x (Def.neg y))
    (trans!{Real} (Def.neg (fieldMul x (Def.neg y)))
      (Def.neg (Def.neg (fieldMul x y))) (fieldMul x y)
      (congr!{Real Real} Def.neg _ _ (fieldMulNegRight x y))
      (negInvolutive (fieldMul x y)));

\definition fieldInverseNonzero (x: Real)
  (nonzero: Logic.Not (x = Def.zero)): fieldMul (fieldInv x) x = Def.one :=
  Logic.orElim (Lt Def.zero x) (Logic.Or[Def.zero = x, Lt x Def.zero])
    (fieldMul (fieldInv x) x = Def.one)
    (\fun (positive: Lt Def.zero x) =>
      trans!{Real} (fieldMul (fieldInv x) x)
        (fieldMul (Def.inv x) x) Def.one
        (congr!{Real Real} (\fun (t: Real) => fieldMul t x) _ _
          (fieldInvNonnegative x (CutOrder.leOfLt Def.zero x positive)))
        (fieldMulInvPositive x positive))
    (\fun (rest: Logic.Or[Def.zero = x, Lt x Def.zero]) =>
      Logic.orElim (Def.zero = x) (Lt x Def.zero)
        (fieldMul (fieldInv x) x = Def.one)
        (\fun (same: Def.zero = x) =>
          Logic.falseElim (fieldMul (fieldInv x) x = Def.one)
            (nonzero (sym!{Real} Def.zero x same)))
        (\fun (negative: Lt x Def.zero) =>
          \block {
            \let nx: Real := Def.neg x \then
            \let positiveNx: Lt Def.zero nx :=
              ltReplaceLeft (Def.neg Def.zero) Def.zero nx negZero
                (negStrictAntitone x Def.zero negative) \then
            \return trans!{Real} (fieldMul (fieldInv x) x)
              (fieldMul (Def.neg (Def.inv nx)) (Def.neg nx)) Def.one
              (congr2!{Real Real Real} fieldMul _ _ _ _
                (fieldInvNegative x negative)
                (sym!{Real} _ _ (negInvolutive x)))
              (trans!{Real} (fieldMul (Def.neg (Def.inv nx)) (Def.neg nx))
                (fieldMul (Def.inv nx) nx) Def.one
                (fieldMulNegBoth (Def.inv nx) nx)
                (fieldMulInvPositive nx positiveNx))
          }) rest)
    (CutOrder.ltTrichotomy Def.zero x);

\import std.Alg[].Alg[] \as Algebra;
\import std.Alg[].Monoid[] \as Monoid;

\definition CommutativeGroup: \Set := Algebra.CommutativeGroup[Real]::[Set];

\definition additiveRaw: Algebra.Group[Real]::[Raw] :=
  Algebra.Group[Real]::[Raw]::# Def.zero Def.add Def.neg;

\definition additiveGroupLaws: Algebra.Group[Real]::[Law][additiveRaw] :=
  Algebra.Group[Real]::[Law][additiveRaw] {
    monoid := Monoid.Monoid[Real]::[Law][Algebra.groupMonoid Real additiveRaw] {
      leftIdentity := addZeroLeft,
      rightIdentity := addZeroRight,
      associative := addAssoc,
    },
    leftInverse := addNegLeft,
    rightInverse := addNegRight,
  };

\definition additiveGroup: Algebra.Group[Real]::[Set] :=
  \into[Algebra.Group[Real]::[Raw]](additiveRaw, Algebra.Group[Real]) \by { additiveGroupLaws };

\definition additiveCommutativeGroupLaws:
  Algebra.CommutativeGroup[Real]::[Law][Algebra.CommutativeGroup[Real]::[Raw]::# (additiveRaw)] :=
  Algebra.CommutativeGroup[Real]::[Law][Algebra.CommutativeGroup[Real]::[Raw]::# (additiveRaw)] {
    group := additiveGroupLaws,
    commutative := addComm,
  };

\definition additiveCommutativeGroup: Algebra.CommutativeGroup[Real]::[Set] :=
  \into[Algebra.CommutativeGroup[Real]::[Raw]](Algebra.CommutativeGroup[Real]::[Raw]::# (additiveRaw), Algebra.CommutativeGroup[Real])
    \by { additiveCommutativeGroupLaws };
