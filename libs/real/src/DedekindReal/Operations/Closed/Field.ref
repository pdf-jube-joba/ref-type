\import \parent.\parent.\parent.Order[] \as CutOrder;
\import real.AxiomaticReals[Carrier := Real] \as AR;
\import \parent.Laws[] \as Laws;
\import std.Logic[].Proposition[] \as Logic;

\definition raw: AR.AxiomaticRealStructure::[Raw] :=
  CutOrder.withOrder zero one add neg Laws.fieldMul Laws.fieldInv;

\definition linearOrder: AR.LinearOrderLaws[#leRelation{raw}] :=
  CutOrder.linearOrder zero one add neg Laws.fieldMul Laws.fieldInv;

\definition completeness: AR.Completeness raw :=
  CutOrder.completeness zero one add neg Laws.fieldMul Laws.fieldInv;

\definition fieldLaws: AR.FieldLaws[#zero{raw}, #one{raw}, #add{raw}, #neg{raw}, #mul{raw}, #inv{raw}] :=
  AR.FieldLaws[#zero{raw}, #one{raw}, #add{raw}, #neg{raw}, #mul{raw}, #inv{raw}]::#
    Laws.zeroNeOne
    Laws.addZeroLeft
    Laws.addNegLeft
    Laws.addComm
    Laws.addAssoc
    Laws.fieldMulOneLeft
    Laws.fieldMulComm
    Laws.fieldMulAssoc
    Laws.fieldMulAdd
    Laws.fieldInverseNonzero;

\definition orderedFieldLaws: AR.OrderedFieldLaws[#zero{raw}, #add{raw}, #mul{raw}, #leRelation{raw}] :=
  AR.OrderedFieldLaws[#zero{raw}, #add{raw}, #mul{raw}, #leRelation{raw}]::#
    Laws.addMonotoneLeft
    Laws.fieldMulNonnegative;

\definition axiomaticLaws: AR.AxiomaticRealStructure::[Law][raw] :=
  AR.AxiomaticRealStructure::[Law][raw] {
    field := fieldLaws,
    order := linearOrder,
    orderedField := orderedFieldLaws,
    completeness := completeness,
  };

\definition axiomaticReal: AR.AxiomaticRealStructure::[Set] :=
  \into[AR.AxiomaticRealStructure::[Raw]]
    (raw, AR.AxiomaticRealStructure) \by { axiomaticLaws };
