
\definition RatLower(a: Rat): \Pow Rat := { q : Rat \where lt q a };

\structure SumWitness[x, y: Real, q, a, b: Rat]: \Prop := {
  leftMember: mem x a,
  rightMember: mem y b,
  below: lt q (addRat a b),
};

\definition SumMember(x, y: Real) (q: Rat): \Prop :=
  \forall (P: \Prop) ->
    (\forall (a, b: Rat) -> SumWitness[x, y, q, a, b] -> P) -> P;

\definition SumLower(x, y: Real): \Pow Rat :=
  { q : Rat \where SumMember x y q };

\definition NegLower(x: Real): \Pow Rat :=
    { q : Rat \where \exists { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] } };

/* Use both endpoints of rational intervals. Multiplying arbitrary lower
 * bounds alone gives an unbounded set even for zero times zero. */
\definition ProductBelow(x, y: Real) (q: Rat): \Prop :=
  \forall (P: \Prop) ->
    (\forall (a, b, c, d: Rat) ->
      mem x a -> Logic.Not (mem x b) ->
      mem y c -> Logic.Not (mem y d) ->
      lt q (mulRat a c) -> lt q (mulRat a d) ->
      lt q (mulRat b c) -> lt q (mulRat b d) -> P) -> P;

\definition MulLower(x, y: Real): \Pow Rat :=
  { q : Rat \where ProductBelow x y q };

\definition productBelowIntro(x, y: Real) (q, a, b, c, d: Rat):
  mem x a -> Logic.Not (mem x b) -> mem y c ->
  Logic.Not (mem y d) -> lt q (mulRat a c) ->
  lt q (mulRat a d) -> lt q (mulRat b c) ->
  lt q (mulRat b d) -> \forall (P: \Prop) ->
  (\forall (a, b, c, d: Rat) ->
    mem x a -> Logic.Not (mem x b) -> mem y c -> Logic.Not (mem y d) ->
    lt q (mulRat a c) -> lt q (mulRat a d) ->
    lt q (mulRat b c) -> lt q (mulRat b d) -> P) ->
  P :=
  \fun (xa: _) (xb: _) (yc: _) (yd: _) (ac: _) (ad: _) (bc: _) (bd: _) (P: \Prop) (use: _) =>
    use a b c d xa xb yc yd ac ad bc bd;

/* Away from zero, reciprocal reverses each interval whose endpoints have
 * the same sign. A rational reciprocal is specified by b*r = 1.
 * The first disjunct fixes the convention inv 0 = 0. */
\definition ReciprocalBelow(x: Real) (q: Rat): \Prop :=
  \forall (P: \Prop) ->
    (\forall (a, b, r: Rat) -> mem x a -> Logic.Not (mem x b) ->
      lt zeroRat (mulRat a b) ->
      RationalFractions.FractionEq (mulRat b r) oneRat -> lt q r -> P) -> P;
\definition InvLower(x: Real): \Pow Rat :=
  { q : Rat \where Logic.Or[
    Logic.And[underlying x = RatLower zeroRat, lt q zeroRat],
    Logic.And[Logic.Not (underlying x = RatLower zeroRat),
      ReciprocalBelow x q]] };
