\use Logic.either;
\import \parent.Def[] \as Def;

\import std.Arithmetic[].Rat[].Estimates[] \as Estimates;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\import std.Data[].Nat[] \as Natural;
\import std.Data[].Nat[].Basic[].Def[] \as NaturalOperation;
\import std.Data[].Nat[].Order[].Prop[] \as NatOrder;
\import RationalFractions.Order[] \as RationalOrder;
\import \parent.\parent.Order[] \as CutOrder;

\definition AdjacentBoundary (P: Natural.Nat^ -> \Prop): \Prop :=
  NatOrder.AdjacentBoundary P;
\definition finiteBoundary (P: Natural.Nat^ -> \Prop):
  \forall (n: Natural.Nat^) -> P Natural.Nat^::zero ->
    Logic.Not (P n) -> AdjacentBoundary P :=
  NatOrder.finiteBoundary P;

\definition lowerLocated (L: \Pow Rat) (lower: Lower L): Located L :=
  \fun (p, q: Rat) => \fun (pq: lt p q) =>
    either!{
      {In L p} "or" {Logic.Not (In L p)} "either" {Logic.Or[In L p, Logic.Not (In L q)]}
      "lt:" {\fun (lp: In L p) =>
        Logic.Or[In L p, Logic.Not (In L q)]::left lp}
      "rt:" {\fun (np: Logic.Not (In L p)) =>
        Logic.Or[In L p, Logic.Not (In L q)]::right
          (\fun (lq: In L q) => np (lower p q pq lq))}
    }
      (Classical.excludedMiddle (In L p));

\definition ratLowerInhabited (a: Rat): Inhabited (Def.RatLower a) :=
  \exact(
    \into[Rat](RationalOperations.below a, { q : Rat \where In (Def.RatLower a) q }) \by { RationalOperationsProp.belowLt a },
    \Cast[Rat] ({ q : Rat \where In (Def.RatLower a) q }));

\definition ratLowerProper (a: Rat): Proper (Def.RatLower a) :=
  \exact(
    \into[Rat](a, { q : Rat \where Logic.Not (In (Def.RatLower a) q) }) \by { RationalOrder.ltIrrefl a },
    \Cast[Rat] ({ q : Rat \where Logic.Not (In (Def.RatLower a) q) }));

\definition ratLowerLower (a: Rat): Lower (Def.RatLower a) :=
  \fun (p, q: Rat) => \fun (pq: lt p q) => \fun (qa: lt q a) =>
    RationalOrder.ltTrans p q a pq qa;

\definition ratLowerRounded (a: Rat): Rounded (Def.RatLower a) :=
  \fun (p: Rat) => \fun (pa: lt p a) =>
    \exact(
      \into[Rat](RationalOperations.midpoint p a, { q : Rat \where Logic.And[In (Def.RatLower a) q, lt p q] }) \by { Logic.And[
          In (Def.RatLower a) (RationalOperations.midpoint p a),
          lt p (RationalOperations.midpoint p a)]::# (RationalOperationsProp.midpointLt p a pa) (RationalOperationsProp.ltMidpoint p a pa) },
      \Cast[Rat] ({ q : Rat \where Logic.And[In (Def.RatLower a) q, lt p q] }));

\definition ratLowerRespects (a: Rat): RespectsFractionEq (Def.RatLower a) :=
  \fun (p, q: Rat) =>
    \fun (pq: RationalFractions.FractionEq p q) =>
      \fun (pa: lt p a) =>
        RationalOrder.ltReplaceLeft p q a pq pa;

\definition ratCut (a: Rat): IsCut[Def.RatLower a] :=
  IsCut[Def.RatLower a] {
    inhabited := ratLowerInhabited a,
    proper := ratLowerProper a,
    lower := ratLowerLower a,
    rounded := ratLowerRounded a,
    located := lowerLocated (Def.RatLower a) (ratLowerLower a),
    respects := ratLowerRespects a,
  };

\definition memberLtOutside (x: Real) (a, b: Rat)
  (xa: mem x a) (xb: Logic.Not (mem x b)): lt a b :=
  either!{
    {lt a b} "or" {Logic.Or[RationalFractions.FractionEq a b, lt b a]} "either" {lt a b}
    "lt:" {\fun (ab: lt a b) => ab}
    "rt:" {\fun (rest: Logic.Or[RationalFractions.FractionEq a b, lt b a]) =>
      either!{
        {RationalFractions.FractionEq a b} "or" {lt b a} "either" {lt a b}
        "lt:" {\fun (ab: RationalFractions.FractionEq a b) =>
          Logic.falseElim (lt a b) (xb (#respects{x} a b ab xa))}
        "rt:" {\fun (ba: lt b a) =>
          Logic.falseElim (lt a b) (xb (#lower{x} b a ba xa))}
      }
        rest}
  }
    (RationalOrder.trichotomy a b);

\definition GridPredicate (x: Real) (a, e: Rat): Natural.Nat^ -> \Prop :=
  \fun (n: Natural.Nat^) => mem x (RationalOperations.grid a e n);

\definition GridBoundaryAt (x: Real) (a, e: Rat): \Prop :=
  AdjacentBoundary (GridPredicate x a e);

\definition GridBoundaryWitnesses (x: Real) (e: Rat): \Pow Rat :=
  { a : Rat \where GridBoundaryAt x a e };

\definition GridBoundary (x: Real) (e: Rat): \Prop :=
  \exists \Cast[Rat] (GridBoundaryWitnesses x e);

\definition gridBoundary (x: Real) (e: Rat) (positive: lt zeroRat e):
  GridBoundary x e :=
  \block {
    \takefrom a: \Cast[Rat] ({ a : Rat \where mem x a }) \by #inhabited{x} \then
    \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.Not (mem x b) }) \by #proper{x} \then
    \takefrom n: \Cast[Natural.Nat^] ({ n : Natural.Nat^ \where lt b (RationalOperations.naturalTranslate a e n) }) \by RationalOperationsProp.naturalTranslateAbove a e b positive \then
    \let P: Natural.Nat^ -> \Prop := GridPredicate x a e \then
    \let xa: mem x a :=
      \bysub(Rat, { a : Rat \where mem x a }, a) \then
    \let xb: Logic.Not (mem x b) :=
      \bysub(Rat, { b : Rat \where Logic.Not (mem x b) }, b) \then
    \let farReduced:
        lt b (RationalOperations.naturalTranslate a e n) :=
      \bysub(Natural.Nat^,
        { n : Natural.Nat^ \where lt b (RationalOperations.naturalTranslate a e n) }, n) \then
    \let far: lt b (RationalOperations.grid a e n) :=
      RationalOrder.ltReplaceRight b
        (RationalOperations.naturalTranslate a e n)
        (RationalOperations.grid a e n)
        (RationalOperationsProp.naturalTranslateAsGrid a e n)
        farReduced \then
    \let atZero: P Natural.Nat^::zero :=
      #respects{x} a
        (RationalOperations.grid a e Natural.Nat^::zero)
        (RationalFractions.fractionEqSym _ _
          (RationalOperationsProp.gridZero a e)) xa \then
    \let notAtN: Logic.Not (P n) :=
      \fun (atN: P n) => xb
        (#lower{x} b (RationalOperations.grid a e n) far atN) \then
    \let boundary: AdjacentBoundary P :=
      finiteBoundary P n atZero notAtN \then
    \return \exact(
      \into[Rat](a, GridBoundaryWitnesses x e) \by { boundary },
      \Cast[Rat] (GridBoundaryWitnesses x e))
  };

\definition Bracketed (x: Real) (e: Rat): \Prop :=
  \exists { a : Rat \where Logic.And[mem x a, Logic.Not (mem x (addRat a e))] };

\definition bracket (x: Real) (e: Rat) (positive: lt zeroRat e):
  Bracketed x e :=
  \block {
    \takefrom base: \Cast[Rat] (GridBoundaryWitnesses x e) \by gridBoundary x e positive \then
    \takefrom k: \Cast[Natural.Nat^] ({ k : Natural.Nat^ \where Logic.And[GridPredicate x base e k,
          Logic.Not (GridPredicate x base e (Natural.Nat^::succ k))] }) \by \bysub(Rat, GridBoundaryWitnesses x e, base) \then
    \let a: Rat := RationalOperations.grid base e k \then
    \let next: Rat :=
      RationalOperations.grid base e (Natural.Nat^::succ k) \then
    \let xa: mem x a :=
      #left{(\bysub(Natural.Nat^,
          { k : Natural.Nat^ \where Logic.And[GridPredicate x base e k,
              Logic.Not (GridPredicate x base e
                (Natural.Nat^::succ k))] }, k))} \then
    \let outsideNext: Logic.Not (mem x next) :=
      #right{(\bysub(Natural.Nat^,
          { k : Natural.Nat^ \where Logic.And[GridPredicate x base e k,
              Logic.Not (GridPredicate x base e
                (Natural.Nat^::succ k))] }, k))} \then
    \let outside: Logic.Not (mem x (addRat a e)) :=
      \fun (inside: mem x (addRat a e)) =>
        outsideNext
          (#respects{x} (addRat a e) next
            (RationalFractions.fractionEqSym _ _
              (RationalOperationsProp.gridSucc base e k)) inside) \then
    \return \exact(
      \into[Rat](a, { a : Rat \where Logic.And[mem x a, Logic.Not (mem x (addRat a e))] }) \by { Logic.And[mem x a,
          Logic.Not (mem x (addRat a e))]::# xa outside },
      \Cast[Rat] ({ a : Rat \where Logic.And[mem x a, Logic.Not (mem x (addRat a e))] }))
  };

\definition sumIntro (x, y: Real) (q, a, b: Rat)
  (xa: mem x a) (yb: mem y b) (qab: lt q (addRat a b)):
  In (Def.SumLower x y) q :=
  \exact(
    \into[Rat](a, { a : Rat \where Logic.And[mem x a,
          \exists { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }] }) \by { Logic.And[mem x a,
        \exists { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }]::# xa (\exact(
          \into[Rat](b, { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }) \by { Logic.And[mem y b, lt q (addRat a b)]::# yb qab },
          \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }))) },
    \Cast[Rat] ({ a : Rat \where Logic.And[mem x a,
        \exists { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }] }));

\definition sumElim (x, y: Real) (q: Rat) (member: In (Def.SumLower x y) q)
  (P: \Prop)
  (use: \forall (a, b: Rat) ->
    mem x a -> mem y b -> lt q (addRat a b) -> P): P :=
  \block {
    \takefrom a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a,
          \exists { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }] }) \by member \then
    \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }) \by #right{(\bysub(Rat,
        { a : Rat \where Logic.And[mem x a,
            \exists { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }] }, a))} \then
    \return use a b
        (#left{(\bysub(Rat,
            { a : Rat \where Logic.And[mem x a,
                \exists { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }] }, a))})
        (#left{(\bysub(Rat,
            { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }, b))})
        (#right{(\bysub(Rat,
            { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }, b))})
  };

\definition sumContainsAdd (x, y: Real) (a, b: Rat)
  (xa: mem x a) (yb: mem y b): In (Def.SumLower x y) (addRat a b) :=
  \block {
    \takefrom a2: \Cast[Rat] ({ a2 : Rat \where Logic.And[mem x a2, lt a a2] }) \by #rounded{x} a xa \then
    \takefrom b2: \Cast[Rat] ({ b2 : Rat \where Logic.And[mem y b2, lt b b2] }) \by #rounded{y} b yb \then
    \return sumIntro x y (addRat a b) a2 b2
        (#left{(\bysub(Rat,
            { a2 : Rat \where Logic.And[mem x a2, lt a a2] }, a2))})
        (#left{(\bysub(Rat,
            { b2 : Rat \where Logic.And[mem y b2, lt b b2] }, b2))})
        (RationalOperationsProp.ltAdd a a2 b b2
          (#right{(\bysub(Rat,
              { a2 : Rat \where Logic.And[mem x a2, lt a a2] }, a2))})
          (#right{(\bysub(Rat,
              { b2 : Rat \where Logic.And[mem y b2, lt b b2] }, b2))}))
  };

\definition sumInhabited (x, y: Real): Inhabited (Def.SumLower x y) :=
  \block {
    \takefrom a: \Cast[Rat] ({ a : Rat \where mem x a }) \by #inhabited{x} \then
    \takefrom b: \Cast[Rat] ({ b : Rat \where mem y b }) \by #inhabited{y} \then
    \return \exact(
        \into[Rat](RationalOperations.below (addRat a b), { q : Rat \where In (Def.SumLower x y) q }) \by { sumIntro x y (RationalOperations.below (addRat a b)) a b
            (\bysub(Rat, { a : Rat \where mem x a }, a))
            (\bysub(Rat, { b : Rat \where mem y b }, b))
            (RationalOperationsProp.belowLt (addRat a b)) },
        \Cast[Rat] ({ q : Rat \where In (Def.SumLower x y) q }))
  };

\definition sumProperAt (x, y: Real) (u, v: Rat)
  (xu: Logic.Not (mem x u)) (yv: Logic.Not (mem y v)):
  Logic.Not (In (Def.SumLower x y) (addRat u v)) :=
  \fun (member: In (Def.SumLower x y) (addRat u v)) =>
    \block {
      \takefrom a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a,
            \exists { b : Rat \where Logic.And[mem y b,
                  lt (addRat u v) (addRat a b)] }] }) \by member \then
      \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt (addRat u v) (addRat a b)] }) \by #right{(\bysub(Rat,
          { a : Rat \where Logic.And[mem x a,
              \exists { b : Rat \where Logic.And[mem y b,
                    lt (addRat u v) (addRat a b)] }] }, a))} \then
      \return (\block {
          \let xa: mem x a :=
            #left{(\bysub(Rat,
                { a : Rat \where Logic.And[mem x a,
                    \exists { b : Rat \where Logic.And[mem y b,
                          lt (addRat u v) (addRat a b)] }] }, a))} \then
          \let yb: mem y b :=
            #left{(\bysub(Rat,
                { b : Rat \where Logic.And[mem y b,
                    lt (addRat u v) (addRat a b)] }, b))} \then
          \let boundLt: lt (addRat u v) (addRat a b) :=
            #right{(\bysub(Rat,
                { b : Rat \where Logic.And[mem y b,
                    lt (addRat u v) (addRat a b)] }, b))} \then
          \return RationalOrder.ltIrrefl (addRat u v)
            (RationalOrder.ltTrans
              (addRat u v) (addRat a b) (addRat u v) boundLt
              (RationalOperationsProp.ltAdd a u b v
                (memberLtOutside x a u xa xu)
                (memberLtOutside y b v yb yv)))
        })
    };

\definition sumProper (x, y: Real): Proper (Def.SumLower x y) :=
  \block {
    \takefrom u: \Cast[Rat] ({ u : Rat \where Logic.Not (mem x u) }) \by #proper{x} \then
    \takefrom v: \Cast[Rat] ({ v : Rat \where Logic.Not (mem y v) }) \by #proper{y} \then
    \return \exact(
        \into[Rat](addRat u v, { q : Rat \where Logic.Not (In (Def.SumLower x y) q) }) \by { sumProperAt x y u v
            (\bysub(Rat, { u : Rat \where Logic.Not (mem x u) }, u))
            (\bysub(Rat, { v : Rat \where Logic.Not (mem y v) }, v)) },
        \Cast[Rat] ({ q : Rat \where Logic.Not (In (Def.SumLower x y) q) }))
  };

\definition sumLower (x, y: Real): Lower (Def.SumLower x y) :=
  \fun (p, q: Rat) => \fun (pq: lt p q) =>
    \fun (member: In (Def.SumLower x y) q) =>
      \block {
        \takefrom a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a,
              \exists { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }] }) \by member \then
        \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }) \by #right{(\bysub(Rat,
            { a : Rat \where Logic.And[mem x a,
                \exists { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }] }, a))} \then
        \return sumIntro x y p a b
            (#left{(\bysub(Rat,
                { a : Rat \where Logic.And[mem x a,
                    \exists { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }] }, a))})
            (#left{(\bysub(Rat,
                { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }, b))})
            (RationalOrder.ltTrans p q (addRat a b) pq
              (#right{(\bysub(Rat,
                  { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }, b))}))
      };

\definition sumRounded (x, y: Real): Rounded (Def.SumLower x y) :=
  \fun (q: Rat) => \fun (member: In (Def.SumLower x y) q) =>
    \block {
      \takefrom a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a,
            \exists { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }] }) \by member \then
      \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }) \by #right{(\bysub(Rat,
          { a : Rat \where Logic.And[mem x a,
              \exists { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }] }, a))} \then
      \return (\block {
          \let xa: mem x a :=
            #left{(\bysub(Rat,
                { a : Rat \where Logic.And[mem x a,
                    \exists { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }] }, a))} \then
          \let yb: mem y b :=
            #left{(\bysub(Rat,
                { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }, b))} \then
          \let qab: lt q (addRat a b) :=
            #right{(\bysub(Rat,
                { b : Rat \where Logic.And[mem y b, lt q (addRat a b)] }, b))} \then
          \let r: Rat := RationalOperations.midpoint q (addRat a b) \then
          \return \exact(
            \into[Rat](r, { r : Rat \where Logic.And[In (Def.SumLower x y) r, lt q r] }) \by { Logic.And[In (Def.SumLower x y) r, lt q r]::# (sumIntro x y r a b xa yb
                  (RationalOperationsProp.midpointLt q (addRat a b) qab)) (RationalOperationsProp.ltMidpoint q (addRat a b) qab) },
            \Cast[Rat] ({ r : Rat \where Logic.And[In (Def.SumLower x y) r, lt q r] }))
        })
    };

\definition sumRespects (x, y: Real): RespectsFractionEq (Def.SumLower x y) :=
  \fun (p, q: Rat) =>
    \fun (pq: RationalFractions.FractionEq p q) =>
      \fun (member: In (Def.SumLower x y) p) =>
        \block {
          \takefrom a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a,
                \exists { b : Rat \where Logic.And[mem y b, lt p (addRat a b)] }] }) \by member \then
          \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.And[mem y b, lt p (addRat a b)] }) \by #right{(\bysub(Rat,
              { a : Rat \where Logic.And[mem x a,
                  \exists { b : Rat \where Logic.And[mem y b, lt p (addRat a b)] }] }, a))} \then
          \return sumIntro x y q a b
              (#left{(\bysub(Rat,
                  { a : Rat \where Logic.And[mem x a,
                      \exists { b : Rat \where Logic.And[mem y b, lt p (addRat a b)] }] }, a))})
              (#left{(\bysub(Rat,
                  { b : Rat \where Logic.And[mem y b, lt p (addRat a b)] }, b))})
              (RationalOrder.ltReplaceLeft p q (addRat a b) pq
                (#right{(\bysub(Rat,
                    { b : Rat \where Logic.And[mem y b, lt p (addRat a b)] }, b))}))
        };

\definition sumCut (x, y: Real): IsCut[Def.SumLower x y] :=
  IsCut[Def.SumLower x y] {
    inhabited := sumInhabited x y,
    proper := sumProper x y,
    lower := sumLower x y,
    rounded := sumRounded x y,
    located := lowerLocated (Def.SumLower x y) (sumLower x y),
    respects := sumRespects x y,
  };

\definition negIntro (x: Real) (q, r: Rat)
  (xr: Logic.Not (mem x r)) (qr: lt q (negRat r)):
  In (Def.NegLower x) q :=
  \exact(
    \into[Rat](r, { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }) \by { Logic.And[Logic.Not (mem x r), lt q (negRat r)]::# xr qr },
    \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }));

\definition negElim (x: Real) (q: Rat) (member: In (Def.NegLower x) q)
  (P: \Prop)
  (use: \forall (r: Rat) ->
    Logic.Not (mem x r) -> lt q (negRat r) -> P): P :=
  \block {
    \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }) \by member \then
    \let xr: Logic.Not (mem x r) :=
      #left{(\bysub(Rat,
          { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r))} \then
    \let qr: lt q (negRat r) :=
      #right{(\bysub(Rat,
          { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r))} \then
    \return use r xr qr
  };

\definition negInhabited (x: Real): Inhabited (Def.NegLower x) :=
  \block {
    \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.Not (mem x r) }) \by #proper{x} \then
    \return \exact(
        \into[Rat](RationalOperations.below (negRat r), { q : Rat \where In (Def.NegLower x) q }) \by { negIntro x (RationalOperations.below (negRat r)) r
            (\bysub(Rat, { r : Rat \where Logic.Not (mem x r) }, r))
            (RationalOperationsProp.belowLt (negRat r)) },
        \Cast[Rat] ({ q : Rat \where In (Def.NegLower x) q }))
  };

\definition negProperAt (x: Real) (a: Rat) (xa: mem x a):
  Logic.Not (In (Def.NegLower x) (negRat a)) :=
  \fun (member: In (Def.NegLower x) (negRat a)) =>
    \block {
      \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt (negRat a) (negRat r)] }) \by member \then
      \return (#left{(\bysub(Rat,
            { r : Rat \where Logic.And[Logic.Not (mem x r),
                lt (negRat a) (negRat r)] }, r))})
          (#lower{x} r a
            (RationalOperationsProp.ltOfNegLtNeg a r
              (#right{(\bysub(Rat,
                  { r : Rat \where Logic.And[Logic.Not (mem x r),
                      lt (negRat a) (negRat r)] }, r))})) xa)
    };

\definition negProper (x: Real): Proper (Def.NegLower x) :=
  \block {
    \takefrom a: \Cast[Rat] ({ a : Rat \where mem x a }) \by #inhabited{x} \then
    \return \exact(
        \into[Rat](negRat a, { q : Rat \where Logic.Not (In (Def.NegLower x) q) }) \by { negProperAt x a (\bysub(Rat, { a : Rat \where mem x a }, a)) },
        \Cast[Rat] ({ q : Rat \where Logic.Not (In (Def.NegLower x) q) }))
  };

\definition negLower (x: Real): Lower (Def.NegLower x) :=
  \fun (p, q: Rat) => \fun (pq: lt p q) =>
    \fun (member: In (Def.NegLower x) q) =>
      \block {
        \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }) \by member \then
        \return negIntro x p r
            (#left{(\bysub(Rat,
                { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r))})
            (RationalOrder.ltTrans p q (negRat r) pq
              (#right{(\bysub(Rat,
                  { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r))}))
      };

\definition negRounded (x: Real): Rounded (Def.NegLower x) :=
  \fun (q: Rat) => \fun (member: In (Def.NegLower x) q) =>
    \block {
      \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }) \by member \then
      \let xr: Logic.Not (mem x r) :=
        #left{(\bysub(Rat,
            { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r))} \then
      \let qr: lt q (negRat r) :=
        #right{(\bysub(Rat,
            { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r))} \then
      \let p: Rat := RationalOperations.midpoint q (negRat r) \then
      \return \exact(
        \into[Rat](p, { p : Rat \where Logic.And[In (Def.NegLower x) p, lt q p] }) \by { Logic.And[In (Def.NegLower x) p, lt q p]::# (negIntro x p r xr
              (RationalOperationsProp.midpointLt q (negRat r) qr)) (RationalOperationsProp.ltMidpoint q (negRat r) qr) },
        \Cast[Rat] ({ p : Rat \where Logic.And[In (Def.NegLower x) p, lt q p] }))
    };

\definition negRespects (x: Real): RespectsFractionEq (Def.NegLower x) :=
  \fun (p, q: Rat) =>
    \fun (pq: RationalFractions.FractionEq p q) =>
      \fun (member: In (Def.NegLower x) p) =>
        \block {
          \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt p (negRat r)] }) \by member \then
          \return negIntro x q r
              (#left{(\bysub(Rat,
                  { r : Rat \where Logic.And[Logic.Not (mem x r), lt p (negRat r)] }, r))})
              (RationalOrder.ltReplaceLeft p q (negRat r) pq
                (#right{(\bysub(Rat,
                    { r : Rat \where Logic.And[Logic.Not (mem x r), lt p (negRat r)] }, r))}))
        };

\definition negCut (x: Real): IsCut[Def.NegLower x] :=
  IsCut[Def.NegLower x] {
    inhabited := negInhabited x,
    proper := negProper x,
    lower := negLower x,
    rounded := negRounded x,
    located := lowerLocated (Def.NegLower x) (negLower x),
    respects := negRespects x,
  };

/* Rational density packaged for the finite endpoint arguments used below. */
\definition BelowBoth (a, b: Rat): \Prop := Estimates.BelowBoth a b;

\definition belowBoth (a, b: Rat): BelowBoth a b := Estimates.belowBoth a b;

\definition AboveBoth (a, b: Rat): \Prop := Estimates.AboveBoth a b;

\definition aboveBoth (a, b: Rat): AboveBoth a b := Estimates.aboveBoth a b;

\record SymmetricBoundLaw[x: Real, u: Rat]: \Prop := {
  positive: lt zeroRat u,
  inside: mem x (negRat u),
  outside: Logic.Not (mem x u),
};

\definition SymmetricBound (x: Real): \Prop :=
  \exists { u : Rat \where SymmetricBoundLaw[x, u] };

\definition symmetricBound (x: Real): SymmetricBound x :=
  \block {
    \takefrom a: \Cast[Rat] ({ a : Rat \where mem x a }) \by #inhabited{x} \then
    \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.Not (mem x b) }) \by #proper{x} \then
    \takefrom u: \Cast[Rat] ({ u : Rat \where Logic.And[lt (negRat a) u, lt b u] }) \by aboveBoth (negRat a) b \then
    \takefrom v: \Cast[Rat] ({ v : Rat \where Logic.And[lt u v, lt zeroRat v] }) \by aboveBoth u zeroRat \then
    \let nua: lt (negRat a) v :=
      RationalOrder.ltTrans (negRat a) u v
        (#left{(\bysub(Rat, { u : Rat \where Logic.And[lt (negRat a) u, lt b u] }, u))})
        (#left{(\bysub(Rat, { v : Rat \where Logic.And[lt u v, lt zeroRat v] }, v))}) \then
    \let nva: lt (negRat v) a :=
      RationalOrder.ltReplaceRight (negRat v)
        (negRat (negRat a)) a
        (RationalOperationsProp.fractionNegInvolutive a)
        (RationalOperationsProp.ltNegReverse (negRat a) v nua) \then
    \let bv: lt b v :=
      RationalOrder.ltTrans b u v
        (#right{(\bysub(Rat, { u : Rat \where Logic.And[lt (negRat a) u, lt b u] }, u))})
        (#left{(\bysub(Rat, { v : Rat \where Logic.And[lt u v, lt zeroRat v] }, v))}) \then
    \let inside: mem x (negRat v) :=
      #lower{x} (negRat v) a nva
        (\bysub(Rat, { a : Rat \where mem x a }, a)) \then
    \let outside: Logic.Not (mem x v) :=
      \fun (xv: mem x v) =>
        (\bysub(Rat, { b : Rat \where Logic.Not (mem x b) }, b))
          (#lower{x} b v bv xv) \then
    \return \exact(
      \into[Rat](v, { v : Rat \where SymmetricBoundLaw[x, v] }) \by { SymmetricBoundLaw[x, v]::#
          (#right{(\bysub(Rat, { v : Rat \where Logic.And[lt u v, lt zeroRat v] }, v))}) inside outside },
      \Cast[Rat] ({ v : Rat \where SymmetricBoundLaw[x, v] }))
  };

\definition productBelowElim (x, y: Real) (q: Rat)
  (member: Def.ProductBelow x y q) (P: \Prop)
  (use: \forall (a, b, c, d: Rat) ->
    mem x a -> Logic.Not (mem x b) ->
    mem y c -> Logic.Not (mem y d) ->
    lt q (mulRat a c) -> lt q (mulRat a d) ->
    lt q (mulRat b c) -> lt q (mulRat b d) -> P): P :=
  member P use;

\definition positiveCornersImpossible
  (u, v, a, b, c, d: Rat)
  (uPositive: lt zeroRat u) (vPositive: lt zeroRat v)
  (au: lt a u) (nub: lt (negRat u) b)
  (cv: lt c v) (nvd: lt (negRat v) d)
  (ac: lt (mulRat u v) (mulRat a c))
  (ad: lt (mulRat u v) (mulRat a d))
  (bc: lt (mulRat u v) (mulRat b c))
  (bd: lt (mulRat u v) (mulRat b d)): Logic.False := Estimates.positiveCornersImpossible u v a b c d uPositive vPositive au nub cv nvd ac ad bc bd;

\definition productInhabited (x, y: Real): Inhabited (Def.MulLower x y) :=
  \block {
    \takefrom a: \Cast[Rat] ({ a : Rat \where mem x a }) \by #inhabited{x} \then
    \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.Not (mem x b) }) \by #proper{x} \then
    \takefrom c: \Cast[Rat] ({ c : Rat \where mem y c }) \by #inhabited{y} \then
    \takefrom d: \Cast[Rat] ({ d : Rat \where Logic.Not (mem y d) }) \by #proper{y} \then
    \takefrom u: \Cast[Rat] ({ u : Rat \where Logic.And[lt u (mulRat a c), lt u (mulRat a d)] }) \by belowBoth (mulRat a c) (mulRat a d) \then
    \takefrom v: \Cast[Rat] ({ v : Rat \where Logic.And[lt v (mulRat b c), lt v (mulRat b d)] }) \by belowBoth (mulRat b c) (mulRat b d) \then
    \takefrom q: \Cast[Rat] ({ q : Rat \where Logic.And[lt q u, lt q v] }) \by belowBoth u v \then
    \let qu: lt q u := #left{(\bysub(Rat, { q : Rat \where Logic.And[lt q u, lt q v] }, q))} \then
    \let qv: lt q v := #right{(\bysub(Rat, { q : Rat \where Logic.And[lt q u, lt q v] }, q))} \then
    \let ac: lt q (mulRat a c) :=
      RationalOrder.ltTrans q u (mulRat a c) qu
        (#left{(\bysub(Rat, { u : Rat \where Logic.And[lt u (mulRat a c), lt u (mulRat a d)] }, u))}) \then
    \let ad: lt q (mulRat a d) :=
      RationalOrder.ltTrans q u (mulRat a d) qu
        (#right{(\bysub(Rat, { u : Rat \where Logic.And[lt u (mulRat a c), lt u (mulRat a d)] }, u))}) \then
    \let bc: lt q (mulRat b c) :=
      RationalOrder.ltTrans q v (mulRat b c) qv
        (#left{(\bysub(Rat, { v : Rat \where Logic.And[lt v (mulRat b c), lt v (mulRat b d)] }, v))}) \then
    \let bd: lt q (mulRat b d) :=
      RationalOrder.ltTrans q v (mulRat b d) qv
        (#right{(\bysub(Rat, { v : Rat \where Logic.And[lt v (mulRat b c), lt v (mulRat b d)] }, v))}) \then
    \return \exact(
      \into[Rat](q, { q : Rat \where In (Def.MulLower x y) q }) \by { Def.productBelowIntro x y q a b c d
          (\bysub(Rat, { a : Rat \where mem x a }, a))
          (\bysub(Rat, { b : Rat \where Logic.Not (mem x b) }, b))
          (\bysub(Rat, { c : Rat \where mem y c }, c))
          (\bysub(Rat, { d : Rat \where Logic.Not (mem y d) }, d))
          ac ad bc bd },
      \Cast[Rat] ({ q : Rat \where In (Def.MulLower x y) q }))
  };


\definition productProper (x, y: Real): Proper (Def.MulLower x y) :=
  \block {
    \takefrom u: \Cast[Rat] ({ u : Rat \where SymmetricBoundLaw[x, u] }) \by symmetricBound x \then
    \takefrom v: \Cast[Rat] ({ v : Rat \where SymmetricBoundLaw[y, v] }) \by symmetricBound y \then
    \let uLaw: SymmetricBoundLaw[x, u] :=
      \bysub(Rat, { u : Rat \where SymmetricBoundLaw[x, u] }, u) \then
    \let vLaw: SymmetricBoundLaw[y, v] :=
      \bysub(Rat, { v : Rat \where SymmetricBoundLaw[y, v] }, v) \then
    \return \exact(
      \into[Rat](mulRat u v, { q : Rat \where Logic.Not (In (Def.MulLower x y) q) }) \by { \fun (member: Def.ProductBelow x y (mulRat u v)) =>
          productBelowElim x y (mulRat u v) member Logic.False
            (\fun (a, b, c, d: Rat) =>
              \fun (xa: mem x a) =>
              \fun (xb: Logic.Not (mem x b)) =>
              \fun (yc: mem y c) =>
              \fun (yd: Logic.Not (mem y d)) =>
              \fun (ac: lt (mulRat u v) (mulRat a c)) =>
              \fun (ad: lt (mulRat u v) (mulRat a d)) =>
              \fun (bc: lt (mulRat u v) (mulRat b c)) =>
              \fun (bd: lt (mulRat u v) (mulRat b d)) =>
                \block {
                  \let au: lt a u := memberLtOutside x a u xa
                    (#outside{uLaw}) \then
                  \let nub: lt (negRat u) b :=
                    memberLtOutside x (negRat u) b
                      (#inside{uLaw}) xb \then
                  \let cv: lt c v := memberLtOutside y c v yc
                    (#outside{vLaw}) \then
                  \let nvd: lt (negRat v) d :=
                    memberLtOutside y (negRat v) d
                      (#inside{vLaw}) yd \then
                  \return positiveCornersImpossible u v a b c d
                    (#positive{uLaw})
                    (#positive{vLaw})
                    au nub cv nvd ac ad bc bd
                }) },
      \Cast[Rat] ({ q : Rat \where Logic.Not (In (Def.MulLower x y) q) }))
  };

\definition productLower (x, y: Real): Lower (Def.MulLower x y) :=
  \fun (p, q: Rat) => \fun (pq: lt p q) =>
    \fun (member: Def.ProductBelow x y q) =>
      productBelowElim x y q member (Def.ProductBelow x y p)
        (\fun (a, b, c, d: Rat) =>
          \fun (xa: mem x a) => \fun (xb: Logic.Not (mem x b)) =>
          \fun (yc: mem y c) => \fun (yd: Logic.Not (mem y d)) =>
          \fun (ac: lt q (mulRat a c)) =>
          \fun (ad: lt q (mulRat a d)) =>
          \fun (bc: lt q (mulRat b c)) =>
          \fun (bd: lt q (mulRat b d)) =>
            Def.productBelowIntro x y p a b c d xa xb yc yd
              (RationalOrder.ltTrans p q (mulRat a c) pq ac)
              (RationalOrder.ltTrans p q (mulRat a d) pq ad)
              (RationalOrder.ltTrans p q (mulRat b c) pq bc)
              (RationalOrder.ltTrans p q (mulRat b d) pq bd));

\definition productRounded (x, y: Real): Rounded (Def.MulLower x y) :=
  \fun (q: Rat) => \fun (member: Def.ProductBelow x y q) =>
    productBelowElim x y q member
      (\exists { r : Rat \where Logic.And[In (Def.MulLower x y) r, lt q r] })
      (\fun (a, b, c, d: Rat) =>
        \fun (xa: mem x a) => \fun (xb: Logic.Not (mem x b)) =>
        \fun (yc: mem y c) => \fun (yd: Logic.Not (mem y d)) =>
        \fun (ac: lt q (mulRat a c)) =>
        \fun (ad: lt q (mulRat a d)) =>
        \fun (bc: lt q (mulRat b c)) =>
        \fun (bd: lt q (mulRat b d)) =>
          \block {
            \takefrom u: \Cast[Rat] ({ u : Rat \where Estimates.BetweenBothLaw[q, mulRat a c, mulRat a d, u] })
              \by Estimates.betweenBoth q (mulRat a c) (mulRat a d) ac ad \then
            \takefrom v: \Cast[Rat] ({ v : Rat \where Estimates.BetweenBothLaw[q, mulRat b c, mulRat b d, v] })
              \by Estimates.betweenBoth q (mulRat b c) (mulRat b d) bc bd \then
            \let uLaw: Estimates.BetweenBothLaw[q, mulRat a c, mulRat a d, u] :=
              \bysub(Rat, { u : Rat \where Estimates.BetweenBothLaw[q, mulRat a c, mulRat a d, u] }, u) \then
            \let vLaw: Estimates.BetweenBothLaw[q, mulRat b c, mulRat b d, v] :=
              \bysub(Rat, { v : Rat \where Estimates.BetweenBothLaw[q, mulRat b c, mulRat b d, v] }, v) \then
            \takefrom r: \Cast[Rat] ({ r : Rat \where Estimates.BetweenBothLaw[q, u, v, r] })
              \by Estimates.betweenBoth q u v #above{uLaw} #above{vLaw} \then
            \let rLaw: Estimates.BetweenBothLaw[q, u, v, r] :=
              \bysub(Rat, { r : Rat \where Estimates.BetweenBothLaw[q, u, v, r] }, r) \then
            \let qr: lt q r := #above{rLaw} \then
            \let ru: lt r u := #belowLeft{rLaw} \then
            \let rv: lt r v := #belowRight{rLaw} \then
            \let uac: lt u (mulRat a c) := #belowLeft{uLaw} \then
            \let uad: lt u (mulRat a d) := #belowRight{uLaw} \then
            \let vbc: lt v (mulRat b c) := #belowLeft{vLaw} \then
            \let vbd: lt v (mulRat b d) := #belowRight{vLaw} \then
            \let rac: lt r (mulRat a c) :=
              RationalOrder.ltTrans r u (mulRat a c) ru uac \then
            \let rad: lt r (mulRat a d) :=
              RationalOrder.ltTrans r u (mulRat a d) ru uad \then
            \let rbc: lt r (mulRat b c) :=
              RationalOrder.ltTrans r v (mulRat b c) rv vbc \then
            \let rbd: lt r (mulRat b d) :=
              RationalOrder.ltTrans r v (mulRat b d) rv vbd \then
            \return \exact(
              \into[Rat](r, { r : Rat \where Logic.And[In (Def.MulLower x y) r, lt q r] }) \by { Logic.And[In (Def.MulLower x y) r, lt q r]::# (Def.productBelowIntro x y r a b c d
                    xa xb yc yd rac rad rbc rbd) qr },
              \Cast[Rat] ({ r : Rat \where Logic.And[In (Def.MulLower x y) r, lt q r] }))
          });

\definition productRespects (x, y: Real): RespectsFractionEq (Def.MulLower x y) :=
  \fun (p, q: Rat) =>
    \fun (pq: RationalFractions.FractionEq p q) =>
      \fun (member: Def.ProductBelow x y p) =>
        productBelowElim x y p member (Def.ProductBelow x y q)
          (\fun (a, b, c, d: Rat) =>
            \fun (xa: mem x a) => \fun (xb: Logic.Not (mem x b)) =>
            \fun (yc: mem y c) => \fun (yd: Logic.Not (mem y d)) =>
            \fun (ac: lt p (mulRat a c)) =>
            \fun (ad: lt p (mulRat a d)) =>
            \fun (bc: lt p (mulRat b c)) =>
            \fun (bd: lt p (mulRat b d)) =>
              Def.productBelowIntro x y q a b c d xa xb yc yd
                (RationalOrder.ltReplaceLeft p q (mulRat a c) pq ac)
                (RationalOrder.ltReplaceLeft p q (mulRat a d) pq ad)
                (RationalOrder.ltReplaceLeft p q (mulRat b c) pq bc)
                (RationalOrder.ltReplaceLeft p q (mulRat b d) pq bd));

\definition mulCut (x, y: Real): IsCut[Def.MulLower x y] :=
  IsCut[Def.MulLower x y] {
    inhabited := productInhabited x y,
    proper := productProper x y,
    lower := productLower x y,
    rounded := productRounded x y,
    located := lowerLocated (Def.MulLower x y) (productLower x y),
    respects := productRespects x y,
  };

\definition reciprocalBelowIntro (x: Real) (q, a, b, r: Rat)
  (xa: mem x a) (xb: Logic.Not (mem x b))
  (positive: lt zeroRat (mulRat a b))
  (law: RationalFractions.FractionEq (mulRat b r) oneRat)
  (qr: lt q r): Def.ReciprocalBelow x q :=
  \fun (P: \Prop) =>
    \fun (use: \forall (a, b, r: Rat) -> mem x a ->
      Logic.Not (mem x b) -> lt zeroRat (mulRat a b) ->
      RationalFractions.FractionEq (mulRat b r) oneRat ->
      lt q r -> P) =>
      use a b r xa xb positive law qr;

\definition reciprocalBelowElim (x: Real) (q: Rat)
  (member: Def.ReciprocalBelow x q) (P: \Prop)
  (use: \forall (a, b, r: Rat) -> mem x a ->
    Logic.Not (mem x b) -> lt zeroRat (mulRat a b) ->
    RationalFractions.FractionEq (mulRat b r) oneRat ->
    lt q r -> P): P :=
  member P use;

\definition zeroReal: Real :=
  \into[\Pow Rat](Def.RatLower zeroRat, CutSet) \by { ratCut zeroRat };

\definition zeroRealMem (q: Rat) (negative: lt q zeroRat):
  mem zeroReal q :=
  \idelim Def.RatLower zeroRat = underlying zeroReal
    \with T: \Pow Rat => \In[Rat] T q
    \by { base: negative, equality: \refl(Def.RatLower zeroRat) };

\definition zeroRealMemLt (q: Rat) (member: mem zeroReal q):
  lt q zeroRat :=
  \idelim underlying zeroReal = Def.RatLower zeroRat
    \with T: \Pow Rat => \In[Rat] T q
    \by { base: member, equality: \refl(Def.RatLower zeroRat) };

\definition zeroLtOfNotNegativeLt (t, a: Rat)
  (notNegative: Logic.Not (lt t zeroRat)) (ta: lt t a):
  lt zeroRat a := Estimates.zeroLtOfNotNegativeLt t a notNegative ta;

\definition invInhabitedAboveZero (x: Real)
  (nonzero: Logic.Not (underlying x = Def.RatLower zeroRat))
  (positive: Lt zeroReal x): Inhabited (Def.InvLower x) :=
  \block {
    \takefrom t: \Cast[Rat] ({ t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }) \by positive \then
    \takefrom a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a, lt t a] }) \by #rounded{x} t
      (#right{(\bysub(Rat, { t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }, t))}) \then
    \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.Not (mem x b) }) \by #proper{x} \then
    \let separation: Logic.And[
        Logic.Not (mem zeroReal t), mem x t] :=
      \bysub(Rat, { t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }, t) \then
    \let rounded: Logic.And[mem x a, lt t a] :=
      \bysub(Rat, { a : Rat \where Logic.And[mem x a, lt t a] }, a) \then
    \let xa: mem x a :=
      #left{rounded} \then
    \let xb: Logic.Not (mem x b) :=
      \bysub(Rat, { b : Rat \where Logic.Not (mem x b) }, b) \then
    \let notNegative: Logic.Not (lt t zeroRat) :=
      \fun (negative: lt t zeroRat) =>
        #left{separation} (zeroRealMem t negative) \then
    \let aPositive: lt zeroRat a :=
      zeroLtOfNotNegativeLt t a notNegative
        (#right{rounded}) \then
    \let ab: lt a b := memberLtOutside x a b xa xb \then
    \let bPositive: lt zeroRat b :=
      RationalOrder.ltTrans zeroRat a b aPositive ab \then
    \let r: Rat := RationalOperations.reciprocal b \then
    \let law: RationalFractions.FractionEq (mulRat b r) oneRat :=
      RationalOperationsProp.fractionMulReciprocal b
        (RationalOperationsProp.numeratorNonZeroOfZeroLt b bPositive) \then
    \let q: Rat := RationalOperations.below r \then
    \return \exact(
      \into[Rat](q, { q : Rat \where In (Def.InvLower x) q }) \by { Logic.Or[
          Logic.And[underlying x = Def.RatLower zeroRat,
            lt q zeroRat],
          Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
            Def.ReciprocalBelow x q]]::right
          (Logic.And[
            Logic.Not (underlying x = Def.RatLower zeroRat),
            Def.ReciprocalBelow x q]::# nonzero (reciprocalBelowIntro x q a b r xa xb
                (RationalOperationsProp.zeroLtMulPositive a b
                  aPositive bPositive)
                law (RationalOperationsProp.belowLt r))) },
      \Cast[Rat] ({ q : Rat \where In (Def.InvLower x) q }))
  };

\definition invInhabitedBelowZero (x: Real)
  (nonzero: Logic.Not (underlying x = Def.RatLower zeroRat))
  (negative: Lt x zeroReal): Inhabited (Def.InvLower x) :=
  \block {
    \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.And[Logic.Not (mem x b), mem zeroReal b] }) \by negative \then
    \takefrom a: \Cast[Rat] ({ a : Rat \where mem x a }) \by #inhabited{x} \then
    \let separation: Logic.And[
        Logic.Not (mem x b), mem zeroReal b] :=
      \bysub(Rat, { b : Rat \where Logic.And[Logic.Not (mem x b), mem zeroReal b] }, b) \then
    \let xa: mem x a :=
      \bysub(Rat, { a : Rat \where mem x a }, a) \then
    \let xb: Logic.Not (mem x b) :=
      #left{separation} \then
    \let bNegative: lt b zeroRat := zeroRealMemLt b
      (#right{separation}) \then
    \let ab: lt a b := memberLtOutside x a b xa xb \then
    \let aNegative: lt a zeroRat :=
      RationalOrder.ltTrans a b zeroRat ab bNegative \then
    \let r: Rat := RationalOperations.reciprocal b \then
    \let law: RationalFractions.FractionEq (mulRat b r) oneRat :=
      RationalOperationsProp.fractionMulReciprocal b
        (RationalOperationsProp.numeratorNonZeroOfLtZero b bNegative) \then
    \let q: Rat := RationalOperations.below r \then
    \return \exact(
      \into[Rat](q, { q : Rat \where In (Def.InvLower x) q }) \by { Logic.Or[
          Logic.And[underlying x = Def.RatLower zeroRat, lt q zeroRat],
          Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
            Def.ReciprocalBelow x q]]::right
          (Logic.And[
            Logic.Not (underlying x = Def.RatLower zeroRat),
            Def.ReciprocalBelow x q]::# nonzero (reciprocalBelowIntro x q a b r xa xb
                (RationalOperationsProp.zeroLtMulNegative a b
                  aNegative bNegative)
                law (RationalOperationsProp.belowLt r))) },
      \Cast[Rat] ({ q : Rat \where In (Def.InvLower x) q }))
  };

\definition invInhabited (x: Real): Inhabited (Def.InvLower x) :=
   either!{
     {underlying x = Def.RatLower zeroRat} "or" {Logic.Not (underlying x = Def.RatLower zeroRat)} "either" {Inhabited (Def.InvLower x)}
     "lt:" {\fun (zero: underlying x = Def.RatLower zeroRat) =>
      \block {
        \let q: Rat := RationalOperations.below zeroRat \then
        \return
      \exact(
        \into[Rat](q, { q : Rat \where In (Def.InvLower x) q }) \by { Logic.Or[
            Logic.And[underlying x = Def.RatLower zeroRat,
              lt q zeroRat],
            Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x q]]::left
            (Logic.And[underlying x = Def.RatLower zeroRat,
              lt q zeroRat]::# zero (RationalOperationsProp.belowLt zeroRat)) },
        \Cast[Rat] ({ q : Rat \where In (Def.InvLower x) q }))
      }}
     "rt:" {\fun (nonzero: Logic.Not (underlying x = Def.RatLower zeroRat)) =>
      either!{
        {Lt x zeroReal} "or" {Logic.Or[x = zeroReal, Lt zeroReal x]} "either" {Inhabited (Def.InvLower x)}
        "lt:" {\fun (negative: Lt x zeroReal) =>
          invInhabitedBelowZero x nonzero negative}
        "rt:" {\fun (rest: Logic.Or[x = zeroReal, Lt zeroReal x]) =>
          either!{
            {x = zeroReal} "or" {Lt zeroReal x} "either" {Inhabited (Def.InvLower x)}
            "lt:" {\fun (same: x = zeroReal) =>
              Logic.falseElim (Inhabited (Def.InvLower x))
                (nonzero
                  (\idelim zeroReal = x
                    \with z: Real => underlying z = Def.RatLower zeroRat
                    \by { base: \refl(Def.RatLower zeroRat), equality:
                      sym!{Real} x zeroReal same }))}
            "rt:" {\fun (positive: Lt zeroReal x) =>
              invInhabitedAboveZero x nonzero positive}
          }
            rest}
      }
        (CutOrder.ltTrichotomy x zeroReal)}
   }
    (Classical.excludedMiddle (underlying x = Def.RatLower zeroRat));

\definition invLower (x: Real): Lower (Def.InvLower x) :=

  \fun (p, q: Rat) => \fun (pq: lt p q) =>
    \fun (member: In (Def.InvLower x) q) =>
      either!{
        {Logic.And[underlying x = Def.RatLower zeroRat, lt q zeroRat]} "or" {Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
          Def.ReciprocalBelow x q]} "either" {In (Def.InvLower x) p}
        "lt:" {\fun (atZero: Logic.And[
          underlying x = Def.RatLower zeroRat, lt q zeroRat]) =>
          Logic.Or[
            Logic.And[underlying x = Def.RatLower zeroRat, lt p zeroRat],
            Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x p]]::left
            (Logic.And[
              underlying x = Def.RatLower zeroRat, lt p zeroRat]::# (#left{atZero}) (RationalOrder.ltTrans p q zeroRat pq
                  (#right{atZero})))}
        "rt:" {\fun (away: Logic.And[
          Logic.Not (underlying x = Def.RatLower zeroRat),
          Def.ReciprocalBelow x q]) =>
          Logic.Or[
            Logic.And[underlying x = Def.RatLower zeroRat, lt p zeroRat],
            Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x p]]::right
            (Logic.And[
              Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x p]::# (#left{away}) (reciprocalBelowElim x q
                  (#right{away})
                  (Def.ReciprocalBelow x p)
                  (\fun (a, b, r: Rat) => \fun (xa: mem x a) =>
                    \fun (xb: Logic.Not (mem x b)) =>
                    \fun (positive: lt zeroRat (mulRat a b)) =>
                    \fun (law: RationalFractions.FractionEq
                      (mulRat b r) oneRat) =>
                    \fun (qr: lt q r) =>
                      reciprocalBelowIntro x p a b r xa xb positive law
                        (RationalOrder.ltTrans p q r pq qr))))}
      }
        member;

\definition invRounded (x: Real): Rounded (Def.InvLower x) :=
  \fun (q: Rat) => \fun (member: In (Def.InvLower x) q) =>
    either!{
      {Logic.And[underlying x = Def.RatLower zeroRat, lt q zeroRat]} "or" {Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
        Def.ReciprocalBelow x q]} "either" {\exists { r : Rat \where Logic.And[In (Def.InvLower x) r, lt q r] }}
      "lt:" {\fun (atZero: Logic.And[
        underlying x = Def.RatLower zeroRat, lt q zeroRat]) =>
        \block {
          \let r: Rat := RationalOperations.midpoint q zeroRat \then
          \return \exact(
            \into[Rat](r, { r : Rat \where Logic.And[In (Def.InvLower x) r, lt q r] }) \by { Logic.And[In (Def.InvLower x) r, lt q r]::# (Logic.Or[
                  Logic.And[underlying x = Def.RatLower zeroRat,
                    lt r zeroRat],
                  Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
                    Def.ReciprocalBelow x r]]::left
                  (Logic.And[
                    underlying x = Def.RatLower zeroRat, lt r zeroRat]::# (#left{atZero}) (RationalOperationsProp.midpointLt q zeroRat
                        (#right{atZero})))) (RationalOperationsProp.ltMidpoint q zeroRat
                  (#right{atZero})) },
            \Cast[Rat] ({ r : Rat \where Logic.And[In (Def.InvLower x) r, lt q r] }))
        }}
      "rt:" {\fun (away: Logic.And[
        Logic.Not (underlying x = Def.RatLower zeroRat),
        Def.ReciprocalBelow x q]) =>
        reciprocalBelowElim x q
          (#right{away})
          (\exists { s : Rat \where Logic.And[In (Def.InvLower x) s, lt q s] })
          (\fun (a, b, r: Rat) => \fun (xa: mem x a) =>
            \fun (xb: Logic.Not (mem x b)) =>
            \fun (positive: lt zeroRat (mulRat a b)) =>
            \fun (law: RationalFractions.FractionEq
              (mulRat b r) oneRat) =>
            \fun (qr: lt q r) =>
              \block {
                \let s: Rat := RationalOperations.midpoint q r \then
                \return \exact(
                  \into[Rat](s, { s : Rat \where Logic.And[In (Def.InvLower x) s, lt q s] }) \by { Logic.And[In (Def.InvLower x) s, lt q s]::# (Logic.Or[
                        Logic.And[underlying x = Def.RatLower zeroRat,
                          lt s zeroRat],
                        Logic.And[
                          Logic.Not (underlying x = Def.RatLower zeroRat),
                          Def.ReciprocalBelow x s]]::right
                        (Logic.And[
                          Logic.Not (underlying x = Def.RatLower zeroRat),
                          Def.ReciprocalBelow x s]::# (#left{away}) (reciprocalBelowIntro x s a b r xa xb
                              positive law
                              (RationalOperationsProp.midpointLt q r qr)))) (RationalOperationsProp.ltMidpoint q r qr) },
                  \Cast[Rat] ({ s : Rat \where Logic.And[In (Def.InvLower x) s, lt q s] }))
              })}
    }
      member;

\definition invRespects (x: Real): RespectsFractionEq (Def.InvLower x) :=

  \fun (p, q: Rat) =>
    \fun (same: RationalFractions.FractionEq p q) =>
      \fun (member: In (Def.InvLower x) p) =>
        either!{
          {Logic.And[underlying x = Def.RatLower zeroRat, lt p zeroRat]} "or" {Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
            Def.ReciprocalBelow x p]} "either" {In (Def.InvLower x) q}
          "lt:" {\fun (atZero: Logic.And[
            underlying x = Def.RatLower zeroRat, lt p zeroRat]) =>
            Logic.Or[
              Logic.And[underlying x = Def.RatLower zeroRat, lt q zeroRat],
              Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
                Def.ReciprocalBelow x q]]::left
              (Logic.And[
                underlying x = Def.RatLower zeroRat, lt q zeroRat]::# (#left{atZero}) (RationalOrder.ltReplaceLeft p q zeroRat same
                    (#right{atZero})))}
          "rt:" {\fun (away: Logic.And[
            Logic.Not (underlying x = Def.RatLower zeroRat),
            Def.ReciprocalBelow x p]) =>
            Logic.Or[
              Logic.And[underlying x = Def.RatLower zeroRat, lt q zeroRat],
              Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
                Def.ReciprocalBelow x q]]::right
              (Logic.And[
                Logic.Not (underlying x = Def.RatLower zeroRat),
                Def.ReciprocalBelow x q]::# (#left{away}) (reciprocalBelowElim x p
                    (#right{away})
                    (Def.ReciprocalBelow x q)
                    (\fun (a, b, r: Rat) => \fun (xa: mem x a) =>
                      \fun (xb: Logic.Not (mem x b)) =>
                      \fun (positive: lt zeroRat (mulRat a b)) =>
                      \fun (law: RationalFractions.FractionEq
                        (mulRat b r) oneRat) =>
                      \fun (pr: lt p r) =>
                        reciprocalBelowIntro x q a b r xa xb positive law
                          (RationalOrder.ltReplaceLeft p q r same pr))))}
        }
          member;

\definition invProperAtZero (x: Real)
  (zero: underlying x = Def.RatLower zeroRat): Proper (Def.InvLower x) :=
  \exact(
    \into[Rat](zeroRat, { q : Rat \where Logic.Not (In (Def.InvLower x) q) }) \by { \fun (member: In (Def.InvLower x) zeroRat) =>
        either!{
          {Logic.And[underlying x = Def.RatLower zeroRat,
            lt zeroRat zeroRat]} "or" {Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
            Def.ReciprocalBelow x zeroRat]} "either" Logic.False
          "lt:" {\fun (atZero: Logic.And[
            underlying x = Def.RatLower zeroRat, lt zeroRat zeroRat]) =>
            RationalOrder.ltIrrefl zeroRat
              (#right{atZero})}
          "rt:" {\fun (away: Logic.And[
            Logic.Not (underlying x = Def.RatLower zeroRat),
            Def.ReciprocalBelow x zeroRat]) =>
            #left{away} zero}
        }
          member },
    \Cast[Rat] ({ q : Rat \where Logic.Not (In (Def.InvLower x) q) }));

\definition invProperBelowZero (x: Real)
  (nonzero: Logic.Not (underlying x = Def.RatLower zeroRat))
  (negative: Lt x zeroReal): Proper (Def.InvLower x) :=
  \block {
    \takefrom u: \Cast[Rat] ({ u : Rat \where Logic.And[Logic.Not (mem x u), mem zeroReal u] }) \by negative \then
    \let separation: Logic.And[
        Logic.Not (mem x u), mem zeroReal u] :=
      \bysub(Rat, { u : Rat \where Logic.And[Logic.Not (mem x u), mem zeroReal u] }, u) \then
    \let xu: Logic.Not (mem x u) :=
      #left{separation} \then
    \let uNegative: lt u zeroRat := zeroRealMemLt u
      (#right{separation}) \then
    \return \exact(
      \into[Rat](zeroRat, { q : Rat \where Logic.Not (In (Def.InvLower x) q) }) \by { \fun (member: In (Def.InvLower x) zeroRat) =>
          either!{
            {Logic.And[underlying x = Def.RatLower zeroRat,
              lt zeroRat zeroRat]} "or" {Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x zeroRat]} "either" Logic.False
            "lt:" {\fun (atZero: Logic.And[
              underlying x = Def.RatLower zeroRat, lt zeroRat zeroRat]) =>
              nonzero (#left{atZero})}
            "rt:" {\fun (away: Logic.And[
              Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x zeroRat]) =>
              reciprocalBelowElim x zeroRat
                (#right{away})
                Logic.False
                (\fun (a, b, r: Rat) => \fun (xa: mem x a) =>
                  \fun (_: Logic.Not (mem x b)) =>
                  \fun (productPositive: lt zeroRat (mulRat a b)) =>
                  \fun (law: RationalFractions.FractionEq
                    (mulRat b r) oneRat) =>
                  \fun (zeroR: lt zeroRat r) =>
                    \block {
                      \let au: lt a u := memberLtOutside x a u xa xu \then
                      \let aNegative: lt a zeroRat :=
                        RationalOrder.ltTrans a u zeroRat au uNegative \then
                      \let bNegative: lt b zeroRat :=
                        RationalOperationsProp.negativeRightOfPositiveProduct
                          a b aNegative productPositive \then
                      \let rNegative: lt r zeroRat :=
                        RationalOperationsProp.negativeOfNegativeProductOne
                          b r bNegative law \then
                      \return RationalOrder.ltIrrefl zeroRat
                        (RationalOrder.ltTrans zeroRat r zeroRat
                          zeroR rNegative)
                    })}
          }
            member },
        \Cast[Rat] ({ q : Rat \where Logic.Not (In (Def.InvLower x) q) }))
  };

\definition invProperAboveZero (x: Real)
  (nonzero: Logic.Not (underlying x = Def.RatLower zeroRat))
  (positive: Lt zeroReal x): Proper (Def.InvLower x) :=
  \block {
    \takefrom t: \Cast[Rat] ({ t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }) \by positive \then
    \takefrom a0: \Cast[Rat] ({ a0 : Rat \where Logic.And[mem x a0, lt t a0] }) \by #rounded{x} t
      (#right{(\bysub(Rat, { t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }, t))}) \then
    \let separation: Logic.And[
        Logic.Not (mem zeroReal t), mem x t] :=
      \bysub(Rat, { t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }, t) \then
    \let rounded: Logic.And[mem x a0, lt t a0] :=
      \bysub(Rat, { a0 : Rat \where Logic.And[mem x a0, lt t a0] }, a0) \then
    \let xa0: mem x a0 :=
      #left{rounded} \then
    \let notNegative: Logic.Not (lt t zeroRat) :=
      \fun (negative: lt t zeroRat) =>
        #left{separation} (zeroRealMem t negative) \then
    \let a0Positive: lt zeroRat a0 :=
      zeroLtOfNotNegativeLt t a0 notNegative
        (#right{rounded}) \then
    \let s: Rat := RationalOperations.reciprocal a0 \then
    \let a0Law: RationalFractions.FractionEq
        (mulRat a0 s) oneRat :=
      RationalOperationsProp.fractionMulReciprocal a0
        (RationalOperationsProp.numeratorNonZeroOfZeroLt a0 a0Positive) \then
    \return \exact(
      \into[Rat](s, { q : Rat \where Logic.Not (In (Def.InvLower x) q) }) \by { \fun (member: In (Def.InvLower x) s) =>
          either!{
            {Logic.And[underlying x = Def.RatLower zeroRat,
              lt s zeroRat]} "or" {Logic.And[
              Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x s]} "either" Logic.False
            "lt:" {\fun (atZero: Logic.And[
              underlying x = Def.RatLower zeroRat, lt s zeroRat]) =>
              nonzero (#left{atZero})}
            "rt:" {\fun (away: Logic.And[
              Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x s]) =>
              reciprocalBelowElim x s
                (#right{away})
                Logic.False
                (\fun (a, b, r: Rat) =>
                  \fun (unusedXa: mem x a) =>
                  \fun (xb: Logic.Not (mem x b)) =>
                  \fun (unusedPositive: lt zeroRat (mulRat a b)) =>
                  \fun (law: RationalFractions.FractionEq
                    (mulRat b r) oneRat) =>
                  \fun (sr: lt s r) =>
                    \block {
                      \let a0b: lt a0 b :=
                        memberLtOutside x a0 b xa0 xb \then
                      \let rs: lt r s :=
                        RationalOperationsProp.reciprocalOrderPositive
                          a0 b r s a0Positive a0b law a0Law \then
                      \return RationalOrder.ltIrrefl s
                        (RationalOrder.ltTrans s r s sr rs)
                    })}
          }
            member },
        \Cast[Rat] ({ q : Rat \where Logic.Not (In (Def.InvLower x) q) }))
  };

\definition invProper (x: Real): Proper (Def.InvLower x) :=
  either!{
    {underlying x = Def.RatLower zeroRat} "or" {Logic.Not (underlying x = Def.RatLower zeroRat)} "either" {Proper (Def.InvLower x)}
    "lt:" {\fun (zero: underlying x = Def.RatLower zeroRat) =>
      invProperAtZero x zero}
    "rt:" {\fun (nonzero: Logic.Not (underlying x = Def.RatLower zeroRat)) =>
      either!{
        {Lt x zeroReal} "or" {Logic.Or[x = zeroReal, Lt zeroReal x]} "either" {Proper (Def.InvLower x)}
        "lt:" {\fun (negative: Lt x zeroReal) =>
          invProperBelowZero x nonzero negative}
        "rt:" {\fun (rest: Logic.Or[x = zeroReal, Lt zeroReal x]) =>
          either!{
            {x = zeroReal} "or" {Lt zeroReal x} "either" {Proper (Def.InvLower x)}
            "lt:" {\fun (same: x = zeroReal) =>
              Logic.falseElim (Proper (Def.InvLower x))
                (nonzero
                  (\idelim zeroReal = x
                    \with z: Real => underlying z = Def.RatLower zeroRat
                    \by { base: \refl(Def.RatLower zeroRat), equality:
                      sym!{Real} x zeroReal same }))}
            "rt:" {\fun (positive: Lt zeroReal x) =>
              invProperAboveZero x nonzero positive}
          }
            rest}
      }
        (CutOrder.ltTrichotomy x zeroReal)}
  }
    (Classical.excludedMiddle (underlying x = Def.RatLower zeroRat));

\definition invCut (x: Real): IsCut[Def.InvLower x] :=
  IsCut[Def.InvLower x] {
    inhabited := invInhabited x,
    proper := invProper x,
    lower := invLower x,
    rounded := invRounded x,
    located := lowerLocated (Def.InvLower x) (invLower x),
    respects := invRespects x,
  };
