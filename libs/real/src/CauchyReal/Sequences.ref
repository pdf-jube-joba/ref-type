/* Concrete sequence constructions with no additional analytic assumptions. */
\definition pointwiseEquivalent (x, y: CauchySeq)
  (same: \forall (n: Nat) -> at x n = at y n)
  (eps: Rat) (positive: Positive eps):
  \exists { k : Nat \where EquivalentAt x y eps k } :=
  \block {
    \takefrom k: \Cast[Nat] ({ k : Nat \where CauchyAt x eps k }) \by cauchyProperty x eps positive \then
    \return \exact(
        \into[Nat](k, { j : Nat \where EquivalentAt x y eps j }) \by { \fun (n: Nat) => \fun (kn: NatLe k n) =>
            \idelim(at x n = at y n \with a: Rat => Close (at x n) a eps)
              \by { base: (\bysub(Nat, { j : Nat \where CauchyAt x eps j }, k)) n n kn kn, equality: same n } },
        \Cast[Nat] ({ j : Nat \where EquivalentAt x y eps j }))
  };

\definition pointwiseFractionEquivalent (x, y: CauchySeq)
  (same: \forall (n: Nat) -> RationalFractions.FractionEq (at x n) (at y n)):
  Equivalent x y :=
  \fun (eps: Rat) => \fun (positive: Positive eps) =>
    \exact(
      \into[Nat](N.Nat^::zero,
        { k : Nat \where EquivalentAt x y eps k }) \by {
          \fun (n: Nat) => \fun (_: NatLe N.Nat^::zero n) =>
            closeOfFractionEq (at x n) (at y n) eps (same n) positive },
      \Cast[Nat] ({ k : Nat \where EquivalentAt x y eps k }));

\definition ConstSeq (a: Rat) (n: Nat): Rat := a;
\definition AddSeq (x, y: CauchySeq) (n: Nat): Rat :=
  addRat (at x n) (at y n);
\definition MulSeq (x, y: CauchySeq) (n: Nat): Rat :=
  mulRat (at x n) (at y n);
\definition constCauchyOf (a: Rat)
  (selfClose: \forall (eps: Rat) -> Positive eps -> Close a a eps)
  (eps: Rat) (positive: Positive eps):
  \exists { k : Nat \where CauchyAt (ConstSeq a) eps k } :=
  \exact(
    \into[Nat](N.Nat^::zero, { k : Nat \where CauchyAt (ConstSeq a) eps k }) \by { \fun (m, n: Nat) => \fun (_: NatLe N.Nat^::zero m) =>
      \fun (_: NatLe N.Nat^::zero n) => selfClose eps positive },
    \Cast[Nat] ({ k : Nat \where CauchyAt (ConstSeq a) eps k }));
\definition constCauchy (a: Rat): IsCauchy (ConstSeq a) :=
  constCauchyOf a (closeRefl a);
\definition ConstCauchy (a: Rat): CauchySeq :=
  \into[Sequence](ConstSeq a, CauchySet) \by { constCauchy a };
\definition zeroClose (eps: Rat) (positive: Positive eps): Close zeroRat zeroRat eps := Estimates.zeroClose eps positive;

\definition oneClose (eps: Rat) (positive: Positive eps): Close oneRat oneRat eps := Estimates.oneClose eps positive;

\definition zeroCauchy: IsCauchy (ConstSeq zeroRat) := constCauchyOf zeroRat zeroClose;
\definition oneCauchy: IsCauchy (ConstSeq oneRat) := constCauchyOf oneRat oneClose;
\definition zero: CauchySeq :=
  \into[Sequence](ConstSeq zeroRat, CauchySet) \by { zeroCauchy };
\definition one: CauchySeq :=
  \into[Sequence](ConstSeq oneRat, CauchySet) \by { oneCauchy };

\definition BoundedAt (x: CauchySeq) (B: Rat) (N: Nat): \Prop :=
  Logic.And[Positive B,
    \forall (n: Nat) -> NatLe N n -> Close (at x n) zeroRat B];

\definition EventuallyBounded (x: CauchySeq): \Prop :=
  \exists { B : Rat \where
    \exists { N : Nat \where BoundedAt x B N } };

\definition boundWidth (x: CauchySeq) (N: Nat): Rat :=
  addRat oneRat (bound (at x N));

\definition boundWidthPositive (x: CauchySeq) (N: Nat):
    Positive (boundWidth x N) :=
  RationalOrder.ltReplaceLeft (addRat zeroRat zeroRat) zeroRat
    (boundWidth x N)
    (RationalOperations.fractionAddZeroRight zeroRat)
    (RationalOperations.ltAdd zeroRat oneRat zeroRat (bound (at x N))
      RationalOrder.zeroLtOne (boundPositive (at x N)));

\definition eventuallyBounded (x: CauchySeq): EventuallyBounded x :=
  \block {
    \takefrom N: \Cast[Nat] ({ k : Nat \where CauchyAt x oneRat k }) \by cauchyProperty x oneRat RationalOrder.zeroLtOne \then
    \return \exact(
        \into[Rat](boundWidth x N,
          { B : Rat \where
            \exists { k : Nat \where BoundedAt x B k } }) \by {
            \exact(
              \into[Nat](N, { k : Nat \where BoundedAt x (boundWidth x N) k }) \by {
                Logic.And[Positive (boundWidth x N),
                  \forall (n: Nat) -> NatLe N n ->
                    Close (at x n) zeroRat (boundWidth x N)]::#
                  (boundWidthPositive x N)
                  (\fun (n: Nat) => \fun (Nn: NatLe N n) =>
                    closeTransAdd (at x n) (at x N) zeroRat
                      oneRat (bound (at x N))
                      ((\bysub(Nat,
                        { k : Nat \where CauchyAt x oneRat k }, N))
                        n N Nn (NL.leRefl N))
                        (closeZeroOfBound (at x N))) },
              \Cast[Nat] ({ k : Nat \where BoundedAt x (boundWidth x N) k })) },
        \Cast[Rat] ({ B : Rat \where
          \exists { k : Nat \where BoundedAt x B k } }))
  };

\definition NonzeroFailure (x: CauchySeq): \Prop :=
  \exists { eps : Rat \where
    Logic.And[Positive eps,
      Logic.Not (\exists { k : Nat \where
        EquivalentAt x zero eps k })] };

\definition nonEquivalentFailure (x: CauchySeq)
    (nonzero: Logic.Not (Equivalent x zero)): NonzeroFailure x :=
  byContradiction (NonzeroFailure x)
    (\fun (noFailure: Logic.Not (NonzeroFailure x)) =>
      nonzero
        (\fun (eps: Rat) => \fun (positive: Positive eps) =>
          byContradiction
            (\exists { k : Nat \where
              EquivalentAt x zero eps k })
            (\fun (noWitness: Logic.Not
                (\exists { k : Nat \where
                  EquivalentAt x zero eps k })) =>
              noFailure
                (\exact(
                  \into[Rat](eps, { e : Rat \where
                    Logic.And[Positive e,
                      Logic.Not (\exists { k : Nat \where EquivalentAt x zero e k })] })
                    \by { Logic.And[Positive eps,
                      Logic.Not (\exists { k : Nat \where EquivalentAt x zero eps k })]::#
                      positive noWitness },
                  \Cast[Rat] ({ e : Rat \where
                    Logic.And[Positive e,
                      Logic.Not (\exists { k : Nat \where EquivalentAt x zero e k })] }))))));

\definition EventuallyPositive (x: CauchySeq): \Prop :=
  \exists { r : Rat \where
    \exists { k : Nat \where
      Logic.And[Positive r,
        \forall (n: Nat) -> NatLe k n ->
          RationalOperations.Le r (at x n)] } };

\definition EventuallyNegative (x: CauchySeq): \Prop :=
  \exists { r : Rat \where
    \exists { k : Nat \where
      Logic.And[Positive r,
        \forall (n: Nat) -> NatLe k n ->
          RationalOperations.Le (at x n) (negRat r)] } };

\definition EventuallyApart (x: CauchySeq): \Prop :=
  Logic.Or[EventuallyPositive x, EventuallyNegative x];

\definition nonEquivalentApart (x: CauchySeq)
    (nonzero: Logic.Not (Equivalent x zero)): EventuallyApart x :=
  \block {
    \takefrom eps: \Cast[Rat] ({ e : Rat \where
        Logic.And[Positive e,
          Logic.Not (\exists { k : Nat \where
            EquivalentAt x zero e k })] }) \by nonEquivalentFailure x nonzero \then
    \takefrom M: \Cast[Nat] ({ k : Nat \where
        CauchyAt x (half eps) k }) \by cauchyProperty x (half eps)
      (halfPositiveOf eps
        #left{(\bysub(Rat, { e : Rat \where
          Logic.And[Positive e,
            Logic.Not (\exists { k : Nat \where EquivalentAt x zero e k })] }, eps))}) \then
    \takefrom N: \Cast[Nat] ({ k : Nat \where
        CauchyAt x (half (half eps)) k }) \by cauchyProperty x (half (half eps))
      (halfPositiveOf (half eps)
        (halfPositiveOf eps
          #left{(\bysub(Rat, { e : Rat \where
            Logic.And[Positive e,
              Logic.Not (\exists { k : Nat \where EquivalentAt x zero e k })] }, eps))})) \then
    \let K: Nat := commonBound M N \then
    \let notClose: Logic.Not (Close (at x K) zeroRat (half eps)) :=
      \fun (anchorClose: Close (at x K) zeroRat (half eps)) =>
        #right{(\bysub(Rat, { e : Rat \where
          Logic.And[Positive e,
            Logic.Not (\exists { k : Nat \where
              EquivalentAt x zero e k })] }, eps))}
          (\exact(
            \into[Nat](K, { k : Nat \where
              EquivalentAt x zero eps k }) \by {
                \fun (n: Nat) => \fun (Kn: NatLe K n) =>
                  closeTransHalf (at x n) (at x K) zeroRat eps
                    ((\bysub(Nat, { k : Nat \where
                      CauchyAt x (half eps) k }, M))
                      n K
                      (NL.leTrans M K n
                        (leftLeCommonBound M N) Kn)
                      (leftLeCommonBound M N))
                    anchorClose },
            \Cast[Nat] ({ k : Nat \where
              EquivalentAt x zero eps k }))) \then
    \return Logic.orElim
      (RationalOperations.Le (half eps) (at x K))
      (RationalOperations.Le (at x K) (negRat (half eps)))
      (EventuallyApart x)
      (\fun (positiveAnchor:
          RationalOperations.Le (half eps) (at x K)) =>
        Logic.Or[EventuallyPositive x, EventuallyNegative x]::left
          (\exact(
            \into[Rat](half (half eps), { r : Rat \where
              \exists { k : Nat \where
                Logic.And[Positive r,
                  \forall (n: Nat) -> NatLe k n ->
                    RationalOperations.Le r (at x n)] } }) \by {
              \exact(
                \into[Nat](K, { k : Nat \where
                  Logic.And[Positive (half (half eps)),
                    \forall (n: Nat) -> NatLe k n ->
                      RationalOperations.Le (half (half eps))
                        (at x n)] }) \by {
                  Logic.And[Positive (half (half eps)),
                    \forall (n: Nat) -> NatLe K n ->
                      RationalOperations.Le (half (half eps))
                        (at x n)]::#
                    (halfPositiveOf (half eps)
                      (halfPositiveOf eps
                        #left{(\bysub(Rat, { e : Rat \where
                          Logic.And[Positive e,
                            Logic.Not (\exists { k : Nat \where EquivalentAt x zero e k })] }, eps))}))
                    (\fun (n: Nat) => \fun (Kn: NatLe K n) =>
                      RationalOperations.leOfLt (half (half eps))
                        (at x n)
                        (lowerOfClose (at x K) (at x n) (half eps)
                          positiveAnchor
                          ((\bysub(Nat, { k : Nat \where
                            CauchyAt x (half (half eps)) k }, N))
                            n K
                            (NL.leTrans N K n
                            (rightLeCommonBound M N) Kn)
                            (rightLeCommonBound M N)))) },
                \Cast[Nat] ({ k : Nat \where
                  Logic.And[Positive (half (half eps)),
                    \forall (n: Nat) -> NatLe k n ->
                      RationalOperations.Le (half (half eps))
                        (at x n)] })) },
            \Cast[Rat] ({ r : Rat \where
              \exists { k : Nat \where
                Logic.And[Positive r,
                  \forall (n: Nat) -> NatLe k n ->
                    RationalOperations.Le r (at x n)] } }))))
      (\fun (negativeAnchor:
          RationalOperations.Le (at x K) (negRat (half eps))) =>
        Logic.Or[EventuallyPositive x, EventuallyNegative x]::right
          (\exact(
            \into[Rat](half (half eps), { r : Rat \where
              \exists { k : Nat \where
                Logic.And[Positive r,
                  \forall (n: Nat) -> NatLe k n ->
                    RationalOperations.Le (at x n) (negRat r)] } }) \by {
              \exact(
                \into[Nat](K, { k : Nat \where
                  Logic.And[Positive (half (half eps)),
                    \forall (n: Nat) -> NatLe k n ->
                      RationalOperations.Le (at x n)
                        (negRat (half (half eps)))] }) \by {
                  Logic.And[Positive (half (half eps)),
                    \forall (n: Nat) -> NatLe K n ->
                      RationalOperations.Le (at x n)
                        (negRat (half (half eps)))]::#
                    (halfPositiveOf (half eps)
                      (halfPositiveOf eps
                        #left{(\bysub(Rat, { e : Rat \where
                          Logic.And[Positive e,
                            Logic.Not (\exists { k : Nat \where EquivalentAt x zero e k })] }, eps))}))
                    (\fun (n: Nat) => \fun (Kn: NatLe K n) =>
                      RationalOperations.leOfLt (at x n)
                        (negRat (half (half eps)))
                        (upperOfClose (at x K) (at x n) (half eps)
                          negativeAnchor
                          ((\bysub(Nat, { k : Nat \where
                            CauchyAt x (half (half eps)) k }, N))
                            n K
                            (NL.leTrans N K n
                            (rightLeCommonBound M N) Kn)
                            (rightLeCommonBound M N)))) },
                \Cast[Nat] ({ k : Nat \where
                  Logic.And[Positive (half (half eps)),
                    \forall (n: Nat) -> NatLe k n ->
                      RationalOperations.Le (at x n)
                        (negRat (half (half eps)))] })) },
            \Cast[Rat] ({ r : Rat \where
              \exists { k : Nat \where
                Logic.And[Positive r,
                  \forall (n: Nat) -> NatLe k n ->
                    RationalOperations.Le (at x n) (negRat r)] } }))))
      (notCloseDirection (at x K) (half eps) notClose)
  };

\definition fourBound (a, b, c, d: Nat): Nat := NatOrder.fourBound a b c d;
\definition firstLeFourBound (a, b, c, d: Nat): NatLe a (fourBound a b c d) :=
  NatOrder.firstLeFourBound a b c d;
\definition secondLeFourBound (a, b, c, d: Nat): NatLe b (fourBound a b c d) :=
  NatOrder.secondLeFourBound a b c d;
\definition thirdLeFourBound (a, b, c, d: Nat): NatLe c (fourBound a b c d) :=
  NatOrder.thirdLeFourBound a b c d;
\definition fourthLeFourBound (a, b, c, d: Nat): NatLe d (fourBound a b c d) :=
  NatOrder.fourthLeFourBound a b c d;

\definition mulCauchy (x, y: CauchySeq) (eps: Rat)
    (positive: Positive eps):
    \exists { k : Nat \where CauchyAt (MulSeq x y) eps k } :=

  \block {
    \takefrom A: \Cast[Rat] ({ A : Rat \where
        \exists { k : Nat \where BoundedAt x A k } }) \by eventuallyBounded x \then
    \takefrom NA: \Cast[Nat] ({ k : Nat \where BoundedAt x A k }) \by \bysub(Rat,
      { A : Rat \where
        \exists { k : Nat \where BoundedAt x A k } }, A) \then
    \takefrom D: \Cast[Rat] ({ D : Rat \where
        \exists { k : Nat \where BoundedAt y D k } }) \by eventuallyBounded y \then
    \takefrom ND: \Cast[Nat] ({ k : Nat \where BoundedAt y D k }) \by \bysub(Rat,
      { D : Rat \where
        \exists { k : Nat \where BoundedAt y D k } }, D) \then
    \takefrom MX: \Cast[Nat] ({ k : Nat \where
        CauchyAt x (productRadius A D eps) k }) \by cauchyProperty x (productRadius A D eps)
      (productRadiusPositive A D eps
        #left{(\bysub(Nat,
          { k : Nat \where BoundedAt x A k }, NA))}
        #left{(\bysub(Nat,
          { k : Nat \where BoundedAt y D k }, ND))}
        positive) \then
    \takefrom MY: \Cast[Nat] ({ k : Nat \where
        CauchyAt y (productRadius A D eps) k }) \by cauchyProperty y (productRadius A D eps)
      (productRadiusPositive A D eps
        #left{(\bysub(Nat,
          { k : Nat \where BoundedAt x A k }, NA))}
        #left{(\bysub(Nat,
          { k : Nat \where BoundedAt y D k }, ND))}
        positive) \then
    \return \exact(
        \into[Nat](fourBound NA ND MX MY,
          { k : Nat \where CauchyAt (MulSeq x y) eps k }) \by {
            \fun (m, n: Nat) =>
              \fun (km: NatLe (fourBound NA ND MX MY) m) =>
                \fun (kn: NatLe (fourBound NA ND MX MY) n) =>
                  closeMulScaled
                    (at x m) (at y m) (at x n) (at y n)
                    A D eps
                    #left{(\bysub(Nat,
                      { k : Nat \where BoundedAt x A k }, NA))}
                    #left{(\bysub(Nat,
                      { k : Nat \where BoundedAt y D k }, ND))}
                    positive
                    (#right{(\bysub(Nat,
                      { k : Nat \where BoundedAt x A k }, NA))}
                      m (NL.leTrans NA (fourBound NA ND MX MY) m
                        (firstLeFourBound NA ND MX MY) km))
                    (#right{(\bysub(Nat,
                      { k : Nat \where BoundedAt y D k }, ND))}
                      n (NL.leTrans ND (fourBound NA ND MX MY) n
                        (secondLeFourBound NA ND MX MY) kn))
                    ((\bysub(Nat,
                      { k : Nat \where CauchyAt x
                        (productRadius A D eps) k }, MX))
                      m n
                      (NL.leTrans MX (fourBound NA ND MX MY) m
                        (thirdLeFourBound NA ND MX MY) km)
                      (NL.leTrans MX (fourBound NA ND MX MY) n
                        (thirdLeFourBound NA ND MX MY) kn))
                    ((\bysub(Nat,
                      { k : Nat \where CauchyAt y
                        (productRadius A D eps) k }, MY))
                      m n
                      (NL.leTrans MY (fourBound NA ND MX MY) m
                        (fourthLeFourBound NA ND MX MY) km)
                      (NL.leTrans MY (fourBound NA ND MX MY) n
                        (fourthLeFourBound NA ND MX MY) kn)) },
        \Cast[Nat] ({ k : Nat \where CauchyAt (MulSeq x y) eps k }))
  };

\definition mul (x, y: CauchySeq): CauchySeq :=
  \into[Sequence](MulSeq x y, CauchySet) \by { mulCauchy x y };

\definition mulRespects (x, x2, y, y2: CauchySeq)
    (xx: Equivalent x x2) (yy: Equivalent y y2):
    Equivalent (mul x y) (mul x2 y2) :=

  \fun (eps: Rat) => \fun (positive: Positive eps) =>
    \block {
      \takefrom A: \Cast[Rat] ({ A : Rat \where
          \exists { k : Nat \where BoundedAt x A k } }) \by eventuallyBounded x \then
      \takefrom NA: \Cast[Nat] ({ k : Nat \where BoundedAt x A k }) \by \bysub(Rat,
        { A : Rat \where
          \exists { k : Nat \where BoundedAt x A k } }, A) \then
      \takefrom D: \Cast[Rat] ({ D : Rat \where
          \exists { k : Nat \where BoundedAt y2 D k } }) \by eventuallyBounded y2 \then
      \takefrom ND: \Cast[Nat] ({ k : Nat \where BoundedAt y2 D k }) \by \bysub(Rat,
        { D : Rat \where
          \exists { k : Nat \where BoundedAt y2 D k } }, D) \then
      \takefrom MX: \Cast[Nat] ({ k : Nat \where
          EquivalentAt x x2 (productRadius A D eps) k }) \by xx (productRadius A D eps)
        (productRadiusPositive A D eps
          #left{(\bysub(Nat,
            { k : Nat \where BoundedAt x A k }, NA))}
          #left{(\bysub(Nat,
            { k : Nat \where BoundedAt y2 D k }, ND))}
          positive) \then
      \takefrom MY: \Cast[Nat] ({ k : Nat \where
          EquivalentAt y y2 (productRadius A D eps) k }) \by yy (productRadius A D eps)
        (productRadiusPositive A D eps
          #left{(\bysub(Nat,
            { k : Nat \where BoundedAt x A k }, NA))}
          #left{(\bysub(Nat,
            { k : Nat \where BoundedAt y2 D k }, ND))}
          positive) \then
      \return \exact(
          \into[Nat](fourBound NA ND MX MY,
            { k : Nat \where
              EquivalentAt (mul x y) (mul x2 y2) eps k }) \by {
              \fun (n: Nat) =>
                \fun (kn: NatLe (fourBound NA ND MX MY) n) =>
                  closeMulScaled
                    (at x n) (at y n) (at x2 n) (at y2 n)
                    A D eps
                    #left{(\bysub(Nat,
                      { k : Nat \where BoundedAt x A k }, NA))}
                    #left{(\bysub(Nat,
                      { k : Nat \where BoundedAt y2 D k }, ND))}
                    positive
                    (#right{(\bysub(Nat,
                      { k : Nat \where BoundedAt x A k }, NA))}
                      n (NL.leTrans NA (fourBound NA ND MX MY) n
                        (firstLeFourBound NA ND MX MY) kn))
                    (#right{(\bysub(Nat,
                      { k : Nat \where BoundedAt y2 D k }, ND))}
                      n (NL.leTrans ND (fourBound NA ND MX MY) n
                        (secondLeFourBound NA ND MX MY) kn))
                    ((\bysub(Nat,
                      { k : Nat \where EquivalentAt x x2
                        (productRadius A D eps) k }, MX))
                      n (NL.leTrans MX (fourBound NA ND MX MY) n
                        (thirdLeFourBound NA ND MX MY) kn))
                    ((\bysub(Nat,
                      { k : Nat \where EquivalentAt y y2
                        (productRadius A D eps) k }, MY))
                      n (NL.leTrans MY (fourBound NA ND MX MY) n
                        (fourthLeFourBound NA ND MX MY) kn)) },
          \Cast[Nat] ({ k : Nat \where
            EquivalentAt (mul x y) (mul x2 y2) eps k }))
    };

\definition ReciprocalSeq (x: CauchySeq) (n: Nat): Rat :=
  RationalOperations.reciprocal (at x n);

\definition positiveReciprocalCauchy (x: CauchySeq)
    (apart: EventuallyPositive x): IsCauchy (ReciprocalSeq x) :=
  \fun (eps: Rat) => \fun (positive: Positive eps) =>
    \block {
      \takefrom r: \Cast[Rat] ({ r : Rat \where
          \exists { k : Nat \where
            Logic.And[Positive r,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le r (at x n)] } }) \by apart \then
      \takefrom N: \Cast[Nat] ({ k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r (at x n)] }) \by \bysub(Rat, { r : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r (at x n)] } }, r) \then
      \takefrom M: \Cast[Nat] ({ k : Nat \where
          CauchyAt x (reciprocalRadius r eps) k }) \by cauchyProperty x (reciprocalRadius r eps)
        (reciprocalRadiusPositive r eps
          #left{(\bysub(Nat, { k : Nat \where
            Logic.And[Positive r,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le r (at x n)] }, N))}
          positive) \then
      \return \exact(
          \into[Nat](commonBound N M,
            { k : Nat \where CauchyAt (ReciprocalSeq x) eps k }) \by {
              \fun (m, n: Nat) =>
                \fun (km: NatLe (commonBound N M) m) =>
                  \fun (kn: NatLe (commonBound N M) n) =>
                    \block {
                      \let rm: RationalOperations.Le r (at x m) :=
                        #right{(\bysub(Nat, { k : Nat \where
                          Logic.And[Positive r,
                            \forall (j: Nat) -> NatLe k j ->
                              RationalOperations.Le r (at x j)] }, N))}
                          m (NL.leTrans N (commonBound N M) m
                            (leftLeCommonBound N M) km) \then
                      \let rn: RationalOperations.Le r (at x n) :=
                        #right{(\bysub(Nat, { k : Nat \where
                          Logic.And[Positive r,
                            \forall (j: Nat) -> NatLe k j ->
                              RationalOperations.Le r (at x j)] }, N))}
                          n (NL.leTrans N (commonBound N M) n
                            (leftLeCommonBound N M) kn) \then
                      \let product: Logic.And[
                          Positive (mulRat (at x m) (at x n)),
                          RationalOperations.Le (mulRat r r)
                            (mulRat (at x m) (at x n))] :=
                        positiveProductLower r
                        (at x m) (at x n)
                        #left{(\bysub(Nat, { k : Nat \where
                          Logic.And[Positive r,
                            \forall (j: Nat) -> NatLe k j ->
                              RationalOperations.Le r (at x j)] }, N))}
                        rm rn \then
                      \return closeReciprocalWithProductLower
                        (at x m) (at x n) r eps positive
                        #left{product} #right{product}
                        (RationalOperations.numeratorNonZeroOfZeroLt
                          (at x m)
                          (RationalOperations.ltLeTrans zeroRat r (at x m)
                            #left{(\bysub(Nat, { k : Nat \where
                              Logic.And[Positive r,
                                \forall (j: Nat) -> NatLe k j ->
                                  RationalOperations.Le r (at x j)] }, N))}
                            rm))
                        (RationalOperations.numeratorNonZeroOfZeroLt
                          (at x n)
                          (RationalOperations.ltLeTrans zeroRat r (at x n)
                            #left{(\bysub(Nat, { k : Nat \where
                              Logic.And[Positive r,
                                \forall (j: Nat) -> NatLe k j ->
                                  RationalOperations.Le r (at x j)] }, N))}
                            rn))
                        ((\bysub(Nat, { k : Nat \where
                          CauchyAt x (reciprocalRadius r eps) k }, M))
                          m n
                          (NL.leTrans M (commonBound N M) m
                            (rightLeCommonBound N M) km)
                          (NL.leTrans M (commonBound N M) n
                            (rightLeCommonBound N M) kn))
                    } },
          \Cast[Nat] ({ k : Nat \where
            CauchyAt (ReciprocalSeq x) eps k }))
    };

\definition negativeReciprocalCauchy (x: CauchySeq)
    (apart: EventuallyNegative x): IsCauchy (ReciprocalSeq x) :=
  \fun (eps: Rat) => \fun (positive: Positive eps) =>
    \block {
      \takefrom r: \Cast[Rat] ({ r : Rat \where
          \exists { k : Nat \where
            Logic.And[Positive r,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le (at x n) (negRat r)] } }) \by apart \then
      \takefrom N: \Cast[Nat] ({ k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le (at x n) (negRat r)] }) \by \bysub(Rat, { r : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le (at x n) (negRat r)] } }, r) \then
      \takefrom M: \Cast[Nat] ({ k : Nat \where
          CauchyAt x (reciprocalRadius r eps) k }) \by cauchyProperty x (reciprocalRadius r eps)
        (reciprocalRadiusPositive r eps
          #left{(\bysub(Nat, { k : Nat \where
            Logic.And[Positive r,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le (at x n) (negRat r)] }, N))}
          positive) \then
      \return \exact(
          \into[Nat](commonBound N M,
            { k : Nat \where CauchyAt (ReciprocalSeq x) eps k }) \by {
              \fun (m, n: Nat) =>
                \fun (km: NatLe (commonBound N M) m) =>
                  \fun (kn: NatLe (commonBound N M) n) =>
                    \block {
                      \let mr: RationalOperations.Le (at x m) (negRat r) :=
                        #right{(\bysub(Nat, { k : Nat \where
                          Logic.And[Positive r,
                            \forall (j: Nat) -> NatLe k j ->
                              RationalOperations.Le (at x j) (negRat r)] }, N))}
                          m (NL.leTrans N (commonBound N M) m
                            (leftLeCommonBound N M) km) \then
                      \let nr: RationalOperations.Le (at x n) (negRat r) :=
                        #right{(\bysub(Nat, { k : Nat \where
                          Logic.And[Positive r,
                            \forall (j: Nat) -> NatLe k j ->
                              RationalOperations.Le (at x j) (negRat r)] }, N))}
                          n (NL.leTrans N (commonBound N M) n
                            (leftLeCommonBound N M) kn) \then
                      \let product: Logic.And[
                          Positive (mulRat (at x m) (at x n)),
                          RationalOperations.Le (mulRat r r)
                            (mulRat (at x m) (at x n))] :=
                        negativeProductLower r
                        (at x m) (at x n)
                        #left{(\bysub(Nat, { k : Nat \where
                          Logic.And[Positive r,
                            \forall (j: Nat) -> NatLe k j ->
                              RationalOperations.Le (at x j) (negRat r)] }, N))}
                        mr nr \then
                      \return closeReciprocalWithProductLower
                        (at x m) (at x n) r eps positive
                        #left{product} #right{product}
                        (RationalOperations.numeratorNonZeroOfLtZero
                          (at x m)
                          (RationalOperations.leLtTrans (at x m) (negRat r)
                            zeroRat mr
                            (RationalOperations.ltNegReverse zeroRat r
                              #left{(\bysub(Nat, { k : Nat \where
                                Logic.And[Positive r,
                                  \forall (j: Nat) -> NatLe k j ->
                                    RationalOperations.Le (at x j)
                                      (negRat r)] }, N))})))
                        (RationalOperations.numeratorNonZeroOfLtZero
                          (at x n)
                          (RationalOperations.leLtTrans (at x n) (negRat r)
                            zeroRat nr
                            (RationalOperations.ltNegReverse zeroRat r
                              #left{(\bysub(Nat, { k : Nat \where
                                Logic.And[Positive r,
                                  \forall (j: Nat) -> NatLe k j ->
                                    RationalOperations.Le (at x j)
                                      (negRat r)] }, N))})))
                        ((\bysub(Nat, { k : Nat \where
                          CauchyAt x (reciprocalRadius r eps) k }, M))
                          m n
                          (NL.leTrans M (commonBound N M) m
                            (rightLeCommonBound N M) km)
                          (NL.leTrans M (commonBound N M) n
                            (rightLeCommonBound N M) kn))
                    } },
          \Cast[Nat] ({ k : Nat \where
            CauchyAt (ReciprocalSeq x) eps k }))
    };

\definition reciprocalCauchy (x: CauchySeq)
    (apart: EventuallyApart x): IsCauchy (ReciprocalSeq x) :=
  Logic.orElim (EventuallyPositive x) (EventuallyNegative x)
    (IsCauchy (ReciprocalSeq x))
    (positiveReciprocalCauchy x) (negativeReciprocalCauchy x) apart;

\definition ReciprocalGraph (x, y: CauchySeq): \Prop :=
  \forall (n: Nat) ->
    at y n = RationalOperations.reciprocal (at x n);

\definition reciprocalGraph (x: CauchySeq)
    (cauchy: IsCauchy (ReciprocalSeq x)):
    ReciprocalGraph x
      (\into[Sequence](ReciprocalSeq x, CauchySet) \by { cauchy }) :=
  \fun (n: Nat) => \refl(RationalOperations.reciprocal (at x n));

\definition reciprocalGraphFractionEq (x, y: CauchySeq)
    (graph: ReciprocalGraph x y) (n: Nat):
    RationalFractions.FractionEq
      (at y n) (RationalOperations.reciprocal (at x n)) :=
  \idelim(at y n = RationalOperations.reciprocal (at x n)
    \with q: Rat => RationalFractions.FractionEq (at y n) q)
    \by { base: RationalFractions.fractionEqRefl (at y n),
      equality: graph n };

\definition reciprocalMulEquivalent (x, y: CauchySeq)
    (apart: EventuallyApart x) (graph: ReciprocalGraph x y):
    Equivalent (mul y x) one :=

  \fun (eps: Rat) => \fun (positive: Positive eps) =>
    Logic.orElim (EventuallyPositive x) (EventuallyNegative x)
      (\exists { k : Nat \where
        EquivalentAt (mul y x) one eps k })
      (\fun (positiveApart: EventuallyPositive x) =>
        \block {
          \takefrom r: \Cast[Rat] ({ r : Rat \where
              \exists { k : Nat \where
                Logic.And[Positive r,
                  \forall (n: Nat) -> NatLe k n ->
                    RationalOperations.Le r (at x n)] } }) \by positiveApart \then
          \takefrom N: \Cast[Nat] ({ k : Nat \where
              Logic.And[Positive r,
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le r (at x n)] }) \by \bysub(Rat, { r : Rat \where
            \exists { k : Nat \where
              Logic.And[Positive r,
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le r (at x n)] } }, r) \then
          \return \exact(
              \into[Nat](N, { k : Nat \where
                EquivalentAt (mul y x) one eps k }) \by {
                  \fun (n: Nat) => \fun (Nn: NatLe N n) =>
                    closeOfFractionEq (mulRat (at y n) (at x n))
                      oneRat eps
                      (RationalFractions.fractionEqTrans _ _ _
                        (RationalOperations.fractionMulRespects
                          (at y n) (RationalOperations.reciprocal (at x n))
                          (at x n) (at x n)
                          (reciprocalGraphFractionEq x y graph n)
                          (RationalFractions.fractionEqRefl _))
                        (reciprocalLeftLaw (at x n)
                          (RationalOperations.numeratorNonZeroOfZeroLt
                            (at x n)
                            (RationalOperations.ltLeTrans zeroRat r (at x n)
                              #left{(\bysub(Nat, { k : Nat \where
                                Logic.And[Positive r,
                                  \forall (j: Nat) -> NatLe k j ->
                                    RationalOperations.Le r (at x j)] }, N))}
                              (#right{(\bysub(Nat, { k : Nat \where
                                Logic.And[Positive r,
                                  \forall (j: Nat) -> NatLe k j ->
                                    RationalOperations.Le r (at x j)] }, N))}
                                n Nn)))))
                      positive },
              \Cast[Nat] ({ k : Nat \where
                EquivalentAt (mul y x) one eps k }))
        })
      (\fun (negativeApart: EventuallyNegative x) =>
        \block {
          \takefrom r: \Cast[Rat] ({ r : Rat \where
              \exists { k : Nat \where
                Logic.And[Positive r,
                  \forall (n: Nat) -> NatLe k n ->
                    RationalOperations.Le (at x n) (negRat r)] } }) \by negativeApart \then
          \takefrom N: \Cast[Nat] ({ k : Nat \where
              Logic.And[Positive r,
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le (at x n) (negRat r)] }) \by \bysub(Rat, { r : Rat \where
            \exists { k : Nat \where
              Logic.And[Positive r,
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le (at x n) (negRat r)] } }, r) \then
          \return \exact(
              \into[Nat](N, { k : Nat \where
                EquivalentAt (mul y x) one eps k }) \by {
                  \fun (n: Nat) => \fun (Nn: NatLe N n) =>
                    closeOfFractionEq (mulRat (at y n) (at x n))
                      oneRat eps
                      (RationalFractions.fractionEqTrans _ _ _
                        (RationalOperations.fractionMulRespects
                          (at y n) (RationalOperations.reciprocal (at x n))
                          (at x n) (at x n)
                          (reciprocalGraphFractionEq x y graph n)
                          (RationalFractions.fractionEqRefl _))
                        (reciprocalLeftLaw (at x n)
                          (RationalOperations.numeratorNonZeroOfLtZero
                            (at x n)
                            (RationalOperations.leLtTrans (at x n) (negRat r)
                              zeroRat
                              (#right{(\bysub(Nat, { k : Nat \where
                                Logic.And[Positive r,
                                  \forall (j: Nat) -> NatLe k j ->
                                    RationalOperations.Le (at x j)
                                      (negRat r)] }, N))}
                                n Nn)
                              (RationalOperations.ltNegReverse zeroRat r
                                #left{(\bysub(Nat, { k : Nat \where
                                  Logic.And[Positive r,
                                    \forall (j: Nat) -> NatLe k j ->
                                      RationalOperations.Le (at x j)
                                        (negRat r)] }, N))})))))
                      positive },
              \Cast[Nat] ({ k : Nat \where
                EquivalentAt (mul y x) one eps k }))
        })
      apart;

\definition addCauchy (x, y: CauchySeq) (eps: Rat) (positive: Positive eps):
  \exists { k : Nat \where CauchyAt (AddSeq x y) eps k } :=
  \block {
    \takefrom M: \Cast[Nat] ({ k : Nat \where CauchyAt x (half eps) k }) \by cauchyProperty x (half eps) (halfPositiveOf eps positive) \then
    \takefrom N: \Cast[Nat] ({ k : Nat \where CauchyAt y (half eps) k }) \by cauchyProperty y (half eps) (halfPositiveOf eps positive) \then
    \return \exact(
        \into[Nat](commonBound M N,
          { k : Nat \where CauchyAt (AddSeq x y) eps k }) \by {
            \fun (m, n: Nat) =>
              \fun (boundM: NatLe (commonBound M N) m) =>
                \fun (boundN: NatLe (commonBound M N) n) =>
                  closeAddHalf (at x m) (at x n) (at y m) (at y n) eps
                    ((\bysub(Nat,
                      { k : Nat \where CauchyAt x (half eps) k }, M))
                      m n
                      (NL.leTrans M (commonBound M N) m (leftLeCommonBound M N) boundM)
                      (NL.leTrans M (commonBound M N) n (leftLeCommonBound M N) boundN))
                    ((\bysub(Nat,
                      { k : Nat \where CauchyAt y (half eps) k }, N))
                      m n
                      (NL.leTrans N (commonBound M N) m (rightLeCommonBound M N) boundM)
                      (NL.leTrans N (commonBound M N) n (rightLeCommonBound M N) boundN)) },
        \Cast[Nat] ({ k : Nat \where CauchyAt (AddSeq x y) eps k }))
  };
\definition add (x, y: CauchySeq): CauchySeq :=
  \into[Sequence](AddSeq x y, CauchySet) \by { addCauchy x y };
\definition addRespects (x, x2, y, y2: CauchySeq)
    (xx: Equivalent x x2) (yy: Equivalent y y2):
    Equivalent (add x y) (add x2 y2) :=
  \fun (eps: Rat) => \fun (positive: Positive eps) =>
    \block {
      \takefrom M: \Cast[Nat] ({ k : Nat \where EquivalentAt x x2 (half eps) k }) \by xx (half eps) (halfPositiveOf eps positive) \then
      \takefrom N: \Cast[Nat] ({ k : Nat \where EquivalentAt y y2 (half eps) k }) \by yy (half eps) (halfPositiveOf eps positive) \then
      \return \exact(
          \into[Nat](commonBound M N,
            { k : Nat \where EquivalentAt (add x y) (add x2 y2) eps k }) \by {
              \fun (n: Nat) => \fun (bound: NatLe (commonBound M N) n) =>
                closeAddHalf (at x n) (at x2 n) (at y n) (at y2 n) eps
                  ((\bysub(Nat,
                    { k : Nat \where EquivalentAt x x2 (half eps) k }, M))
                    n (NL.leTrans M (commonBound M N) n (leftLeCommonBound M N) bound))
                  ((\bysub(Nat,
                    { k : Nat \where EquivalentAt y y2 (half eps) k }, N))
                    n (NL.leTrans N (commonBound M N) n (rightLeCommonBound M N) bound)) },
          \Cast[Nat] ({ k : Nat \where EquivalentAt (add x y) (add x2 y2) eps k }))
    };

\definition addZeroLeft (x: CauchySeq): Equivalent (add zero x) x :=
  pointwiseFractionEquivalent (add zero x) x
    (\fun (n: Nat) => RationalOperations.fractionAddZeroLeft (at x n));
\definition addComm (x, y: CauchySeq): Equivalent (add x y) (add y x) :=
  pointwiseFractionEquivalent (add x y) (add y x)
    (\fun (n: Nat) => RationalOperations.fractionAddComm (at x n) (at y n));
\definition addAssoc (x, y, z: CauchySeq):
    Equivalent (add (add x y) z) (add x (add y z)) :=
  pointwiseFractionEquivalent (add (add x y) z) (add x (add y z))
    (\fun (n: Nat) => RationalOperations.fractionAddAssoc
      (at x n) (at y n) (at z n));

\definition mulZeroLeft (x: CauchySeq): Equivalent (mul zero x) zero :=
  pointwiseFractionEquivalent (mul zero x) zero
    (\fun (n: Nat) => RationalOperations.fractionMulZeroLeft (at x n));
\definition mulOneLeft (x: CauchySeq): Equivalent (mul one x) x :=
  pointwiseFractionEquivalent (mul one x) x
    (\fun (n: Nat) => RationalOperations.fractionMulOneLeft (at x n));
\definition mulComm (x, y: CauchySeq): Equivalent (mul x y) (mul y x) :=
  pointwiseFractionEquivalent (mul x y) (mul y x)
    (\fun (n: Nat) => RationalOperations.fractionMulComm
      (at x n) (at y n));
\definition mulAssoc (x, y, z: CauchySeq):
    Equivalent (mul (mul x y) z) (mul x (mul y z)) :=
  pointwiseFractionEquivalent (mul (mul x y) z) (mul x (mul y z))
    (\fun (n: Nat) => RationalOperations.fractionMulAssoc
      (at x n) (at y n) (at z n));
\definition mulAddLeft (x, y, z: CauchySeq):
    Equivalent (mul x (add y z)) (add (mul x y) (mul x z)) :=
  pointwiseFractionEquivalent
    (mul x (add y z)) (add (mul x y) (mul x z))
    (\fun (n: Nat) => RationalOperations.fractionMulAddLeft
      (at x n) (at y n) (at z n));

\definition zeroNotEquivalentOne: Logic.Not (Equivalent zero one) :=
  \fun (same: Equivalent zero one) =>
    \block {
      \takefrom N: \Cast[Nat] ({ k : Nat \where
          EquivalentAt zero one (half oneRat) k }) \by same (half oneRat) (halfPositiveOf oneRat RationalOrder.zeroLtOne) \then
      \return RationalOrder.ltIrrefl oneRat
          (RationalOrder.ltTrans oneRat (half oneRat) oneRat
            (RationalOrder.ltReplaceLeft
              (subRat oneRat zeroRat) oneRat (half oneRat)
              (RationalOperations.fractionSubZeroRight oneRat)
              #right{((\bysub(Nat,
                { k : Nat \where EquivalentAt zero one (half oneRat) k }, N))
                N (NL.leRefl N))})
            (halfLt oneRat RationalOrder.zeroLtOne))
    };

\definition closeNeg (x, y, eps: Rat) (h: Close x y eps): Close (negRat x) (negRat y) eps := Estimates.closeNeg x y eps h;

\definition NegSeq (x: CauchySeq) (n: Nat): Rat := negRat (at x n);
\definition negCauchy (x: CauchySeq) (eps: Rat) (positive: Positive eps):
  \exists { k : Nat \where CauchyAt (NegSeq x) eps k } :=
  \block {
    \takefrom k: \Cast[Nat] ({ k : Nat \where CauchyAt x eps k }) \by cauchyProperty x eps positive \then
    \return \exact(
        \into[Nat](k, { j : Nat \where CauchyAt (NegSeq x) eps j }) \by { \fun (m, n: Nat) => \fun (km: NatLe k m) => \fun (kn: NatLe k n) =>
            closeNeg (at x m) (at x n) eps
              ((\bysub(Nat, { j : Nat \where CauchyAt x eps j }, k)) m n km kn) },
        \Cast[Nat] ({ j : Nat \where CauchyAt (NegSeq x) eps j }))
  };
\definition neg (x: CauchySeq): CauchySeq :=
  \into[Sequence](NegSeq x, CauchySet) \by { negCauchy x };
\definition negRespects (x, y: CauchySeq) (xy: Equivalent x y) (eps: Rat) (positive: Positive eps):
  \exists { k : Nat \where EquivalentAt (neg x) (neg y) eps k } :=
  \block {
    \takefrom k: \Cast[Nat] ({ k : Nat \where EquivalentAt x y eps k }) \by xy eps positive \then
    \return \exact(
        \into[Nat](k, { j : Nat \where EquivalentAt (neg x) (neg y) eps j }) \by { \fun (n: Nat) => \fun (kn: NatLe k n) =>
            closeNeg (at x n) (at y n) eps
              ((\bysub(Nat, { j : Nat \where EquivalentAt x y eps j }, k)) n kn) },
        \Cast[Nat] ({ j : Nat \where EquivalentAt (neg x) (neg y) eps j }))
  };
\definition negInvolutive (x: CauchySeq): Equivalent (neg (neg x)) x :=
  \fun (eps: Rat) => \fun (positive: Positive eps) =>
    \block {
      \takefrom k: \Cast[Nat] ({ k : Nat \where EquivalentAt x x eps k }) \by equivalentRefl x eps positive \then
      \return \exact(
          \into[Nat](k, { j : Nat \where EquivalentAt (neg (neg x)) x eps j }) \by { \fun (n: Nat) => \fun (kn: NatLe k n) =>
              Logic.And[
                ltRat (subRat (at (neg (neg x)) n) (at x n)) eps,
                ltRat (subRat (at x n) (at (neg (neg x)) n)) eps]::# (\idelim(subRat (at x n) (at x n) = subRat (at (neg (neg x)) n) (at x n)
                  \with q: Rat => ltRat q eps)
                  \by { base: #left{((\bysub(Nat, { j : Nat \where EquivalentAt x x eps j }, k)) n kn)}, equality:
                    sym!{Rat} _ _ (RationalOperations.subFieldsLeft
                      (at (neg (neg x)) n) (at x n) (at x n)
                      (RationalOperations.negInvolutiveNumerator (at x n))
                      (\refl(#denominatorIndex{(at x n)}))) }) (\idelim(subRat (at x n) (at x n) = subRat (at x n) (at (neg (neg x)) n)
                  \with q: Rat => ltRat q eps)
                  \by { base: #right{((\bysub(Nat, { j : Nat \where EquivalentAt x x eps j }, k)) n kn)}, equality:
                    sym!{Rat} _ _ (RationalOperations.subFieldsRight
                      (at x n) (at (neg (neg x)) n) (at x n)
                      (RationalOperations.negInvolutiveNumerator (at x n))
                      (\refl(#denominatorIndex{(at x n)}))) }) },
          \Cast[Nat] ({ j : Nat \where EquivalentAt (neg (neg x)) x eps j }))
    };
\definition negZero: Equivalent (neg zero) zero :=
  pointwiseEquivalent (neg zero) zero (\fun (n: Nat) => RationalOperations.fractionNegZero);
\definition addNegLeft (x: CauchySeq): Equivalent (add (neg x) x) zero :=
  pointwiseFractionEquivalent (add (neg x) x) zero
    (\fun (n: Nat) => RationalOperations.fractionAddNegLeft (at x n));

\definition sub (x, y: CauchySeq): CauchySeq := add x (neg y);

\definition subAsRat (x, y: CauchySeq) (n: Nat):
    RationalFractions.FractionEq (at (sub x y) n)
      (subRat (at x n) (at y n)) :=
  RationalFractions.fractionEqRefl _;

\definition equivalentOfSubZero (x, y: CauchySeq)
    (differenceZero: Equivalent (sub x y) zero): Equivalent x y :=
  \fun (eps: Rat) => \fun (positive: Positive eps) =>
    \block {
      \takefrom N: \Cast[Nat] ({ k : Nat \where
          EquivalentAt (sub x y) zero eps k }) \by differenceZero eps positive \then
      \return \exact(
          \into[Nat](N, { k : Nat \where EquivalentAt x y eps k }) \by {
            \fun (n: Nat) => \fun (Nn: NatLe N n) =>
              closeOfDifferenceZero (at x n) (at y n) eps
                (closeRespects (at (sub x y) n)
                  (subRat (at x n) (at y n)) zeroRat zeroRat eps
                  (subAsRat x y n)
                  (RationalFractions.fractionEqRefl _)
                  ((\bysub(Nat, { k : Nat \where
                    EquivalentAt (sub x y) zero eps k }, N)) n Nn)) },
          \Cast[Nat] ({ k : Nat \where EquivalentAt x y eps k }))
    };

\definition eventuallyPositiveStable (x, y: CauchySeq)
    (same: Equivalent x y) (positiveX: EventuallyPositive x):
    EventuallyPositive y :=

  \block {
    \takefrom r: \Cast[Rat] ({ r : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r (at x n)] } }) \by positiveX \then
    \takefrom N: \Cast[Nat] ({ k : Nat \where
        Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le r (at x n)] }) \by \bysub(Rat, { r : Rat \where
      \exists { k : Nat \where
        Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le r (at x n)] } }, r) \then
    \takefrom M: \Cast[Nat] ({ k : Nat \where
        EquivalentAt x y (half r) k }) \by same (half r)
      (halfPositiveOf r
        #left{(\bysub(Nat, { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r (at x n)] }, N))}) \then
    \return \exact(
        \into[Rat](half r, { s : Rat \where
          \exists { k : Nat \where
            Logic.And[Positive s,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le s (at y n)] } }) \by {
          \exact(
            \into[Nat](commonBound N M, { k : Nat \where
              Logic.And[Positive (half r),
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le (half r) (at y n)] }) \by {
              Logic.And[Positive (half r),
                \forall (n: Nat) -> NatLe (commonBound N M) n ->
                  RationalOperations.Le (half r) (at y n)]::#
                (halfPositiveOf r
                  #left{(\bysub(Nat, { k : Nat \where
                    Logic.And[Positive r,
                      \forall (j: Nat) -> NatLe k j ->
                        RationalOperations.Le r (at x j)] }, N))})
                (\fun (n: Nat) =>
                  \fun (Kn: NatLe (commonBound N M) n) =>
                    RationalOperations.leOfLt (half r) (at y n)
                      (lowerOfClose (at x n) (at y n) r
                        (#right{(\bysub(Nat, { k : Nat \where
                          Logic.And[Positive r,
                            \forall (j: Nat) -> NatLe k j ->
                              RationalOperations.Le r (at x j)] }, N))}
                          n (NL.leTrans N (commonBound N M) n
                            (leftLeCommonBound N M) Kn))
                        (closeSym (at x n) (at y n) (half r)
                          ((\bysub(Nat, { k : Nat \where
                            EquivalentAt x y (half r) k }, M))
                            n (NL.leTrans M (commonBound N M) n
                              (rightLeCommonBound N M) Kn))))) },
            \Cast[Nat] ({ k : Nat \where
              Logic.And[Positive (half r),
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le (half r) (at y n)] })) },
        \Cast[Rat] ({ s : Rat \where
          \exists { k : Nat \where
            Logic.And[Positive s,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le s (at y n)] } }))
  };

\definition eventuallyPositiveAdd (x, y: CauchySeq)
    (positiveX: EventuallyPositive x)
    (positiveY: EventuallyPositive y): EventuallyPositive (add x y) :=

  \block {
    \takefrom r: \Cast[Rat] ({ r : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r (at x n)] } }) \by positiveX \then
    \takefrom M: \Cast[Nat] ({ k : Nat \where
        Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le r (at x n)] }) \by \bysub(Rat, { r : Rat \where
      \exists { k : Nat \where
        Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le r (at x n)] } }, r) \then
    \takefrom s: \Cast[Rat] ({ s : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive s,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le s (at y n)] } }) \by positiveY \then
    \takefrom N: \Cast[Nat] ({ k : Nat \where
        Logic.And[Positive s,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le s (at y n)] }) \by \bysub(Rat, { s : Rat \where
      \exists { k : Nat \where
        Logic.And[Positive s,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le s (at y n)] } }, s) \then
    \return \exact(
        \into[Rat](addRat r s, { t : Rat \where
          \exists { k : Nat \where
            Logic.And[Positive t,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le t (at (add x y) n)] } }) \by {
          \exact(
            \into[Nat](commonBound M N, { k : Nat \where
              Logic.And[Positive (addRat r s),
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le (addRat r s)
                    (at (add x y) n)] }) \by {
              Logic.And[Positive (addRat r s),
                \forall (n: Nat) -> NatLe (commonBound M N) n ->
                  RationalOperations.Le (addRat r s)
                    (at (add x y) n)]::#
                (positiveAdd r s
                  #left{(\bysub(Nat, { k : Nat \where
                    Logic.And[Positive r,
                      \forall (j: Nat) -> NatLe k j ->
                        RationalOperations.Le r (at x j)] }, M))}
                  #left{(\bysub(Nat, { k : Nat \where
                    Logic.And[Positive s,
                      \forall (j: Nat) -> NatLe k j ->
                        RationalOperations.Le s (at y j)] }, N))})
                (\fun (n: Nat) =>
                  \fun (Kn: NatLe (commonBound M N) n) =>
                    leAdd r (at x n) s (at y n)
                      (#right{(\bysub(Nat, { k : Nat \where
                        Logic.And[Positive r,
                          \forall (j: Nat) -> NatLe k j ->
                            RationalOperations.Le r (at x j)] }, M))}
                        n (NL.leTrans M (commonBound M N) n
                          (leftLeCommonBound M N) Kn))
                      (#right{(\bysub(Nat, { k : Nat \where
                        Logic.And[Positive s,
                          \forall (j: Nat) -> NatLe k j ->
                        RationalOperations.Le s (at y j)] }, N))}
                        n (NL.leTrans N (commonBound M N) n
                          (rightLeCommonBound M N) Kn))) },
            \Cast[Nat] ({ k : Nat \where
              Logic.And[Positive (addRat r s),
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le (addRat r s)
                    (at (add x y) n)] })) },
        \Cast[Rat] ({ t : Rat \where
          \exists { k : Nat \where
            Logic.And[Positive t,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le t (at (add x y) n)] } }))
  };

\definition eventuallyPositiveNegOfNegative (x: CauchySeq)
    (negative: EventuallyNegative x): EventuallyPositive (neg x) :=

  \block {
    \takefrom r: \Cast[Rat] ({ r : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le (at x n) (negRat r)] } }) \by negative \then
    \takefrom N: \Cast[Nat] ({ k : Nat \where
        Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le (at x n) (negRat r)] }) \by \bysub(Rat, { r : Rat \where
      \exists { k : Nat \where
        Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le (at x n) (negRat r)] } }, r) \then
    \return \exact(
        \into[Rat](r, { s : Rat \where
          \exists { k : Nat \where
            Logic.And[Positive s,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le s (at (neg x) n)] } }) \by {
          \exact(
            \into[Nat](N, { k : Nat \where
              Logic.And[Positive r,
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le r (at (neg x) n)] }) \by {
              Logic.And[Positive r,
                \forall (n: Nat) -> NatLe N n ->
                  RationalOperations.Le r (at (neg x) n)]::#
                (#left{(\bysub(Nat, { k : Nat \where
                  Logic.And[Positive r,
                    \forall (j: Nat) -> NatLe k j ->
                      RationalOperations.Le (at x j) (negRat r)] }, N))})
                (\fun (n: Nat) => \fun (Nn: NatLe N n) =>
                  RationalOperations.leTrans r (negRat (negRat r))
                    (negRat (at x n))
                    (RationalOperations.leOfEq r (negRat (negRat r))
                      (RationalFractions.fractionEqSym _ _
                        (RationalOperations.fractionNegInvolutive r)))
                    (leNegReverse (at x n) (negRat r)
                      (#right{(\bysub(Nat, { k : Nat \where
                        Logic.And[Positive r,
                          \forall (j: Nat) -> NatLe k j ->
                            RationalOperations.Le (at x j) (negRat r)] }, N))}
                        n Nn))) },
            \Cast[Nat] ({ k : Nat \where
              Logic.And[Positive r,
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le r (at (neg x) n)] })) },
        \Cast[Rat] ({ s : Rat \where
          \exists { k : Nat \where
            Logic.And[Positive s,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le s (at (neg x) n)] } }))
  };

\definition eventuallyPositiveNotZero (x: CauchySeq)
    (positiveX: EventuallyPositive x): Logic.Not (Equivalent x zero) :=
  \fun (zeroX: Equivalent x zero) =>
    \block {
      \takefrom r: \Cast[Rat] ({ r : Rat \where
          \exists { k : Nat \where
            Logic.And[Positive r,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le r (at x n)] } }) \by positiveX \then
      \takefrom N: \Cast[Nat] ({ k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r (at x n)] }) \by \bysub(Rat, { r : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r (at x n)] } }, r) \then
      \takefrom M: \Cast[Nat] ({ k : Nat \where
          EquivalentAt x zero (half r) k }) \by zeroX (half r)
        (halfPositiveOf r
          #left{(\bysub(Nat, { k : Nat \where
            Logic.And[Positive r,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le r (at x n)] }, N))}) \then
      \let K: Nat := commonBound N M \then
      \let rHalf: ltRat r (half r) :=
        RationalOperations.leLtTrans r (at x K) (half r)
          (#right{(\bysub(Nat, { k : Nat \where
            Logic.And[Positive r,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le r (at x n)] }, N))}
            K (leftLeCommonBound N M))
          (RationalOrder.ltReplaceLeft (subRat (at x K) zeroRat)
            (at x K) (half r)
            (RationalOperations.fractionSubZeroRight (at x K))
            #left{(\bysub(Nat, { k : Nat \where
              EquivalentAt x zero (half r) k }, M))
              K (rightLeCommonBound N M)}) \then
      \return RationalOrder.ltIrrefl r
        (RationalOrder.ltTrans r (half r) r rHalf
          (halfLt r
            #left{(\bysub(Nat, { k : Nat \where
              Logic.And[Positive r,
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le r (at x n)] }, N))}))
    };

\definition eventuallyPositiveOppositeImpossible (x: CauchySeq)
    (positiveX: EventuallyPositive x)
    (positiveNegX: EventuallyPositive (neg x)): Logic.False :=
  \block {
    \takefrom r: \Cast[Rat] ({ r : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r (at x n)] } }) \by positiveX \then
    \takefrom N: \Cast[Nat] ({ k : Nat \where
        Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le r (at x n)] }) \by \bysub(Rat, { r : Rat \where
      \exists { k : Nat \where
        Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le r (at x n)] } }, r) \then
    \takefrom s: \Cast[Rat] ({ s : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive s,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le s (at (neg x) n)] } }) \by positiveNegX \then
    \takefrom M: \Cast[Nat] ({ k : Nat \where
        Logic.And[Positive s,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le s (at (neg x) n)] }) \by \bysub(Rat, { s : Rat \where
      \exists { k : Nat \where
        Logic.And[Positive s,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le s (at (neg x) n)] } }, s) \then
    \let K: Nat := commonBound N M \then
    \let lower: RationalOperations.Le (addRat r s)
        (addRat (at x K) (negRat (at x K))) :=
      leAdd r (at x K) s (negRat (at x K))
        (#right{(\bysub(Nat, { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r (at x n)] }, N))}
          K (leftLeCommonBound N M))
        (#right{(\bysub(Nat, { k : Nat \where
          Logic.And[Positive s,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le s (at (neg x) n)] }, M))}
          K (rightLeCommonBound N M)) \then
    \let belowZero: ltRat zeroRat zeroRat :=
      RationalOperations.ltLeTrans zeroRat (addRat r s) zeroRat
        (positiveAdd r s
          #left{(\bysub(Nat, { k : Nat \where
            Logic.And[Positive r,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le r (at x n)] }, N))}
          #left{(\bysub(Nat, { k : Nat \where
            Logic.And[Positive s,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le s (at (neg x) n)] }, M))})
        (RationalOperations.leTrans (addRat r s)
          (addRat (at x K) (negRat (at x K))) zeroRat lower
          (RationalOperations.leOfEq _ _
            (RationalOperations.fractionAddNegRight (at x K)))) \then
    \return RationalOrder.ltIrrefl zeroRat belowZero
  };

\definition subRespects (x, x2, y, y2: CauchySeq)
    (xx: Equivalent x x2) (yy: Equivalent y y2):
    Equivalent (sub x y) (sub x2 y2) :=
  addRespects x x2 (neg y) (neg y2) xx (negRespects y y2 yy);

\definition subNeg (x, y: CauchySeq):
    Equivalent (neg (sub x y)) (sub y x) :=
  pointwiseFractionEquivalent (neg (sub x y)) (sub y x)
    (\fun (n: Nat) => negSub (at x n) (at y n));

\definition subComposition (x, y, z: CauchySeq):
    Equivalent (add (sub y x) (sub z y)) (sub z x) :=
  pointwiseFractionEquivalent (add (sub y x) (sub z y)) (sub z x)
    (\fun (n: Nat) => RationalFractions.fractionEqTrans _ _ _
      (RationalOperations.fractionAddComm
        (subRat (at y n) (at x n)) (subRat (at z n) (at y n)))
      (RationalFractions.fractionEqSym _ _
        (subTriangle (at z n) (at y n) (at x n))));

\definition SeqLe (x, y: CauchySeq): \Prop :=
  Logic.Or[Equivalent x y, EventuallyPositive (sub y x)];

\definition seqLeRefl (x: CauchySeq): SeqLe x x :=
  Logic.Or[Equivalent x x, EventuallyPositive (sub x x)]::left
    (equivalentRefl x);

\definition seqLeRespects (x, x2, y, y2: CauchySeq)
    (xx: Equivalent x x2) (yy: Equivalent y y2)
    (xy: SeqLe x y): SeqLe x2 y2 :=
  Logic.orElim (Equivalent x y) (EventuallyPositive (sub y x))
    (SeqLe x2 y2)
    (\fun (same: Equivalent x y) =>
      Logic.Or[Equivalent x2 y2, EventuallyPositive (sub y2 x2)]::left
        (equivalentTrans x2 x y2 (equivalentSym x x2 xx)
          (equivalentTrans x y y2 same yy)))
    (\fun (positiveDifference: EventuallyPositive (sub y x)) =>
      Logic.Or[Equivalent x2 y2, EventuallyPositive (sub y2 x2)]::right
        (eventuallyPositiveStable (sub y x) (sub y2 x2)
          (subRespects y y2 x x2 yy xx) positiveDifference))
    xy;

\definition seqLeTrans (x, y, z: CauchySeq)
    (xy: SeqLe x y) (yz: SeqLe y z): SeqLe x z :=
  Logic.orElim (Equivalent x y) (EventuallyPositive (sub y x))
    (SeqLe x z)
    (\fun (sameXY: Equivalent x y) =>
      seqLeRespects y x z z (equivalentSym x y sameXY)
        (equivalentRefl z) yz)
    (\fun (positiveXY: EventuallyPositive (sub y x)) =>
      Logic.orElim (Equivalent y z) (EventuallyPositive (sub z y))
        (SeqLe x z)
        (\fun (sameYZ: Equivalent y z) =>
          seqLeRespects x x y z (equivalentRefl x) sameYZ xy)
        (\fun (positiveYZ: EventuallyPositive (sub z y)) =>
          Logic.Or[Equivalent x z, EventuallyPositive (sub z x)]::right
            (eventuallyPositiveStable
              (add (sub y x) (sub z y)) (sub z x)
              (subComposition x y z)
              (eventuallyPositiveAdd (sub y x) (sub z y)
                positiveXY positiveYZ))) yz)
    xy;

\definition seqLeAntisym (x, y: CauchySeq)
    (xy: SeqLe x y) (yx: SeqLe y x): Equivalent x y :=
  Logic.orElim (Equivalent x y) (EventuallyPositive (sub y x))
    (Equivalent x y)
    (\fun (same: Equivalent x y) => same)
    (\fun (positiveXY: EventuallyPositive (sub y x)) =>
      Logic.orElim (Equivalent y x) (EventuallyPositive (sub x y))
        (Equivalent x y)
        (\fun (same: Equivalent y x) => equivalentSym y x same)
        (\fun (positiveYX: EventuallyPositive (sub x y)) =>
          Logic.falseElim (Equivalent x y)
            (eventuallyPositiveOppositeImpossible (sub y x)
              positiveXY
              (eventuallyPositiveStable (sub x y) (neg (sub y x))
                (equivalentSym (neg (sub y x)) (sub x y)
                  (subNeg y x)) positiveYX))) yx)
    xy;

\definition seqLeTotal (x, y: CauchySeq):
    Logic.Or[SeqLe x y, SeqLe y x] :=
  Logic.orElim (Equivalent (sub y x) zero)
    (Logic.Not (Equivalent (sub y x) zero))
    (Logic.Or[SeqLe x y, SeqLe y x])
    (\fun (differenceZero: Equivalent (sub y x) zero) =>
      Logic.Or[SeqLe x y, SeqLe y x]::left
        (Logic.Or[Equivalent x y, EventuallyPositive (sub y x)]::left
          (equivalentSym y x
            (equivalentOfSubZero y x differenceZero))))
    (\fun (differenceNonzero: Logic.Not (Equivalent (sub y x) zero)) =>
      Logic.orElim (EventuallyPositive (sub y x))
        (EventuallyNegative (sub y x))
        (Logic.Or[SeqLe x y, SeqLe y x])
        (\fun (positiveDifference: EventuallyPositive (sub y x)) =>
          Logic.Or[SeqLe x y, SeqLe y x]::left
            (Logic.Or[Equivalent x y,
              EventuallyPositive (sub y x)]::right positiveDifference))
        (\fun (negativeDifference: EventuallyNegative (sub y x)) =>
          Logic.Or[SeqLe x y, SeqLe y x]::right
            (Logic.Or[Equivalent y x,
              EventuallyPositive (sub x y)]::right
              (eventuallyPositiveStable (neg (sub y x)) (sub x y)
                (subNeg y x)
                (eventuallyPositiveNegOfNegative (sub y x)
                  negativeDifference))))
        (nonEquivalentApart (sub y x) differenceNonzero))
    (Classical.excludedMiddle (Equivalent (sub y x) zero));

\definition subAddSameLeft (z, x, y: CauchySeq):
    Equivalent (sub (add z y) (add z x)) (sub y x) :=
  pointwiseFractionEquivalent
    (sub (add z y) (add z x)) (sub y x)
    (\fun (n: Nat) => RationalFractions.fractionEqTrans _ _ _
      (subAdd (at z n) (at z n) (at y n) (at x n))
      (RationalFractions.fractionEqTrans _ _ _
        (RationalOperations.fractionAddRespects
          (subRat (at z n) (at z n)) zeroRat
          (subRat (at y n) (at x n)) (subRat (at y n) (at x n))
          (RationalOperations.fractionSubSelf (at z n))
          (RationalFractions.fractionEqRefl _))
        (RationalOperations.fractionAddZeroLeft
          (subRat (at y n) (at x n)))));

\definition seqLeAddLeft (z, x, y: CauchySeq)
    (xy: SeqLe x y): SeqLe (add z x) (add z y) :=
  Logic.orElim (Equivalent x y) (EventuallyPositive (sub y x))
    (SeqLe (add z x) (add z y))
    (\fun (same: Equivalent x y) =>
      Logic.Or[Equivalent (add z x) (add z y),
        EventuallyPositive (sub (add z y) (add z x))]::left
        (addRespects z z x y (equivalentRefl z) same))
    (\fun (positiveDifference: EventuallyPositive (sub y x)) =>
      Logic.Or[Equivalent (add z x) (add z y),
        EventuallyPositive (sub (add z y) (add z x))]::right
        (eventuallyPositiveStable (sub y x)
          (sub (add z y) (add z x))
          (equivalentSym (sub (add z y) (add z x)) (sub y x)
            (subAddSameLeft z x y)) positiveDifference))
    xy;

\definition subZeroEquivalent (x: CauchySeq): Equivalent (sub x zero) x :=
  pointwiseFractionEquivalent (sub x zero) x
    (\fun (n: Nat) => RationalOperations.fractionSubZeroRight (at x n));

\definition eventuallyPositiveMul (x, y: CauchySeq)
    (positiveX: EventuallyPositive x)
    (positiveY: EventuallyPositive y): EventuallyPositive (mul x y) :=
  \block {
    \takefrom r: \Cast[Rat] ({ r : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r (at x n)] } }) \by positiveX \then
    \takefrom M: \Cast[Nat] ({ k : Nat \where
        Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le r (at x n)] }) \by \bysub(Rat, { r : Rat \where
      \exists { k : Nat \where
        Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le r (at x n)] } }, r) \then
    \takefrom s: \Cast[Rat] ({ s : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive s,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le s (at y n)] } }) \by positiveY \then
    \takefrom N: \Cast[Nat] ({ k : Nat \where
        Logic.And[Positive s,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le s (at y n)] }) \by \bysub(Rat, { s : Rat \where
      \exists { k : Nat \where
        Logic.And[Positive s,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le s (at y n)] } }, s) \then
    \return \exact(
        \into[Rat](mulRat r s, { t : Rat \where
          \exists { k : Nat \where
            Logic.And[Positive t,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le t (at (mul x y) n)] } }) \by {
          \exact(
            \into[Nat](commonBound M N, { k : Nat \where
              Logic.And[Positive (mulRat r s),
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le (mulRat r s)
                    (at (mul x y) n)] }) \by {
              Logic.And[Positive (mulRat r s),
                \forall (n: Nat) -> NatLe (commonBound M N) n ->
                  RationalOperations.Le (mulRat r s)
                    (at (mul x y) n)]::#
                (RationalOperations.zeroLtMulPositive r s
                  #left{(\bysub(Nat, { k : Nat \where
                    Logic.And[Positive r,
                      \forall (j: Nat) -> NatLe k j ->
                        RationalOperations.Le r (at x j)] }, M))}
                  #left{(\bysub(Nat, { k : Nat \where
                    Logic.And[Positive s,
                      \forall (j: Nat) -> NatLe k j ->
                        RationalOperations.Le s (at y j)] }, N))})
                (\fun (n: Nat) =>
                  \fun (Kn: NatLe (commonBound M N) n) =>
                    \block {
                      \let product: Logic.And[
                          Positive (mulRat (at x n) (at y n)),
                          RationalOperations.Le (mulRat r s)
                            (mulRat (at x n) (at y n))] :=
                        positiveProductLowerTwo r s (at x n) (at y n)
                          #left{(\bysub(Nat, { k : Nat \where
                            Logic.And[Positive r,
                              \forall (j: Nat) -> NatLe k j ->
                                RationalOperations.Le r (at x j)] }, M))}
                          #left{(\bysub(Nat, { k : Nat \where
                            Logic.And[Positive s,
                              \forall (j: Nat) -> NatLe k j ->
                                RationalOperations.Le s (at y j)] }, N))}
                          (#right{(\bysub(Nat, { k : Nat \where
                            Logic.And[Positive r,
                              \forall (j: Nat) -> NatLe k j ->
                                RationalOperations.Le r (at x j)] }, M))}
                            n (NL.leTrans M (commonBound M N) n
                              (leftLeCommonBound M N) Kn))
                          (#right{(\bysub(Nat, { k : Nat \where
                            Logic.And[Positive s,
                              \forall (j: Nat) -> NatLe k j ->
                                RationalOperations.Le s (at y j)] }, N))}
                            n (NL.leTrans N (commonBound M N) n
                              (rightLeCommonBound M N) Kn)) \then
                      \return #right{product}
                    }) },
            \Cast[Nat] ({ k : Nat \where
              Logic.And[Positive (mulRat r s),
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le (mulRat r s)
                    (at (mul x y) n)] })) },
        \Cast[Rat] ({ t : Rat \where
          \exists { k : Nat \where
            Logic.And[Positive t,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le t (at (mul x y) n)] } }))
  };

\definition seqLeZeroPositive (x: CauchySeq)
    (positiveX: EventuallyPositive x): SeqLe zero x :=
  Logic.Or[Equivalent zero x, EventuallyPositive (sub x zero)]::right
    (eventuallyPositiveStable x (sub x zero)
      (equivalentSym (sub x zero) x (subZeroEquivalent x)) positiveX);

\definition seqLeMulNonnegative (x, y: CauchySeq)
    (zeroX: SeqLe zero x) (zeroY: SeqLe zero y):
    SeqLe zero (mul x y) :=

  Logic.orElim (Equivalent zero x) (EventuallyPositive (sub x zero))
    (SeqLe zero (mul x y))
    (\fun (xZero: Equivalent zero x) =>
      Logic.Or[Equivalent zero (mul x y),
        EventuallyPositive (sub (mul x y) zero)]::left
        (equivalentSym (mul x y) zero
          (equivalentTrans (mul x y) (mul zero y) zero
            (mulRespects x zero y y (equivalentSym zero x xZero)
              (equivalentRefl y))
            (mulZeroLeft y))))
    (\fun (xPositiveDifference: EventuallyPositive (sub x zero)) =>
      Logic.orElim (Equivalent zero y)
        (EventuallyPositive (sub y zero))
        (SeqLe zero (mul x y))
        (\fun (yZero: Equivalent zero y) =>
          Logic.Or[Equivalent zero (mul x y),
            EventuallyPositive (sub (mul x y) zero)]::left
            (equivalentSym (mul x y) zero
              (equivalentTrans (mul x y) (mul x zero) zero
                (mulRespects x x y zero (equivalentRefl x)
                  (equivalentSym zero y yZero))
                (equivalentTrans (mul x zero) (mul zero x) zero
                  (mulComm x zero) (mulZeroLeft x)))))
        (\fun (yPositiveDifference: EventuallyPositive (sub y zero)) =>
          seqLeZeroPositive (mul x y)
            (eventuallyPositiveMul x y
              (eventuallyPositiveStable (sub x zero) x
                (subZeroEquivalent x) xPositiveDifference)
              (eventuallyPositiveStable (sub y zero) y
                (subZeroEquivalent y) yPositiveDifference)))
        zeroY)
    zeroX;
