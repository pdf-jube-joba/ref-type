\import std.Set[].Quotient[
  A := CauchySeq::[Set], Equivalent := Equivalent,
  equivalentRefl := equivalentRefl, equivalentSym := equivalentSym, equivalentTrans := equivalentTrans
] \as Q;

\definition ClassOf: CauchySeq::[Set] -> \Pow CauchySeq::[Set] := Q.ClassOf;
\definition classOfEq: \forall (x, y: CauchySeq::[Set]) -> Equivalent x y -> ClassOf x = ClassOf y := Q.classOfEq;
\definition IsClass: \Pow CauchySeq::[Set] -> \Prop := Q.IsClass;
\definition ClassSet: \Pow (\Pow CauchySeq::[Set]) := Q.ClassSet;
\definition Real: \Set := Q.Carrier;
\definition mem: Real -> CauchySeq::[Set] -> \Prop := Q.mem;
\definition underlying: Real -> \Pow CauchySeq::[Set] := Q.underlying;
\definition Eq: Real -> Real -> \Prop := Q.Eq;
\definition eqByExt: \forall (x, y: Real) ->
  (\forall (a: CauchySeq::[Set]) -> mem x a -> mem y a) -> (\forall (a: CauchySeq::[Set]) -> mem y a -> mem x a) -> Eq x y := Q.eqByExt;
\definition classIsClass: \forall (x: CauchySeq::[Set]) -> IsClass (ClassOf x) := Q.classIsClass;
\definition class: CauchySeq::[Set] -> Real := Q.class;
\definition classMem: \forall (x, y: CauchySeq::[Set]) ->
  Equivalent x y -> mem (class x) y := Q.classMem;
\definition relatedOfClassMem: \forall (x, y: CauchySeq::[Set]) ->
  mem (class x) y -> Equivalent x y := Q.relatedOfClassMem;
\definition equivalentOfClassEq: \forall (x, y: CauchySeq::[Set]) ->
  ClassOf x = ClassOf y -> Equivalent x y := Q.equivalentOfClassEq;

\definition quotientInduction: \forall (P: Real -> \Prop) ->
  (\forall (x: CauchySeq::[Set]) -> P (class x)) ->
  \forall (x: Real) -> P x :=
  Q.induction;

\definition UnaryImage: (CauchySeq::[Set] -> CauchySeq::[Set]) ->
  \Pow CauchySeq::[Set] -> \Pow CauchySeq::[Set] := Q.UnaryImage;
\definition BinaryImage: (CauchySeq::[Set] -> CauchySeq::[Set] -> CauchySeq::[Set]) ->
  \Pow CauchySeq::[Set] -> \Pow CauchySeq::[Set] -> \Pow CauchySeq::[Set] := Q.BinaryImage;
\definition unaryImageClosed: \forall (f: CauchySeq::[Set] -> CauchySeq::[Set]) ->
  Q.UnaryRespects f -> \forall (x: Real) -> IsClass (UnaryImage f x) :=
  Q.unaryImageClosed;
\definition binaryImageClosed: \forall (f: CauchySeq::[Set] -> CauchySeq::[Set] -> CauchySeq::[Set]) ->
  Q.BinaryRespects f -> \forall (x, y: Real) -> IsClass (BinaryImage f x y) :=
  Q.binaryImageClosed;
\definition unaryImageClass: \forall (f: CauchySeq::[Set] -> CauchySeq::[Set]) ->
  \forall (respects: Q.UnaryRespects f) -> \forall (x: CauchySeq::[Set]) ->
    UnaryImage f (class x) = ClassOf (f x) :=
  \fun (f: CauchySeq::[Set] -> CauchySeq::[Set]) =>
    \fun (respects: Q.UnaryRespects f) => \fun (x: CauchySeq::[Set]) =>
      Q.unaryImageClass f respects (class x) x (\refl(ClassOf x));
\definition binaryImageClass: \forall (f: CauchySeq::[Set] -> CauchySeq::[Set] -> CauchySeq::[Set]) ->
  \forall (respects: Q.BinaryRespects f) -> \forall (x, y: CauchySeq::[Set]) ->
    BinaryImage f (class x) (class y) = ClassOf (f x y) :=
  \fun (f: CauchySeq::[Set] -> CauchySeq::[Set] -> CauchySeq::[Set]) =>
    \fun (respects: Q.BinaryRespects f) => \fun (x, y: CauchySeq::[Set]) =>
      Q.binaryImageClass f respects (class x) (class y) x y
        (\refl(ClassOf x)) (\refl(ClassOf y));

/*
 * Arithmetic is first formed as a relational image of whole classes.
 * No representative is selected.  The closure obligations state that
 * these images are again single equivalence classes.
 */
\module Operations;
