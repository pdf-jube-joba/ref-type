\definition AddClass (x, y: Real): \Pow CauchySeq::[Set] :=
    BinaryImage Sequences.AddCauchy x y;

\definition NegClass (x: Real): \Pow CauchySeq::[Set] :=
    UnaryImage Sequences.NegCauchy x;

\definition MulClass (x, y: Real): \Pow CauchySeq::[Set] :=
    BinaryImage Sequences.MulCauchy x y;

\definition addClassIsClass: \forall (x, y: Real) ->
  IsClass (AddClass x y) :=
  binaryImageClosed Sequences.AddCauchy S.addRespects;
\definition negClassIsClass: \forall (x: Real) ->
  IsClass (NegClass x) :=
  unaryImageClosed Sequences.NegCauchy S.negRespects;
\definition mulClassIsClass: \forall (x, y: Real) ->
  IsClass (MulClass x y) :=
  binaryImageClosed Sequences.MulCauchy S.mulRespects;
