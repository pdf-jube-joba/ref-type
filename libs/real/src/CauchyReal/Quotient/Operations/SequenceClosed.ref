\definition ConstCauchy (a: Rat): CauchySeq::[Set] :=
    CauchySeq { sequence := ConstSeq a } \with { cauchy := constCauchy a };

\definition AddCauchy (x, y: CauchySeq::[Set]): CauchySeq::[Set] :=
    CauchySeq { sequence := AddSeq x y } \with { cauchy := addCauchy x y };

\definition MulCauchy (x, y: CauchySeq::[Set]): CauchySeq::[Set] :=
    CauchySeq { sequence := MulSeq x y } \with { cauchy := mulCauchy x y };

\definition NegCauchy (x: CauchySeq::[Set]): CauchySeq::[Set] :=
    CauchySeq { sequence := NegSeq x } \with { cauchy := negCauchy x };

\definition AddClass (x, y: Real): \Pow CauchySeq::[Set] :=
    BinaryImage AddCauchy x y;

\definition NegClass (x: Real): \Pow CauchySeq::[Set] :=
    UnaryImage NegCauchy x;

\definition MulClass (x, y: Real): \Pow CauchySeq::[Set] :=
    BinaryImage MulCauchy x y;

\definition addClassIsClass: \forall (x, y: Real) ->
  IsClass (AddClass x y) :=
  binaryImageClosed AddCauchy S.addRespects;
\definition negClassIsClass: \forall (x: Real) ->
  IsClass (NegClass x) :=
  unaryImageClosed NegCauchy S.negRespects;
\definition mulClassIsClass: \forall (x, y: Real) ->
  IsClass (MulClass x y) :=
  binaryImageClosed MulCauchy S.mulRespects;

\module ClassClosed;
