\import \parent.Def[] \as Def;

\definition invSpec (x: Real): Def.InverseSpec x (Def.inv x) :=
  \bysub(Real, Def.InverseSet x,
    \choice Def.InverseCandidate x
      \by { existence: Def.inverseExists x, uniqueness: Def.inverseSpecUnique x });

\definition invZero: Def.inv ArithmeticDef.zero = ArithmeticDef.zero :=
  #left{(invSpec ArithmeticDef.zero)} (\refl(ArithmeticDef.zero));

\definition inverseNonzero (x: Real) (nonzero: Logic.Not (x = ArithmeticDef.zero)):
    ArithmeticDef.mul (Def.inv x) x = ArithmeticDef.one :=
  #right{(invSpec x)} nonzero;
