\definition ofRat (a: Rat): Real := class (Sequences.ConstCauchy a);

\definition one: Real := ofRat oneRat;

\definition add (x, y: Real): Real :=
    \into[\Pow CauchySeq::[Set]](Classes.AddClass x y, ClassSet) \by { Classes.addClassIsClass x y };

\definition mul (x, y: Real): Real :=
    \into[\Pow CauchySeq::[Set]](Classes.MulClass x y, ClassSet) \by { Classes.mulClassIsClass x y };

\definition neg (x: Real): Real :=
    \into[\Pow CauchySeq::[Set]](Classes.NegClass x, ClassSet) \by { Classes.negClassIsClass x };

\definition sub (x, y: Real): Real := add x (neg y);

\definition zero: Real := ofRat zeroRat;
