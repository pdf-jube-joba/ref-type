\definition ConstSeq (a: Rat): Sequence := S.ConstSeq a;

\definition AddSeq (x, y: CauchySeq::[Set]): Sequence := \fun (n: Nat) =>
    S.AddSeq x y n;

\definition MulSeq (x, y: CauchySeq::[Set]): Sequence := \fun (n: Nat) =>
    S.MulSeq x y n;

\definition NegSeq (x: CauchySeq::[Set]): Sequence := \fun (n: Nat) => negRat (at x n);

\definition constCauchy: \forall (a: Rat) ->
  IsCauchy (ConstSeq a) := S.constCauchy;
\definition addCauchy: \forall (x, y: CauchySeq::[Set]) ->
  IsCauchy (AddSeq x y) := S.addCauchy;
\definition mulCauchy: \forall (x, y: CauchySeq::[Set]) ->
  IsCauchy (MulSeq x y) := S.mulCauchy;
\definition negCauchy: \forall (x: CauchySeq::[Set]) ->
  IsCauchy (NegSeq x) := S.negCauchy;

\definition ConstCauchy (a: Rat): CauchySeq::[Set] :=
    CauchySeq { sequence := ConstSeq a } \with { cauchy := constCauchy a };

\definition AddCauchy (x, y: CauchySeq::[Set]): CauchySeq::[Set] :=
    CauchySeq { sequence := AddSeq x y } \with { cauchy := addCauchy x y };

\definition MulCauchy (x, y: CauchySeq::[Set]): CauchySeq::[Set] :=
    CauchySeq { sequence := MulSeq x y } \with { cauchy := mulCauchy x y };

\definition NegCauchy (x: CauchySeq::[Set]): CauchySeq::[Set] :=
    CauchySeq { sequence := NegSeq x } \with { cauchy := negCauchy x };
