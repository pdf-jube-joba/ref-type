\import std.Arithmetic[].Rat[].Estimates[] \as Estimates;
\import \parent.Order[] \as O;
\import \parent.Quotient[].Operations[].SequenceClosed[].ClassClosed[] \as C;
\import \parent.Quotient[].Operations[].SequenceClosed[] \as SC;
\import \parent.Sequences[] \as S;
\import real.AxiomaticReals[Carrier := O.Real] \as AR;
\import std.Logic[].Proposition[] \as Logic;

\definition Real: \Set := O.Real;

\definition Member (A: \Pow Real) (x: Real): \Prop :=
  \In[Real] A x;

\definition IsUpperBound (A: \Pow Real) (u: Real): \Prop :=
  \forall (x: Real) -> Member A x -> O.Le x u;

\definition Inhabited (A: \Pow Real): \Prop :=
  \exists { x : Real \where Member A x };

\definition BoundedAbove (A: \Pow Real): \Prop :=
  \exists { u : Real \where IsUpperBound A u };

\definition denominator (n: Nat): Rat := Estimates.denominator n;

\definition denominatorZero:
    RationalFractions.FractionEq (denominator N.Nat^::zero) oneRat := Estimates.denominatorZero;

\definition denominatorSucc (n: Nat): RationalFractions.FractionEq
    (denominator (N.Nat^::succ n)) (addRat (denominator n) oneRat) := Estimates.denominatorSucc n;

\definition denominatorStep (n: Nat):
    ltRat (denominator n) (denominator (N.Nat^::succ n)) := Estimates.denominatorStep n;

\definition denominatorZeroLe: \forall (n: Nat) ->
    RationalOperations.Le (denominator N.Nat^::zero) (denominator n) := Estimates.denominatorZeroLe;

\definition denominatorMonotone: \forall (n, m: Nat) -> NatLe n m ->
    RationalOperations.Le (denominator n) (denominator m) := Estimates.denominatorMonotone;

\definition denominatorPositive (n: Nat): Positive (denominator n) := Estimates.denominatorPositive n;

\definition reciprocalRespectsPositive (x, y: Rat)
    (xPositive: Positive x) (yPositive: Positive y)
    (same: RationalFractions.FractionEq x y):
    RationalFractions.FractionEq
      (RationalOperations.reciprocal x)
      (RationalOperations.reciprocal y) := Estimates.reciprocalRespectsPositive x y xPositive yPositive same;

\definition reciprocalLeReverse (x, y: Rat)
    (xPositive: Positive x) (yPositive: Positive y)
    (xy: RationalOperations.Le x y):
    RationalOperations.Le (RationalOperations.reciprocal y)
      (RationalOperations.reciprocal x) := Estimates.reciprocalLeReverse x y xPositive yPositive xy;

\definition error (n: Nat): Rat := Estimates.error n;

\definition errorPositive (n: Nat): Positive (error n) := Estimates.errorPositive n;

\definition errorAntitone (n, m: Nat) (nm: NatLe n m):
    RationalOperations.Le (error m) (error n) := Estimates.errorAntitone n m nm;

\definition multiple (n: Nat): Rat := Estimates.multiple n;

\definition scaleAsMul (eps: Rat): \forall (n: Nat) ->
    RationalFractions.FractionEq
      (RationalOperations.scaleFraction eps n)
      (mulRat eps (multiple n)) := Estimates.scaleAsMul eps;

\definition naturalTranslateZero (eps: Rat) (n: Nat):
    RationalFractions.FractionEq
      (RationalOperations.naturalTranslate zeroRat eps n)
      (RationalOperations.scaleFraction eps n) := Estimates.naturalTranslateZero eps n;

\definition multipleLtDenominator (n: Nat):
    ltRat (multiple n) (denominator n) := Estimates.multipleLtDenominator n;

\definition errorEventuallySmall (eps: Rat) (positive: Positive eps):
    \exists { k : Nat \where
      \forall (n: Nat) -> NatLe k n -> ltRat (error n) eps } := Estimates.errorEventuallySmall eps positive;

\definition oneBelowExpandedSub (d, B: Rat) (dB: ltRat d B):
    ltRat oneRat (subRat (addRat B oneRat) d) := Estimates.oneBelowExpandedSub d B dB;

\definition shiftedDifference (a, q: Rat):
    RationalFractions.FractionEq (subRat (addRat a q) a) q := Estimates.shiftedDifference a q;

\definition reversedDifference (a, b: Rat):
    RationalFractions.FractionEq
      (subRat a b) (negRat (subRat b a)) := Estimates.reversedDifference a b;

\definition translatedDifferenceLeft (a, b, q: Rat):
    RationalFractions.FractionEq
      (subRat (addRat a q) b)
      (addRat (subRat (addRat a q) a) (subRat a b)) := Estimates.translatedDifferenceLeft a b q;

\definition translatedDifferenceRight (a, b, q: Rat):
    RationalFractions.FractionEq
      (addRat (subRat (addRat a q) a) (subRat a b))
      (subRat q (subRat b a)) := Estimates.translatedDifferenceRight a b q;

\definition translatedDifference (a, b, q: Rat):
    RationalFractions.FractionEq
      (subRat (addRat a q) b)
      (subRat q (subRat b a)) := Estimates.translatedDifference a b q;

\definition constSeqLeOfLt (a, b: Rat) (ab: ltRat a b):
    S.SeqLe (SC.ConstCauchy a) (SC.ConstCauchy b) :=
  Logic.Or[
    Equivalent (SC.ConstCauchy a) (SC.ConstCauchy b),
    S.EventuallyPositive
      (S.sub (SC.ConstCauchy b) (SC.ConstCauchy a))]::right
    (\exact(
      \into[Rat](subRat b a, { r : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r
                (at (S.sub (SC.ConstCauchy b) (SC.ConstCauchy a)) n)] } })
        \by {
          \exact(
            \into[Nat](N.Nat^::zero, { k : Nat \where
              Logic.And[Positive (subRat b a),
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le (subRat b a)
                    (at (S.sub (SC.ConstCauchy b)
                      (SC.ConstCauchy a)) n)] }) \by {
                Logic.And[Positive (subRat b a),
                  \forall (n: Nat) -> NatLe N.Nat^::zero n ->
                    RationalOperations.Le (subRat b a)
                      (at (S.sub (SC.ConstCauchy b)
                        (SC.ConstCauchy a)) n)]::#
                  (RationalOperations.subPositive a b ab)
                  (\fun (n: Nat) =>
                    \fun (_: NatLe N.Nat^::zero n) =>
                      RationalOperations.leOfEq _ _
                        (RationalFractions.fractionEqSym _ _
                          (S.subAsRat (SC.ConstCauchy b)
                            (SC.ConstCauchy a) n))) },
            \Cast[Nat] ({ k : Nat \where
              Logic.And[Positive (subRat b a),
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le (subRat b a)
                    (at (S.sub (SC.ConstCauchy b)
                      (SC.ConstCauchy a)) n)] }))
        },
      \Cast[Rat] ({ r : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r
                (at (S.sub (SC.ConstCauchy b)
                  (SC.ConstCauchy a)) n)] } })));

\definition TranslateSeq (x: CauchySeq::[Set]) (q: Rat): CauchySeq::[Set] :=
  SC.AddCauchy x (SC.ConstCauchy q);

\definition Translate (x: CauchySeq::[Set]) (q: Rat): Real :=
  O.class (TranslateSeq x q);

\definition translateLeOfLt (x: CauchySeq::[Set]) (a, b: Rat)
    (ab: ltRat a b): O.Le (Translate x a) (Translate x b) :=
  O.leClassOf (TranslateSeq x a) (TranslateSeq x b)
    (S.seqLeAddLeft x (SC.ConstCauchy a) (SC.ConstCauchy b)
      (constSeqLeOfLt a b ab));

\definition pairTranslateBound (x, y: CauchySeq::[Set])
    (Bx, By: Rat) (Nx, Ny: Nat)
    (xBound: S.BoundedAt x Bx Nx)
    (yBound: S.BoundedAt y By Ny):
    S.SeqLe y (TranslateSeq x (addRat (addRat By Bx) oneRat)) :=
  Logic.Or[
    Equivalent y (TranslateSeq x (addRat (addRat By Bx) oneRat)),
    S.EventuallyPositive
      (S.sub (TranslateSeq x (addRat (addRat By Bx) oneRat)) y)]::right
    (\exact(
      \into[Rat](oneRat, { r : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r
                (at (S.sub
                  (TranslateSeq x (addRat (addRat By Bx) oneRat)) y)
                  n)] } }) \by {
          \exact(
            \into[Nat](commonBound Nx Ny, { k : Nat \where
              Logic.And[Positive oneRat,
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le oneRat
                    (at (S.sub
                      (TranslateSeq x (addRat (addRat By Bx) oneRat)) y)
                      n)] }) \by {
                Logic.And[Positive oneRat,
                  \forall (n: Nat) -> NatLe (commonBound Nx Ny) n ->
                    RationalOperations.Le oneRat
                      (at (S.sub
                        (TranslateSeq x (addRat (addRat By Bx) oneRat)) y)
                        n)]::# RationalOrder.zeroLtOne
                  (\fun (n: Nat) =>
                    \fun (Kn: NatLe (commonBound Nx Ny) n) =>
                      \block {
                        \let xNear: Close (at x n) zeroRat Bx :=
                          (#right{xBound} n
                            (NL.leTrans Nx (commonBound Nx Ny) n
                              (leftLeCommonBound Nx Ny) Kn)) \then
                        \let yNear: Close (at y n) zeroRat By :=
                          (#right{yBound} n
                            (NL.leTrans Ny (commonBound Nx Ny) n
                              (rightLeCommonBound Nx Ny) Kn)) \then
                        \let dBelow: ltRat
                            (subRat (at y n) (at x n)) (addRat By Bx) :=
                          RationalOperations.ltAdd
                            (at y n) By (negRat (at x n)) Bx
                            (ltBoundOfCloseZero (at y n) By yNear)
                            (negLtBoundOfCloseZero (at x n) Bx xNear) \then
                        \let differenceEq: RationalFractions.FractionEq
                            (at (S.sub
                              (TranslateSeq x
                                (addRat (addRat By Bx) oneRat)) y) n)
                            (subRat (addRat (addRat By Bx) oneRat)
                              (subRat (at y n) (at x n))) :=
                          RationalFractions.fractionEqTrans _ _ _
                            (S.subAsRat
                              (TranslateSeq x
                                (addRat (addRat By Bx) oneRat)) y n)
                            (translatedDifference (at x n) (at y n)
                              (addRat (addRat By Bx) oneRat)) \then
                        \return RationalOperations.leOfLt _ _
                          (RationalOrder.ltReplaceRight oneRat
                            (subRat (addRat (addRat By Bx) oneRat)
                              (subRat (at y n) (at x n)))
                            (at (S.sub
                              (TranslateSeq x
                                (addRat (addRat By Bx) oneRat)) y) n)
                            (RationalFractions.fractionEqSym _ _ differenceEq)
                            (oneBelowExpandedSub
                              (subRat (at y n) (at x n))
                              (addRat By Bx) dBelow))
                      }) },
            \Cast[Nat] ({ k : Nat \where
              Logic.And[Positive oneRat,
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le oneRat
                    (at (S.sub
                      (TranslateSeq x (addRat (addRat By Bx) oneRat)) y)
                      n)] }))
        },
      \Cast[Rat] ({ r : Rat \where
        \exists { k : Nat \where
          Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r
                (at (S.sub
                  (TranslateSeq x (addRat (addRat By Bx) oneRat)) y)
                  n)] } })));

\definition GridValue (step: Rat) (n: Nat): Rat := Estimates.GridValue step n;

\definition translateBeyond (x, y: CauchySeq::[Set]) (step: Rat)
    (positive: Positive step):
    \exists { k : Nat \where
      O.Le (O.class y) (Translate x (GridValue step k)) } :=
  \block {
    \takefrom Bx: \Cast[Rat] ({ B : Rat \where
        \exists { k : Nat \where S.BoundedAt x B k } }) \by S.eventuallyBounded x \then
    \takefrom Nx: \Cast[Nat] ({ k : Nat \where S.BoundedAt x Bx k }) \by \bysub(Rat, { B : Rat \where
      \exists { k : Nat \where S.BoundedAt x B k } }, Bx) \then
    \takefrom By: \Cast[Rat] ({ B : Rat \where
        \exists { k : Nat \where S.BoundedAt y B k } }) \by S.eventuallyBounded y \then
    \takefrom Ny: \Cast[Nat] ({ k : Nat \where S.BoundedAt y By k }) \by \bysub(Rat, { B : Rat \where
      \exists { k : Nat \where S.BoundedAt y B k } }, By) \then
    \takefrom K: \Cast[Nat] ({ k : Nat \where
        ltRat (addRat (addRat By Bx) oneRat)
          (RationalOperations.naturalTranslate zeroRat step k) }) \by RationalOperations.naturalTranslateAbove zeroRat step
      (addRat (addRat By Bx) oneRat) positive \then
    \let initial: O.Le (O.class y)
        (Translate x (addRat (addRat By Bx) oneRat)) :=
      O.leClassOf y
        (TranslateSeq x (addRat (addRat By Bx) oneRat))
        (pairTranslateBound x y Bx By Nx Ny
          (\bysub(Nat,
            { k : Nat \where S.BoundedAt x Bx k }, Nx))
          (\bysub(Nat,
            { k : Nat \where S.BoundedAt y By k }, Ny))) \then
    \let gridAbove: ltRat (addRat (addRat By Bx) oneRat)
        (GridValue step K) :=
      RationalOrder.ltReplaceRight
        (addRat (addRat By Bx) oneRat)
        (RationalOperations.naturalTranslate zeroRat step K)
        (GridValue step K)
        (RationalOperations.naturalTranslateAsGrid
          zeroRat step K)
        (\bysub(Nat, { k : Nat \where
          ltRat (addRat (addRat By Bx) oneRat)
            (RationalOperations.naturalTranslate zeroRat step k) },
          K)) \then
    \return \exact(
      \into[Nat](K, { k : Nat \where
        O.Le (O.class y) (Translate x (GridValue step k)) })
        \by {
          O.leTrans (O.class y)
            (Translate x (addRat (addRat By Bx) oneRat))
            (Translate x (GridValue step K)) initial
            (translateLeOfLt x
              (addRat (addRat By Bx) oneRat)
              (GridValue step K) gridAbove) },
      \Cast[Nat] ({ k : Nat \where
        O.Le (O.class y) (Translate x (GridValue step k)) }))
  };

\definition GridPoint (base: CauchySeq::[Set]) (step: Rat) (n: Nat): Real :=
  Translate base (GridValue step n);

\definition GridUpper (A: \Pow Real) (base: CauchySeq::[Set])
    (step: Rat) (n: Nat): \Prop :=
  IsUpperBound A (GridPoint base step n);

\definition Boundary (A: \Pow Real) (base: CauchySeq::[Set])
    (step: Rat) (n: Nat): \Prop :=
  Logic.Or[
    n = N.Nat^::zero,
    \exists { k : Nat \where
      Logic.And[n = N.Nat^::succ k,
        Logic.Not (GridUpper A base step k)] }];

\definition MinimalGridUpper (A: \Pow Real) (base: CauchySeq::[Set])
    (step: Rat) (n: Nat): \Prop :=
  Logic.And[GridUpper A base step n, Boundary A base step n];

\definition firstGridUpper: \forall (A: \Pow Real) ->
    \forall (base: CauchySeq::[Set]) -> \forall (step: Rat) ->
    \forall (limit: Nat) -> GridUpper A base step limit ->
      \exists { j : Nat \where MinimalGridUpper A base step j } :=
  \fun (A: \Pow Real) =>
    \fun (base: CauchySeq::[Set]) =>
      \fun (step: Rat) =>
        \induction (limit: N.Nat^) \return
          GridUpper A base step limit ->
            \exists { j : Nat \where MinimalGridUpper A base step j }
        \with {
          | zero : (\fun (upper: GridUpper A base step N.Nat^::zero) =>
              \exact(
                \into[Nat](N.Nat^::zero,
                  { j : Nat \where MinimalGridUpper A base step j })
                  \by {
                    Logic.And[
                      GridUpper A base step N.Nat^::zero,
                      Boundary A base step N.Nat^::zero]::#
                      upper
                      (Logic.Or[
                        N.Nat^::zero = N.Nat^::zero,
                        \exists { k : Nat \where Logic.And[
                          N.Nat^::zero = N.Nat^::succ k,
                          Logic.Not (GridUpper A base step k)] }]::left
                        (\refl(N.Nat^::zero))) },
                \Cast[Nat] ({ j : Nat \where
                  MinimalGridUpper A base step j })))
          | succ : (\fun (limit: Nat) =>
              \fun (ih: GridUpper A base step limit ->
                \exists { j : Nat \where
                  MinimalGridUpper A base step j }) =>
                \fun (upper: GridUpper A base step (N.Nat^::succ limit)) =>
                  Logic.orElim (GridUpper A base step limit)
                    (Logic.Not (GridUpper A base step limit))
                    (\exists { j : Nat \where
                      MinimalGridUpper A base step j })
                    ih
                    (\fun (notUpper: Logic.Not
                        (GridUpper A base step limit)) =>
                      \exact(
                        \into[Nat](N.Nat^::succ limit,
                          { j : Nat \where
                            MinimalGridUpper A base step j })
                          \by {
                            Logic.And[
                              GridUpper A base step (N.Nat^::succ limit),
                              Boundary A base step
                                (N.Nat^::succ limit)]::#
                              upper
                              (Logic.Or[
                                N.Nat^::succ limit = N.Nat^::zero,
                                \exists { k : Nat \where Logic.And[
                                  N.Nat^::succ limit = N.Nat^::succ k,
                                  Logic.Not (GridUpper A base step k)] }
                                ]::right
                                (\exact(
                                  \into[Nat](limit, { k : Nat \where
                                    Logic.And[
                                      N.Nat^::succ limit = N.Nat^::succ k,
                                      Logic.Not
                                        (GridUpper A base step k)] })
                                    \by { Logic.And[
                                      N.Nat^::succ limit =
                                        N.Nat^::succ limit,
                                      Logic.Not
                                        (GridUpper A base step limit)]::#
                                      (\refl(N.Nat^::succ limit)) notUpper },
                                  \Cast[Nat] ({ k : Nat \where Logic.And[
                                    N.Nat^::succ limit = N.Nat^::succ k,
                                    Logic.Not
                                      (GridUpper A base step k)] })))) },
                        \Cast[Nat] ({ j : Nat \where
                          MinimalGridUpper A base step j })))
                    (Classical.excludedMiddle
                      (GridUpper A base step limit)))
        };

\definition terminalGridUpper (A: \Pow Real) (base: CauchySeq::[Set])
    (step: Rat) (positive: Positive step)
    (bounded: BoundedAbove A):
    \exists { k : Nat \where GridUpper A base step k } :=
  \block {
    \takefrom u: \Cast[Real] ({ u : Real \where IsUpperBound A u }) \by bounded \then
    \return O.quotientInduction
        (\fun (v: Real) => IsUpperBound A v ->
          \exists { k : Nat \where GridUpper A base step k })
        (\fun (y: CauchySeq::[Set]) =>
          \fun (upper: IsUpperBound A (O.class y)) =>
            \block {
              \takefrom K: \Cast[Nat] ({ k : Nat \where
                  O.Le (O.class y) (Translate base (GridValue step k)) }) \by translateBeyond base y step positive \then
              \return \exact(
                  \into[Nat](K,
                    { k : Nat \where GridUpper A base step k }) \by {
                      \fun (z: Real) => \fun (member: Member A z) =>
                        O.leTrans z (O.class y)
                          (GridPoint base step K) (upper z member)
                          (\bysub(Nat, { k : Nat \where
                            O.Le (O.class y)
                              (Translate base (GridValue step k)) }, K)) },
                  \Cast[Nat] ({ k : Nat \where
                    GridUpper A base step k }))
            })
        u (\bysub(Real, { u : Real \where IsUpperBound A u }, u))
  };

\definition minimalGridUpperExists (A: \Pow Real)
    (base: CauchySeq::[Set]) (step: Rat) (positive: Positive step)
    (bounded: BoundedAbove A):
    \exists { j : Nat \where MinimalGridUpper A base step j } :=
  \block {
    \takefrom K: \Cast[Nat] ({ k : Nat \where GridUpper A base step k }) \by terminalGridUpper A base step positive bounded \then
    \return firstGridUpper A base step K
        (\bysub(Nat, { k : Nat \where GridUpper A base step k }, K))
  };

\definition gridNonnegative (step: Rat) (positive: Positive step):
    \forall (n: Nat) ->
      RationalOperations.Le zeroRat (GridValue step n) := Estimates.gridNonnegative step positive;

\definition successorGridLeOtherPlusStep
    (A: \Pow Real) (base: CauchySeq::[Set])
    (step: Rat) (positive: Positive step) (n: Nat)
    (notUpper: Logic.Not (GridUpper A base step n))
    (otherStep: Rat) (other: Nat)
    (otherUpper: GridUpper A base otherStep other):
    RationalOperations.Le (GridValue step (N.Nat^::succ n))
      (addRat (GridValue otherStep other) step) :=
  \block {
    \let lowerLeOther: RationalOperations.Le (GridValue step n)
        (GridValue otherStep other) :=
      byContradiction
        (RationalOperations.Le (GridValue step n)
          (GridValue otherStep other))
        (\fun (notLe: Logic.Not
            (RationalOperations.Le (GridValue step n)
              (GridValue otherStep other))) =>
          notUpper
            (\fun (z: Real) => \fun (member: Member A z) =>
              O.leTrans z (GridPoint base otherStep other)
                (GridPoint base step n) (otherUpper z member)
                (translateLeOfLt base (GridValue otherStep other)
                  (GridValue step n)
                  (ltOfNotLe (GridValue step n)
                    (GridValue otherStep other) notLe)))) \then
    \return leRespects
      (addRat (GridValue step n) step)
      (GridValue step (N.Nat^::succ n))
      (addRat (GridValue otherStep other) step)
      (addRat (GridValue otherStep other) step)
      (RationalFractions.fractionEqSym _ _
        (RationalOperations.gridSucc zeroRat step n))
      (RationalFractions.fractionEqRefl _)
      (leAddRight (GridValue step n) (GridValue otherStep other)
        step lowerLeOther)
  };

\definition leAddPositiveRight (x, step: Rat)
    (positive: Positive step):
    RationalOperations.Le x (addRat x step) := Estimates.leAddPositiveRight x step positive;

\definition minimalGridLeOtherPlusStep
    (A: \Pow Real) (base: CauchySeq::[Set])
    (step: Rat) (positive: Positive step) (j: Nat)
    (minimal: MinimalGridUpper A base step j)
    (otherStep: Rat) (otherPositive: Positive otherStep) (other: Nat)
    (otherUpper: GridUpper A base otherStep other):
    RationalOperations.Le (GridValue step j)
      (addRat (GridValue otherStep other) step) :=
  Logic.orElim
    (j = N.Nat^::zero)
    (\exists { k : Nat \where
      Logic.And[j = N.Nat^::succ k,
        Logic.Not (GridUpper A base step k)] })
    (RationalOperations.Le (GridValue step j)
      (addRat (GridValue otherStep other) step))
    (\fun (zeroJ: j = N.Nat^::zero) =>
      \idelim N.Nat^::zero = j \with k: Nat =>
        RationalOperations.Le (GridValue step k)
          (addRat (GridValue otherStep other) step)
        \by {
          base: leRespects
            zeroRat (GridValue step N.Nat^::zero)
            (addRat (GridValue otherStep other) step)
            (addRat (GridValue otherStep other) step)
            (RationalFractions.fractionEqSym _ _
              (RationalOperations.gridZero zeroRat step))
            (RationalFractions.fractionEqRefl _)
            (RationalOperations.leTrans zeroRat
              (GridValue otherStep other)
              (addRat (GridValue otherStep other) step)
              (gridNonnegative otherStep otherPositive other)
              (leAddPositiveRight (GridValue otherStep other)
                step positive)),
          equality: sym!{Nat} j N.Nat^::zero zeroJ })
    (\fun (predecessor: \exists { k : Nat \where
        Logic.And[j = N.Nat^::succ k,
          Logic.Not (GridUpper A base step k)] }) =>
      \block {
        \takefrom k: \Cast[Nat] ({ k : Nat \where
            Logic.And[j = N.Nat^::succ k,
              Logic.Not (GridUpper A base step k)] }) \by predecessor \then
        \return \idelim N.Nat^::succ k = j \with i: Nat =>
            RationalOperations.Le (GridValue step i)
              (addRat (GridValue otherStep other) step)
          \by { base: successorGridLeOtherPlusStep A base step positive k
            (#right{(\bysub(Nat, { k : Nat \where Logic.And[
              j = N.Nat^::succ k,
              Logic.Not (GridUpper A base step k)] }, k))})
            otherStep other otherUpper,
          equality: sym!{Nat} j (N.Nat^::succ k)
            (#left{(\bysub(Nat, { k : Nat \where Logic.And[
              j = N.Nat^::succ k,
              Logic.Not (GridUpper A base step k)] }, k))}) }
      })
    #right{minimal};

\definition GridChoiceSet (A: \Pow Real) (base: CauchySeq::[Set])
    (n: Nat): \Pow Nat :=
  { j : Nat \where MinimalGridUpper A base (error n) j };

\definition GridChoice (A: \Pow Real) (base: CauchySeq::[Set])
    (n: Nat): \Set :=
  \Cast[Nat] (GridChoiceSet A base n);

\definition gridChoiceExists (A: \Pow Real) (base: CauchySeq::[Set])
    (bounded: BoundedAbove A):
    \exists (\forall (n: Nat) -> GridChoice A base n) :=
  \axiom:classicalIndefiniteChoice(
    Nat,
    (\fun (n: Nat) => GridChoice A base n),
    (\fun (n: Nat) =>
      minimalGridUpperExists A base (error n) (errorPositive n) bounded));

\definition Approximation (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (n: Nat): Rat :=
  GridValue (error n) (choice n);

\definition chosenMinimal (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (n: Nat):
    MinimalGridUpper A base (error n) (choice n) :=
  \bysub(Nat, GridChoiceSet A base n, choice n);

\definition chosenUpper (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (n: Nat):
    GridUpper A base (error n) (choice n) :=
  #left{(chosenMinimal A base choice n)};

\definition approximationLeOtherPlusError
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (n, m: Nat):
    RationalOperations.Le (Approximation A base choice n)
      (addRat (Approximation A base choice m) (error n)) :=
  minimalGridLeOtherPlusStep A base
    (error n) (errorPositive n) (choice n)
    (chosenMinimal A base choice n)
    (error m) (errorPositive m) (choice m)
    (chosenUpper A base choice m);

\definition subLeOfLeAdd (a, b, e: Rat)
    (h: RationalOperations.Le a (addRat b e)):
    RationalOperations.Le (subRat a b) e := Estimates.subLeOfLeAdd a b e h;

\definition approximationClose
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (eps: Rat) (K, n, m: Nat)
    (small: \forall (j: Nat) -> NatLe K j -> ltRat (error j) eps)
    (Kn: NatLe K n) (Km: NatLe K m):
    Close (Approximation A base choice n)
      (Approximation A base choice m) eps :=
  Logic.And[
    ltRat (subRat (Approximation A base choice n)
      (Approximation A base choice m)) eps,
    ltRat (subRat (Approximation A base choice m)
      (Approximation A base choice n)) eps]::#
    (RationalOperations.leLtTrans
      (subRat (Approximation A base choice n)
        (Approximation A base choice m))
      (error n) eps
      (subLeOfLeAdd
        (Approximation A base choice n)
        (Approximation A base choice m) (error n)
        (approximationLeOtherPlusError A base choice n m))
      (small n Kn))
    (RationalOperations.leLtTrans
      (subRat (Approximation A base choice m)
        (Approximation A base choice n))
      (error m) eps
      (subLeOfLeAdd
        (Approximation A base choice m)
        (Approximation A base choice n) (error m)
        (approximationLeOtherPlusError A base choice m n))
      (small m Km));

\definition approximationCauchy
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n):
    IsCauchy (Approximation A base choice) :=
  \fun (eps: Rat) => \fun (positive: Positive eps) =>
    \block {
      \takefrom K: \Cast[Nat] ({ k : Nat \where
          \forall (n: Nat) -> NatLe k n -> ltRat (error n) eps }) \by errorEventuallySmall eps positive \then
      \return \exact(
          \into[Nat](K, { k : Nat \where
            CauchyAt (Approximation A base choice) eps k }) \by {
              \fun (n, m: Nat) => \fun (Kn: NatLe K n) =>
                \fun (Km: NatLe K m) =>
                  approximationClose A base choice eps K n m
                    (\bysub(Nat, { k : Nat \where
                      \forall (j: Nat) -> NatLe k j ->
                        ltRat (error j) eps }, K)) Kn Km },
          \Cast[Nat] ({ k : Nat \where
            CauchyAt (Approximation A base choice) eps k }))
    };

\definition ApproximationCauchy
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n): CauchySeq::[Set] :=
  CauchySeq { sequence := Approximation A base choice } \with { cauchy := approximationCauchy A base choice };

\definition SupremumSeq
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n): CauchySeq::[Set] :=
  SC.AddCauchy base (ApproximationCauchy A base choice);

\definition Supremum
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n): Real :=
  O.class (SupremumSeq A base choice);

\definition subSelfEquivalentZero (x: CauchySeq::[Set]):
    Equivalent (S.sub x x) S.zero :=
  S.pointwiseFractionEquivalent (S.sub x x) S.zero
    (\fun (n: Nat) =>
      RationalOperations.fractionSubSelf (at x n));

\definition notSeqLeReverseOfPositive (x, y: CauchySeq::[Set])
    (positive: S.EventuallyPositive (S.sub y x)):
    Logic.Not (S.SeqLe y x) :=
  \fun (yx: S.SeqLe y x) =>
    \block {
      \let xy: S.SeqLe x y :=
        Logic.Or[Equivalent x y,
          S.EventuallyPositive (S.sub y x)]::right positive \then
      \let same: Equivalent x y := S.seqLeAntisym x y xy yx \then
      \let differenceZero: Equivalent (S.sub y x) S.zero :=
        equivalentTrans (S.sub y x) (S.sub x x) S.zero
          (S.subRespects y x x x
            (equivalentSym x y same) (equivalentRefl x))
          (subSelfEquivalentZero x) \then
      \return (S.eventuallyPositiveNotZero (S.sub y x) positive)
        differenceZero
    };

\definition seqLeOfNoReversePositive (x, y: CauchySeq::[Set])
    (noReverse: Logic.Not (S.EventuallyPositive (S.sub x y))):
    S.SeqLe x y :=
  Logic.orElim (S.SeqLe x y) (S.SeqLe y x) (S.SeqLe x y)
    (\fun (xy: S.SeqLe x y) => xy)
    (\fun (yx: S.SeqLe y x) =>
      Logic.orElim (Equivalent y x)
        (S.EventuallyPositive (S.sub x y)) (S.SeqLe x y)
        (\fun (same: Equivalent y x) =>
          Logic.Or[Equivalent x y,
            S.EventuallyPositive (S.sub y x)]::left
            (equivalentSym y x same))
        (\fun (positive: S.EventuallyPositive (S.sub x y)) =>
          Logic.falseElim (S.SeqLe x y) (noReverse positive)) yx)
    (S.seqLeTotal x y);

\definition eventuallyPositiveImpossibleOfNonpositive (x: CauchySeq::[Set])
    (nonpositive: \forall (n: Nat) ->
      RationalOperations.Le (at x n) zeroRat):
    Logic.Not (S.EventuallyPositive x) :=
  \fun (positive: S.EventuallyPositive x) =>
    \block {
      \takefrom r: \Cast[Rat] ({ r : Rat \where
          \exists { k : Nat \where Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r (at x n)] } }) \by positive \then
      \takefrom K: \Cast[Nat] ({ k : Nat \where Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le r (at x n)] }) \by \bysub(Rat, { r : Rat \where
        \exists { k : Nat \where Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le r (at x n)] } }, r) \then
      \return RationalOrder.ltIrrefl zeroRat
          (RationalOperations.ltLeTrans zeroRat r zeroRat
            #left{(\bysub(Nat, { k : Nat \where Logic.And[Positive r,
              \forall (n: Nat) -> NatLe k n ->
                RationalOperations.Le r (at x n)] }, K))}
            (RationalOperations.leTrans r (at x K) zeroRat
              (#right{(\bysub(Nat, { k : Nat \where Logic.And[Positive r,
                \forall (n: Nat) -> NatLe k n ->
                  RationalOperations.Le r (at x n)] }, K))}
                K (NL.leRefl K))
              (nonpositive K)))
    };

\definition eventuallyPositiveImpossibleOfErrorBound (x: CauchySeq::[Set])
    (upper: \forall (n: Nat) ->
      RationalOperations.Le (at x n) (error n)):
    Logic.Not (S.EventuallyPositive x) :=
  \fun (positive: S.EventuallyPositive x) =>
    \block {
      \takefrom r: \Cast[Rat] ({ r : Rat \where
          \exists { k : Nat \where Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r (at x n)] } }) \by positive \then
      \takefrom M: \Cast[Nat] ({ k : Nat \where Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le r (at x n)] }) \by \bysub(Rat, { r : Rat \where
        \exists { k : Nat \where Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le r (at x n)] } }, r) \then
      \takefrom N: \Cast[Nat] ({ k : Nat \where
          \forall (n: Nat) -> NatLe k n -> ltRat (error n) r }) \by errorEventuallySmall r
        #left{(\bysub(Nat, { k : Nat \where Logic.And[Positive r,
          \forall (n: Nat) -> NatLe k n ->
            RationalOperations.Le r (at x n)] }, M))} \then
      \let K: Nat := commonBound M N \then
      \let rLeError: RationalOperations.Le r (error K) :=
        RationalOperations.leTrans r (at x K) (error K)
          (#right{(\bysub(Nat, { k : Nat \where Logic.And[Positive r,
            \forall (n: Nat) -> NatLe k n ->
              RationalOperations.Le r (at x n)] }, M))}
            K (leftLeCommonBound M N))
          (upper K) \then
      \return RationalOrder.ltIrrefl r
        (RationalOperations.leLtTrans r (error K) r rLeError
          ((\bysub(Nat, { k : Nat \where
            \forall (n: Nat) -> NatLe k n ->
              ltRat (error n) r }, N))
            K (rightLeCommonBound M N)))
    };

\definition subAddSameLeftRat (a, p, q: Rat):
    RationalFractions.FractionEq
      (subRat (addRat a p) (addRat a q))
      (subRat p q) := Estimates.subAddSameLeftRat a p q;

\definition subLeZeroOfLe (a, b: Rat)
    (ab: RationalOperations.Le a b):
    RationalOperations.Le (subRat a b) zeroRat := Estimates.subLeZeroOfLe a b ab;

\definition supremumMinusGridAt
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (n, i: Nat): RationalFractions.FractionEq
    (at (S.sub (SupremumSeq A base choice)
      (TranslateSeq base (Approximation A base choice n))) i)
    (subRat (Approximation A base choice i)
      (Approximation A base choice n)) :=
  RationalFractions.fractionEqTrans _ _ _
    (S.subAsRat (SupremumSeq A base choice)
      (TranslateSeq base (Approximation A base choice n)) i)
    (subAddSameLeftRat (at base i)
      (Approximation A base choice i)
      (Approximation A base choice n));

\definition supremumMinusGridLeError
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (n, i: Nat): RationalOperations.Le
    (at (S.sub (SupremumSeq A base choice)
      (TranslateSeq base (Approximation A base choice n))) i)
    (error i) :=
  leRespects
    (subRat (Approximation A base choice i)
      (Approximation A base choice n))
    (at (S.sub (SupremumSeq A base choice)
      (TranslateSeq base (Approximation A base choice n))) i)
    (error i) (error i)
    (RationalFractions.fractionEqSym _ _
      (supremumMinusGridAt A base choice n i))
    (RationalFractions.fractionEqRefl _)
    (subLeOfLeAdd
      (Approximation A base choice i)
      (Approximation A base choice n) (error i)
      (approximationLeOtherPlusError A base choice i n));

\definition supremumSeqLeGrid
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (n: Nat): S.SeqLe (SupremumSeq A base choice)
      (TranslateSeq base (Approximation A base choice n)) :=
  seqLeOfNoReversePositive
    (SupremumSeq A base choice)
    (TranslateSeq base (Approximation A base choice n))
    (eventuallyPositiveImpossibleOfErrorBound
      (S.sub (SupremumSeq A base choice)
        (TranslateSeq base (Approximation A base choice n)))
      (supremumMinusGridLeError A base choice n));

\definition EnvelopeSeq
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (n: Nat): CauchySeq::[Set] :=
  SC.AddCauchy (SupremumSeq A base choice)
    (SC.ConstCauchy (error n));

\definition gridMinusEnvelopeAt
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (n, i: Nat): RationalFractions.FractionEq
    (at (S.sub
      (TranslateSeq base (Approximation A base choice n))
      (EnvelopeSeq A base choice n)) i)
    (subRat (Approximation A base choice n)
      (addRat (Approximation A base choice i) (error n))) :=
  RationalFractions.fractionEqTrans _ _ _
    (S.subAsRat
      (TranslateSeq base (Approximation A base choice n))
      (EnvelopeSeq A base choice n) i)
    (RationalFractions.fractionEqTrans _ _ _
      (subRespects
        (addRat (at base i) (Approximation A base choice n))
        (addRat (at base i) (Approximation A base choice n))
        (addRat (addRat (at base i) (Approximation A base choice i))
          (error n))
        (addRat (at base i)
          (addRat (Approximation A base choice i) (error n)))
        (RationalFractions.fractionEqRefl _)
        (RationalOperations.fractionAddAssoc (at base i)
          (Approximation A base choice i) (error n)))
      (subAddSameLeftRat (at base i)
        (Approximation A base choice n)
        (addRat (Approximation A base choice i) (error n))));

\definition gridMinusEnvelopeNonpositive
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (n, i: Nat): RationalOperations.Le
    (at (S.sub
      (TranslateSeq base (Approximation A base choice n))
      (EnvelopeSeq A base choice n)) i) zeroRat :=
  leRespects
    (subRat (Approximation A base choice n)
      (addRat (Approximation A base choice i) (error n)))
    (at (S.sub
      (TranslateSeq base (Approximation A base choice n))
      (EnvelopeSeq A base choice n)) i)
    zeroRat zeroRat
    (RationalFractions.fractionEqSym _ _
      (gridMinusEnvelopeAt A base choice n i))
    (RationalFractions.fractionEqRefl _)
    (subLeZeroOfLe
      (Approximation A base choice n)
      (addRat (Approximation A base choice i) (error n))
      (approximationLeOtherPlusError A base choice n i));

\definition gridLeEnvelope
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (n: Nat): S.SeqLe
    (TranslateSeq base (Approximation A base choice n))
    (EnvelopeSeq A base choice n) :=
  seqLeOfNoReversePositive
    (TranslateSeq base (Approximation A base choice n))
    (EnvelopeSeq A base choice n)
    (eventuallyPositiveImpossibleOfNonpositive
      (S.sub
        (TranslateSeq base (Approximation A base choice n))
        (EnvelopeSeq A base choice n))
      (gridMinusEnvelopeNonpositive A base choice n));

\definition halfLeRemainingGap (r, e, d: Rat)
    (positive: Positive r) (small: ltRat e (half r))
    (rd: RationalOperations.Le r d):
    RationalOperations.Le (half r) (subRat d e) := Estimates.halfLeRemainingGap r e d positive small rd;

\definition subAddRightRat (x, y, e: Rat):
    RationalFractions.FractionEq
      (subRat x (addRat y e)) (subRat (subRat x y) e) := Estimates.subAddRightRat x y e;

\definition removeConstantAt (x, y: CauchySeq::[Set]) (e: Rat) (n: Nat):
    RationalFractions.FractionEq
      (at (S.sub x (SC.AddCauchy y (SC.ConstCauchy e))) n)
      (subRat (at (S.sub x y) n) e) :=
  RationalFractions.fractionEqTrans _ _ _
    (S.subAsRat x (SC.AddCauchy y (SC.ConstCauchy e)) n)
    (RationalFractions.fractionEqTrans _ _ _
      (subAddRightRat (at x n) (at y n) e)
      (subRespects
        (subRat (at x n) (at y n)) (at (S.sub x y) n)
        e e
        (RationalFractions.fractionEqSym _ _
          (S.subAsRat x y n))
        (RationalFractions.fractionEqRefl _)));

\definition seqLeAddRight (x, y, z: CauchySeq::[Set])
    (xy: S.SeqLe x y): S.SeqLe (S.add x z) (S.add y z) :=
  S.seqLeRespects (S.add z x) (S.add x z)
    (S.add z y) (S.add y z)
    (S.addComm z x) (S.addComm z y)
    (S.seqLeAddLeft z x y xy);

\definition translateZeroEquivalent (x: CauchySeq::[Set]):
    Equivalent (TranslateSeq x zeroRat) x :=
  S.pointwiseFractionEquivalent (TranslateSeq x zeroRat) x
    (\fun (n: Nat) =>
      RationalOperations.fractionAddZeroRight (at x n));

\definition translateGridZeroEquivalent (x: CauchySeq::[Set]) (step: Rat):
    Equivalent (TranslateSeq x (GridValue step N.Nat^::zero)) x :=
  S.pointwiseFractionEquivalent
    (TranslateSeq x (GridValue step N.Nat^::zero)) x
    (\fun (n: Nat) =>
      RationalFractions.fractionEqTrans _ _ _
        (RationalOperations.fractionAddRespects
          (at x n) (at x n)
          (GridValue step N.Nat^::zero) zeroRat
          (RationalFractions.fractionEqRefl _)
          (RationalOperations.gridZero zeroRat step))
        (RationalOperations.fractionAddZeroRight (at x n)));

\definition seqLeTranslatePositive (x: CauchySeq::[Set]) (step: Rat)
    (positive: Positive step): S.SeqLe x (TranslateSeq x step) :=
  S.seqLeTrans x (TranslateSeq x zeroRat) (TranslateSeq x step)
    (Logic.Or[Equivalent x (TranslateSeq x zeroRat),
      S.EventuallyPositive (S.sub (TranslateSeq x zeroRat) x)]::left
      (equivalentSym (TranslateSeq x zeroRat) x
        (translateZeroEquivalent x)))
    (S.seqLeAddLeft x (SC.ConstCauchy zeroRat)
      (SC.ConstCauchy step) (constSeqLeOfLt zeroRat step positive));

\definition translateGridSuccEquivalent (base: CauchySeq::[Set])
    (step: Rat) (n: Nat): Equivalent
    (TranslateSeq base (GridValue step (N.Nat^::succ n)))
    (S.add (TranslateSeq base (GridValue step n))
      (SC.ConstCauchy step)) :=
  S.pointwiseFractionEquivalent
    (TranslateSeq base (GridValue step (N.Nat^::succ n)))
    (S.add (TranslateSeq base (GridValue step n))
      (SC.ConstCauchy step))
    (\fun (i: Nat) =>
      RationalFractions.fractionEqTrans _ _ _
        (RationalOperations.fractionAddRespects
          (at base i) (at base i)
          (GridValue step (N.Nat^::succ n))
          (addRat (GridValue step n) step)
          (RationalFractions.fractionEqRefl _)
          (RationalOperations.gridSucc zeroRat step n))
        (RationalFractions.fractionEqSym _ _
          (RationalOperations.fractionAddAssoc
            (at base i) (GridValue step n) step)));

\definition predecessorGridLeUpper
    (A: \Pow Real) (base: CauchySeq::[Set]) (step: Rat) (n: Nat)
    (notUpper: Logic.Not (GridUpper A base step n))
    (y: CauchySeq::[Set]) (upper: IsUpperBound A (O.class y)):
    O.Le (GridPoint base step n) (O.class y) :=
  Logic.orElim
    (O.Le (GridPoint base step n) (O.class y))
    (O.Le (O.class y) (GridPoint base step n))
    (O.Le (GridPoint base step n) (O.class y))
    (\fun (lower: O.Le (GridPoint base step n) (O.class y)) => lower)
    (\fun (reverse: O.Le (O.class y) (GridPoint base step n)) =>
      Logic.falseElim (O.Le (GridPoint base step n) (O.class y))
        (notUpper
          (\fun (z: Real) => \fun (member: Member A z) =>
            O.leTrans z (O.class y) (GridPoint base step n)
              (upper z member) reverse)))
    (O.leTotal (GridPoint base step n) (O.class y));

\definition successorGridLeTranslatedUpper
    (A: \Pow Real) (base: CauchySeq::[Set])
    (step: Rat) (positive: Positive step) (n: Nat)
    (notUpper: Logic.Not (GridUpper A base step n))
    (y: CauchySeq::[Set]) (upper: IsUpperBound A (O.class y)):
    S.SeqLe (TranslateSeq base (GridValue step (N.Nat^::succ n)))
      (TranslateSeq y step) :=
  S.seqLeRespects
    (S.add (TranslateSeq base (GridValue step n))
      (SC.ConstCauchy step))
    (TranslateSeq base (GridValue step (N.Nat^::succ n)))
    (S.add y (SC.ConstCauchy step))
    (TranslateSeq y step)
    (equivalentSym _ _ (translateGridSuccEquivalent base step n))
    (equivalentRefl (TranslateSeq y step))
    (seqLeAddRight
      (TranslateSeq base (GridValue step n)) y
      (SC.ConstCauchy step)
      (O.seqLeOfClassLe (TranslateSeq base (GridValue step n)) y
        (predecessorGridLeUpper A base step n notUpper y upper)));

\definition minimalGridLeTranslatedUpper
    (A: \Pow Real) (base: CauchySeq::[Set]) (baseMember: Member A (O.class base))
    (step: Rat) (positive: Positive step) (j: Nat)
    (minimal: MinimalGridUpper A base step j)
    (y: CauchySeq::[Set]) (upper: IsUpperBound A (O.class y)):
    S.SeqLe (TranslateSeq base (GridValue step j))
      (TranslateSeq y step) :=
  Logic.orElim
    (j = N.Nat^::zero)
    (\exists { k : Nat \where Logic.And[
      j = N.Nat^::succ k,
      Logic.Not (GridUpper A base step k)] })
    (S.SeqLe (TranslateSeq base (GridValue step j))
      (TranslateSeq y step))
    (\fun (zeroJ: j = N.Nat^::zero) =>
      \idelim N.Nat^::zero = j \with k: Nat =>
        S.SeqLe (TranslateSeq base (GridValue step k))
          (TranslateSeq y step)
        \by {
          base: S.seqLeTrans
            (TranslateSeq base (GridValue step N.Nat^::zero))
            base (TranslateSeq y step)
            (Logic.Or[Equivalent
                (TranslateSeq base (GridValue step N.Nat^::zero)) base,
              S.EventuallyPositive
                (S.sub base
                  (TranslateSeq base
                    (GridValue step N.Nat^::zero)))]::left
              (translateGridZeroEquivalent base step))
            (S.seqLeTrans base y (TranslateSeq y step)
              (O.seqLeOfClassLe base y (upper (O.class base) baseMember))
              (seqLeTranslatePositive y step positive)),
          equality: sym!{Nat} j N.Nat^::zero zeroJ })
    (\fun (predecessor: \exists { k : Nat \where Logic.And[
        j = N.Nat^::succ k,
        Logic.Not (GridUpper A base step k)] }) =>
      \block {
        \takefrom k: \Cast[Nat] ({ k : Nat \where Logic.And[
            j = N.Nat^::succ k,
            Logic.Not (GridUpper A base step k)] }) \by predecessor \then
        \return \idelim N.Nat^::succ k = j \with i: Nat =>
            S.SeqLe (TranslateSeq base (GridValue step i))
              (TranslateSeq y step)
          \by { base: successorGridLeTranslatedUpper A base step positive k
            (#right{(\bysub(Nat, { k : Nat \where Logic.And[
              j = N.Nat^::succ k,
              Logic.Not (GridUpper A base step k)] }, k))}) y upper,
          equality: sym!{Nat} j (N.Nat^::succ k)
            (#left{(\bysub(Nat, { k : Nat \where Logic.And[
              j = N.Nat^::succ k,
              Logic.Not (GridUpper A base step k)] }, k))}) }
      })
    #right{minimal};

\definition positiveAfterSmallConstant (x, y: CauchySeq::[Set])
    (r: Rat) (N: Nat) (positive: Positive r)
    (lower: \forall (i: Nat) -> NatLe N i ->
      RationalOperations.Le r (at (S.sub x y) i))
    (e: Rat) (small: ltRat e (half r)):
    S.EventuallyPositive
      (S.sub x (SC.AddCauchy y (SC.ConstCauchy e))) :=
  \exact(
    \into[Rat](half r, { s : Rat \where
      \exists { k : Nat \where Logic.And[Positive s,
        \forall (i: Nat) -> NatLe k i ->
          RationalOperations.Le s
            (at (S.sub x
              (SC.AddCauchy y (SC.ConstCauchy e))) i)] } })
      \by {
        \exact(
          \into[Nat](N, { k : Nat \where Logic.And[Positive (half r),
            \forall (i: Nat) -> NatLe k i ->
              RationalOperations.Le (half r)
                (at (S.sub x
                  (SC.AddCauchy y (SC.ConstCauchy e))) i)] })
            \by {
              Logic.And[Positive (half r),
                \forall (i: Nat) -> NatLe N i ->
                  RationalOperations.Le (half r)
                    (at (S.sub x
                      (SC.AddCauchy y (SC.ConstCauchy e))) i)]::#
                (halfPositiveOf r positive)
                (\fun (i: Nat) => \fun (Ni: NatLe N i) =>
                  leRespects (half r) (half r)
                    (subRat (at (S.sub x y) i) e)
                    (at (S.sub x
                      (SC.AddCauchy y (SC.ConstCauchy e))) i)
                    (RationalFractions.fractionEqRefl _)
                    (RationalFractions.fractionEqSym _ _
                      (removeConstantAt x y e i))
                    (halfLeRemainingGap r e (at (S.sub x y) i)
                      positive small (lower i Ni))) },
          \Cast[Nat] ({ k : Nat \where Logic.And[Positive (half r),
            \forall (i: Nat) -> NatLe k i ->
              RationalOperations.Le (half r)
                (at (S.sub x
                  (SC.AddCauchy y (SC.ConstCauchy e))) i)] })) },
    \Cast[Rat] ({ s : Rat \where
      \exists { k : Nat \where Logic.And[Positive s,
        \forall (i: Nat) -> NatLe k i ->
          RationalOperations.Le s
            (at (S.sub x
              (SC.AddCauchy y (SC.ConstCauchy e))) i)] } }));

\definition supremumUpperClass
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (x: CauchySeq::[Set]) (member: Member A (O.class x)):
    O.Le (O.class x) (Supremum A base choice) :=
  O.leClassOf x (SupremumSeq A base choice)
    (seqLeOfNoReversePositive x (SupremumSeq A base choice)
      (\fun (positive: S.EventuallyPositive
          (S.sub x (SupremumSeq A base choice))) =>
        \block {
          \takefrom r: \Cast[Rat] ({ r : Rat \where
              \exists { k : Nat \where Logic.And[Positive r,
                \forall (i: Nat) -> NatLe k i -> RationalOperations.Le r
                  (at (S.sub x (SupremumSeq A base choice)) i)] } }) \by positive \then
          \takefrom N: \Cast[Nat] ({ k : Nat \where Logic.And[Positive r,
              \forall (i: Nat) -> NatLe k i -> RationalOperations.Le r
                (at (S.sub x (SupremumSeq A base choice)) i)] }) \by \bysub(Rat, { r : Rat \where
            \exists { k : Nat \where Logic.And[Positive r,
              \forall (i: Nat) -> NatLe k i -> RationalOperations.Le r
                (at (S.sub x (SupremumSeq A base choice)) i)] } }, r) \then
          \takefrom j: \Cast[Nat] ({ j : Nat \where
              \forall (i: Nat) -> NatLe j i ->
                ltRat (error i) (half r) }) \by errorEventuallySmall (half r)
            (halfPositiveOf r
              #left{(\bysub(Nat, { k : Nat \where Logic.And[Positive r,
                \forall (i: Nat) -> NatLe k i -> RationalOperations.Le r
                  (at (S.sub x (SupremumSeq A base choice)) i)] }, N))}) \then
          \let rPositive: Positive r :=
            #left{(\bysub(Nat, { k : Nat \where Logic.And[Positive r,
              \forall (i: Nat) -> NatLe k i -> RationalOperations.Le r
                (at (S.sub x (SupremumSeq A base choice)) i)] }, N))} \then
          \let small: ltRat (error j) (half r) :=
            (\bysub(Nat, { j : Nat \where
              \forall (i: Nat) -> NatLe j i ->
                ltRat (error i) (half r) }, j)) j (NL.leRefl j) \then
          \let positiveEnvelope: S.EventuallyPositive
              (S.sub x (EnvelopeSeq A base choice j)) :=
            positiveAfterSmallConstant x
              (SupremumSeq A base choice) r N rPositive
              (#right{(\bysub(Nat,
                { k : Nat \where Logic.And[Positive r,
                  \forall (i: Nat) -> NatLe k i ->
                    RationalOperations.Le r
                      (at (S.sub x
                        (SupremumSeq A base choice)) i)] }, N))})
              (error j) small \then
          \let xLeEnvelope: O.Le (O.class x)
              (O.class (EnvelopeSeq A base choice j)) :=
            O.leTrans (O.class x)
              (GridPoint base (error j) (choice j))
              (O.class (EnvelopeSeq A base choice j))
              ((chosenUpper A base choice j) (O.class x) member)
              (O.leClassOf
                (TranslateSeq base (Approximation A base choice j))
                (EnvelopeSeq A base choice j)
                (gridLeEnvelope A base choice j)) \then
          \return (notSeqLeReverseOfPositive
              (EnvelopeSeq A base choice j) x positiveEnvelope)
            (O.seqLeOfClassLe x (EnvelopeSeq A base choice j)
              xLeEnvelope)
        }));

\definition supremumUpper
    (A: \Pow Real) (base: CauchySeq::[Set])
    (choice: \forall (n: Nat) -> GridChoice A base n):
    IsUpperBound A (Supremum A base choice) :=
  \fun (x: Real) =>
    O.quotientInduction
      (\fun (z: Real) => Member A z -> O.Le z (Supremum A base choice))
      (\fun (z: CauchySeq::[Set]) =>
        supremumUpperClass A base choice z)
      x;

\definition supremumLeastClass
    (A: \Pow Real) (base: CauchySeq::[Set])
    (baseMember: Member A (O.class base))
    (choice: \forall (n: Nat) -> GridChoice A base n)
    (y: CauchySeq::[Set]) (upper: IsUpperBound A (O.class y)):
    O.Le (Supremum A base choice) (O.class y) :=
  O.leClassOf (SupremumSeq A base choice) y
    (seqLeOfNoReversePositive (SupremumSeq A base choice) y
      (\fun (positive: S.EventuallyPositive
          (S.sub (SupremumSeq A base choice) y)) =>
        \block {
          \takefrom r: \Cast[Rat] ({ r : Rat \where
              \exists { k : Nat \where Logic.And[Positive r,
                \forall (i: Nat) -> NatLe k i -> RationalOperations.Le r
                  (at (S.sub (SupremumSeq A base choice) y) i)] } }) \by positive \then
          \takefrom N: \Cast[Nat] ({ k : Nat \where Logic.And[Positive r,
              \forall (i: Nat) -> NatLe k i -> RationalOperations.Le r
                (at (S.sub (SupremumSeq A base choice) y) i)] }) \by \bysub(Rat, { r : Rat \where
            \exists { k : Nat \where Logic.And[Positive r,
              \forall (i: Nat) -> NatLe k i -> RationalOperations.Le r
                (at (S.sub (SupremumSeq A base choice) y) i)] } }, r) \then
          \takefrom j: \Cast[Nat] ({ j : Nat \where
              \forall (i: Nat) -> NatLe j i ->
                ltRat (error i) (half r) }) \by errorEventuallySmall (half r)
            (halfPositiveOf r
              #left{(\bysub(Nat, { k : Nat \where Logic.And[Positive r,
                \forall (i: Nat) -> NatLe k i -> RationalOperations.Le r
                  (at (S.sub (SupremumSeq A base choice) y) i)] }, N))}) \then
          \let rPositive: Positive r :=
            #left{(\bysub(Nat, { k : Nat \where Logic.And[Positive r,
              \forall (i: Nat) -> NatLe k i -> RationalOperations.Le r
                (at (S.sub (SupremumSeq A base choice) y) i)] }, N))} \then
          \let small: ltRat (error j) (half r) :=
            (\bysub(Nat, { j : Nat \where
              \forall (i: Nat) -> NatLe j i ->
                ltRat (error i) (half r) }, j)) j (NL.leRefl j) \then
          \let positiveTranslated: S.EventuallyPositive
              (S.sub (SupremumSeq A base choice)
                (TranslateSeq y (error j))) :=
            positiveAfterSmallConstant
              (SupremumSeq A base choice) y r N rPositive
              (#right{(\bysub(Nat,
                { k : Nat \where Logic.And[Positive r,
                  \forall (i: Nat) -> NatLe k i ->
                    RationalOperations.Le r
                      (at (S.sub
                        (SupremumSeq A base choice) y) i)] }, N))})
              (error j) small \then
          \let supremumLeTranslated: S.SeqLe
              (SupremumSeq A base choice) (TranslateSeq y (error j)) :=
            S.seqLeTrans (SupremumSeq A base choice)
              (TranslateSeq base (Approximation A base choice j))
              (TranslateSeq y (error j))
              (supremumSeqLeGrid A base choice j)
              (minimalGridLeTranslatedUpper A base baseMember
                (error j) (errorPositive j) (choice j)
                (chosenMinimal A base choice j) y upper) \then
          \return (notSeqLeReverseOfPositive
              (TranslateSeq y (error j))
              (SupremumSeq A base choice) positiveTranslated)
            supremumLeTranslated
        }));

\definition supremumLeast
    (A: \Pow Real) (base: CauchySeq::[Set])
    (baseMember: Member A (O.class base))
    (choice: \forall (n: Nat) -> GridChoice A base n):
    \forall (v: Real) -> IsUpperBound A v ->
      O.Le (Supremum A base choice) v :=
  O.quotientInduction
    (\fun (v: Real) => IsUpperBound A v ->
      O.Le (Supremum A base choice) v)
    (\fun (y: CauchySeq::[Set]) =>
      supremumLeastClass A base baseMember choice y);

\definition supremumLaw
    (A: \Pow Real) (base: CauchySeq::[Set])
    (baseMember: Member A (O.class base))
    (choice: \forall (n: Nat) -> GridChoice A base n):
    AR.IsLeastUpperBound O.raw A (Supremum A base choice) :=
  Logic.And[_, _] {
    left := supremumUpper A base choice,
    right := supremumLeast A base baseMember choice,
  };

\definition completeAtClass (A: \Pow Real) (base: CauchySeq::[Set])
    (baseMember: Member A (O.class base))
    (bounded: BoundedAbove A):
    AR.HasLeastUpperBound O.raw A :=
  \block {
    \takefrom choice: \forall (n: Nat) -> GridChoice A base n \by gridChoiceExists A base bounded \then
    \return \exact(
        \into[Real](Supremum A base choice,
          { u : Real \where AR.IsLeastUpperBound O.raw A u }) \by {
            supremumLaw A base baseMember choice },
        \Cast[Real] ({ u : Real \where
          AR.IsLeastUpperBound O.raw A u }))
  };

\definition complete (A: \Pow Real)
    (inhabited: AR.Inhabited A) (bounded: AR.BoundedAbove O.raw A):
    AR.HasLeastUpperBound O.raw A :=
  \block {
    \takefrom x: \Cast[Real] ({ x : Real \where Member A x }) \by inhabited \then
    \return O.quotientInduction
        (\fun (z: Real) => Member A z -> AR.HasLeastUpperBound O.raw A)
        (\fun (base: CauchySeq::[Set]) =>
          \fun (baseMember: Member A (O.class base)) =>
            completeAtClass A base baseMember bounded)
        x (\bysub(Real, { x : Real \where Member A x }, x))
  };

\definition completeness: AR.Completeness O.raw := complete;

\definition axiomaticLaws: AR.AxiomaticRealStructure::[Law][O.raw] :=
  AR.AxiomaticRealStructure::[Law][O.raw] {
    field := O.fieldLaws,
    order := O.linearOrder,
    orderedField := O.orderedField,
    completeness := completeness,
  };

\definition axiomaticReal: AR.AxiomaticRealStructure::[Set] :=
  \into[AR.AxiomaticRealStructure::[Raw]]
    (O.raw, AR.AxiomaticRealStructure) \by { axiomaticLaws };
