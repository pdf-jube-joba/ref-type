\import \parent.Quotient[].Arithmetic[].Def[] \as C;
\import \parent.Quotient[].Arithmetic[].Prop[] \as CProp;
\import \parent.Quotient[].Inverse[].Def[] \as CInverse;
\import \parent.Quotient[].Inverse[].Prop[] \as CInverseProp;
\import \parent.Quotient[].Sequences[].Def[] \as SC;
\import \parent.Quotient[] \as Q;
\import \parent.Sequences[] \as S;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Rel[] \as Rel;
\import real.AxiomaticReals[Carrier := Q.Real] \as AR;

\definition Real: \Set := Q.Real;
\definition mem: Real -> CauchySeq::[Set] -> \Prop := Q.mem;
\definition class: CauchySeq::[Set] -> Real := Q.class;
\definition classMem: \forall (x, y: CauchySeq::[Set]) ->
  Equivalent x y -> mem (class x) y := Q.classMem;
\definition relatedOfClassMem: \forall (x, y: CauchySeq::[Set]) ->
  mem (class x) y -> Equivalent x y := Q.relatedOfClassMem;
\definition classOfEq: \forall (x, y: CauchySeq::[Set]) ->
  Equivalent x y -> class x = class y := Q.classOfEq;
\definition quotientInduction: \forall (P: Real -> \Prop) ->
  (\forall (x: CauchySeq::[Set]) -> P (class x)) ->
  \forall (x: Real) -> P x := Q.quotientInduction;

\definition Le (x, y: Real): \Prop :=
  \forall (a: CauchySeq::[Set]) -> mem x a ->
    \forall (b: CauchySeq::[Set]) -> mem y b -> S.SeqLe a b;

\definition leClassOf (x, y: CauchySeq::[Set])
    (xy: S.SeqLe x y): Le (class x) (class y) :=
  \fun (a: CauchySeq::[Set]) => \fun (xa: mem (class x) a) =>
    \fun (b: CauchySeq::[Set]) => \fun (yb: mem (class y) b) =>
      S.seqLeRespects x a y b
        (relatedOfClassMem x a xa) (relatedOfClassMem y b yb) xy;

\definition seqLeOfClassLe (x, y: CauchySeq::[Set])
    (xy: Le (class x) (class y)): S.SeqLe x y :=
  xy x (classMem x x (equivalentRefl x))
    y (classMem y y (equivalentRefl y));

\definition leRefl: Rel.Reflexive Q.Real Le :=
  quotientInduction (\fun (x: Real) => Le x x)
    (\fun (x: CauchySeq::[Set]) => leClassOf x x (S.seqLeRefl x));

\definition leTrans: Rel.Transitive Q.Real Le :=
  quotientInduction
    (\fun (x: Real) => \forall (y, z: Real) -> Le x y -> Le y z -> Le x z)
    (\fun (x: CauchySeq::[Set]) =>
      quotientInduction
        (\fun (y: Real) => \forall (z: Real) ->
          Le (class x) y -> Le y z -> Le (class x) z)
        (\fun (y: CauchySeq::[Set]) =>
          quotientInduction
            (\fun (z: Real) => Le (class x) (class y) ->
              Le (class y) z -> Le (class x) z)
            (\fun (z: CauchySeq::[Set]) =>
              \fun (xy: Le (class x) (class y)) =>
                \fun (yz: Le (class y) (class z)) =>
                  leClassOf x z
                    (S.seqLeTrans x y z
                      (seqLeOfClassLe x y xy)
                      (seqLeOfClassLe y z yz)))));

\definition leAntisym: Rel.Antisymmetric Q.Real Le :=
  quotientInduction
    (\fun (x: Real) => \forall (y: Real) -> Le x y -> Le y x -> x = y)
    (\fun (x: CauchySeq::[Set]) =>
      quotientInduction
        (\fun (y: Real) => Le (class x) y -> Le y (class x) ->
          class x = y)
        (\fun (y: CauchySeq::[Set]) =>
          \fun (xy: Le (class x) (class y)) =>
            \fun (yx: Le (class y) (class x)) =>
              classOfEq x y
                (S.seqLeAntisym x y
                  (seqLeOfClassLe x y xy)
                  (seqLeOfClassLe y x yx))));

\definition leTotal: Rel.Total Q.Real Le :=
  quotientInduction
    (\fun (x: Real) => \forall (y: Real) ->
      Logic.Or[Le x y, Le y x])
    (\fun (x: CauchySeq::[Set]) =>
      quotientInduction
        (\fun (y: Real) =>
          Logic.Or[Le (class x) y, Le y (class x)])
        (\fun (y: CauchySeq::[Set]) =>
          either!{
            {S.SeqLe x y} "or" {S.SeqLe y x} "either" {Logic.Or[Le (class x) (class y), Le (class y) (class x)]}
            "lt:" {\fun (xy: S.SeqLe x y) =>
              Logic.Or[Le (class x) (class y),
                Le (class y) (class x)]::left (leClassOf x y xy)}
            "rt:" {\fun (yx: S.SeqLe y x) =>
              Logic.Or[Le (class x) (class y),
                Le (class y) (class x)]::right (leClassOf y x yx)}
          }
            (S.seqLeTotal x y)));

\definition addMonotone: \forall (x, y, z: Real) -> Le x y ->
    Le (C.add z x) (C.add z y) :=
  quotientInduction
    (\fun (x: Real) => \forall (y, z: Real) -> Le x y ->
      Le (C.add z x) (C.add z y))
    (\fun (x: CauchySeq::[Set]) =>
      quotientInduction
        (\fun (y: Real) => \forall (z: Real) -> Le (class x) y ->
          Le (C.add z (class x)) (C.add z y))
        (\fun (y: CauchySeq::[Set]) =>
          quotientInduction
            (\fun (z: Real) => Le (class x) (class y) ->
              Le (C.add z (class x)) (C.add z (class y)))
            (\fun (z: CauchySeq::[Set]) =>
              \fun (xy: Le (class x) (class y)) =>
                \block {
                  \let leftClass:
                    C.add (class z) (class x) = class (SC.AddCauchy z x) :=
                    CProp.addClass z x \then
                  \let rightClass:
                    C.add (class z) (class y) = class (SC.AddCauchy z y) :=
                    CProp.addClass z y \then
                  \return \idelim class (SC.AddCauchy z x) =
                      C.add (class z) (class x)
                    \with left: Real =>
                      Le left (C.add (class z) (class y))
                    \by { base:
                      \idelim class (SC.AddCauchy z y) =
                          C.add (class z) (class y)
                        \with right: Real =>
                          Le (class (SC.AddCauchy z x)) right
                        \by { base: leClassOf (SC.AddCauchy z x)
                            (SC.AddCauchy z y)
                            (S.seqLeAddLeft z x y
                              (seqLeOfClassLe x y xy)),
                          equality: sym!{Real} _ _ rightClass },
                      equality: sym!{Real} _ _ leftClass }
                })));

\definition mulNonnegative: \forall (x, y: Real) ->
    Le C.zero x -> Le C.zero y -> Le C.zero (C.mul x y) :=
  quotientInduction
    (\fun (x: Real) => \forall (y: Real) ->
      Le C.zero x -> Le C.zero y -> Le C.zero (C.mul x y))
    (\fun (x: CauchySeq::[Set]) =>
      quotientInduction
        (\fun (y: Real) => Le C.zero (class x) -> Le C.zero y ->
          Le C.zero (C.mul (class x) y))
        (\fun (y: CauchySeq::[Set]) =>
          \fun (zeroX: Le C.zero (class x)) =>
            \fun (zeroY: Le C.zero (class y)) =>
              \idelim class (SC.MulCauchy x y) = C.mul (class x) (class y)
                \with product: Real => Le C.zero product
                \by { base: leClassOf (SC.ConstCauchy zeroRat)
                    (SC.MulCauchy x y)
                    (S.seqLeMulNonnegative x y
                      (seqLeOfClassLe (SC.ConstCauchy zeroRat) x zeroX)
                      (seqLeOfClassLe (SC.ConstCauchy zeroRat) y zeroY)),
                  equality: sym!{Real} _ _ (CProp.mulClass x y) }));

\definition leRelation: \Pow (Pair.Times^[Real, Real]) :=
  { p : Pair.Times^[Real, Real] \where
    Le (Pair.first Real Real p) (Pair.second Real Real p) };

\definition raw: AR.AxiomaticRealStructure::[Raw] :=
  AR.AxiomaticRealStructure::[Raw]::#
    C.zero C.one C.add C.neg C.mul CInverse.inv leRelation;

\definition linearOrder: AR.LinearOrderLaws[#leRelation{raw}] :=
  AR.LinearOrderLaws[#leRelation{raw}] {
    reflexive := leRefl,
    transitive := leTrans,
    antisymmetric := leAntisym,
    total := leTotal,
  };

\definition orderedField: AR.OrderedFieldLaws[#zero{raw}, #add{raw}, #mul{raw}, #leRelation{raw}] :=
  AR.OrderedFieldLaws[#zero{raw}, #add{raw}, #mul{raw}, #leRelation{raw}]::# addMonotone mulNonnegative;

\definition fieldLaws: AR.FieldLaws[#zero{raw}, #one{raw}, #add{raw}, #neg{raw}, #mul{raw}, #inv{raw}] :=
  AR.FieldLaws[#zero{raw}, #one{raw}, #add{raw}, #neg{raw}, #mul{raw}, #inv{raw}]::#
    CProp.zeroNeOne
    CProp.addZeroLeft
    CProp.addNegLeft
    CProp.addComm
    CProp.addAssoc
    CProp.mulOneLeft
    CProp.mulComm
    CProp.mulAssoc
    CProp.mulAddLeft
    CInverseProp.inverseNonzero;
