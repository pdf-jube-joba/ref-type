\import std.Logic[].Proposition[] \as Logic;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Rel[] \as Rel;
\import std.Logic[].Law[] \as Law;
\use Logic.not;
\use Logic.and;
\use Logic.or;

\definition RelationLe(relation: \Pow (Pair.Times^[Carrier, Carrier])) (x, y: Carrier): \Prop :=
  \In[Pair.Times^[Carrier, Carrier]] relation (Pair.pair _ _ x y);

\definition In (A: \Pow Carrier) (x: Carrier): \Prop := \In[Carrier] A x;

\definition Inhabited (A: \Pow Carrier): \Prop :=
    \exists { x : Carrier \where In A x };

\definition UpperBound(relation: \Pow (Pair.Times^[Carrier, Carrier]))
  (A: \Pow Carrier) (u: Carrier): \Prop :=
  \forall (x: Carrier) -> In A x -> RelationLe relation x u;

\definition Complete(relation: \Pow (Pair.Times^[Carrier, Carrier])): \Prop :=
  \forall (A: \Pow Carrier) -> Inhabited A ->
    (\exists { u: Carrier \where UpperBound relation A u }) ->
    \exists { u: Carrier \where Logic.And[UpperBound relation A u,
      \forall (v: Carrier) -> UpperBound relation A v -> RelationLe relation u v] };

\record FieldLaws[zero, one: Carrier, add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier, mul: Carrier -> Carrier -> Carrier, inv: Carrier -> Carrier]: \Prop := {
  zeroNeOne: not!{{ zero = one }},
  addLeftIdentity: Law.LeftUnital Carrier add zero,
  addLeftInverse: Law.LeftInvertible Carrier add zero neg,
  addCommutative: Law.Commutative Carrier add,
  addAssociative: Law.Associative Carrier add,
  mulLeftIdentity: Law.LeftUnital Carrier mul one,
  mulCommutative: Law.Commutative Carrier mul,
  mulAssociative: Law.Associative Carrier mul,
  leftDistributive: Law.LeftDistributive Carrier mul add,
  inverse: \forall (x: Carrier) -> not!{{ x = zero }} -> mul (inv x) x = one,
};

\record LinearOrderLaws[leRelation: \Pow (Pair.Times^[Carrier, Carrier])]: \Prop := {
  reflexive: Rel.Reflexive Carrier (RelationLe leRelation),
  transitive: Rel.Transitive Carrier (RelationLe leRelation),
  antisymmetric: Rel.Antisymmetric Carrier (RelationLe leRelation),
  total: Rel.Total Carrier (RelationLe leRelation),
};

\record OrderedFieldLaws[zero: Carrier, add: Carrier -> Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier, leRelation: \Pow (Pair.Times^[Carrier, Carrier])]: \Prop := {
  addMonotone: \forall (x, y, z: Carrier) -> RelationLe leRelation x y ->
    RelationLe leRelation (add z x) (add z y),
  nonnegativeMul: \forall (x, y: Carrier) ->
    RelationLe leRelation zero x -> RelationLe leRelation zero y ->
      RelationLe leRelation zero (mul x y),
};

\structure AxiomaticRealStructure: \Set {
  zero: Carrier,
  one: Carrier,
  add: Carrier -> Carrier -> Carrier,
  neg: Carrier -> Carrier,
  mul: Carrier -> Carrier -> Carrier,
  inv: Carrier -> Carrier,
  leRelation: \Pow (Pair.Times^[Carrier, Carrier]),
} \where {
  field: FieldLaws[zero, one, add, neg, mul, inv],
  order: LinearOrderLaws[leRelation],
  orderedField: OrderedFieldLaws[zero, add, mul, leRelation],
  completeness: Complete leRelation,
}

\definition Le (s: AxiomaticRealStructure::[Raw]) (x, y: Carrier): \Prop :=
  RelationLe (#leRelation{s}) x y;

\definition NonZero (s: AxiomaticRealStructure::[Raw]) (x: Carrier): \Prop :=
    not!{{ x = #zero{s} }};

\definition IsUpperBound (s: AxiomaticRealStructure::[Raw]) (A: \Pow Carrier) (u: Carrier): \Prop :=
    \forall (x: Carrier) -> In A x -> Le s x u;

\definition BoundedAbove (s: AxiomaticRealStructure::[Raw]) (A: \Pow Carrier): \Prop :=
    \exists { u : Carrier \where IsUpperBound s A u };

\definition IsLeastUpperBound (s: AxiomaticRealStructure::[Raw]) (A: \Pow Carrier) (u: Carrier): \Prop :=
    and!{{ IsUpperBound s A u }
      { \forall (v: Carrier) -> IsUpperBound s A v -> Le s u v }};

\definition HasLeastUpperBound (s: AxiomaticRealStructure::[Raw]) (A: \Pow Carrier): \Prop :=
    \exists { u : Carrier \where IsLeastUpperBound s A u };

\definition Completeness (s: AxiomaticRealStructure::[Raw]): \Prop :=
    \forall (A: \Pow Carrier) -> Inhabited A -> BoundedAbove s A ->
      HasLeastUpperBound s A;

\definition lubUpper (s: AxiomaticRealStructure::[Raw]) (A: \Pow Carrier) (u: Carrier)
  (h: IsLeastUpperBound s A u): IsUpperBound s A u :=
  #left{h};

\definition lubLeast (s: AxiomaticRealStructure::[Raw]) (A: \Pow Carrier) (u: Carrier)
  (h: IsLeastUpperBound s A u): \forall (v: Carrier) -> IsUpperBound s A v -> Le s u v :=
  #right{h};

\module Laws;
