\use Logic.either;
\import \parent.Def[] \as Def;

\import std.Arithmetic[].Rat[].Estimates[] \as Estimates;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\import std.Data[].Nat[] \as Natural;
\import std.Data[].Nat[].Order[].Prop[] \as NatOrder;
\import RationalFractions.Order[] \as RationalOrder;
\import \parent.\parent.Order[] \as CutOrder;

\definition AdjacentBoundary[P: Natural.Nat^ -> \Prop]: \Prop :=
  NatOrder.AdjacentBoundary P;
\definition finiteBoundary[P: Natural.Nat^ -> \Prop]:
  \forall (n: Natural.Nat^) -> P Natural.Nat^::zero ->
    Logic.Not (P n) -> AdjacentBoundary P :=
  NatOrder.finiteBoundary P;

\definition lowerLocated[L: \Pow Rat]:
  Lower L ->
  Located L :=
  \fun (lower: Lower L) (p, q: Rat) (pq: lt p q) =>
      either!{{(Classical.excludedMiddle (In L p))} {Logic.Or[In L p, Logic.Not (In L q)]}
        {\fun (lp: In L p) =>
          Logic.Or[In L p, Logic.Not (In L q)]::left lp}
        {\fun (np: Logic.Not (In L p)) =>
          Logic.Or[In L p, Logic.Not (In L q)]::right
            (\fun (lq: In L q) => np (lower p q pq lq))}
      };

\definition ratLowerInhabited[a: Rat]: Inhabited (Def.RatLower a) :=
  Logic.existsIntro[Rat, { q : Rat \where In (Def.RatLower a) q }] (RationalOperations.below a)
  (RationalOperationsProp.belowLt a);

\definition ratLowerProper[a: Rat]: Proper (Def.RatLower a) :=
  Logic.existsIntro[Rat, { q : Rat \where Logic.Not (In (Def.RatLower a) q) }] a (RationalOrder.ltIrrefl a);

\definition ratLowerLower[a: Rat]: Lower (Def.RatLower a) :=
  \fun (p, q: Rat) (pq: lt p q) (qa: lt q a) =>
    RationalOrder.ltTrans p q a pq qa;

\definition ratLowerRounded[a: Rat]: Rounded (Def.RatLower a) :=
  \fun (p: Rat) (pa: lt p a) =>
    Logic.existsIntro[Rat, { q : Rat \where Logic.And[In (Def.RatLower a) q, lt p q] }] (RationalOperations.midpoint p a)
    (Logic.And[
          In (Def.RatLower a) (RationalOperations.midpoint p a),
          lt p (RationalOperations.midpoint p a)]::# (RationalOperationsProp.midpointLt p a pa) (RationalOperationsProp.ltMidpoint p a pa));

\definition ratLowerRespects[a: Rat]: RespectsFractionEq (Def.RatLower a) :=
  \fun (p, q: Rat) (pq: RationalFractions.FractionEq p q) (pa: lt p a) =>
        RationalOrder.ltReplaceLeft p q a pq pa;

\definition ratCut[a: Rat]: IsCut[Def.RatLower a] :=
  IsCut[Def.RatLower a] {
    inhabited := ratLowerInhabited a,
    proper := ratLowerProper a,
    lower := ratLowerLower a,
    rounded := ratLowerRounded a,
    located := lowerLocated (Def.RatLower a) (ratLowerLower a),
    respects := ratLowerRespects a,
  };

\definition memberLtOutside[x: Real] [a, b: Rat]:
  mem x a -> Logic.Not (mem x b) ->
  lt a b :=
  \fun (xa: mem x a) (xb: Logic.Not (mem x b)) =>
    either!{{(RationalOrder.trichotomy a b)} {lt a b}
      {\fun (ab: lt a b) => ab}
      {\fun (rest: Logic.Or[RationalFractions.FractionEq a b, lt b a]) =>
        either!{rest {lt a b}
          {\fun (ab: RationalFractions.FractionEq a b) =>
            Logic.falseElim (lt a b) (xb (x.respects a b ab xa))}
          {\fun (ba: lt b a) =>
            Logic.falseElim (lt a b) (xb (x.lower b a ba xa))}
        }}
    };

\definition GridPredicate[x: Real] [a, e: Rat]: Natural.Nat^ -> \Prop :=
  \fun (n: _) => mem x (RationalOperations.grid a e n);

\definition GridBoundaryAt[x: Real] [a, e: Rat]: \Prop :=
  AdjacentBoundary (GridPredicate x a e);

\definition GridBoundaryWitnesses[x: Real] [e: Rat]: \Pow Rat :=
  { a : Rat \where GridBoundaryAt x a e };

\definition GridBoundary[x: Real] [e: Rat]: \Prop :=
  \exists \Cast[Rat] (GridBoundaryWitnesses x e);

\definition gridBoundary[x: Real] [e: Rat]:
  lt zeroRat e ->
  GridBoundary x e :=
  \block {
    \fun (positive: lt zeroRat e) \then
    \takefrom a: \Cast[Rat] ({ a : Rat \where mem x a }) \by x.inhabited \then
    \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.Not (mem x b) }) \by x.proper \then
    \takefrom n: \Cast[Natural.Nat^] ({ n : Natural.Nat^ \where lt b (RationalOperations.naturalTranslate a e n) }) \by RationalOperationsProp.naturalTranslateAbove a e b positive \then
    \let P: Natural.Nat^ -> \Prop := GridPredicate x a e \then
    \let xa: mem x a :=
      \bysub(Rat, { a : Rat \where mem x a }, a) \then
    \let xb: Logic.Not (mem x b) :=
      \bysub(Rat, { b : Rat \where Logic.Not (mem x b) }, b) \then
    \let farReduced:
        lt b (RationalOperations.naturalTranslate a e n) :=
      \bysub(Natural.Nat^,
        { n : Natural.Nat^ \where lt b (RationalOperations.naturalTranslate a e n) }, n) \then
    \let far: lt b (RationalOperations.grid a e n) :=
      RationalOrder.ltReplaceRight b
        (RationalOperations.naturalTranslate a e n)
        (RationalOperations.grid a e n)
        (RationalOperationsProp.naturalTranslateAsGrid a e n)
        farReduced \then
    \let atZero: P Natural.Nat^::zero :=
      x.respects a
        (RationalOperations.grid a e Natural.Nat^::zero)
        (RationalFractions.fractionEqSym _ _
          (RationalOperationsProp.gridZero a e)) xa \then
    \let notAtN: Logic.Not (P n) :=
      \fun (atN: P n) => xb
        (x.lower b (RationalOperations.grid a e n) far atN) \then
    \let boundary: AdjacentBoundary P :=
      finiteBoundary P n atZero notAtN \then
    \return Logic.existsIntro[Rat, GridBoundaryWitnesses x e] a boundary
  };

\definition Bracketed[x: Real] [e: Rat]: \Prop :=
  \exists ( a : Rat \where Logic.And[mem x a, Logic.Not (mem x (addRat a e))] );

\definition bracket[x: Real] [e: Rat]:
  lt zeroRat e ->
  Bracketed x e :=
  \block {
    \fun (positive: lt zeroRat e) \then
    \takefrom base: \Cast[Rat] (GridBoundaryWitnesses x e) \by gridBoundary x e positive \then
    \takefrom k: \Cast[Natural.Nat^] ({ k : Natural.Nat^ \where Logic.And[GridPredicate x base e k,
          Logic.Not (GridPredicate x base e (Natural.Nat^::succ k))] }) \by \bysub(Rat, GridBoundaryWitnesses x e, base) \then
    \let a: Rat := RationalOperations.grid base e k \then
    \let next: Rat :=
      RationalOperations.grid base e (Natural.Nat^::succ k) \then
    \let xa: mem x a :=
      (\bysub(Natural.Nat^,
          { k : Natural.Nat^ \where Logic.And[GridPredicate x base e k,
              Logic.Not (GridPredicate x base e
                (Natural.Nat^::succ k))] }, k)).left \then
    \let outsideNext: Logic.Not (mem x next) :=
      (\bysub(Natural.Nat^,
          { k : Natural.Nat^ \where Logic.And[GridPredicate x base e k,
              Logic.Not (GridPredicate x base e
                (Natural.Nat^::succ k))] }, k)).right \then
    \let outside: Logic.Not (mem x (addRat a e)) :=
      \fun (inside: mem x (addRat a e)) =>
        outsideNext
          (x.respects (addRat a e) next
            (RationalFractions.fractionEqSym _ _
              (RationalOperationsProp.gridSucc base e k)) inside) \then
    \return Logic.existsIntro[Rat, { a : Rat \where Logic.And[mem x a, Logic.Not (mem x (addRat a e))] }] a
      (Logic.And[mem x a,
          Logic.Not (mem x (addRat a e))]::# xa outside)
  };

\definition sumIntro[x, y: Real][q, a, b: Rat]:
  mem x a -> mem y b -> lt q (addRat a b) -> In (Def.SumLower x y) q :=
  \fun (xa: _) (yb: _) (qab: _) =>
    \exact(Def.SumWitness[x, y, q] {
      left := a, right := b, leftMember := xa, rightMember := yb, below := qab,
    }, Def.SumWitness[x, y, q]);

\definition sumElim[x, y: Real][q: Rat]:
  In (Def.SumLower x y) q -> \forall (P: \Prop) ->
  (\forall (a, b: Rat) -> mem x a -> mem y b -> lt q (addRat a b) -> P) -> P := \block {
    \fun (member: In (Def.SumLower x y) q) (P: \Prop)
      (use: \forall (a, b: Rat) -> mem x a -> mem y b -> lt q (addRat a b) -> P) \then
    \takefrom witness: Def.SumWitness[x, y, q] \by member \then
    \return use witness.left witness.right
      witness.leftMember witness.rightMember witness.below
  };

\definition sumContainsAdd[x, y: Real] [a, b: Rat]:
  mem x a -> mem y b ->
  In (Def.SumLower x y) (addRat a b) :=
  \block {
    \fun (xa: mem x a) (yb: mem y b) \then
    \takefrom a2: \Cast[Rat] ({ a2 : Rat \where Logic.And[mem x a2, lt a a2] }) \by x.rounded a xa \then
    \takefrom b2: \Cast[Rat] ({ b2 : Rat \where Logic.And[mem y b2, lt b b2] }) \by y.rounded b yb \then
    \return sumIntro x y (addRat a b) a2 b2
        ((\bysub(Rat,
            { a2 : Rat \where Logic.And[mem x a2, lt a a2] }, a2)).left)
        ((\bysub(Rat,
            { b2 : Rat \where Logic.And[mem y b2, lt b b2] }, b2)).left)
        (RationalOperationsProp.ltAdd a a2 b b2
          ((\bysub(Rat,
              { a2 : Rat \where Logic.And[mem x a2, lt a a2] }, a2)).right)
          ((\bysub(Rat,
              { b2 : Rat \where Logic.And[mem y b2, lt b b2] }, b2)).right))
  };

\definition sumInhabited[x, y: Real]: Inhabited (Def.SumLower x y) :=
  \block {
    \takefrom a: \Cast[Rat] ({ a : Rat \where mem x a }) \by x.inhabited \then
    \takefrom b: \Cast[Rat] ({ b : Rat \where mem y b }) \by y.inhabited \then
    \return Logic.existsIntro[Rat, { q : Rat \where In (Def.SumLower x y) q }] (RationalOperations.below (addRat a b))
      (sumIntro x y (RationalOperations.below (addRat a b)) a b
            (\bysub(Rat, { a : Rat \where mem x a }, a))
            (\bysub(Rat, { b : Rat \where mem y b }, b))
            (RationalOperationsProp.belowLt (addRat a b)))
  };

\definition sumProperAt[x, y: Real] [u, v: Rat]:
  Logic.Not (mem x u) -> Logic.Not (mem y v) ->
  Logic.Not (In (Def.SumLower x y) (addRat u v)) :=
  \fun (xu: _) (yv: _) (member: In (Def.SumLower x y) (addRat u v)) =>
    sumElim x y (addRat u v) member Logic.False
      (\fun (a, b: Rat) (xa: mem x a) (yb: mem y b)
        (boundLt: lt (addRat u v) (addRat a b)) =>
          RationalOrder.ltIrrefl (addRat u v)
            (RationalOrder.ltTrans (addRat u v) (addRat a b) (addRat u v) boundLt
              (RationalOperationsProp.ltAdd a u b v
                (memberLtOutside x a u xa xu) (memberLtOutside y b v yb yv))));

\definition sumProper[x, y: Real]: Proper (Def.SumLower x y) :=
  \block {
    \takefrom u: \Cast[Rat] ({ u : Rat \where Logic.Not (mem x u) }) \by x.proper \then
    \takefrom v: \Cast[Rat] ({ v : Rat \where Logic.Not (mem y v) }) \by y.proper \then
    \return Logic.existsIntro[Rat, { q : Rat \where Logic.Not (In (Def.SumLower x y) q) }] (addRat u v)
      (sumProperAt x y u v
            (\bysub(Rat, { u : Rat \where Logic.Not (mem x u) }, u))
            (\bysub(Rat, { v : Rat \where Logic.Not (mem y v) }, v)))
  };

\definition sumLower[x, y: Real]: Lower (Def.SumLower x y) :=
  \fun (p, q: Rat) (pq: lt p q) (member: In (Def.SumLower x y) q) =>
    sumElim x y q member (In (Def.SumLower x y) p)
      (\fun (a, b: Rat) (xa: mem x a) (yb: mem y b) (qab: lt q (addRat a b)) =>
        sumIntro x y p a b xa yb (RationalOrder.ltTrans p q (addRat a b) pq qab));

\definition sumRounded[x, y: Real]: Rounded (Def.SumLower x y) :=
  \fun (q: Rat) (member: In (Def.SumLower x y) q) =>
    sumElim x y q member
      (\exists ( r : Rat \where Logic.And[In (Def.SumLower x y) r, lt q r] ))
      (\fun (a, b: Rat) (xa: mem x a) (yb: mem y b) (qab: lt q (addRat a b)) =>
        \block {
          \let r: Rat := RationalOperations.midpoint q (addRat a b) \then
          \return Logic.existsIntro[Rat, { r : Rat \where Logic.And[In (Def.SumLower x y) r, lt q r] }] r
            (Logic.And[_, _] {
                left := sumIntro x y r a b xa yb
                  (RationalOperationsProp.midpointLt q (addRat a b) qab),
                right := RationalOperationsProp.ltMidpoint q (addRat a b) qab,
              })
        });

\definition sumRespects[x, y: Real]: RespectsFractionEq (Def.SumLower x y) :=
  \fun (p, q: Rat) (pq: RationalFractions.FractionEq p q) (member: In (Def.SumLower x y) p) =>
      sumElim x y p member (In (Def.SumLower x y) q)
        (\fun (a, b: Rat) (xa: mem x a) (yb: mem y b) (pab: lt p (addRat a b)) =>
          sumIntro x y q a b xa yb (RationalOrder.ltReplaceLeft p q (addRat a b) pq pab));

\definition sumCut[x, y: Real]: IsCut[Def.SumLower x y] :=
  IsCut[Def.SumLower x y] {
    inhabited := sumInhabited x y,
    proper := sumProper x y,
    lower := sumLower x y,
    rounded := sumRounded x y,
    located := lowerLocated (Def.SumLower x y) (sumLower x y),
    respects := sumRespects x y,
  };

\definition negIntro[x: Real] [q, r: Rat]:
  Logic.Not (mem x r) -> lt q (negRat r) ->
  In (Def.NegLower x) q :=
  \fun (xr: Logic.Not (mem x r)) (qr: lt q (negRat r)) =>
    Logic.existsIntro[Rat, { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }] r
    (Logic.And[Logic.Not (mem x r), lt q (negRat r)]::# xr qr);

\definition negElim[x: Real] [q: Rat]:
  In (Def.NegLower x) q -> \forall (P: \Prop) ->
  (\forall (r: Rat) ->
    Logic.Not (mem x r) -> lt q (negRat r) -> P) ->
  P :=
  \block {
    \fun (member: In (Def.NegLower x) q) (P: \Prop)
      (use: \forall (r: Rat) ->
    Logic.Not (mem x r) -> lt q (negRat r) -> P) \then
    \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }) \by member \then
    \let xr: Logic.Not (mem x r) :=
      (\bysub(Rat,
          { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r)).left \then
    \let qr: lt q (negRat r) :=
      (\bysub(Rat,
          { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r)).right \then
    \return use r xr qr
  };

\definition negInhabited[x: Real]: Inhabited (Def.NegLower x) :=
  \block {
    \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.Not (mem x r) }) \by x.proper \then
    \return Logic.existsIntro[Rat, { q : Rat \where In (Def.NegLower x) q }] (RationalOperations.below (negRat r))
      (negIntro x (RationalOperations.below (negRat r)) r
            (\bysub(Rat, { r : Rat \where Logic.Not (mem x r) }, r))
            (RationalOperationsProp.belowLt (negRat r)))
  };

\definition negProperAt[x: Real] [a: Rat]:
  mem x a ->
  Logic.Not (In (Def.NegLower x) (negRat a)) :=
  \fun (xa: mem x a) (member: In (Def.NegLower x) (negRat a)) =>
      \block {
        \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt (negRat a) (negRat r)] }) \by member \then
        \return ((\bysub(Rat,
              { r : Rat \where Logic.And[Logic.Not (mem x r),
                  lt (negRat a) (negRat r)] }, r)).left)
            (x.lower r a
              (RationalOperationsProp.ltOfNegLtNeg a r
                ((\bysub(Rat,
                    { r : Rat \where Logic.And[Logic.Not (mem x r),
                        lt (negRat a) (negRat r)] }, r)).right)) xa)
      };

\definition negProper[x: Real]: Proper (Def.NegLower x) :=
  \block {
    \takefrom a: \Cast[Rat] ({ a : Rat \where mem x a }) \by x.inhabited \then
    \return Logic.existsIntro[Rat, { q : Rat \where Logic.Not (In (Def.NegLower x) q) }] (negRat a)
      (negProperAt x a (\bysub(Rat, { a : Rat \where mem x a }, a)))
  };

\definition negLower[x: Real]: Lower (Def.NegLower x) :=
  \fun (p, q: Rat) (pq: lt p q) (member: In (Def.NegLower x) q) =>
      \block {
        \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }) \by member \then
        \return negIntro x p r
            ((\bysub(Rat,
                { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r)).left)
            (RationalOrder.ltTrans p q (negRat r) pq
              ((\bysub(Rat,
                  { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r)).right))
      };

\definition negRounded[x: Real]: Rounded (Def.NegLower x) :=
  \fun (q: Rat) (member: In (Def.NegLower x) q) =>
    \block {
      \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }) \by member \then
      \let xr: Logic.Not (mem x r) :=
        (\bysub(Rat,
            { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r)).left \then
      \let qr: lt q (negRat r) :=
        (\bysub(Rat,
            { r : Rat \where Logic.And[Logic.Not (mem x r), lt q (negRat r)] }, r)).right \then
      \let p: Rat := RationalOperations.midpoint q (negRat r) \then
      \return Logic.existsIntro[Rat, { p : Rat \where Logic.And[In (Def.NegLower x) p, lt q p] }] p
        (Logic.And[In (Def.NegLower x) p, lt q p]::# (negIntro x p r xr
              (RationalOperationsProp.midpointLt q (negRat r) qr)) (RationalOperationsProp.ltMidpoint q (negRat r) qr))
    };

\definition negRespects[x: Real]: RespectsFractionEq (Def.NegLower x) :=
  \fun (p, q: Rat) (pq: RationalFractions.FractionEq p q) (member: In (Def.NegLower x) p) =>
        \block {
          \takefrom r: \Cast[Rat] ({ r : Rat \where Logic.And[Logic.Not (mem x r), lt p (negRat r)] }) \by member \then
          \return negIntro x q r
              ((\bysub(Rat,
                  { r : Rat \where Logic.And[Logic.Not (mem x r), lt p (negRat r)] }, r)).left)
              (RationalOrder.ltReplaceLeft p q (negRat r) pq
                ((\bysub(Rat,
                    { r : Rat \where Logic.And[Logic.Not (mem x r), lt p (negRat r)] }, r)).right))
        };

\definition negCut[x: Real]: IsCut[Def.NegLower x] :=
  IsCut[Def.NegLower x] {
    inhabited := negInhabited x,
    proper := negProper x,
    lower := negLower x,
    rounded := negRounded x,
    located := lowerLocated (Def.NegLower x) (negLower x),
    respects := negRespects x,
  };

/* Rational density packaged for the finite endpoint arguments used below. */
\definition BelowBoth[a, b: Rat]: \Prop := Estimates.BelowBoth a b;

\definition belowBoth[a, b: Rat]: BelowBoth a b := Estimates.belowBoth a b;

\definition AboveBoth[a, b: Rat]: \Prop := Estimates.AboveBoth a b;

\definition aboveBoth[a, b: Rat]: AboveBoth a b := Estimates.aboveBoth a b;

\structure SymmetricBoundLaw[x: Real, u: Rat]: \Prop := {
  positive: lt zeroRat u,
  inside: mem x (negRat u),
  outside: Logic.Not (mem x u),
};

\definition SymmetricBound[x: Real]: \Prop :=
  \exists ( u : Rat \where SymmetricBoundLaw[x, u] );

\definition symmetricBound[x: Real]: SymmetricBound x :=
  \block {
    \takefrom a: \Cast[Rat] ({ a : Rat \where mem x a }) \by x.inhabited \then
    \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.Not (mem x b) }) \by x.proper \then
    \takefrom u: \Cast[Rat] ({ u : Rat \where Logic.And[lt (negRat a) u, lt b u] }) \by aboveBoth (negRat a) b \then
    \takefrom v: \Cast[Rat] ({ v : Rat \where Logic.And[lt u v, lt zeroRat v] }) \by aboveBoth u zeroRat \then
    \let nua: lt (negRat a) v :=
      RationalOrder.ltTrans (negRat a) u v
        ((\bysub(Rat, { u : Rat \where Logic.And[lt (negRat a) u, lt b u] }, u)).left)
        ((\bysub(Rat, { v : Rat \where Logic.And[lt u v, lt zeroRat v] }, v)).left) \then
    \let nva: lt (negRat v) a :=
      RationalOrder.ltReplaceRight (negRat v)
        (negRat (negRat a)) a
        (RationalOperationsProp.fractionNegInvolutive a)
        (RationalOperationsProp.ltNegReverse (negRat a) v nua) \then
    \let bv: lt b v :=
      RationalOrder.ltTrans b u v
        ((\bysub(Rat, { u : Rat \where Logic.And[lt (negRat a) u, lt b u] }, u)).right)
        ((\bysub(Rat, { v : Rat \where Logic.And[lt u v, lt zeroRat v] }, v)).left) \then
    \let inside: mem x (negRat v) :=
      x.lower (negRat v) a nva
        (\bysub(Rat, { a : Rat \where mem x a }, a)) \then
    \let outside: Logic.Not (mem x v) :=
      \fun (xv: mem x v) =>
        (\bysub(Rat, { b : Rat \where Logic.Not (mem x b) }, b))
          (x.lower b v bv xv) \then
    \return Logic.existsIntro[Rat, { v : Rat \where SymmetricBoundLaw[x, v] }] v
      (SymmetricBoundLaw[x, v]::#
          ((\bysub(Rat, { v : Rat \where Logic.And[lt u v, lt zeroRat v] }, v)).right) inside outside)
  };

\definition productBelowElim[x, y: Real] [q: Rat]:
  Def.ProductBelow x y q -> \forall (P: \Prop) ->
  (\forall (a, b, c, d: Rat) ->
    mem x a -> Logic.Not (mem x b) ->
    mem y c -> Logic.Not (mem y d) ->
    lt q (mulRat a c) -> lt q (mulRat a d) ->
    lt q (mulRat b c) -> lt q (mulRat b d) -> P) ->
  P := \block {
    \fun (member: Def.ProductBelow x y q) (P: \Prop)
      (use: \forall (a, b, c, d: Rat) -> mem x a -> Logic.Not (mem x b) ->
        mem y c -> Logic.Not (mem y d) -> lt q (mulRat a c) -> lt q (mulRat a d) ->
        lt q (mulRat b c) -> lt q (mulRat b d) -> P) \then
    \takefrom witness: Def.ProductWitness[x, y, q] \by member \then
    \return use witness.leftLower witness.leftUpper witness.rightLower witness.rightUpper
      witness.leftMember witness.leftOutside witness.rightMember witness.rightOutside
      witness.lowerLower witness.lowerUpper witness.upperLower witness.upperUpper
  };

\definition positiveCornersImpossible[u, v, a, b, c, d: Rat]:
  lt zeroRat u -> lt zeroRat v -> lt a u ->
  lt (negRat u) b -> lt c v -> lt (negRat v) d ->
  lt (mulRat u v) (mulRat a c) -> lt (mulRat u v) (mulRat a d) ->
  lt (mulRat u v) (mulRat b c) -> lt (mulRat u v) (mulRat b d) ->
  Logic.False := Estimates.positiveCornersImpossible u v a b c d;

\definition productInhabited[x, y: Real]: Inhabited (Def.MulLower x y) :=
  \block {
    \takefrom a: \Cast[Rat] ({ a : Rat \where mem x a }) \by x.inhabited \then
    \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.Not (mem x b) }) \by x.proper \then
    \takefrom c: \Cast[Rat] ({ c : Rat \where mem y c }) \by y.inhabited \then
    \takefrom d: \Cast[Rat] ({ d : Rat \where Logic.Not (mem y d) }) \by y.proper \then
    \takefrom u: \Cast[Rat] ({ u : Rat \where Logic.And[lt u (mulRat a c), lt u (mulRat a d)] }) \by belowBoth (mulRat a c) (mulRat a d) \then
    \takefrom v: \Cast[Rat] ({ v : Rat \where Logic.And[lt v (mulRat b c), lt v (mulRat b d)] }) \by belowBoth (mulRat b c) (mulRat b d) \then
    \takefrom q: \Cast[Rat] ({ q : Rat \where Logic.And[lt q u, lt q v] }) \by belowBoth u v \then
    \let qu: lt q u := (\bysub(Rat, { q : Rat \where Logic.And[lt q u, lt q v] }, q)).left \then
    \let qv: lt q v := (\bysub(Rat, { q : Rat \where Logic.And[lt q u, lt q v] }, q)).right \then
    \let ac: lt q (mulRat a c) :=
      RationalOrder.ltTrans q u (mulRat a c) qu
        ((\bysub(Rat, { u : Rat \where Logic.And[lt u (mulRat a c), lt u (mulRat a d)] }, u)).left) \then
    \let ad: lt q (mulRat a d) :=
      RationalOrder.ltTrans q u (mulRat a d) qu
        ((\bysub(Rat, { u : Rat \where Logic.And[lt u (mulRat a c), lt u (mulRat a d)] }, u)).right) \then
    \let bc: lt q (mulRat b c) :=
      RationalOrder.ltTrans q v (mulRat b c) qv
        ((\bysub(Rat, { v : Rat \where Logic.And[lt v (mulRat b c), lt v (mulRat b d)] }, v)).left) \then
    \let bd: lt q (mulRat b d) :=
      RationalOrder.ltTrans q v (mulRat b d) qv
        ((\bysub(Rat, { v : Rat \where Logic.And[lt v (mulRat b c), lt v (mulRat b d)] }, v)).right) \then
    \return Logic.existsIntro[Rat, { q : Rat \where In (Def.MulLower x y) q }] q
      (Def.productBelowIntro x y q a b c d
          (\bysub(Rat, { a : Rat \where mem x a }, a))
          (\bysub(Rat, { b : Rat \where Logic.Not (mem x b) }, b))
          (\bysub(Rat, { c : Rat \where mem y c }, c))
          (\bysub(Rat, { d : Rat \where Logic.Not (mem y d) }, d))
          ac ad bc bd)
  };


\definition productProper[x, y: Real]: Proper (Def.MulLower x y) :=
  \block {
    \takefrom u: \Cast[Rat] ({ u : Rat \where SymmetricBoundLaw[x, u] }) \by symmetricBound x \then
    \takefrom v: \Cast[Rat] ({ v : Rat \where SymmetricBoundLaw[y, v] }) \by symmetricBound y \then
    \let uLaw: SymmetricBoundLaw[x, u] :=
      \bysub(Rat, { u : Rat \where SymmetricBoundLaw[x, u] }, u) \then
    \let vLaw: SymmetricBoundLaw[y, v] :=
      \bysub(Rat, { v : Rat \where SymmetricBoundLaw[y, v] }, v) \then
    \return Logic.existsIntro[Rat, { q : Rat \where Logic.Not (In (Def.MulLower x y) q) }] (mulRat u v)
      (\fun (member: Def.ProductBelow x y (mulRat u v)) =>
          \block {
            \takefrom productWitness: Def.ProductWitness[x, y, (mulRat u v)]
              \by member \then
            \let a: _ := productWitness.leftLower \then
            \let b: _ := productWitness.leftUpper \then
            \let c: _ := productWitness.rightLower \then
            \let d: _ := productWitness.rightUpper \then
            \let xa: _ := productWitness.leftMember \then
            \let xb: _ := productWitness.leftOutside \then
            \let yc: _ := productWitness.rightMember \then
            \let yd: _ := productWitness.rightOutside \then
            \let ac: _ := productWitness.lowerLower \then
            \let ad: _ := productWitness.lowerUpper \then
            \let bc: _ := productWitness.upperLower \then
            \let bd: _ := productWitness.upperUpper \then
            \let au: lt a u := memberLtOutside x a u xa
              (uLaw.outside) \then
            \let nub: lt (negRat u) b :=
              memberLtOutside x (negRat u) b
                (uLaw.inside) xb \then
            \let cv: lt c v := memberLtOutside y c v yc
              (vLaw.outside) \then
            \let nvd: lt (negRat v) d :=
              memberLtOutside y (negRat v) d
                (vLaw.inside) yd \then
            \return positiveCornersImpossible u v a b c d
              (uLaw.positive)
              (vLaw.positive)
              au nub cv nvd ac ad bc bd
          })
  };

\definition productLower[x, y: Real]: Lower (Def.MulLower x y) :=
  \fun (p, q: Rat) (pq: lt p q) (member: Def.ProductBelow x y q) =>
      \block {
        \takefrom productWitness: Def.ProductWitness[x, y, q]
          \by member \then
        \let a: _ := productWitness.leftLower \then
        \let b: _ := productWitness.leftUpper \then
        \let c: _ := productWitness.rightLower \then
        \let d: _ := productWitness.rightUpper \then
        \let xa: _ := productWitness.leftMember \then
        \let xb: _ := productWitness.leftOutside \then
        \let yc: _ := productWitness.rightMember \then
        \let yd: _ := productWitness.rightOutside \then
        \let ac: _ := productWitness.lowerLower \then
        \let ad: _ := productWitness.lowerUpper \then
        \let bc: _ := productWitness.upperLower \then
        \let bd: _ := productWitness.upperUpper \then
        \return Def.productBelowIntro x y p a b c d xa xb yc yd
              (RationalOrder.ltTrans p q (mulRat a c) pq ac)
              (RationalOrder.ltTrans p q (mulRat a d) pq ad)
              (RationalOrder.ltTrans p q (mulRat b c) pq bc)
              (RationalOrder.ltTrans p q (mulRat b d) pq bd)
      };

\definition productRounded[x, y: Real]: Rounded (Def.MulLower x y) :=
  \fun (q: Rat) (member: Def.ProductBelow x y q) =>
    \block {
      \takefrom productWitness: Def.ProductWitness[x, y, q]
        \by member \then
      \let a: _ := productWitness.leftLower \then
      \let b: _ := productWitness.leftUpper \then
      \let c: _ := productWitness.rightLower \then
      \let d: _ := productWitness.rightUpper \then
      \let xa: _ := productWitness.leftMember \then
      \let xb: _ := productWitness.leftOutside \then
      \let yc: _ := productWitness.rightMember \then
      \let yd: _ := productWitness.rightOutside \then
      \let ac: _ := productWitness.lowerLower \then
      \let ad: _ := productWitness.lowerUpper \then
      \let bc: _ := productWitness.upperLower \then
      \let bd: _ := productWitness.upperUpper \then
      \takefrom u: \Cast[Rat] ({ u : Rat \where Estimates.BetweenBothLaw[q, mulRat a c, mulRat a d, u] })
        \by Estimates.betweenBoth q (mulRat a c) (mulRat a d) ac ad \then
      \takefrom v: \Cast[Rat] ({ v : Rat \where Estimates.BetweenBothLaw[q, mulRat b c, mulRat b d, v] })
        \by Estimates.betweenBoth q (mulRat b c) (mulRat b d) bc bd \then
      \let uLaw: Estimates.BetweenBothLaw[q, mulRat a c, mulRat a d, u] :=
        \bysub(Rat, { u : Rat \where Estimates.BetweenBothLaw[q, mulRat a c, mulRat a d, u] }, u) \then
      \let vLaw: Estimates.BetweenBothLaw[q, mulRat b c, mulRat b d, v] :=
        \bysub(Rat, { v : Rat \where Estimates.BetweenBothLaw[q, mulRat b c, mulRat b d, v] }, v) \then
      \takefrom r: \Cast[Rat] ({ r : Rat \where Estimates.BetweenBothLaw[q, u, v, r] })
        \by Estimates.betweenBoth q u v uLaw.above vLaw.above \then
      \let rLaw: Estimates.BetweenBothLaw[q, u, v, r] :=
        \bysub(Rat, { r : Rat \where Estimates.BetweenBothLaw[q, u, v, r] }, r) \then
      \let qr: lt q r := rLaw.above \then
      \let ru: lt r u := rLaw.belowLeft \then
      \let rv: lt r v := rLaw.belowRight \then
      \let uac: lt u (mulRat a c) := uLaw.belowLeft \then
      \let uad: lt u (mulRat a d) := uLaw.belowRight \then
      \let vbc: lt v (mulRat b c) := vLaw.belowLeft \then
      \let vbd: lt v (mulRat b d) := vLaw.belowRight \then
      \let rac: lt r (mulRat a c) :=
        RationalOrder.ltTrans r u (mulRat a c) ru uac \then
      \let rad: lt r (mulRat a d) :=
        RationalOrder.ltTrans r u (mulRat a d) ru uad \then
      \let rbc: lt r (mulRat b c) :=
        RationalOrder.ltTrans r v (mulRat b c) rv vbc \then
      \let rbd: lt r (mulRat b d) :=
        RationalOrder.ltTrans r v (mulRat b d) rv vbd \then
      \return Logic.existsIntro[Rat, { r : Rat \where Logic.And[In (Def.MulLower x y) r, lt q r] }] r
        (Logic.And[In (Def.MulLower x y) r, lt q r]::# (Def.productBelowIntro x y r a b c d
              xa xb yc yd rac rad rbc rbd) qr)
    };

\definition productRespects[x, y: Real]: RespectsFractionEq (Def.MulLower x y) :=
  \fun (p, q: Rat) (pq: RationalFractions.FractionEq p q) (member: Def.ProductBelow x y p) =>
        \block {
          \takefrom productWitness: Def.ProductWitness[x, y, p]
            \by member \then
          \let a: _ := productWitness.leftLower \then
          \let b: _ := productWitness.leftUpper \then
          \let c: _ := productWitness.rightLower \then
          \let d: _ := productWitness.rightUpper \then
          \let xa: _ := productWitness.leftMember \then
          \let xb: _ := productWitness.leftOutside \then
          \let yc: _ := productWitness.rightMember \then
          \let yd: _ := productWitness.rightOutside \then
          \let ac: _ := productWitness.lowerLower \then
          \let ad: _ := productWitness.lowerUpper \then
          \let bc: _ := productWitness.upperLower \then
          \let bd: _ := productWitness.upperUpper \then
          \return Def.productBelowIntro x y q a b c d xa xb yc yd
                (RationalOrder.ltReplaceLeft p q (mulRat a c) pq ac)
                (RationalOrder.ltReplaceLeft p q (mulRat a d) pq ad)
                (RationalOrder.ltReplaceLeft p q (mulRat b c) pq bc)
                (RationalOrder.ltReplaceLeft p q (mulRat b d) pq bd)
        };

\definition mulCut[x, y: Real]: IsCut[Def.MulLower x y] :=
  IsCut[Def.MulLower x y] {
    inhabited := productInhabited x y,
    proper := productProper x y,
    lower := productLower x y,
    rounded := productRounded x y,
    located := lowerLocated (Def.MulLower x y) (productLower x y),
    respects := productRespects x y,
  };

\definition reciprocalBelowIntro[x: Real][q, a, b, r: Rat]:
  mem x a -> Logic.Not (mem x b) -> lt zeroRat (mulRat a b) ->
  RationalFractions.FractionEq (mulRat b r) oneRat -> lt q r -> Def.ReciprocalBelow x q :=
  \fun (xa: _) (xb: _) (positive: _) (law: _) (qr: _) =>
    \exact(Def.ReciprocalWitness[x, q] {
      lower := a, upper := b, reciprocal := r,
      member := xa, outside := xb, positive := positive, inverse := law, below := qr,
    }, Def.ReciprocalWitness[x, q]);

\definition reciprocalBelowElim[x: Real] [q: Rat]:
  Def.ReciprocalBelow x q -> \forall (P: \Prop) ->
  (\forall (a, b, r: Rat) -> mem x a ->
    Logic.Not (mem x b) -> lt zeroRat (mulRat a b) ->
    RationalFractions.FractionEq (mulRat b r) oneRat ->
    lt q r -> P) ->
  P := \block {
    \fun (member: Def.ReciprocalBelow x q) (P: \Prop)
      (use: \forall (a, b, r: Rat) -> mem x a -> Logic.Not (mem x b) ->
        lt zeroRat (mulRat a b) -> RationalFractions.FractionEq (mulRat b r) oneRat -> lt q r -> P) \then
    \takefrom witness: Def.ReciprocalWitness[x, q] \by member \then
    \return use witness.lower witness.upper witness.reciprocal
      witness.member witness.outside witness.positive witness.inverse witness.below
  };

\definition zeroReal: Real :=
  \into[\Pow Rat](Def.RatLower zeroRat, CutSet) \by { ratCut zeroRat };

\definition zeroRealMem[q: Rat]:
  lt q zeroRat ->
  mem zeroReal q :=
  \fun (negative: lt q zeroRat) =>
    \idelim Def.RatLower zeroRat = underlying zeroReal
      \with T: \Pow Rat => \In[Rat] T q
      \by { base: negative, equality: \refl(Def.RatLower zeroRat) };

\definition zeroRealMemLt[q: Rat]:
  mem zeroReal q ->
  lt q zeroRat :=
  \fun (member: mem zeroReal q) =>
    \idelim underlying zeroReal = Def.RatLower zeroRat
      \with T: \Pow Rat => \In[Rat] T q
      \by { base: member, equality: \refl(Def.RatLower zeroRat) };

\definition zeroLtOfNotNegativeLt[t, a: Rat]:
  Logic.Not (lt t zeroRat) -> lt t a ->
  lt zeroRat a := Estimates.zeroLtOfNotNegativeLt t a;

\definition invInhabitedAboveZero[x: Real]:
  Logic.Not (underlying x = Def.RatLower zeroRat) ->
  Lt zeroReal x ->
  Inhabited (Def.InvLower x) :=
  \block {
    \fun (nonzero: Logic.Not (underlying x = Def.RatLower zeroRat)) (positive: Lt zeroReal x) \then
    \takefrom t: \Cast[Rat] ({ t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }) \by positive \then
    \takefrom a: \Cast[Rat] ({ a : Rat \where Logic.And[mem x a, lt t a] }) \by x.rounded t
      ((\bysub(Rat, { t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }, t)).right) \then
    \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.Not (mem x b) }) \by x.proper \then
    \let separation: Logic.And[
        Logic.Not (mem zeroReal t), mem x t] :=
      \bysub(Rat, { t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }, t) \then
    \let rounded: Logic.And[mem x a, lt t a] :=
      \bysub(Rat, { a : Rat \where Logic.And[mem x a, lt t a] }, a) \then
    \let xa: mem x a :=
      rounded.left \then
    \let xb: Logic.Not (mem x b) :=
      \bysub(Rat, { b : Rat \where Logic.Not (mem x b) }, b) \then
    \let notNegative: Logic.Not (lt t zeroRat) :=
      \fun (negative: lt t zeroRat) =>
        separation.left (zeroRealMem t negative) \then
    \let aPositive: lt zeroRat a :=
      zeroLtOfNotNegativeLt t a notNegative
        (rounded.right) \then
    \let ab: lt a b := memberLtOutside x a b xa xb \then
    \let bPositive: lt zeroRat b :=
      RationalOrder.ltTrans zeroRat a b aPositive ab \then
    \let r: Rat := RationalOperations.reciprocal b \then
    \let law: RationalFractions.FractionEq (mulRat b r) oneRat :=
      RationalOperationsProp.fractionMulReciprocal b
        (RationalOperationsProp.numeratorNonZeroOfZeroLt b bPositive) \then
    \let q: Rat := RationalOperations.below r \then
    \return Logic.existsIntro[Rat, { q : Rat \where In (Def.InvLower x) q }] q
      (Logic.Or[
          Logic.And[underlying x = Def.RatLower zeroRat,
            lt q zeroRat],
          Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
            Def.ReciprocalBelow x q]]::right
          (Logic.And[
            Logic.Not (underlying x = Def.RatLower zeroRat),
            Def.ReciprocalBelow x q]::# nonzero (reciprocalBelowIntro x q a b r xa xb
                (RationalOperationsProp.zeroLtMulPositive a b
                  aPositive bPositive)
                law (RationalOperationsProp.belowLt r))))
  };

\definition invInhabitedBelowZero[x: Real]:
  Logic.Not (underlying x = Def.RatLower zeroRat) ->
  Lt x zeroReal ->
  Inhabited (Def.InvLower x) :=
  \block {
    \fun (nonzero: Logic.Not (underlying x = Def.RatLower zeroRat)) (negative: Lt x zeroReal) \then
    \takefrom b: \Cast[Rat] ({ b : Rat \where Logic.And[Logic.Not (mem x b), mem zeroReal b] }) \by negative \then
    \takefrom a: \Cast[Rat] ({ a : Rat \where mem x a }) \by x.inhabited \then
    \let separation: Logic.And[
        Logic.Not (mem x b), mem zeroReal b] :=
      \bysub(Rat, { b : Rat \where Logic.And[Logic.Not (mem x b), mem zeroReal b] }, b) \then
    \let xa: mem x a :=
      \bysub(Rat, { a : Rat \where mem x a }, a) \then
    \let xb: Logic.Not (mem x b) :=
      separation.left \then
    \let bNegative: lt b zeroRat := zeroRealMemLt b
      (separation.right) \then
    \let ab: lt a b := memberLtOutside x a b xa xb \then
    \let aNegative: lt a zeroRat :=
      RationalOrder.ltTrans a b zeroRat ab bNegative \then
    \let r: Rat := RationalOperations.reciprocal b \then
    \let law: RationalFractions.FractionEq (mulRat b r) oneRat :=
      RationalOperationsProp.fractionMulReciprocal b
        (RationalOperationsProp.numeratorNonZeroOfLtZero b bNegative) \then
    \let q: Rat := RationalOperations.below r \then
    \return Logic.existsIntro[Rat, { q : Rat \where In (Def.InvLower x) q }] q
      (Logic.Or[
          Logic.And[underlying x = Def.RatLower zeroRat, lt q zeroRat],
          Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
            Def.ReciprocalBelow x q]]::right
          (Logic.And[
            Logic.Not (underlying x = Def.RatLower zeroRat),
            Def.ReciprocalBelow x q]::# nonzero (reciprocalBelowIntro x q a b r xa xb
                (RationalOperationsProp.zeroLtMulNegative a b
                  aNegative bNegative)
                law (RationalOperationsProp.belowLt r))))
  };

\definition invInhabited[x: Real]: Inhabited (Def.InvLower x) :=
   either!{{(Classical.excludedMiddle (underlying x = Def.RatLower zeroRat))} {Inhabited (Def.InvLower x)}
     {\fun (zero: underlying x = Def.RatLower zeroRat) =>
      \block {
        \let q: Rat := RationalOperations.below zeroRat \then
        \return
      Logic.existsIntro[Rat, { q : Rat \where In (Def.InvLower x) q }] q
      (Logic.Or[
            Logic.And[underlying x = Def.RatLower zeroRat,
              lt q zeroRat],
            Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x q]]::left
            (Logic.And[underlying x = Def.RatLower zeroRat,
              lt q zeroRat]::# zero (RationalOperationsProp.belowLt zeroRat)))
      }}
     {\fun (nonzero: Logic.Not (underlying x = Def.RatLower zeroRat)) =>
      either!{{(CutOrder.ltTrichotomy x zeroReal)} {Inhabited (Def.InvLower x)}
        {\fun (negative: Lt x zeroReal) =>
          invInhabitedBelowZero x nonzero negative}
        {\fun (rest: Logic.Or[x = zeroReal, Lt zeroReal x]) =>
          either!{rest {Inhabited (Def.InvLower x)}
            {\fun (same: x = zeroReal) =>
              Logic.falseElim (Inhabited (Def.InvLower x))
                (nonzero
                  (\idelim zeroReal = x
                    \with z: Real => underlying z = Def.RatLower zeroRat
                    \by { base: \refl(Def.RatLower zeroRat), equality:
                      sym!{Real} x zeroReal same }))}
            {\fun (positive: Lt zeroReal x) =>
              invInhabitedAboveZero x nonzero positive}
          }}
      }}
   };

\definition invLower[x: Real]: Lower (Def.InvLower x) :=

  \fun (p, q: Rat) (pq: lt p q) (member: In (Def.InvLower x) q) =>
      either!{member {In (Def.InvLower x) p}
        {\fun (atZero: Logic.And[
          underlying x = Def.RatLower zeroRat, lt q zeroRat]) =>
          Logic.Or[
            Logic.And[underlying x = Def.RatLower zeroRat, lt p zeroRat],
            Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x p]]::left
            (Logic.And[
              underlying x = Def.RatLower zeroRat, lt p zeroRat]::# (atZero.left) (RationalOrder.ltTrans p q zeroRat pq
                  (atZero.right)))}
        {\fun (away: Logic.And[
          Logic.Not (underlying x = Def.RatLower zeroRat),
          Def.ReciprocalBelow x q]) =>
          Logic.Or[
            Logic.And[underlying x = Def.RatLower zeroRat, lt p zeroRat],
            Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x p]]::right
            (Logic.And[
              Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x p]::# (away.left) (\block {
                \takefrom reciprocalWitness: Def.ReciprocalWitness[x, q]
                  \by (away.right) \then
                \let a: _ := reciprocalWitness.lower \then
                \let b: _ := reciprocalWitness.upper \then
                \let r: _ := reciprocalWitness.reciprocal \then
                \let xa: _ := reciprocalWitness.member \then
                \let xb: _ := reciprocalWitness.outside \then
                \let positive: _ := reciprocalWitness.positive \then
                \let law: _ := reciprocalWitness.inverse \then
                \let qr: _ := reciprocalWitness.below \then
                \return reciprocalBelowIntro x p a b r xa xb positive law
                        (RationalOrder.ltTrans p q r pq qr)
              }))}
      };

\definition invRounded[x: Real]: Rounded (Def.InvLower x) :=
  \fun (q: Rat) (member: In (Def.InvLower x) q) =>
    either!{member {\exists ( r : Rat \where Logic.And[In (Def.InvLower x) r, lt q r] )}
      {\fun (atZero: Logic.And[
        underlying x = Def.RatLower zeroRat, lt q zeroRat]) =>
        \block {
          \let r: Rat := RationalOperations.midpoint q zeroRat \then
          \return Logic.existsIntro[Rat, { r : Rat \where Logic.And[In (Def.InvLower x) r, lt q r] }] r
            (Logic.And[In (Def.InvLower x) r, lt q r]::# (Logic.Or[
                  Logic.And[underlying x = Def.RatLower zeroRat,
                    lt r zeroRat],
                  Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
                    Def.ReciprocalBelow x r]]::left
                  (Logic.And[
                    underlying x = Def.RatLower zeroRat, lt r zeroRat]::# (atZero.left) (RationalOperationsProp.midpointLt q zeroRat
                        (atZero.right)))) (RationalOperationsProp.ltMidpoint q zeroRat
                  (atZero.right)))
        }}
      {\fun (away: Logic.And[
        Logic.Not (underlying x = Def.RatLower zeroRat),
        Def.ReciprocalBelow x q]) =>
        \block {
          \takefrom reciprocalWitness: Def.ReciprocalWitness[x, q]
            \by (away.right) \then
          \let a: _ := reciprocalWitness.lower \then
          \let b: _ := reciprocalWitness.upper \then
          \let r: _ := reciprocalWitness.reciprocal \then
          \let xa: _ := reciprocalWitness.member \then
          \let xb: _ := reciprocalWitness.outside \then
          \let positive: _ := reciprocalWitness.positive \then
          \let law: _ := reciprocalWitness.inverse \then
          \let qr: _ := reciprocalWitness.below \then
          \let s: Rat := RationalOperations.midpoint q r \then
          \return Logic.existsIntro[Rat, { s : Rat \where Logic.And[In (Def.InvLower x) s, lt q s] }] s
            (Logic.And[In (Def.InvLower x) s, lt q s]::# (Logic.Or[
                  Logic.And[underlying x = Def.RatLower zeroRat,
                    lt s zeroRat],
                  Logic.And[
                    Logic.Not (underlying x = Def.RatLower zeroRat),
                    Def.ReciprocalBelow x s]]::right
                  (Logic.And[
                    Logic.Not (underlying x = Def.RatLower zeroRat),
                    Def.ReciprocalBelow x s]::# (away.left) (reciprocalBelowIntro x s a b r xa xb
                        positive law
                        (RationalOperationsProp.midpointLt q r qr)))) (RationalOperationsProp.ltMidpoint q r qr))
        }}
    };

\definition invRespects[x: Real]: RespectsFractionEq (Def.InvLower x) :=

  \fun (p, q: Rat) (same: RationalFractions.FractionEq p q) (member: In (Def.InvLower x) p) =>
        either!{member {In (Def.InvLower x) q}
          {\fun (atZero: Logic.And[
            underlying x = Def.RatLower zeroRat, lt p zeroRat]) =>
            Logic.Or[
              Logic.And[underlying x = Def.RatLower zeroRat, lt q zeroRat],
              Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
                Def.ReciprocalBelow x q]]::left
              (Logic.And[
                underlying x = Def.RatLower zeroRat, lt q zeroRat]::# (atZero.left) (RationalOrder.ltReplaceLeft p q zeroRat same
                    (atZero.right)))}
          {\fun (away: Logic.And[
            Logic.Not (underlying x = Def.RatLower zeroRat),
            Def.ReciprocalBelow x p]) =>
            Logic.Or[
              Logic.And[underlying x = Def.RatLower zeroRat, lt q zeroRat],
              Logic.And[Logic.Not (underlying x = Def.RatLower zeroRat),
                Def.ReciprocalBelow x q]]::right
              (Logic.And[
                Logic.Not (underlying x = Def.RatLower zeroRat),
                Def.ReciprocalBelow x q]::# (away.left) (\block {
                  \takefrom reciprocalWitness: Def.ReciprocalWitness[x, p]
                    \by (away.right) \then
                  \let a: _ := reciprocalWitness.lower \then
                  \let b: _ := reciprocalWitness.upper \then
                  \let r: _ := reciprocalWitness.reciprocal \then
                  \let xa: _ := reciprocalWitness.member \then
                  \let xb: _ := reciprocalWitness.outside \then
                  \let positive: _ := reciprocalWitness.positive \then
                  \let law: _ := reciprocalWitness.inverse \then
                  \let pr: _ := reciprocalWitness.below \then
                  \return reciprocalBelowIntro x q a b r xa xb positive law
                          (RationalOrder.ltReplaceLeft p q r same pr)
                }))}
        };

\definition invProperAtZero[x: Real]:
  underlying x = Def.RatLower zeroRat ->
  Proper (Def.InvLower x) :=
  \fun (zero: underlying x = Def.RatLower zeroRat) =>
    Logic.existsIntro[Rat, { q : Rat \where Logic.Not (In (Def.InvLower x) q) }] zeroRat
    (\fun (member: In (Def.InvLower x) zeroRat) =>
          either!{member Logic.False
            {\fun (atZero: Logic.And[
              underlying x = Def.RatLower zeroRat, lt zeroRat zeroRat]) =>
              RationalOrder.ltIrrefl zeroRat
                (atZero.right)}
            {\fun (away: Logic.And[
              Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x zeroRat]) =>
              away.left zero}
          });

\definition invProperBelowZero[x: Real]:
  Logic.Not (underlying x = Def.RatLower zeroRat) ->
  Lt x zeroReal ->
  Proper (Def.InvLower x) :=
  \block {
    \fun (nonzero: Logic.Not (underlying x = Def.RatLower zeroRat)) (negative: Lt x zeroReal) \then
    \takefrom u: \Cast[Rat] ({ u : Rat \where Logic.And[Logic.Not (mem x u), mem zeroReal u] }) \by negative \then
    \let separation: Logic.And[
        Logic.Not (mem x u), mem zeroReal u] :=
      \bysub(Rat, { u : Rat \where Logic.And[Logic.Not (mem x u), mem zeroReal u] }, u) \then
    \let xu: Logic.Not (mem x u) :=
      separation.left \then
    \let uNegative: lt u zeroRat := zeroRealMemLt u
      (separation.right) \then
    \return Logic.existsIntro[Rat, { q : Rat \where Logic.Not (In (Def.InvLower x) q) }] zeroRat
      (\fun (member: In (Def.InvLower x) zeroRat) =>
          either!{member Logic.False
            {\fun (atZero: Logic.And[
              underlying x = Def.RatLower zeroRat, lt zeroRat zeroRat]) =>
              nonzero (atZero.left)}
            {\fun (away: Logic.And[
              Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x zeroRat]) =>
              \block {
                \takefrom reciprocalWitness: Def.ReciprocalWitness[x, zeroRat]
                  \by (away.right) \then
                \let a: _ := reciprocalWitness.lower \then
                \let b: _ := reciprocalWitness.upper \then
                \let r: _ := reciprocalWitness.reciprocal \then
                \let xa: _ := reciprocalWitness.member \then
                \let productPositive: _ := reciprocalWitness.positive \then
                \let law: _ := reciprocalWitness.inverse \then
                \let zeroR: _ := reciprocalWitness.below \then
                \let au: lt a u := memberLtOutside x a u xa xu \then
                \let aNegative: lt a zeroRat :=
                  RationalOrder.ltTrans a u zeroRat au uNegative \then
                \let bNegative: lt b zeroRat :=
                  RationalOperationsProp.negativeRightOfPositiveProduct
                    a b aNegative productPositive \then
                \let rNegative: lt r zeroRat :=
                  RationalOperationsProp.negativeOfNegativeProductOne
                    b r bNegative law \then
                \return RationalOrder.ltIrrefl zeroRat
                  (RationalOrder.ltTrans zeroRat r zeroRat
                    zeroR rNegative)
              }}
          })
  };

\definition invProperAboveZero[x: Real]:
  Logic.Not (underlying x = Def.RatLower zeroRat) ->
  Lt zeroReal x ->
  Proper (Def.InvLower x) :=
  \block {
    \fun (nonzero: Logic.Not (underlying x = Def.RatLower zeroRat)) (positive: Lt zeroReal x) \then
    \takefrom t: \Cast[Rat] ({ t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }) \by positive \then
    \takefrom a0: \Cast[Rat] ({ a0 : Rat \where Logic.And[mem x a0, lt t a0] }) \by x.rounded t
      ((\bysub(Rat, { t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }, t)).right) \then
    \let separation: Logic.And[
        Logic.Not (mem zeroReal t), mem x t] :=
      \bysub(Rat, { t : Rat \where Logic.And[Logic.Not (mem zeroReal t), mem x t] }, t) \then
    \let rounded: Logic.And[mem x a0, lt t a0] :=
      \bysub(Rat, { a0 : Rat \where Logic.And[mem x a0, lt t a0] }, a0) \then
    \let xa0: mem x a0 :=
      rounded.left \then
    \let notNegative: Logic.Not (lt t zeroRat) :=
      \fun (negative: lt t zeroRat) =>
        separation.left (zeroRealMem t negative) \then
    \let a0Positive: lt zeroRat a0 :=
      zeroLtOfNotNegativeLt t a0 notNegative
        (rounded.right) \then
    \let s: Rat := RationalOperations.reciprocal a0 \then
    \let a0Law: RationalFractions.FractionEq
        (mulRat a0 s) oneRat :=
      RationalOperationsProp.fractionMulReciprocal a0
        (RationalOperationsProp.numeratorNonZeroOfZeroLt a0 a0Positive) \then
    \return Logic.existsIntro[Rat, { q : Rat \where Logic.Not (In (Def.InvLower x) q) }] s
      (\fun (member: In (Def.InvLower x) s) =>
          either!{member Logic.False
            {\fun (atZero: Logic.And[
              underlying x = Def.RatLower zeroRat, lt s zeroRat]) =>
              nonzero (atZero.left)}
            {\fun (away: Logic.And[
              Logic.Not (underlying x = Def.RatLower zeroRat),
              Def.ReciprocalBelow x s]) =>
              \block {
                \takefrom reciprocalWitness: Def.ReciprocalWitness[x, s]
                  \by (away.right) \then
                \let a: _ := reciprocalWitness.lower \then
                \let b: _ := reciprocalWitness.upper \then
                \let r: _ := reciprocalWitness.reciprocal \then
                \let unusedXa: _ := reciprocalWitness.member \then
                \let xb: _ := reciprocalWitness.outside \then
                \let unusedPositive: _ := reciprocalWitness.positive \then
                \let law: _ := reciprocalWitness.inverse \then
                \let sr: _ := reciprocalWitness.below \then
                \let a0b: lt a0 b :=
                  memberLtOutside x a0 b xa0 xb \then
                \let rs: lt r s :=
                  RationalOperationsProp.reciprocalOrderPositive
                    a0 b r s a0Positive a0b law a0Law \then
                \return RationalOrder.ltIrrefl s
                  (RationalOrder.ltTrans s r s sr rs)
              }}
          })
  };

\definition invProper[x: Real]: Proper (Def.InvLower x) :=
  either!{{(Classical.excludedMiddle (underlying x = Def.RatLower zeroRat))} {Proper (Def.InvLower x)}
    {\fun (zero: underlying x = Def.RatLower zeroRat) =>
      invProperAtZero x zero}
    {\fun (nonzero: Logic.Not (underlying x = Def.RatLower zeroRat)) =>
      either!{{(CutOrder.ltTrichotomy x zeroReal)} {Proper (Def.InvLower x)}
        {\fun (negative: Lt x zeroReal) =>
          invProperBelowZero x nonzero negative}
        {\fun (rest: Logic.Or[x = zeroReal, Lt zeroReal x]) =>
          either!{rest {Proper (Def.InvLower x)}
            {\fun (same: x = zeroReal) =>
              Logic.falseElim (Proper (Def.InvLower x))
                (nonzero
                  (\idelim zeroReal = x
                    \with z: Real => underlying z = Def.RatLower zeroRat
                    \by { base: \refl(Def.RatLower zeroRat), equality:
                      sym!{Real} x zeroReal same }))}
            {\fun (positive: Lt zeroReal x) =>
              invProperAboveZero x nonzero positive}
          }}
      }}
  };

\definition invCut[x: Real]: IsCut[Def.InvLower x] :=
  IsCut[Def.InvLower x] {
    inhabited := invInhabited x,
    proper := invProper x,
    lower := invLower x,
    rounded := invRounded x,
    located := lowerLocated (Def.InvLower x) (invLower x),
    respects := invRespects x,
  };
