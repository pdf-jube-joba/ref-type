\use Logic.either;
\import RationalFractions.Order[] \as RationalOrder;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Order[] \as O;
\use Equality.sym;
\import std.Data[].Pair[] \as Pair;
\import ordered_fields.AxiomaticReals[Carrier := Real] \as AR;
\import \parent.Completeness[] \as Complete;

\definition byContradiction[P: \Prop]:
  (Logic.Not P -> Logic.False) ->
  P :=
  \fun (h: Logic.Not P -> Logic.False) =>
    either!{{(Classical.excludedMiddle P)} P
      {\fun (p: P) => p}
      {\fun (np: Logic.Not P) => Logic.falseElim P (h np)}
    };

/* A member of x below a known member of y is in y; the other two
 * rational comparison cases contradict that the latter is outside x. */
\definition separatedInclusion[x, y: Real] [q: Rat]:
  Logic.Not (mem x q) -> mem y q -> \forall (p: Rat) ->
  mem x p ->
  mem y p :=
  \fun (nq: Logic.Not (mem x q)) (yq: mem y q) (p: Rat) (xp: mem x p) =>
    either!{{(RationalOrder.trichotomy p q)} {mem y p}
      {\fun (pq: lt p q) => y.lower p q pq yq}
      {\fun (rest: Logic.Or[RationalFractions.FractionEq p q, lt q p]) =>
        either!{rest {mem y p}
          {\fun (pq: RationalFractions.FractionEq p q) =>
            Logic.falseElim (mem y p) (nq (x.respects p q pq xp))}
          {\fun (qp: lt q p) =>
            Logic.falseElim (mem y p) (nq (x.lower q p qp xp))}
        }}
    };

\definition leTotal[x, y: Real]: Logic.Or[Le x y, Le y x] :=
  either!{{(Classical.excludedMiddle (Le x y))} {Logic.Or[Le x y, Le y x]}
    {\fun (xy: Le x y) => Logic.Or[Le x y, Le y x]::left xy}
    {\fun (nxy: Logic.Not (Le x y)) =>
      Logic.Or[Le x y, Le y x]::right
        (\fun (q: Rat) => \fun (yq: mem y q) =>
          byContradiction (mem x q)
            (\fun (nq: Logic.Not (mem x q)) => nxy (separatedInclusion x y q nq yq)))}
  };

\definition leOfLt[x, y: Real]:
  Lt x y ->
  Le x y :=
  \block {
    \fun (xy: Lt x y) \then
    \takefrom q: \Cast[Rat] ({ q : Rat \where Logic.And[Logic.Not (mem x q), mem y q] }) \by xy \then
    \return separatedInclusion x y q
        ((\bysub(Rat, { q : Rat \where Logic.And[Logic.Not (mem x q), mem y q] }, q)).left)
        ((\bysub(Rat, { q : Rat \where Logic.And[Logic.Not (mem x q), mem y q] }, q)).right)
  };
\definition ltTrans[x, y, z: Real]:
  Lt x y -> Lt y z ->
  Lt x z :=
  \fun (xy: _) (yz: _) =>
    ltLeTrans x y z xy (leOfLt y z yz);

\definition notLtReverseOfLe[x, y: Real]:
  Le x y ->
  Logic.Not (Lt y x) :=
  \fun (xy: Le x y) (yx: Lt y x) => (ltNotLeReverse y x yx) xy;

\definition leOfNotLtReverse[x, y: Real]:
  Logic.Not (Lt y x) ->
  Le x y :=
  \fun (notReverse: Logic.Not (Lt y x)) (q: Rat) (xq: mem x q) =>
      byContradiction (mem y q)
        (\fun (nyq: Logic.Not (mem y q)) =>
          notReverse
            (Logic.existsIntro[Rat, { r : Rat \where Logic.And[Logic.Not (mem y r), mem x r] }] q
              (Logic.And[Logic.Not (mem y q), mem x q]::# nyq xq)));

\definition ltOfLeNotEq[x, y: Real]:
  Le x y -> Logic.Not (x = y) ->
  Lt x y :=
  \fun (xy: Le x y) (different: Logic.Not (x = y)) =>
    byContradiction (Lt x y)
      (\fun (notLt: Logic.Not (Lt x y)) =>
        different (leAntisym x y xy (leOfNotLtReverse y x notLt)));

\definition ltAsym[x, y: Real]:
  Lt x y ->
  Logic.Not (Lt y x) :=
  \fun (xy: _) =>
    notLtReverseOfLe x y (leOfLt x y xy);

\definition ltNotEq[x, y: Real]:
  Lt x y ->
  Logic.Not (x = y) :=
  \fun (xy: Lt x y) (same: x = y) =>
      ltIrrefl x
        (\idelim y = x \with z: Real => Lt x z
          \by { base: xy, equality: sym!{Real} x y same });

\definition comparable: O.Comparable Real Lt := \fun (x, y: Real) =>
  either!{{(leTotal x y)} {O.Trichotomy[Real, Lt, x, y]}
    {\fun (xy: Le x y) =>
      either!{{(Classical.excludedMiddle (x = y))} {O.Trichotomy[Real, Lt, x, y]}
        {\fun (same: x = y) =>
          O.Trichotomy[Real, Lt, x, y]::equal same}
        {\fun (different: Logic.Not (x = y)) =>
          O.Trichotomy[Real, Lt, x, y]::less
            (ltOfLeNotEq x y xy different)}
      }}
    {\fun (yx: Le y x) =>
      either!{{(Classical.excludedMiddle (x = y))} {O.Trichotomy[Real, Lt, x, y]}
        {\fun (same: x = y) =>
          O.Trichotomy[Real, Lt, x, y]::equal same}
        {\fun (different: Logic.Not (x = y)) =>
          O.Trichotomy[Real, Lt, x, y]::greater
            (ltOfLeNotEq y x yx
              (\fun (same: y = x) =>
                different (sym!{Real} y x same)))}
      }}
  };

\definition ltTrichotomy[x, y: Real]: Logic.Or[Lt x y, Logic.Or[x = y, Lt y x]] :=
  O.trichotomyOr Real Lt x y (comparable x y);

/* This relation is used by every arithmetic structure on the cut carrier. */
\definition leRelation: \Pow (Pair.Times^[Real, Real]) :=
  { p : Pair.Times^[Real, Real] \where Le (Pair.first Real Real p) (Pair.second Real Real p) };
\definition withOrder[zero, one: Real] [add: Real -> Real -> Real] [neg: Real -> Real]
  [mul: Real -> Real -> Real] [inv: Real -> Real]: AR.AxiomaticRealStructureData :=
  AR.AxiomaticRealStructureData::# zero one add neg mul inv leRelation;
\definition linearOrder[zero, one: Real] [add: Real -> Real -> Real] [neg: Real -> Real]
  [mul: Real -> Real -> Real] [inv: Real -> Real]:
  AR.LinearOrderLaws[(withOrder zero one add neg mul inv).leRelation] :=
  AR.LinearOrderLaws[(withOrder zero one add neg mul inv).leRelation] {
    reflexive := leRefl,
    transitive := leTrans,
    antisymmetric := leAntisym,
    total := leTotal,
  };
\definition completeness[zero, one: Real] [add: Real -> Real -> Real] [neg: Real -> Real]
  [mul: Real -> Real -> Real] [inv: Real -> Real]:
  AR.Completeness (withOrder zero one add neg mul inv)  := \block {
    \fun (S: \Pow Real)(inhabited: AR.Inhabited S)(bounded: AR.BoundedAbove (withOrder zero one add neg mul inv) S) \then
    \takefrom u: \Cast[Real] ({ u: Real \where Complete.LeastUpperBound[S, u] })
      \by Complete.complete S inhabited bounded \then
    \let law: Complete.LeastUpperBound[S, u] :=
      \bysub(Real, { u: Real \where Complete.LeastUpperBound[S, u] }, u) \then
    \return Logic.existsIntro[Real, { u: Real \where AR.IsLeastUpperBound (withOrder zero one add neg mul inv) S u }] u
      (AR.LeastUpperBound[leRelation, S, u] { upper := law.upper, least := law.least })
  };
