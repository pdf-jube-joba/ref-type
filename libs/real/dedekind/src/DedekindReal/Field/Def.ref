\import \parent.\parent.Arithmetic[].Def[] \as ArithmeticDef;

\import \parent.\parent.Order[] \as CutOrder;
\import ordered_fields.AxiomaticReals[Carrier := Real] \as AR;
\import \parent.\parent.Arithmetic[].Prop[] \as Laws;

\definition raw: AR.AxiomaticRealStructureData :=
  CutOrder.withOrder ArithmeticDef.zero ArithmeticDef.one ArithmeticDef.add ArithmeticDef.neg Laws.fieldMul Laws.fieldInv;

\definition linearOrder: AR.LinearOrderLaws[raw.leRelation] :=
  CutOrder.linearOrder ArithmeticDef.zero ArithmeticDef.one ArithmeticDef.add ArithmeticDef.neg Laws.fieldMul Laws.fieldInv;

\definition completeness: AR.Completeness raw :=
  CutOrder.completeness ArithmeticDef.zero ArithmeticDef.one ArithmeticDef.add ArithmeticDef.neg Laws.fieldMul Laws.fieldInv;

\definition fieldLaws: AR.FieldLaws[raw.zero, raw.one, raw.add, raw.neg, raw.mul, raw.inv] :=
  AR.FieldLaws[raw.zero, raw.one, raw.add, raw.neg, raw.mul, raw.inv]::#
    Laws.zeroNeOne
    Laws.addZeroLeft
    Laws.addNegLeft
    Laws.addComm
    Laws.addAssoc
    Laws.fieldMulOneLeft
    Laws.fieldMulComm
    Laws.fieldMulAssoc
    Laws.fieldMulAdd
    Laws.fieldInverseNonzero;

\definition orderedFieldLaws: AR.OrderedFieldLaws[raw.zero, raw.add, raw.mul, raw.leRelation] :=
  AR.OrderedFieldLaws[raw.zero, raw.add, raw.mul, raw.leRelation]::#
    Laws.addMonotoneLeft
    Laws.fieldMulNonnegative;

\definition axiomaticLaws: AR.AxiomaticRealStructureLaws[raw] :=
  AR.AxiomaticRealStructureLaws[raw] {
    field := fieldLaws,
    order := linearOrder,
    orderedField := orderedFieldLaws,
    completeness := completeness,
  };

\definition axiomaticReal: AR.AxiomaticRealStructure :=
  \into[AR.AxiomaticRealStructureData]
    (raw, AR.AxiomaticRealStructure) \by { axiomaticLaws };
