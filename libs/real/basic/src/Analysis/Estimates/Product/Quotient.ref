\definition small: \forall (r, h, epsilon: Real) -> Logic.Not (h = zero) -> R.Lt (distance r zero) (mul epsilon (distance h zero)) ->
  R.Lt (distance (mul r (Laws.fieldInv h)) zero) epsilon := \block {
  \fun (r, h, epsilon: Real)(nonzero: _)(bound: _) \then
  \let magnitude: distance (mul r (Laws.fieldInv h)) zero = mul (abs (Laws.fieldInv h)) (distance r zero) := trans!{Real} _ _ _
    (Metric.distanceSymmetric (mul r (Laws.fieldInv h)) zero)
    (trans!{Real} _ _ _ (absProduct r (Laws.fieldInv h))
      (trans!{Real} _ _ _ (Laws.fieldMulComm (abs r) (abs (Laws.fieldInv h)))
        (congr!{Real Real} (mul (abs (Laws.fieldInv h))) _ _ (Metric.distanceSymmetric zero r)))) \then
  \let cancel: mul (abs (Laws.fieldInv h)) (mul epsilon (distance h zero)) = epsilon := trans!{Real} _ _ _
    (Algebra.mulSwap (abs (Laws.fieldInv h)) epsilon (distance h zero))
    (trans!{Real} _ _ _ (congr!{Real Real} (mul epsilon) _ _
      (trans!{Real} _ _ _ (congr!{Real Real} (mul (abs (Laws.fieldInv h))) _ _ (Metric.distanceSymmetric h zero)) (inverseAbsCancellation h nonzero)))
      (Algebra.mulOneRight epsilon)) \then
  \return R.ltReplaceRight (distance (mul r (Laws.fieldInv h)) zero) (mul (abs (Laws.fieldInv h)) (mul epsilon (distance h zero))) epsilon cancel
    (R.ltReplaceLeft (mul (abs (Laws.fieldInv h)) (distance r zero)) (distance (mul r (Laws.fieldInv h)) zero) (mul (abs (Laws.fieldInv h)) (mul epsilon (distance h zero)))
      (sym!{Real} _ _ magnitude)
      (mulStrict (abs (Laws.fieldInv h)) (distance r zero) (mul epsilon (distance h zero)) (inverseAbsPositive h nonzero) bound))
};
