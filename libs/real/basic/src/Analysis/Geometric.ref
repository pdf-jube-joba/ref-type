\import \parent.Estimates[] \as Estimates;
\import Estimates.Product[] \as Product;
\import \parent.Algebra[] \as Algebra;
\import \parent.Inverse[] \as Inverse;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition value: N.Nat^ -> Real := \induction (n: N.Nat^) \return Real \with {
  | zero: one
  | succ: \fun (n: N.Nat^)(previous: Real) => mul q previous
};
\definition nonnegative: R.Le zero q -> \forall (n: N.Nat^) -> R.Le zero (value n) :=
  \fun (positive: R.Le zero q) => \induction (n: N.Nat^) \return R.Le zero (value n) \with {
    | zero: Laws.oneNonnegative
    | succ: \fun (n: N.Nat^)(previous: R.Le zero (value n)) => Laws.fieldMulNonnegative q (value n) positive previous
  };
\definition bounded: R.Le zero q -> R.Le q one -> \forall (n: N.Nat^) -> R.Le (value n) one :=
  \fun (nonnegativeQ: _)(below: _) => \induction (n: N.Nat^) \return R.Le (value n) one \with {
    | zero: R.leRefl one
    | succ: \fun (n: N.Nat^)(previous: _) => R.leTrans _ q one
      (R.leReplaceRight _ (mul q one) q (Algebra.mulOneRight q) (Estimates.mulMonotone q (value n) one nonnegativeQ previous)) below
  };
\import std.Data[].Bool[].Prop[] \as Bool;
\definition antitone: R.Le zero q -> R.Le q one -> \forall (m, n: N.Nat^) -> Nat.Le n m -> R.Le (value m) (value n) :=
  \fun (nonnegativeQ: _)(below: _) => \induction (m: N.Nat^) \return \forall (n: N.Nat^) -> Nat.Le n m -> R.Le (value m) (value n) \with {
    | zero: \fun (n: N.Nat^)(ordered: _) => \idelim N.Nat^::zero = n \with k: N.Nat^ => R.Le one (value k) \by {
      base: R.leRefl one, equality: sym!{N.Nat^} _ _ (Nat.leZeroEq n ordered)
    }
    | succ: \fun (m: N.Nat^)(previous: \forall (n: N.Nat^) -> Nat.Le n m -> R.Le (value m) (value n)) =>
      \induction (n: N.Nat^) \return Nat.Le n (N.Nat^::succ m) -> R.Le (value (N.Nat^::succ m)) (value n) \with {
        | zero: \fun (ordered: _) => bounded nonnegativeQ below (N.Nat^::succ m)
        | succ: \fun (n: N.Nat^)(unused: _)(ordered: _) => Estimates.mulMonotone q (value m) (value n) nonnegativeQ
          (previous n (Nat.leOfSuccSucc n m ordered))
      }
  };
\definition Values: \Pow Real := { x: Real \where \exists ( n: N.Nat^ \where value n = x ) };
\definition member[n: N.Nat^]: \In[Real] Values (value n) := Logic.existsIntro[N.Nat^, { k: N.Nat^ \where value k = value n }] n (\refl(value n));
\definition nonempty: Complete.Nonempty Values := Logic.existsIntro[Real, Values] one (member N.Nat^::zero);
\definition lower: \forall (l: Real) -> (\forall (n: N.Nat^) -> R.Le l (value n)) -> Complete.LowerBound Values l := \block {
  \fun (l: Real)(bounds: \forall (n: N.Nat^) -> R.Le l (value n))(x: Real)(member: \In[Real] Values x) \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where value n = x }) \by member \then
  \return R.leReplaceRight l (value n) x (\bysub(N.Nat^, { n: N.Nat^ \where value n = x }, n)) (bounds n)
};
\definition inverseCancel: \forall (x: Real) -> R.Lt zero q -> mul (Laws.fieldInv q) (mul q x) = x :=
  \fun (x: Real)(positive: R.Lt zero q) => trans!{Real} _ _ _ (sym!{Real} _ _ (Laws.fieldMulAssoc (Laws.fieldInv q) q x))
    (trans!{Real} _ _ _ (congr!{Real Real} (\fun (s: Real) => mul s x) _ _ (Laws.fieldInverseNonzero q (Inverse.positiveNonzero q positive))) (Laws.fieldMulOneLeft x));
\definition cancelInverse: \forall (x: Real) -> R.Lt zero q -> mul q (mul (Laws.fieldInv q) x) = x :=
  \fun (x: Real)(positive: R.Lt zero q) => trans!{Real} _ _ _ (Algebra.mulSwap q (Laws.fieldInv q) x) (inverseCancel x positive);
\definition eventualPositive: R.Lt zero q -> R.Lt q one -> \forall (epsilon: Real) -> R.Lt zero epsilon -> \exists ( n: N.Nat^ \where R.Lt (value n) epsilon ) := \block {
  \fun (positive: R.Lt zero q)(below: R.Lt q one)(epsilon: Real)(radius: R.Lt zero epsilon) \then
  \let nonnegativeQ: R.Le zero q := Order.leOfLt zero q positive \then
  \takefrom l: \Cast[Real] ({ l: Real \where Complete.GreatestLowerBound Values l }) \by Complete.completeBelow Values nonempty
    (Logic.existsIntro[Real, { l: Real \where Complete.LowerBound Values l }] zero (lower zero (nonnegative nonnegativeQ))) \then
  \let laws: Complete.GreatestLowerBound Values l := \bysub(Real, { l: Real \where Complete.GreatestLowerBound Values l }, l) \then
  \let scaled: Complete.LowerBound Values (mul (Laws.fieldInv q) l) := lower (mul (Laws.fieldInv q) l)
    (\fun (n: N.Nat^) => R.leReplaceRight _ _ _ (inverseCancel (value n) positive)
      (Estimates.mulMonotone (Laws.fieldInv q) l (value (N.Nat^::succ n)) (Order.leOfLt _ _ (Product.invPositive q positive)) ((laws).left (value (N.Nat^::succ n)) (member (N.Nat^::succ n))))) \then
  \let self: R.Le l (mul q l) := R.leReplaceLeft _ _ _ (cancelInverse l positive)
    (Estimates.mulMonotone q (mul (Laws.fieldInv q) l) l nonnegativeQ ((laws).right (mul (Laws.fieldInv q) l) scaled)) \then
  \let atMostZero: R.Le l zero := Order.leOfNotLtReverse l zero (\fun (lp: R.Lt zero l) => R.ltNotLeReverse (mul q l) l
    (R.ltReplaceRight (mul q l) (mul l one) l (Algebra.mulOneRight l)
      (R.ltReplaceLeft (mul l q) (mul q l) (mul l one) (Laws.fieldMulComm l q) (Product.mulStrict l q one lp below))) self) \then
  \enough _ \by { Order.byContradiction (\exists ( n: N.Nat^ \where R.Lt (value n) epsilon )) } \then
  \fun (none: Logic.Not (\exists ( n: N.Nat^ \where R.Lt (value n) epsilon ))) \then
  \let lowerEpsilon: Complete.LowerBound Values epsilon := lower epsilon (\fun (n: N.Nat^) => Order.leOfNotLtReverse epsilon (value n)
    (\fun (less: R.Lt (value n) epsilon) => none (Logic.existsIntro[N.Nat^, { k: N.Nat^ \where R.Lt (value k) epsilon }] n less))) \then
  \return R.ltNotLeReverse zero epsilon radius (R.leTrans epsilon l zero ((laws).right epsilon lowerEpsilon) atMostZero)
};
\definition eventual: R.Le zero q -> R.Lt q one -> \forall (epsilon: Real) -> R.Lt zero epsilon -> \exists ( n: N.Nat^ \where R.Lt (value n) epsilon ) :=
  \fun (positive: R.Le zero q)(below: R.Lt q one)(epsilon: Real)(radius: R.Lt zero epsilon) =>
    either!{{(Classical.excludedMiddle (q = zero))} {\exists ( n: N.Nat^ \where R.Lt (value n) epsilon )}
      {\fun (same: q = zero) => Logic.existsIntro[N.Nat^, { n: N.Nat^ \where R.Lt (value n) epsilon }] (N.Nat^::succ N.Nat^::zero)
        (R.ltReplaceLeft zero (mul q one) epsilon (sym!{Real} _ _ (trans!{Real} _ _ _ (Algebra.mulOneRight q) same)) radius)}
      {\fun (different: Logic.Not (q = zero)) => eventualPositive (Order.ltOfLeNotEq zero q positive (\fun (same: zero = q) => different (sym!{Real} _ _ same))) below epsilon radius}
    };
\definition scaledEventual: R.Le zero q -> R.Lt q one -> \forall (c, epsilon: Real) -> R.Le zero c -> R.Lt zero epsilon ->
  \exists ( n: N.Nat^ \where R.Lt (mul c (value n)) epsilon ) := \block {
  \fun (nonnegativeQ: R.Le zero q)(below: R.Lt q one)(c, epsilon: Real)(nonnegativeC: R.Le zero c)(positive: R.Lt zero epsilon) \then
  \let coefficient: Real := Product.coefficient c zero \then
  \let coefficientPositive: R.Lt zero coefficient := Product.coefficientPositive c zero \then
  \let cBound: R.Le c coefficient := R.leReplaceLeft (Product.abs c) c coefficient (Product.absOfNonnegative c nonnegativeC) (Product.coefficientFirst c zero) \then
  \let radius: Real := Product.radius coefficient epsilon \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where R.Lt (value n) radius }) \by eventual nonnegativeQ below radius
    (Product.radiusPositive coefficient epsilon coefficientPositive positive) \then
  \let small: R.Lt (value n) radius := \bysub(N.Nat^, { n: N.Nat^ \where R.Lt (value n) radius }, n) \then
  \return Logic.existsIntro[N.Nat^, { n: N.Nat^ \where R.Lt (mul c (value n)) epsilon }] n
    (R.leLtTrans _ _ _
      (R.leTrans _ _ _
        (R.leReplace (mul (value n) c) (mul c (value n)) (mul (value n) coefficient) (mul coefficient (value n))
          (Laws.fieldMulComm (value n) c) (Laws.fieldMulComm (value n) coefficient)
          (Estimates.mulMonotone (value n) c coefficient (nonnegative nonnegativeQ n) cBound))
        (Estimates.mulMonotone coefficient (value n) radius (Order.leOfLt _ _ coefficientPositive) (Order.leOfLt _ _ small)))
      (Product.radiusSmall coefficient epsilon coefficientPositive positive))
};
