\use std.Logic[].Equality[].eq_reason_in;
\import std.Data[].FinSet[] \as Fin;
\import R.Order[] \as Order;
\definition sum: \forall (n: N.Nat^) -> (Fin.Fin n -> Real) -> Real :=
  \induction (n: N.Nat^) \return (Fin.Fin n -> Real) -> Real \with {
    | zero: \fun (f: Fin.Fin N.Nat^::zero -> Real) => zero
    | succ: \fun (n: N.Nat^)(previous: (Fin.Fin n -> Real) -> Real)(f: Fin.Fin (N.Nat^::succ n) -> Real) =>
      add (f (Fin.zero n)) (previous (\fun (j: Fin.Fin n) => f (Fin.succ n j)))
  };
\definition congruent: \forall (n: N.Nat^)(f, g: Fin.Fin n -> Real) -> (\forall (i: Fin.Fin n) -> f i = g i) -> sum n f = sum n g :=
  \induction (n: N.Nat^) \return \forall (f, g: Fin.Fin n -> Real) -> (\forall (i: Fin.Fin n) -> f i = g i) -> sum n f = sum n g \with {
    | zero: \fun (f, g: _)(agrees: _) => \refl(zero)
    | succ: \fun (n: N.Nat^)(previous: _)(f, g: _)(agrees: _) => congr!{Real Real Real} add _ _ _ _ (agrees (Fin.zero n))
      (previous (\fun (j: Fin.Fin n) => f (Fin.succ n j)) (\fun (j: Fin.Fin n) => g (Fin.succ n j)) (\fun (j: Fin.Fin n) => agrees (Fin.succ n j)))
  };
\definition zeroSum: \forall (n: N.Nat^) -> sum n (\fun (i: Fin.Fin n) => zero) = zero :=
  \induction (n: N.Nat^) \return sum n (\fun (i: Fin.Fin n) => zero) = zero \with {
    | zero: \refl(zero)
    | succ: \fun (n: N.Nat^)(previous: _) => trans!{Real} _ _ _ (Laws.addZeroLeft (sum n (\fun (i: Fin.Fin n) => zero))) previous
  };
\import \parent.Algebra[] \as Algebra;
\definition addition: \forall (n: N.Nat^)(f, g: Fin.Fin n -> Real) -> sum n (\fun (i: Fin.Fin n) => add (f i) (g i)) = add (sum n f) (sum n g) :=
  \induction (n: N.Nat^) \return \forall (f, g: Fin.Fin n -> Real) -> sum n (\fun (i: Fin.Fin n) => add (f i) (g i)) = add (sum n f) (sum n g) \with {
    | zero: \fun (f, g: _) => sym!{Real} _ _ (Laws.addZeroLeft zero)
    | succ: \fun (n: N.Nat^)(previous: _)(f, g: _) => trans!{Real} _ _ _
      (congr!{Real Real} (add (add (f (Fin.zero n)) (g (Fin.zero n)))) _ _
        (previous (\fun (j: Fin.Fin n) => f (Fin.succ n j)) (\fun (j: Fin.Fin n) => g (Fin.succ n j))))
      (Algebra.addFour (f (Fin.zero n)) (g (Fin.zero n)) (sum n (\fun (j: Fin.Fin n) => f (Fin.succ n j))) (sum n (\fun (j: Fin.Fin n) => g (Fin.succ n j))))
  };
\definition scalar: \forall (n: N.Nat^)(c: Real)(f: Fin.Fin n -> Real) -> sum n (\fun (i: Fin.Fin n) => mul c (f i)) = mul c (sum n f) :=
  \induction (n: N.Nat^) \return \forall (c: Real)(f: Fin.Fin n -> Real) -> sum n (\fun (i: Fin.Fin n) => mul c (f i)) = mul c (sum n f) \with {
    | zero: \fun (c: _)(f: _) => sym!{Real} _ _ (Laws.fieldMulZeroRight c)
    | succ: \fun (n: N.Nat^)(previous: _)(c: _)(f: _) => trans!{Real} _ _ _
      (congr!{Real Real} (add (mul c (f (Fin.zero n)))) _ _ (previous c (\fun (j: Fin.Fin n) => f (Fin.succ n j))))
      (sym!{Real} _ _ (Laws.fieldMulAdd c (f (Fin.zero n)) (sum n (\fun (j: Fin.Fin n) => f (Fin.succ n j)))))
  };
\definition nonnegative: \forall (n: N.Nat^)(f: Fin.Fin n -> Real) -> (\forall (i: Fin.Fin n) -> R.Le zero (f i)) -> R.Le zero (sum n f) :=
  \induction (n: N.Nat^) \return \forall (f: Fin.Fin n -> Real) -> (\forall (i: Fin.Fin n) -> R.Le zero (f i)) -> R.Le zero (sum n f) \with {
    | zero: \fun (f: _)(proof: _) => R.leRefl zero
    | succ: \fun (n: N.Nat^)(previous: _)(f: _)(proof: _) => Laws.addNonnegative (f (Fin.zero n)) (sum n (\fun (j: Fin.Fin n) => f (Fin.succ n j)))
      (proof (Fin.zero n)) (previous (\fun (j: Fin.Fin n) => f (Fin.succ n j)) (\fun (j: Fin.Fin n) => proof (Fin.succ n j)))
  };
\import \parent.Estimates[] \as Bounds;
\definition comparison: \forall (n: N.Nat^)(f, g: Fin.Fin n -> Real) -> (\forall (i: Fin.Fin n) -> R.Le (f i) (g i)) -> R.Le (sum n f) (sum n g) :=
  \induction (n: N.Nat^) \return \forall (f, g: Fin.Fin n -> Real) -> (\forall (i: Fin.Fin n) -> R.Le (f i) (g i)) -> R.Le (sum n f) (sum n g) \with {
    | zero: \fun (f, g: _)(proof: _) => R.leRefl zero
    | succ: \fun (n: N.Nat^)(previous: _)(f, g: _)(proof: _) => Bounds.addLe _ _ _ _ (proof (Fin.zero n))
      (previous (\fun (j: Fin.Fin n) => f (Fin.succ n j)) (\fun (j: Fin.Fin n) => g (Fin.succ n j)) (\fun (j: Fin.Fin n) => proof (Fin.succ n j)))
  };
\definition absolute: \forall (n: N.Nat^)(f: Fin.Fin n -> Real) -> R.Le (distance (sum n f) zero) (sum n (\fun (i: Fin.Fin n) => distance (f i) zero)) :=
  \induction (n: N.Nat^) \return \forall (f: Fin.Fin n -> Real) -> R.Le (distance (sum n f) zero) (sum n (\fun (i: Fin.Fin n) => distance (f i) zero)) \with {
    | zero: \fun (f: _) => R.leReplaceLeft zero (distance zero zero) zero (sym!{Real} _ _ (Metric.distanceSelf zero)) (R.leRefl zero)
    | succ: \fun (n: N.Nat^)(previous: _)(f: _) => R.leTrans _ _ _
      (R.leReplaceLeft (distance (add (f (Fin.zero n)) (sum n (\fun (j: Fin.Fin n) => f (Fin.succ n j)))) (add zero zero)) (distance (add (f (Fin.zero n)) (sum n (\fun (j: Fin.Fin n) => f (Fin.succ n j)))) zero) (add (distance (f (Fin.zero n)) zero) (distance (sum n (\fun (j: Fin.Fin n) => f (Fin.succ n j))) zero)) (congr!{Real Real} (\fun (s: Real) => distance (add (f (Fin.zero n)) (sum n (\fun (j: Fin.Fin n) => f (Fin.succ n j)))) s) (add zero zero) zero (Laws.addZeroLeft zero))
        (Bounds.distanceAdd (f (Fin.zero n)) (sum n (\fun (j: Fin.Fin n) => f (Fin.succ n j))) zero zero))
      (Bounds.addLe _ _ _ _ (R.leRefl (distance (f (Fin.zero n)) zero)) (previous (\fun (j: Fin.Fin n) => f (Fin.succ n j))))
  };
\module Linear;
\definition exchange: \forall (m, n: N.Nat^)(f: Fin.Fin m -> Fin.Fin n -> Real) ->
  sum m (\fun (i: Fin.Fin m) => sum n (f i)) = sum n (\fun (j: Fin.Fin n) => sum m (\fun (i: Fin.Fin m) => f i j)) :=
  \induction (m: N.Nat^) \return \forall (n: N.Nat^)(f: Fin.Fin m -> Fin.Fin n -> Real) ->
    sum m (\fun (i: Fin.Fin m) => sum n (f i)) = sum n (\fun (j: Fin.Fin n) => sum m (\fun (i: Fin.Fin m) => f i j)) \with {
      | zero: \fun (n: N.Nat^)(f: _) => sym!{Real} _ _ (zeroSum n)
      | succ: \fun (m: N.Nat^)(previous: _)(n: N.Nat^)(f: Fin.Fin (N.Nat^::succ m) -> Fin.Fin n -> Real) =>
          eq_reason!{
            {sum (N.Nat^::succ m) (\fun (i: Fin.Fin (N.Nat^::succ m)) => sum n (f i))}
            "=" {add (sum n (f (Fin.zero m))) (sum n (\fun (j: Fin.Fin n) => sum m (\fun (i: Fin.Fin m) => f (Fin.succ m i) j)))} "by" {
              congr!{Real Real} (add (sum n (f (Fin.zero m)))) _ _
                (previous n (\fun (i: Fin.Fin m) => f (Fin.succ m i)))}
            "=" {sum n (\fun (j: Fin.Fin n) => add (f (Fin.zero m) j) (sum m (\fun (i: Fin.Fin m) => f (Fin.succ m i) j)))} "by" {
              sym!{Real} _ _ (addition n (f (Fin.zero m)) (\fun (j: Fin.Fin n) => sum m (\fun (i: Fin.Fin m) => f (Fin.succ m i) j)))}
          }
    };
\module Bounds;
\module Convex;
\module Exclusion;
\definition difference: \forall (n: N.Nat^)(f, g: Fin.Fin n -> Real) -> sum n (\fun (i: Fin.Fin n) => sub (f i) (g i)) = sub (sum n f) (sum n g) :=
  \induction (n: N.Nat^) \return \forall (f, g: Fin.Fin n -> Real) -> sum n (\fun (i: Fin.Fin n) => sub (f i) (g i)) = sub (sum n f) (sum n g) \with {
    | zero: \fun (f, g: _) => sym!{Real} (sub zero zero) zero (Laws.subSelf zero)
    | succ: \fun (n: N.Nat^)(previous: _)(f, g: _) => trans!{Real} _ _ _
      (congr!{Real Real} (add (sub (f (Fin.zero n)) (g (Fin.zero n)))) _ _
        (previous (\fun (j: Fin.Fin n) => f (Fin.succ n j)) (\fun (j: Fin.Fin n) => g (Fin.succ n j))))
      (sym!{Real} _ _ (Algebra.subAdd (f (Fin.zero n)) (sum n (\fun (j: Fin.Fin n) => f (Fin.succ n j)))
        (g (Fin.zero n)) (sum n (\fun (j: Fin.Fin n) => g (Fin.succ n j)))))
  };
\definition cancelDifferences: \forall (a, b, c: Real) -> add (sub b a) (sub c b) = sub c a :=
  \fun (a, b, c: Real) => Laws.addCancelRight (add (sub b a) (sub c b)) (sub c a) a
    (eq_reason_in!{Real _
      "=" _ "by" { Laws.addAssoc (sub b a) (sub c b) a }
      "=" _ "by" { congr!{Real Real} (add (sub b a)) _ _ (Laws.addComm (sub c b) a) }
      "=" _ "by" { sym!{Real} _ _ (Laws.addAssoc (sub b a) a (sub c b)) }
      "=" _ "by" { congr!{Real Real} (\fun (s: Real) => add s (sub c b)) _ _ (Metric.subAddCancel b a) }
      "=" _ "by" { Bounds.addSubCancel c b }
      "=" _ "by" { sym!{Real} _ _ (Metric.subAddCancel c a) }
    });
\definition telescoping: \forall (n: N.Nat^)(f: N.Nat^ -> Real) ->
  sum n (\fun (i: Fin.Fin n) => sub (f (N.Nat^::succ (Fin.value n i))) (f (Fin.value n i))) = sub (f n) (f N.Nat^::zero) :=
  \induction (n: N.Nat^) \return \forall (f: N.Nat^ -> Real) ->
    sum n (\fun (i: Fin.Fin n) => sub (f (N.Nat^::succ (Fin.value n i))) (f (Fin.value n i))) = sub (f n) (f N.Nat^::zero) \with {
      | zero: \fun (f: N.Nat^ -> Real) => sym!{Real} (sub (f N.Nat^::zero) (f N.Nat^::zero)) zero (Laws.subSelf (f N.Nat^::zero))
      | succ: \fun (n: N.Nat^)(previous: _)(f: N.Nat^ -> Real) => trans!{Real} _ _ _
        (congr!{Real Real} (add (sub (f (N.Nat^::succ N.Nat^::zero)) (f N.Nat^::zero))) _ _
          (previous (\fun (k: N.Nat^) => f (N.Nat^::succ k))))
        (cancelDifferences (f N.Nat^::zero) (f (N.Nat^::succ N.Nat^::zero)) (f (N.Nat^::succ n)))
    };
\definition coordinateUpper: \forall (n: N.Nat^)(f: Fin.Fin n -> Real) -> (\forall (i: Fin.Fin n) -> R.Le zero (f i)) ->
  \forall (i: Fin.Fin n) -> R.Le (f i) (sum n f) :=
  \induction (n: N.Nat^) \return \forall (f: Fin.Fin n -> Real) -> (\forall (i: Fin.Fin n) -> R.Le zero (f i)) ->
    \forall (i: Fin.Fin n) -> R.Le (f i) (sum n f) \with {
      | zero: \fun (f: _)(positive: _)(i: Fin.Fin N.Nat^::zero) => Logic.falseElim _ (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i))
      | succ: \fun (n: N.Nat^)(previous: _)(f: _)(positive: _) => Fin.cases n (\fun (i: Fin.Fin (N.Nat^::succ n)) => R.Le (f i) (sum (N.Nat^::succ n) f))
          (Algebra.leAddRight (f (Fin.zero n)) (sum n (\fun (j: Fin.Fin n) => f (Fin.succ n j)))
            (nonnegative n (\fun (j: Fin.Fin n) => f (Fin.succ n j)) (\fun (j: Fin.Fin n) => positive (Fin.succ n j))))
          (\fun (i: Fin.Fin n) => R.leTrans _ _ _
            (previous (\fun (j: Fin.Fin n) => f (Fin.succ n j)) (\fun (j: Fin.Fin n) => positive (Fin.succ n j)) i)
            (R.leReplaceRight _ _ _ (Laws.addComm (sum n (\fun (j: Fin.Fin n) => f (Fin.succ n j))) (f (Fin.zero n)))
              (Algebra.leAddRight (sum n (\fun (j: Fin.Fin n) => f (Fin.succ n j))) (f (Fin.zero n)) (positive (Fin.zero n)))))
    };
/* Split a finite sum into its two consecutive coordinate blocks. */
\definition blocks: \forall (n, m: N.Nat^)(f: Fin.Fin (Fin.Sum[m := n, n := m].total) -> Real) ->
  sum (Fin.Sum[m := n, n := m].total) f = add (sum n (\fun (i: Fin.Fin n) => f (Fin.Sum[m := n, n := m].left i)))
    (sum m (\fun (j: Fin.Fin m) => f (Fin.Sum[m := n, n := m].right j))) :=
  \induction (n: N.Nat^) \return \forall (m: N.Nat^)(f: Fin.Fin (Fin.Sum[m := n, n := m].total) -> Real) ->
    sum (Fin.Sum[m := n, n := m].total) f = add (sum n (\fun (i: Fin.Fin n) => f (Fin.Sum[m := n, n := m].left i)))
      (sum m (\fun (j: Fin.Fin m) => f (Fin.Sum[m := n, n := m].right j))) \with {
    | zero: \fun (m: N.Nat^)(f: _) => trans!{Real} (sum m f) (sum m (\fun (j: Fin.Fin m) => f j)) (add zero (sum m (\fun (j: Fin.Fin m) => f j)))
      (congruent m f (\fun (j: Fin.Fin m) => f j) (\fun (j: Fin.Fin m) => \refl(f j)))
      (sym!{Real} (add zero (sum m (\fun (j: Fin.Fin m) => f j))) (sum m (\fun (j: Fin.Fin m) => f j)) (Laws.addZeroLeft (sum m (\fun (j: Fin.Fin m) => f j))))
    | succ: \fun (n: N.Nat^)(previous: _)(m: N.Nat^)(f: _) => trans!{Real} _ _ _
      (congr!{Real Real} (add (f (Fin.zero (Fin.Sum[m := n, n := m].total)))) _ _
        (previous m (\fun (i: Fin.Fin (Fin.Sum[m := n, n := m].total)) => f (Fin.succ (Fin.Sum[m := n, n := m].total) i))))
      (sym!{Real} _ _ (Laws.addAssoc (f (Fin.zero (Fin.Sum[m := n, n := m].total)))
        (sum n (\fun (i: Fin.Fin n) => f (Fin.Sum[m := N.Nat^::succ n, n := m].left (Fin.succ n i))))
        (sum m (\fun (j: Fin.Fin m) => f (Fin.Sum[m := N.Nat^::succ n, n := m].right j)))))
  };
