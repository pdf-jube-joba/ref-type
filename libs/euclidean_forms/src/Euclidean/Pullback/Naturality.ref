
\definition next: N.Nat^ := N.Nat^::succ k;
\import SourceForms.ExteriorDerivative[k := k] \as SourceD;
\import TargetForms.ExteriorDerivative[k := k] \as TargetD;
\import Exterior.Components[k := next] \as Components;
\module At(x: Open.Carrier U);
\definition law: \forall (omega: TargetForms.Form k) -> SourceD.apply (apply k omega) = apply next (TargetD.apply omega) :=
  \fun (omega: TargetForms.Form k) => \axiom:funext(SourceD.apply (apply k omega), apply next (TargetD.apply omega),
    \fun (x: Open.Carrier U) => Components.ext (SourceD.apply (apply k omega) x) (apply next (TargetD.apply omega) x)
      (\axiom:funext(Exterior.component next (SourceD.apply (apply k omega) x), Exterior.component next (apply next (TargetD.apply omega) x),
        At[x := x].law omega)));
