\import calculus.Identity[n := n] \as Identity;
\import \parent.On[U := U] \as Forms;
\import \parent.Pullback[m := n, U := U, V := U, f := Identity.map U] \as Pullback;
\import Spaces.Linear[V := Vectors.Vector, W := Vectors.Vector, source := Vectors.space, target := Vectors.space] \as Linear;
\definition law: \forall (k: N.Nat^)(omega: Forms.Form k) -> Pullback.apply k omega = omega :=
  \fun (k: N.Nat^)(omega: Forms.Form k) => Forms.ext k (Pullback.apply k omega) omega
    (\fun (x: Open.Carrier U)(arguments: Multilinear.Arguments k) => trans!{{Reals.Real}} (Pullback.apply k omega x arguments) (omega x (\fun (i: Fin.Fin k) => arguments i)) (omega x arguments)
      (congr!{{Linear.Map} {Reals.Real}} (\fun (d: Linear.Map) => omega x (\fun (i: Fin.Fin k) => #apply{d} (arguments i))) (Pullback.jacobian x) Identity.linear (Identity.At[U := U, a := x].differential))
      (congr!{{Multilinear.Arguments k} {Reals.Real}} (omega x) (\fun (i: Fin.Fin k) => arguments i) arguments
        (\axiom:funext((\fun (i: Fin.Fin k) => arguments i), arguments, \fun (i: Fin.Fin k) => \refl(arguments i)))));
