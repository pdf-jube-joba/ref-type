\import Alternating.Dimension[n := n, b := Basis.basis].Above[k := k] \as Values;
\import \parent.At[k := k] \as Forms;
\import N.Basic[].Prop[] \as Naturals;
\definition zero: Naturals.Lt n k -> \forall (omega: Form k) -> omega = Forms.zero :=
  \fun (above: Naturals.Lt n k)(omega: Form k) => ext k omega Forms.zero
    (\fun (x: Open.Carrier U)(arguments: Multilinear.Arguments k) => congr!{{Alternating.Form k} {Reals.Real}} (\fun (value: Alternating.Form k) => value arguments) (omega x) (Alternating.At[k := k].origin) (Values.zeroAbove (omega x) above));
