\definition T: \VType := \U(N.Nat -> Attempt -> Compute.Output);
\definition program: T := \thunk (\cfun (rank: N.Nat) => \return(\thunk (\cfun (attempt: Attempt) => \match attempt \in Attempt \with {
  | attempt a history changed: \return(Compute.Output::result rank a history)
})));
\definition matches: \forall (rank: N.Nat^)(attempt: Attempt^) -> program^ rank attempt = assemble rank attempt :=
  \fun (rank: N.Nat^) => \induction (attempt: Attempt^) \return program^ rank attempt = assemble rank attempt \with {
    | attempt: \fun (a: Runtime^)(history: History^)(changed: B.Bool^) => \refl(Compute.Output^::result rank a history)
  };
\definition coherence: program^ = assemble := \axiom:funext(program^, assemble,
  \fun (rank: N.Nat^) => \axiom:funext(program^ rank, assemble rank, matches rank));
