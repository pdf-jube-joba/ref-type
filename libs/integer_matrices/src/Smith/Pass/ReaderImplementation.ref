\definition T: \VType := \U(Cursor -> Attempt);
\definition program: T := \thunk (\cfun (cursor: Cursor) => \match cursor \in Cursor \with {
  | cursor i current: \return current
});
\definition matches: \forall (cursor: Cursor^) -> program^ cursor = cursorAttempt cursor :=
  \induction (cursor: Cursor^) \return program^ cursor = cursorAttempt cursor \with {
    | cursor: \fun (i: N.Nat^)(current: Attempt^) => \refl(current)
  };
\definition coherence: program^ = cursorAttempt := \axiom:funext(program^, cursorAttempt, matches);
