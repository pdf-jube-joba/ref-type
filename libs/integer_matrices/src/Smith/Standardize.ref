\import \parent.Compute[] \as Compute;
\import \parent.Normalize[] \as Normalize;
\definition assemble(rank: N.Nat^): Attempt^ -> Compute.Output^ :=
  \induction (attempt: Attempt^) \return Compute.Output^ \with {
    | attempt: \fun (a: Runtime^)(history: History^)(changed: B.Bool^) => Compute.Output^::result rank a history
  };
\definition normalizeOutput: Compute.Output^ -> Compute.Output^ :=
  \induction (output: Compute.Output^) \return Compute.Output^ \with {
    | result: \fun (rank: N.Nat^)(a: Runtime^)(history: History^) => assemble rank (Normalize.fold rank a history)
  };
\definition normalizeProgram: Normalize.Normalize.T := Normalize.Normalize.program;
\module AssembleImplementation;
\correspondence Assemble: Programs.Correspondence := Programs.Correspondence {
  T := AssembleImplementation[].T, program := AssembleImplementation[].program, specification := assemble, coherence := AssembleImplementation[].coherence,
};
\definition assembleProgram: Assemble.T := Assemble.program;
\module NormalizationImplementation;
\correspondence Normalization: Programs.Correspondence := Programs.Correspondence {
  T := NormalizationImplementation[].T, program := NormalizationImplementation[].program, specification := normalizeOutput, coherence := NormalizationImplementation[].coherence,
};
\definition standardize(rows, cols: N.Nat^)(a: Runtime^): Compute.Output^ := normalizeOutput (Compute.executeInitial rows cols a);
\definition runProgram: Compute.Run.T := Compute.Run.program;
\definition normalizeOutputProgram: Normalization.T := Normalization.program;
\module Implementation;
\correspondence Standardize: Programs.Correspondence := Programs.Correspondence {
  T := Implementation[].T, program := Implementation[].program, specification := standardize, coherence := Implementation[].coherence,
};
\module Laws(m, n: N.Nat^, original: Runtime^);
