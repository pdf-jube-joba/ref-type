\definition leftInverseLaws: \forall (witness: Frames.Frame) -> Representation.Matches[witness, frame value] -> LeftInverse.Laws[LeftMatrices.reflect (left value), leftInverseData value] :=
  \fun (witness: Frames.Frame)(law: Representation.Matches[witness, frame value]) => LeftInverse.Laws[LeftMatrices.reflect (left value), leftInverseData value] {
    leftInverse := trans!{Left.Matrix} (LeftProduct.product (LeftMatrices.reflect (leftInverse value)) (LeftMatrices.reflect (left value))) (LeftProduct.product (#inverse{witness.leftInverse}) (witness.left)) LeftIdentity.identity
      (congr2!{Left.Matrix Left.Matrix Left.Matrix} LeftProduct.product (LeftMatrices.reflect (leftInverse value)) (#inverse{witness.leftInverse}) (LeftMatrices.reflect (left value)) (witness.left) #leftInverse{law} #left{law})
      #leftInverse{(\bysub(LeftInverse.Data, { data: LeftInverse.Data \where LeftInverse.Laws[witness.left, data] }, witness.leftInverse))},
    rightInverse := trans!{Left.Matrix} (LeftProduct.product (LeftMatrices.reflect (left value)) (LeftMatrices.reflect (leftInverse value))) (LeftProduct.product (witness.left) (#inverse{witness.leftInverse})) LeftIdentity.identity
      (congr2!{Left.Matrix Left.Matrix Left.Matrix} LeftProduct.product (LeftMatrices.reflect (left value)) (witness.left) (LeftMatrices.reflect (leftInverse value)) (#inverse{witness.leftInverse}) #left{law} #leftInverse{law})
      #rightInverse{(\bysub(LeftInverse.Data, { data: LeftInverse.Data \where LeftInverse.Laws[witness.left, data] }, witness.leftInverse))},
  };
\definition rightInverseLaws: \forall (witness: Frames.Frame) -> Representation.Matches[witness, frame value] -> RightInverse.Laws[RightMatrices.reflect (right value), rightInverseData value] :=
  \fun (witness: Frames.Frame)(law: Representation.Matches[witness, frame value]) => RightInverse.Laws[RightMatrices.reflect (right value), rightInverseData value] {
    leftInverse := trans!{Right.Matrix} (RightProduct.product (RightMatrices.reflect (rightInverse value)) (RightMatrices.reflect (right value))) (RightProduct.product (#inverse{witness.rightInverse}) (witness.right)) RightIdentity.identity
      (congr2!{Right.Matrix Right.Matrix Right.Matrix} RightProduct.product (RightMatrices.reflect (rightInverse value)) (#inverse{witness.rightInverse}) (RightMatrices.reflect (right value)) (witness.right) #rightInverse{law} #right{law})
      #leftInverse{(\bysub(RightInverse.Data, { data: RightInverse.Data \where RightInverse.Laws[witness.right, data] }, witness.rightInverse))},
    rightInverse := trans!{Right.Matrix} (RightProduct.product (RightMatrices.reflect (right value)) (RightMatrices.reflect (rightInverse value))) (RightProduct.product (witness.right) (#inverse{witness.rightInverse})) RightIdentity.identity
      (congr2!{Right.Matrix Right.Matrix Right.Matrix} RightProduct.product (RightMatrices.reflect (right value)) (witness.right) (RightMatrices.reflect (rightInverse value)) (#inverse{witness.rightInverse}) #right{law} #rightInverse{law})
      #rightInverse{(\bysub(RightInverse.Data, { data: RightInverse.Data \where RightInverse.Laws[witness.right, data] }, witness.rightInverse))},
  };
\definition change: \forall (witness: Frames.Frame) -> Representation.Matches[witness, frame value] ->
  ActRight.product (ActLeft.product (LeftMatrices.reflect (left value)) (Matrices.reflect original)) (RightMatrices.reflect (right value)) = Frames.change witness (Matrices.reflect original) :=
  \fun (witness: Frames.Frame)(law: Representation.Matches[witness, frame value]) =>
    congr2!{Matrices.Matrix Right.Matrix Matrices.Matrix} ActRight.product
      (ActLeft.product (LeftMatrices.reflect (left value)) (Matrices.reflect original)) (ActLeft.product witness.left (Matrices.reflect original))
      (RightMatrices.reflect (right value)) witness.right
      (congr!{Left.Matrix Matrices.Matrix} (\fun (matrix: Left.Matrix) => ActLeft.product matrix (Matrices.reflect original)) (LeftMatrices.reflect (left value)) witness.left #left{law}) #right{law};
