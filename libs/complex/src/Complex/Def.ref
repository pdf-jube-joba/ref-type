\definition ofReal(x: Real): Complex := make x RealOp.zero;
\definition zero: Complex := ofReal RealOp.zero;
\definition one: Complex := ofReal RealOp.one;
\definition i: Complex := make RealOp.zero RealOp.one;

\definition add(z, w: Complex): Complex :=
  make (RealOp.add (re z) (re w)) (RealOp.add (im z) (im w));
\definition neg(z: Complex): Complex := make (RealOp.neg (re z)) (RealOp.neg (im z));
\definition sub(z, w: Complex): Complex := add z (neg w);
\definition mul(z, w: Complex): Complex :=
  make
    (RealOp.sub (RealLaws.fieldMul (re z) (re w)) (RealLaws.fieldMul (im z) (im w)))
    (RealOp.add (RealLaws.fieldMul (re z) (im w)) (RealLaws.fieldMul (im z) (re w)));
\definition scale(a: Real) (z: Complex): Complex :=
  make (RealLaws.fieldMul a (re z)) (RealLaws.fieldMul a (im z));
\definition conj(z: Complex): Complex := make (re z) (RealOp.neg (im z));
\definition normSq(z: Complex): Real :=
  RealOp.add (RealLaws.fieldMul (re z) (re z)) (RealLaws.fieldMul (im z) (im z));
\definition inv(z: Complex): Complex := scale (RealLaws.fieldInv (normSq z)) (conj z);
\definition div(z, w: Complex): Complex := mul z (inv w);
\definition NonZero(z: Complex): \Prop := Logic.Not (z = zero);
