/* Real identities used in componentwise complex arithmetic. */
\definition add: Real -> Real -> Real := RealOp.add;
\definition neg: Real -> Real := RealOp.neg;
\definition sub: Real -> Real -> Real := RealOp.sub;
\definition mul: Real -> Real -> Real := RealLaws.fieldMul;
\definition zero: Real := RealOp.zero;
\definition one: Real := RealOp.one;

\definition mulOneRight: \forall (a: Real) -> mul a one = a :=
  \fun (a: _) => trans!{Real} _ _ _ (RealLaws.fieldMulComm a one) (RealLaws.fieldMulOneLeft a);
\definition mulAddRight: \forall (a, b, c: Real) -> mul (add a b) c = add (mul a c) (mul b c) :=
  \fun (a, b, c: _) => eq_reason!{
    {mul (add a b) c} "=" {mul c (add a b)} "by" {RealLaws.fieldMulComm (add a b) c}
    "=" {add (mul c a) (mul c b)} "by" {RealLaws.fieldMulAdd c a b}
    "=" {add (mul a c) (mul b c)} "by" {
      congr2!{Real Real Real} add _ _ _ _ (RealLaws.fieldMulComm c a) (RealLaws.fieldMulComm c b)}
  };
\definition addSwap: \forall (a, b, c: Real) -> add a (add b c) = add b (add a c) :=
  \fun (a, b, c: _) => eq_reason!{
    {add a (add b c)} "=" {add (add a b) c} "by" {sym!{Real} _ _ (RealLaws.addAssoc a b c)}
    "=" {add (add b a) c} "by" {congr!{Real Real} (\fun (t: _) => add t c) _ _ (RealLaws.addComm a b)}
    "=" {add b (add a c)} "by" {RealLaws.addAssoc b a c}
  };
\definition addFour: \forall (a, b, c, d: Real) ->
  add (add a b) (add c d) = add (add a c) (add b d) :=
  \fun (a, b, c, d: _) => eq_reason!{
    {add (add a b) (add c d)} "=" {add a (add b (add c d))} "by" {RealLaws.addAssoc a b (add c d)}
    "=" {add a (add c (add b d))} "by" {congr!{Real Real} (add a) _ _ (addSwap b c d)}
    "=" {add (add a c) (add b d)} "by" {sym!{Real} _ _ (RealLaws.addAssoc a c (add b d))}
  };
\definition subAdd: \forall (a, b, c, d: Real) ->
  sub (add a b) (add c d) = add (sub a c) (sub b d) :=
  \fun (a, b, c, d: _) => trans!{Real} _ _ _
    (congr!{Real Real} (add (add a b)) _ _ (RealLaws.negAdd c d))
    (addFour a b (neg c) (neg d));
\definition mulSub: \forall (a, b, c: Real) -> mul a (sub b c) = sub (mul a b) (mul a c) :=
  \fun (a, b, c: _) => trans!{Real} _ _ _ (RealLaws.fieldMulAdd a b (neg c))
    (congr!{Real Real} (add (mul a b)) _ _ (RealLaws.fieldMulNegRight a c));
\definition subMul: \forall (a, b, c: Real) -> mul (sub a b) c = sub (mul a c) (mul b c) :=
  \fun (a, b, c: _) => trans!{Real} _ _ _ (mulAddRight a (neg b) c)
    (congr!{Real Real} (add (mul a c)) _ _ (RealLaws.fieldMulNegLeft b c));
\definition subNeg: \forall (a, b: Real) -> sub a (neg b) = add a b :=
  \fun (a, b: _) => congr!{Real Real} (add a) _ _ (RealLaws.negInvolutive b);
\definition negSub: \forall (a, b: Real) -> neg (sub a b) = sub b a :=
  \fun (a, b: _) => eq_reason!{
    {neg (sub a b)} "=" {add (neg a) (neg (neg b))} "by" {RealLaws.negAdd a (neg b)}
    "=" {add (neg a) b} "by" {congr!{Real Real} (add (neg a)) _ _ (RealLaws.negInvolutive b)}
    "=" {sub b a} "by" {RealLaws.addComm (neg a) b}
  };

\definition subShuffle: \forall (a, b, c, d: Real) ->
  sub (sub a b) (add c d) = sub (sub a c) (add d b) :=
  \fun (a, b, c, d: _) => eq_reason!{
    {sub (sub a b) (add c d)}
    "=" {add (add a (neg b)) (add (neg c) (neg d))} "by" {
      congr!{Real Real} (add (sub a b)) _ _ (RealLaws.negAdd c d)}
    "=" {add (add a (neg c)) (add (neg b) (neg d))} "by" {addFour a (neg b) (neg c) (neg d)}
    "=" {add (sub a c) (add (neg d) (neg b))} "by" {
      congr!{Real Real} (add (sub a c)) _ _ (RealLaws.addComm (neg b) (neg d))}
    "=" {sub (sub a c) (add d b)} "by" {
      congr!{Real Real} (add (sub a c)) _ _ (sym!{Real} _ _ (RealLaws.negAdd d b))}
  };
\definition mixedShuffle: \forall (a, b, c, d: Real) ->
  add (sub a b) (add c d) = add (add a c) (sub d b) :=
  \fun (a, b, c, d: _) => trans!{Real} _ _ _ (addFour a (neg b) c d)
    (congr!{Real Real} (add (add a c)) _ _ (RealLaws.addComm (neg b) d));

\use Logic.either;
\definition squareNonnegative: \forall (a: Real) -> R.Le zero (mul a a) :=
  \fun (a: _) => either!{
    {R.Le zero a} "or" {R.Lt a zero} "either" {R.Le zero (mul a a)}
    "lt:" {\fun (nonnegative: _) => RealLaws.fieldMulNonnegative a a nonnegative nonnegative}
    "rt:" {\fun (negative: _) => R.leReplaceRight zero (mul (neg a) (neg a)) (mul a a)
      (RealLaws.fieldMulNegBoth a a)
      (RealLaws.fieldMulNonnegative (neg a) (neg a)
        (RealLaws.nonnegativeNegOfNegative a negative) (RealLaws.nonnegativeNegOfNegative a negative))}
  } (RealLaws.nonnegativeOrNegativeReal a);
\definition squareZero: \forall (a: Real) -> mul a a = zero -> a = zero :=
  \fun (a: Real) (square: _) => RealOrder.byContradiction (a = zero)
    (\fun (nonzero: Logic.Not (a = zero)) => nonzero (eq_reason!{
      a "=" {mul one a} "by" {sym!{Real} _ _ (RealLaws.fieldMulOneLeft a)}
      "=" {mul (mul (RealLaws.fieldInv a) a) a} "by" {
        congr!{Real Real} (\fun (t: _) => mul t a) _ _ (sym!{Real} _ _ (RealLaws.fieldInverseNonzero a nonzero))}
      "=" {mul (RealLaws.fieldInv a) (mul a a)} "by" {RealLaws.fieldMulAssoc (RealLaws.fieldInv a) a a}
      "=" {mul (RealLaws.fieldInv a) zero} "by" {congr!{Real Real} (mul (RealLaws.fieldInv a)) _ _ square}
      "=" zero "by" {RealLaws.fieldMulZeroRight (RealLaws.fieldInv a)}
    }));
\definition leAddRight: \forall (a, b: Real) -> R.Le zero b -> R.Le a (add a b) :=
  \fun (a, b: _) (nonnegative: _) => R.leReplaceLeft (add a zero) a (add a b)
    (RealLaws.addZeroRight a) (RealLaws.addMonotoneLeft zero b a nonnegative);
\definition sumSquaresZeroLeft: \forall (a, b: Real) -> add (mul a a) (mul b b) = zero -> a = zero :=
  \fun (a, b: _) (sum: _) => squareZero a
    (R.leAntisym (mul a a) zero
      (R.leReplaceRight (mul a a) (add (mul a a) (mul b b)) zero sum
        (leAddRight (mul a a) (mul b b) (squareNonnegative b)))
      (squareNonnegative a));

\definition assocRealPart: \forall (a, b, c, d, e, f: Real) ->
  sub (mul (sub (mul a c) (mul b d)) e) (mul (add (mul a d) (mul b c)) f) =
  sub (mul a (sub (mul c e) (mul d f))) (mul b (add (mul c f) (mul d e))) :=
  \fun (a, b, c, d, e, f: _) => eq_reason!{
    {sub (mul (sub (mul a c) (mul b d)) e) (mul (add (mul a d) (mul b c)) f)}
    "=" {sub (sub (mul (mul a c) e) (mul (mul b d) e)) (add (mul (mul a d) f) (mul (mul b c) f))} "by" {
      congr2!{Real Real Real} sub _ _ _ _ (subMul (mul a c) (mul b d) e) (mulAddRight (mul a d) (mul b c) f)}
    "=" {sub (sub (mul a (mul c e)) (mul b (mul d e))) (add (mul a (mul d f)) (mul b (mul c f)))} "by" {
      congr2!{Real Real Real} sub _ _ _ _
        (congr2!{Real Real Real} sub _ _ _ _ (RealLaws.fieldMulAssoc a c e) (RealLaws.fieldMulAssoc b d e))
        (congr2!{Real Real Real} add _ _ _ _ (RealLaws.fieldMulAssoc a d f) (RealLaws.fieldMulAssoc b c f))}
    "=" {sub (sub (mul a (mul c e)) (mul a (mul d f))) (add (mul b (mul c f)) (mul b (mul d e)))} "by" {
      subShuffle (mul a (mul c e)) (mul b (mul d e)) (mul a (mul d f)) (mul b (mul c f))}
    "=" {sub (mul a (sub (mul c e) (mul d f))) (mul b (add (mul c f) (mul d e)))} "by" {
      congr2!{Real Real Real} sub _ _ _ _
        (sym!{Real} _ _ (mulSub a (mul c e) (mul d f)))
        (sym!{Real} _ _ (RealLaws.fieldMulAdd b (mul c f) (mul d e)))}
  };
\definition assocImaginaryPart: \forall (a, b, c, d, e, f: Real) ->
  add (mul (sub (mul a c) (mul b d)) f) (mul (add (mul a d) (mul b c)) e) =
  add (mul a (add (mul c f) (mul d e))) (mul b (sub (mul c e) (mul d f))) :=
  \fun (a, b, c, d, e, f: _) => eq_reason!{
    {add (mul (sub (mul a c) (mul b d)) f) (mul (add (mul a d) (mul b c)) e)}
    "=" {add (sub (mul (mul a c) f) (mul (mul b d) f)) (add (mul (mul a d) e) (mul (mul b c) e))} "by" {
      congr2!{Real Real Real} add _ _ _ _ (subMul (mul a c) (mul b d) f) (mulAddRight (mul a d) (mul b c) e)}
    "=" {add (sub (mul a (mul c f)) (mul b (mul d f))) (add (mul a (mul d e)) (mul b (mul c e)))} "by" {
      congr2!{Real Real Real} add _ _ _ _
        (congr2!{Real Real Real} sub _ _ _ _ (RealLaws.fieldMulAssoc a c f) (RealLaws.fieldMulAssoc b d f))
        (congr2!{Real Real Real} add _ _ _ _ (RealLaws.fieldMulAssoc a d e) (RealLaws.fieldMulAssoc b c e))}
    "=" {add (add (mul a (mul c f)) (mul a (mul d e))) (sub (mul b (mul c e)) (mul b (mul d f)))} "by" {
      mixedShuffle (mul a (mul c f)) (mul b (mul d f)) (mul a (mul d e)) (mul b (mul c e))}
    "=" {add (mul a (add (mul c f) (mul d e))) (mul b (sub (mul c e) (mul d f)))} "by" {
      congr2!{Real Real Real} add _ _ _ _
        (sym!{Real} _ _ (RealLaws.fieldMulAdd a (mul c f) (mul d e)))
        (sym!{Real} _ _ (mulSub b (mul c e) (mul d f)))}
  };
