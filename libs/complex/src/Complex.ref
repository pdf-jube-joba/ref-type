\import real.DedekindReal[] \as R;
\import R.Arithmetic[].Def[] \as RealOp;
\import R.Arithmetic[].Prop[] \as RealLaws;
\import R.Order[] \as RealOrder;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality::sym;
\use Equality::trans;
\use Equality::congr;
\use Equality::congr2;
\use Equality::eq_reason;

\definition Real: \Set := R.Real;
\definition Complex: \Set := Pair.Times^[Real, Real];
\definition make: Real -> Real -> Complex := Pair.pair Real Real;
\definition re: Complex -> Real := Pair.first Real Real;
\definition im: Complex -> Real := Pair.second Real Real;
\import Pair.Prop[A := Real, B := Real] \as PairLaws;

\module Def;
\module Multiplication;
\module Prop;
\module Algebra;
\module Absolute;
