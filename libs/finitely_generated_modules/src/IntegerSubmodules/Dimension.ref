\import Modules.FiniteCoordinates[n := n] \as Coordinates;
\definition Vector: \Set := Coordinates.Carrier;
\definition space: Modules.Space Vector := Coordinates.space;
\import Modules.Of[V := Vector, space := space].Submodule[] \as Submodules;
\definition Submodule: \Set := Submodules.Submodule;
\module Of(S: Submodule);
\definition Generated(S: Submodule): \Prop := Of[S := S].Generated;
