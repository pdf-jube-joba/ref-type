\import \parent.Dimension[n := n].Of[S := S] \as Included;
\definition Carrier: \Set := Included.Carrier;
\definition moduleSpace: Modules.Space Carrier := Included.moduleSpace;
\definition BasisData: \Set := Included.BasisData;
\definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier, space := moduleSpace };
\module Chosen(basis: BasisData) {
  \import Modules.FiniteCoordinates[n := basis.rank] \as Coordinates;
  \definition coordinateBundle: Modules.Bundle := Modules.Bundle { Carrier := Coordinates.Carrier, space := Coordinates.space };
  \import Modules.ProjectiveLaws[].Retract[P := bundle, Q := coordinateBundle, inclusion := #backward{basis.isomorphism}, retraction := #forward{basis.isomorphism}] \as Retraction;
  \definition projective: Modules.Projective bundle := Retraction.projective #rightInverse{basis.isomorphism} Coordinates.Free[].projective;
}
\definition projective: Modules.Projective bundle := \block {
  \takefrom basis: BasisData \by freeBases n S \then
  \return Chosen[basis := basis].projective
};
