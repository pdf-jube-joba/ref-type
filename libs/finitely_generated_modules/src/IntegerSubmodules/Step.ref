\import \parent.Dimension[n := n] \as Lower;
\import \parent.Dimension[n := N.Nat^::succ n] \as Upper;
\import Modules.FiniteCoordinates[n := n].Split[] \as Split;
\module On(S: Upper.Submodule);
\definition existence: (\forall (S: Lower.Submodule) -> Lower.Generated S) -> \forall (S: Upper.Submodule) -> Upper.Generated S :=
  \fun (previous: _)(S: Upper.Submodule) => On[S := S].existence previous;
