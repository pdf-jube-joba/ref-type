\definition integerMultiplication: Maps.Map := multiplication;
\definition integerMultiples: Submodules.Submodule := multiples;
\import Modules.Hom[V := Source.Carrier, W := Source.Carrier, source := Source.space, target := Source.space] \as CoefficientMaps;
\definition multiplication: CoefficientMaps.Map := CoefficientMaps.Map {
  apply := #smul{Source.space} d,
  addition := #vectorAdd{Source.space} d,
  scalar := \fun (a: I.Int^)(x: Source.Carrier) => trans!{Source.Carrier} _ _ _
    (sym!{Source.Carrier} _ _ (#scalarAssoc{Source.space} d a x))
    (trans!{Source.Carrier} _ _ _
      (congr!{I.Int^ Source.Carrier} (\fun (r: I.Int^) => #smul{Source.space} r x) _ _ (#mulCommutative{IntegerRing.commutativeRing} d a))
      (#scalarAssoc{Source.space} a d x)),
};
\import Modules.Of[V := Source.Carrier, space := Source.space].Submodule[] \as CoefficientSub;
\import CoefficientSub.Image[U := Source.Carrier, source := Source.space] \as CoefficientImage;
\definition multiples: CoefficientSub.Submodule := CoefficientImage.image multiplication;
\import CoefficientSub.Quotient[S := multiples] \as Q;
\definition QuotientCarrier: \Set := Q.Carrier;
\definition quotientSpace: Modules.Space QuotientCarrier := Q.moduleSpace;
\definition scalarZero: \forall (q: Carrier) -> #smul{space} d q = #zero{space} :=
  induction (\fun (q: Carrier) => #smul{space} d q = #zero{space})
    (\fun (x: I.Int^) => trans!{Carrier} _ _ _ (onScalar d x) (classMultiple x));
\import Q.To[W := Carrier, target := space] \as ForwardDescent;
\definition forwardVanishes: ForwardDescent.Vanishes map := \fun (x: Source.Carrier)(member: _) =>
  CoefficientImage.eliminate multiplication x (#apply{map} x = #zero{space})
    (\fun (a: Source.Carrier)(represented: #smul{Source.space} d a = x) => trans!{Carrier} _ _ _
      (congr!{Source.Carrier Carrier} (#apply{map}) _ _ (sym!{Source.Carrier} _ _ represented))
      (trans!{Carrier} _ _ _ (#scalar{map} d a) (scalarZero (#apply{map} a)))) member;
\definition forward: Modules.Hom[V := Q.Carrier, W := Carrier, source := Q.moduleSpace, target := space].Map := ForwardDescent.descend map forwardVanishes;
\definition forwardOnClass: \forall (a: Source.Carrier) -> #apply{forward} (Q.class a) = #apply{map} a := ForwardDescent.onClass map forwardVanishes;
\import Modules.Hom[V := Source.Carrier, W := Q.Carrier, source := Source.space, target := Q.moduleSpace].Composition[U := I.Int^, domain := Modules.scalarModule] \as Compose;
\definition rawBackward: Modules.Hom[V := I.Int^, W := Q.Carrier, source := Modules.scalarModule, target := Q.moduleSpace].Map := Compose.compose Q.projection Source.projection;
\import Submodules.Quotient[S := integerMultiples].To[W := Q.Carrier, target := Q.moduleSpace] \as BackwardDescent;
\definition backwardVanishes: BackwardDescent.Vanishes rawBackward := \fun (x: I.Int^)(member: _) =>
  Images.eliminate integerMultiplication x (#apply{rawBackward} x = #zero{Q.moduleSpace})
    (\fun (a: I.Int^)(represented: Arithmetic.mul d a = x) => trans!{Q.Carrier} _ _ _
      (congr!{I.Int^ Q.Carrier} (#apply{rawBackward}) _ _ (sym!{I.Int^} _ _ represented))
      (trans!{Q.Carrier} _ _ _
        (congr!{Source.Carrier Q.Carrier} Q.class _ _ (sym!{Source.Carrier} _ _ (Source.onScalar d a)))
        (Q.classZero (#smul{Source.space} d (Source.class a)) (CoefficientImage.member multiplication (Source.class a))))) member;
\definition backward: Modules.Hom[V := Carrier, W := Q.Carrier, source := space, target := Q.moduleSpace].Map := BackwardDescent.descend rawBackward backwardVanishes;
\definition backwardOnClass: \forall (a: I.Int^) -> #apply{backward} (class a) = Q.class (Source.class a) := BackwardDescent.onClass rawBackward backwardVanishes;
\definition leftOnClass: \forall (a: Source.Carrier) -> #apply{backward} (#apply{forward} (Q.class a)) = Q.class a :=
  Source.induction (\fun (a: Source.Carrier) => #apply{backward} (#apply{forward} (Q.class a)) = Q.class a)
    (\fun (x: I.Int^) => trans!{Q.Carrier} _ _ _
      (congr!{Carrier Q.Carrier} (#apply{backward}) _ _ (forwardOnClass (Source.class x)))
      (trans!{Q.Carrier} _ _ _
        (congr!{Carrier Q.Carrier} (#apply{backward}) _ _ (onClass x)) (backwardOnClass x)));
\definition leftInverse: \forall (q: Q.Carrier) -> #apply{backward} (#apply{forward} q) = q := Q.induction
  (\fun (q: Q.Carrier) => #apply{backward} (#apply{forward} q) = q) leftOnClass;
\definition rightInverse: \forall (q: Carrier) -> #apply{forward} (#apply{backward} q) = q := induction
  (\fun (q: Carrier) => #apply{forward} (#apply{backward} q) = q)
  (\fun (x: I.Int^) => trans!{Carrier} _ _ _
    (congr!{Q.Carrier Carrier} (#apply{forward}) _ _ (backwardOnClass x))
    (trans!{Carrier} _ _ _ (forwardOnClass (Source.class x)) (onClass x)));
\definition isomorphism: Modules.Isomorphism[V := Q.Carrier, W := Carrier, source := Q.moduleSpace, target := space].Isomorphism := Modules.Isomorphism[V := Q.Carrier, W := Carrier, source := Q.moduleSpace, target := space].Isomorphism {
  forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
};
