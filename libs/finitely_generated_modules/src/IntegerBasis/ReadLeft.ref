\definition T: \VType := \U(Smith.SmithResult -> Runtime);
\definition program: T := \thunk (\cfun (result: Smith.SmithResult) => \match result \in Smith.SmithResult \with {
  | result rank a history frame: \match frame \in Smith.BasisChange \with { | frame u v ui vi: \return u }
});
\definition matches: \forall (result: Smith.SmithResult^) -> program^ result = Diagonalize.left result :=
  \induction (result: Smith.SmithResult^) \return program^ result = Diagonalize.left result \with {
    | result: \fun (rank: N.Nat^)(a: Runtime^)(history: Smith.History^) => \induction (frame: Smith.BasisChange^) \return program^ (Smith.SmithResult^::result rank a history frame) = Diagonalize.left (Smith.SmithResult^::result rank a history frame) \with {
        | frame: \fun (u, v, ui, vi: Runtime^) => \refl(u)
      }
  };
\definition coherence: program^ = Diagonalize.left := \axiom:funext(program^, Diagonalize.left, matches);
