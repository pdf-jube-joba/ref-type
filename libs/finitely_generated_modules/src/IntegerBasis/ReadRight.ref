\definition T: \VType := \U(Smith.SmithResult -> Runtime);
\definition program: T := \thunk (\cfun (result: Smith.SmithResult) => \match result \in Smith.SmithResult \with {
  | result rank a history frame: \match frame \in Smith.BasisChange \with { | frame u v ui vi: \return v }
});
\definition matches: \forall (result: Smith.SmithResult^) -> program^ result = Diagonalize.right result :=
  \induction (result: Smith.SmithResult^) \return program^ result = Diagonalize.right result \with {
    | result: \fun (rank: N.Nat^)(a: Runtime^)(history: Smith.History^) => \induction (frame: Smith.BasisChange^) \return program^ (Smith.SmithResult^::result rank a history frame) = Diagonalize.right (Smith.SmithResult^::result rank a history frame) \with {
        | frame: \fun (u, v, ui, vi: Runtime^) => \refl(v)
      }
  };
\definition coherence: program^ = Diagonalize.right := \axiom:funext(program^, Diagonalize.right, matches);
