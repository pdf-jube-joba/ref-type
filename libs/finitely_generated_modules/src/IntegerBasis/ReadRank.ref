\definition T: \VType := \U(Smith.SmithResult -> N.Nat);
\definition program: T := \thunk (\cfun (result: Smith.SmithResult) => \match result \in Smith.SmithResult \with {
  | result rank a history frame: \return rank
});
\definition matches: \forall (result: Smith.SmithResult^) -> program^ result = Diagonalize.rank result :=
  \induction (result: Smith.SmithResult^) \return program^ result = Diagonalize.rank result \with {
    | result: \fun (rank: N.Nat^)(a: Runtime^)(history: Smith.History^)(frame: Smith.BasisChange^) => \refl(rank)
  };
\definition coherence: program^ = Diagonalize.rank := \axiom:funext(program^, Diagonalize.rank, matches);
