\definition firstP: Line.Path (Square.time x) (Square.time y) := Coordinates.apply Square.time (Square.timeContinuous I.topology) x y p;
\definition firstQ: Line.Path (Square.time x) (Square.time y) := Coordinates.apply Square.time (Square.timeContinuous I.topology) x y q;
\definition secondP: Line.Path (Square.point x) (Square.point y) := Coordinates.apply Square.point (Square.pointContinuous I.topology) x y p;
\definition secondQ: Line.Path (Square.point x) (Square.point y) := Coordinates.apply Square.point (Square.pointContinuous I.topology) x y q;
\definition first: LineHomotopy.RelativeHomotopy[I.topology, I.topology, Line.Boundary, firstP, firstQ] := Convex.homotopy (Square.time x) (Square.time y) firstP firstQ;
\definition second: LineHomotopy.RelativeHomotopy[I.topology, I.topology, Line.Boundary, secondP, secondQ] := Convex.homotopy (Square.point x) (Square.point y) secondP secondQ;
\definition family[r: Square.Carrier]: Square.Carrier := Square.at (first r) (second r);
\definition homotopy: Homotopy.RelativeHomotopy[I.topology, Square.topology I.topology, Paths.Boundary, p, q] :=
  \into[Homotopy.Family](family, Homotopy.RelativeHomotopy[I.topology, Square.topology I.topology, Paths.Boundary, p, q]) \by {
    Homotopy.RelativeLaws[I.topology, Square.topology I.topology, Paths.Boundary, p, q, family] {
      homotopy := Homotopy.Laws[I.topology, Square.topology I.topology, p, q, family] {
        continuous := Product.pairContinuous (Square.topology I.topology) I.topology I.topology first second
          ((LineHomotopy.relativeLaws I.topology I.topology Line.Boundary firstP firstQ first).homotopy).continuous
          ((LineHomotopy.relativeLaws I.topology I.topology Line.Boundary secondP secondQ second).homotopy).continuous,
        start := \fun (t: I.Carrier) => Pairs.ext _ _
          (((LineHomotopy.relativeLaws I.topology I.topology Line.Boundary firstP firstQ first).homotopy).start t)
          (((LineHomotopy.relativeLaws I.topology I.topology Line.Boundary secondP secondQ second).homotopy).start t),
        end := \fun (t: I.Carrier) => Pairs.ext _ _
          (((LineHomotopy.relativeLaws I.topology I.topology Line.Boundary firstP firstQ first).homotopy).end t)
          (((LineHomotopy.relativeLaws I.topology I.topology Line.Boundary secondP secondQ second).homotopy).end t),
      },
      fixed := \fun (s, t: I.Carrier)(member: _) => Pairs.ext _ _
        ((LineHomotopy.relativeLaws I.topology I.topology Line.Boundary firstP firstQ first).fixed s t member)
        ((LineHomotopy.relativeLaws I.topology I.topology Line.Boundary secondP secondQ second).fixed s t member),
    }
  };
