\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := I.Carrier] \as Square;
\import \root.Paths[A := Square.Carrier, source := Square.topology I.topology] \as Paths;
\import \root.Paths[A := I.Carrier, source := I.topology] \as Line;
\import \root.IntervalPaths[] \as Convex;
\import Paths.Maps[B := I.Carrier, target := I.topology] \as Coordinates;
\import algebraic_topology.Homotopy[A := I.Carrier, B := Square.Carrier] \as Homotopy;
\import algebraic_topology.Homotopy[A := I.Carrier, B := I.Carrier] \as LineHomotopy;
\import topological_constructions.Product[A := I.Carrier, B := I.Carrier].Universal[X := Square.Carrier] \as Product;
\import std.Data[].Pair[].Prop[A := I.Carrier, B := I.Carrier] \as Pairs;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\module Between(x, y: Square.Carrier, p, q: Paths.Path x y);
\definition homotopic: \forall (x, y: Square.Carrier)(p, q: Paths.Path x y) -> Paths.Homotopic x y p q :=
  \fun (x, y: _)(p, q: _) => \exact(Between[x := x, y := y, p := p, q := q].homotopy,
    Homotopy.RelativeHomotopy[I.topology, Square.topology I.topology, Paths.Boundary, p, q]);
