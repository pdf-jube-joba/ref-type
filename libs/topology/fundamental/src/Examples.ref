\import algebraic_topology.Interval[] \as I;
\import \root.Paths[A := I.Carrier, source := I.topology] \as Paths;
\import Paths.Between[x := I.start, y := I.start] \as Quotient;
\import \root.FundamentalGroup[A := I.Carrier, source := I.topology, basepoint := I.start] \as Fundamental;
\import \root.IntervalPaths[] \as Intervals;
\definition intervalSimplyConnected: \forall (q: Fundamental.Carrier) -> q = Fundamental.unit :=
  Quotient.induction (\fun (q: Fundamental.Carrier) => q = Fundamental.unit)
    (\fun (p: Paths.Path I.start I.start) => Quotient.sameClass p (Paths.constant I.start)
      (Intervals.homotopic I.start I.start p (Paths.constant I.start)));
