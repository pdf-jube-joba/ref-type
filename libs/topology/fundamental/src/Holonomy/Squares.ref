\import Gr.Squares[] \as Boundary;
\definition commutes: \forall (F: Edges.Family) -> Group.mul (value (Edges.bottom F)) (value (Edges.right F)) = Group.mul (value (Edges.left F)) (value (Edges.top F)) := \block {
  \fun (F: Edges.Family) \then
  \let a: A := F Boundary.lowerLeft \then
  \let b: A := F Boundary.lowerRight \then
  \let c: A := F Boundary.upperLeft \then
  \let d: A := F Boundary.upperRight \then
  \let p: Paths.Path a b := Raw.asPath (Edges.bottom F) \then
  \let q: Paths.Path b d := Raw.asPath (Edges.right F) \then
  \let r: Paths.Path a c := Raw.asPath (Edges.left F) \then
  \let s: Paths.Path c d := Raw.asPath (Edges.top F) \then
  \return eq_reason!{{Group.mul (value (Edges.bottom F)) (value (Edges.right F))}
    "=" {Group.mul (onArrow a b (Gr.class a b p)) (onArrow b d (Gr.class b d q))} "by" {\refl(Group.mul (value (Edges.bottom F)) (value (Edges.right F)))}
    "=" {onArrow a d (Gr.compose a b d (Gr.class a b p) (Gr.class b d q))} "by" {sym!{G} _ _ (compose a b d (Gr.class a b p) (Gr.class b d q))}
    "=" {onArrow a d (Gr.compose a c d (Gr.class a c r) (Gr.class c d s))} "by" {congr!{{Gr.Arrow a d} G} (onArrow a d) _ _ (Boundary.boundary F)}
    "=" {Group.mul (onArrow a c (Gr.class a c r)) (onArrow c d (Gr.class c d s))} "by" {compose a c d (Gr.class a c r) (Gr.class c d s)}
    "=" {Group.mul (value (Edges.left F)) (value (Edges.top F))} "by" {\refl(Group.mul (value (Edges.left F)) (value (Edges.top F)))}}
};
