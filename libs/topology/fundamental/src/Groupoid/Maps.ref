\import topology.Continuity[A := A, B := B] \as Continuous;
\import Paths.Maps[B := B, target := target] \as PathMaps;
\import \root.Groupoid[A := B, source := target] \as Target;
\definition map[f: A -> B][continuous: Continuous.Continuous source target f][x, y: A]: Arrow x y -> Target.Arrow (f x) (f y) :=
  PathMaps.Between[f := f, continuous := continuous, x := x, y := y].map;
\definition onClass: \forall (f: A -> B)(continuous: Continuous.Continuous source target f)(x, y: A)(p: Paths.Path x y) ->
  map f continuous x y (class x y p) = Target.class (f x) (f y) (PathMaps.apply f continuous x y p) :=
  \fun (f: _)(continuous: _)(x, y: A) => PathMaps.Between[f := f, continuous := continuous, x := x, y := y].onClass;
\module Along(f: A -> B, continuous: Continuous.Continuous source target f);
\definition preservesIdentity: \forall (f: A -> B)(continuous: Continuous.Continuous source target f)(x: A) ->
  map f continuous x x (identity x) = Target.identity (f x) :=
  \fun (f: _)(continuous: _)(x: A) => Along[f := f, continuous := continuous].At[x := x, y := x, z := x].identityLaw;
\definition preservesComposition: \forall (f: A -> B)(continuous: Continuous.Continuous source target f)(x, y, z: A)(p: Arrow x y)(q: Arrow y z) ->
  map f continuous x z (compose x y z p q) = Target.compose (f x) (f y) (f z) (map f continuous x y p) (map f continuous y z q) :=
  \fun (f: _)(continuous: _)(x, y, z: A) => Along[f := f, continuous := continuous].At[x := x, y := y, z := z].composition;
\definition preservesInverse: \forall (f: A -> B)(continuous: Continuous.Continuous source target f)(x, y: A)(p: Arrow x y) ->
  map f continuous y x (inverse x y p) = Target.inverse (f x) (f y) (map f continuous x y p) :=
  \fun (f: _)(continuous: _)(x, y: A) => Along[f := f, continuous := continuous].At[x := x, y := y, z := y].inverseLaw;
