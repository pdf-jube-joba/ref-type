\import topology.Topology[Carrier := A] \as Space;
\import \root.Paths[A := A, source := source] \as Paths;
\import \root.Neighborhoods[A := A, source := source] \as Neighborhoods;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason;
\use Equality.eq_reason_in;
\use Logic.either;
\import algebraic_topology.Interval[] \as I;
\definition Intersection: \Pow A := Space.Intersection U V;
\definition Connected[S: \Pow A]: \Prop := \forall (x, y: A) -> Space.Member S x -> Space.Member S y -> \exists Neighborhoods.Path S x y;
\structure Hypotheses[b: A]: \Prop := {
  openU: Space.IsOpenIn source U,
  openV: Space.IsOpenIn source V,
  covers: \forall (x: A) -> Logic.Or[Space.Member U x, Space.Member V x],
  baseU: Space.Member U b,
  baseV: Space.Member V b,
  connectedU: Connected U,
  connectedV: Connected V,
  connectedIntersection: Connected Intersection,
};
\module At(b: A);
\definition vanKampen: \forall (b: A)(hypotheses: Hypotheses[b]) -> At[b := b].Data[hypotheses := hypotheses].IsAmalgamatedProduct :=
  \fun (b: A) => At[b := b].vanKampen;
