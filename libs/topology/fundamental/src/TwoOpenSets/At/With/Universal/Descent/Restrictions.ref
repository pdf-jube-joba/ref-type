\import \root.Paths[A := Left.CarrierSet, source := Left.topology source] \as LeftBased;
\import LeftBased.Maps[B := A, target := source] \as LeftProjection;
\import \root.Groupoid[A := Left.CarrierSet, source := Left.topology source].Maps[B := A, target := source] \as LeftNative;
\definition leftOnClass: \forall (p: LeftBased.Path leftBase leftBase) -> homomorphism (leftInduced (LeftGroup.class p)) = left (LeftGroup.class p) := \block {
  \fun (p: LeftBased.Path leftBase leftBase) \then
  \let q: Paths.Path b b := LeftProjection.apply leftInclusion (LeftInclusion.inclusionContinuous source) leftBase leftBase p \then
  \let within: LeftPaths.Within (Raw.forget b b q) := \fun (t: I.Carrier) => \bysub(A, U, p t) \then
  \let small: Cover.Small (Raw.forget b b q) := Logic.existsIntro[\Pow A, { S: \Pow A \where Logic.And[\In[\Pow A] family S, Cover.Within (Raw.forget b b q) S] }] U
    (Logic.And[_, _]::# (Logic.Or[U = U, U = V]::left (\refl(U))) within) \then
  \return eq_reason_in!{G {homomorphism (leftInduced (LeftGroup.class p))}
    "=" {homomorphism (Fundamental.class q)} "by" {
      congr!{Fundamental.Carrier G} homomorphism _ _ (LeftNative.onClass leftInclusion (LeftInclusion.inclusionContinuous source) leftBase leftBase p)}
    "=" {Global.extend cover (Raw.forget b b q)} "by" {Based.onClass q}
    "=" {value (Cover.asSmall (Raw.forget b b q) small)} "by" {Global.restricts cover (Cover.asSmall (Raw.forget b b q) small)}
    "=" {leftValue (Raw.forget b b q) within} "by" {sym!{G} _ _ ((agrees (Cover.asSmall (Raw.forget b b q) small)).left within)}
    "=" {LeftHolonomy.value (LeftRaw.forget leftBase leftBase p)} "by" {
      congr!{LeftRaw.Carrier G} LeftHolonomy.value _ _ (\axiom:funext(LeftPaths.raw (Raw.forget b b q) within, LeftRaw.forget leftBase leftBase p, \fun (t: I.Carrier) => \refl(p t)))}
    "=" {left (LeftGroup.class p)} "by" {LeftHolonomy.onLoop p}}
};
\definition restrictsLeft: \forall (a: LeftGroup.Carrier) -> homomorphism (leftInduced a) = left a :=
  LeftBased.Between[x := leftBase, y := leftBase].induction
    (\fun (a: LeftGroup.Carrier) => homomorphism (leftInduced a) = left a) leftOnClass;
\import \root.Paths[A := Right.CarrierSet, source := Right.topology source] \as RightBased;
\import RightBased.Maps[B := A, target := source] \as RightProjection;
\import \root.Groupoid[A := Right.CarrierSet, source := Right.topology source].Maps[B := A, target := source] \as RightNative;
\definition rightOnClass: \forall (p: RightBased.Path rightBase rightBase) -> homomorphism (rightInduced (RightGroup.class p)) = right (RightGroup.class p) := \block {
  \fun (p: RightBased.Path rightBase rightBase) \then
  \let q: Paths.Path b b := RightProjection.apply rightInclusion (RightInclusion.inclusionContinuous source) rightBase rightBase p \then
  \let within: RightPaths.Within (Raw.forget b b q) := \fun (t: I.Carrier) => \bysub(A, V, p t) \then
  \let small: Cover.Small (Raw.forget b b q) := Logic.existsIntro[\Pow A, { S: \Pow A \where Logic.And[\In[\Pow A] family S, Cover.Within (Raw.forget b b q) S] }] V
    (Logic.And[_, _]::# (Logic.Or[V = U, V = V]::right (\refl(V))) within) \then
  \return eq_reason_in!{G {homomorphism (rightInduced (RightGroup.class p))}
    "=" {homomorphism (Fundamental.class q)} "by" {
      congr!{Fundamental.Carrier G} homomorphism _ _ (RightNative.onClass rightInclusion (RightInclusion.inclusionContinuous source) rightBase rightBase p)}
    "=" {Global.extend cover (Raw.forget b b q)} "by" {Based.onClass q}
    "=" {value (Cover.asSmall (Raw.forget b b q) small)} "by" {Global.restricts cover (Cover.asSmall (Raw.forget b b q) small)}
    "=" {rightValue (Raw.forget b b q) within} "by" {sym!{G} _ _ ((agrees (Cover.asSmall (Raw.forget b b q) small)).right within)}
    "=" {RightHolonomy.value (RightRaw.forget rightBase rightBase p)} "by" {
      congr!{RightRaw.Carrier G} RightHolonomy.value _ _ (\axiom:funext(RightPaths.raw (Raw.forget b b q) within, RightRaw.forget rightBase rightBase p, \fun (t: I.Carrier) => \refl(p t)))}
    "=" {right (RightGroup.class p)} "by" {RightHolonomy.onLoop p}}
};
\definition restrictsRight: \forall (a: RightGroup.Carrier) -> homomorphism (rightInduced a) = right a :=
  RightBased.Between[x := rightBase, y := rightBase].induction
    (\fun (a: RightGroup.Carrier) => homomorphism (rightInduced a) = right a) rightOnClass;
