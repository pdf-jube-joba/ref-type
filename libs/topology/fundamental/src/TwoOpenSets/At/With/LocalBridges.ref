\import \root.Bridges[A := Left.CarrierSet, source := Left.topology source, basepoint := leftBase] \as LeftBridges;
\import \root.Bridges[A := Right.CarrierSet, source := Right.topology source, basepoint := rightBase] \as RightBridges;
\import \root.Bridges[A := Overlap.CarrierSet, source := Overlap.topology source, basepoint := overlapBase] \as OverlapBridges;
\import \root.Paths[A := Left.CarrierSet, source := Left.topology source] \as LeftBased;
\import \root.Paths[A := Right.CarrierSet, source := Right.topology source] \as RightBased;
\import \root.Paths[A := Overlap.CarrierSet, source := Overlap.topology source] \as OverlapBased;
\definition left: LeftBridges.Family := \fun (x: Left.CarrierSet) =>
  \into[LeftBased.Path leftBase x](LeftPaths.path leftBase x (bridges x) ((bridgeLaws x (bridges x)).withinU (\bysub(A, U, x))), LeftBridges.Bridge x) \by {
    \fun (t: I.Carrier)(same: x = leftBase) => (bridgeLaws x (bridges x)).normalized t same
  };
\definition right: RightBridges.Family := \fun (x: Right.CarrierSet) =>
  \into[RightBased.Path rightBase x](RightPaths.path rightBase x (bridges x) ((bridgeLaws x (bridges x)).withinV (\bysub(A, V, x))), RightBridges.Bridge x) \by {
    \fun (t: I.Carrier)(same: x = rightBase) => (bridgeLaws x (bridges x)).normalized t same
  };
\definition overlap: OverlapBridges.Family := \fun (x: Overlap.CarrierSet) =>
  \into[OverlapBased.Path overlapBase x](OverlapPaths.path overlapBase x (bridges x)
    (\fun (t: I.Carrier) => Logic.And[_, _]::# ((bridgeLaws x (bridges x)).withinU ((\bysub(A, Intersection, x)).left) t)
      ((bridgeLaws x (bridges x)).withinV ((\bysub(A, Intersection, x)).right) t)), OverlapBridges.Bridge x) \by {
    \fun (t: I.Carrier)(same: x = overlapBase) => (bridgeLaws x (bridges x)).normalized t same
  };
\import \root.Bridges[A := A, source := source, basepoint := b] \as GlobalBridges;
\definition global: GlobalBridges.Family := \fun (x: A) => \into[Paths.Path b x](bridges x, GlobalBridges.Bridge x) \by {
  (bridgeLaws x (bridges x)).normalized
};
