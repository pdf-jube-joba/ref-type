\import Space.Subspace[S := U] \as Left;
\import Space.Subspace[S := V] \as Right;
\import Space.Subspace[S := Intersection] \as Overlap;
\import \root.SubspacePaths[A := A, source := source, U := U] \as LeftPaths;
\import \root.SubspacePaths[A := A, source := source, U := V] \as RightPaths;
\import \root.SubspacePaths[A := A, source := source, U := Intersection] \as OverlapPaths;
\definition leftBase: Left.CarrierSet := \into[A](b, U) \by { hypotheses.baseU };
\definition rightBase: Right.CarrierSet := \into[A](b, V) \by { hypotheses.baseV };
\definition overlapBase: Overlap.CarrierSet := \into[A](b, Intersection) \by { Logic.And[_, _]::# hypotheses.baseU hypotheses.baseV };
\import \root.FundamentalGroup[A := Left.CarrierSet, source := Left.topology source, basepoint := leftBase] \as LeftGroup;
\import \root.FundamentalGroup[A := Right.CarrierSet, source := Right.topology source, basepoint := rightBase] \as RightGroup;
\import \root.FundamentalGroup[A := Overlap.CarrierSet, source := Overlap.topology source, basepoint := overlapBase] \as OverlapGroup;
\import \root.FundamentalGroup[A := A, source := source, basepoint := b] \as Fundamental;
\import OverlapPaths.Inside[V := U, subset := \fun (x: A)(member: Space.Member Intersection x) => member.left] \as OverlapLeft;
\import OverlapPaths.Inside[V := V, subset := \fun (x: A)(member: Space.Member Intersection x) => member.right] \as OverlapRight;
\import OverlapLeft.At[b := overlapBase] \as OverlapLeftGroup;
\import OverlapRight.At[b := overlapBase] \as OverlapRightGroup;
\import topology.Continuity[A := A, B := A].Corestriction[S := U] \as LeftInclusion;
\import topology.Continuity[A := A, B := A].Corestriction[S := V] \as RightInclusion;
\definition leftInclusion[x: Left.CarrierSet]: A := x;
\definition rightInclusion[x: Right.CarrierSet]: A := x;
\import LeftGroup.Maps[B := A, target := source].Along[f := leftInclusion, continuous := LeftInclusion.inclusionContinuous source] \as LeftMap;
\import RightGroup.Maps[B := A, target := source].Along[f := rightInclusion, continuous := RightInclusion.inclusionContinuous source] \as RightMap;
\definition leftInduced: algebra.Hom[A := LeftGroup.Carrier, B := Fundamental.Carrier].GroupMap LeftGroup.group Fundamental.group := LeftMap.induced;
\definition rightInduced: algebra.Hom[A := RightGroup.Carrier, B := Fundamental.Carrier].GroupMap RightGroup.group Fundamental.group := RightMap.induced;
\module LocalBridges;
\module Universal(G: \Set, group: std.Alg[].Alg[].Group[G], left: algebra.Hom[A := LeftGroup.Carrier, B := G].GroupMap LeftGroup.group group,
  right: algebra.Hom[A := RightGroup.Carrier, B := G].GroupMap RightGroup.group group);
\module Commutation;
\module VanKampen;
