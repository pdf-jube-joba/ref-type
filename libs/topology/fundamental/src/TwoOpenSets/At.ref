\structure BridgeLaws[x: A, p: Paths.Path b x]: \Prop := {
  normalized: \forall (t: I.Carrier) -> x = b -> p t = b,
  withinU: Space.Member U x -> Neighborhoods.Within U b x p,
  withinV: Space.Member V x -> Neighborhoods.Within V b x p,
};
\definition Bridge[x: A]: \Set := \Cast[Paths.Path b x] ({ p: Paths.Path b x \where BridgeLaws[x, p] });
\definition Family: \Set := \forall (x: A) -> Bridge x;
\definition bridgeLaws[x: A][p: Bridge x]: BridgeLaws[x, p] := \bysub(Paths.Path b x, Bridge x, p);
\module Bridges;
\module Data(hypotheses: Hypotheses[b]);
\module With(hypotheses: Hypotheses[b], bridges: Family);
\definition vanKampen: \forall (hypotheses: Hypotheses[b]) -> Data[hypotheses := hypotheses].IsAmalgamatedProduct := \block {
  \fun (hypotheses: Hypotheses[b]) \then
  \takefrom bridges: Family \by Bridges[].existsFamily hypotheses \then
  \return With[hypotheses := hypotheses, bridges := bridges].VanKampen[].universal
};
