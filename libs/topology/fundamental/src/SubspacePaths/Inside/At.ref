\import \root.FundamentalGroup[A := Under.CarrierSet, source := Under.topology source, basepoint := b] \as SourceGroup;
\import \root.FundamentalGroup[A := Target.CarrierSet, source := Target.topology source, basepoint := inclusion b] \as TargetGroup;
\import SourceGroup.Maps[B := Target.CarrierSet, target := Target.topology source].Along[f := inclusion, continuous := continuous] \as Map;
\import algebra.Hom[A := SourceGroup.Carrier, B := TargetGroup.Carrier] \as Hom;
\definition induced: Hom.GroupMap SourceGroup.group TargetGroup.group := Map.induced;
