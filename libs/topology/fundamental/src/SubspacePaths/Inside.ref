\import Space.Subspace[S := V] \as Target;
\import topology.Continuity[A := Under.CarrierSet, B := A].Corestriction[S := V] \as IntoTarget;
\import topology.Continuity[A := A, B := A].Corestriction[S := U] \as Inclusion;
\definition inclusion[x: Under.CarrierSet]: Target.CarrierSet := \into[A](x, V) \by { subset x (\bysub(A, U, x)) };
\definition continuous: topology.Continuity[A := Under.CarrierSet, B := Target.CarrierSet].Continuous (Under.topology source) (Target.topology source) inclusion :=
  IntoTarget.corestrictContinuous (Under.topology source) source inclusion (Inclusion.inclusionContinuous source);
\module At(b: Under.CarrierSet);
