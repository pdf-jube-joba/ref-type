\import \root.FundamentalGroup[A := B, source := target, basepoint := f basepoint] \as Target;
\import algebra.Hom[A := Carrier, B := Target.Carrier] \as Hom;
\definition apply: Carrier -> Target.Carrier := Maps.map f continuous basepoint basepoint;
\definition induced: Hom.GroupMap group Target.group := \into[Carrier -> Target.Carrier](apply, Hom.GroupMap group Target.group) \by {
  Hom.MonoidLaws[monoid, Target.monoid, apply] {
    unit := Maps.preservesIdentity f continuous basepoint,
    operation := Maps.preservesComposition f continuous basepoint basepoint basepoint,
  }
};
