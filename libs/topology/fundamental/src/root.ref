\module Paths(A: \Set, source: topology.Topology[Carrier := A].Topology);
\module IntervalPaths;
\module Groupoid(A: \Set, source: topology.Topology[Carrier := A].Topology);
\module FundamentalGroup(A: \Set, source: topology.Topology[Carrier := A].Topology, basepoint: A);
\module UnbasedPaths(A: \Set, source: topology.Topology[Carrier := A].Topology);
\module VanKampen(A: \Set, source: topology.Topology[Carrier := A].Topology, G: \Set, group: std.Alg[].Alg[].Group[G]);
\module Examples;
\module Neighborhoods(A: \Set, source: topology.Topology[Carrier := A].Topology);
\module Bridges(A: \Set, source: topology.Topology[Carrier := A].Topology, basepoint: A);
\module SquarePaths;
\module Holonomy(A: \Set, source: topology.Topology[Carrier := A].Topology, b: A, G: \Set, group: std.Alg[].Alg[].Group[G],
