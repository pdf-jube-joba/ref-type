\import \root.UnbasedPaths[A := A, source := source] \as Raw;
\definition changeStart: \forall (x, u, y: A)(p: Path x y)(q: Path u y) -> x = u ->
  (\forall (t: Interval.Carrier) -> p t = q t) -> value x y p = value u y q :=
  \fun (x, u, y: A)(p: _)(q: _)(same: x = u) =>
    (\idelim x = u \with z: A => \forall (r: Path z y) -> (\forall (t: Interval.Carrier) -> p t = r t) -> value x y p = value z y r
      \by { base: \fun (r: Path x y)(equal: _) => congr!{{Path x y} C} (value x y) p r (\axiom:funext(p, r, equal)), equality: same }) q;
\definition changeEnd: \forall (x, y, v: A)(p: Path x y)(q: Path x v) -> y = v ->
  (\forall (t: Interval.Carrier) -> p t = q t) -> value x y p = value x v q :=
  \fun (x, y, v: A)(p: _)(q: _)(same: y = v) =>
    (\idelim y = v \with z: A => \forall (r: Path x z) -> (\forall (t: Interval.Carrier) -> p t = r t) -> value x y p = value x z r
      \by { base: \fun (r: Path x y)(equal: _) => congr!{{Path x y} C} (value x y) p r (\axiom:funext(p, r, equal)), equality: same }) q;
\definition samePath: \forall (x, y, u, v: A)(p: Path x y)(q: Path u v) ->
  (\forall (t: Interval.Carrier) -> p t = q t) -> value x y p = value u v q := \block {
  \fun (x, y, u, v: A)(p: _)(q: _)(equal: _) \then
  \let starts: x = u := trans!{A} _ _ _ (sym!{A} _ _ (laws x y p).start) (trans!{A} _ _ _ (equal Interval.start) (laws u v q).start) \then
  \let ends: y = v := trans!{A} _ _ _ (sym!{A} _ _ (laws x y p).end) (trans!{A} _ _ _ (equal Interval.end) (laws u v q).end) \then
  \let r: Path u y := \into[Function](p, Path u y) \by {
    Laws[u, y, p] { continuous := (laws x y p).continuous, start := trans!{A} _ _ _ (laws x y p).start starts, end := (laws x y p).end }
  } \then
  \return trans!{C} _ _ _ (changeStart x u y p r starts (\fun (t: Interval.Carrier) => \refl(p t))) (changeEnd u y v r q ends equal)
};
\definition unbased[p: Raw.Carrier]: C := value (p Interval.start) (p Interval.end) (Raw.asPath p);
\definition onPath: \forall (x, y: A)(p: Path x y) -> unbased (Raw.forget x y p) = value x y p :=
  \fun (x, y: A)(p: _) => samePath (p Interval.start) (p Interval.end) x y (Raw.asPath (Raw.forget x y p)) p (\fun (t: Interval.Carrier) => \refl(p t));
