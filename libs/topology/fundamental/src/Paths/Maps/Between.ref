\import \parent.\parent.Between[x := x, y := y] \as SourceClasses;
\import Target.Between[x := f x, y := f y] \as TargetClasses;
\import SourceClasses.Functions[B := TargetClasses.Carrier] \as Descent;
\definition onPath[p: Path x y]: TargetClasses.Carrier := TargetClasses.class (apply f continuous x y p);
\definition wellDefined: Descent.Respects onPath := \fun (p, q: Path x y)(related: Homotopic x y p q) =>
  TargetClasses.sameClass (apply f continuous x y p) (apply f continuous x y q) (respects f continuous x y p q related);
\definition map: SourceClasses.Carrier -> TargetClasses.Carrier := Descent.descend onPath wellDefined;
\definition onClass: \forall (p: Path x y) -> map (SourceClasses.class p) = TargetClasses.class (apply f continuous x y p) :=
  Descent.onClass onPath wellDefined;
