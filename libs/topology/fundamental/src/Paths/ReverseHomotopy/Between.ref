\import \parent.\parent.Between[x := x, y := y] \as From;
\import \parent.\parent.Between[x := y, y := x] \as To;
\import From.Functions[B := To.Carrier] \as Descent;
\definition onPath[f: Path x y]: To.Carrier := To.class (reverse x y f);
\definition wellDefined: Descent.Respects onPath := \fun (f, g: Path x y)(related: Homotopic x y f g) =>
  To.sameClass (reverse x y f) (reverse x y g) (respects x y f g related);
\definition inverse: From.Carrier -> To.Carrier := Descent.descend onPath wellDefined;
\definition onClass: \forall (f: Path x y) -> inverse (From.class f) = To.class (reverse x y f) :=
  Descent.onClass onPath wellDefined;
