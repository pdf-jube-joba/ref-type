\import \parent.\parent.Between[x := x, y := y] \as First;
\import \parent.\parent.Between[x := y, y := z] \as Second;
\import \parent.\parent.Between[x := x, y := z] \as Result;
\import std.Set[].Quotient[A := Path x y, Equivalent := Homotopic x y].Binary[C := Path y z, B := Result.Carrier, OtherEquivalent := Homotopic y z] \as Descent;
\import \parent.Homotopies[] \as Homotopies;
\definition onPaths[p: Path x y][q: Path y z]: Result.Carrier := Result.class (concatenate x y z p q);
\definition respects: Descent.Respects onPaths := \fun (p, p2: Path x y)(q, q2: Path y z)(first: _)(second: _) =>
  Result.sameClass (concatenate x y z p q) (concatenate x y z p2 q2) (Homotopies.respects x y z p p2 q q2 first second);
\definition compose: First.Carrier -> Second.Carrier -> Result.Carrier := Descent.value First.equivalence Second.equivalence onPaths respects;
\definition onClass: \forall (p: Path x y)(q: Path y z) -> compose (First.class p) (Second.class q) = Result.class (concatenate x y z p q) :=
  Descent.onClass First.equivalence Second.equivalence onPaths respects;
