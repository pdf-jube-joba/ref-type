\import \root.Groupoid[A := A, source := source] \as Groupoid;
\import \root.Paths[A := A, source := source] \as Paths;
\import std.Alg[].Alg[] \as Alg;
\import std.Alg[].Monoid[] \as Monoid;
\definition Loop: \Set := Paths.Path basepoint basepoint;
\definition Carrier: \Set := Groupoid.Arrow basepoint basepoint;
\definition class: Loop -> Carrier := Groupoid.class basepoint basepoint;
\definition unit: Carrier := Groupoid.identity basepoint;
\definition multiply: Carrier -> Carrier -> Carrier := Groupoid.compose basepoint basepoint basepoint;
\definition inverse: Carrier -> Carrier := Groupoid.inverse basepoint basepoint;
\definition group: Alg.Group[Carrier] := \into[Alg.GroupData[Carrier]](Alg.GroupData[Carrier]::# unit multiply inverse, Alg.Group[Carrier]) \by {
  Alg.GroupLaws[Carrier, Alg.GroupData[Carrier]::# unit multiply inverse] {
    monoid := Monoid.MonoidLaws[Carrier, Monoid.MonoidData[Carrier]::# unit multiply] {
      leftIdentity := Groupoid.leftIdentity basepoint basepoint,
      rightIdentity := Groupoid.rightIdentity basepoint basepoint,
      associative := Groupoid.associative basepoint basepoint basepoint basepoint,
    },
    leftInverse := Groupoid.leftInverse basepoint basepoint,
    rightInverse := Groupoid.rightInverse basepoint basepoint,
  }
};
\definition monoid: Monoid.Monoid[Carrier] :=
  \into[Monoid.MonoidData[Carrier]](Alg.groupMonoid Carrier group, Monoid.Monoid[Carrier]) \by { group.monoid };
\module Maps(B: \Set, target: topology.Topology[Carrier := B].Topology);
