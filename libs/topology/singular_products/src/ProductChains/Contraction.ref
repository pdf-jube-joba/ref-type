\import Simplex.Contraction[n := p] \as Left;
\import Simplex.Contraction[n := q] \as Right;
\import algebraic_topology.Contraction[A := Simplex.Carrier p, source := LeftSpace.topology].Product[B := Simplex.Carrier q, target := RightSpace.topology]
  .With[left := Left.contraction (Vertices.vertex p (Fin.zero p)), right := Right.contraction (Vertices.vertex q (Fin.zero q))] \as Both;
\definition contraction: algebraic_topology.Contraction[A := Carrier, source := topology].Data := Both.contraction;
