\import ActualChains.DegreeTransport[] \as TargetDegrees;
\import Tuples.DegreeTransport[] \as SourceDegrees;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition law: \forall (m, n: N.Nat^)(same: m = n)(sigma: LeftSimplices.Carrier p)(tau: RightSimplices.Carrier q)(x: Tuples.Carrier (N.Nat^::succ m)) ->
  TargetDegrees.apply m n same (#apply{(evaluation sigma tau)} m x) =
    #apply{(evaluation sigma tau)} n (SourceDegrees.apply (N.Nat^::succ m) (N.Nat^::succ n) (congr!{N.Nat^ N.Nat^} N.Nat^::succ m n same) x) :=
  \fun (m, n: N.Nat^)(same: m = n)(sigma: LeftSimplices.Carrier p)(tau: RightSimplices.Carrier q)(x: Tuples.Carrier (N.Nat^::succ m)) =>
    trans!{{ActualChains.Carrier n}} _ _ _
      (Transport.natural (\fun (k: N.Nat^) => Tuples.Carrier (N.Nat^::succ k)) ActualChains.Carrier (#apply{(evaluation sigma tau)}) m n same x)
      (congr!{{Tuples.Carrier (N.Nat^::succ n)} {ActualChains.Carrier n}} (#apply{(evaluation sigma tau)} n) _ _
        (Transport.reindex Tuples.Carrier N.Nat^::succ m n same x));
