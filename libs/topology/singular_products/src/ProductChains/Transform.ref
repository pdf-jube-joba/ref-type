\import \root.ProductChains[p := k, q := l] \as Final;
\import \root.OrderedShuffle[V := Simplex.Carrier k, W := Simplex.Carrier l] \as FinalShuffle;
\import Simplex.At[n := k] \as FinalLeft;
\import Simplex.At[n := l] \as FinalRight;
\import Simplex.Affine[m := p, n := k] \as LeftAffine;
\import Simplex.Affine[m := q, n := l] \as RightAffine;
\import \parent.Into[A := Simplex.Carrier k, B := Simplex.Carrier l, source := FinalLeft.topology, target := FinalRight.topology] \as Into;
\import singular_cohomology.Simplices[A := Simplex.Carrier k, source := FinalLeft.topology] \as LeftSimplices;
\import singular_cohomology.Simplices[A := Simplex.Carrier l, source := FinalRight.topology] \as RightSimplices;
\import singular_cohomology.Chains[A := Final.Carrier, source := Final.topology] \as FinalChains;
\import singular_cohomology.Simplices[A := Final.Carrier, source := Final.topology] \as FinalSimplices;
\import singular_cohomology.OrderedTuples[V := Final.Points] \as FinalTuples;
\import Tuples.Mapping[W := Final.Points] \as TupleMap;
\definition left(w: LeftAffine.Vertices): LeftSimplices.Carrier p :=
  \into[LeftSimplices.At[n := p].Function](LeftAffine.apply w, LeftSimplices.Carrier p) \by { LeftAffine.continuous w };
\definition right(w: RightAffine.Vertices): RightSimplices.Carrier q :=
  \into[RightSimplices.At[n := q].Function](RightAffine.apply w, RightSimplices.Carrier q) \by { RightAffine.continuous w };
\definition point(u: LeftAffine.Vertices)(v: RightAffine.Vertices)(x: Points): Final.Points :=
  FinalShuffle.Pair { left := LeftAffine.apply u #left{x}, right := RightAffine.apply v #right{x} };
\import singular_cohomology.Maps[A := Carrier, B := Final.Carrier, source := topology, target := Final.topology] \as Maps;
\module At(m: N.Nat^);
\import Complexes.Map[C := FinalTuples.complex, D := FinalChains.complex].Composition[B := Tuples.complex] \as Composition;
\import Complexes.Map[C := Tuples.complex, D := FinalChains.complex] \as Comparison;
\definition equation(u: LeftAffine.Vertices)(v: RightAffine.Vertices):
  Composition.compose Final.map (TupleMap.map (point u v)) = Into.evaluation (left u) (right v) :=
  Comparison.ext (Composition.compose Final.map (TupleMap.map (point u v))) (Into.evaluation (left u) (right v))
    (\fun (m: N.Nat^)(w: Tuples.Carrier (N.Nat^::succ m)) => At[m := m].law u v w);
\module On(u: LeftAffine.Vertices, v: RightAffine.Vertices);
\module IntoSpace(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology);
