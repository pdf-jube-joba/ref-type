\definition lowerLeft: ActualLeft.Carrier p := leftSimplex u sigma;
\definition lowerRight: ActualRight.Carrier q := rightSimplex v tau;
\definition lowerFunction: Carrier -> Product.CarrierSet := Lower.function lowerLeft lowerRight;
\definition higherFunction: Final.Carrier -> Product.CarrierSet := Higher.function sigma tau;
\definition lowerContinuous: LowerMaps.Continuous lowerFunction := Lower.continuous lowerLeft lowerRight;
\definition higherContinuous: HigherMaps.Continuous higherFunction := Higher.continuous sigma tau;
\module At(m: N.Nat^);
\import \parent.\parent.On[u := u, v := v] \as Geometry;
\definition shuffle: Lower.onSimplices lowerLeft lowerRight =
  #apply{(Higher.evaluation sigma tau)} dimension (FinalShuffle.onTuples p q u v) :=
  trans!{{ActualChains.Carrier dimension}} _ _ _ (At[m := dimension].law fundamental)
    (congr!{{FinalTuples.Carrier (N.Nat^::succ dimension)} {ActualChains.Carrier dimension}}
      (#apply{(Higher.evaluation sigma tau)} dimension) _ _ Geometry.shuffle);
