\import \parent.\parent.Into[A := A, B := B, source := source, target := target] \as Lower;
\import Final.Into[A := A, B := B, source := source, target := target] \as Higher;
\import singular_cohomology.Simplices[A := A, source := source] \as ActualLeft;
\import singular_cohomology.Simplices[A := B, source := target] \as ActualRight;
\import topological_constructions.Product[A := A, B := B] \as Product;
\import singular_cohomology.Chains[A := Product.CarrierSet, source := Product.topology source target] \as ActualChains;
\import singular_cohomology.Simplices[A := Product.CarrierSet, source := Product.topology source target] \as ActualSimplices;
\import singular_cohomology.Maps[A := Simplex.Carrier k, B := A, source := FinalLeft.topology, target := source] \as LeftMaps;
\import singular_cohomology.Maps[A := Simplex.Carrier l, B := B, source := FinalRight.topology, target := target] \as RightMaps;
\import singular_cohomology.Maps[A := Carrier, B := Product.CarrierSet, source := topology, target := Product.topology source target] \as LowerMaps;
\import singular_cohomology.Maps[A := Final.Carrier, B := Product.CarrierSet, source := Final.topology, target := Product.topology source target] \as HigherMaps;
\definition leftSimplex(u: LeftAffine.Vertices)(sigma: ActualLeft.Carrier k): ActualLeft.Carrier p :=
  LeftMaps.postcompose p sigma (ActualLeft.At[n := k].continuous sigma) (left u);
\definition rightSimplex(v: RightAffine.Vertices)(tau: ActualRight.Carrier l): ActualRight.Carrier q :=
  RightMaps.postcompose q tau (ActualRight.At[n := l].continuous tau) (right v);
\module On(u: LeftAffine.Vertices, v: RightAffine.Vertices, sigma: ActualLeft.Carrier k, tau: ActualRight.Carrier l);
