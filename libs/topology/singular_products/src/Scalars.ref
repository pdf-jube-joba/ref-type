\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Alg[].Ring[] \as Rings;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\definition base: Rings.Ring[R] := Rings.commutativeRingAsRing R ring;
\import module_theory.Module[].Over[R := R, ring := base] \as Modules;
\import Modules.Alternating[V := R, space := Modules.scalarModule] \as Sums;
\import Sums.Mapping[W := R, target := Modules.scalarModule] \as Mapping;
\import Modules.Hom[V := R, W := R, source := Modules.scalarModule, target := Modules.scalarModule] \as Maps;
\definition sum: \forall (n: N.Nat^) -> (Fin.Fin n -> R) -> R := Sums.sum;
\definition right[b: R]: Maps.Map := Maps.Map {
  apply := \fun (x: R) => (base).mul x b,
  addition := \fun (x, y: R) => (Modules.scalarModule).scalarAdd x y b,
  scalar := \fun (a, x: R) => (Modules.scalarModule).scalarAssoc a x b,
};
\definition rightSum: \forall (n: N.Nat^)(f: Fin.Fin n -> R)(b: R) -> (base).mul (sum n f) b = sum n (\fun (i: Fin.Fin n) => (base).mul (f i) b) :=
  \fun (n: N.Nat^)(f: Fin.Fin n -> R)(b: R) => Mapping.law (right b) n f;
\definition leftSum: \forall (n: N.Nat^)(a: R)(f: Fin.Fin n -> R) -> (base).mul a (sum n f) = sum n (\fun (i: Fin.Fin n) => (base).mul a (f i)) :=
  \fun (n: N.Nat^)(a: R)(f: Fin.Fin n -> R) => trans!{R} _ _ _ ((ring).mulCommutative a (sum n f))
    (trans!{R} _ _ _ (rightSum n f a)
      (Sums.congruent n (\fun (i: Fin.Fin n) => (base).mul (f i) a) (\fun (i: Fin.Fin n) => (base).mul a (f i))
        (\fun (i: Fin.Fin n) => (ring).mulCommutative (f i) a)));
