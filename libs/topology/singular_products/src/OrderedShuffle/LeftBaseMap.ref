\import \parent.At[p := N.Nat^::zero, q := q] \as Shuffle;
\import Right.Mapping[W := Pair] \as Pointwise;
\definition vertex(w: W): Pair := Pair { left := leftHead N.Nat^::zero x, right := w };
\import Commutative.Bilinear[A := Shuffle.left, B := Shuffle.right, C := Shuffle.target] \as Form;
\import Modules.Hom[V := Right.Carrier (N.Nat^::succ q), W := Product.Carrier (N.Nat^::succ q), source := Right.space (N.Nat^::succ q), target := Product.space (N.Nat^::succ q)] \as Maps;
\import Modules.Free[Generators := Right.Tuple (N.Nat^::succ q)].To[W := Product.Carrier (N.Nat^::succ q), target := Product.space (N.Nat^::succ q)] \as Free;
\definition same: Form.rightAt Shuffle.bilinear (Left.generator (N.Nat^::succ N.Nat^::zero) x) = Pointwise.push (N.Nat^::succ q) vertex :=
  Free.ext (Form.rightAt Shuffle.bilinear (Left.generator (N.Nat^::succ N.Nat^::zero) x)) (Pointwise.push (N.Nat^::succ q) vertex)
    (\fun (y: Right.Tuple (N.Nat^::succ q)) => trans!{{Product.Carrier (N.Nat^::succ q)}} _ _ _
    (Shuffle.onGenerators x y)
    (sym!{{Product.Carrier (N.Nat^::succ q)}} _ _ (Pointwise.At[n := N.Nat^::succ q].onGenerator vertex y)));
\definition onChain: \forall (y: Right.Carrier (N.Nat^::succ q)) ->
  Shuffle.apply (Left.generator (N.Nat^::succ N.Nat^::zero) x) y = #apply{(Pointwise.push (N.Nat^::succ q) vertex)} y :=
  \fun (y: Right.Carrier (N.Nat^::succ q)) => congr!{Maps.Map {Product.Carrier (N.Nat^::succ q)}} (\fun (f: Maps.Map) => #apply{f} y) _ _ same;
