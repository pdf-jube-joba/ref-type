\definition lower: N.Nat^ := length r N.Nat^::zero;
\definition law: Statement r N.Nat^::zero -> Statement (N.Nat^::succ r) N.Nat^::zero :=
  \fun (previous: Statement r N.Nat^::zero)(x: Left.Tuple (N.Nat^::succ (N.Nat^::succ r)))(y: Right.Tuple (N.Nat^::succ N.Nat^::zero)) =>
    trans!{{TargetProduct.Carrier (length (N.Nat^::succ r) N.Nat^::zero)}} _ _ _
      (Points.Cone[n := lower].law pair (Pair { left := leftHead (N.Nat^::succ r) x, right := rightHead N.Nat^::zero y }) (onTuples r N.Nat^::zero (leftTail (N.Nat^::succ r) x) y))
      (congr!{{TargetProduct.Carrier lower} {TargetProduct.Carrier (length (N.Nat^::succ r) N.Nat^::zero)}}
        (#apply{(TargetProduct.cone lower (Target.Pair { left := leftMap (leftHead (N.Nat^::succ r) x), right := rightMap (rightHead N.Nat^::zero y) }))}) _ _
        (previous (leftTail (N.Nat^::succ r) x) y));
