\definition join: N.Nat^ -> N.Nat^ -> N.Nat^ := \fun (p: N.Nat^) =>
  \induction (q: N.Nat^) \return N.Nat^ \with {
    | zero: Nat.pred p
    | succ: \fun (q: N.Nat^)(previous: N.Nat^) => Nat.add q p
  };
\definition left(p: N.Nat^): Modules.Bundle := Modules.Bundle { Carrier := Left.Carrier p, space := Left.space p };
\definition right(q: N.Nat^): Modules.Bundle := Modules.Bundle { Carrier := Right.Carrier q, space := Right.space q };
\definition target(p, q: N.Nat^): Modules.Bundle := Modules.Bundle { Carrier := Product.Carrier (join p q), space := Product.space (join p q) };
\definition Form(p, q: N.Nat^): \Set := Commutative.Bilinear[A := left p, B := right q, C := target p q].Map;
\definition bilinear: \forall (p, q: N.Nat^) -> Form p q :=
  \induction (p: N.Nat^) \return \forall (q: N.Nat^) -> Form p q \with {
    | zero: \fun (q: N.Nat^) => Commutative.Bilinear[A := left N.Nat^::zero, B := right q, C := target N.Nat^::zero q].Operations[].zero
    | succ: \fun (p: N.Nat^)(previous: \forall (q: N.Nat^) -> Form p q) =>
      \induction (q: N.Nat^) \return Form (N.Nat^::succ p) q \with {
        | zero: Commutative.Bilinear[A := left (N.Nat^::succ p), B := right N.Nat^::zero, C := target (N.Nat^::succ p) N.Nat^::zero].Operations[].zero
        | succ: \fun (q: N.Nat^)(lower: Form (N.Nat^::succ p) q) => \parent.At[p := p, q := q].bilinear
      }
  };
\definition apply(p, q: N.Nat^): Left.Carrier p -> Right.Carrier q -> Product.Carrier (join p q) := #apply{(bilinear p q)};
\definition rightDegree(p: N.Nat^): \forall (q: N.Nat^) -> join (N.Nat^::succ p) q = degree p q :=
  \induction (q: N.Nat^) \return join (N.Nat^::succ p) q = degree p q \with {
    | zero: sym!{N.Nat^} _ _ (NatLaws.addZeroLeft p)
    | succ: \fun (q: N.Nat^)(previous: join (N.Nat^::succ p) q = degree p q) => sym!{N.Nat^} _ _ (NatLaws.addSuccLeft q p)
  };
\import Product.DegreeTransport[] \as Degrees;
\definition castRight(p, q: N.Nat^): Modules.Hom[V := Product.Carrier (join (N.Nat^::succ p) q), W := Product.Carrier (degree p q),
    source := Product.space (join (N.Nat^::succ p) q), target := Product.space (degree p q)].Map :=
  Degrees.linear (join (N.Nat^::succ p) q) (degree p q) (rightDegree p q);
\module Recurrence(p, q: N.Nat^, a: V, b: W);
\module Positive(r, s: N.Nat^, a: V, b: W);
