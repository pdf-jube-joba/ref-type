\definition leftLength: N.Nat^ := length r (N.Nat^::succ s);
\definition rightLength: N.Nat^ := length (N.Nat^::succ r) s;
\definition same: rightLength = leftLength := sym!{N.Nat^} _ _ (congr!{N.Nat^ N.Nat^} N.Nat^::succ _ _ (NatLaws.addSuccLeft s r));
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\import Modules.Alternating[V := Product.Carrier leftLength, space := Product.space leftLength].Concatenation[] \as Signs;
\definition castRight: Product.Carrier rightLength -> Product.Carrier leftLength := Transport.cast Product.Carrier rightLength leftLength same;
\definition apply[x: Left.Tuple (N.Nat^::succ (N.Nat^::succ r))][y: Right.Tuple (N.Nat^::succ (N.Nat^::succ s))]
  [left: Product.Carrier leftLength][right: Product.Carrier rightLength]: Product.Carrier (length (N.Nat^::succ r) (N.Nat^::succ s)) :=
  (Product.cone leftLength (Pair { left := leftHead (N.Nat^::succ r) x, right := rightHead (N.Nat^::succ s) y })).apply
    ((Product.space leftLength).add left (Signs.twist (N.Nat^::succ r) (castRight right)));
