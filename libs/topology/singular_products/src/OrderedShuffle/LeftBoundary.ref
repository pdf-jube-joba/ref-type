\import \parent.LeftBaseMap[q := N.Nat^::succ q, x := x] \as Upper;
\import \parent.LeftBaseMap[q := q, x := x] \as Lower;
\import \parent.At[p := N.Nat^::zero, q := N.Nat^::succ q] \as UpperShuffle;
\import \parent.At[p := N.Nat^::zero, q := q] \as LowerShuffle;
\import Right.Mapping[W := Pair] \as Pointwise;
\definition law: \forall (y: Right.Carrier (N.Nat^::succ (N.Nat^::succ q))) ->
  #apply{(Product.boundary (N.Nat^::succ q))} (UpperShuffle.apply (Left.generator (N.Nat^::succ N.Nat^::zero) x) y) =
    LowerShuffle.apply (Left.generator (N.Nat^::succ N.Nat^::zero) x) (#apply{(Right.boundary (N.Nat^::succ q))} y) :=
  \fun (y: Right.Carrier (N.Nat^::succ (N.Nat^::succ q))) => trans!{{Product.Carrier (N.Nat^::succ q)}} _ _ _
    (congr!{{Product.Carrier (N.Nat^::succ (N.Nat^::succ q))} {Product.Carrier (N.Nat^::succ q)}} (#apply{(Product.boundary (N.Nat^::succ q))}) _ _ (Upper.onChain y))
    (trans!{{Product.Carrier (N.Nat^::succ q)}} _ _ _
      (Pointwise.Boundary[n := N.Nat^::succ q].commutes Upper.vertex y)
      (sym!{{Product.Carrier (N.Nat^::succ q)}} _ _ (Lower.onChain (#apply{(Right.boundary (N.Nat^::succ q))} y))));
