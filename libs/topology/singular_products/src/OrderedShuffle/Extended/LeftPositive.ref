\module At(q: N.Nat^) {
  \import \parent.\parent.Recurrence[p := N.Nat^::succ r, q := q, a := a, b := b] \as Recurrence;
  \definition Equation: \Prop := Recurrence.lhs = Recurrence.rhs;
}
\definition equation: \forall (q: N.Nat^) -> At[q := q].Equation :=
  \induction (q: N.Nat^) \return At[q := q].Equation \with {
    | zero: \parent.RightZero[r := r, a := a, b := b].equation
    | succ: \fun (q: N.Nat^)(previous: At[q := q].Equation) => \parent.Positive[r := r, s := q, a := a, b := b].equation
  };
