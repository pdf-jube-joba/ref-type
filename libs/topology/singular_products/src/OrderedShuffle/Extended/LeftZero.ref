\definition p: N.Nat^ := N.Nat^::zero;
\definition q: N.Nat^ := N.Nat^::succ s;
\import \parent.Recurrence[p := p, q := q, a := a, b := b] \as Recurrence;
\import \parent.\parent.At[p := p, q := q] \as Full;
\import \parent.\parent.At[p := p, q := s] \as Lower;
\import Fin.Tuples[A := V] \as Tuples;
\import Right.Mapping[W := Pair] \as Pointwise;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\import Modules.Laws[V := Product.Carrier q, space := Product.space q] \as Values;
\import algebra.Group[].Of[Carrier := Product.Carrier q, group := Values.additive] \as Group;
\module At(x: Left.Tuple N.Nat^::zero);
\import Commutative.FreeBilinear[X := Left.Tuple N.Nat^::zero, Y := Right.Tuple q, C := Full.target] \as Extension;
\definition equation: Recurrence.lhs = Recurrence.rhs :=
  Extension.ext Recurrence.lhs Recurrence.rhs (\fun (x: Left.Tuple N.Nat^::zero)(y: Right.Tuple q) => At[x := x].law y);
\definition law(x: Left.Carrier N.Nat^::zero)(y: Right.Carrier q): #apply{Recurrence.lhs} x y = #apply{Recurrence.rhs} x y :=
  congr!{{Commutative.Bilinear[A := Recurrence.domainLeft, B := Recurrence.domainRight, C := Full.target].Map} {Product.Carrier (length p q)}}
    (\fun (f: Commutative.Bilinear[A := Recurrence.domainLeft, B := Recurrence.domainRight, C := Full.target].Map) => #apply{f} x y) _ _ equation;
