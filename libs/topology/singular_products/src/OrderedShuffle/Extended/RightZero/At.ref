\definition nextRight: Right.Tuple (N.Nat^::succ N.Nat^::zero) := Tuples.extend N.Nat^::zero b y;
\import \parent.\parent.\parent.RightBase[].At[p := p, y := nextRight] \as UpperData;
\import \parent.\parent.\parent.RightBase[].Linear[p := p, y := nextRight] \as UpperMap;
\import \parent.\parent.\parent.RightBase[].At[p := r, y := nextRight] \as LowerData;
\import \parent.\parent.\parent.RightBase[].Linear[p := r, y := nextRight] \as LowerMap;
\definition vertex(v: V): Pair := Pair { left := v, right := rightHead N.Nat^::zero nextRight };
\definition point: Pair := Pair { left := a, right := b };
\definition pointLaw: vertex a = point := congr!{W Pair} (\fun (w: W) => Pair { left := a, right := w }) _ _ (Tuples.atZero N.Nat^::zero b y);
\definition value(x: Left.Tuple p): Product.Carrier (degree p q) := #apply{LowerData.map} (Left.generator p x);
\definition canonical(x: Left.Tuple p): Product.Carrier (length p q) := #apply{(Product.cone (degree p q) (vertex a))} (value x);
\definition lhs(x: Left.Tuple p): #apply{Recurrence.lhs} (Left.generator p x) (Right.generator N.Nat^::zero y) = canonical x :=
  trans!{{Product.Carrier (length p q)}} _ _ _
    (congr!{{Right.Carrier (N.Nat^::succ N.Nat^::zero)} {Product.Carrier (length p q)}}
      (Full.apply (#apply{(Left.cone p a)} (Left.generator p x))) _ _ (Right.Cone[n := N.Nat^::zero].onGenerator b y))
    (trans!{{Product.Carrier (length p q)}} _ _ _ (UpperMap.onChain (#apply{(Left.cone p a)} (Left.generator p x)))
      (trans!{{Product.Carrier (length p q)}} _ _ _
        (congr!{{Product.Carrier (N.Nat^::succ p)} {Product.Carrier (length p q)}} (Degrees.apply (N.Nat^::succ p) UpperData.actualLength UpperData.same) _ _
          (Pointwise.Cone[n := p].onGenerator vertex a x))
        (Degrees.coneNatural p LowerData.actualLength LowerData.same (vertex a) (#apply{(Pointwise.push p vertex)} (Left.generator p x)))));
\definition left(x: Left.Tuple p): #apply{Recurrence.leftTerm} (Left.generator p x) (Right.generator N.Nat^::zero y) = value x :=
  trans!{{Product.Carrier (degree p q)}} _ _ _
    (congr!{{Right.Carrier (N.Nat^::succ N.Nat^::zero)} {Product.Carrier (degree p q)}} (Lower.apply (Left.generator p x)) _ _
      (Right.Cone[n := N.Nat^::zero].onGenerator b y))
    (LowerMap.onChain (Left.generator p x));
\definition rightZero(x: Left.Tuple p): #apply{Recurrence.rightTerm} (Left.generator p x) (Right.generator N.Nat^::zero y) = Values.zero :=
  Transport.pointNatural Product.Carrier (\fun (n: N.Nat^) => #zero{(Product.space n)})
    (join (N.Nat^::succ p) q) (degree p q) (rightDegree p q);
\definition signedRightZero(x: Left.Tuple p):
  #apply{(Operations.sign p Recurrence.rightTerm)} (Left.generator p x) (Right.generator N.Nat^::zero y) = Values.zero :=
  trans!{{Product.Carrier (degree p q)}} _ _ _ (Operations.onSign p Recurrence.rightTerm (Left.generator p x) (Right.generator N.Nat^::zero y))
    (trans!{{Product.Carrier (degree p q)}} _ _ _
      (congr!{{Product.Carrier (degree p q)} {Product.Carrier (degree p q)}} (Signs.twist p) _ _ (rightZero x)) (Signs.twistZero p));
\definition rhs(x: Left.Tuple p): #apply{Recurrence.rhs} (Left.generator p x) (Right.generator N.Nat^::zero y) = canonical x :=
  trans!{{Product.Carrier (length p q)}} _ _ _
    (congr!{{Product.Carrier (degree p q)} {Product.Carrier (length p q)}} (#apply{(Product.cone (degree p q) point)}) _ _
      (trans!{{Product.Carrier (degree p q)}} _ _ _
        (congr2!{{Product.Carrier (degree p q)} {Product.Carrier (degree p q)} {Product.Carrier (degree p q)}} Values.add _ _ _ _
          (left x) (signedRightZero x)) (Group.zeroRight (value x))))
    (congr!{Pair {Product.Carrier (length p q)}} (\fun (c: Pair) => #apply{(Product.cone (degree p q) c)} (value x)) _ _ (sym!{Pair} _ _ pointLaw));
\definition law(x: Left.Tuple p): #apply{Recurrence.lhs} (Left.generator p x) (Right.generator N.Nat^::zero y) = #apply{Recurrence.rhs} (Left.generator p x) (Right.generator N.Nat^::zero y) :=
  trans!{{Product.Carrier (length p q)}} _ _ _ (lhs x) (sym!{{Product.Carrier (length p q)}} _ _ (rhs x));
