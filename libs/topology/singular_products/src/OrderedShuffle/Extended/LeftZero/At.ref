\definition nextLeft: Left.Tuple (N.Nat^::succ N.Nat^::zero) := Tuples.extend N.Nat^::zero a x;
\import \parent.\parent.\parent.LeftBaseMap[q := q, x := nextLeft] \as UpperMap;
\import \parent.\parent.\parent.LeftBaseMap[q := s, x := nextLeft] \as LowerMap;
\definition vertex(w: W): Pair := Pair { left := leftHead N.Nat^::zero nextLeft, right := w };
\definition point: Pair := Pair { left := a, right := b };
\definition pointLaw: vertex b = point := congr!{V Pair} (\fun (v: V) => Pair { left := v, right := b }) _ _ (Tuples.atZero N.Nat^::zero a x);
\definition value(y: Right.Tuple q): Product.Carrier q := #apply{(Pointwise.push q vertex)} (Right.generator q y);
\definition canonical(y: Right.Tuple q): Product.Carrier (length p q) := #apply{(Product.cone q (vertex b))} (value y);
\definition lhs(y: Right.Tuple q): #apply{Recurrence.lhs} (Left.generator N.Nat^::zero x) (Right.generator q y) = canonical y :=
  trans!{{Product.Carrier (length p q)}} _ _ _
    (congr!{{Left.Carrier (N.Nat^::succ N.Nat^::zero)} {Product.Carrier (length p q)}}
      (\fun (v: Left.Carrier (N.Nat^::succ N.Nat^::zero)) => Full.apply v (#apply{(Right.cone q b)} (Right.generator q y))) _ _ (Left.Cone[n := N.Nat^::zero].onGenerator a x))
    (trans!{{Product.Carrier (length p q)}} _ _ _ (UpperMap.onChain (#apply{(Right.cone q b)} (Right.generator q y)))
      (Pointwise.Cone[n := q].onGenerator vertex b y));
\definition right(y: Right.Tuple q): #apply{Recurrence.rightTerm} (Left.generator N.Nat^::zero x) (Right.generator q y) = value y :=
  trans!{{Product.Carrier q}} _ _ _
    (Transport.castRefl Product.Carrier q (Lower.apply (#apply{(Left.cone N.Nat^::zero a)} (Left.generator N.Nat^::zero x)) (Right.generator q y)))
    (trans!{{Product.Carrier q}} _ _ _
      (congr!{{Left.Carrier (N.Nat^::succ N.Nat^::zero)} {Product.Carrier q}}
        (\fun (v: Left.Carrier (N.Nat^::succ N.Nat^::zero)) => Lower.apply v (Right.generator q y)) _ _ (Left.Cone[n := N.Nat^::zero].onGenerator a x))
      (LowerMap.onChain (Right.generator q y)));
\definition rhs(y: Right.Tuple q): #apply{Recurrence.rhs} (Left.generator N.Nat^::zero x) (Right.generator q y) = canonical y :=
  trans!{{Product.Carrier (length p q)}} _ _ _
    (congr!{{Product.Carrier q} {Product.Carrier (length p q)}} (#apply{(Product.cone q point)}) _ _
      (trans!{{Product.Carrier q}} _ _ _ (Group.zeroLeft (#apply{Recurrence.rightTerm} (Left.generator N.Nat^::zero x) (Right.generator q y))) (right y)))
    (congr!{Pair {Product.Carrier (length p q)}} (\fun (c: Pair) => #apply{(Product.cone q c)} (value y)) _ _ (sym!{Pair} _ _ pointLaw));
\definition law(y: Right.Tuple q): #apply{Recurrence.lhs} (Left.generator N.Nat^::zero x) (Right.generator q y) = #apply{Recurrence.rhs} (Left.generator N.Nat^::zero x) (Right.generator q y) :=
  trans!{{Product.Carrier (length p q)}} _ _ _ (lhs y) (sym!{{Product.Carrier (length p q)}} _ _ (rhs y));
