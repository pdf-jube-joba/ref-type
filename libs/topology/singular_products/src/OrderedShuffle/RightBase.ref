\import Product.DegreeTransport[] \as Degrees;
\import Left.Mapping[W := Pair] \as Pointwise;
\import Fin.Tuples[A := V] \as LeftTuples;
\module At(p: N.Nat^, y: Right.Tuple (N.Nat^::succ N.Nat^::zero));
\definition Statement(p: N.Nat^): \Prop := \forall (x: Left.Tuple (N.Nat^::succ p))(y: Right.Tuple (N.Nat^::succ N.Nat^::zero)) ->
  onTuples p N.Nat^::zero x y = At[p := p, y := y].value x;
\module Zero(y: Right.Tuple (N.Nat^::succ N.Nat^::zero));
\module Step(p: N.Nat^, y: Right.Tuple (N.Nat^::succ N.Nat^::zero));
\definition law: \forall (p: N.Nat^) -> Statement p := \induction (p: N.Nat^) \return Statement p \with {
  | zero: \fun (x: Left.Tuple (N.Nat^::succ N.Nat^::zero))(y: Right.Tuple (N.Nat^::succ N.Nat^::zero)) => Zero[y := y].law x
  | succ: \fun (p: N.Nat^)(previous: Statement p)(x: Left.Tuple (N.Nat^::succ (N.Nat^::succ p)))(y: Right.Tuple (N.Nat^::succ N.Nat^::zero)) => Step[p := p, y := y].law previous x
};
\module Linear(p: N.Nat^, y: Right.Tuple (N.Nat^::succ N.Nat^::zero));
