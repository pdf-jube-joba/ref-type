\definition left: Modules.Bundle := Modules.Bundle { Carrier := Left.Carrier (N.Nat^::succ p), space := Left.space (N.Nat^::succ p) };
\definition right: Modules.Bundle := Modules.Bundle { Carrier := Right.Carrier (N.Nat^::succ q), space := Right.space (N.Nat^::succ q) };
\definition target: Modules.Bundle := Modules.Bundle { Carrier := Product.Carrier (length p q), space := Product.space (length p q) };
\import Commutative.Bilinear[A := left, B := right, C := target] \as Bilinear;
\import Commutative.FreeBilinear[X := Left.Tuple (N.Nat^::succ p), Y := Right.Tuple (N.Nat^::succ q), C := target] \as Extension;
\definition bilinear: Bilinear.Map := Extension.extend (onTuples p q);
\definition apply: left.Carrier -> right.Carrier -> target.Carrier := #apply{bilinear};
\definition laws: Bilinear.Laws[bilinear] := Bilinear.laws bilinear;
\definition onGenerators: \forall (x: Left.Tuple (N.Nat^::succ p))(y: Right.Tuple (N.Nat^::succ q)) ->
  apply (Left.generator (N.Nat^::succ p) x) (Right.generator (N.Nat^::succ q) y) = onTuples p q x y := Extension.onGenerators (onTuples p q);
