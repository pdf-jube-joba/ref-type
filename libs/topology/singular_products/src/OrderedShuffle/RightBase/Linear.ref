\import \parent.At[p := p, y := y] \as Data;
\import \parent.\parent.At[p := p, q := N.Nat^::zero] \as Shuffle;
\import Commutative.Bilinear[A := Shuffle.left, B := Shuffle.right, C := Shuffle.target] \as Form;
\import Modules.Free[Generators := Left.Tuple (N.Nat^::succ p)].To[W := Product.Carrier Data.actualLength, target := Product.space Data.actualLength] \as Free;
\import Modules.Hom[V := Left.Carrier (N.Nat^::succ p), W := Product.Carrier Data.actualLength, source := Left.space (N.Nat^::succ p), target := Product.space Data.actualLength] \as Maps;
\definition equation: Form.leftAt Shuffle.bilinear (Right.generator (N.Nat^::succ N.Nat^::zero) y) = Data.map :=
  Free.ext (Form.leftAt Shuffle.bilinear (Right.generator (N.Nat^::succ N.Nat^::zero) y)) Data.map
    (\fun (x: Left.Tuple (N.Nat^::succ p)) => trans!{{Product.Carrier Data.actualLength}} _ _ _ (Shuffle.onGenerators x y) (law p x y));
\definition onChain: \forall (x: Left.Carrier (N.Nat^::succ p)) -> Shuffle.apply x (Right.generator (N.Nat^::succ N.Nat^::zero) y) = #apply{Data.map} x :=
  \fun (x: Left.Carrier (N.Nat^::succ p)) => congr!{Maps.Map {Product.Carrier Data.actualLength}} (\fun (f: Maps.Map) => #apply{f} x) _ _ equation;
