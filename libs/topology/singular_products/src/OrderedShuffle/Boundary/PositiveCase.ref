\definition p: N.Nat^ := N.Nat^::succ r;
\definition q: N.Nat^ := N.Nat^::succ s;
\import \parent.At[p := p, q := q] \as Current;
\import \parent.\parent.At[p := p, q := q] \as Full;
\import Commutative.Bilinear[A := Full.left, B := Full.right, C := Current.target] \as Form;
\import Commutative.FreeBilinear[X := Left.Tuple (N.Nat^::succ p), Y := Right.Tuple (N.Nat^::succ q), C := Current.target] \as Extension;
\module OnTuples(x: Left.Tuple (N.Nat^::succ p), y: Right.Tuple (N.Nat^::succ q));
\definition equation: Statement r q -> Statement p s -> Statement p q :=
  \fun (previousLeft: Statement r q)(previousRight: Statement p s) =>
    Extension.ext Current.lhs Current.rhs (\fun (x: Left.Tuple (N.Nat^::succ p))(y: Right.Tuple (N.Nat^::succ q)) =>
      OnTuples[x := x, y := y].law previousLeft previousRight);
