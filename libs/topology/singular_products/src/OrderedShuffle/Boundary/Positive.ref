\definition p: N.Nat^ := N.Nat^::succ r;
\definition q: N.Nat^ := N.Nat^::succ s;
\definition m: N.Nat^ := degree r q;
\definition t: N.Nat^ := degree p s;
\import \parent.\parent.Extended[] \as Extended;
\import Product.DegreeTransport[] \as Degrees;
\definition same: t = m := Extended.rightDegree r q;
\definition lowerCast: Modules.Hom[V := Product.Carrier t, W := Product.Carrier m, source := Product.space t, target := Product.space m].Map := Degrees.linear t m same;
\definition upperCast: Modules.Hom[V := Product.Carrier (N.Nat^::succ t), W := Product.Carrier (N.Nat^::succ m), source := Product.space (N.Nat^::succ t), target := Product.space (N.Nat^::succ m)].Map :=
  Degrees.linear (N.Nat^::succ t) (N.Nat^::succ m) (congr!{N.Nat^ N.Nat^} N.Nat^::succ t m same);
\import \parent.At[p := p, q := q] \as Current;
\import \parent.At[p := r, q := q] \as LowerLeft;
\import \parent.At[p := p, q := s] \as LowerRight;
\import \parent.\parent.At[p := r, q := q] \as LeftShuffle;
\import \parent.\parent.At[p := p, q := s] \as RightShuffle;
\import \parent.\parent.At[p := p, q := q] \as FullShuffle;
\import Extended.Recurrence[p := p, q := q, a := a, b := b] \as FullRecurrence;
\import Extended.Recurrence[p := r, q := q, a := a, b := b] \as LeftRecurrence;
\import Extended.Recurrence[p := p, q := s, a := a, b := b] \as RightRecurrence;
\definition point: Pair := Pair { left := a, right := b };
\definition X: Left.Carrier p -> Left.Carrier (N.Nat^::succ p) := (Left.cone p a).apply;
\definition Y: Right.Carrier q -> Right.Carrier (N.Nat^::succ q) := (Right.cone q b).apply;
\definition leftBoundary: Left.Carrier p -> Left.Carrier r := (Left.boundary r).apply;
\definition rightBoundary: Right.Carrier q -> Right.Carrier s := (Right.boundary s).apply;
\import Modules.Laws[V := Product.Carrier (N.Nat^::succ m), space := Product.space (N.Nat^::succ m)] \as Upper;
\import Modules.Laws[V := Product.Carrier m, space := Product.space m] \as Lower;
\import algebra.Group[].Of[Carrier := Product.Carrier (N.Nat^::succ m), group := Upper.additive] \as UpperGroup;
\import algebra.Group[].Of[Carrier := Product.Carrier m, group := Lower.additive] \as LowerGroup;
\import Modules.Alternating[V := Product.Carrier (N.Nat^::succ m), space := Product.space (N.Nat^::succ m)].Concatenation[] \as UpperSigns;
\import Modules.Alternating[V := Product.Carrier m, space := Product.space m].Concatenation[] \as LowerSigns;
\import UpperSigns.Mapping[W := Product.Carrier m, target := Product.space m] \as BoundarySigns;
\import LowerSigns.Mapping[W := Product.Carrier (N.Nat^::succ m), target := Product.space (N.Nat^::succ m)] \as ConeSigns;
\definition cut[x: Left.Carrier p][y: Right.Carrier q]: Product.Carrier (N.Nat^::succ m) :=
  Upper.add (LeftShuffle.apply x (Y y)) (UpperSigns.twist p ((upperCast).apply (RightShuffle.apply (X x) y)));
\import Commutative.Bilinear[A := FullRecurrence.domainLeft, B := FullRecurrence.domainRight, C := FullRecurrence.middle].Operations[] \as FullOperations;
\definition shuffle[x: Left.Carrier p][y: Right.Carrier q]: FullShuffle.apply (X x) (Y y) = (Product.cone (N.Nat^::succ m) point).apply (cut x y) :=
  trans!{{Product.Carrier (length p q)}} _ _ _ (Extended.Positive[r := r, s := s, a := a, b := b].law x y)
    (congr!{{Product.Carrier (N.Nat^::succ m)} {Product.Carrier (length p q)}} ((Product.cone (N.Nat^::succ m) point).apply) _ _
      (congr!{{Product.Carrier (N.Nat^::succ m)} {Product.Carrier (N.Nat^::succ m)}} (Upper.add (LeftShuffle.apply x (Y y))) _ _
        (FullOperations.onSign p FullRecurrence.rightTerm x y)));
\definition derivative[x: Left.Carrier p][y: Right.Carrier q]:
  (Product.boundary m).apply (cut x y) =
    Lower.add ((Product.boundary m).apply (LeftShuffle.apply x (Y y)))
      (LowerSigns.twist p ((lowerCast).apply ((Product.boundary t).apply (RightShuffle.apply (X x) y)))) :=
  trans!{{Product.Carrier m}} _ _ _
    ((Product.boundary m).addition (LeftShuffle.apply x (Y y)) (UpperSigns.twist p ((upperCast).apply (RightShuffle.apply (X x) y))))
    (congr!{{Product.Carrier m} {Product.Carrier m}} (Lower.add ((Product.boundary m).apply (LeftShuffle.apply x (Y y)))) _ _
      (trans!{{Product.Carrier m}} _ _ _ (BoundarySigns.law (Product.boundary m) p ((upperCast).apply (RightShuffle.apply (X x) y)))
        (congr!{{Product.Carrier m} {Product.Carrier m}} (LowerSigns.twist p) _ _
          (sym!{{Product.Carrier m}} _ _ (Degrees.boundaryNatural t m same (RightShuffle.apply (X x) y))))));
\module Expansion;
\module Cancellation;
\module Coning;
\module RightHandSide;
\module OnCones;
