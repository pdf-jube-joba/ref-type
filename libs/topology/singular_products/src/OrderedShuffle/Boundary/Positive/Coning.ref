\import \parent.Expansion[] \as Expansion;
\import \parent.Cancellation[] \as Cancellation;
\definition leftPart[x: Left.Carrier p][y: Right.Carrier q]: Product.Carrier m :=
  Lower.add (Expansion.first x y) (LowerSigns.twist r (Cancellation.leftRemoved x y));
\definition rightPart[x: Left.Carrier p][y: Right.Carrier q]: Product.Carrier m :=
  Lower.add (LowerSigns.twist p (Cancellation.rightRemoved x y)) (Expansion.last x y);
\definition removedLeft[x: Left.Carrier p][y: Right.Carrier q]: Product.Carrier (N.Nat^::succ m) :=
  LeftShuffle.apply ((Left.cone r a).apply (leftBoundary x)) (Y y);
\definition removedRight[x: Left.Carrier p][y: Right.Carrier q]: Product.Carrier (N.Nat^::succ m) :=
  UpperSigns.twist p ((upperCast).apply (RightShuffle.apply (X x) ((Right.cone s b).apply (rightBoundary y))));
\definition removed[x: Left.Carrier p][y: Right.Carrier q]: Product.Carrier (N.Nat^::succ m) := Upper.add (removedLeft x y) (removedRight x y);
\module LeftTerm;
\module RightTerm;
\definition combined[x: Left.Carrier p][y: Right.Carrier q]:
  (Product.cone m point).apply (Cancellation.reduced x y) = removed x y :=
  trans!{{Product.Carrier (N.Nat^::succ m)}} _ _ _ ((Product.cone m point).addition (leftPart x y) (rightPart x y))
    (congr2!{{Product.Carrier (N.Nat^::succ m)} {Product.Carrier (N.Nat^::succ m)} {Product.Carrier (N.Nat^::succ m)}} Upper.add _ _ _ _
      (sym!{{Product.Carrier (N.Nat^::succ m)}} _ _ (LeftTerm[].law x y))
      (sym!{{Product.Carrier (N.Nat^::succ m)}} _ _ (RightTerm[].law x y)));
\definition law: Statement r q -> Statement p s -> \forall (x: Left.Carrier p)(y: Right.Carrier q) ->
  (Product.cone m point).apply ((Product.boundary m).apply (cut x y)) = removed x y :=
  \fun (previousLeft: Statement r q)(previousRight: Statement p s)(x: Left.Carrier p)(y: Right.Carrier q) =>
    trans!{{Product.Carrier (N.Nat^::succ m)}} _ _ _
      (congr!{{Product.Carrier m} {Product.Carrier (N.Nat^::succ m)}} ((Product.cone m point).apply) _ _ (Cancellation.law previousLeft previousRight x y))
      (combined x y);
