\import \parent.Coning[] \as Coning;
\import \parent.RightHandSide[] \as RightHandSide;
\definition law: Statement r q -> Statement p s -> \forall (x: Left.Carrier p)(y: Right.Carrier q) ->
  #apply{Current.lhs} (X x) (Y y) = #apply{Current.rhs} (X x) (Y y) :=
  \fun (previousLeft: Statement r q)(previousRight: Statement p s)(x: Left.Carrier p)(y: Right.Carrier q) =>
    trans!{{Product.Carrier (N.Nat^::succ m)}} _ _ _
      (congr!{{Product.Carrier (N.Nat^::succ (N.Nat^::succ m))} {Product.Carrier (N.Nat^::succ m)}} (#apply{(Product.boundary (N.Nat^::succ m))}) _ _ (shuffle x y))
      (trans!{{Product.Carrier (N.Nat^::succ m)}} _ _ _ (Product.ConeBoundary[n := m].law point (cut x y))
        (trans!{{Product.Carrier (N.Nat^::succ m)}} _ _ _
          (congr!{{Product.Carrier (N.Nat^::succ m)} {Product.Carrier (N.Nat^::succ m)}} (UpperGroup.difference (cut x y)) _ _ (Coning.law previousLeft previousRight x y))
          (sym!{{Product.Carrier (N.Nat^::succ m)}} _ _ (RightHandSide.law x y))));
