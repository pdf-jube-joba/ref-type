\import Commutative.Bilinear[A := LeftRecurrence.domainLeft, B := LeftRecurrence.domainRight, C := LeftShuffle.target] \as Form;
\import Commutative.Bilinear[A := LeftRecurrence.domainLeft, B := LeftRecurrence.domainRight, C := LeftRecurrence.middle].Operations[] \as Operations;
\definition recurrence(x: Left.Carrier p)(y: Right.Carrier q): removedLeft x y = #apply{LeftRecurrence.rhs} (leftBoundary x) y :=
  congr!{Form.Map {Product.Carrier (N.Nat^::succ m)}} (\fun (f: Form.Map) => #apply{f} (leftBoundary x) y) _ _
    (Extended.RightPositive[s := s, a := a, b := b].equation r);
\definition law(x: Left.Carrier p)(y: Right.Carrier q): removedLeft x y = #apply{(Product.cone m point)} (leftPart x y) :=
  trans!{{Product.Carrier (N.Nat^::succ m)}} _ _ _ (recurrence x y)
    (congr!{{Product.Carrier m} {Product.Carrier (N.Nat^::succ m)}} (#apply{(Product.cone m point)}) _ _
      (congr!{{Product.Carrier m} {Product.Carrier m}} (Lower.add (Expansion.first x y)) _ _
        (Operations.onSign r LeftRecurrence.rightTerm (leftBoundary x) y)));
