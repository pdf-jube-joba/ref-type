\definition lowerLength: N.Nat^ := length r N.Nat^::zero;
\definition apply(x: Left.Tuple (N.Nat^::succ (N.Nat^::succ r)))(y: Right.Tuple (N.Nat^::succ N.Nat^::zero))(lower: Product.Carrier lowerLength): Product.Carrier (length (N.Nat^::succ r) N.Nat^::zero) :=
  #apply{(Product.cone lowerLength (Pair { left := leftHead (N.Nat^::succ r) x, right := rightHead N.Nat^::zero y }))} lower;
