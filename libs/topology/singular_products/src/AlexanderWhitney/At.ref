\import Simplices.Cut[p := p, q := q] \as Cut;
\definition total: N.Nat^ := Cut.total;
\import Modules.Tensor[V := Left.Carrier p, W := Right.Carrier q, left := Left.space p, right := Right.space q] \as Tensor;
\definition Carrier: \Set := Tensor.Carrier;
\definition space: Modules.Space Carrier := Tensor.space;
\definition front(sigma: Simplices.Carrier total): LeftSimplices.Carrier p := LeftMap.postcompose p leftProjection leftContinuous (Cut.front sigma);
\definition back(sigma: Simplices.Carrier total): RightSimplices.Carrier q := RightMap.postcompose q rightProjection rightContinuous (Cut.back sigma);
\definition value(sigma: Simplices.Carrier total): Carrier := Tensor.tensor (Left.generator p (front sigma)) (Right.generator q (back sigma));
\import Modules.Free[Generators := Simplices.Carrier total].To[W := Carrier, target := space] \as Free;
\import Modules.Hom[V := Source.Carrier total, W := Carrier, source := Source.space total, target := space] \as Maps;
\definition map: Maps.Map := Free.extension value;
\definition onGenerator: \forall (sigma: Simplices.Carrier total) -> #apply{map} (Source.generator total sigma) = value sigma := Free.onGenerator value;
