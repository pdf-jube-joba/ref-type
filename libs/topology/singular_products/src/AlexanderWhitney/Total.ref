\import N.Basic[].Def[] \as Nat;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\import Double.Tensor[C := Left.complex, D := Right.complex] \as Tensor;
\import Double.Total[C := Tensor.complex] \as Chains;
\import Double.Coordinates[C := Tensor.complex] \as Coordinates;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import Native.Map[C := Source.complex, D := Chains.complex] \as Maps;
\import Source.DegreeTransport[] \as Degrees;
\module Degree(n: N.Nat^);
\module Differential(n: N.Nat^);
\definition map: Maps.Map := Maps.Map {
  apply := \fun (n: N.Nat^) => #apply{Degree[n := n].map},
  addition := \fun (n: N.Nat^) => #addition{Degree[n := n].map},
  scalar := \fun (n: N.Nat^) => #scalar{Degree[n := n].map},
  commutes := \fun (n: N.Nat^)(x: Source.Carrier (N.Nat^::succ n)) => sym!{{Chains.Carrier n}} _ _ (Differential[n := n].law x),
};
