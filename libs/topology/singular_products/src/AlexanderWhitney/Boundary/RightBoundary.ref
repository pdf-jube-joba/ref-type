\import \parent.Values[] \as Values;
\definition front(sigma: Simplices.Carrier higher): LeftSimplices.Carrier p := LeftMap.postcompose p leftProjection leftContinuous (RightCut.front sigma);
\definition back(sigma: Simplices.Carrier higher): RightSimplices.Carrier (N.Nat^::succ q) := RightMap.postcompose (N.Nat^::succ q) rightProjection rightContinuous (RightCut.back sigma);
\definition value(sigma: Simplices.Carrier higher): Current.Carrier := Tensor.tensor (Left.generator p (front sigma)) (#apply{(Right.boundary q)} (Right.generator (N.Nat^::succ q) (back sigma)));
\import Modules.Alternating[V := Right.Carrier q, space := Right.space q].Mapping[W := Current.Carrier, target := Current.space] \as Mapping;
\definition expansion(sigma: Simplices.Carrier higher): value sigma = Sum.sum (N.Nat^::succ (N.Nat^::succ q)) (Values.right sigma) :=
  trans!{Current.Carrier} _ _ _
    (congr!{{Right.Carrier q} Current.Carrier} (Tensor.tensor (Left.generator p (front sigma))) _ _ (Right.Boundary[n := q].onGenerator (back sigma)))
    (Mapping.law (Tensor.rightLinear (Left.generator p (front sigma))) (N.Nat^::succ (N.Nat^::succ q))
      (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ q))) => Right.generator q (RightSimplices.face q i (back sigma))));
\definition map: Maps.Map := Free.extension value;
\definition onGenerator: \forall (sigma: Simplices.Carrier higher) -> #apply{map} (Source.generator higher sigma) = value sigma := Free.onGenerator value;
\definition law(sigma: Simplices.Carrier higher): #apply{map} (Source.generator higher sigma) = Sum.sum (N.Nat^::succ (N.Nat^::succ q)) (Values.right sigma) := trans!{Current.Carrier} _ _ _ (onGenerator sigma) (expansion sigma);
\module Factorization;
