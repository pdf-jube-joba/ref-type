\import \parent.Values[] \as Values;
\definition front(sigma: Simplices.Carrier higher): LeftSimplices.Carrier (N.Nat^::succ p) := LeftMap.postcompose (N.Nat^::succ p) leftProjection leftContinuous (LeftCut.front (Geometry.leftSimplex sigma));
\definition back(sigma: Simplices.Carrier higher): RightSimplices.Carrier q := RightMap.postcompose q rightProjection rightContinuous (LeftCut.back (Geometry.leftSimplex sigma));
\definition value(sigma: Simplices.Carrier higher): Current.Carrier := Tensor.tensor (#apply{(Left.boundary p)} (Left.generator (N.Nat^::succ p) (front sigma))) (Right.generator q (back sigma));
\import Modules.Alternating[V := Left.Carrier p, space := Left.space p].Mapping[W := Current.Carrier, target := Current.space] \as Mapping;
\definition expansion(sigma: Simplices.Carrier higher): value sigma = Sum.sum (N.Nat^::succ (N.Nat^::succ p)) (Values.left sigma) :=
  trans!{Current.Carrier} _ _ _
    (congr!{{Left.Carrier p} Current.Carrier} (\fun (x: Left.Carrier p) => Tensor.tensor x (Right.generator q (back sigma))) _ _ (Left.Boundary[n := p].onGenerator (front sigma)))
    (Mapping.law (Tensor.leftLinear (Right.generator q (back sigma))) (N.Nat^::succ (N.Nat^::succ p))
      (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ p))) => Left.generator p (LeftSimplices.face p i (front sigma))));
\definition map: Maps.Map := Free.extension value;
\definition onGenerator: \forall (sigma: Simplices.Carrier higher) -> #apply{map} (Source.generator higher sigma) = value sigma := Free.onGenerator value;
\definition law(sigma: Simplices.Carrier higher): #apply{map} (Source.generator higher sigma) = Sum.sum (N.Nat^::succ (N.Nat^::succ p)) (Values.left sigma) := trans!{Current.Carrier} _ _ _ (onGenerator sigma) (expansion sigma);
\module Factorization;
