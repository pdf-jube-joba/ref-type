\definition leftValue[sigma: Simplices.Carrier p]: Left.Carrier p := Left.generator p (LeftMap.postcompose p leftProjection leftContinuous sigma);
\definition rightValue[sigma: Simplices.Carrier q]: Right.Carrier q := Right.generator q (RightMap.postcompose q rightProjection rightContinuous sigma);
\definition natural[sigma: Simplices.Carrier higher][i: Fin.Fin (N.Nat^::succ higher)]: Current.Carrier := Current.value (Simplices.face total i sigma);
\definition left[sigma: Simplices.Carrier higher][i: Fin.Fin (N.Nat^::succ (N.Nat^::succ p))]: Current.Carrier :=
  Tensor.tensor (leftValue (Simplices.face p i (LeftCut.front (Geometry.leftSimplex sigma)))) (rightValue (LeftCut.back (Geometry.leftSimplex sigma)));
\definition right[sigma: Simplices.Carrier higher][i: Fin.Fin (N.Nat^::succ (N.Nat^::succ q))]: Current.Carrier :=
  Tensor.tensor (leftValue (RightCut.front sigma)) (rightValue (Simplices.face q i (RightCut.back sigma)));
\definition prefix: \forall (sigma: Simplices.Carrier higher)(i: Fin.Fin (N.Nat^::succ p)) ->
  natural sigma (Geometry.prefix i) = left sigma (Fin.widen (N.Nat^::succ p) i) :=
  \fun (sigma: Simplices.Carrier higher)(i: Fin.Fin (N.Nat^::succ p)) =>
    congr2!{{Left.Carrier p} {Right.Carrier q} Current.Carrier} Tensor.tensor _ _ _ _
      (congr!{{Simplices.Carrier p} {Left.Carrier p}} leftValue _ _ (Geometry.PrefixFront[].law i sigma))
      (congr!{{Simplices.Carrier q} {Right.Carrier q}} rightValue _ _ (Geometry.PrefixBack[].law i sigma));
\definition suffix: \forall (sigma: Simplices.Carrier higher)(i: Fin.Fin (N.Nat^::succ q)) ->
  natural sigma (Geometry.suffix i) = right sigma (Fin.succ (N.Nat^::succ q) i) :=
  \fun (sigma: Simplices.Carrier higher)(i: Fin.Fin (N.Nat^::succ q)) =>
    congr2!{{Left.Carrier p} {Right.Carrier q} Current.Carrier} Tensor.tensor _ _ _ _
      (congr!{{Simplices.Carrier p} {Left.Carrier p}} leftValue _ _ (Geometry.SuffixFront[].law i sigma))
      (congr!{{Simplices.Carrier q} {Right.Carrier q}} rightValue _ _ (Geometry.SuffixBack[].law i sigma));
\definition overlap: \forall (sigma: Simplices.Carrier higher) -> left sigma Geometry.lastLeft = right sigma (Fin.zero (N.Nat^::succ q)) :=
  \fun (sigma: Simplices.Carrier higher) =>
    congr2!{{Left.Carrier p} {Right.Carrier q} Current.Carrier} Tensor.tensor _ _ _ _
      (congr!{{Simplices.Carrier p} {Left.Carrier p}} leftValue _ _ (Geometry.Overlap[].Front[].law sigma))
      (congr!{{Simplices.Carrier q} {Right.Carrier q}} rightValue _ _ (Geometry.Overlap[].Back[].law sigma));
