\import Chains.Degree[n := n] \as Target;
\import Coordinates.Degree[n := n] \as Positions;
\import Coordinates.Product[n := n] \as Assembly;
\import Modules.Product[Index := Double.Index n, family := Target.family] \as Product;
\module At(i: Double.Index n) {
  \definition p: N.Nat^ := #first{i};
  \definition q: N.Nat^ := #second{i};
  \definition total: N.Nat^ := Nat.add p q;
  \definition same: total = n := Double.degree n i;
  \import \root.AlexanderWhitney[A := A, B := B, left := left, right := right].At[p := p, q := q] \as Current;
  \import Modules.Hom[V := Source.Carrier total, W := Current.Carrier, source := Source.space total, target := Current.space].Composition[U := Source.Carrier n, domain := Source.space n] \as Before;
  \definition map: Modules.Hom[V := Source.Carrier n, W := Current.Carrier, source := Source.space n, target := Current.space].Map :=
    Before.compose Current.map (Degrees.linear n total (sym!{N.Nat^} _ _ same));
}
\import Modules.Hom[V := Source.Carrier n, W := Product.Carrier, source := Source.space n, target := Product.space] \as ProductMaps;
\definition components: ProductMaps.Map := ProductMaps.Map {
  apply := \fun (x: Source.Carrier n)(i: Double.Index n) => #apply{At[i := i].map} x,
  addition := \fun (x, y: Source.Carrier n) => Product.ext _ _ (\fun (i: Double.Index n) => #addition{At[i := i].map} x y),
  scalar := \fun (a: I.Int^)(x: Source.Carrier n) => Product.ext _ _ (\fun (i: Double.Index n) => #scalar{At[i := i].map} a x),
};
\import Modules.Hom[V := Product.Carrier, W := Target.Carrier, source := Product.space, target := Target.space].Composition[U := Source.Carrier n, domain := Source.space n] \as After;
\definition map: Modules.Hom[V := Source.Carrier n, W := Target.Carrier, source := Source.space n, target := Target.space].Map := After.compose Assembly.fromProduct components;
\definition coordinate: \forall (i: Double.Index n)(x: Source.Carrier n) -> Positions.coordinate i (#apply{map} x) = #apply{At[i := i].map} x :=
  \fun (i: Double.Index n)(x: Source.Carrier n) => Assembly.coordinate (#apply{components} x) i;
