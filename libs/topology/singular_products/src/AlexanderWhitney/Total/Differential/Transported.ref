\import \parent.At[p := p, q := q] \as Initial;
\definition law: \forall (k: N.Nat^)(same: Nat.add p q = k) -> Property k (Coordinates.diagonal k p q same) :=
  \fun (k: N.Nat^)(same: Nat.add p q = k) =>
    (\idelim Nat.add p q = k \with d: N.Nat^ => \forall (equal: Nat.add p q = d) -> Property d (Coordinates.diagonal d p q equal) \by {
      base: \fun (equal: Nat.add p q = Nat.add p q) => Initial.law,
      equality: same
    }) same;
