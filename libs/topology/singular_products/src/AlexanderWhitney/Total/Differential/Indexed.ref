\import \parent.Transported[p := (i).first, q := (i).second] \as Transported;
\definition law: Property n i :=
  \idelim Coordinates.diagonal n (i).first (i).second (Double.degree n i) = i \with j: Double.Index n => Property n j \by {
    base: Transported.law n (Double.degree n i), equality: Double.pairRebuild i
  };
