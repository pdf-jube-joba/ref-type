\import \parent.Transported[p := #first{i}, q := #second{i}] \as Transported;
\definition law: Property n i :=
  \idelim Coordinates.diagonal n #first{i} #second{i} (Double.degree n i) = i \with j: Double.Index n => Property n j \by {
    base: Transported.law n (Double.degree n i), equality: Double.pairRebuild i
  };
