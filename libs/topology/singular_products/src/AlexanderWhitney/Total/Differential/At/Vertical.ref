\import Coordinates.Degree[n := N.Nat^::succ k] \as Positions;
\import Modules.Hom[V := RightTensor.Carrier, W := Current.Carrier, source := RightTensor.space, target := Current.space] \as Linear;
\import Modules.Hom[V := Source.Carrier (N.Nat^::succ k), W := Current.Carrier, source := Source.space (N.Nat^::succ k), target := Current.space] \as Result;
\import \root.AlexanderWhitney[A := A, B := B, left := left, right := right].At[p := p, q := N.Nat^::succ q] \as Cut;
\definition law(x: Source.Carrier (N.Nat^::succ k)):
  #apply{TensorBoundary.vertical} (Positions.coordinate CoordinateBoundary.verticalIndex (#apply{Higher.map} x)) = #apply{Boundary.RightBoundary[].map} x :=
  trans!{Current.Carrier} _ _ _
    (congr!{RightTensor.Carrier Current.Carrier} (#apply{TensorBoundary.vertical}) _ _ (Higher.coordinate CoordinateBoundary.verticalIndex x))
    (trans!{Current.Carrier} _ _ _
      (congr!{RightTensor.Carrier Current.Carrier} (\fun (v: RightTensor.Carrier) => #apply{TensorBoundary.vertical} v) _ _
        (congr!{{Source.Carrier (N.Nat^::succ k)} RightTensor.Carrier} (#apply{Cut.map}) _ _ (Transport.castRefl Source.Carrier (N.Nat^::succ k) x)))
      (trans!{Current.Carrier} _ _ _
        (congr!{Linear.Map Current.Carrier} (\fun (h: Linear.Map) => #apply{h} (#apply{Cut.map} x)) _ _ rightDifferential)
        (sym!{Current.Carrier} _ _ (congr!{Result.Map Current.Carrier} (\fun (h: Result.Map) => #apply{h} x) _ _ RightTerm.equation))));
