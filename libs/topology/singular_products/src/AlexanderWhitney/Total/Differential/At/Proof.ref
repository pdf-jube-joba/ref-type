\import \parent.Horizontal[] \as Horizontal;
\import \parent.Vertical[] \as Vertical;
\import Modules.Hom[V := Source.Carrier (N.Nat^::succ k), W := Current.Carrier, source := Source.space (N.Nat^::succ k), target := Current.space] \as Linear;
\import Modules.Alternating[V := Current.Carrier, space := Current.space].Concatenation[] \as Parity;
\definition lower(x: Source.Carrier (N.Nat^::succ k)):
  Positions.coordinate index (#apply{Lower.map} (#apply{Source.differential} k x)) = #apply{Boundary.lhs} (x) :=
  trans!{Current.Carrier} _ _ _ (Lower.coordinate index (#apply{Source.differential} k x))
    (congr!{{Source.Carrier k} Current.Carrier} (#apply{Current.map}) _ _ (Transport.castRefl Source.Carrier k (#apply{Source.differential} k x)));
\definition upper(x: Source.Carrier (N.Nat^::succ k)):
  Positions.coordinate index (#apply{Chains.differential} k (#apply{Higher.map} x)) = #apply{Boundary.rhs} x :=
  trans!{Current.Carrier} _ _ _ (CoordinateBoundary.differential (#apply{Higher.map} x))
    (congr2!{Current.Carrier Current.Carrier Current.Carrier} (#add{Current.space}) _ _ _ _
      (Horizontal.law x)
      (trans!{Current.Carrier} _ _ _ (Signs.law p _) (congr!{Current.Carrier Current.Carrier} (Parity.twist p) _ _ (Vertical.law x))));
\definition law: Property k index := \fun (x: Source.Carrier (N.Nat^::succ k)) => trans!{Current.Carrier} _ _ _ (lower x)
  (trans!{Current.Carrier} _ _ _ (congr!{Linear.Map Current.Carrier} (\fun (h: Linear.Map) => #apply{h} x) _ _ Boundary.equation) (sym!{Current.Carrier} _ _ (upper x)));
