\import Coordinates.Degree[n := N.Nat^::succ k] \as Positions;
\import Modules.Hom[V := LeftTensor.Carrier, W := Current.Carrier, source := LeftTensor.space, target := Current.space] \as Linear;
\import Modules.Hom[V := Source.Carrier (N.Nat^::succ k), W := Current.Carrier, source := Source.space (N.Nat^::succ k), target := Current.space] \as Result;
\definition law(x: Source.Carrier (N.Nat^::succ k)):
  #apply{TensorBoundary.horizontal} (Positions.coordinate CoordinateBoundary.horizontalIndex (#apply{Higher.map} x)) = #apply{Boundary.LeftBoundary[].map} x :=
  trans!{Current.Carrier} _ _ _
    (congr!{LeftTensor.Carrier Current.Carrier} (#apply{TensorBoundary.horizontal}) _ _ (Higher.coordinate CoordinateBoundary.horizontalIndex x))
    (trans!{Current.Carrier} _ _ _
      (congr!{Linear.Map Current.Carrier} (\fun (h: Linear.Map) => #apply{h} (#apply{Higher.At[i := CoordinateBoundary.horizontalIndex].map} x)) _ _ leftDifferential)
      (sym!{Current.Carrier} _ _ (congr!{Result.Map Current.Carrier} (\fun (h: Result.Map) => #apply{h} x) _ _ LeftTerm.equation)));
