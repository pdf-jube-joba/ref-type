\import std.Data[].Nat[] \as N;
\import std.Alg[].Ring[] \as Rings;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := R, ring := Rings.commutativeRingAsRing R ring] \as Modules;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as IntegerModules;
\definition baseRing: Rings.Ring[R] := Rings.commutativeRingAsRing R ring;
\definition coefficients: Modules.Bundle := Modules.Bundle { Carrier := R, space := Modules.scalarModule };
\import singular_cohomology.Cochains[A := A, source := source].OverRing[R := R, ring := ring].With[coefficients := coefficients] \as Theory;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Theory.integerCoefficients] \as Ordinary;
\import singular_cohomology.Simplices[A := A, source := source] \as Simplices;
\import singular_cohomology.Chains[A := A, source := source] \as Chains;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\definition Carrier: N.Nat^ -> \Set := Theory.Carrier;
\definition space: \forall (n: N.Nat^) -> Modules.Space (Carrier n) := Theory.space;
\definition integerCoefficients: IntegerModules.Bundle := Theory.integerCoefficients;
\module Cup(p, q: N.Nat^);
\module Unit;
\module Pullback(B: \Set, target: topology.Topology[Carrier := B].Topology);
\module DegreeTransport;
\module Associativity(p, q, r: N.Nat^);
\module Differential(n: N.Nat^);
\module Signs(n: N.Nat^);
\module Leibniz(p, q: N.Nat^);
