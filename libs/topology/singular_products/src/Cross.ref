\import std.Data[].FinSet[] \as Fin;
\import algebraic_topology.Simplex[] \as Simplex;
\import std.Data[].Nat[] \as N;
\import N.Basic[].Def[] \as Nat;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import singular_cohomology.Chains[A := A, source := left] \as Left;
\import singular_cohomology.Chains[A := B, source := right] \as Right;
\import singular_cohomology.Simplices[A := A, source := left] \as LeftSimplices;
\import singular_cohomology.Simplices[A := B, source := right] \as RightSimplices;
\import topological_constructions.Product[A := A, B := B] \as Product;
\definition topology: topology.Topology[Carrier := Product.CarrierSet].Topology := Product.topology left right;
\import singular_cohomology.Chains[A := Product.CarrierSet, source := topology] \as Target;
\import Target.DegreeTransport[] \as Degrees;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\definition degree[p, q: N.Nat^]: N.Nat^ := Nat.add q p;
\module At(p, q: N.Nat^);
\module FaceLeft(r, q: N.Nat^, i: Fin.Fin (N.Nat^::succ (N.Nat^::succ r)), sigma: LeftSimplices.Carrier (N.Nat^::succ r), tau: RightSimplices.Carrier q);
\module FaceRight(p, s: N.Nat^, i: Fin.Fin (N.Nat^::succ (N.Nat^::succ s)), sigma: LeftSimplices.Carrier p, tau: RightSimplices.Carrier (N.Nat^::succ s));
\module SumLeft(r, q: N.Nat^, sigma: LeftSimplices.Carrier (N.Nat^::succ r), tau: RightSimplices.Carrier q);
\module SumRight(p, s: N.Nat^, sigma: LeftSimplices.Carrier p, tau: RightSimplices.Carrier (N.Nat^::succ s));
\module AxisLeft(r: N.Nat^, sigma: LeftSimplices.Carrier (N.Nat^::succ r), tau: RightSimplices.Carrier N.Nat^::zero);
\module AxisRight(s: N.Nat^, sigma: LeftSimplices.Carrier N.Nat^::zero, tau: RightSimplices.Carrier (N.Nat^::succ s));
\module Positive(r, s: N.Nat^, sigma: LeftSimplices.Carrier (N.Nat^::succ r), tau: RightSimplices.Carrier (N.Nat^::succ s));
\module Boundary;
\module Total;
\module Zero;
