\import Modules.Alternating[V := Carrier n, space := space n].Concatenation[] \as Cochains;
\import Modules.Alternating[V := R, space := Modules.scalarModule].Concatenation[] \as Scalars;
\import Modules.Laws[V := Carrier n, space := space n] \as Values;
\import algebra.Group[].Of[Carrier := Carrier n, group := Values.additive] \as Group;
\definition apply: N.Nat^ -> Carrier n -> Carrier n := Cochains.twist;
\definition onSimplex: \forall (p: N.Nat^)(alpha: Carrier n)(sigma: Simplices.Carrier n) ->
  #apply{(apply p alpha)} (Chains.generator n sigma) = Scalars.twist p (#apply{alpha} (Chains.generator n sigma)) :=
  \induction (p: N.Nat^) \return \forall (alpha: Carrier n)(sigma: Simplices.Carrier n) ->
    #apply{(apply p alpha)} (Chains.generator n sigma) = Scalars.twist p (#apply{alpha} (Chains.generator n sigma)) \with {
      | zero: \fun (alpha: Carrier n)(sigma: Simplices.Carrier n) => \refl(#apply{alpha} (Chains.generator n sigma))
      | succ: \fun (p: N.Nat^)(previous: _)(alpha: Carrier n)(sigma: Simplices.Carrier n) => congr!{R R} (#neg{baseRing}) _ _ (previous alpha sigma)
    };
\definition zero: \forall (p: N.Nat^) -> apply p #zero{(space n)} = #zero{(space n)} :=
  \induction (p: N.Nat^) \return apply p #zero{(space n)} = #zero{(space n)} \with {
    | zero: \refl(#zero{(space n)})
    | succ: \fun (p: N.Nat^)(previous: _) => trans!{{Carrier n}} _ _ _ (congr!{{Carrier n} {Carrier n}} (#neg{(space n)}) _ _ previous) Group.negZero
  };
