\import \parent.\parent.Cup[p := k, q := q] \as Lower;
\import Lower.Closed[] \as ClosedProduct;
\import \parent.\parent.Cup[p := N.Nat^::succ k, q := q] \as Upper;
\import Simplices.CutFaces[p := k, q := q] \as Geometry;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition law: LeftProperty (N.Nat^::succ k) q := \block {
  \fun (alpha: Carrier (N.Nat^::succ k))(beta: Carrier q)(closed: Closed q beta)(member: Member (N.Nat^::succ k) alpha) \then
  \takefrom primitive: \Cast[Carrier k] ({ c: Carrier k \where Theory.coboundary k c = alpha }) \by member \then
  \return Membership.reflects Geometry.leftDegree Geometry.higher Geometry.same (Upper.apply alpha beta)
    (Logic.existsIntro[Carrier Lower.total, { c: Carrier Lower.total \where Theory.coboundary Lower.total c = Transport.cast Carrier Geometry.leftDegree Geometry.higher Geometry.same (Upper.apply alpha beta) }]
      (Lower.apply primitive beta)
      (trans!{{Carrier Geometry.higher}} _ _ _ (ClosedProduct.rightClosed primitive beta closed)
        (congr!{{Carrier (N.Nat^::succ k)} {Carrier Geometry.higher}}
          (\fun (a: Carrier (N.Nat^::succ k)) => Transport.cast Carrier Geometry.leftDegree Geometry.higher Geometry.same (Upper.apply a beta)) _ _
          (\bysub(Carrier k, { c: Carrier k \where Theory.coboundary k c = alpha }, primitive)))))
};
