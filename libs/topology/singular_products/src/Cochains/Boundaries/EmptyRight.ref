\import \parent.\parent.Cup[p := p, q := N.Nat^::zero] \as Product;
\import Product.Bilinear[] \as Bilinear;
\definition law: RightProperty p N.Nat^::zero :=
  \fun (alpha: Carrier p)(beta: Carrier N.Nat^::zero)(closed: Closed p alpha)(member: Member N.Nat^::zero beta) =>
    \idelim (space Product.total).zero = Product.apply alpha beta \with x: Carrier Product.total => Member Product.total x \by {
      base: zero Product.total,
      equality: sym!{{Carrier Product.total}} _ _ (trans!{{Carrier Product.total}} _ _ _
        (congr!{{Carrier N.Nat^::zero} {Carrier Product.total}} (Product.apply alpha) _ _ member)
        (Bilinear.rightZero alpha))
    };
