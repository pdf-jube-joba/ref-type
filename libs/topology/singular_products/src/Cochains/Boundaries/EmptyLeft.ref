\import \parent.\parent.Cup[p := N.Nat^::zero, q := q] \as Product;
\import Product.Bilinear[] \as Bilinear;
\definition law: LeftProperty N.Nat^::zero q :=
  \fun (alpha: Carrier N.Nat^::zero)(beta: Carrier q)(closed: Closed q beta)(member: Member N.Nat^::zero alpha) =>
    \idelim #zero{(space Product.total)} = Product.apply alpha beta \with x: Carrier Product.total => Member Product.total x \by {
      base: zero Product.total,
      equality: sym!{{Carrier Product.total}} _ _ (trans!{{Carrier Product.total}} _ _ _
        (congr!{{Carrier N.Nat^::zero} {Carrier Product.total}} (\fun (a: Carrier N.Nat^::zero) => Product.apply a beta) _ _ member)
        (Bilinear.leftZero beta))
    };
