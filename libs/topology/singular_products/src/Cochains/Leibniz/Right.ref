\import \parent.Values[] \as Values;
\definition law: \forall (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) ->
  #apply{(RightProduct.apply alpha (Theory.coboundary q beta))} (Chains.generator higher sigma) =
    Sums.sum (N.Nat^::succ (N.Nat^::succ q)) (Values.right alpha beta sigma) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) => trans!{R} _ _ _
    (RightProduct.onSimplex alpha (Theory.coboundary q beta) sigma)
    (trans!{R} _ _ _
      (congr!{R R} (#mul{baseRing} (#apply{alpha} (Chains.generator p (RightCut.front sigma)))) _ _ (RightDifferential.onSimplex beta (RightCut.back sigma)))
      (Scalars.leftSum (N.Nat^::succ (N.Nat^::succ q)) (#apply{alpha} (Chains.generator p (RightCut.front sigma)))
        (\fun (j: Fin.Fin (N.Nat^::succ (N.Nat^::succ q))) => #apply{beta} (Chains.generator q (Simplices.face q j (RightCut.back sigma))))));
