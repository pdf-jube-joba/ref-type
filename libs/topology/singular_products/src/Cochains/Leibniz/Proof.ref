\import \parent.Values[] \as Values;
\import \parent.Left[] \as Left;
\import \parent.Right[] \as Right;
\import \parent.Partition[] \as Partition;
\import RightProduct.Bilinear[] \as Extensionality;
\import Signs.Overlap[p := p, q := q] \as Overlap;
\definition differential: \forall (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) ->
  (Theory.coboundary total (Product.apply alpha beta)).apply (Chains.generator higher sigma) = Sums.sum (N.Nat^::succ higher) (Values.natural alpha beta sigma) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) => trans!{R} _ _ _ (ProductDifferential.onSimplex (Product.apply alpha beta) sigma)
    (Sums.congruent (N.Nat^::succ higher)
      (\fun (i: Fin.Fin (N.Nat^::succ higher)) => (Product.apply alpha beta).apply (Chains.generator total (Simplices.face total i sigma)))
      (Values.natural alpha beta sigma) (\fun (i: Fin.Fin (N.Nat^::succ higher)) => Product.onSimplex alpha beta (Simplices.face total i sigma)));
\use Equality.eq_reason;
\definition law: \forall (alpha: Carrier p)(beta: Carrier q) ->
  Theory.coboundary total (Product.apply alpha beta) = (space higher).add (leftTerm alpha beta) (CochainSigns.apply p (RightProduct.apply alpha (Theory.coboundary q beta))) :=
  \fun (alpha: Carrier p)(beta: Carrier q) => Extensionality.ext _ _ (\fun (sigma: Simplices.Carrier higher) => eq_reason!{
    {(Theory.coboundary total (Product.apply alpha beta)).apply (Chains.generator higher sigma)}
    "=" {Sums.sum (N.Nat^::succ higher) (Values.natural alpha beta sigma)} "by" {differential alpha beta sigma}
    "=" {(baseRing).add (Overlap.front (Values.left alpha beta sigma)) (Signs.twist (N.Nat^::succ p) (Overlap.back (Values.right alpha beta sigma)))}
    "by" {Partition.law alpha beta sigma}
    "=" {(baseRing).add (Sums.sum (N.Nat^::succ (N.Nat^::succ p)) (Values.left alpha beta sigma)) (Signs.twist p (Sums.sum (N.Nat^::succ (N.Nat^::succ q)) (Values.right alpha beta sigma)))}
    "by" {sym!{R} _ _ (Overlap.law (Values.left alpha beta sigma) (Values.right alpha beta sigma) (Values.overlap alpha beta sigma))}
    "=" {(baseRing).add ((leftTerm alpha beta).apply (Chains.generator higher sigma)) (Signs.twist p ((RightProduct.apply alpha (Theory.coboundary q beta)).apply (Chains.generator higher sigma)))}
    "by" {congr2!{R R R} ((baseRing).add) _ _ _ _ (sym!{R} _ _ (Left.law alpha beta sigma)) (congr!{R R} (Signs.twist p) _ _ (sym!{R} _ _ (Right.law alpha beta sigma)))}
    "=" {((space higher).add (leftTerm alpha beta) (CochainSigns.apply p (RightProduct.apply alpha (Theory.coboundary q beta)))).apply (Chains.generator higher sigma)}
    "by" {congr!{R R} ((baseRing).add ((leftTerm alpha beta).apply (Chains.generator higher sigma))) _ _ (sym!{R} _ _ (CochainSigns.onSimplex p (RightProduct.apply alpha (Theory.coboundary q beta)) sigma))}
  });
