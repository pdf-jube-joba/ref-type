\import \parent.Values[] \as Values;
\definition expansion: \forall (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) ->
  #apply{(LeftProduct.apply (Theory.coboundary p alpha) beta)} (Chains.generator Geometry.leftDegree (Geometry.leftSimplex sigma)) =
    Sums.sum (N.Nat^::succ (N.Nat^::succ p)) (Values.left alpha beta sigma) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) => trans!{R} _ _ _
    (LeftProduct.onSimplex (Theory.coboundary p alpha) beta (Geometry.leftSimplex sigma))
    (trans!{R} _ _ _
      (congr!{R R} (\fun (x: R) => #mul{baseRing} x (#apply{beta} (Chains.generator q (LeftCut.back (Geometry.leftSimplex sigma))))) _ _
        (LeftDifferential.onSimplex alpha (LeftCut.front (Geometry.leftSimplex sigma))))
      (Scalars.rightSum (N.Nat^::succ (N.Nat^::succ p))
        (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ p))) => #apply{alpha} (Chains.generator p (Simplices.face p i (LeftCut.front (Geometry.leftSimplex sigma)))))
        (#apply{beta} (Chains.generator q (LeftCut.back (Geometry.leftSimplex sigma))))));
\definition law: \forall (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) ->
  #apply{(leftTerm alpha beta)} (Chains.generator higher sigma) = Sums.sum (N.Nat^::succ (N.Nat^::succ p)) (Values.left alpha beta sigma) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) => trans!{R} _ _ _
    (Degrees.law Geometry.leftDegree higher Geometry.same (LeftProduct.apply (Theory.coboundary p alpha) beta) sigma)
    (trans!{R} _ _ _
      (congr!{{Simplices.Carrier Geometry.leftDegree} R}
        (\fun (tau: Simplices.Carrier Geometry.leftDegree) => #apply{(LeftProduct.apply (Theory.coboundary p alpha) beta)} (Chains.generator Geometry.leftDegree tau)) _ _
        (sym!{{Simplices.Carrier Geometry.leftDegree}} _ _ (Geometry.leftSimplexLaw sigma)))
      (expansion alpha beta sigma));
