\definition natural(alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher)(i: Fin.Fin (N.Nat^::succ higher)): R :=
  Product.values alpha beta (Simplices.face total i sigma);
\definition left(alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ p))): R :=
  #mul{baseRing} (#apply{alpha} (Chains.generator p (Simplices.face p i (LeftCut.front (Geometry.leftSimplex sigma)))))
    (#apply{beta} (Chains.generator q (LeftCut.back (Geometry.leftSimplex sigma))));
\definition right(alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher)(j: Fin.Fin (N.Nat^::succ (N.Nat^::succ q))): R :=
  #mul{baseRing} (#apply{alpha} (Chains.generator p (RightCut.front sigma)))
    (#apply{beta} (Chains.generator q (Simplices.face q j (RightCut.back sigma))));
\definition prefix: \forall (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher)(i: Fin.Fin (N.Nat^::succ p)) ->
  natural alpha beta sigma (Geometry.prefix i) = left alpha beta sigma (Fin.widen (N.Nat^::succ p) i) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher)(i: Fin.Fin (N.Nat^::succ p)) =>
    congr2!{R R R} (#mul{baseRing}) _ _ _ _
      (congr!{{Simplices.Carrier p} R} (\fun (tau: Simplices.Carrier p) => #apply{alpha} (Chains.generator p tau)) _ _ (Geometry.PrefixFront[].law i sigma))
      (congr!{{Simplices.Carrier q} R} (\fun (tau: Simplices.Carrier q) => #apply{beta} (Chains.generator q tau)) _ _ (Geometry.PrefixBack[].law i sigma));
\definition suffix: \forall (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher)(j: Fin.Fin (N.Nat^::succ q)) ->
  natural alpha beta sigma (Geometry.suffix j) = right alpha beta sigma (Fin.succ (N.Nat^::succ q) j) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher)(j: Fin.Fin (N.Nat^::succ q)) =>
    congr2!{R R R} (#mul{baseRing}) _ _ _ _
      (congr!{{Simplices.Carrier p} R} (\fun (tau: Simplices.Carrier p) => #apply{alpha} (Chains.generator p tau)) _ _ (Geometry.SuffixFront[].law j sigma))
      (congr!{{Simplices.Carrier q} R} (\fun (tau: Simplices.Carrier q) => #apply{beta} (Chains.generator q tau)) _ _ (Geometry.SuffixBack[].law j sigma));
\definition overlap: \forall (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) ->
  left alpha beta sigma Geometry.lastLeft = right alpha beta sigma (Fin.zero (N.Nat^::succ q)) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) =>
    congr2!{R R R} (#mul{baseRing}) _ _ _ _
      (congr!{{Simplices.Carrier p} R} (\fun (tau: Simplices.Carrier p) => #apply{alpha} (Chains.generator p tau)) _ _ (Geometry.Overlap[].Front[].law sigma))
      (congr!{{Simplices.Carrier q} R} (\fun (tau: Simplices.Carrier q) => #apply{beta} (Chains.generator q tau)) _ _ (Geometry.Overlap[].Back[].law sigma));
