\definition law: \forall (alpha: Carrier p)(beta: Carrier q)(gamma: Carrier r)(sigma: Simplices.Carrier Geometry.leftDegree) ->
  leftValue alpha beta gamma sigma = rightValue alpha beta gamma (Geometry.rightSimplex sigma) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(gamma: Carrier r)(sigma: Simplices.Carrier Geometry.leftDegree) => trans!{R} _ _ _
    (congr2!{R R R} (#mul{baseRing}) _ _ _ _
      (congr2!{R R R} (#mul{baseRing}) _ _ _ _
        (congr!{{Simplices.Carrier p} R} (\fun (tau: Simplices.Carrier p) => #apply{alpha} (Chains.generator p tau)) _ _ (Geometry.First[].law sigma))
        (congr!{{Simplices.Carrier q} R} (\fun (tau: Simplices.Carrier q) => #apply{beta} (Chains.generator q tau)) _ _ (Geometry.Middle[].law sigma)))
      (congr!{{Simplices.Carrier r} R} (\fun (tau: Simplices.Carrier r) => #apply{gamma} (Chains.generator r tau)) _ _ (Geometry.Last[].law sigma)))
    (#scalarAssoc{Modules.scalarModule}
      (#apply{alpha} (Chains.generator p (RightCut.front (Geometry.rightSimplex sigma))))
      (#apply{beta} (Chains.generator q (QRCut.front (RightCut.back (Geometry.rightSimplex sigma)))))
      (#apply{gamma} (Chains.generator r (QRCut.back (RightCut.back (Geometry.rightSimplex sigma))))));
