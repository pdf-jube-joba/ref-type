\import IntegerModules.Free[Generators := Simplices.Carrier total].To[W := R, target := Theory.integerCoefficients.space] \as Free;
\definition ext: \forall (f, g: Carrier total) ->
  (\forall (sigma: Simplices.Carrier total) -> #apply{f} (Chains.generator total sigma) = #apply{g} (Chains.generator total sigma)) -> f = g := Free.ext;
\import Modules.Laws[V := R, space := Modules.scalarModule] \as Scalars;
\definition leftZero: \forall (beta: Carrier q) -> apply #zero{(space p)} beta = #zero{(space total)} :=
  \fun (beta: Carrier q) => ext _ _ (\fun (sigma: Simplices.Carrier total) => trans!{R} _ _ _ (onSimplex #zero{(space p)} beta sigma)
    (Scalars.zeroScale (#apply{beta} (Chains.generator q (Cut.back sigma)))));
\definition rightZero: \forall (alpha: Carrier p) -> apply alpha #zero{(space q)} = #zero{(space total)} :=
  \fun (alpha: Carrier p) => ext _ _ (\fun (sigma: Simplices.Carrier total) => trans!{R} _ _ _ (onSimplex alpha #zero{(space q)} sigma)
    (Scalars.scaleZero (#apply{alpha} (Chains.generator p (Cut.front sigma)))));
\definition leftAdd: \forall (alpha, alphaPrime: Carrier p)(beta: Carrier q) ->
  apply (#add{(space p)} alpha alphaPrime) beta = #add{(space total)} (apply alpha beta) (apply alphaPrime beta) :=
  \fun (alpha, alphaPrime: Carrier p)(beta: Carrier q) => ext _ _ (\fun (sigma: Simplices.Carrier total) =>
    trans!{R} _ _ _ (onSimplex (#add{(space p)} alpha alphaPrime) beta sigma)
      (trans!{R} _ _ _
        (#scalarAdd{Modules.scalarModule} (#apply{alpha} (Chains.generator p (Cut.front sigma))) (#apply{alphaPrime} (Chains.generator p (Cut.front sigma))) (#apply{beta} (Chains.generator q (Cut.back sigma))))
        (sym!{R} _ _ (congr2!{R R R} (#add{baseRing}) _ _ _ _ (onSimplex alpha beta sigma) (onSimplex alphaPrime beta sigma)))));
\definition rightAdd: \forall (alpha: Carrier p)(beta, betaPrime: Carrier q) ->
  apply alpha (#add{(space q)} beta betaPrime) = #add{(space total)} (apply alpha beta) (apply alpha betaPrime) :=
  \fun (alpha: Carrier p)(beta, betaPrime: Carrier q) => ext _ _ (\fun (sigma: Simplices.Carrier total) =>
    trans!{R} _ _ _ (onSimplex alpha (#add{(space q)} beta betaPrime) sigma)
      (trans!{R} _ _ _
        (#vectorAdd{Modules.scalarModule} (#apply{alpha} (Chains.generator p (Cut.front sigma))) (#apply{beta} (Chains.generator q (Cut.back sigma))) (#apply{betaPrime} (Chains.generator q (Cut.back sigma))))
        (sym!{R} _ _ (congr2!{R R R} (#add{baseRing}) _ _ _ _ (onSimplex alpha beta sigma) (onSimplex alpha betaPrime sigma)))));
\definition leftScale: \forall (a: R)(alpha: Carrier p)(beta: Carrier q) ->
  apply (#smul{(space p)} a alpha) beta = #smul{(space total)} a (apply alpha beta) :=
  \fun (a: R)(alpha: Carrier p)(beta: Carrier q) => ext _ _ (\fun (sigma: Simplices.Carrier total) =>
    trans!{R} _ _ _ (onSimplex (#smul{(space p)} a alpha) beta sigma)
      (trans!{R} _ _ _
        (#scalarAssoc{Modules.scalarModule} a (#apply{alpha} (Chains.generator p (Cut.front sigma))) (#apply{beta} (Chains.generator q (Cut.back sigma))))
        (sym!{R} _ _ (congr!{R R} (#mul{baseRing} a) _ _ (onSimplex alpha beta sigma)))));
\definition commuteScale: \forall (a, x, y: R) -> #mul{baseRing} x (#mul{baseRing} a y) = #mul{baseRing} a (#mul{baseRing} x y) :=
  \fun (a, x, y: R) => trans!{R} _ _ _ (sym!{R} _ _ (#scalarAssoc{Modules.scalarModule} x a y))
    (trans!{R} _ _ _ (congr!{R R} (\fun (r: R) => #mul{baseRing} r y) _ _ (#mulCommutative{ring} x a))
      (#scalarAssoc{Modules.scalarModule} a x y));
\definition rightScale: \forall (a: R)(alpha: Carrier p)(beta: Carrier q) ->
  apply alpha (#smul{(space q)} a beta) = #smul{(space total)} a (apply alpha beta) :=
  \fun (a: R)(alpha: Carrier p)(beta: Carrier q) => ext _ _ (\fun (sigma: Simplices.Carrier total) =>
    trans!{R} _ _ _ (onSimplex alpha (#smul{(space q)} a beta) sigma)
      (trans!{R} _ _ _ (commuteScale a (#apply{alpha} (Chains.generator p (Cut.front sigma))) (#apply{beta} (Chains.generator q (Cut.back sigma))))
        (sym!{R} _ _ (congr!{R R} (#mul{baseRing} a) _ _ (onSimplex alpha beta sigma)))));
