\import singular_cohomology.Zero[A := A, source := source] \as Geometry;
\import Geometry.With[coefficients := Theory.integerCoefficients] \as Zero;
\import Zero.Edges[] \as Edges;
\import Modules.Laws[V := R, space := Modules.scalarModule] \as Scalars;
\import IntegerModules.Free[Generators := Simplices.Carrier (N.Nat^::succ N.Nat^::zero)].To[W := R, target := Theory.integerCoefficients.space] \as Free;
\definition law: Theory.coboundary N.Nat^::zero cochain = #zero{(space (N.Nat^::succ N.Nat^::zero))} :=
  Free.ext _ _ (\fun (sigma: Simplices.Carrier (N.Nat^::succ N.Nat^::zero)) => trans!{R} _ _ _ (Edges.coboundary cochain sigma)
    (trans!{R} _ _ _
      (congr2!{R R R} (#add{baseRing}) _ _ _ _
        (Zero.valueExtended (\fun (_: A) => #one{baseRing}) (Geometry.end sigma))
        (congr!{R R} (#neg{baseRing}) _ _ (Zero.valueExtended (\fun (_: A) => #one{baseRing}) (Geometry.start sigma))))
      (Scalars.inverseRight #one{baseRing})));
