\import Complexes.At[C := Theory.complex, k := p] \as Current;
\import \parent.\parent.Cup[p := p, q := N.Nat^::zero] \as Product;
\definition law: \forall (a: Group p) -> Product.apply a class = a :=
  Current.classInduction (\fun (a: Group p) => Product.apply a class = a)
    (\fun (x: Current.CycleCarrier) => trans!{{Group p}} _ _ _ (Product.onClasses x cycle)
      (Current.equalClass (Product.cycle x cycle) x (Cochain.At[p := p].right x)));
