\import \root.Cochains[A := B, source := target, R := R, ring := ring] \as Other;
\import Other.Cohomology[] \as OtherCohomology;
\import singular_cohomology.Cochains[A := B, source := target].OverRing[R := R, ring := ring].With[coefficients := coefficients] \as OtherTheory;
\import \parent.\parent.Pullback[B := B, target := target] \as CochainPull;
\import singular_cohomology.Maps[A := A, B := B, source := source, target := target] \as Geometry;
\import singular_cohomology.Chains[A := B, source := target] \as OtherChains;
\import resolutions.HomComplex[].Over[R := R, ring := ring].Abelian[N := coefficients]
  .NativeMapping[P := Chains.complex, Q := OtherChains.complex, L := coefficients] \as NativePull;
\import Modules.End[V := R, space := coefficients.space] \as Scalars;
\import Complexes.Map[C := OtherTheory.complex, D := Theory.complex] \as Maps;
\definition map[f: A -> B][continuous: Geometry.Continuous f]: Maps.Map := NativePull.On[f := Geometry.push f continuous, u := Scalars.identity].map;
\module At(n: N.Nat^) {
  \import Maps.At[k := n] \as Native;
  \import Complexes.At[C := OtherTheory.complex, k := n] \as Source;
  \import Complexes.At[C := Theory.complex, k := n] \as Target;
  \definition linear[f: A -> B][continuous: Geometry.Continuous f]: Modules.MapBetween (OtherCohomology.bundle n) (bundle n) := Native.induced (map f continuous);
  \definition cycle[f: A -> B][continuous: Geometry.Continuous f][x: Source.CycleCarrier]: Target.CycleCarrier := (Native.cyclesMap (map f continuous)).apply x;
  \definition onClass: \forall (f: A -> B)(continuous: Geometry.Continuous f)(x: Source.CycleCarrier) ->
    (linear f continuous).apply (Source.classOf x) = Target.classOf (cycle f continuous x) :=
    \fun (f: A -> B)(continuous: Geometry.Continuous f) => Native.onClass (map f continuous);
}
\definition apply[n: N.Nat^][f: A -> B][continuous: Geometry.Continuous f]: OtherCohomology.Group n -> Group n := (At[n := n].linear f continuous).apply;
\module Cup(p, q: N.Nat^);
\module Unit;
