\import \parent.\parent.Cup[p := p, q := q] \as SourceCup;
\import Other.Cup[p := p, q := q] \as TargetCup;
\import SourceCup.Bilinear[] \as Extensionality;
\import Simplices.Cut[p := p, q := q] \as Cut;
\import OtherSimplices.Cut[p := p, q := q] \as OtherCut;
\definition law: \forall (f: A -> B)(continuous: Geometry.Continuous f)(alpha: Other.Carrier p)(beta: Other.Carrier q) ->
  apply Cut.total f continuous (TargetCup.apply alpha beta) = SourceCup.apply (apply p f continuous alpha) (apply q f continuous beta) :=
  \fun (f: A -> B)(continuous: Geometry.Continuous f)(alpha: Other.Carrier p)(beta: Other.Carrier q) =>
    Extensionality.ext _ _ (\fun (sigma: Simplices.Carrier Cut.total) =>
      trans!{R} _ _ _ (onSimplex Cut.total f continuous (TargetCup.apply alpha beta) sigma)
        (trans!{R} _ _ _ (TargetCup.onSimplex alpha beta (Geometry.postcompose Cut.total f continuous sigma))
          (trans!{R} _ _ _
            (congr2!{R R R} ((baseRing).mul) _ _ _ _
              (sym!{R} _ _ (onSimplex p f continuous alpha (Cut.front sigma)))
              (sym!{R} _ _ (onSimplex q f continuous beta (Cut.back sigma))))
            (sym!{R} _ _ (SourceCup.onSimplex (apply p f continuous alpha) (apply q f continuous beta) sigma)))));
