\definition cochain: Carrier N.Nat^::zero := Ordinary.At[n := N.Nat^::zero].extend (\fun (_: Simplices.Carrier N.Nat^::zero) => #one{baseRing});
\definition onSimplex: \forall (sigma: Simplices.Carrier N.Nat^::zero) -> #apply{cochain} (Chains.generator N.Nat^::zero sigma) = #one{baseRing} :=
  Ordinary.At[n := N.Nat^::zero].onGenerator (\fun (_: Simplices.Carrier N.Nat^::zero) => #one{baseRing});
\definition rightOne: \forall (a: R) -> #mul{baseRing} a (#one{baseRing}) = a :=
  \fun (a: R) => trans!{R} _ _ _ (#mulCommutative{ring} a (#one{baseRing})) (#scalarOne{Modules.scalarModule} a);
\module At(p: N.Nat^);
\module Closed;
\module Left(p: N.Nat^);
