\import Simplices.Cut[p := p, q := q] \as Cut;
\definition total: N.Nat^ := Cut.total;
\definition values(alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier total): R :=
  #mul{baseRing} (#apply{alpha} (Chains.generator p (Cut.front sigma))) (#apply{beta} (Chains.generator q (Cut.back sigma)));
\definition apply(alpha: Carrier p)(beta: Carrier q): Carrier total := Ordinary.At[n := total].extend (values alpha beta);
\definition onSimplex: \forall (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier total) ->
  #apply{(apply alpha beta)} (Chains.generator total sigma) =
    #mul{baseRing} (#apply{alpha} (Chains.generator p (Cut.front sigma))) (#apply{beta} (Chains.generator q (Cut.back sigma))) :=
  \fun (alpha: Carrier p)(beta: Carrier q) => Ordinary.At[n := total].onGenerator (values alpha beta);
\module Bilinear;
