\import chain_complexes.Cochain[].Over[R := R, ring := baseRing] \as Complexes;
\import commutative_algebra.Modules[R := R, ring := ring] \as Commutative;
\definition Group: N.Nat^ -> \Set := Theory.cohomology;
\definition moduleSpace(n: N.Nat^): Modules.Space (Group n) := Theory.cohomologySpace n;
\definition bundle(n: N.Nat^): Modules.Bundle := Modules.Bundle { Carrier := Group n, space := moduleSpace n };
\module Cup(p, q: N.Nat^);
