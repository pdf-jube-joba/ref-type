\definition p: N.Nat^ := (i).first;
\definition q: N.Nat^ := (i).second;
\definition total: N.Nat^ := degree p q;
\definition same: total = n := trans!{N.Nat^} _ _ _ (NatLaws.addComm q p) (Double.degree n i);
\import \root.Cross[A := A, B := B, left := left, right := right].At[p := p, q := q] \as Current;
\import Modules.Tensor[V := Left.Carrier p, W := Right.Carrier q, left := Left.space p, right := Right.space q] \as Term;
\import Term.Universal[U := Target.Carrier total, target := Target.space total] \as Universal;
\definition laws: Term.BilinearLaws[Target.Carrier total, Target.space total, Current.apply] := Term.BilinearLaws[Target.Carrier total, Target.space total, Current.apply] {
  addLeft := (Current.bilinear).addLeft, addRight := (Current.bilinear).addRight,
  scaleLeft := (Current.bilinear).scaleLeft, scaleRight := (Current.bilinear).scaleRight,
};
\definition raw: Modules.Hom[V := Term.Carrier, W := Target.Carrier total, source := Term.space, target := Target.space total].Map := Universal.map Current.apply laws;
\import Modules.Hom[V := Target.Carrier total, W := Target.Carrier n, source := Target.space total, target := Target.space n].Composition[U := Term.Carrier, domain := Term.space] \as After;
\definition map: Modules.Hom[V := Term.Carrier, W := Target.Carrier n, source := Term.space, target := Target.space n].Map := After.compose (Degrees.linear total n same) raw;
\definition onTensor: \forall (x: Left.Carrier p)(y: Right.Carrier q) ->
  (map).apply (Term.tensor x y) = Degrees.apply total n same (Current.apply x y) :=
  \fun (x: Left.Carrier p)(y: Right.Carrier q) => congr!{{Target.Carrier total} {Target.Carrier n}} (Degrees.apply total n same) _ _ (Universal.onTensor Current.apply laws x y);
