\import Chains.Degree[n := n] \as Source;
\import Modules.DirectSum[Index := Double.Index n, family := Source.family].To[W := Target.Carrier n, target := Target.space n] \as Extension;
\module At(i: Double.Index n);
\definition components: Extension.Components := \fun (i: Double.Index n) => At[i := i].map;
\definition map: Modules.Hom[V := Source.Carrier, W := Target.Carrier n, source := Source.space, target := Target.space n].Map := Extension.extension components;
\definition onInjection: \forall (i: Double.Index n)(x: Tensor.Carrier (i).first (i).second) ->
  (map).apply ((Source.Component[i := i].injection).apply x) = (At[i := i].map).apply x := Extension.onInjection components;
