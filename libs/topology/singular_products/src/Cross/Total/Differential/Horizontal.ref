\definition p: N.Nat^ := N.Nat^::succ r;
\definition targetIndex: Double.Index n := Double.index n r (Step.lowerSecond r q);
\import Tensor.Term[p := p, q := q] \as SourceTerm;
\import Tensor.At[p := r, q := q] \as Differential;
\import \root.Cross[A := A, B := B, left := left, right := right].At[p := r, q := q] \as Cross;
\import Lower.At[i := targetIndex] \as Component;
\definition law(x: Left.Carrier p)(y: Right.Carrier q):
  #apply{Lower.map} (#apply{(Step.horizontal p q)} (SourceTerm.tensor x y)) =
    Degrees.apply (degree r q) n Component.same (Cross.apply (#apply{(Left.boundary r)} x) y) :=
  trans!{{Target.Carrier n}} _ _ _
    (Lower.onInjection targetIndex (#apply{Differential.horizontal} (SourceTerm.tensor x y)))
    (trans!{{Target.Carrier n}} _ _ _
      (congr!{{Tensor.Carrier r q} {Target.Carrier n}} (#apply{Component.map}) _ _ (Differential.horizontalOnTensor x y))
      (Component.onTensor (#apply{(Left.boundary r)} x) y));
