\import \parent.Transported[] \as Cases;
\definition law: Statement n i :=
  \idelim pairIndex n #first{i} #second{i} (Double.degree (N.Nat^::succ n) i) = i \with j: Double.Index (N.Nat^::succ n) => Statement n j \by {
    base: Cases.all #first{i} #second{i} n (Double.degree (N.Nat^::succ n) i), equality: Double.pairRebuild i
  };
