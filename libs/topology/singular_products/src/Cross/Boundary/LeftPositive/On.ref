\import \parent.At[q := q] \as Current;
\import Commutative.Bilinear[A := Current.leftBundle, B := Current.rightBundle, C := Current.targetBundle] \as Form;
\import Form.Operations[] \as Operations;
\import Modules.Alternating[V := Current.targetBundle.Carrier, space := Current.targetBundle.space].Concatenation[] \as Signs;
\definition rhs: Form.Map := Operations.plus Current.leftTerm (Operations.sign p (rightTerm q));
\definition Equation: \Prop := Current.lhs = rhs;
\definition expansion[x: Left.Carrier p][y: Right.Carrier q]: (rhs).apply x y =
  (Current.targetBundle.space).add ((Current.leftTerm).apply x y) (Signs.twist p ((rightTerm q).apply x y)) :=
  congr!{Current.targetBundle.Carrier Current.targetBundle.Carrier} ((Current.targetBundle.space).add ((Current.leftTerm).apply x y)) _ _ (Operations.onSign p (rightTerm q) x y);
