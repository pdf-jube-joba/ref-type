\definition q: N.Nat^ := N.Nat^::succ s;
\definition lower: N.Nat^ := degree r q;
\definition other: N.Nat^ := degree p s;
\import N.Basic[].Prop[] \as NatLaws;
\definition same: other = lower := sym!{N.Nat^} _ _ (NatLaws.addSuccLeft s r);
\import \parent.At[q := q] \as Current;
\import \parent.\parent.\parent.At[p := p, q := s] \as Lower;
\import Modules.End[V := Left.Carrier p, space := Left.space p] \as LeftIdentity;
\import Commutative.Bilinear[A := Lower.leftBundle, B := Lower.rightBundle, C := Lower.targetBundle].Precompose[D := Current.leftBundle, E := Current.rightBundle] \as Before;
\import Commutative.Bilinear[A := Current.leftBundle, B := Current.rightBundle, C := Lower.targetBundle].Postcompose[D := Current.targetBundle] \as After;
\definition map: Current.Map := After.apply (Before.apply Lower.bilinear LeftIdentity.identity (Right.boundary s)) (Degrees.linear other lower same);
