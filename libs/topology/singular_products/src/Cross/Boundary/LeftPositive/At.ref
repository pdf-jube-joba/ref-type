\import \parent.\parent.\parent.At[p := p, q := q] \as Full;
\import \parent.\parent.\parent.At[p := r, q := q] \as Lower;
\definition lower: N.Nat^ := degree r q;
\definition leftBundle: Modules.Bundle := Full.leftBundle;
\definition rightBundle: Modules.Bundle := Full.rightBundle;
\definition targetBundle: Modules.Bundle := Lower.targetBundle;
\import Commutative.Bilinear[A := leftBundle, B := rightBundle, C := targetBundle] \as Form;
\definition Map: \Set := Form.Map;
\import Form.Operations[] \as Operations;
\definition zero: Map := Operations.zero;
\import Commutative.Bilinear[A := Full.leftBundle, B := Full.rightBundle, C := Full.targetBundle].Postcompose[D := targetBundle] \as After;
\definition lhs: Map := After.apply Full.bilinear (Target.boundary lower);
\import Modules.End[V := Right.Carrier q, space := Right.space q] \as RightIdentity;
\import Commutative.Bilinear[A := Lower.leftBundle, B := Lower.rightBundle, C := targetBundle].Precompose[D := leftBundle, E := rightBundle] \as Before;
\definition leftTerm: Map := Before.apply Lower.bilinear (Left.boundary r) RightIdentity.identity;
