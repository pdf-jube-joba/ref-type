\definition q: N.Nat^ := N.Nat^::succ s;
\definition lower: N.Nat^ := degree r q;
\import \parent.At[q := q] \as Data;
\import \parent.On[q := q] \as Current;
\import \parent.\parent.\parent.At[p := p, q := q] \as Full;
\definition onGenerators(sigma: LeftSimplices.Carrier p)(tau: RightSimplices.Carrier q):
  #apply{Data.lhs} (Left.generator p sigma) (Right.generator q tau) = #apply{Current.rhs} (Left.generator p sigma) (Right.generator q tau) :=
  trans!{{Target.Carrier lower}} _ _ _
    (congr!{{Target.Carrier (N.Nat^::succ lower)} {Target.Carrier lower}} (#apply{(Target.boundary lower)}) _ _ (Full.onGenerators sigma tau))
    (trans!{{Target.Carrier lower}} _ _ _ (\parent.\parent.\parent.Positive[r := r, s := s, sigma := sigma, tau := tau].law)
      (sym!{{Target.Carrier lower}} _ _ (Current.expansion (Left.generator p sigma) (Right.generator q tau))));
\import Commutative.FreeBilinear[X := LeftSimplices.Carrier p, Y := RightSimplices.Carrier q, C := Data.targetBundle] \as Extension;
\definition equation: Statement q := Extension.ext Data.lhs Current.rhs onGenerators;
