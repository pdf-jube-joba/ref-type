\definition n: N.Nat^ := N.Nat^::zero;
\import \parent.At[p := n, q := n] \as Current;
\import \root.ProductChains[p := n, q := n] \as Geometry;
\import Geometry.Into[A := A, B := B, source := left, target := right] \as Evaluation;
\import Geometry.At[m := n] \as Affine;
\import singular_cohomology.Maps[A := Geometry.Carrier, B := Product.CarrierSet, source := Geometry.topology, target := topology] \as ModelMaps;
\import \root.OrderedShuffle[V := Simplex.Carrier n, W := Simplex.Carrier n] \as Raw;
\import singular_cohomology.OrderedTuples[V := Raw.Pair] \as Tuples;
\import Simplex.Vertices[] \as Vertices;
\definition vertices: Tuples.Tuple (N.Nat^::succ n) := \fun (i: Fin.Fin (N.Nat^::succ n)) => Raw.Pair { left := Vertices.vertex n (Fin.zero n), right := Vertices.vertex n i };
\import singular_cohomology.Simplices[A := Product.CarrierSet, source := topology] \as Simplices;
\import topological_constructions.Product[A := A, B := B].Universal[X := Simplex.Carrier n] \as Universal;
\import Simplex.At[n := n] \as Domain;
\import std.Data[].Pair[] \as Pair;
\definition simplex(sigma: LeftSimplices.Carrier n)(tau: RightSimplices.Carrier n): Simplices.Carrier n :=
  \into[Simplices.At[n := n].Function]((\fun (x: Simplex.Carrier n) => Pair.pair A B (sigma x) (tau x)), Simplices.Carrier n) \by {
    Universal.pairContinuous Domain.topology left right sigma tau (LeftSimplices.At[n := n].continuous sigma) (RightSimplices.At[n := n].continuous tau)
  };
\definition same(sigma: LeftSimplices.Carrier n)(tau: RightSimplices.Carrier n):
  ModelMaps.postcompose n (Evaluation.function sigma tau) (Evaluation.continuous sigma tau) (Affine.onTuple vertices) = simplex sigma tau :=
  \axiom:funext(ModelMaps.postcompose n (Evaluation.function sigma tau) (Evaluation.continuous sigma tau) (Affine.onTuple vertices), simplex sigma tau, \fun (x: Simplex.Carrier n) =>
    congr2!{A B Product.CarrierSet} (Pair.pair A B) _ _ _ _
      (congr!{{Simplex.Carrier n} A} sigma _ _ (trans!{{Simplex.Carrier n}} _ _ _ (Simplex.zeroUnique _) (sym!{{Simplex.Carrier n}} _ _ (Simplex.zeroUnique x))))
      (congr!{{Simplex.Carrier n} B} tau _ _ (trans!{{Simplex.Carrier n}} _ _ _ (Simplex.zeroUnique _) (sym!{{Simplex.Carrier n}} _ _ (Simplex.zeroUnique x)))));
\definition law(sigma: LeftSimplices.Carrier n)(tau: RightSimplices.Carrier n): Current.apply (Left.generator n sigma) (Right.generator n tau) = Target.generator n (simplex sigma tau) :=
  trans!{{Target.Carrier n}} _ _ _ (Current.onGenerators sigma tau)
    (trans!{{Target.Carrier n}} _ _ _ (Evaluation.onGenerator n sigma tau vertices)
      (congr!{{Simplices.Carrier n} {Target.Carrier n}} (Target.generator n) _ _ (same sigma tau)));
