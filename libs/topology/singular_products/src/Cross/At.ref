\import \root.ProductChains[p := p, q := q].Into[A := A, B := B, source := left, target := right] \as Model;
\definition leftBundle: Modules.Bundle := Modules.Bundle { Carrier := Left.Carrier p, space := Left.space p };
\definition rightBundle: Modules.Bundle := Modules.Bundle { Carrier := Right.Carrier q, space := Right.space q };
\definition targetBundle: Modules.Bundle := Modules.Bundle { Carrier := Target.Carrier (degree p q), space := Target.space (degree p q) };
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing].Bilinear[A := leftBundle, B := rightBundle, C := targetBundle] \as Bilinear;
\definition bilinear: Bilinear.Map := Model.bilinear;
\definition apply: Left.Carrier p -> Right.Carrier q -> Target.Carrier (degree p q) := #apply{bilinear};
\definition onGenerators: \forall (sigma: LeftSimplices.Carrier p)(tau: RightSimplices.Carrier q) ->
  apply (Left.generator p sigma) (Right.generator q tau) = Model.onSimplices sigma tau := Model.onGenerators;
