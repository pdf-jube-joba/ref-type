\import Modules.Alternating[V := Right.Carrier s, space := Right.space s].Mapping[W := Target.Carrier lower, target := Target.space lower] \as Mapping;
\definition faces[i: Fin.Fin (N.Nat^::succ q)]: Right.Carrier s := Right.generator s (RightSimplices.face s i tau);
\definition law: (nativeMap).apply ((Right.boundary s).apply (Right.generator q tau)) = common :=
  trans!{{Target.Carrier lower}} _ _ _
    (congr!{{Right.Carrier s} {Target.Carrier lower}} ((nativeMap).apply) _ _ (Right.Boundary[n := s].onGenerator tau))
    (trans!{{Target.Carrier lower}} _ _ _ (Mapping.law nativeMap (N.Nat^::succ q) faces)
      (Sum.congruent (N.Nat^::succ q) (\fun (i: Fin.Fin (N.Nat^::succ q)) => (nativeMap).apply (faces i))
        (\fun (i: Fin.Fin (N.Nat^::succ q)) => LowerInto.onSimplices sigma (RightSimplices.face s i tau)) onNativeFace));
