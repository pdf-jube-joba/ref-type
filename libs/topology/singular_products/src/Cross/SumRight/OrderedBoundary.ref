\import Modules.Alternating[V := RawRight.Carrier q, space := RawRight.space q].Mapping[W := Target.Carrier lower, target := Target.space lower] \as Mapping;
\definition faces(i: Fin.Fin (N.Nat^::succ q)): RawRight.Carrier q := RawRight.generator q (Face.vertices i);
\definition law: #apply{rawMap} (#apply{(RawRight.boundary q)} (RawRight.generator (N.Nat^::succ q) (Vertices.vertex q))) = common :=
  trans!{{Target.Carrier lower}} _ _ _
    (congr!{{RawRight.Carrier q} {Target.Carrier lower}} (#apply{rawMap}) _ _ (RawRight.Boundary[n := q].onGenerator (Vertices.vertex q)))
    (trans!{{Target.Carrier lower}} _ _ _ (Mapping.law rawMap (N.Nat^::succ q) faces)
      (Sum.congruent (N.Nat^::succ q) (\fun (i: Fin.Fin (N.Nat^::succ q)) => #apply{rawMap} (faces i))
        (\fun (i: Fin.Fin (N.Nat^::succ q)) => LowerInto.onSimplices sigma (RightSimplices.face s i tau)) onFace));
