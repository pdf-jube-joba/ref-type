\import Modules.Alternating[V := Left.Carrier r, space := Left.space r].Mapping[W := Target.Carrier lower, target := Target.space lower] \as Mapping;
\definition faces(i: Fin.Fin (N.Nat^::succ p)): Left.Carrier r := Left.generator r (LeftSimplices.face r i sigma);
\definition law: #apply{nativeMap} (#apply{(Left.boundary r)} (Left.generator p sigma)) = common :=
  trans!{{Target.Carrier lower}} _ _ _
    (congr!{{Left.Carrier r} {Target.Carrier lower}} (#apply{nativeMap}) _ _ (Left.Boundary[n := r].onGenerator sigma))
    (trans!{{Target.Carrier lower}} _ _ _ (Mapping.law nativeMap (N.Nat^::succ p) faces)
      (Sum.congruent (N.Nat^::succ p) (\fun (i: Fin.Fin (N.Nat^::succ p)) => #apply{nativeMap} (faces i))
        (\fun (i: Fin.Fin (N.Nat^::succ p)) => LowerInto.onSimplices (LeftSimplices.face r i sigma) tau) onNativeFace));
