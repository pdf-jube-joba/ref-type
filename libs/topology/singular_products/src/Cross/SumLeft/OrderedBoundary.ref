\import Modules.Alternating[V := RawLeft.Carrier p, space := RawLeft.space p].Mapping[W := Target.Carrier lower, target := Target.space lower] \as Mapping;
\definition faces(i: Fin.Fin (N.Nat^::succ p)): RawLeft.Carrier p := RawLeft.generator p (Face.vertices i);
\definition law: #apply{rawMap} (#apply{(RawLeft.boundary p)} (RawLeft.generator (N.Nat^::succ p) (Vertices.vertex p))) = common :=
  trans!{{Target.Carrier lower}} _ _ _
    (congr!{{RawLeft.Carrier p} {Target.Carrier lower}} (#apply{rawMap}) _ _ (RawLeft.Boundary[n := p].onGenerator (Vertices.vertex p)))
    (trans!{{Target.Carrier lower}} _ _ _ (Mapping.law rawMap (N.Nat^::succ p) faces)
      (Sum.congruent (N.Nat^::succ p) (\fun (i: Fin.Fin (N.Nat^::succ p)) => #apply{rawMap} (faces i))
        (\fun (i: Fin.Fin (N.Nat^::succ p)) => LowerInto.onSimplices (LeftSimplices.face r i sigma) tau) onFace));
