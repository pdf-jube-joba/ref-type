\import singular_cohomology.Maps[A := Geometry.Carrier, B := Before.CarrierSet, source := Geometry.topology, target := source] \as GeometryMaps;
\import Complexes.Map[C := Tuples.complex, D := SourceChains.complex].At[n := m] \as SourceLinear;
\import Complexes.Map[C := Tuples.complex, D := TargetChains.complex].At[n := m] \as TargetLinear;
\import Modules.Hom[V := SourceChains.Carrier m, W := TargetChains.Carrier m, source := SourceChains.space m, target := TargetChains.space m].Composition[U := Tuples.Carrier (N.Nat^::succ m), domain := Tuples.space (N.Nat^::succ m)] \as Post;
\import Modules.Hom[V := Tuples.Carrier (N.Nat^::succ m), W := TargetChains.Carrier m, source := Tuples.space (N.Nat^::succ m), target := TargetChains.space m] \as Maps;
\definition first: Maps.Map := Post.compose (ProductMaps.At[n := m].push (function f) (continuous f)) (SourceLinear.linear (SourceEvaluation.evaluation sigma tau));
\definition second: Maps.Map := TargetLinear.linear (TargetEvaluation.evaluation (LeftMaps.postcompose p f.leftFunction f.leftContinuous sigma) (RightMaps.postcompose q f.rightFunction f.rightContinuous tau));
\definition onGenerator(v: Tuples.Tuple (N.Nat^::succ m)): #apply{first} (Tuples.generator (N.Nat^::succ m) v) = #apply{second} (Tuples.generator (N.Nat^::succ m) v) :=
  trans!{{TargetChains.Carrier m}} _ _ _
    (congr!{{SourceChains.Carrier m} {TargetChains.Carrier m}} (#apply{(ProductMaps.At[n := m].push (function f) (continuous f))}) _ _ (SourceEvaluation.onGenerator m sigma tau v))
    (trans!{{TargetChains.Carrier m}} _ _ _
      (ProductMaps.At[n := m].onGenerator (function f) (continuous f)
        (GeometryMaps.postcompose m (SourceEvaluation.function sigma tau) (SourceEvaluation.continuous sigma tau) (Geometry.At[m := m].onTuple v)))
      (sym!{{TargetChains.Carrier m}} _ _ (TargetEvaluation.onGenerator m (LeftMaps.postcompose p f.leftFunction f.leftContinuous sigma) (RightMaps.postcompose q f.rightFunction f.rightContinuous tau) v)));
\import Modules.Free[Generators := Tuples.Tuple (N.Nat^::succ m)].To[W := TargetChains.Carrier m, target := TargetChains.space m] \as Free;
\definition equation: first = second := Free.ext first second onGenerator;
\definition law(x: Tuples.Carrier (N.Nat^::succ m)): #apply{first} x = #apply{second} x := congr!{Maps.Map {TargetChains.Carrier m}} (\fun (h: Maps.Map) => #apply{h} x) _ _ equation;
