\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := Chains.complex] \as Extension;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Integer;
\import Integer.Map[C := Extension.complex, D := Extension.complex] \as MapsZ;
\import Integer.End[C := Extension.complex] \as EndZ;
\definition action[arrow: ChainMaps.Map]: MapsZ.Map := ChainMaps.ZeroExtension[f := arrow].map;
\definition law: Maps.integerPush function continuous = EndZ.identity := trans!{MapsZ.Map} _ _ _
  (congr!{ChainMaps.Map MapsZ.Map} action _ _ chainIdentity) (End.ZeroExtension[].law);
\module Homology(z: I.Int^);
\module With(coefficients: Modules.Bundle);
