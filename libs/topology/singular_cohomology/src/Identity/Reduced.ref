\import Chains.Reduced[] \as Reduced;
\import Maps.Reduced[] \as Push;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Integer;
\import Integer.Map[C := Reduced.complex, D := Reduced.complex] \as Actions;
\import Integer.End[C := Reduced.complex] \as Identity;
\definition nonnegative: \forall (n: N.Nat^)(x: Chains.Carrier n) -> #apply{(Push.map function continuous)} (I.Int^::ofNat n) x = x :=
  \fun (n: N.Nat^)(x: Chains.Carrier n) => congr!{ChainMaps.Map {Chains.Carrier n}} (\fun (f: ChainMaps.Map) => #apply{f} n x) _ _ chainIdentity;
\definition negative: \forall (n: N.Nat^)(x: Reduced.Carrier (I.Int^::negSucc n)) -> #apply{(Push.map function continuous)} (I.Int^::negSucc n) x = x :=
  \induction (n: N.Nat^) \return \forall (x: Reduced.Carrier (I.Int^::negSucc n)) -> #apply{(Push.map function continuous)} (I.Int^::negSucc n) x = x \with {
    | zero: \fun (x: I.Int^) => \refl(x)
    | succ: \fun (n: N.Nat^)(previous: _)(x: Modules.Zero[].Carrier) => Modules.Zero[].unique _ _
  };
\definition law: Push.map function continuous = Identity.identity := Actions.ext _ _
  (\induction (z: I.Int^) \return \forall (x: Reduced.Carrier z) -> #apply{(Push.map function continuous)} z x = x \with {
    | ofNat: nonnegative
    | negSucc: negative
  });
