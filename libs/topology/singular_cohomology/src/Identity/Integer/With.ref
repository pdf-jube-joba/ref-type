\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Integer[P := Extension.complex, N := coefficients] \as Cochains;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Theory;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficients;
\import Hom.IntegerMapping[P := Extension.complex, Q := Extension.complex, N := coefficients, L := coefficients] \as Mapping;
\import Hom.IntegerEnd[P := Extension.complex, N := coefficients] \as Identity;
\import Theory.Map[C := Cochains.complex, D := Cochains.complex] \as CochainMaps;
\definition pullback: CochainMaps.Map := Mapping.On[f := Maps.integerPush function continuous, u := Coefficients.identity].map;
\definition pull(arrow: MapsZ.Map): CochainMaps.Map := Mapping.On[f := arrow, u := Coefficients.identity].map;
\definition identityLaw: pullback = Identity.map := congr!{MapsZ.Map CochainMaps.Map} pull _ _ law;
\module At(z: I.Int^);
