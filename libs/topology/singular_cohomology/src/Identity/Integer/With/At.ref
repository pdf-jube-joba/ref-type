\import Theory.At[C := Cochains.complex, z := z] \as H;
\import CochainMaps.At[k := z] \as Actions;
\import std.Logic[].Proposition[] \as Logic;
\use Equality.sym;
\definition onCohomology: \forall (q: H.Cohomology) -> #apply{(Actions.induced pullback)} q = q :=
  \fun (q: H.Cohomology) => trans!{H.Cohomology} _ _ _
    (congr!{CochainMaps.Map H.Cohomology} (\fun (f: CochainMaps.Map) => #apply{(Actions.induced f)} q) _ _ identityLaw)
    (Identity.At[k := z].onCohomology q);
\definition bijective: Actions.Bijective[pullback] := Actions.Bijective[pullback] {
  injective := \fun (x, y: H.Cohomology)(equal: _) => trans!{H.Cohomology} _ _ _ (sym!{H.Cohomology} _ _ (onCohomology x))
    (trans!{H.Cohomology} _ _ _ equal (onCohomology y)),
  onto := \fun (q: H.Cohomology) => Logic.existsIntro[H.Cohomology, { x: H.Cohomology \where #apply{(Actions.induced pullback)} x = q }] q (onCohomology q),
};
