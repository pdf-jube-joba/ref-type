\import Integer.At[C := Extension.complex, z := z] \as H;
\import MapsZ.At[k := z] \as Actions;
\import std.Logic[].Proposition[] \as Logic;
\use Equality.sym;
\definition onHomology: \forall (q: H.Homology) -> #apply{(Actions.induced (Maps.integerPush function continuous))} q = q :=
  \fun (q: H.Homology) => trans!{H.Homology} _ _ _
    (congr!{MapsZ.Map H.Homology} (\fun (f: MapsZ.Map) => #apply{(Actions.induced f)} q) _ _ law)
    (EndZ.At[k := z].identityOnHomology q);
\definition bijective: Actions.Bijective[Maps.integerPush function continuous] := Actions.Bijective[Maps.integerPush function continuous] {
  injective := \fun (x, y: H.Homology)(equal: _) => trans!{H.Homology} _ _ _ (sym!{H.Homology} _ _ (onHomology x))
    (trans!{H.Homology} _ _ _ equal (onHomology y)),
  onto := \fun (q: H.Homology) => Logic.existsIntro[H.Homology, { x: H.Homology \where #apply{(Actions.induced (Maps.integerPush function continuous))} x = q }] q (onHomology q),
};
