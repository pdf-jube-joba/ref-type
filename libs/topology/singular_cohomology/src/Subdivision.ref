\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import \root.Chains[A := A, source := source] \as Chains;
\import \root.Simplices[A := A, source := source] \as Simplices;
\import algebraic_topology.Simplex[] \as Simplex;
\module At(n: N.Nat^);
\module Successor(n: N.Nat^);
\module Zero;
\definition chainMap: Complexes.Map[C := Chains.complex, D := Chains.complex].Map := Complexes.Map[C := Chains.complex, D := Chains.complex].Map {
  apply := \fun (n: N.Nat^) => #apply{At[n := n].map},
  addition := \fun (n: N.Nat^) => #addition{At[n := n].map},
  scalar := \fun (n: N.Nat^) => #scalar{At[n := n].map},
  commutes := \fun (n: N.Nat^) => Successor[n := n].Differential[].commutes,
};
\import Complexes.Homotopy[C := Chains.complex, D := Chains.complex] \as Native;
\import Complexes.End[C := Chains.complex] \as Identity;
\definition data: Native.Data := Native.Data { apply := \fun (n: N.Nat^) => #apply{At[n := n].homotopyMap} };
\definition homotopy: Native.Homotopy chainMap Identity.identity := \into[Native.Data](data, Native.Homotopy chainMap Identity.identity) \by {
  Native.Laws[chainMap, Identity.identity, data] {
    addition := \fun (n: N.Nat^) => #addition{At[n := n].homotopyMap},
    scalar := \fun (n: N.Nat^) => #scalar{At[n := n].homotopyMap},
    zeroEquation := Zero[].law,
    successorEquation := \fun (n: N.Nat^) => Successor[n := n].Equation[].law,
  }
};
\module Coefficients(M: Modules.Bundle);
\module Natural(B: \Set, target: topology.Topology[Carrier := B].Topology);
\module Iterated;
