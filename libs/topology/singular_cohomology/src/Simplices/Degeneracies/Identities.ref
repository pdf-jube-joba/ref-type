\import \parent.\parent.At[n := N.Nat^::succ (N.Nat^::succ n)] \as UpperSimplices;
\import \parent.\parent.At[n := N.Nat^::succ n] \as MiddleSimplices;
\import Simplex.Degeneracy[n := n].Composition[] \as GeometricComposition;
\import Simplex.Degeneracy[n := n].Mixed[] \as GeometricMixed;
\import N.Basic[].Prop[] \as Bounds;

\definition composition: \forall (i, j: Fin.Fin (N.Nat^::succ n))(sigma: Carrier n) -> Bounds.Le i j ->
  apply (N.Nat^::succ n) (Fin.widen (N.Nat^::succ n) i) (apply n j sigma) = apply (N.Nat^::succ n) (Fin.succ (N.Nat^::succ n) j) (apply n i sigma) :=
  \fun (i, j: Fin.Fin (N.Nat^::succ n))(sigma: Carrier n)(ordered: _) => UpperSimplices.ext
    (apply (N.Nat^::succ n) (Fin.widen (N.Nat^::succ n) i) (apply n j sigma))
    (apply (N.Nat^::succ n) (Fin.succ (N.Nat^::succ n) j) (apply n i sigma))
    (\fun (x: Simplex.Carrier (N.Nat^::succ (N.Nat^::succ n))) => congr!{{Simplex.Carrier n} A} sigma _ _ (GeometricComposition.law i j x ordered));
\definition before: \forall (i, j: Fin.Fin (N.Nat^::succ n))(sigma: Carrier (N.Nat^::succ n)) -> Bounds.Le i j ->
  face (N.Nat^::succ n) (Fin.widen (N.Nat^::succ (N.Nat^::succ n)) (Fin.widen (N.Nat^::succ n) i)) (apply (N.Nat^::succ n) (Fin.succ (N.Nat^::succ n) j) sigma) = apply n j (face n (Fin.widen (N.Nat^::succ n) i) sigma) :=
  \fun (i, j: Fin.Fin (N.Nat^::succ n))(sigma: Carrier (N.Nat^::succ n))(ordered: _) => MiddleSimplices.ext
    (face (N.Nat^::succ n) (Fin.widen (N.Nat^::succ (N.Nat^::succ n)) (Fin.widen (N.Nat^::succ n) i)) (apply (N.Nat^::succ n) (Fin.succ (N.Nat^::succ n) j) sigma))
    (apply n j (face n (Fin.widen (N.Nat^::succ n) i) sigma))
    (\fun (x: Simplex.Carrier (N.Nat^::succ n)) => congr!{{Simplex.Carrier (N.Nat^::succ n)} A} sigma _ _ (GeometricMixed.before i j x ordered));
\definition after: \forall (i, j: Fin.Fin (N.Nat^::succ n))(sigma: Carrier (N.Nat^::succ n)) -> Bounds.Le i j ->
  face (N.Nat^::succ n) (Fin.succ (N.Nat^::succ (N.Nat^::succ n)) (Fin.succ (N.Nat^::succ n) j)) (apply (N.Nat^::succ n) (Fin.widen (N.Nat^::succ n) i) sigma) = apply n i (face n (Fin.succ (N.Nat^::succ n) j) sigma) :=
  \fun (i, j: Fin.Fin (N.Nat^::succ n))(sigma: Carrier (N.Nat^::succ n))(ordered: _) => MiddleSimplices.ext
    (face (N.Nat^::succ n) (Fin.succ (N.Nat^::succ (N.Nat^::succ n)) (Fin.succ (N.Nat^::succ n) j)) (apply (N.Nat^::succ n) (Fin.widen (N.Nat^::succ n) i) sigma))
    (apply n i (face n (Fin.succ (N.Nat^::succ n) j) sigma))
    (\fun (x: Simplex.Carrier (N.Nat^::succ n)) => congr!{{Simplex.Carrier (N.Nat^::succ n)} A} sigma _ _ (GeometricMixed.after i j x ordered));
