\import \parent.\parent.At[n := n] \as Source;
\import \parent.\parent.At[n := N.Nat^::succ n] \as Target;
\import Simplex.At[n := n] \as Domain;
\import Simplex.At[n := N.Nat^::succ n] \as Codomain;
\import Simplex.Degeneracy[n := n] \as Geometric;
\import Geometric.Sections[] \as Sections;
\import topology.Composition[A := Simplex.Carrier (N.Nat^::succ n), B := Simplex.Carrier n, C := A] \as Composition;
\definition apply(i: Fin.Fin (N.Nat^::succ n))(sigma: Carrier n): Carrier (N.Nat^::succ n) :=
  \into[Target.Function]((\fun (x: Simplex.Carrier (N.Nat^::succ n)) => sigma (Geometric.apply i x)), Target.Carrier) \by {
    Composition.composeContinuous Codomain.topology Domain.topology source (Geometric.apply i) sigma (Geometric.continuous i) (Source.continuous sigma)
  };
\definition first: \forall (i: Fin.Fin (N.Nat^::succ n))(sigma: Carrier n) -> face n (Fin.widen (N.Nat^::succ n) i) (apply i sigma) = sigma :=
  \fun (i: Fin.Fin (N.Nat^::succ n))(sigma: Carrier n) => Source.ext (face n (Fin.widen (N.Nat^::succ n) i) (apply i sigma)) sigma
    (\fun (x: Simplex.Carrier n) => congr!{{Simplex.Carrier n} A} sigma _ _ (Sections.first i x));
\definition second: \forall (i: Fin.Fin (N.Nat^::succ n))(sigma: Carrier n) -> face n (Fin.succ (N.Nat^::succ n) i) (apply i sigma) = sigma :=
  \fun (i: Fin.Fin (N.Nat^::succ n))(sigma: Carrier n) => Source.ext (face n (Fin.succ (N.Nat^::succ n) i) (apply i sigma)) sigma
    (\fun (x: Simplex.Carrier n) => congr!{{Simplex.Carrier n} A} sigma _ _ (Sections.second i x));
