\module At(n: N.Nat^);
\definition apply(n: N.Nat^): Fin.Fin (N.Nat^::succ n) -> Carrier n -> Carrier (N.Nat^::succ n) := At[n := n].apply;
\definition first: \forall (n: N.Nat^)(i: Fin.Fin (N.Nat^::succ n))(sigma: Carrier n) -> face n (Fin.widen (N.Nat^::succ n) i) (apply n i sigma) = sigma :=
  \fun (n: N.Nat^) => At[n := n].first;
\definition second: \forall (n: N.Nat^)(i: Fin.Fin (N.Nat^::succ n))(sigma: Carrier n) -> face n (Fin.succ (N.Nat^::succ n) i) (apply n i sigma) = sigma :=
  \fun (n: N.Nat^) => At[n := n].second;
