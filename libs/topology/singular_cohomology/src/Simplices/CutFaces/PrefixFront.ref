\import \parent.\parent.Reindex[m := total, n := higher].Composition[k := p] \as NativeComposition;
\import \parent.\parent.Reindex[m := N.Nat^::succ p, n := leftDegree].Composition[k := p] \as FirstComposition;
\import \parent.\parent.Reindex[m := leftDegree, n := higher].Composition[k := p] \as SecondComposition;
\import \parent.\parent.Reindex[m := p, n := higher] \as Direct;
\definition leftIndices(i: Fin.Fin (N.Nat^::succ p))(j: Fin.Fin (N.Nat^::succ p)): Fin.Fin (N.Nat^::succ higher) := NativeFace.skip (prefix i) (CutIndices.frontIndex j);
\definition rightIndices(i: Fin.Fin (N.Nat^::succ p))(j: Fin.Fin (N.Nat^::succ p)): Fin.Fin (N.Nat^::succ higher) :=
  Between.indices same (LeftIndices.frontIndex (LeftFace.skip (Fin.widen (N.Nat^::succ p) i) j));
\definition indices: \forall (i: Fin.Fin (N.Nat^::succ p)) -> leftIndices i = rightIndices i :=
  \fun (i: Fin.Fin (N.Nat^::succ p)) => \axiom:funext(leftIndices i, rightIndices i, \fun (j: Fin.Fin (N.Nat^::succ p)) => trans!{N.Nat^} _ _ _
    (NativeFace.value (prefix i) (CutIndices.frontIndex j))
    (trans!{N.Nat^} _ _ _ (congr2!{N.Nat^ N.Nat^ N.Nat^} Positions.position _ _ _ _ (prefixValue i) (\refl(j)))
      (sym!{N.Nat^} _ _ (trans!{N.Nat^} _ _ _
        (Between.value same (LeftIndices.frontIndex (LeftFace.skip (Fin.widen (N.Nat^::succ p) i) j)))
        (LeftFace.value (Fin.widen (N.Nat^::succ p) i) j)))));
\definition leftFlat: \forall (i: Fin.Fin (N.Nat^::succ p))(sigma: Carrier higher) -> Cut.front (face total (prefix i) sigma) = Direct.apply (leftIndices i) sigma :=
  \fun (i: Fin.Fin (N.Nat^::succ p))(sigma: Carrier higher) => trans!{{Carrier p}} _ _ _
    (congr!{{Carrier total} {Carrier p}} Cut.front _ _ (NativeFace.law (prefix i) sigma))
    (NativeComposition.law (NativeFace.skip (prefix i)) CutIndices.frontIndex sigma);
\definition rightFlat: \forall (i: Fin.Fin (N.Nat^::succ p))(sigma: Carrier higher) ->
  face p (Fin.widen (N.Nat^::succ p) i) (Left.front (leftSimplex sigma)) = Direct.apply (rightIndices i) sigma :=
  \fun (i: Fin.Fin (N.Nat^::succ p))(sigma: Carrier higher) => trans!{{Carrier p}} _ _ _
    (LeftFace.law (Fin.widen (N.Nat^::succ p) i) (Left.front (leftSimplex sigma)))
    (trans!{{Carrier p}} _ _ _ (FirstComposition.law LeftIndices.frontIndex (LeftFace.skip (Fin.widen (N.Nat^::succ p) i)) (leftSimplex sigma))
      (SecondComposition.law (Between.indices same) (\fun (j: Fin.Fin (N.Nat^::succ p)) => LeftIndices.frontIndex (LeftFace.skip (Fin.widen (N.Nat^::succ p) i) j)) sigma));
\definition law: \forall (i: Fin.Fin (N.Nat^::succ p))(sigma: Carrier higher) ->
  Cut.front (face total (prefix i) sigma) = face p (Fin.widen (N.Nat^::succ p) i) (Left.front (leftSimplex sigma)) :=
  \fun (i: Fin.Fin (N.Nat^::succ p))(sigma: Carrier higher) => trans!{{Carrier p}} _ _ _ (leftFlat i sigma)
    (trans!{{Carrier p}} _ _ _ (congr!{Direct.Function {Carrier p}} (\fun (f: Direct.Function) => Direct.apply f sigma) (leftIndices i) (rightIndices i) (indices i))
      (sym!{{Carrier p}} _ _ (rightFlat i sigma)));
