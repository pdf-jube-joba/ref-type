\import \parent.Reindex[m := n, n := n] \as Restriction;
\import \parent.At[n := n] \as Simplices;
\import Simplex.ReindexIdentity[n := n] \as Geometry;
\definition law: \forall (sigma: Carrier n) -> Restriction.apply Geometry.identity sigma = sigma :=
  \fun (sigma: Carrier n) => Simplices.ext (Restriction.apply Geometry.identity sigma) sigma
    (\fun (x: Simplex.Carrier n) => congr!{{Simplex.Carrier n} A} sigma _ _ (Geometry.law x));
