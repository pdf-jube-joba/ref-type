\import Simplex.ReindexFace[n := n] \as Geometry;
\import \parent.Reindex[m := n, n := N.Nat^::succ n] \as Restriction;
\import Simplex.Reindex[m := n, n := N.Nat^::succ n] \as Affine;
\definition skip: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)) -> Restriction.Function := Geometry.skip;
\definition law: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(sigma: Carrier (N.Nat^::succ n)) -> face n i sigma = Restriction.apply (skip i) sigma :=
  \fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(sigma: Carrier (N.Nat^::succ n)) => ext n (face n i sigma) (Restriction.apply (skip i) sigma)
    (\fun (x: Simplex.Carrier n) => congr!{{Simplex.Carrier (N.Nat^::succ n)} A} sigma (Simplex.face n i x) (Affine.apply (skip i) x) (Geometry.law i x));
\import N.Basic[].Prop[] \as Order;
\import Fin.Skipping[].Before[] \as Before;
\import Fin.Skipping[].After[] \as After;
\definition before: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(j: Fin.Fin (N.Nat^::succ n)) -> Order.Lt j i ->
  Fin.value (N.Nat^::succ (N.Nat^::succ n)) (skip i j) = Fin.value (N.Nat^::succ n) j := Before.law (N.Nat^::succ n);
\definition after: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(j: Fin.Fin (N.Nat^::succ n)) -> Order.Le i j ->
  Fin.value (N.Nat^::succ (N.Nat^::succ n)) (skip i j) = N.Nat^::succ (Fin.value (N.Nat^::succ n) j) := After.law (N.Nat^::succ n);
\import Fin.Skipping[].Values[] \as Values;
\definition value: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(j: Fin.Fin (N.Nat^::succ n)) ->
  Fin.value (N.Nat^::succ (N.Nat^::succ n)) (skip i j) = Values.position i j := Values.law (N.Nat^::succ n);
