\import Simplex.Cut[p := p, q := q] \as Geometry;
\import \parent.Reindex[m := p, n := Geometry.total] \as Front;
\import \parent.Reindex[m := q, n := Geometry.total] \as Back;
\import Simplex.Vertices[] \as Vertices;
\definition total: N.Nat^ := Geometry.total;
\definition front[sigma: Carrier total]: Carrier p := Front.apply Geometry.frontIndex sigma;
\definition back[sigma: Carrier total]: Carrier q := Back.apply Geometry.backIndex sigma;
\definition frontOnVertex: \forall (sigma: Carrier total)(i: Fin.Fin (N.Nat^::succ p)) ->
  front sigma (Vertices.vertex p i) = sigma (Vertices.vertex total (Geometry.frontIndex i)) := Front.onVertex Geometry.frontIndex;
\definition backOnVertex: \forall (sigma: Carrier total)(i: Fin.Fin (N.Nat^::succ q)) ->
  back sigma (Vertices.vertex q i) = sigma (Vertices.vertex total (Geometry.backIndex i)) := Back.onVertex Geometry.backIndex;
\definition overlap: \forall (sigma: Carrier total) -> front sigma (Vertices.vertex p Geometry.pivot) = back sigma (Vertices.vertex q (Fin.zero q)) :=
  \fun (sigma: Carrier total) => congr!{{Simplex.Carrier total} A} sigma _ _ Geometry.commonVertex;
