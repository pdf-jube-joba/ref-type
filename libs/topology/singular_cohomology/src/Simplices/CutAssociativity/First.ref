\import \parent.\parent.Reindex[m := pq, n := leftDegree].Composition[k := p] \as LeftComposition;
\import \parent.\parent.Reindex[m := rightDegree, n := leftDegree].Composition[k := p] \as RightComposition;
\import \parent.\parent.Reindex[m := p, n := leftDegree] \as Direct;
\definition leftIndices[i: Fin.Fin (N.Nat^::succ p)]: Fin.Fin (N.Nat^::succ leftDegree) := LeftIndices.frontIndex (PQIndices.frontIndex i);
\definition rightIndices[i: Fin.Fin (N.Nat^::succ p)]: Fin.Fin (N.Nat^::succ leftDegree) := Between.indices same (RightIndices.frontIndex i);
\definition indices: leftIndices = rightIndices := \axiom:funext(leftIndices, rightIndices,
  \fun (i: Fin.Fin (N.Nat^::succ p)) => sym!{N.Nat^} _ _ (Between.value same (RightIndices.frontIndex i)));
\definition law: \forall (sigma: Carrier leftDegree) -> PQ.front (Left.front sigma) = Right.front (rightSimplex sigma) :=
  \fun (sigma: Carrier leftDegree) => trans!{{Carrier p}} _ _ _
    (LeftComposition.law LeftIndices.frontIndex PQIndices.frontIndex sigma)
    (trans!{{Carrier p}} _ _ _
      (congr!{Direct.Function {Carrier p}} (\fun (f: Direct.Function) => Direct.apply f sigma) leftIndices rightIndices indices)
      (sym!{{Carrier p}} _ _ (RightComposition.law (Between.indices same) RightIndices.frontIndex sigma)));
