\import \parent.\parent.Reindex[m := qr, n := rightDegree].Composition[k := r] \as FirstComposition;
\import \parent.\parent.Reindex[m := rightDegree, n := leftDegree].Composition[k := r] \as SecondComposition;
\import \parent.\parent.Reindex[m := r, n := leftDegree] \as Direct;
\definition rightIndices(i: Fin.Fin (N.Nat^::succ r)): Fin.Fin (N.Nat^::succ leftDegree) := Between.indices same (RightIndices.backIndex (QRIndices.backIndex i));
\definition indices: LeftIndices.backIndex = rightIndices := \axiom:funext(LeftIndices.backIndex, rightIndices,
  \fun (i: Fin.Fin (N.Nat^::succ r)) => trans!{N.Nat^} _ _ _ (Arithmetic.addAssoc p q i)
    (sym!{N.Nat^} _ _ (Between.value same (RightIndices.backIndex (QRIndices.backIndex i)))));
\definition rightFlat: \forall (sigma: Carrier leftDegree) -> QR.back (Right.back (rightSimplex sigma)) = Direct.apply rightIndices sigma :=
  \fun (sigma: Carrier leftDegree) => trans!{{Carrier r}} _ _ _
    (FirstComposition.law RightIndices.backIndex QRIndices.backIndex (rightSimplex sigma))
    (SecondComposition.law (Between.indices same) (\fun (i: Fin.Fin (N.Nat^::succ r)) => RightIndices.backIndex (QRIndices.backIndex i)) sigma);
\definition law: \forall (sigma: Carrier leftDegree) -> Left.back sigma = QR.back (Right.back (rightSimplex sigma)) :=
  \fun (sigma: Carrier leftDegree) => trans!{{Carrier r}} _ _ _
    (congr!{Direct.Function {Carrier r}} (\fun (f: Direct.Function) => Direct.apply f sigma) LeftIndices.backIndex rightIndices indices)
    (sym!{{Carrier r}} _ _ (rightFlat sigma));
