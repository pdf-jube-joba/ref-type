\import \parent.At[n := m] \as Lower;
\import \parent.At[n := n] \as Higher;
\import Simplex.At[n := m] \as Domain;
\import Simplex.At[n := n] \as Codomain;
\import Simplex.Reindex[m := m, n := n] \as Geometry;
\import Simplex.Vertices[] \as Vertices;
\import topology.Composition[A := Simplex.Carrier m, B := Simplex.Carrier n, C := A] \as Composition;
\definition Function: \Set := Geometry.Function;
\definition apply[f: Function][sigma: Carrier n]: Carrier m :=
  \into[Lower.Function]((\fun (x: Simplex.Carrier m) => sigma (Geometry.apply f x)), Lower.Carrier) \by {
    Composition.composeContinuous Domain.topology Codomain.topology source (Geometry.apply f) sigma
      (Geometry.continuous f) (Higher.continuous sigma)
  };
\definition onVertex: \forall (f: Function)(sigma: Carrier n)(i: Fin.Fin (N.Nat^::succ m)) ->
  apply f sigma (Vertices.vertex m i) = sigma (Vertices.vertex n (f i)) :=
  \fun (f: Function)(sigma: Carrier n)(i: Fin.Fin (N.Nat^::succ m)) =>
    congr!{{Simplex.Carrier n} A} sigma _ _ (Geometry.onVertex f i);
\module Composition(k: N.Nat^);
