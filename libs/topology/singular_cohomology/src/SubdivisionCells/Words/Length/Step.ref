\import \parent.\parent.Fixed[r := r] \as Lower;
\import \parent.\parent.Fixed[r := N.Nat^::succ r] \as Higher;
\import Free.Subset[S := Lower.Words].Into[W := Carrier, target := space] \as ExtendWords;
\import Modules.Free[Generators := Cells.Cell n].Induction[].Into[W := Carrier, target := space] \as ExtendCells;
\definition cells: \forall (word: \Cast[Word] Lower.Words) -> Higher.Member (#apply{(lift word)} (chain n)) :=
  \fun (word: \Cast[Word] Lower.Words) => ExtendCells.law (lift word) Higher.submodule
    (\fun (c: Cells.Cell n) => transport!{Carrier} (\fun (x: Carrier) => Higher.Member x) _ _ (sym!{Carrier} _ _ (liftOnGenerator word c))
      (Higher.onGenerator (Lists.List[Cells.Cell n]::cons c word)
        (congr!{N.Nat^ N.Nat^} N.Nat^::succ _ _ (\bysub(Word, Lower.Words, word))))) (chain n);
\definition generators: \forall (word: \Cast[Word] Lower.Words) -> Higher.Member (#apply{step} (generator word)) :=
  \fun (word: \Cast[Word] Lower.Words) => transport!{Carrier} (\fun (x: Carrier) => Higher.Member x) _ _ (sym!{Carrier} _ _ (stepOnGenerator word)) (cells word);
\definition law: \forall (x: Carrier) -> Lower.Member x -> Higher.Member (#apply{step} x) := ExtendWords.law step Higher.submodule generators;
