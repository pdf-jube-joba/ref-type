\import Cells.At[n := n].Iterated[k := k] \as Iteration;
\import Simplex.Affine[m := n, n := k] \as Affine;
\import \root.OrderedTuples[V := Simplex.Carrier k] \as Tuples;
\import Free.To[W := Tuples.Carrier (N.Nat^::succ n), target := Tuples.space (N.Nat^::succ n)] \as Extend;
\definition map[v: Affine.Vertices]: Modules.Hom[V := Carrier, W := Tuples.Carrier (N.Nat^::succ n), source := space, target := Tuples.space (N.Nat^::succ n)].Map :=
  Extend.extension (\fun (word: Word) => Tuples.generator (N.Nat^::succ n) (Iteration.vertices v word));
\definition onGenerator: \forall (v: Affine.Vertices)(word: Word) -> (map v).apply (generator word) = Tuples.generator (N.Nat^::succ n) (Iteration.vertices v word) :=
  \fun (v: Affine.Vertices) => Extend.onGenerator (\fun (word: Word) => Tuples.generator (N.Nat^::succ n) (Iteration.vertices v word));
\module Comparison;
