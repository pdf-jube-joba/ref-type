\definition Words: \Pow Word := { word: Word \where length word = r };
\import Free.Subset[S := Words] \as Selected;
\import Modules.Of[V := Carrier, space := space].Submodule[] \as Submodules;
\definition submodule: Submodules.Submodule := Selected.submodule;
\definition Member(x: Carrier): \Prop := Submodules.Member submodule x;
\definition onGenerator: \forall (word: Word) -> length word = r -> Member (generator word) := Selected.generatorMember;
