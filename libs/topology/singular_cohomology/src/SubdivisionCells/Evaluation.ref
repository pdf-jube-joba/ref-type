\import Simplex.Affine[m := n, n := k] \as Affine;
\import \root.OrderedTuples[V := Simplex.Carrier k] \as Tuples;
\definition tuple(v: Affine.Vertices)(c: Cells.Cell n): Tuples.Tuple (N.Nat^::succ n) := \fun (i: Fin.Fin (N.Nat^::succ n)) => Affine.apply v (Cells.vertices n c i);
\import Modules.Free[Generators := Cells.Cell n].To[W := Tuples.Carrier (N.Nat^::succ n), target := Tuples.space (N.Nat^::succ n)] \as Free;
\definition map(v: Affine.Vertices): Modules.Hom[V := Carrier n, W := Tuples.Carrier (N.Nat^::succ n), source := space n, target := Tuples.space (N.Nat^::succ n)].Map :=
  Free.extension (\fun (c: Cells.Cell n) => Tuples.generator (N.Nat^::succ n) (tuple v c));
\definition onGenerator: \forall (v: Affine.Vertices)(c: Cells.Cell n) -> #apply{(map v)} (generator n c) = Tuples.generator (N.Nat^::succ n) (tuple v c) :=
  \fun (v: Affine.Vertices) => Free.onGenerator (\fun (c: Cells.Cell n) => Tuples.generator (N.Nat^::succ n) (tuple v c));
