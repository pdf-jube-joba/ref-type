\import \parent.At[n := n, k := k] \as Lower;
\import \parent.At[n := N.Nat^::succ n, k := k] \as Higher;
\import \parent.\parent.Evaluation[n := n, k := k] \as LowerEvaluation;
\import \parent.\parent.Evaluation[n := N.Nat^::succ n, k := k] \as HigherEvaluation;
\import \parent.\parent.Step[n := n] \as CellChains;
\import Cells.Step[n := n] \as CellsStep;
\import Simplex.Affine[m := N.Nat^::succ n, n := k] \as Affine;
\import Simplex.Affine[m := n, n := k] \as LowerAffine;
\import Simplex.AffineFaces[m := n, n := k] \as Faces;
\import \root.SimplexChains[n := k] \as Geometry;
\import \root.OrderedTuples[V := Simplex.Carrier k] \as Tuples;
\import Tuples.Subdivision[centres := Geometry.centres] \as Subdivision;
\import Fin.Tuples[A := Simplex.Carrier k] \as VertexTuples;
\import VertexTuples.Omission[] \as Omission;
\module Face(v: Affine.Vertices, i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)));
\module Expanded(v: Affine.Vertices);
\definition law: Property n -> \forall (v: Affine.Vertices) -> Higher.Equation v := \fun (previous: Property n)(v: Affine.Vertices) => Expanded[v := v].law previous;
