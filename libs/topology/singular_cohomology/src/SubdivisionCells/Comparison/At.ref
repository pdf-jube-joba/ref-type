\import Simplex.Affine[m := n, n := k] \as Affine;
\import \root.SimplexChains[n := k] \as Geometry;
\import \root.OrderedTuples[V := Simplex.Carrier k] \as Tuples;
\import Tuples.Subdivision[centres := Geometry.centres] \as Subdivision;
\import \parent.\parent.Evaluation[n := n, k := k] \as Evaluation;
\definition Equation(v: Affine.Vertices): \Prop := #apply{(Evaluation.map v)} (chain n) = #apply{(Subdivision.map (N.Nat^::succ n))} (Tuples.generator (N.Nat^::succ n) v);
