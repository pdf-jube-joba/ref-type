\import \parent.Degree[n := n] \as Lower;
\import \parent.Degree[n := N.Nat^::succ n] \as Higher;
\import \parent.Compared[n := n] \as LowerCompared;
\import \parent.Compared[n := N.Nat^::succ n] \as HigherCompared;
\import \parent.CandidateBoundary[n := n] \as Candidate;
\import Small.At[n := n] \as SmallLower;
\definition law: \forall (x: Whole.Carrier (N.Nat^::succ n)) -> #apply{Small.complex.differential} n (#apply{Higher.retraction} x) = #apply{Lower.retraction} (#apply{(Whole.boundary n)} x) :=
  \fun (x: Whole.Carrier (N.Nat^::succ n)) => SmallLower.injective _ _
    (trans!{{Whole.Carrier n}} _ _ _ (sym!{{Whole.Carrier n}} _ _ (#commutes{Small.inclusion} n (#apply{Higher.retraction} x)))
      (trans!{{Whole.Carrier n}} _ _ _ (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier n}} (#apply{(Whole.boundary n)}) _ _ (HigherCompared.included x))
        (trans!{{Whole.Carrier n}} _ _ _ (Candidate.law x) (sym!{{Whole.Carrier n}} _ _ (LowerCompared.included (#apply{(Whole.boundary n)} x))))));
