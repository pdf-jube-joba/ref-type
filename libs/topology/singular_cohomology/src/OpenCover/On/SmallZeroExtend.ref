\import Small.At[n := n] \as Degree;
\import Small.Simplices[] \as SmallSimplices;
\import Modules.Hom[V := Whole.Carrier n, W := Whole.Carrier (N.Nat^::succ n), source := Whole.space n, target := Whole.space (N.Nat^::succ n)].Composition[U := Small.Carrier n, domain := Small.space n] \as Composition;
\import Modules.Hom[V := Small.Carrier n, W := Whole.Carrier (N.Nat^::succ n), source := Small.space n, target := Whole.space (N.Nat^::succ n)] \as Linear;
\import Modules.Free[Generators := SmallSimplices.Carrier n].To[W := Whole.Carrier (N.Nat^::succ n), target := Whole.space (N.Nat^::succ n)] \as Free;
\definition Basis: \Prop := \forall (sigma: SmallSimplices.Carrier n) -> #apply{(homotopyMap n)} (Whole.generator n sigma) = #zero{(Whole.space (N.Nat^::succ n))};
\definition equation: Basis -> Composition.compose (homotopyMap n) Degree.inclusion = Linear.zeroMap :=
  \fun (basis: Basis) => Free.ext _ _ (\fun (sigma: SmallSimplices.Carrier n) => trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{Whole.Carrier n} {Whole.Carrier (N.Nat^::succ n)}} (#apply{(homotopyMap n)}) _ _ (Degree.onGenerator sigma)) (basis sigma));
\definition law: Basis -> SmallZeroProperty n := \fun (basis: Basis)(x: Small.Carrier n) =>
  congr!{Linear.Map {Whole.Carrier (N.Nat^::succ n)}} (\fun (f: Linear.Map) => #apply{f} x) _ _ (equation basis);
