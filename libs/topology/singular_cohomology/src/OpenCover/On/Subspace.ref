\import topology.Topology[Carrier := A].Subspace[S := subset] \as Space;
\definition Carrier: \Set := Space.CarrierSet;
\definition inclusion[x: Carrier]: A := x;
\import topology.Continuity[A := Carrier, B := A].Corestriction[S := subset] \as Into;
\import \root.Maps[A := Carrier, B := A, source := Space.topology source, target := source] \as WholeMaps;
\definition continuous: WholeMaps.Continuous inclusion := Into.inclusionContinuous source;
\import Small.Pullback[B := Carrier].Over[topology := Space.topology source, f := inclusion] \as Pullback;
\import topology.Topology[Carrier := Carrier].OpenCovers[topology := Space.topology source] \as SubspaceCovers;
\import topology.Continuity[A := Carrier, B := A].Covers[] \as CoverPullback;
\definition restrictedCover: SubspaceCovers.Cover := \into[\Pow (\Pow Carrier)](Pullback.pullbackFamily, SubspaceCovers.Families) \by {
  CoverPullback.pullback (Space.topology source) source inclusion continuous (Covers.family cover) (Covers.laws cover)
};
\import \root.Small[A := Carrier, source := Space.topology source, family := SubspaceCovers.family restrictedCover] \as SubspaceSmall;
\import \root.OpenCover[A := Carrier, source := Space.topology source].On[cover := restrictedCover] \as SubspaceComparison;
\definition map: Complexes.Map[C := SubspaceSmall.complex, D := Small.complex].Map := Pullback.push continuous;
\module Degree(n: N.Nat^);
\import Complexes.SplitInjection[C := SubspaceSmall.complex, D := Small.complex] \as Pairs;
\definition pairData: Pairs.Data := Pairs.Data { inclusion := map, retraction := \fun (n: N.Nat^) => Degree[n := n].retraction };
\definition pair: Pairs.SplitInjection := \into[Pairs.Data](pairData, Pairs.SplitInjection) \by {
  Pairs.Laws[pairData] { leftInverse := \fun (n: N.Nat^) => Degree[n := n].leftInverse }
};
\module Relative;
