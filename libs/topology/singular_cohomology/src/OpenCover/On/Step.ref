\import \parent.Terms[n := n] \as Lower;
\import \parent.Terms[n := N.Nat^::succ n] \as Higher;
\import \parent.Selection[n := N.Nat^::succ n] \as Selection;
\import Subdivision.Iterated[].At[n := N.Nat^::succ n] \as Powers;
\import Modules.Laws[V := Whole.Carrier (N.Nat^::succ n), space := Whole.space (N.Nat^::succ n)] \as Values;
\definition residual[previous: Lower.Map][sigma: Simplices.Carrier (N.Nat^::succ n)]: Whole.Carrier (N.Nat^::succ n) :=
  Values.add (Whole.generator (N.Nat^::succ n) sigma) ((previous).apply ((Whole.boundary n).apply (Whole.generator (N.Nat^::succ n) sigma)));
\definition value[previous: Lower.Map][sigma: Simplices.Carrier (N.Nat^::succ n)]: Whole.Carrier (N.Nat^::succ (N.Nat^::succ n)) :=
  (Powers.homotopyMap (Selection.minimum (residual previous sigma))).apply (residual previous sigma);
\import Modules.Free[Generators := Simplices.Carrier (N.Nat^::succ n)].To[W := Whole.Carrier (N.Nat^::succ (N.Nat^::succ n)), target := Whole.space (N.Nat^::succ (N.Nat^::succ n))] \as Free;
\definition map[previous: Lower.Map]: Higher.Map := Free.extension (value previous);
\definition onGenerator: \forall (previous: Lower.Map)(sigma: Simplices.Carrier (N.Nat^::succ n)) -> (map previous).apply (Whole.generator (N.Nat^::succ n) sigma) = value previous sigma :=
  \fun (previous: Lower.Map) => Free.onGenerator (value previous);
