\import \parent.Arithmetic[n := N.Nat^::zero] \as Arithmetic;
\import \parent.\parent.Compared[n := N.Nat^::zero] \as Compared;
\import \parent.\parent.Degree[n := N.Nat^::zero] \as Degree;
\import Small.At[n := N.Nat^::zero] \as SmallDegree;
\import Modules.Laws[V := Whole.Carrier N.Nat^::zero, space := Whole.space N.Nat^::zero] \as Values;
\import algebra.Group[].Of[Carrier := Whole.Carrier N.Nat^::zero, group := Values.additive] \as Group;
\definition law: \forall (x: Whole.Carrier N.Nat^::zero) -> Group.difference (#apply{SmallDegree.inclusion} (#apply{Degree.retraction} x)) x = #apply{(Whole.boundary N.Nat^::zero)} (#apply{(homotopyMap N.Nat^::zero)} x) :=
  \fun (x: Whole.Carrier N.Nat^::zero) => trans!{{Whole.Carrier N.Nat^::zero}} _ _ _
    (congr!{{Whole.Carrier N.Nat^::zero} {Whole.Carrier N.Nat^::zero}} (\fun (y: Whole.Carrier N.Nat^::zero) => Group.difference y x) _ _ (Compared.included x))
    (Arithmetic.differenceSum x (#apply{(Whole.boundary N.Nat^::zero)} (#apply{(homotopyMap N.Nat^::zero)} x)));
