\import \parent.Arithmetic[n := N.Nat^::succ n] \as Arithmetic;
\import \parent.\parent.Compared[n := N.Nat^::succ n] \as Compared;
\import \parent.\parent.Degree[n := N.Nat^::succ n] \as Degree;
\import Small.At[n := N.Nat^::succ n] \as SmallDegree;
\import Modules.Laws[V := Whole.Carrier (N.Nat^::succ n), space := Whole.space (N.Nat^::succ n)] \as Values;
\import algebra.Group[].Of[Carrier := Whole.Carrier (N.Nat^::succ n), group := Values.additive] \as Group;
\definition law: \forall (x: Whole.Carrier (N.Nat^::succ n)) -> Group.difference (#apply{SmallDegree.inclusion} (#apply{Degree.retraction} x)) x =
  Values.add (#apply{(Whole.boundary (N.Nat^::succ n))} (#apply{(homotopyMap (N.Nat^::succ n))} x)) (#apply{(homotopyMap n)} (#apply{(Whole.boundary n)} x)) :=
  \fun (x: Whole.Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)}} (\fun (y: Whole.Carrier (N.Nat^::succ n)) => Group.difference y x) _ _ (Compared.included x))
    (Arithmetic.differenceSum x (Values.add (#apply{(Whole.boundary (N.Nat^::succ n))} (#apply{(homotopyMap (N.Nat^::succ n))} x)) (#apply{(homotopyMap n)} (#apply{(Whole.boundary n)} x))));
