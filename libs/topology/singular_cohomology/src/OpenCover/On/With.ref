\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.On[P := Whole.complex, N := coefficients] \as WholeCochains;
\import Hom.On[P := Small.complex, N := coefficients] \as SmallCochains;
\import Hom.Equivalence[P := Small.complex, Q := Whole.complex, N := coefficients] \as Comparison;
\import Small.With[coefficients := coefficients] \as Restriction;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\definition restriction: Cochains.Map[C := WholeCochains.complex, D := SmallCochains.complex].Map := Restriction.restriction;
\import Comparison.Native[e := equivalence] \as Lift;
\definition extension: Cochains.Map[C := SmallCochains.complex, D := WholeCochains.complex].Map := Lift.forward;
\module Homotopies;
\module At(n: N.Nat^);
