\module At(n: N.Nat^);
\module Positive(n: N.Nat^);
\definition law: \forall (n: N.Nat^) -> At[n := n].Statement := \induction (n: N.Nat^) \return At[n := n].Statement \with {
  | zero: \fun (x: Whole.Carrier (N.Nat^::succ N.Nat^::zero)) => \refl(#apply{(candidateMap N.Nat^::zero)} (#apply{(Whole.boundary N.Nat^::zero)} x))
  | succ: \fun (n: N.Nat^)(previous: At[n := n].Statement) => Positive[n := n].law
};
