\import \parent.Degree[n := n] \as Degree;
\import \parent.CandidateSmall[] \as Candidate;
\import Small.At[n := n] \as SmallDegree;
\definition law: \forall (x: Small.Carrier n) -> (Degree.retraction).apply ((SmallDegree.inclusion).apply x) = x :=
  \fun (x: Small.Carrier n) => trans!{{Small.Carrier n}} _ _ _ (congr!{{Whole.Carrier n} {Small.Carrier n}} ((SmallDegree.retraction).apply) _ _ (Candidate.law n x)) (SmallDegree.retract x);
