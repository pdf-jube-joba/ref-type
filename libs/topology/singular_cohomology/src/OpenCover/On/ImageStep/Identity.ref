\definition next: Whole.Carrier (N.Nat^::succ n) := HigherPowers.apply r c;
\definition boundary: Whole.Carrier (N.Nat^::succ n) := #apply{(Whole.boundary (N.Nat^::succ n))} (#apply{(HigherPowers.homotopyMap r)} c);
\definition prior: Whole.Carrier (N.Nat^::succ n) := #apply{(LowerPowers.homotopyMap r)} (#apply{(Whole.boundary n)} c);
\definition balance: Values.add (Values.add c boundary) prior = next :=
  trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _ (Group.assoc c boundary prior)
    (trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _
      (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)}} (Values.add c) _ _ (sym!{{Whole.Carrier (N.Nat^::succ n)}} _ _ (#successorEquation{(Homotopy.laws r)} n c)))
      (trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _ (Group.comm c (Group.difference next c)) (Group.addDifference next c)));
\definition law: Values.add c boundary = Group.difference next prior := Group.cancelRight prior (Values.add c boundary) (Group.difference next prior)
  (trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _ balance (sym!{{Whole.Carrier (N.Nat^::succ n)}} _ _ (Group.addDifference next prior)));
