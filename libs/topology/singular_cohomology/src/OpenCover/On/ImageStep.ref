\use Equality.transport;
\import \parent.Step[n := n] \as Construction;
\import \parent.Selection[n := N.Nat^::succ n] \as Selection;
\import \parent.Boundaries[] \as Boundaries;
\import Small.At[n := n] \as SmallLower;
\import Small.At[n := N.Nat^::succ n] \as SmallHigher;
\import Small.HomotopyPersistence[n := n] \as Preserve;
\import Subdivision.Iterated[].At[n := n] \as LowerPowers;
\import Subdivision.Iterated[].At[n := N.Nat^::succ n] \as HigherPowers;
\import Subdivision.Iterated[].Homotopy[] \as Homotopy;
\import Modules.Laws[V := Whole.Carrier (N.Nat^::succ n), space := Whole.space (N.Nat^::succ n)] \as Values;
\import algebra.Group[].Of[Carrier := Whole.Carrier (N.Nat^::succ n), group := Values.additive] \as Group;
\import Modules.Of[V := Whole.Carrier (N.Nat^::succ n), space := Whole.space (N.Nat^::succ n)].Submodule[] \as Submodules;
\definition residual(sigma: Simplices.Carrier (N.Nat^::succ n)): Whole.Carrier (N.Nat^::succ n) := Construction.residual (homotopyMap n) sigma;
\definition residualBoundary: \forall (sigma: Simplices.Carrier (N.Nat^::succ n)) -> #apply{(Whole.boundary n)} (residual sigma) = #apply{(candidateMap n)} (#apply{(Whole.boundary n)} (Whole.generator (N.Nat^::succ n) sigma)) :=
  \fun (sigma: Simplices.Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier n}} _ _ _
    (#addition{(Whole.boundary n)} (Whole.generator (N.Nat^::succ n) sigma) (#apply{(homotopyMap n)} (#apply{(Whole.boundary n)} (Whole.generator (N.Nat^::succ n) sigma))))
    (sym!{{Whole.Carrier n}} _ _ (Boundaries.law n (Whole.generator (N.Nat^::succ n) sigma)));
\definition basisEquation: \forall (sigma: Simplices.Carrier (N.Nat^::succ n)) -> #apply{(candidateMap (N.Nat^::succ n))} (Whole.generator (N.Nat^::succ n) sigma) =
  Values.add (residual sigma) (#apply{(Whole.boundary (N.Nat^::succ n))} (#apply{(HigherPowers.homotopyMap (Selection.minimum (residual sigma)))} (residual sigma))) :=
  \fun (sigma: Simplices.Carrier (N.Nat^::succ n)) => \block {
    \let x: Whole.Carrier (N.Nat^::succ n) := Whole.generator (N.Nat^::succ n) sigma \then
    \let h: Whole.Carrier (N.Nat^::succ n) := #apply{(homotopyMap n)} (#apply{(Whole.boundary n)} x) \then
    \let d: Whole.Carrier (N.Nat^::succ n) := #apply{(Whole.boundary (N.Nat^::succ n))} (Construction.value (homotopyMap n) sigma) \then
    \return trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _
      (congr!{{Whole.Carrier (N.Nat^::succ (N.Nat^::succ n))} {Whole.Carrier (N.Nat^::succ n)}}
        (\fun (v: Whole.Carrier (N.Nat^::succ (N.Nat^::succ n))) => Values.add x (Values.add (#apply{(Whole.boundary (N.Nat^::succ n))} v) h)) _ _ (Construction.onGenerator (homotopyMap n) sigma))
      (trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _ (sym!{{Whole.Carrier (N.Nat^::succ n)}} _ _ (Group.assoc x d h)) (Group.swapLast x d h))
  };
\module Identity(c: Whole.Carrier (N.Nat^::succ n), r: N.Nat^);
\definition generator: ImageProperty n -> \forall (sigma: Simplices.Carrier (N.Nat^::succ n)) -> SmallHigher.Image (#apply{(candidateMap (N.Nat^::succ n))} (Whole.generator (N.Nat^::succ n) sigma)) := \block {
  \fun (previous: ImageProperty n)(sigma: Simplices.Carrier (N.Nat^::succ n)) \then
  \let c: Whole.Carrier (N.Nat^::succ n) := residual sigma \then
  \let r: N.Nat^ := Selection.minimum c \then
  \let dc: Whole.Carrier n := #apply{(Whole.boundary n)} c \then
  \let dcSmall: SmallLower.Image dc := transport!{{Whole.Carrier n}} SmallLower.Image _ _ (sym!{{Whole.Carrier n}} _ _ (residualBoundary sigma))
    (previous (#apply{(Whole.boundary n)} (Whole.generator (N.Nat^::succ n) sigma))) \then
  \let same: #apply{(candidateMap (N.Nat^::succ n))} (Whole.generator (N.Nat^::succ n) sigma) = Group.difference (HigherPowers.apply r c) (#apply{(LowerPowers.homotopyMap r)} dc) :=
    trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _ (basisEquation sigma) (Identity[c := c, r := r].law) \then
  \return transport!{{Whole.Carrier (N.Nat^::succ n)}} SmallHigher.Image _ _ (sym!{{Whole.Carrier (N.Nat^::succ n)}} _ _ same)
    (Submodules.differenceClosed SmallHigher.submodule (HigherPowers.apply r c) (#apply{(LowerPowers.homotopyMap r)} dc) (Selection.selected c) (Preserve.law r dc dcSmall))
};
\import Modules.Free[Generators := Simplices.Carrier (N.Nat^::succ n)].Induction[].Into[W := Whole.Carrier (N.Nat^::succ n), target := Whole.space (N.Nat^::succ n)] \as Extend;
\definition law: ImageProperty n -> ImageProperty (N.Nat^::succ n) := \fun (previous: ImageProperty n) => Extend.law (candidateMap (N.Nat^::succ n)) SmallHigher.submodule (generator previous);
