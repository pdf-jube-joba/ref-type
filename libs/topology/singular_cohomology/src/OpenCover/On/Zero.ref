\import \parent.Selection[n := N.Nat^::zero] \as Selection;
\import \parent.Terms[n := N.Nat^::zero] \as Terms;
\import Subdivision.Iterated[].At[n := N.Nat^::zero] \as Powers;
\definition value(sigma: Simplices.Carrier N.Nat^::zero): Whole.Carrier (N.Nat^::succ N.Nat^::zero) :=
  #apply{(Powers.homotopyMap (Selection.minimum (Whole.generator N.Nat^::zero sigma)))} (Whole.generator N.Nat^::zero sigma);
\import Modules.Free[Generators := Simplices.Carrier N.Nat^::zero].To[W := Whole.Carrier (N.Nat^::succ N.Nat^::zero), target := Whole.space (N.Nat^::succ N.Nat^::zero)] \as Free;
\definition map: Terms.Map := Free.extension value;
\definition onGenerator: \forall (sigma: Simplices.Carrier N.Nat^::zero) -> #apply{map} (Whole.generator N.Nat^::zero sigma) = value sigma := Free.onGenerator value;
