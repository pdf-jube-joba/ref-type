\use Equality.transport;
\import \parent.Zero[] \as Construction;
\import \parent.Selection[n := N.Nat^::zero] \as Selection;
\import Small.At[n := N.Nat^::zero] \as SmallDegree;
\import Subdivision.Iterated[].At[n := N.Nat^::zero] \as Powers;
\import Subdivision.Iterated[].Homotopy[] \as Homotopy;
\import Modules.Laws[V := Whole.Carrier N.Nat^::zero, space := Whole.space N.Nat^::zero] \as Values;
\import algebra.Group[].Of[Carrier := Whole.Carrier N.Nat^::zero, group := Values.additive] \as Group;
\definition equation: \forall (sigma: Simplices.Carrier N.Nat^::zero) -> #apply{(candidateMap N.Nat^::zero)} (Whole.generator N.Nat^::zero sigma) = Powers.apply (Selection.minimum (Whole.generator N.Nat^::zero sigma)) (Whole.generator N.Nat^::zero sigma) :=
  \fun (sigma: Simplices.Carrier N.Nat^::zero) => \block {
    \let x: Whole.Carrier N.Nat^::zero := Whole.generator N.Nat^::zero sigma \then
    \let r: N.Nat^ := Selection.minimum x \then
    \return trans!{{Whole.Carrier N.Nat^::zero}} _ _ _
      (congr!{{Whole.Carrier (N.Nat^::succ N.Nat^::zero)} {Whole.Carrier N.Nat^::zero}} (\fun (y: Whole.Carrier (N.Nat^::succ N.Nat^::zero)) => Values.add x (#apply{(Whole.boundary N.Nat^::zero)} y)) _ _ (Construction.onGenerator sigma))
      (trans!{{Whole.Carrier N.Nat^::zero}} _ _ _
        (congr!{{Whole.Carrier N.Nat^::zero} {Whole.Carrier N.Nat^::zero}} (Values.add x) _ _ (sym!{{Whole.Carrier N.Nat^::zero}} _ _ (#zeroEquation{(Homotopy.laws r)} x)))
        (trans!{{Whole.Carrier N.Nat^::zero}} _ _ _ (Group.comm x (Group.difference (Powers.apply r x) x)) (Group.addDifference (Powers.apply r x) x)))
  };
\definition generator: \forall (sigma: Simplices.Carrier N.Nat^::zero) -> SmallDegree.Image (#apply{(candidateMap N.Nat^::zero)} (Whole.generator N.Nat^::zero sigma)) :=
  \fun (sigma: Simplices.Carrier N.Nat^::zero) => transport!{{Whole.Carrier N.Nat^::zero}} SmallDegree.Image _ _ (sym!{{Whole.Carrier N.Nat^::zero}} _ _ (equation sigma)) (Selection.selected (Whole.generator N.Nat^::zero sigma));
\import Modules.Free[Generators := Simplices.Carrier N.Nat^::zero].Induction[].Into[W := Whole.Carrier N.Nat^::zero, target := Whole.space N.Nat^::zero] \as Extend;
\definition law: \forall (x: Whole.Carrier N.Nat^::zero) -> SmallDegree.Image (#apply{(candidateMap N.Nat^::zero)} x) := Extend.law (candidateMap N.Nat^::zero) SmallDegree.submodule generator;
