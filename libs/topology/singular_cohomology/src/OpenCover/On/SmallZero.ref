\import \parent.Zero[] \as Construction;
\import \parent.Selection[n := N.Nat^::zero] \as Selection;
\import \parent.SmallZeroExtend[n := N.Nat^::zero] \as Extend;
\import Small.Simplices[] \as SmallSimplices;
\import Small.At[n := N.Nat^::zero] \as Degree;
\import Subdivision.Iterated[].At[n := N.Nat^::zero] \as Powers;
\definition numberZero: \forall (sigma: SmallSimplices.Carrier N.Nat^::zero) -> Selection.number (Whole.generator N.Nat^::zero sigma) = N.Nat^::zero :=
  \fun (sigma: SmallSimplices.Carrier N.Nat^::zero) => Selection.alreadySmall (Whole.generator N.Nat^::zero sigma) (Degree.generatorImage sigma);
\definition basis: Extend.Basis := \fun (sigma: SmallSimplices.Carrier N.Nat^::zero) => trans!{{Whole.Carrier (N.Nat^::succ N.Nat^::zero)}} _ _ _ (Construction.onGenerator sigma)
  (congr!{N.Nat^ {Whole.Carrier (N.Nat^::succ N.Nat^::zero)}} (\fun (r: N.Nat^) => (Powers.homotopyMap r).apply (Whole.generator N.Nat^::zero sigma)) _ _ (numberZero sigma));
\definition law: SmallZeroProperty N.Nat^::zero := Extend.law basis;
