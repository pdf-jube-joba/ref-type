\import \parent.Step[n := n] \as Construction;
\import \parent.Selection[n := N.Nat^::succ n] \as Selection;
\import \parent.SmallZeroExtend[n := N.Nat^::succ n] \as Extend;
\import Small.Simplices[] \as SmallSimplices;
\import Small.At[n := n] \as Lower;
\import Small.At[n := N.Nat^::succ n] \as Higher;
\import Subdivision.Iterated[].At[n := N.Nat^::succ n] \as Powers;
\import Modules.Laws[V := Whole.Carrier (N.Nat^::succ n), space := Whole.space (N.Nat^::succ n)] \as Values;
\import algebra.Group[].Of[Carrier := Whole.Carrier (N.Nat^::succ n), group := Values.additive] \as Group;
\definition boundary: \forall (sigma: SmallSimplices.Carrier (N.Nat^::succ n)) -> (Whole.boundary n).apply (Whole.generator (N.Nat^::succ n) sigma) =
  (Lower.inclusion).apply ((Small.complex.differential).apply n (Small.generator (N.Nat^::succ n) sigma)) :=
  \fun (sigma: SmallSimplices.Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier n}} _ _ _
    (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier n}} ((Whole.boundary n).apply) _ _ (sym!{{Whole.Carrier (N.Nat^::succ n)}} _ _ (Higher.onGenerator sigma)))
    ((Small.inclusion).commutes n (Small.generator (N.Nat^::succ n) sigma));
\definition prior: SmallZeroProperty n -> \forall (sigma: SmallSimplices.Carrier (N.Nat^::succ n)) -> (homotopyMap n).apply ((Whole.boundary n).apply (Whole.generator (N.Nat^::succ n) sigma)) = (Whole.space (N.Nat^::succ n)).zero :=
  \fun (previous: SmallZeroProperty n)(sigma: SmallSimplices.Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{Whole.Carrier n} {Whole.Carrier (N.Nat^::succ n)}} ((homotopyMap n).apply) _ _ (boundary sigma))
    (previous ((Small.complex.differential).apply n (Small.generator (N.Nat^::succ n) sigma)));
\definition residual: SmallZeroProperty n -> \forall (sigma: SmallSimplices.Carrier (N.Nat^::succ n)) -> Construction.residual (homotopyMap n) sigma = Whole.generator (N.Nat^::succ n) sigma :=
  \fun (previous: SmallZeroProperty n)(sigma: SmallSimplices.Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)}} (Values.add (Whole.generator (N.Nat^::succ n) sigma)) _ _ (prior previous sigma)) (Group.zeroRight (Whole.generator (N.Nat^::succ n) sigma));
\definition numberZero: SmallZeroProperty n -> \forall (sigma: SmallSimplices.Carrier (N.Nat^::succ n)) -> Selection.number (Construction.residual (homotopyMap n) sigma) = N.Nat^::zero :=
  \fun (previous: SmallZeroProperty n)(sigma: SmallSimplices.Carrier (N.Nat^::succ n)) => trans!{N.Nat^} _ _ _
    (congr!{{Whole.Carrier (N.Nat^::succ n)} N.Nat^} Selection.number _ _ (residual previous sigma))
    (Selection.alreadySmall (Whole.generator (N.Nat^::succ n) sigma) (Higher.generatorImage sigma));
\definition basis: SmallZeroProperty n -> Extend.Basis :=
  \fun (previous: SmallZeroProperty n)(sigma: SmallSimplices.Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _ _ (Construction.onGenerator (homotopyMap n) sigma)
    (congr!{N.Nat^ {Whole.Carrier (N.Nat^::succ (N.Nat^::succ n))}} (\fun (r: N.Nat^) => (Powers.homotopyMap r).apply (Construction.residual (homotopyMap n) sigma)) _ _ (numberZero previous sigma));
\definition law: SmallZeroProperty n -> SmallZeroProperty (N.Nat^::succ n) := \fun (previous: SmallZeroProperty n) => Extend.law (basis previous);
