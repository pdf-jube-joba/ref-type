\import Small.At[n := N.Nat^::zero] \as Degree;
\import \parent.At[n := N.Nat^::zero] \as Statement;
\import Modules.Laws[V := Whole.Carrier N.Nat^::zero, space := Whole.space N.Nat^::zero] \as Values;
\import algebra.Group[].Of[Carrier := Whole.Carrier N.Nat^::zero, group := Values.additive] \as Group;
\import Modules.Hom[V := Whole.Carrier (N.Nat^::succ N.Nat^::zero), W := Whole.Carrier N.Nat^::zero, source := Whole.space (N.Nat^::succ N.Nat^::zero), target := Whole.space N.Nat^::zero] \as Boundary;
\definition law: Statement.Statement := \fun (x: Small.Carrier N.Nat^::zero) => trans!{{Whole.Carrier N.Nat^::zero}} _ _ _
  (congr!{{Whole.Carrier N.Nat^::zero} {Whole.Carrier N.Nat^::zero}} (Values.add (#apply{Degree.inclusion} x)) _ _
    (trans!{{Whole.Carrier N.Nat^::zero}} _ _ _ (congr!{{Whole.Carrier (N.Nat^::succ N.Nat^::zero)} {Whole.Carrier N.Nat^::zero}} (#apply{(Whole.boundary N.Nat^::zero)}) _ _ (smallZero N.Nat^::zero x)) (Boundary.zeroPreserved (Whole.boundary N.Nat^::zero))))
  (Group.zeroRight (#apply{Degree.inclusion} x));
