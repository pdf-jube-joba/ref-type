\import \parent.CandidateStep[n := n] \as Higher;
\import \parent.Boundaries[] \as Boundaries;
\import Modules.Laws[V := Whole.Carrier n, space := Whole.space n] \as Values;
\import Modules.Laws[V := Whole.Carrier (N.Nat^::succ n), space := Whole.space (N.Nat^::succ n)] \as HigherValues;
\import algebra.Group[].Of[Carrier := Whole.Carrier n, group := Values.additive] \as Group;
\definition expanded: \forall (x: Whole.Carrier (N.Nat^::succ n)) -> #apply{(Whole.boundary n)} (#apply{(candidateMap (N.Nat^::succ n))} x) =
  Values.add (#apply{(Whole.boundary n)} x) (Values.add (#apply{(Whole.boundary n)} (#apply{Higher.boundary} x)) (#apply{(Whole.boundary n)} (#apply{Higher.prior} x))) :=
  \fun (x: Whole.Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier n}} _ _ _
    (#addition{(Whole.boundary n)} x (HigherValues.add (#apply{Higher.boundary} x) (#apply{Higher.prior} x)))
    (congr!{{Whole.Carrier n} {Whole.Carrier n}} (Values.add (#apply{(Whole.boundary n)} x)) _ _ (#addition{(Whole.boundary n)} (#apply{Higher.boundary} x) (#apply{Higher.prior} x)));
\definition law: \forall (x: Whole.Carrier (N.Nat^::succ n)) -> #apply{(Whole.boundary n)} (#apply{(candidateMap (N.Nat^::succ n))} x) = #apply{(candidateMap n)} (#apply{(Whole.boundary n)} x) :=
  \fun (x: Whole.Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier n}} _ _ _ (expanded x)
    (trans!{{Whole.Carrier n}} _ _ _
      (congr!{{Whole.Carrier n} {Whole.Carrier n}} (Values.add (#apply{(Whole.boundary n)} x)) _ _
        (trans!{{Whole.Carrier n}} _ _ _ (congr!{{Whole.Carrier n} {Whole.Carrier n}} (\fun (z: Whole.Carrier n) => Values.add z (#apply{(Whole.boundary n)} (#apply{Higher.prior} x))) _ _
          (Whole.SquareZero[n := n].all (#apply{(homotopyMap (N.Nat^::succ n))} x)))
          (Group.zeroLeft (#apply{(Whole.boundary n)} (#apply{Higher.prior} x)))))
      (sym!{{Whole.Carrier n}} _ _ (Boundaries.law n x)));
