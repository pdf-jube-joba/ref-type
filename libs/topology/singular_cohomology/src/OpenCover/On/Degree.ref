\import Small.At[n := n] \as SmallDegree;
\import Modules.Hom[V := Whole.Carrier n, W := Small.Carrier n, source := Whole.space n, target := Small.space n] \as Maps;
\import Maps.Composition[U := Whole.Carrier n, domain := Whole.space n] \as Composition;
\definition retraction: Maps.Map := Composition.compose SmallDegree.retraction (candidateMap n);
\definition included: \forall (x: Whole.Carrier n) -> SmallDegree.Image (#apply{(candidateMap n)} x) -> #apply{SmallDegree.inclusion} (#apply{retraction} x) = #apply{(candidateMap n)} x :=
  \fun (x: Whole.Carrier n)(member: SmallDegree.Image (#apply{(candidateMap n)} x)) => SmallDegree.imageRetract (#apply{(candidateMap n)} x) member;
