\import Pullback.Square[n := n] \as Square;
\import Modules.Hom[V := SubspaceSmall.Carrier n, W := Whole.Carrier n, source := SubspaceSmall.space n, target := Whole.space n] \as Maps;
\definition law: \forall (x: SmallSubspace.Carrier (Signed.Int^::ofNat n)) ->
  #apply{SpaceMap.map} (Signed.Int^::ofNat n) (#apply{Inclusion.map} (Signed.Int^::ofNat n) x) =
  #apply{WholePair.inclusionMap} (Signed.Int^::ofNat n) (#apply{SubspaceMap.map} (Signed.Int^::ofNat n) x) :=
  \fun (x: SmallSubspace.Carrier (Signed.Int^::ofNat n)) => congr!{Maps.Map {WholeSpace.Carrier (Signed.Int^::ofNat n)}}
    (\fun (f: Maps.Map) => WholeSpace.Positive[n := n].intro (#apply{f} x)) _ _ (Square.law continuous);
