\definition inclusion: \forall (h: WholeRelative.Carrier z) ->
  #apply{WholeMap.map} z (#apply{SourceSequence.inclusion} z h) = #apply{TargetSequence.inclusion} z (#apply{RelativeMap.map} z h) :=
  \fun (h: WholeRelative.Carrier z) => SmallWhole.At[z := z].ext
    (#apply{WholeMap.map} z (#apply{SourceSequence.inclusion} z h)) (#apply{TargetSequence.inclusion} z (#apply{RelativeMap.map} z h))
    (\fun (x: SmallSpace.Carrier z) => congr!{{WholePair.Carrier z} coefficients.Carrier} (#apply{h}) _ _
      (sym!{{WholePair.Carrier z}} _ _ (QuotientMap.At[k := z].onClass compatible x)));
\definition restriction: \forall (h: WholeWhole.Carrier z) ->
  #apply{SubMap.map} z (#apply{SourceSequence.restriction} z h) = #apply{TargetSequence.restriction} z (#apply{WholeMap.map} z h) :=
  \fun (h: WholeWhole.Carrier z) => SmallSub.At[z := z].ext
    (#apply{SubMap.map} z (#apply{SourceSequence.restriction} z h)) (#apply{TargetSequence.restriction} z (#apply{WholeMap.map} z h))
    (\fun (x: SmallSubspace.Carrier z) => congr!{{WholeSpace.Carrier z} coefficients.Carrier} (#apply{h}) _ _ (sym!{{WholeSpace.Carrier z}} _ _ (compatible z x)));
