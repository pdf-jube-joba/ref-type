\definition inclusion: \forall (h: WholeRelative.Carrier z) ->
  (WholeMap.map).apply z ((SourceSequence.inclusion).apply z h) = (TargetSequence.inclusion).apply z ((RelativeMap.map).apply z h) :=
  \fun (h: WholeRelative.Carrier z) => SmallWhole.At[z := z].ext
    ((WholeMap.map).apply z ((SourceSequence.inclusion).apply z h)) ((TargetSequence.inclusion).apply z ((RelativeMap.map).apply z h))
    (\fun (x: SmallSpace.Carrier z) => congr!{{WholePair.Carrier z} coefficients.Carrier} ((h).apply) _ _
      (sym!{{WholePair.Carrier z}} _ _ (QuotientMap.At[k := z].onClass compatible x)));
\definition restriction: \forall (h: WholeWhole.Carrier z) ->
  (SubMap.map).apply z ((SourceSequence.restriction).apply z h) = (TargetSequence.restriction).apply z ((WholeMap.map).apply z h) :=
  \fun (h: WholeWhole.Carrier z) => SmallSub.At[z := z].ext
    ((SubMap.map).apply z ((SourceSequence.restriction).apply z h)) ((TargetSequence.restriction).apply z ((WholeMap.map).apply z h))
    (\fun (x: SmallSubspace.Carrier z) => congr!{{WholeSpace.Carrier z} coefficients.Carrier} ((h).apply) _ _ (sym!{{WholeSpace.Carrier z}} _ _ (compatible z x)));
