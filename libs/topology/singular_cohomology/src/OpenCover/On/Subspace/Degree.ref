\import SubspaceSmall.Simplices[] \as Domain;
\import Small.Simplices[] \as Codomain;
\definition postcompose(sigma: Domain.Carrier n): Codomain.Carrier n := Pullback.At[n := n].postcompose continuous sigma;
\definition injective: \forall (sigma, tau: Domain.Carrier n) -> postcompose sigma = postcompose tau -> sigma = tau :=
  \fun (sigma, tau: Domain.Carrier n)(same: postcompose sigma = postcompose tau) => \axiom:funext(sigma, tau,
    \fun (x: algebraic_topology.Simplex[].Carrier n) => congr!{{Codomain.Carrier n} A} (\fun (s: Codomain.Carrier n) => s x) _ _ same);
\import Modules.Free[Generators := Domain.Carrier n].Reindex[TargetGenerators := Codomain.Carrier n].Injection[f := postcompose].Retraction[] \as Native;
\definition retraction: Modules.Hom[V := Small.Carrier n, W := SubspaceSmall.Carrier n, source := Small.space n, target := SubspaceSmall.space n].Map := Native.retraction injective;
\import Modules.Hom[V := SubspaceSmall.Carrier n, W := SubspaceSmall.Carrier n, source := SubspaceSmall.space n, target := SubspaceSmall.space n] \as End;
\definition leftInverse: \forall (x: SubspaceSmall.Carrier n) -> #apply{retraction} (#apply{map} n x) = x :=
  \fun (x: SubspaceSmall.Carrier n) => congr!{End.Map {SubspaceSmall.Carrier n}} (\fun (f: End.Map) => #apply{f} x) _ _ (Native.leftInverse injective);
