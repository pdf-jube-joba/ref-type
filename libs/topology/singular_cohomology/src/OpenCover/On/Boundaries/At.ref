\import Modules.Laws[V := Whole.Carrier n, space := Whole.space n] \as Values;
\definition Statement: \Prop := \forall (x: Whole.Carrier (N.Nat^::succ n)) -> (candidateMap n).apply ((Whole.boundary n).apply x) =
  Values.add ((Whole.boundary n).apply x) ((Whole.boundary n).apply ((homotopyMap n).apply ((Whole.boundary n).apply x)));
