\import Modules.Laws[V := Whole.Carrier n, space := Whole.space n] \as Values;
\definition Statement: \Prop := \forall (x: Whole.Carrier (N.Nat^::succ n)) -> #apply{(candidateMap n)} (#apply{(Whole.boundary n)} x) =
  Values.add (#apply{(Whole.boundary n)} x) (#apply{(Whole.boundary n)} (#apply{(homotopyMap n)} (#apply{(Whole.boundary n)} x)));
