\import \parent.At[n := N.Nat^::succ n] \as Statement;
\import Modules.Laws[V := Whole.Carrier (N.Nat^::succ n), space := Whole.space (N.Nat^::succ n)] \as Values;
\import algebra.Group[].Of[Carrier := Whole.Carrier (N.Nat^::succ n), group := Values.additive] \as Group;
\import Modules.Hom[V := Whole.Carrier n, W := Whole.Carrier (N.Nat^::succ n), source := Whole.space n, target := Whole.space (N.Nat^::succ n)] \as Shift;
\definition law: Statement.Statement := \fun (x: Whole.Carrier (N.Nat^::succ (N.Nat^::succ n))) => \block {
  \let dx: Whole.Carrier (N.Nat^::succ n) := (Whole.boundary (N.Nat^::succ n)).apply x \then
  \let h: Whole.Carrier (N.Nat^::succ n) := (Whole.boundary (N.Nat^::succ n)).apply ((homotopyMap (N.Nat^::succ n)).apply dx) \then
  \return congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)}} (Values.add dx) _ _
    (trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _
      (congr!{{Whole.Carrier n} {Whole.Carrier (N.Nat^::succ n)}} (\fun (y: Whole.Carrier n) => Values.add h ((homotopyMap n).apply y)) _ _ (Whole.SquareZero[n := n].all x))
      (trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _
        (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)}} (Values.add h) _ _ (Shift.zeroPreserved (homotopyMap n))) (Group.zeroRight h)))
};
