\import std.Data[].Nat[] \as N;
\import \root.Chains[A := A, source := source] \as Chains;
\import resolutions.HomComplex[].Over[R := R, ring := ring].Abelian[N := coefficients] \as Hom;
\import Hom.Native[P := Chains.complex] \as Native;
\definition integerCoefficients: IntegerModules.Bundle := Hom.coefficients;
\import \root.Cochains[A := A, source := source].With[coefficients := integerCoefficients] \as Ordinary;
\definition Carrier[n: N.Nat^]: \Set := Ordinary.Carrier n;
\definition space[n: N.Nat^]: Modules.Space (Carrier n) := Native.space n;
\import chain_complexes.Cochain[].Over[R := R, ring := Rings.commutativeRingAsRing R ring] \as RingComplexes;
\definition complex: RingComplexes.Complex := Native.complex;
\definition coboundary: \forall (n: N.Nat^) -> Carrier n -> Carrier (N.Nat^::succ n) := Ordinary.coboundary;
\definition cohomology: N.Nat^ -> \Set := Ordinary.cohomology;
\definition cohomologySpace[n: N.Nat^]: Modules.Space (cohomology n) := Native.Cohomology[n := n].ordinarySpace;
\definition scalarValue: \forall (n: N.Nat^)(a: R)(h: Carrier n)(x: Chains.Carrier n) ->
  ((space n).smul a h).apply x = (coefficients.space).smul a ((h).apply x) :=
  \fun (n: N.Nat^)(a: R)(h: Carrier n)(x: Chains.Carrier n) => \refl((coefficients.space).smul a ((h).apply x));
\definition coboundaryScalar: \forall (n: N.Nat^)(a: R)(h: Carrier n) ->
  coboundary n ((space n).smul a h) = (space (N.Nat^::succ n)).smul a (coboundary n h) := Native.scalar;
