\import std.Data[].Nat[] \as N;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\import \root.Chains[A := A, source := source] \as Chains;
\import \root.Simplices[A := A, source := source] \as Simplices;
\import resolutions.HomComplex[].Over[R := Scalars.Int^, ring := IntegerRing.commutativeRing].On[P := Chains.complex, N := coefficients] \as Hom;
\import chain_complexes.Cochain[].Over[R := Scalars.Int^, ring := IntegerRing.ring] \as Complexes;
\definition Carrier[n: N.Nat^]: \Set := Hom.Carrier n;
\definition space[n: N.Nat^]: IntegerModules.Space (Carrier n) := Hom.space n;
\definition coboundary[n: N.Nat^]: Carrier n -> Carrier (N.Nat^::succ n) := Hom.apply n;
\definition complex: Complexes.Complex := Hom.complex;
\module At(n: N.Nat^);
\module Cohomology(n: N.Nat^) {
  \import Complexes.At[C := complex, k := n] \as Native;
  \definition Carrier: \Set := Native.Cohomology;
  \definition space: IntegerModules.Space Carrier := Native.cohomologySpace;
  \definition Cycle: \Set := Native.CycleCarrier;
  \definition cycleSpace: IntegerModules.Space Cycle := Native.cycleSpace;
  \definition classOf: Cycle -> Carrier := Native.classOf;
  \definition classLinear: IntegerModules.Hom[V := Cycle, W := Carrier, source := cycleSpace, target := space].Map := Native.classLinear;
}
\definition cohomology[n: N.Nat^]: \Set := Cohomology[n := n].Carrier;
\definition cohomologySpace[n: N.Nat^]: IntegerModules.Space (cohomology n) := Cohomology[n := n].space;

\module Integer;
\module Reduced;
