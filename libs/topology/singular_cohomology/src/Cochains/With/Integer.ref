\import \root.Cochains[A := A, source := source].With[coefficients := coefficients] \as Native;
\import chain_complexes.Integer[] \as Degrees;
\import double_complexes.NonnegativeChain[].Over[R := Scalars.Int^, ring := IntegerRing.ring].ZeroExtension[C := Chains.complex] \as ExtendedChains;
\import resolutions.HomComplex[].Over[R := Scalars.Int^, ring := IntegerRing.commutativeRing].Integer[P := ExtendedChains.complex, N := coefficients] \as IntegerHom;
\import resolutions.HomComplex[].Over[R := Scalars.Int^, ring := IntegerRing.commutativeRing].ZeroExtension[P := Chains.complex, N := coefficients] \as Comparison;
\import Degrees.Over[R := Scalars.Int^, ring := IntegerRing.ring] \as IntegerComplexes;
\definition Carrier(z: Degrees.Degree): \Set := IntegerHom.Carrier z;
\definition space(z: Degrees.Degree): IntegerModules.Space (Carrier z) := IntegerHom.space z;
\definition complex: IntegerComplexes.Complex := IntegerHom.complex;
\definition cohomology(z: Degrees.Degree): \Set := IntegerHom.Cohomology[z := z].Cohomology;
\definition cohomologySpace(z: Degrees.Degree): IntegerModules.Space (cohomology z) := IntegerHom.Cohomology[z := z].cohomologySpace;
\module At(n: N.Nat^) {
  \definition degree: Degrees.Degree := Scalars.Int^::ofNat n;
  \definition isomorphism: IntegerModules.Isomorphism[V := cohomology degree, W := Native.cohomology n,
    source := cohomologySpace degree, target := Native.cohomologySpace n].Isomorphism := Comparison.Cohomology[n := n].isomorphism;
}
