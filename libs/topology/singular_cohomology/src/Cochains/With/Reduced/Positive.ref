\definition index: I.Int^ := I.Int^::ofNat (N.Nat^::succ n);
\import Signed.At[C := Reduced.complex, z := index] \as H;
\import Complexes.At[C := Native.complex, k := N.Nat^::succ n] \as Natural;
\definition toNatural(x: H.Closed): Natural.CycleCarrier := Natural.cycle x
  (trans!{{Native.Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
    (sym!{{Native.Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _ (differentialLaw (N.Nat^::succ n) x))
    (\bysub(Reduced.Carrier index, #carrier{H.cycles}, x)));
\definition toInteger(x: Natural.CycleCarrier): H.Closed := H.cycle x
  (trans!{{Reduced.Carrier (Degrees.next index)}} _ _ _ (differentialLaw (N.Nat^::succ n) x)
    (\bysub(Native.Carrier (N.Nat^::succ n), #carrier{Natural.cycles}, x)));
\definition priorLaw: \forall (h: Reduced.Carrier (I.Int^::ofNat n)) -> #apply{H.prior} h = Native.coboundary n h :=
  \fun (h: Reduced.Carrier (I.Int^::ofNat n)) => Reduced.At[z := index].ext (#apply{H.prior} h) (Native.coboundary n h)
    (\fun (x: Chains.Carrier (N.Nat^::succ n)) => Reduced.Cohomology[z := index].priorOnElement h x);
\import std.Logic[].Proposition[] \as Logic;
\definition boundaryForward: \forall (x: H.Closed) -> \In[H.Closed] (#carrier{H.boundariesInside}) x ->
  \In[Native.Carrier (N.Nat^::succ n)] (Natural.Boundaries (N.Nat^::succ n)) (toNatural x) := \block {
  \fun (x: H.Closed)(boundary: _) \then
  \takefrom h: \Cast[Reduced.Carrier (I.Int^::ofNat n)] ({ h: Reduced.Carrier (I.Int^::ofNat n) \where #apply{H.prior} h = x }) \by boundary \then
  \return Logic.existsIntro[Native.Carrier n, { h: Native.Carrier n \where Native.coboundary n h = toNatural x }] h
    (trans!{{Native.Carrier (N.Nat^::succ n)}} _ _ _ (sym!{{Native.Carrier (N.Nat^::succ n)}} _ _ (priorLaw h))
      (\bysub(Reduced.Carrier (I.Int^::ofNat n), { h: Reduced.Carrier (I.Int^::ofNat n) \where #apply{H.prior} h = x }, h)))
};
\import IntegerModules.Of[V := Reduced.Carrier index, space := Reduced.space index].Submodule[].Image[U := Reduced.Carrier (I.Int^::ofNat n), source := Reduced.space (I.Int^::ofNat n)] \as Images;
\definition boundaryBackward: \forall (x: Natural.CycleCarrier) -> \In[Natural.CycleCarrier] (#carrier{Natural.boundariesInside}) x ->
  \In[H.Closed] (#carrier{H.boundariesInside}) (toInteger x) := \block {
  \fun (x: Natural.CycleCarrier)(boundary: _) \then
  \takefrom h: \Cast[Native.Carrier n] ({ h: Native.Carrier n \where Native.coboundary n h = x }) \by boundary \then
  \return Images.introduce H.prior (toInteger x) h
    (trans!{{Reduced.Carrier index}} _ _ _ (priorLaw h)
      (\bysub(Native.Carrier n, { h: Native.Carrier n \where Native.coboundary n h = x }, h)))
};
\import IntegerModules.Hom[V := H.Closed, W := Natural.CycleCarrier, source := H.cycleSpace, target := Natural.cycleSpace] \as ForwardCycles;
\import IntegerModules.Hom[V := Natural.CycleCarrier, W := H.Closed, source := Natural.cycleSpace, target := H.cycleSpace] \as BackwardCycles;
\definition forwardCycles: ForwardCycles.Map := ForwardCycles.Map {
  apply := toNatural,
  addition := \fun (x, y: H.Closed) => \refl(#add{Natural.cycleSpace} (toNatural x) (toNatural y)),
  scalar := \fun (a: I.Int^)(x: H.Closed) => \refl(#smul{Natural.cycleSpace} a (toNatural x)),
};
\definition backwardCycles: BackwardCycles.Map := BackwardCycles.Map {
  apply := toInteger,
  addition := \fun (x, y: Natural.CycleCarrier) => \refl(#add{H.cycleSpace} (toInteger x) (toInteger y)),
  scalar := \fun (a: I.Int^)(x: Natural.CycleCarrier) => \refl(#smul{H.cycleSpace} a (toInteger x)),
};
\import IntegerModules.Of[V := H.Closed, space := H.cycleSpace].Submodule[].Quotient[S := H.boundariesInside] \as IntegerQuotient;
\import IntegerQuotient.To[W := Natural.Cohomology, target := Natural.cohomologySpace] \as Forward;
\import IntegerModules.Of[V := Natural.CycleCarrier, space := Natural.cycleSpace].Submodule[].Quotient[S := Natural.boundariesInside] \as NaturalQuotient;
\import NaturalQuotient.To[W := H.Cohomology, target := H.cohomologySpace] \as Backward;
\import IntegerModules.Hom[V := Natural.CycleCarrier, W := Natural.Cohomology, source := Natural.cycleSpace, target := Natural.cohomologySpace].Composition[U := H.Closed, domain := H.cycleSpace] \as ForwardCompose;
\import IntegerModules.Hom[V := H.Closed, W := H.Cohomology, source := H.cycleSpace, target := H.cohomologySpace].Composition[U := Natural.CycleCarrier, domain := Natural.cycleSpace] \as BackwardCompose;
\definition forwardRaw: _ := ForwardCompose.compose Natural.classLinear forwardCycles;
\definition backwardRaw: _ := BackwardCompose.compose H.classLinear backwardCycles;
\definition forwardVanishes: Forward.Vanishes forwardRaw :=
  \fun (x: H.Closed)(boundary: \In[H.Closed] (#carrier{H.boundariesInside}) x) => Natural.boundaryClassZero (toNatural x) (boundaryForward x boundary);
\definition backwardVanishes: Backward.Vanishes backwardRaw :=
  \fun (x: Natural.CycleCarrier)(boundary: \In[Natural.CycleCarrier] (#carrier{Natural.boundariesInside}) x) => H.boundaryClassZero (toInteger x) (boundaryBackward x boundary);
\definition forward: _ := Forward.descend forwardRaw forwardVanishes;
\definition backward: _ := Backward.descend backwardRaw backwardVanishes;
\definition onIntegerClass: \forall (x: H.Closed) -> #apply{forward} (H.classOf x) = Natural.classOf (toNatural x) := Forward.onClass forwardRaw forwardVanishes;
\definition onNaturalClass: \forall (x: Natural.CycleCarrier) -> #apply{backward} (Natural.classOf x) = H.classOf (toInteger x) := Backward.onClass backwardRaw backwardVanishes;
\definition leftInverse: \forall (h: H.Cohomology) -> #apply{backward} (#apply{forward} h) = h :=
  H.classInduction (\fun (h: H.Cohomology) => #apply{backward} (#apply{forward} h) = h)
    (\fun (x: H.Closed) => trans!{{H.Cohomology}} _ _ _
      (congr!{{Natural.Cohomology} {H.Cohomology}} (#apply{backward}) _ _ (onIntegerClass x)) (onNaturalClass (toNatural x)));
\definition rightInverse: \forall (h: Natural.Cohomology) -> #apply{forward} (#apply{backward} h) = h :=
  Natural.classInduction (\fun (h: Natural.Cohomology) => #apply{forward} (#apply{backward} h) = h)
    (\fun (x: Natural.CycleCarrier) => trans!{{Natural.Cohomology}} _ _ _
      (congr!{{H.Cohomology} {Natural.Cohomology}} (#apply{forward}) _ _ (onNaturalClass x)) (onIntegerClass (toInteger x)));
\import IntegerModules.Isomorphism[V := H.Cohomology, W := Natural.Cohomology, source := H.cohomologySpace, target := Natural.cohomologySpace] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
};
