\import IntegerModules.Free[Generators := Simplices.Carrier n].To[W := coefficients.Carrier, target := coefficients.space] \as Free;
\import IntegerModules.Hom[V := Chains.Carrier n, W := coefficients.Carrier, source := Chains.space n, target := coefficients.space] \as Maps;
\import IntegerModules.Functions[X := Simplices.Carrier n, V := coefficients.Carrier, target := coefficients.space] \as Functions;
\definition Values: \Set := Functions.Carrier;
\definition valuesSpace: IntegerModules.Space Values := Functions.space;
\definition evaluate(h: Carrier n): Values := \fun (sigma: Simplices.Carrier n) => #apply{h} (Chains.generator n sigma);
\definition extend(values: Values): Carrier n := Free.extension values;
\definition onGenerator: \forall (values: Values)(sigma: Simplices.Carrier n) -> evaluate (extend values) sigma = values sigma := Free.onGenerator;
\definition valuesInverse: \forall (values: Values) -> evaluate (extend values) = values :=
  \fun (values: Values) => \axiom:funext(evaluate (extend values), values, onGenerator values);
\definition cochainInverse: \forall (h: Carrier n) -> extend (evaluate h) = h :=
  \fun (h: Carrier n) => Maps.dataExt (extend (evaluate h)) h
    (sym!{{Chains.Carrier n -> coefficients.Carrier}} _ _ (Free.unique (evaluate h) h (\fun (sigma: Simplices.Carrier n) => \refl(evaluate h sigma))));
\import IntegerModules.Hom[V := Carrier n, W := Values, source := space n, target := valuesSpace] \as Evaluation;
\definition evaluation: Evaluation.Map := Evaluation.Map {
  apply := evaluate,
  addition := \fun (h, j: Carrier n) => \refl(Functions.add (evaluate h) (evaluate j)),
  scalar := \fun (a: Scalars.Int^)(h: Carrier n) => \refl(Functions.scale a (evaluate h)),
};
\import IntegerModules.Hom[V := Values, W := Carrier n, source := valuesSpace, target := space n] \as Extension;
\definition extension: Extension.Map := Extension.Map {
  apply := extend,
  addition := \fun (f, g: Values) => Free.ext (extend (Functions.add f g)) (#add{(space n)} (extend f) (extend g))
    (\fun (sigma: Simplices.Carrier n) => trans!{coefficients.Carrier} _ _ _ (onGenerator (Functions.add f g) sigma)
      (sym!{coefficients.Carrier} _ _ (congr2!{coefficients.Carrier coefficients.Carrier coefficients.Carrier} (#add{coefficients.space}) _ _ _ _
        (onGenerator f sigma) (onGenerator g sigma)))),
  scalar := \fun (a: Scalars.Int^)(f: Values) => Free.ext (extend (Functions.scale a f)) (#smul{(space n)} a (extend f))
    (\fun (sigma: Simplices.Carrier n) => trans!{coefficients.Carrier} _ _ _ (onGenerator (Functions.scale a f) sigma)
      (sym!{coefficients.Carrier} _ _ (congr!{coefficients.Carrier coefficients.Carrier} (#smul{coefficients.space} a) _ _ (onGenerator f sigma)))),
};
\import IntegerModules.Isomorphism[V := Carrier n, W := Values, source := space n, target := valuesSpace] \as Isomorphisms;
\definition productIsomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := evaluation, backward := extension,
  leftInverse := cochainInverse, rightInverse := valuesInverse,
};
