\import Simplex.Vertices[] \as Vertices;
\import Simplex.AffineIdentity[n := n] \as AffineIdentity;
\import \parent.At[m := n] \as Evaluation;
\import topology.Maps[A := Points, B := Points].Identity[] \as Identity;
\definition vertices: Tuples.Tuple (N.Nat^::succ n) := Vertices.vertex n;
\definition base: Tuples.Carrier (N.Nat^::succ n) := Tuples.generator (N.Nat^::succ n) vertices;
\definition simplex: Simplices.Carrier n := \into[Simplices.At[n := n].Function]((\fun (x: Points) => x), Simplices.Carrier n) \by { Identity.continuous Space.topology };
\definition onTuple: Evaluation.onTuple vertices = simplex :=
  Simplices.ext n (Evaluation.onTuple vertices) simplex AffineIdentity.law;
\definition chain: #apply{Evaluation.map} base = Chains.generator n simplex :=
  trans!{{Chains.Carrier n}} _ _ _ (Evaluation.onGenerator vertices)
    (congr!{{Simplices.Carrier n} {Chains.Carrier n}} (Chains.generator n) _ _ onTuple);
