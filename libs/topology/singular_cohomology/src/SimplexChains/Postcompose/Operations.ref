\import \parent.At[m := m] \as Evaluation;
\import \parent.At[m := N.Nat^::succ m] \as HigherEvaluation;
\import \parent.\parent.At[m := m] \as Source;
\import \parent.\parent.At[m := N.Nat^::succ m] \as SourceHigher;
\import Final.At[m := m] \as Target;
\import Final.At[m := N.Nat^::succ m] \as TargetHigher;
\import Tuples.Subdivision[centres := centres] \as Subdivision;
\import Subdivision.Homotopy[] \as Homotopy;
\import FinalTuples.Subdivision[centres := Final.centres] \as OtherSubdivision;
\import OtherSubdivision.Homotopy[] \as OtherHomotopy;
\import Subdivision.Natural[W := Final.Points, targetCentres := Final.centres] \as Natural;
\import Homotopy.Natural[W := Final.Points, targetCentres := Final.centres] \as HomotopyNatural;
\definition preserves: \forall (w: Affine.Vertices) -> Natural.Preserves (transform w) := \fun (w: Affine.Vertices) => centreLaw w;
\definition subdivision: \forall (w: Affine.Vertices)(x: Tuples.Carrier (N.Nat^::succ m)) ->
  (Target.map).apply ((OtherSubdivision.map (N.Nat^::succ m)).apply ((TupleMaps.push (N.Nat^::succ m) (transform w)).apply x)) =
    (Maps.At[n := m].push (transform w) (continuous w)).apply ((Source.map).apply ((Subdivision.map (N.Nat^::succ m)).apply x)) :=
  \fun (w: Affine.Vertices)(x: Tuples.Carrier (N.Nat^::succ m)) => trans!{{FinalChains.Carrier m}} _ _ _
    (congr!{{FinalTuples.Carrier (N.Nat^::succ m)} {FinalChains.Carrier m}} ((Target.map).apply) _ _
      (sym!{{FinalTuples.Carrier (N.Nat^::succ m)}} _ _ (Natural.law (N.Nat^::succ m) (transform w) (preserves w) x)))
    (Evaluation.law w ((Subdivision.map (N.Nat^::succ m)).apply x));
\definition homotopy: \forall (w: Affine.Vertices)(x: Tuples.Carrier (N.Nat^::succ m)) ->
  (TargetHigher.map).apply ((OtherHomotopy.map (N.Nat^::succ m)).apply ((TupleMaps.push (N.Nat^::succ m) (transform w)).apply x)) =
    (Maps.At[n := N.Nat^::succ m].push (transform w) (continuous w)).apply ((SourceHigher.map).apply ((Homotopy.map (N.Nat^::succ m)).apply x)) :=
  \fun (w: Affine.Vertices)(x: Tuples.Carrier (N.Nat^::succ m)) => trans!{{FinalChains.Carrier (N.Nat^::succ m)}} _ _ _
    (congr!{{FinalTuples.Carrier (N.Nat^::succ (N.Nat^::succ m))} {FinalChains.Carrier (N.Nat^::succ m)}} ((TargetHigher.map).apply) _ _
      (sym!{{FinalTuples.Carrier (N.Nat^::succ (N.Nat^::succ m))}} _ _ (HomotopyNatural.law (N.Nat^::succ m) (transform w) (preserves w) x)))
    (HigherEvaluation.law w ((Homotopy.map (N.Nat^::succ m)).apply x));
