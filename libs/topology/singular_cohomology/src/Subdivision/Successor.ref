\import \parent.At[n := n] \as Lower;
\import \parent.At[n := N.Nat^::succ n] \as Higher;
\import \root.SimplexChains[n := n] \as LowerGeometry;
\import \root.SimplexChains[n := N.Nat^::succ n] \as HigherGeometry;
\import Simplex.At[n := n] \as LowerSpace;
\import Simplex.At[n := N.Nat^::succ n] \as HigherSpace;
\import \root.Chains[A := LowerGeometry.Points, source := LowerSpace.topology] \as LowerChains;
\import \root.Chains[A := HigherGeometry.Points, source := HigherSpace.topology] \as HigherChains;
\import \root.Simplices[A := LowerGeometry.Points, source := LowerSpace.topology] \as LowerSimplices;
\import \root.Maps[A := LowerGeometry.Points, B := HigherGeometry.Points, source := LowerSpace.topology, target := HigherSpace.topology] \as FaceMaps;
\import \root.Maps[A := LowerGeometry.Points, B := A, source := LowerSpace.topology, target := source] \as LowerMaps;
\import \root.Maps[A := HigherGeometry.Points, B := A, source := HigherSpace.topology, target := source] \as HigherMaps;
\module Face(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)));
\module SumImage(W: \Set, target: Modules.Space W) {
  \import Modules.Hom[V := Chains.Carrier n, W := W, source := Chains.space n, target := target] \as Linear;
  \import Modules.Alternating[V := W, space := target] \as Sum;
  \import Modules.Alternating[V := Chains.Carrier n, space := Chains.space n].Mapping[W := W, target := target] \as Mapping;
  \definition law: \forall (f: Linear.Map)(values: Simplices.Carrier n -> W) ->
    (\forall (tau: Simplices.Carrier n) -> #apply{f} (Chains.generator n tau) = values tau) ->
    \forall (sigma: Simplices.Carrier (N.Nat^::succ n)) ->
      #apply{f} (#apply{(Chains.boundary n)} (Chains.generator (N.Nat^::succ n) sigma)) =
        Sum.sum (N.Nat^::succ (N.Nat^::succ n)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => values (Simplices.face n i sigma)) :=
    \fun (f: Linear.Map)(values: Simplices.Carrier n -> W)(agrees: \forall (tau: Simplices.Carrier n) -> #apply{f} (Chains.generator n tau) = values tau)(sigma: Simplices.Carrier (N.Nat^::succ n)) => trans!{W} _ _ _
      (congr!{{Chains.Carrier n} W} (#apply{f}) _ _ (Chains.Boundary[n := n].onGenerator sigma))
      (trans!{W} _ _ _ (Mapping.law f (N.Nat^::succ (N.Nat^::succ n)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => Chains.generator n (Simplices.face n i sigma)))
        (Sum.congruent (N.Nat^::succ (N.Nat^::succ n))
          (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => #apply{f} (Chains.generator n (Simplices.face n i sigma)))
          (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => values (Simplices.face n i sigma))
          (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => agrees (Simplices.face n i sigma))));
}
\module Differential;
\module Prior;
\module Equation;
