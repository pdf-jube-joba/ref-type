\import \root.Cochains[A := A, source := source].With[coefficients := M] \as Cochains;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Homotopy[P := Chains.complex, Q := Chains.complex, N := M] \as Native;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].End[P := Chains.complex, N := M] \as End;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring].Map[C := Cochains.complex, D := Cochains.complex] \as Maps;
\definition map: Maps.Map := Native.map chainMap;
\definition onCohomology: \forall (n: N.Nat^)(q: Cochains.cohomology n) -> (Maps.At[k := n].induced map).apply q = q :=
  \fun (n: N.Nat^)(q: Cochains.cohomology n) => trans!{{Cochains.cohomology n}} _ _ _ (Native.onCohomology chainMap Identity.identity homotopy n q) (End.At[k := n].onCohomology q);
