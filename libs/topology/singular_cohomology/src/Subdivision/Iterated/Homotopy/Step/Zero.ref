\import \parent.\parent.\parent.At[n := N.Nat^::zero] \as Degree;
\import Construction.At[n := N.Nat^::zero] \as Original;
\import Modules.Laws[V := Chains.Carrier N.Nat^::zero, space := Chains.space N.Nat^::zero] \as Values;
\import algebra.Group[].Of[Carrier := Chains.Carrier N.Nat^::zero, group := Values.additive] \as Group;
\definition expanded: \forall (x: Chains.Carrier N.Nat^::zero) -> #apply{(Chains.boundary N.Nat^::zero)} (#apply{(Degree.homotopyMap (N.Nat^::succ r))} x) =
  Values.add (#apply{(Chains.boundary N.Nat^::zero)} (#apply{Original.homotopyMap} (Degree.apply r x))) (#apply{(Chains.boundary N.Nat^::zero)} (#apply{(Degree.homotopyMap r)} x)) :=
  \fun (x: Chains.Carrier N.Nat^::zero) => #addition{(Chains.boundary N.Nat^::zero)} _ _;
\definition law: Property r -> \forall (x: Chains.Carrier N.Nat^::zero) -> Group.difference (Degree.apply (N.Nat^::succ r) x) x = #apply{(Chains.boundary N.Nat^::zero)} (#apply{(Degree.homotopyMap (N.Nat^::succ r))} x) :=
  \fun (previous: Property r)(x: Chains.Carrier N.Nat^::zero) => sym!{{Chains.Carrier N.Nat^::zero}} _ _
    (trans!{{Chains.Carrier N.Nat^::zero}} _ _ _ (expanded x)
      (trans!{{Chains.Carrier N.Nat^::zero}} _ _ _
        (congr2!{{Chains.Carrier N.Nat^::zero} {Chains.Carrier N.Nat^::zero} {Chains.Carrier N.Nat^::zero}} Values.add _ _ _ _
          (sym!{{Chains.Carrier N.Nat^::zero}} _ _ (Construction.Zero[].law (Degree.apply r x))) (sym!{{Chains.Carrier N.Nat^::zero}} _ _ (#zeroEquation{previous} x)))
        (Group.composeDifferences (Degree.apply (N.Nat^::succ r) x) (Degree.apply r x) x)));
