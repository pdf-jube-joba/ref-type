\import Modules.Laws[V := Chains.Carrier (N.Nat^::succ n), space := Chains.space (N.Nat^::succ n)] \as Values;
\import algebra.Group[].Of[Carrier := Chains.Carrier (N.Nat^::succ n), group := Values.additive] \as Group;
\import Modules.Hom[V := Chains.Carrier (N.Nat^::succ (N.Nat^::succ n)), W := Chains.Carrier (N.Nat^::succ n), source := Chains.space (N.Nat^::succ (N.Nat^::succ n)), target := Chains.space (N.Nat^::succ n)] \as Boundary;
\definition rightZero: Values.add (#apply{(Chains.boundary (N.Nat^::succ n))} #zero{(Chains.space (N.Nat^::succ (N.Nat^::succ n)))}) Values.zero = Values.zero :=
  trans!{{Chains.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{Chains.Carrier (N.Nat^::succ n)} {Chains.Carrier (N.Nat^::succ n)}} (\fun (a: Chains.Carrier (N.Nat^::succ n)) => Values.add a Values.zero) _ _ (Boundary.zeroPreserved (Chains.boundary (N.Nat^::succ n)))) (Group.zeroLeft Values.zero);
\definition law: \forall (x: Chains.Carrier (N.Nat^::succ n)) -> Group.difference x x = Values.add (#apply{(Chains.boundary (N.Nat^::succ n))} #zero{(Chains.space (N.Nat^::succ (N.Nat^::succ n)))}) Values.zero :=
  \fun (x: Chains.Carrier (N.Nat^::succ n)) => trans!{{Chains.Carrier (N.Nat^::succ n)}} _ _ _ (Group.inverseRight x) (sym!{{Chains.Carrier (N.Nat^::succ n)}} _ _ rightZero);
