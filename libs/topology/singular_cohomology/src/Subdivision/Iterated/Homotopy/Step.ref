\import \root.Subdivision[A := A, source := source] \as Construction;
\module Zero;
\module Positive(n: N.Nat^);
\definition law: Property r -> Property (N.Nat^::succ r) := \fun (previous: Property r) => Native.Laws[power (N.Nat^::succ r), Identity.identity, data (N.Nat^::succ r)] {
  addition := \fun (n: N.Nat^) => #addition{(\parent.\parent.At[n := n].homotopyMap (N.Nat^::succ r))},
  scalar := \fun (n: N.Nat^) => #scalar{(\parent.\parent.At[n := n].homotopyMap (N.Nat^::succ r))},
  zeroEquation := Zero[].law previous,
  successorEquation := \fun (n: N.Nat^) => Positive[n := n].law previous,
};
