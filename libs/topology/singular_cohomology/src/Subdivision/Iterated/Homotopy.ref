\definition data(r: N.Nat^): Native.Data := Native.Data { apply := \fun (n: N.Nat^) => #apply{\parent.At[n := n].homotopyMap r} };
\definition Property(r: N.Nat^): \Prop := Native.Laws[power r, Identity.identity, data r];
\module Zero;
\module Step(r: N.Nat^);
\definition laws: \forall (r: N.Nat^) -> Property r := \induction (r: N.Nat^) \return Property r \with {
  | zero: Zero[].law
  | succ: \fun (r: N.Nat^)(previous: Property r) => Step[r := r].law previous
};
\definition homotopy(r: N.Nat^): Native.Homotopy (power r) Identity.identity := \into[Native.Data](data r, Native.Homotopy (power r) Identity.identity) \by { laws r };
