\import Simplex.At[n := n] \as Space;
\import \root.SimplexChains[n := n] \as Geometry;
\import Geometry.Subdivision[] \as Subdivision;
\import Geometry.Fundamental[] \as Fundamental;
\import \root.Chains[A := Geometry.Points, source := Space.topology] \as GeometricChains;
\import \root.Maps[A := Geometry.Points, B := A, source := Space.topology, target := source] \as Push;
\definition continuous(sigma: Simplices.Carrier n): Push.Continuous sigma := Simplices.At[n := n].continuous sigma;
\definition onSimplex(sigma: Simplices.Carrier n): Chains.Carrier n := #apply{(Push.At[n := n].push sigma (continuous sigma))} Subdivision.chain;
\definition homotopyOnSimplex(sigma: Simplices.Carrier n): Chains.Carrier (N.Nat^::succ n) :=
  #apply{(Push.At[n := N.Nat^::succ n].push sigma (continuous sigma))} Subdivision.homotopy;
\import Modules.Free[Generators := Simplices.Carrier n].To[W := Chains.Carrier n, target := Chains.space n] \as Free;
\import Modules.Free[Generators := Simplices.Carrier n].To[W := Chains.Carrier (N.Nat^::succ n), target := Chains.space (N.Nat^::succ n)] \as Shift;
\definition map: Modules.Hom[V := Chains.Carrier n, W := Chains.Carrier n, source := Chains.space n, target := Chains.space n].Map := Free.extension onSimplex;
\definition homotopyMap: Modules.Hom[V := Chains.Carrier n, W := Chains.Carrier (N.Nat^::succ n), source := Chains.space n, target := Chains.space (N.Nat^::succ n)].Map := Shift.extension homotopyOnSimplex;
\definition onGenerator: \forall (sigma: Simplices.Carrier n) -> #apply{map} (Chains.generator n sigma) = onSimplex sigma := Free.onGenerator onSimplex;
\definition homotopyOnGenerator: \forall (sigma: Simplices.Carrier n) -> #apply{homotopyMap} (Chains.generator n sigma) = homotopyOnSimplex sigma := Shift.onGenerator homotopyOnSimplex;
\definition originalSimplex: \forall (sigma: Simplices.Carrier n) -> Push.postcompose n sigma (continuous sigma) Fundamental.simplex = sigma :=
  \fun (sigma: Simplices.Carrier n) => Simplices.ext n (Push.postcompose n sigma (continuous sigma) Fundamental.simplex) sigma (\fun (x: Simplex.Carrier n) => \refl(sigma x));
\definition original: \forall (sigma: Simplices.Carrier n) -> #apply{(Push.At[n := n].push sigma (continuous sigma))} (GeometricChains.generator n Fundamental.simplex) = Chains.generator n sigma :=
  \fun (sigma: Simplices.Carrier n) => trans!{{Chains.Carrier n}} _ _ _ (Push.At[n := n].onGenerator sigma (continuous sigma) Fundamental.simplex)
    (congr!{{Simplices.Carrier n} {Chains.Carrier n}} (Chains.generator n) _ _ (originalSimplex sigma));
\module Boundary;
