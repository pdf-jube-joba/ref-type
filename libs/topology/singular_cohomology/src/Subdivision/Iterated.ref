\import Complexes.Map[C := Chains.complex, D := Chains.complex] \as Maps;
\import Maps.Composition[B := Chains.complex] \as Composition;
\definition power: N.Nat^ -> Maps.Map := \induction (r: N.Nat^) \return Maps.Map \with {
  | zero: Identity.identity
  | succ: \fun (r: N.Nat^)(previous: Maps.Map) => Composition.compose chainMap previous
};
\module At(n: N.Nat^);
\module Homotopy;
