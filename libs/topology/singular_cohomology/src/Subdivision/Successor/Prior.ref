\import Modules.Alternating[V := Chains.Carrier (N.Nat^::succ n), space := Chains.space (N.Nat^::succ n)] \as Sum;
\import Modules.Alternating[V := HigherChains.Carrier (N.Nat^::succ n), space := HigherChains.space (N.Nat^::succ n)].Mapping[W := Chains.Carrier (N.Nat^::succ n), target := Chains.space (N.Nat^::succ n)] \as Mapping;
\import \parent.SumImage[W := Chains.Carrier (N.Nat^::succ n), target := Chains.space (N.Nat^::succ n)] \as Image;
\definition law: \forall (sigma: Simplices.Carrier (N.Nat^::succ n)) -> Higher.Boundary[].prior sigma =
  (Lower.homotopyMap).apply ((Chains.boundary n).apply (Chains.generator (N.Nat^::succ n) sigma)) :=
  \fun (sigma: Simplices.Carrier (N.Nat^::succ n)) => \block {
    \let left: Higher.Boundary[].prior sigma = Sum.sum (N.Nat^::succ (N.Nat^::succ n)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => Lower.homotopyOnSimplex (Simplices.face n i sigma)) :=
      trans!{{Chains.Carrier (N.Nat^::succ n)}} _ _ _
        (congr!{{HigherChains.Carrier (N.Nat^::succ n)} {Chains.Carrier (N.Nat^::succ n)}} ((HigherMaps.At[n := N.Nat^::succ n].push sigma (Higher.continuous sigma)).apply) _ _ HigherGeometry.Subdivision[].priorExpansion)
        (trans!{{Chains.Carrier (N.Nat^::succ n)}} _ _ _
          (Mapping.law (HigherMaps.At[n := N.Nat^::succ n].push sigma (Higher.continuous sigma)) (N.Nat^::succ (N.Nat^::succ n)) HigherGeometry.Subdivision[].faceTerm)
          (Sum.congruent (N.Nat^::succ (N.Nat^::succ n)) _ _ (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => \parent.Face[i := i].homotopy sigma))) \then
    \return trans!{{Chains.Carrier (N.Nat^::succ n)}} _ _ _ left
      (sym!{{Chains.Carrier (N.Nat^::succ n)}} _ _ (Image.law Lower.homotopyMap Lower.homotopyOnSimplex Lower.homotopyOnGenerator sigma))
  };
