\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import Native.Homotopy[C := Natural.complex, D := Natural.complex] \as Homotopies;
\import Native.End[C := Natural.complex] \as NativeEnd;
\definition data: Homotopies.LinearData := \into[Homotopies.Data](Homotopies.Data { apply := \fun (n: N.Nat^) => (\parent.Shift[n := n].map).apply }, { h: Homotopies.Data \where Homotopies.LinearLaws[h] }) \by {
  Homotopies.LinearLaws[Homotopies.Data { apply := \fun (n: N.Nat^) => (\parent.Shift[n := n].map).apply }] {
    addition := \fun (n: N.Nat^) => (\parent.Shift[n := n].map).addition,
    scalar := \fun (n: N.Nat^) => (\parent.Shift[n := n].map).scalar,
  }
};
\import Homotopies.Boundary[h := data] \as Boundaries;
\import Boundaries.Correct[f := NativeEnd.identity] \as Correction;
\definition projection: Native.Map[C := Natural.complex, D := Natural.complex].Map := Correction.map;
\definition homotopy: Homotopies.Homotopy NativeEnd.identity projection := Correction.homotopy;
\module Zero;
\module Positive(n: N.Nat^);
