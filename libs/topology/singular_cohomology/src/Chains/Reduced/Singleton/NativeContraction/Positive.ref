\definition degree: N.Nat^ := N.Nat^::succ n;
\import \parent.\parent.Positive[n := n] \as Calculation;
\import Modules.Laws[V := Natural.Carrier degree, space := Natural.space degree] \as Vector;
\import algebra.Group[].Of[Carrier := Natural.Carrier degree, group := Vector.additive] \as Group;
\definition law: Unique -> \forall (x: Natural.Carrier degree) -> #apply{projection} degree x = #zero{(Natural.space degree)} :=
  \fun (unique: Unique)(x: Natural.Carrier degree) => trans!{{Natural.Carrier degree}} _ _ _
    (congr!{{Natural.Carrier degree} {Natural.Carrier degree}} (Group.difference x) _ _ (Calculation.law unique x))
    (Group.inverseRight x);
