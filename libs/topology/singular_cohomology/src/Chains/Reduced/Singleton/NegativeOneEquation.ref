\definition degree: I.Int^ := I.Int^::negSucc N.Nat^::zero;
\import \parent.At[z := degree] \as Current;
\import \parent.Zero[] \as ZeroDegree;
\import algebra.Group[].Of[Carrier := I.Int^, group := Modules.scalarGroup] \as Group;
\definition law: \forall (x: Carrier degree) -> Current.rightHand x = x :=
  \fun (x: Carrier degree) => trans!{I.Int^} _ _ _
    (congr2!{I.Int^ I.Int^ I.Int^} (#add{Modules.scalarModule}) _ _ _ _
      (Transport.castRefl complex.family.Carrier degree (#apply{Augmentation.map} (#apply{ZeroDegree.section} x)))
      (Transport.castRefl complex.family.Carrier degree #zero{Modules.scalarModule}))
    (trans!{I.Int^} _ _ _
      (congr!{I.Int^ I.Int^} (\fun (y: I.Int^) => Group.add y Group.zero) _ _ (Augmentation.sectionLaw a x))
      (Group.zeroRight x));
