\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.congr;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition simplex(m, n: N.Nat^)(same: m = n): Simplices.Carrier m -> Simplices.Carrier n := Transport.cast Simplices.Carrier m n same;
\definition apply(m, n: N.Nat^)(same: m = n): Carrier m -> Carrier n := Transport.cast Carrier m n same;
\definition onGenerator: \forall (m, n: N.Nat^)(same: m = n)(v: Simplices.Carrier m) ->
  apply m n same (generator m v) = generator n (simplex m n same v) := Transport.natural Simplices.Carrier Carrier generator;
\definition addition: \forall (m, n: N.Nat^)(same: m = n)(x, y: Carrier m) ->
  apply m n same (#add{(space m)} x y) = #add{(space n)} (apply m n same x) (apply m n same y) :=
  Transport.binaryNatural Carrier Carrier Carrier (\fun (k: N.Nat^) => #add{(space k)});
\definition scalar: \forall (m, n: N.Nat^)(same: m = n)(a: I.Int^)(x: Carrier m) ->
  apply m n same (#smul{(space m)} a x) = #smul{(space n)} a (apply m n same x) :=
  \fun (m, n: N.Nat^)(same: m = n)(a: I.Int^) => Transport.natural Carrier Carrier (\fun (k: N.Nat^) => #smul{(space k)} a) m n same;
\definition linear(m, n: N.Nat^)(same: m = n): Modules.Hom[V := Carrier m, W := Carrier n, source := space m, target := space n].Map :=
  Modules.Hom[V := Carrier m, W := Carrier n, source := space m, target := space n].Map {
    apply := apply m n same, addition := addition m n same, scalar := scalar m n same,
  };
\definition zero: \forall (m, n: N.Nat^)(same: m = n) -> apply m n same #zero{(space m)} = #zero{(space n)} :=
  Transport.pointNatural Carrier (\fun (k: N.Nat^) => #zero{(space k)});
\definition boundaryNatural: \forall (m, n: N.Nat^)(same: m = n)(x: Carrier (N.Nat^::succ m)) ->
  apply m n same (#apply{(boundary m)} x) = #apply{(boundary n)} (apply (N.Nat^::succ m) (N.Nat^::succ n) (congr!{N.Nat^ N.Nat^} N.Nat^::succ m n same) x) :=
  \fun (m, n: N.Nat^)(same: m = n)(x: Carrier (N.Nat^::succ m)) => trans!{{Carrier n}} _ _ _
    (Transport.natural (\fun (k: N.Nat^) => Carrier (N.Nat^::succ k)) Carrier (\fun (k: N.Nat^) => #apply{(boundary k)}) m n same x)
    (congr!{{Carrier (N.Nat^::succ n)} {Carrier n}} (#apply{(boundary n)}) _ _ (Transport.reindex Carrier N.Nat^::succ m n same x));
