\import \root.Chains[A := A, source := source] \as Chains;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.congr;
\import Modules.Hom[V := Carrier n, W := W, source := space n, target := target] \as Linear;
\import Modules.Alternating[V := W, space := target] \as Sum;
\import Modules.Alternating[V := Carrier n, space := space n].Mapping[W := W, target := target] \as Mapping;
\definition law: \forall (f: Linear.Map)(values: Simplices.Carrier n -> W) ->
  (\forall (tau: Simplices.Carrier n) -> #apply{f} (generator n tau) = values tau) ->
  \forall (sigma: Simplices.Carrier (N.Nat^::succ n)) ->
    #apply{f} (#apply{(Chains.boundary n)} (generator (N.Nat^::succ n) sigma)) =
      Sum.sum (N.Nat^::succ (N.Nat^::succ n)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => values (Simplices.face n i sigma)) :=
  \fun (f: Linear.Map)(values: Simplices.Carrier n -> W)(agrees: \forall (tau: Simplices.Carrier n) -> #apply{f} (generator n tau) = values tau)(sigma: Simplices.Carrier (N.Nat^::succ n)) => trans!{W} _ _ _
    (congr!{{Carrier n} W} (#apply{f}) _ _ (onGenerator sigma))
    (trans!{W} _ _ _ (Mapping.law f (N.Nat^::succ (N.Nat^::succ n)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => generator n (Simplices.face n i sigma)))
      (Sum.congruent (N.Nat^::succ (N.Nat^::succ n))
        (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => #apply{f} (generator n (Simplices.face n i sigma)))
        (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => values (Simplices.face n i sigma))
        (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => agrees (Simplices.face n i sigma))));
