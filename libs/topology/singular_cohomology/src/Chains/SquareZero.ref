\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\use Equality.eq_reason;
\import \parent.Boundary[n := n] \as Lower;
\import \parent.Boundary[n := N.Nat^::succ n] \as Higher;
\import Modules.Alternating[V := Carrier n, space := space n] \as Sums;
\import Modules.Alternating[V := Carrier (N.Nat^::succ n), space := space (N.Nat^::succ n)].Mapping[W := Carrier n, target := space n] \as Mapping;
\import Simplices.Identities[] \as Faces;
\definition onGenerator: \forall (sigma: Simplices.Carrier (N.Nat^::succ (N.Nat^::succ n))) ->
  (boundary n).apply ((boundary (N.Nat^::succ n)).apply (generator (N.Nat^::succ (N.Nat^::succ n)) sigma)) = (space n).zero :=
  \fun (sigma: _) => eq_reason!{
    {(boundary n).apply ((boundary (N.Nat^::succ n)).apply (generator (N.Nat^::succ (N.Nat^::succ n)) sigma))}
    "=" {(boundary n).apply (Higher.onSimplex sigma)} "by" {
      congr!{{Carrier (N.Nat^::succ n)} {Carrier n}} ((boundary n).apply) _ _ (Higher.onGenerator sigma)}
    "=" {Sums.sum (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))
      (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) =>
        (boundary n).apply (generator (N.Nat^::succ n) (Simplices.face (N.Nat^::succ n) i sigma)))} "by" {
      Mapping.law (boundary n) (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))
        (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) => generator (N.Nat^::succ n) (Simplices.face (N.Nat^::succ n) i sigma))}
    "=" {Sums.sum (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))
      (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) =>
        Sums.sum (N.Nat^::succ (N.Nat^::succ n))
          (\fun (j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => generator n (Simplices.face n j (Simplices.face (N.Nat^::succ n) i sigma))))} "by" {
      Sums.congruent (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))) _ _
        (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) => Lower.onGenerator (Simplices.face (N.Nat^::succ n) i sigma))}
    "=" {(space n).zero} "by" {
      Sums.doubleZero (N.Nat^::succ (N.Nat^::succ n))
        (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))))(j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) =>
          generator n (Simplices.face n j (Simplices.face (N.Nat^::succ n) i sigma)))
        (\fun (i, j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(ordered: _) =>
          congr!{{Simplices.Carrier n} {Carrier n}} (generator n) _ _ (Faces.faceIdentity n i j sigma ordered))}
  };
\import Modules.Hom[V := Carrier (N.Nat^::succ n), W := Carrier n, source := space (N.Nat^::succ n), target := space n].Composition[U := Carrier (N.Nat^::succ (N.Nat^::succ n)), domain := space (N.Nat^::succ (N.Nat^::succ n))] \as Composition;
\import Modules.Free[Generators := Simplices.Carrier (N.Nat^::succ (N.Nat^::succ n))].To[W := Carrier n, target := space n] \as Universal;
\import Modules.Hom[V := Carrier (N.Nat^::succ (N.Nat^::succ n)), W := Carrier n, source := space (N.Nat^::succ (N.Nat^::succ n)), target := space n] \as Maps;
\definition mapsEqual: (Composition.compose (boundary n) (boundary (N.Nat^::succ n))).apply = (Maps.zeroMap).apply :=
  trans!{{Carrier (N.Nat^::succ (N.Nat^::succ n)) -> Carrier n}} _ _ _
    (Universal.unique (\fun (_: Simplices.Carrier (N.Nat^::succ (N.Nat^::succ n))) => (space n).zero)
      (Composition.compose (boundary n) (boundary (N.Nat^::succ n))) onGenerator)
    (sym!{{Carrier (N.Nat^::succ (N.Nat^::succ n)) -> Carrier n}} _ _
      (Universal.unique (\fun (_: Simplices.Carrier (N.Nat^::succ (N.Nat^::succ n))) => (space n).zero) Maps.zeroMap
        (\fun (_: Simplices.Carrier (N.Nat^::succ (N.Nat^::succ n))) => \refl((space n).zero))));
\definition all: \forall (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) ->
  (boundary n).apply ((boundary (N.Nat^::succ n)).apply x) = (space n).zero :=
  \fun (x: _) => congr!{{Carrier (N.Nat^::succ (N.Nat^::succ n)) -> Carrier n} {Carrier n}}
    (\fun (f: Carrier (N.Nat^::succ (N.Nat^::succ n)) -> Carrier n) => f x) _ _ mapsEqual;
