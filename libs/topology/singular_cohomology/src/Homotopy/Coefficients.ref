\import \root.Cochains[A := B, source := target].With[coefficients := M] \as SourceCochains;
\import \root.Cochains[A := A, source := source].With[coefficients := M] \as TargetCochains;
\import Maps.Coefficients[M := M, L := M] \as Mapping;
\import Modules.End[V := M.Carrier, space := M.space] \as Coefficients;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Homotopy[P := Domain.complex, Q := Codomain.complex, N := M] \as Native;
\definition onCohomology: \forall (f, g: A -> B)(h: Family f g)(n: N.Nat^)(q: SourceCochains.cohomology n) ->
  #apply{(Mapping.At[n := n].induced g (endContinuous f g h) Coefficients.identity)} q =
    #apply{(Mapping.At[n := n].induced f (startContinuous f g h) Coefficients.identity)} q :=
  \fun (f, g: A -> B)(h: Family f g) => Native.onCohomology (Maps.push g (endContinuous f g h)) (Maps.push f (startContinuous f g h)) (homotopy f g h);
