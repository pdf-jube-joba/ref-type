\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := Domain.complex] \as SourceExtension;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := Codomain.complex] \as TargetExtension;
\import Native.ZeroExtension[f := Maps.push g (endContinuous f g h), g := Maps.push f (startContinuous f g h), h := homotopy f g h] \as Extension;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Integer;
\import Integer.Homotopy[C := SourceExtension.complex, D := TargetExtension.complex] \as Homotopies;
\definition integerHomotopy: Homotopies.Homotopy (Maps.integerPush g (endContinuous f g h)) (Maps.integerPush f (startContinuous f g h)) := Extension.homotopy;
\module At(z: I.Int^) {
  \import Integer.At[C := SourceExtension.complex, z := z] \as Source;
  \import Integer.At[C := TargetExtension.complex, z := z] \as Target;
  \import Integer.Map[C := SourceExtension.complex, D := TargetExtension.complex].At[k := z] \as Actions;
  \import Homotopies.At[k := z] \as Invariance;
  \definition law: \forall (q: Source.Homology) ->
    #apply{(Actions.induced (Maps.integerPush f (startContinuous f g h)))} q =
    #apply{(Actions.induced (Maps.integerPush g (endContinuous f g h)))} q :=
    \fun (q: Source.Homology) => sym!{Target.Homology} _ _
      (Invariance.onHomology (Maps.integerPush g (endContinuous f g h)) (Maps.integerPush f (startContinuous f g h)) integerHomotopy q);
}
