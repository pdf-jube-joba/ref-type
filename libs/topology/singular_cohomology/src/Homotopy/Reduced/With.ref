\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Integer[P := SourceReduced.complex, N := coefficients] \as SourceHom;
\import Hom.Integer[P := TargetReduced.complex, N := coefficients] \as TargetHom;
\import Hom.IntegerHomotopy[P := SourceReduced.complex, Q := TargetReduced.complex, N := coefficients] \as Invariance;
\import Hom.IntegerMapping[P := SourceReduced.complex, Q := TargetReduced.complex, N := coefficients, L := coefficients] \as Mapping;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import Cochains.Map[C := TargetHom.complex, D := SourceHom.complex] \as Pullbacks;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficients;
\definition pullback[f: A -> B][continuous: Maps.Continuous f]: Pullbacks.Map := Mapping.On[f := Push.map f continuous, u := Coefficients.identity].map;
\module At(z: I.Int^);
