\import Complexes.At[C := SourceReduced.complex, z := z] \as SourceH;
\import Complexes.At[C := TargetReduced.complex, z := z] \as TargetH;
\import Complexes.Map[C := SourceReduced.complex, D := TargetReduced.complex].At[k := z] \as Actions;
\import Homotopies.At[k := z] \as Invariance;
\definition law: \forall (f, g: A -> B)(h: Family f g)(q: SourceH.Homology) ->
  (Actions.induced (Push.map f (startContinuous f g h))).apply q = (Actions.induced (Push.map g (endContinuous f g h))).apply q :=
  \fun (f, g: A -> B)(h: Family f g)(q: SourceH.Homology) => sym!{TargetH.Homology} _ _
    (Invariance.onHomology (Push.map g (endContinuous f g h)) (Push.map f (startContinuous f g h)) (homotopy f g h) q);
