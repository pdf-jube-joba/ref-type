\import SourceHom.Cohomology[z := z] \as SourceH;
\import TargetHom.Cohomology[z := z] \as TargetH;
\import Pullbacks.At[k := z] \as Actions;
\definition law: \forall (f, g: A -> B)(h: Family f g)(q: TargetH.Cohomology) ->
  #apply{(Actions.induced (pullback f (startContinuous f g h)))} q = #apply{(Actions.induced (pullback g (endContinuous f g h)))} q :=
  \fun (f, g: A -> B)(h: Family f g)(q: TargetH.Cohomology) => sym!{SourceH.Cohomology} _ _
    (Invariance.onCohomology (Push.map g (endContinuous f g h)) (Push.map f (startContinuous f g h)) (homotopy f g h) z q);
