\definition degree: I.Int^ := I.Int^::negSucc N.Nat^::zero;
\import \parent.At[z := degree] \as Current;
\import algebra.Group[].Of[Carrier := I.Int^, group := Modules.scalarGroup] \as Group;
\import Codomain.Augmentation[] \as Augmentation;
\import Modules.Hom[V := Codomain.Carrier N.Nat^::zero, W := I.Int^, source := Codomain.space N.Nat^::zero, target := Modules.scalarModule] \as AugmentationMaps;
\definition rightZero: \forall (f, g: A -> B)(h: Family f g)(x: SourceReduced.Carrier degree) -> Current.rightHand f g h x = (Modules.scalarModule).zero :=
  \fun (f, g: A -> B)(h: Family f g)(x: SourceReduced.Carrier degree) => trans!{I.Int^} _ _ _
    (congr2!{I.Int^ I.Int^ I.Int^} ((Modules.scalarModule).add) _ _ _ _
      (Transport.castRefl TargetReduced.complex.family.Carrier degree ((Augmentation.map).apply (Codomain.space N.Nat^::zero).zero))
      (Transport.castRefl TargetReduced.complex.family.Carrier degree (Modules.scalarModule).zero))
    (trans!{I.Int^} _ _ _
      (congr!{I.Int^ I.Int^} (\fun (a: I.Int^) => (Modules.scalarModule).add a (Modules.scalarModule).zero) _ _ (AugmentationMaps.zeroPreserved Augmentation.map))
      (Group.zeroRight (Modules.scalarModule).zero));
\definition law: \forall (f, g: A -> B)(h: Family f g)(x: SourceReduced.Carrier degree) -> Current.leftHand f g h x = Current.rightHand f g h x :=
  \fun (f, g: A -> B)(h: Family f g)(x: SourceReduced.Carrier degree) => trans!{I.Int^} _ _ _ (Group.inverseRight x)
    (sym!{I.Int^} _ _ (rightZero f g h x));
