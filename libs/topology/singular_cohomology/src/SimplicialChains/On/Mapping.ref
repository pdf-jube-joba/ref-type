\import \root.SimplicialChains[].On[X := Y] \as Target;
\import algebraic_topology.Semisimplicial[].Maps[X := X, Y := Y] \as Simplicial;
\module At(n: N.Nat^) {
  \import Modules.Free[Generators := X.family.Carrier n].Reindex[TargetGenerators := Y.family.Carrier n] \as Reindex;
  \definition push(f: Simplicial.Map): Modules.Hom[V := Carrier n, W := Target.Carrier n, source := space n, target := Target.space n].Map := Reindex.push (#apply{f} n);
  \definition onGenerator: \forall (f: Simplicial.Map)(sigma: X.family.Carrier n) -> #apply{(push f)} (generator n sigma) = Target.generator n (#apply{f} n sigma) :=
    \fun (f: Simplicial.Map) => Reindex.onGenerator (#apply{f} n);
}
\module Differential(n: N.Nat^);
\definition map(f: Simplicial.Map): Complexes.Map[C := complex, D := Target.complex].Map := Complexes.Map[C := complex, D := Target.complex].Map {
  apply := \fun (n: N.Nat^) => #apply{(At[n := n].push f)},
  addition := \fun (n: N.Nat^) => #addition{(At[n := n].push f)},
  scalar := \fun (n: N.Nat^) => #scalar{(At[n := n].push f)},
  commutes := \fun (n: N.Nat^) => Differential[n := n].commutes f,
};
