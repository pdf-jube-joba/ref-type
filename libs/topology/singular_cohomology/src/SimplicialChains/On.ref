\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\module At(n: N.Nat^) {
  \import Modules.Free[Generators := X.family.Carrier n] \as Free;
  \definition Carrier: \Set := Free.Carrier;
  \definition space: Modules.Space Carrier := Free.space;
  \definition generator: X.family.Carrier n -> Carrier := Free.generator;
}
\definition Carrier(n: N.Nat^): \Set := At[n := n].Carrier;
\definition space(n: N.Nat^): Modules.Space (Carrier n) := At[n := n].space;
\definition generator(n: N.Nat^): X.family.Carrier n -> Carrier n := At[n := n].generator;
\module Boundary(n: N.Nat^) {
  \import Modules.Free[Generators := X.family.Carrier (N.Nat^::succ n)].To[W := Carrier n, target := space n] \as Extend;
  \import Modules.Alternating[V := Carrier n, space := space n] \as Sum;
  \definition onSimplex(sigma: X.family.Carrier (N.Nat^::succ n)): Carrier n := Sum.sum (N.Nat^::succ (N.Nat^::succ n))
    (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => generator n (X.faces.apply n i sigma));
  \definition map: Modules.Hom[V := Carrier (N.Nat^::succ n), W := Carrier n, source := space (N.Nat^::succ n), target := space n].Map := Extend.extension onSimplex;
  \definition onGenerator: \forall (sigma: X.family.Carrier (N.Nat^::succ n)) -> #apply{map} (generator (N.Nat^::succ n) sigma) = onSimplex sigma := Extend.onGenerator onSimplex;
}
\definition boundary(n: N.Nat^): Modules.Hom[V := Carrier (N.Nat^::succ n), W := Carrier n, source := space (N.Nat^::succ n), target := space n].Map := Boundary[n := n].map;
\module SquareZero(n: N.Nat^);
\definition family: Complexes.Family := Complexes.Family { Carrier := Carrier, space := space };
\definition differential: Complexes.DifferentialData[family] := Complexes.DifferentialData[family] { apply := \fun (n: N.Nat^) => #apply{(boundary n)} };
\definition complex: Complexes.Complex := Complexes.Complex {
  family := family, differential := differential,
  laws := Complexes.DifferentialLaws[family, differential] {
    addition := \fun (n: N.Nat^) => #addition{(boundary n)}, scalar := \fun (n: N.Nat^) => #scalar{(boundary n)}, squareZero := \fun (n: N.Nat^) => SquareZero[n := n].all,
  },
};
\module Mapping(Y: Semisimplicial.Object);
