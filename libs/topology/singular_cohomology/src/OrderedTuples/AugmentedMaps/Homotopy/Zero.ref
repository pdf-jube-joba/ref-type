\import \parent.At[n := N.Nat^::zero] \as Degree;
\import \parent.Empty[] \as Empty;
\import \parent.Values[n := N.Nat^::zero] \as Lower;
\import \parent.Values[n := N.Nat^::succ N.Nat^::zero] \as Values;
\import \parent.Filling[n := N.Nat^::zero] \as Filling;
\import Modules.Hom[V := Carrier (N.Nat^::succ N.Nat^::zero), W := Carrier N.Nat^::zero, source := space (N.Nat^::succ N.Nat^::zero), target := space N.Nat^::zero] \as Differential;
\definition onGenerator: Degree.OnGenerators := \fun (v: Tuple (N.Nat^::succ N.Nat^::zero)) => \block {
  \let x: Carrier (N.Nat^::succ N.Nat^::zero) := generator (N.Nat^::succ N.Nat^::zero) v \then
  \let d: Carrier N.Nat^::zero := #apply{(boundary N.Nat^::zero)} x \then
  \let a: Carrier (N.Nat^::succ N.Nat^::zero) := Values.difference (#apply{(f.component (N.Nat^::succ N.Nat^::zero))} x) (#apply{(g.component (N.Nat^::succ N.Nat^::zero))} x) \then
  \let w: Carrier (N.Nat^::succ N.Nat^::zero) := Values.difference a (#apply{(map N.Nat^::zero)} d) \then
  \let inner: w = a := trans!{{Carrier (N.Nat^::succ N.Nat^::zero)}} _ _ _
    (congr!{{Carrier (N.Nat^::succ N.Nat^::zero)} {Carrier (N.Nat^::succ N.Nat^::zero)}} (Values.difference a) _ _ (Empty.zero d)) (Values.minusZero a) \then
  \let closed: #apply{(boundary N.Nat^::zero)} w = Lower.zero := trans!{{Carrier N.Nat^::zero}} _ _ _
    (congr!{{Carrier (N.Nat^::succ N.Nat^::zero)} {Carrier N.Nat^::zero}} (#apply{(boundary N.Nat^::zero)}) _ _ inner)
    (trans!{{Carrier N.Nat^::zero}} _ _ _
      (Differential.differencePreserved (boundary N.Nat^::zero) (#apply{(f.component (N.Nat^::succ N.Nat^::zero))} x) (#apply{(g.component (N.Nat^::succ N.Nat^::zero))} x))
      (trans!{{Carrier N.Nat^::zero}} _ _ _
        (congr2!{{Carrier N.Nat^::zero} {Carrier N.Nat^::zero} {Carrier N.Nat^::zero}} Lower.difference _ _ _ _
          (trans!{{Carrier N.Nat^::zero}} _ _ _ (#commutes{f} N.Nat^::zero x) (#empty{f} d))
          (trans!{{Carrier N.Nat^::zero}} _ _ _ (#commutes{g} N.Nat^::zero x) (#empty{g} d)))
        (Lower.self d))) \then
  \return Filling.law (v (Fin.zero N.Nat^::zero)) w closed
};
