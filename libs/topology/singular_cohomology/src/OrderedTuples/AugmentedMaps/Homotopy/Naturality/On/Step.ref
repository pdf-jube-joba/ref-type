\import \parent.At[n := N.Nat^::succ n] \as Degree;
\import \parent.\parent.\parent.Values[n := N.Nat^::succ n] \as Values;
\import Other.Values[n := N.Nat^::succ n] \as FinalValues;
\import Modules.Hom[V := Carrier (N.Nat^::succ n), W := Codomain.Carrier (N.Nat^::succ n), source := space (N.Nat^::succ n), target := Codomain.space (N.Nat^::succ n)] \as Linear;
\definition law: Property n -> Degree.OnValues :=
  \fun (previous: Property n)(v: Tuple (N.Nat^::succ n)) => \block {
    \let x: Carrier (N.Nat^::succ n) := generator (N.Nat^::succ n) v \then
    \let y: Codomain.Carrier (N.Nat^::succ n) := Codomain.generator (N.Nat^::succ n) (Mapping.onTuple (N.Nat^::succ n) vertices v) \then
    \let p: Carrier (N.Nat^::succ n) := (map n).apply ((boundary n).apply x) \then
    \let w: Carrier (N.Nat^::succ n) := Values.difference (Values.difference ((f.component (N.Nat^::succ n)).apply x) ((g.component (N.Nat^::succ n)).apply x)) p \then
    \let mapped: (Mapping.push (N.Nat^::succ n) vertices).apply x = y := Mapping.At[n := N.Nat^::succ n].onGenerator vertices v \then
    \let sd: (Mapping.push (N.Nat^::succ n) vertices).apply ((f.component (N.Nat^::succ n)).apply x) = (targetFirst.component (N.Nat^::succ n)).apply y :=
      trans!{{Codomain.Carrier (N.Nat^::succ n)}} _ _ _ ((square).first (N.Nat^::succ n) x)
        (congr!{{Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)}} ((targetFirst.component (N.Nat^::succ n)).apply) _ _ mapped) \then
    \let gd: (Mapping.push (N.Nat^::succ n) vertices).apply ((g.component (N.Nat^::succ n)).apply x) = (targetSecond.component (N.Nat^::succ n)).apply y :=
      trans!{{Codomain.Carrier (N.Nat^::succ n)}} _ _ _ ((square).second (N.Nat^::succ n) x)
        (congr!{{Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)}} ((targetSecond.component (N.Nat^::succ n)).apply) _ _ mapped) \then
    \let shifted: (Mapping.push (N.Nat^::succ n) vertices).apply p = (Other.map n).apply ((Codomain.boundary n).apply y) :=
      trans!{{Codomain.Carrier (N.Nat^::succ n)}} _ _ _ (previous ((boundary n).apply x))
        (congr!{{Codomain.Carrier n} {Codomain.Carrier (N.Nat^::succ n)}} ((Other.map n).apply) _ _
          (trans!{{Codomain.Carrier n}} _ _ _ (sym!{{Codomain.Carrier n}} _ _ (Mapping.Boundary[n := n].commutes vertices x))
            (congr!{{Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier n}} ((Codomain.boundary n).apply) _ _ mapped))) \then
    \let inside: (Mapping.push (N.Nat^::succ n) vertices).apply w = FinalValues.difference (FinalValues.difference ((targetFirst.component (N.Nat^::succ n)).apply y) ((targetSecond.component (N.Nat^::succ n)).apply y)) ((Other.map n).apply ((Codomain.boundary n).apply y)) :=
      trans!{{Codomain.Carrier (N.Nat^::succ n)}} _ _ _ (Linear.differencePreserved (Mapping.push (N.Nat^::succ n) vertices) (Values.difference ((f.component (N.Nat^::succ n)).apply x) ((g.component (N.Nat^::succ n)).apply x)) p)
        (congr2!{{Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)}} FinalValues.difference _ _ _ _
          (trans!{{Codomain.Carrier (N.Nat^::succ n)}} _ _ _ (Linear.differencePreserved (Mapping.push (N.Nat^::succ n) vertices) ((f.component (N.Nat^::succ n)).apply x) ((g.component (N.Nat^::succ n)).apply x))
            (congr2!{{Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)}} FinalValues.difference _ _ _ _ sd gd)) shifted) \then
    \return trans!{{Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
      (Mapping.Cone[n := N.Nat^::succ n].law vertices (v (Fin.zero n)) w)
      (congr!{{Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))}} ((Codomain.cone (N.Nat^::succ n) (vertices (v (Fin.zero n)))).apply) _ _ inside)
  };
