\import Complexes.Homotopy[C := complex, D := complex] \as Native;
\import \parent.\parent.On[f := f] \as First;
\import \parent.\parent.On[f := g] \as Second;
\import \parent.Empty[] \as Empty;
\definition data: Native.Data := Native.Data { apply := \fun (n: N.Nat^) => (map (N.Nat^::succ n)).apply };
\import \parent.Values[n := N.Nat^::succ N.Nat^::zero] \as Values;
\definition zero: \forall (x: Carrier (N.Nat^::succ N.Nat^::zero)) -> Values.difference ((f.component (N.Nat^::succ N.Nat^::zero)).apply x) ((g.component (N.Nat^::succ N.Nat^::zero)).apply x) =
  (boundary (N.Nat^::succ N.Nat^::zero)).apply ((map (N.Nat^::succ N.Nat^::zero)).apply x) :=
  \fun (x: Carrier (N.Nat^::succ N.Nat^::zero)) => sym!{{Carrier (N.Nat^::succ N.Nat^::zero)}} _ _
    (trans!{{Carrier (N.Nat^::succ N.Nat^::zero)}} _ _ _ (boundaryLaw N.Nat^::zero x)
      (trans!{{Carrier (N.Nat^::succ N.Nat^::zero)}} _ _ _
        (congr!{{Carrier (N.Nat^::succ N.Nat^::zero)} {Carrier (N.Nat^::succ N.Nat^::zero)}} (Values.difference (Values.difference ((f.component (N.Nat^::succ N.Nat^::zero)).apply x) ((g.component (N.Nat^::succ N.Nat^::zero)).apply x))) _ _ (Empty.zero ((boundary N.Nat^::zero).apply x)))
        (Values.minusZero (Values.difference ((f.component (N.Nat^::succ N.Nat^::zero)).apply x) ((g.component (N.Nat^::succ N.Nat^::zero)).apply x)))));
\module Degree(n: N.Nat^) {
  \import \parent.\parent.Values[n := N.Nat^::succ (N.Nat^::succ n)] \as Values;
  \definition equation: \forall (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) ->
    Values.difference ((f.component (N.Nat^::succ (N.Nat^::succ n))).apply x) ((g.component (N.Nat^::succ (N.Nat^::succ n))).apply x) =
      Values.add ((boundary (N.Nat^::succ (N.Nat^::succ n))).apply ((map (N.Nat^::succ (N.Nat^::succ n))).apply x))
        ((map (N.Nat^::succ n)).apply ((boundary (N.Nat^::succ n)).apply x)) :=
    \fun (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) => sym!{{Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _
      (trans!{{Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
        (congr!{{Carrier (N.Nat^::succ (N.Nat^::succ n))} {Carrier (N.Nat^::succ (N.Nat^::succ n))}}
          (\fun (z: Carrier (N.Nat^::succ (N.Nat^::succ n))) => Values.add z ((map (N.Nat^::succ n)).apply ((boundary (N.Nat^::succ n)).apply x))) _ _ (boundaryLaw (N.Nat^::succ n) x))
        (Values.addDifference (Values.difference ((f.component (N.Nat^::succ (N.Nat^::succ n))).apply x) ((g.component (N.Nat^::succ (N.Nat^::succ n))).apply x))
          ((map (N.Nat^::succ n)).apply ((boundary (N.Nat^::succ n)).apply x))));
}
\definition homotopy: Native.Homotopy First.chainMap Second.chainMap :=
  \into[Native.Data](data, Native.Homotopy First.chainMap Second.chainMap) \by {
    Native.Laws[First.chainMap, Second.chainMap, data] {
      addition := \fun (n: N.Nat^) => (map (N.Nat^::succ n)).addition,
      scalar := \fun (n: N.Nat^) => (map (N.Nat^::succ n)).scalar,
      zeroEquation := zero,
      successorEquation := \fun (n: N.Nat^) => Degree[n := n].equation,
    }
  };
