\import Complexes.Homotopy[C := complex, D := complex] \as Native;
\import \parent.\parent.On[f := f] \as First;
\import \parent.\parent.On[f := g] \as Second;
\import \parent.Empty[] \as Empty;
\definition data: Native.Data := Native.Data { apply := \fun (n: N.Nat^) => #apply{(map (N.Nat^::succ n))} };
\import \parent.Values[n := N.Nat^::succ N.Nat^::zero] \as Values;
\definition zero: \forall (x: Carrier (N.Nat^::succ N.Nat^::zero)) -> Values.difference (#apply{(f.component (N.Nat^::succ N.Nat^::zero))} x) (#apply{(g.component (N.Nat^::succ N.Nat^::zero))} x) =
  #apply{(boundary (N.Nat^::succ N.Nat^::zero))} (#apply{(map (N.Nat^::succ N.Nat^::zero))} x) :=
  \fun (x: Carrier (N.Nat^::succ N.Nat^::zero)) => sym!{{Carrier (N.Nat^::succ N.Nat^::zero)}} _ _
    (trans!{{Carrier (N.Nat^::succ N.Nat^::zero)}} _ _ _ (boundaryLaw N.Nat^::zero x)
      (trans!{{Carrier (N.Nat^::succ N.Nat^::zero)}} _ _ _
        (congr!{{Carrier (N.Nat^::succ N.Nat^::zero)} {Carrier (N.Nat^::succ N.Nat^::zero)}} (Values.difference (Values.difference (#apply{(f.component (N.Nat^::succ N.Nat^::zero))} x) (#apply{(g.component (N.Nat^::succ N.Nat^::zero))} x))) _ _ (Empty.zero (#apply{(boundary N.Nat^::zero)} x)))
        (Values.minusZero (Values.difference (#apply{(f.component (N.Nat^::succ N.Nat^::zero))} x) (#apply{(g.component (N.Nat^::succ N.Nat^::zero))} x)))));
\module Degree(n: N.Nat^) {
  \import \parent.\parent.Values[n := N.Nat^::succ (N.Nat^::succ n)] \as Values;
  \definition equation: \forall (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) ->
    Values.difference (#apply{(f.component (N.Nat^::succ (N.Nat^::succ n)))} x) (#apply{(g.component (N.Nat^::succ (N.Nat^::succ n)))} x) =
      Values.add (#apply{(boundary (N.Nat^::succ (N.Nat^::succ n)))} (#apply{(map (N.Nat^::succ (N.Nat^::succ n)))} x))
        (#apply{(map (N.Nat^::succ n))} (#apply{(boundary (N.Nat^::succ n))} x)) :=
    \fun (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) => sym!{{Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _
      (trans!{{Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
        (congr!{{Carrier (N.Nat^::succ (N.Nat^::succ n))} {Carrier (N.Nat^::succ (N.Nat^::succ n))}}
          (\fun (z: Carrier (N.Nat^::succ (N.Nat^::succ n))) => Values.add z (#apply{(map (N.Nat^::succ n))} (#apply{(boundary (N.Nat^::succ n))} x))) _ _ (boundaryLaw (N.Nat^::succ n) x))
        (Values.addDifference (Values.difference (#apply{(f.component (N.Nat^::succ (N.Nat^::succ n)))} x) (#apply{(g.component (N.Nat^::succ (N.Nat^::succ n)))} x))
          (#apply{(map (N.Nat^::succ n))} (#apply{(boundary (N.Nat^::succ n))} x))));
}
\definition homotopy: Native.Homotopy First.chainMap Second.chainMap :=
  \into[Native.Data](data, Native.Homotopy First.chainMap Second.chainMap) \by {
    Native.Laws[First.chainMap, Second.chainMap, data] {
      addition := \fun (n: N.Nat^) => #addition{(map (N.Nat^::succ n))},
      scalar := \fun (n: N.Nat^) => #scalar{(map (N.Nat^::succ n))},
      zeroEquation := zero,
      successorEquation := \fun (n: N.Nat^) => Degree[n := n].equation,
    }
  };
