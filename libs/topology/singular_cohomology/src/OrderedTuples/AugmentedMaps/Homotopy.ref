\module Values(n: N.Nat^) {
  \import Modules.Laws[V := Carrier n, space := space n] \as Vector;
  \import algebra.Group[].Of[Carrier := Carrier n, group := Vector.additive] \as Group;
  \definition difference: Carrier n -> Carrier n -> Carrier n := Group.difference;
  \definition add: Carrier n -> Carrier n -> Carrier n := Vector.add;
  \definition zero: Carrier n := Vector.zero;
  \definition minusZero: \forall (x: Carrier n) -> difference x zero = x :=
    \fun (x: Carrier n) => trans!{{Carrier n}} _ _ _ (congr!{{Carrier n} {Carrier n}} (Vector.add x) _ _ Group.negZero) (Group.zeroRight x);
  \definition self: \forall (x: Carrier n) -> difference x x = zero := Group.inverseRight;
  \definition addDifference: _ := Group.addDifference;
}
\module Extension(n: N.Nat^) {
  \import Modules.Free[Generators := Tuple n].To[W := Carrier (N.Nat^::succ n), target := space (N.Nat^::succ n)] \as Free;
  \definition extend: (Tuple n -> Carrier (N.Nat^::succ n)) -> Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)].Map := Free.extension;
  \definition onGenerator: \forall (f: Tuple n -> Carrier (N.Nat^::succ n))(v: Tuple n) -> (extend f).apply (generator n v) = f v := Free.onGenerator;
}
\definition value: \forall (n: N.Nat^) -> Tuple n -> Carrier (N.Nat^::succ n) :=
  \induction (n: N.Nat^) \return Tuple n -> Carrier (N.Nat^::succ n) \with {
    | zero: \fun (_: Tuple N.Nat^::zero) => (space (N.Nat^::succ N.Nat^::zero)).zero
    | succ: \fun (n: N.Nat^)(previous: Tuple n -> Carrier (N.Nat^::succ n))(v: Tuple (N.Nat^::succ n)) =>
        (cone (N.Nat^::succ n) (v (Fin.zero n))).apply
          (Values[n := N.Nat^::succ n].difference
            (Values[n := N.Nat^::succ n].difference ((f.component (N.Nat^::succ n)).apply (generator (N.Nat^::succ n) v)) ((g.component (N.Nat^::succ n)).apply (generator (N.Nat^::succ n) v)))
            ((Extension[n := n].extend previous).apply ((boundary n).apply (generator (N.Nat^::succ n) v))))
  };
\definition map[n: N.Nat^]: Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)].Map := Extension[n := n].extend (value n);
\definition onGenerator: \forall (n: N.Nat^)(v: Tuple n) -> (map n).apply (generator n v) = value n v :=
  \fun (n: N.Nat^) => Extension[n := n].onGenerator (value n);
\definition Property[n: N.Nat^]: \Prop := \forall (x: Carrier (N.Nat^::succ n)) ->
  (boundary (N.Nat^::succ n)).apply ((map (N.Nat^::succ n)).apply x) =
    Values[n := N.Nat^::succ n].difference (Values[n := N.Nat^::succ n].difference ((f.component (N.Nat^::succ n)).apply x) ((g.component (N.Nat^::succ n)).apply x))
      ((map n).apply ((boundary n).apply x));
\module At(n: N.Nat^) {
  \import \parent.Values[n := N.Nat^::succ n] \as Values;
  \import Modules.Hom[V := Carrier (N.Nat^::succ n), W := Carrier (N.Nat^::succ n), source := space (N.Nat^::succ n), target := space (N.Nat^::succ n)] \as End;
  \import Modules.Hom[V := Carrier (N.Nat^::succ (N.Nat^::succ n)), W := Carrier (N.Nat^::succ n), source := space (N.Nat^::succ (N.Nat^::succ n)), target := space (N.Nat^::succ n)]
    .Composition[U := Carrier (N.Nat^::succ n), domain := space (N.Nat^::succ n)] \as First;
  \import Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)]
    .Composition[U := Carrier (N.Nat^::succ n), domain := space (N.Nat^::succ n)] \as Second;
  \import Modules.Free[Generators := Tuple (N.Nat^::succ n)].To[W := Carrier (N.Nat^::succ n), target := space (N.Nat^::succ n)] \as Free;
  \definition OnGenerators: \Prop := \forall (v: Tuple (N.Nat^::succ n)) ->
    (boundary (N.Nat^::succ n)).apply (value (N.Nat^::succ n) v) =
      Values.difference (Values.difference ((f.component (N.Nat^::succ n)).apply (generator (N.Nat^::succ n) v)) ((g.component (N.Nat^::succ n)).apply (generator (N.Nat^::succ n) v)))
        ((map n).apply ((boundary n).apply (generator (N.Nat^::succ n) v)));
  \definition extend: OnGenerators -> Property n := \block {
    \fun (generators: OnGenerators) \then
    \let same: First.compose (boundary (N.Nat^::succ n)) (map (N.Nat^::succ n)) =
      End.plus (End.plus (f.component (N.Nat^::succ n)) (End.negative (g.component (N.Nat^::succ n)))) (End.negative (Second.compose (map n) (boundary n))) :=
      Free.ext _ _ (\fun (v: Tuple (N.Nat^::succ n)) => trans!{{Carrier (N.Nat^::succ n)}} _ _ _
        (congr!{{Carrier (N.Nat^::succ (N.Nat^::succ n))} {Carrier (N.Nat^::succ n)}} ((boundary (N.Nat^::succ n)).apply) _ _ (onGenerator (N.Nat^::succ n) v)) (generators v)) \then
    \return \fun (x: Carrier (N.Nat^::succ n)) => congr!{End.Map {Carrier (N.Nat^::succ n)}} (\fun (f: End.Map) => (f).apply x) _ _ same
  };
}
\module Empty;
\module Filling(n: N.Nat^);
\module Zero;
\module Step(n: N.Nat^);
\definition boundaryLaw: \forall (n: N.Nat^) -> Property n :=
  \induction (n: N.Nat^) \return Property n \with {
    | zero: At[n := N.Nat^::zero].extend Zero[].onGenerator
    | succ: \fun (n: N.Nat^)(previous: Property n) => At[n := N.Nat^::succ n].extend (Step[n := n].onGenerator previous)
  };
\module Native;
\module Naturality(W: \Set, targetFirst, targetSecond: \root.OrderedTuples[V := W].AugmentedMaps[].Map);
