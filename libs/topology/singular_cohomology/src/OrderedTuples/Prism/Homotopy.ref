\import Complexes.Homotopy[C := Domain.complex, D := Codomain.complex] \as Native;
\definition data[f, g: V -> W]: Native.Data := Native.Data {
  apply := \fun (n: N.Nat^) => (map (N.Nat^::succ n) f g).apply,
};
\module Degree(n: N.Nat^) {
  \import \parent.\parent.Values[n := N.Nat^::succ (N.Nat^::succ n)] \as Values;
  \definition equation: \forall (f, g: V -> W)(x: Domain.Carrier (N.Nat^::succ (N.Nat^::succ n))) ->
    Values.difference ((Mapping.push (N.Nat^::succ (N.Nat^::succ n)) g).apply x) ((Mapping.push (N.Nat^::succ (N.Nat^::succ n)) f).apply x) =
      Values.add ((Codomain.boundary (N.Nat^::succ (N.Nat^::succ n))).apply ((map (N.Nat^::succ (N.Nat^::succ n)) f g).apply x))
        ((map (N.Nat^::succ n) f g).apply ((Domain.boundary (N.Nat^::succ n)).apply x)) :=
    \fun (f, g: V -> W)(x: Domain.Carrier (N.Nat^::succ (N.Nat^::succ n))) => sym!{{Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _
      (trans!{{Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
        (congr!{{Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))} {Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))}}
          (\fun (v: Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))) => Values.add v ((map (N.Nat^::succ n) f g).apply ((Domain.boundary (N.Nat^::succ n)).apply x))) _ _
          (boundaryLaw (N.Nat^::succ n) f g x))
        (Values.addDifference
          (Values.difference ((Mapping.push (N.Nat^::succ (N.Nat^::succ n)) g).apply x) ((Mapping.push (N.Nat^::succ (N.Nat^::succ n)) f).apply x))
          ((map (N.Nat^::succ n) f g).apply ((Domain.boundary (N.Nat^::succ n)).apply x))));
}
\definition homotopy[f, g: V -> W]: Native.Homotopy (Mapping.map g) (Mapping.map f) :=
  \into[Native.Data](data f g, Native.Homotopy (Mapping.map g) (Mapping.map f)) \by {
    Native.Laws[Mapping.map g, Mapping.map f, data f g] {
      addition := \fun (n: N.Nat^) => (map (N.Nat^::succ n) f g).addition,
      scalar := \fun (n: N.Nat^) => (map (N.Nat^::succ n) f g).scalar,
      zeroEquation := \fun (x: Domain.Carrier (N.Nat^::succ N.Nat^::zero)) =>
        sym!{{Codomain.Carrier (N.Nat^::succ N.Nat^::zero)}} _ _ (\parent.BoundaryZero[].withoutPrior f g x),
      successorEquation := \fun (n: N.Nat^) => Degree[n := n].equation f g,
    }
  };
