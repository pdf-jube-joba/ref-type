\import Modules.Hom[V := Domain.Carrier N.Nat^::zero, W := Codomain.Carrier (N.Nat^::succ N.Nat^::zero), source := Domain.space N.Nat^::zero, target := Codomain.space (N.Nat^::succ N.Nat^::zero)] \as Maps;
\import Modules.Free[Generators := Domain.Tuple N.Nat^::zero].To[W := Codomain.Carrier (N.Nat^::succ N.Nat^::zero), target := Codomain.space (N.Nat^::succ N.Nat^::zero)] \as Free;
\definition equation: \forall (f, g: V -> W) -> map N.Nat^::zero f g = Maps.zeroMap :=
  \fun (f, g: V -> W) => Free.ext _ _ (\parent.At[n := N.Nat^::zero].onGenerator f g);
\definition zero: \forall (f, g: V -> W)(x: Domain.Carrier N.Nat^::zero) -> #apply{(map N.Nat^::zero f g)} x = #zero{(Codomain.space (N.Nat^::succ N.Nat^::zero))} :=
  \fun (f, g: V -> W)(x: Domain.Carrier N.Nat^::zero) => congr!{Maps.Map {Codomain.Carrier (N.Nat^::succ N.Nat^::zero)}} (\fun (h: Maps.Map) => #apply{h} x) _ _ (equation f g);
\import Fin.Empty[A := W] \as EmptyTuples;
\import Modules.Hom[V := Domain.Carrier N.Nat^::zero, W := Codomain.Carrier N.Nat^::zero, source := Domain.space N.Nat^::zero, target := Codomain.space N.Nat^::zero] \as EmptyMaps;
\import Modules.Free[Generators := Domain.Tuple N.Nat^::zero].To[W := Codomain.Carrier N.Nat^::zero, target := Codomain.space N.Nat^::zero] \as FreeEmpty;
\definition mapsEqual: \forall (f, g: V -> W) -> Mapping.push N.Nat^::zero f = Mapping.push N.Nat^::zero g :=
  \fun (f, g: V -> W) => FreeEmpty.ext _ _ (\fun (v: Domain.Tuple N.Nat^::zero) => trans!{{Codomain.Carrier N.Nat^::zero}} _ _ _
    (Mapping.At[n := N.Nat^::zero].onGenerator f v)
    (trans!{{Codomain.Carrier N.Nat^::zero}} _ _ _
      (congr!{{Codomain.Tuple N.Nat^::zero} {Codomain.Carrier N.Nat^::zero}} (Codomain.generator N.Nat^::zero) _ _ (EmptyTuples.unique (Mapping.onTuple N.Nat^::zero f v) (Mapping.onTuple N.Nat^::zero g v)))
      (sym!{{Codomain.Carrier N.Nat^::zero}} _ _ (Mapping.At[n := N.Nat^::zero].onGenerator g v))));
\definition onEmpty: \forall (f, g: V -> W)(x: Domain.Carrier N.Nat^::zero) -> #apply{(Mapping.push N.Nat^::zero f)} x = #apply{(Mapping.push N.Nat^::zero g)} x :=
  \fun (f, g: V -> W)(x: Domain.Carrier N.Nat^::zero) => congr!{EmptyMaps.Map {Codomain.Carrier N.Nat^::zero}} (\fun (h: EmptyMaps.Map) => #apply{h} x) _ _ (mapsEqual f g);
