\definition zeroDegree: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zeroDegree;
\definition two: N.Nat^ := N.Nat^::succ one;
\import \parent.Values[n := one] \as Values;
\import \parent.Empty[] \as Empty;
\import \parent.Extended[n := zeroDegree] \as Recurrence;
\definition onCone: \forall (f, g: V -> W)(a: V)(x: Domain.Carrier zeroDegree) ->
  #apply{(Codomain.boundary one)} (#apply{(map one f g)} (#apply{(Domain.cone zeroDegree a)} x)) =
    Values.difference (#apply{(Mapping.push one g)} (#apply{(Domain.cone zeroDegree a)} x))
      (#apply{(Mapping.push one f)} (#apply{(Domain.cone zeroDegree a)} x)) :=
  \fun (f, g: V -> W)(a: V)(x: Domain.Carrier zeroDegree) => \block {
    \let u: Domain.Carrier one := #apply{(Domain.cone zeroDegree a)} x \then
    \let v: Codomain.Carrier one := #apply{(Mapping.push one g)} u \then
    \let pointValue: #apply{(map one f g)} u = #apply{(Codomain.cone one (f a))} v :=
      trans!{{Codomain.Carrier two}} _ _ _ (Recurrence.law f g a x)
        (congr!{{Codomain.Carrier one} {Codomain.Carrier two}} (#apply{(Codomain.cone one (f a))}) _ _
          (trans!{{Codomain.Carrier one}} _ _ _
            (congr!{{Codomain.Carrier one} {Codomain.Carrier one}} (Values.difference v) _ _ (Empty.zero f g x)) (Values.minusZero v))) \then
    \let dValue: #apply{(Codomain.boundary zeroDegree)} v = #apply{(Mapping.push zeroDegree g)} x :=
      trans!{{Codomain.Carrier zeroDegree}} _ _ _ (Mapping.Boundary[n := zeroDegree].commutes g u)
        (congr!{{Domain.Carrier zeroDegree} {Codomain.Carrier zeroDegree}} (#apply{(Mapping.push zeroDegree g)}) _ _ (Domain.Empty[].coneBoundary a x)) \then
    \let coneValue: #apply{(Codomain.cone zeroDegree (f a))} (#apply{(Codomain.boundary zeroDegree)} v) = #apply{(Mapping.push one f)} u :=
      trans!{{Codomain.Carrier one}} _ _ _
        (congr!{{Codomain.Carrier zeroDegree} {Codomain.Carrier one}} (#apply{(Codomain.cone zeroDegree (f a))}) _ _ dValue)
        (trans!{{Codomain.Carrier one}} _ _ _
          (congr!{{Codomain.Carrier zeroDegree} {Codomain.Carrier one}} (#apply{(Codomain.cone zeroDegree (f a))}) _ _ (Empty.onEmpty g f x))
          (sym!{{Codomain.Carrier one}} _ _ (Mapping.Cone[n := zeroDegree].law f a x))) \then
    \return trans!{{Codomain.Carrier one}} _ _ _
      (congr!{{Codomain.Carrier two} {Codomain.Carrier one}} (#apply{(Codomain.boundary one)}) _ _ pointValue)
      (trans!{{Codomain.Carrier one}} _ _ _ (Codomain.ConeBoundary[n := zeroDegree].law (f a) v)
        (congr!{{Codomain.Carrier one} {Codomain.Carrier one}} (Values.difference v) _ _ coneValue))
  };
\definition onGenerator: \forall (f, g: V -> W)(v: Domain.Tuple one) ->
  #apply{(Codomain.boundary one)} (#apply{(map one f g)} (Domain.generator one v)) =
    Values.difference (#apply{(Mapping.push one g)} (Domain.generator one v)) (#apply{(Mapping.push one f)} (Domain.generator one v)) :=
  \fun (f, g: V -> W)(v: Domain.Tuple one) =>
    \idelim #apply{(Domain.cone zeroDegree (v (Fin.zero zeroDegree)))} (Domain.generator zeroDegree (\fun (i: Fin.Fin zeroDegree) => v (Fin.succ zeroDegree i))) = Domain.generator one v
      \with x: Domain.Carrier one => #apply{(Codomain.boundary one)} (#apply{(map one f g)} x) = Values.difference (#apply{(Mapping.push one g)} x) (#apply{(Mapping.push one f)} x) \by {
        base: onCone f g (v (Fin.zero zeroDegree)) (Domain.generator zeroDegree (\fun (i: Fin.Fin zeroDegree) => v (Fin.succ zeroDegree i))),
        equality: trans!{{Domain.Carrier one}} _ _ _ (Domain.Cone[n := zeroDegree].onGenerator (v (Fin.zero zeroDegree)) (\fun (i: Fin.Fin zeroDegree) => v (Fin.succ zeroDegree i)))
          (congr!{{Domain.Tuple one} {Domain.Carrier one}} (Domain.generator one) _ _ (Tuples.recover zeroDegree v))
      };
\import Modules.Hom[V := Codomain.Carrier two, W := Codomain.Carrier one, source := Codomain.space two, target := Codomain.space one]
  .Composition[U := Domain.Carrier one, domain := Domain.space one] \as Composition;
\import Modules.Hom[V := Domain.Carrier one, W := Codomain.Carrier one, source := Domain.space one, target := Codomain.space one] \as Maps;
\import Modules.Free[Generators := Domain.Tuple one].To[W := Codomain.Carrier one, target := Codomain.space one] \as Free;
\definition equation: \forall (f, g: V -> W) -> Composition.compose (Codomain.boundary one) (map one f g) = Maps.plus (Mapping.push one g) (Maps.negative (Mapping.push one f)) :=
  \fun (f, g: V -> W) => Free.ext _ _ (onGenerator f g);
\definition withoutPrior: \forall (f, g: V -> W)(x: Domain.Carrier one) ->
  #apply{(Codomain.boundary one)} (#apply{(map one f g)} x) = Values.difference (#apply{(Mapping.push one g)} x) (#apply{(Mapping.push one f)} x) :=
  \fun (f, g: V -> W)(x: Domain.Carrier one) => congr!{Maps.Map {Codomain.Carrier one}} (\fun (h: Maps.Map) => #apply{h} x) _ _ (equation f g);
\definition law: \forall (f, g: V -> W)(x: Domain.Carrier one) ->
  #apply{(Codomain.boundary one)} (#apply{(map one f g)} x) = Values.difference
    (Values.difference (#apply{(Mapping.push one g)} x) (#apply{(Mapping.push one f)} x)) (#apply{(map zeroDegree f g)} (#apply{(Domain.boundary zeroDegree)} x)) :=
  \fun (f, g: V -> W)(x: Domain.Carrier one) => trans!{{Codomain.Carrier one}} _ _ _ (withoutPrior f g x)
    (sym!{{Codomain.Carrier one}} _ _ (trans!{{Codomain.Carrier one}} _ _ _
      (congr!{{Codomain.Carrier one} {Codomain.Carrier one}} (Values.difference (Values.difference (#apply{(Mapping.push one g)} x) (#apply{(Mapping.push one f)} x))) _ _ (Empty.zero f g (#apply{(Domain.boundary zeroDegree)} x)))
      (Values.minusZero (Values.difference (#apply{(Mapping.push one g)} x) (#apply{(Mapping.push one f)} x)))));
