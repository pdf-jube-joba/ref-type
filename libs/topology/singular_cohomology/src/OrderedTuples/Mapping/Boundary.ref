\use Equality.eq_reason;
\import \parent.At[n := n] \as Lower;
\import \parent.At[n := N.Nat^::succ n] \as Higher;
\import Domain.Boundary[n := n] \as SourceBoundary;
\import Codomain.Boundary[n := n] \as TargetBoundary;
\import Modules.Alternating[V := Codomain.Carrier n, space := Codomain.space n] \as Sum;
\import Modules.Alternating[V := Domain.Carrier n, space := Domain.space n].Mapping[W := Codomain.Carrier n, target := Codomain.space n] \as Mapping;
\import Modules.Hom[V := Codomain.Carrier (N.Nat^::succ n), W := Codomain.Carrier n, source := Codomain.space (N.Nat^::succ n), target := Codomain.space n]
  .Composition[U := Domain.Carrier (N.Nat^::succ n), domain := Domain.space (N.Nat^::succ n)] \as First;
\import Modules.Hom[V := Domain.Carrier n, W := Codomain.Carrier n, source := Domain.space n, target := Codomain.space n]
  .Composition[U := Domain.Carrier (N.Nat^::succ n), domain := Domain.space (N.Nat^::succ n)] \as Second;
\import Modules.Free[Generators := Domain.Tuple (N.Nat^::succ n)].To[W := Codomain.Carrier n, target := Codomain.space n] \as Free;
\definition onGenerator: \forall (f: V -> W)(v: Domain.Tuple (N.Nat^::succ n)) ->
  #apply{(Second.compose (Lower.push f) (Domain.boundary n))} (Domain.generator (N.Nat^::succ n) v) =
    #apply{(First.compose (Codomain.boundary n) (Higher.push f))} (Domain.generator (N.Nat^::succ n) v) :=
  \fun (f: V -> W)(v: Domain.Tuple (N.Nat^::succ n)) => eq_reason!{
    {#apply{(Lower.push f)} (#apply{(Domain.boundary n)} (Domain.generator (N.Nat^::succ n) v))}
    "=" {#apply{(Lower.push f)} (SourceBoundary.value v)} "by" {
      congr!{{Domain.Carrier n} {Codomain.Carrier n}} (#apply{(Lower.push f)}) _ _ (SourceBoundary.onGenerator v)}
    "=" {Sum.sum (N.Nat^::succ n) (\fun (i: Fin.Fin (N.Nat^::succ n)) => #apply{(Lower.push f)} (Domain.generator n (Omission.omit n i v)))} "by" {
      Mapping.law (Lower.push f) (N.Nat^::succ n) (\fun (i: Fin.Fin (N.Nat^::succ n)) => Domain.generator n (Omission.omit n i v))}
    "=" {TargetBoundary.value (onTuple (N.Nat^::succ n) f v)} "by" {
      Sum.congruent (N.Nat^::succ n) _ _ (\fun (i: Fin.Fin (N.Nat^::succ n)) => trans!{{Codomain.Carrier n}} _ _ _
        (Lower.onGenerator f (Omission.omit n i v))
        (congr!{{Codomain.Tuple n} {Codomain.Carrier n}} (Codomain.generator n) _ _ (faceNaturality n f i v)))}
    "=" {#apply{(Codomain.boundary n)} (Codomain.generator (N.Nat^::succ n) (onTuple (N.Nat^::succ n) f v))} "by" {
      sym!{{Codomain.Carrier n}} _ _ (TargetBoundary.onGenerator (onTuple (N.Nat^::succ n) f v))}
    "=" {#apply{(Codomain.boundary n)} (#apply{(Higher.push f)} (Domain.generator (N.Nat^::succ n) v))} "by" {
      congr!{{Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier n}} (#apply{(Codomain.boundary n)}) _ _ (sym!{{Codomain.Carrier (N.Nat^::succ n)}} _ _ (Higher.onGenerator f v))}
  };
\definition equation: \forall (f: V -> W) -> First.compose (Codomain.boundary n) (Higher.push f) = Second.compose (Lower.push f) (Domain.boundary n) :=
  \fun (f: V -> W) => Free.ext _ _ (\fun (v: Domain.Tuple (N.Nat^::succ n)) => sym!{{Codomain.Carrier n}} _ _ (onGenerator f v));
\import Modules.Hom[V := Domain.Carrier (N.Nat^::succ n), W := Codomain.Carrier n, source := Domain.space (N.Nat^::succ n), target := Codomain.space n] \as Maps;
\definition commutes: \forall (f: V -> W)(x: Domain.Carrier (N.Nat^::succ n)) ->
  #apply{(Codomain.boundary n)} (#apply{(push (N.Nat^::succ n) f)} x) = #apply{(push n f)} (#apply{(Domain.boundary n)} x) :=
  \fun (f: V -> W)(x: Domain.Carrier (N.Nat^::succ n)) => congr!{Maps.Map {Codomain.Carrier n}} (\fun (h: Maps.Map) => #apply{h} x) _ _ (equation f);
