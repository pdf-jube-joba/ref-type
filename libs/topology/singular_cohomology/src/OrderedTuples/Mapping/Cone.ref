\use Equality.eq_reason;
\import Fin.Tuples[A := W] \as TargetTuples;
\import Modules.Hom[V := Codomain.Carrier n, W := Codomain.Carrier (N.Nat^::succ n), source := Codomain.space n, target := Codomain.space (N.Nat^::succ n)]
  .Composition[U := Domain.Carrier n, domain := Domain.space n] \as First;
\import Modules.Hom[V := Domain.Carrier (N.Nat^::succ n), W := Codomain.Carrier (N.Nat^::succ n), source := Domain.space (N.Nat^::succ n), target := Codomain.space (N.Nat^::succ n)]
  .Composition[U := Domain.Carrier n, domain := Domain.space n] \as Second;
\import Modules.Free[Generators := Domain.Tuple n].To[W := Codomain.Carrier (N.Nat^::succ n), target := Codomain.space (N.Nat^::succ n)] \as Free;
\definition onGenerator: \forall (f: V -> W)(a: V)(v: Domain.Tuple n) ->
  (push (N.Nat^::succ n) f).apply ((Domain.cone n a).apply (Domain.generator n v)) =
    (Codomain.cone n (f a)).apply ((push n f).apply (Domain.generator n v)) :=
  \fun (f: V -> W)(a: V)(v: Domain.Tuple n) => eq_reason!{
    {(push (N.Nat^::succ n) f).apply ((Domain.cone n a).apply (Domain.generator n v))}
    "=" {(push (N.Nat^::succ n) f).apply (Domain.generator (N.Nat^::succ n) (Tuples.extend n a v))} "by" {
      congr!{{Domain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)}} ((push (N.Nat^::succ n) f).apply) _ _ (Domain.Cone[n := n].onGenerator a v)}
    "=" {Codomain.generator (N.Nat^::succ n) (onTuple (N.Nat^::succ n) f (Tuples.extend n a v))} "by" {
      \parent.At[n := N.Nat^::succ n].onGenerator f (Tuples.extend n a v)}
    "=" {Codomain.generator (N.Nat^::succ n) (TargetTuples.extend n (f a) (onTuple n f v))} "by" {
      congr!{{Codomain.Tuple (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)}} (Codomain.generator (N.Nat^::succ n)) _ _ (TupleMaps.extendMap n f a v)}
    "=" {(Codomain.cone n (f a)).apply (Codomain.generator n (onTuple n f v))} "by" {
      sym!{{Codomain.Carrier (N.Nat^::succ n)}} _ _ (Codomain.Cone[n := n].onGenerator (f a) (onTuple n f v))}
    "=" {(Codomain.cone n (f a)).apply ((push n f).apply (Domain.generator n v))} "by" {
      congr!{{Codomain.Carrier n} {Codomain.Carrier (N.Nat^::succ n)}} ((Codomain.cone n (f a)).apply) _ _ (sym!{{Codomain.Carrier n}} _ _ (\parent.At[n := n].onGenerator f v))}
  };
\definition equation: \forall (f: V -> W)(a: V) -> Second.compose (push (N.Nat^::succ n) f) (Domain.cone n a) = First.compose (Codomain.cone n (f a)) (push n f) :=
  \fun (f: V -> W)(a: V) => Free.ext _ _ (onGenerator f a);
\import Modules.Hom[V := Domain.Carrier n, W := Codomain.Carrier (N.Nat^::succ n), source := Domain.space n, target := Codomain.space (N.Nat^::succ n)] \as Maps;
\definition law: \forall (f: V -> W)(a: V)(x: Domain.Carrier n) ->
  (push (N.Nat^::succ n) f).apply ((Domain.cone n a).apply x) = (Codomain.cone n (f a)).apply ((push n f).apply x) :=
  \fun (f: V -> W)(a: V)(x: Domain.Carrier n) => congr!{Maps.Map {Codomain.Carrier (N.Nat^::succ n)}} (\fun (h: Maps.Map) => (h).apply x) _ _ (equation f a);
