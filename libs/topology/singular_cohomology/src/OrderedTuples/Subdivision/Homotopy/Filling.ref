\import \root.OrderedTuples[V := V].ConeBoundary[n := n] \as ConeBoundary;
\import \parent.Values[n := N.Nat^::succ n] \as Values;
\import Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)] \as Linear;
\definition law: \forall (a: V)(w: Carrier (N.Nat^::succ n)) -> #apply{(boundary n)} w = #zero{(space n)} ->
  #apply{(boundary (N.Nat^::succ n))} (#apply{(cone (N.Nat^::succ n) a)} w) = w :=
  \fun (a: V)(w: Carrier (N.Nat^::succ n))(closed: #apply{(boundary n)} w = #zero{(space n)}) =>
    trans!{{Carrier (N.Nat^::succ n)}} _ _ _ (ConeBoundary.law a w)
      (trans!{{Carrier (N.Nat^::succ n)}} _ _ _
        (congr!{{Carrier n} {Carrier (N.Nat^::succ n)}} (\fun (x: Carrier n) => Values.difference w (#apply{(cone n a)} x)) _ _ closed)
        (trans!{{Carrier (N.Nat^::succ n)}} _ _ _
          (congr!{{Carrier (N.Nat^::succ n)} {Carrier (N.Nat^::succ n)}} (Values.difference w) _ _ (Linear.zeroPreserved (cone n a)))
          (Values.minusZero w)));
