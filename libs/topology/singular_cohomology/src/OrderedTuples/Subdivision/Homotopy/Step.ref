\import \parent.At[n := N.Nat^::succ n] \as Degree;
\import \parent.Values[n := N.Nat^::succ n] \as Lower;
\import \parent.Values[n := N.Nat^::succ (N.Nat^::succ n)] \as Values;
\import \parent.Filling[n := N.Nat^::succ n] \as Filling;
\import \root.OrderedTuples[V := V].SquareZero[n := n] \as SquareZero;
\import Modules.Hom[V := Carrier (N.Nat^::succ (N.Nat^::succ n)), W := Carrier (N.Nat^::succ n), source := space (N.Nat^::succ (N.Nat^::succ n)), target := space (N.Nat^::succ n)] \as Differential;
\import Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)] \as Shift;
\definition onGenerator: Property n -> Degree.OnGenerators :=
  \fun (previous: Property n)(v: Tuple (N.Nat^::succ (N.Nat^::succ n))) => \block {
    \let x: Carrier (N.Nat^::succ (N.Nat^::succ n)) := generator (N.Nat^::succ (N.Nat^::succ n)) v \then
    \let d: Carrier (N.Nat^::succ n) := (boundary (N.Nat^::succ n)).apply x \then
    \let a: Carrier (N.Nat^::succ (N.Nat^::succ n)) := Values.difference ((Subdivision.map (N.Nat^::succ (N.Nat^::succ n))).apply x) x \then
    \let b: Carrier (N.Nat^::succ n) := Lower.difference ((Subdivision.map (N.Nat^::succ n)).apply d) d \then
    \let p: Carrier (N.Nat^::succ (N.Nat^::succ n)) := (map (N.Nat^::succ n)).apply d \then
    \let w: Carrier (N.Nat^::succ (N.Nat^::succ n)) := Values.difference a p \then
    \let square: (map n).apply ((boundary n).apply d) = Lower.zero := trans!{{Carrier (N.Nat^::succ n)}} _ _ _
      (congr!{{Carrier n} {Carrier (N.Nat^::succ n)}} ((map n).apply) _ _ (SquareZero.all x)) (Shift.zeroPreserved (map n)) \then
    \let first: (boundary (N.Nat^::succ n)).apply a = b := trans!{{Carrier (N.Nat^::succ n)}} _ _ _
      (Differential.differencePreserved (boundary (N.Nat^::succ n)) ((Subdivision.map (N.Nat^::succ (N.Nat^::succ n))).apply x) x)
      (congr!{{Carrier (N.Nat^::succ n)} {Carrier (N.Nat^::succ n)}} (\fun (z: Carrier (N.Nat^::succ n)) => Lower.difference z d) _ _ (Subdivision.commutes (N.Nat^::succ n) x)) \then
    \let second: (boundary (N.Nat^::succ n)).apply p = b := trans!{{Carrier (N.Nat^::succ n)}} _ _ _ (previous d)
      (trans!{{Carrier (N.Nat^::succ n)}} _ _ _ (congr!{{Carrier (N.Nat^::succ n)} {Carrier (N.Nat^::succ n)}} (Lower.difference b) _ _ square) (Lower.minusZero b)) \then
    \let closed: (boundary (N.Nat^::succ n)).apply w = Lower.zero := trans!{{Carrier (N.Nat^::succ n)}} _ _ _
      (Differential.differencePreserved (boundary (N.Nat^::succ n)) a p)
      (trans!{{Carrier (N.Nat^::succ n)}} _ _ _
        (congr2!{{Carrier (N.Nat^::succ n)} {Carrier (N.Nat^::succ n)} {Carrier (N.Nat^::succ n)}} Lower.difference _ _ _ _ first second) (Lower.self b)) \then
    \return Filling.law (v (Fin.zero (N.Nat^::succ n))) w closed
  };
