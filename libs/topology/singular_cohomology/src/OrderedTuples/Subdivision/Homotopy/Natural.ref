\import \root.OrderedTuples[V := V] \as Domain;
\import \root.OrderedTuples[V := W] \as Codomain;
\import Domain.Mapping[W := W] \as Mapping;
\import Domain.Subdivision[centres := centres].Natural[W := W, targetCentres := targetCentres] \as Means;
\import Codomain.Subdivision[centres := targetCentres] \as OtherSubdivision;
\import OtherSubdivision.Homotopy[] \as Other;
\definition Property[n: N.Nat^]: \Prop := \forall (f: V -> W) -> Means.Preserves f -> \forall (x: Carrier n) ->
  (Mapping.push (N.Nat^::succ n) f).apply ((map n).apply x) = (Other.map n).apply ((Mapping.push n f).apply x);
\module At(n: N.Nat^) {
  \import Modules.Hom[V := Carrier (N.Nat^::succ n), W := Codomain.Carrier (N.Nat^::succ n), source := space (N.Nat^::succ n), target := Codomain.space (N.Nat^::succ n)].Composition[U := Carrier n, domain := space n] \as First;
  \import Modules.Hom[V := Codomain.Carrier n, W := Codomain.Carrier (N.Nat^::succ n), source := Codomain.space n, target := Codomain.space (N.Nat^::succ n)].Composition[U := Carrier n, domain := space n] \as Second;
  \import Modules.Free[Generators := Tuple n].To[W := Codomain.Carrier (N.Nat^::succ n), target := Codomain.space (N.Nat^::succ n)] \as Free;
  \import Modules.Hom[V := Carrier n, W := Codomain.Carrier (N.Nat^::succ n), source := space n, target := Codomain.space (N.Nat^::succ n)] \as Maps;
  \definition OnValues: \Prop := \forall (f: V -> W) -> Means.Preserves f -> \forall (v: Tuple n) ->
    (Mapping.push (N.Nat^::succ n) f).apply (value n v) = Other.value n (Mapping.onTuple n f v);
  \definition extend: OnValues -> Property n := \block {
    \fun (values: OnValues)(f: V -> W)(preserves: Means.Preserves f) \then
    \let same: First.compose (Mapping.push (N.Nat^::succ n) f) (map n) = Second.compose (Other.map n) (Mapping.push n f) :=
      Free.ext _ _ (\fun (v: Tuple n) => trans!{{Codomain.Carrier (N.Nat^::succ n)}} _ _ _
        (congr!{{Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)}} ((Mapping.push (N.Nat^::succ n) f).apply) _ _ (onGenerator n v))
        (trans!{{Codomain.Carrier (N.Nat^::succ n)}} _ _ _ (values f preserves v)
          (trans!{{Codomain.Carrier (N.Nat^::succ n)}} _ _ _ (sym!{{Codomain.Carrier (N.Nat^::succ n)}} _ _ (Other.onGenerator n (Mapping.onTuple n f v)))
            (congr!{{Codomain.Carrier n} {Codomain.Carrier (N.Nat^::succ n)}} ((Other.map n).apply) _ _ (sym!{{Codomain.Carrier n}} _ _ (Mapping.At[n := n].onGenerator f v)))))) \then
    \return \fun (x: Carrier n) => congr!{Maps.Map {Codomain.Carrier (N.Nat^::succ n)}} (\fun (arrow: Maps.Map) => (arrow).apply x) _ _ same
  };
}
\module Step(n: N.Nat^);
\import Modules.Hom[V := Carrier (N.Nat^::succ N.Nat^::zero), W := Codomain.Carrier (N.Nat^::succ N.Nat^::zero), source := space (N.Nat^::succ N.Nat^::zero), target := Codomain.space (N.Nat^::succ N.Nat^::zero)] \as ZeroMaps;
\definition law: \forall (n: N.Nat^) -> Property n :=
  \induction (n: N.Nat^) \return Property n \with {
    | zero: At[n := N.Nat^::zero].extend (\fun (f: V -> W)(preserves: Means.Preserves f)(v: Tuple N.Nat^::zero) => ZeroMaps.zeroPreserved (Mapping.push (N.Nat^::succ N.Nat^::zero) f))
    | succ: \fun (n: N.Nat^)(previous: Property n) => At[n := N.Nat^::succ n].extend (Step[n := n].law previous)
  };
