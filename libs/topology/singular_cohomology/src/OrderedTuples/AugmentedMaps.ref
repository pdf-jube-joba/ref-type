\structure Data: \Set {
  component: \forall (n: N.Nat^) -> Modules.Hom[V := Carrier n, W := Carrier n, source := space n, target := space n].Map,
}
\structure Laws[data: Data]: \Prop {
  commutes: \forall (n: N.Nat^)(x: Carrier (N.Nat^::succ n)) ->
    #apply{(boundary n)} (#apply{(data.component (N.Nat^::succ n))} x) = #apply{(data.component n)} (#apply{(boundary n)} x),
  empty: \forall (x: Carrier N.Nat^::zero) -> #apply{(data.component N.Nat^::zero)} x = x,
}
\definition Map: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module On(f: Map) {
  \import Complexes.Map[C := complex, D := complex] \as Native;
  \definition chainMap: Native.Map := Native.Map {
    apply := \fun (n: N.Nat^) => #apply{(f.component (N.Nat^::succ n))},
    addition := \fun (n: N.Nat^) => #addition{(f.component (N.Nat^::succ n))},
    scalar := \fun (n: N.Nat^) => #scalar{(f.component (N.Nat^::succ n))},
    commutes := \fun (n: N.Nat^) => #commutes{f} (N.Nat^::succ n),
  };
}
\module Homotopy(f, g: Map);
