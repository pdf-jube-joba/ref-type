\use Equality.eq_reason;
\import \parent.Boundary[n := n] \as Lower;
\import \parent.Boundary[n := N.Nat^::succ n] \as Higher;
\import Modules.Alternating[V := Carrier n, space := space n] \as Sum;
\import Modules.Alternating[V := Carrier (N.Nat^::succ n), space := space (N.Nat^::succ n)].Mapping[W := Carrier n, target := space n] \as Mapping;
\definition onGenerator: \forall (v: Tuple (N.Nat^::succ (N.Nat^::succ n))) ->
  (boundary n).apply ((boundary (N.Nat^::succ n)).apply (generator (N.Nat^::succ (N.Nat^::succ n)) v)) = (space n).zero :=
  \fun (v: Tuple (N.Nat^::succ (N.Nat^::succ n))) => eq_reason!{
    {(boundary n).apply ((boundary (N.Nat^::succ n)).apply (generator (N.Nat^::succ (N.Nat^::succ n)) v))}
    "=" {(boundary n).apply (Higher.value v)} "by" {
      congr!{{Carrier (N.Nat^::succ n)} {Carrier n}} ((boundary n).apply) _ _ (Higher.onGenerator v)}
    "=" {Sum.sum (N.Nat^::succ (N.Nat^::succ n)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => (boundary n).apply (generator (N.Nat^::succ n) (Omission.omit (N.Nat^::succ n) i v)))} "by" {
      Mapping.law (boundary n) (N.Nat^::succ (N.Nat^::succ n)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => generator (N.Nat^::succ n) (Omission.omit (N.Nat^::succ n) i v))}
    "=" {Sum.sum (N.Nat^::succ (N.Nat^::succ n)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) =>
      Sum.sum (N.Nat^::succ n) (\fun (j: Fin.Fin (N.Nat^::succ n)) => generator n (Omission.omit n j (Omission.omit (N.Nat^::succ n) i v))))} "by" {
        Sum.congruent (N.Nat^::succ (N.Nat^::succ n)) _ _ (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => Lower.onGenerator (Omission.omit (N.Nat^::succ n) i v))}
    "=" {(space n).zero} "by" {
      Sum.doubleZero (N.Nat^::succ n)
        (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(j: Fin.Fin (N.Nat^::succ n)) => generator n (Omission.omit n j (Omission.omit (N.Nat^::succ n) i v)))
        (\fun (i, j: Fin.Fin (N.Nat^::succ n))(ordered: _) => congr!{{Tuple n} {Carrier n}} (generator n) _ _ (Omission.interchange n i j v ordered))}
  };
\import Modules.Hom[V := Carrier (N.Nat^::succ n), W := Carrier n, source := space (N.Nat^::succ n), target := space n]
  .Composition[U := Carrier (N.Nat^::succ (N.Nat^::succ n)), domain := space (N.Nat^::succ (N.Nat^::succ n))] \as Composition;
\import Modules.Hom[V := Carrier (N.Nat^::succ (N.Nat^::succ n)), W := Carrier n, source := space (N.Nat^::succ (N.Nat^::succ n)), target := space n] \as Maps;
\import Modules.Free[Generators := Tuple (N.Nat^::succ (N.Nat^::succ n))].To[W := Carrier n, target := space n] \as Free;
\definition equation: Composition.compose (boundary n) (boundary (N.Nat^::succ n)) = Maps.zeroMap := Free.ext _ _ onGenerator;
\definition all: \forall (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) -> (boundary n).apply ((boundary (N.Nat^::succ n)).apply x) = (space n).zero :=
  \fun (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) => congr!{Maps.Map {Carrier n}} (\fun (f: Maps.Map) => (f).apply x) _ _ equation;
