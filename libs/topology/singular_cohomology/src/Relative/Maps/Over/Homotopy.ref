\import \root.Homotopy[A := A, B := B, source := source, target := target] \as Whole;
\import algebraic_topology.Cylinder[A := A] \as Cylinder;
\import algebraic_topology.Interval[] \as Interval;
\definition Family: \Set := Whole.Family f g;
\definition Preserves(h: Family): \Prop := \forall (t: Interval.Carrier)(x: SubspaceCarrier) -> \In[B] targetSubset (h (Cylinder.at t x));
\definition Homotopy: \Set := \Cast[Family] ({ h: Family \where Preserves h });
\module On(h: Homotopy);
