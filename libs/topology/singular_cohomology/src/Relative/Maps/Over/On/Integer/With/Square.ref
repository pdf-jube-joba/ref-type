\definition inclusion: \forall (h: SourceRelative.Carrier z) ->
  (WholePull.map).apply z ((SourceSequence.inclusion).apply z h) = (TargetSequence.inclusion).apply z ((pullback).apply z h) :=
  \fun (h: SourceRelative.Carrier z) => TargetWhole.At[z := z].ext
    ((WholePull.map).apply z ((SourceSequence.inclusion).apply z h)) ((TargetSequence.inclusion).apply z ((pullback).apply z h))
    (\fun (x: WholeExtension.Carrier z) => congr!{{TargetPair.Carrier z} coefficients.Carrier} ((h).apply) _ _
      (sym!{{TargetPair.Carrier z}} _ _ (QuotientMap.At[k := z].onClass compatible x)));
\definition restriction: \forall (h: SourceWhole.Carrier z) ->
  (TargetSequence.restriction).apply z ((WholePull.map).apply z h) = (SubspacePull.map).apply z ((SourceSequence.restriction).apply z h) :=
  \fun (h: SourceWhole.Carrier z) => TargetSub.At[z := z].ext
    ((TargetSequence.restriction).apply z ((WholePull.map).apply z h)) ((SubspacePull.map).apply z ((SourceSequence.restriction).apply z h))
    (\fun (x: SubspaceExtension.Carrier z) => congr!{{TargetWholeExtension.Carrier z} coefficients.Carrier} ((h).apply) _ _ (compatible z x));
