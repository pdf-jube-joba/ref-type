\definition inclusion: \forall (h: SourceRelative.Carrier z) ->
  #apply{WholePull.map} z (#apply{SourceSequence.inclusion} z h) = #apply{TargetSequence.inclusion} z (#apply{pullback} z h) :=
  \fun (h: SourceRelative.Carrier z) => TargetWhole.At[z := z].ext
    (#apply{WholePull.map} z (#apply{SourceSequence.inclusion} z h)) (#apply{TargetSequence.inclusion} z (#apply{pullback} z h))
    (\fun (x: WholeExtension.Carrier z) => congr!{{TargetPair.Carrier z} coefficients.Carrier} (#apply{h}) _ _
      (sym!{{TargetPair.Carrier z}} _ _ (QuotientMap.At[k := z].onClass compatible x)));
\definition restriction: \forall (h: SourceWhole.Carrier z) ->
  #apply{TargetSequence.restriction} z (#apply{WholePull.map} z h) = #apply{SubspacePull.map} z (#apply{SourceSequence.restriction} z h) :=
  \fun (h: SourceWhole.Carrier z) => TargetSub.At[z := z].ext
    (#apply{TargetSequence.restriction} z (#apply{WholePull.map} z h)) (#apply{SubspacePull.map} z (#apply{SourceSequence.restriction} z h))
    (\fun (x: SubspaceExtension.Carrier z) => congr!{{TargetWholeExtension.Carrier z} coefficients.Carrier} (#apply{h}) _ _ (compatible z x));
