\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import Hom.Integer[P := TargetPair.complex, N := coefficients] \as SourceRelative;
\import Hom.Integer[P := complex, N := coefficients] \as TargetRelative;
\import Hom.Integer[P := TargetWholeExtension.complex, N := coefficients] \as SourceWhole;
\import Hom.Integer[P := WholeExtension.complex, N := coefficients] \as TargetWhole;
\import Hom.Integer[P := TargetSubspaceExtension.complex, N := coefficients] \as SourceSub;
\import Hom.Integer[P := SubspaceExtension.complex, N := coefficients] \as TargetSub;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficients;
\import Hom.IntegerMapping[P := complex, Q := TargetPair.complex, N := coefficients, L := coefficients]
  .On[f := map, u := Coefficients.identity] \as RelativePull;
\import Hom.IntegerMapping[P := WholeExtension.complex, Q := TargetWholeExtension.complex, N := coefficients, L := coefficients]
  .On[f := WholeMap.map, u := Coefficients.identity] \as WholePull;
\import Hom.IntegerMapping[P := SubspaceExtension.complex, Q := TargetSubspaceExtension.complex, N := coefficients, L := coefficients]
  .On[f := SubspaceMap.map, u := Coefficients.identity] \as SubspacePull;
\definition pullback: Cochains.Map[C := SourceRelative.complex, D := TargetRelative.complex].Map := RelativePull.map;
\import TargetPair.With[coefficients := coefficients].PairSequence[] \as SourceSequence;
\import \root.Relative[A := A, source := source, subset := subset].With[coefficients := coefficients].PairSequence[] \as TargetSequence;
\module Square(z: I.Int^);
\import Cochains.ShortExact[A := SourceRelative.complex, B := SourceWhole.complex, C := SourceSub.complex]
  .Morphism[A1 := TargetRelative.complex, B1 := TargetWhole.complex, C1 := TargetSub.complex]
  .Diagram[s := SourceSequence.sequence, t := TargetSequence.sequence, a := pullback, b := WholePull.map, c := SubspacePull.map] \as Diagram;
\definition diagram: Diagram.Commutative := Diagram.Commutative {
  left := \fun (z: I.Int^) => Square[z := z].inclusion,
  right := \fun (z: I.Int^) => Square[z := z].restriction,
};
\module At(z: I.Int^) {
  \import Cochains.Map[C := SourceRelative.complex, D := TargetRelative.complex].At[k := z] \as Actions;
  \definition induced: _ := Actions.induced pullback;
  \definition onClass: _ := Actions.onClass pullback;
  \definition connectingNaturality: _ := Diagram.At[k := z].naturality diagram;
  \definition projectionNaturality: _ := Diagram.At[k := z].projectionNaturality diagram;
  \definition inclusionNaturality: _ := Diagram.Inclusion[k := z].naturality diagram;
}
