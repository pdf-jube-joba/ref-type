\import Nonnegative.Map[C := SubspaceChains.complex, D := TargetWholeChains.complex] \as Maps;
\definition law: \forall (x: SubspaceExtension.Carrier (I.Int^::ofNat n)) ->
  #apply{WholeMap.map} (I.Int^::ofNat n) (#apply{inclusionMap} (I.Int^::ofNat n) x) =
  #apply{TargetPair.inclusionMap} (I.Int^::ofNat n) (#apply{SubspaceMap.map} (I.Int^::ofNat n) x) :=
  \fun (x: SubspaceExtension.Carrier (I.Int^::ofNat n)) => congr!{Maps.Map {TargetWholeExtension.Carrier (I.Int^::ofNat n)}}
    (\fun (g: Maps.Map) => TargetWholeExtension.Positive[n := n].intro (#apply{g} n x)) _ _ square;
