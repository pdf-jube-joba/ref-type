\import Complexes.Map[C := WholeExtension.complex, D := FinalExtension.complex] \as WholeMaps;
\definition law: \forall (x: WholeExtension.Carrier z) ->
  #apply{(Composition.compose SecondMap.map FirstMap.map)} z (SourcePair.class z x) = #apply{CompositeMap.map} z (SourcePair.class z x) :=
  \fun (x: WholeExtension.Carrier z) => trans!{{FinalPair.Carrier z}} _ _ _
    (congr!{{TargetPair.Carrier z} {FinalPair.Carrier z}} (#apply{SecondMap.map} z) _ _ (FirstMap.At[z := z].quotientOnClass x))
    (trans!{{FinalPair.Carrier z}} _ _ _ (SecondMap.At[z := z].quotientOnClass (#apply{FirstWhole.map} z x))
      (trans!{{FinalPair.Carrier z}} _ _ _
        (congr!{{FinalExtension.Carrier z} {FinalPair.Carrier z}} (FinalPair.class z) _ _
          (congr!{WholeMaps.Map {FinalExtension.Carrier z}} (\fun (m: WholeMaps.Map) => #apply{m} z x) _ _ whole))
        (sym!{{FinalPair.Carrier z}} _ _ (CompositeMap.At[z := z].quotientOnClass x))));
