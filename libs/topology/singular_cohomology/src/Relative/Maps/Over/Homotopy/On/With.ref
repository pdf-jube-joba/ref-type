\import \root.Relative[A := A, source := source, subset := subset].With[coefficients := coefficients] \as Source;
\import TargetPair.With[coefficients := coefficients] \as Target;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing]
  .IntegerHomotopy[P := complex, Q := TargetPair.complex, N := coefficients] \as Invariance;
\module At(z: I.Int^) {
  \definition law: \forall (q: Target.At[z := z].Carrier) ->
    (StartInteger.With[coefficients := coefficients].At[z := z].induced).apply q = (EndInteger.With[coefficients := coefficients].At[z := z].induced).apply q :=
    \fun (q: Target.At[z := z].Carrier) =>
      sym!{{Source.At[z := z].Carrier}} _ _
        (Invariance.onCohomology EndInteger.map StartInteger.map homotopy z q);
}
