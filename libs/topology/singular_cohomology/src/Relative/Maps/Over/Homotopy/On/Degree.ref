\import \root.Simplices[A := A, source := source] \as WholeSimplices;
\import \root.Simplices[A := SubspaceCarrier, source := Subspace.topology source] \as SubspaceSimplices;
\import algebraic_topology.Simplex[] \as Simplex;
\import \root.CylinderChains[n := n] \as Geometry;
\import Simplex.Cylinder[n := n] \as GeometrySpace;
\import algebraic_topology.Cylinder[A := Simplex.Carrier n] \as GeometricCylinder;
\import Whole.At[n := n] \as Prism;
\import TargetSupport.From[S := Geometry.Points].Over[topology := GeometrySpace.topology] \as PrismImage;
\definition degree: I.Int^ := I.Int^::ofNat n;
\definition nextDegree: I.Int^ := I.Int^::ofNat (N.Nat^::succ n);
\definition included(sigma: SubspaceSimplices.Carrier n): WholeSimplices.Carrier n := Inclusion.postcompose n inclusion inclusionContinuous sigma;
\import Modules.Hom[V := WholeChains.Carrier n, W := TargetChains.Carrier (N.Nat^::succ n), source := WholeChains.space n, target := TargetChains.space (N.Nat^::succ n)]
  .Composition[U := SubspaceChains.Carrier n, domain := SubspaceChains.space n] \as FirstComposition;
\definition raw: Modules.Hom[V := SubspaceChains.Carrier n, W := TargetChains.Carrier (N.Nat^::succ n), source := SubspaceChains.space n, target := TargetChains.space (N.Nat^::succ n)].Map :=
  FirstComposition.compose (Prism.map f g ambient) (Inclusion.At[n := n].push inclusion inclusionContinuous);
\import Modules.Hom[V := TargetChains.Carrier (N.Nat^::succ n), W := TargetExtension.Carrier nextDegree, source := TargetChains.space (N.Nat^::succ n), target := TargetExtension.space nextDegree]
  .Composition[U := SubspaceChains.Carrier n, domain := SubspaceChains.space n] \as SecondComposition;
\definition map: Modules.Hom[V := SubspaceChains.Carrier n, W := TargetExtension.Carrier nextDegree, source := SubspaceChains.space n, target := TargetExtension.space nextDegree].Map :=
  SecondComposition.compose TargetExtension.Positive[n := N.Nat^::succ n].forward raw;
\definition wrap(x: TargetChains.Carrier (N.Nat^::succ n)): TargetExtension.Carrier nextDegree := TargetExtension.Positive[n := N.Nat^::succ n].intro x;
\definition rawOnGenerator: \forall (sigma: SubspaceSimplices.Carrier n) ->
  #apply{raw} (SubspaceChains.generator n sigma) = Prism.onSimplex f g ambient (included sigma) :=
  \fun (sigma: SubspaceSimplices.Carrier n) => trans!{{TargetChains.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{WholeChains.Carrier n} {TargetChains.Carrier (N.Nat^::succ n)}} (#apply{(Prism.map f g ambient)}) _ _ (Inclusion.At[n := n].onGenerator inclusion inclusionContinuous sigma))
    (Prism.onGenerator f g ambient (included sigma));
\definition onGenerator: \forall (sigma: SubspaceSimplices.Carrier n) -> TargetSupport.Image nextDegree (#apply{map} (SubspaceChains.generator n sigma)) :=
  \fun (sigma: SubspaceSimplices.Carrier n) => \idelim wrap (Prism.onSimplex f g ambient (included sigma)) = #apply{map} (SubspaceChains.generator n sigma)
    \with y: TargetExtension.Carrier nextDegree => TargetSupport.Image nextDegree y \by {
      base: PrismImage.At[n := N.Nat^::succ n].law (Prism.family f g ambient (included sigma)) (Prism.continuous f g ambient (included sigma))
        (\fun (p: Geometry.Points) => preserves (GeometricCylinder.time p) (sigma (GeometricCylinder.point p))) Geometry.Prism[].chain,
      equality: sym!{{TargetExtension.Carrier nextDegree}} _ _ (congr!{{TargetChains.Carrier (N.Nat^::succ n)} {TargetExtension.Carrier nextDegree}} wrap _ _ (rawOnGenerator sigma))
    };
\definition all: \forall (x: SubspaceChains.Carrier n) -> TargetSupport.Image nextDegree (#apply{map} x) :=
  Modules.Free[Generators := SubspaceSimplices.Carrier n].Induction[].Into[W := TargetExtension.Carrier nextDegree, target := TargetExtension.space nextDegree]
    .law map TargetQuotient.At[k := nextDegree].image onGenerator;
\definition law: \forall (x: SubspaceExtension.Carrier degree) -> TargetSupport.Image nextDegree (#apply{WholeInteger.integerHomotopy} degree (#apply{inclusionMap} degree x)) :=
  \fun (x: SubspaceExtension.Carrier degree) => all x;
