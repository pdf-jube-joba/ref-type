\import Complexes.Map[C := SubspaceExtension.complex, D := WholeExtension.complex].At[k := z] \as InclusionAt;
\import Modules.Of[V := WholeExtension.Carrier z, space := WholeExtension.space z].Submodule[] \as Submodules;
\import Submodules.Image[U := SubspaceExtension.Carrier z, source := SubspaceExtension.space z] \as Images;
\definition law: \forall (x: WholeExtension.Carrier z) -> Submodules.Member Quotient.At[k := z].image x ->
  TargetSupport.Image (chain_complexes.Chain[].next z) ((WholeInteger.integerHomotopy).apply z x) :=
  \fun (x: WholeExtension.Carrier z)(member: Submodules.Member Quotient.At[k := z].image x) => Images.eliminate (InclusionAt.linear inclusionMap) x
    (TargetSupport.Image (chain_complexes.Chain[].next z) ((WholeInteger.integerHomotopy).apply z x))
    (\fun (y: SubspaceExtension.Carrier z)(same: (inclusionMap).apply z y = x) =>
      \idelim (inclusionMap).apply z y = x \with a: WholeExtension.Carrier z => TargetSupport.Image (chain_complexes.Chain[].next z) ((WholeInteger.integerHomotopy).apply z a) \by {
        base: included z y, equality: same
      }) member;
