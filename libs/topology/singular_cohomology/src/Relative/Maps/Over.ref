\import \root.Relative[A := B, source := target, subset := targetSubset] \as TargetPair;
\import topology.Topology[Carrier := B].Subspace[S := targetSubset] \as TargetSubspace;
\import \root.Maps[A := A, B := B, source := source, target := target] \as WholeMaps;
\structure Laws[f: A -> B]: \Prop {
  continuous: WholeMaps.Continuous f,
  contained: \forall (x: SubspaceCarrier) -> \In[B] targetSubset (f x),
}
\definition Map: \Set := \Cast[A -> B] ({ f: A -> B \where Laws[f] });
\definition laws(f: Map): Laws[f] := \bysub(A -> B, { f: A -> B \where Laws[f] }, f);
\module On(f: Map);
\module Homotopy(f, g: Map);
