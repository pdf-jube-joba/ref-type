\import \root.Chains[A := S, source := topology] \as SourceChains;
\import \root.Simplices[A := S, source := topology] \as SourceSimplices;
\import \root.Maps[A := S, B := A, source := topology, target := source] \as Maps;
\import Nonnegative.ZeroExtension[C := SourceChains.complex] \as SourceExtension;
\definition Contained(f: S -> A): \Prop := \forall (x: S) -> \In[A] subset (f x);
\module At(n: N.Nat^);
\definition all: \forall (z: I.Int^)(f: S -> A)(continuous: Maps.Continuous f) -> Contained f -> \forall (x: SourceExtension.Carrier z) -> Image z (#apply{(Maps.integerPush f continuous)} z x) :=
  \induction (z: I.Int^) \return \forall (f: S -> A)(continuous: Maps.Continuous f) -> Contained f -> \forall (x: SourceExtension.Carrier z) -> Image z (#apply{(Maps.integerPush f continuous)} z x) \with {
    | ofNat: \fun (n: N.Nat^)(f: S -> A)(continuous: Maps.Continuous f)(contained: Contained f)(x: SourceExtension.Carrier (I.Int^::ofNat n)) => At[n := n].law f continuous contained x
    | negSucc: \fun (n: N.Nat^)(f: S -> A)(continuous: Maps.Continuous f)(contained: Contained f)(x: SourceExtension.Carrier (I.Int^::negSucc n)) => #zero{(Quotient.At[k := I.Int^::negSucc n].image)}
  };
