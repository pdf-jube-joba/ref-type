\definition Contained(sigma: WholeSimplices.Carrier n): \Prop := \forall (x: Simplex.Carrier n) -> \In[A] subset (sigma x);
\definition function(sigma: WholeSimplices.Carrier n)(contained: Contained sigma)(x: Simplex.Carrier n): SubspaceCarrier :=
  \into[A](sigma x, subset) \by { contained x };
\import topology.Continuity[A := Simplex.Carrier n, B := A].Corestriction[S := subset] \as Into;
\import Simplex.At[n := n] \as Domain;
\definition lift(sigma: WholeSimplices.Carrier n)(contained: Contained sigma): SubspaceSimplices.Carrier n :=
  \into[SubspaceSimplices.At[n := n].Function](function sigma contained, SubspaceSimplices.Carrier n) \by {
    Into.corestrictContinuous Domain.topology source (function sigma contained) (WholeSimplices.At[n := n].continuous sigma)
  };
\definition liftLaw: \forall (sigma: WholeSimplices.Carrier n)(contained: Contained sigma) ->
  Inclusion.postcompose n inclusion inclusionContinuous (lift sigma contained) = sigma :=
  \fun (sigma: WholeSimplices.Carrier n)(contained: Contained sigma) => WholeSimplices.ext n
    (Inclusion.postcompose n inclusion inclusionContinuous (lift sigma contained)) sigma (\fun (x: Simplex.Carrier n) => \refl(sigma x));
\definition rawOnGenerator: \forall (sigma: WholeSimplices.Carrier n)(contained: Contained sigma) ->
  #apply{(Inclusion.At[n := n].push inclusion inclusionContinuous)} (SubspaceChains.generator n (lift sigma contained)) = WholeChains.generator n sigma :=
  \fun (sigma: WholeSimplices.Carrier n)(contained: Contained sigma) => trans!{{WholeChains.Carrier n}} _ _ _
    (Inclusion.At[n := n].onGenerator inclusion inclusionContinuous (lift sigma contained))
    (congr!{{WholeSimplices.Carrier n} {WholeChains.Carrier n}} (WholeChains.generator n) _ _ (liftLaw sigma contained));
\definition degree: I.Int^ := I.Int^::ofNat n;
\definition included(x: WholeChains.Carrier n): WholeExtension.Carrier degree := WholeExtension.Positive[n := n].intro x;
\definition generatorImage: \forall (sigma: WholeSimplices.Carrier n)(contained: Contained sigma) -> Image degree (included (WholeChains.generator n sigma)) :=
  \fun (sigma: WholeSimplices.Carrier n)(contained: Contained sigma) => Logic.existsIntro[SubspaceExtension.Carrier degree,
    { x: SubspaceExtension.Carrier degree \where #apply{inclusionMap} degree x = included (WholeChains.generator n sigma) }]
      (SubspaceExtension.Positive[n := n].intro (SubspaceChains.generator n (lift sigma contained)))
      (congr!{{WholeChains.Carrier n} {WholeExtension.Carrier degree}} included _ _ (rawOnGenerator sigma contained));
