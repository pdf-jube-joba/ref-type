\definition degree: I.Int^ := I.Int^::ofNat n;
\import Modules.Hom[V := WholeExtension.Carrier degree, W := Carrier degree, source := WholeExtension.space degree, target := space degree]
  .Composition[U := WholeReduced.Carrier degree, domain := WholeReduced.space degree] \as Composition;
\definition map: Projection degree := Composition.compose Quotient.At[k := degree].projection WholeExtension.Positive[n := n].forward;
\definition injective: \forall (x, y: SubspaceReduced.Carrier degree) -> (inclusionMap).apply degree x = (inclusionMap).apply degree y -> x = y :=
  \fun (x, y: SubspaceReduced.Carrier degree)(equal: _) =>
    congr!{{SubspaceExtension.Carrier degree} {SubspaceReduced.Carrier degree}} ((SubspaceExtension.Positive[n := n].backward).apply) _ _
      (Ordinary.injective degree (SubspaceExtension.Positive[n := n].intro x) (SubspaceExtension.Positive[n := n].intro y)
        (congr!{{WholeReduced.Carrier degree} {WholeExtension.Carrier degree}} (WholeExtension.Positive[n := n].intro) _ _ equal));
\definition onto: \forall (q: Carrier degree) -> \exists ( x: WholeReduced.Carrier degree \where (map).apply x = q ) :=
  Quotient.At[k := degree].induction (\fun (q: Carrier degree) => \exists ( x: WholeReduced.Carrier degree \where (map).apply x = q ))
    (\fun (x: WholeExtension.Carrier degree) => Logic.existsIntro[WholeReduced.Carrier degree, { y: WholeReduced.Carrier degree \where (map).apply y = class degree x }] x
      (congr!{{WholeExtension.Carrier degree} {Carrier degree}} (class degree) _ _ ((WholeExtension.Positive[n := n].isomorphism).rightInverse x)));
\definition zero: \forall (x: SubspaceReduced.Carrier degree) -> (map).apply ((inclusionMap).apply degree x) = (space degree).zero :=
  \fun (x: SubspaceReduced.Carrier degree) => Quotient.At[k := degree].onImage (SubspaceExtension.Positive[n := n].intro x);
\definition kernelImage: \forall (x: WholeReduced.Carrier degree) -> (map).apply x = (space degree).zero ->
  \exists ( y: SubspaceReduced.Carrier degree \where (inclusionMap).apply degree y = x ) := \block {
  \fun (x: WholeReduced.Carrier degree)(killed: _) \then
  \takefrom y: \Cast[SubspaceExtension.Carrier degree] ({ y: SubspaceExtension.Carrier degree \where (Ordinary.inclusionMap).apply degree y = WholeExtension.Positive[n := n].intro x })
    \by Quotient.At[k := degree].zeroClassImage (WholeExtension.Positive[n := n].intro x) killed \then
  \return Logic.existsIntro[SubspaceReduced.Carrier degree, { y: SubspaceReduced.Carrier degree \where (inclusionMap).apply degree y = x }] y
    (congr!{{WholeExtension.Carrier degree} {WholeReduced.Carrier degree}} ((WholeExtension.Positive[n := n].backward).apply) _ _
      (\bysub(SubspaceExtension.Carrier degree, { y: SubspaceExtension.Carrier degree \where (Ordinary.inclusionMap).apply degree y = WholeExtension.Positive[n := n].intro x }, y)))
};
\definition exactness: ExactAt[degree, map] := ExactAt[degree, map] {
  injective := injective, onto := onto, zero := zero, kernelImage := kernelImage,
};
