\import topology.Topology[Carrier := A].Subspace[S := subset] \as Topology;
\import algebraic_topology.Contraction[A := SubspaceCarrier, source := Topology.topology source] \as Geometry;
\import \root.Calculations[A := SubspaceCarrier, source := Topology.topology source].ReducedContractible[] \as Vanishing;
\import Complexes.Map[C := WholeReduced.complex, D := complex] \as Maps;
\definition quasi(c: Geometry.Data): Maps.QuasiIsomorphism projectionMap :=
  Exact.quasiProjection sequence (\fun (z: I.Int^) => Vanishing.Homology[z := z].zero c);
\module Homology(z: I.Int^) {
  \import Complexes.At[C := WholeReduced.complex, z := z] \as Source;
  \import Complexes.At[C := complex, z := z] \as Target;
  \definition isomorphism(c: Geometry.Data): Modules.Isomorphism[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace].Isomorphism :=
    Maps.At[k := z].Invert[f := projectionMap].isomorphism (quasi c z);
  \definition onForward: \forall (c: Geometry.Data)(q: Source.Homology) ->
    #apply{#forward{(isomorphism c)}} q = #apply{(Maps.At[k := z].induced projectionMap)} q :=
    \fun (c: Geometry.Data)(q: Source.Homology) => \refl(#apply{(Maps.At[k := z].induced projectionMap)} q);
}
