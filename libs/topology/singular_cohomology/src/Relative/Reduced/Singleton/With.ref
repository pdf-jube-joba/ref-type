\import \root.Relative[A := A, source := source, subset := subset].Reduced[].With[coefficients := coefficients] \as Sequence;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as HomComplex;
\import HomComplex.Integer[P := complex, N := coefficients] \as RelativeHom;
\import HomComplex.Integer[P := WholeReduced.complex, N := coefficients] \as WholeHom;
\import HomComplex.Integer[P := SubspaceReduced.complex, N := coefficients] \as SubspaceHom;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import Cochains.ShortExact[A := RelativeHom.complex, B := WholeHom.complex, C := SubspaceHom.complex] \as Exact;
\import Cochains.Map[C := RelativeHom.complex, D := WholeHom.complex] \as Maps;
\definition quasiInclusion: Unique -> Maps.QuasiIsomorphism Sequence.sequence.inclusion :=
  \fun (unique: Unique) => Exact.quasiInclusion Sequence.sequence
    (\fun (z: I.Int^)(q: SubspaceHom.Cohomology[z := z].Cohomology) => Point.With[coefficients := coefficients].At[z := z].zero unique q);
\definition quasiPullback: Unique -> Maps.QuasiIsomorphism Sequence.pullback :=
  \fun (unique: Unique) => \idelim Sequence.sequence.inclusion = Sequence.pullback
    \with m: Maps.Map => Maps.QuasiIsomorphism m \by { base: quasiInclusion unique, equality: Sequence.inclusionLaw };
\module At(z: I.Int^) {
  \import Cochains.At[C := RelativeHom.complex, z := z] \as Source;
  \import Cochains.At[C := WholeHom.complex, z := z] \as Target;
  \definition isomorphism(unique: Unique): Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Isomorphism :=
    Maps.At[k := z].Invert[f := Sequence.pullback].isomorphism (quasiPullback unique z);
}
