\definition degree: I.Int^ := I.Int^::negSucc n;
\import Modules.Hom[V := WholeReduced.Carrier degree, W := Carrier degree, source := WholeReduced.space degree, target := space degree] \as Maps;
\definition map: Projection degree := Maps.zeroMap;
\import Modules.Hom[V := WholeExtension.Carrier degree, W := Carrier degree, source := WholeExtension.space degree, target := space degree] \as ProjectionMaps;
\definition zero: \forall (q: Carrier degree) -> q = #zero{(space degree)} :=
  Quotient.At[k := degree].induction (\fun (q: Carrier degree) => q = #zero{(space degree)})
    (\fun (x: WholeExtension.Carrier degree) => trans!{{Carrier degree}} _ _ _
      (congr!{{WholeExtension.Carrier degree} {Carrier degree}} (class degree) _ _ (WholeExtension.Negative[n := n].zero x))
      (ProjectionMaps.zeroPreserved Quotient.At[k := degree].projection));
\definition equal: \forall (x, y: Carrier degree) -> x = y :=
  \fun (x, y: Carrier degree) => trans!{{Carrier degree}} _ _ _ (zero x) (sym!{{Carrier degree}} _ _ (zero y));
\definition injective: \forall (x, y: SubspaceReduced.Carrier degree) -> #apply{inclusionMap} degree x = #apply{inclusionMap} degree y -> x = y :=
  (\induction (k: N.Nat^) \return \forall (x, y: SubspaceReduced.Carrier (I.Int^::negSucc k)) ->
    #apply{inclusionMap} (I.Int^::negSucc k) x = #apply{inclusionMap} (I.Int^::negSucc k) y -> x = y \with {
      | zero: \fun (x, y: I.Int^)(equal: x = y) => equal
      | succ: \fun (k: N.Nat^)(unused: _)(x, y: Modules.Zero[].Carrier)(equal: x = y) => equal
    }) n;
\definition onto: \forall (q: Carrier degree) -> \exists { x: WholeReduced.Carrier degree \where #apply{map} x = q } :=
  \fun (q: Carrier degree) => Logic.existsIntro[WholeReduced.Carrier degree, { x: WholeReduced.Carrier degree \where #apply{map} x = q }]
    #zero{(WholeReduced.space degree)} (sym!{{Carrier degree}} _ _ (zero q));
\definition kernelImage: \forall (x: WholeReduced.Carrier degree) -> \exists { y: SubspaceReduced.Carrier degree \where #apply{inclusionMap} degree y = x } :=
  (\induction (k: N.Nat^) \return \forall (x: WholeReduced.Carrier (I.Int^::negSucc k)) ->
    \exists { y: SubspaceReduced.Carrier (I.Int^::negSucc k) \where #apply{inclusionMap} (I.Int^::negSucc k) y = x } \with {
      | zero: \fun (x: I.Int^) => Logic.existsIntro[I.Int^, { y: I.Int^ \where #apply{inclusionMap} (I.Int^::negSucc N.Nat^::zero) y = x }] x (\refl(x))
      | succ: \fun (k: N.Nat^)(unused: _)(x: Modules.Zero[].Carrier) =>
        Logic.existsIntro[Modules.Zero[].Carrier, { y: Modules.Zero[].Carrier \where #apply{inclusionMap} (I.Int^::negSucc (N.Nat^::succ k)) y = x }] x (\refl(x))
    }) n;
\definition exactness: ExactAt[degree, map] := ExactAt[degree, map] {
  injective := injective, onto := onto,
  zero := \fun (x: SubspaceReduced.Carrier degree) => \refl(#zero{(space degree)}),
  kernelImage := \fun (x: WholeReduced.Carrier degree)(killed: _) => kernelImage x,
};
