\definition Unique: \Prop := \forall (x: SubspaceCarrier) -> x = a;
\import SubspaceReduced.Singleton[a := a] \as Point;
\import Complexes.Map[C := WholeReduced.complex, D := complex] \as Maps;
\definition quasiProjection: Unique -> Maps.QuasiIsomorphism projectionMap :=
  \fun (unique: Unique) => Exact.quasiProjection sequence (\fun (z: I.Int^)(q: SubspaceReduced.At[z := z].Carrier) => Point.Homology[z := z].zero unique q);
\module Homology(z: I.Int^) {
  \import Complexes.At[C := WholeReduced.complex, z := z] \as Source;
  \import Complexes.At[C := complex, z := z] \as Target;
  \definition isomorphism(unique: Unique): Modules.Isomorphism[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace].Isomorphism :=
    Maps.At[k := z].Invert[f := projectionMap].isomorphism (quasiProjection unique z);
}
\module With(coefficients: Modules.Bundle);
