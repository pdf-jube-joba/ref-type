\import Cochains.At[C := Subspace.complex, z := z] \as SubspaceH;
\import Cochains.At[C := Relative.complex, z := CochainDegrees.next z] \as RelativeH;
\import Exact.At[s := sequence, k := z] \as Native;
\import Native.DimensionShift[] \as Shift;
\definition isomorphism(c: Geometry.Data): Modules.Isomorphism[V := SubspaceH.Cohomology, W := RelativeH.Cohomology, source := SubspaceH.cohomologySpace, target := RelativeH.cohomologySpace].Isomorphism :=
  Shift.isomorphism (Vanishing.At[z := z].zero c) (Vanishing.At[z := CochainDegrees.next z].zero c);
\definition onForward: \forall (c: Geometry.Data)(q: SubspaceH.Cohomology) ->
  #apply{#forward{(isomorphism c)}} q = #apply{Native.connecting} q :=
  \fun (c: Geometry.Data)(q: SubspaceH.Cohomology) => \refl(#apply{Native.connecting} q);
