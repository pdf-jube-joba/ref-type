\import Cochains.At[C := Relative.complex, z := z] \as RelativeH;
\import Cochains.At[C := Whole.complex, z := z] \as WholeH;
\import Maps.At[k := z].Invert[f := pullback] \as Inverse;
\definition isomorphism(c: Geometry.Data): Modules.Isomorphism[V := RelativeH.Cohomology, W := WholeH.Cohomology, source := RelativeH.cohomologySpace, target := WholeH.cohomologySpace].Isomorphism :=
  Inverse.isomorphism (quasi c z);
\definition onForward: \forall (c: Geometry.Data)(q: RelativeH.Cohomology) ->
  #apply{#forward{(isomorphism c)}} q = #apply{(Maps.At[k := z].induced pullback)} q :=
  \fun (c: Geometry.Data)(q: RelativeH.Cohomology) => \refl(#apply{(Maps.At[k := z].induced pullback)} q);
