\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as HomComplex;
\import HomComplex.Integer[P := complex, N := coefficients] \as Relative;
\import HomComplex.Integer[P := WholeReduced.complex, N := coefficients] \as Whole;
\import HomComplex.Integer[P := SubspaceReduced.complex, N := coefficients] \as Subspace;
\import HomComplex.IntegerRelative[subcomplex := SubspaceReduced.complex, wholecomplex := WholeReduced.complex].On[pair := split, coefficients := coefficients].PairSequence[] \as Native;
\import HomComplex.IntegerIsomorphism[P := AugmentedQuotient.complex, Q := complex, N := coefficients].On[e := quotientIsomorphism] \as Comparison;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import HomComplex.Integer[P := AugmentedQuotient.complex, N := coefficients] \as QuotientHom;
\import Cochains.ShortExact[A := QuotientHom.complex, B := Whole.complex, C := Subspace.complex].ReplaceLeft[A1 := Relative.complex]
  .On[s := Native.sequence, e := Comparison.isomorphism] \as Transport;
\definition sequence: Cochains.ShortExact[A := Relative.complex, B := Whole.complex, C := Subspace.complex].Sequence := Transport.sequence;
