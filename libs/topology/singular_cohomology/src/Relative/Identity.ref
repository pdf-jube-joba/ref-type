\import \root.Relative[A := A, source := source, subset := subset].Maps[B := A].Over[target := source, targetSubset := subset] \as Maps;
\import \root.Identity[A := A, source := source] \as Whole;
\definition map: Maps.Map := \into[A -> A](Whole.function, Maps.Map) \by {
  Maps.Laws[Whole.function] { continuous := Whole.continuous, contained := \fun (x: SubspaceCarrier) => \bysub(A, subset, x) }
};
\import Maps.On[f := map].Integer[] \as Mapping;
\import Complexes.Map[C := complex, D := complex] \as RelativeMaps;
\import Complexes.End[C := complex] \as End;
\import Complexes.Map[C := WholeExtension.complex, D := WholeExtension.complex] \as WholeMaps;
\module At(z: I.Int^);
\definition chainLaw: Mapping.map = End.identity := RelativeMaps.ext Mapping.map End.identity
  (\fun (z: I.Int^) => Quotient.At[k := z].induction (\fun (q: Carrier z) => (Mapping.map).apply z q = q) (At[z := z].onClass));
\module Homology(z: I.Int^) {
  \import Complexes.At[C := complex, z := z] \as Native;
  \definition law: \forall (q: Native.Homology) -> (Mapping.At[z := z].induced).apply q = q :=
    \fun (q: Native.Homology) => trans!{Native.Homology} _ _ _
      (congr!{RelativeMaps.Map Native.Homology} (\fun (f: RelativeMaps.Map) => (RelativeMaps.At[k := z].induced f).apply q) _ _ chainLaw)
      (End.At[k := z].identityOnHomology q);
}
\module With(coefficients: Modules.Bundle);
