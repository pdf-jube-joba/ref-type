\import \parent.\parent.Vanishing[z := z] \as Vanishing;
\import Quotient.At[k := z] \as Q;
\import Modules.Of[V := WholeExtension.Carrier z, space := WholeExtension.space z].Submodule[].Quotient[S := Q.image] \as ChainQuotient;
\import Modules.Hom[V := Q.Carrier, W := coefficients.Carrier, source := Q.space, target := coefficients.space] \as RelativeMaps;
\import Modules.Hom[V := WholeExtension.Carrier z, W := coefficients.Carrier, source := WholeExtension.space z, target := coefficients.space] \as WholeMaps;
\import Modules.Hom[V := SubspaceExtension.Carrier z, W := coefficients.Carrier, source := SubspaceExtension.space z, target := coefficients.space] \as SubMaps;
\import Modules.Hom[V := WholeExtension.Carrier z, W := coefficients.Carrier, source := WholeExtension.space z, target := coefficients.space]
  .Composition[U := SubspaceExtension.Carrier z, domain := SubspaceExtension.space z] \as Restrict;
\definition injective: \forall (h, k: Hom.Carrier z) -> #apply{inclusion} z h = #apply{inclusion} z k -> h = k :=
  \fun (h, k: Hom.Carrier z)(equal: _) => RelativeMaps.ext h k
    (ChainQuotient.induction (\fun (q: Q.Carrier) => #apply{h} q = #apply{k} q)
      (\fun (x: WholeExtension.Carrier z) => congr!{{Whole.Carrier z} coefficients.Carrier}
        (\fun (g: Whole.Carrier z) => #apply{g} x) _ _ equal));
\definition zero: \forall (h: Hom.Carrier z) -> #apply{restriction} z (#apply{inclusion} z h) = #zero{(Sub.space z)} :=
  \fun (h: Hom.Carrier z) => SubMaps.ext (#apply{restriction} z (#apply{inclusion} z h)) (#zero{(Sub.space z)})
    (\fun (x: SubspaceExtension.Carrier z) => trans!{coefficients.Carrier} _ _ _
      (congr!{Q.Carrier coefficients.Carrier} (#apply{h}) _ _ (Q.onImage x)) (RelativeMaps.zeroPreserved h));
\definition kernelImage: \forall (h: Whole.Carrier z) -> #apply{restriction} z h = #zero{(Sub.space z)} ->
  \exists { k: Hom.Carrier z \where #apply{inclusion} z k = h } := \block {
  \fun (h: Whole.Carrier z)(killed: _) \then
  \let null: Vanishing.NullCochain := \into[Whole.Carrier z](h, #carrier{Vanishing.submodule}) \by {
    \fun (x: SubspaceExtension.Carrier z) => congr!{{Sub.Carrier z} coefficients.Carrier}
      (\fun (g: Sub.Carrier z) => #apply{g} x) _ _ killed
  } \then
  \return Logic.existsIntro[Hom.Carrier z, { k: Hom.Carrier z \where #apply{inclusion} z k = h }]
    (Vanishing.descend null) (Vanishing.rightInverse null)
};
\module Positive(n: N.Nat^) {
  \import \root.Relative[A := A, source := source, subset := subset].Split[n := n] \as Split;
    \import SubspaceExtension.Positive[n := n] \as IntoSubspace;
  \import Modules.Hom[V := WholeExtension.Carrier (I.Int^::ofNat n), W := SubspaceExtension.Carrier (I.Int^::ofNat n),
    source := WholeExtension.space (I.Int^::ofNat n), target := SubspaceExtension.space (I.Int^::ofNat n)] \as Back;
  \definition back: Back.Map := Back.Map {
    apply := \fun (x: WholeExtension.Carrier (I.Int^::ofNat n)) => IntoSubspace.intro (#apply{Split.retraction} x),
    addition := \fun (x, y: WholeExtension.Carrier (I.Int^::ofNat n)) => #addition{Split.retraction} x y,
    scalar := \fun (a: I.Int^)(x: WholeExtension.Carrier (I.Int^::ofNat n)) => #scalar{Split.retraction} a x,
  };
  \import Modules.Hom[V := SubspaceExtension.Carrier (I.Int^::ofNat n), W := coefficients.Carrier, source := SubspaceExtension.space (I.Int^::ofNat n), target := coefficients.space]
    .Composition[U := WholeExtension.Carrier (I.Int^::ofNat n), domain := WholeExtension.space (I.Int^::ofNat n)] \as Extend;
  \definition extend(h: Sub.Carrier (I.Int^::ofNat n)): Whole.Carrier (I.Int^::ofNat n) := Extend.compose h back;
  \definition law: \forall (h: Sub.Carrier (I.Int^::ofNat n)) -> #apply{restriction} (I.Int^::ofNat n) (extend h) = h :=
    \fun (h: Sub.Carrier (I.Int^::ofNat n)) => Sub.At[z := I.Int^::ofNat n].ext _ h
      (\fun (x: SubspaceExtension.Carrier (I.Int^::ofNat n)) => congr!{{SubspaceExtension.Carrier (I.Int^::ofNat n)} coefficients.Carrier} (#apply{h}) _ _ (congr!{{SubspaceChains.Carrier n} {SubspaceExtension.Carrier (I.Int^::ofNat n)}} IntoSubspace.intro _ _ (Split.leftInverse x)));
}
\definition onto: \forall (h: Sub.Carrier z) -> \exists { k: Whole.Carrier z \where #apply{restriction} z k = h } :=
  (\induction (k: I.Int^) \return \forall (h: Sub.Carrier k) -> \exists { g: Whole.Carrier k \where #apply{restriction} k g = h } \with {
    | ofNat: \fun (n: N.Nat^)(h: Sub.Carrier (I.Int^::ofNat n)) =>
        Logic.existsIntro[Whole.Carrier (I.Int^::ofNat n), { g: Whole.Carrier (I.Int^::ofNat n) \where #apply{restriction} (I.Int^::ofNat n) g = h }]
          (Positive[n := n].extend h) (Positive[n := n].law h)
    | negSucc: \fun (n: N.Nat^)(h: Sub.Carrier (I.Int^::negSucc n)) =>
        Logic.existsIntro[Whole.Carrier (I.Int^::negSucc n), { g: Whole.Carrier (I.Int^::negSucc n) \where #apply{restriction} (I.Int^::negSucc n) g = h }]
          (#zero{(Whole.space (I.Int^::negSucc n))})
          (Sub.At[z := I.Int^::negSucc n].ext _ h (\fun (x: SubspaceExtension.Carrier (I.Int^::negSucc n)) =>
            sym!{coefficients.Carrier} _ _ (trans!{coefficients.Carrier} _ _ _
              (congr!{{SubspaceExtension.Carrier (I.Int^::negSucc n)} coefficients.Carrier} (#apply{h}) _ _ (SubspaceExtension.Negative[n := n].zero x))
              (Sub.At[z := I.Int^::negSucc n].zeroPreserved h))))
  }) z;
