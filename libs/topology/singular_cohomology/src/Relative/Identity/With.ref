\import \root.Relative[A := A, source := source, subset := subset].With[coefficients := coefficients] \as Cochains;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.IntegerEnd[P := complex, N := coefficients] \as Native;
\import Hom.IntegerMapping[P := complex, Q := complex, N := coefficients, L := coefficients] \as Action;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficients;
\definition law: \forall (z: I.Int^)(q: Cochains.At[z := z].Carrier) -> #apply{Mapping.With[coefficients := coefficients].At[z := z].induced} q = q :=
  \fun (z: I.Int^)(q: Cochains.At[z := z].Carrier) => trans!{{Cochains.At[z := z].Carrier}} _ _ _
    (congr!{RelativeMaps.Map {Cochains.At[z := z].Carrier}}
      (\fun (f: RelativeMaps.Map) => #apply{Action.On[f := f, u := Coefficients.identity].At[z := z].map} q) _ _ chainLaw)
    (Native.At[k := z].onCohomology q);
