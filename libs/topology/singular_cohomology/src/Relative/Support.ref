\import algebraic_topology.Simplex[] \as Simplex;
\import \root.Simplices[A := A, source := source] \as WholeSimplices;
\import \root.Simplices[A := SubspaceCarrier, source := Subspace.topology source] \as SubspaceSimplices;
\definition Image(z: I.Int^)(x: WholeExtension.Carrier z): \Prop :=
  Modules.Of[V := WholeExtension.Carrier z, space := WholeExtension.space z].Submodule[].Member Quotient.At[k := z].image x;
\module Degree(n: N.Nat^);
\module From(S: \Set) {
  \import topology.Topology[Carrier := S] \as SourceTopology;
  \module Over(topology: SourceTopology.Topology);
}
