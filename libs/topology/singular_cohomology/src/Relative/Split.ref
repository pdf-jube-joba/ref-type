\import \root.Simplices[A := SubspaceCarrier, source := Subspace.topology source] \as SubspaceSimplices;
\import \root.Simplices[A := A, source := source] \as WholeSimplices;
\import \parent.Injection[n := n] \as Injection;
\import Modules.Free[Generators := SubspaceSimplices.Carrier n].Reindex[TargetGenerators := WholeSimplices.Carrier n]
  .Injection[f := Inclusion.postcompose n inclusion inclusionContinuous].Retraction[] \as Native;
\import Modules.Hom[V := WholeChains.Carrier n, W := SubspaceChains.Carrier n, source := WholeChains.space n, target := SubspaceChains.space n] \as Maps;
\definition retraction: Maps.Map := Native.retraction Injection.onSimplices;
\import Modules.Hom[V := SubspaceChains.Carrier n, W := SubspaceChains.Carrier n, source := SubspaceChains.space n, target := SubspaceChains.space n] \as End;
\definition leftInverse: \forall (x: SubspaceExtension.Carrier (I.Int^::ofNat n)) ->
  #apply{retraction} (#apply{inclusionMap} (I.Int^::ofNat n) x) = x :=
  \fun (x: SubspaceExtension.Carrier (I.Int^::ofNat n)) => congr!{End.Map {SubspaceChains.Carrier n}}
    (\fun (f: End.Map) => #apply{f} x) _ _ (Native.leftInverse Injection.onSimplices);
