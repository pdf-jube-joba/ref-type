\import Chains.At[C := Source.complex, z := z] \as SourceH;
\import Chains.At[C := Target.complex, z := z] \as TargetH;
\definition isomorphism(e: Equivalence): Modules.Isomorphism[V := SourceH.Homology, W := TargetH.Homology, source := SourceH.homologySpace, target := TargetH.homologySpace].Isomorphism :=
  \parent.\parent.Integer[e := e].Homology[z := z].isomorphism;
\definition bijective(e: Equivalence): ForwardMaps.At[k := z].Bijective[Forward.integerPush e.forward (#forwardContinuous{(Geometry.laws source target e)})] :=
  \parent.\parent.Integer[e := e].Homology[z := z].bijective;
