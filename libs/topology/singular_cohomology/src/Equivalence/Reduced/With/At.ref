\import Cochains.At[C := SourceHom.complex, z := z] \as SourceH;
\import Cochains.At[C := TargetHom.complex, z := z] \as TargetH;
\definition isomorphism[e: Equivalence]: Modules.Isomorphism[V := SourceH.Cohomology, W := TargetH.Cohomology, source := SourceH.cohomologySpace, target := TargetH.cohomologySpace].Isomorphism :=
  \parent.\parent.On[e := e].With[coefficients := coefficients].At[z := z].isomorphism;
\definition bijective[e: Equivalence]: Cochains.Map[C := TargetHom.complex, D := SourceHom.complex].At[k := z].Bijective[pullback e] :=
  \parent.\parent.On[e := e].With[coefficients := coefficients].At[z := z].bijective;
