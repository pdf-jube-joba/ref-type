\import BackwardMaps.Composition[B := Source.complex] \as LeftComposition;
\import ForwardMaps.Composition[B := Target.complex] \as RightComposition;
\import Forward.Composition[C := A, final := source].Reduced[] \as LeftFunctor;
\import Backward.Composition[C := B, final := target].Reduced[] \as RightFunctor;
\definition forward: ForwardMaps.Map := Forward.Reduced[].map e.forward ((Geometry.laws source target e).forwardContinuous);
\definition backward: BackwardMaps.Map := Backward.Reduced[].map e.backward ((Geometry.laws source target e).backwardContinuous);
\module Homology(z: I.Int^);
\module With(coefficients: Modules.Bundle);
