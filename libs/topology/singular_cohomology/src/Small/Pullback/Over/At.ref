\definition small: \forall (continuous: Continuous) (sigma: DomainSimplices.Carrier n) ->
  \In[WholeSimplices.Carrier n] (TargetSimplices.Small n) (WholeMaps.postcompose n f continuous sigma) := \block {
  \fun (continuous: Continuous)(sigma: DomainSimplices.Carrier n) \then
  \takefrom w: DomainSimplices.Witness[n, sigma] \by DomainSimplices.witness n sigma \then
  \return Sets.pullbackElim f family ((w).element) (\exists TargetSimplices.Witness[n, WholeMaps.postcompose n f continuous sigma])
    (\fun (U: \Pow A)(member: \In[\Pow A] family U)(same: (w).element = Sets.Preimage f U) =>
      \exact(TargetSimplices.Witness[n, WholeMaps.postcompose n f continuous sigma] {
        element := U, member := member,
        contained := \idelim (w).element = Sets.Preimage f U
          \with V: \Pow B => \forall (x: Simplex.Carrier n) -> \In[B] V (sigma x) \by {
            base: (w).contained, equality: same
          },
      }, TargetSimplices.Witness[n, WholeMaps.postcompose n f continuous sigma])) ((w).member)
};
\definition postcompose[continuous: Continuous][sigma: DomainSimplices.Carrier n]: TargetSimplices.Carrier n :=
  \into[WholeSimplices.Carrier n](WholeMaps.postcompose n f continuous sigma, TargetSimplices.Small n) \by { small continuous sigma };
