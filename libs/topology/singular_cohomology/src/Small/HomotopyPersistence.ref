\import \parent.At[n := n] \as Degree;
\import \parent.At[n := N.Nat^::succ n] \as Higher;
\import \parent.Persistence[n := n] \as Persistence;
\import \parent.Subdivision[].At[n := n].Inclusion[] \as Preserve;
\import \root.Subdivision[A := A, source := source].At[n := n] \as Original;
\import \root.Subdivision[A := A, source := source].Iterated[].At[n := n] \as Powers;
\import N.Basic[].Prop[] \as Bounds;
\definition law: \forall (r: N.Nat^)(x: Whole.Carrier n) -> Degree.Image x -> Higher.Image (#apply{(Powers.homotopyMap r)} x) :=
  \induction (r: N.Nat^) \return \forall (x: Whole.Carrier n) -> Degree.Image x -> Higher.Image (#apply{(Powers.homotopyMap r)} x) \with {
    | zero: \fun (x: Whole.Carrier n)(member: Degree.Image x) => #zero{Higher.submodule}
    | succ: \fun (r: N.Nat^)(previous: \forall (x: Whole.Carrier n) -> Degree.Image x -> Higher.Image (#apply{(Powers.homotopyMap r)} x))(x: Whole.Carrier n)(member: Degree.Image x) =>
        #addition{Higher.submodule} (#apply{Original.homotopyMap} (Powers.apply r x)) (#apply{(Powers.homotopyMap r)} x)
          (Preserve.homotopyPreserves (Powers.apply r x) (Persistence.law x N.Nat^::zero member r (Bounds.zeroLe r))) (previous x member)
  };
