\import \root.Subdivision[A := A, source := source] \as WholeSubdivision;
\import \parent.Simplices[] \as SmallSimplices;
\module InSubset(n: N.Nat^, U: \Cast[\Pow A] family);
\module At(n: N.Nat^);
\module Successor(n: N.Nat^);
\module Zero;
\definition chainMap: Complexes.Map[C := complex, D := complex].Map := Complexes.Map[C := complex, D := complex].Map {
  apply := \fun (n: N.Nat^) => #apply{At[n := n].map},
  addition := \fun (n: N.Nat^) => #addition{At[n := n].map},
  scalar := \fun (n: N.Nat^) => #scalar{At[n := n].map},
  commutes := \fun (n: N.Nat^) => Successor[n := n].commutes,
};
\import Complexes.Homotopy[C := complex, D := complex] \as NativeHomotopy;
\import Complexes.End[C := complex] \as Identity;
\definition data: NativeHomotopy.Data := NativeHomotopy.Data { apply := \fun (n: N.Nat^) => #apply{At[n := n].homotopyMap} };
\definition homotopy: NativeHomotopy.Homotopy chainMap Identity.identity := \into[NativeHomotopy.Data](data, NativeHomotopy.Homotopy chainMap Identity.identity) \by {
  NativeHomotopy.Laws[chainMap, Identity.identity, data] {
    addition := \fun (n: N.Nat^) => #addition{At[n := n].homotopyMap},
    scalar := \fun (n: N.Nat^) => #scalar{At[n := n].homotopyMap},
    zeroEquation := Zero[].law,
    successorEquation := \fun (n: N.Nat^) => Successor[n := n].law,
  }
};
