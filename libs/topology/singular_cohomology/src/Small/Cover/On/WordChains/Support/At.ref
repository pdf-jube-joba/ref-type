\import Words.Fixed[r := r] \as Fixed;
\import Modules.Free[Generators := Words.Word].Subset[S := Fixed.Words].Into[W := Whole.Carrier n, target := Whole.space n] \as Extend;
\definition generators: Selection.SmallAfter r -> \forall (word: \Cast[Words.Word] Fixed.Words) -> Submodules.Member submodule ((map).apply (Words.generator word)) :=
  \fun (small: Selection.SmallAfter r)(word: \Cast[Words.Word] Fixed.Words) => \block {
    \let tau: SmallSimplices.Carrier n := \into[WholeSimplices.Carrier n](simplex (Iteration.vertices Selection.basis word), SmallSimplices.Small n) \by { small word (\bysub(Words.Word, Fixed.Words, word)) } \then
    \return transport!{{Whole.Carrier n}} (\fun (x: Whole.Carrier n) => Submodules.Member submodule x) _ _ (sym!{{Whole.Carrier n}} _ _ (onGenerator word)) (generatorImage tau)
  };
\definition law: Selection.SmallAfter r -> SmallDegree.Image ((map).apply (Words.wordChain r)) :=
  \fun (small: Selection.SmallAfter r) => Extend.law map submodule (generators small) (Words.wordChain r) (Words.Length[].law r);
