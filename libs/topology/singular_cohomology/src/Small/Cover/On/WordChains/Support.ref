\use Equality.transport;
\import Modules.Of[V := Whole.Carrier n, space := Whole.space n].Submodule[] \as Submodules;
\definition submodule: Submodules.Submodule := SmallDegree.submodule;
\definition generatorImage: \forall (tau: SmallSimplices.Carrier n) -> Submodules.Member submodule (Whole.generator n tau) := SmallDegree.generatorImage;
\module At(r: N.Nat^);
\definition eventual: Global.IsOpenCover[source, family, Global.Whole] -> \exists { r: N.Nat^ \where SmallDegree.Image (Powers.apply r (Whole.generator n sigma)) } := \block {
  \fun (cover: Global.IsOpenCover[source, family, Global.Whole]) \then
  \takefrom r: \Cast[N.Nat^] ({ r: N.Nat^ \where Selection.SmallAfter r }) \by Selection.law cover \then
  \return Logic.existsIntro[N.Nat^, { r: N.Nat^ \where SmallDegree.Image (Powers.apply r (Whole.generator n sigma)) }] r
    (transport!{{Whole.Carrier n}} SmallDegree.Image _ _ (law r) (At[r := r].law (\bysub(N.Nat^, { r: N.Nat^ \where Selection.SmallAfter r }, r))))
};
