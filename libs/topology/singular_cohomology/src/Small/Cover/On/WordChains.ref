\import std.Data[].List[] \as Lists;
\import \parent.Eventually[] \as Selection;
\import \root.SubdivisionCells[].Words[n := n] \as Words;
\import Words.Evaluation[k := n] \as WordEvaluation;
\import Cells.At[n := n].Iterated[k := n] \as Iteration;
\import Geometry.At[m := n] \as Evaluation;
\import \root.Simplices[A := Simplex.Carrier n, source := Domain.topology] \as GeometricSimplices;
\import \parent.\parent.\parent.At[n := n] \as SmallDegree;
\import \root.OrderedTuples[V := Simplex.Carrier n] \as Tuples;
\import \root.Chains[A := Simplex.Carrier n, source := Domain.topology] \as GeometricChains;
\import \root.Subdivision[A := Simplex.Carrier n, source := Domain.topology] \as GeometricSubdivision;
\import \root.Subdivision[A := A, source := source] \as WholeSubdivision;
\import WholeSubdivision.At[n := n] \as WholeDegree;
\import WholeSubdivision.Iterated[].At[n := n] \as Powers;
\import GeometricSubdivision.Natural[B := A, target := source].At[n := n] \as Natural;
\import Modules.Hom[V := Tuples.Carrier (N.Nat^::succ n), W := GeometricChains.Carrier n, source := Tuples.space (N.Nat^::succ n), target := GeometricChains.space n].Composition[U := Words.Carrier, domain := Words.space] \as First;
\import Modules.Hom[V := GeometricChains.Carrier n, W := Whole.Carrier n, source := GeometricChains.space n, target := Whole.space n].Composition[U := Words.Carrier, domain := Words.space] \as Second;
\definition geometric: Modules.Hom[V := Words.Carrier, W := GeometricChains.Carrier n, source := Words.space, target := GeometricChains.space n].Map := First.compose Evaluation.map (WordEvaluation.map Selection.basis);
\definition map: Modules.Hom[V := Words.Carrier, W := Whole.Carrier n, source := Words.space, target := Whole.space n].Map := Second.compose (Push.At[n := n].push sigma continuous) geometric;
\definition onGenerator: \forall (word: Words.Word) -> #apply{map} (Words.generator word) = Whole.generator n (simplex (Iteration.vertices Selection.basis word)) :=
  \fun (word: Words.Word) => trans!{{Whole.Carrier n}} _ _ _
    (congr!{{Tuples.Carrier (N.Nat^::succ n)} {Whole.Carrier n}} (\fun (x: Tuples.Carrier (N.Nat^::succ n)) => #apply{(Push.At[n := n].push sigma continuous)} (#apply{Evaluation.map} x)) _ _ (WordEvaluation.onGenerator Selection.basis word))
    (trans!{{Whole.Carrier n}} _ _ _ (congr!{{GeometricChains.Carrier n} {Whole.Carrier n}} (#apply{(Push.At[n := n].push sigma continuous)}) _ _ (Evaluation.onGenerator (Iteration.vertices Selection.basis word)))
      (Push.At[n := n].onGenerator sigma continuous (Evaluation.onTuple (Iteration.vertices Selection.basis word))));
\definition commutes: \forall (x: Words.Carrier) -> #apply{map} (#apply{Words.step} x) = #apply{WholeDegree.map} (#apply{map} x) :=
  \fun (x: Words.Carrier) => trans!{{Whole.Carrier n}} _ _ _
    (congr!{{Tuples.Carrier (N.Nat^::succ n)} {Whole.Carrier n}} (\fun (y: Tuples.Carrier (N.Nat^::succ n)) => #apply{(Push.At[n := n].push sigma continuous)} (#apply{Evaluation.map} y)) _ _ (WordEvaluation.Comparison[].law Selection.basis x))
    (trans!{{Whole.Carrier n}} _ _ _
      (congr!{{GeometricChains.Carrier n} {Whole.Carrier n}} (#apply{(Push.At[n := n].push sigma continuous)}) _ _ (Geometry.SubdivisionCompare[m := n].law (#apply{(WordEvaluation.map Selection.basis)} x)))
      (Natural.law sigma continuous (#apply{geometric} x)));
\import Geometry.Fundamental[] \as Fundamental;
\definition identitySimplex: simplex Selection.basis = sigma := trans!{{WholeSimplices.Carrier n}} _ _ _
  (congr!{{GeometricSimplices.Carrier n} {WholeSimplices.Carrier n}} (Push.postcompose n sigma continuous) _ _ Fundamental.onTuple) (WholeDegree.originalSimplex sigma);
\definition zero: #apply{map} (Words.wordChain N.Nat^::zero) = Whole.generator n sigma :=
  trans!{{Whole.Carrier n}} _ _ _ (onGenerator Lists.List[Cells.Cell n]::nil) (congr!{{WholeSimplices.Carrier n} {Whole.Carrier n}} (Whole.generator n) _ _ identitySimplex);
\definition law: \forall (r: N.Nat^) -> #apply{map} (Words.wordChain r) = Powers.apply r (Whole.generator n sigma) :=
  \induction (r: N.Nat^) \return #apply{map} (Words.wordChain r) = Powers.apply r (Whole.generator n sigma) \with {
    | zero: zero
    | succ: \fun (r: N.Nat^)(previous: #apply{map} (Words.wordChain r) = Powers.apply r (Whole.generator n sigma)) => trans!{{Whole.Carrier n}} _ _ _ (commutes (Words.wordChain r))
        (congr!{{Whole.Carrier n} {Whole.Carrier n}} (#apply{WholeDegree.map}) _ _ previous)
  };
\module Support;
