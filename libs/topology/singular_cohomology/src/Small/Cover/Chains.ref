\import \parent.\parent.At[n := n] \as Degree;
\import \parent.\parent.Persistence[n := n] \as Persistence;
\import \root.Subdivision[A := A, source := source].Iterated[].At[n := n] \as Powers;
\import Modules.Free[Generators := WholeSimplices.Carrier n].Induction[] \as Induction;
\import Modules.Laws[V := Whole.Carrier n, space := Whole.space n] \as Values;
\import Modules.Hom[V := Whole.Carrier n, W := Whole.Carrier n, source := Whole.space n, target := Whole.space n] \as Linear;
\import Modules.Of[V := Whole.Carrier n, space := Whole.space n].Submodule[] \as Submodules;
\import N.Basic[].Prop[] \as Bounds;
\import N.Order[].Prop[] \as Order;
\use Equality.transport;
\definition Eventually[x: Whole.Carrier n]: \Prop := \exists ( r: N.Nat^ \where Persistence.Persistent x r );
\module Closure;
\definition basis: Global.IsOpenCover[source, family, Global.Whole] -> \forall (sigma: WholeSimplices.Carrier n) -> Eventually (Whole.generator n sigma) := \block {
  \fun (cover: Global.IsOpenCover[source, family, Global.Whole])(sigma: WholeSimplices.Carrier n) \then
  \takefrom r: \Cast[N.Nat^] ({ r: N.Nat^ \where Degree.Image (Powers.apply r (Whole.generator n sigma)) }) \by \parent.On[sigma := sigma].WordChains[].Support[].eventual cover \then
  \return Logic.existsIntro[N.Nat^, { r: N.Nat^ \where Persistence.Persistent (Whole.generator n sigma) r }] r
    (Persistence.law (Whole.generator n sigma) r (\bysub(N.Nat^, { r: N.Nat^ \where Degree.Image (Powers.apply r (Whole.generator n sigma)) }, r)))
};
\definition law: Global.IsOpenCover[source, family, Global.Whole] -> \forall (x: Whole.Carrier n) -> Eventually x :=
  \fun (cover: Global.IsOpenCover[source, family, Global.Whole]) => Induction.law Eventually Closure[].zero (basis cover) Closure[].addition Closure[].negative Closure[].scalar;
\definition existence: Global.IsOpenCover[source, family, Global.Whole] -> \forall (x: Whole.Carrier n) -> \exists ( r: N.Nat^ \where Degree.Image (Powers.apply r x) ) := \block {
  \fun (cover: Global.IsOpenCover[source, family, Global.Whole])(x: Whole.Carrier n) \then
  \takefrom r: \Cast[N.Nat^] ({ r: N.Nat^ \where Persistence.Persistent x r }) \by law cover x \then
  \return Logic.existsIntro[N.Nat^, { r: N.Nat^ \where Degree.Image (Powers.apply r x) }] r
    ((\bysub(N.Nat^, { r: N.Nat^ \where Persistence.Persistent x r }, r)) r (Bounds.leRefl r))
};
