\import \parent.At[n := n] \as Lower;
\import \parent.At[n := N.Nat^::succ n] \as Higher;
\import \parent.\parent.At[n := n] \as SmallDegree;
\definition commutes: \forall (x: SubspaceChains.Carrier (N.Nat^::succ n)) -> (complex.differential).apply n ((Higher.map).apply x) = (Lower.map).apply ((SubspaceChains.boundary n).apply x) :=
  \fun (x: SubspaceChains.Carrier (N.Nat^::succ n)) => SmallDegree.injective _ _
    (trans!{{Whole.Carrier n}} _ _ _ (sym!{{Whole.Carrier n}} _ _ ((inclusion).commutes n ((Higher.map).apply x)))
      (trans!{{Whole.Carrier n}} _ _ _ (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier n}} ((Whole.boundary n).apply) _ _ (Higher.law x))
        (trans!{{Whole.Carrier n}} _ _ _ ((Inclusion.push inclusionFunction continuous).commutes n x)
          (sym!{{Whole.Carrier n}} _ _ (Lower.law ((SubspaceChains.boundary n).apply x))))));
