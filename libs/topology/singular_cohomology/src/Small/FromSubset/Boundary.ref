\import \parent.At[n := n] \as Lower;
\import \parent.At[n := N.Nat^::succ n] \as Higher;
\import \parent.\parent.At[n := n] \as SmallDegree;
\definition commutes: \forall (x: SubspaceChains.Carrier (N.Nat^::succ n)) -> #apply{complex.differential} n (#apply{Higher.map} x) = #apply{Lower.map} (#apply{(SubspaceChains.boundary n)} x) :=
  \fun (x: SubspaceChains.Carrier (N.Nat^::succ n)) => SmallDegree.injective _ _
    (trans!{{Whole.Carrier n}} _ _ _ (sym!{{Whole.Carrier n}} _ _ (#commutes{inclusion} n (#apply{Higher.map} x)))
      (trans!{{Whole.Carrier n}} _ _ _ (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier n}} (#apply{(Whole.boundary n)}) _ _ (Higher.law x))
        (trans!{{Whole.Carrier n}} _ _ _ (#commutes{(Inclusion.push inclusionFunction continuous)} n x)
          (sym!{{Whole.Carrier n}} _ _ (Lower.law (#apply{(SubspaceChains.boundary n)} x))))));
