\import \parent.\parent.At[n := n] \as SmallDegree;
\import \parent.\parent.At[n := N.Nat^::succ n] \as SmallHigher;
\import WholeSubdivision.At[n := n] \as WholeDegree;
\definition subdivisionImage: \forall (sigma: SmallSimplices.Carrier n) -> SmallDegree.Image (WholeDegree.onSimplex sigma) := \block {
  \fun (sigma: SmallSimplices.Carrier n) \then
  \takefrom w: SmallSimplices.Witness[n, sigma] \by SmallSimplices.witness n sigma \then
  \let U: \Cast[\Pow A] family := \into[\Pow A](#element{w}, family) \by { #member{w} } \then
  \return \parent.InSubset[n := n, U := U].subdivision sigma (#contained{w})
};
\definition homotopyImage: \forall (sigma: SmallSimplices.Carrier n) -> SmallHigher.Image (WholeDegree.homotopyOnSimplex sigma) := \block {
  \fun (sigma: SmallSimplices.Carrier n) \then
  \takefrom w: SmallSimplices.Witness[n, sigma] \by SmallSimplices.witness n sigma \then
  \let U: \Cast[\Pow A] family := \into[\Pow A](#element{w}, family) \by { #member{w} } \then
  \return \parent.InSubset[n := n, U := U].homotopy sigma (#contained{w})
};
\definition onSimplex(sigma: SmallSimplices.Carrier n): Carrier n := #apply{SmallDegree.retraction} (WholeDegree.onSimplex sigma);
\definition homotopyOnSimplex(sigma: SmallSimplices.Carrier n): Carrier (N.Nat^::succ n) := #apply{SmallHigher.retraction} (WholeDegree.homotopyOnSimplex sigma);
\import Modules.Free[Generators := SmallSimplices.Carrier n].To[W := Carrier n, target := space n] \as Free;
\import Modules.Free[Generators := SmallSimplices.Carrier n].To[W := Carrier (N.Nat^::succ n), target := space (N.Nat^::succ n)] \as Shift;
\definition map: Modules.Hom[V := Carrier n, W := Carrier n, source := space n, target := space n].Map := Free.extension onSimplex;
\definition homotopyMap: Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)].Map := Shift.extension homotopyOnSimplex;
\definition onGenerator: \forall (sigma: SmallSimplices.Carrier n) -> #apply{map} (generator n sigma) = onSimplex sigma := Free.onGenerator onSimplex;
\definition homotopyOnGenerator: \forall (sigma: SmallSimplices.Carrier n) -> #apply{homotopyMap} (generator n sigma) = homotopyOnSimplex sigma := Shift.onGenerator homotopyOnSimplex;
\module Inclusion;
