\import Modules.Hom[V := Carrier n, W := Whole.Carrier n, source := space n, target := Whole.space n].Composition[U := Carrier n, domain := space n] \as Left;
\import Modules.Hom[V := Whole.Carrier n, W := Whole.Carrier n, source := Whole.space n, target := Whole.space n].Composition[U := Carrier n, domain := space n] \as Right;
\import Modules.Free[Generators := SmallSimplices.Carrier n].To[W := Whole.Carrier n, target := Whole.space n] \as ToWhole;
\definition equation: Left.compose SmallDegree.inclusion map = Right.compose WholeDegree.map SmallDegree.inclusion :=
  ToWhole.ext _ _ (\fun (sigma: SmallSimplices.Carrier n) => trans!{{Whole.Carrier n}} _ _ _
    (congr!{{Carrier n} {Whole.Carrier n}} (#apply{SmallDegree.inclusion}) _ _ (onGenerator sigma))
    (trans!{{Whole.Carrier n}} _ _ _ (SmallDegree.imageRetract (WholeDegree.onSimplex sigma) (subdivisionImage sigma))
      (trans!{{Whole.Carrier n}} _ _ _ (sym!{{Whole.Carrier n}} _ _ (WholeDegree.onGenerator sigma))
        (congr!{{Whole.Carrier n} {Whole.Carrier n}} (#apply{WholeDegree.map}) _ _ (sym!{{Whole.Carrier n}} _ _ (SmallDegree.onGenerator sigma))))));
\import Modules.Hom[V := Carrier n, W := Whole.Carrier n, source := space n, target := Whole.space n] \as Linear;
\definition law: \forall (x: Carrier n) -> #apply{SmallDegree.inclusion} (#apply{map} x) = #apply{WholeDegree.map} (#apply{SmallDegree.inclusion} x) :=
  \fun (x: Carrier n) => congr!{Linear.Map {Whole.Carrier n}} (\fun (f: Linear.Map) => #apply{f} x) _ _ equation;
\definition preserves: \forall (z: Whole.Carrier n) -> SmallDegree.Image z -> SmallDegree.Image (#apply{WholeDegree.map} z) := \block {
  \fun (z: Whole.Carrier n)(member: SmallDegree.Image z) \then
  \takefrom x: \Cast[Carrier n] ({ x: Carrier n \where #apply{SmallDegree.inclusion} x = z }) \by member \then
  \return Logic.existsIntro[Carrier n, { y: Carrier n \where #apply{SmallDegree.inclusion} y = #apply{WholeDegree.map} z }] (#apply{map} x)
    (trans!{{Whole.Carrier n}} _ _ _ (law x) (congr!{{Whole.Carrier n} {Whole.Carrier n}} (#apply{WholeDegree.map}) _ _ (\bysub(Carrier n, { x: Carrier n \where #apply{SmallDegree.inclusion} x = z }, x))))
};
\import Modules.Hom[V := Carrier (N.Nat^::succ n), W := Whole.Carrier (N.Nat^::succ n), source := space (N.Nat^::succ n), target := Whole.space (N.Nat^::succ n)].Composition[U := Carrier n, domain := space n] \as ShiftLeft;
\import Modules.Hom[V := Whole.Carrier n, W := Whole.Carrier (N.Nat^::succ n), source := Whole.space n, target := Whole.space (N.Nat^::succ n)].Composition[U := Carrier n, domain := space n] \as ShiftRight;
\import Modules.Free[Generators := SmallSimplices.Carrier n].To[W := Whole.Carrier (N.Nat^::succ n), target := Whole.space (N.Nat^::succ n)] \as ShiftToWhole;
\definition homotopyEquation: ShiftLeft.compose SmallHigher.inclusion homotopyMap = ShiftRight.compose WholeDegree.homotopyMap SmallDegree.inclusion :=
  ShiftToWhole.ext _ _ (\fun (sigma: SmallSimplices.Carrier n) => trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)}} (#apply{SmallHigher.inclusion}) _ _ (homotopyOnGenerator sigma))
    (trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _ (SmallHigher.imageRetract (WholeDegree.homotopyOnSimplex sigma) (homotopyImage sigma))
      (trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _ (sym!{{Whole.Carrier (N.Nat^::succ n)}} _ _ (WholeDegree.homotopyOnGenerator sigma))
        (congr!{{Whole.Carrier n} {Whole.Carrier (N.Nat^::succ n)}} (#apply{WholeDegree.homotopyMap}) _ _ (sym!{{Whole.Carrier n}} _ _ (SmallDegree.onGenerator sigma))))));
\import Modules.Hom[V := Carrier n, W := Whole.Carrier (N.Nat^::succ n), source := space n, target := Whole.space (N.Nat^::succ n)] \as ShiftLinear;
\definition homotopyLaw: \forall (x: Carrier n) -> #apply{SmallHigher.inclusion} (#apply{homotopyMap} x) = #apply{WholeDegree.homotopyMap} (#apply{SmallDegree.inclusion} x) :=
  \fun (x: Carrier n) => congr!{ShiftLinear.Map {Whole.Carrier (N.Nat^::succ n)}} (\fun (f: ShiftLinear.Map) => #apply{f} x) _ _ homotopyEquation;
\definition homotopyPreserves: \forall (z: Whole.Carrier n) -> SmallDegree.Image z -> SmallHigher.Image (#apply{WholeDegree.homotopyMap} z) := \block {
  \fun (z: Whole.Carrier n)(member: SmallDegree.Image z) \then
  \takefrom x: \Cast[Carrier n] ({ x: Carrier n \where #apply{SmallDegree.inclusion} x = z }) \by member \then
  \return Logic.existsIntro[Carrier (N.Nat^::succ n), { y: Carrier (N.Nat^::succ n) \where #apply{SmallHigher.inclusion} y = #apply{WholeDegree.homotopyMap} z }] (#apply{homotopyMap} x)
    (trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _ (homotopyLaw x) (congr!{{Whole.Carrier n} {Whole.Carrier (N.Nat^::succ n)}} (#apply{WholeDegree.homotopyMap}) _ _ (\bysub(Carrier n, { x: Carrier n \where #apply{SmallDegree.inclusion} x = z }, x))))
};
