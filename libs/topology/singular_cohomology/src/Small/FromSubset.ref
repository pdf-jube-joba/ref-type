\import topology.Topology[Carrier := A].Subspace[S := U] \as Subspace;
\import \root.Simplices[A := Subspace.CarrierSet, source := Subspace.topology source] \as SubspaceSimplices;
\import \root.Chains[A := Subspace.CarrierSet, source := Subspace.topology source] \as SubspaceChains;
\import \root.Maps[A := Subspace.CarrierSet, B := A, source := Subspace.topology source, target := source] \as Inclusion;
\import \parent.Simplices[] \as SmallSimplices;
\definition member: \In[\Pow A] family U := \bysub(\Pow A, family, U);
\definition inclusionFunction(x: Subspace.CarrierSet): A := x;
\import topology.Continuity[A := Subspace.CarrierSet, B := A].Corestriction[S := U] \as Into;
\definition continuous: Inclusion.Continuous inclusionFunction := Into.inclusionContinuous source;
\module At(n: N.Nat^);
\module Boundary(n: N.Nat^);
\definition map: Complexes.Map[C := SubspaceChains.complex, D := complex].Map := Complexes.Map[C := SubspaceChains.complex, D := complex].Map {
  apply := \fun (n: N.Nat^) => #apply{At[n := n].map},
  addition := \fun (n: N.Nat^) => #addition{At[n := n].map},
  scalar := \fun (n: N.Nat^) => #scalar{At[n := n].map},
  commutes := \fun (n: N.Nat^) => Boundary[n := n].commutes,
};
