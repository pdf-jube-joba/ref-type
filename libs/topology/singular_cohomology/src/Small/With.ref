\import \root.Cochains[A := A, source := source].With[coefficients := coefficients] \as WholeCochains;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.On[P := Native.complex, N := coefficients] \as Cochains;
\import Hom.Mapping[P := Native.complex, Q := Whole.complex, N := coefficients, L := coefficients] \as Mapping;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficients;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as CochainComplexes;
\definition complex: CochainComplexes.Complex := Cochains.complex;
\definition restriction: CochainComplexes.Map[C := WholeCochains.complex, D := Cochains.complex].Map := Mapping.On[f := inclusion, u := Coefficients.identity].map;
\module At(n: N.Nat^) {
  \import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring].At[C := Cochains.complex, k := n] \as Native;
  \definition Carrier: \Set := Native.Cohomology;
  \definition space: Modules.Space Carrier := Native.cohomologySpace;
}
