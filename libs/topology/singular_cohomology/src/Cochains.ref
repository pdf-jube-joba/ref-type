\import std.Arithmetic[].Int[] \as Scalars;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import module_theory.Module[].Over[R := Scalars.Int^, ring := IntegerRing.ring] \as IntegerModules;
\module With(coefficients: IntegerModules.Bundle);
\module Abelian(V: \Set, group: std.Alg[].Alg[].CommutativeGroup[V]) {
  \import module_theory.Module[].IntegerGroup[Carrier := V, group := group] \as Integers;
  \definition coefficients: IntegerModules.Bundle := IntegerModules.Bundle { Carrier := V, space := Integers.space };
  \import \parent.With[coefficients := coefficients] \as Theory;
  \definition cohomology: std.Data[].Nat[].Nat^ -> \Set := Theory.cohomology;
  \definition cohomologySpace(n: std.Data[].Nat[].Nat^): IntegerModules.Space (cohomology n) := Theory.cohomologySpace n;
}
