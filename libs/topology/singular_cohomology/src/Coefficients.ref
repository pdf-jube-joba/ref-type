\import std.Arithmetic[].Int[] \as I;
\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import \root.Chains[A := A, source := source] \as Chains;
\import \root.Simplices[A := A, source := source] \as Simplices;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].End[C := Chains.complex] \as Identity;
\module Sequence(L, M, R: Modules.Bundle) {
  \import Modules.ShortExact[A := L, B := M, C := R] \as Coefficients;
  \import Hom.On[P := Chains.complex, N := L] \as Left;
  \import Hom.On[P := Chains.complex, N := M] \as Middle;
  \import Hom.On[P := Chains.complex, N := R] \as Right;
  \import Hom.Mapping[P := Chains.complex, Q := Chains.complex, N := L, L := M] \as Inclusion;
  \import Hom.Mapping[P := Chains.complex, Q := Chains.complex, N := M, L := R] \as Projection;
  \import Cochains.ShortExact[A := Left.complex, B := Middle.complex, C := Right.complex] \as Exact;
  \module On(s: Coefficients.Sequence);
}
