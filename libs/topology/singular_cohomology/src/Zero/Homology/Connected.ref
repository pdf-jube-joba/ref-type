\import \root.Zero[A := A, source := source].Homology[] \as Homology;
\import FreeComponents.Singleton[point := Components.class point] \as Scalars;
\definition unique: Components.PathConnected -> Scalars.Unique :=
  \fun (connected: Components.PathConnected) => Components.induction (\fun (c: Components.Carrier) => c = Components.class point)
    (\fun (x: A) => Components.sameClass x point (connected x point));
\import Modules.Isomorphism[V := H.Homology, W := FreeComponents.Carrier, source := H.homologySpace, target := FreeComponents.space].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := I.Int^, W := FreeComponents.Carrier, source := Modules.scalarModule, target := FreeComponents.space]
  .Composition[U := H.Homology, final := H.homologySpace] \as Composition;
\definition isomorphism(connected: Components.PathConnected): Modules.Isomorphism[V := I.Int^, W := H.Homology, source := Modules.scalarModule, target := H.homologySpace].Isomorphism :=
  Composition.compose (Inverse.inverse Homology.isomorphism) (Scalars.isomorphism (unique connected));
\definition onOne: \forall (connected: Components.PathConnected) -> #apply{#forward{(isomorphism connected)}} #one{Integers.ring} = Homology.pointClass point :=
  \fun (connected: Components.PathConnected) => trans!{H.Homology} _ _ _
    (congr!{{FreeComponents.Carrier} H.Homology} (#apply{Homology.backward}) _ _ Scalars.onOne)
    (trans!{H.Homology} _ _ _ (Homology.backwardOnGenerator (Components.class point)) (Homology.componentOnClass point));
