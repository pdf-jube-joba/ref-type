\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import \root.Simplices[A := A, source := source] \as Source;
\import \root.Simplices[A := B, source := target] \as Target;
\import \root.Chains[A := A, source := source] \as Domain;
\import \root.Chains[A := B, source := target] \as Codomain;
\import \root.Maps[A := A, B := B, source := source, target := target] \as Maps;
\import algebraic_topology.Homotopy[A := A, B := B] \as Topological;
\import algebraic_topology.Simplex[] \as Simplex;
\definition Family(f, g: A -> B): \Set := Topological.Homotopy[source, target, f, g];
\definition startContinuous(f, g: A -> B)(h: Family f g): Maps.Continuous f := Topological.startContinuous source target f g h;
\definition endContinuous(f, g: A -> B)(h: Family f g): Maps.Continuous g := Topological.endContinuous source target f g h;
\module At(n: N.Nat^);
\module Successor(n: N.Nat^);
\module Zero;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].Homotopy[C := Domain.complex, D := Codomain.complex] \as Native;
\definition data(f, g: A -> B)(h: Family f g): Native.Data := Native.Data {
  apply := \fun (n: N.Nat^) => #apply{(At[n := n].map f g h)},
};
\definition homotopy(f, g: A -> B)(h: Family f g): Native.Homotopy (Maps.push g (endContinuous f g h)) (Maps.push f (startContinuous f g h)) :=
  \into[Native.Data](data f g h, Native.Homotopy (Maps.push g (endContinuous f g h)) (Maps.push f (startContinuous f g h))) \by {
    Native.Laws[Maps.push g (endContinuous f g h), Maps.push f (startContinuous f g h), data f g h] {
      addition := \fun (n: N.Nat^) => #addition{(At[n := n].map f g h)},
      scalar := \fun (n: N.Nat^) => #scalar{(At[n := n].map f g h)},
      zeroEquation := Zero[].law f g h,
      successorEquation := \fun (n: N.Nat^) => Successor[n := n].Equation[].law f g h,
    }
  };
\module Coefficients(M: Modules.Bundle);
