\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import algebraic_topology.Contraction[A := A, source := source] \as Geometry;
\import topology.Topology[Carrier := Geometry.Point] \as PointSpace;
\import \root.Cochains[A := Geometry.Point, source := PointSpace.Discrete].With[coefficients := coefficients] \as PointCochains;
\import \root.Calculations[A := Geometry.Point, source := PointSpace.Discrete].With[coefficients := coefficients].Singleton[a := Geometry.Point::point] \as Point;
\import \root.Equivalence[A := A, B := Geometry.Point, source := source, target := PointSpace.Discrete].With[coefficients := coefficients] \as Comparison;
\module At(n: N.Nat^) {
  \import Modules.Isomorphism[V := Cochains.cohomology n, W := PointCochains.cohomology n, source := Cochains.cohomologySpace n, target := PointCochains.cohomologySpace n] \as Iso;
  \definition isomorphism[c: Geometry.Data]: Iso.Isomorphism := Comparison.At[n := n].isomorphism (Geometry.pointEquivalence c);
}
\module Positive(n: N.Nat^) {
  \import \parent.At[n := N.Nat^::succ n] \as Comparison;
  \import Modules.Hom[V := PointCochains.cohomology (N.Nat^::succ n), W := Cochains.cohomology (N.Nat^::succ n), source := PointCochains.cohomologySpace (N.Nat^::succ n), target := Cochains.cohomologySpace (N.Nat^::succ n)] \as Backward;
  \definition zero: \forall (c: Geometry.Data)(q: Cochains.cohomology (N.Nat^::succ n)) -> q = (Cochains.cohomologySpace (N.Nat^::succ n)).zero :=
    \fun (c: Geometry.Data)(q: Cochains.cohomology (N.Nat^::succ n)) => \block {
      \let e: Modules.Isomorphism[V := Cochains.cohomology (N.Nat^::succ n), W := PointCochains.cohomology (N.Nat^::succ n), source := Cochains.cohomologySpace (N.Nat^::succ n), target := PointCochains.cohomologySpace (N.Nat^::succ n)].Isomorphism := Comparison.isomorphism c \then
      \return trans!{{Cochains.cohomology (N.Nat^::succ n)}} _ _ _ (sym!{{Cochains.cohomology (N.Nat^::succ n)}} _ _ ((e).leftInverse q))
        (trans!{{Cochains.cohomology (N.Nat^::succ n)}} _ _ _
          (congr!{{PointCochains.cohomology (N.Nat^::succ n)} {Cochains.cohomology (N.Nat^::succ n)}} (((e).backward).apply) _ _
            (Point.positiveCohomology Geometry.pointUnique n (((e).forward).apply q)))
          (Backward.zeroPreserved (e).backward))
    };
}
\definition positiveCohomology: \forall (c: Geometry.Data)(n: N.Nat^)(q: Cochains.cohomology (N.Nat^::succ n)) -> q = (Cochains.cohomologySpace (N.Nat^::succ n)).zero :=
  \fun (c: Geometry.Data)(n: N.Nat^) => Positive[n := n].zero c;
\import Modules.Isomorphism[V := Cochains.cohomology N.Nat^::zero, W := PointCochains.cohomology N.Nat^::zero, source := Cochains.cohomologySpace N.Nat^::zero, target := PointCochains.cohomologySpace N.Nat^::zero].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := coefficients.Carrier, W := PointCochains.cohomology N.Nat^::zero, source := coefficients.space, target := PointCochains.cohomologySpace N.Nat^::zero]
  .Composition[U := Cochains.cohomology N.Nat^::zero, final := Cochains.cohomologySpace N.Nat^::zero] \as Compose;
\definition zeroIsomorphism[c: Geometry.Data]: Modules.Isomorphism[V := coefficients.Carrier, W := Cochains.cohomology N.Nat^::zero, source := coefficients.space, target := Cochains.cohomologySpace N.Nat^::zero].Isomorphism :=
  Compose.compose (Inverse.inverse (At[n := N.Nat^::zero].isomorphism c)) (Point.Zero[].isomorphism Geometry.pointUnique);
