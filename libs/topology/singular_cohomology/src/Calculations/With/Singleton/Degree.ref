\import Chains.Boundary[n := n] \as Boundary;
\import Modules.Alternating[V := Chains.Carrier n, space := Chains.space n].Mapping[W := coefficients.Carrier, target := coefficients.space] \as Mapping;
\definition coboundaryOnGenerator: \forall (h: Cochains.Carrier n)(sigma: Simplices.Carrier (N.Nat^::succ n)) ->
  #apply{(Cochains.coboundary n h)} (Chains.generator (N.Nat^::succ n) sigma) =
    Sums.sum (N.Nat^::succ (N.Nat^::succ n)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => #apply{h} (Chains.generator n (Simplices.face n i sigma))) :=
  \fun (h: Cochains.Carrier n)(sigma: Simplices.Carrier (N.Nat^::succ n)) => trans!{coefficients.Carrier} _ _ _
    (congr!{{Chains.Carrier n} coefficients.Carrier} (#apply{h}) _ _ (Boundary.onGenerator sigma))
    (Mapping.law h (N.Nat^::succ (N.Nat^::succ n)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => Chains.generator n (Simplices.face n i sigma)));
\definition constantCoboundary: \forall (v: coefficients.Carrier)(sigma: Simplices.Carrier (N.Nat^::succ n)) ->
  #apply{(Cochains.coboundary n (constant n v))} (Chains.generator (N.Nat^::succ n) sigma) =
    Sums.sum (N.Nat^::succ (N.Nat^::succ n)) (\fun (_: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => v) :=
  \fun (v: coefficients.Carrier)(sigma: Simplices.Carrier (N.Nat^::succ n)) => trans!{coefficients.Carrier} _ _ _
    (coboundaryOnGenerator (constant n v) sigma)
    (Sums.congruent (N.Nat^::succ (N.Nat^::succ n)) _ _ (\fun (i: _) => onGenerator n v (Simplices.face n i sigma)));
