\import Complexes.At[C := Cochains.complex, k := N.Nat^::succ n] \as H;
\import \parent.Degree[n := n] \as Degree;
\import \parent.Degree[n := N.Nat^::succ n] \as NextDegree;
\import Modules.Free[Generators := Simplices.Carrier (N.Nat^::succ n)].To[W := coefficients.Carrier, target := coefficients.space] \as Free;
\definition closedValue: \forall (h: H.CycleCarrier) ->
  Sums.sum (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))
    (\fun (_: Fin.Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) => value (N.Nat^::succ n) h) = Values.zero :=
  \fun (h: H.CycleCarrier) => trans!{coefficients.Carrier} _ _ _
    (sym!{coefficients.Carrier} _ _ (NextDegree.coboundaryOnGenerator h (simplex (N.Nat^::succ (N.Nat^::succ n)))))
    (congr!{{Cochains.Carrier (N.Nat^::succ (N.Nat^::succ n))} coefficients.Carrier}
      (\fun (f: Cochains.Carrier (N.Nat^::succ (N.Nat^::succ n))) => #apply{f} (Chains.generator (N.Nat^::succ (N.Nat^::succ n)) (simplex (N.Nat^::succ (N.Nat^::succ n))))) _ _
      (\bysub(Cochains.Carrier (N.Nat^::succ n), #carrier{H.cycles}, h)));
\definition primitive(h: H.CycleCarrier): Cochains.Carrier n := constant n (value (N.Nat^::succ n) h);
\definition primitiveLaw: Unique -> \forall (h: H.CycleCarrier) -> Cochains.coboundary n (primitive h) = h :=
  \fun (unique: Unique)(h: H.CycleCarrier) => Free.ext (Cochains.coboundary n (primitive h)) h
    (\fun (sigma: Simplices.Carrier (N.Nat^::succ n)) => trans!{coefficients.Carrier} _ _ _
      (Degree.constantCoboundary (value (N.Nat^::succ n) h) sigma)
      (trans!{coefficients.Carrier} _ _ _
        (previousSum (N.Nat^::succ (N.Nat^::succ n)) (value (N.Nat^::succ n) h) (closedValue h))
        (sym!{coefficients.Carrier} _ _ (uniform unique (N.Nat^::succ n) h sigma))));
\definition classZero: Unique -> \forall (h: H.CycleCarrier) -> H.classOf h = H.zeroClass :=
  \fun (unique: Unique)(h: H.CycleCarrier) => H.boundaryClassZero h
    (Logic.existsIntro[Cochains.Carrier n, { g: Cochains.Carrier n \where Cochains.coboundary n g = h }] (primitive h) (primitiveLaw unique h));
\definition zero: Unique -> \forall (q: H.Cohomology) -> q = H.zeroClass :=
  \fun (unique: Unique) => H.classInduction (\fun (q: H.Cohomology) => q = H.zeroClass) (classZero unique);
