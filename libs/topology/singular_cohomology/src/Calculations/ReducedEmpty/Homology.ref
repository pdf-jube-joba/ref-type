\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import std.Logic[].Proposition[] \as Logic;
\definition Empty: \Prop := \forall (x: A) -> Logic.False;
\module Positive(n: N.Nat^) {
  \definition degree: I.Int^ := I.Int^::ofNat n;
  \import Chains.At[C := Reduced.complex, z := degree] \as H;
  \definition zero[empty: Empty]: \forall (q: H.Homology) -> q = H.zeroClass :=
    H.Vanishing[].zero (EmptyChains.Native[n := n].zero empty);
}
\module Negative(n: N.Nat^) {
  \definition degree: I.Int^ := I.Int^::negSucc (N.Nat^::succ n);
  \import Chains.At[C := Reduced.complex, z := degree] \as H;
  \import Modules.Zero[] \as Zero;
  \definition zero: \forall (q: H.Homology) -> q = H.zeroClass :=
    H.Vanishing[].zero (\fun (x: Zero.Carrier) => Zero.unique x Zero.Carrier::zero);
}
\module NegativeOne {
  \definition degree: I.Int^ := I.Int^::negSucc N.Nat^::zero;
  \import Chains.At[C := Reduced.complex, z := degree] \as H;
  \definition isomorphism[empty: Empty]: Modules.Isomorphism[V := I.Int^, W := H.Homology, source := Modules.scalarModule, target := H.homologySpace].Isomorphism :=
    Reduced.NegativeOne[].emptyIsomorphism empty;
}
