\import Modules.Isomorphism[V := Reduced.At[z := z].Carrier, W := Point.At[z := z].Carrier,
  source := Reduced.At[z := z].space, target := Point.At[z := z].space].Vanishing[] \as Vanishing;
\definition zero[c: Geometry.Data]: \forall (q: Reduced.At[z := z].Carrier) -> q = (Reduced.At[z := z].space).zero :=
  Vanishing.sourceZero (Comparison.Homology[z := z].isomorphism (Geometry.pointEquivalence c)) (PointCalculation.Homology[z := z].zero Geometry.pointUnique);
