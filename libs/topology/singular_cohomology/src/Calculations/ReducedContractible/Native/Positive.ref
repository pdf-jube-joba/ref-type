\definition degree: N.Nat^ := N.Nat^::succ n;
\definition law(x: Chains.Carrier degree): #apply{projection} degree x = #zero{(Chains.space degree)} :=
  trans!{{Chains.Carrier degree}} _ _ _
    (congr!{{PointChains.Carrier degree} {Chains.Carrier degree}} (#apply{backward} degree) _ _ (PointContraction.Positive[n := n].law Geometry.pointUnique (#apply{forward} degree x)))
    (Backward.At[n := degree].zeroPreserved backward);
