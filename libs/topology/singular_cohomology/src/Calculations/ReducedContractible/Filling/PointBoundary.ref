\import PointHomotopies.At[k := z] \as PointContraction;
\import Modules.Laws[V := Point.Carrier z, space := Point.space z] \as PointValues;
\import algebra.Group[].Of[Carrier := Point.Carrier z, group := PointValues.additive] \as PointGroup;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition pointCycle(x: SourceH.Cycle): PointH.Cycle := #apply{(Forward.cyclesMap projection)} x;
\definition pointBoundary(x: SourceH.Cycle): #apply{PointH.prior} (#apply{pointHomotopy} z (pointCycle x)) = pointCycle x :=
  trans!{{Point.Carrier z}} _ _ _ (sym!{{Point.Carrier z}} _ _ (PointContraction.onCycle PointEnd.identity PointEnd.zeroMap pointHomotopy (pointCycle x)))
    (trans!{{Point.Carrier z}} _ _ _
      (congr!{{Point.Carrier z} {Point.Carrier z}} (#add{(Point.space z)} (pointCycle x)) _ _ PointGroup.negZero)
      (PointGroup.zeroRight (pointCycle x)));
\definition law(x: SourceH.Cycle): #apply{SourceH.prior} (#apply{pointPart} x) = #apply{inclusion} z (#apply{projection} z x) :=
  trans!{{Reduced.Carrier z}} _ _ _
    (BackwardMaps.priorCommutes z inclusion (#apply{pointHomotopy} z (pointCycle x)))
    (congr!{{Point.Carrier z} {Reduced.Carrier z}} (#apply{inclusion} z) _ _ (pointBoundary x));
