\import Homotopies.At[k := z] \as PrismCycles;
\import Projection.Composition[C := A, final := source].Reduced[] \as Functor;
\import BackwardMaps.Composition[B := Reduced.complex] \as Compose;
\import Complexes.Map[C := Reduced.complex, D := Reduced.complex] \as End;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\definition factorization(x: SourceH.Cycle): #apply{inclusion} z (#apply{projection} z x) =
  #apply{(SelfMaps.Reduced[].map constant (Homotopy.endContinuous Identity.function constant contraction.homotopy))} z x :=
  congr!{End.Map {Reduced.Carrier z}} (\fun (f: End.Map) => #apply{f} z x) _ _ (Functor.law pointFunction pointContinuous centreFunction centreContinuous);
\definition identity(x: SourceH.Cycle): #apply{(SelfMaps.Reduced[].map Identity.function (Homotopy.startContinuous Identity.function constant contraction.homotopy))} z x = x :=
  congr!{End.Map {Reduced.Carrier z}} (\fun (f: End.Map) => #apply{f} z x) _ _ Identity.Reduced[].law;
\definition law(x: SourceH.Cycle):
  #apply{SourceH.prior} (#apply{(Prism.operator Identity.function constant contraction.homotopy z)} x) = Group.difference (#apply{inclusion} z (#apply{projection} z x)) x :=
  trans!{{Reduced.Carrier z}} _ _ _
    (sym!{{Reduced.Carrier z}} _ _ (PrismCycles.onCycle _ _ prism x))
    (congr2!{{Reduced.Carrier z} {Reduced.Carrier z} {Reduced.Carrier z}} Group.difference _ _ _ _ (sym!{{Reduced.Carrier z}} _ _ (factorization x)) (identity x));
