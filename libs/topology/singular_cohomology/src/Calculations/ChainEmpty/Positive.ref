\import \parent.Native[n := n] \as Ordinary;
\import Extension.Positive[n := n] \as Packing;
\definition zero: IsEmpty -> \forall (x: Extension.Carrier (I.Int^::ofNat n)) -> x = #zero{(Extension.space (I.Int^::ofNat n))} :=
  \fun (empty: IsEmpty)(x: Extension.Carrier (I.Int^::ofNat n)) =>
    congr!{{Carrier n} {Extension.Carrier (I.Int^::ofNat n)}} Packing.intro x #zero{(space n)} (Ordinary.zero empty x);
