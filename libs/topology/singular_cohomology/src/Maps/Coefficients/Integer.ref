\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as NativeChains;
\import NativeChains.ZeroExtension[C := Domain.complex] \as DomainExtension;
\import NativeChains.ZeroExtension[C := Codomain.complex] \as CodomainExtension;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Integer[P := CodomainExtension.complex, N := M] \as IntegerSource;
\import Hom.Integer[P := DomainExtension.complex, N := L] \as IntegerTarget;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as SignedCochains;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as NativeCochains;
\import Hom.ZeroExtension[P := Codomain.complex, N := M] \as SourceComparison;
\import Hom.ZeroExtension[P := Domain.complex, N := L] \as TargetComparison;
\import Hom.On[P := Domain.complex, N := L] \as TargetHom;
\import Hom.IntegerMapping[P := DomainExtension.complex, Q := CodomainExtension.complex, N := M, L := L]
  .On[f := integerPush f continuous, u := coefficientMap] \as Action;
\definition signedMap: SignedCochains.Map[C := IntegerSource.complex, D := IntegerTarget.complex].Map := Action.map;
\definition nativeMap: NativeCochains.Map[C := SourceCochains.complex, D := TargetCochains.complex].Map :=
  map f continuous coefficientMap;
\module At(n: N.Nat^);
