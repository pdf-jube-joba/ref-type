\import Domain.Reduced[] \as SourceReduced;
\import Codomain.Reduced[] \as MiddleReduced;
\import FinalChains.Reduced[] \as FinalReduced;
\import \parent.\parent.Reduced[] \as First;
\import After.Reduced[] \as Second;
\import Direct.Reduced[] \as Composite;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import Chains.Map[C := SourceReduced.complex, D := FinalReduced.complex] \as Actions;
\import Chains.Map[C := MiddleReduced.complex, D := FinalReduced.complex].Composition[B := SourceReduced.complex] \as Composition;
\definition nonnegative: \forall (f: A -> B)(fc: Continuous f)(g: B -> C)(gc: After.Continuous g)(n: N.Nat^)(x: Domain.Carrier n) ->
  #apply{(Composition.compose (Second.map g gc) (First.map f fc))} (I.Int^::ofNat n) x =
    #apply{(Composite.map (\fun (x: A) => g (f x)) (Topology.composeContinuous source target final f g fc gc))} (I.Int^::ofNat n) x :=
  \fun (f: A -> B)(fc: Continuous f)(g: B -> C)(gc: After.Continuous g)(n: N.Nat^)(x: Domain.Carrier n) =>
    congr!{Result.Map {FinalChains.Carrier n}} (\fun (arrow: Result.Map) => #apply{arrow} n x) _ _ (functoriality f fc g gc);
\definition negative: \forall (n: N.Nat^)(f: A -> B)(fc: Continuous f)(g: B -> C)(gc: After.Continuous g)(x: SourceReduced.Carrier (I.Int^::negSucc n)) ->
  #apply{(Composition.compose (Second.map g gc) (First.map f fc))} (I.Int^::negSucc n) x =
    #apply{(Composite.map (\fun (x: A) => g (f x)) (Topology.composeContinuous source target final f g fc gc))} (I.Int^::negSucc n) x :=
  \induction (n: N.Nat^) \return \forall (f: A -> B)(fc: Continuous f)(g: B -> C)(gc: After.Continuous g)(x: SourceReduced.Carrier (I.Int^::negSucc n)) ->
    #apply{(Composition.compose (Second.map g gc) (First.map f fc))} (I.Int^::negSucc n) x =
      #apply{(Composite.map (\fun (x: A) => g (f x)) (Topology.composeContinuous source target final f g fc gc))} (I.Int^::negSucc n) x \with {
        | zero: \fun (f: A -> B)(fc: Continuous f)(g: B -> C)(gc: After.Continuous g)(x: I.Int^) => \refl(x)
        | succ: \fun (n: N.Nat^)(previous: _)(f: A -> B)(fc: Continuous f)(g: B -> C)(gc: After.Continuous g)(x: Modules.Zero[].Carrier) => Modules.Zero[].unique _ _
      };
\definition law: \forall (f: A -> B)(fc: Continuous f)(g: B -> C)(gc: After.Continuous g) ->
  Composition.compose (Second.map g gc) (First.map f fc) = Composite.map (\fun (x: A) => g (f x)) (Topology.composeContinuous source target final f g fc gc) :=
  \fun (f: A -> B)(fc: Continuous f)(g: B -> C)(gc: After.Continuous g) => Actions.ext _ _
    (\induction (z: I.Int^) \return \forall (x: SourceReduced.Carrier z) ->
      #apply{(Composition.compose (Second.map g gc) (First.map f fc))} z x =
        #apply{(Composite.map (\fun (x: A) => g (f x)) (Topology.composeContinuous source target final f g fc gc))} z x \with {
          | ofNat: nonnegative f fc g gc
          | negSucc: \fun (n: N.Nat^) => negative n f fc g gc
        });
