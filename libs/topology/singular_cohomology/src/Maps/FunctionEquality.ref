\definition law: \forall (f: A -> B)(fc: Continuous f)(g: A -> B)(gc: Continuous g) -> (\forall (x: A) -> f x = g x) -> push f fc = push g gc :=
  \fun (f: A -> B)(fc: Continuous f)(g: A -> B)(gc: Continuous g)(pointwise: \forall (x: A) -> f x = g x) =>
    (\idelim f = g \with h: (A -> B) => \forall (hc: Continuous h) -> push f fc = push h hc \by {
      base: \fun (hc: Continuous f) => \refl(push f fc),
      equality: \axiom:funext(f, g, pointwise)
    }) gc;
