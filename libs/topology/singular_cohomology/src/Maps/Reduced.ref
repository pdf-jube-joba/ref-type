\import Domain.Reduced[] \as SourceReduced;
\import Codomain.Reduced[] \as TargetReduced;
\import \parent.Augmentation[] \as Augmentation;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.Map[C := SourceReduced.complex, D := TargetReduced.complex] \as Maps;
\definition apply[f: A -> B][continuous: Continuous f]: \forall (z: I.Int^) -> SourceReduced.Carrier z -> TargetReduced.Carrier z :=
  \induction (z: I.Int^) \return SourceReduced.Carrier z -> TargetReduced.Carrier z \with {
    | ofNat: \fun (n: N.Nat^) => (push f continuous).apply n
    | negSucc: \induction (n: N.Nat^) \return SourceReduced.Carrier (I.Int^::negSucc n) -> TargetReduced.Carrier (I.Int^::negSucc n) \with {
      | zero: \fun (x: I.Int^) => x
      | succ: \fun (n: N.Nat^)(unused: _)(x: Modules.Zero[].Carrier) => x
    }
  };
\definition addition: \forall (f: A -> B)(continuous: Continuous f)(z: I.Int^)(x, y: SourceReduced.Carrier z) ->
  apply f continuous z ((SourceReduced.space z).add x y) = (TargetReduced.space z).add (apply f continuous z x) (apply f continuous z y) :=
  \fun (f: A -> B)(continuous: Continuous f) => \induction (z: I.Int^) \return \forall (x, y: SourceReduced.Carrier z) ->
    apply f continuous z ((SourceReduced.space z).add x y) = (TargetReduced.space z).add (apply f continuous z x) (apply f continuous z y) \with {
      | ofNat: \fun (n: N.Nat^) => (push f continuous).addition n
      | negSucc: \induction (n: N.Nat^) \return \forall (x, y: SourceReduced.Carrier (I.Int^::negSucc n)) ->
        apply f continuous (I.Int^::negSucc n) ((SourceReduced.space (I.Int^::negSucc n)).add x y) =
        (TargetReduced.space (I.Int^::negSucc n)).add (apply f continuous (I.Int^::negSucc n) x) (apply f continuous (I.Int^::negSucc n) y) \with {
          | zero: \fun (x, y: I.Int^) => \refl((Modules.scalarModule).add x y)
          | succ: \fun (n: N.Nat^)(unused: _)(x, y: Modules.Zero[].Carrier) => \refl(Modules.Zero[].Carrier::zero)
        }
    };
\definition scalar: \forall (f: A -> B)(continuous: Continuous f)(z: I.Int^)(r: I.Int^)(x: SourceReduced.Carrier z) ->
  apply f continuous z ((SourceReduced.space z).smul r x) = (TargetReduced.space z).smul r (apply f continuous z x) :=
  \fun (f: A -> B)(continuous: Continuous f) => \induction (z: I.Int^) \return \forall (r: I.Int^)(x: SourceReduced.Carrier z) ->
    apply f continuous z ((SourceReduced.space z).smul r x) = (TargetReduced.space z).smul r (apply f continuous z x) \with {
      | ofNat: \fun (n: N.Nat^) => (push f continuous).scalar n
      | negSucc: \induction (n: N.Nat^) \return \forall (r: I.Int^)(x: SourceReduced.Carrier (I.Int^::negSucc n)) ->
        apply f continuous (I.Int^::negSucc n) ((SourceReduced.space (I.Int^::negSucc n)).smul r x) =
        (TargetReduced.space (I.Int^::negSucc n)).smul r (apply f continuous (I.Int^::negSucc n) x) \with {
          | zero: \fun (r, x: I.Int^) => \refl((Modules.scalarModule).smul r x)
          | succ: \fun (n: N.Nat^)(unused: _)(r: I.Int^)(x: Modules.Zero[].Carrier) => \refl(Modules.Zero[].Carrier::zero)
        }
    };
\import chain_complexes.Chain[] \as Degrees;
\definition commutes: \forall (f: A -> B)(continuous: Continuous f)(z: I.Int^)(x: SourceReduced.Carrier z) ->
  (TargetReduced.differential).apply z (apply f continuous z x) = apply f continuous (Degrees.previous z) ((SourceReduced.differential).apply z x) :=
  \fun (f: A -> B)(continuous: Continuous f) => \induction (z: I.Int^) \return \forall (x: SourceReduced.Carrier z) ->
    (TargetReduced.differential).apply z (apply f continuous z x) = apply f continuous (Degrees.previous z) ((SourceReduced.differential).apply z x) \with {
      | ofNat: \induction (n: N.Nat^) \return \forall (x: SourceReduced.Carrier (I.Int^::ofNat n)) ->
        (TargetReduced.differential).apply (I.Int^::ofNat n) (apply f continuous (I.Int^::ofNat n) x) =
        apply f continuous (Degrees.previous (I.Int^::ofNat n)) ((SourceReduced.differential).apply (I.Int^::ofNat n) x) \with {
          | zero: Augmentation.naturality f continuous
          | succ: \fun (n: N.Nat^)(unused: _) => (push f continuous).commutes n
        }
      | negSucc: \induction (n: N.Nat^) \return \forall (x: SourceReduced.Carrier (I.Int^::negSucc n)) ->
        (TargetReduced.differential).apply (I.Int^::negSucc n) (apply f continuous (I.Int^::negSucc n) x) =
        apply f continuous (Degrees.previous (I.Int^::negSucc n)) ((SourceReduced.differential).apply (I.Int^::negSucc n) x) \with {
          | zero: \fun (x: I.Int^) => \refl(Modules.Zero[].Carrier::zero)
          | succ: \fun (n: N.Nat^)(unused: _)(x: Modules.Zero[].Carrier) => \refl(Modules.Zero[].Carrier::zero)
        }
    };
\definition map[f: A -> B][continuous: Continuous f]: Maps.Map := Maps.Map {
  apply := apply f continuous, addition := addition f continuous, scalar := scalar f continuous, commutes := commutes f continuous,
};
\module FunctionEquality;
