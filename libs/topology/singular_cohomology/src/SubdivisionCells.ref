\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import algebraic_topology.Simplex[] \as Simplex;
\import Simplex.BarycentricSubdivision[] \as Cells;
\module At(n: N.Nat^) {
  \import Modules.Free[Generators := Cells.Cell n] \as Free;
  \definition Carrier: \Set := Free.Carrier;
  \definition space: Modules.Space Carrier := Free.space;
  \definition generator: Cells.Cell n -> Carrier := Free.generator;
}
\definition Carrier(n: N.Nat^): \Set := At[n := n].Carrier;
\definition space(n: N.Nat^): Modules.Space (Carrier n) := At[n := n].space;
\definition generator(n: N.Nat^): Cells.Cell n -> Carrier n := At[n := n].generator;
\module Step(n: N.Nat^);
\definition chain: \forall (n: N.Nat^) -> Carrier n := \induction (n: N.Nat^) \return Carrier n \with {
  | zero: generator N.Nat^::zero Cells.base
  | succ: \fun (n: N.Nat^)(previous: Carrier n) => Step[n := n].boundary previous
};
\module Evaluation(n, k: N.Nat^);
\module Comparison;
\module Words(n: N.Nat^);
