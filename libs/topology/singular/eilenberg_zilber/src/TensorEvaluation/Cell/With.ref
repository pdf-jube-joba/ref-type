\import Double.TensorMapping[C := ModelLeft.complex, D := Left.complex, E := ModelRight.complex, F := Right.complex].With[f := Evaluation.leftPush sigma, g := Evaluation.rightPush tau] \as Action;
\import Double.Map[C := ModelTensor.complex, D := Tensor.complex].Total[f := Action.map] \as TotalAction;
\definition leftFunction: LeftMaps.postcompose p sigma (LeftSimplices.At[n := p].continuous sigma) Model.leftSimplex = sigma := \axiom:funext(LeftMaps.postcompose p sigma (LeftSimplices.At[n := p].continuous sigma) Model.leftSimplex, sigma, \fun (x: Simplex.Carrier p) => \refl(sigma x));
\definition rightFunction: RightMaps.postcompose q tau (RightSimplices.At[n := q].continuous tau) Model.rightSimplex = tau := \axiom:funext(RightMaps.postcompose q tau (RightSimplices.At[n := q].continuous tau) Model.rightSimplex, tau, \fun (x: Simplex.Carrier q) => \refl(tau x));
\definition left: (Evaluation.leftPush sigma).apply p (ModelLeft.generator p Model.leftSimplex) = Left.generator p sigma :=
  trans!{{Left.Carrier p}} _ _ _ (LeftMaps.At[n := p].onGenerator sigma (LeftSimplices.At[n := p].continuous sigma) Model.leftSimplex)
    (congr!{{LeftSimplices.Carrier p} {Left.Carrier p}} (Left.generator p) _ _ leftFunction);
\definition right: (Evaluation.rightPush tau).apply q (ModelRight.generator q Model.rightSimplex) = Right.generator q tau :=
  trans!{{Right.Carrier q}} _ _ _ (RightMaps.At[n := q].onGenerator tau (RightSimplices.At[n := q].continuous tau) Model.rightSimplex)
    (congr!{{RightSimplices.Carrier q} {Right.Carrier q}} (Right.generator q) _ _ rightFunction);
\definition law: (Evaluation.map sigma tau).apply n Cell.nativeCell = generator sigma tau :=
  trans!{{Total.Carrier n}} _ _ _ (TotalAction.Degree[n := n].onInjection i (ModelTensor.Term[p := p, q := q].tensor (ModelLeft.generator p Model.leftSimplex) (ModelRight.generator q Model.rightSimplex)))
    (trans!{{Total.Carrier n}} _ _ _ (congr!{{Tensor.Term[p := p, q := q].Carrier} {Total.Carrier n}} ((Total.Degree[n := n].Component[i := i].injection).apply) _ _ (Action.Degree[p := p, q := q].onTensor (ModelLeft.generator p Model.leftSimplex) (ModelRight.generator q Model.rightSimplex)))
      (congr2!{{Left.Carrier p} {Right.Carrier q} {Total.Carrier n}} (\fun (x: Left.Carrier p)(y: Right.Carrier q) => (Total.Degree[n := n].Component[i := i].injection).apply (Tensor.Term[p := p, q := q].tensor x y)) _ _ _ _ left right));
