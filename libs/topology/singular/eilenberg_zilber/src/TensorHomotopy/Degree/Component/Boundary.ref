\use std.Logic[].Equality[].eq_reason_in;
\definition z: I.Int^ := I.Int^::ofNat n;
\import \root.TensorModels[].Level[n := n, z := z] \as LowerLevel;
\import \root.TensorModels[].Cell[n := n, i := i] \as Cell;
\import \root.TensorModels[].Differential[z := Degrees.next z].Degree[n := n].Coordinates[] \as BoundaryCoordinates;
\import Modules.Hom[V := Level.Carrier, W := Model.Carrier (Degrees.next z), source := Level.space, target := Model.space (Degrees.next z)] \as UpperCoordinates;
\import Modules.Hom[V := LowerLevel.Carrier, W := Model.Carrier z, source := LowerLevel.space, target := Model.space z] \as Coordinates;
\import Modules.Laws[V := Model.Carrier z, space := Model.space z] \as ModelValues;
\import algebra.Group[].Of[Carrier := Model.Carrier z, group := ModelValues.additive] \as ModelGroup;
\definition modelPrior: Model.Carrier z := LowerLevel.Coordinates[].coordinate i (Models.prior n);
\definition modelBoundary: (Model.boundary (Degrees.next z)).apply modelValue = ModelGroup.difference Cell.Defect[].value modelPrior :=
  eq_reason_in!{{Model.Carrier z} _
    "=" _ "by" { sym!{{Model.Carrier z}} _ _ (BoundaryCoordinates.law i (Models.homotopy n)) }
    "=" _ "by" { congr!{LowerLevel.Carrier {Model.Carrier z}} (LowerLevel.Coordinates[].coordinate i) _ _ (Models.boundary n) }
    "=" _ "by" { Coordinates.differencePreserved (LowerLevel.Coordinates[].At[i := i].map) Models.Degree[n := n].value (Models.prior n) }
    "=" _ "by" { congr!{{Model.Carrier z} {Model.Carrier z}} (\fun (x: Model.Carrier z) => ModelGroup.difference x modelPrior) _ _ (Models.Degree[n := n].coordinate i) }
  };
\import Modules.Laws[V := Total.Carrier n, space := Total.space n] \as Values;
\import algebra.Group[].Of[Carrier := Total.Carrier n, group := Values.additive] \as Group;
\definition prior[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Total.Carrier n := (evaluation sigma tau).apply n modelPrior;
\import \root.On[A := Simplex.Carrier p, B := Simplex.Carrier q, left := LeftDomain.topology, right := RightDomain.topology] \as ModelComparison;
\import singular_products.ProductMapping[A := Simplex.Carrier p, B := Simplex.Carrier q, C := A, D := B, leftSource := LeftDomain.topology, rightSource := RightDomain.topology, leftTarget := left, rightTarget := right] \as Factors;
\definition factors[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Factors.Map := Factors.Map { leftFunction := sigma, rightFunction := tau, leftContinuous := LeftSimplices.At[n := p].continuous sigma, rightContinuous := RightSimplices.At[n := q].continuous tau };
\definition generator[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Total.Carrier n := Evaluation.Cell[n := n, i := i].generator sigma tau;
\definition defect[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: (evaluation sigma tau).apply n Cell.Defect[].value = (Comparison.tensorDefect).apply n (generator sigma tau) :=
  trans!{{Total.Carrier n}} _ _ _ (ModelComparison.Naturality[C := A, D := B, leftTarget := left, rightTarget := right].With[f := factors sigma tau].Composites[n := n].tensorDefectLaw Cell.nativeCell)
    (congr!{{Total.Carrier n} {Total.Carrier n}} ((Comparison.tensorDefect).apply n) _ _ (Evaluation.Cell[n := n, i := i].With[sigma := sigma, tau := tau].law));
\import Native.Map[C := ModelTotal.complex, D := Total.complex].At[n := n] \as Linear;
\import Modules.Hom[V := Model.Carrier z, W := Total.Carrier n, source := Model.space z, target := Total.space n] \as Maps;
\definition law[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: (Total.differential).apply n (onGenerators sigma tau) = Group.difference ((Comparison.tensorDefect).apply n (generator sigma tau)) (prior sigma tau) :=
  eq_reason_in!{{Total.Carrier n} _
    "=" _ "by" { (evaluation sigma tau).commutes n modelValue }
    "=" _ "by" { congr!{{Model.Carrier z} {Total.Carrier n}} ((evaluationLinear n sigma tau).apply) _ _ modelBoundary }
    "=" _ "by" { Maps.differencePreserved (evaluationLinear n sigma tau) Cell.Defect[].value modelPrior }
    "=" _ "by" { congr!{{Total.Carrier n} {Total.Carrier n}} (\fun (x: Total.Carrier n) => Group.difference x (prior sigma tau)) _ _ (defect sigma tau) }
  };
