\definition lowerIndex: Double.Index n := Double.index n p (NativeBoundary.lowerSecond p q);
\definition upperIndex: Double.Index (N.Nat^::succ n) := Double.index (N.Nat^::succ n) (N.Nat^::succ p) q;
\import \parent.\parent.At[i := upperIndex] \as Current;
\import Lower.Component[i := lowerIndex] \as LowerComponent;
\import Higher.Component[i := upperIndex] \as HigherComponent;
\import Modules.Tensor[V := Left.Carrier p, W := Right.Carrier q, left := Left.space p, right := Right.space q] \as Pure;
\import \root.TensorModels[].At[p := N.Nat^::succ p, q := q] \as HighModel;
\import \root.TensorModels[].Fixed[z := z].Horizontal[p := p, q := q] \as Faces;
\import Coordinates.Step[n := n, i := lowerIndex].Horizontal[] \as CoordinateBoundary;
\import Left.Boundary[n := p].SumImage[W := Total.Carrier (N.Nat^::succ n), target := Total.space (N.Nat^::succ n)] \as BoundaryImage;
\import Modules.Alternating[V := Total.Carrier (N.Nat^::succ n), space := Total.space (N.Nat^::succ n)] \as Sum;
\module With(sigma: LeftSimplices.Carrier (N.Nat^::succ p), tau: RightSimplices.Carrier q);
\definition law: Point upperIndex := \fun (sigma: LeftSimplices.Carrier (N.Nat^::succ p))(tau: RightSimplices.Carrier q) => With[sigma := sigma, tau := tau].law;
