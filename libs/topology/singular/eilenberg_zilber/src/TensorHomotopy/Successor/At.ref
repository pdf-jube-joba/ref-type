\definition p: N.Nat^ := (i).first;
\definition q: N.Nat^ := (i).second;
\import Higher.Component[i := i] \as Component;
\import Component.Boundary[] \as Boundary;
\import \root.TensorModels[].At[p := p, q := q] \as Model;
\definition pure[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Tensor.Term[p := p, q := q].Carrier := Tensor.Term[p := p, q := q].tensor (Left.generator p sigma) (Right.generator q tau);
\definition horizontal[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Total.Carrier (N.Nat^::succ n) := (Lower.map).apply ((NativeBoundary.horizontal p NativeBoundary.Component[i := i].q).apply (pure sigma tau));
\definition vertical[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Total.Carrier (N.Nat^::succ n) := (Lower.map).apply ((NativeBoundary.vertical q NativeBoundary.Component[i := i].p).apply (pure sigma tau));
\definition horizontalCoordinate[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Total.Carrier (N.Nat^::succ n) := (Component.evaluationLinear (N.Nat^::succ n) sigma tau).apply (TargetLevel.Coordinates[].coordinate i ((CoBoundary.horizontal).apply (Models.homotopy n)));
\definition verticalCoordinate[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Total.Carrier (N.Nat^::succ n) := (Component.evaluationLinear (N.Nat^::succ n) sigma tau).apply (TargetLevel.Coordinates[].coordinate i ((CoBoundary.vertical).apply (Models.homotopy n)));
\definition modelPrior: Boundary.modelPrior = (Model.space z).add
  (TargetLevel.Coordinates[].coordinate i ((CoBoundary.horizontal).apply (Models.homotopy n))) (TargetLevel.Coordinates[].coordinate i ((CoBoundary.vertical).apply (Models.homotopy n))) :=
  trans!{{Model.Carrier z}} _ _ _ (congr!{TargetLevel.Carrier {Model.Carrier z}} (TargetLevel.Coordinates[].coordinate i) _ _ (Models.priorSuccessor n))
    ((TargetLevel.Coordinates[].At[i := i].map).addition ((CoBoundary.horizontal).apply (Models.homotopy n)) ((CoBoundary.vertical).apply (Models.homotopy n)));
\definition prior[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Boundary.prior sigma tau = (Total.space (N.Nat^::succ n)).add (horizontalCoordinate sigma tau) (verticalCoordinate sigma tau) :=
  trans!{{Total.Carrier (N.Nat^::succ n)}} _ _ _ (congr!{{Model.Carrier z} {Total.Carrier (N.Nat^::succ n)}} ((Component.evaluationLinear (N.Nat^::succ n) sigma tau).apply) _ _ modelPrior)
    ((Component.evaluationLinear (N.Nat^::succ n) sigma tau).addition _ _);
\definition boundary[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: (Lower.map).apply ((Total.differential).apply n (Evaluation.Cell[n := N.Nat^::succ n, i := i].generator sigma tau)) = (Total.space (N.Nat^::succ n)).add (horizontal sigma tau) (vertical sigma tau) :=
  trans!{{Total.Carrier (N.Nat^::succ n)}} _ _ _ (congr!{{Total.Carrier n} {Total.Carrier (N.Nat^::succ n)}} ((Lower.map).apply) _ _ (NativeBoundary.onComponent i (pure sigma tau)))
    ((Lower.map).addition _ _);
