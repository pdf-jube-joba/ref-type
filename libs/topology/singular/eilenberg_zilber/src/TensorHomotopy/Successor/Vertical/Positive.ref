\definition lowerIndex: Double.Index n := Double.reverseIndex n q (NativeBoundary.lowerFirst q p);
\definition upperIndex: Double.Index (N.Nat^::succ n) := Double.reverseIndex (N.Nat^::succ n) (N.Nat^::succ q) p;
\import \parent.\parent.At[i := upperIndex] \as Current;
\import Lower.Component[i := lowerIndex] \as LowerComponent;
\import Higher.Component[i := upperIndex] \as HigherComponent;
\import Modules.Tensor[V := Left.Carrier p, W := Right.Carrier q, left := Left.space p, right := Right.space q] \as Pure;
\import \root.TensorModels[].At[p := p, q := N.Nat^::succ q] \as HighModel;
\import \root.TensorModels[].Fixed[z := z].Vertical[p := p, q := q] \as Faces;
\import Coordinates.Step[n := n, i := lowerIndex].Vertical[] \as CoordinateBoundary;
\import Right.Boundary[n := q].SumImage[W := Total.Carrier (N.Nat^::succ n), target := Total.space (N.Nat^::succ n)] \as BoundaryImage;
\import Modules.Alternating[V := Total.Carrier (N.Nat^::succ n), space := Total.space (N.Nat^::succ n)] \as Sum;
\module With(sigma: LeftSimplices.Carrier p, tau: RightSimplices.Carrier (N.Nat^::succ q));
\definition law: Point upperIndex := \fun (sigma: LeftSimplices.Carrier p)(tau: RightSimplices.Carrier (N.Nat^::succ q)) => With[sigma := sigma, tau := tau].law;
