\use std.Logic[].Equality[].eq_reason_in;
\definition n: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ n;
\import \parent.Degree[n := n] \as Current;
\import \root.TensorModels[].Level[n := n, z := I.Int^::ofNat one] \as Level;
\import Modules.Hom[V := Total.Carrier n, W := Total.Carrier one, source := Total.space n, target := Total.space one] \as Maps;
\module At(i: Double.Index n) {
  \import Current.Component[i := i] \as Component;
  \import \root.TensorModels[].At[p := (i).first, q := (i).second] \as Model;
  \definition modelZero: Component.modelValue = (Model.space (I.Int^::ofNat one)).zero :=
    trans!{{Model.Carrier (I.Int^::ofNat one)}} _ _ _ (congr!{Level.Carrier {Model.Carrier (I.Int^::ofNat one)}} (Level.Coordinates[].coordinate i) _ _ Models.homotopyZero) Level.Coordinates[].At[i := i].zero;
  \import Modules.Hom[V := Model.Carrier (I.Int^::ofNat one), W := Total.Carrier one, source := Model.space (I.Int^::ofNat one), target := Total.space one] \as EvaluationMaps;
  \definition generator[sigma: LeftSimplices.Carrier (i).first][tau: RightSimplices.Carrier (i).second]: (Current.map).apply (Evaluation.Cell[n := n, i := i].generator sigma tau) = (Total.space one).zero :=
    eq_reason_in!{{Total.Carrier one} _
      "=" _ "by" { Current.onInjection i (Tensor.Term[p := (i).first, q := (i).second].tensor (Left.generator (i).first sigma) (Right.generator (i).second tau)) }
      "=" _ "by" { Component.generatorLaw sigma tau }
      "=" _ "by" { congr!{{Model.Carrier (I.Int^::ofNat one)} {Total.Carrier one}} ((Component.evaluationLinear one sigma tau).apply) _ _ modelZero }
      "=" _ "by" { EvaluationMaps.zeroPreserved (Component.evaluationLinear one sigma tau) }
    };
}
\import \root.TensorGenerators[A := A, B := B, left := left, right := right].To[n := n, W := Total.Carrier one, target := Total.space one] \as Generators;
\definition equation: Current.map = Maps.zeroMap := Generators.ext Current.map Maps.zeroMap (\fun (i: Double.Index n) => At[i := i].generator);
\definition zero[x: Total.Carrier n]: (Current.map).apply x = (Total.space one).zero := congr!{Maps.Map {Total.Carrier one}} (\fun (h: Maps.Map) => (h).apply x) _ _ equation;
\import Modules.Hom[V := Total.Carrier one, W := Total.Carrier n, source := Total.space one, target := Total.space n] \as BoundaryMaps;
\definition law[x: Total.Carrier n]: (Comparison.tensorDefect).apply n x = (Total.differential).apply n ((Current.map).apply x) :=
  trans!{{Total.Carrier n}} _ _ _ (Comparison.Zero[].Tensor[].defect x)
    (sym!{{Total.Carrier n}} _ _ (trans!{{Total.Carrier n}} _ _ _ (congr!{{Total.Carrier one} {Total.Carrier n}} ((Total.differential).apply n) _ _ (zero x)) (BoundaryMaps.zeroPreserved (Total.Step[n := n].differential))));
