\definition z: I.Int^ := I.Int^::ofNat (N.Nat^::succ n);
\import \parent.Degree[n := n] \as Lower;
\import \parent.Degree[n := N.Nat^::succ n] \as Higher;
\import Total.Step[n := n] \as NativeBoundary;
\import \root.TensorModels[].Fixed[z := z] \as Fixed;
\import \root.TensorModels[].Level[n := n, z := z] \as SourceLevel;
\import \root.TensorModels[].Level[n := N.Nat^::succ n, z := z] \as TargetLevel;
\import Diagram.Total[C := Fixed.complex].Step[n := n] \as CoBoundary;
\import Diagram.Coordinates[C := Fixed.complex] \as Coordinates;
\module At(i: Double.Index (N.Nat^::succ n));
\module Horizontal;
\module Vertical;
\import Modules.Hom[V := Total.Carrier (N.Nat^::succ n), W := Total.Carrier (N.Nat^::succ n), source := Total.space (N.Nat^::succ n), target := Total.space (N.Nat^::succ n)] \as Maps;
\import Modules.Hom[V := Total.Carrier (N.Nat^::succ (N.Nat^::succ n)), W := Total.Carrier (N.Nat^::succ n), source := Total.space (N.Nat^::succ (N.Nat^::succ n)), target := Total.space (N.Nat^::succ n)].Composition[U := Total.Carrier (N.Nat^::succ n), domain := Total.space (N.Nat^::succ n)] \as AfterBoundary;
\import Modules.Hom[V := Total.Carrier n, W := Total.Carrier (N.Nat^::succ n), source := Total.space n, target := Total.space (N.Nat^::succ n)].Composition[U := Total.Carrier (N.Nat^::succ n), domain := Total.space (N.Nat^::succ n)] \as AfterPrior;
\import Native.Map[C := Total.complex, D := Total.complex].At[n := N.Nat^::succ n] \as Linear;
\definition boundaryMap: Maps.Map := Maps.plus (AfterBoundary.compose (Total.Step[n := N.Nat^::succ n].differential) Higher.map) (AfterPrior.compose Lower.map (Total.Step[n := n].differential));
\definition defectMap: Maps.Map := Linear.linear Comparison.tensorDefect;
\module Equation(i: Double.Index (N.Nat^::succ n));
\import \root.TensorGenerators[A := A, B := B, left := left, right := right].To[n := N.Nat^::succ n, W := Total.Carrier (N.Nat^::succ n), target := Total.space (N.Nat^::succ n)] \as Generators;
\definition equation: boundaryMap = defectMap := Generators.ext boundaryMap defectMap (\fun (i: Double.Index (N.Nat^::succ n)) => Equation[i := i].law);
\definition law[x: Total.Carrier (N.Nat^::succ n)]: (Comparison.tensorDefect).apply (N.Nat^::succ n) x = (Total.space (N.Nat^::succ n)).add ((Total.differential).apply (N.Nat^::succ n) ((Higher.map).apply x)) ((Lower.map).apply ((Total.differential).apply n x)) := sym!{{Total.Carrier (N.Nat^::succ n)}} _ _ (congr!{Maps.Map {Total.Carrier (N.Nat^::succ n)}} (\fun (h: Maps.Map) => (h).apply x) _ _ equation);
