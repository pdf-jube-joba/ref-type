\import std.Logic[].Proposition[] \as Logic;
\import std.Data[].Nat[] \as N;
\import N.Basic[].Def[] \as Nat;
\import std.Data[].FinSet[] \as Fin;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import algebraic_topology.Simplex[] \as Simplex;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\import chain_complexes.Chain[] \as Degrees;
\import Degrees.Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import field_kunneth.TensorCochain[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Diagram;
\module At(p, q: N.Nat^);
\module Mapping(p, q, r, s: N.Nat^);
\module Horizontal(p, q: N.Nat^, i: Fin.Fin (N.Nat^::succ (N.Nat^::succ p)));
\module Vertical(p, q: N.Nat^, i: Fin.Fin (N.Nat^::succ (N.Nat^::succ q)));
\module HorizontalInterchange(p, q: N.Nat^, i, j: Fin.Fin (N.Nat^::succ (N.Nat^::succ p)));
\module VerticalInterchange(p, q: N.Nat^, i, j: Fin.Fin (N.Nat^::succ (N.Nat^::succ q)));
\module MixedInterchange(p, q: N.Nat^, i: Fin.Fin (N.Nat^::succ (N.Nat^::succ p)), j: Fin.Fin (N.Nat^::succ (N.Nat^::succ q)));
\module Fixed(z: I.Int^);
\module Differential(z: I.Int^);
\module Level(n: N.Nat^, z: I.Int^);
\module PositiveFilling(n: N.Nat^);
\module LadderLaws;
\module Ladder;
\module Cell(n: N.Nat^, i: Double.Index n);
\module HorizontalCellBoundary(n, p: N.Nat^, q: Double.Second (N.Nat^::succ n) (N.Nat^::succ p));
\module VerticalCellBoundary(n, q: N.Nat^, p: Double.First (N.Nat^::succ n) (N.Nat^::succ q));
\module Cells;
