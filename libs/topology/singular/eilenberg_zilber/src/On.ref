\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import topological_constructions.Product[A := A, B := B] \as Product;
\definition topology: topology.Topology[Carrier := Product.CarrierSet].Topology := Product.topology left right;
\import singular_cohomology.Chains[A := A, source := left] \as Left;
\import singular_cohomology.Chains[A := B, source := right] \as Right;
\import singular_cohomology.Chains[A := Product.CarrierSet, source := topology] \as Chains;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\import Double.Tensor[C := Left.complex, D := Right.complex] \as Tensor;
\import Double.Total[C := Tensor.complex] \as Total;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import Native.Map[C := Chains.complex, D := Total.complex] \as Forward;
\import Native.Map[C := Total.complex, D := Chains.complex] \as Backward;
\import singular_products.AlexanderWhitney[A := A, B := B, left := left, right := right].Total[] \as AW;
\import singular_products.Cross[A := A, B := B, left := left, right := right].Total[] \as Shuffle;
\definition forward: Forward.Map := AW.map;
\definition backward: Backward.Map := Shuffle.map;
\import Backward.Composition[B := Chains.complex] \as ProductComposition;
\import Forward.Composition[B := Total.complex] \as TensorComposition;
\definition productComposite: Native.Map[C := Chains.complex, D := Chains.complex].Map := ProductComposition.compose backward forward;
\definition tensorComposite: Native.Map[C := Total.complex, D := Total.complex].Map := TensorComposition.compose forward backward;
\import Native.Map[C := Chains.complex, D := Chains.complex].Additive[] \as ProductAdditive;
\import Native.Map[C := Total.complex, D := Total.complex].Additive[] \as TensorAdditive;
\definition productDefect: Native.Map[C := Chains.complex, D := Chains.complex].Map := ProductAdditive.difference productComposite (Native.End[C := Chains.complex].identity);
\definition tensorDefect: Native.Map[C := Total.complex, D := Total.complex].Map := TensorAdditive.difference tensorComposite (Native.End[C := Total.complex].identity);
\module Zero;
\module Naturality(C, D: \Set, leftTarget: topology.Topology[Carrier := C].Topology, rightTarget: topology.Topology[Carrier := D].Topology);
\module ProductHomotopy;
