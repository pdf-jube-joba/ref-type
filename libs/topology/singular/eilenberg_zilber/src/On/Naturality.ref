\import singular_products.ProductMapping[A := A, B := B, C := C, D := D, leftSource := left, rightSource := right, leftTarget := leftTarget, rightTarget := rightTarget] \as Mapping;
\import \root.On[A := C, B := D, left := leftTarget, right := rightTarget] \as Other;
\import singular_cohomology.Maps[A := A, B := C, source := left, target := leftTarget] \as LeftMaps;
\import singular_cohomology.Maps[A := B, B := D, source := right, target := rightTarget] \as RightMaps;
\import topological_constructions.Product[A := C, B := D] \as TargetProduct;
\definition targetTopology: topology.Topology[Carrier := TargetProduct.CarrierSet].Topology := TargetProduct.topology leftTarget rightTarget;
\import singular_cohomology.Chains[A := C, source := leftTarget] \as TargetLeft;
\import singular_cohomology.Chains[A := D, source := rightTarget] \as TargetRight;
\import singular_cohomology.Chains[A := TargetProduct.CarrierSet, source := targetTopology] \as TargetChains;
\import singular_cohomology.Maps[A := Product.CarrierSet, B := TargetProduct.CarrierSet, source := topology, target := targetTopology] \as ProductMaps;
\import Double.Tensor[C := TargetLeft.complex, D := TargetRight.complex] \as TargetTensor;
\import Double.Total[C := TargetTensor.complex] \as TargetTotal;
\module With(f: Mapping.Map);
