\import Double.TensorMapping[C := Left.complex, D := TargetLeft.complex, E := Right.complex, F := TargetRight.complex].With[f := LeftMaps.push f.leftFunction f.leftContinuous, g := RightMaps.push f.rightFunction f.rightContinuous] \as TensorMapping;
\definition tensor: Native.Map[C := Total.complex, D := TargetTotal.complex].Map := TensorMapping.total;
\definition product: Native.Map[C := Chains.complex, D := TargetChains.complex].Map := ProductMaps.push (Mapping.function f) (Mapping.continuous f);
\module AlexanderWhitney(n: N.Nat^);
\module Shuffle(n: N.Nat^);
\module Composites(n: N.Nat^);
