\import std.Data[].FinSet[] \as Fin;
\import Modules.Alternating[V := Chains.Carrier (N.Nat^::succ n), space := Chains.space (N.Nat^::succ n)] \as Sum;
\import Modules.Alternating[V := HighChains.Carrier (N.Nat^::succ n), space := HighChains.space (N.Nat^::succ n)].Mapping[W := Chains.Carrier (N.Nat^::succ n), target := Chains.space (N.Nat^::succ n)] \as Mapping;
\import \root.Models[].Transition[n := n].Degree[z := I.Int^::ofNat (N.Nat^::succ n)] \as Transition;
\import Chains.Boundary[n := n].SumImage[W := Chains.Carrier (N.Nat^::succ n), target := Chains.space (N.Nat^::succ n)] \as Image;
\definition count: N.Nat^ := N.Nat^::succ (N.Nat^::succ n);
\definition law[sigma: Simplices.Carrier (N.Nat^::succ n)]: Higher.Boundary[].prior sigma = (Lower.map).apply ((Chains.boundary n).apply (Chains.generator (N.Nat^::succ n) sigma)) :=
  trans!{{Chains.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{HighChains.Carrier (N.Nat^::succ n)} {Chains.Carrier (N.Nat^::succ n)}} ((HighMaps.push (Higher.function sigma) (Higher.continuous sigma)).apply (N.Nat^::succ n)) _ _ (Models.priorSuccessor n))
    (trans!{{Chains.Carrier (N.Nat^::succ n)}} _ _ _
      (congr!{{HighChains.Carrier (N.Nat^::succ n)} {Chains.Carrier (N.Nat^::succ n)}} ((HighMaps.push (Higher.function sigma) (Higher.continuous sigma)).apply (N.Nat^::succ n)) _ _ (Transition.onValues (Models.homotopy n)))
      (trans!{{Chains.Carrier (N.Nat^::succ n)}} _ _ _
        (Mapping.law (HighMaps.At[n := N.Nat^::succ n].push (Higher.function sigma) (Higher.continuous sigma)) count (\fun (i: Fin.Fin count) => (Transition.faces i).apply (Models.homotopy n)))
        (trans!{{Chains.Carrier (N.Nat^::succ n)}} _ _ _
          (Sum.congruent count _ _ (\fun (i: Fin.Fin count) => \parent.Face[i := i].law sigma (N.Nat^::succ n) (Models.homotopy n)))
          (sym!{{Chains.Carrier (N.Nat^::succ n)}} _ _ (Image.law Lower.map Lower.onSimplex Lower.onGenerator sigma)))));
