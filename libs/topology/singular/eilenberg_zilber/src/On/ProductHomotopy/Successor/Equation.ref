\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Prior[] \as Prior;
\import Modules.Hom[V := Chains.Carrier (N.Nat^::succ n), W := Chains.Carrier (N.Nat^::succ n), source := Chains.space (N.Nat^::succ n), target := Chains.space (N.Nat^::succ n)] \as Linear;
\import Native.Map[C := Chains.complex, D := Chains.complex].At[n := N.Nat^::succ n] \as Degree;
\import Modules.Laws[V := Chains.Carrier (N.Nat^::succ n), space := Chains.space (N.Nat^::succ n)] \as Values;
\import algebra.Group[].Of[Carrier := Chains.Carrier (N.Nat^::succ n), group := Values.additive] \as Group;
\import Modules.Hom[V := Chains.Carrier (N.Nat^::succ (N.Nat^::succ n)), W := Chains.Carrier (N.Nat^::succ n), source := Chains.space (N.Nat^::succ (N.Nat^::succ n)), target := Chains.space (N.Nat^::succ n)].Composition[U := Chains.Carrier (N.Nat^::succ n), domain := Chains.space (N.Nat^::succ n)] \as AfterBoundary;
\import Modules.Hom[V := Chains.Carrier n, W := Chains.Carrier (N.Nat^::succ n), source := Chains.space n, target := Chains.space (N.Nat^::succ n)].Composition[U := Chains.Carrier (N.Nat^::succ n), domain := Chains.space (N.Nat^::succ n)] \as AfterPrior;
\definition boundaryMap: Linear.Map := Linear.plus (AfterBoundary.compose (Chains.boundary (N.Nat^::succ n)) Higher.map) (AfterPrior.compose Lower.map (Chains.boundary n));
\definition differenceMap: Linear.Map := Degree.linear productDefect;
\definition onGenerator[sigma: Simplices.Carrier (N.Nat^::succ n)]: (boundaryMap).apply (Chains.generator (N.Nat^::succ n) sigma) = (differenceMap).apply (Chains.generator (N.Nat^::succ n) sigma) := \block {
  \let x: Chains.Carrier (N.Nat^::succ n) := Chains.generator (N.Nat^::succ n) sigma \then
  \let p: Chains.Carrier (N.Nat^::succ n) := (Lower.map).apply ((Chains.boundary n).apply x) \then
  \return eq_reason_in!{{Chains.Carrier (N.Nat^::succ n)} _
    "=" _ "by" { congr!{{Chains.Carrier (N.Nat^::succ (N.Nat^::succ n))} {Chains.Carrier (N.Nat^::succ n)}} (\fun (y: Chains.Carrier (N.Nat^::succ (N.Nat^::succ n))) => Values.add ((Chains.boundary (N.Nat^::succ n)).apply y) p) _ _ (Higher.onGenerator sigma) }
    "=" _ "by" { congr!{{Chains.Carrier (N.Nat^::succ n)} {Chains.Carrier (N.Nat^::succ n)}} (\fun (y: Chains.Carrier (N.Nat^::succ n)) => Values.add y p) _ _ (Higher.Boundary[].law sigma) }
    "=" _ "by" { congr!{{Chains.Carrier (N.Nat^::succ n)} {Chains.Carrier (N.Nat^::succ n)}} (\fun (y: Chains.Carrier (N.Nat^::succ n)) => Values.add (Group.difference ((productDefect).apply (N.Nat^::succ n) x) y) p) _ _ (Prior.law sigma) }
    "=" _ "by" { Group.addDifference ((productDefect).apply (N.Nat^::succ n) x) p }
  }
};
\import Modules.Free[Generators := Simplices.Carrier (N.Nat^::succ n)].To[W := Chains.Carrier (N.Nat^::succ n), target := Chains.space (N.Nat^::succ n)] \as Free;
\definition equation: boundaryMap = differenceMap := Free.ext _ _ onGenerator;
\definition law[x: Chains.Carrier (N.Nat^::succ n)]: (productDefect).apply (N.Nat^::succ n) x = (Chains.space (N.Nat^::succ n)).add ((Chains.boundary (N.Nat^::succ n)).apply ((Higher.map).apply x)) ((Lower.map).apply ((Chains.boundary n).apply x)) :=
  sym!{{Chains.Carrier (N.Nat^::succ n)}} _ _ (congr!{Linear.Map {Chains.Carrier (N.Nat^::succ n)}} (\fun (h: Linear.Map) => (h).apply x) _ _ equation);
