\import Total.Degree[n := n] \as Source;
\import Modules.Hom[V := Source.Carrier, W := W, source := Source.space, target := target] \as Maps;
\definition generator[i: Double.Index n][sigma: LeftSimplices.Carrier (i).first][tau: RightSimplices.Carrier (i).second]: Source.Carrier := (Source.Component[i := i].injection).apply (Tensor.Term[p := (i).first, q := (i).second].tensor (Left.generator (i).first sigma) (Right.generator (i).second tau));
\definition Agreement[f, g: Maps.Map]: \Prop := \forall (i: Double.Index n)(sigma: LeftSimplices.Carrier (i).first)(tau: RightSimplices.Carrier (i).second) -> (f).apply (generator i sigma tau) = (g).apply (generator i sigma tau);
\module At(i: Double.Index n);
\import Modules.DirectSum[Index := Double.Index n, family := Source.family].To[W := W, target := target] \as Universal;
\definition ext[f, g: Maps.Map][same: Agreement f g]: f = g := Universal.ext f g (\fun (i: Double.Index n)(x: Tensor.Term[p := (i).first, q := (i).second].Carrier) =>
  congr!{{Modules.Hom[V := Tensor.Term[p := (i).first, q := (i).second].Carrier, W := W, source := Tensor.Term[p := (i).first, q := (i).second].space, target := target].Map} W} (\fun (h: Modules.Hom[V := Tensor.Term[p := (i).first, q := (i).second].Carrier, W := W, source := Tensor.Term[p := (i).first, q := (i).second].space, target := target].Map) => (h).apply x) _ _ (At[i := i].equation f g (same i)));
