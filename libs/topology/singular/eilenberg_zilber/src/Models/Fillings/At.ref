\import \parent.\parent.At[n := n] \as Current;
\import Current.Filling[z := I.Int^::ofNat n] \as Fill;
\import singular_cohomology.Chains[A := Current.Points, source := Current.topology].Reduced[] \as Reduced;
\definition z: I.Int^ := I.Int^::ofNat n;
\import Complexes.At[C := Reduced.complex, z := z] \as H;
\import std.Logic[].Equality[].Transport[A := I.Int^] \as Transport;
\definition law: \forall (x: Current.Carrier z) -> (Current.boundary z).apply x = (Current.space (Degrees.previous z)).zero -> (Current.boundary (Degrees.next z)).apply ((Fill.map).apply x) = x :=
  \fun (x: Current.Carrier z)(closed: (Current.boundary z).apply x = (Current.space (Degrees.previous z)).zero) =>
    trans!{{Current.Carrier z}} _ _ _
      (sym!{{Current.Carrier z}} _ _ (Transport.castRefl Reduced.Carrier z ((Current.boundary (Degrees.next z)).apply ((Fill.map).apply x))))
      (Fill.boundary (H.cycle x closed));
