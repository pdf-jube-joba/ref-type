\definition n: N.Nat^ := N.Nat^::zero;
\import \parent.\parent.At[n := n] \as Current;
\import Simplex.At[n := n] \as Domain;
\import \root.On[A := Simplex.Carrier n, B := Simplex.Carrier n, left := Domain.topology, right := Domain.topology] \as Comparison;
\import Modules.Hom[V := Current.Carrier (I.Int^::ofNat n), W := Current.Carrier (Degrees.previous (I.Int^::ofNat n)), source := Current.space (I.Int^::ofNat n), target := Current.space (Degrees.previous (I.Int^::ofNat n))] \as Linear;
\definition law: (Current.boundary (I.Int^::ofNat n)).apply \parent.Degree[n := n].value = (Current.space (Degrees.previous (I.Int^::ofNat n))).zero :=
  trans!{{Current.Carrier (Degrees.previous (I.Int^::ofNat n))}} _ _ _
    (congr!{{Current.Carrier (I.Int^::ofNat n)} {Current.Carrier (Degrees.previous (I.Int^::ofNat n))}} ((Current.boundary (I.Int^::ofNat n)).apply) _ _ (Comparison.Zero[].defect Current.cell))
    (Linear.zeroPreserved (Current.boundary (I.Int^::ofNat n)));
