\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.At[n := n] \as Lower;
\import \parent.\parent.At[n := N.Nat^::succ n] \as Higher;
\import Simplex.At[n := N.Nat^::succ n] \as Domain;
\import \root.On[A := Simplex.Carrier (N.Nat^::succ n), B := Simplex.Carrier (N.Nat^::succ n), left := Domain.topology, right := Domain.topology] \as Comparison;
\import \parent.\parent.Transition[n := n].Degree[z := I.Int^::ofNat n] \as T;
\definition law: (Higher.boundary (I.Int^::ofNat (N.Nat^::succ n))).apply \parent.Degree[n := N.Nat^::succ n].value = (T.map).apply \parent.Degree[n := n].value :=
  eq_reason_in!{{Higher.Carrier (I.Int^::ofNat n)} _
    "=" _ "by" { (Comparison.productDefect).commutes n Higher.cell }
    "=" _ "by" { congr!{{Higher.Carrier (I.Int^::ofNat n)} {Higher.Carrier (I.Int^::ofNat n)}} ((Comparison.productDefect).apply n) _ _ (\parent.\parent.DiagonalBoundary[n := n].law) }
    "=" _ "by" { \parent.Transition[n := n].law Lower.cell }
  };
