\import \parent.\parent.Vertical[p := p, q := q, i := i] \as Face;
\import \parent.\parent.Mapping[p := p, q := q, r := p, s := N.Nat^::succ q].With[f := Face.factors] \as Action;
\import Action.Pure[n := n, i := lowerIndex] \as CellAction;
\definition native: (\parent.\parent.Mapping[p := p, q := q, r := p, s := N.Nat^::succ q].native Face.factors).apply n Lower.nativeCell = (Total.Degree[n := n].Component[i := lowerIndex].injection).apply (Term.tensor leftGenerator (Right.generator q (RightSimplices.face q i HighModel.rightSimplex))) := CellAction.onGenerators LowModel.leftSimplex LowModel.rightSimplex;
\definition law: (Face.Degree[z := z].map).apply Lower.Defect[].value = (rightMap).apply (Right.generator q (RightSimplices.face q i HighModel.rightSimplex)) :=
  trans!{{HighModel.Carrier z}} _ _ _
    (congr!{{Total.Carrier n} {HighModel.Carrier z}} (Signed.Positive[n := n].intro) _ _ (Action.Defect[n := n].law Lower.nativeCell))
    (congr!{{Total.Carrier n} {HighModel.Carrier z}} ((projection).apply) _ _ native);
