\definition degree: N.Nat^ := N.Nat^::succ n;
\import \parent.Cases[] \as Cases;
\import Double.Coordinates[C := Tensor.complex].Degree[n := degree] \as Coordinates;
\import Double.TensorMapping[C := Left.complex, D := Left.complex, E := Right.complex, F := Right.complex].With[f := LeftContraction.projection, g := RightContraction.projection] \as Action;
\import Double.Map[C := Tensor.complex, D := Tensor.complex].Total[f := Action.map].Coordinates[n := degree] \as Mapping;
\definition law[x: Total.Carrier degree]: (projection).apply degree x = (Total.space degree).zero := Coordinates.zero _
  (\fun (i: Double.Index degree) => trans!{{Tensor.Carrier (i).first (i).second}} _ _ _ (Mapping.law i x)
    (Cases.all (i).first (i).second n (Double.degree degree i) (Coordinates.coordinate i x)));
