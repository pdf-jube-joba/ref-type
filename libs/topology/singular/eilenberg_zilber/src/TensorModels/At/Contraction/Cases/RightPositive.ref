\definition a: N.Nat^ := N.Nat^::zero;
\definition higher: N.Nat^ := N.Nat^::succ b;
\import Tensor.Term[p := a, q := higher] \as Current;
\import Action.Degree[p := a, q := higher] \as Mapping;
\import Modules.Tensor[V := Left.Carrier a, W := Right.Carrier higher, left := Left.space a, right := Right.space higher].Universal[U := Current.Carrier, target := Current.space] \as Universal;
\definition onTensor[x: Left.Carrier a][y: Right.Carrier higher]: (Mapping.map).apply (Current.tensor x y) = (Current.space).zero :=
  trans!{Current.Carrier} _ _ _ (Mapping.onTensor x y)
    (trans!{Current.Carrier} _ _ _ (congr!{{Right.Carrier higher} Current.Carrier} (Current.tensor ((LeftContraction.projection).apply a x)) _ _ (RightContraction.Positive[n := b].law y))
      (Current.zeroRight ((LeftContraction.projection).apply a x)));
\definition equality: \parent.Term[a := a, b := higher].map = \parent.Term[a := a, b := higher].zero := Universal.ext _ _ onTensor;
\import Modules.Hom[V := Current.Carrier, W := Current.Carrier, source := Current.space, target := Current.space] \as Linear;
\definition law: Pointwise a higher := \fun (x: Current.Carrier) => congr!{Linear.Map Current.Carrier} (\fun (f: Linear.Map) => (f).apply x) _ _ equality;
