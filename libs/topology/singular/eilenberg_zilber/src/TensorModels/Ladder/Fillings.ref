\import Double.AcyclicDiagonal[].Of[model := model] \as Recursion;
\definition operator: \forall (n: N.Nat^) -> Modules.Hom[
  V := model.family.Carrier (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ n)),
  W := model.family.Carrier (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n))),
  source := model.family.space (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ n)),
  target := model.family.space (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n)))].Map :=
  \fun (n: N.Nat^) => \root.TensorModels[].PositiveFilling[n := n].map;
\definition boundary: \forall (n: N.Nat^)(x: model.family.Carrier (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ n))) ->
  (model.operators.boundary (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ n))).apply x =
    (model.family.space (N.Nat^::succ n) (I.Int^::ofNat n)).zero ->
  (model.operators.boundary (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n)))).apply
    ((operator n).apply x) = x :=
  \fun (n: N.Nat^) => \root.TensorModels[].PositiveFilling[n := n].boundary;
\definition data: Recursion.PositiveFillings := Recursion.PositiveFillings {
  operator := operator,
  boundary := boundary,
};
