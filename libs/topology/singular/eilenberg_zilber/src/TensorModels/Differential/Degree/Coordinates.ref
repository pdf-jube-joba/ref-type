\import \parent.\parent.\parent.Level[n := n, z := z] \as SourceLevel;
\import \parent.\parent.\parent.Level[n := n, z := Degrees.previous z] \as TargetLevel;
\import SourceLevel.Coordinates[] \as SourceCoordinates;
\import TargetLevel.Coordinates[] \as TargetCoordinates;
\import Modules.DirectSum[Index := Double.Index n, family := SourceLevel.family].Mapping[targetFamily := TargetLevel.family] \as Mapping;
\definition components: Mapping.Data := \fun (i: Double.Index n) => \parent.\parent.\parent.At[p := (i).first, q := (i).second].boundary z;
\import Mapping.Coordinates[f := components] \as Natural;
\import \parent.\parent.Degree[n := n] \as Current;
\definition law[i: Double.Index n][x: SourceLevel.Carrier]: TargetCoordinates.coordinate i ((Current.map).apply x) = (components i).apply (SourceCoordinates.coordinate i x) := Natural.law i x;
