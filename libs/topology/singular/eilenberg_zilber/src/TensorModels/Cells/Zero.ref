\definition n: N.Nat^ := N.Nat^::zero;
\definition z: I.Int^ := I.Int^::ofNat n;
\import \parent.\parent.Level[n := n, z := z] \as Source;
\import \parent.\parent.Level[n := n, z := Degrees.previous z] \as Target;
\import \parent.\parent.Differential[z := z].Degree[n := n] \as Differential;
\import Differential.Coordinates[] \as Boundary;
\definition value: Source.Carrier := \parent.Degree[n := n].value;
\definition closed: (Differential.map).apply value = (Target.space).zero := Target.Coordinates[].ext _ _
  (\fun (i: Double.Index n) => trans!{{\parent.\parent.At[p := (i).first, q := (i).second].Carrier (Degrees.previous z)}} _ _ _ (Boundary.law i value)
    (sym!{{\parent.\parent.At[p := (i).first, q := (i).second].Carrier (Degrees.previous z)}} _ _ Target.Coordinates[].At[i := i].zero));
\module At(i: Double.Index n) {
  \import \parent.\parent.\parent.Cell[n := n, i := i] \as Cell;
  \definition vanishes: Cell.Defect[].value = (\parent.\parent.\parent.At[p := (i).first, q := (i).second].space z).zero := Cell.Defect[].Zero[].law Cell.nativeCell;
}
\definition vanishes: value = (Source.space).zero := Source.Coordinates[].ext _ _
  (\fun (i: Double.Index n) => trans!{{\parent.\parent.At[p := (i).first, q := (i).second].Carrier z}} _ _ _ (\parent.Degree[n := n].coordinate i)
    (trans!{{\parent.\parent.At[p := (i).first, q := (i).second].Carrier z}} _ _ _ At[i := i].vanishes
      (sym!{{\parent.\parent.At[p := (i).first, q := (i).second].Carrier z}} _ _ Source.Coordinates[].At[i := i].zero)));
