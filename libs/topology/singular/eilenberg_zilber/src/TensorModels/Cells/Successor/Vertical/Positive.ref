\import \root.TensorModels[].VerticalCellBoundary[n := n, q := q, p := p] \as ModelBoundary;
\definition i: Double.Index (N.Nat^::succ n) := ModelBoundary.upperIndex;
\import \parent.\parent.At[i := i] \as Current;
\import Coordinates.Step[n := n, i := ModelBoundary.lowerIndex].Vertical[] \as CoordinateBoundary;
\import \root.TensorModels[].Fixed[z := z].Vertical[p := p, q := q] \as Faces;
\definition law: Point i :=
  trans!{{\root.TensorModels[].At[p := (i).first, q := (i).second].Carrier z}} _ _ _ ModelBoundary.boundary
    (sym!{{\root.TensorModels[].At[p := (i).first, q := (i).second].Carrier z}} _ _
      (trans!{{\root.TensorModels[].At[p := (i).first, q := (i).second].Carrier z}} _ _ _ (CoordinateBoundary.law LowerCells.value)
        (congr!{{\root.TensorModels[].At[p := p, q := q].Carrier z} {\root.TensorModels[].At[p := (i).first, q := (i).second].Carrier z}} ((CoordinateBoundary.original).apply) _ _ (LowerCells.coordinate ModelBoundary.lowerIndex))));
