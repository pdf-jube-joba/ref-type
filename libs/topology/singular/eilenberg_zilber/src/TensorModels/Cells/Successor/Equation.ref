\use std.Logic[].Equality[].eq_reason_in;
\import \parent.At[i := i] \as Current;
\import \root.TensorModels[].At[p := (i).first, q := (i).second] \as Model;
\definition law: Target.Coordinates[].coordinate i ((Differential.map).apply UpperCells.value) = Target.Coordinates[].coordinate i ((Lower.transition).apply LowerCells.value) :=
  eq_reason_in!{{Model.Carrier z} _
    "=" _ "by" Current.left
    "=" _ "by" { congr!{{Model.Carrier z} {Model.Carrier z} {Model.Carrier z}} ((Model.space z).add) _ _ _ _ (\parent.Horizontal[].law i) (\parent.Vertical[].law i) }
    "=" _ "by" { sym!{{Model.Carrier z}} _ _ Current.right }
  };
