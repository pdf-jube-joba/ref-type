\module At(z: I.Int^) {
  \import \root.TensorModels[].Fixed[z := z] \as Fixed;
  \import Diagram.Total[C := Fixed.complex] \as Total;
  \import \root.TensorModels[].Differential[z := z] \as Boundary;
  \import Diagram.Map[C := Fixed.complex, D := \root.TensorModels[].Fixed[z := Degrees.previous z].complex].Total[f := Boundary.map] \as Action;
  \definition transitionSquare: \forall (n: N.Nat^)(x: \root.TensorModels[].Level[n := n, z := z].Carrier) -> (\root.TensorModels[].Level[n := N.Nat^::succ n, z := z].transition).apply ((\root.TensorModels[].Level[n := n, z := z].transition).apply x) = (\root.TensorModels[].Level[n := N.Nat^::succ (N.Nat^::succ n), z := z].space).zero := (Total.complex.laws).squareZero;
  \definition commutes[n: N.Nat^][x: \root.TensorModels[].Level[n := n, z := z].Carrier]: (Boundary.Degree[n := N.Nat^::succ n].map).apply ((\root.TensorModels[].Level[n := n, z := z].transition).apply x) = (\root.TensorModels[].Level[n := n, z := Degrees.previous z].transition).apply ((Boundary.Degree[n := n].map).apply x) := sym!{{\root.TensorModels[].Level[n := N.Nat^::succ n, z := Degrees.previous z].Carrier}} _ _ ((Action.map).commutes n x);
}
\definition transitionSquare: \forall (n: N.Nat^)(z: I.Int^)(x: \root.TensorModels[].Level[n := n, z := z].Carrier) ->
  (\root.TensorModels[].Level[n := N.Nat^::succ n, z := z].transition).apply
    ((\root.TensorModels[].Level[n := n, z := z].transition).apply x) =
    (\root.TensorModels[].Level[n := N.Nat^::succ (N.Nat^::succ n), z := z].space).zero :=
  \fun (n: N.Nat^)(z: I.Int^) => At[z := z].transitionSquare n;
\definition commutes: \forall (n: N.Nat^)(z: I.Int^)(x: \root.TensorModels[].Level[n := n, z := z].Carrier) ->
  (\root.TensorModels[].Differential[z := z].Degree[n := N.Nat^::succ n].map).apply
    ((\root.TensorModels[].Level[n := n, z := z].transition).apply x) =
    (\root.TensorModels[].Level[n := n, z := Degrees.previous z].transition).apply
      ((\root.TensorModels[].Differential[z := z].Degree[n := n].map).apply x) :=
  \fun (n: N.Nat^)(z: I.Int^) => At[z := z].commutes n;
