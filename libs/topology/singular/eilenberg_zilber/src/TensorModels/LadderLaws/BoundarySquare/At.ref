\use std.Logic[].Equality[].eq_reason_in;
\definition previous: I.Int^ := Degrees.previous z;
\definition twice: I.Int^ := Degrees.previous previous;
\import \root.TensorModels[].Fixed[z := z] \as SourceFixed;
\import \root.TensorModels[].Fixed[z := previous] \as MiddleFixed;
\import \root.TensorModels[].Fixed[z := twice] \as TargetFixed;
\import Diagram.Total[C := SourceFixed.complex].Degree[n := n] \as Source;
\import Diagram.Total[C := MiddleFixed.complex].Degree[n := n] \as Middle;
\import Diagram.Total[C := TargetFixed.complex].Degree[n := n] \as Target;
\import \root.TensorModels[].Differential[z := z] \as FirstBoundary;
\import \root.TensorModels[].Differential[z := previous] \as SecondBoundary;
\import Diagram.Map[C := SourceFixed.complex, D := MiddleFixed.complex].Total[f := FirstBoundary.map].Degree[n := n] \as Initial;
\import Diagram.Map[C := MiddleFixed.complex, D := TargetFixed.complex].Total[f := SecondBoundary.map].Degree[n := n] \as Final;
\import Modules.Hom[V := Middle.Carrier, W := Target.Carrier, source := Middle.space, target := Target.space].Composition[U := Source.Carrier, domain := Source.space] \as Composition;
\import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Linear;
\definition lhs: Linear.Map := Composition.compose Final.map Initial.map;
\module At(i: Double.Index n) {
  \import \root.TensorModels[].At[p := (i).first, q := (i).second] \as Model;
  \import Modules.Hom[V := Model.Carrier twice, W := Target.Carrier, source := Model.space twice, target := Target.space] \as Injection;
  \definition law[x: Model.Carrier z]: (lhs).apply ((Source.Component[i := i].injection).apply x) = (Target.space).zero :=
    eq_reason_in!{Target.Carrier _
      "=" _ "by" { congr!{Middle.Carrier Target.Carrier} ((Final.map).apply) _ _ (Initial.onInjection i x) }
      "=" _ "by" { Final.onInjection i ((Model.boundary z).apply x) }
      "=" _ "by" { congr!{{Model.Carrier twice} Target.Carrier} ((Target.Component[i := i].injection).apply) _ _ (Model.squareZero z x) }
      "=" _ "by" { Injection.zeroPreserved (Target.Component[i := i].injection) }
    };
}
\import Modules.DirectSum[Index := Double.Index n, family := Source.family].To[W := Target.Carrier, target := Target.space] \as Universal;
\definition equation: lhs = Linear.zeroMap := Universal.ext lhs Linear.zeroMap (\fun (i: Double.Index n) => At[i := i].law);
\definition law[x: Source.Carrier]: (SecondBoundary.Degree[n := n].map).apply ((FirstBoundary.Degree[n := n].map).apply x) = (Target.space).zero := congr!{Linear.Map Target.Carrier} (\fun (f: Linear.Map) => (f).apply x) _ _ equation;
