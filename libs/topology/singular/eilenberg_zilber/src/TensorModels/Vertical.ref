\import \parent.At[p := p, q := q] \as Source;
\import \parent.At[p := p, q := N.Nat^::succ q] \as Target;
\import Simplex.At[n := p] \as LeftSource;
\import Simplex.At[n := q] \as RightSource;
\import Simplex.At[n := p] \as LeftTarget;
\import Simplex.At[n := N.Nat^::succ q] \as RightTarget;
\import Simplex.Faces[n := q] \as Faces;
\import topology.Maps[A := Simplex.Carrier p, B := Simplex.Carrier p].Identity[] \as Identity;
\import \parent.Mapping[p := p, q := q, r := p, s := N.Nat^::succ q] \as Mapping;
\definition factors: Mapping.Map := Mapping.Map {
  leftFunction := (\fun (x: Simplex.Carrier p) => x), rightFunction := Simplex.face q i,
  leftContinuous := Identity.continuous LeftSource.topology, rightContinuous := Faces.continuous i,
};
\import Mapping.With[f := factors] \as Induced;
\module Degree(z: I.Int^) {
  \definition map: Modules.Hom[V := Source.Carrier z, W := Target.Carrier z, source := Source.space z, target := Target.space z].Map := Induced.Degree[z := z].map;
}
\definition commutes: \forall (z: I.Int^)(x: Source.Carrier z) -> (Target.boundary z).apply ((Degree[z := z].map).apply x) = (Degree[z := Degrees.previous z].map).apply ((Source.boundary z).apply x) := Induced.commutes;
