\definition left: \Prop := \forall (x: Simplex.Carrier p) -> f.leftFunction x = g.leftFunction x;
\definition right: \Prop := \forall (x: Simplex.Carrier q) -> f.rightFunction x = g.rightFunction x;
\definition law: left -> right -> native f = native g := \fun (lf: left)(rg: right) => congr!{LeftLinear.Map RightLinear.Map TotalLinear.Map} tensor _ _ _ _
  (LeftMaps.FunctionEquality[].law f.leftFunction f.leftContinuous g.leftFunction g.leftContinuous lf)
  (RightMaps.FunctionEquality[].law f.rightFunction f.rightContinuous g.rightFunction g.rightContinuous rg);
\definition signedLaw: left -> right -> arrow f = arrow g := \fun (lf: left)(rg: right) => congr!{TotalLinear.Map Arrow} lift _ _ (law lf rg);
