\definition leftPush: LeftLinear.Map := LeftMaps.push f.leftFunction f.leftContinuous;
\definition rightPush: RightLinear.Map := RightMaps.push f.rightFunction f.rightContinuous;
\import \parent.Tensor[f := leftPush, g := rightPush] \as TensorAction;
\definition native: TotalLinear.Map := TensorAction.map;
\import \parent.Lift[f := native] \as Extended;
\definition arrow: SignedMaps.Map := Extended.map;
