\import Double.TensorMapping[C := InitialLeft.complex, D := FinalLeft.complex, E := InitialRight.complex, F := FinalRight.complex].With[f := leftPush f, g := rightPush f] \as TensorAction;
\import Double.Map[C := SourceTensor.complex, D := TargetTensor.complex].Total[f := TensorAction.map] \as TotalAction;
\definition sourceValue[x: InitialLeft.Carrier (i).first][y: InitialRight.Carrier (i).second]: SourceTotal.Carrier n :=
  (SourceTotal.Degree[n := n].Component[i := i].injection).apply (SourceTensor.Term[p := (i).first, q := (i).second].tensor x y);
\definition targetValue[x: FinalLeft.Carrier (i).first][y: FinalRight.Carrier (i).second]: TargetTotal.Carrier n :=
  (TargetTotal.Degree[n := n].Component[i := i].injection).apply (TargetTensor.Term[p := (i).first, q := (i).second].tensor x y);
\definition law[x: InitialLeft.Carrier (i).first][y: InitialRight.Carrier (i).second]: (native f).apply n (sourceValue x y) = targetValue ((leftPush f).apply (i).first x) ((rightPush f).apply (i).second y) :=
  trans!{{TargetTotal.Carrier n}} _ _ _ (TotalAction.Degree[n := n].onInjection i (SourceTensor.Term[p := (i).first, q := (i).second].tensor x y))
    (congr!{{TargetTensor.Term[p := (i).first, q := (i).second].Carrier} {TargetTotal.Carrier n}} ((TargetTotal.Degree[n := n].Component[i := i].injection).apply) _ _ (TensorAction.Degree[p := (i).first, q := (i).second].onTensor x y));
\definition signedLaw[x: InitialLeft.Carrier (i).first][y: InitialRight.Carrier (i).second]: (\parent.Degree[z := I.Int^::ofNat n].map).apply (SourceSigned.Positive[n := n].intro (sourceValue x y)) = TargetSigned.Positive[n := n].intro (targetValue ((leftPush f).apply (i).first x) ((rightPush f).apply (i).second y)) :=
  congr!{{TargetTotal.Carrier n} {Target.Carrier (I.Int^::ofNat n)}} (TargetSigned.Positive[n := n].intro) _ _ (law x y);
\import singular_cohomology.Simplices[A := Simplex.Carrier p, source := LeftSource.topology] \as LeftSimplices;
\import singular_cohomology.Simplices[A := Simplex.Carrier q, source := RightSource.topology] \as RightSimplices;
\definition onGenerators[sigma: LeftSimplices.Carrier (i).first][tau: RightSimplices.Carrier (i).second]:
  (native f).apply n (sourceValue (InitialLeft.generator (i).first sigma) (InitialRight.generator (i).second tau)) =
  targetValue (FinalLeft.generator (i).first (LeftMaps.postcompose (i).first f.leftFunction f.leftContinuous sigma)) (FinalRight.generator (i).second (RightMaps.postcompose (i).second f.rightFunction f.rightContinuous tau)) :=
  trans!{{TargetTotal.Carrier n}} _ _ _ (law (InitialLeft.generator (i).first sigma) (InitialRight.generator (i).second tau))
    (congr!{{FinalLeft.Carrier (i).first} {FinalRight.Carrier (i).second} {TargetTotal.Carrier n}} targetValue _ _ _ _
      (LeftMaps.At[n := (i).first].onGenerator f.leftFunction f.leftContinuous sigma)
      (RightMaps.At[n := (i).second].onGenerator f.rightFunction f.rightContinuous tau));
