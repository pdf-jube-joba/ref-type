\import \parent.\parent.At[p := p, q := q] \as Source;
\import \parent.\parent.At[p := N.Nat^::succ p, q := q] \as Middle;
\import \parent.\parent.At[p := N.Nat^::succ (N.Nat^::succ p), q := q] \as Target;
\import \parent.Horizontal[p := p, q := q] \as Low;
\import \parent.Horizontal[p := N.Nat^::succ p, q := q] \as High;
\definition count: N.Nat^ := N.Nat^::succ (N.Nat^::succ p);
\definition larger: N.Nat^ := N.Nat^::succ count;
\import Modules.Alternating[V := Target.Carrier z, space := Target.space z] \as Sum;
\import Modules.Alternating[V := Middle.Carrier z, space := Middle.space z].Mapping[W := Target.Carrier z, target := Target.space z] \as Mapping;
\definition terms[x: Source.Carrier z][i: Fin.Fin larger][j: Fin.Fin count]: Target.Carrier z := (High.faces i).apply ((Low.faces j).apply x);
\definition inner[x: Source.Carrier z][i: Fin.Fin larger]: (High.faces i).apply ((Low.map).apply x) = Sum.sum count (terms x i) :=
  trans!{{Target.Carrier z}} _ _ _ (congr!{{Middle.Carrier z} {Target.Carrier z}} ((High.faces i).apply) _ _ (Low.onValues x))
    (Mapping.law (High.faces i) count (\fun (j: Fin.Fin count) => (Low.faces j).apply x));
\definition law[x: Source.Carrier z]: (High.map).apply ((Low.map).apply x) = (Target.space z).zero :=
  trans!{{Target.Carrier z}} _ _ _ (High.onValues ((Low.map).apply x))
    (trans!{{Target.Carrier z}} _ _ _
      (Sum.congruent larger (\fun (i: Fin.Fin larger) => (High.faces i).apply ((Low.map).apply x)) (\fun (i: Fin.Fin larger) => Sum.sum count (terms x i)) (inner x))
      (Sum.doubleZero count (terms x) (\fun (i, j: Fin.Fin count)(ordered: N.Basic[].Prop[].Le i j) => \parent.\parent.HorizontalInterchange[p := p, q := q, i := i, j := j].law ordered z x)));
