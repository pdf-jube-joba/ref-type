\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.At[p := p, q := q] \as Source;
\import \parent.\parent.At[p := p, q := N.Nat^::succ q] \as VerticalMiddle;
\import \parent.\parent.At[p := N.Nat^::succ p, q := q] \as HorizontalMiddle;
\import \parent.\parent.At[p := N.Nat^::succ p, q := N.Nat^::succ q] \as Target;
\import \parent.Horizontal[p := p, q := q] \as LowH;
\import \parent.Horizontal[p := p, q := N.Nat^::succ q] \as HighH;
\import \parent.Vertical[p := p, q := q] \as LowV;
\import \parent.Vertical[p := N.Nat^::succ p, q := q] \as HighV;
\definition horizontalCount: N.Nat^ := N.Nat^::succ (N.Nat^::succ p);
\definition verticalCount: N.Nat^ := N.Nat^::succ (N.Nat^::succ q);
\import Modules.Alternating[V := Target.Carrier z, space := Target.space z] \as Sum;
\import Sum.Fubini[] \as Fubini;
\import Modules.Alternating[V := VerticalMiddle.Carrier z, space := VerticalMiddle.space z].Mapping[W := Target.Carrier z, target := Target.space z] \as AfterHorizontal;
\import Modules.Alternating[V := HorizontalMiddle.Carrier z, space := HorizontalMiddle.space z].Mapping[W := Target.Carrier z, target := Target.space z] \as AfterVertical;
\definition leftTerms[x: Source.Carrier z][i: Fin.Fin horizontalCount][j: Fin.Fin verticalCount]: Target.Carrier z := (HighH.faces i).apply ((LowV.faces j).apply x);
\definition rightTerms[x: Source.Carrier z][j: Fin.Fin verticalCount][i: Fin.Fin horizontalCount]: Target.Carrier z := (HighV.faces j).apply ((LowH.faces i).apply x);
\definition leftInner[x: Source.Carrier z][i: Fin.Fin horizontalCount]: (HighH.faces i).apply ((LowV.map).apply x) = Sum.sum verticalCount (leftTerms x i) :=
  trans!{{Target.Carrier z}} _ _ _ (congr!{{VerticalMiddle.Carrier z} {Target.Carrier z}} ((HighH.faces i).apply) _ _ (LowV.onValues x))
    (AfterHorizontal.law (HighH.faces i) verticalCount (\fun (j: Fin.Fin verticalCount) => (LowV.faces j).apply x));
\definition rightInner[x: Source.Carrier z][j: Fin.Fin verticalCount]: (HighV.faces j).apply ((LowH.map).apply x) = Sum.sum horizontalCount (rightTerms x j) :=
  trans!{{Target.Carrier z}} _ _ _ (congr!{{HorizontalMiddle.Carrier z} {Target.Carrier z}} ((HighV.faces j).apply) _ _ (LowH.onValues x))
    (AfterVertical.law (HighV.faces j) horizontalCount (\fun (i: Fin.Fin horizontalCount) => (LowH.faces i).apply x));
\definition leftExpansion[x: Source.Carrier z]: (HighH.map).apply ((LowV.map).apply x) = Sum.sum horizontalCount (\fun (i: Fin.Fin horizontalCount) => Sum.sum verticalCount (leftTerms x i)) :=
  trans!{{Target.Carrier z}} _ _ _ (HighH.onValues ((LowV.map).apply x)) (Sum.congruent horizontalCount _ _ (leftInner x));
\definition rightExpansion[x: Source.Carrier z]: (HighV.map).apply ((LowH.map).apply x) = Sum.sum verticalCount (\fun (j: Fin.Fin verticalCount) => Sum.sum horizontalCount (rightTerms x j)) :=
  trans!{{Target.Carrier z}} _ _ _ (HighV.onValues ((LowH.map).apply x)) (Sum.congruent verticalCount _ _ (rightInner x));
\definition interchangeInner[x: Source.Carrier z][j: Fin.Fin verticalCount]:
  Sum.sum horizontalCount (\fun (i: Fin.Fin horizontalCount) => leftTerms x i j) = Sum.sum horizontalCount (rightTerms x j) :=
  Sum.congruent horizontalCount (\fun (i: Fin.Fin horizontalCount) => leftTerms x i j) (rightTerms x j)
    (\fun (i: Fin.Fin horizontalCount) => \parent.\parent.MixedInterchange[p := p, q := q, i := i, j := j].law z x);
\definition interchange[x: Source.Carrier z]:
  Sum.sum verticalCount (\fun (j: Fin.Fin verticalCount) => Sum.sum horizontalCount (\fun (i: Fin.Fin horizontalCount) => leftTerms x i j)) =
  Sum.sum verticalCount (\fun (j: Fin.Fin verticalCount) => Sum.sum horizontalCount (rightTerms x j)) :=
  Sum.congruent verticalCount
    (\fun (j: Fin.Fin verticalCount) => Sum.sum horizontalCount (\fun (i: Fin.Fin horizontalCount) => leftTerms x i j))
    (\fun (j: Fin.Fin verticalCount) => Sum.sum horizontalCount (rightTerms x j))
    (interchangeInner x);
\definition law[x: Source.Carrier z]: (HighH.map).apply ((LowV.map).apply x) = (HighV.map).apply ((LowH.map).apply x) :=
  eq_reason_in!{{Target.Carrier z} _
    "=" _ "by" { leftExpansion x }
    "=" _ "by" { Fubini.law horizontalCount verticalCount (leftTerms x) }
    "=" _ "by" { interchange x }
    "=" _ "by" { sym!{{Target.Carrier z}} _ _ (rightExpansion x) }
  };
