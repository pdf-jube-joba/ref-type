\use std.Logic[].Equality[].eq_reason_in;
\definition z: I.Int^ := I.Int^::ofNat n;
\import \parent.At[p := p, q := q] \as LowModel;
\import \parent.At[p := p, q := N.Nat^::succ q] \as HighModel;
\import Simplex.At[n := p] \as LeftDomain;
\import Simplex.At[n := q] \as LowRightDomain;
\import Simplex.At[n := N.Nat^::succ q] \as HighRightDomain;
\import singular_cohomology.Chains[A := Simplex.Carrier p, source := LeftDomain.topology] \as Left;
\import singular_cohomology.Chains[A := Simplex.Carrier (N.Nat^::succ q), source := HighRightDomain.topology] \as Right;
\import singular_cohomology.Simplices[A := Simplex.Carrier (N.Nat^::succ q), source := HighRightDomain.topology] \as RightSimplices;
\import Double.Tensor[C := Left.complex, D := Right.complex] \as Tensor;
\import Double.Total[C := Tensor.complex] \as Total;
\import Total.Step[n := n] \as NativeBoundary;
\definition lowerP: Double.First n q := NativeBoundary.lowerFirst q p;
\definition lowerIndex: Double.Index n := Double.reverseIndex n q lowerP;
\definition upperIndex: Double.Index (N.Nat^::succ n) := Double.reverseIndex (N.Nat^::succ n) (N.Nat^::succ q) p;
\import \parent.Cell[n := n, i := lowerIndex] \as Lower;
\import \parent.Cell[n := N.Nat^::succ n, i := upperIndex] \as Upper;
\import \root.On[A := Simplex.Carrier p, B := Simplex.Carrier (N.Nat^::succ q), left := LeftDomain.topology, right := HighRightDomain.topology] \as Comparison;
\import Native.ZeroExtension[C := Total.complex] \as Signed;
\import Native.Map[C := Total.complex, D := Total.complex].At[n := n] \as Defect;
\import Modules.Hom[V := Total.Carrier n, W := HighModel.Carrier z, source := Total.space n, target := HighModel.space z].Composition[U := Total.Carrier n, domain := Total.space n] \as Lift;
\definition projection: Modules.Hom[V := Total.Carrier n, W := HighModel.Carrier z, source := Total.space n, target := HighModel.space z].Map := Lift.compose (Signed.Positive[n := n].forward) (Defect.linear Comparison.tensorDefect);
\import Tensor.Term[p := p, q := q] \as Term;
\import Modules.Hom[V := Total.Carrier n, W := HighModel.Carrier z, source := Total.space n, target := HighModel.space z].Composition[U := Term.Carrier, domain := Term.space] \as AfterInjection;
\definition injection: Modules.Hom[V := Term.Carrier, W := HighModel.Carrier z, source := Term.space, target := HighModel.space z].Map := AfterInjection.compose projection (Total.Degree[n := n].Component[i := lowerIndex].injection);
\import Modules.Tensor[V := Left.Carrier p, W := Right.Carrier q, left := Left.space p, right := Right.space q] \as Pure;
\definition leftGenerator: Left.Carrier p := Left.generator p HighModel.leftSimplex;
\import Modules.Hom[V := Term.Carrier, W := HighModel.Carrier z, source := Term.space, target := HighModel.space z].Composition[U := Right.Carrier q, domain := Right.space q] \as AfterTensor;
\definition rightMap: Modules.Hom[V := Right.Carrier q, W := HighModel.Carrier z, source := Right.space q, target := HighModel.space z].Map := AfterTensor.compose injection (Pure.rightLinear leftGenerator);
\definition unsignedPart: HighModel.Carrier z := (injection).apply ((Tensor.At[p := p, q := q].vertical).apply (Tensor.Term[p := p, q := N.Nat^::succ q].tensor leftGenerator (Right.generator (N.Nat^::succ q) HighModel.rightSimplex)));
\definition tensorBoundary: unsignedPart = (rightMap).apply ((Right.boundary q).apply (Right.generator (N.Nat^::succ q) HighModel.rightSimplex)) :=
  congr!{Term.Carrier {HighModel.Carrier z}} ((injection).apply) _ _ (Tensor.At[p := p, q := q].verticalOnTensor leftGenerator (Right.generator (N.Nat^::succ q) HighModel.rightSimplex));
\definition count: N.Nat^ := N.Nat^::succ (N.Nat^::succ q);
\module Face(i: Fin.Fin count);
\import \parent.Fixed[z := z].Vertical[p := p, q := q] \as Faces;
\import Right.Boundary[n := q].SumImage[W := HighModel.Carrier z, target := HighModel.space z] \as BoundaryImage;
\import Modules.Alternating[V := HighModel.Carrier z, space := HighModel.space z] \as Sum;
\definition values[tau: RightSimplices.Carrier q]: HighModel.Carrier z := (rightMap).apply (Right.generator q tau);
\definition unsignedBoundary: unsignedPart = (Faces.map).apply Lower.Defect[].value :=
  eq_reason_in!{{HighModel.Carrier z} _
    "=" _ "by" tensorBoundary
    "=" _ "by" { BoundaryImage.law rightMap values (\fun (tau: RightSimplices.Carrier q) => \refl(values tau)) HighModel.rightSimplex }
    "=" _ "by" { Sum.congruent count _ _ (\fun (i: Fin.Fin count) => sym!{{HighModel.Carrier z}} _ _ Face[i := i].law) }
    "=" _ "by" { sym!{{HighModel.Carrier z}} _ _ (Faces.onValues Lower.Defect[].value) }
  };
\import Double.Sign[V := Term.Carrier, space := Term.space].Mapping[W := HighModel.Carrier z, target := HighModel.space z] \as SignNaturality;
\import Double.Sign[V := HighModel.Carrier z, space := HighModel.space z] \as Sign;
\definition part: HighModel.Carrier z := (projection).apply ((NativeBoundary.vertical (N.Nat^::succ q) p).apply (Tensor.Term[p := p, q := N.Nat^::succ q].tensor leftGenerator (Right.generator (N.Nat^::succ q) HighModel.rightSimplex)));
\definition boundary: part = (Sign.map p).apply ((Faces.map).apply Lower.Defect[].value) :=
  trans!{{HighModel.Carrier z}} _ _ _
    (SignNaturality.naturality injection p ((Tensor.At[p := p, q := q].vertical).apply (Tensor.Term[p := p, q := N.Nat^::succ q].tensor leftGenerator (Right.generator (N.Nat^::succ q) HighModel.rightSimplex))))
    (congr!{{HighModel.Carrier z} {HighModel.Carrier z}} ((Sign.map p).apply) _ _ unsignedBoundary);
