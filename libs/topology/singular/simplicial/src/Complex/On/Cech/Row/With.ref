\use std.Logic[].Equality[].eq_reason_in;
\import Fin.Tuples[A := Vertex] \as Tuples;
\import Tuples.Omission[] \as Omission;
\import N.Basic[].Def[] \as Nat;
\import B.Prop[] \as BoolLaws;
\definition head[n: N.Nat^][s: Carrier n]: Vertex := s (Fin.zero n);
\definition present[n: N.Nat^][s: Carrier n]: B.Bool^ := Nat.eqb (head n s) (apex).vertex;
\definition absent: \forall (n: N.Nat^)(s: Carrier n) -> present n s = B.Bool^::false -> Logic.Not (head n s = (apex).vertex) :=
  \fun (n: N.Nat^)(s: Carrier n)(no: present n s = B.Bool^::false)(equal: head n s = (apex).vertex) =>
    BoolLaws.falseNeTrue (trans!{B.Bool^} _ _ _ (sym!{B.Bool^} _ _ no) (Bounds.eqbTrueOfEq (head n s) (apex).vertex equal));
\definition firstPresent: \forall (n: N.Nat^)(s: Carrier n) -> present n s = B.Bool^::true -> head n s = (apex).vertex :=
  \fun (n: N.Nat^)(s: Carrier n) => Bounds.eqOfEqbTrue (apex).vertex (head n s);
\definition lower: \forall (n: N.Nat^)(s: Carrier n) -> present n s = B.Bool^::false -> Bounds.Lt (apex).vertex (head n s) :=
  \fun (n: N.Nat^)(s: Carrier n)(no: present n s = B.Bool^::false) =>
    (Logic.orElim _ _ (Bounds.Lt (apex).vertex (head n s)) ((Induction.leCases (apex).vertex (head n s) ((apex).least (head n s) (common n s (Fin.zero n)))))
      (\fun (less: Bounds.Lt (apex).vertex (head n s)) => less)
      (\fun (equal: (apex).vertex = head n s) => Logic.falseElim _ (absent n s no (sym!{{Vertex}} _ _ equal))));
\definition allLower: \forall (n: N.Nat^)(s: Carrier n) -> present n s = B.Bool^::false ->
  \forall (i: Fin.Fin (N.Nat^::succ n)) -> Bounds.Lt (apex).vertex (s i) :=
  \fun (n: N.Nat^)(s: Carrier n)(no: present n s = B.Bool^::false) =>
    Ordering.Bounds[k := n, n := N.Nat^::succ d].belowHead s (Complex.admissible n s).increasing (apex).vertex (lower n s no);
\definition extended[n: N.Nat^][s: Carrier n]: Tuple (N.Nat^::succ n) := Tuples.extend (N.Nat^::succ n) (apex).vertex s;
\definition extendedCommon[n: N.Nat^][s: Carrier n]: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) -> CommonVertex (extended n s i) :=
  Fin.cases (N.Nat^::succ n) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => CommonVertex (extended n s i))
    (\idelim (apex).vertex = extended n s (Fin.zero (N.Nat^::succ n)) \with v: Vertex => CommonVertex v
      \by { base: (apex).positive, equality: sym!{{Vertex}} _ _ (Tuples.atZero (N.Nat^::succ n) (apex).vertex s) })
    (\fun (i: Fin.Fin (N.Nat^::succ n)) => \idelim s i = extended n s (Fin.succ (N.Nat^::succ n) i) \with v: Vertex => CommonVertex v
      \by { base: common n s i, equality: sym!{{Vertex}} _ _ (Tuples.atSuccessor (N.Nat^::succ n) (apex).vertex s i) });
\definition cone[n: N.Nat^][s: Carrier n][no: present n s = B.Bool^::false]: Carrier (N.Nat^::succ n) :=
  \into[Complex.Simplex (N.Nat^::succ n)](
    \into[Tuple (N.Nat^::succ n)](extended n s, Complex.Simplex (N.Nat^::succ n)) \by {
      Complex.Admissible[N.Nat^::succ n, extended n s] {
        increasing := \root.Prepending[k := N.Nat^::succ n, n := N.Nat^::succ d].With[a := (apex).vertex, tail := s].increasing
          (Complex.admissible n s).increasing (allLower n s no),
        face := Stars.commonFace (N.Nat^::succ n) (extended n s) (sigma (Geometric.lastVertex q))
          (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => extendedCommon n s i (Geometric.lastVertex q)),
      }
    }, Carrier (N.Nat^::succ n)) \by { extendedCommon n s };
\definition first: \forall (n: N.Nat^)(s: Carrier n)(no: present n s = B.Bool^::false) ->
  face n (Fin.zero (N.Nat^::succ n)) (cone n s no) = s :=
  \fun (n: N.Nat^)(s: Carrier n)(no: present n s = B.Bool^::false) => trans!{{Tuple n}} _ _ _
    (Faces.At[n := n].omission (Fin.zero (N.Nat^::succ n)) (cone n s no))
    (Omission.firstExtended (N.Nat^::succ n) (apex).vertex s);
\definition absentFaces: \forall (n: N.Nat^)(s: Carrier (N.Nat^::succ n))(no: present (N.Nat^::succ n) s = B.Bool^::false)
  (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) -> present n (face n i s) = B.Bool^::false :=
  \fun (n: N.Nat^)(s: Carrier (N.Nat^::succ n))(no: present (N.Nat^::succ n) s = B.Bool^::false)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) =>
    Bounds.eqbFalseOfNe (head n (face n i s)) (apex).vertex (\fun (equal: head n (face n i s) = (apex).vertex) =>
      Bounds.ltIrrefl (apex).vertex (\idelim head n (face n i s) = (apex).vertex \with v: Vertex => Bounds.Lt (apex).vertex v \by {
        base: allLower (N.Nat^::succ n) s no (Fin.Skipping[].apply (N.Nat^::succ n) i (Fin.zero n)), equality: equal
      }));
\definition other: \forall (n: N.Nat^)(s: Carrier (N.Nat^::succ n))(no: present (N.Nat^::succ n) s = B.Bool^::false)
  (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) ->
  face (N.Nat^::succ n) (Fin.succ (N.Nat^::succ (N.Nat^::succ n)) i) (cone (N.Nat^::succ n) s no) =
    cone n (face n i s) (absentFaces n s no i) :=
  \fun (n: N.Nat^)(s: Carrier (N.Nat^::succ n))(no: present (N.Nat^::succ n) s = B.Bool^::false)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) =>
    eq_reason_in!{{Tuple (N.Nat^::succ n)} _
      "=" _ "by" { Faces.At[n := N.Nat^::succ n].omission (Fin.succ (N.Nat^::succ (N.Nat^::succ n)) i) (cone (N.Nat^::succ n) s no) }
      "=" _ "by" { Omission.onExtended (N.Nat^::succ n) i (apex).vertex s }
      "=" _ "by" { congr!{{Tuple n} {Tuple (N.Nat^::succ n)}} (Tuples.extend (N.Nat^::succ n) (apex).vertex) _ _
          (sym!{{Tuple n}} _ _ (Faces.At[n := n].omission i s)) }
    };
\definition firstValue: \forall (n: N.Nat^)(s: Carrier (N.Nat^::succ n))(j: Fin.Fin (N.Nat^::succ n)) ->
  face n (Fin.zero (N.Nat^::succ n)) s j = s (Fin.succ (N.Nat^::succ n) j) :=
  \fun (n: N.Nat^)(s: Carrier (N.Nat^::succ n))(j: Fin.Fin (N.Nat^::succ n)) =>
    congr!{{Tuple n} {Vertex}} (\fun (v: Tuple n) => v j) _ _
      (trans!{{Tuple n}} _ _ _ (Faces.At[n := n].omission (Fin.zero (N.Nat^::succ n)) s) (Omission.first n s));
\definition laterHead: \forall (n: N.Nat^)(s: Carrier (N.Nat^::succ n))(i: Fin.Fin (N.Nat^::succ n)) ->
  head n (face n (Fin.succ (N.Nat^::succ n) i) s) = head (N.Nat^::succ n) s :=
  \fun (n: N.Nat^)(s: Carrier (N.Nat^::succ n))(i: Fin.Fin (N.Nat^::succ n)) => trans!{{Vertex}} _ _ _
    (congr!{{Tuple n} {Vertex}} (\fun (v: Tuple n) => v (Fin.zero n)) _ _
      (trans!{{Tuple n}} _ _ _ (Faces.At[n := n].omission (Fin.succ (N.Nat^::succ n) i) s) (Omission.successor n i s)))
    (Tuples.atZero n (head (N.Nat^::succ n) s) (Omission.omit n i (\fun (j: Fin.Fin (N.Nat^::succ n)) => s (Fin.succ (N.Nat^::succ n) j))));
\definition presentFirst: \forall (n: N.Nat^)(s: Carrier (N.Nat^::succ n)) -> present (N.Nat^::succ n) s = B.Bool^::true ->
  present n (face n (Fin.zero (N.Nat^::succ n)) s) = B.Bool^::false :=
  \fun (n: N.Nat^)(s: Carrier (N.Nat^::succ n))(yes: present (N.Nat^::succ n) s = B.Bool^::true) =>
    Bounds.eqbFalseOfNe (head n (face n (Fin.zero (N.Nat^::succ n)) s)) (apex).vertex (\fun (equal: head n (face n (Fin.zero (N.Nat^::succ n)) s) = (apex).vertex) =>
      Bounds.ltIrrefl (apex).vertex (\idelim s (Fin.succ (N.Nat^::succ n) (Fin.zero n)) = (apex).vertex \with v: Vertex => Bounds.Lt (apex).vertex v \by {
        base: \idelim head (N.Nat^::succ n) s = (apex).vertex \with v: Vertex => Bounds.Lt v (s (Fin.succ (N.Nat^::succ n) (Fin.zero n))) \by {
          base: Ordering.Bounds[k := N.Nat^::succ n, n := N.Nat^::succ d].headTail s (Complex.admissible (N.Nat^::succ n) s).increasing (Fin.zero n),
          equality: firstPresent (N.Nat^::succ n) s yes
        },
        equality: trans!{{Vertex}} _ _ _ (sym!{{Vertex}} _ _ (firstValue n s (Fin.zero n))) equal
      }));
\definition recover: \forall (n: N.Nat^)(s: Carrier (N.Nat^::succ n))(yes: present (N.Nat^::succ n) s = B.Bool^::true) ->
  cone n (face n (Fin.zero (N.Nat^::succ n)) s) (presentFirst n s yes) = s :=
  \fun (n: N.Nat^)(s: Carrier (N.Nat^::succ n))(yes: present (N.Nat^::succ n) s = B.Bool^::true) => eq_reason_in!{{Tuple (N.Nat^::succ n)} _
    "=" _ "by" { congr!{{Vertex} {Tuple (N.Nat^::succ n)}} (\fun (v: Vertex) => Tuples.extend (N.Nat^::succ n) v (face n (Fin.zero (N.Nat^::succ n)) s)) _ _
      (sym!{{Vertex}} _ _ (firstPresent (N.Nat^::succ n) s yes)) }
    "=" _ "by" { congr!{{Tuple n} {Tuple (N.Nat^::succ n)}} (Tuples.extend (N.Nat^::succ n) (head (N.Nat^::succ n) s)) _ _
        (trans!{{Tuple n}} _ _ _ (Faces.At[n := n].omission (Fin.zero (N.Nat^::succ n)) s) (Omission.first n s)) }
    "=" _ "by" { Tuples.recover (N.Nat^::succ n) s }
  };
\definition presentOthers: \forall (n: N.Nat^)(s: Carrier (N.Nat^::succ n)) -> present (N.Nat^::succ n) s = B.Bool^::true ->
  \forall (i: Fin.Fin (N.Nat^::succ n)) -> present n (face n (Fin.succ (N.Nat^::succ n) i) s) = B.Bool^::true :=
  \fun (n: N.Nat^)(s: Carrier (N.Nat^::succ n))(yes: present (N.Nat^::succ n) s = B.Bool^::true)(i: Fin.Fin (N.Nat^::succ n)) =>
    Bounds.eqbTrueOfEq _ _ (trans!{{Vertex}} _ _ _ (laterHead n s i) (firstPresent (N.Nat^::succ n) s yes));
\definition apexSimplex: Carrier N.Nat^::zero :=
  \into[Complex.Simplex N.Nat^::zero](Augmentation.Label[q := q, sigma := sigma].With[w :=
    Augmentation.Label[q := q, sigma := sigma].Witness { vertex := (apex).vertex, positive := (apex).positive }].vertices, Carrier N.Nat^::zero) \by {
      \fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => (apex).positive
    };
\definition zero: \forall (s: Carrier N.Nat^::zero) -> present N.Nat^::zero s = B.Bool^::true -> s = apexSimplex :=
  \fun (s: Carrier N.Nat^::zero)(yes: present N.Nat^::zero s = B.Bool^::true) =>
    \axiom:funext(s, apexSimplex, \fun (i: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => trans!{{Vertex}} _ _ _
      (congr!{{Fin.Fin (N.Nat^::succ N.Nat^::zero)} {Vertex}} s _ _ (Fin.singletonValue i))
      (firstPresent N.Nat^::zero s yes));
\definition last: \forall (s: Carrier N.Nat^::zero)(no: present N.Nat^::zero s = B.Bool^::false) ->
  face N.Nat^::zero (Fin.succ (N.Nat^::succ N.Nat^::zero) (Fin.zero N.Nat^::zero)) (cone N.Nat^::zero s no) = apexSimplex :=
  \fun (s: Carrier N.Nat^::zero)(no: present N.Nat^::zero s = B.Bool^::false) =>
    \axiom:funext(face N.Nat^::zero (Fin.succ (N.Nat^::succ N.Nat^::zero) (Fin.zero N.Nat^::zero)) (cone N.Nat^::zero s no), apexSimplex,
      \fun (i: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => eq_reason_in!{{Vertex} _
        "=" _ "by" { congr!{{Fin.Fin (N.Nat^::succ N.Nat^::zero)} {Vertex}}
          (face N.Nat^::zero (Fin.succ (N.Nat^::succ N.Nat^::zero) (Fin.zero N.Nat^::zero)) (cone N.Nat^::zero s no)) _ _ (Fin.singletonValue i) }
        "=" _ "by" { laterHead N.Nat^::zero (cone N.Nat^::zero s no) (Fin.zero N.Nat^::zero) }
        "=" _ "by" { Tuples.atZero (N.Nat^::succ N.Nat^::zero) (apex).vertex s }
      });
\import singular_cech.PartialCone[].On[X := object] \as PartialCone;
\definition data: PartialCone.Data := PartialCone.Data {
  present := present,
  cone := \fun (n: N.Nat^)(s: \Cast[Carrier n] ({ t: Carrier n \where present n t = B.Bool^::false })) =>
    cone n s (\bysub(Carrier n, { t: Carrier n \where present n t = B.Bool^::false }, s)),
  apex := apexSimplex,
};
\definition laws: PartialCone.Laws[data] := PartialCone.Laws[data] {
  first := first, absentFaces := absentFaces, other := other, presentFirst := presentFirst,
  recover := recover, presentOthers := presentOthers, zero := zero, last := last,
};
\definition partialCone: PartialCone.Cone := \into[PartialCone.Data](data, PartialCone.Cone) \by { laws };
