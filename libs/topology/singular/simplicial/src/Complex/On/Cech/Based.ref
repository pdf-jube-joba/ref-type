\import \parent.Bicomplex[] \as Bicomplex;
\import Doubles.Total[C := Bicomplex.complex] \as Total;
\import Total.Degree[n := n] \as Degree;
\structure Cell: \Set := {
  index: Doubles.Index n,
  simplex: Generator (index).first (index).second,
};
\definition generator[c: Cell]: Total.Carrier n :=
  (Degree.Component[i := (c).index].injection).apply (\parent.At[p := ((c).index).first, q := ((c).index).second].generator (c).simplex);
\module To(W: \Set, target: Modules.Space W) {
  \import Modules.DirectSum[Index := Doubles.Index n, family := Degree.family].To[W := W, target := target] \as Sum;
  \module Component(i: Doubles.Index n) {
    \import Modules.Free[Generators := Generator (i).first (i).second].To[W := W, target := target] \as Free;
    \definition map[values: Cell -> W]: Modules.Hom[V := Carrier (i).first (i).second, W := W, source := space (i).first (i).second, target := target].Map :=
      Free.extension (\fun (s: Generator (i).first (i).second) => values (Cell { index := i, simplex := s }));
    \definition onGenerator: \forall (values: Cell -> W)(s: Generator (i).first (i).second) ->
      (map values).apply (\parent.\parent.\parent.At[p := (i).first, q := (i).second].generator s) = values (Cell { index := i, simplex := s }) :=
      \fun (values: Cell -> W) => Free.onGenerator (\fun (s: Generator (i).first (i).second) => values (Cell { index := i, simplex := s }));
    \import Modules.Hom[V := Total.Carrier n, W := W, source := Total.space n, target := target]
      .Composition[U := Carrier (i).first (i).second, domain := space (i).first (i).second] \as Compose;
    \definition restrict[f: Modules.Hom[V := Total.Carrier n, W := W, source := Total.space n, target := target].Map]:
      Modules.Hom[V := Carrier (i).first (i).second, W := W, source := space (i).first (i).second, target := target].Map := Compose.compose f (Degree.Component[i := i].injection);
  }
  \definition components[values: Cell -> W]: Sum.Components := \fun (i: Doubles.Index n) => Component[i := i].map values;
  \definition extension[values: Cell -> W]: Modules.Hom[V := Total.Carrier n, W := W, source := Total.space n, target := target].Map := Sum.extension (components values);
  \definition onGenerator: \forall (values: Cell -> W)(c: Cell) -> (extension values).apply (generator c) = values c :=
    \fun (values: Cell -> W) => \induction (c: Cell) \return (extension values).apply (generator c) = values c \with {
      | # : \fun (i: Doubles.Index n)(s: Generator (i).first (i).second) => trans!{{W}} _ _ _
        (Sum.onInjection (components values) i (\parent.\parent.At[p := (i).first, q := (i).second].generator s))
        (Component[i := i].onGenerator values s)
    };
  \import Modules.Hom[V := Total.Carrier n, W := W, source := Total.space n, target := target] \as Maps;
  \definition ext: \forall (f, g: Maps.Map) -> (\forall (c: Cell) -> (f).apply (generator c) = (g).apply (generator c)) -> f = g :=
    \fun (f, g: Maps.Map)(same: \forall (c: Cell) -> (f).apply (generator c) = (g).apply (generator c)) =>
      Sum.ext f g (\fun (i: Doubles.Index n)(x: Carrier (i).first (i).second) =>
        congr!{{Modules.Hom[V := Carrier (i).first (i).second, W := W, source := space (i).first (i).second, target := target].Map} {W}}
          (\fun (h: Modules.Hom[V := Carrier (i).first (i).second, W := W, source := space (i).first (i).second, target := target].Map) => (h).apply x) _ _
          (Modules.Free[Generators := Generator (i).first (i).second].To[W := W, target := target].ext (Component[i := i].restrict f) (Component[i := i].restrict g)
            (\fun (s: Generator (i).first (i).second) => same (Cell { index := i, simplex := s }))));
}
