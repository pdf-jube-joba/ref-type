\import \parent.\parent.Based[n := n] \as Based;
\import Algebra.HomAt[n := n, z := z] \as Hom;
\definition Member[f: Hom.Carrier]: \Prop := \forall (c: Based.Cell) ->
  \parent.Cell[n := n, c := c].Degree[z := z].Member ((f).apply (Based.generator c));
\definition support: Hom.Submodule := Hom.Submodule {
  carrier := { f: Hom.Carrier \where Member f },
  zero := \fun (c: Based.Cell) => \parent.Cell[n := n, c := c].Degree[z := z].zero,
  addition := \fun (f, g: Hom.Carrier)(left: Member f)(right: Member g)(c: Based.Cell) =>
    (\parent.Cell[n := n, c := c].Degree[z := z].image).addition ((f).apply (Based.generator c)) ((g).apply (Based.generator c)) (left c) (right c),
  scalar := \fun (a: I.Int^)(f: Hom.Carrier)(member: Member f)(c: Based.Cell) =>
    (\parent.Cell[n := n, c := c].Degree[z := z].image).scalar a ((f).apply (Based.generator c)) (member c),
};
\module Boundary(f: Hom.Carrier, member: Member f) {
  \module At(c: Based.Cell) {
    \import \parent.\parent.\parent.Cell[n := n, c := c] \as Cell;
    \import Cell.Degree[z := z] \as Degree;
    \import Cell.Degree[z := Degrees.previous z] \as Lower;
    \definition value: _ := Degree.lift ((f).apply (Based.generator c)) (member c);
    \definition law: Lower.Member ((Global.differential).apply z ((f).apply (Based.generator c))) :=
      Lower.introduce _ ((Cell.localComplex.differential).apply z value)
        (trans!{{Global.Carrier (Degrees.previous z)}} _ _ _
          (sym!{{Global.Carrier (Degrees.previous z)}} _ _ ((Cell.map).commutes z value))
          (congr!{{Global.Carrier z} {Global.Carrier (Degrees.previous z)}} ((Global.differential).apply z) _ _
            (Degree.equation ((f).apply (Based.generator c)) (member c))));
  }
  \definition law: \forall (c: Based.Cell) -> \parent.\parent.Cell[n := n, c := c].Degree[z := Degrees.previous z].Member
    ((Algebra.Boundary[n := n, z := z].value f).apply (Based.generator c)) := \fun (c: Based.Cell) => At[c := c].law;
}
