\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Delta[] \as Delta;
\import Doubles.AcyclicDiagonal[] \as Acyclic;
\import Acyclic.Of[model := Supported.model] \as Recursion;
\definition fillings: Recursion.Fillings := Recursion.Fillings {
  operator := \fun (n: N.Nat^) => \parent.Filling[n := n].map,
  boundary := \fun (n: N.Nat^) => \parent.Filling[n := n].boundary,
};
\import Supported.Diagonal[delta := Delta.map, carried := Delta.carried] \as Diagonal;
\import Recursion.On[fillings := fillings, cells := Diagonal.cells] \as Rec;
\import Native.Homotopy[C := Total.complex, D := Whole.complex] \as Homotopies;
\definition data: Homotopies.Data := Homotopies.Data { apply := \fun (n: N.Nat^) => (Rec.value n).apply };
\module Zero {
  \definition degree: N.Nat^ := N.Nat^::zero;
  \import Modules.Laws[V := Whole.Carrier degree, space := Whole.space degree] \as Values;
  \import algebra.Group[].Of[Carrier := Whole.Carrier degree, group := Values.additive] \as Group;
  \definition boundary: \forall (x: Total.Carrier degree) -> (Whole.boundary degree).apply ((data).apply degree x) =
    Group.difference ((difference).apply degree x) (Whole.space degree).zero :=
    \fun (x: Total.Carrier degree) => congr!{{Supported.Carrier degree (I.Int^::ofNat degree)} {Whole.Carrier degree}}
      (\fun (f: Supported.Carrier degree (I.Int^::ofNat degree)) => (f).apply x) _ _ (Rec.boundary degree);
  \definition law: \forall (x: Total.Carrier degree) -> Group.difference ((first).apply degree x) ((second).apply degree x) =
    (Whole.boundary degree).apply ((data).apply degree x) :=
    \fun (x: Total.Carrier degree) => sym!{{Whole.Carrier degree}} _ _ (eq_reason_in!{{Whole.Carrier degree} _
      "=" _ "by" { boundary x }
      "=" _ "by" { congr!{{Whole.Carrier degree} {Whole.Carrier degree}} (Values.add ((difference).apply degree x)) _ _ Group.negZero }
      "=" _ "by" { Group.zeroRight ((difference).apply degree x) }
    });
}
\module Positive(n: N.Nat^) {
  \definition degree: N.Nat^ := N.Nat^::succ n;
  \import Modules.Laws[V := Whole.Carrier degree, space := Whole.space degree] \as Values;
  \import algebra.Group[].Of[Carrier := Whole.Carrier degree, group := Values.additive] \as Group;
  \definition prior[x: Total.Carrier degree]: Whole.Carrier degree := (data).apply n ((Total.differential).apply n x);
  \definition boundary: \forall (x: Total.Carrier degree) -> (Whole.boundary degree).apply ((data).apply degree x) =
    Group.difference ((difference).apply degree x) (prior x) :=
    \fun (x: Total.Carrier degree) => congr!{{Supported.Carrier degree (I.Int^::ofNat degree)} {Whole.Carrier degree}}
      (\fun (f: Supported.Carrier degree (I.Int^::ofNat degree)) => (f).apply x) _ _ (Rec.boundary degree);
  \definition law: \forall (x: Total.Carrier degree) -> Group.difference ((first).apply degree x) ((second).apply degree x) =
    (Whole.space degree).add ((Whole.boundary degree).apply ((data).apply degree x)) ((data).apply n ((Total.differential).apply n x)) :=
    \fun (x: Total.Carrier degree) => sym!{{Whole.Carrier degree}} _ _ (trans!{{Whole.Carrier degree}} _ _ _
      (congr!{{Whole.Carrier degree} {Whole.Carrier degree}} (\fun (y: Whole.Carrier degree) => Values.add y (prior x)) _ _ (boundary x))
      (Group.addDifference ((difference).apply degree x) (prior x)));
}
\definition homotopy: Homotopies.Homotopy first second := \into[Homotopies.Data](data, Homotopies.Homotopy first second) \by {
  Homotopies.Laws[first, second, data] {
    addition := \fun (n: N.Nat^) => (Rec.value n).addition,
    scalar := \fun (n: N.Nat^) => (Rec.value n).scalar,
    zeroEquation := Zero[].law,
    successorEquation := \fun (n: N.Nat^) => Positive[n := n].law,
  }
};
