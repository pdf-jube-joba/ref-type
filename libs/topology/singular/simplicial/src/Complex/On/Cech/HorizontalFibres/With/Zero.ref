\use std.Logic[].Equality[].eq_reason_in;
\definition degree: N.Nat^ := N.Nat^::zero;
\import \parent.\parent.\parent.SmallAugmentation[] \as Augmentation;
\import singular_subdivision.Small[A := Realization.Carrier, source := Realization.topology, family := Stars.family] \as Small;
\import Contracted.Zero[] \as Reduced;
\import Modules.Hom[V := Coproduct.Carrier degree, W := Small.Carrier q, source := Coproduct.space degree, target := Small.space q]
  .Composition[U := Native.Carrier degree, domain := Native.space degree] \as Compose;
\import Complexes.Map[C := Native.complex, D := CoproductNative.complex].At[n := degree] \as Forward;
\import Modules.Hom[V := Native.Carrier degree, W := Small.Carrier q, source := Native.space degree, target := Small.space q] \as Maps;
\definition augmentation: Maps.Map := Maps.Map {
  apply := (Augmentation.map).apply q, addition := (Augmentation.map).addition q, scalar := (Augmentation.map).scalar q,
};
\import Modules.Free[Generators := Generator degree q].To[W := Small.Carrier q, target := Small.space q] \as Free;
\definition equation: Compose.compose Reduced.augmentation (Forward.linear forwardMap) = augmentation :=
  Free.ext _ _ (\fun (s: Generator degree q) => eq_reason_in!{{Small.Carrier q} _
    "=" _ "by" { congr!{{Coproduct.Carrier degree} {Small.Carrier q}} ((Reduced.augmentation).apply) _ _ (Encode.At[n := degree].onGenerator forward s) }
    "=" _ "by" { Reduced.augmentationOnGenerator (encode degree s) }
    "=" _ "by" { sym!{{Small.Carrier q}} _ _ (Augmentation.onGenerator q s) }
  });
\definition compatibility: \forall (x: Native.Carrier degree) -> (Reduced.augmentation).apply ((forwardMap).apply degree x) = (augmentation).apply x :=
  \fun (x: Native.Carrier degree) => congr!{{Maps.Map} {Small.Carrier q}} (\fun (f: Maps.Map) => (f).apply x) _ _ equation;
\definition filler[x: Native.Carrier degree]: Native.Carrier (N.Nat^::succ degree) :=
  (backwardMap).apply (N.Nat^::succ degree) ((Contracted.homotopy degree).apply ((forwardMap).apply degree x));
\definition boundary: \forall (x: Native.Carrier degree) -> (augmentation).apply x = (Small.space q).zero ->
  (Native.boundary degree).apply (filler x) = x :=
  \fun (x: Native.Carrier degree)(reduced: (augmentation).apply x = (Small.space q).zero) =>
    eq_reason_in!{{Native.Carrier degree} _
      "=" _ "by" { (backwardMap).commutes degree ((Contracted.homotopy degree).apply ((forwardMap).apply degree x)) }
      "=" _ "by" { congr!{{Coproduct.Carrier degree} {Native.Carrier degree}} ((backwardMap).apply degree) _ _
          (Reduced.cycle ((forwardMap).apply degree x) (trans!{{Small.Carrier q}} _ _ _ (compatibility x) reduced)) }
      "=" _ "by" { \parent.\parent.Degree[n := degree].leftInverse x }
    };
