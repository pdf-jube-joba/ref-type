\import \parent.\parent.\parent.Fibre[p := p, vertices := (s).vertices] \as Fibre;
\import \root.Complex[d := d].On[K := K].Realization[].Stars[].Intersection[n := p, sigma := (s).vertices] \as Intersection;
\import singular_cohomology.Chains[A := Intersection.Carrier, source := Intersection.topology] \as Local;
\import singular_cohomology.Calculations[A := Intersection.Carrier, source := Intersection.topology].ReducedContractible[]
  .Native[contraction := Intersection.Contraction[].contraction] \as Contraction;
\import \parent.\parent.\parent.Bicomplex[] \as Bicomplex;
\definition simplex: _ := Fibre.Lift[q := N.Nat^::succ q, sigma := (s).singular, contained := common p (N.Nat^::succ q) s].simplex;
\definition x: Local.Carrier (N.Nat^::succ q) := Local.generator (N.Nat^::succ q) simplex;
\definition encoded: (Fibre.map).apply (N.Nat^::succ q) x = generator p (N.Nat^::succ q) s :=
  trans!{{Carrier p (N.Nat^::succ q)}} _ _ _ (Fibre.onGenerator (N.Nat^::succ q) simplex)
    (congr!{{Generator p (N.Nat^::succ q)} {Carrier p (N.Nat^::succ q)}} (generator p (N.Nat^::succ q)) _ _
      (dataExt p (N.Nat^::succ q) (Fibre.encode (N.Nat^::succ q) simplex) s (\refl((s).vertices))
        (Fibre.Lift[q := N.Nat^::succ q, sigma := (s).singular, contained := common p (N.Nat^::succ q) s].encoded)));
\definition first: (Bicomplex.vertical p (N.Nat^::succ q)).apply ((homotopy (N.Nat^::succ q)).apply (generator p (N.Nat^::succ q) s)) =
  (Fibre.map).apply (N.Nat^::succ q) ((Local.boundary (N.Nat^::succ q)).apply ((Contraction.homotopy).apply (N.Nat^::succ q) x)) :=
  trans!{{Carrier p (N.Nat^::succ q)}} _ _ _
    (congr!{{Carrier p (N.Nat^::succ (N.Nat^::succ q))} {Carrier p (N.Nat^::succ q)}} ((Bicomplex.vertical p (N.Nat^::succ q)).apply) _ _
      (\parent.\parent.Degree[q := N.Nat^::succ q].onGenerator s))
    ((Fibre.map).commutes (N.Nat^::succ q) ((Contraction.homotopy).apply (N.Nat^::succ q) x));
\definition second: (homotopy q).apply ((Bicomplex.vertical p q).apply (generator p (N.Nat^::succ q) s)) =
  (Fibre.map).apply (N.Nat^::succ q) ((Contraction.homotopy).apply q ((Local.boundary q).apply x)) :=
  trans!{{Carrier p (N.Nat^::succ q)}} _ _ _
    (congr!{{Carrier p (N.Nat^::succ q)} {Carrier p (N.Nat^::succ q)}}
      (\fun (z: Carrier p (N.Nat^::succ q)) => (homotopy q).apply ((Bicomplex.vertical p q).apply z)) _ _ (sym!{{Carrier p (N.Nat^::succ q)}} _ _ encoded))
    (trans!{{Carrier p (N.Nat^::succ q)}} _ _ _
      (congr!{{Carrier p q} {Carrier p (N.Nat^::succ q)}} ((homotopy q).apply) _ _ ((Fibre.map).commutes q x))
      (\parent.\parent.Degree[q := q].Fibre[vertices := (s).vertices].law ((Local.boundary q).apply x)));
\import Modules.Laws[V := Local.Carrier (N.Nat^::succ q), space := Local.space (N.Nat^::succ q)] \as LocalValues;
\import algebra.Group[].Of[Carrier := Local.Carrier (N.Nat^::succ q), group := LocalValues.additive] \as LocalGroup;
\definition localEquation:
  (Local.space (N.Nat^::succ q)).add
    ((Local.boundary (N.Nat^::succ q)).apply ((Contraction.homotopy).apply (N.Nat^::succ q) x))
    ((Contraction.homotopy).apply q ((Local.boundary q).apply x)) = x :=
  trans!{{Local.Carrier (N.Nat^::succ q)}} _ _ _ (sym!{{Local.Carrier (N.Nat^::succ q)}} _ _ ((Contraction.homotopy).successorEquation q x))
    (trans!{{Local.Carrier (N.Nat^::succ q)}} _ _ _
      (congr!{{Local.Carrier (N.Nat^::succ q)} {Local.Carrier (N.Nat^::succ q)}} (LocalGroup.difference x) _ _ (Contraction.Positive[n := q].law x))
      (trans!{{Local.Carrier (N.Nat^::succ q)}} _ _ _
        (congr!{{Local.Carrier (N.Nat^::succ q)} {Local.Carrier (N.Nat^::succ q)}} (LocalValues.add x) _ _ LocalGroup.negZero)
        (LocalGroup.zeroRight x)));
\use Equality.congr2;
\definition law:
  (space p (N.Nat^::succ q)).add
    ((Bicomplex.vertical p (N.Nat^::succ q)).apply ((homotopy (N.Nat^::succ q)).apply (generator p (N.Nat^::succ q) s)))
    ((homotopy q).apply ((Bicomplex.vertical p q).apply (generator p (N.Nat^::succ q) s))) = generator p (N.Nat^::succ q) s :=
  trans!{{Carrier p (N.Nat^::succ q)}} _ _ _
    (congr2!{{Carrier p (N.Nat^::succ q)} {Carrier p (N.Nat^::succ q)} {Carrier p (N.Nat^::succ q)}} ((space p (N.Nat^::succ q)).add) _ _ _ _ first second)
    (trans!{{Carrier p (N.Nat^::succ q)}} _ _ _
      (sym!{{Carrier p (N.Nat^::succ q)}} _ _ ((Fibre.map).addition (N.Nat^::succ q)
        ((Local.boundary (N.Nat^::succ q)).apply ((Contraction.homotopy).apply (N.Nat^::succ q) x))
        ((Contraction.homotopy).apply q ((Local.boundary q).apply x))))
      (trans!{{Carrier p (N.Nat^::succ q)}} _ _ _
        (congr!{{Local.Carrier (N.Nat^::succ q)} {Carrier p (N.Nat^::succ q)}} ((Fibre.map).apply (N.Nat^::succ q)) _ _ localEquation) encoded));
