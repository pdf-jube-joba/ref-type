\use std.Logic[].Equality[].eq_reason_in;
\definition degree: N.Nat^ := N.Nat^::zero;
\import \parent.\parent.Based[n := degree] \as Based;
\import Whole.Augmentation[] \as Augmentation;
\import Modules.Hom[V := Whole.Carrier degree, W := I.Int^, source := Whole.space degree, target := Modules.scalarModule]
  .Composition[U := Total.Carrier degree, domain := Total.space degree] \as Compose;
\import Native.Map[C := Total.complex, D := Whole.complex].At[n := degree] \as Degree;
\definition firstMap: _ := Compose.compose Augmentation.map (Degree.linear first);
\definition secondMap: _ := Compose.compose Augmentation.map (Degree.linear second);
\definition atPoint: \forall (s: Generator degree degree) ->
  (firstMap).apply ((Total.Degree[n := degree].Component[i := SmallComparison.point degree].injection).apply (generator degree degree s)) =
  (secondMap).apply ((Total.Degree[n := degree].Component[i := SmallComparison.point degree].injection).apply (generator degree degree s)) :=
  \fun (s: Generator degree degree) => eq_reason_in!{I.Int^ _
    "=" _ "by" { congr!{{Whole.Carrier degree} {I.Int^}} ((Augmentation.map).apply) _ _ (\parent.Factors[n := degree].FirstPoint[s := s].actual) }
    "=" _ "by" { Augmentation.onGenerator (s).singular }
    "=" _ "by" { sym!{I.Int^} _ _ (trans!{I.Int^} _ _ _
        (congr!{{Whole.Carrier degree} {I.Int^}} ((Augmentation.map).apply) _ _ (\parent.Factors[n := degree].SecondPoint[s := s].actual))
        (Augmentation.onGenerator (Realization.simplex degree (s).vertices))) }
  };
\definition zeroIndex[i: Doubles.Index degree]: i = SmallComparison.point degree :=
  SmallComparison.zeroIndex degree i (Bounds.leZeroEq (i).first (Doubles.firstBound degree i));
\definition onIndex: \forall (i: Doubles.Index degree)(s: Generator (i).first (i).second) ->
  (firstMap).apply ((Total.Degree[n := degree].Component[i := i].injection).apply (generator (i).first (i).second s)) =
  (secondMap).apply ((Total.Degree[n := degree].Component[i := i].injection).apply (generator (i).first (i).second s)) :=
  \fun (i: Doubles.Index degree) => \idelim SmallComparison.point degree = i \with j: Doubles.Index degree =>
    \forall (s: Generator (j).first (j).second) ->
      (firstMap).apply ((Total.Degree[n := degree].Component[i := j].injection).apply (generator (j).first (j).second s)) =
      (secondMap).apply ((Total.Degree[n := degree].Component[i := j].injection).apply (generator (j).first (j).second s)) \by {
        base: atPoint, equality: sym!{{Doubles.Index degree}} _ _ (zeroIndex i)
      };
\import Based.To[W := I.Int^, target := Modules.scalarModule] \as Free;
\definition equality: firstMap = secondMap := Free.ext firstMap secondMap (\fun (c: Based.Cell) => onIndex (c).index (c).simplex);
\import Modules.Hom[V := Total.Carrier degree, W := I.Int^, source := Total.space degree, target := Modules.scalarModule] \as Maps;
\definition law: \forall (x: Total.Carrier degree) -> (Augmentation.map).apply ((first).apply degree x) = (Augmentation.map).apply ((second).apply degree x) :=
  \fun (x: Total.Carrier degree) => congr!{{Maps.Map} {I.Int^}} (\fun (f: Maps.Map) => (f).apply x) firstMap secondMap equality;
\import Modules.Hom[V := Whole.Carrier degree, W := I.Int^, source := Whole.space degree, target := Modules.scalarModule] \as Augmentations;
\import algebra.Group[].Of[Carrier := I.Int^, group := Modules.scalarGroup] \as Group;
\definition differenceZero: \forall (x: Total.Carrier degree) -> (Augmentation.map).apply ((difference).apply degree x) = (Modules.scalarModule).zero :=
  \fun (x: Total.Carrier degree) => eq_reason_in!{I.Int^ _
    "=" _ "by" { Augmentations.differencePreserved Augmentation.map ((first).apply degree x) ((second).apply degree x) }
    "=" _ "by" { congr!{I.Int^ I.Int^} (\fun (y: I.Int^) => Group.difference y ((Augmentation.map).apply ((second).apply degree x))) _ _ (law x) }
    "=" _ "by" { Group.inverseRight ((Augmentation.map).apply ((second).apply degree x)) }
  };
