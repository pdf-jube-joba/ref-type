\import Chains.Map[C := TargetTotal.complex, D := Small.complex].At[n := n] \as Projection;
\module Component(i: Doubles.Index n) {
  \import TargetTotal.Degree[n := n].Component[i := i] \as Component;
  \import Modules.Hom[V := Target.family.Carrier (i).first (i).second, W := TargetTotal.Carrier n, source := Target.family.space (i).first (i).second, target := TargetTotal.space n] \as Injection;
  \definition zero: \forall (x: Carrier (i).first (i).second) -> (mapping (i).first (i).second).apply x = (Target.family.space (i).first (i).second).zero ->
    (comparison).apply n ((Total.Degree[n := n].Component[i := i].injection).apply x) = (Small.space n).zero :=
    \fun (x: Carrier (i).first (i).second)(killed: (mapping (i).first (i).second).apply x = (Target.family.space (i).first (i).second).zero) =>
      trans!{{Small.Carrier n}} _ _ _
        (congr!{{TargetTotal.Carrier n} {Small.Carrier n}} ((projection).apply n) _ _ (Induced.Degree[n := n].onInjection i x))
        (trans!{{Small.Carrier n}} _ _ _
          (congr!{{TargetTotal.Carrier n} {Small.Carrier n}} ((projection).apply n) _ _
            (trans!{{TargetTotal.Carrier n}} _ _ _ (congr!{{Target.family.Carrier (i).first (i).second} {TargetTotal.Carrier n}} ((Component.injection).apply) _ _ killed)
              (Injection.zeroPreserved Component.injection)))
          (Projection.zeroPreserved projection));
}
\definition atPoint: \forall (s: Generator N.Nat^::zero n) ->
  (comparison).apply n ((Total.Degree[n := n].Component[i := Concentrated.point n].injection).apply (generator N.Nat^::zero n s)) =
    Small.generator n (Augmentation.label n s) :=
  \fun (s: Generator N.Nat^::zero n) => trans!{{Small.Carrier n}} _ _ _
    (congr!{{TargetTotal.Carrier n} {Small.Carrier n}} ((projection).apply n) _ _
      (Induced.Degree[n := n].onInjection (Concentrated.point n) (generator N.Nat^::zero n s)))
    (trans!{{Small.Carrier n}} _ _ _
      (Concentrated.Degree[n := n].rightInverse ((mapping N.Nat^::zero n).apply (generator N.Nat^::zero n s)))
      (Augmentation.onGenerator n s));
\definition other: \forall (i: Doubles.Index n) -> Logic.Not (i = Concentrated.point n) -> \forall (x: Carrier (i).first (i).second) ->
  (comparison).apply n ((Total.Degree[n := n].Component[i := i].injection).apply x) = (Small.space n).zero :=
  \fun (i: Doubles.Index n)(different: Logic.Not (i = Concentrated.point n))(x: Carrier (i).first (i).second) => Component[i := i].zero x
    (Concentrated.positive vanishes (i).first (i).second (\fun (zero: (i).first = N.Nat^::zero) => different (Concentrated.zeroIndex n i zero)) _);
