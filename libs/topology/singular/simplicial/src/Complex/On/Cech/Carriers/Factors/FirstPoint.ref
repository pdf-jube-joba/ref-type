\import \root.Complex[d := d].On[K := K].Realization[].SimplicialCarrier[n := n, sigma := (s).singular] \as SimplexCarrier;
\import \root.Complex[d := d].On[K := SimplexCarrier.complex].Realization[] \as LocalRealization;
\import singular_cohomology.Chains[A := LocalRealization.Carrier, source := LocalRealization.topology] \as Local;
\import singular_cohomology.Maps[A := LocalRealization.Carrier, B := Realization.Carrier, source := LocalRealization.topology, target := Realization.topology] \as Inclusion;
\import \parent.\parent.Cell[n := n, c := Based.Cell { index := SmallComparison.point n, simplex := s }] \as Cell;
\import Cell.Degree[z := degree] \as CarrierImage;
\definition value: Local.Carrier n := Local.generator n SimplexCarrier.simplex;
\definition simplexEquation: Inclusion.postcompose n SimplexCarrier.inclusion SimplexCarrier.continuous SimplexCarrier.simplex = (s).singular :=
  Simplices.ext n (Inclusion.postcompose n SimplexCarrier.inclusion SimplexCarrier.continuous SimplexCarrier.simplex) (s).singular
    (\fun (x: Geometric.Carrier n) => \refl((s).singular x));
\definition included: (Cell.map).apply degree value = Whole.generator n (s).singular :=
  trans!{{Whole.Carrier n}} _ _ _ (Inclusion.At[n := n].onGenerator SimplexCarrier.inclusion SimplexCarrier.continuous SimplexCarrier.simplex)
    (congr!{{Simplices.Carrier n} {Whole.Carrier n}} (Whole.generator n) _ _ simplexEquation);
\import singular_subdivision.Small[A := Realization.Carrier, source := Realization.topology, family := Stars.family].At[n := n] \as SmallDegree;
\definition actual: (Actual.first).apply n ((Total.Degree[n := n].Component[i := SmallComparison.point n].injection).apply (generator N.Nat^::zero n s)) = Whole.generator n (s).singular :=
  trans!{{Whole.Carrier n}} _ _ _
    (congr!{{Small.Carrier n} {Whole.Carrier n}} ((Small.inclusion).apply n) _ _ (SmallComparison.Generators[n := n].atPoint s))
    (SmallDegree.onGenerator (\root.Complex[d := d].On[K := K].Cech[].SmallAugmentation[].label n s));
\definition carried: CarrierImage.Member ((Actual.first).apply n ((Total.Degree[n := n].Component[i := SmallComparison.point n].injection).apply (generator N.Nat^::zero n s))) :=
  CarrierImage.introduce _ value (trans!{{Whole.Carrier n}} _ _ _ included (sym!{{Whole.Carrier n}} _ _ actual));
