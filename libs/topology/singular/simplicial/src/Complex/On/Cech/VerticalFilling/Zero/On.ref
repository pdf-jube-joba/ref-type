\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.\parent.Fibre[p := p, vertices := (s).vertices] \as Fibre;
\import \root.Complex[d := d].On[K := K].Realization[].Stars[].Intersection[n := p, sigma := (s).vertices] \as Intersection;
\import singular_cohomology.Chains[A := Intersection.Carrier, source := Intersection.topology] \as Local;
\import singular_cohomology.Simplices[A := Intersection.Carrier, source := Intersection.topology] \as LocalSimplices;
\import singular_cohomology.Calculations[A := Intersection.Carrier, source := Intersection.topology].ReducedContractible[]
  .Native[contraction := Intersection.Contraction[].contraction] \as Contraction;
\definition simplex: _ := Fibre.Lift[q := degree, sigma := (s).singular, contained := common p degree s].simplex;
\definition x: Local.Carrier degree := Local.generator degree simplex;
\definition encoded: (Fibre.map).apply degree x = generator p degree s :=
  trans!{{Carrier p degree}} _ _ _ (Fibre.onGenerator degree simplex)
    (congr!{{Generator p degree} {Carrier p degree}} (generator p degree) _ _
      (dataExt p degree (Fibre.encode degree simplex) s (\refl((s).vertices))
        (Fibre.Lift[q := degree, sigma := (s).singular, contained := common p degree s].encoded)));
\definition point: Carrier p degree := generator p degree (Section.At[vertices := (s).vertices].simplex);
\definition encodedProjection: (Fibre.map).apply degree ((Contraction.projection).apply degree x) = point :=
  trans!{{Carrier p degree}} _ _ _
    (congr!{{Local.Carrier degree} {Carrier p degree}} ((Fibre.map).apply degree) _ _ (Fibre.Zero[].onGenerator simplex))
    (Fibre.onGenerator degree (LocalSimplices.At[n := degree].constant Intersection.point));
\definition projected: (projector).apply (generator p degree s) = point :=
  trans!{{Carrier p degree}} _ _ _
    (congr!{{Nerve.Carrier p} {Carrier p degree}} ((Section.section).apply) _ _ (Augmentation.onGenerator p s))
    (Section.sectionOnGenerator (s).vertices);
\import Modules.Hom[V := Local.Carrier degree, W := Carrier p degree, source := Local.space degree, target := space p degree] \as Inclusion;
\import Modules.Laws[V := Carrier p degree, space := space p degree] \as Vector;
\import algebra.Group[].Of[Carrier := Carrier p degree, group := Vector.additive] \as Group;
\definition law:
  (Bicomplex.vertical p degree).apply ((homotopy degree).apply (generator p degree s)) = Group.difference (generator p degree s) ((projector).apply (generator p degree s)) :=
  eq_reason_in!{{Carrier p degree} _
    "=" _ "by" { congr!{{Carrier p (N.Nat^::succ degree)} {Carrier p degree}} ((Bicomplex.vertical p degree).apply) _ _ (\parent.\parent.Degree[q := degree].onGenerator s) }
    "=" _ "by" { (Fibre.map).commutes degree ((Contraction.homotopy).apply degree x) }
    "=" _ "by" { congr!{{Local.Carrier degree} {Carrier p degree}} ((Fibre.map).apply degree) _ _ (sym!{{Local.Carrier degree}} _ _ ((Contraction.homotopy).zeroEquation x)) }
    "=" _ "by" { Inclusion.differencePreserved
            (double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].Map[C := Local.complex, D := Native.complex].At[n := degree].linear Fibre.map)
            x ((Contraction.projection).apply degree x) }
    "=" _ "by" { congr!{{Carrier p degree} {Carrier p degree} {Carrier p degree}} Group.difference _ _ _ _ encoded encodedProjection }
    "=" _ "by" { congr!{{Carrier p degree} {Carrier p degree}} (Group.difference (generator p degree s)) _ _ (sym!{{Carrier p degree}} _ _ projected) }
  };
