\use std.Logic[].Equality[].eq_reason_in;
\import Chains.Map[C := TargetTotal.complex, D := Nerve.complex].At[n := n] \as Projection;
\module Component(i: Doubles.Index n) {
  \import TargetTotal.Degree[n := n].Component[i := i] \as Component;
  \import Modules.Hom[V := Target.family.Carrier (i).first (i).second, W := TargetTotal.Carrier n, source := Target.family.space (i).first (i).second, target := TargetTotal.space n] \as Injection;
  \definition zero: \forall (x: Carrier (i).first (i).second) -> (mapping (i).first (i).second).apply x = (Target.family.space (i).first (i).second).zero ->
    (comparison).apply n ((Total.Degree[n := n].Component[i := i].injection).apply x) = (Nerve.space n).zero :=
    \fun (x: Carrier (i).first (i).second)(killed: (mapping (i).first (i).second).apply x = (Target.family.space (i).first (i).second).zero) =>
      eq_reason_in!{{Nerve.Carrier n} _
        "=" _ "by" { congr!{{TargetTotal.Carrier n} {Nerve.Carrier n}} ((projection).apply n) _ _ (Induced.Degree[n := n].onInjection i x) }
        "=" _ "by" { congr!{{TargetTotal.Carrier n} {Nerve.Carrier n}} ((projection).apply n) _ _
            (trans!{{TargetTotal.Carrier n}} _ _ _ (congr!{{Target.family.Carrier (i).first (i).second} {TargetTotal.Carrier n}} ((Component.injection).apply) _ _ killed)
              (Injection.zeroPreserved Component.injection)) }
        "=" _ "by" { Projection.zeroPreserved projection }
      };
}
\definition atPoint: \forall (s: Generator n N.Nat^::zero) ->
  (comparison).apply n ((Total.Degree[n := n].Component[i := Concentrated.point n].injection).apply (generator n N.Nat^::zero s)) = Nerve.generator n (s).vertices :=
  \fun (s: Generator n N.Nat^::zero) => eq_reason_in!{{Nerve.Carrier n} _
    "=" _ "by" { congr!{{TargetTotal.Carrier n} {Nerve.Carrier n}} ((projection).apply n) _ _
      (Induced.Degree[n := n].onInjection (Concentrated.point n) (generator n N.Nat^::zero s)) }
    "=" _ "by" { Concentrated.Degree[n := n].rightInverse ((mapping n N.Nat^::zero).apply (generator n N.Nat^::zero s)) }
    "=" _ "by" { Augmentation.onGenerator n s }
  };
\definition other: \forall (i: Doubles.Index n) -> Logic.Not (i = Concentrated.point n) -> \forall (x: Carrier (i).first (i).second) ->
  (comparison).apply n ((Total.Degree[n := n].Component[i := i].injection).apply x) = (Nerve.space n).zero :=
  \fun (i: Doubles.Index n)(different: Logic.Not (i = Concentrated.point n))(x: Carrier (i).first (i).second) => Component[i := i].zero x
    (Concentrated.positive Target.vanishes (i).second (i).first (\fun (zero: (i).second = N.Nat^::zero) => different (Concentrated.zeroIndex n i zero)) _);
