\import \root.Complex[d := d].On[K := K].Realization[].SimplicialCarrier[n := q, sigma := sigma] \as SimplexCarrier;
\import \root.Complex[d := d].On[K := SimplexCarrier.complex].Realization[] \as LocalRealization;
\import singular_cohomology.Chains[A := LocalRealization.Carrier, source := LocalRealization.topology].Reduced[] \as Local;
\import SimplexCarrier.Chains[].Reduced[] \as Inclusion;
\import Modules.Of[V := Global.Carrier z, space := Global.space z].Submodule[] \as Submodules;
\import Submodules.Image[U := Local.Carrier z, source := Local.space z] \as Images;
\definition linear: _ := Complexes.Map[C := Local.complex, D := Global.complex].At[k := z].linear Inclusion.map;
\definition image: Submodules.Submodule := Images.image linear;
\definition Member[y: Global.Carrier z]: \Prop := Submodules.Member image y;
