\use std.Logic[].Equality[].eq_reason_in;
\import Complexes.Map[C := Native.complex, D := CoproductNative.complex].At[n := n] \as LowerForward;
\definition closed: \forall (x: Native.Carrier (N.Nat^::succ n)) -> (Native.boundary n).apply x = (Native.space n).zero ->
  (Coproduct.boundary n).apply ((forwardMap).apply (N.Nat^::succ n) x) = (Coproduct.space n).zero :=
  \fun (x: Native.Carrier (N.Nat^::succ n))(cycle: (Native.boundary n).apply x = (Native.space n).zero) =>
    eq_reason_in!{{Coproduct.Carrier n} _
      "=" _ "by" { (forwardMap).commutes n x }
      "=" _ "by" { congr!{{Native.Carrier n} {Coproduct.Carrier n}} ((forwardMap).apply n) _ _ cycle }
      "=" _ "by" { LowerForward.zeroPreserved forwardMap }
    };
\definition filler[x: Native.Carrier (N.Nat^::succ n)]: Native.Carrier (N.Nat^::succ (N.Nat^::succ n)) :=
  (backwardMap).apply (N.Nat^::succ (N.Nat^::succ n)) ((Contracted.homotopy (N.Nat^::succ n)).apply ((forwardMap).apply (N.Nat^::succ n) x));
\definition boundary: \forall (x: Native.Carrier (N.Nat^::succ n)) -> (Native.boundary n).apply x = (Native.space n).zero ->
  (Native.boundary (N.Nat^::succ n)).apply (filler x) = x :=
  \fun (x: Native.Carrier (N.Nat^::succ n))(cycle: (Native.boundary n).apply x = (Native.space n).zero) =>
    eq_reason_in!{{Native.Carrier (N.Nat^::succ n)} _
      "=" _ "by" { (backwardMap).commutes (N.Nat^::succ n) ((Contracted.homotopy (N.Nat^::succ n)).apply ((forwardMap).apply (N.Nat^::succ n) x)) }
      "=" _ "by" { congr!{{Coproduct.Carrier (N.Nat^::succ n)} {Native.Carrier (N.Nat^::succ n)}} ((backwardMap).apply (N.Nat^::succ n)) _ _
          (Contracted.Positive[n := n].cycle ((forwardMap).apply (N.Nat^::succ n) x) (closed x cycle)) }
      "=" _ "by" { \parent.\parent.Degree[n := N.Nat^::succ n].leftInverse x }
    };
