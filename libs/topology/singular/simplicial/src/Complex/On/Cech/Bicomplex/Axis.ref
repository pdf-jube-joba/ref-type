\import \parent.\parent.Horizontal[q := q] \as Horizontal;
\import \parent.\parent.Vertical[p := p] \as Vertical;
\import singular_cohomology.SimplicialChains[].On[X := Horizontal.object] \as HorizontalChains;
\import singular_cohomology.SimplicialChains[].On[X := Vertical.object] \as VerticalChains;
\definition horizontal: Modules.Hom[V := Carrier (N.Nat^::succ p) q, W := Carrier p q,
  source := space (N.Nat^::succ p) q, target := space p q].Map := HorizontalChains.boundary p;
\definition vertical: Modules.Hom[V := Carrier p (N.Nat^::succ q), W := Carrier p q,
  source := space p (N.Nat^::succ q), target := space p q].Map := VerticalChains.boundary q;
\definition horizontalZero: \forall (x: Carrier (N.Nat^::succ (N.Nat^::succ p)) q) ->
  (HorizontalChains.boundary p).apply ((HorizontalChains.boundary (N.Nat^::succ p)).apply x) = (space p q).zero :=
  HorizontalChains.SquareZero[n := p].all;
\definition verticalZero: \forall (x: Carrier p (N.Nat^::succ (N.Nat^::succ q))) ->
  (VerticalChains.boundary q).apply ((VerticalChains.boundary (N.Nat^::succ q)).apply x) = (space p q).zero :=
  VerticalChains.SquareZero[n := q].all;
