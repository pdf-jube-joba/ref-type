\import \parent.\parent.\parent.\parent.Singular[q := N.Nat^::succ q, sigma := (s).singular, z := z] \as CarrierImage;
\module Face(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ q))) {
  \import \root.Complex[d := d].On[K := K].Realization[].SimplicialCarrier[n := N.Nat^::succ q, sigma := (s).singular]
    .Restriction[m := q, f := Geometric.face q i, continuous := Geometric.Faces[n := q].continuous i].Reduced[].Degree[z := z] \as Restriction;
  \definition contained: CarrierImage.Member ((linear).apply (generator p q (Cech.vertical p q i s))) :=
    Restriction.included _ (member (Based.Cell { index := index, simplex := Cech.vertical p q i s }));
}
\definition unsigned: CarrierImage.Member ((linear).apply ((Bicomplex.vertical p q).apply (generator p (N.Nat^::succ q) s))) :=
  \idelim Sum.sum (N.Nat^::succ (N.Nat^::succ q)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ q))) => (linear).apply (generator p q (Cech.vertical p q i s))) =
    (linear).apply ((Bicomplex.vertical p q).apply (generator p (N.Nat^::succ q) s)) \with y: Global.Carrier z => CarrierImage.Member y \by {
      base: \parent.\parent.\parent.\parent.Sums[z := z].alternating (N.Nat^::succ (N.Nat^::succ q)) CarrierImage.image _
        (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ q))) => Face[i := i].contained),
      equality: sym!{{Global.Carrier z}} _ _ (trans!{{Global.Carrier z}} _ _ _
        (congr!{{Carrier p q} {Global.Carrier z}} ((linear).apply) _ _ (Boundary.onGenerator s))
        (Mapping.law linear (N.Nat^::succ (N.Nat^::succ q)) _))
    };
\definition law: CarrierImage.Member ((f).apply ((Step.vertical (N.Nat^::succ q) p).apply (generator p (N.Nat^::succ q) s))) :=
  \idelim (GlobalSign.map p).apply ((linear).apply ((Bicomplex.vertical p q).apply (generator p (N.Nat^::succ q) s))) =
    (f).apply ((Step.vertical (N.Nat^::succ q) p).apply (generator p (N.Nat^::succ q) s)) \with y: Global.Carrier z => CarrierImage.Member y \by {
      base: \parent.\parent.\parent.\parent.Sums[z := z].signed p CarrierImage.image _ unsigned,
      equality: sym!{{Global.Carrier z}} _ _ (Sign.naturality linear p ((Bicomplex.vertical p q).apply (generator p (N.Nat^::succ q) s)))
    };
