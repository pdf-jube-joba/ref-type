\import Fin.Tuples[A := Vertex] \as Tuples;
\structure Laws: \Prop := {
  vertex: \In[\Pow Vertex] K.faces (Image N.Nat^::zero (\fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => a)),
  extension: \forall (n: N.Nat^)(vertices: Tuple n) -> \In[\Pow Vertex] K.faces (Image n vertices) ->
    \In[\Pow Vertex] K.faces (Image (N.Nat^::succ n) (Tuples.extend (N.Nat^::succ n) a vertices)),
};
\module With(cone: Laws);
