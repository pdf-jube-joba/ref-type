\import std.Set[].FiniteSubset[A := Tuple n] \as Finite;
\import Finite.Enumeration[] \as Enumerations;
\import std.Data[].List[] \as Lists;
\import Fin.FromList[A := Tuple n] \as FromList;
\import \root.ListIndex[A := Tuple n] \as Index;
\definition simplices: \Pow (Tuple n) := { vertices: Tuple n \where Admissible[n, vertices] };
\definition finite: Finite.FiniteSubset := \into[\Pow (Tuple n)](simplices, Finite.FiniteSubsetSet) \by { \parent.\parent.Finiteness[n := n].finite };
\module On(xs: Enumerations.DistinctEnumeration[simplices]);
\definition existence: \exists Enumeration n := \block {
  \takefrom xs: Enumerations.DistinctEnumeration[simplices] \by Enumerations.existsDistinctEnumeration finite \then
  \return \exact(On[xs := xs].enumeration, Enumeration n)
};
