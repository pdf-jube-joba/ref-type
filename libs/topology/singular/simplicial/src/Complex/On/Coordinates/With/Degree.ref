\use std.Logic[].Equality[].eq_reason_in;
\definition enumeration: Enumeration n := indexing n;
\import Modules.Free[Generators := Simplex n] \as Native;
\import Modules.Free[Generators := Fin.Fin (rank n)] \as Finite;
\import Modules.FiniteCoordinates[n := rank n] \as Coordinates;
\import Native.Reindex[TargetGenerators := Fin.Fin (rank n)] \as Forward;
\import Finite.Reindex[TargetGenerators := Simplex n] \as Backward;
\definition forward: Modules.Hom[V := Native.Carrier, W := Finite.Carrier, source := Native.space, target := Finite.space].Map := Forward.push (enumeration).index;
\definition backward: Modules.Hom[V := Finite.Carrier, W := Native.Carrier, source := Finite.space, target := Native.space].Map := Backward.push (enumeration).enumerate;
\import Modules.Hom[V := Finite.Carrier, W := Native.Carrier, source := Finite.space, target := Native.space].Composition[U := Native.Carrier, domain := Native.space] \as Left;
\import Modules.Hom[V := Native.Carrier, W := Finite.Carrier, source := Native.space, target := Finite.space].Composition[U := Finite.Carrier, domain := Finite.space] \as Right;
\import Modules.End[V := Native.Carrier, space := Native.space] \as NativeEnd;
\import Modules.End[V := Finite.Carrier, space := Finite.space] \as FiniteEnd;
\import Native.To[W := Native.Carrier, target := Native.space] \as NativeExt;
\import Finite.To[W := Finite.Carrier, target := Finite.space] \as FiniteExt;
\definition leftMap: Left.compose backward forward = NativeEnd.identity := NativeExt.ext _ _
  (\fun (sigma: Simplex n) => eq_reason_in!{Native.Carrier _
    "=" _ "by" { congr!{Finite.Carrier Native.Carrier} ((backward).apply) _ _ (Forward.onGenerator (enumeration).index sigma) }
    "=" _ "by" { Backward.onGenerator (enumeration).enumerate ((enumeration).index sigma) }
    "=" _ "by" { congr!{{Simplex n} Native.Carrier} Native.generator _ _ ((enumeration).enumerateIndex sigma) }
  });
\definition rightMap: Right.compose forward backward = FiniteEnd.identity := FiniteExt.ext _ _
  (\fun (i: Fin.Fin (rank n)) => eq_reason_in!{Finite.Carrier _
    "=" _ "by" { congr!{Native.Carrier Finite.Carrier} ((forward).apply) _ _ (Backward.onGenerator (enumeration).enumerate i) }
    "=" _ "by" { Forward.onGenerator (enumeration).index ((enumeration).enumerate i) }
    "=" _ "by" { congr!{{Fin.Fin (rank n)} Finite.Carrier} Finite.generator _ _ ((enumeration).indexEnumerate i) }
  });
\import Modules.Isomorphism[V := Native.Carrier, W := Finite.Carrier, source := Native.space, target := Finite.space] \as Iso;
\import Modules.Hom[V := Native.Carrier, W := Native.Carrier, source := Native.space, target := Native.space] \as NativeMaps;
\import Modules.Hom[V := Finite.Carrier, W := Finite.Carrier, source := Finite.space, target := Finite.space] \as FiniteMaps;
\definition freeIsomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := \fun (x: Native.Carrier) => congr!{NativeMaps.Map Native.Carrier} (\fun (f: NativeMaps.Map) => (f).apply x) _ _ leftMap,
  rightInverse := \fun (x: Finite.Carrier) => congr!{FiniteMaps.Map Finite.Carrier} (\fun (f: FiniteMaps.Map) => (f).apply x) _ _ rightMap,
};
\import Iso.Composition[U := Coordinates.Carrier, final := Coordinates.space] \as Compose;
\definition isomorphism: Modules.Isomorphism[V := Chains.Carrier n, W := Coordinates.Carrier, source := Chains.space n, target := Coordinates.space].Isomorphism :=
  Compose.compose (Coordinates.Free[].isomorphism) freeIsomorphism;
