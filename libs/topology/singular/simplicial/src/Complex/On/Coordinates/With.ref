\definition rank[n: N.Nat^]: N.Nat^ := (indexing n).rank;
\definition emptyRank: \forall (r: N.Nat^) -> (\forall (i: Fin.Fin r) -> Logic.False) -> r = N.Nat^::zero :=
  \induction (r: N.Nat^) \return (\forall (i: Fin.Fin r) -> Logic.False) -> r = N.Nat^::zero \with {
    | zero: \fun (empty: _) => \refl(N.Nat^::zero)
    | succ: \fun (r: N.Nat^)(previous: _)(empty: _) => Logic.falseElim _ (empty (Fin.zero r))
  };
\definition aboveDimension: \forall (n: N.Nat^) -> Bounds.Lt d n -> rank n = N.Nat^::zero :=
  \fun (n: N.Nat^)(large: Bounds.Lt d n) => emptyRank (rank n)
    (\fun (i: Fin.Fin (rank n)) => \parent.\parent.Finiteness[n := n].aboveDimension large ((indexing n).enumerate i));
\module Degree(n: N.Nat^);
\module Differential(n: N.Nat^);
\module Natural;
\module Bounded;
\module Comparison;
