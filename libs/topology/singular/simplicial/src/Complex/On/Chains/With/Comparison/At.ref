\import CochainComplexes.At[C := Whole.complex, k := n] \as Source;
\import CochainComplexes.At[C := cochainComplex, k := n] \as Target;
\import CochainComplexes.Map[C := Whole.complex, D := cochainComplex].At[k := n] \as Restriction;
\definition induced: Modules.Hom[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Map :=
  Restriction.induced restriction;
\module With(e: AffineEquivalence);
\definition injective: \forall (x, y: Source.Cohomology) -> (induced).apply x = (induced).apply y -> x = y := \block {
  \fun (x, y: Source.Cohomology)(equal: (induced).apply x = (induced).apply y) \then
  \takefrom e: AffineEquivalence \by ChainComparison.existence \then
  \return trans!{{Source.Cohomology}} _ _ _ (sym!{{Source.Cohomology}} _ _ ((With[e := e].isomorphism).leftInverse x))
    (trans!{{Source.Cohomology}} _ _ _
      (congr!{{Target.Cohomology} {Source.Cohomology}} (((With[e := e].isomorphism).backward).apply) _ _ equal)
      ((With[e := e].isomorphism).leftInverse y))
};
\definition onto: \forall (y: Target.Cohomology) -> \exists ( x: Source.Cohomology \where (induced).apply x = y ) := \block {
  \fun (y: Target.Cohomology) \then
  \takefrom e: AffineEquivalence \by ChainComparison.existence \then
  \return Logic.existsIntro[Source.Cohomology, { x: Source.Cohomology \where (induced).apply x = y }]
    (((With[e := e].isomorphism).backward).apply y) ((With[e := e].isomorphism).rightInverse y)
};
\import Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].OfBijective[f := induced] \as Inverse;
\definition isomorphism: Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Isomorphism :=
  Inverse.isomorphism injective onto;
