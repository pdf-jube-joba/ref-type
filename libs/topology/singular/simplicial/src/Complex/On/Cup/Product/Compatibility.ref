\import \root.Complex[d := d].On[K := K].Cup[R := R, ring := ring].Product[p := p, q := q] \as Product;
\import Simplices.Cut[p := p, q := q] \as SingularCut;
\import Singular.Cup[p := p, q := q] \as Whole;
\use Equality.eq_reason;
\use Equality.congr2;
\definition onSimplex: \forall (alpha: Singular.Carrier p)(beta: Singular.Carrier q)(sigma: Simplex total) ->
  ((restriction).apply total (Whole.apply alpha beta)).apply (Chains.generator total sigma) =
    (apply ((restriction).apply p alpha) ((restriction).apply q beta)).apply (Chains.generator total sigma) :=
  \fun (alpha: Singular.Carrier p)(beta: Singular.Carrier q)(sigma: Simplex total) => eq_reason!{
    {((restriction).apply total (Whole.apply alpha beta)).apply (Chains.generator total sigma)}
    "=" {(Whole.apply alpha beta).apply (SingularChains.generator total (Realization.simplex total sigma))}
    "by" {\parent.\parent.At[n := total].restrictOnGenerator (Whole.apply alpha beta) sigma}
    "=" {(baseRing).mul
      ((alpha).apply (SingularChains.generator p (SingularCut.front (Realization.simplex total sigma))))
      ((beta).apply (SingularChains.generator q (SingularCut.back (Realization.simplex total sigma))))}
    "by" {Whole.onSimplex alpha beta (Realization.simplex total sigma)}
    "=" {(baseRing).mul
      ((alpha).apply (SingularChains.generator p (Realization.simplex p (Cut.front sigma))))
      ((beta).apply (SingularChains.generator q (Realization.simplex q (Cut.back sigma))))}
    "by" {congr2!{R R R} ((baseRing).mul) _ _ _ _
      (congr!{{Simplices.Carrier p} R} (\fun (s: Simplices.Carrier p) => (alpha).apply (SingularChains.generator p s)) _ _ (Cut.frontComparison sigma))
      (congr!{{Simplices.Carrier q} R} (\fun (s: Simplices.Carrier q) => (beta).apply (SingularChains.generator q s)) _ _ (Cut.backComparison sigma))}
    "=" {(baseRing).mul
      (((restriction).apply p alpha).apply (Chains.generator p (Cut.front sigma)))
      (((restriction).apply q beta).apply (Chains.generator q (Cut.back sigma)))}
    "by" {congr2!{R R R} ((baseRing).mul) _ _ _ _
      (sym!{R} _ _ (\parent.\parent.At[n := p].restrictOnGenerator alpha (Cut.front sigma)))
      (sym!{R} _ _ (\parent.\parent.At[n := q].restrictOnGenerator beta (Cut.back sigma)))}
    "=" {(apply ((restriction).apply p alpha) ((restriction).apply q beta)).apply (Chains.generator total sigma)}
    "by" {sym!{R} _ _ (Product.onSimplex ((restriction).apply p alpha) ((restriction).apply q beta) sigma)}
  };
\import Modules.Free[Generators := Simplex total].To[W := R, target := Singular.integerCoefficients.space] \as Free;
\definition law: \forall (alpha: Singular.Carrier p)(beta: Singular.Carrier q) ->
  (restriction).apply total (Whole.apply alpha beta) = apply ((restriction).apply p alpha) ((restriction).apply q beta) :=
  \fun (alpha: Singular.Carrier p)(beta: Singular.Carrier q) => Free.ext _ _ (onSimplex alpha beta);
