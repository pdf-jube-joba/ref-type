\import \root.Complex[d := d].On[K := K].Cup[R := R, ring := ring].Product[p := p, q := q] \as Formula;
\import \root.Complex[d := d].On[K := K].Cup[R := R, ring := ring].Cut[p := p, q := q] \as Cut;
\definition total: N.Nat^ := Formula.total;
\definition apply: Carrier p -> Carrier q -> Carrier total := Formula.apply;
\import Singular.Cup[p := p, q := q] \as WholeProduct;
\definition restrictionLaw: \forall (alpha: Singular.Carrier p)(beta: Singular.Carrier q) ->
  (restriction).apply total (WholeProduct.apply alpha beta) = apply ((restriction).apply p alpha) ((restriction).apply q beta) := Formula.Compatibility[].law;
\import \parent.Lift[n := p] \as LeftLift;
\import \parent.Lift[n := q] \as RightLift;
\definition lifted: \forall (alpha: Carrier p)(beta: Carrier q) ->
  (restriction).apply total (WholeProduct.apply (LeftLift.apply alpha) (RightLift.apply beta)) = apply alpha beta :=
  \fun (alpha: Carrier p)(beta: Carrier q) => trans!{{Carrier total}} _ _ _
    (restrictionLaw (LeftLift.apply alpha) (RightLift.apply beta))
    (congr!{{Carrier p} {Carrier q} {Carrier total}} apply _ _ _ _ (LeftLift.section alpha) (RightLift.section beta));
\definition onSimplex: \forall (alpha: Carrier p)(beta: Carrier q)(sigma: Simplex total) ->
  (apply alpha beta).apply (Chains.generator total sigma) =
    (baseRing).mul ((alpha).apply (Chains.generator p (Cut.front sigma))) ((beta).apply (Chains.generator q (Cut.back sigma))) := Formula.onSimplex;
\module Bilinear;
\module Closed;
\module Cohomology;
