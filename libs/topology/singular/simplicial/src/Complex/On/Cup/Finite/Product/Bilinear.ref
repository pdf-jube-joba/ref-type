\import Modules.Free[Generators := Simplex total].To[W := R, target := Singular.integerCoefficients.space] \as Free;
\definition ext: \forall (f, g: Carrier total) ->
  (\forall (sigma: Simplex total) -> (f).apply (Chains.generator total sigma) = (g).apply (Chains.generator total sigma)) -> f = g := Free.ext;
\import RingModules.Laws[V := R, space := RingModules.scalarModule] \as Scalars;
\definition leftZero: \forall (beta: Carrier q) -> apply (space p).zero beta = (space total).zero :=
  \fun (beta: Carrier q) => ext _ _ (\fun (sigma: Simplex total) => trans!{R} _ _ _ (onSimplex (space p).zero beta sigma)
    (Scalars.zeroScale ((beta).apply (Chains.generator q (Cut.back sigma)))));
\definition rightZero: \forall (alpha: Carrier p) -> apply alpha (space q).zero = (space total).zero :=
  \fun (alpha: Carrier p) => ext _ _ (\fun (sigma: Simplex total) => trans!{R} _ _ _ (onSimplex alpha (space q).zero sigma)
    (Scalars.scaleZero ((alpha).apply (Chains.generator p (Cut.front sigma)))));
\definition leftAdd: \forall (alpha, alphaPrime: Carrier p)(beta: Carrier q) ->
  apply ((space p).add alpha alphaPrime) beta = (space total).add (apply alpha beta) (apply alphaPrime beta) :=
  \fun (alpha, alphaPrime: Carrier p)(beta: Carrier q) => ext _ _ (\fun (sigma: Simplex total) =>
    trans!{R} _ _ _ (onSimplex ((space p).add alpha alphaPrime) beta sigma)
      (trans!{R} _ _ _
        ((RingModules.scalarModule).scalarAdd ((alpha).apply (Chains.generator p (Cut.front sigma))) ((alphaPrime).apply (Chains.generator p (Cut.front sigma))) ((beta).apply (Chains.generator q (Cut.back sigma))))
        (sym!{R} _ _ (congr2!{R R R} ((baseRing).add) _ _ _ _ (onSimplex alpha beta sigma) (onSimplex alphaPrime beta sigma)))));
\definition rightAdd: \forall (alpha: Carrier p)(beta, betaPrime: Carrier q) ->
  apply alpha ((space q).add beta betaPrime) = (space total).add (apply alpha beta) (apply alpha betaPrime) :=
  \fun (alpha: Carrier p)(beta, betaPrime: Carrier q) => ext _ _ (\fun (sigma: Simplex total) =>
    trans!{R} _ _ _ (onSimplex alpha ((space q).add beta betaPrime) sigma)
      (trans!{R} _ _ _
        ((RingModules.scalarModule).vectorAdd ((alpha).apply (Chains.generator p (Cut.front sigma))) ((beta).apply (Chains.generator q (Cut.back sigma))) ((betaPrime).apply (Chains.generator q (Cut.back sigma))))
        (sym!{R} _ _ (congr2!{R R R} ((baseRing).add) _ _ _ _ (onSimplex alpha beta sigma) (onSimplex alpha betaPrime sigma)))));
\import Modules.Laws[V := Carrier p, space := space p] \as LeftVectors;
\import Modules.Laws[V := Carrier q, space := space q] \as RightVectors;
\import Modules.Laws[V := Carrier total, space := space total] \as OutputVectors;
\import algebra.Group[].Of[Carrier := Carrier p, group := LeftVectors.additive] \as LeftGroup;
\import algebra.Group[].Of[Carrier := Carrier q, group := RightVectors.additive] \as RightGroup;
\import algebra.Group[].Of[Carrier := Carrier total, group := OutputVectors.additive] \as OutputGroup;
\definition leftDifference: \forall (x, y: Carrier p)(z: Carrier q) ->
  apply (LeftGroup.difference x y) z = OutputGroup.difference (apply x z) (apply y z) :=
  \fun (x, y: Carrier p)(z: Carrier q) => OutputGroup.cancelRight (apply y z) _ _
    (trans!{{Carrier total}} _ _ _ (sym!{{Carrier total}} _ _ (leftAdd (LeftGroup.difference x y) y z))
      (trans!{{Carrier total}} _ _ _
        (congr!{{Carrier p} {Carrier total}} (\fun (a: Carrier p) => apply a z) _ _ (LeftGroup.addDifference x y))
        (sym!{{Carrier total}} _ _ (OutputGroup.addDifference (apply x z) (apply y z)))));
\definition rightDifference: \forall (x: Carrier p)(y, z: Carrier q) ->
  apply x (RightGroup.difference y z) = OutputGroup.difference (apply x y) (apply x z) :=
  \fun (x: Carrier p)(y, z: Carrier q) => OutputGroup.cancelRight (apply x z) _ _
    (trans!{{Carrier total}} _ _ _ (sym!{{Carrier total}} _ _ (rightAdd x (RightGroup.difference y z) z))
      (trans!{{Carrier total}} _ _ _
        (congr!{{Carrier q} {Carrier total}} (apply x) _ _ (RightGroup.addDifference y z))
        (sym!{{Carrier total}} _ _ (OutputGroup.addDifference (apply x y) (apply x z)))));
