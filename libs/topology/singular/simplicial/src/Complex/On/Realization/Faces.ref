\import \parent.\parent.Faces[] \as Combinatorial;
\definition commutes: \forall (n: N.Nat^)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(sigma: Simplex (N.Nat^::succ n)) ->
  simplex n (Combinatorial.apply n i sigma) = Singular.face n i (simplex (N.Nat^::succ n) sigma) :=
  \fun (n: N.Nat^)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(sigma: Simplex (N.Nat^::succ n)) =>
    Singular.ext n (simplex n (Combinatorial.apply n i sigma)) (Singular.face n i (simplex (N.Nat^::succ n) sigma)) (\fun (x: Geometric.Carrier n) => sym!{{Geometric.Carrier d}} _ _
      (trans!{{Geometric.Carrier d}} _ _ _
        (congr!{{Geometric.Carrier (N.Nat^::succ n)} {Geometric.Carrier d}} (Geometric.Reindex[m := N.Nat^::succ n, n := d].apply sigma) _ _
          (Geometric.ReindexFace[n := n].law i x))
        (Geometric.Reindex[m := n, n := N.Nat^::succ n].Composition[k := d].law (Geometric.ReindexFace[n := n].skip i) sigma x)));
