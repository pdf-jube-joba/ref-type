\definition degree: N.Nat^ := N.Nat^::succ (N.Nat^::succ n);
\definition vanishes: \forall (f: Carrier degree) -> f = (space degree).zero :=
  \fun (f: Carrier degree) => Native.At[n := degree].ext f (space degree).zero
    (\fun (x: Chains.Carrier degree) => trans!{{A.Carrier}} _ _ _
      (congr!{{Chains.Carrier degree} {A.Carrier}} ((f).apply) _ _ (Chains.Higher[n := n].vanishes x))
      (Native.At[n := degree].zeroPreserved f));
