\import \root.On[A := A, source := source] \as Exchange;
\definition n: N.Nat^ := Nat.add p q;
\import \parent.Pairing[p := p, q := q] \as Pairing;
\import \parent.Cup[p := p, q := q] \as CochainCup;
\import CochainCup.Swapped[] \as Swapped;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := integerCoefficients] \as Ordinary;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.At[C := Ordinary.complex, k := p] \as Left;
\import Complexes.At[C := Ordinary.complex, k := q] \as Right;
\import Complexes.At[C := Ordinary.complex, k := n] \as Output;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].On[P := Total.complex, N := integerCoefficients] \as TensorCochains;
\import Complexes.At[C := TensorCochains.complex, k := n] \as TensorCohomology;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Homotopy[P := Chains.complex, Q := Total.complex, N := integerCoefficients] \as Invariance;
\import Complexes.Map[C := TensorCochains.complex, D := Ordinary.complex] \as Actions;
\import Products.Cohomology[].Cup[p := p, q := q] \as Product;
\import Products.Cohomology[].Cup[p := q, q := p] \as ReverseProduct;
\import Products.Cohomology[].DegreeTransport[] \as Regrading;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\import IntegerModules.Alternating[V := Output.CycleCarrier, space := Output.cycleSpace].Concatenation[] \as CycleSigns;
\import IntegerModules.Alternating[V := Output.Cohomology, space := Output.cohomologySpace].Concatenation[] \as GroupSigns;
\definition sign: N.Nat^ -> Output.Cohomology -> Output.Cohomology := GroupSigns.twist;
\definition cycleSign: N.Nat^ -> Output.CycleCarrier -> Output.CycleCarrier := CycleSigns.twist;
\definition ambient[x: Output.CycleCarrier]: Carrier n := x;
\definition ambientSign: \forall (t: N.Nat^)(x: Output.CycleCarrier) -> ambient (cycleSign t x) = Products.Signs[n := n].apply t (ambient x) :=
  \induction (t: N.Nat^) \return \forall (x: Output.CycleCarrier) -> ambient (cycleSign t x) = Products.Signs[n := n].apply t (ambient x) \with {
    | zero: \fun (x: Output.CycleCarrier) => \refl(ambient x)
    | succ: \fun (t: N.Nat^)(previous: _)(x: Output.CycleCarrier) => congr!{{Carrier n} {Carrier n}} ((space n).neg) _ _ (previous x)
  };
\import IntegerModules.Hom[V := Output.CycleCarrier, W := Output.Cohomology, source := Output.cycleSpace, target := Output.cohomologySpace] \as ClassLinear;
\definition signedClass: \forall (t: N.Nat^)(x: Output.CycleCarrier) -> Output.classOf (cycleSign t x) = sign t (Output.classOf x) :=
  \induction (t: N.Nat^) \return \forall (x: Output.CycleCarrier) -> Output.classOf (cycleSign t x) = sign t (Output.classOf x) \with {
    | zero: \fun (x: Output.CycleCarrier) => \refl(Output.classOf x)
    | succ: \fun (t: N.Nat^)(previous: _)(x: Output.CycleCarrier) => trans!{Output.Cohomology} _ _ _
      (ClassLinear.negativePreserved Output.classLinear (cycleSign t x))
      (congr!{Output.Cohomology Output.Cohomology} ((Output.cohomologySpace).neg) _ _ (previous x))
  };
\module OnCycles(alpha: Left.CycleCarrier, beta: Right.CycleCarrier);
\definition Group: N.Nat^ -> \Set := Theory.cohomology;
\definition reversed[x: Group p][y: Group q]: Group n := Transport.cast Group Swapped.reverseDegree n Swapped.same (ReverseProduct.apply y x);
\definition law: \forall (x: Group p)(y: Group q) -> Product.apply x y = sign Swapped.exponent (reversed x y) :=
  Left.classInduction (\fun (x: Group p) => \forall (y: Group q) -> Product.apply x y = sign Swapped.exponent (reversed x y))
    (\fun (alpha: Left.CycleCarrier) => Right.classInduction
      (\fun (y: Group q) => Product.apply (Left.classOf alpha) y = sign Swapped.exponent (reversed (Left.classOf alpha) y))
      (\fun (beta: Right.CycleCarrier) => OnCycles[alpha := alpha, beta := beta].law));
