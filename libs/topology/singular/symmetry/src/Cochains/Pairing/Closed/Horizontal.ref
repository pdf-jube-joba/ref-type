\use std.Logic[].Equality[].eq_reason_in;
\import Tensor.Term[p := N.Nat^::succ p, q := q] \as Before;
\import IntegerModules.Tensor[V := Chains.Carrier (N.Nat^::succ p), W := Chains.Carrier q, left := Chains.space (N.Nat^::succ p), right := Chains.space q].Universal[U := R, target := integerCoefficients.space] \as Universal;
\import IntegerModules.Hom[V := Before.Carrier, W := R, source := Before.space, target := integerCoefficients.space] \as Output;
\import Linear.Composition[U := Before.Carrier, domain := Before.space] \as Composition;
\definition composed: Output.Map := Composition.compose (map alpha beta) Differential.horizontal;
\definition cycle: \Prop := Theory.coboundary p alpha = (space (N.Nat^::succ p)).zero;
\definition closedValue[closed: cycle][x: Chains.Carrier (N.Nat^::succ p)]: (alpha).apply ((Chains.boundary p).apply x) = (integerCoefficients.space).zero :=
  congr!{{Carrier (N.Nat^::succ p)} R} (\fun (f: Carrier (N.Nat^::succ p)) => (f).apply x) _ _ closed;
\definition pure[closed: cycle][x: Chains.Carrier (N.Nat^::succ p)][y: Chains.Carrier q]: (composed).apply (Before.tensor x y) = (integerCoefficients.space).zero :=
  eq_reason_in!{R _
    "=" _ "by" { congr!{Term.Carrier R} ((map alpha beta).apply) _ _ (Differential.horizontalOnTensor x y) }
    "=" _ "by" { onTensor alpha beta ((Chains.boundary p).apply x) y }
    "=" _ "by" { congr!{R R} (\fun (a: R) => (baseRing).mul a ((beta).apply y)) _ _ (closedValue closed x) }
    "=" _ "by" { Scalars.zeroScale ((beta).apply y) }
  };
\definition equation[closed: cycle]: composed = Output.zeroMap := Universal.ext composed Output.zeroMap (pure closed);
\definition law[closed: cycle][x: Before.Carrier]: (map alpha beta).apply ((Differential.horizontal).apply x) = (integerCoefficients.space).zero :=
  congr!{Output.Map R} (\fun (f: Output.Map) => (f).apply x) _ _ (equation closed);
