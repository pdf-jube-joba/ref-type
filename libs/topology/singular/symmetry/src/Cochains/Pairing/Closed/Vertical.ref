\use std.Logic[].Equality[].eq_reason_in;
\import Tensor.Term[p := p, q := N.Nat^::succ q] \as Before;
\import IntegerModules.Tensor[V := Chains.Carrier p, W := Chains.Carrier (N.Nat^::succ q), left := Chains.space p, right := Chains.space (N.Nat^::succ q)].Universal[U := R, target := integerCoefficients.space] \as Universal;
\import IntegerModules.Hom[V := Before.Carrier, W := R, source := Before.space, target := integerCoefficients.space] \as Output;
\import Linear.Composition[U := Before.Carrier, domain := Before.space] \as Composition;
\definition composed: Output.Map := Composition.compose (map alpha beta) Differential.vertical;
\definition cycle: \Prop := Theory.coboundary q beta = (space (N.Nat^::succ q)).zero;
\definition closedValue[closed: cycle][y: Chains.Carrier (N.Nat^::succ q)]: (beta).apply ((Chains.boundary q).apply y) = (integerCoefficients.space).zero :=
  congr!{{Carrier (N.Nat^::succ q)} R} (\fun (f: Carrier (N.Nat^::succ q)) => (f).apply y) _ _ closed;
\definition pure[closed: cycle][x: Chains.Carrier p][y: Chains.Carrier (N.Nat^::succ q)]: (composed).apply (Before.tensor x y) = (integerCoefficients.space).zero :=
  eq_reason_in!{R _
    "=" _ "by" { congr!{Term.Carrier R} ((map alpha beta).apply) _ _ (Differential.verticalOnTensor x y) }
    "=" _ "by" { onTensor alpha beta x ((Chains.boundary q).apply y) }
    "=" _ "by" { congr!{R R} ((baseRing).mul ((alpha).apply x)) _ _ (closedValue closed y) }
    "=" _ "by" { Scalars.scaleZero ((alpha).apply x) }
  };
\definition equation[closed: cycle]: composed = Output.zeroMap := Universal.ext composed Output.zeroMap (pure closed);
\definition law[closed: cycle][x: Before.Carrier]: (map alpha beta).apply ((Differential.vertical).apply x) = (integerCoefficients.space).zero :=
  congr!{Output.Map R} (\fun (f: Output.Map) => (f).apply x) _ _ (equation closed);
