\use std.Logic[].Equality[].eq_reason_in;
\import \root.On[A := A, source := source] \as Exchange;
\import \parent.Pairing[p := p, q := q] \as Pairing;
\definition n: N.Nat^ := Nat.add p q;
\import Products.Cup[p := p, q := q] \as Product;
\import Simplices.Cut[p := p, q := q] \as Cut;
\import singular_products.AlexanderWhitney[A := A, B := A, left := source, right := source] \as AlexanderWhitney;
\import AlexanderWhitney.At[p := p, q := q] \as AW;
\import AlexanderWhitney.Total[] \as TotalAW;
\import topological_constructions.Product[A := A, B := A] \as Points;
\import singular_cohomology.Chains[A := Points.CarrierSet, source := Exchange.productTopology] \as ProductChains;
\import singular_cohomology.Simplices[A := Points.CarrierSet, source := Exchange.productTopology] \as ProductSimplices;
\import singular_cohomology.Maps[A := A, B := Points.CarrierSet, source := source, target := Exchange.productTopology] \as Diagonal;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\import algebraic_topology.Simplex[] \as Simplex;
\definition diagonal[sigma: Simplices.Carrier n]: ProductSimplices.Carrier n := Diagonal.postcompose n Exchange.diagonal Exchange.diagonalContinuous sigma;
\definition front[sigma: Simplices.Carrier n]: AW.front (diagonal sigma) = Cut.front sigma := \axiom:funext(AW.front (diagonal sigma), Cut.front sigma, \fun (x: Simplex.Carrier p) => \refl(Cut.front sigma x));
\definition back[sigma: Simplices.Carrier n]: AW.back (diagonal sigma) = Cut.back sigma := \axiom:funext(AW.back (diagonal sigma), Cut.back sigma, \fun (x: Simplex.Carrier q) => \refl(Cut.back sigma x));
\definition coordinate[sigma: Simplices.Carrier n]: Coordinates.Degree[n := n].coordinate Pairing.index ((Exchange.forward).apply n (Chains.generator n sigma)) = AW.value (diagonal sigma) :=
  eq_reason_in!{AW.Carrier _
    "=" _ "by" { congr!{{ProductChains.Carrier n} AW.Carrier} (\fun (x: ProductChains.Carrier n) => Coordinates.Degree[n := n].coordinate Pairing.index ((TotalAW.map).apply n x)) _ _ (Diagonal.At[n := n].onGenerator Exchange.diagonal Exchange.diagonalContinuous sigma) }
    "=" _ "by" { TotalAW.Degree[n := n].coordinate Pairing.index (ProductChains.generator n (diagonal sigma)) }
    "=" _ "by" { congr!{{ProductChains.Carrier n} AW.Carrier} ((AW.map).apply) _ _ (Transport.castRefl ProductChains.Carrier n (ProductChains.generator n (diagonal sigma))) }
    "=" _ "by" { AW.onGenerator (diagonal sigma) }
  };
\import IntegerModules.Hom[V := Total.Carrier n, W := R, source := Total.space n, target := integerCoefficients.space].Composition[U := Chains.Carrier n, domain := Chains.space n] \as Composition;
\import Native.Map[C := Chains.complex, D := Total.complex].At[n := n] \as Linear;
\definition pullback[alpha: Carrier p][beta: Carrier q]: Carrier n := Composition.compose (Pairing.total alpha beta) (Linear.linear Exchange.forward);
\definition onSimplex[alpha: Carrier p][beta: Carrier q][sigma: Simplices.Carrier n]: (pullback alpha beta).apply (Chains.generator n sigma) = (Product.apply alpha beta).apply (Chains.generator n sigma) :=
  eq_reason_in!{R _
    "=" _ "by" { congr!{AW.Carrier R} ((Pairing.map alpha beta).apply) _ _ (coordinate sigma) }
    "=" _ "by" { Pairing.onTensor alpha beta (Chains.generator p (AW.front (diagonal sigma))) (Chains.generator q (AW.back (diagonal sigma))) }
    "=" _ "by" { congr!{R R R} ((baseRing).mul) _ _ _ _
          (congr!{{Simplices.Carrier p} R} (\fun (s: Simplices.Carrier p) => (alpha).apply (Chains.generator p s)) _ _ (front sigma))
          (congr!{{Simplices.Carrier q} R} (\fun (s: Simplices.Carrier q) => (beta).apply (Chains.generator q s)) _ _ (back sigma)) }
    "=" _ "by" { sym!{R} _ _ (Product.onSimplex alpha beta sigma) }
  };
\import IntegerModules.Free[Generators := Simplices.Carrier n].To[W := R, target := integerCoefficients.space] \as Free;
\definition equation[alpha: Carrier p][beta: Carrier q]: pullback alpha beta = Product.apply alpha beta := Free.ext (pullback alpha beta) (Product.apply alpha beta) (onSimplex alpha beta);
\definition law[alpha: Carrier p][beta: Carrier q][x: Chains.Carrier n]: (Pairing.total alpha beta).apply ((Exchange.forward).apply n x) = (Product.apply alpha beta).apply x :=
  congr!{{Carrier n} R} (\fun (f: Carrier n) => (f).apply x) _ _ (equation alpha beta);
\module Regrading(k: N.Nat^);
\module Swapped;
