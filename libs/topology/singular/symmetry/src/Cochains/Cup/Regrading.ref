\import \root.Cochains[A := A, source := source, R := R, ring := ring].Cup[p := p, q := q] \as Original;
\definition index[same: n = k]: Double.Index k := \into[Double.Pair](Double.Pair { first := p, second := q }, { i: Double.Pair \where Nat.add (i).first (i).second = k }) \by { same };
\definition coordinate[same: n = k][x: Total.Carrier k]: Tensor.Term[p := p, q := q].Carrier := Coordinates.Degree[n := k].coordinate (index same) x;
\definition coordinateTransport[same: n = k][x: Total.Carrier k]: coordinate same x = Coordinates.Degree[n := n].coordinate Pairing.index (Transport.cast Total.Carrier k n (sym!{N.Nat^} n k same) x) :=
  (\idelim n = k \with degree: N.Nat^ => \forall (same: n = degree)(x: Total.Carrier degree) ->
    Coordinates.Degree[n := degree].coordinate (\into[Double.Pair](Double.Pair { first := p, second := q }, { i: Double.Pair \where Nat.add (i).first (i).second = degree }) \by { same }) x = Coordinates.Degree[n := n].coordinate Pairing.index (Transport.cast Total.Carrier degree n (sym!{N.Nat^} n degree same) x) \by {
    base: \fun (same: n = n)(x: Total.Carrier n) => sym!{{Tensor.Term[p := p, q := q].Carrier}} _ _ (congr!{{Total.Carrier n} {Tensor.Term[p := p, q := q].Carrier}} (Coordinates.Degree[n := n].coordinate Pairing.index) _ _ (Transport.castRefl Total.Carrier n x)),
    equality: same
  }) same x;
\definition chainTransport[same: n = k][x: Chains.Carrier k]: Transport.cast Total.Carrier k n (sym!{N.Nat^} n k same) ((Exchange.forward).apply k x) = (Exchange.forward).apply n (Transport.cast Chains.Carrier k n (sym!{N.Nat^} n k same) x) :=
  Transport.natural Chains.Carrier Total.Carrier (\fun (d: N.Nat^) => (Exchange.forward).apply d) k n (sym!{N.Nat^} n k same) x;
\definition evaluateTransport[same: n = k][f: Carrier n][x: Chains.Carrier k]: (Transport.cast Carrier n k same f).apply x = (f).apply (Transport.cast Chains.Carrier k n (sym!{N.Nat^} n k same) x) :=
  (\idelim n = k \with d: N.Nat^ => \forall (same: n = d)(x: Chains.Carrier d) -> (Transport.cast Carrier n d same f).apply x = (f).apply (Transport.cast Chains.Carrier d n (sym!{N.Nat^} n d same) x) \by {
    base: \fun (same: n = n)(x: Chains.Carrier n) => trans!{R} _ _ _
      (congr!{{Carrier n} R} (\fun (h: Carrier n) => (h).apply x) _ _ (Transport.castRefl Carrier n f))
      (sym!{R} _ _ (congr!{{Chains.Carrier n} R} ((f).apply) _ _ (Transport.castRefl Chains.Carrier n x))),
    equality: same
  }) same x;
\definition law[same: n = k][alpha: Carrier p][beta: Carrier q][x: Chains.Carrier k]: (Pairing.map alpha beta).apply (coordinate same ((Exchange.forward).apply k x)) = (Transport.cast Carrier n k same (Product.apply alpha beta)).apply x :=
  trans!{R} _ _ _
    (congr!{{Tensor.Term[p := p, q := q].Carrier} R} ((Pairing.map alpha beta).apply) _ _ (coordinateTransport same ((Exchange.forward).apply k x)))
    (trans!{R} _ _ _
      (congr!{{Total.Carrier n} R} ((Pairing.total alpha beta).apply) _ _ (chainTransport same x))
      (trans!{R} _ _ _ (Original.law alpha beta (Transport.cast Chains.Carrier k n (sym!{N.Nat^} n k same) x))
        (sym!{R} _ _ (evaluateTransport same (Product.apply alpha beta) x))));
