\definition n: N.Nat^ := Nat.add p q;
\import Tensor.Term[p := p, q := q] \as Term;
\import IntegerModules.Tensor[V := Chains.Carrier p, W := Chains.Carrier q, left := Chains.space p, right := Chains.space q] \as Pure;
\import Pure.Universal[U := R, target := integerCoefficients.space] \as Universal;
\definition value[alpha: Carrier p][beta: Carrier q][x: Chains.Carrier p][y: Chains.Carrier q]: R := (baseRing).mul ((beta).apply y) ((alpha).apply x);
\definition commuted[alpha: Carrier p][beta: Carrier q][x: Chains.Carrier p][y: Chains.Carrier q]: value alpha beta x y = (baseRing).mul ((alpha).apply x) ((beta).apply y) := (ring).mulCommutative ((beta).apply y) ((alpha).apply x);
\module Laws(alpha: Carrier p, beta: Carrier q);
\definition bilinear[alpha: Carrier p][beta: Carrier q]: Pure.BilinearLaws[R, integerCoefficients.space, value alpha beta] := Laws[alpha := alpha, beta := beta].laws;
\definition map[alpha: Carrier p][beta: Carrier q]: IntegerModules.Hom[V := Term.Carrier, W := R, source := Term.space, target := integerCoefficients.space].Map := Universal.map (value alpha beta) (bilinear alpha beta);
\definition onTensor[alpha: Carrier p][beta: Carrier q][x: Chains.Carrier p][y: Chains.Carrier q]: (map alpha beta).apply (Term.tensor x y) = (baseRing).mul ((alpha).apply x) ((beta).apply y) :=
  trans!{R} _ _ _ (Universal.onTensor (value alpha beta) (bilinear alpha beta) x y) (commuted alpha beta x y);
\import Coordinates.Step[p := p, q := q] \as Position;
\definition index: Double.Index n := Position.targetIndex;
\import Coordinates.Degree[n := n] \as Current;
\import IntegerModules.Hom[V := Term.Carrier, W := R, source := Term.space, target := integerCoefficients.space].Composition[U := Total.Carrier n, domain := Total.space n] \as Compose;
\definition total[alpha: Carrier p][beta: Carrier q]: IntegerModules.Hom[V := Total.Carrier n, W := R, source := Total.space n, target := integerCoefficients.space].Map := Compose.compose (map alpha beta) Current.At[i := index].map;
\module Closed;
