\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import singular_cohomology.Chains[A := A, source := source] \as Chains;
\import singular_cohomology.Simplices[A := A, source := source] \as Simplices;
\import Double.Tensor[C := Chains.complex, D := Chains.complex] \as Tensor;
\import Double.Total[C := Tensor.complex] \as Total;
\import topological_constructions.Product[A := A, B := A] \as Product;
\definition productTopology: topology.Topology[Carrier := Product.CarrierSet].Topology := Product.topology source source;
\import std.Data[].Pair[] \as Pair;
\definition diagonal[x: A]: Product.CarrierSet := Pair.pair A A x x;
\import topology.Maps[A := A, B := A].Identity[] \as Identity;
\import singular_cohomology.Maps[A := A, B := Product.CarrierSet, source := source, target := productTopology] \as DiagonalMaps;
\definition diagonalContinuous: DiagonalMaps.Continuous diagonal := Product.Universal[X := A].pairContinuous source source source (\fun (x: A) => x) (\fun (x: A) => x) (Identity.continuous source) (Identity.continuous source);
\import singular_cohomology.Chains[A := Product.CarrierSet, source := productTopology] \as ProductChains;
\import singular_products.AlexanderWhitney[A := A, B := A, left := source, right := source].Total[] \as AW;
\import Native.Map[C := ProductChains.complex, D := Total.complex].Composition[B := Chains.complex] \as AWComposition;
\definition forward: Native.Map[C := Chains.complex, D := Total.complex].Map := AWComposition.compose AW.map (DiagonalMaps.push diagonal diagonalContinuous);
\import Double.TensorSwap[C := Chains.complex, D := Chains.complex] \as Swap;
\import Native.Map[C := Total.complex, D := Total.complex].Composition[B := Chains.complex] \as SwapComposition;
\definition backward: Native.Map[C := Chains.complex, D := Total.complex].Map := SwapComposition.compose Swap.forward forward;
\import Native.Map[C := Chains.complex, D := Total.complex].Additive[] \as Additive;
\definition defect: Native.Map[C := Chains.complex, D := Total.complex].Map := Additive.difference forward backward;
\module SwapCoordinates(n: N.Nat^, i: Double.Index n);
\module Zero;
\module Naturality(B: \Set, target: topology.Topology[Carrier := B].Topology);
\module Homotopy;
