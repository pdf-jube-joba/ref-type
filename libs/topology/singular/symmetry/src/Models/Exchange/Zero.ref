\definition n: N.Nat^ := N.Nat^::zero;
\import \parent.\parent.At[n := n] \as Current;
\import Simplex.At[n := n] \as Domain;
\import \root.On[A := Simplex.Carrier n, source := Domain.topology] \as Comparison;
\import \parent.Degree[n := n] \as Value;
\import Modules.Hom[V := Current.Carrier (I.Int^::ofNat n), W := Current.Carrier (Degrees.previous (I.Int^::ofNat n)), source := Current.space (I.Int^::ofNat n), target := Current.space (Degrees.previous (I.Int^::ofNat n))] \as Boundary;
\import singular_cohomology.Chains[A := Simplex.Carrier n, source := Domain.topology] \as Chains;
\import Double.Tensor[C := Chains.complex, D := Chains.complex] \as Tensor;
\import Double.Total[C := Tensor.complex] \as Total;
\import Native.ZeroExtension[C := Total.complex] \as Signed;
\definition value: Value.value = (Current.space (I.Int^::ofNat n)).zero := congr!{{Total.Carrier n} {Current.Carrier (I.Int^::ofNat n)}} (Signed.Positive[n := n].intro) _ _ (Comparison.Zero[].defect Current.cell);
\definition closed: (Current.boundary (I.Int^::ofNat n)).apply Value.value = (Current.space (Degrees.previous (I.Int^::ofNat n))).zero :=
  trans!{{Current.Carrier (Degrees.previous (I.Int^::ofNat n))}} _ _ _
    (congr!{{Current.Carrier (I.Int^::ofNat n)} {Current.Carrier (Degrees.previous (I.Int^::ofNat n))}} ((Current.boundary (I.Int^::ofNat n)).apply) _ _ value)
    (Boundary.zeroPreserved (Current.boundary (I.Int^::ofNat n)));
\definition one: I.Int^ := I.Int^::ofNat (N.Nat^::succ n);
\import Modules.Hom[V := Current.Carrier one, W := Current.Carrier (I.Int^::ofNat n), source := Current.space one, target := Current.space (I.Int^::ofNat n)] \as InitialBoundary;
\definition initial: (Current.boundary one).apply (Current.space one).zero = Value.value :=
  trans!{{Current.Carrier (I.Int^::ofNat n)}} _ _ _ (InitialBoundary.zeroPreserved (Current.boundary one)) (sym!{{Current.Carrier (I.Int^::ofNat n)}} _ _ value);
