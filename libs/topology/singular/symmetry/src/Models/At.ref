\import TensorModels.At[p := n, q := n] \as TensorModel;
\import Simplex.At[n := n] \as Domain;
\import singular_cohomology.Chains[A := Simplex.Carrier n, source := Domain.topology] \as Chains;
\import Double.Tensor[C := Chains.complex, D := Chains.complex] \as Tensor;
\import Double.Total[C := Tensor.complex] \as Total;
\import Native.ZeroExtension[C := Total.complex] \as Signed;
\definition Carrier[z: I.Int^]: \Set := TensorModel.Carrier z;
\definition space[z: I.Int^]: Modules.Space (Carrier z) := TensorModel.space z;
\definition boundary[z: I.Int^]: Modules.Hom[V := Carrier z, W := Carrier (Degrees.previous z), source := space z, target := space (Degrees.previous z)].Map := TensorModel.boundary z;
\definition squareZero: \forall (z: I.Int^)(x: Carrier z) -> (boundary (Degrees.previous z)).apply ((boundary z).apply x) = (space (Degrees.previous (Degrees.previous z))).zero := TensorModel.squareZero;
\definition simplex: singular_cohomology.Simplices[A := Simplex.Carrier n, source := Domain.topology].Carrier n := TensorModel.leftSimplex;
\definition cell: Chains.Carrier n := Chains.generator n simplex;
\module Filling(k: N.Nat^) {
  \import TensorModel.Contraction[].Filling[n := k] \as Explicit;
  \definition map: Modules.Hom[V := Carrier (I.Int^::ofNat (N.Nat^::succ k)), W := Carrier (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ k))), source := space (I.Int^::ofNat (N.Nat^::succ k)), target := space (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ k)))].Map := Explicit.map;
  \definition law: \forall (x: Carrier (I.Int^::ofNat (N.Nat^::succ k))) -> (boundary (I.Int^::ofNat (N.Nat^::succ k))).apply x = (space (Degrees.previous (I.Int^::ofNat (N.Nat^::succ k)))).zero -> (boundary (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ k)))).apply ((map).apply x) = x := Explicit.boundaryClosed;
}
