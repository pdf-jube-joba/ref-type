\import Diagonal.Of[model := model] \as Construction;
\definition data: Construction.PositiveFillings := Construction.PositiveFillings {
  operator := \fun (n: N.Nat^) => \parent.At[n := N.Nat^::succ n].Filling[k := n].map,
  boundary := \fun (n: N.Nat^) => \parent.At[n := N.Nat^::succ n].Filling[k := n].law,
};
