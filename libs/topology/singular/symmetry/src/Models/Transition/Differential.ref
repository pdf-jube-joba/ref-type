\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Degree[z := z] \as Current;
\import \parent.Degree[z := Degrees.previous z] \as Prior;
\import Modules.Alternating[V := Higher.Carrier z, space := Higher.space z].Mapping[W := Higher.Carrier (Degrees.previous z), target := Higher.space (Degrees.previous z)] \as BoundarySum;
\import Modules.Alternating[V := Higher.Carrier (Degrees.previous z), space := Higher.space (Degrees.previous z)] \as Sum;
\definition law[x: Lower.Carrier z]: (Higher.boundary z).apply ((Current.map).apply x) = (Prior.map).apply ((Lower.boundary z).apply x) :=
  eq_reason_in!{{Higher.Carrier (Degrees.previous z)} _
    "=" _ "by" { congr!{{Higher.Carrier z} {Higher.Carrier (Degrees.previous z)}} ((Higher.boundary z).apply) _ _ (Current.onValues x) }
    "=" _ "by" { BoundarySum.law (Higher.boundary z) count (\fun (i: Fin.Fin count) => (Current.faces i).apply x) }
    "=" _ "by" { Sum.congruent count
          (\fun (i: Fin.Fin count) => (Higher.boundary z).apply ((Current.faces i).apply x))
          (\fun (i: Fin.Fin count) => (Prior.faces i).apply ((Lower.boundary z).apply x))
          (\fun (i: Fin.Fin count) => \parent.\parent.Face[n := n, i := i].commutes z x) }
    "=" _ "by" { sym!{{Higher.Carrier (Degrees.previous z)}} _ _ (Prior.onValues ((Lower.boundary z).apply x)) }
  };
