\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import chain_complexes.Chain[] \as Degrees;
\import Degrees.Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\import Double.AcyclicDiagonal[] \as Diagonal;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import singular_eilenberg_zilber.TensorModels[] \as TensorModels;
\import algebraic_topology.Simplex[] \as Simplex;
\module At(n: N.Nat^);
\module Face(n: N.Nat^, i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)));
\definition family: Diagonal.ModelFamily := Diagonal.ModelFamily {
  Carrier := \fun (n: N.Nat^)(z: I.Int^) => At[n := n].Carrier z,
  space := \fun (n: N.Nat^)(z: I.Int^) => At[n := n].space z,
};
\module Transition(n: N.Nat^);
\module Interchange(n: N.Nat^, i, j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)));
\module Square(n: N.Nat^, z: I.Int^);
\definition operators: Diagonal.Operators[family] := Diagonal.Operators[family] {
  boundary := \fun (n: N.Nat^)(z: I.Int^) => At[n := n].boundary z,
  transition := \fun (n: N.Nat^)(z: I.Int^) => Transition[n := n].Degree[z := z].map,
};
\module Laws(n: N.Nat^);
\definition model: Diagonal.Model := Diagonal.Model {
  family := family, operators := operators,
  laws := Diagonal.ModelLaws[family, operators] {
    boundarySquare := \fun (n: N.Nat^) => Laws[n := n].boundarySquare,
    transitionSquare := \fun (n: N.Nat^)(z: I.Int^) => Square[n := n, z := z].law,
    commutes := \fun (n: N.Nat^)(z: I.Int^) => Transition[n := n].commutes z,
  },
};
\module Fillings;
\module Exchange;
