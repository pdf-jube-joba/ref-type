\import Double.SignedTranspose[C := Tensor.complex] \as SignedTranspose;
\import SignedTranspose.Permutation[] \as Permutation;
\import Double.Transpose[C := Tensor.complex] \as Transposed;
\import Double.Swap[C := Tensor.complex] \as Koszul;
\import Koszul.Conjugate[] \as SignChange;
\import Double.TensorSymmetry[C := Chains.complex, D := Chains.complex] \as TensorSymmetry;
\import Double.Coordinates[C := Tensor.complex].Degree[n := n] \as Values;
\import Double.Coordinates[C := Transposed.complex].Degree[n := n] \as TransposedValues;
\import Double.Coordinates[C := SignedTranspose.complex].Degree[n := n] \as SignedValues;
\definition swapped: Double.Index n := Swap.index n i;
\import Double.Map[C := Transposed.complex, D := Tensor.complex].Total[f := TensorSymmetry.map].Coordinates[n := n] \as SymmetryCoordinates;
\import Double.Map[C := SignedTranspose.complex, D := Transposed.complex].Total[f := SignChange.map].Coordinates[n := n] \as SignCoordinates;
\import Double.TensorSwap[C := Chains.complex, D := Chains.complex].Term[p := (i).first, q := (i).second] \as SignedSymmetry;
\import TensorSymmetry.Term[p := (i).second, q := (i).first] \as Flip;
\import Double.Sign[V := Tensor.Carrier (i).first (i).second, space := Tensor.space (i).first (i).second] \as Sign;
\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as Natural;
\definition law[x: Total.Carrier n]: Values.coordinate swapped ((Swap.forward).apply n x) = (SignedSymmetry.map).apply (Values.coordinate i x) :=
  trans!{{Tensor.Carrier (i).second (i).first}} _ _ _ (SymmetryCoordinates.law swapped ((Koszul.forward).apply n x))
    (trans!{{Tensor.Carrier (i).second (i).first}} _ _ _
      (congr!{{Tensor.Carrier (i).first (i).second} {Tensor.Carrier (i).second (i).first}} ((Flip.forward).apply) _ _ (SignCoordinates.law swapped ((Permutation.forward).apply n x)))
      (trans!{{Tensor.Carrier (i).second (i).first}} _ _ _
        (congr!{N.Nat^ {Tensor.Carrier (i).second (i).first}}
          (\fun (k: N.Nat^) => (Flip.forward).apply ((Sign.map k).apply (SignedValues.coordinate swapped ((Permutation.forward).apply n x)))) _ _ (Natural.mulComm (i).second (i).first))
        (trans!{{Tensor.Carrier (i).second (i).first}} _ _ _
          (congr!{{Tensor.Carrier (i).first (i).second} {Tensor.Carrier (i).second (i).first}}
            (\fun (v: Tensor.Carrier (i).first (i).second) => (Flip.forward).apply ((Sign.map (Nat.mul (i).first (i).second)).apply v)) _ _
            (Permutation.Degree[n := n].Coordinate[i := i].formula x))
          (SignedSymmetry.naturality (Values.coordinate i x)))));
