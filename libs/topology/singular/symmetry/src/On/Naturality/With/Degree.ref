\definition diagonal[x: Chains.Carrier n]: (product).apply n ((DiagonalMaps.push Initial.diagonal diagonalContinuous).apply n x) = (TargetDiagonalMaps.push Target.diagonal Target.diagonalContinuous).apply n ((Maps.push f continuous).apply n x) :=
  congr!{DiagonalLinear.Map {TargetProductChains.Carrier n}} (\fun (g: DiagonalLinear.Map) => (g).apply n x) _ _ diagonalSquare;
\definition forward[x: Chains.Carrier n]: (tensor).apply n ((Initial.forward).apply n x) = (Target.forward).apply n ((Maps.push f continuous).apply n x) :=
  trans!{{TargetTotal.Carrier n}} _ _ _ (AWNaturality.AlexanderWhitney[n := n].law ((DiagonalMaps.push Initial.diagonal diagonalContinuous).apply n x))
    (congr!{{TargetProductChains.Carrier n} {TargetTotal.Carrier n}} ((TargetAW.map).apply n) _ _ (diagonal x));
\definition swapped[x: Total.Carrier n]: (tensor).apply n ((Swap.forward).apply n x) = (TargetSwap.forward).apply n ((tensor).apply n x) :=
  congr!{{Native.Map[C := Total.complex, D := TargetTotal.complex].Map} {TargetTotal.Carrier n}} (\fun (g: Native.Map[C := Total.complex, D := TargetTotal.complex].Map) => (g).apply n x) _ _ SwapNaturality.square;
\definition backward[x: Chains.Carrier n]: (tensor).apply n ((Initial.backward).apply n x) = (Target.backward).apply n ((Maps.push f continuous).apply n x) :=
  trans!{{TargetTotal.Carrier n}} _ _ _ (swapped ((Initial.forward).apply n x))
    (congr!{{TargetTotal.Carrier n} {TargetTotal.Carrier n}} ((TargetSwap.forward).apply n) _ _ (forward x));
\import Native.Map[C := Total.complex, D := TargetTotal.complex].At[n := n] \as TensorLinear;
\import Modules.Hom[V := Total.Carrier n, W := TargetTotal.Carrier n, source := Total.space n, target := TargetTotal.space n] \as Linear;
\import Modules.Laws[V := TargetTotal.Carrier n, space := TargetTotal.space n] \as Values;
\import algebra.Group[].Of[Carrier := TargetTotal.Carrier n, group := Values.additive] \as Group;
\definition defect[x: Chains.Carrier n]: (tensor).apply n ((Initial.defect).apply n x) = (Target.defect).apply n ((Maps.push f continuous).apply n x) :=
  trans!{{TargetTotal.Carrier n}} _ _ _ (Linear.differencePreserved (TensorLinear.linear tensor) ((Initial.forward).apply n x) ((Initial.backward).apply n x))
    (congr!{{TargetTotal.Carrier n} {TargetTotal.Carrier n} {TargetTotal.Carrier n}} Group.difference _ _ _ _ (forward x) (backward x));
