\import std.Data[].Nat[] \as N;
\import std.Data[].Nat[].Basic[].Def[] \as Nat;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Alg[].Ring[] \as Rings;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\definition baseRing: Rings.Ring[R] := Rings.commutativeRingAsRing R ring;
\import module_theory.Module[].Over[R := R, ring := baseRing] \as Modules;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as IntegerModules;
\import singular_products.Cochains[A := A, source := source, R := R, ring := ring] \as Products;
\definition Carrier: N.Nat^ -> \Set := Products.Carrier;
\definition space: \forall (n: N.Nat^) -> Modules.Space (Carrier n) := Products.space;
\definition coefficients: Modules.Bundle := Modules.Bundle { Carrier := R, space := Modules.scalarModule };
\import Modules.AbelianHom[N := coefficients] \as Abelian;
\definition integerCoefficients: IntegerModules.Bundle := Abelian.coefficients;
\import singular_cohomology.Cochains[A := A, source := source].OverRing[R := R, ring := ring].With[coefficients := coefficients] \as Theory;
\import singular_cohomology.Chains[A := A, source := source] \as Chains;
\import singular_cohomology.Simplices[A := A, source := source] \as Simplices;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import Double.Tensor[C := Chains.complex, D := Chains.complex] \as Tensor;
\import Double.Total[C := Tensor.complex] \as Total;
\import Double.Coordinates[C := Tensor.complex] \as Coordinates;
\module Pairing(p, q: N.Nat^);
\module Cup(p, q: N.Nat^);
\module GradedCommutativity(p, q: N.Nat^);
\module ExternalCup(p, q: N.Nat^);
