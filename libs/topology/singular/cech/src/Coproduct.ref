\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import N.Basic[].Prop[] \as Bounds;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import algebraic_topology.Semisimplicial[] \as Semisimplicial;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\module View(X: Semisimplicial.Object) {
  \definition Carrier[n: N.Nat^]: \Set := X.family.Carrier n;
  \definition face[n: N.Nat^]: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)) -> Carrier (N.Nat^::succ n) -> Carrier n := X.faces.apply n;
  \definition identity: \forall (n: N.Nat^)(i, j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(s: Carrier (N.Nat^::succ (N.Nat^::succ n))) -> Bounds.Le i j ->
    face n j (face (N.Nat^::succ n) (Fin.widen (N.Nat^::succ (N.Nat^::succ n)) i) s) =
      face n i (face (N.Nat^::succ n) (Fin.succ (N.Nat^::succ (N.Nat^::succ n)) j) s) := (X.laws).identity;
}
\module On(Index: \Set, objects: Index -> Semisimplicial.Object);
