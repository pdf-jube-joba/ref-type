\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import singular_cohomology.SimplicialChains[].On[X := X] \as Chains;
\use Equality.transport;
\definition Carrier: N.Nat^ -> \Set := Chains.Carrier;
\definition space: \forall (n: N.Nat^) -> Modules.Space (Carrier n) := Chains.space;
\definition generator: \forall (n: N.Nat^) -> Simplex n -> Carrier n := Chains.generator;
\definition boundary: \forall (n: N.Nat^) -> Modules.Hom[V := Carrier (N.Nat^::succ n), W := Carrier n,
  source := space (N.Nat^::succ n), target := space n].Map := Chains.boundary;
\definition extended[n: N.Nat^][s: Simplex n][absent: (cone).present n s = B.Bool^::false]: Simplex (N.Nat^::succ n) := extend cone n s absent;
\import B.Prop[] \as BooleanLaws;
\structure ValueLaws[n: N.Nat^, s: Simplex n, y: Carrier (N.Nat^::succ n)]: \Prop := {
  present: (cone).present n s = B.Bool^::true -> y = (space (N.Nat^::succ n)).zero,
  absent: \forall (missing: (cone).present n s = B.Bool^::false) -> y = generator (N.Nat^::succ n) (extended n s missing),
};
\definition Value[n: N.Nat^][s: Simplex n]: \Set := \Cast[Carrier (N.Nat^::succ n)] ({ y: Carrier (N.Nat^::succ n) \where ValueLaws[n, s, y] });
\definition valueLaws[n: N.Nat^][s: Simplex n][y: Value n s]: ValueLaws[n, s, y] :=
  \bysub(Carrier (N.Nat^::succ n), { y: Carrier (N.Nat^::succ n) \where ValueLaws[n, s, y] }, y);
\definition valueExists[n: N.Nat^][s: Simplex n]: \exists Value n s :=
  (\induction (flag: B.Bool^) \return (cone).present n s = flag -> \exists Value n s \with {
    | true: \fun (present: _) => Logic.existsIntro[Carrier (N.Nat^::succ n),
        { y: Carrier (N.Nat^::succ n) \where ValueLaws[n, s, y] }]
        (space (N.Nat^::succ n)).zero (ValueLaws[n, s, (space (N.Nat^::succ n)).zero] {
          present := \fun (same: _) => \refl((space (N.Nat^::succ n)).zero),
          absent := \fun (missing: _) => Logic.falseElim _ (BooleanLaws.trueNeFalse
            (trans!{{B.Bool^}} _ _ _ (sym!{{B.Bool^}} _ _ present) missing)),
        })
    | false: \fun (missing: _) => Logic.existsIntro[Carrier (N.Nat^::succ n),
        { y: Carrier (N.Nat^::succ n) \where ValueLaws[n, s, y] }]
        (generator (N.Nat^::succ n) (extended n s missing))
        (ValueLaws[n, s, generator (N.Nat^::succ n) (extended n s missing)] {
          present := \fun (present: _) => Logic.falseElim _ (BooleanLaws.falseNeTrue
            (trans!{{B.Bool^}} _ _ _ (sym!{{B.Bool^}} _ _ missing) present)),
          absent := \fun (same: _) => \refl(generator (N.Nat^::succ n) (extended n s missing)),
        })
  }) ((cone).present n s) (\refl((cone).present n s));
\definition valueUnique[n: N.Nat^][s: Simplex n][a, b: Value n s]: a = b :=
  (\induction (flag: B.Bool^) \return (cone).present n s = flag -> a = b \with {
    | true: \fun (present: _) => trans!{{Carrier (N.Nat^::succ n)}} _ _ _
        ((valueLaws n s a).present present) (sym!{{Carrier (N.Nat^::succ n)}} _ _ ((valueLaws n s b).present present))
    | false: \fun (missing: _) => trans!{{Carrier (N.Nat^::succ n)}} _ _ _
        ((valueLaws n s a).absent missing) (sym!{{Carrier (N.Nat^::succ n)}} _ _ ((valueLaws n s b).absent missing))
  }) ((cone).present n s) (\refl((cone).present n s));
\definition selected[n: N.Nat^][s: Simplex n]: Value n s := \choice Value n s \by { existence: valueExists n s, uniqueness: valueUnique n s };
\definition value[n: N.Nat^][s: Simplex n]: Carrier (N.Nat^::succ n) := selected n s;
\definition onPresent[n: N.Nat^][s: Simplex n][present: (cone).present n s = B.Bool^::true]: value n s = (space (N.Nat^::succ n)).zero :=
  (valueLaws n s (selected n s)).present present;
\definition onAbsent[n: N.Nat^][s: Simplex n][absent: (cone).present n s = B.Bool^::false]:
  value n s = generator (N.Nat^::succ n) (extended n s absent) := (valueLaws n s (selected n s)).absent absent;
\module Degree(n: N.Nat^) {
  \import Modules.Free[Generators := Simplex n].To[W := Carrier (N.Nat^::succ n), target := space (N.Nat^::succ n)] \as Free;
  \definition map: Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)].Map := Free.extension (value n);
  \definition onGenerator: \forall (s: Simplex n) -> (map).apply (generator n s) = value n s := Free.onGenerator (value n);
}
\definition homotopy[n: N.Nat^]: Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)].Map := Degree[n := n].map;
\definition homotopyPresent[n: N.Nat^][s: Simplex n][present: (cone).present n s = B.Bool^::true]:
  (homotopy n).apply (generator n s) = (space (N.Nat^::succ n)).zero :=
  trans!{{Carrier (N.Nat^::succ n)}} _ _ _ (Degree[n := n].onGenerator s) (onPresent n s present);
\definition homotopyAbsent[n: N.Nat^][s: Simplex n][absent: (cone).present n s = B.Bool^::false]:
  (homotopy n).apply (generator n s) = generator (N.Nat^::succ n) (extended n s absent) :=
  trans!{{Carrier (N.Nat^::succ n)}} _ _ _ (Degree[n := n].onGenerator s) (onAbsent n s absent);
\module Positive(n: N.Nat^);
\module Zero;
