\module Degree(n: N.Nat^) {
  \definition value[s: Generator[n]]: Carrier (N.Nat^::succ n) :=
    (\parent.\parent.Component[i := (s).index].inclusion).apply (N.Nat^::succ n)
      (((contractions).homotopy (s).index n).apply (\parent.\parent.Component[i := (s).index].generator n (s).simplex));
  \import Modules.Free[Generators := Generator[n]].To[W := Carrier (N.Nat^::succ n), target := space (N.Nat^::succ n)] \as Free;
  \definition map: Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)].Map := Free.extension value;
  \definition onGenerator[s: Generator[n]]: (map).apply (generator n s) = value s := Free.onGenerator value s;
}
\definition homotopy[n: N.Nat^]: Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)].Map := Degree[n := n].map;
\module Intertwining(i: Index, n: N.Nat^) {
  \import \parent.\parent.Component[i := i] \as Component;
  \import Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)].Composition[U := Component.Carrier n, domain := Component.space n] \as Before;
  \import Modules.Hom[V := Component.Carrier (N.Nat^::succ n), W := Carrier (N.Nat^::succ n), source := Component.space (N.Nat^::succ n), target := space (N.Nat^::succ n)].Composition[U := Component.Carrier n, domain := Component.space n] \as After;
  \import Complexes.Map[C := Component.complex, D := complex] \as Inclusions;
  \import Modules.Free[Generators := Component.Simplex n].To[W := Carrier (N.Nat^::succ n), target := space (N.Nat^::succ n)] \as Free;
  \definition equality: Before.compose (homotopy n) (Inclusions.At[n := n].linear Component.inclusion) =
    After.compose (Inclusions.At[n := N.Nat^::succ n].linear Component.inclusion) ((contractions).homotopy i n) :=
    Free.ext _ _ (\fun (s: Component.Simplex n) => trans!{{Carrier (N.Nat^::succ n)}} _ _ _
      (congr!{{Carrier n} {Carrier (N.Nat^::succ n)}} ((homotopy n).apply) _ _ (Component.onGenerator n s))
      (\parent.Degree[n := n].onGenerator (Generator[n] { index := i, simplex := s })));
  \import Modules.Hom[V := Component.Carrier n, W := Carrier (N.Nat^::succ n), source := Component.space n, target := space (N.Nat^::succ n)] \as Maps;
  \definition law[x: Component.Carrier n]: (homotopy n).apply ((Component.inclusion).apply n x) =
    (Component.inclusion).apply (N.Nat^::succ n) (((contractions).homotopy i n).apply x) :=
    congr!{{Maps.Map} {Carrier (N.Nat^::succ n)}} (\fun (f: Maps.Map) => (f).apply x) _ _ equality;
}
\module Positive(n: N.Nat^);
\module Zero;
