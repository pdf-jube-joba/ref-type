\use std.Logic[].Equality[].eq_reason_in;
\definition degree: N.Nat^ := N.Nat^::zero;
\import Modules.Laws[V := Carrier degree, space := space degree] \as Values;
\import algebra.Group[].Of[Carrier := Carrier degree, group := Values.additive] \as Group;
\import Modules.Free[Generators := Index] \as Augmented;
\definition AugmentationCarrier: \Set := Augmented.Carrier;
\definition augmentationSpace: Modules.Space AugmentationCarrier := Augmented.space;
\definition augmentationGenerator: Index -> AugmentationCarrier := Augmented.generator;
\import Modules.Free[Generators := Generator[degree]].To[W := Augmented.Carrier, target := Augmented.space] \as ToIndices;
\definition augmentation: Modules.Hom[V := Carrier degree, W := Augmented.Carrier, source := space degree, target := Augmented.space].Map :=
  ToIndices.extension (\fun (s: Generator[degree]) => Augmented.generator (s).index);
\definition augmentationOnGenerator[s: Generator[degree]]: (augmentation).apply (generator degree s) = Augmented.generator (s).index :=
  ToIndices.onGenerator (\fun (s: Generator[degree]) => Augmented.generator (s).index) s;
\definition apex[i: Index]: Generator[degree] := Generator[degree] { index := i, simplex := (contractions).apex i };
\import Augmented.To[W := Carrier degree, target := space degree] \as ToChains;
\definition centre: Modules.Hom[V := Augmented.Carrier, W := Carrier degree, source := Augmented.space, target := space degree].Map :=
  ToChains.extension (\fun (i: Index) => generator degree (apex i));
\definition centreOnGenerator[i: Index]: (centre).apply (Augmented.generator i) = generator degree (apex i) :=
  ToChains.onGenerator (\fun (i: Index) => generator degree (apex i)) i;
\import Modules.Hom[V := Augmented.Carrier, W := Carrier degree, source := Augmented.space, target := space degree].Composition[U := Carrier degree, domain := space degree] \as Composition;
\definition projection: Modules.Hom[V := Carrier degree, W := Carrier degree, source := space degree, target := space degree].Map := Composition.compose centre augmentation;
\definition projectionOnGenerator[s: Generator[degree]]: (projection).apply (generator degree s) = generator degree (apex (s).index) :=
  trans!{{Carrier degree}} _ _ _ (congr!{{Augmented.Carrier} {Carrier degree}} ((centre).apply) _ _ (augmentationOnGenerator s)) (centreOnGenerator (s).index);
\module Component(i: Index) {
  \import \parent.\parent.\parent.Component[i := i] \as Local;
  \import Complexes.Map[C := Local.complex, D := complex] \as Inclusions;
  \import Modules.Hom[V := Local.Carrier degree, W := Carrier degree, source := Local.space degree, target := space degree] \as Included;
  \definition onGenerator[s: Local.Simplex degree]:
    (boundary degree).apply ((homotopy degree).apply (generator degree (Generator[degree] { index := i, simplex := s }))) =
      Group.difference (generator degree (Generator[degree] { index := i, simplex := s })) (generator degree (apex i)) :=
    eq_reason_in!{{Carrier degree} _
      "=" _ "by" { congr!{{Carrier (N.Nat^::succ degree)} {Carrier degree}} ((boundary degree).apply) _ _
        (\parent.\parent.Degree[n := degree].onGenerator (Generator[degree] { index := i, simplex := s })) }
      "=" _ "by" { (Local.inclusion).commutes degree (((contractions).homotopy i degree).apply (Local.generator degree s)) }
      "=" _ "by" { congr!{{Local.Carrier degree} {Carrier degree}} ((Local.inclusion).apply degree) _ _ ((contractions).zero i s) }
      "=" _ "by" { Included.differencePreserved (Inclusions.At[n := degree].linear Local.inclusion) (Local.generator degree s) (Local.generator degree ((contractions).apex i)) }
      "=" _ "by" { congr!{{Carrier degree} {Carrier degree} {Carrier degree}} Group.difference _ _ _ _
              (Local.onGenerator degree s) (Local.onGenerator degree ((contractions).apex i)) }
    };
}
\definition onGenerator: \forall (s: Generator[degree]) ->
  (boundary degree).apply ((homotopy degree).apply (generator degree s)) = Group.difference (generator degree s) (generator degree (apex (s).index)) :=
  \induction (s: Generator[degree]) \return
    (boundary degree).apply ((homotopy degree).apply (generator degree s)) = Group.difference (generator degree s) (generator degree (apex (s).index)) \with {
    | # : \fun (i: Index)(s: Simplex i degree) => Component[i := i].onGenerator s
  };
\import Modules.Hom[V := Carrier degree, W := Carrier degree, source := space degree, target := space degree] \as End;
\import Modules.End[V := Carrier degree, space := space degree] \as Identity;
\import Modules.Hom[V := Carrier (N.Nat^::succ degree), W := Carrier degree, source := space (N.Nat^::succ degree), target := space degree].Composition[U := Carrier degree, domain := space degree] \as After;
\import Modules.Free[Generators := Generator[degree]].To[W := Carrier degree, target := space degree] \as Free;
\definition equality: After.compose (boundary degree) (homotopy degree) = End.plus Identity.identity (End.negative projection) :=
  Free.ext _ _ (\fun (s: Generator[degree]) => trans!{{Carrier degree}} _ _ _ (onGenerator s)
    (congr!{{Carrier degree} {Carrier degree}} (Group.difference (generator degree s)) _ _ (sym!{{Carrier degree}} _ _ (projectionOnGenerator s))));
\definition law[x: Carrier degree]: (boundary degree).apply ((homotopy degree).apply x) = Group.difference x ((projection).apply x) :=
  congr!{{End.Map} {Carrier degree}} (\fun (f: End.Map) => (f).apply x) _ _ equality;
\import Modules.Hom[V := Augmented.Carrier, W := Carrier degree, source := Augmented.space, target := space degree] \as Centres;
\definition cycle[x: Carrier degree][reduced: (augmentation).apply x = (Augmented.space).zero]:
  (boundary degree).apply ((homotopy degree).apply x) = x :=
  eq_reason_in!{{Carrier degree} _
    "=" _ "by" { law x }
    "=" _ "by" { congr!{{Carrier degree} {Carrier degree}} (Group.difference x) _ _
        (trans!{{Carrier degree}} _ _ _ (congr!{{Augmented.Carrier} {Carrier degree}} ((centre).apply) _ _ reduced) (Centres.zeroPreserved centre)) }
    "=" _ "by" { congr!{{Carrier degree} {Carrier degree}} (Group.add x) _ _ Group.negZero }
    "=" _ "by" { Group.zeroRight x }
  };
\import Modules.Hom[V := Carrier degree, W := Augmented.Carrier, source := space degree, target := Augmented.space].Composition[U := Augmented.Carrier, domain := Augmented.space] \as AugmentAfter;
\import Modules.End[V := Augmented.Carrier, space := Augmented.space] \as ScalarIdentity;
\import Augmented.To[W := Augmented.Carrier, target := Augmented.space] \as AugmentedTo;
\definition split: AugmentAfter.compose augmentation centre = ScalarIdentity.identity :=
  AugmentedTo.ext _ _ (\fun (i: Index) => trans!{{Augmented.Carrier}} _ _ _
    (congr!{{Carrier degree} {Augmented.Carrier}} ((augmentation).apply) _ _ (centreOnGenerator i)) (augmentationOnGenerator (apex i)));
\definition section[x: Augmented.Carrier]: (augmentation).apply ((centre).apply x) = x :=
  congr!{{Modules.Hom[V := Augmented.Carrier, W := Augmented.Carrier, source := Augmented.space, target := Augmented.space].Map} {Augmented.Carrier}}
    (\fun (f: Modules.Hom[V := Augmented.Carrier, W := Augmented.Carrier, source := Augmented.space, target := Augmented.space].Map) => (f).apply x) _ _ split;
