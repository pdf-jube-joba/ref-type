\module HomAt(n: N.Nat^, z: I.Int^) {
  \import Modules.Hom[V := C.family.Carrier n, W := D.family.Carrier z, source := C.family.space n, target := D.family.space z] \as Maps;
  \import Commutative.HomSpace[V := C.family.Carrier n, W := D.family.Carrier z, source := C.family.space n, target := D.family.space z] \as HomSpace;
  \definition Carrier: \Set := Maps.Map;
  \definition space: Modules.Space Carrier := HomSpace.space;
  \definition ext: \forall (f, g: Carrier) -> (\forall (x: C.family.Carrier n) -> (f).apply x = (g).apply x) -> f = g := Maps.ext;
  \definition zeroPreserved: \forall (f: Carrier) -> (f).apply (C.family.space n).zero = (D.family.space z).zero := Maps.zeroPreserved;
  \import Modules.Of[V := Carrier, space := space].Submodule[] \as Submodules;
  \definition Submodule: \Set := Submodules.Submodule;
}
\module Boundary(n: N.Nat^, z: I.Int^) {
  \import \parent.HomAt[n := n, z := z] \as Source;
  \import \parent.HomAt[n := n, z := Degrees.previous z] \as Target;
  \definition value[f: Source.Carrier]: Target.Carrier := Target.Carrier {
    apply := \fun (x: C.family.Carrier n) => (D.differential).apply z ((f).apply x),
    addition := \fun (x, y: C.family.Carrier n) => trans!{{D.family.Carrier (Degrees.previous z)}} _ _ _
      (congr!{{D.family.Carrier z} {D.family.Carrier (Degrees.previous z)}} ((D.differential).apply z) _ _ ((f).addition x y))
      ((D.laws).addition z ((f).apply x) ((f).apply y)),
    scalar := \fun (a: I.Int^)(x: C.family.Carrier n) => trans!{{D.family.Carrier (Degrees.previous z)}} _ _ _
      (congr!{{D.family.Carrier z} {D.family.Carrier (Degrees.previous z)}} ((D.differential).apply z) _ _ ((f).scalar a x))
      ((D.laws).scalar z a ((f).apply x)),
  };
  \definition map: Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map :=
    Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map {
      apply := value,
      addition := \fun (f, g: Source.Carrier) =>
        Target.ext (value ((Source.space).add f g)) ((Target.space).add (value f) (value g))
          (\fun (x: C.family.Carrier n) => (D.laws).addition z ((f).apply x) ((g).apply x)),
      scalar := \fun (a: I.Int^)(f: Source.Carrier) =>
        Target.ext (value ((Source.space).smul a f)) ((Target.space).smul a (value f))
          (\fun (x: C.family.Carrier n) => (D.laws).scalar z a ((f).apply x)),
    };
}
\module Transition(n: N.Nat^, z: I.Int^) {
  \import \parent.HomAt[n := n, z := z] \as Source;
  \import \parent.HomAt[n := N.Nat^::succ n, z := z] \as Target;
  \definition value[f: Source.Carrier]: Target.Carrier := Target.Carrier {
    apply := \fun (x: C.family.Carrier (N.Nat^::succ n)) => (f).apply ((C.differential).apply n x),
    addition := \fun (x, y: C.family.Carrier (N.Nat^::succ n)) => trans!{{D.family.Carrier z}} _ _ _
      (congr!{{C.family.Carrier n} {D.family.Carrier z}} ((f).apply) _ _ ((C.laws).addition n x y))
      ((f).addition ((C.differential).apply n x) ((C.differential).apply n y)),
    scalar := \fun (a: I.Int^)(x: C.family.Carrier (N.Nat^::succ n)) => trans!{{D.family.Carrier z}} _ _ _
      (congr!{{C.family.Carrier n} {D.family.Carrier z}} ((f).apply) _ _ ((C.laws).scalar n a x))
      ((f).scalar a ((C.differential).apply n x)),
  };
  \definition map: Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map :=
    Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map {
      apply := value,
      addition := \fun (f, g: Source.Carrier) =>
        Target.ext (value ((Source.space).add f g)) ((Target.space).add (value f) (value g))
          (\fun (x: C.family.Carrier (N.Nat^::succ n)) => \refl((D.family.space z).add ((f).apply ((C.differential).apply n x)) ((g).apply ((C.differential).apply n x)))),
      scalar := \fun (a: I.Int^)(f: Source.Carrier) =>
        Target.ext (value ((Source.space).smul a f)) ((Target.space).smul a (value f))
          (\fun (x: C.family.Carrier (N.Nat^::succ n)) => \refl((D.family.space z).smul a ((f).apply ((C.differential).apply n x)))),
    };
}
\definition Supports: \Set := \forall (n: N.Nat^)(z: I.Int^) -> HomAt[n := n, z := z].Submodule;
\structure Closure[S: Supports]: \Prop := {
  boundary: \forall (n: N.Nat^)(z: I.Int^)(f: HomAt[n := n, z := z].Carrier) -> \In[HomAt[n := n, z := z].Carrier] (S n z).carrier f ->
    \In[HomAt[n := n, z := Degrees.previous z].Carrier] (S n (Degrees.previous z)).carrier (Boundary[n := n, z := z].value f),
  transition: \forall (n: N.Nat^)(z: I.Int^)(f: HomAt[n := n, z := z].Carrier) -> \In[HomAt[n := n, z := z].Carrier] (S n z).carrier f ->
    \In[HomAt[n := N.Nat^::succ n, z := z].Carrier] (S (N.Nat^::succ n) z).carrier (Transition[n := n, z := z].value f),
};
\module With(S: Supports, closed: Closure[S]);
