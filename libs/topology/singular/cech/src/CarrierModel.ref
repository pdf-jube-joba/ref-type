\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing] \as Commutative;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import chain_complexes.Chain[] \as Degrees;
\import Degrees.Over[R := I.Int^, ring := Integers.ring] \as Signed;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring].AcyclicDiagonal[] \as Acyclic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import std.Logic[].Proposition[] \as Logic;
\module On(C: Native.Complex, D: Signed.Complex);
