\import Doubles.Column[C := complex, q := N.Nat^::zero] \as Column;
\import Chains.Map[C := Column.complex, D := C] \as Forward;
\import Chains.Map[C := C, D := Column.complex] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (n: N.Nat^)(x: C.family.Carrier n) => x,
  addition := \fun (n: N.Nat^)(x, y: C.family.Carrier n) => \refl((C.family.space n).add x y),
  scalar := \fun (n: N.Nat^)(a: R)(x: C.family.Carrier n) => \refl((C.family.space n).smul a x),
  commutes := \fun (n: N.Nat^)(x: C.family.Carrier (N.Nat^::succ n)) => \refl((C.differential).apply n x),
};
\definition backward: Backward.Map := Backward.Map {
  apply := \fun (n: N.Nat^)(x: C.family.Carrier n) => x,
  addition := \fun (n: N.Nat^)(x, y: C.family.Carrier n) => \refl((C.family.space n).add x y),
  scalar := \fun (n: N.Nat^)(a: R)(x: C.family.Carrier n) => \refl((C.family.space n).smul a x),
  commutes := \fun (n: N.Nat^)(x: C.family.Carrier (N.Nat^::succ n)) => \refl((C.differential).apply n x),
};
\import Chains.Isomorphism[C := Column.complex, D := C] \as Compared;
\definition data: Compared.Data := Compared.Data { forward := forward, backward := backward };
\definition isomorphism: Compared.Isomorphism := \into[Compared.Data](data, { d: Compared.Data \where Compared.Laws[d] }) \by {
  Compared.Laws[data] {
    leftInverse := \fun (n: N.Nat^)(x: C.family.Carrier n) => \refl(x),
    rightInverse := \fun (n: N.Nat^)(x: C.family.Carrier n) => \refl(x),
  }
};
