\use std.Logic[].Equality[].eq_reason_in;
\module Degree(n: N.Nat^) {
  \import Modules.Of[V := C.family.Carrier n, space := C.family.space n].Submodule[] \as Submodules;
  \import Submodules.Kernel[W := D.family.Carrier n, target := D.family.space n] \as Kernels;
  \definition submodule: Submodules.Submodule := Kernels.kernel (Maps.At[n := n].linear f);
  \import Submodules.Of[S := submodule] \as Induced;
  \definition Carrier: \Set := Induced.Carrier;
  \definition space: Modules.Space Carrier := Induced.moduleSpace;
  \definition inclusion: Modules.Hom[V := Carrier, W := C.family.Carrier n, source := space, target := C.family.space n].Map := Induced.inclusion;
  \definition killed: \forall (x: Carrier) -> (f).apply n x = (D.family.space n).zero :=
    \fun (x: Carrier) => \bysub(C.family.Carrier n, (submodule).carrier, x);
  \definition intro[x: C.family.Carrier n][killed: (f).apply n x = (D.family.space n).zero]: Carrier :=
    \into[C.family.Carrier n](x, (submodule).carrier) \by { killed };
}
\definition Carrier[n: N.Nat^]: \Set := Degree[n := n].Carrier;
\definition space[n: N.Nat^]: Modules.Space (Carrier n) := Degree[n := n].space;
\definition family: Chains.Family := Chains.Family { Carrier := Carrier, space := space };
\module Boundary(n: N.Nat^) {
  \import Modules.Hom[V := Carrier (N.Nat^::succ n), W := Carrier n, source := space (N.Nat^::succ n), target := space n] \as Hom;
  \import Modules.Hom[V := D.family.Carrier (N.Nat^::succ n), W := D.family.Carrier n, source := D.family.space (N.Nat^::succ n), target := D.family.space n] \as TargetMaps;
  \definition targetDifferential: TargetMaps.Map := TargetMaps.Map {
    apply := (D.differential).apply n, addition := (D.laws).addition n, scalar := (D.laws).scalar n,
  };
  \definition killed: \forall (x: Carrier (N.Nat^::succ n)) ->
    (f).apply n ((C.differential).apply n x) = (D.family.space n).zero :=
    \fun (x: Carrier (N.Nat^::succ n)) => eq_reason_in!{{D.family.Carrier n} _
      "=" _ "by" { sym!{{D.family.Carrier n}} _ _ ((f).commutes n x) }
      "=" _ "by" { congr!{{D.family.Carrier (N.Nat^::succ n)} {D.family.Carrier n}} ((D.differential).apply n) _ _ (\parent.Degree[n := N.Nat^::succ n].killed x) }
      "=" _ "by" { TargetMaps.zeroPreserved targetDifferential }
    };
  \definition map: Hom.Map := Hom.Map {
    apply := \fun (x: Carrier (N.Nat^::succ n)) => \parent.Degree[n := n].intro ((C.differential).apply n x) (killed x),
    addition := \fun (x, y: Carrier (N.Nat^::succ n)) => (C.laws).addition n x y,
    scalar := \fun (a: R)(x: Carrier (N.Nat^::succ n)) => (C.laws).scalar n a x,
  };
}
\definition differential: Chains.DifferentialData[family] := Chains.DifferentialData[family] {
  apply := \fun (n: N.Nat^) => (Boundary[n := n].map).apply,
};
\definition complex: Chains.Complex := Chains.Complex {
  family := family, differential := differential,
  laws := Chains.DifferentialLaws[family, differential] {
    addition := \fun (n: N.Nat^) => (Boundary[n := n].map).addition,
    scalar := \fun (n: N.Nat^) => (Boundary[n := n].map).scalar,
    squareZero := \fun (n: N.Nat^)(x: Carrier (N.Nat^::succ (N.Nat^::succ n))) => (C.laws).squareZero n x,
  },
};
\import Chains.Map[C := complex, D := C] \as Inclusions;
\definition inclusion: Inclusions.Map := Inclusions.Map {
  apply := \fun (n: N.Nat^)(x: Carrier n) => x,
  addition := \fun (n: N.Nat^)(x, y: Carrier n) => \refl((C.family.space n).add x y),
  scalar := \fun (n: N.Nat^)(a: R)(x: Carrier n) => \refl((C.family.space n).smul a x),
  commutes := \fun (n: N.Nat^)(x: Carrier (N.Nat^::succ n)) => \refl((C.differential).apply n x),
};
\module Split(s: Sections, splits: Splits s);
\module Resolution(s: Sections, splits: Splits s);
