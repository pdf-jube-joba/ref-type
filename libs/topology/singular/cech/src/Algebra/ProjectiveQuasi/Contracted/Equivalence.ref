\import Chains.Equivalence[C := C, D := D] \as Compared;
\import Homotopies.Reverse[] \as Reverse;
\import Chains.Homotopy[C := D, D := D] \as TargetHomotopies;
\import TargetHomotopies.Reflexive[] \as Reflexive;
\definition left: Homotopies.Homotopy projection End.identity := Reverse.homotopy End.identity projection homotopy;
\definition right: TargetHomotopies.Homotopy TargetEnd.identity TargetEnd.identity := Reflexive.homotopy TargetEnd.identity;
\definition data: Compared.Data := Compared.Data {
  forward := f, backward := backward, left := left, right := right,
};
\definition laws: Compared.Laws[data] := Compared.Laws[data] {
  left := Homotopies.replacementLaws projection End.identity (LeftComposition.compose backward f) End.identity left
    (sym!{{SelfMaps.Map}} _ _ leftComposite) (\refl(End.identity))
    (\bysub(Homotopies.Data, Homotopies.Homotopy projection End.identity, left)),
  right := TargetHomotopies.replacementLaws TargetEnd.identity TargetEnd.identity (RightComposition.compose f backward) TargetEnd.identity right
    (sym!{{TargetMaps.Map}} _ _ rightComposite) (\refl(TargetEnd.identity))
    (\bysub(TargetHomotopies.Data, TargetHomotopies.Homotopy TargetEnd.identity TargetEnd.identity, right)),
};
\definition value: Compared.Equivalence := \into[Compared.Data](data, Compared.Equivalence) \by { laws };
