\use std.Logic[].Equality[].eq_reason_in;
\definition degree: I.Int^ := I.Int^::negSucc N.Nat^::zero;
\import \parent.At[z := degree] \as Current;
\import \parent.Zero[] \as ZeroDegree;
\import algebra.Group[].Of[Carrier := I.Int^, group := Modules.scalarGroup] \as Group;
\definition law: \forall (x: Carrier degree) -> Current.rightHand x = x :=
  \fun (x: Carrier degree) => eq_reason_in!{I.Int^ _
    "=" _ "by" { congr!{I.Int^ I.Int^ I.Int^} ((Modules.scalarModule).add) _ _ _ _
      (Transport.castRefl complex.family.Carrier degree ((Augmentation.map).apply ((ZeroDegree.section).apply x)))
      (Transport.castRefl complex.family.Carrier degree (Modules.scalarModule).zero) }
    "=" _ "by" { congr!{I.Int^ I.Int^} (\fun (y: I.Int^) => Group.add y Group.zero) _ _ (Augmentation.sectionLaw a x) }
    "=" _ "by" { Group.zeroRight x }
  };
