\use std.Logic[].Equality[].eq_reason_in;
\definition n: N.Nat^ := N.Nat^::zero;
\import \parent.\parent.Zero[] \as Calculation;
\import \parent.\parent.Shift[n := n] \as Shift;
\import Modules.Hom[V := Natural.Carrier n, W := Natural.Carrier n, source := Natural.space n, target := Natural.space n] \as EndMaps;
\import Modules.Hom[V := Natural.Carrier (N.Nat^::succ n), W := Natural.Carrier n, source := Natural.space (N.Nat^::succ n), target := Natural.space n].Composition[U := Natural.Carrier n, domain := Natural.space n] \as Compose;
\definition boundaryMap: EndMaps.Map := Compose.compose (Natural.boundary n) Shift.map;
\import Modules.Free[Generators := Simplices.Carrier n].To[W := Natural.Carrier n, target := Natural.space n] \as Extension;
\definition zeroBoundary: Unique -> boundaryMap = EndMaps.zeroMap := \fun (unique: Unique) => Extension.ext boundaryMap EndMaps.zeroMap (Calculation.upper unique);
\definition boundary: Unique -> \forall (x: Natural.Carrier n) -> (boundaryMap).apply x = (Natural.space n).zero :=
  \fun (unique: Unique)(x: Natural.Carrier n) => congr!{EndMaps.Map {Natural.Carrier n}} (\fun (f: EndMaps.Map) => (f).apply x) _ _ (zeroBoundary unique);
\import Modules.Laws[V := Natural.Carrier n, space := Natural.space n] \as Vector;
\import algebra.Group[].Of[Carrier := Natural.Carrier n, group := Vector.additive] \as Group;
\definition law: Unique -> \forall (x: Natural.Carrier n) -> (projection).apply n x = x :=
  \fun (unique: Unique)(x: Natural.Carrier n) => eq_reason_in!{{Natural.Carrier n} _
    "=" _ "by" { congr!{{Natural.Carrier n} {Natural.Carrier n}} (Group.difference x) _ _ (boundary unique x) }
    "=" _ "by" { congr!{{Natural.Carrier n} {Natural.Carrier n}} (Vector.add x) _ _ Group.negZero }
    "=" _ "by" { Group.zeroRight x }
  };
