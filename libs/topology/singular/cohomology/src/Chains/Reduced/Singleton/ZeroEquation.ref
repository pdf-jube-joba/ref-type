\definition degree: I.Int^ := I.Int^::ofNat N.Nat^::zero;
\import \parent.At[z := degree] \as Current;
\import \parent.Shift[n := N.Nat^::zero] \as Shift;
\import \parent.Zero[] \as ZeroDegree;
\definition law: Unique -> \forall (x: Carrier degree) -> Current.rightHand x = x :=
  \fun (unique: Unique)(x: Carrier degree) => trans!{{Carrier degree}} _ _ _
    (congr!{{Carrier degree} {Carrier degree} {Carrier degree}} ((space degree).add) _ _ _ _
      (Transport.castRefl complex.family.Carrier degree ((Natural.boundary N.Nat^::zero).apply ((Shift.map).apply x)))
      (Transport.castRefl complex.family.Carrier degree ((ZeroDegree.section).apply ((Augmentation.map).apply x))))
    (ZeroDegree.law unique x);
