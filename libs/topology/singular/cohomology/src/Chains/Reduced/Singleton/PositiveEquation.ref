\definition degree: I.Int^ := I.Int^::ofNat (N.Nat^::succ n);
\import \parent.At[z := degree] \as Current;
\import \parent.Shift[n := N.Nat^::succ n] \as Upper;
\import \parent.Shift[n := n] \as Lower;
\definition law: Unique -> \forall (x: Carrier degree) -> Current.rightHand x = x :=
  \fun (unique: Unique)(x: Carrier degree) => trans!{{Carrier degree}} _ _ _
    (congr!{{Carrier degree} {Carrier degree} {Carrier degree}} ((space degree).add) _ _ _ _
      (Transport.castRefl complex.family.Carrier degree ((Natural.boundary (N.Nat^::succ n)).apply ((Upper.map).apply x)))
      (Transport.castRefl complex.family.Carrier degree ((Lower.map).apply ((Natural.boundary n).apply x))))
    (\parent.Positive[n := n].law unique x);
