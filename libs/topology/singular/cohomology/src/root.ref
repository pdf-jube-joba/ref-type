\module Simplices(A: \Set, source: topology.Topology[Carrier := A].Topology);
\module Chains(A: \Set, source: topology.Topology[Carrier := A].Topology);
\module Maps(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology);
\module Cochains(A: \Set, source: topology.Topology[Carrier := A].Topology);
\module Relative(A: \Set, source: topology.Topology[Carrier := A].Topology, subset: \Pow A);
\module Calculations(A: \Set, source: topology.Topology[Carrier := A].Topology);
\module Identity(A: \Set, source: topology.Topology[Carrier := A].Topology);
\module OrderedTuples(V: \Set);
\module Coefficients(A: \Set, source: topology.Topology[Carrier := A].Topology);
\module Zero(A: \Set, source: topology.Topology[Carrier := A].Topology);
\module CylinderChains(n: std.Data[].Nat[].Nat^);
\module Homotopy(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology);
\module Equivalence(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology);
\module SimplicialChains;
