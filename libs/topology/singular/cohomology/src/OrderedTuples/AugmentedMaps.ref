\structure Data: \Set := {
  component: \forall (n: N.Nat^) -> Modules.Hom[V := Carrier n, W := Carrier n, source := space n, target := space n].Map,
};
\structure Laws[data: Data]: \Prop := {
  commutes: \forall (n: N.Nat^)(x: Carrier (N.Nat^::succ n)) ->
    (boundary n).apply ((data.component (N.Nat^::succ n)).apply x) = (data.component n).apply ((boundary n).apply x),
  empty: \forall (x: Carrier N.Nat^::zero) -> (data.component N.Nat^::zero).apply x = x,
};
\definition Map: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module On(f: Map) {
  \import Complexes.Map[C := complex, D := complex] \as Native;
  \definition chainMap: Native.Map := Native.Map {
    apply := \fun (n: N.Nat^) => (f.component (N.Nat^::succ n)).apply,
    addition := \fun (n: N.Nat^) => (f.component (N.Nat^::succ n)).addition,
    scalar := \fun (n: N.Nat^) => (f.component (N.Nat^::succ n)).scalar,
    commutes := \fun (n: N.Nat^) => (f).commutes (N.Nat^::succ n),
  };
}
\module Homotopy(f, g: Map);
