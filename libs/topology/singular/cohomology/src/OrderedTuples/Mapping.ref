\import \root.OrderedTuples[V := V] \as Domain;
\import \root.OrderedTuples[V := W] \as Codomain;
\import Fin.Tuples[A := V].Mapping[B := W] \as TupleMaps;
\import Fin.Tuples[A := W].Omission[] \as TargetOmission;
\definition onTuple[n: N.Nat^][f: V -> W][v: Domain.Tuple n]: Codomain.Tuple n := \fun (i: Fin.Fin n) => f (v i);
\module At(n: N.Nat^) {
  \import Modules.Free[Generators := Domain.Tuple n].Reindex[TargetGenerators := Codomain.Tuple n] \as Reindex;
  \definition push[f: V -> W]: Modules.Hom[V := Domain.Carrier n, W := Codomain.Carrier n, source := Domain.space n, target := Codomain.space n].Map :=
    Reindex.push (onTuple n f);
  \definition onGenerator: \forall (f: V -> W)(v: Domain.Tuple n) -> (push f).apply (Domain.generator n v) = Codomain.generator n (onTuple n f v) :=
    \fun (f: V -> W) => Reindex.onGenerator (onTuple n f);
}
\definition push[n: N.Nat^][f: V -> W]: Modules.Hom[V := Domain.Carrier n, W := Codomain.Carrier n, source := Domain.space n, target := Codomain.space n].Map := At[n := n].push f;
\definition faceNaturality: \forall (n: N.Nat^)(f: V -> W)(i: Fin.Fin (N.Nat^::succ n))(v: Domain.Tuple (N.Nat^::succ n)) ->
  onTuple n f (Omission.omit n i v) = TargetOmission.omit n i (onTuple (N.Nat^::succ n) f v) := \fun (n: N.Nat^)(f: V -> W)(i: Fin.Fin (N.Nat^::succ n))(v: Domain.Tuple (N.Nat^::succ n)) => TupleMaps.omitMap n i f v;
\module Boundary(n: N.Nat^);
\module Cone(n: N.Nat^);
\definition map[f: V -> W]: Complexes.Map[C := Domain.complex, D := Codomain.complex].Map := Complexes.Map[C := Domain.complex, D := Codomain.complex].Map {
  apply := \fun (n: N.Nat^) => (push (N.Nat^::succ n) f).apply,
  addition := \fun (n: N.Nat^) => (push (N.Nat^::succ n) f).addition,
  scalar := \fun (n: N.Nat^) => (push (N.Nat^::succ n) f).scalar,
  commutes := \fun (n: N.Nat^) => Boundary[n := N.Nat^::succ n].commutes f,
};
\module DegreeTransport;
