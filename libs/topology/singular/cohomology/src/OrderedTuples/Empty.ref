\use std.Logic[].Equality[].eq_reason_in;
\import Fin.Empty[A := V] \as EmptyTuples;
\import Modules.Laws[V := Carrier N.Nat^::zero, space := space N.Nat^::zero] \as Values;
\import algebra.Group[].Of[Carrier := Carrier N.Nat^::zero, group := Values.additive] \as Group;
\import Modules.Free[Generators := Tuple N.Nat^::zero].To[W := Carrier N.Nat^::zero, target := space N.Nat^::zero] \as Free;
\import Modules.Hom[V := Carrier (N.Nat^::succ N.Nat^::zero), W := Carrier N.Nat^::zero,
  source := space (N.Nat^::succ N.Nat^::zero), target := space N.Nat^::zero]
  .Composition[U := Carrier N.Nat^::zero, domain := space N.Nat^::zero] \as Composition;
\import Modules.End[V := Carrier N.Nat^::zero, space := space N.Nat^::zero] \as Identity;
\definition onGenerator: \forall (a: V)(v: Tuple N.Nat^::zero) ->
  (boundary N.Nat^::zero).apply ((cone N.Nat^::zero a).apply (generator N.Nat^::zero v)) = generator N.Nat^::zero v :=
  \fun (a: V)(v: Tuple N.Nat^::zero) => eq_reason_in!{{Carrier N.Nat^::zero} _
    "=" _ "by" { congr!{{Carrier (N.Nat^::succ N.Nat^::zero)} {Carrier N.Nat^::zero}} ((boundary N.Nat^::zero).apply) _ _ (\parent.Cone[n := N.Nat^::zero].onGenerator a v) }
    "=" _ "by" { \parent.Boundary[n := N.Nat^::zero].onGenerator (Tuples.extend N.Nat^::zero a v) }
    "=" _ "by" { congr!{{Carrier N.Nat^::zero} {Carrier N.Nat^::zero} {Carrier N.Nat^::zero}} Values.add _ _ _ _
          (congr!{{Tuple N.Nat^::zero} {Carrier N.Nat^::zero}} (generator N.Nat^::zero) _ _ (EmptyTuples.unique _ v)) Group.negZero }
    "=" _ "by" { Group.zeroRight (generator N.Nat^::zero v) }
  };
\definition equation: \forall (a: V) -> Composition.compose (boundary N.Nat^::zero) (cone N.Nat^::zero a) = Identity.identity :=
  \fun (a: V) => Free.ext _ _ (onGenerator a);
\import Modules.Hom[V := Carrier N.Nat^::zero, W := Carrier N.Nat^::zero, source := space N.Nat^::zero, target := space N.Nat^::zero] \as End;
\definition coneBoundary: \forall (a: V)(x: Carrier N.Nat^::zero) -> (boundary N.Nat^::zero).apply ((cone N.Nat^::zero a).apply x) = x :=
  \fun (a: V)(x: Carrier N.Nat^::zero) => congr!{End.Map {Carrier N.Nat^::zero}} (\fun (f: End.Map) => (f).apply x) _ _ (equation a);
