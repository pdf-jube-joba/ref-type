\import Domain.DegreeTransport[] \as SourceDegree;
\import Codomain.DegreeTransport[] \as TargetDegree;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition law: \forall (m, n: N.Nat^)(same: m = n)(f: V -> W)(x: Domain.Carrier m) ->
  TargetDegree.apply m n same ((push m f).apply x) = (push n f).apply (SourceDegree.apply m n same x) :=
  \fun (m, n: N.Nat^)(same: m = n)(f: V -> W) =>
    Transport.natural Domain.Carrier Codomain.Carrier (\fun (k: N.Nat^) => (push k f).apply) m n same;
