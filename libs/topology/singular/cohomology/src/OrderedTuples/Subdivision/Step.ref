\use std.Logic[].Equality[].eq_reason_in;
\import \parent.At[n := N.Nat^::succ n] \as Degree;
\import \root.OrderedTuples[V := V].Subdivision[centres := centres] \as Construction;
\import \parent.\parent.ConeBoundary[n := n] \as ConeBoundary;
\import \parent.\parent.SquareZero[n := n] \as SquareZero;
\import Modules.Laws[V := Carrier (N.Nat^::succ n), space := space (N.Nat^::succ n)] \as Values;
\import algebra.Group[].Of[Carrier := Carrier (N.Nat^::succ n), group := Values.additive] \as Group;
\import Modules.Hom[V := Carrier n, W := Carrier n, source := space n, target := space n] \as Lower;
\import Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)] \as Cone;
\definition onGenerator: Property n -> Degree.OnGenerators :=
  \fun (previous: Property n)(v: Tuple (N.Nat^::succ (N.Nat^::succ n))) => \block {
    \let a: V := centres (N.Nat^::succ n) v \then
    \let d: Carrier (N.Nat^::succ n) := (boundary (N.Nat^::succ n)).apply (generator (N.Nat^::succ (N.Nat^::succ n)) v) \then
    \let sd: Carrier (N.Nat^::succ n) := (map (N.Nat^::succ n)).apply d \then
    \let cycle: (boundary n).apply sd = (space n).zero := eq_reason_in!{{Carrier n} _
      "=" _ "by" { previous d }
      "=" _ "by" { congr!{{Carrier n} {Carrier n}} ((map n).apply) _ _ (SquareZero.all (generator (N.Nat^::succ (N.Nat^::succ n)) v)) }
      "=" _ "by" { Lower.zeroPreserved (map n) }
    } \then
    \return eq_reason_in!{{Carrier (N.Nat^::succ n)} _
      "=" _ "by" { congr!{{Carrier (N.Nat^::succ (N.Nat^::succ n))} {Carrier (N.Nat^::succ n)}} ((boundary (N.Nat^::succ n)).apply) _ _ (Construction.onGenerator (N.Nat^::succ (N.Nat^::succ n)) v) }
      "=" _ "by" { ConeBoundary.law a sd }
      "=" _ "by" { congr!{{Carrier n} {Carrier (N.Nat^::succ n)}} (\fun (x: Carrier n) => Group.difference sd ((cone n a).apply x)) _ _ cycle }
      "=" _ "by" { congr!{{Carrier (N.Nat^::succ n)} {Carrier (N.Nat^::succ n)}} (Group.difference sd) _ _ (Cone.zeroPreserved (cone n a)) }
      "=" _ "by" { congr!{{Carrier (N.Nat^::succ n)} {Carrier (N.Nat^::succ n)}} (Values.add sd) _ _ Group.negZero }
      "=" _ "by" { Group.zeroRight sd }
    }
  };
\definition law: Property n -> Property (N.Nat^::succ n) := \fun (previous: Property n) => Degree.extend (onGenerator previous);
