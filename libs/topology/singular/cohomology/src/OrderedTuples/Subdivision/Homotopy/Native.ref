\use std.Logic[].Equality[].eq_reason_in;
\import Complexes.Homotopy[C := complex, D := complex] \as Native;
\import Complexes.End[C := complex] \as Identity;
\import \parent.Empty[] \as Empty;
\definition data: Native.Data := Native.Data { apply := \fun (n: N.Nat^) => (map (N.Nat^::succ n)).apply };
\import \parent.Values[n := N.Nat^::succ N.Nat^::zero] \as Values;
\definition zero: \forall (x: Carrier (N.Nat^::succ N.Nat^::zero)) -> Values.difference ((Subdivision.map (N.Nat^::succ N.Nat^::zero)).apply x) x =
  (boundary (N.Nat^::succ N.Nat^::zero)).apply ((map (N.Nat^::succ N.Nat^::zero)).apply x) :=
  \fun (x: Carrier (N.Nat^::succ N.Nat^::zero)) => sym!{{Carrier (N.Nat^::succ N.Nat^::zero)}} _ _
    (eq_reason_in!{{Carrier (N.Nat^::succ N.Nat^::zero)} _
      "=" _ "by" { boundaryLaw N.Nat^::zero x }
      "=" _ "by" { congr!{{Carrier (N.Nat^::succ N.Nat^::zero)} {Carrier (N.Nat^::succ N.Nat^::zero)}} (Values.difference (Values.difference ((Subdivision.map (N.Nat^::succ N.Nat^::zero)).apply x) x)) _ _ (Empty.zero ((boundary N.Nat^::zero).apply x)) }
      "=" _ "by" { Values.minusZero (Values.difference ((Subdivision.map (N.Nat^::succ N.Nat^::zero)).apply x) x) }
    });
\module Degree(n: N.Nat^) {
  \import \parent.\parent.Values[n := N.Nat^::succ (N.Nat^::succ n)] \as Values;
  \definition equation: \forall (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) ->
    Values.difference ((Subdivision.map (N.Nat^::succ (N.Nat^::succ n))).apply x) x =
      Values.add ((boundary (N.Nat^::succ (N.Nat^::succ n))).apply ((map (N.Nat^::succ (N.Nat^::succ n))).apply x))
        ((map (N.Nat^::succ n)).apply ((boundary (N.Nat^::succ n)).apply x)) :=
    \fun (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) => sym!{{Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _
      (trans!{{Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
        (congr!{{Carrier (N.Nat^::succ (N.Nat^::succ n))} {Carrier (N.Nat^::succ (N.Nat^::succ n))}}
          (\fun (z: Carrier (N.Nat^::succ (N.Nat^::succ n))) => Values.add z ((map (N.Nat^::succ n)).apply ((boundary (N.Nat^::succ n)).apply x))) _ _ (boundaryLaw (N.Nat^::succ n) x))
        (Values.addDifference (Values.difference ((Subdivision.map (N.Nat^::succ (N.Nat^::succ n))).apply x) x)
          ((map (N.Nat^::succ n)).apply ((boundary (N.Nat^::succ n)).apply x))));
}
\definition homotopy: Native.Homotopy Subdivision.chainMap Identity.identity :=
  \into[Native.Data](data, Native.Homotopy Subdivision.chainMap Identity.identity) \by {
    Native.Laws[Subdivision.chainMap, Identity.identity, data] {
      addition := \fun (n: N.Nat^) => (map (N.Nat^::succ n)).addition,
      scalar := \fun (n: N.Nat^) => (map (N.Nat^::succ n)).scalar,
      zeroEquation := zero,
      successorEquation := \fun (n: N.Nat^) => Degree[n := n].equation,
    }
  };
