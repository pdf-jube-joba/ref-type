\use std.Logic[].Equality[].eq_reason_in;
\import \root.OrderedTuples[V := V].ConeBoundary[n := n] \as ConeBoundary;
\import \parent.Values[n := N.Nat^::succ n] \as Values;
\import Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)] \as Linear;
\definition law: \forall (a: V)(w: Carrier (N.Nat^::succ n)) -> (boundary n).apply w = (space n).zero ->
  (boundary (N.Nat^::succ n)).apply ((cone (N.Nat^::succ n) a).apply w) = w :=
  \fun (a: V)(w: Carrier (N.Nat^::succ n))(closed: (boundary n).apply w = (space n).zero) =>
    eq_reason_in!{{Carrier (N.Nat^::succ n)} _
      "=" _ "by" { ConeBoundary.law a w }
      "=" _ "by" { congr!{{Carrier n} {Carrier (N.Nat^::succ n)}} (\fun (x: Carrier n) => Values.difference w ((cone n a).apply x)) _ _ closed }
      "=" _ "by" { congr!{{Carrier (N.Nat^::succ n)} {Carrier (N.Nat^::succ n)}} (Values.difference w) _ _ (Linear.zeroPreserved (cone n a)) }
      "=" _ "by" { Values.minusZero w }
    };
