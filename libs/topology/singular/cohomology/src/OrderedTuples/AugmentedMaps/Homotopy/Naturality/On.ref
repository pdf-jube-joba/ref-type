\use std.Logic[].Equality[].eq_reason_in;
\import Codomain.AugmentedMaps[].Homotopy[f := targetFirst, g := targetSecond] \as Other;
\definition vertices: V -> W := square.vertices;
\definition Property[n: N.Nat^]: \Prop := \forall (x: Carrier n) ->
  (Mapping.push (N.Nat^::succ n) vertices).apply ((map n).apply x) = (Other.map n).apply ((Mapping.push n vertices).apply x);
\module At(n: N.Nat^) {
  \import Modules.Hom[V := Carrier (N.Nat^::succ n), W := Codomain.Carrier (N.Nat^::succ n), source := space (N.Nat^::succ n), target := Codomain.space (N.Nat^::succ n)].Composition[U := Carrier n, domain := space n] \as First;
  \import Modules.Hom[V := Codomain.Carrier n, W := Codomain.Carrier (N.Nat^::succ n), source := Codomain.space n, target := Codomain.space (N.Nat^::succ n)].Composition[U := Carrier n, domain := space n] \as Second;
  \import Modules.Free[Generators := Tuple n].To[W := Codomain.Carrier (N.Nat^::succ n), target := Codomain.space (N.Nat^::succ n)] \as Free;
  \import Modules.Hom[V := Carrier n, W := Codomain.Carrier (N.Nat^::succ n), source := space n, target := Codomain.space (N.Nat^::succ n)] \as Maps;
  \definition OnValues: \Prop := \forall (v: Tuple n) ->
    (Mapping.push (N.Nat^::succ n) vertices).apply (value n v) = Other.value n (Mapping.onTuple n vertices v);
  \definition extend: OnValues -> Property n := \block {
    \fun (values: OnValues) \then
    \let same: First.compose (Mapping.push (N.Nat^::succ n) vertices) (map n) = Second.compose (Other.map n) (Mapping.push n vertices) :=
      Free.ext _ _ (\fun (v: Tuple n) => eq_reason_in!{{Codomain.Carrier (N.Nat^::succ n)} _
        "=" _ "by" { congr!{{Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)}} ((Mapping.push (N.Nat^::succ n) vertices).apply) _ _ (onGenerator n v) }
        "=" _ "by" { values v }
        "=" _ "by" { sym!{{Codomain.Carrier (N.Nat^::succ n)}} _ _ (Other.onGenerator n (Mapping.onTuple n vertices v)) }
        "=" _ "by" { congr!{{Codomain.Carrier n} {Codomain.Carrier (N.Nat^::succ n)}} ((Other.map n).apply) _ _ (sym!{{Codomain.Carrier n}} _ _ (Mapping.At[n := n].onGenerator vertices v)) }
      }) \then
    \return \fun (x: Carrier n) => congr!{Maps.Map {Codomain.Carrier (N.Nat^::succ n)}} (\fun (arrow: Maps.Map) => (arrow).apply x) _ _ same
  };
}
\module Step(n: N.Nat^);
\import Modules.Hom[V := Carrier (N.Nat^::succ N.Nat^::zero), W := Codomain.Carrier (N.Nat^::succ N.Nat^::zero), source := space (N.Nat^::succ N.Nat^::zero), target := Codomain.space (N.Nat^::succ N.Nat^::zero)] \as ZeroMaps;
\definition law: \forall (n: N.Nat^) -> Property n :=
  \induction (n: N.Nat^) \return Property n \with {
    | zero: At[n := N.Nat^::zero].extend (\fun (v: Tuple N.Nat^::zero) => ZeroMaps.zeroPreserved (Mapping.push (N.Nat^::succ N.Nat^::zero) vertices))
    | succ: \fun (n: N.Nat^)(previous: Property n) => At[n := N.Nat^::succ n].extend (Step[n := n].law previous)
  };
