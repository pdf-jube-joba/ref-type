\import Modules.Hom[V := Carrier N.Nat^::zero, W := Carrier (N.Nat^::succ N.Nat^::zero), source := space N.Nat^::zero, target := space (N.Nat^::succ N.Nat^::zero)] \as Linear;
\import Modules.Free[Generators := Tuple N.Nat^::zero].To[W := Carrier (N.Nat^::succ N.Nat^::zero), target := space (N.Nat^::succ N.Nat^::zero)] \as Shift;
\definition equation: map N.Nat^::zero = Linear.zeroMap := Shift.ext _ _ (onGenerator N.Nat^::zero);
\definition zero: \forall (x: Carrier N.Nat^::zero) -> (map N.Nat^::zero).apply x = (space (N.Nat^::succ N.Nat^::zero)).zero :=
  \fun (x: Carrier N.Nat^::zero) => congr!{Linear.Map {Carrier (N.Nat^::succ N.Nat^::zero)}} (\fun (f: Linear.Map) => (f).apply x) _ _ equation;
