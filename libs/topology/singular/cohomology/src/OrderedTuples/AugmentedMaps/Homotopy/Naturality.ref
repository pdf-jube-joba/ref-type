\import \root.OrderedTuples[V := V] \as Domain;
\import \root.OrderedTuples[V := W] \as Codomain;
\import Domain.Mapping[W := W] \as Mapping;
\structure Data: \Set := { vertices: V -> W };
\structure Laws[data: Data]: \Prop := {
  first: \forall (n: N.Nat^)(x: Domain.Carrier n) ->
    (Mapping.push n data.vertices).apply ((f.component n).apply x) = (targetFirst.component n).apply ((Mapping.push n data.vertices).apply x),
  second: \forall (n: N.Nat^)(x: Domain.Carrier n) ->
    (Mapping.push n data.vertices).apply ((g.component n).apply x) = (targetSecond.component n).apply ((Mapping.push n data.vertices).apply x),
};
\definition Square: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module On(square: Square);
