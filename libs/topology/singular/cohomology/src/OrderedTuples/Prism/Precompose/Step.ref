\import \parent.\parent.Values[n := N.Nat^::succ n] \as Values;
\definition law: Property n -> Property (N.Nat^::succ n) :=
  \fun (previous: Property n)(f, g: V -> W)(k: U -> V)(v: Source.Tuple (N.Nat^::succ n)) =>
    congr!{{Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))}}
      ((Codomain.cone (N.Nat^::succ n) (f (k (v (Fin.zero n))))).apply) _ _
      (congr!{{Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)}}
        (Values.difference (Codomain.generator (N.Nat^::succ n) (\fun (i: Fin.Fin (N.Nat^::succ n)) => g (k (v i))))) _ _
        (previous f g k (\fun (i: Fin.Fin n) => v (Fin.succ n i))));
