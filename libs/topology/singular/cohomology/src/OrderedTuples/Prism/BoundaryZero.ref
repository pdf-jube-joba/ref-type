\use std.Logic[].Equality[].eq_reason_in;
\definition zeroDegree: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zeroDegree;
\definition two: N.Nat^ := N.Nat^::succ one;
\import \parent.Values[n := one] \as Values;
\import \parent.Empty[] \as Empty;
\import \parent.Extended[n := zeroDegree] \as Recurrence;
\definition onCone: \forall (f, g: V -> W)(a: V)(x: Domain.Carrier zeroDegree) ->
  (Codomain.boundary one).apply ((map one f g).apply ((Domain.cone zeroDegree a).apply x)) =
    Values.difference ((Mapping.push one g).apply ((Domain.cone zeroDegree a).apply x))
      ((Mapping.push one f).apply ((Domain.cone zeroDegree a).apply x)) :=
  \fun (f, g: V -> W)(a: V)(x: Domain.Carrier zeroDegree) => \block {
    \let u: Domain.Carrier one := (Domain.cone zeroDegree a).apply x \then
    \let v: Codomain.Carrier one := (Mapping.push one g).apply u \then
    \let pointValue: (map one f g).apply u = (Codomain.cone one (f a)).apply v :=
      trans!{{Codomain.Carrier two}} _ _ _ (Recurrence.law f g a x)
        (congr!{{Codomain.Carrier one} {Codomain.Carrier two}} ((Codomain.cone one (f a)).apply) _ _
          (trans!{{Codomain.Carrier one}} _ _ _
            (congr!{{Codomain.Carrier one} {Codomain.Carrier one}} (Values.difference v) _ _ (Empty.zero f g x)) (Values.minusZero v))) \then
    \let dValue: (Codomain.boundary zeroDegree).apply v = (Mapping.push zeroDegree g).apply x :=
      trans!{{Codomain.Carrier zeroDegree}} _ _ _ (Mapping.Boundary[n := zeroDegree].commutes g u)
        (congr!{{Domain.Carrier zeroDegree} {Codomain.Carrier zeroDegree}} ((Mapping.push zeroDegree g).apply) _ _ (Domain.Empty[].coneBoundary a x)) \then
    \let coneValue: (Codomain.cone zeroDegree (f a)).apply ((Codomain.boundary zeroDegree).apply v) = (Mapping.push one f).apply u :=
      eq_reason_in!{{Codomain.Carrier one} _
        "=" _ "by" { congr!{{Codomain.Carrier zeroDegree} {Codomain.Carrier one}} ((Codomain.cone zeroDegree (f a)).apply) _ _ dValue }
        "=" _ "by" { congr!{{Codomain.Carrier zeroDegree} {Codomain.Carrier one}} ((Codomain.cone zeroDegree (f a)).apply) _ _ (Empty.onEmpty g f x) }
        "=" _ "by" { sym!{{Codomain.Carrier one}} _ _ (Mapping.Cone[n := zeroDegree].law f a x) }
      } \then
    \return eq_reason_in!{{Codomain.Carrier one} _
      "=" _ "by" { congr!{{Codomain.Carrier two} {Codomain.Carrier one}} ((Codomain.boundary one).apply) _ _ pointValue }
      "=" _ "by" { Codomain.ConeBoundary[n := zeroDegree].law (f a) v }
      "=" _ "by" { congr!{{Codomain.Carrier one} {Codomain.Carrier one}} (Values.difference v) _ _ coneValue }
    }
  };
\definition onGenerator: \forall (f, g: V -> W)(v: Domain.Tuple one) ->
  (Codomain.boundary one).apply ((map one f g).apply (Domain.generator one v)) =
    Values.difference ((Mapping.push one g).apply (Domain.generator one v)) ((Mapping.push one f).apply (Domain.generator one v)) :=
  \fun (f, g: V -> W)(v: Domain.Tuple one) =>
    \idelim (Domain.cone zeroDegree (v (Fin.zero zeroDegree))).apply (Domain.generator zeroDegree (\fun (i: Fin.Fin zeroDegree) => v (Fin.succ zeroDegree i))) = Domain.generator one v
      \with x: Domain.Carrier one => (Codomain.boundary one).apply ((map one f g).apply x) = Values.difference ((Mapping.push one g).apply x) ((Mapping.push one f).apply x) \by {
        base: onCone f g (v (Fin.zero zeroDegree)) (Domain.generator zeroDegree (\fun (i: Fin.Fin zeroDegree) => v (Fin.succ zeroDegree i))),
        equality: trans!{{Domain.Carrier one}} _ _ _ (Domain.Cone[n := zeroDegree].onGenerator (v (Fin.zero zeroDegree)) (\fun (i: Fin.Fin zeroDegree) => v (Fin.succ zeroDegree i)))
          (congr!{{Domain.Tuple one} {Domain.Carrier one}} (Domain.generator one) _ _ (Tuples.recover zeroDegree v))
      };
\import Modules.Hom[V := Codomain.Carrier two, W := Codomain.Carrier one, source := Codomain.space two, target := Codomain.space one]
  .Composition[U := Domain.Carrier one, domain := Domain.space one] \as Composition;
\import Modules.Hom[V := Domain.Carrier one, W := Codomain.Carrier one, source := Domain.space one, target := Codomain.space one] \as Maps;
\import Modules.Free[Generators := Domain.Tuple one].To[W := Codomain.Carrier one, target := Codomain.space one] \as Free;
\definition equation: \forall (f, g: V -> W) -> Composition.compose (Codomain.boundary one) (map one f g) = Maps.plus (Mapping.push one g) (Maps.negative (Mapping.push one f)) :=
  \fun (f, g: V -> W) => Free.ext _ _ (onGenerator f g);
\definition withoutPrior: \forall (f, g: V -> W)(x: Domain.Carrier one) ->
  (Codomain.boundary one).apply ((map one f g).apply x) = Values.difference ((Mapping.push one g).apply x) ((Mapping.push one f).apply x) :=
  \fun (f, g: V -> W)(x: Domain.Carrier one) => congr!{Maps.Map {Codomain.Carrier one}} (\fun (h: Maps.Map) => (h).apply x) _ _ (equation f g);
\definition law: \forall (f, g: V -> W)(x: Domain.Carrier one) ->
  (Codomain.boundary one).apply ((map one f g).apply x) = Values.difference
    (Values.difference ((Mapping.push one g).apply x) ((Mapping.push one f).apply x)) ((map zeroDegree f g).apply ((Domain.boundary zeroDegree).apply x)) :=
  \fun (f, g: V -> W)(x: Domain.Carrier one) => trans!{{Codomain.Carrier one}} _ _ _ (withoutPrior f g x)
    (sym!{{Codomain.Carrier one}} _ _ (trans!{{Codomain.Carrier one}} _ _ _
      (congr!{{Codomain.Carrier one} {Codomain.Carrier one}} (Values.difference (Values.difference ((Mapping.push one g).apply x) ((Mapping.push one f).apply x))) _ _ (Empty.zero f g ((Domain.boundary zeroDegree).apply x)))
      (Values.minusZero (Values.difference ((Mapping.push one g).apply x) ((Mapping.push one f).apply x)))));
