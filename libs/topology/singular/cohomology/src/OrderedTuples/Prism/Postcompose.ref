\use std.Logic[].Equality[].eq_reason_in;
\import \root.OrderedTuples[V := U] \as Final;
\import Codomain.Mapping[W := U] \as After;
\import Domain.Prism[W := U] \as Other;
\import Fin.Tuples[A := U] \as FinalTuples;
\definition Property[n: N.Nat^]: \Prop := \forall (f, g: V -> W)(h: W -> U)(v: Domain.Tuple n) ->
  (After.push (N.Nat^::succ n) h).apply (value n f g v) = Other.value n (\fun (x: V) => h (f x)) (\fun (x: V) => h (g x)) v;
\module Step(n: N.Nat^);
\definition valueLaw: \forall (n: N.Nat^) -> Property n :=
  \induction (n: N.Nat^) \return Property n \with {
    | zero: \fun (f, g: V -> W)(h: W -> U)(v: Domain.Tuple N.Nat^::zero) =>
        Modules.Hom[V := Codomain.Carrier (N.Nat^::succ N.Nat^::zero), W := Final.Carrier (N.Nat^::succ N.Nat^::zero), source := Codomain.space (N.Nat^::succ N.Nat^::zero), target := Final.space (N.Nat^::succ N.Nat^::zero)].zeroPreserved
          (After.push (N.Nat^::succ N.Nat^::zero) h)
    | succ: \fun (n: N.Nat^)(previous: Property n) => Step[n := n].law previous
  };
\module At(n: N.Nat^) {
  \import Modules.Hom[V := Codomain.Carrier (N.Nat^::succ n), W := Final.Carrier (N.Nat^::succ n), source := Codomain.space (N.Nat^::succ n), target := Final.space (N.Nat^::succ n)]
    .Composition[U := Domain.Carrier n, domain := Domain.space n] \as Composition;
  \import Modules.Free[Generators := Domain.Tuple n].To[W := Final.Carrier (N.Nat^::succ n), target := Final.space (N.Nat^::succ n)] \as Free;
  \import Modules.Hom[V := Domain.Carrier n, W := Final.Carrier (N.Nat^::succ n), source := Domain.space n, target := Final.space (N.Nat^::succ n)] \as Maps;
  \definition equation: \forall (f, g: V -> W)(h: W -> U) -> Composition.compose (After.push (N.Nat^::succ n) h) (map n f g) = Other.map n (\fun (x: V) => h (f x)) (\fun (x: V) => h (g x)) :=
    \fun (f, g: V -> W)(h: W -> U) => Free.ext _ _ (\fun (v: Domain.Tuple n) => eq_reason_in!{{Final.Carrier (N.Nat^::succ n)} _
      "=" _ "by" { congr!{{Codomain.Carrier (N.Nat^::succ n)} {Final.Carrier (N.Nat^::succ n)}} ((After.push (N.Nat^::succ n) h).apply) _ _ (\parent.\parent.At[n := n].onGenerator f g v) }
      "=" _ "by" { valueLaw n f g h v }
      "=" _ "by" { sym!{{Final.Carrier (N.Nat^::succ n)}} _ _ (Other.At[n := n].onGenerator (\fun (x: V) => h (f x)) (\fun (x: V) => h (g x)) v) }
    });
  \definition law: \forall (f, g: V -> W)(h: W -> U)(x: Domain.Carrier n) ->
    (After.push (N.Nat^::succ n) h).apply ((map n f g).apply x) = (Other.map n (\fun (x: V) => h (f x)) (\fun (x: V) => h (g x))).apply x :=
    \fun (f, g: V -> W)(h: W -> U)(x: Domain.Carrier n) => congr!{Maps.Map {Final.Carrier (N.Nat^::succ n)}} (\fun (k: Maps.Map) => (k).apply x) _ _ (equation f g h);
}
