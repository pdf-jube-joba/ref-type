\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Values[n := N.Nat^::succ n] \as DegreeValues;
\definition valueExtended: \forall (f, g: V -> W)(a: V)(v: Domain.Tuple n) ->
  value (N.Nat^::succ n) f g (Tuples.extend n a v) =
    (Codomain.cone (N.Nat^::succ n) (f a)).apply
      (DegreeValues.difference (Codomain.generator (N.Nat^::succ n) (Mapping.onTuple (N.Nat^::succ n) g (Tuples.extend n a v))) (value n f g v)) :=
  \fun (f, g: V -> W)(a: V)(v: Domain.Tuple n) =>
    congr!{V {Domain.Tuple n} {Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))}}
      (\fun (head: V)(tail: Domain.Tuple n) => (Codomain.cone (N.Nat^::succ n) (f head)).apply
        (DegreeValues.difference (Codomain.generator (N.Nat^::succ n) (Mapping.onTuple (N.Nat^::succ n) g (Tuples.extend n a v))) (value n f g tail)))
      _ _ _ _ (Tuples.atZero n a v)
      (\axiom:funext((\fun (i: Fin.Fin n) => Tuples.extend n a v (Fin.succ n i)), v, Tuples.atSuccessor n a v));
\import Modules.Hom[V := Domain.Carrier (N.Nat^::succ n), W := Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n)), source := Domain.space (N.Nat^::succ n), target := Codomain.space (N.Nat^::succ (N.Nat^::succ n))]
  .Composition[U := Domain.Carrier n, domain := Domain.space n] \as Before;
\import Modules.Hom[V := Domain.Carrier (N.Nat^::succ n), W := Codomain.Carrier (N.Nat^::succ n), source := Domain.space (N.Nat^::succ n), target := Codomain.space (N.Nat^::succ n)]
  .Composition[U := Domain.Carrier n, domain := Domain.space n] \as MapCone;
\import Modules.Hom[V := Domain.Carrier n, W := Codomain.Carrier (N.Nat^::succ n), source := Domain.space n, target := Codomain.space (N.Nat^::succ n)] \as Residual;
\import Modules.Hom[V := Codomain.Carrier (N.Nat^::succ n), W := Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n)), source := Codomain.space (N.Nat^::succ n), target := Codomain.space (N.Nat^::succ (N.Nat^::succ n))]
  .Composition[U := Domain.Carrier n, domain := Domain.space n] \as After;
\definition residual[f, g: V -> W][a: V]: Residual.Map := Residual.plus
  (MapCone.compose (Mapping.push (N.Nat^::succ n) g) (Domain.cone n a)) (Residual.negative (map n f g));
\definition leftMap[f, g: V -> W][a: V]: Modules.Hom[V := Domain.Carrier n, W := Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n)), source := Domain.space n, target := Codomain.space (N.Nat^::succ (N.Nat^::succ n))].Map :=
  Before.compose (map (N.Nat^::succ n) f g) (Domain.cone n a);
\definition rightMap[f, g: V -> W][a: V]: Modules.Hom[V := Domain.Carrier n, W := Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n)), source := Domain.space n, target := Codomain.space (N.Nat^::succ (N.Nat^::succ n))].Map :=
  After.compose (Codomain.cone (N.Nat^::succ n) (f a)) (residual f g a);
\definition onGenerator: \forall (f, g: V -> W)(a: V)(v: Domain.Tuple n) ->
  (leftMap f g a).apply (Domain.generator n v) = (rightMap f g a).apply (Domain.generator n v) :=
  \fun (f, g: V -> W)(a: V)(v: Domain.Tuple n) => \block {
    \let c: Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n)) :=
      (Codomain.cone (N.Nat^::succ n) (f a)).apply
        (DegreeValues.difference (Codomain.generator (N.Nat^::succ n) (Mapping.onTuple (N.Nat^::succ n) g (Tuples.extend n a v))) (value n f g v)) \then
    \let left: (leftMap f g a).apply (Domain.generator n v) = c := eq_reason_in!{{Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))} _
      "=" _ "by" { congr!{{Domain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))}} ((map (N.Nat^::succ n) f g).apply) _ _ (Domain.Cone[n := n].onGenerator a v) }
      "=" _ "by" { \parent.At[n := N.Nat^::succ n].onGenerator f g (Tuples.extend n a v) }
      "=" _ "by" { valueExtended f g a v }
    } \then
    \let first: (Mapping.push (N.Nat^::succ n) g).apply ((Domain.cone n a).apply (Domain.generator n v)) =
      Codomain.generator (N.Nat^::succ n) (Mapping.onTuple (N.Nat^::succ n) g (Tuples.extend n a v)) :=
      trans!{{Codomain.Carrier (N.Nat^::succ n)}} _ _ _
        (congr!{{Domain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)}} ((Mapping.push (N.Nat^::succ n) g).apply) _ _ (Domain.Cone[n := n].onGenerator a v))
        (Mapping.At[n := N.Nat^::succ n].onGenerator g (Tuples.extend n a v)) \then
    \let right: (rightMap f g a).apply (Domain.generator n v) = c :=
      congr!{{Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))}} ((Codomain.cone (N.Nat^::succ n) (f a)).apply) _ _
        (congr!{{Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)} {Codomain.Carrier (N.Nat^::succ n)}}
          DegreeValues.difference _ _ _ _ first (\parent.At[n := n].onGenerator f g v)) \then
    \return trans!{{Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _ _ left (sym!{{Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))}} _ _ right)
  };
\import Modules.Free[Generators := Domain.Tuple n].To[W := Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n)), target := Codomain.space (N.Nat^::succ (N.Nat^::succ n))] \as Free;
\definition equation: \forall (f, g: V -> W)(a: V) -> leftMap f g a = rightMap f g a :=
  \fun (f, g: V -> W)(a: V) => Free.ext _ _ (onGenerator f g a);
\import Modules.Hom[V := Domain.Carrier n, W := Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n)), source := Domain.space n, target := Codomain.space (N.Nat^::succ (N.Nat^::succ n))] \as Maps;
\definition law: \forall (f, g: V -> W)(a: V)(x: Domain.Carrier n) ->
  (map (N.Nat^::succ n) f g).apply ((Domain.cone n a).apply x) =
    (Codomain.cone (N.Nat^::succ n) (f a)).apply
      (DegreeValues.difference ((Mapping.push (N.Nat^::succ n) g).apply ((Domain.cone n a).apply x)) ((map n f g).apply x)) :=
  \fun (f, g: V -> W)(a: V)(x: Domain.Carrier n) => congr!{Maps.Map {Codomain.Carrier (N.Nat^::succ (N.Nat^::succ n))}} (\fun (h: Maps.Map) => (h).apply x) _ _ (equation f g a);
