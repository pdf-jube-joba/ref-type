\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition tuple[m, n: N.Nat^][same: m = n]: Tuple m -> Tuple n := Transport.cast Tuple m n same;
\definition apply[m, n: N.Nat^][same: m = n]: Carrier m -> Carrier n := Transport.cast Carrier m n same;
\definition onGenerator: \forall (m, n: N.Nat^)(same: m = n)(v: Tuple m) ->
  apply m n same (generator m v) = generator n (tuple m n same v) := Transport.natural Tuple Carrier generator;
\definition addition: \forall (m, n: N.Nat^)(same: m = n)(x, y: Carrier m) ->
  apply m n same ((space m).add x y) = (space n).add (apply m n same x) (apply m n same y) :=
  Transport.binaryNatural Carrier Carrier Carrier (\fun (k: N.Nat^) => (space k).add);
\definition scalar: \forall (m, n: N.Nat^)(same: m = n)(a: I.Int^)(x: Carrier m) ->
  apply m n same ((space m).smul a x) = (space n).smul a (apply m n same x) :=
  \fun (m, n: N.Nat^)(same: m = n)(a: I.Int^) => Transport.natural Carrier Carrier (\fun (k: N.Nat^) => (space k).smul a) m n same;
\definition linear[m, n: N.Nat^][same: m = n]: Modules.Hom[V := Carrier m, W := Carrier n, source := space m, target := space n].Map :=
  Modules.Hom[V := Carrier m, W := Carrier n, source := space m, target := space n].Map {
    apply := apply m n same, addition := addition m n same, scalar := scalar m n same,
  };
\definition boundaryNatural: \forall (m, n: N.Nat^)(same: m = n)(x: Carrier (N.Nat^::succ m)) ->
  apply m n same ((boundary m).apply x) = (boundary n).apply (apply (N.Nat^::succ m) (N.Nat^::succ n) (congr!{N.Nat^ N.Nat^} N.Nat^::succ m n same) x) :=
  \fun (m, n: N.Nat^)(same: m = n)(x: Carrier (N.Nat^::succ m)) => trans!{{Carrier n}} _ _ _
    (Transport.natural (\fun (k: N.Nat^) => Carrier (N.Nat^::succ k)) Carrier (\fun (k: N.Nat^) => (boundary k).apply) m n same x)
    (congr!{{Carrier (N.Nat^::succ n)} {Carrier n}} ((boundary n).apply) _ _ (Transport.reindex Carrier N.Nat^::succ m n same x));
\definition coneNatural: \forall (m, n: N.Nat^)(same: m = n)(a: V)(x: Carrier m) ->
  apply (N.Nat^::succ m) (N.Nat^::succ n) (congr!{N.Nat^ N.Nat^} N.Nat^::succ m n same) ((cone m a).apply x) = (cone n a).apply (apply m n same x) :=
  \fun (m, n: N.Nat^)(same: m = n)(a: V)(x: Carrier m) => trans!{{Carrier (N.Nat^::succ n)}} _ _ _
    (sym!{{Carrier (N.Nat^::succ n)}} _ _ (Transport.reindex Carrier N.Nat^::succ m n same ((cone m a).apply x)))
    (Transport.natural Carrier (\fun (k: N.Nat^) => Carrier (N.Nat^::succ k)) (\fun (k: N.Nat^) => (cone k a).apply) m n same x);
