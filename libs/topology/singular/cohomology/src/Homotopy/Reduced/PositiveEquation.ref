\definition degree: I.Int^ := I.Int^::ofNat (N.Nat^::succ n);
\import \parent.At[z := degree] \as Current;
\definition first[f, g: A -> B][h: Family f g][x: SourceReduced.Carrier degree]: TargetReduced.Carrier degree :=
  (Codomain.boundary (N.Nat^::succ n)).apply ((Ordinary.At[n := N.Nat^::succ n].map f g h).apply x);
\definition second[f, g: A -> B][h: Family f g][x: SourceReduced.Carrier degree]: TargetReduced.Carrier degree :=
  (Ordinary.At[n := n].map f g h).apply ((Domain.boundary n).apply x);
\definition rightLaw: \forall (f, g: A -> B)(h: Family f g)(x: SourceReduced.Carrier degree) ->
  Current.rightHand f g h x = (TargetReduced.space degree).add (first f g h x) (second f g h x) :=
  \fun (f, g: A -> B)(h: Family f g)(x: SourceReduced.Carrier degree) =>
    congr!{{TargetReduced.Carrier degree} {TargetReduced.Carrier degree} {TargetReduced.Carrier degree}} ((TargetReduced.space degree).add) _ _ _ _
      (Transport.castRefl TargetReduced.complex.family.Carrier degree (first f g h x))
      (Transport.castRefl TargetReduced.complex.family.Carrier degree (second f g h x));
\definition law: \forall (f, g: A -> B)(h: Family f g)(x: SourceReduced.Carrier degree) -> Current.leftHand f g h x = Current.rightHand f g h x :=
  \fun (f, g: A -> B)(h: Family f g)(x: SourceReduced.Carrier degree) => trans!{{TargetReduced.Carrier degree}} _ _ _
    ((nativeLaws f g h).successorEquation n x) (sym!{{TargetReduced.Carrier degree}} _ _ (rightLaw f g h x));
