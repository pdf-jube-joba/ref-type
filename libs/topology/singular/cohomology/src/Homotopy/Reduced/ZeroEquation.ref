\definition degree: I.Int^ := I.Int^::ofNat N.Nat^::zero;
\import \parent.At[z := degree] \as Current;
\import Modules.Laws[V := TargetReduced.Carrier degree, space := TargetReduced.space degree] \as Values;
\definition boundary[f, g: A -> B][h: Family f g][x: Domain.Carrier N.Nat^::zero]: Codomain.Carrier N.Nat^::zero :=
  (Codomain.boundary N.Nat^::zero).apply ((Ordinary.At[n := N.Nat^::zero].map f g h).apply x);
\definition rightLaw: \forall (f, g: A -> B)(h: Family f g)(x: SourceReduced.Carrier degree) -> Current.rightHand f g h x = boundary f g h x :=
  \fun (f, g: A -> B)(h: Family f g)(x: SourceReduced.Carrier degree) => trans!{{TargetReduced.Carrier degree}} _ _ _
    (congr!{{TargetReduced.Carrier degree} {TargetReduced.Carrier degree} {TargetReduced.Carrier degree}} ((TargetReduced.space degree).add) _ _ _ _
      (Transport.castRefl TargetReduced.complex.family.Carrier degree (boundary f g h x))
      (Transport.castRefl TargetReduced.complex.family.Carrier degree (TargetReduced.space degree).zero))
    (Values.zeroRight (boundary f g h x));
\definition law: \forall (f, g: A -> B)(h: Family f g)(x: SourceReduced.Carrier degree) -> Current.leftHand f g h x = Current.rightHand f g h x :=
  \fun (f, g: A -> B)(h: Family f g)(x: SourceReduced.Carrier degree) => trans!{{TargetReduced.Carrier degree}} _ _ _
    ((nativeLaws f g h).zeroEquation x) (sym!{{TargetReduced.Carrier degree}} _ _ (rightLaw f g h x));
