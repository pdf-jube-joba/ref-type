\import algebraic_topology.Interval[] \as Interval;
\import Geometry.Endpoints[] \as Endpoints;
\definition startSimplex: \forall (f, g: A -> B)(h: Family f g)(sigma: Source.Carrier n) ->
  CylinderMaps.postcompose n (family f g h sigma) (continuous f g h sigma) (Endpoints.simplex Interval.start) =
    Maps.postcompose n f (startContinuous f g h) sigma :=
  \fun (f, g: A -> B)(h: Family f g)(sigma: Source.Carrier n) => Target.ext n
    (CylinderMaps.postcompose n (family f g h sigma) (continuous f g h sigma) (Endpoints.simplex Interval.start))
    (Maps.postcompose n f (startContinuous f g h) sigma)
    ((OnSimplex.laws DomainSpace.topology target (\fun (u: Simplex.Carrier n) => f (sigma u)) (\fun (u: Simplex.Carrier n) => g (sigma u)) (homotopy f g h sigma)).start);
\definition endSimplex: \forall (f, g: A -> B)(h: Family f g)(sigma: Source.Carrier n) ->
  CylinderMaps.postcompose n (family f g h sigma) (continuous f g h sigma) (Endpoints.simplex Interval.end) =
    Maps.postcompose n g (endContinuous f g h) sigma :=
  \fun (f, g: A -> B)(h: Family f g)(sigma: Source.Carrier n) => Target.ext n
    (CylinderMaps.postcompose n (family f g h sigma) (continuous f g h sigma) (Endpoints.simplex Interval.end))
    (Maps.postcompose n g (endContinuous f g h) sigma)
    ((OnSimplex.laws DomainSpace.topology target (\fun (u: Simplex.Carrier n) => f (sigma u)) (\fun (u: Simplex.Carrier n) => g (sigma u)) (homotopy f g h sigma)).end);
\definition startChain: \forall (f, g: A -> B)(h: Family f g)(sigma: Source.Carrier n) ->
  (CylinderMaps.At[n := n].push (family f g h sigma) (continuous f g h sigma)).apply (CylinderChains.generator n (Endpoints.simplex Interval.start)) =
    Codomain.generator n (Maps.postcompose n f (startContinuous f g h) sigma) :=
  \fun (f, g: A -> B)(h: Family f g)(sigma: Source.Carrier n) => trans!{{Codomain.Carrier n}} _ _ _
    (CylinderMaps.At[n := n].onGenerator (family f g h sigma) (continuous f g h sigma) (Endpoints.simplex Interval.start))
    (congr!{{Target.Carrier n} {Codomain.Carrier n}} (Codomain.generator n) _ _ (startSimplex f g h sigma));
\definition endChain: \forall (f, g: A -> B)(h: Family f g)(sigma: Source.Carrier n) ->
  (CylinderMaps.At[n := n].push (family f g h sigma) (continuous f g h sigma)).apply (CylinderChains.generator n (Endpoints.simplex Interval.end)) =
    Codomain.generator n (Maps.postcompose n g (endContinuous f g h) sigma) :=
  \fun (f, g: A -> B)(h: Family f g)(sigma: Source.Carrier n) => trans!{{Codomain.Carrier n}} _ _ _
    (CylinderMaps.At[n := n].onGenerator (family f g h sigma) (continuous f g h sigma) (Endpoints.simplex Interval.end))
    (congr!{{Target.Carrier n} {Codomain.Carrier n}} (Codomain.generator n) _ _ (endSimplex f g h sigma));
