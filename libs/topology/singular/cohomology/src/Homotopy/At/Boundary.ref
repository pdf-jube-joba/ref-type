\import \parent.Endpoints[] \as Endpoints;
\import Geometry.Prism[] \as Prism;
\import Geometry.Endpoints[] \as GeometryEndpoints;
\import algebraic_topology.Interval[] \as Interval;
\import Modules.Laws[V := Codomain.Carrier n, space := Codomain.space n] \as Values;
\import algebra.Group[].Of[Carrier := Codomain.Carrier n, group := Values.additive] \as Group;
\import Modules.Laws[V := CylinderChains.Carrier n, space := CylinderChains.space n] \as CylinderValues;
\import algebra.Group[].Of[Carrier := CylinderChains.Carrier n, group := CylinderValues.additive] \as CylinderGroup;
\import Modules.Hom[V := CylinderChains.Carrier n, W := Codomain.Carrier n, source := CylinderChains.space n, target := Codomain.space n] \as Push;
\definition prior[f, g: A -> B][h: Family f g][sigma: Source.Carrier n]: Codomain.Carrier n :=
  (CylinderMaps.At[n := n].push (family f g h sigma) (continuous f g h sigma)).apply Prism.prior;
\definition law: \forall (f, g: A -> B)(h: Family f g)(sigma: Source.Carrier n) ->
  (Codomain.boundary n).apply (onSimplex f g h sigma) = Group.difference
    (Group.difference (Codomain.generator n (Maps.postcompose n g (endContinuous f g h) sigma)) (Codomain.generator n (Maps.postcompose n f (startContinuous f g h) sigma)))
    (prior f g h sigma) := \block {
  \fun (f, g: A -> B)(h: Family f g)(sigma: Source.Carrier n) \then
  \let push: Push.Map := CylinderMaps.At[n := n].push (family f g h sigma) (continuous f g h sigma) \then
  \let e: CylinderChains.Carrier n := CylinderChains.generator n (GeometryEndpoints.simplex Interval.end) \then
  \let s: CylinderChains.Carrier n := CylinderChains.generator n (GeometryEndpoints.simplex Interval.start) \then
  \return trans!{{Codomain.Carrier n}} _ _ _ (CylinderMaps.Differential[n := n].commutes (family f g h sigma) (continuous f g h sigma) Prism.chain)
    (trans!{{Codomain.Carrier n}} _ _ _ (congr!{{CylinderChains.Carrier n} {Codomain.Carrier n}} ((push).apply) _ _ Prism.boundary)
      (trans!{{Codomain.Carrier n}} _ _ _ (Push.differencePreserved push (CylinderGroup.difference e s) Prism.prior)
        (congr!{{Codomain.Carrier n} {Codomain.Carrier n}} (\fun (v: Codomain.Carrier n) => Group.difference v (prior f g h sigma)) _ _
          (trans!{{Codomain.Carrier n}} _ _ _ (Push.differencePreserved push e s)
            (congr2!{{Codomain.Carrier n} {Codomain.Carrier n} {Codomain.Carrier n}} Group.difference _ _ _ _ (Endpoints.endChain f g h sigma) (Endpoints.startChain f g h sigma))))))
};
