\import std.Arithmetic[].Int[] \as I;
\import \root.Cochains[A := A, source := source].With[coefficients := coefficients] \as Native;
\import \root.Chains[A := A, source := source].Reduced[] \as Augmented;
\import resolutions.HomComplex[].Over[R := Scalars.Int^, ring := IntegerRing.commutativeRing].Integer[P := Augmented.complex, N := coefficients] \as Reduced;
\import chain_complexes.Integer[] \as Degrees;
\import Degrees.Over[R := Scalars.Int^, ring := IntegerRing.ring] \as Signed;
\import chain_complexes.Chain[].Over[R := Scalars.Int^, ring := IntegerRing.ring].Prior[C := Augmented.complex] \as Prior;
\import std.Logic[].Equality[].Transport[A := I.Int^] \as Transport;
\definition differentialLaw: \forall (n: N.Nat^)(h: Reduced.Carrier (I.Int^::ofNat n)) -> Reduced.apply (I.Int^::ofNat n) h = Native.coboundary n h :=
  \fun (n: N.Nat^)(h: Reduced.Carrier (I.Int^::ofNat n)) => Reduced.At[z := I.Int^::ofNat (N.Nat^::succ n)].ext (Reduced.apply (I.Int^::ofNat n) h) (Native.coboundary n h)
    (\fun (x: Chains.Carrier (N.Nat^::succ n)) => congr!{{Augmented.Carrier (I.Int^::ofNat n)} coefficients.Carrier} ((h).apply) (Prior.value (I.Int^::ofNat n) x) ((Augmented.differential).apply (I.Int^::ofNat (N.Nat^::succ n)) x)
      (Transport.castRefl Augmented.Carrier (I.Int^::ofNat n) ((Augmented.differential).apply (I.Int^::ofNat (N.Nat^::succ n)) x)));
\module Positive(n: N.Nat^);
