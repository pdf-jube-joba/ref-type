\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import Fin.Tuples[A := V] \as Tuples;
\import Tuples.Omission[] \as Omission;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Proposition[] \as Logic;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition Tuple[n: N.Nat^]: \Set := Fin.Fin n -> V;
\module At(n: N.Nat^) {
  \import Modules.Free[Generators := Tuple n] \as Free;
  \definition Carrier: \Set := Free.Carrier;
  \definition space: Modules.Space Carrier := Free.space;
  \definition generator: Tuple n -> Carrier := Free.generator;
}
\definition Carrier[n: N.Nat^]: \Set := At[n := n].Carrier;
\definition space[n: N.Nat^]: Modules.Space (Carrier n) := At[n := n].space;
\definition generator[n: N.Nat^]: Tuple n -> Carrier n := At[n := n].generator;
\module Boundary(n: N.Nat^) {
  \import Modules.Free[Generators := Tuple (N.Nat^::succ n)].To[W := Carrier n, target := space n] \as Extend;
  \import Modules.Hom[V := Carrier (N.Nat^::succ n), W := Carrier n, source := space (N.Nat^::succ n), target := space n] \as Maps;
  \import Modules.Alternating[V := Carrier n, space := space n] \as Sum;
  \definition value[v: Tuple (N.Nat^::succ n)]: Carrier n :=
    Sum.sum (N.Nat^::succ n) (\fun (i: Fin.Fin (N.Nat^::succ n)) => generator n (Omission.omit n i v));
  \definition map: Maps.Map := Extend.extension value;
  \definition onGenerator: \forall (v: Tuple (N.Nat^::succ n)) -> (map).apply (generator (N.Nat^::succ n) v) = value v := Extend.onGenerator value;
}
\module Cone(n: N.Nat^) {
  \import Modules.Free[Generators := Tuple n].Reindex[TargetGenerators := Tuple (N.Nat^::succ n)] \as Reindex;
  \import Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)] \as Maps;
  \definition map[a: V]: Maps.Map := Reindex.push (Tuples.extend n a);
  \definition onGenerator: \forall (a: V)(v: Tuple n) ->
    (map a).apply (generator n v) = generator (N.Nat^::succ n) (Tuples.extend n a v) :=
    \fun (a: V) => Reindex.onGenerator (Tuples.extend n a);
}
\definition cone[n: N.Nat^][a: V]: Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)].Map := Cone[n := n].map a;
\definition boundary[n: N.Nat^]: Modules.Hom[V := Carrier (N.Nat^::succ n), W := Carrier n, source := space (N.Nat^::succ n), target := space n].Map := Boundary[n := n].map;
\module ConeBoundary(n: N.Nat^);
\module Empty;
\module SquareZero(n: N.Nat^);
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\definition family: Complexes.Family := Complexes.Family {
  Carrier := \fun (n: N.Nat^) => Carrier (N.Nat^::succ n),
  space := \fun (n: N.Nat^) => space (N.Nat^::succ n),
};
\definition differential: Complexes.DifferentialData[family] := Complexes.DifferentialData[family] {
  apply := \fun (n: N.Nat^) => (boundary (N.Nat^::succ n)).apply,
};
\definition complex: Complexes.Complex := Complexes.Complex {
  family := family, differential := differential,
  laws := Complexes.DifferentialLaws[family, differential] {
    addition := \fun (n: N.Nat^) => (boundary (N.Nat^::succ n)).addition,
    scalar := \fun (n: N.Nat^) => (boundary (N.Nat^::succ n)).scalar,
    squareZero := \fun (n: N.Nat^) => SquareZero[n := N.Nat^::succ n].all,
  },
};
\module Mapping(W: \Set);
\module Prism(W: \Set);
\definition Centres: \Set := \forall (n: N.Nat^) -> Tuple (N.Nat^::succ n) -> V;
\module Subdivision(centres: Centres);
\module DegreeTransport;
\module AugmentedMaps;
