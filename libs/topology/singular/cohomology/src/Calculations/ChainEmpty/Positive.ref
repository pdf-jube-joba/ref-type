\import \parent.Native[n := n] \as Ordinary;
\import Extension.Positive[n := n] \as Packing;
\definition zero: IsEmpty -> \forall (x: Extension.Carrier (I.Int^::ofNat n)) -> x = (Extension.space (I.Int^::ofNat n)).zero :=
  \fun (empty: IsEmpty)(x: Extension.Carrier (I.Int^::ofNat n)) =>
    congr!{{Carrier n} {Extension.Carrier (I.Int^::ofNat n)}} Packing.intro x (space n).zero (Ordinary.zero empty x);
