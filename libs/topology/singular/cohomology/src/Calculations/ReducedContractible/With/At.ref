\import Modules.Isomorphism[V := Theory.At[z := z].Carrier, W := PointTheory.At[z := z].Carrier,
  source := Theory.At[z := z].space, target := PointTheory.At[z := z].space].Vanishing[] \as Vanishing;
\definition zero[c: Geometry.Data]: \forall (q: Theory.At[z := z].Carrier) -> q = (Theory.At[z := z].space).zero :=
  Vanishing.sourceZero (Comparison.With[coefficients := coefficients].At[z := z].isomorphism (Geometry.pointEquivalence c)) (PointZero.At[z := z].zero Geometry.pointUnique);
