\use std.Logic[].Equality[].eq_reason_in;
\import PointHomotopies.At[k := z] \as PointContraction;
\import Modules.Laws[V := Point.Carrier z, space := Point.space z] \as PointValues;
\import algebra.Group[].Of[Carrier := Point.Carrier z, group := PointValues.additive] \as PointGroup;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition pointCycle[x: SourceH.Cycle]: PointH.Cycle := (Forward.cyclesMap projection).apply x;
\definition pointBoundary[x: SourceH.Cycle]: (PointH.prior).apply ((pointHomotopy).apply z (pointCycle x)) = pointCycle x :=
  eq_reason_in!{{Point.Carrier z} _
    "=" _ "by" { sym!{{Point.Carrier z}} _ _ (PointContraction.onCycle PointEnd.identity PointEnd.zeroMap pointHomotopy (pointCycle x)) }
    "=" _ "by" { congr!{{Point.Carrier z} {Point.Carrier z}} ((Point.space z).add (pointCycle x)) _ _ PointGroup.negZero }
    "=" _ "by" { PointGroup.zeroRight (pointCycle x) }
  };
\definition law[x: SourceH.Cycle]: (SourceH.prior).apply ((pointPart).apply x) = (inclusion).apply z ((projection).apply z x) :=
  trans!{{Reduced.Carrier z}} _ _ _
    (BackwardMaps.priorCommutes z inclusion ((pointHomotopy).apply z (pointCycle x)))
    (congr!{{Point.Carrier z} {Reduced.Carrier z}} ((inclusion).apply z) _ _ (pointBoundary x));
