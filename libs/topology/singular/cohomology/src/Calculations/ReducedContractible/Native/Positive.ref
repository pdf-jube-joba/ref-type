\definition degree: N.Nat^ := N.Nat^::succ n;
\definition law[x: Chains.Carrier degree]: (projection).apply degree x = (Chains.space degree).zero :=
  trans!{{Chains.Carrier degree}} _ _ _
    (congr!{{PointChains.Carrier degree} {Chains.Carrier degree}} ((backward).apply degree) _ _ (PointContraction.Positive[n := n].law Geometry.pointUnique ((forward).apply degree x)))
    (Backward.At[n := degree].zeroPreserved backward);
