\import \root.Simplices[A := SubspaceCarrier, source := Subspace.topology source] \as SubspaceSimplices;
\import \root.Simplices[A := A, source := source] \as WholeSimplices;
\import algebraic_topology.Simplex[] \as Simplex;
\definition onSimplices: \forall (sigma, tau: SubspaceSimplices.Carrier n) ->
  Inclusion.postcompose n inclusion inclusionContinuous sigma = Inclusion.postcompose n inclusion inclusionContinuous tau -> sigma = tau :=
  \fun (sigma, tau: SubspaceSimplices.Carrier n)(same: _) => \axiom:funext(sigma, tau,
    \fun (x: Simplex.Carrier n) => congr!{{WholeSimplices.Carrier n} A}
      (\fun (f: WholeSimplices.Carrier n) => f x) _ _ same);
\import Modules.Free[Generators := SubspaceSimplices.Carrier n].Reindex[TargetGenerators := WholeSimplices.Carrier n].Injection[f := Inclusion.postcompose n inclusion inclusionContinuous] \as Free;
\definition injective: \forall (x, y: SubspaceExtension.Carrier (I.Int^::ofNat n)) ->
  (inclusionMap).apply (I.Int^::ofNat n) x = (inclusionMap).apply (I.Int^::ofNat n) y -> x = y :=
  \fun (x, y: _)(same: _) => Free.injective onSimplices x y same;
