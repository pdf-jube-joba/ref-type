\import resolutions.HomComplex[].Over[R := R, ring := ring].Abelian[N := coefficients] \as Hom;
\definition integerCoefficients: Modules.Bundle := Hom.coefficients;
\import \root.Relative[A := A, source := source, subset := subset] \as Pair;
\import Pair.With[coefficients := integerCoefficients] \as Ordinary;
\import Hom.On[P := Pair.complex] \as Native;
\definition Carrier[z: I.Int^]: \Set := Ordinary.Carrier z;
\definition space[z: I.Int^]: CoefficientModules.Space (Carrier z) := Native.space z;
\import chain_complexes.Integer[].Over[R := R, ring := Rings.commutativeRingAsRing R ring] \as RingComplexes;
\definition complex: RingComplexes.Complex := Native.complex;
\module At(z: I.Int^) {
  \definition Carrier: \Set := Ordinary.At[z := z].Carrier;
  \definition space: CoefficientModules.Space Carrier := Native.Cohomology[z := z].ordinarySpace;
}
\definition cohomology[n: N.Nat^]: \Set := At[z := I.Int^::ofNat n].Carrier;
\definition cohomologySpace[n: N.Nat^]: CoefficientModules.Space (cohomology n) := At[z := I.Int^::ofNat n].space;
\definition scalarValue: \forall (z: I.Int^)(a: R)(h: Carrier z)(x: Pair.Carrier z) ->
  ((space z).smul a h).apply x = (coefficients.space).smul a ((h).apply x) :=
  \fun (z: I.Int^)(a: R)(h: Carrier z)(x: Pair.Carrier z) => \refl((coefficients.space).smul a ((h).apply x));
\definition coboundaryScalar: \forall (z: I.Int^)(a: R)(h: Carrier z) ->
  (Ordinary.complex.differential).apply z ((space z).smul a h) = (space (chain_complexes.Integer[].next z)).smul a ((Ordinary.complex.differential).apply z h) := Native.scalar;
