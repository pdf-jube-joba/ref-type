\import algebraic_topology.Contraction[A := A, source := source] \as Geometry;
\import \root.Calculations[A := A, source := source].ReducedContractible[] \as Vanishing;
\module Homology(z: I.Int^) {
  \import Complexes.At[C := complex, z := z] \as RelativeH;
  \import Complexes.At[C := SubspaceReduced.complex, z := Degrees.previous z] \as SubspaceH;
  \import Exact.At[s := sequence, k := z] \as Native;
  \import Native.DimensionShift[] \as Shift;
  \definition isomorphism[c: Geometry.Data]: Modules.Isomorphism[V := RelativeH.Homology, W := SubspaceH.Homology, source := RelativeH.homologySpace, target := SubspaceH.homologySpace].Isomorphism :=
    Shift.isomorphism (Vanishing.Homology[z := z].zero c) (Vanishing.Homology[z := Degrees.previous z].zero c);
  \definition onForward: \forall (c: Geometry.Data)(q: RelativeH.Homology) ->
    ((isomorphism c).forward).apply q = (Native.connecting).apply q :=
    \fun (c: Geometry.Data)(q: RelativeH.Homology) => \refl((Native.connecting).apply q);
}
