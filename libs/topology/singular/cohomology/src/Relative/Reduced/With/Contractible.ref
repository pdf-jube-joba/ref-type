\import topology.Topology[Carrier := A].Subspace[S := subset] \as Topology;
\import algebraic_topology.Contraction[A := SubspaceCarrier, source := Topology.topology source] \as Geometry;
\import \root.Calculations[A := SubspaceCarrier, source := Topology.topology source].ReducedContractible[].With[coefficients := coefficients] \as Vanishing;
\import Cochains.ShortExact[A := Relative.complex, B := Whole.complex, C := Subspace.complex] \as Exact;
\definition quasi[c: Geometry.Data]: Maps.QuasiIsomorphism pullback :=
  \idelim sequence.inclusion = pullback \with f: Maps.Map => Maps.QuasiIsomorphism f \by {
    base: Exact.quasiInclusion sequence (\fun (z: I.Int^) => Vanishing.At[z := z].zero c),
    equality: inclusionLaw
  };
\module At(z: I.Int^);
