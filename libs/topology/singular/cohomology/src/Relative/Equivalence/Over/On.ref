\use std.Logic[].Equality[].eq_reason_in;
\import Forward.On[f := (e).forward].Integer[] \as ForwardMap;
\import Backward.On[f := (e).backward].Integer[] \as BackwardMap;
\import Left.On[f := (e).forward, g := (e).backward] \as LeftComposition;
\import Right.On[f := (e).backward, g := (e).forward] \as RightComposition;
\import SourceEnd.Homotopy[f := Left.compose (e).forward (e).backward, g := SourceIdentity.map].On[h := (e).left] \as LeftHomotopy;
\import TargetEnd.Homotopy[f := Right.compose (e).backward (e).forward, g := TargetIdentity.map].On[h := (e).right] \as RightHomotopy;
\module Homology(z: I.Int^) {
  \import Complexes.At[C := SourcePair.complex, z := z] \as Source;
  \import Complexes.At[C := TargetPair.complex, z := z] \as Target;
  \definition leftInverse: \forall (q: Source.Homology) -> (BackwardMap.At[z := z].induced).apply ((ForwardMap.At[z := z].induced).apply q) = q :=
    \fun (q: Source.Homology) => eq_reason_in!{Source.Homology _
      "=" _ "by" { sym!{Source.Homology} _ _ (LeftComposition.Homology[z := z].law q) }
      "=" _ "by" { LeftHomotopy.At[z := z].law q }
      "=" _ "by" { SourceIdentity.Homology[z := z].law q }
    };
  \definition rightInverse: \forall (q: Target.Homology) -> (ForwardMap.At[z := z].induced).apply ((BackwardMap.At[z := z].induced).apply q) = q :=
    \fun (q: Target.Homology) => eq_reason_in!{Target.Homology _
      "=" _ "by" { sym!{Target.Homology} _ _ (RightComposition.Homology[z := z].law q) }
      "=" _ "by" { RightHomotopy.At[z := z].law q }
      "=" _ "by" { TargetIdentity.Homology[z := z].law q }
    };
  \definition isomorphism: Modules.Isomorphism[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace].Isomorphism :=
    Modules.Isomorphism[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace].Isomorphism {
      forward := ForwardMap.At[z := z].induced, backward := BackwardMap.At[z := z].induced, leftInverse := leftInverse, rightInverse := rightInverse,
    };
}
\module With(coefficients: Modules.Bundle);
