\use std.Logic[].Equality[].eq_reason_in;
\definition leftInverse: \forall (q: Target.At[z := z].Carrier) -> (Push.At[z := z].induced).apply ((Pull.At[z := z].induced).apply q) = q :=
  \fun (q: Target.At[z := z].Carrier) => eq_reason_in!{{Target.At[z := z].Carrier} _
    "=" _ "by" { sym!{{Target.At[z := z].Carrier}} _ _ (RightComposition.With[coefficients := coefficients].law z q) }
    "=" _ "by" { RightHomotopy.With[coefficients := coefficients].At[z := z].law q }
    "=" _ "by" { TargetIdentity.With[coefficients := coefficients].law z q }
  };
\definition rightInverse: \forall (q: Source.At[z := z].Carrier) -> (Pull.At[z := z].induced).apply ((Push.At[z := z].induced).apply q) = q :=
  \fun (q: Source.At[z := z].Carrier) => eq_reason_in!{{Source.At[z := z].Carrier} _
    "=" _ "by" { sym!{{Source.At[z := z].Carrier}} _ _ (LeftComposition.With[coefficients := coefficients].law z q) }
    "=" _ "by" { LeftHomotopy.With[coefficients := coefficients].At[z := z].law q }
    "=" _ "by" { SourceIdentity.With[coefficients := coefficients].law z q }
  };
\definition isomorphism: Modules.Isomorphism[V := Target.At[z := z].Carrier, W := Source.At[z := z].Carrier, source := Target.At[z := z].space, target := Source.At[z := z].space].Isomorphism :=
  Modules.Isomorphism[V := Target.At[z := z].Carrier, W := Source.At[z := z].Carrier, source := Target.At[z := z].space, target := Source.At[z := z].space].Isomorphism {
    forward := Pull.At[z := z].induced, backward := Push.At[z := z].induced, leftInverse := leftInverse, rightInverse := rightInverse,
  };
