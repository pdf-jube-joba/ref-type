\import TargetPair.Maps[B := C].Over[target := final, targetSubset := finalSubset] \as After;
\import \root.Relative[A := A, source := source, subset := subset] \as SourcePair;
\import SourcePair.Maps[B := C].Over[target := final, targetSubset := finalSubset] \as Direct;
\import \root.Relative[A := C, source := final, subset := finalSubset] \as FinalPair;
\import topology.Composition[A := A, B := B, C := C] \as Topology;
\definition compose[f: Map][g: After.Map]: Direct.Map := \into[A -> C]((\fun (x: A) => g (f x)), Direct.Map) \by {
  Direct.Laws[\fun (x: A) => g (f x)] {
    continuous := Topology.composeContinuous source target final f g ((laws f).continuous) ((After.laws g).continuous),
    contained := \fun (x: SubspaceCarrier) => (After.laws g).contained (\into[B](f x, targetSubset) \by { (laws f).contained x }),
  }
};
\module On(f: Map, g: After.Map);
