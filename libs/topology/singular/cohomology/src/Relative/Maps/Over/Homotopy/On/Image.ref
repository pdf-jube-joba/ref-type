\definition Included[z: I.Int^]: \Prop := \forall (x: SubspaceExtension.Carrier z) ->
  TargetSupport.Image (chain_complexes.Chain[].next z) ((WholeInteger.integerHomotopy).apply z ((inclusionMap).apply z x));
\definition included: \forall (z: I.Int^) -> Included z := \induction (z: I.Int^) \return Included z \with {
  | ofNat: \fun (n: N.Nat^) => \parent.Degree[n := n].law
  | negSucc: \fun (n: N.Nat^)(x: SubspaceExtension.Carrier (I.Int^::negSucc n)) => (TargetQuotient.At[k := chain_complexes.Chain[].next (I.Int^::negSucc n)].image).zero
};
\module At(z: I.Int^);
\definition law: Descent.Preserves WholeInteger.integerHomotopy := \fun (z: I.Int^) => At[z := z].law;
