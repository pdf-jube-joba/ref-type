\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.IntegerComposition[P := SourcePair.complex, Q := TargetPair.complex, T := FinalPair.complex, N := coefficients] \as Product;
\import Hom.IntegerMapping[P := SourcePair.complex, Q := FinalPair.complex, N := coefficients, L := coefficients] \as DirectAction;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficients;
\import SourcePair.With[coefficients := coefficients] \as Source;
\import FinalPair.With[coefficients := coefficients] \as Target;
\definition law: \forall (z: I.Int^)(q: Target.At[z := z].Carrier) ->
  (CompositeMap.With[coefficients := coefficients].At[z := z].induced).apply q =
  (FirstMap.With[coefficients := coefficients].At[z := z].induced).apply ((SecondMap.With[coefficients := coefficients].At[z := z].induced).apply q) :=
  \fun (z: I.Int^)(q: Target.At[z := z].Carrier) => trans!{{Source.At[z := z].Carrier}} _ _ _
    (congr!{Maps.Map {Source.At[z := z].Carrier}}
      (\fun (m: Maps.Map) => (DirectAction.On[f := m, u := Coefficients.identity].At[z := z].map).apply q) _ _ (sym!{Maps.Map} _ _ chainLaw))
    (Product.At[k := z].onCohomology FirstMap.map SecondMap.map q);
