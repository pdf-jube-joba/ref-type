\definition restriction[x: SubspaceCarrier]: TargetPair.SubspaceCarrier :=
  \into[B](f x, targetSubset) \by { (laws f).contained x };
\import topology.Continuity[A := A, B := B].Restriction[S := subset] \as Restriction;
\import topology.Continuity[A := SubspaceCarrier, B := B].Corestriction[S := targetSubset] \as Corestriction;
\import \root.Maps[A := SubspaceCarrier, B := TargetPair.SubspaceCarrier,
  source := Subspace.topology source, target := TargetSubspace.topology target] \as SubspaceMaps;
\definition restrictionContinuous: SubspaceMaps.Continuous restriction :=
  Corestriction.corestrictContinuous (Subspace.topology source) target restriction
    (Restriction.restrictContinuous source target f ((laws f).continuous));
\import \root.Chains[A := TargetPair.SubspaceCarrier, source := TargetSubspace.topology target] \as TargetSubspaceChains;
\import \root.Chains[A := B, source := target] \as TargetWholeChains;
\definition ambientMap: Nonnegative.Map[C := WholeChains.complex, D := TargetWholeChains.complex].Map := WholeMaps.push f ((laws f).continuous);
\definition subspaceMap: Nonnegative.Map[C := SubspaceChains.complex, D := TargetSubspaceChains.complex].Map := SubspaceMaps.push restriction restrictionContinuous;
\import \root.Maps[A := SubspaceCarrier, B := A, source := Subspace.topology source, target := source].Composition[C := B, final := target] \as First;
\import SubspaceMaps.Composition[C := B, final := target] \as Second;
\import \root.Maps[A := TargetPair.SubspaceCarrier, B := B, source := TargetSubspace.topology target, target := target] \as TargetInclusion;
\import Nonnegative.Map[C := WholeChains.complex, D := TargetWholeChains.complex].Composition[B := SubspaceChains.complex] \as Left;
\import Nonnegative.Map[C := TargetSubspaceChains.complex, D := TargetWholeChains.complex].Composition[B := SubspaceChains.complex] \as Right;
\definition square: Left.compose ambientMap (Inclusion.push inclusion inclusionContinuous) =
  Right.compose (TargetInclusion.push TargetPair.inclusion TargetPair.inclusionContinuous) subspaceMap :=
  trans!{{Nonnegative.Map[C := SubspaceChains.complex, D := TargetWholeChains.complex].Map}} _ _ _
    (First.functoriality inclusion inclusionContinuous f ((laws f).continuous))
    (sym!{{Nonnegative.Map[C := SubspaceChains.complex, D := TargetWholeChains.complex].Map}} _ _
      (Second.functoriality restriction restrictionContinuous TargetPair.inclusion TargetPair.inclusionContinuous));
\module Integer;
