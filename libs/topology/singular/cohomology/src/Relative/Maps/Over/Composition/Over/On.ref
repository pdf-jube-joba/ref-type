\import \parent.\parent.\parent.On[f := f] \as First;
\import After.On[f := g] \as Second;
\import Direct.On[f := compose f g] \as Composite;
\import First.Integer[] \as FirstMap;
\import Second.Integer[] \as SecondMap;
\import Composite.Integer[] \as CompositeMap;
\import \root.Chains[A := B, source := target] \as MiddleChains;
\import \root.Chains[A := C, source := final] \as FinalChains;
\import Nonnegative.ZeroExtension[C := MiddleChains.complex] \as MiddleExtension;
\import Nonnegative.ZeroExtension[C := FinalChains.complex] \as FinalExtension;
\import Nonnegative.Map[C := WholeChains.complex, D := MiddleChains.complex].ZeroExtension[f := First.ambientMap] \as FirstWhole;
\import Nonnegative.Map[C := MiddleChains.complex, D := FinalChains.complex].ZeroExtension[f := Second.ambientMap] \as SecondWhole;
\import Nonnegative.Map[C := WholeChains.complex, D := FinalChains.complex].ZeroExtension[f := Composite.ambientMap] \as CompositeWhole;
\import Complexes.Map[C := MiddleExtension.complex, D := FinalExtension.complex].Composition[B := WholeExtension.complex] \as WholeComposition;
\definition whole: WholeComposition.compose SecondWhole.map FirstWhole.map = CompositeWhole.map :=
  WholeMaps.Composition[C := C, final := final].Integer[].law f ((laws f).continuous) g ((After.laws g).continuous);
\import Complexes.Map[C := TargetPair.complex, D := FinalPair.complex].Composition[B := SourcePair.complex] \as Composition;
\import Complexes.Map[C := SourcePair.complex, D := FinalPair.complex] \as Maps;
\module Degree(z: I.Int^);
\definition chainLaw: Composition.compose SecondMap.map FirstMap.map = CompositeMap.map :=
  Maps.ext (Composition.compose SecondMap.map FirstMap.map) CompositeMap.map
    (\fun (z: I.Int^) => Quotient.At[k := z].induction (\fun (q: SourcePair.Carrier z) => (Composition.compose SecondMap.map FirstMap.map).apply z q = (CompositeMap.map).apply z q) (Degree[z := z].law));
\module Homology(z: I.Int^) {
  \import Complexes.At[C := SourcePair.complex, z := z] \as SourceH;
  \import Complexes.At[C := FinalPair.complex, z := z] \as FinalH;
  \import Maps.At[k := z] \as Actions;
  \definition law: \forall (q: SourceH.Homology) -> (CompositeMap.At[z := z].induced).apply q = (SecondMap.At[z := z].induced).apply ((FirstMap.At[z := z].induced).apply q) :=
    \fun (q: SourceH.Homology) => trans!{FinalH.Homology} _ _ _
      (congr!{Maps.Map FinalH.Homology} (\fun (m: Maps.Map) => (Actions.induced m).apply q) _ _ (sym!{Maps.Map} _ _ chainLaw))
      (Composition.At[k := z].compositionOnHomology SecondMap.map FirstMap.map q);
}
\module With(coefficients: Modules.Bundle);
