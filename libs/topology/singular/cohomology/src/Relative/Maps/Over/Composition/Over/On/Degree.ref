\import Complexes.Map[C := WholeExtension.complex, D := FinalExtension.complex] \as WholeMaps;
\definition law: \forall (x: WholeExtension.Carrier z) ->
  (Composition.compose SecondMap.map FirstMap.map).apply z (SourcePair.class z x) = (CompositeMap.map).apply z (SourcePair.class z x) :=
  \fun (x: WholeExtension.Carrier z) => trans!{{FinalPair.Carrier z}} _ _ _
    (congr!{{TargetPair.Carrier z} {FinalPair.Carrier z}} ((SecondMap.map).apply z) _ _ (FirstMap.At[z := z].quotientOnClass x))
    (trans!{{FinalPair.Carrier z}} _ _ _ (SecondMap.At[z := z].quotientOnClass ((FirstWhole.map).apply z x))
      (trans!{{FinalPair.Carrier z}} _ _ _
        (congr!{{FinalExtension.Carrier z} {FinalPair.Carrier z}} (FinalPair.class z) _ _
          (congr!{WholeMaps.Map {FinalExtension.Carrier z}} (\fun (m: WholeMaps.Map) => (m).apply z x) _ _ whole))
        (sym!{{FinalPair.Carrier z}} _ _ (CompositeMap.At[z := z].quotientOnClass x))));
