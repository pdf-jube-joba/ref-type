\import Complexes.Map[C := SubspaceExtension.complex, D := TargetSubspaceExtension.complex] \as SubspaceMaps;
\import Complexes.Map[C := WholeExtension.complex, D := TargetWholeExtension.complex] \as WholeMaps;
\definition SubspaceQuasi: \Prop := SubspaceMaps.QuasiIsomorphism SubspaceMap.map;
\definition WholeQuasi: \Prop := WholeMaps.QuasiIsomorphism WholeMap.map;
\module At(z: I.Int^) {
  \import Complexes.Map[C := complex, D := TargetPair.complex].At[k := z] \as RelativeMaps;
  \import Complexes.At[C := complex, z := z] \as SourceH;
  \import Complexes.At[C := TargetPair.complex, z := z] \as TargetH;
  \definition bijective: SubspaceQuasi -> WholeQuasi -> RelativeMaps.Bijective[map] :=
    \fun (subspace: SubspaceQuasi)(whole: WholeQuasi) => Diagram.At[k := z].Comparison[].bijective diagram
      (subspace z) (whole z) (subspace (Degrees.previous z)) (whole (Degrees.previous z));
  \definition isomorphism[subspace: SubspaceQuasi][whole: WholeQuasi]: Modules.Isomorphism[V := SourceH.Homology, W := TargetH.Homology, source := SourceH.homologySpace, target := TargetH.homologySpace].Isomorphism :=
    RelativeMaps.Invert[f := map].isomorphism (bijective subspace whole);
}
