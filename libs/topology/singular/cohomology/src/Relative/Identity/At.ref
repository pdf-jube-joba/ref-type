\definition onClass: \forall (x: WholeExtension.Carrier z) -> (Mapping.map).apply z (class z x) = class z x :=
  \fun (x: WholeExtension.Carrier z) => trans!{{Carrier z}} _ _ _ (Mapping.At[z := z].quotientOnClass x)
    (congr!{{WholeExtension.Carrier z} {Carrier z}} (class z) _ _
      (congr!{WholeMaps.Map {WholeExtension.Carrier z}} (\fun (f: WholeMaps.Map) => (f).apply z x) _ _ Whole.Integer[].law));
