\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Proposition[] \as Logic;
\import Chains.At[C := Source.complex, z := z] \as SourceH;
\import Chains.At[C := Target.complex, z := z] \as TargetH;
\import ForwardMaps.At[k := z] \as ForwardH;
\import BackwardMaps.At[k := z] \as BackwardH;
\definition forwardMap: Modules.Hom[V := SourceH.Homology, W := TargetH.Homology, source := SourceH.homologySpace, target := TargetH.homologySpace].Map := ForwardH.induced forward;
\definition backwardMap: Modules.Hom[V := TargetH.Homology, W := SourceH.Homology, source := TargetH.homologySpace, target := SourceH.homologySpace].Map := BackwardH.induced backward;
\definition leftInverse: \forall (q: SourceH.Homology) -> (backwardMap).apply ((forwardMap).apply q) = q := \block {
  \fun (q: SourceH.Homology) \then
  \takefrom h: LeftHomotopies.Homotopy[source, source, (\fun (x: A) => e.backward (e.forward x)), SourceIdentity.function]
    \by (Geometry.laws source target e).leftInverse \then
  \return eq_reason_in!{SourceH.Homology _
    "=" _ "by" { sym!{SourceH.Homology} _ _ (LeftComposition.At[k := z].compositionOnHomology backward forward q) }
    "=" _ "by" { congr!{SourceMaps.Map SourceH.Homology} (\fun (m: SourceMaps.Map) => (SourceMaps.At[k := z].induced m).apply q) _ _
        (LeftFunctor.law e.forward ((Geometry.laws source target e).forwardContinuous) e.backward ((Geometry.laws source target e).backwardContinuous)) }
    "=" _ "by" { Left.Reduced[].Homology[z := z].law (\fun (x: A) => e.backward (e.forward x)) SourceIdentity.function h q }
    "=" _ "by" { congr!{SourceMaps.Map SourceH.Homology} (\fun (m: SourceMaps.Map) => (SourceMaps.At[k := z].induced m).apply q) _ _ SourceIdentity.Reduced[].law }
    "=" _ "by" { Chains.End[C := Source.complex].At[k := z].identityOnHomology q }
  }
};
\definition rightInverse: \forall (q: TargetH.Homology) -> (forwardMap).apply ((backwardMap).apply q) = q := \block {
  \fun (q: TargetH.Homology) \then
  \takefrom h: RightHomotopies.Homotopy[target, target, (\fun (x: B) => e.forward (e.backward x)), TargetIdentity.function]
    \by (Geometry.laws source target e).rightInverse \then
  \return eq_reason_in!{TargetH.Homology _
    "=" _ "by" { sym!{TargetH.Homology} _ _ (RightComposition.At[k := z].compositionOnHomology forward backward q) }
    "=" _ "by" { congr!{TargetMaps.Map TargetH.Homology} (\fun (m: TargetMaps.Map) => (TargetMaps.At[k := z].induced m).apply q) _ _
        (RightFunctor.law e.backward ((Geometry.laws source target e).backwardContinuous) e.forward ((Geometry.laws source target e).forwardContinuous)) }
    "=" _ "by" { Right.Reduced[].Homology[z := z].law (\fun (x: B) => e.forward (e.backward x)) TargetIdentity.function h q }
    "=" _ "by" { congr!{TargetMaps.Map TargetH.Homology} (\fun (m: TargetMaps.Map) => (TargetMaps.At[k := z].induced m).apply q) _ _ TargetIdentity.Reduced[].law }
    "=" _ "by" { Chains.End[C := Target.complex].At[k := z].identityOnHomology q }
  }
};
\definition isomorphism: Modules.Isomorphism[V := SourceH.Homology, W := TargetH.Homology, source := SourceH.homologySpace, target := TargetH.homologySpace].Isomorphism :=
  Modules.Isomorphism[V := SourceH.Homology, W := TargetH.Homology, source := SourceH.homologySpace, target := TargetH.homologySpace].Isomorphism {
    forward := forwardMap, backward := backwardMap, leftInverse := leftInverse, rightInverse := rightInverse,
  };
\definition bijective: ForwardH.Bijective[forward] := ForwardH.Bijective[forward] {
  injective := \fun (x, y: SourceH.Homology)(equal: (forwardMap).apply x = (forwardMap).apply y) =>
    eq_reason_in!{SourceH.Homology _
      "=" _ "by" { sym!{SourceH.Homology} _ _ (leftInverse x) }
      "=" _ "by" { congr!{TargetH.Homology SourceH.Homology} ((backwardMap).apply) _ _ equal }
      "=" _ "by" { leftInverse y }
    },
  onto := \fun (y: TargetH.Homology) => Logic.existsIntro[SourceH.Homology, { x: SourceH.Homology \where (forwardMap).apply x = y }]
    ((backwardMap).apply y) (rightInverse y),
};
