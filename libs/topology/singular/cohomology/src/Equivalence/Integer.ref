\import \root.Chains[A := A, source := source] \as SourceChains;
\import \root.Chains[A := B, source := target] \as TargetChains;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import Nonnegative.ZeroExtension[C := SourceChains.complex] \as Source;
\import Nonnegative.ZeroExtension[C := TargetChains.complex] \as Target;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import Chains.Map[C := Source.complex, D := Target.complex] \as ForwardMaps;
\import Chains.Map[C := Target.complex, D := Source.complex] \as BackwardMaps;
\import Chains.Map[C := Source.complex, D := Source.complex] \as SourceMaps;
\import Chains.Map[C := Target.complex, D := Target.complex] \as TargetMaps;
\import BackwardMaps.Composition[B := Source.complex] \as LeftComposition;
\import ForwardMaps.Composition[B := Target.complex] \as RightComposition;
\import Forward.Composition[C := A, final := source].Integer[] \as LeftFunctor;
\import Backward.Composition[C := B, final := target].Integer[] \as RightFunctor;
\definition forward: ForwardMaps.Map := Forward.integerPush e.forward ((Geometry.laws source target e).forwardContinuous);
\definition backward: BackwardMaps.Map := Backward.integerPush e.backward ((Geometry.laws source target e).backwardContinuous);
\module Homology(z: I.Int^);
\module With(coefficients: Modules.Bundle);
