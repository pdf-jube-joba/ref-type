\import \parent.Between[m := n, n := n] \as Between;
\import \parent.\parent.Reindex[m := n, n := n] \as Reindex;
\import Simplex.ReindexIdentity[n := n] \as Geometry;
\import \parent.\parent.ReindexIdentity[n := n] \as Identity;
\definition indices: \forall (same: n = n) -> Between.indices same = Geometry.identity :=
  \fun (same: n = n) => \axiom:funext(Between.indices same, Geometry.identity,
    \fun (i: Indices n) => Transport.castRefl Indices n i);
\definition law: \forall (same: n = n)(sigma: Carrier n) -> Between.apply same sigma = sigma :=
  \fun (same: n = n)(sigma: Carrier n) => trans!{{Carrier n}} _ _ _
    (congr!{Reindex.Function {Carrier n}} (\fun (f: Reindex.Function) => Reindex.apply f sigma) _ _ (indices same))
    (Identity.law sigma);
