\import \parent.\parent.Reindex[m := m, n := n] \as Reindex;
\definition indices[same: m = n][i: Indices m]: Indices n := Transport.cast Indices m n same i;
\definition apply[same: m = n][sigma: Carrier n]: Carrier m := Reindex.apply (indices same) sigma;
\import Transport.Constant[C := N.Nat^] \as Constants;
\definition value: \forall (same: m = n)(i: Indices m) -> Fin.value (N.Nat^::succ n) (indices same i) = Fin.value (N.Nat^::succ m) i :=
  \fun (same: m = n)(i: Indices m) => trans!{N.Nat^} _ _ _
    (sym!{N.Nat^} _ _ (Transport.natural Indices (\fun (_: N.Nat^) => N.Nat^) (\fun (k: N.Nat^)(j: Indices k) => j) m n same i))
    (Constants.law m n i same);
