\import \parent.Cut[p := p, q := N.Nat^::zero] \as Cut;
\import Simplex.Cut[p := p, q := N.Nat^::zero] \as Geometry;
\import Simplex.ReindexIdentity[n := p] \as IdentityIndices;
\import \parent.Reindex[m := p, n := p] \as Restriction;
\import \parent.ReindexIdentity[n := p] \as Identity;
\use Equality.trans;
\definition indices: Geometry.frontIndex = IdentityIndices.identity :=
  \axiom:funext(Geometry.frontIndex, IdentityIndices.identity, \fun (i: Fin.Fin (N.Nat^::succ p)) => \refl(i));
\definition law: \forall (sigma: Carrier p) -> Cut.front sigma = sigma :=
  \fun (sigma: Carrier p) => trans!{{Carrier p}} _ _ _
    (congr!{Restriction.Function {Carrier p}} (\fun (f: Restriction.Function) => Restriction.apply f sigma) _ _ indices)
    (Identity.law sigma);
