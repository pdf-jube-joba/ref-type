\import \parent.\parent.\parent.Reindex[m := N.Nat^::succ p, n := leftDegree].Composition[k := p] \as FirstComposition;
\import \parent.\parent.\parent.Reindex[m := leftDegree, n := higher].Composition[k := p] \as SecondComposition;
\import \parent.\parent.\parent.Reindex[m := p, n := higher] \as Direct;
\definition leftIndices[j: Fin.Fin (N.Nat^::succ p)]: Fin.Fin (N.Nat^::succ higher) := Between.indices same (LeftIndices.frontIndex (LeftFace.skip lastLeft j));
\definition indices: leftIndices = RightIndices.frontIndex := \axiom:funext(leftIndices, RightIndices.frontIndex,
  \fun (j: Fin.Fin (N.Nat^::succ p)) => trans!{N.Nat^} _ _ _
    (Between.value same (LeftIndices.frontIndex (LeftFace.skip lastLeft j)))
    (LeftFace.before lastLeft j (Fin.bound (N.Nat^::succ p) j)));
\definition flat: \forall (sigma: Carrier higher) -> face p lastLeft (Left.front (leftSimplex sigma)) = Direct.apply leftIndices sigma :=
  \fun (sigma: Carrier higher) => trans!{{Carrier p}} _ _ _ (LeftFace.law lastLeft (Left.front (leftSimplex sigma)))
    (trans!{{Carrier p}} _ _ _ (FirstComposition.law LeftIndices.frontIndex (LeftFace.skip lastLeft) (leftSimplex sigma))
      (SecondComposition.law (Between.indices same) (\fun (j: Fin.Fin (N.Nat^::succ p)) => LeftIndices.frontIndex (LeftFace.skip lastLeft j)) sigma));
\definition law: \forall (sigma: Carrier higher) -> face p lastLeft (Left.front (leftSimplex sigma)) = Right.front sigma :=
  \fun (sigma: Carrier higher) => trans!{{Carrier p}} _ _ _ (flat sigma)
    (congr!{Direct.Function {Carrier p}} (\fun (f: Direct.Function) => Direct.apply f sigma) leftIndices RightIndices.frontIndex indices);
