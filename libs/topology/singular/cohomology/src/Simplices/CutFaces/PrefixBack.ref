\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Reindex[m := total, n := higher].Composition[k := q] \as NativeComposition;
\import \parent.\parent.Reindex[m := leftDegree, n := higher].Composition[k := q] \as LeftComposition;
\import \parent.\parent.Reindex[m := q, n := higher] \as Direct;
\definition leftIndices[i: Fin.Fin (N.Nat^::succ p)][j: Fin.Fin (N.Nat^::succ q)]: Fin.Fin (N.Nat^::succ higher) := NativeFace.skip (prefix i) (CutIndices.backIndex j);
\definition rightIndices[j: Fin.Fin (N.Nat^::succ q)]: Fin.Fin (N.Nat^::succ higher) := Between.indices same (LeftIndices.backIndex j);
\definition indices: \forall (i: Fin.Fin (N.Nat^::succ p)) -> leftIndices i = rightIndices :=
  \fun (i: Fin.Fin (N.Nat^::succ p)) => \axiom:funext(leftIndices i, rightIndices, \fun (j: Fin.Fin (N.Nat^::succ q)) =>
    trans!{N.Nat^} _ _ _ (NativeFace.after (prefix i) (CutIndices.backIndex j) (Bounds.leTrans (prefix i) p (Nat.add p j) (prefixBound i) (Bounds.leAddRight p j)))
      (sym!{N.Nat^} _ _ (trans!{N.Nat^} _ _ _ (Between.value same (LeftIndices.backIndex j)) (Bounds.addSuccLeft p j))));
\definition law: \forall (i: Fin.Fin (N.Nat^::succ p))(sigma: Carrier higher) -> Cut.back (face total (prefix i) sigma) = Left.back (leftSimplex sigma) :=
  \fun (i: Fin.Fin (N.Nat^::succ p))(sigma: Carrier higher) => eq_reason_in!{{Carrier q} _
    "=" _ "by" { congr!{{Carrier total} {Carrier q}} Cut.back _ _ (NativeFace.law (prefix i) sigma) }
    "=" _ "by" { NativeComposition.law (NativeFace.skip (prefix i)) CutIndices.backIndex sigma }
    "=" _ "by" { congr!{Direct.Function {Carrier q}} (\fun (f: Direct.Function) => Direct.apply f sigma) (leftIndices i) rightIndices (indices i) }
    "=" _ "by" { sym!{{Carrier q}} _ _ (LeftComposition.law (Between.indices same) LeftIndices.backIndex sigma) }
  };
