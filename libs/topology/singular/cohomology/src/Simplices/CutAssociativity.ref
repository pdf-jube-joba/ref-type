\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as Arithmetic;
\use Equality.trans;
\use Equality.sym;
\definition pq: N.Nat^ := Nat.add p q;
\definition qr: N.Nat^ := Nat.add q r;
\definition leftDegree: N.Nat^ := Nat.add pq r;
\definition rightDegree: N.Nat^ := Nat.add p qr;
\definition same: rightDegree = leftDegree := sym!{N.Nat^} _ _ (Arithmetic.addAssoc p q r);
\import \parent.Cut[p := p, q := q] \as PQ;
\import \parent.Cut[p := pq, q := r] \as Left;
\import \parent.Cut[p := q, q := r] \as QR;
\import \parent.Cut[p := p, q := qr] \as Right;
\import Simplex.Cut[p := p, q := q] \as PQIndices;
\import Simplex.Cut[p := pq, q := r] \as LeftIndices;
\import Simplex.Cut[p := q, q := r] \as QRIndices;
\import Simplex.Cut[p := p, q := qr] \as RightIndices;
\import \parent.ReindexTransport[] \as Transport;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as NatTransport;
\import Transport.Between[m := rightDegree, n := leftDegree] \as Between;
\definition rightSimplex[sigma: Carrier leftDegree]: Carrier rightDegree := Between.apply same sigma;
\definition rightSimplexLaw: \forall (sigma: Carrier leftDegree) -> rightSimplex sigma = NatTransport.cast Carrier leftDegree rightDegree (Arithmetic.addAssoc p q r) sigma :=
  \fun (sigma: Carrier leftDegree) => Transport.law rightDegree leftDegree same sigma;
\module First;
\module Middle;
\module Last;
