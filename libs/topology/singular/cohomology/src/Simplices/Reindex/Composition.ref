\import \parent.\parent.Reindex[m := k, n := m] \as Earlier;
\import \parent.\parent.Reindex[m := k, n := n] \as Direct;
\import \parent.\parent.At[n := k] \as Result;
\import Simplex.Reindex[m := k, n := m].Composition[k := n] \as GeometricComposition;
\definition law: \forall (f: Function)(g: Earlier.Function)(sigma: Carrier n) ->
  Earlier.apply g (apply f sigma) = Direct.apply (\fun (i: Fin.Fin (N.Nat^::succ k)) => f (g i)) sigma :=
  \fun (f: Function)(g: Earlier.Function)(sigma: Carrier n) =>
    Result.ext (Earlier.apply g (apply f sigma)) (Direct.apply (\fun (i: Fin.Fin (N.Nat^::succ k)) => f (g i)) sigma)
      (\fun (x: Simplex.Carrier k) => congr!{{Simplex.Carrier n} A} sigma _ _ (GeometricComposition.law g f x));
