\import \parent.Functions[] \as Functions;
\import Modules.Functions[X := Components.Carrier, V := coefficients.Carrier, target := coefficients.space].Singleton[point := Components.class point] \as Constants;
\definition unique: Components.PathConnected -> \forall (c: Components.Carrier) -> c = Components.class point :=
  \fun (connected: Components.PathConnected) => Components.induction (\fun (c: Components.Carrier) => c = Components.class point)
    (\fun (x: A) => Components.sameClass x point (connected x point));
\import Modules.Isomorphism[V := coefficients.Carrier, W := Functions.Function, source := coefficients.space, target := Functions.functionSpace]
  .Composition[U := H.Cohomology, final := H.cohomologySpace] \as Composition;
\definition isomorphism[connected: Components.PathConnected]: Modules.Isomorphism[V := coefficients.Carrier, W := H.Cohomology, source := coefficients.space, target := H.cohomologySpace].Isomorphism :=
  Composition.compose Functions.isomorphism (Constants.isomorphism (unique connected));
