\import algebraic_topology.Cylinder[A := Simplex.Carrier n] \as Geometric;
\import algebraic_topology.Interval[] \as Interval;
\import Simplex.At[n := n] \as Domain;
\import \parent.At[m := n] \as Evaluation;
\definition simplex[t: Interval.Carrier]: Simplices.Carrier n :=
  \into[Simplices.At[n := n].Function](Geometric.at t, Simplices.Carrier n) \by { Geometric.atContinuous Domain.topology t };
\definition simplexEquality: \forall (t: Interval.Carrier) -> Evaluation.onTuple (Space.vertices t) = simplex t :=
  \fun (t: Interval.Carrier) => Simplices.ext n (Evaluation.onTuple (Space.vertices t)) (simplex t) (Space.law t);
\definition onGenerator: \forall (t: Interval.Carrier) ->
  (Evaluation.map).apply (Tuples.generator (N.Nat^::succ n) (Space.vertices t)) = Chains.generator n (simplex t) :=
  \fun (t: Interval.Carrier) => trans!{{Chains.Carrier n}} _ _ _ (Evaluation.onGenerator (Space.vertices t))
    (congr!{{Simplices.Carrier n} {Chains.Carrier n}} (Chains.generator n) _ _ (simplexEquality t));
