\import \root.SimplicialChains[].On[X := Y] \as Target;
\import algebraic_topology.Semisimplicial[].Maps[X := X, Y := Y] \as Simplicial;
\module At(n: N.Nat^) {
  \import Modules.Free[Generators := X.family.Carrier n].Reindex[TargetGenerators := Y.family.Carrier n] \as Reindex;
  \definition push[f: Simplicial.Map]: Modules.Hom[V := Carrier n, W := Target.Carrier n, source := space n, target := Target.space n].Map := Reindex.push ((f).apply n);
  \definition onGenerator: \forall (f: Simplicial.Map)(sigma: X.family.Carrier n) -> (push f).apply (generator n sigma) = Target.generator n ((f).apply n sigma) :=
    \fun (f: Simplicial.Map) => Reindex.onGenerator ((f).apply n);
}
\module Differential(n: N.Nat^);
\definition map[f: Simplicial.Map]: Complexes.Map[C := complex, D := Target.complex].Map := Complexes.Map[C := complex, D := Target.complex].Map {
  apply := \fun (n: N.Nat^) => (At[n := n].push f).apply,
  addition := \fun (n: N.Nat^) => (At[n := n].push f).addition,
  scalar := \fun (n: N.Nat^) => (At[n := n].push f).scalar,
  commutes := \fun (n: N.Nat^) => Differential[n := n].commutes f,
};
