\use std.Logic[].Equality[].eq_reason_in;
\import Domain.Augmentation[] \as SourceAugmentation;
\import Codomain.Augmentation[] \as TargetAugmentation;
\import Modules.Hom[V := Codomain.Carrier N.Nat^::zero, W := I.Int^, source := Codomain.space N.Nat^::zero, target := Modules.scalarModule]
  .Composition[U := Domain.Carrier N.Nat^::zero, domain := Domain.space N.Nat^::zero] \as Composition;
\import Modules.Hom[V := Domain.Carrier N.Nat^::zero, W := I.Int^, source := Domain.space N.Nat^::zero, target := Modules.scalarModule] \as Maps;
\import Modules.Free[Generators := Source.Carrier N.Nat^::zero].To[W := I.Int^, target := Modules.scalarModule] \as Free;
\definition onGenerator: \forall (f: A -> B)(continuous: Continuous f)(sigma: Source.Carrier N.Nat^::zero) ->
  (TargetAugmentation.map).apply ((\parent.At[n := N.Nat^::zero].push f continuous).apply (Domain.generator N.Nat^::zero sigma)) =
  (SourceAugmentation.map).apply (Domain.generator N.Nat^::zero sigma) :=
  \fun (f: A -> B)(continuous: Continuous f)(sigma: Source.Carrier N.Nat^::zero) => eq_reason_in!{I.Int^ _
    "=" _ "by" { congr!{{Codomain.Carrier N.Nat^::zero} I.Int^} ((TargetAugmentation.map).apply) _ _ (\parent.At[n := N.Nat^::zero].onGenerator f continuous sigma) }
    "=" _ "by" { TargetAugmentation.onGenerator (postcompose N.Nat^::zero f continuous sigma) }
    "=" _ "by" { sym!{I.Int^} _ _ (SourceAugmentation.onGenerator sigma) }
  };
\definition mapLaw: \forall (f: A -> B)(continuous: Continuous f) -> Composition.compose TargetAugmentation.map (\parent.At[n := N.Nat^::zero].push f continuous) = SourceAugmentation.map :=
  \fun (f: A -> B)(continuous: Continuous f) => Free.ext _ _ (onGenerator f continuous);
\definition naturality: \forall (f: A -> B)(continuous: Continuous f)(x: Domain.Carrier N.Nat^::zero) ->
  (TargetAugmentation.map).apply ((\parent.At[n := N.Nat^::zero].push f continuous).apply x) = (SourceAugmentation.map).apply x :=
  \fun (f: A -> B)(continuous: Continuous f)(x: Domain.Carrier N.Nat^::zero) => congr!{Maps.Map I.Int^} (\fun (m: Maps.Map) => (m).apply x) _ _ (mapLaw f continuous);
