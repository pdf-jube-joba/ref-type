\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := FinalChains.complex] \as FinalExtension;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import Chains.Map[C := SourceExtension.complex, D := FinalExtension.complex] \as IntegerResult;
\import Chains.Map[C := TargetExtension.complex, D := FinalExtension.complex].Composition[B := SourceExtension.complex] \as Composition;
\definition action[arrow: Result.Map]: IntegerResult.Map := Result.ZeroExtension[f := arrow].map;
\definition law: \forall (f: A -> B)(fc: Continuous f)(g: B -> C)(gc: After.Continuous g) ->
  Composition.compose (After.integerPush g gc) (integerPush f fc) = Direct.integerPush (\fun (x: A) => g (f x)) (Topology.composeContinuous source target final f g fc gc) :=
  \fun (f: A -> B)(fc: Continuous f)(g: B -> C)(gc: After.Continuous g) => trans!{IntegerResult.Map} _ _ _
    (sym!{IntegerResult.Map} _ _ (Compose.ZeroExtension[f := After.push g gc, g := push f fc].law))
    (congr!{Result.Map IntegerResult.Map} action _ _ (functoriality f fc g gc));
