\import Domain.DegreeTransport[] \as SourceDegrees;
\import Codomain.DegreeTransport[] \as TargetDegrees;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition law: \forall (m, n: N.Nat^)(same: m = n)(f: A -> B)(continuous: Continuous f)(x: Domain.Carrier m) ->
  TargetDegrees.apply m n same ((push f continuous).apply m x) = (push f continuous).apply n (SourceDegrees.apply m n same x) :=
  \fun (m, n: N.Nat^)(same: m = n)(f: A -> B)(continuous: Continuous f)(x: Domain.Carrier m) =>
    Transport.natural Domain.Carrier Codomain.Carrier (\fun (k: N.Nat^) => (push f continuous).apply k) m n same x;
