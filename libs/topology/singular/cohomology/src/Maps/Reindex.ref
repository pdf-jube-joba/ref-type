\import Source.Reindex[m := m, n := n] \as SourceRestriction;
\import Target.Reindex[m := m, n := n] \as TargetRestriction;
\definition law: \forall (f: A -> B)(continuous: Continuous f)(indices: SourceRestriction.Function)(sigma: Source.Carrier n) ->
  TargetRestriction.apply indices (postcompose n f continuous sigma) = postcompose m f continuous (SourceRestriction.apply indices sigma) :=
  \fun (f: A -> B)(continuous: Continuous f)(indices: SourceRestriction.Function)(sigma: Source.Carrier n) =>
    \refl(postcompose m f continuous (SourceRestriction.apply indices sigma));
