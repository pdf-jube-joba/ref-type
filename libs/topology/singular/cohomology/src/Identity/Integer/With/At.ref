\use std.Logic[].Equality[].eq_reason_in;
\import Theory.At[C := Cochains.complex, z := z] \as H;
\import CochainMaps.At[k := z] \as Actions;
\import std.Logic[].Proposition[] \as Logic;
\use Equality.sym;
\definition onCohomology: \forall (q: H.Cohomology) -> (Actions.induced pullback).apply q = q :=
  \fun (q: H.Cohomology) => trans!{H.Cohomology} _ _ _
    (congr!{CochainMaps.Map H.Cohomology} (\fun (f: CochainMaps.Map) => (Actions.induced f).apply q) _ _ identityLaw)
    (Identity.At[k := z].onCohomology q);
\definition bijective: Actions.Bijective[pullback] := Actions.Bijective[pullback] {
  injective := \fun (x, y: H.Cohomology)(equal: _) => eq_reason_in!{H.Cohomology _
    "=" _ "by" { sym!{H.Cohomology} _ _ (onCohomology x) }
    "=" _ "by" equal
    "=" _ "by" { onCohomology y }
  },
  onto := \fun (q: H.Cohomology) => Logic.existsIntro[H.Cohomology, { x: H.Cohomology \where (Actions.induced pullback).apply x = q }] q (onCohomology q),
};
