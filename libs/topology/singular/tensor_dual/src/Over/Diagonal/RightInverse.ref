\import Primal.To[W := R, target := Modules.scalarModule] \as Universal;
\definition point[h: Target.Carrier][i: Index][x: family.Carrier i]: ((forward).apply ((backward).apply h)).apply ((Primal.Injection[i := i].map).apply x) = (h).apply ((Primal.Injection[i := i].map).apply x) :=
  trans!{R} _ _ _ (\parent.Coordinate[].Evaluation[i := i, x := x].law ((backward).apply h))
    (congr!{{dualFamily.Carrier i} R} (\fun (f: dualFamily.Carrier i) => (f).apply x) _ _ (backwardCoordinate h i));
\definition law[h: Target.Carrier]: (forward).apply ((backward).apply h) = h := Universal.ext ((forward).apply ((backward).apply h)) h (point h);
