\use std.Logic[].Equality[].eq_reason_in;
\import VectorSum.Mapping[W := R, target := Modules.scalarModule] \as Evaluation;
\definition value[f: Left.Carrier][x: V.Carrier]: (f).apply x = ScalarSum.sum Frame.indices (\fun (i: Frame.Index) => mul ((frame.coordinate i).apply x) ((f).apply (frame.basis i))) :=
  eq_reason_in!{R _
    "=" _ "by" { congr!{V.Carrier R} ((f).apply) _ _ (sym!{V.Carrier} _ _ (Frame.decomposition frame x)) }
    "=" _ "by" { Evaluation.law f Frame.indices (\fun (i: Frame.Index) => (V.space).smul ((frame.coordinate i).apply x) (frame.basis i)) }
    "=" _ "by" { ScalarSum.congruent Frame.indices
        (\fun (i: Frame.Index) => (f).apply ((V.space).smul ((frame.coordinate i).apply x) (frame.basis i)))
        (\fun (i: Frame.Index) => mul ((frame.coordinate i).apply x) ((f).apply (frame.basis i)))
        (\fun (i: Frame.Index) => (f).scalar ((frame.coordinate i).apply x) (frame.basis i)) }
  };
\definition evaluation[x: V.Carrier]: Modules.Hom[V := Left.Carrier, W := R, source := Left.space, target := Modules.scalarModule].Map := Modules.Hom[V := Left.Carrier, W := R, source := Left.space, target := Modules.scalarModule].Map {
  apply := \fun (f: Left.Carrier) => (f).apply x,
  addition := \fun (f, g: Left.Carrier) => \refl(add ((f).apply x) ((g).apply x)),
  scalar := \fun (a: R)(f: Left.Carrier) => \refl(mul a ((f).apply x)),
};
\import DualSum.Mapping[W := R, target := Modules.scalarModule] \as EvaluateDual;
\definition dual[f: Left.Carrier]: DualSum.sum Frame.indices (\fun (i: Frame.Index) => (Left.space).smul ((f).apply (frame.basis i)) (frame.coordinate i)) = f :=
  LeftMaps.ext
    (DualSum.sum Frame.indices (\fun (i: Frame.Index) => (Left.space).smul ((f).apply (frame.basis i)) (frame.coordinate i))) f
    (\fun (x: V.Carrier) => eq_reason_in!{R _
      "=" _ "by" { EvaluateDual.law (evaluation x) Frame.indices (\fun (i: Frame.Index) => (Left.space).smul ((f).apply (frame.basis i)) (frame.coordinate i)) }
      "=" _ "by" { ScalarSum.congruent Frame.indices
          (\fun (i: Frame.Index) => mul ((f).apply (frame.basis i)) ((frame.coordinate i).apply x))
          (\fun (i: Frame.Index) => mul ((frame.coordinate i).apply x) ((f).apply (frame.basis i)))
          (\fun (i: Frame.Index) => (ring).mulCommutative ((f).apply (frame.basis i)) ((frame.coordinate i).apply x)) }
      "=" _ "by" { sym!{R} _ _ (value f x) }
    });
