\module At(n: N.Nat^) {
  \definition bundle: Modules.Bundle := Modules.Bundle { Carrier := P.family.Carrier n, space := P.family.space n };
  \definition Frame: \Set := \parent.\parent.Finite[V := bundle, rank := ranks n].Frame;
}
\definition Frames: \Set := \forall (n: N.Nat^) -> At[n := n].Frame;
