\import Modules.Hom[V := DualSum.Carrier, W := SourceTerm.Carrier, source := DualSum.space, target := SourceTerm.space].Composition[U := SourceTerm.Carrier, domain := SourceTerm.space] \as LeftComposition;
\import Modules.Hom[V := SourceTerm.Carrier, W := DualSum.Carrier, source := SourceTerm.space, target := DualSum.space].Composition[U := DualSum.Carrier, domain := DualSum.space] \as RightComposition;
\import Modules.End[V := SourceTerm.Carrier, space := SourceTerm.space] \as SourceEnd;
\import Modules.End[V := DualSum.Carrier, space := DualSum.space] \as DualEnd;
\import SourceSum.To[W := SourceTerm.Carrier, target := SourceTerm.space] \as SourceUniversal;
\import DualSum.To[W := DualSum.Carrier, target := DualSum.space] \as DualUniversal;
\definition leftEquality: LeftComposition.compose fromDual toDual = SourceEnd.identity :=
  SourceUniversal.ext (LeftComposition.compose fromDual toDual) SourceEnd.identity
    (\fun (i: Double.Index n)(x: SourceTerm.family.Carrier i) => trans!{SourceTerm.Carrier} _ _ _
      (congr!{DualSum.Carrier SourceTerm.Carrier} ((fromDual).apply) _ _ (ForwardMapping.onInjection forwards i x))
      (trans!{SourceTerm.Carrier} _ _ _ (BackwardMapping.onInjection backwards i ((forwards i).apply x))
        (congr!{{SourceTerm.family.Carrier i} SourceTerm.Carrier} ((SourceSum.Injection[i := i].map).apply) _ _ ((\parent.Component[i := i].isomorphism).leftInverse x))));
\definition rightEquality: RightComposition.compose toDual fromDual = DualEnd.identity :=
  DualUniversal.ext (RightComposition.compose toDual fromDual) DualEnd.identity
    (\fun (i: Double.Index n)(x: Diagonal.dualFamily.Carrier i) => trans!{DualSum.Carrier} _ _ _
      (congr!{SourceTerm.Carrier DualSum.Carrier} ((toDual).apply) _ _ (BackwardMapping.onInjection backwards i x))
      (trans!{DualSum.Carrier} _ _ _ (ForwardMapping.onInjection forwards i ((backwards i).apply x))
        (congr!{{Diagonal.dualFamily.Carrier i} DualSum.Carrier} ((DualSum.Injection[i := i].map).apply) _ _ ((\parent.Component[i := i].isomorphism).rightInverse x))));
\definition left[x: SourceTerm.Carrier]: (fromDual).apply ((toDual).apply x) = x :=
  congr!{{Modules.Hom[V := SourceTerm.Carrier, W := SourceTerm.Carrier, source := SourceTerm.space, target := SourceTerm.space].Map} SourceTerm.Carrier}
    (\fun (f: Modules.Hom[V := SourceTerm.Carrier, W := SourceTerm.Carrier, source := SourceTerm.space, target := SourceTerm.space].Map) => (f).apply x) _ _ leftEquality;
\definition right[x: DualSum.Carrier]: (toDual).apply ((fromDual).apply x) = x :=
  congr!{{Modules.Hom[V := DualSum.Carrier, W := DualSum.Carrier, source := DualSum.space, target := DualSum.space].Map} DualSum.Carrier}
    (\fun (f: Modules.Hom[V := DualSum.Carrier, W := DualSum.Carrier, source := DualSum.space, target := DualSum.space].Map) => (f).apply x) _ _ rightEquality;
