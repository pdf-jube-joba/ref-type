\import Modules.FiniteCoordinates[n := rank] \as Native;
\definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Native.Carrier, space := Native.space };
\import \parent.\parent.Finite[V := bundle, rank := rank] \as Result;
\definition data: Result.Data := Result.Data { basis := Native.basis, coordinate := Native.evaluation };
\definition frame: Result.Frame := \into[Result.Data](data, Result.Frame) \by { Result.Laws[data] { decomposition := Native.decomposition } };
