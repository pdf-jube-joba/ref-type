\definition Index: \Set := Fin.Fin rank;
\import IntegerModules.FiniteCoordinates[n := rank] \as Coordinates;
\import Modules.FiniteCoordinates[n := rank] \as ScalarCoordinates;
\import \parent.\parent.IntegerCoordinates[rank := rank] \as CoordinateDual;
\import \parent.Dual[V := V] \as Dual;
\definition Frame: \Set := IntegerModules.Isomorphism[V := V.Carrier, W := Coordinates.Carrier, source := V.space, target := Coordinates.space].Isomorphism;
\definition indices: Lists.List[Index] := ScalarCoordinates.indices;
\module With(frame: Frame);
