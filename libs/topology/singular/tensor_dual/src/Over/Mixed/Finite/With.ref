\use std.Logic[].Equality[].eq_reason_in;
\definition basis[i: Index]: V.Carrier := ((frame).backward).apply (Coordinates.basis i);
\import IntegerModules.Hom[V := V.Carrier, W := R, source := V.space, target := Coefficients.coefficients.space] \as Hom;
\import Hom.Composition[U := Coordinates.Carrier, domain := Coordinates.space] \as Restrict;
\definition restrict[f: Dual.Carrier]: CoordinateDual.Carrier := Restrict.compose f (frame).backward;
\import IntegerModules.Hom[V := Coordinates.Carrier, W := R, source := Coordinates.space, target := Coefficients.coefficients.space].Composition[U := V.Carrier, domain := V.space] \as Extend;
\definition extend[f: CoordinateDual.Carrier]: Dual.Carrier := Extend.compose f (frame).forward;
\import Modules.Hom[V := Dual.Carrier, W := ScalarCoordinates.Carrier, source := Dual.space, target := ScalarCoordinates.space] \as Evaluation;
\definition evaluation: Evaluation.Map := Evaluation.Map {
  apply := \fun (f: Dual.Carrier)(i: Index) => (f).apply (basis i),
  addition := \fun (f, g: Dual.Carrier) => \axiom:funext(
    \fun (i: Index) => ((Dual.space).add f g).apply (basis i),
    (ScalarCoordinates.space).add (\fun (i: Index) => (f).apply (basis i)) (\fun (i: Index) => (g).apply (basis i)),
    \fun (i: Index) => \refl(add ((f).apply (basis i)) ((g).apply (basis i)))),
  scalar := \fun (a: R)(f: Dual.Carrier) => \axiom:funext(
    \fun (i: Index) => ((Dual.space).smul a f).apply (basis i),
    (ScalarCoordinates.space).smul a (\fun (i: Index) => (f).apply (basis i)),
    \fun (i: Index) => \refl(mul a ((f).apply (basis i)))),
};
\definition injective: \forall (f, g: Dual.Carrier) -> (evaluation).apply f = (evaluation).apply g -> f = g :=
  \fun (f, g: Dual.Carrier)(equal: _) => Hom.ext f g (\fun (x: V.Carrier) => \block {
    \let same: restrict f = restrict g := CoordinateDual.injective (restrict f) (restrict g) equal \then
    \return eq_reason_in!{R _
      "=" _ "by" { sym!{R} _ _ (congr!{V.Carrier R} ((f).apply) _ _ ((frame).leftInverse x)) }
      "=" _ "by" { congr!{CoordinateDual.Carrier R} (\fun (h: CoordinateDual.Carrier) => (h).apply (((frame).forward).apply x)) _ _ same }
      "=" _ "by" { congr!{V.Carrier R} ((g).apply) _ _ ((frame).leftInverse x) }
    }
  });
\definition extension[values: ScalarCoordinates.Carrier]: Dual.Carrier := extend (((CoordinateDual.isomorphism).backward).apply values);
\definition extensionBasis[values: ScalarCoordinates.Carrier][i: Index]: (extension values).apply (basis i) = values i :=
  trans!{R} _ _ _
    (congr!{Coordinates.Carrier R} ((((CoordinateDual.isomorphism).backward).apply values).apply) _ _ ((frame).rightInverse (Coordinates.basis i)))
    (congr!{ScalarCoordinates.Carrier R} (\fun (v: ScalarCoordinates.Carrier) => v i) _ _ ((CoordinateDual.isomorphism).rightInverse values));
\import std.Logic[].Proposition[] \as Logic;
\definition onto: \forall (values: ScalarCoordinates.Carrier) -> \exists ( f: Dual.Carrier \where (evaluation).apply f = values ) :=
  \fun (values: ScalarCoordinates.Carrier) => Logic.existsIntro[Dual.Carrier, { f: Dual.Carrier \where (evaluation).apply f = values }] (extension values)
    (\axiom:funext((evaluation).apply (extension values), values, extensionBasis values));
\import Modules.Isomorphism[V := Dual.Carrier, W := ScalarCoordinates.Carrier, source := Dual.space, target := ScalarCoordinates.space].OfBijective[f := evaluation] \as Bijective;
\definition isomorphism: Modules.Isomorphism[V := Dual.Carrier, W := ScalarCoordinates.Carrier, source := Dual.space, target := ScalarCoordinates.space].Isomorphism := Bijective.isomorphism injective onto;
\definition coordinate[i: Index]: Dual.Carrier := ((isomorphism).backward).apply (ScalarCoordinates.basis i);
\import Modules.Sums[I := Index].Vector[V := Dual.Carrier, space := Dual.space] \as DualSum;
\import Modules.Sums[I := Index].Vector[V := ScalarCoordinates.Carrier, space := ScalarCoordinates.space].Mapping[W := Dual.Carrier, target := Dual.space] \as MapSum;
\definition dual[f: Dual.Carrier]: DualSum.sum indices (\fun (i: Index) => (Dual.space).smul ((f).apply (basis i)) (coordinate i)) = f :=
  eq_reason_in!{Dual.Carrier _
    "=" _ "by" { sym!{Dual.Carrier} _ _
      (trans!{Dual.Carrier} _ _ _
        (MapSum.law (isomorphism).backward indices (\fun (i: Index) => (ScalarCoordinates.space).smul ((f).apply (basis i)) (ScalarCoordinates.basis i)))
        (DualSum.congruent indices
          (\fun (i: Index) => ((isomorphism).backward).apply ((ScalarCoordinates.space).smul ((f).apply (basis i)) (ScalarCoordinates.basis i)))
          (\fun (i: Index) => (Dual.space).smul ((f).apply (basis i)) (coordinate i))
          (\fun (i: Index) => ((isomorphism).backward).scalar ((f).apply (basis i)) (ScalarCoordinates.basis i)))) }
    "=" _ "by" { congr!{ScalarCoordinates.Carrier Dual.Carrier} (((isomorphism).backward).apply) _ _ (ScalarCoordinates.decomposition ((evaluation).apply f)) }
    "=" _ "by" { (isomorphism).leftInverse f }
  };
