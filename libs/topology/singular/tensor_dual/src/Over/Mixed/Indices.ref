\definition toInteger[i: ScalarDouble.Index n]: Double.Index n :=
  \into[Double.Pair](Double.Pair { first := (i).first, second := (i).second },
    { j: Double.Pair \where N.Basic[].Def[].add (j).first (j).second = n }) \by { ScalarDouble.degree n i };
\definition toScalar[i: Double.Index n]: ScalarDouble.Index n :=
  \into[ScalarDouble.Pair](ScalarDouble.Pair { first := (i).first, second := (i).second },
    { j: ScalarDouble.Pair \where N.Basic[].Def[].add (j).first (j).second = n }) \by { Double.degree n i };
