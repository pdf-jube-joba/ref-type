\import chain_complexes.Cochain[].Over[R := R, ring := Rings.commutativeRingAsRing R ring] \as Cochains;
\import Cochains.At[C := Source.complex, k := n] \as SourceH;
\import Cochains.At[C := Target.complex, k := n] \as TargetH;
\import Cochains.Map[C := Source.complex, D := Target.complex].At[k := n] \as ForwardH;
\import Cochains.Map[C := Target.complex, D := Source.complex].At[k := n] \as BackwardH;
\definition isomorphism: Modules.Isomorphism[V := SourceH.Cohomology, W := TargetH.Cohomology,
  source := SourceH.cohomologySpace, target := TargetH.cohomologySpace].Isomorphism :=
  Modules.Isomorphism[V := SourceH.Cohomology, W := TargetH.Cohomology,
    source := SourceH.cohomologySpace, target := TargetH.cohomologySpace].Isomorphism {
    forward := ForwardH.induced Forward.map, backward := BackwardH.induced Backward.map,
    leftInverse := Underlying.At[k := n].left e, rightInverse := Underlying.At[k := n].right e,
  };
