\import resolutions.HomComplex[].Over[R := R, ring := ring].Abelian[N := scalars] \as Hom;
\import Hom.Native[P := P] \as Source;
\import Hom.Native[P := Q] \as Target;
\import Modules.End[V := R, space := Modules.scalarModule] \as Coefficient;
\import Hom.NativeMapping[P := Q, Q := P, L := scalars].On[f := (e).backward, u := Coefficient.identity] \as Forward;
\import Hom.NativeMapping[P := P, Q := Q, L := scalars].On[f := (e).forward, u := Coefficient.identity] \as Backward;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as IntegerHom;
\import IntegerHom.Equivalence[P := P, Q := Q, N := Coefficients.coefficients] \as Underlying;
\module At(n: N.Nat^);
