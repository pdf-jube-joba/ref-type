\import Cochains.End[C := source] \as SourceEnd;
\import Cochains.End[C := target] \as TargetEnd;
\import Cochains.Map[C := source, D := source] \as SourceMaps;
\import Cochains.Map[C := target, D := target] \as TargetMaps;
\import Backward.Composition[B := source] \as LeftComposition;
\import Forward.Composition[B := target] \as RightComposition;
\definition leftEquality: LeftComposition.compose backward forward = SourceEnd.identity := SourceMaps.ext (LeftComposition.compose backward forward) SourceEnd.identity leftInverse;
\definition rightEquality: RightComposition.compose forward backward = TargetEnd.identity := TargetMaps.ext (RightComposition.compose forward backward) TargetEnd.identity rightInverse;
\import Cochains.Homotopy[C := source, D := source] \as LeftHomotopy;
\import Cochains.Homotopy[C := target, D := target] \as RightHomotopy;
\import LeftHomotopy.Reflexive[f := SourceEnd.identity] \as LeftZero;
\import RightHomotopy.Reflexive[f := TargetEnd.identity] \as RightZero;
\definition left: LeftHomotopy.Homotopy SourceEnd.identity (LeftComposition.compose backward forward) :=
  \into[LeftHomotopy.Data](LeftZero.data, LeftHomotopy.Homotopy SourceEnd.identity (LeftComposition.compose backward forward)) \by {
    LeftHomotopy.replacementLaws SourceEnd.identity SourceEnd.identity SourceEnd.identity (LeftComposition.compose backward forward)
      LeftZero.data (\refl(SourceEnd.identity)) (sym!{SourceMaps.Map} _ _ leftEquality) LeftZero.laws
  };
\definition right: RightHomotopy.Homotopy TargetEnd.identity (RightComposition.compose forward backward) :=
  \into[RightHomotopy.Data](RightZero.data, RightHomotopy.Homotopy TargetEnd.identity (RightComposition.compose forward backward)) \by {
    RightHomotopy.replacementLaws TargetEnd.identity TargetEnd.identity TargetEnd.identity (RightComposition.compose forward backward)
      RightZero.data (\refl(TargetEnd.identity)) (sym!{TargetMaps.Map} _ _ rightEquality) RightZero.laws
  };
\definition equivalence: Equivalences.Equivalence := Equivalences.Equivalence { forward := forward, backward := backward, left := left, right := right };
