\use std.Logic[].Equality[].eq_reason_in;
\import Modules.Hom[V := DualSum.Carrier, W := SourceTerm.Carrier, source := DualSum.space, target := SourceTerm.space].Composition[U := SourceTerm.Carrier, domain := SourceTerm.space] \as LeftComposition;
\import Modules.Hom[V := SourceTerm.Carrier, W := DualSum.Carrier, source := SourceTerm.space, target := DualSum.space].Composition[U := DualSum.Carrier, domain := DualSum.space] \as RightComposition;
\import Modules.End[V := SourceTerm.Carrier, space := SourceTerm.space] \as SourceEnd;
\import Modules.End[V := DualSum.Carrier, space := DualSum.space] \as DualEnd;
\import SourceSum.To[W := SourceTerm.Carrier, target := SourceTerm.space] \as SourceUniversal;
\import DualSum.To[W := DualSum.Carrier, target := DualSum.space] \as DualUniversal;
\import N.Basic[].Def[] \as Arithmetic;
\definition sourceIndex[pair: ScalarDouble.Pair][degree: Arithmetic.add (pair).first (pair).second = n]: ScalarDouble.Index n :=
  \into[ScalarDouble.Pair](pair, ScalarDouble.Index n) \by { degree };
\definition targetIndex[pair: Double.Pair][degree: Arithmetic.add (pair).first (pair).second = n]: Double.Index n :=
  \into[Double.Pair](pair, Double.Index n) \by { degree };
\definition sourceRoundtrip: \forall (pair: ScalarDouble.Pair)(degree: Arithmetic.add (pair).first (pair).second = n)
  (x: SourceTerm.family.Carrier (sourceIndex pair degree)) ->
  (SourceSum.Injection[i := Indices.toScalar (Indices.toInteger (sourceIndex pair degree))].map).apply x =
    (SourceSum.Injection[i := sourceIndex pair degree].map).apply x :=
  \induction (pair: ScalarDouble.Pair) \return \forall (degree: Arithmetic.add (pair).first (pair).second = n)
    (x: SourceTerm.family.Carrier (sourceIndex pair degree)) ->
    (SourceSum.Injection[i := Indices.toScalar (Indices.toInteger (sourceIndex pair degree))].map).apply x =
      (SourceSum.Injection[i := sourceIndex pair degree].map).apply x \with {
    | # : \fun (p, q: N.Nat^)(degree: Arithmetic.add p q = n)(x: SourceTensor.Term[p := p, q := q].Carrier) =>
      \refl((SourceSum.Injection[i := sourceIndex (ScalarDouble.Pair::# p q) degree].map).apply x)
  };
\definition targetRoundtrip: \forall (pair: Double.Pair)(degree: Arithmetic.add (pair).first (pair).second = n)
  (x: Diagonal.dualFamily.Carrier (targetIndex pair degree)) ->
  (DualSum.Injection[i := Indices.toInteger (Indices.toScalar (targetIndex pair degree))].map).apply x =
    (DualSum.Injection[i := targetIndex pair degree].map).apply x :=
  \induction (pair: Double.Pair) \return \forall (degree: Arithmetic.add (pair).first (pair).second = n)
    (x: Diagonal.dualFamily.Carrier (targetIndex pair degree)) ->
    (DualSum.Injection[i := Indices.toInteger (Indices.toScalar (targetIndex pair degree))].map).apply x =
      (DualSum.Injection[i := targetIndex pair degree].map).apply x \with {
    | # : \fun (p, q: N.Nat^)(degree: Arithmetic.add p q = n)(x: Diagonal.dualFamily.Carrier (targetIndex (Double.Pair::# p q) degree)) =>
      \refl((DualSum.Injection[i := targetIndex (Double.Pair::# p q) degree].map).apply x)
  };
\definition leftEquality: LeftComposition.compose fromDual toDual = SourceEnd.identity :=
  SourceUniversal.ext (LeftComposition.compose fromDual toDual) SourceEnd.identity
    (\fun (i: ScalarDouble.Index n)(x: SourceTerm.family.Carrier i) => eq_reason_in!{SourceTerm.Carrier _
      "=" _ "by" { congr!{DualSum.Carrier SourceTerm.Carrier} ((fromDual).apply) _ _ (forwardInjection i x) }
      "=" _ "by" { backwardInjection (Indices.toInteger i) (((\parent.Component[i := i].isomorphism).forward).apply x) }
      "=" _ "by" { congr!{{SourceTerm.family.Carrier i} SourceTerm.Carrier} ((SourceSum.Injection[i := Indices.toScalar (Indices.toInteger i)].map).apply) _ _ ((\parent.Component[i := i].isomorphism).leftInverse x) }
      "=" _ "by" { sourceRoundtrip i (ScalarDouble.degree n i) x }
    });
\definition rightEquality: RightComposition.compose toDual fromDual = DualEnd.identity :=
  DualUniversal.ext (RightComposition.compose toDual fromDual) DualEnd.identity
    (\fun (i: Double.Index n)(x: Diagonal.dualFamily.Carrier i) => eq_reason_in!{DualSum.Carrier _
      "=" _ "by" { congr!{SourceTerm.Carrier DualSum.Carrier} ((toDual).apply) _ _ (backwardInjection i x) }
      "=" _ "by" { forwardInjection (Indices.toScalar i) (((\parent.Component[i := Indices.toScalar i].isomorphism).backward).apply x) }
      "=" _ "by" { congr!{{Diagonal.dualFamily.Carrier i} DualSum.Carrier} ((DualSum.Injection[i := Indices.toInteger (Indices.toScalar i)].map).apply) _ _ ((\parent.Component[i := Indices.toScalar i].isomorphism).rightInverse x) }
      "=" _ "by" { targetRoundtrip i (Double.degree n i) x }
    });
\definition left[x: SourceTerm.Carrier]: (fromDual).apply ((toDual).apply x) = x :=
  congr!{{Modules.Hom[V := SourceTerm.Carrier, W := SourceTerm.Carrier, source := SourceTerm.space, target := SourceTerm.space].Map} SourceTerm.Carrier}
    (\fun (f: Modules.Hom[V := SourceTerm.Carrier, W := SourceTerm.Carrier, source := SourceTerm.space, target := SourceTerm.space].Map) => (f).apply x) _ _ leftEquality;
\definition right[x: DualSum.Carrier]: (toDual).apply ((fromDual).apply x) = x :=
  congr!{{Modules.Hom[V := DualSum.Carrier, W := DualSum.Carrier, source := DualSum.space, target := DualSum.space].Map} DualSum.Carrier}
    (\fun (f: Modules.Hom[V := DualSum.Carrier, W := DualSum.Carrier, source := DualSum.space, target := DualSum.space].Map) => (f).apply x) _ _ rightEquality;
