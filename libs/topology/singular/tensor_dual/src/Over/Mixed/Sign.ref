\use std.Logic[].Equality[].eq_reason_in;
\import Double.Sign[V := R, space := Coefficients.coefficients.space] \as Integral;
\import ScalarDouble.Sign[V := R, space := Modules.scalarModule] \as Scalar;
\definition law: \forall (n: N.Nat^)(x: R) -> (Integral.map n).apply x = (Scalar.map n).apply x :=
  \induction (n: N.Nat^) \return \forall (x: R) -> (Integral.map n).apply x = (Scalar.map n).apply x \with {
    | zero: \fun (x: R) => \refl(x)
    | succ: \fun (n: N.Nat^)(previous: \forall (x: R) -> (Integral.map n).apply x = (Scalar.map n).apply x)(x: R) =>
      eq_reason_in!{R _
        "=" _ "by" { Integral.successor n x }
        "=" _ "by" { congr!{R R} ((Modules.scalarModule).neg) _ _ (previous x) }
        "=" _ "by" { sym!{R} _ _ (Scalar.successor n x) }
      }
  };
