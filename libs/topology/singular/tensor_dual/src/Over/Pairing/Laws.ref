\use std.Logic[].Equality[].eq_reason_in;
\definition laws: Source.BilinearLaws[Target.Carrier, Target.space, comparison] := Source.BilinearLaws[Target.Carrier, Target.space, comparison] {
  addLeft := \fun (alpha, gamma: Left.Carrier)(beta: Right.Carrier) => Extend.ext
    (comparison ((Left.space).add alpha gamma) beta) ((Target.space).add (comparison alpha beta) (comparison gamma beta))
    (\fun (x: V.Carrier)(y: W.Carrier) => eq_reason_in!{R _
      "=" _ "by" { evaluation ((Left.space).add alpha gamma) beta x y }
      "=" _ "by" { distributeRight ((alpha).apply x) ((gamma).apply x) ((beta).apply y) }
      "=" _ "by" { sym!{R} _ _ (congr!{R R R} add _ _ _ _ (evaluation alpha beta x y) (evaluation gamma beta x y)) }
    }),
  addRight := \fun (alpha: Left.Carrier)(beta, gamma: Right.Carrier) => Extend.ext
    (comparison alpha ((Right.space).add beta gamma)) ((Target.space).add (comparison alpha beta) (comparison alpha gamma))
    (\fun (x: V.Carrier)(y: W.Carrier) => eq_reason_in!{R _
      "=" _ "by" { evaluation alpha ((Right.space).add beta gamma) x y }
      "=" _ "by" { distributeLeft ((alpha).apply x) ((beta).apply y) ((gamma).apply y) }
      "=" _ "by" { sym!{R} _ _ (congr!{R R R} add _ _ _ _ (evaluation alpha beta x y) (evaluation alpha gamma x y)) }
    }),
  scaleLeft := \fun (a: R)(alpha: Left.Carrier)(beta: Right.Carrier) => Extend.ext
    (comparison ((Left.space).smul a alpha) beta) ((Target.space).smul a (comparison alpha beta))
    (\fun (x: V.Carrier)(y: W.Carrier) => eq_reason_in!{R _
      "=" _ "by" { evaluation ((Left.space).smul a alpha) beta x y }
      "=" _ "by" { assoc a ((alpha).apply x) ((beta).apply y) }
      "=" _ "by" { sym!{R} _ _ (congr!{R R} (mul a) _ _ (evaluation alpha beta x y)) }
    }),
  scaleRight := \fun (a: R)(alpha: Left.Carrier)(beta: Right.Carrier) => Extend.ext
    (comparison alpha ((Right.space).smul a beta)) ((Target.space).smul a (comparison alpha beta))
    (\fun (x: V.Carrier)(y: W.Carrier) => eq_reason_in!{R _
      "=" _ "by" { evaluation alpha ((Right.space).smul a beta) x y }
      "=" _ "by" { middle ((alpha).apply x) a ((beta).apply y) }
      "=" _ "by" { sym!{R} _ _ (congr!{R R} (mul a) _ _ (evaluation alpha beta x y)) }
    }),
};
