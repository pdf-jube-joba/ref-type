\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Hom.On[P := P, N := canonical] \as Original;
\import Hom.On[P := P, N := standard] \as Standard;
\import Chains.End[C := P] \as End;
\import Hom.Mapping[P := P, Q := P, N := canonical, L := standard] \as Forward;
\import Hom.Mapping[P := P, Q := P, N := standard, L := canonical] \as Backward;
\definition map: Complexes.Map[C := Original.complex, D := Standard.complex].Map := Forward.On[f := End.identity, u := toStandard].map;
\definition inverse: Complexes.Map[C := Standard.complex, D := Original.complex].Map := Backward.On[f := End.identity, u := toCanonical].map;
\definition apply[n: N.Nat^][alpha: Original.Carrier n]: Standard.Carrier n := (map).apply n alpha;
\definition value[n: N.Nat^][alpha: Original.Carrier n][x: P.family.Carrier n]: (apply n alpha).apply x = (alpha).apply x := \refl((alpha).apply x);
\definition leftInverse[n: N.Nat^][alpha: Original.Carrier n]: (inverse).apply n ((map).apply n alpha) = alpha := Original.At[n := n].ext ((inverse).apply n ((map).apply n alpha)) alpha (\fun (x: P.family.Carrier n) => \refl((alpha).apply x));
\definition rightInverse[n: N.Nat^][alpha: Standard.Carrier n]: (map).apply n ((inverse).apply n alpha) = alpha := Standard.At[n := n].ext ((map).apply n ((inverse).apply n alpha)) alpha (\fun (x: P.family.Carrier n) => \refl((alpha).apply x));

\import chain_complexes.CochainEquivalence[].Over[R := I.Int^, ring := Integers.ring].Of[C := Original.complex, D := Standard.complex] \as Equivalences;
\module Equivalence;
\definition equivalence: Equivalences.Equivalence := Equivalence[].equivalence;
