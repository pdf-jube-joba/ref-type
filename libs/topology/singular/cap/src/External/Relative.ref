\import std.Arithmetic[].Int[] \as I;
\import singular_cohomology.Relative[A := A, source := left, subset := leftSubset] \as LeftRelative;
\import singular_cohomology.Relative[A := B, source := right, subset := rightSubset] \as RightRelative;
\definition leftInverse: \Pow Product.CarrierSet := { x: Product.CarrierSet \where \In[A] leftSubset (leftProjection x) };
\definition rightInverse: \Pow Product.CarrierSet := { x: Product.CarrierSet \where \In[B] rightSubset (rightProjection x) };
\import singular_cohomology.Relative[A := Product.CarrierSet, source := topology, subset := leftInverse] \as ProductLeft;
\import singular_cohomology.Relative[A := Product.CarrierSet, source := topology, subset := rightInverse] \as ProductRight;
\import ProductLeft.Maps[B := A].Over[target := left, targetSubset := leftSubset] \as LeftPairMaps;
\import ProductRight.Maps[B := B].Over[target := right, targetSubset := rightSubset] \as RightPairMaps;
\definition leftPair: LeftPairMaps.Map := \into[Product.CarrierSet -> A](leftProjection, { f: Product.CarrierSet -> A \where LeftPairMaps.Laws[f] }) \by {
  LeftPairMaps.Laws[leftProjection] { continuous := leftContinuous, contained := \fun (x: ProductLeft.SubspaceCarrier) => \bysub(Product.CarrierSet, leftInverse, x) }
};
\definition rightPair: RightPairMaps.Map := \into[Product.CarrierSet -> B](rightProjection, { f: Product.CarrierSet -> B \where RightPairMaps.Laws[f] }) \by {
  RightPairMaps.Laws[rightProjection] { continuous := rightContinuous, contained := \fun (x: ProductRight.SubspaceCarrier) => \bysub(Product.CarrierSet, rightInverse, x) }
};
\import LeftPairMaps.On[f := leftPair].Integer[].With[coefficients := Whole.integerCoefficients] \as LeftRelativePull;
\import RightPairMaps.On[f := rightPair].Integer[].With[coefficients := Whole.integerCoefficients] \as RightRelativePull;
\import LeftRelative.With[coefficients := Whole.integerCoefficients] \as LeftRelativeCochains;
\import RightRelative.With[coefficients := Whole.integerCoefficients] \as RightRelativeCochains;
\import ProductLeft.With[coefficients := Whole.integerCoefficients] \as ProductLeftCochains;
\import ProductRight.With[coefficients := Whole.integerCoefficients] \as ProductRightCochains;
\import \root.CochainPair[A := Product.CarrierSet, source := topology, subset := leftInverse, R := R, ring := ring] \as ProductLeftPair;
\import \root.CochainPair[A := Product.CarrierSet, source := topology, subset := rightInverse, R := R, ring := ring] \as ProductRightPair;
\module Cup(p, q: N.Nat^) {
  \import ProductLeftPair.RelativeCup[p := p, q := q] \as LeftCup;
  \import ProductRightPair.RelativeCup[p := p, q := q] \as RightCup;
  \import Whole.Cup[p := p, q := q] \as WholeCup;
  \definition total: N.Nat^ := WholeCup.total;
  \definition left[alpha: LeftRelativeCochains.Carrier (I.Int^::ofNat p)][beta: Right.Carrier q]: ProductLeftCochains.Carrier (I.Int^::ofNat total) :=
    LeftCup.left ((LeftRelativePull.pullback).apply (I.Int^::ofNat p) alpha) (RightPull.apply q rightProjection rightContinuous beta);
  \definition right[alpha: Left.Carrier p][beta: RightRelativeCochains.Carrier (I.Int^::ofNat q)]: ProductRightCochains.Carrier (I.Int^::ofNat total) :=
    RightCup.right (LeftPull.apply p leftProjection leftContinuous alpha) ((RightRelativePull.pullback).apply (I.Int^::ofNat q) beta);
}
