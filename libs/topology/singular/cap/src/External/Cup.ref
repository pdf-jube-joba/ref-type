\import Whole.Cup[p := p, q := q] \as ProductCup;
\definition total: N.Nat^ := ProductCup.total;
\definition apply[alpha: Left.Carrier p][beta: Right.Carrier q]: Whole.Carrier total :=
  ProductCup.apply (LeftPull.apply p leftProjection leftContinuous alpha) (RightPull.apply q rightProjection rightContinuous beta);
