\import Left.Cohomology[] \as LeftTheory;
\import Right.Cohomology[] \as RightTheory;
\import Whole.Cohomology[] \as WholeTheory;
\import WholeTheory.Pullback[B := A, target := left] \as LeftPullback;
\import WholeTheory.Pullback[B := B, target := right] \as RightPullback;
\import WholeTheory.Cup[p := p, q := q] \as Product;
\definition total: N.Nat^ := Product.degree;
\definition apply[alpha: LeftTheory.Group p][beta: RightTheory.Group q]: WholeTheory.Group total :=
  Product.apply (LeftPullback.apply p leftProjection leftContinuous alpha) (RightPullback.apply q rightProjection rightContinuous beta);
