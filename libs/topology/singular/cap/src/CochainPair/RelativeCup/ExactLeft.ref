\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\import \parent.\parent.Degree[] \as Degree;
\import Degree.Boundaries[] \as Boundaries;
\import singular_cohomology.Simplices[A := A, source := source].CutFaces[p := p, q := q] \as Geometry;
\import \parent.Closed[] \as Closed;
\import \parent.Leibniz[] \as Leibniz;
\import \parent.\parent.RelativeCup[p := N.Nat^::succ p, q := q] \as Upper;
\import chain_complexes.Integer[].Over[R := R, ring := std.Alg[].Ring[].commutativeRingAsRing R ring].At[C := Degree.RelativeRing.complex, z := I.Int^::ofNat Geometry.higher] \as Target;
\import Degree.Modules.Of[V := Degree.Carrier Geometry.higher, space := Degree.space Geometry.higher].Submodule[].Image[U := Degree.Carrier WholeProduct.total, source := Degree.space WholeProduct.total] \as Images;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Whole.integerCoefficients] \as Ordinary;
\definition left: \forall (gamma: Degree.Carrier p)(beta: Whole.Carrier q) ->
  Ordinary.coboundary q beta = (Whole.space (N.Nat^::succ q)).zero ->
  Boundaries.Member Geometry.leftDegree (Upper.left (Degree.differential p gamma) beta) :=
  \fun (gamma: Degree.Carrier p)(beta: Whole.Carrier q)(closed: _) => Boundaries.reflects Geometry.leftDegree Geometry.higher Geometry.same _
    (Images.introduce Target.prior (Leibniz.leftTerm gamma beta) (left gamma beta) (Closed.leftRightClosed gamma beta closed));
\definition right: \forall (gamma: Whole.Carrier p)(beta: Degree.Carrier q) ->
  Degree.differential q beta = (Degree.space (N.Nat^::succ q)).zero ->
  Boundaries.Member Geometry.leftDegree (Upper.right (Ordinary.coboundary p gamma) beta) :=
  \fun (gamma: Whole.Carrier p)(beta: Degree.Carrier q)(closed: _) => Boundaries.reflects Geometry.leftDegree Geometry.higher Geometry.same _
    (Images.introduce Target.prior (Leibniz.rightLeftTerm gamma beta) (right gamma beta) (Closed.rightRightClosed gamma beta closed));
