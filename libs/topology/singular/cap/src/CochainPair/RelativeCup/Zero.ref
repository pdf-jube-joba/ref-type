\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import \parent.\parent.Degree[] \as Degree;
\import WholeProduct.Bilinear[] \as Bilinear;
\definition leftFirst: \forall (beta: Whole.Carrier q) -> left (Degree.space p).zero beta = (Degree.space WholeProduct.total).zero :=
  \fun (beta: Whole.Carrier q) => Result.injective _ _ (trans!{{Whole.Carrier WholeProduct.total}} _ _ _ (leftRestriction (Degree.space p).zero beta)
    (trans!{{Whole.Carrier WholeProduct.total}} _ _ _ (congr!{{Whole.Carrier p} {Whole.Carrier WholeProduct.total}} (\fun (x: Whole.Carrier p) => WholeProduct.apply x beta) _ _ Left.zero)
      (trans!{{Whole.Carrier WholeProduct.total}} _ _ _ (Bilinear.leftZero beta) (sym!{{Whole.Carrier WholeProduct.total}} _ _ Result.zero))));
\definition leftSecond: \forall (alpha: Degree.Carrier p) -> left alpha (Whole.space q).zero = (Degree.space WholeProduct.total).zero :=
  \fun (alpha: Degree.Carrier p) => Result.injective _ _ (trans!{{Whole.Carrier WholeProduct.total}} _ _ _ (leftRestriction alpha (Whole.space q).zero)
    (trans!{{Whole.Carrier WholeProduct.total}} _ _ _ (Bilinear.rightZero (Left.from alpha)) (sym!{{Whole.Carrier WholeProduct.total}} _ _ Result.zero)));
\definition rightFirst: \forall (beta: Degree.Carrier q) -> right (Whole.space p).zero beta = (Degree.space WholeProduct.total).zero :=
  \fun (beta: Degree.Carrier q) => Result.injective _ _ (trans!{{Whole.Carrier WholeProduct.total}} _ _ _ (rightRestriction (Whole.space p).zero beta)
    (trans!{{Whole.Carrier WholeProduct.total}} _ _ _ (Bilinear.leftZero (Right.from beta)) (sym!{{Whole.Carrier WholeProduct.total}} _ _ Result.zero)));
\definition rightSecond: \forall (alpha: Whole.Carrier p) -> right alpha (Degree.space q).zero = (Degree.space WholeProduct.total).zero :=
  \fun (alpha: Whole.Carrier p) => Result.injective _ _ (trans!{{Whole.Carrier WholeProduct.total}} _ _ _ (rightRestriction alpha (Degree.space q).zero)
    (trans!{{Whole.Carrier WholeProduct.total}} _ _ _ (congr!{{Whole.Carrier q} {Whole.Carrier WholeProduct.total}} (WholeProduct.apply alpha) _ _ Right.zero)
      (trans!{{Whole.Carrier WholeProduct.total}} _ _ _ (Bilinear.rightZero alpha) (sym!{{Whole.Carrier WholeProduct.total}} _ _ Result.zero))));
