\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.congr;
\use Equality.eq_reason_in;
\import \parent.\parent.Degree[] \as Degree;
\import Left.Linear[] \as LeftLinear;
\import Right.Linear[] \as RightLinear;
\import Result.Linear[] \as ResultLinear;
\import WholeProduct.Bilinear[] \as Bilinear;
\definition total: N.Nat^ := WholeProduct.total;
\definition leftLeftAdd: \forall (x, y: Degree.Carrier p)(z: Whole.Carrier q) -> left ((Degree.space p).add x y) z = (Degree.space total).add (left x z) (left y z) :=
  \fun (x, y: Degree.Carrier p)(z: Whole.Carrier q) => Result.injective _ _ (eq_reason_in!{{Whole.Carrier total} _
    "=" _ "by" { leftRestriction ((Degree.space p).add x y) z }
    "=" _ "by" { congr!{{Whole.Carrier p} {Whole.Carrier total}} (\fun (h: Whole.Carrier p) => WholeProduct.apply h z) _ _ (LeftLinear.addition x y) }
    "=" _ "by" { Bilinear.leftAdd (Left.from x) (Left.from y) z }
    "=" _ "by" { congr!{{Whole.Carrier total} {Whole.Carrier total} {Whole.Carrier total}} ((Whole.space total).add) _ _ _ _ (sym!{{Whole.Carrier total}} _ _ (leftRestriction x z)) (sym!{{Whole.Carrier total}} _ _ (leftRestriction y z)) }
    "=" _ "by" { sym!{{Whole.Carrier total}} _ _ (ResultLinear.addition (left x z) (left y z)) }
  });
\definition leftLeftScale: \forall (a: R)(x: Degree.Carrier p)(z: Whole.Carrier q) -> left ((Degree.space p).smul a x) z = (Degree.space total).smul a (left x z) :=
  \fun (a: R)(x: Degree.Carrier p)(z: Whole.Carrier q) => Result.injective _ _ (eq_reason_in!{{Whole.Carrier total} _
    "=" _ "by" { leftRestriction ((Degree.space p).smul a x) z }
    "=" _ "by" { congr!{{Whole.Carrier p} {Whole.Carrier total}} (\fun (h: Whole.Carrier p) => WholeProduct.apply h z) _ _ (LeftLinear.scalar a x) }
    "=" _ "by" { Bilinear.leftScale a (Left.from x) z }
    "=" _ "by" { congr!{{Whole.Carrier total} {Whole.Carrier total}} ((Whole.space total).smul a) _ _ (sym!{{Whole.Carrier total}} _ _ (leftRestriction x z)) }
    "=" _ "by" { sym!{{Whole.Carrier total}} _ _ (ResultLinear.scalar a (left x z)) }
  });
\definition leftRightAdd: \forall (x: Degree.Carrier p)(y, z: Whole.Carrier q) -> left x ((Whole.space q).add y z) = (Degree.space total).add (left x y) (left x z) :=
  \fun (x: Degree.Carrier p)(y, z: Whole.Carrier q) => Result.injective _ _ (eq_reason_in!{{Whole.Carrier total} _
    "=" _ "by" { leftRestriction x ((Whole.space q).add y z) }
    "=" _ "by" { Bilinear.rightAdd (Left.from x) y z }
    "=" _ "by" { congr!{{Whole.Carrier total} {Whole.Carrier total} {Whole.Carrier total}} ((Whole.space total).add) _ _ _ _ (sym!{{Whole.Carrier total}} _ _ (leftRestriction x y)) (sym!{{Whole.Carrier total}} _ _ (leftRestriction x z)) }
    "=" _ "by" { sym!{{Whole.Carrier total}} _ _ (ResultLinear.addition (left x y) (left x z)) }
  });
\definition leftRightScale: \forall (a: R)(x: Degree.Carrier p)(z: Whole.Carrier q) -> left x ((Whole.space q).smul a z) = (Degree.space total).smul a (left x z) :=
  \fun (a: R)(x: Degree.Carrier p)(z: Whole.Carrier q) => Result.injective _ _ (eq_reason_in!{{Whole.Carrier total} _
    "=" _ "by" { leftRestriction x ((Whole.space q).smul a z) }
    "=" _ "by" { Bilinear.rightScale a (Left.from x) z }
    "=" _ "by" { congr!{{Whole.Carrier total} {Whole.Carrier total}} ((Whole.space total).smul a) _ _ (sym!{{Whole.Carrier total}} _ _ (leftRestriction x z)) }
    "=" _ "by" { sym!{{Whole.Carrier total}} _ _ (ResultLinear.scalar a (left x z)) }
  });
\definition rightLeftAdd: \forall (x, y: Whole.Carrier p)(z: Degree.Carrier q) -> right ((Whole.space p).add x y) z = (Degree.space total).add (right x z) (right y z) :=
  \fun (x, y: Whole.Carrier p)(z: Degree.Carrier q) => Result.injective _ _ (eq_reason_in!{{Whole.Carrier total} _
    "=" _ "by" { rightRestriction ((Whole.space p).add x y) z }
    "=" _ "by" { Bilinear.leftAdd x y (Right.from z) }
    "=" _ "by" { congr!{{Whole.Carrier total} {Whole.Carrier total} {Whole.Carrier total}} ((Whole.space total).add) _ _ _ _ (sym!{{Whole.Carrier total}} _ _ (rightRestriction x z)) (sym!{{Whole.Carrier total}} _ _ (rightRestriction y z)) }
    "=" _ "by" { sym!{{Whole.Carrier total}} _ _ (ResultLinear.addition (right x z) (right y z)) }
  });
\definition rightLeftScale: \forall (a: R)(x: Whole.Carrier p)(z: Degree.Carrier q) -> right ((Whole.space p).smul a x) z = (Degree.space total).smul a (right x z) :=
  \fun (a: R)(x: Whole.Carrier p)(z: Degree.Carrier q) => Result.injective _ _ (eq_reason_in!{{Whole.Carrier total} _
    "=" _ "by" { rightRestriction ((Whole.space p).smul a x) z }
    "=" _ "by" { Bilinear.leftScale a x (Right.from z) }
    "=" _ "by" { congr!{{Whole.Carrier total} {Whole.Carrier total}} ((Whole.space total).smul a) _ _ (sym!{{Whole.Carrier total}} _ _ (rightRestriction x z)) }
    "=" _ "by" { sym!{{Whole.Carrier total}} _ _ (ResultLinear.scalar a (right x z)) }
  });
\definition rightRightAdd: \forall (x: Whole.Carrier p)(y, z: Degree.Carrier q) -> right x ((Degree.space q).add y z) = (Degree.space total).add (right x y) (right x z) :=
  \fun (x: Whole.Carrier p)(y, z: Degree.Carrier q) => Result.injective _ _ (eq_reason_in!{{Whole.Carrier total} _
    "=" _ "by" { rightRestriction x ((Degree.space q).add y z) }
    "=" _ "by" { congr!{{Whole.Carrier q} {Whole.Carrier total}} (WholeProduct.apply x) _ _ (RightLinear.addition y z) }
    "=" _ "by" { Bilinear.rightAdd x (Right.from y) (Right.from z) }
    "=" _ "by" { congr!{{Whole.Carrier total} {Whole.Carrier total} {Whole.Carrier total}} ((Whole.space total).add) _ _ _ _ (sym!{{Whole.Carrier total}} _ _ (rightRestriction x y)) (sym!{{Whole.Carrier total}} _ _ (rightRestriction x z)) }
    "=" _ "by" { sym!{{Whole.Carrier total}} _ _ (ResultLinear.addition (right x y) (right x z)) }
  });
\definition rightRightScale: \forall (a: R)(x: Whole.Carrier p)(z: Degree.Carrier q) -> right x ((Degree.space q).smul a z) = (Degree.space total).smul a (right x z) :=
  \fun (a: R)(x: Whole.Carrier p)(z: Degree.Carrier q) => Result.injective _ _ (eq_reason_in!{{Whole.Carrier total} _
    "=" _ "by" { rightRestriction x ((Degree.space q).smul a z) }
    "=" _ "by" { congr!{{Whole.Carrier q} {Whole.Carrier total}} (WholeProduct.apply x) _ _ (RightLinear.scalar a z) }
    "=" _ "by" { Bilinear.rightScale a x (Right.from z) }
    "=" _ "by" { congr!{{Whole.Carrier total} {Whole.Carrier total}} ((Whole.space total).smul a) _ _ (sym!{{Whole.Carrier total}} _ _ (rightRestriction x z)) }
    "=" _ "by" { sym!{{Whole.Carrier total}} _ _ (ResultLinear.scalar a (right x z)) }
  });
