\import \parent.\parent.Degree[] \as Degree;
\import Degree.Boundaries[] \as Boundaries;
\import singular_cohomology.Simplices[A := A, source := source].CutFaces[p := p, q := q] \as Geometry;
\import \parent.Closed[] \as Closed;
\import \parent.Leibniz[] \as Leibniz;
\import \parent.\parent.RelativeCup[p := p, q := N.Nat^::succ q] \as Upper;
\import Relative.OverRing[R := R, ring := ring].With[coefficients := Whole.coefficients] \as RelativeRing;
\import module_theory.Module[].Over[R := R, ring := std.Alg[].Ring[].commutativeRingAsRing R ring] \as Modules;
\import chain_complexes.Integer[].Over[R := R, ring := std.Alg[].Ring[].commutativeRingAsRing R ring].At[C := RelativeRing.complex, z := I.Int^::ofNat Geometry.higher] \as Target;
\import Modules.Of[V := Degree.Carrier Geometry.higher, space := Degree.space Geometry.higher].Submodule[].Image[U := Degree.Carrier WholeProduct.total, source := Degree.space WholeProduct.total] \as Images;
\import Boundaries.Signs[n := Geometry.higher] \as Signs;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Whole.integerCoefficients] \as Ordinary;
\definition left: \forall (alpha: Degree.Carrier p)(gamma: Whole.Carrier q) ->
  Degree.differential p alpha = (Degree.space (N.Nat^::succ p)).zero ->
  Boundaries.Member Geometry.higher (Upper.left alpha (Ordinary.coboundary q gamma)) :=
  \fun (alpha: Degree.Carrier p)(gamma: Whole.Carrier q)(closed: _) => Signs.reflects p _
    (Images.introduce Target.prior (Leibniz.rightTerm alpha gamma) (left alpha gamma) (Closed.leftLeftClosed alpha gamma closed));
\definition right: \forall (alpha: Whole.Carrier p)(gamma: Degree.Carrier q) ->
  Ordinary.coboundary p alpha = (Whole.space (N.Nat^::succ p)).zero ->
  Boundaries.Member Geometry.higher (Upper.right alpha (Degree.differential q gamma)) :=
  \fun (alpha: Whole.Carrier p)(gamma: Degree.Carrier q)(closed: _) => Signs.reflects p _
    (Images.introduce Target.prior (Leibniz.rightRightTerm alpha gamma) (right alpha gamma) (Closed.rightLeftClosed alpha gamma closed));
