\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import \parent.Boundaries[] \as Boundaries;
\import Relative.With[coefficients := Whole.integerCoefficients] \as Cochains;
\import Relative.OverRing[R := R, ring := ring].With[coefficients := Whole.coefficients] \as Theory;
\import chain_complexes.Integer[].Over[R := R, ring := Rings.commutativeRingAsRing R ring].At[C := Theory.complex, z := I.Int^::ofNat N.Nat^::zero] \as Cochain;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Integer[P := Relative.complex, N := Whole.integerCoefficients] \as Hom;
\import Hom.Cohomology[z := I.Int^::ofNat N.Nat^::zero] \as Native;
\import \root.Integral[A := A, source := source].Pair[subset := subset].ZeroHomology[q := N.Nat^::zero] \as ZeroChains;
\definition priorZero: \forall (h: Cochains.Carrier (I.Int^::negSucc N.Nat^::zero)) -> (Cochain.prior).apply h = (space N.Nat^::zero).zero :=
  \fun (h: Cochains.Carrier (I.Int^::negSucc N.Nat^::zero)) => Hom.At[z := I.Int^::ofNat N.Nat^::zero].ext _ _
    (\fun (x: Relative.Carrier (I.Int^::ofNat N.Nat^::zero)) => trans!{R} _ _ _ (Native.priorOnElement h x)
      (trans!{R} _ _ _ (congr!{{Relative.Carrier (I.Int^::negSucc N.Nat^::zero)} R} ((h).apply) _ _ (ZeroChains.negativeZero ((Relative.complex.differential).apply (I.Int^::ofNat N.Nat^::zero) x)))
        (Hom.At[z := I.Int^::negSucc N.Nat^::zero].zeroPreserved h)));
\definition law: \forall (alpha: Carrier N.Nat^::zero) -> Boundaries.Member N.Nat^::zero alpha -> alpha = (space N.Nat^::zero).zero := \block {
  \fun (alpha: Carrier N.Nat^::zero)(member: _) \then
  \takefrom gamma: \Cast[Cochains.Carrier (I.Int^::negSucc N.Nat^::zero)] ({ gamma: Cochains.Carrier (I.Int^::negSucc N.Nat^::zero) \where (Cochain.prior).apply gamma = alpha }) \by member \then
  \let result: alpha = (space N.Nat^::zero).zero := trans!{{Carrier N.Nat^::zero}} _ _ _
    (sym!{{Carrier N.Nat^::zero}} _ _ (\bysub(Cochains.Carrier (I.Int^::negSucc N.Nat^::zero), { gamma: Cochains.Carrier (I.Int^::negSucc N.Nat^::zero) \where (Cochain.prior).apply gamma = alpha }, gamma))) (priorZero gamma) \then
  \return result
};
