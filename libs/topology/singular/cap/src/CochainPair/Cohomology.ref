import std.Arithmetic[].Int[] \as I;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import \parent.Degree[] \as Degree;
\import \parent.RelativeCup[p := p, q := q] \as Product;
\import Product.Bilinear[] \as ProductLaws;
\import Product.Closed[] \as ProductClosed;
\import \parent.BoundaryProducts[] \as Boundaries;
\import Relative.OverRing[R := R, ring := ring].With[coefficients := Whole.coefficients] \as RelativeRing;
\import singular_cohomology.Cochains[A := A, source := source].OverRing[R := R, ring := ring].With[coefficients := Whole.coefficients] \as OrdinaryRing;
\import chain_complexes.Integer[].Over[R := R, ring := std.Alg[].Ring[].commutativeRingAsRing R ring] \as RelativeComplexes;
\import chain_complexes.Cochain[].Over[R := R, ring := std.Alg[].Ring[].commutativeRingAsRing R ring] \as OrdinaryComplexes;
\import module_theory.Module[].Over[R := R, ring := std.Alg[].Ring[].commutativeRingAsRing R ring] \as Modules;
\import commutative_algebra.Modules[R := R, ring := ring] \as Commutative;
\import N.Basic[].Def[] \as Nat;
\definition total: N.Nat^ := Nat.add p q;
\import RelativeComplexes.At[C := RelativeRing.complex, z := I.Int^::ofNat total] \as Output;
\definition outputBundle: Modules.Bundle := Modules.Bundle { Carrier := Output.Cohomology, space := Output.cohomologySpace };
