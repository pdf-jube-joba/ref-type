\import std.Arithmetic[].Int[] \as I;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\import \parent.Cup[p := p, q := q] \as Product;
\import Whole.Cup[p := p, q := q] \as WholeProduct;
\import Relative.With[coefficients := Whole.integerCoefficients] \as RelativeCochains;
\import \parent.Comparison[n := p] \as Left;
\import \parent.Comparison[n := q] \as Right;
\import \parent.Comparison[n := WholeProduct.total] \as Result;
\definition left[alpha: RelativeCochains.Carrier (I.Int^::ofNat p)][beta: Whole.Carrier q]: RelativeCochains.Carrier (I.Int^::ofNat WholeProduct.total) :=
  Result.to (Product.left (Left.from alpha) beta);
\definition right[alpha: Whole.Carrier p][beta: RelativeCochains.Carrier (I.Int^::ofNat q)]: RelativeCochains.Carrier (I.Int^::ofNat WholeProduct.total) :=
  Result.to (Product.right alpha (Right.from beta));
\definition leftRestriction: \forall (alpha: RelativeCochains.Carrier (I.Int^::ofNat p))(beta: Whole.Carrier q) ->
  Result.from (left alpha beta) = Product.left (Left.from alpha) beta :=
  \fun (alpha: RelativeCochains.Carrier (I.Int^::ofNat p))(beta: Whole.Carrier q) => Result.fromTo (Product.left (Left.from alpha) beta);
\definition rightRestriction: \forall (alpha: Whole.Carrier p)(beta: RelativeCochains.Carrier (I.Int^::ofNat q)) ->
  Result.from (right alpha beta) = Product.right alpha (Right.from beta) :=
  \fun (alpha: Whole.Carrier p)(beta: RelativeCochains.Carrier (I.Int^::ofNat q)) => Result.fromTo (Product.right alpha (Right.from beta));
\module Closed;
\module Leibniz;

\module Bilinear;
