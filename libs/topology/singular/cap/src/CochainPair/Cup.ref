\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.congr;
\import Whole.Cup[p := p, q := q] \as Product;
\import Sub.Cup[p := p, q := q] \as SubProduct;
\import SubProduct.Bilinear[] \as Bilinear;
\import Pull.Cup[p := p, q := q] \as Naturality;
\definition left[alpha: Carrier p][beta: Whole.Carrier q]: Carrier Product.total :=
  \into[Whole.Carrier Product.total](Product.apply alpha beta, { h: Whole.Carrier Product.total \where Vanishes Product.total h }) \by {
    trans!{{Sub.Carrier Product.total}} _ _ _ (Naturality.law Relative.inclusion Relative.inclusionContinuous alpha beta)
      (trans!{{Sub.Carrier Product.total}} _ _ _
        (congr!{{Sub.Carrier p} {Sub.Carrier Product.total}} (\fun (h: Sub.Carrier p) => SubProduct.apply h (Pull.apply q Relative.inclusion Relative.inclusionContinuous beta)) _ _
          (\bysub(Whole.Carrier p, { h: Whole.Carrier p \where Vanishes p h }, alpha)))
        (Bilinear.leftZero (Pull.apply q Relative.inclusion Relative.inclusionContinuous beta)))
  };
\definition right[alpha: Whole.Carrier p][beta: Carrier q]: Carrier Product.total :=
  \into[Whole.Carrier Product.total](Product.apply alpha beta, { h: Whole.Carrier Product.total \where Vanishes Product.total h }) \by {
    trans!{{Sub.Carrier Product.total}} _ _ _ (Naturality.law Relative.inclusion Relative.inclusionContinuous alpha beta)
      (trans!{{Sub.Carrier Product.total}} _ _ _
        (congr!{{Sub.Carrier q} {Sub.Carrier Product.total}} (SubProduct.apply (Pull.apply p Relative.inclusion Relative.inclusionContinuous alpha)) _ _
          (\bysub(Whole.Carrier q, { h: Whole.Carrier q \where Vanishes q h }, beta)))
        (Bilinear.rightZero (Pull.apply p Relative.inclusion Relative.inclusionContinuous alpha)))
  };
