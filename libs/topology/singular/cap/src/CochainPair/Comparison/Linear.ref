\import std.Alg[].Ring[] \as Rings;
\import Relative.OverRing[R := R, ring := ring].With[coefficients := Whole.coefficients] \as RelativeRing;
\definition addValue: \forall (h, k: RelativeCochains.Carrier (I.Int^::ofNat n))(x: WholeChains.Carrier n) ->
  (from ((RelativeRing.space (I.Int^::ofNat n)).add h k)).apply x = ((Whole.space n).add (from h) (from k)).apply x :=
  \fun (h, k: RelativeCochains.Carrier (I.Int^::ofNat n))(x: WholeChains.Carrier n) =>
    \refl((Whole.coefficients.space).add ((h).apply (Relative.class (I.Int^::ofNat n) (Positive.intro x))) ((k).apply (Relative.class (I.Int^::ofNat n) (Positive.intro x))));
\definition addition: \forall (h, k: RelativeCochains.Carrier (I.Int^::ofNat n)) ->
  from ((RelativeRing.space (I.Int^::ofNat n)).add h k) = (Whole.space n).add (from h) (from k) :=
  \fun (h, k: RelativeCochains.Carrier (I.Int^::ofNat n)) => WholeMaps.ext _ _ (addValue h k);
\definition scalarValue: \forall (a: R)(h: RelativeCochains.Carrier (I.Int^::ofNat n))(x: WholeChains.Carrier n) ->
  (from ((RelativeRing.space (I.Int^::ofNat n)).smul a h)).apply x = ((Whole.space n).smul a (from h)).apply x :=
  \fun (a: R)(h: RelativeCochains.Carrier (I.Int^::ofNat n))(x: WholeChains.Carrier n) =>
    \refl((Whole.coefficients.space).smul a ((h).apply (Relative.class (I.Int^::ofNat n) (Positive.intro x))));
\definition scalar: \forall (a: R)(h: RelativeCochains.Carrier (I.Int^::ofNat n)) ->
  from ((RelativeRing.space (I.Int^::ofNat n)).smul a h) = (Whole.space n).smul a (from h) :=
  \fun (a: R)(h: RelativeCochains.Carrier (I.Int^::ofNat n)) => WholeMaps.ext _ _ (scalarValue a h);
\import module_theory.Module[].Over[R := R, ring := Rings.commutativeRingAsRing R ring].Hom[V := RelativeCochains.Carrier (I.Int^::ofNat n), W := Whole.Carrier n, source := RelativeRing.space (I.Int^::ofNat n), target := Whole.space n] \as Maps;
\definition map: Maps.Map := Maps.Map { apply := from, addition := addition, scalar := scalar };
