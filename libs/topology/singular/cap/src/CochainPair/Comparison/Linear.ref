\import std.Alg[].Ring[] \as Rings;
\import Relative.OverRing[R := R, ring := ring].With[coefficients := Whole.coefficients] \as RelativeRing;
\definition addition: \forall (h, k: RelativeCochains.Carrier (I.Int^::ofNat n)) ->
  from ((RelativeRing.space (I.Int^::ofNat n)).add h k) = (Whole.space n).add (from h) (from k) :=
  \fun (h, k: RelativeCochains.Carrier (I.Int^::ofNat n)) => WholeMaps.ext _ _
    (\fun (x: WholeChains.Carrier n) => \refl((Whole.coefficients.space).add ((h).apply (Relative.class (I.Int^::ofNat n) (Positive.intro x))) ((k).apply (Relative.class (I.Int^::ofNat n) (Positive.intro x)))));
\definition scalar: \forall (a: R)(h: RelativeCochains.Carrier (I.Int^::ofNat n)) ->
  from ((RelativeRing.space (I.Int^::ofNat n)).smul a h) = (Whole.space n).smul a (from h) :=
  \fun (a: R)(h: RelativeCochains.Carrier (I.Int^::ofNat n)) => WholeMaps.ext _ _
    (\fun (x: WholeChains.Carrier n) => \refl((Whole.coefficients.space).smul a ((h).apply (Relative.class (I.Int^::ofNat n) (Positive.intro x))));
