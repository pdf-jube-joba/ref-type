\import \parent.\parent.Comparison[n := N.Nat^::succ n] \as Higher;
\import \parent.\parent.Differential[n := n] \as Differential;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.Quotient[C := SubExtension.complex, D := Extension.complex].On[f := Relative.inclusionMap] \as Q;
\import WholeChains.Boundary[n := n] \as Boundary;
\definition law: \forall (h: RelativeCochains.Carrier (I.Int^::ofNat n)) ->
  Higher.from ((RelativeCochains.complex.differential).apply (I.Int^::ofNat n) h) = Differential.apply (from h) :=
  \fun (h: RelativeCochains.Carrier (I.Int^::ofNat n)) =>
    Modules.Hom[V := WholeChains.Carrier (N.Nat^::succ n), W := R, source := WholeChains.space (N.Nat^::succ n), target := Whole.integerCoefficients.space].ext _ _
      (\fun (x: WholeChains.Carrier (N.Nat^::succ n)) =>
        congr!{{Relative.Carrier (I.Int^::ofNat n)} R} ((h).apply) _ _
          (Q.At[k := I.Int^::ofNat (N.Nat^::succ n)].onClass (Extension.Positive[n := N.Nat^::succ n].intro x)));
