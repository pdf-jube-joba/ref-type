\import std.Arithmetic[].Int[] \as I;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\import Relative.With[coefficients := Whole.integerCoefficients] \as RelativeCochains;
\import Relative.OverRing[R := R, ring := ring].With[coefficients := Whole.coefficients] \as RelativeRing;
\import std.Alg[].Ring[] \as Rings;
\import module_theory.Module[].Over[R := R, ring := Rings.commutativeRingAsRing R ring] \as Modules;
\definition Carrier[n: N.Nat^]: \Set := RelativeCochains.Carrier (I.Int^::ofNat n);
\definition space[n: N.Nat^]: Modules.Space (Carrier n) := RelativeRing.space (I.Int^::ofNat n);
\definition from[n: N.Nat^]: Carrier n -> Whole.Carrier n := \parent.Comparison[n := n].from;
\definition apply[m, n: N.Nat^][same: m = n]: Carrier m -> Carrier n := Transport.cast Carrier m n same;
\definition zero: \forall (m, n: N.Nat^)(same: m = n) -> apply m n same (space m).zero = (space n).zero := Transport.pointNatural Carrier (\fun (k: N.Nat^) => (space k).zero);
\definition fromNatural: \forall (m, n: N.Nat^)(same: m = n)(x: Carrier m) ->
  Transport.cast Whole.Carrier m n same (from m x) = from n (apply m n same x) := Transport.natural Carrier Whole.Carrier from;
\definition differential[n: N.Nat^]: Carrier n -> Carrier (N.Nat^::succ n) := (RelativeCochains.complex.differential).apply (I.Int^::ofNat n);
\module Boundaries;
