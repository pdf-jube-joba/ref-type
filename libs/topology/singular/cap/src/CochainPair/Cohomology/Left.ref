\import RelativeComplexes.At[C := RelativeRing.complex, z := I.Int^::ofNat p] \as LeftTheory;
\import OrdinaryComplexes.At[C := OrdinaryRing.complex, k := q] \as RightTheory;
\definition cycle[alpha: LeftTheory.Closed][beta: RightTheory.CycleCarrier]: Output.Closed :=
  Output.cycle (Product.left alpha beta) (ProductClosed.leftLaw alpha beta (\bysub(Degree.Carrier p, (LeftTheory.cycles).carrier, alpha)) (\bysub(Whole.Carrier q, (RightTheory.cycles).carrier, beta)));
\definition leftCycles: Modules.Bundle := Modules.Bundle { Carrier := LeftTheory.Closed, space := LeftTheory.cycleSpace };
\definition rightCycles: Modules.Bundle := Modules.Bundle { Carrier := RightTheory.CycleCarrier, space := RightTheory.cycleSpace };
\import Commutative.Bilinear[A := leftCycles, B := rightCycles, C := outputBundle] \as Bilinear;
\definition cycleAddLeft: \forall (x, y: LeftTheory.Closed)(z: RightTheory.CycleCarrier) -> cycle ((LeftTheory.cycleSpace).add x y) z = (Output.cycleSpace).add (cycle x z) (cycle y z) := \fun (x, y: LeftTheory.Closed)(z: RightTheory.CycleCarrier) => ProductLaws.leftLeftAdd x y z;
\definition cycleAddRight: \forall (x: LeftTheory.Closed)(y, z: RightTheory.CycleCarrier) -> cycle x ((RightTheory.cycleSpace).add y z) = (Output.cycleSpace).add (cycle x y) (cycle x z) := \fun (x: LeftTheory.Closed)(y, z: RightTheory.CycleCarrier) => ProductLaws.leftRightAdd x y z;
\definition cycleScaleLeft: \forall (a: R)(x: LeftTheory.Closed)(z: RightTheory.CycleCarrier) -> cycle ((LeftTheory.cycleSpace).smul a x) z = (Output.cycleSpace).smul a (cycle x z) := \fun (a: R)(x: LeftTheory.Closed)(z: RightTheory.CycleCarrier) => ProductLaws.leftLeftScale a x z;
\definition cycleScaleRight: \forall (a: R)(x: LeftTheory.Closed)(z: RightTheory.CycleCarrier) -> cycle x ((RightTheory.cycleSpace).smul a z) = (Output.cycleSpace).smul a (cycle x z) := \fun (a: R)(x: LeftTheory.Closed)(z: RightTheory.CycleCarrier) => ProductLaws.leftRightScale a x z;
\definition onCycles: Bilinear.Map := Bilinear.Map {
  apply := \fun (x: LeftTheory.Closed)(y: RightTheory.CycleCarrier) => Output.classOf (cycle x y),
  addLeft := \fun (x, y: LeftTheory.Closed)(z: RightTheory.CycleCarrier) => trans!{Output.Cohomology} _ _ _
    (congr!{Output.Closed Output.Cohomology} Output.classOf _ _ (cycleAddLeft x y z))
    ((Output.classLinear).addition (cycle x z) (cycle y z)),
  addRight := \fun (x: LeftTheory.Closed)(y, z: RightTheory.CycleCarrier) => trans!{Output.Cohomology} _ _ _
    (congr!{Output.Closed Output.Cohomology} Output.classOf _ _ (cycleAddRight x y z))
    ((Output.classLinear).addition (cycle x y) (cycle x z)),
  scaleLeft := \fun (a: R)(x: LeftTheory.Closed)(z: RightTheory.CycleCarrier) => trans!{Output.Cohomology} _ _ _
    (congr!{Output.Closed Output.Cohomology} Output.classOf _ _ (cycleScaleLeft a x z))
    ((Output.classLinear).scalar a (cycle x z)),
  scaleRight := \fun (a: R)(x: LeftTheory.Closed)(z: RightTheory.CycleCarrier) => trans!{Output.Cohomology} _ _ _
    (congr!{Output.Closed Output.Cohomology} Output.classOf _ _ (cycleScaleRight a x z))
    ((Output.classLinear).scalar a (cycle x z)),
};
\import Bilinear.Quotients[S := LeftTheory.boundariesInside, T := RightTheory.boundariesInside] \as Quotients;
\definition leftVanishes: Quotients.VanishesLeft onCycles :=
  \fun (x: LeftTheory.Closed)(y: RightTheory.CycleCarrier)(boundary: _) => Output.boundaryClassZero (cycle x y) (Boundaries.leftFirst p q x y (\bysub(Whole.Carrier q, (RightTheory.cycles).carrier, y)) boundary);
\definition rightVanishes: Quotients.VanishesRight onCycles :=
  \fun (x: LeftTheory.Closed)(y: RightTheory.CycleCarrier)(boundary: _) => Output.boundaryClassZero (cycle x y) (Boundaries.leftSecond p q x y (\bysub(Degree.Carrier p, (LeftTheory.cycles).carrier, x)) boundary);
\definition bilinear: Quotients.QuotientMap := Quotients.descend onCycles leftVanishes rightVanishes;
\definition apply: LeftTheory.Cohomology -> RightTheory.Cohomology -> Output.Cohomology := (bilinear).apply;
\definition onClasses: \forall (x: LeftTheory.Closed)(y: RightTheory.CycleCarrier) -> apply (LeftTheory.classOf x) (RightTheory.classOf y) = Output.classOf (cycle x y) :=
  Quotients.onClasses onCycles leftVanishes rightVanishes;
