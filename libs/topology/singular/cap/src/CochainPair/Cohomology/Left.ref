\import RelativeComplexes.At[C := RelativeRing.complex, z := I.Int^::ofNat p] \as A;
\import OrdinaryComplexes.At[C := OrdinaryRing.complex, k := q] \as B;
\definition cycle[alpha: A.Closed][beta: B.CycleCarrier]: Output.Closed :=
  Output.cycle (Product.left alpha beta) (ProductClosed.leftLaw alpha beta (\bysub(Degree.Carrier p, (A.cycles).carrier, alpha)) (\bysub(Whole.Carrier q, (B.cycles).carrier, beta)));
\definition leftCycles: Modules.Bundle := Modules.Bundle { Carrier := A.Closed, space := A.cycleSpace };
\definition rightCycles: Modules.Bundle := Modules.Bundle { Carrier := B.CycleCarrier, space := B.cycleSpace };
\import Commutative.Bilinear[A := leftCycles, B := rightCycles, C := outputBundle] \as Bilinear;
\definition onCycles: Bilinear.Map := Bilinear.Map {
  apply := \fun (x: A.Closed)(y: B.CycleCarrier) => Output.classOf (cycle x y),
  addLeft := \fun (x, y: A.Closed)(z: B.CycleCarrier) => trans!{Output.Cohomology} _ _ _
    (congr!{Output.Closed Output.Cohomology} Output.classOf _ _ (ProductLaws.leftLeftAdd x y z))
    ((Output.classLinear).addition (cycle x z) (cycle y z)),
  addRight := \fun (x: A.Closed)(y, z: B.CycleCarrier) => trans!{Output.Cohomology} _ _ _
    (congr!{Output.Closed Output.Cohomology} Output.classOf _ _ (ProductLaws.leftRightAdd x y z))
    ((Output.classLinear).addition (cycle x y) (cycle x z)),
  scaleLeft := \fun (a: R)(x: A.Closed)(z: B.CycleCarrier) => trans!{Output.Cohomology} _ _ _
    (congr!{Output.Closed Output.Cohomology} Output.classOf _ _ (ProductLaws.leftLeftScale a x z))
    ((Output.classLinear).scalar a (cycle x z)),
  scaleRight := \fun (a: R)(x: A.Closed)(z: B.CycleCarrier) => trans!{Output.Cohomology} _ _ _
    (congr!{Output.Closed Output.Cohomology} Output.classOf _ _ (ProductLaws.leftRightScale a x z))
    ((Output.classLinear).scalar a (cycle x z)),
};
\import Bilinear.Quotients[S := A.boundariesInside, T := B.boundariesInside] \as Quotients;
\definition leftVanishes: Quotients.VanishesLeft onCycles :=
  \fun (x: A.Closed)(y: B.CycleCarrier)(boundary: _) => Output.boundaryClassZero (cycle x y) (Boundaries.leftFirst p q x y (\bysub(Whole.Carrier q, (B.cycles).carrier, y)) boundary);
\definition rightVanishes: Quotients.VanishesRight onCycles :=
  \fun (x: A.Closed)(y: B.CycleCarrier)(boundary: _) => Output.boundaryClassZero (cycle x y) (Boundaries.leftSecond p q x y (\bysub(Degree.Carrier p, (A.cycles).carrier, x)) boundary);
\definition bilinear: Quotients.QuotientMap := Quotients.descend onCycles leftVanishes rightVanishes;
\definition apply: A.Cohomology -> B.Cohomology -> Output.Cohomology := (bilinear).apply;
\definition onClasses: \forall (x: A.Closed)(y: B.CycleCarrier) -> apply (A.classOf x) (B.classOf y) = Output.classOf (cycle x y) :=
  Quotients.onClasses onCycles leftVanishes rightVanishes;
