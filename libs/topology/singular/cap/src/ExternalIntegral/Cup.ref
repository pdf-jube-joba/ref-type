\import std.Arithmetic[].Int[] \as I;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.At[C := LeftCochains.complex, z := I.Int^::ofNat p] \as LeftInput;
\import Complexes.At[C := RightCochains.complex, z := I.Int^::ofNat q] \as RightInput;
\import Cover.On[conditions := conditions].Cup[p := p, q := q] \as Product;
\import std.Data[].Nat[].Basic[].Def[] \as Nat;
\definition total: N.Nat^ := Nat.add p q;
\import singular_cohomology.Relative[A := Product.CarrierSet, source := External.topology, subset := \root.Triple[A := Product.CarrierSet, source := External.topology, first := Relative.leftInverse, second := Relative.rightInverse].Union[].subset].With[coefficients := Whole.integerCoefficients] \as OutputCochains;
\import Complexes.At[C := OutputCochains.complex, z := I.Int^::ofNat total] \as Output;
\definition apply[alpha: LeftInput.Cohomology][beta: RightInput.Cohomology]: Output.Cohomology :=
  Product.apply ((LeftPull.At[z := I.Int^::ofNat p].induced).apply alpha) ((RightPull.At[z := I.Int^::ofNat q].induced).apply beta);
