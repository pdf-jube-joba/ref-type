\import \parent.\parent.\parent.Homology[].All[] \as Source;
\import Target.Cross[].Homology[].All[] \as Destination;
\import LeftPairMaps.On[f := f].Integer[] \as LeftMap;
\import RightPairMaps.On[f := g].Integer[] \as RightMap;
\import UnionPairMaps.On[f := unionMap].Integer[] \as UnionMap;
\import singular_products.Cross[A := A, B := B, left := left, right := right] \as Whole;
\definition Property[p, q: N.Nat^]: \Prop := \forall (x: Source.LeftHomology p)(y: Source.RightHomology q) ->
  (UnionMap.At[z := I.Int^::ofNat (Whole.degree p q)].induced).apply (Source.apply p q x y) =
  Destination.apply p q ((LeftMap.At[z := I.Int^::ofNat p].induced).apply x) ((RightMap.At[z := I.Int^::ofNat q].induced).apply y);
\definition law: \forall (p, q: N.Nat^) -> Property p q :=
  \induction (p: N.Nat^) \return \forall (q: N.Nat^) -> Property p q \with {
    | zero: \induction (q: N.Nat^) \return Property N.Nat^::zero q \with {
      | zero: \parent.ZeroZero[].law
      | succ: \fun (s: N.Nat^)(unused: _) => \parent.LeftZero[s := s].law
    }
    | succ: \fun (r: N.Nat^)(unused: _) => \induction (q: N.Nat^) \return Property (N.Nat^::succ r) q \with {
      | zero: \parent.RightZero[r := r].law
      | succ: \fun (s: N.Nat^)(unused2: _) => \parent.Positive[r := r, s := s].law
    }
  };
