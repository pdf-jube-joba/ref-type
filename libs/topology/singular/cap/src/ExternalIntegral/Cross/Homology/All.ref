\module At(n: N.Nat^) {
  \import Complexes.At[C := Left.complex, z := I.Int^::ofNat n] \as L;
  \import Complexes.At[C := Right.complex, z := I.Int^::ofNat n] \as R;
  \import Complexes.At[C := TargetRelative.complex, z := I.Int^::ofNat n] \as T;
  \definition LeftHomology: \Set := L.Homology;
  \definition RightHomology: \Set := R.Homology;
  \definition TargetHomology: \Set := T.Homology;
}
\definition LeftHomology[n: N.Nat^]: \Set := At[n := n].LeftHomology;
\definition RightHomology[n: N.Nat^]: \Set := At[n := n].RightHomology;
\definition TargetHomology[n: N.Nat^]: \Set := At[n := n].TargetHomology;
\definition Product[p, q: N.Nat^]: \Set := LeftHomology p -> RightHomology q -> TargetHomology (Whole.degree p q);
\definition apply: \forall (p, q: N.Nat^) -> Product p q :=
  \induction (p: N.Nat^) \return \forall (q: N.Nat^) -> Product p q \with {
    | zero: \induction (q: N.Nat^) \return Product N.Nat^::zero q \with {
      | zero: \parent.ZeroZero[].Descent[].apply
      | succ: \fun (s: N.Nat^)(unused: _) => \parent.LeftZero[s := s].Descent[].apply
    }
    | succ: \fun (r: N.Nat^)(unused: _) => \induction (q: N.Nat^) \return Product (N.Nat^::succ r) q \with {
      | zero: \parent.RightZero[r := r].Descent[].apply
      | succ: \fun (s: N.Nat^)(unused2: _) => \parent.Positive[r := r, s := s].Descent[].apply
    }
  };
