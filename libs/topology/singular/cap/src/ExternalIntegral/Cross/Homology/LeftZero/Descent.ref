\import \parent.LeftBoundary[] \as LeftBoundary;
\import \parent.RightBoundary[] \as RightBoundary;
\import CycleForms.Quotients[S := L.boundariesInside, T := R.boundariesInside] \as Quotients;
\definition bilinear: Quotients.QuotientMap := Quotients.descend onCycles LeftBoundary.vanishes RightBoundary.vanishes;
\definition apply: L.Homology -> R.Homology -> T.Homology := bilinear.apply;
\definition onClasses: \forall (x: L.Cycle)(y: R.Cycle) ->
  apply (L.classOf x) (R.classOf y) = T.classOf (cycle x y) := Quotients.onClasses onCycles LeftBoundary.vanishes RightBoundary.vanishes;
