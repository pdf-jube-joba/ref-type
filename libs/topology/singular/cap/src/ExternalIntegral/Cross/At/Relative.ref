\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import Nonnegative.ZeroExtension[C := LeftChains.complex] \as LeftExtension;
\import Nonnegative.ZeroExtension[C := LeftSubChains.complex] \as LeftSubExtension;
\import Nonnegative.ZeroExtension[C := RightChains.complex] \as RightExtension;
\import Nonnegative.ZeroExtension[C := RightSubChains.complex] \as RightSubExtension;
\import Nonnegative.ZeroExtension[C := ProductChains.complex] \as ProductExtension;
\import singular_cohomology.Chains[A := TargetRelative.SubspaceCarrier, source := UnionSpace.topology External.topology] \as UnionChains;
\import Nonnegative.ZeroExtension[C := UnionChains.complex] \as UnionExtension;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.Quotient[C := LeftSubExtension.complex, D := LeftExtension.complex].On[f := Left.inclusionMap].At[k := I.Int^::ofNat p] \as LeftQ;
\import Complexes.Quotient[C := RightSubExtension.complex, D := RightExtension.complex].On[f := Right.inclusionMap].At[k := I.Int^::ofNat q] \as RightQ;
\import Complexes.Quotient[C := UnionExtension.complex, D := ProductExtension.complex].On[f := TargetRelative.inclusionMap].At[k := I.Int^::ofNat (Whole.degree p q)] \as TargetQ;
\definition targetBundle: Modules.Bundle := Modules.Bundle { Carrier := TargetQ.Carrier, space := TargetQ.space };
\import Commutative.Bilinear[A := CrossProduct.leftBundle, B := CrossProduct.rightBundle, C := CrossProduct.targetBundle].Postcompose[D := targetBundle] \as Post;
\import Commutative.Bilinear[A := CrossProduct.leftBundle, B := CrossProduct.rightBundle, C := targetBundle] \as Raw;
\definition raw: Raw.Map := Post.apply CrossProduct.bilinear TargetQ.projection;
\import Raw.Quotients[S := LeftQ.image, T := RightQ.image] \as Quotients;
\import Modules.Of[V := LeftChains.Carrier p, space := LeftChains.space p].Submodule[].Image[U := LeftSubChains.Carrier p, source := LeftSubChains.space p] \as LeftImages;
\import Modules.Of[V := RightChains.Carrier q, space := RightChains.space q].Submodule[].Image[U := RightSubChains.Carrier q, source := RightSubChains.space q] \as RightImages;
\import Complexes.Map[C := LeftSubExtension.complex, D := LeftExtension.complex].At[k := I.Int^::ofNat p] \as LeftAt;
\import Complexes.Map[C := RightSubExtension.complex, D := RightExtension.complex].At[k := I.Int^::ofNat q] \as RightAt;
\definition leftZero: Quotients.VanishesLeft raw :=
  \fun (x: LeftChains.Carrier p)(y: RightChains.Carrier q)(member: _) => LeftImages.eliminate (LeftAt.linear Left.inclusionMap) x ((raw).apply x y = (TargetQ.space).zero)
    (\fun (v: LeftSubChains.Carrier p)(same: (Left.inclusionMap).apply (I.Int^::ofNat p) v = x) => eq_reason_in!{TargetQ.Carrier _
      "=" _ "by" { congr!{{LeftChains.Carrier p} TargetQ.Carrier} (\fun (z: LeftChains.Carrier p) => (raw).apply z y) _ _ (sym!{{LeftChains.Carrier p}} _ _ same) }
      "=" _ "by" { congr!{{ProductChains.Carrier (Whole.degree p q)} TargetQ.Carrier} TargetQ.class _ _ (left v y) }
      "=" _ "by" { TargetQ.onImage ((LeftIntoMaps.At[n := Whole.degree p q].push leftInto leftContinuous).apply (LeftCross.apply v y)) }
    }) member;
\definition rightZero: Quotients.VanishesRight raw :=
  \fun (x: LeftChains.Carrier p)(y: RightChains.Carrier q)(member: _) => RightImages.eliminate (RightAt.linear Right.inclusionMap) y ((raw).apply x y = (TargetQ.space).zero)
    (\fun (v: RightSubChains.Carrier q)(same: (Right.inclusionMap).apply (I.Int^::ofNat q) v = y) => eq_reason_in!{TargetQ.Carrier _
      "=" _ "by" { congr!{{RightChains.Carrier q} TargetQ.Carrier} (\fun (z: RightChains.Carrier q) => (raw).apply x z) _ _ (sym!{{RightChains.Carrier q}} _ _ same) }
      "=" _ "by" { congr!{{ProductChains.Carrier (Whole.degree p q)} TargetQ.Carrier} TargetQ.class _ _ (right x v) }
      "=" _ "by" { TargetQ.onImage ((RightIntoMaps.At[n := Whole.degree p q].push rightInto rightContinuous).apply (RightCross.apply x v)) }
    }) member;
\definition bilinear: Quotients.QuotientMap := Quotients.descend raw leftZero rightZero;
\definition apply: LeftQ.Carrier -> RightQ.Carrier -> TargetQ.Carrier := (bilinear).apply;
\definition onClasses: \forall (x: LeftChains.Carrier p)(y: RightChains.Carrier q) ->
  apply (LeftQ.class x) (RightQ.class y) = TargetQ.class (CrossProduct.apply x y) := Quotients.onClasses raw leftZero rightZero;
