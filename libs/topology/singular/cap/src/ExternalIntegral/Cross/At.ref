\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import singular_cohomology.Chains[A := A, source := left] \as LeftChains;
\import singular_cohomology.Chains[A := B, source := right] \as RightChains;
\import singular_cohomology.Chains[A := Left.SubspaceCarrier, source := LeftSpace.topology left] \as LeftSubChains;
\import singular_cohomology.Chains[A := Right.SubspaceCarrier, source := RightSpace.topology right] \as RightSubChains;
\import singular_cohomology.Maps[A := Left.SubspaceCarrier, B := A, source := LeftSpace.topology left, target := left] \as LeftInclusion;
\import singular_cohomology.Maps[A := Right.SubspaceCarrier, B := B, source := RightSpace.topology right, target := right] \as RightInclusion;
\import singular_products.Cross[A := A, B := B, left := left, right := right] \as Whole;
\import Whole.At[p := p, q := q] \as Product;
\import singular_products.Cross[A := Left.SubspaceCarrier, B := B, left := LeftSpace.topology left, right := right].At[p := p, q := q] \as LeftCross;
\import singular_products.Cross[A := A, B := Right.SubspaceCarrier, left := left, right := RightSpace.topology right].At[p := p, q := q] \as RightCross;
\import LeftMapping.Cross[p := p, q := q, f := leftMap] \as LeftNatural;
\import RightMapping.Cross[p := p, q := q, f := rightMap] \as RightNatural;
\import \parent.Factor[n := Whole.degree p q] \as Factor;
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing] \as Commutative;
\import Commutative.Bilinear[A := LeftCross.leftBundle, B := LeftCross.rightBundle, C := Product.targetBundle] \as LeftForms;
\import Commutative.Bilinear[A := RightCross.leftBundle, B := RightCross.rightBundle, C := Product.targetBundle] \as RightForms;
\import Modules.Hom[V := RightChains.Carrier q, W := RightChains.Carrier q, source := RightChains.space q, target := RightChains.space q] \as RightEnd;
\import Modules.Hom[V := LeftChains.Carrier p, W := LeftChains.Carrier p, source := LeftChains.space p, target := LeftChains.space p] \as LeftEnd;
\import singular_cohomology.Maps[A := LeftProduct.CarrierSet, B := TargetRelative.SubspaceCarrier, source := LeftMapping.source, target := UnionSpace.topology External.topology] \as LeftIntoMaps;
\import singular_cohomology.Maps[A := RightProduct.CarrierSet, B := TargetRelative.SubspaceCarrier, source := RightMapping.source, target := UnionSpace.topology External.topology] \as RightIntoMaps;
\import singular_cohomology.Maps[A := TargetRelative.SubspaceCarrier, B := Product.CarrierSet, source := UnionSpace.topology External.topology, target := External.topology] \as Inclusion;
\import singular_cohomology.Chains[A := Product.CarrierSet, source := External.topology] \as ProductChains;
\definition left: \forall (x: LeftSubChains.Carrier p)(y: RightChains.Carrier q) ->
  Product.apply ((LeftInclusion.At[n := p].push Left.inclusion Left.inclusionContinuous).apply x) y =
  (Inclusion.At[n := Whole.degree p q].push TargetRelative.inclusion TargetRelative.inclusionContinuous).apply
    ((LeftIntoMaps.At[n := Whole.degree p q].push leftInto leftContinuous).apply (LeftCross.apply x y)) :=
  \fun (x: LeftSubChains.Carrier p)(y: RightChains.Carrier q) => eq_reason_in!{{ProductChains.Carrier (Whole.degree p q)} _
    "=" _ "by" { congr!{{RightChains.Carrier q} {ProductChains.Carrier (Whole.degree p q)}} (\fun (z: RightChains.Carrier q) => Product.apply ((LeftInclusion.At[n := p].push Left.inclusion Left.inclusionContinuous).apply x) z) _ _
      (sym!{{RightChains.Carrier q}} _ _ (congr!{RightEnd.Map {RightChains.Carrier q}} (\fun (f: RightEnd.Map) => f.apply y) _ _ RightIdentity.At[n := q].law)) }
    "=" _ "by" { congr!{LeftForms.Map {ProductChains.Carrier (Whole.degree p q)}} (\fun (f: LeftForms.Map) => f.apply x y) _ _ (sym!{LeftForms.Map} _ _ LeftNatural.equation) }
    "=" _ "by" { Factor.left (LeftCross.apply x y) }
  };
\definition right: \forall (x: LeftChains.Carrier p)(y: RightSubChains.Carrier q) ->
  Product.apply x ((RightInclusion.At[n := q].push Right.inclusion Right.inclusionContinuous).apply y) =
  (Inclusion.At[n := Whole.degree p q].push TargetRelative.inclusion TargetRelative.inclusionContinuous).apply
    ((RightIntoMaps.At[n := Whole.degree p q].push rightInto rightContinuous).apply (RightCross.apply x y)) :=
  \fun (x: LeftChains.Carrier p)(y: RightSubChains.Carrier q) => eq_reason_in!{{ProductChains.Carrier (Whole.degree p q)} _
    "=" _ "by" { congr!{{LeftChains.Carrier p} {ProductChains.Carrier (Whole.degree p q)}} (\fun (z: LeftChains.Carrier p) => Product.apply z ((RightInclusion.At[n := q].push Right.inclusion Right.inclusionContinuous).apply y)) _ _
      (sym!{{LeftChains.Carrier p}} _ _ (congr!{LeftEnd.Map {LeftChains.Carrier p}} (\fun (f: LeftEnd.Map) => f.apply x) _ _ LeftIdentity.At[n := p].law)) }
    "=" _ "by" { congr!{RightForms.Map {ProductChains.Carrier (Whole.degree p q)}} (\fun (f: RightForms.Map) => f.apply x y) _ _ (sym!{RightForms.Map} _ _ RightNatural.equation) }
    "=" _ "by" { Factor.right (RightCross.apply x y) }
  };
