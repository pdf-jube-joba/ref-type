\import std.Data[].Nat[] \as N;
\import std.Data[].Pair[] \as Pair;
\import topological_constructions.Product[A := A, B := B] \as Product;
\definition topology: topology.Topology[Carrier := Product.CarrierSet].Topology := Product.topology left right;
\import singular_products.Cochains[A := A, source := left, R := R, ring := ring] \as Left;
\import singular_products.Cochains[A := B, source := right, R := R, ring := ring] \as Right;
\import singular_products.Cochains[A := Product.CarrierSet, source := topology, R := R, ring := ring] \as Whole;
\import Whole.Pullback[B := A, target := left] \as LeftPull;
\import Whole.Pullback[B := B, target := right] \as RightPull;
\import Product.Maps[] \as Projections;
\definition leftProjection: Product.CarrierSet -> A := Pair.first A B;
\definition rightProjection: Product.CarrierSet -> B := Pair.second A B;
\definition leftContinuous: singular_cohomology.Maps[A := Product.CarrierSet, B := A, source := topology, target := left].Continuous leftProjection := Projections.firstContinuous left right;
\definition rightContinuous: singular_cohomology.Maps[A := Product.CarrierSet, B := B, source := topology, target := right].Continuous rightProjection := Projections.secondContinuous left right;
\module Cup(p, q: N.Nat^);
\module Cohomology(p, q: N.Nat^);
