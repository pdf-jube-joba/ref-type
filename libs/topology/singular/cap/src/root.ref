\module Integral(A: \Set, source: topology.Topology[Carrier := A].Topology);
\module CochainPair(A: \Set, source: topology.Topology[Carrier := A].Topology, subset: \Pow A, R: \Set, ring: std.Alg[].Ring[].CommutativeRing[R]);
\module RelativeEvaluation(A: \Set, source: topology.Topology[Carrier := A].Topology, subset: \Pow A);
\module External(A, B: \Set, left: topology.Topology[Carrier := A].Topology, right: topology.Topology[Carrier := B].Topology, R: \Set, ring: std.Alg[].Ring[].CommutativeRing[R]);
