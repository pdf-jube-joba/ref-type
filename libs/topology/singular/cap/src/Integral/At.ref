\import Simplices.Cut[p := p, q := q] \as Cut;
\definition total: N.Nat^ := Cut.total;
\import Modules.Free[Generators := Simplices.Carrier total].To[W := Chains.Carrier p, target := Chains.space p] \as Free;
\import Modules.Hom[V := Chains.Carrier total, W := Chains.Carrier p, source := Chains.space total, target := Chains.space p] \as Maps;
\definition value[beta: Cochains.Carrier q][sigma: Simplices.Carrier total]: Chains.Carrier p :=
  (Chains.space p).smul ((beta).apply (Chains.generator q (Cut.back sigma))) (Chains.generator p (Cut.front sigma));
\definition map[beta: Cochains.Carrier q]: Maps.Map := Free.extension (value beta);
\definition onGenerator: \forall (beta: Cochains.Carrier q)(sigma: Simplices.Carrier total) ->
  (map beta).apply (Chains.generator total sigma) = value beta sigma := 
  \fun (beta: Cochains.Carrier q) => Free.onGenerator (value beta);
\module Adjunction;
\module Zero;
\module Bilinear;
