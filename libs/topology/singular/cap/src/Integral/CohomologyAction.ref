\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import singular_cohomology.Cochains[A := A, source := source].OverRing[R := I.Int^, ring := Integers.commutativeRing].With[coefficients := Cochains.coefficients] \as Theory;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as CochainComplexes;
\import CochainComplexes.At[C := Theory.complex, k := N.Nat^::succ r] \as Cochain;
\import \parent.Homology[p := p, q := N.Nat^::succ r] \as H;
\import Simplices.CutFaces[p := p, q := N.Nat^::succ r] \as Geometry;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.Positive[C := Chains.complex, n := Geometry.total] \as Source;
\import Complexes.Positive[C := Chains.complex, n := p] \as Target;
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing].HomSpace[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as Actions;
\import Modules.Hom[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as ActionMaps;
\import \parent.At[p := N.Nat^::succ p, q := N.Nat^::succ r].Bilinear[] \as Bilinear;
\import Chains.DegreeTransport[] \as Degrees;
\definition closed[alpha: Cochain.CycleCarrier]: H.Closed alpha := \bysub(Cochains.Carrier (N.Nat^::succ r), (Cochain.cycles).carrier, alpha);
\module On(alpha: Cochain.CycleCarrier) {
  \import H.On[beta := alpha, closed := closed alpha].Induced[] \as Induced;
  \definition map: Actions.Carrier := Induced.map;
}
\definition value[alpha: Cochain.CycleCarrier]: Actions.Carrier := On[alpha := alpha].map;
\module Linearity;
\module Descent;
