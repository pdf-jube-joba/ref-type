\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import N.Basic[].Def[] \as Nat;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.DegreeZero[C := Chains.complex] \as Target;
\import Complexes.Positive[C := Chains.complex, n := Nat.add N.Nat^::zero r] \as Source;
\import \parent.At[p := N.Nat^::zero, q := N.Nat^::succ r] \as Cap;
\import \parent.At[p := N.Nat^::succ N.Nat^::zero, q := N.Nat^::succ r] \as Upper;
\import \parent.Diagonal[].Boundary[p := N.Nat^::zero, q := N.Nat^::succ r] \as Boundary;
\import Boundary.Closed[] \as Closed;
\import Simplices.CutFaces[p := N.Nat^::zero, q := N.Nat^::succ r] \as Geometry;
\import Chains.DegreeTransport[] \as Degrees;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients] \as Ordinary;
\definition ClosedCochain[beta: Cochains.Carrier (N.Nat^::succ r)]: \Prop := Ordinary.coboundary (N.Nat^::succ r) beta = (Cochains.space (N.Nat^::succ (N.Nat^::succ r))).zero;
\module On(beta: Cochains.Carrier (N.Nat^::succ r), closed: ClosedCochain beta);
