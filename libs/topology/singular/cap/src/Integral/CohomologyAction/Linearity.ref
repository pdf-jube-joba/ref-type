\import \parent.On[alpha := (Cochain.cycleSpace).zero] \as Zero;
\definition addition: \forall (alpha, beta: Cochain.CycleCarrier) -> value ((Cochain.cycleSpace).add alpha beta) = Actions.add (value alpha) (value beta) :=
  \fun (alpha, beta: Cochain.CycleCarrier) => ActionMaps.ext _ _
    (Source.classInduction (\fun (x: Source.Homology) => (value ((Cochain.cycleSpace).add alpha beta)).apply x = (Actions.add (value alpha) (value beta)).apply x)
      (\fun (x: Source.Cycle) => eq_reason_in!{Target.Homology _
        "=" _ "by" { On[alpha := (Cochain.cycleSpace).add alpha beta].Induced[].onClass x }
        "=" _ "by" { congr!{Target.Cycle Target.Homology} Target.classOf _ _
          (congr!{{Modules.Hom[V := Chains.Carrier Geometry.leftDegree, W := Chains.Carrier (N.Nat^::succ p), source := Chains.space Geometry.leftDegree, target := Chains.space (N.Nat^::succ p)].Map} {Chains.Carrier (N.Nat^::succ p)}}
            (\fun (f: Modules.Hom[V := Chains.Carrier Geometry.leftDegree, W := Chains.Carrier (N.Nat^::succ p), source := Chains.space Geometry.leftDegree, target := Chains.space (N.Nat^::succ p)].Map) => (f).apply (Degrees.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)) _ _ (Bilinear.addition alpha beta)) }
        "=" _ "by" { (Target.classLinear).addition (H.On[beta := alpha, closed := closed alpha].cycle x) (H.On[beta := beta, closed := closed beta].cycle x) }
        "=" _ "by" { congr!{Target.Homology Target.Homology Target.Homology} ((Target.homologySpace).add) _ _ _ _
          (sym!{Target.Homology} _ _ (On[alpha := alpha].Induced[].onClass x)) (sym!{Target.Homology} _ _ (On[alpha := beta].Induced[].onClass x)) }
      }));
\definition scalar: \forall (a: I.Int^)(alpha: Cochain.CycleCarrier) -> value ((Cochain.cycleSpace).smul a alpha) = Actions.scale a (value alpha) :=
  \fun (a: I.Int^)(alpha: Cochain.CycleCarrier) => ActionMaps.ext _ _
    (Source.classInduction (\fun (x: Source.Homology) => (value ((Cochain.cycleSpace).smul a alpha)).apply x = (Actions.scale a (value alpha)).apply x)
      (\fun (x: Source.Cycle) => eq_reason_in!{Target.Homology _
        "=" _ "by" { On[alpha := (Cochain.cycleSpace).smul a alpha].Induced[].onClass x }
        "=" _ "by" { congr!{Target.Cycle Target.Homology} Target.classOf _ _
          (Bilinear.scalarValue a alpha (Degrees.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)) }
        "=" _ "by" { (Target.classLinear).scalar a (H.On[beta := alpha, closed := closed alpha].cycle x) }
        "=" _ "by" { congr!{Target.Homology Target.Homology} ((Target.homologySpace).smul a) _ _ (sym!{Target.Homology} _ _ (On[alpha := alpha].Induced[].onClass x)) }
      }));
