\definition addition: \forall (alpha, beta: Cochain.CycleCarrier) -> value ((Cochain.cycleSpace).add alpha beta) = Actions.add (value alpha) (value beta) :=
  \fun (alpha, beta: Cochain.CycleCarrier) => ActionMaps.ext _ _
    (Source.classInduction (\fun (x: Source.Homology) => (value ((Cochain.cycleSpace).add alpha beta)).apply x = (Actions.add (value alpha) (value beta)).apply x)
      (\fun (x: Source.Cycle) => eq_reason_in!{Target.Homology _
        "=" _ "by" { \parent.On[alpha := (Cochain.cycleSpace).add alpha beta].onClass x }
        "=" _ "by" { congr!{{Chains.Carrier N.Nat^::zero} Target.Homology} Target.classOf _ _ (congr!{CapMaps.Map {Chains.Carrier N.Nat^::zero}} (\fun (f: CapMaps.Map) => (f).apply x) _ _ (Bilinear.addition alpha beta)) }
        "=" _ "by" { (Target.classLinear).addition ((Cap.map alpha).apply x) ((Cap.map beta).apply x) }
        "=" _ "by" { congr!{Target.Homology Target.Homology Target.Homology} ((Target.homologySpace).add) _ _ _ _
          (sym!{Target.Homology} _ _ (\parent.On[alpha := alpha].onClass x)) (sym!{Target.Homology} _ _ (\parent.On[alpha := beta].onClass x)) }
      }));
\definition scalar: \forall (a: I.Int^)(alpha: Cochain.CycleCarrier) -> value ((Cochain.cycleSpace).smul a alpha) = Actions.scale a (value alpha) :=
  \fun (a: I.Int^)(alpha: Cochain.CycleCarrier) => ActionMaps.ext _ _
    (Source.classInduction (\fun (x: Source.Homology) => (value ((Cochain.cycleSpace).smul a alpha)).apply x = (Actions.scale a (value alpha)).apply x)
      (\fun (x: Source.Cycle) => eq_reason_in!{Target.Homology _
        "=" _ "by" { \parent.On[alpha := (Cochain.cycleSpace).smul a alpha].onClass x }
        "=" _ "by" { congr!{{Chains.Carrier N.Nat^::zero} Target.Homology} Target.classOf _ _ (Bilinear.scalarValue a alpha x) }
        "=" _ "by" { (Target.classLinear).scalar a ((Cap.map alpha).apply x) }
        "=" _ "by" { congr!{Target.Homology Target.Homology} ((Target.homologySpace).smul a) _ _ (sym!{Target.Homology} _ _ (\parent.On[alpha := alpha].onClass x)) }
      }));
