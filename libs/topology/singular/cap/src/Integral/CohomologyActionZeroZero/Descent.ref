\import \parent.Linearity[] \as Linearity;
\import Modules.Hom[V := Cochain.CycleCarrier, W := Actions.Carrier, source := Cochain.cycleSpace, target := Actions.space] \as Linear;
\definition raw: Linear.Map := Linear.Map { apply := value, addition := Linearity.addition, scalar := Linearity.scalar };
\import Modules.Of[V := Cochain.CycleCarrier, space := Cochain.cycleSpace].Submodule[].Quotient[S := Cochain.boundariesInside].To[W := Actions.Carrier, target := Actions.space] \as Quotient;
\import Cap.Zero[] \as Zero;
\import Modules.Hom[V := Chains.Carrier N.Nat^::zero, W := Target.Homology, source := Chains.space N.Nat^::zero, target := Target.homologySpace] \as Classes;
\definition zeroValue: value (Cochain.cycleSpace).zero = Actions.zero := ActionMaps.ext _ _
  (Source.classInduction (\fun (x: Source.Homology) => (value (Cochain.cycleSpace).zero).apply x = (Target.homologySpace).zero)
    (\fun (x: Chains.Carrier N.Nat^::zero) => eq_reason_in!{Target.Homology _
      "=" _ "by" { \parent.On[alpha := (Cochain.cycleSpace).zero].onClass x }
      "=" _ "by" { congr!{{Chains.Carrier N.Nat^::zero} Target.Homology} Target.classOf _ _ (congr!{CapMaps.Map {Chains.Carrier N.Nat^::zero}} (\fun (f: CapMaps.Map) => (f).apply x) _ _ Zero.equation) }
      "=" _ "by" { Classes.zeroPreserved Target.classLinear }
    }));
\definition vanishes: Quotient.Vanishes raw :=
  \fun (alpha: Cochain.CycleCarrier)(member: \In[Cochain.CycleCarrier] (Cochain.boundariesInside).carrier alpha) => \block {
    \let equal: alpha = (Cochain.cycleSpace).zero := member \then
    \return trans!{Actions.Carrier} _ _ _ (congr!{Cochain.CycleCarrier Actions.Carrier} value _ _ equal) zeroValue
  };
\definition map: Modules.Hom[V := Cochain.Cohomology, W := Actions.Carrier, source := Cochain.cohomologySpace, target := Actions.space].Map := Quotient.descend raw vanishes;
\definition onClass: \forall (alpha: Cochain.CycleCarrier) -> (map).apply (Cochain.classOf alpha) = value alpha := Quotient.onClass raw vanishes;
