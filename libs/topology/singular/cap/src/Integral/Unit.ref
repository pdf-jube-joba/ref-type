\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import \parent.At[p := p, q := N.Nat^::zero] \as Cap;
\import Cochains.Unit[] \as Unit;
\import Simplices.Cut[p := p, q := N.Nat^::zero] \as Cut;
\import Simplices.CutRightUnit[p := p] \as Restriction;
\import Modules.End[V := Chains.Carrier p, space := Chains.space p] \as End;
\import Modules.Hom[V := Chains.Carrier p, W := Chains.Carrier p, source := Chains.space p, target := Chains.space p] \as Maps;
\import Modules.Free[Generators := Simplices.Carrier p].To[W := Chains.Carrier p, target := Chains.space p] \as Free;
\definition equation: Cap.map Unit.cochain = End.identity := Free.ext _ _ (\fun (sigma: Simplices.Carrier p) => eq_reason_in!{{Chains.Carrier p} _
  "=" _ "by" { Cap.onGenerator Unit.cochain sigma }
  "=" _ "by" { congr!{I.Int^ {Chains.Carrier p}} (\fun (a: I.Int^) => (Chains.space p).smul a (Chains.generator p (Cut.front sigma))) _ _ (Unit.onSimplex (Cut.back sigma)) }
  "=" _ "by" { (Chains.space p).scalarOne (Chains.generator p (Cut.front sigma)) }
  "=" _ "by" { congr!{{Simplices.Carrier p} {Chains.Carrier p}} (Chains.generator p) _ _ (Restriction.law sigma) }
});
\definition law: \forall (x: Chains.Carrier p) -> (Cap.map Unit.cochain).apply x = x :=
  \fun (x: Chains.Carrier p) => congr!{Maps.Map {Chains.Carrier p}} (\fun (f: Maps.Map) => (f).apply x) _ _ equation;
