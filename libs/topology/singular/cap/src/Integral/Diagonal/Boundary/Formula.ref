\import Simplices.CutFaces[p := p, q := q] \as Geometry;
\import \parent.\parent.At[p := p, q := q] \as Factor;
\import \parent.\parent.\parent.At[p := p, q := q] \as Cap;
\import \parent.\parent.\parent.At[p := N.Nat^::succ p, q := q] \as LeftCap;
\import \parent.\parent.\parent.At[p := p, q := N.Nat^::succ q] \as RightCap;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients] \as Ordinary;
\import Chains.DegreeTransport[] \as Degrees;
\import \parent.LeftComparison[] \as LeftComparison;
\import \parent.RightComparison[] \as RightComparison;
\import Modules.Hom[V := Chains.Carrier Alexander.total, W := Chains.Carrier p, source := Chains.space Alexander.total, target := Chains.space p].Composition[U := Chains.Carrier Alexander.higher, domain := Chains.space Alexander.higher] \as LowerComposition;
\import Modules.Hom[V := Chains.Carrier Geometry.leftDegree, W := Chains.Carrier (N.Nat^::succ p), source := Chains.space Geometry.leftDegree, target := Chains.space (N.Nat^::succ p)].Composition[U := Chains.Carrier Alexander.higher, domain := Chains.space Alexander.higher] \as DegreeComposition;
\import Modules.Hom[V := Chains.Carrier (N.Nat^::succ p), W := Chains.Carrier p, source := Chains.space (N.Nat^::succ p), target := Chains.space p].Composition[U := Chains.Carrier Alexander.higher, domain := Chains.space Alexander.higher] \as BoundaryComposition;
\import Modules.Hom[V := Chains.Carrier Alexander.higher, W := Chains.Carrier p, source := Chains.space Alexander.higher, target := Chains.space p] \as Result;
\import Modules.Free[Generators := Simplices.Carrier Alexander.higher].To[W := Chains.Carrier p, target := Chains.space p] \as Free;
\definition lhs[beta: Cochains.Carrier q]: Result.Map := LowerComposition.compose (Cap.map beta) (Chains.boundary Alexander.total);
\definition left[beta: Cochains.Carrier q]: Result.Map := BoundaryComposition.compose (Chains.boundary p)
  (DegreeComposition.compose (LeftCap.map beta) (Degrees.linear Alexander.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same)));
\definition right[beta: Cochains.Carrier q]: Result.Map := RightCap.map (Ordinary.coboundary q beta);
\definition signedRight[beta: Cochains.Carrier q]: Result.Map := Result.Map {
  apply := \fun (x: Chains.Carrier Alexander.higher) => Signs.twist p ((right beta).apply x),
  addition := \fun (x, y: Chains.Carrier Alexander.higher) => trans!{{Chains.Carrier p}} _ _ _
    (congr!{{Chains.Carrier p} {Chains.Carrier p}} (Signs.twist p) _ _ ((right beta).addition x y))
    (Signs.twistAdd p ((right beta).apply x) ((right beta).apply y)),
  scalar := \fun (a: I.Int^)(x: Chains.Carrier Alexander.higher) => trans!{{Chains.Carrier p}} _ _ _
    (congr!{{Chains.Carrier p} {Chains.Carrier p}} (Signs.twist p) _ _ ((right beta).scalar a x))
    (Signs.twistScalar p a ((right beta).apply x)),
};
\definition rhs[beta: Cochains.Carrier q]: Result.Map := Result.plus (left beta) (signedRight beta);
\definition onGenerator: \forall (beta: Cochains.Carrier q)(sigma: Simplices.Carrier Alexander.higher) ->
  (lhs beta).apply (Chains.generator Alexander.higher sigma) = (rhs beta).apply (Chains.generator Alexander.higher sigma) :=
  \fun (beta: Cochains.Carrier q)(sigma: Simplices.Carrier Alexander.higher) => eq_reason_in!{{Chains.Carrier p} _
    "=" _ "by" { congr!{{Modules.Hom[V := Chains.Carrier Alexander.total, W := Chains.Carrier p, source := Chains.space Alexander.total, target := Chains.space p].Map} {Chains.Carrier p}}
      (\fun (f: Modules.Hom[V := Chains.Carrier Alexander.total, W := Chains.Carrier p, source := Chains.space Alexander.total, target := Chains.space p].Map) => (f).apply ((Chains.boundary Alexander.total).apply (Chains.generator Alexander.higher sigma))) _ _ (sym!{_} _ _ (Factor.equation beta)) }
    "=" _ "by" { congr!{{ProductChains.Carrier Alexander.total} {Chains.Carrier p}} (\fun (x: ProductChains.Carrier Alexander.total) => (Contract.map beta).apply ((Component.map).apply x)) _ _
      (sym!{{ProductChains.Carrier Alexander.total}} _ _ (Maps.Differential[n := Alexander.total].commutes function continuous (Chains.generator Alexander.higher sigma))) }
    "=" _ "by" { contracted beta ((Maps.At[n := Alexander.higher].push function continuous).apply (Chains.generator Alexander.higher sigma)) }
    "=" _ "by" { congr!{{Chains.Carrier p} {Chains.Carrier p} {Chains.Carrier p}} ((Chains.space p).add) _ _ _ _
      (LeftComparison.law beta sigma) (congr!{{Chains.Carrier p} {Chains.Carrier p}} (Signs.twist p) _ _ (RightComparison.law beta sigma)) }
  };
\definition equation: \forall (beta: Cochains.Carrier q) -> lhs beta = rhs beta :=
  \fun (beta: Cochains.Carrier q) => Free.ext (lhs beta) (rhs beta) (onGenerator beta);
\definition law: \forall (beta: Cochains.Carrier q)(x: Chains.Carrier Alexander.higher) ->
  (lhs beta).apply x = (rhs beta).apply x :=
  \fun (beta: Cochains.Carrier q)(x: Chains.Carrier Alexander.higher) =>
    congr!{Result.Map {Chains.Carrier p}} (\fun (f: Result.Map) => (f).apply x) _ _ (equation beta);
