\import Simplices.CutFaces[p := p, q := q] \as Geometry;
\import \parent.\parent.\parent.At[p := N.Nat^::succ p, q := q] \as HighCap;
\import Chains.DegreeTransport[] \as Degrees;
\definition law: \forall (beta: Cochains.Carrier q)(sigma: Simplices.Carrier Alexander.higher) ->
  (Contract.map beta).apply ((Left.map).apply ((Maps.At[n := Alexander.higher].push function continuous).apply (Chains.generator Alexander.higher sigma))) =
  (Chains.boundary p).apply ((HighCap.map beta).apply (Degrees.apply Alexander.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) (Chains.generator Alexander.higher sigma))) :=
  \fun (beta: Cochains.Carrier q)(sigma: Simplices.Carrier Alexander.higher) => eq_reason_in!{{Chains.Carrier p} _
    "=" _ "by" { congr!{{ProductChains.Carrier Alexander.higher} {Chains.Carrier p}} (\fun (x: ProductChains.Carrier Alexander.higher) => (Contract.map beta).apply ((Left.map).apply x)) _ _ (Maps.At[n := Alexander.higher].onGenerator function continuous sigma) }
    "=" _ "by" { congr!{Component.Carrier {Chains.Carrier p}} ((Contract.map beta).apply) _ _ (Left.onGenerator (Maps.postcompose Alexander.higher function continuous sigma)) }
    "=" _ "by" { Contract.onTensor beta ((Chains.boundary p).apply (Chains.generator (N.Nat^::succ p) (Left.front (Maps.postcompose Alexander.higher function continuous sigma)))) (Chains.generator q (Left.back (Maps.postcompose Alexander.higher function continuous sigma))) }
    "=" _ "by" { sym!{{Chains.Carrier p}} _ _ ((Chains.boundary p).scalar ((beta).apply (Chains.generator q (Left.back (Maps.postcompose Alexander.higher function continuous sigma)))) (Chains.generator (N.Nat^::succ p) (Left.front (Maps.postcompose Alexander.higher function continuous sigma)))) }
    "=" _ "by" { congr!{{Chains.Carrier (N.Nat^::succ p)} {Chains.Carrier p}} ((Chains.boundary p).apply) _ _ (sym!{{Chains.Carrier (N.Nat^::succ p)}} _ _ (HighCap.onGenerator beta (Geometry.leftSimplex sigma))) }
    "=" _ "by" { congr!{{Chains.Carrier (N.Nat^::succ p)} {Chains.Carrier p}} ((Chains.boundary p).apply) _ _ (congr!{{Chains.Carrier Geometry.leftDegree} {Chains.Carrier (N.Nat^::succ p)}} ((HighCap.map beta).apply) _ _
      (trans!{{Chains.Carrier Geometry.leftDegree}} _ _ _
        (congr!{{Simplices.Carrier Geometry.leftDegree} {Chains.Carrier Geometry.leftDegree}} (Chains.generator Geometry.leftDegree) _ _ (Geometry.leftSimplexLaw sigma))
        (sym!{{Chains.Carrier Geometry.leftDegree}} _ _ (Degrees.onGenerator Alexander.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) sigma)))) }
  };
