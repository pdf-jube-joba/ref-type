\import \parent.\parent.\parent.At[p := p, q := N.Nat^::succ q] \as HighCap;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients] \as Ordinary;
\definition law: \forall (beta: Cochains.Carrier q)(sigma: Simplices.Carrier Alexander.higher) ->
  (Contract.map beta).apply ((Right.map).apply ((Maps.At[n := Alexander.higher].push function continuous).apply (Chains.generator Alexander.higher sigma))) =
  (HighCap.map (Ordinary.coboundary q beta)).apply (Chains.generator Alexander.higher sigma) :=
  \fun (beta: Cochains.Carrier q)(sigma: Simplices.Carrier Alexander.higher) => eq_reason_in!{{Chains.Carrier p} _
    "=" _ "by" { congr!{{ProductChains.Carrier Alexander.higher} {Chains.Carrier p}} (\fun (x: ProductChains.Carrier Alexander.higher) => (Contract.map beta).apply ((Right.map).apply x)) _ _ (Maps.At[n := Alexander.higher].onGenerator function continuous sigma) }
    "=" _ "by" { congr!{Component.Carrier {Chains.Carrier p}} ((Contract.map beta).apply) _ _ (Right.onGenerator (Maps.postcompose Alexander.higher function continuous sigma)) }
    "=" _ "by" { Contract.onTensor beta (Chains.generator p (Right.front (Maps.postcompose Alexander.higher function continuous sigma))) ((Chains.boundary q).apply (Chains.generator (N.Nat^::succ q) (Right.back (Maps.postcompose Alexander.higher function continuous sigma)))) }
    "=" _ "by" { sym!{{Chains.Carrier p}} _ _ (HighCap.onGenerator (Ordinary.coboundary q beta) sigma) }
  };
