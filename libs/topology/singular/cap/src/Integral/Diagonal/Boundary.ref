\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import AW.Boundary[p := p, q := q] \as Alexander;
\import AW.At[p := p, q := q] \as Component;
\import \parent.\parent.Contraction[p := p, q := q] \as Contract;
\import Alexander.LeftBoundary[] \as Left;
\import Alexander.RightBoundary[] \as Right;
\import singular_cohomology.Chains[A := Product.CarrierSet, source := Product.topology source source] \as ProductChains;
\import Modules.Alternating[V := Component.Carrier, space := Component.space].Concatenation[] \as SourceSigns;
\import SourceSigns.Mapping[W := Chains.Carrier p, target := Chains.space p] \as SignMap;
\import Modules.Alternating[V := Chains.Carrier p, space := Chains.space p].Concatenation[] \as Signs;
\definition contracted: \forall (beta: Cochains.Carrier q)(x: ProductChains.Carrier Alexander.higher) ->
  (Contract.map beta).apply ((Component.map).apply ((ProductChains.boundary Alexander.total).apply x)) =
  (Chains.space p).add ((Contract.map beta).apply ((Left.map).apply x))
    (Signs.twist p ((Contract.map beta).apply ((Right.map).apply x))) :=
  \fun (beta: Cochains.Carrier q)(x: ProductChains.Carrier Alexander.higher) => eq_reason_in!{{Chains.Carrier p} _
    "=" _ "by" { congr!{Component.Carrier {Chains.Carrier p}} ((Contract.map beta).apply) _ _
      (congr!{{ProductChains.Carrier Alexander.higher} Component.Carrier} (\fun (f: ProductChains.Carrier Alexander.higher -> Component.Carrier) => f x) _ _
        (congr!{{Alexander.Maps.Map} {ProductChains.Carrier Alexander.higher -> Component.Carrier}} (\fun (f: Alexander.Maps.Map) => (f).apply) _ _ Alexander.equation)) }
    "=" _ "by" { (Contract.map beta).addition ((Left.map).apply x) (SourceSigns.twist p ((Right.map).apply x)) }
    "=" _ "by" { congr!{{Chains.Carrier p} {Chains.Carrier p}} ((Chains.space p).add ((Contract.map beta).apply ((Left.map).apply x))) _ _ (SignMap.law (Contract.map beta) p ((Right.map).apply x)) }
  };
