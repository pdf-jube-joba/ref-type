\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.DegreeZero[C := Chains.complex] \as H;
\import \parent.At[p := N.Nat^::zero, q := N.Nat^::zero] \as Cap;
\import \parent.Diagonal[].Boundary[p := N.Nat^::zero, q := N.Nat^::zero] \as Boundary;
\import Boundary.Formula[] \as Formula;
\import Boundary.Closed[] \as Closed;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients] \as Ordinary;
\definition ClosedCochain[beta: Cochains.Carrier N.Nat^::zero]: \Prop := Ordinary.coboundary N.Nat^::zero beta = (Cochains.space (N.Nat^::succ N.Nat^::zero)).zero;
\module On(beta: Cochains.Carrier N.Nat^::zero, closed: ClosedCochain beta);
