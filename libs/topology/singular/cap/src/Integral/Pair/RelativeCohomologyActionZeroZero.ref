\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import Relative.With[coefficients := Cochains.integerCoefficients] \as RelativeCochains;
\import Relative.OverRing[R := I.Int^, ring := Integers.commutativeRing].With[coefficients := Cochains.coefficients] \as Theory;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring].At[C := Theory.complex, z := I.Int^::ofNat (N.Nat^::zero)] \as Cochain;
\import \parent.RelativeCochainZeroHomology[q := N.Nat^::zero] \as H;
\import \parent.RelativeCochainBoundary[p := N.Nat^::zero, q := N.Nat^::zero] \as Boundary;
\import \parent.Degree[] \as Degree;
\import \root.Integral[A := A, source := source].At[p := N.Nat^::zero, q := N.Nat^::zero] \as WholeCap;
\import \parent.At[p := N.Nat^::zero, q := N.Nat^::zero].RelativeCochain[] \as Cap;
\import Cap.Bilinear[] \as Bilinear;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring].At[C := Relative.complex, z := I.Int^::ofNat WholeCap.total] \as Source;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].DegreeZero[C := Chains.complex] \as Target;
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing].HomSpace[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as Actions;
\import Modules.Hom[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as ActionMaps;
\import Modules.Hom[V := Degree.Carrier WholeCap.total, W := Chains.Carrier N.Nat^::zero, source := Degree.space WholeCap.total, target := Chains.space N.Nat^::zero] \as CapMaps;
\definition closed[alpha: Cochain.Closed]: Boundary.Closed alpha := \bysub(RelativeCochains.Carrier (I.Int^::ofNat (N.Nat^::zero)), (Cochain.cycles).carrier, alpha);
\module On(alpha: Cochain.Closed) {
  \import H.On[beta := alpha, closed := closed alpha] \as Native;
  \definition map: Actions.Carrier := Native.map;
  \definition onClass: \forall (x: Source.Cycle) -> (map).apply (Source.classOf x) = Target.classOf ((Cap.map alpha).apply x) := Native.onClass;
}
\definition value[alpha: Cochain.Closed]: Actions.Carrier := On[alpha := alpha].map;
\module Linearity;
\module Descent;
