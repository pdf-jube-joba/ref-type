\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.sym;
\import \parent.\parent.At[p := p, q := q] \as Whole;
\import SubCap.At[p := p, q := q] \as Sub;
\import singular_products.Cochains[A := Relative.SubspaceCarrier, source := Subspace.topology source, R := I.Int^, ring := Integers.commutativeRing] \as SubCochains;
\import SubCochains.Pullback[B := A, target := source] \as Pull;
\import SubCap.Natural[B := A, target := source].At[p := p, q := q] \as Naturality;
\import singular_cohomology.Maps[A := Relative.SubspaceCarrier, B := A, source := Subspace.topology source, target := source] \as Inclusion;
\import singular_cohomology.Chains[A := Relative.SubspaceCarrier, source := Subspace.topology source] \as SubChains;
\import Modules.Hom[V := SubChains.Carrier Whole.total, W := Chains.Carrier p, source := SubChains.space Whole.total, target := Chains.space p] \as Maps;
\definition law: \forall (beta: Cochains.Carrier q)(x: SubChains.Carrier Whole.total) ->
  (Whole.map beta).apply ((Inclusion.At[n := Whole.total].push Relative.inclusion Relative.inclusionContinuous).apply x) =
  (Inclusion.At[n := p].push Relative.inclusion Relative.inclusionContinuous).apply ((Sub.map (Pull.apply q Relative.inclusion Relative.inclusionContinuous beta)).apply x) :=
  \fun (beta: Cochains.Carrier q)(x: SubChains.Carrier Whole.total) =>
    congr!{Maps.Map {Chains.Carrier p}} (\fun (f: Maps.Map) => (f).apply x) _ _
      (sym!{Maps.Map} _ _ (Naturality.equation Relative.inclusion Relative.inclusionContinuous beta));
\module Quotient;
