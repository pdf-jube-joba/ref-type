\import \parent.\parent.At[p := p, q := N.Nat^::succ q].Quotient[] \as Right;
\import \root.Integral[A := A, source := source].Diagonal[].Boundary[p := p, q := q].Formula[] \as WholeFormula;
\import Modules.Alternating[V := Chains.Carrier p, space := Chains.space p].Concatenation[] \as WholeSigns;
\import WholeSigns.Mapping[W := Degree.Carrier p, target := Degree.space p] \as SignMapping;
\import Modules.Alternating[V := Degree.Carrier p, space := Degree.space p].Concatenation[] \as Signs;
\definition law: \forall (beta: Cochains.Carrier q)(x: Degree.Carrier Geometry.higher) ->
  (Lower.map beta).apply ((Degree.boundary Geometry.total).apply x) =
  (Degree.space p).add ((Degree.boundary p).apply ((Upper.map beta).apply (Degree.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)))
    (Signs.twist p ((Right.map (Ordinary.coboundary q beta)).apply x)) :=
  \fun (beta: Cochains.Carrier q) => SourceQ.induction (\fun (x: Degree.Carrier Geometry.higher) =>
    (Lower.map beta).apply ((Degree.boundary Geometry.total).apply x) =
    (Degree.space p).add ((Degree.boundary p).apply ((Upper.map beta).apply (Degree.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)))
      (Signs.twist p ((Right.map (Ordinary.coboundary q beta)).apply x)))
    (\fun (x: Extension.Carrier (I.Int^::ofNat Geometry.higher)) => eq_reason_in!{{Degree.Carrier p} _
      "=" _ "by" { congr!{{Degree.Carrier Geometry.total} {Degree.Carrier p}} ((Lower.map beta).apply) _ _ (Degree.boundaryOnClass Geometry.total x) }
      "=" _ "by" { Lower.onClass beta (Extension.Positive[n := Geometry.total].intro ((Chains.boundary Geometry.total).apply x)) }
      "=" _ "by" { congr!{{Chains.Carrier p} {Degree.Carrier p}} (Degree.class p) _ _ (WholeFormula.law beta x) }
      "=" _ "by" { (Degree.projection p).addition ((WholeFormula.left beta).apply x) ((WholeFormula.signedRight beta).apply x) }
      "=" _ "by" { congr!{{Degree.Carrier p} {Degree.Carrier p} {Degree.Carrier p}} ((Degree.space p).add) _ _ _ _
        (trans!{{Degree.Carrier p}} _ _ _
          (sym!{{Degree.Carrier p}} _ _ (Degree.boundaryOnClass p ((WholeUpper.map beta).apply (ChainDegrees.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x))))
          (congr!{{Degree.Carrier Geometry.leftDegree} {Degree.Carrier p}} (\fun (z: Degree.Carrier Geometry.leftDegree) => (Degree.boundary p).apply ((Upper.map beta).apply z)) _ _
            (sym!{{Degree.Carrier Geometry.leftDegree}} _ _ (trans!{{Degree.Carrier Geometry.leftDegree}} _ _ _
              (Degree.onClass Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)
              (\refl(Degree.class Geometry.leftDegree (ChainDegrees.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)))))))
        (trans!{{Degree.Carrier p}} _ _ _ (SignMapping.law (Degree.projection p) p ((WholeFormula.right beta).apply x))
          (congr!{{Degree.Carrier p} {Degree.Carrier p}} (Signs.twist p) _ _
            (sym!{{Degree.Carrier p}} _ _ (Right.onClass (Ordinary.coboundary q beta) (Extension.Positive[n := Geometry.higher].intro x))))) }
    });
