\import \parent.\parent.Connecting[p := N.Nat^::succ t, q := N.Nat^::zero] \as Base;
\import Base.On[beta := beta, closed := closed] \as Known;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import singular_cohomology.Simplices[A := A, source := source].CutFaces[p := N.Nat^::succ t, q := N.Nat^::zero] \as Geometry;
\import singular_cohomology.Chains[A := Relative.SubspaceCarrier, source := Subspace.topology source] \as SubChains;
\import singular_products.Cochains[A := Relative.SubspaceCarrier, source := Subspace.topology source, R := I.Int^, ring := Integers.commutativeRing].Pullback[B := A, target := source] \as Pull;
\import singular_cohomology.Maps[A := Relative.SubspaceCarrier, B := A, source := Subspace.topology source, target := source] \as Inclusion;
\import \parent.\parent.Degree[] \as RelativeDegree;
\import \parent.\parent.Homology[p := N.Nat^::succ t, q := N.Nat^::zero].On[beta := beta, closed := closed].Induced[] \as Induced;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import Nonnegative.ZeroExtension[C := SubChains.complex] \as SubExtension;
\import Nonnegative.ZeroExtension[C := Chains.complex] \as WholeExtension;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.At[C := Relative.complex, z := I.Int^::ofNat Geometry.higher] \as Input;
\import Complexes.ShortExact[A := SubExtension.complex, B := WholeExtension.complex, C := Relative.complex].At[s := Relative.sequence, k := I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ t))] \as Exact;
\import Complexes.At[C := SubExtension.complex, z := I.Int^::ofNat (N.Nat^::succ t)] \as LowerSub;

\import \root.Integral[A := Relative.SubspaceCarrier, source := Subspace.topology source].At[p := N.Nat^::succ t, q := N.Nat^::zero] \as SubCapAt;
\import std.Logic[].Proposition[] \as Logic;
\import \root.Integral[A := Relative.SubspaceCarrier, source := Subspace.topology source] \as SubCap;
\import singular_cohomology.Cochains[A := Relative.SubspaceCarrier, source := Subspace.topology source].With[coefficients := Cochains.integerCoefficients] \as SubTheory;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as CochainsComplex;
\import CochainsComplex.At[C := Theory.complex, k := N.Nat^::zero] \as WholeCochain;
\import CochainsComplex.Map[C := Theory.complex, D := SubTheory.complex].At[k := N.Nat^::zero] \as PullAt;
\import Inclusion.Coefficients[M := Cochains.integerCoefficients, L := Cochains.integerCoefficients] \as PullMap;
\import Modules.End[V := I.Int^, space := Cochains.integerCoefficients.space] \as Scalars;
\definition closedCocycle: WholeCochain.CycleCarrier := WholeCochain.cycle beta closed;
\definition pulledClosed: SubCap.Homology[p := t, q := N.Nat^::zero].Closed (Pull.apply N.Nat^::zero Relative.inclusion Relative.inclusionContinuous beta) :=
  PullAt.preservesClosed (PullMap.map Relative.inclusion Relative.inclusionContinuous Scalars.identity) closedCocycle;
\import SubCap.Homology[p := t, q := N.Nat^::zero].On[beta := Pull.apply N.Nat^::zero Relative.inclusion Relative.inclusionContinuous beta, closed := pulledClosed] \as NativeAction;
\import NativeAction.Induced[] \as SubAction;
\import Nonnegative.Positive[C := SubChains.complex, n := t] \as NativeSub;
\import SubExtension.PositiveHomology[n := t] \as Compare;
\import Modules.Hom[V := NativeSub.Homology, W := NativeSub.Homology, source := NativeSub.homologySpace, target := NativeSub.homologySpace].Composition[U := LowerSub.Homology, domain := LowerSub.homologySpace] \as FirstComposition;
\import Modules.Hom[V := NativeSub.Homology, W := LowerSub.Homology, source := NativeSub.homologySpace, target := LowerSub.homologySpace].Composition[U := LowerSub.Homology, domain := LowerSub.homologySpace] \as SecondComposition;
\definition subMap: Modules.Hom[V := LowerSub.Homology, W := LowerSub.Homology, source := LowerSub.homologySpace, target := LowerSub.homologySpace].Map :=
  SecondComposition.compose Compare.homologyIsomorphism.forward (FirstComposition.compose SubAction.map Compare.homologyIsomorphism.backward);
\import Complexes.ShortExact[A := SubExtension.complex, B := WholeExtension.complex, C := Relative.complex].At[s := Relative.sequence, k := I.Int^::ofNat Geometry.higher] \as InputExact;
\definition onLift: \forall (x: Input.Cycle)(c: Chains.Carrier Geometry.higher)(a: SubChains.Carrier Geometry.total) ->
  RelativeDegree.class Geometry.higher c = x ->
  \forall (boundary: (Inclusion.At[n := Geometry.total].push Relative.inclusion Relative.inclusionContinuous).apply a = (Chains.boundary Geometry.total).apply c) ->
  (Relative.LongExact[z := I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ t))].connecting).apply ((Induced.map).apply (Input.classOf x)) =
  (subMap).apply ((Relative.LongExact[z := I.Int^::ofNat Geometry.higher].connecting).apply (Input.classOf x)) :=
  \fun (x: Input.Cycle)(c: Chains.Carrier Geometry.higher)(a: SubChains.Carrier Geometry.total)(same: _)(boundary: _) => eq_reason_in!{LowerSub.Homology _
    "=" _ "by" { Known.law x c a same boundary }
    "=" _ "by" { LowerSub.cycleClassExt (LowerSub.cycle (Known.lower a) (Exact.lowerClosed (Known.upper c) (Known.lower a) (Base.liftBoundary beta closed c a boundary))) (Compare.cycleIsomorphism.forward.apply (NativeAction.cycle (NativeSub.cycle a (InputExact.lowerClosed (WholeExtension.Positive[n := Geometry.higher].intro c) (SubExtension.Positive[n := Geometry.total].intro a) boundary)))) (\refl(Known.lower a)) }
    "=" _ "by" { sym!{LowerSub.Homology} _ _ (Compare.onClass (NativeAction.cycle (NativeSub.cycle a (InputExact.lowerClosed (WholeExtension.Positive[n := Geometry.higher].intro c) (SubExtension.Positive[n := Geometry.total].intro a) boundary)))) }
    "=" _ "by" { congr!{NativeSub.Homology LowerSub.Homology} ((Compare.homologyIsomorphism.forward).apply) _ _ (sym!{NativeSub.Homology} _ _ (SubAction.onClass (NativeSub.cycle a (InputExact.lowerClosed (WholeExtension.Positive[n := Geometry.higher].intro c) (SubExtension.Positive[n := Geometry.total].intro a) boundary)))) }
    "=" _ "by" { congr!{NativeSub.Homology LowerSub.Homology} (\fun (z: NativeSub.Homology) => (Compare.homologyIsomorphism.forward).apply ((SubAction.map).apply z)) _ _ (sym!{NativeSub.Homology} _ _ (Compare.homologyIsomorphism.leftInverse (NativeSub.classOf (NativeSub.cycle a (InputExact.lowerClosed (WholeExtension.Positive[n := Geometry.higher].intro c) (SubExtension.Positive[n := Geometry.total].intro a) boundary))))) }
    "=" _ "by" { congr!{LowerSub.Homology LowerSub.Homology} (subMap.apply) _ _ (Compare.onClass (NativeSub.cycle a (InputExact.lowerClosed (WholeExtension.Positive[n := Geometry.higher].intro c) (SubExtension.Positive[n := Geometry.total].intro a) boundary))) }
    "=" _ "by" { congr!{LowerSub.Homology LowerSub.Homology} (subMap.apply) _ _ (sym!{LowerSub.Homology} _ _ (Known.sourceLaw x c a same boundary)) }
  };
\definition onCycle: \forall (x: Input.Cycle) ->
  (Relative.LongExact[z := I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ t))].connecting).apply ((Induced.map).apply (Input.classOf x)) =
  (subMap).apply ((Relative.LongExact[z := I.Int^::ofNat Geometry.higher].connecting).apply (Input.classOf x)) := \block {
  \fun (x: Input.Cycle) \then
  \takefrom value: InputExact.Value x \by InputExact.existence x \then
  \takefrom witness: \Cast[InputExact.Witness] ({ w: InputExact.Witness \where InputExact.WitnessLaws[x, value, w] })
    \by \bysub(LowerSub.Homology, InputExact.Values x, value) \then
  \let laws: InputExact.WitnessLaws[x, value, witness] := \bysub(InputExact.Witness, { w: InputExact.Witness \where InputExact.WitnessLaws[x, value, w] }, witness) \then
  \return onLift x witness.lift witness.lower laws.lifted laws.differential
};
\definition compatibility: \forall (x: Input.Homology) ->
  (Relative.LongExact[z := I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ t))].connecting).apply ((Induced.map).apply x) =
  (subMap).apply ((Relative.LongExact[z := I.Int^::ofNat Geometry.higher].connecting).apply x) :=
  Input.classInduction (\fun (x: Input.Homology) =>
    (Relative.LongExact[z := I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ t))].connecting).apply ((Induced.map).apply x) =
    (subMap).apply ((Relative.LongExact[z := I.Int^::ofNat Geometry.higher].connecting).apply x) ) onCycle;
