\definition left[alpha: InputCochain.Closed][z: SubChain.Homology]: WholeH.Homology :=
  (Push.map).apply (((SubDescent.map).apply ((CochainCompare.isomorphism.forward).apply (InputCochain.classOf alpha))).apply ((ChainCompare.isomorphism.backward).apply z));
\definition sourceLaw: \forall (x: InputChain.Cycle)(c: Chains.Carrier (N.Nat^::succ N.Nat^::zero))(a: SubChains.Carrier N.Nat^::zero) ->
  Degree.class (N.Nat^::succ N.Nat^::zero) c = x ->
  \forall (boundary: (Inclusion.At[n := N.Nat^::zero].push Relative.inclusion Relative.inclusionContinuous).apply a = (Chains.boundary N.Nat^::zero).apply c) ->
  (Relative.LongExact[z := I.Int^::ofNat (N.Nat^::succ N.Nat^::zero)].connecting).apply (InputChain.classOf x) = (ChainCompare.isomorphism.forward).apply (SubH.classOf a) :=
  \fun (x: InputChain.Cycle)(c: Chains.Carrier (N.Nat^::succ N.Nat^::zero))(a: SubChains.Carrier N.Nat^::zero)(same: _)(boundary: _) => eq_reason_in!{SubChain.Homology _
    "=" _ "by" { Exact.onClass x }
    "=" _ "by" { Exact.onLift x (Upper.intro c) (Lower.intro a) same boundary (Exact.lowerClosed (Upper.intro c) (Lower.intro a) boundary) }
    "=" _ "by" { SubChain.cycleClassExt (SubChain.cycle (Lower.intro a) (Exact.lowerClosed (Upper.intro c) (Lower.intro a) boundary)) (ChainCompare.into a) (\refl(Lower.intro a)) }
    "=" _ "by" { sym!{SubChain.Homology} _ _ (ChainCompare.onClass a) }
  };
