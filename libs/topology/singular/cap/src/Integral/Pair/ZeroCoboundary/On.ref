\import \parent.\parent.ZeroHomology[q := N.Nat^::succ r] \as H;
\import \parent.\parent.Boundary[p := N.Nat^::zero, q := N.Nat^::succ r] \as Closed;
\definition closed: Closed.closed (Ordinary.coboundary r gamma) := (Ordinary.complex.laws).squareZero r gamma;
\import H.On[beta := Ordinary.coboundary r gamma, closed := closed] \as Action;
\import Action.Induced[] \as Induced;
\import Modules.Of[V := Degrees.Carrier N.Nat^::zero, space := Degrees.space N.Nat^::zero].Submodule[] \as Submodules;
\import Submodules.Image[U := Degrees.Carrier (N.Nat^::succ N.Nat^::zero), source := Degrees.space (N.Nat^::succ N.Nat^::zero)] \as Images;
\definition onCycle: \forall (x: Source.Cycle) -> Target.classOf (Action.cycle x) = (Target.homologySpace).zero :=
  \fun (x: Source.Cycle) => Target.boundaryClassZero (Action.cycle x)
    (Images.introduce Target.prior (Action.cycle x) ((Degrees.space (N.Nat^::succ N.Nat^::zero)).neg (witness gamma x))
      (trans!{{Degrees.Carrier N.Nat^::zero}} _ _ _ (H.targetPrior ((Degrees.space (N.Nat^::succ N.Nat^::zero)).neg (witness gamma x))) (boundary gamma x)));
\definition law: \forall (x: Source.Homology) -> (Induced.map).apply x = (Target.homologySpace).zero :=
  Source.classInduction (\fun (x: Source.Homology) => (Induced.map).apply x = (Target.homologySpace).zero)
    (\fun (x: Source.Cycle) => trans!{Target.Homology} _ _ _ (Induced.onClass x) (onCycle x));
