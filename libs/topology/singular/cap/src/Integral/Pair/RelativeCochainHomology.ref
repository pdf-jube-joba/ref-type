\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import \parent.Degree[] \as Degree;
\import Simplices.CutFaces[p := p, q := q] \as Geometry;
\import \parent.RelativeCochainBoundary[p := p, q := q] \as Boundary;
\import \parent.Homology[p := p, q := q] \as RelativeHomology;
\import \parent.At[p := p, q := q].RelativeCochain[] \as Lower;
\import \parent.At[p := N.Nat^::succ p, q := q].RelativeCochain[] \as Upper;
\import Relative.With[coefficients := Cochains.integerCoefficients] \as RelativeCochains;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring].At[C := Relative.complex, z := I.Int^::ofNat Geometry.higher] \as Source;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].Positive[C := Chains.complex, n := p] \as Target;
\import Modules.Hom[V := Degree.Carrier Geometry.leftDegree, W := Chains.Carrier (N.Nat^::succ p), source := Degree.space Geometry.leftDegree, target := Chains.space (N.Nat^::succ p)].Composition[U := Degree.Carrier Geometry.higher, domain := Degree.space Geometry.higher] \as Composition;
\import Modules.Hom[V := Degree.Carrier Geometry.total, W := Chains.Carrier p, source := Degree.space Geometry.total, target := Chains.space p] \as LowerMaps;
\definition cap[beta: RelativeCochains.Carrier (I.Int^::ofNat q)]: Modules.Hom[V := Degree.Carrier Geometry.higher, W := Chains.Carrier (N.Nat^::succ p), source := Degree.space Geometry.higher, target := Chains.space (N.Nat^::succ p)].Map :=
  Composition.compose (Upper.map beta) (Degree.linear Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same));
\module On(beta: RelativeCochains.Carrier (I.Int^::ofNat q), closed: Boundary.Closed beta);
