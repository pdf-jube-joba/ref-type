\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import Relative.With[coefficients := Cochains.integerCoefficients] \as RelativeCochains;
\import Relative.OverRing[R := I.Int^, ring := Integers.commutativeRing].With[coefficients := Cochains.coefficients] \as Theory;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring].At[C := Theory.complex, z := I.Int^::ofNat (N.Nat^::succ r)] \as Cochain;
\import \parent.RelativeCochainHomology[p := p, q := N.Nat^::succ r] \as H;
\import \parent.RelativeCochainBoundary[p := p, q := N.Nat^::succ r] \as Boundary;
\import \parent.Degree[] \as Degree;
\import Simplices.CutFaces[p := p, q := N.Nat^::succ r] \as Geometry;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring].At[C := Relative.complex, z := I.Int^::ofNat Geometry.higher] \as Source;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].Positive[C := Chains.complex, n := p] \as Target;
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing].HomSpace[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as Actions;
\import Modules.Hom[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as ActionMaps;
\import \parent.At[p := N.Nat^::succ p, q := N.Nat^::succ r].RelativeCochain[].Bilinear[] \as Bilinear;
\import \parent.Degree[] \as Degrees;
\definition closed[alpha: Cochain.Closed]: Boundary.Closed alpha := \bysub(RelativeCochains.Carrier (I.Int^::ofNat (N.Nat^::succ r)), (Cochain.cycles).carrier, alpha);
\module On(alpha: Cochain.Closed) {
  \import H.On[beta := alpha, closed := closed alpha] \as Native;
  \import Native.Induced[] \as Induced;
  \definition cycle: Source.Cycle -> Target.Cycle := Native.cycle;
  \definition map: Actions.Carrier := Induced.map;
  \definition onClass: \forall (x: Source.Cycle) -> (map).apply (Source.classOf x) = Target.classOf (cycle x) := Induced.onClass;
}
\definition value[alpha: Cochain.Closed]: Actions.Carrier := On[alpha := alpha].map;
\module Linearity;
\module Descent;
