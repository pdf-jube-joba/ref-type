\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import \parent.Degree[] \as Degree;
\import Simplices.CutFaces[p := p, q := q] \as Geometry;
\import \parent.Boundary[p := p, q := q] \as Boundary;
\import \parent.At[p := p, q := q].Quotient[] \as Lower;
\import \parent.At[p := N.Nat^::succ p, q := q].Quotient[] \as Upper;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.At[C := Relative.complex, z := I.Int^::ofNat Geometry.higher] \as Source;
\import Complexes.At[C := Relative.complex, z := I.Int^::ofNat (N.Nat^::succ p)] \as Target;
\import Modules.Hom[V := Degree.Carrier Geometry.leftDegree, W := Degree.Carrier (N.Nat^::succ p), source := Degree.space Geometry.leftDegree, target := Degree.space (N.Nat^::succ p)].Composition[U := Degree.Carrier Geometry.higher, domain := Degree.space Geometry.higher] \as Composition;
\import Modules.Hom[V := Degree.Carrier Geometry.total, W := Degree.Carrier p, source := Degree.space Geometry.total, target := Degree.space p] \as LowerMaps;
\import std.Logic[].Equality[].Transport[A := I.Int^] \as IntegerTransport;
\definition sourcePrior: \forall (y: Degree.Carrier (N.Nat^::succ Geometry.higher)) ->
  (Source.prior).apply y = (Degree.boundary Geometry.higher).apply y :=
  \fun (y: Degree.Carrier (N.Nat^::succ Geometry.higher)) => IntegerTransport.castRefl Relative.complex.family.Carrier (I.Int^::ofNat Geometry.higher) ((Degree.boundary Geometry.higher).apply y);
\definition targetPrior: \forall (y: Degree.Carrier (N.Nat^::succ (N.Nat^::succ p))) ->
  (Target.prior).apply y = (Degree.boundary (N.Nat^::succ p)).apply y :=
  \fun (y: Degree.Carrier (N.Nat^::succ (N.Nat^::succ p))) => IntegerTransport.castRefl Relative.complex.family.Carrier (I.Int^::ofNat (N.Nat^::succ p)) ((Degree.boundary (N.Nat^::succ p)).apply y);
\definition cap[beta: Cochains.Carrier q]: Modules.Hom[V := Degree.Carrier Geometry.higher, W := Degree.Carrier (N.Nat^::succ p), source := Degree.space Geometry.higher, target := Degree.space (N.Nat^::succ p)].Map :=
  Composition.compose (Upper.map beta) (Degree.linear Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same));
\module On(beta: Cochains.Carrier q, closed: Boundary.closed beta);
