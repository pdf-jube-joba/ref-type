\import \parent.\parent.RelativeCochainBoundary[p := p, q := N.Nat^::succ r] \as Closed;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].Positive[C := Chains.complex, n := p] \as Target;
\definition closed: Closed.Closed ((RelativeCochains.complex.differential).apply (I.Int^::ofNat r) gamma) := (RelativeCochains.complex.laws).squareZero (I.Int^::ofNat r) gamma;
\import Homology.On[beta := (RelativeCochains.complex.differential).apply (I.Int^::ofNat r) gamma, closed := closed] \as Action;
\import Action.Induced[] \as Induced;
\import Modules.Of[V := Chains.Carrier (N.Nat^::succ p), space := Chains.space (N.Nat^::succ p)].Submodule[] \as TargetSub;
\import TargetSub.Image[U := Chains.Carrier (N.Nat^::succ (N.Nat^::succ p)), source := Chains.space (N.Nat^::succ (N.Nat^::succ p))] \as Images;
\definition onCycle: \forall (x: Source.Cycle) -> Target.classOf (Action.cycle x) = (Target.homologySpace).zero :=
  \fun (x: Source.Cycle) => Target.boundaryClassZero (Action.cycle x)
    (Images.introduce Target.prior (Action.cycle x) (boundaryWitness gamma x)
      (trans!{{Chains.Carrier (N.Nat^::succ p)}} _ _ _ (boundary gamma x) (sym!{{Chains.Carrier (N.Nat^::succ p)}} _ _ (sameValue gamma x))));
\definition law: \forall (x: Source.Homology) -> (Induced.map).apply x = (Target.homologySpace).zero :=
  Source.classInduction (\fun (x: Source.Homology) => (Induced.map).apply x = (Target.homologySpace).zero)
    (\fun (x: Source.Cycle) => trans!{Target.Homology} _ _ _ (Induced.onClass x) (onCycle x));
