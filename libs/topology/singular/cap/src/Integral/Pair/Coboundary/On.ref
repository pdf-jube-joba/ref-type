\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients] \as Theory;
\import Complexes.At[C := Relative.complex, z := I.Int^::ofNat (N.Nat^::succ p)] \as Target;
\definition closed: \root.Integral[A := A, source := source].Pair[subset := subset].Boundary[p := p, q := N.Nat^::succ r].closed (Ordinary.coboundary r gamma) := (Theory.complex.laws).squareZero r gamma;
\import Homology.On[beta := Ordinary.coboundary r gamma, closed := closed] \as Action;
\import Action.Induced[] \as Induced;
\import Modules.Of[V := Degree.Carrier (N.Nat^::succ p), space := Degree.space (N.Nat^::succ p)].Submodule[] \as TargetSub;
\import TargetSub.Image[U := Degree.Carrier (N.Nat^::succ (N.Nat^::succ p)), source := Degree.space (N.Nat^::succ (N.Nat^::succ p))] \as Images;
\definition onCycle: \forall (x: Source.Cycle) -> Target.classOf (Action.cycle x) = (Target.homologySpace).zero :=
  \fun (x: Source.Cycle) => Target.boundaryClassZero (Action.cycle x)
    (Images.introduce Target.prior (Action.cycle x) (boundaryWitness gamma x)
      (trans!{{Degree.Carrier (N.Nat^::succ p)}} _ _ _ (Homology.targetPrior (boundaryWitness gamma x))
        (trans!{{Degree.Carrier (N.Nat^::succ p)}} _ _ _ (boundary gamma x) (sym!{{Degree.Carrier (N.Nat^::succ p)}} _ _ (sameValue gamma x)))));
\definition law: \forall (x: Source.Homology) -> (Induced.map).apply x = (Target.homologySpace).zero :=
  Source.classInduction (\fun (x: Source.Homology) => (Induced.map).apply x = (Target.homologySpace).zero)
    (\fun (x: Source.Cycle) => trans!{Target.Homology} _ _ _ (Induced.onClass x) (onCycle x));
