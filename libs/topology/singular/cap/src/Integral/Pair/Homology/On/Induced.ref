\import \parent.Boundaries[] \as Boundaries;
\import Modules.Hom[V := Target.Cycle, W := Target.Homology, source := Target.cycleSpace, target := Target.homologySpace].Composition[U := Source.Cycle, domain := Source.cycleSpace] \as Composition;
\definition raw: Modules.Hom[V := Source.Cycle, W := Target.Homology, source := Source.cycleSpace, target := Target.homologySpace].Map := Composition.compose Target.classLinear cycles;
\import Modules.Of[V := Source.Cycle, space := Source.cycleSpace].Submodule[].Quotient[S := Source.boundariesInside].To[W := Target.Homology, target := Target.homologySpace] \as Descent;
\definition vanishes: Descent.Vanishes raw :=
  \fun (x: Source.Cycle)(member: \In[Source.Cycle] (Source.boundariesInside).carrier x) => Target.boundaryClassZero (cycle x) (Boundaries.preserves x member);
\definition map: Modules.Hom[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace].Map := Descent.descend raw vanishes;
\definition onClass: \forall (x: Source.Cycle) -> (map).apply (Source.classOf x) = Target.classOf (cycle x) := Descent.onClass raw vanishes;
