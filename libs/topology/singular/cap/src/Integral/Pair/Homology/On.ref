\definition cycle[x: Source.Cycle]: Target.Cycle := Target.cycle ((cap beta).apply x)
  (trans!{{Degree.Carrier p}} _ _ _ (sym!{{Degree.Carrier p}} _ _ (Boundary.law beta closed x))
    (trans!{{Degree.Carrier p}} _ _ _
      (congr!{{Degree.Carrier Geometry.total} {Degree.Carrier p}} ((Lower.map beta).apply) _ _
        (\bysub(Degree.Carrier Geometry.higher, (Source.cycles).carrier, x)))
      (LowerMaps.zeroPreserved (Lower.map beta))));
\import Modules.Hom[V := Source.Cycle, W := Target.Cycle, source := Source.cycleSpace, target := Target.cycleSpace] \as CycleMaps;
\definition cycles: CycleMaps.Map := CycleMaps.Map {
  apply := cycle,
  addition := \fun (x, y: Source.Cycle) => (cap beta).addition x y,
  scalar := \fun (a: I.Int^)(x: Source.Cycle) => (cap beta).scalar a x,
};
\module Boundaries;
\module Induced;
