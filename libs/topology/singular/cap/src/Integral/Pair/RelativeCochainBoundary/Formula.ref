\import \parent.\parent.At[p := p, q := N.Nat^::succ q].RelativeCochain[] \as Right;
\import \root.Integral[A := A, source := source].At[p := p, q := N.Nat^::succ q] \as WholeRight;
\import \root.Integral[A := A, source := source].Diagonal[].Boundary[p := p, q := q].Formula[] \as WholeFormula;
\import Modules.Alternating[V := Chains.Carrier p, space := Chains.space p].Concatenation[] \as Signs;
\import Modules.Hom[V := Chains.Carrier Geometry.higher, W := Chains.Carrier p, source := Chains.space Geometry.higher, target := Chains.space p] \as WholeMaps;
\definition law: \forall (beta: RelativeCochains.Carrier (I.Int^::ofNat q))(x: Degree.Carrier Geometry.higher) ->
  (Lower.map beta).apply ((Degree.boundary Geometry.total).apply x) =
  (Chains.space p).add ((Chains.boundary p).apply ((Upper.map beta).apply (Degree.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)))
    (Signs.twist p ((Right.map ((RelativeCochains.complex.differential).apply (I.Int^::ofNat q) beta)).apply x)) :=
  \fun (beta: RelativeCochains.Carrier (I.Int^::ofNat q)) => SourceQ.induction (\fun (x: Degree.Carrier Geometry.higher) =>
    (Lower.map beta).apply ((Degree.boundary Geometry.total).apply x) =
    (Chains.space p).add ((Chains.boundary p).apply ((Upper.map beta).apply (Degree.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)))
      (Signs.twist p ((Right.map ((RelativeCochains.complex.differential).apply (I.Int^::ofNat q) beta)).apply x)))
    (\fun (x: Extension.Carrier (I.Int^::ofNat Geometry.higher)) => eq_reason_in!{{Chains.Carrier p} _
      "=" _ "by" { congr!{{Degree.Carrier Geometry.total} {Chains.Carrier p}} ((Lower.map beta).apply) _ _ (Degree.boundaryOnClass Geometry.total x) }
      "=" _ "by" { Lower.onClass beta (Extension.Positive[n := Geometry.total].intro ((Chains.boundary Geometry.total).apply x)) }
      "=" _ "by" { WholeFormula.law (Comparison.from beta) x }
      "=" _ "by" { congr!{{Chains.Carrier p} {Chains.Carrier p} {Chains.Carrier p}} ((Chains.space p).add) _ _ _ _
        (trans!{{Chains.Carrier p}} _ _ _
          (congr!{{Chains.Carrier (N.Nat^::succ p)} {Chains.Carrier p}} ((Chains.boundary p).apply) _ _
            (sym!{{Chains.Carrier (N.Nat^::succ p)}} _ _ (Upper.onClass beta (Extension.Positive[n := Geometry.leftDegree].intro (ChainDegrees.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)))))
          (congr!{{Degree.Carrier Geometry.leftDegree} {Chains.Carrier p}} (\fun (z: Degree.Carrier Geometry.leftDegree) => (Chains.boundary p).apply ((Upper.map beta).apply z)) _ _
            (sym!{{Degree.Carrier Geometry.leftDegree}} _ _ (Degree.onClass Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x))))
        (congr!{{Chains.Carrier p} {Chains.Carrier p}} (Signs.twist p) _ _
          (trans!{{Chains.Carrier p}} _ _ _
            (congr!{WholeMaps.Map {Chains.Carrier p}} (\fun (f: WholeMaps.Map) => (f).apply x) _ _
              (congr!{{Cochains.Carrier (N.Nat^::succ q)} WholeMaps.Map} WholeRight.map _ _ (sym!{{Cochains.Carrier (N.Nat^::succ q)}} _ _ (Commutes.law beta))))
            (sym!{{Chains.Carrier p}} _ _ (Right.onClass ((RelativeCochains.complex.differential).apply (I.Int^::ofNat q) beta) (Extension.Positive[n := Geometry.higher].intro x))))) }
    });
