\import \parent.\parent.RelativeCochainZeroHomology[q := N.Nat^::succ r] \as H;
\import \parent.\parent.RelativeCochainBoundary[p := N.Nat^::zero, q := N.Nat^::succ r] \as Closed;
\definition closed: Closed.Closed ((RelativeCochains.complex.differential).apply (I.Int^::ofNat r) gamma) := (RelativeCochains.complex.laws).squareZero (I.Int^::ofNat r) gamma;
\import H.On[beta := (RelativeCochains.complex.differential).apply (I.Int^::ofNat r) gamma, closed := closed] \as Action;
\import Modules.Of[V := Chains.Carrier N.Nat^::zero, space := Chains.space N.Nat^::zero].Submodule[] \as Submodules;
\import Submodules.Quotient[S := Target.boundaries] \as Quotient;
\import Submodules.Image[U := Chains.Carrier (N.Nat^::succ N.Nat^::zero), source := Chains.space (N.Nat^::succ N.Nat^::zero)] \as Images;
\definition onCycle: \forall (x: Source.Cycle) -> Target.classOf ((Right.map ((RelativeCochains.complex.differential).apply (I.Int^::ofNat r) gamma)).apply x) = (Target.homologySpace).zero :=
  \fun (x: Source.Cycle) => Quotient.classZero ((Right.map ((RelativeCochains.complex.differential).apply (I.Int^::ofNat r) gamma)).apply x)
    (Images.introduce Target.prior ((Right.map ((RelativeCochains.complex.differential).apply (I.Int^::ofNat r) gamma)).apply x) ((Chains.space (N.Nat^::succ N.Nat^::zero)).neg (witness gamma x)) (boundary gamma x));
\definition law: \forall (x: Source.Homology) -> (Action.map).apply x = (Target.homologySpace).zero :=
  Source.classInduction (\fun (x: Source.Homology) => (Action.map).apply x = (Target.homologySpace).zero)
    (\fun (x: Source.Cycle) => trans!{Target.Homology} _ _ _ (Action.onClass x) (onCycle x));
