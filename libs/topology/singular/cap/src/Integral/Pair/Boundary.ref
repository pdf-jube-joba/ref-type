\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import \parent.Degree[] \as Degree;
\import Simplices.CutFaces[p := p, q := q] \as Geometry;
\import \parent.At[p := p, q := q].Quotient[] \as Lower;
\import \parent.At[p := N.Nat^::succ p, q := q].Quotient[] \as Upper;
\import \root.Integral[A := A, source := source].At[p := p, q := q] \as WholeLower;
\import \root.Integral[A := A, source := source].At[p := N.Nat^::succ p, q := q] \as WholeUpper;
\import \root.Integral[A := A, source := source].Diagonal[].Boundary[p := p, q := q].Closed[] \as WholeClosed;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients] \as Ordinary;
\import Chains.DegreeTransport[] \as ChainDegrees;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import Nonnegative.ZeroExtension[C := Chains.complex] \as Extension;
\import singular_cohomology.Chains[A := Relative.SubspaceCarrier, source := Subspace.topology source] \as SubChains;
\import Nonnegative.ZeroExtension[C := SubChains.complex] \as SubExtension;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.Quotient[C := SubExtension.complex, D := Extension.complex].On[f := Relative.inclusionMap].At[k := I.Int^::ofNat Geometry.higher] \as SourceQ;
\definition closed[beta: Cochains.Carrier q]: \Prop := Ordinary.coboundary q beta = (Cochains.space (N.Nat^::succ q)).zero;
\definition law: \forall (beta: Cochains.Carrier q) -> closed beta -> \forall (x: Degree.Carrier Geometry.higher) ->
  (Lower.map beta).apply ((Degree.boundary Geometry.total).apply x) =
  (Degree.boundary p).apply ((Upper.map beta).apply (Degree.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)) :=
  \fun (beta: Cochains.Carrier q)(cocycle: closed beta) => SourceQ.induction
    (\fun (x: Degree.Carrier Geometry.higher) => (Lower.map beta).apply ((Degree.boundary Geometry.total).apply x) =
      (Degree.boundary p).apply ((Upper.map beta).apply (Degree.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)))
    (\fun (x: Extension.Carrier (I.Int^::ofNat Geometry.higher)) => eq_reason_in!{{Degree.Carrier p} _
      "=" _ "by" { congr!{{Degree.Carrier Geometry.total} {Degree.Carrier p}} ((Lower.map beta).apply) _ _ (Degree.boundaryOnClass Geometry.total x) }
      "=" _ "by" { Lower.onClass beta (Extension.Positive[n := Geometry.total].intro ((Chains.boundary Geometry.total).apply x)) }
      "=" _ "by" { congr!{{Chains.Carrier p} {Degree.Carrier p}} (Degree.class p) _ _ (WholeClosed.law beta cocycle x) }
      "=" _ "by" { sym!{{Degree.Carrier p}} _ _ (Degree.boundaryOnClass p ((WholeUpper.map beta).apply (ChainDegrees.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x))) }
      "=" _ "by" { congr!{{Degree.Carrier (N.Nat^::succ p)} {Degree.Carrier p}} ((Degree.boundary p).apply) _ _
        (sym!{{Degree.Carrier (N.Nat^::succ p)}} _ _ (Upper.onClass beta (Extension.Positive[n := Geometry.leftDegree].intro (ChainDegrees.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)))) }
      "=" _ "by" { congr!{{Degree.Carrier Geometry.leftDegree} {Degree.Carrier p}} (\fun (z: Degree.Carrier Geometry.leftDegree) => (Degree.boundary p).apply ((Upper.map beta).apply z)) _ _
        (sym!{{Degree.Carrier Geometry.leftDegree}} _ _ (Degree.onClass Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)) }
    });
\module Formula;
