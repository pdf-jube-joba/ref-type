\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import singular_cohomology.Cochains[A := A, source := source].OverRing[R := I.Int^, ring := Integers.commutativeRing].With[coefficients := Cochains.coefficients] \as Theory;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring].At[C := Theory.complex, k := N.Nat^::zero] \as Cochain;
\import \parent.Degree[] \as Degree;
\import \parent.ZeroHomology[q := N.Nat^::zero] \as H;
\import \parent.Boundary[p := N.Nat^::zero, q := N.Nat^::zero] \as Boundary;
\import \root.Integral[A := A, source := source].At[p := N.Nat^::zero, q := N.Nat^::zero] \as WholeCap;
\import \parent.At[p := N.Nat^::zero, q := N.Nat^::zero].Quotient[] \as Cap;
\import Cap.Bilinear[] \as Bilinear;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.At[C := Relative.complex, z := I.Int^::ofNat WholeCap.total] \as Source;
\import Complexes.At[C := Relative.complex, z := I.Int^::ofNat N.Nat^::zero] \as Target;
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing].HomSpace[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as Actions;
\import Modules.Hom[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as ActionMaps;
\definition closed[alpha: Cochain.CycleCarrier]: Boundary.closed alpha := \bysub(Cochains.Carrier (N.Nat^::zero), (Cochain.cycles).carrier, alpha);
\module On(alpha: Cochain.CycleCarrier) {
  \import H.On[beta := alpha, closed := closed alpha] \as Native;
  \import Native.Induced[] \as Induced;
  \definition cycle: Source.Cycle -> Target.Cycle := Native.cycle;
  \definition map: Actions.Carrier := Induced.map;
  \definition onClass: \forall (x: Source.Cycle) -> (map).apply (Source.classOf x) = Target.classOf (cycle x) := Induced.onClass;
}
\definition value[alpha: Cochain.CycleCarrier]: Actions.Carrier := On[alpha := alpha].map;
\module Linearity;
\module Descent;
