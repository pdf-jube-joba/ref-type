\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import \parent.\parent.Scalar[] \as Scalar;
\import Cochains.Cup[p := p, q := q] \as Cup;
\definition onSimplex: \forall (alpha: Cochains.Carrier p)(beta: Cochains.Carrier q)(sigma: Simplices.Carrier total) ->
  (alpha).apply ((map beta).apply (Chains.generator total sigma)) = (Cup.apply alpha beta).apply (Chains.generator total sigma) :=
  \fun (alpha: Cochains.Carrier p)(beta: Cochains.Carrier q)(sigma: Simplices.Carrier total) => eq_reason_in!{I.Int^ _
    "=" _ "by" { congr!{{Chains.Carrier p} I.Int^} ((alpha).apply) _ _ (onGenerator beta sigma) }
    "=" _ "by" { (alpha).scalar ((beta).apply (Chains.generator q (Cut.back sigma))) (Chains.generator p (Cut.front sigma)) }
    "=" _ "by" { Scalar.law ((beta).apply (Chains.generator q (Cut.back sigma))) ((alpha).apply (Chains.generator p (Cut.front sigma))) }
    "=" _ "by" { (Integers.commutativeRing).mulCommutative ((beta).apply (Chains.generator q (Cut.back sigma))) ((alpha).apply (Chains.generator p (Cut.front sigma))) }
    "=" _ "by" { sym!{I.Int^} _ _ (Cup.onSimplex alpha beta sigma) }
  };
