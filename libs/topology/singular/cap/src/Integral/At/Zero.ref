\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\import Modules.Laws[V := Chains.Carrier p, space := Chains.space p] \as Laws;
\definition equation: map (Cochains.space q).zero = Maps.zeroMap :=
  Free.ext (map (Cochains.space q).zero) Maps.zeroMap
    (\fun (sigma: Simplices.Carrier total) => trans!{{Chains.Carrier p}} _ _ _
      (onGenerator (Cochains.space q).zero sigma) (Laws.zeroScale (Chains.generator p (Cut.front sigma))));
