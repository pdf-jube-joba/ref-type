\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import N.Basic[].Prop[] \as Bounds;
\import Simplices.CutFaces[p := p, q := N.Nat^::succ r] \as Geometry;
\import Simplices.CutFaces[p := N.Nat^::succ p, q := r] \as UpperGeometry;
\import \parent.Homology[p := p, q := N.Nat^::succ r] \as Homology;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].Positive[C := Chains.complex, n := Geometry.total] \as Source;
\import \parent.Diagonal[].Boundary[p := N.Nat^::succ p, q := r].Formula[] \as Formula;
\import \parent.At[p := N.Nat^::succ p, q := r] \as Lower;
\import \parent.At[p := N.Nat^::succ (N.Nat^::succ p), q := r] \as Higher;
\import Chains.DegreeTransport[] \as Degrees;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients] \as Ordinary;
\import Modules.Hom[V := Chains.Carrier UpperGeometry.total, W := Chains.Carrier (N.Nat^::succ p), source := Chains.space UpperGeometry.total, target := Chains.space (N.Nat^::succ p)] \as LowerMaps;
\import Modules.Laws[V := Chains.Carrier (N.Nat^::succ p), space := Chains.space (N.Nat^::succ p)] \as Values;
\import algebra.Group[].Of[Carrier := Chains.Carrier (N.Nat^::succ p), group := Values.additive] \as Group;
\import Modules.Alternating[V := Chains.Carrier (N.Nat^::succ p), space := Chains.space (N.Nat^::succ p)].Concatenation[] \as Signs;
\import Modules.Alternating[V := Chains.Carrier (N.Nat^::succ (N.Nat^::succ p)), space := Chains.space (N.Nat^::succ (N.Nat^::succ p))].Concatenation[] \as UpperSigns;
\import UpperSigns.Mapping[W := Chains.Carrier (N.Nat^::succ p), target := Chains.space (N.Nat^::succ p)] \as SignMapping;
\import Modules.Hom[V := Chains.Carrier (N.Nat^::succ (N.Nat^::succ p)), W := Chains.Carrier (N.Nat^::succ p), source := Chains.space (N.Nat^::succ (N.Nat^::succ p)), target := Chains.space (N.Nat^::succ p)] \as BoundaryMaps;
\definition same: Geometry.total = UpperGeometry.total := sym!{N.Nat^} _ _ (Bounds.addSuccLeft p r);
\definition input[x: Source.Cycle]: Chains.Carrier UpperGeometry.higher :=
  Degrees.apply Geometry.higher UpperGeometry.higher (congr!{N.Nat^ N.Nat^} N.Nat^::succ _ _ same) x;
\definition boundaryZero: \forall (x: Source.Cycle) -> (Chains.boundary UpperGeometry.total).apply (input x) = (Chains.space UpperGeometry.total).zero :=
  \fun (x: Source.Cycle) => eq_reason_in!{{Chains.Carrier UpperGeometry.total} _
    "=" _ "by" { sym!{{Chains.Carrier UpperGeometry.total}} _ _ (Degrees.boundaryNatural Geometry.total UpperGeometry.total same x) }
    "=" _ "by" { congr!{{Chains.Carrier Geometry.total} {Chains.Carrier UpperGeometry.total}} (Degrees.apply Geometry.total UpperGeometry.total same) _ _
      (\bysub(Chains.Carrier Geometry.higher, (Source.cycles).carrier, x)) }
    "=" _ "by" { Degrees.zero Geometry.total UpperGeometry.total same }
  };
\definition witness[gamma: Cochains.Carrier r][x: Source.Cycle]: Chains.Carrier (N.Nat^::succ (N.Nat^::succ p)) :=
  (Higher.map gamma).apply (Degrees.apply UpperGeometry.higher UpperGeometry.leftDegree (sym!{N.Nat^} _ _ UpperGeometry.same) (input x));
\definition value[gamma: Cochains.Carrier r][x: Source.Cycle]: Chains.Carrier (N.Nat^::succ p) := (Formula.right gamma).apply (input x);
\definition sumZero: \forall (gamma: Cochains.Carrier r)(x: Source.Cycle) ->
  (Chains.space (N.Nat^::succ p)).add ((Chains.boundary (N.Nat^::succ p)).apply (witness gamma x)) (Signs.twist (N.Nat^::succ p) (value gamma x)) = (Chains.space (N.Nat^::succ p)).zero :=
  \fun (gamma: Cochains.Carrier r)(x: Source.Cycle) => trans!{{Chains.Carrier (N.Nat^::succ p)}} _ _ _
    (sym!{{Chains.Carrier (N.Nat^::succ p)}} _ _ (Formula.law gamma (input x)))
    (trans!{{Chains.Carrier (N.Nat^::succ p)}} _ _ _
      (congr!{{Chains.Carrier UpperGeometry.total} {Chains.Carrier (N.Nat^::succ p)}} ((Lower.map gamma).apply) _ _ (boundaryZero x))
      (LowerMaps.zeroPreserved (Lower.map gamma)));
\definition signedValue: \forall (gamma: Cochains.Carrier r)(x: Source.Cycle) ->
  Signs.twist (N.Nat^::succ p) (value gamma x) = (Chains.space (N.Nat^::succ p)).neg ((Chains.boundary (N.Nat^::succ p)).apply (witness gamma x)) :=
  \fun (gamma: Cochains.Carrier r)(x: Source.Cycle) => Group.inverseUnique _ _
    (trans!{{Chains.Carrier (N.Nat^::succ p)}} _ _ _
      (Group.comm (Signs.twist (N.Nat^::succ p) (value gamma x)) ((Chains.boundary (N.Nat^::succ p)).apply (witness gamma x))) (sumZero gamma x));
\definition boundaryWitness[gamma: Cochains.Carrier r][x: Source.Cycle]: Chains.Carrier (N.Nat^::succ (N.Nat^::succ p)) :=
  (Chains.space (N.Nat^::succ (N.Nat^::succ p))).neg (UpperSigns.twist (N.Nat^::succ p) (witness gamma x));
\definition boundary: \forall (gamma: Cochains.Carrier r)(x: Source.Cycle) ->
  (Chains.boundary (N.Nat^::succ p)).apply (boundaryWitness gamma x) = value gamma x :=
  \fun (gamma: Cochains.Carrier r)(x: Source.Cycle) => eq_reason_in!{{Chains.Carrier (N.Nat^::succ p)} _
    "=" _ "by" { BoundaryMaps.negativePreserved (Chains.boundary (N.Nat^::succ p)) (UpperSigns.twist (N.Nat^::succ p) (witness gamma x)) }
    "=" _ "by" { congr!{{Chains.Carrier (N.Nat^::succ p)} {Chains.Carrier (N.Nat^::succ p)}} ((Chains.space (N.Nat^::succ p)).neg) _ _
      (SignMapping.law (Chains.boundary (N.Nat^::succ p)) (N.Nat^::succ p) (witness gamma x)) }
    "=" _ "by" { sym!{{Chains.Carrier (N.Nat^::succ p)}} _ _ (Signs.twistNeg (N.Nat^::succ p) ((Chains.boundary (N.Nat^::succ p)).apply (witness gamma x))) }
    "=" _ "by" { congr!{{Chains.Carrier (N.Nat^::succ p)} {Chains.Carrier (N.Nat^::succ p)}} (Signs.twist (N.Nat^::succ p)) _ _ (sym!{{Chains.Carrier (N.Nat^::succ p)}} _ _ (signedValue gamma x)) }
    "=" _ "by" { Signs.involution (N.Nat^::succ p) (value gamma x) }
  };
