\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients] \as Theory;
\import \root.Integral[A := A, source := source].ZeroPositive[r := r] \as H;
\definition closed: H.ClosedCochain (Theory.coboundary r gamma) := (Theory.complex.laws).squareZero r gamma;
\import H.On[beta := Theory.coboundary r gamma, closed := closed] \as Action;
\import Modules.Of[V := Chains.Carrier N.Nat^::zero, space := Chains.space N.Nat^::zero].Submodule[] \as Submodules;
\import Submodules.Quotient[S := Target.boundaries] \as Quotient;
\import Submodules.Image[U := Chains.Carrier (N.Nat^::succ N.Nat^::zero), source := Chains.space (N.Nat^::succ N.Nat^::zero)] \as Images;
\definition onCycle: \forall (x: Source.Cycle) -> Target.classOf ((Formula.right gamma).apply x) = (Target.homologySpace).zero :=
  \fun (x: Source.Cycle) => Quotient.classZero ((Formula.right gamma).apply x)
    (Images.introduce Target.prior ((Formula.right gamma).apply x) ((Chains.space (N.Nat^::succ N.Nat^::zero)).neg (witness gamma x)) (boundary gamma x));
\definition law: \forall (x: Source.Homology) -> (Action.map).apply x = (Target.homologySpace).zero :=
  Source.classInduction (\fun (x: Source.Homology) => (Action.map).apply x = (Target.homologySpace).zero)
    (\fun (x: Source.Cycle) => trans!{Target.Homology} _ _ _ (Action.onClass x) (onCycle x));
