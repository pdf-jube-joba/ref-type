\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.congr;
\use Equality.eq_reason_in;
\import \parent.\parent.At[p := p, q := q] \as Cap;
\import Other.At[p := p, q := q] \as TargetCap;
\import singular_products.Cochains[A := B, source := target, R := I.Int^, ring := Integers.commutativeRing] \as OtherCochains;
\import Simplices.Cut[p := p, q := q] \as Cut;
\import Modules.Hom[V := Chains.Carrier p, W := OtherChains.Carrier p, source := Chains.space p, target := OtherChains.space p].Composition[U := Chains.Carrier Cap.total, domain := Chains.space Cap.total] \as SourceComposition;
\import Modules.Hom[V := OtherChains.Carrier Cap.total, W := OtherChains.Carrier p, source := OtherChains.space Cap.total, target := OtherChains.space p].Composition[U := Chains.Carrier Cap.total, domain := Chains.space Cap.total] \as TargetComposition;
\import Modules.Free[Generators := Simplices.Carrier Cap.total].To[W := OtherChains.Carrier p, target := OtherChains.space p] \as Free;
\definition equation: \forall (f: A -> B)(continuous: Geometry.Continuous f)(beta: OtherCochains.Carrier q) ->
  SourceComposition.compose (Geometry.At[n := p].push f continuous) (Cap.map (Pull.apply q f continuous beta)) =
  TargetComposition.compose (TargetCap.map beta) (Geometry.At[n := Cap.total].push f continuous) :=
  \fun (f: A -> B)(continuous: Geometry.Continuous f)(beta: OtherCochains.Carrier q) => Free.ext _ _
    (\fun (sigma: Simplices.Carrier Cap.total) => eq_reason_in!{{OtherChains.Carrier p} _
      "=" _ "by" { congr!{{Chains.Carrier p} {OtherChains.Carrier p}} ((Geometry.At[n := p].push f continuous).apply) _ _ (Cap.onGenerator (Pull.apply q f continuous beta) sigma) }
      "=" _ "by" { (Geometry.At[n := p].push f continuous).scalar ((Pull.apply q f continuous beta).apply (Chains.generator q (Cut.back sigma))) (Chains.generator p (Cut.front sigma)) }
      "=" _ "by" { congr!{I.Int^ {OtherChains.Carrier p}} (\fun (a: I.Int^) => (OtherChains.space p).smul a ((Geometry.At[n := p].push f continuous).apply (Chains.generator p (Cut.front sigma)))) _ _ (Pull.onSimplex q f continuous beta (Cut.back sigma)) }
      "=" _ "by" { congr!{{OtherChains.Carrier p} {OtherChains.Carrier p}} ((OtherChains.space p).smul ((beta).apply (OtherChains.generator q (Geometry.postcompose q f continuous (Cut.back sigma))))) _ _ (Geometry.At[n := p].onGenerator f continuous (Cut.front sigma)) }
      "=" _ "by" { sym!{{OtherChains.Carrier p}} _ _ (TargetCap.onGenerator beta (Geometry.postcompose Cap.total f continuous sigma)) }
      "=" _ "by" { sym!{{OtherChains.Carrier p}} _ _ (congr!{{OtherChains.Carrier Cap.total} {OtherChains.Carrier p}} ((TargetCap.map beta).apply) _ _ (Geometry.At[n := Cap.total].onGenerator f continuous sigma)) }
    });
