\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import N.Basic[].Def[] \as Nat;
\import singular_cohomology.Cochains[A := A, source := source].OverRing[R := I.Int^, ring := Integers.commutativeRing].With[coefficients := Cochains.coefficients] \as Theory;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring].At[C := Theory.complex, k := N.Nat^::zero] \as Cochain;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.DegreeZero[C := Chains.complex] \as Source;
\import Complexes.DegreeZero[C := Chains.complex] \as Target;
\import \parent.ZeroHomology[] \as H;
\import \parent.At[p := N.Nat^::zero, q := N.Nat^::zero] \as Cap;
\import Cap.Bilinear[] \as Bilinear;
\import Modules.Hom[V := Chains.Carrier Cap.total, W := Chains.Carrier N.Nat^::zero, source := Chains.space Cap.total, target := Chains.space N.Nat^::zero] \as CapMaps;
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing].HomSpace[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as Actions;
\import Modules.Hom[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as ActionMaps;
\definition closed[alpha: Cochain.CycleCarrier]: H.ClosedCochain alpha := \bysub(Cochains.Carrier (N.Nat^::zero), (Cochain.cycles).carrier, alpha);
\module On(alpha: Cochain.CycleCarrier) {
  \import H.On[beta := alpha, closed := closed alpha] \as Native;
  \definition map: Actions.Carrier := Native.map;
  \definition onClass: \forall (x: Chains.Carrier N.Nat^::zero) -> (map).apply (Source.classOf x) = Target.classOf ((Cap.map alpha).apply x) := Native.onClass;
}
\definition value[alpha: Cochain.CycleCarrier]: Actions.Carrier := On[alpha := alpha].map;
\module Linearity;
\module Descent;
