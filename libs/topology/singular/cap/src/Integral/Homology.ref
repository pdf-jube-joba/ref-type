\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients] \as Ordinary;
\import \parent.Diagonal[].Boundary[p := p, q := q] \as Boundary;
\import Boundary.Formula[] \as Formula;
\import Boundary.Closed[] \as BoundaryClosed;
\import Simplices.CutFaces[p := p, q := q] \as Geometry;
\import \parent.At[p := p, q := q] \as LowerCap;
\import \parent.At[p := N.Nat^::succ p, q := q] \as UpperCap;
\import Chains.DegreeTransport[] \as Degrees;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.Positive[C := Chains.complex, n := Geometry.total] \as Source;
\import Complexes.Positive[C := Chains.complex, n := p] \as Target;
\import Modules.Hom[V := Chains.Carrier Geometry.leftDegree, W := Chains.Carrier (N.Nat^::succ p), source := Chains.space Geometry.leftDegree, target := Chains.space (N.Nat^::succ p)].Composition[U := Chains.Carrier Geometry.higher, domain := Chains.space Geometry.higher] \as Composition;
\import Modules.Hom[V := Chains.Carrier Geometry.total, W := Chains.Carrier p, source := Chains.space Geometry.total, target := Chains.space p] \as LowerMaps;
\definition cap[beta: Cochains.Carrier q]: Modules.Hom[V := Chains.Carrier Geometry.higher, W := Chains.Carrier (N.Nat^::succ p), source := Chains.space Geometry.higher, target := Chains.space (N.Nat^::succ p)].Map :=
  Composition.compose (UpperCap.map beta) (Degrees.linear Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same));
\definition Closed[beta: Cochains.Carrier q]: \Prop := Ordinary.coboundary q beta = (Cochains.space (N.Nat^::succ q)).zero;
\module On(beta: Cochains.Carrier q, closed: Closed beta);
