\import std.Data[].Pair[] \as Pair;
\import topological_constructions.Product[A := A, B := A] \as Product;
\import Product.Universal[X := A] \as Universal;
\import topology.Maps[A := A, B := A].Identity[] \as Identity;
\definition function[x: A]: Product.CarrierSet := Pair.pair A A x x;
\definition continuous: topology.Continuity[A := A, B := Product.CarrierSet].Continuous source (Product.topology source source) function :=
  Universal.pairContinuous source source source Identity.function Identity.function (Identity.continuous source) (Identity.continuous source);
\import singular_cohomology.Maps[A := A, B := Product.CarrierSet, source := source, target := Product.topology source source] \as Maps;
\import singular_products.AlexanderWhitney[A := A, B := A, left := source, right := source] \as AW;
\module At(p, q: N.Nat^);
