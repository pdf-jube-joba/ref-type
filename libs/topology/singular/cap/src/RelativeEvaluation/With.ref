\import Relative.With[coefficients := coefficients] \as Cochains;
\import derived_functors.UniversalCoefficient[].Over[R := I.Int^, ring := Integers.commutativeRing].On[C := Relative.complex, A := coefficients] \as Universal;
\module At(z: I.Int^) {
  \import Universal.At[z := z] \as Evaluation;
  \import Relative.Homology[z := z] \as Homology;
  \import Cochains.At[z := z] \as Cohomology;
  \definition apply[alpha: Cohomology.Carrier][x: Homology.Carrier]: coefficients.Carrier :=
    ((Evaluation.map).apply alpha).apply x;
  \definition onClasses: \forall (alpha: Cohomology.Closed)(x: Homology.Cycle) ->
    apply (Cohomology.classOf alpha) (Homology.classOf x) = (alpha).apply x :=
    \fun (alpha: Cohomology.Closed)(x: Homology.Cycle) => trans!{coefficients.Carrier} _ _ _
      (congr!{Evaluation.ValueCarrier coefficients.Carrier} (\fun (f: Evaluation.ValueCarrier) => (f).apply (Homology.classOf x)) _ _ (Evaluation.onCohomologyClass alpha))
      (Evaluation.onClass alpha x);
}
\module Natural(B: \Set, target: topology.Topology[Carrier := B].Topology, targetSubset: \Pow B);
