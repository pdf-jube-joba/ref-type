\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import singular_products.Cochains[A := A, source := source, R := I.Int^, ring := Integers.commutativeRing] \as Cochains;
\import singular_cohomology.Relative[A := A, source := source, subset := first] \as First;
\import singular_cohomology.Relative[A := A, source := source, subset := second] \as Second;
\import First.With[coefficients := Cochains.integerCoefficients] \as FirstCochains;
\import Second.With[coefficients := Cochains.integerCoefficients] \as SecondCochains;
\import \root.CochainPair[A := A, source := source, subset := first, R := I.Int^, ring := Integers.commutativeRing] \as FirstPair;
\import \root.CochainPair[A := A, source := source, subset := second, R := I.Int^, ring := Integers.commutativeRing] \as SecondPair;
\import \root.Integral[A := A, source := source].Pair[subset := first] \as FirstCap;
\import \root.Integral[A := A, source := source].Pair[subset := second] \as SecondCap;
\import singular_cohomology.Chains[A := A, source := source] \as Chains;
\module Cup(p, q: N.Nat^);
\module Cap(p, q: N.Nat^);

\module Common(n: N.Nat^);
\module CommonComplex;
\module LeftPrimitive(k, q: N.Nat^);
\module RightPrimitive(p, r: N.Nat^);
\module Boundaries;
