\import std.Data[].Nat[] \as N;
\import singular_cohomology.Relative[A := A, source := source, subset := subset] \as Relative;
\import topology.Topology[Carrier := A].Subspace[S := subset] \as Subspace;
\import singular_products.Cochains[A := A, source := source, R := R, ring := ring] \as Whole;
\import singular_products.Cochains[A := Relative.SubspaceCarrier, source := Subspace.topology source, R := R, ring := ring] \as Sub;
\import Sub.Pullback[B := A, target := source] \as Pull;
\definition Vanishes[n: N.Nat^][alpha: Whole.Carrier n]: \Prop :=
  Pull.apply n Relative.inclusion Relative.inclusionContinuous alpha = (Sub.space n).zero;
\definition Carrier[n: N.Nat^]: \Set := \Cast[Whole.Carrier n] { alpha: Whole.Carrier n \where Vanishes n alpha };
\module Cup(p, q: N.Nat^);
