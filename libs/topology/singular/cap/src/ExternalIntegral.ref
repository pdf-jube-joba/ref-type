\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import topological_constructions.Product[A := A, B := B] \as Product;
\import \root.External[A := A, B := B, left := left, right := right, R := I.Int^, ring := Integers.commutativeRing] \as External;
\import External.Relative[leftSubset := leftSubset, rightSubset := rightSubset] \as Relative;
\import singular_products.Cochains[A := Product.CarrierSet, source := External.topology, R := I.Int^, ring := Integers.commutativeRing] \as Whole;
\import singular_cohomology.Relative[A := A, source := left, subset := leftSubset] \as Left;
\import singular_cohomology.Relative[A := B, source := right, subset := rightSubset] \as Right;
\import singular_cohomology.Relative[A := Product.CarrierSet, source := External.topology, subset := Relative.leftInverse] \as ProductLeft;
\import singular_cohomology.Relative[A := Product.CarrierSet, source := External.topology, subset := Relative.rightInverse] \as ProductRight;
\import ProductLeft.Maps[B := A].Over[target := left, targetSubset := leftSubset].On[f := Relative.leftPair].Integer[].With[coefficients := Whole.integerCoefficients] \as LeftPull;
\import ProductRight.Maps[B := B].Over[target := right, targetSubset := rightSubset].On[f := Relative.rightPair].Integer[].With[coefficients := Whole.integerCoefficients] \as RightPull;
\import Left.With[coefficients := Whole.integerCoefficients] \as LeftCochains;
\import Right.With[coefficients := Whole.integerCoefficients] \as RightCochains;
\import \root.Triple[A := Product.CarrierSet, source := External.topology, first := Relative.leftInverse, second := Relative.rightInverse].Union[].Cover[] \as Cover;
\module Cup(p, q: N.Nat^, conditions: Cover.Conditions);
\module Cross;
