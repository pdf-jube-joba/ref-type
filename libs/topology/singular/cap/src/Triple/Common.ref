\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients] \as Theory;
\import FirstPair.Differential[n := n] \as FirstDifferential;
\import SecondPair.Differential[n := n] \as SecondDifferential;
\structure Conditions[h: Cochains.Carrier n]: \Prop := {
  first: FirstPair.Vanishes n h,
  second: SecondPair.Vanishes n h,
};
\definition Carrier: \Set := \Cast[Cochains.Carrier n] ({ h: Cochains.Carrier n \where Conditions[h] });
\definition firstCochain[h: Carrier]: FirstPair.Carrier n := \into[Cochains.Carrier n](h, { x: Cochains.Carrier n \where FirstPair.Vanishes n x }) \by {
  (\bysub(Cochains.Carrier n, { x: Cochains.Carrier n \where Conditions[x] }, h)).first
};
\definition secondCochain[h: Carrier]: SecondPair.Carrier n := \into[Cochains.Carrier n](h, { x: Cochains.Carrier n \where SecondPair.Vanishes n x }) \by {
  (\bysub(Cochains.Carrier n, { x: Cochains.Carrier n \where Conditions[x] }, h)).second
};
\definition differential[h: Carrier]: \parent.Common[n := N.Nat^::succ n].Carrier :=
  \into[Cochains.Carrier (N.Nat^::succ n)](Theory.coboundary n h,
    { x: Cochains.Carrier (N.Nat^::succ n) \where \parent.Common[n := N.Nat^::succ n].Conditions[x] }) \by {
      \parent.Common[n := N.Nat^::succ n].Conditions[Theory.coboundary n h] {
        first := \bysub(Cochains.Carrier (N.Nat^::succ n), { x: Cochains.Carrier (N.Nat^::succ n) \where FirstPair.Vanishes (N.Nat^::succ n) x }, FirstDifferential.apply (firstCochain h)),
        second := \bysub(Cochains.Carrier (N.Nat^::succ n), { x: Cochains.Carrier (N.Nat^::succ n) \where SecondPair.Vanishes (N.Nat^::succ n) x }, SecondDifferential.apply (secondCochain h)),
      }
    };
\import topology.Topology[Carrier := A].Subspace[S := first] \as FirstTopology;
\import topology.Topology[Carrier := A].Subspace[S := second] \as SecondTopology;
\import singular_cohomology.Cochains[A := First.SubspaceCarrier, source := FirstTopology.topology source].With[coefficients := Cochains.integerCoefficients] \as FirstTheory;
\import singular_cohomology.Cochains[A := Second.SubspaceCarrier, source := SecondTopology.topology source].With[coefficients := Cochains.integerCoefficients] \as SecondTheory;
\import singular_cohomology.Maps[A := First.SubspaceCarrier, B := A, source := FirstTopology.topology source, target := source].Coefficients[M := Cochains.integerCoefficients, L := Cochains.integerCoefficients] \as FirstPull;
\import singular_cohomology.Maps[A := Second.SubspaceCarrier, B := A, source := SecondTopology.topology source, target := source].Coefficients[M := Cochains.integerCoefficients, L := Cochains.integerCoefficients] \as SecondPull;
\import Modules.End[V := I.Int^, space := Cochains.integerCoefficients.space] \as Scalars;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.Map[C := Theory.complex, D := FirstTheory.complex].At[k := n] \as FirstMap;
\import Complexes.Map[C := Theory.complex, D := SecondTheory.complex].At[k := n] \as SecondMap;
\import Modules.Of[V := Theory.Carrier n, space := Theory.space n].Submodule[] \as Submodules;
\import Submodules.Kernel[W := FirstTheory.Carrier n, target := FirstTheory.space n] \as FirstKernel;
\import Submodules.Kernel[W := SecondTheory.Carrier n, target := SecondTheory.space n] \as SecondKernel;
\definition firstKernel: Submodules.Submodule := FirstKernel.kernel (FirstMap.linear (FirstPull.map First.inclusion First.inclusionContinuous Scalars.identity));
\definition secondKernel: Submodules.Submodule := SecondKernel.kernel (SecondMap.linear (SecondPull.map Second.inclusion Second.inclusionContinuous Scalars.identity));
\definition submodule: Submodules.Submodule := Submodules.Submodule {
  carrier := { h: Cochains.Carrier n \where Conditions[h] },
  zero := Conditions[(Theory.space n).zero] { first := (firstKernel).zero, second := (secondKernel).zero },
  addition := \fun (x, y: Cochains.Carrier n)(hx: Conditions[x])(hy: Conditions[y]) => Conditions[(Theory.space n).add x y] {
    first := (firstKernel).addition x y hx.first hy.first, second := (secondKernel).addition x y hx.second hy.second,
  },
  scalar := \fun (a: I.Int^)(x: Cochains.Carrier n)(hx: Conditions[x]) => Conditions[(Theory.space n).smul a x] {
    first := (firstKernel).scalar a x hx.first, second := (secondKernel).scalar a x hx.second,
  },
};
\import Submodules.Of[S := submodule] \as CommonModule;
\definition space: Modules.Space Carrier := CommonModule.moduleSpace;
