\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\import \root.Integral[A := A, source := source].At[p := p, q := q] \as Whole;
\import FirstCap.At[p := p, q := q].RelativeCochain[] \as Absolute;
\import FirstCap.At[p := p, q := q].Quotient[] \as FirstRelative;
\import SecondCap.Degree[] \as SecondDegree;
\import SecondPair.Comparison[n := q] \as SecondComparison;
\import Modules.Hom[V := Chains.Carrier p, W := SecondDegree.Carrier p, source := Chains.space p, target := SecondDegree.space p].Composition[U := First.Carrier (I.Int^::ofNat Whole.total), domain := First.space (I.Int^::ofNat Whole.total)] \as Composition;
\definition total: N.Nat^ := Whole.total;
\definition fromFirst[beta: FirstCochains.Carrier (I.Int^::ofNat q)]: Modules.Hom[V := First.Carrier (I.Int^::ofNat total), W := Second.Carrier (I.Int^::ofNat p), source := First.space (I.Int^::ofNat total), target := Second.space (I.Int^::ofNat p)].Map :=
  Composition.compose (SecondDegree.projection p) (Absolute.map beta);
\definition fromSecond[beta: SecondCochains.Carrier (I.Int^::ofNat q)]: Modules.Hom[V := First.Carrier (I.Int^::ofNat total), W := First.Carrier (I.Int^::ofNat p), source := First.space (I.Int^::ofNat total), target := First.space (I.Int^::ofNat p)].Map :=
  FirstRelative.map (SecondComparison.from beta);
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := Chains.complex] \as Extension;
\definition onClass: \forall (beta: FirstCochains.Carrier (I.Int^::ofNat q))(x: Extension.Carrier (I.Int^::ofNat total)) ->
  (fromFirst beta).apply (First.class (I.Int^::ofNat total) x) = SecondDegree.class p ((Whole.map (FirstPair.Comparison[n := q].from beta)).apply x) :=
  \fun (beta: FirstCochains.Carrier (I.Int^::ofNat q))(x: Extension.Carrier (I.Int^::ofNat total)) =>
    congr!{{Chains.Carrier p} {SecondDegree.Carrier p}} (SecondDegree.class p) _ _ (Absolute.onClass beta x);
