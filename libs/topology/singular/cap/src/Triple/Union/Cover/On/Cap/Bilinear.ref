\import FirstComparison.Linear[] \as ComparisonLinear;
\import First.OverRing[R := I.Int^, ring := Integers.commutativeRing].With[coefficients := Cochains.coefficients] \as FirstRing;
\import Whole.Bilinear[] \as WholeBilinear;
\import Modules.Hom[V := Q.Carrier, W := SecondDegree.Carrier p, source := Q.space, target := SecondDegree.space p] \as Maps;
\import Modules.Hom[V := Chains.Carrier Whole.total, W := Chains.Carrier p, source := Chains.space Whole.total, target := Chains.space p] \as WholeMaps;
\definition addition: \forall (beta, gamma: FirstCochains.Carrier (I.Int^::ofNat q)) ->
  map ((FirstRing.space (I.Int^::ofNat q)).add beta gamma) = Maps.plus (map beta) (map gamma) :=
  \fun (beta, gamma: FirstCochains.Carrier (I.Int^::ofNat q)) => Maps.ext _ _
    (Q.induction (\fun (x: Q.Carrier) => (map ((FirstRing.space (I.Int^::ofNat q)).add beta gamma)).apply x = (Maps.plus (map beta) (map gamma)).apply x)
      (\fun (x: WholeExtension.Carrier (I.Int^::ofNat Whole.total)) => eq_reason_in!{{SecondDegree.Carrier p} _
        "=" _ "by" { onClass ((FirstRing.space (I.Int^::ofNat q)).add beta gamma) x }
        "=" _ "by" { congr!{{Cochains.Carrier q} {SecondDegree.Carrier p}} (\fun (b: Cochains.Carrier q) => (SecondAction.raw b).apply x) _ _ (ComparisonLinear.addition beta gamma) }
        "=" _ "by" { congr!{{Chains.Carrier p} {SecondDegree.Carrier p}} (SecondDegree.class p) _ _
          (congr!{WholeMaps.Map {Chains.Carrier p}} (\fun (f: WholeMaps.Map) => f.apply x) _ _ (WholeBilinear.addition (FirstComparison.from beta) (FirstComparison.from gamma))) }
        "=" _ "by" { (SecondDegree.projection p).addition ((Whole.map (FirstComparison.from beta)).apply x) ((Whole.map (FirstComparison.from gamma)).apply x) }
        "=" _ "by" { congr!{{SecondDegree.Carrier p} {SecondDegree.Carrier p} {SecondDegree.Carrier p}} ((SecondDegree.space p).add) _ _ _ _ (sym!{{SecondDegree.Carrier p}} _ _ (onClass beta x)) (sym!{{SecondDegree.Carrier p}} _ _ (onClass gamma x)) }
      }));
\definition scalarValue: \forall (a: I.Int^)(beta: FirstCochains.Carrier (I.Int^::ofNat q))(x: Q.Carrier) ->
  (map ((FirstRing.space (I.Int^::ofNat q)).smul a beta)).apply x = (SecondDegree.space p).smul a ((map beta).apply x) :=
  \fun (a: I.Int^)(beta: FirstCochains.Carrier (I.Int^::ofNat q)) => Q.induction
    (\fun (x: Q.Carrier) => (map ((FirstRing.space (I.Int^::ofNat q)).smul a beta)).apply x = (SecondDegree.space p).smul a ((map beta).apply x))
    (\fun (x: WholeExtension.Carrier (I.Int^::ofNat Whole.total)) => eq_reason_in!{{SecondDegree.Carrier p} _
      "=" _ "by" { onClass ((FirstRing.space (I.Int^::ofNat q)).smul a beta) x }
      "=" _ "by" { congr!{{Cochains.Carrier q} {SecondDegree.Carrier p}} (\fun (b: Cochains.Carrier q) => (SecondAction.raw b).apply x) _ _ (ComparisonLinear.scalar a beta) }
      "=" _ "by" { congr!{{Chains.Carrier p} {SecondDegree.Carrier p}} (SecondDegree.class p) _ _ (WholeBilinear.scalarValue a (FirstComparison.from beta) x) }
      "=" _ "by" { (SecondDegree.projection p).scalar a ((Whole.map (FirstComparison.from beta)).apply x) }
      "=" _ "by" { congr!{{SecondDegree.Carrier p} {SecondDegree.Carrier p}} ((SecondDegree.space p).smul a) _ _ (sym!{{SecondDegree.Carrier p}} _ _ (onClass beta x)) }
    });
