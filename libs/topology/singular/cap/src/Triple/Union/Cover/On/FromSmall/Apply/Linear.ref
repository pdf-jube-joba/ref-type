\definition addition: \forall (h, k: SmallRelative.Carrier (I.Int^::ofNat n)) ->
  apply ((SmallRelative.space (I.Int^::ofNat n)).add h k) = (Common.space).add (apply h) (apply k) :=
  \fun (h, k: SmallRelative.Carrier (I.Int^::ofNat n)) => WholeMaps.ext (whole ((SmallRelative.space (I.Int^::ofNat n)).add h k)) ((singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients].space n).add (whole h) (whole k))
    (\fun (x: Chains.Carrier n) => \refl((Cochains.integerCoefficients.space).add ((h).apply (Quotient.At[k := I.Int^::ofNat n].class (WholeExtension.Positive[n := n].intro x))) ((k).apply (Quotient.At[k := I.Int^::ofNat n].class (WholeExtension.Positive[n := n].intro x)))));
\definition scalar: \forall (a: I.Int^)(h: SmallRelative.Carrier (I.Int^::ofNat n)) ->
  apply ((SmallRelative.space (I.Int^::ofNat n)).smul a h) = (Common.space).smul a (apply h) :=
  \fun (a: I.Int^)(h: SmallRelative.Carrier (I.Int^::ofNat n)) => WholeMaps.ext (whole ((SmallRelative.space (I.Int^::ofNat n)).smul a h)) ((singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients].space n).smul a (whole h))
    (\fun (x: Chains.Carrier n) => \refl((Cochains.integerCoefficients.space).smul a ((h).apply (Quotient.At[k := I.Int^::ofNat n].class (WholeExtension.Positive[n := n].intro x)))));
\import Modules.Hom[V := SmallRelative.Carrier (I.Int^::ofNat n), W := Common.Carrier, source := SmallRelative.space (I.Int^::ofNat n), target := Common.space] \as Maps;
\definition map: Maps.Map := Maps.Map { apply := apply, addition := addition, scalar := scalar };
