\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;

\import First.OverRing[R := I.Int^, ring := Integers.commutativeRing].With[coefficients := Cochains.coefficients] \as Theory;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring].At[C := Theory.complex, z := I.Int^::ofNat (N.Nat^::succ r)] \as Cochain;
\import \parent.CapHomology[p := p, q := N.Nat^::succ r] \as H;
\import \parent.CapBoundary[p := p, q := N.Nat^::succ r] \as Boundary;
\import \parent.SmallDegree[] \as Degree;
\import singular_cohomology.Simplices[A := A, source := source].CutFaces[p := p, q := N.Nat^::succ r] \as Geometry;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import Nonnegative.ZeroExtension[C := Small.complex] \as SmallExtension;
\import Nonnegative.ZeroExtension[C := Chains.complex] \as WholeExtension;
\import Nonnegative.Map[C := Small.complex, D := Chains.complex].ZeroExtension[f := inclusion] \as SmallMap;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.Quotient[C := SmallExtension.complex, D := WholeExtension.complex].On[f := SmallMap.map] \as Q;
\import Complexes.At[C := Q.complex, z := I.Int^::ofNat Geometry.higher] \as Source;
\import Complexes.At[C := Second.complex, z := I.Int^::ofNat (N.Nat^::succ p)] \as Target;
\import SecondCap.Degree[] \as TargetDegree;
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing].HomSpace[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as Actions;
\import Modules.Hom[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as ActionMaps;
\import \parent.Cap[p := N.Nat^::succ p, q := N.Nat^::succ r].Bilinear[] \as Bilinear;
\import \parent.SmallDegree[] \as Degrees;
\definition closed[alpha: Cochain.Closed]: Boundary.closed alpha := \bysub(FirstCochains.Carrier (I.Int^::ofNat (N.Nat^::succ r)), (Cochain.cycles).carrier, alpha);
\module On(alpha: Cochain.Closed) {
  \import H.On[beta := alpha, closed := closed alpha] \as Native;
  \import Native.Induced[] \as Induced;
  \definition cycle: Source.Cycle -> Target.Cycle := Native.cycle;
  \definition map: Actions.Carrier := Induced.map;
  \definition onClass: \forall (x: Source.Cycle) -> (map).apply (Source.classOf x) = Target.classOf (cycle x) := Induced.onClass;
}
\definition value[alpha: Cochain.Closed]: Actions.Carrier := On[alpha := alpha].map;
\module Linearity;
\module Descent;
