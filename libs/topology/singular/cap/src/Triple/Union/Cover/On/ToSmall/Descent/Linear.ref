\import \parent.\parent.\parent.FromSmall[n := n].Apply[] \as From;
\import From.Linear[] \as FromLinear;
\definition addition: \forall (x, y: Common.Carrier) ->
  apply ((Common.space).add x y) = (SmallRelative.space (I.Int^::ofNat n)).add (apply x) (apply y) :=
  \fun (x, y: Common.Carrier) => From.injective _ _ (eq_reason_in!{Common.Carrier _
    "=" _ "by" { From.fromTo ((Common.space).add x y) }
    "=" _ "by" { congr!{Common.Carrier Common.Carrier Common.Carrier} (Common.space.add) _ _ _ _ (sym!{Common.Carrier} _ _ (From.fromTo x)) (sym!{Common.Carrier} _ _ (From.fromTo y)) }
    "=" _ "by" { sym!{Common.Carrier} _ _ (FromLinear.addition (apply x) (apply y)) }
  });
\definition scalar: \forall (a: I.Int^)(x: Common.Carrier) ->
  apply ((Common.space).smul a x) = (SmallRelative.space (I.Int^::ofNat n)).smul a (apply x) :=
  \fun (a: I.Int^)(x: Common.Carrier) => From.injective _ _ (eq_reason_in!{Common.Carrier _
    "=" _ "by" { From.fromTo ((Common.space).smul a x) }
    "=" _ "by" { congr!{Common.Carrier Common.Carrier} ((Common.space).smul a) _ _ (sym!{Common.Carrier} _ _ (From.fromTo x)) }
    "=" _ "by" { sym!{Common.Carrier} _ _ (FromLinear.scalar a (apply x)) }
  });
\import Modules.Hom[V := Common.Carrier, W := SmallRelative.Carrier (I.Int^::ofNat n), source := Common.space, target := SmallRelative.space (I.Int^::ofNat n)] \as Maps;
\definition map: Maps.Map := Maps.Map { apply := apply, addition := addition, scalar := scalar };
