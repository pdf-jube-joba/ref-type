\import Modules.Of[V := TargetDegree.Carrier N.Nat^::zero, space := TargetDegree.space N.Nat^::zero].Submodule[] \as TargetSub;
\import TargetSub.Image[U := TargetDegree.Carrier (N.Nat^::succ N.Nat^::zero), source := TargetDegree.space (N.Nat^::succ N.Nat^::zero)] \as Images;
\definition witness[y: Degree.Carrier (N.Nat^::succ WholeCap.total)]: TargetDegree.Carrier (N.Nat^::succ N.Nat^::zero) :=
  (Upper.map beta).apply (Degree.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) y);
\definition onBoundary: \forall (y: Degree.Carrier (N.Nat^::succ WholeCap.total)) -> (Cap.map beta).apply ((Source.prior).apply y) = (Target.prior).apply (witness y) :=
  \fun (y: Degree.Carrier (N.Nat^::succ WholeCap.total)) => trans!{{TargetDegree.Carrier N.Nat^::zero}} _ _ _
    (congr!{{Degree.Carrier WholeCap.total} {TargetDegree.Carrier N.Nat^::zero}} ((Cap.map beta).apply) _ _ (sourcePrior y))
    (trans!{{TargetDegree.Carrier N.Nat^::zero}} _ _ _ (Boundary.law beta closed y) (sym!{{TargetDegree.Carrier N.Nat^::zero}} _ _ (targetPrior (witness y))));
\definition preserves: \forall (x: Source.Cycle) -> \In[Source.Cycle] (Source.boundariesInside).carrier x -> \In[Target.Cycle] (Target.boundariesInside).carrier (cycle x) := \block {
  \fun (x: Source.Cycle)(member: _) \then
  \takefrom y: \Cast[Degree.Carrier (N.Nat^::succ WholeCap.total)] ({ y: Degree.Carrier (N.Nat^::succ WholeCap.total) \where (Source.prior).apply y = x }) \by member \then
  \return Images.introduce Target.prior (cycle x) (witness y)
    (trans!{{TargetDegree.Carrier N.Nat^::zero}} _ _ _ (sym!{{TargetDegree.Carrier N.Nat^::zero}} _ _ (onBoundary y))
      (congr!{{Degree.Carrier WholeCap.total} {TargetDegree.Carrier N.Nat^::zero}} ((Cap.map beta).apply) _ _
        (\bysub(Degree.Carrier (N.Nat^::succ WholeCap.total), { y: Degree.Carrier (N.Nat^::succ WholeCap.total) \where (Source.prior).apply y = x }, y))))
};
