\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import algebraic_topology.Simplex[] \as Simplex;
\import Small.Simplices[] \as SmallSimplices;
\import singular_cohomology.Simplices[A := Relative.SubspaceCarrier, source := Space.topology source] \as UnionSimplices;
\import \parent.ToSmall[n := n] \as ToSmall;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Relative[subcomplex := Small.complex, wholecomplex := Chains.complex].On[pair := pair, coefficients := Cochains.integerCoefficients] \as SmallRelative;
\import SmallRelative.Vanishing[z := I.Int^::ofNat n] \as Vanishing;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := Small.complex] \as SmallExtension;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := Chains.complex] \as WholeExtension;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring].Quotient[C := SmallExtension.complex, D := WholeExtension.complex].On[f := SmallRelative.inclusionMap] \as Quotient;
\import Modules.Hom[V := Chains.Carrier n, W := I.Int^, source := Chains.space n, target := Cochains.integerCoefficients.space] \as WholeMaps;
\definition whole[h: SmallRelative.Carrier (I.Int^::ofNat n)]: WholeMaps.Map := WholeMaps.Map {
  apply := \fun (x: Chains.Carrier n) => h.apply (Quotient.At[k := I.Int^::ofNat n].class (WholeExtension.Positive[n := n].intro x)),
  addition := \fun (x, y: Chains.Carrier n) => (Vanishing.precompose h).addition (WholeExtension.Positive[n := n].intro x) (WholeExtension.Positive[n := n].intro y),
  scalar := \fun (a: I.Int^)(x: Chains.Carrier n) => (Vanishing.precompose h).scalar a (WholeExtension.Positive[n := n].intro x),
};
\module Part(S: \Pow A, contained: \forall (x: A) -> \In[A] S x -> \In[A] subset x,
  element: \Pow Relative.SubspaceCarrier, member: \In[\Pow Relative.SubspaceCarrier] Covered.family element,
  inside: \forall (x: \Cast[A] S) -> \In[Relative.SubspaceCarrier] element (\into[A](x, subset) \by { contained x (\bysub(A, S, x)) }));
\module Apply;
