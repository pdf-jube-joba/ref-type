\use std.Logic[].Equality[].congr;
\import \root.Integral[A := A, source := source].At[p := N.Nat^::zero, q := q] \as WholeCap;
\import \parent.CapBoundary[p := N.Nat^::zero, q := q] \as Boundary;
\import \parent.CapZeroHomology[q := q] \as SmallAction;
\import \parent.Comparison[] \as Comparison;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import Nonnegative.ZeroExtension[C := Small.complex] \as SmallExtension;
\import Nonnegative.ZeroExtension[C := Chains.complex] \as WholeExtension;
\import Nonnegative.Map[C := Small.complex, D := Chains.complex].ZeroExtension[f := inclusion] \as SmallMap;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.Quotient[C := SmallExtension.complex, D := WholeExtension.complex].On[f := SmallMap.map] \as Q;
\import Complexes.At[C := Q.complex, z := I.Int^::ofNat WholeCap.total] \as SmallInput;
\import Complexes.At[C := Relative.complex, z := I.Int^::ofNat WholeCap.total] \as Input;
\import Complexes.At[C := Second.complex, z := I.Int^::ofNat (N.Nat^::zero)] \as Output;
\import Modules.Hom[V := SmallInput.Homology, W := Output.Homology, source := SmallInput.homologySpace, target := Output.homologySpace].Composition[U := Input.Homology, domain := Input.homologySpace] \as Composition;
\import Comparison.Homology[z := I.Int^::ofNat WholeCap.total] \as ComparisonAt;
\module On(beta: FirstCochains.Carrier (I.Int^::ofNat q), closed: Boundary.closed beta) {
  \import SmallAction.On[beta := beta, closed := closed].Induced[] \as Induced;
  \definition map: Modules.Hom[V := Input.Homology, W := Output.Homology, source := Input.homologySpace, target := Output.homologySpace].Map :=
    Composition.compose Induced.map (ComparisonAt.isomorphism.backward);
  \definition onSmall: \forall (x: SmallInput.Homology) -> (map).apply ((ComparisonAt.isomorphism.forward).apply x) = (Induced.map).apply x :=
    \fun (x: SmallInput.Homology) => congr!{SmallInput.Homology Output.Homology} ((Induced.map).apply) _ _ (ComparisonAt.isomorphism.leftInverse x);
}
