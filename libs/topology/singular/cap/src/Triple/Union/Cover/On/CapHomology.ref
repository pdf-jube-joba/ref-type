\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import \parent.SmallDegree[] \as Degree;
\import SecondCap.Degree[] \as TargetDegree;
\import singular_cohomology.Simplices[A := A, source := source].CutFaces[p := p, q := q] \as Geometry;
\import \parent.CapBoundary[p := p, q := q] \as Boundary;
\import \parent.Cap[p := p, q := q] \as Lower;
\import \parent.Cap[p := N.Nat^::succ p, q := q] \as Upper;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import Nonnegative.ZeroExtension[C := Small.complex] \as SmallExtension;
\import Nonnegative.ZeroExtension[C := Chains.complex] \as WholeExtension;
\import Nonnegative.Map[C := Small.complex, D := Chains.complex].ZeroExtension[f := inclusion] \as SmallMap;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.Quotient[C := SmallExtension.complex, D := WholeExtension.complex].On[f := SmallMap.map] \as Q;
\import Complexes.At[C := Q.complex, z := I.Int^::ofNat Geometry.higher] \as Source;
\import Complexes.At[C := Second.complex, z := I.Int^::ofNat (N.Nat^::succ p)] \as Target;
\import Modules.Hom[V := Degree.Carrier Geometry.leftDegree, W := TargetDegree.Carrier (N.Nat^::succ p), source := Degree.space Geometry.leftDegree, target := TargetDegree.space (N.Nat^::succ p)].Composition[U := Degree.Carrier Geometry.higher, domain := Degree.space Geometry.higher] \as Composition;
\import Modules.Hom[V := Degree.Carrier Geometry.total, W := TargetDegree.Carrier p, source := Degree.space Geometry.total, target := TargetDegree.space p] \as LowerMaps;
\import std.Logic[].Equality[].Transport[A := I.Int^] \as IntegerTransport;
\definition sourcePrior: \forall (y: Degree.Carrier (N.Nat^::succ Geometry.higher)) -> (Source.prior).apply y = (Degree.boundary Geometry.higher).apply y :=
  \fun (y: Degree.Carrier (N.Nat^::succ Geometry.higher)) => IntegerTransport.castRefl Q.complex.family.Carrier (I.Int^::ofNat Geometry.higher) ((Degree.boundary Geometry.higher).apply y);
\definition targetPrior: \forall (y: TargetDegree.Carrier (N.Nat^::succ (N.Nat^::succ p))) -> (Target.prior).apply y = (TargetDegree.boundary (N.Nat^::succ p)).apply y :=
  \fun (y: TargetDegree.Carrier (N.Nat^::succ (N.Nat^::succ p))) => IntegerTransport.castRefl Second.complex.family.Carrier (I.Int^::ofNat (N.Nat^::succ p)) ((TargetDegree.boundary (N.Nat^::succ p)).apply y);
\definition cap[beta: FirstCochains.Carrier (I.Int^::ofNat q)]: Modules.Hom[V := Degree.Carrier Geometry.higher, W := TargetDegree.Carrier (N.Nat^::succ p), source := Degree.space Geometry.higher, target := TargetDegree.space (N.Nat^::succ p)].Map :=
  Composition.compose (Upper.map beta) (Degree.linear Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same));
\module On(beta: FirstCochains.Carrier (I.Int^::ofNat q), closed: Boundary.closed beta);
