\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.congr;
\import \root.Triple[A := A, source := source, first := first, second := second].Cup[p := p, q := q] \as Product;
\import Product.Both[].Cohomology[] \as CommonProduct;
\import \parent.CommonIso[].Cohomology[n := Product.total] \as Comparison;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Integer;
\import Integer.At[C := FirstCochains.complex, z := I.Int^::ofNat p] \as Left;
\import Integer.At[C := SecondCochains.complex, z := I.Int^::ofNat q] \as Right;
\import Integer.At[C := RelativeCochains.complex, z := I.Int^::ofNat Product.total] \as Output;
\import \root.Triple[A := A, source := source, first := first, second := second].CommonComplex[].At[n := Product.total] \as Common;
\definition apply[alpha: Left.Cohomology][beta: Right.Cohomology]: Output.Cohomology :=
  (Comparison.isomorphism.backward).apply (CommonProduct.apply alpha beta);
\definition comparison: \forall (alpha: Left.Cohomology)(beta: Right.Cohomology) ->
  (Comparison.isomorphism.forward).apply (apply alpha beta) = CommonProduct.apply alpha beta :=
  \fun (alpha: Left.Cohomology)(beta: Right.Cohomology) => (Comparison.isomorphism).rightInverse (CommonProduct.apply alpha beta);
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing] \as Commutative;
\definition left: Modules.Bundle := Modules.Bundle { Carrier := Left.Cohomology, space := Left.cohomologySpace };
\definition right: Modules.Bundle := Modules.Bundle { Carrier := Right.Cohomology, space := Right.cohomologySpace };
\definition common: Modules.Bundle := Modules.Bundle { Carrier := Common.cohomology, space := Common.space };
\definition output: Modules.Bundle := Modules.Bundle { Carrier := Output.Cohomology, space := Output.cohomologySpace };
\import Commutative.Bilinear[A := left, B := right, C := common].Postcompose[D := output] \as Postcompose;
\definition bilinear: _ := Postcompose.apply CommonProduct.bilinear (Comparison.isomorphism.backward);
