\import \parent.Maps[] \as Maps;
\import \parent.\parent.Comparison[].With[coefficients := Cochains.integerCoefficients] \as Comparison;
\import Integer.At[C := Relative.With[coefficients := Cochains.integerCoefficients].complex, z := I.Int^::ofNat n] \as Source;
\import Integer.At[C := SmallRelative.complex, z := I.Int^::ofNat n] \as SmallH;
\import Integer.At[C := CommonExtension.complex, z := I.Int^::ofNat n] \as IntegerH;
\import Nonnegative.At[C := Common.complex, k := n] \as Target;
\import Integer.Isomorphism[C := SmallRelative.complex, D := CommonExtension.complex].On[e := Maps.isomorphism].At[z := I.Int^::ofNat n] \as SmallCommon;
\import CommonExtension.PositiveCohomology[n := n] \as Positive;
\import Modules.Isomorphism[V := Source.Cohomology, W := SmallH.Cohomology, source := Source.cohomologySpace, target := SmallH.cohomologySpace].Composition[U := IntegerH.Cohomology, final := IntegerH.cohomologySpace] \as FirstComposition;
\definition first: Modules.Isomorphism[V := Source.Cohomology, W := IntegerH.Cohomology, source := Source.cohomologySpace, target := IntegerH.cohomologySpace].Isomorphism :=
  FirstComposition.compose SmallCommon.isomorphism (Comparison.At[z := I.Int^::ofNat n].isomorphism);
\import Modules.Isomorphism[V := Source.Cohomology, W := IntegerH.Cohomology, source := Source.cohomologySpace, target := IntegerH.cohomologySpace].Composition[U := Target.Cohomology, final := Target.cohomologySpace] \as LastComposition;
\definition isomorphism: Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Isomorphism :=
  LastComposition.compose Positive.isomorphism first;
\module Canonical;
