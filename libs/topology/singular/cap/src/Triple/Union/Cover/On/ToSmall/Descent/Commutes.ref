\import \parent.\parent.\parent.ToSmall[n := N.Nat^::succ n].Descent[] \as Higher;
\import \parent.\parent.\parent.FromSmall[n := n].Apply[] \as From;
\import From.Commutes[] \as FromCommutes;
\import \parent.\parent.\parent.FromSmall[n := N.Nat^::succ n].Apply[] \as HigherFrom;
\definition law: \forall (x: Common.Carrier) ->
  Higher.apply (Common.differential x) = (SmallRelative.complex.differential).apply (I.Int^::ofNat n) (apply x) :=
  \fun (x: Common.Carrier) => HigherFrom.injective _ _ (eq_reason_in!{{\root.Triple[A := A, source := source, first := first, second := second].Common[n := N.Nat^::succ n].Carrier} _
    "=" _ "by" { HigherFrom.fromTo (Common.differential x) }
    "=" _ "by" { congr!{Common.Carrier {\root.Triple[A := A, source := source, first := first, second := second].Common[n := N.Nat^::succ n].Carrier}} Common.differential _ _ (sym!{Common.Carrier} _ _ (From.fromTo x)) }
    "=" _ "by" { sym!{{\root.Triple[A := A, source := source, first := first, second := second].Common[n := N.Nat^::succ n].Carrier}} _ _ (FromCommutes.law (apply x)) }
  });
