\import \parent.\parent.\parent.FromSmall[n := N.Nat^::succ n].Apply[] \as Higher;
\import std.Logic[].Equality[].Transport[A := I.Int^] \as Transport;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring].Prior[C := Quotient.complex] \as Prior;
\import Modules.Hom[V := Chains.Carrier (N.Nat^::succ n), W := I.Int^, source := Chains.space (N.Nat^::succ n), target := Cochains.integerCoefficients.space] \as HigherMaps;
\definition prior: \forall (x: Chains.Carrier (N.Nat^::succ n)) ->
  Prior.value (I.Int^::ofNat n) (Quotient.At[k := I.Int^::ofNat (N.Nat^::succ n)].class (WholeExtension.Positive[n := N.Nat^::succ n].intro x)) =
  Quotient.At[k := I.Int^::ofNat n].class (WholeExtension.Positive[n := n].intro ((Chains.boundary n).apply x)) :=
  \fun (x: Chains.Carrier (N.Nat^::succ n)) => trans!{{Quotient.Carrier (I.Int^::ofNat n)}} _ _ _
    (Transport.castRefl Quotient.complex.family.Carrier (I.Int^::ofNat n)
      ((Quotient.complex.differential).apply (I.Int^::ofNat (N.Nat^::succ n)) (Quotient.At[k := I.Int^::ofNat (N.Nat^::succ n)].class (WholeExtension.Positive[n := N.Nat^::succ n].intro x))))
    (Quotient.At[k := I.Int^::ofNat (N.Nat^::succ n)].onClass (WholeExtension.Positive[n := N.Nat^::succ n].intro x));
\definition law: \forall (h: SmallRelative.Carrier (I.Int^::ofNat n)) ->
  Higher.apply ((SmallRelative.complex.differential).apply (I.Int^::ofNat n) h) = Common.differential (apply h) :=
  \fun (h: SmallRelative.Carrier (I.Int^::ofNat n)) => HigherMaps.ext _ _ (\fun (x: Chains.Carrier (N.Nat^::succ n)) =>
    congr!{{Quotient.Carrier (I.Int^::ofNat n)} I.Int^} ((h).apply) _ _ (prior x));
