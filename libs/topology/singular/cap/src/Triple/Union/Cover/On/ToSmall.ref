\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import algebraic_topology.Simplex[] \as Simplex;
\import Simplex.At[n := n] \as Domain;
\import Small.Simplices[] \as SmallSimplices;
\import singular_cohomology.Simplices[A := Relative.SubspaceCarrier, source := Space.topology source] \as UnionSimplices;
\import singular_cohomology.Simplices[A := A, source := source] \as WholeSimplices;
\import \parent.Degree[n := n] \as Degree;
\import Modules.Free[Generators := SmallSimplices.Carrier n].Reindex[TargetGenerators := WholeSimplices.Carrier n] \as Reindex;
\definition embedded[sigma: SmallSimplices.Carrier n]: WholeSimplices.Carrier n := Degree.simplex sigma;
\definition onGenerator: \forall (sigma: SmallSimplices.Carrier n) ->
  (inclusion).apply n (Small.generator n sigma) = Chains.generator n (embedded sigma) :=
  \fun (sigma: SmallSimplices.Carrier n) => trans!{{Chains.Carrier n}} _ _ _ (Degree.same (Small.generator n sigma)) (Reindex.onGenerator Degree.simplex sigma);
\module Part(S: \Pow A);
