\definition cycle[x: Source.Cycle]: Target.Cycle := Target.cycle ((Cap.map beta).apply x)
  (SecondCap.ZeroHomology[q := q].negativeZero ((Target.differential).apply ((Cap.map beta).apply x)));
\import Modules.Hom[V := Source.Cycle, W := Target.Cycle, source := Source.cycleSpace, target := Target.cycleSpace] \as CycleMaps;
\definition cycles: CycleMaps.Map := CycleMaps.Map { apply := cycle, addition := \fun (x, y: Source.Cycle) => (Cap.map beta).addition x y, scalar := \fun (a: I.Int^)(x: Source.Cycle) => (Cap.map beta).scalar a x };
\module Boundaries;
\module Induced;
