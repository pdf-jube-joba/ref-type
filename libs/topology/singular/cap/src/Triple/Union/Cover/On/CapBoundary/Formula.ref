\import \parent.\parent.Cap[p := p, q := N.Nat^::succ q] \as Right;
\import \root.Integral[A := A, source := source].Diagonal[].Boundary[p := p, q := q].Formula[] \as WholeFormula;
\import Modules.Alternating[V := Chains.Carrier p, space := Chains.space p].Concatenation[] \as WholeSigns;
\import WholeSigns.Mapping[W := TargetDegree.Carrier p, target := TargetDegree.space p] \as SignMapping;
\import Modules.Alternating[V := TargetDegree.Carrier p, space := TargetDegree.space p].Concatenation[] \as Signs;
\import FirstComparison.Commutes[] \as Commutes;
\import FirstPair.Comparison[n := N.Nat^::succ q] \as HigherComparison;
\import \root.Integral[A := A, source := source].At[p := p, q := N.Nat^::succ q] \as WholeRight;
\import Modules.Hom[V := Chains.Carrier Geometry.higher, W := Chains.Carrier p, source := Chains.space Geometry.higher, target := Chains.space p] \as WholeMaps;
\definition law: \forall (beta: FirstCochains.Carrier (I.Int^::ofNat q))(x: SourceDegree.Carrier Geometry.higher) ->
  (Lower.map beta).apply ((SourceDegree.boundary Geometry.total).apply x) =
  (TargetDegree.space p).add ((TargetDegree.boundary p).apply ((Upper.map beta).apply (SourceDegree.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)))
    (Signs.twist p ((Right.map ((FirstCochains.complex.differential).apply (I.Int^::ofNat q) beta)).apply x)) :=
  \fun (beta: FirstCochains.Carrier (I.Int^::ofNat q)) => SourceQ.induction (\fun (x: SourceDegree.Carrier Geometry.higher) =>
    (Lower.map beta).apply ((SourceDegree.boundary Geometry.total).apply x) =
    (TargetDegree.space p).add ((TargetDegree.boundary p).apply ((Upper.map beta).apply (SourceDegree.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)))
      (Signs.twist p ((Right.map ((FirstCochains.complex.differential).apply (I.Int^::ofNat q) beta)).apply x)))
    (\fun (x: Extension.Carrier (I.Int^::ofNat Geometry.higher)) => eq_reason_in!{{TargetDegree.Carrier p} _
      "=" _ "by" { congr!{{SourceDegree.Carrier Geometry.total} {TargetDegree.Carrier p}} ((Lower.map beta).apply) _ _ (SourceDegree.boundaryOnClass Geometry.total x) }
      "=" _ "by" { Lower.onClass beta (Extension.Positive[n := Geometry.total].intro ((Chains.boundary Geometry.total).apply x)) }
      "=" _ "by" { congr!{{Chains.Carrier p} {TargetDegree.Carrier p}} (TargetDegree.class p) _ _ (WholeFormula.law (FirstComparison.from beta) x) }
      "=" _ "by" { (TargetDegree.projection p).addition ((WholeFormula.left (FirstComparison.from beta)).apply x) ((WholeFormula.signedRight (FirstComparison.from beta)).apply x) }
      "=" _ "by" { congr!{{TargetDegree.Carrier p} {TargetDegree.Carrier p} {TargetDegree.Carrier p}} ((TargetDegree.space p).add) _ _ _ _
        (trans!{{TargetDegree.Carrier p}} _ _ _
          (sym!{{TargetDegree.Carrier p}} _ _ (TargetDegree.boundaryOnClass p ((WholeUpper.map (FirstComparison.from beta)).apply (ChainDegrees.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x))))
          (trans!{{TargetDegree.Carrier p}} _ _ _
            (congr!{{TargetDegree.Carrier (N.Nat^::succ p)} {TargetDegree.Carrier p}} ((TargetDegree.boundary p).apply) _ _
              (sym!{{TargetDegree.Carrier (N.Nat^::succ p)}} _ _ (Upper.onClass beta (Extension.Positive[n := Geometry.leftDegree].intro (ChainDegrees.apply Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)))))
            (congr!{{SourceDegree.Carrier Geometry.leftDegree} {TargetDegree.Carrier p}} (\fun (z: SourceDegree.Carrier Geometry.leftDegree) => (TargetDegree.boundary p).apply ((Upper.map beta).apply z)) _ _
              (sym!{{SourceDegree.Carrier Geometry.leftDegree}} _ _ (SourceDegree.onClass Geometry.higher Geometry.leftDegree (sym!{N.Nat^} _ _ Geometry.same) x)))))
        (trans!{{TargetDegree.Carrier p}} _ _ _ (SignMapping.law (TargetDegree.projection p) p ((WholeFormula.right (FirstComparison.from beta)).apply x))
          (congr!{{TargetDegree.Carrier p} {TargetDegree.Carrier p}} (Signs.twist p) _ _
            (trans!{{TargetDegree.Carrier p}} _ _ _
              (congr!{{Cochains.Carrier (N.Nat^::succ q)} {TargetDegree.Carrier p}} (\fun (gamma: Cochains.Carrier (N.Nat^::succ q)) => TargetDegree.class p ((WholeRight.map gamma).apply x)) _ _ (sym!{{Cochains.Carrier (N.Nat^::succ q)}} _ _ (Commutes.law beta)))
              (sym!{{TargetDegree.Carrier p}} _ _ (Right.onClass ((FirstCochains.complex.differential).apply (I.Int^::ofNat q) beta) (Extension.Positive[n := Geometry.higher].intro x)))))) }
    });
