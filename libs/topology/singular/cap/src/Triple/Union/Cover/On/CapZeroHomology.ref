\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import \parent.SmallDegree[] \as Degree;
\import SecondCap.Degree[] \as TargetDegree;
\import \parent.Cap[p := N.Nat^::zero, q := q] \as Cap;
\import \parent.Cap[p := N.Nat^::succ N.Nat^::zero, q := q] \as Upper;
\import \parent.CapBoundary[p := N.Nat^::zero, q := q] \as Boundary;
\import \root.Integral[A := A, source := source].At[p := N.Nat^::zero, q := q] \as WholeCap;
\import singular_cohomology.Simplices[A := A, source := source].CutFaces[p := N.Nat^::zero, q := q] \as Geometry;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import Nonnegative.ZeroExtension[C := Small.complex] \as SmallExtension;
\import Nonnegative.ZeroExtension[C := Chains.complex] \as WholeExtension;
\import Nonnegative.Map[C := Small.complex, D := Chains.complex].ZeroExtension[f := inclusion] \as SmallMap;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.Quotient[C := SmallExtension.complex, D := WholeExtension.complex].On[f := SmallMap.map] \as Q;
\import Complexes.At[C := Q.complex, z := I.Int^::ofNat WholeCap.total] \as Source;
\import Complexes.At[C := Second.complex, z := I.Int^::ofNat N.Nat^::zero] \as Target;
\import std.Logic[].Equality[].Transport[A := I.Int^] \as Transport;
\definition sourcePrior: \forall (y: Degree.Carrier (N.Nat^::succ WholeCap.total)) -> (Source.prior).apply y = (Degree.boundary WholeCap.total).apply y :=
  \fun (y: Degree.Carrier (N.Nat^::succ WholeCap.total)) => Transport.castRefl Q.complex.family.Carrier (I.Int^::ofNat WholeCap.total) ((Degree.boundary WholeCap.total).apply y);
\definition targetPrior: \forall (y: TargetDegree.Carrier (N.Nat^::succ N.Nat^::zero)) -> (Target.prior).apply y = (TargetDegree.boundary N.Nat^::zero).apply y :=
  \fun (y: TargetDegree.Carrier (N.Nat^::succ N.Nat^::zero)) => Transport.castRefl Second.complex.family.Carrier (I.Int^::ofNat N.Nat^::zero) ((TargetDegree.boundary N.Nat^::zero).apply y);
\module On(beta: FirstCochains.Carrier (I.Int^::ofNat q), closed: Boundary.closed beta);
