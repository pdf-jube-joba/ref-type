\import topology.Topology[Carrier := A].Subspace[S := S] \as PartSpace;
\import singular_cohomology.Relative[A := A, source := source, subset := S] \as Part;
\import \root.CochainPair[A := A, source := source, subset := S, R := I.Int^, ring := Integers.commutativeRing] \as PartPair;
\import singular_cohomology.Simplices[A := Part.SubspaceCarrier, source := PartSpace.topology source] \as PartSimplices;
\import singular_cohomology.Maps[A := Part.SubspaceCarrier, B := A, source := PartSpace.topology source, target := source] \as PartMaps;
\import singular_products.Cochains[A := Part.SubspaceCarrier, source := PartSpace.topology source, R := I.Int^, ring := Integers.commutativeRing].Pullback[B := A, target := source] \as Pull;
\import topology.Continuity[A := Simplex.Carrier n, B := A].Corestriction[S := S] \as Corestrict;
\definition function[sigma: SmallSimplices.Carrier n][contained: \forall (x: Simplex.Carrier n) -> \In[A] S (sigma x)][x: Simplex.Carrier n]: Part.SubspaceCarrier :=
  \into[A](sigma x, S) \by { contained x };
\definition simplex[sigma: SmallSimplices.Carrier n][contained: \forall (x: Simplex.Carrier n) -> \In[A] S (sigma x)]: PartSimplices.Carrier n :=
  \into[PartSimplices.At[n := n].Function](function sigma contained, PartSimplices.Carrier n) \by {
    Corestrict.corestrictContinuous Domain.topology source (function sigma contained) (WholeSimplices.At[n := n].continuous (embedded sigma))
  };
\definition same: \forall (sigma: SmallSimplices.Carrier n)(contained: \forall (x: Simplex.Carrier n) -> \In[A] S (sigma x)) ->
  PartMaps.postcompose n Part.inclusion Part.inclusionContinuous (simplex sigma contained) = embedded sigma :=
  \fun (sigma: SmallSimplices.Carrier n)(contained: _) => \axiom:funext(PartMaps.postcompose n Part.inclusion Part.inclusionContinuous (simplex sigma contained), embedded sigma,
    \fun (x: Simplex.Carrier n) => \refl(sigma x));
\definition vanishes: \forall (h: Cochains.Carrier n) -> PartPair.Vanishes n h ->
  \forall (sigma: SmallSimplices.Carrier n)(contained: \forall (x: Simplex.Carrier n) -> \In[A] S (sigma x)) ->
  (h).apply ((inclusion).apply n (Small.generator n sigma)) = (Cochains.integerCoefficients.space).zero :=
  \fun (h: Cochains.Carrier n)(zero: _)(sigma: SmallSimplices.Carrier n)(contained: _) => eq_reason_in!{I.Int^ _
    "=" _ "by" { congr!{{Chains.Carrier n} I.Int^} ((h).apply) _ _ (onGenerator sigma) }
    "=" _ "by" { congr!{{WholeSimplices.Carrier n} I.Int^} (\fun (s: WholeSimplices.Carrier n) => (h).apply (Chains.generator n s)) _ _ (sym!{{WholeSimplices.Carrier n}} _ _ (same sigma contained)) }
    "=" _ "by" { sym!{I.Int^} _ _ (Pull.onSimplex n Part.inclusion Part.inclusionContinuous h (simplex sigma contained)) }
    "=" _ "by" { congr!{{singular_products.Cochains[A := Part.SubspaceCarrier, source := PartSpace.topology source, R := I.Int^, ring := Integers.commutativeRing].Carrier n} I.Int^}
      (\fun (f: singular_products.Cochains[A := Part.SubspaceCarrier, source := PartSpace.topology source, R := I.Int^, ring := Integers.commutativeRing].Carrier n) => (f).apply (singular_cohomology.Chains[A := Part.SubspaceCarrier, source := PartSpace.topology source].generator n (simplex sigma contained))) _ _ zero }
  };
\import singular_cohomology.Chains[A := Part.SubspaceCarrier, source := PartSpace.topology source] \as PartChains;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import Nonnegative.ZeroExtension[C := PartChains.complex] \as PartExtension;
\import Nonnegative.ZeroExtension[C := Chains.complex] \as WholeExtension;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as IntegerChains;
\import IntegerChains.Quotient[C := PartExtension.complex, D := WholeExtension.complex].On[f := Part.inclusionMap].At[k := I.Int^::ofNat n] \as Q;
\import IntegerChains.Map[C := PartExtension.complex, D := WholeExtension.complex].At[k := I.Int^::ofNat n] \as InclusionAt;
\import Modules.Of[V := WholeExtension.Carrier (I.Int^::ofNat n), space := WholeExtension.space (I.Int^::ofNat n)].Submodule[].Image[U := PartExtension.Carrier (I.Int^::ofNat n), source := PartExtension.space (I.Int^::ofNat n)] \as Images;
\definition image: \forall (sigma: SmallSimplices.Carrier n)(contained: \forall (x: Simplex.Carrier n) -> \In[A] S (sigma x)) ->
  \In[WholeExtension.Carrier (I.Int^::ofNat n)] (Q.image).carrier (WholeExtension.Positive[n := n].intro ((inclusion).apply n (Small.generator n sigma))) :=
  \fun (sigma: SmallSimplices.Carrier n)(contained: _) => Images.introduce (InclusionAt.linear Part.inclusionMap) _
    (PartExtension.Positive[n := n].intro (PartChains.generator n (simplex sigma contained)))
    (congr!{{Chains.Carrier n} {WholeExtension.Carrier (I.Int^::ofNat n)}} WholeExtension.Positive[n := n].intro _ _ (eq_reason_in!{{Chains.Carrier n} _
      "=" _ "by" { PartMaps.At[n := n].onGenerator Part.inclusion Part.inclusionContinuous (simplex sigma contained) }
      "=" _ "by" { congr!{{WholeSimplices.Carrier n} {Chains.Carrier n}} (Chains.generator n) _ _ (same sigma contained) }
      "=" _ "by" { sym!{{Chains.Carrier n}} _ _ (onGenerator sigma) }
    }));
