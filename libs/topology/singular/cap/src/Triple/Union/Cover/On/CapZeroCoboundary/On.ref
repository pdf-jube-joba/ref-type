\import \parent.\parent.CapZeroHomology[q := N.Nat^::succ r] \as H;
\import \parent.\parent.CapBoundary[p := N.Nat^::zero, q := N.Nat^::succ r] \as Closed;
\definition closed: Closed.closed ((FirstCochains.complex.differential).apply (I.Int^::ofNat r) gamma) := (FirstCochains.complex.laws).squareZero (I.Int^::ofNat r) gamma;
\import H.On[beta := (FirstCochains.complex.differential).apply (I.Int^::ofNat r) gamma, closed := closed] \as Action;
\import Action.Induced[] \as Induced;
\import Modules.Of[V := TargetDegree.Carrier N.Nat^::zero, space := TargetDegree.space N.Nat^::zero].Submodule[] \as Submodules;
\import Submodules.Image[U := TargetDegree.Carrier (N.Nat^::succ N.Nat^::zero), source := TargetDegree.space (N.Nat^::succ N.Nat^::zero)] \as Images;
\definition onCycle: \forall (x: Source.Cycle) -> Target.classOf (Action.cycle x) = (Target.homologySpace).zero :=
  \fun (x: Source.Cycle) => Target.boundaryClassZero (Action.cycle x)
    (Images.introduce Target.prior (Action.cycle x) ((TargetDegree.space (N.Nat^::succ N.Nat^::zero)).neg (witness gamma x))
      (trans!{{TargetDegree.Carrier N.Nat^::zero}} _ _ _ (H.targetPrior ((TargetDegree.space (N.Nat^::succ N.Nat^::zero)).neg (witness gamma x))) (boundary gamma x)));
\definition law: \forall (x: Source.Homology) -> (Induced.map).apply x = (Target.homologySpace).zero :=
  Source.classInduction (\fun (x: Source.Homology) => (Induced.map).apply x = (Target.homologySpace).zero)
    (\fun (x: Source.Cycle) => trans!{Target.Homology} _ _ _ (Induced.onClass x) (onCycle x));
