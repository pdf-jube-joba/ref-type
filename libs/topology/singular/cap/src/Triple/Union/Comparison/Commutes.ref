\import \parent.\parent.Comparison[n := N.Nat^::succ n] \as Higher;
\import UnionComparison.Commutes[] \as Native;
\definition law: \forall (h: RelativeCochains.Carrier (I.Int^::ofNat n)) ->
  Higher.apply ((RelativeCochains.complex.differential).apply (I.Int^::ofNat n) h) = Common.differential (apply h) := Native.law;
