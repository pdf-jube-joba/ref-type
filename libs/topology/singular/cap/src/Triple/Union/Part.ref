\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import topology.Topology[Carrier := A].Subspace[S := S] \as PartSpace;
\import singular_cohomology.Relative[A := A, source := source, subset := S] \as Part;
\import \root.CochainPair[A := A, source := source, subset := S, R := I.Int^, ring := Integers.commutativeRing] \as PartPair;
\definition intoUnion[x: Part.SubspaceCarrier]: Relative.SubspaceCarrier :=
  \into[A](x, subset) \by { contained x (\bysub(A, S, x)) };
\import topology.Continuity[A := Part.SubspaceCarrier, B := A].Corestriction[S := subset] \as Corestrict;
\definition continuous: topology.Continuity[A := Part.SubspaceCarrier, B := Relative.SubspaceCarrier].Continuous
  (PartSpace.topology source) (Space.topology source) intoUnion :=
  Corestrict.corestrictContinuous (PartSpace.topology source) source intoUnion Part.inclusionContinuous;
\import singular_cohomology.Maps[A := Part.SubspaceCarrier, B := Relative.SubspaceCarrier, source := PartSpace.topology source, target := Space.topology source] \as IntoMaps;
\import singular_cohomology.Maps[A := Part.SubspaceCarrier, B := A, source := PartSpace.topology source, target := source] \as PartMaps;
\import singular_cohomology.Maps[A := Relative.SubspaceCarrier, B := A, source := Space.topology source, target := source] \as UnionMaps;
\import singular_cohomology.Simplices[A := Part.SubspaceCarrier, source := PartSpace.topology source] \as PartSimplices;
\import singular_cohomology.Simplices[A := Relative.SubspaceCarrier, source := Space.topology source] \as UnionSimplices;
\import singular_cohomology.Chains[A := Part.SubspaceCarrier, source := PartSpace.topology source] \as PartChains;
\import singular_cohomology.Chains[A := Relative.SubspaceCarrier, source := Space.topology source] \as UnionChains;
\import singular_products.Cochains[A := Part.SubspaceCarrier, source := PartSpace.topology source, R := I.Int^, ring := Integers.commutativeRing] \as PartCochains;
\import PartCochains.Pullback[B := A, target := source] \as PartPull;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := UnionChains.complex] \as UnionExtension;
\module At(n: N.Nat^);
