\import Cochains.Cup[p := p, q := q] \as Whole;
\import FirstPair.RelativeCup[p := p, q := q] \as FirstProduct;
\import SecondPair.RelativeCup[p := p, q := q] \as SecondProduct;
\import FirstPair.Comparison[n := p] \as FirstComparison;
\import SecondPair.Comparison[n := q] \as SecondComparison;
\definition total: N.Nat^ := Whole.total;
\definition inFirst[alpha: FirstCochains.Carrier (I.Int^::ofNat p)][beta: SecondCochains.Carrier (I.Int^::ofNat q)]: FirstCochains.Carrier (I.Int^::ofNat total) :=
  FirstProduct.left alpha (SecondComparison.from beta);
\definition inSecond[alpha: FirstCochains.Carrier (I.Int^::ofNat p)][beta: SecondCochains.Carrier (I.Int^::ofNat q)]: SecondCochains.Carrier (I.Int^::ofNat total) :=
  SecondProduct.right (FirstComparison.from alpha) beta;
