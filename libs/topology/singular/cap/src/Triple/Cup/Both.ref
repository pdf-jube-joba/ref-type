\import FirstPair.Cup[p := p, q := q] \as FirstVanishing;
\import SecondPair.Cup[p := p, q := q] \as SecondVanishing;
\import \root.Triple[A := A, source := source, first := first, second := second].Common[n := total] \as Common;
\definition Carrier: \Set := Common.Carrier;
\definition product[alpha: FirstCochains.Carrier (I.Int^::ofNat p)][beta: SecondCochains.Carrier (I.Int^::ofNat q)]: Carrier :=
  \into[Cochains.Carrier total](Whole.apply (FirstComparison.from alpha) (SecondComparison.from beta), { h: Cochains.Carrier total \where Common.Conditions[h] }) \by {
    Common.Conditions[Whole.apply (FirstComparison.from alpha) (SecondComparison.from beta)] {
      first := \bysub(Cochains.Carrier total, { h: Cochains.Carrier total \where FirstPair.Vanishes total h }, FirstVanishing.left (FirstComparison.from alpha) (SecondComparison.from beta)),
      second := \bysub(Cochains.Carrier total, { h: Cochains.Carrier total \where SecondPair.Vanishes total h }, SecondVanishing.right (FirstComparison.from alpha) (SecondComparison.from beta)),
    }
  };
\module Closed;
