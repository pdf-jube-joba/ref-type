\import FirstProduct.Closed[] \as FirstClosed;
\import SecondProduct.Closed[] \as SecondClosed;
\definition firstLaw: \forall (alpha: FirstCochains.Carrier (I.Int^::ofNat p))(beta: SecondCochains.Carrier (I.Int^::ofNat q)) ->
  (FirstCochains.complex.differential).apply (I.Int^::ofNat p) alpha = (FirstCochains.space (I.Int^::ofNat (N.Nat^::succ p))).zero ->
  (SecondCochains.complex.differential).apply (I.Int^::ofNat q) beta = (SecondCochains.space (I.Int^::ofNat (N.Nat^::succ q))).zero ->
  (FirstCochains.complex.differential).apply (I.Int^::ofNat total) (inFirst alpha beta) = (FirstCochains.space (I.Int^::ofNat (N.Nat^::succ total))).zero :=
  \fun (alpha: FirstCochains.Carrier (I.Int^::ofNat p))(beta: SecondCochains.Carrier (I.Int^::ofNat q))(aClosed: _)(bClosed: _) =>
    FirstClosed.leftLaw alpha (SecondComparison.from beta) aClosed (SecondClosed.rightUnderlying beta bClosed);
\definition secondLaw: \forall (alpha: FirstCochains.Carrier (I.Int^::ofNat p))(beta: SecondCochains.Carrier (I.Int^::ofNat q)) ->
  (FirstCochains.complex.differential).apply (I.Int^::ofNat p) alpha = (FirstCochains.space (I.Int^::ofNat (N.Nat^::succ p))).zero ->
  (SecondCochains.complex.differential).apply (I.Int^::ofNat q) beta = (SecondCochains.space (I.Int^::ofNat (N.Nat^::succ q))).zero ->
  (SecondCochains.complex.differential).apply (I.Int^::ofNat total) (inSecond alpha beta) = (SecondCochains.space (I.Int^::ofNat (N.Nat^::succ total))).zero :=
  \fun (alpha: FirstCochains.Carrier (I.Int^::ofNat p))(beta: SecondCochains.Carrier (I.Int^::ofNat q))(aClosed: _)(bClosed: _) =>
    SecondClosed.rightLaw (FirstComparison.from alpha) beta (FirstClosed.leftUnderlying alpha aClosed) bClosed;
