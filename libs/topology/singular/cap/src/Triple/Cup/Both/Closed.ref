\import FirstProduct.Closed[] \as FirstClosed;
\import SecondProduct.Closed[] \as SecondClosed;
\import Whole.Closed[] \as WholeClosed;
\import \root.Triple[A := A, source := source, first := first, second := second].CommonComplex[] \as CommonComplex;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as IntegerComplexes;
\import IntegerComplexes.At[C := FirstCochains.complex, z := I.Int^::ofNat p] \as FirstInput;
\import IntegerComplexes.At[C := SecondCochains.complex, z := I.Int^::ofNat q] \as SecondInput;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring].At[C := CommonComplex.complex, k := total] \as Output;
\definition cycle[alpha: FirstInput.Closed][beta: SecondInput.Closed]: Output.CycleCarrier :=
  Output.cycle (product alpha beta) (WholeClosed.law (FirstComparison.from alpha) (SecondComparison.from beta)
    (FirstClosed.leftUnderlying alpha (\bysub(FirstCochains.Carrier (I.Int^::ofNat p), FirstInput.cycles.carrier, alpha)))
    (SecondClosed.rightUnderlying beta (\bysub(SecondCochains.Carrier (I.Int^::ofNat q), SecondInput.cycles.carrier, beta))));
\definition onCycles[alpha: FirstInput.Closed][beta: SecondInput.Closed]: Output.Cohomology := Output.classOf (cycle alpha beta);
