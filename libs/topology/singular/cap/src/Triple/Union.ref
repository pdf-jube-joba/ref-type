\import std.Logic[].Proposition[] \as Logic;
\import topology.Topology[Carrier := A] \as Top;
\definition subset: \Pow A := { x: A \where Logic.Or[\In[A] first x, \In[A] second x] };
\import singular_cohomology.Relative[A := A, source := source, subset := subset] \as Relative;
\import topology.Topology[Carrier := A].Subspace[S := subset] \as Space;
\import Relative.With[coefficients := Cochains.integerCoefficients] \as RelativeCochains;
\import \root.CochainPair[A := A, source := source, subset := subset, R := I.Int^, ring := Integers.commutativeRing] \as Pair;
\module Part(S: \Pow A, contained: \forall (x: A) -> \In[A] S x -> \In[A] subset x);
\module Comparison(n: N.Nat^);
