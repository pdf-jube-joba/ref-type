\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import Modules.Laws[V := I.Int^, space := Cochains.coefficients.space] \as Laws;
\import module_theory.Module[].IntegerGroup[Carrier := I.Int^, group := Laws.additive] \as Canonical;
\import algebra.Hom[A := I.Int^, B := I.Int^] \as Maps;
\definition native[x: I.Int^]: Canonical.IntegerMap :=
  \into[I.Int^ -> I.Int^](\fun (a: I.Int^) => (Cochains.coefficients.space).smul a x, Canonical.IntegerMap) \by {
    Maps.MonoidLaws[Canonical.integerDomain, Canonical.target, \fun (a: I.Int^) => (Cochains.coefficients.space).smul a x] {
      unit := Laws.zeroScale x,
      operation := \fun (a, b: I.Int^) => (Cochains.coefficients.space).scalarAdd a b x,
    }
  };
\definition equal: \forall (a, x: I.Int^) -> (Cochains.coefficients.space).smul a x = (Cochains.integerCoefficients.space).smul a x :=
  \fun (a, x: I.Int^) => congr!{{I.Int^ -> I.Int^} I.Int^} (\fun (f: I.Int^ -> I.Int^) => f a) _ _
    (Canonical.generatorExt (native x) (Canonical.integerMap x)
      (trans!{I.Int^} _ _ _ ((Cochains.coefficients.space).scalarOne x) (sym!{I.Int^} _ _ (Canonical.scalarOne x))));
