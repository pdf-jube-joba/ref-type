\definition degree: I.Int^ := I.Int^::ofNat (N.Nat^::succ k);
\import Modules.Isomorphism[V := Groups.homology n (I.Int^::ofNat k), W := Disk.Homology[z := degree].Carrier,
  source := Groups.space n (I.Int^::ofNat k), target := Disk.Homology[z := degree].space].Vanishing[] \as Transport;
\definition zero: Logic.Not (n = k) -> \forall (q: Disk.Homology[z := degree].Carrier) -> q = (Disk.Homology[z := degree].space).zero :=
  \fun (different: _) => Transport.targetZero (Native.Degree[z := degree].isomorphism) (\parent.\parent.SphereVanishing[].zero n k different);
