\import algebraic_topology.Euclidean[].Dimension[n := d] \as Model;
\import \parent.\parent.At[n := d] \as Disk;
\definition degree: I.Int^ := I.Int^::ofNat N.Nat^::zero;
\definition Iso: \Set := Modules.Isomorphism[V := I.Int^, W := Disk.Homology[z := degree].Carrier,
  source := Modules.scalarModule, target := Disk.Homology[z := degree].space].Isomorphism;
\definition diagonal: Modules.Isomorphism[V := I.Int^, W := Disk.Homology[z := I.Int^::ofNat d].Carrier,
  source := Modules.scalarModule, target := Disk.Homology[z := I.Int^::ofNat d].space].Isomorphism := orientation d;
\definition orientation[same: d = N.Nat^::zero]: Iso :=
  \idelim d = N.Nat^::zero \with k: N.Nat^ => Modules.Isomorphism[V := I.Int^, W := Disk.Homology[z := I.Int^::ofNat k].Carrier,
    source := Modules.scalarModule, target := Disk.Homology[z := I.Int^::ofNat k].space].Isomorphism \by {
      base: diagonal, equality: same
    };
\module Point(p: Model.Disk);
\definition Property: \Prop := \forall (same: d = N.Nat^::zero)(p: Model.Disk) ->
  ((orientation same).forward).apply I.One.specification = Point[p := p].class;
