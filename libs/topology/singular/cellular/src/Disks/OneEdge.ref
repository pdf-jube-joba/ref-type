\module At(d: N.Nat^);
\import \parent.One[].Edge[] \as Edge;
\import \parent.One[] \as One;
\import \root.DiskRelative[n := N.Nat^::zero] \as DiskOne;
\definition value[same: n = N.Nat^::succ N.Nat^::zero]: At[d := n].Data :=
  \idelim N.Nat^::succ N.Nat^::zero = n \with d: N.Nat^ =>
    At[d := d].Data \by {
      base: At[d := N.Nat^::succ N.Nat^::zero].Data {
        edge := Edge.edge, sphere := DiskOne.homeomorphism, boundary := Edge.boundary,
        cycle := Edge.RelativeCycle[].cycle, lifted := \refl(Edge.RelativeCycle[].value),
        fundamental := \fun (e: N.Nat^::succ N.Nat^::zero = N.Nat^::succ N.Nat^::zero) =>
          trans!{{\parent.At[n := N.Nat^::succ N.Nat^::zero].Homology[z := I.Int^::ofNat (N.Nat^::succ N.Nat^::zero)].Carrier}} _ _ _
          (Edge.RelativeCycle[].fundamental)
          (congr!{{At[d := N.Nat^::succ N.Nat^::zero].Iso}
            {\parent.At[n := N.Nat^::succ N.Nat^::zero].Homology[z := I.Int^::ofNat (N.Nat^::succ N.Nat^::zero)].Carrier}}
            (\fun (orientation: At[d := N.Nat^::succ N.Nat^::zero].Iso) => ((orientation).forward).apply I.One.specification) _ _
            (sym!{{At[d := N.Nat^::succ N.Nat^::zero].Iso}} _ _
              (\transporteq N.Nat^::succ N.Nat^::zero \with k: N.Nat^ =>
                Modules.Isomorphism[V := I.Int^, W := \parent.At[n := N.Nat^::succ N.Nat^::zero].Homology[z := I.Int^::ofNat k].Carrier,
                  source := Modules.scalarModule, target := \parent.At[n := N.Nat^::succ N.Nat^::zero].Homology[z := I.Int^::ofNat k].space].Isomorphism
                \by { base: One.orientation }))),
      },
      equality: sym!{N.Nat^} _ _ same
    };
