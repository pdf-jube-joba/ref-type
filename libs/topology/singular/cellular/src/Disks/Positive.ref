\import \root.DiskRelative[n := n] \as Native;
\import \parent.At[n := N.Nat^::succ n] \as Disk;
\import cohomology_models.Spheres[].Homology[].Reduced[] \as Groups;
\module Degree(k: N.Nat^);
\module First;
\definition zero: \forall (k: N.Nat^) -> Logic.Not (N.Nat^::succ n = k) -> Vanishing (N.Nat^::succ n) k :=
  \induction (k: N.Nat^) \return Logic.Not (N.Nat^::succ n = k) -> Vanishing (N.Nat^::succ n) k \with {
    | zero: \fun (different: _) => First[].zero
    | succ: \fun (k: N.Nat^)(previous: _)(different: _) => Degree[k := k].zero
      (\fun (same: n = k) => different (congr!{N.Nat^ N.Nat^} N.Nat^::succ _ _ same))
  };
