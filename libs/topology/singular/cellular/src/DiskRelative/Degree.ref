\import chain_complexes.Chain[] \as Degrees;
\definition previous: I.Int^ := Degrees.previous z;
\import Pair.Reduced[].ConnectingContractible[].Homology[z := z] \as Connecting;
\import Sphere.At[z := previous] \as SphereH;
\import NestedSphere.At[z := previous] \as BoundaryH;
\definition connecting: Modules.Isomorphism[V := Pair.Homology[z := z].Carrier, W := BoundaryH.Carrier,
  source := Pair.Homology[z := z].space, target := BoundaryH.space].Isomorphism := Connecting.isomorphism (Model.Contraction[].contraction);
\import Modules.Isomorphism[V := Pair.Homology[z := z].Carrier, W := BoundaryH.Carrier,
  source := Pair.Homology[z := z].space, target := BoundaryH.space].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := SphereH.Carrier, W := BoundaryH.Carrier, source := SphereH.space, target := BoundaryH.space]
  .Composition[U := Pair.Homology[z := z].Carrier, final := Pair.Homology[z := z].space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := SphereH.Carrier, W := Pair.Homology[z := z].Carrier,
  source := SphereH.space, target := Pair.Homology[z := z].space].Isomorphism :=
  Composition.compose (Inverse.inverse connecting) (BoundaryComparison.Homology[z := previous].isomorphism equivalence);
