\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import \parent.Restricted[S := subset] \as Restriction;
\import \parent.Singular[].Decomposition[] \as WholeSum;
\import singular_cohomology.Relative[A := Carrier, source := topology, subset := subset] \as Pair;
\import Space.Subspace[S := subset] \as Subspace;
\import singular_cohomology.Chains[A := Subspace.CarrierSet, source := Subspace.topology topology] \as SubspaceChains;
\import singular_cohomology.Chains[A := Carrier, source := topology] \as WholeChains;
\import Nonnegative.ZeroExtension[C := SubspaceChains.complex] \as SubspaceExtension;
\import Nonnegative.ZeroExtension[C := WholeChains.complex] \as WholeExtension;
\import singular_cohomology.Relative[A := fibers i, source := spaces i, subset := Restriction.fiberSubset i] \as Native;
\import singular_cohomology.Chains[A := Restriction.Fiber i, source := Restriction.fiberTopology i] \as FiberSubChains;
\import singular_cohomology.Chains[A := fibers i, source := spaces i] \as FiberWholeChains;
\import Nonnegative.ZeroExtension[C := FiberSubChains.complex] \as FiberSubExtension;
\import Nonnegative.ZeroExtension[C := FiberWholeChains.complex] \as FiberWholeExtension;
\definition subCarrier[z: I.Int^]: \Set := FiberSubExtension.Carrier z;
\definition subSpace[z: I.Int^]: Modules.Space (subCarrier z) := FiberSubExtension.space z;
\definition subApply: _ := FiberSubExtension.apply;
\definition subAddition: _ := FiberSubExtension.addition;
\definition subScalar: _ := FiberSubExtension.scalar;
\definition subSquareZero: _ := (FiberSubExtension.complex.laws).squareZero;
\definition subFamily: Complexes.Family := Complexes.Family { Carrier := subCarrier, space := subSpace };
\definition subDifferential: Complexes.DifferentialData[subFamily] := Complexes.DifferentialData[subFamily] { apply := subApply };
\definition subLaws: Complexes.DifferentialLaws[subFamily, subDifferential] := Complexes.DifferentialLaws[subFamily, subDifferential] {
  addition := subAddition, scalar := subScalar, squareZero := subSquareZero,
};
\definition subcomplex: Complexes.Complex := Complexes.Complex {
  family := subFamily, differential := subDifferential, laws := subLaws,
};
\definition wholeCarrier[z: I.Int^]: \Set := FiberWholeExtension.Carrier z;
\definition wholeSpace[z: I.Int^]: Modules.Space (wholeCarrier z) := FiberWholeExtension.space z;
\definition wholeApply: _ := FiberWholeExtension.apply;
\definition wholeAddition: _ := FiberWholeExtension.addition;
\definition wholeScalar: _ := FiberWholeExtension.scalar;
\definition wholeSquareZero: _ := (FiberWholeExtension.complex.laws).squareZero;
\definition wholeFamily: Complexes.Family := Complexes.Family { Carrier := wholeCarrier, space := wholeSpace };
\definition wholeDifferential: Complexes.DifferentialData[wholeFamily] := Complexes.DifferentialData[wholeFamily] { apply := wholeApply };
\definition wholeLaws: Complexes.DifferentialLaws[wholeFamily, wholeDifferential] := Complexes.DifferentialLaws[wholeFamily, wholeDifferential] {
  addition := wholeAddition, scalar := wholeScalar, squareZero := wholeSquareZero,
};
\definition wholecomplex: Complexes.Complex := Complexes.Complex {
  family := wholeFamily, differential := wholeDifferential, laws := wholeLaws,
};
\import Complexes.Quotient[C := FiberSubExtension.complex, D := FiberWholeExtension.complex]
  .On[f := Native.inclusionMap] \as Quotient;
\definition chainCarrier[z: I.Int^]: \Set := Quotient.Carrier z;
\definition chainSpace[z: I.Int^]: Modules.Space (chainCarrier z) := Quotient.space z;
\definition chainFamily: Complexes.Family := Complexes.Family {
  Carrier := chainCarrier, space := chainSpace,
};
\definition chainDifferential: Complexes.DifferentialData[chainFamily] := Complexes.DifferentialData[chainFamily] {
  apply := \fun (z: I.Int^)(x: chainCarrier z) => (Quotient.At[k := z].differential).apply x,
};
\definition chainLaws: Complexes.DifferentialLaws[chainFamily, chainDifferential] := Complexes.DifferentialLaws[chainFamily, chainDifferential] {
  addition := \fun (z: I.Int^)(x, y: chainCarrier z) => (Quotient.At[k := z].differential).addition x y,
  scalar := \fun (z: I.Int^)(a: I.Int^)(x: chainCarrier z) => (Quotient.At[k := z].differential).scalar a x,
  squareZero := \fun (z: I.Int^)(x: chainCarrier z) => Quotient.At[k := z].squareZero x,
};
\definition chainApply: _ := (chainDifferential).apply;
\definition chainAddition: _ := (chainLaws).addition;
\definition chainScalar: _ := (chainLaws).scalar;
\definition chainSquareZero: _ := (chainLaws).squareZero;
\definition complex: Complexes.Complex := Complexes.Complex {
  family := chainFamily, differential := chainDifferential, laws := chainLaws,
};
\import Complexes.Map[C := subcomplex, D := wholecomplex] \as InclusionMaps;
\definition inclusionMap: InclusionMaps.Map := InclusionMaps.Map {
  apply := (Native.inclusionMap).apply, addition := (Native.inclusionMap).addition,
  scalar := (Native.inclusionMap).scalar, commutes := (Native.inclusionMap).commutes,
};
\import Complexes.Map[C := wholecomplex, D := complex] \as ProjectionMaps;
\definition projectionMap: ProjectionMaps.Map := ProjectionMaps.Map {
  apply := \fun (z: I.Int^) => Quotient.At[k := z].class,
  addition := \fun (z: I.Int^) => (Quotient.At[k := z].projection).addition,
  scalar := \fun (z: I.Int^) => (Quotient.At[k := z].projection).scalar,
  commutes := \fun (z: I.Int^) => Quotient.At[k := z].onClass,
};
\import Complexes.ShortExact[A := subcomplex, B := wholecomplex, C := complex] \as Exact;
\definition sequence: Exact.Sequence := Exact.Sequence {
  inclusion := inclusionMap, projection := projectionMap,
  injective := \fun (z: I.Int^)(x, y: FiberSubExtension.Carrier z)(same: _) => Native.injective z x y same,
  onto := \fun (z: I.Int^) => Quotient.At[k := z].onto,
  zero := \fun (z: I.Int^) => Quotient.At[k := z].onImage,
  kernelImage := \fun (z: I.Int^) => Quotient.At[k := z].zeroClassImage,
};
\import singular_cellular_algebra.Algebra[].RelativeSplit[A := fibers i, source := spaces i, subset := Restriction.fiberSubset i] \as Splitting;
\definition retraction[z: I.Int^]: Modules.Hom[V := wholecomplex.family.Carrier z, W := subcomplex.family.Carrier z,
  source := wholecomplex.family.space z, target := subcomplex.family.space z].Map := Splitting.retraction z;
\definition section[z: I.Int^]: Modules.Hom[V := complex.family.Carrier z, W := wholecomplex.family.Carrier z,
  source := complex.family.space z, target := wholecomplex.family.space z].Map := Splitting.At[z := z].section;
\definition retracts: \forall (z: I.Int^)(x: subcomplex.family.Carrier z) -> (retraction z).apply ((sequence.inclusion).apply z x) = x := Splitting.retracts;
\definition sectionLaw: \forall (z: I.Int^)(x: complex.family.Carrier z) -> (sequence.projection).apply z ((section z).apply x) = x :=
  \fun (z: I.Int^) => Splitting.At[z := z].sectionLaw;
\import Native.Maps[B := Carrier].Over[target := topology, targetSubset := subset] \as Maps;
\import \parent.At[i := i] \as Image;
\definition pairMap: Maps.Map := \into[fibers i -> Carrier](injection i, Maps.Map) \by {
  Maps.Laws[injection i] { continuous := Image.continuous, contained := \fun (x: Native.SubspaceCarrier) => \bysub(fibers i, Restriction.fiberSubset i, x) }
};
\import Maps.On[f := pairMap] \as Topological;
\import Topological.Integer[] \as Action;
\import Complexes.Map[C := complex, D := Pair.complex] \as RelativeMaps;
\definition relativeMap: RelativeMaps.Map := RelativeMaps.Map {
  apply := (Action.map).apply, addition := (Action.map).addition,
  scalar := (Action.map).scalar, commutes := (Action.map).commutes,
};
\import Nonnegative.Map[C := FiberSubChains.complex, D := SubspaceChains.complex].ZeroExtension[f := Topological.subspaceMap] \as Restricted;
\import Complexes.Map[C := subcomplex, D := SubspaceExtension.complex] \as RestrictedMaps;
\definition restrictedMap: RestrictedMaps.Map := RestrictedMaps.Map {
  apply := (Restricted.map).apply, addition := (Restricted.map).addition,
  scalar := (Restricted.map).scalar, commutes := (Restricted.map).commutes,
};
\import WholeSum.Canonical[].Component[i := i] \as Ambient;
\import Complexes.Map[C := wholecomplex, D := WholeExtension.complex] \as AmbientMaps;
\definition ambientMap: AmbientMaps.Map := AmbientMaps.Map {
  apply := (Ambient.map).apply, addition := (Ambient.map).addition,
  scalar := (Ambient.map).scalar, commutes := (Ambient.map).commutes,
};
\definition leftSquare: \forall (z: I.Int^)(x: subcomplex.family.Carrier z) ->
  (ambientMap).apply z ((sequence.inclusion).apply z x) = (Pair.inclusionMap).apply z ((restrictedMap).apply z x) := Action.compatible;
\definition rightSquare: \forall (z: I.Int^)(x: wholecomplex.family.Carrier z) ->
  (Pair.sequence.projection).apply z ((ambientMap).apply z x) = (relativeMap).apply z ((sequence.projection).apply z x) := (Action.Naturality[].diagram).right;
\definition Carrier[z: I.Int^]: \Set := Native.Homology[z := z].Carrier;
\definition space[z: I.Int^]: Modules.Space (Carrier z) := Native.Homology[z := z].space;

\definition projective[z: I.Int^]: Modules.Projective (Modules.Bundle { Carrier := complex.family.Carrier z, space := complex.family.space z }) := Splitting.projective z;
\definition zeroBelow: \forall (n: N.Nat^)(x: complex.family.Carrier (I.Int^::negSucc n)) -> x = (complex.family.space (I.Int^::negSucc n)).zero := Splitting.zeroBelow;
