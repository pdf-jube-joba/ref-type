\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\definition belongs[chart: Carrier]: Space.Member (\parent.At[i := (chart).index].subset) chart :=
  Logic.existsIntro[fibers ((chart).index), { p: fibers ((chart).index) \where Logic.And[
    topology.Topology[Carrier := fibers ((chart).index)].Member (topology.Topology[Carrier := fibers ((chart).index)].Whole) p,
    injection ((chart).index) p = chart] }] ((chart).point) (Logic.And[_, _]::# (\refl((chart).point)) (eta chart));
\definition indexOf: \forall (i: Index)(chart: Carrier) -> Space.Member (\parent.At[i := i].subset) chart -> (chart).index = i := \block {
  \fun (i: Index)(chart: Carrier)(member: _) \then
  \takefrom p: \Cast[fibers i] ({ p: fibers i \where Logic.And[
    topology.Topology[Carrier := fibers i].Member (topology.Topology[Carrier := fibers i].Whole) p, injection i p = chart] }) \by member \then
  \let data: Logic.And[topology.Topology[Carrier := fibers i].Member (topology.Topology[Carrier := fibers i].Whole) p, injection i p = chart] :=
    \bysub(fibers i, { p: fibers i \where Logic.And[
      topology.Topology[Carrier := fibers i].Member (topology.Topology[Carrier := fibers i].Whole) p, injection i p = chart] }, p) \then
  \return sym!{Index} _ _ (congr!{Carrier Index} (\fun (c: Carrier) => (c).index) _ _ ((data).right))
};
\definition ofIndex: \forall (i: Index)(chart: Carrier) -> (chart).index = i -> Space.Member (\parent.At[i := i].subset) chart :=
  \fun (i: Index)(chart: Carrier)(same: _) => \idelim (chart).index = i \with j: Index => Space.Member (\parent.At[i := j].subset) chart \by {
    base: belongs chart, equality: same
  };
