\use std.Logic[].Equality[].eq_reason_in;
\definition i: Index := Simplices.label sigma;
\import Simplices.On[sigma := sigma] \as Decoded;
\import \parent.\parent.\parent.Component[i := i] \as Component;
\definition value: Sum.Term[z := degree].Carrier := (Sum.Term[z := degree].Component[i := i].injection).apply (Component.generator n Decoded.simplex);
\definition forward: (Native.map).apply degree value = SmallExtension.Positive[n := n].intro (Small.generator n sigma) :=
  eq_reason_in!{{SmallExtension.Carrier degree} _
    "=" _ "by" { Native.At[z := degree].onInjection i (Component.generator n Decoded.simplex) }
    "=" _ "by" { Component.onGenerator n Decoded.simplex }
    "=" _ "by" { congr!{{SmallSimplices.Carrier n} {SmallExtension.Carrier degree}}
        (\fun (s: SmallSimplices.Carrier n) => SmallExtension.Positive[n := n].intro (Small.generator n s)) _ _ Decoded.forward }
  };
