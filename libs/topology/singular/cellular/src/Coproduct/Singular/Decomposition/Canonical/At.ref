\import Modules.Hom[V := Sum.Term[z := z].Carrier, W := WholeExtension.Carrier z,
  source := Sum.Term[z := z].space, target := WholeExtension.space z] \as Linear;
\definition first: Linear.Map := Linear.Map {
  apply := ((equivalence).forward).apply z, addition := ((equivalence).forward).addition z, scalar := ((equivalence).forward).scalar z,
};
\definition second: Linear.Map := Linear.Map { apply := (map).apply z, addition := (map).addition z, scalar := (map).scalar z };
\import Modules.DirectSum[Index := Index, family := Sum.Term[z := z].family].To[W := WholeExtension.Carrier z, target := WholeExtension.space z] \as Universal;
\definition onInjection: \forall (i: Index)(x: Sum.termCarrier i z) ->
  (first).apply ((Sum.Term[z := z].Component[i := i].injection).apply x) = (second).apply ((Sum.Term[z := z].Component[i := i].injection).apply x) :=
  \fun (i: Index)(x: Sum.termCarrier i z) => trans!{{WholeExtension.Carrier z}} _ _ _
    (congr!{{SmallExtension.Carrier z} {WholeExtension.Carrier z}} (((Comparison.equivalence).forward).apply z) _ _
      (Native.At[z := z].onInjection i x))
    (trans!{{WholeExtension.Carrier z}} _ _ _ (\parent.Component[i := i].equation z x)
      (sym!{{WholeExtension.Carrier z}} _ _ (Copair.At[z := z].onInjection i x)));
\definition equation: first = second := Universal.ext first second onInjection;
\definition law: \forall (x: Sum.Term[z := z].Carrier) -> ((equivalence).forward).apply z x = (map).apply z x :=
  \fun (x: Sum.Term[z := z].Carrier) => congr!{Linear.Map {WholeExtension.Carrier z}} (\fun (f: Linear.Map) => (f).apply x) _ _ equation;
