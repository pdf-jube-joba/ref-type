\import Modules.Free[Generators := Simplices.Carrier n].Reindex[TargetGenerators := SmallSimplices.Carrier n] \as Reindex;
\definition raw: \forall (sigma: Simplices.Carrier n) -> (nonnegativeMap).apply n (Chains.generator n sigma) =
  Small.generator n (simplex n sigma) := Reindex.onGenerator (simplex n);
\definition law: \forall (sigma: Simplices.Carrier n) -> (map).apply (I.Int^::ofNat n) (generator n sigma) =
  SmallExtension.Positive[n := n].intro (Small.generator n (simplex n sigma)) :=
  \fun (sigma: Simplices.Carrier n) =>
    congr!{{Small.Carrier n} {SmallExtension.Carrier (I.Int^::ofNat n)}} (SmallExtension.Positive[n := n].intro) _ _ (raw sigma);
