\import singular_cellular_algebra.Algebra[].ChainSumMapping[Index := Index, sourceTerms := leftTerms, targetTerms := middleTerms, maps := Sums.inclusions].At[z := z] \as Inclusion;
\import singular_cellular_algebra.Algebra[].ChainSumMapping[Index := Index, sourceTerms := middleTerms, targetTerms := rightTerms, maps := Sums.projections].At[z := z] \as Projection;
\import Modules.Hom[V := Left.Term[z := z].Carrier, W := WholeExtension.Carrier z,
  source := Left.Term[z := z].space, target := WholeExtension.space z] \as LeftMaps;
\definition leftFirst: LeftMaps.Map := LeftMaps.Map {
  apply := \fun (x: Left.Term[z := z].Carrier) => (ambientMap).apply z ((Exact.sequence.inclusion).apply z x),
  addition := \fun (x, y: Left.Term[z := z].Carrier) => trans!{{WholeExtension.Carrier z}} _ _ _
    (congr!{Middle.Term[z := z].Carrier {WholeExtension.Carrier z}} ((ambientMap).apply z) _ _ ((Exact.sequence.inclusion).addition z x y))
    ((ambientMap).addition z ((Exact.sequence.inclusion).apply z x) ((Exact.sequence.inclusion).apply z y)),
  scalar := \fun (a: I.Int^)(x: Left.Term[z := z].Carrier) => trans!{{WholeExtension.Carrier z}} _ _ _
    (congr!{Middle.Term[z := z].Carrier {WholeExtension.Carrier z}} ((ambientMap).apply z) _ _ ((Exact.sequence.inclusion).scalar z a x))
    ((ambientMap).scalar z a ((Exact.sequence.inclusion).apply z x)),
};
\import Modules.Hom[V := SubspaceExtension.Carrier z, W := WholeExtension.Carrier z, source := SubspaceExtension.space z, target := WholeExtension.space z]
  .Composition[U := Left.Term[z := z].Carrier, domain := Left.Term[z := z].space] \as LeftCompose;
\definition leftSecond: LeftMaps.Map := LeftMaps.Map {
  apply := \fun (x: Left.Term[z := z].Carrier) => (Pair.inclusionMap).apply z ((subspaceMap).apply z x),
  addition := \fun (x, y: Left.Term[z := z].Carrier) => trans!{{WholeExtension.Carrier z}} _ _ _
    (congr!{{SubspaceExtension.Carrier z} {WholeExtension.Carrier z}} ((Pair.inclusionMap).apply z) _ _ ((subspaceMap).addition z x y))
    ((Pair.inclusionMap).addition z ((subspaceMap).apply z x) ((subspaceMap).apply z y)),
  scalar := \fun (a: I.Int^)(x: Left.Term[z := z].Carrier) => trans!{{WholeExtension.Carrier z}} _ _ _
    (congr!{{SubspaceExtension.Carrier z} {WholeExtension.Carrier z}} ((Pair.inclusionMap).apply z) _ _ ((subspaceMap).scalar z a x))
    ((Pair.inclusionMap).scalar z a ((subspaceMap).apply z x)),
};
\import Modules.Hom[V := Middle.Term[z := z].Carrier, W := Pair.Carrier z, source := Middle.Term[z := z].space, target := Pair.space z] \as RightMaps;
\definition rightFirst: RightMaps.Map := RightMaps.Map {
  apply := \fun (x: Middle.Term[z := z].Carrier) => (Pair.sequence.projection).apply z ((ambientMap).apply z x),
  addition := \fun (x, y: Middle.Term[z := z].Carrier) => trans!{{Pair.Carrier z}} _ _ _
    (congr!{{WholeExtension.Carrier z} {Pair.Carrier z}} ((Pair.sequence.projection).apply z) _ _ ((ambientMap).addition z x y))
    ((Pair.sequence.projection).addition z ((ambientMap).apply z x) ((ambientMap).apply z y)),
  scalar := \fun (a: I.Int^)(x: Middle.Term[z := z].Carrier) => trans!{{Pair.Carrier z}} _ _ _
    (congr!{{WholeExtension.Carrier z} {Pair.Carrier z}} ((Pair.sequence.projection).apply z) _ _ ((ambientMap).scalar z a x))
    ((Pair.sequence.projection).scalar z a ((ambientMap).apply z x)),
};
\definition rightSecond: RightMaps.Map := RightMaps.Map {
  apply := \fun (x: Middle.Term[z := z].Carrier) => (map).apply z ((Exact.sequence.projection).apply z x),
  addition := \fun (x, y: Middle.Term[z := z].Carrier) => trans!{{Pair.Carrier z}} _ _ _
    (congr!{Right.Term[z := z].Carrier {Pair.Carrier z}} ((map).apply z) _ _ ((Exact.sequence.projection).addition z x y))
    ((map).addition z ((Exact.sequence.projection).apply z x) ((Exact.sequence.projection).apply z y)),
  scalar := \fun (a: I.Int^)(x: Middle.Term[z := z].Carrier) => trans!{{Pair.Carrier z}} _ _ _
    (congr!{Right.Term[z := z].Carrier {Pair.Carrier z}} ((map).apply z) _ _ ((Exact.sequence.projection).scalar z a x))
    ((map).scalar z a ((Exact.sequence.projection).apply z x)),
};
\module Component(i: Index);
\import Modules.DirectSum[Index := Index, family := Left.Term[z := z].family].To[W := WholeExtension.Carrier z, target := WholeExtension.space z] \as LeftUniversal;
\definition leftEquation: leftFirst = leftSecond := LeftUniversal.ext _ _ (\fun (i: Index) => Component[i := i].left);
\definition left: \forall (x: Left.Term[z := z].Carrier) ->
  (ambientMap).apply z ((Exact.sequence.inclusion).apply z x) = (Pair.inclusionMap).apply z ((subspaceMap).apply z x) :=
  \fun (x: Left.Term[z := z].Carrier) => congr!{LeftMaps.Map {WholeExtension.Carrier z}} (\fun (f: LeftMaps.Map) => (f).apply x) _ _ leftEquation;
\import Modules.DirectSum[Index := Index, family := Middle.Term[z := z].family].To[W := Pair.Carrier z, target := Pair.space z] \as RightUniversal;
\definition rightEquation: rightFirst = rightSecond := RightUniversal.ext _ _ (\fun (i: Index) => Component[i := i].right);
\definition right: \forall (x: Middle.Term[z := z].Carrier) ->
  (Pair.sequence.projection).apply z ((ambientMap).apply z x) = (map).apply z ((Exact.sequence.projection).apply z x) :=
  \fun (x: Middle.Term[z := z].Carrier) => congr!{RightMaps.Map {Pair.Carrier z}} (\fun (f: RightMaps.Map) => (f).apply x) _ _ rightEquation;
