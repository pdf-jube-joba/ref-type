\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.\parent.RelativeComponent[subset := subset, i := i] \as Fiber;
\definition left: \forall (x: Left.termCarrier i z) ->
  (leftFirst).apply ((Left.Term[z := z].Component[i := i].injection).apply x) = (leftSecond).apply ((Left.Term[z := z].Component[i := i].injection).apply x) :=
  \fun (x: Left.termCarrier i z) => eq_reason_in!{{WholeExtension.Carrier z} _
    "=" _ "by" { congr!{Middle.Term[z := z].Carrier {WholeExtension.Carrier z}} ((ambientMap).apply z) _ _ (Inclusion.onInjection i x) }
    "=" _ "by" { WholeSum.Canonical[].mapOnInjection z i ((Fiber.sequence.inclusion).apply z x) }
    "=" _ "by" { Fiber.leftSquare z x }
    "=" _ "by" { sym!{{WholeExtension.Carrier z}} _ _
          (congr!{{SubspaceExtension.Carrier z} {WholeExtension.Carrier z}} ((Pair.inclusionMap).apply z) _ _ (\parent.\parent.SubspaceComparison[].onInjection z i x)) }
  };
\definition right: \forall (x: Middle.termCarrier i z) ->
  (rightFirst).apply ((Middle.Term[z := z].Component[i := i].injection).apply x) = (rightSecond).apply ((Middle.Term[z := z].Component[i := i].injection).apply x) :=
  \fun (x: Middle.termCarrier i z) => eq_reason_in!{{Pair.Carrier z} _
    "=" _ "by" { congr!{{WholeExtension.Carrier z} {Pair.Carrier z}} ((Pair.sequence.projection).apply z) _ _ (WholeSum.Canonical[].mapOnInjection z i x) }
    "=" _ "by" { Fiber.rightSquare z x }
    "=" _ "by" { sym!{{Pair.Carrier z}} _ _
        (trans!{{Pair.Carrier z}} _ _ _
          (congr!{Right.Term[z := z].Carrier {Pair.Carrier z}} ((map).apply z) _ _ (Projection.onInjection i x))
          (Copair.At[z := z].onInjection i ((Fiber.sequence.projection).apply z x))) }
  };
