\import \parent.\parent.\parent.With[coefficients := coefficients].At[z := z] \as Original;
\import \parent.\parent.\parent.Relative[].With[coefficients := coefficients].At[z := z] \as Relative;
\import Reduced.With[coefficients := coefficients].At[z := z] \as Source;
\import Pair.With[coefficients := coefficients].At[z := z] \as Middle;
\import Modules.Isomorphism[V := Source.Carrier, W := Middle.Carrier, source := Source.space, target := Middle.space]
  .Composition[U := Original.Carrier, final := Original.space] \as Compose;
\definition isomorphism: Modules.Isomorphism[V := Source.Carrier, W := Original.Carrier, source := Source.space, target := Original.space].Isomorphism :=
  Compose.compose Relative.isomorphism (Comparison.With[coefficients := coefficients].At[z := z].isomorphism);
