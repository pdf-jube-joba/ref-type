\import \root.Disks[] \as Disks;
\import Comparison.Cell[cell := cell] \as Local;
\definition zero: Logic.Not (n = k) -> \forall (q: Comparison.localGroups.Carrier cell) -> q = (Comparison.localGroups.space cell).zero :=
  \fun (different: _) => Local.zero (Disks.offDiagonal ((cell).dimension) k
    (\fun (same: (cell).dimension = k) => different (trans!{N.Nat^} _ _ _ (sym!{N.Nat^} _ _ (Interiors.dimension cell)) same)));
