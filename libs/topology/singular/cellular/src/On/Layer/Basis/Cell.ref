\definition dimension: N.Nat^ := (cell).dimension;
\import \root.Disks[].At[n := dimension] \as Disk;
\import \root.DiskLocal[n := dimension] \as Local;
\definition orientedDisk: Modules.Isomorphism[V := I.Int^, W := Disk.Homology[z := degree].Carrier,
  source := Modules.scalarModule, target := Disk.Homology[z := degree].space].Isomorphism :=
  \idelim dimension = n \with k: N.Nat^ => Modules.Isomorphism[V := I.Int^, W := Disk.Homology[z := I.Int^::ofNat k].Carrier,
    source := Modules.scalarModule, target := Disk.Homology[z := I.Int^::ofNat k].space].Isomorphism \by {
      base: \root.Disks[].orientation dimension, equality: Interiors.dimension cell };
\import Modules.Isomorphism[V := I.Int^, W := Disk.Homology[z := degree].Carrier, source := Modules.scalarModule, target := Disk.Homology[z := degree].space]
  .Composition[U := localGroups.Carrier cell, final := localGroups.space cell] \as Composition;
\definition orientation: Modules.Isomorphism[V := I.Int^, W := localGroups.Carrier cell,
  source := Modules.scalarModule, target := localGroups.space cell].Isomorphism := Composition.compose (Local.Homology[z := degree].isomorphism) orientedDisk;
