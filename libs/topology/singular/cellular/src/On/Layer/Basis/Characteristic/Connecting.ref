\use std.Logic[].Equality[].eq_reason_in;
\definition upperDegree: I.Int^ := I.Int^::ofNat n;
\definition lowerDegree: I.Int^ := Degrees.previous upperDegree;
\import \parent.\parent.\parent.Homology[z := upperDegree] \as SourceLayer;
\import \parent.\parent.\parent.Relative[] \as Relative;
\import \parent.\parent.Cell[cell := cell] \as Orientation;
\import \parent.Oriented[] \as CharacteristicBasis;
\import \parent.\parent.\parent.\parent.Filtration[] \as Filtration;
\import Filtration.Stage[limit := n] \as Skeleton;
\import SourcePair.Maps[B := Upper.Carrier].Over[target := Upper.topology, targetSubset := Relative.subset].On[f := map] \as CharacteristicMap;
\import CharacteristicMap.Integer[] \as CharacteristicAction;
\definition diskGenerator: SourcePair.Homology[z := upperDegree].Carrier := ((Orientation.orientedDisk).forward).apply I.One.specification;
\import topology.Topology[Carrier := Model.Disk].Subspace[S := Local.boundary] \as SourceBoundary;
\import singular_cohomology.Chains[A := SourcePair.SubspaceCarrier, source := SourceBoundary.topology Model.diskTopology] \as BoundaryChains;
\import Nonnegative.ZeroExtension[C := BoundaryChains.complex] \as BoundaryExtension;
\import Complexes.At[C := BoundaryExtension.complex, z := lowerDegree] \as BoundaryH;
\definition boundaryGenerator: BoundaryH.Homology := (SourcePair.LongExact[z := upperDegree].connecting).apply diskGenerator;
\import topology.Topology[Carrier := Upper.Carrier].Subspace[S := Relative.subset] \as Nested;
\import Space.Subspace[S := Filtration.subset n].Inside[U := Filtration.subset (N.Nat^::succ n)] \as Nesting;
\definition included: Space.Subset (Filtration.subset n) (Filtration.subset (N.Nat^::succ n)) := Filtration.monotone n (N.Nat^::succ n) (Nat.leSelfSucc n);
\import singular_cellular_algebra.Algebra[].AbsoluteHomeomorphism[A := Skeleton.Carrier, B := Nested.CarrierSet,
  source := Skeleton.topology, target := Nested.topology Upper.topology, homeomorphism := Nesting.homeomorphism source included] \as Left;
\import singular_cohomology.Chains[A := Nested.CarrierSet, source := Nested.topology Upper.topology] \as NestedChains;
\import Nonnegative.ZeroExtension[C := NestedChains.complex] \as NestedExtension;
\import Complexes.At[C := NestedExtension.complex, z := lowerDegree] \as NestedH;
\import singular_cohomology.Chains[A := Skeleton.Carrier, source := Skeleton.topology] \as SkeletonChains;
\import Nonnegative.ZeroExtension[C := SkeletonChains.complex] \as SkeletonExtension;
\import Complexes.At[C := SkeletonExtension.complex, z := lowerDegree] \as SkeletonH;
\definition lowerIsomorphism: Modules.Isomorphism[V := SkeletonH.Homology, W := NestedH.Homology,
  source := SkeletonH.homologySpace, target := NestedH.homologySpace].Isomorphism :=
  Complexes.Isomorphism[C := SkeletonExtension.complex, D := NestedExtension.complex].At[z := lowerDegree].isomorphism Left.isomorphism;
\definition attaching[p: SourcePair.SubspaceCarrier]: Skeleton.Carrier := Left.backward (CharacteristicMap.restriction p);
\import topology.Composition[A := SourcePair.SubspaceCarrier, B := Nested.CarrierSet, C := Skeleton.Carrier] \as AttachTopology;
\definition attachingContinuous: topology.Continuity[A := SourcePair.SubspaceCarrier, B := Skeleton.Carrier].Continuous
  (SourceBoundary.topology Model.diskTopology) Skeleton.topology attaching :=
  AttachTopology.composeContinuous (SourceBoundary.topology Model.diskTopology) (Nested.topology Upper.topology) Skeleton.topology
    CharacteristicMap.restriction Left.backward CharacteristicMap.restrictionContinuous ((Left.laws).backwardContinuous);
\definition underlying[x: Skeleton.Carrier]: A := x;
\definition attachingValue[p: SourcePair.SubspaceCarrier]: underlying (attaching p) = (cell).characteristic p := \refl((cell).characteristic p);
\import singular_cohomology.Maps[A := SourcePair.SubspaceCarrier, B := Skeleton.Carrier,
  source := SourceBoundary.topology Model.diskTopology, target := Skeleton.topology] \as AttachingMaps;
\definition attachingMap: Complexes.Map[C := BoundaryExtension.complex, D := SkeletonExtension.complex].Map := AttachingMaps.integerPush attaching attachingContinuous;
\definition attachingAction: Modules.Hom[V := BoundaryH.Homology, W := SkeletonH.Homology, source := BoundaryH.homologySpace, target := SkeletonH.homologySpace].Map :=
  Complexes.Map[C := BoundaryExtension.complex, D := SkeletonExtension.complex].At[k := lowerDegree].induced attachingMap;
\import singular_cohomology.Maps[A := SourcePair.SubspaceCarrier, B := Nested.CarrierSet,
  source := SourceBoundary.topology Model.diskTopology, target := Nested.topology Upper.topology] \as RestrictionMaps;
\definition restrictionMap: Complexes.Map[C := BoundaryExtension.complex, D := NestedExtension.complex].Map :=
  RestrictionMaps.integerPush CharacteristicMap.restriction CharacteristicMap.restrictionContinuous;
\definition restrictionAction: Modules.Hom[V := BoundaryH.Homology, W := NestedH.Homology, source := BoundaryH.homologySpace, target := NestedH.homologySpace].Map :=
  Complexes.Map[C := BoundaryExtension.complex, D := NestedExtension.complex].At[k := lowerDegree].induced restrictionMap;
\import RestrictionMaps.Composition[C := Skeleton.Carrier, final := Skeleton.topology].Integer[] \as AttachComposition;
\import Complexes.Map[C := NestedExtension.complex, D := SkeletonExtension.complex].Composition[B := BoundaryExtension.complex] \as AttachChains;
\import Complexes.Map[C := BoundaryExtension.complex, D := SkeletonExtension.complex].At[k := lowerDegree] \as AttachInduced;
\definition attachingOnHomology[q: BoundaryH.Homology]: (attachingAction).apply q = ((lowerIsomorphism).backward).apply ((restrictionAction).apply q) :=
  trans!{SkeletonH.Homology} _ _ _
    (congr!{{Complexes.Map[C := BoundaryExtension.complex, D := SkeletonExtension.complex].Map} SkeletonH.Homology}
      (\fun (f: Complexes.Map[C := BoundaryExtension.complex, D := SkeletonExtension.complex].Map) => (AttachInduced.induced f).apply q) _ _
      (sym!{{Complexes.Map[C := BoundaryExtension.complex, D := SkeletonExtension.complex].Map}} _ _
        (AttachComposition.law CharacteristicMap.restriction CharacteristicMap.restrictionContinuous Left.backward ((Left.laws).backwardContinuous))))
    (AttachChains.At[k := lowerDegree].compositionOnHomology Left.backwardMap restrictionMap q);
\import singular_cohomology.Relative[A := Upper.Carrier, source := Upper.topology, subset := Relative.subset] \as RawPair;
\definition basisProjection: ((Relative.Homology[z := upperDegree].isomorphism).forward).apply (generator cell) =
  (CharacteristicAction.At[z := upperDegree].induced).apply diskGenerator :=
  trans!{{RawPair.Homology[z := upperDegree].Carrier}} _ _ _
    (congr!{{SourceLayer.Carrier} {RawPair.Homology[z := upperDegree].Carrier}}
      (((Relative.Homology[z := upperDegree].isomorphism).forward).apply) _ _ CharacteristicBasis.onGenerator)
    ((Relative.Homology[z := upperDegree].isomorphism).rightInverse ((CharacteristicAction.At[z := upperDegree].induced).apply diskGenerator));
\definition law: (SourceLayer.connecting).apply (generator cell) = (attachingAction).apply boundaryGenerator :=
  eq_reason_in!{SkeletonH.Homology _
    "=" _ "by" { sym!{SkeletonH.Homology} _ _ ((lowerIsomorphism).leftInverse ((SourceLayer.connecting).apply (generator cell))) }
    "=" _ "by" { congr!{NestedH.Homology SkeletonH.Homology} (((lowerIsomorphism).backward).apply) _ _
        (sym!{NestedH.Homology} _ _ (Relative.Naturality[].At[z := upperDegree].connecting (generator cell))) }
    "=" _ "by" { congr!{NestedH.Homology SkeletonH.Homology} (((lowerIsomorphism).backward).apply) _ _
          (trans!{NestedH.Homology} _ _ _
            (congr!{{RawPair.Homology[z := upperDegree].Carrier} NestedH.Homology}
              ((RawPair.LongExact[z := upperDegree].connecting).apply) _ _ basisProjection)
            (CharacteristicAction.Naturality[].At[z := upperDegree].connectingNaturality diskGenerator)) }
    "=" _ "by" { sym!{SkeletonH.Homology} _ _ (attachingOnHomology boundaryGenerator) }
  };
