\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Homology[z := degree] \as NaturalBasis;
\import \parent.\parent.Cell[cell := cell] \as Orientation;
\import \parent.\parent.\parent.Relative[].Homology[z := degree] \as RelativeComparison;
\import \parent.\parent.\parent.Homology[z := degree] \as LayerHomology;
\import singular_cohomology.Relative[A := Upper.Carrier, source := Upper.topology, subset := Punctures.Excision[].lower] \as SkeletalPair;
\import singular_cohomology.Relative[A := Mapping.targetSmall.Carrier, source := Mapping.targetSmall.topology, subset := Mapping.targetSmall.subset] \as SmallPair;
\definition image[q: Disk.Homology[z := degree].Carrier]: LayerHomology.Carrier :=
  ((RelativeComparison.isomorphism).backward).apply ((Action.At[z := degree].induced).apply q);
\definition comparison[q: LayerHomology.Carrier]: SmallPair.Homology[z := degree].Carrier :=
  ((Punctures.Excision[].Homology[z := degree].isomorphism).forward).apply (((RelativeComparison.isomorphism).forward).apply q);
\definition cancel[x, y: LayerHomology.Carrier][same: comparison x = comparison y]: x = y :=
  eq_reason_in!{LayerHomology.Carrier _
    "=" _ "by" { sym!{LayerHomology.Carrier} _ _ ((RelativeComparison.isomorphism).leftInverse x) }
    "=" _ "by" { congr!{{SkeletalPair.Homology[z := degree].Carrier} LayerHomology.Carrier} (((RelativeComparison.isomorphism).backward).apply) _ _
        (eq_reason_in!{{ SkeletalPair.Homology[z := degree].Carrier } _
          "=" _ "by" { sym!{{SkeletalPair.Homology[z := degree].Carrier}} _ _ ((Punctures.Excision[].Homology[z := degree].isomorphism).leftInverse (((RelativeComparison.isomorphism).forward).apply x)) }
          "=" _ "by" { congr!{{SmallPair.Homology[z := degree].Carrier} {SkeletalPair.Homology[z := degree].Carrier}} (((Punctures.Excision[].Homology[z := degree].isomorphism).backward).apply) _ _ same }
          "=" _ "by" { (Punctures.Excision[].Homology[z := degree].isomorphism).leftInverse (((RelativeComparison.isomorphism).forward).apply y) }
        }) }
    "=" _ "by" { (RelativeComparison.isomorphism).leftInverse y }
  };
\definition basisProjection[a: I.Int^]:
  comparison (((isomorphism).forward).apply ((Free.Injection[i := cell].map).apply a)) =
  ((ChartPair.Homology[z := degree].isomorphism).forward).apply
    ((NaturalBasis.injection).apply (((Orientation.orientation).forward).apply a)) :=
  eq_reason_in!{{SmallPair.Homology[z := degree].Carrier} _
    "=" _ "by" { congr!{{SkeletalPair.Homology[z := degree].Carrier} {SmallPair.Homology[z := degree].Carrier}}
      (((Punctures.Excision[].Homology[z := degree].isomorphism).forward).apply) _ _
      ((RelativeComparison.isomorphism).rightInverse (((Comparison.skeletal).forward).apply (((CellBasis.isomorphism).forward).apply ((Free.Injection[i := cell].map).apply a)))) }
    "=" _ "by" { (Punctures.Excision[].Homology[z := degree].isomorphism).rightInverse
        (((Comparison.excised).forward).apply (((CellBasis.isomorphism).forward).apply ((Free.Injection[i := cell].map).apply a))) }
    "=" _ "by" { congr!{LocalSum.Carrier {SmallPair.Homology[z := degree].Carrier}} (((Comparison.excised).forward).apply) _ _ (CellBasis.onInjection cell a) }
    "=" _ "by" { congr!{{singular_cohomology.Relative[A := Disks.Carrier, source := Disks.topology, subset := ChartPair.punctures].Homology[z := degree].Carrier} {SmallPair.Homology[z := degree].Carrier}}
          (((ChartPair.Homology[z := degree].isomorphism).forward).apply) _ _
          (Additivity.Cell[i := cell].onInjection (((Orientation.orientation).forward).apply a)) }
  };
\definition imageProjection[q: Disk.Homology[z := degree].Carrier]: comparison (image q) =
  ((Punctures.Excision[].Homology[z := degree].isomorphism).forward).apply ((Action.At[z := degree].induced).apply q) :=
  congr!{{SkeletalPair.Homology[z := degree].Carrier} {SmallPair.Homology[z := degree].Carrier}}
    (((Punctures.Excision[].Homology[z := degree].isomorphism).forward).apply) _ _
    ((RelativeComparison.isomorphism).rightInverse ((Action.At[z := degree].induced).apply q));
\definition onScalar[a: I.Int^]: ((isomorphism).forward).apply ((Free.Injection[i := cell].map).apply a) =
  image (((Orientation.orientedDisk).forward).apply a) := cancel _ _
    (eq_reason_in!{{SmallPair.Homology[z := degree].Carrier} _
      "=" _ "by" { basisProjection a }
      "=" _ "by" { NaturalBasis.naturality (((Orientation.orientedDisk).forward).apply a) }
      "=" _ "by" { sym!{{SmallPair.Homology[z := degree].Carrier}} _ _ (imageProjection (((Orientation.orientedDisk).forward).apply a)) }
    });
\definition onGenerator: generator cell = image (((Orientation.orientedDisk).forward).apply I.One.specification) := onScalar I.One.specification;
