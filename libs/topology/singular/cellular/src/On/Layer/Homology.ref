\import Complexes.At[C := complex, z := z] \as Relative;
\import Complexes.At[C := LowerExtension.complex, z := Degrees.previous z] \as LowerHomology;
\import Complexes.At[C := UpperExtension.complex, z := z] \as UpperHomology;
\import Complexes.Map[C := UpperExtension.complex, D := complex].At[k := z] \as Projection;
\import Exact.At[s := sequence, k := z] \as Connecting;
\definition Carrier: \Set := Relative.Homology;
\definition space: Modules.Space Carrier := Relative.homologySpace;
\definition projection: Modules.Hom[V := UpperHomology.Homology, W := Carrier,
  source := UpperHomology.homologySpace, target := space].Map := Projection.induced Quotient.projection;
\definition connecting: Modules.Hom[V := Carrier, W := LowerHomology.Homology,
  source := space, target := LowerHomology.homologySpace].Map := Connecting.connecting;
\definition projectionConnectingZero: \forall (q: UpperHomology.Homology) ->
  (connecting).apply ((projection).apply q) = (LowerHomology.homologySpace).zero :=
  Connecting.Exactness[].projectionConnectingZero;
\definition connectingInclusionZero: _ := Connecting.Exactness[].connectingInclusionZero;
\definition exactAtRelative: _ := Connecting.Exactness[].exactAtC;
\definition exactAtSubspace: _ := Connecting.Exactness[].exactAtALower;
\definition exactAtSpace: _ := Connecting.Exactness[].exactAtB;
