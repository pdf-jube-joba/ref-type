\definition degree: I.Int^ := I.Int^::negSucc k;
\import Modules.Hom[V := UpperExtension.Carrier degree, W := LowerExtension.Carrier degree, source := UpperExtension.space degree, target := LowerExtension.space degree] \as Maps;
\definition map: Maps.Map := Maps.zeroMap;
\definition retracts: \forall (x: LowerExtension.Carrier degree) -> (map).apply ((inclusion).apply degree x) = x :=
  \fun (x: LowerExtension.Carrier degree) => sym!{{LowerExtension.Carrier degree}} _ _ (LowerExtension.Negative[n := k].zero x);
