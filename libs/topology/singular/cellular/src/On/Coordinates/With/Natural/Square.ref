\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Degree[n := n] \as Lower;
\import \parent.\parent.Degree[n := N.Nat^::succ n] \as Middle;
\import \parent.\parent.Degree[n := N.Nat^::succ (N.Nat^::succ n)] \as Higher;
\definition law: \forall (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) -> apply n (apply (N.Nat^::succ n) x) = (space n).zero :=
  \fun (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) => eq_reason_in!{{Carrier n} _
    "=" _ "by" { congr!{{Chains.Carrier (N.Nat^::succ n)} {Carrier n}}
      (\fun (y: Chains.Carrier (N.Nat^::succ n)) => ((Lower.isomorphism).forward).apply ((Chains.boundary n).apply y)) _ _
      ((Middle.isomorphism).leftInverse ((Chains.boundary (N.Nat^::succ n)).apply (((Higher.isomorphism).backward).apply x))) }
    "=" _ "by" { congr!{{Chains.Carrier n} {Carrier n}} (((Lower.isomorphism).forward).apply) _ _
        ((Chains.complex.laws).squareZero n (((Higher.isomorphism).backward).apply x)) }
    "=" _ "by" { Modules.Hom[V := Chains.Carrier n, W := Carrier n, source := Chains.space n, target := space n].zeroPreserved (Lower.isomorphism).forward }
  };
