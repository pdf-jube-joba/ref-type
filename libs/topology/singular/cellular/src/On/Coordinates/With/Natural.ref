\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\definition Carrier[n: N.Nat^]: \Set := Modules.FiniteCoordinates[n := rank n].Carrier;
\definition space[n: N.Nat^]: Modules.Space (Carrier n) := Modules.FiniteCoordinates[n := rank n].space;
\definition family: Complexes.Family := Complexes.Family { Carrier := Carrier, space := space };
\definition apply[n: N.Nat^][x: Carrier (N.Nat^::succ n)]: Carrier n := (\parent.Differential[n := n].linear).apply x;
\definition differential: Complexes.DifferentialData[family] := Complexes.DifferentialData[family] { apply := apply };
\module Square(n: N.Nat^);
\definition complex: Complexes.Complex := Complexes.Complex {
  family := family, differential := differential,
  laws := Complexes.DifferentialLaws[family, differential] {
    addition := \fun (n: N.Nat^) => (\parent.Differential[n := n].linear).addition,
    scalar := \fun (n: N.Nat^) => (\parent.Differential[n := n].linear).scalar,
    squareZero := \fun (n: N.Nat^) => Square[n := n].law,
  },
};
\import Complexes.Map[C := Chains.complex, D := complex] \as Forward;
\import Complexes.Map[C := complex, D := Chains.complex] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (n: N.Nat^) => ((\parent.Degree[n := n].isomorphism).forward).apply,
  addition := \fun (n: N.Nat^) => ((\parent.Degree[n := n].isomorphism).forward).addition,
  scalar := \fun (n: N.Nat^) => ((\parent.Degree[n := n].isomorphism).forward).scalar,
  commutes := \fun (n: N.Nat^)(x: Chains.Carrier (N.Nat^::succ n)) =>
    congr!{{Chains.Carrier (N.Nat^::succ n)} {Carrier n}}
      (\fun (y: Chains.Carrier (N.Nat^::succ n)) => ((\parent.Degree[n := n].isomorphism).forward).apply ((Chains.boundary n).apply y)) _ _
      ((\parent.Degree[n := N.Nat^::succ n].isomorphism).leftInverse x),
};
\definition backward: Backward.Map := Backward.Map {
  apply := \fun (n: N.Nat^) => ((\parent.Degree[n := n].isomorphism).backward).apply,
  addition := \fun (n: N.Nat^) => ((\parent.Degree[n := n].isomorphism).backward).addition,
  scalar := \fun (n: N.Nat^) => ((\parent.Degree[n := n].isomorphism).backward).scalar,
  commutes := \fun (n: N.Nat^)(x: Carrier (N.Nat^::succ n)) => sym!{{Chains.Carrier n}} _ _
    ((\parent.Degree[n := n].isomorphism).leftInverse ((Chains.boundary n).apply (((\parent.Degree[n := N.Nat^::succ n].isomorphism).backward).apply x))),
};
\import Complexes.Isomorphism[C := Chains.complex, D := complex] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := \fun (n: N.Nat^) => (\parent.Degree[n := n].isomorphism).leftInverse,
  rightInverse := \fun (n: N.Nat^) => (\parent.Degree[n := n].isomorphism).rightInverse,
};
\import Iso.With[e := isomorphism] \as Signed;
\definition integerIsomorphism: _ := Signed.integerIsomorphism;
