\import \parent.\parent.Filtration[].CellInteriors[n := n] \as Interior;
\definition finiteMembers: \forall (family: Cells.Cells) -> Finite.Finite (Cells.members family) :=
  \induction (family: Cells.Cells) \return Finite.Finite (Cells.members family) \with {
    | nil: Finite.finiteEmpty
    | cons: \fun (cell: Cells.CellData) (tail: Cells.Cells) (finite: _) => Finite.finiteInsert cell (Cells.members tail) finite
  };
\definition listed: Finite.FiniteSubset := \into[\Pow Cells.CellData](Cells.members cells, Finite.FiniteSubsetSet) \by { finiteMembers cells };
\definition finite: Finite.FiniteSubset := Finite.filter listed ({ cell: Cells.CellData \where (cell).dimension = n });
\definition selected: \Pow Cells.CellData := Interior.Selected;
\definition same: finite = selected := \refl(selected);
\definition value: Finite.FiniteSubset := \into[\Pow Cells.CellData](selected, Finite.FiniteSubsetSet) \by {
  \idelim finite = selected \with S: \Pow Cells.CellData => Finite.Finite S \by { base: Finite.finite finite, equality: same }
};
\module On(xs: Enumerations.DistinctEnumeration[selected]);
\definition existence: \exists Enumeration n := \block {
  \takefrom xs: Enumerations.DistinctEnumeration[selected] \by Enumerations.existsDistinctEnumeration value \then
  \return \exact(On[xs := xs].enumeration, Enumeration n)
};
