\import std.Data[].ListIndex[A := Cells.CellData].Selected[S := selected].Listed[xs := xs] \as Native;
\definition data: Data[n] := Data[n] { rank := Native.rank, enumerate := Native.enumerate, index := Native.index };
\definition enumeration: Enumeration n := \into[Data[n]](data, Enumeration n) \by {
  Laws[n, data] { indexEnumerate := Native.indexEnumerate, enumerateIndex := Native.enumerateIndex }
};
