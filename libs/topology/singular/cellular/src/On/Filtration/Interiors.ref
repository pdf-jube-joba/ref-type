\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import real.Analysis[] \as Real;
\import std.Logic[].Classical[] \as Classical;
\structure Witness[limit: N.Nat^, x: A]: \Set := {
  cell: Cells.CellData,
  member: Cells.CellMember cells cell,
  below: Nat.Lt ((cell).dimension) limit,
  contains: \In[A] (Cells.InteriorImage cell) x,
};
\definition ltTrans[a, b, c: N.Nat^][ab: Nat.Lt a b][bc: Nat.Lt b c]: Nat.Lt a c :=
  Nat.ltLeTrans a b c ab (Nat.leTrans b (N.Nat^::succ b) c (Nat.leSelfSucc b) (Nat.succLeOfLt c b bc));
\definition fromPoint: \forall (limit: N.Nat^)(cell: Cells.CellData)(member: Cells.CellMember cells cell)
  (below: Nat.Lt ((cell).dimension) limit)(p: Euclidean.Disk ((cell).dimension)) ->
  \exists Witness[limit, (cell).characteristic p] :=
  \fun (limit: _)(cell: Cells.CellData)(member: _)(below: _)(p: _) =>
    either!{{(Classical.excludedMiddle (R.Lt (Euclidean.normSquaredAt ((cell).dimension) p) Real.one))}
      {\exists Witness[limit, (cell).characteristic p]}
      {\fun (inside: _) => \exact(Witness[limit, (cell).characteristic p] {
        cell := cell, member := member, below := below,
        contains := Logic.existsIntro[Euclidean.Disk ((cell).dimension),
          { q: Euclidean.Disk ((cell).dimension) \where Logic.And[
            \In[Euclidean.coordinateCarrier ((cell).dimension)] (Euclidean.interiorAt ((cell).dimension)) q,
            (cell).characteristic q = (cell).characteristic p] }] p
          (Logic.And[_, _]::# inside (\refl((cell).characteristic p))),
      }, Witness[limit, (cell).characteristic p])}
      {\block {
        \fun (outside: _) \then
        \let boundary: Euclidean.normSquaredAt ((cell).dimension) p = Real.one :=
          R.leAntisym _ _ (\bysub(Euclidean.coordinateCarrier ((cell).dimension), Euclidean.closedBallAt ((cell).dimension), p))
            (Order.leOfNotLtReverse Real.one (Euclidean.normSquaredAt ((cell).dimension) p) outside) \then
        \takefrom witness: Cells.BoundaryWitness[cells, cell, (cell).characteristic p] \by (laws).boundary cell member p boundary \then
        \return \exact(Witness[limit, (cell).characteristic p] {
          cell := (witness).other, member := (witness).member,
          below := ltTrans (((witness).other).dimension) ((cell).dimension) limit ((witness).lower) below,
          contains := (witness).contains,
        }, Witness[limit, (cell).characteristic p])
      }}
    };
\definition cover: \forall (limit: N.Nat^)(x: A) -> \In[A] (subset limit) x -> \exists Witness[limit, x] :=
  \fun (limit: _)(x: _)(member: _) => eliminate cells limit x (\exists Witness[limit, x])
    (\block {
      \fun (cell: Cells.CellData)(present: _)(below: _)(contains: _) \then
      \takefrom p: \Cast[Euclidean.Disk ((cell).dimension)]
        ({ p: Euclidean.Disk ((cell).dimension) \where (cell).characteristic p = x }) \by contains \then
      \return \idelim (cell).characteristic p = x \with a: A => \exists Witness[limit, a] \by {
        base: fromPoint limit cell present below p,
        equality: \bysub(Euclidean.Disk ((cell).dimension), { p: Euclidean.Disk ((cell).dimension) \where (cell).characteristic p = x }, p)
      }
    }) member;
\definition topBoundary: \forall (n: N.Nat^)(cell: Cells.CellData)(member: Cells.CellMember cells cell)
  (dimension: (cell).dimension = n)(p: Euclidean.Disk ((cell).dimension)) ->
  \In[A] (subset n) ((cell).characteristic p) -> Euclidean.normSquaredAt ((cell).dimension) p = Real.one := \block {
  \fun (n: _)(cell: Cells.CellData)(member: _)(dimension: _)(p: _)(lower: _) \then
  \let notInterior: Logic.Not (R.Lt (Euclidean.normSquaredAt ((cell).dimension) p) Real.one) := \block {
    \fun (inside: _) \then
    \takefrom other: Witness[n, (cell).characteristic p] \by cover n ((cell).characteristic p) lower \then
    \let same: cell = (other).cell := (laws).disjoint cell ((other).cell) member ((other).member) ((cell).characteristic p)
      (Logic.existsIntro[Euclidean.Disk ((cell).dimension),
        { q: Euclidean.Disk ((cell).dimension) \where Logic.And[
          \In[Euclidean.coordinateCarrier ((cell).dimension)] (Euclidean.interiorAt ((cell).dimension)) q,
          (cell).characteristic q = (cell).characteristic p] }] p (Logic.And[_, _]::# inside (\refl((cell).characteristic p)))) ((other).contains) \then
    \return Nat.ltIrrefl n
      (\idelim ((other).cell).dimension = n \with d: N.Nat^ => Nat.Lt d n \by {
        base: (other).below, equality: trans!{N.Nat^} _ _ _
          (congr!{Cells.CellData N.Nat^} (\fun (c: Cells.CellData) => (c).dimension) _ _ (sym!{Cells.CellData} _ _ same)) dimension
      })
  } \then
  \return R.leAntisym _ _ (\bysub(Euclidean.coordinateCarrier ((cell).dimension), Euclidean.closedBallAt ((cell).dimension), p))
    (Order.leOfNotLtReverse Real.one (Euclidean.normSquaredAt ((cell).dimension) p) notInterior)
};
