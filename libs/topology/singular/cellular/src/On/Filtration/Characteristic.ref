\definition dimension: N.Nat^ := (cell).dimension;
\import Euclidean.Dimension[n := dimension] \as Model;
\import Cells.Attach[n := dimension] \as Attachment;
\definition disk: \Set := Model.Disk;
\definition sphere: \Set := Model.Sphere;
\definition boundaryInclusion: sphere -> disk := Attachment.boundaryInclusion;
\definition image: \forall (p: disk) -> \In[A] (Cells.ClosedImage cell) ((cell).characteristic p) :=
  \fun (p: disk) => Logic.existsIntro[disk, { q: disk \where (cell).characteristic q = (cell).characteristic p }] p (\refl((cell).characteristic p));
\definition boundaryImage: \forall (p: sphere) -> \In[A] (subset dimension) ((cell).characteristic (boundaryInclusion p)) := \block {
  \fun (p: sphere) \then
  \takefrom other: Cells.BoundaryWitness[cells, cell, ((cell).characteristic (boundaryInclusion p))]
    \by (laws).boundary cell member (boundaryInclusion p) (\bysub(Model.Coordinate, Model.Boundary, p)) \then
  \takefrom point: \Cast[Euclidean.Disk (((other).other).dimension)]
    ({ q: Euclidean.Disk (((other).other).dimension) \where Logic.And[
      \In[Euclidean.coordinateCarrier (((other).other).dimension)] (Euclidean.interiorAt (((other).other).dimension)) q,
      ((other).other).characteristic q = (cell).characteristic (boundaryInclusion p)] }) \by (other).contains \then
  \return include cells dimension ((other).other) ((other).member) ((other).lower) ((cell).characteristic (boundaryInclusion p))
    (Logic.existsIntro[Euclidean.Disk (((other).other).dimension),
      { q: Euclidean.Disk (((other).other).dimension) \where ((other).other).characteristic q = (cell).characteristic (boundaryInclusion p) }]
      point ((\bysub(Euclidean.Disk (((other).other).dimension),
        { q: Euclidean.Disk (((other).other).dimension) \where Logic.And[
          \In[Euclidean.coordinateCarrier (((other).other).dimension)] (Euclidean.interiorAt (((other).other).dimension)) q,
          ((other).other).characteristic q = (cell).characteristic (boundaryInclusion p)] }, point)).right))
};
\import \parent.Stage[limit := N.Nat^::succ dimension] \as Target;
\import \parent.Stage[limit := dimension] \as BoundaryTarget;
\definition characteristic[p: disk]: Target.Carrier := \into[A]((cell).characteristic p, subset (N.Nat^::succ dimension)) \by {
  include cells (N.Nat^::succ dimension) cell member (Nat.ltOfSuccLe (N.Nat^::succ dimension) dimension (Nat.leRefl (N.Nat^::succ dimension)))
    ((cell).characteristic p) (image p)
};
\definition attaching[p: sphere]: BoundaryTarget.Carrier := \into[A]((cell).characteristic (boundaryInclusion p), subset dimension) \by { boundaryImage p };
\definition attached: \forall (p: sphere) -> BoundaryTarget.Next[].inclusion (attaching p) = characteristic (boundaryInclusion p) :=
  \fun (p: sphere) => \refl(characteristic (boundaryInclusion p));
\import topology.Continuity[A := disk, B := A].Corestriction[S := subset (N.Nat^::succ dimension)] \as IntoSkeleton;
\definition characteristicContinuous: topology.Continuity[A := disk, B := Target.Carrier].Continuous Model.diskTopology Target.topology characteristic :=
  IntoSkeleton.corestrictContinuous Model.diskTopology source characteristic (((laws).cellLaws cell member).continuous);
\import topology.Continuity[A := sphere, B := Model.Coordinate].Corestriction[S := Model.Boundary] \as SphereInclusion;
\import topology.Continuity[A := sphere, B := Model.Coordinate].Corestriction[S := Model.ClosedBall] \as IntoDisk;
\definition boundaryContinuous: topology.Continuity[A := sphere, B := disk].Continuous Model.sphereTopology Model.diskTopology boundaryInclusion :=
  IntoDisk.corestrictContinuous Model.sphereTopology Model.topology boundaryInclusion (SphereInclusion.inclusionContinuous Model.topology);
\import topology.Composition[A := sphere, B := disk, C := A] \as Composition;
\import topology.Continuity[A := sphere, B := A].Corestriction[S := subset dimension] \as IntoBoundary;
\definition attachingContinuous: topology.Continuity[A := sphere, B := BoundaryTarget.Carrier].Continuous Model.sphereTopology BoundaryTarget.topology attaching :=
  IntoBoundary.corestrictContinuous Model.sphereTopology source attaching
    (Composition.composeContinuous Model.sphereTopology Model.diskTopology source boundaryInclusion ((cell).characteristic)
      boundaryContinuous (((laws).cellLaws cell member).continuous));
