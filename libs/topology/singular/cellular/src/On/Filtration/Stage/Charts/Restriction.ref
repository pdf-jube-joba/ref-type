\import algebraic_topology.Interval[] \as Interval;
\import std.Data[].Pair[] \as Pair;
\import StageSpace.Subspace[S := U] \as RegionSpace;
\definition Region: \Set := RegionSpace.CarrierSet;
\definition regionTopology: topology.Topology[Carrier := Region].Topology := RegionSpace.topology Target.topology;
\import Quotient.Restriction[q := map, U := U] \as Restriction;
\import Disks.Restricted[S := Maps.Preimage map U] \as Coproduct;
\definition Domain: \Set := Coproduct.Old;
\definition domainTopology: topology.Topology[Carrier := Domain].Topology := Coproduct.oldTopology;
\definition restrictedMap: Domain -> Region := Restriction.map;
\import topological_constructions.Quotient[A := Domain, B := Region] \as RegionQuotient;
\definition restrictedQuotient: RegionQuotient.IsQuotientMap[domainTopology, regionTopology, restrictedMap] :=
  Restriction.quotientMap topology Target.topology quotientMap open;
\import topological_constructions.Product[A := Interval.Carrier, B := Domain] \as DomainCylinder;
\import topological_constructions.Product[A := Interval.Carrier, B := Region] \as RegionCylinder;
\import topological_constructions.ProductQuotient[X := Interval.Carrier, A := Domain, B := Region] \as Product;
\import topological_constructions.Quotient[A := DomainCylinder.CarrierSet, B := RegionCylinder.CarrierSet] \as ProductQuotient;
\definition productMap: DomainCylinder.CarrierSet -> RegionCylinder.CarrierSet := Product.map restrictedMap;
\definition productQuotient: ProductQuotient.IsQuotientMap[DomainCylinder.topology Interval.topology domainTopology,
  RegionCylinder.topology Interval.topology regionTopology, productMap] :=
  Product.quotientMap Interval.topology Interval.compact Interval.hausdorff domainTopology regionTopology restrictedMap restrictedQuotient;

\module To(B: \Set, target: topology.Topology[Carrier := B].Topology);
