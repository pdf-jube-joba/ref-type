\definition member: Cells.CellMember cells cell := (selected).left;
\definition below: Nat.Lt ((cell).dimension) limit := (selected).right;
\import Euclidean.Dimension[n := (cell).dimension] \as Model;
\import topology.Topology[Carrier := Model.Disk] \as Disk;
\import Disk.Finite[] \as DiskFinite;
\definition good: \Pow Model.Disk := { p: Model.Disk \where StageSpace.Member W (lift cell member below p) };
\definition bad: \Pow Model.Disk := Disk.Complement good;
\import topology.Maps[A := Model.Disk, B := A] \as Maps;
\definition same: Maps.Image ((cell).characteristic) bad = piece cell :=
  \axiom:setext(Maps.Image ((cell).characteristic) bad, piece cell,
    \block {
      \fun (x: A)(inside: _) \then
      \takefrom p: \Cast[Model.Disk] ({ p: Model.Disk \where Logic.And[Disk.Member bad p, (cell).characteristic p = x] }) \by inside \then
      \let data: Logic.And[Disk.Member bad p, (cell).characteristic p = x] :=
        \bysub(Model.Disk, { p: Model.Disk \where Logic.And[Disk.Member bad p, (cell).characteristic p = x] }, p) \then
      \return \exact(Witness[cell, x] {
        member := member, below := below, point := p, image := (data).right, outside := (data).left,
      }, Witness[cell, x])
    },
    \block {
      \fun (x: A)(inside: _) \then
      \takefrom witness: Witness[cell, x] \by inside \then
      \return Logic.existsIntro[Model.Disk, { p: Model.Disk \where Logic.And[Disk.Member bad p, (cell).characteristic p = x] }] ((witness).point)
        (Logic.And[_, _]::# ((witness).outside) ((witness).image))
    });
\import \root.On[A := A, source := source, complex := complex].CellProperties[cell := cell, member := member] \as Properties;
\definition closed: Space.IsClosedIn source (piece cell) :=
  \idelim Maps.Image ((cell).characteristic) bad = piece cell \with F: \Pow A => Space.IsClosedIn source F \by {
    base: Properties.closedImage bad (DiskFinite.openComplementClosed Model.diskTopology good (local cell member below)),
    equality: same
  };
