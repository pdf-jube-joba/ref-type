\import \parent.\parent.Stage[limit := N.Nat^::succ limit] \as Larger;
\definition inclusion[x: Carrier]: Larger.Carrier := \into[A](x, subset (N.Nat^::succ limit)) \by {
  monotone limit (N.Nat^::succ limit) (Nat.leSelfSucc limit) x (\bysub(A, subset limit, x))
};
\import topology.Continuity[A := Carrier, B := A].Corestriction[S := subset (N.Nat^::succ limit)] \as Into;
\definition continuous: topology.Continuity[A := Carrier, B := Larger.Carrier].Continuous topology Larger.topology inclusion :=
  Into.corestrictContinuous topology source inclusion ambientContinuous;
