\import Coproduct.ProductUniversal[X := Interval.Carrier, B := B, factor := Interval.topology, target := target] \as Branches;
\definition Branchwise[f: RegionCylinder.CarrierSet -> B]: \Prop := Branches.Branchwise
  (\fun (p: DomainCylinder.CarrierSet) => f (productMap p));
\definition continuous: \forall (f: RegionCylinder.CarrierSet -> B) -> Branchwise f ->
  topology.Continuity[A := RegionCylinder.CarrierSet, B := B].Continuous (RegionCylinder.topology Interval.topology regionTopology) target f :=
  \fun (f: _)(branches: _)(W: \Pow B)(wo: _) => (productQuotient).reflectsOpen
    ({ p: RegionCylinder.CarrierSet \where \In[B] W (f p) })
    (Branches.continuous (\fun (p: DomainCylinder.CarrierSet) => f (productMap p)) branches W wo);
