\definition lift[cell: Cells.CellData][member: Cells.CellMember cells cell][below: Nat.Lt ((cell).dimension) limit]
  [p: Euclidean.Disk ((cell).dimension)]: Carrier := \into[A]((cell).characteristic p, subset limit) \by {
    include cells limit cell member below ((cell).characteristic p)
      (Logic.existsIntro[Euclidean.Disk ((cell).dimension),
        { q: Euclidean.Disk ((cell).dimension) \where (cell).characteristic q = (cell).characteristic p }] p (\refl((cell).characteristic p)))
  };
\definition LocalOpen[W: \Pow Carrier]: \Prop := \forall (cell: Cells.CellData)(member: Cells.CellMember cells cell)
  (below: Nat.Lt ((cell).dimension) limit) -> Cells.DiskOpen ((cell).dimension)
    ({ p: Euclidean.Disk ((cell).dimension) \where StageSpace.Member W (lift cell member below p) });
\module For(W: \Pow Carrier, local: LocalOpen W);
\definition liftContinuous[cell: Cells.CellData][member: Cells.CellMember cells cell][below: Nat.Lt ((cell).dimension) limit]:
  topology.Continuity[A := Euclidean.Disk ((cell).dimension), B := Carrier]
    .Continuous (Euclidean.Dimension[n := (cell).dimension].diskTopology) topology (lift cell member below) :=
  topology.Continuity[A := Euclidean.Disk ((cell).dimension), B := A].Corestriction[S := subset limit]
    .corestrictContinuous (Euclidean.Dimension[n := (cell).dimension].diskTopology) source
      (lift cell member below) (((laws).cellLaws cell member).continuous);
\definition criterion[W: \Pow Carrier]: Logic.PropEquiv[StageSpace.IsOpenIn topology W, LocalOpen W] :=
  Logic.PropEquiv[_, _] {
    ltr := \fun (open: _)(cell: Cells.CellData)(member: _)(below: _) => liftContinuous cell member below W open,
    rtl := \fun (local: _) => For[W := W, local := local].open,
  };
