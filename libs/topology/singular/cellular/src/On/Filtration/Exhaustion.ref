\import N.Basic[].Def[] \as Arithmetic;
\definition height[family: Cells.Cells]: N.Nat^ :=
  Lists.foldr Cells.CellData N.Nat^
    (\fun (cell: Cells.CellData)(tail: N.Nat^) => Arithmetic.add (N.Nat^::succ ((cell).dimension)) tail)
    N.Nat^::zero family;
\definition dimensionBound: \forall (family: Cells.Cells)(cell: Cells.CellData) ->
  Cells.CellMember family cell -> Nat.Lt ((cell).dimension) (height family) :=
  \induction (family: Cells.Cells) \return \forall (cell: Cells.CellData) ->
    Cells.CellMember family cell -> Nat.Lt ((cell).dimension) (height family) \with {
      | nil: \fun (cell: Cells.CellData)(impossible: Logic.False) => Logic.falseElim _ impossible
      | cons: \fun (first: Cells.CellData)(tail: _)(ih: _)(cell: Cells.CellData)(member: _) => either!{member
        {Nat.Lt ((cell).dimension) (height (Lists.List[Cells.CellData]::cons first tail))}
        {\fun (same: cell = first) => \idelim first = cell
          \with c: Cells.CellData => Nat.Lt ((c).dimension) (height (Lists.List[Cells.CellData]::cons first tail)) \by {
            base: Nat.ltLeTrans ((first).dimension) (N.Nat^::succ ((first).dimension))
              (Arithmetic.add (N.Nat^::succ ((first).dimension)) (height tail))
              (Nat.ltOfSuccLe (N.Nat^::succ ((first).dimension)) ((first).dimension) (Nat.leRefl (N.Nat^::succ ((first).dimension))))
              (Nat.leAddRight (N.Nat^::succ ((first).dimension)) (height tail)),
            equality: sym!{Cells.CellData} _ _ same
          }}
        {\fun (old: _) => Nat.ltLeTrans ((cell).dimension) (height tail)
          (Arithmetic.add (N.Nat^::succ ((first).dimension)) (height tail)) (ih cell old)
          (Nat.leAddLeft (N.Nat^::succ ((first).dimension)) (height tail))}
      }
    };
\definition interiorClosed: \forall (cell: Cells.CellData)(x: A) ->
  \In[A] (Cells.InteriorImage cell) x -> \In[A] (Cells.ClosedImage cell) x := \block {
  \fun (cell: Cells.CellData)(x: _)(member: _) \then
  \takefrom point: \Cast[Euclidean.Disk ((cell).dimension)]
    ({ p: Euclidean.Disk ((cell).dimension) \where Logic.And[
      \In[Euclidean.coordinateCarrier ((cell).dimension)] (Euclidean.interiorAt ((cell).dimension)) p,
      (cell).characteristic p = x] }) \by member \then
  \return Logic.existsIntro[Euclidean.Disk ((cell).dimension), { p: Euclidean.Disk ((cell).dimension) \where (cell).characteristic p = x }]
    point ((\bysub(Euclidean.Disk ((cell).dimension),
      { p: Euclidean.Disk ((cell).dimension) \where Logic.And[
        \In[Euclidean.coordinateCarrier ((cell).dimension)] (Euclidean.interiorAt ((cell).dimension)) p,
        (cell).characteristic p = x] }, point)).right)
};
\definition covers: \forall (x: A) -> \In[A] (subset (height cells)) x := \block {
  \fun (x: A) \then
  \takefrom witness: Cells.CoverWitness[cells, x] \by (laws).covers x \then
  \return include cells (height cells) ((witness).cell) ((witness).member)
    (dimensionBound cells ((witness).cell) ((witness).member)) x (interiorClosed ((witness).cell) x ((witness).contains))
};
\definition full: subset (height cells) = Space.Whole :=
  \axiom:setext(subset (height cells), Space.Whole,
    \fun (x: A)(member: _) => \refl(x),
    \fun (x: A)(whole: _) => covers x);
\import \parent.Stage[limit := height cells] \as Last;
\import topology.Homeomorphism[A := Last.Carrier, B := A] \as Homeomorphisms;
\import topology.Continuity[A := A, B := A].Corestriction[S := subset (height cells)] \as Into;
\import topology.Maps[A := A, B := A].Identity[] \as Identity;
\definition homeomorphism: Homeomorphisms.Homeomorphism[Last.topology, source] :=
  Homeomorphisms.Homeomorphism[Last.topology, source] {
    forward := Last.inclusion,
    backward := \fun (x: A) => \into[A](x, subset (height cells)) \by { covers x },
    leftInverse := \fun (x: Last.Carrier) => \refl(x),
    rightInverse := \fun (x: A) => \refl(x),
    forwardContinuous := Last.continuous,
    backwardContinuous := Into.corestrictContinuous source source
      (\fun (x: A) => \into[A](x, subset (height cells)) \by { covers x }) (Identity.continuous source),
  };
