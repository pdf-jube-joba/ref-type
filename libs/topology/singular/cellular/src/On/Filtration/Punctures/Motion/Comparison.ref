\import \parent.On[x := x, w := w].Top[dimension := wd] \as First;
\import \parent.On[x := x, w := v].Top[dimension := vd] \as Second;
\import \parent.\parent.Cell[cell := (w).cell, member := (w).member, dimension := wd] \as FirstCell;
\import \parent.\parent.Cell[cell := (v).cell, member := (v).member, dimension := vd] \as SecondCell;
\import R.Order[] \as Order;
\definition secondInterior: R.Lt (Euclidean.normSquaredAt (((w).cell).dimension) ((w).point)) Real.one ->
  R.Lt (Euclidean.normSquaredAt (((v).cell).dimension) ((v).point)) Real.one :=
  \fun (inside: _) => Order.ltOfLeNotEq _ Real.one
    (\bysub(Euclidean.coordinateCarrier (((v).cell).dimension), Euclidean.closedBallAt (((v).cell).dimension), (v).point))
    (\fun (boundary: _) => Order.ltNotEq _ Real.one inside
      (\parent.\parent.\parent.Interiors[].topBoundary n ((w).cell) ((w).member) wd ((w).point)
        (\idelim x = ((w).cell).characteristic ((w).point) \with a: A => Space.Member (subset n) a \by {
          base: \idelim ((v).cell).characteristic ((v).point) = x \with a: A => Space.Member (subset n) a \by {
            base: SecondCell.boundaryLower ((v).point) boundary, equality: (v).image
          }, equality: sym!{A} _ _ ((w).image)
        })));
\definition law: \forall (t: Interval.Carrier) -> First.value t = Second.value t :=
  \fun (t: Interval.Carrier) => either!{{(Classical.excludedMiddle (R.Lt (Euclidean.normSquaredAt (((w).cell).dimension) ((w).point)) Real.one))}
    {First.value t = Second.value t}
    {\block {
      \fun (inside: _) \then
      \let vi: R.Lt (Euclidean.normSquaredAt (((v).cell).dimension) ((v).point)) Real.one := secondInterior inside \then
      \let imageSame: ((w).cell).characteristic ((w).point) = ((v).cell).characteristic ((v).point) :=
        trans!{A} _ _ _ ((w).image) (sym!{A} _ _ ((v).image)) \then
      \let cellsEqual: (w).cell = (v).cell := (laws).disjoint ((w).cell) ((v).cell) ((w).member) ((v).member) x
        (\idelim ((w).cell).characteristic ((w).point) = x \with a: A => Space.Member (Cells.InteriorImage ((w).cell)) a \by {
          base: FirstCell.containsInterior ((w).point) inside, equality: (w).image
        })
        (\idelim ((v).cell).characteristic ((v).point) = x \with a: A => Space.Member (Cells.InteriorImage ((v).cell)) a \by {
          base: SecondCell.containsInterior ((v).point) vi, equality: (v).image
        }) \then
      \return topRespects ((w).cell) ((v).cell) ((w).member) ((v).member) wd vd cellsEqual t First.input Second.input inside vi imageSame
    }}
    {\block {
      \fun (outside: _) \then
      \let boundary: Euclidean.normSquaredAt (((w).cell).dimension) ((w).point) = Real.one :=
        R.leAntisym _ _ (\bysub(Euclidean.coordinateCarrier (((w).cell).dimension), Euclidean.closedBallAt (((w).cell).dimension), (w).point))
          (Order.leOfNotLtReverse Real.one (Euclidean.normSquaredAt (((w).cell).dimension) ((w).point)) outside) \then
      \let lower: Space.Member (subset n) x := \idelim ((w).cell).characteristic ((w).point) = x
        \with a: A => Space.Member (subset n) a \by { base: FirstCell.boundaryLower ((w).point) boundary, equality: (w).image } \then
      \return trans!{Carrier} _ _ _ (First.fixesLower lower t) (sym!{Carrier} _ _ (Second.fixesLower lower t))
    }}
  };
