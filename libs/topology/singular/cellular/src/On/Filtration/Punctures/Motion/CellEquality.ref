\import \root.DiskCollar[n := (cell).dimension] \as Collar;
\import \parent.\parent.Cell[cell := cell, member := member, dimension := dimension] \as Cell;
\import Algebra.Refinement[A := Euclidean.Disk ((cell).dimension), S := Collar.punctured] \as Refined;
\definition Point: \Set := Collar.Carrier;
\definition law[t: Interval.Carrier][p, q: Point]
  [leftInterior: R.Lt (Euclidean.normSquaredAt ((cell).dimension) p) Real.one]
  [rightInterior: R.Lt (Euclidean.normSquaredAt ((cell).dimension) q) Real.one]
  [images: (cell).characteristic p = (cell).characteristic q]: Cell.motion t p = Cell.motion t q :=
  congr!{Point Carrier} (Cell.motion t) p q
    (Refined.ext p q (((laws).cellLaws cell member).injectiveInterior p q leftInterior rightInterior images));
