\import \parent.Motion[] \as Motion;
\import algebraic_topology.Interval[] \as Interval;
\import algebraic_topology.Homotopy[A := Carrier, B := Carrier] \as Homotopies;
\definition lower: \Pow Carrier := { x: Carrier \where Space.Member (subset n) x };
\import topology.Topology[Carrier := Carrier].Subspace[S := lower] \as Subspace;
\definition endpoint[x: Carrier]: Carrier := Motion.value Interval.end x;
\definition homotopy: Homotopies.Homotopy[topology, topology, (\fun (x: Carrier) => x), endpoint] :=
  \into[Homotopies.Family](Motion.family, Homotopies.Homotopy[topology, topology, (\fun (x: Carrier) => x), endpoint]) \by {
    Homotopies.Laws[topology, topology, (\fun (x: Carrier) => x), endpoint, Motion.family] {
      continuous := Motion.Continuity[].continuous,
      start := Motion.atStart,
      end := \fun (x: Carrier) => \refl(endpoint x),
    }
  };
\definition relativeHomotopy: Homotopies.RelativeHomotopy[topology, topology, lower, (\fun (x: Carrier) => x), endpoint] :=
  \into[Homotopies.Family](homotopy, Homotopies.RelativeHomotopy[topology, topology, lower, (\fun (x: Carrier) => x), endpoint]) \by {
    Homotopies.RelativeLaws[topology, topology, lower, (\fun (x: Carrier) => x), endpoint, homotopy] {
      homotopy := Homotopies.laws topology topology (\fun (x: Carrier) => x) endpoint homotopy,
      fixed := Motion.fixesLower,
    }
  };
\definition retraction[x: Carrier]: Subspace.CarrierSet := \into[Carrier](endpoint x, lower) \by { Motion.endLower x };
\import topology.Continuity[A := Carrier, B := Carrier].Corestriction[S := lower] \as Into;
\definition continuous: topology.Continuity[A := Carrier, B := Subspace.CarrierSet].Continuous topology (Subspace.topology topology) retraction :=
  Into.corestrictContinuous topology topology retraction (Homotopies.endContinuous topology topology (\fun (x: Carrier) => x) endpoint homotopy);
\import algebraic_topology.DeformationRetract[A := Carrier, source := topology, subset := lower] \as Deformations;
\definition deformation: Deformations.Data := Deformations.Data {
  retraction := retraction, continuous := continuous,
  retracts := \fun (x: Subspace.CarrierSet) => Motion.fixesLower Interval.end x (\bysub(Carrier, lower, x)),
  homotopy := relativeHomotopy,
};
