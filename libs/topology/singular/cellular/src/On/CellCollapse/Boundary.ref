\definition onLower[x: Skeleton.Carrier][lower: \In[A] (Filtration.subset dimension) x]: Logic.Not (InteriorImage x) :=
  \fun (inside: InteriorImage x) => Interior.outsideLower (\into[A](x, Cells.InteriorImage cell) \by { inside }) lower;
\definition outside[p: Model.Disk][boundary: Model.normSquared p = Real.one]: Logic.Not (InteriorImage (Characteristic.characteristic p)) :=
  onLower (Characteristic.characteristic p)
    (Characteristic.boundaryImage (\into[Model.Coordinate](p, Model.Boundary) \by { boundary }));
\definition onCharacteristic: \forall (p: Model.Disk) -> map (Characteristic.characteristic p) = DiskQuotient.class p :=
  \fun (p: Model.Disk) => either!{{(Classical.excludedMiddle (Reals.Lt (Model.normSquared p) Real.one))} {map (Characteristic.characteristic p) = DiskQuotient.class p}
    {onInterior p}
    {\fun (notInterior: _) => \block {
      \let boundary: Model.normSquared p = Real.one := Reals.leAntisym _ _
        (\bysub(Model.Coordinate, Model.ClosedBall, p)) (Order.leOfNotLtReverse Real.one (Model.normSquared p) notInterior) \then
      \return trans!{DiskQuotient.Carrier} _ _ _ (onOutside (Characteristic.characteristic p) (outside p boundary))
        (DiskQuotient.collapsed (Characteristic.boundaryInclusion point) p (\bysub(Model.Coordinate, Model.Boundary, point)) boundary)
    }}
  };
