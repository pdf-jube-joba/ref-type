\definition degree: I.Int^ := I.Int^::ofNat dimension;
\import Pair.Homology[z := degree] \as PairH;
\import Pair.Basis[] \as CellBasis;
\definition quotient: Modules.Bundle := Modules.Bundle { Carrier := \parent.DiskAt[d := dimension].Carrier, space := \parent.DiskAt[d := dimension].space };
\definition relative: Modules.Bundle := Modules.Bundle {
  Carrier := singular_cohomology.Relative[A := DiskQuotient.Carrier, source := DiskQuotient.topology Model.diskTopology,
    subset := topology.Topology[Carrier := DiskQuotient.Carrier].Singleton basepoint].Homology[z := degree].Carrier,
  space := singular_cohomology.Relative[A := DiskQuotient.Carrier, source := DiskQuotient.topology Model.diskTopology,
    subset := topology.Topology[Carrier := DiskQuotient.Carrier].Singleton basepoint].Homology[z := degree].space,
};
\import singular_cellular_algebra.Algebra[].IntegerCoordinates[A := quotient, B := relative, f := PairH.projection,
  sourceOrientation := sourceOrientation, targetOrientation := CellBasis.orientation] \as Projected;
\definition projectionPositive: Projected.Positive := trans!{relative.Carrier} _ _ _
  (congr!{quotient.Carrier relative.Carrier} ((PairH.projection).apply) _ _ (sym!{quotient.Carrier} _ _ represented.onGenerator))
  (represented.projected (\root.Disks[].generator dimension));
\module Along(h: Result);
