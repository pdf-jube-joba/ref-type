\import topology.Homeomorphism[A := DiskQuotient.Carrier, B := Sphere.Sphere] \as Homeomorphisms;
\definition laws: Homeomorphisms.Laws[DiskQuotient.topology Model.diskTopology, Sphere.sphereTopology, h] := Homeomorphisms.laws (DiskQuotient.topology Model.diskTopology) Sphere.sphereTopology h;
\definition collapse[x: Skeleton.Carrier]: Sphere.Sphere := (h).forward (map x);
\import topology.Composition[A := Skeleton.Carrier, B := DiskQuotient.Carrier, C := Sphere.Sphere] \as Composition;
\definition continuous: topology.Continuity[A := Skeleton.Carrier, B := Sphere.Sphere].Continuous Skeleton.topology Sphere.sphereTopology collapse :=
  Composition.composeContinuous Skeleton.topology (DiskQuotient.topology Model.diskTopology) Sphere.sphereTopology map (h).forward
    (\parent.\parent.\parent.Continuity[].continuous) (laws).forwardContinuous;
\definition onCharacteristic[p: Model.Disk]: collapse (Characteristic.characteristic p) = (h).forward (DiskQuotient.class p) :=
  congr!{DiskQuotient.Carrier Sphere.Sphere} ((h).forward) _ _ (\parent.\parent.\parent.Boundary[].onCharacteristic p);
\definition outside[x: Skeleton.Carrier][notCell: Logic.Not (InteriorImage x)]: collapse x = (h).forward basepoint :=
  congr!{DiskQuotient.Carrier Sphere.Sphere} ((h).forward) _ _ (onOutside x notCell);
