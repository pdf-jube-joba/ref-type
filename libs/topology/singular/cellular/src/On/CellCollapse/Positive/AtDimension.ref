\import Euclidean.Dimension[n := d] \as Disk;
\definition boundary: \Pow Disk.Disk := { p: Disk.Disk \where Disk.normSquared p = Real.one };
\import algebraic_topology.Collapse[A := Disk.Disk, subset := boundary] \as Collapse;
\definition Homeomorphism: \Set := topology.Homeomorphism[A := Collapse.Carrier, B := Sphere.Sphere]
  .Homeomorphism[Collapse.topology Disk.diskTopology, Sphere.sphereTopology];
