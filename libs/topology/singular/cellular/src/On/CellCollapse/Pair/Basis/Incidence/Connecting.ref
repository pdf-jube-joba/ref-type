\import singular_cohomology.Relative[A := Upper.Carrier, source := Upper.topology, subset := SourceRelative.subset] \as RawPair;
\definition basisProjection: ((SourceRelative.Homology[z := upperDegree].isomorphism).forward).apply (SourceBasis.generator sourceCell) =
  (CharacteristicAction.At[z := upperDegree].induced).apply diskGenerator :=
  trans!{{RawPair.Homology[z := upperDegree].Carrier}} _ _ _
    (congr!{{SourceLayer.Homology[z := upperDegree].Carrier} {RawPair.Homology[z := upperDegree].Carrier}}
      (((SourceRelative.Homology[z := upperDegree].isomorphism).forward).apply) _ _ CharacteristicBasis.onGenerator)
    ((SourceRelative.Homology[z := upperDegree].isomorphism).rightInverse ((CharacteristicAction.At[z := upperDegree].induced).apply diskGenerator));
\definition law: (SourceLayer.Homology[z := upperDegree].connecting).apply (SourceBasis.generator sourceCell) = (attachingAction).apply boundaryGenerator :=
  trans!{SkeletonH.Homology} _ _ _
    (sym!{SkeletonH.Homology} _ _ ((lowerIsomorphism).leftInverse ((SourceLayer.Homology[z := upperDegree].connecting).apply (SourceBasis.generator sourceCell))))
    (trans!{SkeletonH.Homology} _ _ _
      (congr!{NestedH.Homology SkeletonH.Homology} (((lowerIsomorphism).backward).apply) _ _
        (sym!{NestedH.Homology} _ _ (SourceRelative.Naturality[].At[z := upperDegree].connecting (SourceBasis.generator sourceCell))))
      (trans!{SkeletonH.Homology} _ _ _
        (congr!{NestedH.Homology SkeletonH.Homology} (((lowerIsomorphism).backward).apply) _ _
          (trans!{NestedH.Homology} _ _ _
            (congr!{{RawPair.Homology[z := upperDegree].Carrier} NestedH.Homology}
              ((RawPair.LongExact[z := upperDegree].connecting).apply) _ _ basisProjection)
            (CharacteristicAction.Naturality[].At[z := upperDegree].connectingNaturality diskGenerator)))
        (sym!{SkeletonH.Homology} _ _ (attachingOnHomology boundaryGenerator))));
