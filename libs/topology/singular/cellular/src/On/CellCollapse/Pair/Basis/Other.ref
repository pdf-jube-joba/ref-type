\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Other[other := other, present := CellsAt.member other, sameDimension := CellsAt.dimension other, different := different] \as Vanishing;
\import Basis.Characteristic[cell := other].Oriented[] \as OtherBasis;
\import \root.Disks[].At[n := (other).dimension] \as OtherDisk;
\import Basis.Cell[cell := other] \as Orientation;
\import Euclidean.Dimension[n := (other).dimension] \as OtherModel;
\import singular_cohomology.Relative[A := OtherModel.Disk, source := OtherModel.diskTopology, subset := Vanishing.otherBoundary]
  .Maps[B := Skeleton.Carrier].Over[target := Skeleton.topology, targetSubset := lower].On[f := Vanishing.characteristic].Integer[] \as OtherAction;
\definition collapsedZero[a: I.Int^]: (ActionH.fromLayer).apply (((Basis.isomorphism).forward).apply ((Free.Injection[i := other].map).apply a)) = (Target.Homology[z := degree].space).zero :=
  eq_reason_in!{{Target.Homology[z := degree].Carrier} _
    "=" _ "by" { congr!{{Layer.Homology[z := degree].Carrier} {Target.Homology[z := degree].Carrier}} ((ActionH.fromLayer).apply) _ _ (OtherBasis.onScalar a) }
    "=" _ "by" { congr!{{Source.Homology[z := degree].Carrier} {Target.Homology[z := degree].Carrier}} ((ActionH.relative).apply) _ _
        ((Layer.Relative[].Homology[z := degree].isomorphism).rightInverse
          ((OtherAction.At[z := degree].induced).apply (((Orientation.orientedDisk).forward).apply a))) }
    "=" _ "by" { Vanishing.Homology[z := degree].zero (((Orientation.orientedDisk).forward).apply a) }
  };
\import Modules.Hom[V := Target.Homology[z := degree].Carrier, W := I.Int^, source := Target.Homology[z := degree].space, target := Modules.scalarModule] \as Backward;
\definition onScalar[a: I.Int^]: (coordinate).apply (((Basis.isomorphism).forward).apply ((Free.Injection[i := other].map).apply a)) = I.Zero.specification :=
  trans!{I.Int^} _ _ _
    (congr!{{Target.Homology[z := degree].Carrier} I.Int^} (((orientation).backward).apply) _ _ (collapsedZero a))
    (Backward.zeroPreserved (orientation).backward);
