\definition degree: I.Int^ := I.Int^::ofNat (N.Nat^::succ n);
\import Reduced.Positive[n := n] \as Comparison;
\import Complexes.At[C := Extension.complex, z := degree] \as H;
\import Modules.Isomorphism[V := Reduced.At[z := degree].Carrier, W := H.Homology,
  source := Reduced.At[z := degree].space, target := H.homologySpace].Vanishing[] \as Vanishing;
\definition zero: \forall (q: H.Homology) -> q = (H.homologySpace).zero :=
  Vanishing.targetZero Comparison.isomorphism (Contractible.Homology[z := degree].zero (SourceModel.Contraction[].contraction));
