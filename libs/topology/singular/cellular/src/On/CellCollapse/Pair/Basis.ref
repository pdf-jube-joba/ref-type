\use std.Logic[].Equality[].eq_reason_in;
\definition degree: I.Int^ := I.Int^::ofNat dimension;
\import \parent.Homology[z := degree] \as ActionH;
\import Layer.Basis[] \as Basis;
\import Filtration.CellInteriors[n := dimension] \as CellsAt;
\definition self: CellsAt.Index := \into[Cells.CellData](cell, CellsAt.Selected) \by {
  Logic.And[_, _]::# member (\refl(dimension))
};
\import Modules.DirectSum[Index := CellsAt.Index, family := Basis.scalars] \as Free;
\import \root.Disks[].At[n := dimension] \as Disk;
\definition sourceOrientation: Modules.Isomorphism[V := I.Int^, W := Disk.Homology[z := degree].Carrier,
  source := Modules.scalarModule, target := Disk.Homology[z := degree].space].Isomorphism := \root.Disks[].orientation dimension;
\import singular_excision.GoodPair[A := Model.Disk, source := Model.diskTopology, subset := boundary].On[pair := GoodPair.pair]
  .Homology[z := degree] \as Collapsed;
\definition orientation: Modules.Isomorphism[V := I.Int^, W := Target.Homology[z := degree].Carrier,
  source := Modules.scalarModule, target := Target.Homology[z := degree].space].Isomorphism :=
  Modules.Isomorphism[V := I.Int^, W := Disk.Homology[z := degree].Carrier, source := Modules.scalarModule, target := Disk.Homology[z := degree].space]
    .Composition[U := Target.Homology[z := degree].Carrier, final := Target.Homology[z := degree].space]
    .compose Collapsed.relativeIsomorphism sourceOrientation;
\definition coordinate: Modules.Hom[V := Layer.Homology[z := degree].Carrier, W := I.Int^,
  source := Layer.Homology[z := degree].space, target := Modules.scalarModule].Map :=
  Modules.Hom[V := Target.Homology[z := degree].Carrier, W := I.Int^, source := Target.Homology[z := degree].space, target := Modules.scalarModule]
    .Composition[U := Layer.Homology[z := degree].Carrier, domain := Layer.Homology[z := degree].space]
    .compose (orientation).backward ActionH.fromLayer;
\import Basis.Characteristic[cell := self].Oriented[] \as Selected;
\import Basis.Cell[cell := self] \as BasisOrientation;
\definition orientationEquation: BasisOrientation.orientedDisk = sourceOrientation :=
  \transporteq dimension \with k: N.Nat^ =>
    Modules.Isomorphism[V := I.Int^, W := Disk.Homology[z := I.Int^::ofNat k].Carrier,
      source := Modules.scalarModule, target := Disk.Homology[z := I.Int^::ofNat k].space].Isomorphism
  \by { base: sourceOrientation };
\import Layer.Relative[].Homology[z := degree] \as RelativeComparison;
\import Characteristics.On[f := characteristic].Integer[].At[z := degree] \as CharacteristicHomology;
\definition selected[a: I.Int^]: (ActionH.fromLayer).apply (((Basis.isomorphism).forward).apply ((Free.Injection[i := self].map).apply a)) = ((orientation).forward).apply a := \block {
  \let input: Disk.Homology[z := degree].Carrier := ((sourceOrientation).forward).apply a \then
  \let characteristicClass: Source.Homology[z := degree].Carrier := (CharacteristicHomology.induced).apply input \then
  \let representative: Layer.Homology[z := degree].Carrier := ((RelativeComparison.isomorphism).backward).apply characteristicClass \then
  \let basisValue: Layer.Homology[z := degree].Carrier := ((Basis.isomorphism).forward).apply ((Free.Injection[i := self].map).apply a) \then
  \let orientedInput: Disk.Homology[z := degree].Carrier := ((BasisOrientation.orientedDisk).forward).apply a \then
  \let aligned: orientedInput = input :=
    congr!{{Modules.Isomorphism[V := I.Int^, W := Disk.Homology[z := degree].Carrier,
      source := Modules.scalarModule, target := Disk.Homology[z := degree].space].Isomorphism} {Disk.Homology[z := degree].Carrier}}
      (\fun (e: Modules.Isomorphism[V := I.Int^, W := Disk.Homology[z := degree].Carrier,
        source := Modules.scalarModule, target := Disk.Homology[z := degree].space].Isomorphism) => ((e).forward).apply a)
      BasisOrientation.orientedDisk sourceOrientation orientationEquation \then
  \let chosen: basisValue = representative :=
    trans!{{Layer.Homology[z := degree].Carrier}} basisValue (Selected.image orientedInput) representative
      (Selected.onScalar a)
      (congr!{{Disk.Homology[z := degree].Carrier} {Layer.Homology[z := degree].Carrier}}
        Selected.image orientedInput input aligned) \then
  \let quotient: ((RelativeComparison.isomorphism).forward).apply representative = characteristicClass :=
    (RelativeComparison.isomorphism).rightInverse characteristicClass \then
  \return eq_reason_in!{{Target.Homology[z := degree].Carrier} { (ActionH.fromLayer).apply basisValue }
    "=" { (ActionH.fromLayer).apply representative } "by" { congr!{{Layer.Homology[z := degree].Carrier} {Target.Homology[z := degree].Carrier}}
      ((ActionH.fromLayer).apply) basisValue representative chosen }
    "=" { (ActionH.relative).apply characteristicClass } "by" { congr!{{Source.Homology[z := degree].Carrier} {Target.Homology[z := degree].Carrier}}
        ((ActionH.relative).apply) (((RelativeComparison.isomorphism).forward).apply representative) characteristicClass quotient }
    "=" { ((orientation).forward).apply a } "by" { ActionH.onCharacteristic input }
  }
};
\definition onSelf[a: I.Int^]: (coordinate).apply (((Basis.isomorphism).forward).apply ((Free.Injection[i := self].map).apply a)) = a :=
  trans!{I.Int^} _ _ _
    (congr!{{Target.Homology[z := degree].Carrier} I.Int^} (((orientation).backward).apply) _ _ (selected a)) ((orientation).leftInverse a);
\module Other(other: CellsAt.Index, different: Logic.Not (other = cell));

\import Free.FiniteSupport[] \as Coordinates;
\import Free.To[W := I.Int^, target := Modules.scalarModule] \as Universal;
\import Modules.Hom[V := Layer.Homology[z := degree].Carrier, W := I.Int^, source := Layer.Homology[z := degree].space, target := Modules.scalarModule]
  .Composition[U := Free.Carrier, domain := Free.space] \as Rows;
\definition row: Modules.Hom[V := Free.Carrier, W := I.Int^, source := Free.space, target := Modules.scalarModule].Map := Rows.compose coordinate (Basis.isomorphism).forward;
\definition onInjection: \forall (other: CellsAt.Index)(a: I.Int^) ->
  (row).apply ((Free.Injection[i := other].map).apply a) = (Coordinates.At[i := self].evaluate).apply ((Free.Injection[i := other].map).apply a) :=
  \fun (other: CellsAt.Index)(a: I.Int^) => Logic.orElim _ _ _ (Classical.excludedMiddle (other = self))
    (\fun (same: other = self) => \idelim self = other \with i: CellsAt.Index =>
      (row).apply ((Free.Injection[i := i].map).apply a) = (Coordinates.At[i := self].evaluate).apply ((Free.Injection[i := i].map).apply a) \by {
        base: trans!{I.Int^} _ _ _ (onSelf a) (sym!{I.Int^} _ _ (Coordinates.atOwn self a)),
        equality: sym!{CellsAt.Index} _ _ same
      })
    (\fun (different: Logic.Not (other = self)) => trans!{I.Int^} _ _ _ (Other[other := other, different := different].onScalar a)
      (sym!{I.Int^} _ _ (Coordinates.atOther other self a different)));
\definition rowEquation: row = Coordinates.At[i := self].evaluate := Universal.ext _ _ onInjection;
\definition coefficient[q: Layer.Homology[z := degree].Carrier]: I.Int^ := (Coordinates.At[i := self].evaluate).apply (((Basis.isomorphism).backward).apply q);
\definition coefficientLaw[q: Layer.Homology[z := degree].Carrier]: (coordinate).apply q = coefficient q :=
  trans!{I.Int^} _ _ _
    (sym!{I.Int^} _ _ (congr!{{Layer.Homology[z := degree].Carrier} I.Int^} ((coordinate).apply) _ _ ((Basis.isomorphism).rightInverse q)))
    (congr!{{Modules.Hom[V := Free.Carrier, W := I.Int^, source := Free.space, target := Modules.scalarModule].Map} I.Int^}
      (\fun (f: Modules.Hom[V := Free.Carrier, W := I.Int^, source := Free.space, target := Modules.scalarModule].Map) => (f).apply (((Basis.isomorphism).backward).apply q)) _ _ rowEquation);

\import Filtration.CellInteriors[n := N.Nat^::succ dimension] \as HigherCells;
\module Incidence(sourceCell: HigherCells.Index);
