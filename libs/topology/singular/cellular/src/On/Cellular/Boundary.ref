\import \parent.\parent.Layer[n := N.Nat^::succ n].Homology[z := I.Int^::ofNat (N.Nat^::succ n)] \as Source;
\import \parent.\parent.Layer[n := n].Homology[z := I.Int^::ofNat n] \as Target;
\import \parent.\parent.Filtration[].Stage[limit := N.Nat^::succ n] \as MiddleSpace;
\import singular_cohomology.Chains[A := MiddleSpace.Carrier, source := MiddleSpace.topology] \as MiddleChains;
\import Nonnegative.ZeroExtension[C := MiddleChains.complex] \as MiddleExtension;
\import Complexes.At[C := MiddleExtension.complex, z := I.Int^::ofNat n] \as Middle;
\import Modules.Hom[V := Middle.Homology, W := Carrier n, source := Middle.homologySpace, target := space n]
  .Composition[U := Carrier (N.Nat^::succ n), domain := space (N.Nat^::succ n)] \as Composition;
\definition map: Modules.Hom[V := Carrier (N.Nat^::succ n), W := Carrier n, source := space (N.Nat^::succ n), target := space n].Map :=
  Composition.compose Target.projection Source.connecting;
