\use std.Logic[].Equality[].eq_reason_in;
\import Modules.Hom[V := Carrier n, W := UpperExtension.Carrier degree, source := space n, target := UpperExtension.space degree] \as PreviousMaps;
\import Modules.Laws[V := NextExtension.Carrier degree, space := NextExtension.space degree] \as Target;
\import Complexes.Map[C := UpperExtension.complex, D := NextExtension.complex].At[k := degree] \as Included;
\definition onCycle: \forall (q: NextCell.Cycle) ->
  (NextExtension.complex.differential).apply (I.Int^::ofNat (N.Nat^::succ n)) ((result.representative.map).apply q) = (NextExtension.space degree).zero :=
  \fun (q: NextCell.Cycle) => eq_reason_in!{{NextExtension.Carrier degree} _
    "=" _ "by" { result.boundary q }
    "=" _ "by" { congr!{{UpperExtension.Carrier degree} {NextExtension.Carrier degree}} ((NextLayer.inclusion).apply degree) _ _
        (trans!{{UpperExtension.Carrier degree}} _ _ _
          (congr!{{Carrier n} {UpperExtension.Carrier degree}} ((previous.relative.map).apply) _ _
            (\bysub(Extension.Carrier (I.Int^::ofNat (N.Nat^::succ n)), (NextCell.cycles).carrier, q)))
          (PreviousMaps.zeroPreserved previous.relative.map)) }
    "=" _ "by" { Included.zeroPreserved NextLayer.inclusion }
  };
\definition data: Next.Data := Next.Data { relative := result.representative, onCycle := onCycle };
\definition boundaryLaw: \forall (q: Carrier (N.Nat^::succ n)) ->
  (NextExtension.complex.differential).apply (I.Int^::ofNat (N.Nat^::succ n)) ((data.relative.map).apply q) =
    (NextLayer.inclusion).apply degree ((previous.relative.map).apply ((boundary n).apply q)) := result.boundary;
