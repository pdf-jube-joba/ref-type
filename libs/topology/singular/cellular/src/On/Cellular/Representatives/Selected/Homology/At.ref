\import Complexes.At[C := Cellular.complex, z := z] \as Source;
\import Complexes.At[C := Singular.complex, z := z] \as Target;
\import Maps.At[k := z].Invert[f := chainMap] \as Inverse;
\definition isomorphism: Modules.Isomorphism[V := Source.Homology, W := Target.Homology,
  source := Source.homologySpace, target := Target.homologySpace].Isomorphism := Inverse.isomorphism (quasiIsomorphism z);
