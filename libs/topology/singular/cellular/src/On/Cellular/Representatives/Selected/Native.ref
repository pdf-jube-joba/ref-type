\import singular_cech.Algebra[R := I.Int^, ring := Integers.ring] \as Algebra;
\import Algebra.Restriction[C := integerComplex] \as SourceRestriction;
\import Algebra.Restriction[C := AmbientChains.integerComplex] \as TargetRestriction;
\import SourceRestriction.Mapping[D := AmbientChains.integerComplex].Equivalence[e := e, sourceNegative := sourceNegative, targetNegative := targetNegative] \as Restricted;
\import Algebra.RestrictionZeroExtension[C := complex] \as SourceRecovery;
\import Algebra.RestrictionZeroExtension[C := AmbientChains.complex] \as TargetRecovery;
\import Nonnegative.Equivalence[C := SourceRestriction.complex, D := complex] \as SourceEquivalence;
\definition sourceEquivalence: Nonnegative.Equivalence[C := complex, D := SourceRestriction.complex].Equivalence :=
  SourceEquivalence.Reverse[].apply (SourceEquivalence.FromIsomorphism[].apply SourceRecovery.isomorphism);
\import Nonnegative.Equivalence[C := complex, D := SourceRestriction.complex].Composition[E := TargetRestriction.complex] \as First;
\definition restricted: Nonnegative.Equivalence[C := complex, D := TargetRestriction.complex].Equivalence := First.compose sourceEquivalence Restricted.value;
\import Nonnegative.Equivalence[C := TargetRestriction.complex, D := AmbientChains.complex].FromIsomorphism[] \as TargetEquivalence;
\import Nonnegative.Equivalence[C := complex, D := TargetRestriction.complex].Composition[E := AmbientChains.complex] \as Second;
\definition equivalence: Nonnegative.Equivalence[C := complex, D := AmbientChains.complex].Equivalence := Second.compose restricted (TargetEquivalence.apply TargetRecovery.isomorphism);
\module Diagonal;
