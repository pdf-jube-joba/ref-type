\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Degree[n := n] \as Current;
\import \parent.Degree[n := N.Nat^::succ n] \as Next;
\import \parent.\parent.\parent.\parent.Filtration[].Stage[limit := N.Nat^::succ n] \as Upper;
\import \parent.\parent.\parent.\parent.Filtration[].Stage[limit := N.Nat^::succ (N.Nat^::succ n)] \as NextUpper;
\import singular_cohomology.Chains[A := Upper.Carrier, source := Upper.topology] \as UpperChains;
\import singular_cohomology.Chains[A := NextUpper.Carrier, source := NextUpper.topology] \as NextChains;
\import singular_cohomology.Chains[A := A, source := source] \as AmbientChains;
\import singular_cohomology.Maps[A := Upper.Carrier, B := NextUpper.Carrier, source := Upper.topology, target := NextUpper.topology] \as Inclusion;
\import singular_cohomology.Maps[A := NextUpper.Carrier, B := A, source := NextUpper.topology, target := source] \as NextAmbient;
\import Inclusion.Composition[C := A, final := source].At[n := n] \as Composition;
\definition commutes: \forall (q: Carrier (N.Nat^::succ n)) ->
  (AmbientChains.complex.differential).apply n ((Next.map).apply q) = (Current.map).apply ((boundary n).apply q) :=
  \fun (q: Carrier (N.Nat^::succ n)) => eq_reason_in!{{AmbientChains.Carrier n} _
    "=" _ "by" { (NextAmbient.push NextUpper.inclusion NextUpper.continuous).commutes n ((Next.local).apply q) }
    "=" _ "by" { congr!{{NextChains.Carrier n} {AmbientChains.Carrier n}}
        ((NextAmbient.At[n := n].push NextUpper.inclusion NextUpper.continuous).apply) _ _ (boundaryLaw n q) }
    "=" _ "by" { congr!{{Modules.Hom[V := UpperChains.Carrier n, W := AmbientChains.Carrier n, source := UpperChains.space n, target := AmbientChains.space n].Map} {AmbientChains.Carrier n}}
        (\fun (f: Modules.Hom[V := UpperChains.Carrier n, W := AmbientChains.Carrier n, source := UpperChains.space n, target := AmbientChains.space n].Map) => (f).apply ((Current.local).apply ((boundary n).apply q))) _ _
        (Composition.law Upper.Next[].inclusion Upper.Next[].continuous NextUpper.inclusion NextUpper.continuous) }
  };
