\import \parent.\parent.Cellular[].Representatives[].Selected[selection := sourceSelection] \as SourceComparison;
\import Target.Cellular[].Representatives[].Selected[selection := targetSelection] \as TargetComparison;
\import singular_cohomology.Chains[A := A, source := source] \as SourceSingular;
\import singular_cohomology.Chains[A := B, source := target] \as TargetSingular;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\module Coefficients(input, output: Modules.Bundle,
  coefficientMap: Modules.Hom[V := input.Carrier, W := output.Carrier, source := input.space, target := output.space].Map);

\import Complexes.Equivalence[C := Target.Cellular[].integerComplex, D := TargetSingular.integerComplex] \as TargetEquivalences;
\definition Recovery: \Set := \Cast[TargetEquivalences.Equivalence] ({ e: TargetEquivalences.Equivalence \where (e).forward = TargetComparison.integerMap });
\definition recoveryExists: \exists Recovery := TargetComparison.equivalenceExists;
\module Chain(e: Recovery);
