\use std.Logic[].Equality[].eq_reason_in;
\import Complexes.At[C := SourceCell.complex, z := z] \as SourceCellH;
\import Complexes.At[C := TargetCell.complex, z := z] \as TargetCellH;
\import Complexes.At[C := SourceOrdinary.complex, z := z] \as SourceH;
\import Complexes.At[C := TargetOrdinary.complex, z := z] \as TargetH;
\import CellularMaps.At[k := z] \as CellInduced;
\import Complexes.Map[C := SourceOrdinary.complex, D := TargetOrdinary.complex].At[k := z] \as SingularInduced;
\import Complexes.Map[C := TargetOrdinary.complex, D := TargetCell.complex].At[k := z] \as RecoveryInduced;
\import Complexes.Map[C := TargetCell.complex, D := TargetOrdinary.complex].At[k := z] \as TargetInduced;
\import IntermediateMaps.At[k := z] \as IntermediateInduced;
\import FirstTensor.At[k := z] \as FirstH;
\import SecondTensor.At[k := z] \as SecondH;
\import Equivalence.At[k := z] \as InverseH;
\definition cellularPushforward: Modules.Hom[V := SourceCellH.Homology, W := TargetCellH.Homology,
  source := SourceCellH.homologySpace, target := TargetCellH.homologySpace].Map := CellInduced.induced chainMap;
\definition singularPushforward: Modules.Hom[V := SourceH.Homology, W := TargetH.Homology,
  source := SourceH.homologySpace, target := TargetH.homologySpace].Map :=
  SingularInduced.induced (Singular.On[f := Maps.integerPush f continuous].map);
\definition intermediate: Modules.Hom[V := SourceCellH.Homology, W := TargetH.Homology,
  source := SourceCellH.homologySpace, target := TargetH.homologySpace].Map := IntermediateInduced.induced (Intermediate.On[f := first].map);
\definition recovery: Modules.Hom[V := TargetH.Homology, W := TargetCellH.Homology,
  source := TargetH.homologySpace, target := TargetCellH.homologySpace].Map := RecoveryInduced.induced (Recover.On[f := (e).backward].map);
\definition cellularFactor[q: SourceCellH.Homology]: (cellularPushforward).apply q = (recovery).apply ((intermediate).apply q) :=
  trans!{TargetCellH.Homology} _ _ _
    (congr!{CellularMaps.Map TargetCellH.Homology} (\fun (g: CellularMaps.Map) => (CellInduced.induced g).apply q) _ _
      (SecondCoefficients.law first (e).backward))
    (SecondH.compositionOnHomology (Recover.On[f := (e).backward].map) (Intermediate.On[f := first].map) q);
\definition intermediateFactor[q: SourceCellH.Homology]: (intermediate).apply q =
  (singularPushforward).apply (((SourceComparison.Homology[coefficients := coefficients].At[z := z].isomorphism).forward).apply q) :=
  trans!{TargetH.Homology} _ _ _
    (congr!{IntermediateMaps.Map TargetH.Homology} (\fun (g: IntermediateMaps.Map) => (IntermediateInduced.induced g).apply q) _ _
      (FirstCoefficients.law SourceComparison.integerMap (Maps.integerPush f continuous)))
    (FirstH.compositionOnHomology (Singular.On[f := Maps.integerPush f continuous].map)
      SourceComparison.Homology[coefficients := coefficients].chainMap q);
\definition recover[q: TargetH.Homology]:
  ((TargetComparison.Homology[coefficients := coefficients].At[z := z].isomorphism).forward).apply ((recovery).apply q) = q :=
  trans!{TargetH.Homology} _ _ _
    (congr!{TargetMaps.Map TargetH.Homology}
      (\fun (g: TargetMaps.Map) => (TargetInduced.induced (TargetPush.On[f := g].map)).apply ((recovery).apply q)) _ _
      (sym!{TargetMaps.Map} _ _ forwardLaw))
    (InverseH.rightInverse Invariant.With[e := e].equivalence q);
\definition naturality[q: SourceCellH.Homology]:
  ((TargetComparison.Homology[coefficients := coefficients].At[z := z].isomorphism).forward).apply ((cellularPushforward).apply q) =
  (singularPushforward).apply (((SourceComparison.Homology[coefficients := coefficients].At[z := z].isomorphism).forward).apply q) :=
  eq_reason_in!{TargetH.Homology _
    "=" _ "by" { congr!{TargetCellH.Homology TargetH.Homology}
      (((TargetComparison.Homology[coefficients := coefficients].At[z := z].isomorphism).forward).apply) _ _ (cellularFactor q) }
    "=" _ "by" { recover ((intermediate).apply q) }
    "=" _ "by" { intermediateFactor q }
  };
