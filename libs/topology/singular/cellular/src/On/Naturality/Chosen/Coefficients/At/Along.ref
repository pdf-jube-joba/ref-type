\definition singularCochainMap: Cochains.Map[C := TargetOrdinary.complex, D := SourceOrdinary.complex].Map :=
  Pullback.On[f := Maps.integerPush f continuous, u := coefficientMap].map;
\import Cochains.Map[C := TargetOrdinary.complex, D := SourceOrdinary.complex].At[k := z] \as Induced;
\definition singularPullback: Modules.Hom[V := TargetH.Cohomology, W := SourceH.Cohomology,
  source := TargetH.cohomologySpace, target := SourceH.cohomologySpace].Map := Induced.induced singularCochainMap;
\import Modules.Hom[V := TargetH.Cohomology, W := SourceH.Cohomology,
  source := TargetH.cohomologySpace, target := SourceH.cohomologySpace]
  .Composition[U := TargetCellH.Cohomology, domain := TargetCellH.cohomologySpace] \as First;
\import Modules.Hom[V := SourceH.Cohomology, W := SourceCellH.Cohomology,
  source := SourceH.cohomologySpace, target := SourceCellH.cohomologySpace]
  .Composition[U := TargetCellH.Cohomology, domain := TargetCellH.cohomologySpace] \as Second;
\definition cellularPullback: Modules.Hom[V := TargetCellH.Cohomology, W := SourceCellH.Cohomology,
  source := TargetCellH.cohomologySpace, target := SourceCellH.cohomologySpace].Map :=
  Second.compose (sourceIsomorphism).forward (First.compose singularPullback (targetIsomorphism).backward);
\definition naturality[q: TargetH.Cohomology]:
  (cellularPullback).apply (((targetIsomorphism).forward).apply q) = ((sourceIsomorphism).forward).apply ((singularPullback).apply q) :=
  congr!{TargetH.Cohomology SourceCellH.Cohomology}
    (\fun (x: TargetH.Cohomology) => ((sourceIsomorphism).forward).apply ((singularPullback).apply x)) _ _ ((targetIsomorphism).leftInverse q);
\definition comparisonInverse[q: TargetCellH.Cohomology]:
  ((sourceIsomorphism).backward).apply ((cellularPullback).apply q) = (singularPullback).apply (((targetIsomorphism).backward).apply q) :=
  (sourceIsomorphism).leftInverse ((singularPullback).apply (((targetIsomorphism).backward).apply q));
