\import Cochains.At[C := SourceOrdinary.complex, z := z] \as SourceH;
\import Cochains.At[C := TargetOrdinary.complex, z := z] \as TargetH;
\import Cochains.At[C := SourceCellular.complex, z := z] \as SourceCellH;
\import Cochains.At[C := TargetCellular.complex, z := z] \as TargetCellH;
\definition sourceIsomorphism: Modules.Isomorphism[V := SourceH.Cohomology, W := SourceCellH.Cohomology,
  source := SourceH.cohomologySpace, target := SourceCellH.cohomologySpace].Isomorphism := SourceComparison.With[coefficients := output].At[z := z].isomorphism;
\definition targetIsomorphism: Modules.Isomorphism[V := TargetH.Cohomology, W := TargetCellH.Cohomology,
  source := TargetH.cohomologySpace, target := TargetCellH.cohomologySpace].Isomorphism := TargetComparison.With[coefficients := input].At[z := z].isomorphism;
\module Along(f: A -> B, continuous: Maps.Continuous f);
