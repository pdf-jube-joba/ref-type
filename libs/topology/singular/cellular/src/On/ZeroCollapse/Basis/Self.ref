\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Characteristic[other := cell, p := Disk.origin] \as Point;
\import sphere_maps.ZeroHomology[].Sphere[] \as SpherePoints;
\definition onGenerator: (Functional.coordinate).apply (Basis.generator cell) = I.One.specification :=
  eq_reason_in!{I.Int^ _
    "=" _ "by" { congr!{{Layer.Homology[z := degree].Carrier} I.Int^} ((Functional.coordinate).apply) _ _ Point.onGenerator }
    "=" _ "by" { Functional.onProjection (Points.class Point.point) }
    "=" _ "by" { Functional.onPoint Point.point }
    "=" _ "by" { congr!{{algebraic_topology.Spheres[].Carrier zero} I.Int^}
            (\fun (x: algebraic_topology.Spheres[].Carrier zero) => (SpherePoints.cochain).apply
              (singular_cohomology.Chains[A := algebraic_topology.Spheres[].Carrier zero, source := algebraic_topology.Spheres[].topology zero].generator zero
                (singular_cohomology.Simplices[A := algebraic_topology.Spheres[].Carrier zero, source := algebraic_topology.Spheres[].topology zero].At[n := zero].constant x))) _ _
            (onCharacteristic Disk.origin) }
    "=" _ "by" SpherePoints.north
  };
\import singular_cellular_algebra.Algebra[].IntegerLine[W := I.Int^, target := Modules.scalarModule] \as Scalars;
\import Modules.Hom[V := Free.Carrier, W := I.Int^, source := Free.space, target := Modules.scalarModule]
  .Composition[U := I.Int^, domain := Modules.scalarModule] \as Composition;
\definition line: Modules.Hom[V := I.Int^, W := I.Int^, source := Modules.scalarModule, target := Modules.scalarModule].Map :=
  Composition.compose (Rows.compose Functional.coordinate (Basis.isomorphism).forward) Free.Injection[i := cell].map;
\definition onScalar[a: I.Int^]: (Functional.coordinate).apply (((Basis.isomorphism).forward).apply ((Free.Injection[i := cell].map).apply a)) = a :=
  eq_reason_in!{I.Int^ _
    "=" _ "by" { Scalars.onScalar line a }
    "=" _ "by" { congr!{I.Int^ I.Int^} (\fun (x: I.Int^) => (Modules.scalarModule).smul a x) _ _ onGenerator }
    "=" _ "by" { (((Integers.ring).semiring).multiplicative).rightIdentity a }
  };
