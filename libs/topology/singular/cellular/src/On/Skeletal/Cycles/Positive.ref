\import \parent.\parent.\parent.Layer[n := N.Nat^::succ k].Homology[z := I.Int^::ofNat (N.Nat^::succ k)] \as Pair;
\import \parent.\parent.\parent.Layer[n := k].Homology[z := I.Int^::ofNat k] \as LowerPair;
\import Complexes.At[C := Cellular.integerComplex, z := I.Int^::ofNat (N.Nat^::succ k)] \as PositiveCell;
\definition projectedClosed: \forall (q: homology (N.Nat^::succ (N.Nat^::succ k)) (I.Int^::ofNat (N.Nat^::succ k))) ->
  (Cellular.integerComplex.differential).apply (I.Int^::ofNat (N.Nat^::succ k))
    (CellExtension.Positive[n := N.Nat^::succ k].intro ((Pair.projection).apply q)) = (CellExtension.space (I.Int^::ofNat k)).zero :=
  \fun (q: _) => trans!{{Cellular.Carrier k}} _ _ _
    (congr!{{homology (N.Nat^::succ k) (I.Int^::ofNat k)} {Cellular.Carrier k}} ((LowerPair.projection).apply) _ _ (Pair.projectionConnectingZero q))
    (Modules.Hom[V := homology (N.Nat^::succ k) (I.Int^::ofNat k), W := Cellular.Carrier k,
      source := space (N.Nat^::succ k) (I.Int^::ofNat k), target := Cellular.space k].zeroPreserved LowerPair.projection);
\definition connectingZero: \forall (q: PositiveCell.Cycle) -> (Pair.connecting).apply q = (\parent.\parent.At[limit := N.Nat^::succ k, z := I.Int^::ofNat k].space).zero :=
  \fun (q: PositiveCell.Cycle) => \parent.\parent.Top[n := k].projectionInjective _ _
    (trans!{{Cellular.Carrier k}} _ _ _
      (\bysub(CellExtension.Carrier (I.Int^::ofNat (N.Nat^::succ k)), (PositiveCell.cycles).carrier, q))
      (sym!{{Cellular.Carrier k}} _ _
        (Modules.Hom[V := homology (N.Nat^::succ k) (I.Int^::ofNat k), W := Cellular.Carrier k,
          source := space (N.Nat^::succ k) (I.Int^::ofNat k), target := Cellular.space k].zeroPreserved LowerPair.projection)));
