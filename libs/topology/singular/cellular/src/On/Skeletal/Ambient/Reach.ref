\import \parent.\parent.\parent.Filtration[].Stage[limit := limit extra] \as Stage;
\import singular_cohomology.Chains[A := Stage.Carrier, source := Stage.topology] \as Chains;
\import Nonnegative.ZeroExtension[C := Chains.complex] \as Extension;
\import Complexes.At[C := Extension.complex, z := degree] \as Homology;
\import Modules.Isomorphism[V := InitialHomology.Homology, W := Homology.Homology,
  source := InitialHomology.homologySpace, target := Homology.homologySpace] \as Isomorphisms;
\definition Isomorphism: \Set := Isomorphisms.Isomorphism;
\definition bound: Nat.Le base (limit extra) := Nat.leAddRight base extra;
\import \parent.\parent.\parent.Filtration[].Inclusion[m := base, n := limit extra] \as Inclusion;
\import singular_cohomology.Maps[A := Initial.Carrier, B := Stage.Carrier,
  source := Initial.topology, target := Stage.topology] \as Maps;
\definition chainMap: Complexes.Map[C := InitialExtension.complex, D := Extension.complex].Map := Inclusion.chainMap bound;
\import Complexes.Map[C := InitialExtension.complex, D := Extension.complex].At[k := degree] \as Induced;
\definition map: Modules.Hom[V := InitialHomology.Homology, W := Homology.Homology, source := InitialHomology.homologySpace, target := Homology.homologySpace].Map := Induced.induced chainMap;
\module Zero;
\module Step;
\definition identity: \parent.Reach[extra := N.Nat^::zero].Isomorphism := Zero[].isomorphism;
\definition identityEquation: \forall (q: InitialHomology.Homology) ->
  ((identity).forward).apply q = (\parent.Reach[extra := N.Nat^::zero].map).apply q := Zero[].equation;
\definition extend[previous: Isomorphism]: \parent.Reach[extra := N.Nat^::succ extra].Isomorphism := Step[].extend previous;
\definition extendEquation: \forall (previous: Isomorphism) ->
  (\forall (q: InitialHomology.Homology) -> ((previous).forward).apply q = (map).apply q) ->
  \forall (q: InitialHomology.Homology) ->
    ((extend previous).forward).apply q = (\parent.Reach[extra := N.Nat^::succ extra].map).apply q := Step[].equation;
