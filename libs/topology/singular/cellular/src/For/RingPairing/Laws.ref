
\module Left(x: P.family.Carrier p, y: Q.family.Carrier q);

\module Right(x: P.family.Carrier p);
\definition laws: Pure.BilinearLaws[R, integerCoefficients.space, value alpha beta] := Pure.BilinearLaws[R, integerCoefficients.space, value alpha beta] {
  addLeft := \fun (x1, x2: P.family.Carrier p)(y: Q.family.Carrier q) => Left[x := x1, y := y].addition x1 x2,
  addRight := \fun (x: P.family.Carrier p)(y1, y2: Q.family.Carrier q) => Right[x := x].addition y1 y2,
  scaleLeft := \fun (a: I.Int^)(x: P.family.Carrier p)(y: Q.family.Carrier q) => Left[x := x, y := y].scalar a,
  scaleRight := \fun (a: I.Int^)(x: P.family.Carrier p)(y: Q.family.Carrier q) => Right[x := x].scalar a y,
};
