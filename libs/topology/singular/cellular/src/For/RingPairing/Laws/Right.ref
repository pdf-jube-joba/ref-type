\use std.Logic[].Equality[].eq_reason_in;
\import Abelian.Scalar[a := (alpha).apply x] \as Scalar;
\definition addition[y1, y2: Q.family.Carrier q]: value alpha beta x ((Q.family.space q).add y1 y2) = (integerCoefficients.space).add (value alpha beta x y1) (value alpha beta x y2) :=
  eq_reason_in!{R _
    "=" _ "by" { commuted alpha beta x ((Q.family.space q).add y1 y2) }
    "=" _ "by" { congr!{R R} ((baseRing).mul ((alpha).apply x)) _ _ ((beta).addition y1 y2) }
    "=" _ "by" { (Scalar.map).addition ((beta).apply y1) ((beta).apply y2) }
    "=" _ "by" { sym!{R} _ _ (congr!{R R R} ((integerCoefficients.space).add) _ _ _ _ (commuted alpha beta x y1) (commuted alpha beta x y2)) }
  };
\definition scalar[a: I.Int^][y: Q.family.Carrier q]: value alpha beta x ((Q.family.space q).smul a y) = (integerCoefficients.space).smul a (value alpha beta x y) :=
  eq_reason_in!{R _
    "=" _ "by" { commuted alpha beta x ((Q.family.space q).smul a y) }
    "=" _ "by" { congr!{R R} ((baseRing).mul ((alpha).apply x)) _ _ ((beta).scalar a y) }
    "=" _ "by" { (Scalar.map).scalar a ((beta).apply y) }
    "=" _ "by" { sym!{R} _ _ (congr!{R R} ((integerCoefficients.space).smul a) _ _ (commuted alpha beta x y)) }
  };
