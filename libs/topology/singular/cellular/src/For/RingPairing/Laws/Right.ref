\import Abelian.Scalar[a := (alpha).apply x] \as Scalar;
\definition addition[y1, y2: Q.family.Carrier q]: value alpha beta x ((Q.family.space q).add y1 y2) = (integerCoefficients.space).add (value alpha beta x y1) (value alpha beta x y2) :=
  trans!{R} _ _ _ (commuted alpha beta x ((Q.family.space q).add y1 y2))
    (trans!{R} _ _ _
      (congr!{R R} ((baseRing).mul ((alpha).apply x)) _ _ ((beta).addition y1 y2))
      (trans!{R} _ _ _ ((Scalar.map).addition ((beta).apply y1) ((beta).apply y2))
        (sym!{R} _ _ (congr2!{R R R} ((integerCoefficients.space).add) _ _ _ _ (commuted alpha beta x y1) (commuted alpha beta x y2)))));
\definition scalar[a: I.Int^][y: Q.family.Carrier q]: value alpha beta x ((Q.family.space q).smul a y) = (integerCoefficients.space).smul a (value alpha beta x y) :=
  trans!{R} _ _ _ (commuted alpha beta x ((Q.family.space q).smul a y))
    (trans!{R} _ _ _
      (congr!{R R} ((baseRing).mul ((alpha).apply x)) _ _ ((beta).scalar a y))
      (trans!{R} _ _ _ ((Scalar.map).scalar a ((beta).apply y))
        (sym!{R} _ _ (congr!{R R} ((integerCoefficients.space).smul a) _ _ (commuted alpha beta x y)))));
