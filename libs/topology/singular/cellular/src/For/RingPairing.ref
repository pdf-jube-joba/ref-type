\import std.Data[].Nat[] \as N;
\import N.Basic[].Def[] \as Nat;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Alg[].Ring[] \as Rings;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\definition baseRing: Rings.Ring[R] := Rings.commutativeRingAsRing R ring;
\import module_theory.Module[].Over[R := R, ring := baseRing] \as Scalars;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\definition coefficients: Scalars.Bundle := Scalars.Bundle { Carrier := R, space := Scalars.scalarModule };
\import Scalars.AbelianHom[N := coefficients] \as Abelian;
\definition integerCoefficients: Modules.Bundle := Modules.Bundle { Carrier := R, space := Abelian.coefficients.space };
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\import Double.Tensor[C := P, D := Q] \as Tensor;
\import Double.Total[C := Tensor.complex] \as Total;
\import Double.Coordinates[C := Tensor.complex] \as Coordinates;
\import Tensor.Term[p := p, q := q] \as Term;
\import Modules.Tensor[V := P.family.Carrier p, W := Q.family.Carrier q, left := P.family.space p, right := Q.family.space q] \as Pure;
\import Pure.Universal[U := R, target := integerCoefficients.space] \as Universal;
\definition n: N.Nat^ := Nat.add p q;
\definition LeftCochain[k: N.Nat^]: \Set := Modules.Hom[V := P.family.Carrier k, W := R,
  source := P.family.space k, target := integerCoefficients.space].Map;
\definition RightCochain[k: N.Nat^]: \Set := Modules.Hom[V := Q.family.Carrier k, W := R,
  source := Q.family.space k, target := integerCoefficients.space].Map;
\definition value[alpha: LeftCochain p][beta: RightCochain q][x: P.family.Carrier p][y: Q.family.Carrier q]: R := (baseRing).mul ((beta).apply y) ((alpha).apply x);
\definition commuted[alpha: LeftCochain p][beta: RightCochain q][x: P.family.Carrier p][y: Q.family.Carrier q]: value alpha beta x y = (baseRing).mul ((alpha).apply x) ((beta).apply y) := (ring).mulCommutative ((beta).apply y) ((alpha).apply x);
\module Laws(alpha: LeftCochain p, beta: RightCochain q);
\definition bilinear[alpha: LeftCochain p][beta: RightCochain q]: Pure.BilinearLaws[R, integerCoefficients.space, value alpha beta] := Laws[alpha := alpha, beta := beta].laws;
\definition map[alpha: LeftCochain p][beta: RightCochain q]: Modules.Hom[V := Term.Carrier, W := R, source := Term.space, target := integerCoefficients.space].Map := Universal.map (value alpha beta) (bilinear alpha beta);
\definition onTensor[alpha: LeftCochain p][beta: RightCochain q][x: P.family.Carrier p][y: Q.family.Carrier q]: (map alpha beta).apply (Term.tensor x y) = (baseRing).mul ((alpha).apply x) ((beta).apply y) :=
  trans!{R} _ _ _ (Universal.onTensor (value alpha beta) (bilinear alpha beta) x y) (commuted alpha beta x y);
\import Coordinates.Step[p := p, q := q] \as Position;
\definition index: Double.Index n := Position.targetIndex;
\import Coordinates.Degree[n := n] \as Current;
\import Modules.Hom[V := Term.Carrier, W := R, source := Term.space, target := integerCoefficients.space].Composition[U := Total.Carrier n, domain := Total.space n] \as Compose;
\definition total[alpha: LeftCochain p][beta: RightCochain q]: Modules.Hom[V := Total.Carrier n, W := R, source := Total.space n, target := integerCoefficients.space].Map := Compose.compose (map alpha beta) Current.At[i := index].map;
\module Mapping(C, D: Native.Complex);
