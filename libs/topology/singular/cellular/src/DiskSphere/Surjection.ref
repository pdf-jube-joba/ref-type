\import \parent.Scalars[] \as Scalars;
\import \parent.Fibers[] \as Fibers;
\import algebraic_topology.Spheres[].Positive[n := n] \as Sphere;
\module Away(y: Ambient.Sphere, different: Logic.Not (Split.head y = Real.one));
\import algebraic_topology.Euclidean[].Dimension[n := n].Splitting[] \as BoundaryPole;
\definition boundaryPoint: Disk.Disk := \into[Disk.Coordinate](BoundaryPole.north, Disk.ClosedBall) \by {
  R.leReplaceLeft Real.one (Disk.normSquared BoundaryPole.north) Real.one
    (sym!{Real.Real} _ _ (\bysub(Disk.Coordinate, Disk.Boundary, BoundaryPole.north))) (R.leRefl Real.one)
};
\definition onto: \forall (y: Ambient.Sphere) -> \exists ( x: Disk.Disk \where map x = y ) :=
  \fun (y: Ambient.Sphere) => either!{{(Classical.excludedMiddle (Split.head y = Real.one))}
    {\exists ( x: Disk.Disk \where map x = y )}
    {\fun (pole: _) => Logic.existsIntro[Disk.Disk, { x: Disk.Disk \where map x = y }] boundaryPoint
      (trans!{Ambient.Sphere} _ _ _ (Fibers.onBoundary boundaryPoint (\bysub(Disk.Coordinate, Disk.Boundary, BoundaryPole.north)))
        (sym!{Ambient.Sphere} _ _ (Split.Pole[].determined y Real.one (Laws.fieldMulOneLeft Real.one) pole)))}
    {\fun (different: _) => Logic.existsIntro[Disk.Disk, { x: Disk.Disk \where map x = y }]
      Away[y := y, different := different].point Away[y := y, different := different].onPoint}
  };
