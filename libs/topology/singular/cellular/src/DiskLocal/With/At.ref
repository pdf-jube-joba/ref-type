\definition neighborhood: Modules.Isomorphism[V := Expanded.With[coefficients := coefficients].At[z := z].Carrier, W := Original.With[coefficients := coefficients].At[z := z].Carrier,
  source := Expanded.With[coefficients := coefficients].At[z := z].space, target := Original.With[coefficients := coefficients].At[z := z].space].Isomorphism :=
  Pull.Comparison[].At[z := z].isomorphism subspaceQuasi wholeQuasi;
\definition excision: Modules.Isomorphism[V := Expanded.With[coefficients := coefficients].At[z := z].Carrier, W := Excised.With[coefficients := coefficients].At[z := z].Carrier,
  source := Expanded.With[coefficients := coefficients].At[z := z].space, target := Excised.With[coefficients := coefficients].At[z := z].space].Isomorphism :=
  Excision.With[coefficients := coefficients].At[z := z].isomorphism pair;
\import Modules.Isomorphism[V := Expanded.With[coefficients := coefficients].At[z := z].Carrier, W := Original.With[coefficients := coefficients].At[z := z].Carrier,
  source := Expanded.With[coefficients := coefficients].At[z := z].space, target := Original.With[coefficients := coefficients].At[z := z].space].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := Original.With[coefficients := coefficients].At[z := z].Carrier, W := Expanded.With[coefficients := coefficients].At[z := z].Carrier,
  source := Original.With[coefficients := coefficients].At[z := z].space, target := Expanded.With[coefficients := coefficients].At[z := z].space]
  .Composition[U := Excised.With[coefficients := coefficients].At[z := z].Carrier, final := Excised.With[coefficients := coefficients].At[z := z].space] \as Composition;
\definition excisedIsomorphism: Modules.Isomorphism[V := Original.With[coefficients := coefficients].At[z := z].Carrier, W := Excised.With[coefficients := coefficients].At[z := z].Carrier,
  source := Original.With[coefficients := coefficients].At[z := z].space, target := Excised.With[coefficients := coefficients].At[z := z].space].Isomorphism :=
  Composition.compose excision (Inverse.inverse neighborhood);
\import Modules.Isomorphism[V := Local.With[coefficients := coefficients].At[z := z].Carrier, W := Excised.With[coefficients := coefficients].At[z := z].Carrier,
  source := Local.With[coefficients := coefficients].At[z := z].space, target := Excised.With[coefficients := coefficients].At[z := z].space].Inverse[] \as LocalInverse;
\import Modules.Isomorphism[V := Original.With[coefficients := coefficients].At[z := z].Carrier, W := Excised.With[coefficients := coefficients].At[z := z].Carrier,
  source := Original.With[coefficients := coefficients].At[z := z].space, target := Excised.With[coefficients := coefficients].At[z := z].space]
  .Composition[U := Local.With[coefficients := coefficients].At[z := z].Carrier, final := Local.With[coefficients := coefficients].At[z := z].space] \as LocalComposition;
\definition isomorphism: Modules.Isomorphism[V := Original.With[coefficients := coefficients].At[z := z].Carrier, W := Local.With[coefficients := coefficients].At[z := z].Carrier,
  source := Original.With[coefficients := coefficients].At[z := z].space, target := Local.With[coefficients := coefficients].At[z := z].space].Isomorphism :=
  LocalComposition.compose (LocalInverse.inverse (\parent.\parent.Identification[].With[coefficients := coefficients].At[z := z].isomorphism)) excisedIsomorphism;
