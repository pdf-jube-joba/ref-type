\import algebraic_topology.Collapse[A := Model.Disk, subset := boundary].Open[source := Model.diskTopology] \as Neighborhoods;
\definition neighborhood: Neighborhoods.Neighborhood := Neighborhoods.Neighborhood {
  region := Collar.punctured, open := puncturedOpen, contains := included,
};
\import algebraic_topology.NeighborhoodRetract[A := Model.Disk, source := Model.diskTopology, subset := boundary] \as Geometry;
\definition pair: Geometry.Data := Geometry.Data {
  point := point, closed := boundaryClosed, neighborhood := neighborhood, deformation := Collar.Deformation[].deformation,
};
