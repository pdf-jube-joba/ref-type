\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import topology.Homeomorphism[A := A, B := B] \as Original;
\definition laws: Original.Laws[source, target, e] := Original.laws source target e;
\import topological_constructions.Product[A := X, B := A] \as Source;
\import topological_constructions.Product[A := X, B := B] \as Target;
\import Source.Maps[] \as SourceProjections;
\import Target.Maps[] \as TargetProjections;
\import Target.Universal[X := Source.CarrierSet] \as IntoTarget;
\import Source.Universal[X := Target.CarrierSet] \as IntoSource;
\definition forward[p: Source.CarrierSet]: Target.CarrierSet := Pair.pair X B (Pair.first X A p) ((e).forward (Pair.second X A p));
\definition backward[p: Target.CarrierSet]: Source.CarrierSet := Pair.pair X A (Pair.first X B p) ((e).backward (Pair.second X B p));
\import topology.Composition[A := Source.CarrierSet, B := A, C := B] \as ForwardComposition;
\import topology.Composition[A := Target.CarrierSet, B := B, C := A] \as BackwardComposition;
\definition forwardContinuous: topology.Continuity[A := Source.CarrierSet, B := Target.CarrierSet].Continuous
  (Source.topology factor source) (Target.topology factor target) forward :=
  IntoTarget.pairContinuous (Source.topology factor source) factor target (Pair.first X A)
    (\fun (p: Source.CarrierSet) => (e).forward (Pair.second X A p)) (SourceProjections.firstContinuous factor source)
    (ForwardComposition.composeContinuous (Source.topology factor source) source target (Pair.second X A) ((e).forward)
      (SourceProjections.secondContinuous factor source) ((laws).forwardContinuous));
\definition backwardContinuous: topology.Continuity[A := Target.CarrierSet, B := Source.CarrierSet].Continuous
  (Target.topology factor target) (Source.topology factor source) backward :=
  IntoSource.pairContinuous (Target.topology factor target) factor source (Pair.first X B)
    (\fun (p: Target.CarrierSet) => (e).backward (Pair.second X B p)) (TargetProjections.firstContinuous factor target)
    (BackwardComposition.composeContinuous (Target.topology factor target) target source (Pair.second X B) ((e).backward)
      (TargetProjections.secondContinuous factor target) ((laws).backwardContinuous));
\import Pair.Prop[A := X, B := A] \as SourcePairs;
\import Pair.Prop[A := X, B := B] \as TargetPairs;
\definition homeomorphism: topology.Homeomorphism[A := Source.CarrierSet, B := Target.CarrierSet]
  .Homeomorphism[Source.topology factor source, Target.topology factor target] :=
  topology.Homeomorphism[A := Source.CarrierSet, B := Target.CarrierSet].Homeomorphism[Source.topology factor source, Target.topology factor target] {
    forward := forward, backward := backward,
    leftInverse := \fun (p: Source.CarrierSet) => trans!{Source.CarrierSet} _ _ _
      (congr!{A Source.CarrierSet} (Pair.pair X A (Pair.first X A p)) _ _ ((laws).leftInverse (Pair.second X A p))) (SourcePairs.eta p),
    rightInverse := \fun (p: Target.CarrierSet) => trans!{Target.CarrierSet} _ _ _
      (congr!{B Target.CarrierSet} (Pair.pair X B (Pair.first X B p)) _ _ ((laws).rightInverse (Pair.second X B p))) (TargetPairs.eta p),
    forwardContinuous := forwardContinuous, backwardContinuous := backwardContinuous,
  };
