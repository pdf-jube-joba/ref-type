\import Complexes.At[C := C, z := z] \as H;
\definition law[x, y: H.Cycle][same: H.forget x = H.forget y]: x = y :=
  H.cycleExt x y same;
\definition onClass[x, y: H.Cycle][same: H.forget x = H.forget y]: H.classOf x = H.classOf y :=
  H.cycleClassExt x y same;
\definition forget[x, y: H.Cycle][same: x = y]: H.forget x = H.forget y :=
  congr!{H.Cycle {C.family.Carrier z}} H.forget x y same;
