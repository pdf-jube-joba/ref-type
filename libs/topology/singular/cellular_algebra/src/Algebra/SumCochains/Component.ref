\import Hom.Integer[P := terms i, N := coefficients] \as Native;
\definition Carrier[z: I.Int^]: \Set := Native.Carrier z;
\definition space[z: I.Int^]: Modules.Space (Carrier z) := Native.space z;
\definition apply: _ := Native.apply;
\definition addition: _ := Native.addition;
\definition scalar: _ := Native.scalar;
\definition squareZero: _ := Native.squareZero;
\definition complex: Cochains.Complex := Native.complex;
\import Hom.IntegerMapping[P := terms i, Q := Sum.complex, N := coefficients, L := coefficients]
  .On[f := Sum.Injection[i := i].map, u := Coefficients.identity] \as Pull;
\definition map: Cochains.Map[C := Source.complex, D := complex].Map := Pull.cochainMap;
