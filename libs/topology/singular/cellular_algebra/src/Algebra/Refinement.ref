\definition Carrier: \Set := \Cast[A] S;
\definition forget[x: Carrier]: A := x;
\definition into[x: A][inside: \In[A] S x]: Carrier := \into[A](x, S) \by { inside };
\definition ext[x, y: Carrier][same: forget x = forget y]: x = y :=
  (\idelim forget x = forget y \with value: A =>
    \forall (inside: \In[A] S value) -> x = into value inside \by {
      base: \fun (inside: _) => \refl(x), equality: same
    }) (\bysub(A, S, y));
\definition forgetEquality[x, y: Carrier][same: x = y]: forget x = forget y :=
  congr!{Carrier A} forget x y same;
