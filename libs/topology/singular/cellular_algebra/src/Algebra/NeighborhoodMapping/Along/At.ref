\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Homology[z := z] \as Comparison;
\import Modules.Isomorphism[V := TargetSmall.Homology[z := z].Carrier, W := TargetExpanded.Homology[z := z].Carrier,
  source := TargetSmall.Homology[z := z].space, target := TargetExpanded.Homology[z := z].space] \as Invert;
\definition cancel[x, y: TargetSmall.Homology[z := z].Carrier]
  [same: ((Comparison.targetExcisionIsomorphism).forward).apply x = ((Comparison.targetExcisionIsomorphism).forward).apply y]: x = y :=
  eq_reason_in!{{TargetSmall.Homology[z := z].Carrier} _
    "=" _ "by" { sym!{{TargetSmall.Homology[z := z].Carrier}} _ _ ((Comparison.targetExcisionIsomorphism).leftInverse x) }
    "=" _ "by" { congr!{{TargetExpanded.Homology[z := z].Carrier} {TargetSmall.Homology[z := z].Carrier}} (((Comparison.targetExcisionIsomorphism).backward).apply) _ _ same }
    "=" _ "by" { (Comparison.targetExcisionIsomorphism).leftInverse y }
  };
\definition law: \forall (q: Source.Homology[z := z].Carrier) ->
  (SmallAction.At[z := z].induced).apply (((Comparison.source).forward).apply q) =
  ((Comparison.target).forward).apply ((OriginalAction.At[z := z].induced).apply q) :=
  \fun (q: Source.Homology[z := z].Carrier) => cancel _ _
    (eq_reason_in!{{TargetExpanded.Homology[z := z].Carrier} _
      "=" _ "by" { ExcisionSquare.Homology[z := z].law (\fun (x: sourceSmall.Carrier) => \refl(data.map x)) (((Comparison.source).forward).apply q) }
      "=" _ "by" { congr!{{SourceExpanded.Homology[z := z].Carrier} {TargetExpanded.Homology[z := z].Carrier}} ((ExpandedAction.At[z := z].induced).apply) _ _
          ((Comparison.sourceExcisionIsomorphism).rightInverse (((Comparison.sourceNeighborhood).forward).apply q)) }
      "=" _ "by" { sym!{{TargetExpanded.Homology[z := z].Carrier}} _ _ (NeighborhoodSquare.Homology[z := z].law (\fun (x: a.base.Carrier) => \refl(data.map x)) q) }
      "=" _ "by" { sym!{{TargetExpanded.Homology[z := z].Carrier}} _ _
            ((Comparison.targetExcisionIsomorphism).rightInverse (((Comparison.targetNeighborhood).forward).apply ((OriginalAction.At[z := z].induced).apply q))) }
    });
