\use std.Logic[].Equality[].eq_reason_in;
\import \parent.IntegerLine[W := B.Carrier, target := B.space] \as Line;
\import Modules.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space]
  .Composition[U := I.Int^, domain := Modules.scalarModule] \as Compose;
\definition Positive: \Prop := (f).apply (((sourceOrientation).forward).apply I.One.specification) = ((targetOrientation).forward).apply I.One.specification;
\definition equation[positive: Positive]: Compose.compose f (sourceOrientation).forward = (targetOrientation).forward := Line.ext (Compose.compose f (sourceOrientation).forward) (targetOrientation).forward positive;
\import Modules.Hom[V := I.Int^, W := B.Carrier, source := Modules.scalarModule, target := B.space] \as Linear;
\definition onScalar[positive: Positive][a: I.Int^]: (f).apply (((sourceOrientation).forward).apply a) = ((targetOrientation).forward).apply a :=
  congr!{Linear.Map B.Carrier} (\fun (g: Linear.Map) => (g).apply a) _ _ (equation positive);
\definition coordinate[positive: Positive][q: A.Carrier]: ((sourceOrientation).backward).apply q = ((targetOrientation).backward).apply ((f).apply q) :=
  eq_reason_in!{I.Int^ _
    "=" _ "by" { sym!{I.Int^} _ _ ((targetOrientation).leftInverse (((sourceOrientation).backward).apply q)) }
    "=" _ "by" { congr!{B.Carrier I.Int^} (((targetOrientation).backward).apply) _ _ (sym!{B.Carrier} _ _ (onScalar positive (((sourceOrientation).backward).apply q))) }
    "=" _ "by" { congr!{A.Carrier I.Int^} (\fun (x: A.Carrier) => ((targetOrientation).backward).apply ((f).apply x)) _ _ ((sourceOrientation).rightInverse q) }
  };
