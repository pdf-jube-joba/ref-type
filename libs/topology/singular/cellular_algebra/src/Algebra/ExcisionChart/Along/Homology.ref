\definition upperLeft: Modules.Bundle := Modules.Bundle { Carrier := SourceSmall.Homology[z := z].Carrier, space := SourceSmall.Homology[z := z].space };
\definition upperRight: Modules.Bundle := Modules.Bundle { Carrier := TargetSmall.Homology[z := z].Carrier, space := TargetSmall.Homology[z := z].space };
\definition lowerLeft: Modules.Bundle := Modules.Bundle { Carrier := Source.Homology[z := z].Carrier, space := Source.Homology[z := z].space };
\definition lowerRight: Modules.Bundle := Modules.Bundle { Carrier := Target.Homology[z := z].Carrier, space := Target.Homology[z := z].space };
\import Modules.IsomorphismSquare[A := upperLeft, B := upperRight, C := lowerLeft, D := lowerRight] \as Transport;
\definition isomorphism[agrees: Agrees]: Modules.Isomorphism[V := lowerLeft.Carrier, W := lowerRight.Carrier, source := lowerLeft.space, target := lowerRight.space].Isomorphism :=
  Transport.transport (SourceExcision.Homology[z := z].isomorphism sourcePair) (TargetExcision.Homology[z := z].isomorphism targetPair)
    (Charts.Homology[z := z].isomorphism chart) Action.At[z := z].induced
    (\fun (q: upperLeft.Carrier) => sym!{lowerRight.Carrier} _ _ (Square.Homology[z := z].law agrees q));
