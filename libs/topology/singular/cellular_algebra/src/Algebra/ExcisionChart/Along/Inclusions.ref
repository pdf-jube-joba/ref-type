\import SourceSmall.Maps[B := a.base.Carrier].Over[target := a.base.topology, targetSubset := a.base.subset] \as SourceMaps;
\import TargetSmall.Maps[B := b.base.Carrier].Over[target := b.base.topology, targetSubset := b.base.subset] \as TargetMaps;
\import topology.Continuity[A := sourceSmall.Carrier, B := a.base.Carrier]
  .Corestriction[S := SourceSpace.Complement a.removed] \as SourceEmbedding;
\import topology.Continuity[A := targetSmall.Carrier, B := b.base.Carrier]
  .Corestriction[S := TargetSpace.Complement b.removed] \as TargetEmbedding;
\definition sourceFunction[x: sourceSmall.Carrier]: a.base.Carrier := x;
\definition targetFunction[x: targetSmall.Carrier]: b.base.Carrier := x;
\definition source: SourceMaps.Map := \into[sourceSmall.Carrier -> a.base.Carrier](sourceFunction, SourceMaps.Map) \by {
  SourceMaps.Laws[sourceFunction] {
    continuous := SourceEmbedding.inclusionContinuous a.base.topology,
    contained := \fun (x: SourceSmall.SubspaceCarrier) => \bysub(sourceSmall.Carrier, sourceSmall.subset, x),
  }
};
\definition target: TargetMaps.Map := \into[targetSmall.Carrier -> b.base.Carrier](targetFunction, TargetMaps.Map) \by {
  TargetMaps.Laws[targetFunction] {
    continuous := TargetEmbedding.inclusionContinuous b.base.topology,
    contained := \fun (x: TargetSmall.SubspaceCarrier) => \bysub(targetSmall.Carrier, targetSmall.subset, x),
  }
};
