\definition map: Modules.Hom[V := I.Int^, W := Free.Carrier, source := Modules.scalarModule, target := Free.space].Map :=
  Modules.Hom[V := I.Int^, W := Free.Carrier, source := Modules.scalarModule, target := Free.space].Map {
    apply := \fun (a: I.Int^) => (Free.space).smul a (Free.generator i),
    addition := \fun (a, b: I.Int^) => (Free.space).scalarAdd a b (Free.generator i),
    scalar := \fun (a, b: I.Int^) => (Free.space).scalarAssoc a b (Free.generator i),
  };
