\import std.Data[].Nat[] \as N;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import topology.Topology[Carrier := A] \as Space;
\definition subset: \Pow A := Space.Singleton point;
\import singular_cohomology.Chains[A := A, source := source] \as Whole;
\import Whole.Reduced[] \as Reduced;
\import Native.ZeroExtension[C := Whole.complex] \as Extension;
\import singular_cohomology.Relative[A := A, source := source, subset := subset] \as Pair;
\definition basepoint: Pair.SubspaceCarrier := \into[A](point, subset) \by { \refl(point) };
\import Pair.Reduced[].Singleton[a := basepoint] \as Singleton;
\definition unique: Singleton.Unique := \fun (x: Pair.SubspaceCarrier) => \bysub(A, subset, x);
\module Positive(n: N.Nat^);
