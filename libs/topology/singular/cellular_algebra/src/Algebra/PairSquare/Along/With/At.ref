\use std.Logic[].Equality[].eq_reason_in;
\definition action[m: AD.Map]: Modules.Hom[V := D.With[coefficients := coefficients].At[z := z].Carrier,
  W := A.With[coefficients := coefficients].At[z := z].Carrier, source := D.With[coefficients := coefficients].At[z := z].space,
  target := A.With[coefficients := coefficients].At[z := z].space].Map := AD.On[f := m].Integer[].With[coefficients := coefficients].At[z := z].induced;
\definition law: \forall (compatible: Commutes)(q: D.With[coefficients := coefficients].At[z := z].Carrier) ->
  (F.With[coefficients := coefficients].At[z := z].induced).apply ((H.With[coefficients := coefficients].At[z := z].induced).apply q) =
    (G.With[coefficients := coefficients].At[z := z].induced).apply ((K.With[coefficients := coefficients].At[z := z].induced).apply q) :=
  \fun (compatible: Commutes)(q: D.With[coefficients := coefficients].At[z := z].Carrier) => eq_reason_in!{{A.With[coefficients := coefficients].At[z := z].Carrier} _
    "=" _ "by" { sym!{{A.With[coefficients := coefficients].At[z := z].Carrier}} _ _ (FirstComposition.With[coefficients := coefficients].law z q) }
    "=" _ "by" { congr!{AD.Map {A.With[coefficients := coefficients].At[z := z].Carrier}} (\fun (m: AD.Map) => (action m).apply q) _ _ (equality compatible) }
    "=" _ "by" { SecondComposition.With[coefficients := coefficients].law z q }
  };
