\use std.Logic[].Equality[].eq_reason_in;
\definition action[m: AD.Map]: Modules.Hom[V := A.Homology[z := z].Carrier, W := D.Homology[z := z].Carrier,
  source := A.Homology[z := z].space, target := D.Homology[z := z].space].Map := AD.On[f := m].Integer[].At[z := z].induced;
\definition law: \forall (compatible: Commutes)(q: A.Homology[z := z].Carrier) ->
  (H.At[z := z].induced).apply ((F.At[z := z].induced).apply q) = (K.At[z := z].induced).apply ((G.At[z := z].induced).apply q) :=
  \fun (compatible: Commutes)(q: A.Homology[z := z].Carrier) => eq_reason_in!{{D.Homology[z := z].Carrier} _
    "=" _ "by" { sym!{{D.Homology[z := z].Carrier}} _ _ (FirstComposition.Homology[z := z].law q) }
    "=" _ "by" { congr!{AD.Map {D.Homology[z := z].Carrier}} (\fun (m: AD.Map) => (action m).apply q) _ _ (equality compatible) }
    "=" _ "by" { SecondComposition.Homology[z := z].law q }
  };
