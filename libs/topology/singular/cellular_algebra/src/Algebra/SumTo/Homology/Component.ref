\use std.Logic[].Equality[].eq_reason_in;
\import Complexes.At[C := terms i, z := z] \as Source;
\import Complexes.Map[C := terms i, D := target] \as Direct;
\import Complexes.Map[C := Sum.complex, D := target].Composition[B := terms i] \as Composition;
\definition equation: Composition.compose map Sum.Injection[i := i].map = maps i :=
  Direct.ext _ _ (\fun (degree: I.Int^) => \parent.\parent.At[z := degree].onInjection i);
\import HomologySum.Injection[i := i] \as Injection;
\import Direct.At[k := z] \as DirectAction;
\import Composition.At[k := z] \as ComposedAction;
\definition onInjection: \forall (q: Source.Homology) ->
  (Action.induced map).apply ((SumHomology.forward).apply ((Injection.map).apply q)) =
  (DirectAction.induced (maps i)).apply q :=
  \fun (q: Source.Homology) => eq_reason_in!{Target.Homology _
    "=" _ "by" { congr!{{Complexes.At[C := Sum.complex, z := z].Homology} Target.Homology} ((Action.induced map).apply) _ _
      (Universal.onInjection SumHomology.components i q) }
    "=" _ "by" { sym!{Target.Homology} _ _ (ComposedAction.compositionOnHomology map Sum.Injection[i := i].map q) }
    "=" _ "by" { congr!{Direct.Map Target.Homology} (\fun (f: Direct.Map) => (DirectAction.induced f).apply q) _ _ equation }
  };
