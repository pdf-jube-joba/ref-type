\use std.Logic[].Equality[].eq_reason_in;
\definition previous: I.Int^ := Degrees.previous z;
\import \parent.\parent.At[z := previous] \as Lower;
\import Complexes.At[C := target, z := z] \as Differential;
\import Modules.DirectSum[Index := Index, family := Sum.Term[z := z].family].To[W := target.family.Carrier previous, target := target.family.space previous] \as Comparison;
\import Modules.Hom[V := target.family.Carrier z, W := target.family.Carrier previous, source := target.family.space z, target := target.family.space previous]
  .Composition[U := Sum.Term[z := z].Carrier, domain := Sum.Term[z := z].space] \as First;
\import Modules.Hom[V := Sum.Term[z := previous].Carrier, W := target.family.Carrier previous,
  source := Sum.Term[z := previous].space, target := target.family.space previous]
  .Composition[U := Sum.Term[z := z].Carrier, domain := Sum.Term[z := z].space] \as Second;
\import Modules.DirectSum[Index := Index, family := Sum.Term[z := previous].family].To[W := target.family.Carrier previous, target := target.family.space previous] \as LowerUniversal;
\definition onInjection: \forall (i: Index)(x: Sum.termCarrier i z) ->
  (Differential.differential).apply ((map).apply ((Sum.Term[z := z].Component[i := i].injection).apply x)) =
    (Lower.map).apply ((Sum.Step[z := z].map).apply ((Sum.Term[z := z].Component[i := i].injection).apply x)) :=
  \fun (i: Index)(x: Sum.termCarrier i z) => eq_reason_in!{{target.family.Carrier previous} _
    "=" _ "by" { congr!{{target.family.Carrier z} {target.family.Carrier previous}} ((Differential.differential).apply) _ _ (Universal.onInjection components i x) }
    "=" _ "by" { (maps i).commutes z x }
    "=" _ "by" { sym!{{target.family.Carrier previous}} _ _
        (LowerUniversal.onInjection Lower.components i (Sum.termApply i z x)) }
    "=" _ "by" { congr!{{Sum.Term[z := previous].Carrier} {target.family.Carrier previous}} ((Lower.map).apply) _ _
          (sym!{{Sum.Term[z := previous].Carrier}} _ _ (Sum.Step[z := z].onInjection i x)) }
  };
\definition equation: First.compose Differential.differential map = Second.compose Lower.map Sum.Step[z := z].map :=
  Comparison.ext _ _ onInjection;
\import Modules.Hom[V := Sum.Term[z := z].Carrier, W := target.family.Carrier previous, source := Sum.Term[z := z].space, target := target.family.space previous] \as Maps;
\definition commutes: \forall (x: Sum.Term[z := z].Carrier) ->
  (target.differential).apply z ((map).apply x) = (Lower.map).apply ((Sum.complex.differential).apply z x) :=
  \fun (x: Sum.Term[z := z].Carrier) => congr!{Maps.Map {target.family.Carrier previous}} (\fun (f: Maps.Map) => (f).apply x) _ _ equation;
