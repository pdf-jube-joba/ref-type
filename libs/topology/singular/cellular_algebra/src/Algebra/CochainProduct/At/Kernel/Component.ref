\import Cochains.At[C := terms i, z := z] \as H;
\import Cochains.Map[C := complex, D := terms i].At[k := z] \as Action;
\definition Fiber[x: Source.Closed]: \Set := \Cast[pointCarrier i (Degrees.previous z)]
  ({ y: pointCarrier i (Degrees.previous z) \where (H.prior).apply y = x i });
\definition inhabited: \forall (x: Source.Closed) -> (forward).apply (Source.classOf x) = (Product.space).zero -> \exists Fiber x :=
  \fun (x: Source.Closed)(killed: _) => H.zeroClassBoundary ((Action.cyclesMap \parent.\parent.\parent.Projection[i := i].map).apply x)
    (trans!{H.Cohomology} _ _ _ (sym!{H.Cohomology} _ _ (Action.onClass \parent.\parent.\parent.Projection[i := i].map x))
      (congr!{Product.Carrier H.Cohomology} (\fun (v: Product.Carrier) => v i) _ _ killed));
\definition coordinate: \forall (g: \parent.\parent.\parent.Term[z := Degrees.previous z].Carrier) -> (Prior.value z g) i = (H.prior).apply (g i) :=
  \fun (g: \parent.\parent.\parent.Term[z := Degrees.previous z].Carrier) => sym!{{pointCarrier i z}} _ _
    (Cochains.Map[C := complex, D := terms i].priorCommutes z \parent.\parent.\parent.Projection[i := i].map g);
