\import singular_excision.Excision[A := a.base.Carrier].Over[source := a.base.topology] \as SourceExcision;
\import singular_excision.Excision[A := b.base.Carrier].Over[source := b.base.topology] \as TargetExcision;
\definition sourcePair: SourceExcision.Pair := \into[SourceExcision.PairData](SourceExcision.PairData { subset := a.base.subset, removed := a.removed }, SourceExcision.Pair) \by { a.valid };
\definition targetPair: TargetExcision.Pair := \into[TargetExcision.PairData](TargetExcision.PairData { subset := b.base.subset, removed := b.removed }, TargetExcision.Pair) \by { b.valid };
\import topology.Topology[Carrier := a.base.Carrier] \as SourceSpace;
\import topology.Topology[Carrier := b.base.Carrier] \as TargetSpace;
\import SourceSpace.Subspace[S := SourceSpace.Complement a.removed] \as SourceRemaining;
\import TargetSpace.Subspace[S := TargetSpace.Complement b.removed] \as TargetRemaining;
\definition sourceSubset: \Pow SourceRemaining.CarrierSet := { x: SourceRemaining.CarrierSet \where SourceSpace.Member a.base.subset x };
\definition targetSubset: \Pow TargetRemaining.CarrierSet := { x: TargetRemaining.CarrierSet \where TargetSpace.Member b.base.subset x };
\definition sourceSmall: SpacePair := SpacePair { Carrier := SourceRemaining.CarrierSet, topology := SourceRemaining.topology a.base.topology, subset := sourceSubset };
\definition targetSmall: SpacePair := SpacePair { Carrier := TargetRemaining.CarrierSet, topology := TargetRemaining.topology b.base.topology, subset := targetSubset };
\import singular_cohomology.Relative[A := a.base.Carrier, source := a.base.topology, subset := a.base.subset] \as Source;
\import singular_cohomology.Relative[A := b.base.Carrier, source := b.base.topology, subset := b.base.subset] \as Target;
\import singular_cohomology.Relative[A := sourceSmall.Carrier, source := sourceSmall.topology, subset := sourceSmall.subset] \as SourceSmall;
\import singular_cohomology.Relative[A := targetSmall.Carrier, source := targetSmall.topology, subset := targetSmall.subset] \as TargetSmall;
\import SourceSmall.Homeomorphism[B := targetSmall.Carrier].Over[target := targetSmall.topology, targetSubset := targetSmall.subset] \as Charts;
\import Source.Maps[B := b.base.Carrier].Over[target := b.base.topology, targetSubset := b.base.subset] \as Maps;
\module Along(f: Maps.Map, chart: Charts.Data);
