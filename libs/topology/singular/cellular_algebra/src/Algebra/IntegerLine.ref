\use std.Logic[].Equality[].eq_reason_in;
\import Modules.Hom[V := I.Int^, W := W, source := Modules.scalarModule, target := target] \as Maps;
\definition onScalar: \forall (f: Maps.Map)(a: I.Int^) -> (f).apply a = (target).smul a ((f).apply I.One.specification) :=
  \fun (f: Maps.Map)(a: I.Int^) => trans!{W} _ _ _
    (congr!{I.Int^ W} ((f).apply) _ _ (sym!{I.Int^} _ _ ((((Integers.ring).semiring).multiplicative).rightIdentity a)))
    ((f).scalar a I.One.specification);
\definition ext[f, g: Maps.Map][same: (f).apply I.One.specification = (g).apply I.One.specification]: f = g :=
  Maps.ext f g (\fun (a: I.Int^) => eq_reason_in!{W _
    "=" _ "by" { onScalar f a }
    "=" _ "by" { congr!{W W} ((target).smul a) _ _ same }
    "=" _ "by" { sym!{W} _ _ (onScalar g a) }
  });
