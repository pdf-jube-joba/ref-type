\use std.Logic[].Equality[].eq_reason_in;
\import Rep.Represented[data := data].WithRetraction[r := r.map].On[retracts := r.retracts] \as Derivative;
\import Modules.Hom[V := H.Homology, W := Lower.Cycle, source := H.homologySpace, target := Lower.cycleSpace] \as CycleMaps;
\definition difference: CycleMaps.Map := CycleMaps.plus Derivative.cycles (CycleMaps.negative desired.map);
\import Modules.Hom[V := Lower.Cycle, W := Lower.Homology, source := Lower.cycleSpace, target := Lower.homologySpace] \as Classes;
\import Modules.Laws[V := Lower.Homology, space := Lower.homologySpace] \as LowerHomology;
\import algebra.Group[].Of[Carrier := Lower.Homology, group := LowerHomology.additive] \as HomologyGroup;
\definition differenceZero: \forall (q: H.Homology) -> Lower.classOf ((difference).apply q) = Lower.zeroClass :=
  \fun (q: H.Homology) => eq_reason_in!{Lower.Homology _
    "=" _ "by" { Classes.differencePreserved Lower.classLinear ((Derivative.cycles).apply q) ((desired.map).apply q) }
    "=" _ "by" { congr!{Lower.Homology Lower.Homology Lower.Homology} HomologyGroup.difference _ _ _ _
        (sym!{Lower.Homology} _ _ (Derivative.connectingLaw q)) (desired.compatible q) }
    "=" _ "by" { HomologyGroup.inverseRight ((Connecting.connecting).apply q) }
  };
\import \parent.\parent.BoundaryFill[P := A, z := previous, M := homology] \as Fill;
\definition fillData: Fill.Data := Fill.Data { map := difference, killed := differenceZero };
\definition FillMap: \Set := \Cast[Modules.Hom[V := H.Homology, W := A.family.Carrier z, source := H.homologySpace, target := A.family.space z].Map]
  ({ f: Modules.Hom[V := H.Homology, W := A.family.Carrier z, source := H.homologySpace, target := A.family.space z].Map \where
    \forall (q: H.Homology) -> (Lower.prior).apply ((f).apply q) = (difference).apply q });
\module Filled(f: FillMap);
\definition existence: Modules.Projective homology -> \exists Result[desired] := \block {
  \fun (projective: Modules.Projective homology) \then
  \takefrom f: FillMap \by Fill.On[data := fillData].existence projective \then
  \return \exact(Filled[f := f].result, Result[desired])
};
