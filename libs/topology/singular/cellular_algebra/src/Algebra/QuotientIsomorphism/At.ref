\use std.Logic[].Equality[].eq_reason_in;
\import Source.At[k := z] \as SourceAt;
\import Target.At[k := z] \as TargetAt;
\import Forward.At[k := z] \as ForwardAt;
\import Backward.At[k := z] \as BackwardAt;
\definition forward: Modules.Hom[V := SourceAt.Carrier, W := TargetAt.Carrier, source := SourceAt.space, target := TargetAt.space].Map := ForwardAt.map commutes;
\definition backward: Modules.Hom[V := TargetAt.Carrier, W := SourceAt.Carrier, source := TargetAt.space, target := SourceAt.space].Map := BackwardAt.map (reverseCompatible commutes);
\definition leftInverse: \forall (q: SourceAt.Carrier) -> (backward).apply ((forward).apply q) = q :=
  SourceAt.induction (\fun (q: SourceAt.Carrier) => (backward).apply ((forward).apply q) = q)
    (\fun (x: D.family.Carrier z) => eq_reason_in!{SourceAt.Carrier _
      "=" _ "by" { congr!{TargetAt.Carrier SourceAt.Carrier} ((backward).apply) _ _ (ForwardAt.onClass commutes x) }
      "=" _ "by" { BackwardAt.onClass (reverseCompatible commutes) (((right).forward).apply z x) }
      "=" _ "by" { congr!{{D.family.Carrier z} SourceAt.Carrier} SourceAt.class _ _ ((right).leftInverse z x) }
    });
\definition rightInverse: \forall (q: TargetAt.Carrier) -> (forward).apply ((backward).apply q) = q :=
  TargetAt.induction (\fun (q: TargetAt.Carrier) => (forward).apply ((backward).apply q) = q)
    (\fun (x: D1.family.Carrier z) => eq_reason_in!{TargetAt.Carrier _
      "=" _ "by" { congr!{SourceAt.Carrier TargetAt.Carrier} ((forward).apply) _ _ (BackwardAt.onClass (reverseCompatible commutes) x) }
      "=" _ "by" { ForwardAt.onClass commutes (((right).backward).apply z x) }
      "=" _ "by" { congr!{{D1.family.Carrier z} TargetAt.Carrier} TargetAt.class _ _ ((right).rightInverse z x) }
    });
