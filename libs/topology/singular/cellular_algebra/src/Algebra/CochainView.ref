\import chain_complexes.Chain[] \as Degrees;
\definition Carrier[z: I.Int^]: \Set := C.family.Carrier z;
\definition space[z: I.Int^]: Modules.Space (Carrier z) := C.family.space z;
\definition apply[z: I.Int^]: Carrier z -> Carrier (Degrees.next z) := (C.differential).apply z;
\definition addition[z: I.Int^][x, y: Carrier z]: apply z ((space z).add x y) = (space (Degrees.next z)).add (apply z x) (apply z y) := (C.laws).addition z x y;
\definition scalar[z: I.Int^][a: I.Int^][x: Carrier z]: apply z ((space z).smul a x) = (space (Degrees.next z)).smul a (apply z x) := (C.laws).scalar z a x;
\definition squareZero[z: I.Int^][x: Carrier z]: apply (Degrees.next z) (apply z x) = (space (Degrees.next (Degrees.next z))).zero := (C.laws).squareZero z x;
