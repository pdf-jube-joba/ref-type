\use std.Logic[].Equality[].eq_reason_in;
\definition sectionLaw: \forall (q: Right.Term[z := z].Carrier) ->
  RightCoordinates.coordinates ((Projection.map).apply z ((Section.map).apply q)) i = RightCoordinates.coordinates q i :=
  \fun (q: Right.Term[z := z].Carrier) => eq_reason_in!{{Right.termCarrier i z} _
    "=" _ "by" { Projected.coordinates ((Section.map).apply q) i }
    "=" _ "by" { congr!{{Middle.termCarrier i z} {Right.termCarrier i z}} (((sequences i).projection).apply z) _ _ (Section.coordinatesNatural q i) }
    "=" _ "by" { (splitting i z).sectionLaw (RightCoordinates.coordinates q i) }
  };
\definition zero: \forall (x: Left.Term[z := z].Carrier) ->
  RightCoordinates.coordinates ((Projection.map).apply z ((Inclusion.map).apply z x)) i = RightProduct.zero i :=
  \fun (x: Left.Term[z := z].Carrier) => eq_reason_in!{{Right.termCarrier i z} _
    "=" _ "by" { Projected.coordinates ((Inclusion.map).apply z x) i }
    "=" _ "by" { congr!{{Middle.termCarrier i z} {Right.termCarrier i z}} (((sequences i).projection).apply z) _ _ (Included.coordinates x i) }
    "=" _ "by" { (sequences i).zero z (LeftCoordinates.coordinates x i) }
  };
\definition closed: \forall (y: Middle.Term[z := z].Carrier) -> (Projection.map).apply z y = (Right.Term[z := z].space).zero ->
  ((sequences i).projection).apply z (MiddleCoordinates.coordinates y i) = (Right.termSpace i z).zero :=
  \fun (y: Middle.Term[z := z].Carrier)(zero: _) => eq_reason_in!{{Right.termCarrier i z} _
    "=" _ "by" { sym!{{Right.termCarrier i z}} _ _ (Projected.coordinates y i) }
    "=" _ "by" { congr!{Right.Term[z := z].Carrier {Right.termCarrier i z}} (\fun (q: Right.Term[z := z].Carrier) => RightCoordinates.coordinates q i) _ _ zero }
    "=" _ "by" { congr!{RightProduct.Carrier {Right.termCarrier i z}} (\fun (v: RightProduct.Carrier) => v i) _ _ RightCoordinates.coordinatesZero }
  };
\definition kernel: \forall (y: Middle.Term[z := z].Carrier) -> (Projection.map).apply z y = (Right.Term[z := z].space).zero ->
  MiddleCoordinates.coordinates ((Inclusion.map).apply z ((Retraction.map).apply y)) i = MiddleCoordinates.coordinates y i := \block {
  \fun (y: Middle.Term[z := z].Carrier)(zero: _) \then
  \takefrom x: \Cast[Left.termCarrier i z] ({ x: Left.termCarrier i z \where
    ((sequences i).inclusion).apply z x = MiddleCoordinates.coordinates y i })
    \by (sequences i).kernelImage z (MiddleCoordinates.coordinates y i) (closed y zero) \then
  \let image: ((sequences i).inclusion).apply z x = MiddleCoordinates.coordinates y i :=
    \bysub(Left.termCarrier i z, { x: Left.termCarrier i z \where
      ((sequences i).inclusion).apply z x = MiddleCoordinates.coordinates y i }, x) \then
  \return eq_reason_in!{{Middle.termCarrier i z} _
    "=" _ "by" { Included.coordinates ((Retraction.map).apply y) i }
    "=" _ "by" { congr!{{Left.termCarrier i z} {Middle.termCarrier i z}} (((sequences i).inclusion).apply z) _ _ (Retraction.coordinatesNatural y i) }
    "=" _ "by" { congr!{{Middle.termCarrier i z} {Middle.termCarrier i z}}
          (\fun (b: Middle.termCarrier i z) => ((sequences i).inclusion).apply z (((splitting i z).retraction).apply b)) _ _
          (sym!{{Middle.termCarrier i z}} _ _ image) }
    "=" _ "by" { congr!{{Left.termCarrier i z} {Middle.termCarrier i z}} (((sequences i).inclusion).apply z) _ _ ((splitting i z).retracts x) }
    "=" _ "by" image
  }
};
