\module At(z: I.Int^);
\definition sequence: Complexes.ShortExact[A := Left.complex, B := Middle.complex, C := Right.complex].Sequence :=
  Complexes.ShortExact[A := Left.complex, B := Middle.complex, C := Right.complex].Sequence {
    inclusion := Inclusion.map, projection := Projection.map,
    injective := \fun (z: I.Int^) => At[z := z].injective,
    onto := \fun (z: I.Int^) => At[z := z].onto,
    zero := \fun (z: I.Int^) => At[z := z].zero,
    kernelImage := \fun (z: I.Int^) => At[z := z].kernelImage,
  };
