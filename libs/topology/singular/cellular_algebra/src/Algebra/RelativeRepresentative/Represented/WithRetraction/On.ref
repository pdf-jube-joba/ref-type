\use std.Logic[].Equality[].eq_reason_in;
\import Complexes.ShortExact[A := A, B := B, C := C].At[s := sequence, k := z] \as Connecting;
\import Complexes.At[C := A, z := previous] \as Lower;
\definition killed: \forall (q: H.Homology) -> (sequence.projection).apply previous ((wholeBoundary).apply q) = (C.family.space previous).zero :=
  \fun (q: H.Homology) => trans!{{C.family.Carrier previous}} _ _ _
    (sym!{{C.family.Carrier previous}} _ _ ((sequence.projection).commutes z ((data.map).apply q))) (data.closed q);
\definition onInclusion: \forall (q: H.Homology) -> (sequence.inclusion).apply previous ((boundary).apply q) = (wholeBoundary).apply q := \block {
  \fun (q: H.Homology) \then
  \takefrom a: \Cast[A.family.Carrier previous] ({ a: A.family.Carrier previous \where (sequence.inclusion).apply previous a = (wholeBoundary).apply q })
    \by (sequence).kernelImage previous ((wholeBoundary).apply q) (killed q) \then
  \let equal: (sequence.inclusion).apply previous a = (wholeBoundary).apply q :=
    \bysub(A.family.Carrier previous, { a: A.family.Carrier previous \where (sequence.inclusion).apply previous a = (wholeBoundary).apply q }, a) \then
  \return eq_reason_in!{{B.family.Carrier previous} _
    "=" _ "by" { congr!{{B.family.Carrier previous} {B.family.Carrier previous}}
      (\fun (b: B.family.Carrier previous) => (sequence.inclusion).apply previous ((r).apply b)) _ _
      (sym!{{B.family.Carrier previous}} _ _ equal) }
    "=" _ "by" { congr!{{A.family.Carrier previous} {B.family.Carrier previous}} ((sequence.inclusion).apply previous) _ _ (retracts a) }
    "=" _ "by" equal
  }
};
\definition closed: \forall (q: H.Homology) -> (A.differential).apply previous ((boundary).apply q) = (A.family.space (Degrees.previous previous)).zero :=
  \fun (q: H.Homology) => Connecting.lowerClosed ((data.map).apply q) ((boundary).apply q) (onInclusion q);
\import Modules.Hom[V := H.Homology, W := Lower.Cycle, source := H.homologySpace, target := Lower.cycleSpace] \as Cycles;
\definition cycles: Cycles.Map := Cycles.Map {
  apply := \fun (q: H.Homology) => Lower.cycle ((boundary).apply q) (closed q),
  addition := (boundary).addition, scalar := (boundary).scalar,
};
\definition connectingLaw: \forall (q: H.Homology) -> (Connecting.connecting).apply q = Lower.classOf ((cycles).apply q) :=
  \fun (q: H.Homology) => eq_reason_in!{Lower.Homology _
    "=" _ "by" { congr!{H.Homology Lower.Homology} ((Connecting.connecting).apply) _ _ (sym!{H.Homology} _ _ (data.section q)) }
    "=" _ "by" { Connecting.onClass (H.cycle ((sequence.projection).apply z ((data.map).apply q)) (data.closed q)) }
    "=" _ "by" { Connecting.onLift (H.cycle ((sequence.projection).apply z ((data.map).apply q)) (data.closed q))
        ((data.map).apply q) ((boundary).apply q) (\refl((sequence.projection).apply z ((data.map).apply q))) (onInclusion q) (closed q) }
  };
