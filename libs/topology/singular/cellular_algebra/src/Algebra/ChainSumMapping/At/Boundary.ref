\use std.Logic[].Equality[].eq_reason_in;
\definition point: \forall (x: Source.Term[z := z].Carrier)(i: Index) ->
  LowerTarget.coordinates ((Target.complex.differential).apply z ((map).apply x)) i =
  LowerTarget.coordinates ((\parent.\parent.At[z := Degrees.previous z].map).apply ((Source.complex.differential).apply z x)) i :=
  \fun (x: Source.Term[z := z].Carrier)(i: Index) => eq_reason_in!{{Target.termCarrier i (Degrees.previous z)} _
    "=" _ "by" { Target.Step[z := z].coordinatesNatural ((map).apply x) i }
    "=" _ "by" { congr!{{Target.termCarrier i z} {Target.termCarrier i (Degrees.previous z)}} (Target.termApply i z) _ _ (coordinates x i) }
    "=" _ "by" { (maps i).commutes z (SourceCoordinates.coordinates x i) }
    "=" _ "by" { sym!{{Target.termCarrier i (Degrees.previous z)}} _ _
          (trans!{{Target.termCarrier i (Degrees.previous z)}} _ _ _
            (\parent.\parent.At[z := Degrees.previous z].coordinates ((Source.complex.differential).apply z x) i)
            (congr!{{Source.termCarrier i (Degrees.previous z)} {Target.termCarrier i (Degrees.previous z)}} ((maps i).apply (Degrees.previous z)) _ _
              (Source.Step[z := z].coordinatesNatural x i))) }
  };
\definition law: \forall (x: Source.Term[z := z].Carrier) ->
  (Target.complex.differential).apply z ((map).apply x) =
  (\parent.\parent.At[z := Degrees.previous z].map).apply ((Source.complex.differential).apply z x) :=
  \fun (x: Source.Term[z := z].Carrier) => LowerTarget.injective _ _
    (\axiom:funext(LowerTarget.coordinates ((Target.complex.differential).apply z ((map).apply x)),
      LowerTarget.coordinates ((\parent.\parent.At[z := Degrees.previous z].map).apply ((Source.complex.differential).apply z x)), point x));
