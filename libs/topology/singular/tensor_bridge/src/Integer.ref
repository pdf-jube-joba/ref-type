\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import singular_cech.Algebra[R := I.Int^, ring := Integers.ring] \as Algebra;
\module Factor(C: Signed.Complex);
\module Lift(C, D: Native.Complex);
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\import tensor_chains.TensorChain[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Tensors;
