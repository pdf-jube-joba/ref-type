\definition positive[z: I.Int^]: N.Nat^ := I.Positive.specification z;
\definition pair[n, p, q: I.Int^][closed: Grading.add p q = n]: Grading.Index n :=
  \into[Grading.Pair](Grading.Pair { first := p, second := q },
    { i: Grading.Pair \where Grading.add (i).first (i).second = n }) \by { closed };
\definition rebuild[n: I.Int^][i: Grading.Index n]: pair n (i).first (i).second (Grading.degree n i) = i := Grading.pairRebuild i;
\definition injective[p, q: N.Nat^][equal: I.Int^::ofNat p = I.Int^::ofNat q]: p = q :=
  congr!{I.Int^ N.Nat^} positive _ _ equal;
\definition Nonnegative: I.Int^ -> \Prop := \induction (z: I.Int^) \return \Prop \with {
  | ofNat: \fun (n: N.Nat^) => Logic.True
  | negSucc: \fun (n: N.Nat^) => Logic.False
};
\definition disjoint[p, q: N.Nat^][equal: I.Int^::ofNat p = I.Int^::negSucc q]: Logic.False :=
  \idelim I.Int^::ofNat p = I.Int^::negSucc q \with z: I.Int^ => Nonnegative z \by {
    base: Logic.True::intro, equality: equal
  };
\definition signed[n: N.Nat^][i: Double.Index n]: Grading.Index (I.Int^::ofNat n) :=
  \into[Grading.Pair](Grading.Pair { first := I.Int^::ofNat (i).first, second := I.Int^::ofNat (i).second },
    { j: Grading.Pair \where Grading.add (j).first (j).second = I.Int^::ofNat n }) \by {
      congr!{N.Nat^ I.Int^} I.Int^::ofNat _ _ (Double.degree n i)
    };
\definition unsigned[n, p, q: N.Nat^][closed: Grading.add (I.Int^::ofNat p) (I.Int^::ofNat q) = I.Int^::ofNat n]: Double.Index n :=
  \into[Double.Pair](Double.Pair { first := p, second := q },
    { i: Double.Pair \where Nat.add (i).first (i).second = n }) \by { injective (Nat.add p q) n closed };
\definition unsignedSigned[n: N.Nat^][i: Double.Index n]:
  unsigned n (i).first (i).second (Grading.degree (I.Int^::ofNat n) (signed n i)) = i := Double.pairRebuild i;
\definition signedUnsigned[n, p, q: N.Nat^][closed: Grading.add (I.Int^::ofNat p) (I.Int^::ofNat q) = I.Int^::ofNat n]:
  signed n (unsigned n p q closed) =
    (\into[Grading.Pair](Grading.Pair { first := I.Int^::ofNat p, second := I.Int^::ofNat q },
      { i: Grading.Pair \where Grading.add (i).first (i).second = I.Int^::ofNat n }) \by { closed }) :=
  \refl(Grading.Pair { first := I.Int^::ofNat p, second := I.Int^::ofNat q });
