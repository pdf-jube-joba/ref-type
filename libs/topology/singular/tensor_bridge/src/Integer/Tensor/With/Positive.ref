\definition z: I.Int^ := I.Int^::ofNat n;
\import Source.Term[n := z] \as S;
\import Target.Degree[n := n] \as T;
\module Both(p, q: N.Nat^, closed: Grading.add (I.Int^::ofNat p) (I.Int^::ofNat q) = z) {
  \definition sourceIndex: Grading.Index z := Indices.pair z (I.Int^::ofNat p) (I.Int^::ofNat q) closed;
  \definition targetIndex: Double.Index n := Indices.unsigned n p q closed;
  \import T.Component[i := targetIndex] \as Injection;
  \definition map: Modules.Hom[V := SignedTensor.family.Carrier (I.Int^::ofNat p) (I.Int^::ofNat q), W := T.Carrier,
    source := SignedTensor.family.space (I.Int^::ofNat p) (I.Int^::ofNat q), target := T.space].Map := Injection.injection;
}
\module RightAbsent(p, q: N.Nat^) {
  \import Modules.Hom[V := SignedTensor.family.Carrier (I.Int^::ofNat p) (I.Int^::negSucc q), W := T.Carrier,
    source := SignedTensor.family.space (I.Int^::ofNat p) (I.Int^::negSucc q), target := T.space] \as Maps;
  \definition map: Maps.Map := Maps.zeroMap;
}
\module LeftAbsent(p: N.Nat^, q: I.Int^) {
  \import Modules.Hom[V := SignedTensor.family.Carrier (I.Int^::negSucc p) q, W := T.Carrier,
    source := SignedTensor.family.space (I.Int^::negSucc p) q, target := T.space] \as Maps;
  \definition map: Maps.Map := Maps.zeroMap;
}
\structure Coordinates[p, q: I.Int^, i: Grading.Index z]: \Prop := {
  first: (i).first = p,
  second: (i).second = q,
};
\definition Closed[p, q: I.Int^]: \Set := \Cast[Grading.Index z] ({ i: Grading.Index z \where Coordinates[p, q, i] });
\definition closedLaws[p, q: I.Int^][i: Closed p q]: Coordinates[p, q, i] :=
  \bysub(Grading.Index z, { i: Grading.Index z \where Coordinates[p, q, i] }, i);
\definition close[i: Grading.Index z]: Closed (i).first (i).second :=
  \into[Grading.Index z](i, { j: Grading.Index z \where Coordinates[(i).first, (i).second, j] }) \by {
    Coordinates[(i).first, (i).second, i] { first := \refl((i).first), second := \refl((i).second) }
  };
\definition degree[p, q: I.Int^][i: Closed p q]: Grading.add p q = z :=
  trans!{I.Int^} _ _ _
    (sym!{I.Int^} _ _ (congr2!{I.Int^ I.Int^ I.Int^} Grading.add _ _ _ _
      ((closedLaws p q i).first) ((closedLaws p q i).second)))
    (Grading.degree z i);
\definition component: \forall (p, q: I.Int^) -> Closed p q ->
  Modules.Hom[V := SignedTensor.family.Carrier p q, W := T.Carrier, source := SignedTensor.family.space p q, target := T.space].Map :=
  \induction (p: I.Int^) \return \forall (q: I.Int^) -> Closed p q ->
    Modules.Hom[V := SignedTensor.family.Carrier p q, W := T.Carrier, source := SignedTensor.family.space p q, target := T.space].Map \with {
    | ofNat: \fun (p: N.Nat^) => \induction (q: I.Int^) \return Closed (I.Int^::ofNat p) q ->
        Modules.Hom[V := SignedTensor.family.Carrier (I.Int^::ofNat p) q, W := T.Carrier,
          source := SignedTensor.family.space (I.Int^::ofNat p) q, target := T.space].Map \with {
      | ofNat: \fun (q: N.Nat^)(i: Closed (I.Int^::ofNat p) (I.Int^::ofNat q)) =>
          Both[p := p, q := q, closed := degree (I.Int^::ofNat p) (I.Int^::ofNat q) i].map
      | negSucc: \fun (q: N.Nat^)(unused: Closed (I.Int^::ofNat p) (I.Int^::negSucc q)) => RightAbsent[p := p, q := q].map
    }
    | negSucc: \fun (p: N.Nat^)(q: I.Int^)(unused: Closed (I.Int^::negSucc p) q) => LeftAbsent[p := p, q := q].map
  };
\import Modules.DirectSum[Index := Grading.Index z, family := S.family].To[W := T.Carrier, target := T.space] \as ForwardUniversal;
\definition components: ForwardUniversal.Components := \fun (i: Grading.Index z) => component (i).first (i).second (close i);
\import Modules.Hom[V := S.Carrier, W := T.Carrier, source := S.space, target := T.space] \as ForwardMaps;
\definition forward: ForwardMaps.Map := ForwardUniversal.extension components;
\definition forwardOnInjection[i: Grading.Index z][x: SignedTensor.family.Carrier (i).first (i).second]:
  (forward).apply ((S.Component[i := i].injection).apply x) = (components i).apply x := ForwardUniversal.onInjection components i x;
\module BackwardAt(i: Double.Index n) {
  \import S.Component[i := Indices.signed n i] \as Injection;
  \definition map: Modules.Hom[V := NativeTensor.family.Carrier (i).first (i).second, W := S.Carrier,
    source := NativeTensor.family.space (i).first (i).second, target := S.space].Map := Injection.injection;
}
\import Modules.DirectSum[Index := Double.Index n, family := T.family].To[W := S.Carrier, target := S.space] \as BackwardUniversal;
\definition backwardComponents: BackwardUniversal.Components := \fun (i: Double.Index n) => BackwardAt[i := i].map;
\import Modules.Hom[V := T.Carrier, W := S.Carrier, source := T.space, target := S.space] \as BackwardMaps;
\definition backward: BackwardMaps.Map := BackwardUniversal.extension backwardComponents;
\definition backwardOnInjection[i: Double.Index n][x: NativeTensor.family.Carrier (i).first (i).second]:
  (backward).apply ((T.Component[i := i].injection).apply x) = (S.Component[i := Indices.signed n i].injection).apply x :=
  BackwardUniversal.onInjection backwardComponents i x;
\import BackwardMaps.Composition[U := S.Carrier, domain := S.space] \as LeftCompose;
\import ForwardMaps.Composition[U := T.Carrier, domain := T.space] \as RightCompose;
\definition leftComposite: Modules.Hom[V := S.Carrier, W := S.Carrier, source := S.space, target := S.space].Map := LeftCompose.compose backward forward;
\definition rightComposite: Modules.Hom[V := T.Carrier, W := T.Carrier, source := T.space, target := T.space].Map := RightCompose.compose forward backward;
\module InverseBoth(p, q: N.Nat^, closed: Grading.add (I.Int^::ofNat p) (I.Int^::ofNat q) = z);
\module TrivialAt(i: Grading.Index z) {
  \import S.Component[i := i] \as Injection;
  \import Modules.Hom[V := SignedTensor.family.Carrier (i).first (i).second, W := S.Carrier,
    source := SignedTensor.family.space (i).first (i).second, target := S.space] \as Maps;
  \import Modules.Hom[V := S.Carrier, W := S.Carrier, source := S.space, target := S.space] \as Ends;
  \definition Vanishes: \Prop := \forall (x: SignedTensor.family.Carrier (i).first (i).second) -> x = (SignedTensor.family.space (i).first (i).second).zero;
  \definition injectionZero[vanishes: Vanishes][x: SignedTensor.family.Carrier (i).first (i).second]: (Injection.injection).apply x = (S.space).zero :=
    trans!{S.Carrier} _ _ _ (congr!{{SignedTensor.family.Carrier (i).first (i).second} S.Carrier} ((Injection.injection).apply) _ _ (vanishes x))
      (Maps.zeroPreserved Injection.injection);
  \definition law[vanishes: Vanishes][x: SignedTensor.family.Carrier (i).first (i).second]:
    (leftComposite).apply ((Injection.injection).apply x) = (Injection.injection).apply x :=
    trans!{S.Carrier} _ _ _ (congr!{S.Carrier S.Carrier} ((leftComposite).apply) _ _ (injectionZero vanishes x))
      (trans!{S.Carrier} _ _ _ (Ends.zeroPreserved leftComposite) (sym!{S.Carrier} _ _ (injectionZero vanishes x)));
}
\definition rightVanishes[p: I.Int^][q: N.Nat^][x: SignedTensor.family.Carrier p (I.Int^::negSucc q)]:
  x = (SignedTensor.family.space p (I.Int^::negSucc q)).zero := \parent.TrivialRight[p := p, q := q].zero x;
\definition leftVanishes[p: N.Nat^][q: I.Int^][x: SignedTensor.family.Carrier (I.Int^::negSucc p) q]:
  x = (SignedTensor.family.space (I.Int^::negSucc p) q).zero := \parent.TrivialLeft[p := p, q := q].zero x;
\module InverseRightAbsent(p, q: N.Nat^, closed: Grading.add (I.Int^::ofNat p) (I.Int^::negSucc q) = z) {
  \definition i: Grading.Index z := Indices.pair z (I.Int^::ofNat p) (I.Int^::negSucc q) closed;
  \import \parent.TrivialAt[i := i] \as Comparison;
  \definition law[x: SignedTensor.family.Carrier (I.Int^::ofNat p) (I.Int^::negSucc q)]:
    (leftComposite).apply ((S.Component[i := i].injection).apply x) = (S.Component[i := i].injection).apply x :=
    Comparison.law (\fun (y: SignedTensor.family.Carrier (I.Int^::ofNat p) (I.Int^::negSucc q)) => rightVanishes (I.Int^::ofNat p) q y) x;
}
\module InverseLeftAbsent(p: N.Nat^, q: I.Int^, closed: Grading.add (I.Int^::negSucc p) q = z) {
  \definition i: Grading.Index z := Indices.pair z (I.Int^::negSucc p) q closed;
  \import \parent.TrivialAt[i := i] \as Comparison;
  \definition law[x: SignedTensor.family.Carrier (I.Int^::negSucc p) q]:
    (leftComposite).apply ((S.Component[i := i].injection).apply x) = (S.Component[i := i].injection).apply x :=
    Comparison.law (\fun (y: SignedTensor.family.Carrier (I.Int^::negSucc p) q) => leftVanishes p q y) x;
}
\definition componentLeft: \forall (p, q: I.Int^)(closed: Grading.add p q = z)(x: SignedTensor.family.Carrier p q) ->
  (leftComposite).apply ((S.Component[i := Indices.pair z p q closed].injection).apply x) =
    (S.Component[i := Indices.pair z p q closed].injection).apply x :=
  \induction (p: I.Int^) \return \forall (q: I.Int^)(closed: Grading.add p q = z)(x: SignedTensor.family.Carrier p q) ->
    (leftComposite).apply ((S.Component[i := Indices.pair z p q closed].injection).apply x) =
      (S.Component[i := Indices.pair z p q closed].injection).apply x \with {
    | ofNat: \fun (p: N.Nat^) => \induction (q: I.Int^) \return \forall (closed: Grading.add (I.Int^::ofNat p) q = z)(x: SignedTensor.family.Carrier (I.Int^::ofNat p) q) ->
        (leftComposite).apply ((S.Component[i := Indices.pair z (I.Int^::ofNat p) q closed].injection).apply x) =
          (S.Component[i := Indices.pair z (I.Int^::ofNat p) q closed].injection).apply x \with {
      | ofNat: \fun (q: N.Nat^)(closed: Grading.add (I.Int^::ofNat p) (I.Int^::ofNat q) = z)
          (x: SignedTensor.family.Carrier (I.Int^::ofNat p) (I.Int^::ofNat q)) => InverseBoth[p := p, q := q, closed := closed].left x
      | negSucc: \fun (q: N.Nat^)(closed: Grading.add (I.Int^::ofNat p) (I.Int^::negSucc q) = z)
          (x: SignedTensor.family.Carrier (I.Int^::ofNat p) (I.Int^::negSucc q)) =>
        InverseRightAbsent[p := p, q := q, closed := closed].law x
    }
    | negSucc: \fun (p: N.Nat^)(q: I.Int^)(closed: Grading.add (I.Int^::negSucc p) q = z)
        (x: SignedTensor.family.Carrier (I.Int^::negSucc p) q) =>
      InverseLeftAbsent[p := p, q := q, closed := closed].law x
  };
\definition onLeft[i: Grading.Index z][x: SignedTensor.family.Carrier (i).first (i).second]:
  (leftComposite).apply ((S.Component[i := i].injection).apply x) = (S.Component[i := i].injection).apply x :=
  (\idelim Indices.pair z (i).first (i).second (Grading.degree z i) = i
    \with j: Grading.Index z => \forall (v: SignedTensor.family.Carrier (j).first (j).second) ->
      (leftComposite).apply ((S.Component[i := j].injection).apply v) = (S.Component[i := j].injection).apply v \by {
      base: componentLeft (i).first (i).second (Grading.degree z i), equality: Indices.rebuild z i
    }) x;
\definition onRight[i: Double.Index n][x: NativeTensor.family.Carrier (i).first (i).second]:
  (rightComposite).apply ((T.Component[i := i].injection).apply x) = (T.Component[i := i].injection).apply x :=
  (\idelim Indices.unsigned n (i).first (i).second (Grading.degree z (Indices.signed n i)) = i
    \with j: Double.Index n => \forall (v: NativeTensor.family.Carrier (j).first (j).second) ->
      (rightComposite).apply ((T.Component[i := j].injection).apply v) = (T.Component[i := j].injection).apply v \by {
      base: \fun (v: NativeTensor.family.Carrier (i).first (i).second) =>
        InverseBoth[p := (i).first, q := (i).second, closed := Grading.degree z (Indices.signed n i)].right v,
      equality: Indices.unsignedSigned n i
    }) x;
\import Modules.End[V := S.Carrier, space := S.space] \as SourceIdentity;
\import Modules.End[V := T.Carrier, space := T.space] \as TargetIdentity;
\import Modules.DirectSum[Index := Grading.Index z, family := S.family].To[W := S.Carrier, target := S.space] \as SourceEquality;
\import Modules.DirectSum[Index := Double.Index n, family := T.family].To[W := T.Carrier, target := T.space] \as TargetEquality;
\definition leftEquality: leftComposite = SourceIdentity.identity := SourceEquality.ext leftComposite SourceIdentity.identity onLeft;
\definition rightEquality: rightComposite = TargetIdentity.identity := TargetEquality.ext rightComposite TargetIdentity.identity onRight;
\import Modules.Hom[V := S.Carrier, W := S.Carrier, source := S.space, target := S.space] \as SourceEnds;
\import Modules.Hom[V := T.Carrier, W := T.Carrier, source := T.space, target := T.space] \as TargetEnds;
\definition leftInverse[x: S.Carrier]: (backward).apply ((forward).apply x) = x :=
  congr!{SourceEnds.Map S.Carrier} (\fun (f: SourceEnds.Map) => (f).apply x) _ _ leftEquality;
\definition rightInverse[x: T.Carrier]: (forward).apply ((backward).apply x) = x :=
  congr!{TargetEnds.Map T.Carrier} (\fun (f: TargetEnds.Map) => (f).apply x) _ _ rightEquality;
\import Modules.Isomorphism[V := S.Carrier, W := T.Carrier, source := S.space, target := T.space] \as Compared;
\definition isomorphism: Compared.Isomorphism := Compared.Isomorphism {
  forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
};
