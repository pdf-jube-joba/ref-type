\use std.Logic[].Equality[].eq_reason_in;
\definition z: I.Int^ := I.Int^::ofNat (N.Nat^::succ n);
\import \parent.Positive[n := N.Nat^::succ n] \as P;
\import \parent.Positive[n := n] \as Q;
\import Target.Step[n := n] \as NativeStep;
\import Source.Step[n := z] \as SignedStep;
\import Source.Term[n := I.Int^::ofNat n] \as ST;
\import Source.Term[n := z] \as SS;
\import Target.Degree[n := n] \as NT;
\import Target.Degree[n := N.Nat^::succ n] \as NS;
\import Modules.Hom[V := NT.Carrier, W := ST.Carrier, source := NT.space, target := ST.space] \as BackwardMaps;
\module HorizontalBase(q: Double.Second (N.Nat^::succ n) N.Nat^::zero);
\module HorizontalPositive(p: N.Nat^, q: Double.Second (N.Nat^::succ n) (N.Nat^::succ p));
\module VerticalBase(p: Double.First (N.Nat^::succ n) N.Nat^::zero);
\module VerticalPositive(q: N.Nat^, p: Double.First (N.Nat^::succ n) (N.Nat^::succ q));
\definition HorizontalLaw[p: N.Nat^]: \Prop := \forall (q: Double.Second (N.Nat^::succ n) p)(x: NativeTensor.family.Carrier p q) ->
  (Q.backward).apply ((NativeStep.horizontal p q).apply x) =
    (SignedStep.Component[i := Indices.signed (N.Nat^::succ n) (Double.index (N.Nat^::succ n) p q)].horizontal).apply x;
\definition horizontal: \forall (p: N.Nat^) -> HorizontalLaw p :=
  \induction (p: N.Nat^) \return HorizontalLaw p \with {
    | zero: \fun (q: Double.Second (N.Nat^::succ n) N.Nat^::zero)(x: NativeTensor.family.Carrier N.Nat^::zero q) => HorizontalBase[q := q].law x
    | succ: \fun (p: N.Nat^)(unused: HorizontalLaw p)(q: Double.Second (N.Nat^::succ n) (N.Nat^::succ p))
        (x: NativeTensor.family.Carrier (N.Nat^::succ p) q) => HorizontalPositive[p := p, q := q].law x
  };
\definition VerticalLaw[q: N.Nat^]: \Prop := \forall (p: Double.First (N.Nat^::succ n) q)(x: NativeTensor.family.Carrier p q) ->
  (Q.backward).apply ((NativeStep.vertical q p).apply x) =
    (SignedStep.Component[i := Indices.signed (N.Nat^::succ n) (Double.reverseIndex (N.Nat^::succ n) q p)].vertical).apply x;
\definition vertical: \forall (q: N.Nat^) -> VerticalLaw q :=
  \induction (q: N.Nat^) \return VerticalLaw q \with {
    | zero: \fun (p: Double.First (N.Nat^::succ n) N.Nat^::zero)(x: NativeTensor.family.Carrier p N.Nat^::zero) => VerticalBase[p := p].law x
    | succ: \fun (q: N.Nat^)(unused: VerticalLaw q)(p: Double.First (N.Nat^::succ n) (N.Nat^::succ q))
        (x: NativeTensor.family.Carrier p (N.Nat^::succ q)) => VerticalPositive[q := q, p := p].law x
  };
\import BackwardMaps.Composition[U := NS.Carrier, domain := NS.space] \as LeftCompose;
\import Modules.Hom[V := SS.Carrier, W := ST.Carrier, source := SS.space, target := ST.space].Composition[U := NS.Carrier, domain := NS.space] \as RightCompose;
\import Modules.Hom[V := NS.Carrier, W := ST.Carrier, source := NS.space, target := ST.space] \as Maps;
\definition left: Maps.Map := LeftCompose.compose Q.backward NativeStep.differential;
\definition right: Maps.Map := RightCompose.compose SignedStep.differential P.backward;
\module At(i: Double.Index (N.Nat^::succ n)) {
  \definition j: Grading.Index z := Indices.signed (N.Nat^::succ n) i;
  \import NativeStep.Component[i := i] \as NativeAt;
  \import SignedStep.Component[i := j] \as SignedAt;
  \import NS.Component[i := i] \as Injection;
  \definition leftValue[x: NativeTensor.family.Carrier (i).first (i).second]:
    (left).apply ((Injection.injection).apply x) = (ST.space).add ((SignedAt.horizontal).apply x) ((SignedAt.vertical).apply x) :=
    eq_reason_in!{ST.Carrier _
      "=" _ "by" { congr!{NT.Carrier ST.Carrier} ((Q.backward).apply) _ _ (NativeStep.onComponent i x) }
      "=" _ "by" { (Q.backward).addition ((NativeStep.horizontal (i).first NativeAt.q).apply x) ((NativeStep.vertical (i).second NativeAt.p).apply x) }
      "=" _ "by" { congr!{ST.Carrier ST.Carrier ST.Carrier} ((ST.space).add) _ _ _ _
          (horizontal (i).first NativeAt.q x) (vertical (i).second NativeAt.p x) }
    };
  \definition rightValue[x: NativeTensor.family.Carrier (i).first (i).second]:
    (right).apply ((Injection.injection).apply x) = (ST.space).add ((SignedAt.horizontal).apply x) ((SignedAt.vertical).apply x) :=
    trans!{ST.Carrier} _ _ _
      (congr!{SS.Carrier ST.Carrier} ((SignedStep.differential).apply) _ _ (P.backwardOnInjection i x))
      (congr!{ST.Carrier ST.Carrier ST.Carrier} ((ST.space).add) _ _ _ _
        (SignedStep.horizontalOnInjection j x) (SignedStep.verticalOnInjection j x));
  \definition law[x: NativeTensor.family.Carrier (i).first (i).second]:
    (left).apply ((Injection.injection).apply x) = (right).apply ((Injection.injection).apply x) :=
    trans!{ST.Carrier} _ _ _ (leftValue x) (sym!{ST.Carrier} _ _ (rightValue x));
}
\import Modules.DirectSum[Index := Double.Index (N.Nat^::succ n), family := NS.family].To[W := ST.Carrier, target := ST.space] \as Equality;
\definition equality: left = right := Equality.ext left right (\fun (i: Double.Index (N.Nat^::succ n)) => At[i := i].law);
\definition commutes[x: NS.Carrier]: (SignedStep.differential).apply ((P.backward).apply x) = (Q.backward).apply ((NativeStep.differential).apply x) :=
  sym!{ST.Carrier} _ _ (congr!{Maps.Map ST.Carrier} (\fun (f: Maps.Map) => (f).apply x) _ _ equality);
\definition backwardInjective[a, b: NT.Carrier][equal: (Q.backward).apply a = (Q.backward).apply b]: a = b :=
  eq_reason_in!{NT.Carrier _
    "=" _ "by" { sym!{NT.Carrier} _ _ (Q.rightInverse a) }
    "=" _ "by" { congr!{ST.Carrier NT.Carrier} ((Q.forward).apply) _ _ equal }
    "=" _ "by" { Q.rightInverse b }
  };
\definition forwardCommutes[x: SS.Carrier]: (NativeStep.differential).apply ((P.forward).apply x) = (Q.forward).apply ((SignedStep.differential).apply x) :=
  backwardInjective _ _
    (eq_reason_in!{ST.Carrier _
      "=" _ "by" { sym!{ST.Carrier} _ _ (commutes ((P.forward).apply x)) }
      "=" _ "by" { congr!{SS.Carrier ST.Carrier} ((SignedStep.differential).apply) _ _ (P.leftInverse x) }
      "=" _ "by" { sym!{ST.Carrier} _ _ (Q.leftInverse ((SignedStep.differential).apply x)) }
    });
