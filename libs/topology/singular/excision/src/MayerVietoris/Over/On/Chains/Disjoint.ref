\definition IsDisjoint: \Prop := \forall (x: A) -> Top.Member left x -> Top.Member right x -> Logic.False;
\import singular_cohomology.Calculations[A := Intersection, source := IntersectionTopology.topology (LeftTopology.topology source)].ChainEmpty[] \as Empty;
\definition empty[disjoint: IsDisjoint][x: Intersection]: Logic.False :=
  disjoint x (\bysub(A, left, x)) (\bysub(Left, intersection, x));
\module With(coefficients: Modules.Bundle);
\module Homology;
