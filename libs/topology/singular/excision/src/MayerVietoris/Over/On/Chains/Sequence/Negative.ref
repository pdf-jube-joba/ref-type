\definition degree: I.Int^ := I.Int^::negSucc n;
\definition onto: \forall (x: Target.Carrier degree) -> \exists ( y: Middle.Carrier degree \where (Projection.map).apply degree y = x ) :=
  \fun (x: Target.Carrier degree) => Logic.existsIntro[Middle.Carrier degree, { y: Middle.Carrier degree \where (Projection.map).apply degree y = x }]
    (Middle.space degree).zero (sym!{{Target.Carrier degree}} _ _ (Target.Negative[n := n].zero x));
\definition kernelImage: \forall (y: Middle.Carrier degree) -> (Projection.map).apply degree y = (Target.space degree).zero ->
  \exists ( x: Sub.Carrier degree \where (Inclusion.map).apply degree x = y ) :=
  \fun (y: Middle.Carrier degree)(closed: _) => Logic.existsIntro[Sub.Carrier degree, { x: Sub.Carrier degree \where (Inclusion.map).apply degree x = y }]
    (Sub.space degree).zero (sym!{{Middle.Carrier degree}} _ _ (Middle.Negative[n := n].zero y));
