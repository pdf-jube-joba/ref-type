\import Theory.Degree[z := z] \as Current;
\definition source: Modules.Bundle := Current.whole;
\definition target: Modules.Bundle := Current.directSum;
\import Inclusion.At[k := z].Invert[f := Sequence.sequence.inclusion] \as Inverse;
\definition inclusionIsomorphism[disjoint: IsDisjoint]: Modules.Isomorphism[V := Current.small.Carrier, W := Current.sum.Carrier, source := Current.small.space, target := Current.sum.space].Isomorphism :=
  Inverse.isomorphism (quasi disjoint z);
\import Modules.Isomorphism[V := Current.small.Carrier, W := Current.sum.Carrier, source := Current.small.space, target := Current.sum.space]
  .Composition[U := target.Carrier, final := target.space] \as First;
\definition smallIsomorphism[disjoint: IsDisjoint]: Modules.Isomorphism[V := Current.small.Carrier, W := target.Carrier, source := Current.small.space, target := target.space].Isomorphism :=
  First.compose Current.sumComparison (inclusionIsomorphism disjoint);
\import Modules.Isomorphism[V := Current.small.Carrier, W := source.Carrier, source := Current.small.space, target := source.space].Inverse[] \as Reverse;
\import Modules.Isomorphism[V := source.Carrier, W := Current.small.Carrier, source := source.space, target := Current.small.space]
  .Composition[U := target.Carrier, final := target.space] \as Last;
\definition isomorphism[disjoint: IsDisjoint]: Modules.Isomorphism[V := source.Carrier, W := target.Carrier, source := source.space, target := target.space].Isomorphism :=
  Last.compose (smallIsomorphism disjoint) (Reverse.inverse Current.comparison);
