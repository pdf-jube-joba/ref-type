\import \parent.Degree[z := z] \as Current;
\import \parent.Degree[z := Degrees.previous z] \as Lower;
\import Exact.At[s := Sequence.sequence, k := z] \as Native;
\import Native.Exactness[] \as Exactness;
\import Modules.ExactPair[A := Current.intersection, B := Current.sum, C := Current.small] \as SumExact;
\definition atSum: SumExact.Sequence := SumExact.Sequence {
  first := Current.inclusion, last := Current.projection, zero := Exactness.inclusionProjectionZero, kernelImage := Exactness.exactAtB,
};
\import SumExact.Reindex[A1 := Current.intersection, B1 := Current.directSum, C1 := Current.whole, sequence := atSum, a := Current.intersectionIdentity, b := Current.sumComparison, c := Current.comparison] \as SumTransport;
\definition exactAtSum: _ := SumTransport.transported;
\import Modules.ExactPair[A := Current.sum, B := Current.small, C := Lower.intersection] \as WholeExact;
\definition atWhole: WholeExact.Sequence := WholeExact.Sequence {
  first := Current.projection, last := Native.connecting, zero := Exactness.projectionConnectingZero, kernelImage := Exactness.exactAtC,
};
\import WholeExact.Reindex[A1 := Current.directSum, B1 := Current.whole, C1 := Lower.intersection, sequence := atWhole, a := Current.sumComparison, b := Current.comparison, c := Lower.intersectionIdentity] \as WholeTransport;
\definition exactAtWhole: _ := WholeTransport.transported;
\import Modules.ExactPair[A := Current.small, B := Lower.intersection, C := Lower.sum] \as IntersectionExact;
\definition atIntersection: IntersectionExact.Sequence := IntersectionExact.Sequence {
  first := Native.connecting, last := Lower.inclusion, zero := Exactness.connectingInclusionZero, kernelImage := Exactness.exactAtALower,
};
\import IntersectionExact.Reindex[A1 := Current.whole, B1 := Lower.intersection, C1 := Lower.directSum, sequence := atIntersection, a := Current.comparison, b := Lower.intersectionIdentity, c := Lower.sumComparison] \as IntersectionTransport;
\definition exactAtIntersection: _ := IntersectionTransport.transported;
\definition inclusion: _ := SumTransport.first;
\definition projection: _ := SumTransport.last;
\definition connecting: _ := WholeTransport.last;
