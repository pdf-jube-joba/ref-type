\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Relative[subcomplex := IntersectionChains.complex, wholecomplex := Sum.complex].On[pair := pair, coefficients := coefficients] \as Relative;
\import \parent.Sequence[] \as Sequence;
\import Complexes.ZeroExtension[C := Small.complex] \as SmallExtension;
\import Complexes.ZeroExtension[C := Sum.complex] \as SumExtension;
\import Complexes.ZeroExtension[C := IntersectionChains.complex] \as IntersectionExtension;
\import Hom.IntegerIsomorphism[P := Quotient.complex, Q := SmallExtension.complex, N := coefficients].On[e := Sequence.quotientIsomorphism] \as Comparison;
\definition cochainIsomorphism: _ := Comparison.isomorphism;
\import Hom.Integer[P := Quotient.complex, N := coefficients] \as QuotientHom;
\import Hom.Integer[P := SmallExtension.complex, N := coefficients] \as SmallHom;
\import Hom.Integer[P := SumExtension.complex, N := coefficients] \as SumHom;
\import Hom.Integer[P := IntersectionExtension.complex, N := coefficients] \as IntersectionHom;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import Cochains.ShortExact[A := QuotientHom.complex, B := SumHom.complex, C := IntersectionHom.complex] \as Original;
\import Original.ReplaceLeft[A1 := SmallHom.complex].On[s := Relative.PairSequence[].sequence, e := cochainIsomorphism] \as Transport;
\import Cochains.ShortExact[A := SmallHom.complex, B := SumHom.complex, C := IntersectionHom.complex] \as Exact;
\definition sequence: Exact.Sequence := Transport.sequence;
\module At(z: I.Int^) {
  \definition isomorphism: _ := Comparison.At[z := z].isomorphism;
  \import Exact.At[s := sequence, k := z] \as Native;
  \import Native.Exactness[] \as Exactness;
  \definition connecting: _ := Native.connecting;
  \definition exactAtIntersection: _ := Exactness.exactAtC;
  \definition exactAtSmall: _ := Exactness.exactAtALower;
  \definition exactAtSum: _ := Exactness.exactAtB;
  \definition inclusionProjectionZero: _ := Exactness.inclusionProjectionZero;
  \definition projectionConnectingZero: _ := Exactness.projectionConnectingZero;
  \definition connectingInclusionZero: _ := Exactness.connectingInclusionZero;
}
