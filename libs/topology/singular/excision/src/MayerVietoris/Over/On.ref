\definition left: \Pow A := (cover).left;
\definition right: \Pow A := (cover).right;
\definition family: \Pow (\Pow A) := { U: \Pow A \where Logic.Or[U = left, U = right] };
\definition coverLaws: Top.IsOpenCover[source, family, Top.Whole] := Top.IsOpenCover[source, family, Top.Whole] {
  open := \fun (U: \Pow A)(member: Top.FamilyMember family U) => either!{member {Top.IsOpenIn source U}
    {\fun (same: U = left) => \idelim left = U \with V: \Pow A => Top.IsOpenIn source V \by {
      base: (laws cover).leftOpen, equality: sym!{{\Pow A}} _ _ same
    }}
    {\fun (same: U = right) => \idelim right = U \with V: \Pow A => Top.IsOpenIn source V \by {
      base: (laws cover).rightOpen, equality: sym!{{\Pow A}} _ _ same
    }}
  },
  covers := \fun (x: A)(member: Top.Member Top.Whole x) => either!{{((laws cover).covered x)} {Top.Member (Top.Union family) x}
    {Top.unionMemberOf family left x (Logic.Or[_, _]::left (\refl(left)))}
    {Top.unionMemberOf family right x (Logic.Or[_, _]::right (\refl(right)))}
  },
};
\import Top.OpenCovers[topology := source] \as Covers;
\definition openCover: Covers.Cover := \into[\Pow (\Pow A)](family, Covers.Families) \by { coverLaws };
\module Chains;
\module Reduced;
