\definition subset: \Pow A := (pair).subset;
\definition removed: \Pow A := (pair).removed;
\import Top.Subspace[S := Top.Complement removed] \as Remaining;
\definition intersection: \Pow Remaining.CarrierSet := { x: Remaining.CarrierSet \where Top.Member subset x };
\import singular_cohomology.Relative[A := Remaining.CarrierSet, source := Remaining.topology source, subset := intersection] \as Source;
\import singular_cohomology.Relative[A := A, source := source, subset := subset] \as Target;
\module Homology(z: I.Int^) {
  \definition Isomorphism: \Set := Modules.Isomorphism[V := Source.Homology[z := z].Carrier, W := Target.Homology[z := z].Carrier,
    source := Source.Homology[z := z].space, target := Target.Homology[z := z].space].Isomorphism;
}
\module With(coefficients: Modules.Bundle) {
  \module At(z: I.Int^) {
    \definition Isomorphism: \Set := Modules.Isomorphism[V := Target.With[coefficients := coefficients].At[z := z].Carrier, W := Source.With[coefficients := coefficients].At[z := z].Carrier,
      source := Target.With[coefficients := coefficients].At[z := z].space, target := Source.With[coefficients := coefficients].At[z := z].space].Isomorphism;
  }
}
