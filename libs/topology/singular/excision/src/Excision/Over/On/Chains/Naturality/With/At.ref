\use std.Logic[].Equality[].eq_reason_in;
\import Cochains.At[C := TargetWhole.complex, z := z] \as Source;
\import Cochains.At[C := SourceSmallHom.complex, z := z] \as Target;
\import Cochains.Map[C := TargetWhole.complex, D := SourceWhole.complex].At[k := z] \as OrdinaryActions;
\import Cochains.Map[C := SourceWhole.complex, D := SourceSmallHom.complex].At[k := z] \as SourceActions;
\import Cochains.Map[C := TargetWhole.complex, D := TargetSmallHom.complex].At[k := z] \as TargetActions;
\import Cochains.Map[C := TargetSmallHom.complex, D := SourceSmallHom.complex].At[k := z] \as SmallActions;
\definition law: \forall (q: Source.Cohomology) ->
  (SourceActions.induced sourceRestriction).apply ((OrdinaryActions.induced ordinaryMap).apply q) =
  (SmallActions.induced smallMap).apply ((TargetActions.induced targetRestriction).apply q) :=
  \fun (q: Source.Cohomology) => eq_reason_in!{Target.Cohomology _
    "=" _ "by" { sym!{Target.Cohomology} _ _ (Left.At[k := z].compositionOnCohomology sourceRestriction ordinaryMap q) }
    "=" _ "by" { congr!{Maps.Map Target.Cohomology} (\fun (f: Maps.Map) => (Maps.At[k := z].induced f).apply q) _ _ equation }
    "=" _ "by" { Right.At[k := z].compositionOnCohomology smallMap targetRestriction q }
  };
