\import \parent.Ordinary[] \as Ordinary;
\import \parent.Isomorphism[] \as SmallComparison;
\import \parent.Naturality[] \as Naturality;
\import singular_cohomology.Relative[A := Remaining.Carrier, source := RemainingTopology.topology source, subset := intersection] \as SourceRelative;
\import singular_cohomology.Relative[A := A, source := source, subset := subset] \as TargetRelative;
\import RemainingPair.Relative[] \as SourceComparison;
\import CoveredSubset.Relative[] \as TargetComparison;
\import Complexes.At[C := SourceQuotient.complex, z := z] \as SmallSource;
\import Complexes.At[C := TargetQuotient.complex, z := z] \as SmallTarget;
\import Complexes.At[C := SourceRelative.complex, z := z] \as Source;
\import Complexes.At[C := TargetRelative.complex, z := z] \as Target;
\definition smallSource: Modules.Bundle := Modules.Bundle { Carrier := SmallSource.Homology, space := SmallSource.homologySpace };
\definition smallTarget: Modules.Bundle := Modules.Bundle { Carrier := SmallTarget.Homology, space := SmallTarget.homologySpace };
\definition ordinarySource: Modules.Bundle := Modules.Bundle { Carrier := Source.Homology, space := Source.homologySpace };
\definition ordinaryTarget: Modules.Bundle := Modules.Bundle { Carrier := Target.Homology, space := Target.homologySpace };
\import Modules.IsomorphismSquare[A := smallSource, B := smallTarget, C := ordinarySource, D := ordinaryTarget]
  .On[a := SourceComparison.At[z := z].isomorphism, b := TargetComparison.At[z := z].isomorphism,
    c := SmallComparison.At[z := z].isomorphism, f := Ordinary.At[z := z].induced] \as Square;
\definition induced: _ := Ordinary.At[z := z].induced;
\definition isomorphism: Modules.Isomorphism[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace].Isomorphism :=
  Square.isomorphism Naturality.Homology[z := z].law;
