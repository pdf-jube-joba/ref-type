\definition smallSource: Modules.Bundle := Modules.Bundle { Carrier := SmallSource.Cohomology[z := z].Cohomology, space := SmallSource.Cohomology[z := z].cohomologySpace };
\definition smallTarget: Modules.Bundle := Modules.Bundle { Carrier := SmallTarget.Cohomology[z := z].Cohomology, space := SmallTarget.Cohomology[z := z].cohomologySpace };
\definition ordinarySource: Modules.Bundle := Modules.Bundle { Carrier := Source.Cohomology[z := z].Cohomology, space := Source.Cohomology[z := z].cohomologySpace };
\definition ordinaryTarget: Modules.Bundle := Modules.Bundle { Carrier := Target.Cohomology[z := z].Cohomology, space := Target.Cohomology[z := z].cohomologySpace };
\import Modules.Isomorphism[V := ordinarySource.Carrier, W := smallSource.Carrier, source := ordinarySource.space, target := smallSource.space].Inverse[] \as SourceInverse;
\import Modules.Isomorphism[V := ordinaryTarget.Carrier, W := smallTarget.Carrier, source := ordinaryTarget.space, target := smallTarget.space].Inverse[] \as TargetInverse;
\import Modules.IsomorphismSquare[A := smallTarget, B := smallSource, C := ordinaryTarget, D := ordinarySource]
  .On[a := TargetInverse.inverse TargetComparison.At[z := z].isomorphism, b := SourceInverse.inverse SourceComparison.At[z := z].isomorphism,
    c := SmallComparison.At[z := z].isomorphism, f := Ordinary.With[coefficients := coefficients].At[z := z].induced] \as Square;
\definition commutative: Square.Commutes := \fun (q: smallTarget.Carrier) =>
  trans!{ordinarySource.Carrier} _ _ _
    (sym!{ordinarySource.Carrier} _ _ ((SourceComparison.At[z := z].isomorphism).leftInverse
      ((Ordinary.With[coefficients := coefficients].At[z := z].induced).apply (((TargetComparison.At[z := z].isomorphism).backward).apply q))))
    (congr!{smallSource.Carrier ordinarySource.Carrier} (((SourceComparison.At[z := z].isomorphism).backward).apply) _ _
      (trans!{smallSource.Carrier} _ _ _ (Naturality.At[z := z].law (((TargetComparison.At[z := z].isomorphism).backward).apply q))
        (congr!{smallTarget.Carrier smallSource.Carrier} (((SmallComparison.At[z := z].isomorphism).forward).apply) _ _
          ((TargetComparison.At[z := z].isomorphism).rightInverse q))));
\definition induced: _ := Ordinary.With[coefficients := coefficients].At[z := z].induced;
\definition isomorphism: Modules.Isomorphism[V := ordinaryTarget.Carrier, W := ordinarySource.Carrier, source := ordinaryTarget.space, target := ordinarySource.space].Isomorphism :=
  Square.isomorphism commutative;
