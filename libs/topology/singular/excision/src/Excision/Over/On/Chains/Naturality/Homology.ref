\use std.Logic[].Equality[].eq_reason_in;
\import Complexes.At[C := SourceQuotient.complex, z := z] \as Source;
\import Complexes.At[C := TargetRelative.complex, z := z] \as Target;
\import Complexes.Map[C := SourceRelative.complex, D := TargetRelative.complex].At[k := z] \as OrdinaryActions;
\import Complexes.Map[C := SourceQuotient.complex, D := SourceRelative.complex].At[k := z] \as SourceActions;
\import Complexes.Map[C := TargetQuotient.complex, D := TargetRelative.complex].At[k := z] \as TargetActions;
\import Complexes.Map[C := SourceQuotient.complex, D := TargetQuotient.complex].At[k := z] \as SmallActions;
\definition law: \forall (q: Source.Homology) ->
  (OrdinaryActions.induced Ordinary.map).apply ((SourceActions.induced SourceComparison.comparison).apply q) =
  (TargetActions.induced TargetComparison.comparison).apply ((SmallActions.induced Mapping.map).apply q) :=
  \fun (q: Source.Homology) => eq_reason_in!{Target.Homology _
    "=" _ "by" { sym!{Target.Homology} _ _ (Left.At[k := z].compositionOnHomology Ordinary.map SourceComparison.comparison q) }
    "=" _ "by" { congr!{Maps.Map Target.Homology} (\fun (f: Maps.Map) => (Maps.At[k := z].induced f).apply q) _ _ equation }
    "=" _ "by" { Right.At[k := z].compositionOnHomology TargetComparison.comparison Mapping.map q }
  };
