\import \parent.Square[].Homology[z := z] \as Diagram;
\import SourceExcision.Homology[z := z] \as SourceTheory;
\import TargetExcision.Homology[z := z] \as TargetTheory;
\import Homeomorphisms.Homology[z := z] \as Complement;
\definition sourceComparison: Modules.Isomorphism[V := Diagram.cutSource.Carrier, W := Diagram.wholeSource.Carrier, source := Diagram.cutSource.space, target := Diagram.wholeSource.space].Isomorphism := SourceTheory.isomorphism sourcePair;
\definition targetComparison: Modules.Isomorphism[V := Diagram.cutTarget.Carrier, W := Diagram.wholeTarget.Carrier, source := Diagram.cutTarget.space, target := Diagram.wholeTarget.space].Isomorphism := TargetTheory.isomorphism targetPair;
\definition complementComparison: Modules.Isomorphism[V := Diagram.cutSource.Carrier, W := Diagram.cutTarget.Carrier, source := Diagram.cutSource.space, target := Diagram.cutTarget.space].Isomorphism := Complement.isomorphism homeomorphismData;
\import Modules.IsomorphismSquare[A := Diagram.cutSource, B := Diagram.cutTarget, C := Diagram.wholeSource, D := Diagram.wholeTarget] \as Transport;
\definition induced: Modules.MapBetween Diagram.wholeSource Diagram.wholeTarget := Diagram.quotient;
\definition isomorphism: Modules.Isomorphism[V := Diagram.wholeSource.Carrier, W := Diagram.wholeTarget.Carrier, source := Diagram.wholeSource.space, target := Diagram.wholeTarget.space].Isomorphism := Transport.transport sourceComparison targetComparison complementComparison Diagram.quotient Diagram.law;
