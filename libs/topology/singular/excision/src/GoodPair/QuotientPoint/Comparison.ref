\import singular_cohomology.Relative[A := Quotient.Carrier, source := Quotient.topology source, subset := singleton] \as Original;
\import singular_cohomology.Relative[A := Quotient.Carrier, source := Quotient.topology source, subset := image] \as Expanded;
\import Original.Maps[B := Quotient.Carrier].Over[target := Quotient.topology source, targetSubset := image] \as Maps;
\import topology.Maps[A := Quotient.Carrier, B := Quotient.Carrier].Identity[] \as Identity;
\definition map: Maps.Map := \into[Quotient.Carrier -> Quotient.Carrier]((\fun (x: Quotient.Carrier) => x), Maps.Map) \by {
  Maps.Laws[(\fun (x: Quotient.Carrier) => x)] {
    continuous := Identity.continuous (Quotient.topology source),
    contained := \fun (x: Original.SubspaceCarrier) => \bysub(Quotient.Carrier, image, forward x),
  }
};
\import Maps.On[f := map].Integer[] \as Action;
\import singular_cohomology.Equivalence[A := Point.CarrierSet, B := Region.CarrierSet,
  source := Point.topology (Quotient.topology source), target := Region.topology (Quotient.topology source)].Signed[] \as SubspaceComparison;
\import singular_cohomology.Identity[A := Quotient.Carrier, source := Quotient.topology source].Integer[] \as WholeComparison;
\definition subspaceQuasi: Action.Naturality[].Comparison[].SubspaceQuasi := \fun (z: I.Int^) => SubspaceComparison.Homology[z := z].bijective equivalence;
\definition wholeQuasi: Action.Naturality[].Comparison[].WholeQuasi := \fun (z: I.Int^) => WholeComparison.Homology[z := z].bijective;
\import Original.Reduced[].Singleton[a := point] \as Reduced;
\module Homology(z: I.Int^) {
  \definition isomorphism: Modules.Isomorphism[V := Original.Homology[z := z].Carrier, W := Expanded.Homology[z := z].Carrier,
    source := Original.Homology[z := z].space, target := Expanded.Homology[z := z].space].Isomorphism := Action.Naturality[].Comparison[].At[z := z].isomorphism subspaceQuasi wholeQuasi;
  \definition reducedIsomorphism: _ := Reduced.Homology[z := z].isomorphism pointUnique;
}
\module With(coefficients: Modules.Bundle) {
  \import Action.With[coefficients := coefficients].Naturality[] \as Pull;
  \definition subspaceQuasi: Pull.Comparison[].SubspaceQuasi := \fun (z: I.Int^) => SubspaceComparison.With[coefficients := coefficients].At[z := z].bijective equivalence;
  \definition wholeQuasi: Pull.Comparison[].WholeQuasi := \fun (z: I.Int^) => WholeComparison.With[coefficients := coefficients].At[z := z].bijective;
  \module At(z: I.Int^) {
    \definition isomorphism: Modules.Isomorphism[V := Expanded.With[coefficients := coefficients].At[z := z].Carrier, W := Original.With[coefficients := coefficients].At[z := z].Carrier,
      source := Expanded.With[coefficients := coefficients].At[z := z].space, target := Original.With[coefficients := coefficients].At[z := z].space].Isomorphism := Pull.Comparison[].At[z := z].isomorphism subspaceQuasi wholeQuasi;
    \definition reducedIsomorphism: _ := Reduced.With[coefficients := coefficients].At[z := z].isomorphism pointUnique;
  }
}
