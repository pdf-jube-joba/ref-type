\module Excision(A: \Set) {
  \import topology.Topology[Carrier := A] \as Top;
  \module Over(source: Top.Topology);
}
\module MayerVietoris(A: \Set) {
  \import topology.Topology[Carrier := A] \as Top;
  \module Over(source: Top.Topology);
}
\module GoodPair(A: \Set, source: topology.Topology[Carrier := A].Topology, subset: \Pow A);
