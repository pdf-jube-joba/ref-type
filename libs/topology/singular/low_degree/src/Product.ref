\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\import \root.Normalize[A := A, source := left, point := leftPoint] \as LeftNormalization;
\import \root.Normalize[A := B, source := right, point := rightPoint] \as RightNormalization;
\import singular_cohomology.Chains[A := A, source := left] \as Left;
\import singular_cohomology.Chains[A := B, source := right] \as Right;
\import Double.Tensor[C := Left.complex, D := Right.complex] \as Tensor;
\import Double.Total[C := Tensor.complex] \as Total;
\import topological_constructions.Product[A := A, B := B] \as Geometry;
\import Geometry.Universal[X := A] \as LeftProduct;
\import Geometry.Universal[X := B] \as RightProduct;
\import std.Data[].Pair[] \as Pairs;
\import topology.Maps[A := A, B := A].Identity[] \as LeftIdentity;
\import topology.Maps[A := B, B := B].Identity[] \as RightIdentity;
\import topology.Maps[A := A, B := B] \as LeftConstant;
\import topology.Maps[A := B, B := A] \as RightConstant;
\definition productTopology: topology.Topology[Carrier := Geometry.CarrierSet].Topology := Geometry.topology left right;
\definition first[x: A]: Geometry.CarrierSet := Pairs.pair A B x rightPoint;
\definition second[y: B]: Geometry.CarrierSet := Pairs.pair A B leftPoint y;
\import singular_cohomology.Maps[A := A, B := Geometry.CarrierSet, source := left, target := productTopology] \as LeftAxis;
\import singular_cohomology.Maps[A := B, B := Geometry.CarrierSet, source := right, target := productTopology] \as RightAxis;
\definition firstContinuous: LeftAxis.Continuous first := LeftProduct.pairContinuous left left right
  (\fun (x: A) => x) (\fun (_: A) => rightPoint) (LeftIdentity.continuous left) (LeftConstant.constantContinuous left right rightPoint);
\definition secondContinuous: RightAxis.Continuous second := RightProduct.pairContinuous right left right
  (\fun (_: B) => leftPoint) (\fun (y: B) => y) (RightConstant.constantContinuous right left leftPoint) (RightIdentity.continuous right);
\definition zero: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zero;
\definition two: N.Nat^ := N.Nat^::succ one;
\import singular_products.Cross[A := A, B := B, left := left, right := right] \as Shuffle;
\import singular_cohomology.Chains[A := Geometry.CarrierSet, source := productTopology] \as ProductChains;
\module AxisLeft;
\module AxisRight;
\module PullInjection(coefficients: Modules.Bundle);
\module With(leftPaths: LeftNormalization.PathFamily, rightPaths: RightNormalization.PathFamily);
