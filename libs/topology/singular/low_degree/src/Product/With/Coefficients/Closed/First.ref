\use std.Logic[].Equality[].eq_reason_in;
\import \root.Product[A := A, B := B, left := left, right := right, leftPoint := leftPoint, rightPoint := rightPoint].AxisLeft[] \as AxisLeft;
\definition onCycle: FirstPrimitive a -> \forall (x: Left.Carrier one) ->
  (phi).apply ((LeftAxis.At[n := one].push first firstContinuous).apply ((L.map).apply one x)) = (coefficients.space).zero :=
  \fun (boundary: FirstPrimitive a)(x: Left.Carrier one) => eq_reason_in!{coefficients.Carrier _
    "=" _ "by" { congr!{{LeftTheory.Carrier one} coefficients.Carrier}
      (\fun (f: LeftTheory.Carrier one) => (f).apply ((L.map).apply one x)) _ _ boundary }
    "=" _ "by" { congr!{{Left.Carrier zero} coefficients.Carrier} ((a).apply) _ _ (L.oneClosed x) }
    "=" _ "by" { LeftValues.zeroPreserved a }
  };
\definition law: FirstPrimitive a -> \forall (x: Left.Carrier one)(y: Right.Carrier zero) ->
  (normalized phi).apply ((Current.Component[i := firstIndex].injection).apply (FirstTerm.tensor x y)) = (coefficients.space).zero :=
  \fun (boundary: FirstPrimitive a)(x: Left.Carrier one)(y: Right.Carrier zero) => eq_reason_in!{coefficients.Carrier _
    "=" _ "by" { firstFormula x y }
    "=" _ "by" { congr!{{Right.Carrier zero} coefficients.Carrier} (\fun (v: Right.Carrier zero) => (phi).apply (FirstCross.apply ((L.map).apply one x) v)) _ _ (R.zeroValue y) }
    "=" _ "by" { congr!{{ProductChains.Carrier one} coefficients.Carrier} ((phi).apply) _ _ ((FirstCross.bilinear).scaleRight ((Right.Augmentation[].map).apply y) ((L.map).apply one x) AxisLeft.pointChain) }
    "=" _ "by" { (phi).scalar ((Right.Augmentation[].map).apply y) (FirstCross.apply ((L.map).apply one x) AxisLeft.pointChain) }
    "=" _ "by" { congr!{coefficients.Carrier coefficients.Carrier} ((coefficients.space).smul ((Right.Augmentation[].map).apply y)) _ _
              (trans!{coefficients.Carrier} _ _ _
                (congr!{{ProductChains.Carrier one} coefficients.Carrier} ((phi).apply) _ _ (AxisLeft.law ((L.map).apply one x)))
                (onCycle boundary x)) }
    "=" _ "by" { Values.scaleZero ((Right.Augmentation[].map).apply y) }
  };
