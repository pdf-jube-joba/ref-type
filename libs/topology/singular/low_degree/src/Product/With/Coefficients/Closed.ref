\use std.Logic[].Equality[].eq_reason_in;
\import Modules.Laws[V := coefficients.Carrier, space := coefficients.space] \as Values;
\import Modules.Hom[V := Left.Carrier zero, W := coefficients.Carrier,
  source := Left.space zero, target := coefficients.space] \as LeftValues;
\import Modules.Hom[V := Right.Carrier zero, W := coefficients.Carrier,
  source := Right.space zero, target := coefficients.space] \as RightValues;
\import Total.Degree[n := one] \as Current;
\import Shuffle.Total[].Degree[n := one] \as ShuffleDegree;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition firstIndex: Double.Index one := \into[Double.Pair](Double.Pair { first := one, second := zero }, Double.Index one) \by { \refl(one) };
\definition secondIndex: Double.Index one := \into[Double.Pair](Double.Pair { first := zero, second := one }, Double.Index one) \by { \refl(one) };
\import ShuffleDegree.At[i := firstIndex] \as FirstShuffle;
\import ShuffleDegree.At[i := secondIndex] \as SecondShuffle;
\import Tensor.Term[p := one, q := zero] \as FirstTerm;
\import Tensor.Term[p := zero, q := one] \as SecondTerm;
\import Shuffle.At[p := one, q := zero] \as FirstCross;
\import Shuffle.At[p := zero, q := one] \as SecondCross;
\definition firstShuffle[x: Left.Carrier one][y: Right.Carrier zero]:
  (Shuffle.Total[].map).apply one ((Current.Component[i := firstIndex].injection).apply (FirstTerm.tensor x y)) = FirstCross.apply x y :=
  eq_reason_in!{{ProductChains.Carrier one} _
    "=" _ "by" { ShuffleDegree.onInjection firstIndex (FirstTerm.tensor x y) }
    "=" _ "by" { FirstShuffle.onTensor x y }
    "=" _ "by" { Transport.castRefl ProductChains.Carrier one (FirstCross.apply x y) }
  };
\definition secondShuffle[x: Left.Carrier zero][y: Right.Carrier one]:
  (Shuffle.Total[].map).apply one ((Current.Component[i := secondIndex].injection).apply (SecondTerm.tensor x y)) = SecondCross.apply x y :=
  eq_reason_in!{{ProductChains.Carrier one} _
    "=" _ "by" { ShuffleDegree.onInjection secondIndex (SecondTerm.tensor x y) }
    "=" _ "by" { SecondShuffle.onTensor x y }
    "=" _ "by" { Transport.castRefl ProductChains.Carrier one (SecondCross.apply x y) }
  };
\definition firstFormula[x: Left.Carrier one][y: Right.Carrier zero]:
  (normalized phi).apply ((Current.Component[i := firstIndex].injection).apply (FirstTerm.tensor x y)) =
    (phi).apply (FirstCross.apply ((L.map).apply one x) ((R.map).apply zero y)) :=
  trans!{coefficients.Carrier} _ _ _
    (congr!{Current.Carrier coefficients.Carrier} (\fun (v: Current.Carrier) => (phi).apply ((Shuffle.Total[].map).apply one v)) _ _
      (\parent.\parent.Degree[n := one].onTensor firstIndex x y))
    (congr!{{ProductChains.Carrier one} coefficients.Carrier} ((phi).apply) _ _ (firstShuffle ((L.map).apply one x) ((R.map).apply zero y)));
\definition secondFormula[x: Left.Carrier zero][y: Right.Carrier one]:
  (normalized phi).apply ((Current.Component[i := secondIndex].injection).apply (SecondTerm.tensor x y)) =
    (phi).apply (SecondCross.apply ((L.map).apply zero x) ((R.map).apply one y)) :=
  trans!{coefficients.Carrier} _ _ _
    (congr!{Current.Carrier coefficients.Carrier} (\fun (v: Current.Carrier) => (phi).apply ((Shuffle.Total[].map).apply one v)) _ _
      (\parent.\parent.Degree[n := one].onTensor secondIndex x y))
    (congr!{{ProductChains.Carrier one} coefficients.Carrier} ((phi).apply) _ _ (secondShuffle ((L.map).apply zero x) ((R.map).apply one y)));
\definition FirstPrimitive[a: LeftTheory.Carrier zero]: \Prop := (FirstRestriction.map).apply one phi = LeftTheory.apply zero a;
\definition SecondPrimitive[b: RightTheory.Carrier zero]: \Prop := (SecondRestriction.map).apply one phi = RightTheory.apply zero b;
\module First(a: LeftTheory.Carrier zero);
\module Second(b: RightTheory.Carrier zero);
\import singular_eilenberg_zilber.TensorGenerators[A := A, B := B, left := left, right := right].To[
  n := one, W := coefficients.Carrier, target := coefficients.space] \as Generators;
\import Modules.Hom[V := Current.Carrier, W := coefficients.Carrier,
  source := Current.space, target := coefficients.space] \as Linear;
\definition Vanishes[i: Double.Index one]: \Prop :=
  \forall (sigma: singular_cohomology.Simplices[A := A, source := left].Carrier (i).first)
    (tau: singular_cohomology.Simplices[A := B, source := right].Carrier (i).second) ->
    (normalized phi).apply (Generators.generator i sigma tau) = (coefficients.space).zero;
\module Primitive(a: LeftTheory.Carrier zero, b: RightTheory.Carrier zero);
\import std.Logic[].Proposition[] \as Logic;
\definition firstPrimitiveExists: (firstRestriction).apply (ProductH.classOf phi) = (LeftH.cohomologySpace).zero ->
  \exists ( a: LeftTheory.Carrier zero \where FirstPrimitive a ) := \block {
  \fun (vanishes: _) \then
  \let boundary: _ := LeftH.zeroClassBoundary ((LeftMaps.cyclesMap FirstRestriction.map).apply phi)
    (trans!{LeftH.Cohomology} _ _ _ (sym!{LeftH.Cohomology} _ _ (LeftMaps.onClass FirstRestriction.map phi)) vanishes) \then
  \takefrom a: \Cast[LeftTheory.Carrier zero] ({ a: LeftTheory.Carrier zero \where LeftTheory.apply zero a = (FirstRestriction.map).apply one phi }) \by boundary \then
  \return Logic.existsIntro[LeftTheory.Carrier zero, { a: LeftTheory.Carrier zero \where FirstPrimitive a }] a
    (sym!{{LeftTheory.Carrier one}} _ _ (\bysub(LeftTheory.Carrier zero,
      { a: LeftTheory.Carrier zero \where LeftTheory.apply zero a = (FirstRestriction.map).apply one phi }, a)))
};
\definition secondPrimitiveExists: (secondRestriction).apply (ProductH.classOf phi) = (RightH.cohomologySpace).zero ->
  \exists ( b: RightTheory.Carrier zero \where SecondPrimitive b ) := \block {
  \fun (vanishes: _) \then
  \let boundary: _ := RightH.zeroClassBoundary ((RightMaps.cyclesMap SecondRestriction.map).apply phi)
    (trans!{RightH.Cohomology} _ _ _ (sym!{RightH.Cohomology} _ _ (RightMaps.onClass SecondRestriction.map phi)) vanishes) \then
  \takefrom b: \Cast[RightTheory.Carrier zero] ({ b: RightTheory.Carrier zero \where RightTheory.apply zero b = (SecondRestriction.map).apply one phi }) \by boundary \then
  \return Logic.existsIntro[RightTheory.Carrier zero, { b: RightTheory.Carrier zero \where SecondPrimitive b }] b
    (sym!{{RightTheory.Carrier one}} _ _ (\bysub(RightTheory.Carrier zero,
      { b: RightTheory.Carrier zero \where RightTheory.apply zero b = (SecondRestriction.map).apply one phi }, b)))
};
\definition normalizedCycle: TensorH.CycleCarrier := (NormalizeMaps.cyclesMap Normalize.map).apply ((PullMaps.cyclesMap Pull.map).apply phi);
\import Cohomology.At[C := TensorTheory.complex, k := zero] \as TensorZero;
\definition normalizedClassZero: normalized phi = Linear.zeroMap -> TensorH.classOf normalizedCycle = (TensorH.cohomologySpace).zero :=
  \fun (vanishes: normalized phi = Linear.zeroMap) => TensorH.boundaryClassZero normalizedCycle
    (Logic.existsIntro[TensorTheory.Carrier zero, { a: TensorTheory.Carrier zero \where TensorTheory.apply zero a = normalized phi }]
      (TensorTheory.space zero).zero
      (trans!{{TensorTheory.Carrier one}} _ _ _ TensorZero.differentialZero (sym!{{TensorTheory.Carrier one}} _ _ vanishes)));
\definition pullClassZero: normalized phi = Linear.zeroMap -> (PullMaps.induced Pull.map).apply (ProductH.classOf phi) = (TensorH.cohomologySpace).zero :=
  \fun (vanishes: _) => eq_reason_in!{TensorH.Cohomology _
    "=" _ "by" { sym!{TensorH.Cohomology} _ _ (normalizationIdentity ((PullMaps.induced Pull.map).apply (ProductH.classOf phi))) }
    "=" _ "by" { congr!{TensorH.Cohomology TensorH.Cohomology} ((NormalizeMaps.induced Normalize.map).apply) _ _ (PullMaps.onClass Pull.map phi) }
    "=" _ "by" { NormalizeMaps.onClass Normalize.map ((PullMaps.cyclesMap Pull.map).apply phi) }
    "=" _ "by" { normalizedClassZero vanishes }
  };
\definition detected: (firstRestriction).apply (ProductH.classOf phi) = (LeftH.cohomologySpace).zero ->
  (secondRestriction).apply (ProductH.classOf phi) = (RightH.cohomologySpace).zero -> ProductH.classOf phi = (ProductH.cohomologySpace).zero := \block {
  \fun (leftZero: _)(rightZero: _) \then
  \takefrom a: \Cast[LeftTheory.Carrier zero] ({ a: LeftTheory.Carrier zero \where FirstPrimitive a }) \by firstPrimitiveExists leftZero \then
  \takefrom b: \Cast[RightTheory.Carrier zero] ({ b: RightTheory.Carrier zero \where SecondPrimitive b }) \by secondPrimitiveExists rightZero \then
  \return pullDetectsZero (ProductH.classOf phi)
    (pullClassZero (Primitive[a := a, b := b].zero
      (\bysub(LeftTheory.Carrier zero, { a: LeftTheory.Carrier zero \where FirstPrimitive a }, a))
      (\bysub(RightTheory.Carrier zero, { b: RightTheory.Carrier zero \where SecondPrimitive b }, b))))
};
