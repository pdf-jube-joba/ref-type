\use std.Logic[].Equality[].eq_reason_in;
\import \root.Product[A := A, B := B, left := left, right := right, leftPoint := leftPoint, rightPoint := rightPoint].AxisRight[] \as AxisRight;
\definition onCycle: SecondPrimitive b -> \forall (y: Right.Carrier one) ->
  (phi).apply ((RightAxis.At[n := one].push second secondContinuous).apply ((R.map).apply one y)) = (coefficients.space).zero :=
  \fun (boundary: SecondPrimitive b)(y: Right.Carrier one) => eq_reason_in!{coefficients.Carrier _
    "=" _ "by" { congr!{{RightTheory.Carrier one} coefficients.Carrier}
      (\fun (f: RightTheory.Carrier one) => (f).apply ((R.map).apply one y)) _ _ boundary }
    "=" _ "by" { congr!{{Right.Carrier zero} coefficients.Carrier} ((b).apply) _ _ (R.oneClosed y) }
    "=" _ "by" { RightValues.zeroPreserved b }
  };
\definition law: SecondPrimitive b -> \forall (x: Left.Carrier zero)(y: Right.Carrier one) ->
  (normalized phi).apply ((Current.Component[i := secondIndex].injection).apply (SecondTerm.tensor x y)) = (coefficients.space).zero :=
  \fun (boundary: SecondPrimitive b)(x: Left.Carrier zero)(y: Right.Carrier one) => eq_reason_in!{coefficients.Carrier _
    "=" _ "by" { secondFormula x y }
    "=" _ "by" { congr!{{Left.Carrier zero} coefficients.Carrier} (\fun (v: Left.Carrier zero) => (phi).apply (SecondCross.apply v ((R.map).apply one y))) _ _ (L.zeroValue x) }
    "=" _ "by" { congr!{{ProductChains.Carrier one} coefficients.Carrier} ((phi).apply) _ _ ((SecondCross.bilinear).scaleLeft ((Left.Augmentation[].map).apply x) AxisRight.pointChain ((R.map).apply one y)) }
    "=" _ "by" { (phi).scalar ((Left.Augmentation[].map).apply x) (SecondCross.apply AxisRight.pointChain ((R.map).apply one y)) }
    "=" _ "by" { congr!{coefficients.Carrier coefficients.Carrier} ((coefficients.space).smul ((Left.Augmentation[].map).apply x)) _ _
              (trans!{coefficients.Carrier} _ _ _
                (congr!{{ProductChains.Carrier one} coefficients.Carrier} ((phi).apply) _ _ (AxisRight.law ((R.map).apply one y)))
                (onCycle boundary y)) }
    "=" _ "by" { Values.scaleZero ((Left.Augmentation[].map).apply x) }
  };
