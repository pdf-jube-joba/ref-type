\import \root.Product[A := A, B := B, left := left, right := right, leftPoint := leftPoint, rightPoint := rightPoint].AxisRight[] \as AxisRight;
\definition onCycle: SecondPrimitive b -> \forall (y: Right.Carrier one) ->
  (phi).apply ((RightAxis.At[n := one].push second secondContinuous).apply ((R.map).apply one y)) = (coefficients.space).zero :=
  \fun (boundary: SecondPrimitive b)(y: Right.Carrier one) => trans!{coefficients.Carrier} _ _ _
    (congr!{{RightTheory.Carrier one} coefficients.Carrier}
      (\fun (f: RightTheory.Carrier one) => (f).apply ((R.map).apply one y)) _ _ boundary)
    (trans!{coefficients.Carrier} _ _ _
      (congr!{{Right.Carrier zero} coefficients.Carrier} ((b).apply) _ _ (R.oneClosed y))
      (RightValues.zeroPreserved b));
\definition law: SecondPrimitive b -> \forall (x: Left.Carrier zero)(y: Right.Carrier one) ->
  (normalized phi).apply ((Current.Component[i := secondIndex].injection).apply (SecondTerm.tensor x y)) = (coefficients.space).zero :=
  \fun (boundary: SecondPrimitive b)(x: Left.Carrier zero)(y: Right.Carrier one) => trans!{coefficients.Carrier} _ _ _ (secondFormula x y)
    (trans!{coefficients.Carrier} _ _ _
      (congr!{{Left.Carrier zero} coefficients.Carrier} (\fun (v: Left.Carrier zero) => (phi).apply (SecondCross.apply v ((R.map).apply one y))) _ _ (L.zeroValue x))
      (trans!{coefficients.Carrier} _ _ _
        (congr!{{ProductChains.Carrier one} coefficients.Carrier} ((phi).apply) _ _ ((SecondCross.bilinear).scaleLeft ((Left.Augmentation[].map).apply x) AxisRight.pointChain ((R.map).apply one y)))
        (trans!{coefficients.Carrier} _ _ _ ((phi).scalar ((Left.Augmentation[].map).apply x) (SecondCross.apply AxisRight.pointChain ((R.map).apply one y)))
          (trans!{coefficients.Carrier} _ _ _
            (congr!{coefficients.Carrier coefficients.Carrier} ((coefficients.space).smul ((Left.Augmentation[].map).apply x)) _ _
              (trans!{coefficients.Carrier} _ _ _
                (congr!{{ProductChains.Carrier one} coefficients.Carrier} ((phi).apply) _ _ (AxisRight.law ((R.map).apply one y)))
                (onCycle boundary y)))
            (Values.scaleZero ((Left.Augmentation[].map).apply x))))));
