\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import algebraic_topology.PathComponent[A := A, source := source] \as Paths;
\definition PathFamily: \Set := \forall (x: A) -> Paths.Path point x;
\definition pathFamilyExists: Paths.PathConnected -> \exists PathFamily :=
  \fun (connected: Paths.PathConnected) => \axiom:classicalIndefiniteChoice(A, (\fun (x: A) => Paths.Path point x), connected point);
\module With(paths: PathFamily);
