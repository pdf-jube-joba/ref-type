\import singular_cohomology.Chains[A := A, source := source] \as Chains;
\import singular_cohomology.Simplices[A := A, source := source] \as Simplices;
\import singular_cohomology.Zero[A := A, source := source] \as Zero;
\import algebraic_topology.Simplex[] \as Simplex;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition ZeroChain: \Set := Chains.Carrier N.Nat^::zero;
\definition OneChain: \Set := Chains.Carrier one;
\definition zeroSpace: Modules.Space ZeroChain := Chains.space N.Nat^::zero;
\definition oneSpace: Modules.Space OneChain := Chains.space one;
\definition coefficient: Modules.Bundle := Modules.Bundle { Carrier := ZeroChain, space := zeroSpace };
\import Zero.With[coefficients := coefficient] \as Coefficients;
\import Coefficients.Edges[] \as Edges;
\import Modules.End[V := ZeroChain, space := zeroSpace] \as ZeroEnd;
\import Modules.Laws[V := ZeroChain, space := zeroSpace] \as ZeroLaws;
\import algebra.Group[].Of[Carrier := ZeroChain, group := ZeroLaws.additive] \as Group;
\definition pointChain: ZeroChain := Chains.generator N.Nat^::zero (Coefficients.constant point);
\definition pathSimplex[x: A]: Simplices.Carrier one := Zero.simplex point x (paths x);
\definition generator[sigma: Simplices.Carrier N.Nat^::zero]: OneChain :=
  Chains.generator one (pathSimplex (sigma Simplex.zeroPoint));
\import Modules.Free[Generators := Simplices.Carrier N.Nat^::zero].To[W := OneChain, target := oneSpace] \as Extension;
\definition section: Modules.Hom[V := ZeroChain, W := OneChain, source := zeroSpace, target := oneSpace].Map := Extension.extension generator;
\definition onGenerator: \forall (sigma: Simplices.Carrier N.Nat^::zero) ->
  (section).apply (Chains.generator N.Nat^::zero sigma) = generator sigma := Extension.onGenerator generator;
\definition boundaryOnPath: \forall (x: A) ->
  (Chains.differential).apply N.Nat^::zero (Chains.generator one (pathSimplex x)) =
    Group.difference (Chains.generator N.Nat^::zero (Coefficients.constant x)) pointChain :=
  \fun (x: A) => trans!{ZeroChain} _ _ _ (Edges.coboundary ZeroEnd.identity (pathSimplex x))
    (congr2!{ZeroChain ZeroChain ZeroChain} Group.difference _ _ _ _
      (congr!{A ZeroChain} (\fun (y: A) => Chains.generator N.Nat^::zero (Coefficients.constant y)) _ _ (Zero.simplexEnd point x (paths x)))
      (congr!{A ZeroChain} (\fun (y: A) => Chains.generator N.Nat^::zero (Coefficients.constant y)) _ _ (Zero.simplexStart point x (paths x))));
\definition boundaryOnGenerator: \forall (sigma: Simplices.Carrier N.Nat^::zero) ->
  (Chains.differential).apply N.Nat^::zero ((section).apply (Chains.generator N.Nat^::zero sigma)) =
    Group.difference (Chains.generator N.Nat^::zero sigma) pointChain :=
  \fun (sigma: Simplices.Carrier N.Nat^::zero) => trans!{ZeroChain} _ _ _
    (congr!{OneChain ZeroChain} ((Chains.differential).apply N.Nat^::zero) _ _ (onGenerator sigma))
    (trans!{ZeroChain} _ _ _ (boundaryOnPath (sigma Simplex.zeroPoint))
      (congr!{ZeroChain ZeroChain} (\fun (x: ZeroChain) => Group.difference x pointChain) _ _
        (sym!{ZeroChain} _ _ (congr!{{Simplices.Carrier N.Nat^::zero} ZeroChain} (Chains.generator N.Nat^::zero) _ _ (Coefficients.simplexConstant sigma)))));
\import Native.Homotopy[C := Chains.complex, D := Chains.complex] \as Homotopies;
\module Degree(n: N.Nat^) {
  \import Modules.Hom[V := Chains.Carrier (N.Nat^::succ n), W := Chains.Carrier (N.Nat^::succ (N.Nat^::succ n)), source := Chains.space (N.Nat^::succ n), target := Chains.space (N.Nat^::succ (N.Nat^::succ n))] \as Maps;
  \definition zero: Maps.Map := Maps.zeroMap;
}
\definition linear: \forall (n: N.Nat^) ->
  Modules.Hom[V := Chains.Carrier n, W := Chains.Carrier (N.Nat^::succ n), source := Chains.space n, target := Chains.space (N.Nat^::succ n)].Map :=
  \induction (n: N.Nat^) \return
    Modules.Hom[V := Chains.Carrier n, W := Chains.Carrier (N.Nat^::succ n), source := Chains.space n, target := Chains.space (N.Nat^::succ n)].Map \with {
    | zero: section
    | succ: \fun (n: N.Nat^)(unused: _) => Degree[n := n].zero
  };
\definition data: Homotopies.Data := Homotopies.Data { apply := \fun (n: N.Nat^) => (linear n).apply };
\definition homotopyData: Homotopies.LinearData := \into[Homotopies.Data](data, { data: Homotopies.Data \where Homotopies.LinearLaws[data] }) \by {
  Homotopies.LinearLaws[data] {
    addition := \fun (n: N.Nat^) => (linear n).addition, scalar := \fun (n: N.Nat^) => (linear n).scalar,
  }
};
\import Native.End[C := Chains.complex] \as End;
\import Homotopies.Boundary[h := homotopyData].Correct[f := End.identity] \as Correction;
\definition map: Native.Map[C := Chains.complex, D := Chains.complex].Map := Correction.map;
\definition homotopy: Homotopies.Homotopy End.identity map := Correction.homotopy;
\definition zeroOnGenerator: \forall (sigma: Simplices.Carrier N.Nat^::zero) ->
  (map).apply N.Nat^::zero (Chains.generator N.Nat^::zero sigma) = pointChain :=
  \fun (sigma: Simplices.Carrier N.Nat^::zero) => trans!{ZeroChain} _ _ _
    (congr!{ZeroChain ZeroChain} (Group.difference (Chains.generator N.Nat^::zero sigma)) _ _ (boundaryOnGenerator sigma))
    (Group.subtractDifference (Chains.generator N.Nat^::zero sigma) pointChain);
\import Chains.Augmentation[] \as Augmentation;
\import Modules.Hom[V := I.Int^, W := ZeroChain, source := Modules.scalarModule, target := zeroSpace] \as FromScalars;
\definition scalarSection: FromScalars.Map := FromScalars.Map {
  apply := \fun (a: I.Int^) => (zeroSpace).smul a pointChain,
  addition := \fun (a, b: I.Int^) => (zeroSpace).scalarAdd a b pointChain,
  scalar := \fun (a, b: I.Int^) => (zeroSpace).scalarAssoc a b pointChain,
};
\import FromScalars.Composition[U := ZeroChain, domain := zeroSpace] \as Projection;
\definition zeroProjection: Modules.Hom[V := ZeroChain, W := ZeroChain, source := zeroSpace, target := zeroSpace].Map :=
  Projection.compose scalarSection Augmentation.map;
\import Native.Map[C := Chains.complex, D := Chains.complex].At[n := N.Nat^::zero] \as NativeZero;
\import Modules.Free[Generators := Simplices.Carrier N.Nat^::zero].To[W := ZeroChain, target := zeroSpace] \as FreeZero;
\definition zeroEquation: NativeZero.linear map = zeroProjection :=
  FreeZero.ext (NativeZero.linear map) zeroProjection
    (\fun (sigma: Simplices.Carrier N.Nat^::zero) => trans!{ZeroChain} _ _ _ (zeroOnGenerator sigma)
      (sym!{ZeroChain} _ _
        (trans!{ZeroChain} _ _ _
          (congr!{I.Int^ ZeroChain} (\fun (a: I.Int^) => (zeroSpace).smul a pointChain) _ _ (Augmentation.onGenerator sigma))
          ((zeroSpace).scalarOne pointChain))));
\definition zeroValue: \forall (x: ZeroChain) -> (map).apply N.Nat^::zero x = (zeroSpace).smul ((Augmentation.map).apply x) pointChain :=
  \fun (x: ZeroChain) => congr!{{Modules.Hom[V := ZeroChain, W := ZeroChain, source := zeroSpace, target := zeroSpace].Map} ZeroChain}
    (\fun (f: Modules.Hom[V := ZeroChain, W := ZeroChain, source := zeroSpace, target := zeroSpace].Map) => (f).apply x) _ _ zeroEquation;
\definition oneClosed: \forall (x: OneChain) -> (Chains.differential).apply N.Nat^::zero ((map).apply one x) = (zeroSpace).zero :=
  \fun (x: OneChain) => trans!{ZeroChain} _ _ _ ((map).commutes N.Nat^::zero x)
    (trans!{ZeroChain} _ _ _ (zeroValue ((Chains.differential).apply N.Nat^::zero x))
      (trans!{ZeroChain} _ _ _
        (congr!{I.Int^ ZeroChain} (\fun (a: I.Int^) => (zeroSpace).smul a pointChain) _ _ (Augmentation.killsBoundary x))
        (ZeroLaws.zeroScale pointChain)));
\import Native.Homotopy[C := Chains.complex, D := Chains.complex].Reverse[] \as Reverse;
\definition reverseHomotopy: Homotopies.Homotopy map End.identity := Reverse.homotopy End.identity map homotopy;
