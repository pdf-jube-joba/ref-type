\import Cochains.At[C := complex, k := n] \as Source;
\import Cochains.At[C := Native.complex, k := n] \as Target;
\definition isomorphism: Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology,
  source := Source.cohomologySpace, target := Target.cohomologySpace].Isomorphism := Compared.At[n := n].isomorphism;
