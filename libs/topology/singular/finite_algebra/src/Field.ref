\import std.Data[].Nat[] \as N;
\import std.Alg[].Field[] \as Fields;
\import std.Alg[].Ring[] \as Rings;
\definition commutativeRing: Rings.CommutativeRing[K] := Fields.fieldAsCommutativeRing K field;
\definition ring: Rings.Ring[K] := Rings.commutativeRingAsRing K commutativeRing;
\import module_theory.Module[].Over[R := K, ring := ring] \as Modules;
\import field_kunneth.FieldFinite[].Over[K := K, field := field] \as Finite;
\import field_kunneth.Kunneth[].Field[K := K, field := field] \as Kunneth;
\import field_kunneth.TensorCochain[].Over[R := K, ring := commutativeRing] \as Tensor;
\import chain_complexes.Cochain[].Over[R := K, ring := ring] \as Cochains;
\module Product(X, Y: \Set, left: topology.Topology[Carrier := X].Topology,
  right: topology.Topology[Carrier := Y].Topology, first, second: Finite.Complex);

\import homological_algebra.Finite[].Bounded[] \as IntegerModels;
\module IntegralModel(model: IntegerModels.Complex);
\module IntegralProduct(X, Y: \Set, left: topology.Topology[Carrier := X].Topology,
  right: topology.Topology[Carrier := Y].Topology, first, second: IntegerModels.Complex);
