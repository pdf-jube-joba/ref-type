\definition z: I.Int^ := I.Int^::negSucc n;
\import Modules.Hom[V := Q.family.Carrier z, W := P.family.Carrier z, source := Q.family.space z, target := P.family.space z] \as Backward;
\import Modules.Hom[V := P.family.Carrier z, W := P.family.Carrier (Degrees.next z), source := P.family.space z, target := P.family.space (Degrees.next z)] \as Source;
\import Modules.Hom[V := Q.family.Carrier z, W := Q.family.Carrier (Degrees.next z), source := Q.family.space z, target := Q.family.space (Degrees.next z)] \as Target;
\definition backwardMap: Backward.Map := Backward.zeroMap;
\definition sourceMap: Source.Map := Source.zeroMap;
\definition targetMap: Target.Map := Target.zeroMap;
