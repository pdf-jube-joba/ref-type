\definition degree: I.Int^ := I.Int^::ofNat N.Nat^::zero;
\import \parent.\parent.Zero[] \as Model;
\import std.Logic[].Equality[].Transport[A := I.Int^] \as Transport;
\use Equality.congr;
\definition sourcePrior[x: P.family.Carrier degree]:
  SourcePrior.value degree (sourceOperator degree x) = (P.differential).apply (Degrees.next degree) (sourceOperator degree x) :=
  Transport.castRefl P.family.Carrier degree ((P.differential).apply (Degrees.next degree) (sourceOperator degree x));
\definition sourceShifted[x: P.family.Carrier degree]:
  SourceHomotopies.shifted sourceData degree ((P.differential).apply degree x) = (P.family.space degree).zero :=
  Transport.castRefl P.family.Carrier degree (P.family.space degree).zero;
\definition left: LeftEquation degree := \fun (x: P.family.Carrier degree) =>
  trans!{{P.family.Carrier degree}} _ _ _ (Model.sourceEquation sourceNegative x)
    (congr!{{P.family.Carrier degree} {P.family.Carrier degree} {P.family.Carrier degree}}
      ((P.family.space degree).add) _ _ _ _
      (sym!{{P.family.Carrier degree}} _ _ (sourcePrior x))
      (sym!{{P.family.Carrier degree}} _ _ (sourceShifted x)));
\definition targetPrior[x: Q.family.Carrier degree]:
  TargetPrior.value degree (targetOperator degree x) = (Q.differential).apply (Degrees.next degree) (targetOperator degree x) :=
  Transport.castRefl Q.family.Carrier degree ((Q.differential).apply (Degrees.next degree) (targetOperator degree x));
\definition targetShifted[x: Q.family.Carrier degree]:
  TargetHomotopies.shifted targetData degree ((Q.differential).apply degree x) = (Q.family.space degree).zero :=
  Transport.castRefl Q.family.Carrier degree (Q.family.space degree).zero;
\definition right: RightEquation degree := \fun (x: Q.family.Carrier degree) =>
  trans!{{Q.family.Carrier degree}} _ _ _ (Model.targetZeroEquation x)
    (congr!{{Q.family.Carrier degree} {Q.family.Carrier degree} {Q.family.Carrier degree}}
      ((Q.family.space degree).add) _ _ _ _
      (sym!{{Q.family.Carrier degree}} _ _ (targetPrior x))
      (sym!{{Q.family.Carrier degree}} _ _ (targetShifted x)));
