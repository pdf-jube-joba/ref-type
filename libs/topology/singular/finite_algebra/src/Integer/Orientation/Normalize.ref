\import singular_cellular_algebra.Algebra[].AbsoluteHomeomorphism[A := A, B := B,
  source := source, target := target, homeomorphism := homeomorphism] \as Actual;
\import SignedChains.Isomorphism[C := SourceExtension.complex, D := TargetExtension.complex].At[z := z] \as ActualHomology;
\definition actual: Modules.Isomorphism[V := SourceCarrier, W := TargetCarrier, source := sourceSpace, target := targetSpace].Isomorphism :=
  ActualHomology.isomorphism Actual.isomorphism;
\import SourceOrientations.Composition[U := TargetCarrier, final := targetSpace] \as ForwardCoordinates;
\import Modules.Isomorphism[V := I.Int^, W := TargetCarrier, source := Modules.scalarModule, target := targetSpace]
  .Composition[U := I.Int^, final := Modules.scalarModule] \as BackCoordinates;
\definition coordinates: Modules.Isomorphism[V := I.Int^, W := I.Int^, source := Modules.scalarModule, target := Modules.scalarModule].Isomorphism :=
  BackCoordinates.compose (TargetOrientations.Inverse[].inverse targetOrientation)
    (ForwardCoordinates.compose actual sourceOrientation);
\definition sourceGenerator: SourceCarrier := ((sourceOrientation).forward).apply I.One.specification;
\definition targetGenerator: TargetCarrier := ((targetOrientation).forward).apply I.One.specification;
\definition Positive[h: Homeomorphisms.Homeomorphism[source, target]]: \Prop :=
  (action h).apply sourceGenerator = targetGenerator;
\definition Result: \Set := \Cast[Homeomorphisms.Homeomorphism[source, target]] ({ h: Homeomorphisms.Homeomorphism[source, target] \where Positive h });
\import Modules.Hom[V := I.Int^, W := TargetCarrier, source := Modules.scalarModule, target := targetSpace] \as TargetLinear;
\import Modules.Laws[V := TargetCarrier, space := targetSpace] \as TargetLaws;
\import algebra.Group[].Of[Carrier := TargetCarrier, group := TargetLaws.additive] \as TargetGroup;
\definition reconstruct: (action homeomorphism).apply sourceGenerator =
  ((targetOrientation).forward).apply (((coordinates).forward).apply I.One.specification) :=
  sym!{TargetCarrier} _ _ ((targetOrientation).rightInverse ((action homeomorphism).apply sourceGenerator));
\definition positive[same: ((coordinates).forward).apply I.One.specification = I.One.specification]: Positive homeomorphism :=
  trans!{TargetCarrier} _ _ _ reconstruct
    (congr!{I.Int^ TargetCarrier} (((targetOrientation).forward).apply) _ _ same);
\definition negative[same: ((coordinates).forward).apply I.One.specification = std.Arithmetic[].IntAlgebra[].Calculation[].neg I.One.specification]:
  (action homeomorphism).apply sourceGenerator = TargetLaws.neg targetGenerator :=
  trans!{TargetCarrier} _ _ _ reconstruct
    (trans!{TargetCarrier} _ _ _
      (congr!{I.Int^ TargetCarrier} (((targetOrientation).forward).apply) _ _ same)
      (TargetLinear.negativePreserved (targetOrientation).forward I.One.specification));
\import Homeomorphisms.Composition[C := B] \as ComposeHomeomorphisms;
\definition corrected: Homeomorphisms.Homeomorphism[source, target] :=
  ComposeHomeomorphisms.compose source target target homeomorphism reflection;
\import Maps.Composition[C := B, final := target] \as ComposeMaps;
\import SignedChains.Map[C := TargetExtension.complex, D := TargetExtension.complex].Composition[B := SourceExtension.complex] \as ComposeChains;
\definition composition[q: SourceCarrier]: (action corrected).apply q =
  (endAction reflection).apply ((action homeomorphism).apply q) :=
  trans!{TargetCarrier} _ _ _
    (congr!{{SignedChains.Map[C := SourceExtension.complex, D := TargetExtension.complex].Map} TargetCarrier}
      (\fun (f: SignedChains.Map[C := SourceExtension.complex, D := TargetExtension.complex].Map) => (Induced.induced f).apply q) _ _
      (sym!{{SignedChains.Map[C := SourceExtension.complex, D := TargetExtension.complex].Map}} _ _
        (ComposeMaps.Integer[].law ((homeomorphism).forward) ((Homeomorphisms.laws source target homeomorphism).forwardContinuous)
          ((reflection).forward) ((Reflections.laws target target reflection).forwardContinuous))))
    (ComposeChains.At[k := z].compositionOnHomology
      (EndMaps.integerPush ((reflection).forward) ((Reflections.laws target target reflection).forwardContinuous))
      (Maps.integerPush ((homeomorphism).forward) ((Homeomorphisms.laws source target homeomorphism).forwardContinuous)) q);
\definition correctedPositive:
  (\forall (q: TargetCarrier) -> (endAction reflection).apply q = TargetLaws.neg q) ->
  ((coordinates).forward).apply I.One.specification = std.Arithmetic[].IntAlgebra[].Calculation[].neg I.One.specification -> Positive corrected :=
  \fun (negativeAction: _)(same: _) => trans!{TargetCarrier} _ _ _ (composition sourceGenerator)
    (trans!{TargetCarrier} _ _ _ (negativeAction ((action homeomorphism).apply sourceGenerator))
      (trans!{TargetCarrier} _ _ _ (congr!{TargetCarrier TargetCarrier} TargetLaws.neg _ _ (negative same))
        (TargetGroup.negNeg targetGenerator)));
\definition existence:
  (\forall (q: TargetCarrier) -> (endAction reflection).apply q = TargetLaws.neg q) ->
  \exists Result :=
  \fun (negativeAction: _) => Logic.orElim
    (((coordinates).forward).apply I.One.specification = I.One.specification)
    (((coordinates).forward).apply I.One.specification = std.Arithmetic[].IntAlgebra[].Calculation[].neg I.One.specification)
    (\exists Result)
    (\parent.\parent.Units[].automorphism coordinates)
    (\fun (same: _) => \exact(\into[Homeomorphisms.Homeomorphism[source, target]](homeomorphism, { h: Homeomorphisms.Homeomorphism[source, target] \where Positive h }) \by { positive same }, Result))
    (\fun (same: _) => \exact(\into[Homeomorphisms.Homeomorphism[source, target]](corrected, { h: Homeomorphisms.Homeomorphism[source, target] \where Positive h }) \by { correctedPositive negativeAction same }, Result));
