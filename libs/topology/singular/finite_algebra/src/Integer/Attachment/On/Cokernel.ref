\import Modules.RightExact[A := coefficients, B := coefficients, C := second] \as RightExact;
\definition sequence: RightExact.Sequence := RightExact.Sequence {
  inclusion := double, projection := data.relative, onto := (data).onto,
  zero := \fun (x: coefficients.Carrier) => trans!{second.Carrier} _ _ _
    (congr!{coefficients.Carrier second.Carrier} ((data.relative).apply) _ _ (sym!{coefficients.Carrier} _ _ ((data).doubling x)))
    (((data).exactAtSecond).zero x),
  kernelImage := \block {
    \fun (y: coefficients.Carrier)(killed: _) \then
    \takefrom x: \Cast[coefficients.Carrier] ({ x: coefficients.Carrier \where (data.connecting).apply x = y }) \by
      ((data).exactAtSecond).kernelImage y killed \then
    \return Logic.existsIntro[coefficients.Carrier, { x: coefficients.Carrier \where (double).apply x = y }] x
      (trans!{coefficients.Carrier} _ _ _ (sym!{coefficients.Carrier} _ _ ((data).doubling x))
        (\bysub(coefficients.Carrier, { x: coefficients.Carrier \where (data.connecting).apply x = y }, x)))
  },
};
\import RightExact.Cokernel[sequence := sequence] \as Comparison;
\definition isomorphism: Modules.Isomorphism[V := CokernelCarrier, W := second.Carrier, source := cokernelSpace, target := second.space].Isomorphism :=
  Comparison.isomorphism;
\definition onRelativeClass: \forall (x: coefficients.Carrier) ->
  ((isomorphism).forward).apply (relativeClass x) = (data.relative).apply x := Comparison.onClass;
