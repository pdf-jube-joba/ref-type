\import Modules.Hom[V := first.Carrier, W := KernelCarrier, source := first.space, target := kernelSpace] \as Forward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (x: first.Carrier) => \into[coefficients.Carrier]((data.restriction).apply x, (kernel).carrier) \by {
    trans!{coefficients.Carrier} _ _ _ (sym!{coefficients.Carrier} _ _ ((data).doubling ((data.restriction).apply x)))
      (((data).exactAtFirst).zero x)
  },
  addition := (data.restriction).addition, scalar := (data.restriction).scalar,
};
\definition injective: \forall (x, y: first.Carrier) -> (forward).apply x = (forward).apply y -> x = y := (data).injective;
\definition onto: \forall (q: KernelCarrier) -> \exists ( x: first.Carrier \where (forward).apply x = q ) := \block {
  \fun (q: KernelCarrier) \then
  \takefrom x: \Cast[first.Carrier] ({ x: first.Carrier \where (data.restriction).apply x = q }) \by
    ((data).exactAtFirst).kernelImage q
      (trans!{coefficients.Carrier} _ _ _ ((data).doubling q) (\bysub(coefficients.Carrier, (kernel).carrier, q))) \then
  \return Logic.existsIntro[first.Carrier, { x: first.Carrier \where (forward).apply x = q }] x
    (\bysub(first.Carrier, { x: first.Carrier \where (data.restriction).apply x = q }, x))
};
\import Modules.Isomorphism[V := first.Carrier, W := KernelCarrier, source := first.space, target := kernelSpace].OfBijective[f := forward] \as Inverse;
\definition isomorphism: Modules.Isomorphism[V := first.Carrier, W := KernelCarrier, source := first.space, target := kernelSpace].Isomorphism :=
  Inverse.isomorphism injective onto;
\definition onRestriction: \forall (x: first.Carrier) -> (KernelSpace.inclusion).apply (((isomorphism).forward).apply x) = (data.restriction).apply x :=
  \fun (x: first.Carrier) => \refl((data.restriction).apply x);
\definition onKernel: \forall (q: KernelCarrier) -> (data.restriction).apply (((isomorphism).backward).apply q) = q :=
  (isomorphism).rightInverse;
