\import Cochains.At[C := Theory.complex, k := n] \as H;
\import Criterion.At[n := n] \as Term;
\import Modules.Isomorphism[V := Theory.Carrier n, W := H.Cohomology,
  source := Theory.space n, target := H.cohomologySpace] \as Into;
\import Into.Inverse[] \as Inverse;
\definition isomorphism[zero: DifferentialZero]:
  Modules.Isomorphism[V := H.Cohomology, W := Theory.Carrier n,
    source := H.cohomologySpace, target := Theory.space n].Isomorphism :=
  Inverse.inverse (Term.termIsomorphism (cochainDifferentialZero zero));
\import Cochains.ZeroDifferential[family := Theory.family].At[k := n] \as ZeroTerm;
\import Cochains.Map[C := Cochains.ZeroDifferential[family := Theory.family].complex,
  D := Theory.complex].At[k := n] \as Inclusion;
\definition onTerm[zero: DifferentialZero][phi: Theory.Carrier n]:
  ((Term.termIsomorphism (cochainDifferentialZero zero)).forward).apply phi =
    H.classOf (H.cycle phi (cochainDifferentialZero zero n phi)) :=
  Inclusion.onClass (Criterion.forward (cochainDifferentialZero zero)) ((ZeroTerm.cycles).apply phi);
\definition onClass[zero: DifferentialZero][phi: H.CycleCarrier]:
  ((isomorphism zero).forward).apply (H.classOf phi) = H.ambient phi :=
  trans!{{Theory.Carrier n}} _ _ _
    (congr!{H.Cohomology {Theory.Carrier n}} (((isomorphism zero).forward).apply)
      (H.classOf phi) (((Term.termIsomorphism (cochainDifferentialZero zero)).forward).apply (H.ambient phi))
      (sym!{H.Cohomology} _ _ (onTerm zero (H.ambient phi))))
    ((Term.termIsomorphism (cochainDifferentialZero zero)).leftInverse (H.ambient phi));
