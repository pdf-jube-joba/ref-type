\use std.Logic[].Equality[].eq_reason_in;
\import Cochains.At[C := Source.complex, k := n] \as SourceH;
\import Cochains.At[C := Theory.complex, k := n] \as TargetH;
\import Cochains.Map[C := Source.complex, D := Theory.complex].At[k := n] \as Maps;
\import SourceZero.At[n := n] \as SourceCoordinates;
\import \root.Integer[].HomZero[P := P, coefficients := coefficients].At[n := n] \as TargetCoordinates;
\definition law[sourceZero: SourceZero.DifferentialZero][targetZero: DifferentialZero]:
  \forall (h: SourceH.Cohomology) ->
    ((TargetCoordinates.isomorphism targetZero).forward).apply ((Maps.induced Pull.map).apply h) =
      (Pull.map).apply n (((SourceCoordinates.isomorphism sourceZero).forward).apply h) :=
  SourceH.classInduction
    (\fun (h: SourceH.Cohomology) =>
      ((TargetCoordinates.isomorphism targetZero).forward).apply ((Maps.induced Pull.map).apply h) =
        (Pull.map).apply n (((SourceCoordinates.isomorphism sourceZero).forward).apply h))
    (\fun (phi: SourceH.CycleCarrier) => eq_reason_in!{{Theory.Carrier n} _
      "=" _ "by" { congr!{TargetH.Cohomology {Theory.Carrier n}} (((TargetCoordinates.isomorphism targetZero).forward).apply)
        ((Maps.induced Pull.map).apply (SourceH.classOf phi))
        (TargetH.classOf ((Maps.cyclesMap Pull.map).apply phi)) (Maps.onClass Pull.map phi) }
      "=" _ "by" { TargetCoordinates.onClass targetZero ((Maps.cyclesMap Pull.map).apply phi) }
      "=" _ "by" { congr!{{Source.Carrier n} {Theory.Carrier n}} ((Pull.map).apply n)
          (SourceH.ambient phi) (((SourceCoordinates.isomorphism sourceZero).forward).apply (SourceH.classOf phi))
          (sym!{{Source.Carrier n}} _ _ (SourceCoordinates.onClass sourceZero phi)) }
    });
