\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import SignedChains.Map[C := P, D := Q] \as Maps;
\import Modules.ProjectiveLaws[] \as ProjectiveLaws;
\definition SourceProjective: \Prop := \forall (n: N.Nat^) ->
  Modules.Projective (Modules.Bundle { Carrier := P.family.Carrier (I.Int^::ofNat n), space := P.family.space (I.Int^::ofNat n) });
\definition TargetProjective: \Prop := \forall (n: N.Nat^) ->
  Modules.Projective (Modules.Bundle { Carrier := Q.family.Carrier (I.Int^::ofNat n), space := Q.family.space (I.Int^::ofNat n) });
\definition SourceNegative: \Prop := \forall (n: N.Nat^)(x: P.family.Carrier (I.Int^::negSucc n)) ->
  x = (P.family.space (I.Int^::negSucc n)).zero;
\definition TargetNegative: \Prop := \forall (n: N.Nat^)(x: Q.family.Carrier (I.Int^::negSucc n)) ->
  x = (Q.family.space (I.Int^::negSucc n)).zero;
\module On(f: Maps.Map);
