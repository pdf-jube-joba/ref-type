\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.eq_reason;
\import std.Logic[].Equality[].Transport[A := Degrees.Degree] \as Transport;
\import \parent.\parent.On[f := f] \as First;
\import \parent.\parent.On[f := g] \as Second;
\import Chains.Prior[C := Q] \as OriginalPrior;
\import Chains.Prior[C := Target.complex] \as TargetPrior;
\module At(z: Degrees.Degree) {
  \import Modules.Tensor[V := P.family.Carrier z, W := coefficients.Carrier,
    left := P.family.space z, right := coefficients.space] \as Domain;
  \import Target.At[z := Degrees.next z] \as Codomain;
  \import Modules.Hom[V := P.family.Carrier z, W := Q.family.Carrier (Degrees.next z),
    source := P.family.space z, target := Q.family.space (Degrees.next z)] \as Linear;
  \definition linear: Linear.Map := Linear.Map {
    apply := (h).apply z, addition := (h).addition z, scalar := (h).scalar z,
  };
  \import Domain.Mapping[U := Q.family.Carrier (Degrees.next z), Z := coefficients.Carrier,
    targetLeft := Q.family.space (Degrees.next z), targetRight := coefficients.space] \as Mapping;
  \definition map: Modules.Hom[V := Domain.Carrier, W := Codomain.Carrier,
    source := Domain.space, target := Codomain.space].Map := Mapping.map linear Identity.identity;
  \definition onTensor: \forall (x: P.family.Carrier z)(a: coefficients.Carrier) ->
    (map).apply (Domain.tensor x a) = Codomain.tensor ((h).apply z x) a := Mapping.onTensor linear Identity.identity;
}
\definition data: TargetHomotopy.Data := TargetHomotopy.Data { apply := \fun (z: Degrees.Degree) => (At[z := z].map).apply };
\module Equation(z: Degrees.Degree);
\definition laws: TargetHomotopy.Laws[First.map, Second.map, data] := TargetHomotopy.Laws[First.map, Second.map, data] {
  addition := \fun (z: Degrees.Degree) => (At[z := z].map).addition,
  scalar := \fun (z: Degrees.Degree) => (At[z := z].map).scalar,
  equation := \fun (z: Degrees.Degree) => Equation[z := z].law,
};
\definition homotopy: TargetHomotopy.Homotopy First.map Second.map := \into[TargetHomotopy.Data](data,
  TargetHomotopy.Homotopy First.map Second.map) \by { laws };
