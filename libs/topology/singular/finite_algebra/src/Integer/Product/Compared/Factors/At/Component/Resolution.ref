\import resolutions.Resolution[].Over[R := I.Int^, ring := Integers.ring].Of[M := finiteFirst, P := Presentation.complex] \as Source;
\import resolutions.Resolution[].Over[R := I.Int^, ring := Integers.ring].Of[M := actualFirst, P := Presentation.complex] \as Target;
\import Modules.Hom[V := finiteFirst.Carrier, W := actualFirst.Carrier, source := finiteFirst.space, target := actualFirst.space] \as Forward;
\import Modules.Hom[V := actualFirst.Carrier, W := finiteFirst.Carrier, source := actualFirst.space, target := finiteFirst.space] \as Backward;
\import Forward.Composition[U := Presentation.complex.family.Carrier N.Nat^::zero, domain := Presentation.complex.family.space N.Nat^::zero] \as Compose;
\definition original: Source.Resolution := Presentation.resolution;
\definition augmentation: Modules.Hom[V := Presentation.complex.family.Carrier N.Nat^::zero, W := actualFirst.Carrier,
  source := Presentation.complex.family.space N.Nat^::zero, target := actualFirst.space].Map := Compose.compose (firstIsomorphism).forward (original).augmentation;
\import std.Logic[].Proposition[] \as Logic;
\definition onto: Modules.Surjective (Target.term N.Nat^::zero) actualFirst augmentation := \block {
  \fun (h: actualFirst.Carrier) \then
  \takefrom x: \Cast[Presentation.complex.family.Carrier N.Nat^::zero] ({ x: Presentation.complex.family.Carrier N.Nat^::zero \where ((original).augmentation).apply x = ((firstIsomorphism).backward).apply h })
    \by (original).onto (((firstIsomorphism).backward).apply h) \then
  \return Logic.existsIntro[Presentation.complex.family.Carrier N.Nat^::zero, { x: Presentation.complex.family.Carrier N.Nat^::zero \where (augmentation).apply x = h }] x
    (trans!{actualFirst.Carrier} _ _ _
      (congr!{finiteFirst.Carrier actualFirst.Carrier} (((firstIsomorphism).forward).apply) _ _
        (\bysub(Presentation.complex.family.Carrier N.Nat^::zero, { x: Presentation.complex.family.Carrier N.Nat^::zero \where ((original).augmentation).apply x = ((firstIsomorphism).backward).apply h }, x)))
      ((firstIsomorphism).rightInverse h))
};
\definition killed[x: Presentation.complex.family.Carrier (N.Nat^::succ N.Nat^::zero)]:
  (augmentation).apply ((Presentation.complex.differential).apply N.Nat^::zero x) = (actualFirst.space).zero :=
  trans!{actualFirst.Carrier} _ _ _
    (congr!{finiteFirst.Carrier actualFirst.Carrier} (((firstIsomorphism).forward).apply) _ _ ((original).killed x))
    (Forward.zeroPreserved (firstIsomorphism).forward);
\definition augmentationExact: \forall (x: Presentation.complex.family.Carrier N.Nat^::zero) -> (augmentation).apply x = (actualFirst.space).zero ->
  \exists ( y: Presentation.complex.family.Carrier (N.Nat^::succ N.Nat^::zero) \where (Presentation.complex.differential).apply N.Nat^::zero y = x ) :=
  \fun (x: Presentation.complex.family.Carrier N.Nat^::zero)(closed: _) => (original).augmentationExact x
    (trans!{finiteFirst.Carrier} _ _ _ (sym!{finiteFirst.Carrier} _ _ ((firstIsomorphism).leftInverse (((original).augmentation).apply x)))
      (trans!{finiteFirst.Carrier} _ _ _ (congr!{actualFirst.Carrier finiteFirst.Carrier} (((firstIsomorphism).backward).apply) _ _ closed)
        (Backward.zeroPreserved (firstIsomorphism).backward)));
\definition data: Target.Data := Target.Data { augmentation := augmentation };
\definition resolution: Target.Resolution := \into[Target.Data](data, Target.Resolution) \by {
  Target.Laws[data] { projective := (original).projective, onto := onto, killed := killed,
    augmentationExact := augmentationExact, exact := (original).exact }
};
