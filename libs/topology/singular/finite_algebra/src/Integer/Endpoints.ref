\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Proposition[] \as Logic;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import Modules.ShortExact[A := U, B := B, C := V] \as Target;
\import Modules.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space].Composition[U := U.Carrier, domain := U.space] \as Inclusion;
\import Modules.Hom[V := C.Carrier, W := V.Carrier, source := C.space, target := V.space].Composition[U := B.Carrier, domain := B.space] \as Projection;
\import Modules.Hom[V := V.Carrier, W := C.Carrier, source := V.space, target := C.space] \as Backward;
\import Modules.Hom[V := C.Carrier, W := V.Carrier, source := C.space, target := V.space] \as Forward;
\definition data: Target.Data := Target.Data {
  inclusion := Inclusion.compose sequence.inclusion (left).backward,
  projection := Projection.compose (right).forward sequence.projection,
};
\definition injective: \forall (x, y: U.Carrier) -> (data.inclusion).apply x = (data.inclusion).apply y -> x = y :=
  \fun (x, y: U.Carrier)(equal: _) => eq_reason_in!{U.Carrier _
    "=" _ "by" { sym!{U.Carrier} _ _ ((left).rightInverse x) }
    "=" _ "by" { congr!{A.Carrier U.Carrier} (((left).forward).apply) _ _ ((sequence).injective (((left).backward).apply x) (((left).backward).apply y) equal) }
    "=" _ "by" { (left).rightInverse y }
  };
\definition onto: \forall (v: V.Carrier) -> \exists ( y: B.Carrier \where (data.projection).apply y = v ) := \block {
  \fun (v: V.Carrier) \then
  \takefrom y: \Cast[B.Carrier] ({ y: B.Carrier \where (sequence.projection).apply y = ((right).backward).apply v })
    \by (sequence).onto (((right).backward).apply v) \then
  \return Logic.existsIntro[B.Carrier, { y: B.Carrier \where (data.projection).apply y = v }] y
    (trans!{V.Carrier} _ _ _
      (congr!{C.Carrier V.Carrier} (((right).forward).apply) _ _ (\bysub(B.Carrier, { y: B.Carrier \where (sequence.projection).apply y = ((right).backward).apply v }, y)))
      ((right).rightInverse v))
};
\definition zero: \forall (x: U.Carrier) -> (data.projection).apply ((data.inclusion).apply x) = (V.space).zero :=
  \fun (x: U.Carrier) => trans!{V.Carrier} _ _ _
    (congr!{C.Carrier V.Carrier} (((right).forward).apply) _ _ ((sequence).zero (((left).backward).apply x)))
    (Forward.zeroPreserved (right).forward);
\definition kernelImage: \forall (y: B.Carrier) -> (data.projection).apply y = (V.space).zero ->
  \exists ( x: U.Carrier \where (data.inclusion).apply x = y ) := \block {
  \fun (y: B.Carrier)(closed: _) \then
  \let original: (sequence.projection).apply y = (C.space).zero := eq_reason_in!{C.Carrier _
    "=" _ "by" { sym!{C.Carrier} _ _ ((right).leftInverse ((sequence.projection).apply y)) }
    "=" _ "by" { congr!{V.Carrier C.Carrier} (((right).backward).apply) _ _ closed }
    "=" _ "by" { Backward.zeroPreserved (right).backward }
  } \then
  \takefrom x: \Cast[A.Carrier] ({ x: A.Carrier \where (sequence.inclusion).apply x = y }) \by (sequence).kernelImage y original \then
  \return Logic.existsIntro[U.Carrier, { x: U.Carrier \where (data.inclusion).apply x = y }] (((left).forward).apply x)
    (trans!{B.Carrier} _ _ _ (congr!{A.Carrier B.Carrier} ((sequence.inclusion).apply) _ _ ((left).leftInverse x))
      (\bysub(A.Carrier, { x: A.Carrier \where (sequence.inclusion).apply x = y }, x)))
};
\definition exact: Target.Sequence := \into[Target.Data](data, Target.Sequence) \by {
  Target.Laws[data] { injective := injective, onto := onto, zero := zero, kernelImage := kernelImage }
};
