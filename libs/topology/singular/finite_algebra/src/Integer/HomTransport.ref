\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing] \as Algebra;
\import Algebra.HomSpace[V := V.Carrier, W := coefficients.Carrier,
  source := V.space, target := coefficients.space] \as Source;
\import Algebra.HomSpace[V := W.Carrier, W := coefficients.Carrier,
  source := W.space, target := coefficients.space] \as Target;
\import Modules.Hom[V := V.Carrier, W := coefficients.Carrier,
  source := V.space, target := coefficients.space] \as SourceMaps;
\import Modules.Hom[V := W.Carrier, W := coefficients.Carrier,
  source := W.space, target := coefficients.space] \as TargetMaps;
\import Modules.Isomorphism[V := V.Carrier, W := W.Carrier, source := V.space, target := W.space] \as Isomorphisms;
\module With(e: Isomorphisms.Isomorphism);
