\import \parent.Degree[n := n] \as Lower;
\import \parent.Degree[n := N.Nat^::succ n] \as Higher;
\import Coordinates.Degree[n := n] \as Positions;
\definition Property[k: N.Nat^][i: Double.Index k]: \Prop := \forall (x: Source.Carrier (N.Nat^::succ k)) ->
  Coordinates.Degree[n := k].coordinate i ((\parent.Degree[n := k].map).apply ((Source.differential).apply k x)) =
  Coordinates.Degree[n := k].coordinate i ((Chains.differential).apply k ((\parent.Degree[n := N.Nat^::succ k].map).apply x));
\module At(p, q: N.Nat^);
\module Transported(p, q: N.Nat^);
\module Indexed(i: Double.Index n);
\definition law: \forall (x: Source.Carrier (N.Nat^::succ n)) ->
  (\parent.Degree[n := n].map).apply ((Source.differential).apply n x) = (Chains.differential).apply n ((\parent.Degree[n := N.Nat^::succ n].map).apply x) :=
  \fun (x: Source.Carrier (N.Nat^::succ n)) => Positions.ext _ _ (\fun (i: Double.Index n) => Indexed[i := i].law x);
