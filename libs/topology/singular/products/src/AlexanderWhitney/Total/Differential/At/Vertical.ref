\use std.Logic[].Equality[].eq_reason_in;
\import Coordinates.Degree[n := N.Nat^::succ k] \as Positions;
\import Modules.Hom[V := RightTensor.Carrier, W := Current.Carrier, source := RightTensor.space, target := Current.space] \as Linear;
\import Modules.Hom[V := Source.Carrier (N.Nat^::succ k), W := Current.Carrier, source := Source.space (N.Nat^::succ k), target := Current.space] \as Result;
\import \root.AlexanderWhitney[A := A, B := B, left := left, right := right].At[p := p, q := N.Nat^::succ q] \as Cut;
\definition law[x: Source.Carrier (N.Nat^::succ k)]:
  (TensorBoundary.vertical).apply (Positions.coordinate CoordinateBoundary.verticalIndex ((Higher.map).apply x)) = (Boundary.RightBoundary[].map).apply x :=
  eq_reason_in!{Current.Carrier _
    "=" _ "by" { congr!{RightTensor.Carrier Current.Carrier} ((TensorBoundary.vertical).apply) _ _ (Higher.coordinate CoordinateBoundary.verticalIndex x) }
    "=" _ "by" { congr!{RightTensor.Carrier Current.Carrier} (\fun (v: RightTensor.Carrier) => (TensorBoundary.vertical).apply v) _ _
        (congr!{{Source.Carrier (N.Nat^::succ k)} RightTensor.Carrier} ((Cut.map).apply) _ _ (Transport.castRefl Source.Carrier (N.Nat^::succ k) x)) }
    "=" _ "by" { congr!{Linear.Map Current.Carrier} (\fun (h: Linear.Map) => (h).apply ((Cut.map).apply x)) _ _ rightDifferential }
    "=" _ "by" { sym!{Current.Carrier} _ _ (congr!{Result.Map Current.Carrier} (\fun (h: Result.Map) => (h).apply x) _ _ RightTerm.equation) }
  };
