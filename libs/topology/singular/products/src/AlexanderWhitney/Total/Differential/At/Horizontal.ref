\import Coordinates.Degree[n := N.Nat^::succ k] \as Positions;
\import Modules.Hom[V := LeftTensor.Carrier, W := Current.Carrier, source := LeftTensor.space, target := Current.space] \as Linear;
\import Modules.Hom[V := Source.Carrier (N.Nat^::succ k), W := Current.Carrier, source := Source.space (N.Nat^::succ k), target := Current.space] \as Result;
\definition law[x: Source.Carrier (N.Nat^::succ k)]:
  (TensorBoundary.horizontal).apply (Positions.coordinate CoordinateBoundary.horizontalIndex ((Higher.map).apply x)) = (Boundary.LeftBoundary[].map).apply x :=
  trans!{Current.Carrier} _ _ _
    (congr!{LeftTensor.Carrier Current.Carrier} ((TensorBoundary.horizontal).apply) _ _ (Higher.coordinate CoordinateBoundary.horizontalIndex x))
    (trans!{Current.Carrier} _ _ _
      (congr!{Linear.Map Current.Carrier} (\fun (h: Linear.Map) => (h).apply ((Higher.At[i := CoordinateBoundary.horizontalIndex].map).apply x)) _ _ leftDifferential)
      (sym!{Current.Carrier} _ _ (congr!{Result.Map Current.Carrier} (\fun (h: Result.Map) => (h).apply x) _ _ LeftTerm.equation)));
