\definition k: N.Nat^ := Nat.add p q;
\definition index: Double.Index k := Coordinates.diagonal k p q (\refl(k));
\import Coordinates.Step[p := p, q := q] \as CoordinateBoundary;
\import \root.AlexanderWhitney[A := A, B := B, left := left, right := right].At[p := p, q := q] \as Current;
\import \root.AlexanderWhitney[A := A, B := B, left := left, right := right].Boundary[p := p, q := q] \as Boundary;
\import Boundary.LeftBoundary[].Factorization[] \as LeftTerm;
\import Boundary.RightBoundary[].Factorization[] \as RightTerm;
\import \parent.\parent.Degree[n := k] \as Lower;
\import \parent.\parent.Degree[n := N.Nat^::succ k] \as Higher;
\import Coordinates.Degree[n := k] \as Positions;
\import Double.SignComparison[V := Current.Carrier, space := Current.space] \as Signs;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\import Tensor.At[p := p, q := q] \as TensorBoundary;
\import Modules.Tensor[V := Left.Carrier (N.Nat^::succ p), W := Right.Carrier q, left := Left.space (N.Nat^::succ p), right := Right.space q] \as LeftTensor;
\import Modules.Tensor[V := Left.Carrier p, W := Right.Carrier (N.Nat^::succ q), left := Left.space p, right := Right.space (N.Nat^::succ q)] \as RightTensor;
\import LeftTensor.Universal[U := Current.Carrier, target := Current.space] \as LeftExt;
\import RightTensor.Universal[U := Current.Carrier, target := Current.space] \as RightExt;
\definition leftDifferential: TensorBoundary.horizontal = LeftTerm.differential := LeftExt.ext _ _
  (\fun (x: Left.Carrier (N.Nat^::succ p))(y: Right.Carrier q) => trans!{Current.Carrier} _ _ _ (TensorBoundary.horizontalOnTensor x y)
    (sym!{Current.Carrier} _ _ (LeftTerm.onTensor x y)));
\definition rightDifferential: TensorBoundary.vertical = RightTerm.differential := RightExt.ext _ _
  (\fun (x: Left.Carrier p)(y: Right.Carrier (N.Nat^::succ q)) => trans!{Current.Carrier} _ _ _ (TensorBoundary.verticalOnTensor x y)
    (sym!{Current.Carrier} _ _ (RightTerm.onTensor x y)));
\module Horizontal;
\module Vertical;
\module Proof;
\definition law: Property k index := Proof[].law;
