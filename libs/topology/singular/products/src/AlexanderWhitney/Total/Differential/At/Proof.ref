\import \parent.Horizontal[] \as Horizontal;
\import \parent.Vertical[] \as Vertical;
\import Modules.Hom[V := Source.Carrier (N.Nat^::succ k), W := Current.Carrier, source := Source.space (N.Nat^::succ k), target := Current.space] \as Linear;
\import Modules.Alternating[V := Current.Carrier, space := Current.space].Concatenation[] \as Parity;
\definition lower[x: Source.Carrier (N.Nat^::succ k)]:
  Positions.coordinate index ((Lower.map).apply ((Source.differential).apply k x)) = (Boundary.lhs).apply (x) :=
  trans!{Current.Carrier} _ _ _ (Lower.coordinate index ((Source.differential).apply k x))
    (congr!{{Source.Carrier k} Current.Carrier} ((Current.map).apply) _ _ (Transport.castRefl Source.Carrier k ((Source.differential).apply k x)));
\definition upper[x: Source.Carrier (N.Nat^::succ k)]:
  Positions.coordinate index ((Chains.differential).apply k ((Higher.map).apply x)) = (Boundary.rhs).apply x :=
  trans!{Current.Carrier} _ _ _ (CoordinateBoundary.differential ((Higher.map).apply x))
    (congr2!{Current.Carrier Current.Carrier Current.Carrier} ((Current.space).add) _ _ _ _
      (Horizontal.law x)
      (trans!{Current.Carrier} _ _ _ (Signs.law p _) (congr!{Current.Carrier Current.Carrier} (Parity.twist p) _ _ (Vertical.law x))));
\definition law: Property k index := \fun (x: Source.Carrier (N.Nat^::succ k)) => trans!{Current.Carrier} _ _ _ (lower x)
  (trans!{Current.Carrier} _ _ _ (congr!{Linear.Map Current.Carrier} (\fun (h: Linear.Map) => (h).apply x) _ _ Boundary.equation) (sym!{Current.Carrier} _ _ (upper x)));
