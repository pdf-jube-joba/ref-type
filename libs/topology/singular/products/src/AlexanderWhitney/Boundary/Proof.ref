\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Values[] \as Values;
\import \parent.Partition[] \as Partition;
\import Signs.Overlap[p := p, q := q] \as Overlap;
\import Modules.Alternating[V := Source.Carrier total, space := Source.space total].Mapping[W := Current.Carrier, target := Current.space] \as Mapping;
\definition differential[sigma: Simplices.Carrier higher]: (lhs).apply (Source.generator higher sigma) = Sum.sum (N.Nat^::succ higher) (Values.natural sigma) :=
  eq_reason_in!{Current.Carrier _
    "=" _ "by" { congr!{{Source.Carrier total} Current.Carrier} ((Current.map).apply) _ _ (Source.Boundary[n := total].onGenerator sigma) }
    "=" _ "by" { Mapping.law Current.map (N.Nat^::succ higher) (\fun (i: Fin.Fin (N.Nat^::succ higher)) => Source.generator total (Simplices.face total i sigma)) }
    "=" _ "by" { Sum.congruent (N.Nat^::succ higher)
        (\fun (i: Fin.Fin (N.Nat^::succ higher)) => (Current.map).apply (Source.generator total (Simplices.face total i sigma)))
        (Values.natural sigma) (\fun (i: Fin.Fin (N.Nat^::succ higher)) => Current.onGenerator (Simplices.face total i sigma)) }
  };
\use Equality.eq_reason;
\definition onGenerator[sigma: Simplices.Carrier higher]: (lhs).apply (Source.generator higher sigma) = (rhs).apply (Source.generator higher sigma) := eq_reason!{
  {(lhs).apply (Source.generator higher sigma)} "=" {Sum.sum (N.Nat^::succ higher) (Values.natural sigma)} "by" {differential sigma}
  "=" {(Current.space).add (Overlap.front (Values.left sigma)) (Signs.twist (N.Nat^::succ p) (Overlap.back (Values.right sigma)))} "by" {Partition.law sigma}
  "=" {(Current.space).add (Sum.sum (N.Nat^::succ (N.Nat^::succ p)) (Values.left sigma)) (Signs.twist p (Sum.sum (N.Nat^::succ (N.Nat^::succ q)) (Values.right sigma)))} "by" {
    sym!{Current.Carrier} _ _ (Overlap.law (Values.left sigma) (Values.right sigma) (Values.overlap sigma))}
  "=" {(rhs).apply (Source.generator higher sigma)} "by" {
    congr!{Current.Carrier Current.Carrier Current.Carrier} ((Current.space).add) _ _ _ _
      (sym!{Current.Carrier} _ _ (LeftTerm.law sigma))
      (congr!{Current.Carrier Current.Carrier} (Signs.twist p) _ _ (sym!{Current.Carrier} _ _ (RightTerm.law sigma)))}
};
\definition equation: lhs = rhs := Free.ext lhs rhs onGenerator;
