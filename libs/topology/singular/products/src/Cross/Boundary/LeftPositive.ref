\definition p: N.Nat^ := N.Nat^::succ r;
\module At(q: N.Nat^);
\module RightStep(s: N.Nat^);
\definition rightTerm: \forall (q: N.Nat^) -> At[q := q].Map :=
  \induction (q: N.Nat^) \return At[q := q].Map \with {
    | zero: At[q := N.Nat^::zero].zero
    | succ: \fun (s: N.Nat^)(previous: At[q := s].Map) => RightStep[s := s].map
  };
\module On(q: N.Nat^);
\definition Statement[q: N.Nat^]: \Prop := On[q := q].Equation;
\module Zero;
\module Step(s: N.Nat^);
\definition equation: \forall (q: N.Nat^) -> Statement q :=
  \induction (q: N.Nat^) \return Statement q \with {
    | zero: Zero[].equation
    | succ: \fun (s: N.Nat^)(previous: Statement s) => Step[s := s].equation
  };
