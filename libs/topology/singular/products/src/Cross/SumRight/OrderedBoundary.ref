\use std.Logic[].Equality[].eq_reason_in;
\import Modules.Alternating[V := RawRight.Carrier q, space := RawRight.space q].Mapping[W := Target.Carrier lower, target := Target.space lower] \as Mapping;
\definition faces[i: Fin.Fin (N.Nat^::succ q)]: RawRight.Carrier q := RawRight.generator q (Face.vertices i);
\definition law: (rawMap).apply ((RawRight.boundary q).apply (RawRight.generator (N.Nat^::succ q) (Vertices.vertex q))) = common :=
  eq_reason_in!{{Target.Carrier lower} _
    "=" _ "by" { congr!{{RawRight.Carrier q} {Target.Carrier lower}} ((rawMap).apply) _ _ (RawRight.Boundary[n := q].onGenerator (Vertices.vertex q)) }
    "=" _ "by" { Mapping.law rawMap (N.Nat^::succ q) faces }
    "=" _ "by" { Sum.congruent (N.Nat^::succ q) (\fun (i: Fin.Fin (N.Nat^::succ q)) => (rawMap).apply (faces i))
        (\fun (i: Fin.Fin (N.Nat^::succ q)) => LowerInto.onSimplices sigma (RightSimplices.face s i tau)) onFace }
  };
