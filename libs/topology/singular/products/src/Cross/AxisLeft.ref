\use std.Logic[].Equality[].eq_reason_in;
\definition p: N.Nat^ := N.Nat^::succ r;
\definition lower: N.Nat^ := degree r N.Nat^::zero;
\import \root.ProductChains[p := p, q := N.Nat^::zero] \as Higher;
\import Higher.Into[A := A, B := B, source := left, target := right] \as Into;
\import \parent.At[p := r, q := N.Nat^::zero] \as Lower;
\import \root.OrderedShuffle[V := Simplex.Carrier p, W := Simplex.Carrier N.Nat^::zero] \as Raw;
\import Raw.At[p := p, q := N.Nat^::zero] \as Full;
\import Raw.At[p := r, q := N.Nat^::zero] \as LowerRaw;
\import singular_cohomology.OrderedTuples[V := Simplex.Carrier p] \as RawLeft;
\import singular_cohomology.OrderedTuples[V := Simplex.Carrier N.Nat^::zero] \as RawRight;
\import singular_cohomology.OrderedTuples[V := Higher.Points] \as Tuples;
\import Simplex.Vertices[] \as Vertices;
\definition leftGenerator: RawLeft.Carrier (N.Nat^::succ p) := RawLeft.generator (N.Nat^::succ p) (Vertices.vertex p);
\definition rightGenerator: RawRight.Carrier (N.Nat^::succ N.Nat^::zero) := RawRight.generator (N.Nat^::succ N.Nat^::zero) (Vertices.vertex N.Nat^::zero);
\definition rawBoundary: (Tuples.boundary (N.Nat^::succ lower)).apply Higher.fundamental = LowerRaw.apply ((RawLeft.boundary p).apply leftGenerator) rightGenerator :=
  trans!{{Tuples.Carrier (N.Nat^::succ lower)}} _ _ _
    (sym!{{Tuples.Carrier (N.Nat^::succ lower)}} _ _
      (congr!{{Tuples.Carrier (N.Nat^::succ (N.Nat^::succ lower))} {Tuples.Carrier (N.Nat^::succ lower)}} ((Tuples.boundary (N.Nat^::succ lower)).apply) _ _
        (Full.onGenerators (Vertices.vertex p) (Vertices.vertex N.Nat^::zero))))
    (Raw.RightDegreeZero[p := r].law leftGenerator rightGenerator);
\definition law: (Target.boundary lower).apply (Into.onSimplices sigma tau) = Lower.apply ((Left.boundary r).apply (Left.generator p sigma)) (Right.generator N.Nat^::zero tau) :=
  eq_reason_in!{{Target.Carrier lower} _
    "=" _ "by" { (Into.evaluation sigma tau).commutes lower Higher.fundamental }
    "=" _ "by" { congr!{{Tuples.Carrier (N.Nat^::succ lower)} {Target.Carrier lower}} ((Into.evaluation sigma tau).apply lower) _ _ rawBoundary }
    "=" _ "by" { \parent.SumLeft[r := r, q := N.Nat^::zero, sigma := sigma, tau := tau].law }
  };
