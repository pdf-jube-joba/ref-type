\definition p: N.Nat^ := (i).first;
\definition q: N.Nat^ := (i).second;
\import Modules.Tensor[V := Left.Carrier p, W := Right.Carrier q, left := Left.space p, right := Right.space q] \as Term;
\import Term.Universal[U := Target.Carrier n, target := Target.space n] \as Extensionality;
\import Modules.Hom[V := Term.Carrier, W := Target.Carrier n, source := Term.space, target := Target.space n] \as Maps;
\import Linear.Composition[U := Term.Carrier, domain := Term.space] \as Before;
\definition first: Maps.Map := Before.compose lhs HigherSum.Component[i := i].injection;
\definition second: Maps.Map := Before.compose rhs HigherSum.Component[i := i].injection;
\definition OnTensors: \Prop := \forall (x: Left.Carrier p)(y: Right.Carrier q) -> (first).apply (Term.tensor x y) = (second).apply (Term.tensor x y);
\definition extend: OnTensors -> Statement n i := \block {
  \fun (same: OnTensors) \then
  \let equation: first = second := Extensionality.ext first second same \then
  \return \fun (z: Term.Carrier) => congr!{Maps.Map {Target.Carrier n}} (\fun (h: Maps.Map) => (h).apply z) _ _ equation
};
\definition leftPart[x: Left.Carrier p][y: Right.Carrier q]: Target.Carrier n :=
  (Lower.map).apply ((Step.horizontal p Step.Component[i := i].q).apply (Term.tensor x y));
\definition rightPart[x: Left.Carrier p][y: Right.Carrier q]: Target.Carrier n :=
  (Lower.map).apply ((Step.vertical q Step.Component[i := i].p).apply (Term.tensor x y));
\definition leftExpansion[x: Left.Carrier p][y: Right.Carrier q]: (first).apply (Term.tensor x y) = (Target.space n).add (leftPart x y) (rightPart x y) :=
  trans!{{Target.Carrier n}} _ _ _
    (congr!{LowerSum.Carrier {Target.Carrier n}} ((Lower.map).apply) _ _ (Step.onComponent i (Term.tensor x y)))
    ((Lower.map).addition _ _);
\definition rightExpansion[x: Left.Carrier p][y: Right.Carrier q]: (second).apply (Term.tensor x y) =
  (Target.boundary n).apply (Degrees.apply (degree p q) (N.Nat^::succ n) Higher.At[i := i].same (\root.Cross[A := A, B := B, left := left, right := right].At[p := p, q := q].apply x y)) :=
  trans!{{Target.Carrier n}} _ _ _
    (congr!{{Target.Carrier (N.Nat^::succ n)} {Target.Carrier n}} ((Target.boundary n).apply) _ _ (Higher.onInjection i (Term.tensor x y)))
    (congr!{{Target.Carrier (N.Nat^::succ n)} {Target.Carrier n}} ((Target.boundary n).apply) _ _ (Higher.At[i := i].onTensor x y));
