\use std.Logic[].Equality[].eq_reason_in;
\definition p: N.Nat^ := N.Nat^::succ r;
\definition targetIndex: Double.Index n := Double.index n r (Step.lowerSecond r q);
\import Tensor.Term[p := p, q := q] \as SourceTerm;
\import Tensor.At[p := r, q := q] \as Differential;
\import \root.Cross[A := A, B := B, left := left, right := right].At[p := r, q := q] \as Cross;
\import Lower.At[i := targetIndex] \as Component;
\definition law[x: Left.Carrier p][y: Right.Carrier q]:
  (Lower.map).apply ((Step.horizontal p q).apply (SourceTerm.tensor x y)) =
    Degrees.apply (degree r q) n Component.same (Cross.apply ((Left.boundary r).apply x) y) :=
  eq_reason_in!{{Target.Carrier n} _
    "=" _ "by" { Lower.onInjection targetIndex ((Differential.horizontal).apply (SourceTerm.tensor x y)) }
    "=" _ "by" { congr!{{Tensor.Carrier r q} {Target.Carrier n}} ((Component.map).apply) _ _ (Differential.horizontalOnTensor x y) }
    "=" _ "by" { Component.onTensor ((Left.boundary r).apply x) y }
  };
