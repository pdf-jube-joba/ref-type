\import \parent.\parent.Positive[r := r, s := s] \as Initial;
\definition p: N.Nat^ := Initial.p;
\definition q: N.Nat^ := Initial.q;
\definition law: Case p q := \fun (k: N.Nat^)(closed: Nat.add p q = N.Nat^::succ k) =>
  (\idelim Initial.k = k \with d: N.Nat^ => \forall (equal: Nat.add p q = N.Nat^::succ d) -> Statement d (pairIndex d p q equal) \by {
    base: \fun (equal: Nat.add p q = N.Nat^::succ Initial.k) => Initial.law,
    equality: NatLaws.succInjective Initial.k k (trans!{N.Nat^} _ _ _ (sym!{N.Nat^} _ _ Initial.closed) closed)
  }) closed;
