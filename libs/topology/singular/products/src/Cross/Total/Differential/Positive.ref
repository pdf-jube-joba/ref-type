\use std.Logic[].Equality[].eq_reason_in;
\definition p: N.Nat^ := N.Nat^::succ r;
\definition q: N.Nat^ := N.Nat^::succ s;
\definition k: N.Nat^ := degree r q;
\definition other: N.Nat^ := degree p s;
\definition same: other = k := sym!{N.Nat^} _ _ (NatLaws.addSuccLeft s r);
\definition closed: Nat.add p q = N.Nat^::succ k := NatLaws.addComm p q;
\definition index: Double.Index (N.Nat^::succ k) := \into[Double.Pair](Double.Pair { first := p, second := q }, { i: Double.Pair \where Nat.add (i).first (i).second = N.Nat^::succ k }) \by { closed };
\definition secondDegree: Double.Second (N.Nat^::succ k) p := \into[N.Nat^](q, Double.Second (N.Nat^::succ k) p) \by { closed };
\definition firstDegree: Double.First (N.Nat^::succ k) q := \into[N.Nat^](p, Double.First (N.Nat^::succ k) q) \by { closed };
\import \root.Cross[A := A, B := B, left := left, right := right].Total[].Differential[n := k].At[i := index] \as Data;
\import \root.Cross[A := A, B := B, left := left, right := right].Total[].Differential[n := k].Horizontal[r := r, q := secondDegree] \as Horizontal;
\import \root.Cross[A := A, B := B, left := left, right := right].Total[].Differential[n := k].Vertical[s := s, p := firstDegree] \as Vertical;
\import \root.Cross[A := A, B := B, left := left, right := right].At[p := p, q := q] \as Full;
\import \root.Cross[A := A, B := B, left := left, right := right].At[p := r, q := q] \as LowerLeft;
\import \root.Cross[A := A, B := B, left := left, right := right].At[p := p, q := s] \as LowerRight;
\import \root.Cross[A := A, B := B, left := left, right := right].Boundary[].LeftPositive[r := r] \as Boundary;
\import Commutative.Bilinear[A := Full.leftBundle, B := Full.rightBundle, C := LowerLeft.targetBundle] \as Forms;
\import Modules.Alternating[V := Target.Carrier k, space := Target.space k].Concatenation[] \as Parity;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition common[x: Left.Carrier p][y: Right.Carrier q]: Target.Carrier k :=
  (Target.space k).add (LowerLeft.apply ((Left.boundary r).apply x) y)
    (Parity.twist p (Degrees.apply other k same (LowerRight.apply x ((Right.boundary s).apply y))));
\definition boundary[x: Left.Carrier p][y: Right.Carrier q]: (Target.boundary k).apply (Full.apply x y) = common x y :=
  trans!{{Target.Carrier k}} _ _ _
    (congr!{Forms.Map {Target.Carrier k}} (\fun (h: Forms.Map) => (h).apply x y) _ _ (Boundary.equation q))
    (Boundary.On[q := q].expansion x y);
\definition first[x: Left.Carrier p][y: Right.Carrier q]: (Data.first).apply (Tensor.Term[p := p, q := q].tensor x y) = common x y :=
  trans!{{Target.Carrier k}} _ _ _ (Data.leftExpansion x y)
    (congr!{{Target.Carrier k} {Target.Carrier k} {Target.Carrier k}} ((Target.space k).add) _ _ _ _
      (trans!{{Target.Carrier k}} _ _ _ (Horizontal.law x y) (Transport.castRefl Target.Carrier k (LowerLeft.apply ((Left.boundary r).apply x) y)))
      (Vertical.law x y));
\definition second[x: Left.Carrier p][y: Right.Carrier q]: (Data.second).apply (Tensor.Term[p := p, q := q].tensor x y) = common x y :=
  eq_reason_in!{{Target.Carrier k} _
    "=" _ "by" { Data.rightExpansion x y }
    "=" _ "by" { congr!{{Target.Carrier (N.Nat^::succ k)} {Target.Carrier k}} ((Target.boundary k).apply) _ _ (Transport.castRefl Target.Carrier (N.Nat^::succ k) (Full.apply x y)) }
    "=" _ "by" { boundary x y }
  };
\definition onTensors: Data.OnTensors := \fun (x: Left.Carrier p)(y: Right.Carrier q) => trans!{{Target.Carrier k}} _ _ _ (first x y) (sym!{{Target.Carrier k}} _ _ (second x y));
\definition law: Statement k index := Data.extend onTensors;
