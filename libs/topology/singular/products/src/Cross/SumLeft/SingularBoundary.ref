\use std.Logic[].Equality[].eq_reason_in;
\import Modules.Alternating[V := Left.Carrier r, space := Left.space r].Mapping[W := Target.Carrier lower, target := Target.space lower] \as Mapping;
\definition faces[i: Fin.Fin (N.Nat^::succ p)]: Left.Carrier r := Left.generator r (LeftSimplices.face r i sigma);
\definition law: (nativeMap).apply ((Left.boundary r).apply (Left.generator p sigma)) = common :=
  eq_reason_in!{{Target.Carrier lower} _
    "=" _ "by" { congr!{{Left.Carrier r} {Target.Carrier lower}} ((nativeMap).apply) _ _ (Left.Boundary[n := r].onGenerator sigma) }
    "=" _ "by" { Mapping.law nativeMap (N.Nat^::succ p) faces }
    "=" _ "by" { Sum.congruent (N.Nat^::succ p) (\fun (i: Fin.Fin (N.Nat^::succ p)) => (nativeMap).apply (faces i))
        (\fun (i: Fin.Fin (N.Nat^::succ p)) => LowerInto.onSimplices (LeftSimplices.face r i sigma) tau) onNativeFace }
  };
