\use std.Logic[].Equality[].eq_reason_in;
\import Modules.Alternating[V := RawLeft.Carrier p, space := RawLeft.space p].Mapping[W := Target.Carrier lower, target := Target.space lower] \as Mapping;
\definition faces[i: Fin.Fin (N.Nat^::succ p)]: RawLeft.Carrier p := RawLeft.generator p (Face.vertices i);
\definition law: (rawMap).apply ((RawLeft.boundary p).apply (RawLeft.generator (N.Nat^::succ p) (Vertices.vertex p))) = common :=
  eq_reason_in!{{Target.Carrier lower} _
    "=" _ "by" { congr!{{RawLeft.Carrier p} {Target.Carrier lower}} ((rawMap).apply) _ _ (RawLeft.Boundary[n := p].onGenerator (Vertices.vertex p)) }
    "=" _ "by" { Mapping.law rawMap (N.Nat^::succ p) faces }
    "=" _ "by" { Sum.congruent (N.Nat^::succ p) (\fun (i: Fin.Fin (N.Nat^::succ p)) => (rawMap).apply (faces i))
        (\fun (i: Fin.Fin (N.Nat^::succ p)) => LowerInto.onSimplices (LeftSimplices.face r i sigma) tau) onFace }
  };
