\import \parent.\parent.Unit[] \as Unit;
\import OtherCohomology.Unit[] \as OtherUnit;
\import Complexes.At[C := Theory.complex, k := N.Nat^::zero] \as Zero;
\definition law: \forall (f: A -> B)(continuous: Geometry.Continuous f) -> apply N.Nat^::zero f continuous OtherUnit.class = Unit.class :=
  \fun (f: A -> B)(continuous: Geometry.Continuous f) => trans!{{Group N.Nat^::zero}} _ _ _
    (\parent.At[n := N.Nat^::zero].onClass f continuous OtherUnit.cycle)
    (Zero.equalClass (\parent.At[n := N.Nat^::zero].cycle f continuous OtherUnit.cycle) Unit.cycle (CochainPull.Unit[].law f continuous));
