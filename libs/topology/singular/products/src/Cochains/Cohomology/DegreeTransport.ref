\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition Cycle[n: N.Nat^]: \Set := Complexes.At[C := Theory.complex, k := n].CycleCarrier;
\definition classOf[n: N.Nat^]: Cycle n -> Group n := Complexes.At[C := Theory.complex, k := n].classOf;
\definition ambient[n: N.Nat^][x: Cycle n]: Carrier n := x;
\definition apply[m, n: N.Nat^][same: m = n]: Group m -> Group n := Transport.cast Group m n same;
\definition cycle[m, n: N.Nat^][same: m = n]: Cycle m -> Cycle n := Transport.cast Cycle m n same;
\definition onClass: \forall (m, n: N.Nat^)(same: m = n)(x: Cycle m) ->
  apply m n same (classOf m x) = classOf n (cycle m n same x) := Transport.natural Cycle Group classOf;
\definition onAmbient: \forall (m, n: N.Nat^)(same: m = n)(x: Cycle m) ->
  Transport.cast Carrier m n same x = ambient n (cycle m n same x) := Transport.natural Cycle Carrier ambient;
