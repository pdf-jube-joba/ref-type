\import \parent.\parent.Unit[] \as Cochain;
\import Complexes.At[C := Theory.complex, k := N.Nat^::zero] \as Zero;
\definition cycle: Zero.CycleCarrier := Zero.cycle Cochain.cochain Cochain.Closed[].law;
\definition class: Group N.Nat^::zero := Zero.classOf cycle;
\module Right(p: N.Nat^);
\module Left(p: N.Nat^);
