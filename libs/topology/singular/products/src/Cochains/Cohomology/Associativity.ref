\use std.Logic[].Equality[].eq_reason_in;
\import Simplices.CutAssociativity[p := p, q := q, r := r] \as Geometry;
\import \parent.Cup[p := p, q := q] \as PQ;
\import \parent.Cup[p := Geometry.pq, q := r] \as Left;
\import \parent.Cup[p := q, q := r] \as QR;
\import \parent.Cup[p := p, q := Geometry.qr] \as Right;
\import \parent.\parent.Associativity[p := p, q := q, r := r] \as Cochain;
\import \parent.DegreeTransport[] \as Degrees;
\import Complexes.At[C := Theory.complex, k := p] \as P;
\import Complexes.At[C := Theory.complex, k := q] \as Q;
\import Complexes.At[C := Theory.complex, k := r] \as T;
\import Complexes.At[C := Theory.complex, k := Geometry.leftDegree] \as Output;
\definition onCycles: \forall (x: P.CycleCarrier)(y: Q.CycleCarrier)(z: T.CycleCarrier) ->
  Left.apply (PQ.apply (P.classOf x) (Q.classOf y)) (T.classOf z) =
    Degrees.apply Geometry.rightDegree Geometry.leftDegree Geometry.same (Right.apply (P.classOf x) (QR.apply (Q.classOf y) (T.classOf z))) :=
  \fun (x: P.CycleCarrier)(y: Q.CycleCarrier)(z: T.CycleCarrier) => eq_reason_in!{{Group Geometry.leftDegree} _
    "=" _ "by" { congr!{{Group Geometry.pq} {Group Geometry.leftDegree}} (\fun (a: Group Geometry.pq) => Left.apply a (T.classOf z)) _ _ (PQ.onClasses x y) }
    "=" _ "by" { Left.onClasses (PQ.cycle x y) z }
    "=" _ "by" { Output.equalClass (Left.cycle (PQ.cycle x y) z) (Degrees.cycle Geometry.rightDegree Geometry.leftDegree Geometry.same (Right.cycle x (QR.cycle y z)))
          (trans!{{Carrier Geometry.leftDegree}} _ _ _ (Cochain.law x y z) (Degrees.onAmbient Geometry.rightDegree Geometry.leftDegree Geometry.same (Right.cycle x (QR.cycle y z)))) }
    "=" _ "by" { sym!{{Group Geometry.leftDegree}} _ _
          (trans!{{Group Geometry.leftDegree}} _ _ _
            (congr!{{Group Geometry.rightDegree} {Group Geometry.leftDegree}} (Degrees.apply Geometry.rightDegree Geometry.leftDegree Geometry.same) _ _
              (trans!{{Group Geometry.rightDegree}} _ _ _
                (congr!{{Group Geometry.qr} {Group Geometry.rightDegree}} (Right.apply (P.classOf x)) _ _ (QR.onClasses y z))
                (Right.onClasses x (QR.cycle y z))))
            (Degrees.onClass Geometry.rightDegree Geometry.leftDegree Geometry.same (Right.cycle x (QR.cycle y z)))) }
  };
\definition law: \forall (a: Group p)(b: Group q)(c: Group r) ->
  Left.apply (PQ.apply a b) c = Degrees.apply Geometry.rightDegree Geometry.leftDegree Geometry.same (Right.apply a (QR.apply b c)) :=
  P.classInduction (\fun (a: Group p) => \forall (b: Group q)(c: Group r) ->
    Left.apply (PQ.apply a b) c = Degrees.apply Geometry.rightDegree Geometry.leftDegree Geometry.same (Right.apply a (QR.apply b c)))
    (\fun (x: P.CycleCarrier) => Q.classInduction (\fun (b: Group q) => \forall (c: Group r) ->
      Left.apply (PQ.apply (P.classOf x) b) c = Degrees.apply Geometry.rightDegree Geometry.leftDegree Geometry.same (Right.apply (P.classOf x) (QR.apply b c)))
      (\fun (y: Q.CycleCarrier) => T.classInduction (\fun (c: Group r) =>
        Left.apply (PQ.apply (P.classOf x) (Q.classOf y)) c = Degrees.apply Geometry.rightDegree Geometry.leftDegree Geometry.same (Right.apply (P.classOf x) (QR.apply (Q.classOf y) c)))
        (onCycles x y)));
