\import Complexes.At[C := Theory.complex, k := p] \as Current;
\import \parent.\parent.Cup[p := N.Nat^::zero, q := p] \as Product;
\import Complexes.At[C := Theory.complex, k := Product.degree] \as Output;
\import Simplices.CutLeftUnit[p := p] \as Geometry;
\import \parent.\parent.DegreeTransport[] \as Degrees;
\definition law: \forall (a: Group p) -> Product.apply class a = Degrees.apply p Product.degree Geometry.same a :=
  Current.classInduction (\fun (a: Group p) => Product.apply class a = Degrees.apply p Product.degree Geometry.same a)
    (\fun (x: Current.CycleCarrier) => trans!{{Group Product.degree}} _ _ _ (Product.onClasses cycle x)
      (trans!{{Group Product.degree}} _ _ _
        (Output.equalClass (Product.cycle cycle x) (Degrees.cycle p Product.degree Geometry.same x)
          (trans!{{Carrier Product.degree}} _ _ _ (Cochain.Left[p := p].law x) (Degrees.onAmbient p Product.degree Geometry.same x)))
        (sym!{{Group Product.degree}} _ _ (Degrees.onClass p Product.degree Geometry.same x))));
