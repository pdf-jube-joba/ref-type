\definition cochain: Carrier N.Nat^::zero := Ordinary.At[n := N.Nat^::zero].extend (\fun (_: Simplices.Carrier N.Nat^::zero) => (baseRing).one);
\definition onSimplex: \forall (sigma: Simplices.Carrier N.Nat^::zero) -> (cochain).apply (Chains.generator N.Nat^::zero sigma) = (baseRing).one :=
  Ordinary.At[n := N.Nat^::zero].onGenerator (\fun (_: Simplices.Carrier N.Nat^::zero) => (baseRing).one);
\definition rightOne: \forall (a: R) -> (baseRing).mul a ((baseRing).one) = a :=
  \fun (a: R) => trans!{R} _ _ _ ((ring).mulCommutative a ((baseRing).one)) ((Modules.scalarModule).scalarOne a);
\module At(p: N.Nat^);
\module Closed;
\module Left(p: N.Nat^);
