\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Cup[p := p, q := N.Nat^::zero] \as Cup;
\import Cup.Bilinear[] \as Bilinear;
\import Simplices.CutRightUnit[p := p] \as Restriction;
\import Simplices.Cut[p := p, q := N.Nat^::zero] \as Cut;
\definition right: \forall (alpha: Carrier p) -> Cup.apply alpha cochain = alpha :=
  \fun (alpha: Carrier p) => Bilinear.ext _ _ (\fun (sigma: Simplices.Carrier p) => eq_reason_in!{R _
    "=" _ "by" { Cup.onSimplex alpha cochain sigma }
    "=" _ "by" { congr!{R R R} ((baseRing).mul) _ _ _ _
        (congr!{{Simplices.Carrier p} R} (\fun (tau: Simplices.Carrier p) => (alpha).apply (Chains.generator p tau)) _ _ (Restriction.law sigma))
        (onSimplex (Cut.back sigma)) }
    "=" _ "by" { rightOne ((alpha).apply (Chains.generator p sigma)) }
  });
