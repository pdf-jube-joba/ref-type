\use std.Logic[].Equality[].eq_reason_in;
\import singular_cohomology.Zero[A := A, source := source] \as Geometry;
\import Geometry.With[coefficients := Theory.integerCoefficients] \as Zero;
\import Zero.Edges[] \as Edges;
\import Modules.Laws[V := R, space := Modules.scalarModule] \as Scalars;
\import IntegerModules.Free[Generators := Simplices.Carrier (N.Nat^::succ N.Nat^::zero)].To[W := R, target := Theory.integerCoefficients.space] \as Free;
\definition law: Theory.coboundary N.Nat^::zero cochain = (space (N.Nat^::succ N.Nat^::zero)).zero :=
  Free.ext _ _ (\fun (sigma: Simplices.Carrier (N.Nat^::succ N.Nat^::zero)) => eq_reason_in!{R _
    "=" _ "by" { Edges.coboundary cochain sigma }
    "=" _ "by" { congr!{R R R} ((baseRing).add) _ _ _ _
        (Zero.valueExtended (\fun (_: A) => (baseRing).one) (Geometry.end sigma))
        (congr!{R R} ((baseRing).neg) _ _ (Zero.valueExtended (\fun (_: A) => (baseRing).one) (Geometry.start sigma))) }
    "=" _ "by" { Scalars.inverseRight (baseRing).one }
  });
