\use std.Logic[].Equality[].eq_reason_in;
\import N.Basic[].Prop[] \as Nat;
\import \parent.\parent.Cup[p := N.Nat^::zero, q := p] \as Cup;
\import Cup.Bilinear[] \as Extensionality;
\import Simplices.Cut[p := N.Nat^::zero, q := p] \as Cut;
\import Simplices.CutLeftUnit[p := p] \as Restriction;
\import \parent.\parent.DegreeTransport[] \as Degrees;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition leftOne: \forall (x: R) -> (baseRing).mul (baseRing).one x = x := (Modules.scalarModule).scalarOne;
\definition law: \forall (alpha: Carrier p) -> Cup.apply cochain alpha = Transport.cast Carrier p Cut.total Restriction.same alpha :=
  \fun (alpha: Carrier p) => Extensionality.ext _ _ (\fun (sigma: Simplices.Carrier Cut.total) =>
    eq_reason_in!{R _
      "=" _ "by" { Cup.onSimplex cochain alpha sigma }
      "=" _ "by" { congr!{R R} (\fun (r: R) => (baseRing).mul r ((alpha).apply (Chains.generator p (Cut.back sigma)))) _ _ (onSimplex (Cut.front sigma)) }
      "=" _ "by" { leftOne ((alpha).apply (Chains.generator p (Cut.back sigma))) }
      "=" _ "by" { congr!{{Simplices.Carrier p} R} (\fun (tau: Simplices.Carrier p) => (alpha).apply (Chains.generator p tau)) _ _ (Restriction.law sigma) }
      "=" _ "by" { sym!{R} _ _ (Degrees.law p Cut.total Restriction.same alpha sigma) }
    });
