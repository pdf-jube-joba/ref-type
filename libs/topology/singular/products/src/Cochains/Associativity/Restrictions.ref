\definition law: \forall (alpha: Carrier p)(beta: Carrier q)(gamma: Carrier r)(sigma: Simplices.Carrier Geometry.leftDegree) ->
  leftValue alpha beta gamma sigma = rightValue alpha beta gamma (Geometry.rightSimplex sigma) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(gamma: Carrier r)(sigma: Simplices.Carrier Geometry.leftDegree) => trans!{R} _ _ _
    (congr!{R R R} ((baseRing).mul) _ _ _ _
      (congr!{R R R} ((baseRing).mul) _ _ _ _
        (congr!{{Simplices.Carrier p} R} (\fun (tau: Simplices.Carrier p) => (alpha).apply (Chains.generator p tau)) _ _ (Geometry.First[].law sigma))
        (congr!{{Simplices.Carrier q} R} (\fun (tau: Simplices.Carrier q) => (beta).apply (Chains.generator q tau)) _ _ (Geometry.Middle[].law sigma)))
      (congr!{{Simplices.Carrier r} R} (\fun (tau: Simplices.Carrier r) => (gamma).apply (Chains.generator r tau)) _ _ (Geometry.Last[].law sigma)))
    ((Modules.scalarModule).scalarAssoc
      ((alpha).apply (Chains.generator p (RightCut.front (Geometry.rightSimplex sigma))))
      ((beta).apply (Chains.generator q (QRCut.front (RightCut.back (Geometry.rightSimplex sigma)))))
      ((gamma).apply (Chains.generator r (QRCut.back (RightCut.back (Geometry.rightSimplex sigma))))));
