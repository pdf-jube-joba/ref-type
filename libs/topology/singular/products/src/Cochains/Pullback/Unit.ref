\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Unit[] \as Source;
\import Other.Unit[] \as Target;
\import \parent.\parent.Cup[p := N.Nat^::zero, q := N.Nat^::zero].Bilinear[] \as Extensionality;
\definition law: \forall (f: A -> B)(continuous: Geometry.Continuous f) -> apply N.Nat^::zero f continuous Target.cochain = Source.cochain :=
  \fun (f: A -> B)(continuous: Geometry.Continuous f) => Extensionality.ext _ _
    (\fun (sigma: Simplices.Carrier N.Nat^::zero) => eq_reason_in!{R _
      "=" _ "by" { onSimplex N.Nat^::zero f continuous Target.cochain sigma }
      "=" _ "by" { Target.onSimplex (Geometry.postcompose N.Nat^::zero f continuous sigma) }
      "=" _ "by" { sym!{R} _ _ (Source.onSimplex sigma) }
    });
