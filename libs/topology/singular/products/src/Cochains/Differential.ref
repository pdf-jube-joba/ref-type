\import std.Data[].FinSet[] \as Fin;
\import IntegerModules.Alternating[V := Chains.Carrier n, space := Chains.space n].Mapping[W := R, target := integerCoefficients.space] \as Mapping;
\import Modules.Alternating[V := R, space := Modules.scalarModule] \as Sums;
\definition values[alpha: Carrier n][sigma: Simplices.Carrier (N.Nat^::succ n)][i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))]: R :=
  (alpha).apply (Chains.generator n (Simplices.face n i sigma));
\definition onSimplex: \forall (alpha: Carrier n)(sigma: Simplices.Carrier (N.Nat^::succ n)) ->
  (Theory.coboundary n alpha).apply (Chains.generator (N.Nat^::succ n) sigma) = Sums.sum (N.Nat^::succ (N.Nat^::succ n)) (values alpha sigma) :=
  \fun (alpha: Carrier n)(sigma: Simplices.Carrier (N.Nat^::succ n)) => trans!{R} _ _ _
    (congr!{{Chains.Carrier n} R} ((alpha).apply) _ _ (Chains.Boundary[n := n].onGenerator sigma))
    (Mapping.law alpha (N.Nat^::succ (N.Nat^::succ n))
      (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => Chains.generator n (Simplices.face n i sigma)));
