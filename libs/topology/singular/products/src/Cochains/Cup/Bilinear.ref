\use std.Logic[].Equality[].eq_reason_in;
\import IntegerModules.Free[Generators := Simplices.Carrier total].To[W := R, target := Theory.integerCoefficients.space] \as Free;
\definition ext: \forall (f, g: Carrier total) ->
  (\forall (sigma: Simplices.Carrier total) -> (f).apply (Chains.generator total sigma) = (g).apply (Chains.generator total sigma)) -> f = g := Free.ext;
\import Modules.Laws[V := R, space := Modules.scalarModule] \as Scalars;
\definition leftZero: \forall (beta: Carrier q) -> apply (space p).zero beta = (space total).zero :=
  \fun (beta: Carrier q) => ext _ _ (\fun (sigma: Simplices.Carrier total) => trans!{R} _ _ _ (onSimplex (space p).zero beta sigma)
    (Scalars.zeroScale ((beta).apply (Chains.generator q (Cut.back sigma)))));
\definition rightZero: \forall (alpha: Carrier p) -> apply alpha (space q).zero = (space total).zero :=
  \fun (alpha: Carrier p) => ext _ _ (\fun (sigma: Simplices.Carrier total) => trans!{R} _ _ _ (onSimplex alpha (space q).zero sigma)
    (Scalars.scaleZero ((alpha).apply (Chains.generator p (Cut.front sigma)))));
\definition leftAdd: \forall (alpha, alphaPrime: Carrier p)(beta: Carrier q) ->
  apply ((space p).add alpha alphaPrime) beta = (space total).add (apply alpha beta) (apply alphaPrime beta) :=
  \fun (alpha, alphaPrime: Carrier p)(beta: Carrier q) => ext _ _ (\fun (sigma: Simplices.Carrier total) =>
    eq_reason_in!{R _
      "=" _ "by" { onSimplex ((space p).add alpha alphaPrime) beta sigma }
      "=" _ "by" { (Modules.scalarModule).scalarAdd ((alpha).apply (Chains.generator p (Cut.front sigma))) ((alphaPrime).apply (Chains.generator p (Cut.front sigma))) ((beta).apply (Chains.generator q (Cut.back sigma))) }
      "=" _ "by" { sym!{R} _ _ (congr!{R R R} ((baseRing).add) _ _ _ _ (onSimplex alpha beta sigma) (onSimplex alphaPrime beta sigma)) }
    });
\definition rightAdd: \forall (alpha: Carrier p)(beta, betaPrime: Carrier q) ->
  apply alpha ((space q).add beta betaPrime) = (space total).add (apply alpha beta) (apply alpha betaPrime) :=
  \fun (alpha: Carrier p)(beta, betaPrime: Carrier q) => ext _ _ (\fun (sigma: Simplices.Carrier total) =>
    eq_reason_in!{R _
      "=" _ "by" { onSimplex alpha ((space q).add beta betaPrime) sigma }
      "=" _ "by" { (Modules.scalarModule).vectorAdd ((alpha).apply (Chains.generator p (Cut.front sigma))) ((beta).apply (Chains.generator q (Cut.back sigma))) ((betaPrime).apply (Chains.generator q (Cut.back sigma))) }
      "=" _ "by" { sym!{R} _ _ (congr!{R R R} ((baseRing).add) _ _ _ _ (onSimplex alpha beta sigma) (onSimplex alpha betaPrime sigma)) }
    });
\definition leftScale: \forall (a: R)(alpha: Carrier p)(beta: Carrier q) ->
  apply ((space p).smul a alpha) beta = (space total).smul a (apply alpha beta) :=
  \fun (a: R)(alpha: Carrier p)(beta: Carrier q) => ext _ _ (\fun (sigma: Simplices.Carrier total) =>
    eq_reason_in!{R _
      "=" _ "by" { onSimplex ((space p).smul a alpha) beta sigma }
      "=" _ "by" { (Modules.scalarModule).scalarAssoc a ((alpha).apply (Chains.generator p (Cut.front sigma))) ((beta).apply (Chains.generator q (Cut.back sigma))) }
      "=" _ "by" { sym!{R} _ _ (congr!{R R} ((baseRing).mul a) _ _ (onSimplex alpha beta sigma)) }
    });
\definition commuteScale: \forall (a, x, y: R) -> (baseRing).mul x ((baseRing).mul a y) = (baseRing).mul a ((baseRing).mul x y) :=
  \fun (a, x, y: R) => eq_reason_in!{R _
    "=" _ "by" { sym!{R} _ _ ((Modules.scalarModule).scalarAssoc x a y) }
    "=" _ "by" { congr!{R R} (\fun (r: R) => (baseRing).mul r y) _ _ ((ring).mulCommutative x a) }
    "=" _ "by" { (Modules.scalarModule).scalarAssoc a x y }
  };
\definition rightScale: \forall (a: R)(alpha: Carrier p)(beta: Carrier q) ->
  apply alpha ((space q).smul a beta) = (space total).smul a (apply alpha beta) :=
  \fun (a: R)(alpha: Carrier p)(beta: Carrier q) => ext _ _ (\fun (sigma: Simplices.Carrier total) =>
    eq_reason_in!{R _
      "=" _ "by" { onSimplex alpha ((space q).smul a beta) sigma }
      "=" _ "by" { commuteScale a ((alpha).apply (Chains.generator p (Cut.front sigma))) ((beta).apply (Chains.generator q (Cut.back sigma))) }
      "=" _ "by" { sym!{R} _ _ (congr!{R R} ((baseRing).mul a) _ _ (onSimplex alpha beta sigma)) }
    });
