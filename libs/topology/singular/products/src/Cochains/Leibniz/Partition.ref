\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Values[] \as Values;
\import Signs.Ordered[p := N.Nat^::succ p, q := N.Nat^::succ q] \as Cut;
\import Signs.Reindex[] \as Reindex;
\definition count: N.Nat^ := N.Nat^::succ higher;
\definition sameCount: Cut.total = count := congr!{N.Nat^ N.Nat^} (\fun (n: N.Nat^) => N.Nat^::succ n) Geometry.leftDegree higher Geometry.same;
\definition image[i: Fin.Fin Cut.total]: Fin.Fin count := Reindex.indices Cut.total count sameCount i;
\definition prefixImage: \forall (i: Fin.Fin (N.Nat^::succ p)) -> image (Cut.front i) = Geometry.prefix i :=
  \fun (i: Fin.Fin (N.Nat^::succ p)) => eq_reason_in!{N.Nat^ _
    "=" _ "by" { Reindex.value Cut.total count sameCount (Cut.front i) }
    "=" _ "by" { Cut.frontValue i }
    "=" _ "by" { sym!{N.Nat^} _ _ (Geometry.prefixValue i) }
  };
\definition suffixImage: \forall (j: Fin.Fin (N.Nat^::succ q)) -> image (Cut.back j) = Geometry.suffix j :=
  \fun (j: Fin.Fin (N.Nat^::succ q)) => eq_reason_in!{N.Nat^ _
    "=" _ "by" { Reindex.value Cut.total count sameCount (Cut.back j) }
    "=" _ "by" { Cut.backValue j }
    "=" _ "by" { Bounds.addSuccLeft p j }
  };
\definition function[alpha: Carrier p][beta: Carrier q][sigma: Simplices.Carrier higher][i: Fin.Fin Cut.total]: R := Values.natural alpha beta sigma (image i);
\definition law: \forall (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) ->
  Sums.sum count (Values.natural alpha beta sigma) =
    (baseRing).add (Sums.sum (N.Nat^::succ p) (\fun (i: Fin.Fin (N.Nat^::succ p)) => Values.left alpha beta sigma (Fin.widen (N.Nat^::succ p) i)))
      (Signs.twist (N.Nat^::succ p) (Sums.sum (N.Nat^::succ q) (\fun (j: Fin.Fin (N.Nat^::succ q)) => Values.right alpha beta sigma (Fin.succ (N.Nat^::succ q) j)))) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) => eq_reason_in!{R _
    "=" _ "by" { sym!{R} _ _ (Reindex.law Cut.total count sameCount (Values.natural alpha beta sigma)) }
    "=" _ "by" { Cut.law (function alpha beta sigma) }
    "=" _ "by" { congr!{R R R} ((baseRing).add) _ _ _ _
        (Sums.congruent (N.Nat^::succ p) (\fun (i: Fin.Fin (N.Nat^::succ p)) => function alpha beta sigma (Cut.front i))
          (\fun (i: Fin.Fin (N.Nat^::succ p)) => Values.left alpha beta sigma (Fin.widen (N.Nat^::succ p) i))
          (\fun (i: Fin.Fin (N.Nat^::succ p)) => trans!{R} _ _ _
            (congr!{{Fin.Fin count} R} (Values.natural alpha beta sigma) _ _ (prefixImage i)) (Values.prefix alpha beta sigma i)))
        (congr!{R R} (Signs.twist (N.Nat^::succ p)) _ _
          (Sums.congruent (N.Nat^::succ q) (\fun (j: Fin.Fin (N.Nat^::succ q)) => function alpha beta sigma (Cut.back j))
            (\fun (j: Fin.Fin (N.Nat^::succ q)) => Values.right alpha beta sigma (Fin.succ (N.Nat^::succ q) j))
            (\fun (j: Fin.Fin (N.Nat^::succ q)) => trans!{R} _ _ _
              (congr!{{Fin.Fin count} R} (Values.natural alpha beta sigma) _ _ (suffixImage j)) (Values.suffix alpha beta sigma j)))) }
  };
