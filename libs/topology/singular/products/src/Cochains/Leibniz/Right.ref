\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Values[] \as Values;
\definition law: \forall (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) ->
  (RightProduct.apply alpha (Theory.coboundary q beta)).apply (Chains.generator higher sigma) =
    Sums.sum (N.Nat^::succ (N.Nat^::succ q)) (Values.right alpha beta sigma) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) => eq_reason_in!{R _
    "=" _ "by" { RightProduct.onSimplex alpha (Theory.coboundary q beta) sigma }
    "=" _ "by" { congr!{R R} ((baseRing).mul ((alpha).apply (Chains.generator p (RightCut.front sigma)))) _ _ (RightDifferential.onSimplex beta (RightCut.back sigma)) }
    "=" _ "by" { Scalars.leftSum (N.Nat^::succ (N.Nat^::succ q)) ((alpha).apply (Chains.generator p (RightCut.front sigma)))
        (\fun (j: Fin.Fin (N.Nat^::succ (N.Nat^::succ q))) => (beta).apply (Chains.generator q (Simplices.face q j (RightCut.back sigma)))) }
  };
