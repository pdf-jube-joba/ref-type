\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Values[] \as Values;
\definition expansion: \forall (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) ->
  (LeftProduct.apply (Theory.coboundary p alpha) beta).apply (Chains.generator Geometry.leftDegree (Geometry.leftSimplex sigma)) =
    Sums.sum (N.Nat^::succ (N.Nat^::succ p)) (Values.left alpha beta sigma) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) => eq_reason_in!{R _
    "=" _ "by" { LeftProduct.onSimplex (Theory.coboundary p alpha) beta (Geometry.leftSimplex sigma) }
    "=" _ "by" { congr!{R R} (\fun (x: R) => (baseRing).mul x ((beta).apply (Chains.generator q (LeftCut.back (Geometry.leftSimplex sigma))))) _ _
        (LeftDifferential.onSimplex alpha (LeftCut.front (Geometry.leftSimplex sigma))) }
    "=" _ "by" { Scalars.rightSum (N.Nat^::succ (N.Nat^::succ p))
        (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ p))) => (alpha).apply (Chains.generator p (Simplices.face p i (LeftCut.front (Geometry.leftSimplex sigma)))))
        ((beta).apply (Chains.generator q (LeftCut.back (Geometry.leftSimplex sigma)))) }
  };
\definition law: \forall (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) ->
  (leftTerm alpha beta).apply (Chains.generator higher sigma) = Sums.sum (N.Nat^::succ (N.Nat^::succ p)) (Values.left alpha beta sigma) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(sigma: Simplices.Carrier higher) => eq_reason_in!{R _
    "=" _ "by" { Degrees.law Geometry.leftDegree higher Geometry.same (LeftProduct.apply (Theory.coboundary p alpha) beta) sigma }
    "=" _ "by" { congr!{{Simplices.Carrier Geometry.leftDegree} R}
        (\fun (tau: Simplices.Carrier Geometry.leftDegree) => (LeftProduct.apply (Theory.coboundary p alpha) beta).apply (Chains.generator Geometry.leftDegree tau)) _ _
        (sym!{{Simplices.Carrier Geometry.leftDegree}} _ _ (Geometry.leftSimplexLaw sigma)) }
    "=" _ "by" { expansion alpha beta sigma }
  };
