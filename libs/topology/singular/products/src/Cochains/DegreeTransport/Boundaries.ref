\import chain_complexes.Cochain[].Over[R := R, ring := baseRing] \as Complexes;
\module At(n: N.Nat^) {
  \import Complexes.At[C := Theory.complex, k := n] \as Native;
  \definition Member[x: Carrier n]: \Prop := \In[Carrier n] (Native.Boundaries n) x;
}
\definition Member[n: N.Nat^][x: Carrier n]: \Prop := At[n := n].Member x;
\definition preserves: \forall (m, n: N.Nat^)(same: m = n)(x: Carrier m) -> Member m x -> Member n (Transport.cast Carrier m n same x) :=
  \fun (m, n: N.Nat^)(same: m = n)(x: Carrier m) => Transport.predicate Carrier (\fun (k: N.Nat^)(y: Carrier k) => Member k y) m n same x;
\definition reflects: \forall (m, n: N.Nat^)(same: m = n)(x: Carrier m) -> Member n (Transport.cast Carrier m n same x) -> Member m x :=
  \fun (m, n: N.Nat^)(same: m = n)(x: Carrier m)(member: Member n (Transport.cast Carrier m n same x)) =>
    \idelim Transport.cast Carrier n m (sym!{N.Nat^} m n same) (Transport.cast Carrier m n same x) = x \with y: Carrier m => Member m y \by {
      base: preserves n m (sym!{N.Nat^} m n same) (Transport.cast Carrier m n same x) member,
      equality: Transport.castInverse Carrier m n same x
    };
