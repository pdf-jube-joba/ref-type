\import \root.Cochains[A := B, source := target, R := R, ring := ring] \as Other;
\import singular_cohomology.Maps[A := A, B := B, source := source, target := target] \as Geometry;
\import Geometry.Coefficients[M := integerCoefficients, L := integerCoefficients] \as Pull;
\import IntegerModules.End[V := R, space := integerCoefficients.space] \as Coefficients;
\import singular_cohomology.Simplices[A := B, source := target] \as OtherSimplices;
\import singular_cohomology.Chains[A := B, source := target] \as OtherChains;
\definition apply[n: N.Nat^][f: A -> B][continuous: Geometry.Continuous f][alpha: Other.Carrier n]: Carrier n :=
  (Pull.map f continuous Coefficients.identity).apply n alpha;
\definition onSimplex: \forall (n: N.Nat^)(f: A -> B)(continuous: Geometry.Continuous f)(alpha: Other.Carrier n)(sigma: Simplices.Carrier n) ->
  (apply n f continuous alpha).apply (Chains.generator n sigma) = (alpha).apply (OtherChains.generator n (Geometry.postcompose n f continuous sigma)) :=
  \fun (n: N.Nat^)(f: A -> B)(continuous: Geometry.Continuous f)(alpha: Other.Carrier n)(sigma: Simplices.Carrier n) =>
    Pull.At[n := n].onCochain f continuous Coefficients.identity alpha sigma;
\module Cup(p, q: N.Nat^);
\module Unit;
