\import std.Data[].FinSet[] \as Fin;
\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as Bounds;
\import Simplices.CutFaces[p := p, q := q] \as Geometry;
\definition total: N.Nat^ := Geometry.total;
\definition higher: N.Nat^ := Geometry.higher;
\import \parent.Cup[p := p, q := q] \as Product;
\import \parent.Cup[p := N.Nat^::succ p, q := q] \as LeftProduct;
\import \parent.Cup[p := p, q := N.Nat^::succ q] \as RightProduct;
\import Simplices.Cut[p := N.Nat^::succ p, q := q] \as LeftCut;
\import Simplices.Cut[p := p, q := N.Nat^::succ q] \as RightCut;
\import \parent.Differential[n := p] \as LeftDifferential;
\import \parent.Differential[n := q] \as RightDifferential;
\import \parent.Differential[n := total] \as ProductDifferential;
\import Modules.Alternating[V := R, space := Modules.scalarModule] \as Sums;
\import Sums.Concatenation[] \as Signs;
\import \root.Scalars[R := R, ring := ring] \as Scalars;
\import \parent.Signs[n := higher] \as CochainSigns;
\import \parent.DegreeTransport[] \as Degrees;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition leftTerm[alpha: Carrier p][beta: Carrier q]: Carrier higher := Transport.cast Carrier Geometry.leftDegree higher Geometry.same (LeftProduct.apply (Theory.coboundary p alpha) beta);
\module Values;
\module Left;
\module Right;
\module Partition;
\module Proof;
\definition law: \forall (alpha: Carrier p)(beta: Carrier q) ->
  Theory.coboundary total (Product.apply alpha beta) = (space higher).add (leftTerm alpha beta) (CochainSigns.apply p (RightProduct.apply alpha (Theory.coboundary q beta))) := Proof[].law;
