\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Pair[] \as Pair;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import singular_cohomology.Chains[A := A, source := left] \as Left;
\import singular_cohomology.Chains[A := B, source := right] \as Right;
\import singular_cohomology.Simplices[A := A, source := left] \as LeftSimplices;
\import singular_cohomology.Simplices[A := B, source := right] \as RightSimplices;
\import topological_constructions.Product[A := A, B := B] \as Product;
\definition topology: topology.Topology[Carrier := Product.CarrierSet].Topology := Product.topology left right;
\import singular_cohomology.Chains[A := Product.CarrierSet, source := topology] \as Source;
\import singular_cohomology.Simplices[A := Product.CarrierSet, source := topology] \as Simplices;
\import singular_cohomology.Maps[A := Product.CarrierSet, B := A, source := topology, target := left] \as LeftMap;
\import singular_cohomology.Maps[A := Product.CarrierSet, B := B, source := topology, target := right] \as RightMap;
\import Product.Maps[] \as Projections;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\definition leftProjection: Product.CarrierSet -> A := Pair.first A B;
\definition rightProjection: Product.CarrierSet -> B := Pair.second A B;
\definition leftContinuous: LeftMap.Continuous leftProjection := Projections.firstContinuous left right;
\definition rightContinuous: RightMap.Continuous rightProjection := Projections.secondContinuous left right;
\module At(p, q: N.Nat^);
\module Boundary(p, q: N.Nat^);
\module Total;
