\import \parent.RightBase[].At[p := p, y := y] \as Lower;
\import \parent.RightBase[].At[p := N.Nat^::succ p, y := y] \as Upper;
\import \parent.RightBase[].Linear[p := p, y := y] \as LowerLinear;
\import \parent.RightBase[].Linear[p := N.Nat^::succ p, y := y] \as UpperLinear;
\import \parent.At[p := p, q := N.Nat^::zero] \as LowerShuffle;
\import \parent.At[p := N.Nat^::succ p, q := N.Nat^::zero] \as UpperShuffle;
\import Product.DegreeTransport[] \as Degrees;
\import Left.Mapping[W := Pair] \as Pointwise;
\definition law: \forall (x: Left.Carrier (N.Nat^::succ (N.Nat^::succ p))) ->
  (Product.boundary Lower.actualLength).apply (UpperShuffle.apply x (Right.generator (N.Nat^::succ N.Nat^::zero) y)) =
    LowerShuffle.apply ((Left.boundary Lower.canonicalLength).apply x) (Right.generator (N.Nat^::succ N.Nat^::zero) y) :=
  \fun (x: Left.Carrier (N.Nat^::succ (N.Nat^::succ p))) => trans!{{Product.Carrier Lower.actualLength}} _ _ _
    (congr!{{Product.Carrier Upper.actualLength} {Product.Carrier Lower.actualLength}} ((Product.boundary Lower.actualLength).apply) _ _ (UpperLinear.onChain x))
    (trans!{{Product.Carrier Lower.actualLength}} _ _ _
      (sym!{{Product.Carrier Lower.actualLength}} _ _ (Degrees.boundaryNatural Lower.canonicalLength Lower.actualLength Lower.same ((Upper.raw).apply x)))
      (trans!{{Product.Carrier Lower.actualLength}} _ _ _
        (congr!{{Product.Carrier Lower.canonicalLength} {Product.Carrier Lower.actualLength}} (Degrees.apply Lower.canonicalLength Lower.actualLength Lower.same) _ _
          (Pointwise.Boundary[n := Lower.canonicalLength].commutes Lower.vertex x))
        (sym!{{Product.Carrier Lower.actualLength}} _ _ (LowerLinear.onChain ((Left.boundary Lower.canonicalLength).apply x)))));
