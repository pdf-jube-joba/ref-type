\definition p: N.Nat^ := N.Nat^::zero;
\definition q: N.Nat^ := N.Nat^::succ s;
\import \parent.At[p := p, q := q] \as Current;
\import \parent.\parent.At[p := p, q := q] \as Full;
\import \parent.\parent.At[p := p, q := s] \as Lower;
\import \parent.\parent.LeftDegreeZero[q := s] \as Known;
\import Commutative.Bilinear[A := Full.left, B := Full.right, C := Current.target] \as Form;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\import Modules.Laws[V := Product.Carrier q, space := Product.space q] \as Values;
\import algebra.Group[].Of[Carrier := Product.Carrier q, group := Values.additive] \as Group;
\definition rhs[x: Full.left.Carrier][y: Full.right.Carrier]:
  (Current.rhs).apply x y = Lower.apply x ((Right.boundary q).apply y) :=
  trans!{{Product.Carrier q}} _ _ _ (Group.zeroLeft ((Current.rightTerm).apply x y))
    (Transport.castRefl Product.Carrier q (Lower.apply x ((Right.boundary q).apply y)));
\definition equation: Statement p q := Form.ext Current.lhs Current.rhs (\fun (x: Full.left.Carrier)(y: Full.right.Carrier) =>
  trans!{{Product.Carrier q}} _ _ _ (Known.law x y) (sym!{{Product.Carrier q}} _ _ (rhs x y)));
