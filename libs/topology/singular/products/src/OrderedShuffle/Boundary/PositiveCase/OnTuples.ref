\definition a: V := leftHead p x;
\definition b: W := rightHead q y;
\definition tailLeft: Left.Carrier p := Left.generator p (leftTail p x);
\definition tailRight: Right.Carrier q := Right.generator q (rightTail q y);
\import \parent.\parent.Positive[r := r, s := s, a := a, b := b].OnCones[] \as Calculation;
\import Fin.Tuples[A := V] \as LeftTuples;
\import Fin.Tuples[A := W] \as RightTuples;
\definition left: (Left.cone p a).apply tailLeft = Left.generator (N.Nat^::succ p) x :=
  trans!{{Left.Carrier (N.Nat^::succ p)}} _ _ _ (Left.Cone[n := p].onGenerator a (leftTail p x))
    (congr!{{Left.Tuple (N.Nat^::succ p)} {Left.Carrier (N.Nat^::succ p)}} (Left.generator (N.Nat^::succ p)) _ _ (LeftTuples.recover p x));
\definition right: (Right.cone q b).apply tailRight = Right.generator (N.Nat^::succ q) y :=
  trans!{{Right.Carrier (N.Nat^::succ q)}} _ _ _ (Right.Cone[n := q].onGenerator b (rightTail q y))
    (congr!{{Right.Tuple (N.Nat^::succ q)} {Right.Carrier (N.Nat^::succ q)}} (Right.generator (N.Nat^::succ q)) _ _ (RightTuples.recover q y));
\definition onGenerators[f: Form.Map]:
  (f).apply ((Left.cone p a).apply tailLeft) ((Right.cone q b).apply tailRight) = (f).apply (Left.generator (N.Nat^::succ p) x) (Right.generator (N.Nat^::succ q) y) :=
  congr2!{{Left.Carrier (N.Nat^::succ p)} {Right.Carrier (N.Nat^::succ q)} Current.target.Carrier} ((f).apply) _ _ _ _ left right;
\definition law: Statement r q -> Statement p s ->
  (Current.lhs).apply (Left.generator (N.Nat^::succ p) x) (Right.generator (N.Nat^::succ q) y) = (Current.rhs).apply (Left.generator (N.Nat^::succ p) x) (Right.generator (N.Nat^::succ q) y) :=
  \fun (previousLeft: Statement r q)(previousRight: Statement p s) =>
    trans!{Current.target.Carrier} _ _ _ (sym!{Current.target.Carrier} _ _ (onGenerators Current.lhs))
      (trans!{Current.target.Carrier} _ _ _ (Calculation.law previousLeft previousRight tailLeft tailRight) (onGenerators Current.rhs));
