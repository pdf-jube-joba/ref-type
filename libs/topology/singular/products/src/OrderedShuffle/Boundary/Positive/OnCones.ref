\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Coning[] \as Coning;
\import \parent.RightHandSide[] \as RightHandSide;
\definition law: Statement r q -> Statement p s -> \forall (x: Left.Carrier p)(y: Right.Carrier q) ->
  (Current.lhs).apply (X x) (Y y) = (Current.rhs).apply (X x) (Y y) :=
  \fun (previousLeft: Statement r q)(previousRight: Statement p s)(x: Left.Carrier p)(y: Right.Carrier q) =>
    eq_reason_in!{{Product.Carrier (N.Nat^::succ m)} _
      "=" _ "by" { congr!{{Product.Carrier (N.Nat^::succ (N.Nat^::succ m))} {Product.Carrier (N.Nat^::succ m)}} ((Product.boundary (N.Nat^::succ m)).apply) _ _ (shuffle x y) }
      "=" _ "by" { Product.ConeBoundary[n := m].law point (cut x y) }
      "=" _ "by" { congr!{{Product.Carrier (N.Nat^::succ m)} {Product.Carrier (N.Nat^::succ m)}} (UpperGroup.difference (cut x y)) _ _ (Coning.law previousLeft previousRight x y) }
      "=" _ "by" { sym!{{Product.Carrier (N.Nat^::succ m)}} _ _ (RightHandSide.law x y) }
    };
