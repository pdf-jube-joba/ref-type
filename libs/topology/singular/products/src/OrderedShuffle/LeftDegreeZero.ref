\import \parent.At[p := N.Nat^::zero, q := N.Nat^::succ q] \as Upper;
\import \parent.At[p := N.Nat^::zero, q := q] \as Lower;
\import Commutative.Bilinear[A := Upper.left, B := Upper.right, C := Upper.target] \as UpperForm;
\import Commutative.Bilinear[A := Lower.left, B := Lower.right, C := Lower.target] \as LowerForm;
\import Modules.Hom[V := Product.Carrier (N.Nat^::succ (N.Nat^::succ q)), W := Product.Carrier (N.Nat^::succ q),
  source := Product.space (N.Nat^::succ (N.Nat^::succ q)), target := Product.space (N.Nat^::succ q)]
  .Composition[U := Left.Carrier (N.Nat^::succ N.Nat^::zero), domain := Left.space (N.Nat^::succ N.Nat^::zero)] \as Composition;
\import Modules.Hom[V := Left.Carrier (N.Nat^::succ N.Nat^::zero), W := Product.Carrier (N.Nat^::succ q),
  source := Left.space (N.Nat^::succ N.Nat^::zero), target := Product.space (N.Nat^::succ q)] \as Maps;
\definition after[y: Right.Carrier (N.Nat^::succ (N.Nat^::succ q))]: Maps.Map :=
  Composition.compose (Product.boundary (N.Nat^::succ q)) (UpperForm.leftAt Upper.bilinear y);
\definition before[y: Right.Carrier (N.Nat^::succ (N.Nat^::succ q))]: Maps.Map :=
  LowerForm.leftAt Lower.bilinear ((Right.boundary (N.Nat^::succ q)).apply y);
\import Modules.Free[Generators := Left.Tuple (N.Nat^::succ N.Nat^::zero)].To[W := Product.Carrier (N.Nat^::succ q), target := Product.space (N.Nat^::succ q)] \as Free;
\definition equation[y: Right.Carrier (N.Nat^::succ (N.Nat^::succ q))]: after y = before y :=
  Free.ext (after y) (before y) (\fun (x: Left.Tuple (N.Nat^::succ N.Nat^::zero)) => \parent.LeftBoundary[q := q, x := x].law y);
\definition law: \forall (x: Left.Carrier (N.Nat^::succ N.Nat^::zero))(y: Right.Carrier (N.Nat^::succ (N.Nat^::succ q))) ->
  (Product.boundary (N.Nat^::succ q)).apply (Upper.apply x y) = Lower.apply x ((Right.boundary (N.Nat^::succ q)).apply y) :=
  \fun (x: Left.Carrier (N.Nat^::succ N.Nat^::zero))(y: Right.Carrier (N.Nat^::succ (N.Nat^::succ q))) =>
    congr!{Maps.Map {Product.Carrier (N.Nat^::succ q)}} (\fun (f: Maps.Map) => (f).apply x) _ _ (equation y);
