\module At(p: N.Nat^) {
  \import \parent.\parent.Recurrence[p := p, q := N.Nat^::succ s, a := a, b := b] \as Recurrence;
  \definition Equation: \Prop := Recurrence.lhs = Recurrence.rhs;
}
\definition equation: \forall (p: N.Nat^) -> At[p := p].Equation :=
  \induction (p: N.Nat^) \return At[p := p].Equation \with {
    | zero: \parent.LeftZero[s := s, a := a, b := b].equation
    | succ: \fun (p: N.Nat^)(previous: At[p := p].Equation) => \parent.Positive[r := p, s := s, a := a, b := b].equation
  };
