\definition p: N.Nat^ := N.Nat^::succ r;
\definition q: N.Nat^ := N.Nat^::zero;
\import \parent.Recurrence[p := p, q := q, a := a, b := b] \as Recurrence;
\import \parent.\parent.At[p := p, q := q] \as Full;
\import \parent.\parent.At[p := r, q := q] \as Lower;
\import Fin.Tuples[A := W] \as Tuples;
\import Left.Mapping[W := Pair] \as Pointwise;
\import Product.DegreeTransport[] \as Degrees;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\import Modules.Laws[V := Product.Carrier (degree p q), space := Product.space (degree p q)] \as Values;
\import algebra.Group[].Of[Carrier := Product.Carrier (degree p q), group := Values.additive] \as Group;
\import Modules.Alternating[V := Product.Carrier (degree p q), space := Product.space (degree p q)].Concatenation[] \as Signs;
\import Commutative.Bilinear[A := Recurrence.domainLeft, B := Recurrence.domainRight, C := Recurrence.middle].Operations[] \as Operations;
\module At(y: Right.Tuple N.Nat^::zero);
\import Commutative.FreeBilinear[X := Left.Tuple p, Y := Right.Tuple N.Nat^::zero, C := Full.target] \as Extension;
\definition equation: Recurrence.lhs = Recurrence.rhs :=
  Extension.ext Recurrence.lhs Recurrence.rhs (\fun (x: Left.Tuple p)(y: Right.Tuple N.Nat^::zero) => At[y := y].law x);
\definition law[x: Left.Carrier p][y: Right.Carrier N.Nat^::zero]: (Recurrence.lhs).apply x y = (Recurrence.rhs).apply x y :=
  congr!{{Commutative.Bilinear[A := Recurrence.domainLeft, B := Recurrence.domainRight, C := Full.target].Map} {Product.Carrier (length p q)}}
    (\fun (f: Commutative.Bilinear[A := Recurrence.domainLeft, B := Recurrence.domainRight, C := Full.target].Map) => (f).apply x y) _ _ equation;
