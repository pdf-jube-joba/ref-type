\definition nextLeft: Left.Tuple (N.Nat^::succ N.Nat^::zero) := Tuples.extend N.Nat^::zero a x;
\import \parent.\parent.\parent.LeftBaseMap[q := q, x := nextLeft] \as UpperMap;
\import \parent.\parent.\parent.LeftBaseMap[q := s, x := nextLeft] \as LowerMap;
\definition vertex[w: W]: Pair := Pair { left := leftHead N.Nat^::zero nextLeft, right := w };
\definition point: Pair := Pair { left := a, right := b };
\definition pointLaw: vertex b = point := congr!{V Pair} (\fun (v: V) => Pair { left := v, right := b }) _ _ (Tuples.atZero N.Nat^::zero a x);
\definition value[y: Right.Tuple q]: Product.Carrier q := (Pointwise.push q vertex).apply (Right.generator q y);
\definition canonical[y: Right.Tuple q]: Product.Carrier (length p q) := (Product.cone q (vertex b)).apply (value y);
\definition lhs[y: Right.Tuple q]: (Recurrence.lhs).apply (Left.generator N.Nat^::zero x) (Right.generator q y) = canonical y :=
  trans!{{Product.Carrier (length p q)}} _ _ _
    (congr!{{Left.Carrier (N.Nat^::succ N.Nat^::zero)} {Product.Carrier (length p q)}}
      (\fun (v: Left.Carrier (N.Nat^::succ N.Nat^::zero)) => Full.apply v ((Right.cone q b).apply (Right.generator q y))) _ _ (Left.Cone[n := N.Nat^::zero].onGenerator a x))
    (trans!{{Product.Carrier (length p q)}} _ _ _ (UpperMap.onChain ((Right.cone q b).apply (Right.generator q y)))
      (Pointwise.Cone[n := q].onGenerator vertex b y));
\definition right[y: Right.Tuple q]: (Recurrence.rightTerm).apply (Left.generator N.Nat^::zero x) (Right.generator q y) = value y :=
  trans!{{Product.Carrier q}} _ _ _
    (Transport.castRefl Product.Carrier q (Lower.apply ((Left.cone N.Nat^::zero a).apply (Left.generator N.Nat^::zero x)) (Right.generator q y)))
    (trans!{{Product.Carrier q}} _ _ _
      (congr!{{Left.Carrier (N.Nat^::succ N.Nat^::zero)} {Product.Carrier q}}
        (\fun (v: Left.Carrier (N.Nat^::succ N.Nat^::zero)) => Lower.apply v (Right.generator q y)) _ _ (Left.Cone[n := N.Nat^::zero].onGenerator a x))
      (LowerMap.onChain (Right.generator q y)));
\definition rhs[y: Right.Tuple q]: (Recurrence.rhs).apply (Left.generator N.Nat^::zero x) (Right.generator q y) = canonical y :=
  trans!{{Product.Carrier (length p q)}} _ _ _
    (congr!{{Product.Carrier q} {Product.Carrier (length p q)}} ((Product.cone q point).apply) _ _
      (trans!{{Product.Carrier q}} _ _ _ (Group.zeroLeft ((Recurrence.rightTerm).apply (Left.generator N.Nat^::zero x) (Right.generator q y))) (right y)))
    (congr!{Pair {Product.Carrier (length p q)}} (\fun (c: Pair) => (Product.cone q c).apply (value y)) _ _ (sym!{Pair} _ _ pointLaw));
\definition law[y: Right.Tuple q]: (Recurrence.lhs).apply (Left.generator N.Nat^::zero x) (Right.generator q y) = (Recurrence.rhs).apply (Left.generator N.Nat^::zero x) (Right.generator q y) :=
  trans!{{Product.Carrier (length p q)}} _ _ _ (lhs y) (sym!{{Product.Carrier (length p q)}} _ _ (rhs y));
