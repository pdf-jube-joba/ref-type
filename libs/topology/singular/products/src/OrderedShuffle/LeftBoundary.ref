\use std.Logic[].Equality[].eq_reason_in;
\import \parent.LeftBaseMap[q := N.Nat^::succ q, x := x] \as Upper;
\import \parent.LeftBaseMap[q := q, x := x] \as Lower;
\import \parent.At[p := N.Nat^::zero, q := N.Nat^::succ q] \as UpperShuffle;
\import \parent.At[p := N.Nat^::zero, q := q] \as LowerShuffle;
\import Right.Mapping[W := Pair] \as Pointwise;
\definition law: \forall (y: Right.Carrier (N.Nat^::succ (N.Nat^::succ q))) ->
  (Product.boundary (N.Nat^::succ q)).apply (UpperShuffle.apply (Left.generator (N.Nat^::succ N.Nat^::zero) x) y) =
    LowerShuffle.apply (Left.generator (N.Nat^::succ N.Nat^::zero) x) ((Right.boundary (N.Nat^::succ q)).apply y) :=
  \fun (y: Right.Carrier (N.Nat^::succ (N.Nat^::succ q))) => eq_reason_in!{{Product.Carrier (N.Nat^::succ q)} _
    "=" _ "by" { congr!{{Product.Carrier (N.Nat^::succ (N.Nat^::succ q))} {Product.Carrier (N.Nat^::succ q)}} ((Product.boundary (N.Nat^::succ q)).apply) _ _ (Upper.onChain y) }
    "=" _ "by" { Pointwise.Boundary[n := N.Nat^::succ q].commutes Upper.vertex y }
    "=" _ "by" { sym!{{Product.Carrier (N.Nat^::succ q)}} _ _ (Lower.onChain ((Right.boundary (N.Nat^::succ q)).apply y)) }
  };
