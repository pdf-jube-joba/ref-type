\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\import \parent.At[p := N.Nat^::zero, y := y] \as Data;
\definition leftTuple[x: Left.Tuple (N.Nat^::succ N.Nat^::zero)]: Product.Tuple (N.Nat^::succ N.Nat^::zero) :=
  \fun (i: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => Pair { left := leftHead N.Nat^::zero x, right := y i };
\definition rightTuple[x: Left.Tuple (N.Nat^::succ N.Nat^::zero)]: Product.Tuple (N.Nat^::succ N.Nat^::zero) :=
  \fun (i: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => Data.vertex (x i);
\definition tuples: \forall (x: Left.Tuple (N.Nat^::succ N.Nat^::zero)) -> leftTuple x = rightTuple x :=
  \fun (x: Left.Tuple (N.Nat^::succ N.Nat^::zero)) => \axiom:funext(leftTuple x, rightTuple x,
    \fun (i: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => congr!{V W Pair} Pair::# _ _ _ _
      (sym!{V} _ _ (congr!{{Fin.Fin (N.Nat^::succ N.Nat^::zero)} V} x _ _ (Fin.singletonValue i)))
      (congr!{{Fin.Fin (N.Nat^::succ N.Nat^::zero)} W} y _ _ (Fin.singletonValue i)));
\definition law: \forall (x: Left.Tuple (N.Nat^::succ N.Nat^::zero)) -> onTuples N.Nat^::zero N.Nat^::zero x y = Data.value x :=
  \fun (x: Left.Tuple (N.Nat^::succ N.Nat^::zero)) => eq_reason_in!{{Product.Carrier (N.Nat^::succ N.Nat^::zero)} _
    "=" _ "by" { congr!{{Product.Tuple (N.Nat^::succ N.Nat^::zero)} {Product.Carrier (N.Nat^::succ N.Nat^::zero)}} (Product.generator (N.Nat^::succ N.Nat^::zero)) _ _ (tuples x) }
    "=" _ "by" { sym!{{Product.Carrier (N.Nat^::succ N.Nat^::zero)}} _ _ (Pointwise.At[n := N.Nat^::succ N.Nat^::zero].onGenerator Data.vertex x) }
    "=" _ "by" { sym!{{Product.Carrier (N.Nat^::succ N.Nat^::zero)}} _ _ (Transport.castRefl Product.Carrier (N.Nat^::succ N.Nat^::zero) ((Data.raw).apply (Left.generator (N.Nat^::succ N.Nat^::zero) x))) }
  };
