\definition canonicalLength: N.Nat^ := N.Nat^::succ p;
\definition actualLength: N.Nat^ := length p N.Nat^::zero;
\definition same: canonicalLength = actualLength := sym!{N.Nat^} _ _ (congr!{N.Nat^ N.Nat^} N.Nat^::succ _ _ (NatLaws.addZeroLeft p));
\definition vertex[v: V]: Pair := Pair { left := v, right := rightHead N.Nat^::zero y };
\definition raw: Modules.Hom[V := Left.Carrier canonicalLength, W := Product.Carrier canonicalLength, source := Left.space canonicalLength, target := Product.space canonicalLength].Map := Pointwise.push canonicalLength vertex;
\import Modules.Hom[V := Product.Carrier canonicalLength, W := Product.Carrier actualLength, source := Product.space canonicalLength, target := Product.space actualLength]
  .Composition[U := Left.Carrier canonicalLength, domain := Left.space canonicalLength] \as Composition;
\definition map: Modules.Hom[V := Left.Carrier canonicalLength, W := Product.Carrier actualLength, source := Left.space canonicalLength, target := Product.space actualLength].Map :=
  Composition.compose (Degrees.linear canonicalLength actualLength same) raw;
\definition value[x: Left.Tuple canonicalLength]: Product.Carrier actualLength := (map).apply (Left.generator canonicalLength x);
