\use std.Logic[].Equality[].eq_reason_in;
\import Target.At[n := n] \as TargetAt;
\import SmallMaps.At[n := n] \as SmallAt;
\import WholeMaps.At[n := n] \as WholeAt;
\import Domain.At[n := n] \as DomainAt;
\import \parent.At[n := n] \as SimplexAt;
\import singular_cohomology.Chains[A := B, source := topology] \as WholeDomain;
\import Modules.Hom[V := Domain.Carrier n, W := Whole.Carrier n, source := Domain.space n, target := Whole.space n] \as Maps;
\import Modules.Hom[V := Target.Carrier n, W := Whole.Carrier n, source := Target.space n, target := Whole.space n]
  .Composition[U := Domain.Carrier n, domain := Domain.space n] \as Left;
\import Modules.Hom[V := WholeDomain.Carrier n, W := Whole.Carrier n, source := WholeDomain.space n, target := Whole.space n]
  .Composition[U := Domain.Carrier n, domain := Domain.space n] \as Right;
\definition law: \forall (continuous: Continuous) ->
  Left.compose TargetAt.inclusion (SmallAt.push (simplicial continuous)) =
  Right.compose (WholeAt.push f continuous) DomainAt.inclusion :=
  \fun (continuous: Continuous) => Modules.Free[Generators := DomainSimplices.Carrier n].To[W := Whole.Carrier n, target := Whole.space n].ext
    (Left.compose TargetAt.inclusion (SmallAt.push (simplicial continuous)))
    (Right.compose (WholeAt.push f continuous) DomainAt.inclusion)
    (\fun (sigma: DomainSimplices.Carrier n) => eq_reason_in!{{Whole.Carrier n} _
      "=" _ "by" { congr!{{Target.Carrier n} {Whole.Carrier n}} ((TargetAt.inclusion).apply) _ _ (SmallAt.onGenerator (simplicial continuous) sigma) }
      "=" _ "by" { TargetAt.onGenerator (SimplexAt.postcompose continuous sigma) }
      "=" _ "by" { sym!{{Whole.Carrier n}} _ _ (trans!{{Whole.Carrier n}} _ _ _
          (congr!{{WholeDomain.Carrier n} {Whole.Carrier n}} ((WholeAt.push f continuous).apply) _ _ (DomainAt.onGenerator sigma))
          (WholeAt.onGenerator f continuous sigma)) }
    });
