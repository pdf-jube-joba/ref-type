\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Simplices[] \as SmallSimplices;
\definition simplex[sigma: SmallSimplices.Carrier n]: WholeSimplices.Carrier n := sigma;
\import Modules.Free[Generators := SmallSimplices.Carrier n].Reindex[TargetGenerators := WholeSimplices.Carrier n] \as Reindex;
\import Reindex.Injection[f := simplex] \as Injection;
\import Injection.Retraction[] \as Retraction;
\definition generatorInjection: \forall (sigma, tau: SmallSimplices.Carrier n) -> simplex sigma = simplex tau -> sigma = tau :=
  \fun (sigma, tau: SmallSimplices.Carrier n)(same: simplex sigma = simplex tau) => \axiom:funext(sigma, tau,
    \fun (x: Simplex.Carrier n) => congr!{{WholeSimplices.Carrier n} A} (\fun (s: WholeSimplices.Carrier n) => s x) _ _ same);
\import Modules.Hom[V := Carrier n, W := Whole.Carrier n, source := space n, target := Whole.space n] \as Forward;
\definition inclusion: Forward.Map := Mapping.At[n := n].push simplicialInclusion;
\definition onGenerator: \forall (sigma: SmallSimplices.Carrier n) -> (inclusion).apply (generator n sigma) = Whole.generator n sigma := Mapping.At[n := n].onGenerator simplicialInclusion;
\definition injective: \forall (x, y: Carrier n) -> (inclusion).apply x = (inclusion).apply y -> x = y := Injection.injective generatorInjection;
\definition retraction: Modules.Hom[V := Whole.Carrier n, W := Carrier n, source := Whole.space n, target := space n].Map := Retraction.retraction generatorInjection;
\import Modules.Hom[V := Carrier n, W := Carrier n, source := space n, target := space n] \as End;
\definition retract: \forall (x: Carrier n) -> (retraction).apply ((inclusion).apply x) = x :=
  \fun (x: Carrier n) => congr!{End.Map {Carrier n}} (\fun (f: End.Map) => (f).apply x) _ _ (Retraction.leftInverse generatorInjection);
\definition Image[z: Whole.Carrier n]: \Prop := \exists ( x: Carrier n \where (inclusion).apply x = z );
\import Modules.Of[V := Whole.Carrier n, space := Whole.space n].Submodule[] \as Submodules;
\import Submodules.Image[U := Carrier n, source := space n] \as Images;
\definition submodule: Submodules.Submodule := Images.image inclusion;
\definition generatorImage: \forall (sigma: SmallSimplices.Carrier n) -> Image (Whole.generator n sigma) :=
  \fun (sigma: SmallSimplices.Carrier n) => Logic.existsIntro[Carrier n, { x: Carrier n \where (inclusion).apply x = Whole.generator n sigma }] (generator n sigma) (onGenerator sigma);
\definition imageRetract: \forall (z: Whole.Carrier n) -> Image z -> (inclusion).apply ((retraction).apply z) = z := \block {
  \fun (z: Whole.Carrier n)(image: Image z) \then
  \takefrom x: \Cast[Carrier n] ({ x: Carrier n \where (inclusion).apply x = z }) \by image \then
  \let same: (inclusion).apply x = z := \bysub(Carrier n, { x: Carrier n \where (inclusion).apply x = z }, x) \then
  \return eq_reason_in!{{Whole.Carrier n} _
    "=" _ "by" { congr!{{Whole.Carrier n} {Whole.Carrier n}} (\fun (y: Whole.Carrier n) => (inclusion).apply ((retraction).apply y)) _ _ (sym!{{Whole.Carrier n}} _ _ same) }
    "=" _ "by" { congr!{{Carrier n} {Whole.Carrier n}} ((inclusion).apply) _ _ (retract x) }
    "=" _ "by" same
  }
};
