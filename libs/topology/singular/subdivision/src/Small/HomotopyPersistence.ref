\import \parent.At[n := n] \as Degree;
\import \parent.At[n := N.Nat^::succ n] \as Higher;
\import \parent.Persistence[n := n] \as Persistence;
\import \parent.Subdivision[].At[n := n].Inclusion[] \as Preserve;
\import \root.Subdivision[A := A, source := source].At[n := n] \as Original;
\import \root.Subdivision[A := A, source := source].Iterated[].At[n := n] \as Powers;
\import N.Basic[].Prop[] \as Bounds;
\definition law: \forall (r: N.Nat^)(x: Whole.Carrier n) -> Degree.Image x -> Higher.Image ((Powers.homotopyMap r).apply x) :=
  \induction (r: N.Nat^) \return \forall (x: Whole.Carrier n) -> Degree.Image x -> Higher.Image ((Powers.homotopyMap r).apply x) \with {
    | zero: \fun (x: Whole.Carrier n)(member: Degree.Image x) => (Higher.submodule).zero
    | succ: \fun (r: N.Nat^)(previous: \forall (x: Whole.Carrier n) -> Degree.Image x -> Higher.Image ((Powers.homotopyMap r).apply x))(x: Whole.Carrier n)(member: Degree.Image x) =>
        (Higher.submodule).addition ((Original.homotopyMap).apply (Powers.apply r x)) ((Powers.homotopyMap r).apply x)
          (Preserve.homotopyPreserves (Powers.apply r x) (Persistence.law x N.Nat^::zero member r (Bounds.zeroLe r))) (previous x member)
  };
