\use std.Logic[].Equality[].eq_reason_in;
\import \parent.At[n := N.Nat^::zero] \as Degree;
\import \parent.\parent.At[n := N.Nat^::zero] \as SmallDegree;
\import \parent.\parent.At[n := N.Nat^::succ N.Nat^::zero] \as SmallHigher;
\import WholeSubdivision.At[n := N.Nat^::zero] \as WholeDegree;
\import Modules.Laws[V := Carrier N.Nat^::zero, space := space N.Nat^::zero] \as Values;
\import Modules.Laws[V := Whole.Carrier N.Nat^::zero, space := Whole.space N.Nat^::zero] \as WholeValues;
\import Modules.Hom[V := Carrier N.Nat^::zero, W := Whole.Carrier N.Nat^::zero, source := space N.Nat^::zero, target := Whole.space N.Nat^::zero] \as Linear;
\definition law: \forall (x: Carrier N.Nat^::zero) -> Values.add ((Degree.map).apply x) (Values.neg x) = (complex.differential).apply N.Nat^::zero ((Degree.homotopyMap).apply x) :=
  \fun (x: Carrier N.Nat^::zero) => SmallDegree.injective _ _
    (eq_reason_in!{{Whole.Carrier N.Nat^::zero} _
      "=" _ "by" { (SmallDegree.inclusion).addition _ _ }
      "=" _ "by" { congr!{{Whole.Carrier N.Nat^::zero} {Whole.Carrier N.Nat^::zero} {Whole.Carrier N.Nat^::zero}} WholeValues.add _ _ _ _
          (Degree.Inclusion[].law x) (Linear.negativePreserved SmallDegree.inclusion x) }
      "=" _ "by" { WholeSubdivision.Zero[].law ((SmallDegree.inclusion).apply x) }
      "=" _ "by" { congr!{{Whole.Carrier (N.Nat^::succ N.Nat^::zero)} {Whole.Carrier N.Nat^::zero}} ((Whole.boundary N.Nat^::zero).apply) _ _ (sym!{{Whole.Carrier (N.Nat^::succ N.Nat^::zero)}} _ _ (Degree.Inclusion[].homotopyLaw x)) }
      "=" _ "by" { (inclusion).commutes N.Nat^::zero ((Degree.homotopyMap).apply x) }
    });
