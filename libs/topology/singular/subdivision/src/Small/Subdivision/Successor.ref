\use std.Logic[].Equality[].eq_reason_in;
\import \parent.At[n := n] \as Lower;
\import \parent.At[n := N.Nat^::succ n] \as Higher;
\import \parent.\parent.At[n := n] \as SmallDegree;
\import \parent.\parent.At[n := N.Nat^::succ n] \as SmallHigher;
\import \parent.\parent.At[n := N.Nat^::succ (N.Nat^::succ n)] \as SmallNext;
\definition commutes: \forall (x: Carrier (N.Nat^::succ n)) -> (complex.differential).apply n ((Higher.map).apply x) = (Lower.map).apply ((complex.differential).apply n x) :=
  \fun (x: Carrier (N.Nat^::succ n)) => SmallDegree.injective _ _
    (eq_reason_in!{{Whole.Carrier n} _
      "=" _ "by" { sym!{{Whole.Carrier n}} _ _ ((inclusion).commutes n ((Higher.map).apply x)) }
      "=" _ "by" { congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier n}} ((Whole.boundary n).apply) _ _ (Higher.Inclusion[].law x) }
      "=" _ "by" { (WholeSubdivision.chainMap).commutes n ((SmallHigher.inclusion).apply x) }
      "=" _ "by" { congr!{{Whole.Carrier n} {Whole.Carrier n}} ((WholeSubdivision.At[n := n].map).apply) _ _ ((inclusion).commutes n x) }
      "=" _ "by" { sym!{{Whole.Carrier n}} _ _ (Lower.Inclusion[].law ((complex.differential).apply n x)) }
    });
\import Modules.Laws[V := Carrier (N.Nat^::succ n), space := space (N.Nat^::succ n)] \as Values;
\import Modules.Laws[V := Whole.Carrier (N.Nat^::succ n), space := Whole.space (N.Nat^::succ n)] \as WholeValues;
\import Modules.Hom[V := Carrier (N.Nat^::succ n), W := Whole.Carrier (N.Nat^::succ n), source := space (N.Nat^::succ n), target := Whole.space (N.Nat^::succ n)] \as Linear;
\definition difference: \forall (x: Carrier (N.Nat^::succ n)) -> (SmallHigher.inclusion).apply (Values.add ((Higher.map).apply x) (Values.neg x)) =
  WholeValues.add ((WholeSubdivision.At[n := N.Nat^::succ n].map).apply ((SmallHigher.inclusion).apply x)) (WholeValues.neg ((SmallHigher.inclusion).apply x)) :=
  \fun (x: Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _ ((SmallHigher.inclusion).addition _ _)
    (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)}} WholeValues.add _ _ _ _
      (Higher.Inclusion[].law x) (Linear.negativePreserved SmallHigher.inclusion x));
\definition boundary: \forall (x: Carrier (N.Nat^::succ n)) -> (SmallHigher.inclusion).apply
  (Values.add ((complex.differential).apply (N.Nat^::succ n) ((Higher.homotopyMap).apply x)) ((Lower.homotopyMap).apply ((complex.differential).apply n x))) =
  WholeValues.add ((Whole.boundary (N.Nat^::succ n)).apply ((WholeSubdivision.At[n := N.Nat^::succ n].homotopyMap).apply ((SmallHigher.inclusion).apply x)))
    ((WholeSubdivision.At[n := n].homotopyMap).apply ((Whole.boundary n).apply ((SmallHigher.inclusion).apply x))) :=
  \fun (x: Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _ ((SmallHigher.inclusion).addition _ _)
    (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)}} WholeValues.add _ _ _ _
      (trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _ (sym!{{Whole.Carrier (N.Nat^::succ n)}} _ _ ((inclusion).commutes (N.Nat^::succ n) ((Higher.homotopyMap).apply x)))
        (congr!{{Whole.Carrier (N.Nat^::succ (N.Nat^::succ n))} {Whole.Carrier (N.Nat^::succ n)}} ((Whole.boundary (N.Nat^::succ n)).apply) _ _ (Higher.Inclusion[].homotopyLaw x)))
      (trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _ (Lower.Inclusion[].homotopyLaw ((complex.differential).apply n x))
        (congr!{{Whole.Carrier n} {Whole.Carrier (N.Nat^::succ n)}} ((WholeSubdivision.At[n := n].homotopyMap).apply) _ _ (sym!{{Whole.Carrier n}} _ _ ((inclusion).commutes n x)))));
\definition law: \forall (x: Carrier (N.Nat^::succ n)) -> Values.add ((Higher.map).apply x) (Values.neg x) =
  Values.add ((complex.differential).apply (N.Nat^::succ n) ((Higher.homotopyMap).apply x)) ((Lower.homotopyMap).apply ((complex.differential).apply n x)) :=
  \fun (x: Carrier (N.Nat^::succ n)) => SmallHigher.injective _ _ (eq_reason_in!{{Whole.Carrier (N.Nat^::succ n)} _
    "=" _ "by" { difference x }
    "=" _ "by" { WholeSubdivision.Successor[n := n].Equation[].law ((SmallHigher.inclusion).apply x) }
    "=" _ "by" { sym!{{Whole.Carrier (N.Nat^::succ n)}} _ _ (boundary x) }
  });
