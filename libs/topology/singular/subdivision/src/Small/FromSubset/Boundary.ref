\use std.Logic[].Equality[].eq_reason_in;
\import \parent.At[n := n] \as Lower;
\import \parent.At[n := N.Nat^::succ n] \as Higher;
\import \parent.\parent.At[n := n] \as SmallDegree;
\definition commutes: \forall (x: SubspaceChains.Carrier (N.Nat^::succ n)) -> (complex.differential).apply n ((Higher.map).apply x) = (Lower.map).apply ((SubspaceChains.boundary n).apply x) :=
  \fun (x: SubspaceChains.Carrier (N.Nat^::succ n)) => SmallDegree.injective _ _
    (eq_reason_in!{{Whole.Carrier n} _
      "=" _ "by" { sym!{{Whole.Carrier n}} _ _ ((inclusion).commutes n ((Higher.map).apply x)) }
      "=" _ "by" { congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier n}} ((Whole.boundary n).apply) _ _ (Higher.law x) }
      "=" _ "by" { (Inclusion.push inclusionFunction continuous).commutes n x }
      "=" _ "by" { sym!{{Whole.Carrier n}} _ _ (Lower.law ((SubspaceChains.boundary n).apply x)) }
    });
