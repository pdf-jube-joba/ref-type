\import \parent.At[m := m] \as Evaluation;
\import \root.SimplexChains[n := m] \as Source;
\import Source.Fundamental[] \as Fundamental;
\import Source.Postcompose[k := n] \as Postcompose;
\import singular_cohomology.OrderedTuples[V := Simplex.Carrier m] \as SourceTuples;
\import SourceTuples.Mapping[W := Points] \as TupleMaps;
\import Simplex.Affine[m := m, n := n] \as Affine;
\import Simplex.AffineVertex[m := m, n := n] \as Vertex;
\import Tuples.Subdivision[centres := centres] \as Subdivision;
\import \root.Subdivision[A := Points, source := Space.topology] \as Native;
\import Native.At[n := m] \as NativeDegree;
\definition basisTuple: \forall (v: Affine.Vertices) -> TupleMaps.onTuple (N.Nat^::succ m) (Postcompose.transform v) Fundamental.vertices = v :=
  \fun (v: Affine.Vertices) => \axiom:funext(TupleMaps.onTuple (N.Nat^::succ m) (Postcompose.transform v) Fundamental.vertices, v, Vertex.law v);
\definition basisImage: \forall (v: Affine.Vertices) -> (TupleMaps.push (N.Nat^::succ m) (Postcompose.transform v)).apply Fundamental.base = Tuples.generator (N.Nat^::succ m) v :=
  \fun (v: Affine.Vertices) => trans!{{Tuples.Carrier (N.Nat^::succ m)}} _ _ _ (TupleMaps.At[n := N.Nat^::succ m].onGenerator (Postcompose.transform v) Fundamental.vertices)
    (congr!{{Tuples.Tuple (N.Nat^::succ m)} {Tuples.Carrier (N.Nat^::succ m)}} (Tuples.generator (N.Nat^::succ m)) _ _ (basisTuple v));
\definition simplex: \forall (v: Affine.Vertices) -> (Evaluation.map).apply ((Subdivision.map (N.Nat^::succ m)).apply (Tuples.generator (N.Nat^::succ m) v)) = NativeDegree.onSimplex (Evaluation.onTuple v) :=
  \fun (v: Affine.Vertices) => trans!{{Chains.Carrier m}} _ _ _
    (congr!{{Tuples.Carrier (N.Nat^::succ m)} {Chains.Carrier m}} (\fun (x: Tuples.Carrier (N.Nat^::succ m)) => (Evaluation.map).apply ((Subdivision.map (N.Nat^::succ m)).apply x)) _ _ (sym!{{Tuples.Carrier (N.Nat^::succ m)}} _ _ (basisImage v)))
    (Postcompose.Operations[m := m].subdivision v Fundamental.base);
\definition onGenerator: \forall (v: Affine.Vertices) -> (Evaluation.map).apply ((Subdivision.map (N.Nat^::succ m)).apply (Tuples.generator (N.Nat^::succ m) v)) = (NativeDegree.map).apply ((Evaluation.map).apply (Tuples.generator (N.Nat^::succ m) v)) :=
  \fun (v: Affine.Vertices) => trans!{{Chains.Carrier m}} _ _ _ (simplex v)
    (trans!{{Chains.Carrier m}} _ _ _ (sym!{{Chains.Carrier m}} _ _ (NativeDegree.onGenerator (Evaluation.onTuple v)))
      (congr!{{Chains.Carrier m} {Chains.Carrier m}} ((NativeDegree.map).apply) _ _ (sym!{{Chains.Carrier m}} _ _ (Evaluation.onGenerator v))));
\import Modules.Hom[V := Tuples.Carrier (N.Nat^::succ m), W := Chains.Carrier m, source := Tuples.space (N.Nat^::succ m), target := Chains.space m].Composition[U := Tuples.Carrier (N.Nat^::succ m), domain := Tuples.space (N.Nat^::succ m)] \as First;
\import Modules.Hom[V := Chains.Carrier m, W := Chains.Carrier m, source := Chains.space m, target := Chains.space m].Composition[U := Tuples.Carrier (N.Nat^::succ m), domain := Tuples.space (N.Nat^::succ m)] \as Second;
\import Modules.Free[Generators := Tuples.Tuple (N.Nat^::succ m)].To[W := Chains.Carrier m, target := Chains.space m] \as Free;
\definition equation: First.compose Evaluation.map (Subdivision.map (N.Nat^::succ m)) = Second.compose NativeDegree.map Evaluation.map := Free.ext _ _ onGenerator;
\import Modules.Hom[V := Tuples.Carrier (N.Nat^::succ m), W := Chains.Carrier m, source := Tuples.space (N.Nat^::succ m), target := Chains.space m] \as Linear;
\definition law: \forall (x: Tuples.Carrier (N.Nat^::succ m)) -> (Evaluation.map).apply ((Subdivision.map (N.Nat^::succ m)).apply x) = (NativeDegree.map).apply ((Evaluation.map).apply x) :=
  \fun (x: Tuples.Carrier (N.Nat^::succ m)) => congr!{Linear.Map {Chains.Carrier m}} (\fun (f: Linear.Map) => (f).apply x) _ _ equation;
