\use Equality.eq_reason;
\import \parent.At[m := m] \as Lower;
\import \parent.At[m := N.Nat^::succ m] \as Higher;
\import \parent.Faces[m := m] \as Faces;
\import Tuples.Boundary[n := N.Nat^::succ m] \as SourceBoundary;
\import Chains.Boundary[n := m] \as TargetBoundary;
\import Modules.Alternating[V := Chains.Carrier m, space := Chains.space m] \as Sum;
\import Modules.Alternating[V := Tuples.Carrier (N.Nat^::succ m), space := Tuples.space (N.Nat^::succ m)].Mapping[W := Chains.Carrier m, target := Chains.space m] \as Mapping;
\import Modules.Hom[V := Chains.Carrier (N.Nat^::succ m), W := Chains.Carrier m, source := Chains.space (N.Nat^::succ m), target := Chains.space m]
  .Composition[U := Tuples.Carrier (N.Nat^::succ (N.Nat^::succ m)), domain := Tuples.space (N.Nat^::succ (N.Nat^::succ m))] \as First;
\import Modules.Hom[V := Tuples.Carrier (N.Nat^::succ m), W := Chains.Carrier m, source := Tuples.space (N.Nat^::succ m), target := Chains.space m]
  .Composition[U := Tuples.Carrier (N.Nat^::succ (N.Nat^::succ m)), domain := Tuples.space (N.Nat^::succ (N.Nat^::succ m))] \as Second;
\import Modules.Free[Generators := Tuples.Tuple (N.Nat^::succ (N.Nat^::succ m))].To[W := Chains.Carrier m, target := Chains.space m] \as Free;
\definition onGenerator: \forall (v: Tuples.Tuple (N.Nat^::succ (N.Nat^::succ m))) ->
  (Second.compose Lower.map (Tuples.boundary (N.Nat^::succ m))).apply (Tuples.generator (N.Nat^::succ (N.Nat^::succ m)) v) =
    (First.compose (Chains.boundary m) Higher.map).apply (Tuples.generator (N.Nat^::succ (N.Nat^::succ m)) v) :=
  \fun (v: Tuples.Tuple (N.Nat^::succ (N.Nat^::succ m))) => eq_reason!{
    {(Lower.map).apply ((Tuples.boundary (N.Nat^::succ m)).apply (Tuples.generator (N.Nat^::succ (N.Nat^::succ m)) v))}
    "=" {(Lower.map).apply (SourceBoundary.value v)} "by" {
      congr!{{Tuples.Carrier (N.Nat^::succ m)} {Chains.Carrier m}} ((Lower.map).apply) _ _ (SourceBoundary.onGenerator v)}
    "=" {Sum.sum (N.Nat^::succ (N.Nat^::succ m)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ m))) => (Lower.map).apply (Tuples.generator (N.Nat^::succ m) (Omission.omit (N.Nat^::succ m) i v)))} "by" {
      Mapping.law Lower.map (N.Nat^::succ (N.Nat^::succ m)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ m))) => Tuples.generator (N.Nat^::succ m) (Omission.omit (N.Nat^::succ m) i v))}
    "=" {TargetBoundary.onSimplex (Higher.onTuple v)} "by" {
      Sum.congruent (N.Nat^::succ (N.Nat^::succ m)) _ _ (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ m))) => trans!{{Chains.Carrier m}} _ _ _
        (Lower.onGenerator (Omission.omit (N.Nat^::succ m) i v))
        (congr!{{Simplices.Carrier m} {Chains.Carrier m}} (Chains.generator m) _ _ (sym!{{Simplices.Carrier m}} _ _ (Faces.law v i))))}
    "=" {(Chains.boundary m).apply (Chains.generator (N.Nat^::succ m) (Higher.onTuple v))} "by" {sym!{{Chains.Carrier m}} _ _ (TargetBoundary.onGenerator (Higher.onTuple v))}
    "=" {(Chains.boundary m).apply ((Higher.map).apply (Tuples.generator (N.Nat^::succ (N.Nat^::succ m)) v))} "by" {
      congr!{{Chains.Carrier (N.Nat^::succ m)} {Chains.Carrier m}} ((Chains.boundary m).apply) _ _ (sym!{{Chains.Carrier (N.Nat^::succ m)}} _ _ (Higher.onGenerator v))}
  };
\definition equation: First.compose (Chains.boundary m) Higher.map = Second.compose Lower.map (Tuples.boundary (N.Nat^::succ m)) :=
  Free.ext _ _ (\fun (v: Tuples.Tuple (N.Nat^::succ (N.Nat^::succ m))) => sym!{{Chains.Carrier m}} _ _ (onGenerator v));
\import Modules.Hom[V := Tuples.Carrier (N.Nat^::succ (N.Nat^::succ m)), W := Chains.Carrier m, source := Tuples.space (N.Nat^::succ (N.Nat^::succ m)), target := Chains.space m] \as Maps;
\definition commutes: \forall (x: Tuples.Carrier (N.Nat^::succ (N.Nat^::succ m))) -> (Chains.boundary m).apply ((Higher.map).apply x) = (Lower.map).apply ((Tuples.boundary (N.Nat^::succ m)).apply x) :=
  \fun (x: Tuples.Carrier (N.Nat^::succ (N.Nat^::succ m))) => congr!{Maps.Map {Chains.Carrier m}} (\fun (f: Maps.Map) => (f).apply x) _ _ equation;
