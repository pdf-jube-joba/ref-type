\import \root.SimplexChains[n := N.Nat^::succ n] \as Higher;
\import Simplex.At[n := N.Nat^::succ n] \as HigherSpace;
\import \parent.Fundamental[] \as Fundamental;
\import Higher.Fundamental[] \as HigherFundamental;
\import \parent.Subdivision[] \as Subdivision;
\import Higher.Subdivision[] \as HigherSubdivision;
\import \parent.Postcompose[k := N.Nat^::succ n] \as Push;
\import Simplex.AffineFace[n := n] \as Affine;
\import Simplex.AffineVertex[m := n, n := N.Nat^::succ n] \as Vertex;
\import singular_cohomology.OrderedTuples[V := Higher.Points] \as HigherTuples;
\import singular_cohomology.Chains[A := Higher.Points, source := HigherSpace.topology] \as HigherChains;
\import Tuples.Mapping[W := Higher.Points] \as TupleMap;
\import HigherTuples.Subdivision[centres := Higher.centres] \as HigherRaw;
\import HigherRaw.Homotopy[] \as HigherHomotopy;
\import Higher.At[m := n] \as Evaluation;
\import Higher.At[m := N.Nat^::succ n] \as HigherEvaluation;
\import singular_cohomology.Maps[A := Points, B := Higher.Points, source := Space.topology, target := HigherSpace.topology] \as Maps;
\definition transform: Points -> Higher.Points := Push.transform (Affine.vertices i);
\definition continuous: Maps.Continuous transform := Push.continuous (Affine.vertices i);
\definition vertices: TupleMap.onTuple (N.Nat^::succ n) transform Fundamental.vertices = Affine.vertices i :=
  \axiom:funext(TupleMap.onTuple (N.Nat^::succ n) transform Fundamental.vertices, Affine.vertices i, Vertex.law (Affine.vertices i));
\definition tuple: (TupleMap.push (N.Nat^::succ n) transform).apply Fundamental.base = HigherTuples.generator (N.Nat^::succ n) (Affine.vertices i) :=
  trans!{{HigherTuples.Carrier (N.Nat^::succ n)}} _ _ _ (TupleMap.At[n := N.Nat^::succ n].onGenerator transform Fundamental.vertices)
    (congr!{{HigherTuples.Tuple (N.Nat^::succ n)} {HigherTuples.Carrier (N.Nat^::succ n)}} (HigherTuples.generator (N.Nat^::succ n)) _ _ vertices);
\definition subdivisionTerm: HigherChains.Carrier n := (Evaluation.map).apply ((HigherRaw.map (N.Nat^::succ n)).apply (HigherTuples.generator (N.Nat^::succ n) (Affine.vertices i)));
\definition subdivision: subdivisionTerm = (Maps.At[n := n].push transform continuous).apply Subdivision.chain :=
  trans!{{HigherChains.Carrier n}} _ _ _
    (congr!{{HigherTuples.Carrier (N.Nat^::succ n)} {HigherChains.Carrier n}}
      (\fun (x: HigherTuples.Carrier (N.Nat^::succ n)) => (Evaluation.map).apply ((HigherRaw.map (N.Nat^::succ n)).apply x)) _ _
      (sym!{{HigherTuples.Carrier (N.Nat^::succ n)}} _ _ tuple))
    (Push.Operations[m := n].subdivision (Affine.vertices i) Fundamental.base);
\definition homotopy: HigherSubdivision.faceTerm i = (Maps.At[n := N.Nat^::succ n].push transform continuous).apply Subdivision.homotopy :=
  trans!{{HigherChains.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{HigherTuples.Carrier (N.Nat^::succ n)} {HigherChains.Carrier (N.Nat^::succ n)}}
      (\fun (x: HigherTuples.Carrier (N.Nat^::succ n)) => (HigherEvaluation.map).apply ((HigherHomotopy.map (N.Nat^::succ n)).apply x)) _ _
      (sym!{{HigherTuples.Carrier (N.Nat^::succ n)}} _ _ tuple))
    (Push.Operations[m := n].homotopy (Affine.vertices i) Fundamental.base);
