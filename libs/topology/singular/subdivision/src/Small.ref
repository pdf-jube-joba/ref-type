\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import algebraic_topology.Semisimplicial[] \as Semisimplicial;
\import algebraic_topology.Simplex[] \as Simplex;
\import singular_cohomology.Simplices[A := A, source := source] \as WholeSimplices;
\import singular_cohomology.Chains[A := A, source := source] \as Whole;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\module Simplices;
\import singular_cohomology.SimplicialChains[].On[X := Simplices[].object] \as Native;
\definition Carrier[n: N.Nat^]: \Set := Native.Carrier n;
\definition space[n: N.Nat^]: Modules.Space (Carrier n) := Native.space n;
\definition generator[n: N.Nat^]: Simplices[].Carrier n -> Carrier n := Native.generator n;
\definition complex: Complexes.Complex := Native.complex;
\import Semisimplicial.Maps[X := Simplices[].object, Y := WholeSimplices.object] \as Maps;
\definition simplicialInclusion: Maps.Map := Maps.Map {
  apply := \fun (n: N.Nat^)(sigma: Simplices[].Carrier n) => sigma,
  faces := \fun (n: N.Nat^)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(sigma: Simplices[].Carrier (N.Nat^::succ n)) => \refl(WholeSimplices.face n i sigma),
};
\import Native.Mapping[Y := WholeSimplices.object] \as Mapping;
\definition inclusion: Complexes.Map[C := Native.complex, D := Whole.complex].Map := Mapping.map simplicialInclusion;
\module At(n: N.Nat^);
\module With(coefficients: Modules.Bundle);
\module FromSubset(U: \Cast[\Pow A] family);
\module Subdivision;
\module Cover(n: N.Nat^);
\module Persistence(n: N.Nat^);
\module HomotopyPersistence(n: N.Nat^);
\module Pullback(B: \Set) {
  \import topology.Topology[Carrier := B] \as DomainTopology;
  \module Over(topology: DomainTopology.Topology, f: B -> A);
}
