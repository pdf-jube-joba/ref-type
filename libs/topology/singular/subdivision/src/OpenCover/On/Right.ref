\import Complexes.Homotopy[C := Whole.complex, D := Whole.complex] \as Native;
\import Complexes.Map[C := Small.complex, D := Whole.complex].Composition[B := Whole.complex] \as Composition;
\import Complexes.End[C := Whole.complex] \as Identity;
\definition data: Native.Data := Native.Data { apply := \fun (n: N.Nat^) => (homotopyMap n).apply };
\module Arithmetic(n: N.Nat^);
\module Zero;
\module Positive(n: N.Nat^);
\definition laws: Native.Laws[Composition.compose Small.inclusion retraction, Identity.identity, data] := Native.Laws[Composition.compose Small.inclusion retraction, Identity.identity, data] {
  addition := \fun (n: N.Nat^) => (homotopyMap n).addition,
  scalar := \fun (n: N.Nat^) => (homotopyMap n).scalar,
  zeroEquation := Zero[].law,
  successorEquation := \fun (n: N.Nat^) => Positive[n := n].law,
};
