\import \parent.Degree[n := n] \as Lower;
\import \parent.Degree[n := N.Nat^::succ n] \as Higher;
\import \parent.Compared[n := n] \as LowerCompared;
\import \parent.Compared[n := N.Nat^::succ n] \as HigherCompared;
\import \parent.CandidateBoundary[n := n] \as Candidate;
\import Small.At[n := n] \as SmallLower;
\definition law: \forall (x: Whole.Carrier (N.Nat^::succ n)) -> (Small.complex.differential).apply n ((Higher.retraction).apply x) = (Lower.retraction).apply ((Whole.boundary n).apply x) :=
  \fun (x: Whole.Carrier (N.Nat^::succ n)) => SmallLower.injective _ _
    (trans!{{Whole.Carrier n}} _ _ _ (sym!{{Whole.Carrier n}} _ _ ((Small.inclusion).commutes n ((Higher.retraction).apply x)))
      (trans!{{Whole.Carrier n}} _ _ _ (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier n}} ((Whole.boundary n).apply) _ _ (HigherCompared.included x))
        (trans!{{Whole.Carrier n}} _ _ _ (Candidate.law x) (sym!{{Whole.Carrier n}} _ _ (LowerCompared.included ((Whole.boundary n).apply x))))));
