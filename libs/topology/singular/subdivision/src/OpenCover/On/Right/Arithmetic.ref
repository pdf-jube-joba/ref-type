\import Modules.Laws[V := Whole.Carrier n, space := Whole.space n] \as Values;
\import algebra.Group[].Of[Carrier := Whole.Carrier n, group := Values.additive] \as Group;
\definition differenceSum: \forall (x, y: Whole.Carrier n) -> Group.difference (Values.add x y) x = y :=
  \fun (x, y: Whole.Carrier n) => Group.cancelRight x (Group.difference (Values.add x y) x) y
    (trans!{{Whole.Carrier n}} _ _ _ (Group.addDifference (Values.add x y) x) (Group.comm x y));
