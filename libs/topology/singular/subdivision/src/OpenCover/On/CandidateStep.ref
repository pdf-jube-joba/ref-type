\import \parent.Terms[n := N.Nat^::succ n] \as Terms;
\import Modules.Hom[V := Whole.Carrier (N.Nat^::succ n), W := Whole.Carrier (N.Nat^::succ n), source := Whole.space (N.Nat^::succ n), target := Whole.space (N.Nat^::succ n)] \as Linear;
\import Modules.End[V := Whole.Carrier (N.Nat^::succ n), space := Whole.space (N.Nat^::succ n)] \as Identity;
\import Modules.Hom[V := Whole.Carrier (N.Nat^::succ (N.Nat^::succ n)), W := Whole.Carrier (N.Nat^::succ n), source := Whole.space (N.Nat^::succ (N.Nat^::succ n)), target := Whole.space (N.Nat^::succ n)].Composition[U := Whole.Carrier (N.Nat^::succ n), domain := Whole.space (N.Nat^::succ n)] \as First;
\import Modules.Hom[V := Whole.Carrier n, W := Whole.Carrier (N.Nat^::succ n), source := Whole.space n, target := Whole.space (N.Nat^::succ n)].Composition[U := Whole.Carrier (N.Nat^::succ n), domain := Whole.space (N.Nat^::succ n)] \as Second;
\definition boundary: Linear.Map := First.compose (Whole.boundary (N.Nat^::succ n)) (homotopyMap (N.Nat^::succ n));
\definition prior: Linear.Map := Second.compose (homotopyMap n) (Whole.boundary n);
\definition map: Terms.EndMap := Linear.plus Identity.identity (Linear.plus boundary prior);
