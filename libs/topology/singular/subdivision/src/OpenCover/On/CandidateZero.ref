\import \parent.Terms[n := N.Nat^::zero] \as Terms;
\import Modules.Hom[V := Whole.Carrier N.Nat^::zero, W := Whole.Carrier N.Nat^::zero, source := Whole.space N.Nat^::zero, target := Whole.space N.Nat^::zero] \as Linear;
\import Modules.End[V := Whole.Carrier N.Nat^::zero, space := Whole.space N.Nat^::zero] \as Identity;
\import Modules.Hom[V := Whole.Carrier (N.Nat^::succ N.Nat^::zero), W := Whole.Carrier N.Nat^::zero, source := Whole.space (N.Nat^::succ N.Nat^::zero), target := Whole.space N.Nat^::zero].Composition[U := Whole.Carrier N.Nat^::zero, domain := Whole.space N.Nat^::zero] \as Composition;
\definition boundary: Linear.Map := Composition.compose (Whole.boundary N.Nat^::zero) (homotopyMap N.Nat^::zero);
\definition map: Terms.EndMap := Linear.plus Identity.identity boundary;
