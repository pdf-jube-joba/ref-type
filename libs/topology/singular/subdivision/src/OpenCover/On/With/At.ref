\import Cochains.At[C := WholeCochains.complex, k := n] \as WholeH;
\import Cochains.At[C := SmallCochains.complex, k := n] \as SmallH;
\import Comparison.At[k := n] \as Native;
\import Modules.Isomorphism[V := WholeH.Cohomology, W := SmallH.Cohomology, source := WholeH.cohomologySpace, target := SmallH.cohomologySpace] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := (Native.isomorphism equivalence).backward,
  backward := (Native.isomorphism equivalence).forward,
  leftInverse := (Native.isomorphism equivalence).rightInverse,
  rightInverse := (Native.isomorphism equivalence).leftInverse,
};
\import Cochains.Map[C := WholeCochains.complex, D := SmallCochains.complex].At[k := n] \as Maps;
\definition restrictionIsomorphism: (isomorphism).forward = Maps.induced restriction := \refl(Maps.induced restriction);
