\import Cochains.Homotopy[C := SmallCochains.complex, D := SmallCochains.complex] \as SmallHomotopy;
\import Cochains.Homotopy[C := WholeCochains.complex, D := WholeCochains.complex] \as WholeHomotopy;
\import Cochains.Map[C := WholeCochains.complex, D := SmallCochains.complex].Composition[B := SmallCochains.complex] \as SmallComposition;
\import Cochains.Map[C := SmallCochains.complex, D := WholeCochains.complex].Composition[B := WholeCochains.complex] \as WholeComposition;
\import Cochains.End[C := SmallCochains.complex] \as SmallIdentity;
\import Cochains.End[C := WholeCochains.complex] \as WholeIdentity;
\definition small: SmallHomotopy.Homotopy (SmallComposition.compose restriction extension) SmallIdentity.identity := Lift.leftHomotopy;
\definition whole: WholeHomotopy.Homotopy (WholeComposition.compose extension restriction) WholeIdentity.identity := Lift.rightHomotopy;
