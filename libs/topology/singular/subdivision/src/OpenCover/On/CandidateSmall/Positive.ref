\import Small.At[n := N.Nat^::succ n] \as Degree;
\import \parent.At[n := N.Nat^::succ n] \as Statement;
\import Modules.Laws[V := Whole.Carrier (N.Nat^::succ n), space := Whole.space (N.Nat^::succ n)] \as Values;
\import algebra.Group[].Of[Carrier := Whole.Carrier (N.Nat^::succ n), group := Values.additive] \as Group;
\import Modules.Hom[V := Whole.Carrier (N.Nat^::succ (N.Nat^::succ n)), W := Whole.Carrier (N.Nat^::succ n), source := Whole.space (N.Nat^::succ (N.Nat^::succ n)), target := Whole.space (N.Nat^::succ n)] \as Boundary;
\definition delta: \forall (x: Small.Carrier (N.Nat^::succ n)) -> (Whole.boundary (N.Nat^::succ n)).apply ((homotopyMap (N.Nat^::succ n)).apply ((Degree.inclusion).apply x)) = Values.zero :=
  \fun (x: Small.Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{Whole.Carrier (N.Nat^::succ (N.Nat^::succ n))} {Whole.Carrier (N.Nat^::succ n)}} ((Whole.boundary (N.Nat^::succ n)).apply) _ _ (smallZero (N.Nat^::succ n) x)) (Boundary.zeroPreserved (Whole.boundary (N.Nat^::succ n)));
\definition prior: \forall (x: Small.Carrier (N.Nat^::succ n)) -> (homotopyMap n).apply ((Whole.boundary n).apply ((Degree.inclusion).apply x)) = Values.zero :=
  \fun (x: Small.Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{Whole.Carrier n} {Whole.Carrier (N.Nat^::succ n)}} ((homotopyMap n).apply) _ _ ((Small.inclusion).commutes n x))
    (smallZero n ((Small.complex.differential).apply n x));
\definition law: Statement.Statement := \fun (x: Small.Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _
  (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)}} (Values.add ((Degree.inclusion).apply x)) _ _
    (trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _ (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)}} Values.add _ _ _ _ (delta x) (prior x)) (Group.zeroLeft Values.zero)))
  (Group.zeroRight ((Degree.inclusion).apply x));
