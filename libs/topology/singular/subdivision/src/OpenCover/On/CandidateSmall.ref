\module At(n: N.Nat^) {
  \import Small.At[n := n] \as Degree;
  \definition Statement: \Prop := \forall (x: Small.Carrier n) -> (candidateMap n).apply ((Degree.inclusion).apply x) = (Degree.inclusion).apply x;
}
\module Zero;
\module Positive(n: N.Nat^);
\definition law: \forall (n: N.Nat^) -> At[n := n].Statement := \induction (n: N.Nat^) \return At[n := n].Statement \with {
  | zero: Zero[].law
  | succ: \fun (n: N.Nat^)(previous: At[n := n].Statement) => Positive[n := n].law
};
