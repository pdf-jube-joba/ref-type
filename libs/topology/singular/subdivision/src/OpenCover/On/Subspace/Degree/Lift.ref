\import SubspaceSmall.Simplices[] \as Domain;
\import Small.Simplices[] \as Codomain;
\import singular_cohomology.Simplices[A := Carrier, source := Space.topology source] \as WholeDomain;
\import singular_cohomology.Simplices[A := A, source := source] \as WholeCodomain;
\import algebraic_topology.Simplex[] \as Simplex;
\definition Contained[sigma: Codomain.Carrier n]: \Prop := \forall (x: Simplex.Carrier n) -> \In[A] subset (sigma x);
\definition function[sigma: Codomain.Carrier n][contained: Contained sigma][x: Simplex.Carrier n]: Carrier :=
  \into[A](sigma x, subset) \by { contained x };
\import topology.Continuity[A := Simplex.Carrier n, B := A].Corestriction[S := subset] \as Corestriction;
\import Simplex.At[n := n] \as SimplexSpace;
\definition simplex[sigma: Codomain.Carrier n][contained: Contained sigma]: WholeDomain.Carrier n :=
  \into[WholeDomain.At[n := n].Function](function sigma contained, WholeDomain.Carrier n) \by {
    Corestriction.corestrictContinuous SimplexSpace.topology source (function sigma contained) (WholeCodomain.At[n := n].continuous sigma)
  };
\import topology.Maps[A := Carrier, B := A] \as Sets;
\definition small: \forall (sigma: Codomain.Carrier n)(contained: Contained sigma) ->
  \In[WholeDomain.Carrier n] (Domain.Small n) (simplex sigma contained) := \block {
  \fun (sigma: Codomain.Carrier n)(contained: Contained sigma) \then
  \takefrom w: Codomain.Witness[n, sigma] \by Codomain.witness n sigma \then
  \return \exact(Domain.Witness[n, simplex sigma contained] {
    element := Sets.Preimage inclusion ((w).element),
    member := Sets.pullbackMember inclusion (Covers.family cover) ((w).element) ((w).member),
    contained := \fun (x: Simplex.Carrier n) => (w).contained x,
  }, Domain.Witness[n, simplex sigma contained])
};
\definition lift[sigma: Codomain.Carrier n][contained: Contained sigma]: Domain.Carrier n :=
  \into[WholeDomain.Carrier n](simplex sigma contained, Domain.Small n) \by { small sigma contained };
\definition law: \forall (sigma: Codomain.Carrier n)(contained: Contained sigma) -> Pullback.At[n := n].postcompose continuous (lift sigma contained) = sigma :=
  \fun (sigma: Codomain.Carrier n)(contained: Contained sigma) => \axiom:funext(Pullback.At[n := n].postcompose continuous (lift sigma contained), sigma,
    \fun (x: Simplex.Carrier n) => \refl(sigma x));
