\use std.Logic[].Equality[].eq_reason_in;
\import \parent.CandidateStep[n := n] \as Higher;
\import \parent.Boundaries[] \as Boundaries;
\import Modules.Laws[V := Whole.Carrier n, space := Whole.space n] \as Values;
\import Modules.Laws[V := Whole.Carrier (N.Nat^::succ n), space := Whole.space (N.Nat^::succ n)] \as HigherValues;
\import algebra.Group[].Of[Carrier := Whole.Carrier n, group := Values.additive] \as Group;
\definition expanded: \forall (x: Whole.Carrier (N.Nat^::succ n)) -> (Whole.boundary n).apply ((candidateMap (N.Nat^::succ n)).apply x) =
  Values.add ((Whole.boundary n).apply x) (Values.add ((Whole.boundary n).apply ((Higher.boundary).apply x)) ((Whole.boundary n).apply ((Higher.prior).apply x))) :=
  \fun (x: Whole.Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier n}} _ _ _
    ((Whole.boundary n).addition x (HigherValues.add ((Higher.boundary).apply x) ((Higher.prior).apply x)))
    (congr!{{Whole.Carrier n} {Whole.Carrier n}} (Values.add ((Whole.boundary n).apply x)) _ _ ((Whole.boundary n).addition ((Higher.boundary).apply x) ((Higher.prior).apply x)));
\definition law: \forall (x: Whole.Carrier (N.Nat^::succ n)) -> (Whole.boundary n).apply ((candidateMap (N.Nat^::succ n)).apply x) = (candidateMap n).apply ((Whole.boundary n).apply x) :=
  \fun (x: Whole.Carrier (N.Nat^::succ n)) => eq_reason_in!{{Whole.Carrier n} _
    "=" _ "by" { expanded x }
    "=" _ "by" { congr!{{Whole.Carrier n} {Whole.Carrier n}} (Values.add ((Whole.boundary n).apply x)) _ _
        (trans!{{Whole.Carrier n}} _ _ _ (congr!{{Whole.Carrier n} {Whole.Carrier n}} (\fun (z: Whole.Carrier n) => Values.add z ((Whole.boundary n).apply ((Higher.prior).apply x))) _ _
          (Whole.SquareZero[n := n].all ((homotopyMap (N.Nat^::succ n)).apply x)))
          (Group.zeroLeft ((Whole.boundary n).apply ((Higher.prior).apply x)))) }
    "=" _ "by" { sym!{{Whole.Carrier n}} _ _ (Boundaries.law n x) }
  };
