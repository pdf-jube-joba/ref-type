\import Modules.Hom[V := Whole.Carrier n, W := Whole.Carrier (N.Nat^::succ n), source := Whole.space n, target := Whole.space (N.Nat^::succ n)] \as Shift;
\import Modules.Hom[V := Whole.Carrier n, W := Whole.Carrier n, source := Whole.space n, target := Whole.space n] \as End;
\definition Map: \Set := Shift.Map;
\definition EndMap: \Set := End.Map;
