\import Cells.Step[n := n] \as CellsStep;
\import Modules.Free[Generators := Cells.Cell n].Reindex[TargetGenerators := Cells.Cell (N.Nat^::succ n)] \as Reindex;
\definition lift[i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))]: Modules.Hom[V := Carrier n, W := Carrier (N.Nat^::succ n), source := space n, target := space (N.Nat^::succ n)].Map := Reindex.push (CellsStep.join i);
\definition onGenerator: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(c: Cells.Cell n) -> (lift i).apply (generator n c) = generator (N.Nat^::succ n) (CellsStep.join i c) :=
  \fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => Reindex.onGenerator (CellsStep.join i);
\import Modules.Alternating[V := Carrier (N.Nat^::succ n), space := space (N.Nat^::succ n)] \as Sum;
\definition boundary[x: Carrier n]: Carrier (N.Nat^::succ n) := Sum.sum (N.Nat^::succ (N.Nat^::succ n))
  (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => (lift i).apply x);
