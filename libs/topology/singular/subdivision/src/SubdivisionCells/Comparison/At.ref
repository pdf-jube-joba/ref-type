\import Simplex.Affine[m := n, n := k] \as Affine;
\import \root.SimplexChains[n := k] \as Geometry;
\import singular_cohomology.OrderedTuples[V := Simplex.Carrier k] \as Tuples;
\import Tuples.Subdivision[centres := Geometry.centres] \as Subdivision;
\import \parent.\parent.Evaluation[n := n, k := k] \as Evaluation;
\definition Equation[v: Affine.Vertices]: \Prop := (Evaluation.map v).apply (chain n) = (Subdivision.map (N.Nat^::succ n)).apply (Tuples.generator (N.Nat^::succ n) v);
