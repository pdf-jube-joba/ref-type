\use std.Logic[].Equality[].eq_reason_in;
\import \parent.At[n := N.Nat^::zero, k := k] \as Degree;
\import \parent.\parent.Evaluation[n := N.Nat^::zero, k := k] \as Evaluation;
\import Simplex.Affine[m := N.Nat^::zero, n := k] \as Affine;
\import Simplex.Barycentre[n := N.Nat^::zero] \as Centre;
\import \root.SimplexChains[n := k] \as Geometry;
\import singular_cohomology.OrderedTuples[V := Simplex.Carrier k] \as Tuples;
\import Tuples.Subdivision[centres := Geometry.centres] \as Subdivision;
\import Subdivision.Homotopy[].Empty[] \as Empty;
\import Fin.Tuples[A := Simplex.Carrier k] \as VertexTuples;
\import VertexTuples.Omission[] \as Omission;
\import Modules.Laws[V := Tuples.Carrier N.Nat^::zero, space := Tuples.space N.Nat^::zero] \as Values;
\import algebra.Group[].Of[Carrier := Tuples.Carrier N.Nat^::zero, group := Values.additive] \as Group;
\definition omitted[v: Affine.Vertices]: Tuples.Tuple N.Nat^::zero := Omission.omit N.Nat^::zero (Fin.zero N.Nat^::zero) v;
\definition boundary: \forall (v: Affine.Vertices) -> (Tuples.boundary N.Nat^::zero).apply (Tuples.generator (N.Nat^::succ N.Nat^::zero) v) = Tuples.generator N.Nat^::zero (omitted v) :=
  \fun (v: Affine.Vertices) => eq_reason_in!{{Tuples.Carrier N.Nat^::zero} _
    "=" _ "by" { Tuples.Boundary[n := N.Nat^::zero].onGenerator v }
    "=" _ "by" { congr!{{Tuples.Carrier N.Nat^::zero} {Tuples.Carrier N.Nat^::zero}} (Values.add (Tuples.generator N.Nat^::zero (omitted v))) _ _ Group.negZero }
    "=" _ "by" { Group.zeroRight (Tuples.generator N.Nat^::zero (omitted v)) }
  };
\definition tuple: \forall (v: Affine.Vertices) -> VertexTuples.extend N.Nat^::zero (Geometry.centres N.Nat^::zero v) (omitted v) = Evaluation.tuple v Cells.base :=
  \fun (v: Affine.Vertices) => \axiom:funext(VertexTuples.extend N.Nat^::zero (Geometry.centres N.Nat^::zero v) (omitted v), Evaluation.tuple v Cells.base,
    \fun (i: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => eq_reason_in!{{Simplex.Carrier k} _
      "=" _ "by" { congr!{{Fin.Fin (N.Nat^::succ N.Nat^::zero)} {Simplex.Carrier k}} (VertexTuples.extend N.Nat^::zero (Geometry.centres N.Nat^::zero v) (omitted v)) _ _ (Fin.singletonValue i) }
      "=" _ "by" { VertexTuples.atZero N.Nat^::zero (Geometry.centres N.Nat^::zero v) (omitted v) }
      "=" _ "by" { congr!{{Simplex.Carrier N.Nat^::zero} {Simplex.Carrier k}} (Affine.apply v) _ _ (Simplex.zeroUnique Centre.point) }
    });
\definition basis: \forall (v: Affine.Vertices) -> (Subdivision.map (N.Nat^::succ N.Nat^::zero)).apply (Tuples.generator (N.Nat^::succ N.Nat^::zero) v) = Tuples.generator (N.Nat^::succ N.Nat^::zero) (Evaluation.tuple v Cells.base) :=
  \fun (v: Affine.Vertices) => eq_reason_in!{{Tuples.Carrier (N.Nat^::succ N.Nat^::zero)} _
    "=" _ "by" { Subdivision.onGenerator (N.Nat^::succ N.Nat^::zero) v }
    "=" _ "by" { congr!{{Tuples.Carrier N.Nat^::zero} {Tuples.Carrier (N.Nat^::succ N.Nat^::zero)}} ((Tuples.cone N.Nat^::zero (Geometry.centres N.Nat^::zero v)).apply) _ _
        (trans!{{Tuples.Carrier N.Nat^::zero}} _ _ _ (Empty.subdivisionIdentity ((Tuples.boundary N.Nat^::zero).apply (Tuples.generator (N.Nat^::succ N.Nat^::zero) v))) (boundary v)) }
    "=" _ "by" { Tuples.Cone[n := N.Nat^::zero].onGenerator (Geometry.centres N.Nat^::zero v) (omitted v) }
    "=" _ "by" { congr!{{Tuples.Tuple (N.Nat^::succ N.Nat^::zero)} {Tuples.Carrier (N.Nat^::succ N.Nat^::zero)}} (Tuples.generator (N.Nat^::succ N.Nat^::zero)) _ _ (tuple v) }
  };
\definition law: \forall (v: Affine.Vertices) -> Degree.Equation v := \fun (v: Affine.Vertices) =>
  trans!{{Tuples.Carrier (N.Nat^::succ N.Nat^::zero)}} _ _ _ (Evaluation.onGenerator v Cells.base) (sym!{{Tuples.Carrier (N.Nat^::succ N.Nat^::zero)}} _ _ (basis v));
