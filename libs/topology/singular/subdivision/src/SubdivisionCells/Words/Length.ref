\use Equality.transport;
\module Step(r: N.Nat^);
\definition law: \forall (r: N.Nat^) -> \parent.Fixed[r := r].Member (wordChain r) :=
  \induction (r: N.Nat^) \return \parent.Fixed[r := r].Member (wordChain r) \with {
    | zero: \parent.Fixed[r := N.Nat^::zero].onGenerator Lists.List[Cells.Cell n]::nil (\refl(N.Nat^::zero))
    | succ: \fun (r: N.Nat^)(previous: \parent.Fixed[r := r].Member (wordChain r)) => Step[r := r].law (wordChain r) previous
  };
