\module At(n, k: N.Nat^);
\definition Property[n: N.Nat^]: \Prop := \forall (k: N.Nat^)(v: Simplex.Affine[m := n, n := k].Vertices) -> At[n := n, k := k].Equation v;
\module Zero(k: N.Nat^);
\module Step(n, k: N.Nat^);
\definition law: \forall (n: N.Nat^) -> Property n := \induction (n: N.Nat^) \return Property n \with {
  | zero: \fun (k: N.Nat^) => Zero[k := k].law
  | succ: \fun (n: N.Nat^)(previous: Property n)(k: N.Nat^) => Step[n := n, k := k].law previous
};
