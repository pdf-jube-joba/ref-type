\use std.Logic[].Equality[].eq_reason_in;
\import Modules.Laws[V := Chains.Carrier n, space := Chains.space n] \as Values;
\import algebra.Group[].Of[Carrier := Chains.Carrier n, group := Values.additive] \as Group;
\import Modules.Laws[V := GeometricChains.Carrier n, space := GeometricChains.space n] \as GeometricValues;
\import algebra.Group[].Of[Carrier := GeometricChains.Carrier n, group := GeometricValues.additive] \as GeometricGroup;
\import Modules.Hom[V := GeometricChains.Carrier n, W := Chains.Carrier n, source := GeometricChains.space n, target := Chains.space n] \as Linear;
\definition prior[sigma: Simplices.Carrier n]: Chains.Carrier n := (Push.At[n := n].push sigma (continuous sigma)).apply Subdivision.prior;
\definition law: \forall (sigma: Simplices.Carrier n) -> (Chains.boundary n).apply (homotopyOnSimplex sigma) =
  Group.difference (Group.difference (onSimplex sigma) (Chains.generator n sigma)) (prior sigma) :=
  \fun (sigma: Simplices.Carrier n) => \block {
    \let push: Linear.Map := Push.At[n := n].push sigma (continuous sigma) \then
    \return eq_reason_in!{{Chains.Carrier n} _
      "=" _ "by" { Push.Differential[n := n].commutes sigma (continuous sigma) Subdivision.homotopy }
      "=" _ "by" { congr!{{GeometricChains.Carrier n} {Chains.Carrier n}} ((push).apply) _ _ Subdivision.boundary }
      "=" _ "by" { Linear.differencePreserved push (GeometricGroup.difference Subdivision.chain (GeometricChains.generator n Fundamental.simplex)) Subdivision.prior }
      "=" _ "by" { congr!{{Chains.Carrier n} {Chains.Carrier n}} (\fun (x: Chains.Carrier n) => Group.difference x (prior sigma)) _ _
            (trans!{{Chains.Carrier n}} _ _ _ (Linear.differencePreserved push Subdivision.chain (GeometricChains.generator n Fundamental.simplex))
              (congr!{{Chains.Carrier n} {Chains.Carrier n}} (Group.difference (onSimplex sigma)) _ _ (original sigma))) }
    }
  };
