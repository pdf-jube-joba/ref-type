\import \parent.\parent.At[n := N.Nat^::zero] \as Degree;
\import Modules.Laws[V := Chains.Carrier N.Nat^::zero, space := Chains.space N.Nat^::zero] \as Values;
\import algebra.Group[].Of[Carrier := Chains.Carrier N.Nat^::zero, group := Values.additive] \as Group;
\import Modules.Hom[V := Chains.Carrier (N.Nat^::succ N.Nat^::zero), W := Chains.Carrier N.Nat^::zero, source := Chains.space (N.Nat^::succ N.Nat^::zero), target := Chains.space N.Nat^::zero] \as Boundary;
\definition zeroEquation: \forall (x: Chains.Carrier N.Nat^::zero) -> Group.difference x x = (Chains.boundary N.Nat^::zero).apply ((Degree.homotopyMap N.Nat^::zero).apply x) :=
  \fun (x: Chains.Carrier N.Nat^::zero) => trans!{{Chains.Carrier N.Nat^::zero}} _ _ _ (Group.inverseRight x) (sym!{{Chains.Carrier N.Nat^::zero}} _ _ (Boundary.zeroPreserved (Chains.boundary N.Nat^::zero)));
\module Positive(n: N.Nat^);
\definition law: Property N.Nat^::zero := Native.Laws[power N.Nat^::zero, Identity.identity, data N.Nat^::zero] {
  addition := \fun (n: N.Nat^) => (\parent.\parent.At[n := n].homotopyMap N.Nat^::zero).addition,
  scalar := \fun (n: N.Nat^) => (\parent.\parent.At[n := n].homotopyMap N.Nat^::zero).scalar,
  zeroEquation := zeroEquation,
  successorEquation := \fun (n: N.Nat^) => Positive[n := n].law,
};
