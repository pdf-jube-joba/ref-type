\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.\parent.At[n := N.Nat^::zero] \as Degree;
\import Construction.At[n := N.Nat^::zero] \as Original;
\import Modules.Laws[V := Chains.Carrier N.Nat^::zero, space := Chains.space N.Nat^::zero] \as Values;
\import algebra.Group[].Of[Carrier := Chains.Carrier N.Nat^::zero, group := Values.additive] \as Group;
\definition expanded: \forall (x: Chains.Carrier N.Nat^::zero) -> (Chains.boundary N.Nat^::zero).apply ((Degree.homotopyMap (N.Nat^::succ r)).apply x) =
  Values.add ((Chains.boundary N.Nat^::zero).apply ((Original.homotopyMap).apply (Degree.apply r x))) ((Chains.boundary N.Nat^::zero).apply ((Degree.homotopyMap r).apply x)) :=
  \fun (x: Chains.Carrier N.Nat^::zero) => (Chains.boundary N.Nat^::zero).addition _ _;
\definition law: Property r -> \forall (x: Chains.Carrier N.Nat^::zero) -> Group.difference (Degree.apply (N.Nat^::succ r) x) x = (Chains.boundary N.Nat^::zero).apply ((Degree.homotopyMap (N.Nat^::succ r)).apply x) :=
  \fun (previous: Property r)(x: Chains.Carrier N.Nat^::zero) => sym!{{Chains.Carrier N.Nat^::zero}} _ _
    (eq_reason_in!{{Chains.Carrier N.Nat^::zero} _
      "=" _ "by" { expanded x }
      "=" _ "by" { congr!{{Chains.Carrier N.Nat^::zero} {Chains.Carrier N.Nat^::zero} {Chains.Carrier N.Nat^::zero}} Values.add _ _ _ _
          (sym!{{Chains.Carrier N.Nat^::zero}} _ _ (Construction.Zero[].law (Degree.apply r x))) (sym!{{Chains.Carrier N.Nat^::zero}} _ _ ((previous).zeroEquation x)) }
      "=" _ "by" { Group.composeDifferences (Degree.apply (N.Nat^::succ r) x) (Degree.apply r x) x }
    });
