\import Construction.Topology[] \as Top;
\import Construction.At[basis := basis, inhabited := inhabited] \as RealizedAction;
\import RealizedAction.Agreement[] \as Agreement;
\import \root.Projection[E := Carrier, B := B, total := Top.topology basis, base := base, projection := projection] \as Cover;
\import Cover.Fundamental[e := point].Monodromy[covering := RealizedAction.covering] \as FundamentalImage;
\import Cover.Transport[].Groupoid[covering := RealizedAction.covering] \as Monodromy;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Top.topology basis;
\definition covering: Cover.Covering := RealizedAction.covering;
\definition connected: fundamental_groups.Paths[A := Carrier, source := topology].PathConnected := RealizedAction.connected transitive;
\definition ImageSet: \Pow Fundamental.Carrier := FundamentalImage.image;
\definition SubgroupSet: \Pow Fundamental.Carrier := H;
\definition subgroup: FundamentalImage.image = H := \axiom:setext(ImageSet, SubgroupSet,
  \fun (g: Fundamental.Carrier)(fixed: FundamentalImage.Fixed g) => (fixes g).ltr
    (trans!{Carrier} (move b b g pointed) (Monodromy.move b b g pointed) pointed
      (sym!{Carrier} (Monodromy.move b b g pointed) (move b b g pointed) (Agreement.classes b b g pointed)) fixed),
  \fun (g: Fundamental.Carrier)(member: \In[Fundamental.Carrier] H g) =>
    trans!{Carrier} (Monodromy.move b b g pointed) (move b b g pointed) pointed (Agreement.classes b b g pointed) ((fixes g).rtl member));
