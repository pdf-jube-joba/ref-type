\import \root.Projection[E := Carrier Group.trivial, B := B, total := r.topology, base := base, projection := projection Group.trivial] \as Cover;
\import Cover.Fundamental[e := point Group.trivial] \as Induced;
\import Induced.Monodromy[covering := r.covering] \as Image;
\import fundamental_groups.FundamentalGroup[A := Carrier Group.trivial, source := r.topology, basepoint := point Group.trivial] \as Source;
\import fundamental_groups.SimpleConnectivity[A := Carrier Group.trivial, source := r.topology, b := point Group.trivial] \as Simple;
\import fundamental_groups.Groupoid[A := Carrier Group.trivial, source := r.topology].Maps[B := B, target := base] \as Map;
\definition trivial: Simple.Trivial := \block {
  \fun (a: Source.Carrier) \then
  \let g: Fundamental.Carrier := Induced.induced r.covering a \then
  \let inImage: \In[Fundamental.Carrier] Image.image g := (Image.imageMembership g).rtl
    (Logic.existsIntro[Source.Carrier, { h: Source.Carrier \where Induced.induced r.covering h = g }] a (\refl(g))) \then
  \let inTrivial: \In[Fundamental.Carrier] Group.trivial g := \idelim Image.image = Group.trivial \with H: \Pow Fundamental.Carrier => \In[Fundamental.Carrier] H g
    \by { base: inImage, equality: r.image } \then
  \return Induced.injective r.covering a Source.unit (trans!{Fundamental.Carrier} _ _ _ inTrivial
    (sym!{Fundamental.Carrier} _ _ (Map.preservesIdentity (projection Group.trivial) r.covering.continuous (point Group.trivial))))
};
\definition simplyConnected: fundamental_groups.Paths[A := Carrier Group.trivial, source := r.topology].SimplyConnected := Simple.ofTrivial r.connected trivial;
