\import fundamental_groups.Paths[A := B, source := base] \as Paths;
\import fundamental_groups.Groupoid[A := B, source := base] \as G;
\import fundamental_groups.Neighborhoods[A := B, source := base] \as Neighborhoods;
\import topology.Topology[Carrier := B] \as Base;
\import topology.Topology[Carrier := E] \as Total;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason;
\definition Fiber[b: B]: \Set := \Cast[E] ({ e: E \where projection e = b });
\definition projectsTo[b: B][e: Fiber b]: projection e = b := \bysub(E, Fiber b, e);
\structure Action: \Set := {
  move: \forall (x, y: B) -> G.Arrow x y -> Fiber x -> Fiber y,
  identity: \forall (x: B)(e: Fiber x) -> move x x (G.identity x) e = e,
  compose: \forall (x, y, z: B)(p: G.Arrow x y)(q: G.Arrow y z)(e: Fiber x) ->
    move x z (G.compose x y z p q) e = move y z q (move x y p e),
};
\definition Transitive[action: Action]: \Prop := \forall (x, y: B)(e: Fiber x)(f: Fiber y) ->
  \exists ( p: G.Arrow x y \where action.move x y p e = f );
\module Local(action: Action, U: \Pow B, good: Neighborhoods.Good[U]);
\module Realization(action: Action);
\module Rebasing(action: Action, b: B, bridges: fundamental_groups.Bridges[A := B, source := base, basepoint := b].Family);
