\module Neighborhood(b: B);
\definition existence: \forall (f, g: Interval.Carrier -> Interval.Carrier) ->
  ParameterMaps.Continuous Interval.topology Interval.topology f -> ParameterMaps.Continuous Interval.topology Interval.topology g ->
  \forall (U: \Pow Square.Carrier) -> \In[\Pow Square.Carrier] neighborhoods U -> Fine.Within f g U -> Property f g := \block {
  \fun (f, g: _)(fc: _)(gc: _)(U: _)(member: _)(within: _) \then
  \takefrom b: \Cast[B] ({ b: B \where U = Preimage b }) \by member \then
  \let same: U = Preimage b := \bysub(B, { b: B \where U = Preimage b }, b) \then
  \let contained: \forall (q: Square.Carrier) -> \In[B] (charts b).neighborhood (trace f g q) :=
    \fun (q: Square.Carrier) => \idelim U = Preimage b \with V: \Pow Square.Carrier => \In[Square.Carrier] V (parameter f g q)
      \by { base: within (Square.time q) (Square.point q), equality: same } \then
  \return Neighborhood[b := b].existence f g contained
};
