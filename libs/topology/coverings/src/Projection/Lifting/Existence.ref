\import std.Logic[].Proposition[] \as Logic;
\definition ChartFamily: \Set := \forall (b: B) -> LocalChart[b];
\definition chartFamilyExists: Covering -> \exists ChartFamily :=
  \fun (covering: Covering) => \axiom:classicalIndefiniteChoice(B, (\fun (b: B) => LocalChart[b]), covering.local);
\module Along(x, y: B, path: BasePaths.Path x y, charts: ChartFamily);
\definition pathLiftExists: Covering -> \forall (x, y: B)(path: BasePaths.Path x y)(start: Fiber x) -> \exists PathLift x y path start := \block {
  \fun (covering: Covering)(x, y: B)(path: BasePaths.Path x y)(start: Fiber x) \then
  \takefrom charts: ChartFamily \by chartFamilyExists covering \then
  \return Along[x := x, y := y, path := path, charts := charts].existsLift start
};
