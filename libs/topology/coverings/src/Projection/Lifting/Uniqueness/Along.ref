\import Existence.Along[x := x, y := y, path := path, charts := charts] \as Neighborhoods;
\import algebraic_topology.Interval[].Subdivision[] \as Subdivision;
\import algebraic_topology.Interval[].Halves[] \as Halves;
\import topology.Continuity[A := Interval.Carrier, B := Interval.Carrier] \as Parameters;
\import Subdivision.Cover[family := Neighborhoods.family] \as Fine;
\import \root.Projection[E := E, B := B, total := total, base := base, projection := projection] \as Projection;
\import std.Logic[].Proposition[] \as Logic;
\definition Property[f: Interval.Carrier -> Interval.Carrier]: \Prop :=
  l (f Interval.start) = r (f Interval.start) -> l (f Interval.end) = r (f Interval.end);
\definition combine: \forall (f: Interval.Carrier -> Interval.Carrier) -> Property (Subdivision.left f) -> Property (Subdivision.right f) -> Property f :=
  \fun (f: _)(left: _)(right: _)(starts: _) => trans!{E} _ _ _
    (congr!{Interval.Carrier E} (\fun (t: Interval.Carrier) => l (f t)) _ _ (sym!{Interval.Carrier} _ _ Halves.upperEnd))
    (trans!{E} _ _ _
      (right (trans!{E} _ _ _
        (congr!{Interval.Carrier E} (\fun (t: Interval.Carrier) => l (f t)) _ _
          (trans!{Interval.Carrier} _ _ _ Halves.upperStart (sym!{Interval.Carrier} _ _ Halves.lowerEnd)))
        (trans!{E} _ _ _
          (left (trans!{E} _ _ _ (congr!{Interval.Carrier E} (\fun (t: Interval.Carrier) => l (f t)) _ _ Halves.lowerStart)
            (trans!{E} _ _ _ starts (congr!{Interval.Carrier E} (\fun (t: Interval.Carrier) => r (f t)) _ _ (sym!{Interval.Carrier} _ _ Halves.lowerStart)))))
          (congr!{Interval.Carrier E} (\fun (t: Interval.Carrier) => r (f t)) _ _
            (trans!{Interval.Carrier} _ _ _ Halves.lowerEnd (sym!{Interval.Carrier} _ _ Halves.upperStart))))))
      (congr!{Interval.Carrier E} (\fun (t: Interval.Carrier) => r (f t)) _ _ Halves.upperEnd));
\definition local: \forall (f: Interval.Carrier -> Interval.Carrier) -> Parameters.Continuous Interval.topology Interval.topology f ->
  \forall (V: \Pow Interval.Carrier) -> \In[\Pow Interval.Carrier] Neighborhoods.family V -> Fine.Within f V -> Property f := \block {
  \fun (f: _)(continuous: _)(V: _)(member: _)(within: _)(starts: _) \then
  \takefrom b: \Cast[B] ({ b: B \where V = Neighborhoods.Preimage b }) \by member \then
  \let same: V = Neighborhoods.Preimage b := \bysub(B, { b: B \where V = Neighborhoods.Preimage b }, b) \then
  \let contained: \forall (t: Interval.Carrier) -> \In[B] (charts b).neighborhood (path (f t)) :=
    \fun (t: Interval.Carrier) => \idelim V = Neighborhoods.Preimage b \with W: \Pow Interval.Carrier => \In[Interval.Carrier] W (f t)
      \by { base: within t, equality: same } \then
  \return Projection.Around[b := b, U := (charts b).neighborhood].DiscretePaths[].endpointUnique (charts b).chart
    (\fun (t: Interval.Carrier) => l (f t)) (\fun (t: Interval.Carrier) => r (f t))
    (Compose.composeContinuous Interval.topology Interval.topology total f l continuous lc)
    (Compose.composeContinuous Interval.topology Interval.topology total f r continuous rc)
    (\fun (t: Interval.Carrier) => \idelim path (f t) = projection (l (f t)) \with v: B => \In[B] (charts b).neighborhood v
      \by { base: contained t, equality: sym!{B} _ _ (lp (f t)) })
    (\fun (t: Interval.Carrier) => \idelim path (f t) = projection (r (f t)) \with v: B => \In[B] (charts b).neighborhood v
      \by { base: contained t, equality: sym!{B} _ _ (rp (f t)) })
    (\fun (t: Interval.Carrier) => trans!{B} _ _ _ (lp (f t)) (sym!{B} _ _ (rp (f t)))) starts
};
\definition endpoints: l Interval.start = r Interval.start -> l Interval.end = r Interval.end := Fine.localToGlobal Neighborhoods.cover Property combine local;
