\definition imageOnClass: \forall (a: Fundamental.Carrier)(normalizes: Normalizer a) -> image (backward (class a normalizes)) = Action.move a sourcePoint :=
  \fun (a: _)(normalizes: _) => trans!{E} _ _ _ (\bysub(Carrier, Value (class a normalizes), backward (class a normalizes))) (Orbit.onClass a);
\definition multiplication: \forall (a, b: Fundamental.Carrier)(na: Normalizer a)(nb: Normalizer b) ->
  representative (quotientMultiply (class a na) (class b nb)) = Cosets.class (Group.mul a b) := \block {
  \fun (a, b: Fundamental.Carrier)(na: _)(nb: _) \then
  \let f: Carrier := backward (class a na) \then
  \let g: Carrier := backward (class b nb) \then
  \let equivariant: Comparison.Equivariant[covering, covering, map f] := Compare.equivariantOfContinuous (map f) (laws f).continuous \then
  \return Orbit.injective (quotientMultiply (class a na) (class b nb)) (Cosets.class (Group.mul a b))
    (eq_reason_in!{E {Orbit.orbit (quotientMultiply (class a na) (class b nb))}
      "=" {image (multiply f g)} "by" {Orbit.orbitRightInverse (Action.connectedTransitive connected) (image (multiply f g))}
      "=" {f (Action.move b sourcePoint)} "by" {congr!{E E} f _ _ (imageOnClass b nb)}
      "=" {Action.move b (image f)} "by" {equivariant.commutes (projection point) (projection point) b sourcePoint}
      "=" {Action.move b (Action.move a sourcePoint)} "by" {congr!{{Fiber (projection point)} E} (Action.move b) (image f) (Action.move a sourcePoint) (imageOnClass a na)}
      "=" {Action.move (Group.mul a b) sourcePoint} "by" {sym!{E} _ _ ((Actions.laws Action.action).compose a b sourcePoint)}
      "=" {Orbit.orbit (Cosets.class (Group.mul a b))} "by" {sym!{E} _ _ (Orbit.onClass (Group.mul a b))}})
};
