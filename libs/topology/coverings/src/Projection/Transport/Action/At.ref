\import Actions.At[act := action, point := e] \as Classification;
\definition Cosets: \Set := Group.Cosets[H := stabilizer e].Carrier;
\definition orbit: Cosets -> Fiber b := Classification.orbit;
\definition injective: \forall (u, v: Cosets) -> orbit u = orbit v -> u = v := Classification.injective;
\definition surjective: Actions.Transitive action -> \forall (s: Fiber b) -> \exists ( q: Cosets \where orbit q = s ) := Classification.surjective;
