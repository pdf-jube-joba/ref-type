\import \root.Projection[E := E, B := B, total := total, base := base, projection := projection].Transport[] \as RawTransport;
\import fundamental_groups.Groupoid[A := B, source := base] \as G;
\definition move[x, y: B][p: G.Arrow x y][e: Fiber x]: Fiber y := RawTransport.Classes[covering := covering, x := x, y := y, e := e].apply p;
\definition onClass: \forall (x, y: B)(p: Paths.Path x y)(e: Fiber x) -> move x y (G.class x y p) e = along covering x y p e :=
  \fun (x, y: B)(p: _)(e: _) => RawTransport.Classes[covering := covering, x := x, y := y, e := e].onClass p;
\definition identityLaw: \forall (x: B)(e: Fiber x) -> move x x (G.identity x) e = e :=
  \fun (x: B)(e: Fiber x) => trans!{E} _ _ _ (onClass x x (Paths.constant x) e) (constant covering x e);
\module At(x, y, z: B);
\definition compositionLaw: \forall (x, y, z: B)(p: G.Arrow x y)(q: G.Arrow y z)(e: Fiber x) ->
  move x z (G.compose x y z p q) e = move y z q (move x y p e) :=
  \fun (x, y, z: B) => At[x := x, y := y, z := z].compositionLaw;
