\import Paths.Between[x := x, y := y] \as Quotient;
\import Quotient.Functions[B := Fiber y] \as Descent;
\import \parent.Homotopy[] \as Homotopy;
\definition respects: Descent.Respects (\fun (p: Paths.Path x y) => along covering x y p e) :=
  \fun (p, q: Paths.Path x y)(related: Paths.Homotopic x y p q) => Homotopy.respects covering x y p q related e;
\definition apply: Quotient.Carrier -> Fiber y := Descent.descend (\fun (p: Paths.Path x y) => along covering x y p e) respects;
\definition onClass: \forall (p: Paths.Path x y) -> apply (Quotient.class p) = along covering x y p e :=
  Descent.onClass (\fun (p: Paths.Path x y) => along covering x y p e) respects;
