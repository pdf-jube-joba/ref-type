\import \parent.Groupoid[covering := covering] \as Transport;
\import fundamental_groups.FundamentalGroup[A := B, source := base, basepoint := b] \as Fundamental;
\import algebra.Noncommutative[G := Fundamental.Carrier, group := Fundamental.group] \as Group;
\import Group.Actions[S := Fiber b] \as Actions;
\definition move: Fundamental.Carrier -> Fiber b -> Fiber b := Transport.move b b;
\definition action: Actions.Action := \into[Fundamental.Carrier -> Fiber b -> Fiber b](move, Actions.Action) \by {
  Actions.Laws[move] { identity := Transport.identityLaw b, compose := Transport.compositionLaw b b b }
};
\definition stabilizer[e: Fiber b]: Group.Subgroup := Actions.stabilizer action e;
\module At(e: Fiber b);
