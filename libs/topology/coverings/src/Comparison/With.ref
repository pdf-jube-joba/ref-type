\use std.Logic[].Equality[].eq_reason_in;
\import SourceTransport.Groupoid[covering := c] \as SourceAction;
\import TargetTransport.Groupoid[covering := d] \as TargetAction;
\definition alongCommutes: \forall (m: OverMap) -> Equivariant[c, d, m] -> \forall (x, y: B)(p: Paths.Path x y)(e: Source.Fiber x) ->
  m.apply (SourceTransport.along c x y p e) = TargetTransport.along d x y p (fiber m x e) :=
  \fun (m: _)(equivariant: _)(x, y: _)(p: _)(e: _) => eq_reason_in!{F _
    "=" _ "by" { congr!{E F} m.apply _ _ (sym!{E} _ _ (SourceAction.onClass x y p e)) }
    "=" _ "by" { equivariant.commutes x y (G.class x y p) e }
    "=" _ "by" { TargetAction.onClass x y p (fiber m x e) }
  };
\module Along(m: OverMap, equivariant: Equivariant[c, d, m], basis: Neighborhoods.GoodBasis);
\module Rebasing(b: B, bridges: fundamental_groups.Bridges[A := B, source := base, basepoint := b].Family);
\import Source.Lifting[] \as SourceLifts;
\import Target.Lifting[] \as TargetLifts;
\import TargetLifts.Uniqueness[] \as TargetUnique;
\import SourceLifts.Uniqueness[] \as SourceUnique;
\import algebraic_topology.Interval[] \as Interval;
\import topology.Composition[A := Interval.Carrier, B := E, C := F] \as LiftMaps;
\definition alongOfContinuous: \forall (m: OverMap) -> Maps.Continuous total other m.apply ->
  \forall (x, y: B)(p: Paths.Path x y)(e: Source.Fiber x) ->
  m.apply (SourceTransport.along c x y p e) = TargetTransport.along d x y p (fiber m x e) := \block {
  \fun (m: _)(mc: _)(x, y: B)(p: Paths.Path x y)(e: Source.Fiber x) \then
  \let source: SourceLifts.PathLift x y p e := SourceTransport.lift c x y p e \then
  \let image: TargetLifts.PathLift x y p (fiber m x e) :=
    \into[Interval.Carrier -> F](\fun (t: Interval.Carrier) => m.apply (source t), TargetLifts.PathLift x y p (fiber m x e)) \by {
      TargetLifts.PathLiftLaws[x, y, p, fiber m x e, \fun (t: Interval.Carrier) => m.apply (source t)] {
        continuous := LiftMaps.composeContinuous Interval.topology total other source m.apply (SourceLifts.pathLaws x y p e source).continuous mc,
        projects := \fun (t: Interval.Carrier) => trans!{B} _ _ _ (m.over (source t)) ((SourceLifts.pathLaws x y p e source).projects t),
        starts := congr!{E F} m.apply _ _ (SourceLifts.pathLaws x y p e source).starts,
      }
    } \then
  \return congr!{{Interval.Carrier -> F} F} (\fun (q: Interval.Carrier -> F) => q Interval.end) _ _
    (TargetUnique.pathLiftUnique d x y p (fiber m x e) image (TargetTransport.lift d x y p (fiber m x e)))
};
\definition equivariantOfContinuous: \forall (m: OverMap) -> Maps.Continuous total other m.apply -> Equivariant[c, d, m] :=
  \fun (m: _)(continuous: _) => Equivariant[c, d, m] {
    commutes := \fun (x, y: B) => Paths.Between[x := x, y := y].induction
      (\fun (p: G.Arrow x y) => \forall (e: Source.Fiber x) -> m.apply (SourceAction.move x y p e) = TargetAction.move x y p (fiber m x e))
      (\fun (p: Paths.Path x y)(e: _) => eq_reason_in!{F _
        "=" _ "by" { congr!{E F} m.apply _ _ (SourceAction.onClass x y p e) }
        "=" _ "by" { alongOfContinuous m continuous x y p e }
        "=" _ "by" { sym!{F} _ _ (TargetAction.onClass x y p (fiber m x e)) }
      }),
  };
\import fundamental_groups.Paths[A := E, source := total] \as TotalPaths;
\import TotalPaths.Maps[B := B, target := base] \as ProjectPaths;
\definition unique: TotalPaths.PathConnected -> \forall (m, n: OverMap) -> Maps.Continuous total other m.apply -> Maps.Continuous total other n.apply ->
  \forall (point: E) -> m.apply point = n.apply point -> \forall (e: E) -> m.apply e = n.apply e := \block {
  \fun (connected: _)(m, n: OverMap)(mc: _)(nc: _)(point: E)(same: _)(e: E) \then
  \takefrom f: TotalPaths.Path point e \by connected point e \then
  \let x: B := projection point \then
  \let y: B := projection e \then
  \let start: Source.Fiber x := \into[E](point, Source.Fiber x) \by { \refl(x) } \then
  \let p: Paths.Path x y := ProjectPaths.apply projection c.continuous point e f \then
  \let lift: SourceLifts.PathLift x y p start := \into[Interval.Carrier -> E](f, SourceLifts.PathLift x y p start) \by {
    SourceLifts.PathLiftLaws[x, y, p, start, f] { continuous := (TotalPaths.laws point e f).continuous,
      projects := \fun (t: Interval.Carrier) => \refl(projection (f t)), starts := (TotalPaths.laws point e f).start }
  } \then
  \let ends: SourceTransport.along c x y p start = e := trans!{E} _ _ _
    (congr!{{Interval.Carrier -> E} E} (\fun (q: Interval.Carrier -> E) => q Interval.end) _ _
      (SourceUnique.pathLiftUnique c x y p start (SourceTransport.lift c x y p start) lift)) (TotalPaths.laws point e f).end \then
  \return eq_reason_in!{F {m.apply e}
    "=" {m.apply (SourceTransport.along c x y p start)} "by" {congr!{E F} m.apply _ _ (sym!{E} _ _ ends)}
    "=" {TargetTransport.along d x y p (fiber m x start)} "by" {alongOfContinuous m mc x y p start}
    "=" {TargetTransport.along d x y p (fiber n x start)} "by" {congr!{{Target.Fiber x} F} (TargetTransport.along d x y p) (fiber m x start) (fiber n x start) same}
    "=" {n.apply (SourceTransport.along c x y p start)} "by" {sym!{F} _ _ (alongOfContinuous n nc x y p start)}
    "=" {n.apply e} "by" {congr!{E F} n.apply _ _ ends}}
};
\module Pointed(point: E, targetPoint: Target.Fiber (projection point));
\module Unpointed(point: E, targetPoint: Target.Fiber (projection point));
