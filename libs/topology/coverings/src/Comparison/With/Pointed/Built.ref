\import \root.Comparison[E := E, F := F, B := B, total := total, other := other, base := base, projection := projection, otherProjection := otherProjection].With[c := c, d := d] \as Comparison;
\import Comparison.Rebasing[b := b, bridges := bridges] \as Rebase;
\import PointedMaps.Along[compatible := compatible, transitive := SourceFiber.connectedTransitive connected] \as FiberMap;
\definition baseMap: Rebase.FiberMap := Rebase.FiberMap { apply := FiberMap.map.apply, commutes := FiberMap.map.commutes };
\import Rebase.Extend[map := baseMap] \as Extension;
\definition continuous: Maps.Continuous total other Extension.data.apply :=
  Comparison.Along[m := Extension.data, equivariant := Extension.equivariant, basis := basis].continuous;
\definition pointed: Extension.data.apply point = targetPoint := trans!{F} _ _ _ (Extension.atBase sourcePoint) FiberMap.map.pointed;
\definition map: Map := Map { map := Extension.data, continuous := continuous, pointed := pointed };
