\import \root.PathAction[E := E, B := B, base := base, projection := projection] \as SourcePaths;
\import \root.PathAction[E := F, B := B, base := base, projection := otherProjection] \as TargetPaths;
\import SourcePaths.Rebasing[action := SourceTransport.pathAction c, b := b, bridges := bridges] \as SourceRebase;
\import TargetPaths.Rebasing[action := TargetTransport.pathAction d, b := b, bridges := bridges] \as TargetRebase;
\import fundamental_groups.FundamentalGroup[A := B, source := base, basepoint := b] \as Fundamental;
\structure FiberMap: \Set := {
  apply: Source.Fiber b -> Target.Fiber b,
  commutes: \forall (g: Fundamental.Carrier)(e: Source.Fiber b) -> apply (SourceAction.move b b g e) = TargetAction.move b b g (apply e),
};
\module Extend(map: FiberMap);
