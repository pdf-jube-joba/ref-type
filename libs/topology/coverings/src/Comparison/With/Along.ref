\module Local(e: E, left: Source.LocalChart[projection e], right: Target.LocalChart[projection e]);
\definition continuous: Maps.Continuous total other m.apply :=
  \fun (W: \Pow F)(wo: _) => Total.openOfNeighborhoods total (Maps.Preimage m.apply W) (\block {
    \fun (e: E)(inW: _) \then
    \takefrom left: Source.LocalChart[projection e] \by c.local (projection e) \then
    \takefrom right: Target.LocalChart[projection e] \by d.local (projection e) \then
    \return Local[e := e, left := left, right := right].neighborhood W wo inW
  });
