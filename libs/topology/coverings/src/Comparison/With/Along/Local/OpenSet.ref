\definition sectionOpen: topology.Topology[Carrier := Under.CarrierSet].IsOpenIn (Under.topology base) (Sections.Preimage section W) :=
  Right.sectionContinuous right.chart sheet W wo;
\definition sectionContains: topology.Topology[Carrier := Under.CarrierSet].Member (Sections.Preimage section W) targetBase :=
  \idelim m.apply e = section targetBase \with f: F => Other.Member W f \by { base: contains, equality: sym!{F} _ _ atStart };
\definition neighborhood: \exists ( V: \Pow E \where Total.OpenNeighborhood[total, e, Maps.Preimage m.apply W, V] ) := \block {
  \takefrom V: \Cast[\Pow B] ({ V: \Pow B \where Logic.And[Base.IsOpenIn base V, Sections.Preimage section W = Under.Trace V] })
    \by Under.openRepresentation base (Sections.Preimage section W) sectionOpen \then
  \let v: Logic.And[Base.IsOpenIn base V, Sections.Preimage section W = Under.Trace V] :=
    \bysub(\Pow B, { V: \Pow B \where Logic.And[Base.IsOpenIn base V, Sections.Preimage section W = Under.Trace V] }, V) \then
  \let inV: Base.Member V (projection e) := \idelim Sections.Preimage section W = Under.Trace V
    \with S: \Pow Under.CarrierSet => \In[Under.CarrierSet] S targetBase \by { base: sectionContains, equality: v.right } \then
  \let ambient: \Pow B := Base.Intersection V (Base.Intersection left.neighborhood right.neighborhood) \then
  \let ambientOpen: Base.IsOpenIn base ambient := (Base.topologyLaws base).intersectionOpen V (Base.Intersection left.neighborhood right.neighborhood)
    v.left ((Base.topologyLaws base).intersectionOpen left.neighborhood right.neighborhood left.open right.open) \then
  \takefrom U: \Cast[\Pow B] ({ U: \Pow B \where Neighborhoods.Refinement[projection e, ambient, U] }) \by
    basis ambient ambientOpen (projection e) (Logic.And[_, _]::# inV (Logic.And[_, _]::# left.contains right.contains)) \then
  \let u: Neighborhoods.Refinement[projection e, ambient, U] := \bysub(\Pow B, { U: \Pow B \where Neighborhoods.Refinement[projection e, ambient, U] }, U) \then
  \let patch: \Pow E := Total.Intersection (SourceMap.Preimage projection U) (LeftSheet.Sheet (Left.index left.chart sourcePoint)) \then
  \return Logic.existsIntro[\Pow E, { R: \Pow E \where Total.OpenNeighborhood[total, e, Maps.Preimage m.apply W, R] }] patch
    (Total.OpenNeighborhood[total, e, Maps.Preimage m.apply W, patch] {
      open := (Total.topologyLaws total).intersectionOpen (SourceMap.Preimage projection U) (LeftSheet.Sheet (Left.index left.chart sourcePoint))
        (c.continuous U u.good.open) (LeftSheet.open c left.open (Left.index left.chart sourcePoint)),
      contains := Logic.And[_, _]::# u.contains (LeftSheet.member (Left.index left.chart sourcePoint) sourcePoint (\refl(Left.index left.chart sourcePoint))),
      within := \block {
        \fun (h: E)(inside: Logic.And[Base.Member U (projection h), Total.Member (LeftSheet.Sheet (Left.index left.chart sourcePoint)) h]) \then
        \let inU: Base.Member U (projection h) := inside.left \then
        \let inLeft: Base.Member left.neighborhood (projection h) := ((u.subset (projection h) inU).right).left \then
        \let inRight: Base.Member right.neighborhood (projection h) := ((u.subset (projection h) inU).right).right \then
        \let target: Under.CarrierSet := \into[B](projection h, right.neighborhood) \by { inRight } \then
        \let overH: SourceOver.CarrierSet := \into[E](h, SourceMap.Preimage projection left.neighborhood) \by { inLeft } \then
        \let member: Other.Member W (section target) := \idelim Under.Trace V = Sections.Preimage section W
          \with S: \Pow Under.CarrierSet => \In[Under.CarrierSet] S target
          \by { base: (u.subset (projection h) inU).left, equality: sym!{\Pow Under.CarrierSet} _ _ v.right } \then
        \takefrom p: Neighborhoods.Path U (projection e) (projection h) \by u.good.connected (projection e) (projection h) u.contains inU \then
        \let inSource: \forall (t: algebraic_topology.Interval[].Carrier) -> Base.Member left.neighborhood (p t) :=
          \fun (t: _) => ((u.subset (p t) (Neighborhoods.within U (projection e) (projection h) p t)).right).left \then
        \let inTarget: \forall (t: algebraic_topology.Interval[].Carrier) -> Base.Member right.neighborhood (p t) :=
          \fun (t: _) => ((u.subset (p t) (Neighborhoods.within U (projection e) (projection h) p t)).right).right \then
        \let sourceEnd: SourceTransport.along c (projection e) (projection h) p start = h := trans!{E} _ _ _
          (LeftSheet.along c (projection e) (projection h) p inSource start
            (\into[B](projection h, left.neighborhood) \by { inLeft }) (\refl(projection h)))
          (trans!{E} _ _ _
            (congr!{{Source.Fiber (projection e)} E}
              (\fun (s: Source.Fiber (projection e)) => Left.section left.chart s (\into[B](projection h, left.neighborhood) \by { inLeft })) _ _
              (sym!{E} _ _ (LeftSheet.sheetIndex (Left.index left.chart sourcePoint) overH inside.right)))
            (Left.reconstruct left.chart overH (\into[B](projection h, left.neighborhood) \by { inLeft }) (\refl(projection h)))) \then
        \let targetEnd: TargetTransport.along d (projection e) (projection h) p image = section target :=
          RightSheet.along d (projection e) (projection h) p inTarget image target (\refl(projection h)) \then
        \let same: m.apply h = section target := trans!{F} _ _ _
          (congr!{E F} m.apply _ _ (sym!{E} _ _ sourceEnd))
          (trans!{F} _ _ _ (alongCommutes m equivariant (projection e) (projection h) p start) targetEnd) \then
        \return \idelim section target = m.apply h \with f: F => Other.Member W f \by { base: member, equality: sym!{F} _ _ same }
      },
    })
};
