\module Projection(E, B: \Set, total: topology.Topology[Carrier := E].Topology, base: topology.Topology[Carrier := B].Topology, projection: E -> B);
\module PathAction(E, B: \Set, base: topology.Topology[Carrier := B].Topology, projection: E -> B);
\module Subgroups(B: \Set, base: topology.Topology[Carrier := B].Topology, b: B);
\module Comparison(E, F, B: \Set, total: topology.Topology[Carrier := E].Topology, other: topology.Topology[Carrier := F].Topology,
  base: topology.Topology[Carrier := B].Topology, projection: E -> B, otherProjection: F -> B);
