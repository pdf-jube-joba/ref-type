\import topology.Topology[Carrier := E] \as Total;
\import topology.Topology[Carrier := B] \as Base;
\import topology.Continuity[A := E, B := B] \as Maps;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\definition Fiber[b: B]: \Set := \Cast[E] ({ e: E \where projection e = b });
\definition projectsTo[b: B][e: Fiber b]: projection e = b := \bysub(E, Fiber b, e);
\module Around(b: B, U: \Pow B);
\structure LocalChart[b: B]: \Set := {
  neighborhood: \Pow B,
  open: Base.IsOpenIn base neighborhood,
  contains: \In[B] neighborhood b,
  chart: Around[b := b, U := neighborhood].Chart,
};
\structure Covering: \Prop := {
  continuous: Maps.Continuous total base projection,
  local: \forall (b: B) -> \exists LocalChart[b],
  surjective: \forall (b: B) -> \exists Fiber b,
};
\module Lifting;
\module Transport;
\module Fundamental(e: E);
