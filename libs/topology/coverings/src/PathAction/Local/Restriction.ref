\import \root.PathAction[E := E, B := B, base := base, projection := projection].Local[action := action, U := V, good := smaller] \as Smaller;
\definition agrees: \forall (x, y: B)(inX: Base.Member V x)(inY: Base.Member V y)(e: Fiber x) ->
  Smaller.move x y inX inY e = move x y (subset x inX) (subset y inY) e := \block {
  \fun (x, y: B)(inX: _)(inY: _)(e: _) \then
  \takefrom p: Neighborhoods.Path V x y \by smaller.connected x y inX inY \then
  \return trans!{E} _ _ _ (Smaller.onPath x y inX inY e p)
    (sym!{E} _ _ (onPath x y (subset x inX) (subset y inY) e (Neighborhoods.restrict V U subset x y p)))
};
