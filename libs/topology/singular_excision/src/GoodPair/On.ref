\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Proposition[] \as Logic;
\use Equality.sym;
\use Equality.trans;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import Geometry.On[pair := pair] \as Topology;
\import topology.Topology[Carrier := A] \as Space;
\import Space.Subspace[S := subset] \as Subspace;
\import Space.Subspace[S := Topology.region] \as Neighborhood;
\import singular_cohomology.Relative[A := A, source := source, subset := subset] \as Original;
\import singular_cohomology.Relative[A := A, source := source, subset := Topology.region] \as Expanded;
\import Original.Maps[B := A].Over[target := source, targetSubset := Topology.region] \as Maps;
\import topology.Maps[A := A, B := A].Identity[] \as Identity;
\definition map: Maps.Map := \into[A -> A]((\fun (x: A) => x), Maps.Map) \by {
  Maps.Laws[(\fun (x: A) => x)] {
    continuous := Identity.continuous source,
    contained := \fun (x: Subspace.CarrierSet) => #contains{Topology.neighborhood} x (\bysub(A, subset, x)),
  }
};
\import Maps.On[f := map].Integer[] \as Action;
\import singular_cohomology.Equivalence[A := Subspace.CarrierSet, B := Neighborhood.CarrierSet, source := Subspace.topology source, target := Neighborhood.topology source]
  .Signed[] \as SubspaceComparison;
\import singular_cohomology.Identity[A := A, source := source].Integer[] \as WholeComparison;
\definition subspaceQuasi: Action.Comparison[].SubspaceQuasi := \fun (z: I.Int^) => SubspaceComparison.Homology[z := z].bijective Topology.equivalence;
\definition wholeQuasi: Action.Comparison[].WholeQuasi := \fun (z: I.Int^) => WholeComparison.Homology[z := z].bijective;
\module Homology(z: I.Int^);
\module With(coefficients: Modules.Bundle) {
  \import Action.With[coefficients := coefficients] \as Pull;
  \definition subspaceQuasi: Pull.Comparison[].SubspaceQuasi := \fun (z: I.Int^) => SubspaceComparison.With[coefficients := coefficients].At[z := z].bijective Topology.equivalence;
  \definition wholeQuasi: Pull.Comparison[].WholeQuasi := \fun (z: I.Int^) => WholeComparison.With[coefficients := coefficients].At[z := z].bijective;
  \module At(z: I.Int^);
}
