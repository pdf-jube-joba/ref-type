\definition neighborhoodIsomorphism: Modules.Isomorphism[V := Expanded.With[coefficients := coefficients].At[z := z].Carrier, W := Original.With[coefficients := coefficients].At[z := z].Carrier,
      source := Expanded.With[coefficients := coefficients].At[z := z].space, target := Original.With[coefficients := coefficients].At[z := z].space].Isomorphism :=
        Pull.Comparison[].At[z := z].isomorphism subspaceQuasi wholeQuasi;
\import \parent.\parent.\parent.QuotientSquare[pair := pair].With[coefficients := coefficients].At[z := z] \as Diagram;
\import \parent.\parent.\parent.QuotientPoint[pair := pair].Comparison[].With[coefficients := coefficients].At[z := z] \as TargetComparison;
\import \parent.\parent.\parent.Excision[pair := pair].With[coefficients := coefficients].At[z := z] \as ExpandedComparison;
\import Modules.IsomorphismSquare[A := Diagram.expandedTarget, B := Diagram.expandedSource, C := Diagram.originalTarget, D := Diagram.originalSource] \as Transport;
\definition relativeIsomorphism: Modules.Isomorphism[V := Diagram.originalTarget.Carrier, W := Diagram.originalSource.Carrier, source := Diagram.originalTarget.space, target := Diagram.originalSource.space].Isomorphism :=
  Transport.transport TargetComparison.isomorphism neighborhoodIsomorphism ExpandedComparison.isomorphism Diagram.quotient (\fun (q: Diagram.expandedTarget.Carrier) => sym!{Diagram.originalSource.Carrier} _ _ (Diagram.law q));
\import algebraic_topology.Collapse[A := A, subset := subset] \as Quotient;
\import singular_cohomology.Chains[A := Quotient.Carrier, source := Quotient.topology source].Reduced[].With[coefficients := coefficients] \as Reduced;
\import Modules.Isomorphism[V := Diagram.originalTarget.Carrier, W := Reduced.At[z := z].Carrier, source := Diagram.originalTarget.space, target := Reduced.At[z := z].space].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := Reduced.At[z := z].Carrier, W := Diagram.originalTarget.Carrier, source := Reduced.At[z := z].space, target := Diagram.originalTarget.space]
  .Composition[U := Diagram.originalSource.Carrier, final := Diagram.originalSource.space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Reduced.At[z := z].Carrier, W := Original.With[coefficients := coefficients].At[z := z].Carrier, source := Reduced.At[z := z].space, target := Original.With[coefficients := coefficients].At[z := z].space].Isomorphism :=
  Composition.compose relativeIsomorphism (Inverse.inverse TargetComparison.reducedIsomorphism);
