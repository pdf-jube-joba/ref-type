\definition neighborhoodIsomorphism: Modules.Isomorphism[V := Original.Homology[z := z].Carrier, W := Expanded.Homology[z := z].Carrier,
    source := Original.Homology[z := z].space, target := Expanded.Homology[z := z].space].Isomorphism :=
      Action.Comparison[].At[z := z].isomorphism subspaceQuasi wholeQuasi;
\import \parent.\parent.QuotientSquare[pair := pair].Homology[z := z] \as Diagram;
\import \parent.\parent.QuotientPoint[pair := pair].Comparison[].Homology[z := z] \as TargetComparison;
\import \parent.\parent.Excision[pair := pair].Homology[z := z] \as ExpandedComparison;
\import Modules.IsomorphismSquare[A := Diagram.expandedSource, B := Diagram.expandedTarget, C := Diagram.originalSource, D := Diagram.originalTarget] \as Transport;
\definition relativeIsomorphism: Modules.Isomorphism[V := Diagram.originalSource.Carrier, W := Diagram.originalTarget.Carrier, source := Diagram.originalSource.space, target := Diagram.originalTarget.space].Isomorphism :=
  Transport.incoming neighborhoodIsomorphism TargetComparison.isomorphism ExpandedComparison.isomorphism Diagram.quotient (\fun (q: Diagram.originalSource.Carrier) => sym!{Diagram.expandedTarget.Carrier} _ _ (Diagram.law q));
\import algebraic_topology.Collapse[A := A, subset := subset] \as Quotient;
\import singular_cohomology.Chains[A := Quotient.Carrier, source := Quotient.topology source].Reduced[] \as Reduced;
\import Modules.Isomorphism[V := Reduced.At[z := z].Carrier, W := Diagram.originalTarget.Carrier, source := Reduced.At[z := z].space, target := Diagram.originalTarget.space].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := Diagram.originalSource.Carrier, W := Diagram.originalTarget.Carrier, source := Diagram.originalSource.space, target := Diagram.originalTarget.space]
  .Composition[U := Reduced.At[z := z].Carrier, final := Reduced.At[z := z].space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Original.Homology[z := z].Carrier, W := Reduced.At[z := z].Carrier, source := Original.Homology[z := z].space, target := Reduced.At[z := z].space].Isomorphism :=
  Composition.compose (Inverse.inverse TargetComparison.reducedIsomorphism) relativeIsomorphism;
