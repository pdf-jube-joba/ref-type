\import \parent.\parent.Square[].With[coefficients := coefficients].At[z := z] \as Diagram;
\import SourceExcision.With[coefficients := coefficients].At[z := z] \as SourceTheory;
\import TargetExcision.With[coefficients := coefficients].At[z := z] \as TargetTheory;
\import Homeomorphisms.With[coefficients := coefficients].At[z := z] \as Complement;
\definition sourceComparison: Modules.Isomorphism[V := Diagram.wholeSource.Carrier, W := Diagram.cutSource.Carrier, source := Diagram.wholeSource.space, target := Diagram.cutSource.space].Isomorphism := SourceTheory.isomorphism sourcePair;
\definition targetComparison: Modules.Isomorphism[V := Diagram.wholeTarget.Carrier, W := Diagram.cutTarget.Carrier, source := Diagram.wholeTarget.space, target := Diagram.cutTarget.space].Isomorphism := TargetTheory.isomorphism targetPair;
\definition complementComparison: Modules.Isomorphism[V := Diagram.cutTarget.Carrier, W := Diagram.cutSource.Carrier, source := Diagram.cutTarget.space, target := Diagram.cutSource.space].Isomorphism := Complement.isomorphism homeomorphismData;
\import Modules.IsomorphismSquare[A := Diagram.cutTarget, B := Diagram.cutSource, C := Diagram.wholeTarget, D := Diagram.wholeSource] \as Transport;
\definition induced: Modules.MapBetween Diagram.wholeTarget Diagram.wholeSource := Diagram.quotient;
\definition isomorphism: Modules.Isomorphism[V := Diagram.wholeTarget.Carrier, W := Diagram.wholeSource.Carrier, source := Diagram.wholeTarget.space, target := Diagram.wholeSource.space].Isomorphism := Transport.incoming targetComparison sourceComparison complementComparison Diagram.quotient Diagram.law;
