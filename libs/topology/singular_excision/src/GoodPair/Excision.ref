\import Geometry.On[pair := pair] \as Topology;
\import topology.Topology[Carrier := A] \as Space;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\import Space.Closure[] \as Closure;
\import Space.Interior[] \as Interior;
\import algebraic_topology.Collapse[A := A, subset := subset] \as Quotient;
\import Quotient.Pointed[point := Topology.point] \as Pointed;
\import Quotient.Open[source := source].On[neighborhood := Topology.neighborhood] \as NeighborhoodQuotient;
\import topology.Topology[Carrier := Quotient.Carrier] \as QuotientSpace;
\import QuotientSpace.Closure[] \as QuotientClosure;
\import QuotientSpace.Interior[] \as QuotientInterior;
\definition basepoint: Quotient.Carrier := Quotient.class Topology.point;
\definition image: \Pow Quotient.Carrier := NeighborhoodQuotient.image;
\definition imageContains: QuotientSpace.Member image basepoint := NeighborhoodQuotient.toImage Topology.point
  (#contains{Topology.neighborhood} Topology.point (\bysub(A, subset, Topology.point)));
\import \root.Excision[A := A].Over[source := source] \as SourceExcision;
\definition sourcePair: SourceExcision.Pair := \into[SourceExcision.PairData](SourceExcision.PairData { subset := Topology.region, removed := subset }, SourceExcision.Pair) \by {
  \fun (x: A)(member: Space.Member (Closure.closure source subset) x) =>
    Interior.greatest source Topology.region Topology.region #open{Topology.neighborhood} (\fun (x: A)(member: Space.Member Topology.region x) => member) x
      (#contains{Topology.neighborhood} x (Closure.least source subset subset #closed{pair} (\fun (x: A)(member: Space.Member subset x) => member) x member))
};
\import \root.Excision[A := Quotient.Carrier].Over[source := Quotient.topology source] \as TargetExcision;
\definition targetPair: TargetExcision.Pair := \into[TargetExcision.PairData](TargetExcision.PairData { subset := image, removed := QuotientSpace.Singleton basepoint }, TargetExcision.Pair) \by {
  \fun (q: Quotient.Carrier)(member: QuotientSpace.Member (QuotientClosure.closure (Quotient.topology source) (QuotientSpace.Singleton basepoint)) q) =>
    QuotientInterior.greatest (Quotient.topology source) image image NeighborhoodQuotient.imageOpen (\fun (q: Quotient.Carrier)(member: QuotientSpace.Member image q) => member) q
      (\idelim basepoint = q \with z: Quotient.Carrier => QuotientSpace.Member image z \by {
        base: imageContains,
        equality: sym!{Quotient.Carrier} _ _ (QuotientClosure.least (Quotient.topology source) (QuotientSpace.Singleton basepoint) (QuotientSpace.Singleton basepoint)
          (Pointed.closed source #closed{pair}) (\fun (q: Quotient.Carrier)(member: q = basepoint) => member) q member)
      })
};
\import Space.Subspace[S := Space.Complement subset] \as SourceComplement;
\import QuotientSpace.Subspace[S := QuotientSpace.Complement (QuotientSpace.Singleton basepoint)] \as TargetComplement;
\definition sourceSubset: \Pow SourceComplement.CarrierSet := { x: SourceComplement.CarrierSet \where Space.Member Topology.region x };
\definition targetSubset: \Pow TargetComplement.CarrierSet := { x: TargetComplement.CarrierSet \where QuotientSpace.Member image x };
\import singular_cohomology.Relative[A := SourceComplement.CarrierSet, source := SourceComplement.topology source, subset := sourceSubset] \as SourceRelative;
\import singular_cohomology.Relative[A := TargetComplement.CarrierSet, source := TargetComplement.topology (Quotient.topology source), subset := targetSubset] \as TargetRelative;
\import SourceRelative.Homeomorphism[B := TargetComplement.CarrierSet].Over[target := TargetComplement.topology (Quotient.topology source), targetSubset := targetSubset] \as Homeomorphisms;
\import Pointed.Outside[] \as Outside;
\import topology.Homeomorphism[A := SourceComplement.CarrierSet, B := TargetComplement.CarrierSet] \as Geometry;
\definition homeomorphism: Geometry.Homeomorphism[SourceComplement.topology source, TargetComplement.topology (Quotient.topology source)] := Outside.homeomorphism source #closed{pair};
\definition homeomorphismLaws: Geometry.Laws[SourceComplement.topology source, TargetComplement.topology (Quotient.topology source), homeomorphism] :=
  Geometry.laws (SourceComplement.topology source) (TargetComplement.topology (Quotient.topology source)) homeomorphism;
\definition homeomorphismData: Homeomorphisms.Data := Homeomorphisms.Data {
  homeomorphism := homeomorphism,
  forwardPreserves := \fun (x: SourceRelative.SubspaceCarrier) =>
    \idelim Quotient.class x = #forward{homeomorphism} x \with q: Quotient.Carrier => QuotientSpace.Member image q \by {
      base: NeighborhoodQuotient.toImage x (\bysub(SourceComplement.CarrierSet, sourceSubset, x)),
      equality: sym!{Quotient.Carrier} _ _ (Outside.onPoint source #closed{pair} x)
    },
  backwardPreserves := \fun (y: TargetRelative.SubspaceCarrier) => NeighborhoodQuotient.fromImage (#backward{homeomorphism} y)
    (\idelim y = Quotient.class (#backward{homeomorphism} y) \with q: Quotient.Carrier => QuotientSpace.Member image q \by {
      base: \bysub(TargetComplement.CarrierSet, targetSubset, y),
      equality: sym!{Quotient.Carrier} _ _ (#rightInverse{homeomorphismLaws} y)
    }),
};

\module Square;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\module Homology(z: I.Int^);
\module With(coefficients: Modules.Bundle) {
  \module At(z: I.Int^);
}
