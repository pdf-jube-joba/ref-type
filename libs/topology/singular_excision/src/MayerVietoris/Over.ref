\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Logic.either;
\structure Data: \Set { left: \Pow A, right: \Pow A }
\structure Laws[data: Data]: \Prop {
  leftOpen: Top.IsOpenIn source data.left,
  rightOpen: Top.IsOpenIn source data.right,
  covered: \forall (x: A) -> Logic.Or[Top.Member data.left x, Top.Member data.right x],
}
\definition Cover: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition laws(cover: Cover): Laws[cover] := \bysub(Data, { data: Data \where Laws[data] }, cover);
\module On(cover: Cover);
