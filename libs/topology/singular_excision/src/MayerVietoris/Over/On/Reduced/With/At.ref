\definition upper: I.Int^ := Degrees.next z;
\import IntersectionTheory.At[z := z] \as Source;
\import Whole.At[z := upper] \as Target;
\import Local.With[coefficients := coefficients].At[z := upper] \as LocalH;
\import Global.With[coefficients := coefficients].At[z := upper] \as GlobalH;
\import singular_cohomology.Relative[A := Remaining, source := RemainingTopology.topology source, subset := trace].With[coefficients := coefficients].At[z := upper] \as RemainingH;
\import Modules.Isomorphism[V := GlobalH.Carrier, W := RemainingH.Carrier, source := GlobalH.space, target := RemainingH.space]
  .Composition[U := LocalH.Carrier, final := LocalH.space] \as CutComposition;
\definition cut: Modules.Isomorphism[V := GlobalH.Carrier, W := LocalH.Carrier, source := GlobalH.space, target := LocalH.space].Isomorphism :=
  CutComposition.compose (Pairs.With[coefficients := coefficients].At[z := upper].isomorphism pairHomeomorphism)
    (Excision.With[coefficients := coefficients].At[z := upper].isomorphism excision);
\import Modules.Isomorphism[V := GlobalH.Carrier, W := LocalH.Carrier, source := GlobalH.space, target := LocalH.space].Inverse[] \as CutInverse;
\import Modules.Isomorphism[V := Source.Carrier, W := LocalH.Carrier, source := Source.space, target := LocalH.space]
  .Composition[U := GlobalH.Carrier, final := GlobalH.space] \as First;
\import Modules.Isomorphism[V := Source.Carrier, W := GlobalH.Carrier, source := Source.space, target := GlobalH.space]
  .Composition[U := Target.Carrier, final := Target.space] \as Second;
\definition isomorphism[leftContraction: LeftContractions.Data][rightContraction: RightContractions.Data]:
  Modules.Isomorphism[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Isomorphism :=
  Second.compose (Comparison.At[z := upper].isomorphism rightContraction)
    (First.compose (CutInverse.inverse cut) (Connecting.At[z := z].isomorphism leftContraction));
