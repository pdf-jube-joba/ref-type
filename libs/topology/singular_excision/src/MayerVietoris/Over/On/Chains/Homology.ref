\import chain_complexes.Chain[] \as Degrees;
\import Degrees.Over[R := I.Int^, ring := Integers.ring] \as Integer;
\import singular_cohomology.Chains[A := A, source := source] \as Whole;
\import singular_cohomology.OpenCover[A := A, source := source].On[cover := openCover] \as Covered;
\import Complexes.ZeroExtension[C := Small.complex] \as SmallExtension;
\import Complexes.ZeroExtension[C := Whole.complex] \as WholeExtension;
\import Complexes.ZeroExtension[C := Sum.complex] \as SumExtension;
\import Complexes.ZeroExtension[C := IntersectionChains.complex] \as IntersectionExtension;
\import Complexes.Equivalence[C := Small.complex, D := Whole.complex].ZeroExtension[e := Covered.equivalence] \as Comparison;
\import Complexes.Map[C := Sum.complex, D := Small.complex].ZeroExtension[f := projection] \as Projection;
\import Complexes.Map[C := IntersectionChains.complex, D := Sum.complex].ZeroExtension[f := inclusion] \as Inclusion;
\import Integer.ShortExact[A := IntersectionExtension.complex, B := SumExtension.complex, C := SmallExtension.complex] \as Exact;
\import \parent.Sequence[] \as Sequence;
\import Sum.Integer[] \as SumComparison;
\module Degree(z: I.Int^) {
  \import Integer.At[C := SmallExtension.complex, z := z] \as SmallH;
  \import Integer.At[C := WholeExtension.complex, z := z] \as WholeH;
  \import Integer.At[C := SumExtension.complex, z := z] \as SumH;
  \import Integer.At[C := IntersectionExtension.complex, z := z] \as IntersectionH;
  \definition small: Modules.Bundle := Modules.Bundle { Carrier := SmallH.Homology, space := SmallH.homologySpace };
  \definition whole: Modules.Bundle := Modules.Bundle { Carrier := WholeH.Homology, space := WholeH.homologySpace };
  \definition sum: Modules.Bundle := Modules.Bundle { Carrier := SumH.Homology, space := SumH.homologySpace };
  \definition intersection: Modules.Bundle := Modules.Bundle { Carrier := IntersectionH.Homology, space := IntersectionH.homologySpace };
  \definition comparison: Modules.Isomorphism[V := small.Carrier, W := whole.Carrier, source := small.space, target := whole.space].Isomorphism := Comparison.At[z := z].isomorphism;
  \definition directSum: Modules.Bundle := Modules.Bundle { Carrier := SumComparison.Homology[z := z].Carrier, space := SumComparison.Homology[z := z].space };
  \definition sumComparison: Modules.Isomorphism[V := sum.Carrier, W := directSum.Carrier, source := sum.space, target := directSum.space].Isomorphism := SumComparison.Homology[z := z].isomorphism;
  \definition intersectionIdentity: _ := Modules.Identity[V := intersection.Carrier, space := intersection.space].isomorphism;
  \import Integer.Map[C := SumExtension.complex, D := SmallExtension.complex].At[k := z] \as ProjectionAt;
  \import Integer.Map[C := IntersectionExtension.complex, D := SumExtension.complex].At[k := z] \as InclusionAt;
  \definition projection: Modules.MapBetween sum small := ProjectionAt.induced Projection.map;
  \definition inclusion: Modules.MapBetween intersection sum := InclusionAt.induced Inclusion.map;
}
\module At(z: I.Int^);
