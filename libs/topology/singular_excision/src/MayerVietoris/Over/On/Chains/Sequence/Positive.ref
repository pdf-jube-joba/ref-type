\import \parent.\parent.Degree[n := n] \as Native;
\definition degree: I.Int^ := I.Int^::ofNat n;
\definition sub(x: IntersectionChains.Carrier n): Sub.Carrier degree := Sub.Positive[n := n].intro x;
\definition middle(x: Sum.Carrier n): Middle.Carrier degree := Middle.Positive[n := n].intro x;
\definition target(x: Small.Carrier n): Target.Carrier degree := Target.Positive[n := n].intro x;
\definition injective: \forall (x, y: Sub.Carrier degree) -> #apply{Inclusion.map} degree x = #apply{Inclusion.map} degree y -> x = y :=
  \fun (x, y: Sub.Carrier degree)(same: _) => congr!{{IntersectionChains.Carrier n} {Sub.Carrier degree}} sub _ _
    (Native.injective x y (congr!{{Middle.Carrier degree} {Sum.Carrier n}} (\fun (a: Middle.Carrier degree) => a) _ _ same));
\definition onto: \forall (x: Target.Carrier degree) -> \exists { y: Middle.Carrier degree \where #apply{Projection.map} degree y = x } := \block {
  \fun (x: Target.Carrier degree) \then
  \takefrom y: \Cast[Sum.Carrier n] ({ y: Sum.Carrier n \where #apply{projection} n y = x }) \by Native.onto x \then
  \return Logic.existsIntro[Middle.Carrier degree, { z: Middle.Carrier degree \where #apply{Projection.map} degree z = x }] (middle y)
    (congr!{{Small.Carrier n} {Target.Carrier degree}} target _ _ (\bysub(Sum.Carrier n, { y: Sum.Carrier n \where #apply{projection} n y = x }, y)))
};
\definition zero: \forall (x: Sub.Carrier degree) -> #apply{Projection.map} degree (#apply{Inclusion.map} degree x) = #zero{(Target.space degree)} :=
  \fun (x: Sub.Carrier degree) => congr!{{Small.Carrier n} {Target.Carrier degree}} target _ _ (Native.zero x);
\definition kernelImage: \forall (y: Middle.Carrier degree) -> #apply{Projection.map} degree y = #zero{(Target.space degree)} ->
  \exists { x: Sub.Carrier degree \where #apply{Inclusion.map} degree x = y } := \block {
  \fun (y: Middle.Carrier degree)(closed: #apply{Projection.map} degree y = #zero{(Target.space degree)}) \then
  \takefrom x: \Cast[IntersectionChains.Carrier n] ({ x: IntersectionChains.Carrier n \where #apply{inclusion} n x = y })
    \by Native.kernelImage y (congr!{{Target.Carrier degree} {Small.Carrier n}} (\fun (a: Target.Carrier degree) => a) _ _ closed) \then
  \return Logic.existsIntro[Sub.Carrier degree, { w: Sub.Carrier degree \where #apply{Inclusion.map} degree w = y }] (sub x)
    (congr!{{Sum.Carrier n} {Middle.Carrier degree}} middle _ _ (\bysub(IntersectionChains.Carrier n, { x: IntersectionChains.Carrier n \where #apply{inclusion} n x = y }, x)))
};
