\import singular_cohomology.Simplices[A := Left, source := LeftTopology.topology source] \as LeftSimplices;
\import singular_cohomology.Simplices[A := Right, source := RightTopology.topology source] \as RightSimplices;
\import singular_cohomology.Simplices[A := Intersection, source := IntersectionTopology.topology (LeftTopology.topology source)] \as IntersectionSimplices;
\import singular_cohomology.Simplices[A := A, source := source] \as WholeSimplices;
\import Small.Simplices[] \as SmallSimplices;
\definition leftFunction: LeftSimplices.Carrier n -> SmallSimplices.Carrier n := LeftSmall.At[n := n].simplex;
\definition rightFunction: RightSimplices.Carrier n -> SmallSimplices.Carrier n := RightSmall.At[n := n].simplex;
\definition topFunction: IntersectionSimplices.Carrier n -> LeftSimplices.Carrier n := LeftMaps.postcompose n toLeft leftContinuous;
\definition bottomFunction: IntersectionSimplices.Carrier n -> RightSimplices.Carrier n := RightMaps.postcompose n toRight rightContinuous;
\import Modules.FreePullback[Left := LeftSimplices.Carrier n, Right := RightSimplices.Carrier n, Overlap := IntersectionSimplices.Carrier n, Whole := SmallSimplices.Carrier n] \as Sets;
\definition data: Sets.Data := Sets.Data { left := leftFunction, right := rightFunction, overLeft := topFunction, overRight := bottomFunction };
\definition leftInjective: \forall (sigma, tau: LeftSimplices.Carrier n) -> leftFunction sigma = leftFunction tau -> sigma = tau :=
  \fun (sigma, tau: LeftSimplices.Carrier n)(same: leftFunction sigma = leftFunction tau) => \axiom:funext(sigma, tau,
    \fun (x: Simplex.Carrier n) => congr!{{SmallSimplices.Carrier n} A} (\fun (s: SmallSimplices.Carrier n) => s x) _ _ same);
\definition rightInjective: \forall (sigma, tau: RightSimplices.Carrier n) -> rightFunction sigma = rightFunction tau -> sigma = tau :=
  \fun (sigma, tau: RightSimplices.Carrier n)(same: rightFunction sigma = rightFunction tau) => \axiom:funext(sigma, tau,
    \fun (x: Simplex.Carrier n) => congr!{{SmallSimplices.Carrier n} A} (\fun (s: SmallSimplices.Carrier n) => s x) _ _ same);
\definition bottomInjective: \forall (sigma, tau: IntersectionSimplices.Carrier n) -> bottomFunction sigma = bottomFunction tau -> sigma = tau :=
  \fun (sigma, tau: IntersectionSimplices.Carrier n)(same: bottomFunction sigma = bottomFunction tau) => \axiom:funext(sigma, tau,
    \fun (x: Simplex.Carrier n) => congr!{{RightSimplices.Carrier n} A} (\fun (s: RightSimplices.Carrier n) => s x) _ _ same);
\definition commutes: \forall (sigma: IntersectionSimplices.Carrier n) -> leftFunction (topFunction sigma) = rightFunction (bottomFunction sigma) :=
  \fun (sigma: IntersectionSimplices.Carrier n) => \axiom:funext(leftFunction (topFunction sigma), rightFunction (bottomFunction sigma), \fun (x: Simplex.Carrier n) => \refl((\fun (a: A) => a) (sigma x)));
\module Cartesian;
\definition square: Sets.Square := \into[Sets.Data](data, Sets.Square) \by {
  Sets.Laws[data] { leftInjective := leftInjective, overlapInjective := bottomInjective, commutes := commutes, cartesian := Cartesian[].law }
};
\module Covered;
\definition union: Sets.Union := \into[Sets.Square](square, Sets.Union) \by {
  Sets.UnionLaws[square] { rightInjective := rightInjective, covered := Covered[].law }
};
\import Sets.Covering[square := union] \as Exact;
\definition zero: \forall (x: IntersectionChains.Carrier n) -> (projection).apply n ((inclusion).apply n x) = (Small.space n).zero := Exact.zero;
\definition injective: \forall (x, y: IntersectionChains.Carrier n) -> (inclusion).apply n x = (inclusion).apply n y -> x = y := Exact.injective;
\definition onto: \forall (x: Small.Carrier n) -> \exists ( y: Sum.Carrier n \where (projection).apply n y = x ) := Exact.Surjection[].onto;
\definition kernelImage: \forall (y: Sum.Carrier n) -> (projection).apply n y = (Small.space n).zero ->
  \exists ( x: IntersectionChains.Carrier n \where (inclusion).apply n x = y ) := Exact.Kernel[].law;

\definition retraction: Modules.Hom[V := Sum.Carrier n, W := IntersectionChains.Carrier n, source := Sum.space n, target := IntersectionChains.space n].Map := Exact.Retraction[].map;
\definition leftInverse: \forall (x: IntersectionChains.Carrier n) -> (retraction).apply ((inclusion).apply n x) = x := Exact.Retraction[].leftInverse;
