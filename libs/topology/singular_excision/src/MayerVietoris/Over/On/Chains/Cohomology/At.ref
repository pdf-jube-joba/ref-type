\import \parent.Degree[z := z] \as Current;
\import \parent.Degree[z := Degrees.next z] \as Upper;
\import Exact.At[s := SmallSequence.sequence, k := z] \as Native;
\import Native.Exactness[] \as Exactness;
\import Modules.ExactPair[A := Current.small, B := Current.sum, C := Current.intersection] \as SumExact;
\definition atSum: SumExact.Sequence := SumExact.Sequence {
  first := Current.inclusion, last := Current.projection, zero := Exactness.inclusionProjectionZero, kernelImage := Exactness.exactAtB,
};
\import SumExact.Reindex[A1 := Current.whole, B1 := Current.directSum, C1 := Current.intersection, sequence := atSum, a := Current.comparison, b := Current.sumComparison, c := Current.intersectionIdentity] \as SumTransport;
\definition exactAtSum: _ := SumTransport.transported;
\import Modules.ExactPair[A := Current.sum, B := Current.intersection, C := Upper.small] \as IntersectionExact;
\definition atIntersection: IntersectionExact.Sequence := IntersectionExact.Sequence {
  first := Current.projection, last := Native.connecting, zero := Exactness.projectionConnectingZero, kernelImage := Exactness.exactAtC,
};
\import IntersectionExact.Reindex[A1 := Current.directSum, B1 := Current.intersection, C1 := Upper.whole, sequence := atIntersection, a := Current.sumComparison, b := Current.intersectionIdentity, c := Upper.comparison] \as IntersectionTransport;
\definition exactAtIntersection: _ := IntersectionTransport.transported;
\import Modules.ExactPair[A := Current.intersection, B := Upper.small, C := Upper.sum] \as WholeExact;
\definition atWhole: WholeExact.Sequence := WholeExact.Sequence {
  first := Native.connecting, last := Upper.inclusion, zero := Exactness.connectingInclusionZero, kernelImage := Exactness.exactAtALower,
};
\import WholeExact.Reindex[A1 := Current.intersection, B1 := Upper.whole, C1 := Upper.directSum, sequence := atWhole, a := Current.intersectionIdentity, b := Upper.comparison, c := Upper.sumComparison] \as WholeTransport;
\definition exactAtWhole: _ := WholeTransport.transported;
\definition restriction: _ := SumTransport.first;
\definition difference: _ := SumTransport.last;
\definition connecting: _ := IntersectionTransport.last;
