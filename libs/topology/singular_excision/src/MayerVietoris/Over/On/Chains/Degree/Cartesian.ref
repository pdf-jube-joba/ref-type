\definition Contained(sigma: LeftSimplices.Carrier n): \Prop := \forall (x: Simplex.Carrier n) -> Top.Member right (sigma x);
\definition contained: \forall (sigma: LeftSimplices.Carrier n)(tau: RightSimplices.Carrier n) -> leftFunction sigma = rightFunction tau -> Contained sigma :=
  \fun (sigma: LeftSimplices.Carrier n)(tau: RightSimplices.Carrier n)(same: leftFunction sigma = rightFunction tau)(x: Simplex.Carrier n) =>
    \idelim (\fun (a: A) => a) (tau x) = (\fun (a: A) => a) (sigma x) \with a: A => Top.Member right a \by {
      base: \bysub(A, right, tau x),
      equality: sym!{A} _ _ (congr!{{SmallSimplices.Carrier n} A} (\fun (s: SmallSimplices.Carrier n) => s x) _ _ same)
    };
\definition function(sigma: LeftSimplices.Carrier n)(inside: Contained sigma)(x: Simplex.Carrier n): Intersection :=
  \into[Left](sigma x, intersection) \by { inside x };
\import topology.Continuity[A := Simplex.Carrier n, B := Left].Corestriction[S := intersection] \as Into;
\import Simplex.At[n := n] \as Domain;
\definition lift(sigma: LeftSimplices.Carrier n)(inside: Contained sigma): IntersectionSimplices.Carrier n :=
  \into[IntersectionSimplices.At[n := n].Function](function sigma inside, IntersectionSimplices.Carrier n) \by {
    Into.corestrictContinuous Domain.topology (LeftTopology.topology source) (function sigma inside) (LeftSimplices.At[n := n].continuous sigma)
  };
\definition law: \forall (sigma: LeftSimplices.Carrier n)(tau: RightSimplices.Carrier n) -> leftFunction sigma = rightFunction tau ->
  \exists { rho: IntersectionSimplices.Carrier n \where Logic.And[topFunction rho = sigma, bottomFunction rho = tau] } :=
  \fun (sigma: LeftSimplices.Carrier n)(tau: RightSimplices.Carrier n)(same: leftFunction sigma = rightFunction tau) =>
    Logic.existsIntro[IntersectionSimplices.Carrier n, { rho: IntersectionSimplices.Carrier n \where Logic.And[topFunction rho = sigma, bottomFunction rho = tau] }]
      (lift sigma (contained sigma tau same)) (Logic.And[_, _]::#
        (\axiom:funext(topFunction (lift sigma (contained sigma tau same)), sigma, \fun (x: Simplex.Carrier n) => \refl(sigma x)))
        (\axiom:funext(bottomFunction (lift sigma (contained sigma tau same)), tau, \fun (x: Simplex.Carrier n) =>
          congr!{{SmallSimplices.Carrier n} A} (\fun (s: SmallSimplices.Carrier n) => s x) _ _ same)));
