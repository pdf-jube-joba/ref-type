\definition degree: I.Int^ := I.Int^::negSucc n;
\definition onto: \forall (x: Target.Carrier degree) -> \exists { y: Middle.Carrier degree \where #apply{Projection.map} degree y = x } :=
  \fun (x: Target.Carrier degree) => Logic.existsIntro[Middle.Carrier degree, { y: Middle.Carrier degree \where #apply{Projection.map} degree y = x }]
    #zero{(Middle.space degree)} (sym!{{Target.Carrier degree}} _ _ (Target.Negative[n := n].zero x));
\definition kernelImage: \forall (y: Middle.Carrier degree) -> #apply{Projection.map} degree y = #zero{(Target.space degree)} ->
  \exists { x: Sub.Carrier degree \where #apply{Inclusion.map} degree x = y } :=
  \fun (y: Middle.Carrier degree)(closed: _) => Logic.existsIntro[Sub.Carrier degree, { x: Sub.Carrier degree \where #apply{Inclusion.map} degree x = y }]
    #zero{(Sub.space degree)} (sym!{{Middle.Carrier degree}} _ _ (Middle.Negative[n := n].zero y));
