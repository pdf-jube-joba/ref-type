\import Complexes.QuotientMapping[C := SourceSubspace.complex, D := SourceSpace.complex,
  C1 := TargetSubspace.complex, D1 := TargetSpace.complex]
  .Image[f := SourceInclusion.map, g := TargetInclusion.map, b := Ambient.map] \as QuotientMap;
\definition compatible: QuotientMap.Compatible := \induction (z: I.Int^) \return \forall (x: SourceSpace.Carrier z) ->
  Modules.Of[V := SourceSpace.Carrier z, space := SourceSpace.space z].Submodule[].Member SourceQuotient.At[k := z].image x ->
  Modules.Of[V := TargetSpace.Carrier z, space := TargetSpace.space z].Submodule[].Member TargetQuotient.At[k := z].image (#apply{Ambient.map} z x) \with {
    | ofNat: \fun (n: N.Nat^) => \parent.Preservation[n := n].law
    | negSucc: \fun (n: N.Nat^)(x: SourceSpace.Carrier (I.Int^::negSucc n))(member: _) => #zero{TargetQuotient.At[k := I.Int^::negSucc n].image}
  };
\definition map: Complexes.Map[C := SourceQuotient.complex, D := TargetQuotient.complex].Map := QuotientMap.map compatible;
\module At(z: I.Int^) {
  \definition onClass: _ := QuotientMap.At[k := z].onClass compatible;
}
