\import \parent.Complement[] \as Complement;
\import \parent.\parent.Mapping[] \as Mapping;
\import Complexes.Map[C := SourceQuotient.complex, D := TargetQuotient.complex].At[k := index] \as Actions;
\import Modules.Hom[V := SourceQuotient.Carrier index, W := TargetQuotient.Carrier index, source := SourceQuotient.space index, target := TargetQuotient.space index]
  .Composition[U := SourceBasis.Carrier, domain := SourceBasis.space] \as AfterSource;
\import Modules.Hom[V := TargetBasis.Carrier, W := TargetQuotient.Carrier index, source := TargetBasis.space, target := TargetQuotient.space index]
  .Composition[U := SourceBasis.Carrier, domain := SourceBasis.space] \as AfterBasis;
\use Equality.eq_reason;
\definition onGenerator: \forall (sigma: SourceComplement) ->
  #apply{Mapping.map} index (#apply{#forward{sourceIsomorphism}} (SourceBasis.generator sigma)) =
  #apply{#forward{targetIsomorphism}} (#apply{#forward{Complement.isomorphism}} (SourceBasis.generator sigma)) :=
  \fun (sigma: SourceComplement) => eq_reason!{
    {#apply{Mapping.map} index (#apply{#forward{sourceIsomorphism}} (SourceBasis.generator sigma))}
    "=" {#apply{Mapping.map} index (SourceQuotient.At[k := index].class (SourceSpace.Positive[n := n].intro (SourceSmall.generator n sigma)))}
    "by" {congr!{{SourceQuotient.Carrier index} {TargetQuotient.Carrier index}} (#apply{Mapping.map} index) _ _ (sourceOnGenerator sigma)}
    "=" {TargetQuotient.At[k := index].class (#apply{Ambient.map} index (SourceSpace.Positive[n := n].intro (SourceSmall.generator n sigma)))}
    "by" {Mapping.At[z := index].onClass (SourceSpace.Positive[n := n].intro (SourceSmall.generator n sigma))}
    "=" {TargetQuotient.At[k := index].class (TargetSpace.Positive[n := n].intro (TargetSmall.generator n (ambient sigma)))}
    "by" {congr!{{TargetSmall.Carrier n} {TargetQuotient.Carrier index}}
      (\fun (x: TargetSmall.Carrier n) => TargetQuotient.At[k := index].class (TargetSpace.Positive[n := n].intro x)) _ _ (Remaining.Degree[n := n].onGenerator sigma)}
    "=" {#apply{#forward{targetIsomorphism}} (TargetBasis.generator (Complement.map sigma))}
    "by" {sym!{{TargetQuotient.Carrier index}} _ _ (targetOnGenerator (Complement.map sigma))}
    "=" {#apply{#forward{targetIsomorphism}} (#apply{#forward{Complement.isomorphism}} (SourceBasis.generator sigma))}
    "by" {congr!{TargetBasis.Carrier {TargetQuotient.Carrier index}} (#apply{#forward{targetIsomorphism}}) _ _
      (sym!{TargetBasis.Carrier} _ _ (Complement.onGenerator sigma))}
  };
\definition equation: AfterSource.compose (Actions.linear Mapping.map) #forward{sourceIsomorphism} =
  AfterBasis.compose #forward{targetIsomorphism} #forward{Complement.isomorphism} :=
    Modules.Free[Generators := SourceComplement].To[W := TargetQuotient.Carrier index, target := TargetQuotient.space index].ext _ _ onGenerator;
\import Modules.Isomorphism[V := SourceBasis.Carrier, W := SourceQuotient.Carrier index, source := SourceBasis.space, target := SourceQuotient.space index].Inverse[] \as SourceInverse;
\import Modules.Isomorphism[V := SourceQuotient.Carrier index, W := SourceBasis.Carrier, source := SourceQuotient.space index, target := SourceBasis.space]
  .Composition[U := TargetBasis.Carrier, final := TargetBasis.space] \as IntoBasis;
\definition middle: Modules.Isomorphism[V := SourceQuotient.Carrier index, W := TargetBasis.Carrier, source := SourceQuotient.space index, target := TargetBasis.space].Isomorphism :=
  IntoBasis.compose Complement.isomorphism (SourceInverse.inverse sourceIsomorphism);
\import Modules.Isomorphism[V := SourceQuotient.Carrier index, W := TargetBasis.Carrier, source := SourceQuotient.space index, target := TargetBasis.space]
  .Composition[U := TargetQuotient.Carrier index, final := TargetQuotient.space index] \as IntoRelative;
\import Modules.Isomorphism[V := SourceQuotient.Carrier index, W := TargetQuotient.Carrier index, source := SourceQuotient.space index, target := TargetQuotient.space index] \as Iso;
\definition candidate: Iso.Isomorphism := IntoRelative.compose targetIsomorphism middle;
\import Modules.Hom[V := SourceBasis.Carrier, W := TargetQuotient.Carrier index, source := SourceBasis.space, target := TargetQuotient.space index] \as Maps;
\definition forwardEquality: \forall (x: SourceQuotient.Carrier index) -> #apply{Mapping.map} index x = #apply{#forward{candidate}} x :=
  \fun (x: SourceQuotient.Carrier index) => trans!{{TargetQuotient.Carrier index}} _ _ _
    (congr!{{SourceQuotient.Carrier index} {TargetQuotient.Carrier index}} (#apply{Mapping.map} index) _ _
      (sym!{{SourceQuotient.Carrier index}} _ _ (#rightInverse{sourceIsomorphism} x)))
    (congr!{Maps.Map {TargetQuotient.Carrier index}} (\fun (f: Maps.Map) => #apply{f} (#apply{#backward{sourceIsomorphism}} x)) _ _ equation);
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := Actions.linear Mapping.map, backward := #backward{candidate},
  leftInverse := \fun (x: SourceQuotient.Carrier index) => trans!{{SourceQuotient.Carrier index}} _ _ _
    (congr!{{TargetQuotient.Carrier index} {SourceQuotient.Carrier index}} (#apply{#backward{candidate}}) _ _ (forwardEquality x)) (#leftInverse{candidate} x),
  rightInverse := \fun (y: TargetQuotient.Carrier index) => trans!{{TargetQuotient.Carrier index}} _ _ _
    (forwardEquality (#apply{#backward{candidate}} y)) (#rightInverse{candidate} y),
};
\definition injective: \forall (x, y: SourceQuotient.Carrier index) -> #apply{Mapping.map} index x = #apply{Mapping.map} index y -> x = y :=
  \fun (x, y: SourceQuotient.Carrier index)(same: #apply{Mapping.map} index x = #apply{Mapping.map} index y) => trans!{{SourceQuotient.Carrier index}} _ _ _
    (sym!{{SourceQuotient.Carrier index}} _ _ (#leftInverse{isomorphism} x))
    (trans!{{SourceQuotient.Carrier index}} _ _ _ (congr!{{TargetQuotient.Carrier index} {SourceQuotient.Carrier index}} (#apply{#backward{isomorphism}}) _ _ same) (#leftInverse{isomorphism} y));
\definition onto: \forall (y: TargetQuotient.Carrier index) -> \exists { x: SourceQuotient.Carrier index \where #apply{Mapping.map} index x = y } :=
  \fun (y: TargetQuotient.Carrier index) => Logic.existsIntro[SourceQuotient.Carrier index, { x: SourceQuotient.Carrier index \where #apply{Mapping.map} index x = y }]
    (#apply{#backward{isomorphism}} y) (#rightInverse{isomorphism} y);
