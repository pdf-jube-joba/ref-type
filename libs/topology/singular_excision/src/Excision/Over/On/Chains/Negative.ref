\definition index: I.Int^ := I.Int^::negSucc n;
\import \parent.Mapping[] \as Mapping;
\definition sourceZero: \forall (q: SourceQuotient.Carrier index) -> q = #zero{(SourceQuotient.space index)} :=
  SourceQuotient.At[k := index].induction (\fun (q: SourceQuotient.Carrier index) => q = #zero{(SourceQuotient.space index)})
    (\fun (x: SourceSpace.Carrier index) => congr!{{SourceSpace.Carrier index} {SourceQuotient.Carrier index}}
      SourceQuotient.At[k := index].class _ _ (SourceSpace.Negative[n := n].zero x));
\definition targetZero: \forall (q: TargetQuotient.Carrier index) -> q = #zero{(TargetQuotient.space index)} :=
  TargetQuotient.At[k := index].induction (\fun (q: TargetQuotient.Carrier index) => q = #zero{(TargetQuotient.space index)})
    (\fun (x: TargetSpace.Carrier index) => congr!{{TargetSpace.Carrier index} {TargetQuotient.Carrier index}}
      TargetQuotient.At[k := index].class _ _ (TargetSpace.Negative[n := n].zero x));
\definition injective: \forall (x, y: SourceQuotient.Carrier index) -> #apply{Mapping.map} index x = #apply{Mapping.map} index y -> x = y :=
  \fun (x, y: SourceQuotient.Carrier index)(same: #apply{Mapping.map} index x = #apply{Mapping.map} index y) =>
    trans!{{SourceQuotient.Carrier index}} _ _ _ (sourceZero x) (sym!{{SourceQuotient.Carrier index}} _ _ (sourceZero y));
\definition onto: \forall (y: TargetQuotient.Carrier index) -> \exists { x: SourceQuotient.Carrier index \where #apply{Mapping.map} index x = y } :=
  \fun (y: TargetQuotient.Carrier index) => Logic.existsIntro[SourceQuotient.Carrier index, { x: SourceQuotient.Carrier index \where #apply{Mapping.map} index x = y }]
    #zero{(SourceQuotient.space index)} (trans!{{TargetQuotient.Carrier index}} _ _ _
      (targetZero (#apply{Mapping.map} index #zero{(SourceQuotient.space index)})) (sym!{{TargetQuotient.Carrier index}} _ _ (targetZero y)));
