\definition index: I.Int^ := I.Int^::negSucc n;
\import \parent.Mapping[] \as Mapping;
\definition sourceZero: \forall (q: SourceQuotient.Carrier index) -> q = (SourceQuotient.space index).zero :=
  SourceQuotient.At[k := index].induction (\fun (q: SourceQuotient.Carrier index) => q = (SourceQuotient.space index).zero)
    (\fun (x: SourceSpace.Carrier index) => congr!{{SourceSpace.Carrier index} {SourceQuotient.Carrier index}}
      SourceQuotient.At[k := index].class _ _ (SourceSpace.Negative[n := n].zero x));
\definition targetZero: \forall (q: TargetQuotient.Carrier index) -> q = (TargetQuotient.space index).zero :=
  TargetQuotient.At[k := index].induction (\fun (q: TargetQuotient.Carrier index) => q = (TargetQuotient.space index).zero)
    (\fun (x: TargetSpace.Carrier index) => congr!{{TargetSpace.Carrier index} {TargetQuotient.Carrier index}}
      TargetQuotient.At[k := index].class _ _ (TargetSpace.Negative[n := n].zero x));
\definition injective: \forall (x, y: SourceQuotient.Carrier index) -> (Mapping.map).apply index x = (Mapping.map).apply index y -> x = y :=
  \fun (x, y: SourceQuotient.Carrier index)(same: (Mapping.map).apply index x = (Mapping.map).apply index y) =>
    trans!{{SourceQuotient.Carrier index}} _ _ _ (sourceZero x) (sym!{{SourceQuotient.Carrier index}} _ _ (sourceZero y));
\definition onto: \forall (y: TargetQuotient.Carrier index) -> \exists ( x: SourceQuotient.Carrier index \where (Mapping.map).apply index x = y ) :=
  \fun (y: TargetQuotient.Carrier index) => Logic.existsIntro[SourceQuotient.Carrier index, { x: SourceQuotient.Carrier index \where (Mapping.map).apply index x = y }]
    (SourceQuotient.space index).zero (trans!{{TargetQuotient.Carrier index}} _ _ _
      (targetZero ((Mapping.map).apply index (SourceQuotient.space index).zero)) (sym!{{TargetQuotient.Carrier index}} _ _ (targetZero y)));
