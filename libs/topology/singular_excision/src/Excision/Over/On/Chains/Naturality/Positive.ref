\import Modules.Hom[V := SourceSmall.Carrier n, W := TargetWhole.Carrier n, source := SourceSmall.space n, target := TargetWhole.space n] \as Maps;
\definition law: Square (I.Int^::ofNat n) := \fun (x: SourceSpace.Carrier (I.Int^::ofNat n)) =>
  congr!{Maps.Map {TargetExtension.Carrier (I.Int^::ofNat n)}}
    (\fun (f: Maps.Map) => TargetExtension.Positive[n := n].intro (#apply{f} x)) _ _ (Pullback.Square[n := n].law Remaining.continuous);
