\use Equality.eq_reason;
\definition onClass: \forall (x: SourceSpace.Carrier z) ->
  #apply{Ordinary.map} z (#apply{SourceComparison.comparison} z (SourceQuotient.At[k := z].class x)) =
  #apply{TargetComparison.comparison} z (#apply{Mapping.map} z (SourceQuotient.At[k := z].class x)) :=
  \fun (x: SourceSpace.Carrier z) => eq_reason!{
    {#apply{Ordinary.map} z (#apply{SourceComparison.comparison} z (SourceQuotient.At[k := z].class x))}
    "=" {#apply{Ordinary.map} z (SourceRelative.class z (#apply{SourceInclusion.map} z x))}
    "by" {congr!{{SourceRelative.Carrier z} {TargetRelative.Carrier z}} (#apply{Ordinary.map} z) _ _ (SourceComparison.At[z := z].quotientOnClass x)}
    "=" {TargetRelative.class z (#apply{(WholeMaps.integerPush Remaining.inclusion Remaining.continuous)} z (#apply{SourceInclusion.map} z x))}
    "by" {Ordinary.At[z := z].quotientOnClass (#apply{SourceInclusion.map} z x)}
    "=" {TargetRelative.class z (#apply{TargetInclusion.map} z (#apply{Ambient.map} z x))}
    "by" {congr!{{TargetExtension.Carrier z} {TargetRelative.Carrier z}} (TargetRelative.class z) _ _ (sym!{{TargetExtension.Carrier z}} _ _ (square z x))}
    "=" {#apply{TargetComparison.comparison} z (TargetQuotient.At[k := z].class (#apply{Ambient.map} z x))}
    "by" {sym!{{TargetRelative.Carrier z}} _ _ (TargetComparison.At[z := z].quotientOnClass (#apply{Ambient.map} z x))}
    "=" {#apply{TargetComparison.comparison} z (#apply{Mapping.map} z (SourceQuotient.At[k := z].class x))}
    "by" {congr!{{TargetQuotient.Carrier z} {TargetRelative.Carrier z}} (#apply{TargetComparison.comparison} z) _ _
      (sym!{{TargetQuotient.Carrier z}} _ _ (Mapping.At[z := z].onClass x))}
  };
\definition law: \forall (q: SourceQuotient.Carrier z) ->
  #apply{Ordinary.map} z (#apply{SourceComparison.comparison} z q) = #apply{TargetComparison.comparison} z (#apply{Mapping.map} z q) :=
  SourceQuotient.At[k := z].induction (\fun (q: SourceQuotient.Carrier z) =>
    #apply{Ordinary.map} z (#apply{SourceComparison.comparison} z q) = #apply{TargetComparison.comparison} z (#apply{Mapping.map} z q)) onClass;
