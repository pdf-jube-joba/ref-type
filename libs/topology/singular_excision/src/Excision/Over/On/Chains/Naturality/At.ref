\use Equality.eq_reason;
\definition onClass: \forall (x: SourceSpace.Carrier z) ->
  (Ordinary.map).apply z ((SourceComparison.comparison).apply z (SourceQuotient.At[k := z].class x)) =
  (TargetComparison.comparison).apply z ((Mapping.map).apply z (SourceQuotient.At[k := z].class x)) :=
  \fun (x: SourceSpace.Carrier z) => eq_reason!{
    {(Ordinary.map).apply z ((SourceComparison.comparison).apply z (SourceQuotient.At[k := z].class x))}
    "=" {(Ordinary.map).apply z (SourceRelative.class z ((SourceInclusion.map).apply z x))}
    "by" {congr!{{SourceRelative.Carrier z} {TargetRelative.Carrier z}} ((Ordinary.map).apply z) _ _ (SourceComparison.At[z := z].quotientOnClass x)}
    "=" {TargetRelative.class z ((WholeMaps.integerPush Remaining.inclusion Remaining.continuous).apply z ((SourceInclusion.map).apply z x))}
    "by" {Ordinary.At[z := z].quotientOnClass ((SourceInclusion.map).apply z x)}
    "=" {TargetRelative.class z ((TargetInclusion.map).apply z ((Ambient.map).apply z x))}
    "by" {congr!{{TargetExtension.Carrier z} {TargetRelative.Carrier z}} (TargetRelative.class z) _ _ (sym!{{TargetExtension.Carrier z}} _ _ (square z x))}
    "=" {(TargetComparison.comparison).apply z (TargetQuotient.At[k := z].class ((Ambient.map).apply z x))}
    "by" {sym!{{TargetRelative.Carrier z}} _ _ (TargetComparison.At[z := z].quotientOnClass ((Ambient.map).apply z x))}
    "=" {(TargetComparison.comparison).apply z ((Mapping.map).apply z (SourceQuotient.At[k := z].class x))}
    "by" {congr!{{TargetQuotient.Carrier z} {TargetRelative.Carrier z}} ((TargetComparison.comparison).apply z) _ _
      (sym!{{TargetQuotient.Carrier z}} _ _ (Mapping.At[z := z].onClass x))}
  };
\definition law: \forall (q: SourceQuotient.Carrier z) ->
  (Ordinary.map).apply z ((SourceComparison.comparison).apply z q) = (TargetComparison.comparison).apply z ((Mapping.map).apply z q) :=
  SourceQuotient.At[k := z].induction (\fun (q: SourceQuotient.Carrier z) =>
    (Ordinary.map).apply z ((SourceComparison.comparison).apply z q) = (TargetComparison.comparison).apply z ((Mapping.map).apply z q)) onClass;
