\import singular_cohomology.Relative[A := Remaining.Carrier, source := RemainingTopology.topology source, subset := intersection] \as Source;
\import singular_cohomology.Relative[A := A, source := source, subset := subset] \as Target;
\import Source.Maps[B := A].Over[target := source, targetSubset := subset] \as Maps;
\definition inclusion: Maps.Map := \into[Remaining.Carrier -> A](Remaining.inclusion, Maps.Map) \by {
  Maps.Laws[Remaining.inclusion] {
    continuous := Remaining.continuous,
    contained := \fun (x: Source.SubspaceCarrier) => \bysub(Remaining.Carrier, intersection, x),
  }
};
\import Maps.On[f := inclusion].Integer[] \as Native;
\definition map: Complexes.Map[C := Source.complex, D := Target.complex].Map := Native.map;
\module At(z: I.Int^) {
  \definition quotientOnClass: _ := Native.At[z := z].quotientOnClass;
  \definition induced: _ := Native.At[z := z].induced;
}
\module With(coefficients: Modules.Bundle) {
  \definition pullback: _ := Native.With[coefficients := coefficients].pullback;
  \module At(z: I.Int^) {
    \definition induced: _ := Native.With[coefficients := coefficients].At[z := z].induced;
  }
}
