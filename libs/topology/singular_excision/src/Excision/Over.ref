\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Logic.either;
\import Top.Closure[] \as Closure;
\import Top.Interior[] \as Interior;
\import Top.OpenCovers[topology := source] \as Covers;
\structure PairData: \Set := { subset: \Pow A, removed: \Pow A };
\definition Valid[data: PairData]: \Prop := Top.Subset (Closure.closure source data.removed) (Interior.interior source data.subset);
\definition Pair: \Set := \Cast[PairData] ({ data: PairData \where Valid data });
\definition laws[pair: Pair]: Valid pair := \bysub(PairData, { data: PairData \where Valid data }, pair);
\module On(pair: Pair);
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\module Ordinary(pair: Pair);
\module Homology(z: I.Int^) {
  \definition isomorphism[pair: Pair]: \parent.Ordinary[pair := pair].Homology[z := z].Isomorphism :=
    \parent.On[pair := pair].Chains[].Homology[z := z].isomorphism;
}
\module With(coefficients: Modules.Bundle) {
  \module At(z: I.Int^) {
    \definition isomorphism[pair: Pair]: \parent.\parent.Ordinary[pair := pair].With[coefficients := coefficients].At[z := z].Isomorphism :=
      \parent.\parent.On[pair := pair].Chains[].Cohomology[coefficients := coefficients].At[z := z].isomorphism;
  }
}
