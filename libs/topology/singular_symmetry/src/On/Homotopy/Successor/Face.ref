\import \root.Models[].Face[n := n, i := i] \as ModelFace;
\import singular_eilenberg_zilber.TensorEvaluation[A := A, B := A, left := source, right := source].Precomposition[p := n, q := n, r := N.Nat^::succ n, s := N.Nat^::succ n] \as Precomposition;
\import Simplex.At[n := n] \as Domain;
\import singular_cohomology.Chains[A := Simplex.Carrier n, source := Domain.topology] \as ModelChains;
\import Double.Tensor[C := ModelChains.complex, D := ModelChains.complex] \as ModelTensor;
\import Double.Total[C := ModelTensor.complex] \as ModelTotal;
\module With(sigma: Simplices.Carrier (N.Nat^::succ n)) {
  \import Precomposition.With[f := ModelFace.factors, sigma := sigma, tau := sigma] \as Comparison;
  \definition law(k: N.Nat^)(x: LowModel.Carrier (I.Int^::ofNat k)): #apply{(Higher.evaluation sigma)} k (#apply{ModelFace.Degree[z := I.Int^::ofNat k].map} x) = #apply{(Lower.evaluation (Simplices.face n i sigma))} k x :=
    trans!{{Total.Carrier k}} _ _ _ (Comparison.law k x)
      (Evaluation.At[p := n, q := n].pointwiseEquality Comparison.leftSimplex (Simplices.face n i sigma) Comparison.rightSimplex (Simplices.face n i sigma)
        (\fun (t: Simplex.Carrier n) => \refl(sigma (Simplex.face n i t)))
        (\fun (t: Simplex.Carrier n) => \refl(sigma (Simplex.face n i t))) k x);
}
