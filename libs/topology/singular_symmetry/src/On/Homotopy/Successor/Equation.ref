\import \parent.Prior[] \as Prior;
\import Modules.Hom[V := Chains.Carrier (N.Nat^::succ n), W := Total.Carrier (N.Nat^::succ n), source := Chains.space (N.Nat^::succ n), target := Total.space (N.Nat^::succ n)] \as Linear;
\import Native.Map[C := Chains.complex, D := Total.complex].At[n := N.Nat^::succ n] \as Degree;
\import Modules.Laws[V := Total.Carrier (N.Nat^::succ n), space := Total.space (N.Nat^::succ n)] \as Values;
\import algebra.Group[].Of[Carrier := Total.Carrier (N.Nat^::succ n), group := Values.additive] \as Group;
\import Modules.Hom[V := Total.Carrier (N.Nat^::succ (N.Nat^::succ n)), W := Total.Carrier (N.Nat^::succ n), source := Total.space (N.Nat^::succ (N.Nat^::succ n)), target := Total.space (N.Nat^::succ n)].Composition[U := Chains.Carrier (N.Nat^::succ n), domain := Chains.space (N.Nat^::succ n)] \as AfterBoundary;
\import Modules.Hom[V := Chains.Carrier n, W := Total.Carrier (N.Nat^::succ n), source := Chains.space n, target := Total.space (N.Nat^::succ n)].Composition[U := Chains.Carrier (N.Nat^::succ n), domain := Chains.space (N.Nat^::succ n)] \as AfterPrior;
\import Modules.Hom[V := Total.Carrier (N.Nat^::succ (N.Nat^::succ n)), W := Total.Carrier (N.Nat^::succ n), source := Total.space (N.Nat^::succ (N.Nat^::succ n)), target := Total.space (N.Nat^::succ n)] \as TotalBoundary;
\definition totalBoundary: TotalBoundary.Map := TotalBoundary.Map {
  apply := (Total.differential).apply (N.Nat^::succ n),
  addition := Total.addition (N.Nat^::succ n),
  scalar := Total.scalar (N.Nat^::succ n),
};
\definition boundaryMap: Linear.Map := Linear.plus (AfterBoundary.compose totalBoundary Higher.map) (AfterPrior.compose Lower.map (Chains.boundary n));
\definition differenceMap: Linear.Map := Degree.linear Initial.defect;
\definition onGenerator[sigma: Simplices.Carrier (N.Nat^::succ n)]: (boundaryMap).apply (Chains.generator (N.Nat^::succ n) sigma) = (differenceMap).apply (Chains.generator (N.Nat^::succ n) sigma) := \block {
  \let x: Chains.Carrier (N.Nat^::succ n) := Chains.generator (N.Nat^::succ n) sigma \then
  \let p: Total.Carrier (N.Nat^::succ n) := (Lower.map).apply ((Chains.boundary n).apply x) \then
  \return trans!{{Total.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{Total.Carrier (N.Nat^::succ (N.Nat^::succ n))} {Total.Carrier (N.Nat^::succ n)}} (\fun (y: Total.Carrier (N.Nat^::succ (N.Nat^::succ n))) => Values.add ((Total.differential).apply (N.Nat^::succ n) y) p) _ _ (Higher.onGenerator sigma))
    (trans!{{Total.Carrier (N.Nat^::succ n)}} _ _ _
      (congr!{{Total.Carrier (N.Nat^::succ n)} {Total.Carrier (N.Nat^::succ n)}} (\fun (y: Total.Carrier (N.Nat^::succ n)) => Values.add y p) _ _ (Higher.Boundary[].law sigma))
      (trans!{{Total.Carrier (N.Nat^::succ n)}} _ _ _
        (congr!{{Total.Carrier (N.Nat^::succ n)} {Total.Carrier (N.Nat^::succ n)}} (\fun (y: Total.Carrier (N.Nat^::succ n)) => Values.add (Group.difference ((Initial.defect).apply (N.Nat^::succ n) x) y) p) _ _ (Prior.law sigma))
        (Group.addDifference ((Initial.defect).apply (N.Nat^::succ n) x) p)))
};
\import Modules.Free[Generators := Simplices.Carrier (N.Nat^::succ n)].To[W := Total.Carrier (N.Nat^::succ n), target := Total.space (N.Nat^::succ n)] \as Free;
\definition equation: boundaryMap = differenceMap := Free.ext _ _ onGenerator;
\definition law[x: Chains.Carrier (N.Nat^::succ n)]: (Initial.defect).apply (N.Nat^::succ n) x = (Total.space (N.Nat^::succ n)).add ((Total.differential).apply (N.Nat^::succ n) ((Higher.map).apply x)) ((Lower.map).apply ((Chains.boundary n).apply x)) :=
  sym!{{Total.Carrier (N.Nat^::succ n)}} _ _ (congr!{Linear.Map {Total.Carrier (N.Nat^::succ n)}} (\fun (h: Linear.Map) => (h).apply x) _ _ equation);
