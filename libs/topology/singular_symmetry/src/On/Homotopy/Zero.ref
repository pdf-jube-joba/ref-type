\definition n: N.Nat^ := N.Nat^::zero;
\import \parent.At[n := n] \as Degree;
\import \root.Models[].At[n := n] \as Model;
\import Modules.Hom[V := Model.Carrier (I.Int^::ofNat (N.Nat^::succ n)), W := Total.Carrier (N.Nat^::succ n), source := Model.space (I.Int^::ofNat (N.Nat^::succ n)), target := Total.space (N.Nat^::succ n)] \as EvaluationLinear;
\definition onSimplex(sigma: Simplices.Carrier n): Degree.onSimplex sigma = #zero{(Total.space (N.Nat^::succ n))} :=
  trans!{{Total.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{Model.Carrier (I.Int^::ofNat (N.Nat^::succ n))} {Total.Carrier (N.Nat^::succ n)}} (#apply{(Degree.evaluationLinear (N.Nat^::succ n) sigma)}) _ _ Models.homotopyZero)
    (EvaluationLinear.zeroPreserved (Degree.evaluationLinear (N.Nat^::succ n) sigma));
\import Modules.Hom[V := Chains.Carrier n, W := Total.Carrier (N.Nat^::succ n), source := Chains.space n, target := Total.space (N.Nat^::succ n)] \as Linear;
\import Modules.Free[Generators := Simplices.Carrier n].To[W := Total.Carrier (N.Nat^::succ n), target := Total.space (N.Nat^::succ n)] \as Free;
\definition equation: Degree.map = Linear.zeroMap := Free.ext Degree.map Linear.zeroMap (\fun (sigma: Simplices.Carrier n) => trans!{{Total.Carrier (N.Nat^::succ n)}} _ _ _ (Degree.onGenerator sigma) (onSimplex sigma));
\definition value(x: Chains.Carrier n): #apply{Degree.map} x = #zero{(Total.space (N.Nat^::succ n))} := congr!{Linear.Map {Total.Carrier (N.Nat^::succ n)}} (\fun (f: Linear.Map) => #apply{f} x) _ _ equation;
\import Modules.Hom[V := Total.Carrier (N.Nat^::succ n), W := Total.Carrier n, source := Total.space (N.Nat^::succ n), target := Total.space n] \as Boundary;
\definition totalBoundary: Boundary.Map := Boundary.Map { apply := #apply{Total.differential} n, addition := Total.addition n, scalar := Total.scalar n };
\definition boundary(x: Chains.Carrier n): #apply{Total.differential} n (#apply{Degree.map} x) = #zero{(Total.space n)} :=
  trans!{{Total.Carrier n}} _ _ _ (congr!{{Total.Carrier (N.Nat^::succ n)} {Total.Carrier n}} (#apply{Total.differential} n) _ _ (value x)) (Boundary.zeroPreserved totalBoundary);
\definition law(x: Chains.Carrier n): #apply{Initial.defect} n x = #apply{Total.differential} n (#apply{Degree.map} x) :=
  trans!{{Total.Carrier n}} _ _ _ (Initial.Zero[].defect x) (sym!{{Total.Carrier n}} _ _ (boundary x));
