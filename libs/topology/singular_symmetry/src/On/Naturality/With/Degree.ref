\definition diagonal(x: Chains.Carrier n): #apply{product} n (#apply{(DiagonalMaps.push Initial.diagonal diagonalContinuous)} n x) = #apply{(TargetDiagonalMaps.push Target.diagonal Target.diagonalContinuous)} n (#apply{(Maps.push f continuous)} n x) :=
  congr!{DiagonalLinear.Map {TargetProductChains.Carrier n}} (\fun (g: DiagonalLinear.Map) => #apply{g} n x) _ _ diagonalSquare;
\definition forward(x: Chains.Carrier n): #apply{tensor} n (#apply{Initial.forward} n x) = #apply{Target.forward} n (#apply{(Maps.push f continuous)} n x) :=
  trans!{{TargetTotal.Carrier n}} _ _ _ (AWNaturality.AlexanderWhitney[n := n].law (#apply{(DiagonalMaps.push Initial.diagonal diagonalContinuous)} n x))
    (congr!{{TargetProductChains.Carrier n} {TargetTotal.Carrier n}} (#apply{TargetAW.map} n) _ _ (diagonal x));
\definition swapped(x: Total.Carrier n): #apply{tensor} n (#apply{Swap.forward} n x) = #apply{TargetSwap.forward} n (#apply{tensor} n x) :=
  congr!{{Native.Map[C := Total.complex, D := TargetTotal.complex].Map} {TargetTotal.Carrier n}} (\fun (g: Native.Map[C := Total.complex, D := TargetTotal.complex].Map) => #apply{g} n x) _ _ SwapNaturality.square;
\definition backward(x: Chains.Carrier n): #apply{tensor} n (#apply{Initial.backward} n x) = #apply{Target.backward} n (#apply{(Maps.push f continuous)} n x) :=
  trans!{{TargetTotal.Carrier n}} _ _ _ (swapped (#apply{Initial.forward} n x))
    (congr!{{TargetTotal.Carrier n} {TargetTotal.Carrier n}} (#apply{TargetSwap.forward} n) _ _ (forward x));
\import Native.Map[C := Total.complex, D := TargetTotal.complex].At[n := n] \as TensorLinear;
\import Modules.Hom[V := Total.Carrier n, W := TargetTotal.Carrier n, source := Total.space n, target := TargetTotal.space n] \as Linear;
\import Modules.Laws[V := TargetTotal.Carrier n, space := TargetTotal.space n] \as Values;
\import algebra.Group[].Of[Carrier := TargetTotal.Carrier n, group := Values.additive] \as Group;
\definition defect(x: Chains.Carrier n): #apply{tensor} n (#apply{Initial.defect} n x) = #apply{Target.defect} n (#apply{(Maps.push f continuous)} n x) :=
  trans!{{TargetTotal.Carrier n}} _ _ _ (Linear.differencePreserved (TensorLinear.linear tensor) (#apply{Initial.forward} n x) (#apply{Initial.backward} n x))
    (congr2!{{TargetTotal.Carrier n} {TargetTotal.Carrier n} {TargetTotal.Carrier n}} Group.difference _ _ _ _ (forward x) (backward x));
