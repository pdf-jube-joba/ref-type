\import algebraic_topology.Simplex[] \as Simplex;
\import \root.Models[].Exchange[] \as Models;
\import singular_eilenberg_zilber.TensorEvaluation[A := A, B := A, left := source, right := source] \as Evaluation;
\import \root.On[A := A, source := source] \as Initial;
\module At(n: N.Nat^);
\module Zero;
\module Successor(n: N.Nat^);
\import Native.Homotopy[C := Chains.complex, D := Total.complex] \as Homotopies;
\definition data: Homotopies.Data := Homotopies.Data { apply := \fun (n: N.Nat^) => #apply{At[n := n].map} };
\definition homotopy: Homotopies.Homotopy forward backward :=
  \into[Homotopies.Data](data, { h: Homotopies.Data \where Homotopies.Laws[forward, backward, h] }) \by {
    Homotopies.Laws[forward, backward, data] {
      addition := \fun (n: N.Nat^) => #addition{At[n := n].map},
      scalar := \fun (n: N.Nat^) => #scalar{At[n := n].map},
      zeroEquation := Zero[].law,
      successorEquation := \fun (n: N.Nat^) => Successor[n := n].Equation[].law,
    }
  };
