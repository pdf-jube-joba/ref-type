\import Diagonal.Of[model := model] \as Construction;
\module Degree(n: N.Nat^) {
  \import \parent.\parent.At[n := n] \as Current;
  \import Simplex.At[n := n] \as Domain;
  \import \root.On[A := Simplex.Carrier n, source := Domain.topology] \as Comparison;
  \import singular_cohomology.Chains[A := Simplex.Carrier n, source := Domain.topology] \as Chains;
  \import Double.Tensor[C := Chains.complex, D := Chains.complex] \as Tensor;
  \import Double.Total[C := Tensor.complex] \as Total;
  \import Native.ZeroExtension[C := Total.complex] \as Signed;
  \definition native: Total.Carrier n := #apply{Comparison.defect} n Current.cell;
  \definition value: Current.Carrier (I.Int^::ofNat n) := Signed.Positive[n := n].intro native;
}
\module Zero;
\module Successor(n: N.Nat^);
\definition cells: Construction.ClosedDiagonal := Construction.ClosedDiagonal {
  value := \fun (n: N.Nat^) => Degree[n := n].value,
  zero := Zero[].closed,
  successor := \fun (n: N.Nat^) => Successor[n := n].law,
};
\import Construction.Positive[fillings := \parent.Fillings[].data, cells := cells] \as Recursion;
\definition initial: Recursion.Initial := Recursion.Initial {
  value := #zero{(\parent.At[n := N.Nat^::zero].space (I.Int^::ofNat (N.Nat^::succ N.Nat^::zero)))},
  boundary := Zero[].initial,
};
\import Recursion.On[initial := initial] \as Filled;
\definition homotopy: \forall (n: N.Nat^) -> \parent.At[n := n].Carrier (I.Int^::ofNat (N.Nat^::succ n)) := Filled.value;
\definition boundary: \forall (n: N.Nat^) -> Filled.Property n := Filled.boundary;
\definition prior: \forall (n: N.Nat^) -> \parent.At[n := n].Carrier (I.Int^::ofNat n) := Filled.preceding;
\definition homotopyZero: homotopy N.Nat^::zero = #zero{(\parent.At[n := N.Nat^::zero].space (I.Int^::ofNat (N.Nat^::succ N.Nat^::zero)))} := \refl(homotopy N.Nat^::zero);
\definition priorZero: prior N.Nat^::zero = #zero{(\parent.At[n := N.Nat^::zero].space (I.Int^::ofNat N.Nat^::zero))} := \refl(prior N.Nat^::zero);
\definition priorSuccessor(n: N.Nat^): prior (N.Nat^::succ n) = #apply{\parent.Transition[n := n].Degree[z := I.Int^::ofNat (N.Nat^::succ n)].map} (homotopy n) := \refl(prior (N.Nat^::succ n));
