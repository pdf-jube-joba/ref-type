\import \parent.Degree[z := z] \as Current;
\import \parent.Degree[z := Degrees.previous z] \as Prior;
\import Modules.Alternating[V := Higher.Carrier z, space := Higher.space z].Mapping[W := Higher.Carrier (Degrees.previous z), target := Higher.space (Degrees.previous z)] \as BoundarySum;
\import Modules.Alternating[V := Higher.Carrier (Degrees.previous z), space := Higher.space (Degrees.previous z)] \as Sum;
\definition law(x: Lower.Carrier z): #apply{(Higher.boundary z)} (#apply{Current.map} x) = #apply{Prior.map} (#apply{(Lower.boundary z)} x) :=
  trans!{{Higher.Carrier (Degrees.previous z)}} _ _ _
    (congr!{{Higher.Carrier z} {Higher.Carrier (Degrees.previous z)}} (#apply{(Higher.boundary z)}) _ _ (Current.onValues x))
    (trans!{{Higher.Carrier (Degrees.previous z)}} _ _ _
      (BoundarySum.law (Higher.boundary z) count (\fun (i: Fin.Fin count) => #apply{(Current.faces i)} x))
      (trans!{{Higher.Carrier (Degrees.previous z)}} _ _ _
        (Sum.congruent count
          (\fun (i: Fin.Fin count) => #apply{(Higher.boundary z)} (#apply{(Current.faces i)} x))
          (\fun (i: Fin.Fin count) => #apply{(Prior.faces i)} (#apply{(Lower.boundary z)} x))
          (\fun (i: Fin.Fin count) => \parent.\parent.Face[n := n, i := i].commutes z x))
        (sym!{{Higher.Carrier (Degrees.previous z)}} _ _ (Prior.onValues (#apply{(Lower.boundary z)} x)))));
