\import \parent.At[n := n] \as Lower;
\import \parent.At[n := N.Nat^::succ n] \as Higher;
\definition count: N.Nat^ := N.Nat^::succ (N.Nat^::succ n);
\module Degree(z: I.Int^) {
  \import Modules.Hom[V := Lower.Carrier z, W := Higher.Carrier z, source := Lower.space z, target := Higher.space z] \as Maps;
  \import Maps.Alternating[] \as Sum;
  \import Modules.Alternating[V := Higher.Carrier z, space := Higher.space z] \as Values;
  \definition faces(i: Fin.Fin count): Maps.Map := \parent.\parent.Face[n := n, i := i].Degree[z := z].map;
  \definition map: Maps.Map := Sum.map count faces;
  \definition onValues(x: Lower.Carrier z): #apply{map} x = Values.sum count (\fun (i: Fin.Fin count) => #apply{(faces i)} x) := Sum.onValues count faces x;
}
\module Differential(z: I.Int^);
\definition commutes: \forall (z: I.Int^)(x: Lower.Carrier z) -> #apply{(Higher.boundary z)} (#apply{Degree[z := z].map} x) = #apply{Degree[z := Degrees.previous z].map} (#apply{(Lower.boundary z)} x) :=
  \fun (z: I.Int^) => Differential[z := z].law;
