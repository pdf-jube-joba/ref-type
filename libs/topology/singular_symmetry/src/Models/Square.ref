\import \parent.At[n := n] \as Lower;
\import \parent.At[n := N.Nat^::succ n] \as Middle;
\import \parent.At[n := N.Nat^::succ (N.Nat^::succ n)] \as Higher;
\import \parent.Transition[n := n].Degree[z := z] \as Low;
\import \parent.Transition[n := N.Nat^::succ n].Degree[z := z] \as High;
\definition count: N.Nat^ := N.Nat^::succ (N.Nat^::succ n);
\definition larger: N.Nat^ := N.Nat^::succ count;
\import Modules.Alternating[V := Higher.Carrier z, space := Higher.space z] \as Sum;
\import Modules.Alternating[V := Middle.Carrier z, space := Middle.space z].Mapping[W := Higher.Carrier z, target := Higher.space z] \as Mapping;
\definition terms(x: Lower.Carrier z)(i: Fin.Fin larger)(j: Fin.Fin count): Higher.Carrier z := #apply{(High.faces i)} (#apply{(Low.faces j)} x);
\definition inner(x: Lower.Carrier z)(i: Fin.Fin larger): #apply{(High.faces i)} (#apply{Low.map} x) = Sum.sum count (terms x i) :=
  trans!{{Higher.Carrier z}} _ _ _
    (congr!{{Middle.Carrier z} {Higher.Carrier z}} (#apply{(High.faces i)}) _ _ (Low.onValues x))
    (Mapping.law (High.faces i) count (\fun (j: Fin.Fin count) => #apply{(Low.faces j)} x));
\definition law(x: Lower.Carrier z): #apply{High.map} (#apply{Low.map} x) = #zero{(Higher.space z)} :=
  trans!{{Higher.Carrier z}} _ _ _ (High.onValues (#apply{Low.map} x))
    (trans!{{Higher.Carrier z}} _ _ _
      (Sum.congruent larger (\fun (i: Fin.Fin larger) => #apply{(High.faces i)} (#apply{Low.map} x))
        (\fun (i: Fin.Fin larger) => Sum.sum count (terms x i)) (inner x))
      (Sum.doubleZero count (terms x) (\fun (i, j: Fin.Fin count)(ordered: N.Basic[].Prop[].Le i j) => \parent.Interchange[n := n, i := i, j := j].law ordered z x)));
