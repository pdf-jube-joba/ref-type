\import \parent.At[n := n] \as Lower;
\import \parent.At[n := N.Nat^::succ n] \as Higher;
\import Simplex.Faces[n := n] \as Faces;
\import TensorModels.Mapping[p := n, q := n, r := N.Nat^::succ n, s := N.Nat^::succ n] \as Mapping;
\definition factors: Mapping.Map := Mapping.Map {
  leftFunction := Simplex.face n i, rightFunction := Simplex.face n i,
  leftContinuous := Faces.continuous i, rightContinuous := Faces.continuous i,
};
\import Mapping.With[f := factors] \as Action;
\module Degree(z: I.Int^) {
  \definition map: Modules.Hom[V := Lower.Carrier z, W := Higher.Carrier z, source := Lower.space z, target := Higher.space z].Map := Action.Degree[z := z].map;
}
\definition commutes: \forall (z: I.Int^)(x: Lower.Carrier z) -> (Higher.boundary z).apply ((Degree[z := z].map).apply x) = (Degree[z := Degrees.previous z].map).apply ((Lower.boundary z).apply x) := Action.commutes;
