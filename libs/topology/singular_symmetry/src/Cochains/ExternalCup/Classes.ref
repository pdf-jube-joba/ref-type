\definition leftCycle: RingComplexes.At[C := ProductTheory.complex, k := p].CycleCarrier := ClassProjection.At[n := p].cycle first firstContinuous alpha;
\definition rightCycle: RingComplexes.At[C := ProductTheory.complex, k := q].CycleCarrier := ClassProjection.At[n := q].cycle second secondContinuous beta;
\definition cycle: Output.CycleCarrier := ClassCup.cycle leftCycle rightCycle;
\definition ambientCycle: ProductCochains.Carrier n := cycle;
\definition representative: pullback alpha beta = ambientCycle := equation alpha beta;
\definition closed: ProductTheory.coboundary n (pullback alpha beta) = #zero{(ProductCochains.space (N.Nat^::succ n))} :=
  trans!{{ProductCochains.Carrier (N.Nat^::succ n)}} _ _ _
    (congr!{{ProductCochains.Carrier n} {ProductCochains.Carrier (N.Nat^::succ n)}} (ProductTheory.coboundary n) _ _ representative)
    (\bysub(ProductCochains.Carrier n, #carrier{Output.cycles}, cycle));
\definition onClasses:
  ClassCup.apply (ClassProjection.apply p first firstContinuous (Left.classOf alpha)) (ClassProjection.apply q second secondContinuous (Right.classOf beta)) = Output.classOf cycle :=
  trans!{Output.Cohomology} _ _ _
    (congr2!{{ProductCochains.Cohomology[].Group p} {ProductCochains.Cohomology[].Group q} Output.Cohomology} ClassCup.apply _ _ _ _
      (ClassProjection.At[n := p].onClass first firstContinuous alpha)
      (ClassProjection.At[n := q].onClass second secondContinuous beta))
    (ClassCup.onClasses leftCycle rightCycle);
\definition evaluation(x: ProductChains.Carrier n): #apply{(Pairing.total alpha beta)} (#apply{TotalAW.map} n x) = #apply{cycle} x := law alpha beta x;
