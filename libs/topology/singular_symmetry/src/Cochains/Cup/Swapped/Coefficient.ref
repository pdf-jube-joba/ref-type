\import IntegerModules.Hom[V := Tensor.Term[p := p, q := q].Carrier, W := R, source := Tensor.Term[p := p, q := q].space, target := integerCoefficients.space].Composition[U := ReverseTerm.Carrier, domain := ReverseTerm.space] \as AfterFlip;
\import IntegerModules.Hom[V := R, W := R, source := integerCoefficients.space, target := integerCoefficients.space].Composition[U := ReverseTerm.Carrier, domain := ReverseTerm.space] \as AfterSign;
\import IntegerModules.Hom[V := ReverseTerm.Carrier, W := R, source := ReverseTerm.space, target := integerCoefficients.space] \as Linear;
\import IntegerModules.Tensor[V := Chains.Carrier q, W := Chains.Carrier p, left := Chains.space q, right := Chains.space p].Universal[U := R, target := integerCoefficients.space] \as Universal;
\definition lhs: Linear.Map := AfterFlip.compose (Pairing.map alpha beta) SignedSymmetry.map;
\definition rhs: Linear.Map := AfterSign.compose (Sign.map exponent) (ReversePairing.map beta alpha);
\definition onTensor(x: Chains.Carrier q)(y: Chains.Carrier p): #apply{lhs} (ReverseTerm.tensor x y) = #apply{rhs} (ReverseTerm.tensor x y) :=
  trans!{R} _ _ _
    (congr!{{Tensor.Term[p := p, q := q].Carrier} R} (#apply{(Pairing.map alpha beta)}) _ _ (SignedSymmetry.onTensor x y))
    (trans!{R} _ _ _
      (SignNaturality.naturality (Pairing.map alpha beta) (Nat.mul q p) (Tensor.Term[p := p, q := q].tensor y x))
      (trans!{R} _ _ _
        (congr!{N.Nat^ R} (\fun (t: N.Nat^) => #apply{(Sign.map t)} (#apply{(Pairing.map alpha beta)} (Tensor.Term[p := p, q := q].tensor y x))) _ _ (Natural.mulComm q p))
        (trans!{R} _ _ _
          (congr!{R R} (#apply{(Sign.map exponent)}) _ _ (Pairing.onTensor alpha beta y x))
          (trans!{R} _ _ _
            (congr!{R R} (#apply{(Sign.map exponent)}) _ _ (#mulCommutative{ring} (#apply{alpha} y) (#apply{beta} x)))
            (sym!{R} _ _ (congr!{R R} (#apply{(Sign.map exponent)}) _ _ (ReversePairing.onTensor beta alpha x y)))))));
\definition equation: lhs = rhs := Universal.ext lhs rhs onTensor;
\definition law(x: ReverseTerm.Carrier): #apply{lhs} x = #apply{rhs} x := congr!{Linear.Map R} (\fun (f: Linear.Map) => #apply{f} x) _ _ equation;
