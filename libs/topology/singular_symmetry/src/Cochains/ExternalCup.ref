\definition n: N.Nat^ := Nat.add p q;
\import \parent.Pairing[p := p, q := q] \as Pairing;
\import topological_constructions.Product[A := A, B := A] \as Points;
\definition productTopology: topology.Topology[Carrier := Points.CarrierSet].Topology := Points.topology source source;
\import singular_cohomology.Chains[A := Points.CarrierSet, source := productTopology] \as ProductChains;
\import singular_cohomology.Simplices[A := Points.CarrierSet, source := productTopology] \as ProductSimplices;
\import ProductSimplices.Cut[p := p, q := q] \as Cut;
\import singular_products.Cochains[A := Points.CarrierSet, source := productTopology, R := R, ring := ring] \as ProductCochains;
\import ProductCochains.Cup[p := p, q := q] \as ProductCup;
\import ProductCochains.Pullback[B := A, target := source] \as Projection;
\import singular_products.AlexanderWhitney[A := A, B := A, left := source, right := source] \as AlexanderWhitney;
\import AlexanderWhitney.At[p := p, q := q] \as AW;
\import AlexanderWhitney.Total[] \as TotalAW;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition first: Points.CarrierSet -> A := AlexanderWhitney.leftProjection;
\definition second: Points.CarrierSet -> A := AlexanderWhitney.rightProjection;
\definition firstContinuous: singular_cohomology.Maps[A := Points.CarrierSet, B := A, source := productTopology, target := source].Continuous first := AlexanderWhitney.leftContinuous;
\definition secondContinuous: singular_cohomology.Maps[A := Points.CarrierSet, B := A, source := productTopology, target := source].Continuous second := AlexanderWhitney.rightContinuous;
\definition left(alpha: Carrier p): ProductCochains.Carrier p := Projection.apply p first firstContinuous alpha;
\definition right(beta: Carrier q): ProductCochains.Carrier q := Projection.apply q second secondContinuous beta;
\definition coordinate(sigma: ProductSimplices.Carrier n): Coordinates.Degree[n := n].coordinate Pairing.index (#apply{TotalAW.map} n (ProductChains.generator n sigma)) = AW.value sigma :=
  trans!{AW.Carrier} _ _ _ (TotalAW.Degree[n := n].coordinate Pairing.index (ProductChains.generator n sigma))
    (trans!{AW.Carrier} _ _ _
      (congr!{{ProductChains.Carrier n} AW.Carrier} (#apply{AW.map}) _ _ (Transport.castRefl ProductChains.Carrier n (ProductChains.generator n sigma)))
      (AW.onGenerator sigma));
\import IntegerModules.Hom[V := Total.Carrier n, W := R, source := Total.space n, target := integerCoefficients.space].Composition[U := ProductChains.Carrier n, domain := ProductChains.space n] \as Composition;
\import Native.Map[C := ProductChains.complex, D := Total.complex].At[n := n] \as Linear;
\definition pullback(alpha: Carrier p)(beta: Carrier q): ProductCochains.Carrier n := Composition.compose (Pairing.total alpha beta) (Linear.linear TotalAW.map);
\definition onSimplex(alpha: Carrier p)(beta: Carrier q)(sigma: ProductSimplices.Carrier n): #apply{(pullback alpha beta)} (ProductChains.generator n sigma) = #apply{(ProductCup.apply (left alpha) (right beta))} (ProductChains.generator n sigma) :=
  trans!{R} _ _ _
    (congr!{AW.Carrier R} (#apply{(Pairing.map alpha beta)}) _ _ (coordinate sigma))
    (trans!{R} _ _ _ (Pairing.onTensor alpha beta (Chains.generator p (AW.front sigma)) (Chains.generator q (AW.back sigma)))
      (trans!{R} _ _ _
        (congr2!{R R R} (#mul{baseRing}) _ _ _ _
          (sym!{R} _ _ (Projection.onSimplex p first firstContinuous alpha (Cut.front sigma)))
          (sym!{R} _ _ (Projection.onSimplex q second secondContinuous beta (Cut.back sigma))))
        (sym!{R} _ _ (ProductCup.onSimplex (left alpha) (right beta) sigma))));
\import IntegerModules.Free[Generators := ProductSimplices.Carrier n].To[W := R, target := integerCoefficients.space] \as Free;
\definition equation(alpha: Carrier p)(beta: Carrier q): pullback alpha beta = ProductCup.apply (left alpha) (right beta) :=
  Free.ext (pullback alpha beta) (ProductCup.apply (left alpha) (right beta)) (onSimplex alpha beta);
\definition law(alpha: Carrier p)(beta: Carrier q)(x: ProductChains.Carrier n): #apply{(Pairing.total alpha beta)} (#apply{TotalAW.map} n x) = #apply{(ProductCup.apply (left alpha) (right beta))} x :=
  congr!{{ProductCochains.Carrier n} R} (\fun (f: ProductCochains.Carrier n) => #apply{f} x) _ _ (equation alpha beta);
\import chain_complexes.Cochain[].Over[R := R, ring := baseRing] \as RingComplexes;
\import RingComplexes.At[C := Theory.complex, k := p] \as Left;
\import RingComplexes.At[C := Theory.complex, k := q] \as Right;
\import singular_cohomology.Cochains[A := Points.CarrierSet, source := productTopology].OverRing[R := R, ring := ring].With[coefficients := coefficients] \as ProductTheory;
\import RingComplexes.At[C := ProductTheory.complex, k := n] \as Output;
\import ProductCochains.Cohomology[].Pullback[B := A, target := source] \as ClassProjection;
\import ProductCochains.Cohomology[].Cup[p := p, q := q] \as ClassCup;
\module Classes(alpha: Left.CycleCarrier, beta: Right.CycleCarrier);
