\module Left(x: Chains.Carrier p, y: Chains.Carrier q) {
  \import Abelian.Scalar[a := #apply{beta} y] \as Scalar;
  \definition addition(x1, x2: Chains.Carrier p): value alpha beta (#add{(Chains.space p)} x1 x2) y = #add{integerCoefficients.space} (value alpha beta x1 y) (value alpha beta x2 y) :=
    trans!{R} _ _ _
      (congr!{R R} (#mul{baseRing} (#apply{beta} y)) _ _ (#addition{alpha} x1 x2))
      (#addition{Scalar.map} (#apply{alpha} x1) (#apply{alpha} x2));
  \definition scalar(a: I.Int^): value alpha beta (#smul{(Chains.space p)} a x) y = #smul{integerCoefficients.space} a (value alpha beta x y) :=
    trans!{R} _ _ _
      (congr!{R R} (#mul{baseRing} (#apply{beta} y)) _ _ (#scalar{alpha} a x))
      (#scalar{Scalar.map} a (#apply{alpha} x));
}
\module Right(x: Chains.Carrier p) {
  \import Abelian.Scalar[a := #apply{alpha} x] \as Scalar;
  \definition addition(y1, y2: Chains.Carrier q): value alpha beta x (#add{(Chains.space q)} y1 y2) = #add{integerCoefficients.space} (value alpha beta x y1) (value alpha beta x y2) :=
    trans!{R} _ _ _ (commuted alpha beta x (#add{(Chains.space q)} y1 y2))
      (trans!{R} _ _ _
        (congr!{R R} (#mul{baseRing} (#apply{alpha} x)) _ _ (#addition{beta} y1 y2))
        (trans!{R} _ _ _ (#addition{Scalar.map} (#apply{beta} y1) (#apply{beta} y2))
          (sym!{R} _ _ (congr2!{R R R} (#add{integerCoefficients.space}) _ _ _ _ (commuted alpha beta x y1) (commuted alpha beta x y2)))));
  \definition scalar(a: I.Int^)(y: Chains.Carrier q): value alpha beta x (#smul{(Chains.space q)} a y) = #smul{integerCoefficients.space} a (value alpha beta x y) :=
    trans!{R} _ _ _ (commuted alpha beta x (#smul{(Chains.space q)} a y))
      (trans!{R} _ _ _
        (congr!{R R} (#mul{baseRing} (#apply{alpha} x)) _ _ (#scalar{beta} a y))
        (trans!{R} _ _ _ (#scalar{Scalar.map} a (#apply{beta} y))
          (sym!{R} _ _ (congr!{R R} (#smul{integerCoefficients.space} a) _ _ (commuted alpha beta x y)))));
}
\definition laws: Pure.BilinearLaws[R, integerCoefficients.space, value alpha beta] := Pure.BilinearLaws[R, integerCoefficients.space, value alpha beta] {
  addLeft := \fun (x1, x2: Chains.Carrier p)(y: Chains.Carrier q) => Left[x := x1, y := y].addition x1 x2,
  addRight := \fun (x: Chains.Carrier p)(y1, y2: Chains.Carrier q) => Right[x := x].addition y1 y2,
  scaleLeft := \fun (a: I.Int^)(x: Chains.Carrier p)(y: Chains.Carrier q) => Left[x := x, y := y].scalar a,
  scaleRight := \fun (a: I.Int^)(x: Chains.Carrier p)(y: Chains.Carrier q) => Right[x := x].scalar a y,
};
