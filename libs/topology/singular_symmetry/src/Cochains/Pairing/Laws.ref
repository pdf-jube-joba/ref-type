\module Left(x: Chains.Carrier p, y: Chains.Carrier q) {
  \import Abelian.Scalar[a := (beta).apply y] \as Scalar;
  \definition addition[x1, x2: Chains.Carrier p]: value alpha beta ((Chains.space p).add x1 x2) y = (integerCoefficients.space).add (value alpha beta x1 y) (value alpha beta x2 y) :=
    trans!{R} _ _ _
      (congr!{R R} ((baseRing).mul ((beta).apply y)) _ _ ((alpha).addition x1 x2))
      ((Scalar.map).addition ((alpha).apply x1) ((alpha).apply x2));
  \definition scalar[a: I.Int^]: value alpha beta ((Chains.space p).smul a x) y = (integerCoefficients.space).smul a (value alpha beta x y) :=
    trans!{R} _ _ _
      (congr!{R R} ((baseRing).mul ((beta).apply y)) _ _ ((alpha).scalar a x))
      ((Scalar.map).scalar a ((alpha).apply x));
}
\module Right(x: Chains.Carrier p) {
  \import Abelian.Scalar[a := (alpha).apply x] \as Scalar;
  \definition addition[y1, y2: Chains.Carrier q]: value alpha beta x ((Chains.space q).add y1 y2) = (integerCoefficients.space).add (value alpha beta x y1) (value alpha beta x y2) :=
    trans!{R} _ _ _ (commuted alpha beta x ((Chains.space q).add y1 y2))
      (trans!{R} _ _ _
        (congr!{R R} ((baseRing).mul ((alpha).apply x)) _ _ ((beta).addition y1 y2))
        (trans!{R} _ _ _ ((Scalar.map).addition ((beta).apply y1) ((beta).apply y2))
          (sym!{R} _ _ (congr2!{R R R} ((integerCoefficients.space).add) _ _ _ _ (commuted alpha beta x y1) (commuted alpha beta x y2)))));
  \definition scalar[a: I.Int^][y: Chains.Carrier q]: value alpha beta x ((Chains.space q).smul a y) = (integerCoefficients.space).smul a (value alpha beta x y) :=
    trans!{R} _ _ _ (commuted alpha beta x ((Chains.space q).smul a y))
      (trans!{R} _ _ _
        (congr!{R R} ((baseRing).mul ((alpha).apply x)) _ _ ((beta).scalar a y))
        (trans!{R} _ _ _ ((Scalar.map).scalar a ((beta).apply y))
          (sym!{R} _ _ (congr!{R R} ((integerCoefficients.space).smul a) _ _ (commuted alpha beta x y)))));
}
\definition laws: Pure.BilinearLaws[R, integerCoefficients.space, value alpha beta] := Pure.BilinearLaws[R, integerCoefficients.space, value alpha beta] {
  addLeft := \fun (x1, x2: Chains.Carrier p)(y: Chains.Carrier q) => Left[x := x1, y := y].addition x1 x2,
  addRight := \fun (x: Chains.Carrier p)(y1, y2: Chains.Carrier q) => Right[x := x].addition y1 y2,
  scaleLeft := \fun (a: I.Int^)(x: Chains.Carrier p)(y: Chains.Carrier q) => Left[x := x, y := y].scalar a,
  scaleRight := \fun (a: I.Int^)(x: Chains.Carrier p)(y: Chains.Carrier q) => Right[x := x].scalar a y,
};
