\module Product(A, B: \Set);
\module Quotient(A, B: \Set);
\module Gluing(A, B: \Set);
\module FunctionSpace(A, B: \Set);
\module RelationQuotient(A: \Set, relation: A -> A -> \Prop);
\module Coproduct(A, B: \Set);
\module Pushout(A, B, C: \Set);
\module ProductQuotient(X, A, B: \Set);
\module CompactQuotient(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology, q: A -> B);
\module Induced(A, B: \Set);
