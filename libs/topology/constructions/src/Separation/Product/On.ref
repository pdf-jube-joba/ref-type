\definition source: Target.Topology := Product.topology left right;
\definition first: Product.CarrierSet -> A := Pair.first A B;
\definition second: Product.CarrierSet -> B := Pair.second A B;
\import topological_constructions.Separation[].Pullback[A := Product.CarrierSet, B := A, source := source, target := left, f := first, continuous := Maps.firstContinuous left right] \as First;
\import topological_constructions.Separation[].Pullback[A := Product.CarrierSet, B := B, source := source, target := right, f := second, continuous := Maps.secondContinuous left right] \as Second;
\definition hausdorff: Target.IsT2 source := \fun (x, y: Product.CarrierSet)(distinct: Logic.Not (x = y)) =>
  Logic.orElim[(first x = first y), Logic.Not (first x = first y), (\exists (U: \Pow Product.CarrierSet \where Target.RegularChoice[source, Target.Singleton y, x, U]))] (Classical.excludedMiddle (first x = first y))
    (\fun (equal: first x = first y) => Second.separate rightHausdorff x y (\fun (other: second x = second y) => distinct (Pairs.ext x y equal other)))
    (First.separate leftHausdorff x y);
