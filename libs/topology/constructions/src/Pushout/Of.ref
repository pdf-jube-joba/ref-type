\definition Edge[x, y: Sum.Carrier]: \Prop :=
  \exists ( c: C \where Logic.And[x = Sum.inl (u c), y = Sum.inr (v c)] );
\definition Related: Sum.Carrier -> Sum.Carrier -> \Prop := Closure.EquivalenceClosure Sum.Carrier Edge;
\import topological_constructions.RelationQuotient[A := Sum.Carrier, relation := Related] \as Quotient;
\import topology.Topology[Carrier := Quotient.Carrier] \as Space;
\definition Carrier: \Set := Quotient.Carrier;
\definition class: Sum.Carrier -> Carrier := Quotient.class;
\definition topology[left: Left.Topology] [right: Right.Topology]: Space.Topology :=
  Quotient.topology (Sum.topology left right);
\definition inl[x: A]: Carrier := class (Sum.inl x);
\definition inr[y: B]: Carrier := class (Sum.inr y);
\definition equivalence: Quotient.Laws := Quotient.Laws {
  refl := Closure.equivalenceClosureRefl Sum.Carrier Edge,
  sym := Closure.equivalenceClosureSym Sum.Carrier Edge,
  trans := Closure.equivalenceClosureTrans Sum.Carrier Edge,
};
\definition glued: \forall (c: C) -> inl (u c) = inr (v c) :=
  \fun (c: C) => Quotient.relatedEqual equivalence _ _
    (Closure.equivalenceClosureOf Sum.Carrier Edge _ _
      (Logic.existsIntro[C, { d: C \where Logic.And[Sum.inl (u c) = Sum.inl (u d), Sum.inr (v c) = Sum.inr (v d)] }] c
        (Logic.And[_, _]::# (\refl(Sum.inl (u c))) (\refl(Sum.inr (v c))))));
\module Universal(D: \Set);
\import topology.Continuity[A := A, B := Carrier] \as LeftInclusion;
\import topology.Continuity[A := B, B := Carrier] \as RightInclusion;
\definition inlContinuous: \forall (left: Left.Topology) (right: Right.Topology) ->
  LeftInclusion.Continuous left (topology left right) inl :=
  \fun (left: _) (right: _) (U: _) (open: _) => Sum.inlContinuous left right
    ({ p: Sum.Carrier \where \In[Carrier] U (class p) }) (Quotient.projectionContinuous (Sum.topology left right) U open);
\definition inrContinuous: \forall (left: Left.Topology) (right: Right.Topology) ->
  RightInclusion.Continuous right (topology left right) inr :=
  \fun (left: _) (right: _) (U: _) (open: _) => Sum.inrContinuous left right
    ({ p: Sum.Carrier \where \In[Carrier] U (class p) }) (Quotient.projectionContinuous (Sum.topology left right) U open);

\definition induction[P: Carrier -> \Prop]: (\forall (x: A) -> P (inl x)) -> (\forall (y: B) -> P (inr y)) -> \forall (p: Carrier) -> P p :=
  \fun (left: _)(right: _) => Quotient.induction P
    (\induction (p: Sum.Carrier) \return P (class p) \with { | inl: left | inr: right });
