\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := Model.Disk] \as Cylinder;
\definition radius[x: Model.Disk]: I.Carrier := \into[Real.Real](Geometry.norm x, metric_spaces.RealLine[].ClosedInterval Real.zero Real.one) \by {
  Logic.And[_, _]::# (normNonnegative x) (diskNorm x)
};
\module At(t: I.Carrier, x: Model.Disk);
\definition time[p: Cylinder.Carrier]: I.Carrier := At[t := Cylinder.time p, x := Cylinder.point p].time;
\definition point[p: Cylinder.Carrier]: Model.Disk := At[t := Cylinder.time p, x := Cylinder.point p].point;
\definition family[p: Cylinder.Carrier]: Cylinder.Carrier := Cylinder.at (time p) (point p);
\module Continuity;
