\import algebraic_topology.Pointed[A := A].Maps[B := A] \as Maps;
\definition apply[x: A]: A := x;
\definition map: Maps.Map[source, source] := \into[A -> A](apply, Maps.Map[source, source]) \by {
  Maps.Laws[source, source, apply] { continuous := topology.Maps[A := A, B := A].Identity[].continuous source.topology, pointed := \refl(source.basepoint) }
};
