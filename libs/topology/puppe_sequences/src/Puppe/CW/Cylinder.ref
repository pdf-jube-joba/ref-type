\import Native.Filtration[].Stage[limit := k] \as Stage;
\import Stage.Charts[] \as Charts;
\import algebraic_topology.Cylinder[A := Stage.Carrier] \as Cylinder;
\import algebraic_topology.Cylinder[A := Charts.Carrier] \as ChartCylinder;
\import singular_cellular.Coproduct[Index := Charts.Index, fibers := (\fun (c: Charts.Index) => Euclidean.Disk c.dimension),
  spaces := (\fun (c: Charts.Index) => Euclidean.Dimension[n := c.dimension].diskTopology)] \as Disks;
\import Disks.ProductUniversal[X := I.Carrier, B := B, factor := I.topology, target := target] \as Universal;
\import topological_constructions.ProductQuotient[X := I.Carrier, A := Charts.Carrier, B := Stage.Carrier] \as Quotient;
\definition lift[p: ChartCylinder.Carrier]: Cylinder.Carrier := Quotient.map Charts.map p;
\definition value[p: ChartCylinder.Carrier]: B := f (lift p);
\definition Branches: \Prop := Universal.Branches value;
\definition continuous: Branches -> topology.Continuity[A := Cylinder.Carrier, B := B].Continuous (Cylinder.topology Stage.topology) target f :=
  \fun (branches: Branches)(U: \Pow B)(open: topology.Topology[Carrier := B].IsOpenIn target U) =>
    (Quotient.quotientMap I.topology I.compact I.hausdorff Charts.topology Stage.topology Charts.map Charts.quotientMap).reflectsOpen
      ({ p: Cylinder.Carrier \where \In[B] U (f p) }) (Universal.continuous value branches U open);
