\definition pointed: algebraic_topology.Pointed[A := A].Space := algebraic_topology.Pointed[A := A].Space { topology := source, basepoint := base };
\import \root.Puppe[].Pair[A := A, source := pointed, subset := subset, containsBase := \bysub(A, subset, base)] \as Comparison;
\definition equivalence: \exists Comparison.ComparisonEquivalence := Comparison.equivalence cofibration;
