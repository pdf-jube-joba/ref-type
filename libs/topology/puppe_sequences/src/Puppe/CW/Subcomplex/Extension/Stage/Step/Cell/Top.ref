\definition onLower: \forall (t: I.Carrier)(x: Model.Disk)(lower: \In[A] (Filtration.subset k) (cell.characteristic x)) ->
  extension (DiskCylinder.at t x) = h (Cylinder.at t (\into[A](cell.characteristic x, Filtration.subset k) \by { lower })) :=
  \fun (t: I.Carrier)(x: Model.Disk)(lower: _) => extendedLaws.extends t
    (\into[Model.Disk](x, Boundary.subset) \by { Filtration.Interiors[].topBoundary k cell member dimension x lower });
\definition onSubset: \forall (t: I.Carrier)(x: Model.Disk)(inside: \In[A] subset (cell.characteristic x)) ->
  extension (DiskCylinder.at t x) = problem.family (SubCylinder.at t (\into[A](cell.characteristic x, subset) \by { inside })) := \block {
  \fun (t: I.Carrier)(x: Model.Disk)(inside: _) \then
  \let boundary: BoundarySpace.CarrierSet := \into[Model.Disk](x, Boundary.subset) \by { boundaryOutside cell member outside x inside } \then
  \return trans!{B} _ _ _ (extendedLaws.extends t boundary) (hLaws.agrees t (boundaryPoint boundary) inside)
};
\definition result: Good := \into[DiskCylinder.Carrier -> B](extension, Good) \by {
  GoodLaws[extension] { continuous := extendedLaws.continuous, initial := extendedLaws.initial, onLower := onLower, onSubset := onSubset }
};
