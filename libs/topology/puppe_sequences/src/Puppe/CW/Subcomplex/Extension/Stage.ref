\import Filtration.Stage[limit := k] \as Skeleton;
\import algebraic_topology.Cylinder[A := Skeleton.Carrier] \as Cylinder;
\import topology.Continuity[A := Cylinder.Carrier, B := B] \as Maps;
\structure Laws[h: Cylinder.Carrier -> B]: \Prop := {
  continuous: Maps.Continuous (Cylinder.topology Skeleton.topology) target h,
  initial: \forall (x: Skeleton.Carrier) -> h (Cylinder.at I.start x) = problem.initial x,
  agrees: \forall (t: I.Carrier)(x: Skeleton.Carrier)(inside: \In[A] subset x) ->
    h (Cylinder.at t x) = problem.family (SubCylinder.at t (\into[A](x, subset) \by { inside })),
};
\definition Extension: \Set := \Cast[Cylinder.Carrier -> B] ({ h: Cylinder.Carrier -> B \where Laws[h] });
\definition extensionLaws[h: Extension]: Laws[h] := \bysub(Cylinder.Carrier -> B, Extension, h);

\module Step(h: Extension);
