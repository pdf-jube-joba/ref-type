\structure Data: \Set := {
  value: I.Carrier -> I.Carrier,
  continuous: topology.Continuity[A := I.Carrier, B := I.Carrier].Continuous I.topology I.topology value,
  bottom: value I.start = I.end,
  top: value I.end = I.start,
};
\definition reflection: Data := Data { value := I.reverse, continuous := I.reverseContinuous, bottom := I.reverseStart, top := I.reverseEnd };
\import \root.Puppe[].Compression[] \as Compression;
\definition compression: Data := Data { value := Compression.apply, continuous := Compression.continuous, bottom := Compression.atStart, top := Compression.atEnd };
\module Of(r: Data);
\module Between(r, s: Data);
