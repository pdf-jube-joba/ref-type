\import \root.Puppe[].Suspension[A := A, source := source] \as Suspension;
\import Attached.Universal[D := Suspension.Carrier] \as Gluing;
\definition constant[x: B]: Suspension.Carrier := Suspension.point;
\definition compatible: Gluing.Compatible constant Suspension.quotient := \fun (x: A) => sym!{Suspension.Carrier} _ _ (Suspension.onBase x);
\definition apply: Carrier -> Suspension.Carrier := Gluing.apply constant Suspension.quotient compatible;
\definition onTarget: \forall (x: B) -> apply (inclusion x) = Suspension.point := Gluing.onLeft constant Suspension.quotient compatible;
\definition onCone: \forall (x: Cone.Carrier) -> apply (cone x) = Suspension.quotient x := Gluing.onRight constant Suspension.quotient compatible;
\definition continuous: topology.Continuity[A := Carrier, B := Suspension.Carrier].Continuous topology Suspension.topology apply :=
  Gluing.continuous target.topology Cone.topology Suspension.topology constant Suspension.quotient compatible
    (topology.Maps[A := B, B := Suspension.Carrier].constantContinuous target.topology Suspension.topology Suspension.point) Suspension.quotientContinuous;
\import algebraic_topology.Pointed[A := Carrier].Maps[B := Suspension.Carrier] \as Pointed;
\definition map: Pointed.Map[pointed, Suspension.pointed] := \into[Carrier -> Suspension.Carrier](apply, Pointed.Map[pointed, Suspension.pointed]) \by {
  Pointed.Laws[pointed, Suspension.pointed, apply] { continuous := continuous, pointed := onTarget target.basepoint }
};
