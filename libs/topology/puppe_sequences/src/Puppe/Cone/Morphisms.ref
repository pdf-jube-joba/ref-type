\import algebraic_topology.Pointed[A := A].Maps[B := C] \as Left;
\import algebraic_topology.Pointed[A := B].Maps[B := D] \as Right;
\structure Square: \Set := {
  left: Left.Map[source, nextSource],
  right: Right.Map[target, nextTarget],
  commutes: \forall (x: A) -> next (left x) = right (f x),
};
\import \root.Puppe[].Cone[A := C, B := D, source := nextSource, target := nextTarget, f := next] \as Next;
\module Of(square: Square);
