\import \parent.Of[initial := a] \as Source;
\import \parent.Of[initial := b] \as Target;
\definition advance[n: N.Nat^][s: Square[Source.arrows n, Target.arrows n]]:
  Square[Source.arrows (N.Nat^::succ n), Target.arrows (N.Nat^::succ n)] :=
  \parent.Mapping[a := Source.arrows n, b := Target.arrows n, square := s].next;
\definition squares: \forall (n: N.Nat^) -> Square[Source.arrows n, Target.arrows n] :=
  \induction (n: N.Nat^) \return Square[Source.arrows n, Target.arrows n] \with {
    | zero: square
    | succ: advance
  };
\module At(n: N.Nat^) {
  \import \parent.\parent.Mapping[a := Source.arrows n, b := Target.arrows n, square := squares n] \as Mapping;
  \definition next: Square[Source.arrows (N.Nat^::succ n), Target.arrows (N.Nat^::succ n)] := squares (N.Nat^::succ n);
  \definition commutes: \forall (x: (Source.arrows n).A) -> (data (Target.arrows n)).map ((squares n).left x) = (squares n).right ((data (Source.arrows n)).map x) := (squares n).commutes;
}
