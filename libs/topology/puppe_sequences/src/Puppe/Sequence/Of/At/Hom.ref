\import \root.Puppe[].Maps[A := arrow.A, B := C, source := (data arrow).source, target := range] \as Source;
\import \root.Puppe[].Maps[A := arrow.B, B := C, source := (data arrow).target, target := range] \as Target;
\import \root.Puppe[].Maps[A := next.B, B := C, source := (data next).target, target := range] \as ConeMaps;
\import Target.Precompose[C := arrow.A, domain := (data arrow).source, f := (data arrow).map] \as Pullback;
\import ConeMaps.Precompose[C := arrow.B, domain := (data arrow).target, f := (data next).map] \as Restriction;
\definition exact[x: Target.Class]: Logic.PropEquiv[Pullback.apply x = Source.zero,
  \exists ( y: ConeMaps.Class \where Restriction.apply y = x )] := Model.Exactness[C := C, range := range].exact x;
\import \root.Puppe[].Maps[A := Suspension.Carrier, B := C, source := Suspension.pointed, target := range] \as SuspensionMaps;
\import SuspensionMaps.Precompose[C := next.B, domain := (data next).target, f := Model.Connecting[].map] \as ConnectingPull;
\definition connectingExact[x: ConeMaps.Class]: Logic.PropEquiv[Restriction.apply x = Target.zero,
  \exists ( y: SuspensionMaps.Class \where ConnectingPull.apply y = x )] := Iteration.Exactness[C := C, range := range].exact x;
