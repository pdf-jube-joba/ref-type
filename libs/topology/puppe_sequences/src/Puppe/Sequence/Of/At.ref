\definition arrow: Arrow := arrows n;
\import \root.Puppe[].Cone[A := arrow.A, B := arrow.B, source := (data arrow).source, target := (data arrow).target, f := (data arrow).map] \as Model;
\import Model.Iteration[] \as Iteration;
\import Iteration.Inverse[] \as Inverse;
\import \root.Puppe[].Suspension[A := arrow.A, source := (data arrow).source] \as Suspension;
\definition next: Arrow := arrows (N.Nat^::succ n);
\definition following: Arrow := arrows (N.Nat^::succ (N.Nat^::succ n));
\definition comparison: \root.Puppe[].Equivalence[A := following.B, B := Suspension.Carrier, source := (data following).target, target := Suspension.pointed].Data := Inverse.equivalence;
\definition projection: algebraic_topology.Pointed[A := following.B].Maps[B := Suspension.Carrier].Map[(data following).target, Suspension.pointed] := Iteration.projectionMap;
\definition onInclusion: \forall (x: next.B) -> projection ((data following).map x) = Model.Connecting[].apply x := Iteration.onOriginal;
\module Hom(C: \Set, range: algebraic_topology.Pointed[A := C].Space);
\import Iteration.Successor[] \as Successor;
\import \root.Puppe[].Suspension[A := arrow.B, source := (data arrow).target] \as TargetSuspension;
\import \root.Puppe[].Maps[A := Suspension.Carrier, B := TargetSuspension.Carrier, source := Suspension.pointed, target := TargetSuspension.pointed] \as SuccessorMaps;
\definition nextConnecting: SuccessorMaps.Map := Successor.map;
\definition reflectedSuspension: SuccessorMaps.Map := Successor.reflected;
\definition successorComparison: SuccessorMaps.Homotopy[nextConnecting, reflectedSuspension] := Successor.homotopy;
