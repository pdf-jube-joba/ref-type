\import \root.Puppe[].Cone[A := a.A, B := a.B, source := (data a).source, target := (data a).target, f := (data a).map] \as Source;
\import \root.Puppe[].Cone[A := b.A, B := b.B, source := (data b).source, target := (data b).target, f := (data b).map] \as Target;
\import Source.Morphisms[C := b.A, D := b.B, nextSource := (data b).source, nextTarget := (data b).target, next := (data b).map] \as Morphisms;
\definition given: Morphisms.Square := Morphisms.Square { left := square.left, right := square.right, commutes := square.commutes };
\import Morphisms.Of[square := given] \as Induced;
\definition next: Square[step a, step b] := Square[step a, step b] {
  left := square.right, right := Induced.map,
  commutes := \fun (x: a.B) => sym!{Target.Carrier} _ _ (Induced.onTarget x),
};
\import \root.Puppe[].Suspension[A := a.A, source := (data a).source] \as SourceSuspension;
\import \root.Puppe[].Suspension[A := b.A, source := (data b).source] \as TargetSuspension;
\import SourceSuspension.Mapping[B := b.A, target := (data b).source, f := square.left] \as Suspended;
\definition connectingNatural: \forall (x: Source.Carrier) -> Target.Connecting[].apply (next.right x) = Suspended.apply (Source.Connecting[].apply x) := Induced.connectingNatural;
