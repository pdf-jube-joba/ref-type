\import \root.Puppe[].Maps[A := A, B := B, source := source, target := target] \as Forward;
\import \root.Puppe[].Maps[A := B, B := A, source := target, target := source] \as Backward;
\import \root.Puppe[].Maps[A := A, B := A, source := source, target := source] \as Left;
\import \root.Puppe[].Maps[A := B, B := B, source := target, target := target] \as Right;
\import \root.Puppe[].Identity[A := A, source := source] \as LeftIdentity;
\import \root.Puppe[].Identity[A := B, source := target] \as RightIdentity;
\import algebraic_topology.Pointed[A := A].Maps[B := B].Composition[C := A] \as LeftComposition;
\import algebraic_topology.Pointed[A := B].Maps[B := A].Composition[C := B] \as RightComposition;
\structure Data: \Set := {
  forward: Forward.Map,
  backward: Backward.Map,
  leftInverse: Left.Related (LeftComposition.compose source target source forward backward) LeftIdentity.map,
  rightInverse: Right.Related (RightComposition.compose target source target backward forward) RightIdentity.map,
};
