\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Proposition[] \as Logic;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\module Cofibration(A: \Set, subset: \Pow A);
\module Disk(n: std.Data[].Nat[].Nat^);
\module Radial(t, r: algebraic_topology.Interval[].Carrier);
\module CW(A: \Set, source: topology.Topology[Carrier := A].Topology, complex: algebraic_topology.CW[A := A].FiniteComplex[source]);

\module Maps(A, B: \Set, source: algebraic_topology.Pointed[A := A].Space, target: algebraic_topology.Pointed[A := B].Space);
\module ReducedCone(A: \Set, source: algebraic_topology.Pointed[A := A].Space);

\module Cone(A, B: \Set, source: algebraic_topology.Pointed[A := A].Space, target: algebraic_topology.Pointed[A := B].Space,
  f: algebraic_topology.Pointed[A := A].Maps[B := B].Map[source, target]);
\module Suspension(A: \Set, source: algebraic_topology.Pointed[A := A].Space);
