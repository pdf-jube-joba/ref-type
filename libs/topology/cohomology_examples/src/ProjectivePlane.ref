\inductive Vertex: \Set := | center: Vertex | rim: Vertex;
\inductive Edge: \Set := | loop: Edge | first: Edge | second: Edge;
\inductive Triangle: \Set := | upper: Triangle | lower: Triangle;
\import \root.Surface[V := Vertex, E := Edge, T := Triangle] \as Surface;
\definition source: Edge -> Vertex := \induction (e: Edge) \return Vertex \with {
  | loop: Vertex::rim | first: Vertex::center | second: Vertex::center
};
\definition target(e: Edge): Vertex := Vertex::rim;
\definition front: Triangle -> Edge := \induction (t: Triangle) \return Edge \with {
  | upper: Edge::first | lower: Edge::second
};
\definition diagonal: Triangle -> Edge := \induction (t: Triangle) \return Edge \with {
  | upper: Edge::second | lower: Edge::first
};
\definition back(t: Triangle): Edge := Edge::loop;
\definition data: Surface.Data := Surface.Data {
  source := source, target := target, front := front, diagonal := diagonal, back := back,
};
\definition object: Surface.Object := Surface.Object {
  source := source, target := target, front := front, diagonal := diagonal, back := back,
  first := \induction (t: Triangle) \return source (front t) = source (diagonal t) \with {
    | upper: \refl(Vertex::center) | lower: \refl(Vertex::center)
  },
  middle := \fun (t: Triangle) => \refl(Vertex::rim),
  last := \fun (t: Triangle) => \refl(Vertex::rim),
};
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import module_theory.Module[].Over[R := I.Int^, ring := IntegerRing.ring] \as Modules;
\module With(A: Modules.Bundle);
\module ModTwo;
\module Integral;
\module Geometry;
\module Bockstein;
