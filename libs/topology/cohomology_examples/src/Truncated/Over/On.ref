\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import Modules.Of[V := first.Carrier, space := first.space].Submodule[] \as FirstSubmodules;
\import FirstSubmodules.Image[U := zeroth.Carrier, source := zeroth.space] \as FirstImages;
\definition firstBoundaries: FirstSubmodules.Submodule := FirstImages.image deltaZero;
\import Modules.Of[V := second.Carrier, space := second.space].Submodule[] \as SecondSubmodules;
\import SecondSubmodules.Image[U := first.Carrier, source := first.space] \as SecondImages;
\definition secondBoundaries: SecondSubmodules.Submodule := SecondImages.image deltaOne;
\definition firstBoundaryClosed: \forall (x: first.Carrier) -> FirstSubmodules.Member firstBoundaries x -> #apply{deltaOne} x = #zero{second.space} :=
  \fun (x: first.Carrier)(member: _) => FirstImages.eliminate deltaZero x (#apply{deltaOne} x = #zero{second.space})
    (\fun (y: zeroth.Carrier)(equal: #apply{deltaZero} y = x) =>
      \idelim #apply{deltaZero} y = x \with z: first.Carrier => #apply{deltaOne} z = #zero{second.space} \by {
        base: square y, equality: equal
      }) member;
\definition zeroDifferential: Modules.Hom[V := second.Carrier, W := Zero.Carrier, source := second.space, target := Zero.moduleSpace].Map :=
  Modules.Hom[V := second.Carrier, W := Zero.Carrier, source := second.space, target := Zero.moduleSpace].zeroMap;
\module DegreeZero;
\module DegreeOne;
\module DegreeTwo;
\module Native;
