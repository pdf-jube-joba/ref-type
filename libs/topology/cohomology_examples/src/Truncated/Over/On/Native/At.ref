\import Modules.Of[V := Base, space := baseSpace].Submodule[] \as Submodules;
\import \parent.Restriction[] \as Eligibility;
\definition eligible(x: Base): \Prop := Eligibility.Eligible[n, x];
\definition submodule: Submodules.Submodule := Submodules.Submodule {
  carrier := { x: Base \where eligible x },
  zero := Eligibility.Eligible[n, Product.origin] {
    zeroth := Logic.Or[n = N.Nat^::zero, Zeroth.zero = Zeroth.zero]::right (\refl(Zeroth.zero)),
    first := Logic.Or[n = firstDegree, First.zero = First.zero]::right (\refl(First.zero)),
    second := Logic.Or[n = secondDegree, Second.zero = Second.zero]::right (\refl(Second.zero)),
  },
  addition := \fun (x, y: Base)(left: eligible x)(right: eligible y) => Eligibility.Eligible[n, Product.plus x y] {
    zeroth := Eligibility.Coordinate[A := zeroth].addition n N.Nat^::zero (firstCoordinate x) (firstCoordinate y) #zeroth{left} #zeroth{right},
    first := Eligibility.Coordinate[A := first].addition n firstDegree (secondCoordinate x) (secondCoordinate y) #first{left} #first{right},
    second := Eligibility.Coordinate[A := second].addition n secondDegree (thirdCoordinate x) (thirdCoordinate y) #second{left} #second{right},
  },
  scalar := \fun (a: I.Int^)(x: Base)(member: eligible x) => Eligibility.Eligible[n, Product.scale a x] {
    zeroth := Eligibility.Coordinate[A := zeroth].scalar n N.Nat^::zero a (firstCoordinate x) #zeroth{member},
    first := Eligibility.Coordinate[A := first].scalar n firstDegree a (secondCoordinate x) #first{member},
    second := Eligibility.Coordinate[A := second].scalar n secondDegree a (thirdCoordinate x) #second{member},
  },
};
\import Submodules.Of[S := submodule] \as Induced;
\definition Carrier: \Set := Induced.Carrier;
\definition space: Modules.Space Carrier := Induced.moduleSpace;
