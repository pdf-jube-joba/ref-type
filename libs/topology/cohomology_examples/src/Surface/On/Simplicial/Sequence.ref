\import resolutions.HomComplex[].Over[R := I.Int^, ring := IntegerRing.commutativeRing] \as Hom;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := IntegerRing.ring] \as Cochains;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := IntegerRing.ring].End[C := chainComplex] \as Identity;
\import Modules.ShortExact[A := L, B := M, C := R] \as CoefficientExact;
\import Hom.On[P := chainComplex, N := L] \as Left;
\import Hom.On[P := chainComplex, N := M] \as Middle;
\import Hom.On[P := chainComplex, N := R] \as Right;
\import Hom.Mapping[P := chainComplex, Q := chainComplex, N := L, L := M] \as Inclusion;
\import Hom.Mapping[P := chainComplex, Q := chainComplex, N := M, L := R] \as Projection;
\import Cochains.ShortExact[A := Left.complex, B := Middle.complex, C := Right.complex] \as Exact;
\module On(s: CoefficientExact.Sequence);
