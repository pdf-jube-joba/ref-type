\import Modules.Hom[V := Chains.Carrier n, W := L.Carrier, source := Chains.space n, target := L.space] \as LeftMaps;
\import Modules.Hom[V := Chains.Carrier n, W := M.Carrier, source := Chains.space n, target := M.space] \as MiddleMaps;
\import Modules.Hom[V := Chains.Carrier n, W := R.Carrier, source := Chains.space n, target := R.space] \as RightMaps;
\definition injective: \forall (h, k: Left.Carrier n) -> #apply{inclusion} n h = #apply{inclusion} n k -> h = k :=
  \fun (h, k: Left.Carrier n)(equal: _) => LeftMaps.ext h k
    (\fun (x: Chains.Carrier n) => #injective{s} (#apply{h} x) (#apply{k} x)
      (congr!{{Middle.Carrier n} M.Carrier} (\fun (u: Middle.Carrier n) => #apply{u} x) _ _ equal));
\definition zero: \forall (h: Left.Carrier n) -> #apply{projection} n (#apply{inclusion} n h) = #zero{(Right.space n)} :=
  \fun (h: Left.Carrier n) => RightMaps.ext (#apply{projection} n (#apply{inclusion} n h)) (#zero{(Right.space n)})
    (\fun (x: Chains.Carrier n) => #zero{s} (#apply{h} x));
\import Modules.Free[Generators := Carrier n] \as Free;
\definition onto: \forall (h: Right.Carrier n) -> \exists { k: Middle.Carrier n \where #apply{projection} n k = h } := \block {
  \fun (h: Right.Carrier n) \then
  \takefrom k: \Cast[Middle.Carrier n] ({ k: Middle.Carrier n \where \forall (x: Chains.Carrier n) -> #apply{s.projection} (#apply{k} x) = #apply{h} x })
    \by Free.Lifting[A := M, B := R, q := s.projection, f := h].existence (#onto{s}) \then
  \return Logic.existsIntro[Middle.Carrier n, { k: Middle.Carrier n \where #apply{projection} n k = h }] k
    (RightMaps.ext (#apply{projection} n k) h (\bysub(Middle.Carrier n,
      { k: Middle.Carrier n \where \forall (x: Chains.Carrier n) -> #apply{s.projection} (#apply{k} x) = #apply{h} x }, k)))
};
\import CoefficientExact.Kernel[sequence := s] \as Kernel;
\definition Vanishes(h: Middle.Carrier n): \Prop := \forall (x: Chains.Carrier n) -> #apply{s.projection} (#apply{h} x) = #zero{R.space};
\import Modules.Hom[V := Chains.Carrier n, W := Kernel.Carrier, source := Chains.space n, target := Kernel.space] \as KernelMaps;
\definition intoKernel(h: Middle.Carrier n)(vanishes: Vanishes h): KernelMaps.Map := KernelMaps.Map {
  apply := \fun (x: Chains.Carrier n) => \into[M.Carrier](#apply{h} x, #carrier{Kernel.kernel}) \by { vanishes x },
  addition := #addition{h}, scalar := #scalar{h},
};
\import Modules.Hom[V := Kernel.Carrier, W := L.Carrier, source := Kernel.space, target := L.space]
  .Composition[U := Chains.Carrier n, domain := Chains.space n] \as Descent;
\definition kernelImage: \forall (h: Middle.Carrier n) -> #apply{projection} n h = #zero{(Right.space n)} ->
  \exists { k: Left.Carrier n \where #apply{inclusion} n k = h } := \block {
  \fun (h: Middle.Carrier n)(zero: _) \then
  \let vanishes: Vanishes h := \fun (x: Chains.Carrier n) => congr!{{Right.Carrier n} R.Carrier}
    (\fun (u: Right.Carrier n) => #apply{u} x) _ _ zero \then
  \let k: Left.Carrier n := Descent.compose Kernel.backward (intoKernel h vanishes) \then
  \return Logic.existsIntro[Left.Carrier n, { k: Left.Carrier n \where #apply{inclusion} n k = h }] k
    (MiddleMaps.ext (#apply{inclusion} n k) h (\fun (x: Chains.Carrier n) => Kernel.onKernel (#apply{(intoKernel h vanishes)} x)))
};
