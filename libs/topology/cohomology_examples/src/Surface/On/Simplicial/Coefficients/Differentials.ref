\import \parent.DegreeZero[] \as DegreeZero;
\import \parent.DegreeOne[] \as DegreeOne;
\import \parent.DegreeTwo[] \as DegreeTwo;
\import \root.Surface[V := V, E := E, T := T].On[surface := surface].With[A := A] \as Matrix;
\import Modules.Alternating[V := A.Carrier, space := A.space] \as Alternating;
\import Modules.Alternating[V := Chains.Carrier N.Nat^::zero, space := Chains.space N.Nat^::zero].Mapping[W := A.Carrier, target := A.space] \as ZeroSum;
\import Modules.Alternating[V := Chains.Carrier one, space := Chains.space one].Mapping[W := A.Carrier, target := A.space] \as OneSum;
\definition differenceZero(a: A.Carrier): Group.difference a Values.zero = a :=
  trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (Values.add a) _ _ Group.negZero) (Group.zeroRight a);
\definition triangleSum(a, b, c: A.Carrier): Group.difference a (Group.difference b (Group.difference c Values.zero)) = Values.add (Group.difference a b) c :=
  trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (\fun (x: A.Carrier) => Group.difference a (Group.difference b x)) _ _ (differenceZero c))
    (trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (Values.add a) _ _ (Group.negAdd b (Values.neg c)))
      (trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (\fun (x: A.Carrier) => Values.add a (Values.add (Values.neg b) x)) _ _ (Group.negNeg c))
        (sym!{A.Carrier} _ _ (Group.assoc a (Values.neg b) c))));
\definition zeroth(phi: Native.Carrier N.Nat^::zero): DegreeOne.evaluate (Native.apply N.Nat^::zero phi) = Matrix.deltaZero (DegreeZero.evaluate phi) :=
  \axiom:funext(DegreeOne.evaluate (Native.apply N.Nat^::zero phi), Matrix.deltaZero (DegreeZero.evaluate phi), \fun (e: E) =>
    trans!{A.Carrier} _ _ _ (congr!{(Chains.Carrier N.Nat^::zero) A.Carrier} (#apply{phi}) _ _ (Chains.Boundary[n := N.Nat^::zero].onGenerator (edge e)))
      (trans!{A.Carrier} _ _ _ (ZeroSum.law phi two (\fun (i: Fin.Fin two) => Chains.generator N.Nat^::zero (face N.Nat^::zero i (edge e))))
        (congr!{A.Carrier A.Carrier} (Group.difference (DegreeZero.evaluate phi (surface.target e))) _ _ (differenceZero (DegreeZero.evaluate phi (surface.source e))))));
\definition first(phi: Native.Carrier one): DegreeTwo.evaluate (Native.apply one phi) = Matrix.deltaOne (DegreeOne.evaluate phi) :=
  \axiom:funext(DegreeTwo.evaluate (Native.apply one phi), Matrix.deltaOne (DegreeOne.evaluate phi), \fun (t: T) =>
    trans!{A.Carrier} _ _ _ (congr!{(Chains.Carrier one) A.Carrier} (#apply{phi}) _ _ (Chains.Boundary[n := one].onGenerator (triangle t)))
      (trans!{A.Carrier} _ _ _ (OneSum.law phi (N.Nat^::succ two) (\fun (i: Fin.Fin (N.Nat^::succ two)) => Chains.generator one (face one i (triangle t))))
        (triangleSum (DegreeOne.evaluate phi (surface.back t)) (DegreeOne.evaluate phi (surface.diagonal t)) (DegreeOne.evaluate phi (surface.front t)))));
\definition inverseZeroth(f: DegreeZero.FunctionCarrier): Native.apply N.Nat^::zero (DegreeZero.extend f) = DegreeOne.extend (Matrix.deltaZero f) :=
  trans!{(Native.Carrier one)} _ _ _ (sym!{(Native.Carrier one)} _ _ (DegreeOne.leftInverse (Native.apply N.Nat^::zero (DegreeZero.extend f))))
    (congr!{DegreeOne.FunctionCarrier (Native.Carrier one)} DegreeOne.extend _ _
      (trans!{DegreeOne.FunctionCarrier} _ _ _ (zeroth (DegreeZero.extend f))
        (congr!{DegreeZero.FunctionCarrier DegreeOne.FunctionCarrier} Matrix.deltaZero _ _ (DegreeZero.rightInverse f))));
\definition inverseFirst(f: DegreeOne.FunctionCarrier): Native.apply one (DegreeOne.extend f) = DegreeTwo.extend (Matrix.deltaOne f) :=
  trans!{(Native.Carrier two)} _ _ _ (sym!{(Native.Carrier two)} _ _ (DegreeTwo.leftInverse (Native.apply one (DegreeOne.extend f))))
    (congr!{DegreeTwo.FunctionCarrier (Native.Carrier two)} DegreeTwo.extend _ _
      (trans!{DegreeTwo.FunctionCarrier} _ _ _ (first (DegreeOne.extend f))
        (congr!{DegreeOne.FunctionCarrier DegreeTwo.FunctionCarrier} Matrix.deltaOne _ _ (DegreeOne.rightInverse f))));
\import \root.Coordinates[].On[Generators := Carrier (N.Nat^::succ two), coefficients := A] \as Third;
\import Modules.Free[Generators := Carrier (N.Nat^::succ two)].To[W := A.Carrier, target := A.space] \as ThirdFree;
\definition second(phi: Native.Carrier two): Native.apply two phi = #zero{(Native.space (N.Nat^::succ two))} :=
  ThirdFree.ext (Native.apply two phi) #zero{(Native.space (N.Nat^::succ two))}
    (\fun (sigma: Carrier (N.Nat^::succ two)) => Logic.falseElim
      (#apply{(Native.apply two phi)} (Chains.generator (N.Nat^::succ two) sigma) = #zero{A.space})
      (higherEmpty N.Nat^::zero sigma (\bysub(Base, { tau: Base \where degree tau = N.Nat^::succ two }, sigma))));
