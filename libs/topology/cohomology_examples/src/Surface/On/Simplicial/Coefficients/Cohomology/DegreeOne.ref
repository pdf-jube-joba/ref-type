\import Cochains.At[C := Native.complex, k := one] \as Source;
\import Local.DegreeOne[] \as Target;
\import \root.Surface[V := V, E := E, T := T].On[surface := surface].Simplicial[].Coefficients[A := A].DegreeZero[] \as ZeroCoordinates;
\import \root.Surface[V := V, E := E, T := T].On[surface := surface].Simplicial[].Coefficients[A := A].DegreeTwo[] \as TwoCoordinates;
\import Modules.Of[V := Matrix.first.Carrier, space := Matrix.first.space].Submodule[].Image[U := Matrix.zeroth.Carrier, source := Matrix.zeroth.space] \as BoundaryImages;
\import \root.Surface[V := V, E := E, T := T].On[surface := surface].Simplicial[].Coefficients[A := A].DegreeOne[] \as OneCoordinates;
\definition forwardClosed[phi: Source.CycleCarrier]: Matrix.deltaOne (OneCoordinates.evaluate phi) = (Matrix.second.space).zero :=
  trans!{TwoCoordinates.FunctionCarrier} _ _ _ (sym!{TwoCoordinates.FunctionCarrier} _ _ (Differentials.first phi))
    (trans!{TwoCoordinates.FunctionCarrier} _ _ _
      (congr!{{Native.Carrier two} TwoCoordinates.FunctionCarrier} TwoCoordinates.evaluate _ _ (\bysub(Native.Carrier one, (Source.cycles).carrier, phi)))
      (Modules.Hom[V := Native.Carrier two, W := TwoCoordinates.FunctionCarrier, source := Native.space two, target := TwoCoordinates.functionSpace].zeroPreserved TwoCoordinates.forward));
\definition backwardClosed[f: Target.CycleCarrier]: Native.apply one (OneCoordinates.extend f) = (Native.space two).zero :=
  trans!{{Native.Carrier two}} _ _ _ (Differentials.inverseFirst f)
    (trans!{{Native.Carrier two}} _ _ _
      (congr!{TwoCoordinates.FunctionCarrier {Native.Carrier two}} TwoCoordinates.extend _ _ (\bysub(Matrix.first.Carrier, (Target.cycles).carrier, f)))
      (Modules.Hom[V := TwoCoordinates.FunctionCarrier, W := Native.Carrier two, source := TwoCoordinates.functionSpace, target := Native.space two].zeroPreserved TwoCoordinates.backward));
\definition forwardValue[phi: Source.CycleCarrier]: Target.CycleCarrier := Target.cycle (OneCoordinates.evaluate phi) (forwardClosed phi);
\definition backwardValue[f: Target.CycleCarrier]: Source.CycleCarrier := Source.cycle (OneCoordinates.extend f) (backwardClosed f);
\definition sourceCycles: Modules.Bundle := Modules.Bundle { Carrier := Source.CycleCarrier, space := Source.cycleSpace };
\definition targetCycles: Modules.Bundle := Modules.Bundle { Carrier := Target.CycleCarrier, space := Target.cycleSpace };
\import Modules.Hom[V := Source.CycleCarrier, W := Target.CycleCarrier, source := Source.cycleSpace, target := Target.cycleSpace] \as Forward;
\import Modules.Hom[V := Target.CycleCarrier, W := Source.CycleCarrier, source := Target.cycleSpace, target := Source.cycleSpace] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := forwardValue,
  addition := \fun (phi, psi: Source.CycleCarrier) => (OneCoordinates.forward).addition phi psi,
  scalar := \fun (a: I.Int^)(phi: Source.CycleCarrier) => (OneCoordinates.forward).scalar a phi,
};
\definition backward: Backward.Map := Backward.Map {
  apply := backwardValue,
  addition := \fun (f, g: Target.CycleCarrier) => (OneCoordinates.backward).addition f g,
  scalar := \fun (a: I.Int^)(f: Target.CycleCarrier) => (OneCoordinates.backward).scalar a f,
};
\import Modules.QuotientMapping[A := sourceCycles, B := targetCycles].On[S := Source.boundariesInside, T := Target.boundariesInside, f := forward] \as Quotient;
\definition compatible: Quotient.Compatible := \block {
  \fun (phi: Source.CycleCarrier)(boundary: _) \then
  \takefrom f: \Cast[Native.Carrier N.Nat^::zero] ({ f: Native.Carrier N.Nat^::zero \where Native.apply N.Nat^::zero f = phi }) \by boundary \then
  \return \idelim Matrix.deltaZero (ZeroCoordinates.evaluate f) = OneCoordinates.evaluate phi
    \with y: Matrix.first.Carrier => \In[Matrix.first.Carrier] ((Target.boundaries).carrier) y \by {
      base: BoundaryImages.member Matrix.differentialZero (ZeroCoordinates.evaluate f),
      equality: trans!{OneCoordinates.FunctionCarrier} _ _ _ (sym!{OneCoordinates.FunctionCarrier} _ _ (Differentials.zeroth f))
        (congr!{{Native.Carrier one} OneCoordinates.FunctionCarrier} OneCoordinates.evaluate _ _ (\bysub(Native.Carrier N.Nat^::zero, { f: Native.Carrier N.Nat^::zero \where Native.apply N.Nat^::zero f = phi }, f)))
    }
};
\import Quotient.Inverse[g := backward] \as Inverse;
\definition compatibleBack: Inverse.CompatibleBack := \fun (phi: Target.CycleCarrier)(boundary: _) =>
  BoundaryImages.eliminate Matrix.differentialZero phi (\In[Native.Carrier one] (Source.Boundaries one) (OneCoordinates.extend phi))
    (\fun (f: Matrix.zeroth.Carrier)(represented: Matrix.deltaZero f = phi) =>
      Logic.existsIntro[Native.Carrier N.Nat^::zero, { g: Native.Carrier N.Nat^::zero \where Native.apply N.Nat^::zero g = OneCoordinates.extend phi }] (ZeroCoordinates.extend f)
        (trans!{{Native.Carrier one}} _ _ _ (Differentials.inverseZeroth f) (congr!{OneCoordinates.FunctionCarrier {Native.Carrier one}} OneCoordinates.extend _ _ represented))) boundary;
\definition isomorphism: Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Isomorphism :=
  Inverse.isomorphism compatible compatibleBack (\fun (phi: Source.CycleCarrier) => OneCoordinates.leftInverse phi) (\fun (f: Target.CycleCarrier) => OneCoordinates.rightInverse f);
\definition onClass[phi: Source.CycleCarrier]: ((isomorphism).forward).apply (Source.classOf phi) = Target.classOf (forwardValue phi) := Quotient.onClass compatible phi;
