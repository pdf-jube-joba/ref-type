\import \root.Surface[V := V, E := E, T := T].On[surface := surface].Simplicial[].Coefficients[A := A].DegreeOne[] \as From;
\import \root.Surface[V := V, E := E, T := T].On[surface := surface].Simplicial[].Coefficients[A := B].DegreeOne[] \as To;
\definition pointwise[f: From.FunctionCarrier]: To.FunctionCarrier := \fun (x: From.Labels) => (u).apply (f x);
\definition evaluate[phi: Source.Carrier one]: To.evaluate ((map).apply one phi) = pointwise (From.evaluate phi) :=
  \refl(pointwise (From.evaluate phi));
\definition extend[f: From.FunctionCarrier]: (map).apply one (From.extend f) = To.extend (pointwise f) :=
  To.injective ((map).apply one (From.extend f)) (To.extend (pointwise f))
    (trans!{To.FunctionCarrier} _ _ _ (evaluate (From.extend f))
      (trans!{To.FunctionCarrier} _ _ _ (congr!{From.FunctionCarrier To.FunctionCarrier} pointwise _ _ (From.rightInverse f))
        (sym!{To.FunctionCarrier} _ _ (To.rightInverse (pointwise f)))));
