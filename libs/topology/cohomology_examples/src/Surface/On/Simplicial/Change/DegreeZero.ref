\import \root.Surface[V := V, E := E, T := T].On[surface := surface].Simplicial[].Coefficients[A := A].DegreeZero[] \as From;
\import \root.Surface[V := V, E := E, T := T].On[surface := surface].Simplicial[].Coefficients[A := B].DegreeZero[] \as To;
\definition pointwise(f: From.FunctionCarrier): To.FunctionCarrier := \fun (x: From.Labels) => #apply{u} (f x);
\definition evaluate(phi: Source.Carrier N.Nat^::zero): To.evaluate (#apply{map} N.Nat^::zero phi) = pointwise (From.evaluate phi) :=
  \refl(pointwise (From.evaluate phi));
\definition extend(f: From.FunctionCarrier): #apply{map} N.Nat^::zero (From.extend f) = To.extend (pointwise f) :=
  To.injective (#apply{map} N.Nat^::zero (From.extend f)) (To.extend (pointwise f))
    (trans!{To.FunctionCarrier} _ _ _ (evaluate (From.extend f))
      (trans!{To.FunctionCarrier} _ _ _ (congr!{From.FunctionCarrier To.FunctionCarrier} pointwise _ _ (From.rightInverse f))
        (sym!{To.FunctionCarrier} _ _ (To.rightInverse (pointwise f)))));
