\import resolutions.HomComplex[].Over[R := I.Int^, ring := IntegerRing.commutativeRing] \as Hom;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := IntegerRing.ring].End[C := chainComplex] \as Identity;
\import Hom.On[P := chainComplex, N := A] \as Source;
\import Hom.On[P := chainComplex, N := B] \as Target;
\import Hom.Mapping[P := chainComplex, Q := chainComplex, N := A, L := B] \as Mapping;
\definition map: _ := Mapping.On[f := Identity.identity, u := u].map;
\module DegreeZero;
\module DegreeOne;
\module DegreeTwo;
