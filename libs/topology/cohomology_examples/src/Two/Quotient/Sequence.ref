\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Nat;
\import std.Arithmetic[].IntAlgebra[].IntegralDomain[] \as Domain;
\import Modules.Hom[V := I.Int^, W := I.Int^, source := Modules.scalarModule, target := Modules.scalarModule] \as IntegerMaps;
\import Modules.Hom[V := Z2.Carrier, W := Carrier, source := Z2.space, target := integerSpace] \as ForwardMaps;
\definition integers: Modules.Bundle := Modules.Bundle { Carrier := I.Int^, space := Modules.scalarModule };
\definition magnitude: I.Int^ -> N.Nat^ := \induction (z: I.Int^) \return N.Nat^ \with {
  | ofNat: \fun (n: N.Nat^) => n | negSucc: \fun (n: N.Nat^) => n
};
\definition twoNonzero(equal: two = Arithmetic.zero): Logic.False :=
  Nat.succNeZero (N.Nat^::succ N.Nat^::zero) (congr!{I.Int^ N.Nat^} magnitude _ _ equal);
\definition injective(x, y: I.Int^)(equal: #apply{Z2.multiplication} x = #apply{Z2.multiplication} y): x = y :=
  Domain.cancellation two x y twoNonzero equal;
\definition onto: \forall (x: Carrier) -> \exists { y: I.Int^ \where #apply{reduction} y = x } :=
  B.cases (\fun (x: Carrier) => \exists { y: I.Int^ \where #apply{reduction} y = x })
    (Logic.existsIntro[I.Int^, { y: I.Int^ \where #apply{reduction} y = zero }] Arithmetic.zero (Reduction.zeroPreserved reduction))
    (Logic.existsIntro[I.Int^, { y: I.Int^ \where #apply{reduction} y = one }] Arithmetic.one (#scalarOne{integerSpace} one));
\definition compositionZero(x: I.Int^): #apply{reduction} (#apply{Z2.multiplication} x) = \root.Two[].zero :=
  trans!{Carrier} _ _ _ (sym!{Carrier} _ _ (onClass (Arithmetic.mul two x)))
    (trans!{Carrier} _ _ _ (congr!{Z2.Carrier Carrier} (#apply{forward}) _ _ (Z2.classMultiple x)) (ForwardMaps.zeroPreserved forward));
\definition kernelImage(x: I.Int^)(killed: #apply{reduction} x = \root.Two[].zero):
  \exists { y: I.Int^ \where #apply{Z2.multiplication} y = x } :=
  Images.eliminate Z2.multiplication x (\exists { y: I.Int^ \where #apply{Z2.multiplication} y = x })
    (\fun (y: I.Int^)(equal: #apply{Z2.multiplication} y = x) => Logic.existsIntro[I.Int^, { y: I.Int^ \where #apply{Z2.multiplication} y = x }] y equal)
    (Z2.classZeroMember x (trans!{Z2.Carrier} _ _ _ (sym!{Z2.Carrier} _ _ (leftInverseOnClass x))
      (trans!{Z2.Carrier} _ _ _ (congr!{Carrier Z2.Carrier} (#apply{backward}) _ _
        (trans!{Carrier} _ _ _ (onClass x) killed)) (BackwardMaps.zeroPreserved backward))));
\import Modules.ShortExact[A := integers, B := integers, C := coefficients] \as Sequences;
\definition sequence: Sequences.Sequence := Sequences.Sequence {
  inclusion := Z2.multiplication, projection := reduction,
  injective := injective, onto := onto, zero := compositionZero, kernelImage := kernelImage,
};
