\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as Laws;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition vertices: N.Nat^ := Nat.add forestEdges components;
\definition edges: N.Nat^ := Nat.add forestEdges chords;
\definition euler: Nat.add edges components = Nat.add vertices chords :=
  trans!{N.Nat^} _ _ _ (Laws.addAssoc forestEdges chords components)
    (trans!{N.Nat^} _ _ _ (congr!{N.Nat^ N.Nat^} (Nat.add forestEdges) _ _ (Laws.addComm chords components))
      (sym!{N.Nat^} _ _ (Laws.addAssoc forestEdges components chords)));
\definition cycleRank: Nat.sub (Nat.add edges components) vertices = chords :=
  trans!{N.Nat^} _ _ _ (congr!{N.Nat^ N.Nat^} (\fun (n: N.Nat^) => Nat.sub n vertices) _ _ euler)
    (trans!{N.Nat^} _ _ _ (congr!{N.Nat^ N.Nat^} (\fun (n: N.Nat^) => Nat.sub n vertices) _ _ (Laws.addComm vertices chords))
      (Laws.subAddCancel vertices chords));
