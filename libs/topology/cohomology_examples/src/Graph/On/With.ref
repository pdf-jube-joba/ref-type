\import Modules.Laws[V := A.Carrier, space := A.space] \as Values;
\import algebra.Group[].Of[Carrier := A.Carrier, group := Values.additive] \as Group;
\import Modules.Functions[X := Vertex, V := A.Carrier, target := A.space] \as Vertices;
\import Modules.Functions[X := Edge, V := A.Carrier, target := A.space] \as Edges;
\import Modules.Functions[X := Fin.Fin components, V := A.Carrier, target := A.space] \as Components;
\import Modules.Functions[X := Fin.Fin chords, V := A.Carrier, target := A.space] \as Chords;
\import Modules.Zero[] \as Zero;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\definition zeroth: Modules.Bundle := Modules.Bundle { Carrier := Vertices.Carrier, space := Vertices.space };
\definition first: Modules.Bundle := Modules.Bundle { Carrier := Edges.Carrier, space := Edges.space };
\definition zero: Modules.Bundle := Modules.Bundle { Carrier := Zero.Carrier, space := Zero.moduleSpace };
\definition componentValues: Modules.Bundle := Modules.Bundle { Carrier := Components.Carrier, space := Components.space };
\definition chordValues: Modules.Bundle := Modules.Bundle { Carrier := Chords.Carrier, space := Chords.space };
\definition delta(f: Vertices.Carrier): Edges.Carrier := \fun (e: Edge) => Group.difference (f (target e)) (f (source e));
\import Modules.Hom[V := Vertices.Carrier, W := Edges.Carrier, source := Vertices.space, target := Edges.space] \as Differentials;
\definition differential: Differentials.Map := Differentials.Map {
  apply := delta,
  addition := \fun (f, g: Vertices.Carrier) => Edges.ext (delta (Vertices.add f g)) (Edges.add (delta f) (delta g))
    (\fun (e: Edge) => Group.differenceAdd (f (target e)) (g (target e)) (f (source e)) (g (source e))),
  scalar := \fun (a: I.Int^)(f: Vertices.Carrier) => Edges.ext (delta (Vertices.scale a f)) (Edges.scale a (delta f))
    (\fun (e: Edge) => sym!{A.Carrier} _ _ (Values.scaleDifference a (f (target e)) (f (source e)))),
};
\module Paths;
\definition potential(f: Edges.Carrier): Vertices.Carrier := \fun (v: Vertex) => Paths.sum (\fun (e: ForestEdge) => f (forestEdge e)) (graph.path v);
\definition potentialAdd(f, g: Edges.Carrier): potential (Edges.add f g) = Vertices.add (potential f) (potential g) :=
  Vertices.ext (potential (Edges.add f g)) (Vertices.add (potential f) (potential g)) (\fun (v: Vertex) =>
    Paths.addition (\fun (e: ForestEdge) => f (forestEdge e)) (\fun (e: ForestEdge) => g (forestEdge e)) (graph.path v));
\import \root.Integral[].Maps[A := first, B := zeroth] \as Integrals;
\definition primitive: Modules.Hom[V := Edges.Carrier, W := Vertices.Carrier, source := Edges.space, target := Vertices.space].Map :=
  Integrals.fromAdditive potential potentialAdd;
\definition evaluateRoot(f: Vertices.Carrier): Components.Carrier := \fun (i: Fin.Fin components) => f (root i);
\definition constant(f: Components.Carrier): Vertices.Carrier := \fun (v: Vertex) => f (component v);
\definition evaluateChord(f: Edges.Carrier): Chords.Carrier := \fun (j: Fin.Fin chords) =>
  Group.difference (f (chord j)) (delta (potential f) (chord j));
\definition extendChord(f: Chords.Carrier): Edges.Carrier := \induction (e: Edge) \return A.Carrier \with {
  | inl: \fun (e: ForestEdge) => Group.zero
  | inr: f
};
\definition primitiveGradient(f: Vertices.Carrier): potential (delta f) = Vertices.add f (Vertices.neg (constant (evaluateRoot f))) :=
  Vertices.ext (potential (delta f)) (Vertices.add f (Vertices.neg (constant (evaluateRoot f)))) (\fun (v: Vertex) =>
    trans!{A.Carrier} _ _ _ (Paths.gradient f (graph.path v) (#valid{(\bysub(Data, Object, graph))} v))
      (congr!{Vertex A.Carrier} (\fun (u: Vertex) => Group.difference (f u) (f (root (component v)))) _ _ (#endpoint{(\bysub(Data, Object, graph))} v)));
\definition primitiveRoot(f: Edges.Carrier)(i: Fin.Fin components): potential f (root i) = Group.zero :=
  congr!{Walk A.Carrier} (Paths.sum (\fun (e: ForestEdge) => f (forestEdge e))) _ _ (#root{(\bysub(Data, Object, graph))} i);
\definition primitiveForest(f: Edges.Carrier)(e: ForestEdge): delta (potential f) (forestEdge e) = f (forestEdge e) :=
  trans!{A.Carrier} _ _ _
    (congr!{Walk A.Carrier} (\fun (w: Walk) => Group.difference (Paths.sum (\fun (k: ForestEdge) => f (forestEdge k)) w) (potential f (graph.parent e))) _ _ (#tree{(\bysub(Data, Object, graph))} e))
    (trans!{A.Carrier} _ _ _
      (congr!{A.Carrier A.Carrier} (\fun (x: A.Carrier) => Group.difference x (potential f (graph.parent e))) _ _ (Group.comm (potential f (graph.parent e)) (f (forestEdge e))))
      (trans!{A.Carrier} _ _ _ (Group.assoc (f (forestEdge e)) (potential f (graph.parent e)) (Group.neg (potential f (graph.parent e))))
        (trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (Group.add (f (forestEdge e))) _ _ (Group.inverseRight (potential f (graph.parent e)))) (Group.zeroRight (f (forestEdge e))))));
\definition reductionEquation(f: Edges.Carrier): Edges.add f (Edges.neg (extendChord (evaluateChord f))) = delta (potential f) :=
  Edges.ext (Edges.add f (Edges.neg (extendChord (evaluateChord f)))) (delta (potential f))
    (\induction (e: Edge) \return Group.difference (f e) (extendChord (evaluateChord f) e) = delta (potential f) e \with {
      | inl: \fun (e: ForestEdge) => trans!{A.Carrier} _ _ _
          (trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (Group.add (f (Sums.Sum[ForestEdge, Fin.Fin chords]::inl e))) _ _ Group.negZero)
            (Group.zeroRight (f (Sums.Sum[ForestEdge, Fin.Fin chords]::inl e))))
          (sym!{A.Carrier} _ _ (primitiveForest f e))
      | inr: \fun (j: Fin.Fin chords) => Group.subtractDifference (f (chord j)) (delta (potential f) (chord j))
    });
\import \root.Truncated[].Over[zeroth := zeroth, first := first, second := zero] \as Truncated;
\definition upperDifferential: Modules.Hom[V := Edges.Carrier, W := Zero.Carrier, source := Edges.space, target := Zero.moduleSpace].Map :=
  Modules.Hom[V := Edges.Carrier, W := Zero.Carrier, source := Edges.space, target := Zero.moduleSpace].zeroMap;
\definition squareZero(f: Vertices.Carrier): #apply{upperDifferential} (#apply{differential} f) = Zero.Carrier::zero := \refl(Zero.Carrier::zero);
\import Truncated.On[deltaZero := differential, deltaOne := upperDifferential, square := squareZero] \as Complex;

\definition constantClosed(f: Components.Carrier): delta (constant f) = Edges.zero :=
  Edges.ext (delta (constant f)) Edges.zero
    (\induction (e: Edge) \return delta (constant f) e = Group.zero \with {
      | inl: \fun (e: ForestEdge) => trans!{A.Carrier} _ _ _
          (congr!{Walk A.Carrier} (\fun (w: Walk) => Group.difference (f (start w)) (f (component (graph.parent e)))) _ _ (#tree{(\bysub(Data, Object, graph))} e))
          (Group.inverseRight (f (component (graph.parent e))))
      | inr: \fun (j: Fin.Fin chords) => trans!{A.Carrier} _ _ _
          (congr!{{Fin.Fin components} A.Carrier} (\fun (i: Fin.Fin components) => Group.difference (f (component (graph.chordTarget j))) (f i)) _ _ (#chord{(\bysub(Data, Object, graph))} j))
          (Group.inverseRight (f (component (graph.chordTarget j))))
    });
\definition primitiveGradientBoundary(f: Vertices.Carrier): delta (potential (delta f)) = delta f :=
  trans!{Edges.Carrier} _ _ _ (congr!{Vertices.Carrier Edges.Carrier} delta _ _ (primitiveGradient f))
    (trans!{Edges.Carrier} _ _ _ (Differentials.differencePreserved differential f (constant (evaluateRoot f)))
      (trans!{Edges.Carrier} _ _ _
        (congr!{Edges.Carrier Edges.Carrier} (\fun (x: Edges.Carrier) => Edges.add (delta f) (Edges.neg x)) _ _ (constantClosed (evaluateRoot f)))
        (Edges.ext _ _ (\fun (e: Edge) => trans!{A.Carrier} _ _ _
          (congr!{A.Carrier A.Carrier} (Group.add (delta f e)) _ _ Group.negZero) (Group.zeroRight (delta f e))))));
\definition evaluateChordBoundary(f: Vertices.Carrier): evaluateChord (delta f) = Chords.zero :=
  Chords.ext (evaluateChord (delta f)) Chords.zero (\fun (j: Fin.Fin chords) =>
    trans!{A.Carrier} _ _ _
      (congr!{Edges.Carrier A.Carrier} (\fun (x: Edges.Carrier) => Group.difference (delta f (chord j)) (x (chord j))) _ _ (primitiveGradientBoundary f))
      (Group.inverseRight (delta f (chord j))));
\definition evaluateChordAdd(f, g: Edges.Carrier): evaluateChord (Edges.add f g) = Chords.add (evaluateChord f) (evaluateChord g) :=
  Chords.ext (evaluateChord (Edges.add f g)) (Chords.add (evaluateChord f) (evaluateChord g)) (\fun (j: Fin.Fin chords) =>
    trans!{A.Carrier} _ _ _
      (congr!{Edges.Carrier A.Carrier} (\fun (x: Edges.Carrier) => Group.difference (Group.add (f (chord j)) (g (chord j))) (x (chord j))) _ _
        (trans!{Edges.Carrier} _ _ _ (congr!{Vertices.Carrier Edges.Carrier} delta _ _ (potentialAdd f g)) (#addition{differential} (potential f) (potential g))))
      (Group.differenceAdd (f (chord j)) (g (chord j)) (delta (potential f) (chord j)) (delta (potential g) (chord j))));
\import \root.Integral[].Maps[A := first, B := chordValues] \as ChordReduction;
\definition chordProjection: Modules.Hom[V := Edges.Carrier, W := Chords.Carrier, source := Edges.space, target := Chords.space].Map :=
  ChordReduction.fromAdditive evaluateChord evaluateChordAdd;
\definition primitiveChord(f: Chords.Carrier): potential (extendChord f) = Vertices.zero :=
  Modules.Hom[V := Edges.Carrier, W := Vertices.Carrier, source := Edges.space, target := Vertices.space].zeroPreserved primitive;
\definition chordRoundtrip(f: Chords.Carrier): evaluateChord (extendChord f) = f :=
  Chords.ext (evaluateChord (extendChord f)) f (\fun (j: Fin.Fin chords) =>
    trans!{A.Carrier} _ _ _
      (congr!{Vertices.Carrier A.Carrier} (\fun (x: Vertices.Carrier) => Group.difference (f j) (delta x (chord j))) _ _ (primitiveChord f))
      (trans!{A.Carrier} _ _ _
        (congr!{A.Carrier A.Carrier} (\fun (x: A.Carrier) => Group.difference (f j) x) _ _ (Group.inverseRight Group.zero))
        (trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (Group.add (f j)) _ _ Group.negZero) (Group.zeroRight (f j)))));
\module Cohomology;
