\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\definition differenceZero(a: A.Carrier): Group.difference a Values.zero = a :=
  trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (Values.add a) _ _ Group.negZero) (Group.zeroRight a);
\definition negativeDifference(a, b: A.Carrier): Values.neg (Group.difference a b) = Group.difference b a :=
  trans!{A.Carrier} _ _ _ (Group.negAdd a (Values.neg b))
    (trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (Values.add (Values.neg a)) _ _ (Group.negNeg b)) (Group.comm (Values.neg a) b));
\definition sumSubtractFirst(a, b: A.Carrier): Group.difference (Values.add a b) a = b :=
  trans!{A.Carrier} _ _ _ (Group.swapLast a b (Values.neg a))
    (trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (\fun (x: A.Carrier) => Values.add x b) _ _ (Group.inverseRight a)) (Group.zeroLeft b));
\definition terminalCancellation(a, b, c: A.Carrier): Group.difference c (Values.neg (Group.difference (Values.add a b) c)) = Values.add a b :=
  trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (Values.add c) _ _ (Group.negNeg (Group.difference (Values.add a b) c)))
    (trans!{A.Carrier} _ _ _ (Group.comm c (Group.difference (Values.add a b) c)) (Group.addDifference (Values.add a b) c));
\definition liftRestrictVertex(f: Original.zeroth.Carrier): restrictVertex (liftVertex f) = f :=
  \axiom:funext(restrictVertex (liftVertex f), f, \fun (v: Vertex) => \refl(f v));
\definition liftRestrictEdge(f: Original.first.Carrier): restrictEdge (liftEdge f) = f :=
  \axiom:funext(restrictEdge (liftEdge f), f, \fun (e: Edge) => trans!{A.Carrier} _ _ _
    (congr!{A.Carrier A.Carrier} (\fun (x: A.Carrier) => Group.difference x (Values.neg (f e))) _ _ (Group.zeroLeft Values.zero))
    (trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (Values.add Values.zero) _ _ (Group.negNeg (f e))) (Group.zeroLeft (f e))));
\definition restrictGradient(f: VertexFunctions.Carrier): restrictEdge (delta f) = Original.delta (restrictVertex f) :=
  \axiom:funext(restrictEdge (delta f), Original.delta (restrictVertex f), \fun (e: Edge) => trans!{A.Carrier} _ _ _
    (congr!{A.Carrier A.Carrier} (\fun (x: A.Carrier) => Group.difference x (Group.difference (f (Index.secondVertex e)) (f (Index.vertex (target e))))) _ _
      (trans!{A.Carrier} _ _ _
        (Group.comm (Group.difference (f (Index.firstVertex e)) (f (Index.vertex (source e)))) (Group.difference (f (Index.secondVertex e)) (f (Index.firstVertex e))))
        (Group.composeDifferences (f (Index.secondVertex e)) (f (Index.firstVertex e)) (f (Index.vertex (source e))))))
    (Group.differenceCommonLeft (f (Index.secondVertex e)) (f (Index.vertex (target e))) (f (Index.vertex (source e)))));
\definition liftGradient(f: Original.zeroth.Carrier): delta (liftVertex f) = liftEdge (Original.delta f) :=
  EdgeFunctions.ext _ _ (\induction (e: Index.Edges) \return delta (liftVertex f) e = liftEdge (Original.delta f) e \with {
    | inl: \fun (x: Edge) => Group.inverseRight (f (source x))
    | inr: \induction (e: Sums.Sum[Edge, Edge]) \return delta (liftVertex f) (Sums.Sum[Edge, Sums.Sum[Edge, Edge]]::inr e) = liftEdge (Original.delta f) (Sums.Sum[Edge, Sums.Sum[Edge, Edge]]::inr e) \with {
        | inl: \fun (x: Edge) => Group.inverseRight (f (source x))
        | inr: \fun (x: Edge) => sym!{A.Carrier} _ _ (negativeDifference (f (target x)) (f (source x)))
      }
  });
\definition vertexHomotopy(f: VertexFunctions.Carrier): primitive (delta f) = VertexFunctions.add f (VertexFunctions.neg (liftVertex (restrictVertex f))) :=
  VertexFunctions.ext _ _ (\induction (v: Index.Vertices) \return primitive (delta f) v = Group.difference (f v) (liftVertex (restrictVertex f) v) \with {
    | inl: \fun (x: Vertex) => sym!{A.Carrier} _ _ (Group.inverseRight (f (Index.vertex x)))
    | inr: \induction (v: Sums.Sum[Edge, Edge]) \return primitive (delta f) (Sums.Sum[Vertex, Sums.Sum[Edge, Edge]]::inr v) = Group.difference (f (Sums.Sum[Vertex, Sums.Sum[Edge, Edge]]::inr v)) (liftVertex (restrictVertex f) (Sums.Sum[Vertex, Sums.Sum[Edge, Edge]]::inr v)) \with {
        | inl: \fun (x: Edge) => \refl(Group.difference (f (Index.firstVertex x)) (f (Index.vertex (source x))))
        | inr: \fun (x: Edge) => trans!{A.Carrier} _ _ _
          (Group.comm (Group.difference (f (Index.firstVertex x)) (f (Index.vertex (source x)))) (Group.difference (f (Index.secondVertex x)) (f (Index.firstVertex x))))
          (Group.composeDifferences (f (Index.secondVertex x)) (f (Index.firstVertex x)) (f (Index.vertex (source x))))
      }
  });
\definition edgeHomotopy(f: EdgeFunctions.Carrier): delta (primitive f) = EdgeFunctions.add f (EdgeFunctions.neg (liftEdge (restrictEdge f))) :=
  EdgeFunctions.ext _ _ (\induction (e: Index.Edges) \return delta (primitive f) e = Group.difference (f e) (liftEdge (restrictEdge f) e) \with {
    | inl: \fun (x: Edge) => \refl(Group.difference (f (Index.initialEdge x)) Values.zero)
    | inr: \induction (e: Sums.Sum[Edge, Edge]) \return delta (primitive f) (Sums.Sum[Edge, Sums.Sum[Edge, Edge]]::inr e) = Group.difference (f (Sums.Sum[Edge, Sums.Sum[Edge, Edge]]::inr e)) (liftEdge (restrictEdge f) (Sums.Sum[Edge, Sums.Sum[Edge, Edge]]::inr e)) \with {
        | inl: \fun (x: Edge) => trans!{A.Carrier} _ _ _ (sumSubtractFirst (f (Index.initialEdge x)) (f (Index.middleEdge x)))
          (sym!{A.Carrier} _ _ (differenceZero (f (Index.middleEdge x))))
        | inr: \fun (x: Edge) => trans!{A.Carrier} _ _ _ (differenceZero (Values.add (f (Index.initialEdge x)) (f (Index.middleEdge x))))
          (sym!{A.Carrier} _ _ (terminalCancellation (f (Index.initialEdge x)) (f (Index.middleEdge x)) (f (Index.terminalEdge x))))
      }
  });
\definition closedVertex(f: VertexFunctions.Carrier)(closed: delta f = EdgeFunctions.zero): liftVertex (restrictVertex f) = f := \block {
  \let zero: primitive (delta f) = VertexFunctions.zero := trans!{VertexFunctions.Carrier} _ _ _
    (congr!{EdgeFunctions.Carrier VertexFunctions.Carrier} primitive _ _ closed)
    (Modules.Hom[V := EdgeFunctions.Carrier, W := VertexFunctions.Carrier, source := EdgeFunctions.space, target := VertexFunctions.space].zeroPreserved contraction) \then
  \return VertexFunctions.ext _ _ (\fun (v: Index.Vertices) => sym!{A.Carrier} _ _
    (Group.cancelRight (Values.neg (liftVertex (restrictVertex f) v)) (f v) (liftVertex (restrictVertex f) v)
      (trans!{A.Carrier} _ _ _
        (congr!{VertexFunctions.Carrier A.Carrier} (\fun (g: VertexFunctions.Carrier) => g v) _ _
          (trans!{VertexFunctions.Carrier} _ _ _ (sym!{VertexFunctions.Carrier} _ _ (vertexHomotopy f)) zero))
        (sym!{A.Carrier} _ _ (Group.inverseRight (liftVertex (restrictVertex f) v))))))
};
\definition primitiveGradient(f: EdgeFunctions.Carrier): delta (VertexFunctions.add (primitive f) (liftVertex (Original.potential (restrictEdge f)))) =
  EdgeFunctions.add f (EdgeFunctions.neg (liftEdge (Original.extendChord (Original.evaluateChord (restrictEdge f))))) :=
  trans!{EdgeFunctions.Carrier} _ _ _ (#addition{differential} (primitive f) (liftVertex (Original.potential (restrictEdge f))))
    (trans!{EdgeFunctions.Carrier} _ _ _
      (congr2!{EdgeFunctions.Carrier EdgeFunctions.Carrier EdgeFunctions.Carrier} EdgeFunctions.add _ _ _ _
        (edgeHomotopy f)
        (trans!{EdgeFunctions.Carrier} _ _ _ (liftGradient (Original.potential (restrictEdge f)))
          (trans!{EdgeFunctions.Carrier} _ _ _
            (congr!{Original.first.Carrier EdgeFunctions.Carrier} liftEdge _ _ (sym!{Original.first.Carrier} _ _ (Original.reductionEquation (restrictEdge f))))
            (Modules.Hom[V := Original.first.Carrier, W := EdgeFunctions.Carrier, source := Original.first.space, target := EdgeFunctions.space].differencePreserved edgeInclusion (restrictEdge f) (Original.extendChord (Original.evaluateChord (restrictEdge f)))))))
      (EdgeFunctions.ext _ _ (\fun (e: Index.Edges) => Group.composeDifferences (f e) (liftEdge (restrictEdge f) e) (liftEdge (Original.extendChord (Original.evaluateChord (restrictEdge f))) e))));
