\definition degree: N.Nat^ := N.Nat^::zero;
\import Cochains.At[C := Actual.complex, k := degree] \as Source;
\import Cochains.At[C := Finite.complex, k := degree] \as Middle;
\import Model.DegreeZero[] \as Local;
\import \root.Graph[components := components, forestEdges := forestEdges, chords := chords].On[graph := graph].Geometry[].Coefficients[A := A].Cohomology[].DegreeZero[] \as Computed;
\import Modules.Functions[X := Fin.Fin components, V := A.Carrier, target := A.space] \as Values;
\import Modules.Isomorphism[V := Middle.Cohomology, W := Local.Cohomology, source := Middle.cohomologySpace, target := Local.cohomologySpace].Composition[U := Values.Carrier, final := Values.space] \as FiniteComposition;
\definition finiteIsomorphism: Modules.Isomorphism[V := Middle.Cohomology, W := Values.Carrier, source := Middle.cohomologySpace, target := Values.space].Isomorphism :=
  FiniteComposition.compose Computed.isomorphism NativeComparison.DegreeZero[].isomorphism;
\import Modules.Isomorphism[V := Source.Cohomology, W := Middle.Cohomology, source := Source.cohomologySpace, target := Middle.cohomologySpace].Composition[U := Values.Carrier, final := Values.space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Source.Cohomology, W := Values.Carrier, source := Source.cohomologySpace, target := Values.space].Isomorphism :=
  Composition.compose finiteIsomorphism Restriction.Comparison[].At[n := degree].isomorphism;
