\import Original.Cohomology[].DegreeZero[] \as OriginalZero;
\definition evaluate(f: VertexFunctions.Carrier): Components.Carrier := Original.evaluateRoot (restrictVertex f);
\import Modules.Hom[V := H0.CycleCarrier, W := Components.Carrier, source := H0.cycleSpace, target := Components.space] \as Cycles;
\definition evaluation: Cycles.Map := Cycles.Map {
  apply := \fun (f: H0.CycleCarrier) => evaluate f,
  addition := \fun (f, g: H0.CycleCarrier) => \refl(Components.add (evaluate f) (evaluate g)),
  scalar := \fun (a: I.Int^)(f: H0.CycleCarrier) => \refl(Components.scale a (evaluate f)),
};
\import Modules.Of[V := H0.CycleCarrier, space := H0.cycleSpace].Submodule[].Quotient[S := H0.boundariesInside] \as Quotient;
\import Quotient.To[W := Components.Carrier, target := Components.space] \as Descent;
\definition kills: Descent.Vanishes evaluation := \fun (f: H0.CycleCarrier)(boundary: _) => Components.ext _ _
  (\fun (i: Fin.Fin components) => congr!{VertexFunctions.Carrier A.Carrier} (\fun (g: VertexFunctions.Carrier) => g (Index.vertex (root i))) _ _ boundary);
\definition forward: Modules.Hom[V := H0.Cohomology, W := Components.Carrier, source := H0.cohomologySpace, target := Components.space].Map := Descent.descend evaluation kills;
\definition constant(f: Components.Carrier): VertexFunctions.Carrier := liftVertex (Original.constant f);
\definition closed(f: Components.Carrier): delta (constant f) = EdgeFunctions.zero :=
  trans!{EdgeFunctions.Carrier} _ _ _ (Equations[].liftGradient (Original.constant f))
    (trans!{EdgeFunctions.Carrier} _ _ _
      (congr!{Original.first.Carrier EdgeFunctions.Carrier} liftEdge _ _ (Original.constantClosed f))
      (Modules.Hom[V := Original.first.Carrier, W := EdgeFunctions.Carrier, source := Original.first.space, target := EdgeFunctions.space].zeroPreserved edgeInclusion));
\import Modules.Hom[V := Components.Carrier, W := H0.CycleCarrier, source := Components.space, target := H0.cycleSpace] \as Inclusion;
\definition include: Inclusion.Map := Inclusion.Map {
  apply := \fun (f: Components.Carrier) => H0.cycle (constant f) (closed f),
  addition := \fun (f, g: Components.Carrier) => trans!{VertexFunctions.Carrier} _ _ _
    (congr!{Original.zeroth.Carrier VertexFunctions.Carrier} liftVertex _ _ (\refl(#add{Original.zeroth.space} (Original.constant f) (Original.constant g))))
    (#addition{vertexInclusion} (Original.constant f) (Original.constant g)),
  scalar := \fun (a: I.Int^)(f: Components.Carrier) => trans!{VertexFunctions.Carrier} _ _ _
    (congr!{Original.zeroth.Carrier VertexFunctions.Carrier} liftVertex _ _ (\refl(#scale{Original.zeroth.space} a (Original.constant f))))
    (#scalar{vertexInclusion} a (Original.constant f)),
};
\import Modules.Hom[V := H0.CycleCarrier, W := H0.Cohomology, source := H0.cycleSpace, target := H0.cohomologySpace].Composition[U := Components.Carrier, domain := Components.space] \as Composition;
\definition backward: Modules.Hom[V := Components.Carrier, W := H0.Cohomology, source := Components.space, target := H0.cohomologySpace].Map := Composition.compose H0.classLinear include;
\definition leftInverse(f: Components.Carrier): #apply{forward} (#apply{backward} f) = f :=
  trans!{Components.Carrier} _ _ _ (Descent.onClass evaluation kills (#apply{include} f))
    (Components.ext _ _ (\fun (i: Fin.Fin components) => congr!{Walk A.Carrier} (\fun (w: Walk) => f (start w)) _ _ (#root{(\bysub(Data, Object, graph))} i)));
\definition oldClosed(f: H0.CycleCarrier): Original.delta (restrictVertex f) = #zero{Original.first.space} :=
  trans!{Original.first.Carrier} _ _ _ (sym!{Original.first.Carrier} _ _ (Equations[].restrictGradient f))
    (trans!{Original.first.Carrier} _ _ _
      (congr!{EdgeFunctions.Carrier Original.first.Carrier} restrictEdge _ _ (\bysub(VertexFunctions.Carrier, #carrier{H0.cycles}, f)))
      (Modules.Hom[V := EdgeFunctions.Carrier, W := Original.first.Carrier, source := EdgeFunctions.space, target := Original.first.space].zeroPreserved edgeProjection));
\definition closedConstant(f: H0.CycleCarrier): constant (evaluate f) = f :=
  trans!{VertexFunctions.Carrier} _ _ _
    (congr!{Original.zeroth.Carrier VertexFunctions.Carrier} liftVertex _ _ (OriginalZero.closedConstant (OldH0.cycle (restrictVertex f) (oldClosed f))))
    (Equations[].closedVertex f (\bysub(VertexFunctions.Carrier, #carrier{H0.cycles}, f)));
\definition rightInverse: \forall (h: H0.Cohomology) -> #apply{backward} (#apply{forward} h) = h :=
  H0.classInduction (\fun (h: H0.Cohomology) => #apply{backward} (#apply{forward} h) = h)
    (\fun (f: H0.CycleCarrier) => trans!{H0.Cohomology} _ _ _
      (congr!{Components.Carrier H0.Cohomology} (#apply{backward}) _ _ (Descent.onClass evaluation kills f))
      (H0.equalClass (#apply{include} (evaluate f)) f (closedConstant f)));
\definition isomorphism: Modules.Isomorphism[V := H0.Cohomology, W := Components.Carrier, source := H0.cohomologySpace, target := Components.space].Isomorphism :=
  Modules.Isomorphism[V := H0.Cohomology, W := Components.Carrier, source := H0.cohomologySpace, target := Components.space].Isomorphism {
    forward := forward, backward := backward, leftInverse := rightInverse, rightInverse := leftInverse,
  };
