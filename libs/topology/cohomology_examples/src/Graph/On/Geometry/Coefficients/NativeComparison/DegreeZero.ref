\import Model.DegreeZero[] \as Target;
\import Cochains.At[C := Native.complex, k := degreeZero] \as Source;
\definition forwardClosed(phi: Source.CycleCarrier): delta (evaluateZero phi) = #zero{EdgeFunctions.space} :=
  trans!{EdgeFunctions.Carrier} _ _ _ (sym!{EdgeFunctions.Carrier} _ _ (zeroth phi))
    (trans!{EdgeFunctions.Carrier} _ _ _
      (congr!{{Native.Carrier degreeOne} EdgeFunctions.Carrier} evaluateOne _ _ (\bysub(Native.Carrier degreeZero, #carrier{Source.cycles}, phi)))
      (Modules.Hom[V := Native.Carrier degreeOne, W := EdgeFunctions.Carrier, source := Native.space degreeOne, target := EdgeFunctions.space].zeroPreserved One.forward));
\definition backwardClosed(f: Target.CycleCarrier): Native.differential degreeZero (extendZero f) = #zero{(Native.space degreeOne)} :=
  trans!{{Native.Carrier degreeOne}} _ _ _ (inverseZeroth f)
    (trans!{{Native.Carrier degreeOne}} _ _ _
      (congr!{EdgeFunctions.Carrier {Native.Carrier degreeOne}} extendOne _ _ (\bysub(VertexFunctions.Carrier, #carrier{Target.cycles}, f)))
      (Modules.Hom[V := EdgeFunctions.Carrier, W := Native.Carrier degreeOne, source := EdgeFunctions.space, target := Native.space degreeOne].zeroPreserved One.backward));
\definition forwardValue(phi: Source.CycleCarrier): Target.CycleCarrier := Target.cycle (evaluateZero phi) (forwardClosed phi);
\definition backwardValue(f: Target.CycleCarrier): Source.CycleCarrier := Source.cycle (extendZero f) (backwardClosed f);
\definition sourceCycles: Modules.Bundle := Modules.Bundle { Carrier := Source.CycleCarrier, space := Source.cycleSpace };
\definition targetCycles: Modules.Bundle := Modules.Bundle { Carrier := Target.CycleCarrier, space := Target.cycleSpace };
\import Modules.Hom[V := Source.CycleCarrier, W := Target.CycleCarrier, source := Source.cycleSpace, target := Target.cycleSpace] \as Forward;
\import Modules.Hom[V := Target.CycleCarrier, W := Source.CycleCarrier, source := Target.cycleSpace, target := Source.cycleSpace] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := forwardValue,
  addition := \fun (phi, psi: Source.CycleCarrier) => #addition{Zero.forward} phi psi,
  scalar := \fun (a: I.Int^)(phi: Source.CycleCarrier) => #scalar{Zero.forward} a phi,
};
\definition backward: Backward.Map := Backward.Map {
  apply := backwardValue,
  addition := \fun (f, g: Target.CycleCarrier) => #addition{Zero.backward} f g,
  scalar := \fun (a: I.Int^)(f: Target.CycleCarrier) => #scalar{Zero.backward} a f,
};
\import Modules.QuotientMapping[A := sourceCycles, B := targetCycles].On[S := Source.boundariesInside, T := Target.boundariesInside, f := forward] \as Quotient;
\definition compatible: Quotient.Compatible := \fun (phi: Source.CycleCarrier)(boundary: _) =>
  trans!{VertexFunctions.Carrier} _ _ _
    (congr!{{Native.Carrier degreeZero} VertexFunctions.Carrier} evaluateZero _ _ boundary)
    (Modules.Hom[V := Native.Carrier degreeZero, W := VertexFunctions.Carrier, source := Native.space degreeZero, target := VertexFunctions.space].zeroPreserved Zero.forward);
\import Quotient.Inverse[g := backward] \as Inverse;
\definition compatibleBack: Inverse.CompatibleBack := \fun (phi: Target.CycleCarrier)(boundary: _) =>
  trans!{{Native.Carrier degreeZero}} _ _ _
    (congr!{VertexFunctions.Carrier {Native.Carrier degreeZero}} extendZero _ _ boundary)
    (Modules.Hom[V := VertexFunctions.Carrier, W := Native.Carrier degreeZero, source := VertexFunctions.space, target := Native.space degreeZero].zeroPreserved Zero.backward);
\definition isomorphism: Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Isomorphism :=
  Inverse.isomorphism compatible compatibleBack (\fun (phi: Source.CycleCarrier) => #leftInverse{Zero.isomorphism} phi) (\fun (f: Target.CycleCarrier) => #rightInverse{Zero.isomorphism} f);
\definition onClass(phi: Source.CycleCarrier): #apply{#forward{isomorphism}} (Source.classOf phi) = Target.classOf (forwardValue phi) := Quotient.onClass compatible phi;
