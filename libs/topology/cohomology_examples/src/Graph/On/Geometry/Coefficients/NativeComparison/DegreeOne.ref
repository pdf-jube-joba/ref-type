\import Model.DegreeOne[] \as Target;
\import Cochains.At[C := Native.complex, k := degreeOne] \as Source;
\import Modules.Of[V := EdgeFunctions.Carrier, space := EdgeFunctions.space].Submodule[].Image[U := VertexFunctions.Carrier, source := VertexFunctions.space] \as BoundaryImages;
\definition forwardClosed[phi: Source.CycleCarrier]: (upper).apply (evaluateOne phi) = ZeroModule.Carrier::zero := \refl(ZeroModule.Carrier::zero);
\definition backwardClosed[f: Target.CycleCarrier]: Native.differential degreeOne (extendOne f) = (Native.space (N.Nat^::succ degreeOne)).zero :=
  Native.Higher[n := degreeZero].vanishes (Native.differential degreeOne (extendOne f));
\definition forwardValue[phi: Source.CycleCarrier]: Target.CycleCarrier := Target.cycle (evaluateOne phi) (forwardClosed phi);
\definition backwardValue[f: Target.CycleCarrier]: Source.CycleCarrier := Source.cycle (extendOne f) (backwardClosed f);
\definition sourceCycles: Modules.Bundle := Modules.Bundle { Carrier := Source.CycleCarrier, space := Source.cycleSpace };
\definition targetCycles: Modules.Bundle := Modules.Bundle { Carrier := Target.CycleCarrier, space := Target.cycleSpace };
\import Modules.Hom[V := Source.CycleCarrier, W := Target.CycleCarrier, source := Source.cycleSpace, target := Target.cycleSpace] \as Forward;
\import Modules.Hom[V := Target.CycleCarrier, W := Source.CycleCarrier, source := Target.cycleSpace, target := Source.cycleSpace] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := forwardValue,
  addition := \fun (phi, psi: Source.CycleCarrier) => (One.forward).addition phi psi,
  scalar := \fun (a: I.Int^)(phi: Source.CycleCarrier) => (One.forward).scalar a phi,
};
\definition backward: Backward.Map := Backward.Map {
  apply := backwardValue,
  addition := \fun (f, g: Target.CycleCarrier) => (One.backward).addition f g,
  scalar := \fun (a: I.Int^)(f: Target.CycleCarrier) => (One.backward).scalar a f,
};
\import Modules.QuotientMapping[A := sourceCycles, B := targetCycles].On[S := Source.boundariesInside, T := Target.boundariesInside, f := forward] \as Quotient;
\definition compatible: Quotient.Compatible := \block {
  \fun (phi: Source.CycleCarrier)(boundary: _) \then
  \takefrom f: \Cast[Native.Carrier degreeZero] ({ f: Native.Carrier degreeZero \where Native.differential degreeZero f = phi }) \by boundary \then
  \return \idelim delta (evaluateZero f) = evaluateOne phi
    \with y: EdgeFunctions.Carrier => \In[EdgeFunctions.Carrier] ((Target.boundaries).carrier) y \by {
      base: BoundaryImages.member differential (evaluateZero f),
      equality: trans!{EdgeFunctions.Carrier} _ _ _ (sym!{EdgeFunctions.Carrier} _ _ (zeroth f))
        (congr!{{Native.Carrier degreeOne} EdgeFunctions.Carrier} evaluateOne _ _ (\bysub(Native.Carrier degreeZero, { f: Native.Carrier degreeZero \where Native.differential degreeZero f = phi }, f)))
    }
};
\import Quotient.Inverse[g := backward] \as Inverse;
\definition compatibleBack: Inverse.CompatibleBack := \fun (phi: Target.CycleCarrier)(boundary: _) =>
  BoundaryImages.eliminate differential phi (\In[Native.Carrier degreeOne] (Source.Boundaries degreeOne) (extendOne phi))
    (\fun (f: VertexFunctions.Carrier)(represented: delta f = phi) =>
      Logic.existsIntro[Native.Carrier degreeZero, { g: Native.Carrier degreeZero \where Native.differential degreeZero g = extendOne phi }] (extendZero f)
        (trans!{{Native.Carrier degreeOne}} _ _ _ (inverseZeroth f) (congr!{EdgeFunctions.Carrier {Native.Carrier degreeOne}} extendOne _ _ represented))) boundary;
\definition isomorphism: Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Isomorphism :=
  Inverse.isomorphism compatible compatibleBack (\fun (phi: Source.CycleCarrier) => (One.isomorphism).leftInverse phi) (\fun (f: Target.CycleCarrier) => (One.isomorphism).rightInverse f);
\definition onClass[phi: Source.CycleCarrier]: ((isomorphism).forward).apply (Source.classOf phi) = Target.classOf (forwardValue phi) := Quotient.onClass compatible phi;
