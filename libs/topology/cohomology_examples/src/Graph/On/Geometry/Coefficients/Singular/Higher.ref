\definition degree: N.Nat^ := N.Nat^::succ (N.Nat^::succ n);
\import Cochains.At[C := Actual.complex, k := degree] \as Source;
\import Cochains.At[C := Finite.complex, k := degree] \as Target;
\definition isomorphism: Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Isomorphism :=
  Restriction.Comparison[].At[n := degree].isomorphism;
\import Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Vanishing[] \as Vanishing;
\definition law(h: Source.Cohomology): h = Source.zeroClass := Vanishing.sourceZero isomorphism (NativeComparison.Higher[n := n].law) h;
