\inductive Vertex: \Set := | point: Vertex;
\inductive Edge: \Set := | horizontal: Edge | vertical: Edge | diagonal: Edge;
\inductive Triangle: \Set := | first: Triangle | second: Triangle;
\import \root.Surface[V := Vertex, E := Edge, T := Triangle] \as Surface;
\definition endpoint[e: Edge]: Vertex := Vertex::point;
\definition front: Triangle -> Edge := \induction (t: Triangle) \return Edge \with {
  | first: Edge::horizontal | second: Edge::vertical
};
\definition back: Triangle -> Edge := \induction (t: Triangle) \return Edge \with {
  | first: Edge::vertical | second: Edge::horizontal
};
\definition diagonal[t: Triangle]: Edge := Edge::diagonal;
\definition object: Surface.Object := Surface.Object {
  source := endpoint, target := endpoint, front := front, diagonal := diagonal, back := back,
  first := \fun (t: Triangle) => \refl(Vertex::point),
  middle := \fun (t: Triangle) => \refl(Vertex::point),
  last := \fun (t: Triangle) => \refl(Vertex::point),
};
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import module_theory.Module[].Over[R := I.Int^, ring := IntegerRing.ring] \as Modules;
\module With(A: Modules.Bundle);
\module Integral;
\module Geometry;
