\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as NatLaws;
\import std.Arithmetic[].IntAlgebra[].Calculation[] \as Arithmetic;
\import std.Arithmetic[].IntAlgebra[].IntegralDomain[] \as Domain;
\import I.Math[].Specification[].Prop[].Multiplication[] \as Products;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\import Modules.Laws[V := I.Int^, space := Modules.scalarModule] \as Values;
\import algebra.Group[].Of[Carrier := I.Int^, group := Values.additive] \as Group;
\definition coefficients: Modules.Bundle := Modules.Bundle { Carrier := I.Int^, space := Modules.scalarModule };
\import \parent.With[A := coefficients] \as Model;
\import \root.Surface[V := Vertex, E := Edge, T := Triangle].On[surface := object].With[A := coefficients] \as Raw;
\import \root.Truncated[].Over[zeroth := Raw.zeroth, first := Raw.first, second := Raw.second].On[deltaZero := Raw.differentialZero, deltaOne := Raw.differentialOne, square := Raw.squareZero] \as Complex;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := IntegerRing.ring] \as Cochains;
\import Modules.Zero[] \as Zero;
\definition firstDegree: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition secondDegree: N.Nat^ := N.Nat^::succ firstDegree;
\definition two: I.Int^ := I.Int^::ofNat secondDegree;
\import Complex.DegreeOne[] \as H1;
\import Complex.DegreeTwo[] \as H2;
\import finitely_generated_modules.IntegerCyclic[d := two] \as Z2;
\definition twice(x: I.Int^): Arithmetic.mul two x = Model.double x :=
  trans!{I.Int^} _ _ _ (Products.addMul Arithmetic.one Arithmetic.one x)
    (congr2!{I.Int^ I.Int^ I.Int^} Arithmetic.add _ _ _ _ (Products.mulOneLeft x) (Products.mulOneLeft x));
\definition magnitude: I.Int^ -> N.Nat^ := \induction (z: I.Int^) \return N.Nat^ \with {
  | ofNat: \fun (n: N.Nat^) => n
  | negSucc: \fun (n: N.Nat^) => n
};
\definition twoNonzero: two = Arithmetic.zero -> Logic.False := \fun (same: two = Arithmetic.zero) =>
  NatLaws.succNeZero firstDegree (congr!{I.Int^ N.Nat^} magnitude _ _ same);
\definition closedLoop(f: H1.CycleCarrier): f Edge::loop = Arithmetic.zero := Domain.cancellation two (f Edge::loop) Arithmetic.zero twoNonzero
  (trans!{I.Int^} _ _ _ (twice (f Edge::loop))
    (trans!{I.Int^} _ _ _ (Model.closedDouble f (\bysub(Model.Edges, #carrier{H1.cycles}, f)))
      (sym!{I.Int^} _ _ (Products.mulZeroRight two))));
\definition subtractZero(x: I.Int^): Group.difference x Group.zero = x :=
  trans!{I.Int^} _ _ _ (congr!{I.Int^ I.Int^} (Group.add x) _ _ Group.negZero) (Group.zeroRight x);
\definition boundaryPrimitive(f: H1.CycleCarrier): Model.deltaZero (Model.vertex Arithmetic.zero (f Edge::first)) = f :=
  Model.edgesExt _ _
    (trans!{I.Int^} _ _ _ (Group.inverseRight (f Edge::first)) (sym!{I.Int^} _ _ (closedLoop f)))
    (subtractZero (f Edge::first))
    (trans!{I.Int^} _ _ _ (subtractZero (f Edge::first))
      (sym!{I.Int^} _ _ (trans!{I.Int^} _ _ _
        (Model.closedSecond f (\bysub(Model.Edges, #carrier{H1.cycles}, f)))
        (trans!{I.Int^} _ _ _ (congr!{I.Int^ I.Int^} (\fun (x: I.Int^) => Arithmetic.add x (f Edge::first)) _ _ (closedLoop f))
          (Group.zeroLeft (f Edge::first))))));
\definition firstVanishes: \forall (h: H1.Cohomology) -> h = H1.zeroClass :=
  H1.classInduction (\fun (h: H1.Cohomology) => h = H1.zeroClass)
    (\fun (f: H1.CycleCarrier) => H1.boundaryClassZero f
      (Logic.existsIntro[Model.Vertices, { g: Model.Vertices \where Model.deltaZero g = f }]
        (Model.vertex Arithmetic.zero (f Edge::first)) (boundaryPrimitive f)));
\definition orientation: Model.Triangles := Model.triangle Arithmetic.zero Arithmetic.one;
\definition orientationCycle: H2.CycleCarrier := H2.cycle orientation (\refl(Zero.Carrier::zero));
\definition generator: H2.Cohomology := H2.classOf orientationCycle;
\module Top;
