\import Modules.Laws[V := F.Carrier, space := F.integerSpace] \as Values;
\import algebra.Group[].Of[Carrier := F.Carrier, group := Values.additive] \as Group;
\definition cycles: Modules.Bundle := Modules.Bundle { Carrier := H2.CycleCarrier, space := H2.cycleSpace };
\import \root.Integral[].Maps[A := cycles, B := coefficients] \as TotalLinear;
\definition totalAdd(f, g: H2.CycleCarrier): Model.total (#add{H2.cycleSpace} f g) = F.add (Model.total f) (Model.total g) :=
  Group.four (f Triangle::upper) (g Triangle::upper) (f Triangle::lower) (g Triangle::lower);
\definition evaluate: Modules.Hom[V := H2.CycleCarrier, W := F.Carrier, source := H2.cycleSpace, target := F.integerSpace].Map :=
  TotalLinear.fromAdditive (\fun (f: H2.CycleCarrier) => Model.total f) totalAdd;
\import Modules.Of[V := H2.CycleCarrier, space := H2.cycleSpace].Submodule[].Quotient[S := H2.boundariesInside] \as Quotient;
\import Quotient.To[W := F.Carrier, target := F.integerSpace] \as Descent;
\definition kills: Descent.Vanishes evaluate := \block {
  \fun (f: H2.CycleCarrier)(boundary: _) \then
  \takefrom g: \Cast[Model.Edges] ({ g: Model.Edges \where Model.deltaOne g = f }) \by boundary \then
  \let equal: Model.deltaOne g = f := \bysub(Model.Edges, { g: Model.Edges \where Model.deltaOne g = f }, g) \then
  \return trans!{F.Carrier} _ _ _ (congr!{Model.Triangles F.Carrier} Model.total _ _ (sym!{Model.Triangles} _ _ equal)) (boundaryTotal g)
};
\definition forward: Modules.Hom[V := H2.Cohomology, W := F.Carrier, source := H2.cohomologySpace, target := F.integerSpace].Map := Descent.descend evaluate kills;
\import Modules.Hom[V := F.Carrier, W := H2.CycleCarrier, source := F.integerSpace, target := H2.cycleSpace] \as Representatives;
\definition representative(x: F.Carrier): Model.Triangles := Model.triangle F.zero x;
\definition represent: Representatives.Map := Representatives.Map {
  apply := \fun (x: F.Carrier) => H2.cycle (representative x) (\refl(Zero.Carrier::zero)),
  addition := \fun (x, y: F.Carrier) => Model.trianglesExt _ _ (sym!{F.Carrier} _ _ (F.addZeroLeft F.zero)) (\refl(F.add x y)),
  scalar := \fun (a: I.Int^)(x: F.Carrier) => Model.trianglesExt _ _ (sym!{F.Carrier} _ _ (Values.scaleZero a)) (\refl(#smul{F.integerSpace} a x)),
};
\import Modules.Hom[V := H2.CycleCarrier, W := H2.Cohomology, source := H2.cycleSpace, target := H2.cohomologySpace].Composition[U := F.Carrier, domain := F.integerSpace] \as Composition;
\definition backward: Modules.Hom[V := F.Carrier, W := H2.Cohomology, source := F.integerSpace, target := H2.cohomologySpace].Map := Composition.compose H2.classLinear represent;
\definition rightInverse(x: F.Carrier): #apply{forward} (#apply{backward} x) = x :=
  trans!{F.Carrier} _ _ _ (Descent.onClass evaluate kills (#apply{represent} x)) (F.addZeroLeft x);
\definition leftInverse: \forall (h: H2.Cohomology) -> #apply{backward} (#apply{forward} h) = h :=
  H2.classInduction (\fun (h: H2.Cohomology) => #apply{backward} (#apply{forward} h) = h)
    (\fun (f: H2.CycleCarrier) => trans!{H2.Cohomology} _ _ _
      (congr!{F.Carrier H2.Cohomology} (#apply{backward}) _ _ (Descent.onClass evaluate kills f))
      (sym!{H2.Cohomology} _ _ (H2.classEqual f (#apply{represent} (Model.total f))
        (Logic.existsIntro[Model.Edges, { g: Model.Edges \where Model.deltaOne g =
          #add{(Raw.second.space)} f (#neg{(Raw.second.space)} (representative (Model.total f))) }]
          (Model.edge F.zero (f Triangle::upper) F.zero) (Model.boundaryDifference f)))));
\definition isomorphism: Modules.Isomorphism[V := H2.Cohomology, W := F.Carrier, source := H2.cohomologySpace, target := F.integerSpace].Isomorphism :=
  Modules.Isomorphism[V := H2.Cohomology, W := F.Carrier, source := H2.cohomologySpace, target := F.integerSpace].Isomorphism {
    forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
  };
\definition generatorCoordinate: #apply{forward} topGenerator = F.one := Descent.onClass evaluate kills vCycle;
