\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := IntegerRing.ring] \as Native;
\import singular_cech.Algebra[R := I.Int^, ring := IntegerRing.ring].Restriction[C := chain] \as Restriction;
\definition native: Native.Complex := Restriction.complex;
\import \root.Surface[V := Vertex, E := Edge, T := Triangle].On[surface := object].Simplicial[] \as Model;
\definition targetComplex: Native.Complex := Model.chainComplex;
\import singular_cohomology.SimplicialChains[].On[X := Model.object] \as Target;
\definition vertex(v: Vertex): Target.Carrier zero := Target.generator zero (Model.vertex v);
\definition edge(e: Edge): Target.Carrier one := Target.generator one (Model.edge e);
\definition triangle(t: Triangle): Target.Carrier two := Target.generator two (Model.triangle t);
\definition sourceBundle(n: N.Nat^): Modules.Bundle := Modules.Bundle { Carrier := native.family.Carrier n, space := native.family.space n };
\definition targetBundle(n: N.Nat^): Modules.Bundle := Modules.Bundle { Carrier := targetComplex.family.Carrier n, space := targetComplex.family.space n };
\definition Forward(n: N.Nat^): \Set := Modules.MapBetween (sourceBundle n) (targetBundle n);
\definition Backward(n: N.Nat^): \Set := Modules.MapBetween (targetBundle n) (sourceBundle n);
\definition Homotopy(n: N.Nat^): \Set := Modules.MapBetween (targetBundle n) (targetBundle (N.Nat^::succ n));
\module Zero;
\module One;
\module Two;
\module Higher(n: N.Nat^);
\definition forwardDegree: \forall (n: N.Nat^) -> Forward n := \induction (n: N.Nat^) \return Forward n \with {
  | zero: Zero[].forward
  | succ: \fun (n: N.Nat^)(unused: _) => (\induction (n: N.Nat^) \return Forward (N.Nat^::succ n) \with {
      | zero: One[].forward
      | succ: \fun (n: N.Nat^)(unused: _) => (\induction (n: N.Nat^) \return Forward (N.Nat^::succ (N.Nat^::succ n)) \with {
          | zero: Two[].forward
          | succ: \fun (n: N.Nat^)(unused: _) => Higher[n := n].forward
        }) n
    }) n
};
\definition backwardDegree: \forall (n: N.Nat^) -> Backward n := \induction (n: N.Nat^) \return Backward n \with {
  | zero: Zero[].backward
  | succ: \fun (n: N.Nat^)(unused: _) => (\induction (n: N.Nat^) \return Backward (N.Nat^::succ n) \with {
      | zero: One[].backward
      | succ: \fun (n: N.Nat^)(unused: _) => (\induction (n: N.Nat^) \return Backward (N.Nat^::succ (N.Nat^::succ n)) \with {
          | zero: Two[].backward
          | succ: \fun (n: N.Nat^)(unused: _) => Higher[n := n].backward
        }) n
    }) n
};
\definition homotopyDegree: \forall (n: N.Nat^) -> Homotopy n := \induction (n: N.Nat^) \return Homotopy n \with {
  | zero: Zero[].homotopy
  | succ: \fun (n: N.Nat^)(unused: _) => (\induction (n: N.Nat^) \return Homotopy (N.Nat^::succ n) \with {
      | zero: One[].homotopy
      | succ: \fun (n: N.Nat^)(unused: _) => Modules.Hom[V := Target.Carrier (N.Nat^::succ (N.Nat^::succ n)), W := Target.Carrier (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))), source := Target.space (N.Nat^::succ (N.Nat^::succ n)), target := Target.space (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))].zeroMap
    }) n
};
