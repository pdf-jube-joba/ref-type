\import \parent.Degree[n := two] \as Degree;
\import \parent.Line[W := native.family.Carrier two, target := native.family.space two] \as Line;
\import Modules.Laws[V := native.family.Carrier two, space := native.family.space two] \as Values;
\definition leftUnit: #apply{Degree.left} Line.unit = Line.unit :=
  trans!{{native.family.Carrier two}} _ _ _
    (congr!{{Target.Carrier two} {native.family.Carrier two}} (#apply{(backwardDegree two)}) _ _ (\parent.Two[].forwardUnit))
    (trans!{{native.family.Carrier two}} _ _ _ (#addition{(backwardDegree two)} (triangle Triangle::upper) (triangle Triangle::lower))
      (trans!{{native.family.Carrier two}} _ _ _
        (congr2!{{native.family.Carrier two} {native.family.Carrier two} {native.family.Carrier two}} Values.add _ _ _ _
          (\parent.Two[].backwardOnGenerator Triangle::upper) (\parent.Two[].backwardOnGenerator Triangle::lower))
        (Values.zeroLeft Line.unit)));
\definition leftEquation: Degree.left = Modules.End[V := native.family.Carrier two, space := native.family.space two].identity := Line.ext _ _ leftUnit;
