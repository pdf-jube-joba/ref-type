\import Modules.FiniteCoordinates[n := one] \as Coordinates;
\import Modules.Hom[V := Coordinates.Carrier, W := W, source := Coordinates.space, target := target] \as Maps;
\definition unit: Coordinates.Carrier := \fun (i: Fin.Fin one) => I.One.specification;
\definition reconstruction(x: Coordinates.Carrier): #smul{Coordinates.space} (x (Fin.zero zero)) unit = x :=
  \axiom:funext(#smul{Coordinates.space} (x (Fin.zero zero)) unit, x, \fun (i: Fin.Fin one) => trans!{I.Int^} _ _ _
    (#rightIdentity{(#multiplicative{(#semiring{IntegerRing.ring})})} (x (Fin.zero zero)))
    (congr!{{Fin.Fin one} I.Int^} x _ _ (sym!{{Fin.Fin one}} _ _ (Fin.singletonValue i))));
\definition ext(f, g: Maps.Map)(same: #apply{f} unit = #apply{g} unit): f = g := Maps.ext f g
  (\fun (x: Coordinates.Carrier) => trans!{W} _ _ _
    (congr!{Coordinates.Carrier W} (#apply{f}) _ _ (sym!{Coordinates.Carrier} _ _ (reconstruction x)))
    (trans!{W} _ _ _ (#scalar{f} (x (Fin.zero zero)) unit)
      (trans!{W} _ _ _ (congr!{W W} (#smul{target} (x (Fin.zero zero))) _ _ same)
        (trans!{W} _ _ _ (sym!{W} _ _ (#scalar{g} (x (Fin.zero zero)) unit))
          (congr!{Coordinates.Carrier W} (#apply{g}) _ _ (reconstruction x))))));
