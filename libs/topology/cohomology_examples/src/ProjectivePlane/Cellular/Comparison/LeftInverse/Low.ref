\definition Equation(k: N.Nat^): \Prop := \forall (x: native.family.Carrier k) -> #apply{(backwardDegree k)} (#apply{(forwardDegree k)} x) = x;
\module At(k: N.Nat^) {
  \import Modules.Hom[V := native.family.Carrier k, W := native.family.Carrier k, source := native.family.space k, target := native.family.space k] \as End;
  \definition evaluation(e: \parent.\parent.\parent.Degree[n := k].left = Modules.End[V := native.family.Carrier k, space := native.family.space k].identity): Equation k :=
    \fun (x: native.family.Carrier k) => congr!{End.Map {native.family.Carrier k}} (\fun (f: End.Map) => #apply{f} x) _ _ e;
}
\definition all: \forall (k: N.Nat^) -> Equation k := \induction (k: N.Nat^) \return Equation k \with {
  | zero: At[k := zero].evaluation (\parent.\parent.CheckZero[].leftEquation)
  | succ: \fun (k: N.Nat^)(unused: _) => (\induction (k: N.Nat^) \return Equation (N.Nat^::succ k) \with {
      | zero: At[k := one].evaluation (\parent.\parent.CheckOne[].leftEquation)
      | succ: \fun (k: N.Nat^)(unused: _) => (\induction (k: N.Nat^) \return Equation (N.Nat^::succ (N.Nat^::succ k)) \with {
          | zero: At[k := two].evaluation (\parent.\parent.CheckTwo[].leftEquation)
          | succ: \fun (k: N.Nat^)(unused: _)(x: native.family.Carrier (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ k)))) =>
            sym!{{native.family.Carrier (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ k)))}} _ _ (\parent.\parent.Higher[n := k].sourceZero x)
        }) k
    }) k
};
\definition law: Equation n := all n;
