\definition Equation[n: N.Nat^]: \Prop := \forall (x: native.family.Carrier (N.Nat^::succ n)) -> (targetComplex.differential).apply n ((forwardDegree (N.Nat^::succ n)).apply x) = (forwardDegree n).apply ((native.differential).apply n x);
\definition all: \forall (n: N.Nat^) -> Equation n := \induction (n: N.Nat^) \return Equation n \with {
  | zero: \fun (x: native.family.Carrier one) => congr!{{Modules.Hom[V := native.family.Carrier one, W := Target.Carrier zero, source := native.family.space one, target := Target.space zero].Map} {Target.Carrier zero}} (\fun (f: Modules.Hom[V := native.family.Carrier one, W := Target.Carrier zero, source := native.family.space one, target := Target.space zero].Map) => (f).apply x) _ _ (\parent.\parent.CheckZero[].forwardEquation)
  | succ: \fun (n: N.Nat^)(unused: _) => (\induction (n: N.Nat^) \return Equation (N.Nat^::succ n) \with {
      | zero: \fun (x: native.family.Carrier two) => congr!{{Modules.Hom[V := native.family.Carrier two, W := Target.Carrier one, source := native.family.space two, target := Target.space one].Map} {Target.Carrier one}} (\fun (f: Modules.Hom[V := native.family.Carrier two, W := Target.Carrier one, source := native.family.space two, target := Target.space one].Map) => (f).apply x) _ _ (\parent.\parent.CheckOne[].forwardEquation)
      | succ: \fun (n: N.Nat^)(unused: _) => \parent.\parent.CheckHigher[n := n].forwardEquation
    }) n
};
\definition law: Equation n := all n;
