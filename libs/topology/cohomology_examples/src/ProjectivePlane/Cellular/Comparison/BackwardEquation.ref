\definition law: \forall (y: Target.Carrier (N.Nat^::succ n)) -> (native.differential).apply n ((backwardDegree (N.Nat^::succ n)).apply y) = (backwardDegree n).apply ((targetComplex.differential).apply n y) :=
  \fun (y: Target.Carrier (N.Nat^::succ n)) => trans!{{native.family.Carrier n}} _ _ _
    (sym!{{native.family.Carrier n}} _ _ (leftInverse n ((native.differential).apply n ((backwardDegree (N.Nat^::succ n)).apply y))))
    (trans!{{native.family.Carrier n}} _ _ _
      (congr!{{Target.Carrier n} {native.family.Carrier n}} ((backwardDegree n).apply) _ _
        (trans!{{Target.Carrier n}} _ _ _
          (sym!{{Target.Carrier n}} _ _ ((forward).commutes n ((backwardDegree (N.Nat^::succ n)).apply y)))
          (trans!{{Target.Carrier n}} _ _ _
            (congr!{{Target.Carrier (N.Nat^::succ n)} {Target.Carrier n}} ((targetComplex.differential).apply n) _ _ (projectionEquation (N.Nat^::succ n) y))
            (trans!{{Target.Carrier n}} _ _ _ ((Corrected.map).commutes n y)
              (sym!{{Target.Carrier n}} _ _ (projectionEquation n ((targetComplex.differential).apply n y)))))))
      (leftInverse n ((backwardDegree n).apply ((targetComplex.differential).apply n y))));
