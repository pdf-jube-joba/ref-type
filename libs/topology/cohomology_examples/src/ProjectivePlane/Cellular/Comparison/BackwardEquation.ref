\definition law: \forall (y: Target.Carrier (N.Nat^::succ n)) -> #apply{native.differential} n (#apply{(backwardDegree (N.Nat^::succ n))} y) = #apply{(backwardDegree n)} (#apply{targetComplex.differential} n y) :=
  \fun (y: Target.Carrier (N.Nat^::succ n)) => trans!{{native.family.Carrier n}} _ _ _
    (sym!{{native.family.Carrier n}} _ _ (leftInverse n (#apply{native.differential} n (#apply{(backwardDegree (N.Nat^::succ n))} y))))
    (trans!{{native.family.Carrier n}} _ _ _
      (congr!{{Target.Carrier n} {native.family.Carrier n}} (#apply{(backwardDegree n)}) _ _
        (trans!{{Target.Carrier n}} _ _ _
          (sym!{{Target.Carrier n}} _ _ (#commutes{forward} n (#apply{(backwardDegree (N.Nat^::succ n))} y)))
          (trans!{{Target.Carrier n}} _ _ _
            (congr!{{Target.Carrier (N.Nat^::succ n)} {Target.Carrier n}} (#apply{targetComplex.differential} n) _ _ (projectionEquation (N.Nat^::succ n) y))
            (trans!{{Target.Carrier n}} _ _ _ (#commutes{Corrected.map} n y)
              (sym!{{Target.Carrier n}} _ _ (projectionEquation n (#apply{targetComplex.differential} n y)))))))
      (leftInverse n (#apply{(backwardDegree n)} (#apply{targetComplex.differential} n y))));
