\definition degree: N.Nat^ := N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n));
\definition forward: Forward degree := Modules.Hom[V := native.family.Carrier degree, W := Target.Carrier degree, source := native.family.space degree, target := Target.space degree].zeroMap;
\definition backward: Backward degree := Modules.Hom[V := Target.Carrier degree, W := native.family.Carrier degree, source := Target.space degree, target := native.family.space degree].zeroMap;
\definition sourceZero(x: native.family.Carrier degree): x = #zero{(native.family.space degree)} :=
  \axiom:funext(x, #zero{(native.family.space degree)}, \fun (i: Fin.Fin zero) => Logic.falseElim (x i = I.Zero.specification) (Fin.zeroImpossible i (Fin.bound zero i)));
\import Modules.Free[Generators := Model.Carrier degree].To[W := Target.Carrier degree, target := Target.space degree] \as End;
\import Modules.Hom[V := Target.Carrier degree, W := Target.Carrier degree, source := Target.space degree, target := Target.space degree] \as Endomorphisms;
\definition targetZero: \forall (x: Target.Carrier degree) -> x = #zero{(Target.space degree)} := \block {
  \let equation: Modules.End[V := Target.Carrier degree, space := Target.space degree].identity = Endomorphisms.zeroMap :=
    End.ext _ _ (\fun (sigma: Model.Carrier degree) => Logic.falseElim _
      (Model.higherEmpty n sigma (\bysub(Model.Base, { tau: Model.Base \where Model.degree tau = degree }, sigma)))) \then
  \return \fun (x: Target.Carrier degree) => congr!{Endomorphisms.Map {Target.Carrier degree}} (\fun (f: Endomorphisms.Map) => #apply{f} x) _ _ equation
};
