\definition degree: N.Nat^ := zero;
\definition value: Target.Carrier degree := vertex Vertex::rim;
\import Modules.Hom[V := native.family.Carrier degree, W := Target.Carrier degree, source := native.family.space degree, target := Target.space degree] \as ForwardLinear;
\definition forward: ForwardLinear.Map := ForwardLinear.Map {
  apply := \fun (x: native.family.Carrier degree) => (Target.space degree).smul (x (Fin.zero zero)) value,
  addition := \fun (x, y: native.family.Carrier degree) => (Target.space degree).scalarAdd (x (Fin.zero zero)) (y (Fin.zero zero)) value,
  scalar := \fun (a: I.Int^)(x: native.family.Carrier degree) => (Target.space degree).scalarAssoc a (x (Fin.zero zero)) value,
};
\import Model.Coefficients[A := sourceBundle degree] \as BackwardExtension;
\definition backwardValues: Vertex -> native.family.Carrier degree := \fun (v: Vertex)(i: Fin.Fin one) => I.One.specification;
\definition backward: Modules.MapBetween (targetBundle degree) (sourceBundle degree) := BackwardExtension.DegreeZero[].extend backwardValues;
\definition backwardOnGenerator: \forall (x: Vertex) -> (backward).apply (vertex x) = backwardValues x := BackwardExtension.DegreeZero[].onGenerator backwardValues;
\import Model.Coefficients[A := targetBundle one] \as HomotopyExtension;
\definition homotopyValues: Vertex -> Target.Carrier one := \induction (v: Vertex) \return Target.Carrier one \with {
  | center: (Target.space one).neg (edge Edge::first)
  | rim: (Target.space one).zero
};
\definition homotopy: Modules.MapBetween (targetBundle degree) (targetBundle one) := HomotopyExtension.DegreeZero[].extend homotopyValues;
\definition homotopyOnGenerator: \forall (x: Vertex) -> (homotopy).apply (vertex x) = homotopyValues x := HomotopyExtension.DegreeZero[].onGenerator homotopyValues;

\definition unit: native.family.Carrier degree := \fun (i: Fin.Fin one) => I.One.specification;
\definition forwardUnit: (forward).apply unit = value := (Target.space degree).scalarOne value;
