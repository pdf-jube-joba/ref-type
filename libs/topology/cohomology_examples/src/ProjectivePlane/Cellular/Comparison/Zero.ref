\definition degree: N.Nat^ := zero;
\definition value: Target.Carrier degree := vertex Vertex::rim;
\import Modules.Hom[V := native.family.Carrier degree, W := Target.Carrier degree, source := native.family.space degree, target := Target.space degree] \as Forward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (x: native.family.Carrier degree) => #smul{(Target.space degree)} (x (Fin.zero zero)) value,
  addition := \fun (x, y: native.family.Carrier degree) => #scalarAdd{(Target.space degree)} (x (Fin.zero zero)) (y (Fin.zero zero)) value,
  scalar := \fun (a: I.Int^)(x: native.family.Carrier degree) => #scalarAssoc{(Target.space degree)} a (x (Fin.zero zero)) value,
};
\import Model.Coefficients[A := sourceBundle degree] \as Backward;
\definition backwardValues: Vertex -> native.family.Carrier degree := \fun (v: Vertex)(i: Fin.Fin one) => I.One.specification;
\definition backward: Modules.MapBetween (targetBundle degree) (sourceBundle degree) := Backward.DegreeZero[].extend backwardValues;
\definition backwardOnGenerator: \forall (x: Vertex) -> #apply{backward} (vertex x) = backwardValues x := Backward.DegreeZero[].onGenerator backwardValues;
\import Model.Coefficients[A := targetBundle one] \as Homotopy;
\definition homotopyValues: Vertex -> Target.Carrier one := \induction (v: Vertex) \return Target.Carrier one \with {
  | center: #neg{(Target.space one)} (edge Edge::first)
  | rim: #zero{(Target.space one)}
};
\definition homotopy: Modules.MapBetween (targetBundle degree) (targetBundle one) := Homotopy.DegreeZero[].extend homotopyValues;
\definition homotopyOnGenerator: \forall (x: Vertex) -> #apply{homotopy} (vertex x) = homotopyValues x := Homotopy.DegreeZero[].onGenerator homotopyValues;
