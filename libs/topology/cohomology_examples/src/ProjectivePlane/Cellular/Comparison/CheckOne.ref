\import \parent.Degree[n := one] \as Degree;
\import \parent.Line[W := Target.Carrier one, target := Target.space one] \as Line;
\import \parent.Group[W := Target.Carrier one, target := Target.space one] \as Group;
\import Modules.Laws[V := Target.Carrier one, space := Target.space one] \as Values;
\definition firstUnit: #apply{Degree.first} Line.unit = #smul{(Target.space one)} (I.Int^::ofNat two) (edge Edge::loop) :=
  trans!{{Target.Carrier one}} _ _ _
    (congr!{{Target.Carrier two} {Target.Carrier one}} (#apply{targetComplex.differential} one) _ _ (\parent.Two[].forwardUnit))
    (trans!{{Target.Carrier one}} _ _ _
      (#addition{(\parent.Degree[n := one].differential)} (triangle Triangle::upper) (triangle Triangle::lower))
      (trans!{{Target.Carrier one}} _ _ _
        (congr2!{{Target.Carrier one} {Target.Carrier one} {Target.Carrier one}} Values.add _ _ _ _
          (Model.Boundaries[].triangleBoundary Triangle::upper) (Model.Boundaries[].triangleBoundary Triangle::lower))
        (trans!{{Target.Carrier one}} _ _ _ (Group.paired (edge Edge::loop) (edge Edge::first) (edge Edge::second))
          (sym!{{Target.Carrier one}} _ _ (Group.twice (edge Edge::loop))))));
\definition secondUnit: #apply{Degree.second} Line.unit = #smul{(Target.space one)} (I.Int^::ofNat two) (edge Edge::loop) :=
  congr!{{native.family.Carrier one} {Target.Carrier one}} (#apply{(forwardDegree one)}) _ _ (\parent.Differentials[].doubleUnit);
\definition forwardEquation: Degree.first = Degree.second := Line.ext _ _ (trans!{{Target.Carrier one}} _ _ _ firstUnit (sym!{{Target.Carrier one}} _ _ secondUnit));
\import \parent.Degree[n := one] \as Current;
\import \parent.Line[W := native.family.Carrier one, target := native.family.space one] \as SourceLine;
\definition leftUnit: #apply{Current.left} SourceLine.unit = SourceLine.unit :=
  trans!{{native.family.Carrier one}} _ _ _
    (congr!{{Target.Carrier one} {native.family.Carrier one}} (#apply{(backwardDegree one)}) _ _ (\parent.One[].forwardUnit))
    (\parent.One[].backwardOnGenerator Edge::loop);
\definition leftEquation: Current.left = Modules.End[V := native.family.Carrier one, space := native.family.space one].identity := SourceLine.ext _ _ leftUnit;
