\import \parent.\parent.Zero[] \as Zero;
\import \parent.\parent.One[] \as Maps;
\import \parent.\parent.Degree[n := one] \as Degree;
\import \parent.\parent.Degree[n := zero] \as DegreeZero;
\import \parent.\parent.Group[W := Target.Carrier one, target := Target.space one] \as Algebra;
\import Modules.Laws[V := Target.Carrier one, space := Target.space one] \as Values;
\import algebra.Group[].Of[Carrier := Target.Carrier one, group := Values.additive] \as Group;
\import Modules.Hom[V := Target.Carrier zero, W := Target.Carrier one, source := Target.space zero, target := Target.space one] \as H0;
\import Modules.Hom[V := Target.Carrier two, W := Target.Carrier one, source := Target.space two, target := Target.space one] \as Boundaries;
\definition h0(e: Edge): #apply{Zero.homotopy} (#apply{targetComplex.differential} zero (edge e)) =
  Group.difference (Zero.homotopyValues (target e)) (Zero.homotopyValues (source e)) :=
  trans!{{Target.Carrier one}} _ _ _
    (congr!{{Target.Carrier zero} {Target.Carrier one}} (#apply{Zero.homotopy}) _ _ (Model.Boundaries[].edgeBoundary e))
    (trans!{{Target.Carrier one}} _ _ _ (H0.differencePreserved Zero.homotopy (vertex (target e)) (vertex (source e)))
      (congr2!{{Target.Carrier one} {Target.Carrier one} {Target.Carrier one}} Group.difference _ _ _ _ (Zero.homotopyOnGenerator (target e)) (Zero.homotopyOnGenerator (source e))));
\definition h0Loop: #apply{Zero.homotopy} (#apply{targetComplex.differential} zero (edge Edge::loop)) = Values.zero :=
  trans!{{Target.Carrier one}} _ _ _ (h0 Edge::loop) (Group.inverseRight Values.zero);
\definition h0Arc(e: Edge)(same: source e = Vertex::center): #apply{Zero.homotopy} (#apply{targetComplex.differential} zero (edge e)) = edge Edge::first :=
  trans!{{Target.Carrier one}} _ _ _ (h0 e)
    (trans!{{Target.Carrier one}} _ _ _
      (congr!{Vertex {Target.Carrier one}} (\fun (v: Vertex) => Group.difference Values.zero (Zero.homotopyValues v)) _ _ same)
      (trans!{{Target.Carrier one}} _ _ _ (congr!{{Target.Carrier one} {Target.Carrier one}} (Values.add Values.zero) _ _ (Group.negNeg (edge Edge::first)))
        (Group.zeroLeft (edge Edge::first))));
\definition d0(e: Edge)(zero: Maps.homotopyValues e = #zero{(Target.space two)}):
  #apply{targetComplex.differential} one (#apply{Maps.homotopy} (edge e)) = Values.zero :=
  trans!{{Target.Carrier one}} _ _ _
    (congr!{{Target.Carrier two} {Target.Carrier one}} (#apply{targetComplex.differential} one) _ _ (trans!{{Target.Carrier two}} _ _ _ (Maps.homotopyOnGenerator e) zero))
    (Boundaries.zeroPreserved Degree.differential);
\definition dSecond: #apply{targetComplex.differential} one (#apply{Maps.homotopy} (edge Edge::second)) =
  Values.neg (Values.add (Group.difference (edge Edge::loop) (edge Edge::second)) (edge Edge::first)) :=
  trans!{{Target.Carrier one}} _ _ _
    (congr!{{Target.Carrier two} {Target.Carrier one}} (#apply{targetComplex.differential} one) _ _ (Maps.homotopyOnGenerator Edge::second))
    (trans!{{Target.Carrier one}} _ _ _ (Boundaries.negativePreserved Degree.differential (triangle Triangle::upper))
      (congr!{{Target.Carrier one} {Target.Carrier one}} Values.neg _ _ (Model.Boundaries[].triangleBoundary Triangle::upper)));
\definition defectLoop: #apply{Corrected.boundary} one (edge Edge::loop) = Values.zero :=
  trans!{{Target.Carrier one}} _ _ _
    (congr2!{{Target.Carrier one} {Target.Carrier one} {Target.Carrier one}} Values.add _ _ _ _ (d0 Edge::loop (\refl(#zero{(Target.space two)}))) h0Loop)
    (Group.zeroLeft Values.zero);
\definition defectFirst: #apply{Corrected.boundary} one (edge Edge::first) = edge Edge::first :=
  trans!{{Target.Carrier one}} _ _ _
    (congr2!{{Target.Carrier one} {Target.Carrier one} {Target.Carrier one}} Values.add _ _ _ _ (d0 Edge::first (\refl(#zero{(Target.space two)}))) (h0Arc Edge::first (\refl(Vertex::center))))
    (Group.zeroLeft (edge Edge::first));
\definition defectSecond: #apply{Corrected.boundary} one (edge Edge::second) = Group.difference (edge Edge::second) (edge Edge::loop) :=
  trans!{{Target.Carrier one}} _ _ _
    (congr2!{{Target.Carrier one} {Target.Carrier one} {Target.Carrier one}} Values.add _ _ _ _ dSecond (h0Arc Edge::second (\refl(Vertex::center))))
    (Algebra.removeLast (edge Edge::loop) (edge Edge::first) (edge Edge::second));
\definition corrected(e: Edge): #apply{Corrected.map} one (edge e) = #apply{Maps.forward} (Maps.backwardValues e) :=
  (\induction (e: Edge) \return #apply{Corrected.map} one (edge e) = #apply{Maps.forward} (Maps.backwardValues e) \with {
    | loop: trans!{{Target.Carrier one}} _ _ _ (congr!{{Target.Carrier one} {Target.Carrier one}} (Group.difference (edge Edge::loop)) _ _ defectLoop)
      (trans!{{Target.Carrier one}} _ _ _ (congr!{{Target.Carrier one} {Target.Carrier one}} (Values.add (edge Edge::loop)) _ _ Group.negZero)
        (trans!{{Target.Carrier one}} _ _ _ (Group.zeroRight (edge Edge::loop)) (sym!{{Target.Carrier one}} _ _ Maps.forwardUnit)))
    | first: trans!{{Target.Carrier one}} _ _ _ (congr!{{Target.Carrier one} {Target.Carrier one}} (Group.difference (edge Edge::first)) _ _ defectFirst)
      (trans!{{Target.Carrier one}} _ _ _ (Group.inverseRight (edge Edge::first))
        (sym!{{Target.Carrier one}} _ _ (Modules.Hom[V := native.family.Carrier one, W := Target.Carrier one, source := native.family.space one, target := Target.space one].zeroPreserved Maps.forward)))
    | second: trans!{{Target.Carrier one}} _ _ _ (congr!{{Target.Carrier one} {Target.Carrier one}} (Group.difference (edge Edge::second)) _ _ defectSecond)
      (trans!{{Target.Carrier one}} _ _ _ (Group.subtractDifference (edge Edge::second) (edge Edge::loop)) (sym!{{Target.Carrier one}} _ _ Maps.forwardUnit))
  }) e;
\import Native.Map[C := targetComplex, D := targetComplex].At[n := one] \as CorrectedAt;
\import Model.Coefficients[A := targetBundle one].DegreeOne[] \as Ext;
\definition equation: Degree.right = CorrectedAt.linear Corrected.map := Ext.injective _ _
  (\axiom:funext(_, _, \fun (e: Edge) => trans!{{Target.Carrier one}} _ _ _
    (congr!{{native.family.Carrier one} {Target.Carrier one}} (#apply{Maps.forward}) _ _ (Maps.backwardOnGenerator e)) (sym!{{Target.Carrier one}} _ _ (corrected e))));
\definition law: Equation one := \fun (y: Target.Carrier one) => congr!{{Modules.Hom[V := Target.Carrier one, W := Target.Carrier one, source := Target.space one, target := Target.space one].Map} {Target.Carrier one}}
  (\fun (f: Modules.Hom[V := Target.Carrier one, W := Target.Carrier one, source := Target.space one, target := Target.space one].Map) => #apply{f} y) _ _ equation;
