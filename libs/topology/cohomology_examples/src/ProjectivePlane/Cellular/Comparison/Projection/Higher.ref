\definition degree: N.Nat^ := N.Nat^::succ (N.Nat^::succ (N.Nat^::succ k));
\definition law: Equation degree := \fun (y: Target.Carrier degree) => trans!{{Target.Carrier degree}} _ _ _
  (\parent.\parent.Higher[n := k].targetZero (#apply{(forwardDegree degree)} (#apply{(backwardDegree degree)} y)))
  (sym!{{Target.Carrier degree}} _ _ (\parent.\parent.Higher[n := k].targetZero (#apply{Corrected.map} degree y)));
