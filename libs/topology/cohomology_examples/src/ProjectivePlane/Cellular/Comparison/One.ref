\definition degree: N.Nat^ := one;
\definition value: Target.Carrier degree := edge Edge::loop;
\import Modules.Hom[V := native.family.Carrier degree, W := Target.Carrier degree, source := native.family.space degree, target := Target.space degree] \as Forward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (x: native.family.Carrier degree) => #smul{(Target.space degree)} (x (Fin.zero zero)) value,
  addition := \fun (x, y: native.family.Carrier degree) => #scalarAdd{(Target.space degree)} (x (Fin.zero zero)) (y (Fin.zero zero)) value,
  scalar := \fun (a: I.Int^)(x: native.family.Carrier degree) => #scalarAssoc{(Target.space degree)} a (x (Fin.zero zero)) value,
};
\import Model.Coefficients[A := sourceBundle degree] \as Backward;
\definition backwardValues: Edge -> native.family.Carrier degree := \induction (e: Edge) \return native.family.Carrier one \with {
  | loop: \fun (i: Fin.Fin one) => I.One.specification
  | first: \fun (i: Fin.Fin one) => I.Zero.specification
  | second: \fun (i: Fin.Fin one) => I.One.specification
};
\definition backward: Modules.MapBetween (targetBundle degree) (sourceBundle degree) := Backward.DegreeOne[].extend backwardValues;
\definition backwardOnGenerator: \forall (x: Edge) -> #apply{backward} (edge x) = backwardValues x := Backward.DegreeOne[].onGenerator backwardValues;
\import Model.Coefficients[A := targetBundle two] \as Homotopy;
\definition homotopyValues: Edge -> Target.Carrier two := \induction (e: Edge) \return Target.Carrier two \with {
  | loop: #zero{(Target.space two)}
  | first: #zero{(Target.space two)}
  | second: #neg{(Target.space two)} (triangle Triangle::upper)
};
\definition homotopy: Modules.MapBetween (targetBundle degree) (targetBundle two) := Homotopy.DegreeOne[].extend homotopyValues;
\definition homotopyOnGenerator: \forall (x: Edge) -> #apply{homotopy} (edge x) = homotopyValues x := Homotopy.DegreeOne[].onGenerator homotopyValues;

\definition unit: native.family.Carrier degree := \fun (i: Fin.Fin one) => I.One.specification;
\definition forwardUnit: #apply{forward} unit = value := #scalarOne{(Target.space degree)} value;
