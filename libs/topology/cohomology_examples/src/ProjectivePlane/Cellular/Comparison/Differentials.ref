\import I.Math[].Specification[].Prop[] \as Integers;
\definition zeroBoundary(x: native.family.Carrier one): #apply{native.differential} zero x = #zero{(native.family.space zero)} :=
  Commutative.Matrix[m := one, n := one].zeroAction x;
\definition doubleBoundary(x: native.family.Carrier two): #apply{native.differential} one x = (\fun (i: Fin.Fin one) => I.Mul.specification (I.Int^::ofNat two) (x (Fin.zero zero))) :=
  \axiom:funext(#apply{native.differential} one x, (\fun (i: Fin.Fin one) => I.Mul.specification (I.Int^::ofNat two) (x (Fin.zero zero))),
    \fun (i: Fin.Fin one) => Integers.addZeroRight (I.Mul.specification (I.Int^::ofNat two) (x (Fin.zero zero))));
\definition doubleUnit: #apply{native.differential} one (\fun (i: Fin.Fin one) => I.One.specification) = (\fun (i: Fin.Fin one) => I.Int^::ofNat two) :=
  \axiom:funext(_, _, \fun (i: Fin.Fin one) => trans!{I.Int^} _ _ _
    (congr!{{native.family.Carrier one} I.Int^} (\fun (x: native.family.Carrier one) => x i) _ _ (doubleBoundary (\fun (i: Fin.Fin one) => I.One.specification)))
    (#rightIdentity{(#multiplicative{(#semiring{IntegerRing.ring})})} (I.Int^::ofNat two)));
