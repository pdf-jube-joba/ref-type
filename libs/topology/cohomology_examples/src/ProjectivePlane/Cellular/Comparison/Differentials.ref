\import I.Math[].Specification[].Prop[] \as Integers;
\definition zeroBoundary[x: native.family.Carrier one]: (native.differential).apply zero x = (native.family.space zero).zero :=
  Commutative.Matrix[m := one, n := one].zeroAction x;
\definition doubleBoundary[x: native.family.Carrier two]: (native.differential).apply one x = (\fun (i: Fin.Fin one) => I.Mul.specification (I.Int^::ofNat two) (x (Fin.zero zero))) :=
  \axiom:funext((native.differential).apply one x, (\fun (i: Fin.Fin one) => I.Mul.specification (I.Int^::ofNat two) (x (Fin.zero zero))),
    \fun (i: Fin.Fin one) => Integers.addZeroRight (I.Mul.specification (I.Int^::ofNat two) (x (Fin.zero zero))));
\definition doubleUnit: (native.differential).apply one (\fun (i: Fin.Fin one) => I.One.specification) = (\fun (i: Fin.Fin one) => I.Int^::ofNat two) :=
  \axiom:funext((native.differential).apply one (\fun (i: Fin.Fin one) => I.One.specification), (\fun (i: Fin.Fin one) => I.Int^::ofNat two), \fun (i: Fin.Fin one) => trans!{I.Int^} _ _ _
    (congr!{{native.family.Carrier one} I.Int^} (\fun (x: native.family.Carrier one) => x i) _ _ (doubleBoundary (\fun (i: Fin.Fin one) => I.One.specification)))
    ((((IntegerRing.ring).semiring).multiplicative).rightIdentity (I.Int^::ofNat two)));
