\import Modules.Hom[V := native.family.Carrier n, W := native.family.Carrier n, source := native.family.space n, target := native.family.space n] \as End;
\import Modules.Hom[V := Target.Carrier n, W := native.family.Carrier n, source := Target.space n, target := native.family.space n].Composition[U := native.family.Carrier n, domain := native.family.space n] \as Compose;
\definition composite: End.Map := Compose.compose (backwardDegree n) (forwardDegree n);
\module Low;
\definition law: \forall (x: native.family.Carrier n) -> #apply{composite} x = x := Low[].law;
