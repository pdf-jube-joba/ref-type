\definition degree: N.Nat^ := N.Nat^::succ (N.Nat^::succ n);
\import \parent.Degree[n := degree] \as Degree;
\import Modules.Hom[V := native.family.Carrier (N.Nat^::succ degree), W := Target.Carrier degree, source := native.family.space (N.Nat^::succ degree), target := Target.space degree] \as Maps;
\definition forwardEquation: \forall (x: native.family.Carrier (N.Nat^::succ degree)) -> #apply{Degree.first} x = #apply{Degree.second} x :=
  \fun (x: native.family.Carrier (N.Nat^::succ degree)) => trans!{{Target.Carrier degree}} _ _ _
    (congr!{{native.family.Carrier (N.Nat^::succ degree)} {Target.Carrier degree}} (#apply{Degree.first}) _ _ (\parent.Higher[n := n].sourceZero x))
    (trans!{{Target.Carrier degree}} _ _ _ (Maps.zeroPreserved Degree.first)
      (trans!{{Target.Carrier degree}} _ _ _ (sym!{{Target.Carrier degree}} _ _ (Maps.zeroPreserved Degree.second))
        (congr!{{native.family.Carrier (N.Nat^::succ degree)} {Target.Carrier degree}} (#apply{Degree.second}) _ _ (sym!{{native.family.Carrier (N.Nat^::succ degree)}} _ _ (\parent.Higher[n := n].sourceZero x)))));
