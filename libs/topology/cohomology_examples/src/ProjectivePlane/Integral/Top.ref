\import Modules.Hom[V := H2.CycleCarrier, W := Z2.Carrier, source := H2.cycleSpace, target := Z2.space] \as Evaluation;
\definition totalAdd(f, g: Model.Triangles): Model.total (\fun (t: Triangle) => Arithmetic.add (f t) (g t)) = Arithmetic.add (Model.total f) (Model.total g) :=
  Group.four (f Triangle::upper) (g Triangle::upper) (f Triangle::lower) (g Triangle::lower);
\definition evaluate: Evaluation.Map := Evaluation.Map {
  apply := \fun (f: H2.CycleCarrier) => Z2.class (Model.total f),
  addition := \fun (f, g: H2.CycleCarrier) => trans!{Z2.Carrier} _ _ _
    (congr!{I.Int^ Z2.Carrier} Z2.class _ _ (totalAdd f g)) (sym!{Z2.Carrier} _ _ (Z2.onAdd (Model.total f) (Model.total g))),
  scalar := \fun (a: I.Int^)(f: H2.CycleCarrier) => trans!{Z2.Carrier} _ _ _
    (congr!{I.Int^ Z2.Carrier} Z2.class _ _ (sym!{I.Int^} _ _ (Products.mulAdd a (f Triangle::upper) (f Triangle::lower))))
    (sym!{Z2.Carrier} _ _ (Z2.onScalar a (Model.total f))),
};
\import Modules.Of[V := H2.CycleCarrier, space := H2.cycleSpace].Submodule[].Quotient[S := H2.boundariesInside] \as CohomologyQuotient;
\import CohomologyQuotient.To[W := Z2.Carrier, target := Z2.space] \as Descent;
\definition kills: Descent.Vanishes evaluate := \block {
  \fun (f: H2.CycleCarrier)(boundary: _) \then
  \takefrom g: \Cast[Model.Edges] ({ g: Model.Edges \where Model.deltaOne g = f }) \by boundary \then
  \let equal: Model.deltaOne g = f := \bysub(Model.Edges, { g: Model.Edges \where Model.deltaOne g = f }, g) \then
  \return trans!{Z2.Carrier} _ _ _
    (congr!{Model.Triangles Z2.Carrier} (\fun (x: Model.Triangles) => Z2.class (Model.total x)) _ _ (sym!{Model.Triangles} _ _ equal))
    (trans!{Z2.Carrier} _ _ _
      (congr!{I.Int^ Z2.Carrier} Z2.class _ _ (trans!{I.Int^} _ _ _ (Model.totalBoundary g) (sym!{I.Int^} _ _ (twice (g Edge::loop)))))
      (Z2.classMultiple (g Edge::loop)))
};
\definition forward: Modules.Hom[V := H2.Cohomology, W := Z2.Carrier, source := H2.cohomologySpace, target := Z2.space].Map := Descent.descend evaluate kills;
\import Modules.Hom[V := I.Int^, W := H2.CycleCarrier, source := Modules.scalarModule, target := H2.cycleSpace] \as Representatives;
\definition representative(x: I.Int^): Model.Triangles := Model.triangle Arithmetic.zero x;
\definition represent: Representatives.Map := Representatives.Map {
  apply := \fun (x: I.Int^) => H2.cycle (representative x) (\refl(Zero.Carrier::zero)),
  addition := \fun (x, y: I.Int^) => Model.trianglesExt (representative (Arithmetic.add x y))
    (\fun (t: Triangle) => Arithmetic.add (representative x t) (representative y t)) (sym!{I.Int^} _ _ (Group.zeroLeft Group.zero)) (\refl(Arithmetic.add x y)),
  scalar := \fun (a, x: I.Int^) => Model.trianglesExt (representative (Arithmetic.mul a x))
    (\fun (t: Triangle) => Arithmetic.mul a (representative x t)) (sym!{I.Int^} _ _ (Products.mulZeroRight a)) (\refl(Arithmetic.mul a x)),
};
\import Modules.Hom[V := H2.CycleCarrier, W := H2.Cohomology, source := H2.cycleSpace, target := H2.cohomologySpace].Composition[U := I.Int^, domain := Modules.scalarModule] \as Composition;
\definition fromInteger: Modules.Hom[V := I.Int^, W := H2.Cohomology, source := Modules.scalarModule, target := H2.cohomologySpace].Map := Composition.compose H2.classLinear represent;
\definition twiceRepresentative(x: I.Int^): Model.deltaOne (Model.edge x Arithmetic.zero x) = representative (Arithmetic.mul two x) :=
  trans!{Model.Triangles} _ _ _ (Model.loopBoundary x)
    (congr!{I.Int^ Model.Triangles} (Model.triangle Arithmetic.zero) _ _ (sym!{I.Int^} _ _ (twice x)));
\definition killsDouble(x: I.Int^): #apply{fromInteger} (Arithmetic.mul two x) = H2.zeroClass :=
  H2.boundaryClassZero (#apply{represent} (Arithmetic.mul two x))
    (Logic.existsIntro[Model.Edges, { f: Model.Edges \where Model.deltaOne f = representative (Arithmetic.mul two x) }]
      (Model.edge x Arithmetic.zero x) (twiceRepresentative x));
\import Modules.Of[V := I.Int^, space := Modules.scalarModule].Submodule[] \as Submodules;
\import Submodules.Image[U := I.Int^, source := Modules.scalarModule] \as Images;
\import Submodules.Quotient[S := Z2.multiples].To[W := H2.Cohomology, target := H2.cohomologySpace] \as ReverseDescent;
\definition killsMultiples: ReverseDescent.Vanishes fromInteger := \fun (x: I.Int^)(member: _) =>
  Images.eliminate Z2.multiplication x (#apply{fromInteger} x = H2.zeroClass)
    (\fun (q: I.Int^)(equal: Arithmetic.mul two q = x) => trans!{H2.Cohomology} _ _ _
      (congr!{I.Int^ H2.Cohomology} (#apply{fromInteger}) _ _ (sym!{I.Int^} _ _ equal)) (killsDouble q)) member;
\definition backward: Modules.Hom[V := Z2.Carrier, W := H2.Cohomology, source := Z2.space, target := H2.cohomologySpace].Map := ReverseDescent.descend fromInteger killsMultiples;
\definition onClass(x: I.Int^): #apply{backward} (Z2.class x) = #apply{fromInteger} x := ReverseDescent.onClass fromInteger killsMultiples x;
\definition rightInverseOnClass(x: I.Int^): #apply{forward} (#apply{backward} (Z2.class x)) = Z2.class x :=
  trans!{Z2.Carrier} _ _ _ (congr!{H2.Cohomology Z2.Carrier} (#apply{forward}) _ _ (onClass x))
    (trans!{Z2.Carrier} _ _ _ (Descent.onClass evaluate kills (#apply{represent} x)) (congr!{I.Int^ Z2.Carrier} Z2.class _ _ (Group.zeroLeft x)));
\definition rightInverse: \forall (q: Z2.Carrier) -> #apply{forward} (#apply{backward} q) = q :=
  Z2.induction (\fun (q: Z2.Carrier) => #apply{forward} (#apply{backward} q) = q) rightInverseOnClass;
\definition leftInverse: \forall (h: H2.Cohomology) -> #apply{backward} (#apply{forward} h) = h :=
  H2.classInduction (\fun (h: H2.Cohomology) => #apply{backward} (#apply{forward} h) = h)
    (\fun (f: H2.CycleCarrier) => trans!{H2.Cohomology} _ _ _
      (congr!{Z2.Carrier H2.Cohomology} (#apply{backward}) _ _ (Descent.onClass evaluate kills f))
      (trans!{H2.Cohomology} _ _ _ (onClass (Model.total f))
        (sym!{H2.Cohomology} _ _ (H2.classEqual f (#apply{represent} (Model.total f))
          (Logic.existsIntro[Model.Edges, { g: Model.Edges \where Model.deltaOne g =
            #add{(Raw.second.space)} f (#neg{(Raw.second.space)} (representative (Model.total f))) }]
            (Model.edge Arithmetic.zero (f Triangle::upper) Arithmetic.zero) (Model.boundaryDifference f))))));
\definition isomorphism: Modules.Isomorphism[V := H2.Cohomology, W := Z2.Carrier, source := H2.cohomologySpace, target := Z2.space].Isomorphism :=
  Modules.Isomorphism[V := H2.Cohomology, W := Z2.Carrier, source := H2.cohomologySpace, target := Z2.space].Isomorphism {
    forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
  };
\import \root.Two[].Quotient[] \as BinaryQuotient;
\import Modules.Hom[V := H2.Cohomology, W := Z2.Carrier, source := H2.cohomologySpace, target := Z2.space] \as ForwardMaps;
\definition generatorCoordinate: #apply{forward} generator = Z2.class Arithmetic.one :=
  trans!{Z2.Carrier} _ _ _ (Descent.onClass evaluate kills orientationCycle)
    (congr!{I.Int^ Z2.Carrier} Z2.class _ _ (Group.zeroLeft Arithmetic.one));
\definition generatorNonzero: generator = H2.zeroClass -> Logic.False :=
  \fun (same: generator = H2.zeroClass) => BinaryQuotient.generatorNonzero
    (trans!{Z2.Carrier} _ _ _ (sym!{Z2.Carrier} _ _ generatorCoordinate)
      (trans!{Z2.Carrier} _ _ _ (congr!{H2.Cohomology Z2.Carrier} (#apply{forward}) _ _ same) (ForwardMaps.zeroPreserved forward)));
