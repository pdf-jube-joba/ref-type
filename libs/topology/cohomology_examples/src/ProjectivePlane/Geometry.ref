\import std.Data[].Nat[] \as N;
\import algebraic_topology.Spheres[] \as Spheres;
\definition two: N.Nat^ := N.Nat^::succ (N.Nat^::succ N.Nat^::zero);
\definition Sphere: \Set := Spheres.Carrier two;
\import Spheres.Antipodal[n := two] \as Antipodal;
\import \root.Involution[A := Sphere, source := Spheres.topology two, flip := Antipodal.apply, square := Antipodal.involution] \as Quotient;
\definition Carrier: \Set := Quotient.Carrier;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Quotient.topology;
\definition projection: Sphere -> Carrier := Quotient.class;
\definition antipodalIdentified(x: Sphere): projection (Antipodal.apply x) = projection x := Quotient.identify x;
\definition fibers(x, y: Sphere): projection x = projection y -> Quotient.Equivalent x y := Quotient.classEqual x y;
\definition continuous: topology.Continuity[A := Sphere, B := Carrier].Continuous (Spheres.topology two) topology projection := Quotient.continuous;

\module Hemisphere;
\module Attachment;
\module Chart;
