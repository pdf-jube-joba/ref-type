\import \parent.Integral[] \as Z;
\import \parent.ModTwo[] \as ModTwo;
\import \root.Two[] \as F;
\import F.Quotient[] \as Reduction;
\import \parent.With[A := Z.coefficients] \as IntegerModel;
\import \parent.With[A := ModTwo.coefficients] \as BinaryModel;
\import std.Arithmetic[].IntAlgebra[].Calculation[] \as Arithmetic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import Modules.Laws[V := F.Carrier, space := F.integerSpace] \as Values;
\definition integralLift: IntegerModel.Edges := IntegerModel.edge Arithmetic.one Arithmetic.zero Arithmetic.one;
\definition reduce(f: IntegerModel.Edges): BinaryModel.Edges := \fun (e: Edge) => #apply{Reduction.reduction} (f e);
\definition liftReduces: reduce integralLift = ModTwo.u := BinaryModel.edgesExt (reduce integralLift) ModTwo.u
  (#scalarOne{F.integerSpace} F.one) (Values.zeroScale F.one) (#scalarOne{F.integerSpace} F.one);
\definition derivative: IntegerModel.deltaOne integralLift = IntegerModel.triangle Arithmetic.zero Z.two :=
  IntegerModel.trianglesExt (IntegerModel.deltaOne integralLift) (IntegerModel.triangle Arithmetic.zero Z.two) (\refl(Arithmetic.zero)) (\refl(Z.two));
\definition dividedDerivative: IntegerModel.deltaOne integralLift =
  \fun (t: Triangle) => Arithmetic.mul Z.two (Z.orientation t) :=
  IntegerModel.trianglesExt (IntegerModel.deltaOne integralLift) (\fun (t: Triangle) => Arithmetic.mul Z.two (Z.orientation t)) (\refl(Arithmetic.zero)) (\refl(Z.two));
\definition dividedClass: _ := Z.generator;
\module Finite;
