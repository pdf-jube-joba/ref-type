\import \root.Circle[].Geometry[].Loop[] \as CircleLoop;
\import \parent.Faces[] \as Faces;
\import \parent.Finite[] \as Finite;
\import \root.ProjectivePlane[].Geometry[].Attachment[] \as Attachment;
\import Attachment.Base[] \as Base;
\import Attachment.Inverse[] \as Inverse;
\import Attachment.Canonical[] \as Canonical;
\import sphere_maps.Circle[].Quotient[] \as CircleQuotient;
\definition backLeft[x: Simplex.Carrier one]: left (Faces.backPoint x) = CircleLoop.u x := Simplex.faceFirstSuccessor one x Faces.edgeFirst;
\definition backRight[x: Simplex.Carrier one]: right (Faces.backPoint x) = CircleLoop.v x := Simplex.faceFirstSuccessor one x Faces.edgeLast;
\definition vectors[x: Simplex.Carrier one]: vector (Faces.backPoint x) = CircleLoop.vector x :=
  ComplexLaws.ext _ _ (congr!{Real.Real Real.Real} Root.sqrt _ _ (backRight x)) (congr!{Real.Real Real.Real} Root.sqrt _ _ (backLeft x));
\definition onDisk[x: Simplex.Carrier one]: upper (Faces.backPoint x) = Attachment.boundary (CircleLoop.upper x) :=
  congr!{Complex.Complex Disk.Coordinate} Coordinates.ambientBackward _ _
    (congr2!{Complex.Complex Complex.Complex Complex.Complex} Operations.mul _ _ _ _ (vectors x) (vectors x));
\definition basePoint[y: CircleQuotient.Sphere]: Base.Carrier := (Base.sphereHomeomorphism).backward y;
\definition inclusion[y: CircleQuotient.Sphere]: Projective.Carrier := (Inverse.projectiveHomeomorphism).forward (basePoint y);
\import topology.Continuity[A := Base.Carrier, B := Attachment.Point].Corestriction[S := Attachment.Fibers[].BaseImage] \as IncludeBase;
\import topology.Composition[A := CircleQuotient.Sphere, B := Base.Carrier, C := Attachment.Point] \as FirstComposition;
\import topology.Composition[A := CircleQuotient.Sphere, B := Attachment.Point, C := Projective.Carrier] \as Composition;
\definition baseContinuous: topology.Continuity[A := CircleQuotient.Sphere, B := Attachment.Point].Continuous CircleQuotient.sphereTopology Attachment.pointTopology (\fun (y: CircleQuotient.Sphere) => basePoint y) :=
  FirstComposition.composeContinuous CircleQuotient.sphereTopology Base.topology Attachment.pointTopology basePoint (\fun (p: Base.Carrier) => p)
    ((Base.sphereHomeomorphism).backwardContinuous) (IncludeBase.inclusionContinuous Attachment.pointTopology);
\definition continuous: topology.Continuity[A := CircleQuotient.Sphere, B := Projective.Carrier].Continuous CircleQuotient.sphereTopology Projective.topology inclusion :=
  Composition.composeContinuous CircleQuotient.sphereTopology Attachment.pointTopology Projective.topology (\fun (y: CircleQuotient.Sphere) => basePoint y) ((Inverse.projectiveHomeomorphism).forward)
    baseContinuous ((Inverse.projectiveHomeomorphism).forwardContinuous);
\definition baseLoop[x: Simplex.Carrier one]: basePoint (CircleLoop.simplex x) = Base.inclusion (CircleQuotient.class (CircleLoop.upper x)) :=
  trans!{Base.Carrier} _ _ _
    (congr!{CircleQuotient.Sphere Base.Carrier} ((Base.sphereHomeomorphism).backward) _ _
      (sym!{CircleQuotient.Sphere} _ _ (trans!{CircleQuotient.Sphere} _ _ _
        (Base.onIncluded (CircleQuotient.class (CircleLoop.upper x))) (CircleQuotient.onClass (CircleLoop.upper x)))))
    ((Base.sphereHomeomorphism).leftInverse (Base.inclusion (CircleQuotient.class (CircleLoop.upper x))));
\import algebraic_topology.CW[A := CircleQuotient.Carrier].Attach[n := two].Along[attach := CircleQuotient.class] \as Attached;
\definition pointwise[x: Simplex.Carrier one]: inclusion (CircleLoop.simplex x) = Finite.loopEdge x :=
  trans!{Projective.Carrier} _ _ _
    (congr!{Attachment.Point Projective.Carrier} ((Inverse.projectiveHomeomorphism).forward) _ _ (baseLoop x))
    (trans!{Projective.Carrier} _ _ _
      (congr!{Attachment.Point Projective.Carrier} ((Inverse.projectiveHomeomorphism).forward) _ _ (Attached.attached (CircleLoop.upper x)))
      (trans!{Projective.Carrier} _ _ _ (Canonical.characteristic (Attachment.boundary (CircleLoop.upper x)))
        (congr!{Disk.Disk Projective.Carrier} diskProjection _ _ (sym!{Disk.Disk} _ _ (onDisk x)))));
\import singular_cohomology.Maps[A := CircleQuotient.Sphere, B := Projective.Carrier, source := CircleQuotient.sphereTopology, target := Projective.topology] \as Maps;
\definition simplex: Maps.postcompose one inclusion continuous CircleLoop.simplex = Finite.loopEdge := Simplices.ext one _ _ pointwise;
