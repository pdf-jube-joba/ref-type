\import \root.ProjectivePlane[].Geometry[] \as Projective;
\import \root.ProjectivePlane[].Geometry[].Hemisphere[] \as Hemisphere;
\import Hemisphere.Continuity[] \as HemisphereContinuity;
\import Hemisphere.DiskQuotient[] \as DiskQuotient;
\import \parent.Continuity[] \as ChartContinuity;
\import \parent.Formulas[] \as Formulas;
\definition diskProjection(x: Disk.Disk): Projective.Carrier := Projective.projection (Hemisphere.sphereLift x);
\import topology.Composition[A := Disk.Disk, B := Projective.Sphere, C := Projective.Carrier] \as ProjectionComposition;
\definition diskContinuous: topology.Continuity[A := Disk.Disk, B := Projective.Carrier].Continuous Disk.diskTopology Projective.topology diskProjection :=
  ProjectionComposition.composeContinuous Disk.diskTopology (Spheres.topology two) Projective.topology Hemisphere.sphereLift Projective.projection
    HemisphereContinuity.sphereLiftContinuous Projective.continuous;
\import topology.Composition[A := Domain.CarrierSet, B := Disk.Disk, C := Projective.Carrier] \as Composition;
\import singular_cohomology.Simplices[A := Projective.Carrier, source := Projective.topology] \as Simplices;
\definition upperSimplex: Simplices.Carrier two := \into[Simplices.At[n := two].Function]((\fun (x: Domain.CarrierSet) => diskProjection (upper x)), Simplices.Carrier two) \by {
  Composition.composeContinuous Domain.topology Disk.diskTopology Projective.topology upper diskProjection ChartContinuity.upperContinuous diskContinuous
};
\definition lowerSimplex: Simplices.Carrier two := \into[Simplices.At[n := two].Function]((\fun (x: Domain.CarrierSet) => diskProjection (lower x)), Simplices.Carrier two) \by {
  Composition.composeContinuous Domain.topology Disk.diskTopology Projective.topology lower diskProjection ChartContinuity.lowerContinuous diskContinuous
};
\import \root.Involution[A := Projective.Sphere, source := Spheres.topology two, flip := Antipodal.apply, square := Antipodal.involution] \as Involution;
\import topological_constructions.RelationQuotient[A := Projective.Sphere, relation := Involution.Equivalent] \as Quotient;
\definition projectionRespects(x, y: Disk.Disk)(related: DiskQuotient.Equivalent x y): diskProjection x = diskProjection y :=
  Quotient.relatedEqual Involution.laws (Hemisphere.sphereLift x) (Hemisphere.sphereLift y) related;
\definition boundaryEqual(x: Domain.CarrierSet)(onEdge: center x = Real.zero): lowerSimplex x = upperSimplex x :=
  projectionRespects (lower x) (upper x) (#rtl{(Boundary.characterizes (lower x) (upper x))}
    (std.Logic[].Proposition[].Or[_, _]::right (std.Logic[].Proposition[].And[_, _]::#
      (trans!{Real.Real} _ _ _ (Boundary.negativeNorm (upper x)) (Formulas.boundaryNorm x onEdge)) (\refl(lower x)))));
\module Faces;
\module Finite;
\module Loop;
