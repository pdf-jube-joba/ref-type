\import \root.Surface[V := Vertex, E := Edge, T := Triangle].On[surface := object].Simplicial[] \as Finite;
\import \parent.Chart[].Singular[].Finite[] \as Geometric;
\import \parent.Restriction[coefficients := L] \as LeftRestriction;
\import \parent.Restriction[coefficients := M] \as MiddleRestriction;
\import \parent.Restriction[coefficients := R] \as RightRestriction;
\import singular_cohomology.Coefficients[A := Carrier, source := topology].Sequence[L := L, M := M, R := R] \as ActualSequence;
\import Finite.Sequence[L := L, M := M, R := R] \as FiniteSequence;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := IntegerRing.commutativeRing] \as Hom;
\import singular_cohomology.Chains[A := Carrier, source := topology] \as Singular;
\import Hom.On[P := Singular.complex, N := L] \as SourceLeft;
\import Hom.On[P := Singular.complex, N := M] \as SourceMiddle;
\import Hom.On[P := Singular.complex, N := R] \as SourceRight;
\import Hom.On[P := Finite.chainComplex, N := L] \as TargetLeft;
\import Hom.On[P := Finite.chainComplex, N := M] \as TargetMiddle;
\import Hom.On[P := Finite.chainComplex, N := R] \as TargetRight;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := IntegerRing.ring] \as Cochains;
\import Cochains.ShortExact[A := SourceLeft.complex, B := SourceMiddle.complex, C := SourceRight.complex].Morphism[A1 := TargetLeft.complex, B1 := TargetMiddle.complex, C1 := TargetRight.complex] \as Morphism;
\import Modules.ShortExact[A := L, B := M, C := R] \as Coefficients;
\module On(s: Coefficients.Sequence);
