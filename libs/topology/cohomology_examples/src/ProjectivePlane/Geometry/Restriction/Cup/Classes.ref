\definition cycle: FiniteTwo.CycleCarrier := Restriction.At[n := twoDegree].cycle (ClassCup.cycle alpha beta);
\definition representative: FiniteTwo.ambient cycle = finiteCup (Restriction.apply oneDegree alpha) (Restriction.apply oneDegree beta) := equation alpha beta;
\definition law:
  #apply{Restriction.At[n := twoDegree].induced} (ClassCup.apply (ActualOne.classOf alpha) (ActualOne.classOf beta)) = FiniteTwo.classOf cycle :=
  trans!{FiniteTwo.Cohomology} _ _ _
    (congr!{ActualTwo.Cohomology FiniteTwo.Cohomology} (#apply{Restriction.At[n := twoDegree].induced}) _ _ (ClassCup.onClasses alpha beta))
    (Restriction.At[n := twoDegree].onClass (ClassCup.cycle alpha beta));
