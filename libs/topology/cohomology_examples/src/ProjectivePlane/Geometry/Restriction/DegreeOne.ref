\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import Finite.Coefficients[A := coefficients].DegreeOne[] \as Coordinates;
\import \parent.\parent.Chart[].Singular[].Loop[] \as Loop;
\import singular_cohomology.Cochains[A := sphere_maps.Circle[].Quotient[].Sphere, source := sphere_maps.Circle[].Quotient[].sphereTopology].With[coefficients := coefficients] \as Circle;
\import singular_cohomology.Maps[A := sphere_maps.Circle[].Quotient[].Sphere, B := Carrier, source := sphere_maps.Circle[].Quotient[].sphereTopology, target := topology].Coefficients[M := coefficients, L := coefficients] \as CirclePull;
\definition loopValue[h: Actual.Carrier one]:
  Coordinates.evaluate (apply one h) Edge::loop = (h).apply (SingularChains.generator one Geometric.loopEdge) :=
  trans!{coefficients.Carrier} _ _ _ (onGenerator one h (Finite.edge Edge::loop))
    (congr!{{singular_cohomology.Simplices[A := Carrier, source := topology].Carrier one} coefficients.Carrier}
      (\fun (sigma: singular_cohomology.Simplices[A := Carrier, source := topology].Carrier one) => (h).apply (SingularChains.generator one sigma)) _ _ (Geometric.onEdge Edge::loop));
\import \root.Circle[].Geometry[].Loop[] \as CircleLoop;
\import singular_cohomology.Chains[A := sphere_maps.Circle[].Quotient[].Sphere, source := sphere_maps.Circle[].Quotient[].sphereTopology] \as CircleChains;
\definition onLoop[h: Actual.Carrier one]:
  ((CirclePull.map Loop.inclusion Loop.continuous Identity.identity).apply one h).apply (CircleChains.generator one CircleLoop.simplex) =
  Coordinates.evaluate (apply one h) Edge::loop :=
  trans!{coefficients.Carrier} _ _ _
    (CirclePull.At[n := one].onCochain Loop.inclusion Loop.continuous Identity.identity h CircleLoop.simplex)
    (trans!{coefficients.Carrier} _ _ _
      (congr!{{singular_cohomology.Simplices[A := Carrier, source := topology].Carrier one} coefficients.Carrier}
        (\fun (sigma: singular_cohomology.Simplices[A := Carrier, source := topology].Carrier one) => (h).apply (SingularChains.generator one sigma)) _ _ Loop.simplex)
      (sym!{coefficients.Carrier} _ _ (loopValue h)));
\module Topology;
\module Functional;
