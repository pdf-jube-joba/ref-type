\definition index: N.Nat^ := two;
\import Signed.At[C := AttachedSigned.complex, z := I.Int^::ofNat index] \as Middle;
\import Modules.Isomorphism[V := Groups.Cokernel, W := Middle.Cohomology, source := Groups.cokernelSpace, target := Middle.cohomologySpace].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := Actual.cohomology index, W := Middle.Cohomology, source := Actual.cohomologySpace index, target := Middle.cohomologySpace].Composition[U := Groups.Cokernel, final := Groups.cokernelSpace] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Actual.cohomology index, W := Groups.Cokernel, source := Actual.cohomologySpace index, target := Groups.cokernelSpace].Isomorphism :=
  Composition.compose (Inverse.inverse Groups.cokernelIsomorphism) (\parent.Degree[n := index].isomorphism);
