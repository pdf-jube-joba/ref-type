\import topology.Topology[Carrier := Point] \as Space;
\import topology.Topology[Carrier := Disk.Disk] \as DiskSpace;
\import topology.Topology[Carrier := Circle.Carrier] \as CircleSpace;
\import metric_spaces.RealLine[] \as Line;
\import Line.Rays[] \as Rays;
\import Disk.Geometry[] \as Geometry;
\import topology.Continuity[A := Disk.Coordinate, B := Disk.Coordinate].Corestriction[S := Disk.ClosedBall] \as Inclusion;
\import topology.Composition[A := Disk.Disk, B := Disk.Coordinate, C := Real.Real] \as Norm;
\definition interior: \Pow Disk.Disk := { x: Disk.Disk \where R.Lt (Disk.normSquared x) Real.one };
\definition interiorOpen: DiskSpace.IsOpenIn Disk.diskTopology interior :=
  (Norm.composeContinuous Disk.diskTopology Disk.topology Line.topology (\fun (x: Disk.Disk) => x) Disk.normSquared
    (Inclusion.inclusionContinuous Disk.topology) Geometry.normSquaredContinuous) (Rays.Below Real.one) (Rays.belowOpen Real.one);
\structure Witness[U: \Pow Disk.Disk, p: Point]: \Set {
  point: Disk.Disk,
  member: \In[Disk.Disk] U point,
  interior: R.Lt (Disk.normSquared point) Real.one,
  image: Attached.characteristic point = p,
}
\definition Image(U: \Pow Disk.Disk): \Pow Point := { p: Point \where \exists Witness[U, p] };
\import topology.Continuity[A := Circle.Carrier, B := Point] \as LeftMaps;
\import topology.Continuity[A := Disk.Disk, B := Point] \as RightMaps;
\module Open(U: \Pow Disk.Disk, open: DiskSpace.IsOpenIn Disk.diskTopology U);
\definition interiorImage: \Pow Point := Image DiskSpace.Whole;
\definition part(U: \Pow Disk.Disk)(x: Disk.Disk)(member: \In[Disk.Disk] U x)(inside: R.Lt (Disk.normSquared x) Real.one): \In[Point] (Image U) (Attached.characteristic x) :=
  \exact(Witness[U, Attached.characteristic x] { point := x, member := member, interior := inside, image := \refl(Attached.characteristic x) }, Witness[U, Attached.characteristic x]);
\definition inverseNeighborhood(U: \Pow Disk.Disk)(open: DiskSpace.IsOpenIn Disk.diskTopology U):
  \exists { V: \Pow Point \where Logic.And[Space.IsOpenIn pointTopology V, Image U = Space.Intersection interiorImage V] } :=
  Logic.existsIntro[\Pow Point, { V: \Pow Point \where Logic.And[Space.IsOpenIn pointTopology V, Image U = Space.Intersection interiorImage V] }] (Image U)
    (Logic.And[_, _]::# (Open[U := U, open := open].imageOpen)
      (\axiom:setext(Image U, Space.Intersection interiorImage (Image U),
        \block {
          \fun (p: Point)(exists: \In[Point] (Image U) p) \then
          \takefrom w: Witness[U, p] \by exists \then
          \return Logic.And[_, _]::#
            (\exact(Witness[DiskSpace.Whole, p] { point := #point{w}, member := \refl(#point{w}), interior := #interior{w}, image := #image{w} }, Witness[DiskSpace.Whole, p])) exists
        },
        \fun (p: Point)(member: Space.Member (Space.Intersection interiorImage (Image U)) p) => #right{member})));
