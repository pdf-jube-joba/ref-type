\import N.Basic[].Def[] \as Arithmetic;
\definition index: N.Nat^ := Arithmetic.add n two;
\import Cochains.At[C := CircleSigned.complex, z := I.Int^::ofNat index] \as SphereH;
\import Cochains.At[C := Sub.complex, z := I.Int^::ofNat index] \as Target;
\import singular_cohomology.Equivalence[A := Circle.Sphere, B := Base.Carrier, source := Circle.sphereTopology, target := Base.topology].Integer[e := baseEquivalence].With[coefficients := coefficients].At[z := I.Int^::ofNat index] \as Comparison;
\import cohomology_models.Spheres[].With[coefficients := coefficients] \as SphereGroups;
\import Modules.Isomorphism[V := SphereH.Cohomology, W := CircleNatural.cohomology index, source := SphereH.cohomologySpace, target := CircleNatural.cohomologySpace index].Vanishing[] \as SphereZero;
\definition sphereZero: \forall (h: SphereH.Cohomology) -> h = SphereH.zeroClass := SphereZero.sourceZero CircleSigned.At[n := index].isomorphism (SphereGroups.above one n);
\import Modules.Isomorphism[V := SphereH.Cohomology, W := Target.Cohomology, source := SphereH.cohomologySpace, target := Target.cohomologySpace].Vanishing[] \as Vanishing;
\definition law: \forall (h: Target.Cohomology) -> h = Target.zeroClass := Vanishing.targetZero Comparison.isomorphism sphereZero;
