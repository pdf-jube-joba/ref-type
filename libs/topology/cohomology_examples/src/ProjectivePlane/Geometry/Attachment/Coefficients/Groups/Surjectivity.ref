\import Cochains.At[C := Sub.complex, z := degreeTwo] \as BaseH2;
\import Cochains.Map[C := Whole.complex, D := Sub.complex].At[k := degreeTwo] \as Projection;
\definition law(h: second.Carrier): \exists { q: coefficients.Carrier \where #apply{inclusion} q = h } := \block {
  \takefrom a: \Cast[RelativeH.Cohomology] ({ a: RelativeH.Cohomology \where #apply{(Inclusion.induced Sequence.inclusion)} a = h })
    \by SecondExactness.exactAtB h (\parent.\parent.BaseHigher[n := zero].law (#apply{(Projection.induced Sequence.restriction)} h)) \then
  \return Logic.existsIntro[coefficients.Carrier, { q: coefficients.Carrier \where #apply{inclusion} q = h }] (#apply{#backward{relativeOrientation}} a)
    (trans!{second.Carrier} _ _ _
      (congr!{RelativeH.Cohomology second.Carrier} (#apply{(Inclusion.induced Sequence.inclusion)}) _ _ (#rightInverse{relativeOrientation} a))
      (\bysub(RelativeH.Cohomology, { a: RelativeH.Cohomology \where #apply{(Inclusion.induced Sequence.inclusion)} a = h }, a)))
};
