\import Modules.Hom[V := first.Carrier, W := coefficients.Carrier, source := first.space, target := coefficients.space] \as Maps;
\import Modules.Hom[V := coefficients.Carrier, W := BaseH.Cohomology, source := coefficients.space, target := BaseH.cohomologySpace] \as BaseMaps;
\import Modules.Hom[V := R1.Cohomology, W := first.Carrier, source := R1.cohomologySpace, target := first.space] \as InclusionMaps;
\definition kernelZero(h: first.Carrier)(killed: #apply{restriction} h = #zero{coefficients.space}): h = #zero{first.space} := \block {
  \let zero: #apply{(Restriction.induced Sequence.restriction)} h = BaseH.zeroClass :=
    trans!{BaseH.Cohomology} _ _ _
      (sym!{BaseH.Cohomology} _ _ (#rightInverse{baseOrientation} (#apply{(Restriction.induced Sequence.restriction)} h)))
      (trans!{BaseH.Cohomology} _ _ _
        (congr!{coefficients.Carrier BaseH.Cohomology} (#apply{#forward{baseOrientation}}) _ _ killed)
        (BaseMaps.zeroPreserved #forward{baseOrientation})) \then
  \takefrom a: \Cast[R1.Cohomology] ({ a: R1.Cohomology \where #apply{(LowerInclusion.induced Sequence.inclusion)} a = h }) \by FirstExactness.exactAtB h zero \then
  \return trans!{first.Carrier} _ _ _
    (sym!{first.Carrier} _ _ (\bysub(R1.Cohomology, { a: R1.Cohomology \where #apply{(LowerInclusion.induced Sequence.inclusion)} a = h }, a)))
    (trans!{first.Carrier} _ _ _
      (congr!{R1.Cohomology first.Carrier} (#apply{(LowerInclusion.induced Sequence.inclusion)}) _ _ (\parent.\parent.RelativeVanishing[].first a))
      (InclusionMaps.zeroPreserved (LowerInclusion.induced Sequence.inclusion)))
};
\definition law: \forall (x, y: first.Carrier) -> #apply{restriction} x = #apply{restriction} y -> x = y := Maps.injectiveOfZeroKernel restriction kernelZero;
