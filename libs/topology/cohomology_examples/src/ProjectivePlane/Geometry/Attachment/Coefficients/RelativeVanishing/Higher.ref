\import N.Basic[].Def[] \as Arithmetic;
\definition index: N.Nat^ := Arithmetic.add n three;
\definition boundaryIndex: N.Nat^ := Arithmetic.add n two;
\import \parent.\parent.RelativeDegree[n := boundaryIndex] \as Comparison;
\import Cochains.At[C := Relative.complex, z := I.Int^::ofNat index] \as H;
\import Modules.Isomorphism[V := SphereGroups.cohomology one (I.Int^::ofNat boundaryIndex), W := H.Cohomology,
  source := SphereGroups.space one (I.Int^::ofNat boundaryIndex), target := H.cohomologySpace].Vanishing[] \as Vanishing;
\definition law: \forall (h: H.Cohomology) -> h = H.zeroClass := Vanishing.targetZero Comparison.isomorphism (SphereGroups.above one n);
