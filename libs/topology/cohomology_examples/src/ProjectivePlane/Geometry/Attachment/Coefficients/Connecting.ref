\import \parent.BoundaryAction[] \as BoundaryAction;
\import DiskPair.Maps[B := Point].Over[target := pointTopology, targetSubset := Fibers.BaseImage].On[f := CellComparison.characteristic].Integer[].With[coefficients := coefficients] \as CoefficientMap;
\import Exact.At[s := Sequence.sequence, k := degreeOne] \as Actual;
\import DiskExact.At[s := DiskSequence.sequence, k := degreeOne] \as Disk;
\definition onOrientation(q: coefficients.Carrier): #apply{Actual.connecting} (#apply{#forward{baseOrientation}} q) = #apply{#forward{relativeOrientation}} (#add{coefficients.space} q q) :=
  Modules.Hom[V := RelativeH.Cohomology, W := DiskH.Cohomology, source := RelativeH.cohomologySpace, target := DiskH.cohomologySpace].injectiveOfZeroKernel #forward{cellRestriction}
    (\fun (h: RelativeH.Cohomology)(zero: #apply{#forward{cellRestriction}} h = #zero{DiskH.cohomologySpace}) =>
      trans!{RelativeH.Cohomology} _ _ _ (sym!{RelativeH.Cohomology} _ _ (#leftInverse{cellRestriction} h))
        (trans!{RelativeH.Cohomology} _ _ _
          (congr!{DiskH.Cohomology RelativeH.Cohomology} (#apply{#backward{cellRestriction}}) _ _ zero)
          (Modules.Hom[V := DiskH.Cohomology, W := RelativeH.Cohomology, source := DiskH.cohomologySpace, target := RelativeH.cohomologySpace].zeroPreserved #backward{cellRestriction}))) _ _
    (trans!{DiskH.Cohomology} _ _ _
      (sym!{DiskH.Cohomology} _ _ (CoefficientMap.At[z := degreeOne].connectingNaturality (#apply{#forward{baseOrientation}} q)))
      (trans!{DiskH.Cohomology} _ _ _
        (congr!{BoundaryH.Cohomology DiskH.Cohomology} (#apply{Disk.connecting}) _ _ (BoundaryAction.onOrientation q))
        (sym!{DiskH.Cohomology} _ _ (#rightInverse{cellRestriction} (#apply{#forward{diskOrientation}} (#add{coefficients.space} q q))))));
