\definition lower: I.Int^ := z;
\import chain_complexes.Integer[] \as Degrees;
\definition upper: I.Int^ := Degrees.next z;
\import singular_cohomology.Chains[A := Circle.Sphere, source := Circle.sphereTopology].Reduced[] \as Sphere;
\import singular_cohomology.Chains[A := DiskPair.SubspaceCarrier, source := DiskBoundary.topology Disk.diskTopology].Reduced[] \as Boundary;
\import Sphere.With[coefficients := coefficients].At[z := lower] \as SphereH;
\import Boundary.With[coefficients := coefficients].At[z := lower] \as BoundaryH;
\import Cochains.At[C := DiskRelativeCochains.complex, z := upper] \as DiskH;
\import Cochains.At[C := Relative.complex, z := upper] \as Target;
\import singular_cohomology.Equivalence[A := Circle.Sphere, B := DiskPair.SubspaceCarrier, source := Circle.sphereTopology, target := DiskBoundary.topology Disk.diskTopology].Reduced[].With[coefficients := coefficients].At[z := lower] \as BoundaryComparison;
\import DiskPair.Reduced[].With[coefficients := coefficients].ConnectingContractible[].At[z := lower] \as Shift;
\import Modules.Isomorphism[V := SphereH.Carrier, W := BoundaryH.Carrier, source := SphereH.space, target := BoundaryH.space].Composition[U := DiskH.Cohomology, final := DiskH.cohomologySpace] \as DiskCompose;
\definition diskIsomorphism: Modules.Isomorphism[V := SphereH.Carrier, W := DiskH.Cohomology, source := SphereH.space, target := DiskH.cohomologySpace].Isomorphism :=
  DiskCompose.compose (Shift.isomorphism (Disk.Contraction[].contraction)) (BoundaryComparison.isomorphism DiskRelative.equivalence);
\definition restriction: Modules.Isomorphism[V := Target.Cohomology, W := DiskH.Cohomology, source := Target.cohomologySpace, target := DiskH.cohomologySpace].Isomorphism :=
  CellComparison.With[coefficients := coefficients].At[z := upper].isomorphism;
\import Modules.Isomorphism[V := Target.Cohomology, W := DiskH.Cohomology, source := Target.cohomologySpace, target := DiskH.cohomologySpace].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := SphereH.Carrier, W := DiskH.Cohomology, source := SphereH.space, target := DiskH.cohomologySpace].Composition[U := Target.Cohomology, final := Target.cohomologySpace] \as Compose;
\definition isomorphism: Modules.Isomorphism[V := SphereH.Carrier, W := Target.Cohomology, source := SphereH.space, target := Target.cohomologySpace].Isomorphism :=
  Compose.compose (Inverse.inverse restriction) diskIsomorphism;
