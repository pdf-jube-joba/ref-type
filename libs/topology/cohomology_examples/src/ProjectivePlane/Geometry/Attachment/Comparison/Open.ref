\import OpenDisk.Open[] \as DomainOpen;
\import topology.Continuity[A := Domain, B := Range] \as Maps;
\definition preimage: \Pow Domain := Maps.Preimage chart U;
\definition diskImage: \Pow Disk.Disk := DomainOpen.image preimage;
\definition diskOpen: DiskSpace.IsOpenIn Disk.diskTopology diskImage := DomainOpen.imageOpen Disk.diskTopology LocalDisk.boundaryClosed preimage open;
\definition image: \Pow Point := Interior.Image diskImage;
\definition trace: OpenCell.Trace image = U :=
  \axiom:setext(OpenCell.Trace image, U,
    \block {
      \fun (p: Range)(member: \In[Point] image p) \then
      \takefrom w: Interior.Witness[diskImage, p] \by member \then
      \return DomainOpen.imageElim preimage (#point{w}) (\In[Range] U p)
        (\fun (x: Domain)(inside: \In[Range] U (chart x))(same: x = #point{w}) =>
          \idelim chart x = p \with q: Range => \In[Range] U q \by {
            base: inside, equality: trans!{Point} _ _ _ (congr!{Disk.Disk Point} Attached.characteristic _ _ same) (#image{w})
          }) (#member{w})
    },
    \block {
      \fun (p: Range)(member: \In[Range] U p) \then
      \takefrom x: \Cast[Domain] ({ x: Domain \where chart x = p }) \by onto p \then
      \let same: chart x = p := \bysub(Domain, { x: Domain \where chart x = p }, x) \then
      \let inside: \In[Domain] preimage x := \idelim p = chart x \with q: Range => \In[Range] U q \by { base: member, equality: sym!{Range} _ _ same } \then
      \return \idelim Attached.characteristic x = p \with q: Point => \In[Point] image q \by {
        base: Interior.part diskImage x (DomainOpen.imageMember preimage x inside) (strict x), equality: same
      }
    });
\definition reflected: topology.Topology[Carrier := Range].IsOpenIn rangeTopology U :=
  \idelim OpenCell.Trace image = U \with V: \Pow Range => topology.Topology[Carrier := Range].IsOpenIn rangeTopology V \by {
    base: OpenCell.traceOpen pointTopology image (Interior.Open[U := diskImage, open := diskOpen].imageOpen), equality: trace
  };
