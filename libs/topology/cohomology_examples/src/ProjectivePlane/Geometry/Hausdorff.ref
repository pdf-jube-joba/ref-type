\import Quotient.Separation[flipContinuous := Antipodal.continuous] \as Separated;
\import algebraic_topology.Euclidean[].Dimension[n := N.Nat^::succ two].Compactness[] \as Compactness;
\definition law: topology.Topology[Carrier := Carrier].IsT2 topology := Separated.hausdorff Compactness.sphereHausdorff;
