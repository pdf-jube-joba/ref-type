\import ActualSequence.On[s := s] \as Source;
\import FiniteSequence.On[s := s] \as Target;
\import Morphism.Diagram[s := Source.sequence, t := Target.sequence, a := LeftRestriction.map, b := MiddleRestriction.map, c := RightRestriction.map] \as Diagram;
\definition diagram: Diagram.Commutative := Diagram.Commutative {
  left := \fun (n: N.Nat^)(h: SourceLeft.Carrier n) => TargetMiddle.At[n := n].ext _ _ (\fun (x: Finite.chainComplex.family.Carrier n) => \refl(#apply{s.inclusion} (#apply{h} (#apply{Geometric.comparison} n x)))),
  right := \fun (n: N.Nat^)(h: SourceMiddle.Carrier n) => TargetRight.At[n := n].ext _ _ (\fun (x: Finite.chainComplex.family.Carrier n) => \refl(#apply{s.projection} (#apply{h} (#apply{Geometric.comparison} n x)))),
};
\module At(n: N.Nat^) {
  \import Diagram.At[n := n] \as Naturality;
  \import Cochains.At[C := SourceRight.complex, k := n] \as Input;
  \definition law(q: Input.Cohomology):
    #apply{Target.Bockstein[n := n].connecting} (#apply{RightRestriction.At[n := n].induced} q) =
    #apply{LeftRestriction.At[n := N.Nat^::succ n].induced} (#apply{Source.Bockstein[n := n].connecting} q) :=
    Naturality.naturality diagram q;
}
