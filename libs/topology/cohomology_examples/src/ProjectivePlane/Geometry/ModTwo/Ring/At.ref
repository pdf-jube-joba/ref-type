\definition restricted: FiniteOne.CycleCarrier := Restriction.At[n := one].cycle alpha;
\definition coordinate: MatrixOne.CycleCarrier := FirstComparison.forwardValue restricted;
\definition loopCoordinate: ((\parent.\parent.Comparison[].coordinate).forward).apply (FiniteOne.classOf restricted) = coordinate Edge::loop :=
  trans!{Binary.Carrier} _ _ _
    (congr!{MatrixOne.Cohomology Binary.Carrier} ((FirstCoordinate.forward).apply) _ _ (FirstComparison.onClass restricted))
    (FirstDescent.onClass FirstCoordinate.evaluate FirstCoordinate.kills coordinate);
\definition restrictedClass[representative: ActualOne.classOf alpha = u]: FiniteOne.classOf restricted = FiniteBockstein.binaryGenerator :=
  trans!{FiniteOne.Cohomology} _ _ _ (sym!{FiniteOne.Cohomology} _ _ (Restriction.At[n := one].onClass alpha))
    (trans!{FiniteOne.Cohomology} _ _ _
      (congr!{ActualOne.Cohomology FiniteOne.Cohomology} ((Restriction.At[n := one].induced).apply) _ _ representative)
      \parent.\parent.Comparison[].onU);
\definition onLoop[representative: ActualOne.classOf alpha = u]: coordinate Edge::loop = Binary.one :=
  trans!{Binary.Carrier} _ _ _ (sym!{Binary.Carrier} _ _ loopCoordinate)
    (trans!{Binary.Carrier} _ _ _
      (congr!{FiniteOne.Cohomology Binary.Carrier} (((\parent.\parent.Comparison[].coordinate).forward).apply) _ _ (restrictedClass representative))
      (trans!{Binary.Carrier} _ _ _
        (congr!{MatrixOne.Cohomology Binary.Carrier} ((FirstCoordinate.forward).apply) _ _ FiniteBockstein.binaryCompared)
        FirstCoordinate.generatorCoordinate));
\import CupRestriction.Classes[alpha := alpha, beta := alpha] \as RestrictedCup;
\definition triangles: Triangles.evaluate RestrictedCup.cycle = FiniteBinary.cup coordinate coordinate :=
  trans!{Triangles.FunctionCarrier} _ _ _
    (congr!{{Native.Carrier two} Triangles.FunctionCarrier} Triangles.evaluate _ _ RestrictedCup.representative)
    (Triangles.rightInverse (FiniteBinary.cup coordinate coordinate));
\definition topCoordinate: (TopCoordinate.forward).apply (((SecondComparison.isomorphism).forward).apply (FiniteTwo.classOf RestrictedCup.cycle)) = Matrix.total (Triangles.evaluate RestrictedCup.cycle) :=
  trans!{Binary.Carrier} _ _ _
    (congr!{MatrixTwo.Cohomology Binary.Carrier} ((TopCoordinate.forward).apply) _ _ (SecondComparison.onClass RestrictedCup.cycle))
    (TopDescent.onClass TopCoordinate.evaluate TopCoordinate.kills (SecondComparison.forwardValue RestrictedCup.cycle));
\import Modules.Hom[V := Theory.cohomology two, W := FiniteTwo.Cohomology, source := Theory.cohomologySpace two, target := FiniteTwo.cohomologySpace] \as RestrictionMaps;
\import Modules.Hom[V := FiniteTwo.Cohomology, W := MatrixTwo.Cohomology, source := FiniteTwo.cohomologySpace, target := MatrixTwo.cohomologySpace] \as SecondMaps;
\import Modules.Hom[V := MatrixTwo.Cohomology, W := Binary.Carrier, source := MatrixTwo.cohomologySpace, target := Binary.integerSpace] \as TotalMaps;
\definition nonzero[representative: ActualOne.classOf alpha = u][equal: Cup.apply (ActualOne.classOf alpha) (ActualOne.classOf alpha) = (Theory.cohomologySpace two).zero]: Logic.False :=
  Binary.nontrivial
    (trans!{Binary.Carrier} _ _ _
      (sym!{Binary.Carrier} _ _ (TotalMaps.zeroPreserved TopCoordinate.forward))
      (trans!{Binary.Carrier} _ _ _
        (congr!{MatrixTwo.Cohomology Binary.Carrier} ((TopCoordinate.forward).apply) _ _
          (sym!{MatrixTwo.Cohomology} _ _
            (trans!{MatrixTwo.Cohomology} _ _ _
              (congr!{FiniteTwo.Cohomology MatrixTwo.Cohomology} (((SecondComparison.isomorphism).forward).apply) _ _
                (trans!{FiniteTwo.Cohomology} _ _ _
                  (sym!{FiniteTwo.Cohomology} _ _ RestrictedCup.law)
                  (trans!{FiniteTwo.Cohomology} _ _ _
                    (congr!{{Theory.cohomology two} FiniteTwo.Cohomology} ((Restriction.At[n := two].induced).apply) _ _ equal)
                    (RestrictionMaps.zeroPreserved Restriction.At[n := two].induced))))
              (SecondMaps.zeroPreserved (SecondComparison.isomorphism).forward))))
        (trans!{Binary.Carrier} _ _ _ topCoordinate
          (trans!{Binary.Carrier} _ _ _ (congr!{Matrix.Triangles Binary.Carrier} Matrix.total _ _ triangles)
            (squareTotal coordinate (onLoop representative))))));
