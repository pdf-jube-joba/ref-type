\import \root.Two[] \as F;
\import \root.ProjectivePlane[].ModTwo[] \as Finite;
\import \parent.Cohomology[coefficients := Finite.coefficients] \as Actual;
\import \parent.Attachment[].Coefficients[coefficients := Finite.coefficients].Groups[] \as Groups;
\import singular_cohomology.Cochains[A := Carrier, source := topology].With[coefficients := Finite.coefficients] \as Theory;
\import singular_finite_algebra.Integer[].Attachment[coefficients := Finite.coefficients, first := Groups.first, second := Groups.second].On[data := Groups.data].CharacteristicTwo[] \as Calculation;
\definition doubleZero: Calculation.Vanishes := F.addSelf;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition degreeZero: Modules.Isomorphism[V := Theory.cohomology N.Nat^::zero, W := F.Carrier, source := Theory.cohomologySpace N.Nat^::zero, target := F.integerSpace].Isomorphism := Actual.DegreeZero[].isomorphism;
\import Modules.Isomorphism[V := F.Carrier, W := Groups.Kernel, source := F.integerSpace, target := Groups.kernelSpace].Inverse[] \as KernelInverse;
\import Modules.Isomorphism[V := Theory.cohomology one, W := Groups.Kernel, source := Theory.cohomologySpace one, target := Groups.kernelSpace].Composition[U := F.Carrier, final := F.integerSpace] \as First;
\definition degreeOne: Modules.Isomorphism[V := Theory.cohomology one, W := F.Carrier, source := Theory.cohomologySpace one, target := F.integerSpace].Isomorphism :=
  First.compose (KernelInverse.inverse (Calculation.kernelIsomorphism doubleZero)) Actual.DegreeOne[].isomorphism;
\import Modules.Isomorphism[V := Theory.cohomology two, W := Groups.Cokernel, source := Theory.cohomologySpace two, target := Groups.cokernelSpace].Composition[U := F.Carrier, final := F.integerSpace] \as Second;
\definition degreeTwo: Modules.Isomorphism[V := Theory.cohomology two, W := F.Carrier, source := Theory.cohomologySpace two, target := F.integerSpace].Isomorphism :=
  Second.compose (Calculation.cokernelIsomorphism doubleZero) Actual.DegreeTwo[].isomorphism;
\definition u: Theory.cohomology one := #apply{#backward{degreeOne}} F.one;
\definition v: Theory.cohomology two := #apply{#backward{degreeTwo}} F.one;
\definition onU: #apply{#forward{degreeOne}} u = F.one := #rightInverse{degreeOne} F.one;
\definition onV: #apply{#forward{degreeTwo}} v = F.one := #rightInverse{degreeTwo} F.one;
\import Modules.Hom[V := Theory.cohomology one, W := F.Carrier, source := Theory.cohomologySpace one, target := F.integerSpace] \as FirstMaps;
\import Modules.Hom[V := Theory.cohomology two, W := F.Carrier, source := Theory.cohomologySpace two, target := F.integerSpace] \as SecondMaps;
\definition uNonzero(equal: u = #zero{(Theory.cohomologySpace one)}): std.Logic[].Proposition[].False :=
  F.nontrivial (trans!{F.Carrier} _ _ _ (sym!{F.Carrier} _ _ (FirstMaps.zeroPreserved #forward{degreeOne}))
    (trans!{F.Carrier} _ _ _ (congr!{{Theory.cohomology one} F.Carrier} (#apply{#forward{degreeOne}}) _ _ (sym!{{Theory.cohomology one}} _ _ equal)) onU));
\definition vNonzero(equal: v = #zero{(Theory.cohomologySpace two)}): std.Logic[].Proposition[].False :=
  F.nontrivial (trans!{F.Carrier} _ _ _ (sym!{F.Carrier} _ _ (SecondMaps.zeroPreserved #forward{degreeTwo}))
    (trans!{F.Carrier} _ _ _ (congr!{{Theory.cohomology two} F.Carrier} (#apply{#forward{degreeTwo}}) _ _ (sym!{{Theory.cohomology two}} _ _ equal)) onV));
\module Higher(n: N.Nat^) {
  \definition law: _ := Actual.Higher[n := n].law;
}
\module Comparison;
