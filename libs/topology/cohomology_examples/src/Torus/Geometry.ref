\import std.Data[].Nat[] \as N;
\import std.Data[].Pair[] \as Pair;
\import algebraic_topology.Spheres[] \as Spheres;
\definition zero: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zero;
\definition two: N.Nat^ := N.Nat^::succ one;
\definition Circle: \Set := Spheres.Carrier one;
\definition circleTopology: topology.Topology[Carrier := Circle].Topology := Spheres.topology one;
\import topological_constructions.Product[A := Circle, B := Circle] \as Product;
\import Product.Maps[] \as Projections;
\definition Carrier: \Set := Product.CarrierSet;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Product.topology circleTopology circleTopology;
\definition first: Carrier -> Circle := Pair.first Circle Circle;
\definition second: Carrier -> Circle := Pair.second Circle Circle;
\definition firstContinuous: topology.Continuity[A := Carrier, B := Circle].Continuous topology circleTopology first := Projections.firstContinuous circleTopology circleTopology;
\definition secondContinuous: topology.Continuity[A := Carrier, B := Circle].Continuous topology circleTopology second := Projections.secondContinuous circleTopology circleTopology;
\definition flip[p: Carrier]: Carrier := Pair.pair Circle Circle (second p) (first p);
\import Product.Universal[X := Carrier] \as IntoProduct;
\definition flipContinuous: topology.Continuity[A := Carrier, B := Carrier].Continuous topology topology flip :=
  IntoProduct.pairContinuous topology circleTopology circleTopology second first secondContinuous firstContinuous;
\module Ring;
\module Comparison;
