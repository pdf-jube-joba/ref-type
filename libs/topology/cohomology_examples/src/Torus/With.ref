\import \root.Surface[V := Vertex, E := Edge, T := Triangle].On[surface := object].With[A := A] \as Surface;
\import Modules.Laws[V := A.Carrier, space := A.space] \as Values;
\import algebra.Group[].Of[Carrier := A.Carrier, group := Values.additive] \as Group;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\definition Edges: \Set := Edge -> A.Carrier;
\definition Triangles: \Set := Triangle -> A.Carrier;
\definition edge(a, b, c: A.Carrier): Edges := \induction (i: Edge) \return A.Carrier \with {
  | horizontal: a | vertical: b | diagonal: c
};
\definition triangle(p, q: A.Carrier): Triangles := \induction (i: Triangle) \return A.Carrier \with {
  | first: p | second: q
};
\definition edgesExt: \forall (f, g: Edges) -> f Edge::horizontal = g Edge::horizontal -> f Edge::vertical = g Edge::vertical -> f Edge::diagonal = g Edge::diagonal -> f = g :=
  \fun (f, g: Edges)(a: f Edge::horizontal = g Edge::horizontal)(b: f Edge::vertical = g Edge::vertical)(c: f Edge::diagonal = g Edge::diagonal) =>
    \axiom:funext(f, g, \induction (i: Edge) \return f i = g i \with { | horizontal: a | vertical: b | diagonal: c });
\definition trianglesExt: \forall (f, g: Triangles) -> f Triangle::first = g Triangle::first -> f Triangle::second = g Triangle::second -> f = g :=
  \fun (f, g: Triangles)(p: f Triangle::first = g Triangle::first)(q: f Triangle::second = g Triangle::second) =>
    \axiom:funext(f, g, \induction (i: Triangle) \return f i = g i \with { | first: p | second: q });
\definition deltaZero: (Vertex -> A.Carrier) -> Edges := Surface.deltaZero;
\definition deltaOne: Edges -> Triangles := Surface.deltaOne;
\definition zeroDifferential(f: Vertex -> A.Carrier): deltaZero f = edge Group.zero Group.zero Group.zero :=
  edgesExt _ _ (Group.inverseRight (f Vertex::point)) (Group.inverseRight (f Vertex::point)) (Group.inverseRight (f Vertex::point));
\definition cocycle(a, b: A.Carrier): Edges := edge a b (Group.add a b);
\definition firstBoundary(f: Edges): deltaOne f Triangle::first = Group.difference (Group.add (f Edge::horizontal) (f Edge::vertical)) (f Edge::diagonal) :=
  trans!{A.Carrier} _ _ _
    (Group.swapLast (f Edge::vertical) (Group.neg (f Edge::diagonal)) (f Edge::horizontal))
    (congr!{A.Carrier A.Carrier} (\fun (x: A.Carrier) => Group.add x (Group.neg (f Edge::diagonal))) _ _ (Group.comm (f Edge::vertical) (f Edge::horizontal)));
\definition secondBoundary(f: Edges): deltaOne f Triangle::second = Group.difference (Group.add (f Edge::horizontal) (f Edge::vertical)) (f Edge::diagonal) :=
  Group.swapLast (f Edge::horizontal) (Group.neg (f Edge::diagonal)) (f Edge::vertical);
\definition cocycleClosed(a, b: A.Carrier): deltaOne (cocycle a b) = triangle Group.zero Group.zero :=
  trianglesExt _ _
    (trans!{A.Carrier} _ _ _ (firstBoundary (cocycle a b)) (Group.inverseRight (Group.add a b)))
    (trans!{A.Carrier} _ _ _ (secondBoundary (cocycle a b)) (Group.inverseRight (Group.add a b)));
\definition total(f: Triangles): A.Carrier := Group.difference (f Triangle::first) (f Triangle::second);
\definition totalBoundary(f: Edges): total (deltaOne f) = Group.zero :=
  trans!{A.Carrier} _ _ _
    (congr2!{A.Carrier A.Carrier A.Carrier} Group.difference _ _ _ _ (firstBoundary f) (secondBoundary f))
    (Group.inverseRight (Group.difference (Group.add (f Edge::horizontal) (f Edge::vertical)) (f Edge::diagonal)));

\definition closedDiagonal(f: Edges)(closed: deltaOne f = triangle Group.zero Group.zero): f Edge::diagonal = Group.add (f Edge::horizontal) (f Edge::vertical) :=
  sym!{A.Carrier} _ _
    (Group.cancelRight (Group.neg (f Edge::diagonal)) (Group.add (f Edge::horizontal) (f Edge::vertical)) (f Edge::diagonal)
      (trans!{A.Carrier} _ _ _
        (trans!{A.Carrier} _ _ _ (sym!{A.Carrier} _ _ (firstBoundary f))
          (congr!{Triangles A.Carrier} (\fun (x: Triangles) => x Triangle::first) _ _ closed))
        (sym!{A.Carrier} _ _ (Group.inverseRight (f Edge::diagonal)))));
\definition normal(f: Triangles): Triangles := triangle (total f) Group.zero;
\definition diagonalBoundary(x: A.Carrier): deltaOne (edge x Group.zero Group.zero) = triangle x x :=
  trianglesExt _ _
    (trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (\fun (z: A.Carrier) => Group.add z x) _ _ (Group.inverseRight Group.zero)) (Group.zeroLeft x))
    (trans!{A.Carrier} _ _ _ (Group.zeroRight (Group.difference x Group.zero))
      (trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (Group.add x) _ _ Group.negZero) (Group.zeroRight x)));
\definition boundaryDifference(f: Triangles): deltaOne (edge (f Triangle::second) Group.zero Group.zero) =
  \fun (t: Triangle) => Group.difference (f t) (normal f t) :=
  trans!{Triangles} _ _ _ (diagonalBoundary (f Triangle::second))
    (trianglesExt _ _ (sym!{A.Carrier} _ _ (Group.subtractDifference (f Triangle::first) (f Triangle::second)))
      (sym!{A.Carrier} _ _ (trans!{A.Carrier} _ _ _ (congr!{A.Carrier A.Carrier} (Group.add (f Triangle::second)) _ _ Group.negZero) (Group.zeroRight (f Triangle::second)))));
\module Cohomology;
