\import Modules.Hom[V := H0.CycleCarrier, W := A.Carrier, source := H0.cycleSpace, target := A.space] \as Evaluation;
\definition evaluate: Evaluation.Map := Evaluation.Map {
  apply := \fun (f: H0.CycleCarrier) => f Vertex::point,
  addition := \fun (f, g: H0.CycleCarrier) => \refl(Group.add (f Vertex::point) (g Vertex::point)),
  scalar := \fun (a: I.Int^)(f: H0.CycleCarrier) => \refl(Values.scale a (f Vertex::point)),
};
\definition constant(x: A.Carrier): Vertex -> A.Carrier := \fun (v: Vertex) => x;
\definition constantClosed(x: A.Carrier): deltaZero (constant x) = edge Group.zero Group.zero Group.zero := zeroDifferential (constant x);
\import Modules.Hom[V := A.Carrier, W := H0.CycleCarrier, source := A.space, target := H0.cycleSpace] \as Inclusion;
\definition include: Inclusion.Map := Inclusion.Map {
  apply := \fun (x: A.Carrier) => H0.cycle (constant x) (constantClosed x),
  addition := \fun (x, y: A.Carrier) => \refl(\fun (v: Vertex) => Group.add x y),
  scalar := \fun (a: I.Int^)(x: A.Carrier) => \refl(\fun (v: Vertex) => Values.scale a x),
};
\import Modules.Isomorphism[V := H0.CycleCarrier, W := A.Carrier, source := H0.cycleSpace, target := A.space] \as Iso;
\definition kernelIso: Iso.Isomorphism := Iso.Isomorphism {
  forward := evaluate, backward := include,
  leftInverse := \fun (f: H0.CycleCarrier) => \axiom:funext((#apply{include} (#apply{evaluate} f)), f,
    \induction (v: Vertex) \return f Vertex::point = f v \with { | point: \refl(f Vertex::point) }),
  rightInverse := \fun (x: A.Carrier) => \refl(x),
};
\import Complex.DegreeZero[] \as DegreeZero;
\import Modules.Isomorphism[V := H0.CycleCarrier, W := H0.Cohomology, source := H0.cycleSpace, target := H0.cohomologySpace].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := H0.Cohomology, W := H0.CycleCarrier, source := H0.cohomologySpace, target := H0.cycleSpace].Composition[U := A.Carrier, final := A.space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := H0.Cohomology, W := A.Carrier, source := H0.cohomologySpace, target := A.space].Isomorphism :=
  Composition.compose kernelIso (Inverse.inverse DegreeZero.kernelIso);
