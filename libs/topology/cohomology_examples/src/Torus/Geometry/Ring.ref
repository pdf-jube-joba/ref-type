\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as IntegerModules;
\import singular_products.Cochains[A := Carrier, source := topology, R := I.Int^, ring := Integers.commutativeRing] \as Products;
\import Products.Cohomology[] \as Cohomology;
\import singular_products.Cochains[A := Circle, source := circleTopology, R := I.Int^, ring := Integers.commutativeRing] \as CircleProducts;
\import CircleProducts.Cohomology[] \as CircleCohomology;
\import cohomology_models.Spheres[].With[coefficients := CircleProducts.integerCoefficients] \as CircleGroups;
\import CircleGroups.Top[n := zero] \as CircleTop;
\definition generator: CircleCohomology.Group one := ((CircleTop.isomorphism).forward).apply I.One.specification;
\import Cohomology.Pullback[B := Circle, target := circleTopology] \as Projection;
\definition a: Cohomology.Group one := Projection.apply one first firstContinuous generator;
\definition b: Cohomology.Group one := Projection.apply one second secondContinuous generator;
\import Cohomology.Cup[p := one, q := one] \as Cup;
\import CircleCohomology.Cup[p := one, q := one] \as CircleCup;
\definition orientation: Cohomology.Group two := Cup.apply a b;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition circleSquare: CircleCup.apply generator generator = (CircleCohomology.moduleSpace two).zero := CircleGroups.above one zero (CircleCup.apply generator generator);
\import Products.Cohomology[].Pullback[B := Circle, target := circleTopology].Cup[p := one, q := one] \as NaturalCup;
\import module_theory.Module[].Over[R := I.Int^, ring := std.Alg[].Ring[].commutativeRingAsRing I.Int^ Integers.commutativeRing] \as Modules;
\import Modules.Hom[V := CircleCohomology.Group two, W := Cohomology.Group two,
  source := CircleCohomology.moduleSpace two, target := Cohomology.moduleSpace two] \as Maps;
\definition square[f: Carrier -> Circle][continuous: topology.Continuity[A := Carrier, B := Circle].Continuous topology circleTopology f]:
  Cup.apply (Projection.apply one f continuous generator) (Projection.apply one f continuous generator) = (Cohomology.moduleSpace two).zero :=
  trans!{{Cohomology.Group two}} _ _ _ (sym!{{Cohomology.Group two}} _ _ (NaturalCup.law f continuous generator generator))
    (trans!{{Cohomology.Group two}} _ _ _
      (congr!{{CircleCohomology.Group two} {Cohomology.Group two}} (Projection.apply two f continuous) _ _ circleSquare)
      (Maps.zeroPreserved (Projection.At[n := two].linear f continuous)));
\definition firstSquare: Cup.apply a a = (Cohomology.moduleSpace two).zero := square first firstContinuous;
\definition secondSquare: Cup.apply b b = (Cohomology.moduleSpace two).zero := square second secondContinuous;
\import singular_symmetry.Cochains[A := Carrier, source := topology, R := I.Int^, ring := Integers.commutativeRing].GradedCommutativity[p := one, q := one] \as Symmetry;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition skewCommutativity: Cup.apply b a = (Cohomology.moduleSpace two).neg orientation :=
  trans!{{Cohomology.Group two}} _ _ _ (Symmetry.law b a)
    (congr!{{Cohomology.Group two} {Cohomology.Group two}} ((Cohomology.moduleSpace two).neg) _ _ (Transport.castRefl Cohomology.Group two orientation));
\module Flip;
\module Primitive;
\module Basis;
\module UnitBasis;
