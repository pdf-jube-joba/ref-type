\definition index: N.Nat^ := N.Nat^::succ (N.Nat^::succ p);
\import FiniteTensor.Term[p := index, q := q] \as Term;
\import Modules.End[V := Term.Carrier, space := Term.space] \as End;
\import Modules.Hom[V := Term.Carrier, W := Term.Carrier, source := Term.space, target := Term.space] \as Maps;
\import Modules.Tensor[V := FiniteCircle.complex.family.Carrier index, W := FiniteCircle.complex.family.Carrier q,
  left := FiniteCircle.complex.family.space index, right := FiniteCircle.complex.family.space q].Universal[U := Term.Carrier, target := Term.space] \as Universal;
\definition equality: End.identity = Maps.zeroMap := Universal.ext End.identity Maps.zeroMap
  (\fun (x: FiniteCircle.complex.family.Carrier index)(y: FiniteCircle.complex.family.Carrier q) =>
    trans!{Term.Carrier} _ _ _ (congr!{(FiniteCircle.complex.family.Carrier index) Term.Carrier} (\fun (v: FiniteCircle.complex.family.Carrier index) => Term.tensor v y) _ _ (empty p x)) (Term.zeroLeft y));
\definition law(x: Term.Carrier): x = #zero{Term.space} := congr!{Maps.Map Term.Carrier} (\fun (f: Maps.Map) => #apply{f} x) _ _ equality;
