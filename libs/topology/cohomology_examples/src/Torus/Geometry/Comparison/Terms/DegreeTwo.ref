\import FiniteTotal.Degree[n := two] \as Total;
\import FiniteTensor.Term[p := one, q := one] \as Term;
\import Modules.DirectSum[Index := Doubles.Index two, family := Total.family].Single[point := i11] \as Single;
\definition trivial: Single.OtherTrivial := twoCases
  (\fun (i: Doubles.Index two) => Logic.Not (i = i11) -> \forall (x: Total.family.Carrier i) -> x = (Total.family.space i).zero)
  (\fun (different: Logic.Not (i02 = i11)) => \parent.RightZero[p := zero, q := zero].law)
  (\fun (different: Logic.Not (i11 = i11))(x: Term.Carrier) => Logic.falseElim (x = (Term.space).zero) (different (\refl(i11))))
  (\fun (different: Logic.Not (i20 = i11)) => \parent.LeftZero[p := zero, q := zero].law);
\import Modules.Isomorphism[V := Total.Carrier, W := Term.Carrier, source := Total.space, target := Term.space].Composition[U := I.Int^, final := Modules.scalarModule] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Total.Carrier, W := I.Int^, source := Total.space, target := Modules.scalarModule].Isomorphism :=
  Composition.compose TensorScalars.isomorphism (Single.isomorphism trivial);
\definition unit: Total.Carrier := ((isomorphism).backward).apply I.One.specification;
\definition onUnit: ((isomorphism).forward).apply unit = I.One.specification := (isomorphism).rightInverse I.One.specification;
