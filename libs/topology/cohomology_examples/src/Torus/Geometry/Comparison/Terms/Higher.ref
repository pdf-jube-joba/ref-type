\definition index: N.Nat^ := N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n));
\definition zeroImpossible(equal: zero = index): Logic.False := Natural.zeroNeSucc (N.Nat^::succ (N.Nat^::succ n)) equal;
\definition oneImpossible(equal: one = index): Logic.False := Natural.zeroNeSucc (N.Nat^::succ n) (Natural.succInjective zero (N.Nat^::succ (N.Nat^::succ n)) equal);
\definition twoImpossible(equal: two = index): Logic.False := Natural.zeroNeSucc n
  (Natural.succInjective zero (N.Nat^::succ n) (Natural.succInjective one (N.Nat^::succ (N.Nat^::succ n)) equal));
\definition zeroRow: \forall (q: N.Nat^) -> NaturalArithmetic.add zero q = index -> \forall (x: FiniteTensor.Carrier zero q) -> x = #zero{(FiniteTensor.space zero q)} :=
  \induction (q: N.Nat^) \return NaturalArithmetic.add zero q = index -> \forall (x: FiniteTensor.Carrier zero q) -> x = #zero{(FiniteTensor.space zero q)} \with {
    | zero: \fun (equal: zero = index)(x: FiniteTensor.Carrier zero zero) => Logic.falseElim (x = #zero{(FiniteTensor.space zero zero)}) (zeroImpossible equal)
    | succ: \fun (q: N.Nat^)(previous: _) =>
      (\induction (q: N.Nat^) \return NaturalArithmetic.add zero (N.Nat^::succ q) = index -> \forall (x: FiniteTensor.Carrier zero (N.Nat^::succ q)) -> x = #zero{(FiniteTensor.space zero (N.Nat^::succ q))} \with {
        | zero: \fun (equal: one = index)(x: FiniteTensor.Carrier zero one) => Logic.falseElim (x = #zero{(FiniteTensor.space zero one)}) (oneImpossible equal)
        | succ: \fun (q: N.Nat^)(previous: _)(equal: _) => \parent.RightZero[p := zero, q := q].law
      }) q
  };
\definition oneRow: \forall (q: N.Nat^) -> NaturalArithmetic.add one q = index -> \forall (x: FiniteTensor.Carrier one q) -> x = #zero{(FiniteTensor.space one q)} :=
  \induction (q: N.Nat^) \return NaturalArithmetic.add one q = index -> \forall (x: FiniteTensor.Carrier one q) -> x = #zero{(FiniteTensor.space one q)} \with {
    | zero: \fun (equal: one = index)(x: FiniteTensor.Carrier one zero) => Logic.falseElim (x = #zero{(FiniteTensor.space one zero)}) (oneImpossible equal)
    | succ: \fun (q: N.Nat^)(previous: _) =>
      (\induction (q: N.Nat^) \return NaturalArithmetic.add one (N.Nat^::succ q) = index -> \forall (x: FiniteTensor.Carrier one (N.Nat^::succ q)) -> x = #zero{(FiniteTensor.space one (N.Nat^::succ q))} \with {
        | zero: \fun (equal: two = index)(x: FiniteTensor.Carrier one one) => Logic.falseElim (x = #zero{(FiniteTensor.space one one)}) (twoImpossible equal)
        | succ: \fun (q: N.Nat^)(previous: _)(equal: _) => \parent.RightZero[p := one, q := q].law
      }) q
  };
\definition tensor: \forall (p, q: N.Nat^) -> NaturalArithmetic.add p q = index -> \forall (x: FiniteTensor.Carrier p q) -> x = #zero{(FiniteTensor.space p q)} :=
  \induction (p: N.Nat^) \return \forall (q: N.Nat^) -> NaturalArithmetic.add p q = index -> \forall (x: FiniteTensor.Carrier p q) -> x = #zero{(FiniteTensor.space p q)} \with {
    | zero: zeroRow
    | succ: \fun (p: N.Nat^)(previous: _) =>
      (\induction (p: N.Nat^) \return \forall (q: N.Nat^) -> NaturalArithmetic.add (N.Nat^::succ p) q = index -> \forall (x: FiniteTensor.Carrier (N.Nat^::succ p) q) -> x = #zero{(FiniteTensor.space (N.Nat^::succ p) q)} \with {
        | zero: oneRow
        | succ: \fun (p: N.Nat^)(previous: _)(q: N.Nat^)(equal: _) => \parent.LeftZero[p := p, q := q].law
      }) p
  };
\definition law(x: FiniteTotal.Carrier index): x = #zero{(FiniteTotal.space index)} := Coordinates.Degree[n := index].zero x
  (\fun (i: Doubles.Index index) => tensor #first{i} #second{i} (Doubles.degree index i) (Coordinates.Degree[n := index].coordinate i x));
