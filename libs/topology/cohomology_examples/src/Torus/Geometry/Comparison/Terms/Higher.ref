\definition index: N.Nat^ := N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n));
\definition zeroImpossible[equal: zero = index]: Logic.False := Natural.zeroNeSucc (N.Nat^::succ (N.Nat^::succ n)) equal;
\definition oneImpossible[equal: one = index]: Logic.False := Natural.zeroNeSucc (N.Nat^::succ n) (Natural.succInjective zero (N.Nat^::succ (N.Nat^::succ n)) equal);
\definition twoImpossible[equal: two = index]: Logic.False := Natural.zeroNeSucc n
  (Natural.succInjective zero (N.Nat^::succ n) (Natural.succInjective one (N.Nat^::succ (N.Nat^::succ n)) equal));
\definition zeroRow: \forall (q: N.Nat^) -> NaturalArithmetic.add zero q = index -> \forall (x: FiniteTensor.Carrier zero q) -> x = (FiniteTensor.space zero q).zero :=
  \induction (q: N.Nat^) \return NaturalArithmetic.add zero q = index -> \forall (x: FiniteTensor.Carrier zero q) -> x = (FiniteTensor.space zero q).zero \with {
    | zero: \fun (equal: zero = index)(x: FiniteTensor.Carrier zero zero) => Logic.falseElim (x = (FiniteTensor.space zero zero).zero) (zeroImpossible equal)
    | succ: \fun (q: N.Nat^)(previous: NaturalArithmetic.add zero q = index -> \forall (x: FiniteTensor.Carrier zero q) -> x = (FiniteTensor.space zero q).zero) =>
      (\induction (q: N.Nat^) \return NaturalArithmetic.add zero (N.Nat^::succ q) = index -> \forall (x: FiniteTensor.Carrier zero (N.Nat^::succ q)) -> x = (FiniteTensor.space zero (N.Nat^::succ q)).zero \with {
        | zero: \fun (equal: one = index)(x: FiniteTensor.Carrier zero one) => Logic.falseElim (x = (FiniteTensor.space zero one).zero) (oneImpossible equal)
        | succ: \fun (q: N.Nat^)(previous: NaturalArithmetic.add zero (N.Nat^::succ q) = index -> \forall (x: FiniteTensor.Carrier zero (N.Nat^::succ q)) -> x = (FiniteTensor.space zero (N.Nat^::succ q)).zero)(equal: NaturalArithmetic.add zero (N.Nat^::succ (N.Nat^::succ q)) = index) => \parent.RightZero[p := zero, q := q].law
      }) q
  };
\definition oneRow: \forall (q: N.Nat^) -> NaturalArithmetic.add one q = index -> \forall (x: FiniteTensor.Carrier one q) -> x = (FiniteTensor.space one q).zero :=
  \induction (q: N.Nat^) \return NaturalArithmetic.add one q = index -> \forall (x: FiniteTensor.Carrier one q) -> x = (FiniteTensor.space one q).zero \with {
    | zero: \fun (equal: one = index)(x: FiniteTensor.Carrier one zero) => Logic.falseElim (x = (FiniteTensor.space one zero).zero) (oneImpossible equal)
    | succ: \fun (q: N.Nat^)(previous: NaturalArithmetic.add one q = index -> \forall (x: FiniteTensor.Carrier one q) -> x = (FiniteTensor.space one q).zero) =>
      (\induction (q: N.Nat^) \return NaturalArithmetic.add one (N.Nat^::succ q) = index -> \forall (x: FiniteTensor.Carrier one (N.Nat^::succ q)) -> x = (FiniteTensor.space one (N.Nat^::succ q)).zero \with {
        | zero: \fun (equal: two = index)(x: FiniteTensor.Carrier one one) => Logic.falseElim (x = (FiniteTensor.space one one).zero) (twoImpossible equal)
        | succ: \fun (q: N.Nat^)(previous: NaturalArithmetic.add one (N.Nat^::succ q) = index -> \forall (x: FiniteTensor.Carrier one (N.Nat^::succ q)) -> x = (FiniteTensor.space one (N.Nat^::succ q)).zero)(equal: NaturalArithmetic.add one (N.Nat^::succ (N.Nat^::succ q)) = index) => \parent.RightZero[p := one, q := q].law
      }) q
  };
\definition tensor: \forall (p, q: N.Nat^) -> NaturalArithmetic.add p q = index -> \forall (x: FiniteTensor.Carrier p q) -> x = (FiniteTensor.space p q).zero :=
  \induction (p: N.Nat^) \return \forall (q: N.Nat^) -> NaturalArithmetic.add p q = index -> \forall (x: FiniteTensor.Carrier p q) -> x = (FiniteTensor.space p q).zero \with {
    | zero: zeroRow
    | succ: \fun (p: N.Nat^)(previous: \forall (q: N.Nat^) -> NaturalArithmetic.add p q = index -> \forall (x: FiniteTensor.Carrier p q) -> x = (FiniteTensor.space p q).zero) =>
      (\induction (p: N.Nat^) \return \forall (q: N.Nat^) -> NaturalArithmetic.add (N.Nat^::succ p) q = index -> \forall (x: FiniteTensor.Carrier (N.Nat^::succ p) q) -> x = (FiniteTensor.space (N.Nat^::succ p) q).zero \with {
        | zero: oneRow
        | succ: \fun (p: N.Nat^)(previous: \forall (q: N.Nat^) -> NaturalArithmetic.add (N.Nat^::succ p) q = index -> \forall (x: FiniteTensor.Carrier (N.Nat^::succ p) q) -> x = (FiniteTensor.space (N.Nat^::succ p) q).zero)(q: N.Nat^)(equal: NaturalArithmetic.add (N.Nat^::succ (N.Nat^::succ p)) q = index) => \parent.LeftZero[p := p, q := q].law
      }) p
  };
\definition law[x: FiniteTotal.Carrier index]: x = (FiniteTotal.space index).zero := Coordinates.Degree[n := index].zero x
  (\fun (i: Doubles.Index index) => tensor (i).first (i).second (Doubles.degree index i) (Coordinates.Degree[n := index].coordinate i x));
