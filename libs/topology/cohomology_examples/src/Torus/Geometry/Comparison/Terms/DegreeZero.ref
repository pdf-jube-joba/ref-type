\import FiniteTotal.Degree[n := zero] \as Total;
\import FiniteTensor.Term[p := zero, q := zero] \as Term;
\import Modules.DirectSum[Index := Doubles.Index zero, family := Total.family].Single[point := i00] \as Single;
\definition trivial: Single.OtherTrivial := \fun (i: Doubles.Index zero)(different: Logic.Not (i = i00))(x: Total.family.Carrier i) =>
  Logic.falseElim (x = #zero{(Total.family.space i)}) (different (singleton i));
\import Modules.Isomorphism[V := Total.Carrier, W := Term.Carrier, source := Total.space, target := Term.space].Composition[U := I.Int^, final := Modules.scalarModule] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Total.Carrier, W := I.Int^, source := Total.space, target := Modules.scalarModule].Isomorphism :=
  Composition.compose TensorScalars.isomorphism (Single.isomorphism trivial);
\definition unit: Total.Carrier := #apply{#backward{isomorphism}} I.One.specification;
\definition onUnit: #apply{#forward{isomorphism}} unit = I.One.specification := #rightInverse{isomorphism} I.One.specification;
