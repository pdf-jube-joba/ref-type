\definition index: N.Nat^ := N.Nat^::succ (N.Nat^::succ q);
\import FiniteTensor.Term[p := p, q := index] \as Term;
\import Modules.End[V := Term.Carrier, space := Term.space] \as End;
\import Modules.Hom[V := Term.Carrier, W := Term.Carrier, source := Term.space, target := Term.space] \as Maps;
\import Modules.Tensor[V := FiniteCircle.complex.family.Carrier p, W := FiniteCircle.complex.family.Carrier index,
  left := FiniteCircle.complex.family.space p, right := FiniteCircle.complex.family.space index].Universal[U := Term.Carrier, target := Term.space] \as Universal;
\definition equality: End.identity = Maps.zeroMap := Universal.ext End.identity Maps.zeroMap
  (\fun (x: FiniteCircle.complex.family.Carrier p)(y: FiniteCircle.complex.family.Carrier index) =>
    trans!{Term.Carrier} _ _ _ (congr!{{FiniteCircle.complex.family.Carrier index} Term.Carrier} (Term.tensor x) _ _ (empty q y)) (Term.zeroRight x));
\definition law[x: Term.Carrier]: x = (Term.space).zero := congr!{Maps.Map Term.Carrier} (\fun (f: Maps.Map) => (f).apply x) _ _ equality;
