\module At(i: Doubles.Index n) {
  \import TensorDegree[p := #first{i}, q := #second{i}] \as Tensor;
  \import FiniteTensor.Term[p := #first{i}, q := #second{i}] \as Term;
  \import Modules.Laws[V := Term.Carrier, space := Term.space] \as Values;
  \import algebra.Group[].Of[Carrier := Term.Carrier, group := Values.additive] \as Group;
  \import Doubles.Sign[V := Term.Carrier, space := Term.space] \as Sign;
  \import Modules.Hom[V := Term.Carrier, W := Term.Carrier, source := Term.space, target := Term.space] \as Maps;
  \definition law(x: FiniteTotal.Carrier (N.Nat^::succ n)):
    Coordinates.Degree[n := n].coordinate i (#apply{FiniteTotal.differential} n x) = #zero{Term.space} :=
    trans!{Term.Carrier} _ _ _ (Coordinates.StepAt[n := n, i := i].differential x)
      (trans!{Term.Carrier} _ _ _
        (congr2!{Term.Carrier Term.Carrier Term.Carrier} Values.add _ _ _ _
          (Tensor.horizontal (Coordinates.Degree[n := N.Nat^::succ n].coordinate (Coordinates.raiseHorizontalIndex n i) x))
          (trans!{Term.Carrier} _ _ _
            (congr!{Term.Carrier Term.Carrier} (#apply{(Sign.map #first{i})}) _ _
              (Tensor.vertical (Coordinates.Degree[n := N.Nat^::succ n].coordinate (Coordinates.raiseVerticalIndex n i) x)))
            (Maps.zeroPreserved (Sign.map #first{i}))))
        (Group.zeroLeft Values.zero));
}
\definition law(x: FiniteTotal.Carrier (N.Nat^::succ n)): #apply{FiniteTotal.differential} n x = #zero{(FiniteTotal.space n)} :=
  Coordinates.Degree[n := n].zero (#apply{FiniteTotal.differential} n x) (\fun (i: Doubles.Index n) => At[i := i].law x);
