\import \root.Circle[] \as CircleModel;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\module TensorDegree(p, q: N.Nat^);
\import Doubles.Coordinates[C := FiniteTensor.complex] \as Coordinates;
\module Degree(n: N.Nat^);
\definition law: \forall (n: N.Nat^)(x: model.family.Carrier (N.Nat^::succ n)) -> #apply{model.differential} n x = #zero{(model.family.space n)} :=
  \fun (n: N.Nat^) => Degree[n := n].law;
