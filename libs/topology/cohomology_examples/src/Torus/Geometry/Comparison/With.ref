\import CircleComparison.With[e := circle] \as CircleEquivalent;
\import Algebra.TensorEquivalence[C := FiniteCircle.complex, D := SingularCircle.complex,
  E := FiniteCircle.complex, F := SingularCircle.complex, left := CircleEquivalent.equivalence, right := CircleEquivalent.equivalence] \as Tensor;
\import Chains.Equivalence[C := model, D := SingularTotal.complex].Composition[E := ProductChains.complex] \as Composition;
\definition equivalence: Equivalences.Equivalence := Composition.compose Tensor.value (Reverse.apply EilenbergZilber.equivalence);
