\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\definition index: N.Nat^ := N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n));
\import \root.Torus[].Geometry[].Comparison[].Terms[].Higher[n := n] \as HighTerms;
\import Cochains.At[C := Model.complex, k := index] \as Finite;
\import Cochains.At[C := Actual.complex, k := index] \as Infinite;
\import Modules.Hom[V := model.family.Carrier index, W := M.Carrier, source := model.family.space index, target := M.space] \as Values;
\definition cochainZero(phi: Model.Carrier index): phi = #zero{(Model.space index)} := Values.ext phi #zero{(Model.space index)}
  (\fun (x: model.family.Carrier index) => trans!{M.Carrier} _ _ _
    (congr!{{model.family.Carrier index} M.Carrier} (#apply{phi}) _ _ (HighTerms.law x)) (Values.zeroPreserved phi));
\definition finiteZero: \forall (h: Finite.Cohomology) -> h = Finite.zeroClass := Finite.classInduction (\fun (h: Finite.Cohomology) => h = Finite.zeroClass)
  (\fun (phi: Finite.CycleCarrier) => Finite.equalClass phi #zero{Finite.cycleSpace} (cochainZero phi));
\import Modules.Isomorphism[V := Finite.Cohomology, W := Infinite.Cohomology, source := Finite.cohomologySpace, target := Infinite.cohomologySpace].Vanishing[] \as Vanishing;
\definition law(h: Infinite.Cohomology): h = #zero{Infinite.cohomologySpace} := \block {
  \takefrom e: Degree[n := index].Comparison \by Degree[n := index].existence \then
  \return Vanishing.targetZero e finiteZero h
};
