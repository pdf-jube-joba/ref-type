\import Hom.On[P := model, N := M] \as Model;
\import singular_cohomology.Cochains[A := Carrier, source := topology].With[coefficients := M] \as Actual;
\import Hom.Equivalence[P := model, Q := Singular.complex, N := M] \as Transport;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\module Degree(n: N.Nat^) {
  \import Cochains.At[C := Model.complex, k := n] \as Finite;
  \import Cochains.At[C := Actual.complex, k := n] \as Infinite;
  \import Modules.Isomorphism[V := Finite.Cohomology, W := Infinite.Cohomology, source := Finite.cohomologySpace, target := Infinite.cohomologySpace] \as Compared;
  \definition Comparison: \Set := Compared.Isomorphism;
  \definition existence: \exists Comparison := \block {
    \takefrom e: Equivalences.Equivalence \by \root.Torus[].Geometry[].Comparison[].existence \then
    \return \exact(Transport.At[k := n].isomorphism e, Comparison)
  };
}
