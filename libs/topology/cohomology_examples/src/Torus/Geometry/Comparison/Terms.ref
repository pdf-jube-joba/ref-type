\import std.Data[].FinSet[] \as Fin;
\import N.Basic[].Def[] \as NaturalArithmetic;
\import N.Basic[].Prop[] \as Natural;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\import Doubles.Coordinates[C := FiniteTensor.complex] \as Coordinates;
\import \root.Circle[].Homology[].Unit[].Tensor[] \as TensorScalars;
\definition i00: Doubles.Index zero := Coordinates.diagonal zero zero zero (\refl(zero));
\definition i01: Doubles.Index one := Coordinates.diagonal one zero one (\refl(one));
\definition i10: Doubles.Index one := Coordinates.diagonal one one zero (\refl(one));
\definition i02: Doubles.Index two := Coordinates.diagonal two zero two (\refl(two));
\definition i11: Doubles.Index two := Coordinates.diagonal two one one (\refl(two));
\definition i20: Doubles.Index two := Coordinates.diagonal two two zero (\refl(two));
\definition singleton(i: Doubles.Index zero): i = i00 :=
  trans!{{Doubles.Index zero}} _ _ _ (sym!{{Doubles.Index zero}} _ _ (Doubles.finiteIndexLeftInverse zero i))
    (congr!{{Fin.Fin one} {Doubles.Index zero}} (Doubles.fromFinite zero) _ _ (Fin.singletonValue (Doubles.finiteIndex zero i)));
\definition oneCases(P: Doubles.Index one -> \Prop)(first: P i01)(last: P i10)(i: Doubles.Index one): P i :=
  \idelim Doubles.fromFinite one (Doubles.finiteIndex one i) = i \with j: Doubles.Index one => P j \by {
    base: Fin.cases one (\fun (j: Fin.Fin two) => P (Doubles.fromFinite one j)) first
      (\fun (j: Fin.Fin one) => \idelim Fin.zero zero = j \with k: Fin.Fin one => P (Doubles.fromFinite one (Fin.succ one k))
        \by { base: last, equality: sym!{{Fin.Fin one}} _ _ (Fin.singletonValue j) }) (Doubles.finiteIndex one i),
    equality: Doubles.finiteIndexLeftInverse one i
  };
\definition twoCases(P: Doubles.Index two -> \Prop)(first: P i02)(middle: P i11)(last: P i20)(i: Doubles.Index two): P i :=
  \idelim Doubles.fromFinite two (Doubles.finiteIndex two i) = i \with j: Doubles.Index two => P j \by {
    base: Fin.cases two (\fun (j: Fin.Fin (N.Nat^::succ two)) => P (Doubles.fromFinite two j)) first
      (Fin.cases one (\fun (j: Fin.Fin two) => P (Doubles.fromFinite two (Fin.succ two j))) middle
        (\fun (j: Fin.Fin one) => \idelim Fin.zero zero = j \with k: Fin.Fin one => P (Doubles.fromFinite two (Fin.succ two (Fin.succ one k)))
          \by { base: last, equality: sym!{{Fin.Fin one}} _ _ (Fin.singletonValue j) })) (Doubles.finiteIndex two i),
    equality: Doubles.finiteIndexLeftInverse two i
  };
\definition empty(n: N.Nat^)(v: FiniteCircle.complex.family.Carrier (N.Nat^::succ (N.Nat^::succ n))): v = #zero{(FiniteCircle.complex.family.space (N.Nat^::succ (N.Nat^::succ n)))} :=
  \axiom:funext(v, #zero{(FiniteCircle.complex.family.space (N.Nat^::succ (N.Nat^::succ n)))}, \fun (i: Fin.Fin zero) => Logic.falseElim
    (v i = #zero{Integers.ring}) (Fin.zeroImpossible i (Fin.bound zero i)));
\module LeftZero(p, q: N.Nat^);
\module RightZero(p, q: N.Nat^);
\module DegreeZero;
\module DegreeTwo;
\module DegreeOne;
\module Higher(n: N.Nat^);
