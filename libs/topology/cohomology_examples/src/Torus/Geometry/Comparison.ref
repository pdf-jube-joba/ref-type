\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import \root.Circle[].Geometry[] \as CircleGeometry;
\import CircleGeometry.FiniteComparison[] \as CircleComparison;
\import singular_cech.Algebra[R := I.Int^, ring := Integers.ring] \as Algebra;
\import Algebra.Restriction[C := \root.Circle[].chain] \as FiniteCircle;
\import singular_cohomology.Chains[A := Circle, source := circleTopology] \as SingularCircle;
\import singular_cohomology.Chains[A := Carrier, source := topology] \as Singular;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Doubles;
\import Doubles.Tensor[C := FiniteCircle.complex, D := FiniteCircle.complex] \as FiniteTensor;
\import Doubles.Total[C := FiniteTensor.complex] \as FiniteTotal;
\import Doubles.Tensor[C := SingularCircle.complex, D := SingularCircle.complex] \as SingularTensor;
\import Doubles.Total[C := SingularTensor.complex] \as SingularTotal;
\definition model: Chains.Complex := FiniteTotal.complex;
\import Chains.ZeroExtension[C := SingularCircle.complex] \as CircleExtension;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring].Equivalence[C := \root.Circle[].chain, D := CircleExtension.complex] \as CircleEquivalences;
\import singular_eilenberg_zilber.Equivalence[A := Circle, B := Circle, left := circleTopology, right := circleTopology] \as EilenbergZilber;
\import singular_eilenberg_zilber.On[A := Circle, B := Circle, left := circleTopology, right := circleTopology] \as ProductMaps;
\import topological_constructions.Product[A := Circle, B := Circle] \as ActualProduct;
\import singular_cohomology.Chains[A := ActualProduct.CarrierSet, source := ProductMaps.topology] \as ProductChains;
\import Chains.Equivalence[C := ProductChains.complex, D := SingularTotal.complex].Reverse[] \as Reverse;
\import Chains.Equivalence[C := model, D := ProductChains.complex] \as Equivalences;
\module With(circle: CircleEquivalences.Equivalence);
\import std.Logic[].Proposition[] \as Logic;
\definition existence: \exists Equivalences.Equivalence := \block {
  \takefrom circle: CircleEquivalences.Equivalence \by CircleComparison.existence \then
  \return \exact(With[circle := circle].equivalence, Equivalences.Equivalence)
};
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\module Coefficients(M: Modules.Bundle);
\module ZeroDifferential;
\module Terms;
