\import singular_low_degree.Product[A := Circle, B := Circle, left := circleTopology, right := circleTopology,
  leftPoint := Geometry.point, rightPoint := Geometry.point].With[leftPaths := paths, rightPaths := paths]
  .Coefficients[coefficients := Products.integerCoefficients] \as Axes;
\definition law(q: NativeCarrier): #apply{nativeForward} (#apply{nativeBackward} q) = q :=
  Axes.detectsEqual _ _
    (trans!{{CircleCohomology.Group one}} _ _ _ (firstEvaluation (#apply{nativeBackward} q))
      (#rightInverse{CircleTop.isomorphism} (#apply{Pullbacks.firstRestriction} q)))
    (trans!{{CircleCohomology.Group one}} _ _ _ (secondEvaluation (#apply{nativeBackward} q))
      (#rightInverse{CircleTop.isomorphism} (#apply{Pullbacks.secondRestriction} q)));
