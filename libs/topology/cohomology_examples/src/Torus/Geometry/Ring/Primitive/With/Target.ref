\import NativeModules.Isomorphism[V := OriginalTorusH.Cohomology, W := StandardTorusH.Cohomology, source := OriginalTorusH.cohomologySpace, target := StandardTorusH.cohomologySpace].Inverse[] \as CoefficientInverse;
\import NativeModules.Isomorphism[V := FiniteTorusH.Cohomology, W := StandardTorusH.Cohomology, source := FiniteTorusH.cohomologySpace, target := StandardTorusH.cohomologySpace].Composition[U := OriginalTorusH.Cohomology, final := OriginalTorusH.cohomologySpace] \as CoefficientComposition;
\definition original: _ := CoefficientComposition.compose (CoefficientInverse.inverse TorusCoefficientIso.isomorphism) torusTransport;
\import NativeModules.Isomorphism[V := FiniteTorusH.Cohomology, W := OriginalTorusH.Cohomology, source := FiniteTorusH.cohomologySpace, target := OriginalTorusH.cohomologySpace].Composition[U := Cohomology.Group two, final := Cohomology.moduleSpace two] \as ActionComposition;
\definition isomorphism: _ := ActionComposition.compose TorusAction.isomorphism original;
\import Hom.Homotopy[P := SingularTorus.complex, Q := Comparison.model, N := scalars] \as Forward;
\import Cochains.Map[C := FiniteTorusTheory.complex, D := StandardTorus.complex].At[k := two] \as Pullback;
\import Cochains.Map[C := StandardTorus.complex, D := OriginalTorus.complex].At[k := two] \as Change;
\definition standardCycle(phi: FiniteTorusH.CycleCarrier): StandardTorusH.CycleCarrier := #apply{(Pullback.cyclesMap (Forward.map #backward{TorusComparison.equivalence}))} phi;
\definition cycle(phi: FiniteTorusH.CycleCarrier): OriginalTorusH.CycleCarrier := #apply{(Change.cyclesMap ConvertTorus.inverse)} (standardCycle phi);
\definition onClass(phi: FiniteTorusH.CycleCarrier): #apply{#forward{isomorphism}} (FiniteTorusH.classOf phi) = OriginalTorusH.classOf (cycle phi) :=
  trans!{{Cohomology.Group two}} _ _ _
    (congr!{StandardTorusH.Cohomology {Cohomology.Group two}}
      (\fun (h: StandardTorusH.Cohomology) => #apply{#forward{TorusAction.isomorphism}} (#apply{#backward{TorusCoefficientIso.isomorphism}} h)) _ _
      (Pullback.onClass (Forward.map #backward{TorusComparison.equivalence}) phi))
    (Change.onClass ConvertTorus.inverse (standardCycle phi));
