\import \root.Circle[].Geometry[].FiniteComparison[].With[e := circle] \as CircleComparison;
\import Comparison.With[circle := circle] \as TorusComparison;
\import \parent.Finite[] \as Finite;
\import Hom.On[P := FiniteCircle.complex, N := scalars] \as FiniteCircleTheory;
\import Hom.On[P := Comparison.model, N := scalars] \as FiniteTorusTheory;
\import Cochains.At[C := FiniteCircleTheory.complex, k := one] \as FiniteCircleH;
\import Cochains.At[C := FiniteTorusTheory.complex, k := two] \as FiniteTorusH;
\import Hom.On[P := SingularCircle.complex, N := scalars] \as StandardCircle;
\import Hom.On[P := SingularTorus.complex, N := scalars] \as StandardTorus;
\import Hom.On[P := SingularCircle.complex, N := Coefficients.canonical] \as OriginalCircle;
\import Hom.On[P := SingularTorus.complex, N := Coefficients.canonical] \as OriginalTorus;
\import Cochains.At[C := StandardCircle.complex, k := one] \as StandardCircleH;
\import Cochains.At[C := StandardTorus.complex, k := two] \as StandardTorusH;
\import Cochains.At[C := OriginalCircle.complex, k := one] \as OriginalCircleH;
\import Cochains.At[C := OriginalTorus.complex, k := two] \as OriginalTorusH;
\import Coefficients.Convert[P := SingularCircle.complex] \as ConvertCircle;
\import Coefficients.Convert[P := SingularTorus.complex] \as ConvertTorus;
\import chain_complexes.CochainEquivalence[].Over[R := I.Int^, ring := Integers.ring] \as CochainEquivalences;
\import CochainEquivalences.Of[C := OriginalCircle.complex, D := StandardCircle.complex].With[e := ConvertCircle.equivalence].At[n := one] \as CircleCoefficientIso;
\import CochainEquivalences.Of[C := OriginalTorus.complex, D := StandardTorus.complex].With[e := ConvertTorus.equivalence].At[n := two] \as TorusCoefficientIso;
\import Hom.Equivalence[P := FiniteCircle.complex, Q := SingularCircle.complex, N := scalars] \as CircleTransport;
\import Hom.Equivalence[P := Comparison.model, Q := SingularTorus.complex, N := scalars] \as TorusTransport;
\definition circleTransport: _ := CircleTransport.At[k := one].isomorphism CircleComparison.equivalence;
\definition torusTransport: _ := TorusTransport.At[k := two].isomorphism TorusComparison.equivalence;
\import \parent.Action[A := Circle, source := circleTopology, n := one] \as CircleAction;
\import \parent.Action[A := Carrier, source := topology, n := two] \as TorusAction;
\module Circle;
\module Torus;
\module Compatibility;
