\import \root.Circle[].Geometry[].FiniteComparison[].With[e := circle] \as CircleComparison;
\import Comparison.With[circle := circle] \as TorusComparison;
\import \parent.Finite[] \as Finite;
\import Hom.On[P := FiniteCircle.complex, N := scalars] \as FiniteCircleTheory;
\import Hom.On[P := Comparison.model, N := scalars] \as FiniteTorusTheory;
\import Cochains.At[C := FiniteCircleTheory.complex, k := one] \as FiniteCircleH;
\import Cochains.At[C := FiniteTorusTheory.complex, k := two] \as FiniteTorusH;
\import Hom.On[P := SingularCircle.complex, N := scalars] \as StandardCircle;
\import Hom.On[P := SingularTorus.complex, N := scalars] \as StandardTorus;
\import Hom.On[P := SingularCircle.complex, N := Coefficients.canonical] \as OriginalCircle;
\import Hom.On[P := SingularTorus.complex, N := Coefficients.canonical] \as OriginalTorus;
\import Cochains.At[C := StandardCircle.complex, k := one] \as StandardCircleH;
\import Cochains.At[C := StandardTorus.complex, k := two] \as StandardTorusH;
\import Cochains.At[C := OriginalCircle.complex, k := one] \as OriginalCircleH;
\import Cochains.At[C := OriginalTorus.complex, k := two] \as OriginalTorusH;
\import Coefficients.Convert[P := SingularCircle.complex] \as ConvertCircle;
\import Coefficients.Convert[P := SingularTorus.complex] \as ConvertTorus;
\import chain_complexes.CochainEquivalence[].Over[R := I.Int^, ring := Integers.ring] \as CochainEquivalences;
\import CochainEquivalences.Of[C := OriginalCircle.complex, D := StandardCircle.complex].With[e := ConvertCircle.equivalence].At[n := one] \as CircleCoefficientIso;
\import CochainEquivalences.Of[C := OriginalTorus.complex, D := StandardTorus.complex].With[e := ConvertTorus.equivalence].At[n := two] \as TorusCoefficientIso;
\import Hom.Equivalence[P := FiniteCircle.complex, Q := SingularCircle.complex, N := scalars] \as CircleTransport;
\import Hom.Equivalence[P := Comparison.model, Q := SingularTorus.complex, N := scalars] \as TorusTransport;
\definition circleTransport: _ := CircleTransport.At[k := one].isomorphism CircleComparison.equivalence;
\definition torusTransport: _ := TorusTransport.At[k := two].isomorphism TorusComparison.equivalence;
\import \parent.Action[A := Circle, source := circleTopology, n := one] \as CircleAction;
\import \parent.Action[A := Carrier, source := topology, n := two] \as TorusAction;
\module Factor;
\module Target;
\module Compatibility;
\import \parent.Finite[] \as FinitePair;
\import \root.Torus[].Geometry[].Ring[].Primitive[].With[circle := circle].Factor[] \as FactorData;
\import \root.Torus[].Geometry[].Ring[].Primitive[].With[circle := circle].Target[] \as TargetData;
\import NativeModules.Tensor[V := I.Int^, W := I.Int^, left := scalars.space, right := scalars.space] \as ScalarTensor;
\import Commutative.ScalarTensor[N := scalars] \as ScalarProduct;
\import NativeModules.Isomorphism[V := ScalarTensor.Carrier, W := I.Int^, source := ScalarTensor.space, target := scalars.space].Inverse[] \as ScalarInverse;
\import ScalarTensor.Mapping[U := FinitePair.CircleCochain, Z := FinitePair.CircleCochain, targetLeft := FinitePair.circleSpace, targetRight := FinitePair.circleSpace] \as MapTensor;
\import MapTensor.Isomorphism[leftIso := FactorData.model, rightIso := FactorData.model] \as FactorTensor;
\import NativeModules.Isomorphism[V := I.Int^, W := ScalarTensor.Carrier, source := scalars.space, target := ScalarTensor.space].Composition[U := FinitePair.TensorCarrier, final := FinitePair.tensorSpace] \as FactorComposition;
\definition factorIsomorphism: _ := FactorComposition.compose FactorTensor.isomorphism (ScalarInverse.inverse ScalarProduct.isomorphism);
\import NativeModules.Isomorphism[V := I.Int^, W := FinitePair.TensorCarrier, source := scalars.space, target := FinitePair.tensorSpace].Composition[U := FinitePair.Group, final := FinitePair.groupSpace] \as FiniteComposition;
\definition finiteIsomorphism: _ := FiniteComposition.compose FinitePair.isomorphism factorIsomorphism;
\import NativeModules.Isomorphism[V := I.Int^, W := FinitePair.Group, source := scalars.space, target := FinitePair.groupSpace].Composition[U := Cohomology.Group two, final := Cohomology.moduleSpace two] \as Composition;
\definition isomorphism: NativeModules.Isomorphism[V := I.Int^, W := Cohomology.Group two, source := scalars.space, target := Cohomology.moduleSpace two].Isomorphism := Composition.compose TargetData.isomorphism finiteIsomorphism;
\definition onOne: ((isomorphism).forward).apply I.One.specification = orientation :=
  trans!{{Cohomology.Group two}} _ _ _
    (congr!{FinitePair.TensorCarrier {Cohomology.Group two}}
      (\fun (z: FinitePair.TensorCarrier) => ((TargetData.isomorphism).forward).apply (((FinitePair.isomorphism).forward).apply z)) _ _
      (MapTensor.onTensor ((FactorData.model).forward) ((FactorData.model).forward) I.One.specification I.One.specification))
    (trans!{{Cohomology.Group two}} _ _ _
      (congr!{FinitePair.Group {Cohomology.Group two}} (((TargetData.isomorphism).forward).apply) _ _ (FinitePair.onTensor FactorData.alpha FactorData.alpha))
      (trans!{{Cohomology.Group two}} _ _ _
        (Compatibility[].At[alpha := FactorData.alpha, beta := FactorData.alpha].law)
        (congr2!{{CircleCohomology.Group one} {CircleCohomology.Group one} {Cohomology.Group two}}
          (\fun (h, k: CircleCohomology.Group one) => Cup.apply (Projection.apply one first firstContinuous h) (Projection.apply one second secondContinuous k)) _ _ _ _ FactorData.onAlpha FactorData.onAlpha)));
