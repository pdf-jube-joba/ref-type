\import singular_cohomology.Chains[A := A, source := source] \as Singular;
\import Hom.On[P := Singular.complex, N := Coefficients.canonical] \as Original;
\import Cochains.At[C := Original.complex, k := n] \as Native;
\import singular_products.Cochains[A := A, source := source, R := I.Int^, ring := Integers.commutativeRing].Cohomology[] \as Ring;
\definition original: NativeModules.Bundle := NativeModules.Bundle { Carrier := Native.Cohomology, space := Native.cohomologySpace };
\definition target: NativeModules.Bundle := NativeModules.Bundle { Carrier := Ring.Group n, space := Ring.moduleSpace n };
\import \root.Integral[].Maps[A := original, B := target] \as Forward;
\import \root.Integral[].Maps[A := target, B := original] \as Backward;
\definition forward: NativeModules.Hom[V := original.Carrier, W := target.Carrier, source := original.space, target := target.space].Map := Forward.fromAdditive (\fun (h: original.Carrier) => h) (\fun (h, k: original.Carrier) => \refl(#add{original.space} h k));
\definition backward: NativeModules.Hom[V := target.Carrier, W := original.Carrier, source := target.space, target := original.space].Map := Backward.fromAdditive (\fun (h: target.Carrier) => h) (\fun (h, k: target.Carrier) => \refl(#add{target.space} h k));
\definition isomorphism: NativeModules.Isomorphism[V := original.Carrier, W := target.Carrier, source := original.space, target := target.space].Isomorphism := NativeModules.Isomorphism[V := original.Carrier, W := target.Carrier, source := original.space, target := target.space].Isomorphism {
  forward := forward, backward := backward,
  leftInverse := \fun (h: original.Carrier) => \refl(h), rightInverse := \fun (h: target.Carrier) => \refl(h),
};
