\use Equality.congr2;
\import \root.Torus[].Geometry[].Comparison[] \as Comparison;
\import singular_cohomology.Chains[A := Circle, source := circleTopology] \as SingularCircle;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as TensorChains;
\import TensorChains.ZeroExtension[C := SingularCircle.complex] \as CircleExtension;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring].Equivalence[C := \root.Circle[].chain, D := CircleExtension.complex] \as CircleEquivalences;
\import singular_cech.Algebra[R := I.Int^, ring := Integers.ring].Restriction[C := \root.Circle[].chain] \as FiniteCircle;
\import singular_eilenberg_zilber.On[A := Circle, B := Circle, left := circleTopology, right := circleTopology] \as ProductMaps;
\import topological_constructions.Product[A := Circle, B := Circle] \as ActualProduct;
\import singular_cohomology.Chains[A := ActualProduct.CarrierSet, source := ProductMaps.topology] \as SingularTorus;
\import Comparison.Terms[] \as Terms;
\import singular_tensor_dual.Over[R := I.Int^, ring := Integers.commutativeRing] \as TensorDual;
\import singular_tensor_dual.Integer[] \as Coefficients;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as TensorModules;
\definition nativeFiniteCircle: TensorChains.Complex := FiniteCircle.complex;
\definition nativeSingularCircle: TensorChains.Complex := SingularCircle.complex;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Doubles;
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing] \as Commutative;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as NativeModules;
\definition scalars: NativeModules.Bundle := Coefficients.standard;
\module Finite;
\module Action(A: \Set, source: topology.Topology[Carrier := A].Topology, n: N.Nat^);
\module With(circle: CircleEquivalences.Equivalence);
\import NativeModules.Isomorphism[V := I.Int^, W := Cohomology.Group two, source := scalars.space, target := Cohomology.moduleSpace two] \as Isomorphisms;
\definition Result: \Set := \Cast[Isomorphisms.Isomorphism] ({ e: Isomorphisms.Isomorphism \where ((e).forward).apply I.One.specification = orientation });
\definition existence: \exists Result := \block {
  \takefrom circle: CircleEquivalences.Equivalence \by \root.Circle[].Geometry[].FiniteComparison[].existence \then
  \return \exact(\into[Isomorphisms.Isomorphism](With[circle := circle].isomorphism, Result) \by { With[circle := circle].onOne }, Result)
};
