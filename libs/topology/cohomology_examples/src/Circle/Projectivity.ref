\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\module Degree(n: N.Nat^) {
  \import Modules.FiniteCoordinates[n := ranks (I.Int^::ofNat n)].Free[] \as Free;
  \definition projective: Modules.Projective (Modules.Bundle {
    Carrier := chain.family.Carrier (I.Int^::ofNat n), space := chain.family.space (I.Int^::ofNat n) }) := Free.projective;
}
\definition projective: \forall (n: N.Nat^) -> Modules.Projective (Modules.Bundle {
  Carrier := chain.family.Carrier (I.Int^::ofNat n), space := chain.family.space (I.Int^::ofNat n) }) :=
  \fun (n: N.Nat^) => Degree[n := n].projective;
\definition negative(n: N.Nat^)(x: chain.family.Carrier (I.Int^::negSucc n)): x = #zero{(chain.family.space (I.Int^::negSucc n))} :=
  \axiom:funext(x, #zero{(chain.family.space (I.Int^::negSucc n))}, \fun (i: Fin.Fin zero) =>
    Logic.falseElim (x i = #zero{Integers.ring}) (Fin.zeroImpossible i (Fin.bound zero i)));
