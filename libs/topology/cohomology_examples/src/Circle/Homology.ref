\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import Chains.ZeroDifferential[family := FiniteModel.family] \as Zero;
\import Chains.Map[C := chain, D := Zero.complex] \as Forward;
\import Chains.Map[C := Zero.complex, D := chain] \as Backward;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (z: I.Int^)(x: Vector z) => x,
  addition := \fun (z: I.Int^)(x, y: Vector z) => \refl((vectorSpace z).add x y),
  scalar := \fun (z: I.Int^)(a: I.Int^)(x: Vector z) => \refl((vectorSpace z).smul a x),
  commutes := \fun (z: I.Int^)(x: Vector z) => sym!{{Vector (Bounded.previous z)}} _ _ (zeroAction z x),
};
\definition backward: Backward.Map := Backward.Map {
  apply := \fun (z: I.Int^)(x: Vector z) => x,
  addition := \fun (z: I.Int^)(x, y: Vector z) => \refl((vectorSpace z).add x y),
  scalar := \fun (z: I.Int^)(a: I.Int^)(x: Vector z) => \refl((vectorSpace z).smul a x),
  commutes := zeroAction,
};
\import Chains.Isomorphism[C := chain, D := Zero.complex] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := \fun (z: I.Int^)(x: Vector z) => \refl(x),
  rightInverse := \fun (z: I.Int^)(x: Vector z) => \refl(x),
};
\module Degree(z: I.Int^);
\module Unit;
