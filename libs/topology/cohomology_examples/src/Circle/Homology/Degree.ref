\import Chains.At[C := chain, z := z] \as H;
\import Chains.At[C := Zero.complex, z := z] \as ZeroH;
\import Zero.At[k := z] \as Calculation;
\import Isomorphisms.At[z := z] \as Comparison;
\import Modules.Isomorphism[V := Vector z, W := ZeroH.Homology, source := vectorSpace z, target := ZeroH.homologySpace].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := H.Homology, W := ZeroH.Homology, source := H.homologySpace, target := ZeroH.homologySpace]
  .Composition[U := Vector z, final := vectorSpace z] \as Composition;
\definition coordinates: Modules.Isomorphism[V := H.Homology, W := Vector z, source := H.homologySpace, target := vectorSpace z].Isomorphism :=
  Composition.compose (Inverse.inverse Calculation.isomorphism) (Comparison.isomorphism isomorphism);
\definition onClass(x: H.Cycle): #apply{#forward{coordinates}} (H.classOf x) = x :=
  trans!{{Vector z}} _ _ _
    (congr!{ZeroH.Homology {Vector z}} (#apply{Calculation.backward}) _ _ (Forward.At[k := z].onClass forward x))
    (Calculation.leftInverse x);
