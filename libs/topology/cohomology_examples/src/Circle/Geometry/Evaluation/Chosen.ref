\import \parent.\parent.Representatives[pointCycle := pointCycle, orientationCycle := ExplicitLoop.Primitive[].cycle] \as Representatives;
\definition oriented: H1.classOf ExplicitLoop.Primitive[].cycle = orientation := sym!{H1.Homology} _ _ ExplicitLoop.Primitive[].onOne;
\import Representatives.Quasi[pointRepresents := represents, orientationRepresents := oriented] \as Quasi;
\import singular_finite_algebra.Integer[].ProjectiveCone[P := chain, Q := ExtendedSingular.complex] \as Bridge;
\import \root.Circle[].Projectivity[] \as SourceProjectivity;
\import \parent.\parent.Projectivity[] \as TargetProjectivity;
\import SignedChains.Equivalence[C := chain, D := ExtendedSingular.complex] \as Equivalences;
\module With(e: Equivalences.Equivalence, forwardExact: #forward{e} = Representatives.comparison);
\definition existence: \exists Result := \block {
  \takefrom e: \Cast[Equivalences.Equivalence] ({ e: Equivalences.Equivalence \where #forward{e} = Representatives.comparison })
    \by Bridge.On[f := Representatives.comparison].equivalenceExists SourceProjectivity.projective TargetProjectivity.projective
      SourceProjectivity.negative TargetProjectivity.negative Quasi.law \then
  \return \exact(With[e := e, forwardExact := \bysub(Equivalences.Equivalence,
    { e: Equivalences.Equivalence \where #forward{e} = Representatives.comparison }, e)].result, Result)
};
