\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := Singular.complex] \as Extension;
\module Degree(n: N.Nat^) {
  \import Modules.Free[Generators := singular_cohomology.Simplices[A := Carrier, source := topology].Carrier n] \as Free;
  \import Extension.Positive[n := n] \as Positive;
  \definition bundle: Modules.Bundle := Modules.Bundle {
    Carrier := ExtendedSingular.complex.family.Carrier (I.Int^::ofNat n), space := ExtendedSingular.complex.family.space (I.Int^::ofNat n) };
  \import Modules.ProjectiveLaws[].Retract[P := bundle, Q := Free.bundle, inclusion := Positive.backward, retraction := Positive.forward] \as Retraction;
  \definition projective: Modules.Projective bundle := Retraction.projective (Positive.isomorphism).rightInverse Free.projective;
}
\definition projective: \forall (n: N.Nat^) -> Modules.Projective (Modules.Bundle {
  Carrier := ExtendedSingular.complex.family.Carrier (I.Int^::ofNat n), space := ExtendedSingular.complex.family.space (I.Int^::ofNat n) }) :=
  \fun (n: N.Nat^) => Degree[n := n].projective;
\definition negative: \forall (n: N.Nat^)(x: ExtendedSingular.complex.family.Carrier (I.Int^::negSucc n)) ->
  x = (ExtendedSingular.complex.family.space (I.Int^::negSucc n)).zero := \fun (n: N.Nat^) => Extension.Negative[n := n].zero;
