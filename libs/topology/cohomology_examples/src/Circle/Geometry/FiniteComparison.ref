\import singular_finite_algebra.Integer[].ProjectiveCone[P := chain, Q := Singular.integerComplex] \as Bridge;
\import \root.Circle[].Projectivity[] \as Source;
\import \parent.Projectivity[] \as Target;
\import SignedChains.Equivalence[C := chain, D := Singular.integerComplex] \as Equivalences;
\definition existence: \exists Equivalences.Equivalence := \block {
  \takefrom f: \Cast[Comparisons.Map] ({ f: Comparisons.Map \where Comparisons.QuasiIsomorphism f }) \by quasiComparison \then
  \takefrom e: \Cast[Equivalences.Equivalence] ({ e: Equivalences.Equivalence \where #forward{e} = f })
    \by Bridge.On[f := f].equivalenceExists Source.projective Target.projective Source.negative Target.negative
      (\bysub(Comparisons.Map, { f: Comparisons.Map \where Comparisons.QuasiIsomorphism f }, f)) \then
  \return \exact(e, Equivalences.Equivalence)
};

\import singular_cech.Algebra[R := I.Int^, ring := Integers.ring] \as Algebra;
\import Algebra.Restriction[C := chain] \as Restriction;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as NativeChains;
\definition native: NativeChains.Complex := Restriction.complex;
\module With(e: Equivalences.Equivalence);
