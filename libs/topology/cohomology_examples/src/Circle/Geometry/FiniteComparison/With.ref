\import Algebra.Restriction[C := Singular.integerComplex] \as TargetRestriction;
\import Restriction.Mapping[D := Singular.integerComplex].Equivalence[e := e, sourceNegative := Source.negative, targetNegative := Target.negative] \as Restricted;
\import Algebra.RestrictionZeroExtension[C := Singular.complex] \as Recovery;
\import NativeChains.Equivalence[C := TargetRestriction.complex, D := Singular.complex].FromIsomorphism[] \as Recovered;
\import NativeChains.Equivalence[C := Restriction.complex, D := TargetRestriction.complex].Composition[E := Singular.complex] \as Composition;
\definition equivalence: NativeChains.Equivalence[C := native, D := Singular.complex].Equivalence :=
  Composition.compose Restricted.value (Recovered.apply Recovery.isomorphism);
