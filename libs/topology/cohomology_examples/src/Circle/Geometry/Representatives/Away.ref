\import SignedChains.At[C := chain, z := z] \as Source;
\import SignedChains.At[C := ExtendedSingular.complex, z := z] \as Target;
\import \root.Circle[].Homology[].Degree[z := z] \as Coordinates;
\import Modules.Isomorphism[V := Source.Homology, W := Vector z, source := Source.homologySpace, target := vectorSpace z].Vanishing[] \as Vanishing;
\definition sourceVanishes: \forall (h: Source.Homology) -> h = Source.zeroClass := Vanishing.sourceZero Coordinates.coordinates sourceZero;
\import Maps.At[k := z] \as Actual;
\import Modules.Hom[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace] \as Linear;
\definition bijective: Actual.Bijective[comparison] := Actual.Bijective[comparison] {
  injective := \fun (h, k: Source.Homology)(equal: #apply{(Actual.induced comparison)} h = #apply{(Actual.induced comparison)} k) =>
    trans!{Source.Homology} _ _ _ (sourceVanishes h) (sym!{Source.Homology} _ _ (sourceVanishes k)),
  onto := \fun (h: Target.Homology) => Logic.existsIntro[Source.Homology, { k: Source.Homology \where #apply{(Actual.induced comparison)} k = h }]
    Source.zeroClass (trans!{Target.Homology} _ _ _ (Linear.zeroPreserved (Actual.induced comparison)) (sym!{Target.Homology} _ _ (targetZero h))),
};
