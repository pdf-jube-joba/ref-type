\import cohomology_models.Spheres[].Homology[] \as SphereHomology;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := Singular.complex] \as Extension;
\definition natural: \forall (n: N.Nat^) -> Maps.At[k := I.Int^::ofNat n].Bijective[comparison] :=
  \induction (n: N.Nat^) \return Maps.At[k := I.Int^::ofNat n].Bijective[comparison] \with {
    | zero: \parent.DegreeZero[represents := pointRepresents].bijective
    | succ: \fun (n: N.Nat^)(previous: _) =>
      (\induction (n: N.Nat^) \return Maps.At[k := I.Int^::ofNat (N.Nat^::succ n)].Bijective[comparison] \with {
        | zero: \parent.DegreeOne[represents := orientationRepresents].bijective
        | succ: \fun (n: N.Nat^)(previous: _) =>
          \parent.Away[z := I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n)), sourceZero := \parent.EmptyCoordinates[].zero, targetZero := SphereHomology.above one n].bijective
      }) n
  };
\definition law: Maps.QuasiIsomorphism comparison :=
  \induction (z: I.Int^) \return Maps.At[k := z].Bijective[comparison] \with {
    | ofNat: natural
    | negSucc: \fun (n: N.Nat^) => \parent.Away[z := I.Int^::negSucc n, sourceZero := \parent.EmptyCoordinates[].zero,
      targetZero := Extension.NegativeHomology[n := n].vanishes].bijective
  };
