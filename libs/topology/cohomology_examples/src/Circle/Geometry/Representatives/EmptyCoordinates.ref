\import std.Data[].FinSet[] \as Fin;
\import Modules.FiniteCoordinates[n := zero] \as Empty;
\definition zero(v: Empty.Carrier): v = #zero{Empty.space} :=
  \axiom:funext(v, #zero{Empty.space}, \fun (i: Empty.Index) => Logic.falseElim (v i = #zero{Integers.ring}) (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i)));
