\import SignedChains.At[C := Singular.integerComplex, z := z] \as H;
\import Modules.Hom[V := Singular.integerComplex.family.Carrier z, W := Singular.integerComplex.family.Carrier (Bounded.previous z),
  source := Singular.integerComplex.family.space z, target := Singular.integerComplex.family.space (Bounded.previous z)] \as Maps;
\definition value: H.Cycle := H.cycle #zero{(Singular.integerComplex.family.space z)} (Maps.zeroPreserved H.differential);
