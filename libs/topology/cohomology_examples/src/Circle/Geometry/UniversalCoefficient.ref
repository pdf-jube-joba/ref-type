\import \root.Circle[] \as CircleModel;
\import homological_algebra.Finite[].Bounded[].Of[C := CircleModel.complex] \as Finite;
\import singular_finite_algebra.Integer[].Finite[X := Carrier, topology := topology, model := CircleModel.complex] \as Transfer;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Integer[P := Singular.integerComplex, N := coefficients] \as Cochains;
\import Cochains.Cohomology[z := z] \as Cohomology;
\import Finite.At[z := z].UniversalCoefficient[A := coefficients].CohomologyKernel[] \as UCT;
\definition cohomologyBundle: Modules.Bundle := Modules.Bundle { Carrier := Cohomology.Cohomology, space := Cohomology.cohomologySpace };
\import Modules.ShortExact[A := UCT.extBundle, B := cohomologyBundle, C := UCT.homBundle] \as CohomologyExact;
\definition CohomologySequence: \Set := CohomologyExact.Sequence;
\definition cohomology: \exists CohomologySequence := \block {
  \takefrom e: Transfer.Comparison \by \parent.FiniteComparison[].existence \then
  \return \exact(Transfer.Compared[comparison := e].At[z := z, coefficients := coefficients].universalCoefficient, CohomologySequence)
};
\import Finite.At[z := z].UniversalCoefficient[A := coefficients].Tensor[].Projection[].Exactness[] \as TensorExact;
\import TensorExact.Derived[] \as Derived;
\import resolutions.TensorComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Integer[P := Singular.integerComplex, N := coefficients] \as Tensor;
\import SignedChains.At[C := Tensor.complex, z := z] \as Homology;
\definition homologyBundle: Modules.Bundle := Modules.Bundle { Carrier := Homology.Homology, space := Homology.homologySpace };
\import Modules.ShortExact[A := TensorExact.homologyTensorBundle, B := homologyBundle, C := Derived.torBundle] \as HomologyExact;
\definition HomologySequence: \Set := HomologyExact.Sequence;
\definition homology: \exists HomologySequence := \block {
  \takefrom e: Transfer.Comparison \by \parent.FiniteComparison[].existence \then
  \return \exact(Transfer.Compared[comparison := e].At[z := z, coefficients := coefficients].homologyUniversalCoefficient, HomologySequence)
};
