\definition distanceContinuous: \forall (source: Source.Topology) (p: Real.Real) (f: A -> Real.Real) ->
  Continuous source f -> Continuous source (\fun (x: A) => Real.distance p (f x)) :=
  \fun (source: _) (p: _) (f: _) (fc: _) => continuousOfLocal source (\fun (x: A) => Real.distance p (f x)) (\block {
    \fun (x: A) (r: Real.Real) (rp: R.Lt Real.zero r) \then
    \takefrom U: \Cast[\Pow A] ({ U: \Pow A \where Source.OpenNeighborhood[source, x, Small f x r, U] })
      \by localOfContinuous source f fc x r rp \then
    \let data: Source.OpenNeighborhood[source, x, Small f x r, U] :=
      \bysub(\Pow A, { U: \Pow A \where Source.OpenNeighborhood[source, x, Small f x r, U] }, U) \then
    \return Logic.existsIntro[\Pow A, { U: \Pow A \where Source.OpenNeighborhood[source, x, Small (\fun (x: A) => Real.distance p (f x)) x r, U] }] U
      (Source.OpenNeighborhood[source, x, Small (\fun (x: A) => Real.distance p (f x)) x r, U] {
        open := data.open, contains := data.contains,
        within := \fun (y: A) (member: Source.Member U y) => R.leLtTrans _ _ r (Estimates.distanceFromPoint p (f x) (f y)) (data.within y member),
      })
  });
\definition absoluteContinuous: \forall (source: Source.Topology) (f: A -> Real.Real) ->
  Continuous source f -> Continuous source (\fun (x: A) => Real.distance Real.zero (f x)) :=
  \fun (source: _) (f: _) => distanceContinuous source Real.zero f;
\definition maximumContinuous: \forall (source: Source.Topology) (f, g: A -> Real.Real) ->
  Continuous source f -> Continuous source g -> Continuous source (\fun (x: A) => Distance.max (f x) (g x)) :=
  \fun (source: _) (f, g: _) (fc: _) (gc: _) => continuousOfLocal source (\fun (x: A) => Distance.max (f x) (g x)) (\block {
    \fun (x: A) (r: Real.Real) (positive: R.Lt Real.zero r) \then
    \let h: Real.Real := Real.mul Real.half r \then
    \takefrom U: \Cast[\Pow A] ({ U: \Pow A \where Source.OpenNeighborhood[source, x, Small f x h, U] })
      \by localOfContinuous source f fc x h (Estimates.halfOfPositive r positive) \then
    \takefrom V: \Cast[\Pow A] ({ V: \Pow A \where Source.OpenNeighborhood[source, x, Small g x h, V] })
      \by localOfContinuous source g gc x h (Estimates.halfOfPositive r positive) \then
    \let ud: Source.OpenNeighborhood[source, x, Small f x h, U] := \bysub(\Pow A,
      { U: \Pow A \where Source.OpenNeighborhood[source, x, Small f x h, U] }, U) \then
    \let vd: Source.OpenNeighborhood[source, x, Small g x h, V] := \bysub(\Pow A,
      { V: \Pow A \where Source.OpenNeighborhood[source, x, Small g x h, V] }, V) \then
    \let W: \Pow A := Source.Intersection U V \then
    \return Logic.existsIntro[\Pow A, { W: \Pow A \where Source.OpenNeighborhood[source, x, Small (\fun (x: A) => Distance.max (f x) (g x)) x r, W] }] W
      (Source.OpenNeighborhood[source, x, Small (\fun (x: A) => Distance.max (f x) (g x)) x r, W] {
        open := (Source.topologyLaws source).intersectionOpen U V (ud.open) (vd.open),
        contains := Logic.And[_, _]::# (ud.contains) (vd.contains),
        within := \fun (y: A) (member: Source.Member W y) => R.leLtTrans _ h r
          (Estimates.maxDistance (f x) (g x) (f y) (g y) h
            (Order.leOfLt _ _ (ud.within y (member.left))) (Order.leOfLt _ _ (vd.within y (member.right))))
          (Estimates.halfStrict r positive),
      })
  });
\definition minimumContinuous: \forall (source: Source.Topology) (f, g: A -> Real.Real) ->
  Continuous source f -> Continuous source g -> Continuous source (\fun (x: A) => Distance.min (f x) (g x)) :=
  \fun (source: _) (f, g: _) (fc: _) (gc: _) => negContinuous source
    (\fun (x: A) => Distance.max (Real.neg (f x)) (Real.neg (g x)))
    (maximumContinuous source (\fun (x: A) => Real.neg (f x)) (\fun (x: A) => Real.neg (g x))
      (negContinuous source f fc) (negContinuous source g gc));
