\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import R.Arithmetic[].Prop[] \as Laws;
\import R.Completeness[] \as Complete;
\import Real.Estimates[] \as Estimates;
\import Real.Distance[] \as Distance;
\import metric_spaces.RealMetric[] \as Metric;
\import metric_spaces.MetricSpace[Carrier := Real.Real] \as MetricSpace;
\import MetricSpace.Topology[] \as MetricTopology;
\import topology.Topology[Carrier := Real.Real] \as Space;
\import Space.Compactness[] \as Compactness;
\import std.Set[].FiniteSubset[A := \Pow Real.Real] \as Finite;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Logic.either;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\definition topology: Space.Topology := MetricTopology.topology Metric.metric;
\definition ClosedInterval[a, b: Real.Real]: \Pow Real.Real :=
  { x: Real.Real \where Logic.And[R.Le a x, R.Le x b] };
\definition OpenInterval[a, b: Real.Real]: \Pow Real.Real :=
  { x: Real.Real \where Logic.And[R.Lt a x, R.Lt x b] };
\module CompactIntervals;
\module Rays;
\module CompactExtrema;
