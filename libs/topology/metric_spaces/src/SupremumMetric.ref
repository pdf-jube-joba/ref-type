/* A metric obtained as the supremum of capped coordinate distances. */
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Def[] \as Real;
\import R.Arithmetic[].Prop[] \as RealLaws;
\import R.Completeness[] \as Complete;
\import real.Analysis[].Distance[] \as RM;
\import metric_spaces.MetricSpace[Carrier := Carrier] \as M;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;

\structure CappedCoordinates: \Set := {
  anchor: Index,
  ceiling: R.Real,
  weight: Index -> R.Real,
  component: Index -> Carrier -> Carrier -> R.Real,
  weightNonnegative: \forall (i: Index) -> R.Le Real.zero (weight i),
  weightBounded: \forall (i: Index) -> R.Le (weight i) ceiling,
  componentNonnegative: \forall (i: Index) (x, y: Carrier) ->
    R.Le Real.zero (component i x y),
  componentSelf: \forall (i: Index) (x: Carrier) ->
    component i x x = Real.zero,
  componentSymmetric: \forall (i: Index) (x, y: Carrier) ->
    component i x y = component i y x,
  componentTriangle: \forall (i: Index) (x, y, z: Carrier) ->
    R.Le (component i x z)
      (Real.add (component i x y) (component i y z)),
  separated: \forall (x, y: Carrier) ->
    (\forall (i: Index) ->
      RM.min (weight i) (component i x y) = Real.zero) -> x = y,
};

\definition capped[coordinates: CappedCoordinates] [i: Index] [x, y: Carrier]: R.Real :=
  RM.min (coordinates.weight i) (coordinates.component i x y);

\definition Family[coordinates: CappedCoordinates] [x, y: Carrier]: \Pow R.Real :=
  { d : R.Real \where
    \exists ( i : Index \where d = capped coordinates i x y ) };

\definition familyMember[coordinates: CappedCoordinates] [i: Index] [x, y: Carrier]:
  Complete.Member (Family coordinates x y) (capped coordinates i x y) :=
  Logic.existsIntro[Index, { j : Index \where
        capped coordinates i x y = capped coordinates j x y }] i
  (\refl(capped coordinates i x y));

\definition familyNonempty[coordinates: CappedCoordinates] [x, y: Carrier]:
  Complete.Nonempty (Family coordinates x y) :=
  Logic.existsIntro[R.Real, Family coordinates x y] (capped coordinates (coordinates.anchor) x y)
  (familyMember coordinates (coordinates.anchor) x y);

\definition familyUpperBound[coordinates: CappedCoordinates] [x, y: Carrier]:
  Complete.UpperBound (Family coordinates x y) (coordinates.ceiling) :=
  \fun (d: R.Real) (member: Complete.Member (Family coordinates x y) d) => \block {
      \takefrom i: \Cast[Index]
        ({ i : Index \where d = capped coordinates i x y })
        \by member \then
      \let same: d = capped coordinates i x y :=
        \bysub(Index,
          { j : Index \where d = capped coordinates j x y }, i) \then
      \return R.leReplaceLeft (capped coordinates i x y) d
        (coordinates.ceiling)
        (sym!{R.Real} d (capped coordinates i x y) same)
        (R.leTrans (capped coordinates i x y)
          (coordinates.weight i) (coordinates.ceiling)
          (RM.minLeft (coordinates.weight i)
            (coordinates.component i x y))
          (coordinates.weightBounded i))
    };

\definition familyBounded[coordinates: CappedCoordinates] [x, y: Carrier]:
  Complete.Bounded (Family coordinates x y) :=
  Logic.existsIntro[R.Real, { u : R.Real \where
        Complete.UpperBound (Family coordinates x y) u }] (coordinates.ceiling)
  (familyUpperBound coordinates x y);

\definition familyAsComplete[coordinates: CappedCoordinates] [x, y: Carrier]: Complete.Family :=
  \into[\Pow R.Real](Family coordinates x y, Complete.FamilySet)
    \by { Logic.And[_, _]::#
      (familyNonempty coordinates x y)
      (familyBounded coordinates x y) };

\definition distance[coordinates: CappedCoordinates] [x, y: Carrier]: R.Real :=
  Complete.supremum (familyAsComplete coordinates x y);

\definition cappedUpper[coordinates: CappedCoordinates] [i: Index] [x, y: Carrier]:
  R.Le (capped coordinates i x y) (distance coordinates x y) :=
  Complete.supremumUpper (familyAsComplete coordinates x y)
    (capped coordinates i x y) (familyMember coordinates i x y);

\definition familyUpperBoundOf[coordinates: CappedCoordinates] [x, y: Carrier] [u: R.Real]:
  (\forall (i: Index) -> R.Le (capped coordinates i x y) u) ->
  Complete.UpperBound (Family coordinates x y) u :=
  \fun (bound: \forall (i: Index) -> R.Le (capped coordinates i x y) u) =>
    \fun (d: R.Real) =>
      \fun (member: Complete.Member (Family coordinates x y) d) => \block {
        \takefrom i: \Cast[Index]
          ({ i : Index \where d = capped coordinates i x y })
          \by member \then
        \let same: d = capped coordinates i x y :=
          \bysub(Index,
            { j : Index \where d = capped coordinates j x y }, i) \then
        \return R.leReplaceLeft (capped coordinates i x y) d u
          (sym!{R.Real} d (capped coordinates i x y) same)
          (bound i)
      };

\definition cappedNonnegative[coordinates: CappedCoordinates] [i: Index] [x, y: Carrier]:
  R.Le Real.zero (capped coordinates i x y) :=
  RM.minNonnegative (coordinates.weight i)
    (coordinates.component i x y)
    (coordinates.weightNonnegative i)
    (coordinates.componentNonnegative i x y);

\definition cappedSelf[coordinates: CappedCoordinates] [i: Index] [x: Carrier]:
  capped coordinates i x x = Real.zero :=
  trans!{R.Real}
    _ _ _
    (congr!{R.Real R.Real}
      (RM.min (coordinates.weight i)) _ _
      (coordinates.componentSelf i x))
    (RM.minOfGe (coordinates.weight i) Real.zero
      (coordinates.weightNonnegative i));

\definition cappedSymmetric[coordinates: CappedCoordinates] [i: Index] [x, y: Carrier]:
  capped coordinates i x y = capped coordinates i y x :=
  congr!{R.Real R.Real}
    (RM.min (coordinates.weight i)) _ _
    (coordinates.componentSymmetric i x y);

\definition cappedTriangle[coordinates: CappedCoordinates] [i: Index] [x, y, z: Carrier]:
  R.Le (capped coordinates i x z)
    (Real.add (capped coordinates i x y)
      (capped coordinates i y z)) :=
  R.leTrans (capped coordinates i x z)
    (RM.min (coordinates.weight i)
      (Real.add (coordinates.component i x y)
        (coordinates.component i y z)))
    (Real.add (capped coordinates i x y)
      (capped coordinates i y z))
    (RM.minMonotone (coordinates.weight i)
      (coordinates.component i x z)
      (coordinates.weight i)
      (Real.add (coordinates.component i x y)
        (coordinates.component i y z))
      (R.leRefl (coordinates.weight i))
      (coordinates.componentTriangle i x y z))
    (RM.minSubadd (coordinates.weight i)
      (coordinates.component i x y)
      (coordinates.component i y z)
      (coordinates.weightNonnegative i)
      (coordinates.componentNonnegative i x y)
      (coordinates.componentNonnegative i y z));

\definition distanceNonnegative[coordinates: CappedCoordinates] [x, y: Carrier]:
  R.Le Real.zero (distance coordinates x y) :=
  R.leTrans Real.zero
    (capped coordinates (coordinates.anchor) x y)
    (distance coordinates x y)
    (cappedNonnegative coordinates (coordinates.anchor) x y)
    (cappedUpper coordinates (coordinates.anchor) x y);

\definition distanceSelf[coordinates: CappedCoordinates] [x: Carrier]:
  distance coordinates x x = Real.zero :=
  R.leAntisym (distance coordinates x x) Real.zero
    (Complete.supremumLeast (familyAsComplete coordinates x x)
      Real.zero
      (familyUpperBoundOf coordinates x x Real.zero
        (\fun (i: Index) =>
          R.leReplaceLeft Real.zero (capped coordinates i x x)
            Real.zero
            (sym!{R.Real} _ _ (cappedSelf coordinates i x))
            (R.leRefl Real.zero))))
    (distanceNonnegative coordinates x x);

\definition distanceSeparated[coordinates: CappedCoordinates] [x, y: Carrier]:
  distance coordinates x y = Real.zero ->
  x = y :=
  \fun (zero: distance coordinates x y = Real.zero) =>
    coordinates.separated x y
      (\fun (i: Index) =>
        R.leAntisym (capped coordinates i x y) Real.zero
          (R.leReplaceRight (capped coordinates i x y)
            (distance coordinates x y) Real.zero zero
            (cappedUpper coordinates i x y))
          (cappedNonnegative coordinates i x y));

\definition distanceSymmetric[coordinates: CappedCoordinates] [x, y: Carrier]:
  distance coordinates x y = distance coordinates y x :=
  R.leAntisym (distance coordinates x y) (distance coordinates y x)
    (Complete.supremumLeast (familyAsComplete coordinates x y)
      (distance coordinates y x)
      (familyUpperBoundOf coordinates x y (distance coordinates y x)
        (\fun (i: Index) =>
          R.leReplaceLeft (capped coordinates i y x)
            (capped coordinates i x y) (distance coordinates y x)
            (sym!{R.Real} _ _ (cappedSymmetric coordinates i x y))
            (cappedUpper coordinates i y x))))
    (Complete.supremumLeast (familyAsComplete coordinates y x)
      (distance coordinates x y)
      (familyUpperBoundOf coordinates y x (distance coordinates x y)
        (\fun (i: Index) =>
          R.leReplaceLeft (capped coordinates i x y)
            (capped coordinates i y x) (distance coordinates x y)
            (cappedSymmetric coordinates i x y)
            (cappedUpper coordinates i x y))));

\definition distanceTriangle[coordinates: CappedCoordinates] [x, y, z: Carrier]:
  R.Le (distance coordinates x z)
    (Real.add (distance coordinates x y)
      (distance coordinates y z)) :=
  Complete.supremumLeast (familyAsComplete coordinates x z)
    (Real.add (distance coordinates x y)
      (distance coordinates y z))
    (familyUpperBoundOf coordinates x z
      (Real.add (distance coordinates x y)
        (distance coordinates y z))
      (\fun (i: Index) =>
        R.leTrans (capped coordinates i x z)
          (Real.add (capped coordinates i x y)
            (capped coordinates i y z))
          (Real.add (distance coordinates x y)
            (distance coordinates y z))
          (cappedTriangle coordinates i x y z)
          (R.leTrans
            (Real.add (capped coordinates i x y)
              (capped coordinates i y z))
            (Real.add (distance coordinates x y)
              (capped coordinates i y z))
            (Real.add (distance coordinates x y)
              (distance coordinates y z))
            (RealLaws.addMonotoneRight
              (capped coordinates i x y)
              (distance coordinates x y)
              (capped coordinates i y z)
              (cappedUpper coordinates i x y))
            (RealLaws.addMonotoneLeft
              (capped coordinates i y z)
              (distance coordinates y z)
              (distance coordinates x y)
              (cappedUpper coordinates i y z)))));

\definition metric[coordinates: CappedCoordinates]: M.Metric :=
  M.Metric {
    distance := distance coordinates,

    nonnegative := distanceNonnegative coordinates,
    self := distanceSelf coordinates,
    separated := distanceSeparated coordinates,
    symmetric := distanceSymmetric coordinates,
    triangle := distanceTriangle coordinates,
  };
