/* A metric from countably many separating Urysohn functions. */
\import topology.Topology[Carrier := Carrier] \as T;
\import T.Metrization[] \as Coord;
\import T.Normality[] \as Normal;
\import T.Urysohn[] \as Urysohn;
\import real.Analysis[].Distance[] \as RM;
\import std.Data[].Nat[].Pair[].Def[] \as NatPair;
\import metric_spaces.SupremumMetric[Carrier := Carrier,
  Index := NatPair.NatPair] \as SM;
\import metric_spaces.MetricSpace[Carrier := Carrier] \as Metric;
\import Metric.Topology[] \as MetricTopology;
\import std.Data[].Nat[] \as N;
\import std.Data[].Nat[].Basic[].Def[] \as NatOp;
\import std.Data[].Nat[].Basic[].Prop[] \as NatOrder;
\import std.Arithmetic[].Rat[].Estimates[] \as Estimates;
\import std.Logic[].Proposition[] \as Logic;
\use Logic.either;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Def[] \as Real;
\import R.Arithmetic[].Prop[] \as RealLaws;
\import R.Order[] \as RealOrder;
\import R.Completeness[] \as Complete;
\use Equality.sym;
\use Equality.trans;

\definition coordinateDistance[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [pair: NatPair.NatPair] [x, y: Carrier]:
  R.Real :=
  RM.distance
    ((coordinates.select pair).value x)
    ((coordinates.select pair).value y);

\definition coordinateDistancesSeparate[topology: T.Topology]:
  T.IsT1 topology -> T.IsNormal topology ->
  \forall (coordinates: Coord.SeparationCoordinates[topology]) -> \forall (x, y: Carrier) ->
  (\forall (pair: NatPair.NatPair) ->
    coordinateDistance topology coordinates pair x y = Real.zero) ->
  x = y :=
  \fun (t1: T.IsT1 topology) (normal: T.IsNormal topology)
    (coordinates: Coord.SeparationCoordinates[topology]) (x, y: Carrier)
    (allZero: \forall (pair: NatPair.NatPair) ->
    coordinateDistance topology coordinates pair x y = Real.zero) =>
    either!{{(Classical.excludedMiddle (x = y))} {x = y}
      {\fun (same: x = y) => same}
      {\fun (different: Logic.Not (x = y)) => \block {
        \takefrom pair: \Cast[NatPair.NatPair]
          ({ p : NatPair.NatPair \where
            Logic.And[(coordinates.select p).value x = Real.zero,
              (coordinates.select p).value y = Real.one] })
          \by Coord.separationCoordinatesDistinguish topology t1 normal
            coordinates x y different \then
        \let data: Logic.And[
          (coordinates.select pair).value x = Real.zero,
          (coordinates.select pair).value y = Real.one] :=
          \bysub(NatPair.NatPair,
            { p : NatPair.NatPair \where
              Logic.And[(coordinates.select p).value x = Real.zero,
                (coordinates.select p).value y = Real.one] }, pair) \then
        \let sameValues:
          (coordinates.select pair).value x =
            (coordinates.select pair).value y :=
          RM.distanceSeparated
            ((coordinates.select pair).value x)
            ((coordinates.select pair).value y)
            (allZero pair) \then
        \return Logic.falseElim (x = y)
          (RealLaws.zeroNotOne
            (trans!{R.Real} _ _ _
              (sym!{R.Real} _ _ (data.left))
              (trans!{R.Real}
                _ _ _
                sameValues (data.right))))
      }}
    };

\structure PositiveWeights: \Set := {
  weight: NatPair.NatPair -> R.Real,
  ceiling: R.Real,
  positive: \forall (pair: NatPair.NatPair) ->
    R.Lt Real.zero (weight pair),
  bounded: \forall (pair: NatPair.NatPair) ->
    R.Le (weight pair) ceiling,
};

\structure WeightedCoordinateMetric[
  topology: T.Topology,
  coordinates: Coord.SeparationCoordinates[topology],
  weights: PositiveWeights]: \Set := {
  family: SM.CappedCoordinates,
  weightEq: \forall (pair: NatPair.NatPair) ->
    family.weight pair = weights.weight pair,
  componentEq: \forall (pair: NatPair.NatPair) (x, y: Carrier) ->
    family.component pair x y =
      coordinateDistance topology coordinates pair x y,
};

\definition weightedFamilyExists[topology: T.Topology]:
  T.IsT1 topology ->
  T.IsNormal topology ->
  \forall (coordinates: Coord.SeparationCoordinates[topology]) ->
  \forall (weights: PositiveWeights) ->
  \exists WeightedCoordinateMetric[topology, coordinates, weights] :=
  \block {
    \fun (t1: T.IsT1 topology) (normal: T.IsNormal topology)
      (coordinates: Coord.SeparationCoordinates[topology]) (weights: PositiveWeights) \then
    \let family: SM.CappedCoordinates :=
      SM.CappedCoordinates {
      anchor := NatPair.natPair N.Nat^::zero N.Nat^::zero,
      ceiling := weights.ceiling,
      weight := weights.weight,
      component := coordinateDistance topology coordinates,

      weightNonnegative := \fun (pair: NatPair.NatPair) =>
        RealOrder.leOfLt Real.zero (weights.weight pair)
          (weights.positive pair),
      weightBounded := weights.bounded,
      componentNonnegative := \fun (pair: NatPair.NatPair) =>
        \fun (x, y: Carrier) =>
          RM.distanceNonnegative
            ((coordinates.select pair).value x)
            ((coordinates.select pair).value y),
      componentSelf := \fun (pair: NatPair.NatPair) =>
        \fun (x: Carrier) =>
          RM.distanceSelf ((coordinates.select pair).value x),
      componentSymmetric := \fun (pair: NatPair.NatPair) =>
        \fun (x, y: Carrier) =>
          RM.distanceSymmetric
            ((coordinates.select pair).value x)
            ((coordinates.select pair).value y),
      componentTriangle := \fun (pair: NatPair.NatPair) =>
        \fun (x, y, z: Carrier) =>
          RM.distanceTriangle
            ((coordinates.select pair).value x)
            ((coordinates.select pair).value y)
            ((coordinates.select pair).value z),
      separated := \fun (x, y: Carrier) =>
        \fun (allZero: \forall (pair: NatPair.NatPair) ->
          RM.min (weights.weight pair)
            (coordinateDistance topology coordinates pair x y) =
            Real.zero) =>
          coordinateDistancesSeparate topology t1 normal
            coordinates x y
            (\fun (pair: NatPair.NatPair) =>
              RM.minPositiveZero (weights.weight pair)
                (coordinateDistance topology coordinates pair x y)
                (weights.positive pair) (allZero pair)),
    } \then
    \return \exact(
      WeightedCoordinateMetric[topology, coordinates, weights] {
        family := family,

        weightEq := \fun (pair: NatPair.NatPair) =>
          \refl(weights.weight pair),
        componentEq := \fun (pair: NatPair.NatPair) =>
          \fun (x, y: Carrier) =>
            \refl(coordinateDistance topology coordinates pair x y),
      }, WeightedCoordinateMetric[topology, coordinates, weights])
  };

\definition pairRank[pair: NatPair.NatPair]: N.Nat^ :=
  NatOp.add
    (NatPair.natPairFirst pair) (NatPair.natPairSecond pair);

\definition errorWeights: PositiveWeights :=
  PositiveWeights {
    weight := \fun (pair: NatPair.NatPair) =>
      Real.ofRat (Estimates.error (pairRank pair)),
    ceiling := Real.ofRat (Estimates.error N.Nat^::zero),

    positive := \fun (pair: NatPair.NatPair) =>
      RealLaws.ltOfRat Estimates.zeroRat
        (Estimates.error (pairRank pair))
        (Estimates.errorPositive (pairRank pair)),
    bounded := \fun (pair: NatPair.NatPair) =>
      RM.ofRatLe (Estimates.error (pairRank pair))
        (Estimates.error N.Nat^::zero)
        (Estimates.errorAntitone N.Nat^::zero (pairRank pair)
          (NatOrder.zeroLe (pairRank pair))),
  };

\definition errorWeightsEventuallySmall[eps: Estimates.Rat]:
  Estimates.Positive eps ->
  \exists ( bound: N.Nat^ \where
    \forall (pair: NatPair.NatPair) ->
      NatOrder.Le bound (pairRank pair) ->
        R.Lt (errorWeights.weight pair) (Real.ofRat eps) ) :=
  \block {
    \fun (positive: Estimates.Positive eps) \then
    \takefrom bound: \Cast[N.Nat^]
      ({ n : N.Nat^ \where
        \forall (m: N.Nat^) -> NatOrder.Le n m ->
          Estimates.ltRat (Estimates.error m) eps })
      \by Estimates.errorEventuallySmall eps positive \then
    \let data: \forall (m: N.Nat^) -> NatOrder.Le bound m ->
      Estimates.ltRat (Estimates.error m) eps :=
      \bysub(N.Nat^,
        { n : N.Nat^ \where
          \forall (m: N.Nat^) -> NatOrder.Le n m ->
            Estimates.ltRat (Estimates.error m) eps }, bound) \then
    \return Logic.existsIntro[N.Nat^, { n : N.Nat^ \where
          \forall (pair: NatPair.NatPair) ->
            NatOrder.Le n (pairRank pair) ->
              R.Lt (errorWeights.weight pair) (Real.ofRat eps) }] bound
      (\fun (pair: NatPair.NatPair) =>
          \fun (large: NatOrder.Le bound (pairRank pair)) =>
            RealLaws.ltOfRat (Estimates.error (pairRank pair))
              eps (data (pairRank pair) large))
  };

\definition errorWeightsSmallReal[radius: R.Real]:
  R.Lt Real.zero radius ->
  \exists ( bound: N.Nat^ \where
    \forall (pair: NatPair.NatPair) ->
      NatOrder.Le bound (pairRank pair) ->
        R.Lt (errorWeights.weight pair) radius ) := \block {
    \fun (positive: R.Lt Real.zero radius) \then
    \takefrom eps: \Cast[Estimates.Rat]
      ({ q : Estimates.Rat \where
        Logic.And[R.Lt Real.zero (Real.ofRat q),
          R.Lt (Real.ofRat q) radius] })
      \by RealLaws.rationalDensity Real.zero radius positive \then
    \let epsData: Logic.And[R.Lt Real.zero (Real.ofRat eps),
      R.Lt (Real.ofRat eps) radius] :=
      \bysub(Estimates.Rat,
        { q : Estimates.Rat \where
          Logic.And[R.Lt Real.zero (Real.ofRat q),
            R.Lt (Real.ofRat q) radius] }, eps) \then
    \takefrom bound: \Cast[N.Nat^]
      ({ n : N.Nat^ \where
        \forall (pair: NatPair.NatPair) ->
          NatOrder.Le n (pairRank pair) ->
            R.Lt (errorWeights.weight pair) (Real.ofRat eps) })
      \by errorWeightsEventuallySmall eps
        (RealLaws.ofRatLt Estimates.zeroRat eps
          (epsData.left)) \then
    \let small: \forall (pair: NatPair.NatPair) ->
      NatOrder.Le bound (pairRank pair) ->
        R.Lt (errorWeights.weight pair) (Real.ofRat eps) :=
      \bysub(N.Nat^,
        { n : N.Nat^ \where
          \forall (pair: NatPair.NatPair) ->
            NatOrder.Le n (pairRank pair) ->
              R.Lt (errorWeights.weight pair) (Real.ofRat eps) },
        bound) \then
    \return Logic.existsIntro[N.Nat^, { n : N.Nat^ \where
          \forall (pair: NatPair.NatPair) ->
            NatOrder.Le n (pairRank pair) ->
              R.Lt (errorWeights.weight pair) radius }] bound
      (\fun (pair: NatPair.NatPair) =>
          \fun (large: NatOrder.Le bound (pairRank pair)) =>
            RealOrder.ltTrans (errorWeights.weight pair)
              (Real.ofRat eps) radius
              (small pair large) (epsData.right))
  };

\definition CoordinateSmall[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [pair: NatPair.NatPair] [x: Carrier]
  [radius: R.Real]: \Pow Carrier :=
  { y: Carrier \where
    R.Lt (coordinateDistance topology coordinates pair x y) radius };

\definition CoordinatesLocallyContinuous[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]]: \Prop :=
  \forall (pair: NatPair.NatPair) (x: Carrier) (radius: R.Real) ->
    R.Lt Real.zero radius ->
      T.IsOpenIn topology
        (CoordinateSmall topology coordinates pair x radius);

\definition coordinateSmallOpen[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [pair: NatPair.NatPair] [x: Carrier]
  [radius: R.Real]:
  R.Lt Real.zero radius ->
  T.IsOpenIn topology
    (CoordinateSmall topology coordinates pair x radius) :=
  \fun (_: R.Lt Real.zero radius) =>
    T.openOfNeighborhoods topology
      (CoordinateSmall topology coordinates pair x radius)
      (\fun (y: Carrier) =>
        \fun (near: T.Member
          (CoordinateSmall topology coordinates pair x radius) y) =>
          \block {
            \let f: Carrier -> R.Real :=
              (coordinates.select pair).value \then
            \let a: R.Real := f x \then
            \let b: R.Real := f y \then
            \takefrom lower: \Cast[Estimates.Rat]
              ({ q: Estimates.Rat \where
                Logic.And[R.Lt (Real.sub a radius) (Real.ofRat q),
                  R.Lt (Real.ofRat q) b] })
              \by RealLaws.rationalDensity (Real.sub a radius) b
                (RM.distanceLtLower a b radius near) \then
            \let lowerData:
              Logic.And[R.Lt (Real.sub a radius) (Real.ofRat lower),
                R.Lt (Real.ofRat lower) b] :=
              \bysub(Estimates.Rat,
                { q: Estimates.Rat \where
                  Logic.And[R.Lt (Real.sub a radius) (Real.ofRat q),
                    R.Lt (Real.ofRat q) b] }, lower) \then
            \takefrom upper: \Cast[Estimates.Rat]
              ({ q: Estimates.Rat \where
                Logic.And[R.Lt b (Real.ofRat q),
                  R.Lt (Real.ofRat q) (Real.add a radius)] })
              \by RealLaws.rationalDensity b (Real.add a radius)
                (RM.distanceLtUpper a b radius near) \then
            \let upperData:
              Logic.And[R.Lt b (Real.ofRat upper),
                R.Lt (Real.ofRat upper) (Real.add a radius)] :=
              \bysub(Estimates.Rat,
                { q: Estimates.Rat \where
                  Logic.And[R.Lt b (Real.ofRat q),
                    R.Lt (Real.ofRat q) (Real.add a radius)] }, upper)
              \then
            \let V: \Pow Carrier :=
              T.Intersection
                (Urysohn.FunctionLowerRay f lower)
                (Urysohn.FunctionUpperCut f upper) \then
            \return Logic.existsIntro[\Pow Carrier, { W: \Pow Carrier \where
                  T.OpenNeighborhood[topology, y, (CoordinateSmall topology coordinates pair x radius), W] }] V
              (T.OpenNeighborhood[topology, y,
                  (CoordinateSmall topology coordinates pair x radius), V]::#
                  ((T.topologyLaws topology).intersectionOpen
                    (Urysohn.FunctionLowerRay f lower)
                    (Urysohn.FunctionUpperCut f upper)
                    ((coordinates.select pair).lowerOpen lower)
                    ((coordinates.select pair).upperOpen upper))
                  (T.intersectionMember
                      (Urysohn.FunctionLowerRay f lower)
                      (Urysohn.FunctionUpperCut f upper) y
                      (RM.memberOfLt lower b (lowerData.right))
                      (RM.upperCutOfLt b upper (upperData.left)))
                  (\fun (z: Carrier) =>
                      \fun (inV: T.Member V z) =>
                        RM.distanceLtOfInterval a (f z) radius
                          (RealOrder.ltTrans (Real.sub a radius)
                            (Real.ofRat lower) (f z)
                            (lowerData.left)
                            (RM.ltOfMember lower (f z)
                              (inV.left)))
                          (RealOrder.ltTrans (f z)
                            (Real.ofRat upper) (Real.add a radius)
                            (RM.ltOfUpperCut (f z) upper
                              (inV.right))
                            (upperData.right))))
          });

\definition coordinatesLocallyContinuous[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]]:
  CoordinatesLocallyContinuous topology coordinates :=
  coordinateSmallOpen topology coordinates;

\definition centerInCoordinateSmall[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [pair: NatPair.NatPair] [x: Carrier]
  [radius: R.Real]:
  R.Lt Real.zero radius ->
  T.Member (CoordinateSmall topology coordinates pair x radius) x :=
  R.ltReplaceLeft Real.zero
    (coordinateDistance topology coordinates pair x x) radius
    (sym!{R.Real} _ _
      (RM.distanceSelf ((coordinates.select pair).value x)));

\definition singletonWithinCoordinateSmall[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [pair: NatPair.NatPair] [x: Carrier]
  [radius: R.Real]:
  R.Lt Real.zero radius ->
  T.Subset (T.Singleton x)
    (CoordinateSmall topology coordinates pair x radius) :=
  \fun (positive: R.Lt Real.zero radius) (y: Carrier) (same: T.Member (T.Singleton x) y) =>
      \idelim x = y
        \with z: Carrier =>
          T.Member (CoordinateSmall topology coordinates pair x radius) z
        \by { base: centerInCoordinateSmall topology coordinates
          pair x radius positive,
          equality: sym!{Carrier} y x same };

\definition RowSmall[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [i: N.Nat^] [x: Carrier] [radius: R.Real]
  [n: N.Nat^]: \Pow Carrier :=
  Normal.PrefixIntersection
    (\fun (j: N.Nat^) =>
      CoordinateSmall topology coordinates (NatPair.natPair i j)
        x radius) n;

\definition rowSmallOpen[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]]:
  CoordinatesLocallyContinuous topology coordinates -> \forall (i: N.Nat^) ->
  \forall (x: Carrier) -> \forall (radius: R.Real) -> R.Lt Real.zero radius ->
  \forall (n: N.Nat^) ->
  T.IsOpenIn topology (RowSmall topology coordinates i x radius n) :=
  \fun (continuous: CoordinatesLocallyContinuous topology coordinates) (i: N.Nat^) (x: Carrier)
    (radius: R.Real) (positive: R.Lt Real.zero radius) (n: N.Nat^) =>
    Normal.prefixOpen topology
      (\fun (j: N.Nat^) =>
        CoordinateSmall topology coordinates (NatPair.natPair i j)
          x radius)
      (\fun (j: N.Nat^) =>
        continuous (NatPair.natPair i j) x radius positive) n;

\definition rowSmallContainsCenter[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [i: N.Nat^] [x: Carrier] [radius: R.Real]:
  R.Lt Real.zero radius -> \forall (n: N.Nat^) ->
  T.Subset (T.Singleton x)
    (RowSmall topology coordinates i x radius n) :=
  \fun (positive: R.Lt Real.zero radius) (n: N.Nat^) =>
    Normal.prefixContainsSet
      (\fun (j: N.Nat^) =>
        CoordinateSmall topology coordinates (NatPair.natPair i j)
          x radius)
      (T.Singleton x)
      (\fun (j: N.Nat^) =>
        singletonWithinCoordinateSmall topology coordinates
          (NatPair.natPair i j) x radius positive) n;

\definition SquareSmall[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [x: Carrier] [radius: R.Real] [n: N.Nat^]:
  \Pow Carrier :=
  Normal.PrefixIntersection
    (\fun (i: N.Nat^) =>
      RowSmall topology coordinates i x radius n) n;

\definition squareSmallOpen[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]]:
  CoordinatesLocallyContinuous topology coordinates -> \forall (x: Carrier) ->
  \forall (radius: R.Real) -> R.Lt Real.zero radius -> \forall (n: N.Nat^) ->
  T.IsOpenIn topology (SquareSmall topology coordinates x radius n) :=
  \fun (continuous: CoordinatesLocallyContinuous topology coordinates) (x: Carrier) (radius: R.Real)
    (positive: R.Lt Real.zero radius) (n: N.Nat^) =>
    Normal.prefixOpen topology
      (\fun (i: N.Nat^) =>
        RowSmall topology coordinates i x radius n)
      (\fun (i: N.Nat^) =>
        rowSmallOpen topology coordinates continuous i x radius
          positive n) n;

\definition squareSmallContainsCenter[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [x: Carrier] [radius: R.Real]:
  R.Lt Real.zero radius -> \forall (n: N.Nat^) ->
  T.Member (SquareSmall topology coordinates x radius n) x :=
  \fun (positive: R.Lt Real.zero radius) (n: N.Nat^) =>
    Normal.prefixContainsSet
      (\fun (i: N.Nat^) =>
        RowSmall topology coordinates i x radius n)
      (T.Singleton x)
      (\fun (i: N.Nat^) =>
        rowSmallContainsCenter topology coordinates i x radius
          positive n) n x (\refl(x));

\definition squareSmallContainsCoordinate[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [x: Carrier] [radius: R.Real]
  [n, i, j: N.Nat^]:
  NatOrder.Le i n -> NatOrder.Le j n ->
  T.Subset (SquareSmall topology coordinates x radius n)
    (CoordinateSmall topology coordinates (NatPair.natPair i j)
      x radius) :=
  \fun (in: NatOrder.Le i n) (jn: NatOrder.Le j n) =>
    T.subsetTrans (SquareSmall topology coordinates x radius n)
      (RowSmall topology coordinates i x radius n)
      (CoordinateSmall topology coordinates (NatPair.natPair i j)
        x radius)
      (Normal.prefixContains
        (\fun (k: N.Nat^) =>
          RowSmall topology coordinates k x radius n)
        n i in)
      (Normal.prefixContains
        (\fun (k: N.Nat^) =>
          CoordinateSmall topology coordinates (NatPair.natPair i k)
            x radius)
        n j jn);

\definition natLeTotal:
  \forall (a, b: N.Nat^) ->
    Logic.Or[NatOrder.Le a b, NatOrder.Le b a] :=
  \induction (a: N.Nat^) \return
    \forall (b: N.Nat^) ->
      Logic.Or[NatOrder.Le a b, NatOrder.Le b a] \with {
    | zero: \fun (b: N.Nat^) =>
        Logic.Or[_, _]::left (NatOrder.zeroLe b)
    | succ: \fun (a: N.Nat^)
        (ih: \forall (b: N.Nat^) ->
          Logic.Or[NatOrder.Le a b, NatOrder.Le b a]) =>
        \induction (b: N.Nat^) \return
          Logic.Or[NatOrder.Le (N.Nat^::succ a) b,
            NatOrder.Le b (N.Nat^::succ a)] \with {
          | zero: Logic.Or[_, _]::right
              (NatOrder.zeroLe (N.Nat^::succ a))
          | succ: \fun (b: N.Nat^) (_: _) =>
              either!{{(ih b)} {Logic.Or[
                  NatOrder.Le (N.Nat^::succ a) (N.Nat^::succ b),
                  NatOrder.Le (N.Nat^::succ b) (N.Nat^::succ a)]}
                {\fun (ab: NatOrder.Le a b) =>
                  Logic.Or[_, _]::left
                    (NatOrder.leSuccSucc a b ab)}
                {\fun (ba: NatOrder.Le b a) =>
                  Logic.Or[_, _]::right
                    (NatOrder.leSuccSucc b a ba)}
              }
        }
  };

\definition rankBounds[pair: NatPair.NatPair] [n: N.Nat^]:
  NatOrder.Le (pairRank pair) n ->
  Logic.And[
    NatOrder.Le (NatPair.natPairFirst pair) n,
    NatOrder.Le (NatPair.natPairSecond pair) n] :=
  \fun (small: NatOrder.Le (pairRank pair) n) =>
    Logic.And[_, _]::#
      (NatOrder.leTrans (NatPair.natPairFirst pair)
        (pairRank pair) n
        (NatOrder.leAddRight (NatPair.natPairFirst pair)
          (NatPair.natPairSecond pair)) small)
      (NatOrder.leTrans (NatPair.natPairSecond pair)
        (pairRank pair) n
        (NatOrder.leAddLeft (NatPair.natPairFirst pair)
          (NatPair.natPairSecond pair)) small);

\definition pairEta:
  \forall (pair: NatPair.NatPair) ->
    NatPair.natPair (NatPair.natPairFirst pair)
      (NatPair.natPairSecond pair) = pair :=
  NatPair.natPairElim
    (\fun (pair: NatPair.NatPair) =>
      NatPair.natPair (NatPair.natPairFirst pair)
        (NatPair.natPairSecond pair) = pair)
    (\fun (i, j: N.Nat^) => \refl(NatPair.natPair i j));

\definition squareSmallContainsPair[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [x: Carrier] [radius: R.Real] [n: N.Nat^]
  [pair: NatPair.NatPair]:
  NatOrder.Le (pairRank pair) n ->
  T.Subset (SquareSmall topology coordinates x radius n)
    (CoordinateSmall topology coordinates pair x radius) :=
  \fun (small: NatOrder.Le (pairRank pair) n) =>
    \idelim
      NatPair.natPair (NatPair.natPairFirst pair)
        (NatPair.natPairSecond pair) = pair
      \with p: NatPair.NatPair =>
        T.Subset (SquareSmall topology coordinates x radius n)
          (CoordinateSmall topology coordinates p x radius)
      \by {
        base: squareSmallContainsCoordinate topology coordinates
          x radius n (NatPair.natPairFirst pair)
          (NatPair.natPairSecond pair)
          ((rankBounds pair n small).left)
          ((rankBounds pair n small).right),
        equality: pairEta pair
      };

\definition squareCappedBelow[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [family: SM.CappedCoordinates]:
  (\forall (pair: NatPair.NatPair) ->
    family.weight pair = errorWeights.weight pair) ->
  (\forall (pair: NatPair.NatPair) (x, y: Carrier) ->
    family.component pair x y =
      coordinateDistance topology coordinates pair x y) ->
  \forall (x, y: Carrier) -> \forall (radius: R.Real) -> \forall (n: N.Nat^) ->
  (\forall (pair: NatPair.NatPair) ->
    NatOrder.Le n (pairRank pair) ->
      R.Lt (errorWeights.weight pair) radius) ->
  T.Member
    (SquareSmall topology coordinates x radius n) y ->
  \forall (pair: NatPair.NatPair) ->
  R.Le (SM.capped family pair x y) radius :=
  \fun (weightEq: \forall (pair: NatPair.NatPair) ->
    family.weight pair = errorWeights.weight pair)
    (componentEq: \forall (pair: NatPair.NatPair) (x, y: Carrier) ->
    family.component pair x y =
      coordinateDistance topology coordinates pair x y) (x, y: Carrier) (radius: R.Real) (n: N.Nat^)
    (tail: \forall (pair: NatPair.NatPair) ->
    NatOrder.Le n (pairRank pair) ->
      R.Lt (errorWeights.weight pair) radius)
    (inside: T.Member
    (SquareSmall topology coordinates x radius n) y) (pair: NatPair.NatPair) =>
    either!{{(natLeTotal n (pairRank pair))} {R.Le (SM.capped family pair x y) radius}
      {\fun (large: NatOrder.Le n (pairRank pair)) =>
        R.leTrans (SM.capped family pair x y)
          (family.weight pair) radius
          (RM.minLeft (family.weight pair)
            (family.component pair x y))
          (R.leReplaceLeft (errorWeights.weight pair)
            (family.weight pair) radius
            (sym!{R.Real} _ _ (weightEq pair))
            (RealOrder.leOfLt (errorWeights.weight pair)
              radius (tail pair large)))}
      {\fun (small: NatOrder.Le (pairRank pair) n) =>
        R.leTrans (SM.capped family pair x y)
          (family.component pair x y) radius
          (RM.minRight (family.weight pair)
            (family.component pair x y))
          (R.leReplaceLeft
            (coordinateDistance topology coordinates pair x y)
            (family.component pair x y) radius
            (sym!{R.Real} _ _ (componentEq pair x y))
            (RealOrder.leOfLt
              (coordinateDistance topology coordinates pair x y)
              radius
              (squareSmallContainsPair topology coordinates x radius
                n pair small y inside)))}
    };

\definition squareDistanceBelow[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [family: SM.CappedCoordinates]:
  (\forall (pair: NatPair.NatPair) ->
    family.weight pair = errorWeights.weight pair) ->
  (\forall (pair: NatPair.NatPair) (x, y: Carrier) ->
    family.component pair x y =
      coordinateDistance topology coordinates pair x y) ->
  \forall (x: Carrier) -> \forall (smallRadius, radius: R.Real) ->
  R.Lt smallRadius radius -> \forall (n: N.Nat^) ->
  (\forall (pair: NatPair.NatPair) ->
    NatOrder.Le n (pairRank pair) ->
      R.Lt (errorWeights.weight pair) smallRadius) ->
  T.Subset (SquareSmall topology coordinates x smallRadius n)
    (Metric.Ball (SM.metric family) x radius) :=
  \fun (weightEq: \forall (pair: NatPair.NatPair) ->
    family.weight pair = errorWeights.weight pair)
    (componentEq: \forall (pair: NatPair.NatPair) (x, y: Carrier) ->
    family.component pair x y =
      coordinateDistance topology coordinates pair x y) (x: Carrier) (smallRadius, radius: R.Real)
    (smallBelow: R.Lt smallRadius radius) (n: N.Nat^)
    (tail: \forall (pair: NatPair.NatPair) ->
    NatOrder.Le n (pairRank pair) ->
      R.Lt (errorWeights.weight pair) smallRadius) =>
    \fun (y: Carrier) =>
      \fun (inside: T.Member
        (SquareSmall topology coordinates x smallRadius n) y) =>
        R.leLtTrans (SM.distance family x y) smallRadius radius
          (Complete.supremumLeast (SM.familyAsComplete family x y)
            smallRadius
            (SM.familyUpperBoundOf family x y smallRadius
              (\fun (pair: NatPair.NatPair) =>
                squareCappedBelow topology coordinates family
                  weightEq componentEq x y smallRadius n tail
                  inside pair)))
          smallBelow;

\definition metricBallHasOriginalNeighborhood[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]]:
  CoordinatesLocallyContinuous topology coordinates ->
  \forall (family: SM.CappedCoordinates) ->
  (\forall (pair: NatPair.NatPair) ->
    family.weight pair = errorWeights.weight pair) ->
  (\forall (pair: NatPair.NatPair) (x, y: Carrier) ->
    family.component pair x y =
      coordinateDistance topology coordinates pair x y) ->
  \forall (x: Carrier) -> \forall (radius: R.Real) -> R.Lt Real.zero radius ->
  \exists ( V: \Pow Carrier \where
    T.OpenNeighborhood[topology, x, (Metric.Ball (SM.metric family) x radius), V] ) :=
  \block {
    \fun (continuous: CoordinatesLocallyContinuous topology coordinates)
      (family: SM.CappedCoordinates)
      (weightEq: \forall (pair: NatPair.NatPair) ->
    family.weight pair = errorWeights.weight pair)
      (componentEq: \forall (pair: NatPair.NatPair) (x, y: Carrier) ->
    family.component pair x y =
      coordinateDistance topology coordinates pair x y) (x: Carrier) (radius: R.Real)
      (positive: R.Lt Real.zero radius) \then
    \takefrom eps: \Cast[Estimates.Rat]
      ({ q: Estimates.Rat \where
        Logic.And[R.Lt Real.zero (Real.ofRat q),
          R.Lt (Real.ofRat q) radius] })
      \by RealLaws.rationalDensity Real.zero radius positive \then
    \let epsData: Logic.And[R.Lt Real.zero (Real.ofRat eps),
      R.Lt (Real.ofRat eps) radius] :=
      \bysub(Estimates.Rat,
        { q: Estimates.Rat \where
          Logic.And[R.Lt Real.zero (Real.ofRat q),
            R.Lt (Real.ofRat q) radius] }, eps) \then
    \takefrom bound: \Cast[N.Nat^]
      ({ n: N.Nat^ \where
        \forall (pair: NatPair.NatPair) ->
          NatOrder.Le n (pairRank pair) ->
            R.Lt (errorWeights.weight pair) (Real.ofRat eps) })
      \by errorWeightsSmallReal (Real.ofRat eps)
        (epsData.left) \then
    \let tail: \forall (pair: NatPair.NatPair) ->
      NatOrder.Le bound (pairRank pair) ->
        R.Lt (errorWeights.weight pair) (Real.ofRat eps) :=
      \bysub(N.Nat^,
        { n: N.Nat^ \where
          \forall (pair: NatPair.NatPair) ->
            NatOrder.Le n (pairRank pair) ->
              R.Lt (errorWeights.weight pair) (Real.ofRat eps) },
        bound) \then
    \let V: \Pow Carrier :=
      SquareSmall topology coordinates x (Real.ofRat eps) bound \then
    \return Logic.existsIntro[\Pow Carrier, { W: \Pow Carrier \where
          T.OpenNeighborhood[topology, x, (Metric.Ball (SM.metric family) x radius), W] }] V
      (T.OpenNeighborhood[topology, x,
          (Metric.Ball (SM.metric family) x radius), V]::#
          (squareSmallOpen topology coordinates continuous x
            (Real.ofRat eps) (epsData.left) bound)
          (squareSmallContainsCenter topology coordinates x
              (Real.ofRat eps) (epsData.left) bound)
          (squareDistanceBelow topology coordinates family
            weightEq componentEq x (Real.ofRat eps) radius
            (epsData.right) bound tail))
  };

\definition metricOpenInOriginal[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]]:
  CoordinatesLocallyContinuous topology coordinates ->
  \forall (family: SM.CappedCoordinates) ->
  (\forall (pair: NatPair.NatPair) ->
    family.weight pair = errorWeights.weight pair) ->
  (\forall (pair: NatPair.NatPair) (x, y: Carrier) ->
    family.component pair x y =
      coordinateDistance topology coordinates pair x y) ->
  \forall (U: \Pow Carrier) -> Metric.IsOpen (SM.metric family) U ->
  T.IsOpenIn topology U :=
  \fun (continuous: CoordinatesLocallyContinuous topology coordinates)
    (family: SM.CappedCoordinates)
    (weightEq: \forall (pair: NatPair.NatPair) ->
    family.weight pair = errorWeights.weight pair)
    (componentEq: \forall (pair: NatPair.NatPair) (x, y: Carrier) ->
    family.component pair x y =
      coordinateDistance topology coordinates pair x y) (U: \Pow Carrier)
    (open: Metric.IsOpen (SM.metric family) U) =>
    T.openOfNeighborhoods topology U
      (\fun (x: Carrier) =>
        \fun (inside: T.Member U x) => \block {
          \takefrom radius: \Cast[R.Real]
            (Metric.NeighborhoodRadius (SM.metric family) U x)
            \by open x inside \then
          \let radiusData: Logic.And[R.Lt Real.zero radius,
            T.Subset (Metric.Ball (SM.metric family) x radius) U] :=
            \bysub(R.Real,
              Metric.NeighborhoodRadius (SM.metric family) U x,
              radius) \then
          \takefrom V: \Cast[\Pow Carrier]
            ({ W: \Pow Carrier \where
              T.OpenNeighborhood[topology, x, (Metric.Ball (SM.metric family) x radius), W] })
            \by metricBallHasOriginalNeighborhood topology coordinates
              continuous family weightEq componentEq x radius
              (radiusData.left) \then
          \let data: T.OpenNeighborhood[topology, x, (Metric.Ball (SM.metric family) x radius), V] :=
            \bysub(\Pow Carrier,
              { W: \Pow Carrier \where
                T.OpenNeighborhood[topology, x, (Metric.Ball (SM.metric family) x radius), W] }, V)
            \then
          \return Logic.existsIntro[\Pow Carrier, { W: \Pow Carrier \where
                T.OpenNeighborhood[topology, x, U, W] }] V
            (T.OpenNeighborhood[topology, x, U, V]::#
                (data.open) (data.contains)
                (T.subsetTrans V
                  (Metric.Ball (SM.metric family) x radius) U
                  (data.within) (radiusData.right)))
        });

\definition weightedRadius[weights: PositiveWeights] [pair: NatPair.NatPair]: R.Real :=
  RM.min (weights.weight pair)
    (RM.distance Real.zero Real.one);

\definition weightedRadiusPositive[weights: PositiveWeights] [pair: NatPair.NatPair]:
  R.Lt Real.zero (weightedRadius weights pair) :=
  RealOrder.ltOfLeNotEq Real.zero (weightedRadius weights pair)
    (RM.minNonnegative (weights.weight pair)
      (RM.distance Real.zero Real.one)
      (RealOrder.leOfLt Real.zero (weights.weight pair)
        (weights.positive pair))
      (RM.distanceNonnegative Real.zero Real.one))
    (\fun (zero: Real.zero = weightedRadius weights pair) =>
      RealLaws.zeroNotOne
        (RM.distanceSeparated Real.zero Real.one
          (RM.minPositiveZero (weights.weight pair)
            (RM.distance Real.zero Real.one)
            (weights.positive pair)
            (sym!{R.Real} _ _ zero))));

\definition weightedRadiusEqual[topology: T.Topology]
  [coordinates: Coord.SeparationCoordinates[topology]] [weights: PositiveWeights]
  [family: SM.CappedCoordinates]:
  (\forall (pair: NatPair.NatPair) ->
    family.weight pair = weights.weight pair) ->
  (\forall (pair: NatPair.NatPair) (x, y: Carrier) ->
    family.component pair x y =
      coordinateDistance topology coordinates pair x y) ->
  \forall (pair: NatPair.NatPair) -> \forall (x, y: Carrier) ->
  (coordinates.select pair).value x = Real.zero ->
  (coordinates.select pair).value y = Real.one ->
  weightedRadius weights pair = SM.capped family pair x y :=
  \fun (weightEq: \forall (pair: NatPair.NatPair) ->
    family.weight pair = weights.weight pair)
    (componentEq: \forall (pair: NatPair.NatPair) (x, y: Carrier) ->
    family.component pair x y =
      coordinateDistance topology coordinates pair x y) (pair: NatPair.NatPair) (x, y: Carrier)
    (xZero: (coordinates.select pair).value x = Real.zero)
    (yOne: (coordinates.select pair).value y = Real.one) =>
    RM.minReplace (weights.weight pair) (family.weight pair)
      (RM.distance Real.zero Real.one)
      (family.component pair x y)
      (sym!{R.Real} _ _ (weightEq pair))
      (trans!{R.Real} _ _ _
        (RM.distanceReplace Real.zero
          ((coordinates.select pair).value x)
          Real.one ((coordinates.select pair).value y)
          (sym!{R.Real} _ _ xZero)
          (sym!{R.Real} _ _ yOne))
        (sym!{R.Real} _ _ (componentEq pair x y)));

\definition originalOpenInWeightedMetric[topology: T.Topology]:
  T.IsT1 topology -> T.IsNormal topology ->
  \forall (coordinates: Coord.SeparationCoordinates[topology]) ->
  \forall (weights: PositiveWeights) -> \forall (family: SM.CappedCoordinates) ->
  (\forall (pair: NatPair.NatPair) ->
    family.weight pair = weights.weight pair) ->
  (\forall (pair: NatPair.NatPair) (x, y: Carrier) ->
    family.component pair x y =
      coordinateDistance topology coordinates pair x y) ->
  \forall (U: \Pow Carrier) -> T.IsOpenIn topology U ->
  Metric.IsOpen (SM.metric family) U :=
  \fun (t1: T.IsT1 topology) (normal: T.IsNormal topology)
    (coordinates: Coord.SeparationCoordinates[topology]) (weights: PositiveWeights)
    (family: SM.CappedCoordinates)
    (weightEq: \forall (pair: NatPair.NatPair) ->
    family.weight pair = weights.weight pair)
    (componentEq: \forall (pair: NatPair.NatPair) (x, y: Carrier) ->
    family.component pair x y =
      coordinateDistance topology coordinates pair x y) (U: \Pow Carrier)
    (open: T.IsOpenIn topology U) =>
    \fun (x: Carrier) => \fun (inside: T.Member U x) => \block {
      \takefrom pair: \Cast[NatPair.NatPair]
        ({ p: NatPair.NatPair \where
          Logic.And[(coordinates.select p).value x = Real.zero,
            \forall (y: Carrier) -> Logic.Not (T.Member U y) ->
              (coordinates.select p).value y = Real.one] })
        \by Coord.separationCoordinatesLocal topology t1 normal
          coordinates U open x inside \then
      \let data: Logic.And[
        (coordinates.select pair).value x = Real.zero,
        \forall (y: Carrier) -> Logic.Not (T.Member U y) ->
          (coordinates.select pair).value y = Real.one] :=
        \bysub(NatPair.NatPair,
          { p: NatPair.NatPair \where
            Logic.And[(coordinates.select p).value x = Real.zero,
              \forall (y: Carrier) -> Logic.Not (T.Member U y) ->
                (coordinates.select p).value y = Real.one] }, pair) \then
      \let radius: R.Real := weightedRadius weights pair \then
      \return MetricTopology.openOfRadius (SM.metric family)
        U x radius (weightedRadiusPositive weights pair)
        (\fun (y: Carrier) =>
          \fun (inBall: T.Member
            (Metric.Ball (SM.metric family) x radius) y) =>
            either!{{(Classical.excludedMiddle (T.Member U y))} {T.Member U y}
              {\fun (inU: T.Member U y) => inU}
              {\fun (outside: Logic.Not (T.Member U y)) =>
                Logic.falseElim (T.Member U y)
                  ((R.ltNotLeReverse (SM.distance family x y)
                    radius inBall)
                    (R.leTrans radius
                      (SM.capped family pair x y)
                      (SM.distance family x y)
                      (R.leReplaceRight radius radius
                        (SM.capped family pair x y)
                        (weightedRadiusEqual topology coordinates
                          weights family weightEq componentEq pair x y
                          (data.left) (data.right y outside))
                        (R.leRefl radius))
                      (SM.cappedUpper family pair x y)))}
            })
    };

\definition errorMetricCompatible[topology: T.Topology]:
  T.IsT1 topology -> T.IsNormal topology ->
  \forall (coordinates: Coord.SeparationCoordinates[topology]) ->
  CoordinatesLocallyContinuous topology coordinates ->
  \forall (data: WeightedCoordinateMetric[topology, coordinates,
    errorWeights]) ->
  MetricTopology.Compatible (SM.metric (data.family)) topology :=
  \fun (t1: T.IsT1 topology) (normal: T.IsNormal topology)
    (coordinates: Coord.SeparationCoordinates[topology])
    (continuous: CoordinatesLocallyContinuous topology coordinates)
    (data: WeightedCoordinateMetric[topology, coordinates,
    errorWeights]) =>
    \fun (U: \Pow Carrier) =>
      Logic.PropEquiv[_, _] {
        ltr := originalOpenInWeightedMetric topology t1 normal
          coordinates errorWeights (data.family)
          (data.weightEq) (data.componentEq) U,
        rtl := metricOpenInOriginal topology coordinates continuous
          (data.family) (data.weightEq)
          (data.componentEq) U,
      };

\definition metrizableOfContinuousCoordinates[topology: T.Topology]:
  T.IsT1 topology -> T.IsNormal topology ->
  \forall (coordinates: Coord.SeparationCoordinates[topology]) ->
  CoordinatesLocallyContinuous topology coordinates ->
  MetricTopology.Metrizable topology := \block {
    \fun (t1: T.IsT1 topology) (normal: T.IsNormal topology)
      (coordinates: Coord.SeparationCoordinates[topology])
      (continuous: CoordinatesLocallyContinuous topology coordinates) \then
    \takefrom data:
      WeightedCoordinateMetric[topology, coordinates, errorWeights]
      \by weightedFamilyExists topology t1 normal coordinates
        errorWeights \then
    \return Logic.existsIntro[Metric.Metric, { metric: Metric.Metric \where
          MetricTopology.Compatible metric topology }] (SM.metric (data.family))
      (errorMetricCompatible topology t1 normal coordinates
          continuous data)
  };

\definition t3SecondCountableMetrizable[topology: T.Topology]:
  T.IsT3 topology -> T.IsSecondCountable topology ->
  MetricTopology.Metrizable topology := \block {
    \fun (t3: T.IsT3 topology) (secondCountable: T.IsSecondCountable topology) \then
    \takefrom coordinates: Coord.SeparationCoordinates[topology]
      \by Coord.separationCoordinatesExist topology t3
        secondCountable \then
    \return metrizableOfContinuousCoordinates topology
      (t3.left)
      (Normal.regularSecondCountableNormal topology
        (t3.right) secondCountable)
      coordinates
      (coordinatesLocallyContinuous topology coordinates)
  };

\definition urysohnMetrization:
  \forall (topology: T.Topology) ->
    T.IsT3 topology -> T.IsSecondCountable topology ->
    MetricTopology.Metrizable topology :=
  \fun (topology: _) (t3: _) (secondCountable: _) =>
      t3SecondCountableMetrizable topology t3 secondCountable;
