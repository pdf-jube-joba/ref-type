\import real.Analysis[] \as Analysis;
\import Analysis.Estimates[] \as Estimates;
\import Estimates.Product[] \as Product;
\import Analysis.Distance[] \as Distance;
\import std.Set[].FiniteSubset[A := \Pow Carrier] \as Finite;
\import \parent.Topology[] \as Topology;
\use Equality.trans;
\use Equality.congr;
\use Logic.either;
\structure LebesgueRadius[metric: Metric, family: \Pow (\Pow Carrier), radius: R.Real]: \Prop := {
  positive: R.Lt Real.zero radius,
  smallBalls: \forall (x: Carrier) -> \exists ( U: \Pow Carrier \where Logic.And[T.FamilyMember family U, T.Subset (Ball metric x radius) U] ),
};
\module Cover(metric: Metric, family: \Pow (\Pow Carrier));
\definition lebesgue: \forall (metric: Metric) -> T.IsCompact (Topology.topology metric) ->
  \forall (family: \Pow (\Pow Carrier)) -> T.IsOpenCover[Topology.topology metric, family, T.Whole] ->
  \exists ( radius: R.Real \where LebesgueRadius[metric, family, radius] ) :=
  \fun (metric: Metric)(compact: T.IsCompact (Topology.topology metric))(family: \Pow (\Pow Carrier)) => Cover[metric := metric, family := family].lebesgue compact;
\module Uniform(B: \Set);
