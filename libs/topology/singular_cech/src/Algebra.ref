\import std.Data[].Nat[] \as N;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Proposition[] \as Logic;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\use Equality.eq_reason;
\import module_theory.Module[].Over[R := R, ring := ring] \as Modules;
\import double_complexes.NonnegativeChain[].Over[R := R, ring := ring] \as Chains;
\module Nilpotent(V: \Set, space: Modules.Space V, operator: Modules.Hom[V := V, W := V, source := space, target := space].Map);
\module Unipotent(V: \Set, space: Modules.Space V, operator: Modules.Hom[V := V, W := V, source := space, target := space].Map);
\module ProjectiveQuasi(C, D: Chains.Complex, f: Chains.Map[C := C, D := D].Map);
\module Concentrated(C: Chains.Complex);
\import chain_complexes.Chain[] \as Degrees;
\import Degrees.Over[R := R, ring := ring] \as Signed;
\import std.Arithmetic[].Int[] \as I;
\module Restriction(C: Signed.Complex);
\module RestrictionZeroExtension(C: Chains.Complex);
\module TensorEquivalence(C, D, E, F: Chains.Complex,
  left: Chains.Equivalence[C := C, D := D].Equivalence,
  right: Chains.Equivalence[C := E, D := F].Equivalence);
