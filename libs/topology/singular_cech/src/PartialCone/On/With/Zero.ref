\definition degree: N.Nat^ := N.Nat^::zero;
\import Modules.Laws[V := Carrier degree, space := space degree] \as Values;
\import algebra.Group[].Of[Carrier := Carrier degree, group := Values.additive] \as Group;
\import Modules.Hom[V := Carrier (N.Nat^::succ degree), W := Carrier degree, source := space (N.Nat^::succ degree), target := space degree] \as Differentials;
\import Modules.Free[Generators := Simplex degree].To[W := I.Int^, target := Modules.scalarModule] \as ToScalar;
\definition augmentation: Modules.Hom[V := Carrier degree, W := I.Int^, source := space degree, target := Modules.scalarModule].Map := ToScalar.extension (\fun (s: Simplex degree) => (Integers.ring).one);
\definition augmentationOnGenerator[s: Simplex degree]: (augmentation).apply (generator degree s) = (Integers.ring).one := ToScalar.onGenerator (\fun (s: Simplex degree) => (Integers.ring).one) s;
\import Modules.Hom[V := I.Int^, W := Carrier degree, source := Modules.scalarModule, target := space degree] \as Centres;
\definition centre: Centres.Map := Centres.Map {
  apply := \fun (a: I.Int^) => (space degree).smul a (generator degree (cone).apex),
  addition := \fun (a, b: I.Int^) => (space degree).scalarAdd a b (generator degree (cone).apex),
  scalar := \fun (a, b: I.Int^) => (space degree).scalarAssoc a b (generator degree (cone).apex),
};
\import Centres.Composition[U := Carrier degree, domain := space degree] \as Composition;
\definition projection: Modules.Hom[V := Carrier degree, W := Carrier degree, source := space degree, target := space degree].Map := Composition.compose centre augmentation;
\definition projectionOnGenerator[s: Simplex degree]: (projection).apply (generator degree s) = generator degree (cone).apex :=
  trans!{{Carrier degree}} _ _ _
    (congr!{{I.Int^} {Carrier degree}} ((centre).apply) _ _ (augmentationOnGenerator s))
    ((space degree).scalarOne (generator degree (cone).apex));
\definition zeroDifference[x: Carrier degree]: Group.difference x Group.zero = x :=
  trans!{{Carrier degree}} _ _ _ (congr!{{Carrier degree} {Carrier degree}} (Group.add x) _ _ Group.negZero) (Group.zeroRight x);
\definition absent[s: Simplex degree][missing: (cone).present degree s = B.Bool^::false]:
  (boundary degree).apply ((homotopy degree).apply (generator degree s)) = Group.difference (generator degree s) (generator degree (cone).apex) :=
  trans!{{Carrier degree}} _ _ _
    (congr!{{Carrier (N.Nat^::succ degree)} {Carrier degree}} ((boundary degree).apply) _ _ (homotopyAbsent degree s missing))
    (trans!{{Carrier degree}} _ _ _ (Chains.Boundary[n := degree].onGenerator (extended degree s missing))
      (congr2!{{Carrier degree} {Carrier degree} {Carrier degree}} Group.difference _ _ _ _
        (congr!{{Simplex degree} {Carrier degree}} (generator degree) _ _ ((cone).first degree s missing))
        (trans!{{Carrier degree}} _ _ _
          (congr!{{Carrier degree} {Carrier degree}} (\fun (x: Carrier degree) => Group.difference x Group.zero) _ _
            (congr!{{Simplex degree} {Carrier degree}} (generator degree) _ _ ((cone).last s missing)))
          (zeroDifference (generator degree (cone).apex)))));
\definition present[s: Simplex degree][present: (cone).present degree s = B.Bool^::true]:
  (boundary degree).apply ((homotopy degree).apply (generator degree s)) = Group.difference (generator degree s) (generator degree (cone).apex) :=
  trans!{{Carrier degree}} _ _ _
    (congr!{{Carrier (N.Nat^::succ degree)} {Carrier degree}} ((boundary degree).apply) _ _ (homotopyPresent degree s present))
    (trans!{{Carrier degree}} _ _ _ (Differentials.zeroPreserved (boundary degree))
      (sym!{{Carrier degree}} _ _
        (trans!{{Carrier degree}} _ _ _
          (congr!{{Carrier degree} {Carrier degree}} (Group.difference (generator degree s)) _ _
            (sym!{{Carrier degree}} _ _ (congr!{{Simplex degree} {Carrier degree}} (generator degree) _ _ ((cone).zero s present))))
          (Group.inverseRight (generator degree s)))));
\definition onGenerator[s: Simplex degree]:
  (boundary degree).apply ((homotopy degree).apply (generator degree s)) = Group.difference (generator degree s) (generator degree (cone).apex) :=
  (\induction (flag: B.Bool^) \return (cone).present degree s = flag ->
    (boundary degree).apply ((homotopy degree).apply (generator degree s)) = Group.difference (generator degree s) (generator degree (cone).apex) \with {
    | true: present s
    | false: absent s
  }) ((cone).present degree s) (\refl((cone).present degree s));
\import Modules.Hom[V := Carrier degree, W := Carrier degree, source := space degree, target := space degree] \as End;
\import Modules.End[V := Carrier degree, space := space degree] \as Identity;
\import Differentials.Composition[U := Carrier degree, domain := space degree] \as After;
\import Modules.Free[Generators := Simplex degree].To[W := Carrier degree, target := space degree] \as Free;
\definition equality: After.compose (boundary degree) (homotopy degree) = End.plus Identity.identity (End.negative projection) :=
  Free.ext _ _ (\fun (s: Simplex degree) => trans!{{Carrier degree}} _ _ _ (onGenerator s)
    (congr!{{Carrier degree} {Carrier degree}} (Group.difference (generator degree s)) _ _ (sym!{{Carrier degree}} _ _ (projectionOnGenerator s))));
\definition law[x: Carrier degree]: (boundary degree).apply ((homotopy degree).apply x) = Group.difference x ((projection).apply x) :=
  congr!{{End.Map} {Carrier degree}} (\fun (f: End.Map) => (f).apply x) _ _ equality;
\definition cycle[x: Carrier degree][reduced: (augmentation).apply x = (Modules.scalarModule).zero]:
  (boundary degree).apply ((homotopy degree).apply x) = x :=
  trans!{{Carrier degree}} _ _ _ (law x)
    (trans!{{Carrier degree}} _ _ _
      (congr!{{Carrier degree} {Carrier degree}} (Group.difference x) _ _
        (trans!{{Carrier degree}} _ _ _ (congr!{{I.Int^} {Carrier degree}} ((centre).apply) _ _ reduced) (Centres.zeroPreserved centre)))
      (zeroDifference x));
