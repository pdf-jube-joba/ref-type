\module At(n: N.Nat^) {
  \import \parent.\parent.Degree[n := n] \as Kernel;
  \import Modules.Hom[V := C.family.Carrier n, W := C.family.Carrier n, source := C.family.space n, target := C.family.space n] \as Ambient;
  \import Modules.Hom[V := D.family.Carrier n, W := C.family.Carrier n, source := D.family.space n, target := C.family.space n] \as SectionMaps;
  \import SectionMaps.Composition[U := C.family.Carrier n, domain := C.family.space n] \as Compose;
  \import Modules.End[V := C.family.Carrier n, space := C.family.space n] \as End;
  \import Modules.Laws[V := C.family.Carrier n, space := C.family.space n] \as Source;
  \import algebra.Group[].Of[Carrier := C.family.Carrier n, group := Source.additive] \as Group;
  \import Modules.Laws[V := D.family.Carrier n, space := D.family.space n] \as Target;
  \import algebra.Group[].Of[Carrier := D.family.Carrier n, group := Target.additive] \as TargetGroup;
  \import Modules.Hom[V := C.family.Carrier n, W := D.family.Carrier n, source := C.family.space n, target := D.family.space n] \as Forward;
  \definition ambient: Ambient.Map := Ambient.plus End.identity (Ambient.negative (Compose.compose (s n) (Maps.At[n := n].linear f)));
  \definition killed: \forall (x: C.family.Carrier n) -> #apply{f} n (#apply{ambient} x) = TargetGroup.zero :=
    \fun (x: C.family.Carrier n) => trans!{{D.family.Carrier n}} _ _ _
      (Forward.differencePreserved (Maps.At[n := n].linear f) x (#apply{(s n)} (#apply{f} n x)))
      (trans!{{D.family.Carrier n}} _ _ _
        (congr!{{D.family.Carrier n} {D.family.Carrier n}} (\fun (v: D.family.Carrier n) => TargetGroup.difference (#apply{f} n x) v) _ _ (splits n (#apply{f} n x)))
        (TargetGroup.inverseRight (#apply{f} n x)));
  \import Modules.Hom[V := C.family.Carrier n, W := Kernel.Carrier, source := C.family.space n, target := Kernel.space] \as Retractions;
  \definition retraction: Retractions.Map := Retractions.Map {
    apply := \fun (x: C.family.Carrier n) => Kernel.intro (#apply{ambient} x) (killed x),
    addition := #addition{ambient}, scalar := #scalar{ambient},
  };
  \definition leftInverse: \forall (x: Kernel.Carrier) -> #apply{retraction} x = x :=
    \fun (x: Kernel.Carrier) => trans!{{C.family.Carrier n}} _ _ _
      (congr!{{C.family.Carrier n} {C.family.Carrier n}} (Group.difference x) _ _
        (trans!{{C.family.Carrier n}} _ _ _
          (congr!{{D.family.Carrier n} {C.family.Carrier n}} (#apply{(s n)}) _ _ (Kernel.killed x))
          (SectionMaps.zeroPreserved (s n))))
      (trans!{{C.family.Carrier n}} _ _ _ (congr!{{C.family.Carrier n} {C.family.Carrier n}} (Group.add x) _ _ Group.negZero)
        (Group.zeroRight x));
  \definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Kernel.Carrier, space := Kernel.space };
  \import Modules.ProjectiveLaws[].Retract[P := bundle,
    Q := Modules.Bundle { Carrier := C.family.Carrier n, space := C.family.space n },
    inclusion := Kernel.inclusion, retraction := retraction] \as Projective;
  \definition projective(sourceProjective: SourceProjective): Modules.Projective bundle :=
    Projective.projective leftInverse (sourceProjective n);
}
\definition retraction(n: N.Nat^): Modules.Hom[V := C.family.Carrier n, W := Carrier n, source := C.family.space n, target := space n].Map := At[n := n].retraction;
\definition leftInverse(n: N.Nat^)(x: Carrier n): #apply{(retraction n)} x = x := At[n := n].leftInverse x;
\definition projective(sourceProjective: SourceProjective)(n: N.Nat^):
  Modules.Projective (Modules.Bundle { Carrier := Carrier n, space := space n }) := At[n := n].projective sourceProjective;
