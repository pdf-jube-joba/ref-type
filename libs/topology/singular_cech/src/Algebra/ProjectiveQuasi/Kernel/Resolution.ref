\import \parent.Split[s := s, splits := splits] \as Split;
\import Modules.Zero[] \as Point;
\definition zero: Modules.Bundle := Modules.Bundle { Carrier := Point.Carrier, space := Point.moduleSpace };
\import resolutions.Resolution[].Over[R := R, ring := ring] \as Resolutions;
\import Resolutions.Of[M := zero, P := complex] \as Resolution;
\import Modules.Hom[V := Carrier N.Nat^::zero, W := Point.Carrier, source := space N.Nat^::zero, target := Point.moduleSpace] \as Augmentations;
\definition augmentation: Augmentations.Map := Augmentations.zeroMap;
\definition boundaryExists: \forall (exact: Criterion.ExactCycles)(n: N.Nat^)(x: Carrier n) -> Criterion.Closed n x ->
  \exists { y: Carrier (N.Nat^::succ n) \where #apply{differential} n y = x } := \block {
  \fun (exact: Criterion.ExactCycles)(n: N.Nat^)(x: Carrier n)(closed: Criterion.Closed n x) \then
  \takefrom witness: Criterion.BoundaryAt[n, x] \by exact n x closed (\parent.Degree[n := n].killed x) \then
  \let y: Carrier (N.Nat^::succ n) := \parent.Degree[n := N.Nat^::succ n].intro #value{witness} #killed{witness} \then
  \return Logic.existsIntro[Carrier (N.Nat^::succ n), { y: Carrier (N.Nat^::succ n) \where #apply{differential} n y = x }]
    y #boundary{witness}
};
\definition data: Resolution.Data := Resolution.Data { augmentation := augmentation };
\definition resolution(projective: SourceProjective)(exact: Criterion.ExactCycles): Resolution.Resolution :=
  \into[Resolution.Data](data, { data: Resolution.Data \where Resolution.Laws[data] }) \by {
  Resolution.Laws[data] {
  projective := Split.projective projective,
  onto := \fun (x: Point.Carrier) => Logic.existsIntro[Carrier N.Nat^::zero,
    { y: Carrier N.Nat^::zero \where #apply{augmentation} y = x }]
    #zero{(space N.Nat^::zero)} (Point.unique Point.Carrier::zero x),
  killed := \fun (x: Carrier (N.Nat^::succ N.Nat^::zero)) => \refl(Point.Carrier::zero),
  augmentationExact := \fun (x: Carrier N.Nat^::zero)(killed: _) => boundaryExists exact N.Nat^::zero x Logic.True::intro,
  exact := \fun (n: N.Nat^)(x: Carrier (N.Nat^::succ n))(closed: _) => boundaryExists exact (N.Nat^::succ n) x closed,
  }
};
\import Chains.End[C := complex] \as End;
\import Chains.Map[C := complex, D := complex].Additive[] \as Additive;
\import Chains.Homotopy[C := complex, D := complex] \as Homotopies;
\import Resolutions.Uniqueness[M := zero, N := zero, P := complex, Q := complex] \as Uniqueness;
\definition contractible(projective: SourceProjective)(exact: Criterion.ExactCycles):
  \exists Homotopies.Homotopy End.identity Additive.zero :=
  Uniqueness.existence (resolution projective exact) (resolution projective exact) End.identity Additive.zero
    (\fun (x: Carrier N.Nat^::zero) => \refl(Point.Carrier::zero));
