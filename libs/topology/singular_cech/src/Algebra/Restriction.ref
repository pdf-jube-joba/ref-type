\definition degree(n: N.Nat^): I.Int^ := I.Int^::ofNat n;
\definition NegativeVanishes: \Prop := \forall (n: N.Nat^)(x: C.family.Carrier (I.Int^::negSucc n)) -> x = #zero{(C.family.space (I.Int^::negSucc n))};
\definition family: Chains.Family := Chains.Family {
  Carrier := \fun (n: N.Nat^) => C.family.Carrier (degree n),
  space := \fun (n: N.Nat^) => C.family.space (degree n),
};
\definition differential: Chains.DifferentialData[family] := Chains.DifferentialData[family] {
  apply := \fun (n: N.Nat^) => #apply{C.differential} (degree (N.Nat^::succ n)),
};
\definition complex: Chains.Complex := Chains.Complex {
  family := family, differential := differential,
  laws := Chains.DifferentialLaws[family, differential] {
    addition := \fun (n: N.Nat^) => #addition{C.laws} (degree (N.Nat^::succ n)),
    scalar := \fun (n: N.Nat^) => #scalar{C.laws} (degree (N.Nat^::succ n)),
    squareZero := \fun (n: N.Nat^) => #squareZero{C.laws} (degree (N.Nat^::succ (N.Nat^::succ n))),
  },
};
\module Mapping(D: Signed.Complex);
