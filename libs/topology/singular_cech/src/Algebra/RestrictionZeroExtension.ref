\import Chains.ZeroExtension[C := C] \as Extension;
\import \parent.Restriction[C := Extension.complex] \as Restricted;
\definition negativeVanishes: Restricted.NegativeVanishes := \fun (n: N.Nat^) => Extension.Negative[n := n].zero;
\import Chains.Map[C := Restricted.complex, D := C] \as Forward;
\import Chains.Map[C := C, D := Restricted.complex] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (n: N.Nat^)(x: Restricted.complex.family.Carrier n) => x,
  addition := \fun (n: N.Nat^)(x, y: Restricted.complex.family.Carrier n) => \refl(#add{(C.family.space n)} x y),
  scalar := \fun (n: N.Nat^)(a: R)(x: Restricted.complex.family.Carrier n) => \refl(#smul{(C.family.space n)} a x),
  commutes := \fun (n: N.Nat^)(x: Restricted.complex.family.Carrier (N.Nat^::succ n)) => \refl(#apply{C.differential} n x),
};
\definition backward: Backward.Map := Backward.Map {
  apply := \fun (n: N.Nat^)(x: C.family.Carrier n) => Extension.Positive[n := n].intro x,
  addition := \fun (n: N.Nat^)(x, y: C.family.Carrier n) => \refl(#add{(C.family.space n)} x y),
  scalar := \fun (n: N.Nat^)(a: R)(x: C.family.Carrier n) => \refl(#smul{(C.family.space n)} a x),
  commutes := \fun (n: N.Nat^)(x: C.family.Carrier (N.Nat^::succ n)) => \refl(#apply{C.differential} n x),
};
\import Chains.Isomorphism[C := Restricted.complex, D := C] \as Compared;
\definition data: Compared.Data := Compared.Data { forward := forward, backward := backward };
\definition isomorphism: Compared.Isomorphism := \into[Compared.Data](data, { d: Compared.Data \where Compared.Laws[d] }) \by {
  Compared.Laws[data] {
    leftInverse := \fun (n: N.Nat^)(x: Restricted.complex.family.Carrier n) => \refl(x),
    rightInverse := \fun (n: N.Nat^)(x: C.family.Carrier n) => \refl(x),
  }
};
