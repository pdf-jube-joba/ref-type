\import Modules.Hom[V := V, W := V, source := space, target := space] \as Maps;
\import Modules.End[V := V, space := space] \as End;
\import Modules.Laws[V := V, space := space] \as Vector;
\import algebra.Group[].Of[Carrier := V, group := Vector.additive] \as Group;
\import \parent.Nilpotent[V := V, space := space, operator := Maps.negative operator] \as Negative;
\definition map: Maps.Map := Maps.plus End.identity operator;
\definition inverse(n: N.Nat^): Maps.Map := Negative.sum n;
\definition forwardFormula: \forall (x: V) -> #apply{Negative.complement} x = #apply{map} x :=
  \fun (x: V) => congr!{V V} (Group.add x) _ _ (Group.negNeg (#apply{operator} x));
\module AtBound(n: N.Nat^) {
  \definition Nilpotent: \Prop := Negative.AtBound[n := n].Nilpotent;
  \definition leftInverse: Nilpotent -> \forall (x: V) -> #apply{(inverse n)} (#apply{map} x) = x :=
    \fun (nilpotent: Nilpotent)(x: V) => trans!{V} _ _ _
      (congr!{V V} (#apply{(inverse n)}) _ _ (sym!{V} _ _ (forwardFormula x)))
      (Negative.AtBound[n := n].rightInverse nilpotent x);
  \definition rightInverse: Nilpotent -> \forall (x: V) -> #apply{map} (#apply{(inverse n)} x) = x :=
    \fun (nilpotent: Nilpotent)(x: V) => trans!{V} _ _ _
      (sym!{V} _ _ (forwardFormula (#apply{(inverse n)} x)))
      (Negative.AtBound[n := n].leftInverse nilpotent x);
  \import Modules.Isomorphism[V := V, W := V, source := space, target := space] \as Isomorphisms;
  \definition isomorphism(nilpotent: Nilpotent): Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
    forward := map,
    backward := inverse n,
    leftInverse := leftInverse nilpotent,
    rightInverse := rightInverse nilpotent,
  };
}
