\definition value[n: N.Nat^]: Carrier n (I.Int^::ofNat n) :=
  \parent.Cell[n := n, z := I.Int^::ofNat n].intro (\parent.DeltaComponent[delta := delta, n := n].map) (carried n);
\definition cells: Recursion.ClosedDiagonal := Recursion.ClosedDiagonal {
  value := value,
  zero := \parent.\parent.HomAt[n := N.Nat^::zero, z := Degrees.previous (I.Int^::ofNat N.Nat^::zero)].ext
    ((model.operators.boundary N.Nat^::zero (I.Int^::ofNat N.Nat^::zero)).apply (value N.Nat^::zero))
    (space N.Nat^::zero (Degrees.previous (I.Int^::ofNat N.Nat^::zero))).zero
    (\fun (x: C.family.Carrier N.Nat^::zero) => trans!{{D.family.Carrier (Degrees.previous (I.Int^::ofNat N.Nat^::zero))}} _ _ _
      ((delta).commutes (I.Int^::ofNat N.Nat^::zero) (Source.Positive[n := N.Nat^::zero].intro x))
      (SignedMaps.At[k := Degrees.previous (I.Int^::ofNat N.Nat^::zero)].zeroPreserved delta)),
  successor := \fun (n: N.Nat^) => \parent.\parent.HomAt[n := N.Nat^::succ n, z := I.Int^::ofNat n].ext
    ((model.operators.boundary (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ n))).apply (value (N.Nat^::succ n)))
    ((model.operators.transition n (I.Int^::ofNat n)).apply (value n))
    (\fun (x: C.family.Carrier (N.Nat^::succ n)) => (delta).commutes (I.Int^::ofNat (N.Nat^::succ n)) (Source.Positive[n := N.Nat^::succ n].intro x)),
};
