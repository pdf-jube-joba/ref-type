\import std.Data[].FinSet[] \as Fin;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n] \as M;
\import matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := n].Families[X := Y] \as Top;
\import topological_algebra.Complex[] \as Plane;
\definition Continuous[f: Y -> C.Complex]: \Prop := topology.Continuity[A := Y, B := C.Complex].Continuous source Plane.topology f;
\definition evaluate: \forall (A: Y -> M.Matrix)(v: Y -> M.Vector) -> Top.Regular source A -> (\forall (i: M.Index) -> Continuous (\fun (y: Y) => v y i)) ->
  \forall (i: M.Index) -> Continuous (\fun (y: Y) => (M.linear (A y)).apply (v y) i) :=
  \fun (A: Y -> M.Matrix)(v: Y -> M.Vector)(regular: _)(vectorRegular: _)(i: M.Index) => Top.Indexed[I := M.Index].sumContinuous (Fin.elements n) source
    (\fun (j: M.Index)(y: Y) => C.Def[].mul (A y i j) (v y j))
    (\fun (j: M.Index) => Plane.Functions[A := Y].multiplicationContinuous source _ _ (regular i j) (vectorRegular j));
