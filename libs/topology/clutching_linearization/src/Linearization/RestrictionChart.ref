\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\import Bundles.Family[X := X, F := F] \as Family;
\import Family.Of[bundle := bundle].Restriction[U := U] \as Restriction;
\import topology.Topology[Carrier := X].Subspace[S := U] \as Base;
\definition BasePoint: \Set := \Cast[X] U;
\definition source: topology.Topology[Carrier := BasePoint].Topology := Base.topology bundle.baseSpace;
\import Bundles.Trivial[X := BasePoint, n := n, baseSpace := source] \as Trivial;
\definition Vector: \Set := Bundles.Vector n;
\import Bundles.Family[X := BasePoint, F := (\fun (x: BasePoint) => F x)] \as Restricted;
\import Bundles.Family[X := BasePoint, F := (\fun (_: BasePoint) => Vector)] \as Coordinates;
\definition Isomorphism: \Set := Bundles.Isomorphisms[X := BasePoint, F := (\fun (x: BasePoint) => F x), G := (\fun (_: BasePoint) => Vector),
  source := Restriction.restricted, target := Trivial.bundle].Isomorphism;
\module With(value: Isomorphism);
