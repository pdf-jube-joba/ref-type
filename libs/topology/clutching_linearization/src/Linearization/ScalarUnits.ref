\import \root.Linearization[].IdentityImage[n := n, X := X, source := source] \as Identity;
\import Spaces.Coordinates[I := std.Data[].FinSet[].Fin n] \as Vectors;
\definition projection: spectral_splitting.Spectral[].Idempotents[n := n].Projection := Identity.projection;
\definition regular: hermitian_frames.Hermitian[].Over[K := C.Complex, field := Scalars.field, scalar := linear_algebra.Hermitian[].Complex[].scalar,
  topological := hermitian_frames.Hermitian[].Complex[].topological].At[n := n].Families[X := X].Matrix[m := n].Regular source (\fun (_: X) => projection.map) := Identity.regular;
\import \root.Linearization[].ProjectionBundle[n := n, X := X, source := source, P := (\fun (_: X) => projection), regular := regular].Scalar[
  a := a, continuous := continuous].Invertible[nonzero := nonzero] \as Native;
\import bundle_homotopy.Homotopy[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Projections[n := n].Operators[].Units[] \as Units;
\definition value: X -> Units.Carrier := Native.unit;
\definition valueContinuous: topology.Continuity[A := X, B := Units.Carrier].Continuous source Units.topology value := Native.unitContinuous;
\definition formula: \forall (x: X)(v: Vectors.Vector) -> (value x).apply v = Vectors.space.smul (a x) v :=
  \fun (x: X)(v: Vectors.Vector) => trans!{{Vectors.Vector}} _ _ _ (Native.unitFormula x v)
    (\root.Linearization[].ProjectionLoop[n := n, projection := projection].onImage (a x) v);
