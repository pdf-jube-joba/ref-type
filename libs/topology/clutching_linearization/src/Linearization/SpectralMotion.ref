\import std.Data[].Pair[] \as Pair;
\import std.Data[].FinSet[] \as Fin;
\import sphere_maps.Circle[] \as Circle;
\import topological_algebra.Complex[] \as Plane;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n] \as M;
\import Spaces.Coordinates[I := M.Index] \as Vectors;
\import Spaces.FiniteCoordinates[n := n] \as Basis;
\import Spaces.Linear[V := M.Vector, W := M.Vector, source := Vectors.space, target := Vectors.space] \as End;
\import End.Operations[] \as Operations;
\import End.Composition[U := M.Vector, domain := Vectors.space] \as Composition;
\import spectral_splitting.Spectral[].At[n := n].Continuous[X := X, source := source, A := A, regular := regular, off := off] \as Native;
\import hermitian_frames.Hermitian[].Over[K := C.Complex, field := Scalars.field, scalar := linear_algebra.Hermitian[].Complex[].scalar,
  topological := hermitian_frames.Hermitian[].Complex[].topological] \as Hermitian;
\import algebraic_topology.Interval[] \as Time;
\import topological_constructions.Product[A := X, B := Circle.Carrier] \as Circular;
\import topological_constructions.Product[A := Time.Carrier, B := Circular.CarrierSet] \as Cylinder;
\definition Domain: \Set := Cylinder.CarrierSet;
\definition circleTopology: topology.Topology[Carrier := Circular.CarrierSet].Topology := Circular.topology source Circle.topology;
\definition topology: topology.Topology[Carrier := Domain].Topology := Cylinder.topology Time.topology circleTopology;
\definition time[p: Domain]: Time.Carrier := Pair.first Time.Carrier Circular.CarrierSet p;
\definition circlePoint[p: Domain]: Circular.CarrierSet := Pair.second Time.Carrier Circular.CarrierSet p;
\definition base[p: Domain]: X := Pair.first X Circle.Carrier (circlePoint p);
\definition variable[p: Domain]: C.Complex := Pair.second X Circle.Carrier (circlePoint p);
\definition scalar[p: Domain]: C.Complex := C.Def[].ofReal (time p);
\module At(p: Domain);
\definition value[p: Domain]: End.Map := At[p := p].value;
\definition matrix[p: Domain]: M.Matrix := M.Representation[].entries (value p);
\definition nonzero: \forall (p: Domain) -> matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := n].Nonzero (matrix p) :=
  \fun (p: Domain) => At[p := p].nonzero;
\module Regularity;
\module Endpoints(q: Circular.CarrierSet);
\module Endpoint(t: Time.Carrier);
\module ClutchedMotion(compact: topology.Topology[Carrier := X].IsCompact source, hausdorff: topology.Topology[Carrier := X].IsT2 source);
\module Normal;
