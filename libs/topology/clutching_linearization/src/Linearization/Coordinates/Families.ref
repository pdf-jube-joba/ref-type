\import topological_algebra.Complex[] \as Plane;
\import \parent.Selections[] \as Selections;
\definition Regular[d: N.Nat^][v: X -> Carrier d]: \Prop := \forall (i: Fin.Fin d)(j: Fin.Fin n) ->
  topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology (\fun (x: X) => v x i j);
\definition flattenRegular: \forall (d: N.Nat^)(v: X -> Carrier d) -> Regular d v ->
  \forall (k: Fin.Fin (dimension d)) -> topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology (\fun (x: X) => flatten d (v x) k) := \block {
    \fun (d: N.Nat^)(v: X -> Carrier d)(regular: _)(k: Fin.Fin (dimension d)) \then
    \takefrom position: Selections.Position[d, k] \by Selections.exists d k \then
    \return \idelim (\fun (x: X) => v x position.block position.component) = (\fun (x: X) => flatten d (v x) k)
      \with f: (X -> C.Complex) => topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology f \by {
        base: regular position.block position.component,
        equality: \axiom:funext((\fun (x: X) => v x position.block position.component), (\fun (x: X) => flatten d (v x) k), \fun (x: X) => sym!{{C.Complex}} _ _ (position.equation (v x)))
      }
  };
