\import Spaces.CoordinateSum[n := n, m := dimension d] \as Sum;
\import Spaces.Coordinates[I := Fin.Fin (dimension d)] \as Tail;
\import Spaces.Coordinates[I := Fin.Fin (dimension (N.Nat^::succ d))] \as Total;
\definition leftInverse: (\forall (x: Carrier d) -> unflatten d (flatten d x) = x) ->
  \forall (x: Carrier (N.Nat^::succ d)) -> unflatten (N.Nat^::succ d) (flatten (N.Nat^::succ d) x) = x :=
  \fun (previous: _)(x: Carrier (N.Nat^::succ d)) => Tuples.extensionality d _ x
    (trans!{Vectors.Vector} _ _ _ (Tuples.atZero d (Sum.left (flatten (N.Nat^::succ d) x)) (unflatten d (Sum.right (flatten (N.Nat^::succ d) x))))
      (Sum.leftJoin (x (Fin.zero d)) (flatten d (\fun (i: Fin.Fin d) => x (Fin.succ d i)))))
    (\fun (i: Fin.Fin d) => eq_reason_in!{Vectors.Vector _
      "=" { unflatten d (Sum.right (flatten (N.Nat^::succ d) x)) i } "by" { Tuples.atSuccessor d (Sum.left (flatten (N.Nat^::succ d) x)) (unflatten d (Sum.right (flatten (N.Nat^::succ d) x))) i }
      "=" { unflatten d (flatten d (\fun (j: Fin.Fin d) => x (Fin.succ d j))) i } "by" { congr!{Tail.Vector Vectors.Vector} (\fun (v: Tail.Vector) => unflatten d v i) _ _ (Sum.rightJoin (x (Fin.zero d)) (flatten d (\fun (j: Fin.Fin d) => x (Fin.succ d j)))) }
      "=" { x (Fin.succ d i) } "by" { congr!{{Carrier d} Vectors.Vector} (\fun (v: Carrier d) => v i) _ _ (previous (\fun (j: Fin.Fin d) => x (Fin.succ d j))) }
    });
\definition rightInverse: (\forall (x: Tail.Vector) -> flatten d (unflatten d x) = x) -> \forall (x: Total.Vector) -> flatten (N.Nat^::succ d) (unflatten (N.Nat^::succ d) x) = x :=
  \fun (previous: _)(x: Total.Vector) => eq_reason_in!{Total.Vector _
    "=" { Sum.join (Sum.left x) (flatten d (unflatten d (Sum.right x))) } "by" {
      congr!{Vectors.Vector Tail.Vector Total.Vector} Sum.join _ _ _ _
        (Tuples.atZero d (Sum.left x) (unflatten d (Sum.right x)))
        (congr!{{Carrier d} Tail.Vector} (flatten d) _ _ (\axiom:funext((\fun (i: Fin.Fin d) => unflatten (N.Nat^::succ d) x (Fin.succ d i)), unflatten d (Sum.right x), Tuples.atSuccessor d (Sum.left x) (unflatten d (Sum.right x)))))
    }
    "=" { Sum.join (Sum.left x) (Sum.right x) } "by" { congr!{Tail.Vector Total.Vector} (Sum.join (Sum.left x)) _ _ (previous (Sum.right x)) }
    "=" x "by" { Sum.recover x }
  };
\definition addition: (\forall (x, y: Carrier d) -> flatten d ((space d).add x y) = Tail.plus (flatten d x) (flatten d y)) ->
  \forall (x, y: Carrier (N.Nat^::succ d)) -> flatten (N.Nat^::succ d) ((space (N.Nat^::succ d)).add x y) = Total.plus (flatten (N.Nat^::succ d) x) (flatten (N.Nat^::succ d) y) :=
  \fun (previous: _)(x, y: Carrier (N.Nat^::succ d)) => trans!{Total.Vector} _ _ _
    (congr!{Tail.Vector Total.Vector} (Sum.join (Vectors.plus (x (Fin.zero d)) (y (Fin.zero d)))) _ _ (previous (\fun (i: Fin.Fin d) => x (Fin.succ d i)) (\fun (i: Fin.Fin d) => y (Fin.succ d i))))
    (Sum.addition (x (Fin.zero d)) (y (Fin.zero d)) (flatten d (\fun (i: Fin.Fin d) => x (Fin.succ d i))) (flatten d (\fun (i: Fin.Fin d) => y (Fin.succ d i))));
\definition scalar: (\forall (a: C.Complex)(x: Carrier d) -> flatten d ((space d).smul a x) = Tail.scale a (flatten d x)) ->
  \forall (a: C.Complex)(x: Carrier (N.Nat^::succ d)) -> flatten (N.Nat^::succ d) ((space (N.Nat^::succ d)).smul a x) = Total.scale a (flatten (N.Nat^::succ d) x) :=
  \fun (previous: _)(a: C.Complex)(x: Carrier (N.Nat^::succ d)) => trans!{Total.Vector} _ _ _
    (congr!{Tail.Vector Total.Vector} (Sum.join (Vectors.scale a (x (Fin.zero d)))) _ _ (previous a (\fun (i: Fin.Fin d) => x (Fin.succ d i))))
    (Sum.scalar a (x (Fin.zero d)) (flatten d (\fun (i: Fin.Fin d) => x (Fin.succ d i))));
\definition flattenExtend: \forall (v: Vectors.Vector)(w: Carrier d) -> flatten (N.Nat^::succ d) (Tuples.extend d v w) = Sum.join v (flatten d w) :=
  \fun (v: Vectors.Vector)(w: Carrier d) => congr!{Vectors.Vector Tail.Vector Total.Vector} Sum.join _ _ _ _
    (Tuples.atZero d v w)
    (congr!{{Carrier d} Tail.Vector} (flatten d) _ _ (\axiom:funext((\fun (i: Fin.Fin d) => Tuples.extend d v w (Fin.succ d i)), w, Tuples.atSuccessor d v w)));
\definition block[f: Vectors.Vector -> Vectors.Vector][v: Carrier (N.Nat^::succ d)]: Carrier (N.Nat^::succ d) :=
  Tuples.extend d (f (v (Fin.zero d))) (\fun (i: Fin.Fin d) => v (Fin.succ d i));
\definition blockFormula: \forall (f: Vectors.Vector -> Vectors.Vector)(v: Total.Vector) ->
  flatten (N.Nat^::succ d) (block f (unflatten (N.Nat^::succ d) v)) = Sum.join (f (Sum.left v)) (Sum.right v) :=
  \fun (f: Vectors.Vector -> Vectors.Vector)(v: Total.Vector) => trans!{Total.Vector} _ _ _
    (flattenExtend (f (unflatten (N.Nat^::succ d) v (Fin.zero d))) (\fun (i: Fin.Fin d) => unflatten (N.Nat^::succ d) v (Fin.succ d i)))
    (congr!{Vectors.Vector Tail.Vector Total.Vector} Sum.join _ _ _ _
      (congr!{Vectors.Vector Vectors.Vector} f _ _ (Tuples.atZero d (Sum.left v) (unflatten d (Sum.right v))))
      (trans!{Tail.Vector} _ _ _
        (congr!{{Carrier d} Tail.Vector} (flatten d) _ _ (\axiom:funext((\fun (i: Fin.Fin d) => unflatten (N.Nat^::succ d) v (Fin.succ d i)), unflatten d (Sum.right v), Tuples.atSuccessor d (Sum.left v) (unflatten d (Sum.right v)))))
        (\parent.rightInverse d (Sum.right v))));
