\import Spaces.CoordinateSum[n := n, m := dimension d] \as Sum;
\import Spaces.Coordinates[I := Fin.Fin (dimension d)] \as Tail;
\import Spaces.Coordinates[I := Fin.Fin (dimension (N.Nat^::succ d))] \as Total;
\definition flattenExtend: \forall (v: Vectors.Vector)(w: Carrier d) -> flatten (N.Nat^::succ d) (Tuples.extend d v w) = Sum.join v (flatten d w) :=
  \fun (v: Vectors.Vector)(w: Carrier d) => congr!{Vectors.Vector Tail.Vector Total.Vector} Sum.join _ _ _ _
    (Tuples.atZero d v w)
    (congr!{{Carrier d} Tail.Vector} (flatten d) _ _ (\axiom:funext((\fun (i: Fin.Fin d) => Tuples.extend d v w (Fin.succ d i)), w, Tuples.atSuccessor d v w)));
\definition block[f: Vectors.Vector -> Vectors.Vector][v: Carrier (N.Nat^::succ d)]: Carrier (N.Nat^::succ d) :=
  Tuples.extend d (f (v (Fin.zero d))) (\fun (i: Fin.Fin d) => v (Fin.succ d i));
\definition blockFormula: \forall (f: Vectors.Vector -> Vectors.Vector)(v: Total.Vector) ->
  flatten (N.Nat^::succ d) (block f (unflatten (N.Nat^::succ d) v)) = Sum.join (f (Sum.left v)) (Sum.right v) :=
  \fun (f: Vectors.Vector -> Vectors.Vector)(v: Total.Vector) => trans!{Total.Vector} _ _ _
    (flattenExtend (f (unflatten (N.Nat^::succ d) v (Fin.zero d))) (\fun (i: Fin.Fin d) => unflatten (N.Nat^::succ d) v (Fin.succ d i)))
    (congr!{Vectors.Vector Tail.Vector Total.Vector} Sum.join _ _ _ _
      (congr!{Vectors.Vector Vectors.Vector} f _ _ (Tuples.atZero d (Sum.left v) (unflatten d (Sum.right v))))
      (trans!{Tail.Vector} _ _ _
        (congr!{{Carrier d} Tail.Vector} (flatten d) _ _ (\axiom:funext((\fun (i: Fin.Fin d) => unflatten (N.Nat^::succ d) v (Fin.succ d i)), unflatten d (Sum.right v), Tuples.atSuccessor d (Sum.left v) (unflatten d (Sum.right v)))))
        (\parent.rightInverse d (Sum.right v))));
