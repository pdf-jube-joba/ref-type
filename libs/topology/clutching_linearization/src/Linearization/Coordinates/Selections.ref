\structure Position[d: N.Nat^, k: Fin.Fin (dimension d)]: \Set := {
  block: Fin.Fin d,
  component: Fin.Fin n,
  equation: \forall (v: Carrier d) -> flatten d v k = v block component,
};
\module Successor(d: N.Nat^);
\definition exists: \forall (d: N.Nat^)(k: Fin.Fin (dimension d)) -> \exists Position[d, k] :=
  \induction (d: N.Nat^) \return \forall (k: Fin.Fin (dimension d)) -> \exists Position[d, k] \with {
    | zero: \fun (k: Fin.Fin N.Nat^::zero) => Logic.falseElim _ (Fin.zeroImpossible k (Fin.bound N.Nat^::zero k))
    | succ: \fun (d: N.Nat^)(previous: _) => Successor[d := d].exists previous
  };
