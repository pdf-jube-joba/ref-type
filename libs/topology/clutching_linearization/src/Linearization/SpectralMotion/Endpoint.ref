\import \parent.Regularity[] \as Regularity;
\definition include[q: Circular.CarrierSet]: Domain := Pair.pair Time.Carrier Circular.CarrierSet t q;
\definition inclusionContinuous: topology.Continuity[A := Circular.CarrierSet, B := Domain].Continuous circleTopology topology include :=
  Cylinder.Universal[X := Circular.CarrierSet].pairContinuous circleTopology Time.topology circleTopology (\fun (_: Circular.CarrierSet) => t) (\fun (q: Circular.CarrierSet) => q)
    (topology.Maps[A := Circular.CarrierSet, B := Time.Carrier].constantContinuous circleTopology Time.topology t)
    (topology.Maps[A := Circular.CarrierSet, B := Circular.CarrierSet].Identity[].continuous circleTopology);
\definition endpointMatrix[q: Circular.CarrierSet]: M.Matrix := matrix (include q);
\definition endpointRegular: matrix_invariants.Topological[K := C.Complex, ring := Plane.Ring[].topologicalRing].At[n := n].Families[X := Circular.CarrierSet].Regular circleTopology endpointMatrix :=
  \fun (i, j: M.Index) => topology.Composition[A := Circular.CarrierSet, B := Domain, C := C.Complex].composeContinuous circleTopology topology Plane.topology include
    (\fun (p: Domain) => matrix p i j) inclusionContinuous (Regularity.matrixRegular i j);
\definition invertible: \forall (q: Circular.CarrierSet) -> matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := n].Nonzero (endpointMatrix q) :=
  \fun (q: Circular.CarrierSet) => nonzero (include q);
