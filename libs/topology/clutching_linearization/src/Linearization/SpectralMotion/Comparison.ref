\import \parent.ClutchedMotion[compact := compact, hausdorff := hausdorff] \as Motion;
\import \parent.Normal[].Clutched[compact := compact, hausdorff := hausdorff] \as NormalizedLoop;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition Base: \Set := Motion.Base;
\definition PencilFiber: Base -> \Set := Motion.FinishFiber;
\definition pencilBundle: Bundles.Family[X := Base, F := PencilFiber].Bundle := Motion.finishBundle;
\definition NormalFiber: Base -> \Set := NormalizedLoop.NormalFiber;
\definition normalBundle: Bundles.Family[X := Base, F := NormalFiber].Bundle := NormalizedLoop.normalBundle;
\import Bundles.Isomorphisms[X := Base, F := Motion.StartFiber, G := PencilFiber,
  source := Motion.startBundle, target := pencilBundle] \as Reverse;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].IsomorphismComposition[
  X := Base, F := PencilFiber, G := Motion.StartFiber, H := NormalFiber,
  source := pencilBundle, middle := Motion.startBundle, target := normalBundle] \as Compose;
\definition isomorphismExists: \exists Bundles.Isomorphisms[X := Base, F := PencilFiber, G := NormalFiber,
  source := pencilBundle, target := normalBundle].Isomorphism :=
  Compose.exists (Reverse.inverseExists Motion.isomorphismExists) (\exact(NormalizedLoop.isomorphism, Bundles.Isomorphisms[X := Base, F := Motion.StartFiber, G := NormalFiber, source := Motion.startBundle, target := normalBundle].Isomorphism));
