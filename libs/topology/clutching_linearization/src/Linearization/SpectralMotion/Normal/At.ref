\import \root.Linearization[].SpectralPencil[n := n, A := A x, off := off x].NormalForm[] \as Native;
\definition gauge: End.Map := Native.gauge;
\definition loop: C.Complex -> End.Map := Native.loop;
\definition gaugeNonzero: matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := n].Nonzero Native.matrix := Native.nonzero;
\definition loopNonzero: \forall (z: C.Complex) -> C.Absolute[].abs z = R.one -> matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := n].Nonzero (Native.loopMatrix z) := Native.loopNonzero;
\definition intertwines: \forall (z: C.Complex) -> M.product Native.matrix (Native.loopMatrix z) = M.Representation[].entries (Native.separated z) := Native.matrixIntertwines;
