\definition unit: C.Absolute[].abs (variable p) = R.one := \root.Linearization[].Powers[].unitOfNorm (variable p) (Circle.norm (Pair.second X Circle.Carrier (circlePoint p)));
\definition bounded: Real.Le (C.Absolute[].abs (scalar p)) R.one := Real.leReplaceLeft _ _ _
  (sym!{{R.Real}} _ _ (trans!{{R.Real}} _ _ _ (uniform_approximation.Approximation[].ComplexScalars[].absoluteReal (time p))
    (R.Estimates[].Product[].absOfNonnegative (time p) (Time.bounds (time p)).left))) (Time.bounds (time p)).right;
\import \root.Linearization[].SpectralPencil[n := n, A := A (base p), off := off (base p)].Unit[z := variable p, unit := unit].Scaled[s := scalar p, bounded := bounded].Deformation[] \as Motion;
\definition value: End.Map := Motion.value;
\definition nonzero: matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := n].Nonzero Motion.matrix := Motion.nonzero;
