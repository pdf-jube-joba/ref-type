\import \parent.Endpoint[t := Time.start] \as Start;
\import \parent.Endpoint[t := Time.end] \as Finish;
\import \parent.Regularity[] \as Regularity;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n,
  a := Start.endpointMatrix, regular := Start.endpointRegular, nonzero := Start.invertible].Clutched[] \as First;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n,
  a := Finish.endpointMatrix, regular := Finish.endpointRegular, nonzero := Finish.invertible].Clutched[] \as Last;
\import First.Comparison[b := Finish.endpointMatrix, regularB := Finish.endpointRegular, nonzeroB := Finish.invertible] \as Comparison;
\definition path: Comparison.Path := Comparison.Path {
  homotopy := matrix, regular := Regularity.matrixRegular, nonzero := nonzero,
  atStart := \fun (q: Circular.CarrierSet) => \refl(Start.endpointMatrix q),
  atEnd := \fun (q: Circular.CarrierSet) => \refl(Finish.endpointMatrix q),
};
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition Base: \Set := First.Carrier;
\definition StartFiber: Base -> \Set := First.Fiber;
\definition startBundle: Bundles.Family[X := Base, F := StartFiber].Bundle := First.bundle;
\definition FinishFiber: Base -> \Set := Last.Fiber;
\definition finishBundle: Bundles.Family[X := Base, F := FinishFiber].Bundle := Last.bundle;
\definition Isomorphism: \Set := Bundles.Isomorphisms[X := Base, F := StartFiber, G := FinishFiber, source := startBundle, target := finishBundle].Isomorphism;
\definition isomorphismExists: \exists Isomorphism := Comparison.Along[path := path].isomorphismExists;
