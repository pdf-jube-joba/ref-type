\definition law: \forall (p: P.Carrier) -> Action.apply p v = space.smul (Evaluation.apply z p) v := P.induction
  (\fun (p: P.Carrier) => Action.apply p v = space.smul (Evaluation.apply z p) v)
  (\fun (a: C.Complex) => trans!{V} _ _ _ (Action.constants a v) (congr!{{C.Complex} V} (\fun (s: C.Complex) => space.smul s v) _ _ (sym!{{C.Complex}} _ _ (Universal.constants Evaluation.identity z a))))
  (trans!{V} _ _ _ (Action.variable v) (trans!{V} _ _ _ eigen (congr!{{C.Complex} V} (\fun (s: C.Complex) => space.smul s v) _ _ (sym!{{C.Complex}} _ _ (Universal.variable Evaluation.identity z)))))
  (\fun (p, q: P.Carrier)(first: _)(second: _) => eq_reason_in!{V _
    "=" { space.add (Action.apply p v) (Action.apply q v) } "by" { Action.addition p q v }
    "=" { space.add (space.smul (Evaluation.apply z p) v) (space.smul (Evaluation.apply z q) v) } "by" { congr!{V V V} space.add _ _ _ _ first second }
    "=" { space.smul (C.Def[].add (Evaluation.apply z p) (Evaluation.apply z q)) v } "by" { sym!{V} _ _ (space.scalarAdd (Evaluation.apply z p) (Evaluation.apply z q) v) }
    "=" _ "by" { congr!{{C.Complex} V} (\fun (s: C.Complex) => space.smul s v) _ _ (sym!{{C.Complex}} _ _ ((Evaluation.homomorphism z).add p q)) }
  })
  (\fun (p: P.Carrier)(previous: _) => eq_reason_in!{V _
    "=" { space.neg (Action.apply p v) } "by" { Action.negative p v }
    "=" { space.neg (space.smul (Evaluation.apply z p) v) } "by" { congr!{V V} space.neg _ _ previous }
    "=" { space.smul (C.Def[].neg (Evaluation.apply z p)) v } "by" { negativeScalar (Evaluation.apply z p) v }
    "=" _ "by" { congr!{{C.Complex} V} (\fun (s: C.Complex) => space.smul s v) _ _ (sym!{{C.Complex}} _ _ (negativeEvaluation z p)) }
  })
  (\fun (p, q: P.Carrier)(first: _)(second: _) => eq_reason_in!{V _
    "=" { Action.apply p (Action.apply q v) } "by" { Action.multiplication p q v }
    "=" { Action.apply p (space.smul (Evaluation.apply z q) v) } "by" { congr!{V V} (Action.apply p) _ _ second }
    "=" { space.smul (Evaluation.apply z q) (Action.apply p v) } "by" { (Action.evaluate p).preservesScale (Evaluation.apply z q) v }
    "=" { space.smul (Evaluation.apply z q) (space.smul (Evaluation.apply z p) v) } "by" { congr!{V V} (space.smul (Evaluation.apply z q)) _ _ first }
    "=" { space.smul (Evaluation.apply z p) (space.smul (Evaluation.apply z q) v) } "by" { Values.scaleComm (Evaluation.apply z q) (Evaluation.apply z p) v }
    "=" { space.smul (C.Def[].mul (Evaluation.apply z p) (Evaluation.apply z q)) v } "by" { sym!{V} _ _ (space.scalarAssoc (Evaluation.apply z p) (Evaluation.apply z q) v) }
    "=" _ "by" { congr!{{C.Complex} V} (\fun (s: C.Complex) => space.smul s v) _ _ (sym!{{C.Complex}} _ _ ((Evaluation.homomorphism z).mul p q)) }
  });
