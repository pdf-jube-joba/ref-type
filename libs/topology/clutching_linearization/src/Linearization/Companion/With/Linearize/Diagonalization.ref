\import std.Data[].Pair[].Prop[A := Vectors.Vector, B := Coordinates.Carrier d] \as Pairs;
\definition equation: \forall (p: Sum.Carrier) -> leftIsomorphism.forward.apply (pencil.apply (rightIsomorphism.forward.apply p)) = (Blocks.diagonal (polynomial z)).apply p :=
  \fun (p: Sum.Carrier) => Pairs.ext (leftIsomorphism.forward.apply (pencil.apply (rightIsomorphism.forward.apply p))) ((Blocks.diagonal (polynomial z)).apply p)
    (eq_reason_in!{Vectors.Vector _
      "=" { Vectors.plus (Vectors.plus ((polynomial z).apply (Sum.first p)) (remainder.apply (Sum.second p))) (Vectors.negative (remainder.apply (Sum.second p))) } "by" {
        congr!{Vectors.Vector Vectors.Vector Vectors.Vector} Vectors.plus _ _ _ _ (Triangular.first p)
          (trans!{Vectors.Vector} _ _ _ (Values.minusOneScale (remainder.apply (Sum.second (transformed.apply p))))
            (congr!{Vectors.Vector Vectors.Vector} Vectors.negative _ _ (congr!{{Coordinates.Carrier d} Vectors.Vector} remainder.apply _ _ (Triangular.tail p))))
      }
      "=" { Vectors.plus ((polynomial z).apply (Sum.first p)) (Vectors.plus (remainder.apply (Sum.second p)) (Vectors.negative (remainder.apply (Sum.second p)))) } "by" { Values.assoc ((polynomial z).apply (Sum.first p)) (remainder.apply (Sum.second p)) (Vectors.negative (remainder.apply (Sum.second p))) }
      "=" { Vectors.plus ((polynomial z).apply (Sum.first p)) Vectors.origin } "by" { congr!{Vectors.Vector Vectors.Vector} (Vectors.plus ((polynomial z).apply (Sum.first p))) _ _ (ValueGroup.inverseRight (remainder.apply (Sum.second p))) }
      "=" _ "by" { Values.zeroRight ((polynomial z).apply (Sum.first p)) }
    }) (Triangular.tail p);
