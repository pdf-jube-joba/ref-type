\import spectral_splitting.Spectral[].InFrame[V := Carrier, space := space, T := operator,
  n := Coordinates.dimension degree, frame := Coordinates.At[d := degree].frame] \as Native;
\definition matrix: matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := Coordinates.dimension degree].Matrix := Native.matrix;
\definition formula: \forall (v: Fin.Fin (Coordinates.dimension degree) -> C.Complex) ->
  (matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := Coordinates.dimension degree].linear matrix).apply v =
    Coordinates.flatten degree (operator.apply (Coordinates.unflatten degree v)) := Native.matrixFormula;
\definition off:
  (\forall (z: C.Complex) -> C.Absolute[].abs z = R.one -> \forall (w: Vectors.Vector) -> (polynomial z).apply w = Vectors.origin -> w = Vectors.origin) -> Native.OffSpectrum :=
  \fun (kernel: _) => Native.Eigenvalues[].off (noUnitEigen kernel);
\module Separated(kernel: \forall (z: C.Complex) -> C.Absolute[].abs z = R.one -> \forall (w: Vectors.Vector) -> (polynomial z).apply w = Vectors.origin -> w = Vectors.origin);
