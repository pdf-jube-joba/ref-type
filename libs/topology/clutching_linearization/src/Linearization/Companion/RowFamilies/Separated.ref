\definition off: \forall (x: X) -> spectral_splitting.Spectral[].At[n := Coordinates.dimension degree].Splitting[A := matrix x].OffSpectrum :=
  \fun (x: X) => \root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].Spectral[].off (kernel x);
\import spectral_splitting.Spectral[].At[n := Coordinates.dimension degree].Continuous[X := X, source := source, A := matrix, regular := matrixRegular, off := off].Bundle[] \as Image;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition Fiber[x: X]: \Set := Image.Fiber x;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Image.bundle;
\definition OutsideFiber[x: X]: \Set := Image.OutsideFiber x;
\definition outsideBundle: Bundles.Family[X := X, F := OutsideFiber].Bundle := Image.outsideBundle;
\module KClass(compact: topology.Topology[Carrier := X].IsCompact source, hausdorff: topology.Topology[Carrier := X].IsT2 source, shift: N.Nat^);
