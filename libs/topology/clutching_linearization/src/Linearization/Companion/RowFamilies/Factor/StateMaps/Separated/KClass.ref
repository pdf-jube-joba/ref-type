\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff] \as On;
\import On.SpectralIndex[n := Coordinates.dimension Next.degree, A := enlargedMatrix, regular := enlargedRegular, off := enlargedOff, removed := Nat.add removedB removedA] \as EnlargedIndex;
\import On.SpectralIndex[n := Coordinates.dimension degree, A := matrix, regular := matrixRegular, off := originalOff, removed := removedA] \as OriginalIndex;
\import On.SpectralIndex[n := n, A := scalarMatrix, regular := scalarRegular, off := scalarOff, removed := removedB] \as ScalarIndex;
\import EnlargedIndex.Similarity[m := total, B := Triangle.matrix, regularB := Triangle.matrixRegular, offB := Triangle.matrixOff].With[
  iso := isomorphism, regularForward := forwardRegular, regularBackward := backwardRegular, intertwines := intertwines] \as Comparison;
\import Triangle.Additivity[compact := compact, hausdorff := hausdorff, removedA := removedA, removedB := removedB] \as Addition;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\definition enlargedValue: K.K0[].Carrier := EnlargedIndex.value;
\definition originalValue: K.K0[].Carrier := OriginalIndex.value;
\definition scalarValue: K.K0[].Carrier := ScalarIndex.value;
\definition factorFormula: enlargedValue = K.K0[].add originalValue scalarValue :=
  trans!{K.K0[].Carrier} _ _ _ Comparison.invariant (sym!{K.K0[].Carrier} _ _ Addition.additivity);
