\import \parent.KClass[compact := compact, hausdorff := hausdorff, removedA := removed, removedB := n] \as Formula;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].SpectralIndex[n := n,
  A := scalarMatrix, regular := scalarRegular, off := scalarOff, removed := n].Scalar[r := r,
  acts := (\fun (x: X) => Shape.scalarAction)].Inside[inside := bound] \as Scalar;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\import algebra.Group[].Of[Carrier := K.K0[].Carrier, group := K.K0[].group] \as Group;
\definition scalarZero: Formula.scalarValue = K.K0[].zero := trans!{K.K0[].Carrier} _ _ _ Scalar.valueFormula (Group.inverseRight (K.K0[].include K.Trivial[n := n].value));
\definition enlargedValue: K.K0[].Carrier := Formula.enlargedValue;
\definition originalValue: K.K0[].Carrier := Formula.originalValue;
\definition invariant: enlargedValue = originalValue := trans!{K.K0[].Carrier} _ _ _ Formula.factorFormula
  (trans!{K.K0[].Carrier} _ _ _ (congr!{K.K0[].Carrier K.K0[].Carrier} (K.K0[].add originalValue) _ _ scalarZero) (Group.zeroRight originalValue));
