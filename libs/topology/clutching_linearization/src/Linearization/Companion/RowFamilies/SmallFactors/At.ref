\import \root.Linearization[].Companion[n := n, d := Factors.order k] \as Extended;
\import Spaces.Linear[V := Extended.Carrier, W := Vectors.Vector, source := Extended.space, target := Vectors.space] \as ExtendedRows;
\definition rows[x: X]: ExtendedRows.Map := ExtendedRows.Operations[].scale (leading k) (Factors.iterated k x);
\definition regular: \forall (v: Extended.Carrier)(j: Fin.Fin n) -> topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology (\fun (x: X) => (rows x).apply v j) :=
  \fun (v: Extended.Carrier)(j: Fin.Fin n) => Functions.multiplicationContinuous source _ _
    (topology.Maps[A := X, B := C.Complex].constantContinuous source Plane.topology (leading k)) (Factors.iteratedRegular k v j);
\definition polynomial[x: X][z: C.Complex]: End.Map := End.Operations[].plus
  (End.Operations[].scale (leading k) (Spaces.Eigen[V := Vectors.Vector, space := Vectors.space].scalar (power z (Factors.length k))))
  (ExtendedRows.Composition[U := Vectors.Vector, domain := Vectors.space].compose (rows x) (Extended.geometric z));
\definition evaluation: \forall (x: X)(z: C.Complex)(v: Vectors.Vector) -> (polynomial x z).apply v =
  Vectors.scale (power (C.Def[].add C.Def[].one (C.Def[].mul Parameter.scalar z)) k) ((Factors.polynomial N.Nat^::zero x z).apply v) :=
  \fun (x: X)(z: C.Complex)(v: Vectors.Vector) => trans!{Vectors.Vector} _ _ _
    (sym!{Vectors.Vector} _ _ (Vectors.space.vectorAdd (leading k) (Vectors.scale (power z (Factors.length k)) v) ((Factors.iterated k x).apply ((Extended.geometric z).apply v))))
    (clearedEvaluation k x z v);
