\import \root.Linearization[].Companion[n := n, d := order k].RowFamilies[X := X, source := source, rows := iterated k, regular := iteratedRegular k] \as Family;
\definition matrix: X -> matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := Coordinates.dimension (length k)].Matrix := Family.matrix;
\definition regular: matrix_invariants.Topological[K := C.Complex, ring := Plane.Ring[].topologicalRing].At[n := Coordinates.dimension (length k)].Families[X := X].Regular source matrix := Family.matrixRegular;
\definition off: \forall (x: X) -> spectral_splitting.Spectral[].At[n := Coordinates.dimension (length k)].Splitting[A := matrix x].OffSpectrum :=
  \fun (x: X) => \root.Linearization[].Companion[n := n, d := order k].FromRow[row := iterated k x].Spectral[].off (iteratedKernel initial k x);
