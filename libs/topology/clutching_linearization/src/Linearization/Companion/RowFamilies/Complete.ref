\import \root.Linearization[].Companion[n := n, d := degree] \as Next;
\import Spaces.Linear[V := Next.Carrier, W := Vectors.Vector, source := Next.space, target := Vectors.space] \as FullRows;
\definition complete[x: X]: FullRows.Map := \root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].Factor[r := C.Def[].zero].residual;
\definition completeRegular: \forall (v: Next.Carrier)(j: Fin.Fin n) -> topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology (\fun (x: X) => (complete x).apply v j) :=
  \fun (v: Next.Carrier)(j: Fin.Fin n) => Functions.additionContinuous source _ _ (regular (\fun (i: Fin.Fin degree) => v (Fin.widen degree i)) j)
    (topology.Maps[A := X, B := C.Complex].constantContinuous source Plane.topology (v Next.last j));
\import Next.RowFamilies[X := X, source := source, rows := complete, regular := completeRegular].Pad[] \as Padding;
\definition padded: \forall (k: N.Nat^) -> X -> Padding.RowAt k := Padding.padded;
\definition paddedRegular: \forall (k: N.Nat^) -> Padding.Regular k (padded k) := Padding.paddedRegular;
\definition evaluation: \forall (k: N.Nat^)(x: X)(z: C.Complex)(v: Vectors.Vector) ->
  (padded k x).apply ((Padding.geometric k z).apply v) = (\root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].polynomial z).apply v :=
  \fun (k: N.Nat^)(x: X)(z: C.Complex)(v: Vectors.Vector) => trans!{Vectors.Vector} _ _ _ (Padding.evaluation k x z v)
    (\root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].Factor[r := C.Def[].zero].residualGeometric z v);
