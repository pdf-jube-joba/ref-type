\definition negativeRegular: \forall (j: Fin.Fin n) -> topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology
  (\fun (x: X) => (\root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].negativeRow).apply v j) :=
  \fun (j: Fin.Fin n) => Functions.multiplicationContinuous source (\fun (_: X) => C.Def[].neg C.Def[].one) _
    (topology.Maps[A := X, B := C.Complex].constantContinuous source Plane.topology (C.Def[].neg C.Def[].one)) (regular v j);
\definition operatorRegular: Flatten.Regular degree (\fun (x: X) => (\root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].operator).apply v) :=
  \fun (i: Fin.Fin degree)(j: Fin.Fin n) =>
    (\induction (k: Indices.Index) \return topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology
      (\fun (x: X) => Joining.evaluate (\fun (l: Fin.Fin d) => v (Fin.succ d l))
        (\fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => (\root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].negativeRow).apply v) k j) \with {
          | inl: \fun (l: Fin.Fin d) => topology.Maps[A := X, B := C.Complex].constantContinuous source Plane.topology (v (Fin.succ d l) j)
          | inr: \fun (l: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => negativeRegular j
        }) (Indices.split (toTotal i));
