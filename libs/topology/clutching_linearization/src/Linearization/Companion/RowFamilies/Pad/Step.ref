\import \root.Linearization[].Companion[n := n, d := order k] \as Current;
\import \root.Linearization[].Companion[n := n, d := length k] \as Next;
\import Spaces.Linear[V := Current.Carrier, W := Vectors.Vector, source := Current.space, target := Vectors.space] \as CurrentRows;
\import Spaces.Linear[V := Next.Carrier, W := Current.Carrier, source := Next.space, target := Current.space] \as Projection;
\definition prefix: Projection.Map := Current.FromRow[row := CurrentRows.Operations[].zeroMap].Factor[r := C.Def[].zero].prefix;
\definition append[row: RowAt k]: RowAt (N.Nat^::succ k) := CurrentRows.Composition[U := Next.Carrier, domain := Next.space].compose row prefix;
