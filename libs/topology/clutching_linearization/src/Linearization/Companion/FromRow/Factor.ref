\import \root.Linearization[].Companion[n := n, d := degree] \as Next;
\import Spaces.Linear[V := Next.Carrier, W := Carrier, source := Next.space, target := space] \as Projections;
\import Spaces.Linear[V := Next.Carrier, W := Vectors.Vector, source := Next.space, target := Vectors.space] \as Rows;
\definition prefix: Projections.Map := Projections.Map {
  apply := \fun (v: Next.Carrier)(i: Fin.Fin degree) => v (Fin.widen degree i),
  preservesAdd := \fun (v, w: Next.Carrier) => \refl(\fun (i: Fin.Fin degree) => Vectors.plus (v (Fin.widen degree i)) (w (Fin.widen degree i))),
  preservesScale := \fun (a: C.Complex)(v: Next.Carrier) => \refl(\fun (i: Fin.Fin degree) => Vectors.scale a (v (Fin.widen degree i))),
};
\definition tail: Projections.Map := Projections.Map {
  apply := \fun (v: Next.Carrier)(i: Fin.Fin degree) => v (Fin.succ degree i),
  preservesAdd := \fun (v, w: Next.Carrier) => \refl(\fun (i: Fin.Fin degree) => Vectors.plus (v (Fin.succ degree i)) (w (Fin.succ degree i))),
  preservesScale := \fun (a: C.Complex)(v: Next.Carrier) => \refl(\fun (i: Fin.Fin degree) => Vectors.scale a (v (Fin.succ degree i))),
};
\definition finalCoordinate: Rows.Map := Rows.Map {
  apply := \fun (v: Next.Carrier) => v Next.last,
  preservesAdd := \fun (v, w: Next.Carrier) => \refl(Vectors.plus (v Next.last) (w Next.last)),
  preservesScale := \fun (a: C.Complex)(v: Next.Carrier) => \refl(Vectors.scale a (v Next.last)),
};
\definition rowPrefix: Rows.Map := Row.Composition[U := Next.Carrier, domain := Next.space].compose row prefix;
\definition rowTail: Rows.Map := Row.Composition[U := Next.Carrier, domain := Next.space].compose row tail;
\definition residual: Rows.Map := Rows.Operations[].plus rowPrefix finalCoordinate;
\definition newRow: Rows.Map := Rows.Operations[].plus rowTail (Rows.Operations[].scale (C.Def[].neg r) residual);
\import Next.FromRow[row := newRow] \as Enlarged;
\definition prefixGeometric: \forall (z: C.Complex)(v: Vectors.Vector) -> prefix.apply ((Next.geometric z).apply v) = (geometric z).apply v :=
  \fun (z: C.Complex)(v: Vectors.Vector) => \refl((geometric z).apply v);
\definition tailGeometric: \forall (z: C.Complex)(v: Vectors.Vector) -> tail.apply ((Next.geometric z).apply v) = space.smul z ((geometric z).apply v) :=
  \fun (z: C.Complex)(v: Vectors.Vector) => \axiom:funext(tail.apply ((Next.geometric z).apply v), space.smul z ((geometric z).apply v),
    \fun (i: Fin.Fin degree) => Vectors.space.scalarAssoc z (power z i) v);
\definition residualGeometric: \forall (z: C.Complex)(v: Vectors.Vector) -> residual.apply ((Next.geometric z).apply v) = (polynomial z).apply v :=
  \fun (z: C.Complex)(v: Vectors.Vector) => ValueGroup.comm (row.apply ((geometric z).apply v)) (Vectors.scale (power z degree) v);
\definition polynomialFactor: \forall (z: C.Complex)(v: Vectors.Vector) -> (Enlarged.polynomial z).apply v = Vectors.scale (C.Def[].add z (C.Def[].neg r)) ((polynomial z).apply v) :=
  \fun (z: C.Complex)(v: Vectors.Vector) => eq_reason_in!{Vectors.Vector
    { (Enlarged.polynomial z).apply v }
    "=" { Vectors.plus (Vectors.scale z (Vectors.scale (power z degree) v)) (Vectors.plus (Vectors.scale z (row.apply ((geometric z).apply v))) (Vectors.scale (C.Def[].neg r) ((polynomial z).apply v))) } "by" {
      congr!{Vectors.Vector Vectors.Vector Vectors.Vector} Vectors.plus _ _ _ _ (Vectors.space.scalarAssoc z (power z degree) v)
        (congr!{Vectors.Vector Vectors.Vector Vectors.Vector} Vectors.plus _ _ _ _
          (trans!{Vectors.Vector} _ _ _ (congr!{Carrier Vectors.Vector} row.apply _ _ (tailGeometric z v)) (row.preservesScale z ((geometric z).apply v)))
          (congr!{Vectors.Vector Vectors.Vector} (Vectors.scale (C.Def[].neg r)) _ _ (residualGeometric z v))) }
    "=" { Vectors.plus (Vectors.plus (Vectors.scale z (Vectors.scale (power z degree) v)) (Vectors.scale z (row.apply ((geometric z).apply v)))) (Vectors.scale (C.Def[].neg r) ((polynomial z).apply v)) } "by" { sym!{Vectors.Vector} _ _ (ValueGroup.assoc _ _ _) }
    "=" { Vectors.plus (Vectors.scale z ((polynomial z).apply v)) (Vectors.scale (C.Def[].neg r) ((polynomial z).apply v)) } "by" { congr!{Vectors.Vector Vectors.Vector} (\fun (w: Vectors.Vector) => Vectors.plus w (Vectors.scale (C.Def[].neg r) ((polynomial z).apply v))) _ _ (sym!{Vectors.Vector} _ _ (Vectors.space.vectorAdd z _ _)) }
    "=" _ "by" { sym!{Vectors.Vector} _ _ (Vectors.space.scalarAdd z (C.Def[].neg r) ((polynomial z).apply v)) }
  };

\import Spaces.DirectSum[V := Carrier, W := Vectors.Vector, left := space, right := Vectors.space] \as State;
\import Spaces.Linear[V := Next.Carrier, W := State.Carrier, source := Next.space, target := State.space] \as Forward;
\definition forward: Forward.Map := State.Universal[U := Next.Carrier, domain := Next.space].pair prefix residual;
\definition backwardValue[p: State.Carrier]: Next.Carrier := Next.join (State.first p) (ValueGroup.difference (State.second p) (row.apply (State.first p)));
\definition prefixBackward: \forall (p: State.Carrier) -> prefix.apply (backwardValue p) = State.first p :=
  \fun (p: State.Carrier) => \axiom:funext(prefix.apply (backwardValue p), State.first p,
    \fun (i: Fin.Fin degree) => Next.atFront (State.first p) (ValueGroup.difference (State.second p) (row.apply (State.first p))) i);
\definition residualBackward: \forall (p: State.Carrier) -> residual.apply (backwardValue p) = State.second p :=
  \fun (p: State.Carrier) => eq_reason_in!{Vectors.Vector
    { residual.apply (backwardValue p) }
    "=" { Vectors.plus (row.apply (State.first p)) (ValueGroup.difference (State.second p) (row.apply (State.first p))) } "by" {
      congr!{Vectors.Vector Vectors.Vector Vectors.Vector} Vectors.plus _ _ _ _
        (congr!{Carrier Vectors.Vector} row.apply _ _ (prefixBackward p))
        (Next.atLast (State.first p) (ValueGroup.difference (State.second p) (row.apply (State.first p)))) }
    "=" { Vectors.plus (ValueGroup.difference (State.second p) (row.apply (State.first p))) (row.apply (State.first p)) } "by" { ValueGroup.comm _ _ }
    "=" _ "by" { ValueGroup.addDifference (State.second p) (row.apply (State.first p)) }
  };
\import std.Data[].Pair[].Prop[A := Carrier, B := Vectors.Vector] \as StatePairs;
\definition forwardBackward: \forall (p: State.Carrier) -> forward.apply (backwardValue p) = p :=
  \fun (p: State.Carrier) => StatePairs.ext _ p (prefixBackward p) (residualBackward p);
\definition lastRecovered: \forall (v: Next.Carrier) -> ValueGroup.difference (residual.apply v) (row.apply (prefix.apply v)) = v Next.last :=
  \fun (v: Next.Carrier) => eq_reason_in!{Vectors.Vector
    { ValueGroup.difference (residual.apply v) (row.apply (prefix.apply v)) }
    "=" { Vectors.plus (Vectors.plus (v Next.last) (row.apply (prefix.apply v))) (Vectors.negative (row.apply (prefix.apply v))) } "by" {
      congr!{Vectors.Vector Vectors.Vector} (\fun (w: Vectors.Vector) => Vectors.plus w (Vectors.negative (row.apply (prefix.apply v)))) _ _ (ValueGroup.comm _ _) }
    "=" { Vectors.plus (v Next.last) (Vectors.plus (row.apply (prefix.apply v)) (Vectors.negative (row.apply (prefix.apply v)))) } "by" { ValueGroup.assoc _ _ _ }
    "=" { Vectors.plus (v Next.last) Vectors.origin } "by" { congr!{Vectors.Vector Vectors.Vector} (Vectors.plus (v Next.last)) _ _ (ValueGroup.inverseRight (row.apply (prefix.apply v))) }
    "=" _ "by" { ValueGroup.zeroRight (v Next.last) }
  };
\definition backwardForward: \forall (v: Next.Carrier) -> backwardValue (forward.apply v) = v :=
  \fun (v: Next.Carrier) => trans!{Next.Carrier} _ _ _
    (congr!{Vectors.Vector Next.Carrier} (Next.join (prefix.apply v)) _ _ (lastRecovered v)) (Next.Reordering[].recover v);

\definition forwardInjective: \forall (v, w: Next.Carrier) -> forward.apply v = forward.apply w -> v = w :=
  \fun (v, w: Next.Carrier)(equal: _) => trans!{Next.Carrier} _ _ _ (sym!{Next.Carrier} _ _ (backwardForward v))
    (trans!{Next.Carrier} _ _ _ (congr!{State.Carrier Next.Carrier} backwardValue _ _ equal) (backwardForward w));
\import Spaces.Linear[V := State.Carrier, W := Next.Carrier, source := State.space, target := Next.space] \as Backward;
\definition backward: Backward.Map := Backward.Map {
  apply := backwardValue,
  preservesAdd := \fun (p, q: State.Carrier) => forwardInjective _ _
    (trans!{State.Carrier} _ _ _ (forwardBackward (State.plus p q))
      (sym!{State.Carrier} _ _ (trans!{State.Carrier} _ _ _ (forward.preservesAdd (backwardValue p) (backwardValue q))
        (congr!{State.Carrier State.Carrier State.Carrier} State.plus _ _ _ _ (forwardBackward p) (forwardBackward q))))),
  preservesScale := \fun (a: C.Complex)(p: State.Carrier) => forwardInjective _ _
    (trans!{State.Carrier} _ _ _ (forwardBackward (State.scale a p))
      (sym!{State.Carrier} _ _ (trans!{State.Carrier} _ _ _ (forward.preservesScale a (backwardValue p))
        (congr!{State.Carrier State.Carrier} (State.scale a) _ _ (forwardBackward p))))),
};
\import Spaces.Isomorphism[V := Next.Carrier, W := State.Carrier, source := Next.space, target := State.space] \as StateIsomorphisms;
\definition stateIsomorphism: StateIsomorphisms.Isomorphism := StateIsomorphisms.Isomorphism {
  forward := forward, backward := backward, leftInverse := backwardForward, rightInverse := forwardBackward,
};
\definition prefixOperator: \forall (v: Next.Carrier) -> prefix.apply (Enlarged.operator.apply v) = tail.apply v :=
  \fun (v: Next.Carrier) => \axiom:funext(prefix.apply (Enlarged.operator.apply v), tail.apply v,
    \fun (i: Fin.Fin degree) => Next.atFront (tail.apply v) (Enlarged.negativeRow.apply v) i);
\definition negativeScalar: \forall (a: C.Complex)(v: Vectors.Vector) -> Vectors.scale (C.Def[].neg a) v = Vectors.negative (Vectors.scale a v) :=
  \fun (a: C.Complex)(v: Vectors.Vector) => Values.cancelLeft (Vectors.scale a v) _ _
    (trans!{Vectors.Vector} _ _ _ (sym!{Vectors.Vector} _ _ (Vectors.space.scalarAdd a (C.Def[].neg a) v))
      (trans!{Vectors.Vector} _ _ _ (congr!{{C.Complex} Vectors.Vector} (\fun (s: C.Complex) => Vectors.scale s v) _ _ (C.Prop[].addNegRight a))
        (trans!{Vectors.Vector} _ _ _ (Values.zeroScale v) (sym!{Vectors.Vector} _ _ (ValueGroup.inverseRight (Vectors.scale a v))))));
\definition rowFormula: \forall (v: Next.Carrier) -> newRow.apply v = ValueGroup.difference (rowTail.apply v) (Vectors.scale r (residual.apply v)) :=
  \fun (v: Next.Carrier) => congr!{Vectors.Vector Vectors.Vector} (Vectors.plus (rowTail.apply v)) _ _ (negativeScalar r (residual.apply v));
\definition residualOperator: \forall (v: Next.Carrier) -> residual.apply (Enlarged.operator.apply v) = Vectors.scale r (residual.apply v) :=
  \fun (v: Next.Carrier) => eq_reason_in!{Vectors.Vector
    { residual.apply (Enlarged.operator.apply v) }
    "=" { ValueGroup.difference (rowTail.apply v) (newRow.apply v) } "by" {
      congr!{Vectors.Vector Vectors.Vector Vectors.Vector} Vectors.plus _ _ _ _
        (congr!{Carrier Vectors.Vector} row.apply _ _ (prefixOperator v))
        (trans!{Vectors.Vector} _ _ _ (Next.atLast (tail.apply v) (Enlarged.negativeRow.apply v)) (Enlarged.negativeRowValue v)) }
    "=" { ValueGroup.difference (rowTail.apply v) (ValueGroup.difference (rowTail.apply v) (Vectors.scale r (residual.apply v))) } "by" {
      congr!{Vectors.Vector Vectors.Vector} (ValueGroup.difference (rowTail.apply v)) _ _ (rowFormula v) }
    "=" _ "by" { ValueGroup.subtractDifference (rowTail.apply v) (Vectors.scale r (residual.apply v)) }
  };

\definition injection[u: Vectors.Vector]: Carrier := join (\fun (_: Fin.Fin d) => Vectors.origin) u;
\definition joinSplitAdd: \forall (f: Fin.Fin d -> Vectors.Vector)(a, b: Vectors.Vector) -> space.add (join f a) (injection b) = join f (Vectors.plus a b) :=
  \fun (f: Fin.Fin d -> Vectors.Vector)(a, b: Vectors.Vector) => trans!{Carrier} _ _ _
    (sym!{Carrier} _ _ (joinAddition f (\fun (_: Fin.Fin d) => Vectors.origin) a b))
    (congr!{{Fin.Fin d -> Vectors.Vector} Carrier} (\fun (g: Fin.Fin d -> Vectors.Vector) => join g (Vectors.plus a b)) _ _
      (\axiom:funext((\fun (i: Fin.Fin d) => Vectors.plus (f i) Vectors.origin), f, \fun (i: Fin.Fin d) => ValueGroup.zeroRight (f i))));
\definition cancelResidual: \forall (a, b: Vectors.Vector) -> Vectors.plus (Vectors.negative a) (Vectors.plus a b) = b :=
  \fun (a, b: Vectors.Vector) => trans!{Vectors.Vector} _ _ _ (sym!{Vectors.Vector} _ _ (ValueGroup.assoc (Vectors.negative a) a b))
    (trans!{Vectors.Vector} _ _ _ (congr!{Vectors.Vector Vectors.Vector} (\fun (w: Vectors.Vector) => Vectors.plus w b) _ _ (ValueGroup.inverseLeft a)) (ValueGroup.zeroLeft b));
\definition firstOperator: \forall (v: Next.Carrier) -> tail.apply v = space.add (operator.apply (prefix.apply v)) (injection (residual.apply v)) :=
  \fun (v: Next.Carrier) => sym!{Carrier} _ _ (eq_reason_in!{Carrier
    { space.add (operator.apply (prefix.apply v)) (injection (residual.apply v)) }
    "=" { join (\fun (i: Fin.Fin d) => prefix.apply v (Fin.succ d i)) (Vectors.plus (negativeRow.apply (prefix.apply v)) (residual.apply v)) } "by" { joinSplitAdd (\fun (i: Fin.Fin d) => prefix.apply v (Fin.succ d i)) (negativeRow.apply (prefix.apply v)) (residual.apply v) }
    "=" { join (\fun (i: Fin.Fin d) => prefix.apply v (Fin.succ d i)) (v Next.last) } "by" {
      congr!{Vectors.Vector Carrier} (join (\fun (i: Fin.Fin d) => prefix.apply v (Fin.succ d i))) _ _
        (trans!{Vectors.Vector} _ _ _ (congr!{Vectors.Vector Vectors.Vector} (\fun (w: Vectors.Vector) => Vectors.plus w (residual.apply v)) _ _ (negativeRowValue (prefix.apply v)))
          (cancelResidual (row.apply (prefix.apply v)) (v Next.last))) }
    "=" _ "by" { \root.Linearization[].Companion[n := n, d := d].Reordering[].recover (tail.apply v) }
  });
\definition triangularValue[p: State.Carrier]: State.Carrier := State.make (space.add (operator.apply (State.first p)) (injection (State.second p))) (Vectors.scale r (State.second p));
\definition intertwines: \forall (v: Next.Carrier) -> forward.apply (Enlarged.operator.apply v) = triangularValue (forward.apply v) :=
  \fun (v: Next.Carrier) => StatePairs.ext _ _
    (trans!{Carrier} _ _ _ (prefixOperator v) (firstOperator v)) (residualOperator v);

\import algebra.Group[].Of[Carrier := C.Complex, group := Scalars.additiveGroup] \as ScalarGroup;
\definition factorNonzero: Logic.Not (C.Absolute[].abs r = R.one) -> \forall (z: C.Complex) -> C.Absolute[].abs z = R.one -> C.Def[].NonZero (C.Def[].add z (C.Def[].neg r)) :=
  \fun (off: _)(z: C.Complex)(unit: _)(zero: C.Def[].add z (C.Def[].neg r) = C.Def[].zero) => off
    (trans!{{R.Real}} _ _ _ (congr!{{C.Complex} {R.Real}} C.Absolute[].abs r z
      (sym!{{C.Complex}} _ _ (trans!{{C.Complex}} _ _ _ (sym!{{C.Complex}} _ _ (ScalarGroup.addDifference z r))
        (trans!{{C.Complex}} _ _ _ (congr!{{C.Complex} {C.Complex}} (\fun (w: C.Complex) => C.Def[].add w r) _ _ zero) (C.Prop[].addZeroLeft r))))) unit);
\definition scalarKernel: \forall (a: C.Complex) -> C.Def[].NonZero a -> \forall (v: Vectors.Vector) -> Vectors.scale a v = Vectors.origin -> v = Vectors.origin :=
  \fun (a: C.Complex)(nonzero: _)(v: Vectors.Vector)(zero: _) => eq_reason_in!{Vectors.Vector v
    "=" { Vectors.scale C.Def[].one v } "by" { sym!{Vectors.Vector} _ _ (Vectors.space.scalarOne v) }
    "=" { Vectors.scale (C.Def[].mul (C.Def[].inv a) a) v } "by" { congr!{{C.Complex} Vectors.Vector} (\fun (s: C.Complex) => Vectors.scale s v) _ _ (sym!{{C.Complex}} _ _ (C.Prop[].inverseNonzero a nonzero)) }
    "=" { Vectors.scale (C.Def[].inv a) (Vectors.scale a v) } "by" { Vectors.space.scalarAssoc (C.Def[].inv a) a v }
    "=" { Vectors.scale (C.Def[].inv a) Vectors.origin } "by" { congr!{Vectors.Vector Vectors.Vector} (Vectors.scale (C.Def[].inv a)) _ _ zero }
    "=" _ "by" { Values.scaleZero (C.Def[].inv a) }
  };
\definition polynomialKernel:
  (\forall (z: C.Complex) -> C.Absolute[].abs z = R.one -> \forall (v: Vectors.Vector) -> (polynomial z).apply v = Vectors.origin -> v = Vectors.origin) ->
  Logic.Not (C.Absolute[].abs r = R.one) ->
  \forall (z: C.Complex) -> C.Absolute[].abs z = R.one -> \forall (v: Vectors.Vector) -> (Enlarged.polynomial z).apply v = Vectors.origin -> v = Vectors.origin :=
  \fun (kernel: _)(off: _)(z: C.Complex)(unit: _)(v: Vectors.Vector)(zero: _) => kernel z unit v
    (scalarKernel (C.Def[].add z (C.Def[].neg r)) (factorNonzero off z unit) ((polynomial z).apply v)
      (trans!{Vectors.Vector} _ _ _ (sym!{Vectors.Vector} _ _ (polynomialFactor z v)) zero));
