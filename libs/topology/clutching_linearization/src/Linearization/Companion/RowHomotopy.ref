\import algebraic_topology.Interval[] \as Time;
\import std.Data[].Pair[] \as Pair;
\definition Domain: \Set := Pair.Times^[Time.Carrier, X];
\import topological_constructions.Product[A := Time.Carrier, B := X] \as Cylinder;
\definition topology: topology.Topology[Carrier := Domain].Topology := Cylinder.topology Time.topology source;
\import topological_algebra.Complex[] \as Plane;
\module With(rows: Domain -> Row.Map,
  regular: \forall (v: Carrier)(j: Fin.Fin n) -> topology.Continuity[A := Domain, B := C.Complex].Continuous topology Plane.topology (\fun (p: Domain) => (rows p).apply v j),
  kernel: \forall (p: Domain)(z: C.Complex) -> C.Absolute[].abs z = R.one -> \forall (v: Vectors.Vector) -> (\root.Linearization[].Companion[n := n, d := d].FromRow[row := rows p].polynomial z).apply v = Vectors.origin -> v = Vectors.origin);
