\import std.Data[].Pair[] \as Pair;
\definition baseMatrix: X -> Matrices.Matrix := matrix;
\definition baseMatrixRegular: Top.Regular source baseMatrix := matrixRegular;
\import topological_constructions.Product[A := X, B := C.Complex] \as Product;
\definition Domain: \Set := Product.CarrierSet;
\definition topology: topology.Topology[Carrier := Domain].Topology := Product.topology source Plane.topology;
\definition base: Domain -> X := Pair.first X C.Complex;
\definition variable: Domain -> C.Complex := Pair.second X C.Complex;
\import \root.Linearization[].Coordinates[n := n].Families[X := Domain, source := topology] \as Families;
\import \root.Linearization[].Companion[n := n, d := d].ShiftFamilies[Y := Domain, source := topology, z := variable, regularZ := Product.Maps[].secondContinuous source Plane.topology] \as Shift;
\import \root.Linearization[].Companion[n := n, d := d].Splitting[] \as Splitting;
\import Spaces.Isomorphism[V := Carrier, W := Carrier, source := space, target := space] \as EndIso;
\import Spaces.DirectSum[V := Vectors.Vector, W := Coordinates.Carrier d, left := Vectors.space, right := Coordinates.space d] \as Sum;
\import Fin.Tuples[A := Vectors.Vector] \as Tuples;
\module At(p: Domain);
\definition pencil[p: Domain]: Operators.Map := At[p := p].pencil;
\definition left[p: Domain]: EndIso.Isomorphism := At[p := p].left;
\definition right[p: Domain]: EndIso.Isomorphism := At[p := p].right;
\definition diagonal[p: Domain]: Operators.Map := At[p := p].diagonal;
\definition comparison: \forall (p: Domain)(v: Carrier) -> (left p).forward.apply ((pencil p).apply ((right p).forward.apply v)) = (diagonal p).apply v :=
  \fun (p: Domain) => At[p := p].comparison;
\module Regularity;
\module Gauges;
