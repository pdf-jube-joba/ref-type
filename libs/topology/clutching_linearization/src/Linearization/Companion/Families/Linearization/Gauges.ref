\import \parent.Regularity[] \as Continuity;
\import \root.Linearization[].BlockMatrices[n := n, d := degree, Y := Domain, source := topology, A := (\fun (p: Domain) => (left p).forward),
  regular := (\fun (v: Carrier) => Continuity.leftRegular (\fun (_: Domain) => v) (Families.constant degree v))] \as Left;
\import \root.Linearization[].BlockMatrices[n := n, d := degree, Y := Domain, source := topology, A := (\fun (p: Domain) => (right p).forward),
  regular := (\fun (v: Carrier) => Continuity.rightRegular (\fun (_: Domain) => v) (Families.constant degree v))] \as Right;
\import \root.Linearization[].BlockMatrices[n := n, d := degree, Y := Domain, source := topology, A := pencil,
  regular := (\fun (v: Carrier) => Continuity.pencilRegular (\fun (_: Domain) => v) (Families.constant degree v))] \as Pencil;
\import \root.Linearization[].BlockMatrices[n := n, d := degree, Y := Domain, source := topology, A := diagonal,
  regular := (\fun (v: Carrier) => Continuity.diagonalRegular (\fun (_: Domain) => v) (Families.constant degree v))] \as Diagonal;
\import Left.WithInverse[B := (\fun (p: Domain) => (left p).backward), left := (\fun (p: Domain) => (EndIso.laws (left p)).leftInverse), right := (\fun (p: Domain) => (EndIso.laws (left p)).rightInverse)] \as LeftInverse;
\import Right.WithInverse[B := (\fun (p: Domain) => (right p).backward), left := (\fun (p: Domain) => (EndIso.laws (right p)).leftInverse), right := (\fun (p: Domain) => (EndIso.laws (right p)).rightInverse)] \as RightInverse;
\definition leftMatrix: Domain -> Matrices.Matrix := Left.matrix;
\definition rightMatrix: Domain -> Matrices.Matrix := Right.matrix;
\definition pencilMatrix: Domain -> Matrices.Matrix := Pencil.matrix;
\definition diagonalMatrix: Domain -> Matrices.Matrix := Diagonal.matrix;
\definition leftRegular: matrix_invariants.Topological[K := C.Complex, ring := Plane.Ring[].topologicalRing].At[n := Coordinates.dimension degree].Families[X := Domain].Regular topology leftMatrix := Left.matrixRegular;
\definition rightRegular: matrix_invariants.Topological[K := C.Complex, ring := Plane.Ring[].topologicalRing].At[n := Coordinates.dimension degree].Families[X := Domain].Regular topology rightMatrix := Right.matrixRegular;
\definition leftNonzero: \forall (p: Domain) -> matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := Coordinates.dimension degree].Nonzero (leftMatrix p) := LeftInverse.nonzero;
\definition rightNonzero: \forall (p: Domain) -> matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := Coordinates.dimension degree].Nonzero (rightMatrix p) := RightInverse.nonzero;
\import Operators.Composition[U := Carrier, domain := space] \as Composition;
\definition matrixComparison: \forall (p: Domain) -> Matrices.product (Matrices.product (leftMatrix p) (pencilMatrix p)) (rightMatrix p) = diagonalMatrix p :=
  \fun (p: Domain) => eq_reason_in!{Matrices.Matrix _
    "=" { Matrices.product (Left.entries (Composition.compose (left p).forward (pencil p))) (rightMatrix p) } "by" {
      congr!{Matrices.Matrix Matrices.Matrix} (\fun (m: Matrices.Matrix) => Matrices.product m (rightMatrix p)) _ _ (sym!{Matrices.Matrix} _ _ (Left.composition (left p).forward (pencil p))) }
    "=" { Left.entries (Composition.compose (Composition.compose (left p).forward (pencil p)) (right p).forward) } "by" {
      sym!{Matrices.Matrix} _ _ (Left.composition (Composition.compose (left p).forward (pencil p)) (right p).forward) }
    "=" { Left.entries (diagonal p) } "by" { congr!{Operators.Map Matrices.Matrix} Left.entries _ _
      (Operators.ext _ _ (\axiom:funext((Composition.compose (Composition.compose (left p).forward (pencil p)) (right p).forward).apply, (diagonal p).apply, comparison p))) }
  };
