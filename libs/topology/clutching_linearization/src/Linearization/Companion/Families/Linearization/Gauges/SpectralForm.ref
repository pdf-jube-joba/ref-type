\import \root.Linearization[].Companion[n := n, d := d].With[coefficients := coefficients (base p)] \as Cyclic;
\import Spaces.Coordinates[I := Matrices.Index] \as Flat;
\import Spaces.Linear[V := Flat.Vector, W := Flat.Vector, source := Flat.space, target := Flat.space] \as FlatEnd;
\import FlatEnd.Operations[] \as FlatOperations;
\import Spaces.Eigen[V := Carrier, space := space] \as Eigen;
\import spectral_splitting.Spectral[].At[n := Coordinates.dimension degree].Pencil[A := baseMatrix (base p), z := variable p] \as Native;
\definition operator: Pencil.coordinateMap Cyclic.operator = Matrices.linear (baseMatrix (base p)) :=
  FlatEnd.ext _ _ (\axiom:funext((Pencil.coordinateMap Cyclic.operator).apply, (Matrices.linear (baseMatrix (base p))).apply,
    \fun (v: Flat.Vector) => sym!{Flat.Vector} _ _ (Cyclic.Spectral[].formula v)));
\definition action: Pencil.coordinateMap (pencil p) = Native.value := eq_reason_in!{FlatEnd.Map _
  "=" { FlatOperations.plus (Pencil.coordinateMap (Eigen.scalar (variable p))) (Pencil.coordinateMap (Operators.Operations[].negative Cyclic.operator)) } "by" {
    Pencil.coordinateAddition (Eigen.scalar (variable p)) (Operators.Operations[].negative Cyclic.operator) }
  "=" { FlatOperations.plus (Spaces.Eigen[V := Flat.Vector, space := Flat.space].scalar (variable p)) (FlatOperations.scale (C.Def[].neg C.Def[].one) (Pencil.coordinateMap Cyclic.operator)) } "by" {
    congr!{FlatEnd.Map FlatEnd.Map FlatEnd.Map} FlatOperations.plus _ _ _ _ (Pencil.coordinateScalar (variable p)) (Pencil.coordinateScale (C.Def[].neg C.Def[].one) Cyclic.operator) }
  "=" _ "by" {
    congr!{FlatEnd.Map FlatEnd.Map} (\fun (f: FlatEnd.Map) => FlatOperations.plus (Spaces.Eigen[V := Flat.Vector, space := Flat.space].scalar (variable p)) (FlatOperations.negative f)) _ _ operator }
};
\definition entries: pencilMatrix p = Native.entries :=
  congr!{FlatEnd.Map Matrices.Matrix} Matrices.Representation[].entries _ _ action;
