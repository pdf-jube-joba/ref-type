\import spectral_splitting.Spectral[].At[n := Coordinates.dimension degree].Pencil[A := baseMatrix (Pair.first X Circle.Carrier q), z := Pair.second X Circle.Carrier q] \as Native;
\definition finish: Motion.Domain := Pair.pair Time.Carrier Carrier Time.end q;
\definition action: Motion.value finish = Native.value := FlatEnd.ext _ _
  (\axiom:funext((Motion.value finish).apply, Native.value.apply, Motion.Endpoints[q := q].atEnd));
\definition equal: pencil q = Finish.endpointMatrix q :=
  trans!{Matrices.Matrix} _ _ _
    (\root.Linearization[].Companion[n := n, d := d].Families[X := X, source := source, coefficients := coefficients, regular := regular].Linearization[].Gauges[].SpectralForm[p := include q].entries)
    (sym!{Matrices.Matrix} _ _ (congr!{FlatEnd.Map Matrices.Matrix} Matrices.Representation[].entries _ _ action));
