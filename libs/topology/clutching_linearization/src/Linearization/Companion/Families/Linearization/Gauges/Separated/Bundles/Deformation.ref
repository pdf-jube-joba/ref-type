\import \root.Linearization[].Companion[n := n, d := d].Families[X := X, source := source, coefficients := coefficients, regular := regular].Separated[kernel := kernel] \as Splitting;
\import \root.Linearization[].SpectralMotion[n := Coordinates.dimension degree, X := X, source := source,
  A := baseMatrix, regular := baseMatrixRegular, off := Splitting.off] \as Motion;
\import algebraic_topology.Interval[] \as Time;
\import Motion.Endpoint[t := Time.end] \as Finish;
\import Motion.Comparison[compact := compact, hausdorff := hausdorff] \as Normal;
\import Spaces.Coordinates[I := Matrices.Index] \as Flat;
\import Spaces.Linear[V := Flat.Vector, W := Flat.Vector, source := Flat.space, target := Flat.space] \as FlatEnd;
\module At(q: Carrier);
\definition endpointEquality: \forall (q: Carrier) -> pencil q = Finish.endpointMatrix q := \fun (q: Carrier) => At[q := q].equal;
\import First.Comparison[b := Finish.endpointMatrix, regularB := Finish.endpointRegular, nonzeroB := Finish.invertible] \as EndpointComparison;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].IsomorphismComposition[
  X := Base, F := PencilFiber, G := Normal.PencilFiber, H := Normal.NormalFiber,
  source := pencilBundle, middle := Normal.pencilBundle, target := Normal.normalBundle] \as Compose;
\definition NormalFiber: Base -> \Set := Normal.NormalFiber;
\definition normalBundle: VectorBundles.Family[X := Base, F := NormalFiber].Bundle := Normal.normalBundle;
\definition isomorphismExists: \exists VectorBundles.Isomorphisms[X := Base, F := PencilFiber, G := NormalFiber,
  source := pencilBundle, target := normalBundle].Isomorphism :=
  Compose.exists (EndpointComparison.ofEquality endpointEquality) Normal.isomorphismExists;
