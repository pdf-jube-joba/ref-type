\import topological_algebra.Complex[] \as Plane;
\import Plane.Functions[A := X] \as Functions;
\import \root.Linearization[].Coordinates[n := n].Families[X := X, source := source] \as Flatten;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := Coordinates.dimension degree] \as Matrices;
\import matrix_invariants.Topological[K := C.Complex, ring := Plane.Ring[].topologicalRing].At[n := Coordinates.dimension degree].Families[X := X] \as Top;
\import Spaces.FiniteCoordinates[n := Coordinates.dimension degree] \as Basis;
\definition matrix[x: X]: Matrices.Matrix := \root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].Spectral[].matrix;
\module At(v: Carrier);
\definition entryFormula: \forall (x: X)(i, j: Matrices.Index) -> matrix x i j =
  Coordinates.flatten degree ((\root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].operator).apply (Coordinates.unflatten degree (Basis.vectors j))) i :=
  \fun (x: X)(i, j: Matrices.Index) => trans!{{C.Complex}} _ _ _
    (sym!{{C.Complex}} _ _ (congr!{Matrices.Vector {C.Complex}} (\fun (v: Matrices.Vector) => v i) _ _ (Matrices.onBasis (matrix x) j)))
    (congr!{Matrices.Vector {C.Complex}} (\fun (v: Matrices.Vector) => v i) _ _ (\root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].Spectral[].formula (Basis.vectors j)));
\definition matrixRegular: Top.Regular source matrix := \fun (i, j: Matrices.Index) => Top.transport source
  (\fun (x: X) => Coordinates.flatten degree ((\root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].operator).apply (Coordinates.unflatten degree (Basis.vectors j))) i)
  (\fun (x: X) => matrix x i j) (\fun (x: X) => sym!{{C.Complex}} _ _ (entryFormula x i j))
  (Flatten.flattenRegular degree (\fun (x: X) => (\root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].operator).apply (Coordinates.unflatten degree (Basis.vectors j)))
    At[v := Coordinates.unflatten degree (Basis.vectors j)].operatorRegular i);
\module Separated(kernel: \forall (x: X)(z: C.Complex) -> C.Absolute[].abs z = R.one -> \forall (v: Vectors.Vector) ->
  (\root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].polynomial z).apply v = Vectors.origin -> v = Vectors.origin);

\module Factor(r: C.Complex);
\module SamePolynomial(other: X -> Row.Map,
  regularOther: \forall (v: Carrier)(j: Fin.Fin n) -> topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology (\fun (x: X) => (other x).apply v j),
  kernel: \forall (x: X)(z: C.Complex) -> C.Absolute[].abs z = R.one -> \forall (v: Vectors.Vector) -> (\root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].polynomial z).apply v = Vectors.origin -> v = Vectors.origin,
  same: \forall (x: X)(z: C.Complex) -> C.Absolute[].abs z = R.one -> \forall (v: Vectors.Vector) -> (\root.Linearization[].Companion[n := n, d := d].FromRow[row := rows x].polynomial z).apply v = (\root.Linearization[].Companion[n := n, d := d].FromRow[row := other x].polynomial z).apply v);
\module Factors(r: C.Complex, offR: Logic.Not (C.Absolute[].abs r = R.one));
\module Pad;
\module Complete;
\module Evaluation(z: X -> C.Complex, regularZ: topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology z);
\module Normalize(a: X -> C.Complex, regularA: topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology a,
  nonzero: \forall (x: X) -> C.Def[].NonZero (a x));
