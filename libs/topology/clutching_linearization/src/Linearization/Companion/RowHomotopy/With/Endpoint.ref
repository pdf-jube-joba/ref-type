\definition include[x: X]: Domain := Pair.pair Time.Carrier X t x;
\definition continuous: topology.Continuity[A := X, B := Domain].Continuous source topology include :=
  Cylinder.Universal[X := X].pairContinuous source Time.topology source (\fun (_: X) => t) (\fun (x: X) => x)
    (topology.Maps[A := X, B := Time.Carrier].constantContinuous source Time.topology t)
    (topology.Maps[A := X, B := X].Identity[].continuous source);
\definition endpointRows[x: X]: Row.Map := rows (include x);
\definition endpointRegular: \forall (v: Carrier)(j: Fin.Fin n) -> topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology (\fun (x: X) => (endpointRows x).apply v j) :=
  \fun (v: Carrier)(j: Fin.Fin n) => topology.Composition[A := X, B := Domain, C := C.Complex].composeContinuous source topology Plane.topology include (\fun (p: Domain) => (rows p).apply v j) continuous (regular v j);
\import \root.Linearization[].Companion[n := n, d := d].RowFamilies[X := X, source := source, rows := endpointRows, regular := endpointRegular] \as EndpointFamily;
\definition matrix: X -> matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := Coordinates.dimension degree].Matrix := EndpointFamily.matrix;
\definition matrixRegular: matrix_invariants.Topological[K := C.Complex, ring := Plane.Ring[].topologicalRing].At[n := Coordinates.dimension degree].Families[X := X].Regular source matrix := EndpointFamily.matrixRegular;
\definition off: \forall (x: X) -> spectral_splitting.Spectral[].At[n := Coordinates.dimension degree].Splitting[A := matrix x].OffSpectrum :=
  \fun (x: X) => Separated.off (include x);
