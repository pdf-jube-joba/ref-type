\import \parent.Endpoint[t := Time.start] \as Start;
\import \parent.Endpoint[t := Time.end] \as Finish;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff] \as On;
\import On.SpectralHomotopy[n := Coordinates.dimension degree, A := Family.matrix, regular := Family.matrixRegular, off := Separated.off, removed := removed] \as Motion;
\import On.SpectralIndex[n := Coordinates.dimension degree, A := Start.matrix, regular := Start.matrixRegular, off := Start.off, removed := removed] \as First;
\import On.SpectralIndex[n := Coordinates.dimension degree, A := Finish.matrix, regular := Finish.matrixRegular, off := Finish.off, removed := removed] \as Last;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\definition startValue: K.K0[].Carrier := First.value;
\definition endValue: K.K0[].Carrier := Last.value;
\definition invariant: startValue = endValue := Motion.invariant;
