\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Pair[] \as Pair;
\import Fin.Sum[m := n, n := m] \as Indices;
\import Indices.Tuples[A := C.Complex] \as Tuples;
\definition total: N.Nat^ := Indices.total;
\import Spaces.Coordinates[I := Fin.Fin n] \as V;
\import Spaces.Coordinates[I := Fin.Fin m] \as W;
\import Spaces.Coordinates[I := Fin.Fin total] \as Flat;
\import Spaces.DirectSum[V := V.Vector, W := W.Vector, left := V.space, right := W.space] \as Sum;
\import Spaces.Linear[V := W.Vector, W := V.Vector, source := W.space, target := V.space] \as Rows;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar].CoordinateSum[n := n, m := m] \as Coordinates;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing] \as Matrices;
\import Matrices.At[n := n] \as MA;
\import Matrices.At[n := m] \as MB;
\import Matrices.At[n := total] \as M;
\import topological_algebra.Complex[] \as Plane;
\import matrix_invariants.Topological[K := C.Complex, ring := Plane.Ring[].topologicalRing] \as MatrixTopology;
\import hermitian_frames.Hermitian[].Over[K := C.Complex, field := Scalars.field, scalar := linear_algebra.Hermitian[].Complex[].scalar,
  topological := hermitian_frames.Hermitian[].Complex[].topological] \as Hermitian;
\module With(A: X -> MA.Matrix, B: X -> MB.Matrix, coupling: X -> Rows.Map,
  regularA: MatrixTopology.At[n := n].Families[X := X].Regular source A,
  regularB: MatrixTopology.At[n := m].Families[X := X].Regular source B,
  regularCoupling: Hermitian.At[n := n].Families[X := X].Matrix[m := m].Regular source coupling,
  offA: \forall (x: X) -> spectral_splitting.Spectral[].At[n := n].Splitting[A := A x].OffSpectrum,
  offB: \forall (x: X) -> spectral_splitting.Spectral[].At[n := m].Splitting[A := B x].OffSpectrum);
