\definition collapse: \forall (v: V) -> Group.difference v ((power order).apply v) = v :=
  \fun (v: V) => eq_reason_in!{V _
    "=" { Group.difference v space.zero } "by" { congr!{V V} (Group.difference v) _ _ (nilpotent v) }
    "=" { space.add v space.zero } "by" { congr!{V V} (space.add v) _ _ Group.negZero }
    "=" v "by" { Group.zeroRight v }
  };
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := difference, backward := partial order,
  leftInverse := \fun (v: V) => trans!{V} _ _ _ (rightTelescoping order v) (collapse v),
  rightInverse := \fun (v: V) => trans!{V} _ _ _ (leftTelescoping order v) (collapse v),
};
