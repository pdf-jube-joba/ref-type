\definition point: Domain := Pair.pair R.Real X R.zero x;
\definition factorOne: factor point = C.Def[].one := trans!{{C.Complex}} _ _ _ (congr!{{C.Complex} {C.Complex}} (C.Def[].add C.Def[].one) _ _ (C.Prop[].mulZeroLeft (z x))) (C.Prop[].addZeroRight C.Def[].one);
\definition multiplierZero: \forall (k: N.Nat^) -> multiplier k point = C.Def[].zero :=
  \fun (k: N.Nat^) => trans!{{C.Complex}} _ _ _ (congr!{{C.Complex} {C.Complex}} (\fun (s: C.Complex) => C.Def[].sub (Powers.value s k) C.Def[].one) _ _ factorOne)
    (trans!{{C.Complex}} _ _ _ (congr!{{C.Complex} {C.Complex}} (\fun (s: C.Complex) => C.Def[].sub s C.Def[].one) _ _ (Powers.one k)) (C.Prop[].subSelf C.Def[].one));
\definition termZero: \forall (w, v: C.Complex)(k: N.Nat^) -> C.Def[].mul w (C.Def[].mul (multiplier k point) v) = C.Def[].zero :=
  \fun (w, v: C.Complex)(k: N.Nat^) => trans!{{C.Complex}} _ _ _
    (congr!{{C.Complex} {C.Complex}} (\fun (s: C.Complex) => C.Def[].mul w (C.Def[].mul s v)) _ _ (multiplierZero k))
    (trans!{{C.Complex}} _ _ _ (congr!{{C.Complex} {C.Complex}} (C.Def[].mul w) _ _ (C.Prop[].mulZeroLeft v)) (C.Prop[].mulZeroRight w));
\definition equality: value point = original x := Matrices.Operations[].ext _ _ (\fun (i, j: Matrices.Index) =>
  trans!{{C.Complex}} _ _ _ (congr!{{C.Complex} {C.Complex}} (C.Def[].add (original x i j)) _ _
    (trans!{{C.Complex}} _ _ _ (congr!{{C.Complex} {C.Complex} {C.Complex}} C.Def[].add _ _ _ _ (termZero (complement point) (left x i j) leftPower) (termZero (weight x) (right x i j) rightPower)) (C.Prop[].addZeroLeft C.Def[].zero)))
    (C.Prop[].addZeroRight (original x i j)));
