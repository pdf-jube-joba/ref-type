\import topological_constructions.Product[A := R.Real, B := X] \as Product;
\definition Domain: \Set := Product.CarrierSet;
\definition topology: topology.Topology[Carrier := Domain].Topology := Product.topology metric_spaces.RealLine[].topology source;
\module With(family: Domain -> Matrices.Matrix, regular: Top.Families[X := Domain].Regular topology family,
  atZero: \forall (x: X) -> Field.Nonzero (family (Pair.pair R.Real X R.zero x)));
