\import std.Data[].FinSet[] \as Fin;
\import Fin.Sum[m := n, n := m] \as Indices;
\import Indices.Tuples[A := C.Complex] \as Entries;
\import Spaces.CoordinateSum[n := n, m := m] \as Sum;
\definition total: N.Nat^ := Sum.dimension;
\import Spaces.Coordinates[I := Fin.Fin n] \as V;
\import Spaces.Coordinates[I := Fin.Fin m] \as W;
\import Spaces.Coordinates[I := Fin.Fin total] \as T;
\import \root.Linearization[].Companion[n := n, d := d] \as Left;
\import \root.Linearization[].Companion[n := m, d := d] \as Right;
\import \root.Linearization[].Companion[n := total, d := d] \as Total;
\import \root.Linearization[].Coordinates[n := total] \as Coordinates;
\import Spaces.Linear[V := Total.Carrier, W := T.Vector, source := Total.space, target := T.space] \as Row;
\definition left[v: Total.Carrier][i: Fin.Fin Total.degree]: V.Vector := Sum.left (v i);
\definition right[v: Total.Carrier][i: Fin.Fin Total.degree]: W.Vector := Sum.right (v i);
\definition joined[v: Left.Carrier][w: Right.Carrier][i: Fin.Fin Total.degree]: T.Vector := Sum.join (v i) (w i);
\definition leftJoined: \forall (v: Left.Carrier)(w: Right.Carrier) -> left (joined v w) = v := \fun (v: Left.Carrier)(w: Right.Carrier) =>
  \axiom:funext(left (joined v w), v, \fun (i: Fin.Fin Total.degree) => Sum.leftJoin (v i) (w i));
\definition rightJoined: \forall (v: Left.Carrier)(w: Right.Carrier) -> right (joined v w) = w := \fun (v: Left.Carrier)(w: Right.Carrier) =>
  \axiom:funext(right (joined v w), w, \fun (i: Fin.Fin Total.degree) => Sum.rightJoin (v i) (w i));
\definition recover: \forall (v: Total.Carrier) -> joined (left v) (right v) = v := \fun (v: Total.Carrier) =>
  \axiom:funext(joined (left v) (right v), v, \fun (i: Fin.Fin Total.degree) => Sum.recover (v i));
\definition rows[x: X]: Row.Map := Row.Map {
  apply := \fun (v: Total.Carrier) => Sum.join ((q0 x).apply (left v)) ((q1 x).apply (right v)),
  preservesAdd := \fun (v, w: Total.Carrier) => trans!{T.Vector} _ _ _
    (congr!{V.Vector W.Vector T.Vector} Sum.join _ _ _ _ ((q0 x).preservesAdd (left v) (left w)) ((q1 x).preservesAdd (right v) (right w)))
    (Sum.addition ((q0 x).apply (left v)) ((q0 x).apply (left w)) ((q1 x).apply (right v)) ((q1 x).apply (right w))),
  preservesScale := \fun (s: C.Complex)(v: Total.Carrier) => trans!{T.Vector} _ _ _
    (congr!{V.Vector W.Vector T.Vector} Sum.join _ _ _ _ ((q0 x).preservesScale s (left v)) ((q1 x).preservesScale s (right v)))
    (Sum.scalar s ((q0 x).apply (left v)) ((q1 x).apply (right v))),
};
\import \root.Linearization[].RowOrders[n := total, X := X, source := source] \as Orders;
\import topological_algebra.Complex[] \as Plane;
\definition regular: Orders.Regular d rows := \fun (v: Total.Carrier)(i: Fin.Fin total) =>
  (\induction (s: Indices.Index) \return topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology
    (\fun (x: X) => Entries.evaluate ((q0 x).apply (left v)) ((q1 x).apply (right v)) s) \with {
    | inl: \fun (j: Fin.Fin n) => regular0 (left v) j
    | inr: \fun (j: Fin.Fin m) => regular1 (right v) j
  }) (Indices.split i);
\definition polynomialLeft: \forall (x: X)(z: C.Complex)(v: T.Vector) -> Sum.left ((Total.FromRow[row := rows x].polynomial z).apply v) = (Left.FromRow[row := q0 x].polynomial z).apply (Sum.left v) :=
  \fun (x: X)(z: C.Complex)(v: T.Vector) => congr!{V.Vector V.Vector} (V.plus (V.scale (Left.power z Left.degree) (Sum.left v))) _ _
    (Sum.leftJoin ((q0 x).apply (left ((Total.geometric z).apply v))) ((q1 x).apply (right ((Total.geometric z).apply v))));
\definition polynomialRight: \forall (x: X)(z: C.Complex)(v: T.Vector) -> Sum.right ((Total.FromRow[row := rows x].polynomial z).apply v) = (Right.FromRow[row := q1 x].polynomial z).apply (Sum.right v) :=
  \fun (x: X)(z: C.Complex)(v: T.Vector) => congr!{W.Vector W.Vector} (W.plus (W.scale (Right.power z Right.degree) (Sum.right v))) _ _
    (Sum.rightJoin ((q0 x).apply (left ((Total.geometric z).apply v))) ((q1 x).apply (right ((Total.geometric z).apply v))));
\definition zeroJoin: Sum.join V.origin W.origin = T.origin := \axiom:funext(Sum.join V.origin W.origin, T.origin, \fun (i: Fin.Fin total) =>
  (\induction (s: Indices.Index) \return Entries.evaluate V.origin W.origin s = C.Def[].zero \with {
    | inl: \fun (_: Fin.Fin n) => \refl(C.Def[].zero)
    | inr: \fun (_: Fin.Fin m) => \refl(C.Def[].zero)
  }) (Indices.split i));
\definition kernel: Orders.Kernel d rows := \fun (x: X)(z: C.Complex)(unit: _)(v: T.Vector)(zero: _) => trans!{T.Vector} _ _ _ (sym!{T.Vector} _ _ (Sum.recover v))
  (trans!{T.Vector} _ _ _ (congr!{V.Vector W.Vector T.Vector} Sum.join _ _ _ _
    (kernel0 x z unit (Sum.left v) (trans!{V.Vector} _ _ _ (sym!{V.Vector} _ _ (polynomialLeft x z v)) (congr!{T.Vector V.Vector} Sum.left _ _ zero)))
    (kernel1 x z unit (Sum.right v) (trans!{W.Vector} _ _ _ (sym!{W.Vector} _ _ (polynomialRight x z v)) (congr!{T.Vector W.Vector} Sum.right _ _ zero)))) zeroJoin);
\module Shape;
