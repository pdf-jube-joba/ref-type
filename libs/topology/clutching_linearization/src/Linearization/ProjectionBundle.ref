\import spectral_splitting.Spectral[].Idempotents[n := n].Image[X := X, baseSpace := source, P := P, regular := regular] \as Image;
\import Image.Complement[] \as Split;
\import spectral_splitting.Spectral[].Idempotents[n := n].Image[X := X, baseSpace := source, P := Split.Q, regular := Split.qRegular] \as Other;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n] \as M;
\import Spaces.Coordinates[I := M.Index] \as Vectors;
\import std.Data[].Pair[] \as Pair;
\definition ImageFiber: X -> \Set := Image.Fiber;
\definition ComplementFiber: X -> \Set := Split.ComplementFiber;
\definition SumFiber: X -> \Set := Split.SumFiber;
\definition imageBundle: Bundles.Family[X := X, F := ImageFiber].Bundle := Image.bundle;
\definition complementBundle: Bundles.Family[X := X, F := ComplementFiber].Bundle := Split.complementBundle;
\definition sumBundle: Bundles.Family[X := X, F := SumFiber].Bundle := Split.sumBundle;
\import Bundles.Trivial[X := X, n := n, baseSpace := source] \as Ambient;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := SumFiber, G := (\fun (_: X) => M.Vector), source := sumBundle, target := Ambient.bundle].Isomorphism := Split.isomorphism;
\module At(x: X);
\module Scalar(a: X -> C.Complex, continuous: topology.Continuity[A := X, B := C.Complex].Continuous source topological_algebra.Complex[].topology a);
\module TensorLine(L: X -> \Set, line: Bundles.Family[X := X, F := L].Bundle, sameBase: line.baseSpace = source);
\module Clutching(U, V: \Pow X, openU: topology.Topology[Carrier := X].IsOpenIn source U,
  openV: topology.Topology[Carrier := X].IsOpenIn source V, covers: \forall (x: X) -> Logic.Or[\In[X] U x, \In[X] V x]);
\import hermitian_frames.Hermitian[].Over[K := C.Complex, field := Scalars.field, scalar := linear_algebra.Hermitian[].Complex[].scalar,
  topological := hermitian_frames.Hermitian[].Complex[].topological] \as Hermitian;
\module Into(m: N.Nat^, Q: X -> spectral_splitting.Spectral[].Idempotents[n := m].Projection,
  regularQ: Hermitian.At[n := m].Families[X := X].Matrix[m := m].Regular source (\fun (x: X) => (Q x).map));
