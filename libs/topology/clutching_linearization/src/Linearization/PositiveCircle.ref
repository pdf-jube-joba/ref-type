\import algebra.Group[].Of[Carrier := C.Complex, group := Scalars.additiveGroup] \as Group;
\import \root.Linearization[].ComplexBounds[] \as Bounds;
\definition scalar[z: C.Complex]: C.Complex := C.Def[].add (C.Def[].ofReal a) (C.Def[].mul (C.Def[].ofReal b) z);
\definition positiveA: Real.Lt R.zero a := Real.leLtTrans R.zero b a nonnegative separated;
\definition absoluteA: C.Absolute[].abs (C.Def[].ofReal a) = a := trans!{{R.Real}} _ _ _ (uniform_approximation.Approximation[].ComplexScalars[].absoluteReal a)
  (R.Estimates[].Product[].absOfNonnegative a (Order.leOfLt _ _ positiveA));
\definition absoluteB: C.Absolute[].abs (C.Def[].ofReal b) = b := trans!{{R.Real}} _ _ _ (uniform_approximation.Approximation[].ComplexScalars[].absoluteReal b)
  (R.Estimates[].Product[].absOfNonnegative b nonnegative);
\definition nonzero: \forall (z: C.Complex) -> C.Absolute[].abs z = R.one -> C.Def[].NonZero (scalar z) :=
  \fun (z: C.Complex)(unit: _)(zero: _) => Order.ltNotEq b a separated (sym!{{R.Real}} _ _ (eq_reason_in!{{R.Real} a
    "=" {C.Absolute[].abs (C.Def[].ofReal a)} "by" {sym!{{R.Real}} _ _ absoluteA}
    "=" {C.Absolute[].abs (C.Def[].neg (C.Def[].mul (C.Def[].ofReal b) z))} "by" {
      congr!{{C.Complex} {R.Real}} C.Absolute[].abs _ _ (Group.inverseUnique (C.Def[].mul (C.Def[].ofReal b) z) (C.Def[].ofReal a) zero)}
    "=" {C.Absolute[].abs (C.Def[].mul (C.Def[].ofReal b) z)} "by" {Bounds.negativeAbsolute (C.Def[].mul (C.Def[].ofReal b) z)}
    "=" {R.mul (C.Absolute[].abs (C.Def[].ofReal b)) (C.Absolute[].abs z)} "by" {C.Absolute[].multiplicative (C.Def[].ofReal b) z}
    "=" {R.mul b R.one} "by" {congr!{{R.Real} {R.Real} {R.Real}} R.mul _ _ _ _ absoluteB unit}
    "=" b "by" {R.Algebra[].mulOneRight b}
  }));
