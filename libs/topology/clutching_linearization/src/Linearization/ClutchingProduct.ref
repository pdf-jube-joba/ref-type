\import bundle_homotopy.Homotopy[].Over[K := C.Complex, field := Scalars.field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar] \as Homotopy;
\import Homotopy.Projections[n := n].Operators[].Units[] \as Units;
\import Homotopy.Clutching[n := n, X := X, baseSpace := source, U := U, V := V, openU := openU, openV := openV, covers := covers] \as Clutching;
\definition Overlap: \Set := Clutching.Overlap;
\definition overlapTopology: topology.Topology[Carrier := Overlap].Topology := Clutching.overlapTopology;
\module With(a, b: Overlap -> Units.Carrier,
  continuousA: topology.Continuity[A := Overlap, B := Units.Carrier].Continuous overlapTopology Units.topology a,
  continuousB: topology.Continuity[A := Overlap, B := Units.Carrier].Continuous overlapTopology Units.topology b);
\module Class(g: Overlap -> Units.Carrier,
  continuous: topology.Continuity[A := Overlap, B := Units.Carrier].Continuous overlapTopology Units.topology g);
