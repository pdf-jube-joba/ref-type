\import std.Data[].FinSet[] \as Fin;
\import \root.Linearization[].Companion[n := n, d := N.Nat^::zero] \as Companion;
\import \root.Linearization[].Coordinates[n := n] \as Coordinates;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\import Spaces.Linear[V := Vectors.Vector, W := Vectors.Vector, source := Vectors.space, target := Vectors.space] \as End;
\import Spaces.Linear[V := Companion.Carrier, W := Vectors.Vector, source := Companion.space, target := Vectors.space] \as Row;
\import Spaces.Linear[V := Vectors.Vector, W := Companion.Carrier, source := Vectors.space, target := Companion.space] \as Column;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n] \as M;
\import spectral_splitting.Spectral[].At[n := n].Continuous[X := X, source := source, A := A, regular := regular, off := off] \as Native;
\import topological_algebra.Complex[] \as Plane;
\import Plane.Functions[A := X] \as Functions;
\import Spaces.Laws[V := Vectors.Vector, space := Vectors.space] \as Values;
\import algebra.Group[].Of[Carrier := Vectors.Vector, group := Rings.ringModuleAsCommutativeGroup C.Complex Vectors.Vector Spaces.ring Vectors.space] \as Group;
\definition evaluate: Row.Map := Row.Map {
  apply := \fun (v: Companion.Carrier) => v (Fin.zero N.Nat^::zero),
  preservesAdd := \fun (v, w: Companion.Carrier) => \refl(Vectors.plus (v (Fin.zero N.Nat^::zero)) (w (Fin.zero N.Nat^::zero))),
  preservesScale := \fun (s: C.Complex)(v: Companion.Carrier) => \refl(Vectors.scale s (v (Fin.zero N.Nat^::zero))),
};
\definition constant: Column.Map := Column.Map {
  apply := \fun (v: Vectors.Vector)(_ : Fin.Fin Companion.degree) => v,
  preservesAdd := \fun (v, w: Vectors.Vector) => \refl(\fun (_: Fin.Fin Companion.degree) => Vectors.plus v w),
  preservesScale := \fun (s: C.Complex)(v: Vectors.Vector) => \refl(\fun (_: Fin.Fin Companion.degree) => Vectors.scale s v),
};
\definition tupleLaw: \forall (v: Companion.Carrier) -> constant.apply (evaluate.apply v) = v := \fun (v: Companion.Carrier) =>
  \axiom:funext(constant.apply (evaluate.apply v), v, \fun (i: Fin.Fin Companion.degree) => congr!{{Fin.Fin Companion.degree} Vectors.Vector} v _ _ (sym!{{Fin.Fin Companion.degree}} _ _ (Fin.singletonValue i)));
\definition row[x: X]: Row.Map := Row.Operations[].negative (End.Composition[U := Companion.Carrier, domain := Companion.space].compose (M.linear (A x)) evaluate);
\definition rowRegular: \forall (v: Companion.Carrier)(j: Fin.Fin n) -> topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology (\fun (x: X) => (row x).apply v j) :=
  \fun (v: Companion.Carrier)(j: Fin.Fin n) => Functions.multiplicationContinuous source (\fun (_: X) => C.Def[].neg C.Def[].one) (\fun (x: X) => (M.linear (A x)).apply (evaluate.apply v) j)
    (topology.Maps[A := X, B := C.Complex].constantContinuous source Plane.topology (C.Def[].neg C.Def[].one)) (Native.regularT (evaluate.apply v) j);
\definition polynomialFormula: \forall (x: X)(z: C.Complex)(v: Vectors.Vector) -> (Companion.FromRow[row := row x].polynomial z).apply v = (spectral_splitting.Spectral[].At[n := n].Pencil[A := A x, z := z].value).apply v :=
  \fun (x: X)(z: C.Complex)(v: Vectors.Vector) => congr!{Vectors.Vector Vectors.Vector Vectors.Vector} Vectors.plus _ _ _ _
    (congr!{{C.Complex} Vectors.Vector} (\fun (s: C.Complex) => Vectors.scale s v) _ _ (C.Prop[].mulOneRight z))
    (congr!{Vectors.Vector Vectors.Vector} (\fun (w: Vectors.Vector) => Vectors.scale (C.Def[].neg C.Def[].one) ((M.linear (A x)).apply w)) _ _ (Vectors.space.scalarOne v));
\definition kernel: \forall (x: X)(z: C.Complex) -> C.Absolute[].abs z = R.one -> \forall (v: Vectors.Vector) -> (Companion.FromRow[row := row x].polynomial z).apply v = Vectors.origin -> v = Vectors.origin :=
  \fun (x: X)(z: C.Complex)(unit: _)(v: Vectors.Vector)(zero: _) => spectral_splitting.Spectral[].At[n := n].Eigenvalues[A := A x].noUnitEigen (off x) z unit v
    (spectral_splitting.Spectral[].At[n := n].Pencil[A := A x, z := z].kernelToEigen v (trans!{Vectors.Vector} _ _ _ (sym!{Vectors.Vector} _ _ (polynomialFormula x z v)) zero));
\module Index(compact: topology.Topology[Carrier := X].IsCompact source, hausdorff: topology.Topology[Carrier := X].IsT2 source);
