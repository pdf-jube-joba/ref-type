\import algebraic_topology.Cylinder[A := Y] \as Cylinder;
\import \root.Linearization[].MatrixPaths[n := n, Y := Cylinder.Carrier, source := Cylinder.topology source] \as LeftCylinder;
\import \root.Linearization[].MatrixPaths[n := m, Y := Cylinder.Carrier, source := Cylinder.topology source] \as RightCylinder;
\import \root.Linearization[].MatrixSum[n := n, m := m].Families[Y := Cylinder.Carrier, source := Cylinder.topology source] \as Along;
\definition left: LeftCylinder.Family := LeftCylinder.Family { matrix := first.homotopy, regular := first.regular, nonzero := first.nonzero };
\definition right: RightCylinder.Family := RightCylinder.Family { matrix := second.homotopy, regular := second.regular, nonzero := second.nonzero };
\definition path: TotalPaths.Path[sum a b, sum c d] := TotalPaths.Path[sum a b, sum c d] {
  homotopy := (Along.sum left right).matrix, regular := (Along.sum left right).regular, nonzero := (Along.sum left right).nonzero,
  atStart := \fun (y: Y) => congr!{ML.Matrix MR.Matrix MT.Matrix} matrix _ _ _ _ (first.atStart y) (second.atStart y),
  atEnd := \fun (y: Y) => congr!{ML.Matrix MR.Matrix MT.Matrix} matrix _ _ _ _ (first.atEnd y) (second.atEnd y),
};
