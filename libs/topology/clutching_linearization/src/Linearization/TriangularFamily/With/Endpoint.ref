\definition include[x: X]: Domain := Pair.pair Time.Carrier X t x;
\definition continuous: topology.Continuity[A := X, B := Domain].Continuous source topology include :=
  Cylinder.Universal[X := X].pairContinuous source Time.topology source (\fun (_: X) => t) (\fun (x: X) => x)
    (topology.Maps[A := X, B := Time.Carrier].constantContinuous source Time.topology t)
    (topology.Maps[A := X, B := X].Identity[].continuous source);
\definition matrix[x: X]: M.Matrix := homotopy (include x);
\definition regular: MatrixTopology.At[n := total].Families[X := X].Regular source matrix :=
  \fun (i, j: M.Index) => topology.Composition[A := X, B := Domain, C := C.Complex].composeContinuous source topology Plane.topology include
    (\fun (p: Domain) => homotopy p i j) continuous (\root.Linearization[].TriangularFamily[n := n, m := m, X := X, source := source].With[
      A := A, B := B, coupling := coupling, regularA := regularA, regularB := regularB, regularCoupling := regularCoupling, offA := offA, offB := offB].regular i j);
\definition gap: \forall (x: X) -> spectral_splitting.Spectral[].At[n := total].Splitting[A := matrix x].OffSpectrum := \fun (x: X) => off (include x);
