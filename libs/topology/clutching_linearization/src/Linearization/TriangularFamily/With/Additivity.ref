\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff] \as On;
\import On.SpectralIndex[n := n, A := A, regular := regularA, off := offA, removed := removedA] \as Left;
\import On.SpectralIndex[n := m, A := B, regular := regularB, off := offB, removed := removedB] \as Right;
\import Left.Sum[m := m, B := B, regularB := regularB, offB := offB, removedB := removedB].Difference[] \as Sum;
\import \parent.KClass[compact := compact, hausdorff := hausdorff, removed := N.Basic[].Def[].add removedB removedA] \as Comparison;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\definition value: K.K0[].Carrier := Comparison.triangularValue;
\definition additivity: K.K0[].add Left.value Right.value = value := trans!{K.K0[].Carrier} _ _ _ Sum.additivity Comparison.invariant;
