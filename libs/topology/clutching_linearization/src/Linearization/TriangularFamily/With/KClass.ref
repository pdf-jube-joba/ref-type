\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff] \as On;
\import On.SpectralHomotopy[n := total, A := homotopy, regular := regular, off := off, removed := removed] \as Motion;
\import On.SpectralIndex[n := total, A := Start.matrix, regular := Start.regular, off := Start.gap, removed := removed] \as First;
\import On.SpectralIndex[n := total, A := Finish.matrix, regular := Finish.regular, off := Finish.gap, removed := removed] \as Last;
\import On.SpectralIndex[n := total, A := diagonal, regular := diagonalRegular, off := diagonalOff, removed := removed] \as Diagonal;
\import On.SpectralIndex[n := total, A := matrix, regular := matrixRegular, off := matrixOff, removed := removed] \as Triangular;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\definition diagonalValue: K.K0[].Carrier := Diagonal.value;
\definition triangularValue: K.K0[].Carrier := Triangular.value;
\definition startEquality: First.value = diagonalValue := First.Equal[B := diagonal, regularB := diagonalRegular, offB := diagonalOff].invariant atStart;
\definition endEquality: Last.value = triangularValue := Last.Equal[B := matrix, regularB := matrixRegular, offB := matrixOff].invariant atEnd;
\definition invariant: diagonalValue = triangularValue := trans!{K.K0[].Carrier} _ _ _ (sym!{K.K0[].Carrier} _ _ startEquality)
  (trans!{K.K0[].Carrier} _ _ _ Motion.invariant endEquality);
