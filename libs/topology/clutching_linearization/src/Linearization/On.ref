\import uniform_approximation.Approximation[].Circle[].Coefficients[X := X, space := source, baseCompact := compact, baseHausdorff := hausdorff] \as Circle;
\import uniform_approximation.Approximation[].ComplexOn[X := X, space := source].FunctionRing[] \as CoefficientRing;
\import \root.Linearization[].LaurentNormal[K := CoefficientRing.Carrier, coefficients := CoefficientRing.commutativeRing] \as Normal;
\module Evaluation(point: Circle.Domain);
\module Matrices(n: N.Nat^,
  a: Circle.Domain -> matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n].Matrix,
  regular: matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := n].Families[X := Circle.Domain].Regular Circle.source a,
  nonzero: \forall (x: Circle.Domain) -> matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := n].Nonzero (a x));
\module SpectralIndex(n: N.Nat^, A: X -> matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n].Matrix,
  regular: matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := n].Families[X := X].Regular source A,
  off: \forall (x: X) -> spectral_splitting.Spectral[].At[n := n].Splitting[A := A x].OffSpectrum, removed: N.Nat^);
\module SpectralHomotopy(n: N.Nat^,
  A: std.Data[].Pair[].Times^[algebraic_topology.Interval[].Carrier, X] -> matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n].Matrix,
  regular: spectral_splitting.Spectral[].At[n := n].Characteristic[].Families[X := std.Data[].Pair[].Times^[algebraic_topology.Interval[].Carrier, X],
    source := topological_constructions.Product[A := algebraic_topology.Interval[].Carrier, B := X].topology algebraic_topology.Interval[].topology source].Regular A,
  off: \forall (p: std.Data[].Pair[].Times^[algebraic_topology.Interval[].Carrier, X]) -> spectral_splitting.Spectral[].At[n := n].Splitting[A := A p].OffSpectrum,
  removed: N.Nat^);
\module TrivialSum(n, m: N.Nat^);
\module CanonicalIndex(n: N.Nat^, P: X -> spectral_splitting.Spectral[].Idempotents[n := n].Projection,
  regular: hermitian_frames.Hermitian[].Over[K := C.Complex, field := Scalars.field, scalar := linear_algebra.Hermitian[].Complex[].scalar,
    topological := hermitian_frames.Hermitian[].Complex[].topological].At[n := n].Families[X := X].Matrix[m := n].Regular source (\fun (x: X) => (P x).map),
  c: C.Complex, outside: Real.Lt R.one (C.Absolute[].abs c), removed: N.Nat^);
