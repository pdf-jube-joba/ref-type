\definition along[y: Y]: Row d := q (f y);
\definition alongRegular: \forall (v: Coordinates.Carrier (N.Nat^::succ d))(j: Fin.Fin n) -> topology.Continuity[A := Y, B := C.Complex].Continuous target Plane.topology (\fun (y: Y) => (along y).apply v j) :=
  \fun (v: Coordinates.Carrier (N.Nat^::succ d))(j: Fin.Fin n) => topology.Composition[A := Y, B := X, C := C.Complex].composeContinuous target source Plane.topology f
    (\fun (x: X) => (q x).apply v j) regularF (regular v j);
\import \root.Linearization[].Companion[n := n, d := d].RowFamilies[X := Y, source := target, rows := along, regular := alongRegular].Evaluation[z := z, regularZ := regularZ] \as Evaluation;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n] \as Matrices;
\import matrix_invariants.Topological[K := C.Complex, ring := Plane.Ring[].topologicalRing].At[n := n].Families[X := Y] \as Top;
\import Spaces.FiniteCoordinates[n := n] \as Basis;
\definition raw[y: Y]: Matrices.Matrix := Matrices.Representation[].entries (evaluation d q (f y) (z y));
\definition monic[y: Y]: Matrices.Matrix := Matrices.Representation[].entries (polynomial d q (f y) (z y));
\definition rawRegular: Top.Regular target raw := \fun (i, j: Fin.Fin n) => Evaluation.rowRegular (Basis.vectors j) i;
\definition monicRegular: Top.Regular target monic := \fun (i, j: Fin.Fin n) => Evaluation.polynomialRegular (Basis.vectors j) i;
\definition rawAction: \forall (y: Y) -> Matrices.linear (raw y) = evaluation d q (f y) (z y) :=
  \fun (y: Y) => Matrices.Representation[].linearEntries (evaluation d q (f y) (z y));
\definition monicAction: \forall (y: Y) -> Matrices.linear (monic y) = polynomial d q (f y) (z y) :=
  \fun (y: Y) => Matrices.Representation[].linearEntries (polynomial d q (f y) (z y));
\definition rawNonzero:
  (\forall (y: Y)(v: Vectors.Vector) -> (evaluation d q (f y) (z y)).apply v = Vectors.origin -> v = Vectors.origin) ->
  \forall (y: Y) -> matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := n].Nonzero (raw y) :=
  \fun (kernel: _)(y: Y) => \root.Linearization[].ScalarMatrices[n := n].nonzeroOfZeroKernel (evaluation d q (f y) (z y)) (kernel y);
