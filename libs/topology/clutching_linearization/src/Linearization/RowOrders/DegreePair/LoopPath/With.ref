\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n] \as M;
\import matrix_invariants.Topological[K := C.Complex, ring := Plane.Ring[].topologicalRing].At[n := n] \as Top;
\definition H[p: OverCircle.Domain]: M.Matrix := path.homotopy (reindex p);
\definition regular: Top.Families[X := OverCircle.Domain].Regular OverCircle.source H := \fun (i, j: M.Index) =>
  topology.Composition[A := OverCircle.Domain, B := PathDomain.Carrier, C := C.Complex].composeContinuous OverCircle.source (PathDomain.topology Circle.source) Plane.topology reindex
    (\fun (p: PathDomain.Carrier) => path.homotopy p i j) reindexContinuous (path.regular i j);
\import Comparison.With[H := H, regularH := regular, nonzeroH := (\fun (p: OverCircle.Domain) => path.nonzero (reindex p)),
  atStart := (\fun (x: X)(z: Native.Carrier) => path.atStart (Product.pair X Native.Carrier x z)),
  atEnd := (\fun (x: X)(z: Native.Carrier) => path.atEnd (Product.pair X Native.Carrier x z))] \as Result;
\definition invariant: \forall (removed: N.Nat^) -> Orders.Index[compact := compact, hausdorff := hausdorff, removed := removed].value d0 q0 regular0 kernel0 =
  Orders.Index[compact := compact, hausdorff := hausdorff, removed := removed].value d1 q1 regular1 kernel1 := Result.invariant;
