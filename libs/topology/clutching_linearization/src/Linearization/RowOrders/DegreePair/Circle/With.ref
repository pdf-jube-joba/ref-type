\import Perturbation.With[small := small] \as Fixed;
\import Pair.Factors[delta := small.value, positive := small.positive, belowOne := small.below].Correction[h := h, regularH := regularH, weight := weight, regularWeight := regularWeight] \as Correct;
\import std.Data[].Pair[] \as Product;
\definition kernel: \forall (x: X)(z: C.Complex) -> C.Absolute[].abs z = R.one -> \forall (v: Vectors.Vector) -> (Correct.raw x z).apply v = Vectors.origin -> v = Vectors.origin :=
  \fun (x: X)(z: C.Complex)(unit: C.Absolute[].abs z = R.one) => Fixed.kernel
    (Product.pair X Native.Carrier x (\into[C.Complex](z, Native.Carrier) \by { Powers.normOfUnit z unit }));
\module Positive(time: X -> algebraic_topology.Interval[].Carrier, weightFormula: \forall (x: X) -> weight x = C.Def[].ofReal (time x)) {
  \import Correct.Positive[time := time, weightFormula := weightFormula] \as Normal;
  \definition normalized: Family order := Normal.normalized;
  \definition regular: Regular order normalized := Normal.normalizedRegular;
  \definition separated: Kernel order normalized := Normal.normalizedKernel kernel;
}
