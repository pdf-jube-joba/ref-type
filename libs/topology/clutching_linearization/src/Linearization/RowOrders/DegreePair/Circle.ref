\import uniform_approximation.Approximation[].Circle[].Coefficients[X := X, space := source, baseCompact := compact, baseHausdorff := hausdorff] \as Circle;
\import sphere_maps.Circle[] \as Native;
\import topological_constructions.Product[A := X, B := Native.Carrier] \as Product;
\import \root.Linearization[].Powers[] \as Powers;
\import \root.Linearization[].RowOrders[n := n, X := X, source := source].DegreePair[d0 := d0, d1 := d1, padding := padding, q0 := q0, q1 := q1, regular0 := regular0, regular1 := regular1] \as Pair;
\import Pair.Perturbation[Y := Circle.Domain, target := Circle.source, compact := Circle.domainCompact, f := Circle.first,
  regularF := Product.Maps[].firstContinuous source Native.topology, z := Circle.unit, regularZ := Circle.unitContinuous,
  h := h, regularH := regularH, weight := weight, regularWeight := regularWeight,
  kernel := (\fun (p: Circle.Domain) => kernel (Circle.first p) (Circle.unit p) (Powers.unitOfNorm (Circle.unit p) (Circle.unitNorm p)))] \as Perturbation;
\definition Small: \Set := Perturbation.Small;
\definition exists: \exists Small := Perturbation.exists;
\module With(small: Small);
