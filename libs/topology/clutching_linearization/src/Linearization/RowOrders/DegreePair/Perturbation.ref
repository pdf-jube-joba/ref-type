\import \root.Linearization[].RowOrders[n := n, X := X, source := source] \as Orders;
\import Orders.DegreePair[d0 := d0, d1 := d1, padding := padding, q0 := q0, q1 := q1, regular0 := regular0, regular1 := regular1] \as Pair;
\import Orders.Evaluation[d := order, q := h, regular := regularH, Y := Y, target := target, f := f, regularF := regularF, z := z, regularZ := regularZ] \as Original;
\import Orders.Evaluation[d := d0, q := q0, regular := regular0, Y := Y, target := target, f := f, regularF := regularF, z := z, regularZ := regularZ] \as First;
\import Orders.Evaluation[d := d1, q := q1, regular := regular1, Y := Y, target := target, f := f, regularF := regularF, z := z, regularZ := regularZ] \as Last;
\definition alongWeight[y: Y]: C.Complex := weight (f y);
\definition alongWeightRegular: topology.Continuity[A := Y, B := C.Complex].Continuous target Plane.topology alongWeight :=
  topology.Composition[A := Y, B := X, C := C.Complex].composeContinuous target source Plane.topology f weight regularF regularWeight;
\import \root.Linearization[].MatrixNeighborhoods[n := n].Factors[X := Y, source := target, compact := compact,
  original := Original.raw, left := First.monic, right := Last.monic, regularOriginal := Original.rawRegular, regularLeft := First.monicRegular, regularRight := Last.monicRegular,
  nonzero := Original.rawNonzero kernel, z := z, weight := alongWeight, regularZ := regularZ, regularWeight := alongWeightRegular, leftPower := leftExtra, rightPower := rightExtra] \as Uniform;
\definition Small: \Set := Uniform.Small;
\definition exists: \exists Small := Uniform.exists;
\module With(small: Small);
