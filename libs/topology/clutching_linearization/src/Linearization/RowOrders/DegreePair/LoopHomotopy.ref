\import \parent.Homotopy[compact := compact, hausdorff := hausdorff, kernel0 := kernel0, kernel1 := kernel1] \as Cylinder;
\import algebraic_topology.Interval[] \as Time;
\import std.Data[].Pair[] \as Product;
\import sphere_maps.Circle[] \as Native;
\import uniform_approximation.Approximation[].Circle[].Coefficients[X := Cylinder.Domain, space := Cylinder.topology, baseCompact := Cylinder.domainCompact, baseHausdorff := Cylinder.domainHausdorff] \as Circle;
\import \root.Linearization[].On[X := Cylinder.Domain, source := Cylinder.topology, compact := Cylinder.domainCompact, hausdorff := Cylinder.domainHausdorff] \as Global;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n] \as M;
\import matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := n] \as Field;
\import matrix_invariants.Topological[K := C.Complex, ring := Plane.Ring[].topologicalRing].At[n := n] \as Top;
\definition point[t: Time.Carrier][x: X][z: Native.Carrier]: Circle.Domain := Product.pair Cylinder.Domain Native.Carrier (Cylinder.include t x) z;
\module With(H: Circle.Domain -> M.Matrix, regularH: Top.Families[X := Circle.Domain].Regular Circle.source H,
  nonzeroH: \forall (p: Circle.Domain) -> Field.Nonzero (H p),
  atStart: \forall (x: X)(z: Native.Carrier) -> H (point Time.start x z) = M.Representation[].entries (polynomial d0 q0 x z),
  atEnd: \forall (x: X)(z: Native.Carrier) -> H (point Time.end x z) = M.Representation[].entries (polynomial d1 q1 x z));
