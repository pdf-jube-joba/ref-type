\import Path.Endpoint[t := Time.end] \as Endpoint;
\import DomainK.Pullback[Y := X, space := source, sourceCompact := compact, sourceHausdorff := hausdorff, f := include Time.end, regular := inclusionContinuous Time.end] \as Pull;
\import DomainIndex.At[d := order, q := Factors.rightMonic, regular := Factors.rightMonicRegular, kernel := Factors.rightKernel lastKernel].Pullback[
  Y := X, target := source, compactY := compact, hausdorffY := hausdorff, f := include Time.end, continuous := inclusionContinuous Time.end] \as Factored;
\import DomainIndex.At[d := d1, q := last, regular := lastRegular, kernel := lastKernel].Pullback[
  Y := X, target := source, compactY := compact, hausdorffY := hausdorff, f := include Time.end, continuous := inclusionContinuous Time.end] \as Original;
\import BaseIndex.At[d := order, q := Endpoint.endpointRows, regular := Endpoint.endpointRegular, kernel := (\fun (x: X) => Separated.separated (include Time.end x))].Equal[
  other := Factored.pulled, regularOther := Factored.pulledRegular, kernelOther := Factored.pulledKernel,
  same := (\fun (x: X) => Normal.Endpoints[].atRight (include Time.end x) (\refl(Time.end)) (atEnd x))] \as Compare;
\definition comparison: Motion.endValue = BaseIndex.value d1 q1 regular1 kernel1 := trans!{BaseK.K0[].Carrier} _ _ _ Compare.invariant
  (trans!{BaseK.K0[].Carrier} _ _ _ (sym!{BaseK.K0[].Carrier} _ _ Factored.naturality)
    (trans!{BaseK.K0[].Carrier} _ _ _ (congr!{DomainK.K0[].Carrier BaseK.K0[].Carrier} Pull.K0[].map _ _ FactorIndex.rightInvariant) Original.naturality));
