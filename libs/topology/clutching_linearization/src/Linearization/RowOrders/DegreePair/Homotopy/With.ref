\import Pair.Circle[compact := domainCompact, hausdorff := domainHausdorff, h := h, regularH := regularH, weight := weight, regularWeight := weightContinuous, kernel := kernelH] \as Circle;
\definition Small: \Set := Circle.Small;
\definition exists: \exists Small := Circle.exists;
\module At(small: Small, removed: N.Nat^);
\import \root.Linearization[].RowOrders[n := n, X := X, source := source] \as Base;
\definition invariant: \forall (removed: N.Nat^) ->
  Base.Index[compact := compact, hausdorff := hausdorff, removed := removed].value d0 q0 regular0 kernel0 =
  Base.Index[compact := compact, hausdorff := hausdorff, removed := removed].value d1 q1 regular1 kernel1 := \block {
    \fun (removed: N.Nat^) \then
    \takefrom small: Small \by exists \then
    \return At[small := small, removed := removed].invariant
  };
