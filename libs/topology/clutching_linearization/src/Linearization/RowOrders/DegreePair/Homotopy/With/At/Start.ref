\import Path.Endpoint[t := Time.start] \as Endpoint;
\import DomainK.Pullback[Y := X, space := source, sourceCompact := compact, sourceHausdorff := hausdorff, f := include Time.start, regular := inclusionContinuous Time.start] \as Pull;
\import DomainIndex.At[d := order, q := Factors.leftMonic, regular := Factors.leftMonicRegular, kernel := Factors.leftKernel firstKernel].Pullback[
  Y := X, target := source, compactY := compact, hausdorffY := hausdorff, f := include Time.start, continuous := inclusionContinuous Time.start] \as Factored;
\import DomainIndex.At[d := d0, q := first, regular := firstRegular, kernel := firstKernel].Pullback[
  Y := X, target := source, compactY := compact, hausdorffY := hausdorff, f := include Time.start, continuous := inclusionContinuous Time.start] \as Original;
\import BaseIndex.At[d := order, q := Endpoint.endpointRows, regular := Endpoint.endpointRegular, kernel := (\fun (x: X) => Separated.separated (include Time.start x))].Equal[
  other := Factored.pulled, regularOther := Factored.pulledRegular, kernelOther := Factored.pulledKernel,
  same := (\fun (x: X) => Normal.Endpoints[].atLeft (include Time.start x) (\refl(Time.start)) (atStart x))] \as Compare;
\definition comparison: Motion.startValue = BaseIndex.value d0 q0 regular0 kernel0 := trans!{BaseK.K0[].Carrier} _ _ _ Compare.invariant
  (trans!{BaseK.K0[].Carrier} _ _ _ (sym!{BaseK.K0[].Carrier} _ _ Factored.naturality)
    (trans!{BaseK.K0[].Carrier} _ _ _ (congr!{DomainK.K0[].Carrier BaseK.K0[].Carrier} Pull.K0[].map _ _ FactorIndex.leftInvariant) Original.naturality));
