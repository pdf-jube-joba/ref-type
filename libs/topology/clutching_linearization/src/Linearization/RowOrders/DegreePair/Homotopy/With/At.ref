\import Pair.Factors[delta := small.value, positive := small.positive, belowOne := small.below] \as Factors;
\import Factors.Correction[h := h, regularH := regularH, weight := weight, regularWeight := weightContinuous].Positive[time := time, weightFormula := (\fun (p: Domain) => \refl(weight p))] \as Normal;
\import Circle.With[small := small].Positive[time := time, weightFormula := (\fun (p: Domain) => \refl(weight p))] \as Separated;
\import \root.Linearization[].Companion[n := n, d := order].RowHomotopy[X := X, source := source].With[rows := Separated.normalized, regular := Separated.regular, kernel := Separated.separated] \as Path;
\import Path.KClass[compact := compact, hausdorff := hausdorff, removed := removed] \as Motion;
\import Over.Index[compact := domainCompact, hausdorff := domainHausdorff, removed := removed] \as DomainIndex;
\import \root.Linearization[].RowOrders[n := n, X := X, source := source].Index[compact := compact, hausdorff := hausdorff, removed := removed] \as BaseIndex;
\import Factors.Index[compact := domainCompact, hausdorff := domainHausdorff, removed := removed, kernel0 := firstKernel, kernel1 := lastKernel] \as FactorIndex;
\import topological_k_theory.KTheory[].On[X := Domain, baseSpace := topology, compact := domainCompact, hausdorff := domainHausdorff] \as DomainK;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as BaseK;
\module Start;
\module Finish;
\definition invariant: BaseIndex.value d0 q0 regular0 kernel0 = BaseIndex.value d1 q1 regular1 kernel1 := trans!{BaseK.K0[].Carrier} _ _ _
  (sym!{BaseK.K0[].Carrier} _ _ Start[].comparison) (trans!{BaseK.K0[].Carrier} _ _ _ Motion.invariant Finish[].comparison);
