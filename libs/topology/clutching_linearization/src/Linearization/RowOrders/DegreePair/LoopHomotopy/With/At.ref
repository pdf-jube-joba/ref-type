\import Approx.With[chosen := chosen] \as Refined;
\import Refined.Model[] \as Model;
\definition shift: N.Nat^ := chosen.form.shift;
\definition rank: N.Nat^ := Nat.add (Nat.mul n shift) removed;
\import \root.Linearization[].Companion[n := n, d := chosen.form.order].RowHomotopy[X := X, source := source].With[rows := Model.rows, regular := Model.regular, kernel := Model.kernel] \as Path;
\import Path.KClass[compact := compact, hausdorff := hausdorff, removed := rank] \as Motion;
\import \root.Linearization[].RowOrders[n := n, X := X, source := source] \as Base;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\module Endpoint(t: Time.Carrier, d: N.Nat^, q: Base.Family d, regularQ: Base.Regular d q, kernelQ: Base.Kernel d q,
  endpoint: \forall (x: X)(z: Native.Carrier) -> H (point t x z) = M.Representation[].entries (Base.polynomial d q x z));

\import Endpoint[t := Time.start, d := d0, q := q0, regularQ := regular0, kernelQ := kernel0, endpoint := atStart] \as Start;
\import Endpoint[t := Time.end, d := d1, q := q1, regularQ := regular1, kernelQ := kernel1, endpoint := atEnd] \as Finish;
\definition invariant: Base.Index[compact := compact, hausdorff := hausdorff, removed := removed].value d0 q0 regular0 kernel0 =
  Base.Index[compact := compact, hausdorff := hausdorff, removed := removed].value d1 q1 regular1 kernel1 :=
  trans!{K.K0[].Carrier} _ _ _ Start.comparison
    (trans!{K.K0[].Carrier} _ _ _ Motion.invariant (sym!{K.K0[].Carrier} _ _ Finish.comparison));
