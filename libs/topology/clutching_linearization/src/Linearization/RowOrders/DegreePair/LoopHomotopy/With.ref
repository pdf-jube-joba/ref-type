\import Global.Matrices[n := n, a := H, regular := regularH, nonzero := nonzeroH].Refined[] \as Approx;
\module At(chosen: Approx.Parameters, removed: N.Nat^);

\import \root.Linearization[].RowOrders[n := n, X := X, source := source] \as Base;
\definition invariant: \forall (removed: N.Nat^) -> Base.Index[compact := compact, hausdorff := hausdorff, removed := removed].value d0 q0 regular0 kernel0 =
  Base.Index[compact := compact, hausdorff := hausdorff, removed := removed].value d1 q1 regular1 kernel1 :=
  \fun (removed: N.Nat^) => \block {
    \takefrom chosen: Approx.Parameters \by Approx.parametersExist \then
    \return At[chosen := chosen, removed := removed].invariant
  };
