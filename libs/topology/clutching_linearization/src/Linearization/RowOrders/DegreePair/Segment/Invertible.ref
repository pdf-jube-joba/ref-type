\definition separated: \forall (p: Path.Domain)(z: C.Complex) -> C.Absolute[].abs z = R.one -> \forall (v: Vectors.Vector) -> (Over.evaluation order h p z).apply v = Vectors.origin -> v = Vectors.origin :=
  \fun (p: Path.Domain)(z: C.Complex)(unit: C.Absolute[].abs z = R.one)(v: Vectors.Vector)(zero: _) => kernel (Path.time p) (Path.base p) z unit v
    (trans!{Vectors.Vector} _ _ _ (sym!{Vectors.Vector} _ _ (restoration p z v))
      (trans!{Vectors.Vector} _ _ _ (congr!{Vectors.Vector Vectors.Vector} (Vectors.scale (Blend.scalar (Path.time p))) _ _ zero) (Values.scaleZero (Blend.scalar (Path.time p)))));
\import Path.With[h := h, regularH := regular, kernelH := separated, atStart := atStart, atEnd := atEnd] \as Comparison;
\import \root.Linearization[].RowOrders[n := n, X := X, source := source] \as Base;
\definition invariant: \forall (removed: N.Nat^) ->
  Base.Index[compact := compact, hausdorff := hausdorff, removed := removed].value d0 q0 regular0 kernel0 =
  Base.Index[compact := compact, hausdorff := hausdorff, removed := removed].value d1 q1 regular1 kernel1 := Comparison.invariant;
