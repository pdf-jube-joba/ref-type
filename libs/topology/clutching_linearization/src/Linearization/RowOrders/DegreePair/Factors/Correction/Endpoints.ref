\import algebra.Group[].Of[Carrier := C.Complex, group := Scalars.additiveGroup] \as ScalarGroup;
\definition complementZero: C.Def[].sub C.Def[].one C.Def[].zero = C.Def[].one := trans!{{C.Complex}} _ _ _
  (congr!{{C.Complex} {C.Complex}} (C.Def[].add C.Def[].one) _ _ ScalarGroup.negZero)
  (C.Prop[].addZeroRight C.Def[].one);
\definition atLeft: \forall (x: X) -> weight x = C.Def[].zero -> h x = left x -> corrected x = leftRows x :=
  \fun (x: X)(zero: weight x = C.Def[].zero)(same: h x = left x) => Rows.ext (corrected x) (leftRows x)
    (\axiom:funext((corrected x).apply, (leftRows x).apply, \fun (v: Common.Carrier) => trans!{Vectors.Vector} _ _ _ (rowFormula x v)
      (trans!{Vectors.Vector} _ _ _
        (congr!{Vectors.Vector {C.Complex} Vectors.Vector} (\fun (p: Vectors.Vector)(w: C.Complex) => Algebra.lower p ((leftRows x).apply v) ((rightRows x).apply v) ((left x).apply v) ((right x).apply v) (C.Def[].sub C.Def[].one w) w) _ _ _ _
          (congr!{{Row order} Vectors.Vector} (\fun (q: Row order) => q.apply v) _ _ same) zero)
        (trans!{Vectors.Vector} _ _ _
          (congr!{{C.Complex} Vectors.Vector} (\fun (u: C.Complex) => Algebra.lower ((left x).apply v) ((leftRows x).apply v) ((rightRows x).apply v) ((left x).apply v) ((right x).apply v) u C.Def[].zero) _ _ complementZero)
          (Algebra.atLeft ((leftRows x).apply v) ((rightRows x).apply v) ((left x).apply v) ((right x).apply v))))));
\definition atRight: \forall (x: X) -> weight x = C.Def[].one -> h x = right x -> corrected x = rightRows x :=
  \fun (x: X)(one: weight x = C.Def[].one)(same: h x = right x) => Rows.ext (corrected x) (rightRows x)
    (\axiom:funext((corrected x).apply, (rightRows x).apply, \fun (v: Common.Carrier) => trans!{Vectors.Vector} _ _ _ (rowFormula x v)
      (trans!{Vectors.Vector} _ _ _
        (congr!{Vectors.Vector {C.Complex} Vectors.Vector} (\fun (p: Vectors.Vector)(w: C.Complex) => Algebra.lower p ((leftRows x).apply v) ((rightRows x).apply v) ((left x).apply v) ((right x).apply v) (C.Def[].sub C.Def[].one w) w) _ _ _ _
          (congr!{{Row order} Vectors.Vector} (\fun (q: Row order) => q.apply v) _ _ same) one)
        (trans!{Vectors.Vector} _ _ _
          (congr!{{C.Complex} Vectors.Vector} (\fun (u: C.Complex) => Algebra.lower ((right x).apply v) ((leftRows x).apply v) ((rightRows x).apply v) ((left x).apply v) ((right x).apply v) u C.Def[].one) _ _ (C.Prop[].subSelf C.Def[].one))
          (Algebra.atRight ((leftRows x).apply v) ((rightRows x).apply v) ((left x).apply v) ((right x).apply v))))));
