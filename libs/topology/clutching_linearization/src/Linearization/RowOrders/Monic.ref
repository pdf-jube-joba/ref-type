\import \root.Linearization[].RowOrders[n := n, X := X, source := source] \as Orders;
\import Orders.DegreePair[d0 := d, d1 := d, padding := N.Nat^::zero, q0 := q, q1 := q, regular0 := regular, regular1 := regular].LoopPath[
  compact := compact, hausdorff := hausdorff, kernel0 := kernel, kernel1 := kernel] \as Loop;
\import uniform_approximation.Approximation[].Circle[].Coefficients[X := X, space := source, baseCompact := compact, baseHausdorff := hausdorff] \as Circle;
\import \root.Linearization[].MatrixPaths[n := n, Y := Circle.Domain, source := Circle.source] \as Paths;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n] \as M;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n, a := Loop.first.matrix, regular := Loop.first.regular, nonzero := Loop.first.nonzero] \as Matrices;
\import Matrices.Representative[d := d, q := q, regularQ := regular, kernelQ := kernel, k := N.Nat^::zero] \as Representative;
\definition path: Paths.Path[Representative.shifted, Representative.polynomial] := Paths.retarget Loop.first Loop.first Representative.shifted Representative.polynomial (Paths.constant Loop.first)
  (\fun (p: Circle.Domain) => M.Operations[].ext (Loop.first.matrix p) (Representative.shifted.matrix p) (\fun (i, j: M.Index) => sym!{{C.Complex}} _ _ (C.Prop[].mulOneLeft (Loop.first.matrix p i j))))
  (\fun (p: Circle.Domain) => \refl(Loop.first.matrix p));
\import Representative.With[path := path] \as Recovery;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\definition matrix: Circle.Domain -> M.Matrix := Loop.first.matrix;
\definition inverse: K.K0[].Carrier := Matrices.Inverse[].value;
\definition index: K.K0[].Carrier := Orders.Index[compact := compact, hausdorff := hausdorff, removed := N.Nat^::zero].value d q regular kernel;
\definition recovery: inverse = index := Recovery.recovery;
\definition family: Paths.Family := Loop.first;
