\import \root.Linearization[].RowOrders[n := n, X := Y, source := target] \as Target;
\definition pulled[y: Y]: Row d := q (f y);
\definition pulledRegular: Target.Regular d pulled := \fun (v: Coordinates.Carrier (N.Nat^::succ d))(j: Fin.Fin n) =>
  topology.Composition[A := Y, B := X, C := C.Complex].composeContinuous target source Plane.topology f (\fun (x: X) => (q x).apply v j) continuous (regular v j);
\definition pulledKernel: Target.Kernel d pulled := \fun (y: Y) => kernel (f y);
\import Target.Index[compact := compactY, hausdorff := hausdorffY, removed := removed] \as TargetIndex;
\import K.Pullback[Y := Y, space := target, sourceCompact := compactY, sourceHausdorff := hausdorffY, f := f, regular := continuous] \as Pull;
\import Spectral.Pullback[Y := Y, space := target, compactY := compactY, hausdorffY := hausdorffY, f := f, continuous := continuous] \as Natural;
\definition naturality: Pull.K0[].map value = TargetIndex.value d pulled pulledRegular pulledKernel := Natural.naturality;
