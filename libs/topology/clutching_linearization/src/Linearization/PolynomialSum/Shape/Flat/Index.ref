\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff] \as On;
\import On.SpectralIndex[n := leftRank, A := LeftFamily.matrix, regular := LeftFamily.matrixRegular, off := LeftSeparated.off, removed := removed0].Sum[
  m := rightRank, B := RightFamily.matrix, regularB := RightFamily.matrixRegular, offB := RightSeparated.off, removedB := removed1] \as Added;
\import hermitian_frames.Hermitian[].Over[K := C.Complex, field := Scalars.field, scalar := linear_algebra.Hermitian[].Complex[].scalar,
  topological := hermitian_frames.Hermitian[].Complex[].topological] \as Hermitian;
\import On.SpectralIndex[n := sourceRank, A := TotalFamily.matrix, regular := TotalFamily.matrixRegular, off := TotalSeparated.off, removed := N.Basic[].Def[].add removed1 removed0].Similarity[
  m := targetRank, B := Added.matrix, regularB := Added.matrixRegular, offB := Added.totalOff].With[iso := (\fun (_: X) => frame),
  regularForward := Hermitian.At[n := targetRank].Families[X := X].Matrix[m := sourceRank].constant source frame.forward,
  regularBackward := Hermitian.At[n := sourceRank].Families[X := X].Matrix[m := targetRank].constant source frame.backward, intertwines := intertwines] \as Similarity;
\import \root.Linearization[].RowOrders[n := n, X := X, source := source].Index[compact := compact, hausdorff := hausdorff, removed := removed0] \as LeftIndex;
\import \root.Linearization[].RowOrders[n := m, X := X, source := source].Index[compact := compact, hausdorff := hausdorff, removed := removed1] \as RightIndex;
\import Orders.Index[compact := compact, hausdorff := hausdorff, removed := N.Basic[].Def[].add removed1 removed0] \as TotalIndex;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\definition additivity: K.K0[].add (LeftIndex.value d q0 regular0 kernel0) (RightIndex.value d q1 regular1 kernel1) = TotalIndex.value d rows regular kernel :=
  trans!{K.K0[].Carrier} _ _ _ Added.Difference[].additivity (sym!{K.K0[].Carrier} _ _ Similarity.invariant);
