\definition realValue: R.Real := R.add R.one R.one;
\definition value: C.Complex := C.Def[].ofReal realValue;
\definition oneLess: Real.Lt R.one realValue :=
  Real.ltReplaceLeft _ _ _ (Laws.addZeroLeft R.one)
    (Laws.ltAddRight R.zero R.one R.one R.Estimates[].Product[].onePositive);
\definition nonnegative: Real.Le R.zero realValue := Real.leTrans _ _ _ Laws.oneNonnegative (Order.leOfLt _ _ oneLess);
\definition magnitude: C.Absolute[].abs value = realValue :=
  trans!{{R.Real}} _ _ _ (uniform_approximation.Approximation[].ComplexScalars[].absoluteReal realValue)
    (R.Estimates[].Product[].absOfNonnegative realValue nonnegative);
\definition outside: Real.Lt R.one (C.Absolute[].abs value) := Real.ltReplaceRight _ _ _ (sym!{{R.Real}} _ _ magnitude) oneLess;
