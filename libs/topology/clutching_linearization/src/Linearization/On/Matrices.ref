\import \root.Linearization[].MatrixNeighborhoods[n := n] \as Neighborhoods;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n] \as M;
\import matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := n] \as Top;
\import matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := n] \as Field;
\import uniform_approximation.Approximation[].ComplexOn[X := Circle.Domain, space := Circle.source] \as Functions;
\import Neighborhoods.Perturbation[X := Circle.Domain, source := Circle.source, compact := Circle.domainCompact, a := a, regular := regular, nonzero := nonzero] \as Margin;
\import algebraic_topology.Interval[] \as Time;
\import std.Data[].Pair[] \as Pair;
\import topological_constructions.Product[A := Time.Carrier, B := Circle.Domain] \as Cylinder;
\definition cylinderTopology: topology.Topology[Carrier := Cylinder.CarrierSet].Topology := Cylinder.topology Time.topology Circle.source;
\definition PolynomialMatrix: \Set := M.Index -> M.Index -> Circle.Polynomial;
\definition value[p: PolynomialMatrix][x: Circle.Domain]: M.Matrix := \fun (i, j: M.Index) => Circle.value (p i j) x;
\definition valueRegular: \forall (p: PolynomialMatrix) -> Top.Families[X := Circle.Domain].Regular Circle.source (value p) :=
  \fun (p: PolynomialMatrix)(i, j: M.Index) => Circle.valueContinuous (p i j);
\structure Approximation: \Set := {
  coefficients: PolynomialMatrix,
  homotopy: Cylinder.CarrierSet -> M.Matrix,
  continuous: Top.Families[X := Cylinder.CarrierSet].Regular cylinderTopology homotopy,
  invertible: \forall (p: Cylinder.CarrierSet) -> Field.Nonzero (homotopy p),
  atStart: \forall (x: Circle.Domain) -> homotopy (Pair.pair Time.Carrier Circle.Domain Time.start x) = a x,
  atEnd: \forall (x: Circle.Domain) -> homotopy (Pair.pair Time.Carrier Circle.Domain Time.end x) = value coefficients x,
};
\module Candidate(bound: Margin.Bound, coefficients: PolynomialMatrix,
  near: \forall (x: Circle.Domain)(i, j: M.Index) -> Real.Lt (C.Absolute[].abs (C.Def[].sub (a x i j) (value coefficients x i j))) bound.value);
\definition exists: \exists Approximation := \block {
  \takefrom bound: Margin.Bound \by Margin.boundExists \then
  \takefrom p: \Cast[PolynomialMatrix] ({ p: PolynomialMatrix \where \forall (i, j: M.Index) -> Functions.Error (\fun (x: Circle.Domain) => a x i j) (Circle.value (p i j)) bound.value })
    \by Circle.Matrices[n := n, m := n, f := (\fun (i, j: M.Index)(x: Circle.Domain) => a x i j), regular := regular].exists bound.value bound.positive \then
  \let near: \forall (i, j: M.Index) -> Functions.Error (\fun (x: Circle.Domain) => a x i j) (Circle.value (p i j)) bound.value :=
    \bysub(PolynomialMatrix, { p: PolynomialMatrix \where \forall (i, j: M.Index) -> Functions.Error (\fun (x: Circle.Domain) => a x i j) (Circle.value (p i j)) bound.value }, p) \then
  \return \exact(Candidate[bound := bound, coefficients := p, near := (\fun (x: Circle.Domain)(i, j: M.Index) => near i j x)].result, Approximation)
};
\module Result(data: Approximation);
\module Normalized(data: Approximation);
\structure Parameters: \Set := {
  approximation: Approximation,
  normal: Normal.Matrices[n := n, m := n, p := approximation.coefficients].PolynomialMatrix,
  radius: Normalized[data := approximation].With[form := normal].Shifted[].Radius,
};
\definition parametersExist: \exists Parameters := \block {
  \takefrom approximation: Approximation \by exists \then
  \takefrom normal: Normal.Matrices[n := n, m := n, p := approximation.coefficients].PolynomialMatrix \by Normalized[data := approximation].normalizationExists \then
  \takefrom radius: Normalized[data := approximation].With[form := normal].Shifted[].Radius \by Normalized[data := approximation].With[form := normal].Shifted[].radiusExists \then
  \return \exact(Parameters { approximation := approximation, normal := normal, radius := radius }, Parameters)
};
\module Construction(parameters: Parameters);
\module Clutched;
\module ApproximationComparison(first, second: Approximation);
\module Refined;
\module ChoiceComparison(first, second: Parameters);
\module Inverse;
\module Representative(d: N.Nat^,
  q: \root.Linearization[].RowOrders[n := n, X := X, source := source].Family d,
  regularQ: \root.Linearization[].RowOrders[n := n, X := X, source := source].Regular d q,
  kernelQ: \root.Linearization[].RowOrders[n := n, X := X, source := source].Kernel d q, k: N.Nat^);
