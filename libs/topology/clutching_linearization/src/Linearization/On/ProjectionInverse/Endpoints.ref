\definition weightStart: \forall (p: Circle.Domain) -> weight (Cylinder.at Time.start p) = C.Def[].one :=
  \fun (p: Circle.Domain) => trans!{{C.Complex}} _ _ _
    (congr!{{C.Complex} {C.Complex} {C.Complex}} C.Def[].add _ _ _ _
      (congr!{{R.Real} {C.Complex}} C.Def[].ofReal _ _ (Laws.addZeroRight R.one)) (C.Prop[].mulZeroLeft (Circle.unit p))) (C.Prop[].addZeroRight C.Def[].one);
\definition weightEnd: \forall (p: Circle.Domain) -> weight (Cylinder.at Time.end p) = C.Def[].add Two.value (Circle.unit p) :=
  \fun (p: Circle.Domain) => congr!{{C.Complex} {C.Complex}} (C.Def[].add Two.value) _ _ (C.Prop[].mulOneLeft (Circle.unit p));
\definition standardFormula: \forall (p: Circle.Domain) -> family.matrix p = M.Representation[].entries (\root.Linearization[].ProjectionLoop[n := n, projection := P (Circle.first p)].loop (Circle.unit p)) :=
  \fun (p: Circle.Domain) => M.Operations[].ext (family.matrix p) (M.Representation[].entries (\root.Linearization[].ProjectionLoop[n := n, projection := P (Circle.first p)].loop (Circle.unit p)))
    (\fun (i, j: M.Index) => congr!{Vectors.Vector {C.Complex}} (\fun (v: Vectors.Vector) => v i) _ _
      (congr!{Vectors.Vector Vectors.Vector} (Vectors.plus (Vectors.scale (Circle.unit p) ((P (Circle.first p)).map.apply (Basis.vectors j)))) _ _
        (trans!{Vectors.Vector} _ _ _ (congr!{{C.Complex} Vectors.Vector} (\fun (s: C.Complex) => Vectors.scale s ((Split.Q (Circle.first p)).map.apply (Basis.vectors j))) _ _ (weightStart p))
          (Vectors.space.scalarOne ((Split.Q (Circle.first p)).map.apply (Basis.vectors j))))));
\definition negativeAction: \forall (x: X)(v: Vectors.Vector) -> Vectors.scale (C.Def[].neg C.Def[].one) ((M.linear (Canonical.matrix x)).apply v) = Vectors.scale Two.value ((Split.Q x).map.apply v) :=
  \fun (x: X)(v: Vectors.Vector) => trans!{Vectors.Vector} _ _ _
    (congr!{Vectors.Vector Vectors.Vector} (Vectors.scale (C.Def[].neg C.Def[].one)) _ _ (\root.Linearization[].CanonicalProjection[n := n, projection := P x, c := c, outside := outside].action v))
    (trans!{Vectors.Vector} _ _ _ (sym!{Vectors.Vector} _ _ (Vectors.space.scalarAssoc (C.Def[].neg C.Def[].one) c ((Split.Q x).map.apply v)))
      (congr!{{C.Complex} Vectors.Vector} (\fun (s: C.Complex) => Vectors.scale s ((Split.Q x).map.apply v)) _ _
        (trans!{{C.Complex}} _ _ _ (ScalarLaws.minusOneScale c) (C.Prop[].negNeg Two.value))));
\definition endValue: \forall (p: Circle.Domain)(v: Vectors.Vector) -> (operator (Cylinder.at Time.end p)).apply v = Vectors.plus (Vectors.scale (Circle.unit p) v) (Vectors.scale Two.value ((Split.Q (Circle.first p)).map.apply v)) :=
  \fun (p: Circle.Domain)(v: Vectors.Vector) => eq_reason_in!{Vectors.Vector {(operator (Cylinder.at Time.end p)).apply v}
    "=" {Vectors.plus (Vectors.scale (Circle.unit p) ((P (Circle.first p)).map.apply v)) (Vectors.scale (C.Def[].add Two.value (Circle.unit p)) ((Split.Q (Circle.first p)).map.apply v))} "by" {
      congr!{Vectors.Vector Vectors.Vector} (Vectors.plus (Vectors.scale (Circle.unit p) ((P (Circle.first p)).map.apply v))) _ _
        (congr!{{C.Complex} Vectors.Vector} (\fun (s: C.Complex) => Vectors.scale s ((Split.Q (Circle.first p)).map.apply v)) _ _ (weightEnd p))}
    "=" {Vectors.plus (Vectors.scale (Circle.unit p) ((P (Circle.first p)).map.apply v)) (Vectors.plus (Vectors.scale (Circle.unit p) ((Split.Q (Circle.first p)).map.apply v)) (Vectors.scale Two.value ((Split.Q (Circle.first p)).map.apply v)))} "by" {
      congr!{Vectors.Vector Vectors.Vector} (Vectors.plus (Vectors.scale (Circle.unit p) ((P (Circle.first p)).map.apply v))) _ _
        (trans!{Vectors.Vector} _ _ _ (Vectors.space.scalarAdd Two.value (Circle.unit p) ((Split.Q (Circle.first p)).map.apply v))
          (Values.comm (Vectors.scale Two.value ((Split.Q (Circle.first p)).map.apply v)) (Vectors.scale (Circle.unit p) ((Split.Q (Circle.first p)).map.apply v))))}
    "=" {Vectors.plus (Vectors.plus (Vectors.scale (Circle.unit p) ((P (Circle.first p)).map.apply v)) (Vectors.scale (Circle.unit p) ((Split.Q (Circle.first p)).map.apply v))) (Vectors.scale Two.value ((Split.Q (Circle.first p)).map.apply v))} "by" {
      sym!{Vectors.Vector} _ _ (Values.assoc (Vectors.scale (Circle.unit p) ((P (Circle.first p)).map.apply v)) (Vectors.scale (Circle.unit p) ((Split.Q (Circle.first p)).map.apply v)) (Vectors.scale Two.value ((Split.Q (Circle.first p)).map.apply v)))}
    "=" {Vectors.plus (Vectors.scale (Circle.unit p) v) (Vectors.scale Two.value ((Split.Q (Circle.first p)).map.apply v))} "by" {
      congr!{Vectors.Vector Vectors.Vector} (\fun (u: Vectors.Vector) => Vectors.plus u (Vectors.scale Two.value ((Split.Q (Circle.first p)).map.apply v))) _ _
        (trans!{Vectors.Vector} _ _ _ (sym!{Vectors.Vector} _ _ (Vectors.space.vectorAdd (Circle.unit p) ((P (Circle.first p)).map.apply v) ((Split.Q (Circle.first p)).map.apply v)))
          (congr!{Vectors.Vector Vectors.Vector} (Vectors.scale (Circle.unit p)) _ _ (spectral_splitting.Spectral[].At[n := n].Idempotent[P := (P (Circle.first p)).map, idempotent := (P (Circle.first p)).idempotent].splitting v)))}
  };
\definition endEquality: \forall (p: Circle.Domain) -> matrix (Cylinder.at Time.end p) = Index.family.matrix p :=
  \fun (p: Circle.Domain) => M.Operations[].ext (matrix (Cylinder.at Time.end p)) (Index.family.matrix p) (\fun (i, j: M.Index) => congr!{Vectors.Vector {C.Complex}} (\fun (v: Vectors.Vector) => v i) _ _
    (trans!{Vectors.Vector} _ _ _ (endValue p (Basis.vectors j))
      (sym!{Vectors.Vector} _ _ (trans!{Vectors.Vector} _ _ _ (Linear.polynomialFormula (Circle.first p) (Circle.unit p) (Basis.vectors j))
        (congr!{Vectors.Vector Vectors.Vector} (Vectors.plus (Vectors.scale (Circle.unit p) (Basis.vectors j))) _ _ (negativeAction (Circle.first p) (Basis.vectors j)))))));
\definition path: Paths.Path[family, Index.family] := Paths.Path[family, Index.family] {
  homotopy := matrix, regular := matrixRegular, nonzero := nonzero,
  atStart := \fun (p: Circle.Domain) => \refl(family.matrix p), atEnd := endEquality,
};
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n, a := family.matrix, regular := family.regular, nonzero := family.nonzero] \as Original;
\import Original.Inverse[].Homotopy[b := Index.family.matrix, regularB := Index.family.regular, nonzeroB := Index.family.nonzero].With[path := path] \as Invariance;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\import K.Bundle[F := Image.Fiber, original := Image.bundle, same := \refl(source)] \as ImageClass;
\definition recovery: Original.Inverse[].value = K.K0[].difference ImageClass.value K.Trivial[n := N.Nat^::zero].value :=
  trans!{K.K0[].Carrier} _ _ _ Invariance.invariant (trans!{K.K0[].Carrier} _ _ _ Index.recovery Canonical.recovery);
