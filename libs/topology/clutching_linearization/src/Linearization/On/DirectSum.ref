\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff] \as On;
\import \root.Linearization[].MatrixSum[n := n, m := m] \as Blocks;
\import Blocks.Families[Y := Circle.Domain, source := Circle.source] \as Families;
\definition total: N.Nat^ := Blocks.total;
\definition sum := Families.sum a b;
\import On.Matrices[n := n, a := a.matrix, regular := a.regular, nonzero := a.nonzero] \as Left;
\import On.Matrices[n := m, a := b.matrix, regular := b.regular, nonzero := b.nonzero] \as Right;
\import On.Matrices[n := total, a := sum.matrix, regular := sum.regular, nonzero := sum.nonzero] \as Total;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\module At(first: Left.Parameters, second: Right.Parameters);
\definition additivity: Total.Inverse[].value = K.K0[].add Left.Inverse[].value Right.Inverse[].value := \block {
  \takefrom first: Left.Parameters \by Left.parametersExist \then
  \takefrom second: Right.Parameters \by Right.parametersExist \then
  \return At[first := first, second := second].recovery
};
