\import \root.Linearization[].RowOrders[n := n, X := X, source := source] \as Orders;
\import \root.Linearization[].Companion[n := n, d := chosen.form.order].Families[X := X, source := source, coefficients := Monic.coefficients, regular := Monic.regularAction] \as Family;
\import \root.Linearization[].ScalarMatrices[n := n] \as Scaling;
\import Spaces.Coordinates[I := M.Index] \as Vectors;
\import Spaces.Linear[V := Vectors.Vector, W := Vectors.Vector, source := Vectors.space, target := Vectors.space] \as End;
\definition rows: Orders.Family chosen.form.order := Family.rows;
\definition regular: Orders.Regular chosen.form.order rows := Family.rowsRegular;
\definition kernel: Orders.Kernel chosen.form.order rows := Monic.kernel;
\definition polynomial: Circle.Domain -> M.Matrix := Monic.polynomial;
\definition polynomialRegular: Top.Families[X := Circle.Domain].Regular Circle.source polynomial := Monic.polynomialRegular;
\definition action: \forall (p: Circle.Domain) -> M.linear (polynomial p) = Orders.polynomial chosen.form.order rows (Circle.first p) (Circle.unit p) :=
  \fun (p: Circle.Domain) => Monic.At[point := p].action;
\definition epsilon: R.Real := Leading.epsilon;
\definition positive: Real.Lt R.zero epsilon := Leading.positive;
\definition restoration: \forall (p: Circle.Domain) -> Scaling.scale (C.Def[].ofReal epsilon) (polynomial p) = Leading.perturbed p :=
  \fun (p: Circle.Domain) => M.Operations[].ext (Scaling.scale (C.Def[].ofReal epsilon) (polynomial p)) (Leading.perturbed p) (\fun (i, j: M.Index) => trans!{{C.Complex}} _ _ _
    (sym!{{C.Complex}} _ _ (C.Prop[].mulAssoc Monic.scalar Monic.reciprocal (Leading.perturbed p i j)))
    (trans!{{C.Complex}} _ _ _ (congr!{{C.Complex} {C.Complex}} (\fun (s: C.Complex) => C.Def[].mul s (Leading.perturbed p i j)) _ _ (C.Prop[].inverseNonzeroRight Monic.scalar Monic.scalarNonzero)) (C.Prop[].mulOneLeft (Leading.perturbed p i j))));
\definition indexFormula: Orders.Index[compact := compact, hausdorff := hausdorff, removed := N.Basic[].Def[].mul n chosen.form.shift].value chosen.form.order rows regular kernel = Monic.inverseClass := \refl(Monic.inverseClass);
