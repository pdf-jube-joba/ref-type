\import \parent.Result[data := first].Clutching[] \as First;
\import \parent.Result[data := second].Clutching[] \as Second;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Operations;
\definition Base: \Set := First.Base;
\definition FirstFiber: Base -> \Set := First.ApproximateFiber;
\definition SecondFiber: Base -> \Set := Second.ApproximateFiber;
\definition firstBundle: Bundles.Family[X := Base, F := FirstFiber].Bundle := First.approximateBundle;
\definition secondBundle: Bundles.Family[X := Base, F := SecondFiber].Bundle := Second.approximateBundle;
\import Bundles.Isomorphisms[X := Base, F := First.OriginalFiber, G := FirstFiber, source := First.originalBundle, target := firstBundle] \as Reverse;
\import Bundles.Isomorphisms[X := Base, F := Second.OriginalFiber, G := SecondFiber, source := Second.originalBundle, target := secondBundle] \as Forward;
\import Operations.IsomorphismComposition[X := Base, F := FirstFiber, G := First.OriginalFiber, H := SecondFiber,
  source := firstBundle, middle := First.originalBundle, target := secondBundle] \as Compose;
\definition Isomorphism: \Set := Compose.Isomorphism;
\definition isomorphismExists: \exists Isomorphism := \block {
  \takefrom firstMap: Reverse.Isomorphism \by First.isomorphismExists \then
  \takefrom secondMap: Forward.Isomorphism \by Second.isomorphismExists \then
  \return \exact(Compose.compose (Reverse.inverse firstMap) secondMap, Isomorphism)
};
