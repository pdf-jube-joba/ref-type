\import \root.Linearization[].MatrixSum[n := n, m := n] \as Sum;
\definition action: \forall (u, v: Units.Carrier)(w: Flat.Vector) ->
  (Block.value u v).apply w = (Sum.block (M.linear (Units.matrix u)) (M.linear (Units.matrix v))).apply w :=
  \fun (u, v: Units.Carrier)(w: Flat.Vector) =>
    congr!{PairSpace.Carrier Flat.Vector} Coordinates.join _ _
      (Pair.Prop[A := Vectors.Vector, B := Vectors.Vector].pairCong _ _ _ _
        (sym!{Vectors.Vector} _ _ (congr!{End.Map Vectors.Vector} (\fun (h: End.Map) => h.apply (PairSpace.first (Coordinates.split w))) _ _ (M.Representation[].linearEntries u)))
        (sym!{Vectors.Vector} _ _ (congr!{End.Map Vectors.Vector} (\fun (h: End.Map) => h.apply (PairSpace.second (Coordinates.split w))) _ _ (M.Representation[].linearEntries v))));
\definition equality: \forall (u, v: Units.Carrier) -> BigM.Representation[].entries (Block.value u v) = Sum.matrix (Units.matrix u) (Units.matrix v) :=
  \fun (u, v: Units.Carrier) => BigM.Operations[].ext _ _ (\fun (i, j: BigM.Index) =>
    congr!{Flat.Vector {C.Complex}} (\fun (w: Flat.Vector) => w i) _ _ (action u v (Spaces.FiniteCoordinates[n := total].vectors j)));
