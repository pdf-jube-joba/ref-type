\import Margin.Nearby[b := value coefficients, regularB := valueRegular coefficients, bound := bound, near := near] \as Path;
\definition result: Approximation := Approximation {
  coefficients := coefficients,
  homotopy := Path.homotopy,
  continuous := Path.homotopyRegular,
  invertible := Path.nonzero,
  atStart := Path.atStart,
  atEnd := Path.atEnd,
};
