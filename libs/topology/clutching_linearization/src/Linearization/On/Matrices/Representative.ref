\import \root.Linearization[].RowOrders[n := n, X := X, source := source] \as Orders;
\import \root.Linearization[].MatrixPaths[n := n, Y := Circle.Domain, source := Circle.source] \as Paths;
\import \root.Linearization[].Powers[] \as Powers;
\import Powers.Families[X := Circle.Domain, source := Circle.source, z := Circle.unit, regular := Circle.unitContinuous] \as CirclePowers;
\import \root.Linearization[].ScalarMatrices[n := n] \as Scaling;
\import sphere_maps.Circle[] \as NativeCircle;
\import topological_constructions.Product[A := X, B := NativeCircle.Carrier] \as CircleProduct;
\import Orders.Evaluation[d := d, q := q, regular := regularQ, Y := Circle.Domain, target := Circle.source, f := Circle.first,
  regularF := CircleProduct.Maps[].firstContinuous source NativeCircle.topology, z := Circle.unit, regularZ := Circle.unitContinuous] \as Evaluation;
\definition original: Paths.Family := Paths.Family { matrix := a, regular := regular, nonzero := nonzero };
\definition scalar[p: Circle.Domain]: C.Complex := Powers.value (Circle.unit p) k;
\definition scalarNonzero: \forall (p: Circle.Domain) -> C.Def[].NonZero (scalar p) := \fun (p: Circle.Domain) => Powers.nonzero (Circle.unit p) (Powers.unitOfNorm (Circle.unit p) (Circle.unitNorm p)) k;
\import Paths.Scale[s := scalar, regular := CirclePowers.continuous k, nonzero := scalarNonzero] \as Scale;
\definition shifted: Paths.Family := Scale.family original;
\definition polynomial: Paths.Family := Paths.Family { matrix := Evaluation.monic, regular := Evaluation.monicRegular,
  nonzero := \fun (p: Circle.Domain) => Scaling.nonzeroOfZeroKernel (Orders.polynomial d q (Circle.first p) (Circle.unit p))
    (kernelQ (Circle.first p) (Circle.unit p) (Powers.unitOfNorm (Circle.unit p) (Circle.unitNorm p))) };
\module With(path: Paths.Path[shifted, polynomial]);
