\definition endpointNonzero: \forall (p: Circle.Domain) -> Field.Nonzero (value data.coefficients p) :=
  \fun (p: Circle.Domain)(zero: _) => data.invertible (Pair.pair Time.Carrier Circle.Domain Time.end p)
    (trans!{{C.Complex}} _ _ _ (congr!{M.Matrix {C.Complex}} M.determinant _ _ (data.atEnd p)) zero);
\import \parent.\parent.Clutched[] \as Original;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n,
  a := value data.coefficients, regular := valueRegular data.coefficients, nonzero := endpointNonzero].Clutched[] \as Approximate;
\import Original.Comparison[b := value data.coefficients, regularB := valueRegular data.coefficients, nonzeroB := endpointNonzero] \as Compare;
\definition path: Compare.Path := Compare.Path {
  homotopy := data.homotopy, regular := data.continuous, nonzero := data.invertible,
  atStart := data.atStart, atEnd := data.atEnd,
};
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition Base: \Set := Original.Carrier;
\definition OriginalFiber: Base -> \Set := Original.Fiber;
\definition originalBundle: Bundles.Family[X := Base, F := OriginalFiber].Bundle := Original.bundle;
\definition ApproximateFiber: Base -> \Set := Approximate.Fiber;
\definition approximateBundle: Bundles.Family[X := Base, F := ApproximateFiber].Bundle := Approximate.bundle;
\definition isomorphismExists: \exists Bundles.Isomorphisms[X := Base, F := OriginalFiber, G := ApproximateFiber,
  source := originalBundle, target := approximateBundle].Isomorphism := Compare.Along[path := path].isomorphismExists;
