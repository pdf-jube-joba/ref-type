\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n, a := a, regular := regular, nonzero := nonzero] \as Original;
\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as NatLaws;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\module At(parameters: Parameters);
\definition recovery: Original.Inverse[].value = Orders.Index[compact := compact, hausdorff := hausdorff, removed := Nat.mul n k].value d q regularQ kernelQ := \block {
  \takefrom parameters: Parameters \by parametersExist \then
  \return trans!{K.K0[].Carrier} _ _ _ (Original.Inverse[].comparison parameters) (At[parameters := parameters].recovery)
};
