\import \root.Linearization[].MatrixPaths[n := n, Y := Circle.Domain, source := Circle.source] \as Paths;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n, a := b, regular := regularB, nonzero := nonzeroB] \as Target;
\definition first: Paths.Family := Paths.Family { matrix := a, regular := regular, nonzero := nonzero };
\definition second: Paths.Family := Paths.Family { matrix := b, regular := regularB, nonzero := nonzeroB };
\module With(path: Paths.Path[first, second]);
