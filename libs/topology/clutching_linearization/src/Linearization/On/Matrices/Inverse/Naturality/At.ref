\import Original.Construction[parameters := parameters].Path[] \as Path;
\import Path.Model[] \as Model;
\import \root.Linearization[].RowOrders[n := n, X := X, source := source].Index[compact := compact, hausdorff := hausdorff, removed := N.Basic[].Def[].mul n parameters.normal.shift].At[
  d := parameters.normal.order, q := Model.rows, regular := Model.regular, kernel := Model.kernel].Pullback[
  Y := Y, target := space, compactY := compactY, hausdorffY := hausdorffY, f := f, continuous := continuous] \as Rows;
\import Target.Representative[d := parameters.normal.order, q := Rows.pulled, regularQ := Rows.pulledRegular, kernelQ := Rows.pulledKernel, k := parameters.normal.shift] \as Representative;
\import \root.Linearization[].MatrixPaths[n := n, Y := Circle.Domain, source := Circle.source].Reindex[Z := TargetCircle.Domain, target := TargetCircle.source, f := circleMap, continuous := circleContinuous] \as Reindex;
\import \root.Linearization[].MatrixPaths[n := n, Y := TargetCircle.Domain, source := TargetCircle.source] \as Paths;
\import Spaces.Coordinates[I := M.Index] \as Vectors;
\import Spaces.Linear[V := Vectors.Vector, W := Vectors.Vector, source := Vectors.space, target := Vectors.space] \as End;
\definition endpoint: \forall (p: TargetCircle.Domain) -> (Reindex.family Path.polynomial).matrix p = Representative.polynomial.matrix p :=
  \fun (p: TargetCircle.Domain) => trans!{M.Matrix} _ _ _ (sym!{M.Matrix} _ _ (M.Representation[].entriesLinear (Model.polynomial (circleMap p))))
    (congr!{End.Map M.Matrix} M.Representation[].entries _ _ (Model.action (circleMap p)));
\definition path: Paths.Path[Representative.shifted, Representative.polynomial] := Paths.retarget (Reindex.family Path.shifted) (Reindex.family Path.polynomial) Representative.shifted Representative.polynomial
  (Reindex.path Path.shifted Path.polynomial Path.path) (\fun (p: TargetCircle.Domain) => \refl(Representative.shifted.matrix p)) endpoint;
\import Representative.With[path := path] \as Recovery;
\definition naturality: Pull.K0[].map (Original.Construction[parameters := parameters].inverseClass) = Target.Inverse[].value :=
  trans!{TargetK.K0[].Carrier} _ _ _ Rows.naturality (sym!{TargetK.K0[].Carrier} _ _ Recovery.recovery);
