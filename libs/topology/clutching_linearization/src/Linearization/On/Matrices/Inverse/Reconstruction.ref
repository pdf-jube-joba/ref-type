\import Original.Construction[parameters := parameters].Reconstruction[] \as Given;
\import Original.Clutched[] \as Clutched;
\import topological_k_theory.KTheory[].On[X := Clutched.Carrier, baseSpace := Clutched.topology, compact := Clutched.productCompact, hausdorff := Clutched.productHausdorff] \as ProductK;
\import algebraic_topology.Euclidean[].Dimension[n := N.Nat^::succ (N.Nat^::succ (N.Nat^::succ N.Nat^::zero))] \as Sphere;
\import topological_constructions.Product[A := X, B := Sphere.Sphere] \as Product;
\import K.Pullback[Y := Clutched.Carrier, space := Clutched.topology, sourceCompact := Clutched.productCompact, sourceHausdorff := Clutched.productHausdorff,
  f := Clutched.first, regular := Product.Maps[].firstContinuous source Sphere.sphereTopology] \as Pull;
\definition reconstruction: Given.reducedClutchingClass = ProductK.K0[].mul Given.lineDifference (Pull.K0[].map value) :=
  trans!{ProductK.K0[].Carrier} _ _ _ Given.reconstruction
    (congr!{K.K0[].Carrier ProductK.K0[].Carrier} (\fun (v: K.K0[].Carrier) => ProductK.K0[].mul Given.lineDifference (Pull.K0[].map v)) _ _
      (sym!{K.K0[].Carrier} _ _ (comparison parameters)));
