\definition inverse[p: Cylinder.CarrierSet]: M.Matrix := Field.formula (data.homotopy p);
\definition inverseRegular: Top.Families[X := Cylinder.CarrierSet].Regular cylinderTopology inverse :=
  matrix_invariants.Complex[].At[n := n].Families[X := Cylinder.CarrierSet].inverseRegular cylinderTopology data.homotopy data.continuous data.invertible;
\definition inverseAt[p: Cylinder.CarrierSet]: M.Operations[].Inverse (data.homotopy p) :=
  Field.inverse (\into[M.Matrix](data.homotopy p, Field.Nonsingular) \by { data.invertible p });
\definition left: \forall (p: Cylinder.CarrierSet) -> M.product (inverse p) (data.homotopy p) = M.identity :=
  \fun (p: Cylinder.CarrierSet) => (M.Operations[].inverseLaws (data.homotopy p) (inverseAt p)).left;
\definition right: \forall (p: Cylinder.CarrierSet) -> M.product (data.homotopy p) (inverse p) = M.identity :=
  \fun (p: Cylinder.CarrierSet) => (M.Operations[].inverseLaws (data.homotopy p) (inverseAt p)).right;
\module Clutching;
