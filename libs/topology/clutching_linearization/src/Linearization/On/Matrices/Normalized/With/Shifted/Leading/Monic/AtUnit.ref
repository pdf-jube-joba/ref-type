\import sphere_maps.Circle[] \as Native;
\definition circle: Native.Carrier := \into[C.Complex](z, Native.unit) \by { Powers.normOfUnit z unit };
\definition point: Circle.Domain := Pair.pair X Native.Carrier x circle;
\import Companion.With[coefficients := coefficients x] \as Cyclic;
\import \parent.At[point := point] \as Comparison;
\definition zero: \forall (v: Vectors.Vector) -> (Cyclic.polynomial z).apply v = Vectors.origin -> v = Vectors.origin :=
  \fun (v: Vectors.Vector)(zero: _) => Scaling.zeroKernel (polynomial point) (nonzero point) v
    (trans!{Vectors.Vector} _ _ _ (congr!{End.Map Vectors.Vector} (\fun (f: End.Map) => f.apply v) _ _ Comparison.action) zero);
