\import \root.Linearization[].Coordinates[n := n] \as Coordinates;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n,
  a := polynomial, regular := polynomialRegular, nonzero := nonzero].Clutched[] \as Original;
\import Original.Stabilize[m := Coordinates.dimension form.order] \as Stable;
\import Companion.Families[X := X, source := source, coefficients := coefficients, regular := regularAction].Linearization[] \as Linearized;
\import Linearized.Gauges[] \as Gauges;
\import Gauges.Separated[kernel := kernel] \as Diagonal;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := Coordinates.dimension degree] \as Big;
\module At(q: Circle.Domain);
\definition equation: \forall (q: Circle.Domain)(v: Big.Vector) -> (Big.linear (Diagonal.diagonal q)).apply v = (Stable.block q).apply v :=
  \fun (q: Circle.Domain) => At[q := q].equation;
\import Stable.Comparing[b := Diagonal.diagonal, regularB := Diagonal.diagonalContinuous, nonzeroB := Diagonal.nonzeroDiagonal, equation := equation] \as Compare;
\import \parent.Clutching[] \as Normal;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition Base: \Set := Original.Carrier;
\definition SumFiber: Base -> \Set := Stable.SumFiber;
\definition sumBundle: Bundles.Family[X := Base, F := SumFiber].Bundle := Stable.sumBundle;
\definition NormalFiber: Base -> \Set := Normal.NormalFiber;
\definition normalBundle: Bundles.Family[X := Base, F := NormalFiber].Bundle := Normal.normalBundle;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].IsomorphismComposition[
    X := Base, F := SumFiber, G := Normal.DiagonalFiber, H := NormalFiber, source := sumBundle, middle := Normal.diagonalBundle, target := normalBundle] \as Compose;
\definition isomorphismExists: \exists Compose.Isomorphism := Compose.exists Compare.isomorphismExists Normal.spectralComparisonExists;
