\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Evaluation[point := point] \as Evaluation;
\import algebra.Polynomial[].Over[R := CoefficientRing.Carrier, coefficients := CoefficientRing.commutativeRing] \as P;
\import Fin.FromList[A := CoefficientRing.Carrier] \as FromList;
\definition equation: \forall (i, j: M.Index) -> C.Def[].mul (power point form.shift) (Circle.value (data.coefficients i j) point) =
  sum point degree (\fun (k: Fin.Fin degree) => C.Def[].mul (power point k) (coefficient k (Circle.first point) i j)) :=
  \fun (i, j: M.Index) => trans!{{C.Complex}} _ _ _
    (Evaluation.shifted form.shift (data.coefficients i j) (P.Finite[].asPolynomial (FromList.list degree (form.coefficients i j))) (form.equation i j))
    (Evaluation.arrayFormula degree (form.coefficients i j));
