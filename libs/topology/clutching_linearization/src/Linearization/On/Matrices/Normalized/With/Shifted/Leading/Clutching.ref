\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n,
  a := value, regular := regular, nonzero := nonzero].Clutched[] \as Shifted;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n,
  a := perturbed, regular := perturbedRegular, nonzero := perturbedNonzero].Clutched[] \as Perturbed;
\import Shifted.Comparison[b := perturbed, regularB := perturbedRegular, nonzeroB := perturbedNonzero] \as Compare;
\import \parent.Homotopy[] \as Motion;
\import \parent.Monic[] \as Normal;
\definition path: Compare.Path := Compare.Path {
  homotopy := Motion.homotopy, regular := Motion.continuous, nonzero := Motion.nonzero,
  atStart := Motion.atStart, atEnd := Motion.atEnd,
};
\import Perturbed.Scaling[s := Normal.reciprocal, nonzeroScalar := Normal.reciprocalNonzero] \as Scale;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition Base: \Set := Shifted.Carrier;
\definition ShiftedFiber: Base -> \Set := Shifted.Fiber;
\definition shiftedBundle: Bundles.Family[X := Base, F := ShiftedFiber].Bundle := Shifted.bundle;
\definition MonicFiber: Base -> \Set := Scale.ScaledFiber;
\definition monicBundle: Bundles.Family[X := Base, F := MonicFiber].Bundle := Scale.scaledBundle;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].IsomorphismComposition[
    X := Base, F := ShiftedFiber, G := Perturbed.Fiber, H := MonicFiber, source := shiftedBundle, middle := Perturbed.bundle, target := monicBundle] \as Compose;
\definition isomorphismExists: \exists Compose.Isomorphism :=
  Compose.exists (Compare.Along[path := path].isomorphismExists)
    (\exact(Scale.isomorphism, Bundles.Isomorphisms[X := Base, F := Perturbed.Fiber, G := MonicFiber, source := Perturbed.bundle, target := monicBundle].Isomorphism));
