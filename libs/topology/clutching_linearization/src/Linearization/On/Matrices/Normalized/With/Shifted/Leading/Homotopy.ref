\import Margin.Nearby[b := perturbed, regularB := perturbedRegular, bound := bound, near := near] \as Path;
\definition homotopy: Cylinder.CarrierSet -> M.Matrix := Path.homotopy;

\definition continuous: Top.Families[X := Cylinder.CarrierSet].Regular cylinderTopology homotopy := Path.homotopyRegular;
\definition nonzero: \forall (p: Cylinder.CarrierSet) -> Field.Nonzero (homotopy p) := Path.nonzero;
\definition atStart: \forall (point: Circle.Domain) -> homotopy (Pair.pair Time.Carrier Circle.Domain Time.start point) = value point := Path.atStart;
\definition atEnd: \forall (point: Circle.Domain) -> homotopy (Pair.pair Time.Carrier Circle.Domain Time.end point) = perturbed point := Path.atEnd;
