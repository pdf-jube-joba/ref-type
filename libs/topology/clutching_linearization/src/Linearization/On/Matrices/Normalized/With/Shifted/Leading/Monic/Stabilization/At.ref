\import Companion.With[coefficients := coefficients (Circle.first q)] \as Cyclic;
\import Spaces.CoordinateSum[n := n, m := Coordinates.dimension form.order] \as Sum;
\import Coordinates.Successor[d := form.order] \as Successor;
\import Spaces.Coordinates[I := Big.Index] \as Flat;
\import \parent.\parent.At[point := q] \as Polynomial;
\definition equation: \forall (v: Big.Vector) -> (Big.linear (Diagonal.diagonal q)).apply v = (Stable.block q).apply v :=
  \fun (v: Big.Vector) => trans!{Big.Vector} _ _ _ (Gauges.diagonalAction (Diagonal.include q) v)
    (trans!{Big.Vector} _ _ _ (Successor.blockFormula (Cyclic.polynomial (Circle.unit q)).apply v)
      (congr!{Vectors.Vector Big.Vector} (\fun (w: Vectors.Vector) => Sum.join w (Sum.right v)) _ _
        (sym!{Vectors.Vector} _ _ (congr!{End.Map Vectors.Vector} (\fun (f: End.Map) => f.apply (Sum.left v)) _ _ Polynomial.action))));
