\import std.Data[].FinSet[] \as Fin;
\definition degree: N.Nat^ := N.Nat^::succ form.order;
\definition coefficient[k: Fin.Fin degree][x: X]: M.Matrix := \fun (i, j: M.Index) => form.coefficients i j k x;
\definition regular: \forall (k: Fin.Fin degree) -> matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := n].Families[X := X].Regular source (coefficient k) :=
  \fun (k: Fin.Fin degree)(i, j: M.Index) => CoefficientRing.regular (form.coefficients i j k);
\definition power[point: Circle.Domain][k: N.Nat^]: C.Complex := \root.Linearization[].Powers[].value (Circle.unit point) k;
\definition sum[point: Circle.Domain]: \forall (m: N.Nat^) -> (Fin.Fin m -> C.Complex) -> C.Complex :=
  \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Evaluation[point := point].sum;
\module At(point: Circle.Domain);
\definition shifted: \forall (point: Circle.Domain)(i, j: M.Index) -> C.Def[].mul (power point form.shift) (Circle.value (data.coefficients i j) point) =
  sum point degree (\fun (k: Fin.Fin degree) => C.Def[].mul (power point k) (coefficient k (Circle.first point) i j)) :=
  \fun (point: Circle.Domain)(i, j: M.Index) => At[point := point].equation i j;
\module Shifted;
