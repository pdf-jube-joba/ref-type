\import Companion.Families[X := X, source := source, coefficients := coefficients, regular := regularAction].Linearization[].Gauges[].Separated[kernel := kernel].Bundles[compact := compact, hausdorff := hausdorff] \as Linearized;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition Base: \Set := Linearized.Base;
\definition PencilFiber: Base -> \Set := Linearized.PencilFiber;
\definition pencilBundle: Bundles.Family[X := Base, F := PencilFiber].Bundle := Linearized.pencilBundle;
\definition DiagonalFiber: Base -> \Set := Linearized.DiagonalFiber;
\definition diagonalBundle: Bundles.Family[X := Base, F := DiagonalFiber].Bundle := Linearized.diagonalBundle;
\definition comparison: Bundles.Isomorphisms[X := Base, F := PencilFiber, G := DiagonalFiber, source := pencilBundle, target := diagonalBundle].Isomorphism := Linearized.isomorphism;
\import Linearized.Deformation[] \as Deformation;
\definition NormalFiber: Base -> \Set := Deformation.NormalFiber;
\definition normalBundle: Bundles.Family[X := Base, F := NormalFiber].Bundle := Deformation.normalBundle;
\import Bundles.Isomorphisms[X := Base, F := PencilFiber, G := DiagonalFiber, source := pencilBundle, target := diagonalBundle] \as Reverse;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].IsomorphismComposition[
  X := Base, F := DiagonalFiber, G := PencilFiber, H := NormalFiber,
  source := diagonalBundle, middle := pencilBundle, target := normalBundle] \as Compose;
\definition spectralComparisonExists: \exists Bundles.Isomorphisms[X := Base, F := DiagonalFiber, G := NormalFiber,
  source := diagonalBundle, target := normalBundle].Isomorphism :=
  Compose.exists (\exact(Reverse.inverse comparison, Bundles.Isomorphisms[X := Base, F := DiagonalFiber, G := PencilFiber,
    source := diagonalBundle, target := pencilBundle].Isomorphism)) Deformation.isomorphismExists;
