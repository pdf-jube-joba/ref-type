\import \parent.Clutching[] \as Normalize;
\import \parent.Monic[].Stabilization[] \as Normal;
\import \root.Linearization[].Coordinates[n := n] \as Coordinates;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Operations;
\definition Base: \Set := Normalize.Base;
\definition baseSpace: topology.Topology[Carrier := Base].Topology := Normalize.shiftedBundle.baseSpace;
\definition ExtraFiber[x: Base]: \Set := Bundles.Vector (Coordinates.dimension form.order);
\import Bundles.Trivial[X := Base, n := Coordinates.dimension form.order, baseSpace := baseSpace] \as Extra;
\import Operations.DirectSumIsomorphisms[X := Base, F := Normalize.ShiftedFiber, G := ExtraFiber, A := Normalize.MonicFiber, B := ExtraFiber,
  first := Normalize.shiftedBundle, second := Extra.bundle, newFirst := Normalize.monicBundle, newSecond := Extra.bundle,
  sameSource := \refl(baseSpace), sameTarget := \refl(baseSpace)] \as Added;
\import Operations.IdentityIsomorphism[X := Base, F := ExtraFiber, bundle := Extra.bundle] \as Identity;
\definition SumFiber: Base -> \Set := Added.SourceFiber;
\definition sumBundle: Bundles.Family[X := Base, F := SumFiber].Bundle := Added.sourceBundle;
\definition NormalFiber: Base -> \Set := Normal.NormalFiber;
\definition normalBundle: Bundles.Family[X := Base, F := NormalFiber].Bundle := Normal.normalBundle;
\import Operations.IsomorphismComposition[X := Base, F := SumFiber, G := Normal.SumFiber, H := NormalFiber,
  source := sumBundle, middle := Normal.sumBundle, target := normalBundle] \as Compose;
\definition isomorphismExists: \exists Compose.Isomorphism :=
  Compose.exists (Added.exists Normalize.isomorphismExists
    (\exact(Identity.isomorphism, Bundles.Isomorphisms[X := Base, F := ExtraFiber, G := ExtraFiber, source := Extra.bundle, target := Extra.bundle].Isomorphism)))
    Normal.isomorphismExists;
