\import \parent.\parent.Normalized[data := parameters.approximation].With[form := parameters.normal].Shifted[].Leading[bound := parameters.radius].KClass[] \as Native;
\import Native.Pullback[] \as Product;
\import \parent.\parent.Clutched[] \as Original;
\import \parent.\parent.Result[data := parameters.approximation].Clutching[] \as ApproximateBundle;
\import topological_k_theory.KTheory[].On[X := Original.Carrier, baseSpace := Original.topology, compact := Original.productCompact, hausdorff := Original.productHausdorff] \as K;
\import K.K0[] \as K0;
\import K.Bundle[F := Original.Fiber, original := Original.bundle, same := \refl(Original.topology)] \as OriginalClass;
\import K.Bundle[F := ApproximateBundle.ApproximateFiber, original := ApproximateBundle.approximateBundle, same := \refl(Original.topology)] \as ApproximateClass;
\import K.Trivial[n := n] \as Rank;
\import K.Compare[F := Original.Fiber, G := ApproximateBundle.ApproximateFiber, first := Original.bundle, second := ApproximateBundle.approximateBundle,
  firstSame := \refl(Original.topology), secondSame := \refl(Original.topology)] \as Compare;
\definition reducedClutchingClass: K0.Carrier := K0.difference OriginalClass.value Rank.value;
\definition lineDifference: K0.Carrier := Native.lineDifference;
\definition pulledInverseClass: K0.Carrier := Product.pulledIndex;
\definition reconstruction: reducedClutchingClass = K0.mul lineDifference pulledInverseClass :=
  trans!{K0.Carrier} _ _ _
    (congr!{K.Classes K0.Carrier} (\fun (v: K.Classes) => K0.difference v Rank.value) _ _ (Compare.ofExists ApproximateBundle.isomorphismExists))
    Product.reconstruction;
