\import Monic.Clutching[] \as Native;
\definition Base: \Set := Native.Base;
\definition PencilFiber: Base -> \Set := Native.PencilFiber;
\definition pencilBundle: Bundles.Family[X := Base, F := PencilFiber].Bundle := Native.pencilBundle;
\definition DiagonalFiber: Base -> \Set := Native.DiagonalFiber;
\definition diagonalBundle: Bundles.Family[X := Base, F := DiagonalFiber].Bundle := Native.diagonalBundle;
\definition comparison: Bundles.Isomorphisms[X := Base, F := PencilFiber, G := DiagonalFiber, source := pencilBundle, target := diagonalBundle].Isomorphism := Native.comparison;
\definition NormalFiber: Base -> \Set := Native.NormalFiber;
\definition normalBundle: Bundles.Family[X := Base, F := NormalFiber].Bundle := Native.normalBundle;
\definition spectralComparisonExists: \exists Bundles.Isomorphisms[X := Base, F := DiagonalFiber, G := NormalFiber,
  source := diagonalBundle, target := normalBundle].Isomorphism := Native.spectralComparisonExists;
\import Monic.Stabilization[] \as Stable;
\definition StabilizedMonicFiber: Base -> \Set := Stable.SumFiber;
\definition stabilizedMonicBundle: Bundles.Family[X := Base, F := StabilizedMonicFiber].Bundle := Stable.sumBundle;
\definition stabilizedComparisonExists: \exists Bundles.Isomorphisms[X := Base, F := StabilizedMonicFiber, G := NormalFiber,
  source := stabilizedMonicBundle, target := normalBundle].Isomorphism := Stable.isomorphismExists;
\import \parent.\parent.Normalized[data := parameters.approximation].With[form := parameters.normal].Shifted[].Leading[bound := parameters.radius].StableClutching[] \as Shifted;
\definition StabilizedShiftedFiber: Base -> \Set := Shifted.SumFiber;
\definition stabilizedShiftedBundle: Bundles.Family[X := Base, F := StabilizedShiftedFiber].Bundle := Shifted.sumBundle;
\definition shiftedComparisonExists: \exists Bundles.Isomorphisms[X := Base, F := StabilizedShiftedFiber, G := NormalFiber,
  source := stabilizedShiftedBundle, target := normalBundle].Isomorphism := Shifted.isomorphismExists;
