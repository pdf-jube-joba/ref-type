\import Monic.Clutching[] \as Native;
\definition Base: \Set := Native.Base;
\definition PencilFiber: Base -> \Set := Native.PencilFiber;
\definition pencilBundle: Bundles.Family[X := Base, F := PencilFiber].Bundle := Native.pencilBundle;
\definition DiagonalFiber: Base -> \Set := Native.DiagonalFiber;
\definition diagonalBundle: Bundles.Family[X := Base, F := DiagonalFiber].Bundle := Native.diagonalBundle;
\definition comparison: Bundles.Isomorphisms[X := Base, F := PencilFiber, G := DiagonalFiber, source := pencilBundle, target := diagonalBundle].Isomorphism := Native.comparison;
\definition NormalFiber: Base -> \Set := Native.NormalFiber;
\definition normalBundle: Bundles.Family[X := Base, F := NormalFiber].Bundle := Native.normalBundle;
\definition spectralComparisonExists: \exists Bundles.Isomorphisms[X := Base, F := DiagonalFiber, G := NormalFiber,
  source := diagonalBundle, target := normalBundle].Isomorphism := Native.spectralComparisonExists;
