\import \root.Linearization[].RowOrders[n := n, X := X, source := source] \as Orders;
\import \root.Linearization[].Companion[n := n, d := parameters.normal.order].Families[X := X, source := source, coefficients := Monic.coefficients, regular := Monic.regularAction] \as Family;
\import \root.Linearization[].ScalarMatrices[n := n] \as Scaling;
\import Spaces.Coordinates[I := M.Index] \as Vectors;
\import Spaces.Linear[V := Vectors.Vector, W := Vectors.Vector, source := Vectors.space, target := Vectors.space] \as End;
\definition rows: Orders.Family parameters.normal.order := Family.rows;
\definition regular: Orders.Regular parameters.normal.order rows := Family.rowsRegular;
\definition kernel: Orders.Kernel parameters.normal.order rows := Monic.kernel;
\definition polynomial: Circle.Domain -> M.Matrix := Monic.polynomial;
\definition polynomialRegular: Top.Families[X := Circle.Domain].Regular Circle.source polynomial := Monic.polynomialRegular;
\definition action: \forall (p: Circle.Domain) -> M.linear (polynomial p) = Orders.polynomial parameters.normal.order rows (Circle.first p) (Circle.unit p) :=
  \fun (p: Circle.Domain) => Monic.At[point := p].action;
\definition indexFormula: Orders.Index[compact := compact, hausdorff := hausdorff, removed := N.Basic[].Def[].mul n parameters.normal.shift].value parameters.normal.order rows regular kernel = Monic.inverseClass := \refl(Monic.inverseClass);
