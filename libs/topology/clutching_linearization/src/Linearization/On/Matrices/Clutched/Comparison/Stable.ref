\import topological_k_theory.KTheory[].On[X := Carrier, baseSpace := topology, compact := productCompact, hausdorff := productHausdorff] \as K;
\import K.Bundle[F := Fiber, original := bundle, same := \refl(topology)] \as First;
\import K.Bundle[F := Other.Fiber, original := Other.bundle, same := \refl(topology)] \as Second;
\import K.K0[].Stability[].ForBundles[F := Fiber, G := Other.Fiber, first := bundle, second := Other.bundle,
  firstSame := \refl(topology), secondSame := \refl(topology)] \as Stability;
\module At(m: N.Nat^, iso: Stability.At[n := m].Isomorphism);
\definition invariant: K.K0[].include First.value = K.K0[].include Second.value ->
  \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n, a := a, regular := regular, nonzero := nonzero].Inverse[].value =
  \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n, a := b, regular := regularB, nonzero := nonzeroB].Inverse[].value := \block {
  \fun (equal: _) \then
  \takefrom m: \Cast[N.Nat^] ({ m: N.Nat^ \where \exists Stability.At[n := m].Isomorphism }) \by (Stability.criterion).ltr equal \then
  \takefrom iso: Stability.At[n := m].Isomorphism \by \bysub(N.Nat^, { m: N.Nat^ \where \exists Stability.At[n := m].Isomorphism }, m) \then
  \return At[m := m, iso := iso].invariant
};
