\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := total,
  a := b, regular := regularB, nonzero := nonzeroB].Clutched[] \as Other;
\import Homotopy.Clutching[n := m, X := Carrier, baseSpace := topology, U := U, V := V, openU := openU, openV := openV, covers := covers].Identity[] \as Identity;
\import Construction.Sum[m := m, h := Identity.identity, continuousH := Identity.continuous] \as Added;
\import Homotopy.Clutching[n := total, X := Carrier, baseSpace := topology, U := U, V := V, openU := openU, openV := openV, covers := covers].With[g := Added.block, continuous := Added.blockContinuous] \as Stable;
\import Stable.Comparison[h := Other.transition, continuousH := Other.transitionContinuous] \as Compare;
\import Spaces.Coordinates[I := Big.Index] \as Vectors;
\import Spaces.Linear[V := Big.Vector, W := Big.Vector, source := Vectors.space, target := Vectors.space] \as End;
\definition equal: Added.block = Other.transition := \axiom:funext(Added.block, Other.transition,
  \fun (p: Overlap) => End.ext _ _ (\axiom:funext((Added.block p).apply, (Other.transition p).apply,
    \fun (v: Big.Vector) => sym!{Big.Vector} _ _ (equation (circlePoint p) v))));
\definition OtherFiber: Carrier -> \Set := Other.Fiber;
\definition otherBundle: Bundles.Family[X := Carrier, F := OtherFiber].Bundle := Other.bundle;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].IsomorphismComposition[
    X := Carrier, F := SumFiber, G := StableFiber, H := OtherFiber, source := sumBundle, middle := stableBundle, target := otherBundle] \as Compose;
\definition isomorphismExists: \exists Compose.Isomorphism := Compose.exists \parent.isomorphismExists (Compare.ofEquality equal);
