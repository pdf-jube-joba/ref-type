\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n, a := b, regular := regularB, nonzero := nonzeroB].Clutched[] \as Other;
\import Disks.Hemispheres[].Cover[] \as Halves;
\definition C: \Pow Carrier := { p: Carrier \where \In[Sphere.Sphere] Halves.PositiveHalf (second p) };
\definition D: \Pow Carrier := { p: Carrier \where \In[Sphere.Sphere] Halves.NegativeHalf (second p) };
\definition closedC: Base.IsClosedIn topology C := Product.Maps[].secondContinuous source Sphere.sphereTopology (topology.Topology[Carrier := Sphere.Sphere].Complement Halves.PositiveHalf) Halves.positiveClosed;
\definition closedD: Base.IsClosedIn topology D := Product.Maps[].secondContinuous source Sphere.sphereTopology (topology.Topology[Carrier := Sphere.Sphere].Complement Halves.NegativeHalf) Halves.negativeClosed;
\definition covered: \forall (p: Carrier) -> Logic.Or[\In[Carrier] C p, \In[Carrier] D p] := \fun (p: Carrier) => Halves.halvesCover (second p);
\definition insideC: \forall (p: \Cast[Carrier] C) -> \In[Carrier] U p :=
  \fun (p: \Cast[Carrier] C) => Halves.positiveInside (\into[Sphere.Sphere](second p, Halves.PositiveHalf) \by { \bysub(Carrier, C, p) });
\definition insideD: \forall (p: \Cast[Carrier] D) -> \In[Carrier] V p :=
  \fun (p: \Cast[Carrier] D) => Halves.negativeInside (\into[Sphere.Sphere](second p, Halves.NegativeHalf) \by { \bysub(Carrier, D, p) });
\import Construction.Comparison[h := Other.transition, continuousH := Other.transitionContinuous].Closed[C := C, D := D, closedC := closedC, closedD := closedD, covered := covered, insideC := insideC, insideD := insideD] \as Closed;
\import topological_constructions.Product[A := X, B := C.Complex] \as PlaneProduct;
\definition Parameters: \Set := PlaneProduct.CarrierSet;
\definition parameterTopology: topology.Topology[Carrier := Parameters].Topology := PlaneProduct.topology source topological_algebra.Complex[].topology;
\definition parameter[p: Carrier]: Parameters := Pair.pair X C.Complex (first p) (CircleCoordinates.ambientForward (Disks.tail (second p)));
\definition parameterContinuous: topology.Continuity[A := Carrier, B := Parameters].Continuous topology parameterTopology parameter :=
  PlaneProduct.Universal[X := Carrier].pairContinuous topology source topological_algebra.Complex[].topology first
    (\fun (p: Carrier) => CircleCoordinates.ambientForward (Disks.tail (second p))) (Product.Maps[].firstContinuous source Sphere.sphereTopology)
    (topology.Composition[A := Carrier, B := Sphere.Sphere, C := C.Complex].composeContinuous topology Sphere.sphereTopology topological_algebra.Complex[].topology second
      (\fun (s: Sphere.Sphere) => CircleCoordinates.ambientForward (Disks.tail s)) (Product.Maps[].secondContinuous source Sphere.sphereTopology)
      (topology.Composition[A := Sphere.Sphere, B := algebraic_topology.Euclidean[].Dimension[n := two].Coordinate, C := C.Complex].composeContinuous Sphere.sphereTopology
        algebraic_topology.Euclidean[].Dimension[n := two].topology topological_algebra.Complex[].topology Disks.tail CircleCoordinates.ambientForward Disks.tailContinuous CircleCoordinates.ambientForwardContinuous));
\definition circleParameter[p: Circle.Domain]: Parameters := Pair.pair X C.Complex (Circle.first p) (Circle.unit p);
\structure Gauge: \Set := {
  positive: Parameters -> Units.Carrier, negative: Parameters -> Units.Carrier,
  positiveContinuous: topology.Continuity[A := Parameters, B := Units.Carrier].Continuous parameterTopology Units.topology positive,
  negativeContinuous: topology.Continuity[A := Parameters, B := Units.Carrier].Continuous parameterTopology Units.topology negative,
  compatible: \forall (p: Circle.Domain)(v: Fin.Fin n -> C.Complex) ->
    (negative (circleParameter p)).apply ((Matrices.map p).apply v) =
    (\root.Linearization[].MatrixUnits[n := n, Y := Circle.Domain, source := Circle.source, A := b, regular := regularB, nonzero := nonzeroB].map p).apply ((positive (circleParameter p)).apply v),
};
\module FromGauge(gauge: Gauge);
