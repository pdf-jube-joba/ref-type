\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n, a := b, regular := regularB, nonzero := nonzeroB].Clutched[] \as Other;
\import std.Data[].FinSet[] \as Fin;
\import Disks.Hemispheres[].Cover[] \as Halves;
\definition PositiveHalf: \Pow Carrier := { p: Carrier \where \In[Sphere.Sphere] Halves.PositiveHalf (second p) };
\definition NegativeHalf: \Pow Carrier := { p: Carrier \where \In[Sphere.Sphere] Halves.NegativeHalf (second p) };
\definition closedC: Base.IsClosedIn topology PositiveHalf := Product.Maps[].secondContinuous source Sphere.sphereTopology (topology.Topology[Carrier := Sphere.Sphere].Complement Halves.PositiveHalf) Halves.positiveClosed;
\definition closedD: Base.IsClosedIn topology NegativeHalf := Product.Maps[].secondContinuous source Sphere.sphereTopology (topology.Topology[Carrier := Sphere.Sphere].Complement Halves.NegativeHalf) Halves.negativeClosed;
\definition covered: \forall (p: Carrier) -> Logic.Or[\In[Carrier] PositiveHalf p, \In[Carrier] NegativeHalf p] := \fun (p: Carrier) => Halves.halvesCover (second p);
\definition insideC: \forall (p: \Cast[Carrier] PositiveHalf) -> \In[Carrier] U p :=
  \fun (p: \Cast[Carrier] PositiveHalf) => Halves.positiveInside (\into[Sphere.Sphere](second p, Halves.PositiveHalf) \by { \bysub(Carrier, PositiveHalf, p) });
\definition insideD: \forall (p: \Cast[Carrier] NegativeHalf) -> \In[Carrier] V p :=
  \fun (p: \Cast[Carrier] NegativeHalf) => Halves.negativeInside (\into[Sphere.Sphere](second p, Halves.NegativeHalf) \by { \bysub(Carrier, NegativeHalf, p) });
\import Construction.Comparison[h := Other.transition, continuousH := Other.transitionContinuous].Closed[C := PositiveHalf, D := NegativeHalf, closedC := closedC, closedD := closedD, covered := covered, insideC := insideC, insideD := insideD] \as Closed;
\definition halfGaugeCriterion: Logic.PropEquiv[\exists vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Isomorphisms[
    X := Carrier, F := Fiber, G := Other.Fiber, source := bundle, target := Other.bundle].Isomorphism, \exists Closed.Gauge] := Closed.gaugeCriterion;
\module DiskGauge(gauge: Closed.Gauge);
\import topological_constructions.Product[A := X, B := C.Complex] \as PlaneProduct;
\definition Parameters: \Set := PlaneProduct.CarrierSet;
\definition parameterTopology: topology.Topology[Carrier := Parameters].Topology := PlaneProduct.topology source topological_algebra.Complex[].topology;
\definition parameter[p: Carrier]: Parameters := Pair.pair X C.Complex (first p) (CircleCoordinates.ambientForward (Disks.tail (second p)));
\definition parameterContinuous: topology.Continuity[A := Carrier, B := Parameters].Continuous topology parameterTopology parameter :=
  PlaneProduct.Universal[X := Carrier].pairContinuous topology source topological_algebra.Complex[].topology first
    (\fun (p: Carrier) => CircleCoordinates.ambientForward (Disks.tail (second p))) (Product.Maps[].firstContinuous source Sphere.sphereTopology)
    (topology.Composition[A := Carrier, B := Sphere.Sphere, C := C.Complex].composeContinuous topology Sphere.sphereTopology topological_algebra.Complex[].topology second
      (\fun (s: Sphere.Sphere) => CircleCoordinates.ambientForward (Disks.tail s)) (Product.Maps[].secondContinuous source Sphere.sphereTopology)
      (topology.Composition[A := Sphere.Sphere, B := algebraic_topology.Euclidean[].Dimension[n := two].Coordinate, C := C.Complex].composeContinuous Sphere.sphereTopology
        algebraic_topology.Euclidean[].Dimension[n := two].topology topological_algebra.Complex[].topology Disks.tail CircleCoordinates.ambientForward Disks.tailContinuous CircleCoordinates.ambientForwardContinuous));
\definition circleParameter[p: Circle.Domain]: Parameters := Pair.pair X C.Complex (Circle.first p) (Circle.unit p);
\structure Gauge: \Set := {
  positive: Parameters -> Units.Carrier, negative: Parameters -> Units.Carrier,
  positiveContinuous: topology.Continuity[A := Parameters, B := Units.Carrier].Continuous parameterTopology Units.topology positive,
  negativeContinuous: topology.Continuity[A := Parameters, B := Units.Carrier].Continuous parameterTopology Units.topology negative,
  compatible: \forall (p: Circle.Domain)(v: Fin.Fin n -> C.Complex) ->
    (negative (circleParameter p)).apply ((Matrices.map p).apply v) =
    (\root.Linearization[].MatrixUnits[n := n, Y := Circle.Domain, source := Circle.source, A := b, regular := regularB, nonzero := nonzeroB].map p).apply ((positive (circleParameter p)).apply v),
};
\module FromGauge(gauge: Gauge);
\structure Path: \Set := {
  homotopy: Cylinder.CarrierSet -> M.Matrix,
  regular: Top.Families[X := Cylinder.CarrierSet].Regular cylinderTopology homotopy,
  nonzero: \forall (p: Cylinder.CarrierSet) -> Field.Nonzero (homotopy p),
  atStart: \forall (p: Circle.Domain) -> homotopy (Pair.pair Time.Carrier Circle.Domain Time.start p) = a p,
  atEnd: \forall (p: Circle.Domain) -> homotopy (Pair.pair Time.Carrier Circle.Domain Time.end p) = b p,
};
\module Along(path: Path);
\import Construction.Comparison[h := Other.transition, continuousH := Other.transitionContinuous] \as EqualTransitions;
\definition ofEquality: (\forall (p: Circle.Domain) -> a p = b p) ->
  \exists vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
    conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Isomorphisms[
    X := Carrier, F := Fiber, G := Other.Fiber, source := bundle, target := Other.bundle].Isomorphism :=
  \fun (equal: _) => EqualTransitions.ofEquality (\axiom:funext(transition, Other.transition,
    \fun (p: Overlap) => congr!{M.Matrix Spaces.Linear[V := M.Vector, W := M.Vector, source := Spaces.Coordinates[I := M.Index].space, target := Spaces.Coordinates[I := M.Index].space].Map}
      M.linear _ _ (equal (circlePoint p))));
