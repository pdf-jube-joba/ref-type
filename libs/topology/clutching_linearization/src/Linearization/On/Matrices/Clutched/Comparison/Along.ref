\import topological_constructions.Product[A := Time.Carrier, B := Overlap] \as TimeOverlap;
\import TimeOverlap.Maps[] \as Projections;
\definition timeTopology: topology.Topology[Carrier := TimeOverlap.CarrierSet].Topology := TimeOverlap.topology Time.topology overlapTopology;
\definition parameter[p: TimeOverlap.CarrierSet]: Cylinder.CarrierSet := Pair.pair Time.Carrier Circle.Domain
  (Pair.first Time.Carrier Overlap p) (circlePoint (Pair.second Time.Carrier Overlap p));
\definition parameterContinuous: topology.Continuity[A := TimeOverlap.CarrierSet, B := Cylinder.CarrierSet].Continuous timeTopology cylinderTopology parameter :=
  Cylinder.Universal[X := TimeOverlap.CarrierSet].pairContinuous timeTopology Time.topology Circle.source (Pair.first Time.Carrier Overlap)
    (\fun (p: TimeOverlap.CarrierSet) => circlePoint (Pair.second Time.Carrier Overlap p)) (Projections.firstContinuous Time.topology overlapTopology)
    (topology.Composition[A := TimeOverlap.CarrierSet, B := Overlap, C := Circle.Domain].composeContinuous timeTopology overlapTopology Circle.source
      (Pair.second Time.Carrier Overlap) circlePoint (Projections.secondContinuous Time.topology overlapTopology) circleContinuous);
\import \root.Linearization[].MatrixUnits[n := n, Y := Cylinder.CarrierSet, source := cylinderTopology, A := path.homotopy, regular := path.regular, nonzero := path.nonzero] \as MatrixPath;
\definition transition[p: TimeOverlap.CarrierSet]: Units.Carrier := MatrixPath.map (parameter p);
\definition continuous: topology.Continuity[A := TimeOverlap.CarrierSet, B := Units.Carrier].Continuous timeTopology Units.topology transition :=
  topology.Composition[A := TimeOverlap.CarrierSet, B := Cylinder.CarrierSet, C := Units.Carrier].composeContinuous timeTopology cylinderTopology Units.topology parameter MatrixPath.map parameterContinuous MatrixPath.continuous;
\import BaseClutching.Homotopy[compact := productCompact, hausdorff := productHausdorff, G := transition, regular := continuous] \as Motion;
\import Motion.Endpoint[t := Time.start] \as Initial;
\import Motion.Endpoint[t := Time.end] \as FinalEndpoint;
\import Spaces.Coordinates[I := M.Index] \as Vectors;
\import Spaces.Linear[V := Vectors.Vector, W := Vectors.Vector, source := Vectors.space, target := Vectors.space] \as End;
\definition startEquality: \forall (p: Overlap) -> Initial.at p = Matrices.map (circlePoint p) :=
  \fun (p: Overlap) => congr!{M.Matrix End.Map} M.linear _ _ (path.atStart (circlePoint p));
\definition endEquality: \forall (p: Overlap) -> FinalEndpoint.at p = Other.transition p :=
  \fun (p: Overlap) => congr!{M.Matrix End.Map} M.linear _ _ (path.atEnd (circlePoint p));
\import Construction.Comparison[h := Initial.at, continuousH := Initial.regularAt] \as Start;
\import BaseClutching.With[g := FinalEndpoint.at, continuous := FinalEndpoint.regularAt].Comparison[h := Other.transition, continuousH := Other.transitionContinuous] \as Finish;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Operations;
\definition startExists: \exists Bundles.Isomorphisms[X := Carrier, F := Fiber, G := Initial.Fiber, source := bundle, target := Initial.bundle].Isomorphism :=
  Start.ofEquality (\axiom:funext((\fun (p: Overlap) => Matrices.map (circlePoint p)), Initial.at, \fun (p: Overlap) => sym!{{Units.Carrier}} _ _ (startEquality p)));
\definition finishExists: \exists Bundles.Isomorphisms[X := Carrier, F := FinalEndpoint.Fiber, G := Other.Fiber, source := FinalEndpoint.bundle, target := Other.bundle].Isomorphism :=
  Finish.ofEquality (\axiom:funext(FinalEndpoint.at, Other.transition, endEquality));
\import Operations.IsomorphismComposition[X := Carrier, F := Fiber, G := Initial.Fiber, H := FinalEndpoint.Fiber, source := bundle, middle := Initial.bundle, target := FinalEndpoint.bundle] \as First;
\import Operations.IsomorphismComposition[X := Carrier, F := Fiber, G := FinalEndpoint.Fiber, H := Other.Fiber, source := bundle, middle := FinalEndpoint.bundle, target := Other.bundle] \as Last;
\definition isomorphismExists: \exists Bundles.Isomorphisms[X := Carrier, F := Fiber, G := Other.Fiber, source := bundle, target := Other.bundle].Isomorphism :=
  Last.exists (First.exists startExists Motion.isomorphismExists) finishExists;
