\import \root.Linearization[].ScalarMatrices[n := n] \as Scalar;
\import topological_algebra.Complex[] \as Plane;
\import Plane.Functions[A := Circle.Domain] \as Functions;
\definition matrix[p: Circle.Domain]: M.Matrix := Scalar.scale s (a p);
\definition matrixRegular: Top.Families[X := Circle.Domain].Regular Circle.source matrix :=
  \fun (i, j: M.Index) => Functions.multiplicationContinuous Circle.source (\fun (_: Circle.Domain) => s) (\fun (p: Circle.Domain) => a p i j)
    (topology.Maps[A := Circle.Domain, B := C.Complex].constantContinuous Circle.source Plane.topology s) (regular i j);
\definition matrixNonzero: \forall (p: Circle.Domain) -> Field.Nonzero (matrix p) :=
  \fun (p: Circle.Domain) => Scalar.nonzero s nonzeroScalar (a p) (nonzero p);
\import \parent.Comparison[b := matrix, regularB := matrixRegular, nonzeroB := matrixNonzero] \as Compare;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n,
  a := matrix, regular := matrixRegular, nonzero := matrixNonzero].Clutched[] \as Scaled;
\definition ScaledFiber: Carrier -> \Set := Scaled.Fiber;
\definition scaledBundle: vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Family[X := Carrier, F := ScaledFiber].Bundle := Scaled.bundle;
\module Gauge;
\definition isomorphism: vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Isomorphisms[
    X := Carrier, F := Fiber, G := ScaledFiber, source := bundle, target := scaledBundle].Isomorphism := Compare.FromGauge[gauge := Gauge[].gauge].value;
