\import Construction.Stabilize[m := m] \as Native;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\import Homotopy.BlockDiagonal[n := n, m := m] \as Block;
\definition total: N.Nat^ := Block.total;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := total] \as Big;
\import matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := total] \as BigField;
\import matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := total] \as BigTop;
\import Homotopy.Projections[n := m].Operators[].Units[] \as AddedUnits;
\definition block[p: Circle.Domain]: Homotopy.Projections[n := total].Operators[].Units[].Carrier := Block.value (Matrices.map p) AddedUnits.identity;
\definition SumFiber: Carrier -> \Set := Native.SumFiber;
\definition sumBundle: Bundles.Family[X := Carrier, F := SumFiber].Bundle := Native.sumBundle;
\definition StableFiber: Carrier -> \Set := Native.StableFiber;
\definition stableBundle: Bundles.Family[X := Carrier, F := StableFiber].Bundle := Native.stableBundle;
\definition isomorphismExists: \exists Bundles.Isomorphisms[X := Carrier, F := SumFiber, G := StableFiber, source := sumBundle, target := stableBundle].Isomorphism := Native.isomorphismExists;
\module Comparing(b: Circle.Domain -> Big.Matrix, regularB: BigTop.Families[X := Circle.Domain].Regular Circle.source b,
  nonzeroB: \forall (p: Circle.Domain) -> BigField.Nonzero (b p),
  equation: \forall (p: Circle.Domain)(v: Big.Vector) -> (Big.linear (b p)).apply v = (block p).apply v);
