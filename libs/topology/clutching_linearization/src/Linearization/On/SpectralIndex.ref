\import spectral_splitting.Spectral[].At[n := n].Continuous[X := X, source := source, A := A, regular := regular, off := off] \as Native;
\import Native.Bundle[] \as Image;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition Fiber: X -> \Set := Image.Fiber;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Image.bundle;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\import K.Bundle[F := Fiber, original := bundle, same := \refl(source)] \as Inside;
\import K.Trivial[n := removed] \as Removed;
\definition value: K.K0[].Carrier := K.K0[].difference Inside.value Removed.value;
\module Pullback(Y: \Set, space: topology.Topology[Carrier := Y].Topology,
  compactY: topology.Topology[Carrier := Y].IsCompact space, hausdorffY: topology.Topology[Carrier := Y].IsT2 space,
  f: Y -> X, continuous: topology.Continuity[A := Y, B := X].Continuous space source f);
\module Sum(m: N.Nat^, B: X -> matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := m].Matrix,
  regularB: matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := m].Families[X := X].Regular source B,
  offB: \forall (x: X) -> spectral_splitting.Spectral[].At[n := m].Splitting[A := B x].OffSpectrum, removedB: N.Nat^);
\module Canonical(c: C.Complex, outside: Real.Lt R.one (C.Absolute[].abs c));
\module Equal(B: X -> matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n].Matrix,
  regularB: matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := n].Families[X := X].Regular source B,
  offB: \forall (x: X) -> spectral_splitting.Spectral[].At[n := n].Splitting[A := B x].OffSpectrum);
\module Similarity(m: N.Nat^, B: X -> matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := m].Matrix,
  regularB: matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := m].Families[X := X].Regular source B,
  offB: \forall (x: X) -> spectral_splitting.Spectral[].At[n := m].Splitting[A := B x].OffSpectrum);
\module Scalar(r: C.Complex,
  acts: \forall (x: X)(v: matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n].Vector) ->
    (matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n].linear (A x)).apply v = Spaces.Coordinates[I := std.Data[].FinSet[].Fin n].scale r v);

\definition removedEquality: \forall (other: N.Nat^) -> removed = other -> value = \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].SpectralIndex[n := n, A := A, regular := regular, off := off, removed := other].value :=
  \fun (other: N.Nat^)(equal: removed = other) => congr!{{N.Nat^} {K.K0[].Carrier}} (\fun (k: N.Nat^) => K.K0[].difference Inside.value K.Trivial[n := k].value) _ _ equal;
