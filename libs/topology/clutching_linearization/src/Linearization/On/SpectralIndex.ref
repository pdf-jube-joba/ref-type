\import spectral_splitting.Spectral[].At[n := n].Continuous[X := X, source := source, A := A, regular := regular, off := off].Bundle[] \as Image;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition Fiber: X -> \Set := Image.Fiber;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Image.bundle;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\import K.Bundle[F := Fiber, original := bundle, same := \refl(source)] \as Inside;
\import K.Trivial[n := removed] \as Removed;
\definition value: K.K0[].Carrier := K.K0[].difference Inside.value Removed.value;
