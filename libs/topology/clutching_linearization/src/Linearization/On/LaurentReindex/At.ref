\import algebra.Hom[A := Laurent.Carrier, B := Laurent.Carrier].Composition[C := C.Complex] \as Composition;
\import algebra.Hom[A := Laurent.Carrier, B := C.Complex] \as Maps;
\definition composed: Maps.RingMap (Rings.commutativeRingAsRing Laurent.Carrier Laurent.ring) (Rings.commutativeRingAsRing C.Complex Scalars.commutativeRing) :=
  Composition.ring (Rings.commutativeRingAsRing Laurent.Carrier Laurent.ring) (Rings.commutativeRingAsRing Laurent.Carrier Laurent.ring) (Rings.commutativeRingAsRing C.Complex Scalars.commutativeRing) map (Circle.evaluation p);
\import Laurent.Universal[K := C.Complex, target := Scalars.commutativeRing] \as Values;
\definition constant: \forall (a: CoefficientRing.Carrier) -> composed (Laurent.constant a) = a (f (Circle.first p)) :=
  \fun (a: CoefficientRing.Carrier) => trans!{{C.Complex}} _ _ _ (congr!{Laurent.Carrier {C.Complex}} (Circle.evaluation p) _ _ (onConstant a)) (Circle.onConstant (coefficient a) p);
\definition variable: composed Laurent.X = Circle.unit p := trans!{{C.Complex}} _ _ _ (congr!{Laurent.Carrier {C.Complex}} (Circle.evaluation p) _ _ onVariable) (Circle.onVariable p);
\definition inverseVariable: composed Laurent.inverseX = C.Def[].conj (Circle.unit p) := trans!{{C.Complex}} _ _ _ (congr!{Laurent.Carrier {C.Complex}} (Circle.evaluation p) _ _ onInverseVariable) (Circle.onInverseVariable p);
\definition inverse: C.Def[].mul (Circle.unit p) (C.Def[].conj (Circle.unit p)) = C.Def[].one := trans!{{C.Complex}} _ _ _ (C.Prop[].mulConjSelf (Circle.unit p))
  (congr!{{R.Real} {C.Complex}} C.Def[].ofReal _ _ (Circle.unitNorm p));
\definition equality: composed = Circle.evaluation (point p) := Values.unique (CoefficientRing.evaluation (f (Circle.first p))) (Circle.unit p) (C.Def[].conj (Circle.unit p)) inverse composed constant variable inverseVariable;
\definition evaluation: \forall (q: Laurent.Carrier) -> Circle.value (map q) p = Circle.value q (point p) :=
  \fun (q: Laurent.Carrier) => congr!{{Laurent.Carrier -> C.Complex} {C.Complex}} (\fun (g: Laurent.Carrier -> C.Complex) => g q) _ _ equality;
