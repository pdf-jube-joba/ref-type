\import algebraic_topology.Interval[] \as Time;
\import spectral_splitting.Spectral[].At[n := n].Homotopy[X := X, baseSpace := source, compact := compact, A := A, regular := regular, off := off] \as Motion;
\import Motion.Endpoint[t := Time.start] \as Start;
\import Motion.Endpoint[t := Time.end] \as Finish;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\import K.Bundle[F := Start.Fiber, original := Start.bundle, same := \refl(source)] \as First;
\import K.Bundle[F := Finish.Fiber, original := Finish.bundle, same := \refl(source)] \as Last;
\import K.Compare[F := Start.Fiber, G := Finish.Fiber, first := Start.bundle, second := Finish.bundle,
  firstSame := \refl(source), secondSame := \refl(source)] \as Comparison;
\import K.Trivial[n := removed] \as Removed;
\import K.K0[] \as Group;
\definition startValue: Group.Carrier := Group.difference First.value Removed.value;
\definition endValue: Group.Carrier := Group.difference Last.value Removed.value;
\definition invariant: startValue = endValue :=
  congr!{K.Classes Group.Carrier} (\fun (c: K.Classes) => Group.difference c Removed.value) _ _
    (Comparison.ofExists Motion.endpointIsomorphismExists);
