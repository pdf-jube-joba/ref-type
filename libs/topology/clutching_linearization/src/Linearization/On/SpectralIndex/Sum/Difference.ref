\import \parent.BundlesComparison[] \as Images;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].TrivialSum[n := removed, m := removedB] \as Ranks;
\import K.Bundle[F := Other.Fiber, original := Other.bundle, same := \refl(source)] \as OtherImage;
\import K.Bundle[F := Total.Fiber, original := Total.bundle, same := \refl(source)] \as TotalImage;
\import K.Trivial[n := removedB] \as OtherRemoved;
\import K.Trivial[n := N.Basic[].Def[].add removed removedB] \as TotalRemoved;
\import algebra.GroupCompletion[].Of[M := K.Classes, monoid := K.K0[].additiveMonoid] \as Completion;
\definition positive: K.Classes := K.Addition[].add Inside.value OtherImage.value;
\definition negative: K.Classes := K.Addition[].add Removed.value OtherRemoved.value;
\definition addDifferences: K.K0[].add value Other.value = K.K0[].difference positive negative :=
  trans!{K.K0[].Carrier} _ _ _
    (congr!{K.K0[].Carrier K.K0[].Carrier K.K0[].Carrier} K.K0[].add _ _ _ _
      (K.K0[].differenceClass Inside.value Removed.value) (K.K0[].differenceClass OtherImage.value OtherRemoved.value))
    (trans!{K.K0[].Carrier} _ _ _ (Completion.addClass (Completion.pair Inside.value Removed.value) (Completion.pair OtherImage.value OtherRemoved.value))
      (sym!{K.K0[].Carrier} _ _ (K.K0[].differenceClass positive negative)));
\definition additivity: K.K0[].add value Other.value = Total.value :=
  trans!{K.K0[].Carrier} _ _ _ addDifferences
    (congr!{K.Classes K.Classes K.K0[].Carrier} K.K0[].difference _ _ _ _ Images.additivity Ranks.additivity);
