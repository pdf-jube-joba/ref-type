\import std.Data[].FinSet[] \as Fin;
\import Spaces.Coordinates[I := Fin.Fin n] \as V;
\import Spaces.Coordinates[I := Fin.Fin m] \as W;
\import Spaces.Isomorphism[V := V.Vector, W := W.Vector, source := V.space, target := W.space] \as Iso;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing] \as Matrices;
\import Matrices.At[n := n] \as MA;
\import Matrices.At[n := m] \as MB;
\import hermitian_frames.Hermitian[].Over[K := C.Complex, field := Scalars.field, scalar := linear_algebra.Hermitian[].Complex[].scalar,
  topological := hermitian_frames.Hermitian[].Complex[].topological] \as Hermitian;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].SpectralIndex[n := m, A := B, regular := regularB, off := offB, removed := removed] \as Other;
\import spectral_splitting.Spectral[].At[n := m].Continuous[X := X, source := source, A := B, regular := regularB, off := offB] \as OtherNative;
\import OtherNative.Bundle[] \as OtherImage;
\module With(iso: X -> Iso.Isomorphism,
  regularForward: Hermitian.At[n := m].Families[X := X].Matrix[m := n].Regular source (\fun (x: X) => (iso x).forward),
  regularBackward: Hermitian.At[n := n].Families[X := X].Matrix[m := m].Regular source (\fun (x: X) => (iso x).backward),
  intertwines: \forall (x: X)(v: V.Vector) -> (iso x).forward.apply ((MA.linear (A x)).apply v) = (MB.linear (B x)).apply ((iso x).forward.apply v));
