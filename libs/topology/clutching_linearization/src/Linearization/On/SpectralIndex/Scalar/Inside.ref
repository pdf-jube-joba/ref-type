\definition projectionIdentity: \forall (x: X)(v: Vectors.Vector) -> (Native.projection x).apply v = v :=
  \fun (x: X)(v: Vectors.Vector) => \root.Linearization[].SpectralPencil[n := n, A := A x, off := off x].Eigenvector[z := r, v := v, eigen := acts x v].onInside inside;
\import Bundles.Trivial[X := X, n := n, baseSpace := source] \as Trivial;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Fiber, G := (\fun (_: X) => Vectors.Vector), source := bundle, target := Trivial.bundle].Isomorphism :=
  Bundles.Isomorphisms[X := X, F := Fiber, G := (\fun (_: X) => Vectors.Vector), source := bundle, target := Trivial.bundle].Isomorphism {
    forward := Image.inclusion, backward := Image.project,
    leftInverse := Image.onImage, rightInverse := projectionIdentity,
  };
\definition classEquality: K.Bundle[F := Fiber, original := bundle, same := \refl(source)].value = K.Trivial[n := n].value :=
  K.Compare[F := Fiber, G := (\fun (_: X) => Vectors.Vector), first := bundle, second := Trivial.bundle, firstSame := \refl(source), secondSame := \refl(source)].ofIsomorphism isomorphism;
\definition valueFormula: value = K.K0[].difference K.Trivial[n := n].value Removed.value :=
  congr!{K.Classes {K.K0[].Carrier}} (\fun (c: K.Classes) => K.K0[].difference c Removed.value) _ _ classEquality;
