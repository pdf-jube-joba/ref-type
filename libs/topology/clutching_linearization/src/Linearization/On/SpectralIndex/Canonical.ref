\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].CanonicalIndex[
  n := n, P := Image.idempotent, regular := Native.projectionRegular, c := c, outside := outside, removed := removed] \as Model;
\definition matrix: X -> matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n].Matrix := Model.matrix;
\definition canonicalValue: K.K0[].Carrier := Model.value;
\definition invariant: canonicalValue = value := Model.recovery;
\definition ModelFiber: X -> \Set := Model.SpectralFiber;
\definition modelBundle: Bundles.Family[X := X, F := ModelFiber].Bundle := Model.spectralBundle;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Fiber, G := ModelFiber, source := bundle, target := modelBundle].Isomorphism := Model.isomorphism;
