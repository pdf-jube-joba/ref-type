\import std.Data[].FinSet[] \as Fin;
\import Fin.Sum[m := n, n := m] \as Indices;
\import Indices.Tuples[A := C.Complex] \as Tuples;
\definition total: N.Nat^ := Indices.total;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing] \as Matrices;
\import Matrices.At[n := n] \as MA;
\import Matrices.At[n := m] \as MB;
\import Matrices.At[n := total] \as M;
\import Spaces.Coordinates[I := Fin.Fin n] \as V;
\import Spaces.Coordinates[I := Fin.Fin m] \as W;
\import Spaces.Coordinates[I := Fin.Fin total] \as Flat;
\import Spaces.DirectSum[V := V.Vector, W := W.Vector, left := V.space, right := W.space] \as PairSpace;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Operations;
\import Operations.CoordinateSum[n := n, m := m] \as Coordinates;
\import Spaces.FiniteCoordinates[n := total] \as Basis;
\import spectral_splitting.Spectral[].At[n := m].Continuous[X := X, source := source, A := B, regular := regularB, off := offB] \as OtherNative;
\definition matrix[x: X]: M.Matrix := \root.Linearization[].SpectralSum[n := n, m := m, A := A x, B := B x, offA := off x, offB := offB x].matrix;
\import topological_algebra.Complex[] \as Plane;
\definition matrixRegular: matrix_invariants.Topological[K := C.Complex, ring := Plane.Ring[].topologicalRing].At[n := total].Families[X := X].Regular source matrix :=
  \fun (i, j: M.Index) =>
    (\induction (s: Indices.Index) \return topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology
      (\fun (x: X) => Tuples.evaluate ((MA.linear (A x)).apply (PairSpace.first (Coordinates.split (Basis.vectors j))))
        ((MB.linear (B x)).apply (PairSpace.second (Coordinates.split (Basis.vectors j)))) s) \with {
      | inl: \fun (k: Fin.Fin n) => Native.regularT (PairSpace.first (Coordinates.split (Basis.vectors j))) k
      | inr: \fun (k: Fin.Fin m) => OtherNative.regularT (PairSpace.second (Coordinates.split (Basis.vectors j))) k
    }) (Indices.split i);
\definition totalOff: \forall (x: X) -> spectral_splitting.Spectral[].At[n := total].Splitting[A := matrix x].OffSpectrum :=
  \fun (x: X) => \root.Linearization[].SpectralSum[n := n, m := m, A := A x, B := B x, offA := off x, offB := offB x].off;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].SpectralIndex[
  n := m, A := B, regular := regularB, off := offB, removed := removedB] \as Other;
\import \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].SpectralIndex[
  n := total, A := matrix, regular := matrixRegular, off := totalOff, removed := N.Basic[].Def[].add removed removedB] \as Total;
\import spectral_splitting.Spectral[].At[n := total].Continuous[X := X, source := source, A := matrix, regular := matrixRegular, off := totalOff] \as TotalNative;
\import Operations.DirectSum[X := X, F := Fiber, G := Other.Fiber, left := bundle, right := Other.bundle] \as Added;
\definition SumFiber: X -> \Set := Added.Fiber;
\definition sumBundle: Bundles.Family[X := X, F := SumFiber].Bundle := Added.bundle (\refl(source));
\module At(x: X);
