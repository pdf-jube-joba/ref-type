\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n] \as M;
\import matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := n].Families[X := X] \as Families;
\import \parent.\parent.SpectralIndex[n := n, A := B, regular := regularB, off := offB, removed := removed] \as Other;
\definition invariant: (\forall (x: X) -> A x = B x) -> value = Other.value :=
  \fun (equal: _) => (\idelim A = B \with matrix: (X -> M.Matrix) =>
    \forall (continuous: Families.Regular source matrix)(gap: \forall (x: X) -> spectral_splitting.Spectral[].At[n := n].Splitting[A := matrix x].OffSpectrum) ->
      value = \root.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].SpectralIndex[
        n := n, A := matrix, regular := continuous, off := gap, removed := removed].value \by {
          base: \fun (continuous: Families.Regular source A)(gap: \forall (x: X) -> spectral_splitting.Spectral[].At[n := n].Splitting[A := A x].OffSpectrum) => \refl(value),
          equality: \axiom:funext(A, B, equal)
        }) regularB offB;
