\structure MatrixForm: \Set := {
  shift: N.Nat^,
  polynomials: Fin.Fin n -> Fin.Fin m -> P.Carrier,
  equation: \forall (i: Fin.Fin n)(j: Fin.Fin m) -> L.mul (power shift) (p i j) = embed (polynomials i j),
};
\definition Forms: \Set := \forall (i: Fin.Fin n)(j: Fin.Fin m) -> Form[p i j];
\module Selected(forms: Forms);
\definition commonExists: \exists MatrixForm := \block {
  \takefrom forms: Forms \by \axiom:classicalIndefiniteChoice(Fin.Fin n,
    (\fun (i: Fin.Fin n) => \forall (j: Fin.Fin m) -> Form[p i j]),
    (\fun (i: Fin.Fin n) => \axiom:classicalIndefiniteChoice(Fin.Fin m, (\fun (j: Fin.Fin m) => Form[p i j]), (\fun (j: Fin.Fin m) => exists (p i j))))) \then
  \return \exact(Selected[forms := forms].result, MatrixForm)
};
