\import topological_algebra.Complex[] \as Plane;
\definition continuous: \forall (k: N.Nat^) -> topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology (\fun (x: X) => value (z x) k) :=
  \induction (k: N.Nat^) \return topology.Continuity[A := X, B := C.Complex].Continuous source Plane.topology (\fun (x: X) => value (z x) k) \with {
    | zero: topology.Maps[A := X, B := C.Complex].constantContinuous source Plane.topology C.Def[].one
    | succ: \fun (k: N.Nat^)(previous: _) => Plane.Functions[A := X].multiplicationContinuous source z (\fun (x: X) => value (z x) k) regular previous
  };
