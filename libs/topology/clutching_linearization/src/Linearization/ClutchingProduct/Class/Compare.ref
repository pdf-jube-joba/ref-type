\import Clutching.With[g := h, continuous := continuousH] \as Other;
\import K.Bundle[F := Other.Fiber, original := Other.bundle, same := \refl(source)] \as OtherIncluded;
\import \parent.\parent.Class[g := h, continuous := continuousH] \as OtherClass;
\import Constructed.Comparison[h := h, continuousH := continuousH] \as Comparison;
\import K.Compare[F := Constructed.Fiber, G := Other.Fiber, first := Constructed.bundle, second := Other.bundle,
  firstSame := \refl(source), secondSame := \refl(source)] \as Classes;
\definition ofEquality: (\forall (x: Overlap) -> g x = h x) -> value = OtherClass.value :=
  \fun (equal: _) => congr!{K.Classes K.K0[].Carrier} (\fun (v: K.Classes) => K.K0[].difference v Rank.value) _ _
    (Classes.ofExists (Comparison.ofEquality (\axiom:funext(g, h, equal))));
