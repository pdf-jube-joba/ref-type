\import \root.Linearization[].IdentityImage[n := n, X := X, source := source] \as IdentityImage;
\import \root.Linearization[].ProjectionBundle[n := n, X := X, source := source, P := (\fun (_: X) => IdentityImage.projection), regular := IdentityImage.regular].Clutching[
  U := U, V := V, openU := openU, openV := openV, covers := covers].With[
  a := (\fun (x: Overlap) => Powers.value (z x) one), continuous := Continuity.continuous one,
  nonzero := (\fun (x: Overlap) => Powers.nonzero (z x) (unitZ x) one)] \as Model;
\import Model.KClass[compact := compact, hausdorff := hausdorff] \as Product;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar].Trivial[X := X, n := n, baseSpace := source] \as Trivial;
\import K.Compare[F := IdentityImage.Fiber, G := (\fun (_: X) => Vectors.Vector), first := IdentityImage.bundle, second := Trivial.bundle,
  firstSame := \refl(source), secondSame := \refl(source)] \as ImageComparison;
\import K.Trivial[n := n] \as Rank;
\definition lineDifference: K0.Carrier := Product.lineDifference;
\definition generatorFormula: generator = K0.mul lineDifference (K0.include Rank.value) :=
  trans!{K0.Carrier} _ _ _ Product.comparison
    (congr!{K0.Carrier K0.Carrier} (K0.mul lineDifference) _ _ (congr!{K.Classes K0.Carrier} K0.include _ _ (ImageComparison.ofIsomorphism IdentityImage.isomorphism)));
