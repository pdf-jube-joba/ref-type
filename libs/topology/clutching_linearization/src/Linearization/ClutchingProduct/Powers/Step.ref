\import \parent.At[k := k] \as Previous;
\import \parent.At[k := N.Nat^::succ k] \as Next;
\import \parent.\parent.With[a := First.transition, b := Previous.transition, continuousA := First.regular, continuousB := Previous.regular] \as Product;
\import Product.Comparison[].KClass[] \as Addition;
\definition coefficient: \forall (x: Overlap) -> C.Def[].mul (Powers.value (z x) one) (Powers.value (z x) k) = Powers.value (z x) (N.Nat^::succ k) :=
  \fun (x: Overlap) => congr!{{C.Complex} {C.Complex}} (\fun (u: C.Complex) => C.Def[].mul u (Powers.value (z x) k)) _ _ (C.Prop[].mulOneRight (z x));
\definition action: \forall (x: Overlap)(v: Vectors.Vector) -> (Product.product x).apply v = (Next.transition x).apply v :=
  \fun (x: Overlap)(v: Vectors.Vector) => trans!{Vectors.Vector} _ _ _
    (First.formula x ((Previous.transition x).apply v))
    (trans!{Vectors.Vector} _ _ _
      (congr!{Vectors.Vector Vectors.Vector} (Vectors.space.smul (Powers.value (z x) one)) _ _ (Previous.formula x v))
      (trans!{Vectors.Vector} _ _ _ (sym!{Vectors.Vector} _ _ (Vectors.space.scalarAssoc (Powers.value (z x) one) (Powers.value (z x) k) v))
        (trans!{Vectors.Vector} _ _ _ (congr!{{C.Complex} Vectors.Vector} (\fun (u: C.Complex) => Vectors.space.smul u v) _ _ (coefficient x))
          (sym!{Vectors.Vector} _ _ (Next.formula x v)))));
\definition equal: \forall (x: Overlap) -> Product.product x = Next.transition x :=
  \fun (x: Overlap) => End.ext _ _ (\axiom:funext((Product.product x).apply, (Next.transition x).apply, action x));
\import \parent.\parent.Class[g := Product.product, continuous := Product.productContinuous].Compare[h := Next.transition, continuousH := Next.regular] \as Comparison;
\definition additivity: Next.value = K0.add generator Previous.value := trans!{K0.Carrier} _ _ _
  (sym!{K0.Carrier} _ _ (Comparison.ofEquality equal)) Addition.additivity;
