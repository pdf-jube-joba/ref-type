\import Clutching.With[g := g, continuous := continuous] \as Constructed;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as K;
\import K.Bundle[F := Constructed.Fiber, original := Constructed.bundle, same := \refl(source)] \as Included;
\import K.Trivial[n := n] \as Rank;
\definition value: K.K0[].Carrier := K.K0[].difference Included.value Rank.value;
\module Compare(h: Overlap -> Units.Carrier,
  continuousH: topology.Continuity[A := Overlap, B := Units.Carrier].Continuous overlapTopology Units.topology h);
\import Clutching.Identity[] \as Identity;
\import \parent.Class[g := Identity.identity, continuous := Identity.continuous] \as IdentityClass;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar].Trivial[X := X, n := n, baseSpace := source] \as Trivial;
\import K.Compare[F := (\fun (_: X) => Spaces.Coordinates[I := std.Data[].FinSet[].Fin n].Vector), G := Identity.Fiber,
  first := Trivial.bundle, second := Identity.bundle, firstSame := \refl(source), secondSame := \refl(source)] \as IdentityComparison;
\definition identityClass: IdentityClass.value = K.K0[].zero :=
  trans!{K.K0[].Carrier} _ _ _
    (congr!{K.Classes K.K0[].Carrier} (\fun (v: K.Classes) => K.K0[].difference v Rank.value) _ _ (sym!{K.Classes} _ _ (IdentityComparison.ofExists Identity.isomorphismExists)))
    (algebra.Group[].Of[Carrier := K.K0[].Carrier, group := K.K0[].group].inverseRight (K.K0[].include Rank.value));
