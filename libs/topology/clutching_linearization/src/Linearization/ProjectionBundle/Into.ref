\import std.Data[].FinSet[] \as Fin;
\import Spaces.Coordinates[I := Fin.Fin m] \as TargetVectors;
\import Spaces.Linear[V := Vectors.Vector, W := TargetVectors.Vector, source := Vectors.space, target := TargetVectors.space] \as Linear;
\import spectral_splitting.Spectral[].Idempotents[n := m].Image[X := X, baseSpace := source, P := Q, regular := regularQ] \as Destination;
\module With(h: X -> Linear.Map,
  regularH: Hermitian.At[n := m].Families[X := X].Matrix[m := n].Regular source h,
  commutes: \forall (x: X)(v: Vectors.Vector) -> (h x).apply ((P x).map.apply v) = (Q x).map.apply ((h x).apply v));
