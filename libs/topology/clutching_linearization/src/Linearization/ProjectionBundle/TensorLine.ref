\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Operations;
\import Operations.ScalarLine[X := X, baseSpace := source] \as ScalarLine;
\import Operations.Tensor[X := X, F := L, G := ImageFiber, left := line, right := imageBundle] \as Tensor;
\definition tensorBundle: Bundles.Family[X := X, F := Tensor.Fiber].Bundle := Tensor.bundle sameBase;
\import Operations.DirectSum[X := X, F := Tensor.Fiber, G := ComplementFiber, left := tensorBundle, right := complementBundle] \as Product;
\definition ProductFiber: X -> \Set := Product.Fiber;
\definition productBundle: Bundles.Family[X := X, F := ProductFiber].Bundle := Product.bundle sameBase;
\import Bundles.Isomorphisms[X := X, F := L, G := (\fun (_: X) => C.Complex), source := line, target := ScalarLine.bundle] \as Frames;
\definition Frame: \Set := Frames.Isomorphism;
\module In(frame: Frame);
\module Comparison(first, second: Frame);
\definition TensorFiber: X -> \Set := Tensor.Fiber;
\module Pullback(Y: \Set, space: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  continuous: topology.Continuity[A := Y, B := X].Continuous space source f);
