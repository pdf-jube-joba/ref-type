\import \root.Linearization[].RestrictionChart[X := X, F := ProductFiber, bundle := productBundle, U := U, openU := openU, n := n] \as Chart;
\definition BasePoint: \Set := Chart.BasePoint;
\definition inclusion[x: BasePoint]: X := x;
\definition inclusionContinuous: topology.Continuity[A := BasePoint, B := X].Continuous Chart.source source inclusion :=
  \idelim line.baseSpace = source \with t: topology.Topology[Carrier := X].Topology => topology.Continuity[A := BasePoint, B := X].Continuous Chart.source t inclusion \by {
    base: (\fun (V: \Pow X)(open: _) => topology.Topology[Carrier := X].Subspace[S := U].traceOpen line.baseSpace V open), equality: sameBase
  };
\import \parent.Pullback[Y := BasePoint, space := Chart.source, f := inclusion, continuous := inclusionContinuous] \as Pulled;
\definition Frame: \Set := Pulled.LineFrame;
\module In(frame: Frame);
