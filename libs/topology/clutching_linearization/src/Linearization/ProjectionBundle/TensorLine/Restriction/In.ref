\import Pulled.Framed[frame := frame] \as Framing;
\import Chart.With[value := Framing.trivialization] \as Local;
\definition trivialization: Bundles.Family[X := X, F := ProductFiber].With[data := productBundle].Chart := Local.trivialization;
\definition unit[x: BasePoint]: L x := (frame.backward.fiber x).apply C.Def[].one;
\definition reconstruction[x: BasePoint][v: M.Vector]: ProductFiber x :=
  Pair.pair (TensorFiber x) (ComplementFiber x) (Tensor.pure x (unit x) ((Image.projectMap.fiber x).apply v)) ((Other.projectMap.fiber x).apply v);
\definition forwardPure: \forall (x: BasePoint)(l: L x)(v: ImageFiber x)(w: ComplementFiber x) ->
  (trivialization.frame x).forward.apply (Pair.pair (TensorFiber x) (ComplementFiber x) (Tensor.pure x l v) w) =
    Vectors.plus (Vectors.scale ((frame.forward.fiber x).apply l) v) w := Framing.onPure;
\definition backwardFormula: \forall (x: BasePoint)(v: M.Vector) -> (trivialization.frame x).backward.apply v = reconstruction x v := Framing.backwardFormula;
