\definition projectedEigen: (M.linear A).apply (Projection.projection.apply v) = Vectors.scale z (Projection.projection.apply v) :=
  trans!{M.Vector} _ _ _ (commute v)
    (trans!{M.Vector} _ _ _ (congr!{M.Vector M.Vector} Projection.projection.apply _ _ eigen) (Projection.projection.preservesScale z v));
\definition complementaryEigen: (M.linear A).apply (Projection.complementary.apply v) = Vectors.scale z (Projection.complementary.apply v) :=
  trans!{M.Vector} _ _ _ (commuteComplement v)
    (trans!{M.Vector} _ _ _ (congr!{M.Vector M.Vector} Projection.complementary.apply _ _ eigen) (Projection.complementary.preservesScale z v));
\definition onInside: Real.Le (C.Absolute[].abs z) R.one -> Projection.projection.apply v = v :=
  \fun (inside: _) => trans!{M.Vector} _ _ _ (sym!{M.Vector} _ _ (Values.zeroRight (Projection.projection.apply v)))
    (trans!{M.Vector} _ _ _ (congr!{M.Vector M.Vector} (Vectors.plus (Projection.projection.apply v)) _ _
      (sym!{M.Vector} _ _ (outsideNoEigen z inside (Projection.complementary.apply v) (Projection.inOtherKernel v) complementaryEigen)))
      (Projection.reconstruction v));
\definition onOutside: Real.Le R.one (C.Absolute[].abs z) -> Projection.projection.apply v = Vectors.origin :=
  \fun (outside: _) => insideNoEigen z outside (Projection.projection.apply v) (Projection.inKernel v) projectedEigen;
