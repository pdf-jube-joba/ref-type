\definition nonzero: C.Def[].NonZero z := \fun (zero: z = C.Def[].zero) => Laws.zeroNeOne
  (trans!{{R.Real}} _ _ _ (sym!{{R.Real}} _ _ (trans!{{R.Real}} _ _ _ (congr!{{C.Complex} {R.Real}} C.Absolute[].abs _ _ zero)
    uniform_approximation.Approximation[].FiniteComplex[].zeroAbsolute)) unit);
\module Scaled(s: C.Complex, bounded: Real.Le (C.Absolute[].abs s) R.one);
