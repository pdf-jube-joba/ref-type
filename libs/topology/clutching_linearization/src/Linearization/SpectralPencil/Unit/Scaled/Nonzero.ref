\definition ratio: C.Complex := C.Def[].mul (C.Def[].inv s) z;
\definition cancels: C.Def[].mul s ratio = z := trans!{{C.Complex}} _ _ _ (sym!{{C.Complex}} _ _ (C.Prop[].mulAssoc s (C.Def[].inv s) z))
  (trans!{{C.Complex}} _ _ _ (congr!{{C.Complex} {C.Complex}} (\fun (a: C.Complex) => C.Def[].mul a z) _ _ (C.Prop[].inverseNonzeroRight s nonzeroS)) (C.Prop[].mulOneLeft z));
\definition magnitude: C.Absolute[].abs (C.Def[].mul s ratio) = R.one := trans!{{R.Real}} _ _ _ (congr!{{C.Complex} {R.Real}} C.Absolute[].abs _ _ cancels) unit;
\definition ratioBound: Real.Le R.one (C.Absolute[].abs ratio) := Real.leReplaceLeft _ _ _ magnitude
  (Real.leReplace _ _ _ _ (sym!{{R.Real}} _ _ (trans!{{R.Real}} _ _ _ (C.Absolute[].multiplicative s ratio) (Laws.fieldMulComm (C.Absolute[].abs s) (C.Absolute[].abs ratio))))
    (R.Algebra[].mulOneRight (C.Absolute[].abs ratio))
    (R.Estimates[].mulMonotone (C.Absolute[].abs ratio) (C.Absolute[].abs s) R.one (C.Absolute[].nonnegative ratio) bounded));
\definition inside: \forall (v: M.Vector) -> Evaluation.apply Split.inside v = Vectors.origin ->
  Vectors.scale s ((M.linear A).apply v) = Vectors.scale z v -> v = Vectors.origin :=
  \fun (v: M.Vector)(kernel: _)(equation: _) => insideNoEigen ratio ratioBound v kernel (eq_reason_in!{M.Vector _
    "=" { Vectors.scale (C.Def[].inv s) (Vectors.scale s ((M.linear A).apply v)) } "by" { sym!{M.Vector} _ _ (inverseScale s nonzeroS ((M.linear A).apply v)) }
    "=" { Vectors.scale (C.Def[].inv s) (Vectors.scale z v) } "by" { congr!{M.Vector M.Vector} (Vectors.scale (C.Def[].inv s)) _ _ equation }
    "=" { Vectors.scale ratio v } "by" { sym!{M.Vector} _ _ (Vectors.space.scalarAssoc (C.Def[].inv s) z v) }
  });
