\import std.Logic[].Classical[] \as Classical;
\definition productBound: Real.Le (C.Absolute[].abs (C.Def[].mul s z)) R.one := Real.leReplaceLeft _ _ _
  (sym!{{R.Real}} _ _ (trans!{{R.Real}} _ _ _ (C.Absolute[].multiplicative s z)
    (trans!{{R.Real}} _ _ _ (congr!{{R.Real} {R.Real}} (R.mul (C.Absolute[].abs s)) _ _ unit) (R.Algebra[].mulOneRight (C.Absolute[].abs s))))) bounded;
\definition outside: \forall (v: M.Vector) -> Evaluation.apply Split.outside v = Vectors.origin ->
  (M.linear A).apply v = Vectors.scale (C.Def[].mul s z) v -> v = Vectors.origin := outsideNoEigen (C.Def[].mul s z) productBound;
\module Nonzero(nonzeroS: C.Def[].NonZero s);
\definition inside: \forall (v: M.Vector) -> Evaluation.apply Split.inside v = Vectors.origin ->
  Vectors.scale s ((M.linear A).apply v) = Vectors.scale z v -> v = Vectors.origin :=
  \fun (v: M.Vector)(kernel: _)(equation: _) => Logic.orElim _ _ _ (Classical.excludedMiddle (s = C.Def[].zero))
    (\fun (zero: s = C.Def[].zero) => \block {
      \let annihilated: Vectors.scale z v = Vectors.origin := trans!{M.Vector} _ _ _ (sym!{M.Vector} _ _ equation)
        (trans!{M.Vector} _ _ _ (congr!{{C.Complex} M.Vector} (\fun (a: C.Complex) => Vectors.scale a ((M.linear A).apply v)) _ _ zero) (Values.zeroScale ((M.linear A).apply v))) \then
      \return trans!{M.Vector} _ _ _ (sym!{M.Vector} _ _ (inverseScale z nonzero v))
        (trans!{M.Vector} _ _ _ (congr!{M.Vector M.Vector} (Vectors.scale (C.Def[].inv z)) _ _ annihilated) (Values.scaleZero (C.Def[].inv z)))
    })
    (\fun (nonzeroS: C.Def[].NonZero s) => Nonzero[nonzeroS := nonzeroS].inside v kernel equation);
\module Deformation;
