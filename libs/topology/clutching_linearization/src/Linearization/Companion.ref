\import std.Data[].FinSet[] \as Fin;
\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as NatLaws;
\import N.Order[].Prop[] \as NatOrder;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\definition degree: N.Nat^ := N.Nat^::succ d;
\import \root.Linearization[].Coordinates[n := n] \as Coordinates;
\definition Carrier: \Set := Coordinates.Carrier degree;
\definition space: Spaces.VectorSpace Carrier := Coordinates.space degree;
\import Spaces.Linear[V := Vectors.Vector, W := Vectors.Vector, source := Vectors.space, target := Vectors.space] \as End;
\import Spaces.Linear[V := Carrier, W := Vectors.Vector, source := space, target := Vectors.space] \as Row;
\import Spaces.Linear[V := Carrier, W := Carrier, source := space, target := space] \as Operators;
\import Spaces.Laws[V := Vectors.Vector, space := Vectors.space] \as Values;
\import algebra.Group[].Of[Carrier := Vectors.Vector, group := Rings.ringModuleAsCommutativeGroup C.Complex Vectors.Vector Spaces.ring Vectors.space] \as ValueGroup;
\import Fin.Sum[m := d, n := N.Nat^::succ N.Nat^::zero] \as Indices;
\import Indices.Tuples[A := Vectors.Vector] \as Joining;
\definition rankEquality: Indices.total = degree := NatLaws.addComm (N.Nat^::succ N.Nat^::zero) d;
\definition toTotal[i: Fin.Fin degree]: Fin.Fin Indices.total := \into[N.Nat^](i, Fin.Fin Indices.total) \by {
  \idelim degree = Indices.total \with k: N.Nat^ => NatLaws.Lt i k \by { base: Fin.bound degree i, equality: sym!{{N.Nat^}} _ _ rankEquality }
};
\definition fromTotal[i: Fin.Fin Indices.total]: Fin.Fin degree := \into[N.Nat^](i, Fin.Fin degree) \by {
  \idelim Indices.total = degree \with k: N.Nat^ => NatLaws.Lt i k \by { base: Fin.bound Indices.total i, equality: rankEquality }
};
\definition join[f: Fin.Fin d -> Vectors.Vector][v: Vectors.Vector]: Carrier :=
  \fun (i: Fin.Fin degree) => Joining.join f (\fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => v) (toTotal i);
\definition last: Fin.Fin degree := \into[N.Nat^](d, Fin.Fin degree) \by { NatOrder.ltSelfSucc d };
\definition atFront: \forall (f: Fin.Fin d -> Vectors.Vector)(v: Vectors.Vector)(i: Fin.Fin d) -> join f v (Fin.widen d i) = f i :=
  \fun (f: Fin.Fin d -> Vectors.Vector)(v: Vectors.Vector)(i: Fin.Fin d) => Joining.atLeft f (\fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => v) i;
\definition atLast: \forall (f: Fin.Fin d -> Vectors.Vector)(v: Vectors.Vector) -> join f v last = v :=
  \fun (f: Fin.Fin d -> Vectors.Vector)(v: Vectors.Vector) => trans!{Vectors.Vector} _ _ _
    (congr!{{Fin.Fin Indices.total} Vectors.Vector} (Joining.join f (\fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => v)) (toTotal last) (Indices.right (Fin.zero N.Nat^::zero)) (sym!{{N.Nat^}} _ _ (NatLaws.addZeroLeft d)))
    (Joining.atRight f (\fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => v) (Fin.zero N.Nat^::zero));
\definition joinAddition: \forall (f, g: Fin.Fin d -> Vectors.Vector)(v, w: Vectors.Vector) ->
  join (\fun (i: Fin.Fin d) => Vectors.plus (f i) (g i)) (Vectors.plus v w) = (space.add (join f v) (join g w)) :=
  \fun (f, g: Fin.Fin d -> Vectors.Vector)(v, w: Vectors.Vector) => \axiom:funext(join (\fun (i: Fin.Fin d) => Vectors.plus (f i) (g i)) (Vectors.plus v w), space.add (join f v) (join g w), \fun (i: Fin.Fin degree) =>
    (\induction (k: Indices.Index) \return
      Joining.evaluate (\fun (j: Fin.Fin d) => Vectors.plus (f j) (g j)) (\fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => Vectors.plus v w) k =
        Vectors.plus (Joining.evaluate f (\fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => v) k) (Joining.evaluate g (\fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => w) k) \with {
          | inl: \fun (j: Fin.Fin d) => \refl(Vectors.plus (f j) (g j))
          | inr: \fun (j: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => \refl(Vectors.plus v w)
        }) (Indices.split (toTotal i)));
\definition joinScalar: \forall (a: C.Complex)(f: Fin.Fin d -> Vectors.Vector)(v: Vectors.Vector) ->
  join (\fun (i: Fin.Fin d) => Vectors.scale a (f i)) (Vectors.scale a v) = space.smul a (join f v) :=
  \fun (a: C.Complex)(f: Fin.Fin d -> Vectors.Vector)(v: Vectors.Vector) => \axiom:funext(join (\fun (i: Fin.Fin d) => Vectors.scale a (f i)) (Vectors.scale a v), space.smul a (join f v), \fun (i: Fin.Fin degree) =>
    (\induction (k: Indices.Index) \return
      Joining.evaluate (\fun (j: Fin.Fin d) => Vectors.scale a (f j)) (\fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => Vectors.scale a v) k =
        Vectors.scale a (Joining.evaluate f (\fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => v) k) \with {
          | inl: \fun (j: Fin.Fin d) => \refl(Vectors.scale a (f j))
          | inr: \fun (j: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => \refl(Vectors.scale a v)
        }) (Indices.split (toTotal i)));
\definition power: C.Complex -> N.Nat^ -> C.Complex := \root.Linearization[].Powers[].value;
\import Spaces.Linear[V := Vectors.Vector, W := Carrier, source := Vectors.space, target := space] \as Column;
\definition geometric[z: C.Complex]: Column.Map := Column.Map {
  apply := \fun (v: Vectors.Vector)(i: Fin.Fin degree) => Vectors.scale (power z i) v,
  preservesAdd := \fun (v, w: Vectors.Vector) => \axiom:funext((\fun (i: Fin.Fin degree) => Vectors.scale (power z i) (Vectors.plus v w)), (\fun (i: Fin.Fin degree) => Vectors.plus (Vectors.scale (power z i) v) (Vectors.scale (power z i) w)), \fun (i: Fin.Fin degree) => Vectors.space.vectorAdd (power z i) v w),
  preservesScale := \fun (a: C.Complex)(v: Vectors.Vector) => \axiom:funext((\fun (i: Fin.Fin degree) => Vectors.scale (power z i) (Vectors.scale a v)), (\fun (i: Fin.Fin degree) => Vectors.scale a (Vectors.scale (power z i) v)), \fun (i: Fin.Fin degree) => Values.scaleComm (power z i) a v),
};
\module With(coefficients: Fin.Fin degree -> End.Map);
\module Families(X: \Set, source: topology.Topology[Carrier := X].Topology,
  coefficients: X -> Fin.Fin degree -> End.Map,
  regular: \forall (k: Fin.Fin degree)(v: Vectors.Vector)(j: Fin.Fin n) ->
    topology.Continuity[A := X, B := C.Complex].Continuous source topological_algebra.Complex[].topology (\fun (x: X) => (coefficients x k).apply v j));
\module Splitting;
\module Shift(z: C.Complex);
\module ShiftFamilies(Y: \Set, source: topology.Topology[Carrier := Y].Topology, z: Y -> C.Complex,
  regularZ: topology.Continuity[A := Y, B := C.Complex].Continuous source topological_algebra.Complex[].topology z);
\module Reordering;
\module FromRow(row: Row.Map);
\module RowFamilies(X: \Set, source: topology.Topology[Carrier := X].Topology,
  rows: X -> Row.Map,
  regular: \forall (v: Carrier)(j: Fin.Fin n) -> topology.Continuity[A := X, B := C.Complex].Continuous source topological_algebra.Complex[].topology (\fun (x: X) => (rows x).apply v j));
\module RowHomotopy(X: \Set, source: topology.Topology[Carrier := X].Topology);
