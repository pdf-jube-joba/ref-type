\import matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := Coordinates.dimension d] \as Field;
\definition inverse[y: Y]: M.Operations[].Inverse (matrix y) := \into[M.Matrix](Representation.entries (coordinateMap (B y)), M.Operations[].Inverse (matrix y)) \by {
  Representation.inverseCertificate (coordinateMap (A y)) (coordinateMap (B y))
    (\fun (v: Flat.Vector) => eq_reason_in!{Flat.Vector _
      "=" { Coordinates.flatten d ((B y).apply ((A y).apply (Coordinates.unflatten d v))) } "by" {
        congr!{Carrier Flat.Vector} (\fun (w: Carrier) => Coordinates.flatten d ((B y).apply w)) _ _ (Coordinates.leftInverse d ((A y).apply (Coordinates.unflatten d v))) }
      "=" { Coordinates.flatten d (Coordinates.unflatten d v) } "by" { congr!{Carrier Flat.Vector} (Coordinates.flatten d) _ _ (left y (Coordinates.unflatten d v)) }
      "=" v "by" { Coordinates.rightInverse d v }
    })
    (\fun (v: Flat.Vector) => eq_reason_in!{Flat.Vector _
      "=" { Coordinates.flatten d ((A y).apply ((B y).apply (Coordinates.unflatten d v))) } "by" {
        congr!{Carrier Flat.Vector} (\fun (w: Carrier) => Coordinates.flatten d ((A y).apply w)) _ _ (Coordinates.leftInverse d ((B y).apply (Coordinates.unflatten d v))) }
      "=" { Coordinates.flatten d (Coordinates.unflatten d v) } "by" { congr!{Carrier Flat.Vector} (Coordinates.flatten d) _ _ (right y (Coordinates.unflatten d v)) }
      "=" v "by" { Coordinates.rightInverse d v }
    })
};
\definition nonzero: \forall (y: Y) -> Field.Nonzero (matrix y) := \fun (y: Y) => Field.nonzeroOfInverse (matrix y) (inverse y);
