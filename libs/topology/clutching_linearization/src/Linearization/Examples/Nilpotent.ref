\import spectral_splitting.Spectral[].Examples[].MovingNilpotent[] \as Model;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := two] \as M;
\definition matrix[x: Point]: M.Matrix := Model.matrix C.Def[].one;
\definition regular: matrix_invariants.Topological[K := C.Complex, ring := Plane.Ring[].topologicalRing].At[n := two].Families[X := Point].Regular topology matrix :=
  \fun (i, j: M.Index) => topology.Maps[A := Point, B := C.Complex].constantContinuous topology Plane.topology (Model.matrix C.Def[].one i j);
\import \root.Linearization[].SpectralMotion[n := two, X := Point, source := topology, A := matrix, regular := regular,
  off := (\fun (_: Point) => Model.gap C.Def[].one)].Comparison[compact := Finite.compact, hausdorff := Finite.hausdorff] \as Comparison;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition comparison: \exists Bundles.Isomorphisms[X := Comparison.Base, F := Comparison.PencilFiber, G := Comparison.NormalFiber,
  source := Comparison.pencilBundle, target := Comparison.normalBundle].Isomorphism := Comparison.isomorphismExists;
\import \root.Linearization[].On[X := Point, source := topology, compact := Finite.compact, hausdorff := Finite.hausdorff].SpectralIndex[
  n := two, A := matrix, regular := regular, off := (\fun (_: Point) => Model.gap C.Def[].one), removed := zero] \as Index;
\import \root.Linearization[].CanonicalScalar[] \as Scalar;
\import Index.Canonical[c := Scalar.value, outside := Scalar.outside] \as Canonical;
\definition canonicalInvariant: Canonical.canonicalValue = Index.value := Canonical.invariant;
\import \root.Linearization[].SpectralMotion[n := two, X := Point, source := topology, A := matrix, regular := regular,
  off := (\fun (_: Point) => Model.gap C.Def[].one)].Normal[].Clutched[compact := Finite.compact, hausdorff := Finite.hausdorff].Product[] \as Product;
\definition productFormula: Product.reducedClass = Product.productClass := Product.productFormula;
\import \root.Linearization[].On[X := Point, source := topology, compact := Finite.compact, hausdorff := Finite.hausdorff] \as On;
\import \root.Linearization[].LinearPolynomial[n := two, X := Point, source := topology, A := matrix, regular := regular,
  off := (\fun (_: Point) => Model.gap C.Def[].one)].Index[compact := Finite.compact, hausdorff := Finite.hausdorff] \as Pencil;
\import On.Matrices[n := two, a := Pencil.family.matrix, regular := Pencil.family.regular, nonzero := Pencil.family.nonzero] \as Loop;
\definition inverseRecovery: Loop.Inverse[].value = Index.value := Pencil.recovery;
\import On.DirectSum[n := two, m := two, a := Pencil.family, b := Pencil.family] \as Double;
\import On.Matrices[n := Double.total, a := Double.sum.matrix, regular := Double.sum.regular, nonzero := Double.sum.nonzero] \as DoubleLoop;
\import topological_k_theory.KTheory[].On[X := Point, baseSpace := topology, compact := Finite.compact, hausdorff := Finite.hausdorff] \as K;
\definition doubleRecovery: DoubleLoop.Inverse[].value = K.K0[].add Index.value Index.value :=
  trans!{K.K0[].Carrier} _ _ _ Double.additivity (congr!{K.K0[].Carrier K.K0[].Carrier K.K0[].Carrier} K.K0[].add _ _ _ _ inverseRecovery inverseRecovery);
