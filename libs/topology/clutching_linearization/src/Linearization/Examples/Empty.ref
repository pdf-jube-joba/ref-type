\import spectral_splitting.Spectral[].Examples[].Empty[] \as Model;
\import matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := zero] \as M;
\definition matrix[x: Point]: M.Matrix := Model.matrix;
\definition regular: matrix_invariants.Topological[K := C.Complex, ring := Plane.Ring[].topologicalRing].At[n := zero].Families[X := Point].Regular topology matrix :=
  \fun (i, j: M.Index) => topology.Maps[A := Point, B := C.Complex].constantContinuous topology Plane.topology (Model.matrix i j);
\import \root.Linearization[].SpectralMotion[n := zero, X := Point, source := topology, A := matrix, regular := regular,
  off := (\fun (_: Point) => Model.gap)].Comparison[compact := Finite.compact, hausdorff := Finite.hausdorff] \as Comparison;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition comparison: \exists Bundles.Isomorphisms[X := Comparison.Base, F := Comparison.PencilFiber, G := Comparison.NormalFiber,
  source := Comparison.pencilBundle, target := Comparison.normalBundle].Isomorphism := Comparison.isomorphismExists;
