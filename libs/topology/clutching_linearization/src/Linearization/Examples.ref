\import std.Data[].FinSet[] \as Fin;
\definition zero: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zero;
\definition two: N.Nat^ := N.Nat^::succ one;
\definition Point: \Set := Fin.Fin one;
\definition topology: topology.Topology[Carrier := Point].Topology := topology.Topology[Carrier := Point].Discrete;
\import topological_k_theory.KTheory[].FiniteDiscrete[n := one] \as Finite;
\import topological_algebra.Complex[] \as Plane;
\module Empty;
\module Nilpotent;
