\import Spaces.Coordinates[I := std.Data[].FinSet[].Fin n] \as Vectors;
\import Spaces.FiniteCoordinates[n := n] \as Basis;
\import spectral_splitting.Spectral[].Idempotents[n := n] \as Idempotents;
\definition projection: Idempotents.Projection := Idempotents.Projection { map := Basis.identity,
  idempotent := \fun (v: Vectors.Vector) => \refl(v)
};
\definition regular: hermitian_frames.Hermitian[].Over[K := C.Complex, field := Scalars.field, scalar := linear_algebra.Hermitian[].Complex[].scalar,
  topological := hermitian_frames.Hermitian[].Complex[].topological].At[n := n].Families[X := X].Matrix[m := n].Regular source (\fun (_: X) => projection.map) :=
  \fun (v: Vectors.Vector)(i: std.Data[].FinSet[].Fin n) => topology.Maps[A := X, B := C.Complex].constantContinuous source topological_algebra.Complex[].topology (v i);
\import spectral_splitting.Spectral[].Idempotents[n := n].Image[X := X, baseSpace := source, P := (\fun (_: X) => projection), regular := regular] \as Image;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\import Bundles.Trivial[X := X, n := n, baseSpace := source] \as Ambient;
\definition Fiber: X -> \Set := Image.Fiber;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Image.bundle;
\import Bundles.Isomorphisms[X := X, F := Fiber, G := (\fun (_: X) => Vectors.Vector), source := bundle, target := Ambient.bundle] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := Image.inclusion, backward := Image.projectMap,
  leftInverse := \fun (x: X)(v: Fiber x) => \refl(v),
  rightInverse := \fun (x: X)(v: Vectors.Vector) => \refl(v),
};
