\definition rightEigen: (MB.linear B).apply (second.apply v) = W.scale z (second.apply v) :=
  trans!{W.Vector} _ _ _ (sym!{W.Vector} _ _ (rightAction v))
    (trans!{W.Vector} _ _ _ (congr!{Flat.Vector W.Vector} second.apply _ _ eigen) (second.preservesScale z v));
\definition rightZero: second.apply v = W.origin := spectral_splitting.Spectral[].At[n := m].Eigenvalues[A := B].noUnitEigen offB z unit (second.apply v) rightEigen;
\import Spaces.Laws[V := V.Vector, space := V.space] \as Values;
\definition leftReduced: first.apply ((M.linear matrix).apply v) = (MA.linear A).apply (first.apply v) :=
  trans!{V.Vector} _ _ _ (leftAction v)
    (trans!{V.Vector} _ _ _ (congr!{W.Vector V.Vector} (\fun (w: W.Vector) => V.plus ((MA.linear A).apply (first.apply v)) (coupling.apply w)) _ _ rightZero)
      (trans!{V.Vector} _ _ _ (congr!{V.Vector V.Vector} (V.plus ((MA.linear A).apply (first.apply v))) _ _ coupling.preservesZero)
        (Values.zeroRight ((MA.linear A).apply (first.apply v)))));
\definition leftEigen: (MA.linear A).apply (first.apply v) = V.scale z (first.apply v) :=
  trans!{V.Vector} _ _ _ (sym!{V.Vector} _ _ leftReduced)
    (trans!{V.Vector} _ _ _ (congr!{Flat.Vector V.Vector} first.apply _ _ eigen) (first.preservesScale z v));
\definition leftZero: first.apply v = V.origin := spectral_splitting.Spectral[].At[n := n].Eigenvalues[A := A].noUnitEigen offA z unit (first.apply v) leftEigen;
\definition zero: v = Flat.origin := eq_reason_in!{Flat.Vector _
  "=" { Coordinates.join (Coordinates.split v) } "by" { sym!{Flat.Vector} _ _ ((Frames.laws Coordinates.isomorphism).rightInverse v) }
  "=" { Coordinates.join Sum.origin } "by" { congr!{Sum.Carrier Flat.Vector} Coordinates.join _ _ (Pair.Prop[A := V.Vector, B := W.Vector].ext (Coordinates.split v) Sum.origin leftZero rightZero) }
  "=" _ "by" { Coordinates.forward.preservesZero }
};
