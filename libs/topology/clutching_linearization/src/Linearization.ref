\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import complex.Complex[] \as C;
\import C.Algebra[] \as Scalars;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := Scalars.commutativeRing] \as Spaces;
\module Blocks(V, W: \Set, left: Spaces.VectorSpace V, right: Spaces.VectorSpace W);
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as Real;
\import Real.Order[] \as Order;
\import Real.Arithmetic[].Prop[] \as Laws;
\import std.Logic[].Proposition[] \as Logic;
\module Uniform(A, I: \Set, coordinate: A -> I -> R.Real);
\module ComplexBounds;
\import std.Data[].Nat[] \as N;
\module MatrixNeighborhoods(n: N.Nat^);
\module On(X: \Set, source: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact source, hausdorff: topology.Topology[Carrier := X].IsT2 source);
\import std.Alg[].Ring[] \as Rings;
\module LaurentNormal(K: \Set, coefficients: Rings.CommutativeRing[K]);
\module FiniteBounds;
\module Coordinates(n: N.Nat^);
\module Companion(n, d: N.Nat^);
\module Geometric(V: \Set, space: Spaces.VectorSpace V,
  A: Spaces.Linear[V := V, W := V, source := space, target := space].Map);
\module Powers;
\module ScalarMatrices(n: N.Nat^);
\module PolynomialEigen(V: \Set, space: Spaces.VectorSpace V,
  T: Spaces.Linear[V := V, W := V, source := space, target := space].Map);
\module SpectralPencil(n: N.Nat^, A: matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n].Matrix,
  off: spectral_splitting.Spectral[].At[n := n].Splitting[A := A].OffSpectrum);
\module SpectralMotion(n: N.Nat^, X: \Set, source: topology.Topology[Carrier := X].Topology,
  A: X -> matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n].Matrix,
  regular: matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := n].Families[X := X].Regular source A,
  off: \forall (x: X) -> spectral_splitting.Spectral[].At[n := n].Splitting[A := A x].OffSpectrum);
\module MatrixContinuity(n: N.Nat^, Y: \Set, source: topology.Topology[Carrier := Y].Topology);
\definition BlockEnd[n, d: N.Nat^]: \Set := Spaces.Linear[V := \root.Linearization[].Coordinates[n := n].Carrier d, W := \root.Linearization[].Coordinates[n := n].Carrier d,
  source := \root.Linearization[].Coordinates[n := n].space d, target := \root.Linearization[].Coordinates[n := n].space d].Map;
\module BlockMatrices(n, d: N.Nat^, Y: \Set, source: topology.Topology[Carrier := Y].Topology, A: Y -> BlockEnd n d,
  regular: \forall (v: \root.Linearization[].Coordinates[n := n].Carrier d) -> \root.Linearization[].Coordinates[n := n].Families[X := Y, source := source].Regular d (\fun (y: Y) => (A y).apply v));
\module MatrixUnits(n: N.Nat^, Y: \Set, source: topology.Topology[Carrier := Y].Topology,
  A: Y -> matrix_invariants.Ring[K := C.Complex, scalars := Scalars.commutativeRing].At[n := n].Matrix,
  regular: matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := n].Families[X := Y].Regular source A,
  nonzero: \forall (y: Y) -> matrix_invariants.Field[K := C.Complex, field := Scalars.field].At[n := n].Nonzero (A y));
\module Examples;
