\import Theory.For[X := X, F := Box.Fiber, bundle := Box.bundle] \as Original;
\import Original.With[metric := metric] \as Source;
\import Bundles.Family[X := X, F := Box.Fiber] \as Family;
\import Sum.CompareGauges[left := Original.MetricGauge[metric := metric].data, right := Box.gauge] \as Radial;
\import \root.Thom[].Levels[A := Family.Point, B := Family.Point, source := Box.bundle.totalSpace, target := Box.bundle.totalSpace,
  q := Source.squared, r := Box.squared, h := Radial.totalHomeomorphism, forwardSquared := Radial.forwardSquared, backwardSquared := Radial.backwardSquared] \as Level;
\import Box.Comparison[] \as Iteration;
\definition inverse: topology.Homeomorphism[A := Box.BoxThom, B := Box.IteratedThom].Homeomorphism[Box.thomTopology, Box.iteratedTopology] :=
  topology.Homeomorphism[A := Box.IteratedThom, B := Box.BoxThom].Inverse[].inverse Box.iteratedTopology Box.thomTopology Iteration.homeomorphism;
\definition homeomorphism: topology.Homeomorphism[A := Source.Thom, B := Box.IteratedThom].Homeomorphism[Source.thomTopology, Box.iteratedTopology] :=
  topology.Homeomorphism[A := Source.Thom, B := Box.BoxThom].Composition[C := Box.IteratedThom].compose Source.thomTopology Box.thomTopology Box.iteratedTopology Level.thomHomeomorphism inverse;
