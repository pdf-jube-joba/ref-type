\import Original.With[metric := metric] \as Source;
\definition squared[p: RealFamily.Point]: R.Real := Source.squared (Realified.backward p);
\definition continuous: metric_spaces.RealFunctions[A := RealFamily.Point].Continuous Realified.topology squared :=
  topology.Composition[A := RealFamily.Point, B := Family.Point, C := R.Real].composeContinuous Realified.topology bundle.totalSpace metric_spaces.RealLine[].topology Realified.backward Source.squared Realified.backwardContinuous Source.squaredContinuous;
\definition gauge: Gauges.Gauge := Gauges.Gauge {
  squared := squared, continuous := continuous,
  nonnegative := \fun (p: RealFamily.Point) => Source.nonnegative (Realified.backward p),
  zero := Source.zeroSquared,
  definite := \fun (p: RealFamily.Point)(atZero: _) => linear_algebra.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := linear_algebra.Hermitian[].Complex[].scalar].Inner[V := F p.base, space := bundle.space p.base].Of[h := metric.form p.base].squaredDefinite (metric.positive p.base) p.vector atZero,
  homogeneous := \fun (a: R.Real)(p: RealFamily.Point) => Source.squaredScale a (Realified.backward p)
};
