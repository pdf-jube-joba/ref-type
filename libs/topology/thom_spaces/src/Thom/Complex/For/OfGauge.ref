\definition squared[p: RealFamily.Point]: R.Real := data.squared (Realified.backward p);
\definition continuous: metric_spaces.RealFunctions[A := RealFamily.Point].Continuous Realified.topology squared :=
  topology.Composition[A := RealFamily.Point, B := Family.Point, C := R.Real].composeContinuous Realified.topology bundle.totalSpace metric_spaces.RealLine[].topology Realified.backward data.squared Realified.backwardContinuous data.continuous;
\definition gauge: Gauges.Gauge := Gauges.Gauge {
  squared := squared, continuous := continuous,
  nonnegative := \fun (p: RealFamily.Point) => data.nonnegative (Realified.backward p), zero := data.zero,
  definite := \fun (p: RealFamily.Point)(atZero: _) => data.definite (Realified.backward p) atZero,
  homogeneous := \fun (a: R.Real)(p: RealFamily.Point) => data.homogeneous a (Realified.backward p)
};
