\import Bundles.Family[X := X, F := (\fun (x: X) => Bundles.Vector n)] \as Family;
\import Original.With[metric := metric] \as Source;
\import Gauges.CompareGauges[left := Original.MetricGauge[metric := metric].data, right := Model.gauge] \as Radial;
\definition totalHomeomorphism: topology.Homeomorphism[A := Family.Point, B := Suspension.Point].Homeomorphism[Bundle.topology, Suspension.totalTopology] :=
  topology.Homeomorphism[A := Family.Point, B := Family.Point].Composition[C := Suspension.Point].compose Bundle.topology Bundle.topology Suspension.totalTopology Radial.totalHomeomorphism Model.homeomorphism;
\definition forwardSquared: \forall (p: Family.Point) -> Suspension.squared (totalHomeomorphism.forward p) = Source.squared p :=
  \fun (p: Family.Point) => trans!{R.Real} _ _ _ (Model.forwardSquared (Radial.totalHomeomorphism.forward p)) (Radial.forwardSquared p);
\definition backwardSquared: \forall (p: Suspension.Point) -> Source.squared (totalHomeomorphism.backward p) = Suspension.squared p :=
  \fun (p: Suspension.Point) => trans!{R.Real} _ _ _ (Radial.backwardSquared (Model.homeomorphism.backward p)) (Model.backwardSquared p);
\import \root.Thom[].Levels[A := Family.Point, B := Suspension.Point, source := Bundle.topology, target := Suspension.totalTopology, q := Source.squared, r := Suspension.squared,
  h := totalHomeomorphism, forwardSquared := forwardSquared, backwardSquared := backwardSquared] \as Level;
\definition homeomorphism: topology.Homeomorphism[A := Source.Thom, B := Suspension.Carrier].Homeomorphism[Source.thomTopology, Suspension.topology] := Level.thomHomeomorphism;
