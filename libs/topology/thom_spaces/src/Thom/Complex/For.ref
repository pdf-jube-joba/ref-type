\import Bundles.Family[X := X, F := F] \as Family;
\import Theory.For[X := X, F := F, bundle := bundle] \as Original;
\definition Metric: \Set := Original.Metric;
\import bundle_operations.Operations[].Scalars[].Realification[X := X, F := F, source := bundle] \as Realified;
\import vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].Family[X := X, F := F] \as RealFamily;
\import \root.Thom[].Quadratic[].Over[X := X, F := F, bundle := Realified.bundle] \as Gauges;
\module Gauge(metric: Metric);
\module Change(left, right: Metric);
\module OfGauge(data: Original.GaugeData);
\module CompareGauges(left, right: Original.GaugeData);
