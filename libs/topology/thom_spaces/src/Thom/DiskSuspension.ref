\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as D;
\import algebraic_topology.Euclidean[].Dimension[n := n] \as Euclidean;
\import topological_constructions.Product[A := X, B := Euclidean.Coordinate] \as Product;
\definition Point: \Set := Product.CarrierSet;
\definition totalTopology: topology.Topology[Carrier := Point].Topology := Product.topology space Euclidean.topology;
\definition squared[p: Point]: R.Real := Euclidean.normSquared (Pair.second X Euclidean.Coordinate p);
\definition disk: \Pow Point := { p: Point \where D.Le (squared p) R.one };
\import topology.Topology[Carrier := Point].Subspace[S := disk] \as Disk;
\definition DiskCarrier: \Set := Disk.CarrierSet;
\definition diskTopology: topology.Topology[Carrier := DiskCarrier].Topology := Disk.topology totalTopology;
\definition boundary: \Pow DiskCarrier := { p: DiskCarrier \where squared p = R.one };
\import \root.Thom[].Collapse[A := DiskCarrier, source := diskTopology, subset := boundary] \as Quotient;
\definition Carrier: \Set := Quotient.Carrier;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Quotient.topology;
\definition pointed: algebraic_topology.Pointed[A := Carrier].Space := Quotient.pointed;
\definition class: DiskCarrier -> Carrier := Quotient.class;
\module Step;
