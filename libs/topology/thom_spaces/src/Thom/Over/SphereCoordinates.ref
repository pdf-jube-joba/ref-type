\import Bundles.Family[X := X, F := F] \as Family;
\import \parent.For[X := X, F := F, bundle := bundle] \as Original;
\import vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as RealBundles;
\import RealBundles.Trivial[X := X, n := d, baseSpace := bundle.baseSpace] \as RealBundle;
\import RealBundles.Family[X := X, F := (\fun (x: X) => RealBundles.Vector d)] \as RealFamily;
\import \root.Thom[].CWType[].TrivialSphere[X := X, source := bundle.baseSpace, n := d] \as TrivialSphere;
\import \root.Thom[].Quadratic[].Over[X := X, F := (\fun (x: X) => RealBundles.Vector d), bundle := RealBundle.bundle] \as Quadratic;
\definition sourceZero[x: X]: RealFamily.Point := RealFamily.include x (RealBundles.coordinates d).zero;
\definition targetZero[x: X]: Family.Point := Family.include x (bundle.space x).zero;
\definition sourceScale[a: R.Real][p: RealFamily.Point]: RealFamily.Point := RealFamily.include p.base ((RealBundles.coordinates d).smul a p.vector);
\definition targetScale[a: R.Real][p: Family.Point]: Family.Point := Family.include p.base ((bundle.space p.base).smul (conjugation.embed a) p.vector);
\module With(data: Original.GaugeData,
  h: topology.Homeomorphism[A := RealFamily.Point, B := Family.Point].Homeomorphism[RealBundle.topology, bundle.totalSpace],
  overBase: \forall (p: RealFamily.Point) -> (h.forward p).base = p.base,
  zero: \forall (x: X) -> h.forward (sourceZero x) = targetZero x,
  scale: \forall (a: R.Real)(p: RealFamily.Point) -> h.forward (sourceScale a p) = targetScale a (h.forward p));
