\import R.Distance[] \as Distance;
\import Order.Order[] \as Ord;
\definition multiply: \forall (s: R.Real) -> Order.Le R.zero s -> \forall (a, b: R.Real) -> Distance.max (R.mul s a) (R.mul s b) = R.mul s (Distance.max a b) :=
  \fun (s: R.Real)(nonnegative: _)(a, b: R.Real) => either!{{Ord.leTotal a b} {Distance.max (R.mul s a) (R.mul s b) = R.mul s (Distance.max a b)}
    {\fun (ab: _) => trans!{R.Real} _ _ _ (Distance.maxOfLe (R.mul s a) (R.mul s b) (R.Estimates[].mulMonotone s a b nonnegative ab))
      (congr!{R.Real R.Real} (R.mul s) _ _ (sym!{R.Real} _ _ (Distance.maxOfLe a b ab)))}
    {\fun (ba: _) => trans!{R.Real} _ _ _ (Distance.maxOfGe (R.mul s a) (R.mul s b) (R.Estimates[].mulMonotone s b a nonnegative ba))
      (congr!{R.Real R.Real} (R.mul s) _ _ (sym!{R.Real} _ _ (Distance.maxOfGe a b ba)))}
  };
