\import \parent.With[metric := left] \as Left;
\import \parent.With[metric := right] \as Right;
\import \parent.NormalizeSphere[sourceMetric := left, targetMetric := right] \as Forward;
\import \parent.NormalizeSphere[sourceMetric := right, targetMetric := left] \as Backward;
\import Order.Arithmetic[].Prop[] \as Laws;
\module LeftInverse(p: Left.SphereBundle);
\module RightInverse(p: Right.SphereBundle);
\definition sphereHomeomorphism: topology.Homeomorphism[A := Left.SphereBundle, B := Right.SphereBundle].Homeomorphism[Left.sphereTopology, Right.sphereTopology] :=
  topology.Homeomorphism[A := Left.SphereBundle, B := Right.SphereBundle].Homeomorphism[Left.sphereTopology, Right.sphereTopology] {
    forward := Forward.apply, backward := Backward.apply,
    leftInverse := \fun (p: Left.SphereBundle) => LeftInverse[p := p].inverse,
    rightInverse := \fun (p: Right.SphereBundle) => RightInverse[p := p].inverse,
    forwardContinuous := Forward.continuous, backwardContinuous := Backward.continuous
  };
