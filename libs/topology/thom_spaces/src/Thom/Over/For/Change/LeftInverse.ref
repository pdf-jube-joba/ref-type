\definition a: R.Real := Backward.coefficient (Forward.apply p);
\definition b: R.Real := Forward.coefficient p;
\definition c: R.Real := R.mul a b;
\definition nonnegative: Order.Le R.zero c := Laws.fieldMulNonnegative a b
  (Order.Order[].leOfLt _ _ (Backward.coefficientPositive (Forward.apply p))) (Order.Order[].leOfLt _ _ (Forward.coefficientPositive p));
\definition composite: Family.Point := Backward.apply (Forward.apply p);
\definition formula: composite = Left.scale c p := Left.scaleCompose a b p;
\definition square: R.mul c c = R.one := eq_reason_in!{R.Real _
  "=" _ "by" { sym!{R.Real} _ _ (R.Algebra[].mulOneRight (R.mul c c)) }
  "=" _ "by" { congr!{R.Real R.Real} (R.mul (R.mul c c)) _ _ (sym!{R.Real} _ _ (\bysub(Family.Point, Left.UnitSphere, p))) }
  "=" _ "by" { sym!{R.Real} _ _ (Left.squaredScale c p) }
  "=" _ "by" { congr!{Family.Point R.Real} Left.squared _ _ (sym!{Family.Point} _ _ formula) }
  "=" R.one "by" { Backward.squaredOne (Forward.apply p) }
};
\definition one: c = R.one := R.SquareRoot[].squaresInjective c R.one nonnegative Laws.oneNonnegative
  (trans!{R.Real} _ _ _ square (sym!{R.Real} _ _ (R.Algebra[].mulOneRight R.one)));
\definition inverse: Backward.apply (Forward.apply p) = p := trans!{Family.Point} _ _ _ formula
  (trans!{Family.Point} _ _ _ (congr!{R.Real Family.Point} (\fun (s: R.Real) => Left.scale s p) _ _ one) (Left.scaleOne p));
