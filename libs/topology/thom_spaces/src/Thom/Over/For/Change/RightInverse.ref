\definition a: R.Real := Forward.coefficient (Backward.apply p);
\definition b: R.Real := Backward.coefficient p;
\definition c: R.Real := R.mul a b;
\definition nonnegative: Order.Le R.zero c := Laws.fieldMulNonnegative a b
  (Order.Order[].leOfLt _ _ (Forward.coefficientPositive (Backward.apply p))) (Order.Order[].leOfLt _ _ (Backward.coefficientPositive p));
\definition composite: Family.Point := Forward.apply (Backward.apply p);
\definition formula: composite = Right.scale c p := Right.scaleCompose a b p;
\definition square: R.mul c c = R.one := eq_reason_in!{R.Real _
  "=" _ "by" { sym!{R.Real} _ _ (R.Algebra[].mulOneRight (R.mul c c)) }
  "=" _ "by" { congr!{R.Real R.Real} (R.mul (R.mul c c)) _ _ (sym!{R.Real} _ _ (\bysub(Family.Point, Right.UnitSphere, p))) }
  "=" _ "by" { sym!{R.Real} _ _ (Right.squaredScale c p) }
  "=" _ "by" { congr!{Family.Point R.Real} Right.squared _ _ (sym!{Family.Point} _ _ formula) }
  "=" R.one "by" { Forward.squaredOne (Backward.apply p) }
};
\definition one: c = R.one := R.SquareRoot[].squaresInjective c R.one nonnegative Laws.oneNonnegative
  (trans!{R.Real} _ _ _ square (sym!{R.Real} _ _ (R.Algebra[].mulOneRight R.one)));
\definition inverse: Forward.apply (Backward.apply p) = p := trans!{Family.Point} _ _ _ formula
  (trans!{Family.Point} _ _ _ (congr!{R.Real Family.Point} (\fun (s: R.Real) => Right.scale s p) _ _ one) (Right.scaleOne p));
