\import Geometry.Inner[V := F x, space := bundle.space x].Of[h := metric.form x] \as Inner;
\definition dotScale: \forall (a: R.Real)(v: F x) ->
  (metric.form x).dot ((bundle.space x).smul (conjugation.embed a) v) ((bundle.space x).smul (conjugation.embed a) v) = conjugation.embed (R.mul (R.mul a a) (squared (Family.include x v))) :=
  \fun (a: R.Real)(v: F x) => eq_reason_in!{K _
      "=" _ "by" { Inner.scaleLeft (conjugation.embed a) v ((bundle.space x).smul (conjugation.embed a) v) }
      "=" _ "by" { congr!{K K K} field.mul _ _ _ _ (conjugation.conjugateReal a) ((metric.form x).scaleRight (conjugation.embed a) v v) }
      "=" _ "by" { congr!{K K} (\fun (b: K) => field.mul (conjugation.embed a) (field.mul (conjugation.embed a) b)) _ _ (Inner.selfReal v) }
      "=" _ "by" { sym!{K} _ _ (Spaces.mulAssoc (conjugation.embed a) (conjugation.embed a) (conjugation.embed (squared (Family.include x v)))) }
      "=" _ "by" { congr!{K K} (\fun (b: K) => field.mul b (conjugation.embed (squared (Family.include x v)))) _ _ (sym!{K} _ _ (conjugation.embedMul a a)) }
      "=" _ "by" { sym!{K} _ _ (conjugation.embedMul (R.mul a a) (squared (Family.include x v))) }
    };
