\definition MidSubset: \Pow DiskBundle := { p: DiskBundle \where Logic.Or[\In[DiskBundle] (Subset k family) p,
  Logic.And[\In[DiskBundle] (Subset k (Lists.List[CW.CellData]::cons cell family)) p, squared p = R.one]] };
\import topology.Topology[Carrier := DiskBundle].Subspace[S := MidSubset] \as Subspace;
\definition Carrier: \Set := Subspace.CarrierSet;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Subspace.topology diskTopology;
\definition inclusion[p: Carrier]: DiskBundle := p;
\definition continuous: topology.Continuity[A := Carrier, B := DiskBundle].Continuous topology diskTopology inclusion := topology.Continuity[A := Carrier, B := DiskBundle].Corestriction[S := MidSubset].inclusionContinuous diskTopology;
\definition hausdorff: topology.Topology[Carrier := Carrier].IsT2 topology := Subspace.Properties[].hausdorff diskTopology diskHausdorff;
\definition UnitSubset: \Pow Carrier := { p: Carrier \where squared p = R.one };
\definition Property: \Prop := \root.Thom[].CWType[].CompactPairType[A := Carrier, source := topology, subset := UnitSubset].Property;
\definition original[p: Previous.Carrier]: Carrier := \into[DiskBundle](p, MidSubset) \by { Logic.Or[_, _]::left (\bysub(DiskBundle, Subset k family, p)) };
\definition originalContinuous: topology.Continuity[A := Previous.Carrier, B := Carrier].Continuous Previous.topology topology original := topology.Continuity[A := Previous.Carrier, B := DiskBundle].Corestriction[S := MidSubset].corestrictContinuous Previous.topology diskTopology original Previous.continuous;
\definition toNext[p: Carrier]: Next.Carrier := \into[DiskBundle](p, Subset k (Lists.List[CW.CellData]::cons cell family)) \by {
  either!{{\bysub(DiskBundle, MidSubset, p)} {\In[DiskBundle] (Subset k (Lists.List[CW.CellData]::cons cell family)) p}
    {\fun (old: _) => includePrevious p old}
    {\fun (new: Logic.And[\In[DiskBundle] (Subset k (Lists.List[CW.CellData]::cons cell family)) p, squared p = R.one]) => new.left}
  }
};
\definition toNextContinuous: topology.Continuity[A := Carrier, B := Next.Carrier].Continuous topology Next.topology toNext := topology.Continuity[A := Carrier, B := DiskBundle].Corestriction[S := Subset k (Lists.List[CW.CellData]::cons cell family)].corestrictContinuous topology diskTopology toNext continuous;
\definition originalContained: \forall (p: \Cast[Previous.Carrier] Previous.UnitSubset) -> \In[Carrier] UnitSubset (original p) := \fun (p: \Cast[Previous.Carrier] Previous.UnitSubset) => \bysub(Previous.Carrier, Previous.UnitSubset, p);
\definition originalReflects: \forall (p: Previous.Carrier) -> \In[Carrier] UnitSubset (original p) -> \In[Previous.Carrier] Previous.UnitSubset p := \fun (p: Previous.Carrier)(unit: _) => unit;

\definition asSphere[p: Carrier][unit: squared p = R.one]: SphereBundle := \into[Family.Point](p, UnitSphere) \by { unit };
\module Zero(chart: Charts.Chart[N.Nat^::zero]);
\module Positive(r: N.Nat^, chart: Charts.Chart[N.Nat^::succ r]);
\definition Theorem[n: N.Nat^]: \Prop := \forall (chart: Charts.Chart[n]) -> Previous.Property -> Property;
\definition theorem: \forall (n: N.Nat^) -> Theorem n := \induction (n: N.Nat^) \return Theorem n \with {
  | zero: \fun (chart: _) => Zero[chart := chart].property
  | succ: \fun (r: N.Nat^)(previous: Theorem r)(chart: _) => Positive[r := r, chart := chart].property
};
