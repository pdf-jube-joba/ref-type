\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := DiskBundle] \as Cylinder;
\definition radius[x: DiskBundle]: I.Carrier := \into[Real.Real](norm x, metric_spaces.RealLine[].ClosedInterval Real.zero Real.one) \by {
  Logic.And[_, _]::# (normNonnegative x) (diskNorm x)
};
\module At(t: I.Carrier, x: DiskBundle);
\definition time[p: Cylinder.Carrier]: I.Carrier := At[t := Cylinder.time p, x := Cylinder.point p].time;
\definition point[p: Cylinder.Carrier]: DiskBundle := At[t := Cylinder.time p, x := Cylinder.point p].point;
\definition family[p: Cylinder.Carrier]: Cylinder.Carrier := Cylinder.at (time p) (point p);
\module Continuity;
