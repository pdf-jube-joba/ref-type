\import singular_cohomology.Relative[A := Extended, source := source, subset := Quotient.Boundary].Homology[z := z] \as Relative;
\import singular_cohomology.Chains[A := Thom, source := thomTopology].Reduced[].At[z := z] \as Reduced;
\import singular_excision.GoodPair[A := Extended, source := source, subset := Quotient.Boundary].On[pair := goodPair].Homology[z := z] \as Comparison;
\definition isomorphism: Modules.Isomorphism[V := Relative.Carrier, W := Reduced.Carrier, source := Relative.space, target := Reduced.space].Isomorphism := Comparison.isomorphism;
\import singular_cohomology.Relative[A := DiskBundle, source := diskTopology, subset := Boundary].Homology[z := z] \as Ordinary;
\definition ordinaryIsomorphism: Modules.Isomorphism[V := Ordinary.Carrier, W := Reduced.Carrier, source := Ordinary.space, target := Reduced.space].Isomorphism :=
  Modules.Isomorphism[V := Ordinary.Carrier, W := Relative.Carrier, source := Ordinary.space, target := Relative.space].Composition[U := Reduced.Carrier, final := Reduced.space].compose
    isomorphism (Quotient.Relative[].Homology[z := z].isomorphism);
