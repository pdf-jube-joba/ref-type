\import \root.Thom[].CWType[].Point[] \as Point;
\import Pullback.Universal[Z := Point.Carrier] \as Lift;
\definition cone: Lift.Cone := Lift.Cone {
  base := \fun (z: Point.Carrier) => x,
  total := \fun (z: Point.Carrier) => p,
  commutes := \fun (z: Point.Carrier) => same
};
\definition lifted: PulledFamily.Point := Lift.lift cone Point.point;
\definition point: Normalized.UnitCarrier := \into[PulledFamily.Point](lifted, Normalized.UnitSubset) \by {
  trans!{R.Real} _ _ _ (congr!{Family.Point R.Real} squared _ _ (Lift.mapFormula cone Point.point)) (\bysub(Family.Point, UnitSphere, p))
};
\definition inverse: SphereProduct.CarrierSet := Normalized.homeomorphism.backward point;
\definition base: Pair.first BaseDisk.Disk Euclidean.Sphere inverse = x := Normalized.backwardBase point;
\definition vector: Euclidean.Sphere := Pair.second BaseDisk.Disk Euclidean.Sphere inverse;
\definition pair: Pair.pair BaseDisk.Disk Euclidean.Sphere x vector = inverse := trans!{SphereProduct.CarrierSet} _ _ _
  (congr!{BaseDisk.Disk Euclidean.Sphere SphereProduct.CarrierSet} (Pair.pair BaseDisk.Disk Euclidean.Sphere) x (Pair.first BaseDisk.Disk Euclidean.Sphere inverse) vector vector (sym!{BaseDisk.Disk} _ _ base) (\refl(vector)))
  (Pair.Prop[A := BaseDisk.Disk, B := Euclidean.Sphere].eta inverse);
\definition exists: \exists (u: Euclidean.Sphere \where chart (Pair.pair BaseDisk.Disk Euclidean.Sphere x u) = p) := Logic.existsIntro[Euclidean.Sphere,
  { u: Euclidean.Sphere \where chart (Pair.pair BaseDisk.Disk Euclidean.Sphere x u) = p }] vector (eq_reason_in!{Family.Point _
    "=" _ "by" { congr!{SphereProduct.CarrierSet SphereBundle} chart _ _ pair }
    "=" _ "by" { congr!{Normalized.UnitCarrier Family.Point} (\fun (q: Normalized.UnitCarrier) => Pullback.map q) _ _ (normalizedLaws.rightInverse point) }
    "=" _ "by" { Lift.mapFormula cone Point.point }
  });
