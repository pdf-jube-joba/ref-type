\definition homeomorphism: topology.Homeomorphism[A := Model.Carrier, B := DiskBundle].Homeomorphism[Model.topology, diskTopology] :=
  \root.Thom[].CWType[].CompactBijection[A := Model.Carrier, B := DiskBundle, source := Model.topology, target := diskTopology,
    compact := Model.compact sphereCompact baseCompact, hausdorff := diskHausdorff, f := toDisk,
    injective := injective, onto := onto, continuous := toDiskContinuous].homeomorphism;
\definition boundary: \forall (u: SphereBundle) -> homeomorphism.forward (Model.top u) = sphereInclusion u := toDiskTop;
