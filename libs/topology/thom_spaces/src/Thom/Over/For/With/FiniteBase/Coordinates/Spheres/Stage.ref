\import topology.Topology[Carrier := SphereBundle].Subspace[S := Subset k family] \as Subspace;
\definition Carrier: \Set := Subspace.CarrierSet;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Subspace.topology sphereTopology;
\definition inclusion[p: Carrier]: SphereBundle := p;
\definition continuous: topology.Continuity[A := Carrier, B := SphereBundle].Continuous topology sphereTopology inclusion :=
  topology.Continuity[A := Carrier, B := SphereBundle].Corestriction[S := Subset k family].inclusionContinuous sphereTopology;
\definition hausdorff: topology.Topology[Carrier := Carrier].IsT2 topology := Subspace.Properties[].hausdorff sphereTopology sphereHausdorff;
\definition Property: \Prop := \root.Thom[].CWType[].CompactType[A := Carrier, source := topology].Property;
