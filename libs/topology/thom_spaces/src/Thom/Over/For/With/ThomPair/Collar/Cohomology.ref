\import singular_cohomology.Relative[A := Extended, source := source, subset := Quotient.Boundary].With[coefficients := coefficients].At[z := z] \as Relative;
\import singular_cohomology.Chains[A := Thom, source := thomTopology].Reduced[].With[coefficients := coefficients].At[z := z] \as Reduced;
\import singular_excision.GoodPair[A := Extended, source := source, subset := Quotient.Boundary].On[pair := goodPair].With[coefficients := coefficients].At[z := z] \as Comparison;
\definition isomorphism: Modules.Isomorphism[V := Reduced.Carrier, W := Relative.Carrier, source := Reduced.space, target := Relative.space].Isomorphism := Comparison.isomorphism;
\import singular_cohomology.Relative[A := DiskBundle, source := diskTopology, subset := Boundary].With[coefficients := coefficients].At[z := z] \as Ordinary;
\definition ordinaryIsomorphism: Modules.Isomorphism[V := Reduced.Carrier, W := Ordinary.Carrier, source := Reduced.space, target := Ordinary.space].Isomorphism :=
  Modules.Isomorphism[V := Reduced.Carrier, W := Relative.Carrier, source := Reduced.space, target := Relative.space].Composition[U := Ordinary.Carrier, final := Ordinary.space].compose
    (Quotient.Relative[].Cohomology[coefficients := coefficients, z := z].isomorphism) isomorphism;
