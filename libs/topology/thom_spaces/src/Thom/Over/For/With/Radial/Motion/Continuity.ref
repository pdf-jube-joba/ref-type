\import metric_spaces.RealLine[] \as Line;
\import metric_spaces.RealFunctions[A := Cylinder.Carrier] \as Functions;
\import Functions.Product[] \as Product;
\import Functions.Reciprocal[] \as Reciprocal;
\import Functions.Lattice[] \as Lattice;
\definition source: topology.Topology[Carrier := Cylinder.Carrier].Topology := Cylinder.topology diskTopology;
\import topology.Continuity[A := DiskBundle, B := Family.Point].Corestriction[S := ClosedBall] \as Inclusion;
\definition originalPoint: topology.Continuity[A := Cylinder.Carrier, B := Family.Point].Continuous source bundle.totalSpace (\fun (p: Cylinder.Carrier) => Cylinder.point p) :=
  topology.Composition[A := Cylinder.Carrier, B := DiskBundle, C := Family.Point].composeContinuous source diskTopology bundle.totalSpace Cylinder.point (\fun (x: DiskBundle) => x)
    (Cylinder.pointContinuous diskTopology) (Inclusion.inclusionContinuous bundle.totalSpace);
\definition originalTime: Functions.Continuous source (\fun (p: Cylinder.Carrier) => Cylinder.time p) :=
  topology.Composition[A := Cylinder.Carrier, B := I.Carrier, C := Real.Real].composeContinuous source I.topology Line.topology Cylinder.time (\fun (t: I.Carrier) => t)
    (Cylinder.timeContinuous diskTopology) I.inclusionContinuous;
\definition radiusContinuous: Functions.Continuous source (\fun (p: Cylinder.Carrier) => radius (Cylinder.point p)) :=
  topology.Composition[A := Cylinder.Carrier, B := Family.Point, C := Real.Real].composeContinuous source bundle.totalSpace Line.topology (\fun (p: Cylinder.Carrier) => Cylinder.point p)
    norm originalPoint normContinuous;
\definition lower[p: Cylinder.Carrier]: Real.Real := puppe_sequences.Puppe[].Radial[t := Cylinder.time p, r := radius (Cylinder.point p)].lower;
\definition denominator[p: Cylinder.Carrier]: Real.Real := puppe_sequences.Puppe[].Radial[t := Cylinder.time p, r := radius (Cylinder.point p)].denominator;
\definition coefficient[p: Cylinder.Carrier]: Real.Real := puppe_sequences.Puppe[].Radial[t := Cylinder.time p, r := radius (Cylinder.point p)].coefficient;
\definition quotient[p: Cylinder.Carrier]: Real.Real := puppe_sequences.Puppe[].Radial[t := Cylinder.time p, r := radius (Cylinder.point p)].quotient;
\definition lowerContinuous: Functions.Continuous source lower := Functions.subContinuous source (\fun (_: Cylinder.Carrier) => Real.one)
  (\fun (p: Cylinder.Carrier) => Real.mul Real.half (Cylinder.time p)) (Functions.constantContinuous source Real.one)
  (Product.continuous source (\fun (_: Cylinder.Carrier) => Real.half) (\fun (p: Cylinder.Carrier) => Cylinder.time p)
    (Functions.constantContinuous source Real.half) originalTime);
\definition denominatorContinuous: Functions.Continuous source denominator := Lattice.maximumContinuous source lower (\fun (p: Cylinder.Carrier) => radius (Cylinder.point p)) lowerContinuous radiusContinuous;
\definition coefficientContinuous: Functions.Continuous source coefficient := Reciprocal.continuousPositive source denominator denominatorContinuous
  (\fun (p: Cylinder.Carrier) => puppe_sequences.Puppe[].Radial[t := Cylinder.time p, r := radius (Cylinder.point p)].denominatorPositive);
\definition quotientContinuous: Functions.Continuous source quotient := Product.continuous source coefficient lower coefficientContinuous lowerContinuous;
\definition reverseContinuous: Functions.Continuous source (\fun (p: Cylinder.Carrier) => Real.sub Real.one (quotient p)) :=
  Functions.subContinuous source (\fun (_: Cylinder.Carrier) => Real.one) quotient (Functions.constantContinuous source Real.one) quotientContinuous;
\definition timeContinuous: topology.Continuity[A := Cylinder.Carrier, B := I.Carrier].Continuous source I.topology time :=
  topology.Continuity[A := Cylinder.Carrier, B := Real.Real].Corestriction[S := Line.ClosedInterval Real.zero Real.one].corestrictContinuous source Line.topology time
    (Functions.sumContinuous source (\fun (p: Cylinder.Carrier) => Real.sub Real.one (quotient p)) (\fun (p: Cylinder.Carrier) => Real.sub Real.one (quotient p)) reverseContinuous reverseContinuous);
\import Operations.Along[X := X, F := F, bundle := bundle, Y := Cylinder.Carrier, source := source, base := (\fun (p: Cylinder.Carrier) => (Cylinder.point p).base)] \as Along;
\definition originalVectorContinuous: Along.Continuous (\fun (p: Cylinder.Carrier) => (Cylinder.point p).vector) :=
  topology.Composition[A := Cylinder.Carrier, B := Family.Point, C := Family.Point].composeContinuous source bundle.totalSpace bundle.totalSpace
    (\fun (p: Cylinder.Carrier) => Cylinder.point p) (\fun (p: Family.Point) => Family.include p.base p.vector) originalPoint reconstructedContinuous;
\definition originalBaseContinuous: Along.BaseContinuous :=
  topology.Composition[A := Cylinder.Carrier, B := Family.Point, C := X].composeContinuous source bundle.totalSpace bundle.baseSpace
    (\fun (p: Cylinder.Carrier) => Cylinder.point p) Family.projection originalPoint Family.Of[bundle := bundle].projectionContinuous;
\definition embeddedCoefficientContinuous: topology.Continuity[A := Cylinder.Carrier, B := K].Continuous source scalar.topological.space (\fun (p: Cylinder.Carrier) => conjugation.embed (coefficient p)) :=
  hermitian_frames.Hermitian[].Over[K := K, field := field, scalar := conjugation, topological := scalar.topological].Functions[X := Cylinder.Carrier].embedding source coefficient coefficientContinuous;
\definition pointContinuous: topology.Continuity[A := Cylinder.Carrier, B := DiskBundle].Continuous source diskTopology point :=
  topology.Continuity[A := Cylinder.Carrier, B := Family.Point].Corestriction[S := ClosedBall].corestrictContinuous source bundle.totalSpace point
    (Along.scaling (\fun (p: Cylinder.Carrier) => conjugation.embed (coefficient p)) (\fun (p: Cylinder.Carrier) => (Cylinder.point p).vector)
      originalBaseContinuous embeddedCoefficientContinuous originalVectorContinuous);
\definition continuous: topology.Continuity[A := Cylinder.Carrier, B := Cylinder.Carrier].Continuous source source family :=
  topological_constructions.Product[A := I.Carrier, B := DiskBundle].Universal[X := Cylinder.Carrier].pairContinuous source I.topology diskTopology time point timeContinuous pointContinuous;
