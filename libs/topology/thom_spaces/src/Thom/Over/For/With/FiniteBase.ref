\import algebraic_topology.CW[A := X] \as CW;
\structure DiskType: \Set := {
  model: CW.FiniteComplex[bundle.baseSpace],
  equivalence: algebraic_topology.HomotopyEquivalence[A := DiskBundle, B := X].Equivalence[diskTopology, bundle.baseSpace]
};
\definition diskType: DiskType := DiskType { model := complex, equivalence := \parent.Contraction[].equivalence };
\module Cell(cell: CW.CellData, member: CW.CellMember complex.cells cell);
