\import puppe_sequences.Puppe[].Radial[t := t, r := radius x] \as Parameters;
\definition time: I.Carrier := Parameters.time;
\definition point: DiskBundle := \into[Family.Point](scale Parameters.coefficient x, ClosedBall) \by {
  rescaleDisk Parameters.denominator Parameters.denominatorPositive x (Real.Distance[].maxRight Parameters.lower (radius x))
};
\definition boundaryRadius: squared x = Real.one -> radius x = I.end := \fun (onSphere: squared x = Real.one) =>
  trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} Root.sqrt _ _ onSphere) Root.sqrtOne;
\definition fixesPoint: Parameters.coefficient = Real.one -> point = x := \fun (one: Parameters.coefficient = Real.one) =>
  trans!{Family.Point} _ _ _
    (congr!{{F x.base} Family.Point} (Family.include x.base) _ _
      (trans!{{F x.base}} _ _ _
        (congr!{K {F x.base}} (\fun (a: K) => (bundle.space x.base).smul a x.vector) _ _
          (trans!{K} _ _ _ (congr!{Real.Real K} conjugation.embed _ _ one) conjugation.embedOne))
        ((bundle.space x.base).scalarOne x.vector))) (Family.eta x);
\definition startPoint: t = I.start -> point = x := \fun (atStart: t = I.start) => fixesPoint (Parameters.Endpoints[].startCoefficient atStart);
\definition startTime: t = I.start -> time = I.start := Parameters.Endpoints[].startTime;
\definition boundaryPoint: squared x = Real.one -> point = x := \fun (onSphere: squared x = Real.one) => fixesPoint (Parameters.Endpoints[].boundaryCoefficient (boundaryRadius onSphere));
\definition boundaryTime: squared x = Real.one -> time = t := \fun (onSphere: squared x = Real.one) => Parameters.Endpoints[].boundaryTime (boundaryRadius onSphere);
\definition side: Parameters.denominator = radius x -> squared point = Real.one := \fun (same: Parameters.denominator = radius x) => \block {
  \let unit: Real.mul Parameters.coefficient (radius x) = Real.one := trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real} (Real.mul Parameters.coefficient) _ _ (sym!{Real.Real} _ _ same))
    (Laws.fieldInverseNonzero Parameters.denominator Parameters.denominatorNonzero) \then
  \return trans!{Real.Real} _ _ _ (scaledSquared Parameters.coefficient x)
    (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real Real.Real} Real.mul _ _ _ _ unit unit) (Algebra.mulOneRight Real.one))
};
\use Logic.either;
\definition covered: Logic.Or[time = I.start, squared point = Real.one] := either!{{Parameters.Endpoints[].alternatives} {Logic.Or[time = I.start, squared point = Real.one]}
  {\fun (same: Parameters.denominator = Parameters.lower) => Logic.Or[_, _]::left (Parameters.bottom same)}
  {\fun (same: Parameters.denominator = radius x) => Logic.Or[_, _]::right (side same)}};
