\import \root.Thom[].CWType[].PairFiniteType[A := DiskBundle, source := diskTopology, subset := Boundary] \as Models;
\definition data: Models.Details[model.Carrier] := Models.details model;
\definition nativeSubset: \Pow model.Carrier := algebraic_topology.CW[A := model.Carrier].Pair[source := data.space, complex := data.complex].Of[subcomplex := data.part].Subset;
\definition comparison: \root.Thom[].CWType[].PairTools[A := DiskBundle, B := model.Carrier, source := diskTopology, target := data.space, subset := Boundary, targetSubset := nativeSubset].Data := data.equivalence;
\import singular_cohomology.Relative[A := DiskBundle, source := diskTopology, subset := Boundary].Equivalence[B := model.Carrier].Over[target := data.space, targetSubset := nativeSubset] \as Relative;
\definition relativeEquivalence: Relative.Equivalence := \root.Thom[].CWType[].PairTools[A := DiskBundle, B := model.Carrier, source := diskTopology, target := data.space, subset := Boundary, targetSubset := nativeSubset].Relative[e := comparison].equivalence;
\import Relative.On[e := relativeEquivalence] \as Singular;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Coefficients;
\module Homology(z: I.Int^) {
  \definition isomorphism: _ := Singular.Homology[z := z].isomorphism;
}
\module Cohomology(coefficients: Coefficients.Bundle, z: I.Int^) {
  \definition isomorphism: _ := Singular.With[coefficients := coefficients].At[z := z].isomorphism;
}
