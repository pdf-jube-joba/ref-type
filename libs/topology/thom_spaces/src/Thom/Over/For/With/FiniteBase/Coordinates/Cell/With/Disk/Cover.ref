\import \root.Thom[].CWType[].Point[] \as Point;
\import Pullback.Universal[Z := Point.Carrier] \as Lift;
\definition cone: Lift.Cone := Lift.Cone {
  base := \fun (z: Point.Carrier) => x,
  total := \fun (z: Point.Carrier) => p,
  commutes := \fun (z: Point.Carrier) => same
};
\definition lifted: PulledFamily.Point := Lift.lift cone Point.point;
\definition point: NormalDisk.ClosedCarrier := \into[PulledFamily.Point](lifted, NormalDisk.ClosedSubset) \by {
  dedekind_reals.DedekindReal[].leReplaceLeft (squared p) (squared (Pullback.map lifted)) R.one
    (sym!{R.Real} _ _ (congr!{Family.Point R.Real} squared _ _ (Lift.mapFormula cone Point.point))) (\bysub(Family.Point, ClosedBall, p))
};
\definition inverse: DiskProduct.CarrierSet := NormalDisk.homeomorphism.backward point;
\definition base: Pair.first BaseDisk.Disk Euclidean.Disk inverse = x := NormalDisk.backwardBase point;
\definition vector: Euclidean.Disk := Pair.second BaseDisk.Disk Euclidean.Disk inverse;
\definition pair: Pair.pair BaseDisk.Disk Euclidean.Disk x vector = inverse := trans!{DiskProduct.CarrierSet} _ _ _
  (congr!{BaseDisk.Disk Euclidean.Disk DiskProduct.CarrierSet} (Pair.pair BaseDisk.Disk Euclidean.Disk) x (Pair.first BaseDisk.Disk Euclidean.Disk inverse) vector vector (sym!{BaseDisk.Disk} _ _ base) (\refl(vector)))
  (Pair.Prop[A := BaseDisk.Disk, B := Euclidean.Disk].eta inverse);
\definition exists: \exists (u: Euclidean.Disk \where map (Pair.pair BaseDisk.Disk Euclidean.Disk x u) = p) := Logic.existsIntro[Euclidean.Disk,
  { u: Euclidean.Disk \where map (Pair.pair BaseDisk.Disk Euclidean.Disk x u) = p }] vector (eq_reason_in!{Family.Point _
    "=" _ "by" { congr!{DiskProduct.CarrierSet DiskBundle} map _ _ pair }
    "=" _ "by" { congr!{NormalDisk.ClosedCarrier Family.Point} (\fun (q: NormalDisk.ClosedCarrier) => Pullback.map q) _ _ (normalizedLaws.rightInverse point) }
    "=" _ "by" { Lift.mapFormula cone Point.point }
  });
