\import algebraic_topology.Euclidean[].Dimension[n := cell.dimension] \as Euclidean;
\definition regular: topology.Continuity[A := Euclidean.Disk, B := X].Continuous Euclidean.diskTopology bundle.baseSpace cell.characteristic := ((CW.laws bundle.baseSpace complex).cellLaws cell member).continuous;
\import Family.Of[bundle := bundle].Pullback[Y := Euclidean.Disk, source := Euclidean.diskTopology, f := cell.characteristic] \as Pullback;
\definition pullback: Bundles.Family[X := Euclidean.Disk, F := (\fun (p: Euclidean.Disk) => F (cell.characteristic p))].Bundle := Pullback.pulled regular;
\import bundle_homotopy.Homotopy[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar].Disks[d := cell.dimension].Triviality[
  F := (\fun (p: Euclidean.Disk) => F (cell.characteristic p)), bundle := pullback, sameBase := \refl(Euclidean.diskTopology)] \as Triviality;
\definition triviality: \exists Triviality.Result := Triviality.exists;
