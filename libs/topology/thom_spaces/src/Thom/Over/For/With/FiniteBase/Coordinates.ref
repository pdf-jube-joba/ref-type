\import topology.Topology[Carrier := X] \as Base;
\import singular_cellular.On[A := X, source := bundle.baseSpace, complex := complex] \as Native;
\import Native.Filtration[] \as Filtration;
\definition height: N.Nat^ := Filtration.Exhaustion[].height complex.cells;
\definition baseCompact: Base.IsCompact bundle.baseSpace := \idelim Filtration.subset height = Base.Whole \with S: \Pow X => Base.IsCompactIn bundle.baseSpace S \by {
  base: Filtration.Compactness[limit := height].compactIn, equality: Filtration.Exhaustion[].full
};
\definition baseHausdorff: Base.IsT2 bundle.baseSpace := (CW.laws bundle.baseSpace complex).hausdorff;
\module WithEmbedding(embedding: Metrics.Embedding);
\definition totalHausdorff: topology.Topology[Carrier := Family.Point].IsT2 bundle.totalSpace := \block {
  \takefrom embedding: Metrics.Embedding \by Metrics.embeddingExists baseCompact baseHausdorff \then
  \return WithEmbedding[embedding := embedding].hausdorff
};
\definition sphereHausdorff: topology.Topology[Carrier := SphereBundle].IsT2 sphereTopology := topology.Topology[Carrier := Family.Point].Subspace[S := UnitSphere].Properties[].hausdorff bundle.totalSpace totalHausdorff;
\definition diskHausdorff: topology.Topology[Carrier := DiskBundle].IsT2 diskTopology := topology.Topology[Carrier := Family.Point].Subspace[S := ClosedBall].Properties[].hausdorff bundle.totalSpace totalHausdorff;
\module Cell(cell: CW.CellData, member: CW.CellMember complex.cells cell);
