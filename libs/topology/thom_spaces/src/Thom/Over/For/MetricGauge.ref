\import \parent.With[metric := metric] \as Source;
\definition data: GaugeData := GaugeData {
  squared := Source.squared, continuous := Source.squaredContinuous, nonnegative := Source.nonnegative, zero := Source.zeroSquared,
  definite := \fun (p: Family.Point)(atZero: _) => Geometry.Inner[V := F p.base, space := bundle.space p.base].Of[h := metric.form p.base].squaredDefinite (metric.positive p.base) p.vector atZero,
  homogeneous := Source.squaredScale
};
