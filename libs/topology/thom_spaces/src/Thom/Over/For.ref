\import Bundles.Family[X := X, F := F] \as Family;
\import Complements.For[X := X, F := F, bundle := bundle] \as Metrics;
\definition Metric: \Set := Metrics.Metric;
\module With(metric: Metric);
\module NormalizeSphere(sourceMetric, targetMetric: Metric);
\module Change(left, right: Metric);
\structure GaugeData: \Set := {
  squared: Family.Point -> R.Real,
  continuous: metric_spaces.RealFunctions[A := Family.Point].Continuous bundle.totalSpace squared,
  nonnegative: \forall (p: Family.Point) -> Order.Le R.zero (squared p),
  zero: \forall (x: X) -> squared (Family.include x (bundle.space x).zero) = R.zero,
  definite: \forall (p: Family.Point) -> squared p = R.zero -> p.vector = (bundle.space p.base).zero,
  homogeneous: \forall (a: R.Real)(p: Family.Point) -> squared (Family.include p.base ((bundle.space p.base).smul (conjugation.embed a) p.vector)) = R.mul (R.mul a a) (squared p)
};
\module MetricGauge(metric: Metric);
