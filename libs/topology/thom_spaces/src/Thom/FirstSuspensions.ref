\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition two: N.Nat^ := N.Nat^::succ one;
\import \root.Thom[].Adjoin[A := X, source := source] \as Plus;
\import \root.Thom[].DiskSuspension[X := X, space := source, n := N.Nat^::zero] \as ZeroDisk;
\import \root.Thom[].DiskSuspension[X := X, space := source, n := one] \as OneDisk;
\import \root.Thom[].DiskSuspension[X := X, space := source, n := two] \as TwoDisk;
\import \root.Thom[].ZeroDiskSuspension[X := X, source := source] \as Zero;
\import ZeroDisk.Step[].Cylinder[] \as OneStep;
\import OneDisk.Step[].Cylinder[] \as TwoStep;
\import \root.Thom[].SuspendHomeomorphism[A := ZeroDisk.Carrier, B := Plus.Carrier, source := ZeroDisk.pointed, target := Plus.pointed,
  h := Zero.homeomorphism, pointed := Zero.preservesPoint] \as OneComparison;
\import puppe_sequences.Puppe[].Suspension[A := ZeroDisk.Carrier, source := ZeroDisk.pointed] \as SuspendedZero;
\import puppe_sequences.Puppe[].Suspension[A := Plus.Carrier, source := Plus.pointed] \as Once;
\definition once: topology.Homeomorphism[A := OneDisk.Carrier, B := Once.Carrier].Homeomorphism[OneDisk.topology, Once.topology] :=
  topology.Homeomorphism[A := OneDisk.Carrier, B := SuspendedZero.Carrier].Composition[C := Once.Carrier].compose OneDisk.topology SuspendedZero.topology Once.topology
    OneStep.suspensionHomeomorphism OneComparison.homeomorphism;
\definition oncePointed: once.forward OneDisk.pointed.basepoint = Once.point :=
  trans!{Once.Carrier} _ _ _ (congr!{SuspendedZero.Carrier Once.Carrier} OneComparison.homeomorphism.forward _ _ OneStep.suspensionPointed) OneComparison.preservesPoint;
\import \root.Thom[].SuspendHomeomorphism[A := OneDisk.Carrier, B := Once.Carrier, source := OneDisk.pointed, target := Once.pointed,
  h := once, pointed := oncePointed] \as TwoComparison;
\import puppe_sequences.Puppe[].Suspension[A := OneDisk.Carrier, source := OneDisk.pointed] \as SuspendedOne;
\import puppe_sequences.Puppe[].Suspension[A := Once.Carrier, source := Once.pointed] \as Twice;
\definition twice: topology.Homeomorphism[A := TwoDisk.Carrier, B := Twice.Carrier].Homeomorphism[TwoDisk.topology, Twice.topology] :=
  topology.Homeomorphism[A := TwoDisk.Carrier, B := SuspendedOne.Carrier].Composition[C := Twice.Carrier].compose TwoDisk.topology SuspendedOne.topology Twice.topology
    TwoStep.suspensionHomeomorphism TwoComparison.homeomorphism;
\definition twicePointed: twice.forward TwoDisk.pointed.basepoint = Twice.point :=
  trans!{Twice.Carrier} _ _ _ (congr!{SuspendedOne.Carrier Twice.Carrier} TwoComparison.homeomorphism.forward _ _ TwoStep.suspensionPointed) TwoComparison.preservesPoint;
