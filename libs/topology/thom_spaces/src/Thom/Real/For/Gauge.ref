\import Original.With[metric := metric] \as Source;
\definition gauge: Gauges.Gauge := Gauges.Gauge {
  squared := Source.squared, continuous := Source.squaredContinuous, nonnegative := Source.nonnegative, zero := Source.zeroSquared,
  definite := \fun (p: Family.Point)(atZero: _) => linear_algebra.Hermitian[].Over[K := R.Real, field := R.Algebra[].field, scalar := linear_algebra.Hermitian[].Real[].scalar].Inner[V := F p.base, space := bundle.space p.base].Of[h := metric.form p.base].squaredDefinite (metric.positive p.base) p.vector atZero,
  homogeneous := Source.squaredScale
};
