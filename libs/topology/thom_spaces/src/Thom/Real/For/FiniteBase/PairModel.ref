
\import Construction.PairModel[model := model] \as Model;
\definition data: _ := Model.data;
\definition nativeSubset: \Pow model.Carrier := Model.nativeSubset;
\definition comparison: _ := Model.comparison;
\definition relativeEquivalence: _ := Model.relativeEquivalence;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Coefficients;
\module Homology(z: I.Int^) {
  \definition isomorphism: _ := Model.Homology[z := z].isomorphism;
}
\module Cohomology(coefficients: Coefficients.Bundle, z: I.Int^) {
  \definition isomorphism: _ := Model.Cohomology[coefficients := coefficients, z := z].isomorphism;
}
