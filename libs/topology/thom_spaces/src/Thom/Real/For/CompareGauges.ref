\import \parent.OfGauge[data := left] \as LeftGauge;
\import \parent.OfGauge[data := right] \as RightGauge;
\import Gauges.Change[left := LeftGauge.gauge, right := RightGauge.gauge] \as Comparison;
\definition totalHomeomorphism: topology.Homeomorphism[A := Family.Point, B := Family.Point].Homeomorphism[bundle.totalSpace, bundle.totalSpace] := Comparison.homeomorphism;

\definition forwardSquared: \forall (p: Family.Point) -> right.squared (totalHomeomorphism.forward p) = left.squared p := Comparison.forwardSquared;
\definition backwardSquared: \forall (p: Family.Point) -> left.squared (totalHomeomorphism.backward p) = right.squared p := Comparison.backwardSquared;
