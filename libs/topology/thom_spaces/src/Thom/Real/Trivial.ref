  topology.Maps[A := Bundles.Vector n, B := Bundles.Vector n].Identity[].continuous (Bundles.coordinateTopology n);
\definition backwardRegular: topology.Continuity[A := algebraic_topology.Euclidean[].Dimension[n := n].Coordinate, B := Bundles.Vector n].Continuous algebraic_topology.Euclidean[].Dimension[n := n].topology (Bundles.coordinateTopology n) frame.backward.apply :=
  topology.Maps[A := Bundles.Vector n, B := Bundles.Vector n].Identity[].continuous (Bundles.coordinateTopology n);
