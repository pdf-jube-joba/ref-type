\import singular_cohomology.Relative[A := A, source := source, subset := subset].Homology[z := z] \as Original;
\import singular_cohomology.Relative[A := Carrier, source := topology, subset := boundary].Homology[z := z] \as Remaining;
\import singular_cohomology.Relative[A := Extended, source := extendedTopology, subset := Boundary].Homology[z := z] \as Augmented;
\definition removePoint: Modules.Isomorphism[V := Remaining.Carrier, W := Augmented.Carrier, source := Remaining.space, target := Augmented.space].Isomorphism :=
  Excision.Homology[z := z].isomorphism pair;
\definition isomorphism: Modules.Isomorphism[V := Original.Carrier, W := Augmented.Carrier, source := Original.space, target := Augmented.space].Isomorphism :=
  Modules.Isomorphism[V := Original.Carrier, W := Remaining.Carrier, source := Original.space, target := Remaining.space].Composition[U := Augmented.Carrier, final := Augmented.space].compose
    removePoint (PairComparison.Homology[z := z].isomorphism comparison);
