\import singular_cohomology.Relative[A := A, source := source, subset := subset].With[coefficients := coefficients].At[z := z] \as Original;
\import singular_cohomology.Relative[A := Carrier, source := topology, subset := boundary].With[coefficients := coefficients].At[z := z] \as Remaining;
\import singular_cohomology.Relative[A := Extended, source := extendedTopology, subset := Boundary].With[coefficients := coefficients].At[z := z] \as Augmented;
\definition removePoint: Modules.Isomorphism[V := Augmented.Carrier, W := Remaining.Carrier, source := Augmented.space, target := Remaining.space].Isomorphism :=
  Excision.With[coefficients := coefficients].At[z := z].isomorphism pair;
\definition isomorphism: Modules.Isomorphism[V := Augmented.Carrier, W := Original.Carrier, source := Augmented.space, target := Original.space].Isomorphism :=
  Modules.Isomorphism[V := Augmented.Carrier, W := Remaining.Carrier, source := Augmented.space, target := Remaining.space].Composition[U := Original.Carrier, final := Original.space].compose
    (PairComparison.With[coefficients := coefficients].At[z := z].isomorphism comparison) removePoint;
