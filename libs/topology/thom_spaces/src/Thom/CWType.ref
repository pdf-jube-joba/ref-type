\module ConcatenationLaws(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology,
  f, g, k: A -> B, h: algebraic_topology.Homotopy[A := A, B := B].Homotopy[source, target, f, g],
  j: algebraic_topology.Homotopy[A := A, B := B].Homotopy[source, target, g, k]);
\module PathCancellation(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology,
  f, g, k: A -> B, p: algebraic_topology.Homotopy[A := A, B := B].Homotopy[source, target, f, g],
  h: algebraic_topology.Homotopy[A := A, B := B].Homotopy[source, target, g, k]);
\module PathTransport(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology,
  f, g, k: A -> B, p: algebraic_topology.Homotopy[A := A, B := B].Homotopy[source, target, f, g],
  h: algebraic_topology.Homotopy[A := A, B := B].Homotopy[source, target, k, g]);
\module PathReparametrization(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology,
  f, g: A -> B, p: algebraic_topology.Homotopy[A := A, B := B].Homotopy[source, target, f, g],
  clock: algebraic_topology.Homotopy[A := A, B := algebraic_topology.Interval[].Carrier].Homotopy[source, algebraic_topology.Interval[].topology,
    (\fun (x: A) => algebraic_topology.Interval[].start), (\fun (x: A) => algebraic_topology.Interval[].end)],
  q: algebraic_topology.Homotopy[A := A, B := B].Homotopy[source, target, f, g],
  formula: \forall (t: algebraic_topology.Interval[].Carrier)(x: A) -> q (algebraic_topology.Cylinder[A := A].at t x) = p (algebraic_topology.Cylinder[A := A].at (clock (algebraic_topology.Cylinder[A := A].at t x)) x));
\module Separated(A, B: \Set, source: topology.Topology[Carrier := A].Topology,
  target: topology.Topology[Carrier := B].Topology, hausdorff: topology.Topology[Carrier := B].IsT2 target,
  f, g: A -> B, first: topology.Continuity[A := A, B := B].Continuous source target f,
  second: topology.Continuity[A := A, B := B].Continuous source target g);
\module ProductHausdorff(A, B: \Set, left: topology.Topology[Carrier := A].Topology,
  right: topology.Topology[Carrier := B].Topology, first: topology.Topology[Carrier := A].IsT2 left,
  second: topology.Topology[Carrier := B].IsT2 right);
