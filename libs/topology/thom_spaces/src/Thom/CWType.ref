\module CompactQuotient(A: \Set, source: topology.Topology[Carrier := A].Topology,
  relation: A -> A -> \Prop, laws: std.Logic[].Relation[].Equivalence[A, relation],
  compact: topology.Topology[Carrier := A].IsCompact source, hausdorff: topology.Topology[Carrier := A].IsT2 source,
  closed: topology.Topology[Carrier := Pair.Times^[A, A]].IsClosedIn
    (topological_constructions.Product[A := A, B := A].topology source source)
    ({ p: Pair.Times^[A, A] \where relation (Pair.first A A p) (Pair.second A A p) }));
\module CompactBijection(A, B: \Set, source: topology.Topology[Carrier := A].Topology,
  target: topology.Topology[Carrier := B].Topology, compact: topology.Topology[Carrier := A].IsCompact source,
  hausdorff: topology.Topology[Carrier := B].IsT2 target, f: A -> B,
  injective: \forall (x, y: A) -> f x = f y -> x = y,
  onto: \forall (y: B) -> \exists (x: A \where f x = y),
  continuous: topology.Continuity[A := A, B := B].Continuous source target f);
\module CompactSurjection(A, B: \Set, source: topology.Topology[Carrier := A].Topology,
  target: topology.Topology[Carrier := B].Topology, compact: topology.Topology[Carrier := A].IsCompact source,
  hausdorff: topology.Topology[Carrier := B].IsT2 target, f: A -> B,
  onto: \forall (y: B) -> \exists (x: A \where f x = y),
  continuous: topology.Continuity[A := A, B := B].Continuous source target f);
