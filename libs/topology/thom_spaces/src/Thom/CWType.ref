\module CompactQuotient(A: \Set, source: topology.Topology[Carrier := A].Topology,
  relation: A -> A -> \Prop, laws: std.Logic[].Relation[].Equivalence[A, relation],
  compact: topology.Topology[Carrier := A].IsCompact source, hausdorff: topology.Topology[Carrier := A].IsT2 source,
  closed: topology.Topology[Carrier := Pair.Times^[A, A]].IsClosedIn
    (topological_constructions.Product[A := A, B := A].topology source source)
    ({ p: Pair.Times^[A, A] \where relation (Pair.first A A p) (Pair.second A A p) }));
\module CompactBijection(A, B: \Set, source: topology.Topology[Carrier := A].Topology,
  target: topology.Topology[Carrier := B].Topology, compact: topology.Topology[Carrier := A].IsCompact source,
  hausdorff: topology.Topology[Carrier := B].IsT2 target, f: A -> B,
  injective: \forall (x, y: A) -> f x = f y -> x = y,
  onto: \forall (y: B) -> \exists (x: A \where f x = y),
  continuous: topology.Continuity[A := A, B := B].Continuous source target f);
\module PiecewiseAffine(m: N.Nat^);
\module LinearKernel;
\module LinearForms(n: N.Nat^);
\module Hyperplanes(n: N.Nat^);
\module FiniteTuples(A: \Set);
\module AffineImage(m, n: N.Nat^, larger: N.Basic[].Prop[].Lt m n, forms: Fin.Fin n -> \root.Thom[].CWType[].PiecewiseAffine[m := m].Affine);
\module PiecewiseImage(m, n: N.Nat^, larger: N.Basic[].Prop[].Lt m n, expressions: Fin.Fin n -> \root.Thom[].CWType[].PiecewiseAffine[m := m].Expression);
\module PiecewiseApproximation(m, n: N.Nat^, larger: N.Basic[].Prop[].Lt m n);
\module SupGeometry(n: N.Nat^);
\module LocalAvoidance(m, n: N.Nat^, larger: N.Basic[].Prop[].Lt m n);
\module CellChart(A: \Set, source: topology.Topology[Carrier := A].Topology, complex: algebraic_topology.CW[A := A].FiniteComplex[source],
  cell: algebraic_topology.CW[A := A].CellData, member: algebraic_topology.CW[A := A].CellMember complex.cells cell);
\module CellAvoidance(m: N.Nat^, A: \Set, source: topology.Topology[Carrier := A].Topology, complex: algebraic_topology.CW[A := A].FiniteComplex[source],
  cell: algebraic_topology.CW[A := A].CellData, member: algebraic_topology.CW[A := A].CellMember complex.cells cell, larger: N.Basic[].Prop[].Lt m cell.dimension);
\module Separated(A, B: \Set, source: topology.Topology[Carrier := A].Topology,
  target: topology.Topology[Carrier := B].Topology, hausdorff: topology.Topology[Carrier := B].IsT2 target,
  f, g: A -> B, first: topology.Continuity[A := A, B := B].Continuous source target f,
  second: topology.Continuity[A := A, B := B].Continuous source target g);
\module ProductHausdorff(A, B: \Set, left: topology.Topology[Carrier := A].Topology,
  right: topology.Topology[Carrier := B].Topology, first: topology.Topology[Carrier := A].IsT2 left,
  second: topology.Topology[Carrier := B].IsT2 right);
\module MappingCylinder(A, B: \Set, source: topology.Topology[Carrier := A].Topology,
  target: topology.Topology[Carrier := B].Topology, f: A -> B,
  continuous: topology.Continuity[A := A, B := B].Continuous source target f);
