\module TwoOutOfSix(A, B, C, D: \Set, firstSpace: topology.Topology[Carrier := A].Topology, secondSpace: topology.Topology[Carrier := B].Topology,
  thirdSpace: topology.Topology[Carrier := C].Topology, fourthSpace: topology.Topology[Carrier := D].Topology,
  f: A -> B, g: B -> C, h: C -> D,
  fContinuous: topology.Continuity[A := A, B := B].Continuous firstSpace secondSpace f,
  gContinuous: topology.Continuity[A := B, B := C].Continuous secondSpace thirdSpace g,
  hContinuous: topology.Continuity[A := C, B := D].Continuous thirdSpace fourthSpace h,
  firstEquivalence: algebraic_topology.HomotopyEquivalence[A := A, B := C].Equivalence[firstSpace, thirdSpace],
  secondEquivalence: algebraic_topology.HomotopyEquivalence[A := B, B := D].Equivalence[secondSpace, fourthSpace],
  firstForward: \forall (x: A) -> firstEquivalence.forward x = g (f x),
  secondForward: \forall (y: B) -> secondEquivalence.forward y = h (g y));
\module FiniteCellTypes(A: \Set, source: topology.Topology[Carrier := A].Topology, complex: algebraic_topology.CW[A := A].FiniteComplex[source]);
\module ConeAttachment(A, B: \Set, source: topology.Topology[Carrier := A].Topology,
  target: topology.Topology[Carrier := B].Topology, f: A -> B,
