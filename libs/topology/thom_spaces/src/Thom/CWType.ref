\module FixedPaths(S, A, B: \Set, from: S -> A, to: S -> B);
\module Under(S, A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology, from: S -> A, to: S -> B);
\module UnderCancellation(S, A, B, C, D: \Set,
  firstSpace: topology.Topology[Carrier := A].Topology, secondSpace: topology.Topology[Carrier := B].Topology,
  thirdSpace: topology.Topology[Carrier := C].Topology, fourthSpace: topology.Topology[Carrier := D].Topology,
  firstIn: S -> A, secondIn: S -> B, thirdIn: S -> C, fourthIn: S -> D,
  f: A -> B, g: B -> C, h: C -> D,
  fContinuous: topology.Continuity[A := A, B := B].Continuous firstSpace secondSpace f,
  gContinuous: topology.Continuity[A := B, B := C].Continuous secondSpace thirdSpace g,
  hContinuous: topology.Continuity[A := C, B := D].Continuous thirdSpace fourthSpace h,
  fFixed: \forall (s: S) -> f (firstIn s) = secondIn s,
  gFixed: \forall (s: S) -> g (secondIn s) = thirdIn s,
  hFixed: \forall (s: S) -> h (thirdIn s) = fourthIn s,
  first: \root.Thom[].CWType[].Under[S := S, A := A, B := C, source := firstSpace, target := thirdSpace, from := firstIn, to := thirdIn].Data,
  second: \root.Thom[].CWType[].Under[S := S, A := B, B := D, source := secondSpace, target := fourthSpace, from := secondIn, to := fourthIn].Data,
  firstForward: \forall (x: A) -> first.forward x = g (f x),
  secondForward: \forall (y: B) -> second.forward y = h (g y));
