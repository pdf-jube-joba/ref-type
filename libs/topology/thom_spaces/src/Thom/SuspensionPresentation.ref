\structure Comparison[n: N.Nat^]: \Set := {
  homeomorphism: topology.Homeomorphism[A := \root.Thom[].DiskSuspension[X := X, space := source, n := n].Carrier, B := T n].Homeomorphism[
    \root.Thom[].DiskSuspension[X := X, space := source, n := n].topology, (spaces n).topology],
  pointed: homeomorphism.forward (\root.Thom[].DiskSuspension[X := X, space := source, n := n].pointed.basepoint) = (spaces n).basepoint
};
\import \root.Thom[].DiskSuspension[X := X, space := source, n := N.Nat^::zero] \as ZeroDisk;
\import \root.Thom[].ZeroDiskSuspension[X := X, source := source] \as Zero;
\import \root.Thom[].Adjoin[A := X, source := source] \as Plus;
\definition initial: Comparison[N.Nat^::zero] := Comparison[N.Nat^::zero] {
  homeomorphism := topology.Homeomorphism[A := ZeroDisk.Carrier, B := Plus.Carrier].Composition[C := T N.Nat^::zero].compose
    ZeroDisk.topology Plus.topology (spaces N.Nat^::zero).topology Zero.homeomorphism zero,
  pointed := trans!{{T N.Nat^::zero}} _ _ _ (congr!{Plus.Carrier {T N.Nat^::zero}} zero.forward _ _ Zero.preservesPoint) zeroPointed
};
\module Successor(n: N.Nat^, previous: Comparison[n]);
\definition comparison: \forall (n: N.Nat^) -> Comparison[n] := \induction (n: N.Nat^) \return Comparison[n] \with {
  | zero: initial
  | succ: \fun (n: N.Nat^)(previous: Comparison[n]) => Successor[n := n, previous := previous].comparison
};
