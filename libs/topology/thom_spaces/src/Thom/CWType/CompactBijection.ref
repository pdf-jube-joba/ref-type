\import \parent.CompactSurjection[A := A, B := B, source := source, target := target, compact := compact, hausdorff := hausdorff, f := f, onto := onto, continuous := continuous] \as Surjection;
\definition reflectsOpen: \forall (V: \Pow B) -> topology.Topology[Carrier := A].IsOpenIn source (topology.Maps[A := A, B := B].Preimage f V) -> topology.Topology[Carrier := B].IsOpenIn target V := Surjection.reflectsOpen;
\definition homeomorphism: topology.Homeomorphism[A := A, B := B].Homeomorphism[source, target] :=
  topology.Homeomorphism[A := A, B := B].OfQuotient[f := f].homeomorphism source target injective onto continuous reflectsOpen;
