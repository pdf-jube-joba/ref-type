\import Euclidean.Dimension[n := N.Nat^::zero] \as Disk;
\import \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := N.Nat^::zero, attach := attach, continuous := continuous] \as Attached;
\import Attached.Subset[subset := Part.Subset] \as Subsets;
\import singular_cellular.On[A := A, source := source, complex := complex].Filtration[] \as Filtration;
\definition empty: \forall (v: Disk.Sphere) -> Logic.False := \fun (v: Disk.Sphere) => dedekind_reals.DedekindReal[].Arithmetic[].Prop[].zeroNeOne (\bysub(Disk.Coordinate, Disk.Boundary, v));
\definition lands: \forall (v: Disk.Sphere) -> \In[A] (Filtration.subset N.Nat^::zero) (attach v) := \fun (v: Disk.Sphere) => Logic.falseElim _ (empty v);
\import Attached.Finite[complex := complex].Cellular[lands := lands] \as CW;
\import CW.Subcomplex[part := part] \as ChosenPart;
\import \root.Thom[].CWType[].PairFiniteType[A := Attached.Carrier, source := Attached.topology, subset := Subsets.originalSubset] \as OutsideType;
\definition outsideModel: OutsideType.Data := OutsideType.Native[complex := CW.complex, part := ChosenPart.result, agrees := ChosenPart.Images[].equation].result;
\definition outsideExists: \exists OutsideType.Data := \exact(outsideModel, OutsideType.Data);
\import \root.Thom[].CWType[].NativeSubcomplex[A := A, source := source, complex := complex, subcomplex := part] \as NativePart;
\import singular_cellular.On[A := NativePart.Carrier, source := NativePart.topology, complex := NativePart.result].Filtration[] \as PartFiltration;
\definition lift[v: Disk.Sphere]: NativePart.Carrier := \choice NativePart.Carrier \by {
  existence: Logic.falseElim (\exists NativePart.Carrier) (empty v),
  uniqueness: \fun (x, y: NativePart.Carrier) => Logic.falseElim (x = y) (empty v)
};
\definition over: \forall (v: Disk.Sphere) -> NativePart.inclusion (lift v) = attach v := \fun (v: Disk.Sphere) => Logic.falseElim _ (empty v);
\definition within: \forall (v: Disk.Sphere) -> \In[NativePart.Carrier] (PartFiltration.subset N.Nat^::zero) (lift v) := \fun (v: Disk.Sphere) => Logic.falseElim _ (empty v);
\import ChosenPart.WithCell[lift := lift, over := over, within := within] \as WithCell;
\import \root.Thom[].CWType[].PairFiniteType[A := Attached.Carrier, source := Attached.topology, subset := Subsets.fullSubset] \as InsideType;
\definition insideModel: InsideType.Data := InsideType.Native[complex := CW.complex, part := WithCell.result, agrees := WithCell.Images[].equation].result;
\definition insideExists: \exists InsideType.Data := \exact(insideModel, InsideType.Data);
