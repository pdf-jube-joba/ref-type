\import Euclidean.Dimension[n := N.Nat^::succ d] \as Disk;
\import \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := N.Nat^::succ d, attach := attach, continuous := continuous] \as Attached;
\import Attached.Subset[subset := Part.Subset] \as Subsets;
\module Outside;
\module Inside(contained: \forall (v: Disk.Sphere) -> \In[A] Part.Subset (attach v));
