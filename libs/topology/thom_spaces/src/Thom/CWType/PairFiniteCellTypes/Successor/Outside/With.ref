\import singular_cellular.On[A := A, source := source, complex := complex].Filtration[] \as Filtration;
\import Filtration.Stage[limit := N.Nat^::succ d] \as Target;
\definition attachNext[v: Disk.Sphere]: A := Target.inclusion (approximation.value v);
\definition regular: topology.Continuity[A := Disk.Sphere, B := A].Continuous Disk.sphereTopology source attachNext :=
  topology.Composition[A := Disk.Sphere, B := Target.Carrier, C := A].composeContinuous Disk.sphereTopology Target.topology source approximation.value Target.inclusion approximation.continuous Target.continuous;
\definition lands: \forall (v: Disk.Sphere) -> \In[A] (Filtration.subset (N.Nat^::succ d)) (attachNext v) := \fun (v: Disk.Sphere) => \bysub(A, Filtration.subset (N.Nat^::succ d), approximation.value v);
\import \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := N.Nat^::succ d, attach := attachNext, continuous := regular] \as Next;
\import Next.Subset[subset := Part.Subset] \as NextSubsets;
\import Next.Finite[complex := complex].Cellular[lands := lands] \as CW;
\import CW.Subcomplex[part := part] \as ChosenPart;
\import \root.Thom[].CWType[].PairFiniteType[A := Next.Carrier, source := Next.topology, subset := NextSubsets.originalSubset] \as NextType;
\definition model: NextType.Data := NextType.Native[complex := CW.complex, part := ChosenPart.result, agrees := ChosenPart.Images[].equation].result;
\import Subsets.Homotopic[next := attachNext, regular := regular, homotopy := approximation.homotopy] \as Change;
\definition result: Type.Data := Type.Along[B := Next.Carrier, target := Next.topology, targetSubset := NextSubsets.originalSubset, e := Change.equivalence, model := model].result;
\definition exists: \exists Type.Data := \exact(result, Type.Data);
