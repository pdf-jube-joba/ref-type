\import \root.Thom[].CWType[].SphereApproximation[d := d, A := A, source := source, complex := complex] \as Approximation;
\import \root.Thom[].CWType[].PairFiniteType[A := Attached.Carrier, source := Attached.topology, subset := Subsets.originalSubset] \as Type;
\module With(approximation: Approximation.Result[attach]);
\definition exists: \exists Type.Data := \block {
  \takefrom approximation: Approximation.Result[attach] \by Approximation.For[f := attach, continuous := continuous].exists \then
  \return With[approximation := approximation].exists
};
