\import \root.Thom[].CWType[].NativeSubcomplex[A := A, source := source, complex := complex, subcomplex := part] \as NativePart;
\definition restricted[v: Disk.Sphere]: NativePart.Carrier := \into[A](attach v, Part.Subset) \by { contained v };
\definition restrictedContinuous: topology.Continuity[A := Disk.Sphere, B := NativePart.Carrier].Continuous Disk.sphereTopology NativePart.topology restricted :=
  topology.Continuity[A := Disk.Sphere, B := A].Corestriction[S := Part.Subset].corestrictContinuous Disk.sphereTopology source restricted continuous;
\import \root.Thom[].CWType[].SphereApproximation[d := d, A := NativePart.Carrier, source := NativePart.topology, complex := NativePart.result] \as Approximation;
\import \root.Thom[].CWType[].PairFiniteType[A := Attached.Carrier, source := Attached.topology, subset := Subsets.fullSubset] \as Type;
\module With(approximation: Approximation.Result[restricted]);
\definition exists: \exists Type.Data := \block {
  \takefrom approximation: Approximation.Result[restricted] \by Approximation.For[f := restricted, continuous := restrictedContinuous].exists \then
  \return With[approximation := approximation].exists
};
