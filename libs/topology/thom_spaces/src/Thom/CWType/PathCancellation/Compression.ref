\import algebraic_topology.Homotopy[A := A, B := I.Carrier] \as Times;
\import Times.Concatenation[] \as TimeJoin;
\definition zero[x: A]: I.Carrier := I.start;
\definition one[x: A]: I.Carrier := I.end;
\definition clock: Times.Homotopy[source, I.topology, zero, one] := \into[Times.Family](Cylinder.time, Times.Homotopy[source, I.topology, zero, one]) \by {
  Times.Laws[source, I.topology, zero, one, Cylinder.time] {
    continuous := Cylinder.timeContinuous source, start := \fun (x: A) => \refl(I.start), end := \fun (x: A) => \refl(I.end)
  }
};
\definition constantTime: Times.Homotopy[source, I.topology, one, one] := Times.constant source I.topology one (topology.Maps[A := A, B := I.Carrier].constantContinuous source I.topology I.end);
\definition firstClock: Times.Homotopy[source, I.topology, zero, one] := TimeJoin.concatenate source I.topology zero one one clock constantTime;
\definition rho: Times.Homotopy[source, I.topology, zero, one] := TimeJoin.concatenate source I.topology zero one one firstClock constantTime;
\import \root.Thom[].CWType[].ConcatenationLaws[A := A, B := I.Carrier, source := source, target := I.topology, f := zero, g := one, k := one, h := clock, j := constantTime] \as FirstJoin;
\definition firstAgrees: \forall (t: I.Carrier)(x: A) -> p (Cylinder.at t x) = p (Cylinder.at (clock (Cylinder.at t x)) x) := \fun (t: I.Carrier)(x: A) => \refl(p (Cylinder.at t x));
\definition constantAgrees: \forall (t: I.Carrier)(x: A) -> constant (Cylinder.at t x) = p (Cylinder.at (constantTime (Cylinder.at t x)) x) := \fun (t: I.Carrier)(x: A) => sym!{B} _ _ ((Paths.laws source target f g p).end x);
\import FirstJoin.Compare[C := A, D := B, domain := source, range := target, before := (\fun (x: A) => x), after := (\fun (x: A)(t: I.Carrier) => p (Cylinder.at t x)), a := f, b := g, c := g,
  first := p, second := constant, firstAgrees := firstAgrees, secondAgrees := constantAgrees] \as FirstFormula;
\import \root.Thom[].CWType[].ConcatenationLaws[A := A, B := I.Carrier, source := source, target := I.topology, f := zero, g := one, k := one, h := firstClock, j := constantTime] \as SecondJoin;
\import SecondJoin.Compare[C := A, D := B, domain := source, range := target, before := (\fun (x: A) => x), after := (\fun (x: A)(t: I.Carrier) => p (Cylinder.at t x)), a := f, b := g, c := g,
  first := paused, second := constant, firstAgrees := FirstFormula.result, secondAgrees := constantAgrees] \as Formula;
\definition map[z: Double.Carrier]: Cylinder.Carrier := Cylinder.at
  (I.Convex[].blend (Double.time z) (rho (Double.point z)) (Cylinder.time (Double.point z))) (Cylinder.point (Double.point z));
\definition mapContinuous: topology.Continuity[A := Double.Carrier, B := Cylinder.Carrier].Continuous doubleTopology (Cylinder.topology source) map :=
  topological_constructions.Product[A := I.Carrier, B := A].Universal[X := Double.Carrier].pairContinuous doubleTopology I.topology source
    (\fun (z: Double.Carrier) => I.Convex[].blend (Double.time z) (rho (Double.point z)) (Cylinder.time (Double.point z)))
    (\fun (z: Double.Carrier) => Cylinder.point (Double.point z))
    (I.Convex[].Functions[A := Double.Carrier].continuous doubleTopology Double.time (\fun (z: Double.Carrier) => rho (Double.point z)) (\fun (z: Double.Carrier) => Cylinder.time (Double.point z))
      (Double.timeContinuous (Cylinder.topology source))
      (topology.Composition[A := Double.Carrier, B := Cylinder.Carrier, C := I.Carrier].composeContinuous doubleTopology (Cylinder.topology source) I.topology Double.point rho (Double.pointContinuous (Cylinder.topology source)) (Times.laws source I.topology zero one rho).continuous)
      (topology.Composition[A := Double.Carrier, B := Cylinder.Carrier, C := I.Carrier].composeContinuous doubleTopology (Cylinder.topology source) I.topology Double.point Cylinder.time (Double.pointContinuous (Cylinder.topology source)) (Cylinder.timeContinuous source)))
    (topology.Composition[A := Double.Carrier, B := Cylinder.Carrier, C := A].composeContinuous doubleTopology (Cylinder.topology source) source Double.point Cylinder.point (Double.pointContinuous (Cylinder.topology source)) (Cylinder.pointContinuous source));
\definition apply[z: Double.Carrier]: B := p (map z);
\definition continuous: topology.Continuity[A := Double.Carrier, B := B].Continuous doubleTopology target apply :=
  topology.Composition[A := Double.Carrier, B := Cylinder.Carrier, C := B].composeContinuous doubleTopology (Cylinder.topology source) target map p mapContinuous (Paths.laws source target f g p).continuous;
\definition start: \forall (t: I.Carrier)(x: A) -> apply (Double.at I.start (Cylinder.at t x)) = compressed (Cylinder.at t x) := \fun (t: I.Carrier)(x: A) => trans!{B} _ _ _
  (congr!{{I.Carrier} B} (\fun (v: I.Carrier) => p (Cylinder.at v x)) _ _ (I.Convex[].atStart (rho (Cylinder.at t x)) t)) (sym!{B} _ _ (Formula.result t x));
\definition end: \forall (t: I.Carrier)(x: A) -> apply (Double.at I.end (Cylinder.at t x)) = p (Cylinder.at t x) := \fun (t: I.Carrier)(x: A) =>
  congr!{{I.Carrier} B} (\fun (v: I.Carrier) => p (Cylinder.at v x)) _ _ (I.Convex[].atEnd (rho (Cylinder.at t x)) t);
\definition atZero: \forall (u: I.Carrier)(x: A) -> apply (Double.at u (Cylinder.at I.start x)) = f x := \fun (u: I.Carrier)(x: A) => eq_reason_in!{B _
  "=" _ "by" { congr!{{I.Carrier} B} (\fun (v: I.Carrier) => p (Cylinder.at v x)) _ _ (congr!{{I.Carrier} {I.Carrier}} (\fun (v: I.Carrier) => I.Convex[].blend u v I.start) _ _ ((Times.laws source I.topology zero one rho).start x)) }
  "=" _ "by" { congr!{{I.Carrier} B} (\fun (v: I.Carrier) => p (Cylinder.at v x)) _ _ (I.Convex[].fixed u I.start) }
  "=" _ "by" { (Paths.laws source target f g p).start x }
};
\definition atOne: \forall (u: I.Carrier)(x: A) -> apply (Double.at u (Cylinder.at I.end x)) = g x := \fun (u: I.Carrier)(x: A) => eq_reason_in!{B _
  "=" _ "by" { congr!{{I.Carrier} B} (\fun (v: I.Carrier) => p (Cylinder.at v x)) _ _ (congr!{{I.Carrier} {I.Carrier}} (\fun (v: I.Carrier) => I.Convex[].blend u v I.end) _ _ ((Times.laws source I.topology zero one rho).end x)) }
  "=" _ "by" { congr!{{I.Carrier} B} (\fun (v: I.Carrier) => p (Cylinder.at v x)) _ _ (I.Convex[].fixed u I.end) }
  "=" _ "by" { (Paths.laws source target f g p).end x }
};
