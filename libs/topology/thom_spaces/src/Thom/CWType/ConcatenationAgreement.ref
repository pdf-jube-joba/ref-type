\import topology.Topology[Carrier := A] \as Source;
\import topology.Topology[Carrier := B] \as Target;
\import algebraic_topology.Homotopy[A := A, B := B] \as Homotopies;
\import algebraic_topology.Cylinder[A := A] \as Cylinder;
\import algebraic_topology.Interval[] \as I;
\module Of(source: Source.Topology, target: Target.Topology, subset: \Pow A,
  f, g, k, p, q, r: A -> B, h: Homotopies.Homotopy[source, target, f, g], j: Homotopies.Homotopy[source, target, g, k],
  u: Homotopies.Homotopy[source, target, p, q], v: Homotopies.Homotopy[source, target, q, r],
  first: \forall (t: I.Carrier)(x: A) -> \In[A] subset x -> h (Cylinder.at t x) = u (Cylinder.at t x),
  second: \forall (t: I.Carrier)(x: A) -> \In[A] subset x -> j (Cylinder.at t x) = v (Cylinder.at t x));
