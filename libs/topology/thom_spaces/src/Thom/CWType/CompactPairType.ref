\import topology.Topology[Carrier := A] \as Space;
\import \root.Thom[].CWType[].PairFiniteType[A := A, source := source, subset := subset] \as Models;
\definition Property: \Prop := Logic.And[Space.IsCompact source, \exists Models.Data];
\module Homeomorphic(B: \Set, target: topology.Topology[Carrier := B].Topology, targetSubset: \Pow B,
  h: topology.Homeomorphism[A := A, B := B].Homeomorphism[source, target],
  forwardContained: \forall (x: \Cast[A] subset) -> \In[B] targetSubset (h.forward x),
  backwardContained: \forall (y: \Cast[B] targetSubset) -> \In[A] subset (h.backward y));
\module Empty(empty: \forall (x: A) -> Logic.False) {
  \definition property: Property := Logic.And[_, _]::#
    (\root.Thom[].CWType[].CompactType[A := A, source := source].Native[complex := \root.Thom[].CWType[].EmptyComplex[A := A, source := source, empty := empty].complex].compact)
    (\exact(Models.Empty[empty := empty].result, Models.Data));
}
