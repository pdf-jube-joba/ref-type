\import algebraic_topology.Euclidean[] \as Euclidean;
\import algebraic_topology.CW[A := A].Pair[source := source, complex := complex] \as OriginalPair;
\import OriginalPair.Of[subcomplex := part] \as Part;
\definition Outside[n: N.Nat^]: \Prop := \forall (attach: Euclidean.Dimension[n := n].Sphere -> A) ->
  \forall (continuous: topology.Continuity[A := Euclidean.Dimension[n := n].Sphere, B := A].Continuous Euclidean.Dimension[n := n].sphereTopology source attach) ->
  \exists \root.Thom[].CWType[].PairFiniteType[A := \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := n, attach := attach, continuous := continuous].Carrier,
    source := \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := n, attach := attach, continuous := continuous].topology,
    subset := \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := n, attach := attach, continuous := continuous].Subset[subset := Part.Subset].originalSubset].Data;
\definition Inside[n: N.Nat^]: \Prop := \forall (attach: Euclidean.Dimension[n := n].Sphere -> A) ->
  \forall (continuous: topology.Continuity[A := Euclidean.Dimension[n := n].Sphere, B := A].Continuous Euclidean.Dimension[n := n].sphereTopology source attach) ->
  (\forall (v: Euclidean.Dimension[n := n].Sphere) -> \In[A] Part.Subset (attach v)) ->
  \exists \root.Thom[].CWType[].PairFiniteType[A := \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := n, attach := attach, continuous := continuous].Carrier,
    source := \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := n, attach := attach, continuous := continuous].topology,
    subset := \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := n, attach := attach, continuous := continuous].Subset[subset := Part.Subset].fullSubset].Data;
\module Zero(attach: Euclidean.Dimension[n := N.Nat^::zero].Sphere -> A,
  continuous: topology.Continuity[A := Euclidean.Dimension[n := N.Nat^::zero].Sphere, B := A].Continuous Euclidean.Dimension[n := N.Nat^::zero].sphereTopology source attach);
\module Successor(d: N.Nat^, attach: Euclidean.Dimension[n := N.Nat^::succ d].Sphere -> A,
  continuous: topology.Continuity[A := Euclidean.Dimension[n := N.Nat^::succ d].Sphere, B := A].Continuous Euclidean.Dimension[n := N.Nat^::succ d].sphereTopology source attach);
\definition outside: \forall (n: N.Nat^) -> Outside n := \induction (n: N.Nat^) \return Outside n \with {
  | zero: \fun (attach: _)(continuous: _) => Zero[attach := attach, continuous := continuous].outsideExists
  | succ: \fun (d: N.Nat^)(previous: Outside d)(attach: _)(continuous: _) => Successor[d := d, attach := attach, continuous := continuous].Outside[].exists
};
\definition inside: \forall (n: N.Nat^) -> Inside n := \induction (n: N.Nat^) \return Inside n \with {
  | zero: \fun (attach: _)(continuous: _)(contained: _) => Zero[attach := attach, continuous := continuous].insideExists
  | succ: \fun (d: N.Nat^)(previous: Inside d)(attach: _)(continuous: _)(contained: _) => Successor[d := d, attach := attach, continuous := continuous].Inside[contained := contained].exists
};
