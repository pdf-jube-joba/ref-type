\import algebraic_topology.Homotopy[A := Carrier, B := Second.Carrier] \as Native;
\definition start: \forall (x: Carrier) -> Finishing.apply (Total.at I.start x) = middle x := induction (\fun (x: Carrier) => Finishing.apply (Total.at I.start x) = middle x)
  (\fun (y: B) => eq_reason_in!{Second.Carrier _
    "=" _ "by" { Finishing.onOriginal I.start y }
    "=" _ "by" { congr!{D Second.Carrier} Second.inclusion _ _ (sym!{D} _ _ ((Original.laws target range u v homotopy).end y)) }
    "=" _ "by" { sym!{Second.Carrier} _ _ (Sliding.onOriginal I.end y) }
  })
  (trans!{Second.Carrier} _ _ _ (Finishing.onApex I.start) (sym!{Second.Carrier} _ _ (Sliding.onApex I.end)))
  (\fun (t: I.Carrier)(x: A) => eq_reason_in!{Second.Carrier _
    "=" _ "by" { Finishing.onCylinder I.start t x }
    "=" _ "by" { Transport.singleStart t x }
    "=" _ "by" { sym!{Second.Carrier} _ _ (Transport.finalPoint t x) }
    "=" _ "by" { sym!{Second.Carrier} _ _ (Sliding.onCylinder I.end t x) }
  });
\definition end: \forall (x: Carrier) -> Finishing.apply (Total.at I.end x) = SecondMap.apply x := induction (\fun (x: Carrier) => Finishing.apply (Total.at I.end x) = SecondMap.apply x)
  (\fun (y: B) => trans!{Second.Carrier} _ _ _ (Finishing.onOriginal I.end y) (sym!{Second.Carrier} _ _ (SecondMap.onOriginal y)))
  (trans!{Second.Carrier} _ _ _ (Finishing.onApex I.end) (sym!{Second.Carrier} _ _ SecondMap.onApex))
  (\fun (t: I.Carrier)(x: A) => eq_reason_in!{Second.Carrier _
    "=" _ "by" { Finishing.onCylinder I.end t x }
    "=" _ "by" { Transport.singleEnd t x }
    "=" _ "by" { sym!{Second.Carrier} _ _ (SecondMap.onCylinder t x) }
  });
\definition result: Native.Homotopy[topology, Second.topology, middle, SecondMap.apply] :=
  \into[Native.Family](Finishing.apply, Native.Homotopy[topology, Second.topology, middle, SecondMap.apply]) \by {
    Native.Laws[topology, Second.topology, middle, SecondMap.apply, Finishing.apply] { continuous := Finishing.continuous, start := start, end := end }
  };
