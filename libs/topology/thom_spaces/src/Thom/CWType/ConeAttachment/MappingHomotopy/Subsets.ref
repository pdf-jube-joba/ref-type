\import \parent.FirstHomotopy[] \as FirstMotion;
\import \parent.SecondHomotopy[] \as SecondMotion;
\import \parent.\parent.Subset[subset := subset] \as OriginalSubset;
\import \root.Thom[].CWType[].ConeAttachment[A := A, B := D, source := source, target := range, f := second, continuous := secondContinuous].Subset[subset := targetSubset] \as FinalSubset;
\definition firstPreserves: \forall (t: I.Carrier)(z: \Cast[Carrier] OriginalSubset.originalSubset) -> \In[Second.Carrier] FinalSubset.originalSubset (FirstMotion.result (Total.at t z)) :=
  \fun (t: I.Carrier) => OriginalSubset.mapPreserves Second.Carrier FinalSubset.originalSubset (\fun (z: Carrier) => FirstMotion.result (Total.at t z))
    (\fun (y: B)(member: \In[B] subset y) => \idelim Second.inclusion (homotopy (OriginalCylinder.at t y)) = FirstMotion.result (Total.at t (inclusion y)) \with q: Second.Carrier => \In[Second.Carrier] FinalSubset.originalSubset q \by {
      base: FinalSubset.original (homotopy (OriginalCylinder.at t y)) (homotopyContained t (\into[B](y, subset) \by { member })),
      equality: sym!{Second.Carrier} _ _ (FirstMotion.originalFormula t y)
    });
\definition secondPreserves: \forall (t: I.Carrier)(z: \Cast[Carrier] OriginalSubset.originalSubset) -> \In[Second.Carrier] FinalSubset.originalSubset (SecondMotion.result (Total.at t z)) :=
  \fun (t: I.Carrier) => OriginalSubset.mapPreserves Second.Carrier FinalSubset.originalSubset (\fun (z: Carrier) => SecondMotion.result (Total.at t z))
    (\fun (y: B)(member: \In[B] subset y) => \idelim Second.inclusion (v y) = SecondMotion.result (Total.at t (inclusion y)) \with q: Second.Carrier => \In[Second.Carrier] FinalSubset.originalSubset q \by {
      base: FinalSubset.original (v y) (vContained (\into[B](y, subset) \by { member })),
      equality: sym!{Second.Carrier} _ _ (SecondMotion.originalFormula t y)
    });
\import \root.Thom[].CWType[].PreservedPaths[A := Carrier, B := Second.Carrier, subset := OriginalSubset.originalSubset, targetSubset := FinalSubset.originalSubset].Concatenation[
  source := topology, target := Second.topology, f := initial, g := middle, k := SecondMap.apply,
  first := FirstMotion.result, second := SecondMotion.result, firstPreserves := firstPreserves, secondPreserves := secondPreserves] \as Joined;
\definition preserves: \forall (t: I.Carrier)(z: \Cast[Carrier] OriginalSubset.originalSubset) -> \In[Second.Carrier] FinalSubset.originalSubset (result (Total.at t z)) := Joined.preserves;
\module Inside(attachesInside: \forall (x: A) -> \In[B] subset (f x));
