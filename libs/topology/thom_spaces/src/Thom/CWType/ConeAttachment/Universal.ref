\import algebraic_topology.Homotopy[A := A, B := D] \as H;
\definition laws: H.Laws[source, range, (\fun (x: A) => point), (\fun (x: A) => original (f x)), homotopy] := H.laws source range (\fun (x: A) => point) (\fun (x: A) => original (f x)) homotopy;
\import \root.Thom[].CWType[].Cone[A := A, source := source].Universal[B := D, target := range, point := point, family := homotopy, zero := laws.start, continuous := laws.continuous] \as ConeMap;
\import Pushout.Universal[D := D] \as Gluing;
\definition compatible: Gluing.Compatible original ConeMap.apply := \fun (x: A) => sym!{D} _ _
  (trans!{D} _ _ _ (ConeMap.onCylinder I.end x) (laws.end x));
\definition apply: Carrier -> D := Gluing.apply original ConeMap.apply compatible;
\definition onOriginal: \forall (y: B) -> apply (inclusion y) = original y := Gluing.onLeft original ConeMap.apply compatible;
\definition onApex: apply apex = point := trans!{D} _ _ _ (Gluing.onRight original ConeMap.apply compatible Cone.apex) ConeMap.onApex;
\definition onCylinder: \forall (t: I.Carrier)(x: A) -> apply (at t x) = homotopy (Cylinder.at t x) :=
  \fun (t: I.Carrier)(x: A) => trans!{D} _ _ _ (Gluing.onRight original ConeMap.apply compatible (Cone.at t x)) (ConeMap.onCylinder t x);
\definition continuous: topology.Continuity[A := Carrier, B := D].Continuous topology range apply :=
  Gluing.continuous target Cone.topology range original ConeMap.apply compatible originalContinuous ConeMap.regular;
