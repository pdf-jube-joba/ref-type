\import \root.Thom[].CWType[].ConeAttachment[A := A, B := D, source := source, target := range, f := next, continuous := nextContinuous] \as Next;
\import Pushout.Universal[D := Next.Carrier] \as Gluing;
\definition original[y: B]: Next.Carrier := Next.inclusion (map y);
\definition compatible: Gluing.Compatible original Next.cone := \fun (x: A) => trans!{Next.Carrier} _ _ _
  (congr!{D Next.Carrier} Next.inclusion _ _ (commutes x)) (Next.attached x);
\definition apply: Carrier -> Next.Carrier := Gluing.apply original Next.cone compatible;
\definition onOriginal: \forall (y: B) -> apply (inclusion y) = Next.inclusion (map y) := Gluing.onLeft original Next.cone compatible;
\definition onCone: \forall (c: Cone.Carrier) -> apply (cone c) = Next.cone c := Gluing.onRight original Next.cone compatible;
\definition onApex: apply apex = Next.apex := onCone Cone.apex;
\definition onCylinder: \forall (t: I.Carrier)(x: A) -> apply (at t x) = Next.at t x := \fun (t: I.Carrier)(x: A) => onCone (Cone.at t x);
\definition continuous: topology.Continuity[A := Carrier, B := Next.Carrier].Continuous topology Next.topology apply :=
  Gluing.continuous target Cone.topology Next.topology original Next.cone compatible
    (topology.Composition[A := B, B := D, C := Next.Carrier].composeContinuous target range Next.topology map Next.inclusion mapContinuous Next.inclusionContinuous) Next.coneContinuous;
