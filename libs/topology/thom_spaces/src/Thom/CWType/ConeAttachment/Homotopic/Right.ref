\import \root.Thom[].CWType[].PathCancellation[A := A, B := Next.Carrier, source := source, target := Next.topology,
  f := (\fun (x: A) => Next.apex), g := (\fun (x: A) => Next.inclusion (g x)), k := (\fun (x: A) => Next.inclusion (f x)), p := Next.null, h := reversePath] \as Cancel;
\definition firstAgrees: \forall (t: I.Carrier)(x: A) -> forwardPath (Cylinder.at t x) = forward (null (Cylinder.at t x)) := \fun (t: I.Carrier)(x: A) => sym!{Next.Carrier} _ _ (forwardCylinder t x);
\definition secondAgrees: \forall (t: I.Carrier)(x: A) -> Cancel.reverse (Cylinder.at t x) = forward (firstPath (Cylinder.at t x)) :=
  \fun (t: I.Carrier)(x: A) => trans!{Next.Carrier} _ _ _
    (congr!{{I.Carrier} Next.Carrier} (\fun (v: I.Carrier) => Next.inclusion (h (Cylinder.at v x))) _ _ (I.reverseInvolutive t))
    (sym!{Next.Carrier} _ _ (forwardOriginal (h (Cylinder.at t x))));
\import \root.Thom[].CWType[].ConcatenationLaws[A := A, B := Carrier, source := source, target := topology,
  f := (\fun (x: A) => apex), g := (\fun (x: A) => inclusion (f x)), k := (\fun (x: A) => inclusion (g x)), h := null, j := firstPath] \as Joined;
\import Joined.Compare[C := A, D := Next.Carrier, domain := source, range := Next.topology, before := (\fun (x: A) => x), after := (\fun (x: A)(y: Carrier) => forward y),
  a := (\fun (x: A) => Next.apex), b := (\fun (x: A) => Next.inclusion (f x)), c := (\fun (x: A) => Next.inclusion (g x)), first := forwardPath, second := Cancel.reverse,
  firstAgrees := firstAgrees, secondAgrees := secondAgrees] \as Formula;
\definition composite[z: Next.Carrier]: Next.Carrier := forward (backward z);
\definition onOriginal: \forall (y: B) -> composite (Next.inclusion y) = Next.inclusion y := \fun (y: B) => trans!{Next.Carrier} _ _ _ (congr!{Carrier Next.Carrier} forward _ _ (backwardOriginal y)) (forwardOriginal y);
\definition onApex: composite Next.apex = Next.apex := trans!{Next.Carrier} _ _ _ (congr!{Carrier Next.Carrier} forward _ _ backwardApex) forwardApex;
\definition onCylinder: \forall (t: I.Carrier)(x: A) -> composite (Next.at t x) = Cancel.detour (Cylinder.at t x) := \fun (t: I.Carrier)(x: A) => trans!{Next.Carrier} _ _ _
  (congr!{Carrier Next.Carrier} forward _ _ (backwardCylinder t x)) (sym!{Next.Carrier} _ _ (Formula.result t x));
\definition filling: algebraic_topology.Homotopy[A := Cylinder.Carrier, B := Next.Carrier].Homotopy[Cylinder.topology source, Next.topology, Cancel.detour, Next.null] :=
  algebraic_topology.Homotopy[A := Cylinder.Carrier, B := Next.Carrier].forgetRelative (Cylinder.topology source) Next.topology Cancel.Ends Cancel.detour Next.null Cancel.result;
\import \root.Thom[].CWType[].ConeAttachment[A := A, B := B, source := source, target := target, f := g, continuous := regular].NullFilling[map := composite, original := onOriginal, mapApex := onApex, path := Cancel.detour, mapCylinder := onCylinder, filling := filling, zero := Cancel.resultAtZero, one := Cancel.resultAtOne] \as Retraction;
\definition result: algebraic_topology.Homotopy[A := Next.Carrier, B := Next.Carrier].Homotopy[Next.topology, Next.topology, composite, (\fun (z: Next.Carrier) => z)] := Retraction.result;
\definition fixed: \forall (u: I.Carrier)(y: B) -> result (algebraic_topology.Cylinder[A := Next.Carrier].at u (Next.inclusion y)) = Next.inclusion y := Retraction.fixed;
