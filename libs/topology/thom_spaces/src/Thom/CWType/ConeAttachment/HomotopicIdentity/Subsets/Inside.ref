\import SourceSubset.Inside[] \as SourceInside;
\import TargetSubset.Inside[] \as TargetInside;
\definition boundaryContained: \forall (t: I.Carrier)(x: A) -> \In[B] subset (Motion.boundary (algebraic_topology.Cylinder[A := A].at t x)) :=
  \fun (t: I.Carrier)(x: A) => homotopyContained t (\into[B](f x, subset) \by { attachesInside x });
\import SourceInside.Homotopic[g := next, regular := regular, h := Motion.boundary, hContained := boundaryContained] \as InsideChange;
\definition equivalence: \root.Thom[].CWType[].PairTools[A := Carrier, B := Next.Carrier, source := topology, target := Next.topology,
  subset := SourceInside.fullSubset, targetSubset := TargetInside.fullSubset].Data :=
  \root.Thom[].CWType[].PairTools[A := Carrier, B := Next.Carrier, source := topology, target := Next.topology,
    subset := SourceInside.fullSubset, targetSubset := TargetInside.fullSubset].Replace[e := InsideChange.equivalence, next := Map.apply, homotopy := comparison, preserves := Preservation.Inside[attachesInside := attachesInside].preserves].result;
