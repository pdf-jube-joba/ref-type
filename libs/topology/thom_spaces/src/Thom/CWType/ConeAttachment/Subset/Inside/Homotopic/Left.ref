\definition preserves: \forall (u: I.Carrier)(z: \Cast[Carrier] fullSubset) -> \In[Carrier] fullSubset (Change.Left[].result (algebraic_topology.Cylinder[A := Carrier].at u z)) := \fun (u: I.Carrier)(z: \Cast[Carrier] fullSubset) =>
  eliminate z (\In[Carrier] fullSubset (Change.Left[].result (algebraic_topology.Cylinder[A := Carrier].at u z)))
    (\fun (y: B)(member: _)(same: inclusion y = z) => \idelim inclusion y = Change.Left[].result (algebraic_topology.Cylinder[A := Carrier].at u z) \with q: Carrier => \In[Carrier] fullSubset q \by {
      base: originalMember y member,
      equality: trans!{Carrier} _ _ _ (sym!{Carrier} _ _ (Change.Left[].fixed u y)) (congr!{Carrier Carrier} (\fun (q: Carrier) => Change.Left[].result (algebraic_topology.Cylinder[A := Carrier].at u q)) _ _ same)
    })
    (\fun (same: apex = z) => \idelim apex = Change.Left[].result (algebraic_topology.Cylinder[A := Carrier].at u z) \with q: Carrier => \In[Carrier] fullSubset q \by {
      base: apexMember,
      equality: trans!{Carrier} _ _ _ (sym!{Carrier} _ _ (Change.Left[].apexFixed u)) (congr!{Carrier Carrier} (\fun (q: Carrier) => Change.Left[].result (algebraic_topology.Cylinder[A := Carrier].at u q)) _ _ same)
    })
    (\fun (t: I.Carrier)(x: A)(same: at t x = z) => \idelim Change.Left[].filling (algebraic_topology.Cylinder[A := Cylinder.Carrier].at u (Cylinder.at t x)) = Change.Left[].result (algebraic_topology.Cylinder[A := Carrier].at u z) \with q: Carrier => \In[Carrier] fullSubset q \by {
      base: LeftFill.preserves u t (\into[A](x, Input.Whole) \by { \refl(x) }),
      equality: trans!{Carrier} _ _ _ (sym!{Carrier} _ _ (Change.Left[].cylinderFormula u t x)) (congr!{Carrier Carrier} (\fun (q: Carrier) => Change.Left[].result (algebraic_topology.Cylinder[A := Carrier].at u q)) _ _ same)
    }) (\bysub(Carrier, fullSubset, z));
