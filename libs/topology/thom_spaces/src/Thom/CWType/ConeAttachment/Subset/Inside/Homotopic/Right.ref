\definition preserves: \forall (u: I.Carrier)(z: \Cast[Next.Carrier] NextInside.fullSubset) -> \In[Next.Carrier] NextInside.fullSubset (Change.Right[].result (algebraic_topology.Cylinder[A := Next.Carrier].at u z)) := \fun (u: I.Carrier)(z: \Cast[Next.Carrier] NextInside.fullSubset) =>
  NextInside.eliminate z (\In[Next.Carrier] NextInside.fullSubset (Change.Right[].result (algebraic_topology.Cylinder[A := Next.Carrier].at u z)))
    (\fun (y: B)(member: _)(same: Next.inclusion y = z) => \idelim Next.inclusion y = Change.Right[].result (algebraic_topology.Cylinder[A := Next.Carrier].at u z) \with q: Next.Carrier => \In[Next.Carrier] NextInside.fullSubset q \by {
      base: NextInside.originalMember y member,
      equality: trans!{Next.Carrier} _ _ _ (sym!{Next.Carrier} _ _ (Change.Right[].fixed u y)) (congr!{Next.Carrier Next.Carrier} (\fun (q: Next.Carrier) => Change.Right[].result (algebraic_topology.Cylinder[A := Next.Carrier].at u q)) _ _ same)
    })
    (\fun (same: Next.apex = z) => \idelim Next.apex = Change.Right[].result (algebraic_topology.Cylinder[A := Next.Carrier].at u z) \with q: Next.Carrier => \In[Next.Carrier] NextInside.fullSubset q \by {
      base: NextInside.apexMember,
      equality: trans!{Next.Carrier} _ _ _ (sym!{Next.Carrier} _ _ (Change.Right[].apexFixed u)) (congr!{Next.Carrier Next.Carrier} (\fun (q: Next.Carrier) => Change.Right[].result (algebraic_topology.Cylinder[A := Next.Carrier].at u q)) _ _ same)
    })
    (\fun (t: I.Carrier)(x: A)(same: Next.at t x = z) => \idelim Change.Right[].filling (algebraic_topology.Cylinder[A := Cylinder.Carrier].at u (Cylinder.at t x)) = Change.Right[].result (algebraic_topology.Cylinder[A := Next.Carrier].at u z) \with q: Next.Carrier => \In[Next.Carrier] NextInside.fullSubset q \by {
      base: RightFill.preserves u t (\into[A](x, Input.Whole) \by { \refl(x) }),
      equality: trans!{Next.Carrier} _ _ _ (sym!{Next.Carrier} _ _ (Change.Right[].cylinderFormula u t x)) (congr!{Next.Carrier Next.Carrier} (\fun (q: Next.Carrier) => Change.Right[].result (algebraic_topology.Cylinder[A := Next.Carrier].at u q)) _ _ same)
    }) (\bysub(Next.Carrier, NextInside.fullSubset, z));
