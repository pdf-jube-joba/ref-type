\import \parent.\parent.Inside[] \as SourceInside;
\import NextSubset.Inside[] \as NextInside;
\import ThirdSubset.Inside[] \as ThirdInside;
\import FourthSubset.Inside[] \as FourthInside;
\definition nextContained: \forall (x: A) -> \In[D] targetSubset (next x) := \fun (x: A) =>
  \idelim e.forward (f x) = next x \with y: D => \In[D] targetSubset y \by {
    base: e.forwardContained (\into[B](f x, subset) \by { attachesInside x }), equality: commutes x
  };
\import \root.Thom[].CWType[].PairCancellation[A := Carrier, B := Next.Carrier, C := Third.Carrier, D := Fourth.Carrier,
  firstSpace := topology, secondSpace := Next.topology, thirdSpace := Third.topology, fourthSpace := Fourth.topology,
  firstSubset := SourceInside.fullSubset, secondSubset := NextInside.fullSubset, thirdSubset := ThirdInside.fullSubset, fourthSubset := FourthInside.fullSubset,
  f := FirstMap.apply, g := SecondMap.apply, h := ThirdMap.apply, fContinuous := FirstMap.continuous, gContinuous := SecondMap.continuous, hContinuous := ThirdMap.continuous,
  fContained := FirstSubsetMap.insideContained, gContained := SecondSubsetMap.insideContained, hContained := ThirdSubsetMap.insideContained,
  first := FirstIdentity.Inside[attachesInside := attachesInside].equivalence, second := SecondIdentity.Inside[attachesInside := nextContained].equivalence,
  firstForward := Ordinary.firstForward, secondForward := Ordinary.secondForward] \as Cancellation;
\definition equivalence: \root.Thom[].CWType[].PairTools[A := Carrier, B := Next.Carrier, source := topology, target := Next.topology,
