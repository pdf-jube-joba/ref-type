\import \parent.\parent.Subset[subset := subset] \as OriginalSubset;
\import Next.Subset[subset := targetSubset] \as FinalSubset;
\definition onOriginalContained: \forall (y: B) -> \In[B] subset y -> \In[Next.Carrier] FinalSubset.originalSubset (apply (inclusion y)) := \fun (y: B)(member: _) =>
  \idelim Next.inclusion (map y) = apply (inclusion y) \with q: Next.Carrier => \In[Next.Carrier] FinalSubset.originalSubset q \by {
    base: FinalSubset.original (map y) (mapContained (\into[B](y, subset) \by { member })), equality: sym!{Next.Carrier} _ _ (onOriginal y)
  };
\definition contained: \forall (z: \Cast[Carrier] OriginalSubset.originalSubset) -> \In[Next.Carrier] FinalSubset.originalSubset (apply z) :=
  OriginalSubset.mapPreserves Next.Carrier FinalSubset.originalSubset apply onOriginalContained;
\import OriginalSubset.Inside[] \as OriginalInside;
\import FinalSubset.Inside[] \as FinalInside;
\definition insideOriginal: \forall (y: B) -> \In[B] subset y -> \In[Next.Carrier] FinalInside.fullSubset (apply (inclusion y)) := \fun (y: B)(member: _) =>
  \idelim Next.inclusion (map y) = apply (inclusion y) \with q: Next.Carrier => \In[Next.Carrier] FinalInside.fullSubset q \by {
    base: FinalInside.originalMember (map y) (mapContained (\into[B](y, subset) \by { member })), equality: sym!{Next.Carrier} _ _ (onOriginal y)
  };
\definition insideApex: \In[Next.Carrier] FinalInside.fullSubset (apply apex) :=
  \idelim Next.apex = apply apex \with q: Next.Carrier => \In[Next.Carrier] FinalInside.fullSubset q \by {
    base: FinalInside.apexMember, equality: sym!{Next.Carrier} _ _ onApex
  };
\definition insideCylinder: \forall (t: I.Carrier)(x: A) -> \In[Next.Carrier] FinalInside.fullSubset (apply (at t x)) := \fun (t: I.Carrier)(x: A) =>
  \idelim Next.at t x = apply (at t x) \with q: Next.Carrier => \In[Next.Carrier] FinalInside.fullSubset q \by {
    base: FinalInside.cylinderMember t x, equality: sym!{Next.Carrier} _ _ (onCylinder t x)
  };
\definition insideContained: \forall (z: \Cast[Carrier] OriginalInside.fullSubset) -> \In[Next.Carrier] FinalInside.fullSubset (apply z) :=
  OriginalInside.mapPreserves Next.Carrier FinalInside.fullSubset apply insideOriginal insideApex insideCylinder;
