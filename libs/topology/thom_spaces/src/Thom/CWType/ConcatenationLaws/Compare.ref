\import algebraic_topology.Cylinder[A := C] \as Domain;
\import algebraic_topology.TimeSubdivision[A := C] \as Subdivision;
\import \root.Thom[].CWType[].ConcatenationLaws[A := C, B := D, source := domain, target := range,
  f := a, g := b, k := c, h := first, j := second] \as Next;
\definition result: \forall (t: I.Carrier)(x: C) -> Next.concatenate (Domain.at t x) = after x (concatenate (Cylinder.at t (before x))) := \block {
  \fun (t: I.Carrier)(x: C) \then
  \return either!{{Subdivision.covered (Domain.at t x)} {Next.concatenate (Domain.at t x) = after x (concatenate (Cylinder.at t (before x)))}
    {\fun (member: _) => \block {
      \let p: Subdivision.Left := \into[Domain.Carrier](Domain.at t x, Subdivision.LeftSet) \by { member } \then
      \let q: Division.Left := \into[Cylinder.Carrier](Cylinder.at t (before x), Division.LeftSet) \by { member } \then
      \return eq_reason_in!{D _
        "=" _ "by" { Next.onLeft p }
        "=" _ "by" { firstAgrees (Subdivision.leftTime p) x }
        "=" _ "by" { congr!{B D} (after x) _ _ (sym!{B} _ _ (onLeft q)) }
      }
    }}
    {\fun (member: _) => \block {
      \let p: Subdivision.Right := \into[Domain.Carrier](Domain.at t x, Subdivision.RightSet) \by { member } \then
      \let q: Division.Right := \into[Cylinder.Carrier](Cylinder.at t (before x), Division.RightSet) \by { member } \then
      \return eq_reason_in!{D _
        "=" _ "by" { Next.onRight p }
        "=" _ "by" { secondAgrees (Subdivision.rightTime p) x }
        "=" _ "by" { congr!{B D} (after x) _ _ (sym!{B} _ _ (onRight q)) }
      }
    }}
  }
};
