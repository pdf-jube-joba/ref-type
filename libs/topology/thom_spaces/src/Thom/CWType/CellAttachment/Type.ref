\import \root.Thom[].CWType[].FiniteType[A := A, source := source] \as Base;
\definition data: Base.Details[model.Carrier] := Base.details model;
\definition next[v: Model.Sphere]: model.Carrier := data.equivalence.forward (attach v);
\definition regular: topology.Continuity[A := Model.Sphere, B := model.Carrier].Continuous Model.sphereTopology data.space next :=
  topology.Composition[A := Model.Sphere, B := A, C := model.Carrier].composeContinuous Model.sphereTopology source data.space attach data.equivalence.forward continuous
    (algebraic_topology.HomotopyEquivalence[A := A, B := model.Carrier].laws source data.space data.equivalence).forwardContinuous;
\definition commutes: \forall (v: Model.Sphere) -> data.equivalence.forward (attach v) = next v := \fun (v: Model.Sphere) => \refl(next v);
\import \root.Thom[].CWType[].CellAttachment[A := model.Carrier, source := data.space, n := n, attach := next, continuous := regular] \as Next;
\import \parent.BaseEquivalence[B := model.Carrier, target := data.space, equivalence := data.equivalence, next := next, regular := regular, commutes := commutes] \as Change;
\import \root.Thom[].CWType[].FiniteType[A := Carrier, source := topology] \as Type;
\import \root.Thom[].CWType[].FiniteType[A := Next.Carrier, source := Next.topology] \as NextType;
\definition exists: \exists Type.Data := \block {
  \takefrom value: NextType.Data \by \root.Thom[].CWType[].FiniteCellTypes[A := model.Carrier, source := data.space, complex := data.complex].theorem n next regular \then
  \takefrom equivalence: algebraic_topology.HomotopyEquivalence[A := Carrier, B := Next.Carrier].Equivalence[topology, Next.topology] \by Change.exists \then
  \return \exact(\root.Thom[].CWType[].FiniteType[A := Carrier, source := topology].Along[B := Next.Carrier, target := Next.topology, equivalence := equivalence, model := value].result, Type.Data)
};
