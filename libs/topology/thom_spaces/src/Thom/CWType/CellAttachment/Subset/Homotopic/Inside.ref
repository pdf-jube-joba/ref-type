\import NextConeSubset.Inside[] \as NextConeInside;
\import ConeInside.Homotopic[g := next, regular := regular, h := homotopy, hContained := hContained] \as InsideChange;
\import \root.Thom[].CWType[].PairTools[A := Attached.Carrier, B := Carrier, source := Attached.topology, target := topology,
  subset := ConeInside.fullSubset, targetSubset := fullSubset] \as Original;
\definition inverse: \root.Thom[].CWType[].PairTools[A := Carrier, B := Attached.Carrier, source := topology, target := Attached.topology,
  subset := fullSubset, targetSubset := ConeInside.fullSubset].Data := Original.Inverse[e := fullEquivalence].result;
\import \root.Thom[].CWType[].PairTools[A := Carrier, B := Attached.Carrier, source := topology, target := Attached.topology,
  subset := fullSubset, targetSubset := ConeInside.fullSubset] \as First;
\definition initial: \root.Thom[].CWType[].PairTools[A := Carrier, B := NextCone.Carrier, source := topology, target := NextCone.topology,
  subset := fullSubset, targetSubset := NextConeInside.fullSubset].Data := First.Composition[C := NextCone.Carrier, range := NextCone.topology,
    finalSubset := NextConeInside.fullSubset, first := inverse, second := InsideChange.equivalence].result;
\definition equivalence: \root.Thom[].CWType[].PairTools[A := Carrier, B := Next.Carrier, source := topology, target := Next.topology,
  subset := fullSubset, targetSubset := NextSubset.fullSubset].Data :=
  \root.Thom[].CWType[].PairTools[A := Carrier, B := NextCone.Carrier, source := topology, target := NextCone.topology,
    subset := fullSubset, targetSubset := NextConeInside.fullSubset].Composition[C := Next.Carrier, range := Next.topology,
      finalSubset := NextSubset.fullSubset, first := initial, second := NextSubset.fullEquivalence].result;
