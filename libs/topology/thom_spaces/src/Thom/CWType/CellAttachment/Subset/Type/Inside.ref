\import \root.Thom[].CWType[].PairFiniteType[A := Carrier, source := topology, subset := fullSubset] \as InsideType;
\import \root.Thom[].CWType[].PairFiniteType[A := Next.Carrier, source := Next.topology, subset := NextSubsets.fullSubset] \as NextInsideType;
\definition nextContained: \forall (v: Model.Sphere) -> \In[model.Carrier] targetSubset (next v) := \fun (v: Model.Sphere) => data.equivalence.forwardContained (\into[A](attach v, subset) \by { contained v });
\definition exists: \exists InsideType.Data := \block {
  \takefrom result: NextInsideType.Data \by Cells.inside n next regular nextContained \then
  \return \exact(InsideType.Along[B := Next.Carrier, target := Next.topology, targetSubset := NextSubsets.fullSubset, e := Change.Inside[attachesInside := contained].equivalence, model := result].result, InsideType.Data)
};
