\import \root.Thom[].CWType[].CellAttachment[A := B, source := target, n := n, attach := next, continuous := regular] \as Next;
\import Next.Subset[subset := targetSubset] \as NextSubset;
\import \root.Thom[].CWType[].ConeAttachment[A := Model.Sphere, B := B, source := Model.sphereTopology, target := target, f := next, continuous := regular] \as NextCone;
\import NextCone.Subset[subset := targetSubset] \as NextConeSubset;
\import ConeSubset.BaseEquivalence[D := B, range := target, targetSubset := targetSubset, e := e, next := next, regular := regular, commutes := commutes] \as Change;
\import \root.Thom[].CWType[].PairTools[A := Attached.Carrier, B := Carrier, source := Attached.topology, target := topology,
  subset := ConeSubset.originalSubset, targetSubset := originalSubset] \as Original;
\definition inverse: \root.Thom[].CWType[].PairTools[A := Carrier, B := Attached.Carrier, source := topology, target := Attached.topology,
  subset := originalSubset, targetSubset := ConeSubset.originalSubset].Data := Original.Inverse[e := originalEquivalence].result;
\import \root.Thom[].CWType[].PairTools[A := Carrier, B := Attached.Carrier, source := topology, target := Attached.topology,
  subset := originalSubset, targetSubset := ConeSubset.originalSubset] \as First;
\definition initial: \root.Thom[].CWType[].PairTools[A := Carrier, B := NextCone.Carrier, source := topology, target := NextCone.topology,
  subset := originalSubset, targetSubset := NextConeSubset.originalSubset].Data := First.Composition[C := NextCone.Carrier, range := NextCone.topology,
    finalSubset := NextConeSubset.originalSubset, first := inverse, second := Change.equivalence].result;
\definition equivalence: \root.Thom[].CWType[].PairTools[A := Carrier, B := Next.Carrier, source := topology, target := Next.topology,
  subset := originalSubset, targetSubset := NextSubset.originalSubset].Data :=
  \root.Thom[].CWType[].PairTools[A := Carrier, B := NextCone.Carrier, source := topology, target := NextCone.topology,
    subset := originalSubset, targetSubset := NextConeSubset.originalSubset].Composition[C := Next.Carrier, range := Next.topology,
      finalSubset := NextSubset.originalSubset, first := initial, second := NextSubset.originalEquivalence].result;
\module Inside(attachesInside: \forall (v: Model.Sphere) -> \In[A] subset (attach v));
