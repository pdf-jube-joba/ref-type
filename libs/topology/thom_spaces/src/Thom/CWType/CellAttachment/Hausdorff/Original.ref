\definition exists: \exists Separation[inclusion a, inclusion b] := \block {
  \takefrom U: \Cast[\Pow A] ({ U: \Pow A \where Base.RegularChoice[source, Base.Singleton b, a, U] })
    \by hausdorff a b (\fun (same: a = b) => different (congr!{A Carrier} inclusion a b same)) \then
  \let u: Base.RegularChoice[source, Base.Singleton b, a, U] := \bysub(\Pow A, { U: \Pow A \where Base.RegularChoice[source, Base.Singleton b, a, U] }, U) \then
  \takefrom V: \Cast[\Pow A] ({ V: \Pow A \where Base.NormalPartner[source, Base.Singleton b, U, V] }) \by u.partner \then
  \let v: Base.NormalPartner[source, Base.Singleton b, U, V] := \bysub(\Pow A, { V: \Pow A \where Base.NormalPartner[source, Base.Singleton b, U, V] }, V) \then
  \return \exact(Separation[inclusion a, inclusion b] {
    first := \parent.\parent.Collar[r := half, below := halfBelow, U := U, open := u.open].region,
    second := \parent.\parent.Collar[r := half, below := halfBelow, U := V, open := v.open].region,
    firstOpen := \parent.\parent.Collar[r := half, below := halfBelow, U := U, open := u.open].regionOpen,
    secondOpen := \parent.\parent.Collar[r := half, below := halfBelow, U := V, open := v.open].regionOpen,
    containsFirst := u.contains, containsSecond := v.covers b (\refl(b)),
    disjoint := \parent.\parent.CollarDisjoint[r := half, below := halfBelow, U := U, V := V, first := u.open, second := v.open, disjoint := v.disjoint].law
  }, Separation[inclusion a, inclusion b])
};
