\import algebraic_topology.Euclidean[].Dimension[n := c.dimension] \as First;
\import algebraic_topology.Euclidean[].Dimension[n := d.dimension] \as Second;
\definition same: \forall (x: Carrier) -> \In[Carrier] (Cells.InteriorImage (oldCell c)) x -> \In[Carrier] (Cells.InteriorImage (oldCell d)) x -> oldCell c = oldCell d := \block {
  \fun (x: Carrier)(left: _)(right: _) \then
  \takefrom p: \Cast[First.Disk] ({ p: First.Disk \where Logic.And[D.Lt (First.normSquared p) R.one, inclusion (c.characteristic p) = x] }) \by left \then
  \let pd: Logic.And[D.Lt (First.normSquared p) R.one, inclusion (c.characteristic p) = x] :=
    \bysub(First.Disk, { p: First.Disk \where Logic.And[D.Lt (First.normSquared p) R.one, inclusion (c.characteristic p) = x] }, p) \then
  \takefrom q: \Cast[Second.Disk] ({ q: Second.Disk \where Logic.And[D.Lt (Second.normSquared q) R.one, inclusion (d.characteristic q) = x] }) \by right \then
  \let qd: Logic.And[D.Lt (Second.normSquared q) R.one, inclusion (d.characteristic q) = x] :=
    \bysub(Second.Disk, { q: Second.Disk \where Logic.And[D.Lt (Second.normSquared q) R.one, inclusion (d.characteristic q) = x] }, q) \then
  \let images: c.characteristic p = d.characteristic q := Cases.leftInjective _ _ (trans!{Carrier} _ _ _ pd.right (sym!{Carrier} _ _ qd.right)) \then
  \let cellsEqual: c = d := (Original.laws source complex).disjoint c d first second (c.characteristic p)
    (Logic.existsIntro[First.Disk, { a: First.Disk \where Logic.And[D.Lt (First.normSquared a) R.one, c.characteristic a = c.characteristic p] }] p (Logic.And[_, _]::# pd.left (\refl(c.characteristic p))))
    (Logic.existsIntro[Second.Disk, { a: Second.Disk \where Logic.And[D.Lt (Second.normSquared a) R.one, d.characteristic a = c.characteristic p] }] q (Logic.And[_, _]::# qd.left (sym!{A} _ _ images))) \then
  \return congr!{Original.CellData Cells.CellData} oldCell c d cellsEqual
};
