\import algebraic_topology.Euclidean[].Dimension[n := c.dimension] \as Disk;
\import topology.Topology[Carrier := Disk.Disk] \as Source;
\import topology.Maps[A := Disk.Disk, B := Carrier] \as Images;
\definition image: Images.Image c.characteristic Source.Whole = Cells.ClosedImage c :=
  \axiom:setext(Images.Image c.characteristic Source.Whole, Cells.ClosedImage c,
    \block {
      \fun (x: Carrier)(inside: _) \then
      \takefrom p: \Cast[Disk.Disk] ({ p: Disk.Disk \where Logic.And[\In[Disk.Disk] Source.Whole p, c.characteristic p = x] }) \by inside \then
      \return Logic.existsIntro[Disk.Disk, { p: Disk.Disk \where c.characteristic p = x }] p (\bysub(Disk.Disk,
        { p: Disk.Disk \where Logic.And[\In[Disk.Disk] Source.Whole p, c.characteristic p = x] }, p)).right
    },
    \block {
      \fun (x: Carrier)(inside: _) \then
      \takefrom p: \Cast[Disk.Disk] ({ p: Disk.Disk \where c.characteristic p = x }) \by inside \then
      \return Logic.existsIntro[Disk.Disk, { p: Disk.Disk \where Logic.And[\In[Disk.Disk] Source.Whole p, c.characteristic p = x] }] p
        (Logic.And[_, _]::# (\refl(p)) (\bysub(Disk.Disk, { p: Disk.Disk \where c.characteristic p = x }, p)))
    });
\definition closed: Space.IsClosedIn topology (Cells.ClosedImage c) :=
  \idelim Images.Image c.characteristic Source.Whole = Cells.ClosedImage c \with S: \Pow Carrier => Space.IsClosedIn topology S \by {
    base: Space.Compactness[].compactClosed topology hausdorff (Images.Image c.characteristic Source.Whole)
      (topology.Compactness[A := Disk.Disk, B := Carrier].continuousImage Disk.diskTopology topology c.characteristic continuous Source.Whole Disk.Compactness[].compact),
    equality: image
  };
