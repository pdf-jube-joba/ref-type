\import algebraic_topology.Euclidean[].Dimension[n := c.dimension] \as Disk;
\definition different: \forall (x: Carrier) -> \In[Carrier] (Cells.InteriorImage (oldCell c)) x -> \In[Carrier] (Cells.InteriorImage newCell) x -> Logic.False := \block {
  \fun (x: Carrier)(old: _)(new: _) \then
  \takefrom p: \Cast[Disk.Disk] ({ p: Disk.Disk \where Logic.And[D.Lt (Disk.normSquared p) R.one, inclusion (c.characteristic p) = x] }) \by old \then
  \let pd: Logic.And[D.Lt (Disk.normSquared p) R.one, inclusion (c.characteristic p) = x] := \bysub(Disk.Disk,
    { p: Disk.Disk \where Logic.And[D.Lt (Disk.normSquared p) R.one, inclusion (c.characteristic p) = x] }, p) \then
  \takefrom q: \Cast[Model.Disk] ({ q: Model.Disk \where Logic.And[D.Lt (Model.normSquared q) R.one, characteristic q = x] }) \by new \then
  \let qd: Logic.And[D.Lt (Model.normSquared q) R.one, characteristic q = x] := \bysub(Model.Disk,
    { q: Model.Disk \where Logic.And[D.Lt (Model.normSquared q) R.one, characteristic q = x] }, q) \then
  \let point: InteriorPoint := \into[Model.Disk](q, interiorSubset) \by { qd.left } \then
  \return Cases.leftRightDifferent (c.characteristic p) point (trans!{Carrier} _ _ _ pd.right
    (trans!{Carrier} _ _ _ (sym!{Carrier} _ _ qd.right) (onInterior point)))
};
