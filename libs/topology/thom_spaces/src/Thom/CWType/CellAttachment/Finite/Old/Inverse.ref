\module With(O: \Pow A, regular: Base.IsOpenIn source O,
  same: Original.InteriorPart c U = Base.Intersection (Original.InteriorImage c) O);
\definition exists: \exists (V: \Pow Carrier \where Logic.And[Space.IsOpenIn topology V, Cells.InteriorPart (oldCell c) U = Space.Intersection (Cells.InteriorImage (oldCell c)) V]) := \block {
  \takefrom O: \Cast[\Pow A] ({ O: \Pow A \where Logic.And[Base.IsOpenIn source O, Original.InteriorPart c U = Base.Intersection (Original.InteriorImage c) O] })
    \by ((Original.laws source complex).cellLaws c member).inverseContinuous U open \then
  \let data: Logic.And[Base.IsOpenIn source O, Original.InteriorPart c U = Base.Intersection (Original.InteriorImage c) O] :=
    \bysub(\Pow A, { O: \Pow A \where Logic.And[Base.IsOpenIn source O, Original.InteriorPart c U = Base.Intersection (Original.InteriorImage c) O] }, O) \then
  \return With[O := O, regular := data.left, same := data.right].exists
};
