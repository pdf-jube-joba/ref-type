\import algebraic_topology.Euclidean[].Dimension[n := c.dimension] \as Disk;
\definition continuous: topology.Continuity[A := Disk.Disk, B := Carrier].Continuous Disk.diskTopology topology (oldCell c).characteristic :=
  topology.Composition[A := Disk.Disk, B := A, C := Carrier].composeContinuous Disk.diskTopology source topology c.characteristic inclusion
    ((Original.laws source complex).cellLaws c member).continuous inclusionContinuous;
\definition closed: Space.IsClosedIn topology (Cells.ClosedImage (oldCell c)) := \parent.ClosedCell[c := oldCell c, continuous := continuous].closed;
\definition injective: \forall (p, q: Disk.Disk) -> D.Lt (Disk.normSquared p) R.one -> D.Lt (Disk.normSquared q) R.one -> (oldCell c).characteristic p = (oldCell c).characteristic q -> p = q :=
  \fun (p, q: Disk.Disk)(first: _)(second: _)(same: _) => ((Original.laws source complex).cellLaws c member).injectiveInterior p q first second
    (Cases.leftInjective (c.characteristic p) (c.characteristic q) same);
\module Inverse(U: \Pow Disk.Disk, open: Original.DiskOpen c.dimension U);
\definition inverseContinuous: \forall (U: \Pow Disk.Disk) -> Original.DiskOpen c.dimension U ->
  \exists (V: \Pow Carrier \where Logic.And[Space.IsOpenIn topology V, Cells.InteriorPart (oldCell c) U = Space.Intersection (Cells.InteriorImage (oldCell c)) V]) :=
  \fun (U: \Pow Disk.Disk)(open: _) => Inverse[U := U, open := open].exists;
\definition laws: Cells.CellLaws[topology, oldCell c] := Cells.CellLaws[topology, oldCell c] {
  continuous := continuous, closed := closed, injectiveInterior := injective, inverseContinuous := inverseContinuous
};
