\import Filtration.Stage[limit := N.Nat^::succ k] \as Upper;
\definition ambient[x: Domain.Disk]: A := Upper.inclusion (f x);
\module Higher(above: Nat.Lt m k);
\definition exists: \exists Result[ambient] :=
  \match NatOrder.trichotomy m k \in Ordering.Trichotomy \return (\fun (_: NatOrder.Trichotomy m k) => \exists Result[ambient]) \with {
    | less above: Higher[above := above].exists
    | equal same: \exact(\parent.Below[limit := N.Nat^::succ k, bound := (\idelim m = k \with n: N.Nat^ => Nat.Le (N.Nat^::succ n) targetLimit \by {
        base: Nat.leRefl targetLimit, equality: same
      }), f := f, continuous := continuous].result, Result[ambient])
    | greater below: \exact(\parent.Below[limit := N.Nat^::succ k, bound := Nat.leSuccSucc k m
        (Nat.leTrans k (N.Nat^::succ k) m (Nat.leSelfSucc k) (Nat.succLeOfLt m k below)), f := f, continuous := continuous].result, Result[ambient])
  };
