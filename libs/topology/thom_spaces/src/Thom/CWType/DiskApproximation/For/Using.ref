\definition family: Homotopies.Family := result.homotopy;
\definition homotopy: Homotopies.RelativeHomotopy[Domain.diskTopology, source, fixed, f, (\fun (x: Domain.Disk) => Target.inclusion (result.value x))] :=
  \into[Homotopies.Family](family, Homotopies.RelativeHomotopy[Domain.diskTopology, source, fixed, f, (\fun (x: Domain.Disk) => Target.inclusion (result.value x))]) \by {
    Homotopies.RelativeLaws[Domain.diskTopology, source, fixed, f, (\fun (x: Domain.Disk) => Target.inclusion (result.value x)), family] {
      homotopy := Homotopies.Laws[Domain.diskTopology, source, f, (\fun (x: Domain.Disk) => Target.inclusion (result.value x)), family] {
        continuous := (Homotopies.relativeLaws Domain.diskTopology source fixed lifted (\fun (x: Domain.Disk) => Target.inclusion (result.value x)) result.homotopy).homotopy.continuous,
        start := \fun (x: Domain.Disk) => trans!{A} _ _ _
          ((Homotopies.relativeLaws Domain.diskTopology source fixed lifted (\fun (x: Domain.Disk) => Target.inclusion (result.value x)) result.homotopy).homotopy.start x) (liftEquals x),
        end := (Homotopies.relativeLaws Domain.diskTopology source fixed lifted (\fun (x: Domain.Disk) => Target.inclusion (result.value x)) result.homotopy).homotopy.end
      },
      fixed := \fun (t: I.Carrier)(x: Domain.Disk)(inside: _) => trans!{A} _ _ _
        ((Homotopies.relativeLaws Domain.diskTopology source fixed lifted (\fun (x: Domain.Disk) => Target.inclusion (result.value x)) result.homotopy).fixed t x inside) (liftEquals x)
    }
  };
\definition result: Result[f] := Result[f] { value := result.value, continuous := result.continuous, homotopy := homotopy };
