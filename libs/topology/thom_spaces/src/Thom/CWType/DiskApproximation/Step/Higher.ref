\import \root.Thom[].CWType[].TopCells[m := m, k := k, A := A, source := source, complex := complex, larger := above].For[f := f, continuous := continuous] \as Lowering;
\module Using(lowering: Lowering.Lowering);
\definition exists: \exists Result[ambient] := \block {
  \takefrom lowering: Lowering.Lowering \by Lowering.lowering \then
  \return Using[lowering := lowering].exists
};
