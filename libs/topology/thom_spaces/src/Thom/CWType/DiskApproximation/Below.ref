\import Filtration.Stage[limit := limit] \as Stage;
\definition ambient[x: Domain.Disk]: A := Stage.inclusion (f x);
\definition ambientContinuous: topology.Continuity[A := Domain.Disk, B := A].Continuous Domain.diskTopology source ambient :=
  topology.Composition[A := Domain.Disk, B := Stage.Carrier, C := A].composeContinuous Domain.diskTopology Stage.topology source f Stage.inclusion continuous Stage.continuous;
\definition value[x: Domain.Disk]: Target.Carrier := \into[A](ambient x, Filtration.subset targetLimit) \by {
  Filtration.monotone limit targetLimit bound (f x) (\bysub(A, Filtration.subset limit, f x))
};
\definition valueContinuous: topology.Continuity[A := Domain.Disk, B := Target.Carrier].Continuous Domain.diskTopology Target.topology value :=
  topology.Continuity[A := Domain.Disk, B := A].Corestriction[S := Filtration.subset targetLimit].corestrictContinuous Domain.diskTopology source value ambientContinuous;
\definition result: Result[ambient] := Result[ambient] {
  value := value, continuous := valueContinuous, homotopy := Homotopies.constantRelative Domain.diskTopology source fixed ambient ambientContinuous
};
