\import topology.Topology[Carrier := A] \as Space;
\import \parent.FiniteType[A := A, source := source] \as Models;
\definition Property: \Prop := Logic.And[Space.IsCompact source, \exists Models.Data];
\module Native(complex: algebraic_topology.CW[A := A].FiniteComplex[source]);
\module Homeomorphic(B: \Set, target: topology.Topology[Carrier := B].Topology,
  h: topology.Homeomorphism[A := A, B := B].Homeomorphism[source, target]);
