\import real.Analysis[] \as R;
\import Euclidean.Dimension[n := N.Nat^::zero] \as Disk;
\import \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := N.Nat^::zero, attach := attach, continuous := continuous] \as Attached;
\import singular_cellular.On[A := A, source := source, complex := complex].Filtration[] \as Filtration;
\definition lands: \forall (v: Disk.Sphere) -> \In[A] (Filtration.subset N.Nat^::zero) (attach v) := \fun (v: Disk.Sphere) =>
  Logic.falseElim _ (dedekind_reals.DedekindReal[].Arithmetic[].Prop[].zeroNeOne (\bysub(Disk.Coordinate, Disk.Boundary, v)));
\import \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := N.Nat^::zero, attach := attach, continuous := continuous].Finite[complex := complex].Cellular[lands := lands] \as CW;
\import \root.Thom[].CWType[].FiniteType[A := Attached.Carrier, source := Attached.topology] \as Type;
\definition identity: topology.Homeomorphism[A := Attached.Carrier, B := Attached.Carrier].Homeomorphism[Attached.topology, Attached.topology] :=
  topology.Homeomorphism[A := Attached.Carrier, B := Attached.Carrier].Homeomorphism[Attached.topology, Attached.topology] {
    forward := \fun (x: Attached.Carrier) => x, backward := \fun (x: Attached.Carrier) => x,
    forwardContinuous := topology.Maps[A := Attached.Carrier, B := Attached.Carrier].Identity[].continuous Attached.topology,
    backwardContinuous := topology.Maps[A := Attached.Carrier, B := Attached.Carrier].Identity[].continuous Attached.topology,
    leftInverse := \fun (x: Attached.Carrier) => \refl(x), rightInverse := \fun (x: Attached.Carrier) => \refl(x)
  };
\definition model: Type.Data := Type.pack Attached.Carrier (Type.Details[Attached.Carrier] {
  space := Attached.topology, complex := CW.complex,
  equivalence := algebraic_topology.HomotopyEquivalence[A := Attached.Carrier, B := Attached.Carrier].fromHomeomorphism Attached.topology Attached.topology identity
});
\definition exists: \exists Type.Data := \exact(model, Type.Data);
