\import singular_cellular.On[A := A, source := source, complex := complex].Filtration[] \as Filtration;
\import Filtration.Stage[limit := N.Nat^::succ d] \as Target;
\import Euclidean.Dimension[n := N.Nat^::succ d] \as Sphere;
\definition attachNext[v: Sphere.Sphere]: A := Target.inclusion (approximation.value v);
\definition regular: topology.Continuity[A := Sphere.Sphere, B := A].Continuous Sphere.sphereTopology source attachNext :=
  topology.Composition[A := Sphere.Sphere, B := Target.Carrier, C := A].composeContinuous Sphere.sphereTopology Target.topology source approximation.value Target.inclusion approximation.continuous Target.continuous;
\definition lands: \forall (v: Sphere.Sphere) -> \In[A] (Filtration.subset (N.Nat^::succ d)) (attachNext v) :=
  \fun (v: Sphere.Sphere) => \bysub(A, Filtration.subset (N.Nat^::succ d), approximation.value v);
\import \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := N.Nat^::succ d, attach := attachNext, continuous := regular] \as Next;
\import \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := N.Nat^::succ d, attach := attachNext, continuous := regular].Finite[complex := complex].Cellular[lands := lands] \as CW;
\import \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := N.Nat^::succ d, attach := attach, continuous := continuous].Homotopic[next := attachNext, regular := regular, homotopy := approximation.homotopy] \as Change;
\definition model: Type.Data := Type.pack Next.Carrier (Type.Details[Next.Carrier] { space := Next.topology, complex := CW.complex, equivalence := Change.equivalence });
\definition exists: \exists Type.Data := \exact(model, Type.Data);
