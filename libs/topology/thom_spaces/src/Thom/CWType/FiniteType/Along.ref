\import \root.Thom[].CWType[].FiniteType[A := B, source := target] \as Type;
\definition details: Type.Details[model.Carrier] := Type.details model;
\definition result: Data := pack model.Carrier (Details[model.Carrier] {
  space := details.space, complex := details.complex,
  equivalence := algebraic_topology.HomotopyEquivalence[A := A, B := B].Composition[C := model.Carrier].compose source target details.space equivalence details.equivalence
});
