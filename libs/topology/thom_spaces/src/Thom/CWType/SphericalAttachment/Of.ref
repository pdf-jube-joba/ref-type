\definition polePair[v: Base.Sphere]: Boundary.CarrierSet := Pair.pair Base.Sphere FiberSphere.Sphere v fiber.pole;
\definition polePairContinuous: topology.Continuity[A := Base.Sphere, B := Boundary.CarrierSet].Continuous Base.sphereTopology boundaryTopology polePair :=
  Boundary.Universal[X := Base.Sphere].pairContinuous Base.sphereTopology Base.sphereTopology FiberSphere.sphereTopology (\fun (v: Base.Sphere) => v) (\fun (v: Base.Sphere) => fiber.pole)
    (topology.Maps[A := Base.Sphere, B := Base.Sphere].Identity[].continuous Base.sphereTopology) (topology.Maps[A := Base.Sphere, B := FiberSphere.Sphere].constantContinuous Base.sphereTopology FiberSphere.sphereTopology fiber.pole);
\definition firstAttach[v: Base.Sphere]: A := data.boundary (polePair v);
\definition firstRegular: topology.Continuity[A := Base.Sphere, B := A].Continuous Base.sphereTopology source firstAttach :=
  topology.Composition[A := Base.Sphere, B := Boundary.CarrierSet, C := A].composeContinuous Base.sphereTopology boundaryTopology source polePair data.boundary polePairContinuous data.boundaryContinuous;
\import \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := d, attach := firstAttach, continuous := firstRegular] \as First;
\module SecondBoundary;
\import \root.Thom[].CWType[].CellAttachment[A := First.Carrier, source := First.topology, n := Geometry.dimension, attach := SecondBoundary[].apply, continuous := SecondBoundary[].continuous] \as Second;
\module Map;
\module Representation;
\module Injectivity;
\module Surjectivity;
\module Comparison(compact: topology.Topology[Carrier := A].IsCompact source, hausdorff: topology.Topology[Carrier := Y].IsT2 target);
