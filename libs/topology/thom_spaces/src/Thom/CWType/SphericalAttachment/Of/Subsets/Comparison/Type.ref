\import \root.Thom[].CWType[].PairFiniteType[A := First.Carrier, source := First.topology, subset := FirstSubset.fullSubset] \as FirstType;
\import \root.Thom[].CWType[].PairFiniteType[A := Second.Carrier, source := Second.topology, subset := SecondSubset.fullSubset] \as SecondType;
\import \root.Thom[].CWType[].PairFiniteType[A := Y, source := target, subset := targetSubset] \as Type;
\definition exists: \exists Type.Data := \block {
  \takefrom first: FirstType.Data \by FirstSubset.Type[model := model].Inside[contained := firstContained].exists \then
  \takefrom second: SecondType.Data \by SecondSubset.Type[model := first].Inside[contained := secondContained].exists \then
  \return \exact(Type.Along[B := Second.Carrier, target := Second.topology, targetSubset := SecondSubset.fullSubset,
    e := Pairs.Inverse[e := equivalence].result, model := second].result, Type.Data)
};
