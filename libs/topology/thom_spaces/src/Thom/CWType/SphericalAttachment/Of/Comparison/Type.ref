\import \root.Thom[].CWType[].FiniteType[A := First.Carrier, source := First.topology] \as FirstType;
\import \root.Thom[].CWType[].FiniteType[A := Second.Carrier, source := Second.topology] \as SecondType;
\import \root.Thom[].CWType[].FiniteType[A := Y, source := target] \as Type;
\definition exists: \exists Type.Data := \block {
  \takefrom first: FirstType.Data \by \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := d, attach := firstAttach, continuous := firstRegular].Type[model := model].exists \then
  \takefrom second: SecondType.Data \by \root.Thom[].CWType[].CellAttachment[A := First.Carrier, source := First.topology, n := Geometry.dimension, attach := \parent.\parent.SecondBoundary[].apply, continuous := \parent.\parent.SecondBoundary[].continuous].Type[model := first].exists \then
  \return \exact(\root.Thom[].CWType[].FiniteType[A := Y, source := target].Along[B := Second.Carrier, target := Second.topology, equivalence := inverseEquivalence, model := second].result, Type.Data)
};
