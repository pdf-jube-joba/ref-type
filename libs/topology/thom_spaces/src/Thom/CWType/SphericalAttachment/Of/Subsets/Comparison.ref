\import \parent.\parent.Comparison[compact := compact, hausdorff := hausdorff] \as Ordinary;
\definition laws: topology.Homeomorphism[A := Second.Carrier, B := Y].Laws[Second.topology, target, Ordinary.homeomorphism] := topology.Homeomorphism[A := Second.Carrier, B := Y].laws Second.topology target Ordinary.homeomorphism;
\definition backwardContained: \forall (y: \Cast[Y] targetSubset) -> \In[Second.Carrier] SecondSubset.fullSubset (Ordinary.homeomorphism.backward y) := \fun (y: \Cast[Y] targetSubset) =>
  reflects (Ordinary.homeomorphism.backward y) (\idelim y = Mapping.apply (Ordinary.homeomorphism.backward y) \with q: Y => \In[Y] targetSubset q \by {
    base: \bysub(Y, targetSubset, y), equality: sym!{Y} _ _ (laws.rightInverse y)
  });
\import \root.Thom[].CWType[].PairTools[A := Second.Carrier, B := Y, source := Second.topology, target := target, subset := SecondSubset.fullSubset, targetSubset := targetSubset] \as Pairs;
\definition equivalence: Pairs.Data := Pairs.Homeomorphic[h := Ordinary.homeomorphism, forwardContained := preserves, backwardContained := backwardContained].result;
\module Type(model: \root.Thom[].CWType[].PairFiniteType[A := A, source := source, subset := subset].Data);
