\definition firstCompact: topology.Topology[Carrier := First.Carrier].IsCompact First.topology := First.compact compact;
\definition secondCompact: topology.Topology[Carrier := Second.Carrier].IsCompact Second.topology := Second.compact firstCompact;
\definition homeomorphism: topology.Homeomorphism[A := Second.Carrier, B := Y].Homeomorphism[Second.topology, target] :=
  \root.Thom[].CWType[].CompactBijection[A := Second.Carrier, B := Y, source := Second.topology, target := target, compact := secondCompact, hausdorff := hausdorff,
    f := \parent.Map[].apply, injective := \parent.Injectivity[].injective, onto := \parent.Surjectivity[].onto, continuous := \parent.Map[].continuous].homeomorphism;
\definition inverseEquivalence: algebraic_topology.HomotopyEquivalence[A := Y, B := Second.Carrier].Equivalence[target, Second.topology] :=
  algebraic_topology.HomotopyEquivalence[A := Y, B := Second.Carrier].fromHomeomorphism target Second.topology
    (topology.Homeomorphism[A := Second.Carrier, B := Y].Inverse[].inverse Second.topology target homeomorphism);
\module Type(model: \root.Thom[].CWType[].FiniteType[A := A, source := source].Data);
