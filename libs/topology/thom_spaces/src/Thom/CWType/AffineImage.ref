\import \parent.PiecewiseAffine[m := m] \as Affine;
\import Affine.Linearization[] \as Expansion;
\import real.Analysis[] \as R;
\import R.FiniteSums[] \as Sums;
\import \parent.LinearKernel[] \as Kernel;
\import \parent.Hyperplanes[n := n] \as Planes;
\import algebraic_topology.Euclidean[].Dimension[n := m] \as Source;
\import algebraic_topology.Euclidean[].Dimension[n := n] \as Target;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\definition value[x: Source.Coordinate][i: Fin.Fin n]: R.Real := Affine.affine (forms i) x;
\definition matrix[j: Fin.Fin m][i: Fin.Fin n]: R.Real := Expansion.coefficient (forms i) j;
\definition Contained[p: Planes.Plane]: \Prop := \forall (x: Source.Coordinate) -> Kernel.dot n p.normal (value x) = p.offset;
\module With(witness: Kernel.Witness[m, n, matrix]);
\definition exists: \exists (p: Planes.Plane \where Contained p) := \block {
  \takefrom witness: Kernel.Witness[m, n, matrix] \by Kernel.exists m n larger matrix \then
  \return Logic.existsIntro[Planes.Plane, { p: Planes.Plane \where Contained p }] With[witness := witness].plane With[witness := witness].contained
};
