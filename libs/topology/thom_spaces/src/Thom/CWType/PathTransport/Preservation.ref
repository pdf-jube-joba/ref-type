\definition CylinderSubset: \Pow Cylinder.Carrier := { z: Cylinder.Carrier \where \In[A] subset (Cylinder.point z) };
\definition firstPreserves: \forall (t: I.Carrier)(z: \Cast[Cylinder.Carrier] CylinderSubset) -> \In[B] targetSubset (first (Double.at t z)) :=
  \fun (t: I.Carrier)(z: \Cast[Cylinder.Carrier] CylinderSubset) => pPreserves t (\into[A](Cylinder.point z, subset) \by { \bysub(Cylinder.Carrier, CylinderSubset, z) });
\definition secondPreserves: \forall (t: I.Carrier)(z: \Cast[Cylinder.Carrier] CylinderSubset) -> \In[B] targetSubset (second (Double.at t z)) :=
  \fun (t: I.Carrier)(z: \Cast[Cylinder.Carrier] CylinderSubset) => hPreserves (time (Double.at t z)) (\into[A](Cylinder.point z, subset) \by { \bysub(Cylinder.Carrier, CylinderSubset, z) });
\import \root.Thom[].CWType[].PreservedPaths[A := Cylinder.Carrier, B := B, subset := CylinderSubset, targetSubset := targetSubset].Concatenation[
  source := Cylinder.topology source, target := target, f := start, g := middle, k := endpoint,
  first := first, second := second, firstPreserves := firstPreserves, secondPreserves := secondPreserves] \as Joined;
\definition preserves: \forall (u, t: I.Carrier)(x: \Cast[A] subset) -> \In[B] targetSubset (apply (Double.at u (Cylinder.at t x))) :=
  \fun (u, t: I.Carrier)(x: \Cast[A] subset) => Joined.preserves t (\into[Cylinder.Carrier](Cylinder.at u x, CylinderSubset) \by { \bysub(A, subset, x) });
\definition singlePreserves: \forall (u, t: I.Carrier)(x: \Cast[A] subset) -> \In[B] targetSubset (singleApply (Double.at u (Cylinder.at t x))) :=
  \fun (u, t: I.Carrier)(x: \Cast[A] subset) => pPreserves (I.Convex[].blend u (Reindex.Compression[].firstClock (Cylinder.at t x)) t) x;
