\import algebraic_topology.Euclidean[].Dimension[n := m] \as Source;
\import algebraic_topology.Euclidean[].Dimension[n := n] \as Target;
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as D;
\import \parent.PiecewiseAffine[m := m] \as Affine;
\import topological_algebra.Coordinates[K := R.Real, I := Fin.Fin n] \as Coordinates;
\module Of(f: Source.Disk -> Target.Coordinate,
  continuous: topology.Continuity[A := Source.Disk, B := Target.Coordinate].Continuous Source.diskTopology Target.topology f);
