\import \root.Thom[].CWType[].CompactPairType[A := B, source := target, subset := targetSubset] \as Target;
\import \root.Thom[].CWType[].PairFiniteType[A := B, source := target, subset := targetSubset] \as TargetModels;
\definition laws: topology.Homeomorphism[A := A, B := B].Laws[source, target, h] := topology.Homeomorphism[A := A, B := B].laws source target h;
\definition onto: \forall (x: A) -> \exists (y: B \where h.backward y = x) := \fun (x: A) => Logic.existsIntro[B, { y: B \where h.backward y = x }] (h.forward x) (laws.leftInverse x);
\definition equivalence: \root.Thom[].CWType[].PairTools[A := A, B := B, source := source, target := target, subset := subset, targetSubset := targetSubset].Data :=
  \root.Thom[].CWType[].PairTools[A := A, B := B, source := source, target := target, subset := subset, targetSubset := targetSubset].Homeomorphic[h := h, forwardContained := forwardContained, backwardContained := backwardContained].result;
\definition fromTarget: Target.Property -> Property := \fun (property: Target.Property) => Logic.And[_, _]::#
  (topology.Compactness[A := B, B := A].surjectiveImage target source h.backward laws.backwardContinuous onto property.left)
  (\block {
    \takefrom model: TargetModels.Data \by property.right \then
    \return \exact(Models.Along[B := B, target := target, targetSubset := targetSubset, e := equivalence, model := model].result, Models.Data)
  });
