    forward := e.backward, backward := e.forward,
    forwardContinuous := e.backwardContinuous, backwardContinuous := e.forwardContinuous,
    forwardContained := e.backwardContained, backwardContained := e.forwardContained,
    left := e.right, right := e.left, leftPreserves := e.rightPreserves, rightPreserves := e.leftPreserves
  };
