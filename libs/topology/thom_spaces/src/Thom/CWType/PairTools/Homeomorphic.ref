\definition laws: topology.Homeomorphism[A := A, B := B].Laws[source, target, h] := topology.Homeomorphism[A := A, B := B].laws source target h;
\definition left: Left.Homotopy[source, source, (\fun (x: A) => h.backward (h.forward x)), (\fun (x: A) => x)] :=
  \into[Left.Family](LeftCylinder.point, Left.Homotopy[source, source, (\fun (x: A) => h.backward (h.forward x)), (\fun (x: A) => x)]) \by {
    Left.Laws[source, source, (\fun (x: A) => h.backward (h.forward x)), (\fun (x: A) => x), LeftCylinder.point] {
      continuous := LeftCylinder.pointContinuous source, start := \fun (x: A) => sym!{A} _ _ (laws.leftInverse x), end := \fun (x: A) => \refl(x)
    }
  };
\definition right: Right.Homotopy[target, target, (\fun (y: B) => h.forward (h.backward y)), (\fun (y: B) => y)] :=
  \into[Right.Family](RightCylinder.point, Right.Homotopy[target, target, (\fun (y: B) => h.forward (h.backward y)), (\fun (y: B) => y)]) \by {
    Right.Laws[target, target, (\fun (y: B) => h.forward (h.backward y)), (\fun (y: B) => y), RightCylinder.point] {
      continuous := RightCylinder.pointContinuous target, start := \fun (y: B) => sym!{B} _ _ (laws.rightInverse y), end := \fun (y: B) => \refl(y)
    }
  };
\definition result: Data := Data {
  forward := h.forward, backward := h.backward, forwardContinuous := laws.forwardContinuous, backwardContinuous := laws.backwardContinuous,
  forwardContained := forwardContained, backwardContained := backwardContained,
  left := left, right := right,
  leftPreserves := \fun (t: I.Carrier)(x: SourceSubset) => \bysub(A, subset, x),
  rightPreserves := \fun (t: I.Carrier)(y: TargetSubset) => \bysub(B, targetSubset, y)
};
