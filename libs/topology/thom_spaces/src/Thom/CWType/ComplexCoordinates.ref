\import complex.Complex[] \as C;
\import bundle_operations.Operations[].Scalars[] \as Scalars;
\import \parent.ScalarCoordinates[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Coordinates;
\definition data: Coordinates.Data := Coordinates.Data {
  dimension := \fun (n: N.Nat^) => Scalars.RealCoordinates[n := n].dimension,
  frame := \fun (n: N.Nat^) => Scalars.RealCoordinates[n := n].frame,
  forwardContinuous := \fun (n: N.Nat^) => Scalars.RealCoordinates[n := n].Topology[].forwardContinuous,
  backwardContinuous := \fun (n: N.Nat^) => Scalars.RealCoordinates[n := n].Topology[].backwardContinuous
};
