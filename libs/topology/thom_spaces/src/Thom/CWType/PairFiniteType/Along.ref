\import \root.Thom[].CWType[].PairFiniteType[A := B, source := target, subset := targetSubset] \as Type;
\definition data: Type.Details[model.Carrier] := Type.details model;
\definition finalSubset: \Pow model.Carrier := algebraic_topology.CW[A := model.Carrier].Pair[source := data.space, complex := data.complex].Of[subcomplex := data.part].Subset;
\definition result: Data := pack model.Carrier (Details[model.Carrier] {
  space := data.space, complex := data.complex, part := data.part,
  equivalence := \root.Thom[].CWType[].PairTools[A := A, B := B, source := source, target := target, subset := subset, targetSubset := targetSubset].Composition[
    C := model.Carrier, range := data.space, finalSubset := finalSubset, first := e, second := data.equivalence].result
});
