\import algebraic_topology.CW[A := A].Pair[source := source, complex := complex].Of[subcomplex := part] \as Part;
\definition identity: topology.Homeomorphism[A := A, B := A].Homeomorphism[source, source] := \root.Thom[].CWType[].FiniteType[A := A, source := source].identity;
\definition forwardContained: \forall (x: \Cast[A] subset) -> \In[A] Part.Subset x := \fun (x: \Cast[A] subset) =>
  \idelim subset = Part.Subset \with S: \Pow A => \In[A] S x \by { base: \bysub(A, subset, x), equality: agrees };
\definition backwardContained: \forall (x: \Cast[A] Part.Subset) -> \In[A] subset x := \fun (x: \Cast[A] Part.Subset) =>
  \idelim Part.Subset = subset \with S: \Pow A => \In[A] S x \by { base: \bysub(A, Part.Subset, x), equality: sym!{{\Pow A}} _ _ agrees };
\definition result: Data := pack A (Details[A] {
  space := source, complex := complex, part := part,
  equivalence := \root.Thom[].CWType[].PairTools[A := A, B := A, source := source, target := source, subset := subset, targetSubset := Part.Subset].Homeomorphic[
    h := identity, forwardContained := forwardContained, backwardContained := backwardContained].result
});
