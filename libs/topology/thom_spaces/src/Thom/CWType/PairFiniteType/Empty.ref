\definition complex: algebraic_topology.CW[A := A].FiniteComplex[source] := \root.Thom[].CWType[].EmptyComplex[A := A, source := source, empty := empty].complex;
\import algebraic_topology.CW[A := A].Pair[source := source, complex := complex] \as Pair;
\definition agrees: subset = Pair.Of[subcomplex := Pair.empty].Subset := \axiom:setext(subset, Pair.Of[subcomplex := Pair.empty].Subset,
  \fun (x: A)(member: _) => Logic.falseElim (\In[A] Pair.Of[subcomplex := Pair.empty].Subset x) (empty x),
  \fun (x: A)(member: _) => Logic.falseElim (\In[A] subset x) (empty x));
\definition result: Data := \parent.Native[complex := complex, part := Pair.empty, agrees := agrees].result;
