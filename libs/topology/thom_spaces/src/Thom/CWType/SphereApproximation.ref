\import real.Analysis[] \as R;
\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Euclidean[].Dimension[n := d] \as Disk;
\import algebraic_topology.Euclidean[].Dimension[n := N.Nat^::succ d] \as Sphere;
\import algebraic_topology.Cylinder[A := Disk.Disk] \as DiskCylinder;
\import algebraic_topology.Cylinder[A := Sphere.Sphere] \as Cylinder;
\import algebraic_topology.Homotopy[A := Disk.Disk, B := A] \as DiskHomotopies;
\import algebraic_topology.Homotopy[A := Sphere.Sphere, B := A] \as Homotopies;
\import bundle_homotopy.Homotopy[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar,
  scalar := vector_bundles.Bundles[].Real[].scalar].Disks[d := d].Hemispheres[] \as Halves;
\import Halves.Cover[] \as Cover;
\import singular_cellular.On[A := A, source := source, complex := complex].Filtration[] \as Filtration;
\import Filtration.Stage[limit := N.Nat^::succ d] \as Target;
\structure Result[f: Sphere.Sphere -> A]: \Set := {
  value: Sphere.Sphere -> Target.Carrier,
  continuous: topology.Continuity[A := Sphere.Sphere, B := Target.Carrier].Continuous Sphere.sphereTopology Target.topology value,
  homotopy: Homotopies.Homotopy[Sphere.sphereTopology, source, f, (\fun (x: Sphere.Sphere) => Target.inclusion (value x))]
};
\module For(f: Sphere.Sphere -> A, continuous: topology.Continuity[A := Sphere.Sphere, B := A].Continuous Sphere.sphereTopology source f);
