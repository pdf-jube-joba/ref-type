\import \parent.\parent.\parent.PiecewiseImage[m := m, n := n, larger := larger, expressions := approximation.expressions] \as Image;
\definition exclusion: \exists Image.Exclusion := Image.exclusion;
\definition misses: \forall (excluded: Image.Exclusion)(y: Target.Coordinate) -> \In[Target.Coordinate] excluded.region y ->
  \forall (x: Source.Disk) -> Logic.Not (value approximation.expressions x = y) :=
  \fun (excluded: Image.Exclusion)(y: Target.Coordinate)(inside: _)(x: Source.Disk) => excluded.excludes y inside x;
