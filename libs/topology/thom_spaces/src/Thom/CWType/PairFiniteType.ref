\structure Details[Y: \Set]: \Set := {
  space: topology.Topology[Carrier := Y].Topology,
  complex: algebraic_topology.CW[A := Y].FiniteComplex[space],
  part: algebraic_topology.CW[A := Y].Pair[source := space, complex := complex].Subcomplex,
  equivalence: \root.Thom[].CWType[].PairTools[A := A, B := Y, source := source, target := space, subset := subset,
    targetSubset := algebraic_topology.CW[A := Y].Pair[source := space, complex := complex].Of[subcomplex := part].Subset].Data
};
\structure Data: \Set(1) := {
  Carrier: \Set,
  dataLift: \forall (Z: \Set) -> (Details[Carrier] -> Z) -> Z
};
\definition details[model: Data]: Details[model.Carrier] := model.dataLift Details[model.Carrier] (\fun (d: Details[model.Carrier]) => d);
\definition pack[Y: \Set][data: Details[Y]]: Data := Data { Carrier := Y, dataLift := \fun (Z: \Set)(f: Details[Y] -> Z) => f data };
\module Along(B: \Set, target: topology.Topology[Carrier := B].Topology, targetSubset: \Pow B,
  e: \root.Thom[].CWType[].PairTools[A := A, B := B, source := source, target := target, subset := subset, targetSubset := targetSubset].Data,
  model: \root.Thom[].CWType[].PairFiniteType[A := B, source := target, subset := targetSubset].Data);
\module Native(complex: algebraic_topology.CW[A := A].FiniteComplex[source],
  part: algebraic_topology.CW[A := A].Pair[source := source, complex := complex].Subcomplex,
  agrees: subset = algebraic_topology.CW[A := A].Pair[source := source, complex := complex].Of[subcomplex := part].Subset);
\module Empty(empty: \forall (x: A) -> Logic.False);
