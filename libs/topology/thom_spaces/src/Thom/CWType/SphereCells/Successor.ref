\import singular_cellular.DiskSphere[n := n] \as Quotient;
\import Euclidean.Dimension[n := N.Nat^::succ n] \as SourceDisk;
\import Euclidean.Dimension[n := n].Splitting[] \as Boundary;
\definition point: SourceDisk.Disk := Quotient.Surjection[].boundaryPoint;
\definition pointUnit: SourceDisk.normSquared point = R.one := \bysub(SourceDisk.Coordinate, SourceDisk.Boundary, Boundary.north);
\definition poleBoundary: \forall (p: SourceDisk.Disk) -> Quotient.map p = Quotient.Fibers[].north -> SourceDisk.normSquared p = R.one := \fun (p: SourceDisk.Disk)(same: _) => trans!{R.Real} _ _ _
  (Quotient.Fibers[].sameSquared p point (trans!{{Sphere (N.Nat^::succ n)}} _ _ _ same (sym!{{Sphere (N.Nat^::succ n)}} _ _ (Quotient.Fibers[].onBoundary point pointUnit)))) pointUnit;
\definition data: Data[N.Nat^::succ n] := Data[N.Nat^::succ n] {
  pole := Quotient.Fibers[].north, characteristic := Quotient.map, continuous := Quotient.Continuity[].continuous,
  boundary := Quotient.Fibers[].onBoundary,
  interiorInjective := \fun (p, q: SourceDisk.Disk)(inside: _) => Quotient.Fibers[].equalInterior p q (dedekind_reals.DedekindReal[].Order[].ltNotEq (SourceDisk.normSquared p) R.one inside),
  poleBoundary := poleBoundary,
  covers := \fun (x: Sphere (N.Nat^::succ n)) => Logic.Or[_, _]::right (Quotient.Surjection[].onto x)
};
