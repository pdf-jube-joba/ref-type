\import real.Analysis[] \as R;
\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Bundles;
\import bundle_operations.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Operations;
\import vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as RealBundles;
\import linear_algebra.Commutative[K := R.Real, scalarRing := Fields.fieldAsCommutativeRing R.Real R.Algebra[].field] \as Spaces;
\definition Frame[n, d: N.Nat^]: \Set := Spaces.Isomorphism[V := Bundles.Vector n, W := RealBundles.Vector d,
  source := Operations.RealScalars[V := Bundles.Vector n, space := Bundles.coordinates n].realSpace, target := RealBundles.coordinates d].Isomorphism;
\structure Data: \Set := {
  dimension: N.Nat^ -> N.Nat^,
  frame: \forall (n: N.Nat^) -> Frame n (dimension n),
  forwardContinuous: \forall (n: N.Nat^) -> topology.Continuity[A := Bundles.Vector n, B := algebraic_topology.Euclidean[].Dimension[n := dimension n].Coordinate].Continuous
    (Bundles.coordinateTopology n) algebraic_topology.Euclidean[].Dimension[n := dimension n].topology (frame n).forward.apply,
  backwardContinuous: \forall (n: N.Nat^) -> topology.Continuity[A := algebraic_topology.Euclidean[].Dimension[n := dimension n].Coordinate, B := Bundles.Vector n].Continuous
    algebraic_topology.Euclidean[].Dimension[n := dimension n].topology (Bundles.coordinateTopology n) (frame n).backward.apply
};
