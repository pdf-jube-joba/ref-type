\definition north[x: Disk.Disk]: A := f (Halves.positive x);
\definition south[x: Disk.Disk]: A := f (Halves.negative x);
\definition northContinuous: topology.Continuity[A := Disk.Disk, B := A].Continuous Disk.diskTopology source north :=
  topology.Composition[A := Disk.Disk, B := Sphere.Sphere, C := A].composeContinuous Disk.diskTopology Sphere.sphereTopology source Halves.positive f Halves.positiveContinuous continuous;
\definition southContinuous: topology.Continuity[A := Disk.Disk, B := A].Continuous Disk.diskTopology source south :=
  topology.Composition[A := Disk.Disk, B := Sphere.Sphere, C := A].composeContinuous Disk.diskTopology Sphere.sphereTopology source Halves.negative f Halves.negativeContinuous continuous;
\definition empty: \Pow Disk.Disk := { x: Disk.Disk \where Logic.False };
\import \root.Thom[].CWType[].DiskApproximation[m := d, A := A, source := source, complex := complex, fixed := empty] \as North;
\definition emptyLands: North.Lands north := \fun (x: Disk.Disk)(empty: Logic.False) => Logic.falseElim (\In[A] (Filtration.subset (N.Nat^::succ d)) (north x)) empty;
\module North(n: North.Result[north]);
\definition exists: \exists Result[f] := \block {
  \takefrom n: North.Result[north] \by North.For[f := north, continuous := northContinuous, lands := emptyLands].exists \then
  \return North[n := n].exists
};
