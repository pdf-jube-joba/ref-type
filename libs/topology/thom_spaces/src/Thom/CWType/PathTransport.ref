\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := A] \as Cylinder;
\import algebraic_topology.Cylinder[A := Cylinder.Carrier] \as Double;
\import algebraic_topology.Homotopy[A := A, B := B] \as Paths;
\definition reverse: Paths.Homotopy[source, target, g, k] := Paths.reverse source target k g h;
\import \root.Thom[].CWType[].PathCancellation[A := A, B := B, source := source, target := target, f := f, g := g, k := k, p := p, h := reverse] \as Reindex;
\definition doubleTopology: topology.Topology[Carrier := Double.Carrier].Topology := Double.topology (Cylinder.topology source);
\import algebraic_topology.Homotopy[A := Cylinder.Carrier, B := B] \as Wide;
\definition start[x: Cylinder.Carrier]: B := f (Cylinder.point x);
\definition middle[x: Cylinder.Carrier]: B := g (Cylinder.point x);
\definition endpoint[x: Cylinder.Carrier]: B := h x;
\definition first: Wide.Homotopy[Cylinder.topology source, target, start, middle] :=
  Paths.Composition[C := Cylinder.Carrier].precompose (Cylinder.topology source) source target f g p Cylinder.point (Cylinder.pointContinuous source);
\definition time[z: Double.Carrier]: I.Carrier := I.Convex[].blend (Double.time z) I.end (Cylinder.time (Double.point z));
\definition map[z: Double.Carrier]: Cylinder.Carrier := Cylinder.at (time z) (Cylinder.point (Double.point z));
\definition mapContinuous: topology.Continuity[A := Double.Carrier, B := Cylinder.Carrier].Continuous doubleTopology (Cylinder.topology source) map :=
  topological_constructions.Product[A := I.Carrier, B := A].Universal[X := Double.Carrier].pairContinuous doubleTopology I.topology source time (\fun (z: Double.Carrier) => Cylinder.point (Double.point z))
    (I.Convex[].Functions[A := Double.Carrier].continuous doubleTopology Double.time (\fun (z: Double.Carrier) => I.end) (\fun (z: Double.Carrier) => Cylinder.time (Double.point z))
      (Double.timeContinuous (Cylinder.topology source)) (topology.Maps[A := Double.Carrier, B := I.Carrier].constantContinuous doubleTopology I.topology I.end)
      (topology.Composition[A := Double.Carrier, B := Cylinder.Carrier, C := I.Carrier].composeContinuous doubleTopology (Cylinder.topology source) I.topology Double.point Cylinder.time (Double.pointContinuous (Cylinder.topology source)) (Cylinder.timeContinuous source)))
    (topology.Composition[A := Double.Carrier, B := Cylinder.Carrier, C := A].composeContinuous doubleTopology (Cylinder.topology source) source Double.point Cylinder.point (Double.pointContinuous (Cylinder.topology source)) (Cylinder.pointContinuous source));
\definition second: Wide.Homotopy[Cylinder.topology source, target, middle, endpoint] :=
  \into[Wide.Family](\fun (z: Double.Carrier) => h (map z), Wide.Homotopy[Cylinder.topology source, target, middle, endpoint]) \by {
    Wide.Laws[Cylinder.topology source, target, middle, endpoint, (\fun (z: Double.Carrier) => h (map z))] {
      continuous := topology.Composition[A := Double.Carrier, B := Cylinder.Carrier, C := B].composeContinuous doubleTopology (Cylinder.topology source) target map h mapContinuous (Paths.laws source target k g h).continuous,
      start := \fun (x: Cylinder.Carrier) => trans!{B} _ _ _
        (congr!{{I.Carrier} B} (\fun (t: I.Carrier) => h (Cylinder.at t (Cylinder.point x))) _ _ (I.Convex[].atStart I.end (Cylinder.time x))) ((Paths.laws source target k g h).end (Cylinder.point x)),
      end := \fun (x: Cylinder.Carrier) => trans!{B} _ _ _
        (congr!{{I.Carrier} B} (\fun (t: I.Carrier) => h (Cylinder.at t (Cylinder.point x))) _ _ (I.Convex[].atEnd I.end (Cylinder.time x)))
        (congr!{Cylinder.Carrier B} h _ _ (Pair.Prop[A := I.Carrier, B := A].eta x))
    }
  };
\definition family: Wide.Homotopy[Cylinder.topology source, target, start, endpoint] := Wide.Concatenation[].concatenate (Cylinder.topology source) target start middle endpoint first second;
\definition apply[z: Double.Carrier]: B := family (Reindex.swap z);
\definition continuous: topology.Continuity[A := Double.Carrier, B := B].Continuous doubleTopology target apply :=
  topology.Composition[A := Double.Carrier, B := Double.Carrier, C := B].composeContinuous doubleTopology doubleTopology target Reindex.swap family Reindex.swapContinuous (Wide.laws (Cylinder.topology source) target start endpoint family).continuous;
\definition atZero: \forall (u: I.Carrier)(x: A) -> apply (Double.at u (Cylinder.at I.start x)) = f x := \fun (u: I.Carrier)(x: A) => (Wide.laws (Cylinder.topology source) target start endpoint family).start (Cylinder.at u x);
\definition atOne: \forall (u: I.Carrier)(x: A) -> apply (Double.at u (Cylinder.at I.end x)) = h (Cylinder.at u x) := \fun (u: I.Carrier)(x: A) => (Wide.laws (Cylinder.topology source) target start endpoint family).end (Cylinder.at u x);
\definition reverseLine: \forall (t: I.Carrier) -> I.Convex[].blend t I.end I.start = I.reverse t := \fun (t: I.Carrier) => trans!{real.Analysis[].Real} _ _ _
  (congr!{real.Analysis[].Real real.Analysis[].Real real.Analysis[].Real} real.Analysis[].add _ _ _ _
    (real.Analysis[].Algebra[].mulOneRight (I.reverse t)) (dedekind_reals.DedekindReal[].Arithmetic[].Prop[].fieldMulZeroRight t))
  (dedekind_reals.DedekindReal[].Arithmetic[].Prop[].addZeroRight (I.reverse t));
\definition firstFormula: \forall (t: I.Carrier)(x: A) -> p (Cylinder.at t x) = first (Double.at t (Cylinder.at I.start x)) := \fun (t: I.Carrier)(x: A) => \refl(p (Cylinder.at t x));
\definition secondFormula: \forall (t: I.Carrier)(x: A) -> reverse (Cylinder.at t x) = second (Double.at t (Cylinder.at I.start x)) := \fun (t: I.Carrier)(x: A) =>
  congr!{{I.Carrier} B} (\fun (v: I.Carrier) => h (Cylinder.at v x)) _ _ (sym!{{I.Carrier}} _ _ (reverseLine t));
\import \root.Thom[].CWType[].ConcatenationLaws[A := Cylinder.Carrier, B := B, source := Cylinder.topology source, target := target, f := start, g := middle, k := endpoint, h := first, j := second] \as WideJoin;
\import WideJoin.Compare[C := A, D := B, domain := source, range := target, before := Cylinder.at I.start, after := (\fun (x: A)(y: B) => y), a := f, b := g, c := k,
  first := p, second := reverse, firstAgrees := firstFormula, secondAgrees := secondFormula] \as StartFormula;
\definition initial: Paths.Homotopy[source, target, f, k] := Paths.Concatenation[].concatenate source target f g k p reverse;
\definition initialPoint: \forall (t: I.Carrier)(x: A) -> apply (Double.at I.start (Cylinder.at t x)) = initial (Cylinder.at t x) := \fun (t: I.Carrier)(x: A) => sym!{B} _ _ (StartFormula.result t x);
\definition constant: Paths.Homotopy[source, target, g, g] := Paths.constant source target g (Paths.endContinuous source target f g p);
\definition finalFirst: \forall (t: I.Carrier)(x: A) -> p (Cylinder.at t x) = first (Double.at t (Cylinder.at I.end x)) := \fun (t: I.Carrier)(x: A) => \refl(p (Cylinder.at t x));
\definition finalSecond: \forall (t: I.Carrier)(x: A) -> constant (Cylinder.at t x) = second (Double.at t (Cylinder.at I.end x)) := \fun (t: I.Carrier)(x: A) => sym!{B} _ _
  (trans!{B} _ _ _ (congr!{{I.Carrier} B} (\fun (v: I.Carrier) => h (Cylinder.at v x)) _ _ (I.Convex[].fixed t I.end)) ((Paths.laws source target k g h).end x));
\import WideJoin.Compare[C := A, D := B, domain := source, range := target, before := Cylinder.at I.end, after := (\fun (x: A)(y: B) => y), a := f, b := g, c := g,
  first := p, second := constant, firstAgrees := finalFirst, secondAgrees := finalSecond] \as EndFormula;
\definition paused: Paths.Homotopy[source, target, f, g] := Paths.Concatenation[].concatenate source target f g g p constant;
\definition finalPoint: \forall (t: I.Carrier)(x: A) -> apply (Double.at I.end (Cylinder.at t x)) = paused (Cylinder.at t x) := \fun (t: I.Carrier)(x: A) => sym!{B} _ _ (EndFormula.result t x);
\definition singleApply: Double.Carrier -> B := Reindex.Compression[].singleApply;
\definition singleContinuous: topology.Continuity[A := Double.Carrier, B := B].Continuous doubleTopology target singleApply := Reindex.Compression[].singleContinuous;
\definition singleStart: \forall (t: I.Carrier)(x: A) -> singleApply (Double.at I.start (Cylinder.at t x)) = paused (Cylinder.at t x) := Reindex.Compression[].singleStart;
\definition singleEnd: \forall (t: I.Carrier)(x: A) -> singleApply (Double.at I.end (Cylinder.at t x)) = p (Cylinder.at t x) := Reindex.Compression[].singleEnd;
\definition singleAtZero: \forall (u: I.Carrier)(x: A) -> singleApply (Double.at u (Cylinder.at I.start x)) = f x := Reindex.Compression[].singleAtZero;
\definition singleAtOne: \forall (u: I.Carrier)(x: A) -> singleApply (Double.at u (Cylinder.at I.end x)) = g x := Reindex.Compression[].singleAtOne;

\module Preservation(subset: \Pow A, targetSubset: \Pow B,
  pPreserves: \forall (t: I.Carrier)(x: \Cast[A] subset) -> \In[B] targetSubset (p (Cylinder.at t x)),
  hPreserves: \forall (t: I.Carrier)(x: \Cast[A] subset) -> \In[B] targetSubset (h (Cylinder.at t x)));
