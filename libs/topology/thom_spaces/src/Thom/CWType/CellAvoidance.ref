\import algebraic_topology.Euclidean[].Dimension[n := m] \as Domain;
\import \parent.SupGeometry[n := cell.dimension] \as Sup;
\import topological_algebra.Euclidean[].Dimension[n := cell.dimension].Norm[] \as Norm;
\import real.Analysis[] \as R;
