\import singular_cellular.On[A := A, source := source, complex := complex].Filtration[] \as Filtration;
\definition height: N.Nat^ := Filtration.Exhaustion[].height complex.cells;
\definition compact: Space.IsCompact source := \idelim Filtration.subset height = Space.Whole \with S: \Pow A => Space.IsCompactIn source S \by {
  base: Filtration.Compactness[limit := height].compactIn, equality: Filtration.Exhaustion[].full
};
\definition property: Property := Logic.And[_, _]::# compact (\exact(Models.native complex, Models.Data));
