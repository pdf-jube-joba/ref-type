\import \root.Thom[].CWType[].CompactType[A := B, source := target] \as Target;
\import \root.Thom[].CWType[].FiniteType[A := B, source := target] \as TargetModels;
\definition laws: topology.Homeomorphism[A := A, B := B].Laws[source, target, h] := topology.Homeomorphism[A := A, B := B].laws source target h;
\definition onto: \forall (x: A) -> \exists (y: B \where h.backward y = x) := \fun (x: A) => Logic.existsIntro[B, { y: B \where h.backward y = x }] (h.forward x) (laws.leftInverse x);
\definition equivalence: algebraic_topology.HomotopyEquivalence[A := A, B := B].Equivalence[source, target] := algebraic_topology.HomotopyEquivalence[A := A, B := B].fromHomeomorphism source target h;
\definition fromTarget: Target.Property -> Property := \fun (property: Target.Property) => Logic.And[_, _]::#
  (topology.Compactness[A := B, B := A].surjectiveImage target source h.backward laws.backwardContinuous onto property.left)
  (\block {
    \takefrom model: TargetModels.Data \by property.right \then
    \return \exact(\root.Thom[].CWType[].FiniteType[A := A, source := source].Along[B := B, target := target, equivalence := equivalence, model := model].result, Models.Data)
  });
