\import \parent.Coordinates[] \as Coordinates;
\import topological_algebra.Coordinates[K := R.Real, I := Fin.Fin cell.dimension] \as Vectors;
\definition extensionContinuous: topology.Continuity[A := Domain.Disk, B := Model.Coordinate].Continuous Domain.diskTopology Model.topology extension.value :=
  Vectors.Universal[A := Domain.Disk].continuous Domain.diskTopology metric_spaces.RealLine[].topology extension.value extension.continuous;
\import \root.Thom[].CWType[].LocalAvoidance[m := m, n := cell.dimension, larger := larger].Of[f := extension.value, continuous := extensionContinuous, radius := radius, positive := positive] \as Local;
\module Modified(perturbation: Local.Perturbation);
\definition exists: \exists Perturbation := \block {
  \takefrom perturbation: Local.Perturbation \by Local.exists \then
  \return \exact(Modified[perturbation := perturbation].result, Perturbation)
};
