\structure Perturbation: \Set := {
  value: Domain.Disk -> Stage.Carrier,
  continuous: topology.Continuity[A := Domain.Disk, B := Stage.Carrier].Continuous Domain.diskTopology Stage.topology value,
  homotopy: Homotopies.Homotopy[Domain.diskTopology, Stage.topology, f, value],
  fixed: \forall (t: I.Carrier)(x: Domain.Disk) -> Logic.Not (\In[A] (Cells.InteriorImage cell) (f x)) -> homotopy (Cylinder.at t x) = f x,
  supported: \forall (p: Cylinder.Carrier) -> Logic.Or[homotopy p = f (Cylinder.point p), \In[A] (Cells.InteriorImage cell) (homotopy p)],
  noncentre: \forall (x: Domain.Disk) -> Logic.Not (value x = C.centre)
};
\module Bounded(bound: C.Radius);
\definition exists: \exists Perturbation := \block {
  \takefrom bound: C.Radius \by C.radius \then
  \return Bounded[bound := bound].exists
};
