\definition laws: Equivalences.Laws[source, target, e] := Equivalences.laws source target e;
\definition reverse: Homotopies.Homotopy[source, target, next, e.forward] := Homotopies.reverse source target e.forward next homotopy;
\definition continuous: topology.Continuity[A := A, B := B].Continuous source target next := Homotopies.endContinuous source target e.forward next homotopy;
\import Homotopies.Composition[C := A] \as Post;
\import Homotopies.Composition[C := B] \as Pre;
\definition first: Left.Homotopy[source, source, (\fun (x: A) => e.backward (next x)), (\fun (x: A) => e.backward (e.forward x))] :=
  Post.postcompose source target source next e.forward reverse e.backward laws.backwardContinuous;
\definition second: Right.Homotopy[target, target, (\fun (y: B) => next (e.backward y)), (\fun (y: B) => e.forward (e.backward y))] :=
  Pre.precompose target source target next e.forward reverse e.backward laws.backwardContinuous;
\definition result: Equivalences.Equivalence[source, target] := Equivalences.Equivalence[source, target] {
  forward := next, backward := e.backward, forwardContinuous := continuous, backwardContinuous := laws.backwardContinuous,
  leftInverse := Left.Concatenation[].transitive source source (\fun (x: A) => e.backward (next x)) (\fun (x: A) => e.backward (e.forward x)) (\fun (x: A) => x)
    (\exact(first, Left.Homotopy[source, source, (\fun (x: A) => e.backward (next x)), (\fun (x: A) => e.backward (e.forward x))])) laws.leftInverse,
  rightInverse := Right.Concatenation[].transitive target target (\fun (y: B) => next (e.backward y)) (\fun (y: B) => e.forward (e.backward y)) (\fun (y: B) => y)
    (\exact(second, Right.Homotopy[target, target, (\fun (y: B) => next (e.backward y)), (\fun (y: B) => e.forward (e.backward y))])) laws.rightInverse
};
