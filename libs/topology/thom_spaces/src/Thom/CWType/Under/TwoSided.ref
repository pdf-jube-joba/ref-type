\import \root.Thom[].CWType[].EquivalenceTools[A := A, B := B, source := source, target := target].TwoSided[
  f := f, left := leftMap, right := rightMap, continuous := continuous, leftContinuous := leftContinuous, rightContinuous := rightContinuous,
  leftInverse := leftInverse, rightInverse := rightInverse] \as Ordinary;
\definition firstFixed: \forall (t: I.Carrier)(s: S) -> Ordinary.first (RightCylinder.at t (to s)) = to s := \fun (t: I.Carrier)(s: S) => eq_reason_in!{B _
  "=" _ "by" { congr!{B B} (\fun (y: B) => f (leftMap y)) _ _ (rightInverseFixed (I.reverse t) s) }
  "=" _ "by" { congr!{A B} f _ _ (leftFixed s) }
  "=" _ "by" { forwardFixed s }
};
\definition secondFixed: \forall (t: I.Carrier)(s: S) -> Ordinary.second (RightCylinder.at t (to s)) = to s := \fun (t: I.Carrier)(s: S) => eq_reason_in!{B _
  "=" _ "by" { congr!{A B} (\fun (x: A) => f (leftInverse (LeftCylinder.at t x))) _ _ (rightFixed s) }
  "=" _ "by" { congr!{A B} f _ _ (leftInverseFixed t s) }
  "=" _ "by" { forwardFixed s }
};
\import \root.Thom[].CWType[].FixedPaths[S := S, A := B, B := B, from := to, to := to].Concatenation[
  source := target, target := target, f := (\fun (y: B) => f (leftMap (f (rightMap y)))), g := (\fun (y: B) => f (rightMap y)), k := (\fun (y: B) => y),
  first := Ordinary.second, second := rightInverse, firstFixed := secondFixed, secondFixed := rightInverseFixed] \as Tail;
\import \root.Thom[].CWType[].FixedPaths[S := S, A := B, B := B, from := to, to := to].Concatenation[
  source := target, target := target, f := (\fun (y: B) => f (leftMap y)), g := (\fun (y: B) => f (leftMap (f (rightMap y)))), k := (\fun (y: B) => y),
  first := Ordinary.first, second := Tail.result, firstFixed := firstFixed, secondFixed := Tail.fixed] \as Joined;
\definition result: Data := Data {
  forward := f, backward := leftMap, forwardContinuous := continuous, backwardContinuous := leftContinuous,
  forwardFixed := forwardFixed, backwardFixed := leftFixed,
  left := leftInverse, right := Joined.result, leftFixed := leftInverseFixed, rightFixed := Joined.fixed
};
