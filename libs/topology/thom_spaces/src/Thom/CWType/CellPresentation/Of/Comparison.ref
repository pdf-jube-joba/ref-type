\definition homeomorphism: topology.Homeomorphism[A := Attached.Carrier, B := Y].Homeomorphism[Attached.topology, target] :=
  \root.Thom[].CWType[].CompactBijection[A := Attached.Carrier, B := Y, source := Attached.topology, target := target,
    compact := Attached.compact compact, hausdorff := hausdorff, f := apply, injective := injective, onto := onto, continuous := continuous].homeomorphism;
\module Subsets(subset: \Pow A, targetSubset: \Pow Y,
  originalContained: \forall (a: \Cast[A] subset) -> \In[Y] targetSubset (data.original a),
  originalReflects: \forall (a: A) -> \In[Y] targetSubset (data.original a) -> \In[A] subset a,
  interiorAvoids: \forall (p: Attached.InteriorPoint) -> Logic.Not (\In[Y] targetSubset (data.characteristic p)));
