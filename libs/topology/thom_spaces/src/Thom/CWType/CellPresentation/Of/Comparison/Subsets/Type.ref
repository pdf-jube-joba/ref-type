\import \root.Thom[].CWType[].PairFiniteType[A := Attached.Carrier, source := Attached.topology, subset := Subsets.originalSubset] \as AttachedType;
\import \root.Thom[].CWType[].PairFiniteType[A := Y, source := target, subset := targetSubset] \as Type;
\definition exists: \exists Type.Data := \block {
  \takefrom attached: AttachedType.Data \by Subsets.Type[model := model].exists \then
  \return \exact(Type.Along[B := Attached.Carrier, target := Attached.topology, targetSubset := Subsets.originalSubset, e := Pairs.Inverse[e := equivalence].result, model := attached].result, Type.Data)
};
