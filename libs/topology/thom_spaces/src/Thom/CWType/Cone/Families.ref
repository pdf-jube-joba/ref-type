\import algebraic_topology.Cylinder[A := Vertex.Carrier] \as VertexCylinder;
\import algebraic_topology.Cylinder[A := Cylinder.Carrier] \as DoubleCylinder;
\import algebraic_topology.Cylinder[A := Carrier] \as TotalCylinder;
\import Pushout.Families[X := I.Carrier, D := B, factor := I.topology, left := Vertex.topology, right := Cylinder.topology source, target := target] \as Gluing;
\definition left[p: VertexCylinder.Carrier]: B := point (VertexCylinder.time p);
\definition compatible: Gluing.Compatible left family := \fun (t: I.Carrier)(x: A) => sym!{B} _ _ (zero t x);
\definition apply: TotalCylinder.Carrier -> B := Gluing.apply left family compatible;
\definition onApex: \forall (t: I.Carrier) -> apply (TotalCylinder.at t apex) = point t := \fun (t: I.Carrier) => Gluing.onLeft left family compatible t Vertex.point;
\definition onCylinder: \forall (t, u: I.Carrier)(x: A) -> apply (TotalCylinder.at t (at u x)) = family (DoubleCylinder.at t (Cylinder.at u x)) :=
  \fun (t, u: I.Carrier)(x: A) => Gluing.onRight left family compatible t (Cylinder.at u x);
\definition continuous: topology.Continuity[A := TotalCylinder.Carrier, B := B].Continuous (TotalCylinder.topology topology) target apply :=
  Gluing.continuous I.compact I.hausdorff left family compatible
    (topology.Composition[A := VertexCylinder.Carrier, B := I.Carrier, C := B].composeContinuous (VertexCylinder.topology Vertex.topology) I.topology target VertexCylinder.time point
      (VertexCylinder.timeContinuous Vertex.topology) pointContinuous) familyContinuous;
