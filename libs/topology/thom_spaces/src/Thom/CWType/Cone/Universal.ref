\import Pushout.Universal[D := B] \as Gluing;
\definition compatible: Gluing.Compatible (\fun (p: Vertex.Carrier) => point) family := \fun (x: A) => sym!{B} _ _ (zero x);
\definition apply: Carrier -> B := Gluing.apply (\fun (p: Vertex.Carrier) => point) family compatible;
\definition onApex: apply apex = point := Gluing.onLeft (\fun (p: Vertex.Carrier) => point) family compatible Vertex.point;
\definition onCylinder: \forall (t: I.Carrier)(x: A) -> apply (at t x) = family (Cylinder.at t x) :=
  \fun (t: I.Carrier)(x: A) => Gluing.onRight (\fun (p: Vertex.Carrier) => point) family compatible (Cylinder.at t x);
\definition regular: topology.Continuity[A := Carrier, B := B].Continuous topology target apply := Gluing.continuous Vertex.topology (Cylinder.topology source) target
  (\fun (p: Vertex.Carrier) => point) family compatible (topology.Maps[A := Vertex.Carrier, B := B].constantContinuous Vertex.topology target point) continuous;
