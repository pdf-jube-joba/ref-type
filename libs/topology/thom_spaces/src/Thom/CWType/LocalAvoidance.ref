\import algebraic_topology.Euclidean[].Dimension[n := m] \as Source;
\import algebraic_topology.Euclidean[].Dimension[n := n] \as Target;
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as D;
\import D.Arithmetic[].Prop[] \as Laws;
\import D.Order[] \as Order;
\import \parent.SupGeometry[n := n] \as Sup;
\import topological_algebra.Euclidean[].Dimension[n := n].Def[] \as Vectors;
\import topological_algebra.Euclidean[].Dimension[n := n].Norm[] \as Norm;
\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := Source.Disk] \as Cylinder;
\import algebraic_topology.Homotopy[A := Source.Disk, B := Target.Coordinate] \as Homotopies;
\import topology.Topology[Carrier := Source.Disk] \as DiskSpace;
\module Of(f: Source.Disk -> Target.Coordinate,
  continuous: topology.Continuity[A := Source.Disk, B := Target.Coordinate].Continuous Source.diskTopology Target.topology f,
  radius: R.Real, positive: D.Lt R.zero radius);
