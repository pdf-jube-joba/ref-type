\import algebraic_topology.HomotopyEquivalence[A := A, B := C] \as First;
\import algebraic_topology.HomotopyEquivalence[A := B, B := D] \as Second;
\import algebraic_topology.HomotopyEquivalence[A := A, B := B] \as ResultEquivalences;
\import algebraic_topology.Homotopy[A := B, B := B] \as Left;
\import algebraic_topology.Homotopy[A := C, B := C] \as Right;
\definition firstLaws: First.Laws[firstSpace, thirdSpace, firstEquivalence] := First.laws firstSpace thirdSpace firstEquivalence;
\definition secondLaws: Second.Laws[secondSpace, fourthSpace, secondEquivalence] := Second.laws secondSpace fourthSpace secondEquivalence;
\structure Result: \Set := {
  equivalence: ResultEquivalences.Equivalence[firstSpace, secondSpace],
  forward: equivalence.forward = f
};
\module With(left: Left.Homotopy[secondSpace, secondSpace, (\fun (y: B) => secondEquivalence.backward (secondEquivalence.forward y)), (\fun (y: B) => y)],
  right: Right.Homotopy[thirdSpace, thirdSpace, (\fun (z: C) => firstEquivalence.forward (firstEquivalence.backward z)), (\fun (z: C) => z)]);
\definition exists: \exists Result := \block {
  \takefrom left: Left.Homotopy[secondSpace, secondSpace, (\fun (y: B) => secondEquivalence.backward (secondEquivalence.forward y)), (\fun (y: B) => y)] \by secondLaws.leftInverse \then
  \takefrom right: Right.Homotopy[thirdSpace, thirdSpace, (\fun (z: C) => firstEquivalence.forward (firstEquivalence.backward z)), (\fun (z: C) => z)] \by firstLaws.rightInverse \then
  \return \exact(With[left := left, right := right].result, Result)
};
