\import algebraic_topology.HomotopyEquivalence[A := A, B := B] \as Equivalences;
\import algebraic_topology.Homotopy[A := A, B := B] \as Homotopies;
\import algebraic_topology.Homotopy[A := A, B := A] \as Left;
\import algebraic_topology.Homotopy[A := B, B := B] \as Right;
\module Replace(e: Equivalences.Equivalence[source, target], next: A -> B,
  homotopy: Homotopies.Homotopy[source, target, e.forward, next]);
\module TwoSided(f: A -> B, left, right: B -> A,
  continuous: topology.Continuity[A := A, B := B].Continuous source target f,
  leftContinuous: topology.Continuity[A := B, B := A].Continuous target source left,
  rightContinuous: topology.Continuity[A := B, B := A].Continuous target source right,
  leftInverse: Left.Homotopy[source, source, (\fun (x: A) => left (f x)), (\fun (x: A) => x)],
  rightInverse: Right.Homotopy[target, target, (\fun (y: B) => f (right y)), (\fun (y: B) => y)]);
