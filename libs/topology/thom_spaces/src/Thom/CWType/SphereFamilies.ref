\import real.Analysis[] \as R;
\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Euclidean[].Dimension[n := d] \as Disk;
\import algebraic_topology.Euclidean[].Dimension[n := N.Nat^::succ d] \as Sphere;
\import algebraic_topology.Cylinder[A := Disk.Disk] \as DiskCylinder;
\import algebraic_topology.Cylinder[A := Sphere.Sphere] \as Cylinder;
\import bundle_homotopy.Homotopy[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar,
  scalar := vector_bundles.Bundles[].Real[].scalar].Disks[d := d].Hemispheres[] \as Halves;
\import Halves.Cover[] \as Cover;
\definition Compatible: \Prop := \forall (t: I.Carrier)(v: Disk.Sphere) -> first (DiskCylinder.at t (Halves.boundaryInclusion v)) = second (DiskCylinder.at t (Halves.boundaryInclusion v));
\definition source: topology.Topology[Carrier := DiskCylinder.Carrier].Topology := DiskCylinder.topology Disk.diskTopology;
\module Of(firstContinuous: topology.Continuity[A := DiskCylinder.Carrier, B := B].Continuous source target first,
  secondContinuous: topology.Continuity[A := DiskCylinder.Carrier, B := B].Continuous source target second, compatible: Compatible);
