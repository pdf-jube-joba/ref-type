\definition result: Data[Lists.List[Cells.CellData]::cons c tail] := Data[Lists.List[Cells.CellData]::cons c tail] {
  value := previous.value, continuous := previous.continuous, homotopy := previous.homotopy,
  avoids := \fun (d: Cells.CellData)(included: _)(present: _)(dimension: _)(x: Domain.Disk) =>
    either!{included {Logic.Not ((\fun (y: Upper.Carrier) => y) (previous.value x) = centre d)}
      {\fun (same: d = c) => Logic.falseElim _ (outside (Logic.And[_, _]::#
        (\idelim d = c \with e: Cells.CellData => Cells.CellMember complex.cells e \by { base: present, equality: same })
        (trans!{N.Nat^} c.dimension d.dimension k (sym!{N.Nat^} _ _ (congr!{Cells.CellData N.Nat^} (\fun (e: Cells.CellData) => e.dimension) d c same)) dimension)))}
      {\fun (old: _) => previous.avoids d old present dimension x}
    }
};
