\import \root.Thom[].CWType[].TopCells[m := m, k := k, A := A, source := source, complex := complex, larger := larger].For[f := previous.value, continuous := previous.continuous] \as Current;
\module Using(adjustment: Current.Adjustment[c]);
\definition exists: \exists Data[Lists.List[Cells.CellData]::cons c tail] := \block {
  \takefrom adjustment: Current.Adjustment[c] \by Current.Single[c := c, present := present, dimension := dimension].exists \then
  \return \exact(Using[adjustment := adjustment].result, Data[Lists.List[Cells.CellData]::cons c tail])
};
