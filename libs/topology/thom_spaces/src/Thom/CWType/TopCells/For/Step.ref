\definition Selected: \Prop := Logic.And[Cells.CellMember complex.cells c, c.dimension = k];
\module Selected(present: Cells.CellMember complex.cells c, dimension: c.dimension = k);
\module Unselected(outside: Logic.Not Selected);
\definition exists: \exists Data[Lists.List[Cells.CellData]::cons c tail] :=
  either!{{Classical.excludedMiddle Selected} {\exists Data[Lists.List[Cells.CellData]::cons c tail]}
    {\fun (selected: Selected) => Selected[present := selected.left, dimension := selected.right].exists}
    {\fun (outside: _) => \exact(Unselected[outside := outside].result, Data[Lists.List[Cells.CellData]::cons c tail])}
  };
