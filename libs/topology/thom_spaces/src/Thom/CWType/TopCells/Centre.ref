\import algebraic_topology.Euclidean[].Dimension[n := c.dimension] \as Model;
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as D;
\definition originInterior: D.Lt (Model.normSquared Model.Contraction[].origin) R.one := D.ltReplaceLeft R.zero _ R.one
  (sym!{R.Real} _ _ (Model.Contraction[].zeroSum (Fin.elements c.dimension))) R.Estimates[].Product[].onePositive;
\definition inside: \In[A] (Cells.InteriorImage c) (centre c) :=
  Logic.existsIntro[Model.Disk, { p: Model.Disk \where Logic.And[D.Lt (Model.normSquared p) R.one, c.characteristic p = centre c] }] Model.Contraction[].origin
    (Logic.And[_, _]::# originInterior (\refl(centre c)));
