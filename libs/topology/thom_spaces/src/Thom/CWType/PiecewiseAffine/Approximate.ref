\definition hausdorff: topology.Topology[Carrier := Euclidean.Disk].IsT2 Euclidean.diskTopology :=
  topology.Topology[Carrier := Euclidean.Coordinate].Subspace[S := Euclidean.ClosedBall].Properties[].hausdorff Euclidean.topology Euclidean.Compactness[].hausdorff;
\import Approximation.Compact[compact := Euclidean.Compactness[].compact, hausdorff := hausdorff].LatticeDensity[B := Functions, laws := lattice].Of[
  f := f, regular := regular, interpolation := (\fun (x, y: Euclidean.Disk) => \parent.Interpolation[f := f, x := x, y := y].exists)] \as Density;
\definition exists: \forall (epsilon: R.Real) -> D.Lt R.zero epsilon -> \exists (e: Expression \where Approximation.Error f (value e) epsilon) := \block {
  \fun (epsilon: R.Real)(positive: _) \then
  \takefrom g: \Cast[Approximation.Function] ({ g: Approximation.Function \where Logic.And[\In[Approximation.Function] Functions g, Approximation.Error f g epsilon] })
    \by Density.approximation epsilon positive \then
  \let data: Logic.And[\In[Approximation.Function] Functions g, Approximation.Error f g epsilon] :=
    \bysub(Approximation.Function, { g: Approximation.Function \where Logic.And[\In[Approximation.Function] Functions g, Approximation.Error f g epsilon] }, g) \then
  \takefrom e: \Cast[Expression] ({ e: Expression \where value e = g }) \by data.left \then
  \return Logic.existsIntro[Expression, { e: Expression \where Approximation.Error f (value e) epsilon }] e
    (\idelim g = value e \with h: Approximation.Function => Approximation.Error f h epsilon \by {
      base: data.right, equality: sym!{Approximation.Function} _ _ (\bysub(Expression, { e: Expression \where value e = g }, e))
    })
};
