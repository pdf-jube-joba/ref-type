\definition V: \Pow Carrier := { x: Carrier \where \In[A] O x };
\definition toIntersection: \forall (x: Carrier) -> \In[Carrier] (Cells.InteriorPart (transform c) U) x -> \In[Carrier] (Space.Intersection (Cells.InteriorImage (transform c)) V) x := \fun (x: Carrier)(member: _) => \block {
  \let old: \In[A] (Base.Intersection (Original.InteriorImage c) O) x := \idelim Original.InteriorPart c U = Base.Intersection (Original.InteriorImage c) O \with S: \Pow A => \In[A] S x \by {
    base: partForward U x member, equality: same
  } \then
  \return Logic.And[_, _]::# (interiorBackward x old.left) old.right
};
\definition fromIntersection: \forall (x: Carrier) -> \In[Carrier] (Space.Intersection (Cells.InteriorImage (transform c)) V) x -> \In[Carrier] (Cells.InteriorPart (transform c) U) x := \fun (x: Carrier)(member: _) =>
  partBackward U x (\idelim Base.Intersection (Original.InteriorImage c) O = Original.InteriorPart c U \with S: \Pow A => \In[A] S x \by {
    base: Logic.And[_, _]::# (interiorForward x member.left) member.right, equality: sym!{{\Pow A}} _ _ same
  });
\definition equation: Cells.InteriorPart (transform c) U = Space.Intersection (Cells.InteriorImage (transform c)) V :=
  \axiom:setext(Cells.InteriorPart (transform c) U, Space.Intersection (Cells.InteriorImage (transform c)) V, toIntersection, fromIntersection);
\definition exists: \exists (W: \Pow Carrier \where Logic.And[Space.IsOpenIn topology W, Cells.InteriorPart (transform c) U = Space.Intersection (Cells.InteriorImage (transform c)) W]) :=
  Logic.existsIntro[\Pow Carrier, { W: \Pow Carrier \where Logic.And[Space.IsOpenIn topology W, Cells.InteriorPart (transform c) U = Space.Intersection (Cells.InteriorImage (transform c)) W] }] V
    (Logic.And[_, _]::# (inclusionContinuous O regular) equation);
