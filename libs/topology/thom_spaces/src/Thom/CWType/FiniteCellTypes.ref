\import algebraic_topology.Euclidean[] \as Euclidean;
\definition Theorem[n: N.Nat^]: \Prop := \forall (attach: Euclidean.Dimension[n := n].Sphere -> A) ->
  \forall (continuous: topology.Continuity[A := Euclidean.Dimension[n := n].Sphere, B := A].Continuous Euclidean.Dimension[n := n].sphereTopology source attach) ->
  \exists \root.Thom[].CWType[].FiniteType[A := \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := n, attach := attach, continuous := continuous].Carrier,
    source := \root.Thom[].CWType[].CellAttachment[A := A, source := source, n := n, attach := attach, continuous := continuous].topology].Data;
\module Zero(attach: Euclidean.Dimension[n := N.Nat^::zero].Sphere -> A,
  continuous: topology.Continuity[A := Euclidean.Dimension[n := N.Nat^::zero].Sphere, B := A].Continuous Euclidean.Dimension[n := N.Nat^::zero].sphereTopology source attach);
\module Successor(d: N.Nat^, attach: Euclidean.Dimension[n := N.Nat^::succ d].Sphere -> A,
  continuous: topology.Continuity[A := Euclidean.Dimension[n := N.Nat^::succ d].Sphere, B := A].Continuous Euclidean.Dimension[n := N.Nat^::succ d].sphereTopology source attach);
\definition theorem: \forall (n: N.Nat^) -> Theorem n := \induction (n: N.Nat^) \return Theorem n \with {
  | zero: \fun (attach: _)(continuous: _) => Zero[attach := attach, continuous := continuous].exists
  | succ: \fun (d: N.Nat^)(previous: Theorem d)(attach: _)(continuous: _) => Successor[d := d, attach := attach, continuous := continuous].exists
};
