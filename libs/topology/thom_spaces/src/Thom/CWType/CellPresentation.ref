\import algebraic_topology.Euclidean[].Dimension[n := n] \as Model;
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as D;
\definition boundaryInclusion[v: Model.Sphere]: Model.Disk := \into[Model.Coordinate](v, Model.ClosedBall) \by {
  D.leReplaceLeft R.one (Model.normSquared v) R.one (sym!{R.Real} _ _ (\bysub(Model.Coordinate, Model.Boundary, v))) (D.leRefl R.one)
};
\structure Data: \Set := {
  original: A -> Y,
  characteristic: Model.Disk -> Y,
  boundary: Model.Sphere -> A,
  originalContinuous: topology.Continuity[A := A, B := Y].Continuous source target original,
  characteristicContinuous: topology.Continuity[A := Model.Disk, B := Y].Continuous Model.diskTopology target characteristic,
  boundaryContinuous: topology.Continuity[A := Model.Sphere, B := A].Continuous Model.sphereTopology source boundary,
  originalInjective: \forall (a, b: A) -> original a = original b -> a = b,
  interiorInjective: \forall (p, q: Model.Disk) -> \In[Model.Coordinate] Model.Interior p -> \In[Model.Coordinate] Model.Interior q -> characteristic p = characteristic q -> p = q,
  separated: \forall (a: A)(p: Model.Disk) -> \In[Model.Coordinate] Model.Interior p -> Logic.Not (original a = characteristic p),
  seam: \forall (v: Model.Sphere) -> original (boundary v) = characteristic (boundaryInclusion v),
  covers: \forall (y: Y) -> Logic.Or[\exists (a: A \where original a = y), \exists (p: Model.Disk \where characteristic p = y)]
};
\module Of(data: Data);
