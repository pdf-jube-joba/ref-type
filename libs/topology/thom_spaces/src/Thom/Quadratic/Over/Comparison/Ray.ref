\definition r: R.Real := Right.norm p;
\definition l: R.Real := Left.norm p;
\definition rPositive: D.Lt R.zero r := \bysub(Family.Point, nonzero, p);
\definition aNonzero: Logic.Not (a = R.zero) := R.Inverse[].positiveNonzero a positive;
\definition rNonzero: Logic.Not (r = R.zero) := R.Inverse[].positiveNonzero r rPositive;
\definition productNonzero: Logic.Not (R.mul a r = R.zero) := R.Inverse[].positiveNonzero (R.mul a r) (R.Estimates[].Product[].mulPositive a r positive rPositive);
\definition inverse: Laws.fieldInv (R.mul a r) = R.mul (Laws.fieldInv a) (Laws.fieldInv r) :=
  sym!{R.Real} _ _ (R.Inverse[].inverseUnique (R.mul a r) (R.mul (Laws.fieldInv a) (Laws.fieldInv r)) productNonzero
    (trans!{R.Real} _ _ _ (Algebra.mulFour (Laws.fieldInv a) (Laws.fieldInv r) a r)
      (trans!{R.Real} _ _ _ (congr!{R.Real R.Real R.Real} R.mul _ _ _ _ (Laws.fieldInverseNonzero a aNonzero) (Laws.fieldInverseNonzero r rNonzero)) (Laws.fieldMulOneLeft R.one))));
\definition constant: coefficient (scale a p) = coefficient p := eq_reason_in!{R.Real _
  "=" _ "by" { congr!{R.Real R.Real R.Real} R.mul _ _ _ _ (Left.normScale a (Ord.leOfLt _ _ positive) p)
    (trans!{R.Real} _ _ _ (congr!{R.Real R.Real} Laws.fieldInv _ _ (Right.normScale a (Ord.leOfLt _ _ positive) p)) inverse) }
  "=" _ "by" { Algebra.mulFour a l (Laws.fieldInv a) (Laws.fieldInv r) }
  "=" _ "by" { congr!{R.Real R.Real} (\fun (s: R.Real) => R.mul s (R.mul l (Laws.fieldInv r))) _ _
    (trans!{R.Real} _ _ _ (Laws.fieldMulComm a (Laws.fieldInv a)) (Laws.fieldInverseNonzero a aNonzero)) }
  "=" _ "by" { Laws.fieldMulOneLeft (coefficient p) }
};
