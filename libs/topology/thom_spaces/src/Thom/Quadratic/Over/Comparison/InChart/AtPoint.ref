\import topology.Topology[Carrier := Coordinates.TotalPoint] \as Source;
\module WithBound(bound: Bound[Coordinates.base p]);
\definition neighborhood: \forall (U: \Pow Family.Point) -> topology.Topology[Carrier := Family.Point].IsOpenIn bundle.totalSpace U -> \In[Family.Point] U (apply p) ->
  \exists ( V: \Pow Coordinates.TotalPoint \where Source.OpenNeighborhood[Coordinates.localTopology, p, { q: Coordinates.TotalPoint \where \In[Family.Point] U (apply q) }, V] ) := \block {
  \fun (U: \Pow Family.Point)(open: _)(member: _) \then
  \takefrom bound: Bound[Coordinates.base p] \by \parent.At[a := Coordinates.base p].boundExists \then
  \return WithBound[bound := bound].neighborhood U open member
};
