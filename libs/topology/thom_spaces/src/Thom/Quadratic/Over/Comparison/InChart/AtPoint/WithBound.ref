\import \parent.\parent.Bounded[a := Coordinates.base p, bound := bound] \as Region;
\import topology.Topology[Carrier := Coordinates.TotalPoint].Subspace[S := Region.region].Open[] \as Open;
\definition neighborhood: \forall (U: \Pow Family.Point) -> topology.Topology[Carrier := Family.Point].IsOpenIn bundle.totalSpace U -> \In[Family.Point] U (apply p) ->
  \exists ( V: \Pow Coordinates.TotalPoint \where Source.OpenNeighborhood[Coordinates.localTopology, p, { q: Coordinates.TotalPoint \where \In[Family.Point] U (apply q) }, V] ) :=
  \fun (U: \Pow Family.Point)(open: _)(member: _) =>
  Logic.existsIntro[\Pow Coordinates.TotalPoint, { V: \Pow Coordinates.TotalPoint \where Source.OpenNeighborhood[Coordinates.localTopology, p, { q: Coordinates.TotalPoint \where \In[Family.Point] U (apply q) }, V] }]
    (Open.image ({ q: Region.Carrier \where \In[Family.Point] U (apply q) }))
    (Source.OpenNeighborhood[Coordinates.localTopology, p, { q: Coordinates.TotalPoint \where \In[Family.Point] U (apply q) }, Open.image ({ q: Region.Carrier \where \In[Family.Point] U (apply q) })] {
      open := Open.imageOpen Coordinates.localTopology Region.regionOpen ({ q: Region.Carrier \where \In[Family.Point] U (apply q) }) (Region.continuous U open),
      contains := Open.imageMember ({ q: Region.Carrier \where \In[Family.Point] U (apply q) }) (\into[Coordinates.TotalPoint](p, Region.region) \by { bound.contains }) member,
      within := \fun (q: Coordinates.TotalPoint)(inside: _) => Open.imageElim ({ q: Region.Carrier \where \In[Family.Point] U (apply q) }) q (\In[Family.Point] U (apply q))
        (\fun (r: Region.Carrier)(inU: _)(same: r = q) => \idelim r = q \with s: Coordinates.TotalPoint => \In[Family.Point] U (apply s) \by { base: inU, equality: same }) inside
    });
