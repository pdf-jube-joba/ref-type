\import \parent.Comparison[left := left, right := right] \as Forward;
\import \parent.Comparison[left := right, right := left] \as Backward;
\definition homeomorphism: topology.Homeomorphism[A := Family.Point, B := Family.Point].Homeomorphism[bundle.totalSpace, bundle.totalSpace] :=
  topology.Homeomorphism[A := Family.Point, B := Family.Point].Homeomorphism[bundle.totalSpace, bundle.totalSpace] {
    forward := Forward.apply, backward := Backward.apply,
    forwardContinuous := Forward.continuous, backwardContinuous := Backward.continuous,
    leftInverse := \fun (p: Family.Point) => \parent.Inverse[left := left, right := right, p := p].inverse,
    rightInverse := \fun (p: Family.Point) => \parent.Inverse[left := right, right := left, p := p].inverse
  };
\definition forwardSquared: \forall (p: Family.Point) -> right.squared (homeomorphism.forward p) = left.squared p := Forward.squaredImage;
\definition backwardSquared: \forall (p: Family.Point) -> left.squared (homeomorphism.backward p) = right.squared p := Backward.squaredImage;
\definition overBase: \forall (p: Family.Point) -> (homeomorphism.forward p).base = p.base := \fun (p: Family.Point) => \refl(p.base);
