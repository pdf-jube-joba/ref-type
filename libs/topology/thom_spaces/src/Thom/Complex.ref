\import complex.Complex[] \as C;
\import real.Analysis[] \as R;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\import \root.Thom[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Theory;
\module For(X: \Set, F: X -> \Set, bundle: Bundles.Family[X := X, F := F].Bundle);

\module DirectSum(X: \Set, F, G: X -> \Set,
  left: Bundles.Family[X := X, F := F].Bundle, right: Bundles.Family[X := X, F := G].Bundle,
  same: left.baseSpace = right.baseSpace,
  leftMetric: Theory.For[X := X, F := F, bundle := left].Metric, rightMetric: Theory.For[X := X, F := G, bundle := right].Metric);
\module Trivial(X: \Set, n: N.Nat^, baseSpace: topology.Topology[Carrier := X].Topology);
