\import real.Analysis[] \as R;
\import complex.Complex[] \as C;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Complements;
\definition baseTopology: topology.Topology[Carrier := C.Complex].Topology := (vector_bundles.Bundles[].Complex[].scalar).topological.space;
\import Bundles.Trivial[X := C.Complex, n := one, baseSpace := baseTopology] \as Line;
\import Bundles.Family[X := C.Complex, F := (\fun (x: C.Complex) => Bundles.Vector one)] \as Family;
\import Complements.For[X := C.Complex, F := (\fun (x: C.Complex) => Bundles.Vector one), bundle := Line.bundle] \as Metrics;
\definition embedding: Metrics.Embedding := Metrics.Embedding {
  dimension := one, map := Bundles.Identity[X := C.Complex, F := (\fun (x: C.Complex) => Bundles.Vector one), bundle := Line.bundle].map,
  injective := \fun (x: C.Complex)(v, w: Bundles.Vector one)(same: v = w) => same
};
\definition standard: Metrics.Metric := Metrics.FromEmbedding[embedding := embedding].metric;
\definition moving: Metrics.Metric := Complements.Examples[].Moving[].metric;
\import \root.Thom[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].For[X := C.Complex, F := (\fun (x: C.Complex) => Bundles.Vector one), bundle := Line.bundle] \as Theory;
\import Theory.With[metric := standard] \as Standard;
\import Theory.With[metric := moving] \as Moving;
\import \root.Thom[].Complex[].For[X := C.Complex, F := (\fun (x: C.Complex) => Bundles.Vector one), bundle := Line.bundle].Change[left := moving, right := standard] \as Change;
\definition metricIndependence: topology.Homeomorphism[A := Moving.Thom, B := Standard.Thom].Homeomorphism[Moving.thomTopology, Standard.thomTopology] := Change.thomHomeomorphism;
\definition boundaryCofibration: algebraic_topology.Cofibration[A := Moving.DiskBundle, subset := Moving.Boundary].IsCofibration Moving.diskTopology := Moving.Radial[].Boundary[].cofibration;
\import \root.Thom[].Complex[].Trivial[X := C.Complex, n := one, baseSpace := baseTopology] \as Trivial;
\import Trivial.Compare[metric := moving] \as Presentation;
\import \root.Thom[].DiskSuspension[X := C.Complex, space := baseTopology, n := Trivial.dimension] \as Suspension;
\definition suspension: topology.Homeomorphism[A := Moving.Thom, B := Suspension.Carrier].Homeomorphism[Moving.thomTopology, Suspension.topology] := Presentation.homeomorphism;
\import \root.Thom[].FirstSuspensions[X := C.Complex, source := baseTopology] \as NativePresentation;
\import \root.Thom[].Adjoin[A := C.Complex, source := baseTopology] \as Plus;
\import puppe_sequences.Puppe[].Suspension[A := Plus.Carrier, source := Plus.pointed] \as Once;
\import puppe_sequences.Puppe[].Suspension[A := Once.Carrier, source := Once.pointed] \as Native;
\definition nativeSuspension: topology.Homeomorphism[A := Moving.Thom, B := Native.Carrier].Homeomorphism[Moving.thomTopology, Native.topology] :=
  topology.Homeomorphism[A := Moving.Thom, B := Suspension.Carrier].Composition[C := Native.Carrier].compose Moving.thomTopology Suspension.topology Native.topology suspension NativePresentation.twice;
