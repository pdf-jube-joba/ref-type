\import real.Analysis[] \as R;
\import complex.Complex[] \as C;
\import \root.Thom[].CWType[].Empty[] \as Vertex;
\import vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Bundles;
\import bundle_complements.Complements[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Complements;
\import Bundles.Trivial[X := Vertex.Carrier, n := n, baseSpace := Vertex.topology] \as Bundle;
\import Complements.For[X := Vertex.Carrier, F := (\fun (x: Vertex.Carrier) => Bundles.Vector n), bundle := Bundle.bundle] \as Metrics;
\definition embedding: Metrics.Embedding := Metrics.Embedding {
  dimension := n, map := Bundles.Identity[X := Vertex.Carrier, F := (\fun (x: Vertex.Carrier) => Bundles.Vector n), bundle := Bundle.bundle].map,
  injective := \fun (x: Vertex.Carrier)(v, w: Bundles.Vector n)(same: v = w) => same
};
\definition metric: Metrics.Metric := Metrics.FromEmbedding[embedding := embedding].metric;
\import \root.Thom[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].For[X := Vertex.Carrier, F := (\fun (x: Vertex.Carrier) => Bundles.Vector n), bundle := Bundle.bundle].With[metric := metric] \as Source;
\import \root.Thom[].Real[].For[X := Vertex.Carrier, F := (\fun (x: Vertex.Carrier) => Bundles.Vector n), bundle := Bundle.bundle].FiniteBase[metric := metric, complex := Vertex.complex] \as Finite;
\definition pairType: \exists \root.Thom[].CWType[].PairFiniteType[A := Source.DiskBundle, source := Source.diskTopology, subset := Source.Boundary].Data := Finite.pairFiniteType;
\definition diskCompact: topology.Topology[Carrier := Source.DiskBundle].IsCompact Source.diskTopology := Finite.diskCompact;
\definition boundaryCofibration: algebraic_topology.Cofibration[A := Source.DiskBundle, subset := Source.Boundary].IsCofibration Source.diskTopology := Source.Radial[].Boundary[].cofibration;
