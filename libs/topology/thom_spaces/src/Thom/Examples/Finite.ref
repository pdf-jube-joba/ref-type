\module Real(n: N.Nat^);
\module Complex(n: N.Nat^);
\module EmptyReal(n: N.Nat^);
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition rankZeroReal: _ := Real[n := N.Nat^::zero].pairType;
\definition rankZeroComplex: _ := Complex[n := N.Nat^::zero].pairType;
\definition realLine: _ := Real[n := one].pairType;
\definition complexLine: _ := Complex[n := one].pairType;
\definition emptyBase: _ := EmptyReal[n := one].pairType;
