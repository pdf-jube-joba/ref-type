\import real.Analysis[] \as R;
\import complex.Complex[] \as C;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Bundles;
\import bundle_complements.Complements[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Complements;
\definition baseTopology: topology.Topology[Carrier := R.Real].Topology := (vector_bundles.Bundles[].Real[].scalar).topological.space;
\import Bundles.Trivial[X := R.Real, n := one, baseSpace := baseTopology] \as Line;
\import Bundles.Family[X := R.Real, F := (\fun (x: R.Real) => Bundles.Vector one)] \as Family;
\import Complements.For[X := R.Real, F := (\fun (x: R.Real) => Bundles.Vector one), bundle := Line.bundle] \as Metrics;
\definition embedding: Metrics.Embedding := Metrics.Embedding {
  dimension := one, map := Bundles.Identity[X := R.Real, F := (\fun (x: R.Real) => Bundles.Vector one), bundle := Line.bundle].map,
  injective := \fun (x: R.Real)(v, w: Bundles.Vector one)(same: v = w) => same
};
\definition standard: Metrics.Metric := Metrics.FromEmbedding[embedding := embedding].metric;
\definition moving: Metrics.Metric := Complements.Examples[].Moving[].metric;
\import \root.Thom[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].For[X := R.Real, F := (\fun (x: R.Real) => Bundles.Vector one), bundle := Line.bundle] \as Theory;
\import Theory.With[metric := standard] \as Standard;
\import Theory.With[metric := moving] \as Moving;
\import \root.Thom[].Real[].For[X := R.Real, F := (\fun (x: R.Real) => Bundles.Vector one), bundle := Line.bundle].Change[left := moving, right := standard] \as Change;
\definition metricIndependence: topology.Homeomorphism[A := Moving.Thom, B := Standard.Thom].Homeomorphism[Moving.thomTopology, Standard.thomTopology] := Change.thomHomeomorphism;
\definition boundaryCofibration: algebraic_topology.Cofibration[A := Moving.DiskBundle, subset := Moving.Boundary].IsCofibration Moving.diskTopology := Moving.Radial[].Boundary[].cofibration;
\import \root.Thom[].Real[].Trivial[X := R.Real, n := one, baseSpace := baseTopology] \as Trivial;
\import Trivial.Compare[metric := moving] \as Presentation;
\import \root.Thom[].DiskSuspension[X := R.Real, space := baseTopology, n := Trivial.dimension] \as Suspension;
\definition suspension: topology.Homeomorphism[A := Moving.Thom, B := Suspension.Carrier].Homeomorphism[Moving.thomTopology, Suspension.topology] := Presentation.homeomorphism;
