\import vector_bundles.Bundles[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Bundles;
\import bundle_operations.Operations[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Operations;
\import bundle_complements.Complements[].Over[K := K, field := field, conjugation := conjugation, scalar := scalar] \as Complements;
\import linear_algebra.Hermitian[].Over[K := K, field := field, scalar := conjugation] \as Geometry;
\import linear_algebra.Commutative[K := K, scalarRing := Fields.fieldAsCommutativeRing K field] \as Spaces;
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as Order;
\module For(X: \Set, F: X -> \Set, bundle: Bundles.Family[X := X, F := F].Bundle);
\module Box(X: \Set, F, G: X -> \Set, left: Bundles.Family[X := X, F := F].Bundle, right: Bundles.Family[X := X, F := G].Bundle,
  same: left.baseSpace = right.baseSpace, leftMetric: Complements.For[X := X, F := F, bundle := left].Metric, rightMetric: Complements.For[X := X, F := G, bundle := right].Metric);
\module TrivialModel(X: \Set, n, d: N.Nat^, baseSpace: topology.Topology[Carrier := X].Topology,
  frame: linear_algebra.Commutative[K := real.Analysis[].Real, scalarRing := Fields.fieldAsCommutativeRing real.Analysis[].Real real.Analysis[].Algebra[].field].Isomorphism[
    V := Bundles.Vector n, W := vector_bundles.Bundles[].Over[K := real.Analysis[].Real, field := real.Analysis[].Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].Vector d,
    source := Operations.RealScalars[V := Bundles.Vector n, space := Bundles.coordinates n].realSpace,
    target := vector_bundles.Bundles[].Over[K := real.Analysis[].Real, field := real.Analysis[].Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].coordinates d].Isomorphism,
  forwardRegular: topology.Continuity[A := Bundles.Vector n, B := algebraic_topology.Euclidean[].Dimension[n := d].Coordinate].Continuous (Bundles.coordinateTopology n) algebraic_topology.Euclidean[].Dimension[n := d].topology frame.forward.apply,
  backwardRegular: topology.Continuity[A := algebraic_topology.Euclidean[].Dimension[n := d].Coordinate, B := Bundles.Vector n].Continuous algebraic_topology.Euclidean[].Dimension[n := d].topology (Bundles.coordinateTopology n) frame.backward.apply);
