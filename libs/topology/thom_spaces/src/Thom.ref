\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Pair[] \as Pair;
\import std.Data[].Sum[] \as Sum;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\import std.Logic[].Classical[] \as Classical;
\import std.Alg[].Field[] \as Fields;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\use Logic.either;
\inductive Unit: \Set := | point: Unit;
\definition unitUnique: \forall (x: Unit) -> x = Unit::point :=
  \induction (x: Unit) \return x = Unit::point \with { | point: \refl(Unit::point) };
\module Collapse(A: \Set, source: topology.Topology[Carrier := A].Topology, subset: \Pow A);
\module Over(K: \Set, field: Fields.Field[K], conjugation: linear_algebra.Hermitian[].Scalar[K, field], scalar: vector_bundles.Bundles[].Scalar[K, field, conjugation]);
\module CompactAction(A, B, T: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology,
  parameter: topology.Topology[Carrier := T].Topology,
  action: std.Data[].Pair[].Times^[A, T] -> B, f: A -> B, choose: A -> T, zero: \Pow A);
\module Quadratic;
\module CollapseComparison(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology,
  subset: \Pow A, targetSubset: \Pow B,
  h: topology.Homeomorphism[A := A, B := B].Homeomorphism[source, target],
  forwardPreserves: \forall (x: A) -> \In[A] subset x -> \In[B] targetSubset (h.forward x),
  backwardPreserves: \forall (y: B) -> \In[B] targetSubset y -> \In[A] subset (h.backward y));
\module Levels(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology,
  q: A -> real.Analysis[].Real, r: B -> real.Analysis[].Real,
  h: topology.Homeomorphism[A := A, B := B].Homeomorphism[source, target],
  forwardSquared: \forall (x: A) -> r (h.forward x) = q x,
  backwardSquared: \forall (y: B) -> q (h.backward y) = r y);
\module Real;
\module Complex;
\module Iterated(A: \Set, source: topology.Topology[Carrier := A].Topology, first, second: \Pow A);
\module Tube(A, B: \Set);
\module DiskSuspension(X: \Set, space: topology.Topology[Carrier := X].Topology, n: N.Nat^);
\module Examples;
