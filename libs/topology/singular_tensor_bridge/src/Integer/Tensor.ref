\import Algebra.Restriction[C := C] \as Left;
\import Algebra.Restriction[C := D] \as Right;
\import Tensors.Tensor[C := C, D := D] \as SignedTensor;
\import Tensors.Total[C := SignedTensor.complex] \as Source;
\import Algebra.Restriction[C := Source.complex] \as SourceRestriction;
\import Double.Tensor[C := Left.complex, D := Right.complex] \as NativeTensor;
\import Double.Total[C := NativeTensor.complex] \as Target;
\import Native.ZeroExtension[C := Target.complex] \as TargetExtension;
\import \root.Integer[].Indices[] \as Indices;
\definition LeftNegative: \Prop := Left.NegativeVanishes;
\definition RightNegative: \Prop := Right.NegativeVanishes;
\module With(leftNegative: LeftNegative, rightNegative: RightNegative);
