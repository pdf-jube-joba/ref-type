\definition backwardCommutes: \forall (z: I.Int^)(x: Extension.Carrier z) ->
  (C.differential).apply z ((backwardComponent z).apply x) =
    (backwardComponent (Degrees.previous z)).apply (Extension.apply z x) :=
  \induction (z: I.Int^) \return \forall (x: Extension.Carrier z) ->
    (C.differential).apply z ((backwardComponent z).apply x) =
      (backwardComponent (Degrees.previous z)).apply (Extension.apply z x) \with {
    | ofNat: \induction (n: N.Nat^) \return \forall (x: Extension.Carrier (I.Int^::ofNat n)) ->
        (C.differential).apply (I.Int^::ofNat n) ((backwardComponent (I.Int^::ofNat n)).apply x) =
          (backwardComponent (Degrees.previous (I.Int^::ofNat n))).apply (Extension.apply (I.Int^::ofNat n) x) \with {
      | zero: \fun (x: Extension.Carrier (I.Int^::ofNat N.Nat^::zero)) => negative N.Nat^::zero ((C.differential).apply (I.Int^::ofNat N.Nat^::zero) x)
      | succ: \fun (n: N.Nat^)(unused: _)(x: Extension.Carrier (I.Int^::ofNat (N.Nat^::succ n))) => \refl((C.differential).apply (I.Int^::ofNat (N.Nat^::succ n)) x)
    }
    | negSucc: \fun (n: N.Nat^)(x: Extension.Carrier (I.Int^::negSucc n)) => \parent.Differential[z := I.Int^::negSucc n].zero
  };
\import Signed.Map[C := Extension.complex, D := C] \as Backward;
\definition backward: Backward.Map := Backward.Map {
  apply := \fun (z: I.Int^) => (backwardComponent z).apply,
  addition := \fun (z: I.Int^) => (backwardComponent z).addition,
  scalar := \fun (z: I.Int^) => (backwardComponent z).scalar,
  commutes := backwardCommutes,
};
\definition leftInverse: \forall (z: I.Int^)(x: C.family.Carrier z) -> (backward).apply z ((forward).apply z x) = x :=
  \induction (z: I.Int^) \return \forall (x: C.family.Carrier z) -> (backward).apply z ((forward).apply z x) = x \with {
    | ofNat: \fun (n: N.Nat^)(x: C.family.Carrier (I.Int^::ofNat n)) => \refl(x)
    | negSucc: \fun (n: N.Nat^)(x: C.family.Carrier (I.Int^::negSucc n)) => sym!{{C.family.Carrier (I.Int^::negSucc n)}} _ _ (negative n x)
  };
\definition rightInverse: \forall (z: I.Int^)(x: Extension.Carrier z) -> (forward).apply z ((backward).apply z x) = x :=
  \induction (z: I.Int^) \return \forall (x: Extension.Carrier z) -> (forward).apply z ((backward).apply z x) = x \with {
    | ofNat: \fun (n: N.Nat^)(x: Extension.Carrier (I.Int^::ofNat n)) => \refl(x)
    | negSucc: \fun (n: N.Nat^)(x: Extension.Carrier (I.Int^::negSucc n)) => sym!{{Extension.Carrier (I.Int^::negSucc n)}} _ _ (Extension.Negative[n := n].zero x)
  };
\import Signed.Isomorphism[C := C, D := Extension.complex] \as Compared;
\definition data: Compared.Data := Compared.Data { forward := forward, backward := backward };
\definition isomorphism: Compared.Isomorphism := \into[Compared.Data](data, { d: Compared.Data \where Compared.Laws[d] }) \by {
  Compared.Laws[data] { leftInverse := leftInverse, rightInverse := rightInverse }
};
\import Signed.Equivalence[C := C, D := Extension.complex].FromIsomorphism[] \as Equivalences;
\definition equivalence: Signed.Equivalence[C := C, D := Extension.complex].Equivalence := Equivalences.apply isomorphism;
