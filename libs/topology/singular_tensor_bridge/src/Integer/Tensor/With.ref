\module TrivialLeft(p: N.Nat^, q: I.Int^) {
  \import Modules.Tensor[V := C.family.Carrier (I.Int^::negSucc p), W := D.family.Carrier q,
    left := C.family.space (I.Int^::negSucc p), right := D.family.space q] \as Term;
  \import Modules.Hom[V := Term.Carrier, W := Term.Carrier, source := Term.space, target := Term.space] \as Maps;
  \import Modules.End[V := Term.Carrier, space := Term.space] \as Identity;
  \import Term.Universal[U := Term.Carrier, target := Term.space] \as Equality;
  \definition equality: Identity.identity = Maps.zeroMap := Equality.ext Identity.identity Maps.zeroMap
    (\fun (x: C.family.Carrier (I.Int^::negSucc p))(y: D.family.Carrier q) => trans!{Term.Carrier} _ _ _
      (congr!{{C.family.Carrier (I.Int^::negSucc p)} Term.Carrier} (\fun (v: C.family.Carrier (I.Int^::negSucc p)) => Term.tensor v y) _ _ (leftNegative p x))
      (Term.tensorZeroLeft y));
  \definition zero(x: Term.Carrier): x = #zero{Term.space} :=
    congr!{Maps.Map Term.Carrier} (\fun (f: Maps.Map) => #apply{f} x) _ _ equality;
}
\module TrivialRight(p: I.Int^, q: N.Nat^) {
  \import Modules.Tensor[V := C.family.Carrier p, W := D.family.Carrier (I.Int^::negSucc q),
    left := C.family.space p, right := D.family.space (I.Int^::negSucc q)] \as Term;
  \import Modules.Hom[V := Term.Carrier, W := Term.Carrier, source := Term.space, target := Term.space] \as Maps;
  \import Modules.End[V := Term.Carrier, space := Term.space] \as Identity;
  \import Term.Universal[U := Term.Carrier, target := Term.space] \as Equality;
  \definition equality: Identity.identity = Maps.zeroMap := Equality.ext Identity.identity Maps.zeroMap
    (\fun (x: C.family.Carrier p)(y: D.family.Carrier (I.Int^::negSucc q)) => trans!{Term.Carrier} _ _ _
      (congr!{{D.family.Carrier (I.Int^::negSucc q)} Term.Carrier} (Term.tensor x) _ _ (rightNegative q y))
      (Term.tensorZeroRight x));
  \definition zero(x: Term.Carrier): x = #zero{Term.space} :=
    congr!{Maps.Map Term.Carrier} (\fun (f: Maps.Map) => #apply{f} x) _ _ equality;
}
\module Negative(n: N.Nat^);
\module Positive(n: N.Nat^);
