\import \parent.Both[p := p, q := q, closed := closed] \as At;
\definition left[x: SignedTensor.family.Carrier (I.Int^::ofNat p) (I.Int^::ofNat q)]:
  (leftComposite).apply ((S.Component[i := At.sourceIndex].injection).apply x) =
    (S.Component[i := At.sourceIndex].injection).apply x :=
  trans!{S.Carrier} _ _ _
    (congr!{T.Carrier S.Carrier} ((backward).apply) _ _ (forwardOnInjection At.sourceIndex x))
    (backwardOnInjection At.targetIndex x);
\definition right[x: NativeTensor.family.Carrier p q]:
  (rightComposite).apply ((T.Component[i := At.targetIndex].injection).apply x) =
    (T.Component[i := At.targetIndex].injection).apply x :=
  trans!{T.Carrier} _ _ _
    (congr!{S.Carrier T.Carrier} ((forward).apply) _ _ (backwardOnInjection At.targetIndex x))
    (forwardOnInjection (Indices.signed n At.targetIndex) x);
