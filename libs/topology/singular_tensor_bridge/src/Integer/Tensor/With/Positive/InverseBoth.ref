\import \parent.Both[p := p, q := q, closed := closed] \as At;
\definition left(x: SignedTensor.family.Carrier (I.Int^::ofNat p) (I.Int^::ofNat q)):
  #apply{leftComposite} (#apply{(S.Component[i := At.sourceIndex].injection)} x) =
    #apply{(S.Component[i := At.sourceIndex].injection)} x :=
  trans!{S.Carrier} _ _ _
    (congr!{T.Carrier S.Carrier} (#apply{backward}) _ _ (forwardOnInjection At.sourceIndex x))
    (backwardOnInjection At.targetIndex x);
\definition right(x: NativeTensor.family.Carrier p q):
  #apply{rightComposite} (#apply{(T.Component[i := At.targetIndex].injection)} x) =
    #apply{(T.Component[i := At.targetIndex].injection)} x :=
  trans!{T.Carrier} _ _ _
    (congr!{S.Carrier T.Carrier} (#apply{forward}) _ _ (backwardOnInjection At.targetIndex x))
    (forwardOnInjection (Indices.signed n At.targetIndex) x);
