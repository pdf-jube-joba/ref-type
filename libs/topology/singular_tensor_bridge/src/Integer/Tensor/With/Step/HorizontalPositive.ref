\definition sourceIndex: Double.Index (N.Nat^::succ n) := Double.index (N.Nat^::succ n) (N.Nat^::succ p) q;
\definition targetIndex: Double.Index n := Double.index n p (NativeStep.lowerSecond p q);
\import NativeTensor.At[p := p, q := q] \as Boundary;
\definition law[x: NativeTensor.family.Carrier (N.Nat^::succ p) q]:
  (Q.backward).apply ((NativeStep.horizontal (N.Nat^::succ p) q).apply x) =
    (SignedStep.Component[i := Indices.signed (N.Nat^::succ n) sourceIndex].horizontal).apply x :=
  Q.backwardOnInjection targetIndex ((Boundary.horizontal).apply x);
