\definition sourceIndex: Double.Index (N.Nat^::succ n) := Double.index (N.Nat^::succ n) N.Nat^::zero q;
\definition signedIndex: Grading.Index z := Indices.signed (N.Nat^::succ n) sourceIndex;
\import SignedStep.Component[i := signedIndex] \as Component;
\import Source.Term[n := I.Int^::ofNat n].Component[i := Grading.horizontal z signedIndex] \as Injection;
\import \parent.\parent.HorizontalZero[q := I.Int^::ofNat q] \as Boundary;
\import Modules.Tensor[V := C.family.Carrier (I.Int^::negSucc N.Nat^::zero), W := D.family.Carrier (I.Int^::ofNat q),
  left := C.family.space (I.Int^::negSucc N.Nat^::zero), right := D.family.space (I.Int^::ofNat q)] \as TargetTerm;
\import Modules.Hom[V := TargetTerm.Carrier, W := ST.Carrier,
  source := TargetTerm.space, target := ST.space] \as InjectionMaps;
\definition signedZero(x: NativeTensor.family.Carrier N.Nat^::zero q): #apply{Component.horizontal} x = #zero{ST.space} :=
  trans!{ST.Carrier} _ _ _ (congr!{TargetTerm.Carrier ST.Carrier} (#apply{Injection.injection}) _ _ (Boundary.zero x))
    (InjectionMaps.zeroPreserved Injection.injection);
\definition law(x: NativeTensor.family.Carrier N.Nat^::zero q):
  #apply{Q.backward} (#apply{(NativeStep.horizontal N.Nat^::zero q)} x) = #apply{Component.horizontal} x :=
  trans!{ST.Carrier} _ _ _ (BackwardMaps.zeroPreserved Q.backward) (sym!{ST.Carrier} _ _ (signedZero x));
