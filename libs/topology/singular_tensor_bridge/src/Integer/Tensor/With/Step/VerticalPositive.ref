\definition sourceIndex: Double.Index (N.Nat^::succ n) := Double.reverseIndex (N.Nat^::succ n) (N.Nat^::succ q) p;
\definition targetIndex: Double.Index n := Double.reverseIndex n q (NativeStep.lowerFirst q p);
\import NativeTensor.At[p := p, q := q] \as Boundary;
\import Double.Sign[V := NativeTensor.family.Carrier p q, space := NativeTensor.family.space p q] \as Sign;
\definition law(x: NativeTensor.family.Carrier p (N.Nat^::succ q)):
  #apply{Q.backward} (#apply{(NativeStep.vertical (N.Nat^::succ q) p)} x) =
    #apply{(SignedStep.Component[i := Indices.signed (N.Nat^::succ n) sourceIndex].vertical)} x :=
  Q.backwardOnInjection targetIndex (#apply{(Sign.map p)} (#apply{Boundary.vertical} x));
