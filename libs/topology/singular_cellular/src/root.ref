\module Algebra;

\module FiniteUnion(A, C: \Set, source: topology.Topology[Carrier := A].Topology, pieces: C -> \Pow A);
\module ProductHomeomorphism(X, A, B: \Set,
  factor: topology.Topology[Carrier := X].Topology,
  source: topology.Topology[Carrier := A].Topology,
  target: topology.Topology[Carrier := B].Topology,
  e: topology.Homeomorphism[A := A, B := B].Homeomorphism[source, target]);
\module Coproduct(Index: \Set, fibers: Index -> \Set,
  spaces: \forall (i: Index) -> topology.Topology[Carrier := fibers i].Topology);
\module DiskCollar(n: std.Data[].Nat[].Nat^);


\module DiskSphere(n: std.Data[].Nat[].Nat^);
\module DiskLocal(n: std.Data[].Nat[].Nat^);
\module Disks;
\module DiskRelative(n: std.Data[].Nat[].Nat^);
\module On(A: \Set, source: topology.Topology[Carrier := A].Topology,
  complex: algebraic_topology.CW[A := A].FiniteComplex[source]);
