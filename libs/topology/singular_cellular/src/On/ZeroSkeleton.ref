\import std.Data[].FinSet[] \as Fin;
\definition zero: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zero;
\import \parent.Filtration[].Stage[limit := one] \as Stage;
\definition Carrier: \Set := Stage.Carrier;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Stage.topology;
\module Disk(cell: Cells.CellData, member: Cells.CellMember cells cell, below: Nat.Lt (#dimension{cell}) one);
\module Mapping(B: \Set, target: topology.Topology[Carrier := B].Topology, f: Carrier -> B);

\module Homology(z: I.Int^);
