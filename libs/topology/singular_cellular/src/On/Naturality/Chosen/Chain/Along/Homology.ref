\import \parent.\parent.\parent.\parent.\parent.Cellular[] \as SourceCellular;
\import resolutions.TensorComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Tensor;
\import Tensor.Integer[P := SourceCellular.integerComplex, N := coefficients] \as SourceCell;
\import Tensor.Integer[P := Target.Cellular[].integerComplex, N := coefficients] \as TargetCell;
\import Tensor.Integer[P := SourceSingular.integerComplex, N := coefficients] \as SourceOrdinary;
\import Tensor.Integer[P := TargetSingular.integerComplex, N := coefficients] \as TargetOrdinary;
\import singular_finite_algebra.Integer[] \as Finite;
\import Finite.CoefficientTensor[P := SourceCellular.integerComplex, Q := Target.Cellular[].integerComplex, coefficients := coefficients] \as Cellular;
\import Finite.CoefficientTensor[P := SourceSingular.integerComplex, Q := TargetSingular.integerComplex, coefficients := coefficients] \as Singular;
\import Finite.CoefficientTensor[P := TargetSingular.integerComplex, Q := Target.Cellular[].integerComplex, coefficients := coefficients] \as Recover;
\import Finite.CoefficientTensor[P := Target.Cellular[].integerComplex, Q := TargetSingular.integerComplex, coefficients := coefficients] \as TargetPush;
\import Finite.CoefficientTensor[P := SourceCellular.integerComplex, Q := TargetSingular.integerComplex, coefficients := coefficients] \as Intermediate;
\import Finite.CoefficientComposition[P := SourceCellular.integerComplex, Q := SourceSingular.integerComplex,
  T := TargetSingular.integerComplex, coefficients := coefficients] \as FirstCoefficients;
\import Finite.CoefficientComposition[P := SourceCellular.integerComplex, Q := TargetSingular.integerComplex,
  T := Target.Cellular[].integerComplex, coefficients := coefficients] \as SecondCoefficients;
\import Finite.CoefficientEquivalence[P := Target.Cellular[].integerComplex, Q := TargetSingular.integerComplex, coefficients := coefficients] \as Invariant;
\import Complexes.Map[C := SourceCell.complex, D := TargetCell.complex] \as CellularMaps;
\import Complexes.Map[C := SourceCell.complex, D := TargetOrdinary.complex] \as IntermediateMaps;
\import Complexes.Map[C := Target.Cellular[].integerComplex, D := TargetSingular.integerComplex] \as TargetMaps;
\import Complexes.Map[C := SourceOrdinary.complex, D := TargetOrdinary.complex].Composition[B := SourceCell.complex] \as FirstTensor;
\import Complexes.Map[C := TargetOrdinary.complex, D := TargetCell.complex].Composition[B := SourceCell.complex] \as SecondTensor;
\import Complexes.Equivalence[C := TargetCell.complex, D := TargetOrdinary.complex] \as Equivalence;
\definition chainMap: CellularMaps.Map := Cellular.On[f := map].map;
\module At(z: I.Int^);
