\import Hom.Integer[P := \parent.\parent.\parent.\parent.\parent.Cellular[].integerComplex, N := coefficients] \as SourceCell;
\import Hom.Integer[P := Target.Cellular[].integerComplex, N := coefficients] \as TargetCell;
\import Hom.Integer[P := SourceSingular.integerComplex, N := coefficients] \as SourceOrdinary;
\import Hom.Integer[P := TargetSingular.integerComplex, N := coefficients] \as TargetOrdinary;
\import Hom.IntegerHomotopy[P := \parent.\parent.\parent.\parent.\parent.Cellular[].integerComplex, Q := Target.Cellular[].integerComplex, N := coefficients] \as Cellular;
\import Hom.IntegerHomotopy[P := SourceSingular.integerComplex, Q := TargetSingular.integerComplex, N := coefficients] \as Singular;
\import Hom.IntegerHomotopy[P := TargetSingular.integerComplex, Q := Target.Cellular[].integerComplex, N := coefficients] \as Recover;
\import Hom.IntegerHomotopy[P := Target.Cellular[].integerComplex, Q := TargetSingular.integerComplex, N := coefficients] \as TargetPull;
\import Hom.IntegerHomotopy[P := \parent.\parent.\parent.\parent.\parent.Cellular[].integerComplex, Q := TargetSingular.integerComplex, N := coefficients] \as Intermediate;
\import Hom.IntegerComposition[P := \parent.\parent.\parent.\parent.\parent.Cellular[].integerComplex, Q := SourceSingular.integerComplex,
  T := TargetSingular.integerComplex, N := coefficients] \as FirstComposition;
\import Hom.IntegerComposition[P := \parent.\parent.\parent.\parent.\parent.Cellular[].integerComplex, Q := TargetSingular.integerComplex,
  T := Target.Cellular[].integerComplex, N := coefficients] \as SecondComposition;
\import Hom.IntegerEquivalence[P := Target.Cellular[].integerComplex, Q := TargetSingular.integerComplex, N := coefficients] \as Invariant;
\definition cochainMap: Cochains.Map[C := TargetCell.complex, D := SourceCell.complex].Map := Cellular.map map;
\module At(z: I.Int^);
