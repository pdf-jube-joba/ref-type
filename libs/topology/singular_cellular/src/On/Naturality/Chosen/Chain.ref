\definition forwardLaw: (e).forward = TargetComparison.integerMap :=
  \bysub(TargetEquivalences.Equivalence, { q: TargetEquivalences.Equivalence \where (q).forward = TargetComparison.integerMap }, e);
\import singular_cohomology.Maps[A := A, B := B, source := source, target := target] \as Maps;
\import Complexes.Map[C := SourceSingular.integerComplex, D := TargetSingular.integerComplex]
  .Composition[B := \parent.\parent.\parent.Cellular[].integerComplex] \as First;
\import Complexes.Map[C := TargetSingular.integerComplex, D := Target.Cellular[].integerComplex]
  .Composition[B := \parent.\parent.\parent.Cellular[].integerComplex] \as Second;
\module Along(f: A -> B, continuous: Maps.Continuous f);
