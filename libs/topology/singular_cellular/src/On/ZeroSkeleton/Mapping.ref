\module Cell(cell: Cells.CellData, member: Cells.CellMember cells cell, below: Nat.Lt (#dimension{cell}) one);
\definition continuous: topology.Continuity[A := Carrier, B := B].Continuous topology target f :=
  \fun (U: \Pow B)(open: topology.Topology[Carrier := B].IsOpenIn target U) =>
    #rtl{(Stage.Open[].criterion ({ x: Carrier \where \In[B] U (f x) }))}
      (\fun (cell: Cells.CellData)(member: _)(below: _) => Cell[cell := cell, member := member, below := below].continuous U open);
