\import Euclidean.Dimension[n := (cell).dimension] \as Model;
\definition dimension: (cell).dimension = zero := Nat.leZeroEq ((cell).dimension)
  (Nat.leOfSuccSucc ((cell).dimension) zero (Nat.succLeOfLt one ((cell).dimension) below));
\definition indexImpossible: \forall (i: Model.Index) -> Logic.False :=
  \idelim zero = (cell).dimension \with n: N.Nat^ => \forall (i: Fin.Fin n) -> Logic.False \by {
    base: \fun (i: Fin.Fin zero) => Fin.zeroImpossible i (Fin.bound zero i), equality: sym!{N.Nat^} _ _ dimension
  };
\definition unique[p, q: Model.Disk]: p = q := \axiom:funext(p, q, \fun (i: Model.Index) => Logic.falseElim (p i = q i) (indexImpossible i));
\definition origin: Model.Disk := Model.Contraction[].origin;
\definition normZero[p: Model.Disk]: Model.normSquared p = real.Analysis[].zero :=
  trans!{real.Analysis[].Real} _ _ _ (congr!{Model.Disk {real.Analysis[].Real}} (\fun (x: Model.Disk) => Model.normSquared x) _ _ (unique p origin))
    (Model.Contraction[].zeroSum (std.Data[].FinSet[].elements ((cell).dimension)));
