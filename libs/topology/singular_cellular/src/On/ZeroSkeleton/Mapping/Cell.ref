\import \parent.\parent.Disk[cell := cell, member := member, below := below] \as Point;
\import Euclidean.Dimension[n := #dimension{cell}] \as Model;
\definition value: B := f (Stage.Open[].lift cell member below Point.origin);
\definition equation: (\fun (p: Model.Disk) => value) = (\fun (p: Model.Disk) => f (Stage.Open[].lift cell member below p)) :=
  \axiom:funext((\fun (p: Model.Disk) => value), (\fun (p: Model.Disk) => f (Stage.Open[].lift cell member below p)), \fun (p: Model.Disk) => congr!{Model.Disk B} (\fun (q: Model.Disk) => f (Stage.Open[].lift cell member below q)) _ _ (Point.unique Point.origin p));
\definition continuous: topology.Continuity[A := Model.Disk, B := B].Continuous Model.diskTopology target
  (\fun (p: Model.Disk) => f (Stage.Open[].lift cell member below p)) :=
  \idelim (\fun (p: Model.Disk) => value) = (\fun (p: Model.Disk) => f (Stage.Open[].lift cell member below p))
    \with g: (Model.Disk -> B) => topology.Continuity[A := Model.Disk, B := B].Continuous Model.diskTopology target g \by {
      base: topology.Maps[A := Model.Disk, B := B].constantContinuous Model.diskTopology target value,
      equality: equation
    };
