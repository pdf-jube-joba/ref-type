\import \parent.\parent.Filtration[] \as Filtration;
\import Filtration.Stage[limit := zero] \as Lower;
\import singular_cohomology.Chains[A := Carrier, source := topology] \as Chains;
\import singular_cohomology.Chains[A := Lower.Carrier, source := Lower.topology] \as LowerChains;
\import Nonnegative.ZeroExtension[C := Chains.complex] \as Extension;
\import Nonnegative.ZeroExtension[C := LowerChains.complex] \as LowerExtension;
\import \parent.\parent.Layer[n := zero] \as Layer;
\import singular_cohomology.Calculations[A := Lower.Carrier, source := Lower.topology].ChainEmpty[] \as Empty;
\definition empty[x: Lower.Carrier]: Logic.False :=
  \idelim Filtration.subset zero = Space.Empty \with S: \Pow A => \In[A] S x \by {
    base: \bysub(A, Filtration.subset zero, x), equality: Filtration.empty
  };
\definition quasi: Complexes.Map[C := Extension.complex, D := Layer.complex].QuasiIsomorphism Layer.sequence.projection :=
  Complexes.ShortExact[A := LowerExtension.complex, B := Extension.complex, C := Layer.complex].quasiProjection Layer.sequence
    (\fun (degree: I.Int^) => Empty.Homology[z := degree].zero empty);
\import Complexes.At[C := Extension.complex, z := z] \as H;
\definition Whole: \Set := H.Homology;
\definition space: Modules.Space Whole := H.homologySpace;
\definition isomorphism: Modules.Isomorphism[V := Whole, W := Layer.Homology[z := z].Carrier, source := space, target := Layer.Homology[z := z].space].Isomorphism :=
  Complexes.Map[C := Extension.complex, D := Layer.complex].At[k := z].Invert[f := Layer.sequence.projection].isomorphism (quasi z);
