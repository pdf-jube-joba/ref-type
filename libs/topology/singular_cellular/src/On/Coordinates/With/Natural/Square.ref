\import \parent.\parent.Degree[n := n] \as Lower;
\import \parent.\parent.Degree[n := N.Nat^::succ n] \as Middle;
\import \parent.\parent.Degree[n := N.Nat^::succ (N.Nat^::succ n)] \as Higher;
\definition law: \forall (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) -> apply n (apply (N.Nat^::succ n) x) = #zero{(space n)} :=
  \fun (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) => trans!{{Carrier n}} _ _ _
    (congr!{{Chains.Carrier (N.Nat^::succ n)} {Carrier n}}
      (\fun (y: Chains.Carrier (N.Nat^::succ n)) => #apply{#forward{Lower.isomorphism}} (#apply{(Chains.boundary n)} y)) _ _
      (#leftInverse{Middle.isomorphism} (#apply{(Chains.boundary (N.Nat^::succ n))} (#apply{#backward{Higher.isomorphism}} x))))
    (trans!{{Carrier n}} _ _ _
      (congr!{{Chains.Carrier n} {Carrier n}} (#apply{#forward{Lower.isomorphism}}) _ _
        (#squareZero{Chains.complex.laws} n (#apply{#backward{Higher.isomorphism}} x)))
      (Modules.Hom[V := Chains.Carrier n, W := Carrier n, source := Chains.space n, target := space n].zeroPreserved #forward{Lower.isomorphism}));
