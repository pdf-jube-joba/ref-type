\import homological_algebra.Finite[].Bounded[].Of[C := model] \as Model;
\import \parent.\parent.\parent.\parent.Cellular[] \as Cellular;
\import Cellular.Representatives[].Selected[selection := selection] \as SingularComparison;
\import singular_cohomology.Chains[A := A, source := source] \as Singular;
\import \parent.\parent.Natural[] \as Natural;
\import Nonnegative.ZeroExtension[C := Natural.complex] \as Coordinates;
\import \parent.SignedModel[] \as SignedModel;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Signed;
\import Signed.Equivalence[C := Cellular.integerComplex, D := Coordinates.complex] \as CellularToCoordinates;
\import Signed.Equivalence[C := Coordinates.complex, D := Cellular.integerComplex] \as CoordinatesToCellular;
\definition coordinatesToCellular: CoordinatesToCellular.Equivalence :=
  CellularToCoordinates.Reverse[].apply (CellularToCoordinates.FromIsomorphism[].apply Natural.integerIsomorphism);
\import Signed.Equivalence[C := Model.chain, D := Coordinates.complex] \as ModelToCoordinates;
\import ModelToCoordinates.Composition[E := Cellular.integerComplex] \as ToCellular;
\definition modelToCellular: Signed.Equivalence[C := Model.chain, D := Cellular.integerComplex].Equivalence :=
  ToCellular.compose (ModelToCoordinates.FromIsomorphism[].apply SignedModel.isomorphism) coordinatesToCellular;
\import Signed.Equivalence[C := Model.chain, D := Cellular.integerComplex].Composition[E := Singular.integerComplex] \as ToSingular;
\definition equivalenceExists: \exists Signed.Equivalence[C := Model.chain, D := Singular.integerComplex].Equivalence := \block {
  \takefrom e: \Cast[Signed.Equivalence[C := Cellular.integerComplex, D := Singular.integerComplex].Equivalence]
    ({ e: Signed.Equivalence[C := Cellular.integerComplex, D := Singular.integerComplex].Equivalence \where #forward{e} = SingularComparison.integerMap })
    \by SingularComparison.equivalenceExists \then
  \return \exact(ToSingular.compose modelToCellular e, Signed.Equivalence[C := Model.chain, D := Singular.integerComplex].Equivalence)
};
