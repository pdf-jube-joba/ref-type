\import \parent.\parent.\parent.Filtration[].CellInteriors[n := n] \as Interior;
\definition impossible: Bounds.Lt d n -> \forall (cell: CellIndex n) -> Logic.False :=
  \fun (large: _)(cell: CellIndex n) => Bounds.ltIrrefl n
    (Bounds.ltLeTrans n d n
      (\idelim (cell).dimension = n \with m: N.Nat^ => Bounds.Lt m d \by {
        base: Exhaustion.dimensionBound cells cell (Interior.member cell), equality: Interior.dimension cell })
      (Bounds.leTrans d (N.Nat^::succ d) n (Bounds.leSelfSucc d) (Bounds.succLeOfLt n d large)));
\definition zero: Bounds.Lt d n -> rank n = N.Nat^::zero := \fun (large: _) => emptyRank (rank n)
  (\fun (i: Fin.Fin (rank n)) => impossible large ((indexing n).enumerate i));
