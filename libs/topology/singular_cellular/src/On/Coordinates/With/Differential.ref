\import \parent.Degree[n := n] \as Lower;
\import \parent.Degree[n := N.Nat^::succ n] \as Higher;
\import Modules.FiniteCoordinates[n := rank n] \as Target;
\import Modules.FiniteCoordinates[n := rank (N.Nat^::succ n)] \as Source;
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing].Matrix[m := rank n, n := rank (N.Nat^::succ n)] \as Matrices;
\import Matrices.WithBases[V := Chains.Carrier (N.Nat^::succ n), W := Chains.Carrier n,
  source := Chains.space (N.Nat^::succ n), target := Chains.space n, basisSource := Higher.isomorphism, basisTarget := Lower.isomorphism] \as Based;
\definition matrix: Matrices.Matrix := Based.matrix (Chains.boundary n);
\definition linear: Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map := Based.coordinates (Chains.boundary n);
\import Matrices.Representation[] \as Representation;
\definition represents: Matrices.linear matrix = linear := Representation.mapRoundtrip linear;
\import integer_matrices.IntegerMatrix[m := rank n, n := rank (N.Nat^::succ n)] \as Runtime;
\definition runtime: Runtime.Runtime^ := Runtime.Extension[].extend matrix;
\definition runtimeEntry: \forall (i: Fin.Fin (rank n))(j: Fin.Fin (rank (N.Nat^::succ n))) -> runtime i j = matrix i j := Runtime.Extension[].at matrix;
