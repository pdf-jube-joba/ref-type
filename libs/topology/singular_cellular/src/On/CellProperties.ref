\definition dimension: N.Nat^ := (cell).dimension;
\import Euclidean.Dimension[n := dimension] \as Model;
\import Space.Subspace[S := Cells.ClosedImage cell] \as Image;
\import Image.Properties[] \as Properties;
\definition Carrier: \Set := Image.CarrierSet;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Image.topology source;
\definition map[p: Model.Disk]: Carrier := \into[A]((cell).characteristic p, Cells.ClosedImage cell) \by {
  Logic.existsIntro[Model.Disk, { q: Model.Disk \where (cell).characteristic q = (cell).characteristic p }] p (\refl((cell).characteristic p))
};
\import topology.Continuity[A := Model.Disk, B := A].Corestriction[S := Cells.ClosedImage cell] \as Into;
\definition continuous: topology.Continuity[A := Model.Disk, B := Carrier].Continuous Model.diskTopology topology map :=
  Into.corestrictContinuous Model.diskTopology source map (((laws).cellLaws cell member).continuous);
\definition onto: \forall (x: Carrier) -> \exists ( p: Model.Disk \where map p = x ) := \block {
  \fun (x: Carrier) \then
  \takefrom p: \Cast[Model.Disk] ({ p: Model.Disk \where (cell).characteristic p = x })
    \by \bysub(A, Cells.ClosedImage cell, x) \then
  \return Logic.existsIntro[Model.Disk, { p: Model.Disk \where map p = x }] p
    (\bysub(Model.Disk, { p: Model.Disk \where (cell).characteristic p = x }, p))
};
\import topological_constructions.CompactQuotient[A := Model.Disk, B := Carrier, source := Model.diskTopology, target := topology, q := map] \as Quotient;
\definition quotientMap: topological_constructions.Quotient[A := Model.Disk, B := Carrier].IsQuotientMap[Model.diskTopology, topology, map] :=
  Quotient.quotientMap (Model.Compactness[].compact) (Properties.hausdorff source ((laws).hausdorff)) continuous onto;
\import topological_constructions.CompactQuotient[A := Model.Disk, B := A, source := Model.diskTopology, target := source, q := (cell).characteristic] \as Closed;
\definition closedImage: Closed.ClosedMap :=
  Closed.closedMap (Model.Compactness[].compact) ((laws).hausdorff) (((laws).cellLaws cell member).continuous);
\import topology.Topology[Carrier := Model.Disk] \as DiskSpace;
\import topology.Maps[A := Model.Disk, B := A] \as Images;
\import topology.Compactness[A := Model.Disk, B := A] \as CompactImages;
\definition imageWhole: Images.Image ((cell).characteristic) DiskSpace.Whole = Cells.ClosedImage cell :=
  \axiom:setext(Images.Image ((cell).characteristic) DiskSpace.Whole, Cells.ClosedImage cell,
    \block {
      \fun (x: A)(inside: _) \then
      \takefrom p: \Cast[Model.Disk] ({ p: Model.Disk \where Logic.And[DiskSpace.Member DiskSpace.Whole p, (cell).characteristic p = x] }) \by inside \then
      \return Logic.existsIntro[Model.Disk, { p: Model.Disk \where (cell).characteristic p = x }] p
        ((\bysub(Model.Disk, { p: Model.Disk \where Logic.And[DiskSpace.Member DiskSpace.Whole p, (cell).characteristic p = x] }, p)).right)
    },
    \block {
      \fun (x: A)(inside: _) \then
      \takefrom p: \Cast[Model.Disk] ({ p: Model.Disk \where (cell).characteristic p = x }) \by inside \then
      \return Logic.existsIntro[Model.Disk, { p: Model.Disk \where Logic.And[DiskSpace.Member DiskSpace.Whole p, (cell).characteristic p = x] }] p
        (Logic.And[_, _]::# (\refl(p)) (\bysub(Model.Disk, { p: Model.Disk \where (cell).characteristic p = x }, p)))
    });
\definition compactImage: Space.IsCompactIn source (Cells.ClosedImage cell) :=
  \idelim Images.Image ((cell).characteristic) DiskSpace.Whole = Cells.ClosedImage cell
    \with F: \Pow A => Space.IsCompactIn source F \by {
      base: CompactImages.continuousImage Model.diskTopology source ((cell).characteristic) (((laws).cellLaws cell member).continuous)
        DiskSpace.Whole (Model.Compactness[].compact),
      equality: imageWhole
    };

\module Interior;
