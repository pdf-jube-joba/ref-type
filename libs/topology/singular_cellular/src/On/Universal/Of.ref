\structure Witness[x: A, value: B]: \Set := {
  cell: Cells.CellData,
  member: Cells.CellMember cells cell,
  point: Euclidean.Disk ((cell).dimension),
  image: (cell).characteristic point = x,
  result: family cell point = value,
};
\definition Values[x: A]: \Pow B := { value: B \where \exists Witness[x, value] };
\definition Value[x: A]: \Set := \Cast[B] (Values x);
\definition existence: \forall (x: A) -> \exists Value x := \block {
  \fun (x: A) \then
  \takefrom cover: Cells.CoverWitness[cells, x] \by (laws).covers x \then
  \takefrom point: \Cast[Euclidean.Disk (((cover).cell).dimension)]
    ({ p: Euclidean.Disk (((cover).cell).dimension) \where Logic.And[
      \In[Euclidean.coordinateCarrier (((cover).cell).dimension)] (Euclidean.interiorAt (((cover).cell).dimension)) p,
      ((cover).cell).characteristic p = x] }) \by (cover).contains \then
  \let same: ((cover).cell).characteristic point = x :=
    (\bysub(Euclidean.Disk (((cover).cell).dimension),
      { p: Euclidean.Disk (((cover).cell).dimension) \where Logic.And[
        \In[Euclidean.coordinateCarrier (((cover).cell).dimension)] (Euclidean.interiorAt (((cover).cell).dimension)) p,
        ((cover).cell).characteristic p = x] }, point)).right \then
  \return Logic.existsIntro[B, Values x] (family ((cover).cell) point)
    (\exact(Witness[x, family ((cover).cell) point] {
      cell := (cover).cell, member := (cover).member, point := point, image := same,
      result := \refl(family ((cover).cell) point),
    }, Witness[x, family ((cover).cell) point]))
};
\definition uniqueness: \forall (x: A)(left, right: Value x) -> left = right := \block {
  \fun (x: A)(left, right: Value x) \then
  \takefrom l: Witness[x, left] \by \bysub(B, Values x, left) \then
  \takefrom r: Witness[x, right] \by \bysub(B, Values x, right) \then
  \return trans!{B} _ _ _ (sym!{B} _ _ ((l).result))
    (trans!{B} _ _ _
      (compatible ((l).cell) ((r).cell) ((l).member) ((r).member) ((l).point) ((r).point)
        (trans!{A} _ _ _ ((l).image) (sym!{A} _ _ ((r).image)))) ((r).result))
};
\definition value[x: A]: B := \choice Value x \by { existence: existence x, uniqueness: uniqueness x };
\definition onCharacteristic: \forall (cell: Cells.CellData)(member: Cells.CellMember cells cell)(p: Euclidean.Disk ((cell).dimension)) ->
  value ((cell).characteristic p) = family cell p :=
  \fun (cell: Cells.CellData)(member: _)(p: _) => sym!{B} _ _
    (\choiceeq \into[B](family cell p, Values ((cell).characteristic p)) \by {
      \exact(Witness[(cell).characteristic p, family cell p] {
        cell := cell, member := member, point := p, image := \refl((cell).characteristic p), result := \refl(family cell p),
      }, Witness[(cell).characteristic p, family cell p])
    } \of Value ((cell).characteristic p) \by {
      existence: existence ((cell).characteristic p), uniqueness: uniqueness ((cell).characteristic p)
    });
\definition unique: \forall (f: A -> B) ->
  (\forall (cell: Cells.CellData)(member: Cells.CellMember cells cell)(p: Euclidean.Disk ((cell).dimension)) ->
    f ((cell).characteristic p) = family cell p) -> f = value := \block {
  \fun (f: A -> B)(local: _) \then
  \return \axiom:funext(f, value, \block {
    \fun (x: A) \then
    \takefrom w: Witness[x, value x] \by \bysub(B, Values x, \choice Value x \by { existence: existence x, uniqueness: uniqueness x }) \then
    \return trans!{B} _ _ _
      (congr!{A B} f _ _ (sym!{A} _ _ ((w).image)))
      (trans!{B} _ _ _ (local ((w).cell) ((w).member) ((w).point)) ((w).result))
  })
};
\import topology.Topology[Carrier := B] \as Target;
\import topology.Continuity[A := A, B := B] \as Maps;
\definition ContinuousFamily: \Prop := \forall (cell: Cells.CellData) -> Cells.CellMember cells cell ->
  topology.Continuity[A := Euclidean.Disk ((cell).dimension), B := B]
    .Continuous (Euclidean.Dimension[n := (cell).dimension].diskTopology) target (family cell);
\definition continuous: ContinuousFamily -> Maps.Continuous source target value :=
  \fun (allContinuous: ContinuousFamily)(U: \Pow B)(open: Target.IsOpenIn target U) =>
    ((laws).weakTopology (Maps.Preimage value U)).rtl
      (\fun (cell: Cells.CellData)(member: Cells.CellMember cells cell) =>
        \idelim { p: Euclidean.Disk ((cell).dimension) \where \In[B] U (family cell p) } = Cells.Pullback cell (Maps.Preimage value U)
          \with V: \Pow (Euclidean.Disk ((cell).dimension)) => Cells.DiskOpen ((cell).dimension) V \by {
            base: allContinuous cell member U open,
            equality: \axiom:setext({ p: Euclidean.Disk ((cell).dimension) \where \In[B] U (family cell p) }, Cells.Pullback cell (Maps.Preimage value U),
              \fun (p: _)(inside: _) => \idelim family cell p = value ((cell).characteristic p)
                \with b: B => \In[B] U b \by { base: inside, equality: sym!{B} _ _ (onCharacteristic cell member p) },
              \fun (p: _)(inside: _) => \idelim value ((cell).characteristic p) = family cell p
                \with b: B => \In[B] U b \by { base: inside, equality: onCharacteristic cell member p })
          });
