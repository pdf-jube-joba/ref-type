\import topology.Topology[Carrier := Upper.Carrier] \as UpperSpace;
\definition subset: \Pow Upper.Carrier := { x: Upper.Carrier \where \In[A] (\parent.\parent.Filtration[].subset n) x };
\import singular_cohomology.Relative[A := Upper.Carrier, source := Upper.topology, subset := subset] \as Pair;
\import UpperSpace.Subspace[S := subset] \as Nested;
\import Space.Subspace[S := \parent.\parent.Filtration[].subset n].Inside[U := \parent.\parent.Filtration[].subset (N.Nat^::succ n)] \as Nesting;
\definition included: Space.Subset (\parent.\parent.Filtration[].subset n) (\parent.\parent.Filtration[].subset (N.Nat^::succ n)) :=
  \parent.\parent.Filtration[].monotone n (N.Nat^::succ n) (Nat.leSelfSucc n);
\import \root.Algebra[].AbsoluteHomeomorphism[A := Lower.Carrier, B := Nested.CarrierSet,
  source := Lower.topology, target := Nested.topology Upper.topology,
  homeomorphism := Nesting.homeomorphism source included] \as Left;
\import singular_cohomology.Chains[A := Nested.CarrierSet, source := Nested.topology Upper.topology] \as NestedChains;
\import Nonnegative.ZeroExtension[C := NestedChains.complex] \as NestedExtension;
\import Complexes.End[C := UpperExtension.complex] \as Identity;
\definition right: Complexes.Isomorphism[C := UpperExtension.complex, D := UpperExtension.complex].Isomorphism :=
  Complexes.Isomorphism[C := UpperExtension.complex, D := UpperExtension.complex].Isomorphism {
    forward := Identity.identity, backward := Identity.identity,
    leftInverse := \fun (z: I.Int^)(x: UpperExtension.complex.family.Carrier z) => \refl(x),
    rightInverse := \fun (z: I.Int^)(x: UpperExtension.complex.family.Carrier z) => \refl(x),
  };
\import \root.Algebra[].QuotientIsomorphism[C := LowerExtension.complex, D := UpperExtension.complex,
  C1 := NestedExtension.complex, D1 := UpperExtension.complex,
  f := inclusion, g := Pair.inclusionMap, left := Left.isomorphism, right := right] \as Comparison;
\module Square;
\definition isomorphism: Complexes.Isomorphism[C := complex, D := Pair.complex].Isomorphism :=
  Comparison.isomorphism Square[].compatible;

\module Homology(z: I.Int^);

\module With(coefficients: Modules.Bundle);
