\import \root.Disks[] \as Disks;
\import Comparison.Cell[cell := cell] \as Local;
\definition zero: Logic.Not (n = k) -> \forall (q: Comparison.localGroups.Carrier cell) -> q = #zero{(Comparison.localGroups.space cell)} :=
  \fun (different: _) => Local.zero (Disks.offDiagonal (#dimension{cell}) k
    (\fun (same: #dimension{cell} = k) => different (trans!{N.Nat^} _ _ _ (sym!{N.Nat^} _ _ (Interiors.dimension cell)) same)));
