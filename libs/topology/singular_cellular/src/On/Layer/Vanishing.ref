\definition degree: I.Int^ := I.Int^::ofNat k;
\import \parent.Decomposition[z := degree] \as Comparison;
\import \parent.\parent.Filtration[].CellInteriors[n := n] \as Interiors;
\import Modules.DirectSum[Index := Interiors.Index, family := Comparison.localGroups].FiniteSupport[] \as Coordinates;
\import Modules.Product[Index := Interiors.Index, family := Comparison.localGroups] \as Product;
\module Cell(cell: Interiors.Index);
\definition sourceZero: Logic.Not (n = k) -> \forall (q: Comparison.Carrier) -> q = (Comparison.space).zero :=
  \fun (different: _)(q: Comparison.Carrier) => Coordinates.injective _ _
    (trans!{Product.Carrier} _ _ _
      (\axiom:funext(Coordinates.coordinates q, Product.zero, \fun (cell: Interiors.Index) => Cell[cell := cell].zero different (Coordinates.coordinates q cell)))
      (sym!{Product.Carrier} _ _ Coordinates.coordinatesZero));
\import Modules.Isomorphism[V := Comparison.Carrier, W := \parent.Homology[z := degree].Carrier,
  source := Comparison.space, target := \parent.Homology[z := degree].space].Vanishing[] \as Transport;
\definition zero: Logic.Not (n = k) -> \forall (q: \parent.Homology[z := degree].Carrier) -> q = (\parent.Homology[z := degree].space).zero :=
  \fun (different: _) => Transport.targetZero Comparison.isomorphism (sourceZero different);
