\import Complexes.ShortExact[A := LowerExtension.complex, B := UpperExtension.complex, C := complex]
  .Morphism[A1 := NestedExtension.complex, B1 := UpperExtension.complex, C1 := Pair.complex]
  .Diagram[s := sequence, t := Pair.sequence, a := Left.forwardMap, b := Identity.identity, c := #forward{isomorphism}] \as Diagram;
\definition diagram: Diagram.Commutative := Diagram.Commutative {
  left := \parent.Square[].compatible,
  right := \fun (z: I.Int^)(x: UpperExtension.complex.family.Carrier z) =>
    sym!{{Pair.Carrier z}} _ _ (Comparison.onProjection (\parent.Square[].compatible) z x),
};
\module At(z: I.Int^);
