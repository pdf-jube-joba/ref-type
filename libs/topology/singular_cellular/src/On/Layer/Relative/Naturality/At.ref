\definition connecting: _ := Diagram.At[k := z].naturality diagram;
\definition rawProjection: _ := Diagram.At[k := z].projectionNaturality diagram;
\import Complexes.At[C := UpperExtension.complex, z := z] \as WholeH;
\import Complexes.Map[C := UpperExtension.complex, D := Pair.complex].At[k := z] \as Projected;
\import \parent.\parent.\parent.Homology[z := z] \as LayerH;
\definition projection(q: WholeH.Homology): #apply{(Projected.induced Pair.sequence.projection)} q =
  #apply{#forward{\parent.\parent.Homology[z := z].isomorphism}} (#apply{LayerH.projection} q) :=
  trans!{{Pair.Homology[z := z].Carrier}} _ _ _
    (sym!{{Pair.Homology[z := z].Carrier}} _ _ (congr!{WholeH.Homology {Pair.Homology[z := z].Carrier}}
      (#apply{(Projected.induced Pair.sequence.projection)}) _ _ (Identity.At[k := z].identityOnHomology q)))
    (rawProjection q);
