\import singular_cohomology.Simplices[A := Lower.Carrier, source := Lower.topology] \as LowerSimplices;
\import singular_cohomology.Simplices[A := Upper.Carrier, source := Upper.topology] \as UpperSimplices;
\import algebraic_topology.Simplex[] \as Simplex;
\definition simplexInjective: \forall (sigma, tau: LowerSimplices.Carrier k) ->
  Inclusion.postcompose k Lower.Next[].inclusion Lower.Next[].continuous sigma =
    Inclusion.postcompose k Lower.Next[].inclusion Lower.Next[].continuous tau -> sigma = tau :=
  \fun (sigma, tau: LowerSimplices.Carrier k)(same: _) => \axiom:funext(sigma, tau,
    \fun (p: Simplex.Carrier k) => congr!{{UpperSimplices.Carrier k} A}
      (\fun (f: UpperSimplices.Carrier k) => f p) _ _ same);
\import Modules.Free[Generators := LowerSimplices.Carrier k].Reindex[TargetGenerators := UpperSimplices.Carrier k]
  .Injection[f := Inclusion.postcompose k Lower.Next[].inclusion Lower.Next[].continuous] \as Free;
\definition injective: \forall (x, y: LowerExtension.Carrier (I.Int^::ofNat k)) ->
  #apply{inclusion} (I.Int^::ofNat k) x = #apply{inclusion} (I.Int^::ofNat k) y -> x = y :=
  \fun (x, y: _)(same: _) => Free.injective simplexInjective x y same;
