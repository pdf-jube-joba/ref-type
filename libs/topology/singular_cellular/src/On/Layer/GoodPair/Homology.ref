\import \parent.\parent.Homology[z := z] \as Original;
\import \parent.\parent.Relative[].Homology[z := z] \as Relative;
\import Modules.Isomorphism[V := Original.Carrier, W := Pair.Homology[z := z].Carrier,
  source := Original.space, target := Pair.Homology[z := z].space]
  .Composition[U := Reduced.At[z := z].Carrier, final := Reduced.At[z := z].space] \as Compose;
\definition isomorphism: Modules.Isomorphism[V := Original.Carrier, W := Reduced.At[z := z].Carrier,
  source := Original.space, target := Reduced.At[z := z].space].Isomorphism :=
    Compose.compose Comparison.Homology[z := z].isomorphism Relative.isomorphism;
