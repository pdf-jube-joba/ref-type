\module Positive(k: N.Nat^);
\module Negative(k: N.Nat^);
\definition Retraction(z: I.Int^): \Set := Modules.Hom[V := UpperExtension.Carrier z, W := LowerExtension.Carrier z,
  source := UpperExtension.space z, target := LowerExtension.space z].Map;
\definition map: \forall (z: I.Int^) -> Retraction z := \induction (z: I.Int^) \return Retraction z \with {
  | ofNat: \fun (k: N.Nat^) => Positive[k := k].map
  | negSucc: \fun (k: N.Nat^) => Negative[k := k].map
};
\definition retracts: \forall (z: I.Int^)(x: LowerExtension.Carrier z) -> #apply{(map z)} (#apply{inclusion} z x) = x :=
  \induction (z: I.Int^) \return \forall (x: LowerExtension.Carrier z) -> #apply{(map z)} (#apply{inclusion} z x) = x \with {
    | ofNat: \fun (k: N.Nat^) => Positive[k := k].retracts
    | negSucc: \fun (k: N.Nat^) => Negative[k := k].retracts
  };
