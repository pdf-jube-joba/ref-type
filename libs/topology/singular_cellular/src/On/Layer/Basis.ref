\definition degree: I.Int^ := I.Int^::ofNat n;
\import \parent.\parent.Filtration[].CellInteriors[n := n] \as Interiors;
\import Interiors.Charts[] \as Charts;
\import Charts.Pair[] \as ChartPair;
\import \root.Coproduct[Index := Interiors.Index, fibers := Charts.fiber, spaces := Charts.fiberTopology] \as Disks;
\import Disks.Relative[subset := ChartPair.punctures] \as RelativeDisks;
\import RelativeDisks.Homology[z := degree] \as Additivity;
\definition scalars: Modules.Family[Interiors.Index] := Modules.Family[Interiors.Index] {
  Carrier := \fun (_: Interiors.Index) => I.Int^,
  space := \fun (_: Interiors.Index) => Modules.scalarModule,
};
\definition localGroups: Modules.Family[Interiors.Index] := Additivity.family;
\module Cell(cell: Interiors.Index);
\definition orientations: \forall (cell: Interiors.Index) -> Modules.Isomorphism[V := I.Int^, W := localGroups.Carrier cell,
  source := Modules.scalarModule, target := localGroups.space cell].Isomorphism := \fun (cell: Interiors.Index) => Cell[cell := cell].orientation;
\import singular_cellular_algebra.Algebra[].SumIsomorphism[Index := Interiors.Index, sourceFamily := scalars, targetFamily := localGroups, isomorphisms := orientations] \as CellBasis;
\import Modules.DirectSum[Index := Interiors.Index, family := scalars] \as Free;
\definition Carrier: \Set := Free.Carrier;
\definition space: Modules.Space Carrier := Free.space;
\import \parent.Decomposition[z := degree] \as Comparison;
\import Modules.DirectSum[Index := Interiors.Index, family := localGroups] \as LocalSum;
\import Modules.Isomorphism[V := Carrier, W := LocalSum.Carrier, source := space, target := LocalSum.space]
  .Composition[U := \parent.Homology[z := degree].Carrier, final := \parent.Homology[z := degree].space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Carrier, W := \parent.Homology[z := degree].Carrier,
  source := space, target := \parent.Homology[z := degree].space].Isomorphism := Composition.compose Comparison.isomorphism CellBasis.isomorphism;
\definition generator(cell: Interiors.Index): \parent.Homology[z := degree].Carrier := #apply{#forward{isomorphism}} (#apply{Free.Injection[i := cell].map} I.One.specification);
