\import \parent.\parent.Filtration[].Punctures[n := n].GoodPair[point := point] \as Geometry;
\definition subset: \Pow Upper.Carrier := { x: Upper.Carrier \where Space.Member (\parent.\parent.Filtration[].subset n) x };
\import singular_cohomology.Relative[A := Upper.Carrier, source := Upper.topology, subset := subset] \as Pair;
\import singular_excision.GoodPair[A := Upper.Carrier, source := Upper.topology, subset := subset].On[pair := Geometry.pair] \as Comparison;
\import algebraic_topology.Collapse[A := Upper.Carrier, subset := subset] \as Quotient;
\import singular_cohomology.Chains[A := Quotient.Carrier, source := Quotient.topology Upper.topology].Reduced[] \as Reduced;

