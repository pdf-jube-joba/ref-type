\definition dimension: N.Nat^ := (cell).dimension;
\import \root.Disks[].At[n := dimension] \as Disk;
\import \root.DiskLocal[n := dimension] \as Local;
\import Modules.Isomorphism[V := Disk.Homology[z := degree].Carrier, W := localGroups.Carrier cell,
  source := Disk.Homology[z := degree].space, target := localGroups.space cell].Vanishing[] \as Transport;
\definition zero: (\forall (q: Disk.Homology[z := degree].Carrier) -> q = (Disk.Homology[z := degree].space).zero) ->
  \forall (q: localGroups.Carrier cell) -> q = (localGroups.space cell).zero := Transport.targetZero (Local.Homology[z := degree].isomorphism);
