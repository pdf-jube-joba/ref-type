\definition degree: I.Int^ := I.Int^::ofNat k;
\import \parent.\parent.Layer[n := limit].Homology[z := degree] \as Relative;
\import \parent.\parent.Layer[n := limit].Vanishing[k := k] \as Layer;
\import \parent.\parent.Layer[n := limit] \as Pair;
\import \parent.\parent.Filtration[].Stage[limit := limit] \as Lower;
\import \parent.\parent.Filtration[].Stage[limit := N.Nat^::succ limit] \as Upper;
\import singular_cohomology.Chains[A := Lower.Carrier, source := Lower.topology] \as LowerChains;
\import singular_cohomology.Chains[A := Upper.Carrier, source := Upper.topology] \as UpperChains;
\import Nonnegative.ZeroExtension[C := LowerChains.complex] \as LowerExtension;
\import Nonnegative.ZeroExtension[C := UpperChains.complex] \as UpperExtension;
\import Complexes.Map[C := LowerExtension.complex, D := UpperExtension.complex].At[k := degree] \as Inclusion;
\import Modules.Hom[V := homology limit degree, W := homology (N.Nat^::succ limit) degree,
  source := space limit degree, target := space (N.Nat^::succ limit) degree] \as Maps;
\definition zero: Vanishing limit k -> Nat.Le (N.Nat^::succ limit) k -> Vanishing (N.Nat^::succ limit) k := \block {
  \fun (previous: Vanishing limit k)(bound: Nat.Le (N.Nat^::succ limit) k)(q: homology (N.Nat^::succ limit) degree) \then
  \let killed: #apply{Relative.projection} q = #zero{Relative.space} :=
    Layer.zero (Nat.ltNe limit k (Nat.ltOfSuccLe k limit bound)) (#apply{Relative.projection} q) \then
  \takefrom p: \Cast[homology limit degree] ({ p: homology limit degree \where #apply{(Inclusion.induced Pair.inclusion)} p = q })
    \by Relative.exactAtSpace q killed \then
  \return trans!{{homology (N.Nat^::succ limit) degree}} _ _ _
    (sym!{{homology (N.Nat^::succ limit) degree}} _ _ (\bysub(homology limit degree, { p: homology limit degree \where #apply{(Inclusion.induced Pair.inclusion)} p = q }, p)))
    (trans!{{homology (N.Nat^::succ limit) degree}} _ _ _
      (congr!{homology limit degree {homology (N.Nat^::succ limit) degree}} (#apply{(Inclusion.induced Pair.inclusion)}) _ _ (previous p))
      (Maps.zeroPreserved (Inclusion.induced Pair.inclusion)))
};
