\import Complexes.At[C := Cellular.integerComplex, z := I.Int^::ofNat N.Nat^::zero] \as ZeroCell;
\definition projectedClosed: \forall (q: homology (N.Nat^::succ N.Nat^::zero) (I.Int^::ofNat N.Nat^::zero)) ->
  #apply{Cellular.integerComplex.differential} (I.Int^::ofNat N.Nat^::zero)
    (CellExtension.Positive[n := N.Nat^::zero].intro (#apply{Pair.projection} q)) = #zero{(CellExtension.space (I.Int^::negSucc N.Nat^::zero))} :=
  \fun (q: _) => \refl(#zero{(CellExtension.space (I.Int^::negSucc N.Nat^::zero))});
