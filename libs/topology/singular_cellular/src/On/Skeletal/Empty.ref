\import \parent.\parent.Filtration[].Stage[limit := N.Nat^::zero] \as Stage;
\definition empty: \forall (x: Stage.Carrier) -> Logic.False :=
  \fun (x: Stage.Carrier) => \idelim \parent.\parent.Filtration[].subset N.Nat^::zero = Space.Empty
    \with S: \Pow A => \In[A] S x \by {
      base: \bysub(A, \parent.\parent.Filtration[].subset N.Nat^::zero, x), equality: \parent.\parent.Filtration[].empty };
\import singular_cohomology.Calculations[A := Stage.Carrier, source := Stage.topology].ChainEmpty[] \as Calculation;
\definition zero: \forall (z: I.Int^)(q: homology N.Nat^::zero z) -> q = (space N.Nat^::zero z).zero :=
  \fun (z: I.Int^) => Calculation.Homology[z := z].zero empty;
