\import \parent.\parent.Filtration[].Stage[limit := limit] \as Stage;
\import singular_cohomology.Chains[A := Stage.Carrier, source := Stage.topology] \as Chains;
\import Nonnegative.ZeroExtension[C := Chains.complex] \as Extension;
\import Complexes.At[C := Extension.complex, z := z] \as Native;
\definition Carrier: \Set := Native.Homology;
\definition space: Modules.Space Carrier := Native.homologySpace;
