\definition degree: I.Int^ := I.Int^::ofNat n;
\import \parent.\parent.Cellular[] \as Cellular;
\import \parent.\parent.Layer[n := n] \as Layer;
\import \parent.\parent.Filtration[].Stage[limit := N.Nat^::succ n] \as Upper;
\import singular_cohomology.Chains[A := Upper.Carrier, source := Upper.topology] \as UpperChains;
\import Nonnegative.ZeroExtension[C := UpperChains.complex] \as UpperExtension;
\import Nonnegative.ZeroExtension[C := Cellular.complex] \as CellExtension;
\import Complexes.At[C := UpperExtension.complex, z := degree] \as Whole;
\import Complexes.At[C := Cellular.integerComplex, z := degree] \as Cell;
\import Layer.Homology[z := degree] \as Relative;
\module Zero;
\module Positive(k: N.Nat^);
\definition projectedClosed: \forall (n: N.Nat^)(q: homology (N.Nat^::succ n) (I.Int^::ofNat n)) ->
  #apply{Cellular.integerComplex.differential} (I.Int^::ofNat n)
    (CellExtension.Positive[n := n].intro (#apply{(\parent.\parent.Layer[n := n].Homology[z := I.Int^::ofNat n].projection)} q)) =
      #zero{(CellExtension.space (Degrees.previous (I.Int^::ofNat n)))} :=
  \induction (n: N.Nat^) \return \forall (q: homology (N.Nat^::succ n) (I.Int^::ofNat n)) ->
    #apply{Cellular.integerComplex.differential} (I.Int^::ofNat n)
      (CellExtension.Positive[n := n].intro (#apply{(\parent.\parent.Layer[n := n].Homology[z := I.Int^::ofNat n].projection)} q)) =
        #zero{(CellExtension.space (Degrees.previous (I.Int^::ofNat n)))} \with {
    | zero: Zero[].projectedClosed
    | succ: \fun (k: N.Nat^)(unused: _) => Positive[k := k].projectedClosed
  };
\definition connectingZero: \forall (n: N.Nat^)(q: Complexes.At[C := Cellular.integerComplex, z := I.Int^::ofNat n].Cycle) ->
  #apply{(\parent.\parent.Layer[n := n].Homology[z := I.Int^::ofNat n].connecting)} q =
    #zero{(\parent.At[limit := n, z := Degrees.previous (I.Int^::ofNat n)].space)} :=
  \induction (n: N.Nat^) \return \forall (q: Complexes.At[C := Cellular.integerComplex, z := I.Int^::ofNat n].Cycle) ->
    #apply{(\parent.\parent.Layer[n := n].Homology[z := I.Int^::ofNat n].connecting)} q =
      #zero{(\parent.At[limit := n, z := Degrees.previous (I.Int^::ofNat n)].space)} \with {
    | zero: Zero[].connectingZero
    | succ: \fun (k: N.Nat^)(unused: _) => Positive[k := k].connectingZero
  };
\import Modules.Hom[V := Whole.Homology, W := Cell.Cycle, source := Whole.homologySpace, target := Cell.cycleSpace] \as Maps;
\definition map: Maps.Map := Maps.Map {
  apply := \fun (q: Whole.Homology) => Cell.cycle (CellExtension.Positive[n := n].intro (#apply{Relative.projection} q)) (projectedClosed n q),
  addition := #addition{Relative.projection}, scalar := #scalar{Relative.projection},
};
\definition injective: \forall (q, r: Whole.Homology) -> #apply{map} q = #apply{map} r -> q = r :=
  \fun (q, r: Whole.Homology)(same: _) => \parent.Top[n := n].projectionInjective q r same;
\definition onto: \forall (q: Cell.Cycle) -> \exists { p: Whole.Homology \where #apply{map} p = q } :=
  \fun (q: Cell.Cycle) => Relative.exactAtRelative q (connectingZero n q);
\import Modules.Isomorphism[V := Whole.Homology, W := Cell.Cycle, source := Whole.homologySpace, target := Cell.cycleSpace].OfBijective[f := map] \as Inverse;
\definition isomorphism: Modules.Isomorphism[V := Whole.Homology, W := Cell.Cycle, source := Whole.homologySpace, target := Cell.cycleSpace].Isomorphism :=
  Inverse.isomorphism injective onto;
