\import \parent.\parent.Reach[extra := N.Nat^::zero] \as Base;
\import singular_cohomology.Identity[A := Initial.Carrier, source := Initial.topology] \as Identity;
\import Modules.Hom[V := InitialHomology.Homology, W := InitialHomology.Homology,
  source := InitialHomology.homologySpace, target := InitialHomology.homologySpace] \as Linear;
\definition linearIdentity: Linear.Map := Linear.Map {
  apply := \fun (q: InitialHomology.Homology) => q,
  addition := \fun (q, r: InitialHomology.Homology) => \refl(#add{InitialHomology.homologySpace} q r),
  scalar := \fun (a: I.Int^)(q: InitialHomology.Homology) => \refl(#smul{InitialHomology.homologySpace} a q),
};
\definition isomorphism: Base.Isomorphism := Modules.Isomorphism[V := InitialHomology.Homology, W := InitialHomology.Homology,
  source := InitialHomology.homologySpace, target := InitialHomology.homologySpace].Isomorphism {
  forward := linearIdentity, backward := linearIdentity,
  leftInverse := \fun (q: InitialHomology.Homology) => \refl(q),
  rightInverse := \fun (q: InitialHomology.Homology) => \refl(q),
};
\definition equation: \forall (q: InitialHomology.Homology) -> #apply{#forward{isomorphism}} q = #apply{Base.map} q :=
  \fun (q: InitialHomology.Homology) => sym!{InitialHomology.Homology} _ _ (Identity.Integer[].Homology[z := degree].onHomology q);
