\import \parent.On[x := x, w := w].Top[dimension := wd] \as First;
\import \parent.On[x := x, w := v].Top[dimension := vd] \as Second;
\import \parent.\parent.Cell[cell := #cell{w}, member := #member{w}, dimension := wd] \as FirstCell;
\import \parent.\parent.Cell[cell := #cell{v}, member := #member{v}, dimension := vd] \as SecondCell;
\import R.Order[] \as Order;
\definition secondInterior: R.Lt (Euclidean.normSquaredAt (#dimension{(#cell{w})}) (#point{w})) Real.one ->
  R.Lt (Euclidean.normSquaredAt (#dimension{(#cell{v})}) (#point{v})) Real.one :=
  \fun (inside: _) => Order.ltOfLeNotEq _ Real.one
    (\bysub(Euclidean.coordinateCarrier (#dimension{(#cell{v})}), Euclidean.closedBallAt (#dimension{(#cell{v})}), #point{v}))
    (\fun (boundary: _) => Order.ltNotEq _ Real.one inside
      (\parent.\parent.\parent.Interiors[].topBoundary n (#cell{w}) (#member{w}) wd (#point{w})
        (\idelim x = #characteristic{(#cell{w})} (#point{w}) \with a: A => Space.Member (subset n) a \by {
          base: \idelim #characteristic{(#cell{v})} (#point{v}) = x \with a: A => Space.Member (subset n) a \by {
            base: SecondCell.boundaryLower (#point{v}) boundary, equality: #image{v}
          }, equality: sym!{A} _ _ (#image{w})
        })));
\definition law: \forall (t: Interval.Carrier) -> First.value t = Second.value t :=
  \fun (t: Interval.Carrier) => either!{{(Classical.excludedMiddle (R.Lt (Euclidean.normSquaredAt (#dimension{(#cell{w})}) (#point{w})) Real.one))}
    {First.value t = Second.value t}
    {\block {
      \fun (inside: _) \then
      \let vi: R.Lt (Euclidean.normSquaredAt (#dimension{(#cell{v})}) (#point{v})) Real.one := secondInterior inside \then
      \let imageSame: #characteristic{(#cell{w})} (#point{w}) = #characteristic{(#cell{v})} (#point{v}) :=
        trans!{A} _ _ _ (#image{w}) (sym!{A} _ _ (#image{v})) \then
      \let cellsEqual: #cell{w} = #cell{v} := #disjoint{laws} (#cell{w}) (#cell{v}) (#member{w}) (#member{v}) x
        (\idelim #characteristic{(#cell{w})} (#point{w}) = x \with a: A => Space.Member (Cells.InteriorImage (#cell{w})) a \by {
          base: FirstCell.containsInterior (#point{w}) inside, equality: #image{w}
        })
        (\idelim #characteristic{(#cell{v})} (#point{v}) = x \with a: A => Space.Member (Cells.InteriorImage (#cell{v})) a \by {
          base: SecondCell.containsInterior (#point{v}) vi, equality: #image{v}
        }) \then
      \return topRespects (#cell{w}) (#cell{v}) (#member{w}) (#member{v}) wd vd cellsEqual t First.input Second.input inside vi imageSame
    }}
    {\block {
      \fun (outside: _) \then
      \let boundary: Euclidean.normSquaredAt (#dimension{(#cell{w})}) (#point{w}) = Real.one :=
        R.leAntisym _ _ (\bysub(Euclidean.coordinateCarrier (#dimension{(#cell{w})}), Euclidean.closedBallAt (#dimension{(#cell{w})}), #point{w}))
          (Order.leOfNotLtReverse Real.one (Euclidean.normSquaredAt (#dimension{(#cell{w})}) (#point{w})) outside) \then
      \let lower: Space.Member (subset n) x := \idelim #characteristic{(#cell{w})} (#point{w}) = x
        \with a: A => Space.Member (subset n) a \by { base: FirstCell.boundaryLower (#point{w}) boundary, equality: #image{w} } \then
      \return trans!{Carrier} _ _ _ (First.fixesLower lower t) (sym!{Carrier} _ _ (Second.fixesLower lower t))
    }}
  };
