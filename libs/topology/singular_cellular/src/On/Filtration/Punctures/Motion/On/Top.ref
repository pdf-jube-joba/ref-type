\import \parent.\parent.\parent.Cell[cell := cell, member := member, dimension := dimension] \as Cell;
\import \root.DiskCollar[n := (cell).dimension] \as Collar;
\definition inside: UpperSpace.Member region (Cell.image point) :=
  \idelim x = Cell.image point \with p: Upper.Carrier => UpperSpace.Member region p \by {
    base: \bysub(Upper.Carrier, region, x), equality: sym!{A} _ _ ((w).image)
  };
\definition input: Collar.Carrier := \into[Euclidean.Disk ((cell).dimension)](point, Collar.punctured) \by { Cell.nonzero point inside };
\definition value[t: Interval.Carrier]: Carrier := Cell.motion t input;
\definition atStart: value Interval.start = x := trans!{Upper.Carrier} _ _ _ (Cell.starts input) ((w).image);
\definition endLower: Space.Member (subset n) (value Interval.end) := Cell.endpointLower input;
\definition fixesLower: Space.Member (subset n) x -> \forall (t: Interval.Carrier) -> value t = x :=
  \fun (lower: _)(t: Interval.Carrier) => trans!{Upper.Carrier} _ _ _
    (Cell.fixesBoundary t input (\parent.\parent.\parent.\parent.Interiors[].topBoundary n cell member dimension point
      (\idelim x = (cell).characteristic point \with a: A => Space.Member (subset n) a \by {
        base: lower, equality: sym!{A} _ _ ((w).image)
      }))) ((w).image);
