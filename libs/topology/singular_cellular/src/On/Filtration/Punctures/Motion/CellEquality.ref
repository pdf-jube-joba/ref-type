\import \root.DiskCollar[n := #dimension{cell}] \as Collar;
\import \parent.\parent.Cell[cell := cell, member := member, dimension := dimension] \as Cell;
\import Algebra.Refinement[A := Euclidean.Disk (#dimension{cell}), S := Collar.punctured] \as Refined;
\definition Point: \Set := Collar.Carrier;
\definition law(t: Interval.Carrier)(p, q: Point)
  (leftInterior: R.Lt (Euclidean.normSquaredAt (#dimension{cell}) p) Real.one)
  (rightInterior: R.Lt (Euclidean.normSquaredAt (#dimension{cell}) q) Real.one)
  (images: #characteristic{cell} p = #characteristic{cell} q): Cell.motion t p = Cell.motion t q :=
  congr!{Point Carrier} (Cell.motion t) p q
    (Refined.ext p q (#injectiveInterior{(#cellLaws{laws} cell member)} p q leftInterior rightInterior images));
