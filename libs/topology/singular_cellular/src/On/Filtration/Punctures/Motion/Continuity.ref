\import Upper.Charts[] \as Charts;
\import \root.Coproduct[Index := Charts.Index,
  fibers := (\fun (cell: Charts.Index) => Euclidean.Disk (#dimension{cell})),
  spaces := (\fun (cell: Charts.Index) => Euclidean.Dimension[n := #dimension{cell}].diskTopology)] \as Disks;
\import topology.Continuity[A := Disks.Carrier, B := Upper.Carrier] \as Maps;
\import Disks.Restricted[S := Maps.Preimage Charts.map region] \as Cut;
\import Charts.Restriction[U := region, open := regionOpen].To[B := Carrier, target := topology] \as Gluing;
\definition point(cell: Charts.Index)(p: Cut.Fiber cell): Carrier :=
  \into[Upper.Carrier](Charts.map (Disks.injection cell p), region) \by {
    \bysub(Euclidean.Disk (#dimension{cell}), Cut.fiberSubset cell, p)
  };
\definition representation(cell: Charts.Index)(p: Cut.Fiber cell): Representation[point cell p] :=
  Representation[point cell p] {
    cell := cell, member := Charts.member cell, below := Charts.below cell, point := p, image := \refl(point cell p),
  };
\module AtCell(cell: Charts.Index);
\definition continuous: topology.Continuity[A := Cylinder.Carrier, B := Carrier].Continuous (Cylinder.topology topology) topology family :=
  Gluing.continuous family (\fun (cell: Charts.Index) => AtCell[cell := cell].continuous);
