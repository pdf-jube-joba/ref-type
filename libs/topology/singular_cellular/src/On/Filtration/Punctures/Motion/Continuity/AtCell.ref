\import Euclidean.Dimension[n := #dimension{cell}] \as Model;
\import algebraic_topology.Cylinder[A := Cut.Fiber cell] \as Domain;
\import topology.Topology[Carrier := Model.Disk].Subspace[S := Cut.fiberSubset cell] \as Fiber;
\definition source: topology.Topology[Carrier := Domain.Carrier].Topology := Domain.topology (Cut.fiberTopology cell);
\definition branch(p: Domain.Carrier): Carrier := family (Cylinder.at (Domain.time p) (point cell (Domain.point p)));
\import topology.Continuity[A := Cut.Fiber cell, B := Model.Disk].Corestriction[S := Cut.fiberSubset cell] \as Inclusion;
\definition diskContinuous: topology.Continuity[A := Cut.Fiber cell, B := Model.Disk].Continuous (Cut.fiberTopology cell) Model.diskTopology
  (\fun (p: Cut.Fiber cell) => p) := Inclusion.inclusionContinuous Model.diskTopology;
\definition chart(p: Model.Disk): Upper.Carrier := Upper.Open[].lift cell (Charts.member cell) (Charts.below cell) p;
\definition chartContinuous: topology.Continuity[A := Model.Disk, B := Upper.Carrier].Continuous Model.diskTopology Upper.topology chart :=
  Upper.Open[].liftContinuous cell (Charts.member cell) (Charts.below cell);
\import topology.Composition[A := Cut.Fiber cell, B := Model.Disk, C := Upper.Carrier] \as ChartComposition;
\import topology.Continuity[A := Cut.Fiber cell, B := Upper.Carrier].Corestriction[S := region] \as IntoRegion;
\definition pointContinuous: topology.Continuity[A := Cut.Fiber cell, B := Carrier].Continuous (Cut.fiberTopology cell) topology (point cell) :=
  IntoRegion.corestrictContinuous (Cut.fiberTopology cell) Upper.topology (point cell)
    (ChartComposition.composeContinuous (Cut.fiberTopology cell) Model.diskTopology Upper.topology
      (\fun (p: Cut.Fiber cell) => p) chart diskContinuous chartContinuous);
\module Top(dimension: #dimension{cell} = n);
\definition lowerContinuous: Nat.Lt (#dimension{cell}) n -> topology.Continuity[A := Domain.Carrier, B := Carrier].Continuous source topology branch :=
  \fun (below: _) => \idelim (\fun (p: Domain.Carrier) => point cell (Domain.point p)) = branch
    \with f: (Domain.Carrier -> Carrier) => topology.Continuity[A := Domain.Carrier, B := Carrier].Continuous source topology f \by {
      base: topology.Composition[A := Domain.Carrier, B := Cut.Fiber cell, C := Carrier]
        .composeContinuous source (Cut.fiberTopology cell) topology Domain.point (point cell) (Domain.pointContinuous (Cut.fiberTopology cell)) pointContinuous,
      equality: \axiom:funext((\fun (p: Domain.Carrier) => point cell (Domain.point p)), branch,
        \fun (p: Domain.Carrier) => sym!{Carrier} _ _
          (onLower (Domain.time p) (point cell (Domain.point p)) (representation cell (Domain.point p)) below))
    };
\definition continuous: topology.Continuity[A := Domain.Carrier, B := Carrier].Continuous source topology branch :=
  either!{{(Classical.excludedMiddle (#dimension{cell} = n))}
    {topology.Continuity[A := Domain.Carrier, B := Carrier].Continuous source topology branch}
    {\fun (dimension: _) => Top[dimension := dimension].continuous}
    {\fun (different: _) => lowerContinuous (Nat.ltOfLeDifferent (#dimension{cell}) n
      (Nat.leOfSuccSucc (#dimension{cell}) n (Nat.succLeOfLt (N.Nat^::succ n) (#dimension{cell}) (Charts.below cell))) different)}
  };
