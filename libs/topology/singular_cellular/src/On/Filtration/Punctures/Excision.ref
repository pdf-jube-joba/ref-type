\definition lower: \Pow Upper.Carrier := { x: Upper.Carrier \where Space.Member (subset n) x };
\import UpperSpace.Subspace[S := lower] \as LowerSubspace;
\import UpperSpace.Subspace[S := region] \as Neighborhood;
\definition collapsedPart: \Pow Neighborhood.CarrierSet := { x: Neighborhood.CarrierSet \where UpperSpace.Member lower x };
\import topology.Topology[Carrier := Neighborhood.CarrierSet].Subspace[S := collapsedPart] \as LocalSubspace;
\import LowerSubspace.Inside[U := region] \as Nesting;
\import algebraic_topology.DeformationRetract[A := Neighborhood.CarrierSet, source := Neighborhood.topology Upper.topology, subset := collapsedPart]
  .On[retract := \parent.Deformation[].deformation] \as Retraction;
\import algebraic_topology.HomotopyEquivalence[A := LowerSubspace.CarrierSet, B := LocalSubspace.CarrierSet] \as Refinement;
\import Refinement.Composition[C := Neighborhood.CarrierSet] \as Composition;
\definition equivalence: algebraic_topology.HomotopyEquivalence[A := LowerSubspace.CarrierSet, B := Neighborhood.CarrierSet]
  .Equivalence[LowerSubspace.topology Upper.topology, Neighborhood.topology Upper.topology] :=
  Composition.compose (LowerSubspace.topology Upper.topology) (LocalSubspace.topology (Neighborhood.topology Upper.topology)) (Neighborhood.topology Upper.topology)
    (Refinement.fromHomeomorphism (LowerSubspace.topology Upper.topology) (LocalSubspace.topology (Neighborhood.topology Upper.topology))
      (Nesting.homeomorphism Upper.topology lowerIncluded)) Retraction.equivalence;
\import singular_cohomology.Relative[A := Upper.Carrier, source := Upper.topology, subset := lower] \as Original;
\import singular_cohomology.Relative[A := Upper.Carrier, source := Upper.topology, subset := region] \as Expanded;
\import Original.Maps[B := Upper.Carrier].Over[target := Upper.topology, targetSubset := region] \as Maps;
\import topology.Maps[A := Upper.Carrier, B := Upper.Carrier].Identity[] \as Identity;
\definition map: Maps.Map := \into[Upper.Carrier -> Upper.Carrier]((\fun (x: Upper.Carrier) => x), Maps.Map) \by {
  Maps.Laws[(\fun (x: Upper.Carrier) => x)] {
    continuous := Identity.continuous Upper.topology,
    contained := \fun (x: LowerSubspace.CarrierSet) => lowerIncluded x (\bysub(Upper.Carrier, lower, x)),
  }
};
\import Maps.On[f := map].Integer[] \as Action;
\import singular_cohomology.Equivalence[A := LowerSubspace.CarrierSet, B := Neighborhood.CarrierSet,
  source := LowerSubspace.topology Upper.topology, target := Neighborhood.topology Upper.topology].Signed[] \as SubspaceComparison;
\import singular_cohomology.Identity[A := Upper.Carrier, source := Upper.topology].Integer[] \as WholeComparison;
\definition subspaceQuasi: Action.Comparison[].SubspaceQuasi := \fun (z: I.Int^) => SubspaceComparison.Homology[z := z].bijective equivalence;
\definition wholeQuasi: Action.Comparison[].WholeQuasi := \fun (z: I.Int^) => WholeComparison.Homology[z := z].bijective;
\import singular_excision.Excision[A := Upper.Carrier].Over[source := Upper.topology] \as Excision;
\import UpperSpace.Closure[] \as Closure;
\import UpperSpace.Interior[] \as Interior;
\definition lowerClosed: UpperSpace.IsClosedIn Upper.topology lower :=
  Space.Subspace[S := subset (N.Nat^::succ n)].traceOpen source (Space.Complement (subset n)) (\parent.\parent.Closed[].closed n);
\definition pair: Excision.Pair := \into[Excision.PairData](Excision.PairData { subset := region, removed := lower }, Excision.Pair) \by {
  \fun (x: Upper.Carrier)(member: UpperSpace.Member (Closure.closure Upper.topology lower) x) =>
    Interior.greatest Upper.topology region region regionOpen (\fun (x: Upper.Carrier)(inside: UpperSpace.Member region x) => inside) x
      (lowerIncluded x (Closure.least Upper.topology lower lower lowerClosed
        (\fun (x: Upper.Carrier)(inside: UpperSpace.Member lower x) => inside) x member))
};
\import UpperSpace.Subspace[S := UpperSpace.Complement lower] \as Remaining;
\definition remaining: \Set := Remaining.CarrierSet;
\definition remainingTopology: topology.Topology[Carrier := remaining].Topology := Remaining.topology Upper.topology;
\definition punctures: \Pow remaining := { x: remaining \where UpperSpace.Member region x };
\import singular_cohomology.Relative[A := remaining, source := remainingTopology, subset := punctures] \as Excised;
\module Homology(z: I.Int^);
\module With(coefficients: Modules.Bundle);
