\import Action.With[coefficients := coefficients] \as Pull;
\definition subspaceQuasi: Pull.Comparison[].SubspaceQuasi := \fun (z: I.Int^) => SubspaceComparison.With[coefficients := coefficients].At[z := z].bijective equivalence;
\definition wholeQuasi: Pull.Comparison[].WholeQuasi := \fun (z: I.Int^) => WholeComparison.With[coefficients := coefficients].At[z := z].bijective;
\module At(z: I.Int^);
