\definition lower: \Pow Upper.Carrier := { x: Upper.Carrier \where Space.Member (subset n) x };
\import algebraic_topology.Collapse[A := Upper.Carrier, subset := lower].Open[source := Upper.topology] \as Neighborhoods;
\definition neighborhood: Neighborhoods.Neighborhood := Neighborhoods.Neighborhood {
  region := region,
  open := regionOpen,
  contains := lowerIncluded,
};
\definition closed: UpperSpace.IsClosedIn Upper.topology lower :=
  Space.Subspace[S := subset (N.Nat^::succ n)].traceOpen source (Space.Complement (subset n)) (\parent.\parent.Closed[].closed n);
\import algebraic_topology.NeighborhoodRetract[A := Upper.Carrier, source := Upper.topology, subset := lower] \as Geometry;
\definition pair: Geometry.Data := Geometry.Data {
  point := \into[Upper.Carrier](Lower.Next[].inclusion point, lower) \by { \bysub(A, subset n, point) },
  closed := closed,
  neighborhood := neighborhood,
  deformation := \parent.Deformation[].deformation,
};
