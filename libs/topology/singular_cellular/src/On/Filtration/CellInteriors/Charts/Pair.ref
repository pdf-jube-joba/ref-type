\import \parent.\parent.\parent.Punctures[n := n] \as Punctures;
\import Punctures.Excision[] \as Skeletal;
\definition punctures: \Pow Carrier := { chart: Carrier \where
  Logic.Not (Euclidean.Dimension[n := #dimension{(#index{chart})}].normSquared (#point{chart}) = Real.zero) };
\import singular_cohomology.Relative[A := Carrier, source := topology, subset := punctures] \as Source;
\import singular_cohomology.Relative[A := Target.Carrier, source := Target.topology, subset := Skeletal.punctures] \as TargetPair;
\import Source.Homeomorphism[B := Target.Carrier].Over[target := Target.topology, targetSubset := Skeletal.punctures] \as Homeomorphisms;
\definition upper(x: Target.Carrier): Upper.Carrier := x;
\definition forwardPreserves: \forall (chart: Source.SubspaceCarrier) ->
  \In[Target.Carrier] Skeletal.punctures (map chart) :=
  \fun (chart: Source.SubspaceCarrier) => Punctures.Cell[cell := #index{chart}, member := member (#index{chart}), dimension := dimension (#index{chart})]
    .insideRegion (#point{chart}) (\bysub(Carrier, punctures, chart));
\definition backwardPreserves: \forall (x: TargetPair.SubspaceCarrier) ->
  \In[Carrier] punctures (backward x) := \block {
  \fun (x: TargetPair.SubspaceCarrier) \then
  \let chart: Carrier := backward x \then
  \let inRegion: \In[Upper.Carrier] Punctures.region (map chart) :=
    \idelim x = map chart \with p: Upper.Carrier => \In[Upper.Carrier] Punctures.region p \by {
      base: \bysub(Target.Carrier, Skeletal.punctures, x),
      equality: congr!{Target.Carrier Upper.Carrier} upper _ _ (sym!{Target.Carrier} _ _ (Inverse.rightInverse injective onto x)) } \then
  \return Punctures.Cell[cell := #index{chart}, member := member (#index{chart}), dimension := dimension (#index{chart})]
    .nonzero (#point{chart}) inRegion
};
\definition data: Homeomorphisms.Data := Homeomorphisms.Data {
  homeomorphism := homeomorphism, forwardPreserves := forwardPreserves, backwardPreserves := backwardPreserves,
};
\definition chainIsomorphism: _ := Homeomorphisms.chainIsomorphism data;

\module Homology(z: I.Int^);

\module With(coefficients: Modules.Bundle);
