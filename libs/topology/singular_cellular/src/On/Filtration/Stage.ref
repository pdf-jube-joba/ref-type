\import Space.Subspace[S := subset limit] \as Subspace;
\import topology.Topology[Carrier := Subspace.CarrierSet] \as StageSpace;
\definition Carrier: \Set := Subspace.CarrierSet;
\definition topology: StageSpace.Topology := Subspace.topology source;
\definition inclusion[x: Carrier]: A := x;
\import topology.Continuity[A := Carrier, B := A].Corestriction[S := subset limit] \as Inclusion;
\definition continuous: topology.Continuity[A := Carrier, B := A].Continuous topology source inclusion :=
  Inclusion.inclusionContinuous source;
\definition closed: Space.IsClosedIn source (subset limit) := \parent.Closed[].closed limit;
\definition ambientContinuous: topology.Continuity[A := Carrier, B := A].Continuous topology source inclusion := continuous;

