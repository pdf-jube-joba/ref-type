\import \parent.Stage[limit := limit] \as Stage;
\import \parent.Exhaustion[] \as Exhaustion;
\definition covers(bound: Nat.Le (Exhaustion.height cells) limit): \forall (x: A) -> \In[A] (subset limit) x :=
  \fun (x: A) => monotone (Exhaustion.height cells) limit bound x (Exhaustion.covers x);
\import topology.Homeomorphism[A := Stage.Carrier, B := A] \as Homeomorphisms;
\import topology.Continuity[A := A, B := A].Corestriction[S := subset limit] \as Into;
\import topology.Maps[A := A, B := A].Identity[] \as Identity;
\definition homeomorphism(bound: Nat.Le (Exhaustion.height cells) limit): Homeomorphisms.Homeomorphism[Stage.topology, source] :=
  Homeomorphisms.Homeomorphism[Stage.topology, source] {
    forward := Stage.inclusion,
    backward := \fun (x: A) => \into[A](x, subset limit) \by { covers bound x },
    leftInverse := \fun (x: Stage.Carrier) => \refl(x),
    rightInverse := \fun (x: A) => \refl(x),
    forwardContinuous := Stage.continuous,
    backwardContinuous := Into.corestrictContinuous source source
      (\fun (x: A) => \into[A](x, subset limit) \by { covers bound x }) (Identity.continuous source),
  };
