\definition member: Cells.CellMember cells cell := #left{selected};
\definition below: Nat.Lt (#dimension{cell}) limit := #right{selected};
\import Euclidean.Dimension[n := #dimension{cell}] \as Model;
\import topology.Topology[Carrier := Model.Disk] \as Disk;
\import Disk.Finite[] \as DiskFinite;
\definition good: \Pow Model.Disk := { p: Model.Disk \where StageSpace.Member W (lift cell member below p) };
\definition bad: \Pow Model.Disk := Disk.Complement good;
\import topology.Maps[A := Model.Disk, B := A] \as Maps;
\definition same: Maps.Image (#characteristic{cell}) bad = piece cell :=
  \axiom:setext(Maps.Image (#characteristic{cell}) bad, piece cell,
    \block {
      \fun (x: A)(inside: _) \then
      \takefrom p: \Cast[Model.Disk] ({ p: Model.Disk \where Logic.And[Disk.Member bad p, #characteristic{cell} p = x] }) \by inside \then
      \let data: Logic.And[Disk.Member bad p, #characteristic{cell} p = x] :=
        \bysub(Model.Disk, { p: Model.Disk \where Logic.And[Disk.Member bad p, #characteristic{cell} p = x] }, p) \then
      \return \exact(Witness[cell, x] {
        member := member, below := below, point := p, image := #right{data}, outside := #left{data},
      }, Witness[cell, x])
    },
    \block {
      \fun (x: A)(inside: _) \then
      \takefrom witness: Witness[cell, x] \by inside \then
      \return Logic.existsIntro[Model.Disk, { p: Model.Disk \where Logic.And[Disk.Member bad p, #characteristic{cell} p = x] }] (#point{witness})
        (Logic.And[_, _]::# (#outside{witness}) (#image{witness}))
    });
\import \root.On[A := A, source := source, complex := complex].CellProperties[cell := cell, member := member] \as Properties;
\definition closed: Space.IsClosedIn source (piece cell) :=
  \idelim Maps.Image (#characteristic{cell}) bad = piece cell \with F: \Pow A => Space.IsClosedIn source F \by {
    base: Properties.closedImage bad (DiskFinite.openComplementClosed Model.diskTopology good (local cell member below)),
    equality: same
  };
