\import \parent.Stage[limit := m] \as From;
\import \parent.Stage[limit := n] \as To;
\definition apply(bound: Nat.Le m n)(x: From.Carrier): To.Carrier := \into[A](x, subset n) \by {
  monotone m n bound x (\bysub(A, subset m, x))
};
\import topology.Continuity[A := From.Carrier, B := A].Corestriction[S := subset n] \as Into;
\definition continuous(bound: Nat.Le m n): topology.Continuity[A := From.Carrier, B := To.Carrier].Continuous From.topology To.topology (apply bound) :=
  Into.corestrictContinuous From.topology source (apply bound) From.continuous;
\import singular_cohomology.Chains[A := From.Carrier, source := From.topology] \as FromChains;
\import singular_cohomology.Chains[A := To.Carrier, source := To.topology] \as ToChains;
\import singular_cohomology.Maps[A := From.Carrier, B := To.Carrier, source := From.topology, target := To.topology] \as Maps;
\definition chainMap(bound: Nat.Le m n): Complexes.Map[C := FromChains.integerComplex, D := ToChains.integerComplex].Map :=
  Maps.integerPush (apply bound) (continuous bound);
