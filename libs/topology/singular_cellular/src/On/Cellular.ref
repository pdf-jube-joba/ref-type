\definition Carrier[n: N.Nat^]: \Set := \parent.Layer[n := n].Homology[z := I.Int^::ofNat n].Carrier;
\definition space[n: N.Nat^]: Modules.Space (Carrier n) := \parent.Layer[n := n].Homology[z := I.Int^::ofNat n].space;
\definition family: Nonnegative.Family := Nonnegative.Family { Carrier := Carrier, space := space };

\module Boundary(n: N.Nat^);
\definition boundary[n: N.Nat^]: Modules.Hom[V := Carrier (N.Nat^::succ n), W := Carrier n, source := space (N.Nat^::succ n), target := space n].Map := Boundary[n := n].map;
\module Square(n: N.Nat^);
\definition squareZero: \forall (n: N.Nat^)(x: Carrier (N.Nat^::succ (N.Nat^::succ n))) ->
  (boundary n).apply ((boundary (N.Nat^::succ n)).apply x) = (space n).zero :=
  \fun (n: N.Nat^) => Square[n := n].law;
\definition differential: Nonnegative.DifferentialData[family] := Nonnegative.DifferentialData[family] {
  apply := \fun (n: N.Nat^) => (boundary n).apply,
};
\definition complex: Nonnegative.Complex := Nonnegative.Complex {
  family := family, differential := differential,
  laws := Nonnegative.DifferentialLaws[family, differential] {
    addition := \fun (n: N.Nat^) => (boundary n).addition,
    scalar := \fun (n: N.Nat^) => (boundary n).scalar,
    squareZero := squareZero,
  },
};
\import Nonnegative.ZeroExtension[C := complex] \as Extension;
\definition integerComplex: Complexes.Complex := Extension.complex;

\module With(coefficients: Modules.Bundle);

\module Projectivity(n: N.Nat^);

\module Preliminary(n: N.Nat^);

\module Representatives;
