\module At(n: N.Nat^);
\definition Data(n: N.Nat^): \Set := At[n := n].Data;
\module Zero;

\structure Input: \Set { degree: N.Nat^, previous: Data degree }
\definition Correction(input: Input): \Set := At[n := input.degree].Next[previous := input.previous].Result;
\definition correctionExists(input: Input): \exists Correction input := At[n := input.degree].Next[previous := input.previous].existence;
\structure Selection: \Set {
  zero: Data N.Nat^::zero,
  next: \forall (input: Input) -> Correction input,
}
\definition selectionExists: \exists Selection := \block {
  \takefrom zero: Data N.Nat^::zero \by Zero[].existence \then
  \takefrom next: (\forall (input: Input) -> Correction input) \by \axiom:classicalIndefiniteChoice(Input, Correction, correctionExists) \then
  \return \exact(Selection { zero := zero, next := next }, Selection)
};
\module Selected(selection: Selection);
