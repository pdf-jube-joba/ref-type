\import \parent.\parent.Layer[n := n].Homology[z := I.Int^::ofNat n] \as Target;
\import \parent.\parent.Layer[n := N.Nat^::succ n].Homology[z := I.Int^::ofNat (N.Nat^::succ n)] \as MiddleLayer;
\import \parent.\parent.Layer[n := N.Nat^::succ (N.Nat^::succ n)].Homology[z := I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n))] \as Source;
\import \parent.\parent.Filtration[].Stage[limit := N.Nat^::succ n] \as MiddleSpace;
\import singular_cohomology.Chains[A := MiddleSpace.Carrier, source := MiddleSpace.topology] \as MiddleChains;
\import Nonnegative.ZeroExtension[C := MiddleChains.complex] \as MiddleExtension;
\import Complexes.At[C := MiddleExtension.complex, z := I.Int^::ofNat n] \as Middle;
\import Modules.Hom[V := Middle.Homology, W := Carrier n, source := Middle.homologySpace, target := space n] \as Projection;
\definition law: \forall (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) ->
  (boundary n).apply ((boundary (N.Nat^::succ n)).apply x) = (space n).zero :=
  \fun (x: Carrier (N.Nat^::succ (N.Nat^::succ n))) => trans!{{Carrier n}} _ _ _
    (congr!{Middle.Homology {Carrier n}} ((Target.projection).apply) _ _
      (MiddleLayer.projectionConnectingZero ((Source.connecting).apply x)))
    (Projection.zeroPreserved Target.projection);
