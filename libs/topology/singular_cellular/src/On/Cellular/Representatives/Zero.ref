\import \parent.At[n := N.Nat^::zero] \as Zero;
\import \parent.\parent.\parent.Layer[n := N.Nat^::zero] \as Layer;
\import \parent.\parent.\parent.Filtration[].Stage[limit := N.Nat^::zero] \as Lower;
\import \parent.\parent.\parent.Filtration[].Stage[limit := N.Nat^::succ N.Nat^::zero] \as Upper;
\import singular_cohomology.Chains[A := Lower.Carrier, source := Lower.topology] \as LowerChains;
\import singular_cohomology.Chains[A := Upper.Carrier, source := Upper.topology] \as UpperChains;
\import Nonnegative.ZeroExtension[C := LowerChains.complex] \as LowerExtension;
\import Nonnegative.ZeroExtension[C := UpperChains.complex] \as UpperExtension;
\import Complexes.At[C := integerComplex, z := I.Int^::ofNat N.Nat^::zero] \as Cell;
\import singular_cellular_algebra.Algebra[].RelativeRepresentative[A := LowerExtension.complex, B := UpperExtension.complex, C := Layer.complex, sequence := Layer.sequence, z := I.Int^::ofNat N.Nat^::zero] \as Relative;
\definition existence: \exists Zero.Data := \block {
  \takefrom data: Relative.Data \by \parent.\parent.Preliminary[n := N.Nat^::zero].existence \then
  \return \exact(Zero.Data {
    relative := data,
    onCycle := \fun (q: Cell.Cycle) => \refl(#zero{(UpperExtension.space (I.Int^::negSucc N.Nat^::zero))}),
  }, Zero.Data)
};
