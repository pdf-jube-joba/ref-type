\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Integer[P := AmbientChains.integerComplex, N := coefficients] \as Singular;
\import Hom.Integer[P := integerComplex, N := coefficients] \as Cellular;
\import Hom.IntegerHomotopy[P := integerComplex, Q := AmbientChains.integerComplex, N := coefficients] \as Pull;
\import Hom.IntegerEquivalence[P := integerComplex, Q := AmbientChains.integerComplex, N := coefficients] \as Invariance;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\definition pullback: Cochains.Map[C := Singular.complex, D := Cellular.complex].Map := Pull.map integerMap;
\definition quasiIsomorphism: Cochains.Map[C := Singular.complex, D := Cellular.complex].QuasiIsomorphism pullback := \block {
  \takefrom e: \Cast[Equivalences.Equivalence] ({ e: Equivalences.Equivalence \where #forward{e} = integerMap }) \by equivalenceExists \then
  \return \idelim #forward{e} = integerMap \with f: Complexes.Map[C := integerComplex, D := AmbientChains.integerComplex].Map =>
    Cochains.Map[C := Singular.complex, D := Cellular.complex].QuasiIsomorphism (Pull.map f) \by {
      base: Invariance.quasiIsomorphism e,
      equality: \bysub(Equivalences.Equivalence, { e: Equivalences.Equivalence \where #forward{e} = integerMap }, e)
    }
};
\module At(z: I.Int^);
