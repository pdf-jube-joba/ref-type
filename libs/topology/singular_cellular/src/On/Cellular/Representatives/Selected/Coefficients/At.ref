\import Cochains.At[C := SingularInput.complex, z := z] \as SourceH;
\import Cochains.At[C := CellOutput.complex, z := z] \as TargetH;
\import Cochains.Map[C := SingularInput.complex, D := CellInput.complex].At[k := z] \as InputPull;
\import Cochains.Map[C := SingularOutput.complex, D := CellOutput.complex].At[k := z] \as OutputPull;
\import Maps.At[k := z] \as Direct;
\definition naturality[q: SourceH.Cohomology]:
  (Cellular.At[z := z].map).apply (((\parent.\parent.With[coefficients := input].At[z := z].isomorphism).forward).apply q) =
  ((\parent.\parent.With[coefficients := output].At[z := z].isomorphism).forward).apply ((Singular.At[z := z].map).apply q) :=
  trans!{TargetH.Cohomology} _ _ _
    (sym!{TargetH.Cohomology} _ _ (Left.At[k := z].compositionOnCohomology Cellular.map (InputComparison.map integerMap) q))
    (trans!{TargetH.Cohomology} _ _ _
      (congr!{Maps.Map TargetH.Cohomology} (\fun (m: Maps.Map) => (Direct.induced m).apply q) _ _ cochainNaturality)
      (Right.At[k := z].compositionOnCohomology (OutputComparison.map integerMap) Singular.map q));
