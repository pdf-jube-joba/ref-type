\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\import Double.Tensor[C := complex, D := complex] \as CellTensor;
\import Double.Total[C := CellTensor.complex] \as CellTotal;
\import Double.Tensor[C := AmbientChains.complex, D := AmbientChains.complex] \as SingularTensor;
\import Double.Total[C := SingularTensor.complex] \as SingularTotal;
\import singular_symmetry.On[A := A, source := source] \as Singular;
\import Double.TensorMapping[C := AmbientChains.complex, D := complex, E := AmbientChains.complex, F := complex]
  .With[f := (equivalence).backward, g := (equivalence).backward] \as Backward;
\import Nonnegative.Map[C := AmbientChains.complex, D := SingularTotal.complex].Composition[B := complex] \as IntoSingular;
\definition first: Nonnegative.Map[C := complex, D := SingularTotal.complex].Map := IntoSingular.compose Singular.forward (equivalence).forward;
\import Nonnegative.Map[C := SingularTotal.complex, D := CellTotal.complex].Composition[B := complex] \as Final;
\definition map: Nonnegative.Map[C := complex, D := CellTotal.complex].Map := Final.compose Backward.total first;
\definition target: Nonnegative.Complex := CellTotal.complex;

\module Cup(R: \Set, ring: std.Alg[].Ring[].CommutativeRing[R], p, q: N.Nat^);
