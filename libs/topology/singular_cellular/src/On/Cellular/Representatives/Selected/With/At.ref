\import Cochains.At[C := Singular.complex, z := z] \as Source;
\import Cochains.At[C := Cellular.complex, z := z] \as Target;
\import Cochains.Map[C := Singular.complex, D := Cellular.complex].At[k := z].Invert[f := pullback] \as Inverse;
\definition isomorphism: Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Isomorphism :=
  Inverse.isomorphism (quasiIsomorphism z);
