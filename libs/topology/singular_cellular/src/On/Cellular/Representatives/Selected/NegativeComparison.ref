\definition degree: I.Int^ := I.Int^::negSucc k;
\import Complexes.At[C := integerComplex, z := degree] \as Cell;
\import Complexes.At[C := AmbientChains.integerComplex, z := degree] \as Target;
\import Nonnegative.ZeroExtension[C := complex].NegativeHomology[n := k] \as SourceZero;
\import Nonnegative.ZeroExtension[C := AmbientChains.complex].NegativeHomology[n := k] \as TargetZero;
\import Complexes.Map[C := integerComplex, D := AmbientChains.integerComplex].At[k := degree] \as Maps;
\definition bijective: Maps.Bijective[integerMap] := Maps.Bijective[integerMap] {
  injective := \fun (q, r: Cell.Homology)(same: _) => trans!{Cell.Homology} _ _ _ (SourceZero.vanishes q) (sym!{Cell.Homology} _ _ (SourceZero.vanishes r)),
  onto := \fun (q: Target.Homology) => Logic.existsIntro[Cell.Homology, { x: Cell.Homology \where #apply{(Maps.induced integerMap)} x = q }] Cell.zeroClass
    (trans!{Target.Homology} _ _ _ (TargetZero.vanishes (#apply{(Maps.induced integerMap)} Cell.zeroClass)) (sym!{Target.Homology} _ _ (TargetZero.vanishes q))),
};
