\definition degree: I.Int^ := I.Int^::ofNat n;
\import Extension.Positive[n := n] \as Cell;
\import Nonnegative.ZeroExtension[C := AmbientChains.complex].Positive[n := n] \as Ambient;
\definition sourceBundle: Modules.Bundle := Modules.Bundle { Carrier := Extension.Carrier degree, space := Extension.space degree };
\definition cellularBundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier n, space := space n };
\import Modules.ProjectiveLaws[].Retract[P := sourceBundle, Q := cellularBundle, inclusion := Cell.backward, retraction := Cell.forward] \as Source;
\definition sourceProjectivity: Modules.Projective sourceBundle := Source.projective (\fun (x: Extension.Carrier degree) => \refl(x)) (\parent.\parent.\parent.Projectivity[n := n].projective);
\import singular_cohomology.Simplices[A := A, source := source] \as Simplices;
\import Modules.Free[Generators := Simplices.Carrier n] \as Free;
\import Nonnegative.ZeroExtension[C := AmbientChains.complex] \as AmbientExtension;
\definition targetBundle: Modules.Bundle := Modules.Bundle { Carrier := AmbientExtension.Carrier degree, space := AmbientExtension.space degree };
\import Modules.ProjectiveLaws[].Retract[P := targetBundle, Q := Free.bundle, inclusion := Ambient.backward, retraction := Ambient.forward] \as Target;
\definition targetProjectivity: Modules.Projective targetBundle := Target.projective (\fun (x: AmbientExtension.Carrier degree) => \refl(x)) Free.projective;
