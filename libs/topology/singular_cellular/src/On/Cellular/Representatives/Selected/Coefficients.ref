\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Integer[P := integerComplex, N := input] \as CellInput;
\import Hom.Integer[P := integerComplex, N := output] \as CellOutput;
\import Hom.Integer[P := AmbientChains.integerComplex, N := input] \as SingularInput;
\import Hom.Integer[P := AmbientChains.integerComplex, N := output] \as SingularOutput;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import Hom.IntegerMapping[P := integerComplex, Q := integerComplex, N := input, L := output]
  .On[f := Complexes.End[C := integerComplex].identity, u := coefficientMap] \as Cellular;
\import Hom.IntegerMapping[P := AmbientChains.integerComplex, Q := AmbientChains.integerComplex, N := input, L := output]
  .On[f := Complexes.End[C := AmbientChains.integerComplex].identity, u := coefficientMap] \as Singular;
\import Hom.IntegerHomotopy[P := integerComplex, Q := AmbientChains.integerComplex, N := input] \as InputComparison;
\import Hom.IntegerHomotopy[P := integerComplex, Q := AmbientChains.integerComplex, N := output] \as OutputComparison;
\import Cochains.Map[C := CellInput.complex, D := CellOutput.complex].Composition[B := SingularInput.complex] \as Left;
\import Cochains.Map[C := SingularOutput.complex, D := CellOutput.complex].Composition[B := SingularInput.complex] \as Right;
\import Cochains.Map[C := SingularInput.complex, D := CellOutput.complex] \as Maps;
\definition left: Maps.Map := Left.compose Cellular.map (InputComparison.map integerMap);
\definition right: Maps.Map := Right.compose (OutputComparison.map integerMap) Singular.map;
\definition cochainNaturality: left = right := Maps.ext left right
  (\fun (z: I.Int^)(h: SingularInput.Carrier z) => CellOutput.At[z := z].ext
    (#apply{left} z h) (#apply{right} z h)
    (\fun (x: integerComplex.family.Carrier z) => \refl(#apply{coefficientMap} (#apply{h} (#apply{integerMap} z x)))));
\module At(z: I.Int^);
