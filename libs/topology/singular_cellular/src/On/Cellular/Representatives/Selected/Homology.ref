\import resolutions.TensorComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Tensor;
\import Tensor.Integer[P := integerComplex, N := coefficients] \as Cellular;
\import Tensor.Integer[P := AmbientChains.integerComplex, N := coefficients] \as Singular;
\import singular_finite_algebra.Integer[].CoefficientTensor[P := integerComplex, Q := AmbientChains.integerComplex, coefficients := coefficients] \as Mapping;
\import singular_finite_algebra.Integer[].CoefficientEquivalence[P := integerComplex, Q := AmbientChains.integerComplex, coefficients := coefficients] \as Invariance;
\import Complexes.Map[C := Cellular.complex, D := Singular.complex] \as Maps;
\import Complexes.Equivalence[C := Cellular.complex, D := Singular.complex] \as Comparison;
\definition chainMap: Maps.Map := Mapping.On[f := integerMap].map;
\definition quasiIsomorphism: Maps.QuasiIsomorphism chainMap := \block {
  \takefrom e: \Cast[Equivalences.Equivalence] ({ e: Equivalences.Equivalence \where (e).forward = integerMap }) \by equivalenceExists \then
  \return \idelim (e).forward = integerMap \with f: Complexes.Map[C := integerComplex, D := AmbientChains.integerComplex].Map =>
    Maps.QuasiIsomorphism Mapping.On[f := f].map \by {
      base: \fun (z: I.Int^) => Comparison.At[k := z].bijective Invariance.With[e := e].equivalence,
      equality: \bysub(Equivalences.Equivalence, { e: Equivalences.Equivalence \where (e).forward = integerMap }, e)
    }
};
\module At(z: I.Int^);
