\definition degree: I.Int^ := I.Int^::ofNat n;
\import \parent.\parent.\parent.Layer[n := n] \as Layer;
\import \parent.\parent.\parent.Filtration[].Stage[limit := n] \as Lower;
\import \parent.\parent.\parent.Filtration[].Stage[limit := N.Nat^::succ n] \as Upper;
\import singular_cohomology.Chains[A := Lower.Carrier, source := Lower.topology] \as LowerChains;
\import singular_cohomology.Chains[A := Upper.Carrier, source := Upper.topology] \as UpperChains;
\import Nonnegative.ZeroExtension[C := LowerChains.complex] \as LowerExtension;
\import Nonnegative.ZeroExtension[C := UpperChains.complex] \as UpperExtension;
\import singular_cellular_algebra.Algebra[].RelativeRepresentative[A := LowerExtension.complex, B := UpperExtension.complex, C := Layer.complex, sequence := Layer.sequence, z := degree] \as Relative;
\import Complexes.At[C := integerComplex, z := degree] \as CellHomology;
\import Complexes.At[C := UpperExtension.complex, z := degree] \as Whole;
\structure Data: \Set := {
  relative: Relative.Data,
  onCycle: \forall (q: CellHomology.Cycle) -> (UpperExtension.complex.differential).apply degree ((relative.map).apply q) = (UpperExtension.space (Degrees.previous degree)).zero,
};
\module Next(previous: Data);
