\import Modules.Hom[V := Carrier n, W := UpperExtension.Carrier degree, source := space n, target := UpperExtension.space degree] \as PreviousMaps;
\import Modules.Laws[V := NextExtension.Carrier degree, space := NextExtension.space degree] \as Target;
\import Complexes.Map[C := UpperExtension.complex, D := NextExtension.complex].At[k := degree] \as Included;
\definition onCycle: \forall (q: NextCell.Cycle) ->
  #apply{NextExtension.complex.differential} (I.Int^::ofNat (N.Nat^::succ n)) (#apply{result.representative.map} q) = #zero{(NextExtension.space degree)} :=
  \fun (q: NextCell.Cycle) => trans!{{NextExtension.Carrier degree}} _ _ _
    (result.boundary q)
    (trans!{{NextExtension.Carrier degree}} _ _ _
      (congr!{{UpperExtension.Carrier degree} {NextExtension.Carrier degree}} (#apply{NextLayer.inclusion} degree) _ _
        (trans!{{UpperExtension.Carrier degree}} _ _ _
          (congr!{{Carrier n} {UpperExtension.Carrier degree}} (#apply{previous.relative.map}) _ _
            (\bysub(Extension.Carrier (I.Int^::ofNat (N.Nat^::succ n)), #carrier{(NextCell.cycles)}, q)))
          (PreviousMaps.zeroPreserved previous.relative.map)))
      (Included.zeroPreserved NextLayer.inclusion));
\definition data: Next.Data := Next.Data { relative := result.representative, onCycle := onCycle };
\definition boundaryLaw: \forall (q: Carrier (N.Nat^::succ n)) ->
  #apply{NextExtension.complex.differential} (I.Int^::ofNat (N.Nat^::succ n)) (#apply{data.relative.map} q) =
    #apply{NextLayer.inclusion} degree (#apply{previous.relative.map} (#apply{(boundary n)} q)) := result.boundary;
