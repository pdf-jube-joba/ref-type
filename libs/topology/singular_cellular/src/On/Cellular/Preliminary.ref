\definition degree: I.Int^ := I.Int^::ofNat n;
\import \parent.\parent.Layer[n := n] \as Layer;
\import \parent.\parent.Filtration[].Stage[limit := n] \as Lower;
\import \parent.\parent.Filtration[].Stage[limit := N.Nat^::succ n] \as Upper;
\import singular_cohomology.Chains[A := Lower.Carrier, source := Lower.topology] \as LowerChains;
\import singular_cohomology.Chains[A := Upper.Carrier, source := Upper.topology] \as UpperChains;
\import Nonnegative.ZeroExtension[C := LowerChains.complex] \as LowerExtension;
\import Nonnegative.ZeroExtension[C := UpperChains.complex] \as UpperExtension;
\import singular_cellular_algebra.Algebra[].RelativeRepresentative[A := LowerExtension.complex, B := UpperExtension.complex, C := Layer.complex, sequence := Layer.sequence, z := degree] \as Representatives;
\definition existence: \exists Representatives.Data := Representatives.existence (\parent.Projectivity[n := n].projective);
