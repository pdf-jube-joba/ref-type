\import \parent.\parent.Layer[n := n].Basis[] \as Basis;
\import \parent.\parent.Filtration[].CellInteriors[n := n] \as Cells;
\import singular_cellular_algebra.Algebra[].FreeSum[Index := Cells.Index] \as FreeBasis;
\import Modules.DirectSum[Index := Cells.Index, family := Basis.scalars] \as Sum;
\definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier n, space := space n };
\import Modules.ProjectiveLaws[].Retract[P := bundle, Q := Sum.bundle,
  inclusion := #backward{Basis.isomorphism}, retraction := #forward{Basis.isomorphism}] \as Transport;
\definition projective: Modules.Projective bundle := Transport.projective #rightInverse{Basis.isomorphism}
  (Sum.projective (\fun (_: Cells.Index) => Modules.ProjectiveLaws[].Scalar[].projective));

\import Modules.Free[Generators := Cells.Index] \as Free;
\import Modules.Isomorphism[V := Free.Carrier, W := Sum.Carrier, source := Free.space, target := Sum.space]
  .Composition[U := Carrier n, final := space n] \as Composition;
\definition freeIsomorphism: Modules.Isomorphism[V := Free.Carrier, W := Carrier n, source := Free.space, target := space n].Isomorphism :=
  Composition.compose Basis.isomorphism FreeBasis.isomorphism;
