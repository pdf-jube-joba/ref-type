\import topology.Topology[Carrier := DiskQuotient.Carrier] \as Target;
\import topology.Continuity[A := Skeleton.Carrier, B := DiskQuotient.Carrier] \as Maps;
\module OnCell(other: Cells.CellData, present: Cells.CellMember cells other, below: Nat.Lt ((other).dimension) (N.Nat^::succ dimension));
\definition continuous: Maps.Continuous Skeleton.topology (DiskQuotient.topology Model.diskTopology) map :=
  \fun (U: \Pow DiskQuotient.Carrier)(open: Target.IsOpenIn (DiskQuotient.topology Model.diskTopology) U) =>
    (Skeleton.Open[].criterion (Maps.Preimage map U)).rtl
      (\fun (other: Cells.CellData)(present: _)(below: _) => OnCell[other := other, present := present, below := below].continuous U open);
