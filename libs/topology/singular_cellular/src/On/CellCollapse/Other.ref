\import Euclidean.Dimension[n := (other).dimension] \as OtherModel;
\import Filtration.Characteristic[cell := other, member := present] \as Other;
\definition bound: Nat.Le ((other).dimension) dimension := Nat.leOfSuccSucc ((other).dimension) dimension
  (Nat.succLeOfLt (N.Nat^::succ dimension) ((other).dimension) below);
\definition lift[p: OtherModel.Disk]: Skeleton.Carrier := Skeleton.Open[].lift other present below p;
\definition boundaryOutside[p: OtherModel.Disk][boundary: OtherModel.normSquared p = Real.one]: Logic.Not (InteriorImage (lift p)) :=
  \parent.Boundary[].onLower (lift p) (Filtration.monotone ((other).dimension) dimension bound ((other).characteristic p)
    (Other.boundaryImage (\into[OtherModel.Coordinate](p, OtherModel.Boundary) \by { boundary })));
\definition outside: Logic.Not (other = cell) -> \forall (p: OtherModel.Disk) -> Logic.Not (InteriorImage (lift p)) :=
  \fun (different: _)(p: OtherModel.Disk) => either!{{(Classical.excludedMiddle (Reals.Lt (OtherModel.normSquared p) Real.one))} {Logic.Not (InteriorImage (lift p))}
    {\fun (interior: _)(inside: _) => different ((laws).disjoint other cell present member ((other).characteristic p)
      (Logic.existsIntro[OtherModel.Disk, { q: OtherModel.Disk \where Logic.And[Reals.Lt (OtherModel.normSquared q) Real.one, (other).characteristic q = (other).characteristic p] }] p
        (Logic.And[_, _]::# interior (\refl((other).characteristic p)))) inside)}
    {\fun (notInterior: _) => boundaryOutside p (Reals.leAntisym _ _ (\bysub(OtherModel.Coordinate, OtherModel.ClosedBall, p))
      (Order.leOfNotLtReverse Real.one (OtherModel.normSquared p) notInterior))}
  };
\definition onCharacteristic[different: Logic.Not (other = cell)]: \forall (p: OtherModel.Disk) -> map (lift p) = basepoint :=
  \fun (p: OtherModel.Disk) => onOutside (lift p) (outside different p);
