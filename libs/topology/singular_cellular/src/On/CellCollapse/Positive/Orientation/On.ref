\import topology.Homeomorphism[A := DiskQuotient.Carrier, B := Sphere.Sphere] \as Homeomorphisms;
\definition laws: Homeomorphisms.Laws[DiskQuotient.topology Model.diskTopology, Sphere.sphereTopology, h] := Homeomorphisms.laws (DiskQuotient.topology Model.diskTopology) Sphere.sphereTopology h;
\definition collapse(x: Skeleton.Carrier): Sphere.Sphere := #forward{h} (map x);
\import topology.Composition[A := Skeleton.Carrier, B := DiskQuotient.Carrier, C := Sphere.Sphere] \as Composition;
\definition continuous: topology.Continuity[A := Skeleton.Carrier, B := Sphere.Sphere].Continuous Skeleton.topology Sphere.sphereTopology collapse :=
  Composition.composeContinuous Skeleton.topology (DiskQuotient.topology Model.diskTopology) Sphere.sphereTopology map #forward{h}
    (\parent.\parent.\parent.Continuity[].continuous) #forwardContinuous{laws};
\definition onCharacteristic(p: Model.Disk): collapse (Characteristic.characteristic p) = #forward{h} (DiskQuotient.class p) :=
  congr!{DiskQuotient.Carrier Sphere.Sphere} (#forward{h}) _ _ (\parent.\parent.\parent.Boundary[].onCharacteristic p);
\definition outside(x: Skeleton.Carrier)(notCell: Logic.Not (InteriorImage x)): collapse x = #forward{h} basepoint :=
  congr!{DiskQuotient.Carrier Sphere.Sphere} (#forward{h}) _ _ (onOutside x notCell);
