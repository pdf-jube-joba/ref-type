\import singular_cohomology.Chains[A := Sphere.Sphere, source := Sphere.sphereTopology] \as Chains;
\import Nonnegative.ZeroExtension[C := Chains.complex] \as Extension;
\import Complexes.At[C := Extension.complex, z := I.Int^::ofNat d] \as H;
\definition Carrier: \Set := H.Homology;
\definition space: Modules.Space Carrier := H.homologySpace;
\definition Orientation: \Set := Modules.Isomorphism[V := I.Int^, W := Carrier, source := Modules.scalarModule, target := space].Isomorphism;
\import sphere_maps.Reflection[n := N.Nat^::succ k] \as Reflection;
\import singular_cohomology.Maps[A := Sphere.Sphere, B := Sphere.Sphere, source := Sphere.sphereTopology, target := Sphere.sphereTopology] \as Maps;
\definition reflectionMap: Complexes.Map[C := Extension.complex, D := Extension.complex].Map := Maps.integerPush Reflection.head Reflection.headContinuous;
\definition Negative: \Prop := \forall (q: Carrier) -> #apply{(Complexes.Map[C := Extension.complex, D := Extension.complex].At[k := I.Int^::ofNat d].induced reflectionMap)} q = #neg{space} q;
