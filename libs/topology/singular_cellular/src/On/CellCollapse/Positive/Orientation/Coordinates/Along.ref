\definition sphere: Modules.Bundle := Modules.Bundle { Carrier := \parent.\parent.SphereAt[d := dimension].Carrier, space := \parent.\parent.SphereAt[d := dimension].space };
\import singular_cellular_algebra.Algebra[].IntegerCoordinates[A := quotient, B := sphere, f := Actual.action h,
  sourceOrientation := sourceOrientation, targetOrientation := targetOrientation] \as Normalized;
\definition coordinate[q: quotient.Carrier]: ((CellBasis.orientation).backward).apply ((PairH.projection).apply q) =
  ((targetOrientation).backward).apply ((Actual.action h).apply q) :=
  trans!{I.Int^} _ _ _ (sym!{I.Int^} _ _ (Projected.coordinate projectionPositive q)) (Normalized.coordinate (onGenerator h) q);
