\import \parent.\parent.Other[other := other, present := CellsAt.member other, sameDimension := CellsAt.dimension other, different := different] \as Vanishing;
\import Basis.Characteristic[cell := other].Oriented[] \as OtherBasis;
\import \root.Disks[].At[n := #dimension{other}] \as OtherDisk;
\import Basis.Cell[cell := other] \as Orientation;
\import Euclidean.Dimension[n := #dimension{other}] \as OtherModel;
\import singular_cohomology.Relative[A := OtherModel.Disk, source := OtherModel.diskTopology, subset := Vanishing.otherBoundary]
  .Maps[B := Skeleton.Carrier].Over[target := Skeleton.topology, targetSubset := lower].On[f := Vanishing.characteristic].Integer[] \as OtherAction;
\definition collapsedZero(a: I.Int^): #apply{ActionH.fromLayer} (#apply{#forward{Basis.isomorphism}} (#apply{Free.Injection[i := other].map} a)) = #zero{(Target.Homology[z := degree].space)} :=
  trans!{{Target.Homology[z := degree].Carrier}} _ _ _
    (congr!{{Layer.Homology[z := degree].Carrier} {Target.Homology[z := degree].Carrier}} (#apply{ActionH.fromLayer}) _ _ (OtherBasis.onScalar a))
    (trans!{{Target.Homology[z := degree].Carrier}} _ _ _
      (congr!{{Source.Homology[z := degree].Carrier} {Target.Homology[z := degree].Carrier}} (#apply{ActionH.relative}) _ _
        (#rightInverse{Layer.Relative[].Homology[z := degree].isomorphism}
          (#apply{OtherAction.At[z := degree].induced} (#apply{#forward{Orientation.orientedDisk}} a))))
      (Vanishing.Homology[z := degree].zero (#apply{#forward{Orientation.orientedDisk}} a)));
\import Modules.Hom[V := Target.Homology[z := degree].Carrier, W := I.Int^, source := Target.Homology[z := degree].space, target := Modules.scalarModule] \as Backward;
\definition onScalar(a: I.Int^): #apply{coordinate} (#apply{#forward{Basis.isomorphism}} (#apply{Free.Injection[i := other].map} a)) = I.Zero.specification :=
  trans!{I.Int^} _ _ _
    (congr!{{Target.Homology[z := degree].Carrier} I.Int^} (#apply{#backward{orientation}}) _ _ (collapsedZero a))
    (Backward.zeroPreserved #backward{orientation});
