\definition rawContinuous: _ := continuous;
\definition rawAction: _ := action;
\definition rawChainMap: _ := chainMap;
\definition rawIncidence: matrixCoefficient = value := law;
\import \parent.\parent.\parent.\parent.\parent.Positive[k := k, equalDimension := positive].Orientation[] \as Normalization;
\import Normalization.On[h := h] \as Collapse;
\import Euclidean.Dimension[n := N.Nat^::succ (N.Nat^::succ k)] \as Sphere;
\import singular_cohomology.Chains[A := Sphere.Sphere, source := Sphere.sphereTopology] \as SphereChains;
\import Nonnegative.ZeroExtension[C := SphereChains.complex] \as SphereExtension;
\import Complexes.At[C := SphereExtension.complex, z := degree] \as SphereH;
\definition attachingSphere(p: SourceDiskPair.SubspaceCarrier): Sphere.Sphere := #forward{h} (collapsed p);
\import topology.Composition[A := SourceDiskPair.SubspaceCarrier, B := DiskQuotient.Carrier, C := Sphere.Sphere] \as Topology;
\definition continuous: topology.Continuity[A := SourceDiskPair.SubspaceCarrier, B := Sphere.Sphere].Continuous
  (SourceBoundary.topology SourceModel.diskTopology) Sphere.sphereTopology attachingSphere :=
  Topology.composeContinuous (SourceBoundary.topology SourceModel.diskTopology) (DiskQuotient.topology Model.diskTopology) Sphere.sphereTopology
    collapsed #forward{h} (rawContinuous) #forwardContinuous{Collapse.laws};
\import Maps.Composition[C := Sphere.Sphere, final := Sphere.sphereTopology] \as Composition;
\import singular_cohomology.Maps[A := SourceDiskPair.SubspaceCarrier, B := Sphere.Sphere,
  source := SourceBoundary.topology SourceModel.diskTopology, target := Sphere.sphereTopology] \as SphereMaps;
\definition chainMap: Complexes.Map[C := BoundaryExtension.complex, D := SphereExtension.complex].Map := SphereMaps.integerPush attachingSphere continuous;
\import Complexes.Map[C := BoundaryExtension.complex, D := SphereExtension.complex].At[k := degree] \as Induced;
\definition action: Modules.Hom[V := BoundaryH.Homology, W := SphereH.Homology, source := BoundaryH.homologySpace, target := SphereH.homologySpace].Map := Induced.induced chainMap;
\import Complexes.Map[C := QuotientExtension.complex, D := SphereExtension.complex].Composition[B := BoundaryExtension.complex] \as ChainComposition;
\import singular_cohomology.Maps[A := DiskQuotient.Carrier, B := Sphere.Sphere,
  source := DiskQuotient.topology Model.diskTopology, target := Sphere.sphereTopology] \as HomeomorphismMaps;
\import singular_finite_algebra.Integer[].Orientation[A := DiskQuotient.Carrier, B := Sphere.Sphere,
  source := DiskQuotient.topology Model.diskTopology, target := Sphere.sphereTopology, z := degree] \as Actual;
\definition composition(q: BoundaryH.Homology): #apply{action} q = #apply{(Actual.action h)} (#apply{rawAction} q) :=
  trans!{SphereH.Homology} _ _ _
    (congr!{{Complexes.Map[C := BoundaryExtension.complex, D := SphereExtension.complex].Map} SphereH.Homology}
      (\fun (f: Complexes.Map[C := BoundaryExtension.complex, D := SphereExtension.complex].Map) => #apply{(Induced.induced f)} q) _ _
      (sym!{{Complexes.Map[C := BoundaryExtension.complex, D := SphereExtension.complex].Map}} _ _
        (Composition.Integer[].law collapsed (rawContinuous) #forward{h} #forwardContinuous{Collapse.laws})))
    (ChainComposition.At[k := degree].compositionOnHomology (HomeomorphismMaps.integerPush #forward{h} #forwardContinuous{Collapse.laws}) (rawChainMap) q);
\definition degree: I.Int^ := #apply{#backward{Normalization.targetOrientation}} (#apply{action} boundaryGenerator);
\definition incidence: matrixCoefficient = degree :=
  trans!{I.Int^} _ _ _ (rawIncidence)
    (trans!{I.Int^} _ _ _ (Normalization.Coordinates[].Along[h := h].coordinate (#apply{rawAction} boundaryGenerator))
      (congr!{SphereH.Homology I.Int^} (#apply{#backward{Normalization.targetOrientation}}) _ _ (sym!{SphereH.Homology} _ _ (composition boundaryGenerator))));

\module Spherical;
