\definition basisProjection: #apply{#forward{SourceRelative.Homology[z := upperDegree].isomorphism}} (SourceBasis.generator sourceCell) =
  #apply{CharacteristicAction.At[z := upperDegree].induced} diskGenerator :=
  trans!{{singular_cohomology.Relative[A := Upper.Carrier, source := Upper.topology, subset := SourceRelative.subset].Homology[z := upperDegree].Carrier}} _ _ _
    (congr!{{SourceLayer.Homology[z := upperDegree].Carrier} {singular_cohomology.Relative[A := Upper.Carrier, source := Upper.topology, subset := SourceRelative.subset].Homology[z := upperDegree].Carrier}}
      (#apply{#forward{SourceRelative.Homology[z := upperDegree].isomorphism}}) _ _ CharacteristicBasis.onGenerator)
    (#rightInverse{SourceRelative.Homology[z := upperDegree].isomorphism} (#apply{CharacteristicAction.At[z := upperDegree].induced} diskGenerator));
\definition law: #apply{SourceLayer.Homology[z := upperDegree].connecting} (SourceBasis.generator sourceCell) = #apply{attachingAction} boundaryGenerator :=
  trans!{SkeletonH.Homology} _ _ _
    (sym!{SkeletonH.Homology} _ _ (#leftInverse{lowerIsomorphism} (#apply{SourceLayer.Homology[z := upperDegree].connecting} (SourceBasis.generator sourceCell))))
    (trans!{SkeletonH.Homology} _ _ _
      (congr!{NestedH.Homology SkeletonH.Homology} (#apply{#backward{lowerIsomorphism}}) _ _
        (sym!{NestedH.Homology} _ _ (SourceRelative.Naturality[].At[z := upperDegree].connecting (SourceBasis.generator sourceCell))))
      (trans!{SkeletonH.Homology} _ _ _
        (congr!{NestedH.Homology SkeletonH.Homology} (#apply{#backward{lowerIsomorphism}}) _ _
          (trans!{NestedH.Homology} _ _ _
            (congr!{{singular_cohomology.Relative[A := Upper.Carrier, source := Upper.topology, subset := SourceRelative.subset].Homology[z := upperDegree].Carrier} NestedH.Homology}
              (#apply{singular_cohomology.Relative[A := Upper.Carrier, source := Upper.topology, subset := SourceRelative.subset].LongExact[z := upperDegree].connecting}) _ _ basisProjection)
            (CharacteristicAction.At[z := upperDegree].connectingNaturality diskGenerator)))
        (sym!{SkeletonH.Homology} _ _ (attachingOnHomology boundaryGenerator))));
