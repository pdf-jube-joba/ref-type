\definition boundaryMap: _ := attachingSphere;
\definition boundaryContinuous: _ := continuous;
\definition boundaryAction: _ := action;
\definition boundaryChainMap: _ := chainMap;
\definition boundaryDegree: I.Int^ := degree;
\definition boundaryIncidence: matrixCoefficient = boundaryDegree := incidence;
\import topology.Topology[Carrier := SourceModel.Coordinate].Subspace[S := SourceModel.Boundary].Inside[U := SourceModel.ClosedBall] \as BoundaryNesting;
\definition boundaryIncluded: \forall (p: SourceModel.Coordinate) -> \In[SourceModel.Coordinate] SourceModel.Boundary p -> \In[SourceModel.Coordinate] SourceModel.ClosedBall p :=
  \fun (p: SourceModel.Coordinate)(onBoundary: _) => Reals.leReplaceLeft Real.one (SourceModel.normSquared p) Real.one (sym!{Real.Real} _ _ onBoundary) (Reals.leRefl Real.one);
\definition homeomorphism: topology.Homeomorphism[A := SourceModel.Sphere, B := SourceDiskPair.SubspaceCarrier]
  .Homeomorphism[SourceModel.sphereTopology, SourceBoundary.topology SourceModel.diskTopology] :=
  BoundaryNesting.homeomorphism SourceModel.topology boundaryIncluded;
\import singular_cellular_algebra.Algebra[].AbsoluteHomeomorphism[A := SourceModel.Sphere, B := SourceDiskPair.SubspaceCarrier,
  source := SourceModel.sphereTopology, target := SourceBoundary.topology SourceModel.diskTopology, homeomorphism := homeomorphism] \as Geometry;
\import singular_cohomology.Chains[A := SourceModel.Sphere, source := SourceModel.sphereTopology] \as DomainChains;
\import Nonnegative.ZeroExtension[C := DomainChains.complex] \as DomainExtension;
\import Complexes.At[C := DomainExtension.complex, z := I.Int^::ofNat dimension] \as DomainH;
\definition boundaryIsomorphism: Modules.Isomorphism[V := DomainH.Homology, W := BoundaryH.Homology, source := DomainH.homologySpace, target := BoundaryH.homologySpace].Isomorphism :=
  Complexes.Isomorphism[C := DomainExtension.complex, D := BoundaryExtension.complex].At[z := I.Int^::ofNat dimension].isomorphism Geometry.isomorphism;
\module Disk;
\definition orientation: Modules.Isomorphism[V := I.Int^, W := DomainH.Homology, source := Modules.scalarModule, target := DomainH.homologySpace].Isomorphism :=
  Modules.Isomorphism[V := I.Int^, W := BoundaryH.Homology, source := Modules.scalarModule, target := BoundaryH.homologySpace]
    .Composition[U := DomainH.Homology, final := DomainH.homologySpace].compose
      (Modules.Isomorphism[V := DomainH.Homology, W := BoundaryH.Homology, source := DomainH.homologySpace, target := BoundaryH.homologySpace].Inverse[].inverse boundaryIsomorphism)
      Disk[].boundaryOrientation;
\definition map(p: SourceModel.Sphere): Sphere.Sphere := boundaryMap (#forward{homeomorphism} p);
\import topology.Composition[A := SourceModel.Sphere, B := SourceDiskPair.SubspaceCarrier, C := Sphere.Sphere] \as Topology;
\definition continuous: topology.Continuity[A := SourceModel.Sphere, B := Sphere.Sphere].Continuous SourceModel.sphereTopology Sphere.sphereTopology map :=
  Topology.composeContinuous SourceModel.sphereTopology (SourceBoundary.topology SourceModel.diskTopology) Sphere.sphereTopology
    #forward{homeomorphism} boundaryMap (#forwardContinuous{Geometry.laws}) boundaryContinuous;
\import singular_cohomology.Maps[A := SourceModel.Sphere, B := Sphere.Sphere, source := SourceModel.sphereTopology, target := Sphere.sphereTopology] \as Maps;
\definition chainMap: Complexes.Map[C := DomainExtension.complex, D := SphereExtension.complex].Map := Maps.integerPush map continuous;
\import Complexes.Map[C := DomainExtension.complex, D := SphereExtension.complex].At[k := I.Int^::ofNat dimension] \as Induced;
\definition action: Modules.Hom[V := DomainH.Homology, W := SphereH.Homology, source := DomainH.homologySpace, target := SphereH.homologySpace].Map := Induced.induced chainMap;
\import singular_cohomology.Maps[A := SourceModel.Sphere, B := SourceDiskPair.SubspaceCarrier,
  source := SourceModel.sphereTopology, target := SourceBoundary.topology SourceModel.diskTopology]
  .Composition[C := Sphere.Sphere, final := Sphere.sphereTopology].Integer[] \as Composition;
\import Complexes.Map[C := BoundaryExtension.complex, D := SphereExtension.complex].Composition[B := DomainExtension.complex] \as ChainComposition;
\definition composition(q: DomainH.Homology): #apply{action} q = #apply{boundaryAction} (#apply{#forward{boundaryIsomorphism}} q) :=
  trans!{SphereH.Homology} _ _ _
    (congr!{{Complexes.Map[C := DomainExtension.complex, D := SphereExtension.complex].Map} SphereH.Homology}
      (\fun (f: Complexes.Map[C := DomainExtension.complex, D := SphereExtension.complex].Map) => #apply{(Induced.induced f)} q) _ _
      (sym!{{Complexes.Map[C := DomainExtension.complex, D := SphereExtension.complex].Map}} _ _
        (Composition.law #forward{homeomorphism} (#forwardContinuous{Geometry.laws}) boundaryMap boundaryContinuous)))
    (ChainComposition.At[k := I.Int^::ofNat dimension].compositionOnHomology (boundaryChainMap) Geometry.forwardMap q);
\definition degree: I.Int^ := #apply{#backward{Normalization.targetOrientation}} (#apply{action} (#apply{#forward{orientation}} I.One.specification));
\definition degreeLaw: degree = boundaryDegree :=
  congr!{SphereH.Homology I.Int^} (#apply{#backward{Normalization.targetOrientation}}) _ _
    (trans!{SphereH.Homology} _ _ _ (composition (#apply{#forward{orientation}} I.One.specification))
      (congr!{BoundaryH.Homology SphereH.Homology} (#apply{boundaryAction}) _ _
        (#rightInverse{boundaryIsomorphism} (#apply{#forward{Disk[].boundaryOrientation}} I.One.specification))));
\definition incidence: matrixCoefficient = degree := trans!{I.Int^} _ _ _ boundaryIncidence (sym!{I.Int^} _ _ degreeLaw);
