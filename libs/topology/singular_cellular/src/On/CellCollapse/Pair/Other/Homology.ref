\import IntoSkeleton.On[f := characteristic].Integer[] \as CharacteristicAction;
\definition zero: \forall (q: OtherPair.Homology[z := z].Carrier) ->
  #apply{Action.At[z := z].induced} (#apply{CharacteristicAction.At[z := z].induced} q) = #zero{(Target.Homology[z := z].space)} :=
  \fun (q: OtherPair.Homology[z := z].Carrier) => trans!{{Target.Homology[z := z].Carrier}} _ _ _
    (sym!{{Target.Homology[z := z].Carrier}} _ _ (Composition.On[f := characteristic, g := pairMap].Homology[z := z].law q))
    (Vanishing.At[z := z].homology contained q);
