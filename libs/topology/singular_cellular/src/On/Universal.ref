\definition Family: \Set := \forall (cell: Cells.CellData) -> Euclidean.Disk ((cell).dimension) -> B;
\definition Compatible[family: Family]: \Prop := \forall (cell, other: Cells.CellData) ->
  Cells.CellMember cells cell -> Cells.CellMember cells other ->
  \forall (p: Euclidean.Disk ((cell).dimension))(q: Euclidean.Disk ((other).dimension)) ->
    (cell).characteristic p = (other).characteristic q -> family cell p = family other q;
\module Of(family: Family, compatible: Compatible family);
