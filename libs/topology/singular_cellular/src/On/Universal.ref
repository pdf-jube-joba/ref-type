\definition Family: \Set := \forall (cell: Cells.CellData) -> Euclidean.Disk (#dimension{cell}) -> B;
\definition Compatible(family: Family): \Prop := \forall (cell, other: Cells.CellData) ->
  Cells.CellMember cells cell -> Cells.CellMember cells other ->
  \forall (p: Euclidean.Disk (#dimension{cell}))(q: Euclidean.Disk (#dimension{other})) ->
    #characteristic{cell} p = #characteristic{other} q -> family cell p = family other q;
\module Of(family: Family, compatible: Compatible family);
