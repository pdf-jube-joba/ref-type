\import \parent.\parent.Other[other := other, different := different] \as Geometry;
\import Skeleton.Disk[cell := other, member := AtZero.member other, below := Geometry.below] \as OtherDisk;
\import \parent.Characteristic[other := other, p := OtherDisk.origin] \as Point;
\import sphere_maps.ZeroHomology[].Sphere[] \as SpherePoints;
\definition onGenerator: #apply{Functional.coordinate} (Basis.generator other) = I.Zero.specification :=
  trans!{I.Int^} _ _ _
    (congr!{{Layer.Homology[z := degree].Carrier} I.Int^} (#apply{Functional.coordinate}) _ _ Point.onGenerator)
    (trans!{I.Int^} _ _ _ (Functional.onProjection (Points.class Point.point))
      (trans!{I.Int^} _ _ _ (Functional.onPoint Point.point)
        (trans!{I.Int^} _ _ _
          (congr!{{algebraic_topology.Spheres[].Carrier zero} I.Int^}
            (\fun (x: algebraic_topology.Spheres[].Carrier zero) => #apply{SpherePoints.cochain}
              (singular_cohomology.Chains[A := algebraic_topology.Spheres[].Carrier zero, source := algebraic_topology.Spheres[].topology zero].generator zero
                (singular_cohomology.Simplices[A := algebraic_topology.Spheres[].Carrier zero, source := algebraic_topology.Spheres[].topology zero].At[n := zero].constant x))) _ _
            (Geometry.onCharacteristic OtherDisk.origin)) SpherePoints.south)));
\import singular_cellular_algebra.Algebra[].IntegerLine[W := I.Int^, target := Modules.scalarModule] \as Scalars;
\import Modules.Hom[V := Free.Carrier, W := I.Int^, source := Free.space, target := Modules.scalarModule]
  .Composition[U := I.Int^, domain := Modules.scalarModule] \as Composition;
\definition line: Modules.Hom[V := I.Int^, W := I.Int^, source := Modules.scalarModule, target := Modules.scalarModule].Map :=
  Composition.compose (Rows.compose Functional.coordinate #forward{Basis.isomorphism}) Free.Injection[i := other].map;
\definition onScalar(a: I.Int^): #apply{Functional.coordinate} (#apply{#forward{Basis.isomorphism}} (#apply{Free.Injection[i := other].map} a)) = I.Zero.specification :=
  trans!{I.Int^} _ _ _ (Scalars.onScalar line a)
    (trans!{I.Int^} _ _ _ (congr!{I.Int^ I.Int^} (\fun (x: I.Int^) => #smul{Modules.scalarModule} a x) _ _ onGenerator) (#zeroAbsorbsRight{(#semiring{Integers.ring})} a));
