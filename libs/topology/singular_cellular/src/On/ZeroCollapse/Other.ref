\definition below: Nat.Lt (#dimension{other}) (N.Nat^::succ N.Nat^::zero) :=
  \idelim N.Nat^::zero = #dimension{other} \with d: N.Nat^ => Nat.Lt d (N.Nat^::succ N.Nat^::zero) \by {
    base: Nat.ltOfSuccLe (N.Nat^::succ N.Nat^::zero) N.Nat^::zero (Nat.leRefl (N.Nat^::succ N.Nat^::zero)),
    equality: sym!{N.Nat^} _ _ (AtZero.dimension other)
  };
\import Skeleton.Disk[cell := other, member := AtZero.member other, below := below] \as OtherDisk;
\import Euclidean.Dimension[n := #dimension{other}] \as OtherModel;
\import dedekind_reals.DedekindReal[] \as Reals;
\import Reals.Arithmetic[].Prop[] \as Laws;
\import Reals.Order[] \as Order;
\import real.Analysis[] \as Real;
\definition interior(p: OtherModel.Disk): Reals.Lt (OtherModel.normSquared p) Real.one :=
  Reals.ltReplaceLeft Real.zero (OtherModel.normSquared p) Real.one (sym!{Real.Real} _ _ (OtherDisk.normZero p)) (Order.ltOfLeNotEq Real.zero Real.one Laws.oneNonnegative Laws.zeroNeOne);
\definition targetInterior: Reals.Lt (Euclidean.normSquaredAt (#dimension{cell}) Disk.origin) Real.one :=
  Reals.ltReplaceLeft Real.zero (Euclidean.normSquaredAt (#dimension{cell}) Disk.origin) Real.one (sym!{Real.Real} _ _ (Disk.normZero Disk.origin)) (Order.ltOfLeNotEq Real.zero Real.one Laws.oneNonnegative Laws.zeroNeOne);
\definition pointDifferent(p: OtherModel.Disk): Logic.Not (Stage.Open[].lift other (AtZero.member other) below p = point) :=
  \fun (same: _) => different (#disjoint{laws} other cell (AtZero.member other) (AtZero.member cell) (#characteristic{other} p)
    (Logic.existsIntro[OtherModel.Disk, { q: OtherModel.Disk \where Logic.And[Reals.Lt (OtherModel.normSquared q) Real.one, #characteristic{other} q = #characteristic{other} p] }] p (Logic.And[_, _]::# (interior p) (\refl(#characteristic{other} p))))
    (Logic.existsIntro[Euclidean.Disk (#dimension{cell}), { q: Euclidean.Disk (#dimension{cell}) \where Logic.And[
      Reals.Lt (Euclidean.normSquaredAt (#dimension{cell}) q) Real.one, #characteristic{cell} q = #characteristic{other} p] }] Disk.origin
      (Logic.And[_, _]::# targetInterior (sym!{A} _ _ same))));
\definition onCharacteristic(p: OtherModel.Disk): map (Stage.Open[].lift other (AtZero.member other) below p) = Sphere.south := outside _ (pointDifferent p);
