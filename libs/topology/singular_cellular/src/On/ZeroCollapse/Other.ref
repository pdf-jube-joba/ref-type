\definition below: Nat.Lt ((other).dimension) (N.Nat^::succ N.Nat^::zero) :=
  \idelim N.Nat^::zero = (other).dimension \with d: N.Nat^ => Nat.Lt d (N.Nat^::succ N.Nat^::zero) \by {
    base: Nat.ltOfSuccLe (N.Nat^::succ N.Nat^::zero) N.Nat^::zero (Nat.leRefl (N.Nat^::succ N.Nat^::zero)),
    equality: sym!{N.Nat^} _ _ (AtZero.dimension other)
  };
\import Skeleton.Disk[cell := other, member := AtZero.member other, below := below] \as OtherDisk;
\import Euclidean.Dimension[n := (other).dimension] \as OtherModel;
\import dedekind_reals.DedekindReal[] \as Reals;
\import Reals.Arithmetic[].Prop[] \as Laws;
\import Reals.Order[] \as Order;
\import real.Analysis[] \as Real;
\definition interior[p: OtherModel.Disk]: Reals.Lt (OtherModel.normSquared p) Real.one :=
  Reals.ltReplaceLeft Real.zero (OtherModel.normSquared p) Real.one (sym!{Real.Real} _ _ (OtherDisk.normZero p)) (Order.ltOfLeNotEq Real.zero Real.one Laws.oneNonnegative Laws.zeroNeOne);
\definition targetInterior: Reals.Lt (Euclidean.normSquaredAt ((cell).dimension) Disk.origin) Real.one :=
  Reals.ltReplaceLeft Real.zero (Euclidean.normSquaredAt ((cell).dimension) Disk.origin) Real.one (sym!{Real.Real} _ _ (Disk.normZero Disk.origin)) (Order.ltOfLeNotEq Real.zero Real.one Laws.oneNonnegative Laws.zeroNeOne);
\definition pointDifferent[p: OtherModel.Disk]: Logic.Not (Stage.Open[].lift other (AtZero.member other) below p = point) :=
  \fun (same: _) => different ((laws).disjoint other cell (AtZero.member other) (AtZero.member cell) ((other).characteristic p)
    (Logic.existsIntro[OtherModel.Disk, { q: OtherModel.Disk \where Logic.And[Reals.Lt (OtherModel.normSquared q) Real.one, (other).characteristic q = (other).characteristic p] }] p (Logic.And[_, _]::# (interior p) (\refl((other).characteristic p))))
    (Logic.existsIntro[Euclidean.Disk ((cell).dimension), { q: Euclidean.Disk ((cell).dimension) \where Logic.And[
      Reals.Lt (Euclidean.normSquaredAt ((cell).dimension) q) Real.one, (cell).characteristic q = (other).characteristic p] }] Disk.origin
      (Logic.And[_, _]::# targetInterior (sym!{A} _ _ same))));
\definition onCharacteristic[p: OtherModel.Disk]: map (Stage.Open[].lift other (AtZero.member other) below p) = Sphere.south := outside _ (pointDifferent p);
