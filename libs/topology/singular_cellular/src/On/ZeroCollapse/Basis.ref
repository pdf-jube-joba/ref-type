\import \parent.Functional[] \as Functional;
\definition zero: N.Nat^ := N.Nat^::zero;
\definition degree: I.Int^ := I.Int^::ofNat zero;
\import \parent.\parent.Layer[n := zero] \as Layer;
\import Layer.Basis[] \as Basis;
\import singular_cellular_algebra.Algebra[].PointClass[A := Skeleton.Carrier, source := Skeleton.topology] \as Points;
\definition scalars: Modules.Family[AtZero.Index] := Modules.Family[AtZero.Index] {
  Carrier := \fun (_: AtZero.Index) => I.Int^,
  space := \fun (_: AtZero.Index) => Modules.scalarModule,
};
\import Modules.DirectSum[Index := AtZero.Index, family := scalars] \as Free;
\import Modules.Hom[V := Layer.Homology[z := degree].Carrier, W := I.Int^,
  source := Layer.Homology[z := degree].space, target := Modules.scalarModule]
  .Composition[U := Free.Carrier, domain := Free.space] \as Rows;
\module Characteristic(other: AtZero.Index, p: Euclidean.Disk (#dimension{other}));
\module Self;
\module Other(other: AtZero.Index, different: Logic.Not (other = cell));
\import Free.FiniteSupport[] \as Coordinates;
\import Free.To[W := I.Int^, target := Modules.scalarModule] \as Universal;
\definition row: Modules.Hom[V := Free.Carrier, W := I.Int^, source := Free.space, target := Modules.scalarModule].Map :=
  Rows.compose Functional.coordinate #forward{Basis.isomorphism};
\definition onInjection: \forall (other: AtZero.Index)(a: I.Int^) ->
  #apply{row} (#apply{Free.Injection[i := other].map} a) =
  #apply{Coordinates.At[i := cell].evaluate} (#apply{Free.Injection[i := other].map} a) :=
  \fun (other: AtZero.Index)(a: I.Int^) => Logic.orElim _ _ _ (Classical.excludedMiddle (other = cell))
    (\fun (same: other = cell) => \idelim cell = other \with i: AtZero.Index =>
      #apply{row} (#apply{Free.Injection[i := i].map} a) =
      #apply{Coordinates.At[i := cell].evaluate} (#apply{Free.Injection[i := i].map} a) \by {
        base: trans!{I.Int^} _ _ _ (Self[].onScalar a) (sym!{I.Int^} _ _ (Coordinates.atOwn cell a)),
        equality: sym!{AtZero.Index} _ _ same
      })
    (\fun (different: Logic.Not (other = cell)) => trans!{I.Int^} _ _ _
      (Other[other := other, different := different].onScalar a)
      (sym!{I.Int^} _ _ (Coordinates.atOther other cell a different)));
\definition rowEquation: row = Coordinates.At[i := cell].evaluate := Universal.ext _ _ onInjection;
\definition coefficient(q: Layer.Homology[z := degree].Carrier): I.Int^ :=
  #apply{Coordinates.At[i := cell].evaluate} (#apply{#backward{Basis.isomorphism}} q);
\definition coefficientLaw(q: Layer.Homology[z := degree].Carrier): #apply{Functional.coordinate} q = coefficient q :=
  trans!{I.Int^} _ _ _
    (sym!{I.Int^} _ _ (congr!{{Layer.Homology[z := degree].Carrier} I.Int^} (#apply{Functional.coordinate}) _ _ (#rightInverse{Basis.isomorphism} q)))
    (congr!{{Modules.Hom[V := Free.Carrier, W := I.Int^, source := Free.space, target := Modules.scalarModule].Map} I.Int^}
      (\fun (f: Modules.Hom[V := Free.Carrier, W := I.Int^, source := Free.space, target := Modules.scalarModule].Map) =>
        #apply{f} (#apply{#backward{Basis.isomorphism}} q)) _ _ rowEquation);

\import \parent.\parent.Filtration[].CellInteriors[n := N.Nat^::succ N.Nat^::zero] \as HigherCells;
\module Incidence(sourceCell: HigherCells.Index);
