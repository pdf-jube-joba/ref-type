\module At(limit: N.Nat^, z: I.Int^);
\definition homology(limit: N.Nat^)(z: I.Int^): \Set := At[limit := limit, z := z].Carrier;
\definition space(limit: N.Nat^)(z: I.Int^): Modules.Space (homology limit z) := At[limit := limit, z := z].space;
\definition Vanishing(limit, k: N.Nat^): \Prop := \forall (q: homology limit (I.Int^::ofNat k)) -> q = #zero{(space limit (I.Int^::ofNat k))};
\module Empty;
\module AboveStep(limit, k: N.Nat^);
\definition above: \forall (limit, k: N.Nat^) -> Nat.Le limit k -> Vanishing limit k :=
  \induction (limit: N.Nat^) \return \forall (k: N.Nat^) -> Nat.Le limit k -> Vanishing limit k \with {
    | zero: \fun (k: N.Nat^)(bound: _) => Empty[].zero (I.Int^::ofNat k)
    | succ: \fun (limit: N.Nat^)(previous: _)(k: N.Nat^)(bound: _) => AboveStep[limit := limit, k := k].zero
      (previous k (Nat.leTrans limit (N.Nat^::succ limit) k (Nat.leSelfSucc limit) bound)) bound
  };

\module Top(n: N.Nat^);
