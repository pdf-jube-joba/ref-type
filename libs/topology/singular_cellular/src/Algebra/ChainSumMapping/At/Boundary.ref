\definition point: \forall (x: Source.Term[z := z].Carrier)(i: Index) ->
  LowerTarget.coordinates (#apply{Target.complex.differential} z (#apply{map} x)) i =
  LowerTarget.coordinates (#apply{\parent.\parent.At[z := Degrees.previous z].map} (#apply{Source.complex.differential} z x)) i :=
  \fun (x: Source.Term[z := z].Carrier)(i: Index) => trans!{{(targetTerms i).family.Carrier (Degrees.previous z)}} _ _ _
    (Target.Step[z := z].coordinatesNatural (#apply{map} x) i)
    (trans!{{(targetTerms i).family.Carrier (Degrees.previous z)}} _ _ _
      (congr!{{(targetTerms i).family.Carrier z} {(targetTerms i).family.Carrier (Degrees.previous z)}} (#apply{(targetTerms i).differential} z) _ _ (coordinates x i))
      (trans!{{(targetTerms i).family.Carrier (Degrees.previous z)}} _ _ _
        (#commutes{(maps i)} z (SourceCoordinates.coordinates x i))
        (sym!{{(targetTerms i).family.Carrier (Degrees.previous z)}} _ _
          (trans!{{(targetTerms i).family.Carrier (Degrees.previous z)}} _ _ _
            (\parent.\parent.At[z := Degrees.previous z].coordinates (#apply{Source.complex.differential} z x) i)
            (congr!{{(sourceTerms i).family.Carrier (Degrees.previous z)} {(targetTerms i).family.Carrier (Degrees.previous z)}} (#apply{(maps i)} (Degrees.previous z)) _ _
              (Source.Step[z := z].coordinatesNatural x i))))));
\definition law: \forall (x: Source.Term[z := z].Carrier) ->
  #apply{Target.complex.differential} z (#apply{map} x) =
  #apply{\parent.\parent.At[z := Degrees.previous z].map} (#apply{Source.complex.differential} z x) :=
  \fun (x: Source.Term[z := z].Carrier) => LowerTarget.injective _ _
    (\axiom:funext(LowerTarget.coordinates (#apply{Target.complex.differential} z (#apply{map} x)),
      LowerTarget.coordinates (#apply{\parent.\parent.At[z := Degrees.previous z].map} (#apply{Source.complex.differential} z x)), point x));
