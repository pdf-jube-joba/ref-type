\import Cochains.Prior[C := complex] \as Prior;

\module Component(i: Index);
\definition onClass: \forall (x: Source.Closed) -> #apply{forward} (Source.classOf x) = #zero{Product.space} -> Source.classOf x = Source.zeroClass := \block {
  \fun (x: Source.Closed)(killed: _) \then
  \let Fibers: Index -> \Set := \fun (i: Index) => Component[i := i].Fiber x \then
  \takefrom selected: \forall (i: Index) -> Fibers i \by
    \axiom:classicalIndefiniteChoice(Index, Fibers, (\fun (i: Index) => Component[i := i].inhabited x killed)) \then
  \let g: \parent.\parent.Term[z := Degrees.previous z].Carrier := \fun (i: Index) => selected i \then
  \let bounds: #apply{Source.prior} g = x := \axiom:funext(#apply{Source.prior} g, x, \fun (i: Index) =>
    trans!{(terms i).family.Carrier z} _ _ _ (Component[i := i].coordinate g)
      (\bysub((terms i).family.Carrier (Degrees.previous z),
        { y: (terms i).family.Carrier (Degrees.previous z) \where
          #apply{Cochains.At[C := terms i, z := z].prior} y = x i }, selected i))) \then
  \return Source.boundaryClassZero x
    (Logic.existsIntro[\parent.\parent.Term[z := Degrees.previous z].Carrier, { y: \parent.\parent.Term[z := Degrees.previous z].Carrier \where #apply{Source.prior} y = x }] g bounds)
};
\definition zero: \forall (q: Source.Cohomology) -> #apply{forward} q = #zero{Product.space} -> q = Source.zeroClass :=
  Source.classInduction (\fun (q: Source.Cohomology) => #apply{forward} q = #zero{Product.space} -> q = Source.zeroClass) onClass;
