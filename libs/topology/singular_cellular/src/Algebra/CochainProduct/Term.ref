\definition family: Modules.Family[Index] := Modules.Family[Index] {
  Carrier := \fun (i: Index) => (terms i).family.Carrier z,
  space := \fun (i: Index) => (terms i).family.space z,
};
\import Modules.Product[Index := Index, family := family] \as Native;
\definition Carrier: \Set := Native.Carrier;
\definition space: Modules.Space Carrier := Native.space;
