\import Hom.Integer[P := terms i, N := coefficients] \as Native;
\import Cochains.Map[C := Source.complex, D := Native.complex].At[k := z] \as Action;
\definition map: Modules.Hom[V := Source.Carrier z, W := Native.Carrier z, source := Source.space z, target := Native.space z].Map :=
  Action.linear (\parent.\parent.Component[i := i].map);
