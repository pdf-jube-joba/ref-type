\import chain_complexes.Chain[] \as Degrees;
\import homological_algebra.Kunneth[].Integer[].ChainSum[Index := Index, terms := sourceTerms] \as Source;
\import homological_algebra.Kunneth[].Integer[].ChainSum[Index := Index, terms := targetTerms] \as Target;
\module At(z: I.Int^);
\definition map: Complexes.Map[C := Source.complex, D := Target.complex].Map := Complexes.Map[C := Source.complex, D := Target.complex].Map {
  apply := \fun (z: I.Int^) => #apply{At[z := z].map},
  addition := \fun (z: I.Int^) => #addition{At[z := z].map},
  scalar := \fun (z: I.Int^) => #scalar{At[z := z].map},
  commutes := \fun (z: I.Int^) => At[z := z].commutes,
};
