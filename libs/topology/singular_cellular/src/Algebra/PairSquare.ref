\import singular_cohomology.Relative[A := a.Carrier, source := a.topology, subset := a.subset] \as A;
\import singular_cohomology.Relative[A := b.Carrier, source := b.topology, subset := b.subset] \as B;
\import singular_cohomology.Relative[A := c.Carrier, source := c.topology, subset := c.subset] \as C;
\import singular_cohomology.Relative[A := d.Carrier, source := d.topology, subset := d.subset] \as D;
\import A.Maps[B := b.Carrier].Over[target := b.topology, targetSubset := b.subset] \as AB;
\import A.Maps[B := c.Carrier].Over[target := c.topology, targetSubset := c.subset] \as AC;
\import B.Maps[B := d.Carrier].Over[target := d.topology, targetSubset := d.subset] \as BD;
\import C.Maps[B := d.Carrier].Over[target := d.topology, targetSubset := d.subset] \as CD;
\import A.Maps[B := d.Carrier].Over[target := d.topology, targetSubset := d.subset] \as AD;
\module Along(f: AB.Map, g: AC.Map, h: BD.Map, k: CD.Map);
