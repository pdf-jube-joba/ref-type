\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Nat;
\import std.Data[].List[] \as Lists;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Logic.either;
\import algebraic_topology.CW[A := A] \as Cells;
\import algebraic_topology.Euclidean[] \as Euclidean;
\import topology.Topology[Carrier := A] \as Space;
\definition cells: Cells.Cells := #cells{complex};
\definition laws: Cells.ComplexLaws[source, complex] := Cells.laws source complex;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import chain_complexes.Chain[] \as Degrees;
\import Degrees.Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\module CellProperties(cell: Cells.CellData, member: Cells.CellMember cells cell);
\module Filtration;
\module Layer(n: N.Nat^);
\module Cellular;
\module Universal(B: \Set, target: topology.Topology[Carrier := B].Topology);
