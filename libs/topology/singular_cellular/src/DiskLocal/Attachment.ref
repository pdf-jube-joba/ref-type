\import singular_cellular_algebra.Algebra[] \as Algebra;
\import Algebra.Neighborhood[pair := neighborhood] \as SourceNeighborhood;
\import Algebra.Neighborhood[pair := pair] \as TargetNeighborhood;
\import Algebra.ExcisionChart[a := SourceNeighborhood.excisive, b := TargetNeighborhood.excisive] \as Excision;
\import singular_cohomology.Relative[A := pair.base.Carrier, source := pair.base.topology, subset := pair.base.subset] \as Target;
\import singular_cohomology.Relative[A := pair.base.Carrier, source := pair.base.topology, subset := pair.region] \as TargetExpanded;
\import Original.Maps[B := pair.base.Carrier].Over[target := pair.base.topology, targetSubset := pair.base.subset] \as Maps;
\import Expanded.Maps[B := pair.base.Carrier].Over[target := pair.base.topology, targetSubset := pair.region] \as ExpandedMaps;
\import singular_cohomology.Relative[A := Excision.sourceSmall.Carrier, source := Excision.sourceSmall.topology, subset := Excision.sourceSmall.subset]
  .Homeomorphism[B := Excision.targetSmall.Carrier].Over[target := Excision.targetSmall.topology, targetSubset := Excision.targetSmall.subset] \as Charts;
\structure Data: \Set {
  characteristic: Maps.Map,
  punctured: \forall (p: Collar.Carrier) -> \In[pair.base.Carrier] pair.region (characteristic p),
  chart: Charts.Data,
  agrees: \forall (p: Excision.sourceSmall.Carrier) -> #forward{#homeomorphism{chart}} p = characteristic p,
}
\module On(data: Data);
