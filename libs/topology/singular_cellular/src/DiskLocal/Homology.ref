\definition neighborhood: Modules.Isomorphism[V := Original.Homology[z := z].Carrier, W := Expanded.Homology[z := z].Carrier,
  source := Original.Homology[z := z].space, target := Expanded.Homology[z := z].space].Isomorphism :=
  Action.Comparison[].At[z := z].isomorphism subspaceQuasi wholeQuasi;
\definition excision: Modules.Isomorphism[V := Excised.Homology[z := z].Carrier, W := Expanded.Homology[z := z].Carrier,
  source := Excised.Homology[z := z].space, target := Expanded.Homology[z := z].space].Isomorphism :=
  Excision.Homology[z := z].isomorphism pair;
\import Modules.Isomorphism[V := Excised.Homology[z := z].Carrier, W := Expanded.Homology[z := z].Carrier,
  source := Excised.Homology[z := z].space, target := Expanded.Homology[z := z].space].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := Original.Homology[z := z].Carrier, W := Expanded.Homology[z := z].Carrier,
  source := Original.Homology[z := z].space, target := Expanded.Homology[z := z].space]
  .Composition[U := Excised.Homology[z := z].Carrier, final := Excised.Homology[z := z].space] \as Composition;
\definition excisedIsomorphism: Modules.Isomorphism[V := Original.Homology[z := z].Carrier, W := Excised.Homology[z := z].Carrier,
  source := Original.Homology[z := z].space, target := Excised.Homology[z := z].space].Isomorphism :=
  Composition.compose (Inverse.inverse excision) neighborhood;
\import Modules.Isomorphism[V := Original.Homology[z := z].Carrier, W := Excised.Homology[z := z].Carrier,
  source := Original.Homology[z := z].space, target := Excised.Homology[z := z].space]
  .Composition[U := Local.Homology[z := z].Carrier, final := Local.Homology[z := z].space] \as LocalComposition;
\definition isomorphism: Modules.Isomorphism[V := Original.Homology[z := z].Carrier, W := Local.Homology[z := z].Carrier,
  source := Original.Homology[z := z].space, target := Local.Homology[z := z].space].Isomorphism :=
  LocalComposition.compose (\parent.Identification[].Homology[z := z].isomorphism) excisedIsomorphism;
