\definition expandedSource: Modules.Bundle := Modules.Bundle { Carrier := TargetExpanded.With[coefficients := coefficients].At[z := z].Carrier, space := TargetExpanded.With[coefficients := coefficients].At[z := z].space };
\definition expandedTarget: Modules.Bundle := Modules.Bundle { Carrier := Expanded.With[coefficients := coefficients].At[z := z].Carrier, space := Expanded.With[coefficients := coefficients].At[z := z].space };
\definition originalSource: Modules.Bundle := Modules.Bundle { Carrier := Target.With[coefficients := coefficients].At[z := z].Carrier, space := Target.With[coefficients := coefficients].At[z := z].space };
\definition originalTarget: Modules.Bundle := Modules.Bundle { Carrier := Original.With[coefficients := coefficients].At[z := z].Carrier, space := Original.With[coefficients := coefficients].At[z := z].space };
\import Modules.IsomorphismSquare[A := expandedSource, B := expandedTarget, C := originalSource, D := originalTarget] \as Transport;
\definition isomorphism: Modules.Isomorphism[V := originalSource.Carrier, W := originalTarget.Carrier, source := originalSource.space, target := originalTarget.space].Isomorphism :=
  Transport.transport (TargetNeighborhood.With[coefficients := coefficients].At[z := z].isomorphism)
    (SourceNeighborhood.With[coefficients := coefficients].At[z := z].isomorphism)
    (ExpandedComparison.With[coefficients := coefficients].At[z := z].isomorphism data.agrees) Action.With[coefficients := coefficients].At[z := z].induced
    (Square.With[coefficients := coefficients].At[z := z].law commutes);
