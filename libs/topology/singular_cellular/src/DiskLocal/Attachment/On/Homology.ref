\definition expandedSource: Modules.Bundle := Modules.Bundle { Carrier := Expanded.Homology[z := z].Carrier, space := Expanded.Homology[z := z].space };
\definition expandedTarget: Modules.Bundle := Modules.Bundle { Carrier := TargetExpanded.Homology[z := z].Carrier, space := TargetExpanded.Homology[z := z].space };
\definition originalSource: Modules.Bundle := Modules.Bundle { Carrier := Original.Homology[z := z].Carrier, space := Original.Homology[z := z].space };
\definition originalTarget: Modules.Bundle := Modules.Bundle { Carrier := Target.Homology[z := z].Carrier, space := Target.Homology[z := z].space };
\import Modules.IsomorphismSquare[A := expandedSource, B := expandedTarget, C := originalSource, D := originalTarget] \as Transport;
\definition isomorphism: Modules.Isomorphism[V := originalSource.Carrier, W := originalTarget.Carrier, source := originalSource.space, target := originalTarget.space].Isomorphism :=
  Transport.incoming (SourceNeighborhood.Homology[z := z].isomorphism) (TargetNeighborhood.Homology[z := z].isomorphism)
    (ExpandedComparison.Homology[z := z].isomorphism data.agrees) Action.At[z := z].induced
    (Square.Homology[z := z].law commutes);
