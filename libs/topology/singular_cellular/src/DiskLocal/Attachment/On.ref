\definition expandedMap: ExpandedMaps.Map := \into[Model.Disk -> pair.base.Carrier](data.characteristic, ExpandedMaps.Map) \by {
  ExpandedMaps.Laws[data.characteristic] {
    continuous := #continuous{(Maps.laws data.characteristic)},
    contained := data.punctured,
  }
};
\import Excision.Along[f := expandedMap, chart := data.chart] \as ExpandedComparison;
\definition sourceBase: Algebra.SpacePair := Algebra.SpacePair { Carrier := neighborhood.base.Carrier, topology := neighborhood.base.topology, subset := neighborhood.base.subset };
\definition targetBase: Algebra.SpacePair := Algebra.SpacePair { Carrier := pair.base.Carrier, topology := pair.base.topology, subset := pair.base.subset };
\definition sourceExpanded: Algebra.SpacePair := Algebra.SpacePair { Carrier := neighborhood.base.Carrier, topology := neighborhood.base.topology, subset := neighborhood.region };
\definition targetExpanded: Algebra.SpacePair := Algebra.SpacePair { Carrier := pair.base.Carrier, topology := pair.base.topology, subset := pair.region };
\import Algebra.PairSquare[a := sourceBase, b := targetBase, c := sourceExpanded, d := targetExpanded]
  .Along[f := data.characteristic, g := SourceNeighborhood.map, h := TargetNeighborhood.map, k := expandedMap] \as Square;
\definition commutes: Square.Commutes := \fun (p: Model.Disk) => \refl(data.characteristic p);
\import Maps.On[f := data.characteristic].Integer[] \as Action;
\module Homology(z: I.Int^);
\module With(coefficients: Modules.Bundle);
