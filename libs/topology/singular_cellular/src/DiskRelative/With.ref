\definition degree: I.Int^ := I.Int^::ofNat (N.Nat^::succ n);
\definition boundaryDegree: I.Int^ := I.Int^::ofNat n;
\import Sphere.With[coefficients := coefficients].At[z := boundaryDegree] \as SphereH;
\import NestedSphere.With[coefficients := coefficients].At[z := boundaryDegree] \as BoundaryH;
\definition Carrier: \Set := Pair.With[coefficients := coefficients].At[z := degree].Carrier;
\definition space: Modules.Space Carrier := Pair.With[coefficients := coefficients].At[z := degree].space;
\import Pair.Reduced[].With[coefficients := coefficients].ConnectingContractible[].At[z := boundaryDegree] \as Connecting;
\definition connecting: Modules.Isomorphism[V := BoundaryH.Carrier, W := Carrier, source := BoundaryH.space, target := space].Isomorphism :=
  Connecting.isomorphism (Model.Contraction[].contraction);
\import cohomology_models.Spheres[].With[coefficients := coefficients].Reduced[] \as Groups;
\import Modules.Isomorphism[V := coefficients.Carrier, W := SphereH.Carrier, source := coefficients.space, target := SphereH.space]
  .Composition[U := BoundaryH.Carrier, final := BoundaryH.space] \as First;
\definition boundaryOrientation: Modules.Isomorphism[V := coefficients.Carrier, W := BoundaryH.Carrier, source := coefficients.space, target := BoundaryH.space].Isomorphism :=
  First.compose (BoundaryComparison.With[coefficients := coefficients].At[z := boundaryDegree].isomorphism equivalence) (Groups.top n);
\import Modules.Isomorphism[V := coefficients.Carrier, W := BoundaryH.Carrier, source := coefficients.space, target := BoundaryH.space]
  .Composition[U := Carrier, final := space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := coefficients.Carrier, W := Carrier, source := coefficients.space, target := space].Isomorphism :=
  Composition.compose connecting boundaryOrientation;
