\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import algebraic_topology.Collapse[A := Disk.Disk, subset := { p: Disk.Disk \where Disk.normSquared p = Real.one }] \as Collapse;
\import \parent.Orientation[point := point] \as Source;
\import sphere_maps.Reflection[n := N.Nat^::succ n] \as Reflection;
\definition reflection: topology.Homeomorphism[A := Ambient.Sphere, B := Ambient.Sphere]
  .Homeomorphism[Ambient.sphereTopology, Ambient.sphereTopology] :=
  topology.Homeomorphism[A := Ambient.Sphere, B := Ambient.Sphere].Homeomorphism[Ambient.sphereTopology, Ambient.sphereTopology] {
    forward := Reflection.head, backward := Reflection.head,
    leftInverse := Reflection.headInvolution, rightInverse := Reflection.headInvolution,
    forwardContinuous := Reflection.headContinuous, backwardContinuous := Reflection.headContinuous,
  };
\import singular_finite_algebra.Integer[].Orientation[A := Collapse.Carrier, B := Ambient.Sphere,
  source := Collapse.topology Disk.diskTopology, target := Ambient.sphereTopology, z := I.Int^::ofNat (N.Nat^::succ n)] \as Orientation;
\import cohomology_models.Spheres[].Homology[].Top[n := n] \as Target;
\import Orientation.Normalize[homeomorphism := \parent.Quotient[].homeomorphism, reflection := reflection,
  sourceOrientation := Source.orientation, targetOrientation := Target.isomorphism] \as Normalize;
\definition Result: \Set := Normalize.Result;
\definition existence: \exists Result := Normalize.existence (sphere_maps.Hemispheres[n := n].Homology[].Whole[].head);
\definition onGenerator(h: Result): #apply{(Orientation.action h)} Source.generator = #apply{#forward{Target.isomorphism}} I.One.specification :=
  \bysub(topology.Homeomorphism[A := Collapse.Carrier, B := Ambient.Sphere].Homeomorphism[Collapse.topology Disk.diskTopology, Ambient.sphereTopology], Normalize.Positive, h);
