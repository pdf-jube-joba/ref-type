\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import \root.DiskRelative[n := n] \as RelativeDisk;
\import \root.DiskLocal[n := N.Nat^::succ n] \as Local;
\definition boundaryPoint: topology.Topology[Carrier := Disk.Disk].Subspace[S := Local.boundary].CarrierSet :=
  #forward{RelativeDisk.homeomorphism} point;
\import \root.DiskLocal[n := N.Nat^::succ n].GoodPair[point := boundaryPoint] \as GoodPair;
\import algebraic_topology.Collapse[A := Disk.Disk, subset := Local.boundary] \as Collapse;
\import singular_cohomology.Chains[A := Collapse.Carrier, source := Collapse.topology Disk.diskTopology] \as QuotientChains;
\import Native.ZeroExtension[C := QuotientChains.complex] \as Extension;
\definition degree: I.Int^ := I.Int^::ofNat (N.Nat^::succ n);
\import Chains.At[C := Extension.complex, z := degree] \as H;
\import QuotientChains.Reduced[] \as Reduced;
\import Reduced.Positive[n := n] \as Positive;
\import singular_excision.GoodPair[A := Disk.Disk, source := Disk.diskTopology, subset := Local.boundary].On[pair := GoodPair.pair]
  .Homology[z := degree] \as CollapseComparison;
\definition Carrier: \Set := H.Homology;
\definition space: Modules.Space Carrier := H.homologySpace;
\definition fromRelative: Modules.Isomorphism[V := RelativeDisk.Homology[].Carrier, W := Carrier,
  source := RelativeDisk.Homology[].space, target := space].Isomorphism :=
  Modules.Isomorphism[V := RelativeDisk.Homology[].Carrier, W := Reduced.At[z := degree].Carrier,
    source := RelativeDisk.Homology[].space, target := Reduced.At[z := degree].space]
    .Composition[U := Carrier, final := space].compose Positive.isomorphism CollapseComparison.isomorphism;
\definition orientation: Modules.Isomorphism[V := I.Int^, W := Carrier, source := Modules.scalarModule, target := space].Isomorphism :=
  Modules.Isomorphism[V := I.Int^, W := RelativeDisk.Homology[].Carrier, source := Modules.scalarModule, target := RelativeDisk.Homology[].space]
    .Composition[U := Carrier, final := space].compose fromRelative (RelativeDisk.Homology[].orientation);
\definition generator: Carrier := #apply{#forward{orientation}} I.One.specification;
\definition onRelativeGenerator: #apply{#forward{fromRelative}} (RelativeDisk.Homology[].generator) = generator := \refl(generator);
