\import singular_cohomology.Chains[A := Model.Disk, source := Model.diskTopology] \as Whole;
\import singular_cohomology.Simplices[A := Model.Disk, source := Model.diskTopology] \as Simplices;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import Native.ZeroExtension[C := Whole.complex] \as WholeExtension;
\import singular_cohomology.Relative[A := Model.Disk, source := Model.diskTopology, subset := Disk.boundary] \as Pair;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import Chains.At[C := Pair.complex, z := degree] \as H;
\import singular_cellular_algebra.Algebra[].RelativeSplit[A := Model.Disk, source := Model.diskTopology, subset := Disk.boundary] \as Splitting;
\definition chain: Whole.Carrier N.Nat^::zero := Whole.generator N.Nat^::zero (Simplices.At[n := N.Nat^::zero].constant p);
\definition relative: Pair.Carrier degree := Pair.class degree (WholeExtension.Positive[n := N.Nat^::zero].intro chain);
\definition cycle: H.Cycle := H.cycle relative (Splitting.Negative[n := N.Nat^::zero].zero (#apply{Pair.complex.differential} degree relative));
\definition class: H.Homology := H.classOf cycle;
