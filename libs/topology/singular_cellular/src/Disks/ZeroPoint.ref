\module At(d: N.Nat^);
\definition onGenerator(same: n = N.Nat^::zero): At[d := n].Property :=
  \idelim N.Nat^::zero = n \with d: N.Nat^ => At[d := d].Property \by {
    base: \fun (e: N.Nat^::zero = N.Nat^::zero)(p: algebraic_topology.Euclidean[].Dimension[n := N.Nat^::zero].Disk) =>
      trans!{{\parent.At[n := N.Nat^::zero].Homology[z := I.Int^::ofNat N.Nat^::zero].Carrier}} _ _ _
        (congr!{{At[d := N.Nat^::zero].Iso} {\parent.At[n := N.Nat^::zero].Homology[z := I.Int^::ofNat N.Nat^::zero].Carrier}}
          (\fun (orientation: At[d := N.Nat^::zero].Iso) => #apply{#forward{orientation}} I.One.specification) _ _
          (\transporteq N.Nat^::zero \with k: N.Nat^ =>
            Modules.Isomorphism[V := I.Int^, W := \parent.At[n := N.Nat^::zero].Homology[z := I.Int^::ofNat k].Carrier,
              source := Modules.scalarModule, target := \parent.At[n := N.Nat^::zero].Homology[z := I.Int^::ofNat k].space].Isomorphism
            \by { base: \parent.Zero[].orientation }))
        (\parent.Zero[].Point[p := p].onGenerator),
    equality: sym!{N.Nat^} _ _ same
  };
