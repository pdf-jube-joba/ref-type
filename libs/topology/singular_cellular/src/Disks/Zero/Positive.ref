\definition degree: I.Int^ := I.Int^::ofNat (N.Nat^::succ k);
\import Pair.Reduced[].ConnectingContractible[].Homology[z := degree] \as Connecting;
\import BoundaryChains.At[z := I.Int^::ofNat k] \as H;
\import Modules.Isomorphism[V := Pair.Homology[z := degree].Carrier, W := H.Carrier,
  source := Pair.Homology[z := degree].space, target := H.space].Vanishing[] \as TransportVanishing;
\import singular_cohomology.Calculations[A := Boundary.CarrierSet, source := Boundary.topology Model.diskTopology].ReducedEmpty[].Homology[] \as Empty;
\definition zero: \forall (q: Pair.Homology[z := degree].Carrier) -> q = (Pair.Homology[z := degree].space).zero :=
  TransportVanishing.sourceZero (Connecting.isomorphism (Model.Contraction[].contraction)) (Empty.Positive[n := k].zero empty);
