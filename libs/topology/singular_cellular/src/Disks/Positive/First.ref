\definition degree: I.Int^ := I.Int^::ofNat N.Nat^::zero;
\definition previous: I.Int^ := I.Int^::negSucc N.Nat^::zero;
\import Modules.Isomorphism[V := Groups.homology n previous, W := Disk.Homology[z := degree].Carrier,
  source := Groups.space n previous, target := Disk.Homology[z := degree].space].Vanishing[] \as Transport;
\definition zero: \forall (q: Disk.Homology[z := degree].Carrier) -> q = #zero{(Disk.Homology[z := degree].space)} :=
  Transport.targetZero (Native.Degree[z := degree].isomorphism) (Groups.negative n N.Nat^::zero);
