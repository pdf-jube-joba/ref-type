\import cohomology_models.SphereCover[n := n].Homology[z := I.Int^::ofNat (N.Nat^::succ k)] \as Shift;
\import Modules.Isomorphism[V := Groups.homology n (I.Int^::ofNat k), W := Groups.homology (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ k)),
  source := Groups.space n (I.Int^::ofNat k), target := Groups.space (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ k))].Vanishing[] \as Vanishing;
\definition zero: Zero n k -> Zero (N.Nat^::succ n) (N.Nat^::succ k) := Vanishing.targetZero Shift.upward;
