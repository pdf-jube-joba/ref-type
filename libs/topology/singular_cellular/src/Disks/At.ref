\import algebraic_topology.Euclidean[].Dimension[n := n] \as Model;
\import real.Analysis[] \as Real;
\definition boundary: \Pow Model.Disk := { p: Model.Disk \where Model.normSquared p = Real.one };
\import singular_cohomology.Relative[A := Model.Disk, source := Model.diskTopology, subset := boundary] \as Pair;
\definition complex: _ := Pair.complex;

\module Homology(z: I.Int^);
