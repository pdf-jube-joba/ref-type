\import algebraic_topology.Homotopy[A := Carrier, B := Carrier] \as Homotopies;
\import algebraic_topology.Cylinder[A := Carrier] \as Cylinder;
\import \parent.Continuity[] \as Continuous;
\import \parent.Endpoints[] \as Endpoints;
\definition boundary: \Pow Carrier := { p: Carrier \where Model.normSquared p = Real.one };
\import topology.Topology[Carrier := Carrier].Subspace[S := boundary] \as Boundary;
\definition endpoint[p: Carrier]: Carrier := value Interval.end p;
\definition homotopy: Homotopies.Homotopy[topology, topology, (\fun (p: Carrier) => p), endpoint] :=
  \into[Homotopies.Family](Continuous.family, Homotopies.Homotopy[topology, topology, (\fun (p: Carrier) => p), endpoint]) \by {
    Homotopies.Laws[topology, topology, (\fun (p: Carrier) => p), endpoint, Continuous.family] {
      continuous := Continuous.continuous,
      start := Endpoints.atStart,
      end := \fun (p: Carrier) => \refl(endpoint p),
    }
  };
\definition relativeHomotopy: Homotopies.RelativeHomotopy[topology, topology, boundary, (\fun (p: Carrier) => p), endpoint] :=
  \into[Homotopies.Family](homotopy, Homotopies.RelativeHomotopy[topology, topology, boundary, (\fun (p: Carrier) => p), endpoint]) \by {
    Homotopies.RelativeLaws[topology, topology, boundary, (\fun (p: Carrier) => p), endpoint, homotopy] {
      homotopy := Homotopies.laws topology topology (\fun (p: Carrier) => p) endpoint homotopy,
      fixed := \fun (t: Interval.Carrier)(p: Carrier)(onBoundary: _) => Endpoints.fixesBoundary t p onBoundary,
    }
  };
\definition retraction[p: Carrier]: Boundary.CarrierSet := \into[Carrier](endpoint p, boundary) \by { Endpoints.endOnSphere p };
\import topology.Continuity[A := Carrier, B := Carrier].Corestriction[S := boundary] \as Into;
\definition retractionContinuous: topology.Continuity[A := Carrier, B := Boundary.CarrierSet].Continuous topology (Boundary.topology topology) retraction :=
  Into.corestrictContinuous topology topology retraction (Homotopies.endContinuous topology topology (\fun (p: Carrier) => p) endpoint homotopy);
\import algebraic_topology.DeformationRetract[A := Carrier, source := topology, subset := boundary] \as Deformations;
\definition deformation: Deformations.Data := Deformations.Data {
  retraction := retraction,
  continuous := retractionContinuous,
  retracts := \fun (p: Boundary.CarrierSet) => Endpoints.fixesBoundary Interval.end p (\bysub(Carrier, boundary, p)),
  homotopy := relativeHomotopy,
};
