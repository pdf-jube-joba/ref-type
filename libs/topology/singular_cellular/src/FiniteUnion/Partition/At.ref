\definition other(d: C): \Pow A := { x: A \where Logic.And[Logic.Not (d = c), Space.Member (pieces d) x] };
\import \root.FiniteUnion[A := A, C := C, source := source, pieces := other] \as Others;
\definition otherClosed: \forall (d: C) -> Member family d -> Space.IsClosedIn source (other d) :=
  \fun (d: C)(present: _) => either!{{(Classical.excludedMiddle (d = c))} {Space.IsClosedIn source (other d)}
    {\fun (same: d = c) => \idelim Space.Empty = other d \with S: \Pow A => Space.IsClosedIn source S \by {
      base: emptyClosed,
      equality: \axiom:setext(Space.Empty, other d,
        \fun (x: A)(impossible: Logic.False) => Logic.falseElim _ impossible,
        \fun (x: A)(inside: Space.Member (other d) x) => (#left{inside}) same)
    }}
    {\fun (different: _) => \idelim pieces d = other d \with S: \Pow A => Space.IsClosedIn source S \by {
      base: #closed{laws} d present,
      equality: \axiom:setext(pieces d, other d,
        \fun (x: A)(inside: Space.Member (pieces d) x) => Logic.And[_, _]::# different inside,
        \fun (x: A)(inside: Space.Member (other d) x) => #right{inside})
    }}
  };
\definition equality: pieces c = Space.Complement (Others.union family) :=
  \axiom:setext(pieces c, Space.Complement (Others.union family),
    \fun (x: A)(inside: Space.Member (pieces c) x)(outside: Space.Member (Others.union family) x) =>
      Others.eliminate family x Logic.False
        (\fun (d: C)(present: _)(other: Space.Member (other d) x) =>
          #disjoint{laws} d c present member (#left{other}) x (#right{other}) inside) outside,
    \fun (x: A)(outside: Space.Member (Space.Complement (Others.union family)) x) =>
      eliminate family x (Space.Member (pieces c) x)
        (\fun (d: C)(present: _)(inside: Space.Member (pieces d) x) => either!{{(Classical.excludedMiddle (d = c))} {Space.Member (pieces c) x}
          {\fun (same: d = c) => \idelim d = c \with e: C => Space.Member (pieces e) x \by { base: inside, equality: same }}
          {\fun (different: _) => Logic.falseElim _ (outside (Others.include family d present x (Logic.And[_, _]::# different inside)))}
        }) (#covers{laws} x (\refl(x))));
\definition open: Space.IsOpenIn source (pieces c) :=
  \idelim Space.Complement (Others.union family) = pieces c \with S: \Pow A => Space.IsOpenIn source S \by {
    base: Others.closed family otherClosed,
    equality: sym!{{\Pow A}} _ _ equality
  };
