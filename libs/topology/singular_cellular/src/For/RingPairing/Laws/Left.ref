\import Abelian.Scalar[a := #apply{beta} y] \as Scalar;
\definition addition(x1, x2: P.family.Carrier p): value alpha beta (#add{(P.family.space p)} x1 x2) y = #add{integerCoefficients.space} (value alpha beta x1 y) (value alpha beta x2 y) :=
  trans!{R} _ _ _
    (congr!{R R} (#mul{baseRing} (#apply{beta} y)) _ _ (#addition{alpha} x1 x2))
    (#addition{Scalar.map} (#apply{alpha} x1) (#apply{alpha} x2));
\definition scalar(a: I.Int^): value alpha beta (#smul{(P.family.space p)} a x) y = #smul{integerCoefficients.space} a (value alpha beta x y) :=
  trans!{R} _ _ _
    (congr!{R R} (#mul{baseRing} (#apply{beta} y)) _ _ (#scalar{alpha} a x))
    (#scalar{Scalar.map} a (#apply{alpha} x));
