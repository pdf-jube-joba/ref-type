\import Abelian.Scalar[a := (beta).apply y] \as Scalar;
\definition addition[x1, x2: P.family.Carrier p]: value alpha beta ((P.family.space p).add x1 x2) y = (integerCoefficients.space).add (value alpha beta x1 y) (value alpha beta x2 y) :=
  trans!{R} _ _ _
    (congr!{R R} ((baseRing).mul ((beta).apply y)) _ _ ((alpha).addition x1 x2))
    ((Scalar.map).addition ((alpha).apply x1) ((alpha).apply x2));
\definition scalar[a: I.Int^]: value alpha beta ((P.family.space p).smul a x) y = (integerCoefficients.space).smul a (value alpha beta x y) :=
  trans!{R} _ _ _
    (congr!{R R} ((baseRing).mul ((beta).apply y)) _ _ ((alpha).scalar a x))
    ((Scalar.map).scalar a ((alpha).apply x));
