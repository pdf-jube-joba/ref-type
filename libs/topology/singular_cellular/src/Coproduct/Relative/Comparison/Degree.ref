\definition positive: I.Int^ := I.Int^::ofNat n;
\definition negative: I.Int^ := I.Int^::negSucc n;
\import Modules.DirectSum[Index := Index, family := Right.Term[z := positive].family] \as Sum;
\definition projective: Modules.Projective (Modules.Bundle { Carrier := Right.Term[z := positive].Carrier, space := Right.Term[z := positive].space }) :=
  Sum.projective (\fun (i: Index) => \parent.\parent.\parent.RelativeComponent[subset := subset, i := i].projective positive);
\import Modules.DirectSum[Index := Index, family := Right.Term[z := negative].family].FiniteSupport[] \as Coordinates;
\import Modules.Product[Index := Index, family := Right.Term[z := negative].family] \as Product;
\definition zeroBelow: \forall (x: Right.Term[z := negative].Carrier) -> x = #zero{(Right.Term[z := negative].space)} :=
  \fun (x: Right.Term[z := negative].Carrier) => Coordinates.injective _ _
    (trans!{Product.Carrier} _ _ _
      (\axiom:funext(Coordinates.coordinates x, Product.zero,
        \fun (i: Index) => \parent.\parent.\parent.RelativeComponent[subset := subset, i := i].zeroBelow n (Coordinates.coordinates x i)))
      (sym!{Product.Carrier} _ _ Coordinates.coordinatesZero));
