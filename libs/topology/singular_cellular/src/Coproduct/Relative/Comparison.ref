\import singular_finite_algebra.Integer[].ProjectiveCone[P := Right.complex, Q := Pair.complex].On[f := map] \as Bridge;
\module Degree(n: N.Nat^);
\import \root.Algebra[].RelativeSplit[A := Carrier, source := topology, subset := subset] \as Target;
\definition sourceProjective: Bridge.SourceProjective := \fun (n: N.Nat^) => Degree[n := n].projective;
\definition targetProjective: Bridge.TargetProjective := \fun (n: N.Nat^) => Target.projective (I.Int^::ofNat n);
\definition sourceNegative: Bridge.SourceNegative := \fun (n: N.Nat^) => Degree[n := n].zeroBelow;
\definition targetNegative: Bridge.TargetNegative := Target.zeroBelow;
\import Complexes.Equivalence[C := Right.complex, D := Pair.complex] \as Equivalences;
\definition equivalenceExists: \exists { e: Equivalences.Equivalence \where #forward{e} = map } :=
  Bridge.equivalenceExists sourceProjective targetProjective sourceNegative targetNegative quasiIsomorphism;
