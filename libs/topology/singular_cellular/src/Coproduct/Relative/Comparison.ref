\import singular_finite_algebra.Integer[].ProjectiveCone[P := Right.complex, Q := Pair.complex].On[f := map] \as Bridge;
\module Degree(n: N.Nat^);
\import singular_cellular_algebra.Algebra[].RelativeSplit[A := Carrier, source := topology, subset := subset] \as Target;
\definition sourceProjective: \forall (n: N.Nat^) -> Modules.Projective (Modules.Bundle { Carrier := Right.complex.family.Carrier (I.Int^::ofNat n), space := Right.complex.family.space (I.Int^::ofNat n) }) := \fun (n: N.Nat^) => Degree[n := n].projective;
\definition targetProjective: \forall (n: N.Nat^) -> Modules.Projective (Modules.Bundle { Carrier := Pair.complex.family.Carrier (I.Int^::ofNat n), space := Pair.complex.family.space (I.Int^::ofNat n) }) := \fun (n: N.Nat^) => Target.projective (I.Int^::ofNat n);
\definition sourceNegative: \forall (n: N.Nat^)(x: Right.complex.family.Carrier (I.Int^::negSucc n)) -> x = #zero{(Right.complex.family.space (I.Int^::negSucc n))} := \fun (n: N.Nat^) => Degree[n := n].zeroBelow;
\definition targetNegative: \forall (n: N.Nat^)(x: Pair.complex.family.Carrier (I.Int^::negSucc n)) -> x = #zero{(Pair.complex.family.space (I.Int^::negSucc n))} := Target.zeroBelow;
\import Complexes.Equivalence[C := Right.complex, D := Pair.complex] \as Equivalences;
\definition equivalenceExists: \exists { e: Equivalences.Equivalence \where #forward{e} = map } :=
  Bridge.equivalenceExists sourceProjective targetProjective sourceNegative targetNegative quasiIsomorphism;
