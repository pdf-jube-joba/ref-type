\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Integer[P := Pair.complex, N := coefficients] \as Source;
\import Hom.Integer[P := Right.complex, N := coefficients] \as SumHom;
\import Hom.IntegerHomotopy[P := Right.complex, Q := Pair.complex, N := coefficients] \as Pull;
\import Hom.IntegerEquivalence[P := Right.complex, Q := Pair.complex, N := coefficients] \as Invariance;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\definition pullback: Cochains.Map[C := Source.complex, D := SumHom.complex].Map := Pull.map map;
\definition quasiIsomorphism: Cochains.Map[C := Source.complex, D := SumHom.complex].QuasiIsomorphism pullback := \block {
  \takefrom e: \Cast[Complexes.Equivalence[C := Right.complex, D := Pair.complex].Equivalence]
    ({ e: Complexes.Equivalence[C := Right.complex, D := Pair.complex].Equivalence \where #forward{e} = map })
    \by \parent.Comparison[].equivalenceExists \then
  \return \idelim #forward{e} = map \with f: Complexes.Map[C := Right.complex, D := Pair.complex].Map =>
    Cochains.Map[C := Source.complex, D := SumHom.complex].QuasiIsomorphism (Pull.map f) \by {
      base: Invariance.quasiIsomorphism e,
      equality: \bysub(Complexes.Equivalence[C := Right.complex, D := Pair.complex].Equivalence,
        { e: Complexes.Equivalence[C := Right.complex, D := Pair.complex].Equivalence \where #forward{e} = map }, e) }
};
\import \root.Algebra[].SumCochains[Index := Index, terms := rightTerms, coefficients := coefficients] \as Components;
\module At(z: I.Int^);
