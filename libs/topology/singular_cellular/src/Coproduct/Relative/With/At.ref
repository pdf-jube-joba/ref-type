\import Cochains.At[C := Source.complex, z := z] \as SourceH;
\import Cochains.At[C := SumHom.complex, z := z] \as SumH;
\import Cochains.Map[C := Source.complex, D := SumHom.complex].At[k := z].Invert[f := pullback] \as Inverse;
\definition comparison: Modules.Isomorphism[V := SourceH.Cohomology, W := SumH.Cohomology,
  source := SourceH.cohomologySpace, target := SumH.cohomologySpace].Isomorphism := Inverse.isomorphism (quasiIsomorphism z);
\definition family: Modules.Family[Index] := Components.At[z := z].componentFamily;
\import Modules.Product[Index := Index, family := family] \as Product;
\import Modules.Isomorphism[V := SourceH.Cohomology, W := SumH.Cohomology, source := SourceH.cohomologySpace, target := SumH.cohomologySpace]
  .Composition[U := Product.Carrier, final := Product.space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Pair.With[coefficients := coefficients].At[z := z].Carrier, W := Product.Carrier,
  source := Pair.With[coefficients := coefficients].At[z := z].space, target := Product.space].Isomorphism :=
  Composition.compose (Components.At[z := z].isomorphism) comparison;
