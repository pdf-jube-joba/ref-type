\import singular_cellular_algebra.Algebra[].ChainSumMapping[Index := Index, sourceTerms := leftTerms, targetTerms := middleTerms, maps := Sums.inclusions].At[z := z] \as Inclusion;
\import singular_cellular_algebra.Algebra[].ChainSumMapping[Index := Index, sourceTerms := middleTerms, targetTerms := rightTerms, maps := Sums.projections].At[z := z] \as Projection;
\import Modules.Hom[V := Left.Term[z := z].Carrier, W := WholeExtension.Carrier z,
  source := Left.Term[z := z].space, target := WholeExtension.space z] \as LeftMaps;
\definition leftFirst: LeftMaps.Map := LeftMaps.Map {
  apply := \fun (x: Left.Term[z := z].Carrier) => #apply{ambientMap} z (#apply{Exact.sequence.inclusion} z x),
  addition := \fun (x, y: Left.Term[z := z].Carrier) => trans!{{WholeExtension.Carrier z}} _ _ _
    (congr!{Middle.Term[z := z].Carrier {WholeExtension.Carrier z}} (#apply{ambientMap} z) _ _ (#addition{Exact.sequence.inclusion} z x y))
    (#addition{ambientMap} z (#apply{Exact.sequence.inclusion} z x) (#apply{Exact.sequence.inclusion} z y)),
  scalar := \fun (a: I.Int^)(x: Left.Term[z := z].Carrier) => trans!{{WholeExtension.Carrier z}} _ _ _
    (congr!{Middle.Term[z := z].Carrier {WholeExtension.Carrier z}} (#apply{ambientMap} z) _ _ (#scalar{Exact.sequence.inclusion} z a x))
    (#scalar{ambientMap} z a (#apply{Exact.sequence.inclusion} z x)),
};
\import Modules.Hom[V := SubspaceExtension.Carrier z, W := WholeExtension.Carrier z, source := SubspaceExtension.space z, target := WholeExtension.space z]
  .Composition[U := Left.Term[z := z].Carrier, domain := Left.Term[z := z].space] \as LeftCompose;
\definition leftSecond: LeftMaps.Map := LeftMaps.Map {
  apply := \fun (x: Left.Term[z := z].Carrier) => #apply{Pair.inclusionMap} z (#apply{subspaceMap} z x),
  addition := \fun (x, y: Left.Term[z := z].Carrier) => trans!{{WholeExtension.Carrier z}} _ _ _
    (congr!{{SubspaceExtension.Carrier z} {WholeExtension.Carrier z}} (#apply{Pair.inclusionMap} z) _ _ (#addition{subspaceMap} z x y))
    (#addition{Pair.inclusionMap} z (#apply{subspaceMap} z x) (#apply{subspaceMap} z y)),
  scalar := \fun (a: I.Int^)(x: Left.Term[z := z].Carrier) => trans!{{WholeExtension.Carrier z}} _ _ _
    (congr!{{SubspaceExtension.Carrier z} {WholeExtension.Carrier z}} (#apply{Pair.inclusionMap} z) _ _ (#scalar{subspaceMap} z a x))
    (#scalar{Pair.inclusionMap} z a (#apply{subspaceMap} z x)),
};
\import Modules.Hom[V := Middle.Term[z := z].Carrier, W := Pair.Carrier z, source := Middle.Term[z := z].space, target := Pair.space z] \as RightMaps;
\definition rightFirst: RightMaps.Map := RightMaps.Map {
  apply := \fun (x: Middle.Term[z := z].Carrier) => #apply{Pair.sequence.projection} z (#apply{ambientMap} z x),
  addition := \fun (x, y: Middle.Term[z := z].Carrier) => trans!{{Pair.Carrier z}} _ _ _
    (congr!{{WholeExtension.Carrier z} {Pair.Carrier z}} (#apply{Pair.sequence.projection} z) _ _ (#addition{ambientMap} z x y))
    (#addition{Pair.sequence.projection} z (#apply{ambientMap} z x) (#apply{ambientMap} z y)),
  scalar := \fun (a: I.Int^)(x: Middle.Term[z := z].Carrier) => trans!{{Pair.Carrier z}} _ _ _
    (congr!{{WholeExtension.Carrier z} {Pair.Carrier z}} (#apply{Pair.sequence.projection} z) _ _ (#scalar{ambientMap} z a x))
    (#scalar{Pair.sequence.projection} z a (#apply{ambientMap} z x)),
};
\definition rightSecond: RightMaps.Map := RightMaps.Map {
  apply := \fun (x: Middle.Term[z := z].Carrier) => #apply{map} z (#apply{Exact.sequence.projection} z x),
  addition := \fun (x, y: Middle.Term[z := z].Carrier) => trans!{{Pair.Carrier z}} _ _ _
    (congr!{Right.Term[z := z].Carrier {Pair.Carrier z}} (#apply{map} z) _ _ (#addition{Exact.sequence.projection} z x y))
    (#addition{map} z (#apply{Exact.sequence.projection} z x) (#apply{Exact.sequence.projection} z y)),
  scalar := \fun (a: I.Int^)(x: Middle.Term[z := z].Carrier) => trans!{{Pair.Carrier z}} _ _ _
    (congr!{Right.Term[z := z].Carrier {Pair.Carrier z}} (#apply{map} z) _ _ (#scalar{Exact.sequence.projection} z a x))
    (#scalar{map} z a (#apply{Exact.sequence.projection} z x)),
};
\module Component(i: Index);
\import Modules.DirectSum[Index := Index, family := Left.Term[z := z].family].To[W := WholeExtension.Carrier z, target := WholeExtension.space z] \as LeftUniversal;
\definition leftEquation: leftFirst = leftSecond := LeftUniversal.ext _ _ (\fun (i: Index) => Component[i := i].left);
\definition left: \forall (x: Left.Term[z := z].Carrier) ->
  #apply{ambientMap} z (#apply{Exact.sequence.inclusion} z x) = #apply{Pair.inclusionMap} z (#apply{subspaceMap} z x) :=
  \fun (x: Left.Term[z := z].Carrier) => congr!{LeftMaps.Map {WholeExtension.Carrier z}} (\fun (f: LeftMaps.Map) => #apply{f} x) _ _ leftEquation;
\import Modules.DirectSum[Index := Index, family := Middle.Term[z := z].family].To[W := Pair.Carrier z, target := Pair.space z] \as RightUniversal;
\definition rightEquation: rightFirst = rightSecond := RightUniversal.ext _ _ (\fun (i: Index) => Component[i := i].right);
\definition right: \forall (x: Middle.Term[z := z].Carrier) ->
  #apply{Pair.sequence.projection} z (#apply{ambientMap} z x) = #apply{map} z (#apply{Exact.sequence.projection} z x) :=
  \fun (x: Middle.Term[z := z].Carrier) => congr!{RightMaps.Map {Pair.Carrier z}} (\fun (f: RightMaps.Map) => #apply{f} x) _ _ rightEquation;
