\import \parent.\parent.Component[i := i] \as Fiber;
\import singular_cohomology.Maps[A := Restriction.Fiber i, B := Cut.Carrier, source := Restriction.fiberTopology i, target := Cut.topology] \as FirstMaps;
\import FirstMaps.Composition[C := Subspace.CarrierSet, final := Subspace.topology topology] \as Functoriality;
\import Complexes.Map[C := leftTerms i, D := SubspaceExtension.complex] \as Results;
\definition equation: Complexes.Map[C := CutExtension.complex, D := SubspaceExtension.complex].Composition[B := leftTerms i]
  .compose Homeomorphism.forwardMap (SubspaceSum.Canonical[].Component[i := i].map) = Fiber.restrictedMap :=
  Functoriality.Integer[].law (Cut.injection i) (Cut.At[i := i].continuous) Restriction.forward Restriction.forwardContinuous;
\definition law: \forall (z: I.Int^)(x: (leftTerms i).family.Carrier z) ->
  #apply{Homeomorphism.forwardMap} z (#apply{SubspaceSum.Canonical[].Component[i := i].map} z x) = #apply{Fiber.restrictedMap} z x :=
  \fun (z: I.Int^)(x: (leftTerms i).family.Carrier z) => congr!{Results.Map {SubspaceExtension.Carrier z}}
    (\fun (f: Results.Map) => #apply{f} z x) _ _ equation;
