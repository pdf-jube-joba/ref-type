\import Complexes.At[C := Right.complex, z := z] \as Source;
\import Complexes.Map[C := Right.complex, D := Pair.complex].At[k := z].Invert[f := map] \as Inverse;
\definition comparison: Modules.Isomorphism[V := Source.Homology, W := Pair.Homology[z := z].Carrier,
  source := Source.homologySpace, target := Pair.Homology[z := z].space].Isomorphism := Inverse.isomorphism (quasiIsomorphism z);
\definition family: Modules.Family[Index] := Right.At[z := z].homologyFamily;
\import Modules.DirectSum[Index := Index, family := family] \as Sum;
\import Modules.Isomorphism[V := Sum.Carrier, W := Source.Homology, source := Sum.space, target := Source.homologySpace]
  .Composition[U := Pair.Homology[z := z].Carrier, final := Pair.Homology[z := z].space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Sum.Carrier, W := Pair.Homology[z := z].Carrier,
  source := Sum.space, target := Pair.Homology[z := z].space].Isomorphism := Composition.compose comparison (Right.At[z := z].Homology[].isomorphism);

\module Cell(i: Index);
