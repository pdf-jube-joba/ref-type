\import \parent.\parent.\parent.RelativeComponent[subset := subset, i := i] \as Component;
\import singular_cohomology.Relative[A := fibers i, source := spaces i, subset := Restriction.fiberSubset i]
  .Maps[B := Carrier].Over[target := topology, targetSubset := subset].On[f := Component.pairMap].Integer[] \as Injection;
\definition onInjection: \forall (q: Component.Carrier z) ->
  #apply{#forward{isomorphism}} (#apply{Sum.Injection[i := i].map} q) = #apply{Injection.At[z := z].induced} q :=
  Copair.Homology[z := z].Component[i := i].onInjection;
