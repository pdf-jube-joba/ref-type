\import \parent.\parent.Component[i := i] \as Fiber;
\definition left: \forall (x: (leftTerms i).family.Carrier z) ->
  #apply{leftFirst} (#apply{Left.Term[z := z].Component[i := i].injection} x) = #apply{leftSecond} (#apply{Left.Term[z := z].Component[i := i].injection} x) :=
  \fun (x: (leftTerms i).family.Carrier z) => trans!{WholeExtension.Carrier z} _ _ _
    (congr!{Middle.Term[z := z].Carrier {WholeExtension.Carrier z}} (#apply{ambientMap} z) _ _ (Inclusion.onInjection i x))
    (trans!{WholeExtension.Carrier z} _ _ _
      (WholeSum.Canonical[].mapOnInjection z i (#apply{Fiber.sequence.inclusion} z x))
      (trans!{WholeExtension.Carrier z} _ _ _ (Fiber.leftSquare z x)
        (sym!{WholeExtension.Carrier z} _ _
          (congr!{SubspaceExtension.Carrier z {WholeExtension.Carrier z}} (#apply{Pair.inclusionMap} z) _ _ (\parent.\parent.SubspaceComparison[].onInjection z i x)))));
\definition right: \forall (x: (middleTerms i).family.Carrier z) ->
  #apply{rightFirst} (#apply{Middle.Term[z := z].Component[i := i].injection} x) = #apply{rightSecond} (#apply{Middle.Term[z := z].Component[i := i].injection} x) :=
  \fun (x: (middleTerms i).family.Carrier z) => trans!{Pair.Carrier z} _ _ _
    (congr!{WholeExtension.Carrier z {Pair.Carrier z}} (#apply{Pair.sequence.projection} z) _ _ (WholeSum.Canonical[].mapOnInjection z i x))
    (trans!{Pair.Carrier z} _ _ _ (Fiber.rightSquare z x)
      (sym!{Pair.Carrier z} _ _
        (trans!{Pair.Carrier z} _ _ _
          (congr!{Right.Term[z := z].Carrier {Pair.Carrier z}} (#apply{map} z) _ _ (Projection.onInjection i x))
          (Copair.At[z := z].onInjection i (#apply{Fiber.sequence.projection} z x)))));
