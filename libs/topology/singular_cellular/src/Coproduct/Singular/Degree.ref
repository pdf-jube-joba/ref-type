\import Simplex.Vertices[] \as Vertices;
\definition point: Simplex.Carrier n := Vertices.vertex n (Fin.zero n);
\definition label[sigma: SmallSimplices.Carrier n]: Index := (sigma point).index;
\definition sameLabel: \forall (sigma: SmallSimplices.Carrier n)(x: Simplex.Carrier n) -> (sigma x).index = label sigma := \block {
  \fun (sigma: SmallSimplices.Carrier n)(x: Simplex.Carrier n) \then
  \takefrom w: SmallSimplices.Witness[n, sigma] \by SmallSimplices.witness n sigma \then
  \takefrom v: Witness[(w).element] \by (w).member \then
  \let inImage: \forall (x: Simplex.Carrier n) -> Space.Member (\parent.\parent.At[i := (v).index].subset) (sigma x) :=
    \fun (x: Simplex.Carrier n) => \idelim (w).element = \parent.\parent.At[i := (v).index].subset
      \with U: \Pow Carrier => Space.Member U (sigma x) \by { base: (w).contained x, equality: (v).same } \then
  \return trans!{Index} _ _ _ (Membership.indexOf ((v).index) (sigma x) (inImage x))
    (sym!{Index} _ _ (Membership.indexOf ((v).index) (sigma point) (inImage point)))
};
\module On(sigma: SmallSimplices.Carrier n);

\module Retract(i: Index);
