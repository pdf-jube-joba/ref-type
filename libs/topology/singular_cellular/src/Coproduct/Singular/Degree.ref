\import Simplex.Vertices[] \as Vertices;
\definition point: Simplex.Carrier n := Vertices.vertex n (Fin.zero n);
\definition label(sigma: SmallSimplices.Carrier n): Index := #index{(sigma point)};
\definition sameLabel: \forall (sigma: SmallSimplices.Carrier n)(x: Simplex.Carrier n) -> #index{(sigma x)} = label sigma := \block {
  \fun (sigma: SmallSimplices.Carrier n)(x: Simplex.Carrier n) \then
  \takefrom w: SmallSimplices.Witness[n, sigma] \by SmallSimplices.witness n sigma \then
  \takefrom v: \parent.Witness[#element{w}] \by #member{w} \then
  \let inImage: \forall (x: Simplex.Carrier n) -> Space.Member (\parent.\parent.At[i := #index{v}].subset) (sigma x) :=
    \fun (x: Simplex.Carrier n) => \idelim #element{w} = \parent.\parent.At[i := #index{v}].subset
      \with U: \Pow Carrier => Space.Member U (sigma x) \by { base: #contained{w} x, equality: #same{v} } \then
  \return trans!{Index} _ _ _ (Membership.indexOf (#index{v}) (sigma x) (inImage x))
    (sym!{Index} _ _ (Membership.indexOf (#index{v}) (sigma point) (inImage point)))
};
\module On(sigma: SmallSimplices.Carrier n);

\module Retract(i: Index);
