\definition i: Index := Simplices.label sigma;
\import Simplices.On[sigma := sigma] \as Decoded;
\import \parent.\parent.\parent.Component[i := i] \as Component;
\definition value: Sum.Term[z := degree].Carrier := #apply{Sum.Term[z := degree].Component[i := i].injection} (Component.generator n Decoded.simplex);
\definition forward: #apply{Native.map} degree value = SmallExtension.Positive[n := n].intro (Small.generator n sigma) :=
  trans!{SmallExtension.Carrier degree} _ _ _ (Native.At[z := degree].onInjection i (Component.generator n Decoded.simplex))
    (trans!{SmallExtension.Carrier degree} _ _ _ (Component.onGenerator n Decoded.simplex)
      (congr!{SmallSimplices.Carrier n {SmallExtension.Carrier degree}}
        (\fun (s: SmallSimplices.Carrier n) => SmallExtension.Positive[n := n].intro (Small.generator n s)) _ _ Decoded.forward));
