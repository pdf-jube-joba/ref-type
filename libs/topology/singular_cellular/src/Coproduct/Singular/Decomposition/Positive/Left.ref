\import Modules.Hom[V := SmallExtension.Carrier degree, W := Sum.Term[z := degree].Carrier,
  source := SmallExtension.space degree, target := Sum.Term[z := degree].space]
  .Composition[U := Sum.Term[z := degree].Carrier, domain := Sum.Term[z := degree].space] \as Compose;
\definition composite: Modules.Hom[V := Sum.Term[z := degree].Carrier, W := Sum.Term[z := degree].Carrier,
  source := Sum.Term[z := degree].space, target := Sum.Term[z := degree].space].Map := Compose.compose backward Native.At[z := degree].map;
\module Component(i: Index);
\import Modules.DirectSum[Index := Index, family := Sum.Term[z := degree].family].To[W := Sum.Term[z := degree].Carrier, target := Sum.Term[z := degree].space] \as Compare;
\import Modules.End[V := Sum.Term[z := degree].Carrier, space := Sum.Term[z := degree].space] \as Identity;
\definition equation: composite = Identity.identity := Compare.ext _ _ (\fun (i: Index) => Component[i := i].law);
\import Modules.Hom[V := Sum.Term[z := degree].Carrier, W := Sum.Term[z := degree].Carrier,
  source := Sum.Term[z := degree].space, target := Sum.Term[z := degree].space] \as Maps;
\definition law: \forall (x: Sum.Term[z := degree].Carrier) -> (backward).apply ((Native.map).apply degree x) = x :=
  \fun (x: Sum.Term[z := degree].Carrier) => congr!{Maps.Map {Sum.Term[z := degree].Carrier}} (\fun (f: Maps.Map) => (f).apply x) _ _ equation;
