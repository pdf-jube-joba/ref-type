\import \parent.\parent.\parent.\parent.Component[i := i] \as Component;
\import singular_cohomology.Chains[A := fibers i, source := spaces i] \as Chains;
\import Nonnegative.ZeroExtension[C := Chains.complex] \as Extension;
\import singular_cohomology.Simplices[A := fibers i, source := spaces i] \as Fiber;
\import Sum.Term[z := degree].Component[i := i] \as Injection;
\import Modules.Hom[V := Extension.Carrier degree, W := Sum.Term[z := degree].Carrier,
  source := Extension.space degree, target := Sum.Term[z := degree].space]
  .Composition[U := Chains.Carrier n, domain := Chains.space n] \as Insert;
\definition insertion: Modules.Hom[V := Chains.Carrier n, W := Sum.Term[z := degree].Carrier,
  source := Chains.space n, target := Sum.Term[z := degree].space].Map := Insert.compose Injection.injection Extension.Positive[n := n].forward;
\definition valuesOnComponent: \forall (sigma: Fiber.Carrier n) -> values (Component.simplex n sigma) = #apply{insertion} (Chains.generator n sigma) :=
  \fun (sigma: Fiber.Carrier n) => congr!{Fiber.Carrier n {Sum.Term[z := degree].Carrier}}
    (\fun (s: Fiber.Carrier n) => #apply{Injection.injection} (Component.generator n s)) _ _
    (Simplices.Retract[i := i].onComponent sigma);
\definition generator: \forall (sigma: Fiber.Carrier n) ->
  #apply{composite} (#apply{insertion} (Chains.generator n sigma)) = #apply{insertion} (Chains.generator n sigma) :=
  \fun (sigma: Fiber.Carrier n) => trans!{Sum.Term[z := degree].Carrier} _ _ _
    (congr!{SmallExtension.Carrier degree {Sum.Term[z := degree].Carrier}} (#apply{backward}) _ _
      (trans!{SmallExtension.Carrier degree} _ _ _ (Native.At[z := degree].onInjection i (Component.generator n sigma))
        (Component.onGenerator n sigma)))
    (trans!{Sum.Term[z := degree].Carrier} _ _ _ (onGenerator (Component.simplex n sigma)) (valuesOnComponent sigma));
\import Modules.Hom[V := Sum.Term[z := degree].Carrier, W := Sum.Term[z := degree].Carrier,
  source := Sum.Term[z := degree].space, target := Sum.Term[z := degree].space]
  .Composition[U := Chains.Carrier n, domain := Chains.space n] \as Compose;
\import Modules.Free[Generators := Fiber.Carrier n].To[W := Sum.Term[z := degree].Carrier, target := Sum.Term[z := degree].space] \as Free;
\definition equation: Compose.compose composite insertion = insertion := Free.ext _ _ generator;
\import Modules.Hom[V := Chains.Carrier n, W := Sum.Term[z := degree].Carrier, source := Chains.space n, target := Sum.Term[z := degree].space] \as Maps;
\definition law: \forall (x: (terms i).family.Carrier degree) ->
  #apply{composite} (#apply{Injection.injection} x) = #apply{Injection.injection} x :=
  \fun (x: (terms i).family.Carrier degree) => congr!{Maps.Map {Sum.Term[z := degree].Carrier}} (\fun (f: Maps.Map) => #apply{f} x) _ _ equation;
