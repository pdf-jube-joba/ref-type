\import Modules.Hom[V := Sum.Term[z := degree].Carrier, W := SmallExtension.Carrier degree,
  source := Sum.Term[z := degree].space, target := SmallExtension.space degree]
  .Composition[U := Small.Carrier n, domain := Small.space n] \as Compose;
\import Modules.Free[Generators := SmallSimplices.Carrier n].To[W := SmallExtension.Carrier degree, target := SmallExtension.space degree] \as Free;
\definition equation: Compose.compose Native.At[z := degree].map raw = SmallExtension.Positive[n := n].forward :=
  Free.ext _ _ (\fun (sigma: SmallSimplices.Carrier n) => trans!{{SmallExtension.Carrier degree}} _ _ _
    (congr!{Sum.Term[z := degree].Carrier {SmallExtension.Carrier degree}} (#apply{Native.At[z := degree].map}) _ _ (Universal.onGenerator values sigma))
    (\parent.On[sigma := sigma].forward));
\import Modules.Hom[V := Small.Carrier n, W := SmallExtension.Carrier degree, source := Small.space n, target := SmallExtension.space degree] \as Maps;
\definition law: \forall (x: SmallExtension.Carrier degree) -> #apply{Native.map} degree (#apply{backward} x) = x :=
  \fun (x: SmallExtension.Carrier degree) => congr!{Maps.Map {SmallExtension.Carrier degree}} (\fun (f: Maps.Map) => #apply{f} x) _ _ equation;
