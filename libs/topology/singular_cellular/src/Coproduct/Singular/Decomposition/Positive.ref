\definition degree: I.Int^ := I.Int^::ofNat n;
\import \parent.\parent.Degree[n := n] \as Simplices;
\module On(sigma: SmallSimplices.Carrier n);
\definition values[sigma: SmallSimplices.Carrier n]: Sum.Term[z := degree].Carrier := On[sigma := sigma].value;
\import Modules.Free[Generators := SmallSimplices.Carrier n].To[W := Sum.Term[z := degree].Carrier, target := Sum.Term[z := degree].space] \as Universal;
\definition raw: Modules.Hom[V := Small.Carrier n, W := Sum.Term[z := degree].Carrier,
  source := Small.space n, target := Sum.Term[z := degree].space].Map := Universal.extension values;
\import Modules.Hom[V := SmallExtension.Carrier degree, W := Sum.Term[z := degree].Carrier,
  source := SmallExtension.space degree, target := Sum.Term[z := degree].space] \as Maps;
\definition backward: Maps.Map := Maps.Map {
  apply := \fun (x: SmallExtension.Carrier degree) => (raw).apply x,
  addition := \fun (x, y: SmallExtension.Carrier degree) => (raw).addition x y,
  scalar := \fun (a: I.Int^)(x: SmallExtension.Carrier degree) => (raw).scalar a x,
};
\definition onGenerator: \forall (sigma: SmallSimplices.Carrier n) ->
  (backward).apply (SmallExtension.Positive[n := n].intro (Small.generator n sigma)) = values sigma := Universal.onGenerator values;
\module Right;
\module Left;
