\import Modules.Hom[V := Sum.Term[z := z].Carrier, W := WholeExtension.Carrier z,
  source := Sum.Term[z := z].space, target := WholeExtension.space z] \as Linear;
\definition first: Linear.Map := Linear.Map {
  apply := #apply{#forward{equivalence}} z, addition := #addition{#forward{equivalence}} z, scalar := #scalar{#forward{equivalence}} z,
};
\definition second: Linear.Map := Linear.Map { apply := #apply{map} z, addition := #addition{map} z, scalar := #scalar{map} z };
\import Modules.DirectSum[Index := Index, family := Sum.Term[z := z].family].To[W := WholeExtension.Carrier z, target := WholeExtension.space z] \as Universal;
\definition onInjection: \forall (i: Index)(x: (terms i).family.Carrier z) ->
  #apply{first} (#apply{Sum.Term[z := z].Component[i := i].injection} x) = #apply{second} (#apply{Sum.Term[z := z].Component[i := i].injection} x) :=
  \fun (i: Index)(x: (terms i).family.Carrier z) => trans!{{WholeExtension.Carrier z}} _ _ _
    (congr!{{SmallExtension.Carrier z} {WholeExtension.Carrier z}} (#apply{#forward{(Comparison.equivalence)}} z) _ _
      (Native.At[z := z].onInjection i x))
    (trans!{{WholeExtension.Carrier z}} _ _ _ (\parent.Component[i := i].equation z x)
      (sym!{{WholeExtension.Carrier z}} _ _ (Copair.At[z := z].onInjection i x)));
\definition equation: first = second := Universal.ext first second onInjection;
\definition law: \forall (x: Sum.Term[z := z].Carrier) -> #apply{#forward{equivalence}} z x = #apply{map} z x :=
  \fun (x: Sum.Term[z := z].Carrier) => congr!{Linear.Map {WholeExtension.Carrier z}} (\fun (f: Linear.Map) => #apply{f} x) _ _ equation;
