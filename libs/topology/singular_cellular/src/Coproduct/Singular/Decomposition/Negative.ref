\definition degree: I.Int^ := I.Int^::negSucc n;
\import Modules.DirectSum[Index := Index, family := Sum.Term[z := degree].family].FiniteSupport[] \as Coordinates;
\definition zero: \forall (x: Sum.Term[z := degree].Carrier) -> x = #zero{Sum.Term[z := degree].space} :=
  \fun (x: Sum.Term[z := degree].Carrier) => Coordinates.injective x #zero{Sum.Term[z := degree].space}
    (\axiom:funext(Coordinates.coordinates x, Coordinates.coordinates #zero{Sum.Term[z := degree].space}, \fun (i: Index) =>
      trans!{(terms i).family.Carrier degree} _ _ _ (\parent.\parent.Component[i := i].zeroBelow n (Coordinates.coordinates x i))
        (sym!{(terms i).family.Carrier degree} _ _ (\parent.\parent.Component[i := i].zeroBelow n (Coordinates.coordinates #zero{Sum.Term[z := degree].space} i)))));
\import Modules.Hom[V := SmallExtension.Carrier degree, W := Sum.Term[z := degree].Carrier,
  source := SmallExtension.space degree, target := Sum.Term[z := degree].space] \as Maps;
\definition backward: Maps.Map := Maps.zeroMap;
\definition left: \forall (x: Sum.Term[z := degree].Carrier) -> #apply{backward} (#apply{forward} degree x) = x :=
  \fun (x: Sum.Term[z := degree].Carrier) => sym!{Sum.Term[z := degree].Carrier} _ _ (zero x);
\import Modules.Hom[V := Sum.Term[z := degree].Carrier, W := SmallExtension.Carrier degree,
  source := Sum.Term[z := degree].space, target := SmallExtension.space degree] \as Forward;
\definition right: \forall (x: SmallExtension.Carrier degree) -> #apply{forward} degree (#apply{backward} x) = x :=
  \fun (x: SmallExtension.Carrier degree) => trans!{SmallExtension.Carrier degree} _ _ _ (Forward.zeroPreserved Native.At[z := degree].map)
    (sym!{SmallExtension.Carrier degree} _ _ (SmallExtension.Negative[n := n].zero x));
