\import \parent.\parent.Component[i := i] \as Inclusion;
\import \parent.\parent.\parent.At[i := i] \as Image;
\import Space.Subspace[S := Image.subset] \as ImageSpace;
\import topology.Homeomorphism[A := fibers i, B := ImageSpace.CarrierSet] \as Homeomorphisms;
\import singular_cohomology.Simplices[A := fibers i, source := spaces i] \as Simplices;
\definition laws: Homeomorphisms.Laws[spaces i, ImageSpace.topology topology, Image.homeomorphism] :=
  Homeomorphisms.laws (spaces i) (ImageSpace.topology topology) Image.homeomorphism;
\definition onComponent: \forall (sigma: Simplices.Carrier n) -> \parent.On[sigma := Inclusion.simplex n sigma].simplex = sigma :=
  \fun (sigma: Simplices.Carrier n) => \axiom:funext(\parent.On[sigma := Inclusion.simplex n sigma].simplex, sigma,
    \fun (x: Simplex.Carrier n) => #leftInverse{laws} (sigma x));
