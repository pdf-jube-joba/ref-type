\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\definition belongs(chart: Carrier): Space.Member (\parent.At[i := #index{chart}].subset) chart :=
  Logic.existsIntro[fibers (#index{chart}), { p: fibers (#index{chart}) \where Logic.And[
    topology.Topology[Carrier := fibers (#index{chart})].Member (topology.Topology[Carrier := fibers (#index{chart})].Whole) p,
    injection (#index{chart}) p = chart] }] (#point{chart}) (Logic.And[_, _]::# (\refl(#point{chart})) (eta chart));
\definition indexOf: \forall (i: Index)(chart: Carrier) -> Space.Member (\parent.At[i := i].subset) chart -> #index{chart} = i := \block {
  \fun (i: Index)(chart: Carrier)(member: _) \then
  \takefrom p: \Cast[fibers i] ({ p: fibers i \where Logic.And[
    topology.Topology[Carrier := fibers i].Member (topology.Topology[Carrier := fibers i].Whole) p, injection i p = chart] }) \by member \then
  \let data: Logic.And[topology.Topology[Carrier := fibers i].Member (topology.Topology[Carrier := fibers i].Whole) p, injection i p = chart] :=
    \bysub(fibers i, { p: fibers i \where Logic.And[
      topology.Topology[Carrier := fibers i].Member (topology.Topology[Carrier := fibers i].Whole) p, injection i p = chart] }, p) \then
  \return sym!{Index} _ _ (congr!{Carrier Index} (\fun (c: Carrier) => #index{c}) _ _ (#right{data}))
};
\definition ofIndex: \forall (i: Index)(chart: Carrier) -> #index{chart} = i -> Space.Member (\parent.At[i := i].subset) chart :=
  \fun (i: Index)(chart: Carrier)(same: _) => \idelim #index{chart} = i \with j: Index => Space.Member (\parent.At[i := j].subset) chart \by {
    base: belongs chart, equality: same
  };
