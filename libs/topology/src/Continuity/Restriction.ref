\import Source.Subspace[S := S] \as Subspace;
\import topology.Topology[Carrier := RestrictedCarrier S] \as Sub;

\definition restrictContinuous(ambient: Source.Topology::[Set])
  (target: Target.Topology::[Set]) (f: A -> B)
  (continuous: Continuous ambient target f):
  \forall (V: \Pow B) -> Target.IsOpenIn target V ->
    Sub.IsOpenIn (Subspace.topology ambient) (RestrictedPreimage S f V) :=
  \fun (V: \Pow B) => \fun (open: Target.IsOpenIn target V) =>
    Sub.generatedBasisOpen (Subspace.Basis ambient)
      (RestrictedPreimage S f V)
      (restrictBasisOpen ambient target S f continuous V open);
