/* Product topology generated by open rectangles. */
\import topology.Topology[Carrier := A] \as Left;
\import topology.Topology[Carrier := B] \as Right;
\import std.Data[].Pair[] \as Pair;
\import topology.Topology[Carrier := Pair.Times^[A, B]] \as ProductSpace;
\import std.Logic[].Proposition[] \as Logic;

\definition CarrierSet: \Set := Pair.Times^[A, B];
\definition ProductTopology: \Set := ProductSpace.Topology;

\definition Rectangle(U: \Pow A) (V: \Pow B): \Pow CarrierSet :=
  { p : CarrierSet \where
    Logic.And[\In[A] U (Pair.first A B p),
      \In[B] V (Pair.second A B p)] };

\structure OpenRectangle[
  left: Left.Topology, right: Right.Topology,
  W: \Pow CarrierSet, U: \Pow A, V: \Pow B,
]: \Prop := {
  leftOpen: Left.IsOpenIn left U,
  rightOpen: Right.IsOpenIn right V,
  rectangle: W = Rectangle U V,
};

\structure RectangleWitness[left: Left.Topology, right: Right.Topology, W: \Pow CarrierSet]: \Set {
  leftSet: \Pow A,
  rightSet: \Pow B,
  rectangle: OpenRectangle[left, right, W, leftSet, rightSet],
}

\definition Basis(left: Left.Topology)(right: Right.Topology): \Pow (\Pow CarrierSet) :=
  { W: \Pow CarrierSet \where \exists RectangleWitness[left, right, W] };

\definition topology(left: Left.Topology) (right: Right.Topology): ProductTopology :=
  ProductSpace.generated (Basis left right);

\definition openSets(left: Left.Topology) (right: Right.Topology):
  \Pow (\Pow CarrierSet) :=
  #openSets{(ProductSpace.topologyData (topology left right))};

\module Universal(X: \Set);
