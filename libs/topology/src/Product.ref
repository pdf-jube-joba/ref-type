/* Product topology generated by open rectangles. */
\import std.Data[].Pair[] \as Pair;
\import topology.Topology[Carrier := Pair.Times^[A, B]] \as ProductSpace;
\import std.Logic[].Proposition[] \as Logic;

\definition CarrierSet: \Set := Pair.Times^[A, B];
\definition ProductTopology: \Set := ProductSpace.Topology::[Set];

\definition Rectangle(U: \Pow A) (V: \Pow B): \Pow CarrierSet :=
  { p : CarrierSet \where
    Logic.And[\In[A] U (Pair.first A B p),
      \In[B] V (Pair.second A B p)] };

\definition Basis(left: \Pow (\Pow A)) (right: \Pow (\Pow B)):
  \Pow (\Pow CarrierSet) :=
  { W : \Pow CarrierSet \where
    \exists { U : \Pow A \where
      Logic.And[\In[\Pow A] left U,
        \exists { V : \Pow B \where
          Logic.And[\In[\Pow B] right V, W = Rectangle U V] }] } };

\definition topology(left: \Pow (\Pow A)) (right: \Pow (\Pow B)):
  ProductTopology :=
  ProductSpace.generated (Basis left right);

\definition openSets(left: \Pow (\Pow A)) (right: \Pow (\Pow B)):
  \Pow (\Pow CarrierSet) :=
  #openSets{(ProductSpace.Topology::[raw] (topology left right))};

\module Universal(X: \Set);
