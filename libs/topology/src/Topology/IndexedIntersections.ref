\import std.Data[].FinSet[] \as Fin;
\use Equality::trans;
\use Logic::either;
\definition All(m: N.Nat^)(family: Fin.Fin m -> \Pow Carrier): \Pow Carrier :=
  { x: Carrier \where \forall (i: Fin.Fin m) -> Member (family i) x };
\definition empty: \forall (family: Fin.Fin N.Nat^::zero -> \Pow Carrier) -> All N.Nat^::zero family = Whole :=
  \fun (family: _) => \axiom:setext(All N.Nat^::zero family, Whole,
    \fun (x: Carrier)(member: _) => \refl(x),
    \fun (x: Carrier)(member: _)(i: Fin.Fin N.Nat^::zero) => Logic.falseElim (Member (family i) x) (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i)));
\definition headTail: \forall (m: N.Nat^)(family: Fin.Fin (N.Nat^::succ m) -> \Pow Carrier)(x: Carrier) ->
  Member (family (Fin.zero m)) x -> (\forall (j: Fin.Fin m) -> Member (family (Fin.succ m j)) x) -> Member (All (N.Nat^::succ m) family) x :=
  \fun (m: _)(family: _)(x: _)(head: _)(tail: _)(i: Fin.Fin (N.Nat^::succ m)) => either!{
    {i = N.Nat^::zero} "or" {\exists { j: Fin.Fin m \where i = N.Nat^::succ (Fin.value m j) }}
    "either" {Member (family i) x}
    "lt:" {\fun (equal: _) => \idelim Fin.zero m = i \with j: Fin.Fin (N.Nat^::succ m) => Member (family j) x \by {
      base: head, equality: sym!{{Fin.Fin (N.Nat^::succ m)}} i (Fin.zero m) equal
    }}
    "rt:" {\block {
      \fun (exists: \exists { j: Fin.Fin m \where i = N.Nat^::succ (Fin.value m j) }) \then
      \takefrom j: \Cast[Fin.Fin m] ({ j: Fin.Fin m \where i = N.Nat^::succ (Fin.value m j) }) \by exists \then
      \let equal: i = Fin.succ m j := \bysub(Fin.Fin m, { j: Fin.Fin m \where i = N.Nat^::succ (Fin.value m j) }, j) \then
      \return \idelim Fin.succ m j = i \with k: Fin.Fin (N.Nat^::succ m) => Member (family k) x \by {
        base: tail j, equality: sym!{{Fin.Fin (N.Nat^::succ m)}} i (Fin.succ m j) equal
      }
    }}} (Fin.successorCases m i (Fin.bound (N.Nat^::succ m) i));
\definition successor: \forall (m: N.Nat^)(family: Fin.Fin (N.Nat^::succ m) -> \Pow Carrier) ->
  All (N.Nat^::succ m) family = Intersection (family (Fin.zero m)) (All m (\fun (j: Fin.Fin m) => family (Fin.succ m j))) :=
  \fun (m: _)(family: _) => \axiom:setext(All (N.Nat^::succ m) family, Intersection (family (Fin.zero m)) (All m (\fun (j: Fin.Fin m) => family (Fin.succ m j))),
    \fun (x: Carrier)(all: Member (All (N.Nat^::succ m) family) x) => Logic.And[_, _]::# (all (Fin.zero m)) (\fun (j: Fin.Fin m) => all (Fin.succ m j)),
    \fun (x: Carrier)(both: Member (Intersection (family (Fin.zero m)) (All m (\fun (j: Fin.Fin m) => family (Fin.succ m j)))) x) => headTail m family x (#left{both}) (#right{both}));
\definition open: \forall (space: Topology)(m: N.Nat^)(family: Fin.Fin m -> \Pow Carrier) ->
  (\forall (i: Fin.Fin m) -> IsOpenIn space (family i)) -> IsOpenIn space (All m family) :=
  \fun (space: _) => \induction (m: N.Nat^) \return \forall (family: Fin.Fin m -> \Pow Carrier) ->
    (\forall (i: Fin.Fin m) -> IsOpenIn space (family i)) -> IsOpenIn space (All m family) \with {
      | zero: \fun (family: _)(proof: _) => \idelim Whole = All N.Nat^::zero family \with U: \Pow Carrier => IsOpenIn space U \by {
        base: #wholeOpen{(topologyLaws space)}, equality: sym!{\Pow Carrier} _ _ (empty family)
      }
      | succ: \fun (m: N.Nat^)(previous: _)(family: _)(proof: _) =>
        \idelim Intersection (family (Fin.zero m)) (All m (\fun (j: Fin.Fin m) => family (Fin.succ m j))) = All (N.Nat^::succ m) family
          \with U: \Pow Carrier => IsOpenIn space U \by {
            base: #intersectionOpen{(topologyLaws space)} (family (Fin.zero m)) (All m (\fun (j: Fin.Fin m) => family (Fin.succ m j)))
              (proof (Fin.zero m)) (previous (\fun (j: Fin.Fin m) => family (Fin.succ m j)) (\fun (j: Fin.Fin m) => proof (Fin.succ m j))),
            equality: sym!{\Pow Carrier} _ _ (successor m family)
          }
    };
