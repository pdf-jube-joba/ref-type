\import topology.Continuity[A := Carrier, B := B] \as C;
\import topology.Continuity[A := CarrierSet, B := B] \as Restricted;

\definition restrictContinuous(ambient: Topology::[Set])
  (target: \Pow (\Pow B)) (f: Carrier -> B)
  (continuous: C.Continuous (#openSets{(Topology::[raw] ambient)}) target f):
  Restricted.Continuous
    (#openSets{(Sub.Topology::[raw] (topology ambient))}) target (C.Restrict S f) :=
  \fun (V: \Pow B) => \fun (open: \In[\Pow B] target V) =>
    Sub.generatedBasisOpen (Basis ambient)
      (Restricted.Preimage (C.Restrict S f) V)
      (C.restrictContinuous (#openSets{(Topology::[raw] ambient)}) target S f
        continuous V open);
