\import std.Set[].FiniteSubset[A := \Pow Carrier] \as AmbientFinite;
\import std.Set[].FiniteSubset[A := \Pow CarrierSet] \as SubFinite;
\import AmbientFinite.Selection[B := \Pow CarrierSet] \as Selection;
\import Sub.Compactness[] \as SubCompact;
\import std.Logic[].Equality[] \as Equality;
\definition secondCountable: \forall (ambient: Topology) -> IsSecondCountable ambient -> Sub.IsSecondCountable (topology ambient) := \block {
  \fun (ambient: _)(countable: _) \then
  \takefrom basis: \Cast[N.Nat^ -> \Pow Carrier] ({ basis: N.Nat^ -> \Pow Carrier \where IsCountableBasis[ambient, basis] }) \by countable \then
  \let laws: IsCountableBasis[ambient, basis] := \bysub(N.Nat^ -> \Pow Carrier,
    { basis: N.Nat^ -> \Pow Carrier \where IsCountableBasis[ambient, basis] }, basis) \then
  \let traces: N.Nat^ -> \Pow CarrierSet := \fun (n: N.Nat^) => Trace (basis n) \then
  \return \exact(\into[N.Nat^ -> \Pow CarrierSet](traces,
    { basis: N.Nat^ -> \Pow CarrierSet \where Sub.IsCountableBasis[topology ambient, basis] }) \by {
      Sub.IsCountableBasis[topology ambient, traces] {
        open := \fun (n: N.Nat^) => traceOpen ambient (basis n) (#open{laws} n),
        refines := \fun (W: \Pow CarrierSet)(open: Sub.IsOpenIn (topology ambient) W)(x: CarrierSet)(inside: Sub.Member W x) =>
          openTraceElim ambient W
            (\exists { n: N.Nat^ \where Logic.And[Sub.Member (traces n) x, Sub.Subset (traces n) W] })
            (\block {
              \fun (U: \Pow Carrier)(open: IsOpenIn ambient U)(same: W = Trace U) \then
              \let inU: Member U x := \idelim W = Trace U \with V: \Pow CarrierSet => Sub.Member V x \by { base: inside, equality: same } \then
              \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where Logic.And[Member (basis n) x, Subset (basis n) U] })
                \by #refines{laws} U open x inU \then
              \let refinement: Logic.And[Member (basis n) x, Subset (basis n) U] := \bysub(N.Nat^,
                { n: N.Nat^ \where Logic.And[Member (basis n) x, Subset (basis n) U] }, n) \then
              \return \exact(\into[N.Nat^](n,
                { n: N.Nat^ \where Logic.And[Sub.Member (traces n) x, Sub.Subset (traces n) W] }) \by {
                  Logic.And[_, _]::# (#left{refinement})
                    (\fun (y: CarrierSet)(member: Sub.Member (traces n) y) => \idelim Trace U = W
                      \with V: \Pow CarrierSet => Sub.Member V y \by {
                        base: #right{refinement} y member, equality: sym!{\Pow CarrierSet} _ _ same
                      })
                }, \Cast[N.Nat^] ({ n: N.Nat^ \where Logic.And[Sub.Member (traces n) x, Sub.Subset (traces n) W] }))
            }) (openRepresentation ambient W open),
      }
    }, \Cast[N.Nat^ -> \Pow CarrierSet] ({ basis: N.Nat^ -> \Pow CarrierSet \where Sub.IsCountableBasis[topology ambient, basis] }))
};
\definition hausdorff: \forall (ambient: Topology) -> IsT2 ambient -> Sub.IsT2 (topology ambient) := \block {
  \fun (ambient: _) (separated: _) (x, y: CarrierSet) (different: _) \then
  \takefrom U: \Cast[\Pow Carrier] ({ U: \Pow Carrier \where RegularChoice[ambient, Singleton y, x, U] }) \by separated x y different \then
  \let data: RegularChoice[ambient, Singleton y, x, U] := \bysub(\Pow Carrier, { U: \Pow Carrier \where RegularChoice[ambient, Singleton y, x, U] }, U) \then
  \takefrom V: \Cast[\Pow Carrier] ({ V: \Pow Carrier \where NormalPartner[ambient, Singleton y, U, V] }) \by #partner{data} \then
  \let partner: NormalPartner[ambient, Singleton y, U, V] := \bysub(\Pow Carrier, { V: \Pow Carrier \where NormalPartner[ambient, Singleton y, U, V] }, V) \then
  \return \exact(\into[\Pow CarrierSet](Trace U, { W: \Pow CarrierSet \where Sub.RegularChoice[topology ambient, Sub.Singleton y, x, W] }) \by {
    Sub.RegularChoice[topology ambient, Sub.Singleton y, x, Trace U] {
      open := traceOpen ambient U #open{data}, contains := #contains{data},
      partner := \exact(\into[\Pow CarrierSet](Trace V, { W: \Pow CarrierSet \where Sub.NormalPartner[topology ambient, Sub.Singleton y, Trace U, W] }) \by {
        Sub.NormalPartner[topology ambient, Sub.Singleton y, Trace U, Trace V] {
          open := traceOpen ambient V #open{partner},
          covers := \fun (z: CarrierSet) (equal: z = y) => #covers{partner} z equal,
          disjoint := \fun (z: CarrierSet) (inU: _) (inV: _) => #disjoint{partner} z inU inV,
        }
      }, \Cast[\Pow CarrierSet] ({ W: \Pow CarrierSet \where Sub.NormalPartner[topology ambient, Sub.Singleton y, Trace U, W] })),
    }
  }, \Cast[\Pow CarrierSet] ({ W: \Pow CarrierSet \where Sub.RegularChoice[topology ambient, Sub.Singleton y, x, W] }))
};
\definition TraceRelation(family: \Pow (\Pow CarrierSet)) (U: \Pow Carrier) (W: \Pow CarrierSet): \Prop :=
  Logic.And[Sub.FamilyMember family W, W = Trace U];
\definition compact: \forall (ambient: Topology) -> IsCompactIn ambient S -> Sub.IsCompact (topology ambient) := \block {
  \fun (ambient: _) (compact: _) (family: \Pow (\Pow CarrierSet)) (cover: Sub.IsOpenCover[topology ambient, family, Sub.Whole]) \then
  \let lifted: \Pow (\Pow Carrier) := LiftedFamily ambient family \then
  \let liftedCover: IsOpenCover[ambient, lifted, S] := IsOpenCover[ambient, lifted, S] {
    open := \fun (U: _) (member: _) => #left{member},
    covers := \block {
      \fun (x: Carrier) (inS: Member S x) \then
      \let point: CarrierSet := \into[Carrier](x, S) \by { inS } \then
      \return Sub.unionMemberElim family point (Member (Union lifted) x)
        (\fun (W: \Pow CarrierSet) (inFamily: _) (inW: _) => openTraceElim ambient W (Member (Union lifted) x)
          (\fun (U: \Pow Carrier) (open: _) (same: W = Trace U) => unionMemberOf lifted U x
            (liftedMember ambient family U W open inFamily same)
            (\idelim W = Trace U \with Z: \Pow CarrierSet => Sub.Member Z point \by { base: inW, equality: same }))
          (openRepresentation ambient W (#open{cover} W inFamily))) (#covers{cover} point (\refl(point)))
    },
  } \then
  \takefrom finite: \Cast[AmbientFinite.FiniteSubset] ({ F: AmbientFinite.FiniteSubset \where FiniteSubcover[lifted, S, F] })
    \by compact lifted liftedCover \then
  \let data: FiniteSubcover[lifted, S, finite] := \bysub(AmbientFinite.FiniteSubset,
    { F: AmbientFinite.FiniteSubset \where FiniteSubcover[lifted, S, F] }, finite) \then
  \takefrom selected: Selection.Selection[TraceRelation family, finite] \by
    Selection.existsSelection (TraceRelation family) finite (\fun (U: \Pow Carrier) (member: AmbientFinite.Member finite U) =>
      liftedElim ambient family U (\exists { W: \Pow CarrierSet \where TraceRelation family U W })
        (\fun (W: _) (inFamily: _) (same: _) => \exact(\into[\Pow CarrierSet](W,
          { W: \Pow CarrierSet \where TraceRelation family U W }) \by { Logic.And[_, _]::# inFamily same },
          \Cast[\Pow CarrierSet] ({ W: \Pow CarrierSet \where TraceRelation family U W }))) (#included{data} U member)) \then
  \let result: SubFinite.FiniteSubset := #finite{selected} \then
  \return SubCompact.subcoverExists family Sub.Whole result (Sub.FiniteSubcover[family, Sub.Whole, result] {
    included := \block {
      \fun (W: \Pow CarrierSet) (member: SubFinite.Member result W) \then
      \takefrom U: Selection.RelatedWitness (TraceRelation family) finite W \by #included{selected} W member \then
      \return #left{(#right{(\bysub(\Pow Carrier,
        { U: \Pow Carrier \where Logic.And[AmbientFinite.Member finite U, TraceRelation family U W] }, U))})}
    },
    covers := \fun (x: CarrierSet) (whole: _) => unionMemberElim finite x (Sub.Member (Sub.Union result) x) (\block {
      \fun (U: \Pow Carrier) (member: AmbientFinite.Member finite U) (inU: Member U x) \then
      \takefrom W: Selection.CoveredWitness (TraceRelation family) result U \by #covers{selected} U member \then
      \let wd: Logic.And[SubFinite.Member result W, TraceRelation family U W] := \bysub(\Pow CarrierSet,
        { W: \Pow CarrierSet \where Logic.And[SubFinite.Member result W, TraceRelation family U W] }, W) \then
      \return Sub.unionMemberOf result W x #left{wd}
        (\idelim Trace U = W \with Z: \Pow CarrierSet => Sub.Member Z x
          \by { base: inU, equality: sym!{\Pow CarrierSet} _ _ #right{(#right{wd})} })
    }) (#covers{data} x (\bysub(Carrier, S, x))),
  })
};
