/* The topology induced on a subset by intersections with ambient open sets. */
\import topology.Topology[Carrier := \Cast[Carrier] S] \as Sub;

\definition CarrierSet: \Set := \Cast[Carrier] S;
\definition SubspaceTopology: \Set := Sub.Topology;

\definition Trace(U: \Pow Carrier): \Pow CarrierSet :=
  { x : CarrierSet \where Member U x };

\definition Basis(ambient: Topology): \Pow (\Pow CarrierSet) :=
  { V : \Pow CarrierSet \where
    \exists { U : \Pow Carrier \where
      Logic.And[IsOpenIn ambient U, V = Trace U] } };

\definition topology(ambient: Topology): SubspaceTopology :=
  Sub.generated (Basis ambient);

\definition openSets(ambient: Topology): \Pow (\Pow CarrierSet) :=
  #openSets{(Sub.raw (topology ambient))};

\module Maps(B: \Set);
