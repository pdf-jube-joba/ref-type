/* Elementary topology on a carrier set. */
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\import std.Set[].FiniteSubset[A := \Pow Carrier] \as FiniteFamilies;
\import std.Data[].Nat[] \as N;

\definition Member(S: \Pow Carrier) (x: Carrier): \Prop :=
  \In[Carrier] S x;

\definition FamilyMember(family: \Pow (\Pow Carrier)) (S: \Pow Carrier): \Prop :=
  \In[\Pow Carrier] family S;

\definition Empty: \Pow Carrier :=
  { x : Carrier \where Logic.False };

\definition Whole: \Pow Carrier :=
  { x : Carrier \where x = x };

\definition UnionMember(family: \Pow (\Pow Carrier)) (x: Carrier): \Prop :=
  \exists { U : \Pow Carrier \where Logic.And[FamilyMember family U, Member U x] };

\definition Union(family: \Pow (\Pow Carrier)): \Pow Carrier :=
  { x : Carrier \where UnionMember family x };

\definition unionMemberOf(family: \Pow (\Pow Carrier)) (U: \Pow Carrier) (x: Carrier):
  FamilyMember family U -> Member U x ->
  Member (Union family) x :=
  \fun (inFamily: FamilyMember family U) (inU: Member U x) =>
    \exact(
      \into[\Pow Carrier](U,
        { V : \Pow Carrier \where
          Logic.And[FamilyMember family V, Member V x] })
        \by { Logic.And[_, _]::# inFamily inU },
      \Cast[\Pow Carrier]
        ({ V : \Pow Carrier \where
          Logic.And[FamilyMember family V, Member V x] }));

\definition unionMemberElim(family: \Pow (\Pow Carrier)) (x: Carrier) (P: \Prop):
  (\forall (U: \Pow Carrier) -> FamilyMember family U ->
    Member U x -> P) ->
  Member (Union family) x ->
  P :=
  \block {
    \fun (step: \forall (U: \Pow Carrier) -> FamilyMember family U ->
    Member U x -> P) (member: Member (Union family) x) \then
    \takefrom U: \Cast[\Pow Carrier]
      ({ V : \Pow Carrier \where
        Logic.And[FamilyMember family V, Member V x] })
      \by member \then
    \let evidence: Logic.And[FamilyMember family U, Member U x] :=
      \bysub(\Pow Carrier,
        { V : \Pow Carrier \where
          Logic.And[FamilyMember family V, Member V x] }, U) \then
    \return step U (#left{evidence}) (#right{evidence})
  };

\definition Intersection(S, T: \Pow Carrier): \Pow Carrier :=
  { x : Carrier \where Logic.And[Member S x, Member T x] };

\definition intersectionMember(S, T: \Pow Carrier) (x: Carrier):
  Member S x -> Member T x ->
  Member (Intersection S T) x :=
  \fun (inS: Member S x) (inT: Member T x) => Logic.And[_, _]::# inS inT;

\structure TopologyData: \Set {
  openSets: \Pow (\Pow Carrier),
}

\structure TopologyLaws[data: TopologyData]: \Prop {
  emptyOpen: \In[\Pow Carrier] data.openSets Empty,
  wholeOpen: \In[\Pow Carrier] data.openSets Whole,
  unionOpen: \forall (family: \Pow (\Pow Carrier)) ->
    (\forall (S: \Pow Carrier) -> FamilyMember family S -> \In[\Pow Carrier] data.openSets S) ->
    \In[\Pow Carrier] data.openSets (Union family),
  intersectionOpen: \forall (S, T: \Pow Carrier) ->
    \In[\Pow Carrier] data.openSets S -> \In[\Pow Carrier] data.openSets T ->
    \In[\Pow Carrier] data.openSets (Intersection S T),
}

\definition Topology: \Set :=
  \Cast[TopologyData] ({ data: TopologyData \where TopologyLaws[data] });

\definition topologyData(s: Topology): TopologyData := s;

\definition topologyLaws(s: Topology): TopologyLaws[s] := \bysub(TopologyData, Topology, s);

\definition IsOpen(topology: TopologyData) (S: \Pow Carrier): \Prop :=
  \In[\Pow Carrier] (#openSets{topology}) S;

/* The last two fields express closure under arbitrary unions and finite
 * intersections; binary intersections together with Whole suffice here. */

\definition IsOpenIn(topology: Topology) (S: \Pow Carrier): \Prop :=
  IsOpen (topologyData topology) S;

\definition Subset(S, T: \Pow Carrier): \Prop :=
  \forall (x: Carrier) -> Member S x -> Member T x;

\definition subsetTrans(S, T, U: \Pow Carrier):
  Subset S T -> Subset T U ->
  Subset S U :=
  \fun (st: Subset S T) (tu: Subset T U) (x: Carrier) (member: Member S x) =>
      tu x (st x member);

\structure OpenNeighborhood[
  topology: Topology, x: Carrier, S, U: \Pow Carrier,
]: \Prop := {
  open: IsOpenIn topology U,
  contains: Member U x,
  within: Subset U S,
};

\definition OpenNeighborhoods(topology: Topology) (S: \Pow Carrier): \Pow (\Pow Carrier) :=
  { U : \Pow Carrier \where
    Logic.And[IsOpenIn topology U, Subset U S] };

\definition openOfNeighborhoods(topology: Topology) (S: \Pow Carrier):
  (\forall (x: Carrier) -> Member S x ->
    \exists { U : \Pow Carrier \where
      OpenNeighborhood[topology, x, S, U] }) ->
  IsOpenIn topology S :=
  \block {
    \fun (local: \forall (x: Carrier) -> Member S x ->
    \exists { U : \Pow Carrier \where
      OpenNeighborhood[topology, x, S, U] }) \then
    \let family: \Pow (\Pow Carrier) := OpenNeighborhoods topology S \then
    \let allOpen:
      \forall (U: \Pow Carrier) -> FamilyMember family U ->
        IsOpenIn topology U :=
      \fun (U: \Pow Carrier) =>
        \fun (member: FamilyMember family U) => #left{member} \then
    \let unionOpen: IsOpenIn topology (Union family) :=
      #unionOpen{(topologyLaws topology)} family allOpen \then
    \let equal: Union family = S :=
      \axiom:setext(Union family, S,
        (\fun (x: Carrier) =>
          \fun (member: Member (Union family) x) =>
            unionMemberElim family x (Member S x)
              (\fun (U: \Pow Carrier) =>
                \fun (inFamily: FamilyMember family U) =>
                \fun (inU: Member U x) =>
                  #right{inFamily} x inU)
              member),
        (\fun (x: Carrier) => \fun (inS: Member S x) => \block {
          \takefrom U: \Cast[\Pow Carrier]
            ({ W : \Pow Carrier \where
              OpenNeighborhood[topology, x, S, W] })
            \by local x inS \then
          \let data: OpenNeighborhood[topology, x, S, U] :=
            \bysub(\Pow Carrier,
              { W : \Pow Carrier \where
                OpenNeighborhood[topology, x, S, W] }, U) \then
          \return unionMemberOf family U x
            (Logic.And[_, _]::# (#open{data}) (#within{data}))
            (#contains{data})
        })) \then
    \return \idelim Union family = S
      \with W: \Pow Carrier => IsOpenIn topology W
      \by { base: unionOpen, equality: equal }
  };

\definition Disjoint(S, T: \Pow Carrier): \Prop :=
  \forall (x: Carrier) -> Member S x -> Member T x -> Logic.False;

\definition Complement(S: \Pow Carrier): \Pow Carrier :=
  { x : Carrier \where Logic.Not (Member S x) };

\definition Singleton(x: Carrier): \Pow Carrier :=
  { y : Carrier \where y = x };

\definition IsClosedIn(topology: Topology) (S: \Pow Carrier): \Prop :=
  IsOpenIn topology (Complement S);

\definition IsT1(topology: Topology): \Prop :=
  \forall (x: Carrier) -> IsClosedIn topology (Singleton x);

\structure NormalPartner[
  topology: Topology, G, U, V: \Pow Carrier,
]: \Prop := {
  open: IsOpenIn topology V,
  covers: Subset G V,
  disjoint: Disjoint U V,
};

\structure RegularChoice[
  topology: Topology, F: \Pow Carrier,
  x: Carrier, U: \Pow Carrier,
]: \Prop := {
  open: IsOpenIn topology U,
  contains: Member U x,
  partner: \exists { V : \Pow Carrier \where
    NormalPartner[topology, F, U, V] },
};

\definition IsRegular(topology: Topology): \Prop :=
  \forall (F: \Pow Carrier) -> IsClosedIn topology F ->
  \forall (x: Carrier) -> Logic.Not (Member F x) ->
    \exists { U : \Pow Carrier \where
      RegularChoice[topology, F, x, U] };

\definition IsT2(topology: Topology): \Prop :=
  \forall (x, y: Carrier) -> Logic.Not (x = y) ->
    \exists { U : \Pow Carrier \where
      RegularChoice[topology, (Singleton y), x, U] };

\definition IsT3(topology: Topology): \Prop :=
  Logic.And[IsT1 topology, IsRegular topology];

\definition t3T2(topology: Topology):
  IsT3 topology ->
  IsT2 topology :=
  \fun (t3: IsT3 topology) (x, y: Carrier) (different: Logic.Not (x = y)) =>
      #right{t3} (Singleton y) (#left{t3} y) x different;

\definition IsCountableBasis(topology: Topology) (basis: N.Nat^ -> \Pow Carrier): \Prop :=
  Logic.And[
    \forall (n: N.Nat^) -> IsOpenIn topology (basis n),
    \forall (U: \Pow Carrier) -> IsOpenIn topology U ->
      \forall (x: Carrier) -> Member U x ->
        \exists { n : N.Nat^ \where
          Logic.And[Member (basis n) x, Subset (basis n) U] }];

\definition IsSecondCountable(topology: Topology): \Prop :=
  \exists { basis : N.Nat^ -> \Pow Carrier \where
    IsCountableBasis topology basis };

\structure NormalChoice[
  topology: Topology, F, G, U: \Pow Carrier,
]: \Prop := {
  open: IsOpenIn topology U,
  covers: Subset F U,
  partner: \exists { V : \Pow Carrier \where
    NormalPartner[topology, G, U, V] },
};

\definition IsNormal(topology: Topology): \Prop :=
  \forall (F, G: \Pow Carrier) ->
    IsClosedIn topology F -> IsClosedIn topology G -> Disjoint F G ->
      \exists { U : \Pow Carrier \where
        NormalChoice[topology, F, G, U] };

\definition Covers(family: \Pow (\Pow Carrier)) (S: \Pow Carrier): \Prop :=
  Subset S (Union family);

\definition IsOpenCover(topology: Topology) (family: \Pow (\Pow Carrier)) (S: \Pow Carrier):
  \Prop :=
  Logic.And[Covers family S,
    \forall (U: \Pow Carrier) -> FamilyMember family U -> IsOpenIn topology U];

\definition IsCompactIn(topology: Topology) (S: \Pow Carrier): \Prop :=
  \forall (family: \Pow (\Pow Carrier)) -> IsOpenCover topology family S ->
    \exists { finite : FiniteFamilies.FiniteSubset \where
      Logic.And[\forall (U: \Pow Carrier) ->
        FiniteFamilies.Member finite U -> FamilyMember family U,
        Covers (FiniteFamilies.underlying finite) S] };

\definition IsCompact(topology: Topology): \Prop :=
  IsCompactIn topology Whole;

\definition GeneratedOpen(basis: \Pow (\Pow Carrier)) (S: \Pow Carrier): \Prop :=
  \forall (candidate: TopologyData) -> TopologyLaws[candidate] ->
    (\forall (U: \Pow Carrier) -> FamilyMember basis U -> IsOpen candidate U) ->
    IsOpen candidate S;

\definition GeneratedRaw(basis: \Pow (\Pow Carrier)): TopologyData :=
  TopologyData {
    openSets := { S : \Pow Carrier \where GeneratedOpen basis S },
  };

\definition generatedLaws(basis: \Pow (\Pow Carrier)): TopologyLaws[GeneratedRaw basis] :=
  TopologyLaws[GeneratedRaw basis] {
    emptyOpen := \fun (candidate: TopologyData) =>
      \fun (h: TopologyLaws[candidate]) =>
      \fun (_: \forall (U: \Pow Carrier) -> FamilyMember basis U -> IsOpen candidate U) =>
        #emptyOpen{h},
    wholeOpen := \fun (candidate: TopologyData) =>
      \fun (h: TopologyLaws[candidate]) =>
      \fun (_: \forall (U: \Pow Carrier) -> FamilyMember basis U -> IsOpen candidate U) =>
        #wholeOpen{h},
    unionOpen := \fun (family: \Pow (\Pow Carrier)) =>
      \fun (allOpen: \forall (S: \Pow Carrier) -> FamilyMember family S ->
        IsOpen (GeneratedRaw basis) S) =>
      \fun (candidate: TopologyData) =>
      \fun (h: TopologyLaws[candidate]) =>
      \fun (containsBasis: \forall (U: \Pow Carrier) -> FamilyMember basis U ->
        IsOpen candidate U) =>
        #unionOpen{h} family
          (\fun (S: \Pow Carrier) => \fun (member: FamilyMember family S) =>
            allOpen S member candidate h containsBasis),
    intersectionOpen := \fun (S, T: \Pow Carrier) =>
      \fun (sOpen: IsOpen (GeneratedRaw basis) S) =>
      \fun (tOpen: IsOpen (GeneratedRaw basis) T) =>
      \fun (candidate: TopologyData) =>
      \fun (h: TopologyLaws[candidate]) =>
      \fun (containsBasis: \forall (U: \Pow Carrier) -> FamilyMember basis U ->
        IsOpen candidate U) =>
        #intersectionOpen{h} S T
          (sOpen candidate h containsBasis) (tOpen candidate h containsBasis),
  };

\definition generated(basis: \Pow (\Pow Carrier)): Topology :=
  \into[TopologyData](GeneratedRaw basis, Topology) \by {
    generatedLaws basis
  };

\definition generatedRawEq(basis: \Pow (\Pow Carrier)):
  topologyData (generated basis) = GeneratedRaw basis :=
  \refl(GeneratedRaw basis);

\definition generatedBasisOpen(basis: \Pow (\Pow Carrier)) (S: \Pow Carrier):
  FamilyMember basis S ->
  IsOpenIn (generated basis) S :=
  \fun (member: FamilyMember basis S) =>
    \idelim GeneratedRaw basis = topologyData (generated basis)
      \with candidate: TopologyData => IsOpen candidate S
      \by {
        base: \fun (candidate: TopologyData) =>
          \fun (_: TopologyLaws[candidate]) =>
          \fun (containsBasis: \forall (U: \Pow Carrier) ->
            FamilyMember basis U -> IsOpen candidate U) =>
            containsBasis S member,
        equality: sym!{TopologyData}
          (topologyData (generated basis)) (GeneratedRaw basis) (generatedRawEq basis)
      };

\definition generatedLeast(basis: \Pow (\Pow Carrier)) (candidate: Topology):
  (\forall (U: \Pow Carrier) ->
    FamilyMember basis U -> IsOpenIn candidate U) ->
  \forall (S: \Pow Carrier) -> IsOpenIn (generated basis) S ->
  IsOpenIn candidate S :=
  \fun (containsBasis: \forall (U: \Pow Carrier) ->
    FamilyMember basis U -> IsOpenIn candidate U) (S: \Pow Carrier)
    (open: IsOpenIn (generated basis) S) =>
    (\idelim topologyData (generated basis) = GeneratedRaw basis
      \with source: TopologyData => IsOpen source S
      \by { base: open, equality: generatedRawEq basis })
      (topologyData candidate) (topologyLaws candidate) containsBasis;

\definition IndiscreteBasis: \Pow (\Pow Carrier) :=
  { S : \Pow Carrier \where Logic.Or[S = Empty, S = Whole] };

\definition Indiscrete: Topology := generated IndiscreteBasis;

\definition DiscreteBasis: \Pow (\Pow Carrier) :=
  { S : \Pow Carrier \where S = S };

\definition Discrete: Topology := generated DiscreteBasis;

\definition discreteOpen(S: \Pow Carrier): IsOpenIn Discrete S :=
  generatedBasisOpen DiscreteBasis S (\refl(S));

\module Subspace(S: \Pow Carrier);
\module SingletonSpace(point: Carrier);
\module Presentations;
\module Countability;
\module Normality;
\module Urysohn;
\module Metrization;
