/* Elementary topology on a carrier set. */
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\import std.Set[].FiniteSubset[A := \Pow Carrier] \as FiniteFamilies;

\definition Member (S: \Pow Carrier) (x: Carrier): \Prop :=
  \In[Carrier] S x;

\definition FamilyMember (family: \Pow (\Pow Carrier))
  (S: \Pow Carrier): \Prop :=
  \In[\Pow Carrier] family S;

\definition Empty: \Pow Carrier :=
  { x : Carrier \where Logic.False };

\definition Whole: \Pow Carrier :=
  { x : Carrier \where x = x };

\definition UnionMember (family: \Pow (\Pow Carrier)) (x: Carrier): \Prop :=
  \exists { U : \Pow Carrier \where Logic.And[FamilyMember family U, Member U x] };

\definition Union (family: \Pow (\Pow Carrier)): \Pow Carrier :=
  { x : Carrier \where UnionMember family x };

\definition unionMemberOf (family: \Pow (\Pow Carrier))
  (U: \Pow Carrier) (x: Carrier)
  (inFamily: FamilyMember family U) (inU: Member U x):
  Member (Union family) x :=
  \exact(
    \into[\Pow Carrier](U,
      { V : \Pow Carrier \where
        Logic.And[FamilyMember family V, Member V x] })
      \by { Logic.And[_, _]::# inFamily inU },
    \Cast[\Pow Carrier]
      ({ V : \Pow Carrier \where
        Logic.And[FamilyMember family V, Member V x] }));

\definition unionMemberElim (family: \Pow (\Pow Carrier))
  (x: Carrier) (P: \Prop)
  (step: \forall (U: \Pow Carrier) -> FamilyMember family U ->
    Member U x -> P)
  (member: Member (Union family) x): P :=
  \block {
    \takefrom U: \Cast[\Pow Carrier]
      ({ V : \Pow Carrier \where
        Logic.And[FamilyMember family V, Member V x] })
      \by member \then
    \let evidence: Logic.And[FamilyMember family U, Member U x] :=
      \bysub(\Pow Carrier,
        { V : \Pow Carrier \where
          Logic.And[FamilyMember family V, Member V x] }, U) \then
    \return step U (#left{evidence}) (#right{evidence})
  };

\definition Intersection (S, T: \Pow Carrier): \Pow Carrier :=
  { x : Carrier \where Logic.And[Member S x, Member T x] };

\definition intersectionMember (S, T: \Pow Carrier) (x: Carrier)
  (inS: Member S x) (inT: Member T x):
  Member (Intersection S T) x :=
  Logic.And[_, _]::# inS inT;

\definition intersectionLeft (S, T: \Pow Carrier) (x: Carrier)
  (member: Member (Intersection S T) x): Member S x :=
  #left{member};

\definition intersectionRight (S, T: \Pow Carrier) (x: Carrier)
  (member: Member (Intersection S T) x): Member T x :=
  #right{member};

\record RawTopology[Carrier: \Set]: \Set := {
  openSets: \Pow (\Pow Carrier),
};

\definition IsOpen (topology: RawTopology[Carrier]) (S: \Pow Carrier): \Prop :=
  \In[\Pow Carrier] (#openSets{topology}) S;

/* The last two fields express closure under arbitrary unions and finite
 * intersections; binary intersections together with Whole suffice here. */
\record TopologyLaws[topology: RawTopology[Carrier]]: \Prop := {
  emptyOpen: IsOpen topology Empty,
  wholeOpen: IsOpen topology Whole,
  unionOpen: \forall (family: \Pow (\Pow Carrier)) ->
    (\forall (S: \Pow Carrier) -> FamilyMember family S -> IsOpen topology S) ->
    IsOpen topology (Union family),
  intersectionOpen: \forall (S, T: \Pow Carrier) ->
    IsOpen topology S -> IsOpen topology T ->
    IsOpen topology (Intersection S T),
};

\definition TopologySet: \Pow (RawTopology[Carrier]) :=
  { topology : RawTopology[Carrier] \where TopologyLaws[topology] };

\definition Topology: \Set :=
  \Cast[RawTopology[Carrier]] TopologySet;

\definition raw (topology: Topology): RawTopology[Carrier] := topology;

\definition laws (topology: Topology): TopologyLaws[raw topology] :=
  \bysub(RawTopology[Carrier], TopologySet, topology);

\definition IsOpenIn (topology: Topology) (S: \Pow Carrier): \Prop :=
  IsOpen (raw topology) S;

\definition Subset (S, T: \Pow Carrier): \Prop :=
  \forall (x: Carrier) -> Member S x -> Member T x;

\definition Disjoint (S, T: \Pow Carrier): \Prop :=
  \forall (x: Carrier) -> Member S x -> Member T x -> Logic.False;

\definition Complement (S: \Pow Carrier): \Pow Carrier :=
  { x : Carrier \where Logic.Not (Member S x) };

\definition Singleton (x: Carrier): \Pow Carrier :=
  { y : Carrier \where y = x };

\definition IsClosedIn (topology: Topology) (S: \Pow Carrier): \Prop :=
  IsOpenIn topology (Complement S);

\definition IsT1 (topology: Topology): \Prop :=
  \forall (x: Carrier) -> IsClosedIn topology (Singleton x);

\definition IsT2 (topology: Topology): \Prop :=
  \forall (x, y: Carrier) -> Logic.Not (x = y) ->
    \exists { U : \Pow Carrier \where
      Logic.And[IsOpenIn topology U, Logic.And[Member U x,
        \exists { V : \Pow Carrier \where
          Logic.And[IsOpenIn topology V, Logic.And[Member V y, Disjoint U V]] }]] };

\definition IsRegular (topology: Topology): \Prop :=
  \forall (F: \Pow Carrier) -> IsClosedIn topology F ->
  \forall (x: Carrier) -> Logic.Not (Member F x) ->
    \exists { U : \Pow Carrier \where
      Logic.And[IsOpenIn topology U, Logic.And[Member U x,
        \exists { V : \Pow Carrier \where
          Logic.And[IsOpenIn topology V, Logic.And[Subset F V, Disjoint U V]] }]] };

\definition IsT3 (topology: Topology): \Prop :=
  Logic.And[IsT1 topology, IsRegular topology];

\definition Covers (family: \Pow (\Pow Carrier)) (S: \Pow Carrier): \Prop :=
  Subset S (Union family);

\definition IsOpenCover (topology: Topology) (family: \Pow (\Pow Carrier))
  (S: \Pow Carrier): \Prop :=
  Logic.And[Covers family S,
    \forall (U: \Pow Carrier) -> FamilyMember family U -> IsOpenIn topology U];

\definition IsCompactIn (topology: Topology) (S: \Pow Carrier): \Prop :=
  \forall (family: \Pow (\Pow Carrier)) -> IsOpenCover topology family S ->
    \exists { finite : FiniteFamilies.FiniteSubset \where
      Logic.And[\forall (U: \Pow Carrier) ->
        FiniteFamilies.Member finite U -> FamilyMember family U,
        Covers (FiniteFamilies.underlying finite) S] };

\definition IsCompact (topology: Topology): \Prop :=
  IsCompactIn topology Whole;

\definition GeneratedOpen (basis: \Pow (\Pow Carrier)) (S: \Pow Carrier): \Prop :=
  \forall (candidate: RawTopology[Carrier]) -> TopologyLaws[candidate] ->
    (\forall (U: \Pow Carrier) -> FamilyMember basis U -> IsOpen candidate U) ->
    IsOpen candidate S;

\definition GeneratedRaw (basis: \Pow (\Pow Carrier)): RawTopology[Carrier] :=
  RawTopology[Carrier] {
    openSets := { S : \Pow Carrier \where GeneratedOpen basis S },
  };

\definition generatedLaws (basis: \Pow (\Pow Carrier)):
  TopologyLaws[GeneratedRaw basis] :=
  TopologyLaws[GeneratedRaw basis] {
    emptyOpen := \fun (candidate: RawTopology[Carrier]) =>
      \fun (h: TopologyLaws[candidate]) =>
      \fun (_: \forall (U: \Pow Carrier) -> FamilyMember basis U -> IsOpen candidate U) =>
        #emptyOpen{h},
    wholeOpen := \fun (candidate: RawTopology[Carrier]) =>
      \fun (h: TopologyLaws[candidate]) =>
      \fun (_: \forall (U: \Pow Carrier) -> FamilyMember basis U -> IsOpen candidate U) =>
        #wholeOpen{h},
    unionOpen := \fun (family: \Pow (\Pow Carrier)) =>
      \fun (allOpen: \forall (S: \Pow Carrier) -> FamilyMember family S ->
        IsOpen (GeneratedRaw basis) S) =>
      \fun (candidate: RawTopology[Carrier]) =>
      \fun (h: TopologyLaws[candidate]) =>
      \fun (containsBasis: \forall (U: \Pow Carrier) -> FamilyMember basis U ->
        IsOpen candidate U) =>
        #unionOpen{h} family
          (\fun (S: \Pow Carrier) => \fun (member: FamilyMember family S) =>
            allOpen S member candidate h containsBasis),
    intersectionOpen := \fun (S, T: \Pow Carrier) =>
      \fun (sOpen: IsOpen (GeneratedRaw basis) S) =>
      \fun (tOpen: IsOpen (GeneratedRaw basis) T) =>
      \fun (candidate: RawTopology[Carrier]) =>
      \fun (h: TopologyLaws[candidate]) =>
      \fun (containsBasis: \forall (U: \Pow Carrier) -> FamilyMember basis U ->
        IsOpen candidate U) =>
        #intersectionOpen{h} S T
          (sOpen candidate h containsBasis) (tOpen candidate h containsBasis),
  };

\definition generated (basis: \Pow (\Pow Carrier)): Topology :=
  \into[RawTopology[Carrier]](GeneratedRaw basis, TopologySet) \by {
    generatedLaws basis
  };

\definition generatedRawEq (basis: \Pow (\Pow Carrier)):
  raw (generated basis) = GeneratedRaw basis :=
  \refl(GeneratedRaw basis);

\definition generatedBasisOpen (basis: \Pow (\Pow Carrier))
  (S: \Pow Carrier) (member: FamilyMember basis S):
  IsOpenIn (generated basis) S :=
  \idelim(GeneratedRaw basis = raw (generated basis)
    \with candidate: RawTopology[Carrier] => IsOpen candidate S)
    \by {
      base: \fun (candidate: RawTopology[Carrier]) =>
        \fun (_: TopologyLaws[candidate]) =>
        \fun (containsBasis: \forall (U: \Pow Carrier) ->
          FamilyMember basis U -> IsOpen candidate U) =>
          containsBasis S member,
      equality: sym!{RawTopology[Carrier]}
        (raw (generated basis)) (GeneratedRaw basis) (generatedRawEq basis)
    };

\definition generatedLeast (basis: \Pow (\Pow Carrier))
  (candidate: Topology)
  (containsBasis: \forall (U: \Pow Carrier) ->
    FamilyMember basis U -> IsOpenIn candidate U)
  (S: \Pow Carrier) (open: IsOpenIn (generated basis) S):
  IsOpenIn candidate S :=
  (\idelim(raw (generated basis) = GeneratedRaw basis
    \with source: RawTopology[Carrier] => IsOpen source S)
    \by { base: open, equality: generatedRawEq basis })
    (raw candidate) (laws candidate) containsBasis;

\definition IndiscreteBasis: \Pow (\Pow Carrier) :=
  { S : \Pow Carrier \where Logic.Or[S = Empty, S = Whole] };

\definition Indiscrete: Topology := generated IndiscreteBasis;

\definition DiscreteBasis: \Pow (\Pow Carrier) :=
  { S : \Pow Carrier \where S = S };

\definition Discrete: Topology := generated DiscreteBasis;

\definition discreteOpen (S: \Pow Carrier): IsOpenIn Discrete S :=
  generatedBasisOpen DiscreteBasis S (\refl(S));

\module Subspace(S: \Pow Carrier);
\module SingletonSpace(point: Carrier);
\module Presentations;
