\import \parent.Rays[] \as Rays;
\import \parent.CompactIntervals[] \as Intervals;
\import MetricTopology.Hausdorff[] \as Hausdorff;
\definition RayFamily: \Pow (\Pow Real.Real) :=
  { U: \Pow Real.Real \where \exists { b: Real.Real \where U = Rays.Below b } };
\definition RayBound(U: \Pow Real.Real)(b: Real.Real): \Prop := Space.Subset U (Rays.Below b);
\definition FamilyBound(family: \Pow (\Pow Real.Real))(b: Real.Real): \Prop :=
  \forall (U: \Pow Real.Real) -> Space.FamilyMember family U -> RayBound U b;
\definition rayMonotone: \forall (a, b: Real.Real) -> R.Le a b -> Space.Subset (Rays.Below a) (Rays.Below b) :=
  \fun (a, b: _)(less: _)(x: _)(member: _) => R.ltLeTrans x a b member less;
\definition finiteBound: \forall (F: Finite.FiniteSubset) ->
  (\forall (U: \Pow Real.Real) -> Finite.Member F U -> \exists { b: Real.Real \where RayBound U b }) ->
  \exists { b: Real.Real \where FamilyBound F b } :=
  Finite.induction ({ F: \Pow (\Pow Real.Real) \where
    (\forall (U: \Pow Real.Real) -> Space.FamilyMember F U -> \exists { b: Real.Real \where RayBound U b }) ->
    \exists { b: Real.Real \where FamilyBound F b } })
    (\fun (bounds: _) => \exact(\into[Real.Real](Real.zero,
      { b: Real.Real \where FamilyBound Finite.Empty b }) \by {
        \fun (U: _)(empty: Logic.False)(x: _)(member: _) => Logic.falseElim (R.Lt x Real.zero) empty
      }, \Cast[Real.Real] ({ b: Real.Real \where FamilyBound Finite.Empty b })))
    (\block {
      \fun (F: \Pow (\Pow Real.Real))
        (previous: (\forall (V: \Pow Real.Real) -> Space.FamilyMember F V -> \exists { b: Real.Real \where RayBound V b }) -> \exists { b: Real.Real \where FamilyBound F b })
        (U: \Pow Real.Real)
        (bounds: \forall (V: \Pow Real.Real) -> Space.FamilyMember (Finite.Insert U F) V -> \exists { b: Real.Real \where RayBound V b }) \then
      \takefrom a: \Cast[Real.Real] ({ a: Real.Real \where RayBound U a }) \by bounds U (Finite.inInsertNew U F) \then
      \let ua: RayBound U a := \bysub(Real.Real, { a: Real.Real \where RayBound U a }, a) \then
      \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where FamilyBound F b })
        \by previous (\fun (V: _)(member: _) => bounds V (Finite.inInsertOld U F V member)) \then
      \let fb: FamilyBound F b := \bysub(Real.Real, { b: Real.Real \where FamilyBound F b }, b) \then
      \let c: Real.Real := Distance.max a b \then
      \return \exact(\into[Real.Real](c, { c: Real.Real \where FamilyBound (Finite.Insert U F) c }) \by {
        \fun (V: \Pow Real.Real)(member: Space.FamilyMember (Finite.Insert U F) V) =>
          either!{{V = U} "or" {Space.FamilyMember F V} "either" {RayBound V c}
            "lt:" {\fun (equal: V = U) => \idelim U = V \with W: \Pow Real.Real => RayBound W c \by {
              base: \fun (x: Real.Real)(inside: Space.Member U x) => rayMonotone a c (Distance.maxLeft a b) x (ua x inside),
              equality: sym!{\Pow Real.Real} _ _ equal
            }}
            "rt:" {\fun (old: _) (x: _) (inside: _) => rayMonotone b c (Distance.maxRight a b) x (fb V old x inside)}} member
      }, \Cast[Real.Real] ({ c: Real.Real \where FamilyBound (Finite.Insert U F) c }))
    });
\definition compactBounded: \forall (S: \Pow Real.Real) -> Space.IsCompactIn topology S -> Complete.Bounded S := \block {
  \fun (S: _)(compact: _) \then
  \takefrom F: \Cast[Finite.FiniteSubset] ({ F: Finite.FiniteSubset \where Space.FiniteSubcover[RayFamily, S, F] })
    \by compact RayFamily (Space.IsOpenCover[topology, RayFamily, S] {
      open := \block {
        \fun (U: _)(member: _) \then
        \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where U = Rays.Below b }) \by member \then
        \return \idelim Rays.Below b = U \with V: \Pow Real.Real => Space.IsOpenIn topology V \by {
          base: Rays.belowOpen b, equality: sym!{\Pow Real.Real} _ _ (\bysub(Real.Real, { b: Real.Real \where U = Rays.Below b }, b))
        }
      },
      covers := \fun (x: Real.Real)(member: Space.Member S x) => Space.unionMemberOf RayFamily (Rays.Below (Real.add x Real.one)) x
        (\exact(\into[Real.Real](Real.add x Real.one, { b: Real.Real \where Rays.Below (Real.add x Real.one) = Rays.Below b }) \by {
          \refl(Rays.Below (Real.add x Real.one))
        }, \Cast[Real.Real] ({ b: Real.Real \where Rays.Below (Real.add x Real.one) = Rays.Below b })))
        (Intervals.addPositive x Real.one (Order.ltOfLeNotEq Real.zero Real.one Laws.oneNonnegative Laws.zeroNeOne)),
    }) \then
  \let cover: Space.FiniteSubcover[RayFamily, S, F] := \bysub(Finite.FiniteSubset,
    { F: Finite.FiniteSubset \where Space.FiniteSubcover[RayFamily, S, F] }, F) \then
  \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where FamilyBound F b }) \by finiteBound F (\block {
    \fun (U: _)(inF: _) \then
    \takefrom a: \Cast[Real.Real] ({ a: Real.Real \where U = Rays.Below a }) \by #included{cover} U inF \then
    \let equal: U = Rays.Below a := \bysub(Real.Real, { a: Real.Real \where U = Rays.Below a }, a) \then
    \return \exact(\into[Real.Real](a, { a: Real.Real \where RayBound U a }) \by {
      \fun (x: Real.Real)(member: Space.Member U x) => \idelim U = Rays.Below a
        \with V: \Pow Real.Real => Space.Member V x \by { base: member, equality: equal }
    }, \Cast[Real.Real] ({ a: Real.Real \where RayBound U a }))
  }) \then
  \let bound: FamilyBound F b := \bysub(Real.Real, { b: Real.Real \where FamilyBound F b }, b) \then
  \return \exact(\into[Real.Real](b, { b: Real.Real \where Complete.UpperBound S b }) \by {
    \fun (x: Real.Real)(member: Space.Member S x) => Space.unionMemberElim F x (R.Le x b)
      (\fun (U: _)(inF: _)(inside: _) => Order.leOfLt x b (bound U inF x inside)) (#covers{cover} x member)
  }, \Cast[Real.Real] ({ b: Real.Real \where Complete.UpperBound S b }))
};
\definition supremumMember: \forall (S: Complete.Family) -> Space.IsClosedIn topology S -> Space.Member S (Complete.supremum S) :=
  \fun (S: _)(closed: _) => Order.byContradiction (Space.Member S (Complete.supremum S)) (\block {
    \fun (outside: _) \then
    \let a: Real.Real := Complete.supremum S \then
    \takefrom r: \Cast[Real.Real] (MetricSpace.NeighborhoodRadius Metric.metric (Space.Complement S) a) \by closed a outside \then
    \let radius: Logic.And[R.Lt Real.zero r, Space.Subset (MetricSpace.Ball Metric.metric a r) (Space.Complement S)] :=
      \bysub(Real.Real, MetricSpace.NeighborhoodRadius Metric.metric (Space.Complement S) a, r) \then
    \let h: Real.Real := Real.mul Real.half r \then
    \let positive: R.Lt Real.zero h := Estimates.halfOfPositive r (#left{radius}) \then
    \takefrom x: \Cast[Real.Real] ({ x: Real.Real \where Logic.And[Complete.Member S x, R.Lt (Real.sub a h) x] })
      \by Intervals.belowSupremum S (Real.sub a h) (Intervals.subPositive a h positive) \then
    \let data: Logic.And[Complete.Member S x, R.Lt (Real.sub a h) x] :=
      \bysub(Real.Real, { x: Real.Real \where Logic.And[Complete.Member S x, R.Lt (Real.sub a h) x] }, x) \then
    \let near: R.Lt (Real.distance a x) r := R.leLtTrans _ h r
      (Estimates.distanceLeOfInterval a x h (Order.leOfLt _ _ (#right{data}))
        (R.leTrans x a (Real.add a h) (Complete.supremumUpper S x (#left{data}))
          (Order.leOfLt _ _ (Intervals.addPositive a h positive))))
      (Estimates.halfStrict r (#left{radius})) \then
    \return #right{radius} x near (#left{data})
  });
\structure Maximum[S: \Pow Real.Real, a: Real.Real]: \Prop {
  member: Space.Member S a,
  upper: Complete.UpperBound S a,
}
\definition compactMaximum: \forall (S: \Pow Real.Real) -> Complete.Nonempty S -> Space.IsCompactIn topology S ->
  \exists { a: Real.Real \where Maximum[S, a] } := \block {
  \fun (S: _)(nonempty: _)(compact: _) \then
  \let family: Complete.Family := \into[\Pow Real.Real](S, Complete.FamilySet) \by {
    Logic.And[_, _]::# nonempty (compactBounded S compact)
  } \then
  \let closed: Space.IsClosedIn topology S := Compactness.compactClosed topology (Hausdorff.topologyT2 Metric.metric) S compact \then
  \return \exact(\into[Real.Real](Complete.supremum family, { a: Real.Real \where Maximum[S, a] }) \by {
    Maximum[S, Complete.supremum family] { member := supremumMember family closed, upper := Complete.supremumUpper family }
  }, \Cast[Real.Real] ({ a: Real.Real \where Maximum[S, a] }))
};
