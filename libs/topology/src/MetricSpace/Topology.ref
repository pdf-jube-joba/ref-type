\use Logic.either;
\definition openOfRadius(metric: Metric) (U: \Pow Carrier) (x: Carrier) (radius: R.Real):
  R.Lt Real.zero radius -> T.Subset (Ball metric x radius) U ->
  \exists { r : R.Real \where \In[R.Real] (NeighborhoodRadius metric U x) r } :=
  \fun (positive: R.Lt Real.zero radius) (contained: T.Subset (Ball metric x radius) U) =>
    \exact(
      \into[R.Real](radius, NeighborhoodRadius metric U x) \by {
        Logic.And[_, _]::# positive contained
      },
      \Cast[R.Real] (NeighborhoodRadius metric U x));

\definition emptyOpen(metric: Metric): IsOpen metric T.Empty :=
  \fun (x: Carrier) (inside: T.Member T.Empty x) =>
    Logic.falseElim
      (\exists { r : R.Real \where \In[R.Real] (NeighborhoodRadius metric T.Empty x) r })
      inside;

\definition wholeOpen(metric: Metric): IsOpen metric T.Whole :=
  \fun (x: Carrier) (_: T.Member T.Whole x) =>
    openOfRadius metric T.Whole x Real.one
      (Order.ltOfLeNotEq Real.zero Real.one RealLaws.oneNonnegative RealLaws.zeroNeOne)
      (\fun (y: Carrier) => \fun (_: T.Member (Ball metric x Real.one) y) => \refl(y));

\definition unionOpen(metric: Metric) (family: \Pow (\Pow Carrier)):
  (\forall (U: \Pow Carrier) -> T.FamilyMember family U -> IsOpen metric U) ->
  IsOpen metric (T.Union family) :=
  \fun (allOpen: \forall (U: \Pow Carrier) -> T.FamilyMember family U -> IsOpen metric U) =>
    \fun (x: Carrier) => \fun (inside: T.Member (T.Union family) x) =>
      T.unionMemberElim family x
        (\exists { r : R.Real \where
          \In[R.Real] (NeighborhoodRadius metric (T.Union family) x) r })
        (\fun (U: \Pow Carrier) => \fun (inFamily: T.FamilyMember family U) =>
          \fun (inU: T.Member U x) => \block {
            \takefrom r: \Cast[R.Real] (NeighborhoodRadius metric U x)
              \by allOpen U inFamily x inU \then
            \let h: Logic.And[R.Lt Real.zero r, T.Subset (Ball metric x r) U] :=
              \bysub(R.Real, NeighborhoodRadius metric U x, r) \then
            \return openOfRadius metric (T.Union family) x r (#left{h})
              (\fun (y: Carrier) => \fun (inBall: T.Member (Ball metric x r) y) =>
                T.unionMemberOf family U y inFamily (#right{h} y inBall))
          }) inside;

\definition intersectionRadius(metric: Metric) (U, V: \Pow Carrier) (x: Carrier) (r, s: R.Real):
  \In[R.Real] (NeighborhoodRadius metric U x) r ->
  \In[R.Real] (NeighborhoodRadius metric V x) s -> R.Le r s ->
  \exists { t : R.Real \where
    \In[R.Real] (NeighborhoodRadius metric (T.Intersection U V) x) t } :=
  \fun (hr: \In[R.Real] (NeighborhoodRadius metric U x) r)
    (hs: \In[R.Real] (NeighborhoodRadius metric V x) s) (rs: R.Le r s) =>
    openOfRadius metric (T.Intersection U V) x r (#left{hr})
      (\fun (y: Carrier) => \fun (inside: T.Member (Ball metric x r) y) =>
        T.intersectionMember U V y (#right{hr} y inside)
          (#right{hs} y (ballMonotone metric x r s rs y inside)));

\definition intersectionOpen(metric: Metric) (U, V: \Pow Carrier):
  IsOpen metric U -> IsOpen metric V ->
  IsOpen metric (T.Intersection U V) :=
  \fun (uOpen: IsOpen metric U) (vOpen: IsOpen metric V) (x: Carrier)
    (inside: T.Member (T.Intersection U V) x) => \block {
      \takefrom r: \Cast[R.Real] (NeighborhoodRadius metric U x)
        \by uOpen x (#left{inside}) \then
      \takefrom s: \Cast[R.Real] (NeighborhoodRadius metric V x)
        \by vOpen x (#right{inside}) \then
      \let hr: \In[R.Real] (NeighborhoodRadius metric U x) r :=
        \bysub(R.Real, NeighborhoodRadius metric U x, r) \then
      \let hs: \In[R.Real] (NeighborhoodRadius metric V x) s :=
        \bysub(R.Real, NeighborhoodRadius metric V x, s) \then
      \return either!{
        {R.Le r s} "or" {R.Le s r} "either" {\exists { t : R.Real \where
          \In[R.Real] (NeighborhoodRadius metric (T.Intersection U V) x) t }}
        "lt:" {intersectionRadius metric U V x r s hr hs}
        "rt:" {\fun (sr: R.Le s r) =>
          openOfRadius metric (T.Intersection U V) x s (#left{hs})
            (\fun (y: Carrier) => \fun (inBall: T.Member (Ball metric x s) y) =>
              T.intersectionMember U V y
                (#right{hr} y (ballMonotone metric x s r sr y inBall))
                (#right{hs} y inBall))}
      }
        (Order.leTotal r s)
    };

\definition raw(metric: Metric): T.TopologyData :=
  T.TopologyData {
    openSets := { U : \Pow Carrier \where IsOpen metric U },
  };

\definition laws(metric: Metric): T.TopologyLaws[raw metric] :=
  T.TopologyLaws[raw metric] {
    emptyOpen := emptyOpen metric,
    wholeOpen := wholeOpen metric,
    unionOpen := unionOpen metric,
    intersectionOpen := intersectionOpen metric,
  };

\definition topology(metric: Metric): T.Topology :=
  \into[T.TopologyData](raw metric, T.Topology) \by { laws metric };

\definition openIff(metric: Metric) (U: \Pow Carrier):
  Logic.PropEquiv[T.IsOpenIn (topology metric) U, IsOpen metric U] :=
  Logic.PropEquiv[_, _] {
    ltr := \fun (h: T.IsOpenIn (topology metric) U) => h,
    rtl := \fun (h: IsOpen metric U) => h,
  };

\definition Compatible(metric: Metric) (space: T.Topology): \Prop :=
  \forall (U: \Pow Carrier) ->
    Logic.PropEquiv[T.IsOpenIn space U, IsOpen metric U];

\definition Metrizable(space: T.Topology): \Prop :=
  \exists { metric : Metric \where Compatible metric space };

\definition inducedMetrizable(metric: Metric): Metrizable (topology metric) :=
  \exact(
    \into[Metric](metric,
      { m : Metric \where Compatible m (topology metric) })
      \by { openIff metric },
    \Cast[Metric]
      ({ m : Metric \where Compatible m (topology metric) }));

/* At y in B(x, r), the radius r - d(x, y) stays inside B(x, r). */
\definition ballOpen(metric: Metric) (x: Carrier) (radius: R.Real):
  IsOpen metric (Ball metric x radius) :=
  \fun (y: Carrier) (inside: T.Member (Ball metric x radius) y) => \block {
    \let d: R.Real := #distance{metric} x y \then
    \let remaining: R.Real := Real.add (Real.neg d) radius \then
    \let positive: R.Lt Real.zero remaining :=
      R.ltReplaceLeft (Real.add (Real.neg d) d) Real.zero remaining
        (RealLaws.addNegLeft d) (RealLaws.ltAddLeft (Real.neg d) d radius inside) \then
    \let cancel: Real.add d remaining = radius :=
      RealLaws.addCancelLeft (Real.neg d) (Real.add d remaining) radius
        (RealLaws.addNegCancelLeft d remaining) \then
    \return openOfRadius metric (Ball metric x radius) y remaining positive
      (\fun (z: Carrier) => \fun (near: T.Member (Ball metric y remaining) z) =>
        R.leLtTrans (#distance{metric} x z) (Real.add d (#distance{metric} y z)) radius
          (#triangle{metric} x y z)
          (R.ltReplaceRight (Real.add d (#distance{metric} y z))
            (Real.add d remaining) radius cancel
            (RealLaws.ltAddLeft d (#distance{metric} y z) remaining near)))
  };

\definition ballOpenIn(metric: Metric) (x: Carrier) (radius: R.Real):
  T.IsOpenIn (topology metric) (Ball metric x radius) :=
  #rtl{(openIff metric (Ball metric x radius))} (ballOpen metric x radius);

\definition positiveDistance(metric: Metric) (x, y: Carrier):
  Logic.Not (x = y) ->
  R.Lt Real.zero (#distance{metric} x y) :=
  \fun (different: Logic.Not (x = y)) =>
    Order.ltOfLeNotEq Real.zero (#distance{metric} x y)
      (#nonnegative{metric} x y)
      (\fun (zero: Real.zero = #distance{metric} x y) =>
        different (#separated{metric} x y
          (sym!{R.Real} Real.zero (#distance{metric} x y) zero)));

\definition singletonClosed(metric: Metric) (x: Carrier):
  T.IsClosedIn (topology metric) (T.Singleton x) :=
  #rtl{(openIff metric (T.Complement (T.Singleton x)))}
    (\fun (y: Carrier) => \fun (outside: Logic.Not (y = x)) =>
      openOfRadius metric (T.Complement (T.Singleton x)) y
        (#distance{metric} y x) (positiveDistance metric y x outside)
        (\fun (z: Carrier) =>
          \fun (near: T.Member (Ball metric y (#distance{metric} y x)) z) =>
          \fun (equal: z = x) =>
            R.ltIrrefl (#distance{metric} y x)
              (\idelim z = x
                \with w: Carrier => R.Lt (#distance{metric} y w) (#distance{metric} y x)
                \by { base: near, equality: equal })));

\definition topologyT1(metric: Metric): T.IsT1 (topology metric) :=
  singletonClosed metric;

\definition metrizableT1(space: T.Topology):
  Metrizable space ->
  T.IsT1 space :=
  \block {
    \fun (metrizable: Metrizable space) \then
    \takefrom metric: \Cast[Metric]
      ({ m : Metric \where Compatible m space })
      \by metrizable \then
    \let compatible: Compatible metric space :=
      \bysub(Metric,
        { m : Metric \where Compatible m space }, metric) \then
    \return \fun (x: Carrier) =>
      #rtl{(compatible (T.Complement (T.Singleton x)))}
        (#ltr{(openIff metric (T.Complement (T.Singleton x)))}
          (singletonClosed metric x))
  };
