\import topology.Topology[Carrier := A] \as Space;
\import Space.Compactness[] \as Compact;
\structure CompactNeighborhood[topology: Space.Topology, point: A]: \Set {
  openSet: \Pow A,
  compactSet: \Pow A,
  open: Space.IsOpenIn topology openSet,
  contains: Space.Member openSet point,
  enclosed: Space.Subset openSet compactSet,
  compact: Space.IsCompactIn topology compactSet,
}
\definition IsLocallyCompact(topology: Space.Topology): \Prop :=
  \forall (x: A) -> \exists CompactNeighborhood[topology, x];
\definition compactLocallyCompact: \forall (topology: Space.Topology) -> Space.IsCompact topology -> IsLocallyCompact topology :=
  \fun (topology: _) (compact: _) (x: _) => \exact(CompactNeighborhood[topology, x] {
    openSet := Space.Whole, compactSet := Space.Whole,
    open := #wholeOpen{(Space.topologyLaws topology)}, contains := \refl(x),
    enclosed := \fun (y: _) (h: _) => h, compact := compact,
  }, CompactNeighborhood[topology, x]);
