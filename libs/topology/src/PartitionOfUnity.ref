\import topology.Topology[Carrier := A] \as Space;
\import Space.Compactness[] \as Compactness;
\import Space.Closure[] \as Closure;
\import Space.Finite[] \as FiniteSets;
\import Space.Urysohn[] \as Urysohn;
\import topology.RealFunctions[A := A] \as Functions;
\import Functions.Bounded[] \as Bounded;
\import Functions.Urysohn[] \as UrysohnFunctions;
\import real.Analysis[] \as Real;
\import real.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import Real.Algebra[] \as Algebra;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\use Equality.trans;
\use Equality.eq_reason;
\use Logic.either;
\definition Nonzero(f: A -> Real.Real): \Pow A := { x: A \where Logic.Not (f x = Real.zero) };
\definition support(source: Space.Topology) (f: A -> Real.Real): \Pow A := Closure.closure source (Nonzero f);
\structure Bump[source: Space.Topology, family: \Pow (\Pow A)]: \Set {
  openSet: \Pow A,
  value: Bounded.Function[source],
  oneRegion: \Pow A,
  inCover: Space.FamilyMember family openSet,
  regionOpen: Space.IsOpenIn source oneRegion,
  oneOn: \forall (x: A) -> Space.Member oneRegion x -> value x = Real.one,
  supportWithin: Space.Subset (support source value) openSet,
}
\module Bumps;
\module Of(source: Space.Topology, family: \Pow (\Pow A));
