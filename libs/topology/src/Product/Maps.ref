\import topology.Continuity[A := CarrierSet, B := A] \as First;
\import topology.Continuity[A := CarrierSet, B := B] \as Second;
\import \parent.Universal[X := CarrierSet] \as Universal;
\import Pair.Prop[A := A, B := B] \as PairLaws;
\import std.Logic[].Equality[] \as Equality;
\use Equality::sym;

\definition firstContinuous: \forall (left: Left.Topology) (right: Right.Topology) ->
  First.Continuous (topology left right) left (Pair.first A B) :=
  \fun (left: _) (right: _) (U: _) (open: _) =>
    \idelim Rectangle U Right.Whole = First.Preimage (Pair.first A B) U
      \with W: \Pow CarrierSet => ProductSpace.IsOpenIn (topology left right) W
      \by {
        base: ProductSpace.generatedBasisOpen (Basis left right) (Rectangle U Right.Whole)
          (Universal.rectangleBasisMember left right U Right.Whole open (#wholeOpen{(Right.topologyLaws right)})),
        equality: \axiom:setext(Rectangle U Right.Whole, First.Preimage (Pair.first A B) U,
          \fun (p: CarrierSet) (h: ProductSpace.Member (Rectangle U Right.Whole) p) => #left{h},
          \fun (p: CarrierSet) (h: _) => Logic.And[_, _]::# h (\refl(Pair.second A B p)))
      };
\definition secondContinuous: \forall (left: Left.Topology) (right: Right.Topology) ->
  Second.Continuous (topology left right) right (Pair.second A B) :=
  \fun (left: _) (right: _) (V: _) (open: _) =>
    \idelim Rectangle Left.Whole V = Second.Preimage (Pair.second A B) V
      \with W: \Pow CarrierSet => ProductSpace.IsOpenIn (topology left right) W
      \by {
        base: ProductSpace.generatedBasisOpen (Basis left right) (Rectangle Left.Whole V)
          (Universal.rectangleBasisMember left right Left.Whole V (#wholeOpen{(Left.topologyLaws left)}) open),
        equality: \axiom:setext(Rectangle Left.Whole V, Second.Preimage (Pair.second A B) V,
          \fun (p: CarrierSet) (h: ProductSpace.Member (Rectangle Left.Whole V) p) => #right{h},
          \fun (p: CarrierSet) (h: _) => Logic.And[_, _]::# (\refl(Pair.first A B p)) h)
      };
