\import topology.Continuity[A := A, B := B] \as First;
\import topology.Topology[Carrier := A] \as Source;
\import topology.Topology[Carrier := B] \as Middle;
\import topology.Continuity[A := B, B := C] \as After;
\import topology.Continuity[A := A, B := C] \as Composite;
\import topology.Topology[Carrier := C] \as Target;

\definition composeContinuous(source: Source.Topology::[Set]) (middle: Middle.Topology::[Set])
  (target: Target.Topology::[Set]) (f: A -> B) (g: B -> C):
  First.Continuous source middle f ->
  After.Continuous middle target g ->
  Composite.Continuous source target (First.compose C f g) :=
  \fun (fContinuous: First.Continuous source middle f) (gContinuous: After.Continuous middle target g)
    (W: \Pow C) (open: Target.IsOpenIn target W) =>
      fContinuous (After.Preimage g W) (gContinuous W open);
