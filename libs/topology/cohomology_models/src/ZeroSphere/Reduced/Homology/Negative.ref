\import \parent.At[z := I.Int^::negSucc n] \as Shift;
\import Modules.Isomorphism[V := Shift.source.Carrier, W := Shift.target.Carrier, source := Shift.source.space, target := Shift.target.space].Vanishing[] \as Vanishing;
\definition zero: \forall (q: Shift.source.Carrier) -> q = (Shift.source.space).zero :=
  Vanishing.sourceZero Shift.isomorphism Empty.Negative[n := n].zero;
