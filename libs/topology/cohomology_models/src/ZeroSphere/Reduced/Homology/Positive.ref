\import \parent.At[z := I.Int^::ofNat (N.Nat^::succ n)] \as Shift;
\import Modules.Isomorphism[V := Shift.source.Carrier, W := Shift.target.Carrier, source := Shift.source.space, target := Shift.target.space].Vanishing[] \as Vanishing;
\definition zero: \forall (q: Shift.source.Carrier) -> q = #zero{Shift.source.space} :=
  Vanishing.sourceZero Shift.isomorphism (Empty.Positive[n := n].zero empty);
