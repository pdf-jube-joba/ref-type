\import singular_cohomology.Chains[A := Cover.Intersection, source := IntersectionTopology.topology (Left.topology Sphere.discrete)].Reduced[].With[coefficients := coefficients].At[z := z] \as Source;
\import singular_cohomology.Chains[A := Sphere.Point, source := Sphere.discrete].Reduced[].With[coefficients := coefficients].At[z := Degrees.next z] \as Middle;
\import singular_cohomology.Chains[A := Spheres.Carrier N.Nat^::zero, source := Spheres.topology N.Nat^::zero].Reduced[].With[coefficients := coefficients].At[z := Degrees.next z] \as Target;
\definition source: Modules.Bundle := Modules.Bundle { Carrier := Source.Carrier, space := Source.space };
\definition target: Modules.Bundle := Modules.Bundle { Carrier := Target.Carrier, space := Target.space };
\import singular_cohomology.Equivalence[A := Sphere.Point, B := Spheres.Carrier N.Nat^::zero, source := Sphere.discrete, target := Spheres.topology N.Nat^::zero]
  .Reduced[].With[coefficients := coefficients].At[z := Degrees.next z] \as Comparison;
\import Modules.Isomorphism[V := Source.Carrier, W := Middle.Carrier, source := Source.space, target := Middle.space]
  .Composition[U := Target.Carrier, final := Target.space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Isomorphism :=
  Composition.compose (Comparison.isomorphism equivalence)
    (Cover.With[coefficients := coefficients].At[z := z].isomorphism (LeftContraction.contraction leftUnique) (RightContraction.contraction rightUnique));
