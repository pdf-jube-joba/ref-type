\import \parent.At[z := I.Int^::ofNat n] \as Suspension;
\import Modules.Isomorphism[V := Suspension.source.Carrier, W := Suspension.target.Carrier, source := Suspension.source.space, target := Suspension.target.space].Vanishing[] \as Vanishing;
