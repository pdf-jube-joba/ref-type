\import Covers.On[cover := cover].Chains[] \as Cover;
\import Cover.Disjoint[] \as Disjoint;
\import singular_cohomology.Cochains[A := Sphere.Point, source := Sphere.discrete].With[coefficients := coefficients] \as PointCochains;
\import PointCochains.Integer[] \as PointInteger;
\import singular_cohomology.Cochains[A := Left.CarrierSet, source := Left.topology Sphere.discrete].With[coefficients := coefficients] \as LeftCochains;
\import LeftCochains.Integer[] \as LeftInteger;
\import singular_cohomology.Cochains[A := Right.CarrierSet, source := Right.topology Sphere.discrete].With[coefficients := coefficients] \as RightCochains;
\import RightCochains.Integer[] \as RightInteger;
\import singular_cohomology.Calculations[A := Left.CarrierSet, source := Left.topology Sphere.discrete].With[coefficients := coefficients].Singleton[a := leftPoint] \as LeftCalculation;
\import singular_cohomology.Calculations[A := Right.CarrierSet, source := Right.topology Sphere.discrete].With[coefficients := coefficients].Singleton[a := rightPoint] \as RightCalculation;
\import Modules.Biproduct[V := coefficients.Carrier, W := coefficients.Carrier, left := coefficients.space, right := coefficients.space] \as CoefficientPairs;
\definition coefficientPairs: Modules.Bundle := Modules.Bundle { Carrier := CoefficientPairs.Carrier, space := CoefficientPairs.space };
\import \root.Isomorphisms[] \as Isomorphisms;
\module Degree(n: N.Nat^);
\module Zero;
\module Positive(n: N.Nat^);
\module OnSphere(n: N.Nat^);
