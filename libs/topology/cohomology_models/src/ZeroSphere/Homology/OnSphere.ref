\definition degree: I.Int^ := I.Int^::ofNat n;
\import \parent.Degree[n := n] \as Point;
\import singular_cohomology.Chains[A := Spheres.Carrier N.Nat^::zero, source := Spheres.topology N.Nat^::zero] \as SphereChains;
\import Nonnegative.ZeroExtension[C := SphereChains.complex] \as SphereExtension;
\import Signed.At[C := SphereExtension.complex, z := degree] \as H;
\definition sphere: Modules.Bundle := Modules.Bundle { Carrier := H.Homology, space := H.homologySpace };
\import singular_cohomology.Equivalence[A := Sphere.Point, B := Spheres.Carrier N.Nat^::zero, source := Sphere.discrete, target := Spheres.topology N.Nat^::zero].Signed[].Homology[z := degree] \as Comparison;
\definition isomorphism: Modules.Isomorphism[V := Point.native.Carrier, W := sphere.Carrier, source := Point.native.space, target := sphere.space].Isomorphism := Comparison.isomorphism equivalence;
\import Modules.Isomorphism[V := Point.native.Carrier, W := sphere.Carrier, source := Point.native.space, target := sphere.space].Inverse[] \as Inverse;
\definition inverse: Modules.Isomorphism[V := sphere.Carrier, W := Point.native.Carrier, source := sphere.space, target := Point.native.space].Isomorphism := Inverse.inverse isomorphism;
