\definition degree: I.Int^ := I.Int^::ofNat n;
\import Signed.At[C := PointExtension.complex, z := degree] \as Whole;
\import Signed.At[C := LeftExtension.complex, z := degree] \as LeftH;
\import Signed.At[C := RightExtension.complex, z := degree] \as RightH;
\definition native: Modules.Bundle := Modules.Bundle { Carrier := Whole.Homology, space := Whole.homologySpace };
\definition left: Modules.Bundle := Modules.Bundle { Carrier := LeftH.Homology, space := LeftH.homologySpace };
\definition right: Modules.Bundle := Modules.Bundle { Carrier := RightH.Homology, space := RightH.homologySpace };
\import Modules.Biproduct[V := left.Carrier, W := right.Carrier, left := left.space, right := right.space] \as Pairs;
\definition pair: Modules.Bundle := Modules.Bundle { Carrier := Pairs.Carrier, space := Pairs.space };
\definition isomorphism: Modules.Isomorphism[V := native.Carrier, W := pair.Carrier, source := native.space, target := pair.space].Isomorphism :=
  Disjoint.Homology[].At[z := degree].isomorphism disjoint;
