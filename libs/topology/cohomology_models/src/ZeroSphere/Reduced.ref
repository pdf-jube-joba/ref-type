\import Covers.On[cover := cover].Reduced[] \as Cover;
\import algebraic_topology.Contraction[A := Left.CarrierSet, source := Left.topology Sphere.discrete].Singleton[a := leftPoint] \as LeftContraction;
\import algebraic_topology.Contraction[A := Right.CarrierSet, source := Right.topology Sphere.discrete].Singleton[a := rightPoint] \as RightContraction;
\definition empty: \forall (x: Cover.Intersection) -> Logic.False :=
  \fun (x: Cover.Intersection) => disjoint x (\bysub(Sphere.Point, left, x)) (\bysub(Left.CarrierSet, Cover.intersection, x));
\import algebraic_topology.HomotopyEquivalence[A := Sphere.Point, B := Spheres.Carrier N.Nat^::zero] \as Equivalences;
\definition equivalence: Equivalences.Equivalence[Sphere.discrete, Spheres.topology N.Nat^::zero] :=
  Equivalences.fromHomeomorphism Sphere.discrete (Spheres.topology N.Nat^::zero) Geometry.homeomorphism;
\module With(coefficients: Modules.Bundle);
\module Homology;
