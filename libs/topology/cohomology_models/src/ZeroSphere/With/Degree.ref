\definition degree: I.Int^ := I.Int^::ofNat n;
\import Disjoint.With[coefficients := coefficients].At[z := degree] \as Split;
\definition signed: Modules.Bundle := Modules.Bundle { Carrier := PointInteger.cohomology degree, space := PointInteger.cohomologySpace degree };
\definition native: Modules.Bundle := Modules.Bundle { Carrier := PointCochains.cohomology n, space := PointCochains.cohomologySpace n };
\definition left: Modules.Bundle := Modules.Bundle { Carrier := LeftInteger.cohomology degree, space := LeftInteger.cohomologySpace degree };
\definition right: Modules.Bundle := Modules.Bundle { Carrier := RightInteger.cohomology degree, space := RightInteger.cohomologySpace degree };
\definition leftNative: Modules.Bundle := Modules.Bundle { Carrier := LeftCochains.cohomology n, space := LeftCochains.cohomologySpace n };
\definition rightNative: Modules.Bundle := Modules.Bundle { Carrier := RightCochains.cohomology n, space := RightCochains.cohomologySpace n };
\import Modules.Biproduct[V := left.Carrier, W := right.Carrier, left := left.space, right := right.space] \as Pairs;
\definition pair: Modules.Bundle := Modules.Bundle { Carrier := Pairs.Carrier, space := Pairs.space };
\definition nativeComparison: Modules.Isomorphism[V := signed.Carrier, W := native.Carrier, source := signed.space, target := native.space].Isomorphism := PointInteger.At[n := n].isomorphism;
\definition leftComparison: Modules.Isomorphism[V := left.Carrier, W := leftNative.Carrier, source := left.space, target := leftNative.space].Isomorphism := LeftInteger.At[n := n].isomorphism;
\definition rightComparison: Modules.Isomorphism[V := right.Carrier, W := rightNative.Carrier, source := right.space, target := rightNative.space].Isomorphism := RightInteger.At[n := n].isomorphism;
\definition comparison: Modules.Isomorphism[V := signed.Carrier, W := pair.Carrier, source := signed.space, target := pair.space].Isomorphism := Split.isomorphism disjoint;
\import Modules.Isomorphism[V := signed.Carrier, W := native.Carrier, source := signed.space, target := native.space].Inverse[] \as Reverse;
\import Modules.Isomorphism[V := native.Carrier, W := signed.Carrier, source := native.space, target := signed.space]
  .Composition[U := pair.Carrier, final := pair.space] \as Composition;
\definition nativeIsomorphism: Modules.Isomorphism[V := native.Carrier, W := pair.Carrier, source := native.space, target := pair.space].Isomorphism :=
  Composition.compose comparison (Reverse.inverse nativeComparison);
