\import \parent.Degree[n := N.Nat^::zero] \as Degree;
\import \parent.OnSphere[n := N.Nat^::zero] \as SphereComparison;
\import Modules.Isomorphism[V := coefficients.Carrier, W := Degree.leftNative.Carrier, source := coefficients.space, target := Degree.leftNative.space].Inverse[] \as LeftReverse;
\import Modules.Isomorphism[V := coefficients.Carrier, W := Degree.rightNative.Carrier, source := coefficients.space, target := Degree.rightNative.space].Inverse[] \as RightReverse;
\import Modules.Isomorphism[V := Degree.left.Carrier, W := Degree.leftNative.Carrier, source := Degree.left.space, target := Degree.leftNative.space]
  .Composition[U := coefficients.Carrier, final := coefficients.space] \as LeftComposition;
\import Modules.Isomorphism[V := Degree.right.Carrier, W := Degree.rightNative.Carrier, source := Degree.right.space, target := Degree.rightNative.space]
  .Composition[U := coefficients.Carrier, final := coefficients.space] \as RightComposition;
\definition leftIsomorphism: Modules.Isomorphism[V := Degree.left.Carrier, W := coefficients.Carrier, source := Degree.left.space, target := coefficients.space].Isomorphism :=
  LeftComposition.compose (LeftReverse.inverse (LeftCalculation.Zero[].isomorphism leftUnique)) Degree.leftComparison;
\definition rightIsomorphism: Modules.Isomorphism[V := Degree.right.Carrier, W := coefficients.Carrier, source := Degree.right.space, target := coefficients.space].Isomorphism :=
  RightComposition.compose (RightReverse.inverse (RightCalculation.Zero[].isomorphism rightUnique)) Degree.rightComparison;
\import Isomorphisms.Product[A := Degree.left, B := Degree.right, C := coefficients, D := coefficients] \as Product;
\definition pairIsomorphism: Modules.Isomorphism[V := Degree.pair.Carrier, W := CoefficientPairs.Carrier, source := Degree.pair.space, target := CoefficientPairs.space].Isomorphism :=
  Product.isomorphism leftIsomorphism rightIsomorphism;
\import Modules.Isomorphism[V := Degree.native.Carrier, W := Degree.pair.Carrier, source := Degree.native.space, target := Degree.pair.space]
  .Composition[U := CoefficientPairs.Carrier, final := CoefficientPairs.space] \as PointComposition;
\definition pointIsomorphism: Modules.Isomorphism[V := Degree.native.Carrier, W := CoefficientPairs.Carrier, source := Degree.native.space, target := CoefficientPairs.space].Isomorphism :=
  PointComposition.compose pairIsomorphism Degree.nativeIsomorphism;
\import Modules.Isomorphism[V := SphereComparison.sphere.Carrier, W := Degree.native.Carrier, source := SphereComparison.sphere.space, target := Degree.native.space]
  .Composition[U := CoefficientPairs.Carrier, final := CoefficientPairs.space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := SphereComparison.sphere.Carrier, W := CoefficientPairs.Carrier, source := SphereComparison.sphere.space, target := CoefficientPairs.space].Isomorphism :=
  Composition.compose pointIsomorphism SphereComparison.inverse;
