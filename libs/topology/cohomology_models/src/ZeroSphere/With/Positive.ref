\import \parent.Degree[n := N.Nat^::succ n] \as Degree;
\import \parent.OnSphere[n := N.Nat^::succ n] \as SphereComparison;
\import Modules.Biproduct[V := Degree.left.Carrier, W := Degree.right.Carrier, left := Degree.left.space, right := Degree.right.space] \as Parts;
\import std.Data[].Pair[].Prop[A := Degree.left.Carrier, B := Degree.right.Carrier] \as Pairs;
\import Isomorphisms.Vanishing[A := Degree.left, B := Degree.leftNative] \as LeftVanishing;
\import Isomorphisms.Vanishing[A := Degree.right, B := Degree.rightNative] \as RightVanishing;
\definition leftZero: \forall (q: Degree.left.Carrier) -> q = #zero{Degree.left.space} :=
  LeftVanishing.zero Degree.leftComparison (LeftCalculation.positiveCohomology leftUnique n);
\definition rightZero: \forall (q: Degree.right.Carrier) -> q = #zero{Degree.right.space} :=
  RightVanishing.zero Degree.rightComparison (RightCalculation.positiveCohomology rightUnique n);
\definition pairZero: \forall (q: Degree.pair.Carrier) -> q = #zero{Degree.pair.space} :=
  \fun (q: Degree.pair.Carrier) => Pairs.ext q #zero{Degree.pair.space} (leftZero (Parts.first q)) (rightZero (Parts.second q));
\import Isomorphisms.Vanishing[A := Degree.native, B := Degree.pair] \as PointVanishing;
\definition pointZero: \forall (q: Degree.native.Carrier) -> q = #zero{Degree.native.space} :=
  PointVanishing.zero Degree.nativeIsomorphism pairZero;
\import Isomorphisms.Vanishing[A := SphereComparison.sphere, B := SphereComparison.point] \as Vanishing;
\definition zero: \forall (q: SphereComparison.sphere.Carrier) -> q = #zero{SphereComparison.sphere.space} :=
  Vanishing.zero SphereComparison.inverse pointZero;
