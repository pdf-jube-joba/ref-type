\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\module Disk(n: N.Nat^) {
  \import algebraic_topology.Euclidean[].Dimension[n := n] \as Geometry;
  \import Geometry.Contraction[] \as Contraction;
  \module With(coefficients: Modules.Bundle) {
    \import singular_cohomology.Calculations[A := Geometry.Disk, source := Geometry.diskTopology].With[coefficients := coefficients].Contractible[] \as Calculation;
    \definition degreeZero: _ := Calculation.zeroIsomorphism Contraction.contraction;
    \definition positive: _ := Calculation.positiveCohomology Contraction.contraction;
  }
}
\module ZeroSphere {
  \import algebraic_topology.Spheres[].Zero[] \as Sphere;
  \import Sphere.Topology[] \as Geometry;
  \definition homeomorphism: _ := Geometry.homeomorphism;
  \definition forward[p: Sphere.Point]: algebraic_topology.Spheres[].Carrier N.Nat^::zero := (Geometry.homeomorphism).forward p;
  \definition north: forward Sphere.Point::positive = Sphere.north := \refl(Sphere.north);
  \definition south: forward Sphere.Point::negative = Sphere.south := \refl(Sphere.south);
  \definition allPoints: \forall (x: algebraic_topology.Spheres[].Carrier N.Nat^::zero) ->
    std.Logic[].Proposition[].Or[x = Sphere.north, x = Sphere.south] := Sphere.cases;
}
