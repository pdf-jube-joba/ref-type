\import Covers.On[cover := cover].Chains[] \as Theory;
\definition chainSequence: _ := Theory.Sequence[].sequence;
\definition cochainSequence: _ := Theory.With[coefficients := coefficients].sequence;
\definition homologyConnecting[z: I.Int^]: _ := Theory.Homology[].At[z := z].connecting;
\definition homologyExactAtSum[z: I.Int^]: _ := Theory.Homology[].At[z := z].exactAtSum;
\definition homologyExactAtSpace[z: I.Int^]: _ := Theory.Homology[].At[z := z].exactAtWhole;
\definition homologyExactAtIntersection[z: I.Int^]: _ := Theory.Homology[].At[z := z].exactAtIntersection;
\definition cohomologyConnecting[z: I.Int^]: _ := Theory.Cohomology[coefficients := coefficients].At[z := z].connecting;
\definition cohomologyExactAtSum[z: I.Int^]: _ := Theory.Cohomology[coefficients := coefficients].At[z := z].exactAtSum;
\definition cohomologyExactAtSpace[z: I.Int^]: _ := Theory.Cohomology[coefficients := coefficients].At[z := z].exactAtWhole;
\definition cohomologyExactAtIntersection[z: I.Int^]: _ := Theory.Cohomology[coefficients := coefficients].At[z := z].exactAtIntersection;
