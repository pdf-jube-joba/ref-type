\import Geometry.Positive[n := n].Connected[] \as GeometryConnected;
\import singular_cohomology.Zero[A := Geometry.Carrier (N.Nat^::succ n), source := Geometry.topology (N.Nat^::succ n)]
  .With[coefficients := coefficients].Connected[point := Geometry.point (N.Nat^::succ n)] \as Calculation;
\definition isomorphism: Modules.Isomorphism[V := coefficients.Carrier, W := cohomology (N.Nat^::succ n) N.Nat^::zero,
  source := coefficients.space, target := space (N.Nat^::succ n) N.Nat^::zero].Isomorphism := Calculation.isomorphism GeometryConnected.connected;
