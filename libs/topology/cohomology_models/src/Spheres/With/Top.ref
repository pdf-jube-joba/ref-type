\import \parent.Reduced[] \as Reduced;
\import singular_cohomology.Cochains[A := Geometry.Carrier (N.Nat^::succ n), source := Geometry.topology (N.Nat^::succ n)].With[coefficients := coefficients].Reduced[].Positive[n := n] \as Comparison;
\import Modules.Isomorphism[V := coefficients.Carrier, W := Reduced.cohomology (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ n)), source := coefficients.space, target := Reduced.space (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ n))]
  .Composition[U := cohomology (N.Nat^::succ n) (N.Nat^::succ n), final := space (N.Nat^::succ n) (N.Nat^::succ n)] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := coefficients.Carrier, W := cohomology (N.Nat^::succ n) (N.Nat^::succ n), source := coefficients.space, target := space (N.Nat^::succ n) (N.Nat^::succ n)].Isomorphism :=
  Composition.compose Comparison.isomorphism (Reduced.top (N.Nat^::succ n));
