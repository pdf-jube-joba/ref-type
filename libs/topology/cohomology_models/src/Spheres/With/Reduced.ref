\import chain_complexes.Integer[] \as Degrees;
\module At(n: N.Nat^, z: I.Int^) {
  \import singular_cohomology.Chains[A := Geometry.Carrier n, source := Geometry.topology n].Reduced[].With[coefficients := coefficients].At[z := z] \as Theory;
  \definition Carrier: \Set := Theory.Carrier;
  \definition space: Modules.Space Carrier := Theory.space;
}
\definition cohomology(n: N.Nat^)(z: I.Int^): \Set := At[n := n, z := z].Carrier;
\definition space(n: N.Nat^)(z: I.Int^): Modules.Space (cohomology n z) := At[n := n, z := z].space;
\definition TopIsomorphism(n: N.Nat^): \Set := Modules.Isomorphism[V := coefficients.Carrier, W := cohomology n (I.Int^::ofNat n), source := coefficients.space, target := space n (I.Int^::ofNat n)].Isomorphism;
\import \root.ZeroSphere[].Reduced[].With[coefficients := coefficients] \as Base;
\module TopStep(n: N.Nat^);
\definition top: \forall (n: N.Nat^) -> TopIsomorphism n :=
  \induction (n: N.Nat^) \return TopIsomorphism n \with {
    | zero: Base.Zero[].isomorphism
    | succ: \fun (n: N.Nat^)(previous: TopIsomorphism n) => TopStep[n := n].isomorphism previous
  };
\definition aboveDegree(n, k: N.Nat^): I.Int^ := I.Int^::ofNat (Nat.add k (N.Nat^::succ n));
\module AboveStep(n, k: N.Nat^);
\definition above: \forall (n, k: N.Nat^)(q: cohomology n (aboveDegree n k)) -> q = #zero{(space n (aboveDegree n k))} :=
  \induction (n: N.Nat^) \return \forall (k: N.Nat^)(q: cohomology n (aboveDegree n k)) -> q = #zero{(space n (aboveDegree n k))} \with {
    | zero: \fun (k: N.Nat^) => Base.Positive[n := k].zero
    | succ: \fun (n: N.Nat^)(previous: _)(k: N.Nat^) => AboveStep[n := n, k := k].zero (previous k)
  };
\module NegativeStep(n, k: N.Nat^);
\definition negative: \forall (n, k: N.Nat^)(q: cohomology n (I.Int^::negSucc k)) -> q = #zero{(space n (I.Int^::negSucc k))} :=
  \induction (n: N.Nat^) \return \forall (k: N.Nat^)(q: cohomology n (I.Int^::negSucc k)) -> q = #zero{(space n (I.Int^::negSucc k))} \with {
    | zero: \fun (k: N.Nat^) => Base.Negative[n := k].zero
    | succ: \fun (n: N.Nat^)(previous: _)(k: N.Nat^) => NegativeStep[n := n, k := k].zero (previous (N.Nat^::succ k))
  };
\module BelowStep(k, distance: N.Nat^);
\module BelowZero(distance: N.Nat^);
\definition below: \forall (k, distance: N.Nat^)(q: cohomology (Nat.add (N.Nat^::succ distance) k) (I.Int^::ofNat k)) ->
  q = #zero{(space (Nat.add (N.Nat^::succ distance) k) (I.Int^::ofNat k))} :=
  \induction (k: N.Nat^) \return \forall (distance: N.Nat^)(q: cohomology (Nat.add (N.Nat^::succ distance) k) (I.Int^::ofNat k)) ->
    q = #zero{(space (Nat.add (N.Nat^::succ distance) k) (I.Int^::ofNat k))} \with {
      | zero: \fun (distance: N.Nat^) => BelowZero[distance := distance].zero (negative distance N.Nat^::zero)
      | succ: \fun (k: N.Nat^)(previous: _)(distance: N.Nat^) => BelowStep[k := k, distance := distance].zero (previous distance)
    };
