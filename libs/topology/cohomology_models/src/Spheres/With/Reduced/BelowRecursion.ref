\import \parent.NegativeRecursion[] \as Negative;
\definition value: \forall (k, distance: N.Nat^)(q: cohomology (Nat.add (N.Nat^::succ distance) k) (I.Int^::ofNat k)) ->
  q = (space (Nat.add (N.Nat^::succ distance) k) (I.Int^::ofNat k)).zero :=
  \induction (k: N.Nat^) \return \forall (distance: N.Nat^)(q: cohomology (Nat.add (N.Nat^::succ distance) k) (I.Int^::ofNat k)) ->
    q = (space (Nat.add (N.Nat^::succ distance) k) (I.Int^::ofNat k)).zero \with {
      | zero: \fun (distance: N.Nat^) => \parent.BelowZero[distance := distance].zero (Negative.value distance N.Nat^::zero)
      | succ: \fun (k: N.Nat^)(previous: _)(distance: N.Nat^) => \parent.BelowStep[k := k, distance := distance].zero (previous distance)
    };
