\definition value: \forall (n, k: N.Nat^)(q: cohomology n (aboveDegree n k)) -> q = #zero{(space n (aboveDegree n k))} :=
  \induction (n: N.Nat^) \return \forall (k: N.Nat^)(q: cohomology n (aboveDegree n k)) -> q = #zero{(space n (aboveDegree n k))} \with {
    | zero: \fun (k: N.Nat^) => Base.Positive[n := k].zero
    | succ: \fun (n: N.Nat^)(previous: _)(k: N.Nat^) => \parent.AboveStep[n := n, k := k].zero (previous k)
  };
