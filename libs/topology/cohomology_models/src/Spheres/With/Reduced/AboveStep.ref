\import \root.SphereCover[n := n].With[coefficients := coefficients].Reduced[z := aboveDegree n k] \as Shift;
\import Modules.Isomorphism[V := cohomology n (aboveDegree n k), W := cohomology (N.Nat^::succ n) (aboveDegree (N.Nat^::succ n) k), source := space n (aboveDegree n k), target := space (N.Nat^::succ n) (aboveDegree (N.Nat^::succ n) k)].Vanishing[] \as Vanishing;
\definition zero[previous: \forall (q: cohomology n (aboveDegree n k)) -> q = (space n (aboveDegree n k)).zero]:
  \forall (q: cohomology (N.Nat^::succ n) (aboveDegree (N.Nat^::succ n) k)) -> q = (space (N.Nat^::succ n) (aboveDegree (N.Nat^::succ n) k)).zero :=
  Vanishing.targetZero Shift.isomorphism previous;
