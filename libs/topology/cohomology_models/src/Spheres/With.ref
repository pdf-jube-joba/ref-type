\module At(n: N.Nat^) {
  \import singular_cohomology.Cochains[A := Geometry.Carrier n, source := Geometry.topology n].With[coefficients := coefficients] \as Theory;
  \module Degree(k: N.Nat^) {
    \import Theory.Cohomology[n := k] \as Native;
    \definition Carrier: \Set := Native.Carrier;
    \definition space: Modules.Space Carrier := Native.space;
  }
  \definition Carrier(k: N.Nat^): \Set := Degree[k := k].Carrier;
  \definition space(k: N.Nat^): Modules.Space (Carrier k) := Degree[k := k].space;
}
\definition cohomology(n, k: N.Nat^): \Set := At[n := n].Carrier k;
\definition space(n, k: N.Nat^): Modules.Space (cohomology n k) := At[n := n].space k;
\definition aboveDegree(n, k: N.Nat^): N.Nat^ := Nat.add k (N.Nat^::succ n);
\module AboveStep(n, k: N.Nat^);
\module Zero(n: N.Nat^);
\module Reduced;
\import \root.ZeroSphere[].With[coefficients := coefficients] \as ZeroSphere;
\module AboveRecursion;
\definition above: \forall (n, k: N.Nat^)(q: cohomology n (aboveDegree n k)) -> q = #zero{(space n (aboveDegree n k))} :=
  AboveRecursion[].value;
\module Top(n: N.Nat^);
\module Below(k, distance: N.Nat^);
