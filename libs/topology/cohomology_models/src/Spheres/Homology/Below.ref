\definition dimension: N.Nat^ := Nat.add (N.Nat^::succ distance) (N.Nat^::succ k);
\definition degree: N.Nat^ := N.Nat^::succ k;
\import \parent.Reduced[] \as Reduced;
\import singular_cohomology.Chains[A := Geometry.Carrier dimension, source := Geometry.topology dimension].Reduced[].Positive[n := k] \as Comparison;
\import Modules.Isomorphism[V := Reduced.homology dimension (I.Int^::ofNat degree), W := homology dimension degree, source := Reduced.space dimension (I.Int^::ofNat degree), target := space dimension degree].Vanishing[] \as Vanishing;
\definition zero: \forall (q: homology dimension degree) -> q = #zero{(space dimension degree)} :=
  Vanishing.targetZero Comparison.isomorphism (Reduced.below degree distance);
