\import \root.SphereCover[n := n].Homology[z := I.Int^::negSucc k] \as Shift;
\import Modules.Isomorphism[V := homology n (I.Int^::negSucc (N.Nat^::succ k)), W := homology (N.Nat^::succ n) (I.Int^::negSucc k), source := space n (I.Int^::negSucc (N.Nat^::succ k)), target := space (N.Nat^::succ n) (I.Int^::negSucc k)].Vanishing[] \as Vanishing;
\definition zero[previous: \forall (q: homology n (I.Int^::negSucc (N.Nat^::succ k))) -> q = (space n (I.Int^::negSucc (N.Nat^::succ k))).zero]:
  \forall (q: homology (N.Nat^::succ n) (I.Int^::negSucc k)) -> q = (space (N.Nat^::succ n) (I.Int^::negSucc k)).zero :=
  Vanishing.targetZero Shift.upward previous;
