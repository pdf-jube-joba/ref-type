\import Geometry.Positive[n := n].Connected[] \as GeometryConnected;
\import singular_cohomology.Zero[A := Geometry.Carrier (N.Nat^::succ n), source := Geometry.topology (N.Nat^::succ n)].Homology[]
  .Connected[point := Geometry.point (N.Nat^::succ n)] \as Calculation;
\import singular_cohomology.Chains[A := Geometry.Carrier (N.Nat^::succ n), source := Geometry.topology (N.Nat^::succ n)] \as Chains;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].DegreeZero[C := Chains.complex] \as Native;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := Chains.complex].DegreeZeroHomology[] \as Extension;
\import Modules.Isomorphism[V := I.Int^, W := Native.Homology, source := Modules.scalarModule, target := Native.homologySpace]
  .Composition[U := homology (N.Nat^::succ n) N.Nat^::zero, final := space (N.Nat^::succ n) N.Nat^::zero] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := I.Int^, W := homology (N.Nat^::succ n) N.Nat^::zero,
  source := Modules.scalarModule, target := space (N.Nat^::succ n) N.Nat^::zero].Isomorphism :=
  Composition.compose Extension.isomorphism (Calculation.isomorphism GeometryConnected.connected);
