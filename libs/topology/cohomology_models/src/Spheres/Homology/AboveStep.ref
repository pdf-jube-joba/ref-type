\import \parent.Reduced[] \as Reduced;
\import singular_cohomology.Chains[A := Geometry.Carrier n, source := Geometry.topology n].Reduced[].Positive[n := Nat.add k n] \as Comparison;
\import Modules.Isomorphism[V := Reduced.homology n (Reduced.aboveDegree n k), W := homology n (aboveDegree n k), source := Reduced.space n (Reduced.aboveDegree n k), target := space n (aboveDegree n k)].Vanishing[] \as Vanishing;
\definition zero: \forall (q: homology n (aboveDegree n k)) -> q = #zero{(space n (aboveDegree n k))} :=
  Vanishing.targetZero Comparison.isomorphism (Reduced.above n k);
