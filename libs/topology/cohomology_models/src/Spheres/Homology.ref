\module At(n: N.Nat^) {
  \import singular_cohomology.Chains[A := Geometry.Carrier n, source := Geometry.topology n] \as Theory;
  \import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
  \import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := Theory.complex] \as Extension;
  \module Degree(k: N.Nat^) {
    \import Complexes.At[C := Extension.complex, z := I.Int^::ofNat k] \as H;
    \definition Carrier: \Set := H.Homology;
    \definition space: Modules.Space Carrier := H.homologySpace;
  }
  \definition Carrier[k: N.Nat^]: \Set := Degree[k := k].Carrier;
  \definition space[k: N.Nat^]: Modules.Space (Carrier k) := Degree[k := k].space;
}
\definition homology[n, k: N.Nat^]: \Set := At[n := n].Carrier k;
\definition space[n, k: N.Nat^]: Modules.Space (homology n k) := At[n := n].space k;
\definition aboveDegree[n, k: N.Nat^]: N.Nat^ := Nat.add k (N.Nat^::succ n);
\module AboveStep(n, k: N.Nat^);
\module Zero(n: N.Nat^);
\module Reduced;
\definition above: \forall (n, k: N.Nat^)(q: homology n (aboveDegree n k)) -> q = (space n (aboveDegree n k)).zero :=
  \fun (n, k: N.Nat^) => AboveStep[n := n, k := k].zero;
\module Top(n: N.Nat^);
\module Below(k, distance: N.Nat^);
