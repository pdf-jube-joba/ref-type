\definition action(f: Sphere -> Sphere)(continuous: Maps.Continuous f): Modules.Hom[V := Carrier, W := Carrier, source := space, target := space].Map :=
  Pull.At[n := dimension].induced f continuous Scalars.identity;
\definition conjugate(f: Sphere -> Sphere)(continuous: Maps.Continuous f): ScalarMaps.Map := Second.compose toCoefficient (First.compose (action f continuous) fromCoefficient);
\definition degree(f: Sphere -> Sphere)(continuous: Maps.Continuous f): I.Int^ := #apply{(conjugate f continuous)} I.One.specification;
\definition onCoefficients: \forall (f: Sphere -> Sphere)(continuous: Maps.Continuous f)(a: I.Int^) ->
  #apply{(conjugate f continuous)} a = #mul{Integers.ring} a (degree f continuous) :=
  \fun (f: Sphere -> Sphere)(continuous: Maps.Continuous f)(a: I.Int^) => trans!{I.Int^} _ _ _
    (sym!{I.Int^} _ _ (congr!{I.Int^ I.Int^} (#apply{(conjugate f continuous)}) _ _ (#rightIdentity{(#multiplicative{(#semiring{Integers.ring})})} a)))
    (#scalar{(conjugate f continuous)} a I.One.specification);
\definition onBasis: \forall (f: Sphere -> Sphere)(continuous: Maps.Continuous f)(a: I.Int^) ->
  #apply{(action f continuous)} (#apply{fromCoefficient} a) = #apply{fromCoefficient} (#mul{Integers.ring} a (degree f continuous)) :=
  \fun (f: Sphere -> Sphere)(continuous: Maps.Continuous f)(a: I.Int^) => trans!{Carrier} _ _ _
    (sym!{Carrier} _ _ (#rightInverse{Top.isomorphism} (#apply{(action f continuous)} (#apply{fromCoefficient} a))))
    (congr!{I.Int^ Carrier} (#apply{fromCoefficient}) _ _ (onCoefficients f continuous a));
