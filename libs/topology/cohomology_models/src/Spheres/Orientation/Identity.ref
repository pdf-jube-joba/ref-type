\import singular_cohomology.Identity[A := Sphere, source := topology] \as Identity;
\definition law: degree Identity.function Identity.continuous = I.One.specification :=
  trans!{I.Int^} _ _ _
    (congr!{Carrier I.Int^} (#apply{toCoefficient}) _ _ (Identity.Coefficients[M := coefficients].At[n := dimension].cohomologyIdentity generator))
    (#leftInverse{Top.isomorphism} I.One.specification);
