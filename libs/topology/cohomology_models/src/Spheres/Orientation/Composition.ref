\import Maps.Composition[C := Sphere, final := topology].Coefficients[M := coefficients] \as Functoriality;
\import topology.Composition[A := Sphere, B := Sphere, C := Sphere] \as Continuous;
\definition law: \forall (f, g: Sphere -> Sphere)(fc: Maps.Continuous f)(gc: Maps.Continuous g) ->
  degree (\fun (x: Sphere) => g (f x)) (Continuous.composeContinuous topology topology topology f g fc gc) = #mul{Integers.ring} (degree f fc) (degree g gc) :=
  \fun (f, g: Sphere -> Sphere)(fc: Maps.Continuous f)(gc: Maps.Continuous g) => trans!{I.Int^} _ _ _
    (congr!{Carrier I.Int^} (#apply{toCoefficient}) _ _ (Functoriality.onCohomology f fc g gc dimension generator))
    (trans!{I.Int^} _ _ _
      (congr!{Carrier I.Int^} (\fun (q: Carrier) => #apply{toCoefficient} (#apply{(action f fc)} q)) _ _
        (sym!{Carrier} _ _ (#rightInverse{Top.isomorphism} (#apply{(action g gc)} generator))))
      (trans!{I.Int^} _ _ _
        (congr!{Carrier I.Int^} (#apply{toCoefficient}) _ _ (onBasis f fc (degree g gc)))
        (trans!{I.Int^} _ _ _ (#leftInverse{Top.isomorphism} (#mul{Integers.ring} (degree g gc) (degree f fc)))
          (#mulCommutative{Integers.commutativeRing} (degree g gc) (degree f fc)))));
