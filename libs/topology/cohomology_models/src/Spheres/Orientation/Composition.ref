\import Maps.Composition[C := Sphere, final := topology].Coefficients[M := coefficients] \as Functoriality;
\import topology.Composition[A := Sphere, B := Sphere, C := Sphere] \as Continuous;
\definition law: \forall (f, g: Sphere -> Sphere)(fc: Maps.Continuous f)(gc: Maps.Continuous g) ->
  degree (\fun (x: Sphere) => g (f x)) (Continuous.composeContinuous topology topology topology f g fc gc) = (Integers.ring).mul (degree f fc) (degree g gc) :=
  \fun (f, g: Sphere -> Sphere)(fc: Maps.Continuous f)(gc: Maps.Continuous g) => trans!{I.Int^} _ _ _
    (congr!{Carrier I.Int^} ((toCoefficient).apply) _ _ (Functoriality.onCohomology f fc g gc dimension generator))
    (trans!{I.Int^} _ _ _
      (congr!{Carrier I.Int^} (\fun (q: Carrier) => (toCoefficient).apply ((action f fc).apply q)) _ _
        (sym!{Carrier} _ _ ((Top.isomorphism).rightInverse ((action g gc).apply generator))))
      (trans!{I.Int^} _ _ _
        (congr!{Carrier I.Int^} ((toCoefficient).apply) _ _ (onBasis f fc (degree g gc)))
        (trans!{I.Int^} _ _ _ ((Top.isomorphism).leftInverse ((Integers.ring).mul (degree g gc) (degree f fc)))
          ((Integers.commutativeRing).mulCommutative (degree g gc) (degree f fc)))));
