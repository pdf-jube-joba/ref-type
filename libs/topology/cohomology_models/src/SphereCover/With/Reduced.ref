\import singular_excision.MayerVietoris[A := Geometry.Sphere].Over[source := Spheres.topology (N.Nat^::succ n)]
  .On[cover := cover].Reduced[].With[coefficients := coefficients].At[z := z] \as Suspension;
\import singular_cohomology.Chains[A := Spheres.Carrier n, source := Spheres.topology n].Reduced[].With[coefficients := coefficients].At[z := z] \as Lower;
\import singular_cohomology.Chains[A := Geometry.Intersection, source := Geometry.intersectionTopology].Reduced[].With[coefficients := coefficients].At[z := z] \as Intersection;
\import chain_complexes.Integer[] \as Degrees;
\import singular_cohomology.Chains[A := Geometry.Sphere, source := Spheres.topology (N.Nat^::succ n)].Reduced[].With[coefficients := coefficients].At[z := Degrees.next z] \as Upper;
\import singular_cohomology.Equivalence[A := Spheres.Carrier n, B := Geometry.Intersection, source := Spheres.topology n, target := Geometry.intersectionTopology]
  .Reduced[].With[coefficients := coefficients].At[z := z] \as Comparison;
\import Modules.Isomorphism[V := Lower.Carrier, W := Intersection.Carrier, source := Lower.space, target := Intersection.space]
  .Composition[U := Upper.Carrier, final := Upper.space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Lower.Carrier, W := Upper.Carrier, source := Lower.space, target := Upper.space].Isomorphism :=
  Composition.compose (Suspension.isomorphism leftContraction rightContraction) (Comparison.isomorphism intersectionEquivalence);
