\import \root.Basic[] \as Basic;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import Modules.Zero[] \as Zero;
\definition zero: Modules.Bundle := Modules.Bundle { Carrier := Zero.Carrier, space := Zero.moduleSpace };
\definition integers: Modules.Bundle := Modules.Bundle { Carrier := I.Int^, space := Modules.scalarModule };
\import Modules.Hom[V := Zero.Carrier, W := I.Int^, source := Zero.moduleSpace, target := Modules.scalarModule] \as Inclusion;
\import Modules.End[V := I.Int^, space := Modules.scalarModule] \as Identity;
\import Modules.ShortExact[A := zero, B := integers, C := integers] \as Sequences;
\definition sequence: Sequences.Sequence := Sequences.Sequence {
  inclusion := Inclusion.zeroMap, projection := Identity.identity,
  injective := \fun (x, y: Zero.Carrier)(equal: _) => Zero.unique x y,
  onto := \fun (x: I.Int^) => Logic.existsIntro[I.Int^, { y: I.Int^ \where y = x }] x (\refl(x)),
  zero := \fun (x: Zero.Carrier) => \refl(I.Zero.specification),
  kernelImage := \fun (x: I.Int^)(equal: x = I.Zero.specification) =>
    Logic.existsIntro[Zero.Carrier, { y: Zero.Carrier \where #apply{Inclusion.zeroMap} y = x }] Zero.Carrier::zero (sym!{I.Int^} _ _ equal),
};
\import topology.Topology[Carrier := Basic.Point] \as Topology;
\import singular_cohomology.Coefficients[A := Basic.Point, source := Topology.Discrete]
  .Sequence[L := zero, M := integers, R := integers].On[s := sequence] \as Coefficients;
\definition bockstein(n: N.Nat^): _ := Coefficients.Bockstein[n := n].connecting;
\definition exactAtRight(n: N.Nat^): _ := Coefficients.Bockstein[n := n].exactAtRight;
\definition exactAtLeft(n: N.Nat^): _ := Coefficients.Bockstein[n := n].exactAtLeft;
\definition exactAtMiddle(n: N.Nat^): _ := Coefficients.Bockstein[n := n].exactAtMiddle;
