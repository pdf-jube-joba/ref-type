\inductive Point: \Set := | point: Point;
\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import topology.Topology[Carrier := Point] \as Topology;
\import singular_cohomology.Relative[A := Point, source := Topology.Discrete, subset := Topology.Whole] \as Pair;
\import Topology.Subspace[S := Topology.Whole] \as Subspace;
\import singular_cohomology.Chains[A := Subspace.CarrierSet, source := Subspace.topology Topology.Discrete] \as Included;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := Included.complex] \as Extension;
\definition quotientOfIncluded: \forall (z: I.Int^)(x: Extension.Carrier z) ->
  (Pair.sequence.projection).apply z ((Pair.sequence.inclusion).apply z x) = (Pair.space z).zero :=
  (Pair.sequence).zero;
\definition relativeBoundarySquared: \forall (z: I.Int^)(x: Pair.Carrier z) ->
  (Pair.complex.differential).apply (chain_complexes.Chain[].previous z) ((Pair.complex.differential).apply z x) =
    (Pair.space (chain_complexes.Chain[].previous (chain_complexes.Chain[].previous z))).zero := (Pair.complex.laws).squareZero;
\definition coefficients: Modules.Bundle := Modules.Bundle { Carrier := I.Int^, space := Modules.scalarModule };
\import Pair.With[coefficients := coefficients] \as RelativeCochains;
\definition relativeCohomology[n: N.Nat^]: \Set := RelativeCochains.cohomology n;
\definition vanishingCochainIsomorphism[z: I.Int^]: _ := RelativeCochains.Vanishing[z := z].isomorphism;
\definition connecting[z: I.Int^]: _ := Pair.LongExact[z := z].connecting;
\definition exactAtRelative[z: I.Int^]: _ := Pair.LongExact[z := z].exactAtRelative;
\import RelativeCochains.PairSequence[] \as CochainSequence;
\definition cochainConnecting[z: I.Int^]: _ := CochainSequence.LongExact[z := z].connecting;
\definition cochainExactAtRelative[z: I.Int^]: _ := CochainSequence.LongExact[z := z].exactAtRelative;
\definition cochainExactAtSpace[z: I.Int^]: _ := CochainSequence.LongExact[z := z].exactAtSpace;
\definition cochainExactAtSubspace[z: I.Int^]: _ := CochainSequence.LongExact[z := z].exactAtSubspace;
