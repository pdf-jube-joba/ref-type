\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\import algebraic_topology.Simplex[] \as Simplex;
\definition zero: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zero;
\definition two: N.Nat^ := N.Nat^::succ one;
\module Algebra;
\import algebraic_topology.Spheres[].Zero[] \as ZeroSphere;
\import ZeroSphere.Topology[] \as SphereTopology;
\import cohomology_models.ZeroSphere[] \as Model;
\import std.Logic[].Proposition[] \as Logic;
\import topology.Topology[Carrier := ZeroSphere.Point] \as PointSpace;
\definition family: \Pow (\Pow ZeroSphere.Point) := { U: \Pow ZeroSphere.Point \where Logic.Or[U = Model.left, U = Model.right] };
\import singular_cohomology.Small[A := ZeroSphere.Point, source := ZeroSphere.discrete, family := family] \as Small;
\import Small.Simplices[] \as SmallSimplices;
\import singular_cohomology.SimplicialChains[].On[X := SmallSimplices.object] \as SmallChains;
\import singular_cohomology.Chains[A := ZeroSphere.Point, source := ZeroSphere.discrete] \as Whole;
\import singular_cohomology.Simplices[A := ZeroSphere.Point, source := ZeroSphere.discrete] \as WholeSimplices;
\import singular_excision.MayerVietoris[A := ZeroSphere.Point].Over[source := ZeroSphere.discrete].On[cover := Model.cover] \as Cover;
\import singular_cohomology.OpenCover[A := ZeroSphere.Point, source := ZeroSphere.discrete].On[cover := Cover.openCover] \as Covered;
\definition weight: ZeroSphere.Point -> I.Int^ := \induction (p: ZeroSphere.Point) \return I.Int^ \with {
  | positive: I.One.specification | negative: I.Zero.specification
};
\definition value[sigma: SmallSimplices.Carrier zero]: I.Int^ := weight (sigma Simplex.zeroPoint);
\import Modules.Free[Generators := SmallSimplices.Carrier zero].To[W := I.Int^, target := Modules.scalarModule] \as Free;
\definition small: Modules.Hom[V := Small.Carrier zero, W := I.Int^, source := Small.space zero, target := Modules.scalarModule].Map := Free.extension value;
\import Modules.Alternating[V := Small.Carrier zero, space := Small.space zero].Mapping[W := I.Int^, target := Modules.scalarModule] \as Mapping;
\import Modules.Alternating[V := I.Int^, space := Modules.scalarModule] \as Sums;
\import algebra.Group[].Of[Carrier := I.Int^, group := Modules.scalarGroup] \as Group;
\definition killsConstant: \forall (sigma: SmallSimplices.Carrier one)(p: ZeroSphere.Point) ->
  (\forall (x: Simplex.Carrier one) -> sigma x = p) ->
  (small).apply ((SmallChains.boundary zero).apply (Small.generator one sigma)) = I.Zero.specification :=
  \fun (sigma: SmallSimplices.Carrier one)(p: ZeroSphere.Point)(constant: _) => trans!{I.Int^} _ _ _
    (congr!{{Small.Carrier zero} I.Int^} ((small).apply) _ _ (SmallChains.Boundary[n := zero].onGenerator sigma))
    (trans!{I.Int^} _ _ _ (Mapping.law small two (\fun (i: Fin.Fin two) => Small.generator zero (SmallSimplices.face zero i sigma)))
      (trans!{I.Int^} _ _ _
        (Sums.congruent two _ (\fun (_: Fin.Fin two) => weight p)
          (\fun (i: Fin.Fin two) => trans!{I.Int^} _ _ _ (Free.onGenerator value (SmallSimplices.face zero i sigma))
            (congr!{ZeroSphere.Point I.Int^} weight _ _ (constant (Simplex.face zero i Simplex.zeroPoint)))))
        (Group.subtractDifference (weight p) I.Zero.specification)));
\definition killsGenerator: \forall (sigma: SmallSimplices.Carrier one) ->
  (small).apply ((SmallChains.boundary zero).apply (Small.generator one sigma)) = I.Zero.specification := \block {
  \fun (sigma: SmallSimplices.Carrier one) \then
  \takefrom w: SmallSimplices.Witness[one, sigma] \by SmallSimplices.witness one sigma \then
  \return (Logic.orElim _ _ ((small).apply ((SmallChains.boundary zero).apply (Small.generator one sigma)) = I.Zero.specification) (((w).member)) (\fun (same: (w).element = Model.left) => killsConstant sigma ZeroSphere.Point::positive
      (\fun (x: Simplex.Carrier one) => \idelim (w).element = Model.left \with U: \Pow ZeroSphere.Point => PointSpace.Member U (sigma x)
        \by { base: (w).contained x, equality: same })) (\fun (same: (w).element = Model.right) => killsConstant sigma ZeroSphere.Point::negative
      (\fun (x: Simplex.Carrier one) => \idelim (w).element = Model.right \with U: \Pow ZeroSphere.Point => PointSpace.Member U (sigma x)
        \by { base: (w).contained x, equality: same })))
};
\import Modules.Hom[V := Small.Carrier zero, W := I.Int^, source := Small.space zero, target := Modules.scalarModule].Composition[U := Small.Carrier one, domain := Small.space one] \as BoundaryComposition;
\import Modules.Hom[V := Small.Carrier one, W := I.Int^, source := Small.space one, target := Modules.scalarModule] \as SmallEdges;
\import Modules.Free[Generators := SmallSimplices.Carrier one].To[W := I.Int^, target := Modules.scalarModule] \as FreeEdges;
\definition zeroMap: BoundaryComposition.compose small (SmallChains.boundary zero) = SmallEdges.zeroMap := FreeEdges.ext _ _ killsGenerator;
\definition killsSmall: \forall (x: Small.Carrier one) -> (small).apply ((SmallChains.boundary zero).apply x) = I.Zero.specification :=
  \fun (x: Small.Carrier one) => congr!{SmallEdges.Map I.Int^} (\fun (f: SmallEdges.Map) => (f).apply x) _ _ zeroMap;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import Native.Map[C := Whole.complex, D := Small.complex].At[n := zero] \as Retraction;
\import Modules.Hom[V := Small.Carrier zero, W := I.Int^, source := Small.space zero, target := Modules.scalarModule].Composition[U := Whole.Carrier zero, domain := Whole.space zero] \as Composition;
\definition cochain: Modules.Hom[V := Whole.Carrier zero, W := I.Int^, source := Whole.space zero, target := Modules.scalarModule].Map :=
  Composition.compose small (Retraction.linear Covered.retraction);
\definition closed: \forall (x: Whole.Carrier one) -> (cochain).apply ((Whole.boundary zero).apply x) = I.Zero.specification :=
  \fun (x: Whole.Carrier one) => trans!{I.Int^} _ _ _
    (congr!{{Small.Carrier zero} I.Int^} ((small).apply) _ _ (sym!{{Small.Carrier zero}} _ _ ((Covered.retraction).commutes zero x)))
    (killsSmall ((Covered.retraction).apply one x));
\definition pointMember: \forall (p: ZeroSphere.Point) -> \In[\Pow ZeroSphere.Point] family (PointSpace.Singleton p) :=
  \induction (p: ZeroSphere.Point) \return \In[\Pow ZeroSphere.Point] family (PointSpace.Singleton p) \with {
    | positive: Logic.Or[_, _]::left (\refl(Model.left))
    | negative: Logic.Or[_, _]::right (\refl(Model.right))
  };
\definition smallPoint[p: ZeroSphere.Point]: SmallSimplices.Carrier zero :=
  \into[WholeSimplices.Carrier zero](WholeSimplices.At[n := zero].constant p, SmallSimplices.Small zero) \by {
    \exact(SmallSimplices.Witness[zero, WholeSimplices.At[n := zero].constant p] {
      element := PointSpace.Singleton p, member := pointMember p, contained := \fun (_: Simplex.Carrier zero) => \refl(p),
    }, SmallSimplices.Witness[zero, WholeSimplices.At[n := zero].constant p])
  };
\import Native.Map[C := Small.complex, D := Small.complex] \as End;
\import Native.Map[C := Whole.complex, D := Small.complex].Composition[B := Small.complex] \as RetractAfterInclude;
\definition retractionOnPoint: \forall (p: ZeroSphere.Point) ->
  (Covered.retraction).apply zero (Whole.generator zero (WholeSimplices.At[n := zero].constant p)) = Small.generator zero (smallPoint p) :=
  \fun (p: ZeroSphere.Point) => trans!{{Small.Carrier zero}} _ _ _
    (congr!{{Whole.Carrier zero} {Small.Carrier zero}} ((Covered.retraction).apply zero) _ _ (sym!{{Whole.Carrier zero}} _ _ (Small.At[n := zero].onGenerator (smallPoint p))))
    (congr!{End.Map {Small.Carrier zero}} (\fun (f: End.Map) => (f).apply zero (Small.generator zero (smallPoint p))) _ _ Covered.leftInverse);
\definition onPoint: \forall (p: ZeroSphere.Point) -> (cochain).apply (Whole.generator zero (WholeSimplices.At[n := zero].constant p)) = weight p :=
  \fun (p: ZeroSphere.Point) => trans!{I.Int^} _ _ _
    (congr!{{Small.Carrier zero} I.Int^} ((small).apply) _ _ (retractionOnPoint p))
    (Free.onGenerator value (smallPoint p));
\module Sphere;
