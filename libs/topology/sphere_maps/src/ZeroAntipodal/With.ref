\import singular_cohomology.Cochains[A := Sphere, source := topology].With[coefficients := coefficients] \as Theory;
\import singular_cohomology.Zero[A := Sphere, source := topology].With[coefficients := coefficients] \as Zero;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.At[C := Theory.complex, k := N.Nat^::zero] \as H;
\import Complexes.DegreeZero[C := Theory.complex] \as Cycles;
\definition Carrier: \Set := H.Cohomology;
\definition space: Modules.Space Carrier := H.cohomologySpace;
\definition evaluate(q: Carrier)(a: Sphere): coefficients.Carrier := Zero.value (#apply{#backward{Cycles.kernelIso}} q) a;
\definition onClass: \forall (h: H.CycleCarrier)(a: Sphere) -> evaluate (H.classOf h) a = Zero.value h a :=
  \fun (h: H.CycleCarrier)(a: Sphere) => congr!{H.CycleCarrier coefficients.Carrier} (\fun (g: H.CycleCarrier) => Zero.value g a) _ _ (#leftInverse{Cycles.kernelIso} h);
\import singular_cohomology.Maps[A := Sphere, B := Sphere, source := topology, target := topology].Coefficients[M := coefficients, L := coefficients] \as Pull;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficient;
\definition action: Modules.Hom[V := Carrier, W := Carrier, source := space, target := space].Map := Pull.At[n := N.Nat^::zero].induced Antipodal.apply Antipodal.continuous Coefficient.identity;
\import Complexes.Map[C := Theory.complex, D := Theory.complex].At[k := N.Nat^::zero] \as Action;
\definition valueOnClass: \forall (h: H.CycleCarrier)(a: Sphere) -> evaluate (#apply{action} (H.classOf h)) a = Zero.value h (Antipodal.apply a) :=
  \fun (h: H.CycleCarrier)(a: Sphere) => trans!{coefficients.Carrier} _ _ _
    (congr!{Carrier coefficients.Carrier} (\fun (q: Carrier) => evaluate q a) _ _ (Action.onClass (Pull.map Antipodal.apply Antipodal.continuous Coefficient.identity) h))
    (trans!{coefficients.Carrier} _ _ _
      (onClass (#apply{(Action.cyclesMap (Pull.map Antipodal.apply Antipodal.continuous Coefficient.identity))} h) a)
      (Pull.At[n := N.Nat^::zero].onCochain Antipodal.apply Antipodal.continuous Coefficient.identity h (Zero.constant a)));
\definition value: \forall (q: Carrier)(a: Sphere) -> evaluate (#apply{action} q) a = evaluate q (Antipodal.apply a) :=
  H.classInduction (\fun (q: Carrier) => \forall (a: Sphere) -> evaluate (#apply{action} q) a = evaluate q (Antipodal.apply a))
    (\fun (h: H.CycleCarrier)(a: Sphere) => trans!{coefficients.Carrier} _ _ _ (valueOnClass h a) (sym!{coefficients.Carrier} _ _ (onClass h (Antipodal.apply a))));
\definition atNorth: \forall (q: Carrier) -> evaluate (#apply{action} q) Model.north = evaluate q Model.south :=
  \fun (q: Carrier) => trans!{coefficients.Carrier} _ _ _ (value q Model.north) (congr!{Sphere coefficients.Carrier} (evaluate q) _ _ north);
\definition atSouth: \forall (q: Carrier) -> evaluate (#apply{action} q) Model.south = evaluate q Model.north :=
  \fun (q: Carrier) => trans!{coefficients.Carrier} _ _ _ (value q Model.south) (congr!{Sphere coefficients.Carrier} (evaluate q) _ _ south);
\import Modules.Laws[V := coefficients.Carrier, space := coefficients.space] \as Values;
\import algebra.Group[].Of[Carrier := coefficients.Carrier, group := Values.additive] \as Group;
\definition orientedValue(q: Carrier): coefficients.Carrier := Group.difference (evaluate q Model.north) (evaluate q Model.south);
\definition reverseDifference: \forall (a, b: coefficients.Carrier) -> Group.difference b a = Group.neg (Group.difference a b) :=
  \fun (a, b: coefficients.Carrier) => sym!{coefficients.Carrier} _ _
    (trans!{coefficients.Carrier} _ _ _ (Group.negAdd a (Group.neg b))
      (trans!{coefficients.Carrier} _ _ _ (congr!{coefficients.Carrier coefficients.Carrier} (Group.add (Group.neg a)) _ _ (Group.negNeg b)) (Group.comm (Group.neg a) b)));
\definition orientedAction: \forall (q: Carrier) -> orientedValue (#apply{action} q) = Group.neg (orientedValue q) :=
  \fun (q: Carrier) => trans!{coefficients.Carrier} _ _ _
    (congr2!{coefficients.Carrier coefficients.Carrier coefficients.Carrier} Group.difference _ _ _ _ (atNorth q) (atSouth q))
    (reverseDifference (evaluate q Model.north) (evaluate q Model.south));
\import singular_cohomology.Simplices[A := Sphere, source := topology] \as Simplices;
\import Modules.Free[Generators := Simplices.Carrier N.Nat^::zero].To[W := coefficients.Carrier, target := coefficients.space] \as Free;
\definition sameValues: \forall (h, g: H.CycleCarrier) -> Zero.value h Model.north = Zero.value g Model.north -> Zero.value h Model.south = Zero.value g Model.south ->
  \forall (a: Sphere) -> Zero.value h a = Zero.value g a :=
  \fun (h, g: H.CycleCarrier)(north: _)(south: _)(a: Sphere) => either!{{(Model.cases a)} {Zero.value h a = Zero.value g a}
    {\fun (equal: a = Model.north) => trans!{coefficients.Carrier} _ _ _ (congr!{Sphere coefficients.Carrier} (Zero.value h) _ _ equal)
      (trans!{coefficients.Carrier} _ _ _ north (sym!{coefficients.Carrier} _ _ (congr!{Sphere coefficients.Carrier} (Zero.value g) _ _ equal)))}
    {\fun (equal: a = Model.south) => trans!{coefficients.Carrier} _ _ _ (congr!{Sphere coefficients.Carrier} (Zero.value h) _ _ equal)
      (trans!{coefficients.Carrier} _ _ _ south (sym!{coefficients.Carrier} _ _ (congr!{Sphere coefficients.Carrier} (Zero.value g) _ _ equal)))}
  };
\definition cyclesEqual: \forall (h, g: H.CycleCarrier) -> Zero.value h Model.north = Zero.value g Model.north -> Zero.value h Model.south = Zero.value g Model.south -> h = g :=
  \fun (h, g: H.CycleCarrier)(north: _)(south: _) => Free.ext h g
    (\fun (sigma: Simplices.Carrier N.Nat^::zero) => trans!{coefficients.Carrier} _ _ _ (Zero.valueOnSimplex h sigma)
      (trans!{coefficients.Carrier} _ _ _ (sameValues h g north south (Zero.point sigma)) (sym!{coefficients.Carrier} _ _ (Zero.valueOnSimplex g sigma))));
\definition detectsEqual: \forall (q, r: Carrier) -> evaluate q Model.north = evaluate r Model.north -> evaluate q Model.south = evaluate r Model.south -> q = r :=
  \fun (q, r: Carrier)(north: _)(south: _) => trans!{Carrier} _ _ _ (sym!{Carrier} _ _ (#rightInverse{Cycles.kernelIso} q))
    (trans!{Carrier} _ _ _
      (congr!{H.CycleCarrier Carrier} H.classOf _ _ (cyclesEqual (#apply{#backward{Cycles.kernelIso}} q) (#apply{#backward{Cycles.kernelIso}} r) north south))
      (#rightInverse{Cycles.kernelIso} r));
