\definition degree: I.Int^ := I.Int^::ofNat n;
\import Naturals.At[C := Source.complex, k := n] \as SourceH;
\import Naturals.At[C := Target.complex, k := n] \as TargetH;
\import Signed.At[C := IntegerSource.complex, z := degree] \as IntegerSourceH;
\import Signed.At[C := IntegerTarget.complex, z := degree] \as IntegerTargetH;
\import Naturals.Map[C := Source.complex, D := Target.complex].At[k := n] \as NaturalMap;
\import Signed.Map[C := IntegerSource.complex, D := IntegerTarget.complex].At[k := degree] \as IntegerMap;
\definition sourceComparison: _ := SourceComparison.Cohomology[n := n].isomorphism;
\definition targetComparison: _ := TargetComparison.Cohomology[n := n].isomorphism;
\definition cycles: \forall (h: IntegerSourceH.Closed) ->
  TargetComparison.Cohomology[n := n].restrict (#apply{(IntegerMap.cyclesMap IntegerAction.map)} h) =
    #apply{(NaturalMap.cyclesMap NaturalAction.map)} (SourceComparison.Cohomology[n := n].restrict h) :=
  \fun (h: IntegerSourceH.Closed) => Target.At[n := n].ext _ _
    (\fun (x: C.family.Carrier n) => \refl(#apply{h} (Codomain.Positive[n := n].intro (#apply{f} n x))));
\definition onClass: \forall (h: IntegerSourceH.Closed) ->
  #apply{#forward{targetComparison}} (#apply{(IntegerMap.induced IntegerAction.map)} (IntegerSourceH.classOf h)) =
    #apply{(NaturalMap.induced NaturalAction.map)} (#apply{#forward{sourceComparison}} (IntegerSourceH.classOf h)) :=
  \fun (h: IntegerSourceH.Closed) => trans!{TargetH.Cohomology} _ _ _
    (congr!{IntegerTargetH.Cohomology TargetH.Cohomology} (#apply{#forward{targetComparison}}) _ _ (IntegerMap.onClass IntegerAction.map h))
    (trans!{TargetH.Cohomology} _ _ _
      (TargetComparison.Cohomology[n := n].onClass (#apply{(IntegerMap.cyclesMap IntegerAction.map)} h))
      (trans!{TargetH.Cohomology} _ _ _
        (congr!{TargetH.CycleCarrier TargetH.Cohomology} TargetH.classOf _ _ (cycles h))
        (trans!{TargetH.Cohomology} _ _ _
          (sym!{TargetH.Cohomology} _ _ (NaturalMap.onClass NaturalAction.map (SourceComparison.Cohomology[n := n].restrict h)))
          (congr!{SourceH.Cohomology TargetH.Cohomology} (#apply{(NaturalMap.induced NaturalAction.map)}) _ _
            (sym!{SourceH.Cohomology} _ _ (SourceComparison.Cohomology[n := n].onClass h))))));
\definition law: \forall (q: IntegerSourceH.Cohomology) ->
  #apply{#forward{targetComparison}} (#apply{(IntegerMap.induced IntegerAction.map)} q) =
    #apply{(NaturalMap.induced NaturalAction.map)} (#apply{#forward{sourceComparison}} q) :=
  IntegerSourceH.classInduction (\fun (q: IntegerSourceH.Cohomology) =>
    #apply{#forward{targetComparison}} (#apply{(IntegerMap.induced IntegerAction.map)} q) =
      #apply{(NaturalMap.induced NaturalAction.map)} (#apply{#forward{sourceComparison}} q)) onClass;
