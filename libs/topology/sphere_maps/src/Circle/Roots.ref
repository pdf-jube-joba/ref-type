\import \parent.Powers[] \as Powers;
\import \parent.Coordinates[] \as Coordinates;
\import \parent.Antipodal[] \as Negative;
\import Complex.Algebra[] \as Algebra;
\import Complex.Absolute[] \as Absolute;
\import algebra.Group[].Of[Carrier := Complex.Complex, group := Algebra.additiveGroup] \as Group;
\import Real.Algebra[] \as RealAlgebra;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\definition scaleOne: \forall (z: Complex.Complex) -> Operations.scale Real.one z = z :=
  \fun (z: Complex.Complex) => ComplexLaws.ext _ _ (Laws.fieldMulOneLeft (Complex.re z)) (Laws.fieldMulOneLeft (Complex.im z));
\definition scaleAssoc: \forall (a, b: Real.Real)(z: Complex.Complex) -> Operations.scale (Real.mul a b) z = Operations.scale a (Operations.scale b z) :=
  \fun (a, b: Real.Real)(z: Complex.Complex) => ComplexLaws.ext _ _
    (Laws.fieldMulAssoc a b (Complex.re z)) (Laws.fieldMulAssoc a b (Complex.im z));
\definition normScale: \forall (a: Real.Real)(z: Complex.Complex) -> Operations.normSq (Operations.scale a z) = Real.mul (Real.mul a a) (Operations.normSq z) :=
  \fun (a: Real.Real)(z: Complex.Complex) => trans!{Real.Real} _ _ _
    (congr2!{Real.Real Real.Real Real.Real} Real.add _ _ _ _
      (RealAlgebra.mulFour a (Complex.re z) a (Complex.re z))
      (RealAlgebra.mulFour a (Complex.im z) a (Complex.im z)))
    (sym!{Real.Real} _ _ (Laws.fieldMulAdd (Real.mul a a) (Real.mul (Complex.re z) (Complex.re z)) (Real.mul (Complex.im z) (Complex.im z))));
\definition productScale: \forall (a: Real.Real)(z: Complex.Complex) ->
  Operations.mul (Operations.scale a z) (Operations.scale a z) = Operations.scale (Real.mul a a) (Operations.mul z z) :=
  \fun (a: Real.Real)(z: Complex.Complex) => trans!{Complex.Complex} _ _ _ (ComplexLaws.scaleMulLeft a z (Operations.scale a z))
    (trans!{Complex.Complex} _ _ _
      (congr!{Complex.Complex Complex.Complex} (Operations.scale a) _ _
        (trans!{Complex.Complex} _ _ _ (ComplexLaws.mulComm z (Operations.scale a z)) (ComplexLaws.scaleMulLeft a z z)))
      (sym!{Complex.Complex} _ _ (scaleAssoc a a (Operations.mul z z))));
\definition realTimes: \forall (a: Real.Real)(z: Complex.Complex) -> Operations.mul (Operations.ofReal a) z = Operations.scale a z :=
  \fun (a: Real.Real)(z: Complex.Complex) => ComplexLaws.ext _ _
    (trans!{Real.Real} _ _ _
      (congr!{Real.Real Real.Real} (Real.sub (Real.mul a (Complex.re z))) _ _ (Laws.fieldMulZeroLeft (Complex.im z)))
      (Laws.subZeroRight (Real.mul a (Complex.re z))))
    (trans!{Real.Real} _ _ _
      (congr!{Real.Real Real.Real} (Real.add (Real.mul a (Complex.im z))) _ _ (Laws.fieldMulZeroLeft (Complex.re z)))
      (Laws.addZeroRight (Real.mul a (Complex.im z))));
\module Normalize(v: Complex.Complex, nonzero: Operations.NonZero v);
\module Half(z: Carrier, different: Logic.Not (z = Negative.minusOne));
\definition iNorm: Operations.normSq Operations.i = Real.one :=
  trans!{Real.Real} _ _ _
    (congr2!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ (Laws.fieldMulZeroLeft Real.zero) (Laws.fieldMulOneLeft Real.one))
    (Laws.addZeroLeft Real.one);
\definition imaginary: Carrier := \into[Complex.Complex](Operations.i, unit) \by { iNorm };
\definition existsRoot: \forall (z: Carrier) -> \exists { w: Carrier \where Powers.natural two w = z } :=
  \fun (z: Carrier) => (Logic.orElim _ _ (\exists { w: Carrier \where Powers.natural two w = z }) ((Classical.excludedMiddle (z = Negative.minusOne))) (\fun (same: _) => Logic.existsIntro[Carrier, { w: Carrier \where Powers.natural two w = z }] imaginary
      (trans!{Complex.Complex} _ _ _ (Powers.squareInCircle imaginary)
        (trans!{Complex.Complex} _ _ _ ComplexLaws.iSquared (sym!{Complex.Complex} _ _ same)))) (\fun (different: _) => Logic.existsIntro[Carrier, { w: Carrier \where Powers.natural two w = z }] Half[z := z, different := different].value
      (trans!{Complex.Complex} _ _ _ (Powers.squareInCircle Half[z := z, different := different].value) Half[z := z, different := different].square)));
\definition onto: \forall (y: Coordinates.Sphere) -> \exists { x: Coordinates.Sphere \where Powers.square x = y } := \block {
  \fun (y: Coordinates.Sphere) \then
  \takefrom w: \Cast[Carrier] ({ w: Carrier \where Powers.natural two w = Coordinates.forward y }) \by existsRoot (Coordinates.forward y) \then
  \return Logic.existsIntro[Coordinates.Sphere, { x: Coordinates.Sphere \where Powers.square x = y }] (Coordinates.backward w)
    (trans!{Coordinates.Sphere} _ _ _
      (congr!{Carrier {Coordinates.Sphere}} Coordinates.backward _ _
        (congr!{Carrier Carrier} (Powers.natural two) _ _ (Coordinates.rightInverse w)))
      (trans!{Coordinates.Sphere} _ _ _
        (congr!{Carrier {Coordinates.Sphere}} Coordinates.backward _ _ (\bysub(Carrier, { w: Carrier \where Powers.natural two w = Coordinates.forward y }, w)))
        (Coordinates.leftInverse y)))
};
