\import \parent.Coordinates[] \as Coordinates;
\import algebraic_topology.Spheres[] \as Spheres;
\import Spheres.Positive[n := N.Nat^::zero].Connected[] \as SphereConnected;
\import algebraic_topology.PathComponent[A := Coordinates.Sphere, source := Coordinates.sphereTopology] \as SpherePaths;
\import SpherePaths.Maps[B := Carrier, target := topology] \as IntoCircle;
\import algebraic_topology.PathComponent[A := Carrier, source := topology] \as Paths;
\definition connected: Paths.PathConnected :=
  \fun (z, w: Carrier) => \idelim Coordinates.forward (Coordinates.backward z) = z
    \with a: Carrier => Paths.Related a w \by {
      base: \idelim Coordinates.forward (Coordinates.backward w) = w
        \with b: Carrier => Paths.Related (Coordinates.forward (Coordinates.backward z)) b \by {
          base: IntoCircle.preserves Coordinates.forward Coordinates.forwardContinuous (Coordinates.backward z) (Coordinates.backward w)
            (SphereConnected.connected (Coordinates.backward z) (Coordinates.backward w)),
          equality: Coordinates.rightInverse w
        },
      equality: Coordinates.rightInverse z
    };
\definition apply[c: Carrier][x: Coordinates.Sphere]: Coordinates.Sphere := Coordinates.backward (multiply c (Coordinates.forward x));
\import \parent.Functions[A := Coordinates.Sphere] \as SphereFunctions;
\import topology.Maps[A := Coordinates.Sphere, B := Carrier] \as Constants;
\import topology.Composition[A := Coordinates.Sphere, B := Carrier, C := Coordinates.Sphere] \as Compose;
\definition continuous: \forall (c: Carrier) -> topology.Continuity[A := Coordinates.Sphere, B := Coordinates.Sphere].Continuous Coordinates.sphereTopology Coordinates.sphereTopology (apply c) :=
  \fun (c: Carrier) => Compose.composeContinuous Coordinates.sphereTopology topology Coordinates.sphereTopology
    (\fun (x: Coordinates.Sphere) => multiply c (Coordinates.forward x)) Coordinates.backward
    (SphereFunctions.multiplyContinuous Coordinates.sphereTopology (\fun (_: Coordinates.Sphere) => c) Coordinates.forward
      (Constants.constantContinuous Coordinates.sphereTopology topology c) Coordinates.forwardContinuous) Coordinates.backwardContinuous;
\import algebraic_topology.Homotopy[A := Paths.Point, B := Carrier] \as PathHomotopies;
\import algebraic_topology.Homotopy[A := Coordinates.Sphere, B := Coordinates.Sphere] \as Homotopies;
\import algebraic_topology.Cylinder[A := Paths.Point] \as PathCylinder;
\import algebraic_topology.Cylinder[A := Coordinates.Sphere] \as Cylinder;
\import algebraic_topology.Interval[] \as Interval;
\import topology.Topology[Carrier := Paths.Point] \as PointTopology;
\import topology.Maps[A := Cylinder.Carrier, B := Paths.Point] \as PointConstants;
\import topological_constructions.Product[A := Interval.Carrier, B := Paths.Point].Universal[X := Cylinder.Carrier] \as IntoPath;
\definition pathArgument[p: Cylinder.Carrier]: PathCylinder.Carrier := PathCylinder.at (Cylinder.time p) Paths.Point::point;
\definition pathArgumentContinuous: topology.Continuity[A := Cylinder.Carrier, B := PathCylinder.Carrier].Continuous
  (Cylinder.topology Coordinates.sphereTopology) (PathCylinder.topology PointTopology.Discrete) pathArgument :=
  IntoPath.pairContinuous (Cylinder.topology Coordinates.sphereTopology) Interval.topology PointTopology.Discrete
    Cylinder.time (\fun (_: Cylinder.Carrier) => Paths.Point::point)
    (Cylinder.timeContinuous Coordinates.sphereTopology)
    (PointConstants.constantContinuous (Cylinder.topology Coordinates.sphereTopology) PointTopology.Discrete Paths.Point::point);
\import topology.Composition[A := Cylinder.Carrier, B := PathCylinder.Carrier, C := Carrier] \as PathComposition;
\import topology.Composition[A := Cylinder.Carrier, B := Coordinates.Sphere, C := Carrier] \as CoordinateComposition;
\import \parent.Functions[A := Cylinder.Carrier] \as CylinderFunctions;
\import topology.Composition[A := Cylinder.Carrier, B := Carrier, C := Coordinates.Sphere] \as OutputComposition;
\definition family[c: Carrier][path: Paths.Path identity c][p: Cylinder.Carrier]: Coordinates.Sphere :=
  Coordinates.backward (multiply (path (pathArgument p)) (Coordinates.forward (Cylinder.point p)));
\definition homotopy[c: Carrier][path: Paths.Path identity c]:
  Homotopies.Homotopy[Coordinates.sphereTopology, Coordinates.sphereTopology, (\fun (x: Coordinates.Sphere) => x), apply c] :=
  \into[Homotopies.Family](family c path,
    Homotopies.Homotopy[Coordinates.sphereTopology, Coordinates.sphereTopology, (\fun (x: Coordinates.Sphere) => x), apply c]) \by {
    Homotopies.Laws[Coordinates.sphereTopology, Coordinates.sphereTopology, (\fun (x: Coordinates.Sphere) => x), apply c, family c path] {
      continuous := OutputComposition.composeContinuous (Cylinder.topology Coordinates.sphereTopology) topology Coordinates.sphereTopology
        (\fun (p: Cylinder.Carrier) => multiply (path (pathArgument p)) (Coordinates.forward (Cylinder.point p))) Coordinates.backward
        (CylinderFunctions.multiplyContinuous (Cylinder.topology Coordinates.sphereTopology)
          (\fun (p: Cylinder.Carrier) => path (pathArgument p)) (\fun (p: Cylinder.Carrier) => Coordinates.forward (Cylinder.point p))
          (PathComposition.composeContinuous (Cylinder.topology Coordinates.sphereTopology) (PathCylinder.topology PointTopology.Discrete) topology
            pathArgument path pathArgumentContinuous ((PathHomotopies.laws PointTopology.Discrete topology (Paths.constant identity) (Paths.constant c) path).continuous))
          (CoordinateComposition.composeContinuous (Cylinder.topology Coordinates.sphereTopology) Coordinates.sphereTopology topology
            Cylinder.point Coordinates.forward (Cylinder.pointContinuous Coordinates.sphereTopology) Coordinates.forwardContinuous)) Coordinates.backwardContinuous,
      start := \fun (x: Coordinates.Sphere) => trans!{Coordinates.Sphere} _ _ _
        (congr!{Carrier {Coordinates.Sphere}} Coordinates.backward _ _
          (congr!{Carrier Carrier} (\fun (z: Carrier) => multiply z (Coordinates.forward x)) _ _
            ((PathHomotopies.laws PointTopology.Discrete topology (Paths.constant identity) (Paths.constant c) path).start Paths.Point::point)))
        (trans!{Coordinates.Sphere} _ _ _
          (congr!{Carrier {Coordinates.Sphere}} Coordinates.backward _ _ (leftIdentity (Coordinates.forward x))) (Coordinates.leftInverse x)),
      end := \fun (x: Coordinates.Sphere) => congr!{Carrier {Coordinates.Sphere}} Coordinates.backward _ _
        (congr!{Carrier Carrier} (\fun (z: Carrier) => multiply z (Coordinates.forward x)) _ _
          ((PathHomotopies.laws PointTopology.Discrete topology (Paths.constant identity) (Paths.constant c) path).end Paths.Point::point)),
    }
  };
\import cohomology_models.Spheres[].Orientation[n := N.Nat^::zero] \as Orientation;
\definition degreeOne: \forall (c: Carrier) -> Orientation.degree (apply c) (continuous c) = std.Arithmetic[].Int[].One.specification := \block {
  \fun (c: Carrier) \then
  \takefrom path: Paths.Path identity c \by connected identity c \then
  \return trans!{std.Arithmetic[].Int[].Int^} _ _ _
    (sym!{std.Arithmetic[].Int[].Int^} _ _ (Orientation.Homotopy[].law (\fun (x: Coordinates.Sphere) => x) (apply c) (homotopy c path)))
    Orientation.Identity[].law
};
