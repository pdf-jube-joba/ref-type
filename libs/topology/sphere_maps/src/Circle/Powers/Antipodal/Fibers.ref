\import Complex.Algebra[] \as Algebra;
\import algebra.Group[].Of[Carrier := Complex.Complex, group := Algebra.additiveGroup] \as Group;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition negMul: \forall (z, w: Complex.Complex) -> Operations.mul (Operations.neg z) w = Operations.neg (Operations.mul z w) :=
  \fun (z, w: Complex.Complex) => Group.inverseUnique (Operations.mul z w) (Operations.mul (Operations.neg z) w)
    (trans!{Complex.Complex} _ _ _ (sym!{Complex.Complex} _ _ (ComplexLaws.mulAddRight (Operations.neg z) z w))
      (trans!{Complex.Complex} _ _ _
        (congr!{Complex.Complex Complex.Complex} (\fun (a: Complex.Complex) => Operations.mul a w) _ _ (ComplexLaws.addNegLeft z))
        (ComplexLaws.mulZeroLeft w)));
\definition factor: \forall (z, w: Complex.Complex) ->
  Operations.mul (Operations.sub z w) (Operations.add z w) = Operations.sub (Operations.mul z z) (Operations.mul w w) :=
  \fun (z, w: Complex.Complex) => trans!{Complex.Complex} _ _ _ (ComplexLaws.mulAddRight z (Operations.neg w) (Operations.add z w))
    (trans!{Complex.Complex} _ _ _
      (congr2!{Complex.Complex Complex.Complex Complex.Complex} Operations.add _ _ _ _
        (ComplexLaws.mulAddLeft z z w)
        (trans!{Complex.Complex} _ _ _ (ComplexLaws.mulAddLeft (Operations.neg w) z w)
          (congr2!{Complex.Complex Complex.Complex Complex.Complex} Operations.add _ _ _ _ (negMul w z) (negMul w w))))
      (trans!{Complex.Complex} _ _ _
        (congr!{Complex.Complex Complex.Complex} (Operations.add (Operations.add (Operations.mul z z) (Operations.mul z w))) _ _
          (ComplexLaws.addComm (Operations.neg (Operations.mul w z)) (Operations.neg (Operations.mul w w))))
        (trans!{Complex.Complex} _ _ _
          (Group.four (Operations.mul z z) (Operations.mul z w) (Operations.neg (Operations.mul w w)) (Operations.neg (Operations.mul w z)))
          (trans!{Complex.Complex} _ _ _
            (congr!{Complex.Complex Complex.Complex} (Operations.add (Operations.sub (Operations.mul z z) (Operations.mul w w))) _ _
              (trans!{Complex.Complex} _ _ _
                (congr!{Complex.Complex Complex.Complex} (\fun (a: Complex.Complex) => Operations.add (Operations.mul z w) (Operations.neg a)) _ _ (ComplexLaws.mulComm w z))
                (ComplexLaws.addNegRight (Operations.mul z w))))
            (ComplexLaws.addZeroRight (Operations.sub (Operations.mul z z) (Operations.mul w w)))))));
\definition rightZero: \forall (z, w: Complex.Complex) -> Operations.NonZero z -> Operations.mul z w = Operations.zero -> w = Operations.zero :=
  \fun (z, w: Complex.Complex)(nonzero: _)(equal: _) => trans!{Complex.Complex} _ _ _ (sym!{Complex.Complex} _ _ (ComplexLaws.mulOneLeft w))
    (trans!{Complex.Complex} _ _ _
      (congr!{Complex.Complex Complex.Complex} (\fun (a: Complex.Complex) => Operations.mul a w) _ _ (sym!{Complex.Complex} _ _ (ComplexLaws.inverseNonzero z nonzero)))
      (trans!{Complex.Complex} _ _ _ (ComplexLaws.mulAssoc (Operations.inv z) z w)
        (trans!{Complex.Complex} _ _ _
          (congr!{Complex.Complex Complex.Complex} (Operations.mul (Operations.inv z)) _ _ equal)
          (ComplexLaws.mulZeroRight (Operations.inv z)))));
\definition sameSquare: \forall (z, w: Complex.Complex) -> Operations.mul z z = Operations.mul w w -> Logic.Or[z = w, z = Operations.neg w] :=
  \fun (z, w: Complex.Complex)(equal: _) => either!{{(Classical.excludedMiddle (Operations.sub z w = Operations.zero))} {Logic.Or[z = w, z = Operations.neg w]}
    {\fun (same: _) => Logic.Or[_, _]::left (trans!{Complex.Complex} _ _ _ (sym!{Complex.Complex} _ _ (Group.addDifference z w))
      (trans!{Complex.Complex} _ _ _ (congr!{Complex.Complex Complex.Complex} (\fun (a: Complex.Complex) => Operations.add a w) _ _ same) (ComplexLaws.addZeroLeft w)))}
    {\fun (different: _) => Logic.Or[_, _]::right (Group.inverseUnique w z
      (rightZero (Operations.sub z w) (Operations.add z w) different
        (trans!{Complex.Complex} _ _ _ (factor z w)
          (trans!{Complex.Complex} _ _ _
            (congr!{Complex.Complex Complex.Complex} (\fun (a: Complex.Complex) => Operations.sub a (Operations.mul w w)) _ _ equal)
            (ComplexLaws.subSelf (Operations.mul w w))))))}
  };
\definition injective: \forall (x, y: Coordinates.Sphere) -> Coordinates.forward x = Coordinates.forward y -> x = y :=
  \fun (x, y: Coordinates.Sphere)(same: _) => trans!{Coordinates.Sphere} _ _ _ (sym!{Coordinates.Sphere} _ _ (Coordinates.leftInverse x))
    (trans!{Coordinates.Sphere} _ _ _ (congr!{Carrier {Coordinates.Sphere}} Coordinates.backward _ _ same) (Coordinates.leftInverse y));
\definition law: \forall (x, y: Coordinates.Sphere) -> square x = square y -> Logic.Or[x = y, x = Antipodal.apply y] := \block {
  \fun (x, y: Coordinates.Sphere)(same: _) \then
  \let unitSquare: natural two (Coordinates.forward x) = natural two (Coordinates.forward y) :=
    trans!{Carrier} _ _ _ (sym!{Carrier} _ _ (Coordinates.rightInverse (natural two (Coordinates.forward x))))
      (trans!{Carrier} _ _ _ (congr!{{Coordinates.Sphere} Carrier} Coordinates.forward _ _ same) (Coordinates.rightInverse (natural two (Coordinates.forward y)))) \then
  \let polynomial: Operations.mul (Coordinates.forward x) (Coordinates.forward x) = Operations.mul (Coordinates.forward y) (Coordinates.forward y) :=
    trans!{Complex.Complex} _ _ _ (sym!{Complex.Complex} _ _ (squareInCircle (Coordinates.forward x)))
      (trans!{Complex.Complex} _ _ _ unitSquare (squareInCircle (Coordinates.forward y))) \then
  \return either!{{(sameSquare (Coordinates.forward x) (Coordinates.forward y) polynomial)} {Logic.Or[x = y, x = Antipodal.apply y]}
    {\fun (equal: _) => Logic.Or[_, _]::left (injective x y equal)}
    {\fun (equal: _) => Logic.Or[_, _]::right (injective x (Antipodal.apply y)
      (trans!{Complex.Complex} _ _ _ equal (sym!{Complex.Complex} _ _ (Negative.coordinates y))))}
  }
};
