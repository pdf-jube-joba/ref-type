\import Groups.Pointwise[f := Identity.function, g := map (I.Int^::ofNat n), fc := Identity.continuous, gc := continuous (I.Int^::ofNat n)] \as Multiplication;
\definition functions: \forall (x: Coordinates.Sphere) -> Multiplication.map x = map (I.Int^::ofNat (N.Nat^::succ n)) x :=
  \fun (x: Coordinates.Sphere) => congr!{Circle.Carrier {Coordinates.Sphere}} Coordinates.backward _ _
    (congr!{Circle.Carrier Circle.Carrier} (multiply (Coordinates.forward x)) _ _ (Coordinates.rightInverse (Powers.natural n (Coordinates.forward x))));
\definition successorInteger: #add{IntegerRing.ring} I.One.specification (I.Int^::ofNat n) = I.Int^::ofNat (N.Nat^::succ n) :=
  trans!{I.Int^} _ _ _
    (congr!{I.Int^ I.Int^} (#add{IntegerRing.ring} I.One.specification) _ _ (I.ofNatAsInteger n))
    (trans!{I.Int^} _ _ _ (sym!{I.Int^} _ _ (I.integerSuccAsAdd n)) (sym!{I.Int^} _ _ (I.ofNatAsInteger (N.Nat^::succ n))));
\definition scaledSum: \forall (q: Carrier) -> #add{space} q (#smul{space} (I.Int^::ofNat n) q) = #smul{space} (I.Int^::ofNat (N.Nat^::succ n)) q :=
  \fun (q: Carrier) => trans!{Carrier} _ _ _
    (congr!{Carrier Carrier} (\fun (x: Carrier) => #add{space} x (#smul{space} (I.Int^::ofNat n) q)) _ _ (sym!{Carrier} _ _ (#scalarOne{space} q)))
    (trans!{Carrier} _ _ _ (sym!{Carrier} _ _ (#scalarAdd{space} I.One.specification (I.Int^::ofNat n) q))
      (congr!{I.Int^ Carrier} (\fun (a: I.Int^) => #smul{space} a q) _ _ successorInteger));
\definition law: (\forall (q: Carrier) -> #apply{(action (I.Int^::ofNat n))} q = #smul{space} (I.Int^::ofNat n) q) ->
  \forall (q: Carrier) -> #apply{(action (I.Int^::ofNat (N.Nat^::succ n)))} q = #smul{space} (I.Int^::ofNat (N.Nat^::succ n)) q :=
  \fun (previous: _)(q: Carrier) => trans!{Carrier} _ _ _
    (sym!{Carrier} _ _ (Groups.functionEquality Multiplication.map (map (I.Int^::ofNat (N.Nat^::succ n)))
      Multiplication.mapContinuous (continuous (I.Int^::ofNat (N.Nat^::succ n))) functions q))
    (trans!{Carrier} _ _ _ (Multiplication.law q)
      (trans!{Carrier} _ _ _
        (congr2!{Carrier Carrier Carrier} (#add{space}) _ _ _ _ (Identity.Coefficients[M := coefficients].At[n := one].cohomologyIdentity q) (previous q))
        (scaledSum q)));
