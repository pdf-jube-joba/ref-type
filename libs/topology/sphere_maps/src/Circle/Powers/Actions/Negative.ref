\definition magnitude: N.Nat^ := N.Nat^::succ n;
\import Inversion.With[f := map (I.Int^::ofNat magnitude), fc := continuous (I.Int^::ofNat magnitude)] \as Inverse;
\definition functions: \forall (x: Coordinates.Sphere) -> Inverse.function x = map (I.Int^::negSucc n) x :=
  \fun (x: Coordinates.Sphere) => congr!{Circle.Carrier {Coordinates.Sphere}} Coordinates.backward _ _
    (congr!{Circle.Carrier Circle.Carrier} inverse _ _ (Coordinates.rightInverse (Powers.natural magnitude (Coordinates.forward x))));
\definition negativeInteger: #neg{IntegerRing.ring} (I.Int^::ofNat magnitude) = I.Int^::negSucc n :=
  trans!{I.Int^} _ _ _
    (congr!{I.Int^ I.Int^} (#neg{IntegerRing.ring}) _ _ (I.ofNatAsInteger magnitude))
    (sym!{I.Int^} _ _ (I.negSuccAsNegNatural n));
\definition law: \forall (q: Carrier) -> #apply{(action (I.Int^::negSucc n))} q = #smul{space} (I.Int^::negSucc n) q :=
  \fun (q: Carrier) => trans!{Carrier} _ _ _
    (sym!{Carrier} _ _ (Groups.functionEquality Inverse.function (map (I.Int^::negSucc n)) Inverse.functionContinuous (continuous (I.Int^::negSucc n)) functions q))
    (trans!{Carrier} _ _ _ (Inverse.action q)
      (trans!{Carrier} _ _ _
        (congr!{Carrier Carrier} (#neg{space}) _ _ (natural magnitude q))
        (trans!{Carrier} _ _ _ (sym!{Carrier} _ _ (Values.negScalar (I.Int^::ofNat magnitude) q))
          (congr!{I.Int^ Carrier} (\fun (a: I.Int^) => #smul{space} a q) _ _ negativeInteger))));
