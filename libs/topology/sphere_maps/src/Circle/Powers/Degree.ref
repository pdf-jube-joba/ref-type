\import cohomology_models.Spheres[].Orientation[n := N.Nat^::zero] \as Orientation;
\import cohomology_models.Spheres[].With[coefficients := Orientation.coefficients].Top[n := N.Nat^::zero] \as Top;
\import \parent.Actions[coefficients := Orientation.coefficients] \as Actions;
\definition generatorCoefficient: #apply{Orientation.toCoefficient} Orientation.generator = I.One.specification := #leftInverse{Top.isomorphism} I.One.specification;
\definition integer: \forall (k: I.Int^) -> Orientation.degree (map k) (continuous k) = k :=
  \fun (k: I.Int^) => trans!{I.Int^} _ _ _
    (congr!{Orientation.Carrier I.Int^} (#apply{Orientation.toCoefficient}) _ _ (Actions.integer k Orientation.generator))
    (trans!{I.Int^} _ _ _ (#scalar{Orientation.toCoefficient} k Orientation.generator)
      (trans!{I.Int^} _ _ _
        (congr!{I.Int^ I.Int^} (#mul{IntegerRing.ring} k) _ _ generatorCoefficient)
        (#rightIdentity{(#multiplicative{(#semiring{IntegerRing.ring})})} k)));
\import \root.Circle[].Powers[] \as Powers;
\definition square: Orientation.degree Powers.square Powers.squareContinuous = I.Int^::ofNat two := integer (I.Int^::ofNat two);
