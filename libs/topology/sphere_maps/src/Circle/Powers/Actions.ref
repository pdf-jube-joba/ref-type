\import \root.Circle[] \as Circle;
\import \root.Circle[].Powers[] \as Powers;
\import \parent.\parent.Product[].Cohomology[coefficients := coefficients] \as Groups;
\import \parent.\parent.Inversion[].Coefficients[coefficients := coefficients] \as Inversion;
\import \root.Constants[n := N.Nat^::zero].With[coefficients := coefficients] \as Constants;
\import \parent.\parent.Product[] \as Product;
\definition Carrier: \Set := Groups.SphereCohomology;
\definition space: Modules.Space Carrier := Groups.sphereSpace;
\import Modules.Laws[V := Carrier, space := space] \as Values;
\import singular_cohomology.Identity[A := Coordinates.Sphere, source := Coordinates.sphereTopology] \as Identity;
\definition action(k: I.Int^): Modules.Hom[V := Carrier, W := Carrier, source := space, target := space].Map := Groups.action (map k) (continuous k);
\definition zero: \forall (q: Carrier) -> #apply{(action (I.Int^::ofNat N.Nat^::zero))} q = #smul{space} I.Zero.specification q :=
  \fun (q: Carrier) => trans!{Carrier} _ _ _ (Constants.actionZero Product.point q) (sym!{Carrier} _ _ (Values.zeroScale q));
\module DegreeZero;
\module Step(n: N.Nat^);
\definition natural: \forall (n: N.Nat^)(q: Carrier) -> #apply{(action (I.Int^::ofNat n))} q = #smul{space} (I.Int^::ofNat n) q :=
  \induction (n: N.Nat^) \return \forall (q: Carrier) -> #apply{(action (I.Int^::ofNat n))} q = #smul{space} (I.Int^::ofNat n) q \with {
    | zero: zero
    | succ: \fun (n: N.Nat^)(previous: _) => Step[n := n].law previous
  };
\module Negative(n: N.Nat^);
\definition integer: \forall (k: I.Int^)(q: Carrier) -> #apply{(action k)} q = #smul{space} k q :=
  \induction (k: I.Int^) \return \forall (q: Carrier) -> #apply{(action k)} q = #smul{space} k q \with {
    | ofNat: natural
    | negSucc: \fun (n: N.Nat^) => Negative[n := n].law
  };
\module Signed;
\module Reduced;
