\import \root.Circle[].Translations[] \as Translations;
\definition translation: \forall (x: Coordinates.Sphere) -> Translations.apply minusOne x = Antipodal.apply x :=
  \fun (x: Coordinates.Sphere) => trans!{Coordinates.Sphere} _ _ _
    (congr!{Carrier {Coordinates.Sphere}} Coordinates.backward _ _
      (trans!{Complex.Complex} _ _ _ (multiplication (Coordinates.forward x))
        (sym!{Complex.Complex} _ _ (coordinates x))))
    (Coordinates.leftInverse (Antipodal.apply x));
\import cohomology_models.Spheres[].Orientation[n := N.Nat^::zero] \as Orientation;
\import std.Arithmetic[].Int[] \as I;
\definition degree: Orientation.degree Antipodal.apply Antipodal.continuous = I.One.specification :=
  \idelim Translations.apply minusOne = Antipodal.apply
    \with f: (Coordinates.Sphere -> Coordinates.Sphere) =>
      \forall (continuous: topology.Continuity[A := Coordinates.Sphere, B := Coordinates.Sphere].Continuous Coordinates.sphereTopology Coordinates.sphereTopology f) ->
      Orientation.degree f continuous = I.One.specification \by {
      base: \fun (continuous: _) => Translations.degreeOne minusOne,
      equality: \axiom:funext(Translations.apply minusOne, Antipodal.apply, translation)
    } Antipodal.continuous;
