\import Axes.With[leftPaths := paths, rightPaths := paths].Coefficients[coefficients := coefficients] \as Detection;
\definition law: \forall (q: SphereCohomology) -> #apply{multiplication} q = #add{space} (#apply{firstPull} q) (#apply{secondPull} q) :=
  \fun (q: SphereCohomology) => Detection.detectsEqual _ _
    (trans!{SphereCohomology} _ _ _ (firstMultiplication q)
      (sym!{SphereCohomology} _ _
        (trans!{SphereCohomology} _ _ _ (#addition{firstRestriction} (#apply{firstPull} q) (#apply{secondPull} q))
          (trans!{SphereCohomology} _ _ _
            (congr2!{SphereCohomology SphereCohomology SphereCohomology} (#add{sphereSpace}) _ _ _ _ (firstFirst q) (firstSecond q))
            (SphereGroup.zeroRight q)))))
    (trans!{SphereCohomology} _ _ _ (secondMultiplication q)
      (sym!{SphereCohomology} _ _
        (trans!{SphereCohomology} _ _ _ (#addition{secondRestriction} (#apply{firstPull} q) (#apply{secondPull} q))
          (trans!{SphereCohomology} _ _ _
            (congr2!{SphereCohomology SphereCohomology SphereCohomology} (#add{sphereSpace}) _ _ _ _ (secondFirst q) (secondSecond q))
            (SphereGroup.zeroLeft q)))));
