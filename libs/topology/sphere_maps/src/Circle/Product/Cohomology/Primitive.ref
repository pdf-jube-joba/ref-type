\module Detection(paths: Normalize.PathFamily);
\definition law: \forall (q: SphereCohomology) -> #apply{multiplication} q = #add{space} (#apply{firstPull} q) (#apply{secondPull} q) := \block {
  \fun (q: SphereCohomology) \then
  \takefrom paths: Normalize.PathFamily \by pathsExist \then
  \return Detection[paths := paths].law q
};
