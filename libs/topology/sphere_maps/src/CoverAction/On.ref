\import Covers.On[cover := cover].Chains[] \as Chains;
\import Space.Subspace[S := (cover).left] \as LeftTopology;
\import singular_cohomology.Chains[A := Chains.Left, source := LeftTopology.topology source] \as LeftChains;
\import Space.Subspace[S := (cover).right] \as RightTopology;
\import singular_cohomology.Chains[A := Chains.Right, source := RightTopology.topology source] \as RightChains;
\import topology.Topology[Carrier := Chains.Left].Subspace[S := Chains.intersection] \as IntersectionTopology;
\import singular_cohomology.Chains[A := Chains.Intersection, source := IntersectionTopology.topology (LeftTopology.topology source)] \as IntersectionChains;
\import Native.Biproduct[C := LeftChains.complex, D := RightChains.complex] \as Sum;
\import singular_cohomology.Small[A := A, source := source, family := { U: \Pow A \where Logic.Or[U = (cover).left, U = (cover).right] }] \as Small;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Signed;
\import Native.ZeroExtension[C := IntersectionChains.complex] \as Intersection;
\import Native.ZeroExtension[C := Sum.complex] \as Middle;
\import Native.ZeroExtension[C := Small.complex] \as Target;
\import Native.Map[C := IntersectionChains.complex, D := Sum.complex].ZeroExtension[f := Chains.inclusion] \as Inclusion;
\import Native.Map[C := Sum.complex, D := Small.complex].ZeroExtension[f := Chains.projection] \as Projection;
\import Chains.Sequence[] \as Sequence;
\import Signed.ShortExact[A := Intersection.complex, B := Middle.complex, C := Target.complex] \as ChainSequence;
\definition nativeSequence: ChainSequence.Sequence := Sequence.sequence;
\module Coefficients(coefficients: Modules.Bundle);
\structure Data: \Set := {
  intersection: Native.Map[C := IntersectionChains.complex, D := IntersectionChains.complex].Map,
  middle: Native.Map[C := Sum.complex, D := Sum.complex].Map,
  small: Native.Map[C := Small.complex, D := Small.complex].Map,
};
\structure Laws[data: Data]: \Prop := {
  left: \forall (n: N.Nat^)(x: IntersectionChains.Carrier n) ->
    (data.middle).apply n ((Chains.inclusion).apply n x) = (Chains.inclusion).apply n ((data.intersection).apply n x),
  right: \forall (n: N.Nat^)(x: Sum.Carrier n) ->
    (Chains.projection).apply n ((data.middle).apply n x) = (data.small).apply n ((Chains.projection).apply n x),
};
\definition Mapping: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module With(mapping: Mapping);
