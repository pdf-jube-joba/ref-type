\definition small: Modules.Bundle := Modules.Bundle { Carrier := Target.Carrier z, space := Target.space z };
\definition middle: Modules.Bundle := Modules.Bundle { Carrier := Middle.Carrier z, space := Middle.space z };
\import Modules.Hom[V := Middle.Carrier z, W := Target.Carrier z, source := Middle.space z, target := Target.space z] \as ProjectionMaps;
\definition projection: ProjectionMaps.Map := ProjectionMaps.Map {
  apply := #apply{Projection.map} z, addition := #addition{Projection.map} z, scalar := #scalar{Projection.map} z,
};
\import Modules.SurjectiveDescent[A := middle, B := small, U := coefficients] \as Descent;
\definition injective: \forall (phi, psi: SmallHom.Carrier z) -> #apply{inclusion} z phi = #apply{inclusion} z psi -> phi = psi :=
  \fun (phi, psi: SmallHom.Carrier z)(equal: _) => SmallHom.At[z := z].ext phi psi \block {
    \fun (x: Target.Carrier z) \then
    \takefrom y: \Cast[Middle.Carrier z] ({ y: Middle.Carrier z \where #apply{Projection.map} z y = x }) \by Sequence.sequence.onto z x \then
    \let lifted: #apply{Projection.map} z y = x := \bysub(Middle.Carrier z, { y: Middle.Carrier z \where #apply{Projection.map} z y = x }, y) \then
    \return trans!{coefficients.Carrier} _ _ _
      (sym!{coefficients.Carrier} _ _ (congr!{{Target.Carrier z} coefficients.Carrier} (#apply{phi}) _ _ lifted))
      (trans!{coefficients.Carrier} _ _ _
        (congr!{{MiddleHom.Carrier z} coefficients.Carrier} (\fun (h: MiddleHom.Carrier z) => #apply{h} y) _ _ equal)
        (congr!{{Target.Carrier z} coefficients.Carrier} (#apply{psi}) _ _ lifted))
  };
\definition zero: \forall (phi: SmallHom.Carrier z) -> #apply{restriction} z (#apply{inclusion} z phi) = #zero{(IntersectionHom.space z)} :=
  \fun (phi: SmallHom.Carrier z) => IntersectionHom.At[z := z].ext _ _
    (\fun (x: Intersection.Carrier z) => trans!{coefficients.Carrier} _ _ _
      (congr!{{Target.Carrier z} coefficients.Carrier} (#apply{phi}) _ _ (Sequence.sequence.zero z x))
      (SmallHom.At[z := z].zeroPreserved phi));
\definition kills: \forall (phi: MiddleHom.Carrier z) -> #apply{restriction} z phi = #zero{(IntersectionHom.space z)} ->
  Descent.On[q := projection, f := phi].KillsKernel := \block {
  \fun (phi: MiddleHom.Carrier z)(vanishes: _)(x: Middle.Carrier z)(closed: #apply{Projection.map} z x = #zero{(Target.space z)}) \then
  \takefrom y: \Cast[Intersection.Carrier z] ({ y: Intersection.Carrier z \where #apply{Inclusion.map} z y = x }) \by Sequence.sequence.kernelImage z x closed \then
  \return trans!{coefficients.Carrier} _ _ _
    (sym!{coefficients.Carrier} _ _ (congr!{{Middle.Carrier z} coefficients.Carrier} (#apply{phi}) _ _
      (\bysub(Intersection.Carrier z, { y: Intersection.Carrier z \where #apply{Inclusion.map} z y = x }, y))))
    (congr!{{IntersectionHom.Carrier z} coefficients.Carrier} (\fun (h: IntersectionHom.Carrier z) => #apply{h} y) _ _ vanishes)
};
\definition kernelImage: \forall (phi: MiddleHom.Carrier z) -> #apply{restriction} z phi = #zero{(IntersectionHom.space z)} ->
  \exists { psi: SmallHom.Carrier z \where #apply{inclusion} z psi = phi } := \block {
  \fun (phi: MiddleHom.Carrier z)(vanishes: _) \then
  \let psi: SmallHom.Carrier z := Descent.On[q := projection, f := phi].map (Sequence.sequence.onto z) (kills phi vanishes) \then
  \return Logic.existsIntro[SmallHom.Carrier z, { psi: SmallHom.Carrier z \where #apply{inclusion} z psi = phi }] psi
    (MiddleHom.At[z := z].ext _ _ (Descent.On[q := projection, f := phi].onImage (Sequence.sequence.onto z) (kills phi vanishes)))
};
