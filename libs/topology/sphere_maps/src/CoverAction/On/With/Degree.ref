\import Equality.Prop[A := Sum.Carrier n] \as SumEquality;
\import Equality.Prop[A := Small.Carrier n] \as SmallEquality;
\definition left: \forall (chain: Intersection.Carrier (I.Int^::ofNat n)) ->
  (MiddleAction.map).apply (I.Int^::ofNat n) ((Inclusion.map).apply (I.Int^::ofNat n) chain) =
    (Inclusion.map).apply (I.Int^::ofNat n) ((LeftAction.map).apply (I.Int^::ofNat n) chain) :=
  \fun (chain: Intersection.Carrier (I.Int^::ofNat n)) =>
    SumEquality.congr[Middle.Carrier (I.Int^::ofNat n)] Middle.Positive[n := n].intro _ _ (leftNative n chain);
\definition right: \forall (chain: Middle.Carrier (I.Int^::ofNat n)) ->
  (Projection.map).apply (I.Int^::ofNat n) ((MiddleAction.map).apply (I.Int^::ofNat n) chain) =
    (RightAction.map).apply (I.Int^::ofNat n) ((Projection.map).apply (I.Int^::ofNat n) chain) :=
  \fun (chain: Middle.Carrier (I.Int^::ofNat n)) =>
    SmallEquality.congr[Target.Carrier (I.Int^::ofNat n)] Target.Positive[n := n].intro _ _ (rightNative n chain);
