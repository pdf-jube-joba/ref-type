\import Equality.Prop[A := Target.Carrier z] \as SmallEquality;
\import Equality.Prop[A := Middle.Carrier z] \as MiddleEquality;
\definition left: \forall (cochain: SmallHom.Carrier z) ->
  #apply{SumAction.map} z (#apply{inclusion} z cochain) = #apply{inclusion} z (#apply{SmallAction.map} z cochain) :=
  \fun (cochain: SmallHom.Carrier z) => MiddleHom.At[z := z].ext _ _
    (\fun (chain: Middle.Carrier z) => SmallEquality.congr[coefficients.Carrier] (#apply{cochain}) _ _ (#right{diagram} z chain));
\definition right: \forall (cochain: MiddleHom.Carrier z) ->
  #apply{restriction} z (#apply{SumAction.map} z cochain) = #apply{SignedIntersectionAction.map} z (#apply{restriction} z cochain) :=
  \fun (cochain: MiddleHom.Carrier z) => IntersectionHom.At[z := z].ext _ _
    (\fun (chain: Intersection.Carrier z) => MiddleEquality.congr[coefficients.Carrier] (#apply{cochain}) _ _ (#left{diagram} z chain));
