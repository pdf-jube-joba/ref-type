\import Equality.Prop[A := Target.Carrier z] \as SmallEquality;
\import Equality.Prop[A := Middle.Carrier z] \as MiddleEquality;
\definition leftInput(cochain: SmallHom.Carrier z): MiddleHom.Carrier z :=
  #apply{SumAction.map} z (#apply{inclusion} z cochain);
\definition leftOutput(cochain: SmallHom.Carrier z): MiddleHom.Carrier z :=
  #apply{inclusion} z (#apply{SmallAction.map} z cochain);
\definition rightInput(cochain: MiddleHom.Carrier z): IntersectionHom.Carrier z :=
  #apply{restriction} z (#apply{SumAction.map} z cochain);
\definition rightOutput(cochain: MiddleHom.Carrier z): IntersectionHom.Carrier z :=
  #apply{SignedIntersectionAction.map} z (#apply{restriction} z cochain);
\definition left: \forall (cochain: SmallHom.Carrier z) -> leftInput cochain = leftOutput cochain :=
  \fun (cochain: SmallHom.Carrier z) => MiddleHom.At[z := z].ext (leftInput cochain) (leftOutput cochain)
    (\fun (chain: Middle.Carrier z) => SmallEquality.congr[coefficients.Carrier] (#apply{cochain}) _ _ (projectionSquare z chain));
\definition right: \forall (cochain: MiddleHom.Carrier z) -> rightInput cochain = rightOutput cochain :=
  \fun (cochain: MiddleHom.Carrier z) => IntersectionHom.At[z := z].ext (rightInput cochain) (rightOutput cochain)
    (\fun (chain: Intersection.Carrier z) => MiddleEquality.congr[coefficients.Carrier] (#apply{cochain}) _ _ (inclusionSquare z chain));
