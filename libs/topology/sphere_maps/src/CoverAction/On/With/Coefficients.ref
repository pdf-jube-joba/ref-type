\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import Hom.Integer[P := Target.complex, N := coefficients] \as SmallHom;
\import Hom.Integer[P := Middle.complex, N := coefficients] \as MiddleHom;
\import Hom.Integer[P := Intersection.complex, N := coefficients] \as IntersectionHom;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficient;
\import \root.CoverAction[A := A, source := source].On[cover := cover].Coefficients[coefficients := coefficients] \as Base;
\definition inclusion: Cochains.Map[C := SmallHom.complex, D := MiddleHom.complex].Map := Base.inclusion;
\definition restriction: Cochains.Map[C := MiddleHom.complex, D := IntersectionHom.complex].Map := Base.restriction;
\import Cochains.ShortExact[A := SmallHom.complex, B := MiddleHom.complex, C := IntersectionHom.complex] \as Exact;
\definition sequence: Exact.Sequence := Base.sequence;
\import Hom.IntegerMapping[P := Target.complex, Q := Target.complex, N := coefficients, L := coefficients].On[f := RightAction.map, u := Coefficient.identity] \as SmallAction;
\import Hom.IntegerMapping[P := Middle.complex, Q := Middle.complex, N := coefficients, L := coefficients].On[f := MiddleAction.map, u := Coefficient.identity] \as SumAction;
\import Hom.IntegerMapping[P := Intersection.complex, Q := Intersection.complex, N := coefficients, L := coefficients].On[f := LeftAction.map, u := Coefficient.identity] \as SignedIntersectionAction;
\definition smallAction: Cochains.Map[C := SmallHom.complex, D := SmallHom.complex].Map := SmallAction.map;
\definition middleAction: Cochains.Map[C := MiddleHom.complex, D := MiddleHom.complex].Map := SumAction.map;
\definition intersectionAction: Cochains.Map[C := IntersectionHom.complex, D := IntersectionHom.complex].Map := SignedIntersectionAction.map;
\import Exact.Morphism[A1 := SmallHom.complex, B1 := MiddleHom.complex, C1 := IntersectionHom.complex] \as Morphism;
\import Morphism.Diagram[s := sequence, t := sequence, a := smallAction, b := middleAction, c := intersectionAction] \as Naturality;
\module Degree(z: I.Int^);
\definition naturality: Naturality.Commutative := Naturality.Commutative {
  left := \fun (z: I.Int^) => Degree[z := z].left,
  right := \fun (z: I.Int^) => Degree[z := z].right,
};
\module At(z: I.Int^) {
  \definition connectingNaturality: _ := Naturality.At[k := z].naturality naturality;
  \definition projectionNaturality: _ := Naturality.At[k := z].projectionNaturality naturality;
}
