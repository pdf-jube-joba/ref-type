\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Naturals;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Signed;
\import Native.ZeroExtension[C := C] \as Domain;
\import Native.ZeroExtension[C := D] \as Codomain;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.On[P := D, N := coefficients] \as Source;
\import Hom.On[P := C, N := coefficients] \as Target;
\import Hom.Integer[P := Codomain.complex, N := coefficients] \as IntegerSource;
\import Hom.Integer[P := Domain.complex, N := coefficients] \as IntegerTarget;
\import Hom.ZeroExtension[P := D, N := coefficients] \as SourceComparison;
\import Hom.ZeroExtension[P := C, N := coefficients] \as TargetComparison;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficient;
\module On(f: Native.Map[C := C, D := D].Map);
