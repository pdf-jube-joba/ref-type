\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Naturals;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Signed;
\definition sourceNative: Native.Complex := Native.Complex {
  family := Native.Family { Carrier := C.family.Carrier, space := C.family.space },
  differential := Native.DifferentialData[Native.Family { Carrier := C.family.Carrier, space := C.family.space }] { apply := #apply{C.differential} },
  laws := Native.DifferentialLaws[Native.Family { Carrier := C.family.Carrier, space := C.family.space }, Native.DifferentialData[Native.Family { Carrier := C.family.Carrier, space := C.family.space }] { apply := #apply{C.differential} }] {
    addition := #addition{C.laws}, scalar := #scalar{C.laws}, squareZero := #squareZero{C.laws},
  },
};
\definition targetNative: Native.Complex := Native.Complex {
  family := Native.Family { Carrier := D.family.Carrier, space := D.family.space },
  differential := Native.DifferentialData[Native.Family { Carrier := D.family.Carrier, space := D.family.space }] { apply := #apply{D.differential} },
  laws := Native.DifferentialLaws[Native.Family { Carrier := D.family.Carrier, space := D.family.space }, Native.DifferentialData[Native.Family { Carrier := D.family.Carrier, space := D.family.space }] { apply := #apply{D.differential} }] {
    addition := #addition{D.laws}, scalar := #scalar{D.laws}, squareZero := #squareZero{D.laws},
  },
};
\import Native.ZeroExtension[C := sourceNative] \as Domain;
\import Native.ZeroExtension[C := targetNative] \as Codomain;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.On[P := targetNative, N := coefficients] \as Source;
\import Hom.On[P := sourceNative, N := coefficients] \as Target;
\import Hom.Integer[P := Codomain.complex, N := coefficients] \as IntegerSource;
\import Hom.Integer[P := Domain.complex, N := coefficients] \as IntegerTarget;
\import Hom.ZeroExtension[P := targetNative, N := coefficients] \as SourceComparison;
\import Hom.ZeroExtension[P := sourceNative, N := coefficients] \as TargetComparison;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficient;
\module On(f: Native.Map[C := sourceNative, D := targetNative].Map);
