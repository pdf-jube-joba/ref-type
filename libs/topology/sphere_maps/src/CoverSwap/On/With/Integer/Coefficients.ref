\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import Hom.Integer[P := Target.complex, N := coefficients] \as SmallHom;
\import Hom.Integer[P := Middle.complex, N := coefficients] \as MiddleHom;
\import Hom.Integer[P := Intersection.complex, N := coefficients] \as IntersectionHom;
\import Action.Coefficients[coefficients := coefficients] \as Proofs;
\definition inclusion: Cochains.Map[C := SmallHom.complex, D := MiddleHom.complex].Map := Proofs.inclusion;
\definition restriction: Cochains.Map[C := MiddleHom.complex, D := IntersectionHom.complex].Map := Proofs.restriction;
\import Cochains.ShortExact[A := SmallHom.complex, B := MiddleHom.complex, C := IntersectionHom.complex] \as Exact;
\definition sequence: Exact.Sequence := Proofs.sequence;
\module At(z: I.Int^) {
  \definition connectingNaturality: _ := Proofs.At[z := z].connectingNaturality;
  \definition projectionNaturality: _ := Proofs.At[z := z].projectionNaturality;
}
