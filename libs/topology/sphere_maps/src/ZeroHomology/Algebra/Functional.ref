\import Chains.At[C := C, z := z] \as H;
\definition Closed: \Prop := \forall (x: C.family.Carrier (chain_complexes.Chain[].next z)) -> #apply{functional} (#apply{H.prior} x) = I.Zero.specification;
\import Modules.Hom[V := H.Cycle, W := I.Int^, source := H.cycleSpace, target := Modules.scalarModule] \as Cycles;
\definition onCycles: Cycles.Map := Cycles.Map {
  apply := \fun (x: H.Cycle) => #apply{functional} x,
  addition := \fun (x, y: H.Cycle) => #addition{functional} x y,
  scalar := \fun (a: I.Int^)(x: H.Cycle) => #scalar{functional} a x,
};
\import Modules.Of[V := C.family.Carrier z, space := C.family.space z].Submodule[] \as Submodules;
\import Submodules.Image[U := C.family.Carrier (chain_complexes.Chain[].next z), source := C.family.space (chain_complexes.Chain[].next z)] \as Images;
\import Modules.Of[V := H.Cycle, space := H.cycleSpace].Submodule[].Quotient[S := H.boundariesInside].To[W := I.Int^, target := Modules.scalarModule] \as Descent;
\definition vanishes: Closed -> Descent.Vanishes onCycles :=
  \fun (closed: Closed)(x: H.Cycle)(member: _) => Images.eliminate H.prior x (#apply{functional} x = I.Zero.specification)
    (\fun (y: C.family.Carrier (chain_complexes.Chain[].next z))(same: #apply{H.prior} y = x) => trans!{I.Int^} _ _ _
      (congr!{{C.family.Carrier z} I.Int^} (#apply{functional}) _ _ (sym!{{C.family.Carrier z}} _ _ same)) (closed y)) member;
\definition map(closed: Closed): Modules.Hom[V := H.Homology, W := I.Int^, source := H.homologySpace, target := Modules.scalarModule].Map :=
  Descent.descend onCycles (vanishes closed);
\definition onClass: \forall (closed: Closed)(x: H.Cycle) -> #apply{(map closed)} (H.classOf x) = #apply{functional} x :=
  \fun (closed: Closed) => Descent.onClass onCycles (vanishes closed);
