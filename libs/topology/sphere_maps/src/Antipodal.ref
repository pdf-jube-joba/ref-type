\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import \root.IntegerPowers[] \as Powers;
\import algebraic_topology.Spheres[] \as Geometry;
\definition DegreeLaw(n: N.Nat^): \Prop :=
  cohomology_models.Spheres[].Orientation[n := n].degree
    Geometry.Antipodal[n := N.Nat^::succ n].apply Geometry.Antipodal[n := N.Nat^::succ n].continuous =
      Powers.sign (N.Nat^::succ (N.Nat^::succ n));
\definition degree: \forall (n: N.Nat^) -> DegreeLaw n :=
  \induction (n: N.Nat^) \return DegreeLaw n \with {
    | zero: trans!{I.Int^} _ _ _ \root.Circle[].Antipodal[].Degree[].degree (sym!{I.Int^} _ _ Powers.square)
    | succ: \fun (n: N.Nat^)(previous: DegreeLaw n) => trans!{I.Int^} _ _ _ \root.AntipodalStep[n := n].law
        (trans!{I.Int^} _ _ _ (congr!{I.Int^ I.Int^} I.Neg.specification _ _ previous)
          (sym!{I.Int^} _ _ (Powers.successor (N.Nat^::succ (N.Nat^::succ n)))))
  };
