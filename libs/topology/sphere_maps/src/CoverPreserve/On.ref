\definition left: \Pow A := (cover).left;
\definition right: \Pow A := (cover).right;
\structure Data: \Set := { function: A -> A };
\structure Laws[data: Data]: \Prop := {
  continuous: Maps.Continuous source source data.function,
  toLeft: \forall (x: A) -> Space.Member left x -> Space.Member left (data.function x),
  toRight: \forall (x: A) -> Space.Member right x -> Space.Member right (data.function x),
};
\definition Mapping: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module With(mapping: Mapping);
