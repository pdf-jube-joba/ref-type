\import singular_cohomology.Chains[A := Sphere, source := topology] \as Chains;
\import singular_cohomology.Simplices[A := Sphere, source := topology] \as Simplices;
\import singular_cohomology.Calculations[A := Sphere, source := topology].With[coefficients := coefficients].Singleton[a := a] \as PointModel;
\import PointModel.Degree[n := n] \as Degree;
\import PointModel.Positive[n := n] \as Closed;
\import Modules.Free[Generators := Simplices.Carrier dimension].To[W := coefficients.Carrier, target := coefficients.space] \as Free;
\import std.Logic[].Proposition[] \as Logic;
\use Equality.sym;
\import Modules.Alternating[V := coefficients.Carrier, space := coefficients.space] \as Sums;
\definition primitive[h: H.CycleCarrier]: SphereCochains.Carrier n := PointModel.constant n (PointModel.value dimension h);
\definition primitiveLaw: \forall (h: H.CycleCarrier) ->
  SphereCochains.coboundary n (primitive h) = (Self.map (apply a) (continuous a) Coefficient.identity).apply dimension h :=
  \fun (h: H.CycleCarrier) => Free.ext _ _
    (\fun (sigma: Simplices.Carrier dimension) => trans!{coefficients.Carrier} _ _ _
      (Degree.constantCoboundary (PointModel.value dimension h) sigma)
      (trans!{coefficients.Carrier} _ _ _
        (PointModel.previousSum (N.Nat^::succ dimension) (PointModel.value dimension h) (Closed.closedValue h))
        (sym!{coefficients.Carrier} _ _ (Self.At[n := dimension].onCochain (apply a) (continuous a) Coefficient.identity h sigma))));
\definition classZero: \forall (h: H.CycleCarrier) ->
  H.classOf ((Pull.cyclesMap (Self.map (apply a) (continuous a) Coefficient.identity)).apply h) = H.zeroClass :=
  \fun (h: H.CycleCarrier) => H.boundaryClassZero ((Pull.cyclesMap (Self.map (apply a) (continuous a) Coefficient.identity)).apply h)
    (Logic.existsIntro[SphereCochains.Carrier n, { g: SphereCochains.Carrier n \where SphereCochains.coboundary n g = (Self.map (apply a) (continuous a) Coefficient.identity).apply dimension h }] (primitive h) (primitiveLaw h));
