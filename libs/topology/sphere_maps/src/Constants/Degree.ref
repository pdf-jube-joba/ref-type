\import cohomology_models.Spheres[].Orientation[n := n] \as Orientation;
\import \parent.With[coefficients := Orientation.coefficients] \as Groups;
\import Modules.Hom[V := Orientation.Carrier, W := I.Int^, source := Orientation.space, target := Modules.scalarModule] \as ToCoefficient;
\definition zero: \forall (a: Sphere) -> Orientation.degree (apply a) (continuous a) = I.Zero.specification :=
  \fun (a: Sphere) => trans!{I.Int^} _ _ _
    (congr!{Orientation.Carrier I.Int^} (#apply{Orientation.toCoefficient}) _ _ (Groups.actionZero a Orientation.generator))
    (ToCoefficient.zeroPreserved Orientation.toCoefficient);
