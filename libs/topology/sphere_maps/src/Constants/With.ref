\import singular_cohomology.Cochains[A := Sphere, source := topology].With[coefficients := coefficients] \as SphereCochains;
\definition Carrier: \Set := SphereCochains.cohomology dimension;
\definition space: Modules.Space Carrier := SphereCochains.cohomologySpace dimension;
\import singular_cohomology.Maps[A := Sphere, B := Sphere, source := topology, target := topology].Coefficients[M := coefficients, L := coefficients] \as Self;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficient;
\definition action[a: Sphere]: Modules.Hom[V := Carrier, W := Carrier, source := space, target := space].Map :=
  Self.At[n := dimension].induced (apply a) (continuous a) Coefficient.identity;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.At[C := SphereCochains.complex, k := dimension] \as H;
\import Complexes.Map[C := SphereCochains.complex, D := SphereCochains.complex].At[k := dimension] \as Pull;
\module At(a: Sphere);
\definition actionZero: \forall (a: Sphere)(q: Carrier) -> (action a).apply q = (space).zero :=
  \fun (a: Sphere) => H.classInduction (\fun (q: Carrier) => (action a).apply q = (space).zero)
    (\fun (h: H.CycleCarrier) => trans!{Carrier} _ _ _
      (Pull.onClass (Self.map (apply a) (continuous a) Coefficient.identity) h) (At[a := a].classZero h));
