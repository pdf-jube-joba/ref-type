\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.congr;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import algebraic_topology.Spheres[] \as Geometry;
\definition dimension: N.Nat^ := N.Nat^::succ n;
\definition Sphere: \Set := Geometry.Carrier dimension;
\definition topology: topology.Topology[Carrier := Sphere].Topology := Geometry.topology dimension;
\import topology.Maps[A := Sphere, B := Sphere] \as SelfMaps;
\definition apply[a, x: Sphere]: Sphere := a;
\definition continuous: \forall (a: Sphere) -> topology.Continuity[A := Sphere, B := Sphere].Continuous topology topology (apply a) :=
  \fun (a: Sphere) => SelfMaps.constantContinuous topology topology a;
\module With(coefficients: Modules.Bundle);
\module Degree;
