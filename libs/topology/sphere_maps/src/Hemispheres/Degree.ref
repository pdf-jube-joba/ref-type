\import cohomology_models.Spheres[].Orientation[n := n] \as Orientation;
\import cohomology_models.Spheres[].With[coefficients := Orientation.coefficients].Top[n := n] \as Top;
\import \parent.With[coefficients := Orientation.coefficients].Positive[].Whole[] \as Action;
\import Modules.Hom[V := Orientation.Carrier, W := I.Int^, source := Orientation.space, target := Modules.scalarModule] \as ToCoefficient;
\definition head: Orientation.degree Reflection.head Reflection.headContinuous = I.Neg.specification I.One.specification :=
  trans!{I.Int^} _ _ _
    (congr!{Orientation.Carrier I.Int^} (#apply{Orientation.toCoefficient}) _ _ (Action.naturalAction Orientation.generator))
    (trans!{I.Int^} _ _ _ (ToCoefficient.negativePreserved Orientation.toCoefficient Orientation.generator)
      (congr!{I.Int^ I.Int^} I.Neg.specification _ _ (#leftInverse{Top.isomorphism} I.One.specification)));
