\import Cochains.At[C := LowerHom.complex, z := z] \as LowerH;
\import Cochains.At[C := IntersectionHom.complex, z := z] \as IntersectionH;
\import Cochains.Map[C := IntersectionHom.complex, D := LowerHom.complex].At[k := z] \as Pullback;
\import Cochains.Map[C := IntersectionHom.complex, D := IntersectionHom.complex].At[k := z] \as ActionMap;
\import Hom.IntegerComposition[P := Lower.complex, Q := Intersection.complex, T := Intersection.complex, N := coefficients] \as PullComposition;
\import singular_cohomology.Equivalence[A := Spheres.Carrier n, B := Geometry.Intersection, source := Spheres.topology n, target := Geometry.intersectionTopology]
  .Signed[].With[coefficients := coefficients].At[z := z] \as Comparison;
\definition intersectionAction: \forall (q: IntersectionH.Cohomology) -> (ActionMap.induced reflectionPull).apply q = q :=
  \fun (q: IntersectionH.Cohomology) => (Comparison.bijective Cover.intersectionEquivalence).injective _ _
    (trans!{LowerH.Cohomology} _ _ _
      (sym!{LowerH.Cohomology} _ _ (PullComposition.At[k := z].onCohomology inclusion reflection q))
      (congr!{{Chains.Map[C := Lower.complex, D := Intersection.complex].Map} LowerH.Cohomology}
        (\fun (f: Chains.Map[C := Lower.complex, D := Intersection.complex].Map) => (Pullback.induced Pull.On[f := f, u := Coefficient.identity].map).apply q)
        _ _ fixed));
