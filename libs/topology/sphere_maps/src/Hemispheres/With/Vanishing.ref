\definition upper: I.Int^ := I.Int^::ofNat (N.Nat^::succ n);
\import singular_cohomology.Chains[A := Geometry.Left, source := Geometry.leftTopology] \as LeftChains;
\import singular_cohomology.Chains[A := Geometry.Right, source := Geometry.rightTopology] \as RightChains;
\import Native.Biproduct[C := LeftChains.complex, D := RightChains.complex] \as Sum;
\import Native.ZeroExtension[C := Sum.complex] \as Middle;
\import Hom.Integer[P := Middle.complex, N := coefficients] \as MiddleHom;
\import Cochains.At[C := MiddleHom.complex, z := upper] \as MiddleH;
\import singular_cohomology.Cochains[A := Geometry.Left, source := Geometry.leftTopology].With[coefficients := coefficients] \as LeftTheory;
\import singular_cohomology.Cochains[A := Geometry.Right, source := Geometry.rightTopology].With[coefficients := coefficients] \as RightTheory;
\import singular_cohomology.Calculations[A := Geometry.Left, source := Geometry.leftTopology].With[coefficients := coefficients].Contractible[].Positive[n := n] \as LeftCalculation;
\import singular_cohomology.Calculations[A := Geometry.Right, source := Geometry.rightTopology].With[coefficients := coefficients].Contractible[].Positive[n := n] \as RightCalculation;
\import Modules.Isomorphism[V := LeftTheory.Integer[].cohomology upper, W := LeftTheory.cohomology (N.Nat^::succ n), source := LeftTheory.Integer[].cohomologySpace upper, target := LeftTheory.cohomologySpace (N.Nat^::succ n)] \as LeftIso;
\import Modules.Isomorphism[V := RightTheory.Integer[].cohomology upper, W := RightTheory.cohomology (N.Nat^::succ n), source := RightTheory.Integer[].cohomologySpace upper, target := RightTheory.cohomologySpace (N.Nat^::succ n)] \as RightIso;
\import Modules.Hom[V := LeftTheory.cohomology (N.Nat^::succ n), W := LeftTheory.Integer[].cohomology upper, source := LeftTheory.cohomologySpace (N.Nat^::succ n), target := LeftTheory.Integer[].cohomologySpace upper] \as LeftBackward;
\import Modules.Hom[V := RightTheory.cohomology (N.Nat^::succ n), W := RightTheory.Integer[].cohomology upper, source := RightTheory.cohomologySpace (N.Nat^::succ n), target := RightTheory.Integer[].cohomologySpace upper] \as RightBackward;
\definition leftZero: \forall (q: LeftTheory.Integer[].cohomology upper) -> q = #zero{(LeftTheory.Integer[].cohomologySpace upper)} :=
  \fun (q: LeftTheory.Integer[].cohomology upper) => trans!{{LeftTheory.Integer[].cohomology upper}} _ _ _
    (sym!{{LeftTheory.Integer[].cohomology upper}} _ _ (#leftInverse{LeftTheory.Integer[].At[n := N.Nat^::succ n].isomorphism} q))
    (trans!{{LeftTheory.Integer[].cohomology upper}} _ _ _
      (congr!{{LeftTheory.cohomology (N.Nat^::succ n)} {LeftTheory.Integer[].cohomology upper}} (#apply{#backward{LeftTheory.Integer[].At[n := N.Nat^::succ n].isomorphism}}) _ _
        (LeftCalculation.zero Cover.leftContraction (#apply{#forward{LeftTheory.Integer[].At[n := N.Nat^::succ n].isomorphism}} q)))
      (LeftBackward.zeroPreserved #backward{LeftTheory.Integer[].At[n := N.Nat^::succ n].isomorphism}));
\definition rightZero: \forall (q: RightTheory.Integer[].cohomology upper) -> q = #zero{(RightTheory.Integer[].cohomologySpace upper)} :=
  \fun (q: RightTheory.Integer[].cohomology upper) => trans!{{RightTheory.Integer[].cohomology upper}} _ _ _
    (sym!{{RightTheory.Integer[].cohomology upper}} _ _ (#leftInverse{RightTheory.Integer[].At[n := N.Nat^::succ n].isomorphism} q))
    (trans!{{RightTheory.Integer[].cohomology upper}} _ _ _
      (congr!{{RightTheory.cohomology (N.Nat^::succ n)} {RightTheory.Integer[].cohomology upper}} (#apply{#backward{RightTheory.Integer[].At[n := N.Nat^::succ n].isomorphism}}) _ _
        (RightCalculation.zero Cover.rightContraction (#apply{#forward{RightTheory.Integer[].At[n := N.Nat^::succ n].isomorphism}} q)))
      (RightBackward.zeroPreserved #backward{RightTheory.Integer[].At[n := N.Nat^::succ n].isomorphism}));
\import Hom.Biproduct[P := LeftChains.complex, Q := RightChains.complex, N := coefficients].At[z := upper] \as Split;
\import Modules.Biproduct[V := LeftTheory.Integer[].cohomology upper, W := RightTheory.Integer[].cohomology upper, left := LeftTheory.Integer[].cohomologySpace upper, right := RightTheory.Integer[].cohomologySpace upper] \as Pair;
\import std.Data[].Pair[].Prop[A := LeftTheory.Integer[].cohomology upper, B := RightTheory.Integer[].cohomology upper] \as Pairs;
\import Modules.Hom[V := Pair.Carrier, W := MiddleH.Cohomology, source := Pair.space, target := MiddleH.cohomologySpace] \as Backward;
\definition middleZero: \forall (q: MiddleH.Cohomology) -> q = #zero{MiddleH.cohomologySpace} :=
  \fun (q: MiddleH.Cohomology) => trans!{MiddleH.Cohomology} _ _ _ (sym!{MiddleH.Cohomology} _ _ (#leftInverse{Split.isomorphism} q))
    (trans!{MiddleH.Cohomology} _ _ _
      (congr!{Pair.Carrier MiddleH.Cohomology} (#apply{#backward{Split.isomorphism}}) _ _
        (Pairs.ext _ _ (leftZero (Pair.first (#apply{#forward{Split.isomorphism}} q))) (rightZero (Pair.second (#apply{#forward{Split.isomorphism}} q)))))
      (Backward.zeroPreserved #backward{Split.isomorphism}));
