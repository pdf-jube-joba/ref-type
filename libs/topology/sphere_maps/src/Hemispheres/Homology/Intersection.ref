\import SignedChains.Map[C := LowerExtension.complex, D := IntersectionExtension.complex].At[k := lowerDegree] \as Inclusion;
\import SignedChains.Map[C := IntersectionExtension.complex, D := IntersectionExtension.complex].At[k := lowerDegree] \as Reflection;
\import InclusionComposition.At[k := lowerDegree] \as Composition;
\import singular_cohomology.Equivalence[A := Spheres.Carrier n, B := Geometry.Intersection, source := Spheres.topology n, target := Geometry.intersectionTopology]
  .Signed[].Homology[z := lowerDegree] \as Comparison;
\definition action: \forall (q: IntersectionH.Homology) -> (Reflection.induced intersectionReflection).apply q = q := \block {
  \fun (q: IntersectionH.Homology) \then
  \takefrom p: \Cast[LowerH.Homology] ({ p: LowerH.Homology \where (Inclusion.induced inclusion).apply p = q })
    \by (Comparison.bijective Cover.intersectionEquivalence).onto q \then
  \let same: (Inclusion.induced inclusion).apply p = q :=
    \bysub(LowerH.Homology, { p: LowerH.Homology \where (Inclusion.induced inclusion).apply p = q }, p) \then
  \return trans!{IntersectionH.Homology} _ _ _
    (sym!{IntersectionH.Homology} _ _
      (congr!{IntersectionH.Homology IntersectionH.Homology} ((Reflection.induced intersectionReflection).apply) _ _ same))
    (trans!{IntersectionH.Homology} _ _ _
      (sym!{IntersectionH.Homology} _ _ (Composition.compositionOnHomology intersectionReflection inclusion p))
      (trans!{IntersectionH.Homology} _ _ _
        (congr!{{SignedChains.Map[C := LowerExtension.complex, D := IntersectionExtension.complex].Map} IntersectionH.Homology}
          (\fun (f: SignedChains.Map[C := LowerExtension.complex, D := IntersectionExtension.complex].Map) => (Inclusion.induced f).apply p)
          _ _ fixed) same))
};
\import SignedChains.Map[C := IntersectionExtension.complex, D := IntersectionExtension.complex].At[k := lowerDegree] \as SignedReflection;
\import Modules.Hom[V := IntersectionH.Cycle, W := IntersectionH.Homology, source := IntersectionH.cycleSpace, target := IntersectionH.homologySpace] \as Classes;
\definition signedCycle: \forall (x: IntersectionH.Cycle) ->
  (SignedReflection.cyclesMap Diagram.leftAction).apply x =
    (IntersectionH.cycleSpace).neg ((Reflection.cyclesMap intersectionReflection).apply x) :=
  \fun (x: IntersectionH.Cycle) => \refl((IntersectionH.cycleSpace).neg ((Reflection.cyclesMap intersectionReflection).apply x));
\definition signedAction: \forall (q: IntersectionH.Homology) ->
  (SignedReflection.induced Diagram.leftAction).apply q = (IntersectionH.homologySpace).neg q :=
  IntersectionH.classInduction (\fun (q: IntersectionH.Homology) =>
    (SignedReflection.induced Diagram.leftAction).apply q = (IntersectionH.homologySpace).neg q)
    (\fun (x: IntersectionH.Cycle) => trans!{IntersectionH.Homology} _ _ _ (SignedReflection.onClass Diagram.leftAction x)
      (trans!{IntersectionH.Homology} _ _ _ (congr!{IntersectionH.Cycle IntersectionH.Homology} IntersectionH.classOf _ _ (signedCycle x))
        (trans!{IntersectionH.Homology} _ _ _ (Classes.negativePreserved IntersectionH.classLinear ((Reflection.cyclesMap intersectionReflection).apply x))
          (congr!{IntersectionH.Homology IntersectionH.Homology} ((IntersectionH.homologySpace).neg) _ _
            (trans!{IntersectionH.Homology} _ _ _ (sym!{IntersectionH.Homology} _ _ (Reflection.onClass intersectionReflection x))
              (action (IntersectionH.classOf x)))))));
