\import SignedChains.ShortExact[A := IntersectionExtension.complex, B := MiddleExtension.complex, C := SmallExtension.complex] \as Exact;
\import Exact.At[s := Sequence.nativeSequence, k := upperDegree] \as Connecting;
\import Connecting.Exactness[] \as Exactness;
\import SignedChains.Map[C := MiddleExtension.complex, D := SmallExtension.complex].At[k := upperDegree] \as Projection;
\import Modules.Hom[V := SmallH.Homology, W := IntersectionH.Homology, source := SmallH.homologySpace, target := IntersectionH.homologySpace] \as ConnectingLinear;
\import Modules.Hom[V := MiddleH.Homology, W := SmallH.Homology, source := MiddleH.homologySpace, target := SmallH.homologySpace] \as ProjectionLinear;
\definition zeroKernel: \forall (q: SmallH.Homology) -> #apply{Connecting.connecting} q = #zero{IntersectionH.homologySpace} -> q = #zero{SmallH.homologySpace} := \block {
  \fun (q: SmallH.Homology)(killed: _) \then
  \takefrom p: \Cast[MiddleH.Homology] ({ p: MiddleH.Homology \where #apply{(Projection.induced Sequence.nativeSequence.projection)} p = q })
    \by Exactness.exactAtC q killed \then
  \return trans!{SmallH.Homology} _ _ _
    (sym!{SmallH.Homology} _ _ (\bysub(MiddleH.Homology,
      { p: MiddleH.Homology \where #apply{(Projection.induced Sequence.nativeSequence.projection)} p = q }, p)))
    (trans!{SmallH.Homology} _ _ _
      (congr!{MiddleH.Homology SmallH.Homology} (#apply{(Projection.induced Sequence.nativeSequence.projection)}) _ _ (\parent.Vanishing[].zero p))
      (ProjectionLinear.zeroPreserved (Projection.induced Sequence.nativeSequence.projection)))
};
\definition injective: \forall (p, q: SmallH.Homology) -> #apply{Connecting.connecting} p = #apply{Connecting.connecting} q -> p = q :=
  ConnectingLinear.injectiveOfZeroKernel Connecting.connecting zeroKernel;
\import SignedChains.Map[C := SmallExtension.complex, D := SmallExtension.complex].At[k := upperDegree] \as Reflection;
\import Exact.Morphism[A1 := IntersectionExtension.complex, B1 := MiddleExtension.complex, C1 := SmallExtension.complex]
  .Diagram[s := Sequence.nativeSequence, t := Sequence.nativeSequence, a := Diagram.leftAction, b := Diagram.middleAction, c := Diagram.rightAction] \as Naturality;
\definition action: \forall (q: SmallH.Homology) -> #apply{(Reflection.induced Diagram.rightAction)} q = #neg{SmallH.homologySpace} q :=
  \fun (q: SmallH.Homology) => injective _ _
    (trans!{IntersectionH.Homology} _ _ _ (Naturality.At[k := upperDegree].naturality Diagram.diagram q)
      (trans!{IntersectionH.Homology} _ _ _ (\parent.Intersection[].signedAction (#apply{Connecting.connecting} q))
        (sym!{IntersectionH.Homology} _ _ (ConnectingLinear.negativePreserved Connecting.connecting q))));
