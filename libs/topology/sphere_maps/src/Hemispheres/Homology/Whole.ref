\import singular_cohomology.Maps[A := Geometry.Sphere, B := Geometry.Sphere, source := Spheres.topology (N.Nat^::succ n), target := Spheres.topology (N.Nat^::succ n)] \as Maps;
\import Native.Map[C := SmallChains.complex, D := WholeChains.complex].ZeroExtension[f := SmallChains.inclusion] \as InclusionExtension;
\definition reflection: SignedChains.Map[C := WholeExtension.complex, D := WholeExtension.complex].Map := Maps.integerPush Reflection.head Reflection.headContinuous;
\import SignedChains.Map[C := WholeExtension.complex, D := WholeExtension.complex].Composition[B := SmallExtension.complex] \as ReflectAfterInclude;
\import SignedChains.Map[C := SmallExtension.complex, D := WholeExtension.complex].Composition[B := SmallExtension.complex] \as IncludeAfterReflect;
\module Degree(k: N.Nat^);
\import SignedChains.Map[C := SmallExtension.complex, D := WholeExtension.complex] \as InclusionMaps;
\definition square: ReflectAfterInclude.compose reflection InclusionExtension.map = IncludeAfterReflect.compose InclusionExtension.map Diagram.rightAction := InclusionMaps.ext
  (ReflectAfterInclude.compose reflection InclusionExtension.map) (IncludeAfterReflect.compose InclusionExtension.map Diagram.rightAction)
  (\induction (z: I.Int^) \return \forall (x: SmallExtension.Carrier z) ->
    (reflection).apply z ((InclusionExtension.map).apply z x) = (InclusionExtension.map).apply z ((Diagram.rightAction).apply z x) \with {
    | ofNat: \fun (k: N.Nat^) => Degree[k := k].signedSquare
    | negSucc: \fun (k: N.Nat^)(x: SmallExtension.Carrier (I.Int^::negSucc k)) => \refl((WholeExtension.space (I.Int^::negSucc k)).zero)
  });
\import SignedChains.Map[C := SmallExtension.complex, D := WholeExtension.complex].At[k := upperDegree] \as Inclusion;
\import SignedChains.Map[C := SmallExtension.complex, D := SmallExtension.complex].At[k := upperDegree] \as SmallReflection;
\import SignedChains.Map[C := WholeExtension.complex, D := WholeExtension.complex].At[k := upperDegree] \as WholeReflection;
\import ReflectAfterInclude.At[k := upperDegree] \as LeftComposition;
\import IncludeAfterReflect.At[k := upperDegree] \as RightComposition;
\definition naturality: \forall (q: SmallH.Homology) ->
  (WholeReflection.induced reflection).apply ((Inclusion.induced InclusionExtension.map).apply q) =
    (Inclusion.induced InclusionExtension.map).apply ((SmallReflection.induced Diagram.rightAction).apply q) :=
  \fun (q: SmallH.Homology) => trans!{WholeH.Homology} _ _ _
    (sym!{WholeH.Homology} _ _ (LeftComposition.compositionOnHomology reflection InclusionExtension.map q))
    (trans!{WholeH.Homology} _ _ _
      (congr!{InclusionMaps.Map WholeH.Homology} (\fun (f: InclusionMaps.Map) => (Inclusion.induced f).apply q) _ _ square)
      (RightComposition.compositionOnHomology InclusionExtension.map Diagram.rightAction q));
\import singular_excision.MayerVietoris[A := Geometry.Sphere].Over[source := Spheres.topology (N.Nat^::succ n)].On[cover := Cover.cover] \as CoverData;
\import singular_cohomology.OpenCover[A := Geometry.Sphere, source := Spheres.topology (N.Nat^::succ n)].On[cover := CoverData.openCover] \as Covered;
\import Native.Equivalence[C := SmallChains.complex, D := WholeChains.complex].ZeroExtension[e := Covered.equivalence] \as ChainComparison;
\import SignedChains.Equivalence[C := SmallExtension.complex, D := WholeExtension.complex].At[k := upperDegree] \as Comparison;
\import Modules.Hom[V := SmallH.Homology, W := WholeH.Homology, source := SmallH.homologySpace, target := WholeH.homologySpace] \as InclusionLinear;
\definition Carrier: \Set := WholeH.Homology;
\definition space: Modules.Space Carrier := WholeH.homologySpace;
\definition action: Modules.Hom[V := Carrier, W := Carrier, source := space, target := space].Map := WholeReflection.induced reflection;
\definition head: \forall (q: Carrier) -> (action).apply q = (space).neg q := \block {
  \fun (q: Carrier) \then
  \takefrom p: \Cast[SmallH.Homology] ({ p: SmallH.Homology \where (Inclusion.induced InclusionExtension.map).apply p = q })
    \by (Comparison.bijective ChainComparison.equivalence).onto q \then
  \let same: (Inclusion.induced InclusionExtension.map).apply p = q :=
    \bysub(SmallH.Homology, { p: SmallH.Homology \where (Inclusion.induced InclusionExtension.map).apply p = q }, p) \then
  \return trans!{Carrier} _ _ _
    (sym!{Carrier} _ _ (congr!{Carrier Carrier} ((action).apply) _ _ same))
    (trans!{Carrier} _ _ _ (naturality p)
      (trans!{Carrier} _ _ _
        (congr!{SmallH.Homology Carrier} ((Inclusion.induced InclusionExtension.map).apply) _ _ (\parent.Small[].action p))
        (trans!{Carrier} _ _ _ (InclusionLinear.negativePreserved (Inclusion.induced InclusionExtension.map) p)
          (congr!{Carrier Carrier} ((space).neg) _ _ same))))
};
