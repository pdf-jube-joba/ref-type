\import std.Logic[].Equality[] \as Eq;
\import std.Logic[].Proposition[] \as Logic;
\use Eq.trans;
\use Eq.sym;
\use Eq.congr;
\use Eq.eq_reason_in;
\import std.Data[].Nat[] \as N;
\import relative_k_theory.Relative[] \as Relative;
\import bott_product.Bott[] \as Bott;
\import algebraic_topology.Euclidean[].Dimension[n := Bott.three] \as Sphere;
\import Sphere.Compactness[] \as Compactness;
\import topological_k_theory.KTheory[] \as KTheory;
\import KTheory.On[X := Sphere.Sphere, baseSpace := Sphere.sphereTopology,
  compact := Compactness.sphere, hausdorff := Compactness.sphereHausdorff] \as SphereTheory;
\import Bott.Product[X := Sphere.Sphere, source := Sphere.sphereTopology,
  compact := Compactness.sphere, hausdorff := Compactness.sphereHausdorff].Hemisphere[] \as Hemisphere;
\definition sphere: Relative.CompactPointed := Relative.pack Sphere.Sphere (Relative.PointedDetails[Sphere.Sphere] {
  topology := Sphere.sphereTopology, compact := Compactness.sphere, hausdorff := Compactness.sphereHausdorff, point := Hemisphere.point
});
\import Relative.Reduced[model := sphere] \as SphereGroup;
\definition beta: SphereGroup.Carrier := \into[SphereTheory.K0[].Carrier](Bott.generator, SphereTheory.Ranks[].Reduced[point := (Relative.details sphere).point].kernel) \by { Bott.Rank[].zero (Relative.details sphere).point };
\module Reduced(model: Relative.CompactPointed);

\module Negative(model: Relative.CompactPointed, degree: N.Nat^);
\module PointPair(model: Relative.CompactPointed);
\module RelativePair(X: \Set, space: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact space, hausdorff: topology.Topology[Carrier := X].IsT2 space,
  subset: \Pow X, closed: topology.Topology[Carrier := X].IsClosedIn space subset);
\module SquareSphere;
\module SuspensionSphere;
\module SmashEquivalence(left, targetLeft, right: Relative.CompactPointed, e: Relative.Equivalence[source := left, target := targetLeft].Data);
\module SmashUnit(model: Relative.CompactPointed);
\module SmashNegative(model: Relative.CompactPointed, degree: N.Nat^);
\module DoubleComparison(model: Relative.CompactPointed);
\module TwoShift(model: Relative.CompactPointed);
\module Parity;
\module Isomorphism(A, B: \Set, source: std.Alg[].Alg[].CommutativeGroup[A], target: std.Alg[].Alg[].CommutativeGroup[B]);
\module Integer;
\module Avoidance;
\module ComplexLinear(n: N.Nat^);
\module IntervalPair;
\module Point;
\module Coefficients;
\module Spheres;
\module BottSpheres;
\module SwapSphere;
\module OddProduct(left, right: Relative.CompactPointed);
\module Examples;
\module Product(left, right: Relative.CompactPointed, first, second: std.Arithmetic[].Int[].Int^);
\module SixTerm(X: \Set, space: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact space, hausdorff: topology.Topology[Carrier := X].IsT2 space,
  subset: \Pow X, closed: topology.Topology[Carrier := X].IsClosedIn space subset);
