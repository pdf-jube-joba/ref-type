\import \root.Periodicity[].Point[] \as Point;
\definition pointNegativeOne: \forall (x: Point.Odd) -> x = Point.oddGroup.base.unit := Point.oddZero;
\import \root.Periodicity[].IntervalPair[].Circle[] \as Circle;
\definition reducedCircle: \forall (x: Circle.Carrier) -> x = Circle.group.base.unit := Circle.zero;
\import \root.Periodicity[].BottSpheres[] \as Spheres;
\definition firstBott: Spheres.Carrier Bott.one := Spheres.generator Bott.one;
\definition secondBott: Spheres.Carrier Bott.two := Spheres.generator Bott.two;
\definition secondFormula: secondBott = \root.Periodicity[].Reduced[model := Spheres.model Bott.one].forward firstBott := Spheres.iteratedBott Bott.one;
\module Reduced(model: Relative.CompactPointed);
