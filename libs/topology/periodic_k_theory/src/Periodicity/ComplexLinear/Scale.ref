\definition value: Matrices.Matrix := Operations.scale z A;
\definition candidate: Matrices.Matrix := Operations.scale (Op.inv z) (Field.inverse A);
\definition left: Matrices.product candidate value = Matrices.identity := eq_reason_in!{{Matrices.Matrix} _
  "=" _ "by" { MatrixLaws.scaleLeft (Op.inv z) (Field.inverse A) value }
  "=" _ "by" { congr!{{Matrices.Matrix} {Matrices.Matrix}} (Operations.scale (Op.inv z)) _ _ (MatrixLaws.scaleRight z (Field.inverse A) A) }
  "=" _ "by" { normalize z nonzero (Matrices.product (Field.inverse A) A) }
  "=" _ "by" { (MatrixLaws.inverseLaws A (Field.inverse A)).left }
};
\definition right: Matrices.product value candidate = Matrices.identity := eq_reason_in!{{Matrices.Matrix} _
  "=" _ "by" { MatrixLaws.scaleRight (Op.inv z) value (Field.inverse A) }
  "=" _ "by" { congr!{{Matrices.Matrix} {Matrices.Matrix}} (Operations.scale (Op.inv z)) _ _ (MatrixLaws.scaleLeft z A (Field.inverse A)) }
  "=" _ "by" { normalize z nonzero (Matrices.product A (Field.inverse A)) }
  "=" _ "by" { (MatrixLaws.inverseLaws A (Field.inverse A)).right }
};
\definition inverse: MatrixLaws.Inverse value := \into[Matrices.Matrix](candidate, MatrixLaws.Inverse value) \by {
  MatrixLaws.InverseLaws[value, candidate] { left := left, right := right }
};
\definition invertible: Field.Nonzero value := Field.nonzeroOfInverse value inverse;
