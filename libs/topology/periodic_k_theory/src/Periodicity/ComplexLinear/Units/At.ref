\import algebraic_topology.PathComponent[A := Native.Carrier, source := Native.topology] \as UnitPaths;
\import algebraic_topology.PathComponent[A := Field.Nonsingular, source := topology].Maps[B := Native.Carrier, target := Native.topology] \as Mapping;
\definition onIdentity: ofMatrix identity = Native.identity := Hermitian.Square[].linearIdentity;
\definition onMatrix: ofMatrix (Native.matrix h) = h := Representation.linearEntries h;
\definition exists: UnitPaths.Related Native.identity h :=
  \idelim ofMatrix identity = Native.identity \with a: Native.Carrier => UnitPaths.Related a h \by {
    base: \idelim ofMatrix (Native.matrix h) = h \with b: Native.Carrier => UnitPaths.Related (ofMatrix identity) b \by {
      base: Mapping.preserves ofMatrix continuous identity (Native.matrix h)
        (\root.Periodicity[].ComplexLinear[n := n].At[A := Native.matrix h].pathExists), equality: onMatrix
    }, equality: onIdentity
  };
