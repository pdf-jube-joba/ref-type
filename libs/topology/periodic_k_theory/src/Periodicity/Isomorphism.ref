\structure Data: \Set := {
  forward: A -> B,
  backward: B -> A,
  leftInverse: \forall (a: A) -> backward (forward a) = a,
  rightInverse: \forall (b: B) -> forward (backward b) = b,
  forwardAdd: \forall (a, b: A) -> forward (source.base.op a b) = target.base.op (forward a) (forward b),
  backwardAdd: \forall (a, b: B) -> backward (target.base.op a b) = source.base.op (backward a) (backward b),
  forwardZero: forward source.base.unit = target.base.unit,
  backwardZero: backward target.base.unit = source.base.unit
};
\module Compose(C: \Set, last: std.Alg[].Alg[].CommutativeGroup[C], first: Data,
  second: \root.Periodicity[].Isomorphism[A := B, B := C, source := target, target := last].Data);
