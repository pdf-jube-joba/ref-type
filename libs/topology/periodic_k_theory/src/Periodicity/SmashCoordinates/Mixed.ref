\import Smash.Graded[firstDegree := Bott.one, secondDegree := N.Nat^::zero] \as First;
\import Smash.Graded[firstDegree := N.Nat^::zero, secondDegree := Bott.one] \as Second;
\import Source.Mapping[other := Smash.result, mapping := Identity.map] \as Regroup;
\definition leftEquation: \forall (t: Time.Carrier)(a: left.Carrier)(b: right.Carrier) -> First.equivalence.forward (Source.single t (class a b)) =
  LeftShift.projection (Pairs.pair Left.once.Carrier right.Carrier (Left.single t a) b) :=
  \fun (t: Time.Carrier)(a: left.Carrier)(b: right.Carrier) => eq_reason_in!{{LeftShift.result.Carrier} _
    "=" _ "by" { congr!{{Source.once.Carrier} {LeftShift.result.Carrier}}
      (\fun (z: Source.once.Carrier) => (Smash.leftIteration Bott.one).forward (First.liftedRight.forward z)) _ _ (Regroup.singleEquation t (class a b)) }
    "=" _ "by" { congr!{{Source.once.Carrier} {LeftShift.result.Carrier}} (Smash.leftIteration Bott.one).forward _ _ (Regroup.singleEquation t (class a b)) }
    "=" _ "by" { leftOne t a b }
  };
\definition rightEquation: \forall (t: Time.Carrier)(a: left.Carrier)(b: right.Carrier) -> Second.equivalence.forward (Source.single t (class a b)) =
  RightShift.projection (Pairs.pair left.Carrier Right.once.Carrier a (Right.single t b)) := rightOne;
