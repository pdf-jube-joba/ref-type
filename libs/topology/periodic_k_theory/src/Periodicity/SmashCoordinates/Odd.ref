\import Smash.Graded[firstDegree := Bott.one, secondDegree := Bott.one] \as Native;
\import Relative.Smash[left := Left.once, right := Right.once] \as Both;
\import \root.Periodicity[].Coordinates[model := Source.once] \as TwiceCoordinates;
\import Relative.Identity[model := Source.once] \as MiddleIdentity;
\import TwiceCoordinates.Mapping[other := Source.once, mapping := MiddleIdentity.map] \as Regrouping;
\import \root.Periodicity[].Coordinates[model := RightShift.result] \as RightCoordinates;
\import TwiceCoordinates.Mapping[other := RightShift.result, mapping := (Smash.rightIteration Bott.one).forward] \as RightLift;
\import \root.Periodicity[].SmashCoordinates[left := left, right := Right.once] \as Shifted;
\definition equation: \forall (t, s: Time.Carrier)(a: left.Carrier)(b: right.Carrier) ->
  Native.equivalence.forward (Source.double t s (class a b)) = Both.projection (Pairs.pair Left.once.Carrier Right.once.Carrier (Left.single t a) (Right.single s b)) :=
  \fun (t, s: Time.Carrier)(a: left.Carrier)(b: right.Carrier) => eq_reason_in!{{Both.result.Carrier} _
    "=" _ "by" { congr!{{Source.twice.Carrier} {Both.result.Carrier}}
      (\fun (z: Source.twice.Carrier) => (RightShift.leftIteration Bott.one).forward (Native.liftedRight.forward z)) _ _ (Regrouping.singleEquation t (Source.single s (class a b))) }
    "=" _ "by" { congr!{{RightCoordinates.once.Carrier} {Both.result.Carrier}} (RightShift.leftIteration Bott.one).forward _ _ (RightLift.singleEquation t (Source.single s (class a b))) }
    "=" _ "by" { congr!{{RightShift.result.Carrier} {Both.result.Carrier}}
      (\fun (z: RightShift.result.Carrier) => (RightShift.leftIteration Bott.one).forward (RightCoordinates.single t z)) _ _ (rightOne s a b) }
    "=" _ "by" { Shifted.leftOne t a (Right.single s b) }
  };
