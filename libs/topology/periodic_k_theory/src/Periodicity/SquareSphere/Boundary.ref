\import \parent.Plane[] \as Plane;
\import \parent.Stereographic[] \as Stereo;
\import \parent.Forward[] \as Forward;
\import \parent.Pole[] \as Pole;
\definition gapSquare: square (Plane.gap z) = Real.zero := trans!{{Real.Real}} _ _ _ (congr!{{Real.Real} {Real.Real}} square _ _ edge) (Laws.fieldMulZeroLeft Real.zero);
\definition denominator: Plane.denominator z = Plane.r2 z := trans!{{Real.Real}} _ _ _
  (congr!{{Real.Real} {Real.Real}} (Real.add (Plane.r2 z)) _ _ gapSquare) (Laws.addZeroRight (Plane.r2 z));
\definition numerator: Real.sub (Plane.r2 z) (square (Plane.gap z)) = Plane.denominator z := trans!{{Real.Real}} _ _ _
  (congr!{{Real.Real} {Real.Real}} (Real.sub (Plane.r2 z)) _ _ gapSquare)
  (trans!{{Real.Real}} _ _ _ (Laws.subZeroRight (Plane.r2 z)) (sym!{{Real.Real}} _ _ denominator));
\definition height: Plane.height z = Real.one := trans!{{Real.Real}} _ _ _
  (congr!{{Real.Real} {Real.Real}} (\fun (v: Real.Real) => Real.mul v (Plane.inverse z)) _ _ numerator)
  (trans!{{Real.Real}} _ _ _ (Laws.fieldMulComm (Plane.denominator z) (Plane.inverse z)) (Plane.inverseLaw z));
\definition equation: Forward.map z = (Relative.details sphere).point := Pole.characterizes (Forward.map z)
  (trans!{{Real.Real}} _ _ _ (Stereo.headFormula z) height);
