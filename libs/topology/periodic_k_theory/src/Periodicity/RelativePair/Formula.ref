\import Induced.External[] \as Naturality;
\import Relative.PullbackIdentity[model := Quotient.model] \as LeftIdentity;
\import Relative.Equivalence[source := sphere, target := RightQuotient.model].With[e := Point.equivalence].Groups[] \as PointGroups;
\import Relative.Reduced[model := Intermediate.result] \as IntermediateGroup;
\import Product.External[] \as External;
\import Intermediate.External[] \as Native;
\definition afterPull: \forall (a: Quotient.Relative) -> SphereTransport.forward (Native.product a betaRelative) = Reduced.forward a :=
  \fun (a: Quotient.Relative) => trans!{{Reduced.TargetCarrier}} _ _ _ (Naturality.naturality a betaRelative)
    (congr!{{Quotient.Relative} {SphereGroup.Carrier} {Reduced.TargetCarrier}} Smash.External[].product _ _ _ _
      (LeftIdentity.equation a) (PointGroups.leftInverse beta));
\definition productFormula: \forall (a: Quotient.Relative) -> forward a = External.product a betaRelative :=
  \fun (a: Quotient.Relative) => congr!{{IntermediateGroup.Carrier} {Product.Relative}} Transport.forward _ _
    (trans!{{IntermediateGroup.Carrier}} _ _ _
      (congr!{{Reduced.TargetCarrier} {IntermediateGroup.Carrier}} SphereTransport.backward _ _ (sym!{{Reduced.TargetCarrier}} _ _ (afterPull a)))
      (SphereTransport.rightInverse (Native.product a betaRelative)));
