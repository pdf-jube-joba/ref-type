\definition preimage: \forall (a: SubsetOdd) -> boundaryOdd a = relativeEvenGroup.base.unit -> \exists (x: WholeOdd \where restrictionOdd x = a) := \block {
  \fun (a: SubsetOdd)(zero: _) \then
  \takefrom x: \Cast[Even.First] ({ x: Even.First \where Even.restrictionNegative x = a }) \by (Even.exactSecond a).ltr zero \then
  \return Logic.existsIntro[WholeOdd, { x: WholeOdd \where restrictionOdd x = a }] x
    (trans!{SubsetOdd} _ _ _ (sym!{SubsetOdd} _ _ (Even.restrictionLink x))
      (\bysub(Even.First, { x: Even.First \where Even.restrictionNegative x = a }, x)))
};
\definition kernel: \forall (a: SubsetOdd) -> (\exists (x: WholeOdd \where restrictionOdd x = a)) -> boundaryOdd a = relativeEvenGroup.base.unit := \block {
  \fun (a: SubsetOdd)(image: _) \then
  \takefrom x: \Cast[WholeOdd] ({ x: WholeOdd \where restrictionOdd x = a }) \by image \then
  \return (Even.exactSecond a).rtl (Logic.existsIntro[Even.First, { x: Even.First \where Even.restrictionNegative x = a }] x
    (trans!{SubsetOdd} _ _ _ (Even.restrictionLink x) (\bysub(WholeOdd, { x: WholeOdd \where restrictionOdd x = a }, x))))
};
\definition exact[a: SubsetOdd]: Logic.PropEquiv[boundaryOdd a = relativeEvenGroup.base.unit, \exists (x: WholeOdd \where restrictionOdd x = a)] := Logic.PropEquiv[_, _] { ltr := preimage a, rtl := kernel a };
