\definition preimage: \forall (q: RelativeOdd) -> forgetOdd q = wholeOddGroup.base.unit -> \exists (a: SubsetEven \where boundaryEven a = q) := \block {
  \fun (q: RelativeOdd)(zero: _) \then
  \takefrom a: \Cast[Odd.Second] ({ a: Odd.Second \where Odd.boundary a = q }) \by (Odd.exactThird q).ltr zero \then
  \return Logic.existsIntro[SubsetEven, { b: SubsetEven \where boundaryEven b = q }] (SubsetPeriod.backward a)
    (trans!{RelativeOdd} _ _ _ (congr!{{Odd.Second} RelativeOdd} Odd.boundary _ _ (SubsetPeriod.rightInverse a))
      (\bysub(Odd.Second, { a: Odd.Second \where Odd.boundary a = q }, a)))
};
\definition kernel: \forall (q: RelativeOdd) -> (\exists (a: SubsetEven \where boundaryEven a = q)) -> forgetOdd q = wholeOddGroup.base.unit := \block {
  \fun (q: RelativeOdd)(image: _) \then
  \takefrom a: \Cast[SubsetEven] ({ a: SubsetEven \where boundaryEven a = q }) \by image \then
  \return (Odd.exactThird q).rtl (Logic.existsIntro[Odd.Second, { b: Odd.Second \where Odd.boundary b = q }] (SubsetPeriod.forward a)
    (\bysub(SubsetEven, { a: SubsetEven \where boundaryEven a = q }, a)))
};
\definition exact[q: RelativeOdd]: Logic.PropEquiv[forgetOdd q = wholeOddGroup.base.unit, \exists (a: SubsetEven \where boundaryEven a = q)] := Logic.PropEquiv[_, _] { ltr := preimage q, rtl := kernel q };
