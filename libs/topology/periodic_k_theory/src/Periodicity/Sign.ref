\import std.Data[].Bool[] \as B;
\definition apply[parity: B.Bool^][x: X]: X := (\induction (p: B.Bool^) \return X \with {
  | false: x
  | true: group.base.inv x
}) parity;
\module Mapping(Y: \Set, target: std.Alg[].Alg[].CommutativeGroup[Y], f: X -> Y,
  additive: \forall (x, y: X) -> f (group.base.op x y) = target.base.op (f x) (f y), preservesZero: f group.base.unit = target.base.unit) {
  \import \root.Periodicity[].Sign[X := Y, group := target] \as Target;
  \import Relative.GroupCalculus[X := X, group := group].Mapping[Y := Y, target := target, f := f, additive := additive, preservesZero := preservesZero] \as Linear;
  \definition equation: \forall (parity: B.Bool^)(x: X) -> f (apply parity x) = Target.apply parity (f x) :=
    \induction (parity: B.Bool^) \return \forall (x: X) -> f (apply parity x) = Target.apply parity (f x) \with {
      | false: \fun (x: X) => \refl(f x)
      | true: Linear.inverse
    };
}
