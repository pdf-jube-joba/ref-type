\import KTheory.On[X := X, baseSpace := space, compact := compact, hausdorff := hausdorff].K0[] \as Ordinary;
\definition Carrier: \Set := \parent.At[degree := I.Zero.specification].Carrier;
\definition forward: Ordinary.Carrier -> Carrier := Native.forward;
\definition backward: Carrier -> Ordinary.Carrier := Native.backward;
\definition leftInverse: \forall (a: Ordinary.Carrier) -> backward (forward a) = a := Native.leftInverse;
\definition rightInverse: \forall (b: Carrier) -> forward (backward b) = b := Native.rightInverse;
\definition additive: \forall (a, b: Ordinary.Carrier) -> forward (Ordinary.add a b) = (\parent.At[degree := I.Zero.specification].group).base.op (forward a) (forward b) := Native.Additive[].forwardAdd;
