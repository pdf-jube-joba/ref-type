\import Relative.Absolute[X := X, space := space, compact := compact, hausdorff := hausdorff] \as Native;
\definition model: Relative.CompactPointed := Native.model;
\module At(degree: I.Int^) {
  \import \root.Periodicity[].Integer[].At[model := model, degree := degree] \as Native;
  \definition Carrier: \Set := Native.Carrier;
  \definition group: std.Alg[].Alg[].CommutativeGroup[Carrier] := Native.group;
  \definition Next: \Set := Native.Next;
  \definition nextGroup: std.Alg[].Alg[].CommutativeGroup[Next] := Native.nextGroup;
  \definition periodicity: \root.Periodicity[].Isomorphism[A := Carrier, B := Next, source := group, target := nextGroup].Data := Native.periodicity;
}
\module Zero;
