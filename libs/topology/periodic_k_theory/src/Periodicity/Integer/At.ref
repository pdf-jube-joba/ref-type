\import \parent.Normal[model := model, parity := P.value degree] \as Native;
\definition Carrier: \Set := Relative.Negative[original := model, degree := P.index (P.value degree)].Carrier;
\definition group: std.Alg[].Alg[].CommutativeGroup[Carrier] := Relative.Negative[original := model, degree := P.index (P.value degree)].group;
\definition next: I.Int^ := I.Add.specification degree P.two;
\definition Next: \Set := Relative.Negative[original := model, degree := P.index (P.value next)].Carrier;
\definition nextGroup: std.Alg[].Alg[].CommutativeGroup[Next] := Relative.Negative[original := model, degree := P.index (P.value next)].group;
\definition periodicity: \root.Periodicity[].Isomorphism[A := Carrier, B := Next, source := group, target := nextGroup].Data :=
  \parent.Transport[model := model].apply (P.value degree) (P.value next) (sym!{{B.Bool^}} _ _ (P.period degree));
\module Pullback(other: Relative.CompactPointed, mapping: Relative.Map model other);
\import Relative.Identity[model := model] \as Identity;
\definition identity: \forall (q: Carrier) -> Relative.NegativeMap[source := model, target := model, f := Identity.map, degree := P.index (P.value degree)].map q = q :=
  Identity.Negative[degree := P.index (P.value degree)].equation;
\module Composition(middle, target: Relative.CompactPointed, first: Relative.Map model middle, second: Relative.Map middle target);
