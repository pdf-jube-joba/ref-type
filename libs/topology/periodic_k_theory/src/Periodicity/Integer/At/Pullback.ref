\definition From: \Set := Relative.Negative[original := other, degree := P.index (P.value degree)].Carrier;
\definition fromGroup: std.Alg[].Alg[].CommutativeGroup[From] := Relative.Negative[original := other, degree := P.index (P.value degree)].group;
\import Relative.NegativeMap[source := model, target := other, f := mapping, degree := P.index (P.value degree)] \as Native;
\definition map: From -> Carrier := Native.map;
\definition additive: \forall (a, b: From) -> map (fromGroup.base.op a b) = group.base.op (map a) (map b) := Native.additive;
\definition preservesZero: map fromGroup.base.unit = group.base.unit := Native.preservesZero;
\import \root.Periodicity[].Integer[].At[model := other, degree := degree] \as Other;
\import Relative.NegativeMap[source := model, target := other, f := mapping, degree := P.index (P.value next)] \as NextPull;
\definition periodicity: \forall (q: From) -> (\root.Periodicity[].Integer[].At[model := model, degree := degree].periodicity).forward (map q) =
  NextPull.map ((Other.periodicity).forward q) := \fun (q: From) =>
    \root.Periodicity[].Integer[].Transport[model := model].Naturality[other := other, mapping := mapping].equation
      (P.value degree) (P.value next) (sym!{{B.Bool^}} _ _ (P.period degree)) q;
