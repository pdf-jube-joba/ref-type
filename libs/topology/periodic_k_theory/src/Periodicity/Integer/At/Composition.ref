\import Relative.Composition[source := model, middle := middle, target := target, first := first, second := second] \as Composite;
\definition From: \Set := Relative.Negative[original := target, degree := P.index (P.value degree)].Carrier;
\import Relative.NegativeMap[source := model, target := target, f := Composite.map, degree := P.index (P.value degree)] \as Direct;
\import Relative.NegativeMap[source := model, target := middle, f := first, degree := P.index (P.value degree)] \as First;
\import Relative.NegativeMap[source := middle, target := target, f := second, degree := P.index (P.value degree)] \as Second;
\definition equation: \forall (q: From) -> Direct.map q = First.map (Second.map q) := Composite.Negative[degree := P.index (P.value degree)].equation;
