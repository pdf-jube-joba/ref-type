\definition Carrier[parity: B.Bool^]: \Set := Relative.Negative[original := model, degree := P.index parity].Carrier;
\definition group[parity: B.Bool^]: std.Alg[].Alg[].CommutativeGroup[Carrier parity] := Relative.Negative[original := model, degree := P.index parity].group;
\definition Data[first, second: B.Bool^]: \Set := \root.Periodicity[].Isomorphism[A := Carrier first, B := Carrier second, source := group first, target := group second].Data;
\definition identity[parity: B.Bool^]: Data parity parity :=
  \root.Periodicity[].Isomorphism[A := Carrier parity, B := Carrier parity, source := group parity, target := group parity].Data {
    forward := \fun (a: Carrier parity) => a, backward := \fun (a: Carrier parity) => a,
    leftInverse := \fun (a: Carrier parity) => \refl(a), rightInverse := \fun (a: Carrier parity) => \refl(a),
    forwardAdd := \fun (a, b: Carrier parity) => \refl((group parity).base.op a b),
    backwardAdd := \fun (a, b: Carrier parity) => \refl((group parity).base.op a b),
    forwardZero := \refl((group parity).base.unit), backwardZero := \refl((group parity).base.unit)
  };
\definition apply[first, second: B.Bool^][same: first = second]: Data first second :=
  \idelim first = second \with parity: B.Bool^ => Data first parity \by { base: identity first, equality: same };
\module Naturality(other: Relative.CompactPointed, mapping: Relative.Map model other);
