\import \root.Periodicity[].Negative[model := model, degree := degree] \as Period;
\definition next: N.Nat^ := N.Nat^::succ (N.Nat^::succ degree);
\definition reversed: \root.Periodicity[].Isomorphism[A := Source next, B := Source degree, source := sourceGroup next, target := sourceGroup degree].Data :=
  \root.Periodicity[].Isomorphism[A := Source next, B := Source degree, source := sourceGroup next, target := sourceGroup degree].Data {
    forward := Period.backward, backward := Period.forward, leftInverse := Period.rightInverse, rightInverse := Period.leftInverse,
    forwardAdd := Period.backwardAdd, backwardAdd := Period.forwardAdd, forwardZero := Period.backwardZero, backwardZero := Period.forwardZero
  };
\definition normalized: \root.Periodicity[].Isomorphism[A := Source next, B := Target degree, source := sourceGroup next, target := targetGroup degree].Data :=
  \root.Periodicity[].Isomorphism[A := Source next, B := Source degree, source := sourceGroup next, target := sourceGroup degree].Compose[
    C := Target degree, last := targetGroup degree, first := reversed, second := previous].data;
\definition parity: Transport.Data (P.natural degree) (P.natural next) :=
  Transport.apply (P.natural degree) (P.natural next) (sym!{{B.Bool^}} _ _ (P.naturalPeriod degree));
\definition data: Data next :=
  \root.Periodicity[].Isomorphism[A := Source next, B := Target degree, source := sourceGroup next, target := targetGroup degree].Compose[
    C := Target next, last := targetGroup next, first := normalized, second := parity].data;
