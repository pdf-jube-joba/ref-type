\definition degreeInteger: I.Int^ := I.NegOfNat.specification degree;
\definition IntegerCarrier: \Set := Relative.Negative[original := model, degree := P.index (P.value degreeInteger)].Carrier;
\definition integerGroup: std.Alg[].Alg[].CommutativeGroup[IntegerCarrier] := Relative.Negative[original := model, degree := P.index (P.value degreeInteger)].group;
\definition parity: Transport.Data (P.natural degree) (P.value degreeInteger) := Transport.apply (P.natural degree) (P.value degreeInteger)
  (sym!{{B.Bool^}} _ _ (P.negativeNatural degree));
\definition isomorphism: \root.Periodicity[].Isomorphism[A := Source degree, B := IntegerCarrier, source := sourceGroup degree, target := integerGroup].Data :=
  \root.Periodicity[].Isomorphism[A := Source degree, B := Target degree, source := sourceGroup degree, target := targetGroup degree].Compose[
    C := IntegerCarrier, last := integerGroup, first := normal degree, second := parity].data;
