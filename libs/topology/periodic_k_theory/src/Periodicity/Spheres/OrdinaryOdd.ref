\definition model: Relative.CompactPointed := sphere dimension;
\import \root.Periodicity[].OrdinaryOdd[model := model] \as Comparison;
\import \parent.At[dimension := dimension, degree := I.One.specification] \as Reduced;
\definition Carrier: \Set := Comparison.Absolute;
\definition group: std.Alg[].Alg[].CommutativeGroup[Carrier] := Comparison.absoluteGroup;
\definition Coefficient: \Set := Reduced.Coefficient;
\definition coefficientGroup: std.Alg[].Alg[].CommutativeGroup[Coefficient] := Reduced.coefficientGroup;
\definition isomorphism: \root.Periodicity[].Isomorphism[A := Carrier, B := Coefficient, source := group, target := coefficientGroup].Data :=
  \root.Periodicity[].Isomorphism[A := Carrier, B := Comparison.Reduced, source := group, target := Comparison.reducedGroup].Compose[
    C := Coefficient, last := coefficientGroup,
    first := \root.Periodicity[].Isomorphism[A := Carrier, B := Comparison.Reduced, source := group, target := Comparison.reducedGroup].Data {
      forward := Comparison.backward, backward := Comparison.forward,
      leftInverse := Comparison.rightInverse, rightInverse := Comparison.leftInverse,
      forwardAdd := Comparison.backwardAdd, backwardAdd := Comparison.forwardAdd,
      forwardZero := Comparison.backwardZero, backwardZero := Comparison.forwardZero
    }, second := Reduced.isomorphism].data;
\definition parity: Reduced.parity = P.xor (P.natural dimension) B.Bool^::true := Reduced.parityFormula;
