\import \root.Periodicity[].SmashNegative[model := model n, degree := Bott.one] \as Period;
\definition zero: \forall (x: Odd (N.Nat^::succ n)) -> x = (oddGroup (N.Nat^::succ n)).base.unit :=
  \fun (x: Odd (N.Nat^::succ n)) => eq_reason_in!{{Odd (N.Nat^::succ n)} x
    "=" _ "by" { sym!{{Odd (N.Nat^::succ n)}} _ _ (Period.rightInverse x) }
    "=" _ "by" { congr!{{Odd n} {Odd (N.Nat^::succ n)}} Period.forward _ _ (previous (Period.backward x)) }
    "=" _ "by" { Period.forwardZero }
  };
