\import \root.Periodicity[].Reduced[model := model n] \as Period;
\definition reversed: \root.Periodicity[].Isomorphism[A := Carrier (N.Nat^::succ n), B := Carrier n, source := group (N.Nat^::succ n), target := group n].Data :=
  \root.Periodicity[].Isomorphism[A := Carrier (N.Nat^::succ n), B := Carrier n, source := group (N.Nat^::succ n), target := group n].Data {
    forward := Period.Inverse[].backward, backward := Period.forward, leftInverse := Period.Inverse[].rightInverse, rightInverse := Period.Inverse[].leftInverse,
    forwardAdd := Period.Inverse[].backwardAdd, backwardAdd := Period.Inverse[].forwardAdd, forwardZero := Period.Inverse[].backwardZero, backwardZero := Period.Inverse[].forwardZero
  };
\definition data: Data (N.Nat^::succ n) :=
  \root.Periodicity[].Isomorphism[A := Carrier (N.Nat^::succ n), B := Carrier n, source := group (N.Nat^::succ n), target := group n].Compose[
    C := I.Int^, last := integers, first := reversed, second := previous].data;
