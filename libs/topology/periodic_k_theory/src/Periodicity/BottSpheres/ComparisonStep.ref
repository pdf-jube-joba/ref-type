\definition lifted: Relative.Equivalence[source := Relative.iterate Bott.two (Sphere n), target := Relative.iterate Bott.two (model n)].Data :=
  Relative.Equivalence[source := Sphere n, target := model n].With[e := previous].iterate Bott.two;
\import \root.Periodicity[].DoubleComparison[model := model n] \as Double;
\definition equivalence: Equivalence (N.Nat^::succ n) :=
  Relative.Equivalence[source := Sphere (N.Nat^::succ n), target := model (N.Nat^::succ n)].Compose[
    middle := Relative.iterate Bott.two (model n), first := lifted, second := Double.equivalence].result;
