\definition xorZeroRight: \forall (x: B.Bool^) -> xor x B.Bool^::false = x := B.cases (\fun (x: B.Bool^) => xor x B.Bool^::false = x) (\refl(B.Bool^::false)) (\refl(B.Bool^::true));
\definition andZeroRight: \forall (x: B.Bool^) -> and x B.Bool^::false = B.Bool^::false := B.cases (\fun (x: B.Bool^) => and x B.Bool^::false = B.Bool^::false) (\refl(B.Bool^::false)) (\refl(B.Bool^::false));
\definition xorNegRight: \forall (a, b: B.Bool^) -> xor a (neg b) = neg (xor a b) := B.cases2 (\fun (a, b: B.Bool^) => xor a (neg b) = neg (xor a b))
  (\refl(B.Bool^::true)) (\refl(B.Bool^::false)) (\refl(B.Bool^::false)) (\refl(B.Bool^::true));
\definition mulStep: \forall (a, b: B.Bool^) -> and a (neg b) = xor a (and a b) := B.cases2 (\fun (a, b: B.Bool^) => and a (neg b) = xor a (and a b))
  (\refl(B.Bool^::false)) (\refl(B.Bool^::false)) (\refl(B.Bool^::true)) (\refl(B.Bool^::false));
\definition cross: \forall (a, b, c, d: B.Bool^) -> xor a d = xor c b -> xor a b = xor c d :=
  B.cases2 (\fun (a, b: B.Bool^) => \forall (c, d: B.Bool^) -> xor a d = xor c b -> xor a b = xor c d)
    (B.cases2 (\fun (c, d: B.Bool^) => xor B.Bool^::false d = xor c B.Bool^::false -> xor B.Bool^::false B.Bool^::false = xor c d)
      (\fun (same: B.Bool^::false = B.Bool^::false) => \refl(B.Bool^::false)) (\fun (same: B.Bool^::true = B.Bool^::false) => Logic.falseElim (B.Bool^::false = B.Bool^::true) (Bool.trueNeFalse same)) (\fun (same: B.Bool^::false = B.Bool^::true) => Logic.falseElim (B.Bool^::false = B.Bool^::true) (Bool.falseNeTrue same)) (\fun (same: B.Bool^::true = B.Bool^::true) => \refl(B.Bool^::false)))
    (B.cases2 (\fun (c, d: B.Bool^) => xor B.Bool^::false d = xor c B.Bool^::true -> xor B.Bool^::false B.Bool^::true = xor c d)
      (\fun (same: B.Bool^::false = B.Bool^::true) => Logic.falseElim (B.Bool^::true = B.Bool^::false) (Bool.falseNeTrue same)) (\fun (same: B.Bool^::true = B.Bool^::true) => \refl(B.Bool^::true)) (\fun (same: B.Bool^::false = B.Bool^::false) => \refl(B.Bool^::true)) (\fun (same: B.Bool^::true = B.Bool^::false) => Logic.falseElim (B.Bool^::true = B.Bool^::false) (Bool.trueNeFalse same)))
    (B.cases2 (\fun (c, d: B.Bool^) => xor B.Bool^::true d = xor c B.Bool^::false -> xor B.Bool^::true B.Bool^::false = xor c d)
      (\fun (same: B.Bool^::true = B.Bool^::false) => Logic.falseElim (B.Bool^::true = B.Bool^::false) (Bool.trueNeFalse same)) (\fun (same: B.Bool^::false = B.Bool^::false) => \refl(B.Bool^::true)) (\fun (same: B.Bool^::true = B.Bool^::true) => \refl(B.Bool^::true)) (\fun (same: B.Bool^::false = B.Bool^::true) => Logic.falseElim (B.Bool^::true = B.Bool^::false) (Bool.falseNeTrue same)))
    (B.cases2 (\fun (c, d: B.Bool^) => xor B.Bool^::true d = xor c B.Bool^::true -> xor B.Bool^::true B.Bool^::true = xor c d)
      (\fun (same: B.Bool^::true = B.Bool^::true) => \refl(B.Bool^::false)) (\fun (same: B.Bool^::false = B.Bool^::true) => Logic.falseElim (B.Bool^::false = B.Bool^::true) (Bool.falseNeTrue same)) (\fun (same: B.Bool^::true = B.Bool^::false) => Logic.falseElim (B.Bool^::false = B.Bool^::true) (Bool.trueNeFalse same)) (\fun (same: B.Bool^::false = B.Bool^::false) => \refl(B.Bool^::false)));
\definition four: \forall (a, b, c, d: B.Bool^) -> xor (xor a b) (xor c d) = xor (xor a c) (xor b d) :=
  B.cases2 (\fun (a, b: B.Bool^) => \forall (c, d: B.Bool^) -> xor (xor a b) (xor c d) = xor (xor a c) (xor b d))
    (B.cases2 (\fun (c, d: B.Bool^) => xor (xor B.Bool^::false B.Bool^::false) (xor c d) = xor (xor B.Bool^::false c) (xor B.Bool^::false d))
      (\refl(B.Bool^::false)) (\refl(B.Bool^::true)) (\refl(B.Bool^::true)) (\refl(B.Bool^::false)))
    (B.cases2 (\fun (c, d: B.Bool^) => xor (xor B.Bool^::false B.Bool^::true) (xor c d) = xor (xor B.Bool^::false c) (xor B.Bool^::true d))
      (\refl(B.Bool^::true)) (\refl(B.Bool^::false)) (\refl(B.Bool^::false)) (\refl(B.Bool^::true)))
    (B.cases2 (\fun (c, d: B.Bool^) => xor (xor B.Bool^::true B.Bool^::false) (xor c d) = xor (xor B.Bool^::true c) (xor B.Bool^::false d))
      (\refl(B.Bool^::true)) (\refl(B.Bool^::false)) (\refl(B.Bool^::false)) (\refl(B.Bool^::true)))
    (B.cases2 (\fun (c, d: B.Bool^) => xor (xor B.Bool^::true B.Bool^::true) (xor c d) = xor (xor B.Bool^::true c) (xor B.Bool^::true d))
      (\refl(B.Bool^::false)) (\refl(B.Bool^::true)) (\refl(B.Bool^::true)) (\refl(B.Bool^::false)));
\definition product: \forall (a, b, c, d: B.Bool^) -> xor (xor (and a c) (and b d)) (xor (and a d) (and b c)) = and (xor a b) (xor c d) :=
  B.cases2 (\fun (a, b: B.Bool^) => \forall (c, d: B.Bool^) -> xor (xor (and a c) (and b d)) (xor (and a d) (and b c)) = and (xor a b) (xor c d))
    (B.cases2 (\fun (c, d: B.Bool^) => xor (xor (and B.Bool^::false c) (and B.Bool^::false d)) (xor (and B.Bool^::false d) (and B.Bool^::false c)) = and (xor B.Bool^::false B.Bool^::false) (xor c d))
      (\refl(B.Bool^::false)) (\refl(B.Bool^::false)) (\refl(B.Bool^::false)) (\refl(B.Bool^::false)))
    (B.cases2 (\fun (c, d: B.Bool^) => xor (xor (and B.Bool^::false c) (and B.Bool^::true d)) (xor (and B.Bool^::false d) (and B.Bool^::true c)) = and (xor B.Bool^::false B.Bool^::true) (xor c d))
      (\refl(B.Bool^::false)) (\refl(B.Bool^::true)) (\refl(B.Bool^::true)) (\refl(B.Bool^::false)))
    (B.cases2 (\fun (c, d: B.Bool^) => xor (xor (and B.Bool^::true c) (and B.Bool^::false d)) (xor (and B.Bool^::true d) (and B.Bool^::false c)) = and (xor B.Bool^::true B.Bool^::false) (xor c d))
      (\refl(B.Bool^::false)) (\refl(B.Bool^::true)) (\refl(B.Bool^::true)) (\refl(B.Bool^::false)))
    (B.cases2 (\fun (c, d: B.Bool^) => xor (xor (and B.Bool^::true c) (and B.Bool^::true d)) (xor (and B.Bool^::true d) (and B.Bool^::true c)) = and (xor B.Bool^::true B.Bool^::true) (xor c d))
      (\refl(B.Bool^::false)) (\refl(B.Bool^::false)) (\refl(B.Bool^::false)) (\refl(B.Bool^::false)));
