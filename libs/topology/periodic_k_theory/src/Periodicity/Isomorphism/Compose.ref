\definition data: \root.Periodicity[].Isomorphism[A := A, B := C, source := source, target := last].Data :=
  \root.Periodicity[].Isomorphism[A := A, B := C, source := source, target := last].Data {
    forward := \fun (a: A) => second.forward (first.forward a),
    backward := \fun (c: C) => first.backward (second.backward c),
    leftInverse := \fun (a: A) => trans!{A} _ _ _
      (congr!{B A} first.backward _ _ (second.leftInverse (first.forward a))) (first.leftInverse a),
    rightInverse := \fun (c: C) => trans!{C} _ _ _
      (congr!{B C} second.forward _ _ (first.rightInverse (second.backward c))) (second.rightInverse c),
    forwardAdd := \fun (a, b: A) => trans!{C} _ _ _
      (congr!{B C} second.forward _ _ (first.forwardAdd a b)) (second.forwardAdd (first.forward a) (first.forward b)),
    backwardAdd := \fun (c, d: C) => trans!{A} _ _ _
      (congr!{B A} first.backward _ _ (second.backwardAdd c d)) (first.backwardAdd (second.backward c) (second.backward d)),
    forwardZero := trans!{C} _ _ _ (congr!{B C} second.forward _ _ first.forwardZero) second.forwardZero,
    backwardZero := trans!{A} _ _ _ (congr!{B A} first.backward _ _ second.backwardZero) first.backwardZero
  };
