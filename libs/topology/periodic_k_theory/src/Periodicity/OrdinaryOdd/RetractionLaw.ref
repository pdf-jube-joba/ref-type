\definition equation: \forall (p: Subset.model.Carrier) -> Retraction.map (Augmented.inclusion p) = p :=
  \induction (p: Subset.model.Carrier) \return Retraction.map (Augmented.inclusion p) = p \with {
    | inl: \fun (a: Pair.A) => congr!{{Pair.A} {Subset.model.Carrier}} Sum.inl _ _ (sym!{{Pair.A}} _ _ (singleton a))
    | inr: \fun (p: std.Data[].FinSet[].Fin Bott.one) => \refl(Sum.inr p)
  };
\import Relative.Identity[model := Subset.model] \as Identity;
\import Relative.Square[A := Subset.model, B := Whole.model, C := Subset.model, D := Subset.model,
  f := Augmented.inclusion, g := Retraction.map, h := Identity.map, k := Identity.map, commutes := equation] \as Square;
\module At(degree: N.Nat^) {
  \import Relative.Negative[original := Subset.model, degree := degree] \as Native;
  \import Relative.NegativeMap[source := Subset.model, target := Whole.model, f := Augmented.inclusion, degree := degree] \as Restrict;
  \import Relative.NegativeMap[source := Subset.model, target := Subset.model, f := Identity.map, degree := degree] \as Id;
  \definition equation: \forall (s: Native.Carrier) -> Restrict.map (Retraction.Negative[degree := degree].map s) = s :=
    \fun (s: Native.Carrier) => trans!{{Native.Carrier}} _ _ _ (Square.Negative[degree := degree].equation s)
      (trans!{{Native.Carrier}} _ _ _ (Identity.Negative[degree := degree].equation (Id.map s)) (Identity.Negative[degree := degree].equation s));
}
