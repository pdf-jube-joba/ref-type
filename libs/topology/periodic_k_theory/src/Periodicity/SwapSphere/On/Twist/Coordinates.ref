\import algebraic_topology.Interval[] \as Time;
\import std.Data[].Pair[] \as Pairs;
\import \root.Periodicity[].Coordinates[model := model] \as Source;
\import \root.Periodicity[].DoubleComparison[model := model].Coordinates[] \as Formula;
\import \root.Periodicity[].SwapSphere[].Square[] \as Square;
\definition equation: \forall (t, s: Time.Carrier)(x: model.Carrier) -> map (Source.double t s x) = Source.double s t x :=
  \fun (t, s: Time.Carrier)(x: model.Carrier) => eq_reason_in!{{double.Carrier} _
    "=" _ "by" { congr!{{result.Carrier} {double.Carrier}}
      (\fun (q: result.Carrier) => Comparison.equivalence.backward (\root.Periodicity[].SwapSphere[].On[model := model].map q)) _ _ (Formula.equation t s x) }
    "=" _ "by" { congr!{{result.Carrier} {double.Carrier}} Comparison.equivalence.backward _ _
      (Mapping.onProjection (Pairs.pair model.Carrier sphere.Carrier x (Formula.spherePoint t s))) }
    "=" _ "by" { congr!{{sphere.Carrier} {double.Carrier}}
      (\fun (p: sphere.Carrier) => Comparison.equivalence.backward (Smash.projection (Pairs.pair model.Carrier sphere.Carrier x p))) _ _ (Square.timeEquation t s) }
    "=" _ "by" { congr!{{result.Carrier} {double.Carrier}} Comparison.equivalence.backward _ _ (sym!{{result.Carrier}} _ _ (Formula.equation s t x)) }
    "=" _ "by" { Comparison.equivalence.leftInverse (Source.double s t x) }
  };
