\import \root.Periodicity[].Reduced[model := model] \as BottMap;
\definition timesBeta: BottMap.SourceCarrier -> BottMap.TargetCarrier := BottMap.forward;
\definition coefficient: BottMap.TargetCarrier -> BottMap.SourceCarrier := BottMap.Inverse[].backward;
\definition recover: \forall (a: BottMap.SourceCarrier) -> coefficient (timesBeta a) = a := BottMap.Inverse[].leftInverse;
\import \root.Periodicity[].Negative[model := model, degree := Bott.one] \as Negative;
\definition negativeOneToThree: Negative.Source -> Negative.Target := Negative.forward;
\definition negativeRoundTrip: \forall (a: Negative.Source) -> Negative.backward (negativeOneToThree a) = a := Negative.leftInverse;
