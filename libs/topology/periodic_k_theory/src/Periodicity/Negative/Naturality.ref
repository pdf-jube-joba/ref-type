\import \root.Periodicity[].Negative[model := other, degree := degree] \as Other;
\import Relative.NegativeMap[source := model, target := other, f := mapping, degree := degree] \as CurrentPull;
\import Relative.NegativeMap[source := model, target := other, f := mapping, degree := next] \as NextPull;
\import Shift.Naturality[other := Relative.iterate degree other, mapping := Relative.iterateMap degree model other mapping] \as Native;
\definition forwardEquation: \forall (a: Other.Source) -> NextPull.map (Other.forward a) = forward (CurrentPull.map a) := Native.forwardEquation;
\definition backwardEquation: \forall (q: Other.Target) -> backward (NextPull.map q) = CurrentPull.map (Other.backward q) := Native.backwardEquation;
