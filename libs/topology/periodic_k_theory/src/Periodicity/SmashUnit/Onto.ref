\definition zero: \forall (x: model.Carrier) -> Smash.projection (Pair.pair Sphere.zero.Carrier model.Carrier (Relative.details Sphere.zero).point x) = (Relative.details source).point := Smash.leftCollapsed;
\definition represented: \forall (i: Sphere.zero.Carrier)(x: model.Carrier) -> \exists (y: model.Carrier \where f y = Smash.projection (Pair.pair Sphere.zero.Carrier model.Carrier i x)) :=
  Fin.cases Bott.one (\fun (i: Sphere.zero.Carrier) => \forall (x: model.Carrier) -> \exists (y: model.Carrier \where f y = Smash.projection (Pair.pair Sphere.zero.Carrier model.Carrier i x)))
    (\fun (x: model.Carrier) => Logic.existsIntro[model.Carrier, { y: model.Carrier \where f y = Smash.projection (Pair.pair Sphere.zero.Carrier model.Carrier (Relative.details Sphere.zero).point x) }]
      (Relative.details model).point (trans!{{source.Carrier}} _ _ _ atPoint (sym!{{source.Carrier}} _ _ (zero x))))
    (\fun (i: Fin.Fin Bott.one) => \idelim Sphere.live = Fin.succ Bott.one i \with j: Sphere.zero.Carrier =>
      \forall (x: model.Carrier) -> \exists (y: model.Carrier \where f y = Smash.projection (Pair.pair Sphere.zero.Carrier model.Carrier j x)) \by {
        base: \fun (x: model.Carrier) => Logic.existsIntro[model.Carrier, { y: model.Carrier \where f y = f x }] x (\refl(f x)),
        equality: congr!{{Fin.Fin Bott.one} {Sphere.zero.Carrier}} (Fin.succ Bott.one) _ _ (sym!{{Fin.Fin Bott.one}} _ _ (Fin.singletonValue i))
      });
\definition onto: \forall (q: source.Carrier) -> \exists (x: model.Carrier \where f x = q) := \block {
  \fun (q: source.Carrier) \then
  \takefrom z: \Cast[Smash.model.Carrier] ({ z: Smash.model.Carrier \where Smash.projection z = q }) \by Smash.projectionOnto q \then
  \takefrom x: \Cast[model.Carrier] ({ x: model.Carrier \where f x = Smash.projection (Pair.pair Sphere.zero.Carrier model.Carrier (Smash.first z) (Smash.second z)) }) \by represented (Smash.first z) (Smash.second z) \then
  \return Logic.existsIntro[model.Carrier, { x: model.Carrier \where f x = q }] x (trans!{{source.Carrier}} _ _ _
    (\bysub(model.Carrier, { x: model.Carrier \where f x = Smash.projection (Pair.pair Sphere.zero.Carrier model.Carrier (Smash.first z) (Smash.second z)) }, x))
    (trans!{{source.Carrier}} _ _ _ (congr!{{Smash.model.Carrier} {source.Carrier}} Smash.projection _ _ (Pair.Prop[A := Sphere.zero.Carrier, B := model.Carrier].eta z))
      (\bysub(Smash.model.Carrier, { z: Smash.model.Carrier \where Smash.projection z = q }, z))))
};
