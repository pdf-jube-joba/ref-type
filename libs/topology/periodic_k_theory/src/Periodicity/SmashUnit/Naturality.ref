\import \root.Periodicity[].SmashUnit[model := other] \as Other;
\import Relative.Identity[model := Sphere.zero] \as ZeroIdentity;
\import Smash.Mapping[targetLeft := Sphere.zero, targetRight := other, f := ZeroIdentity.map, g := mapping] \as Induced;
\definition map: Relative.Map source Other.source := Induced.map;
\definition inclusionEquation: \forall (x: model.Carrier) -> map (inclusion x) = Other.inclusion (mapping x) :=
  \fun (x: model.Carrier) => Induced.onProjection (live x);
\definition forwardEquation: \forall (q: source.Carrier) -> Other.equivalence.forward (map q) = mapping (equivalence.forward q) :=
  \fun (q: source.Carrier) => trans!{{other.Carrier}} _ _ _
    (congr!{{source.Carrier} {other.Carrier}} (\fun (r: source.Carrier) => Other.equivalence.forward (map r)) _ _ (sym!{{source.Carrier}} _ _ (equivalence.leftInverse q)))
    (trans!{{other.Carrier}} _ _ _
      (congr!{{Other.source.Carrier} {other.Carrier}} Other.equivalence.forward _ _ (inclusionEquation (equivalence.forward q)))
      (Other.equivalence.rightInverse (mapping (equivalence.forward q))));
