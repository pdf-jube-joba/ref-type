\import \root.Periodicity[].TwoShift[model := Relative.iterate degree model] \as Shift;
\definition next: N.Nat^ := N.Nat^::succ (N.Nat^::succ degree);
\definition Source: \Set := Relative.Negative[original := model, degree := degree].Carrier;
\definition Target: \Set := Relative.Negative[original := model, degree := next].Carrier;
\definition sourceGroup: std.Alg[].Alg[].CommutativeGroup[Source] := Relative.Negative[original := model, degree := degree].group;
\definition targetGroup: std.Alg[].Alg[].CommutativeGroup[Target] := Relative.Negative[original := model, degree := next].group;
\definition forward: Source -> Target := Shift.forward;
\definition backward: Target -> Source := Shift.backward;
\definition leftInverse: \forall (a: Source) -> backward (forward a) = a := Shift.leftInverse;
\definition rightInverse: \forall (q: Target) -> forward (backward q) = q := Shift.rightInverse;
\definition forwardAdd: \forall (a, b: Source) -> forward (sourceGroup.base.op a b) = targetGroup.base.op (forward a) (forward b) := Shift.forwardAdd;
\definition backwardAdd: \forall (q, r: Target) -> backward (targetGroup.base.op q r) = sourceGroup.base.op (backward q) (backward r) := Shift.backwardAdd;
\definition forwardZero: forward sourceGroup.base.unit = targetGroup.base.unit := Shift.forwardZero;
\definition backwardZero: backward targetGroup.base.unit = sourceGroup.base.unit := Shift.backwardZero;
\module Naturality(other: Relative.CompactPointed, mapping: Relative.Map model other);
