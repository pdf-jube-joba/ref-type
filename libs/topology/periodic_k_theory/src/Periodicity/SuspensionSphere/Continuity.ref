\definition innerContinuous: topology.Continuity[A := Times.CarrierSet, B := Inner.Carrier].Continuous timeTopology (Inner.topology (Relative.details zero).topology) inner :=
  topological_constructions.Product[A := Time.Carrier, B := zero.Carrier].Universal[X := Times.CarrierSet].pairContinuous timeTopology Time.topology (Relative.details zero).topology innerTime (\fun (_: Times.CarrierSet) => live)
    (TimesMaps.secondContinuous Time.topology Time.topology)
    (topology.Maps[A := Times.CarrierSet, B := zero.Carrier].constantContinuous timeTopology (Relative.details zero).topology live);
\definition outerContinuous: topology.Continuity[A := Times.CarrierSet, B := Outer.Carrier].Continuous timeTopology (Outer.topology (Relative.details firstModel).topology) outer :=
  topological_constructions.Product[A := Time.Carrier, B := firstModel.Carrier].Universal[X := Times.CarrierSet].pairContinuous timeTopology Time.topology (Relative.details firstModel).topology outerTime (\fun (z: Times.CarrierSet) => First.class (inner z))
    (TimesMaps.firstContinuous Time.topology Time.topology)
    (topology.Composition[A := Times.CarrierSet, B := Inner.Carrier, C := firstModel.Carrier].composeContinuous timeTopology (Inner.topology (Relative.details zero).topology) (Relative.details firstModel).topology
      inner First.class innerContinuous First.classContinuous);
\definition continuous: topology.Continuity[A := Times.CarrierSet, B := source.Carrier].Continuous timeTopology (Relative.details source).topology f :=
  topology.Composition[A := Times.CarrierSet, B := Outer.Carrier, C := source.Carrier].composeContinuous timeTopology (Outer.topology (Relative.details firstModel).topology) (Relative.details source).topology
    outer Second.class outerContinuous Second.classContinuous;
