\import Relative.Smash[left := left, right := right] \as Smash;
\import Smash.Graded[firstDegree := Bott.one, secondDegree := Bott.one] \as Native;
\import \root.Periodicity[].TwoShift[model := Smash.result] \as Period;
\import \root.Periodicity[].SwapSphere[].On[model := Smash.result].Twist[] \as Twist;
\import Relative.Pullback[source := Twist.double, target := Twist.double, f := Twist.map] \as Pull;
\definition First: \Set := Relative.Negative[original := left, degree := Bott.one].Carrier;
\definition Second: \Set := Relative.Negative[original := right, degree := Bott.one].Carrier;
\definition Result: \Set := Relative.Reduced[model := Smash.result].Carrier;
\definition group: std.Alg[].Alg[].CommutativeGroup[Result] := Relative.Reduced[model := Smash.result].group;
\definition product[a: First][b: Second]: Result := Period.backward (Native.product a b);
\definition interchanged[a: First][b: Second]: Result := Period.backward (Pull.map (Native.product a b));
\import Relative.GroupCalculus[X := Twist.Carrier, group := Twist.group].Mapping[Y := Result, target := group, f := Period.backward,
  additive := Period.backwardAdd, preservesZero := Period.backwardZero] \as Linear;
\definition sign: \forall (a: First)(b: Second) -> interchanged a b = group.base.inv (product a b) :=
  \fun (a: First)(b: Second) => trans!{Result} _ _ _
    (congr!{{Twist.Carrier} Result} Period.backward _ _ (Twist.sign (Native.product a b))) (Linear.inverse (Native.product a b));
\module Symmetry;
