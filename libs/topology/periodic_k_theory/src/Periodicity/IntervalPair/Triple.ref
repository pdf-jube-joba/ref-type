\definition E[x: Time.Carrier]: \Set := Absolute.Fiber t.positive x;
\definition F[x: Time.Carrier]: \Set := Absolute.Fiber t.negative x;
\definition positive: Bundles.Family[X := Time.Carrier, F := E].Bundle := Absolute.bundle t.positive;
\definition negative: Bundles.Family[X := Time.Carrier, F := F].Bundle := Absolute.bundle t.negative;
\import Time.Contraction[] \as Contraction;
\import Homotopy.For[Y := Time.Carrier, F := E, bundle := positive].Contractible[compact := Time.compact, hausdorff := Time.hausdorff,
  point := Time.end, contraction := Contraction.homotopy] \as Positive;
\import Homotopy.For[Y := Time.Carrier, F := F, bundle := negative].Contractible[compact := Time.compact, hausdorff := Time.hausdorff,
  point := Time.end, contraction := Contraction.homotopy] \as Negative;
\module With(first: Positive.Result, second: Negative.Result);
\definition zero: Group.value t = Group.zero := \block {
  \takefrom first: Positive.Result \by Positive.exists \then
  \takefrom second: Negative.Result \by Negative.exists \then
  \takefrom path: With[first := first, second := second].Path
    \by With[first := first, second := second].pathExists \then
  \return Group.globalZero t (With[first := first, second := second].Along[path := path].witness)
};
