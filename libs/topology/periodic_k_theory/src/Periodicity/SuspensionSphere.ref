\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Pair[] \as Pair;
\import std.Data[].Nat[].Basic[].Prop[] \as Nat;
\import algebraic_topology.Interval[] \as Time;
\import KTheory.FiniteDiscrete[n := Bott.two] \as Finite;
\definition zero: Relative.CompactPointed := Relative.pack (Fin.Fin Bott.two) (Relative.PointedDetails[Fin.Fin Bott.two] {
  topology := topology.Topology[Carrier := Fin.Fin Bott.two].Discrete, compact := Finite.compact, hausdorff := Finite.hausdorff, point := Fin.zero Bott.one
});
\definition live: zero.Carrier := Fin.succ Bott.one (Fin.zero N.Nat^::zero);
\definition liveDifferent: Logic.Not (live = (Relative.details zero).point) := \fun (same: _) => Nat.succNeZero N.Nat^::zero same;
\import Relative.Suspension[original := zero] \as First;
\definition firstModel: Relative.CompactPointed := Relative.Suspension[original := zero].result;
\import Relative.Suspension[original := firstModel] \as Second;
\definition source: Relative.CompactPointed := Relative.Suspension[original := firstModel].result;
\import algebraic_topology.Cylinder[A := zero.Carrier] \as Inner;
\import algebraic_topology.Cylinder[A := firstModel.Carrier] \as Outer;
\import topological_constructions.Product[A := Time.Carrier, B := Time.Carrier] \as Times;
\import Times.Maps[] \as TimesMaps;
\definition timeTopology: topology.Topology[Carrier := Times.CarrierSet].Topology := Times.topology Time.topology Time.topology;
\definition outerTime: Times.CarrierSet -> Time.Carrier := Pair.first Time.Carrier Time.Carrier;
\definition innerTime: Times.CarrierSet -> Time.Carrier := Pair.second Time.Carrier Time.Carrier;
\definition inner[z: Times.CarrierSet]: Inner.Carrier := Inner.at (innerTime z) live;
\definition outer[z: Times.CarrierSet]: Outer.Carrier := Outer.at (outerTime z) (First.class (inner z));
\definition f[z: Times.CarrierSet]: source.Carrier := Second.class (outer z);
\definition Edge[z: Times.CarrierSet]: \Prop := Logic.Or[outerTime z = Time.start, Logic.Or[outerTime z = Time.end, Logic.Or[innerTime z = Time.start, innerTime z = Time.end]]];
\module Collapsed;
\module Separation;
\module Continuity;
\module Boundary;
\module Common;
