\import algebraic_topology.Interval[] \as Time;
\import topology.Topology[Carrier := Time.Carrier] \as Base;
\definition boundary: \Pow Time.Carrier := { t: Time.Carrier \where Logic.Or[t = Time.start, t = Time.end] };
\definition closed: Base.IsClosedIn Time.topology boundary := Base.Finite[].joinClosed Time.topology
  (Base.Singleton Time.start) (Base.Singleton Time.end)
  (Base.Compactness[].hausdorffT1 Time.topology Time.hausdorff Time.start)
  (Base.Compactness[].hausdorffT1 Time.topology Time.hausdorff Time.end);
\import Relative.Pair[X := Time.Carrier, space := Time.topology, compact := Time.compact, hausdorff := Time.hausdorff,
  subset := boundary, closed := closed] \as Pair;
\import KTheory.On[X := Time.Carrier, baseSpace := Time.topology, compact := Time.compact, hausdorff := Time.hausdorff] \as Absolute;
\import Pair.Group[] \as Group;
\definition start: Pair.A := \into[Time.Carrier](Time.start, boundary) \by { Logic.Or[_, _]::left (\refl(Time.start)) };
\definition end: Pair.A := \into[Time.Carrier](Time.end, boundary) \by { Logic.Or[_, _]::right (\refl(Time.end)) };
\import complex.Complex[] \as C;
\import C.Algebra[] \as Scalars;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing C.Complex Scalars.field] \as Spaces;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Scalars.field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Scalars.field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar] \as Operations;
\import bundle_homotopy.Homotopy[].Over[K := C.Complex, field := Scalars.field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar] \as Homotopy;
\module Triple(t: Pair.Triple);
\definition zero: \forall (x: Group.Carrier) -> x = Group.zero := \block {
  \fun (x: Group.Carrier) \then
  \takefrom t: \Cast[Pair.Triple] ({ t: Pair.Triple \where Group.value t = x }) \by Group.NormalForm[].existence x \then
  \return trans!{{Group.Carrier}} _ _ _ (sym!{{Group.Carrier}} _ _ (\bysub(Pair.Triple, { t: Pair.Triple \where Group.value t = x }, t))) (Triple[t := t].zero)
};
\module Circle;
