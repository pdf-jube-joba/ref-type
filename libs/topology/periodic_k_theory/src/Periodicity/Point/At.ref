\import \root.Periodicity[].Parity[] \as P;
\import \root.Periodicity[].Coefficients[] \as Coefficients;
\definition parity: std.Data[].Bool[].Bool^ := P.value degree;
\definition Carrier: \Set := \root.Periodicity[].Integer[].At[model := model, degree := degree].Carrier;
\definition group: std.Alg[].Alg[].CommutativeGroup[Carrier] := \root.Periodicity[].Integer[].At[model := model, degree := degree].group;
\definition Coefficient: \Set := Coefficients.Carrier parity;
\definition coefficientGroup: std.Alg[].Alg[].CommutativeGroup[Coefficient] := Coefficients.group parity;
\import Relative.Equivalence[source := model, target := SphereModel.zero].With[e := equivalence].Negative[degree := P.index parity] \as Transport;
\definition transported: \root.Periodicity[].Isomorphism[A := Carrier, B := Coefficients.Source parity, source := group, target := Coefficients.sourceGroup parity].Data :=
  \root.Periodicity[].Isomorphism[A := Carrier, B := Coefficients.Source parity, source := group, target := Coefficients.sourceGroup parity].Data {
    forward := Transport.backward, backward := Transport.forward, leftInverse := Transport.leftInverse, rightInverse := Transport.rightInverse,
    forwardAdd := Transport.inverseAdditive, backwardAdd := Transport.additive, forwardZero := Transport.backwardZero, backwardZero := Transport.forwardZero
  };
\definition isomorphism: \root.Periodicity[].Isomorphism[A := Carrier, B := Coefficient, source := group, target := coefficientGroup].Data :=
  \root.Periodicity[].Isomorphism[A := Carrier, B := Coefficients.Source parity, source := group, target := Coefficients.sourceGroup parity].Compose[
    C := Coefficient, last := coefficientGroup, first := transported, second := Coefficients.isomorphism parity].data;
