\import topology.Topology[Carrier := A] \as Source;
\import topology.Topology[Carrier := B] \as Target;
\import topology.Maps[A := A, B := B] \as Maps;
\definition IsProper[f: A -> B]: \Prop :=
  \forall (K: \Pow B) -> Target.IsCompactIn target K -> Source.IsCompactIn source (Maps.Preimage f K);
\module With(f: A -> B, continuous: topology.Continuity[A := A, B := B].Continuous source target f, proper: IsProper f);
