\import Pair.Group[] \as Triples;
\import Pair.Comparison[] \as Comparison;
\import Relative.Equivalence[source := Quotient.model, target := model].With[e := equivalence].Groups[] \as Groups;
\import Relative.Reduced[model := model] \as Reduced;
\definition map[q: Triples.Carrier]: Reduced.Carrier := Groups.backward (Comparison.isomorphism.forward q);
\definition inverse[q: Reduced.Carrier]: Triples.Carrier := Comparison.isomorphism.backward (Groups.forward q);
\definition leftInverse: \forall (q: Triples.Carrier) -> inverse (map q) = q := \fun (q: Triples.Carrier) => trans!{{Triples.Carrier}} _ _ _
  (congr!{{Quotient.Relative} {Triples.Carrier}} Comparison.isomorphism.backward _ _ (Groups.leftInverse (Comparison.isomorphism.forward q))) (Comparison.isomorphism.leftInverse q);
\definition rightInverse: \forall (q: Reduced.Carrier) -> map (inverse q) = q := \fun (q: Reduced.Carrier) => trans!{{Reduced.Carrier}} _ _ _
  (congr!{{Quotient.Relative} {Reduced.Carrier}} Groups.backward _ _ (Comparison.isomorphism.rightInverse (Groups.forward q))) (Groups.rightInverse q);
