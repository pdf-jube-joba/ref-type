\import periodic_k_theory.Periodicity[].Parity[] \as Parity;
\import Relative.Equivalence[source := Quotient.model, target := model].With[e := equivalence].Negative[degree := Parity.index (Parity.value degree)] \as Transport;
\import periodic_k_theory.Periodicity[].Integer[].At[model := model, degree := degree] \as Supported;
\import periodic_k_theory.Periodicity[].Integer[].At[model := Quotient.model, degree := degree] \as Ordinary;
\definition fromCompactSupport: Supported.Carrier -> Ordinary.Carrier := Transport.forward;
\definition toCompactSupport: Ordinary.Carrier -> Supported.Carrier := Transport.backward;
\definition leftInverse: \forall (x: Supported.Carrier) -> toCompactSupport (fromCompactSupport x) = x := Transport.rightInverse;
\definition rightInverse: \forall (x: Ordinary.Carrier) -> fromCompactSupport (toCompactSupport x) = x := Transport.leftInverse;
\definition additive: \forall (x, y: Ordinary.Carrier) -> toCompactSupport (Ordinary.group.base.op x y) = Supported.group.base.op (toCompactSupport x) (toCompactSupport y) := Transport.inverseAdditive;
