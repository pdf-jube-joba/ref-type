\import Pair.Diagonal[p := p] \as Diagonal;
\import Pair.SumConstruction[t := t, u := Diagonal.triple] \as Sum;
\definition Result: \Set := Sum.Result;
\definition existence: \exists Result := Sum.existence;
\module With(r: Result) {
  \definition triple: Triple := r.value;
  \definition equation: value triple = value t := trans!{Carrier} _ _ _
    (sym!{Carrier} _ _ (Native.sum t Diagonal.triple r.value r.witness))
    (trans!{Carrier} _ _ _ (congr!{Carrier Carrier} (group.base.op (value t)) _ _ (Native.Diagonal[p := p].equation))
      (algebra.Groups[].On[G := Carrier, group := std.Alg[].Alg[].asGroup Carrier group].oneRight (value t)));
}
