\definition globalZero: \forall (t: Triple) -> Pair.Global[t := t].Witness -> value t = group.base.unit := Native.globalZero;
\definition directSum: \forall (t, u, v: Triple) -> Pair.Sum[t := t, u := u, v := v].Witness -> group.base.op (value t) (value u) = value v := Native.sum;
\module Homotopy(p, q: Pair.Presentation, first, second: Pair.Between[p := p, q := q].Isomorphism) {
  \definition equation: Pair.Homotopy[p := p, q := q, first := first, second := second].Family ->
    value Pair.Homotopy[p := p, q := q, first := first, second := second].left = value Pair.Homotopy[p := p, q := q, first := first, second := second].right :=
    Native.Homotopy[p := p, q := q, first := first, second := second].equation;
}
\module Isomorphic(t, u: Triple) {
  \module With(w: Native.Isomorphic[t := t, u := u].Witness) {
    \definition equation: value t = value u := Native.Isomorphic[t := t, u := u].With[w := w].equation;
  }
}
