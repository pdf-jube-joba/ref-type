\structure TwoTerm: \Set := {
  triple: Triple,
  complex: \parent.Supported[t := triple].Complex[].Witness
};
\definition class[c: TwoTerm]: Reduced.Carrier := forward (value c.triple);
\definition representation: \forall (a: Reduced.Carrier) -> \exists (c: TwoTerm \where class c = a) := \block {
  \fun (a: Reduced.Carrier) \then
  \takefrom t: \Cast[Triple] ({ t: Triple \where forward (value t) = a }) \by represents a \then
  \takefrom w: \parent.Supported[t := t].Complex[].Witness \by \parent.Supported[t := t].Complex[].existence \then
  \return Logic.existsIntro[TwoTerm, { c: TwoTerm \where class c = a }] (TwoTerm { triple := t, complex := w })
    (\bysub(Triple, { t: Triple \where forward (value t) = a }, t))
};
