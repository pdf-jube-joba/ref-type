\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring].Presentation[Generators := Triple] \as Expressions;
\import Expressions.Of[relations := Native.Relation] \as Relations;
\import std.Set[].Quotient[A := Expressions.Expression, Equivalent := Relations.Equivalent] \as Quotient;
\import algebra.Quotient[A := Expressions.Expression, relation := Relations.Equivalent] \as AlgebraQuotient;
\definition Equivalent: Expressions.Expression -> Expressions.Expression -> \Prop := Relations.Equivalent;
\definition class: Expressions.Expression -> Carrier := Relations.class;
\definition criterion: \forall (a, b: Expressions.Expression) -> Logic.PropEquiv[forward (class a) = forward (class b), Equivalent a b] :=
  \fun (a, b: Expressions.Expression) => Logic.PropEquiv[forward (class a) = forward (class b), Equivalent a b] {
    ltr := \fun (same: _) => Quotient.equivalentOfClassEq Relations.equivalence a b (detectsEquality (class a) (class b) same),
    rtl := \fun (related: _) => congr!{Carrier {Reduced.Carrier}} forward _ _ (AlgebraQuotient.classRelated Relations.equivalence a b related)
  };
