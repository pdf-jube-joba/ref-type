\structure Witness: \Set := {
  triple: Triple,
  extension: \parent.Supported[t := triple].Extensions,
  equation: \parent.Supported[t := triple].With[e := extension].Raw[].value = a
};
\definition existence: \exists Witness := \block {
  \takefrom t: \Cast[Triple] ({ t: Triple \where forward (value t) = a }) \by represents a \then
  \takefrom e: \parent.Supported[t := t].Extensions \by \parent.Supported[t := t].extensionExists \then
  \return \exact(Witness {
    triple := t, extension := e,
    equation := trans!{{Reduced.Carrier}} _ _ _ (\parent.Supported[t := t].With[e := e].Raw[].equation)
      (\bysub(Triple, { t: Triple \where forward (value t) = a }, t))
  }, Witness)
};
