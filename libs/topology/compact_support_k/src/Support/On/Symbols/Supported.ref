\import topological_k_theory.KTheory[].On[X := Compactification.Carrier, baseSpace := Compactification.topology,
  compact := Compactness.compact, hausdorff := Separation.hausdorffCompactification] \as Bundles;
\import bundle_extension.Extension[].ComplexIsomorphisms[X := Compactification.Carrier, subset := Point.subset,
  F := Bundles.Fiber t.positive, G := Bundles.Fiber t.negative, source := Bundles.bundle t.positive, target := Bundles.bundle t.negative,
  same := (\refl(Compactification.topology))] \as Extension;
\definition extensionExists: \exists Extension.Result[t.comparison] := Extension.extend t.comparison Compactness.compact Separation.hausdorffCompactification Point.closed;
\module With(e: Extension.Result[t.comparison]);
\module Complex;
\definition Extensions: \Set := Extension.Result[t.comparison];
