\import VectorBundles.Family[X := Compactification.Carrier, F := (Bundles.Fiber t.positive)].Of[bundle := (Bundles.bundle t.positive)].PullbackComposition[
  Y := X, Z := Local.Carrier, first := space, second := Local.topology, f := Compactification.inclusion, g := Local.inclusion].Of[fRegular := Compactification.inclusionContinuous, gRegular := Local.regular] \as Positive;
\import VectorBundles.Family[X := Compactification.Carrier, F := (Bundles.Fiber t.negative)].Of[bundle := (Bundles.bundle t.negative)].PullbackComposition[
  Y := X, Z := Local.Carrier, first := space, second := Local.topology, f := Compactification.inclusion, g := Local.inclusion].Of[fRegular := Compactification.inclusionContinuous, gRegular := Local.regular] \as Negative;
\import VectorBundles.Isomorphisms[X := Local.Carrier, F := LocalClass.FirstFiber, G := LocalClass.FirstFiber, source := Positive.direct, target := Positive.nested] \as PositiveInverse;
\import VectorBundles.Isomorphisms[X := Local.Carrier, F := LocalClass.SecondFiber, G := LocalClass.SecondFiber, source := Negative.direct, target := Negative.nested] \as NegativeInverse;
\definition positive: VectorBundles.Isomorphisms[X := Local.Carrier, F := LocalClass.FirstFiber, G := Pull.FirstFiber, source := LocalPair.BundleModel[F := LocalClass.FirstFiber].bundle LocalClass.firstOnLocal, target := Pull.firstBundle].Isomorphism := PositiveInverse.inverse Positive.isomorphism;
\definition negative: VectorBundles.Isomorphisms[X := Local.Carrier, F := LocalClass.SecondFiber, G := Pull.SecondFiber, source := LocalPair.BundleModel[F := LocalClass.SecondFiber].bundle LocalClass.secondOnLocal, target := Pull.secondBundle].Isomorphism := NegativeInverse.inverse Negative.isomorphism;
\definition commutes: \forall (x: LocalPair.A)(v: LocalClass.FirstFiber x) ->
  (PulledClass.comparison.forward.fiber x).apply ((positive.forward.fiber x).apply v) = (negative.forward.fiber x).apply ((LocalClass.comparison.forward.fiber x).apply v) :=
  \fun (x: LocalPair.A)(v: LocalClass.FirstFiber x) => \refl((PulledClass.comparison.forward.fiber x).apply v);
\import LocalPair.BundleTriples[F := LocalClass.FirstFiber, G := LocalClass.SecondFiber, firstModel := LocalClass.firstOnLocal, secondModel := LocalClass.secondOnLocal].To[
  H := Pull.FirstFiber, I := Pull.SecondFiber, newFirstModel := Pull.firstModelOnSource, newSecondModel := Pull.secondModelOnSource].With[
    alpha := LocalClass.comparison, beta := PulledClass.comparison, positive := positive, negative := negative, commutes := commutes] \as Change;
\definition equation: LocalClass.localValue = Inclusion.relative GlobalClass.reduced := trans!{{LocalPair.Quotient[].Relative}} _ _ _ Change.reducedEquation PulledClass.reducedNaturality;
