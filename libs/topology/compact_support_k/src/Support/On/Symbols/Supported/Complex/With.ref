\import bundle_extension.Extension[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := Hermitian.scalar, scalar := Scalar.scalar].Isomorphisms[
  X := Compactification.Carrier, subset := Point.subset, F := Bundles.Fiber t.positive, G := Bundles.Fiber t.negative,
  source := Bundles.bundle t.positive, target := Bundles.bundle t.negative, same := (\refl(Compactification.topology))].Through[
  a := t.comparison, h := w.forward, g := w.backward, first := w.positive, second := w.negative] \as Invertible;
\definition domain: \Pow Compactification.Carrier := Invertible.domain;
\definition support: \Pow X := Compactification.remainder domain;
\definition compactSupport: topology.Topology[Carrier := X].IsCompactIn space support :=
  Invertible.open.atInfinity (Invertible.contains Compactification.point (\refl(Compactification.point)));
\import vector_bundles.Bundles[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := Hermitian.scalar, scalar := Scalar.scalar] \as VectorBundles;
\definition differential: VectorBundles.Morphisms[X := Compactification.Carrier, Y := Compactification.Carrier,
  F := Bundles.Fiber t.positive, G := Bundles.Fiber t.negative, source := Bundles.bundle t.positive, target := Bundles.bundle t.negative,
  f := (\fun (x: Compactification.Carrier) => x)].Map := w.forward.map;
\definition inverseAtInfinity: Extension.Result[t.comparison] := Invertible.extension;
\definition forwardEquation: \forall (x: \Cast[Compactification.Carrier] domain)(v: Bundles.Fiber t.positive x) ->
  (inverseAtInfinity.isomorphism.forward.fiber x).apply v = (differential.fiber x).apply v :=
  \fun (x: _)(v: _) => \refl((differential.fiber x).apply v);
