\definition support: \Pow X := Compactification.remainder e.domain;
\definition compactSupport: topology.Topology[Carrier := X].IsCompactIn space support := e.open.atInfinity (e.contains Compactification.point (\refl(Compactification.point)));
\definition outside[x: X]: \Prop := Logic.Not (topology.Topology[Carrier := X].Member support x);
\definition inDomain: \forall (x: X) -> outside x -> \In[Compactification.Carrier] e.domain (Compactification.inclusion x) :=
  \fun (x: X)(h: outside x) => topology.Topology[Carrier := X].Finite[].doubleNegElim (\In[Compactification.Carrier] e.domain (Compactification.inclusion x)) h;
\module Enlarge(K: \Pow X, compact: topology.Topology[Carrier := X].IsCompactIn space K,
  contains: topology.Topology[Carrier := X].Subset support K) {
  \definition outsideDomain: \forall (x: X) -> Logic.Not (\In[X] K x) -> \In[Compactification.Carrier] e.domain (Compactification.inclusion x) :=
    \fun (x: X)(h: _) => inDomain x (\fun (inside: _) => h (contains x inside));
}
\module Outside(K: \Pow X, compact: topology.Topology[Carrier := X].IsCompactIn space K,
  contains: topology.Topology[Carrier := X].Subset support K);
