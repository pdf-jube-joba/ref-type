\import \root.Support[].OnePoint[X := Y, space := target] \as Range;
\import \root.Support[].On[X := Y, space := target, hausdorff := targetHausdorff, locallyCompact := targetLocallyCompact] \as Other;
\import \root.Support[].Proper[A := X, B := Y, source := space, target := target].With[f := f, continuous := continuous, proper := proper] \as Extension;
\import algebraic_topology.Pointed[A := Compactification.Carrier].Maps[B := Range.Carrier] \as Pointed;
\definition mapping: Relative.Map model Other.model := \into[Compactification.Carrier -> Range.Carrier](Extension.extension, Relative.Map model Other.model) \by {
  Pointed.Laws[Relative.pointed model, Relative.pointed Other.model, Extension.extension] {
    continuous := Extension.extensionContinuous, pointed := Extension.atInfinity
  }
};
\module At(degree: std.Arithmetic[].Int[].Int^) {
  \import Periodic.Integer[].At[model := model, degree := degree].Pullback[other := Other.model, mapping := mapping] \as Native;
  \definition map: Other.At[degree := degree].Carrier -> Periodic.Integer[].At[model := model, degree := degree].Carrier := Native.map;
  \definition additive: \forall (a, b: Other.At[degree := degree].Carrier) ->
    map (Other.At[degree := degree].group.base.op a b) = Periodic.Integer[].At[model := model, degree := degree].group.base.op (map a) (map b) := Native.additive;
  \definition preservesZero: map Other.At[degree := degree].group.base.unit = Periodic.Integer[].At[model := model, degree := degree].group.base.unit := Native.preservesZero;
}
