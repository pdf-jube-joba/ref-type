\import \parent.Homotopy[p := p, q := q, K := K, compact := compact, first := first, second := second] \as Raw;
\import \parent.Evaluation[t := Raw.left] \as Left;
\import \parent.Evaluation[t := Raw.right] \as Right;
\import \parent.\parent.BundleTriples[F := Fiber p, G := Fiber q, firstModel := Left.positiveModel, secondModel := Left.negativeModel].Supported[K := Raw.left.support, compactK := Raw.left.compact].With[alpha := Raw.left.comparison] \as LeftClass;
\import \parent.\parent.BundleTriples[F := Fiber p, G := Fiber q, firstModel := Right.positiveModel, secondModel := Right.negativeModel].Supported[K := Raw.right.support, compactK := Raw.right.compact].With[alpha := Raw.right.comparison] \as RightClass;
\import \parent.\parent.Neighborhood[K := K, compact := compact] \as Neighbors;
\import \parent.Between[p := p, q := q, K := K] \as Outside;
\module In(w: Neighbors.Witness);
\definition equation: Left.value = Right.value := \block {
  \takefrom w: Neighbors.Witness \by Neighbors.existence \then
  \return In[w := w].equation
};
