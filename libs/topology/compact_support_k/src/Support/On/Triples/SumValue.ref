\import \parent.Evaluation[t := t] \as First;
\import \parent.Evaluation[t := u] \as Second;
\import \parent.Evaluation[t := v] \as Third;
\import \parent.\parent.BundleTriples[F := Fiber t.positive, G := Fiber t.negative, firstModel := First.positiveModel, secondModel := First.negativeModel]
  .Supported[K := t.support, compactK := t.compact].With[alpha := t.comparison] \as FirstClass;
\import \parent.\parent.BundleTriples[F := Fiber u.positive, G := Fiber u.negative, firstModel := Second.positiveModel, secondModel := Second.negativeModel]
  .Supported[K := u.support, compactK := u.compact].With[alpha := u.comparison] \as SecondClass;
\import \parent.\parent.BundleTriples[F := Fiber v.positive, G := Fiber v.negative, firstModel := Third.positiveModel, secondModel := Third.negativeModel]
  .Supported[K := v.support, compactK := v.compact].With[alpha := v.comparison] \as ThirdClass;
\definition support: \Pow X := Base.Finite[].Join (Base.Finite[].Join t.support u.support) v.support;
\definition compact: Base.IsCompactIn space support := Base.Compactness[].joinCompact space (Base.Finite[].Join t.support u.support) v.support
  (Base.Compactness[].joinCompact space t.support u.support t.compact u.compact) v.compact;
\import \parent.\parent.Neighborhood[K := support, compact := compact] \as Neighbors;
\module In(w: Neighbors.Witness);
\definition equation: Relative.Reduced[model := model].group.base.op First.value Second.value = Third.value := \block {
  \takefrom w: Neighbors.Witness \by Neighbors.existence \then
  \return In[w := w].equation
};
