\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Triples[].DirectSumInput[
  F := F, G := G, H := H, I := I, firstModel := firstModel, secondModel := secondModel, thirdModel := thirdModel, fourthModel := fourthModel, K := K, compact := compact]
  .With[alpha := alpha, beta := beta] \as Sum;
\import algebra.Group[].Of[Carrier := Group.Carrier, group := Group.group] \as Laws;
\definition equation: value = FirstSupport.With[alpha := alpha].value := trans!{{Group.Carrier}} _ _ _ (sym!{{Group.Carrier}} _ _ Sum.equation)
  (trans!{{Group.Carrier}} _ _ _
    (congr!{{Group.Carrier} {Group.Carrier}} (Group.add FirstSupport.With[alpha := alpha].value) _ _
      SecondSupport.With[alpha := beta].Global[isomorphism := global, agrees := agrees].equation)
    (Laws.zeroRight FirstSupport.With[alpha := alpha].value));
