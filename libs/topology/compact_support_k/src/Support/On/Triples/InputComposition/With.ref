\definition comparison: RightInput.OnOutside := Composition.compose alpha beta;
\import LeftInput.With[alpha := alpha] \as Left;
\import MiddleInput.With[alpha := beta] \as MiddleClass;
\import RightInput.With[alpha := comparison] \as Right;
\import Models.From[F := F, original := First.source] \as P;
\import Models.From[F := G, original := First.target] \as Q;
\import Models.From[F := H, original := Second.target] \as R;
\import \parent.\parent.Group[] \as Group;
\module Using(p, q, r: Bundle,
  positive: Bundles.Isomorphisms[X := X, F := F, G := Fiber p, source := First.source, target := bundle p].Isomorphism,
  middle: Bundles.Isomorphisms[X := X, F := G, G := Fiber q, source := First.target, target := bundle q].Isomorphism,
  negative: Bundles.Isomorphisms[X := X, F := H, G := Fiber r, source := Second.target, target := bundle r].Isomorphism);
\definition equation: Group.add Left.value MiddleClass.value = Right.value := \block {
  \takefrom p: P.Result \by P.existence (\refl(space)) \then
  \takefrom q: Q.Result \by Q.existence (\refl(space)) \then
  \takefrom r: R.Result \by R.existence (\refl(space)) \then
  \return Using[p := p.model, q := q.model, r := r.model, positive := p.isomorphism, middle := q.isomorphism, negative := r.isomorphism].equation
};
