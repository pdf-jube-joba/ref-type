\import Left.Using[p := p, q := q, positive := positive, negative := middle] \as T;
\import MiddleClass.Using[p := q, q := r, positive := middle, negative := negative] \as U;
\import Right.Using[p := p, q := r, positive := positive, negative := negative] \as V;
\import \parent.\parent.\parent.Compose[p := p, q := q, r := r, K := K, compact := compact, first := T.comparison, second := U.comparison] \as Composed;
\import Bundles.Isomorphisms[X := X, F := G, G := Fiber q, source := First.target, target := bundle q] \as MiddleMaps;
\definition formula: \forall (x: A)(v: Fiber p x) -> (Composed.triple.comparison.forward.fiber x).apply v = (V.comparison.forward.fiber x).apply v :=
  \fun (x: A)(v: Fiber p x) => congr!{{G x} {Fiber r x}}
    (\fun (w: G x) => (negative.forward.fiber x).apply ((beta.forward.fiber x).apply w)) _ _
    ((\bysub(MiddleMaps.Data, MiddleMaps.Isomorphism, middle)).leftInverse x ((alpha.forward.fiber x).apply ((positive.backward.fiber x).apply v)));
\import \parent.\parent.\parent.Between[p := p, q := r, K := K] \as Boundary;
\import Operations.IsomorphismEquality[X := A, F := (\fun (x: A) => Fiber p x), G := (\fun (x: A) => Fiber r x), source := Boundary.first, target := Boundary.second] \as Equality;
\definition sameComparison: Composed.triple.comparison = V.comparison := Equality.ext Composed.triple.comparison V.comparison formula;
\definition sameTriple: Composed.triple = Right.triple V.result :=
  congr!{{Boundary.Isomorphism} {Triple}}
    (\fun (a: Boundary.Isomorphism) => Triple { positive := p, negative := r, support := K, compact := compact, comparison := a }) _ _ sameComparison;
\import module_theory.Module[].Over[R := std.Arithmetic[].Int[].Int^, ring := std.Arithmetic[].IntAlgebra[].Ring[].ring].Presentation[Generators := Triple] \as Expressions;
\import Expressions.Of[relations := Group.Relation] \as Presented;
\definition compositionEquation: Group.add (Group.value (Left.triple T.result)) (Group.value (MiddleClass.triple U.result)) = Group.value Composed.triple :=
  trans!{{Group.Carrier}} _ _ _
    (Presented.addClass (Group.symbol Composed.left) (Group.symbol Composed.right))
    (Group.relationEquality (Expressions.Expression::sum (Group.symbol Composed.left) (Group.symbol Composed.right)) (Group.symbol Composed.triple)
      (Group.Relation::compose p q r K compact T.comparison U.comparison));
\definition equation: Group.add Left.value MiddleClass.value = Right.value := trans!{{Group.Carrier}} _ _ _
  (congr!{{Group.Carrier} {Group.Carrier} {Group.Carrier}} Group.add _ _ _ _ (Left.agreement T.result) (MiddleClass.agreement U.result))
  (trans!{{Group.Carrier}} _ _ _ compositionEquation
    (trans!{{Group.Carrier}} _ _ _ (congr!{{Triple} {Group.Carrier}} Group.value _ _ sameTriple) (sym!{{Group.Carrier}} _ _ (Right.agreement V.result))));
