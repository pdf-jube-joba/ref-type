\import Bundles.Isomorphisms[X := X, F := Fiber t.positive, G := Fiber t.negative, source := bundle t.positive, target := bundle t.negative] \as Maps;
\import \parent.Between[p := t.positive, q := t.negative, K := t.support] \as Boundary;
\structure Witness: \Set := {
  isomorphism: Maps.Isomorphism,
  agrees: \forall (x: Boundary.A)(v: Fiber t.positive x) ->
    (isomorphism.forward.fiber x).apply v = (t.comparison.forward.fiber x).apply v
};
