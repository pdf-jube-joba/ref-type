\import \parent.Evaluation[t := t] \as Evaluation;
\import \parent.\parent.BundleTriples[F := Fiber t.positive, G := Fiber t.negative, firstModel := Evaluation.positiveModel, secondModel := Evaluation.negativeModel]
  .Supported[K := t.support, compactK := t.compact].With[alpha := t.comparison] \as Original;
\module In(n: Original.Neighborhood);
\definition equation: Evaluation.value = Relative.Reduced[model := model].group.base.unit := \block {
  \takefrom n: Original.Neighborhood \by Original.neighborhoods \then
  \return trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ (Original.agreement n) In[n := n].equation
};
