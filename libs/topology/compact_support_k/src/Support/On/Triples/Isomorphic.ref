\import Bundles.Isomorphisms[X := X, F := Fiber t.positive, G := Fiber u.positive, source := bundle t.positive, target := bundle u.positive] \as Positive;
\import Bundles.Isomorphisms[X := X, F := Fiber t.negative, G := Fiber u.negative, source := bundle t.negative, target := bundle u.negative] \as Negative;
\definition support: \Pow X := Base.Finite[].Join t.support u.support;
\definition outside: \Pow X := Base.Complement support;
\definition first[x: \Cast[X] outside]: \Cast[X] (Base.Complement t.support) := \into[X](x, Base.Complement t.support) \by {
  \fun (inside: _) => (\bysub(X, outside, x)) (Logic.Or[_, _]::left inside)
};
\definition second[x: \Cast[X] outside]: \Cast[X] (Base.Complement u.support) := \into[X](x, Base.Complement u.support) \by {
  \fun (inside: _) => (\bysub(X, outside, x)) (Logic.Or[_, _]::right inside)
};
\structure Witness: \Set := {
  positive: Positive.Isomorphism,
  negative: Negative.Isomorphism,
  commutes: \forall (x: \Cast[X] outside)(v: Fiber t.positive x) ->
    (u.comparison.forward.fiber (second x)).apply ((positive.forward.fiber x).apply v) = (negative.forward.fiber x).apply ((t.comparison.forward.fiber (first x)).apply v)
};
