\definition outside: \Pow X := Base.Complement K;
\definition A: \Set := \Cast[X] outside;
\definition subspace: topology.Topology[Carrier := A].Topology := Base.Subspace[S := outside].topology space;
\import Bundles.Family[X := X, F := Fiber p].Of[bundle := bundle p].Restriction[U := outside] \as Positive;
\import Bundles.Family[X := X, F := Fiber q].Of[bundle := bundle q].Restriction[U := outside] \as Negative;
\definition first: Bundles.Family[X := A, F := (\fun (x: A) => Fiber p x)].Bundle := Positive.restricted;
\definition second: Bundles.Family[X := A, F := (\fun (x: A) => Fiber q x)].Bundle := Negative.restricted;
\definition Isomorphism: \Set := Bundles.Isomorphisms[X := A, F := (\fun (x: A) => Fiber p x), G := (\fun (x: A) => Fiber q x), source := first, target := second].Isomorphism;
