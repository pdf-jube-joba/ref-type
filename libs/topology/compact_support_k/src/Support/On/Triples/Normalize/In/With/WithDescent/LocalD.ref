\definition toPlus[x: Local.Carrier]: Compactification.Carrier := Compactification.inclusion x;
\definition toPlusRegular: topology.Continuity[A := Local.Carrier, B := Compactification.Carrier].Continuous Local.topology Compactification.topology toPlus :=
  topology.Composition[A := Local.Carrier, B := X, C := Compactification.Carrier].composeContinuous Local.topology space Compactification.topology Local.inclusion Compactification.inclusion Local.regular Compactification.inclusionContinuous;
\import Relative.TriplePullback[X := Quotient.Carrier, Y := Compactification.Carrier, Z := X, T := Local.Carrier,
  F := DFiber, bundle := D, first := Compactification.topology, second := space, third := Local.topology,
  f := Local.collapse, g := Compactification.inclusion, h := Local.inclusion,
  fRegular := collapseRegular, gRegular := Compactification.inclusionContinuous, hRegular := Local.regular] \as Flatten;
\definition firstMap[x: Local.Carrier]: Quotient.Carrier := Local.collapse (toPlus x);
\definition firstRegular: topology.Continuity[A := Local.Carrier, B := Quotient.Carrier].Continuous Local.topology Quotient.topology firstMap :=
  topology.Composition[A := Local.Carrier, B := Compactification.Carrier, C := Quotient.Carrier].composeContinuous Local.topology Compactification.topology Quotient.topology toPlus Local.collapse toPlusRegular collapseRegular;
\definition mapsEqual: firstMap = Quotient.projection := \axiom:funext(firstMap, Quotient.projection, Local.onLocal);
\import Relative.PullbackCongruence[X := Quotient.Carrier, Y := Local.Carrier, F := DFiber, bundle := D, source := Local.topology,
  g := firstMap, h := Quotient.projection, gRegular := firstRegular, hRegular := Quotient.continuous, equal := mapsEqual] \as Congruence;
\import Bundles.Isomorphisms[X := Local.Carrier, F := (\fun (x: Local.Carrier) => XFiber x), G := (\fun (x: Local.Carrier) => XFiber x), source := Flatten.direct, target := Flatten.nested] \as Reverse;
\import Operations.IsomorphismComposition[X := Local.Carrier, F := (\fun (x: Local.Carrier) => XFiber x), G := (\fun (x: Local.Carrier) => XFiber x), H := (\fun (x: Local.Carrier) => DFiber (Quotient.projection x)),
  source := Flatten.nested, middle := Flatten.direct, target := Construction.Compare[].pulled] \as Start;
\definition start: Start.Isomorphism := Start.compose (Reverse.inverse Flatten.isomorphism) Congruence.isomorphism;
\import Operations.IsomorphismComposition[X := Local.Carrier, F := (\fun (x: Local.Carrier) => XFiber x), G := (\fun (x: Local.Carrier) => DFiber (Quotient.projection x)), H := Positive,
  source := Flatten.nested, middle := Construction.Compare[].pulled, target := positiveBundle] \as Finish;
\definition sourceBundle: Bundles.Family[X := Local.Carrier, F := (\fun (x: Local.Carrier) => XFiber x)].Bundle := Flatten.nested;
\definition comparison: Finish.Isomorphism := Finish.compose start Construction.Compare[].isomorphism;
\import Relative.FiberTransport[Y := Quotient.Carrier, F := DFiber, bundle := D] \as Transport;
\module Boundary(x: Pair.A);
