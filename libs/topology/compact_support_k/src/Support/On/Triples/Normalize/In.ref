\import Class.In[n := n] \as LocalClass;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Localization[
  U := n.region, open := n.openRegion, L := n.compactSet, compactL := n.compact, enclosed := n.enclosed] \as Local;
\import Relative.Pair[X := Local.Carrier, space := Local.topology, compact := Local.compact, hausdorff := Local.separated,
  subset := Local.boundary, closed := Local.boundaryClosed] \as Pair;
\import Pair.Quotient[] \as Quotient;
\import topological_k_theory.KTheory[].On[X := Local.Carrier, baseSpace := Local.topology, compact := Local.compact, hausdorff := Local.separated] \as Presentations;
\definition E[x: Local.Carrier]: \Set := Fiber t.positive x;
\definition F[x: Local.Carrier]: \Set := Fiber t.negative x;
\definition first: Bundles.Family[X := Local.Carrier, F := E].Bundle := Pair.BundleModel[F := E].bundle LocalClass.firstOnLocal;
\definition second: Bundles.Family[X := Local.Carrier, F := F].Bundle := Pair.BundleModel[F := F].bundle LocalClass.secondOnLocal;
\import Presentations.Bundle[F := F, original := second, same := (\refl(Local.topology))] \as Negative;
\module With(q: Pair.Presentation, negative: Negative.Isomorphism q);

\definition image: \exists (a: Symbols.Carrier \where Group.FromSymbols[].map a = Group.value t) := \block {
  \takefrom q: Negative.Representative \by Negative.representativeExists \then
  \return With[q := q.presentation, negative := q.isomorphism].image
};
