\import Construction.Boundary[x := x] \as Boundary;
\definition outside: \In[Compactification.Carrier] closedPart (Compactification.inclusion x) := \bysub(Local.Carrier, Local.boundary, x);
\definition inChart: \In[Quotient.Carrier] nearChart.domain (firstMap x) := insideChart (Compactification.inclusion x) outside;
\definition reading: \forall (v: XFiber x) -> (Frame.comparison.forward.fiber x).apply ((comparison.forward.fiber x).apply v) =
  (nearChart.frame (\into[Quotient.Carrier](firstMap x, nearChart.domain) \by { inChart })).forward.apply v :=
  \fun (v: XFiber x) => trans!{{Bundles.Vector q.dimension}} _ _ _
    (congr!{{DFiber (Quotient.projection x)} {Bundles.Vector q.dimension}}
      (\fun (w: DFiber (Quotient.projection x)) => (Frame.comparison.forward.fiber x).apply ((Construction.Compare[].isomorphism.forward.fiber x).apply w)) _ _
      (Congruence.formula x v))
    (trans!{{Bundles.Vector q.dimension}} _ _ _ (Boundary.alignment (Transport.cast (firstMap x) (Quotient.projection x) (Congruence.at x) v))
      (Transport.frame nearChart (firstMap x) (Quotient.projection x) (Congruence.at x) inChart
        (\bysub(Quotient.Carrier, Near.domain, Boundary.projected)) v));
