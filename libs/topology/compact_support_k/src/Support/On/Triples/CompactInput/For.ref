\definition source: Bundles.Family[X := Compactification.Carrier, F := F].Bundle := Pair.BundleModel[F := F].bundle firstModel;
\definition target: Bundles.Family[X := Compactification.Carrier, F := G].Bundle := Pair.BundleModel[F := G].bundle secondModel;
\import Pair.BundleTriples[F := F, G := G, firstModel := firstModel, secondModel := secondModel] \as Original;
\import Pair.FromBundles[F := F, G := G, source := source, target := target,
  sourceSame := (\refl(Compactification.topology)), targetSame := (\refl(Compactification.topology))] \as Represent;
\import bundle_extension.Extension[].ComplexMaps[X := Compactification.Carrier, subset := Point.subset, F := F, G := G,
  source := source, target := target, baseSpace := Compactification.topology,
  sourceSame := (\refl(Compactification.topology)), same := (\refl(Compactification.topology))] \as Forward;
\import bundle_extension.Extension[].ComplexMaps[X := Compactification.Carrier, subset := Point.subset, F := G, G := F,
  source := target, target := source, baseSpace := Compactification.topology,
  sourceSame := (\refl(Compactification.topology)), same := (sym!{{topology.Topology[Carrier := Compactification.Carrier].Topology}} source.baseSpace target.baseSpace (\refl(Compactification.topology)))] \as Backward;
\import Complements.For[X := Compactification.Carrier, F := F, bundle := source] \as Positive;
\import Complements.For[X := Compactification.Carrier, F := G, bundle := target] \as Negative;
\module With(alpha: Original.OnSubset, forward: Forward.Result[alpha.forward], backward: Backward.Result[alpha.backward],
  positive: Positive.Embedding, negative: Negative.Embedding);
