\import \parent.Evaluation[t := t] \as First;
\import \parent.Evaluation[t := u] \as Second;
\import \parent.\parent.BundleTriples[F := Fiber t.positive, G := Fiber t.negative, firstModel := First.positiveModel, secondModel := First.negativeModel]
  .To[H := Fiber u.positive, I := Fiber u.negative, newFirstModel := Second.positiveModel, newSecondModel := Second.negativeModel]
  .Supported[K := t.support, J := u.support, compactK := t.compact, compactJ := u.compact]
  .With[alpha := t.comparison, beta := u.comparison, positive := witness.positive, negative := witness.negative, compatible := witness.commutes] \as Change;
\definition equation: First.value = Second.value := Change.equation;
