\import \parent.Between[p := p, q := q, K := K] \as First;
\import \parent.Between[p := q, q := r, K := K] \as Second;
\import \parent.Between[p := p, q := r, K := K] \as Target;
\import Operations.IsomorphismComposition[X := First.A, F := (\fun (x: First.A) => Fiber p x), G := (\fun (x: First.A) => Fiber q x), H := (\fun (x: First.A) => Fiber r x),
  source := First.first, middle := First.second, target := Second.second] \as Composition;
\definition left: Triple := Triple { positive := p, negative := q, support := K, compact := compact, comparison := first };
\definition right: Triple := Triple { positive := q, negative := r, support := K, compact := compact, comparison := second };
\definition triple: Triple := Triple { positive := p, negative := r, support := K, compact := compact, comparison := Composition.compose first second };
