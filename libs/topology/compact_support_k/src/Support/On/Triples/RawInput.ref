\import \parent.Evaluation[t := t] \as Evaluation;
\import \parent.Input[F := Fiber t.positive, G := Fiber t.negative, firstModel := Evaluation.positiveModel, secondModel := Evaluation.negativeModel]
  .Supported[K := t.support, compact := t.compact].With[alpha := t.comparison] \as Class;
\import Operations.IdentityIsomorphism[X := X, F := Fiber t.positive, bundle := bundle t.positive] \as Positive;
\import Operations.IdentityIsomorphism[X := X, F := Fiber t.negative, bundle := bundle t.negative] \as Negative;
\import Class.Using[p := t.positive, q := t.negative, positive := Positive.isomorphism, negative := Negative.isomorphism] \as Chosen;
\import \parent.Isomorphic[t := Class.triple Chosen.result, u := t] \as Change;
\definition witness: Change.Witness := Change.Witness {
  positive := Positive.isomorphism, negative := Negative.isomorphism,
  commutes := \fun (x: \Cast[X] Change.outside)(v: Fiber t.positive x) => \refl((t.comparison.forward.fiber (Change.second x)).apply v)
};
\import \parent.Group[] \as Group;
\definition value: Group.Carrier := Class.value;
\definition equation: value = Group.value t := trans!{{Group.Carrier}} _ _ _ (Class.agreement Chosen.result)
  (Group.isomorphic (Class.triple Chosen.result) t witness);
