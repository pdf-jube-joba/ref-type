\import \parent.Comparison[] \as Comparison;
\import std.Set[].Quotient[A := Expression, Equivalent := Presented.Equivalent] \as Classes;
\definition criterion: \forall (a, b: Expression) -> Logic.PropEquiv[Comparison.forward (class a) = Comparison.forward (class b), Equivalent a b] :=
  \fun (a, b: Expression) => Logic.PropEquiv[Comparison.forward (class a) = Comparison.forward (class b), Equivalent a b] {
    ltr := \fun (same: _) => Classes.equivalentOfClassEq Presented.equivalence a b (Comparison.detectsEquality (class a) (class b) same),
    rtl := \fun (related: _) => congr!{{Carrier} {Relative.Reduced[model := model].Carrier}} Comparison.forward _ _ (Quotient.classRelated Presented.equivalence a b related)
  };
