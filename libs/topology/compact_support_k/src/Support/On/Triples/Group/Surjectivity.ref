\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Symbols[] \as Symbols;
\module With(t: Symbols.Triple, e: Symbols.Supported[t := t].Extensions);
\definition existence: \exists (x: Carrier \where \parent.ToK[].map x = a) := \block {
  \takefrom t: \Cast[Symbols.Triple] ({ t: Symbols.Triple \where Symbols.forward (Symbols.value t) = a }) \by Symbols.represents a \then
  \takefrom e: Symbols.Supported[t := t].Extensions \by Symbols.Supported[t := t].extensionExists \then
  \takefrom v: \Cast[Carrier] ({ v: Carrier \where \parent.ToK[].map v = Symbols.forward (Symbols.value t) }) \by With[t := t, e := e].existence \then
  \return Logic.existsIntro[Carrier, { x: Carrier \where \parent.ToK[].map x = a }] v
    (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _
      (\bysub(Carrier, { v: Carrier \where \parent.ToK[].map v = Symbols.forward (Symbols.value t) }, v))
      (\bysub(Symbols.Triple, { t: Symbols.Triple \where Symbols.forward (Symbols.value t) = a }, t)))
};
