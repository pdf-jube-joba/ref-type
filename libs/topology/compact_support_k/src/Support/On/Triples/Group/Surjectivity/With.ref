\import Symbols.Supported[t := t].With[e := e] \as Extension;
\import Extension.Raw[] \as Raw;
\import \parent.\parent.\parent.Input[F := Raw.F, G := Raw.G, firstModel := Raw.positiveModel, secondModel := Raw.negativeModel]
  .Supported[K := Extension.support, compact := Extension.compactSupport].With[alpha := Raw.comparison] \as Input;
\definition existence: \exists (v: Carrier \where \parent.\parent.ToK[].map v = Symbols.forward (Symbols.value t)) := \block {
  \takefrom r: Input.Result \by Input.existence \then
  \return Logic.existsIntro[Carrier, { v: Carrier \where \parent.\parent.ToK[].map v = Symbols.forward (Symbols.value t) }]
    (\root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Triples[].Group[].value (Input.triple r))
    (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ (\parent.\parent.ToK[].onTriple (Input.triple r))
      (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ (sym!{{Relative.Reduced[model := model].Carrier}} _ _ Input.Comparison[].At[r := r].equation) Raw.equation))
};
