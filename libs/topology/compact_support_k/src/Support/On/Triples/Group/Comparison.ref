\import \parent.ToK[] \as Forward;
\import \parent.FromK[] \as Backward;
\import Relative.Reduced[model := model] \as Reduced;
\definition forward: Carrier -> Reduced.Carrier := Forward.map;
\definition backward: Reduced.Carrier -> Carrier := Backward.map;
\definition forwardAdd: \forall (a, b: Carrier) -> forward (add a b) = Reduced.group.base.op (forward a) (forward b) := Forward.additive;
\definition backwardAdd: \forall (a, b: Reduced.Carrier) -> backward (Reduced.group.base.op a b) = add (backward a) (backward b) := Backward.additive;
\definition leftInverse: \forall (a: Carrier) -> backward (forward a) = a := Backward.LeftInverse[].equation;
\definition rightInverse: \forall (a: Reduced.Carrier) -> forward (backward a) = a := Backward.rightInverse;
\definition detectsEquality: \forall (a, b: Carrier) -> forward a = forward b -> a = b :=
  \fun (a, b: Carrier)(same: _) => trans!{{Carrier}} _ _ _ (sym!{{Carrier}} _ _ (leftInverse a))
    (trans!{{Carrier}} _ _ _ (congr!{{Reduced.Carrier} {Carrier}} backward _ _ same) (leftInverse b));
