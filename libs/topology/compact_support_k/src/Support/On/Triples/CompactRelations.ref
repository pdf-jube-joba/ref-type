\import relative_k_theory.Relative[].PointPair[model := model] \as Point;
\import Relative.Pair[X := Compactification.Carrier, space := Compactification.topology, compact := Compactness.compact,
  hausdorff := Separation.hausdorffCompactification, subset := Point.subset, closed := Point.closed] \as Pair;
\import topological_k_theory.KTheory[].On[X := Compactification.Carrier, baseSpace := Compactification.topology,
  compact := Compactness.compact, hausdorff := Separation.hausdorffCompactification] \as Presentations;
\module Compose(p, q, r: Pair.Presentation, first: Pair.Between[p := p, q := q].Isomorphism, second: Pair.Between[p := q, q := r].Isomorphism);

\module Sum(t, u, v: Pair.Triple, witness: Pair.Sum[t := t, u := u, v := v].Witness);

\module Homotopy(p, q: Pair.Presentation, first, second: Pair.Between[p := p, q := q].Isomorphism,
  family: Pair.Homotopy[p := p, q := q, first := first, second := second].Family);
