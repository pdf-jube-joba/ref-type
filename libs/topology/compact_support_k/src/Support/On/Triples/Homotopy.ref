\import \parent.Between[p := p, q := q, K := K] \as Boundary;
\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := Boundary.A] \as Cylinder;
\import Bundles.Family[X := Boundary.A, F := (\fun (x: Boundary.A) => Fiber p x)].Of[bundle := Boundary.first].Pullback[
  Y := Cylinder.Carrier, source := Cylinder.topology Boundary.subspace, f := Cylinder.point] \as Positive;
\import Bundles.Family[X := Boundary.A, F := (\fun (x: Boundary.A) => Fiber q x)].Of[bundle := Boundary.second].Pullback[
  Y := Cylinder.Carrier, source := Cylinder.topology Boundary.subspace, f := Cylinder.point] \as Negative;
\import Bundles.Isomorphisms[X := Cylinder.Carrier, F := (\fun (z: Cylinder.Carrier) => Fiber p (Cylinder.point z)), G := (\fun (z: Cylinder.Carrier) => Fiber q (Cylinder.point z)),
  source := Positive.pulled (Cylinder.pointContinuous Boundary.subspace), target := Negative.pulled (Cylinder.pointContinuous Boundary.subspace)] \as Maps;
\structure Family: \Set := {
  isomorphism: Maps.Isomorphism,
  start: \forall (x: Boundary.A)(v: Fiber p x) -> (isomorphism.forward.fiber (Cylinder.at I.start x)).apply v = (first.forward.fiber x).apply v,
  end: \forall (x: Boundary.A)(v: Fiber p x) -> (isomorphism.forward.fiber (Cylinder.at I.end x)).apply v = (second.forward.fiber x).apply v
};
\definition left: Triple := Triple { positive := p, negative := q, support := K, compact := compact, comparison := first };
\definition right: Triple := Triple { positive := p, negative := q, support := K, compact := compact, comparison := second };
