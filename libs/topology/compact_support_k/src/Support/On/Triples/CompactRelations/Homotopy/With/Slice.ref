\import EndpointCylinder.Slice[t := time] \as Slice;
\import Bundles.Family[X := Outside, F := (\fun (x: Outside) => Left.F x)].Of[bundle := FirstRestriction.restricted].PullbackIdentity[] \as FirstIdentity;
\import Bundles.Family[X := Outside, F := (\fun (x: Outside) => Left.G x)].Of[bundle := SecondRestriction.restricted].PullbackIdentity[] \as SecondIdentity;
\import Bundles.Isomorphisms[X := Outside, F := (\fun (x: Outside) => Left.G x), G := (\fun (x: Outside) => Left.G x), source := SecondRestriction.restricted, target := Slice.targetBundle] \as Reverse;
\import Operations.IsomorphismComposition[X := Outside, F := (\fun (x: Outside) => Left.F x), G := (\fun (x: Outside) => Left.F x), H := (\fun (x: Outside) => Left.G x),
  source := FirstRestriction.restricted, middle := Slice.sourceBundle, target := Slice.targetBundle] \as Start;
\definition start: Start.Isomorphism := Start.compose FirstIdentity.isomorphism Slice.value;
\import Operations.IsomorphismComposition[X := Outside, F := (\fun (x: Outside) => Left.F x), G := (\fun (x: Outside) => Left.G x), H := (\fun (x: Outside) => Left.G x),
  source := FirstRestriction.restricted, middle := Slice.targetBundle, target := SecondRestriction.restricted] \as Finish;
\definition comparison: Supported.OnOutside := Finish.compose start (Reverse.inverse SecondIdentity.isomorphism);
\definition formula: \forall (x: Outside)(v: Left.F x) -> (comparison.forward.fiber x).apply v = (uniform.forward.fiber (OutsideCylinder.at time x)).apply v :=
  \fun (x: Outside)(v: Left.F x) => \refl((uniform.forward.fiber (OutsideCylinder.at time x)).apply v);
