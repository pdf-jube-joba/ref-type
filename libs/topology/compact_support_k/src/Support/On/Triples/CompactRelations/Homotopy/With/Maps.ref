\import Slices.Slice[t := time] \as Slice;
\import Bundles.Family[X := Compactification.Carrier, F := F].Of[bundle := Presentations.bundle p].PullbackIdentity[] \as PositiveIdentity;
\import Bundles.Family[X := Compactification.Carrier, F := G].Of[bundle := Presentations.bundle q].PullbackIdentity[] \as NegativeIdentity;
\import Bundles.Morphisms[X := Compactification.Carrier, Y := Compactification.Carrier, F := F, G := F, source := Presentations.bundle p, target := Slice.sourceBundle,
  f := (\fun (x: Compactification.Carrier) => x)].Composition[Z := Compactification.Carrier, H := G, range := Slice.targetBundle, g := (\fun (x: Compactification.Carrier) => x)] \as Start;
\definition start: Bundles.Morphisms[X := Compactification.Carrier, Y := Compactification.Carrier, F := F, G := G, source := Presentations.bundle p, target := Slice.targetBundle,
  f := (\fun (x: Compactification.Carrier) => x)].Map := Start.compose PositiveIdentity.forward Slice.value;
\import Bundles.Morphisms[X := Compactification.Carrier, Y := Compactification.Carrier, F := F, G := G, source := Presentations.bundle p, target := Slice.targetBundle,
  f := (\fun (x: Compactification.Carrier) => x)].Composition[Z := Compactification.Carrier, H := G, range := Presentations.bundle q, g := (\fun (x: Compactification.Carrier) => x)] \as Finish;
\definition value: Bundles.Morphisms[X := Compactification.Carrier, Y := Compactification.Carrier, F := F, G := G, source := Presentations.bundle p, target := Presentations.bundle q,
  f := (\fun (x: Compactification.Carrier) => x)].Map := Finish.compose start NegativeIdentity.backward;
\definition formula: \forall (x: Compactification.Carrier)(v: F x) -> (value.fiber x).apply v = (data.forward.map.fiber (Cylinder.at time x)).apply v :=
  \fun (x: Compactification.Carrier)(v: F x) => \refl((data.forward.map.fiber (Cylinder.at time x)).apply v);
