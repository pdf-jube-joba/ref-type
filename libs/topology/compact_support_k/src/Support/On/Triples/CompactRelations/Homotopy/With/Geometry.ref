\definition inclusionRegular: topology.Continuity[A := X, B := Compactification.Carrier].Continuous space original.baseSpace Compactification.inclusion :=
  \idelim Compactification.topology = original.baseSpace \with t: topology.Topology[Carrier := Compactification.Carrier].Topology => topology.Continuity[A := X, B := Compactification.Carrier].Continuous space t Compactification.inclusion \by {
    base: Compactification.inclusionContinuous, equality: sym!{{topology.Topology[Carrier := Compactification.Carrier].Topology}} _ _ same
  };
\definition pointRegular: topology.Continuity[A := Cylinder.Carrier, B := Compactification.Carrier].Continuous Constant.space original.baseSpace Cylinder.point :=
  \idelim Compactification.topology = original.baseSpace \with t: topology.Topology[Carrier := Compactification.Carrier].Topology => topology.Continuity[A := Cylinder.Carrier, B := Compactification.Carrier].Continuous Constant.space t Cylinder.point \by {
    base: Cylinder.pointContinuous Compactification.topology, equality: sym!{{topology.Topology[Carrier := Compactification.Carrier].Topology}} _ _ same
  };
\definition neighborhoodInclusion[z: \Cast[Cylinder.Carrier] Invertible.domain]: Cylinder.Carrier := z;
\definition neighborhoodInclusionRegular: topology.Continuity[A := \Cast[Cylinder.Carrier] Invertible.domain, B := Cylinder.Carrier].Continuous neighborhoodSpace Constant.space neighborhoodInclusion :=
  topology.Continuity[A := \Cast[Cylinder.Carrier] Invertible.domain, B := Cylinder.Carrier].Corestriction[S := Invertible.domain].inclusionContinuous Constant.space;
\import Relative.TriplePullback[X := Compactification.Carrier, Y := X, Z := Outside, T := OutsideCylinder.Carrier, F := H, bundle := original,
  first := space, second := outsideSpace, third := cylinderSpace,
  f := Compactification.inclusion, g := intoOutside, h := OutsideCylinder.point,
  fRegular := inclusionRegular, gRegular := outsideRegular, hRegular := (OutsideCylinder.pointContinuous outsideSpace)] \as Ordinary;
\import Relative.TriplePullback[X := Compactification.Carrier, Y := Cylinder.Carrier, Z := \Cast[Cylinder.Carrier] Invertible.domain, T := OutsideCylinder.Carrier, F := H, bundle := original,
  first := Constant.space, second := neighborhoodSpace, third := cylinderSpace,
  f := Cylinder.point, g := neighborhoodInclusion, h := intoNeighborhood,
  fRegular := pointRegular, gRegular := neighborhoodInclusionRegular, hRegular := neighborhoodRegular] \as Extended;
\definition Fiber[z: OutsideCylinder.Carrier]: \Set := H (Compactification.inclusion (OutsideCylinder.point z));
\definition ordinary: Bundles.Family[X := OutsideCylinder.Carrier, F := Fiber].Bundle := Ordinary.nested;
\definition extended: Bundles.Family[X := OutsideCylinder.Carrier, F := Fiber].Bundle := Extended.nested;
\definition middle: Bundles.Family[X := \Cast[Cylinder.Carrier] Invertible.domain, F := (\fun (z: \Cast[Cylinder.Carrier] Invertible.domain) => H (Cylinder.point z))].Bundle := Extended.middle;
\import Bundles.Isomorphisms[X := OutsideCylinder.Carrier, F := Fiber, G := Fiber, source := Ordinary.direct, target := ordinary] \as Reverse;
\import Operations.IsomorphismComposition[X := OutsideCylinder.Carrier, F := Fiber, G := Fiber, H := Fiber,
  source := ordinary, middle := Ordinary.direct, target := extended] \as Compose;
\definition comparison: Compose.Isomorphism := Compose.compose (Reverse.inverse Ordinary.isomorphism) Extended.isomorphism;
