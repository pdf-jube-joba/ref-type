\import \parent.\parent.FromCompact[t := t] \as Left;
\import \parent.\parent.FromCompact[t := u] \as Middle;
\import \parent.\parent.FromCompact[t := v] \as Right;
\import \parent.\parent.Group[] \as Group;
\module With(a: Left.ExtensionData, b: Middle.ExtensionData, c: Right.ExtensionData);
\definition equation: Group.add Left.value Middle.value = Right.value := \block {
  \takefrom a: Left.ExtensionData \by Left.existence \then
  \takefrom b: Middle.ExtensionData \by Middle.existence \then
  \takefrom c: Right.ExtensionData \by Right.existence \then
  \return With[a := a, b := b, c := c].equation
};
