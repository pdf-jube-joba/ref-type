\import Pair.Compose[p := p, q := q, r := r, first := first, second := second] \as Raw;
\import \parent.\parent.FromCompact[t := Raw.left] \as Left;
\import \parent.\parent.FromCompact[t := Raw.right] \as Middle;
\import \parent.\parent.FromCompact[t := Raw.triple] \as Right;
\import \parent.\parent.Group[] \as Group;
\module With(a: Left.ExtensionData, b: Middle.ExtensionData);
\definition equation: Group.add Left.value Middle.value = Right.value := \block {
  \takefrom a: Left.ExtensionData \by Left.existence \then
  \takefrom b: Middle.ExtensionData \by Middle.existence \then
  \return With[a := a, b := b].equation
};
