\definition originalPointRegular: topology.Continuity[A := Pair.A, B := Compactification.Carrier].Continuous Pair.subspace original.baseSpace pointInclusion :=
  \idelim Compactification.topology = original.baseSpace \with t: topology.Topology[Carrier := Compactification.Carrier].Topology => topology.Continuity[A := Pair.A, B := Compactification.Carrier].Continuous Pair.subspace t pointInclusion \by {
    base: pointRegular, equality: sym!{{topology.Topology[Carrier := Compactification.Carrier].Topology}} _ _ same
  };
\definition cylinderPointRegular: topology.Continuity[A := Cylinder.Carrier, B := Compactification.Carrier].Continuous Constant.space original.baseSpace Cylinder.point :=
  \idelim Compactification.topology = original.baseSpace \with t: topology.Topology[Carrier := Compactification.Carrier].Topology => topology.Continuity[A := Cylinder.Carrier, B := Compactification.Carrier].Continuous Constant.space t Cylinder.point \by {
    base: Cylinder.pointContinuous Compactification.topology, equality: sym!{{topology.Topology[Carrier := Compactification.Carrier].Topology}} _ _ same
  };
\import Relative.TriplePullback[X := Compactification.Carrier, Y := Pair.A, Z := BoundaryCylinder.Carrier, T := B, F := H, bundle := original,
  first := Pair.subspace, second := BoundaryCylinder.topology Pair.subspace, third := boundarySpace,
  f := pointInclusion, g := BoundaryCylinder.point, h := boundaryMap,
  fRegular := originalPointRegular, gRegular := (BoundaryCylinder.pointContinuous Pair.subspace), hRegular := boundaryRegular] \as Local;
\import Bundles.Family[X := Compactification.Carrier, F := H].Of[bundle := original].PullbackComposition[Y := Cylinder.Carrier, Z := B,
  first := Constant.space, second := boundarySpace, f := Cylinder.point, g := boundaryInclusion]
  .Of[fRegular := cylinderPointRegular, gRegular := inclusionRegular] \as Ambient;
\definition Fiber[z: B]: \Set := H (Cylinder.point z);
\definition ambient: Bundles.Family[X := B, F := Fiber].Bundle := Ambient.nested;
\definition local: Bundles.Family[X := B, F := Fiber].Bundle := Local.nested;
\definition middle: Bundles.Family[X := BoundaryCylinder.Carrier, F := (\fun (z: BoundaryCylinder.Carrier) => H (BoundaryCylinder.point z))].Bundle := Local.middle;
\import Bundles.Isomorphisms[X := B, F := Fiber, G := Fiber, source := Ambient.direct, target := ambient] \as Reverse;
\import Operations.IsomorphismComposition[X := B, F := Fiber, G := Fiber, H := Fiber,
  source := ambient, middle := Ambient.direct, target := local] \as Composition;
\definition comparison: Composition.Isomorphism := Composition.compose (Reverse.inverse Ambient.isomorphism) Local.isomorphism;
