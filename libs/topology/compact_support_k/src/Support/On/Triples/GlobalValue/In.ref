\import Original.In[n := n] \as LocalClass;
\import \parent.\parent.\parent.Localization[U := n.region, open := n.openRegion, L := n.compactSet, compactL := n.compact, enclosed := n.enclosed] \as Local;
\import Relative.Pair[X := Local.Carrier, space := Local.topology, compact := Local.compact, hausdorff := Local.separated,
  subset := Local.boundary, closed := Local.boundaryClosed] \as Pair;
\import Complements.PulledIsomorphism[X := X, Y := Local.Carrier, F := Fiber t.positive, G := Fiber t.negative,
  source := bundle t.positive, target := bundle t.negative, base := Local.topology, f := Local.inclusion,
  sourceRegular := Local.regular, targetRegular := Local.regular] \as Pull;
\definition compatible: \forall (x: Pair.A)(v: Fiber t.positive x) ->
  ((Pull.isomorphism witness.isomorphism).forward.fiber x).apply v = (LocalClass.comparison.forward.fiber x).apply v :=
  \fun (x: Pair.A)(v: Fiber t.positive x) => trans!{{Fiber t.negative x}} _ _ _
    (witness.agrees (\into[X](x, Base.Complement t.support) \by {
      \fun (inside: _) => (\bysub(Local.Carrier, Local.boundary, x)) (n.contains x inside)
    }) v) (sym!{{Fiber t.negative x}} _ _ (LocalClass.formula x v));
\import Pair.BundleTriples[F := LocalClass.FirstFiber, G := LocalClass.SecondFiber,
  firstModel := LocalClass.firstOnLocal, secondModel := LocalClass.secondOnLocal].With[alpha := LocalClass.comparison]
  .Global[isomorphism := Pull.isomorphism witness.isomorphism, agrees := compatible] \as Global;
\definition equation: LocalClass.value = Relative.Reduced[model := model].group.base.unit :=
  trans!{{Relative.Reduced[model := model].Carrier}} _ _ _
    (congr!{{Pair.Quotient[].Relative} {Relative.Reduced[model := model].Carrier}} Local.extend _ _ Global.reducedZero) Local.extendZero;
