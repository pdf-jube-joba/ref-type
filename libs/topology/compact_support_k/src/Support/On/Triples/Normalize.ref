\import \parent.Evaluation[t := t] \as Evaluation;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact]
  .BundleTriples[F := Fiber t.positive, G := Fiber t.negative, firstModel := Evaluation.positiveModel, secondModel := Evaluation.negativeModel]
  .Supported[K := t.support, compactK := t.compact].With[alpha := t.comparison] \as Class;
\import \parent.Group[] \as Group;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Symbols[] \as Symbols;
\module In(n: Class.Neighborhood);

\definition image: \exists (a: Symbols.Carrier \where Group.FromSymbols[].map a = Group.value t) := \block {
  \takefrom n: Class.Neighborhood \by Class.neighborhoods \then
  \return In[n := n].image
};
