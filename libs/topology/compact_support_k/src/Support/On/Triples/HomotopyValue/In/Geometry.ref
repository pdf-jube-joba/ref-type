\import Relative.TriplePullback[X := X, Y := Local.Carrier, Z := Pair.A, T := Cylinder.Carrier, F := Fiber b, bundle := bundle b,
  first := Local.topology, second := Pair.subspace, third := Cylinder.topology Pair.subspace,
  f := Local.inclusion, g := toLocal, h := Cylinder.point, fRegular := Local.regular, gRegular := toLocalRegular, hRegular := (Cylinder.pointContinuous Pair.subspace)] \as LocalPull;
\import Relative.TriplePullback[X := X, Y := Outside.A, Z := RawCylinder.Carrier, T := Cylinder.Carrier, F := Fiber b, bundle := bundle b,
  first := Outside.subspace, second := RawCylinder.topology Outside.subspace, third := Cylinder.topology Pair.subspace,
  f := outsideInclusion, g := RawCylinder.point, h := cylinderMap, fRegular := outsideRegular, gRegular := (RawCylinder.pointContinuous Outside.subspace), hRegular := cylinderRegular] \as RawPull;
\definition LocalFiber[z: Cylinder.Carrier]: \Set := Fiber b (Cylinder.point z);
\definition RawFiber[z: RawCylinder.Carrier]: \Set := Fiber b (RawCylinder.point z);
\definition local: Bundles.Family[X := Cylinder.Carrier, F := LocalFiber].Bundle := LocalPull.nested;
\definition raw: Bundles.Family[X := Cylinder.Carrier, F := LocalFiber].Bundle := RawPull.nested;
\definition middle: Bundles.Family[X := RawCylinder.Carrier, F := RawFiber].Bundle := RawPull.middle;
\import Bundles.Isomorphisms[X := Cylinder.Carrier, F := LocalFiber, G := LocalFiber, source := LocalPull.direct, target := local] \as Reverse;
\import Operations.IsomorphismComposition[X := Cylinder.Carrier, F := LocalFiber, G := LocalFiber, H := LocalFiber,
  source := local, middle := LocalPull.direct, target := raw] \as Composition;
\definition comparison: Composition.Isomorphism := Composition.compose (Reverse.inverse LocalPull.isomorphism) RawPull.isomorphism;
