\import \parent.Compose[p := p, q := q, r := r, K := K, compact := compact, first := first, second := second] \as Raw;
\import \parent.Evaluation[t := Raw.left] \as Left;
\import \parent.Evaluation[t := Raw.right] \as Middle;
\import \parent.Evaluation[t := Raw.triple] \as Right;
\import \parent.\parent.BundleTriples[F := Fiber p, G := Fiber q, firstModel := Left.positiveModel, secondModel := Left.negativeModel].Supported[K := Raw.left.support, compactK := Raw.left.compact].With[alpha := Raw.left.comparison] \as LeftClass;
\import \parent.\parent.BundleTriples[F := Fiber q, G := Fiber r, firstModel := Middle.positiveModel, secondModel := Middle.negativeModel].Supported[K := Raw.right.support, compactK := Raw.right.compact].With[alpha := Raw.right.comparison] \as MiddleClass;
\import \parent.\parent.BundleTriples[F := Fiber p, G := Fiber r, firstModel := Right.positiveModel, secondModel := Right.negativeModel].Supported[K := Raw.triple.support, compactK := Raw.triple.compact].With[alpha := Raw.triple.comparison] \as RightClass;
\import \parent.\parent.Neighborhood[K := K, compact := compact] \as Neighbors;
\module In(w: Neighbors.Witness);
\definition equation: Relative.Reduced[model := model].group.base.op Left.value Middle.value = Right.value := \block {
  \takefrom w: Neighbors.Witness \by Neighbors.existence \then
  \return In[w := w].equation
};
