\import \parent.Input[F := F, G := G, firstModel := firstModel, secondModel := secondModel] \as First;
\import \parent.Input[F := G, G := H, firstModel := secondModel, secondModel := thirdModel] \as Second;
\import \parent.Input[F := F, G := H, firstModel := firstModel, secondModel := thirdModel] \as Third;
\import First.Supported[K := K, compact := compact] \as LeftInput;
\import Second.Supported[K := K, compact := compact] \as MiddleInput;
\import Third.Supported[K := K, compact := compact] \as RightInput;
\definition A: \Set := \Cast[X] (Base.Complement K);
\import Bundles.Family[X := X, F := F].Of[bundle := First.source].Restriction[U := Base.Complement K] \as Source;
\import Bundles.Family[X := X, F := G].Of[bundle := First.target].Restriction[U := Base.Complement K] \as Middle;
\import Bundles.Family[X := X, F := H].Of[bundle := Second.target].Restriction[U := Base.Complement K] \as Target;
\import Operations.IsomorphismComposition[X := A, F := (\fun (x: A) => F x), G := (\fun (x: A) => G x), H := (\fun (x: A) => H x),
  source := Source.restricted, middle := Middle.restricted, target := Target.restricted] \as Composition;
\module With(alpha: LeftInput.OnOutside, beta: MiddleInput.OnOutside);
