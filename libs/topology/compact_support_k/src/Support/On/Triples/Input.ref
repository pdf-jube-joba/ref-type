\definition source: Bundles.Family[X := X, F := F].Bundle := \parent.\parent.BundleModel[F := F].bundle firstModel;
\definition target: Bundles.Family[X := X, F := G].Bundle := \parent.\parent.BundleModel[F := G].bundle secondModel;
\import Models.From[F := F, original := source] \as SourceModels;
\import Models.From[F := G, original := target] \as TargetModels;
\module Supported(K: \Pow X, compact: Base.IsCompactIn space K);
\module To(H, I: X -> \Set, newFirstModel: \parent.\parent.\parent.BundleModel[F := H].Bundle, newSecondModel: \parent.\parent.\parent.BundleModel[F := I].Bundle);
