\definition firstAgreement[a: Fiber r.positiveModel x]: (r.negative.backward.fiber x).apply ((r.comparison.forward.fiber (inFirst x)).apply a) =
  (alpha.forward.fiber (inFirst x)).apply ((r.positive.backward.fiber x).apply a) :=
  trans!{{G x}} _ _ _
    (congr!{{Fiber r.negativeModel x} {G x}} (r.negative.backward.fiber x).apply _ _
      (trans!{{Fiber r.negativeModel x}} _ _ _
        (congr!{{Fiber r.positiveModel x} {Fiber r.negativeModel x}} (r.comparison.forward.fiber (inFirst x)).apply _ _
          (sym!{{Fiber r.positiveModel x}} _ _ ((\bysub(PositiveFirst.Data, PositiveFirst.Isomorphism, r.positive)).rightInverse x a)))
        (r.agrees (inFirst x) ((r.positive.backward.fiber x).apply a))))
    ((\bysub(NegativeFirst.Data, NegativeFirst.Isomorphism, r.negative)).leftInverse x _);
\definition secondAgreement[a: Fiber s.positiveModel x]: (s.negative.backward.fiber x).apply ((s.comparison.forward.fiber (inSecond x)).apply a) =
  (beta.forward.fiber (inSecond x)).apply ((s.positive.backward.fiber x).apply a) :=
  trans!{{I x}} _ _ _
    (congr!{{Fiber s.negativeModel x} {I x}} (s.negative.backward.fiber x).apply _ _
      (trans!{{Fiber s.negativeModel x}} _ _ _
        (congr!{{Fiber s.positiveModel x} {Fiber s.negativeModel x}} (s.comparison.forward.fiber (inSecond x)).apply _ _
          (sym!{{Fiber s.positiveModel x}} _ _ ((\bysub(PositiveSecond.Data, PositiveSecond.Isomorphism, s.positive)).rightInverse x a)))
        (s.agrees (inSecond x) ((s.positive.backward.fiber x).apply a))))
    ((\bysub(NegativeSecond.Data, NegativeSecond.Isomorphism, s.negative)).leftInverse x _);
\definition equation: \forall (a: Fiber r.positiveModel x)(b: Fiber s.positiveModel x) ->
  (v.comparison.forward.fiber (inThird x)).apply ((positive.forward.fiber x).apply (Product.pair (Fiber r.positiveModel x) (Fiber s.positiveModel x) a b)) =
  (negative.forward.fiber x).apply (Product.pair (Fiber r.negativeModel x) (Fiber s.negativeModel x)
    ((r.comparison.forward.fiber (inFirst x)).apply a) ((s.comparison.forward.fiber (inSecond x)).apply b)) :=
  \fun (a: Fiber r.positiveModel x)(b: Fiber s.positiveModel x) => trans!{{Fiber v.negativeModel x}} _ _ _
    (v.agrees (inThird x) ((witness.positive.forward.fiber x).apply (Product.pair (F x) (H x) ((r.positive.backward.fiber x).apply a) ((s.positive.backward.fiber x).apply b))))
    (trans!{{Fiber v.negativeModel x}} _ _ _
      (congr!{{L x} {Fiber v.negativeModel x}} (v.negative.forward.fiber x).apply _ _
        (witness.agrees x ((r.positive.backward.fiber x).apply a) ((s.positive.backward.fiber x).apply b)))
      (congr!{{G x} {I x} {Fiber v.negativeModel x}}
        (\fun (g: G x)(i: I x) => (v.negative.forward.fiber x).apply ((witness.negative.forward.fiber x).apply (Product.pair (G x) (I x) g i))) _ _ _ _
        (sym!{{G x}} _ _ (firstAgreement a)) (sym!{{I x}} _ _ (secondAgreement b))));
