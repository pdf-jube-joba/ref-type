\import FirstSupport.With[alpha := alpha] \as Left;
\import SecondSupport.With[alpha := beta] \as Middle;
\import ThirdSupport.With[alpha := gamma] \as Right;
\import \parent.\parent.\parent.Group[] \as Group;
\module Using(r: Left.Result, s: Middle.Result, v: Right.Result);
\definition equation: Group.add Left.value Middle.value = Right.value := \block {
  \takefrom r: Left.Result \by Left.existence \then
  \takefrom s: Middle.Result \by Middle.existence \then
  \takefrom v: Right.Result \by Right.existence \then
  \return trans!{{Group.Carrier}} _ _ _
    (congr!{{Group.Carrier} {Group.Carrier} {Group.Carrier}} Group.add _ _ _ _ (Left.agreement r) (Middle.agreement s))
    (trans!{{Group.Carrier}} _ _ _ Using[r := r, s := s, v := v].equation (sym!{{Group.Carrier}} _ _ (Right.agreement v)))
};
