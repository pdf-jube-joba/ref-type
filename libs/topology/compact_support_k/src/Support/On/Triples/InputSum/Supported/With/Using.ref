\import Bundles.Isomorphisms[X := X, F := F, G := Fiber r.positiveModel, source := First.source, target := bundle r.positiveModel] \as PositiveFirst;
\import Bundles.Isomorphisms[X := X, F := H, G := Fiber s.positiveModel, source := Second.source, target := bundle s.positiveModel] \as PositiveSecond;
\import Operations.DirectSumIsomorphisms[X := X, F := Fiber r.positiveModel, G := Fiber s.positiveModel, A := F, B := H,
  first := bundle r.positiveModel, second := bundle s.positiveModel, newFirst := First.source, newSecond := Second.source, sameSource := (\refl(space)), sameTarget := (\refl(space))] \as PositiveSum;
\import Operations.IsomorphismComposition[X := X, F := PositiveSum.SourceFiber, G := Positive.Fiber, H := J,
  source := PositiveSum.sourceBundle, middle := Positive.bundle (\refl(space)), target := Third.source] \as PositiveStart;
\definition positiveStart: PositiveStart.Isomorphism := PositiveStart.compose
  (PositiveSum.isomorphism (PositiveFirst.inverse r.positive) (PositiveSecond.inverse s.positive)) witness.positive;
\import Operations.IsomorphismComposition[X := X, F := PositiveSum.SourceFiber, G := J, H := Fiber v.positiveModel,
  source := PositiveSum.sourceBundle, middle := Third.source, target := bundle v.positiveModel] \as PositiveFinish;
\definition positive: PositiveFinish.Isomorphism := PositiveFinish.compose positiveStart v.positive;
\import Bundles.Isomorphisms[X := X, F := G, G := Fiber r.negativeModel, source := First.target, target := bundle r.negativeModel] \as NegativeFirst;
\import Bundles.Isomorphisms[X := X, F := I, G := Fiber s.negativeModel, source := Second.target, target := bundle s.negativeModel] \as NegativeSecond;
\import Operations.DirectSumIsomorphisms[X := X, F := Fiber r.negativeModel, G := Fiber s.negativeModel, A := G, B := I,
  first := bundle r.negativeModel, second := bundle s.negativeModel, newFirst := First.target, newSecond := Second.target, sameSource := (\refl(space)), sameTarget := (\refl(space))] \as NegativeSum;
\import Operations.IsomorphismComposition[X := X, F := NegativeSum.SourceFiber, G := Negative.Fiber, H := L,
  source := NegativeSum.sourceBundle, middle := Negative.bundle (\refl(space)), target := Third.target] \as NegativeStart;
\definition negativeStart: NegativeStart.Isomorphism := NegativeStart.compose
  (NegativeSum.isomorphism (NegativeFirst.inverse r.negative) (NegativeSecond.inverse s.negative)) witness.negative;
\import Operations.IsomorphismComposition[X := X, F := NegativeSum.SourceFiber, G := L, H := Fiber v.negativeModel,
  source := NegativeSum.sourceBundle, middle := Third.target, target := bundle v.negativeModel] \as NegativeFinish;
\definition negative: NegativeFinish.Isomorphism := NegativeFinish.compose negativeStart v.negative;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Triples[]
  .Sum[t := Left.triple r, u := Middle.triple s, v := Right.triple v] \as Compare;
\module At(x: \Cast[X] outside);
\definition witness: Compare.Witness := Compare.Witness { positive := positive, negative := negative, agrees := \fun (x: \Cast[X] outside) => At[x := x].equation };
\definition equation: Group.add (Group.value (Left.triple r)) (Group.value (Middle.triple s)) = Group.value (Right.triple v) :=
  Group.sum (Left.triple r) (Middle.triple s) (Right.triple v) witness;
