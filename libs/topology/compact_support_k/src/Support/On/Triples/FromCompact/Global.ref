\import topological_k_theory.KTheory[].On[X := Compactification.Carrier, baseSpace := Compactification.topology,
  compact := Compactness.compact, hausdorff := Separation.hausdorffCompactification] \as Presentations;
\definition F[x: Compactification.Carrier]: \Set := Presentations.Fiber t.positive x;
\definition G[x: Compactification.Carrier]: \Set := Presentations.Fiber t.negative x;
\import bundle_extension.Extension[].ComplexMaps[X := Compactification.Carrier, subset := Point.subset, F := F, G := G,
  source := Presentations.bundle t.positive, target := Presentations.bundle t.negative, baseSpace := Compactification.topology,
  sourceSame := (\refl(Compactification.topology)), same := (\refl(Compactification.topology))] \as Forward;
\import bundle_extension.Extension[].ComplexMaps[X := Compactification.Carrier, subset := Point.subset, F := G, G := F,
  source := Presentations.bundle t.negative, target := Presentations.bundle t.positive, baseSpace := Compactification.topology,
  sourceSame := (\refl(Compactification.topology)), same := (sym!{{topology.Topology[Carrier := Compactification.Carrier].Topology}}
    (Presentations.bundle t.positive).baseSpace (Presentations.bundle t.negative).baseSpace (\refl(Compactification.topology)))] \as Backward;
\definition forward: Forward.Result[t.comparison.forward] := Forward.Result[t.comparison.forward] { map := witness.isomorphism.forward, extends := witness.agrees };
\definition backwardAgreement: \forall (x: \Cast[Compactification.Carrier] Point.subset)(v: G x) ->
  (witness.isomorphism.backward.fiber x).apply v = (t.comparison.backward.fiber x).apply v :=
  \fun (x: \Cast[Compactification.Carrier] Point.subset)(v: G x) => trans!{{F x}} _ _ _
    (congr!{{G x} {F x}} (witness.isomorphism.backward.fiber x).apply _ _ (sym!{{G x}} _ _ (t.comparison.rightInverse x v)))
    (trans!{{F x}} _ _ _
      (congr!{{G x} {F x}} (witness.isomorphism.backward.fiber x).apply _ _ (sym!{{G x}} _ _ (witness.agrees x ((t.comparison.backward.fiber x).apply v))))
      (witness.isomorphism.leftInverse x ((t.comparison.backward.fiber x).apply v)));
\definition backward: Backward.Result[t.comparison.backward] := Backward.Result[t.comparison.backward] { map := witness.isomorphism.backward, extends := backwardAgreement };
\import Complements.For[X := Compactification.Carrier, F := F, bundle := Presentations.bundle t.positive] \as Positive;
\import Complements.For[X := Compactification.Carrier, F := G, bundle := Presentations.bundle t.negative] \as Negative;
\module With(positive: Positive.Embedding, negative: Negative.Embedding);
\definition equation: value = Group.zero := \block {
  \takefrom p: Positive.Embedding \by Positive.embeddingExists Compactness.compact Separation.hausdorffCompactification \then
  \takefrom q: Negative.Embedding \by Negative.embeddingExists Compactness.compact Separation.hausdorffCompactification \then
  \return With[positive := p, negative := q].equation
};
