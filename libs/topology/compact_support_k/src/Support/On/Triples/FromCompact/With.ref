\import Symbols.Supported[t := t].Complex[].With[w := w] \as Extended;
\import Symbols.Supported[t := t].With[e := Extended.inverseAtInfinity] \as Neighborhood;
\import Neighborhood.Raw[] \as Raw;
\import \parent.\parent.Input[F := Raw.F, G := Raw.G, firstModel := Raw.positiveModel, secondModel := Raw.negativeModel]
  .Supported[K := Neighborhood.support, compact := Neighborhood.compactSupport].With[alpha := Raw.comparison] \as Input;
\import \parent.\parent.Group[] \as Group;
\definition F[x: X]: \Set := Raw.F x;
\definition G[x: X]: \Set := Raw.G x;
\definition positiveModel: \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].BundleModel[F := F].Bundle := Raw.positiveModel;
\definition negativeModel: \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].BundleModel[F := G].Bundle := Raw.negativeModel;
\definition support: \Pow X := Neighborhood.support;
\definition compactSupport: Base.IsCompactIn space support := Neighborhood.compactSupport;
\definition comparison: \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Triples[]
  .Input[F := F, G := G, firstModel := positiveModel, secondModel := negativeModel].Supported[K := support, compact := compactSupport].OnOutside := Raw.comparison;
\definition value: Group.Carrier := Input.value;
\definition equation: Group.ToK[].map value = Symbols.forward (Symbols.value t) := trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ Input.Comparison[].equation Raw.equation;
\definition formula: \forall (x: \Cast[X] (Base.Complement support))(v: F x) -> (comparison.forward.fiber x).apply v = (w.forward.map.fiber (Compactification.inclusion x)).apply v :=
  \fun (x: \Cast[X] (Base.Complement support))(v: F x) => \refl((w.forward.map.fiber (Compactification.inclusion x)).apply v);
