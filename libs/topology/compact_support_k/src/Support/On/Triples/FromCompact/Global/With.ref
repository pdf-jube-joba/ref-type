\definition data: ExtensionData := ExtensionData { forward := forward, backward := backward, positive := positive, negative := negative };
\import \parent.\parent.With[w := data] \as Class;
\import Complements.PulledIsomorphism[X := Compactification.Carrier, Y := X, F := F, G := G,
  source := Presentations.bundle t.positive, target := Presentations.bundle t.negative, base := space, f := Compactification.inclusion,
  sourceRegular := Compactification.inclusionContinuous, targetRegular := Compactification.inclusionContinuous] \as Pull;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Triples[]
  .Input[F := Class.F, G := Class.G, firstModel := Class.positiveModel, secondModel := Class.negativeModel]
  .Supported[K := Class.support, compact := Class.compactSupport].With[alpha := Class.comparison] \as Input;
\definition agrees: \forall (x: \Cast[X] (Base.Complement Class.support))(v: Class.F x) ->
  ((Pull.isomorphism witness.isomorphism).forward.fiber x).apply v = (Class.comparison.forward.fiber x).apply v :=
  \fun (x: \Cast[X] (Base.Complement Class.support))(v: Class.F x) => sym!{{Class.G x}} _ _ (Class.formula x v);
\definition equation: value = Group.zero := trans!{{Group.Carrier}} _ _ _ (agreement data)
  Input.Global[isomorphism := (Pull.isomorphism witness.isomorphism), agrees := agrees].equation;
