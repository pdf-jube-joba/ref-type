\import \parent.\parent.BundleModel[F := Fiber t.positive].From[original := bundle t.positive, same := (\refl(space))] \as First;
\import \parent.\parent.BundleModel[F := Fiber t.negative].From[original := bundle t.negative, same := (\refl(space))] \as Second;
\definition positiveModel: \parent.\parent.BundleModel[F := Fiber t.positive].Bundle := First.model;
\definition negativeModel: \parent.\parent.BundleModel[F := Fiber t.negative].Bundle := Second.model;
\import \parent.\parent.BundleTriples[F := Fiber t.positive, G := Fiber t.negative, firstModel := First.model, secondModel := Second.model] \as BundlesClass;
\import BundlesClass.Supported[K := t.support, compactK := t.compact].With[alpha := t.comparison] \as Supported;
\definition value: Relative.Reduced[model := model].Carrier := Supported.value;
