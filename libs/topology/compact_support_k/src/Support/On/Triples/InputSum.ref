\import \parent.Input[F := F, G := G, firstModel := firstModel, secondModel := secondModel] \as First;
\import \parent.Input[F := H, G := I, firstModel := thirdModel, secondModel := fourthModel] \as Second;
\import \parent.Input[F := J, G := L, firstModel := fifthModel, secondModel := sixthModel] \as Third;
\import Operations.DirectSum[X := X, F := F, G := H, left := First.source, right := Second.source] \as Positive;
\import Operations.DirectSum[X := X, F := G, G := I, left := First.target, right := Second.target] \as Negative;
\import Bundles.Isomorphisms[X := X, F := Positive.Fiber, G := J, source := Positive.bundle (\refl(space)), target := Third.source] \as PositiveMaps;
\import Bundles.Isomorphisms[X := X, F := Negative.Fiber, G := L, source := Negative.bundle (\refl(space)), target := Third.target] \as NegativeMaps;
\module Supported(K1, K2, K3: \Pow X,
  compact1: Base.IsCompactIn space K1, compact2: Base.IsCompactIn space K2, compact3: Base.IsCompactIn space K3);
