\import Source.With[alpha := alpha] \as Left;
\import Target.With[alpha := beta] \as Right;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Triples[].Group[] \as Group;
\module Using(r: Left.Result, s: Right.Result);
\definition equation: Left.value = Right.value := \block {
  \takefrom r: Left.Result \by Left.existence \then
  \takefrom s: Right.Result \by Right.existence \then
  \return trans!{{Group.Carrier}} _ _ _ (Left.agreement r)
    (trans!{{Group.Carrier}} _ _ _ Using[r := r, s := s].equation (sym!{{Group.Carrier}} _ _ (Right.agreement s)))
};
