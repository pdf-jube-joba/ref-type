\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact]
  .BundleTriples[F := F, G := G, firstModel := firstModel, secondModel := secondModel].Supported[K := K, compactK := compact].With[alpha := alpha] \as Original;
\import Group.ToK[] \as ToK;
\module At(r: Result);
\definition equation: ToK.map value = Original.value := \block {
  \takefrom r: Result \by existence \then
  \return trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ (congr!{{Group.Carrier} {Relative.Reduced[model := model].Carrier}} ToK.map _ _ (agreement r))
    (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ (ToK.onTriple (triple r)) (sym!{{Relative.Reduced[model := model].Carrier}} _ _ At[r := r].equation))
};
