\import Bundles.Isomorphisms[X := X, F := F, G := Fiber r.positiveModel, source := source, target := bundle r.positiveModel] \as Positive;
\import Operations.IsomorphismComposition[X := X, F := Fiber r.positiveModel, G := F, H := G,
  source := bundle r.positiveModel, middle := source, target := target] \as Start;
\definition start: Start.Isomorphism := Start.compose (Positive.inverse r.positive) isomorphism;
\import Operations.IsomorphismComposition[X := X, F := Fiber r.positiveModel, G := G, H := Fiber r.negativeModel,
  source := bundle r.positiveModel, middle := target, target := bundle r.negativeModel] \as Finish;
\definition comparison: Finish.Isomorphism := Finish.compose start r.negative;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Triples[].Global[t := triple r] \as Global;
\definition witness: Global.Witness := Global.Witness { isomorphism := comparison,
  agrees := \fun (x: A)(v: Fiber r.positiveModel x) => trans!{{Fiber r.negativeModel x}} _ _ _
    (congr!{{G x} {Fiber r.negativeModel x}} (r.negative.forward.fiber x).apply _ _ (agrees x ((r.positive.backward.fiber x).apply v)))
    (trans!{{Fiber r.negativeModel x}} _ _ _ (sym!{{Fiber r.negativeModel x}} _ _ (r.agrees x ((r.positive.backward.fiber x).apply v)))
      (congr!{{Fiber r.positiveModel x} {Fiber r.negativeModel x}} (r.comparison.forward.fiber x).apply _ _
        ((\bysub(Positive.Data, Positive.Isomorphism, r.positive)).rightInverse x v)))
};
\definition equation: Group.value (triple r) = Group.zero := Group.globalZero (triple r) witness;
