\import Original.Supported[K := K, compact := compactK] \as Source;
\import Changed.Supported[K := J, compact := compactJ] \as Target;
\definition outside: \Pow X := Base.Complement (Base.Finite[].Join K J);
\definition inSource[x: \Cast[X] outside]: Source.A := \into[X](x, Base.Complement K) \by {
  \fun (inside: _) => (\bysub(X, outside, x)) (Logic.Or[_, _]::left inside)
};
\definition inTarget[x: \Cast[X] outside]: Target.A := \into[X](x, Base.Complement J) \by {
  \fun (inside: _) => (\bysub(X, outside, x)) (Logic.Or[_, _]::right inside)
};
\module With(alpha: Source.OnOutside, beta: Target.OnOutside, positive: Positive.Isomorphism, negative: Negative.Isomorphism,
  commutes: \forall (x: \Cast[X] outside)(v: F x) -> (beta.forward.fiber (inTarget x)).apply ((positive.forward.fiber x).apply v) =
    (negative.forward.fiber x).apply ((alpha.forward.fiber (inSource x)).apply v));
