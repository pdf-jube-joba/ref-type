\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Triples[].Evaluation[t := triple r] \as Evaluation;
\definition joint: \Pow X := Base.Finite[].Join K (triple r).support;
\definition outsideJoint: \Pow X := Base.Complement joint;
\definition point[x: \Cast[X] outsideJoint]: A := \into[X](x, Base.Complement K) \by {
  \fun (inside: _) => (\bysub(X, outsideJoint, x)) (Logic.Or[_, _]::left inside)
};
\definition compatible: \forall (x: \Cast[X] outsideJoint)(v: F x) ->
  ((triple r).comparison.forward.fiber (point x)).apply ((r.positive.forward.fiber x).apply v) =
  (r.negative.forward.fiber x).apply ((alpha.forward.fiber (point x)).apply v) := \fun (x: \Cast[X] outsideJoint) => r.agrees (point x);
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact]
  .BundleTriples[F := F, G := G, firstModel := firstModel, secondModel := secondModel]
  .To[H := Fiber r.positiveModel, I := Fiber r.negativeModel, newFirstModel := Evaluation.positiveModel, newSecondModel := Evaluation.negativeModel]
  .Supported[K := K, J := (triple r).support, compactK := compact, compactJ := (triple r).compact]
  .With[alpha := alpha, beta := (triple r).comparison, positive := r.positive, negative := r.negative, compatible := compatible] \as Change;
\definition equation: Original.value = Evaluation.value := Change.equation;
