\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact] \as Theory;
\import Theory.BundleTriples[F := F, G := G, firstModel := firstModel, secondModel := secondModel]
  .Supported[K := K, compactK := compact].With[alpha := alpha].Enlarge[H := J, compactH := compactJ, included := included] \as Geometry;
\import \parent.\parent.\parent.Supported[K := J, compact := compactJ] \as Larger;
\definition comparison: Larger.OnOutside := Geometry.comparison;
\definition boundary[x: Larger.A]: A := \into[X](x, Base.Complement K) \by {
  \fun (inside: _) => (\bysub(X, Base.Complement J, x)) (included x inside)
};
\definition formula: \forall (x: Larger.A)(v: F x) -> (comparison.forward.fiber x).apply v = (alpha.forward.fiber (boundary x)).apply v :=
  \fun (x: Larger.A)(v: F x) => \refl((alpha.forward.fiber (boundary x)).apply v);
\import Operations.IdentityIsomorphism[X := X, F := F, bundle := source] \as PositiveIdentity;
\import Operations.IdentityIsomorphism[X := X, F := G, bundle := target] \as NegativeIdentity;
\import \parent.\parent.\parent.To[H := F, I := G, newFirstModel := firstModel, newSecondModel := secondModel]
  .Supported[K := K, J := J, compactK := compact, compactJ := compactJ] \as Change;
\definition commutes: \forall (x: \Cast[X] Change.outside)(v: F x) ->
  (comparison.forward.fiber (Change.inTarget x)).apply ((PositiveIdentity.isomorphism.forward.fiber x).apply v) =
  (NegativeIdentity.isomorphism.forward.fiber x).apply ((alpha.forward.fiber (Change.inSource x)).apply v) :=
  \fun (x: \Cast[X] Change.outside)(v: F x) => \refl((alpha.forward.fiber (Change.inSource x)).apply v);
\definition equation: value = Larger.With[alpha := comparison].value := Change.With[
  alpha := alpha, beta := comparison, positive := PositiveIdentity.isomorphism, negative := NegativeIdentity.isomorphism, commutes := commutes].equation;
