\import \parent.Input[F := F, G := G, firstModel := firstModel, secondModel := secondModel] \as First;
\import \parent.Input[F := H, G := I, firstModel := thirdModel, secondModel := fourthModel] \as Second;
\import First.Supported[K := K, compact := compact] \as FirstSupport;
\import Second.Supported[K := K, compact := compact] \as SecondSupport;
\import Operations.DirectSum[X := X, F := F, G := H, left := First.source, right := Second.source] \as Positive;
\import Operations.DirectSum[X := X, F := G, G := I, left := First.target, right := Second.target] \as Negative;
\definition PositiveFiber[x: X]: \Set := Positive.Fiber x;
\definition NegativeFiber[x: X]: \Set := Negative.Fiber x;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].BundleModel[F := PositiveFiber]
  .From[original := Positive.bundle (\refl(space)), same := (\refl(space))] \as PositiveModel;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].BundleModel[F := NegativeFiber]
  .From[original := Negative.bundle (\refl(space)), same := (\refl(space))] \as NegativeModel;
\definition positiveModel: \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].BundleModel[F := PositiveFiber].Bundle := PositiveModel.model;
\definition negativeModel: \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].BundleModel[F := NegativeFiber].Bundle := NegativeModel.model;
\import \parent.Input[F := PositiveFiber, G := NegativeFiber, firstModel := positiveModel, secondModel := negativeModel].Supported[K := K, compact := compact] \as SumInput;
\definition A: \Set := \Cast[X] (Base.Complement K);
\definition subspace: topology.Topology[Carrier := A].Topology := Base.Subspace[S := Base.Complement K].topology space;
\definition inclusion[x: A]: X := x;
\definition regular: topology.Continuity[A := A, B := X].Continuous subspace space inclusion := topology.Continuity[A := A, B := X].Corestriction[S := Base.Complement K].inclusionContinuous space;
\import Bundles.Family[X := X, F := F].Of[bundle := First.source].Restriction[U := Base.Complement K] \as P;
\import Bundles.Family[X := X, F := G].Of[bundle := First.target].Restriction[U := Base.Complement K] \as Q;
\import Bundles.Family[X := X, F := H].Of[bundle := Second.source].Restriction[U := Base.Complement K] \as R;
\import Bundles.Family[X := X, F := I].Of[bundle := Second.target].Restriction[U := Base.Complement K] \as S;
\import Positive.Of[same := (\refl(space))].Pullback[Y := A, source := subspace, f := inclusion, regular := regular] \as PositivePull;
\import Negative.Of[same := (\refl(space))].Pullback[Y := A, source := subspace, f := inclusion, regular := regular] \as NegativePull;
\import Operations.DirectSumIsomorphisms[X := A, F := (\fun (x: A) => F x), G := (\fun (x: A) => H x), A := (\fun (x: A) => G x), B := (\fun (x: A) => I x),
  first := P.restricted, second := R.restricted, newFirst := Q.restricted, newSecond := S.restricted,
  sameSource := (\refl(subspace)), sameTarget := (\refl(subspace))] \as BoundarySum;
\module With(alpha: FirstSupport.OnOutside, beta: SecondSupport.OnOutside);
