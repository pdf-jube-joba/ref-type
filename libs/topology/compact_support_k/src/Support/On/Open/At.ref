\import periodic_k_theory.Periodicity[] \as Periodic;
\import Periodic.Integer[].At[model := OriginalTheory.model, degree := degree] \as Source;
\import Periodic.Integer[].At[model := model, degree := degree] \as Target;
\import Target.Pullback[other := OriginalTheory.model, mapping := originalMapping] \as Pull;
\definition Carrier: \Set := Source.Carrier;
\definition group: std.Alg[].Alg[].CommutativeGroup[Carrier] := Source.group;
\definition extendByZero: Carrier -> Target.Carrier := Pull.map;
\definition additive: \forall (a, b: Carrier) -> extendByZero (group.base.op a b) = Target.group.base.op (extendByZero a) (extendByZero b) := Pull.additive;
\definition preservesZero: extendByZero group.base.unit = Target.group.base.unit := Pull.preservesZero;
