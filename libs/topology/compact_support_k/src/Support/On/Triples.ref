\import topology.Topology[Carrier := X] \as Base;
\import Operations.Models[X := X, baseSpace := space] \as Models;
\definition Bundle: \Set := Models.Bundle;
\definition Fiber[b: Bundle][x: X]: \Set := Models.Fiber b.ranks x;
\definition bundle[b: Bundle]: Bundles.Family[X := X, F := Fiber b].Bundle := Models.bundle b;
\module Between(p, q: Bundle, K: \Pow X);
\structure Triple: \Set := {
  positive: Bundle,
  negative: Bundle,
  support: \Pow X,
  compact: Base.IsCompactIn space support,
  comparison: Between[p := positive, q := negative, K := support].Isomorphism
};
\module Global(t: Triple);
\module Isomorphic(t, u: Triple);
\module Sum(t, u, v: Triple);
\module Homotopy(p, q: Bundle, K: \Pow X, compact: Base.IsCompactIn space K,
  first, second: \parent.Between[p := p, q := q, K := K].Isomorphism);
\module Compose(p, q, r: Bundle, K: \Pow X, compact: Base.IsCompactIn space K,
  first: \parent.Between[p := p, q := q, K := K].Isomorphism,
  second: \parent.Between[p := q, q := r, K := K].Isomorphism);
\module Group;
\module Evaluation(t: Triple);
\module IsomorphicValue(t, u: Triple, witness: \parent.Isomorphic[t := t, u := u].Witness);
\module GlobalValue(t: Triple, witness: \parent.Global[t := t].Witness);
\module SumValue(t, u, v: Triple, witness: \parent.Sum[t := t, u := u, v := v].Witness);
\module Input(F, G: X -> \Set, firstModel: \parent.\parent.BundleModel[F := F].Bundle, secondModel: \parent.\parent.BundleModel[F := G].Bundle);
