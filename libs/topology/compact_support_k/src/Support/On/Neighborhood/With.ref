\definition openSet: \Pow X := Compactification.trace w.inner;
\definition compactSet: \Pow X := Compactification.remainder (Space.Complement w.envelope);
\definition open: topology.Topology[Carrier := X].IsOpenIn space openSet := Compactification.inclusionContinuous w.inner w.innerOpen;
\definition compact: topology.Topology[Carrier := X].IsCompactIn space compactSet := w.envelopeClosed.atInfinity
  (\fun (inside: Space.Member w.envelope Compactification.point) => w.within Compactification.point inside);
\definition contains: topology.Topology[Carrier := X].Subset K openSet :=
  \fun (x: X)(inside: _) => w.contains (Compactification.inclusion x) (Maps.imageMember Compactification.inclusion K x inside);
\definition enclosed: topology.Topology[Carrier := X].Subset openSet compactSet :=
  \fun (x: X)(inside: _)(outside: _) => outside (w.enclosed (Compactification.inclusion x) inside);
