\import \parent.Of[complex := first] \as First;
\import \parent.Of[complex := second] \as Second;
\import \parent.Of[complex := third] \as Third;
\import Operations.DirectSum[X := X, F := First.Even, G := Second.Even, left := Models.bundle First.even, right := Models.bundle Second.even] \as EvenSum;
\import Operations.DirectSum[X := X, F := First.Odd, G := Second.Odd, left := Models.bundle First.odd, right := Models.bundle Second.odd] \as OddSum;
\import Bundles.Isomorphisms[X := X, F := EvenSum.Fiber, G := Third.Even, source := EvenSum.bundle (\refl(space)), target := Models.bundle Third.even] \as Positives;
\import Bundles.Isomorphisms[X := X, F := OddSum.Fiber, G := Third.Odd, source := OddSum.bundle (\refl(space)), target := Models.bundle Third.odd] \as Negatives;
\import std.Data[].Pair[] \as Product;
\structure Witness: \Set := { positive: Positives.Isomorphism, negative: Negatives.Isomorphism,
  commutesD: \forall (x: X)(v: First.Even x)(w: Second.Even x) ->
    (Third.d.fiber x).apply ((positive.forward.fiber x).apply (Product.pair (First.Even x) (Second.Even x) v w)) =
    (negative.forward.fiber x).apply (Product.pair (First.Odd x) (Second.Odd x) ((First.d.fiber x).apply v) ((Second.d.fiber x).apply w)),
  commutesE: \forall (x: X)(v: First.Odd x)(w: Second.Odd x) ->
    (Third.e.fiber x).apply ((negative.forward.fiber x).apply (Product.pair (First.Odd x) (Second.Odd x) v w)) =
    (positive.forward.fiber x).apply (Product.pair (First.Even x) (Second.Even x) ((First.e.fiber x).apply v) ((Second.e.fiber x).apply w))
};
\module With(witness: Witness);
