\import \root.Support[].CompactBundles[X := Pair.A, space := Pair.subspace, compact := Old.boundaryCompact, hausdorff := Old.boundaryHausdorff] \as Boundary;
\import Models.PullbackMap[p := even, q := odd, Y := Pair.A, source := Pair.subspace, f := Old.boundaryInclusion, regular := Old.boundaryRegular] \as D;
\import Models.PullbackMap[p := odd, q := even, Y := Pair.A, source := Pair.subspace, f := Old.boundaryInclusion, regular := Old.boundaryRegular] \as E;
\import Boundary.Acyclic[p := Old.boundaryEvenModel, q := Old.boundaryOddModel, d := D.map d, e := E.map e] \as Acyclic;
\import Bundles.Family[X := X, F := Even].Of[bundle := Models.bundle even].PullbackComposition[
  Y := OtherPair.A, Z := Pair.A, first := OtherPair.subspace, second := Pair.subspace, f := New.boundaryInclusion, g := boundary]
  .Of[fRegular := New.boundaryRegular, gRegular := boundaryRegular] \as P;
\import Bundles.Family[X := X, F := Odd].Of[bundle := Models.bundle odd].PullbackComposition[
  Y := OtherPair.A, Z := Pair.A, first := OtherPair.subspace, second := Pair.subspace, f := New.boundaryInclusion, g := boundary]
  .Of[fRegular := New.boundaryRegular, gRegular := boundaryRegular] \as Q;
\import Operations.Models[X := OtherPair.A, baseSpace := OtherPair.subspace] \as OtherModels;
\import Bundles.ArrowLaws[X := OtherPair.A, Y := OtherPair.A,
  F := (\fun (x: OtherPair.A) => Even x), G := (\fun (x: OtherPair.A) => Odd x),
  source := OtherModels.bundle New.boundaryEvenModel, target := OtherModels.bundle New.boundaryOddModel,
  f := (\fun (x: OtherPair.A) => x)].Pullback[Z := Pair.A, space := Pair.subspace, g := boundary].Of[a := c.k, regular := boundaryRegular] \as KPull;
\import Bundles.ArrowLaws[X := OtherPair.A, Y := OtherPair.A,
  F := (\fun (x: OtherPair.A) => Odd x), G := (\fun (x: OtherPair.A) => Even x),
  source := OtherModels.bundle New.boundaryOddModel, target := OtherModels.bundle New.boundaryEvenModel,
  f := (\fun (x: OtherPair.A) => x)].Pullback[Z := Pair.A, space := Pair.subspace, g := boundary].Of[a := c.h, regular := boundaryRegular] \as HPull;
\import Bundles.Morphisms[X := Pair.A, Y := Pair.A, F := (\fun (x: Pair.A) => Odd x), G := (\fun (x: Pair.A) => Odd x),
  source := Q.direct, target := Q.nested, f := (\fun (x: Pair.A) => x)]
  .Composition[Z := Pair.A, H := (\fun (x: Pair.A) => Even x), range := P.nested, g := (\fun (x: Pair.A) => x)] \as HStart;
\definition hStart: Bundles.Morphisms[X := Pair.A, Y := Pair.A, F := (\fun (x: Pair.A) => Odd x), G := (\fun (x: Pair.A) => Even x),
  source := Q.direct, target := P.nested, f := (\fun (x: Pair.A) => x)].Map := HStart.compose Q.isomorphism.forward HPull.map;
\import Bundles.Morphisms[X := Pair.A, Y := Pair.A, F := (\fun (x: Pair.A) => Odd x), G := (\fun (x: Pair.A) => Even x),
  source := Q.direct, target := P.nested, f := (\fun (x: Pair.A) => x)]
  .Composition[Z := Pair.A, H := (\fun (x: Pair.A) => Even x), range := P.direct, g := (\fun (x: Pair.A) => x)] \as HFinish;
\definition h: Boundary.Map Old.boundaryOddModel Old.boundaryEvenModel := HFinish.compose hStart P.isomorphism.backward;
\import Bundles.Morphisms[X := Pair.A, Y := Pair.A, F := (\fun (x: Pair.A) => Even x), G := (\fun (x: Pair.A) => Even x),
  source := P.direct, target := P.nested, f := (\fun (x: Pair.A) => x)]
  .Composition[Z := Pair.A, H := (\fun (x: Pair.A) => Odd x), range := Q.nested, g := (\fun (x: Pair.A) => x)] \as KStart;
\definition kStart: Bundles.Morphisms[X := Pair.A, Y := Pair.A, F := (\fun (x: Pair.A) => Even x), G := (\fun (x: Pair.A) => Odd x),
  source := P.direct, target := Q.nested, f := (\fun (x: Pair.A) => x)].Map := KStart.compose P.isomorphism.forward KPull.map;
\import Bundles.Morphisms[X := Pair.A, Y := Pair.A, F := (\fun (x: Pair.A) => Even x), G := (\fun (x: Pair.A) => Odd x),
  source := P.direct, target := Q.nested, f := (\fun (x: Pair.A) => x)]
  .Composition[Z := Pair.A, H := (\fun (x: Pair.A) => Odd x), range := Q.direct, g := (\fun (x: Pair.A) => x)] \as KFinish;
\definition k: Boundary.Map Old.boundaryEvenModel Old.boundaryOddModel := KFinish.compose kStart Q.isomorphism.backward;
\module At(x: Pair.A);
\definition contraction: Acyclic.Contraction := Acyclic.Contraction { h := h, k := k, laws := \fun (x: Pair.A) => At[x := x].laws };
\import Old.With[contraction := contraction] \as Source;
\import New.With[contraction := c] \as Target;
\import OtherPair.Mapping[Y := Local.Carrier, source := Local.topology, sourceCompact := Local.compact, sourceHausdorff := Local.separated,
  sourceSubset := Local.boundary, sourceClosed := Local.boundaryClosed, f := Geometry.map, regular := Geometry.continuous, preserves := Geometry.preserves] \as Mapping;
\import Mapping.BundleTriples[F := New.FirstFiber, G := New.SecondFiber, firstModel := New.firstOnLocal, secondModel := New.secondOnLocal] \as Pull;
\import Pull.With[alpha := Target.comparison] \as Pulled;
\import Bundles.Family[X := X, F := Even].Of[bundle := Models.bundle even].PullbackComposition[
  Y := OtherLocal.Carrier, Z := Local.Carrier, first := OtherLocal.topology, second := Local.topology, f := OtherLocal.inclusion, g := Geometry.map]
  .Of[fRegular := OtherLocal.regular, gRegular := Geometry.continuous] \as Positive;
\import Bundles.Family[X := X, F := Odd].Of[bundle := Models.bundle odd].PullbackComposition[
  Y := OtherLocal.Carrier, Z := Local.Carrier, first := OtherLocal.topology, second := Local.topology, f := OtherLocal.inclusion, g := Geometry.map]
  .Of[fRegular := OtherLocal.regular, gRegular := Geometry.continuous] \as Negative;
\import Relative.PairPullback[X := OtherLocal.Carrier, Y := Local.Carrier, F := New.FirstFiber, G := New.SecondFiber,
  first := OtherPair.BundleModel[F := New.FirstFiber].bundle New.firstOnLocal, second := OtherPair.BundleModel[F := New.SecondFiber].bundle New.secondOnLocal,
  same := (\refl(OtherLocal.topology)), source := Local.topology, subset := OtherLocal.boundary, sourceSubset := Local.boundary,
  f := Geometry.map, regular := Geometry.continuous, preserves := Geometry.preserves] \as BoundaryPull;
\definition commutes: \forall (x: Pair.A)(v: Even x) ->
  (Pulled.comparison.forward.fiber x).apply ((Positive.isomorphism.forward.fiber x).apply v) =
  (Negative.isomorphism.forward.fiber x).apply ((Source.comparison.forward.fiber x).apply v) :=
  \fun (x: Pair.A)(v: Even x) => trans!{{Odd x}} _ _ _ (BoundaryPull.With[alpha := Target.comparison].formula x v)
    (trans!{{Odd x}} _ _ _ (Target.formula (BoundaryPull.boundary x) v) (sym!{{Odd x}} _ _ (Source.formula x v)));
\import Pair.BundleTriples[F := Old.FirstFiber, G := Old.SecondFiber, firstModel := Old.firstOnLocal, secondModel := Old.secondOnLocal].To[
  H := Pull.FirstFiber, I := Pull.SecondFiber, newFirstModel := Pull.firstModelOnSource, newSecondModel := Pull.secondModelOnSource].With[
    alpha := Source.comparison, beta := Pulled.comparison, positive := Positive.isomorphism, negative := Negative.isomorphism, commutes := commutes] \as Change;
\definition localEquation: Source.localValue = Mapping.relative Target.localValue := trans!{{Pair.Quotient[].Relative}} _ _ _ Change.reducedEquation Pulled.reducedNaturality;
\definition equation: Source.value = Target.value := trans!{{Relative.Reduced[model := model].Carrier}} _ _ _
  (congr!{{Pair.Quotient[].Relative} {Relative.Reduced[model := model].Carrier}} Local.extend _ _ localEquation) (Geometry.equation Target.localValue);
