\import \parent.\parent.In[w := other] \as Other;
\import Neighbors.With[w := other] \as OtherNeighbor;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Localization[
  U := OtherNeighbor.openSet, open := OtherNeighbor.open, L := OtherNeighbor.compactSet, compactL := OtherNeighbor.compact, enclosed := OtherNeighbor.enclosed] \as OtherLocal;
\import Relative.Pair[X := OtherLocal.Carrier, space := OtherLocal.topology, compact := OtherLocal.compact, hausdorff := OtherLocal.separated,
  subset := OtherLocal.boundary, closed := OtherLocal.boundaryClosed] \as OtherPair;
\import Local.Refinement[V := OtherNeighbor.openSet, openV := OtherNeighbor.open, shrinks := shrinks, M := OtherNeighbor.compactSet,
  compactM := OtherNeighbor.compact, enclosedV := OtherNeighbor.enclosed, included := included] \as Geometry;
\definition boundary[x: Pair.A]: OtherPair.A := \into[OtherLocal.Carrier](Geometry.map x, OtherLocal.boundary) \by {
  Geometry.preserves x (\bysub(Local.Carrier, Local.boundary, x))
};
\definition boundaryRegular: topology.Continuity[A := Pair.A, B := OtherPair.A].Continuous Pair.subspace OtherPair.subspace boundary :=
  topology.Continuity[A := Pair.A, B := OtherLocal.Carrier].Corestriction[S := OtherLocal.boundary].corestrictContinuous Pair.subspace OtherLocal.topology boundary
    (topology.Composition[A := Pair.A, B := Local.Carrier, C := OtherLocal.Carrier].composeContinuous Pair.subspace Local.topology OtherLocal.topology
      boundaryLocal Geometry.map boundaryLocalRegular Geometry.continuous);
\module Using(c: Other.Contraction);
\definition equation: value = Other.value := \block {
  \takefrom c: Other.Contraction \by Other.contractions \then
  \return trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ (agreement Using[c := c].contraction)
    (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ Using[c := c].equation
      (sym!{{Relative.Reduced[model := model].Carrier}} _ _ (Other.agreement c)))
};
