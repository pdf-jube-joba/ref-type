\import Operations.ContractingPair[V := Even x, W := Odd x, even := (Models.bundle even).space x, odd := (Models.bundle odd).space x] \as Pair;
\import Spaces.Linear[V := Odd x, W := Even x, source := (Models.bundle odd).space x, target := (Models.bundle even).space x] \as HLinear;
\import Spaces.Linear[V := Even x, W := Odd x, source := (Models.bundle even).space x, target := (Models.bundle odd).space x] \as J;
\definition hSame: (c.h.fiber (boundary x)) = (h.fiber x) := HLinear.ext _ _
  (\axiom:funext((c.h.fiber (boundary x)).apply, (h.fiber x).apply, (\fun (v: Odd x) => \refl((c.h.fiber (boundary x)).apply v))));
\definition kSame: (c.k.fiber (boundary x)) = (k.fiber x) := J.ext _ _
  (\axiom:funext((c.k.fiber (boundary x)).apply, (k.fiber x).apply, (\fun (v: Even x) => \refl((c.k.fiber (boundary x)).apply v))));
\definition old: Pair.Data := Pair.Data { d := d.fiber x, e := e.fiber x, h := c.h.fiber (boundary x), k := c.k.fiber (boundary x) };
\definition current: Pair.Data := Pair.Data { d := d.fiber x, e := e.fiber x, h := h.fiber x, k := k.fiber x };
\definition same: old = current := congr!{{HLinear.Map} {J.Map} {Pair.Data}} (\fun (a: HLinear.Map)(b: J.Map) => Pair.Data { d := d.fiber x, e := e.fiber x, h := a, k := b }) _ _ _ _ hSame kSame;
\definition laws: Pair.Laws[current] := \idelim old = current \with candidate: Pair.Data => Pair.Laws[candidate] \by {
  base: c.laws (boundary x), equality: same
};
