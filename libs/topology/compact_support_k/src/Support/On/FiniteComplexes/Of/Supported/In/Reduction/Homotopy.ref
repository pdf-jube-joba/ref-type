\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := Pair.A] \as Cylinder;
\import Relative.ConstantCylinder[X := Pair.A, F := (\fun (x: Pair.A) => Even x), G := (\fun (x: Pair.A) => Odd x),
  first := Boundary.bundle boundaryEvenModel, second := Boundary.bundle boundaryOddModel, same := (\refl(Pair.subspace))] \as Constant;
\definition first: Bundles.Isomorphisms[X := Pair.A, F := (\fun (x: Pair.A) => Even x), G := (\fun (x: Pair.A) => Odd x), source := Boundary.bundle boundaryEvenModel, target := Boundary.bundle boundaryOddModel].Isomorphism := isomorphism;
\structure Family: \Set := {
  isomorphism: Bundles.Isomorphisms[X := Cylinder.Carrier, F := Constant.First, G := Constant.Second, source := Constant.firstBundle, target := Constant.secondBundle].Isomorphism,
  start: \forall (x: Pair.A)(v: Even x) -> (isomorphism.forward.fiber (Cylinder.at I.start x)).apply v = (first.forward.fiber x).apply v,
  end: \forall (x: Pair.A)(v: Even x) -> (isomorphism.forward.fiber (Cylinder.at I.end x)).apply v = (other.forward.fiber x).apply v
};
\module With(provided: Family);
