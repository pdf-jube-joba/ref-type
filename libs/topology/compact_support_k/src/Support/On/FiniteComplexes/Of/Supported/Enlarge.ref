\definition largerExact: \forall (x: \Cast[X] (Base.Complement H)) -> Chain.ExactAt x := \fun (x: \Cast[X] (Base.Complement H)) =>
  exactOutside (\into[X](x, Base.Complement K) \by { \fun (inside: _) => (\bysub(X, Base.Complement H, x)) (included x inside) });
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].FiniteComplexes[].Of[complex := complex]
  .Supported[K := H, compactK := compactH, exactOutside := largerExact] \as Larger;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Neighborhood[K := H, compact := compactH] \as LargerNeighbors;
\module With(w: LargerNeighbors.Witness);
\definition equation: value = Larger.value := \block {
  \takefrom w: LargerNeighbors.Witness \by LargerNeighbors.existence \then
  \return With[w := w].equation
};
