\import \parent.\parent.Supported[K := K, compact := compact, firstExact := firstExact, secondExact := secondExact] \as Classes;
\import First.Supported[K := K, compactK := compact, exactOutside := firstExact] \as FirstClass;
\import Second.Supported[K := K, compactK := compact, exactOutside := secondExact] \as SecondClass;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Neighborhood[K := K, compact := compact] \as Neighbors;
\module In(w: Neighbors.Witness);
\definition equation: FirstClass.value = SecondClass.value := \block {
  \takefrom w: Neighbors.Witness \by Neighbors.existence \then
  \return In[w := w].equation
};
