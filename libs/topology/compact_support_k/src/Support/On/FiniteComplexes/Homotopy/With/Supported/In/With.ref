\import Deformation.With[family := family] \as Lift;
\module Using(c: Lift.Contraction);
\definition equation: FirstClass.value = SecondClass.value := \block {
  \takefrom c: Lift.Contraction \by Lift.existence \then
  \return trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ (FirstClass.agreement w)
    (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ (Source.agreement Lift.Using[c := c].first)
      (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ Using[c := c].equation
        (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ (sym!{{Relative.Reduced[model := model].Carrier}} _ _ (Target.agreement Using[c := c].contraction))
          (sym!{{Relative.Reduced[model := model].Carrier}} _ _ (SecondClass.agreement w)))))
};
