\import Models.Pullback[b := First.odd, Y := Y, source := source, f := f, regular := regular] \as OddFirst;
\import Models.Pullback[b := Second.odd, Y := Y, source := source, f := f, regular := regular] \as OddSecond;
\import Models.Pullback[b := First.even, Y := Y, source := source, f := f, regular := regular] \as EvenFirst;
\import Models.Pullback[b := Second.even, Y := Y, source := source, f := f, regular := regular] \as EvenSecond;
\import Complements.PulledIsomorphism[X := X, Y := Y, F := First.Even, G := Second.Even, source := Models.bundle First.even, target := Models.bundle Second.even,
  base := source, f := f, sourceRegular := regular, targetRegular := regular] \as EvenPull;
\definition positive: Bundles.Isomorphisms[X := Y, F := (\fun (y: Y) => First.Even (f y)), G := (\fun (y: Y) => Second.Even (f y)),
  source := Operations.Models[X := Y, baseSpace := source].bundle EvenFirst.value, target := Operations.Models[X := Y, baseSpace := source].bundle EvenSecond.value].Isomorphism := EvenPull.isomorphism originalPositive;
\import Complements.PulledIsomorphism[X := X, Y := Y, F := First.Odd, G := Second.Odd, source := Models.bundle First.odd, target := Models.bundle Second.odd,
  base := source, f := f, sourceRegular := regular, targetRegular := regular] \as OddPull;
\definition negative: Bundles.Isomorphisms[X := Y, F := (\fun (y: Y) => First.Odd (f y)), G := (\fun (y: Y) => Second.Odd (f y)),
  source := Operations.Models[X := Y, baseSpace := source].bundle OddFirst.value, target := Operations.Models[X := Y, baseSpace := source].bundle OddSecond.value].Isomorphism := OddPull.isomorphism originalNegative;
