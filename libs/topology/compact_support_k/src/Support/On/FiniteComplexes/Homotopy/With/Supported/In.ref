\import FirstClass.In[w := w] \as Source;
\import SecondClass.In[w := w] \as Target;
\import Neighbors.With[w := w] \as Neighbor;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Localization[
  U := Neighbor.openSet, open := Neighbor.open, L := Neighbor.compactSet, compactL := Neighbor.compact, enclosed := Neighbor.enclosed] \as Local;
\import Relative.Pair[X := Local.Carrier, space := Local.topology, compact := Local.compact, hausdorff := Local.separated, subset := Local.boundary, closed := Local.boundaryClosed] \as Pair;
\import \root.Support[].CompactBundles[X := Pair.A, space := Pair.subspace, compact := Source.boundaryCompact, hausdorff := Source.boundaryHausdorff] \as Boundary;
\import Models.PullbackMap[p := First.even, q := First.odd, Y := Pair.A, source := Pair.subspace, f := Source.boundaryInclusion, regular := Source.boundaryRegular] \as D;
\import Models.PullbackMap[p := First.odd, q := First.even, Y := Pair.A, source := Pair.subspace, f := Source.boundaryInclusion, regular := Source.boundaryRegular] \as E;
\import Models.PullbackMap[p := Second.even, q := Second.odd, Y := Pair.A, source := Pair.subspace, f := Source.boundaryInclusion, regular := Source.boundaryRegular] \as D1;
\import Models.PullbackMap[p := Second.odd, q := Second.even, Y := Pair.A, source := Pair.subspace, f := Source.boundaryInclusion, regular := Source.boundaryRegular] \as E1;
\import Boundary.DifferentialHomotopy[p := Source.boundaryEvenModel, q := Source.boundaryOddModel,
  d0 := D.map First.d, e0 := E.map First.e, d1 := D.map endD, e1 := E.map endE] \as Deformation;
\definition Family: \Set := Deformation.Family;
\module With(family: Family);
