\module Supported(K: \Pow X, compact: topology.Topology[Carrier := X].IsCompactIn space K,
  firstExact: \forall (x: \Cast[X] (topology.Topology[Carrier := X].Complement K)) -> Chains.Of[complex := first].ExactAt x,
  secondExact: \forall (x: \Cast[X] (topology.Topology[Carrier := X].Complement K)) -> Chains.Of[complex := second].ExactAt x);
