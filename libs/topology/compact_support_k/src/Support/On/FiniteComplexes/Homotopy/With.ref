\definition originalPositive: Positives.Isomorphism := positive;
\definition originalNegative: Negatives.Isomorphism := negative;
\definition endD: Models.Map First.even First.odd := Models.compose First.even Second.odd First.odd
  (Models.compose First.even Second.even Second.odd positive.forward Second.d) negative.backward;
\definition endE: Models.Map First.odd First.even := Models.compose First.odd Second.even First.even
  (Models.compose First.odd Second.odd Second.even negative.forward Second.e) positive.backward;
\module Geometry(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  regular: topology.Continuity[A := Y, B := X].Continuous source space f);
\module Supported(K: \Pow X, compact: topology.Topology[Carrier := X].IsCompactIn space K,
  firstExact: \forall (x: \Cast[X] (topology.Topology[Carrier := X].Complement K)) -> Chains.Of[complex := first].ExactAt x,
  secondExact: \forall (x: \Cast[X] (topology.Topology[Carrier := X].Complement K)) -> Chains.Of[complex := second].ExactAt x);

\module Constant(commutesD: \forall (x: X)(v: First.Even x) -> (Second.d.fiber x).apply ((positive.forward.fiber x).apply v) = (negative.forward.fiber x).apply ((First.d.fiber x).apply v),
  commutesE: \forall (x: X)(v: First.Odd x) -> (Second.e.fiber x).apply ((negative.forward.fiber x).apply v) = (positive.forward.fiber x).apply ((First.e.fiber x).apply v));
