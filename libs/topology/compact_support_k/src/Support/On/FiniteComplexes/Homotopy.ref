\import \parent.Of[complex := first] \as First;
\import \parent.Of[complex := second] \as Second;
\import Bundles.Isomorphisms[X := X, F := First.Even, G := Second.Even, source := Models.bundle First.even, target := Models.bundle Second.even] \as Positives;
\import Bundles.Isomorphisms[X := X, F := First.Odd, G := Second.Odd, source := Models.bundle First.odd, target := Models.bundle Second.odd] \as Negatives;
\module With(positive: Positives.Isomorphism, negative: Negatives.Isomorphism);
