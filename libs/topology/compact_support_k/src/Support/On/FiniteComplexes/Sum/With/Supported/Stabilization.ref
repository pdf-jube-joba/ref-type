\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].FiniteComplexes[].Sum[first := first, second := second, third := third]
  .With[witness := witness].Supported[K := K, compact := compact, firstExact := firstExact, secondExact := secondExact, thirdExact := thirdExact] \as Sum;
\import algebra.Group[].Of[Carrier := Relative.Reduced[model := model].Carrier, group := Relative.Reduced[model := model].group] \as Laws;
\definition equation: ThirdClass.value = FirstClass.value := trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ (sym!{{Relative.Reduced[model := model].Carrier}} _ _ Sum.equation)
  (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _
    (congr!{{Relative.Reduced[model := model].Carrier} {Relative.Reduced[model := model].Carrier}}
      (Relative.Reduced[model := model].group.base.op FirstClass.value) _ _ SecondClass.Global[exact := exact].equation)
    (Laws.zeroRight FirstClass.value));
