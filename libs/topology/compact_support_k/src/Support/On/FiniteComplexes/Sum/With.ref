\module Geometry(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  regular: topology.Continuity[A := Y, B := X].Continuous source space f);
\import Chains.Of[complex := first] \as FirstChain;
\import Chains.Of[complex := second] \as SecondChain;
\import Chains.Of[complex := third] \as ThirdChain;
\module Supported(K: \Pow X, compact: topology.Topology[Carrier := X].IsCompactIn space K,
  firstExact: \forall (x: \Cast[X] (topology.Topology[Carrier := X].Complement K)) -> FirstChain.ExactAt x,
  secondExact: \forall (x: \Cast[X] (topology.Topology[Carrier := X].Complement K)) -> SecondChain.ExactAt x,
  thirdExact: \forall (x: \Cast[X] (topology.Topology[Carrier := X].Complement K)) -> ThirdChain.ExactAt x);
