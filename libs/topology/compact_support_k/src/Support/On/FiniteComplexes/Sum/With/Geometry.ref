\import EvenSum.Of[same := (\refl(space))].Pullback[Y := Y, source := source, f := f, regular := regular] \as EvenPull;
\import Models.Pullback[b := Third.even, Y := Y, source := source, f := f, regular := regular] \as ThirdEven;
\import Complements.PulledIsomorphism[X := X, Y := Y, F := EvenSum.Fiber, G := Third.Even,
  source := EvenSum.bundle (\refl(space)), target := Models.bundle Third.even, base := source, f := f, sourceRegular := regular, targetRegular := regular] \as EvenWitness;
\definition SourceEven[y: Y]: \Set := EvenSum.Fiber (f y);
\definition TargetEven[y: Y]: \Set := Third.Even (f y);
\definition sourceEven: Bundles.Family[X := Y, F := SourceEven].Bundle := EvenPull.secondBundle;
\definition targetEven: Bundles.Family[X := Y, F := TargetEven].Bundle := Operations.Models[X := Y, baseSpace := source].bundle ThirdEven.value;
\import Bundles.Isomorphisms[X := Y, F := SourceEven, G := SourceEven, source := EvenPull.firstBundle, target := sourceEven] \as EvenReverse;
\import Operations.IsomorphismComposition[X := Y, F := SourceEven, G := SourceEven, H := TargetEven, source := sourceEven, middle := EvenPull.firstBundle, target := targetEven] \as EvenCompose;
\definition positive: EvenCompose.Isomorphism := EvenCompose.compose (EvenReverse.inverse EvenPull.isomorphism) (EvenWitness.isomorphism witness.positive);
\definition positiveFormula: \forall (y: Y)(v: First.Even (f y))(w: Second.Even (f y)) ->
  (positive.forward.fiber y).apply (Product.pair (First.Even (f y)) (Second.Even (f y)) v w) =
  (witness.positive.forward.fiber (f y)).apply (Product.pair (First.Even (f y)) (Second.Even (f y)) v w) :=
  \fun (y: Y)(v: First.Even (f y))(w: Second.Even (f y)) => \refl(_);
\import OddSum.Of[same := (\refl(space))].Pullback[Y := Y, source := source, f := f, regular := regular] \as OddPull;
\import Models.Pullback[b := Third.odd, Y := Y, source := source, f := f, regular := regular] \as ThirdOdd;
\import Complements.PulledIsomorphism[X := X, Y := Y, F := OddSum.Fiber, G := Third.Odd,
  source := OddSum.bundle (\refl(space)), target := Models.bundle Third.odd, base := source, f := f, sourceRegular := regular, targetRegular := regular] \as OddWitness;
\definition SourceOdd[y: Y]: \Set := OddSum.Fiber (f y);
\definition TargetOdd[y: Y]: \Set := Third.Odd (f y);
\definition sourceOdd: Bundles.Family[X := Y, F := SourceOdd].Bundle := OddPull.secondBundle;
\definition targetOdd: Bundles.Family[X := Y, F := TargetOdd].Bundle := Operations.Models[X := Y, baseSpace := source].bundle ThirdOdd.value;
\import Bundles.Isomorphisms[X := Y, F := SourceOdd, G := SourceOdd, source := OddPull.firstBundle, target := sourceOdd] \as OddReverse;
\import Operations.IsomorphismComposition[X := Y, F := SourceOdd, G := SourceOdd, H := TargetOdd, source := sourceOdd, middle := OddPull.firstBundle, target := targetOdd] \as OddCompose;
\definition negative: OddCompose.Isomorphism := OddCompose.compose (OddReverse.inverse OddPull.isomorphism) (OddWitness.isomorphism witness.negative);
\definition negativeFormula: \forall (y: Y)(v: First.Odd (f y))(w: Second.Odd (f y)) ->
  (negative.forward.fiber y).apply (Product.pair (First.Odd (f y)) (Second.Odd (f y)) v w) =
  (witness.negative.forward.fiber (f y)).apply (Product.pair (First.Odd (f y)) (Second.Odd (f y)) v w) :=
  \fun (y: Y)(v: First.Odd (f y))(w: Second.Odd (f y)) => \refl(_);
