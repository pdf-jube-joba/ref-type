\definition preimage: Odd.SourceFiber x := (Odd.isomorphism.backward.fiber x).apply v;
\definition a: OriginalFirst.Odd x := Product.first (OriginalFirst.Odd x) (OriginalSecond.Odd x) preimage;
\definition b: OriginalSecond.Odd x := Product.second (OriginalFirst.Odd x) (OriginalSecond.Odd x) preimage;
\definition coordinates: (Odd.isomorphism.forward.fiber x).apply (Product.pair (OriginalFirst.Odd x) (OriginalSecond.Odd x) a b) = v :=
  trans!{{Boundary.Fiber Sum.odd x}} _ _ _
    (congr!{{Odd.SourceFiber x} {Boundary.Fiber Sum.odd x}} (Odd.isomorphism.forward.fiber x).apply _ _
      (Product.Prop[A := OriginalFirst.Odd x, B := OriginalSecond.Odd x].eta preimage))
    (Odd.isomorphism.rightInverse x v);
\definition sumFormula: (Sum.e.fiber x).apply v =
  (Even.isomorphism.forward.fiber x).apply (Product.pair (OriginalFirst.Even x) (OriginalSecond.Even x) ((OriginalFirst.e.fiber x).apply a) ((OriginalSecond.e.fiber x).apply b)) :=
  trans!{{Boundary.Fiber Sum.even x}} _ _ _
    (congr!{{Boundary.Fiber Sum.odd x} {Boundary.Fiber Sum.even x}} (Sum.e.fiber x).apply _ _ (sym!{{Boundary.Fiber Sum.odd x}} _ _ coordinates))
    (ESum.formula (E0.map OriginalFirst.e) (E1.map OriginalSecond.e) x a b);
\definition equation: ((E2.map OriginalThird.e).fiber x).apply ((negative.forward.fiber x).apply v) = (positive.forward.fiber x).apply ((Sum.e.fiber x).apply v) :=
  trans!{{OriginalThird.Even x}} _ _ _
    (congr!{{Boundary.Fiber Sum.odd x} {OriginalThird.Even x}} (\fun (z: Boundary.Fiber Sum.odd x) => (OriginalThird.e.fiber x).apply ((negative.forward.fiber x).apply z)) _ _ (sym!{{Boundary.Fiber Sum.odd x}} _ _ coordinates))
    (trans!{{OriginalThird.Even x}} _ _ _
      (congr!{{OriginalThird.Odd x} {OriginalThird.Even x}} (OriginalThird.e.fiber x).apply _ _ (negativeFormula x a b))
      (trans!{{OriginalThird.Even x}} _ _ _ (witness.commutesE x a b)
        (sym!{{OriginalThird.Even x}} _ _ (trans!{{OriginalThird.Even x}} _ _ _
          (congr!{{Boundary.Fiber Sum.even x} {OriginalThird.Even x}} (positive.forward.fiber x).apply _ _ sumFormula)
          (positiveFormula x ((OriginalFirst.e.fiber x).apply a) ((OriginalSecond.e.fiber x).apply b))))));
