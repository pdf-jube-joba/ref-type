\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].FiniteComplexes[].Of[complex := first] \as OriginalFirst;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].FiniteComplexes[].Of[complex := second] \as OriginalSecond;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].FiniteComplexes[].Of[complex := third] \as OriginalThird;
\import FirstClass.In[w := w] \as First;
\import SecondClass.In[w := w] \as Second;
\import ThirdClass.In[w := w] \as Third;
\import Neighbors.With[w := w] \as Neighbor;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Localization[
  U := Neighbor.openSet, open := Neighbor.open, L := Neighbor.compactSet, compactL := Neighbor.compact, enclosed := Neighbor.enclosed] \as Local;
\import Relative.Pair[X := Local.Carrier, space := Local.topology, compact := Local.compact, hausdorff := Local.separated,
  subset := Local.boundary, closed := Local.boundaryClosed] \as Pair;
\import \root.Support[].CompactBundles[X := Pair.A, space := Pair.subspace, compact := First.boundaryCompact, hausdorff := First.boundaryHausdorff] \as Boundary;
\module Using(c0: First.Contraction, c1: Second.Contraction);
\definition equation: Relative.Reduced[model := model].group.base.op First.value Second.value = Third.value := \block {
  \takefrom a: First.Contraction \by First.contractions \then
  \takefrom b: Second.Contraction \by Second.contractions \then
  \return Using[c0 := a, c1 := b].equation
};
