\import First.Supported[K := K, compactK := compact, exactOutside := firstExact] \as FirstClass;
\import Second.Supported[K := K, compactK := compact, exactOutside := secondExact] \as SecondClass;
\import Third.Supported[K := K, compactK := compact, exactOutside := thirdExact] \as ThirdClass;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Neighborhood[K := K, compact := compact] \as Neighbors;
\module In(w: Neighbors.Witness);
\definition equation: Relative.Reduced[model := model].group.base.op FirstClass.value SecondClass.value = ThirdClass.value := \block {
  \takefrom w: Neighbors.Witness \by Neighbors.existence \then
  \return trans!{{Relative.Reduced[model := model].Carrier}} _ _ _
    (congr!{{Relative.Reduced[model := model].Carrier} {Relative.Reduced[model := model].Carrier} {Relative.Reduced[model := model].Carrier}}
      Relative.Reduced[model := model].group.base.op _ _ _ _ (FirstClass.agreement w) (SecondClass.agreement w))
    (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ In[w := w].equation (sym!{{Relative.Reduced[model := model].Carrier}} _ _ (ThirdClass.agreement w)))
};

\module Stabilization(exact: \forall (x: X) -> SecondChain.ExactAt x);
