\definition preimage: Even.SourceFiber x := (Even.isomorphism.backward.fiber x).apply v;
\definition a: OriginalFirst.Even x := Product.first (OriginalFirst.Even x) (OriginalSecond.Even x) preimage;
\definition b: OriginalSecond.Even x := Product.second (OriginalFirst.Even x) (OriginalSecond.Even x) preimage;
\definition coordinates: (Even.isomorphism.forward.fiber x).apply (Product.pair (OriginalFirst.Even x) (OriginalSecond.Even x) a b) = v :=
  trans!{{Boundary.Fiber Sum.even x}} _ _ _
    (congr!{{Even.SourceFiber x} {Boundary.Fiber Sum.even x}} (Even.isomorphism.forward.fiber x).apply _ _
      (Product.Prop[A := OriginalFirst.Even x, B := OriginalSecond.Even x].eta preimage))
    (Even.isomorphism.rightInverse x v);
\definition sumFormula: (Sum.d.fiber x).apply v =
  (Odd.isomorphism.forward.fiber x).apply (Product.pair (OriginalFirst.Odd x) (OriginalSecond.Odd x) ((OriginalFirst.d.fiber x).apply a) ((OriginalSecond.d.fiber x).apply b)) :=
  trans!{{Boundary.Fiber Sum.odd x}} _ _ _
    (congr!{{Boundary.Fiber Sum.even x} {Boundary.Fiber Sum.odd x}} (Sum.d.fiber x).apply _ _ (sym!{{Boundary.Fiber Sum.even x}} _ _ coordinates))
    (DSum.formula (D0.map OriginalFirst.d) (D1.map OriginalSecond.d) x a b);
\definition equation: ((D2.map OriginalThird.d).fiber x).apply ((positive.forward.fiber x).apply v) = (negative.forward.fiber x).apply ((Sum.d.fiber x).apply v) :=
  trans!{{OriginalThird.Odd x}} _ _ _
    (congr!{{Boundary.Fiber Sum.even x} {OriginalThird.Odd x}} (\fun (z: Boundary.Fiber Sum.even x) => (OriginalThird.d.fiber x).apply ((positive.forward.fiber x).apply z)) _ _ (sym!{{Boundary.Fiber Sum.even x}} _ _ coordinates))
    (trans!{{OriginalThird.Odd x}} _ _ _
      (congr!{{OriginalThird.Even x} {OriginalThird.Odd x}} (OriginalThird.d.fiber x).apply _ _ (positiveFormula x a b))
      (trans!{{OriginalThird.Odd x}} _ _ _ (witness.commutesD x a b)
        (sym!{{OriginalThird.Odd x}} _ _ (trans!{{OriginalThird.Odd x}} _ _ _
          (congr!{{Boundary.Fiber Sum.odd x} {OriginalThird.Odd x}} (negative.forward.fiber x).apply _ _ sumFormula)
          (negativeFormula x ((OriginalFirst.d.fiber x).apply a) ((OriginalSecond.d.fiber x).apply b))))));
