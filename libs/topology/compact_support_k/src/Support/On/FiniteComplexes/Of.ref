\import Chains.Of[complex := complex] \as Chain;
\definition even: Models.Bundle := Chain.parity.even;
\definition odd: Models.Bundle := Chain.parity.odd;
\definition d: Models.Map even odd := Chain.parity.forward;
\definition e: Models.Map odd even := Chain.parity.backward;
\definition Even[x: X]: \Set := Models.Fiber even.ranks x;
\definition Odd[x: X]: \Set := Models.Fiber odd.ranks x;
\module Supported(K: \Pow X, compactK: topology.Topology[Carrier := X].IsCompactIn space K,
  exactOutside: \forall (x: \Cast[X] (topology.Topology[Carrier := X].Complement K)) -> Chain.ExactAt x);
