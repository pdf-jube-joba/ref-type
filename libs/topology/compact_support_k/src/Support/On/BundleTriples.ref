\import topology.Topology[Carrier := X] \as Base;
\definition first: Bundles.Family[X := X, F := F].Bundle := \parent.BundleModel[F := F].bundle firstModel;
\definition second: Bundles.Family[X := X, F := G].Bundle := \parent.BundleModel[F := G].bundle secondModel;
\module Supported(K: \Pow X, compactK: Base.IsCompactIn space K);
\module To(H, I: X -> \Set, newFirstModel: \parent.\parent.BundleModel[F := H].Bundle, newSecondModel: \parent.\parent.BundleModel[F := I].Bundle);
