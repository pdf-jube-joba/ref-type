\import Periodic.Integer[].At[model := model, degree := degree] \as Native;
\definition Carrier: \Set := Native.Carrier;
\definition group: std.Alg[].Alg[].CommutativeGroup[Carrier] := Native.group;
\definition periodicity: Periodic.Isomorphism[A := Carrier, B := Native.Next, source := group, target := Native.nextGroup].Data := Native.periodicity;
