\import topology.Maps[A := X, B := Y] \as Maps;
\definition region: \Pow X := Maps.Preimage f U;
\definition compactSet: \Pow X := Maps.Preimage f L;
\definition openRegion: topology.Topology[Carrier := X].IsOpenIn space region := continuous U open;
\definition compact: topology.Topology[Carrier := X].IsCompactIn space compactSet := proper L compactL;
\definition contained: topology.Topology[Carrier := X].Subset region compactSet := \fun (x: X)(inside: _) => enclosed (f x) inside;
\module Using(openProof: topology.Topology[Carrier := X].IsOpenIn space region,
  compactProof: topology.Topology[Carrier := X].IsCompactIn space compactSet,
  enclosedProof: topology.Topology[Carrier := X].Subset region compactSet);
