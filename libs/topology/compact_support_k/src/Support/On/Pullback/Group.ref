\import \parent.\parent.Triples[].Group[] \as Source;
\import Other.Triples[].Group[] \as Target;
\import Source.Comparison[] \as SourceComparison;
\import Target.Comparison[] \as TargetComparison;
\import Relative.Pullback[source := model, target := Other.model, f := mapping] \as Native;
\definition map[a: Target.Carrier]: Source.Carrier := SourceComparison.backward (Native.map (TargetComparison.forward a));
\definition additive: \forall (a, b: Target.Carrier) -> map (Target.add a b) = Source.add (map a) (map b) :=
  \fun (a, b: Target.Carrier) => trans!{{Source.Carrier}} _ _ _
    (congr!{{Relative.Reduced[model := model].Carrier} {Source.Carrier}} SourceComparison.backward _ _
      (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _
        (congr!{{Relative.Reduced[model := Other.model].Carrier} {Relative.Reduced[model := model].Carrier}} Native.map _ _ (TargetComparison.forwardAdd a b))
        (Native.additive (TargetComparison.forward a) (TargetComparison.forward b))))
    (SourceComparison.backwardAdd (Native.map (TargetComparison.forward a)) (Native.map (TargetComparison.forward b)));
\definition naturality: \forall (a: Target.Carrier) -> SourceComparison.forward (map a) = Native.map (TargetComparison.forward a) :=
  \fun (a: Target.Carrier) => SourceComparison.rightInverse (Native.map (TargetComparison.forward a));
