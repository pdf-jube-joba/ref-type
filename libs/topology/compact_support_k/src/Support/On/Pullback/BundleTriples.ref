\import Other.BundleTriples[F := F, G := G, firstModel := firstModel, secondModel := secondModel] \as Original;
\definition originalFirst: Bundles.Family[X := Y, F := F].Bundle := Original.first;
\definition originalSecond: Bundles.Family[X := Y, F := G].Bundle := Original.second;
\definition FirstFiber[x: X]: \Set := F (f x);
\definition SecondFiber[x: X]: \Set := G (f x);
\import Bundles.Family[X := Y, F := F].Of[bundle := originalFirst].Pullback[Y := X, source := space, f := f] \as First;
\import Bundles.Family[X := Y, F := G].Of[bundle := originalSecond].Pullback[Y := X, source := space, f := f] \as Second;
\import \parent.\parent.BundleModel[F := FirstFiber].From[original := First.pulled continuous, same := (\refl(space))] \as FirstModel;
\import \parent.\parent.BundleModel[F := SecondFiber].From[original := Second.pulled continuous, same := (\refl(space))] \as SecondModel;
\definition pulledFirstModel: \parent.\parent.BundleModel[F := FirstFiber].Bundle := FirstModel.model;
\definition pulledSecondModel: \parent.\parent.BundleModel[F := SecondFiber].Bundle := SecondModel.model;
\import \parent.\parent.BundleTriples[F := FirstFiber, G := SecondFiber, firstModel := pulledFirstModel, secondModel := pulledSecondModel] \as Pulled;
\module Supported(K: \Pow Y, compactK: topology.Topology[Carrier := Y].IsCompactIn target K);
