\import topology.Maps[A := X, B := Y] \as Maps;
\definition support: \Pow X := Maps.Preimage f K;
\definition compactSupport: topology.Topology[Carrier := X].IsCompactIn space support := proper K compactK;
\import Original.Supported[K := K, compactK := compactK] \as Target;
\import Pulled.Supported[K := support, compactK := compactSupport] \as Source;
\definition preserves: \forall (x: X) -> \In[X] Source.outside x -> \In[Y] Target.outside (f x) := \fun (x: X)(outside: _) => outside;
\import Relative.PairPullback[X := Y, Y := X, F := F, G := G, first := originalFirst, second := originalSecond, same := (\refl(target)), source := space,
  subset := Target.outside, sourceSubset := Source.outside, f := f, regular := continuous, preserves := preserves] \as Boundary;
\module With(alpha: Target.OnOutside);
