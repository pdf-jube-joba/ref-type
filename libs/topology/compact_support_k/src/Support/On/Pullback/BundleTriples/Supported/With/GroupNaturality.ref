\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Triples[] \as SourceTriples;
\import SourceTriples.Group[].Comparison[] \as SourceComparison;
\import Other.Triples[] \as TargetTriples;
\import \parent.\parent.\parent.\parent.Group[] \as Pull;
\import SourceTriples.Input[F := FirstFiber, G := SecondFiber, firstModel := pulledFirstModel, secondModel := pulledSecondModel]
  .Supported[K := support, compact := compactSupport].With[alpha := comparison] \as SourceInput;
\import TargetTriples.Input[F := F, G := G, firstModel := firstModel, secondModel := secondModel]
  .Supported[K := K, compact := compactK].With[alpha := alpha] \as TargetInput;
\import Relative.Pullback[source := model, target := Other.model, f := mapping] \as Native;
\definition equation: SourceInput.value = Pull.map TargetInput.value := SourceComparison.detectsEquality SourceInput.value (Pull.map TargetInput.value)
  (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ SourceInput.Comparison[].equation
    (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ naturality
      (trans!{{Relative.Reduced[model := model].Carrier}} _ _ _
        (congr!{{Relative.Reduced[model := Other.model].Carrier} {Relative.Reduced[model := model].Carrier}} Native.map _ _ (sym!{{Relative.Reduced[model := Other.model].Carrier}} _ _ TargetInput.Comparison[].equation))
        (sym!{{Relative.Reduced[model := model].Carrier}} _ _ (Pull.naturality TargetInput.value)))));
