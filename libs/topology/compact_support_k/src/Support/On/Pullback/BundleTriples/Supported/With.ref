\import Target.With[alpha := alpha] \as TargetClass;
\definition comparison: Source.OnOutside := Boundary.With[alpha := alpha].comparison;
\import Source.With[alpha := comparison] \as SourceClass;
\module Naturality(n: TargetClass.Neighborhood);
\definition naturality: SourceClass.value = Relative.Pullback[source := model, target := Other.model, f := mapping].map TargetClass.value := \block {
  \takefrom n: TargetClass.Neighborhood \by TargetClass.neighborhoods \then
  \return Naturality[n := n].equation
};
