\definition equation: \forall (x: DomainPair.A)(v: SourceLocal.FirstFiber x) ->
  (LocalClass.comparison.forward.fiber x).apply ((Positive.isomorphism.forward.fiber x).apply v) =
  (Negative.isomorphism.forward.fiber x).apply ((SourceLocal.comparison.forward.fiber x).apply v) :=
  \fun (x: DomainPair.A)(v: SourceLocal.FirstFiber x) => trans!{{G (f x)}} _ _ _ (LocalBoundary.With[alpha := TargetLocal.comparison].formula x v)
    (trans!{{G (f x)}} _ _ _ (TargetLocal.formula (LocalBoundary.boundary x) v)
      (trans!{{G (f x)}} _ _ _
        (sym!{{G (f x)}} _ _ (Boundary.With[alpha := alpha].formula (\into[X](x, Source.outside) \by { \fun (inside: _) => (\bysub(DomainLocal.Carrier, DomainLocal.boundary, x)) (n.contains (f x) inside) }) v))
        (sym!{{G (f x)}} _ _ (SourceLocal.formula x v))));
