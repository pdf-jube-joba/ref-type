\import Original.Supported[K := K, compactK := compactK] \as Source;
\import Changed.Supported[K := J, compactK := compactJ] \as Target;
\definition joint: \Pow X := Base.Finite[].Join K J;
\definition compactJoint: Base.IsCompactIn space joint := Base.Compactness[].joinCompact space K J compactK compactJ;
\definition outsideJoint: \Pow X := Base.Complement joint;
\definition inSource[x: \Cast[X] outsideJoint]: \Cast[X] Source.outside := \into[X](x, Source.outside) \by {
  \fun (inside: _) => (\bysub(X, outsideJoint, x)) (Logic.Or[_, _]::left inside)
};
\definition inTarget[x: \Cast[X] outsideJoint]: \Cast[X] Target.outside := \into[X](x, Target.outside) \by {
  \fun (inside: _) => (\bysub(X, outsideJoint, x)) (Logic.Or[_, _]::right inside)
};
\module With(alpha: Source.OnOutside, beta: Target.OnOutside, positive: Positive.Isomorphism, negative: Negative.Isomorphism,
  compatible: \forall (x: \Cast[X] outsideJoint)(v: F x) ->
    (beta.forward.fiber (inTarget x)).apply ((positive.forward.fiber x).apply v) = (negative.forward.fiber x).apply ((alpha.forward.fiber (inSource x)).apply v));
