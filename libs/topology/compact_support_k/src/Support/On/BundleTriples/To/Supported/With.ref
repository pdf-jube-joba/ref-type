\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Symbols[] \as Symbols;
\import Source.With[alpha := alpha] \as SourceClass;
\import Target.With[alpha := beta] \as TargetClass;
\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact].Neighborhood[K := joint, compact := compactJoint] \as Neighbors;
\module In(w: Neighbors.Witness);
\definition equation: SourceClass.value = TargetClass.value := \block {
  \takefrom w: Neighbors.Witness \by Neighbors.existence \then
  \return In[w := w].equation
};
\definition symbolEquation: SourceClass.symbol = TargetClass.symbol := congr!{{Relative.Reduced[model := model].Carrier} {Symbols.Carrier}} Symbols.backward _ _ equation;
