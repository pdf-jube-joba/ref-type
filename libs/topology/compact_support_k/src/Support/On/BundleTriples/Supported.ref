\definition outside: \Pow X := Base.Complement K;
\import Bundles.Family[X := X, F := F].Of[bundle := first].Restriction[U := outside] \as Positive;
\import Bundles.Family[X := X, F := G].Of[bundle := second].Restriction[U := outside] \as Negative;
\definition OnOutside: \Set := Bundles.Isomorphisms[X := \Cast[X] outside, F := (\fun (x: \Cast[X] outside) => F x), G := (\fun (x: \Cast[X] outside) => G x),
  source := Positive.restricted, target := Negative.restricted].Isomorphism;
\module With(alpha: OnOutside);
