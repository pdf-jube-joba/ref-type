\import \root.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact]
  .BundleTriples[F := F, G := G, firstModel := firstModel, secondModel := secondModel].Supported[K := K, compactK := compactK].With[alpha := alpha] \as Original;
\definition neighborhood: Neighborhood := Neighborhood {
  region := U, compactSet := L, openRegion := openU, compact := compactL, contains := containsK, enclosed := enclosedU
};
\definition shrinks: Base.Subset U neighborhood.region := \fun (x: X)(inside: \In[X] U x) => inside;
\definition included: Base.Subset neighborhood.compactSet L := \fun (x: X)(inside: \In[X] neighborhood.compactSet x) => inside;
\import Original.In[n := neighborhood].Direct[V := U, openV := openU, M := L, compactM := compactL, enclosedV := enclosedU,
  containsV := containsK, shrinks := shrinks, included := included] \as Comparison;
\definition equation: Original.value = value := trans!{{Relative.Reduced[model := model].Carrier}} _ _ _ (Original.agreement neighborhood) Comparison.equation;
