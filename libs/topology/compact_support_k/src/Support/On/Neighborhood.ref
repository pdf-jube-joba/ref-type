\import topology.Topology[Carrier := Compactification.Carrier] \as Space;
\import topology.Maps[A := X, B := Compactification.Carrier] \as Maps;
\definition image: \Pow Compactification.Carrier := Maps.Image Compactification.inclusion K;
\definition imageCompact: Space.IsCompactIn Compactification.topology image :=
  topology.Compactness[A := X, B := Compactification.Carrier].continuousImage space Compactification.topology Compactification.inclusion Compactification.inclusionContinuous K compact;
\definition imageClosed: Space.IsClosedIn Compactification.topology image :=
  Space.Compactness[].compactClosed Compactification.topology Separation.hausdorffCompactification image imageCompact;
\definition finitePart: \Pow Compactification.Carrier := Compactification.lift (topology.Topology[Carrier := X].Whole);
\definition included: Space.Subset image finitePart := \fun (p: _)(member: _) => Maps.imageElim Compactification.inclusion K p (Space.Member finitePart p)
  (\fun (x: X)(_: _)(same: Compactification.inclusion x = p) => \idelim Compactification.inclusion x = p
    \with q: Compactification.Carrier => Space.Member finitePart q \by { base: \refl(x), equality: same }) member;
\definition Witness: \Set := Space.Urysohn[].ShrinkData[Compactification.topology, image, finitePart];
\definition existence: \exists Witness := Space.Urysohn[].shrink Compactification.topology
  (Space.Compactness[].compactHausdorffNormal Compactification.topology Compactness.compact Separation.hausdorffCompactification)
  image finitePart imageClosed (Compactification.liftOpen (topology.Topology[Carrier := X].Whole) (topology.Topology[Carrier := X].topologyLaws space).wholeOpen) included;
\module With(w: Witness);
