\definition composite[x: A]: C := g (f x);
\definition continuous: topology.Continuity[A := A, B := C].Continuous firstSpace lastSpace composite :=
  topology.Composition[A := A, B := B, C := C].composeContinuous firstSpace middleSpace lastSpace f g firstContinuous secondContinuous;
\import topology.Topology[Carrier := A] \as Base;
\definition proper: \root.Support[].Proper[A := A, B := C, source := firstSpace, target := lastSpace].IsProper composite :=
  \fun (K: _)(compact: _) => \idelim topology.Maps[A := A, B := B].Preimage f (topology.Maps[A := B, B := C].Preimage g K) = topology.Maps[A := A, B := C].Preimage composite K
    \with L: \Pow A => Base.IsCompactIn firstSpace L \by {
      base: firstProper (topology.Maps[A := B, B := C].Preimage g K) (secondProper K compact),
      equality: \axiom:setext(topology.Maps[A := A, B := B].Preimage f (topology.Maps[A := B, B := C].Preimage g K), topology.Maps[A := A, B := C].Preimage composite K,
        \fun (x: A)(h: _) => h, \fun (x: A)(h: _) => h)
    };
\import \root.Support[].OnePoint[X := A, space := firstSpace] \as Domain;
\import \root.Support[].Proper[A := A, B := B, source := firstSpace, target := middleSpace].With[f := f, continuous := firstContinuous, proper := firstProper] \as First;
\import \root.Support[].Proper[A := B, B := C, source := middleSpace, target := lastSpace].With[f := g, continuous := secondContinuous, proper := secondProper] \as Second;
\import \root.Support[].Proper[A := A, B := C, source := firstSpace, target := lastSpace].With[f := composite, continuous := continuous, proper := proper] \as Direct;
\definition extensionComposition: \forall (p: Domain.Carrier) -> Direct.extension p = Second.extension (First.extension p) :=
  \induction (p: Domain.Carrier) \return Direct.extension p = Second.extension (First.extension p) \with {
    | none: \refl(Option.Option[C]::none) | some: \fun (x: A) => \refl(Option.Option[C]::some (g (f x)))
  };
