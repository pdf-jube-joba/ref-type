\import relative_k_theory.Relative[] \as Relative;
\import Relative.DiskPair[X := X, space := space, compact := compact, hausdorff := hausdorff, p := p] \as Native;
\import \root.Support[].ClosedPair[M := Native.Disk, space := Native.topology, compact := Native.compactDisk, hausdorff := Native.hausdorffDisk,
  subset := Native.boundary, closed := Native.boundaryClosed] \as Pair;
\definition Interior: \Set := Pair.Interior;
\definition topology: topology.Topology[Carrier := Interior].Topology := Pair.interiorTopology;
\definition locallyCompact: topology.LocallyCompact[A := Interior].IsLocallyCompact topology := Pair.interiorLocallyCompact;
\definition hausdorff: topology.Topology[Carrier := Interior].IsT2 topology := Pair.interiorHausdorff;
\definition compactification: Relative.CompactPointed := Pair.model;
\definition quotientEquivalence: Relative.Equivalence[source := Native.quotientModel, target := compactification].Data := Pair.equivalence;
\module At(degree: std.Arithmetic[].Int[].Int^) {
  \import Pair.At[degree := degree] \as Compare;
  \import periodic_k_theory.Periodicity[].Integer[].At[model := Native.quotientModel, degree := degree] \as RelativeDegree;
  \import periodic_k_theory.Periodicity[].Integer[].At[model := compactification, degree := degree] \as SupportedDegree;
  \definition Carrier: \Set := SupportedDegree.Carrier;
  \definition toRelative: Carrier -> RelativeDegree.Carrier := Compare.fromCompactSupport;
  \definition fromRelative: RelativeDegree.Carrier -> Carrier := Compare.toCompactSupport;
  \definition leftInverse: \forall (q: Carrier) -> fromRelative (toRelative q) = q := Compare.leftInverse;
  \definition rightInverse: \forall (q: RelativeDegree.Carrier) -> toRelative (fromRelative q) = q := Compare.rightInverse;
}
