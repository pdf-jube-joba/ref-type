\import relative_k_theory.Relative[] \as Relative;
\import periodic_k_theory.Periodicity[] \as Periodic;
\import \root.Support[].OnePoint[X := X, space := space] \as Compactification;
\import Compactification.Compactness[] \as Compactness;
\import Compactification.Separation[hausdorff := hausdorff, locallyCompact := locallyCompact] \as Separation;
\definition model: Relative.CompactPointed := Relative.pack Compactification.Carrier (Relative.PointedDetails[Compactification.Carrier] {
  topology := Compactification.topology, compact := Compactness.compact, hausdorff := Separation.hausdorffCompactification,
  point := Compactification.point
});
\module At(degree: std.Arithmetic[].Int[].Int^);
\module Pullback(Y: \Set, target: topology.Topology[Carrier := Y].Topology,
  targetHausdorff: topology.Topology[Carrier := Y].IsT2 target,
  targetLocallyCompact: topology.LocallyCompact[A := Y].IsLocallyCompact target,
  f: X -> Y, continuous: topology.Continuity[A := X, B := Y].Continuous space target f,
  proper: \root.Support[].Proper[A := X, B := Y, source := space, target := target].IsProper f);
\module Symbols;
\module Open(U: \Pow X, open: topology.Topology[Carrier := X].IsOpenIn space U);
\module Product(Y: \Set, otherSpace: topology.Topology[Carrier := Y].Topology,
  otherHausdorff: topology.Topology[Carrier := Y].IsT2 otherSpace,
  otherLocallyCompact: topology.LocallyCompact[A := Y].IsLocallyCompact otherSpace);
\module Neighborhood(K: \Pow X, compact: topology.Topology[Carrier := X].IsCompactIn space K);
