\import complex.Complex[] \as C;
\import linear_algebra.Hermitian[].Complex[] \as Hermitian;
\import vector_bundles.Bundles[].Complex[] \as Scalar;
\import bundle_operations.Operations[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := Hermitian.scalar, scalar := Scalar.scalar]
  .Models[X := Point, baseSpace := PointSpace.Discrete] \as Models;
\import Models.Chains[] \as Chains;
\import Chains.ZeroStrings[] \as ZeroChains;
\definition line: Models.Bundle := Models.Trivial[n := one].value;
\definition diagram: ZeroChains.Data := ZeroChains.Data::cons line (ZeroChains.Data::cons line (ZeroChains.Data::cons line ZeroChains.Data::nil));
\definition complex: K.FiniteComplexes[].Complex := ZeroChains.complex diagram;
\import Chains.Of[complex := complex] \as Of;
\definition exactOutside: \forall (x: \Cast[Point] (PointSpace.Complement PointSpace.Whole)) -> Of.ExactAt x :=
  \fun (x: \Cast[Point] (PointSpace.Complement PointSpace.Whole)) => Logic.falseElim _ ((\bysub(Point, PointSpace.Complement PointSpace.Whole, x)) (\refl(x)));
\import K.FiniteComplexes[].Of[complex := complex].Supported[K := PointSpace.Whole, compactK := Finite.compact, exactOutside := exactOutside] \as Supported;
\definition value: relative_k_theory.Relative[].Reduced[model := K.model].Carrier := Supported.value;
