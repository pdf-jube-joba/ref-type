\import complex.Complex[] \as C;
\import linear_algebra.Hermitian[].Complex[] \as Hermitian;
\import vector_bundles.Bundles[].Complex[] \as Scalar;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := Hermitian.scalar, scalar := Scalar.scalar] \as Bundles;
\import bundle_operations.Operations[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := Hermitian.scalar, scalar := Scalar.scalar] \as Operations;
\import Bundles.Trivial[X := Point, n := n, baseSpace := PointSpace.Discrete] \as Trivial;
\definition Fiber[x: Point]: \Set := Bundles.Vector n;
\import K.BundleModel[F := Fiber].From[original := Trivial.bundle, same := (\refl(PointSpace.Discrete))] \as Model;
\import K.BundleTriples[F := Fiber, G := Fiber, firstModel := Model.model, secondModel := Model.model].Supported[K := PointSpace.Empty, compactK := PointSpace.Compactness[].emptyCompact PointSpace.Discrete] \as Supported;
\import Bundles.Family[X := Point, F := Fiber].Of[bundle := Trivial.bundle].Restriction[U := Supported.outside] \as Outside;
\import Operations.IdentityIsomorphism[X := \Cast[Point] Supported.outside, F := (\fun (x: \Cast[Point] Supported.outside) => Fiber x), bundle := Outside.restricted] \as Identity;
\import Supported.With[alpha := Identity.isomorphism] \as Class;
\definition small: Class.Neighborhood := Class.Neighborhood {
  region := PointSpace.Empty, compactSet := PointSpace.Empty,
  openRegion := (PointSpace.topologyLaws PointSpace.Discrete).emptyOpen,
  compact := PointSpace.Compactness[].emptyCompact PointSpace.Discrete,
  contains := \fun (x: Point)(empty: _) => empty,
  enclosed := \fun (x: Point)(empty: _) => empty
};
\definition large: Class.Neighborhood := Class.Neighborhood {
  region := PointSpace.Whole, compactSet := PointSpace.Whole,
  openRegion := (PointSpace.topologyLaws PointSpace.Discrete).wholeOpen,
  compact := Finite.compact,
  contains := \fun (x: Point)(empty: _) => \refl(x),
  enclosed := \fun (x: Point)(inside: _) => inside
};
\definition symbol: K.Symbols[].Carrier := Class.symbol;
\definition independent: Class.In[n := small].value = Class.In[n := large].value := Class.Choices[n := small, m := large].equation;

\import K.Triples[].Input[F := Fiber, G := Fiber, firstModel := Model.model, secondModel := Model.model]
  .Supported[K := PointSpace.Empty, compact := PointSpace.Compactness[].emptyCompact PointSpace.Discrete].With[alpha := Identity.isomorphism] \as SourceInput;
\definition sourceClass: K.Triples[].Group[].Carrier := SourceInput.value;
\definition sourceComparison: K.Triples[].Group[].ToK[].map sourceClass = Class.value := SourceInput.Comparison[].equation;
