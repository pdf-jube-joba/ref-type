\definition identity[x: X]: X := x;
\definition continuous: topology.Continuity[A := X, B := X].Continuous space space identity := topology.Maps[A := X, B := X].Identity[].continuous space;
\import topology.Topology[Carrier := X] \as Base;
\definition proper: \root.Support[].Proper[A := X, B := X, source := space, target := space].IsProper identity :=
  \fun (K: _)(compact: _) => \idelim K = topology.Maps[A := X, B := X].Preimage identity K
    \with L: \Pow X => Base.IsCompactIn space L \by { base: compact,
      equality: \axiom:setext(K, topology.Maps[A := X, B := X].Preimage identity K,
        \fun (x: X)(h: _) => h, \fun (x: X)(h: _) => h) };
\import \root.Support[].OnePoint[X := X, space := space] \as Plus;
\import \root.Support[].Proper[A := X, B := X, source := space, target := space].With[f := identity, continuous := continuous, proper := proper] \as Extended;
\definition extensionIdentity: \forall (p: Plus.Carrier) -> Extended.extension p = p :=
  \induction (p: Plus.Carrier) \return Extended.extension p = p \with {
    | none: \refl(Plus.point) | some: \fun (x: X) => \refl(Plus.inclusion x)
  };
