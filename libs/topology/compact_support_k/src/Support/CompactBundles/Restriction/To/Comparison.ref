\import Bundles.Family[X := X, F := Models.Fiber b.ranks].Of[bundle := Models.bundle b].PullbackComposition[
  Y := Point, Z := Target.Point, first := topology, second := Target.topology, f := inclusion, g := into]
  .Of[fRegular := regular, gRegular := continuous] \as Native;
\definition direct: Bundles.Family[X := Target.Point, F := Target.Fiber b].Bundle := Native.direct;
\definition nested: Bundles.Family[X := Target.Point, F := Target.Fiber b].Bundle := Native.nested;
\definition isomorphism: Bundles.Isomorphisms[X := Target.Point, F := Target.Fiber b, G := Target.Fiber b, source := direct, target := nested].Isomorphism := Native.isomorphism;
