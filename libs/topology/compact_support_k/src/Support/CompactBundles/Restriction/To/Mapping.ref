\import \parent.Comparison[b := p] \as Source;
\import \parent.Comparison[b := q] \as Range;
\import Bundles.ArrowLaws[X := Point, Y := Point, F := Fiber p, G := Fiber q, source := bundle p, target := bundle q,
  f := (\fun (x: Point) => x)].Pullback[Z := Target.Point, space := Target.topology, g := into] \as Pull;
\import Bundles.Morphisms[X := Target.Point, Y := Target.Point, F := Target.Fiber p, G := Target.Fiber p,
  source := Target.bundle p, target := Source.nested, f := (\fun (y: Target.Point) => y)]
  .Composition[Z := Target.Point, H := Target.Fiber q, range := Range.nested, g := (\fun (y: Target.Point) => y)] \as First;
\definition start[a: Map p q]: Bundles.Morphisms[X := Target.Point, Y := Target.Point, F := Target.Fiber p, G := Target.Fiber q,
  source := Target.bundle p, target := Range.nested, f := (\fun (y: Target.Point) => y)].Map :=
  First.compose Source.isomorphism.forward Pull.Of[a := a, regular := continuous].map;
\import Bundles.Morphisms[X := Target.Point, Y := Target.Point, F := Target.Fiber p, G := Target.Fiber q,
  source := Target.bundle p, target := Range.nested, f := (\fun (y: Target.Point) => y)]
  .Composition[Z := Target.Point, H := Target.Fiber q, range := Target.bundle q, g := (\fun (y: Target.Point) => y)] \as Second;
\definition map[a: Map p q]: Target.Map p q := Second.compose (start a) Range.isomorphism.backward;
\definition formula: \forall (a: Map p q)(y: Target.Point)(v: Target.Fiber p y) -> ((map a).fiber y).apply v = (a.fiber (into y)).apply v :=
  \fun (a: Map p q)(y: Target.Point)(v: Target.Fiber p y) => \refl((a.fiber (into y)).apply v);
