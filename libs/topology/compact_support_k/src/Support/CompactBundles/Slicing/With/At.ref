\import Mapping.Slice[t := time] \as Slice;
\import Bundles.Family[X := X, F := Fiber p].Of[bundle := bundle p].PullbackIdentity[] \as P;
\import Bundles.Family[X := X, F := Fiber q].Of[bundle := bundle q].PullbackIdentity[] \as Q;
\import Bundles.Morphisms[X := X, Y := X, F := Fiber p, G := Fiber p, source := bundle p, target := Slice.sourceBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Fiber q, range := Slice.targetBundle, g := (\fun (x: X) => x)] \as Start;
\definition start: Bundles.Morphisms[X := X, Y := X, F := Fiber p, G := Fiber q, source := bundle p, target := Slice.targetBundle, f := (\fun (x: X) => x)].Map :=
  Start.compose P.forward Slice.value;
\import Bundles.Morphisms[X := X, Y := X, F := Fiber p, G := Fiber q, source := bundle p, target := Slice.targetBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Fiber q, range := bundle q, g := (\fun (x: X) => x)] \as Finish;
\definition value: Map p q := Finish.compose start Q.backward;
\definition formula: \forall (x: X)(v: Fiber p x) -> (value.fiber x).apply v = (map.fiber (Cylinder.at time x)).apply v := \fun (x: X)(v: Fiber p x) => \refl(_);
