\import Bundles.Morphisms[X := X, Y := X, F := Fiber s, G := Fiber q, source := bundle s, target := bundle q, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Fiber p, range := bundle p, g := (\fun (x: X) => x)] \as HStart;
\definition hStart: Map s p := HStart.compose negative.backward c.h;
\import Bundles.Morphisms[X := X, Y := X, F := Fiber s, G := Fiber p, source := bundle s, target := bundle p, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Fiber r, range := bundle r, g := (\fun (x: X) => x)] \as HFinish;
\definition h: Map s r := HFinish.compose hStart positive.forward;
\import Bundles.Morphisms[X := X, Y := X, F := Fiber r, G := Fiber p, source := bundle r, target := bundle p, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Fiber q, range := bundle q, g := (\fun (x: X) => x)] \as KStart;
\definition kStart: Map r q := KStart.compose positive.backward c.k;
\import Bundles.Morphisms[X := X, Y := X, F := Fiber r, G := Fiber q, source := bundle r, target := bundle q, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Fiber s, range := bundle s, g := (\fun (x: X) => x)] \as KFinish;
\definition k: Map r s := KFinish.compose kStart negative.forward;
\module At(x: X);
\definition contraction: Target.Contraction := Target.Contraction { h := h, k := k, laws := \fun (x: X) => At[x := x].laws };
\import Source.Normalized[c := c] \as Original;
\import Target.Normalized[c := contraction] \as Normal;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Fiber r, G := Fiber s, source := bundle r, target := bundle s].Isomorphism := Normal.isomorphism;
\definition forwardFormula: \forall (x: X)(v: Fiber p x) ->
  (isomorphism.forward.fiber x).apply ((positive.forward.fiber x).apply v) = (negative.forward.fiber x).apply ((Original.isomorphism.forward.fiber x).apply v) :=
  \fun (x: X)(v: Fiber p x) => At[x := x].forwardFormula v;
