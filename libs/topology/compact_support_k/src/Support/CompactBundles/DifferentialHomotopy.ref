\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := X] \as Cylinder;
\definition cylinderSpace: topology.Topology[Carrier := Cylinder.Carrier].Topology := Cylinder.topology space;
\import Models.Pullback[b := p, Y := Cylinder.Carrier, source := cylinderSpace, f := Cylinder.point, regular := (Cylinder.pointContinuous space)] \as P;
\import Models.Pullback[b := q, Y := Cylinder.Carrier, source := cylinderSpace, f := Cylinder.point, regular := (Cylinder.pointContinuous space)] \as Q;
\import Operations.Models[X := Cylinder.Carrier, baseSpace := cylinderSpace] \as CylinderModels;
\structure Family: \Set := { d: CylinderModels.Map P.value Q.value, e: CylinderModels.Map Q.value P.value,
  exact: \forall (z: Cylinder.Carrier) -> Operations.AcyclicCoordinates[n := p.ranks (Cylinder.point z), m := q.ranks (Cylinder.point z), d := d.fiber z, e := e.fiber z].Exact,
  startD: \forall (x: X)(v: Fiber p x) -> (d.fiber (Cylinder.at I.start x)).apply v = (d0.fiber x).apply v,
  startE: \forall (x: X)(v: Fiber q x) -> (e.fiber (Cylinder.at I.start x)).apply v = (e0.fiber x).apply v,
  endD: \forall (x: X)(v: Fiber p x) -> (d.fiber (Cylinder.at I.end x)).apply v = (d1.fiber x).apply v,
  endE: \forall (x: X)(v: Fiber q x) -> (e.fiber (Cylinder.at I.end x)).apply v = (e1.fiber x).apply v
};
\module With(family: Family);
