\import Operations.ContractingPair[V := Fiber p (Cylinder.point z), W := Fiber q (Cylinder.point z), even := (bundle p).space (Cylinder.point z), odd := (bundle q).space (Cylinder.point z)] \as Pair;
\import Pair.Sums[d := d.fiber (Cylinder.point z), e := e.fiber (Cylinder.point z)] \as Sums;
\definition left: Sums.Candidate := Sums.Candidate { h := first.h.fiber (Cylinder.point z), k := first.k.fiber (Cylinder.point z) };
\definition right: Sums.Candidate := Sums.Candidate { h := second.h.fiber (Cylinder.point z), k := second.k.fiber (Cylinder.point z) };
\definition balanced: Sums.Balance[Sums.Candidate { h := h.fiber z, k := k.fiber z },Algebra.field.add (s z) (t z)] :=
  Sums.plusBalance (Sums.scale (s z) left) (Sums.scale (t z) right) (s z) (t z)
    (Sums.scaleContraction (s z) left (first.laws (Cylinder.point z))) (Sums.scaleContraction (t z) right (second.laws (Cylinder.point z)));
\definition laws: Pair.Laws[Pair.Data { d := d.fiber (Cylinder.point z), e := e.fiber (Cylinder.point z), h := h.fiber z, k := k.fiber z }] :=
  Pair.Laws[Pair.Data { d := d.fiber (Cylinder.point z), e := e.fiber (Cylinder.point z), h := h.fiber z, k := k.fiber z }] {
    squareEven := (first.laws (Cylinder.point z)).squareEven, squareOdd := (first.laws (Cylinder.point z)).squareOdd,
    even := \fun (v: Fiber p (Cylinder.point z)) => trans!{{Fiber p (Cylinder.point z)}} _ _ _ (balanced.even v)
      (trans!{{Fiber p (Cylinder.point z)}} _ _ _
        (congr!{{C.Complex} {Fiber p (Cylinder.point z)}} (\fun (a: C.Complex) => ((bundle p).space (Cylinder.point z)).smul a v) _ _ (total z))
        (((bundle p).space (Cylinder.point z)).scalarOne v)),
    odd := \fun (w: Fiber q (Cylinder.point z)) => trans!{{Fiber q (Cylinder.point z)}} _ _ _ (balanced.odd w)
      (trans!{{Fiber q (Cylinder.point z)}} _ _ _
        (congr!{{C.Complex} {Fiber q (Cylinder.point z)}} (\fun (a: C.Complex) => ((bundle q).space (Cylinder.point z)).smul a w) _ _ (total z))
        (((bundle q).space (Cylinder.point z)).scalarOne w))
  };
