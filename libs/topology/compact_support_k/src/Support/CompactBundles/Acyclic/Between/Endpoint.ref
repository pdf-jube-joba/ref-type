\definition tStart: t (Cylinder.at I.start x) = Algebra.field.zero := Hermitian.scalar.embedZero;
\definition tEnd: t (Cylinder.at I.end x) = Algebra.field.one := Hermitian.scalar.embedOne;
\definition sStart: s (Cylinder.at I.start x) = Algebra.field.one := trans!{{C.Complex}} _ _ _
  (congr!{{C.Complex} {C.Complex}} (\fun (a: C.Complex) => Algebra.field.add Algebra.field.one (Algebra.field.neg a)) _ _ tStart)
  (trans!{{C.Complex}} _ _ _ (congr!{{C.Complex} {C.Complex}} (Algebra.field.add Algebra.field.one) _ _ Scalars.negZero) (Scalars.zeroRight Algebra.field.one));
\definition sEnd: s (Cylinder.at I.end x) = Algebra.field.zero := trans!{{C.Complex}} _ _ _
  (congr!{{C.Complex} {C.Complex}} (\fun (a: C.Complex) => Algebra.field.add Algebra.field.one (Algebra.field.neg a)) _ _ tEnd) (Scalars.inverseRight Algebra.field.one);
\import Spaces.Laws[V := Fiber q x, space := (bundle q).space x] \as Odd;
\definition kStart: \forall (v: Fiber p x) -> (k.fiber (Cylinder.at I.start x)).apply v = (first.k.fiber x).apply v :=
  \fun (v: Fiber p x) => trans!{{Fiber q x}} _ _ _
    (congr!{{C.Complex} {C.Complex} {Fiber q x}} (\fun (a, b: C.Complex) => ((bundle q).space x).add
      (((bundle q).space x).smul a ((first.k.fiber x).apply v)) (((bundle q).space x).smul b ((second.k.fiber x).apply v))) _ _ _ _ sStart tStart)
    (trans!{{Fiber q x}} _ _ _
      (congr!{{Fiber q x} {Fiber q x} {Fiber q x}} ((bundle q).space x).add _ _ _ _ (((bundle q).space x).scalarOne ((first.k.fiber x).apply v)) (Odd.zeroScale ((second.k.fiber x).apply v)))
      (Odd.zeroRight ((first.k.fiber x).apply v)));
\definition start: \forall (v: Fiber p x) -> (isomorphism.forward.fiber (Cylinder.at I.start x)).apply v = (First.forward.fiber x).apply v :=
  \fun (v: Fiber p x) => congr!{{Fiber q x} {Fiber q x}} (((bundle q).space x).add ((d.fiber x).apply v)) _ _
    (trans!{{Fiber q x}} _ _ _
      (congr!{{Fiber q x} {Fiber q x}} (\fun (w: Fiber q x) => (k.fiber (Cylinder.at I.start x)).apply ((e.fiber x).apply w)) _ _ (kStart v))
      (kStart ((e.fiber x).apply ((first.k.fiber x).apply v))));
\definition kEnd: \forall (v: Fiber p x) -> (k.fiber (Cylinder.at I.end x)).apply v = (second.k.fiber x).apply v :=
  \fun (v: Fiber p x) => trans!{{Fiber q x}} _ _ _
    (congr!{{C.Complex} {C.Complex} {Fiber q x}} (\fun (a, b: C.Complex) => ((bundle q).space x).add
      (((bundle q).space x).smul a ((first.k.fiber x).apply v)) (((bundle q).space x).smul b ((second.k.fiber x).apply v))) _ _ _ _ sEnd tEnd)
    (trans!{{Fiber q x}} _ _ _
      (congr!{{Fiber q x} {Fiber q x} {Fiber q x}} ((bundle q).space x).add _ _ _ _ (Odd.zeroScale ((first.k.fiber x).apply v)) (((bundle q).space x).scalarOne ((second.k.fiber x).apply v)))
      (Odd.zeroLeft ((second.k.fiber x).apply v)));
\definition end: \forall (v: Fiber p x) -> (isomorphism.forward.fiber (Cylinder.at I.end x)).apply v = (Second.forward.fiber x).apply v :=
  \fun (v: Fiber p x) => congr!{{Fiber q x} {Fiber q x}} (((bundle q).space x).add ((d.fiber x).apply v)) _ _
    (trans!{{Fiber q x}} _ _ _
      (congr!{{Fiber q x} {Fiber q x}} (\fun (w: Fiber q x) => (k.fiber (Cylinder.at I.end x)).apply ((e.fiber x).apply w)) _ _ (kEnd v))
      (kEnd ((e.fiber x).apply ((second.k.fiber x).apply v))));
