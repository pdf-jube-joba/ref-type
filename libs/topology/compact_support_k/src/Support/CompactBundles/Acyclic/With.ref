\import bundle_complements.Complements[].Over[K := C.Complex, field := Algebra.field, conjugation := Hermitian.scalar, scalar := Scalar.scalar] \as Complements;
\import Complements.For[X := X, F := Fiber p, bundle := bundle p] \as FirstEmbeddings;
\import Complements.For[X := X, F := Fiber q, bundle := bundle q] \as SecondEmbeddings;
\module At(x: X);
\definition locally: \forall (x: X) -> \exists Local[x] := \fun (x: X) => At[x := x].existence;
\module GlobalAt(x: X);
\definition patches: \forall (x: X) -> \exists PatchAt x := \fun (x: X) => GlobalAt[x := x].existence;
\module Finite;
\definition existence: \exists Contraction := Finite[].existence;
