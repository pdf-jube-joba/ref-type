\import Operations.ContractingPair[V := Fiber p x, W := Fiber q x, even := (bundle p).space x, odd := (bundle q).space x] \as Pair;
\definition contraction: Pair.Pair := \into[Pair.Data](Pair.Data { d := d.fiber x, e := e.fiber x, h := c.h.fiber x, k := c.k.fiber x }, Pair.Pair) \by { c.laws x };
\import Pair.With[c := contraction] \as Normal;
\definition left: \forall (v: Fiber p x) -> (backward.fiber x).apply ((forward.fiber x).apply v) = v := Normal.Inverse[].left;
\definition right: \forall (w: Fiber q x) -> (forward.fiber x).apply ((backward.fiber x).apply w) = w := Normal.Inverse[].right;
