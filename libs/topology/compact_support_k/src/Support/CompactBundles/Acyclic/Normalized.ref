\definition h: Map q p := Models.compose q q p (Models.compose q p q c.h d) c.h;
\definition k: Map p q := Models.compose p p q (Models.compose p q p c.k e) c.k;
\definition forward: Map p q := Operations.MapOperations[X := X, F := Fiber p, G := Fiber q, source := bundle p, target := bundle q].add d k;
\definition backward: Map q p := Operations.MapOperations[X := X, F := Fiber q, G := Fiber p, source := bundle q, target := bundle p].add e h;
\module At(x: X);
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Fiber p, G := Fiber q, source := bundle p, target := bundle q].Isomorphism :=
  Bundles.Isomorphisms[X := X, F := Fiber p, G := Fiber q, source := bundle p, target := bundle q].Isomorphism {
    forward := forward, backward := backward,
    leftInverse := \fun (x: X) => At[x := x].left,
    rightInverse := \fun (x: X) => At[x := x].right
  };
