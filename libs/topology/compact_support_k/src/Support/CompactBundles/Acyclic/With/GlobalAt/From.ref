\import Native.Restriction[U := local.domain] \as Restricted;
\import bundle_extension.Extension[].CompactNeighborhood[X := X, topology := space, subset := Base.Singleton x, U := local.domain] \as Shrink;
\definition contains: Base.Subset (Base.Singleton x) local.domain := \fun (y: X)(eq: y = x) =>
  \idelim x = y \with z: X => \In[X] local.domain z \by { base: local.contains, equality: sym!{{X}} _ _ eq };
\module Using(w: Shrink.Witness);
\definition existence: \exists PatchAt x := \block {
  \takefrom w: Shrink.Witness \by Shrink.exists compact hausdorff (Base.Compactness[].hausdorffT1 space hausdorff x) local.open contains \then
  \return Using[w := w].existence
};
