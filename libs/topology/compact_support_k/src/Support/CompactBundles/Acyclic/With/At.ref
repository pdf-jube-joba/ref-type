\import Operations.AcyclicCoordinates[n := p.ranks x, m := q.ranks x, d := d.fiber x, e := e.fiber x] \as Algebraic;
\import \root.Support[].CompactBundles[X := X, space := space, compact := compact, hausdorff := hausdorff] \as Native;
\module Using(c: Algebraic.Result);
\definition existence: \exists Local[x] := \block {
  \takefrom c: Algebraic.Result \by Algebraic.With[exact := exact x].existence \then
  \takefrom er: FirstEmbeddings.Embedding \by FirstEmbeddings.embeddingExists compact hausdorff \then
  \takefrom fr: SecondEmbeddings.Embedding \by SecondEmbeddings.embeddingExists compact hausdorff \then
  \takefrom h: Native.Maps[p := q, q := p].At[center := x, linear := c.h].Result \by Native.Maps[p := q, q := p].At[center := x, linear := c.h].existence \then
  \takefrom k: Native.Maps[p := p, q := q].At[center := x, linear := c.k].Result \by Native.Maps[p := p, q := q].At[center := x, linear := c.k].existence \then
  \return \exact(Using[c := c].Extended[h := h, k := k, er := er, fr := fr].result, Local[x])
};
