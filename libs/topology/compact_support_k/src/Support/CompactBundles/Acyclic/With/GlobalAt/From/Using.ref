\import Native.Restriction[U := w.envelope] \as Closed;
\import Restricted.To[V := w.envelope, inside := w.within] \as Restrict;
\definition hOnClosed: Closed.Map q p := Restrict.Mapping[p := q, q := p].map local.h;
\definition kOnClosed: Closed.Map p q := Restrict.Mapping[p := p, q := q].map local.k;
\import bundle_extension.Extension[].ComplexMaps[X := X, subset := w.envelope, F := Fiber q, G := Fiber p,
  source := bundle q, target := bundle p, baseSpace := space, sourceSame := (\refl(space)), same := (\refl(space))] \as HExtension;
\import bundle_extension.Extension[].ComplexMaps[X := X, subset := w.envelope, F := Fiber p, G := Fiber q,
  source := bundle p, target := bundle q, baseSpace := space, sourceSame := (\refl(space)), same := (\refl(space))] \as KExtension;
\module Extended(h: HExtension.Result[hOnClosed], k: KExtension.Result[kOnClosed]);
\definition existence: \exists PatchAt x := \block {
  \takefrom h: HExtension.Result[hOnClosed] \by HExtension.extend hOnClosed compact hausdorff w.envelopeClosed \then
  \takefrom k: KExtension.Result[kOnClosed] \by KExtension.extend kOnClosed compact hausdorff w.envelopeClosed \then
  \return \exact(Extended[h := h, k := k].result, PatchAt x)
};
