\import Operations.ContractingPair[V := Fiber p x, W := Fiber q x, even := (bundle p).space x, odd := (bundle q).space x].Sums[d := d.fiber x, e := e.fiber x] \as Sums;
\definition original: Sums.Candidate := Sums.Candidate { h := w.patch.candidate.h.fiber x, k := w.patch.candidate.k.fiber x };
\definition weighted: Sums.Candidate := Sums.Candidate { h := h.fiber x, k := k.fiber x };
\definition balance: Sums.Balance[weighted,factor x] := either!{{(Classical.excludedMiddle (w.entry.value x = R.zero))} {Sums.Balance[weighted,factor x]}
  {\fun (zero: w.entry.value x = R.zero) => \idelim Algebra.field.zero = factor x
    \with a: C.Complex => Sums.Balance[Sums.scale a original,a] \by {
      base: Sums.zeroScaleBalance original,
      equality: sym!{{C.Complex}} _ _ (trans!{{C.Complex}} _ _ _ (congr!{{R.Real} {C.Complex}} Hermitian.scalar.embed _ _ zero) Hermitian.scalar.embedZero)
    }}
  {\fun (nonzero: Logic.Not (w.entry.value x = R.zero)) => \block {
    \let member: \In[X] w.entry.openSet x := w.entry.supportWithin x
      (Base.Closure[].contains space (Partitions.Nonzero w.entry.value) x nonzero) \then
    \let inPatch: \In[X] w.patch.domain x := \idelim w.entry.openSet = w.patch.domain \with U: \Pow X => \In[X] U x \by {
      base: member, equality: sym!{{\Pow X}} _ _ w.same
    } \then
    \return Sums.scaleContraction (factor x) original (w.patch.laws (\into[X](x, w.patch.domain) \by { inPatch }))
  }}
};
