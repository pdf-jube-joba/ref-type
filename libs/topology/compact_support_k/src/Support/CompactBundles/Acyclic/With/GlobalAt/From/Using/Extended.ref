\definition candidate: Candidate := Candidate { h := h.map, k := k.map };
\module At(y: \Cast[X] w.inner);
\definition patch: Patch := Patch { candidate := candidate, domain := w.inner, open := w.innerOpen, laws := \fun (y: \Cast[X] w.inner) => At[y := y].laws };
\definition result: PatchAt x := \into[Patch](patch, PatchAt x) \by { w.contains x (\refl(x)) };
