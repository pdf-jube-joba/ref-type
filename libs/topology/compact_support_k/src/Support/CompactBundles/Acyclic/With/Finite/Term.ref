\definition factor[x: X]: C.Complex := Hermitian.scalar.embed (w.entry.value x);
\definition regular: Functions.Continuous space factor := Functions.embedding space w.entry.value (Bounded.laws space w.entry.value).continuous;
\definition h: Map q p := Operations.MapOperations[X := X, F := Fiber q, G := Fiber p, source := bundle q, target := bundle p].functionScale factor w.patch.candidate.h regular;
\definition k: Map p q := Operations.MapOperations[X := X, F := Fiber p, G := Fiber q, source := bundle p, target := bundle q].functionScale factor w.patch.candidate.k regular;
\module At(x: X);
