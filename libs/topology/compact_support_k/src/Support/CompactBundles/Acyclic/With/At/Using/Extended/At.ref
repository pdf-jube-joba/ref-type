\import Operations.ContractingPair[V := Fiber p y, W := Fiber q y, even := (bundle p).space y, odd := (bundle q).space y] \as Pair;
\definition data: Pair.Data := Pair.Data { d := d.fiber y, e := e.fiber y, h := h.map.fiber y, k := k.map.fiber y };
\import Pair.Correction[c := data, squareEven := (exact y).squareEven, squareOdd := (exact y).squareOdd] \as Correction;
\import Correction.With[r := inverseEven.fiber y, s := inverseOdd.fiber y,
  leftEven := EvenPull.left y, rightEven := EvenPull.right y, leftOdd := OddPull.left y, rightOdd := OddPull.right y] \as Corrected;
\definition laws: Pair.Laws[Pair.Data { d := d.fiber y, e := e.fiber y, h := correctedH.fiber y, k := correctedK.fiber y }] := Corrected.laws;
