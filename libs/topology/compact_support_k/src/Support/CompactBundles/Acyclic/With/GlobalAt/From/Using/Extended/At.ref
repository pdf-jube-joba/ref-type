\definition closedPoint: Closed.Point := \into[X](y, w.envelope) \by { w.enclosed y (\bysub(X, w.inner, y)) };
\definition point: Restricted.Point := \into[X](y, local.domain) \by { w.within y (w.enclosed y (\bysub(X, w.inner, y))) };
\definition hSame: (local.h.fiber point) = (h.map.fiber y) :=
  Spaces.Linear[V := Fiber q y, W := Fiber p y, source := (bundle q).space y, target := (bundle p).space y].ext _ _
    (\axiom:funext((local.h.fiber point).apply, (h.map.fiber y).apply, \fun (v: Fiber q y) => sym!{{Fiber p y}} _ _
      (trans!{{Fiber p y}} _ _ _ (h.extends closedPoint v) (Restrict.Mapping[p := q, q := p].formula local.h closedPoint v))));
\definition kSame: (local.k.fiber point) = (k.map.fiber y) :=
  Spaces.Linear[V := Fiber p y, W := Fiber q y, source := (bundle p).space y, target := (bundle q).space y].ext _ _
    (\axiom:funext((local.k.fiber point).apply, (k.map.fiber y).apply, \fun (v: Fiber p y) => sym!{{Fiber q y}} _ _
      (trans!{{Fiber q y}} _ _ _ (k.extends closedPoint v) (Restrict.Mapping[p := p, q := q].formula local.k closedPoint v))));
\import Operations.ContractingPair[V := Fiber p y, W := Fiber q y, even := (bundle p).space y, odd := (bundle q).space y] \as Pair;
\definition old: Pair.Data := Pair.Data { d := d.fiber y, e := e.fiber y, h := local.h.fiber point, k := local.k.fiber point };
\definition current: Pair.Data := Pair.Data { d := d.fiber y, e := e.fiber y, h := h.map.fiber y, k := k.map.fiber y };
\definition same: old = current := congr!{{Spaces.Linear[V := Fiber q y, W := Fiber p y, source := (bundle q).space y, target := (bundle p).space y].Map}
  {Spaces.Linear[V := Fiber p y, W := Fiber q y, source := (bundle p).space y, target := (bundle q).space y].Map} {Pair.Data}}
  (\fun (h: Spaces.Linear[V := Fiber q y, W := Fiber p y, source := (bundle q).space y, target := (bundle p).space y].Map)
    (k: Spaces.Linear[V := Fiber p y, W := Fiber q y, source := (bundle p).space y, target := (bundle q).space y].Map) => Pair.Data { d := d.fiber y, e := e.fiber y, h := h, k := k }) _ _ _ _ hSame kSame;
\definition laws: Contracting candidate y := \idelim old = current \with c: Pair.Data => Pair.Laws[c] \by {
  base: local.laws point, equality: same
};
