\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := X] \as Cylinder;
\import topological_constructions.Product[A := I.Carrier, B := X] \as Product;
\definition cylinderCompact: topology.Topology[Carrier := Cylinder.Carrier].IsCompact (Cylinder.topology space) := Product.Compactness[].productCompact I.topology space I.compact compact;
\definition cylinderHausdorff: topology.Topology[Carrier := Cylinder.Carrier].IsT2 (Cylinder.topology space) :=
  topological_constructions.Separation[].Product[A := I.Carrier, B := X].On[left := I.topology, right := space, leftHausdorff := I.hausdorff, rightHausdorff := hausdorff].hausdorff;
\import \root.Support[].CompactBundles[X := Cylinder.Carrier, space := Cylinder.topology space, compact := cylinderCompact, hausdorff := cylinderHausdorff] \as OnCylinder;
\import Models.Pullback[b := p, Y := Cylinder.Carrier, source := Cylinder.topology space, f := Cylinder.point, regular := (Cylinder.pointContinuous space)] \as P;
\import Models.Pullback[b := q, Y := Cylinder.Carrier, source := Cylinder.topology space, f := Cylinder.point, regular := (Cylinder.pointContinuous space)] \as Q;
\import Models.PullbackMap[p := p, q := q, Y := Cylinder.Carrier, source := Cylinder.topology space, f := Cylinder.point, regular := (Cylinder.pointContinuous space)] \as ForwardPull;
\import Models.PullbackMap[p := q, q := p, Y := Cylinder.Carrier, source := Cylinder.topology space, f := Cylinder.point, regular := (Cylinder.pointContinuous space)] \as BackwardPull;
\import OnCylinder.Acyclic[p := P.value, q := Q.value, d := ForwardPull.map d, e := BackwardPull.map e] \as Target;
\import hermitian_frames.Hermitian[].Over[K := C.Complex, field := Algebra.field, scalar := Hermitian.scalar, topological := Scalar.scalar.topological].Functions[X := Cylinder.Carrier] \as Functions;
\import real.Analysis[] \as R;
\definition t[z: Cylinder.Carrier]: C.Complex := Hermitian.scalar.embed (Cylinder.time z);
\definition s[z: Cylinder.Carrier]: C.Complex := Algebra.field.add Algebra.field.one (Algebra.field.neg (t z));
\definition tRegular: Functions.Continuous (Cylinder.topology space) t := Functions.embedding (Cylinder.topology space) (\fun (z: Cylinder.Carrier) => Cylinder.time z)
  (topology.Composition[A := Cylinder.Carrier, B := I.Carrier, C := R.Real].composeContinuous (Cylinder.topology space) I.topology metric_spaces.RealLine[].topology
    Cylinder.time (\fun (i: I.Carrier) => i) (Cylinder.timeContinuous space) I.inclusionContinuous);
\definition sRegular: Functions.Continuous (Cylinder.topology space) s := Functions.addition (Cylinder.topology space) (\fun (z: Cylinder.Carrier) => Algebra.field.one)
  (\fun (z: Cylinder.Carrier) => Algebra.field.neg (t z)) (Functions.constant (Cylinder.topology space) Algebra.field.one) (Functions.negation (Cylinder.topology space) t tRegular);
\import Operations.MapOperations[X := Cylinder.Carrier, F := (\fun (z: Cylinder.Carrier) => Fiber q (Cylinder.point z)), G := (\fun (z: Cylinder.Carrier) => Fiber p (Cylinder.point z)),
  source := OnCylinder.bundle Q.value, target := OnCylinder.bundle P.value] \as HMaps;
\import Operations.MapOperations[X := Cylinder.Carrier, F := (\fun (z: Cylinder.Carrier) => Fiber p (Cylinder.point z)), G := (\fun (z: Cylinder.Carrier) => Fiber q (Cylinder.point z)),
  source := OnCylinder.bundle P.value, target := OnCylinder.bundle Q.value] \as KMaps;
\definition h: OnCylinder.Map Q.value P.value := HMaps.add (HMaps.functionScale s (BackwardPull.map first.h) sRegular) (HMaps.functionScale t (BackwardPull.map second.h) tRegular);
\definition k: OnCylinder.Map P.value Q.value := KMaps.add (KMaps.functionScale s (ForwardPull.map first.k) sRegular) (KMaps.functionScale t (ForwardPull.map second.k) tRegular);
\import algebra.Group[].Of[Carrier := C.Complex, group := Algebra.additiveGroup] \as Scalars;
\definition total[z: Cylinder.Carrier]: Algebra.field.add (s z) (t z) = Algebra.field.one := Scalars.addDifference Algebra.field.one (t z);
\module At(z: Cylinder.Carrier);
\definition contraction: Target.Contraction := Target.Contraction { h := h, k := k, laws := \fun (z: Cylinder.Carrier) => At[z := z].laws };
\import Target.Normalized[c := contraction] \as Normal;
\import \parent.Normalized[c := first] \as First;
\import \parent.Normalized[c := second] \as Second;
\definition isomorphism: Bundles.Isomorphisms[X := Cylinder.Carrier,
  F := (\fun (z: Cylinder.Carrier) => Fiber p (Cylinder.point z)), G := (\fun (z: Cylinder.Carrier) => Fiber q (Cylinder.point z)),
  source := OnCylinder.bundle P.value, target := OnCylinder.bundle Q.value].Isomorphism := Normal.isomorphism;
\module Endpoint(x: X);
\definition start: \forall (x: X)(v: Fiber p x) -> (isomorphism.forward.fiber (Cylinder.at I.start x)).apply v = (First.forward.fiber x).apply v :=
  \fun (x: X) => Endpoint[x := x].start;
\definition end: \forall (x: X)(v: Fiber p x) -> (isomorphism.forward.fiber (Cylinder.at I.end x)).apply v = (Second.forward.fiber x).apply v :=
  \fun (x: X) => Endpoint[x := x].end;
