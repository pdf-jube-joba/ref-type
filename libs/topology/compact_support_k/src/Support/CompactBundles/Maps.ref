\import Operations.Hom[X := X, F := Fiber p, G := Fiber q, left := bundle p, right := bundle q] \as Hom;
\import Hom.Of[same := (\refl(space))] \as HomBundle;
\import Bundles.Family[X := X, F := Hom.Fiber] \as Family;
\module At(center: X, linear: Spaces.Linear[V := Fiber p center, W := Fiber q center, source := (bundle p).space center, target := (bundle q).space center].Map);
