\definition Point: \Set := \Cast[X] U;
\definition topology: topology.Topology[Carrier := Point].Topology := Base.Subspace[S := U].topology space;
\definition inclusion[x: Point]: X := x;
\definition regular: topology.Continuity[A := Point, B := X].Continuous topology space inclusion :=
  topology.Continuity[A := Point, B := X].Corestriction[S := U].inclusionContinuous space;
\definition Fiber[b: Bundle][x: Point]: \Set := Models.Fiber b.ranks x;
\definition bundle[b: Bundle]: Bundles.Family[X := Point, F := Fiber b].Bundle :=
  Bundles.Family[X := X, F := Models.Fiber b.ranks].Of[bundle := Models.bundle b].Restriction[U := U].restricted;
\definition Map[p, q: Bundle]: \Set := Bundles.Morphisms[X := Point, Y := Point, F := Fiber p, G := Fiber q,
  source := bundle p, target := bundle q, f := (\fun (x: Point) => x)].Map;
\definition pull[p, q: Bundle][a: Models.Map p q]: Map p q := Bundles.ArrowLaws[X := X, Y := X, F := Models.Fiber p.ranks, G := Models.Fiber q.ranks,
  source := Models.bundle p, target := Models.bundle q, f := (\fun (x: X) => x)].Pullback[Z := Point, space := topology, g := inclusion].Of[a := a, regular := regular].map;
\module To(V: \Pow X, inside: Base.Subset V U);
