\import \root.Support[].CompactBundles[X := X, space := space, compact := compact, hausdorff := hausdorff].Slicing[p := q, q := p].With[map := c.h] \as H;
\import \root.Support[].CompactBundles[X := X, space := space, compact := compact, hausdorff := hausdorff].Slicing[p := p, q := q].With[map := c.k] \as K;
\module Endpoint(time: I.Carrier, d: Map p q, e: Map q p,
  dEquation: \forall (x: X)(v: Fiber p x) -> (family.d.fiber (Cylinder.at time x)).apply v = (d.fiber x).apply v,
  eEquation: \forall (x: X)(v: Fiber q x) -> (family.e.fiber (Cylinder.at time x)).apply v = (e.fiber x).apply v);
\import Endpoint[time := I.start, d := d0, e := e0, dEquation := family.startD, eEquation := family.startE] \as Start;
\import Endpoint[time := I.end, d := d1, e := e1, dEquation := family.endD, eEquation := family.endE] \as End;
\import \root.Support[].CompactBundles[X := X, space := space, compact := compact, hausdorff := hausdorff].Acyclic[p := p, q := q, d := d0, e := e0] \as First;
\import \root.Support[].CompactBundles[X := X, space := space, compact := compact, hausdorff := hausdorff].Acyclic[p := p, q := q, d := d1, e := e1] \as Second;
\definition first: First.Contraction := Start.contraction;
\definition second: Second.Contraction := End.contraction;
\import Acyclic.Normalized[c := c] \as Normal;
\definition isomorphism: Bundles.Isomorphisms[X := Cylinder.Carrier,
  F := (\fun (z: Cylinder.Carrier) => Fiber p (Cylinder.point z)), G := (\fun (z: Cylinder.Carrier) => Fiber q (Cylinder.point z)),
  source := OnCylinder.bundle P.value, target := OnCylinder.bundle Q.value].Isomorphism := Normal.isomorphism;
\definition start: \forall (x: X)(v: Fiber p x) -> (isomorphism.forward.fiber (Cylinder.at I.start x)).apply v =
  (First.Normalized[c := first].isomorphism.forward.fiber x).apply v := Start.forwardFormula;
\definition end: \forall (x: X)(v: Fiber p x) -> (isomorphism.forward.fiber (Cylinder.at I.end x)).apply v =
  (Second.Normalized[c := second].isomorphism.forward.fiber x).apply v := End.forwardFormula;
