\import Operations.ContractingPair[V := Fiber p x, W := Fiber q x, even := (bundle p).space x, odd := (bundle q).space x] \as Pair;
\definition old: Pair.Data := Pair.Data { d := family.d.fiber (Cylinder.at time x), e := family.e.fiber (Cylinder.at time x), h := c.h.fiber (Cylinder.at time x), k := c.k.fiber (Cylinder.at time x) };
\definition current: Pair.Data := Pair.Data { d := d.fiber x, e := e.fiber x, h := HS.value.fiber x, k := KS.value.fiber x };
\import Spaces.Linear[V := Fiber p x, W := Fiber q x, source := (bundle p).space x, target := (bundle q).space x] \as D;
\definition dSame: old.d = current.d := D.ext _ _ (\axiom:funext(old.d.apply, current.d.apply, (dEquation x)));
\import Spaces.Linear[V := Fiber q x, W := Fiber p x, source := (bundle q).space x, target := (bundle p).space x] \as E;
\definition eSame: old.e = current.e := E.ext _ _ (\axiom:funext(old.e.apply, current.e.apply, (eEquation x)));
\import Spaces.Linear[V := Fiber q x, W := Fiber p x, source := (bundle q).space x, target := (bundle p).space x] \as H;
\definition hSame: old.h = current.h := H.ext _ _ (\axiom:funext(old.h.apply, current.h.apply, (\fun (v: Fiber q x) => sym!{{Fiber p x}} _ _ (HS.formula x v))));
\import Spaces.Linear[V := Fiber p x, W := Fiber q x, source := (bundle p).space x, target := (bundle q).space x] \as K;
\definition kSame: old.k = current.k := K.ext _ _ (\axiom:funext(old.k.apply, current.k.apply, (\fun (v: Fiber p x) => sym!{{Fiber q x}} _ _ (KS.formula x v))));
\definition same: old = current := congr!{{D.Map} {E.Map} {H.Map} {K.Map} {Pair.Data}}
  (\fun (a: D.Map)(b: E.Map)(c: H.Map)(z: K.Map) => Pair.Data { d := a, e := b, h := c, k := z }) _ _ _ _ _ _ _ _ dSame eSame hSame kSame;
\definition laws: Pair.Laws[current] := \idelim old = current \with d: Pair.Data => Pair.Laws[d] \by { base: c.laws (Cylinder.at time x), equality: same };
\definition polynomial[c: Pair.Data][v: Fiber p x]: Fiber q x := ((bundle q).space x).add (c.d.apply v) (c.k.apply (c.e.apply (c.k.apply v)));
\definition forwardFormula: \forall (v: Fiber p x) -> polynomial old v = polynomial current v := \fun (v: Fiber p x) =>
  congr!{{Pair.Data} {Fiber q x}} (\fun (c: Pair.Data) => polynomial c v) _ _ same;
