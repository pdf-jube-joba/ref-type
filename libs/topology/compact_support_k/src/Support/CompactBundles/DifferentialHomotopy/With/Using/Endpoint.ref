\import H.At[time := time] \as HS;
\import K.At[time := time] \as KS;
\import \root.Support[].CompactBundles[X := X, space := space, compact := compact, hausdorff := hausdorff].Acyclic[p := p, q := q, d := d, e := e] \as Target;
\module At(x: X);
\definition contraction: Target.Contraction := Target.Contraction { h := HS.value, k := KS.value, laws := \fun (x: X) => At[x := x].laws };
\import Target.Normalized[c := contraction] \as Normal;
\definition forwardFormula: \forall (x: X)(v: Fiber p x) ->
  (Acyclic.Normalized[c := c].isomorphism.forward.fiber (Cylinder.at time x)).apply v = (Normal.isomorphism.forward.fiber x).apply v :=
  \fun (x: X)(v: Fiber p x) => At[x := x].forwardFormula v;
