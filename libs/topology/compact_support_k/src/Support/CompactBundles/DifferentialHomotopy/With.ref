\import topological_constructions.Product[A := I.Carrier, B := X] \as Product;
\definition cylinderCompact: topology.Topology[Carrier := Cylinder.Carrier].IsCompact cylinderSpace := Product.Compactness[].productCompact I.topology space I.compact compact;
\definition cylinderHausdorff: topology.Topology[Carrier := Cylinder.Carrier].IsT2 cylinderSpace := topological_constructions.Separation[].Product[A := I.Carrier, B := X].On[
  left := I.topology, right := space, leftHausdorff := I.hausdorff, rightHausdorff := hausdorff].hausdorff;
\import \root.Support[].CompactBundles[X := Cylinder.Carrier, space := cylinderSpace, compact := cylinderCompact, hausdorff := cylinderHausdorff] \as OnCylinder;
\import OnCylinder.Acyclic[p := P.value, q := Q.value, d := family.d, e := family.e] \as Acyclic;
\definition Contraction: \Set := Acyclic.Contraction;
\definition existence: \exists Contraction := Acyclic.With[exact := family.exact].existence;
\module Using(c: Contraction);
