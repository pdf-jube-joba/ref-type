\import Models.Sum[first := p, second := r] \as Even;
\import Models.Sum[first := q, second := s] \as Odd;
\import Models.SumMap[p := p, q := q, r := r, s := s] \as Forward;
\import Models.SumMap[p := q, q := p, r := s, s := r] \as Backward;
\definition even: Bundle := Even.value;
\definition odd: Bundle := Odd.value;
\definition d: Map even odd := Forward.map d0 d1;
\definition e: Map odd even := Backward.map e0 e1;
\import \parent.Acyclic[p := p, q := q, d := d0, e := e0] \as First;
\import \parent.Acyclic[p := r, q := s, d := d1, e := e1] \as Second;
\import \parent.Acyclic[p := even, q := odd, d := d, e := e] \as Target;
\module With(first: First.Contraction, second: Second.Contraction);
