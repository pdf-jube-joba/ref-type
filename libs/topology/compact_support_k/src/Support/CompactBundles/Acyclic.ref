\definition Exact: \Prop := \forall (x: X) -> Operations.AcyclicCoordinates[n := p.ranks x, m := q.ranks x, d := d.fiber x, e := e.fiber x].Exact;
\structure Candidate: \Set := { h: Map q p, k: Map p q };
\definition Contracting[c: Candidate][x: X]: \Prop := Operations.ContractingPair[V := Fiber p x, W := Fiber q x, even := (bundle p).space x, odd := (bundle q).space x].Laws[
  Operations.ContractingPair[V := Fiber p x, W := Fiber q x, even := (bundle p).space x, odd := (bundle q).space x].Data {
    d := d.fiber x, e := e.fiber x, h := c.h.fiber x, k := c.k.fiber x }];
\structure Patch: \Set := {
  candidate: Candidate,
  domain: \Pow X,
  open: Base.IsOpenIn space domain,
  laws: \forall (x: \Cast[X] domain) -> Contracting candidate x
};
\definition PatchAt[x: X]: \Set := \Cast[Patch] ({ c: Patch \where \In[X] c.domain x });
\structure Contraction: \Set := {
  h: Map q p, k: Map p q,
  laws: \forall (x: X) -> Operations.ContractingPair[V := Fiber p x, W := Fiber q x, even := (bundle p).space x, odd := (bundle q).space x].Laws[
    Operations.ContractingPair[V := Fiber p x, W := Fiber q x, even := (bundle p).space x, odd := (bundle q).space x].Data {
      d := d.fiber x, e := e.fiber x, h := h.fiber x, k := k.fiber x }]
};
\structure Local[center: X]: \Set := {
  domain: \Pow X,
  open: Base.IsOpenIn space domain,
  contains: \In[X] domain center,
  h: \parent.Restriction[U := domain].Map q p,
  k: \parent.Restriction[U := domain].Map p q,
  laws: \forall (x: \Cast[X] domain) -> Operations.ContractingPair[V := Fiber p x, W := Fiber q x, even := (bundle p).space x, odd := (bundle q).space x].Laws[
    Operations.ContractingPair[V := Fiber p x, W := Fiber q x, even := (bundle p).space x, odd := (bundle q).space x].Data {
      d := d.fiber x, e := e.fiber x, h := h.fiber x, k := k.fiber x }]
};
\module With(exact: Exact);
\module Normalized(c: Contraction);
\module Between(first, second: Contraction);
