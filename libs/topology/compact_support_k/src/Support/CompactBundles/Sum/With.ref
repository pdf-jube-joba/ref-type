\definition h: Map odd even := Backward.map first.h second.h;
\definition k: Map even odd := Forward.map first.k second.k;
\module At(x: X);
\definition contraction: Target.Contraction := Target.Contraction { h := h, k := k, laws := \fun (x: X) => At[x := x].laws };
\import Target.Normalized[c := contraction] \as Normal;
\import First.Normalized[c := first] \as FirstNormal;
\import Second.Normalized[c := second] \as SecondNormal;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Fiber even, G := Fiber odd, source := bundle even, target := bundle odd].Isomorphism := Normal.isomorphism;
\definition forwardFormula: \forall (x: X)(v: Fiber p x)(w: Fiber r x) ->
  (isomorphism.forward.fiber x).apply ((Even.isomorphism.forward.fiber x).apply (std.Data[].Pair[].pair (Fiber p x) (Fiber r x) v w)) =
  (Odd.isomorphism.forward.fiber x).apply (std.Data[].Pair[].pair (Fiber q x) (Fiber s x) ((FirstNormal.isomorphism.forward.fiber x).apply v) ((SecondNormal.isomorphism.forward.fiber x).apply w)) :=
  \fun (x: X)(v: Fiber p x)(w: Fiber r x) => At[x := x].forwardFormula v w;
