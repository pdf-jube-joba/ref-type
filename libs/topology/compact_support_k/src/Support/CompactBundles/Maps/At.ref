\import Operations.PointSection[X := X, F := Hom.Fiber, bundle := HomBundle.hom, center := center,
  vector := Spaces.Linear[V := Fiber p center, W := Fiber q center, source := (bundle p).space center, target := (bundle q).space center].asModuleMap linear] \as Point;
\import bundle_extension.Extension[].Sections[K := C.Complex, field := Algebra.field, conjugation := Hermitian.scalar, scalar := Scalar.scalar,
  A := X, subset := Base.Singleton center, F := Hom.Fiber, bundle := HomBundle.hom] \as Sections;
\definition input: Sections.Section := Sections.Section { value := Point.value, continuous := Point.continuous };
\import bundle_extension.Extension[].ComplexSections[A := X, subset := Base.Singleton center, F := Hom.Fiber, bundle := HomBundle.hom] \as Extension;
\structure Result: \Set := {
  map: Map p q,
  equation: \forall (v: Fiber p center) -> (map.fiber center).apply v = linear.apply v
};
\module With(extension: Sections.Extension[input]);
\definition existence: \exists Result := \block {
  \takefrom e: Sections.Extension[input] \by Extension.extend input compact hausdorff (Base.Compactness[].hausdorffT1 space hausdorff center) \then
  \return \exact(With[extension := e].result, Result)
};
