\import HomBundle.Section[value := extension.value, regular := extension.continuous] \as SectionMap;
\definition result: Result := Result { map := SectionMap.map,
  equation := \fun (v: Fiber p center) =>
    congr!{{Hom.Fiber center} {Fiber q center}} (\fun (h: Hom.Fiber center) => h.apply v) _ _
      (trans!{{Hom.Fiber center}} _ _ _ (extension.extends (\into[X](center, Base.Singleton center) \by { \refl(center) })) Point.atCenter)
};
