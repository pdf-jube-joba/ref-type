\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := X] \as Cylinder;
\import relative_k_theory.Relative[].ConstantCylinder[X := X, F := Fiber p, G := Fiber q, first := bundle p, second := bundle q, same := (\refl(space))] \as Constant;
\definition CylinderMap: \Set := Bundles.Morphisms[X := Cylinder.Carrier, Y := Cylinder.Carrier, F := Constant.First, G := Constant.Second,
  source := Constant.firstBundle, target := Constant.secondBundle, f := (\fun (z: Cylinder.Carrier) => z)].Map;
\module With(map: CylinderMap);
