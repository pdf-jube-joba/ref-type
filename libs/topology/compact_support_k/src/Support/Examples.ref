\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Nat[] \as Nat;
\definition one: Nat.Nat^ := Nat.Nat^::succ Nat.Nat^::zero;
\definition Point: \Set := Fin.Fin one;
\import topology.Topology[Carrier := Point] \as PointSpace;
\import topological_k_theory.KTheory[].FiniteDiscrete[n := one] \as Finite;
\definition locallyCompact: topology.LocallyCompact[A := Point].IsLocallyCompact PointSpace.Discrete :=
  topology.LocallyCompact[A := Point].compactLocallyCompact PointSpace.Discrete Finite.compact;
\import \root.Support[].On[X := Point, space := PointSpace.Discrete, hausdorff := Finite.hausdorff, locallyCompact := locallyCompact] \as K;
\module At(degree: std.Arithmetic[].Int[].Int^) {
  \definition group: std.Alg[].Alg[].CommutativeGroup[K.At[degree := degree].Carrier] := K.At[degree := degree].group;
}
\module TrivialDisk(n: Nat.Nat^) {
  \import relative_k_theory.Relative[].Examples[].TrivialDisk[n := n] \as Presentation;
  \import \root.Support[].Disk[X := Point, space := PointSpace.Discrete, compact := Finite.compact, hausdorff := Finite.hausdorff,
    p := Presentation.presentation] \as Disk;
  \definition Interior: \Set := Disk.Interior;
  \definition compactification: relative_k_theory.Relative[].CompactPointed := Disk.compactification;
}
\import TrivialDisk[n := Nat.Nat^::zero] \as ZeroDisk;
\import TrivialDisk[n := one] \as LineDisk;
\definition Zero: \Set := ZeroDisk.Interior;
\definition Line: \Set := LineDisk.Interior;
\module Raw(n: Nat.Nat^);
\import Raw[n := one] \as RawLine;
\definition rawLine: K.Symbols[].Carrier := RawLine.symbol;

\module ThreeTerm;
