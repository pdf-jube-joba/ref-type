\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Logic.either;
\import std.Data[].Option[] \as Option;
\module OnePoint(X: \Set, space: topology.Topology[Carrier := X].Topology);
\module Proper(A, B: \Set, source: topology.Topology[Carrier := A].Topology,
  target: topology.Topology[Carrier := B].Topology);
\module On(X: \Set, space: topology.Topology[Carrier := X].Topology,
  hausdorff: topology.Topology[Carrier := X].IsT2 space,
  locallyCompact: topology.LocallyCompact[A := X].IsLocallyCompact space);
\module CompactInSubspace(M: \Set, space: topology.Topology[Carrier := M].Topology, S, K: \Pow M,
  compact: topology.Topology[Carrier := M].IsCompactIn space K, included: topology.Topology[Carrier := M].Subset K S);
\module OpenPart(M: \Set, space: topology.Topology[Carrier := M].Topology,
  compact: topology.Topology[Carrier := M].IsCompact space, hausdorff: topology.Topology[Carrier := M].IsT2 space,
  U: \Pow M, open: topology.Topology[Carrier := M].IsOpenIn space U);
\module ClosedPair(M: \Set, space: topology.Topology[Carrier := M].Topology,
  compact: topology.Topology[Carrier := M].IsCompact space, hausdorff: topology.Topology[Carrier := M].IsT2 space,
  subset: \Pow M, closed: topology.Topology[Carrier := M].IsClosedIn space subset);
\module Disk(X: \Set, space: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact space, hausdorff: topology.Topology[Carrier := X].IsT2 space,
  p: topological_k_theory.KTheory[].On[X := X, baseSpace := space, compact := compact, hausdorff := hausdorff].Presentation);
\module ProperIdentity(X: \Set, space: topology.Topology[Carrier := X].Topology);
\module ProperComposition(A, B, C: \Set, firstSpace: topology.Topology[Carrier := A].Topology,
  middleSpace: topology.Topology[Carrier := B].Topology, lastSpace: topology.Topology[Carrier := C].Topology,
  f: A -> B, g: B -> C,
  firstContinuous: topology.Continuity[A := A, B := B].Continuous firstSpace middleSpace f,
  secondContinuous: topology.Continuity[A := B, B := C].Continuous middleSpace lastSpace g,
  firstProper: \root.Support[].Proper[A := A, B := B, source := firstSpace, target := middleSpace].IsProper f,
  secondProper: \root.Support[].Proper[A := B, B := C, source := middleSpace, target := lastSpace].IsProper g);
\module Examples;
\module Homeomorphic(A, B: \Set, source: topology.Topology[Carrier := A].Topology,
  target: topology.Topology[Carrier := B].Topology, h: topology.Homeomorphism[A := A, B := B].Homeomorphism[source, target]);
\module CompactBundles(X: \Set, space: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact space, hausdorff: topology.Topology[Carrier := X].IsT2 space);
