\import \root.Relative[].PointedPair[pair := source] \as From;
\import \root.Relative[].PointedPair[pair := target] \as To;
\import \root.Relative[].Pair[X := source.model.Carrier, space := (details source.model).topology,
  compact := (details source.model).compact, hausdorff := (details source.model).hausdorff,
  subset := (pairDetails source).subset, closed := (pairDetails source).closed] \as SourceClosed;
\import \root.Relative[].Pair[X := target.model.Carrier, space := (details target.model).topology,
  compact := (details target.model).compact, hausdorff := (details target.model).hausdorff,
  subset := (pairDetails target).subset, closed := (pairDetails target).closed] \as TargetClosed;
\import algebraic_topology.Pointed[A := source.model.Carrier].Maps[B := target.model.Carrier] \as Maps;
\import TargetClosed.Mapping[Y := source.model.Carrier, source := (details source.model).topology,
  sourceCompact := (details source.model).compact, sourceHausdorff := (details source.model).hausdorff,
  sourceSubset := (pairDetails source).subset, sourceClosed := (pairDetails source).closed,
  f := f.function, regular := (Maps.laws (pointed source.model) (pointed target.model) f.function).continuous, preserves := f.preserves] \as Mapping;
\import Mapping.Based[a0 := To.point, b0 := From.point, preservesPoint := (Maps.laws (pointed source.model) (pointed target.model) f.function).pointed] \as Based;
\definition subsetMap: Map From.subsetModel To.subsetModel := Based.subsetMap;
\definition quotientMap: Map From.quotientModel To.quotientModel := Mapping.quotientMap;
\import SourceClosed.Pointed[a0 := From.point].SuspendedPair[] \as SourceSuspendedPair;
\import TargetClosed.Pointed[a0 := To.point].SuspendedPair[] \as TargetSuspendedPair;
\definition onProjection: \forall (x: source.model.Carrier) -> quotientMap (From.projection x) = To.projection (f.function x) := Mapping.onProjection;
\module Suspended;
\definition suspended: PairMapData[From.suspended, To.suspended] := Suspended[].result;
\module Iteration;
