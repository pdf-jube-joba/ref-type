\import Bundles.Family[X := X, F := F].Of[bundle := first].Restriction[U := subset] \as FirstRestriction;
\import Bundles.Family[X := X, F := G].Of[bundle := second].Restriction[U := subset] \as SecondRestriction;
\definition A: \Set := topology.Topology[Carrier := X].Subspace[S := subset].CarrierSet;
\definition B: \Set := topology.Topology[Carrier := Y].Subspace[S := sourceSubset].CarrierSet;
\definition OnSubset: \Set := Bundles.Isomorphisms[X := A, F := (\fun (x: A) => F x), G := (\fun (x: A) => G x),
  source := FirstRestriction.restricted, target := SecondRestriction.restricted].Isomorphism;
\import \root.Relative[].RestrictedPullback[X := X, Y := Y, F := F, bundle := first, source := source,
  subset := subset, sourceSubset := sourceSubset, f := f, regular := regular, preserves := preserves] \as Positive;
\definition secondRegular: topology.Continuity[A := Y, B := X].Continuous source second.baseSpace f :=
  \idelim first.baseSpace = second.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Continuity[A := Y, B := X].Continuous source t f
    \by { base: regular, equality: same };
\import \root.Relative[].RestrictedPullback[X := X, Y := Y, F := G, bundle := second, source := source,
  subset := subset, sourceSubset := sourceSubset, f := f, regular := secondRegular, preserves := preserves] \as Negative;
\definition boundary: B -> A := Positive.boundary;
\definition firstBoundary: Bundles.Family[X := B, F := (\fun (y: B) => F (f y))].Bundle := Positive.first;
\definition secondBoundary: Bundles.Family[X := B, F := (\fun (y: B) => G (f y))].Bundle := Negative.first;
\module With(alpha: OnSubset);
