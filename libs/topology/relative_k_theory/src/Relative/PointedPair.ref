\import \root.Relative[].Pair[X := pair.model.Carrier, space := (details pair.model).topology, compact := (details pair.model).compact, hausdorff := (details pair.model).hausdorff,
  subset := pair.subset, closed := pair.closed] \as Whole;
\definition point: \Cast[pair.model.Carrier] pair.subset := \into[pair.model.Carrier]((details pair.model).point, pair.subset) \by { pair.containsPoint };
\import Whole.Pointed[a0 := point] \as Native;
\import Whole.Quotient[] \as Quotient;
\import Native.SuspendedPair[] \as Suspension;
\definition subsetModel: CompactPointed := Native.subsetModel;
\definition quotientModel: CompactPointed := Quotient.model;
\definition Relative: \Set := Quotient.Relative;
\definition group: std.Alg[].Alg[].CommutativeGroup[Relative] := Quotient.group;
\definition inclusion: Map subsetModel pair.model := Native.Exact[].inclusion;
\definition projection: Map pair.model quotientModel := Native.Exact[].projectionMap;
\definition suspended: ClosedPointedPair := ClosedPointedPair {
  model := Suspension.result, subset := Suspension.image, closed := Suspension.imageClosed, containsPoint := Suspension.containsPoint
};
\definition suspendedModel: suspended.model = \root.Relative[].Suspension[original := pair.model].result := \refl(suspended.model);
\definition suspendedSubsetEquivalence: \root.Relative[].Equivalence[source := \root.Relative[].Suspension[original := subsetModel].result,
  target := \root.Relative[].PointedPair[pair := suspended].subsetModel].Data := Suspension.equivalence;
