\import \root.Relative[].Pair[X := pair.model.Carrier, space := (details pair.model).topology, compact := (details pair.model).compact, hausdorff := (details pair.model).hausdorff,
  subset := (pairDetails pair).subset, closed := (pairDetails pair).closed] \as Whole;
\definition point: \Cast[pair.model.Carrier] (pairDetails pair).subset := \into[pair.model.Carrier]((details pair.model).point, (pairDetails pair).subset) \by { (pairDetails pair).containsPoint };
\import Whole.Pointed[a0 := point] \as Native;
\import Whole.Quotient[] \as Quotient;
\import Native.SuspendedPair[] \as Suspension;
\definition subsetModel: CompactPointed := Native.subsetModel;
\definition quotientModel: CompactPointed := Quotient.model;
\definition Relative: \Set := Quotient.Relative;
\definition group: std.Alg[].Alg[].CommutativeGroup[Relative] := Quotient.group;
\definition inclusion: Map subsetModel pair.model := Native.Exact[].inclusion;
\definition projection: Map pair.model quotientModel := Native.Exact[].projectionMap;
\definition suspended: ClosedPointedPair := packPair Suspension.result (ClosedPairDetails[Suspension.result] {
  subset := Suspension.image, closed := Suspension.imageClosed, containsPoint := Suspension.containsPoint
});
\definition suspendedModel: suspended.model = \root.Relative[].Suspension[original := pair.model].result := \refl(suspended.model);
\definition suspendedSubsetEquivalence: \root.Relative[].Equivalence[source := \root.Relative[].Suspension[original := subsetModel].result,
  target := \root.Relative[].PointedPair[pair := suspended].subsetModel].Data := Suspension.equivalence;
\definition suspendedQuotientEquivalence: \root.Relative[].Equivalence[source := \root.Relative[].PointedPair[pair := suspended].quotientModel,
  target := \root.Relative[].Suspension[original := quotientModel].result].Data := Suspension.Quotient[].equivalence;
\definition suspendedProjectionEquation: \forall (x: \root.Relative[].Suspension[original := pair.model].result.Carrier) ->
  suspendedQuotientEquivalence.forward (\root.Relative[].PointedPair[pair := suspended].projection x) =
  \root.Relative[].SuspendedMap[source := pair.model, target := quotientModel, f := projection].map x := Suspension.Quotient[].onProjection;
\definition forget[v: Relative]: \root.Relative[].Reduced[model := pair.model].Carrier := Native.Exact[].forget v;
\definition restriction: \root.Relative[].Reduced[model := pair.model].Carrier -> \root.Relative[].Reduced[model := subsetModel].Carrier := Native.Exact[].restriction;
\definition forgetProjectionEquation: \forall (v: Relative) -> \root.Relative[].Pullback[source := pair.model, target := quotientModel, f := projection].map v = forget v :=
  Native.Exact[].projectionEquation;
\definition quotientOnto: \forall (q: quotientModel.Carrier) -> \exists (x: pair.model.Carrier \where projection x = q) := Native.QuotientSurjective[].onto;
