\definition inclusionRegular: topology.Continuity[A := Carrier, B := Original.Point].Continuous topology bundle.totalSpace (\fun (p: Carrier) => p) :=
  topology.Continuity[A := Carrier, B := Original.Point].Corestriction[S := domain].inclusionContinuous bundle.totalSpace;
\definition baseRegular: topology.Continuity[A := Carrier, B := X].Continuous topology bundle.baseSpace (\fun (p: Carrier) => p.base) :=
  topology.Composition[A := Carrier, B := Original.Point, C := X].composeContinuous topology bundle.totalSpace bundle.baseSpace
    (\fun (p: Carrier) => p) Original.projection inclusionRegular (Original.Of[bundle := bundle].projectionContinuous);
\definition representedRegular: topology.Continuity[A := Carrier, B := Represented.Point].Continuous topology (Absolute.bundle r.presentation).totalSpace
  (\fun (p: Carrier) => Forward.total r.isomorphism.forward p) :=
  topology.Composition[A := Carrier, B := Original.Point, C := Represented.Point].composeContinuous topology bundle.totalSpace (Absolute.bundle r.presentation).totalSpace
    (\fun (p: Carrier) => p) (Forward.total r.isomorphism.forward) inclusionRegular (Forward.continuous r.isomorphism.forward);
\definition vectorRegular: topology.Continuity[A := Carrier, B := Bundles.Vector r.presentation.dimension].Continuous topology (Bundles.coordinateTopology r.presentation.dimension)
  (\fun (p: Carrier) => represented p) :=
  topology.Composition[A := Carrier, B := Represented.Point, C := Bundles.Vector r.presentation.dimension].composeContinuous topology (Absolute.bundle r.presentation).totalSpace
    (Bundles.coordinateTopology r.presentation.dimension) (\fun (p: Carrier) => Forward.total r.isomorphism.forward p)
    (\fun (p: Represented.Point) => p.vector) representedRegular Projection.vectorContinuous;
\definition realRegular: topology.Continuity[A := Carrier, B := Ambient.Coordinate].Continuous topology Ambient.topology realVector :=
  topology.Composition[A := Carrier, B := Bundles.Vector r.presentation.dimension, C := Ambient.Coordinate].composeContinuous topology
    (Bundles.coordinateTopology r.presentation.dimension) Ambient.topology (\fun (p: Carrier) => represented p) Coordinates.frame.forward.apply
    vectorRegular Coordinates.Topology[].forwardContinuous;
\definition ball[p: Carrier]: Ambient.Disk := \into[Ambient.Coordinate](realVector p, Ambient.ClosedBall) \by { \bysub(Original.Point, domain, p) };
\definition ballRegular: topology.Continuity[A := Carrier, B := Ambient.Disk].Continuous topology Ambient.diskTopology ball :=
  topology.Continuity[A := Carrier, B := Ambient.Coordinate].Corestriction[S := Ambient.ClosedBall].corestrictContinuous topology Ambient.topology ball realRegular;
\definition candidateRegular: topology.Continuity[A := Carrier, B := Native.Container].Continuous topology Native.containerTopology candidate :=
  topological_constructions.Product[A := X, B := Ambient.Disk].Universal[X := Carrier].pairContinuous topology bundle.baseSpace Ambient.diskTopology
    (\fun (p: Carrier) => p.base) ball baseRegular ballRegular;
\definition inverseContinuous: topology.Continuity[A := Carrier, B := Disk].Continuous topology
  \root.Relative[].BundleDisk[X := X, F := F, bundle := bundle, compact := compact, hausdorff := hausdorff].With[r := r].topology inverse :=
  topology.Continuity[A := Carrier, B := Native.Container].Corestriction[S := Native.domain].corestrictContinuous topology Native.containerTopology inverse candidateRegular;
