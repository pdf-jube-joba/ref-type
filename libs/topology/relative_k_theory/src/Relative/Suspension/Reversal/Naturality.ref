\import algebraic_topology.Suspension[A := original.Carrier].Pointed[source := (details original).topology, basepoint := (details original).point].Mapping[
  B := target.Carrier, target := (\root.Relative[].pointed target), f := f] \as SuspendedMap;
\import \root.Relative[].Suspension[original := target] \as TargetSuspension;
\import TargetSuspension.Reversal[] \as TargetReversal;
\import algebraic_topology.Suspension[A := target.Carrier].Pointed[source := (details target).topology, basepoint := (details target).point] \as TargetNative;
\import algebraic_topology.Cylinder[A := target.Carrier] \as TargetCylinder;
\definition classEquation: \forall (z: Cylinder.Carrier) -> SuspendedMap.map (map (Native.class z)) = TargetReversal.map (SuspendedMap.map (Native.class z)) :=
  \fun (z: Cylinder.Carrier) => trans!{{TargetNative.Carrier}} _ _ _
    (congr!{{Native.Carrier} {TargetNative.Carrier}} SuspendedMap.map _ _ (onClass z))
    (trans!{{TargetNative.Carrier}} _ _ _ (SuspendedMap.onClass (raw z))
      (sym!{{TargetNative.Carrier}} _ _ (trans!{{TargetNative.Carrier}} _ _ _
        (congr!{{TargetNative.Carrier} {TargetNative.Carrier}} TargetReversal.map _ _ (SuspendedMap.onClass z))
        (TargetReversal.onClass (TargetCylinder.at (Cylinder.time z) (f (Cylinder.point z)))))));
\definition equation: \forall (z: Native.Carrier) -> SuspendedMap.map (map z) = TargetReversal.map (SuspendedMap.map z) :=
  Collapse.induction (\fun (z: Native.Carrier) => SuspendedMap.map (map z) = TargetReversal.map (SuspendedMap.map z)) classEquation;
