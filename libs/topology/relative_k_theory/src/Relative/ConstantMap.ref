\module Suspended;
\definition Property[degree: N.Nat^]: \Prop := \forall (x: (iterate degree source).Carrier) ->
  iterateMap degree source target f x = (details (iterate degree target)).point;
\module Step(degree: N.Nat^, previous: Property degree);
\definition iterated: \forall (degree: N.Nat^) -> Property degree :=
  \induction (degree: N.Nat^) \return Property degree \with {
    | zero: constant
    | succ: \fun (n: N.Nat^)(previous: Property n) => Step[degree := n, previous := previous].equation
  };
\module Negative(degree: N.Nat^);
