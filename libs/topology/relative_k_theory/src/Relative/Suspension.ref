\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := original.Carrier] \as Cylinder;
\import topology.Topology[Carrier := original.Carrier] \as Base;
\import topology.Topology[Carrier := I.Carrier] \as Time;
\definition pointed: algebraic_topology.Pointed[A := original.Carrier].Space := algebraic_topology.Pointed[A := original.Carrier].Space {
  topology := original.topology, basepoint := original.point
};
\import puppe_sequences.Puppe[].Suspension[A := original.Carrier, source := pointed] \as Native;
\import algebraic_topology.Suspension[A := original.Carrier].Reduced[basepoint := original.point] \as Model;
\import topological_constructions.Product[A := I.Carrier, B := original.Carrier] \as Product;
\import topology.Topology[Carrier := Cylinder.Carrier] \as CylinderSpace;
\definition cylinderCompact: CylinderSpace.IsCompact (Cylinder.topology original.topology) :=
  Product.Compactness[].productCompact I.topology original.topology I.compact original.compact;
\definition cylinderHausdorff: CylinderSpace.IsT2 (Cylinder.topology original.topology) :=
  uniform_approximation.Approximation[].Separation[].Product[A := I.Carrier, B := original.Carrier].On[
    left := I.topology, right := original.topology, leftHausdorff := I.hausdorff, rightHausdorff := original.hausdorff].hausdorff;
\import topology.Continuity[A := Cylinder.Carrier, B := I.Carrier] \as TimeMaps;
\import topology.Continuity[A := Cylinder.Carrier, B := original.Carrier] \as BaseMaps;
\definition startClosed: CylinderSpace.IsClosedIn (Cylinder.topology original.topology) (TimeMaps.Preimage Cylinder.time (Time.Singleton I.start)) :=
  TimeMaps.closedPreimage (Cylinder.topology original.topology) I.topology Cylinder.time (Cylinder.timeContinuous original.topology)
    (Time.Singleton I.start) (Time.Compactness[].hausdorffT1 I.topology I.hausdorff I.start);
\definition endClosed: CylinderSpace.IsClosedIn (Cylinder.topology original.topology) (TimeMaps.Preimage Cylinder.time (Time.Singleton I.end)) :=
  TimeMaps.closedPreimage (Cylinder.topology original.topology) I.topology Cylinder.time (Cylinder.timeContinuous original.topology)
    (Time.Singleton I.end) (Time.Compactness[].hausdorffT1 I.topology I.hausdorff I.end);
\definition lineClosed: CylinderSpace.IsClosedIn (Cylinder.topology original.topology) (BaseMaps.Preimage Cylinder.point (Base.Singleton original.point)) :=
  BaseMaps.closedPreimage (Cylinder.topology original.topology) original.topology Cylinder.point (Cylinder.pointContinuous original.topology)
    (Base.Singleton original.point) (Base.Compactness[].hausdorffT1 original.topology original.hausdorff original.point);
\definition collapsedClosed: CylinderSpace.IsClosedIn (Cylinder.topology original.topology) Model.Collapsed :=
  CylinderSpace.Finite[].joinClosed (Cylinder.topology original.topology)
    (TimeMaps.Preimage Cylinder.time (Time.Singleton I.start))
    (CylinderSpace.Finite[].Join (TimeMaps.Preimage Cylinder.time (Time.Singleton I.end)) (BaseMaps.Preimage Cylinder.point (Base.Singleton original.point)))
    startClosed
    (CylinderSpace.Finite[].joinClosed (Cylinder.topology original.topology)
      (TimeMaps.Preimage Cylinder.time (Time.Singleton I.end)) (BaseMaps.Preimage Cylinder.point (Base.Singleton original.point)) endClosed lineClosed);
\import algebraic_topology.Collapse[A := Cylinder.Carrier, subset := Model.Collapsed].Closed[
  source := Cylinder.topology original.topology, compact := cylinderCompact, hausdorff := cylinderHausdorff, closed := collapsedClosed] \as Properties;
\definition result: CompactPointed := CompactPointed {
  Carrier := Native.Carrier, topology := Native.topology,
  compact := Properties.compactQuotient, hausdorff := Properties.hausdorffQuotient, point := Native.point
};
