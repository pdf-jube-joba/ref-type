\import topology.Topology[Carrier := X] \as Base;
\import Base.Subspace[S := subset] \as Subspace;
\definition A: \Set := Subspace.CarrierSet;
\definition subspace: topology.Topology[Carrier := A].Topology := Subspace.topology space;
\import KTheory.On[X := X, baseSpace := space, compact := compact, hausdorff := hausdorff] \as Absolute;
\definition Presentation: \Set := Absolute.Presentation;
\module Quotient;
\module Restricted(p: Presentation);
\module Between(p, q: Presentation);
\structure Triple: \Set := {
  positive: Presentation,
  negative: Presentation,
  comparison: Between[p := positive, q := negative].Isomorphism
};
\definition eta: \forall (t: Triple) -> Triple { positive := t.positive, negative := t.negative, comparison := t.comparison } = t :=
  \induction (t: Triple) \return Triple { positive := t.positive, negative := t.negative, comparison := t.comparison } = t \with {
    | # : \fun (p, q: Presentation)(comparison: Between[p := p, q := q].Isomorphism) => \refl(Triple { positive := p, negative := q, comparison := comparison })
  };
\module Diagonal(p: Presentation);
\definition reverse[t: Triple]: Triple := Triple {
  positive := t.negative,
  negative := t.positive,
  comparison := Between[p := t.positive, q := t.negative].inverse t.comparison
};
\module Global(t: Triple);
\module Compose(p, q, r: Presentation, first: \parent.Between[p := p, q := q].Isomorphism, second: \parent.Between[p := q, q := r].Isomorphism);
\module Sum(t, u, v: Triple);
\module Homotopy(p, q: Presentation, first, second: \parent.Between[p := p, q := q].Isomorphism);
\module Restriction;
\module FromBundles(F, G: X -> \Set, source: Bundles.Family[X := X, F := F].Bundle, target: Bundles.Family[X := X, F := G].Bundle,
  sourceSame: source.baseSpace = space, targetSame: target.baseSpace = space);
\module FromKernel(p, q: Presentation);
\module Group;
\module Mapping(Y: \Set, source: topology.Topology[Carrier := Y].Topology,
  sourceCompact: topology.Topology[Carrier := Y].IsCompact source, sourceHausdorff: topology.Topology[Carrier := Y].IsT2 source,
  sourceSubset: \Pow Y, sourceClosed: topology.Topology[Carrier := Y].IsClosedIn source sourceSubset,
  f: Y -> X, regular: topology.Continuity[A := Y, B := X].Continuous source space f,
  preserves: \forall (y: Y) -> \In[Y] sourceSubset y -> \In[X] subset (f y));
\module SumConstruction(t, u: Triple);
\module Normalize(t: Triple);
\module BundleModel(F: X -> \Set);
\module FramedBundles(F, G: X -> \Set, sourceModel: \parent.BundleModel[F := F].Bundle, targetModel: \parent.BundleModel[F := G].Bundle, n, m: N.Nat^);
\module FramedBundleIsomorphisms(F, G: X -> \Set, sourceModel: \parent.BundleModel[F := F].Bundle, targetModel: \parent.BundleModel[F := G].Bundle, n, m: N.Nat^);
\module FramedMaps(p, q: Presentation, n, m: N.Nat^);
\module FramedIsomorphisms(p, q: Presentation, n, m: N.Nat^);
\module FramedClass(F: X -> \Set, sourceModel: \parent.BundleModel[F := F].Bundle, n: N.Nat^);
\module FramedChoices(p: Presentation, n: N.Nat^);
\module Excision(U: \Pow X, open: Base.IsOpenIn space U, included: Base.Subset U subset);
\module PresentationChange(F, G: X -> \Set, source: Bundles.Family[X := X, F := F].Bundle, target: Bundles.Family[X := X, F := G].Bundle,
  sourceSame: source.baseSpace = space, targetSame: target.baseSpace = space);
\module FromQuotient(F: \parent.Quotient[].Carrier -> \Set,
  bundle: Bundles.Family[X := \parent.Quotient[].Carrier, F := F].Bundle, same: bundle.baseSpace = \parent.Quotient[].topology);
\module BundleChange(F, G: X -> \Set, source: Bundles.Family[X := X, F := F].Bundle, target: Bundles.Family[X := X, F := G].Bundle,
  sourceSame: source.baseSpace = space, targetSame: target.baseSpace = space);
\module QuotientIsomorphisms(F, G: \parent.Quotient[].Carrier -> \Set,
  source: Bundles.Family[X := \parent.Quotient[].Carrier, F := F].Bundle, target: Bundles.Family[X := \parent.Quotient[].Carrier, F := G].Bundle,
  sourceSame: source.baseSpace = \parent.Quotient[].topology, targetSame: target.baseSpace = \parent.Quotient[].topology);
\module QuotientClass(F: \parent.Quotient[].Carrier -> \Set,
  bundle: Bundles.Family[X := \parent.Quotient[].Carrier, F := F].Bundle, same: bundle.baseSpace = \parent.Quotient[].topology);
\module BundleGlobal(F, G: X -> \Set, source: Bundles.Family[X := X, F := F].Bundle, target: Bundles.Family[X := X, F := G].Bundle,
  sourceSame: source.baseSpace = space, targetSame: target.baseSpace = space);
\module QuotientTrivial(n: N.Nat^);
\module QuotientAdditivity(F, G: \parent.Quotient[].Carrier -> \Set,
  source: Bundles.Family[X := \parent.Quotient[].Carrier, F := F].Bundle, target: Bundles.Family[X := \parent.Quotient[].Carrier, F := G].Bundle,
  sourceSame: source.baseSpace = \parent.Quotient[].topology, targetSame: target.baseSpace = \parent.Quotient[].topology);
\module FromReduced;
\module Reconstruction(t: Triple);
\module Surjectivity;
\module TripleClass(t: Triple);
\module CylinderNeighborhood(U: \Pow (algebraic_topology.Cylinder[A := X].Carrier),
  open: topology.Topology[Carrier := algebraic_topology.Cylinder[A := X].Carrier].IsOpenIn (algebraic_topology.Cylinder[A := X].topology space) U,
  alongSubset: \forall (x: A)(t: algebraic_topology.Interval[].Carrier) -> \In[algebraic_topology.Cylinder[A := X].Carrier] U (algebraic_topology.Cylinder[A := X].at t x),
  atStart: \forall (x: X) -> \In[algebraic_topology.Cylinder[A := X].Carrier] U (algebraic_topology.Cylinder[A := X].at algebraic_topology.Interval[].start x));
\module CylinderSubset;
\module GaugeExtension(F: X -> \Set, sourceModel: \parent.BundleModel[F := F].Bundle);
\module CylinderRestriction(F: X -> \Set, sourceModel: \parent.BundleModel[F := F].Bundle);
\module CylinderSum(F, G: X -> \Set, sourceModel: \parent.BundleModel[F := F].Bundle, targetModel: \parent.BundleModel[F := G].Bundle);
\module CylinderHomotopy(p, q: Presentation, first, second: \parent.Between[p := p, q := q].Isomorphism);
\module TripleHomotopy(p, q: Presentation, first, second: \parent.Between[p := p, q := q].Isomorphism);
\module FramedSum(F, G: X -> \Set, sourceModel: \parent.BundleModel[F := F].Bundle, targetModel: \parent.BundleModel[F := G].Bundle, n, m: N.Nat^);
\module BundleSwitch(F, G: X -> \Set, sourceModel: \parent.BundleModel[F := F].Bundle, targetModel: \parent.BundleModel[F := G].Bundle);
\module TripleFraming(t: Triple, auxiliary: Presentation, n: N.Nat^);
\module ComplementChoice(t: Triple, first, second: Presentation, n, m: N.Nat^);
\module TripleIsomorphic(t, u: Triple);
\module TripleSum(t, u, v: Triple);
\module TripleComposition(p, q, r: Presentation, first: \parent.Between[p := p, q := q].Isomorphism, second: \parent.Between[p := q, q := r].Isomorphism);
\module TripleReconstruction(t: Triple);
\module GroupRetraction;
\module TrivialNegative(t: Triple, n: N.Nat^);
\module QuotientReconstruction(F: \parent.Quotient[].Carrier -> \Set,
  bundle: Bundles.Family[X := \parent.Quotient[].Carrier, F := F].Bundle, same: bundle.baseSpace = \parent.Quotient[].topology);
