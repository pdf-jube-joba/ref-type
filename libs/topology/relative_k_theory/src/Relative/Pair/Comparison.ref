\import \parent.Group[] \as Triples;
\import \parent.Quotient[] \as Quotient;
\import Triples.ToReduced[] \as Forward;
\import \parent.FromReduced[] \as Backward;
\import \parent.GroupRetraction[] \as Left;
\import \parent.ReducedRetraction[] \as Right;
\import algebra.Group[].Of[Carrier := Quotient.Relative, group := Quotient.group] \as ReducedGroup;
\structure Isomorphism: \Set := {
  forward: Triples.Carrier -> Quotient.Relative,
  backward: Quotient.Relative -> Triples.Carrier,
  forwardAdd: \forall (x, y: Triples.Carrier) -> forward (Triples.add x y) = ReducedGroup.add (forward x) (forward y),
  backwardAdd: \forall (x, y: Quotient.Relative) -> backward (ReducedGroup.add x y) = Triples.add (backward x) (backward y),
  leftInverse: \forall (x: Triples.Carrier) -> backward (forward x) = x,
  rightInverse: \forall (x: Quotient.Relative) -> forward (backward x) = x
};
\definition isomorphism: Isomorphism := Isomorphism {
  forward := Forward.map, backward := Backward.reduced,
  forwardAdd := Forward.additive, backwardAdd := Backward.reducedAdditive,
  leftInverse := Left.equation, rightInverse := Right.equation
};
\definition onTriple: \forall (t: Triple) -> isomorphism.forward (Triples.value t) = \parent.TripleClass[t := t].value := Forward.onTriple;
\definition injective: \forall (x, y: Triples.Carrier) -> isomorphism.forward x = isomorphism.forward y -> x = y :=
  \fun (x, y: Triples.Carrier)(same: isomorphism.forward x = isomorphism.forward y) => trans!{{Triples.Carrier}} _ _ _ (sym!{{Triples.Carrier}} _ _ (Left.equation x))
    (trans!{{Triples.Carrier}} _ _ _ (congr!{{Quotient.Relative} {Triples.Carrier}} Backward.reduced _ _ same) (Left.equation y));
\definition surjective: \forall (v: Quotient.Relative) -> \exists (x: Triples.Carrier \where isomorphism.forward x = v) :=
  \fun (v: Quotient.Relative) => Logic.existsIntro[Triples.Carrier, { x: Triples.Carrier \where isomorphism.forward x = v }] (Backward.reduced v) (Right.equation v);
