\import Bundles.Family[X := X, F := F] \as Family;
\structure Data: \Set := {
  totalSpace: topology.Topology[Carrier := Family.Point].Topology,
  fiberSpace: \forall (x: X) -> Spaces.VectorSpace (F x)
};
\definition lifted[d: Data]: Family.Data := Family.Data { baseSpace := space, totalSpace := d.totalSpace, space := d.fiberSpace };
\definition Bundle: \Set := \Cast[Data] ({ d: Data \where Family.With[data := (lifted d)].LocallyTrivial });
\definition bundle[d: Bundle]: Family.Bundle := \into[Family.Data](lifted d, Family.Bundle) \by {
  \bysub(Data, { d: Data \where Family.With[data := (lifted d)].LocallyTrivial }, d)
};
\module From(original: Family.Bundle, same: original.baseSpace = space);
