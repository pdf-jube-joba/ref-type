\definition left: Triple := Triple { positive := p, negative := q, comparison := first };
\definition right: Triple := Triple { positive := q, negative := r, comparison := second };
\import Operations.IsomorphismComposition[X := A, F := \parent.Restricted[p := p].Fiber,
  G := \parent.Restricted[p := q].Fiber, H := \parent.Restricted[p := r].Fiber,
  source := \parent.Restricted[p := p].bundle, middle := \parent.Restricted[p := q].bundle, target := \parent.Restricted[p := r].bundle] \as Composition;
\definition triple: Triple := Triple { positive := p, negative := r, comparison := Composition.compose first second };
