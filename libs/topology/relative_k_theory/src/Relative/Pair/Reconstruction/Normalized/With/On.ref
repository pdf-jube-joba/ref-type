\import \parent.\parent.\parent.\parent.BundleChange[F := Raw.Fiber, G := (\fun (x: X) => Bundles.Vector normalized.dimension),
  source := Raw.pulled, target := Trivial.bundle, sourceSame := (\refl(space)), targetSame := (\refl(space))].To[
  H := (Absolute.Fiber original.positive), I := (Absolute.Fiber original.negative), newSource := (Absolute.bundle original.positive), newTarget := (Absolute.bundle original.negative),
  newSourceSame := (\refl(space)), newTargetSame := (\refl(space))].On[
  alpha := RawModel.comparison, beta := original.comparison, first := result, second := represented] \as Change;
\definition witness: Change.Witness := Change.Witness {
  positive := Construction.Compare[].isomorphism, negative := Negative.inverse normalized.trivialization, commutes := alignment
};
\definition raw: Raw.Witness := Raw.Witness {
  chart := \into[Charts.Chart](chart, { c: Charts.Chart \where topology.Topology[Carrier := Quotient.Carrier].Member c.domain Quotient.point }) \by { contains }, result := result
};
\definition classEquation: Class.value = RelativeGroup.value original := trans!{{RelativeGroup.Carrier}} _ _ _ (Class.agreement raw) (Change.With[w := witness].equation);
\import ReconstructionMap.OnBundle[F := Model.Fiber, bundle := Construction.bundleOnQuotient, same := Construction.sameBaseSpace] \as Identification;
\import algebra.Group[].Of[Carrier := RelativeGroup.Carrier, group := RelativeGroup.group] \as Additive;
\definition equation: ReconstructionMap.reduced ReducedClass.value = RelativeGroup.value t :=
  trans!{{RelativeGroup.Carrier}} _ _ _ (ReconstructionMap.onDifference BundleClass.value (K.Trivial[n := normalized.dimension].value))
    (trans!{{RelativeGroup.Carrier}} _ _ _
      (congr!{{RelativeGroup.Carrier} {RelativeGroup.Carrier} {RelativeGroup.Carrier}} Additive.difference _ _ _ _
        (trans!{{RelativeGroup.Carrier}} _ _ _ Identification.equation classEquation) (ReconstructionMap.Trivial[n := normalized.dimension].equation))
      (trans!{{RelativeGroup.Carrier}} _ _ _ (trans!{{RelativeGroup.Carrier}} _ _ _ (congr!{{RelativeGroup.Carrier} {RelativeGroup.Carrier}} (RelativeGroup.add (RelativeGroup.value original)) _ _ Additive.negZero) (Additive.zeroRight (RelativeGroup.value original)))
        (sym!{{RelativeGroup.Carrier}} _ _ normalized.equality)));
\definition preimage: Preimage := Preimage { value := ReducedClass.value, equation := equation };
