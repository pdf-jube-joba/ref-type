\definition original: Triple := normalized.value;
\import Normalization.ToDescent[result := normalized] \as Boundary;
\import \root.Relative[].Descent[X := X, F := (Absolute.Fiber original.positive), bundle := (Absolute.bundle original.positive),
  compact := compact, hausdorff := hausdorff, subset := subset, closed := closed, dimension := normalized.dimension] \as Descent;
\import Descent.With[comparison := Boundary.comparison] \as Model;
\module With(extension: Model.Result);
\definition existence: \exists Preimage := \block {
  \takefrom descent: Descent.Witness[Boundary.comparison] \by Boundary.existence \then
  \return With[extension := descent.extension].existence
};
