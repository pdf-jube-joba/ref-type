\definition Fiber[x: X]: \Set := Bundles.Vector n;
\import Bundles.Trivial[X := X, n := n, baseSpace := space] \as Trivial;
\import \parent.BundleModel[F := Fiber].From[original := Trivial.bundle, same := (\refl(space))] \as Based;
\import Bundles.Family[X := X, F := Fiber].Of[bundle := Trivial.bundle].Restriction[U := subset] \as Restrict;
\import Bundles.Isomorphisms[X := A, F := (\fun (x: A) => Bundles.Vector n), G := (\fun (x: A) => Bundles.Vector n),
  source := Restrict.restricted, target := Restrict.restricted] \as Frames;
\import \parent.CylinderRestriction[F := Fiber, sourceModel := Based.model] \as CylinderRestriction;
\import \parent.CylinderSubset[] \as Boundary;
\import algebraic_topology.Interval[] \as Interval;
\import algebraic_topology.Cylinder[A := A] \as Cylinder;
\import algebraic_topology.Homotopy[A := A, B := A] \as H;
\definition inclusion[x: A]: X := x;
\definition regular: topology.Continuity[A := A, B := X].Continuous subspace space inclusion := topology.Continuity[A := A, B := X].Corestriction[S := subset].inclusionContinuous space;
\import Spaces.Isomorphism[V := Bundles.Vector n, W := Bundles.Vector n, source := Bundles.coordinates n, target := Bundles.coordinates n] \as Coordinates;
\import \parent.Quotient[] \as Quotient;
\import algebra.Group[].Of[Carrier := Quotient.Relative, group := Quotient.group] \as Group;
\module With(theta: Frames.Isomorphism);
