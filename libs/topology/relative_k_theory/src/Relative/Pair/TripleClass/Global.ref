\import Operations.DirectSumIsomorphisms[X := X, F := (Absolute.Fiber t.positive), G := (Absolute.Fiber complement), A := (Absolute.Fiber t.negative), B := (Absolute.Fiber complement),
  first := (Absolute.bundle t.positive), second := (Absolute.bundle complement), newFirst := (Absolute.bundle t.negative), newSecond := (Absolute.bundle complement),
  sameSource := (\refl(space)), sameTarget := (\refl(space))] \as SumsOfIsomorphisms;
\import Operations.IdentityIsomorphism[X := X, F := (Absolute.Fiber complement), bundle := (Absolute.bundle complement)] \as Identity;
\import Operations.IsomorphismComposition[X := X, F := Positive.Fiber, G := Negative.Fiber, H := (\fun (x: X) => Bundles.Vector t.negative.dimension),
  source := Sums.positiveBundle, middle := Sums.negativeBundle, target := Trivial.bundle] \as CompositionGlobal;
\definition trivialization: CompositionGlobal.Isomorphism := CompositionGlobal.compose (SumsOfIsomorphisms.isomorphism w.isomorphism Identity.isomorphism) Split.isomorphism;
\import std.Data[].Pair[] \as Pair;
\definition extends: \forall (x: A)(v: Positive.Fiber x) -> (trivialization.forward.fiber x).apply v = (comparison.forward.fiber x).apply v :=
  \fun (x: A)(v: Positive.Fiber x) =>
    congr!{{Absolute.Fiber t.negative x} {Bundles.Vector t.negative.dimension}}
      (\fun (u: Absolute.Fiber t.negative x) => (Split.isomorphism.forward.fiber x).apply
        (Pair.pair (Absolute.Fiber t.negative x) (Absolute.Fiber complement x) u (Pair.second (Absolute.Fiber t.positive x) (Absolute.Fiber complement x) v))) _ _
      (w.agrees x (Pair.first (Absolute.Fiber t.positive x) (Absolute.Fiber complement x) v));
\import Class.Global[h := trivialization, extends := extends] \as Vanishing;
\import algebra.Group[].Of[Carrier := Quotient.Relative, group := Quotient.group] \as ReducedGroup;
\definition equation: value = ReducedGroup.zero := Vanishing.equation;
