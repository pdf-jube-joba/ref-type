\import \root.Relative[].Descent[X := X, F := Absolute.Fiber p, bundle := Absolute.bundle p, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed, dimension := n] \as First;
\import \root.Relative[].Descent[X := X, F := Absolute.Fiber q, bundle := Absolute.bundle q, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed, dimension := m] \as Second;
\import Bundles.Morphisms[X := X, Y := X, F := Absolute.Fiber p, G := Absolute.Fiber q, source := Absolute.bundle p, target := Absolute.bundle q,
  f := (\fun (x: X) => x)] \as Global;
\import Spaces.Linear[V := Bundles.Vector n, W := Bundles.Vector m, source := Bundles.coordinates n, target := Bundles.coordinates m] \as Coordinates;
\import \parent.BundleModel[F := (Absolute.Fiber p)].From[original := (Absolute.bundle p), same := (\refl(space))] \as SourceModel;
\import \parent.BundleModel[F := (Absolute.Fiber q)].From[original := (Absolute.bundle q), same := (\refl(space))] \as TargetModel;
\import \parent.FramedBundles[F := (Absolute.Fiber p), G := (Absolute.Fiber q), sourceModel := SourceModel.model, targetModel := TargetModel.model, n := n, m := m] \as General;
\definition Compatible[alpha: First.OnSubset, beta: Second.OnSubset, h: Global.Map, c: Coordinates.Map]: \Prop := General.Compatible alpha beta h c;
\module With(alpha: First.OnSubset, beta: Second.OnSubset, h: Global.Map, c: Coordinates.Map, compatible: Compatible alpha beta h c);
