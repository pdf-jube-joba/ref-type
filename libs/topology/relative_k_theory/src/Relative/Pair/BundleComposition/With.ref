\definition comparison: Third.OnSubset := Composition.compose alpha beta;
\import First.With[alpha := alpha] \as Left;
\import Second.With[alpha := beta] \as MiddleClass;
\import Third.With[alpha := comparison] \as Right;
\import Absolute.Bundle[F := F, original := First.first, same := (\refl(space))] \as P;
\import Absolute.Bundle[F := G, original := First.second, same := (\refl(space))] \as Q;
\import Absolute.Bundle[F := H, original := Second.second, same := (\refl(space))] \as R;
\import \parent.\parent.Group[] \as Group;
\module Using(p, q, r: Presentation, positive: P.Isomorphism p, middle: Q.Isomorphism q, negative: R.Isomorphism r);
\definition equation: Group.add Left.value MiddleClass.value = Right.value := \block {
  \takefrom p: P.Representative \by P.representativeExists \then
  \takefrom q: Q.Representative \by Q.representativeExists \then
  \takefrom r: R.Representative \by R.representativeExists \then
  \return Using[p := p.presentation, q := q.presentation, r := r.presentation, positive := p.isomorphism, middle := q.isomorphism, negative := r.isomorphism].equation
};
\import \parent.\parent.Quotient[] \as Quotient;
\definition reducedEquation: Quotient.group.base.op Left.reduced MiddleClass.reduced = Right.reduced := trans!{{Quotient.Relative}} _ _ _
  (sym!{{Quotient.Relative}} _ _ (Group.ToReduced[].additive Left.value MiddleClass.value))
  (congr!{{Group.Carrier} {Quotient.Relative}} Group.ToReduced[].map _ _ equation);
