\import \parent.\parent.\parent.FromBundles[F := F, G := G, source := First.first, target := First.second, sourceSame := (\refl(space)), targetSame := (\refl(space))]
  .With[alpha := alpha, p := p, q := q, positive := positive, negative := middle] \as T;
\import \parent.\parent.\parent.FromBundles[F := G, G := H, source := First.second, target := Second.second, sourceSame := (\refl(space)), targetSame := (\refl(space))]
  .With[alpha := beta, p := q, q := r, positive := middle, negative := negative] \as U;
\import \parent.\parent.\parent.FromBundles[F := F, G := H, source := First.first, target := Second.second, sourceSame := (\refl(space)), targetSame := (\refl(space))]
  .With[alpha := comparison, p := p, q := r, positive := positive, negative := negative] \as V;
\import \parent.\parent.\parent.Compose[p := p, q := q, r := r, first := T.triple.comparison, second := U.triple.comparison] \as Composed;
\import Bundles.Isomorphisms[X := X, F := G, G := Absolute.Fiber q, source := First.second, target := Absolute.bundle q] \as MiddleMaps;
\definition formula: \forall (x: A)(v: Absolute.Fiber p x) -> (Composed.triple.comparison.forward.fiber x).apply v = (V.triple.comparison.forward.fiber x).apply v :=
  \fun (x: A)(v: Absolute.Fiber p x) => congr!{{G x} {Absolute.Fiber r x}}
    (\fun (w: G x) => (negative.forward.fiber x).apply ((beta.forward.fiber x).apply w)) _ _
    ((\bysub(MiddleMaps.Data, MiddleMaps.Isomorphism, middle)).leftInverse x ((alpha.forward.fiber x).apply ((positive.backward.fiber x).apply v)));
\import \parent.\parent.\parent.Restricted[p := p] \as FP;
\import \parent.\parent.\parent.Restricted[p := r] \as FR;
\import Operations.IsomorphismEquality[X := A, F := FP.Fiber, G := FR.Fiber, source := FP.bundle, target := FR.bundle] \as Equality;
\definition sameComparison: Composed.triple.comparison = V.triple.comparison := Equality.ext Composed.triple.comparison V.triple.comparison formula;
\definition sameTriple: Composed.triple = V.triple :=
  congr!{{\parent.\parent.\parent.Between[p := p, q := r].Isomorphism} {Triple}}
    (\fun (a: \parent.\parent.\parent.Between[p := p, q := r].Isomorphism) => Triple { positive := p, negative := r, comparison := a }) _ _ sameComparison;
\definition equation: Group.add Left.value MiddleClass.value = Right.value := trans!{{Group.Carrier}} _ _ _
  (congr!{{Group.Carrier} {Group.Carrier} {Group.Carrier}} Group.add _ _ _ _ (Left.agreement T.result) (MiddleClass.agreement U.result))
  (trans!{{Group.Carrier}} _ _ _
    (Group.Composition[p := p, q := q, r := r, first := T.triple.comparison, second := U.triple.comparison].equation)
    (trans!{{Group.Carrier}} _ _ _ (congr!{{Triple} {Group.Carrier}} Group.value _ _ sameTriple) (sym!{{Group.Carrier}} _ _ (Right.agreement V.result))));
