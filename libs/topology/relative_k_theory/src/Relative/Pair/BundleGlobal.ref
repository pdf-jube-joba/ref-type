\import \parent.FromBundles[F := F, G := G, source := source, target := target, sourceSame := sourceSame, targetSame := targetSame] \as Original;
\import \parent.Group[] \as RelativeGroup;
\import Bundles.Isomorphisms[X := X, F := F, G := G, source := source, target := target] \as Global;
\module On(alpha: Original.OnSubset, result: Original.Result[alpha], h: Global.Isomorphism,
  agrees: \forall (x: A)(v: F x) -> (h.forward.fiber x).apply v = (alpha.forward.fiber x).apply v);
