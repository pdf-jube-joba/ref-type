\import NativePair.Quotient[] \as Quotient;
\import \root.Relative[].Equivalence[source := Quotient.model, target := Original.model].With[e := QuotientCompare.equivalence].Negative[degree := degree] \as Native;
\definition forward: Relative.Carrier -> Term.Third := Native.forward;
\definition backward: Term.Third -> Relative.Carrier := Native.backward;
\definition leftInverse: \forall (v: Term.Third) -> forward (backward v) = v := Native.leftInverse;
\definition rightInverse: \forall (v: Relative.Carrier) -> backward (forward v) = v := Native.rightInverse;
\definition forwardAdd: \forall (v, w: Relative.Carrier) -> forward (Relative.group.base.op v w) = Term.thirdGroup.base.op (forward v) (forward w) := Native.additive;
\definition backwardAdd: \forall (v, w: Term.Third) -> backward (Term.thirdGroup.base.op v w) = Relative.group.base.op (backward v) (backward w) := Native.inverseAdditive;
\definition forwardZero: forward Relative.group.base.unit = Term.thirdGroup.base.unit := Native.forwardZero;
\definition backwardZero: backward Term.thirdGroup.base.unit = Relative.group.base.unit := Native.backwardZero;
\import \root.Relative[].NegativeMap[source := Quotient.model, target := Original.model,
  f := QuotientCompare.equivalence.forward, degree := degree] \as Pull;
\definition forwardFormula: \forall (v: Relative.Carrier) -> forward v = Pull.map v :=
  \fun (v: Relative.Carrier) => congr!{{Relative.Carrier -> Term.Third} {Term.Third}}
    (\fun (f: Relative.Carrier -> Term.Third) => f v) _ _ Native.forwardEquality;
