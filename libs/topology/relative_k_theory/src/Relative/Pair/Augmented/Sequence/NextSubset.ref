\import \root.Relative[].Equivalence[source := Subset.model, target := PointedPair.subsetModel].With[e := SubsetCompare.equivalence].Negative[degree := (N.Nat^::succ degree)] \as Native;
\definition forward: SubsetNext.Carrier -> Term.Second := Native.backward;
\definition backward: Term.Second -> SubsetNext.Carrier := Native.forward;
\definition leftInverse: \forall (v: Term.Second) -> forward (backward v) = v := Native.rightInverse;
\definition rightInverse: \forall (v: SubsetNext.Carrier) -> backward (forward v) = v := Native.leftInverse;
\definition forwardAdd: \forall (v, w: SubsetNext.Carrier) -> forward (SubsetNext.group.base.op v w) = Term.secondGroup.base.op (forward v) (forward w) := Native.inverseAdditive;
\definition backwardAdd: \forall (v, w: Term.Second) -> backward (Term.secondGroup.base.op v w) = SubsetNext.group.base.op (backward v) (backward w) := Native.additive;
\definition forwardZero: forward SubsetNext.group.base.unit = Term.secondGroup.base.unit := Native.backwardZero;
\definition backwardZero: backward Term.secondGroup.base.unit = SubsetNext.group.base.unit := Native.forwardZero;
