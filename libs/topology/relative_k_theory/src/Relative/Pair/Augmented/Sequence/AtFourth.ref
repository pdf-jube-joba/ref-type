\definition oldKernel: \forall (v: Term.Third) -> Term.restriction (Term.forget v) = Term.fifthGroup.base.unit :=
  \fun (v: Term.Third) => (Term.exactFourth (Term.forget v)).rtl
    (Logic.existsIntro[Term.Third, { w: Term.Third \where Term.forget w = Term.forget v }] v (\refl(Term.forget v)));
\definition kernel: \forall (v: Third) -> restriction (forget v) = fifthGroup.base.unit :=
  \fun (v: Third) => trans!{{Fifth}} _ _ _
    (congr!{{Term.Fourth} {Fifth}} (\fun (w: Term.Fourth) => A0.backward (Term.restriction w)) _ _ (X0.leftInverse (Term.forget (Q.forward v))))
    (trans!{{Fifth}} _ _ _ (congr!{{Term.Fifth} {Fifth}} A0.backward _ _ (oldKernel (Q.forward v))) A0.backwardZero);
\definition Image[v: Fourth]: \Prop := \exists (w: Third \where forget w = v);
\definition preimage: \forall (v: Fourth) -> restriction v = fifthGroup.base.unit -> Image v := \block {
  \fun (v: Fourth)(zero: restriction v = fifthGroup.base.unit) \then
  \let oldZero: Term.restriction (X0.forward v) = Term.fifthGroup.base.unit :=
    trans!{{Term.Fifth}} _ _ _ (sym!{{Term.Fifth}} _ _ (A0.leftInverse (Term.restriction (X0.forward v))))
      (trans!{{Term.Fifth}} _ _ _ (congr!{{Fifth} {Term.Fifth}} A0.forward _ _ zero) A0.forwardZero) \then
  \takefrom w: \Cast[Term.Third] ({ w: Term.Third \where Term.forget w = X0.forward v }) \by (Term.exactFourth (X0.forward v)).ltr oldZero \then
  \return Logic.existsIntro[Third, { u: Third \where forget u = v }] (Q.backward w)
    (trans!{{Fourth}} _ _ _
      (congr!{{Term.Third} {Fourth}} (\fun (u: Term.Third) => X0.backward (Term.forget u)) _ _ (Q.leftInverse w))
      (trans!{{Fourth}} _ _ _
        (congr!{{Term.Fourth} {Fourth}} X0.backward _ _ (\bysub(Term.Third, { w: Term.Third \where Term.forget w = X0.forward v }, w))) (X0.rightInverse v)))
};
\definition inKernel: \forall (v: Fourth) -> Image v -> restriction v = fifthGroup.base.unit := \block {
  \fun (v: Fourth)(image: Image v) \then
  \takefrom w: \Cast[Third] ({ w: Third \where forget w = v }) \by image \then
  \return \idelim forget w = v \with x: Fourth => restriction x = fifthGroup.base.unit \by {
    base: kernel w, equality: \bysub(Third, { w: Third \where forget w = v }, w)
  }
};
\definition exact[v: Fourth]: Logic.PropEquiv[restriction v = fifthGroup.base.unit, Image v] := Logic.PropEquiv[_, _] { ltr := preimage v, rtl := inKernel v };
