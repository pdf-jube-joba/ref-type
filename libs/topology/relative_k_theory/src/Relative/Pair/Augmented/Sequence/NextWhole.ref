\definition forward[v: WholeNext.Carrier]: Term.First := v;
\definition backward[v: Term.First]: WholeNext.Carrier := v;
\definition leftInverse: \forall (v: Term.First) -> forward (backward v) = v := \fun (v: Term.First) => \refl(v);
\definition rightInverse: \forall (v: WholeNext.Carrier) -> backward (forward v) = v := \fun (v: WholeNext.Carrier) => \refl(v);
\definition forwardAdd: \forall (v, w: WholeNext.Carrier) -> forward (WholeNext.group.base.op v w) = Term.firstGroup.base.op (forward v) (forward w) := \fun (v, w: WholeNext.Carrier) => \refl(WholeNext.group.base.op v w);
\definition backwardAdd: \forall (v, w: Term.First) -> backward (Term.firstGroup.base.op v w) = WholeNext.group.base.op (backward v) (backward w) := \fun (v, w: Term.First) => \refl(Term.firstGroup.base.op v w);
\definition forwardZero: forward WholeNext.group.base.unit = Term.firstGroup.base.unit := \refl(WholeNext.group.base.unit);
\definition backwardZero: backward Term.firstGroup.base.unit = WholeNext.group.base.unit := \refl(WholeNext.group.base.unit);
