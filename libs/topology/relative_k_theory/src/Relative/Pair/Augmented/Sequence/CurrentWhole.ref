\definition forward[v: WholeDegree.Carrier]: Term.Fourth := v;
\definition backward[v: Term.Fourth]: WholeDegree.Carrier := v;
\definition leftInverse: \forall (v: Term.Fourth) -> forward (backward v) = v := \fun (v: Term.Fourth) => \refl(v);
\definition rightInverse: \forall (v: WholeDegree.Carrier) -> backward (forward v) = v := \fun (v: WholeDegree.Carrier) => \refl(v);
\definition forwardAdd: \forall (v, w: WholeDegree.Carrier) -> forward (WholeDegree.group.base.op v w) = Term.fourthGroup.base.op (forward v) (forward w) := \fun (v, w: WholeDegree.Carrier) => \refl(WholeDegree.group.base.op v w);
\definition backwardAdd: \forall (v, w: Term.Fourth) -> backward (Term.fourthGroup.base.op v w) = WholeDegree.group.base.op (backward v) (backward w) := \fun (v, w: Term.Fourth) => \refl(Term.fourthGroup.base.op v w);
\definition forwardZero: forward WholeDegree.group.base.unit = Term.fourthGroup.base.unit := \refl(WholeDegree.group.base.unit);
\definition backwardZero: backward Term.fourthGroup.base.unit = WholeDegree.group.base.unit := \refl(WholeDegree.group.base.unit);
