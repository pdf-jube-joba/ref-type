\import \root.Relative[].Equivalence[source := Subset.model, target := PointedPair.subsetModel].With[e := SubsetCompare.equivalence].Negative[degree := degree] \as Native;
\definition forward: SubsetDegree.Carrier -> Term.Fifth := Native.backward;
\definition backward: Term.Fifth -> SubsetDegree.Carrier := Native.forward;
\definition leftInverse: \forall (v: Term.Fifth) -> forward (backward v) = v := Native.rightInverse;
\definition rightInverse: \forall (v: SubsetDegree.Carrier) -> backward (forward v) = v := Native.leftInverse;
\definition forwardAdd: \forall (v, w: SubsetDegree.Carrier) -> forward (SubsetDegree.group.base.op v w) = Term.fifthGroup.base.op (forward v) (forward w) := Native.inverseAdditive;
\definition backwardAdd: \forall (v, w: Term.Fifth) -> backward (Term.fifthGroup.base.op v w) = SubsetDegree.group.base.op (backward v) (backward w) := Native.additive;
\definition forwardZero: forward SubsetDegree.group.base.unit = Term.fifthGroup.base.unit := Native.backwardZero;
\definition backwardZero: backward Term.fifthGroup.base.unit = SubsetDegree.group.base.unit := Native.forwardZero;
\import \root.Relative[].NegativeMap[source := Subset.model, target := PointedPair.subsetModel,
  f := SubsetCompare.equivalence.forward, degree := degree] \as Pull;
\definition backwardFormula: \forall (v: Term.Fifth) -> backward v = Pull.map v :=
  \fun (v: Term.Fifth) => congr!{{Term.Fifth -> SubsetDegree.Carrier} {SubsetDegree.Carrier}} (\fun (f: Term.Fifth -> SubsetDegree.Carrier) => f v) _ _ Native.forwardEquality;
