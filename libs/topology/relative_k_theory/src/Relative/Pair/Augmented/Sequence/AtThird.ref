\definition oldKernel: \forall (v: Term.Second) -> Term.forget (Term.boundary v) = Term.fourthGroup.base.unit :=
  \fun (v: Term.Second) => (Term.exactThird (Term.boundary v)).rtl
    (Logic.existsIntro[Term.Second, { w: Term.Second \where Term.boundary w = Term.boundary v }] v (\refl(Term.boundary v)));
\definition kernel: \forall (v: Second) -> forget (boundary v) = fourthGroup.base.unit :=
  \fun (v: Second) => trans!{{Fourth}} _ _ _
    (congr!{{Term.Third} {Fourth}} (\fun (w: Term.Third) => X0.backward (Term.forget w)) _ _ (Q.leftInverse (Term.boundary (A1.forward v))))
    (trans!{{Fourth}} _ _ _ (congr!{{Term.Fourth} {Fourth}} X0.backward _ _ (oldKernel (A1.forward v))) X0.backwardZero);
\definition Image[v: Third]: \Prop := \exists (w: Second \where boundary w = v);
\definition preimage: \forall (v: Third) -> forget v = fourthGroup.base.unit -> Image v := \block {
  \fun (v: Third)(zero: forget v = fourthGroup.base.unit) \then
  \let oldZero: Term.forget (Q.forward v) = Term.fourthGroup.base.unit :=
    trans!{{Term.Fourth}} _ _ _ (sym!{{Term.Fourth}} _ _ (X0.leftInverse (Term.forget (Q.forward v))))
      (trans!{{Term.Fourth}} _ _ _ (congr!{{Fourth} {Term.Fourth}} X0.forward _ _ zero) X0.forwardZero) \then
  \takefrom w: \Cast[Term.Second] ({ w: Term.Second \where Term.boundary w = Q.forward v }) \by (Term.exactThird (Q.forward v)).ltr oldZero \then
  \return Logic.existsIntro[Second, { u: Second \where boundary u = v }] (A1.backward w)
    (trans!{{Third}} _ _ _
      (congr!{{Term.Second} {Third}} (\fun (u: Term.Second) => Q.backward (Term.boundary u)) _ _ (A1.leftInverse w))
      (trans!{{Third}} _ _ _
        (congr!{{Term.Third} {Third}} Q.backward _ _ (\bysub(Term.Second, { w: Term.Second \where Term.boundary w = Q.forward v }, w))) (Q.rightInverse v)))
};
\definition inKernel: \forall (v: Third) -> Image v -> forget v = fourthGroup.base.unit := \block {
  \fun (v: Third)(image: Image v) \then
  \takefrom w: \Cast[Second] ({ w: Second \where boundary w = v }) \by image \then
  \return \idelim boundary w = v \with x: Third => forget x = fourthGroup.base.unit \by {
    base: kernel w, equality: \bysub(Second, { w: Second \where boundary w = v }, w)
  }
};
\definition exact[v: Third]: Logic.PropEquiv[forget v = fourthGroup.base.unit, Image v] := Logic.PropEquiv[_, _] { ltr := preimage v, rtl := inKernel v };
