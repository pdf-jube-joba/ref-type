\import Complements.Projection[X := X, n := t.negative.dimension, baseSpace := space, P := t.negative.projection, regular := t.negative.regular].Complement[] \as Split;
\definition complement: Presentation := Presentation { dimension := t.negative.dimension, projection := Split.Q, regular := Split.qRegular };
\import \parent.Diagonal[p := complement] \as Added;
\import \parent.SumConstruction[t := t, u := Added.triple] \as Sums;
\import Operations.DirectSum[X := X, F := (Absolute.Fiber t.positive), G := (Absolute.Fiber complement), left := (Absolute.bundle t.positive), right := (Absolute.bundle complement)] \as Positive;
\import Operations.DirectSum[X := X, F := (Absolute.Fiber t.negative), G := (Absolute.Fiber complement), left := (Absolute.bundle t.negative), right := (Absolute.bundle complement)] \as Negative;
\definition inclusion[x: A]: X := x;
\definition regular: topology.Continuity[A := A, B := X].Continuous subspace space inclusion := topology.Continuity[A := A, B := X].Corestriction[S := subset].inclusionContinuous space;
\import Bundles.Trivial[X := X, n := t.negative.dimension, baseSpace := space] \as Trivial;
\import Complements.PulledIsomorphism[X := X, Y := A, F := Negative.Fiber, G := (\fun (x: X) => Bundles.Vector t.negative.dimension),
  source := Sums.negativeBundle, target := Trivial.bundle, base := subspace, f := inclusion, sourceRegular := regular, targetRegular := regular] \as Triviality;
\import Bundles.Family[X := X, F := (\fun (x: X) => Bundles.Vector t.negative.dimension)].Of[bundle := Trivial.bundle].Restriction[U := subset] \as BoundaryTrivial;
\import Bundles.Family[X := X, F := Positive.Fiber].Of[bundle := Sums.positiveBundle].Restriction[U := subset] \as BoundaryPositive;
\import Bundles.Family[X := X, F := Negative.Fiber].Of[bundle := Sums.negativeBundle].Restriction[U := subset] \as BoundaryNegative;
\import Operations.IsomorphismComposition[X := A, F := (\fun (x: A) => Positive.Fiber x), G := (\fun (x: A) => Negative.Fiber x), H := (\fun (x: A) => Bundles.Vector t.negative.dimension),
  source := BoundaryPositive.restricted, middle := BoundaryNegative.restricted, target := BoundaryTrivial.restricted] \as Composition;
\definition comparison: Composition.Isomorphism := Composition.compose Sums.sum (Triviality.isomorphism Split.isomorphism);
\import \parent.BundleModel[F := Positive.Fiber].From[original := Sums.positiveBundle, same := (\refl(space))] \as Based;
\import \parent.FramedClass[F := Positive.Fiber, sourceModel := Based.model, n := t.negative.dimension].With[alpha := comparison] \as Class;
\import \parent.Quotient[] \as Quotient;
\definition SourceFiber[x: X]: \Set := Positive.Fiber x;
\definition sourceBundle: Bundles.Family[X := X, F := SourceFiber].Bundle := Sums.positiveBundle;
\definition sourceModel: \parent.BundleModel[F := SourceFiber].Bundle := Based.model;
\definition value: Quotient.Relative := Class.value;
\module Global(w: \parent.\parent.Global[t := t].Witness);
\import \parent.TripleFraming[t := t, auxiliary := complement, n := t.negative.dimension].With[trivialization := Split.isomorphism] \as Framing;
\definition canonicalEquality: value = Framing.value := \refl(value);
