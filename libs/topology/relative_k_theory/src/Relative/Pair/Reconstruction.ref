\import \parent.Normalize[t := t] \as Normalization;
\import \parent.Quotient[] \as Quotient;
\import \parent.Group[] \as RelativeGroup;
\import \parent.FromReduced[] \as ReconstructionMap;
\structure Preimage: \Set := {
  value: Quotient.Relative,
  equation: ReconstructionMap.reduced value = RelativeGroup.value t
};
\module Normalized(normalized: Normalization.Result);
\definition existence: \exists Preimage := \block {
  \takefrom normalized: Normalization.Result \by Normalization.existence \then
  \return Normalized[normalized := normalized].existence
};
