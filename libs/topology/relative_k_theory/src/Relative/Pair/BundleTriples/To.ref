\import \parent.\parent.BundleTriples[F := F, G := G, firstModel := firstModel, secondModel := secondModel] \as Original;
\import \parent.\parent.BundleTriples[F := H, G := I, firstModel := newFirstModel, secondModel := newSecondModel] \as Changed;
\import Bundles.Isomorphisms[X := X, F := F, G := H, source := Original.first, target := Changed.first] \as Positive;
\import Bundles.Isomorphisms[X := X, F := G, G := I, source := Original.second, target := Changed.second] \as Negative;
\module With(alpha: Original.OnSubset, beta: Changed.OnSubset, positive: Positive.Isomorphism, negative: Negative.Isomorphism,
  commutes: \forall (x: A)(v: F x) -> (beta.forward.fiber x).apply ((positive.forward.fiber x).apply v) = (negative.forward.fiber x).apply ((alpha.forward.fiber x).apply v));
