\definition preimage: Negative.Fiber x := (h.backward.fiber x).apply t;
\definition b: G x := Product.first (G x) (H x) preimage;
\definition c: H x := Product.second (G x) (H x) preimage;
\definition exchanged: FG.Fiber x := (switch.exchange.forward.fiber x).apply (Product.pair (F x) (G x) v b);
\definition exchangeFirst: Product.first (F x) (G x) exchanged = (alpha.backward.fiber x).apply b :=
  congr!{{FG.Fiber x} {F x}} (Product.first (F x) (G x)) _ _ (switch.exchangeFormula x v b);
\definition exchangeSecond: Product.second (F x) (G x) exchanged = (alpha.forward.fiber x).apply v :=
  congr!{{FG.Fiber x} {G x}} (Product.second (F x) (G x)) _ _ (switch.exchangeFormula x v b);
\definition recovered: (alpha.forward.fiber x).apply (Product.first (F x) (G x) exchanged) = b :=
  trans!{{G x}} _ _ _ (congr!{{F x} {G x}} (alpha.forward.fiber x).apply _ _ exchangeFirst) (alpha.rightInverse x b);
\definition firstFormula: (comparison.forward.fiber x).apply (Product.pair (F x) (H x) (Product.first (F x) (G x) exchanged) c) = t :=
  trans!{{Bundles.Vector n}} _ _ _ (formula x (Product.first (F x) (G x) exchanged) c)
    (trans!{{Bundles.Vector n}} _ _ _
      (congr!{{Negative.Fiber x} {Bundles.Vector n}} (h.forward.fiber x).apply _ _
        (Product.Prop[A := G x, B := H x].pairCong _ _ _ _ recovered (\refl(c))))
      (trans!{{Bundles.Vector n}} _ _ _
        (congr!{{Negative.Fiber x} {Bundles.Vector n}} (h.forward.fiber x).apply _ _ (Product.Prop[A := G x, B := H x].eta preimage))
        (h.rightInverse x t)));
\definition equation:
  Product.pair (Bundles.Vector n) (G x)
    ((comparison.forward.fiber x).apply (Product.first (Positive.Fiber x) (G x) ((isomorphism.forward.fiber x).apply (Product.pair (F x) (Bundles.Vector n) v t))))
    (Product.second (Positive.Fiber x) (G x) ((isomorphism.forward.fiber x).apply (Product.pair (F x) (Bundles.Vector n) v t))) =
  Product.pair (Bundles.Vector n) (G x) t ((alpha.forward.fiber x).apply v) :=
  Product.Prop[A := Bundles.Vector n, B := G x].pairCong _ _ _ _ firstFormula exchangeSecond;
