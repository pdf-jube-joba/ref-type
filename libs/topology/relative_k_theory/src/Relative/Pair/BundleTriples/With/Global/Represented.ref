\import Bundles.Isomorphisms[X := X, F := F, G := Absolute.Fiber r.value.positive, source := first, target := Absolute.bundle r.value.positive] \as Positive;
\import Operations.IsomorphismComposition[X := X, F := Absolute.Fiber r.value.positive, G := F, H := G,
  source := Absolute.bundle r.value.positive, middle := first, target := second] \as Start;
\definition start: Start.Isomorphism := Start.compose (Positive.inverse r.positive) isomorphism;
\import Operations.IsomorphismComposition[X := X, F := Absolute.Fiber r.value.positive, G := G, H := Absolute.Fiber r.value.negative,
  source := Absolute.bundle r.value.positive, middle := second, target := Absolute.bundle r.value.negative] \as Finish;
\definition comparison: Finish.Isomorphism := Finish.compose start r.negative;
\definition witness: \parent.\parent.\parent.\parent.Global[t := r.value].Witness := \parent.\parent.\parent.\parent.Global[t := r.value].Witness {
  isomorphism := comparison,
  agrees := \fun (x: A)(a: Absolute.Fiber r.value.positive x) =>
    trans!{{Absolute.Fiber r.value.negative x}} _ _ _
      (congr!{{G x} {Absolute.Fiber r.value.negative x}} (r.negative.forward.fiber x).apply _ _ (agrees x ((r.positive.backward.fiber x).apply a)))
      (trans!{{Absolute.Fiber r.value.negative x}} _ _ _
        (sym!{{Absolute.Fiber r.value.negative x}} _ _ (r.agrees x ((r.positive.backward.fiber x).apply a)))
        (congr!{{Absolute.Fiber r.value.positive x} {Absolute.Fiber r.value.negative x}} (r.value.comparison.forward.fiber x).apply _ _
          ((\bysub(Positive.Data, Positive.Isomorphism, r.positive)).rightInverse x a)))
};
