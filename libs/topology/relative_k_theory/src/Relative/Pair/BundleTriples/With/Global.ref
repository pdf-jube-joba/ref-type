\module Represented(r: Represent.Result[alpha]);
\definition equation: value = Group.zero := \block {
  \takefrom r: Represent.Result[alpha] \by Represent.existence alpha \then
  \return trans!{{Group.Carrier}} _ _ _ (agreement r) (Group.globalZero r.value Represented[r := r].witness)
};
\definition reducedZero: reduced = (Quotient.group.base).unit := trans!{{Quotient.Relative}} _ _ _
  (congr!{{Group.Carrier} {Quotient.Relative}} Group.ToReduced[].map _ _ equation) Group.ToReduced[].preservesZero;
