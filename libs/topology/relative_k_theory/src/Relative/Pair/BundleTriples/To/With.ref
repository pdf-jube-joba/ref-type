\import Original.With[alpha := alpha] \as First;
\import Changed.With[alpha := beta] \as Second;
\import \parent.\parent.\parent.BundleChange[F := F, G := G, source := Original.first, target := Original.second,
  sourceSame := (\refl(space)), targetSame := (\refl(space))].To[H := H, I := I, newSource := Changed.first, newTarget := Changed.second,
  newSourceSame := (\refl(space)), newTargetSame := (\refl(space))] \as Change;
\import \parent.\parent.\parent.FromBundles[F := F, G := G, source := Original.first, target := Original.second, sourceSame := (\refl(space)), targetSame := (\refl(space))] \as Source;
\import \parent.\parent.\parent.FromBundles[F := H, G := I, source := Changed.first, target := Changed.second, sourceSame := (\refl(space)), targetSame := (\refl(space))] \as Target;
\definition equation: First.value = Second.value := \block {
  \takefrom r: Source.Result[alpha] \by Source.existence alpha \then
  \takefrom s: Target.Result[beta] \by Target.existence beta \then
  \return trans!{{Group.Carrier}} _ _ _ (First.agreement r)
    (trans!{{Group.Carrier}} _ _ _ (Change.On[alpha := alpha, beta := beta, first := r, second := s].With[w := Change.On[alpha := alpha, beta := beta, first := r, second := s].Witness {
      positive := positive, negative := negative, commutes := commutes
    }].equation) (sym!{{Group.Carrier}} _ _ (Second.agreement s)))
};
\definition reducedEquation: First.reduced = Second.reduced := congr!{{Group.Carrier} {Quotient.Relative}} Group.ToReduced[].map _ _ equation;
