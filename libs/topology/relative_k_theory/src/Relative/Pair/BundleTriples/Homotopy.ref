\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := A] \as Cylinder;
\import Bundles.Family[X := A, F := (\fun (x: A) => F x)].Of[bundle := Represent.restrictedSource].Pullback[
  Y := Cylinder.Carrier, source := Cylinder.topology subspace, f := Cylinder.point] \as Positive;
\import Bundles.Family[X := A, F := (\fun (x: A) => G x)].Of[bundle := Represent.restrictedTarget].Pullback[
  Y := Cylinder.Carrier, source := Cylinder.topology subspace, f := Cylinder.point] \as Negative;
\import Bundles.Isomorphisms[X := Cylinder.Carrier, F := (\fun (z: Cylinder.Carrier) => F (Cylinder.point z)), G := (\fun (z: Cylinder.Carrier) => G (Cylinder.point z)),
  source := Positive.pulled (Cylinder.pointContinuous subspace), target := Negative.pulled (Cylinder.pointContinuous subspace)] \as Maps;
\structure Family: \Set := {
  isomorphism: Maps.Isomorphism,
  start: \forall (x: A)(v: F x) -> (isomorphism.forward.fiber (Cylinder.at I.start x)).apply v = (alpha.forward.fiber x).apply v,
  end: \forall (x: A)(v: F x) -> (isomorphism.forward.fiber (Cylinder.at I.end x)).apply v = (beta.forward.fiber x).apply v
};
\module With(family: Family);
