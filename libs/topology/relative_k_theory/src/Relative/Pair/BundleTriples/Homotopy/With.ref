\import Absolute.Bundle[F := F, original := first, same := (\refl(space))] \as FirstClass;
\import Absolute.Bundle[F := G, original := second, same := (\refl(space))] \as SecondClass;
\import \parent.\parent.With[alpha := alpha] \as Left;
\import \parent.\parent.With[alpha := beta] \as Right;
\module Using(p, q: Presentation, positive: FirstClass.Isomorphism p, negative: SecondClass.Isomorphism q);
\definition equation: Left.value = Right.value := \block {
  \takefrom p: FirstClass.Representative \by FirstClass.representativeExists \then
  \takefrom q: SecondClass.Representative \by SecondClass.representativeExists \then
  \return Using[p := p.presentation, q := q.presentation, positive := p.isomorphism, negative := q.isomorphism].equation
};
\definition reducedEquation: Left.reduced = Right.reduced := congr!{{Group.Carrier} {Quotient.Relative}} Group.ToReduced[].map _ _ equation;
