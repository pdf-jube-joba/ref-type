\import Complements.PulledIsomorphism[X := X, Y := A, F := Positive.Fiber, G := Absolute.Fiber p, source := positiveBundle, target := Absolute.bundle p,
  base := subspace, f := inclusion, sourceRegular := regular, targetRegular := regular] \as PositivePull;
\import Complements.PulledIsomorphism[X := X, Y := A, F := Negative.Fiber, G := Absolute.Fiber q, source := negativeBundle, target := Absolute.bundle q,
  base := subspace, f := inclusion, sourceRegular := regular, targetRegular := regular] \as NegativePull;
\import Bundles.Isomorphisms[X := A, F := (\fun (x: A) => Positive.Fiber x), G := \parent.\parent.Restricted[p := p].Fiber,
  source := first, target := \parent.\parent.Restricted[p := p].bundle] \as Reverse;
\import Operations.IsomorphismComposition[X := A, F := \parent.\parent.Restricted[p := p].Fiber,
  G := (\fun (x: A) => Positive.Fiber x), H := (\fun (x: A) => Negative.Fiber x),
  source := \parent.\parent.Restricted[p := p].bundle, middle := first, target := second] \as First;
\definition start: First.Isomorphism := First.compose (Reverse.inverse (PositivePull.isomorphism positive)) sum;
\import Operations.IsomorphismComposition[X := A, F := \parent.\parent.Restricted[p := p].Fiber,
  G := (\fun (x: A) => Negative.Fiber x), H := \parent.\parent.Restricted[p := q].Fiber,
  source := \parent.\parent.Restricted[p := p].bundle, middle := second, target := \parent.\parent.Restricted[p := q].bundle] \as Second;
\definition triple: Triple := Triple { positive := p, negative := q, comparison := Second.compose start (NegativePull.isomorphism negative) };
\import Bundles.Isomorphisms[X := X, F := Positive.Fiber, G := Absolute.Fiber p, source := positiveBundle, target := Absolute.bundle p] \as PositiveIsomorphisms;
\module At(x: A);
\definition witness: \parent.\parent.Sum[t := t, u := u, v := triple].Witness := \parent.\parent.Sum[t := t, u := u, v := triple].Witness {
  positive := positive, negative := negative,
  agrees := \fun (x: A) => At[x := x].equation
};
