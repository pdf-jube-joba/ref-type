\import std.Data[].Pair[] \as Pair;
\definition image[v: Positive.Fiber x]: Absolute.Fiber q x := (negative.forward.fiber x).apply
  (Pair.pair (Absolute.Fiber t.negative x) (Absolute.Fiber u.negative x)
    ((t.comparison.forward.fiber x).apply (Pair.first (Absolute.Fiber t.positive x) (Absolute.Fiber u.positive x) v))
    ((u.comparison.forward.fiber x).apply (Pair.second (Absolute.Fiber t.positive x) (Absolute.Fiber u.positive x) v)));
\definition equation: \forall (v: Absolute.Fiber t.positive x)(w: Absolute.Fiber u.positive x) ->
  (triple.comparison.forward.fiber x).apply ((positive.forward.fiber x).apply (Pair.pair (Absolute.Fiber t.positive x) (Absolute.Fiber u.positive x) v w)) =
  image (Pair.pair (Absolute.Fiber t.positive x) (Absolute.Fiber u.positive x) v w) :=
  \fun (v: Absolute.Fiber t.positive x)(w: Absolute.Fiber u.positive x) => congr!{{Positive.Fiber x} {Absolute.Fiber q x}} image _ _
    ((\bysub(PositiveIsomorphisms.Data, PositiveIsomorphisms.Isomorphism, positive)).leftInverse x (Pair.pair (Absolute.Fiber t.positive x) (Absolute.Fiber u.positive x) v w));
