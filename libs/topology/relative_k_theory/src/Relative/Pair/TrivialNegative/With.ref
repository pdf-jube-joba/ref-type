\definition comparison: BoundaryComposition.Isomorphism := BoundaryComposition.compose t.comparison (Pull.isomorphism h);
\import \parent.\parent.FramedClass[F := E, sourceModel := model, n := n].With[alpha := comparison] \as Class;
\definition value: Quotient.Relative := Class.value;
\module Using(result: ZeroRepresentation.Representative);
\definition equation: Canonical.value = value := \block {
  \takefrom result: ZeroRepresentation.Representative \by ZeroRepresentation.representativeExists \then
  \return Using[result := result].equation
};
