\import Complements.Projection[X := X, n := t.negative.dimension, baseSpace := space, P := t.negative.projection, regular := t.negative.regular].Complement[] \as Split;
\definition complement: Presentation := Presentation { dimension := t.negative.dimension, projection := Split.Q, regular := Split.qRegular };
\import \parent.Diagonal[p := complement] \as Added;
\import \parent.SumConstruction[t := t, u := Added.triple] \as Sums;
\import \parent.Group[] \as Group;
\structure Result: \Set := {
  value: Triple,
  dimension: N.Nat^,
  trivialization: Bundles.Isomorphisms[X := X, F := Absolute.Fiber value.negative, G := (\fun (x: X) => Bundles.Vector dimension),
    source := Absolute.bundle value.negative, target := Bundles.Trivial[X := X, n := dimension, baseSpace := space].bundle].Isomorphism,
  equality: Group.value t = Group.value value
};
\module With(result: Sums.Result);
\definition existence: \exists Result := \block {
  \takefrom result: Sums.Result \by Sums.existence \then
  \return \exact(With[result := result].normalized, Result)
};
\module ToDescent(result: Result);
