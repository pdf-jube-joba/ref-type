\import \parent.\parent.BundleModel[F := G] \as TargetModel;
\definition targetBundle: Bundles.Family[X := X, F := G].Bundle := TargetModel.bundle targetModel;
\import \root.Relative[].Descent[X := X, F := G, bundle := targetBundle, compact := compact, hausdorff := hausdorff, subset := subset, closed := closed, dimension := m] \as TargetDescent;
\import Bundles.Isomorphisms[X := X, F := F, G := G, source := framedBundle, target := targetBundle] \as GlobalIsomorphisms;
\import Spaces.Isomorphism[V := Bundles.Vector n, W := Bundles.Vector m, source := Bundles.coordinates n, target := Bundles.coordinates m] \as CoordinateIsomorphisms;
\import \parent.\parent.FramedBundleIsomorphisms[F := F, G := G, sourceModel := sourceModel, targetModel := targetModel, n := n, m := m] \as Comparison;
\import \parent.\parent.FramedClass[F := G, sourceModel := targetModel, n := m] \as TargetClass;
\module With(alpha: Descent.OnSubset, beta: TargetDescent.OnSubset, h: GlobalIsomorphisms.Isomorphism, c: CoordinateIsomorphisms.Isomorphism,
  compatible: \forall (x: A)(v: F x) -> (beta.forward.fiber x).apply ((h.forward.fiber x).apply v) = c.forward.apply ((alpha.forward.fiber x).apply v));
