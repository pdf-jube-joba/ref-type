\import Bundles.Trivial[X := X, n := k, baseSpace := space] \as Trivial;
\import \parent.\parent.\parent.BundleModel[F := (\fun (x: X) => Bundles.Vector k)].From[original := Trivial.bundle, same := (\refl(space))] \as TrivialModel;
\import Bundles.Family[X := X, F := (\fun (x: X) => Bundles.Vector k)].Of[bundle := Trivial.bundle].Restriction[U := subset] \as TrivialRestriction;
\import Operations.IdentityIsomorphism[X := A, F := (\fun (x: A) => Bundles.Vector k), bundle := TrivialRestriction.restricted] \as BoundaryIdentity;
\import Operations.IdentityIsomorphism[X := X, F := (\fun (x: X) => Bundles.Vector k), bundle := Trivial.bundle] \as GlobalIdentity;
\import \parent.\parent.\parent.FramedClass[F := (\fun (x: X) => Bundles.Vector k), sourceModel := TrivialModel.model, n := k].With[alpha := BoundaryIdentity.isomorphism] \as TrivialClass;
\import TrivialClass.Global[h := GlobalIdentity.isomorphism, extends := (\fun (x: A)(v: Bundles.Vector k) => \refl(v))] \as Vanishing;
\import \parent.\parent.\parent.FramedSum[F := F, G := (\fun (x: X) => Bundles.Vector k), sourceModel := sourceModel, targetModel := TrivialModel.model, n := n, m := k].With[
  alpha := alpha, beta := BoundaryIdentity.isomorphism] \as Sum;
\import algebra.Group[].Of[Carrier := Quotient.Relative, group := Quotient.group] \as ReducedGroup;
\definition stabilized: Quotient.Relative := Sum.value;
\definition equation: stabilized = value := trans!{{Quotient.Relative}} _ _ _ (sym!{{Quotient.Relative}} _ _ Sum.additivity)
  (trans!{{Quotient.Relative}} _ _ _ (congr!{{Quotient.Relative} {Quotient.Relative}} (ReducedGroup.add value) _ _ Vanishing.equation) (ReducedGroup.zeroRight value));
