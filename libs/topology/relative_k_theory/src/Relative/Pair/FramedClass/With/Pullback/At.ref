\import Source.Construction[extension := e] \as Construction;
\import Construction.Compare[] \as Comparison;
\import \parent.\parent.Value[e := e] \as Value;
\import K.Bundle[F := Source.Fiber, original := Construction.bundleOnQuotient, same := Construction.sameBaseSpace] \as DescendedClass;
\import Pull.Of[F := Source.Fiber, original := Construction.bundleOnQuotient, same := Construction.sameBaseSpace] \as Pulled;
\import Absolute.Compare[F := (\fun (x: X) => Source.Fiber (Quotient.projection x)), G := F,
  first := Pulled.pulled, second := framedBundle, firstSame := (\refl(space)), secondSame := (\refl(space))] \as CompareOriginal;
\import Bundles.Trivial[X := Quotient.Carrier, n := n, baseSpace := Quotient.topology] \as Trivial;
\import Pull.Of[F := (\fun (q: Quotient.Carrier) => Bundles.Vector n), original := Trivial.bundle, same := (\refl(Quotient.topology))] \as PulledTrivial;
\import Operations.TrivialPullback[X := Quotient.Carrier, Y := X, n := n, original := Quotient.topology, base := space,
  f := Quotient.projection, regular := Quotient.continuous] \as TrivialIso;
\import Absolute.Compare[F := (\fun (x: X) => Bundles.Vector n), G := (\fun (x: X) => Bundles.Vector n),
  first := PulledTrivial.pulled, second := Bundles.Trivial[X := X, n := n, baseSpace := space].bundle,
  firstSame := (\refl(space)), secondSame := (\refl(space))] \as CompareTrivial;
\definition originalEquation: Pull.map DescendedClass.value = OriginalClass.value :=
  trans!{{Absolute.Classes}} _ _ _ Pulled.naturality (CompareOriginal.ofIsomorphism Comparison.isomorphism);
\definition trivialEquation: Pull.map TrivialClass.value = OrdinaryTrivial.value :=
  trans!{{Absolute.Classes}} _ _ _ PulledTrivial.naturality (CompareTrivial.ofIsomorphism TrivialIso.isomorphism);
\definition equation: PullK.map Value.value = difference :=
  trans!{{Ordinary.Carrier}} _ _ _ (Pull.Ranks[].Difference[a := DescendedClass.value, b := TrivialClass.value].difference)
    (congr!{{Absolute.Classes} {Absolute.Classes} {Ordinary.Carrier}} Ordinary.difference _ _ _ _ originalEquation trivialEquation);
