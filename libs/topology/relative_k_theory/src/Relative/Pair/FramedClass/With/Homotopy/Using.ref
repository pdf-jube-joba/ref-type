\definition fixedLaws: Frames.Laws[Fixed.isomorphism] := \bysub(Frames.Data, Frames.Isomorphism, Fixed.isomorphism);
\import Operations.IsomorphismComposition[X := Boundary.Carrier, F := (\fun (z: Boundary.Carrier) => F (Boundary.point z)), G := (\fun (z: Boundary.Carrier) => Bundles.Vector n), H := (\fun (z: Boundary.Carrier) => F (Boundary.point z)),
  source := Fixed.source, middle := Fixed.target, target := Fixed.source] \as Composition;
\definition path: Gauge.Path := Gauge.Path {
  isomorphism := Composition.compose family.isomorphism (Frames.inverse Fixed.isomorphism),
  starts := \fun (z: Boundary.Carrier)(same: Boundary.time z = Interval.start)(v: F (Boundary.point z)) =>
    trans!{{F (Boundary.point z)}} _ _ _
      (congr!{{Bundles.Vector n} {F (Boundary.point z)}} (Fixed.isomorphism.backward.fiber z).apply _ _ (family.start z same v)) (fixedLaws.leftInverse z v)
};
\import Gauge.With[path := path] \as Extension;
\module On(extension: Extension.Result);
\definition equation: value = Changed.value := \block {
  \takefrom extension: Extension.Result \by Extension.existence \then
  \return On[extension := extension].equation
};
