\definition compatible: \forall (x: A)(v: F x) -> (alpha.forward.fiber x).apply ((extension.isomorphism.forward.fiber x).apply v) = coordinateIdentity.forward.apply ((beta.forward.fiber x).apply v) :=
  \fun (x: A)(v: F x) => trans!{{Bundles.Vector n}} _ _ _
    (congr!{{F x} {Bundles.Vector n}} (alpha.forward.fiber x).apply _ _ (extension.extends x v))
    (trans!{{Bundles.Vector n}} _ _ _ (fixedLaws.rightInverse (endpoint x) ((family.isomorphism.forward.fiber (endpoint x)).apply v)) (family.end x v));
\import \parent.\parent.\parent.\parent.To[G := F, targetModel := sourceModel, m := n].With[
  alpha := beta, beta := alpha, h := extension.isomorphism, c := coordinateIdentity, compatible := compatible] \as Comparison;
\definition equation: value = Changed.value := sym!{Quotient.Relative} Changed.value value Comparison.equation;
