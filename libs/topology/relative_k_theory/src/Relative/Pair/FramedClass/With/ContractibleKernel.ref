\import Absolute.K0[] \as BaseK;
\import Absolute.Bundle[F := F, original := framedBundle, same := (\refl(space))] \as BundleClass;
\import Bundles.Trivial[X := X, n := n, baseSpace := space] \as OriginalTrivial;
\import BaseK.Stability[].ForBundles[F := F, G := (\fun (x: X) => Bundles.Vector n), first := framedBundle, second := OriginalTrivial.bundle,
  firstSame := (\refl(space)), secondSame := (\refl(space))] \as Stability;
\import algebra.Group[].Of[Carrier := Quotient.Relative, group := Quotient.group] \as ReducedGroup;
\module At(k: N.Nat^, iso: Stability.At[n := k].Isomorphism);
\definition equation: BaseK.include BundleClass.value = BaseK.include (Absolute.Trivial[n := n].value) -> value = ReducedGroup.zero := \block {
  \fun (equal: BaseK.include BundleClass.value = BaseK.include (Absolute.Trivial[n := n].value)) \then
  \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where \exists Stability.At[n := k].Isomorphism }) \by Stability.criterion.ltr equal \then
  \takefrom iso: Stability.At[n := k].Isomorphism \by \bysub(N.Nat^, { k: N.Nat^ \where \exists Stability.At[n := k].Isomorphism }, k) \then
  \return At[k := k, iso := iso].equation
};
