\import K.Pullback[Y := X, space := space, sourceCompact := compact, sourceHausdorff := hausdorff,
  f := Quotient.projection, regular := Quotient.continuous] \as Pull;
\import Pull.K0[] \as PullK;
\import Absolute.K0[] \as Ordinary;
\import Absolute.Bundle[F := F, original := framedBundle, same := (\refl(space))] \as OriginalClass;
\import Absolute.Trivial[n := n] \as OrdinaryTrivial;
\definition difference: Ordinary.Carrier := Ordinary.difference OriginalClass.value OrdinaryTrivial.value;
\module At(e: Source.Result);
\definition equation: PullK.map value = difference := \block {
  \takefrom witness: Descent.Witness[alpha] \by Descent.descend alpha \then
  \return trans!{{Ordinary.Carrier}} _ _ _
    (congr!{{Quotient.Relative} {Ordinary.Carrier}} (\fun (v: Quotient.Relative) => PullK.map v) _ _ (agreement witness.extension))
    (At[e := witness.extension].equation)
};
