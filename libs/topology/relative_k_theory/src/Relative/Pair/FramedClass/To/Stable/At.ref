\import SourceClass.Stabilized[k := k] \as First;
\import ChangedClass.Stabilized[k := l] \as Second;
\import Bundles.Isomorphisms[X := X, F := First.Fiber, G := Second.Fiber, source := First.bundle, target := Second.bundle] \as Isomorphisms;
\import Spaces.Isomorphism[V := Bundles.Vector First.dimension, W := Bundles.Vector Second.dimension, source := Bundles.coordinates First.dimension, target := Bundles.coordinates Second.dimension] \as Coordinates;
\structure Witness: \Set := {
  isomorphism: Isomorphisms.Isomorphism,
  coordinates: Coordinates.Isomorphism,
  compatible: \forall (x: A)(v: First.Fiber x) -> (Second.frame.forward.fiber x).apply ((isomorphism.forward.fiber x).apply v) = coordinates.forward.apply ((First.frame.forward.fiber x).apply v)
};
\module With(w: Witness);
