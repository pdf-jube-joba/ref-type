\import \parent.\parent.\parent.\parent.\parent.FramedClass[F := First.Fiber, sourceModel := First.bundleModel, n := First.dimension].To[
  G := Second.Fiber, targetModel := Second.bundleModel, m := Second.dimension].With[
  alpha := First.frame, beta := Second.frame, h := w.isomorphism, c := w.coordinates, compatible := w.compatible] \as Comparison;
\definition equation: SourceClass.value = ChangedClass.value := trans!{{Quotient.Relative}} _ _ _ (sym!{{Quotient.Relative}} _ _ First.equation)
