\import \parent.\parent.With[alpha := alpha] \as SourceClass;
\import TargetClass.With[alpha := beta] \as ChangedClass;
\import Descent.With[comparison := alpha] \as First;
\import TargetDescent.With[comparison := beta] \as Second;
\import Comparison.With[alpha := alpha, beta := beta, h := h, c := c, compatible := compatible] \as Compare;
\import K.K0[] \as K0;
\import Bundles.Trivial[X := Quotient.Carrier, n := n, baseSpace := Quotient.topology] \as FirstTrivial;
\import Bundles.Trivial[X := Quotient.Carrier, n := m, baseSpace := Quotient.topology] \as SecondTrivial;
\import Operations.TrivialIsomorphism[X := Quotient.Carrier, n := n, m := m, base := Quotient.topology, linear := c] \as TrivialIsomorphism;
\import K.Compare[F := (\fun (q: Quotient.Carrier) => Bundles.Vector n), G := (\fun (q: Quotient.Carrier) => Bundles.Vector m),
  first := FirstTrivial.bundle, second := SecondTrivial.bundle, firstSame := (\refl(Quotient.topology)), secondSame := (\refl(Quotient.topology))] \as TrivialClasses;
\module Between(first: First.Result, second: Second.Result);
\definition equation: SourceClass.value = ChangedClass.value := \block {
  \takefrom first: Descent.Witness[alpha] \by Descent.descend alpha \then
  \takefrom second: TargetDescent.Witness[beta] \by TargetDescent.descend beta \then
  \return trans!{{Quotient.Relative}} _ _ _ (SourceClass.agreement first.extension)
    (trans!{{Quotient.Relative}} _ _ _ (Between[first := first.extension, second := second.extension].equation)
      (sym!{{Quotient.Relative}} _ _ (ChangedClass.agreement second.extension)))
};
