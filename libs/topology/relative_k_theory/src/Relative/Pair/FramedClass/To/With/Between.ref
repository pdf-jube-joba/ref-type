\import First.Construction[extension := first] \as FirstConstruction;
\import Second.Construction[extension := second] \as SecondConstruction;
\import K.Compare[F := First.Fiber, G := Second.Fiber, first := FirstConstruction.bundleOnQuotient, second := SecondConstruction.bundleOnQuotient,
  firstSame := FirstConstruction.sameBaseSpace, secondSame := SecondConstruction.sameBaseSpace] \as BundleClasses;
\import Compare.Between[first := first, second := second] \as Isomorphism;
\import SourceClass.Value[e := first] \as FirstValue;
\import ChangedClass.Value[e := second] \as SecondValue;
\definition equation: FirstValue.value = SecondValue.value :=
  congr!{{K.Classes} {K.Classes} {K0.Carrier}} K0.difference _ _ _ _ (BundleClasses.ofIsomorphism Isomorphism.isomorphism)
    (TrivialClasses.ofIsomorphism TrivialIsomorphism.isomorphism);
