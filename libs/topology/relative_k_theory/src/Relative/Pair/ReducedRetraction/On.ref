\import \parent.Bundle[p := p] \as First;
\import \parent.Bundle[p := q] \as Second;
\module With(first: First.Witness, second: Second.Witness);
\definition equation: P (K0.difference (K.class p) (K.class q)) := \block {
  \fun (zero: Ranks.rank (K0.difference (K.class p) (K.class q)) Quotient.point = Integer.Zero.specification) \then
  \takefrom first: First.Witness \by First.existence \then
  \takefrom second: Second.Witness \by Second.existence \then
  \return With[first := first, second := second].equation zero
};
