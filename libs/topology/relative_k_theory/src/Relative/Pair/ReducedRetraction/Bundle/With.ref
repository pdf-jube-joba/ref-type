\definition contains: topology.Topology[Carrier := Quotient.Carrier].Member raw.chart.domain Quotient.point :=
  \bysub(Bundles.Family[X := Quotient.Carrier, F := (K.Fiber p)].With[data := (K.bundle p)].Chart,
    { c: Bundles.Family[X := Quotient.Carrier, F := (K.Fiber p)].With[data := (K.bundle p)].Chart \where topology.Topology[Carrier := Quotient.Carrier].Member c.domain Quotient.point }, raw.chart);
\import \parent.\parent.\parent.QuotientComparison[F := (K.Fiber p), bundle := (K.bundle p), same := (\refl(Quotient.topology))].In[
  c := raw.chart, contains := contains, result := raw.result] \as Compare;
\definition dimension: N.Nat^ := raw.chart.dimension;
\definition equation: image (Backward.classes (K.class p)) = K0.difference (K.class p) (K.Trivial[n := dimension].value) :=
  trans!{{K0.Carrier}} _ _ _ (congr!{{RelativeGroup.Carrier} {K0.Carrier}} image _ _ (Backward.onClasses p))
    (trans!{{K0.Carrier}} _ _ _ Compare.equation
      (congr!{{K.Classes} {K0.Carrier}} (\fun (a: K.Classes) => K0.difference a (K.Trivial[n := dimension].value)) _ _ (K.Realized[p := p].equation)));
\definition rankEquation: Ranks.classes (K.class p) Quotient.point = Ranks.natural dimension :=
  trans!{{Integer.Int^}} _ _ _
    (sym!{{Integer.Int^}} _ _ (congr!{{K.Classes} {Integer.Int^}} (\fun (a: K.Classes) => Ranks.classes a Quotient.point) _ _ (K.Realized[p := p].equation))) Compare.rankEquation;
