\import First.With[raw := first] \as FirstComparison;
\import Second.With[raw := second] \as SecondComparison;
\definition rankDifference: Ranks.rank (K0.difference (K.class p) (K.class q)) Quotient.point =
  IntegerGroup.difference (Ranks.classes (K.class p) Quotient.point) (Ranks.classes (K.class q) Quotient.point) :=
  congr!{{K.IntegerFunctions[].Carrier} {Integer.Int^}} (\fun (f: K.IntegerFunctions[].Carrier) => f Quotient.point) _ _ (Ranks.rankDifference (K.class p) (K.class q));
\module AtZero(zero: Ranks.rank (K0.difference (K.class p) (K.class q)) Quotient.point = Integer.Zero.specification);
\definition equation: P (K0.difference (K.class p) (K.class q)) :=
  \fun (zero: Ranks.rank (K0.difference (K.class p) (K.class q)) Quotient.point = Integer.Zero.specification) => AtZero[zero := zero].equation;
