\definition naturalRanks: IntegerGroup.difference (Ranks.natural FirstComparison.dimension) (Ranks.natural SecondComparison.dimension) = IntegerGroup.zero :=
  trans!{{Integer.Int^}} _ _ _
    (congr!{{Integer.Int^} {Integer.Int^} {Integer.Int^}} IntegerGroup.difference _ _ _ _
      (sym!{{Integer.Int^}} _ _ FirstComparison.rankEquation) (sym!{{Integer.Int^}} _ _ SecondComparison.rankEquation))
    (trans!{{Integer.Int^}} _ _ _ (sym!{{Integer.Int^}} _ _ rankDifference) zero);
\definition equalRanks: Ranks.natural FirstComparison.dimension = Ranks.natural SecondComparison.dimension :=
  IntegerGroup.cancelRight (IntegerGroup.neg (Ranks.natural SecondComparison.dimension)) _ _
    (trans!{{Integer.Int^}} _ _ _ naturalRanks (sym!{{Integer.Int^}} _ _ (IntegerGroup.inverseRight (Ranks.natural SecondComparison.dimension))));
\definition sameDimension: FirstComparison.dimension = SecondComparison.dimension := naturalInjective FirstComparison.dimension SecondComparison.dimension equalRanks;
\definition sameTrivial: K0.include (K.Trivial[n := FirstComparison.dimension].value) = K0.include (K.Trivial[n := SecondComparison.dimension].value) :=
  congr!{{N.Nat^} {K0.Carrier}} (\fun (n: N.Nat^) => K0.include (K.Trivial[n := n].value)) _ _ sameDimension;
\definition cancelRanks:
  Additive.difference (K0.difference (K.class p) (K.Trivial[n := FirstComparison.dimension].value)) (K0.difference (K.class q) (K.Trivial[n := SecondComparison.dimension].value)) = K0.difference (K.class p) (K.class q) :=
  trans!{{K0.Carrier}} _ _ _
    (congr!{{K0.Carrier} {K0.Carrier}}
      (\fun (v: K0.Carrier) => Additive.difference (K0.difference (K.class p) (K.Trivial[n := FirstComparison.dimension].value)) (Additive.difference (K0.include (K.class q)) v)) _ _ (sym!{{K0.Carrier}} _ _ sameTrivial))
    (cancelCommon (K0.include (K.class p)) (K0.include (K.class q)) (K0.include (K.Trivial[n := FirstComparison.dimension].value)));
\definition equation: composite (K0.difference (K.class p) (K.class q)) = K0.difference (K.class p) (K.class q) :=
  trans!{{K0.Carrier}} _ _ _ (onDifference (K.class p) (K.class q))
    (trans!{{K0.Carrier}} _ _ _ (congr!{{K0.Carrier} {K0.Carrier} {K0.Carrier}} Additive.difference _ _ _ _ FirstComparison.equation SecondComparison.equation) cancelRanks);
