\definition data: GlobalMaps.Data := GlobalMaps.Data { fiber := \fun (x: X) => a.fiber (intoLocal x) };
\definition localContinuous: topology.Continuity[A := LocalFamily.Point, B := Original.Point].Continuous Local.first.totalSpace bundle.totalSpace (\fun (p: LocalFamily.Point) => lower (LocalMaps.total a p)) :=
  topology.Composition[A := LocalFamily.Point, B := LocalFamily.Point, C := Original.Point].composeContinuous Local.first.totalSpace Local.first.totalSpace bundle.totalSpace (LocalMaps.total a) lower
    (LocalMaps.continuous a) lowerContinuous;
\definition continuous: topology.Continuity[A := Original.Point, B := Original.Point].Continuous bundle.totalSpace bundle.totalSpace (GlobalMaps.total data) :=
  topology.Composition[A := Original.Point, B := LocalFamily.Point, C := Original.Point].composeContinuous bundle.totalSpace Local.first.totalSpace bundle.totalSpace lift
    (\fun (p: LocalFamily.Point) => lower (LocalMaps.total a p)) liftContinuous localContinuous;
\definition map: GlobalMaps.Map := \into[GlobalMaps.Data](data, GlobalMaps.Map) \by { continuous };
