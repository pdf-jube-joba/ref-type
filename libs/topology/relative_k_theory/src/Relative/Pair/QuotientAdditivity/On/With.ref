\import Operations.IsomorphismComposition[X := X, F := PositiveModels.TargetFiber, G := PositiveModels.SourceFiber, H := SumRaw.Fiber,
  source := PositiveModels.targetBundle, middle := PositiveModels.sourceBundle, target := SumRaw.pulled] \as PositiveFirst;
\import Operations.IsomorphismComposition[X := X, F := PositiveModels.TargetFiber, G := SumRaw.Fiber, H := Absolute.Fiber result.value.positive,
  source := PositiveModels.targetBundle, middle := SumRaw.pulled, target := Absolute.bundle result.value.positive] \as PositiveLast;
\definition positive: PositiveLast.Isomorphism := PositiveLast.compose
  (PositiveFirst.compose (PositiveReverse.inverse (PositiveModels.isomorphism first.result.positive second.result.positive)) (PullReverse.inverse SumPull.isomorphism)) result.positive;
\import Operations.IsomorphismComposition[X := X, F := NegativeModels.TargetFiber, G := NegativeModels.SourceFiber, H := (\fun (x: X) => Bundles.Vector SumModel.dimension),
  source := NegativeModels.targetBundle, middle := NegativeModels.sourceBundle, target := SumTrivial.bundle] \as NegativeFirst;
\import Operations.IsomorphismComposition[X := X, F := NegativeModels.TargetFiber, G := (\fun (x: X) => Bundles.Vector SumModel.dimension), H := Absolute.Fiber result.value.negative,
  source := NegativeModels.targetBundle, middle := SumTrivial.bundle, target := Absolute.bundle result.value.negative] \as NegativeLast;
\definition negative: NegativeLast.Isomorphism := NegativeLast.compose
  (NegativeFirst.compose (NegativeReverse.inverse (NegativeModels.isomorphism first.result.negative second.result.negative)) Joined.isomorphism) result.negative;
\import std.Data[].Pair[] \as Pair;
\import Bundles.Isomorphisms[X := X, F := First.Fiber, G := Absolute.Fiber first.result.value.positive, source := First.pulled, target := Absolute.bundle first.result.value.positive] \as FirstPositive;
\import Bundles.Isomorphisms[X := X, F := Second.Fiber, G := Absolute.Fiber second.result.value.positive, source := Second.pulled, target := Absolute.bundle second.result.value.positive] \as SecondPositive;
\import Bundles.Isomorphisms[X := X, F := (\fun (x: X) => Bundles.Vector FirstModel.dimension), G := Absolute.Fiber first.result.value.negative, source := FirstTrivial.bundle, target := Absolute.bundle first.result.value.negative] \as FirstNegative;
\import Bundles.Isomorphisms[X := X, F := (\fun (x: X) => Bundles.Vector SecondModel.dimension), G := Absolute.Fiber second.result.value.negative, source := SecondTrivial.bundle, target := Absolute.bundle second.result.value.negative] \as SecondNegative;
\module At(x: A, a: Absolute.Fiber first.result.value.positive x, b: Absolute.Fiber second.result.value.positive x);
\import \parent.\parent.\parent.Sum[t := first.result.value, u := second.result.value, v := result.value] \as GroupSum;
\definition witness: GroupSum.Witness := GroupSum.Witness {
  positive := positive, negative := negative,
  agrees := \fun (x: A)(a: Absolute.Fiber first.result.value.positive x)(b: Absolute.Fiber second.result.value.positive x) => At[x := x, a := a, b := b].equation
};
\definition equation: RelativeGroup.add (RelativeGroup.value first.result.value) (RelativeGroup.value second.result.value) = RelativeGroup.value result.value :=
  RelativeGroup.sum first.result.value second.result.value result.value witness;
