\definition firstOriginal: First.Fiber x := (first.result.positive.backward.fiber x).apply a;
\definition firstPositiveLaws: FirstPositive.Laws[first.result.positive] := \bysub(FirstPositive.Data, FirstPositive.Isomorphism, first.result.positive);
\definition firstNegativeLaws: FirstNegative.Laws[first.result.negative] := \bysub(FirstNegative.Data, FirstNegative.Isomorphism, first.result.negative);
\definition firstComparison: (first.result.value.comparison.forward.fiber x).apply a =
  (first.result.negative.forward.fiber x).apply ((FirstModel.comparison.forward.fiber x).apply firstOriginal) :=
  trans!{{Absolute.Fiber first.result.value.negative x}} _ _ _
    (sym!{{Absolute.Fiber first.result.value.negative x}} _ _
      (congr!{{Absolute.Fiber first.result.value.positive x} {Absolute.Fiber first.result.value.negative x}} (first.result.value.comparison.forward.fiber x).apply _ _ (firstPositiveLaws.rightInverse x a)))
    (first.result.agrees x firstOriginal);
\definition firstRecovered: (first.result.negative.backward.fiber x).apply ((first.result.value.comparison.forward.fiber x).apply a) = (FirstModel.comparison.forward.fiber x).apply firstOriginal :=
  trans!{{Bundles.Vector FirstModel.dimension}} _ _ _
    (congr!{{Absolute.Fiber first.result.value.negative x} {Bundles.Vector FirstModel.dimension}} (first.result.negative.backward.fiber x).apply _ _ firstComparison)
    (firstNegativeLaws.leftInverse x ((FirstModel.comparison.forward.fiber x).apply firstOriginal));
\definition secondOriginal: Second.Fiber x := (second.result.positive.backward.fiber x).apply b;
\definition secondPositiveLaws: SecondPositive.Laws[second.result.positive] := \bysub(SecondPositive.Data, SecondPositive.Isomorphism, second.result.positive);
\definition secondNegativeLaws: SecondNegative.Laws[second.result.negative] := \bysub(SecondNegative.Data, SecondNegative.Isomorphism, second.result.negative);
\definition secondComparison: (second.result.value.comparison.forward.fiber x).apply b =
  (second.result.negative.forward.fiber x).apply ((SecondModel.comparison.forward.fiber x).apply secondOriginal) :=
  trans!{{Absolute.Fiber second.result.value.negative x}} _ _ _
    (sym!{{Absolute.Fiber second.result.value.negative x}} _ _
      (congr!{{Absolute.Fiber second.result.value.positive x} {Absolute.Fiber second.result.value.negative x}} (second.result.value.comparison.forward.fiber x).apply _ _ (secondPositiveLaws.rightInverse x b)))
    (second.result.agrees x secondOriginal);
\definition secondRecovered: (second.result.negative.backward.fiber x).apply ((second.result.value.comparison.forward.fiber x).apply b) = (SecondModel.comparison.forward.fiber x).apply secondOriginal :=
  trans!{{Bundles.Vector SecondModel.dimension}} _ _ _
    (congr!{{Absolute.Fiber second.result.value.negative x} {Bundles.Vector SecondModel.dimension}} (second.result.negative.backward.fiber x).apply _ _ secondComparison)
    (secondNegativeLaws.leftInverse x ((SecondModel.comparison.forward.fiber x).apply secondOriginal));
\import Operations.CoordinateSum[n := FirstModel.dimension, m := SecondModel.dimension] \as Coordinates;
\definition equation:
  (result.value.comparison.forward.fiber x).apply ((positive.forward.fiber x).apply (Pair.pair (Absolute.Fiber first.result.value.positive x) (Absolute.Fiber second.result.value.positive x) a b)) =
    (negative.forward.fiber x).apply (Pair.pair (Absolute.Fiber first.result.value.negative x) (Absolute.Fiber second.result.value.negative x)
      ((first.result.value.comparison.forward.fiber x).apply a) ((second.result.value.comparison.forward.fiber x).apply b)) :=
  trans!{{Absolute.Fiber result.value.negative x}} _ _ _ (result.agrees x (Pair.pair (First.Fiber x) (Second.Fiber x) firstOriginal secondOriginal))
    (congr!{{Bundles.Vector FirstModel.dimension} {Bundles.Vector SecondModel.dimension} {Absolute.Fiber result.value.negative x}}
      (\fun (u: Bundles.Vector FirstModel.dimension)(v: Bundles.Vector SecondModel.dimension) =>
        (result.negative.forward.fiber x).apply (Coordinates.join (Pair.pair (Bundles.Vector FirstModel.dimension) (Bundles.Vector SecondModel.dimension) u v))) _ _ _ _
      (sym!{{Bundles.Vector FirstModel.dimension}} _ _ firstRecovered) (sym!{{Bundles.Vector SecondModel.dimension}} _ _ secondRecovered));
