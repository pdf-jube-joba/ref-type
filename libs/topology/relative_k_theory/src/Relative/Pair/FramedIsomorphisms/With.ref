\definition globalLaws: Global.Laws[h] := \bysub(Global.Data, Global.Isomorphism, h);
\definition coordinateLaws: Coordinates.Laws[c] := Coordinates.laws c;
\definition reverseCompatible: Backward.Compatible beta alpha h.backward c.backward :=
  \fun (x: A)(v: Absolute.Fiber q x) =>
    trans!{{Bundles.Vector n}} _ _ _ (sym!{{Bundles.Vector n}} _ _ (coordinateLaws.leftInverse ((alpha.forward.fiber x).apply ((h.backward.fiber x).apply v))))
      (congr!{{Bundles.Vector m} {Bundles.Vector n}} c.backward.apply _ _
        (trans!{{Bundles.Vector m}} _ _ _ (sym!{{Bundles.Vector m}} _ _ (compatible x ((h.backward.fiber x).apply v)))
          (congr!{{Absolute.Fiber q x} {Bundles.Vector m}} (beta.forward.fiber x).apply _ _ (globalLaws.rightInverse x v))));
\import Forward.With[alpha := alpha, beta := beta, h := h.forward, c := c.forward, compatible := compatible] \as Direct;
\import Backward.With[alpha := beta, beta := alpha, h := h.backward, c := c.backward, compatible := reverseCompatible] \as Reverse;
\import FirstDescent.With[comparison := alpha] \as First;
\import SecondDescent.With[comparison := beta] \as Second;
\module At(z: Quotient.Carrier);
\module Between(first: First.Result, second: Second.Result);
