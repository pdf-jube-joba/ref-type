\import Direct.Between[first := first, second := second] \as DirectMap;
\import Reverse.Between[first := second, second := first] \as ReverseMap;
\import Bundles.Isomorphisms[X := Direct.Quotient.Carrier, F := Direct.Source.Fiber, G := Direct.Target.Fiber,
  source := DirectMap.From.bundleOnQuotient, target := DirectMap.To.bundleOnQuotient] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := DirectMap.morphism, backward := ReverseMap.morphism,
  leftInverse := \fun (z: Direct.Quotient.Carrier) => \parent.At[z := z].left,
  rightInverse := \fun (z: Direct.Quotient.Carrier) => \parent.At[z := z].right
};
