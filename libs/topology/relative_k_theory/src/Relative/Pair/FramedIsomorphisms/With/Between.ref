\import First.Construction[extension := first] \as From;
\import Second.Construction[extension := second] \as To;
\import Direct.Between[first := first, second := second] \as DirectMap;
\import Reverse.Between[first := second, second := first] \as ReverseMap;
\import Bundles.Isomorphisms[X := Quotient.Carrier, F := First.Fiber, G := Second.Fiber,
  source := From.bundleOnQuotient, target := To.bundleOnQuotient] \as Isomorphisms;
\definition Isomorphism: \Set := Isomorphisms.Isomorphism;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := DirectMap.morphism, backward := ReverseMap.morphism,
  leftInverse := \fun (z: Quotient.Carrier) => \parent.At[z := z].left,
  rightInverse := \fun (z: Quotient.Carrier) => \parent.At[z := z].right
};
