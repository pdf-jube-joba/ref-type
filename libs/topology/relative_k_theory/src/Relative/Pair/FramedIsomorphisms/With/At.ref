\import Direct.Source[].At[q := z] \as First;
\import Direct.Target[].At[q := z] \as Second;
\definition left: \forall (v: First.Carrier) -> (Reverse.map z).apply ((Direct.map z).apply v) = v :=
  \fun (v: First.Carrier) => First.ext _ v (coordinateLaws.leftInverse (First.anchor v))
    (\fun (x: First.Index) => globalLaws.leftInverse x (First.section v x));
\definition right: \forall (v: Second.Carrier) -> (Direct.map z).apply ((Reverse.map z).apply v) = v :=
  \fun (v: Second.Carrier) => Second.ext _ v (coordinateLaws.rightInverse (Second.anchor v))
    (\fun (x: Second.Index) => globalLaws.rightInverse x (Second.section v x));
