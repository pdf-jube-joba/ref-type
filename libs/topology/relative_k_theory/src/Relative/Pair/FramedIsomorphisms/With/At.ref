\import First.At[q := z] \as FirstFiber;
\import Second.At[q := z] \as SecondFiber;
\definition left: \forall (v: FirstFiber.Carrier) -> (Reverse.map z).apply ((Direct.map z).apply v) = v :=
  \fun (v: FirstFiber.Carrier) => FirstFiber.ext _ v (coordinateLaws.leftInverse (FirstFiber.anchor v))
    (\fun (x: FirstFiber.Index) => globalLaws.leftInverse x (FirstFiber.section v x));
\definition right: \forall (v: SecondFiber.Carrier) -> (Direct.map z).apply ((Reverse.map z).apply v) = v :=
  \fun (v: SecondFiber.Carrier) => SecondFiber.ext _ v (coordinateLaws.rightInverse (SecondFiber.anchor v))
    (\fun (x: SecondFiber.Index) => globalLaws.rightInverse x (SecondFiber.section v x));
