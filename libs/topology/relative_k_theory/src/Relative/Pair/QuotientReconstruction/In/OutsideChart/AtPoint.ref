\import Descended.At[q := q] \as Model;
\import \parent.\parent.At[q := q] \as Compare;
\definition modelIndex: Model.Index := \into[X](ExteriorChart.base q, { x: X \where Quotient.projection x = q }) \by { sameProjection q };
\definition point: \Cast[Quotient.Carrier] d.domain := \into[Quotient.Carrier](q, d.domain) \by { included q };
\definition localPoint: \Cast[Quotient.Carrier] d.domain := \into[Quotient.Carrier](Quotient.projection (ExteriorChart.base q), d.domain) \by { ExteriorChart.member q };
\definition equation: (d.frame point).forward.apply ((fiber q).forward.apply v) = (sourceChart.frame q).forward.apply v :=
  trans!{{Bundles.Vector d.dimension}} _ _ _
    (sym!{{Bundles.Vector d.dimension}} _ _ (Transport.frame d q (Quotient.projection (ExteriorChart.base q))
      (sym!{{Quotient.Carrier}} _ _ (sameProjection q)) (included q) (ExteriorChart.member q) ((fiber q).forward.apply v)))
    (congr!{{F (Quotient.projection (ExteriorChart.base q))} {Bundles.Vector d.dimension}} (d.frame localPoint).forward.apply _ _ ((Compare.condition v).evaluations modelIndex));
