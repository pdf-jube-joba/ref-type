\import Descended.At[q := q] \as Model;
\import \parent.\parent.At[q := q] \as Compare;
\import Near.At[q := q] \as Coordinates;
\definition point: \Cast[Quotient.Carrier] c.domain := \into[Quotient.Carrier](q, c.domain) \by { included q };
\module Outside(different: Logic.Not (q = Quotient.point));
\definition equation: (c.frame point).forward.apply ((fiber q).forward.apply v) = Coordinates.coordinate v :=
  Logic.orElim[q = Quotient.point, Logic.Not (q = Quotient.point), (c.frame point).forward.apply ((fiber q).forward.apply v) = Coordinates.coordinate v]
    (std.Logic[].Classical[].excludedMiddle (q = Quotient.point))
    (\fun (equal: q = Quotient.point) => trans!{{Bundles.Vector dimension}} _ _ _
      (sym!{{Bundles.Vector dimension}} _ _ (Transport.frame c q Quotient.point equal (included q) contains ((fiber q).forward.apply v)))
      (trans!{{Bundles.Vector dimension}} _ _ _ ((Compare.condition v).atPoint equal)
        (sym!{{Bundles.Vector dimension}} _ _ ((Coordinates.condition v).atPoint equal))))
    (\fun (different: Logic.Not (q = Quotient.point)) => Outside[different := different].equation);
