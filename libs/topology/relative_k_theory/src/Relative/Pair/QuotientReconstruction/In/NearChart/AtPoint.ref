\import Descended.At[q := q] \as Model;
\import \parent.\parent.At[q := q] \as Compare;
\import Near.At[q := q] \as Coordinates;
\definition point: \Cast[Quotient.Carrier] c.domain := \into[Quotient.Carrier](q, c.domain) \by { included q };
\module Outside(different: Logic.Not (q = Quotient.point));
\definition toPoint: \forall (equal: q = Quotient.point) ->
  (c.frame point).forward.apply ((fiber q).forward.apply v) = Compare.pointFrame.forward.apply (Transport.cast q Quotient.point equal ((fiber q).forward.apply v)) :=
  \fun (equal: q = Quotient.point) => sym!{{Bundles.Vector dimension}} _ _
    (Transport.frame c q Quotient.point equal (included q) contains ((fiber q).forward.apply v));
\definition toAnchor: \forall (equal: q = Quotient.point) ->
  Compare.pointFrame.forward.apply (Transport.cast q Quotient.point equal ((fiber q).forward.apply v)) = Model.anchor v :=
  \fun (equal: q = Quotient.point) => (Compare.condition v).atPoint equal;
\definition fromAnchor: \forall (equal: q = Quotient.point) -> Model.anchor v = Coordinates.coordinate v :=
  \fun (equal: q = Quotient.point) => (Coordinates.condition v).atPoint equal;
\definition equation: (c.frame point).forward.apply ((fiber q).forward.apply v) = Coordinates.coordinate v :=
  Logic.orElim[q = Quotient.point, Logic.Not (q = Quotient.point), (c.frame point).forward.apply ((fiber q).forward.apply v) = Coordinates.coordinate v]
    (std.Logic[].Classical[].excludedMiddle (q = Quotient.point))
    (\fun (equal: q = Quotient.point) => trans!{{Bundles.Vector dimension}} _ _ _ (toPoint equal)
      (trans!{{Bundles.Vector dimension}} _ _ _ (toAnchor equal) (fromAnchor equal)))
    (\fun (different: Logic.Not (q = Quotient.point)) => Outside[different := different].equation);
