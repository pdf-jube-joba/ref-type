\definition modelIndex: Model.Index := Model.Outside[different := different].index;
\definition over: Quotient.projection modelIndex = q := \bysub(X, { x: X \where Quotient.projection x = q }, modelIndex);
\definition inside: QuotientBase.Member c.domain (Quotient.projection modelIndex) := Coordinates.within modelIndex;
\definition localPoint: \Cast[Quotient.Carrier] c.domain := \into[Quotient.Carrier](Quotient.projection modelIndex, c.domain) \by { inside };
\definition equation: (c.frame point).forward.apply ((fiber q).forward.apply v) = Coordinates.coordinate v :=
  trans!{{Bundles.Vector dimension}} _ _ _
    (sym!{{Bundles.Vector dimension}} _ _ (Transport.frame c q (Quotient.projection modelIndex) (sym!{{Quotient.Carrier}} _ _ over) (included q) inside ((fiber q).forward.apply v)))
    (trans!{{Bundles.Vector dimension}} _ _ _
      (congr!{{F (Quotient.projection modelIndex)} {Bundles.Vector dimension}} (c.frame localPoint).forward.apply _ _ ((Compare.condition v).evaluations modelIndex))
      ((Coordinates.condition v).evaluations modelIndex));
