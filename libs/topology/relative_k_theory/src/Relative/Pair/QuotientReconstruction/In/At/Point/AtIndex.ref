\definition over: Quotient.projection x = q := \bysub(X, { x: X \where Quotient.projection x = q }, x);
\definition member: A := \into[X](x, subset) \by { Quotient.atPoint x (trans!{{Quotient.Carrier}} _ _ _ over atBase) };
\definition inside: QuotientBase.Member c.domain (Quotient.projection x) := Boundary.containsAll member;
\definition localPoint: \Cast[Quotient.Carrier] c.domain := \into[Quotient.Carrier](Quotient.projection x, c.domain) \by { inside };
\definition equation: Transport.cast q (Quotient.projection x) (sym!{{Quotient.Carrier}} _ _ over) (candidate.forward.apply d) = Model.section d x :=
  Spaces.Isomorphism[V := F (Quotient.projection x), W := Bundles.Vector dimension, source := bundle.space (Quotient.projection x), target := Bundles.coordinates dimension].injective
    (c.frame localPoint) _ _ (trans!{{Bundles.Vector dimension}} _ _ _
      (Transport.frame c q (Quotient.projection x) (sym!{{Quotient.Carrier}} _ _ over) qMember inside (candidate.forward.apply d))
      (trans!{{Bundles.Vector dimension}} _ _ _ (coordinate d) (sym!{{Bundles.Vector dimension}} _ _ ((Model.laws d).boundary member over))));
