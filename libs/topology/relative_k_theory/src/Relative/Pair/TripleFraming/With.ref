\definition comparison: Compose.Isomorphism := Compose.compose Sums.sum (Triviality.isomorphism trivialization);
\import \parent.\parent.FramedClass[F := SourceFiber, sourceModel := sourceModel, n := n].With[alpha := comparison] \as Class;
\import \parent.\parent.Quotient[] \as Quotient;
\definition value: Quotient.Relative := Class.value;
\import std.Data[].Pair[] \as Pair;
\definition formula: \forall (x: A)(v: Absolute.Fiber t.positive x)(w: Absolute.Fiber auxiliary x) ->
  (comparison.forward.fiber x).apply (Pair.pair (Absolute.Fiber t.positive x) (Absolute.Fiber auxiliary x) v w) =
    (trivialization.forward.fiber x).apply (Pair.pair (Absolute.Fiber t.negative x) (Absolute.Fiber auxiliary x) ((t.comparison.forward.fiber x).apply v) w) :=
  \fun (x: A)(v: Absolute.Fiber t.positive x)(w: Absolute.Fiber auxiliary x) =>
    \refl((trivialization.forward.fiber x).apply (Pair.pair (Absolute.Fiber t.negative x) (Absolute.Fiber auxiliary x) ((t.comparison.forward.fiber x).apply v) w));
