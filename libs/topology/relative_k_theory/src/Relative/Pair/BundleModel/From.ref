\definition data: Data := Data { totalSpace := original.totalSpace, fiberSpace := original.space };
\definition eta: \forall (d: Family.Data) -> Family.Data { baseSpace := d.baseSpace, totalSpace := d.totalSpace, space := d.space } = d :=
  \induction (d: Family.Data) \return Family.Data { baseSpace := d.baseSpace, totalSpace := d.totalSpace, space := d.space } = d \with {
    | # : \fun (baseSpace: Base.Topology)(totalSpace: topology.Topology[Carrier := Family.Point].Topology)(fiberSpace: \forall (x: X) -> Spaces.VectorSpace (F x)) =>
      \refl(Family.Data { baseSpace := baseSpace, totalSpace := totalSpace, space := fiberSpace })
  };
\definition equality: lifted data = original := trans!{{Family.Data}} _ _ _
  (congr!{{Base.Topology} {Family.Data}} (\fun (t: Base.Topology) => Family.Data { baseSpace := t, totalSpace := original.totalSpace, space := original.space }) _ _ (sym!{{Base.Topology}} _ _ same))
  (eta original);
\definition regular: Family.With[data := (lifted data)].LocallyTrivial :=
  \idelim original = lifted data \with d: Family.Data => Family.With[data := d].LocallyTrivial \by {
    base: Family.Of[bundle := original].locallyTrivial, equality: sym!{{Family.Data}} _ _ equality
  };
\definition model: Bundle := \into[Data](data, Bundle) \by { regular };
