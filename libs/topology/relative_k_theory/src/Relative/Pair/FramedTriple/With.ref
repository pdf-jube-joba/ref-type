\import Bundles.Isomorphisms[X := X, F := (\fun (x: X) => Bundles.Vector n), G := (Absolute.Fiber result.value.negative),
  source := Trivial.bundle, target := (Absolute.bundle result.value.negative)] \as Negative;
\definition negativeLaws: Negative.Laws[result.negative] := \bysub(Negative.Data, Negative.Isomorphism, result.negative);
\import \parent.\parent.TrivialNegative[t := result.value, n := n] \as Normalized;
\import Normalized.With[h := (Negative.inverse result.negative)] \as Normal;
\definition compatible: \forall (x: A)(v: F x) ->
  (Normal.comparison.forward.fiber x).apply ((result.positive.forward.fiber x).apply v) = coordinateIdentity.forward.apply ((alpha.forward.fiber x).apply v) :=
  \fun (x: A)(v: F x) => trans!{{Bundles.Vector n}} _ _ _
    (congr!{{Absolute.Fiber result.value.negative x} {Bundles.Vector n}} (result.negative.backward.fiber x).apply _ _ (result.agrees x v))
    (negativeLaws.leftInverse x ((alpha.forward.fiber x).apply v));
\import \parent.\parent.FramedClass[F := F, sourceModel := sourceModel, n := n].With[alpha := alpha] \as Class;
\import \parent.\parent.FramedClass[F := F, sourceModel := sourceModel, n := n].To[
  G := (Absolute.Fiber result.value.positive), targetModel := Normalized.model, m := n].With[
  alpha := alpha, beta := Normal.comparison, h := result.positive, c := coordinateIdentity, compatible := compatible] \as Compare;
\import \parent.\parent.TripleClass[t := result.value] \as TripleClass;
\definition equation: TripleClass.value = Class.value := trans!{{Quotient.Relative}} _ _ _ Normal.equation (sym!{{Quotient.Relative}} _ _ Compare.equation);
\import \parent.\parent.Group[] \as Group;
\import Group.ToReduced[] \as ReducedMap;
\definition mapEquation: ReducedMap.map (Group.value result.value) = Class.value := trans!{{Quotient.Relative}} _ _ _ (ReducedMap.onTriple result.value) equation;
