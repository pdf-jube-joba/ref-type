\import Bundles.Isomorphisms[X := A, F := Restricted[p := p].Fiber, G := Restricted[p := q].Fiber,
  source := Restricted[p := p].bundle, target := Restricted[p := q].bundle] \as Native;
\definition Isomorphism: \Set := Native.Isomorphism;
\definition inverse: Isomorphism -> Bundles.Isomorphisms[X := A, F := Restricted[p := q].Fiber, G := Restricted[p := p].Fiber,
  source := Restricted[p := q].bundle, target := Restricted[p := p].bundle].Isomorphism := Native.inverse;
