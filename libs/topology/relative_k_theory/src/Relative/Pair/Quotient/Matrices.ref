\import bundle_extension.Extension[].Over[K := C.Complex, field := Algebra.field, conjugation := Hermitian.scalar, scalar := Scalar.scalar].Rectangular[m := m, n := n] \as Rectangular;
\definition Matrix: \Set := Rectangular.Matrix;
\structure Function: \Set := {
  value: X -> Matrix,
  constant: Matrix,
  continuous: \forall (i: Fin.Fin n)(j: Fin.Fin m) -> topology.Continuity[A := X, B := C.Complex].Continuous space Scalar.scalar.topological.space (\fun (x: X) => value x i j),
  boundary: \forall (x: A) -> value x = constant
};
\module With(f: Function);
