\definition evaluate[z: EF.Fiber x]: Absolute.Fiber result.value.negative x :=
  (result.value.comparison.forward.fiber x).apply ((result.witness.positive.forward.fiber x).apply z);
\definition equation: (result.value.comparison.forward.fiber x).apply ((positive.forward.fiber x).apply (Pair.pair (E x) (F x) e f)) =
  (negative.forward.fiber x).apply (Pair.pair (G x) (F x) ((Composition.triple.comparison.forward.fiber x).apply e) f) :=
  trans!{{Absolute.Fiber result.value.negative x}} _ _ _
    (congr!{{EF.Fiber x} {Absolute.Fiber result.value.negative x}} evaluate _ _ (w.exchangeFormula x e f))
    (trans!{{Absolute.Fiber result.value.negative x}} _ _ _
      (result.witness.agrees x ((first.backward.fiber x).apply f) ((first.forward.fiber x).apply e))
      (congr!{{F x} {Absolute.Fiber result.value.negative x}}
        (\fun (z: F x) => (result.witness.negative.forward.fiber x).apply (Pair.pair (F x) (G x) z ((second.forward.fiber x).apply ((first.forward.fiber x).apply e)))) _ _ (boundaryLaws.rightInverse x f)));
