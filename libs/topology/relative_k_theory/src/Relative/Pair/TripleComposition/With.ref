\import Operations.IsomorphismComposition[X := X, F := EF.Fiber, G := EF.Fiber, H := (Absolute.Fiber result.value.positive),
  source := efBundle, middle := efBundle, target := (Absolute.bundle result.value.positive)] \as Positive;
\definition positive: Positive.Isomorphism := Positive.compose w.exchange result.witness.positive;
\import Operations.IsomorphismComposition[X := X, F := GF.Fiber, G := FG.Fiber, H := (Absolute.Fiber result.value.negative),
  source := gfBundle, middle := fgBundle, target := (Absolute.bundle result.value.negative)] \as Negative;
\definition negative: Negative.Isomorphism := Negative.compose NegativeSymmetry.isomorphism result.witness.negative;
\import std.Data[].Pair[] \as Pair;
\module At(x: A, e: E x, f: F x);
\import \parent.\parent.Sum[t := Composition.triple, u := Diagonal.triple, v := result.value] \as NewSum;
\definition witness: NewSum.Witness := NewSum.Witness {
  positive := positive, negative := negative,
  agrees := \fun (x: A)(e: E x)(f: F x) => At[x := x, e := e, f := f].equation
};
\import \parent.\parent.TripleSum[t := Composition.left, u := Composition.right, v := result.value] \as FirstSum;
\import \parent.\parent.TripleSum[t := Composition.triple, u := Diagonal.triple, v := result.value] \as SecondSum;
\definition equation: ReducedGroup.add LeftClass.value RightClass.value = CompositeClass.value :=
  trans!{{Quotient.Relative}} _ _ _ (FirstSum.equation (\exact(result.witness, \parent.\parent.Sum[t := Composition.left, u := Composition.right, v := result.value].Witness)))
    (trans!{{Quotient.Relative}} _ _ _ (sym!{{Quotient.Relative}} _ _ (SecondSum.equation (\exact(witness, NewSum.Witness))))
      (trans!{{Quotient.Relative}} _ _ _ (congr!{{Quotient.Relative} {Quotient.Relative}} (ReducedGroup.add CompositeClass.value) _ _ diagonalZero)
        (ReducedGroup.zeroRight CompositeClass.value)));
