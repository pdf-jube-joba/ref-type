\import \parent.BundleModel[F := F] \as FirstModel;
\import \parent.BundleModel[F := G] \as SecondModel;
\definition source: Bundles.Family[X := X, F := F].Bundle := FirstModel.bundle sourceModel;
\definition target: Bundles.Family[X := X, F := G].Bundle := SecondModel.bundle targetModel;
\import Bundles.Family[X := X, F := F].Of[bundle := source].Restriction[U := subset] \as FirstRestriction;
\import Bundles.Family[X := X, F := G].Of[bundle := target].Restriction[U := subset] \as SecondRestriction;
\import Bundles.Isomorphisms[X := A, F := (\fun (x: A) => F x), G := (\fun (x: A) => G x), source := FirstRestriction.restricted, target := SecondRestriction.restricted] \as Boundary;
\import Operations.DirectSum[X := X, F := F, G := G, left := source, right := target] \as Sum;
\definition sumBundle: Bundles.Family[X := X, F := Sum.Fiber].Bundle := Sum.bundle (\refl(space));
\import Operations.Shear[X := X, F := F, G := G, left := source, right := target, same := (\refl(space))] \as Shears;
\import Bundles.Isomorphisms[X := X, F := Sum.Fiber, G := Sum.Fiber, source := sumBundle, target := sumBundle] \as Global;
\import bundle_extension.Extension[].ComplexMaps[X := X, subset := subset, F := F, G := G, source := source, target := target, baseSpace := space, sourceSame := (\refl(space)), same := (\refl(space))] \as ForwardExtension;
\import bundle_extension.Extension[].ComplexMaps[X := X, subset := subset, F := G, G := F, source := target, target := source, baseSpace := space, sourceSame := (\refl(space)), same := (\refl(space))] \as BackwardExtension;
\module With(alpha: Boundary.Isomorphism);
