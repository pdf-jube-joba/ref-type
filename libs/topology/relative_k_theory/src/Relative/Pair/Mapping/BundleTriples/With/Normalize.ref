\import Complements.Projection[X := X, n := r.presentation.dimension, baseSpace := space, P := r.presentation.projection, regular := r.presentation.regular].Complement[] \as Split;
\definition auxiliary: Presentation := Presentation { dimension := r.presentation.dimension, projection := Split.Q, regular := Split.qRegular };
\definition n: N.Nat^ := r.presentation.dimension;
\import TargetClass.Framing[auxiliary := auxiliary, n := n] \as Frame;
\import Operations.IdentityIsomorphism[X := X, F := Frame.H, bundle := Frame.auxiliaryBundle] \as Identity;
\import Operations.DirectSumIsomorphisms[X := X, F := G, G := Frame.H, A := Absolute.Fiber r.presentation, B := Frame.H,
  first := second, second := Frame.auxiliaryBundle, newFirst := Absolute.bundle r.presentation, newSecond := Frame.auxiliaryBundle,
  sameSource := (\refl(space)), sameTarget := (\refl(space))] \as Sum;
\definition trivialization: Frame.Trivialization := Operations.IsomorphismComposition[X := X, F := Sum.SourceFiber, G := Sum.TargetFiber,
  H := (\fun (x: X) => Bundles.Vector n), source := Sum.sourceBundle, middle := Sum.targetBundle, target := Bundles.Trivial[X := X, n := n, baseSpace := space].bundle].compose
    (Sum.isomorphism r.isomorphism Identity.isomorphism) Split.isomorphism;
\import Frame.With[h := trivialization] \as TargetFrame;
\import \parent.\parent.\parent.Framed[F := Frame.Fiber, sourceModel := Frame.model, n := n] \as PullBase;
\import PullBase.With[alpha := TargetFrame.comparison] \as PulledFrame;
\module Source;
\definition equation: SourceClass.reduced = relative TargetClass.reduced := Source[].equation;
