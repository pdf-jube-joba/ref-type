\import Original.With[alpha := alpha] \as TargetClass;
\import Boundary.With[alpha := alpha] \as Pull;
\definition comparison: DomainPair.BundleTriples[F := FirstFiber, G := SecondFiber, firstModel := firstModelOnSource, secondModel := secondModelOnSource].OnSubset := Pull.comparison;
\import DomainPair.BundleTriples[F := FirstFiber, G := SecondFiber, firstModel := firstModelOnSource, secondModel := secondModelOnSource].With[alpha := comparison] \as SourceClass;
\definition value: DomainPair.Group[].Carrier := SourceClass.value;
\module Normalize(r: Negative.Representative);
\definition reducedNaturality: SourceClass.reduced = relative TargetClass.reduced := \block {
  \takefrom r: Negative.Representative \by Negative.representativeExists \then
  \return Normalize[r := r].equation
};
\definition naturality: value = \parent.\parent.Group[].map TargetClass.value :=
  DomainPair.Comparison[].injective _ _ (trans!{{Domain.Relative}} _ _ _ reducedNaturality
    (sym!{{Domain.Relative}} _ _ (\parent.\parent.Group[].naturality TargetClass.value)));
