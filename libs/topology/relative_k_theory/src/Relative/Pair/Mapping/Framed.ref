\import \root.Relative[].Pair[X := X, space := space, compact := compact, hausdorff := hausdorff, subset := subset, closed := closed] \as RangePair;
\definition original: Bundles.Family[X := X, F := F].Bundle := RangePair.BundleModel[F := F].bundle sourceModel;
\import Bundles.Family[X := X, F := F].Of[bundle := original].Pullback[Y := Y, source := source, f := f] \as Pull;
\definition Fiber[y: Y]: \Set := F (f y);
\definition pulled: Bundles.Family[X := Y, F := Fiber].Bundle := Pull.pulled regular;
\import DomainPair.BundleModel[F := Fiber].From[original := pulled, same := (\refl(source))] \as Based;
\definition model: DomainPair.BundleModel[F := Fiber].Bundle := Based.model;
\import \root.Relative[].Descent[X := X, F := F, bundle := original, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed, dimension := n] \as Original;
\module With(alpha: Original.OnSubset);
