\import RangeTheory.Bundle[F := Descent.Fiber, original := Descended.bundleOnQuotient, same := Descended.sameBaseSpace] \as OriginalClass;
\import PullQuotient.Of[F := Descent.Fiber, original := Descended.bundleOnQuotient, same := Descended.sameBaseSpace] \as PulledClass;
\import DomainTheory.Bundle[F := QuotientFiber, original := quotientBundle, same := (\refl(Domain.topology))] \as SourceClass;
\import DomainTheory.K0[] \as K0;
\import Class.Value[e := e] \as Value;
\definition equation: relative Value.value = K0.difference SourceClass.value (DomainTheory.Trivial[n := n].value) :=
  trans!{{K0.Carrier}} _ _ _
    (PullQuotient.Ranks[].Difference[a := OriginalClass.value, b := RangeTheory.Trivial[n := n].value].difference)
    (congr!{{DomainTheory.Classes} {DomainTheory.Classes} {K0.Carrier}} K0.difference _ _ _ _ PulledClass.naturality (PullQuotient.Trivial[n := n].equation));
