\import \root.Relative[].Pair[X := X, space := space, compact := compact, hausdorff := hausdorff, subset := subset, closed := closed] \as RangePair;
\import RangePair.BundleTriples[F := F, G := G, firstModel := firstModel, secondModel := secondModel] \as Original;
\definition OnSubset: \Set := Original.OnSubset;
\definition first: Bundles.Family[X := X, F := F].Bundle := Original.first;
\definition second: Bundles.Family[X := X, F := G].Bundle := Original.second;
\import Bundles.Family[X := X, F := F].Of[bundle := first].Pullback[Y := Y, source := source, f := f] \as FirstPull;
\import Bundles.Family[X := X, F := G].Of[bundle := second].Pullback[Y := Y, source := source, f := f] \as SecondPull;
\definition FirstFiber[y: Y]: \Set := F (f y);
\definition SecondFiber[y: Y]: \Set := G (f y);
\definition firstBundle: Bundles.Family[X := Y, F := FirstFiber].Bundle := FirstPull.pulled regular;
\definition secondBundle: Bundles.Family[X := Y, F := SecondFiber].Bundle := SecondPull.pulled regular;
\import DomainPair.BundleModel[F := FirstFiber].From[original := firstBundle, same := (\refl(source))] \as FirstModel;
\import DomainPair.BundleModel[F := SecondFiber].From[original := secondBundle, same := (\refl(source))] \as SecondModel;
\definition firstModelOnSource: DomainPair.BundleModel[F := FirstFiber].Bundle := FirstModel.model;
\definition secondModelOnSource: DomainPair.BundleModel[F := SecondFiber].Bundle := SecondModel.model;
\import \root.Relative[].PairPullback[X := X, Y := Y, F := F, G := G, first := first, second := second, same := (\refl(space)), source := source,
  subset := subset, sourceSubset := sourceSubset, f := f, regular := regular, preserves := preserves] \as Boundary;
\import Absolute.Bundle[F := G, original := second, same := (\refl(space))] \as Negative;
\module With(alpha: OnSubset);
