\definition source: Bundles.Family[X := X, F := F].Bundle := \parent.BundleModel[F := F].bundle sourceModel;
\import Bundles.Trivial[X := X, n := n, baseSpace := space] \as Trivial;
\import \parent.FromBundles[F := F, G := (\fun (x: X) => Bundles.Vector n), source := source, target := Trivial.bundle,
  sourceSame := (\refl(space)), targetSame := (\refl(space))] \as Represent;
\import \parent.Quotient[] \as Quotient;
\import Spaces.Isomorphism[V := Bundles.Vector n, W := Bundles.Vector n, source := Bundles.coordinates n, target := Bundles.coordinates n] \as Coordinates;
\definition coordinateIdentity: Coordinates.Isomorphism := Coordinates.Isomorphism {
  forward := Spaces.FiniteCoordinates[n := n].identity, backward := Spaces.FiniteCoordinates[n := n].identity,
  leftInverse := \fun (v: Bundles.Vector n) => \refl(v), rightInverse := \fun (v: Bundles.Vector n) => \refl(v)
};
\module With(alpha: Represent.OnSubset, result: Represent.Result[alpha]);
