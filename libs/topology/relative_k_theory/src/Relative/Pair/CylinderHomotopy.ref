\import \parent.Homotopy[p := p, q := q, first := first, second := second] \as Native;
\import \parent.CylinderSubset[] \as Boundary;
\import algebraic_topology.Cylinder[A := A] \as OriginalCylinder;
\import algebraic_topology.Interval[] \as Interval;
\import \parent.BundleModel[F := (Absolute.Fiber p)].From[original := (Absolute.bundle p), same := (\refl(space))] \as FirstModel;
\import \parent.BundleModel[F := (Absolute.Fiber q)].From[original := (Absolute.bundle q), same := (\refl(space))] \as SecondModel;
\import \parent.CylinderRestriction[F := (Absolute.Fiber p), sourceModel := FirstModel.model] \as Source;
\import \parent.CylinderRestriction[F := (Absolute.Fiber q), sourceModel := SecondModel.model] \as Target;
\import Bundles.Family[X := A, F := (\fun (x: A) => Absolute.Fiber p x)].Of[bundle := Source.boundaryBundle].Pullback[Y := OriginalCylinder.Carrier, source := (OriginalCylinder.topology subspace), f := OriginalCylinder.point] \as FirstPull;
\import Bundles.Family[X := A, F := (\fun (x: A) => Absolute.Fiber q x)].Of[bundle := Target.boundaryBundle].Pullback[Y := OriginalCylinder.Carrier, source := (OriginalCylinder.topology subspace), f := OriginalCylinder.point] \as SecondPull;
\definition firstBundle: Bundles.Family[X := OriginalCylinder.Carrier, F := (\fun (z: OriginalCylinder.Carrier) => Absolute.Fiber p (OriginalCylinder.point z))].Bundle := FirstPull.pulled (OriginalCylinder.pointContinuous subspace);
\definition secondBundle: Bundles.Family[X := OriginalCylinder.Carrier, F := (\fun (z: OriginalCylinder.Carrier) => Absolute.Fiber q (OriginalCylinder.point z))].Bundle := SecondPull.pulled (OriginalCylinder.pointContinuous subspace);
\import Bundles.Family[X := A, F := (\fun (x: A) => Absolute.Fiber p x)].Of[bundle := Source.boundaryBundle].PullbackComposition[
  Y := OriginalCylinder.Carrier, Z := Boundary.Carrier, first := (OriginalCylinder.topology subspace), second := Boundary.topology, f := OriginalCylinder.point, g := Boundary.inverse].Of[
  fRegular := (OriginalCylinder.pointContinuous subspace), gRegular := Boundary.inverseContinuous] \as FirstComparison;
\import Bundles.Family[X := A, F := (\fun (x: A) => Absolute.Fiber q x)].Of[bundle := Target.boundaryBundle].PullbackComposition[
  Y := OriginalCylinder.Carrier, Z := Boundary.Carrier, first := (OriginalCylinder.topology subspace), second := Boundary.topology, f := OriginalCylinder.point, g := Boundary.inverse].Of[
  fRegular := (OriginalCylinder.pointContinuous subspace), gRegular := Boundary.inverseContinuous] \as SecondComparison;
\import Operations.IsomorphismComposition[X := Boundary.Carrier, F := Source.Fiber, G := Source.Fiber, H := Source.Fiber,
  source := Source.cylinderRestriction, middle := Source.subsetCylinder, target := FirstComparison.nested] \as FirstBridge;
\definition firstBridge: FirstBridge.Isomorphism := FirstBridge.compose Source.comparison FirstComparison.isomorphism;
\import Operations.IsomorphismComposition[X := Boundary.Carrier, F := Target.Fiber, G := Target.Fiber, H := Target.Fiber,
  source := Target.cylinderRestriction, middle := Target.subsetCylinder, target := SecondComparison.nested] \as SecondBridge;
\definition secondBridge: SecondBridge.Isomorphism := SecondBridge.compose Target.comparison SecondComparison.isomorphism;
\import Complements.PulledIsomorphism[X := OriginalCylinder.Carrier, Y := Boundary.Carrier,
  F := (\fun (z: OriginalCylinder.Carrier) => Absolute.Fiber p (OriginalCylinder.point z)), G := (\fun (z: OriginalCylinder.Carrier) => Absolute.Fiber q (OriginalCylinder.point z)),
  source := firstBundle, target := secondBundle, base := Boundary.topology, f := Boundary.inverse, sourceRegular := Boundary.inverseContinuous, targetRegular := Boundary.inverseContinuous] \as Pull;
\import Bundles.Isomorphisms[X := Boundary.Carrier, F := Target.Fiber, G := Target.Fiber,
  source := Target.cylinderRestriction, target := SecondComparison.nested] \as TargetReverse;
\import Operations.IsomorphismComposition[X := Boundary.Carrier, F := Source.Fiber, G := Source.Fiber, H := Target.Fiber,
  source := Source.cylinderRestriction, middle := FirstComparison.nested, target := SecondComparison.nested] \as Start;
\import Operations.IsomorphismComposition[X := Boundary.Carrier, F := Source.Fiber, G := Target.Fiber, H := Target.Fiber,
  source := Source.cylinderRestriction, middle := SecondComparison.nested, target := Target.cylinderRestriction] \as Finish;
\import Bundles.Isomorphisms[X := Boundary.Carrier, F := Source.Fiber, G := Target.Fiber, source := Source.cylinderRestriction, target := Target.cylinderRestriction] \as Isomorphisms;
\module With(family: Native.Family);
