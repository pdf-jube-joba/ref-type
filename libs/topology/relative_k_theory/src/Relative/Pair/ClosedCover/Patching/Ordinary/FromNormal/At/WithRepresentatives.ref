\import \parent.\parent.\parent.\parent.On[p := p, q := q] \as Candidate;
\definition isomorphismExists: \exists Candidate.OnIntersection := WPresentations.equalRelated (UPresentations.presentation p) (VPresentations.presentation q)
  (matching p q firstEquation secondEquation);
\module With(alpha: Candidate.OnIntersection);
\definition existence: \exists Result[u, v] := \block {
  \takefrom alpha: Candidate.OnIntersection \by isomorphismExists \then
  \return With[alpha := alpha].existence
};
