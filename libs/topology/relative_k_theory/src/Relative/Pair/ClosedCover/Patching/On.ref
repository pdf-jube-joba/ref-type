\definition pRegular: Frames.At[n := p.dimension].Families[X := W].Matrix[m := p.dimension].Regular wSpace (\fun (w: W) => (p.projection (toU w)).map) :=
  \fun (v: Vector p.dimension)(i: Fin.Fin p.dimension) => topology.Composition[A := W, B := A, C := C.Complex].composeContinuous wSpace subspace Scalar.scalar.topological.space
    toU (\fun (u: A) => (p.projection u).map.apply v i) toUContinuous (p.regular v i);
\definition qRegular: Frames.At[n := q.dimension].Families[X := W].Matrix[m := q.dimension].Regular wSpace (\fun (w: W) => (q.projection (toV w)).map) :=
  \fun (v: Vector q.dimension)(i: Fin.Fin q.dimension) => topology.Composition[A := W, B := Y, C := C.Complex].composeContinuous wSpace source Scalar.scalar.topological.space
    toV (\fun (y: Y) => (q.projection y).map.apply v i) toVContinuous (q.regular v i);
\import Complements.Projection[X := W, n := p.dimension, baseSpace := wSpace, P := (\fun (w: W) => p.projection (toU w)), regular := pRegular] \as PU;
\import Complements.Projection[X := W, n := q.dimension, baseSpace := wSpace, P := (\fun (w: W) => q.projection (toV w)), regular := qRegular] \as PV;
\import Bundles.Isomorphisms[X := W, F := PU.Fiber, G := PV.Fiber, source := PU.bundle, target := PV.bundle] \as Isomorphisms;
\definition OnIntersection: \Set := Isomorphisms.Isomorphism;
\module With(alpha: OnIntersection);
