\definition section[x: X]: AmbientFamily.Point := AmbientFamily.include x v;
\definition sectionContinuous: topology.Continuity[A := X, B := AmbientFamily.Point].Continuous space Ambient.topology section :=
  Complements.TrivialMaps[X := X, n := dimension, baseSpace := space].Into[Y := X, source := space].continuous
    (\fun (x: X) => x) (\fun (x: X) => v) (topology.Maps[A := X, B := X].Identity[].continuous space)
    (topology.Maps[A := X, B := Vector dimension].constantContinuous space (Bundles.coordinateTopology dimension) v);
\definition vectorContinuous: topology.Continuity[A := X, B := Vector dimension].Continuous space (Bundles.coordinateTopology dimension) (\fun (x: X) => (matrix x).apply v) :=
  topology.Composition[A := X, B := AmbientFamily.Point, C := Vector dimension].composeContinuous space Ambient.topology (Bundles.coordinateTopology dimension)
    (\fun (x: X) => NativeMaps.total vectorMap (section x)) (\fun (p: AmbientFamily.Point) => p.vector)
    (topology.Composition[A := X, B := AmbientFamily.Point, C := AmbientFamily.Point].composeContinuous space Ambient.topology Ambient.topology
      section (NativeMaps.total vectorMap) sectionContinuous (NativeMaps.continuous vectorMap)) Ambient.vectorContinuous;
\import topological_algebra.Coordinates[K := C.Complex, I := Fin.Fin dimension] \as Coordinates;
\definition regular[i: Fin.Fin dimension]: topology.Continuity[A := X, B := C.Complex].Continuous space Scalar.scalar.topological.space (\fun (x: X) => (matrix x).apply v i) :=
  topology.Composition[A := X, B := Vector dimension, C := C.Complex].composeContinuous space (Bundles.coordinateTopology dimension) Scalar.scalar.topological.space
    (\fun (x: X) => (matrix x).apply v) (\fun (v: Vector dimension) => v i) vectorContinuous
    (Coordinates.evaluationContinuous Scalar.scalar.topological.space i);
