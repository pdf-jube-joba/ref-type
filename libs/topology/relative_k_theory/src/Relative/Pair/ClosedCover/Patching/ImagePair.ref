\import Complements.Idempotents[n := m] \as First;
\import Complements.Idempotents[n := n] \as Second;
\structure Data: \Set := {
  source: Y -> First.Projection,
  target: Y -> Second.Projection,
  sourceRegular: Frames.At[n := m].Families[X := Y].Matrix[m := m].Regular baseSpace (\fun (y: Y) => (source y).map),
  targetRegular: Frames.At[n := n].Families[X := Y].Matrix[m := n].Regular baseSpace (\fun (y: Y) => (target y).map),
  forward: Y -> Linear m n,
  backward: Y -> Linear n m,
  forwardRegular: Frames.At[n := n].Families[X := Y].Matrix[m := m].Regular baseSpace forward,
  backwardRegular: Frames.At[n := m].Families[X := Y].Matrix[m := n].Regular baseSpace backward,
  left: \forall (y: Y)(v: Vector m) -> (backward y).apply ((forward y).apply v) = (source y).map.apply v,
  right: \forall (y: Y)(v: Vector n) -> (forward y).apply ((backward y).apply v) = (target y).map.apply v
};
\module With(d: Data);
