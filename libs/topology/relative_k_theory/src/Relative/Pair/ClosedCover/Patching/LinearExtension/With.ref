\import Matrices.Families[X := X, baseSpace := space, A := e.value, regular := e.continuous] \as Family;
\definition linear[x: X]: Linear m n := Matrices.linear (e.value x);
\definition regular: Frames.At[n := n].Families[X := X].Matrix[m := m].Regular space linear := Family.continuous;
\definition onSubset: \forall (w: W)(v: Vector m) -> (linear w).apply v = (f w).apply v :=
  \fun (w: W)(v: Vector m) => trans!{{Vector n}} _ _ _
    (congr!{Matrices.Matrix {Vector n}} (\fun (A: Matrices.Matrix) => (Matrices.linear A).apply v) _ _ (e.extends w))
    (Matrices.roundTrip (f w) v);
\import Complements.CoordinateFamily[X := X, m := m, n := n, baseSpace := space, A := linear, regular := regular] \as Native;
\definition map: Bundles.Morphisms[X := X, Y := X, F := (\fun (x: X) => Vector m), G := (\fun (x: X) => Vector n),
  source := Bundles.Trivial[X := X, n := m, baseSpace := space].bundle, target := Bundles.Trivial[X := X, n := n, baseSpace := space].bundle,
  f := (\fun (x: X) => x)].Map := Native.map;
