\import Frames.At[n := n].Families[X := SourceFamily.Point].Matrix[m := m] \as Matrices;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := Algebra.field, scalar := Hermitian.scalar].Finite[n := m] \as Basis;
\import topological_algebra.Coordinates[K := C.Complex, I := Fin.Fin m] \as DomainCoordinates;
\import topological_algebra.Coordinates[K := C.Complex, I := Fin.Fin n] \as RangeCoordinates;
\definition components: Matrices.Components Source.topology (\fun (p: SourceFamily.Point) => d.forward p.base) :=
  \fun (j: Fin.Fin m)(i: Fin.Fin n) => topology.Composition[A := SourceFamily.Point, B := Y, C := C.Complex].composeContinuous Source.topology baseSpace Scalar.scalar.topological.space
    SourceFamily.projection (\fun (y: Y) => (d.forward y).apply (Basis.basis j) i) Source.projectionContinuous (d.forwardRegular (Basis.basis j) i);
\definition vectors: \forall (j: Fin.Fin m) -> topology.Continuity[A := SourceFamily.Point, B := C.Complex].Continuous Source.topology Scalar.scalar.topological.space (\fun (p: SourceFamily.Point) => p.vector j) :=
  \fun (j: Fin.Fin m) => topology.Composition[A := SourceFamily.Point, B := Vector m, C := C.Complex].composeContinuous Source.topology (Bundles.coordinateTopology m) Scalar.scalar.topological.space
    (\fun (p: SourceFamily.Point) => p.vector) (\fun (v: Vector m) => v j) Source.vectorContinuous (DomainCoordinates.evaluationContinuous Scalar.scalar.topological.space j);
\definition continuous: topology.Continuity[A := SourceFamily.Point, B := Vector n].Continuous Source.topology (Bundles.coordinateTopology n) (\fun (p: SourceFamily.Point) => (d.forward p.base).apply p.vector) :=
  RangeCoordinates.Universal[A := SourceFamily.Point].continuous Source.topology Scalar.scalar.topological.space
    (\fun (p: SourceFamily.Point) => (d.forward p.base).apply p.vector)
    (Matrices.evaluate Source.topology (\fun (p: SourceFamily.Point) => d.forward p.base) (\fun (p: SourceFamily.Point) => p.vector) components vectors);
