\import bundle_extension.Extension[].Over[K := C.Complex, field := Algebra.field, conjugation := Hermitian.scalar, scalar := Scalar.scalar].Rectangular[m := m, n := n] \as Matrices;
\import bundle_extension.Extension[].Complex[A := X, source := space, subset := intersection].Matrices[m := m, n := n] \as Entries;
\import Spaces.FiniteCoordinates[n := m] \as Basis;
\definition input: Entries.Function := Entries.Function {
  value := \fun (w: W) => Matrices.entries (f w),
  continuous := \fun (i: Fin.Fin n)(j: Fin.Fin m) => regular (Basis.vectors j) i
};
\definition existence: \exists Entries.Extension[input] := Entries.tietze input compact hausdorff intersectionClosed;
\module With(e: Entries.Extension[input]);
