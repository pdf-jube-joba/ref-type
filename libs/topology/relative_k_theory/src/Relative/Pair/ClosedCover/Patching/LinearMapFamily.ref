\import Bundles.Trivial[X := Y, n := m, baseSpace := baseSpace] \as Source;
\import Bundles.Trivial[X := Y, n := n, baseSpace := baseSpace] \as Target;
\import Bundles.Family[X := Y, F := (\fun (y: Y) => Vector m)] \as SourceFamily;
\import Bundles.Family[X := Y, F := (\fun (y: Y) => Vector n)] \as TargetFamily;
\import Bundles.Morphisms[X := Y, Y := Y, F := (\fun (y: Y) => Vector m), G := (\fun (y: Y) => Vector n), source := Source.bundle, target := Target.bundle,
  f := (\fun (y: Y) => y)] \as Maps;
\module Column(v: Vector m);
\definition regular: Frames.At[n := n].Families[X := Y].Matrix[m := m].Regular baseSpace (\fun (y: Y) => map.fiber y) :=
  \fun (v: Vector m) => Column[v := v].regular;
