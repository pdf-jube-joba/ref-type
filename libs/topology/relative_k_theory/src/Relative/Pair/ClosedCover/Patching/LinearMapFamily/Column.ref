\definition section[y: Y]: SourceFamily.Point := SourceFamily.include y v;
\definition sectionContinuous: topology.Continuity[A := Y, B := SourceFamily.Point].Continuous baseSpace Source.topology section :=
  Complements.TrivialMaps[X := Y, n := m, baseSpace := baseSpace].Into[Y := Y, source := baseSpace].continuous
    (\fun (y: Y) => y) (\fun (y: Y) => v) (topology.Maps[A := Y, B := Y].Identity[].continuous baseSpace)
    (topology.Maps[A := Y, B := Vector m].constantContinuous baseSpace (Bundles.coordinateTopology m) v);
\definition vectorContinuous: topology.Continuity[A := Y, B := Vector n].Continuous baseSpace (Bundles.coordinateTopology n) (\fun (y: Y) => (map.fiber y).apply v) :=
  topology.Composition[A := Y, B := TargetFamily.Point, C := Vector n].composeContinuous baseSpace Target.topology (Bundles.coordinateTopology n)
    (\fun (y: Y) => Maps.total map (section y)) (\fun (p: TargetFamily.Point) => p.vector)
    (topology.Composition[A := Y, B := SourceFamily.Point, C := TargetFamily.Point].composeContinuous baseSpace Source.topology Target.topology
      section (Maps.total map) sectionContinuous (Maps.continuous map)) Target.vectorContinuous;
\import topological_algebra.Coordinates[K := C.Complex, I := Fin.Fin n] \as Coordinates;
\definition regular[i: Fin.Fin n]: topology.Continuity[A := Y, B := C.Complex].Continuous baseSpace Scalar.scalar.topological.space (\fun (y: Y) => (map.fiber y).apply v i) :=
  topology.Composition[A := Y, B := Vector n, C := C.Complex].composeContinuous baseSpace (Bundles.coordinateTopology n) Scalar.scalar.topological.space
    (\fun (y: Y) => (map.fiber y).apply v) (\fun (v: Vector n) => v i) vectorContinuous
    (Coordinates.evaluationContinuous Scalar.scalar.topological.space i);
