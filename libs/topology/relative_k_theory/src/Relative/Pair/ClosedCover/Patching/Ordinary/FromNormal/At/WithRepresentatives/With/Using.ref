\import Model.Using[e := e].Glued[].Image[] \as Patched;
\definition onU: GlobalU.map Patched.value = positiveU := trans!{{UTheory.Classes}} _ _ _ Patched.Left[].classEquation firstEquation;
\definition onV: GlobalV.map Patched.value = positiveV := trans!{{VTheory.Classes}} _ _ _ Patched.Right[].classEquation secondEquation;
\import \parent.\parent.\parent.Virtual[globalClass := Patched.value, onU := onU, onV := onV] \as Virtual;
\definition result: Result[u, v] := Virtual.result;
