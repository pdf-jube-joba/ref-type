\definition section[w: W]: UFamily.Point := UFamily.include w v;
\definition sectionContinuous: topology.Continuity[A := W, B := UFamily.Point].Continuous wSpace UAmbient.topology section :=
  Complements.TrivialMaps[X := W, n := p.dimension, baseSpace := wSpace].Into[Y := W, source := wSpace].continuous
    (\fun (w: W) => w) (\fun (w: W) => v) (topology.Maps[A := W, B := W].Identity[].continuous wSpace)
    (topology.Maps[A := W, B := Vector p.dimension].constantContinuous wSpace (Bundles.coordinateTopology p.dimension) v);
\definition vectorContinuous: topology.Continuity[A := W, B := Vector q.dimension].Continuous wSpace (Bundles.coordinateTopology q.dimension) (\fun (w: W) => (g w).apply v) :=
  topology.Composition[A := W, B := VFamily.Point, C := Vector q.dimension].composeContinuous wSpace VAmbient.topology (Bundles.coordinateTopology q.dimension)
    (\fun (w: W) => Forward.total forward (section w)) (\fun (p: VFamily.Point) => p.vector)
    (topology.Composition[A := W, B := UFamily.Point, C := VFamily.Point].composeContinuous wSpace UAmbient.topology VAmbient.topology
      section (Forward.total forward) sectionContinuous (Forward.continuous forward)) VAmbient.vectorContinuous;
\import topological_algebra.Coordinates[K := C.Complex, I := Fin.Fin q.dimension] \as Coordinates;
\definition regular[i: Fin.Fin q.dimension]: topology.Continuity[A := W, B := C.Complex].Continuous wSpace Scalar.scalar.topological.space (\fun (w: W) => (g w).apply v i) :=
  topology.Composition[A := W, B := Vector q.dimension, C := C.Complex].composeContinuous wSpace (Bundles.coordinateTopology q.dimension) Scalar.scalar.topological.space
    (\fun (w: W) => (g w).apply v) (\fun (v: Vector q.dimension) => v i) vectorContinuous
    (Coordinates.evaluationContinuous Scalar.scalar.topological.space i);
