\import Frames.At[n := m].Families[X := TargetFamily.Point].Matrix[m := n] \as Matrices;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := Algebra.field, scalar := Hermitian.scalar].Finite[n := n] \as Basis;
\import topological_algebra.Coordinates[K := C.Complex, I := Fin.Fin n] \as DomainCoordinates;
\import topological_algebra.Coordinates[K := C.Complex, I := Fin.Fin m] \as RangeCoordinates;
\definition components: Matrices.Components Target.topology (\fun (p: TargetFamily.Point) => d.backward p.base) :=
  \fun (j: Fin.Fin n)(i: Fin.Fin m) => topology.Composition[A := TargetFamily.Point, B := Y, C := C.Complex].composeContinuous Target.topology baseSpace Scalar.scalar.topological.space
    TargetFamily.projection (\fun (y: Y) => (d.backward y).apply (Basis.basis j) i) Target.projectionContinuous (d.backwardRegular (Basis.basis j) i);
\definition vectors: \forall (j: Fin.Fin n) -> topology.Continuity[A := TargetFamily.Point, B := C.Complex].Continuous Target.topology Scalar.scalar.topological.space (\fun (p: TargetFamily.Point) => p.vector j) :=
  \fun (j: Fin.Fin n) => topology.Composition[A := TargetFamily.Point, B := Vector n, C := C.Complex].composeContinuous Target.topology (Bundles.coordinateTopology n) Scalar.scalar.topological.space
    (\fun (p: TargetFamily.Point) => p.vector) (\fun (v: Vector n) => v j) Target.vectorContinuous (DomainCoordinates.evaluationContinuous Scalar.scalar.topological.space j);
\definition continuous: topology.Continuity[A := TargetFamily.Point, B := Vector m].Continuous Target.topology (Bundles.coordinateTopology m) (\fun (p: TargetFamily.Point) => (d.backward p.base).apply p.vector) :=
  RangeCoordinates.Universal[A := TargetFamily.Point].continuous Target.topology Scalar.scalar.topological.space
    (\fun (p: TargetFamily.Point) => (d.backward p.base).apply p.vector)
    (Matrices.evaluate Target.topology (\fun (p: TargetFamily.Point) => d.backward p.base) (\fun (p: TargetFamily.Point) => p.vector) components vectors);
