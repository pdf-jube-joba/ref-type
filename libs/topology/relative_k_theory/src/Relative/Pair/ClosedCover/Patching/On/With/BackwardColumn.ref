\definition section[w: W]: VFamily.Point := VFamily.include w v;
\definition sectionContinuous: topology.Continuity[A := W, B := VFamily.Point].Continuous wSpace VAmbient.topology section :=
  Complements.TrivialMaps[X := W, n := q.dimension, baseSpace := wSpace].Into[Y := W, source := wSpace].continuous
    (\fun (w: W) => w) (\fun (w: W) => v) (topology.Maps[A := W, B := W].Identity[].continuous wSpace)
    (topology.Maps[A := W, B := Vector q.dimension].constantContinuous wSpace (Bundles.coordinateTopology q.dimension) v);
\definition vectorContinuous: topology.Continuity[A := W, B := Vector p.dimension].Continuous wSpace (Bundles.coordinateTopology p.dimension) (\fun (w: W) => (f w).apply v) :=
  topology.Composition[A := W, B := UFamily.Point, C := Vector p.dimension].composeContinuous wSpace UAmbient.topology (Bundles.coordinateTopology p.dimension)
    (\fun (w: W) => Backward.total backward (section w)) (\fun (p: UFamily.Point) => p.vector)
    (topology.Composition[A := W, B := VFamily.Point, C := UFamily.Point].composeContinuous wSpace VAmbient.topology UAmbient.topology
      section (Backward.total backward) sectionContinuous (Backward.continuous backward)) UAmbient.vectorContinuous;
\import topological_algebra.Coordinates[K := C.Complex, I := Fin.Fin p.dimension] \as Coordinates;
\definition regular[i: Fin.Fin p.dimension]: topology.Continuity[A := W, B := C.Complex].Continuous wSpace Scalar.scalar.topological.space (\fun (w: W) => (f w).apply v i) :=
  topology.Composition[A := W, B := Vector p.dimension, C := C.Complex].composeContinuous wSpace (Bundles.coordinateTopology p.dimension) Scalar.scalar.topological.space
    (\fun (w: W) => (f w).apply v) (\fun (v: Vector p.dimension) => v i) vectorContinuous
    (Coordinates.evaluationContinuous Scalar.scalar.topological.space i);
