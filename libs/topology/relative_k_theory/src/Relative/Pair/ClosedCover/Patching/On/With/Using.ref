\import ForwardExtension.With[e := e.forward] \as Column;
\import BackwardExtension.With[e := e.backward] \as Row;
\import Bundles.Trivial[X := X, n := p.dimension, baseSpace := space] \as FirstAmbient;
\import Bundles.Trivial[X := X, n := q.dimension, baseSpace := space] \as SecondAmbient;
\import Operations.DirectSum[X := X, F := (\fun (x: X) => Vector p.dimension), G := (\fun (x: X) => Vector q.dimension),
  left := FirstAmbient.bundle, right := SecondAmbient.bundle] \as Sum;
\definition bundle: Bundles.Family[X := X, F := Sum.Fiber].Bundle := Sum.bundle (\refl(space));
\import Operations.Shear[X := X, F := (\fun (x: X) => Vector p.dimension), G := (\fun (x: X) => Vector q.dimension),
  left := FirstAmbient.bundle, right := SecondAmbient.bundle, same := (\refl(space))] \as Shears;
\import Shears.Upper[h := Row.map, a := Algebra.field.one] \as Upper;
\import Shears.Lower[h := Column.map, a := (Algebra.field.neg Algebra.field.one)] \as Lower;
\import Bundles.Isomorphisms[X := X, F := Sum.Fiber, G := Sum.Fiber, source := bundle, target := bundle] \as Automorphisms;
\import Operations.IsomorphismComposition[X := X, F := Sum.Fiber, G := Sum.Fiber, H := Sum.Fiber,
  source := bundle, middle := bundle, target := bundle] \as Compose;
\definition first: Automorphisms.Isomorphism := Compose.compose Upper.isomorphism Lower.isomorphism;
\definition exchange: Automorphisms.Isomorphism := Compose.compose first Upper.isomorphism;
\module At(w: W);
\module Local(S: \Pow X);
\module Glued;
