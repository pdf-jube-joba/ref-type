\import UTheory.K0[] \as UK;
\import VTheory.K0[] \as VK;
\import WTheory.K0[] \as WK;
\import Absolute.K0[] \as XK;
\import UK.NormalForm[] \as UNormal;
\import VK.NormalForm[] \as VNormal;
\import UTheory.Pullback[Y := W, space := wSpace, sourceCompact := compactW, sourceHausdorff := hausdorffW, f := toU, regular := toUContinuous] \as UPull;
\import VTheory.Pullback[Y := W, space := wSpace, sourceCompact := compactW, sourceHausdorff := hausdorffW, f := toV, regular := toVContinuous] \as VPull;
\import UPull.K0[] \as UMap;
\import VPull.K0[] \as VMap;
\import Absolute.Pullback[Y := A, space := subspace, sourceCompact := URestriction.compactSubset, sourceHausdorff := URestriction.hausdorffSubset,
  f := URestriction.inclusion, regular := URestriction.regular] \as GlobalU;
\import Absolute.Pullback[Y := Y, space := source, sourceCompact := compactSource, sourceHausdorff := hausdorffSource,
  f := inclusion, regular := inclusionContinuous] \as GlobalV;
\import GlobalU.K0[] \as RestrictU;
\import GlobalV.K0[] \as RestrictV;
\definition Compatible[u: UK.Carrier][v: VK.Carrier]: \Prop := UMap.map u = VMap.map v;
\structure Result[u: UK.Carrier, v: VK.Carrier]: \Set := {
  value: XK.Carrier,
  onU: RestrictU.map value = u,
  onV: RestrictV.map value = v
};
\module FromNormal(u: UK.Carrier, v: VK.Carrier, first: UNormal.Result[u], second: VNormal.Result[v]);
\definition existence: \forall (u: UK.Carrier)(v: VK.Carrier) -> Compatible u v -> \exists Result[u, v] := \block {
  \fun (u: UK.Carrier)(v: VK.Carrier)(same: Compatible u v) \then
  \takefrom first: UNormal.Result[u] \by UNormal.existence u \then
  \takefrom second: VNormal.Result[v] \by VNormal.existence v \then
  \return FromNormal[u := u, v := v, first := first, second := second].existence same
};
