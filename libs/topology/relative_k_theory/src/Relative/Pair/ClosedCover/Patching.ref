\import \parent.\parent.Restriction[] \as URestriction;
\import KTheory.On[X := A, baseSpace := subspace, compact := URestriction.compactSubset, hausdorff := URestriction.hausdorffSubset] \as UTheory;
\import KTheory.On[X := Y, baseSpace := source, compact := compactSource, hausdorff := hausdorffSource] \as VTheory;
\definition intersection: \Pow X := Base.Intersection subset V;
\definition intersectionClosed: Base.IsClosedIn space intersection := Base.Finite[].intersectionClosed space subset V closed closedV;
\import Base.Subspace[S := intersection] \as Intersection;
\definition W: \Set := Intersection.CarrierSet;
\definition wSpace: topology.Topology[Carrier := W].Topology := Intersection.topology space;
\definition compactW: topology.Topology[Carrier := W].IsCompact wSpace := Intersection.Properties[].compact space
  (Base.Compactness[].closedCompact space compact intersection intersectionClosed);
\definition hausdorffW: topology.Topology[Carrier := W].IsT2 wSpace := Intersection.Properties[].hausdorff space hausdorff;
\import KTheory.On[X := W, baseSpace := wSpace, compact := compactW, hausdorff := hausdorffW] \as WTheory;
\definition toX[w: W]: X := w;
\definition toU[w: W]: A := \into[X](w, subset) \by { (\bysub(X, intersection, w)).left };
\definition toV[w: W]: Y := \into[X](w, V) \by { (\bysub(X, intersection, w)).right };
\definition toXContinuous: topology.Continuity[A := W, B := X].Continuous wSpace space toX :=
  topology.Continuity[A := W, B := X].Corestriction[S := intersection].inclusionContinuous space;
\definition toUContinuous: topology.Continuity[A := W, B := A].Continuous wSpace subspace toU :=
  topology.Continuity[A := W, B := X].Corestriction[S := subset].corestrictContinuous wSpace space toU toXContinuous;
\definition toVContinuous: topology.Continuity[A := W, B := Y].Continuous wSpace source toV :=
  topology.Continuity[A := W, B := X].Corestriction[S := V].corestrictContinuous wSpace space toV toXContinuous;
\import hermitian_frames.Hermitian[].Over[K := C.Complex, field := Algebra.field, scalar := Hermitian.scalar, topological := Scalar.scalar.topological] \as Frames;
\definition Vector[n: N.Nat^]: \Set := Bundles.Vector n;
\definition coordinates[n: N.Nat^]: Spaces.VectorSpace (Vector n) := Bundles.coordinates n;
\definition Linear[m, n: N.Nat^]: \Set := Spaces.Linear[V := Vector m, W := Vector n, source := coordinates m, target := coordinates n].Map;
\module LinearExtension(m, n: N.Nat^, f: W -> Linear m n, regular: Frames.At[n := n].Families[X := W].Matrix[m := m].Regular wSpace f);
\module On(p: UTheory.Presentation, q: VTheory.Presentation);
\module ImagePair(Y: \Set, baseSpace: topology.Topology[Carrier := Y].Topology, m, n: N.Nat^);
\module LinearMapFamily(Y: \Set, baseSpace: topology.Topology[Carrier := Y].Topology, m, n: N.Nat^,
  map: Bundles.Morphisms[X := Y, Y := Y, F := (\fun (y: Y) => Vector m), G := (\fun (y: Y) => Vector n),
    source := Bundles.Trivial[X := Y, n := m, baseSpace := baseSpace].bundle, target := Bundles.Trivial[X := Y, n := n, baseSpace := baseSpace].bundle,
    f := (\fun (y: Y) => y)].Map);
\module Ordinary;
