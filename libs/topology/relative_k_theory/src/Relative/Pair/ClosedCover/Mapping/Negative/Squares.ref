\import \root.Relative[].Absolute[X := X, space := space, compact := compact, hausdorff := hausdorff] \as XAbsolute;
\import \root.Relative[].Absolute[X := Y0, space := space0, compact := compact0, hausdorff := hausdorff0] \as SourceXAbsolute;
\import \root.Relative[].Absolute[X := Y, space := source, compact := compactSource, hausdorff := hausdorffSource] \as VAbsolute;
\import \root.Relative[].Absolute[X := SourceCover.Y, space := SourceCover.source, compact := SourceCover.compactSource, hausdorff := SourceCover.hausdorffSource] \as SourceVAbsolute;
\import \root.Relative[].Absolute[X := A, space := subspace, compact := TargetU.compactSubset, hausdorff := TargetU.hausdorffSubset] \as UAbsolute;
\import \root.Relative[].Absolute[X := SourcePair.A, space := SourcePair.subspace, compact := SourceU.compactSubset, hausdorff := SourceU.hausdorffSubset] \as SourceUAbsolute;
\import \root.Relative[].Absolute[X := DomainPair.A, space := DomainPair.subspace, compact := TargetW.compactSubset, hausdorff := TargetW.hausdorffSubset] \as WAbsolute;
\import \root.Relative[].Absolute[X := SourceVPair.A, space := SourceVPair.subspace, compact := SourceW.compactSubset, hausdorff := SourceW.hausdorffSubset] \as SourceWAbsolute;
\import XAbsolute.Mapping[Y := Y0, source := space0, sourceCompact := compact0, sourceHausdorff := hausdorff0, f := f, regular := regular] \as WholeMap;
\import VAbsolute.Mapping[Y := SourceCover.Y, source := SourceCover.source, sourceCompact := SourceCover.compactSource,
  sourceHausdorff := SourceCover.hausdorffSource, f := onV, regular := vContinuous] \as PieceMap;
\import UAbsolute.Mapping[Y := SourcePair.A, source := SourcePair.subspace, sourceCompact := SourceU.compactSubset,
  sourceHausdorff := SourceU.hausdorffSubset, f := WholeAugmented.onSubset, regular := WholeAugmented.subsetContinuous] \as UMap;
\import WAbsolute.Mapping[Y := SourceVPair.A, source := SourceVPair.subspace, sourceCompact := SourceW.compactSubset,
  sourceHausdorff := SourceW.hausdorffSubset, f := VAugmented.onSubset, regular := VAugmented.subsetContinuous] \as WMap;
\import SourceXAbsolute.Mapping[Y := SourceCover.Y, source := SourceCover.source, sourceCompact := SourceCover.compactSource,
  sourceHausdorff := SourceCover.hausdorffSource, f := SourceCover.inclusion, regular := SourceCover.inclusionContinuous] \as SourceVInclusion;
\import XAbsolute.Mapping[Y := Y, source := source, sourceCompact := compactSource, sourceHausdorff := hausdorffSource,
  f := inclusion, regular := inclusionContinuous] \as TargetVInclusion;
\import SourceUAbsolute.Mapping[Y := SourceVPair.A, source := SourceVPair.subspace, sourceCompact := SourceW.compactSubset,
  sourceHausdorff := SourceW.hausdorffSubset, f := SourceCover.intersectionToSubset, regular := SourceCover.intersectionToSubsetContinuous] \as SourceIntersection;
\import UAbsolute.Mapping[Y := DomainPair.A, source := DomainPair.subspace, sourceCompact := TargetW.compactSubset,
  sourceHausdorff := TargetW.hausdorffSubset, f := intersectionToSubset, regular := intersectionToSubsetContinuous] \as TargetIntersection;
\import topological_constructions.Coproduct[A := SourceCover.Y, B := Fin.Fin KTheory.one] \as VSum;
\definition vSquare: \forall (z: SourceVAbsolute.model.Carrier) -> WholeMap.map (SourceVInclusion.map z) = TargetVInclusion.map (PieceMap.map z) :=
  \induction (z: SourceVAbsolute.model.Carrier) \return WholeMap.map (SourceVInclusion.map z) = TargetVInclusion.map (PieceMap.map z) \with {
    | inl: \fun (y: SourceCover.Y) => \refl(WholeMap.map (SourceVInclusion.map (VSum.inl y)))
    | inr: \fun (p: Fin.Fin KTheory.one) => \refl(WholeMap.map (SourceVInclusion.map (VSum.inr p)))
  };
\import \root.Relative[].Square[A := SourceVAbsolute.model, B := SourceXAbsolute.model, C := VAbsolute.model, D := XAbsolute.model,
  f := SourceVInclusion.map, g := WholeMap.map, h := PieceMap.map, k := TargetVInclusion.map, commutes := vSquare] \as VSquare;
\import topological_constructions.Coproduct[A := SourceVPair.A, B := Fin.Fin KTheory.one] \as WSum;
\definition wSquare: \forall (z: SourceWAbsolute.model.Carrier) -> UMap.map (SourceIntersection.map z) = TargetIntersection.map (WMap.map z) :=
  \induction (z: SourceWAbsolute.model.Carrier) \return UMap.map (SourceIntersection.map z) = TargetIntersection.map (WMap.map z) \with {
    | inl: \fun (w: SourceVPair.A) => \refl(UMap.map (SourceIntersection.map (WSum.inl w)))
    | inr: \fun (p: Fin.Fin KTheory.one) => \refl(UMap.map (SourceIntersection.map (WSum.inr p)))
  };
\import \root.Relative[].Square[A := SourceWAbsolute.model, B := SourceUAbsolute.model, C := WAbsolute.model, D := UAbsolute.model,
  f := SourceIntersection.map, g := UMap.map, h := WMap.map, k := TargetIntersection.map, commutes := wSquare] \as WSquare;
\import WholeMap.Negative[degree := degree] \as Whole;
\import PieceMap.Negative[degree := degree] \as Piece;
\import SourceVInclusion.Negative[degree := degree] \as SourceVRestriction;
\import TargetVInclusion.Negative[degree := degree] \as TargetVRestriction;
\import SourceIntersection.Negative[degree := degree] \as SourceWRestriction;
\import TargetIntersection.Negative[degree := degree] \as TargetWRestriction;
\definition whole: To.Whole -> From.Whole := Whole.map;
\definition piece: TV.Fourth -> SV.Fourth := Piece.map;
\definition wholeAdd: \forall (x, y: To.Whole) -> whole (To.wholeGroup.base.op x y) = From.wholeGroup.base.op (whole x) (whole y) := Whole.additive;
\definition wholeZero: whole To.wholeGroup.base.unit = From.wholeGroup.base.unit := Whole.preservesZero;
\definition pieceAdd: \forall (x, y: TV.Fourth) -> piece (TV.fourthGroup.base.op x y) = SV.fourthGroup.base.op (piece x) (piece y) := Piece.additive;
\definition pieceZero: piece TV.fourthGroup.base.unit = SV.fourthGroup.base.unit := Piece.preservesZero;
\definition restrictionV: \forall (x: To.Whole) -> SourceVRestriction.map (whole x) = piece (TargetVRestriction.map x) := VSquare.Negative[degree := degree].equation;
\definition restrictionU: \forall (u: TX.Fifth) -> SourceWRestriction.map (WholeNaturality.subset u) = VNaturality.subset (TargetWRestriction.map u) := WSquare.Negative[degree := degree].equation;
