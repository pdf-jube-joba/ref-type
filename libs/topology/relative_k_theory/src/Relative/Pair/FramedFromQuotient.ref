\import \parent.Quotient[] \as Quotient;
\import \parent.FromQuotient[F := F, bundle := bundle, same := same] \as Raw;
\import Raw.In[c := c, contains := contains] \as Boundary;
\import \parent.BundleModel[F := Raw.Fiber].From[original := Raw.pulled, same := (\refl(space))] \as Based;
\import \parent.FramedClass[F := Raw.Fiber, sourceModel := Based.model, n := c.dimension].With[alpha := Boundary.comparison] \as Framed;
\import \parent.QuotientClass[F := F, bundle := bundle, same := same] \as Class;
\import \parent.Group[].ToReduced[] \as Forward;
\import KTheory.On[X := Quotient.Carrier, baseSpace := Quotient.topology, compact := Quotient.quotientCompact, hausdorff := Quotient.quotientHausdorff] \as K;
\import K.K0[] \as K0;
\import K.Bundle[F := F, original := bundle, same := same] \as BundleClass;
\definition value: Quotient.Relative := Framed.value;
\definition formula: value = K0.difference BundleClass.value (K.Trivial[n := c.dimension].value) := \block {
  \takefrom result: Boundary.Result \by Boundary.existence \then
  \let raw: Raw.Witness := Raw.Witness {
    chart := \into[Bundles.Family[X := Quotient.Carrier, F := F].With[data := bundle].Chart]
      (c, { d: Bundles.Family[X := Quotient.Carrier, F := F].With[data := bundle].Chart \where topology.Topology[Carrier := Quotient.Carrier].Member d.domain Quotient.point }) \by { contains },
    result := result
  } \then
  \let agreement: Forward.map Class.value = value := trans!{{Quotient.Relative}} _ _ _
    (congr!{{\parent.Group[].Carrier} {Quotient.Relative}} Forward.map _ _ (Class.agreement raw))
    (\parent.FramedTriple[F := Raw.Fiber, sourceModel := Based.model, n := c.dimension].With[alpha := Boundary.comparison, result := result].mapEquation) \then
  \return trans!{{K0.Carrier}} _ _ _ (sym!{{K0.Carrier}} _ _ agreement)
    (\parent.QuotientComparison[F := F, bundle := bundle, same := same].In[c := c, contains := contains, result := result].equation)
};
