\definition compactSubset: topology.Topology[Carrier := A].IsCompact subspace := Subspace.Properties[].compact space
  (Base.Compactness[].closedCompact space compact subset closed);
\definition hausdorffSubset: topology.Topology[Carrier := A].IsT2 subspace := Subspace.Properties[].hausdorff space hausdorff;
\definition inclusion[x: A]: X := x;
\definition regular: topology.Continuity[A := A, B := X].Continuous subspace space inclusion :=
  topology.Continuity[A := A, B := X].Corestriction[S := subset].inclusionContinuous space;
\import Absolute.Pullback[Y := A, space := subspace, sourceCompact := compactSubset, sourceHausdorff := hausdorffSubset, f := inclusion, regular := regular] \as Pull;
\import KTheory.On[X := A, baseSpace := subspace, compact := compactSubset, hausdorff := hausdorffSubset] \as Target;
\import Absolute.K0[] \as SourceK;
\import Target.K0[] \as TargetK;
\definition classMap: Absolute.Classes -> Target.Classes := Pull.map;
\definition map: algebra.Hom[A := SourceK.Carrier, B := TargetK.Carrier].RingMap SourceK.ring TargetK.ring := Pull.K0[].map;
\module On(p: Presentation);
\module Difference(a, b: Absolute.Classes);
