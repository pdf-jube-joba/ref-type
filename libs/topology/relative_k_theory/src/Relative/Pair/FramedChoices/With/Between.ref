\import Comparison.Between[first := first, second := second] \as Construction;
\import Construction.DirectMap[] \as Maps;
\import Maps.From[] \as First;
\import Maps.To[] \as Second;
\import Comparison.Direct[] \as Direct;
\import Direct.Quotient[] \as Quotient;
\import Quotient.K[] \as K;
\import K.Compare[F := Comparison.Direct.Source.Fiber, G := Comparison.Direct.Source.Fiber,
  first := First.bundleOnQuotient, second := Second.bundleOnQuotient, firstSame := First.sameBaseSpace, secondSame := Second.sameBaseSpace] \as Classes;
\definition isomorphism: Construction.Isomorphisms.Isomorphism := Construction.isomorphism;
\definition equality: Classes.First.value = Classes.Second.value := Classes.ofIsomorphism isomorphism;
