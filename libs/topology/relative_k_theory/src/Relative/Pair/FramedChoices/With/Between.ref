\import Comparison.Between[first := first, second := second] \as Construction;
\import Source.Construction[extension := first] \as First;
\import Source.Construction[extension := second] \as Second;
\import K.K0[] \as K0;
\import K.Bundle[F := Source.Fiber, original := First.bundleOnQuotient, same := First.sameBaseSpace] \as FirstClass;
\import K.Bundle[F := Source.Fiber, original := Second.bundleOnQuotient, same := Second.sameBaseSpace] \as SecondClass;
\import K.Compare[F := Source.Fiber, G := Source.Fiber, first := First.bundleOnQuotient, second := Second.bundleOnQuotient,
  firstSame := First.sameBaseSpace, secondSame := Second.sameBaseSpace] \as Classes;
\definition isomorphism: Construction.Isomorphism := Construction.isomorphism;
\definition equality: FirstClass.value = SecondClass.value := Classes.ofIsomorphism isomorphism;
\import \parent.Value[e := first] \as FirstValue;
\import \parent.Value[e := second] \as SecondValue;
\definition reducedEquality: FirstValue.value = SecondValue.value :=
  congr!{{K.Classes} {K0.Carrier}} (\fun (a: K.Classes) => K0.difference a TrivialClass.value) _ _ equality;
