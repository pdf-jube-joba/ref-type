\definition compatible: Comparing.Forward.Compatible alpha alpha Identity.isomorphism.forward coordinateIdentity.forward :=
  \fun (x: A)(v: Absolute.Fiber p x) => \refl((alpha.forward.fiber x).apply v);
\import Comparing.With[alpha := alpha, beta := alpha, h := Identity.isomorphism, c := coordinateIdentity, compatible := compatible] \as Comparison;
\module Between(first, second: Comparison.Direct.Source.Result);
\module Value(e: Comparison.Direct.Source.Result);
