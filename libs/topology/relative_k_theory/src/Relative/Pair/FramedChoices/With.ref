\definition compatible: Maps.Compatible alpha alpha Identity.isomorphism.forward coordinateIdentity.forward :=
  \fun (x: A)(v: Absolute.Fiber p x) => \refl((alpha.forward.fiber x).apply v);
\import Comparing.With[alpha := alpha, beta := alpha, h := Identity.isomorphism, c := coordinateIdentity, compatible := compatible] \as Comparison;
\import Descent.With[comparison := alpha] \as Source;
\module Between(first, second: Source.Result);
\module Value(e: Source.Result);
