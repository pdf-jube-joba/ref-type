\import \parent.\parent.Rotation[].Endpoints[].Pullbacks[] \as Bridge;
\import \root.Relative[].Reduced[model := \root.Relative[].Suspension[original := model].result] \as Original;
\definition restriction: Original.Carrier -> Middle.Carrier := Bridge.restriction;
\definition kernel: \forall (v: Original.Carrier) -> Connecting.map (restriction v) = Quotient.group.base.unit := \block {
  \fun (v: Original.Carrier) \then
  \let source: Source.Carrier := Bridge.toImage (Bridge.reverse v) \then
  \let same: map source = restriction v := trans!{{Middle.Carrier}} _ _ _ (Bridge.bridge (Bridge.reverse v))
    (congr!{{Original.Carrier} {Middle.Carrier}} restriction _ _ (Bridge.reverseInvolutive v)) \then
  \return trans!{{Quotient.Relative}} _ _ _ (sym!{{Quotient.Relative}} _ _ (congr!{{Middle.Carrier} {Quotient.Relative}} Connecting.map _ _ same)) (\parent.kernel source)
};
\definition Image[v: Middle.Carrier]: \Prop := \exists (w: Original.Carrier \where restriction w = v);
\definition preimage: \forall (v: Middle.Carrier) -> Connecting.map v = Quotient.group.base.unit -> Image v := \block {
  \fun (v: Middle.Carrier)(zero: Connecting.map v = Quotient.group.base.unit) \then
  \takefrom w: \Cast[Source.Carrier] ({ w: Source.Carrier \where map w = v }) \by \parent.preimage v zero \then
  \let original: Original.Carrier := Bridge.fromImage w \then
  \return Logic.existsIntro[Original.Carrier, { u: Original.Carrier \where restriction u = v }] (Bridge.reverse original)
    (trans!{{Middle.Carrier}} _ _ _ (sym!{{Middle.Carrier}} _ _ (Bridge.bridge original))
      (trans!{{Middle.Carrier}} _ _ _ (congr!{{Source.Carrier} {Middle.Carrier}} map _ _ (Bridge.toFrom w))
        (\bysub(Source.Carrier, { w: Source.Carrier \where map w = v }, w))))
};
\definition inKernel: \forall (v: Middle.Carrier) -> Image v -> Connecting.map v = Quotient.group.base.unit := \block {
  \fun (v: Middle.Carrier)(image: Image v) \then
  \takefrom w: \Cast[Original.Carrier] ({ w: Original.Carrier \where restriction w = v }) \by image \then
  \return \idelim restriction w = v \with x: Middle.Carrier => Connecting.map x = Quotient.group.base.unit \by {
    base: kernel w, equality: \bysub(Original.Carrier, { w: Original.Carrier \where restriction w = v }, w)
  }
};
\definition exact[v: Middle.Carrier]: Logic.PropEquiv[Connecting.map v = Quotient.group.base.unit, Image v] := Logic.PropEquiv[_, _] {
  ltr := preimage v, rtl := inKernel v
};
