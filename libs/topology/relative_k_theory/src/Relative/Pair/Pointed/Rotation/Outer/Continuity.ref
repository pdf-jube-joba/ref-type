\definition heightContinuous: topology.Continuity[A := Domain.Carrier, B := Interval.Carrier].Continuous domainTopology Interval.topology (\fun (p: Domain.Carrier) => Second.time (Domain.point p)) :=
  topology.Composition[A := Domain.Carrier, B := Second.DomainPoint, C := Interval.Carrier].composeContinuous domainTopology Second.domainTopology Interval.topology
    Domain.point Second.time (Domain.pointContinuous Second.domainTopology) Second.timeContinuous;
\definition parameterContinuous: topology.Continuity[A := Domain.Carrier, B := Square.CarrierSet].Continuous domainTopology squareTopology parameter :=
  Square.Universal[X := Domain.Carrier].pairContinuous domainTopology Interval.topology Interval.topology Domain.time
    (\fun (p: Domain.Carrier) => Second.time (Domain.point p)) (Domain.timeContinuous Second.domainTopology) heightContinuous;
\definition pointContinuous: topology.Continuity[A := Domain.Carrier, B := First.Carrier].Continuous domainTopology First.topology (\fun (p: Domain.Carrier) => Second.point (Domain.point p)) :=
  topology.Composition[A := Domain.Carrier, B := Second.DomainPoint, C := First.Carrier].composeContinuous domainTopology Second.domainTopology First.topology
    Domain.point Second.point (Domain.pointContinuous Second.domainTopology) Second.pointContinuous;
\definition inputContinuous: topology.Continuity[A := Domain.Carrier, B := topological_constructions.Product[A := Square.CarrierSet, B := First.Carrier].CarrierSet].Continuous domainTopology Interior.resultTopology input :=
  topological_constructions.Product[A := Square.CarrierSet, B := First.Carrier].Universal[X := Domain.Carrier].pairContinuous domainTopology squareTopology First.topology parameter
    (\fun (p: Domain.Carrier) => Second.point (Domain.point p)) parameterContinuous pointContinuous;
\definition continuous: topology.Continuity[A := Domain.Carrier, B := Target.Carrier].Continuous domainTopology Target.topology raw :=
  topology.Composition[A := Domain.Carrier, B := topological_constructions.Product[A := Square.CarrierSet, B := First.Carrier].CarrierSet, C := Target.Carrier].composeContinuous domainTopology Interior.resultTopology Target.topology
    input Interior.map inputContinuous Interior.continuous;
