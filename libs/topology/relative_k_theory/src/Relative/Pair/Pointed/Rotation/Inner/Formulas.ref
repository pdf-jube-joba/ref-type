\definition atBase: \forall (h, t: Interval.Carrier)(x: X) -> map (Pair.pair Square.CarrierSet First.Carrier (square h t) (First.base x)) = Target.class (TargetCylinder.at (Times.advance h t) x) :=
  \fun (h, t: Interval.Carrier)(x: X) => trans!{{Target.Carrier}} _ _ _ (onClass (square h t) (First.bottom x))
    (congr!{{Interval.Carrier} {Target.Carrier}} (\fun (u: Interval.Carrier) => Target.class (TargetCylinder.at u x)) _ _
      (trans!{{Interval.Carrier}} _ _ _ (congr!{{Interval.Carrier} {Interval.Carrier}} (Times.multiply (Times.advance h t)) _ _ Interval.reverseStart)
        (multiplyOne (Times.advance h t))));
\definition atLine: \forall (h, t: Interval.Carrier) -> map (Pair.pair Square.CarrierSet First.Carrier (square h t) (First.base a0)) = Target.point :=
  \fun (h, t: Interval.Carrier) => trans!{{Target.Carrier}} _ _ _ (atBase h t a0) (Target.line (Times.advance h t));
\definition atStartRaw: \forall (z: First.DomainPoint) -> map (Pair.pair Square.CarrierSet First.Carrier (square Interval.start Interval.start) (FirstCollapse.class z)) = Target.point :=
  \fun (z: First.DomainPoint) => trans!{{Target.Carrier}} _ _ _ (onClass (square Interval.start Interval.start) z)
    (trans!{{Target.Carrier}} _ _ _ (congr!{{Interval.Carrier} {Target.Carrier}} (\fun (u: Interval.Carrier) => Target.class (TargetCylinder.at u (First.point z))) _ _
      (trans!{{Interval.Carrier}} _ _ _ (congr!{{Interval.Carrier} {Interval.Carrier}} (\fun (u: Interval.Carrier) => Times.multiply u (Interval.reverse (First.time z))) _ _ (Times.advanceStart Interval.start))
        (zeroMultiply (Interval.reverse (First.time z))))) (Target.bottom (First.point z)));
\definition atStart: \forall (z: First.Carrier) -> map (Pair.pair Square.CarrierSet First.Carrier (square Interval.start Interval.start) z) = Target.point :=
  FirstCollapse.induction (\fun (z: First.Carrier) => map (Pair.pair Square.CarrierSet First.Carrier (square Interval.start Interval.start) z) = Target.point) atStartRaw;
\definition atEnd: \forall (t: Interval.Carrier)(z: First.DomainPoint) -> map (Pair.pair Square.CarrierSet First.Carrier (square Interval.end t) (FirstCollapse.class z)) = Target.class (TargetCylinder.at (Interval.reverse (First.time z)) (First.point z)) :=
  \fun (t: Interval.Carrier)(z: First.DomainPoint) => trans!{{Target.Carrier}} _ _ _ (onClass (square Interval.end t) z)
    (congr!{{Interval.Carrier} {Target.Carrier}} (\fun (u: Interval.Carrier) => Target.class (TargetCylinder.at u (First.point z))) _ _
      (trans!{{Interval.Carrier}} _ _ _ (congr!{{Interval.Carrier} {Interval.Carrier}} (\fun (u: Interval.Carrier) => Times.multiply u (Interval.reverse (First.time z))) _ _ (Times.advanceEnd t))
        (oneMultiply (Interval.reverse (First.time z)))));
