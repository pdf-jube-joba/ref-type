\import \parent.Exact[] \as Native;
\import \parent.Connecting[] \as Connecting;
\import \parent.LeftExact[].Suspension[] \as Left;
\import \parent.\parent.Quotient[] \as Quotient;
\import \root.Relative[].Negative[original := model, degree := KTheory.one] \as NegativeX;
\import \root.Relative[].Negative[original := subsetModel, degree := KTheory.one] \as NegativeA;
\import \root.Relative[].Reduced[model := model] \as ReducedX;
\import \root.Relative[].Reduced[model := subsetModel] \as ReducedA;
\definition First: \Set := NegativeX.Carrier;
\definition Second: \Set := NegativeA.Carrier;
\definition Third: \Set := Quotient.Relative;
\definition Fourth: \Set := ReducedX.Carrier;
\definition Fifth: \Set := ReducedA.Carrier;
\definition firstGroup: std.Alg[].Alg[].CommutativeGroup[First] := NegativeX.group;
\definition secondGroup: std.Alg[].Alg[].CommutativeGroup[Second] := NegativeA.group;
\definition thirdGroup: std.Alg[].Alg[].CommutativeGroup[Third] := Quotient.group;
\definition fourthGroup: std.Alg[].Alg[].CommutativeGroup[Fourth] := ReducedX.group;
\definition fifthGroup: std.Alg[].Alg[].CommutativeGroup[Fifth] := ReducedA.group;
\definition restrictionNegative: First -> Second := Left.restriction;
\definition boundary: Second -> Third := Connecting.map;
\definition forget: Third -> Fourth := Native.forget;
\definition restriction: Fourth -> Fifth := Native.restriction;
\import \root.Relative[].NegativeMap[source := subsetModel, target := model, f := Native.inclusion, degree := KTheory.one] \as NegativeRestriction;
\definition negativeFormula: \forall (v: First) -> restrictionNegative v = NegativeRestriction.map v := \fun (v: First) => \refl(restrictionNegative v);
\definition restrictionNegativeAdd: \forall (v, w: First) -> restrictionNegative (firstGroup.base.op v w) = secondGroup.base.op (restrictionNegative v) (restrictionNegative w) := NegativeRestriction.additive;
\definition boundaryAdd: \forall (v, w: Second) -> boundary (secondGroup.base.op v w) = thirdGroup.base.op (boundary v) (boundary w) := Connecting.additive;
\definition forgetAdd: \forall (v, w: Third) -> forget (thirdGroup.base.op v w) = fourthGroup.base.op (forget v) (forget w) := Native.forgetAdd;
\definition restrictionAdd: \forall (v, w: Fourth) -> restriction (fourthGroup.base.op v w) = fifthGroup.base.op (restriction v) (restriction w) := Native.restrictionAdd;
\definition restrictionNegativeZero: restrictionNegative firstGroup.base.unit = secondGroup.base.unit := NegativeRestriction.preservesZero;
\definition boundaryZero: boundary secondGroup.base.unit = thirdGroup.base.unit := Connecting.preservesZero;
\definition forgetZero: forget thirdGroup.base.unit = fourthGroup.base.unit := Native.forgetZero;
\definition restrictionZero: restriction fourthGroup.base.unit = fifthGroup.base.unit := Native.restrictionZero;
\definition exactSecond[v: Second]: Logic.PropEquiv[boundary v = thirdGroup.base.unit, \exists (w: First \where restrictionNegative w = v)] := Left.exact v;
\definition exactThird[v: Third]: Logic.PropEquiv[forget v = fourthGroup.base.unit, \exists (w: Second \where boundary w = v)] := Connecting.exact v;
\definition exactFourth[v: Fourth]: Logic.PropEquiv[restriction v = fifthGroup.base.unit, \exists (w: Third \where forget w = v)] := Native.exact v;
