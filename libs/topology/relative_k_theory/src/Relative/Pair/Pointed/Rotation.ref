\import \parent.Cofiber[] \as First;
\import algebraic_topology.Interval[] \as Interval;
\import Interval.Arithmetic[] \as Times;
\import algebraic_topology.Cylinder[A := X] \as TargetCylinder;
\import \root.Relative[].Suspension[original := model] \as Suspended;
\import algebraic_topology.Suspension[A := X].Pointed[source := space, basepoint := a0] \as Target;
\import algebraic_topology.Collapse[A := First.DomainPoint, subset := First.collapsedPart] \as FirstCollapse;
\import topological_constructions.RelationQuotient[A := First.DomainPoint, relation := FirstCollapse.Related] \as FirstQuotient;
\import std.Data[].Pair[] \as Pair;
\import topological_constructions.Product[A := Interval.Carrier, B := Interval.Carrier] \as Square;
\definition squareTopology: topology.Topology[Carrier := Square.CarrierSet].Topology := Square.topology Interval.topology Interval.topology;
\definition squareCompact: topology.Topology[Carrier := Square.CarrierSet].IsCompact squareTopology := Square.Compactness[].productCompact Interval.topology Interval.topology Interval.compact Interval.compact;
\definition squareHausdorff: topology.Topology[Carrier := Square.CarrierSet].IsT2 squareTopology :=
  topological_constructions.Separation[].Product[A := Interval.Carrier, B := Interval.Carrier].On[left := Interval.topology, right := Interval.topology,
    leftHausdorff := Interval.hausdorff, rightHausdorff := Interval.hausdorff].hausdorff;
\definition square[h, t: Interval.Carrier]: Square.CarrierSet := Pair.pair Interval.Carrier Interval.Carrier h t;
\module Inner;
\import First.BaseImage[] \as Image;
\import \root.Relative[].Pair[X := First.Carrier, space := First.topology, compact := (details First.result).compact, hausdorff := (details First.result).hausdorff,
  subset := First.baseImage, closed := First.baseImageClosed] \as SecondPair;
\import SecondPair.Pointed[a0 := (Image.into a0)] \as SecondPointed;
\import SecondPointed.Cofiber[] \as Second;
\import Second.Projection[] \as SecondProjection;
\import algebraic_topology.Collapse[A := Second.DomainPoint, subset := Second.collapsedPart] \as SecondCollapse;
\import topological_constructions.RelationQuotient[A := Second.DomainPoint, relation := SecondCollapse.Related] \as SecondQuotient;
