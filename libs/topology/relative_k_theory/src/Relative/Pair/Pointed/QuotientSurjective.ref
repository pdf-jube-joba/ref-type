\import \parent.\parent.Quotient[] \as Quotient;
\import algebraic_topology.Collapse[A := Quotient.Augmented, subset := Quotient.collapsedPart] \as Native;
\import topological_constructions.Coproduct[A := X, B := Quotient.Point] \as Sum;
\definition onto: \forall (q: Quotient.Carrier) -> \exists (x: X \where Quotient.projection x = q) :=
  Native.induction (\fun (q: Quotient.Carrier) => \exists (x: X \where Quotient.projection x = q))
    (\induction (p: Quotient.Augmented) \return \exists (x: X \where Quotient.projection x = Native.class p) \with {
      | inl: \fun (x: X) => Logic.existsIntro[X, { y: X \where Quotient.projection y = Quotient.projection x }] x (\refl(Quotient.projection x))
      | inr: \fun (p: Quotient.Point) => Logic.existsIntro[X, { x: X \where Quotient.projection x = Native.class (Sum.inr p) }] a0
        (trans!{{Quotient.Carrier}} _ _ _ (Quotient.onSubset a0)
          (Native.collapsed (Sum.inr Quotient.distinguished) (Sum.inr p) (\refl(Quotient.distinguished)) (\refl(p))))
    });
