\import \parent.\parent.\parent.Quotient[] \as Original;
\import \parent.\parent.QuotientSurjective[] \as OriginalOnto;
\import \root.Relative[].Suspension[original := Original.model] \as SuspendedQuotient;
\import algebraic_topology.Suspension[A := Original.Carrier].Pointed[source := Original.topology, basepoint := Original.point] \as Target;
\import algebraic_topology.Cylinder[A := Original.Carrier] \as QuotientCylinder;
\import algebraic_topology.Collapse[A := QuotientCylinder.Carrier, subset := Target.Collapsed] \as TargetNative;
\import To.Mapping[B := Original.Carrier, target := (pointed Original.model), f := Exact.projectionMap] \as Projected;
\import \root.Relative[].Pair[X := To.Carrier, space := To.topology, compact := (details result).compact, hausdorff := (details result).hausdorff,
  subset := image, closed := imageClosed] \as SpacePair;
\import SpacePair.Quotient[] \as Q;
\import SpacePair.Pointed[a0 := distinguished].QuotientSurjective[] \as SourceOnto;
\import algebraic_topology.Collapse[A := Q.Augmented, subset := Q.collapsedPart] \as SourceNative;
\import topological_constructions.Coproduct[A := To.Carrier, B := Q.Point] \as Augment;
\module Forward;
\import Forward[] \as Fwd;
\module Injective;
\import Injective[] \as Embedding;
\import \root.Relative[].Equivalence[source := Q.model, target := SuspendedQuotient.result].FromMap[f := Fwd.map, injective := Embedding.injective, onto := Fwd.onto] \as Homeomorphism;
\definition equivalence: \root.Relative[].Equivalence[source := Q.model, target := SuspendedQuotient.result].Data := Homeomorphism.equivalence;
\import \root.Relative[].Equivalence[source := Q.model, target := SuspendedQuotient.result].With[e := equivalence].Groups[] \as Groups;
\definition forward: \root.Relative[].Reduced[model := SuspendedQuotient.result].Carrier -> Q.Relative := Groups.forward;
\definition backward: Q.Relative -> \root.Relative[].Reduced[model := SuspendedQuotient.result].Carrier := Groups.backward;
\definition leftInverse: \forall (v: Q.Relative) -> forward (backward v) = v := Groups.leftInverse;
\definition rightInverse: \forall (v: \root.Relative[].Reduced[model := SuspendedQuotient.result].Carrier) -> backward (forward v) = v := Groups.rightInverse;
\definition onProjection: \forall (v: To.Carrier) -> equivalence.forward (Q.projection v) = Projected.map v := Fwd.onProjection;
