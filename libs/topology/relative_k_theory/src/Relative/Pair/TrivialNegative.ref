\import \parent.TripleClass[t := t] \as Canonical;
\import Complements.Projection[X := X, n := t.negative.dimension, baseSpace := space, P := t.negative.projection, regular := t.negative.regular].Complement[] \as Split;
\definition E[x: X]: \Set := Absolute.Fiber t.positive x;
\definition F[x: X]: \Set := Absolute.Fiber t.negative x;
\import \parent.BundleModel[F := E].From[original := (Absolute.bundle t.positive), same := (\refl(space))] \as PositiveModel;
\definition model: \parent.BundleModel[F := E].Bundle := PositiveModel.model;
\import Operations.Zero[X := X, baseSpace := space] \as Zero;
\import Absolute.Bundle[F := (\fun (x: X) => Zero.Fiber), original := Zero.bundle, same := (\refl(space))] \as ZeroRepresentation;
\import Bundles.Trivial[X := X, n := n, baseSpace := space] \as Trivial;
\import Bundles.Isomorphisms[X := X, F := F, G := (\fun (x: X) => Bundles.Vector n), source := (Absolute.bundle t.negative), target := Trivial.bundle] \as Trivializations;
\definition inclusion[x: A]: X := x;
\definition regular: topology.Continuity[A := A, B := X].Continuous subspace space inclusion := topology.Continuity[A := A, B := X].Corestriction[S := subset].inclusionContinuous space;
\import Complements.PulledIsomorphism[X := X, Y := A, F := F, G := (\fun (x: X) => Bundles.Vector n), source := (Absolute.bundle t.negative), target := Trivial.bundle,
  base := subspace, f := inclusion, sourceRegular := regular, targetRegular := regular] \as Pull;
\import Bundles.Family[X := X, F := (\fun (x: X) => Bundles.Vector n)].Of[bundle := Trivial.bundle].Restriction[U := subset] \as BoundaryTrivial;
\import Operations.IsomorphismComposition[X := A, F := \parent.Restricted[p := t.positive].Fiber, G := \parent.Restricted[p := t.negative].Fiber, H := (\fun (x: A) => Bundles.Vector n),
  source := \parent.Restricted[p := t.positive].bundle, middle := \parent.Restricted[p := t.negative].bundle, target := BoundaryTrivial.restricted] \as BoundaryComposition;
\import Operations.IdentityIsomorphism[X := X, F := E, bundle := (Absolute.bundle t.positive)] \as IdentityE;
\import Operations.IdentityIsomorphism[X := X, F := F, bundle := (Absolute.bundle t.negative)] \as IdentityF;
\import Operations.DirectSumRightUnit[X := X, F := E, bundle := (Absolute.bundle t.positive)] \as PositiveUnit;
\import Operations.DirectSumRightUnit[X := X, F := F, bundle := (Absolute.bundle t.negative)] \as NegativeUnit;
\import Spaces.Isomorphism[V := Bundles.Vector n, W := Bundles.Vector n, source := Bundles.coordinates n, target := Bundles.coordinates n] \as Coordinates;
\definition coordinateIdentity: Coordinates.Isomorphism := Coordinates.Isomorphism {
  forward := Spaces.FiniteCoordinates[n := n].identity, backward := Spaces.FiniteCoordinates[n := n].identity,
  leftInverse := \fun (v: Bundles.Vector n) => \refl(v), rightInverse := \fun (v: Bundles.Vector n) => \refl(v)
};
\import \parent.Quotient[] \as Quotient;
\module With(h: Trivializations.Isomorphism);
