\import std.Data[].Pair[] \as Pair;
\definition e: E x := Pair.first (E x) (S x) (Pair.first (First.SourceFiber x) (Second.SourceFiber x) z);
\definition s: S x := Pair.second (E x) (S x) (Pair.first (First.SourceFiber x) (Second.SourceFiber x) z);
\definition g: G x := Pair.first (G x) (T x) (Pair.second (First.SourceFiber x) (Second.SourceFiber x) z);
\definition tAux: T x := Pair.second (G x) (T x) (Pair.second (First.SourceFiber x) (Second.SourceFiber x) z);
\definition boundaryPair: NegativePair.Fiber x := Pair.pair (F x) (H x) ((t.comparison.forward.fiber x).apply e) ((u.comparison.forward.fiber x).apply g);
\definition auxiliaryPair: Auxiliary.Fiber x := Pair.pair (S x) (T x) s tAux;
\definition raw: NegativeOrder.TargetFiber x := Pair.pair (NegativePair.Fiber x) (Auxiliary.Fiber x) boundaryPair auxiliaryPair;
\definition equation: (TargetData.comparison.forward.fiber x).apply ((positive.forward.fiber x).apply z) = coordinateIdentity.forward.apply ((Source.comparison.forward.fiber x).apply z) :=
  trans!{{Bundles.Vector Framed.dimension}} _ _ _
    (congr!{{Absolute.Fiber v.negative x} {Bundles.Vector Framed.dimension}}
      (\fun (y: Absolute.Fiber v.negative x) => (trivialization.forward.fiber x).apply
        (Pair.pair (Absolute.Fiber v.negative x) (U x) y ((auxiliary.isomorphism.forward.fiber x).apply auxiliaryPair))) _ _ (w.agrees x e g))
    (congr!{{NegativeOrder.TargetFiber x} {Bundles.Vector Framed.dimension}} (toCoordinates.forward.fiber x).apply _ _ (negativeLaws.leftInverse x raw));
