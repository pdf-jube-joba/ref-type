\structure Witness: \Set := {
  positive: Positive.Isomorphism,
  negative: Negative.Isomorphism,
  commutes: \forall (x: A)(v: F x) ->
    (beta.forward.fiber x).apply ((positive.forward.fiber x).apply v) = (negative.forward.fiber x).apply ((alpha.forward.fiber x).apply v)
};
\module With(w: Witness);
