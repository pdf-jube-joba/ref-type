\import std.Data[].Pair[] \as Pair;
\structure Result: \Set := {
  isomorphism: Global.Isomorphism,
  formula: \forall (x: A)(v: F x)(w: G x) ->
    (isomorphism.forward.fiber x).apply (Pair.pair (F x) (G x) v w) = Pair.pair (F x) (G x)
      ((alpha.backward.fiber x).apply w) ((target.space x).neg ((alpha.forward.fiber x).apply v)),
  exchange: Global.Isomorphism,
  exchangeFormula: \forall (x: A)(v: F x)(w: G x) ->
    (exchange.forward.fiber x).apply (Pair.pair (F x) (G x) v w) = Pair.pair (F x) (G x) ((alpha.backward.fiber x).apply w) ((alpha.forward.fiber x).apply v)
};
\module Using(f: ForwardExtension.Result[alpha.forward], g: BackwardExtension.Result[alpha.backward]);
\definition existence: \exists Result := \block {
  \takefrom f: ForwardExtension.Result[alpha.forward] \by ForwardExtension.extend alpha.forward compact hausdorff closed \then
  \takefrom g: BackwardExtension.Result[alpha.backward] \by BackwardExtension.extend alpha.backward compact hausdorff closed \then
  \return \exact(Using[f := f, g := g].result, Result)
};
