\import Shears.Upper[h := g.map, a := Algebra.field.one] \as Upper;
\import Shears.Lower[h := f.map, a := (Algebra.field.neg Algebra.field.one)] \as Lower;
\import Operations.IsomorphismComposition[X := X, F := Sum.Fiber, G := Sum.Fiber, H := Sum.Fiber, source := sumBundle, middle := sumBundle, target := sumBundle] \as Composition;
\definition first: Global.Isomorphism := Composition.compose Upper.isomorphism Lower.isomorphism;
\definition isomorphism: Global.Isomorphism := Composition.compose first Upper.isomorphism;
\definition boundaryLaws: Boundary.Laws[alpha] := \bysub(Boundary.Data, Boundary.Isomorphism, alpha);
\module At(x: A);
\definition result: Result := Result {
  isomorphism := isomorphism,
  formula := \fun (x: A)(v: F x)(w: G x) => At[x := x].formula (Pair.pair (F x) (G x) v w)
};
