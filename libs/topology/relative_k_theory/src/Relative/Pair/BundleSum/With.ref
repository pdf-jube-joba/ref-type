\import \parent.\parent.FromBundles[F := F, G := G, source := First.first, target := First.second, sourceSame := (\refl(space)), targetSame := (\refl(space))] \as FirstRep;
\import \parent.\parent.FromBundles[F := H, G := I, source := Second.first, target := Second.second, sourceSame := (\refl(space)), targetSame := (\refl(space))] \as SecondRep;
\import \parent.\parent.FromBundles[F := J, G := L, source := Third.first, target := Third.second, sourceSame := (\refl(space)), targetSame := (\refl(space))] \as ThirdRep;
\import \parent.\parent.Group[] \as Group;
\module Represented(r: FirstRep.Result[alpha], s: SecondRep.Result[beta], v: ThirdRep.Result[gamma]);
\definition equation: Group.add First.With[alpha := alpha].value Second.With[alpha := beta].value = Third.With[alpha := gamma].value := \block {
  \takefrom r: FirstRep.Result[alpha] \by FirstRep.existence alpha \then
  \takefrom s: SecondRep.Result[beta] \by SecondRep.existence beta \then
  \takefrom v: ThirdRep.Result[gamma] \by ThirdRep.existence gamma \then
  \return trans!{{Group.Carrier}} _ _ _
    (congr!{{Group.Carrier} {Group.Carrier} {Group.Carrier}} Group.add _ _ _ _ (First.With[alpha := alpha].agreement r) (Second.With[alpha := beta].agreement s))
    (trans!{{Group.Carrier}} _ _ _ (Group.sum r.value s.value v.value Represented[r := r, s := s, v := v].witness)
      (sym!{{Group.Carrier}} _ _ (Third.With[alpha := gamma].agreement v)))
};
\import \parent.\parent.Quotient[] \as Quotient;
\definition reducedEquation: Quotient.group.base.op First.With[alpha := alpha].reduced Second.With[alpha := beta].reduced = Third.With[alpha := gamma].reduced :=
  trans!{{Quotient.Relative}} _ _ _
    (sym!{{Quotient.Relative}} _ _ (Group.ToReduced[].additive First.With[alpha := alpha].value Second.With[alpha := beta].value))
    (congr!{{Group.Carrier} {Quotient.Relative}} Group.ToReduced[].map _ _ equation);
