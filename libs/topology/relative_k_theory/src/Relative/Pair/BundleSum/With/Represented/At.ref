\definition firstAgreement[a: Absolute.Fiber r.value.positive x]:
  (r.negative.backward.fiber x).apply ((r.value.comparison.forward.fiber x).apply a) =
    (alpha.forward.fiber x).apply ((r.positive.backward.fiber x).apply a) :=
  trans!{{G x}} _ _ _
    (congr!{{Absolute.Fiber r.value.negative x} {G x}} (r.negative.backward.fiber x).apply _ _
      (trans!{{Absolute.Fiber r.value.negative x}} _ _ _
        (congr!{{Absolute.Fiber r.value.positive x} {Absolute.Fiber r.value.negative x}} (r.value.comparison.forward.fiber x).apply _ _
          (sym!{{Absolute.Fiber r.value.positive x}} _ _ ((\bysub(PositiveFirst.Data, PositiveFirst.Isomorphism, r.positive)).rightInverse x a)))
        (r.agrees x ((r.positive.backward.fiber x).apply a))))
    ((\bysub(NegativeFirst.Data, NegativeFirst.Isomorphism, r.negative)).leftInverse x _);
\definition secondAgreement[a: Absolute.Fiber s.value.positive x]:
  (s.negative.backward.fiber x).apply ((s.value.comparison.forward.fiber x).apply a) =
    (beta.forward.fiber x).apply ((s.positive.backward.fiber x).apply a) :=
  trans!{{I x}} _ _ _
    (congr!{{Absolute.Fiber s.value.negative x} {I x}} (s.negative.backward.fiber x).apply _ _
      (trans!{{Absolute.Fiber s.value.negative x}} _ _ _
        (congr!{{Absolute.Fiber s.value.positive x} {Absolute.Fiber s.value.negative x}} (s.value.comparison.forward.fiber x).apply _ _
          (sym!{{Absolute.Fiber s.value.positive x}} _ _ ((\bysub(PositiveSecond.Data, PositiveSecond.Isomorphism, s.positive)).rightInverse x a)))
        (s.agrees x ((s.positive.backward.fiber x).apply a))))
    ((\bysub(NegativeSecond.Data, NegativeSecond.Isomorphism, s.negative)).leftInverse x _);
\definition equation: \forall (a: Absolute.Fiber r.value.positive x)(b: Absolute.Fiber s.value.positive x) ->
  (v.value.comparison.forward.fiber x).apply ((positive.forward.fiber x).apply (Product.pair (Absolute.Fiber r.value.positive x) (Absolute.Fiber s.value.positive x) a b)) =
  (negative.forward.fiber x).apply (Product.pair (Absolute.Fiber r.value.negative x) (Absolute.Fiber s.value.negative x)
    ((r.value.comparison.forward.fiber x).apply a) ((s.value.comparison.forward.fiber x).apply b)) :=
  \fun (a: Absolute.Fiber r.value.positive x)(b: Absolute.Fiber s.value.positive x) =>
    trans!{{Absolute.Fiber v.value.negative x}} _ _ _
      (v.agrees x ((witness.positive.forward.fiber x).apply
        (Product.pair (F x) (H x) ((r.positive.backward.fiber x).apply a) ((s.positive.backward.fiber x).apply b))))
      (trans!{{Absolute.Fiber v.value.negative x}} _ _ _
        (congr!{{L x} {Absolute.Fiber v.value.negative x}} (v.negative.forward.fiber x).apply _ _
          (witness.agrees x ((r.positive.backward.fiber x).apply a) ((s.positive.backward.fiber x).apply b)))
        (congr!{{G x} {I x} {Absolute.Fiber v.value.negative x}}
          (\fun (g: G x)(i: I x) => (v.negative.forward.fiber x).apply ((witness.negative.forward.fiber x).apply (Product.pair (G x) (I x) g i))) _ _ _ _
          (sym!{{G x}} _ _ (firstAgreement a)) (sym!{{I x}} _ _ (secondAgreement b))));
