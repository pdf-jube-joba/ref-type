\import Bundles.Isomorphisms[X := X, F := F, G := Absolute.Fiber r.value.positive, source := First.first, target := Absolute.bundle r.value.positive] \as PositiveFirst;
\import Bundles.Isomorphisms[X := X, F := H, G := Absolute.Fiber s.value.positive, source := Second.first, target := Absolute.bundle s.value.positive] \as PositiveSecond;
\import Operations.DirectSumIsomorphisms[X := X, F := Absolute.Fiber r.value.positive, G := Absolute.Fiber s.value.positive, A := F, B := H,
  first := Absolute.bundle r.value.positive, second := Absolute.bundle s.value.positive, newFirst := First.first, newSecond := Second.first,
  sameSource := (\refl(space)), sameTarget := (\refl(space))] \as PositiveSum;
\import Operations.IsomorphismComposition[X := X, F := PositiveSum.SourceFiber, G := Positive.Fiber, H := J,
  source := PositiveSum.sourceBundle, middle := Positive.bundle (\refl(space)), target := Third.first] \as PositiveStart;
\definition positiveStart: PositiveStart.Isomorphism := PositiveStart.compose
  (PositiveSum.isomorphism (PositiveFirst.inverse r.positive) (PositiveSecond.inverse s.positive)) witness.positive;
\import Operations.IsomorphismComposition[X := X, F := PositiveSum.SourceFiber, G := J, H := Absolute.Fiber v.value.positive,
  source := PositiveSum.sourceBundle, middle := Third.first, target := Absolute.bundle v.value.positive] \as PositiveFinish;
\definition positive: PositiveFinish.Isomorphism := PositiveFinish.compose positiveStart v.positive;
\import Bundles.Isomorphisms[X := X, F := G, G := Absolute.Fiber r.value.negative, source := First.second, target := Absolute.bundle r.value.negative] \as NegativeFirst;
\import Bundles.Isomorphisms[X := X, F := I, G := Absolute.Fiber s.value.negative, source := Second.second, target := Absolute.bundle s.value.negative] \as NegativeSecond;
\import Operations.DirectSumIsomorphisms[X := X, F := Absolute.Fiber r.value.negative, G := Absolute.Fiber s.value.negative, A := G, B := I,
  first := Absolute.bundle r.value.negative, second := Absolute.bundle s.value.negative, newFirst := First.second, newSecond := Second.second,
  sameSource := (\refl(space)), sameTarget := (\refl(space))] \as NegativeSum;
\import Operations.IsomorphismComposition[X := X, F := NegativeSum.SourceFiber, G := Negative.Fiber, H := L,
  source := NegativeSum.sourceBundle, middle := Negative.bundle (\refl(space)), target := Third.second] \as NegativeStart;
\definition negativeStart: NegativeStart.Isomorphism := NegativeStart.compose
  (NegativeSum.isomorphism (NegativeFirst.inverse r.negative) (NegativeSecond.inverse s.negative)) witness.negative;
\import Operations.IsomorphismComposition[X := X, F := NegativeSum.SourceFiber, G := L, H := Absolute.Fiber v.value.negative,
  source := NegativeSum.sourceBundle, middle := Third.second, target := Absolute.bundle v.value.negative] \as NegativeFinish;
\definition negative: NegativeFinish.Isomorphism := NegativeFinish.compose negativeStart v.negative;
\module At(x: A);
\definition witness: \parent.\parent.\parent.Sum[t := r.value, u := s.value, v := v.value].Witness :=
  \parent.\parent.\parent.Sum[t := r.value, u := s.value, v := v.value].Witness {
    positive := positive, negative := negative, agrees := \fun (x: A) => At[x := x].equation
  };
