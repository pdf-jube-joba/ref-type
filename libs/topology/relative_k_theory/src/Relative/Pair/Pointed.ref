\import \parent.Restriction[] \as Restrict;
\definition model: CompactPointed := pack X (PointedDetails[X] { topology := space, compact := compact, hausdorff := hausdorff, point := a0 });
\definition subsetModel: CompactPointed := pack A (PointedDetails[A] { topology := subspace, compact := Restrict.compactSubset, hausdorff := Restrict.hausdorffSubset, point := a0 });
