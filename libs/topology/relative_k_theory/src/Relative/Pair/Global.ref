\import Bundles.Isomorphisms[X := X, F := Absolute.Fiber t.positive, G := Absolute.Fiber t.negative,
  source := Absolute.bundle t.positive, target := Absolute.bundle t.negative] \as Maps;
\structure Witness: \Set := {
  isomorphism: Maps.Isomorphism,
  agrees: \forall (x: A)(v: Absolute.Fiber t.positive x) -> (isomorphism.forward.fiber x).apply v = (t.comparison.forward.fiber x).apply v
};
