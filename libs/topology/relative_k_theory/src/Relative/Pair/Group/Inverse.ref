\import \parent.\parent.Between[p := t.positive, q := t.negative] \as Between;
\import \parent.\parent.Compose[p := t.positive, q := t.negative, r := t.positive,
  first := t.comparison, second := Between.inverse t.comparison] \as Composed;
\import \parent.Composition[p := t.positive, q := t.negative, r := t.positive,
  first := t.comparison, second := Between.inverse t.comparison] \as Composition;
\import Bundles.Isomorphisms[X := A, F := \parent.\parent.Restricted[p := t.positive].Fiber,
  G := \parent.\parent.Restricted[p := t.negative].Fiber,
  source := \parent.\parent.Restricted[p := t.positive].bundle, target := \parent.\parent.Restricted[p := t.negative].bundle] \as Alpha;
\import Operations.IdentityIsomorphism[X := X, F := Absolute.Fiber t.positive, bundle := Absolute.bundle t.positive] \as Identity;
\definition witness: \parent.\parent.Global[t := Composed.triple].Witness := \parent.\parent.Global[t := Composed.triple].Witness {
  isomorphism := Identity.isomorphism,
  agrees := \fun (x: A)(v: Absolute.Fiber t.positive x) => sym!{{Absolute.Fiber t.positive x}} _ _
    ((\bysub(Alpha.Data, Alpha.Isomorphism, t.comparison)).leftInverse x v)
};
\definition cancels: add (value t) (value (reverse t)) = zero :=
  trans!{Carrier} _ _ _ Composition.equation (globalZero Composed.triple witness);
\import algebra.Group[].Of[Carrier := Carrier, group := group] \as Algebra;
\definition equation: value (reverse t) = neg (value t) := Algebra.inverseUnique (value t) (value (reverse t))
  (trans!{Carrier} _ _ _ (Algebra.comm (value (reverse t)) (value t)) cancels);
