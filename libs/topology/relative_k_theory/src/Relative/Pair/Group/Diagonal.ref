\import \parent.\parent.Diagonal[p := p] \as Native;
\import Operations.IdentityIsomorphism[X := X, F := Absolute.Fiber p, bundle := Absolute.bundle p] \as Identity;
\definition witness: \parent.\parent.Global[t := Native.triple].Witness := \parent.\parent.Global[t := Native.triple].Witness {
  isomorphism := Identity.isomorphism,
  agrees := \fun (x: A)(v: Absolute.Fiber p x) => \refl(v)
};
\definition equation: value Native.triple = zero := globalZero Native.triple witness;
