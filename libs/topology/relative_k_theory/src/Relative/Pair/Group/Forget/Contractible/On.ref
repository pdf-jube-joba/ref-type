\import \parent.\parent.\parent.\parent.Normalize[t := t] \as Normalization;
\module With(normalized: Normalization.Result);
\definition equation: map (value t) = K.zero -> value t = zero := \block {
  \fun (given: map (value t) = K.zero) \then
  \takefrom normalized: Normalization.Result \by Normalization.existence \then
  \return With[normalized := normalized].equation given
};
