\import \parent.\parent.\parent.Restriction[] \as Restriction;
\import KTheory.On[X := A, baseSpace := subspace, compact := Restriction.compactSubset, hausdorff := Restriction.hausdorffSubset] \as Target;
\import Target.K0[] \as TargetK;
\import std.Set[].Quotient[A := Presentation, Equivalent := Representations.Equivalent] \as Classes;
\import algebra.GroupCompletion[].Of[M := Absolute.Classes, monoid := K.additiveMonoid] \as Completion;
\import std.Set[].Quotient[A := Completion.Difference, Equivalent := Completion.Equivalent] \as Differences;
\definition Image[y: K.Carrier]: \Prop := \exists (v: Carrier \where map v = y);
\module On(p, q: Presentation);
\definition fromDifference: \forall (a, b: Absolute.Classes) -> Restriction.map (K.difference a b) = TargetK.zero -> Image (K.difference a b) :=
  Classes.induction2 (\fun (a, b: Absolute.Classes) => Restriction.map (K.difference a b) = TargetK.zero -> Image (K.difference a b))
    (\fun (p, q: Presentation) => On[p := p, q := q].existence);
\definition represented[d: Completion.Difference]: K.difference (Completion.positive d) (Completion.negative d) = Completion.class d :=
  trans!{{K.Carrier}} _ _ _ (K.differenceClass (Completion.positive d) (Completion.negative d))
    (congr!{{Completion.Difference} {K.Carrier}} Completion.class _ _ (std.Data[].Pair[].Prop[A := Absolute.Classes, B := Absolute.Classes].eta d));
\definition preimage: \forall (y: K.Carrier) -> Restriction.map y = TargetK.zero -> Image y :=
  Differences.induction (\fun (y: K.Carrier) => Restriction.map y = TargetK.zero -> Image y)
    (\fun (d: Completion.Difference) => \idelim K.difference (Completion.positive d) (Completion.negative d) = Completion.class d
      \with y: K.Carrier => Restriction.map y = TargetK.zero -> Image y \by {
        base: fromDifference (Completion.positive d) (Completion.negative d), equality: represented d });
\definition kernel: \forall (y: K.Carrier) -> Image y -> Restriction.map y = TargetK.zero := \block {
  \fun (y: K.Carrier)(inImage: Image y) \then
  \takefrom v: \Cast[Carrier] ({ v: Carrier \where map v = y }) \by inImage \then
  \return \idelim map v = y \with z: K.Carrier => Restriction.map z = TargetK.zero \by {
    base: \parent.Kernel[].equation v, equality: \bysub(Carrier, { v: Carrier \where map v = y }, v) }
};
\definition exact[y: K.Carrier]: Logic.PropEquiv[Restriction.map y = TargetK.zero, Image y] :=
  Logic.PropEquiv[_, _] { ltr := preimage y, rtl := kernel y };
