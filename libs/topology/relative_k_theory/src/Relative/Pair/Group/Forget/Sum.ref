\import Absolute.Add[p := t.positive, q := u.positive] \as Positive;
\import Absolute.Add[p := t.negative, q := u.negative] \as Negative;
\import Absolute.Addition[] \as Addition;
\definition positive: Addition.add (Absolute.class t.positive) (Absolute.class u.positive) = Absolute.class v.positive :=
  trans!{{Absolute.Classes}} _ _ _ (Addition.onClasses t.positive u.positive) (Positive.Class.identified v.positive w.positive);
\definition negative: Addition.add (Absolute.class t.negative) (Absolute.class u.negative) = Absolute.class v.negative :=
  trans!{{Absolute.Classes}} _ _ _ (Addition.onClasses t.negative u.negative) (Negative.Class.identified v.negative w.negative);
\definition positiveK: K.add (K.include (Absolute.class t.positive)) (K.include (Absolute.class u.positive)) = K.include (Absolute.class v.positive) :=
  trans!{{K.Carrier}} _ _ _ (sym!{{K.Carrier}} _ _ (K.includeAdd (Absolute.class t.positive) (Absolute.class u.positive)))
    (congr!{{Absolute.Classes} {K.Carrier}} K.include _ _ positive);
\definition negativeK: K.add (K.include (Absolute.class t.negative)) (K.include (Absolute.class u.negative)) = K.include (Absolute.class v.negative) :=
  trans!{{K.Carrier}} _ _ _ (sym!{{K.Carrier}} _ _ (K.includeAdd (Absolute.class t.negative) (Absolute.class u.negative)))
    (congr!{{Absolute.Classes} {K.Carrier}} K.include _ _ negative);
\definition equation: K.add (symbolValue t) (symbolValue u) = symbolValue v :=
  trans!{{K.Carrier}} _ _ _ (sym!{{K.Carrier}} _ _
    (Additive.differenceAdd (K.include (Absolute.class t.positive)) (K.include (Absolute.class u.positive)) (K.include (Absolute.class t.negative)) (K.include (Absolute.class u.negative))))
    (congr!{{K.Carrier} {K.Carrier} {K.Carrier}} Additive.difference _ _ _ _ positiveK negativeK);
