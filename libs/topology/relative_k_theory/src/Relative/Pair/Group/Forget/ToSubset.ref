\import \parent.\parent.\parent.Restriction[] \as Restriction;
\import Restriction.On[p := t.positive] \as Positive;
\import Restriction.On[p := t.negative] \as Negative;
\import \parent.\parent.\parent.Restricted[p := t.positive] \as First;
\import \parent.\parent.\parent.Restricted[p := t.negative] \as Second;
\import Restriction.Target[].Compare[F := First.Fiber, G := Second.Fiber, first := First.bundle, second := Second.bundle,
  firstSame := \refl(subspace), secondSame := \refl(subspace)] \as Compare;
\import algebra.Group[].Of[Carrier := Restriction.TargetK.Carrier, group := Restriction.TargetK.group] \as TargetGroup;
\definition classEquality: Restriction.Pull.map (Absolute.class t.positive) = Restriction.Pull.map (Absolute.class t.negative) :=
  trans!{{Restriction.Target.Classes}} _ _ _ Positive.classes
    (trans!{{Restriction.Target.Classes}} _ _ _ (Compare.ofIsomorphism t.comparison) (sym!{{Restriction.Target.Classes}} _ _ Negative.classes));
\definition equation: Restriction.map (symbolValue t) = Restriction.TargetK.zero :=
  trans!{{Restriction.TargetK.Carrier}} _ _ _
    (Restriction.Pull.Ranks[].Difference[a := Absolute.class t.positive, b := Absolute.class t.negative].difference)
    (trans!{{Restriction.TargetK.Carrier}} _ _ _
      (congr!{{Restriction.Target.Classes} {Restriction.TargetK.Carrier}}
        (\fun (a: Restriction.Target.Classes) => Restriction.TargetK.difference a (Restriction.Pull.map (Absolute.class t.negative))) _ _ classEquality)
      (TargetGroup.inverseRight (Restriction.TargetK.include (Restriction.Pull.map (Absolute.class t.negative)))));
\definition onGenerator: Restriction.map (map (value t)) = Restriction.TargetK.zero :=
  trans!{{Restriction.TargetK.Carrier}} _ _ _ (congr!{{K.Carrier} {Restriction.TargetK.Carrier}} Restriction.map _ _ (onTriple t)) equation;
