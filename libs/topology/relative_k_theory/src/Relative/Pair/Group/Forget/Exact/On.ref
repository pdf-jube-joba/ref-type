\import \parent.\parent.\parent.\parent.FromKernel[p := p, q := q] \as Construction;
\definition existence: Restriction.map (K.difference (Absolute.class p) (Absolute.class q)) = TargetK.zero -> Image (K.difference (Absolute.class p) (Absolute.class q)) := \block {
  \fun (zero: Restriction.map (K.difference (Absolute.class p) (Absolute.class q)) = TargetK.zero) \then
  \takefrom result: Construction.Result \by Construction.existence zero \then
  \return Logic.existsIntro[Carrier, { v: Carrier \where map v = K.difference (Absolute.class p) (Absolute.class q) }] (value result.value)
    (trans!{{K.Carrier}} _ _ _ (onTriple result.value) result.equation)
};
