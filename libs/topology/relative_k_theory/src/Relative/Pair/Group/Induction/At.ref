\definition scalarMap: Action.IntegerMap := \into[I.Int^ -> Carrier]((\fun (a: I.Int^) => Presented.scale a x), Action.IntegerMap) \by {
  Scalars.MonoidLaws[Action.integerDomain, Action.target, (\fun (a: I.Int^) => Presented.scale a x)] {
    unit := Laws.zeroScale x,
    operation := \fun (a, b: I.Int^) => Presented.scalarAdd a b x
  }
};
\definition equality: scalarMap = Action.integerMap x := Action.generatorExt scalarMap (Action.integerMap x)
  (trans!{Carrier} _ _ _ (Presented.scalarOne x) (sym!{Carrier} _ _ (Action.scalarOne x)));
\definition equation: \forall (a: I.Int^) -> Presented.scale a x = Action.action a x :=
  \fun (a: I.Int^) => congr!{{I.Int^ -> Carrier} Carrier} (\fun (f: I.Int^ -> Carrier) => f a) _ _ equality;
