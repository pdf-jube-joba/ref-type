\import Bundles.Isomorphisms[X := X, F := Absolute.Fiber t.positive, G := Absolute.Fiber u.positive, source := Absolute.bundle t.positive, target := Absolute.bundle u.positive] \as Positive;
\import Bundles.Isomorphisms[X := X, F := Absolute.Fiber t.negative, G := Absolute.Fiber u.negative, source := Absolute.bundle t.negative, target := Absolute.bundle u.negative] \as Negative;
\structure Witness: \Set := {
  positive: Positive.Isomorphism,
  negative: Negative.Isomorphism,
  commutes: \forall (x: A)(v: Absolute.Fiber t.positive x) ->
    (u.comparison.forward.fiber x).apply ((positive.forward.fiber x).apply v) = (negative.forward.fiber x).apply ((t.comparison.forward.fiber x).apply v)
};
\import \parent.\parent.Restricted[p := t.positive] \as TP;
\import \parent.\parent.Restricted[p := u.positive] \as UP;
\import \parent.\parent.Restricted[p := t.negative] \as TN;
\import \parent.\parent.Restricted[p := u.negative] \as UN;
\import Bundles.Isomorphisms[X := A, F := TP.Fiber, G := UP.Fiber, source := TP.bundle, target := UP.bundle] \as PositiveBoundary;
\import Bundles.Isomorphisms[X := A, F := TN.Fiber, G := UN.Fiber, source := TN.bundle, target := UN.bundle] \as NegativeBoundary;
\module With(w: Witness);
