\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := A] \as Cylinder;
\import Bundles.Family[X := A, F := \parent.Restricted[p := p].Fiber].Of[bundle := \parent.Restricted[p := p].bundle].Pullback[
  Y := Cylinder.Carrier, source := Cylinder.topology subspace, f := Cylinder.point] \as Positive;
\import Bundles.Family[X := A, F := \parent.Restricted[p := q].Fiber].Of[bundle := \parent.Restricted[p := q].bundle].Pullback[
  Y := Cylinder.Carrier, source := Cylinder.topology subspace, f := Cylinder.point] \as Negative;
\import Bundles.Isomorphisms[X := Cylinder.Carrier,
  F := (\fun (z: Cylinder.Carrier) => Absolute.Fiber p (Cylinder.point z)),
  G := (\fun (z: Cylinder.Carrier) => Absolute.Fiber q (Cylinder.point z)),
  source := Positive.pulled (Cylinder.pointContinuous subspace), target := Negative.pulled (Cylinder.pointContinuous subspace)] \as Maps;
\structure Family: \Set := {
  isomorphism: Maps.Isomorphism,
  start: \forall (x: A)(v: Absolute.Fiber p x) -> (isomorphism.forward.fiber (Cylinder.at I.start x)).apply v = (first.forward.fiber x).apply v,
  end: \forall (x: A)(v: Absolute.Fiber p x) -> (isomorphism.forward.fiber (Cylinder.at I.end x)).apply v = (second.forward.fiber x).apply v
};
\definition left: Triple := Triple { positive := p, negative := q, comparison := first };
\definition right: Triple := Triple { positive := p, negative := q, comparison := second };
