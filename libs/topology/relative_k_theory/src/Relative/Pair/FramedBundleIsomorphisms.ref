\import \parent.BundleModel[F := F] \as SourceModel;
\import \parent.BundleModel[F := G] \as TargetModel;
\definition sourceBundle: Bundles.Family[X := X, F := F].Bundle := SourceModel.bundle sourceModel;
\definition targetBundle: Bundles.Family[X := X, F := G].Bundle := TargetModel.bundle targetModel;
\import \root.Relative[].Descent[X := X, F := F, bundle := sourceBundle, compact := compact, hausdorff := hausdorff, subset := subset, closed := closed, dimension := n] \as FirstDescent;
\import \root.Relative[].Descent[X := X, F := G, bundle := targetBundle, compact := compact, hausdorff := hausdorff, subset := subset, closed := closed, dimension := m] \as SecondDescent;
\import \parent.Quotient[] \as Quotient;
\import \parent.FramedBundles[F := F, G := G, sourceModel := sourceModel, targetModel := targetModel, n := n, m := m] \as Forward;
\import \parent.FramedBundles[F := G, G := F, sourceModel := targetModel, targetModel := sourceModel, n := m, m := n] \as Backward;
\import Bundles.Isomorphisms[X := X, F := F, G := G, source := sourceBundle, target := targetBundle] \as Global;
\import Spaces.Isomorphism[V := Bundles.Vector n, W := Bundles.Vector m, source := Bundles.coordinates n, target := Bundles.coordinates m] \as Coordinates;
\module With(alpha: FirstDescent.OnSubset, beta: SecondDescent.OnSubset, h: Global.Isomorphism, c: Coordinates.Isomorphism,
  compatible: Forward.Compatible alpha beta h.forward c.forward);
