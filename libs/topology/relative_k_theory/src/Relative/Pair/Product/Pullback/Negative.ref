\import \parent.\parent.Negative[firstDegree := firstDegree, secondDegree := secondDegree] \as TargetProduct;
\import Domain.Negative[firstDegree := firstDegree, secondDegree := secondDegree] \as SourceProduct;
\definition degree: N.Nat^ := TargetProduct.degree;
\import Smash.Graded[firstDegree := firstDegree, secondDegree := secondDegree] \as TargetSmashProduct;
\import \root.Relative[].Negative[original := Left.model, degree := firstDegree] \as First;
\import \root.Relative[].Negative[original := Right.model, degree := secondDegree] \as Second;
\import \root.Relative[].Negative[original := Domain.model, degree := degree] \as Result;
\import \root.Relative[].NegativeMap[source := Domain.model, target := model, f := map, degree := degree] \as Pull;
\import \root.Relative[].NegativeMap[source := SourceLeftQ.model, target := Left.model, f := LeftMap.quotientMap, degree := firstDegree] \as FirstPull;
\import \root.Relative[].NegativeMap[source := SourceRightQ.model, target := Right.model, f := RightMap.quotientMap, degree := secondDegree] \as SecondPull;
\import \root.Relative[].Equivalence[source := Domain.model, target := SourceSmash.result].With[e := SourceComparison.equivalence].Negative[degree := degree] \as Transport;
\definition naturality: \forall (a: First.Carrier)(b: Second.Carrier) -> Pull.map (TargetProduct.product a b) = SourceProduct.product (FirstPull.map a) (SecondPull.map b) :=
  \fun (a: First.Carrier)(b: Second.Carrier) => trans!{{Result.Carrier}} _ _ _
    (Square.Negative[degree := degree].equation (TargetSmashProduct.product a b))
    (congr!{{\root.Relative[].Negative[original := SourceSmash.result, degree := degree].Carrier} {Result.Carrier}} Transport.forward _ _
      (SmashMap.GradedNaturality[firstDegree := firstDegree, secondDegree := secondDegree].naturality a b));
