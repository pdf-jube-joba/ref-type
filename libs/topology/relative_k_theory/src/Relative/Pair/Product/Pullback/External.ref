\import \parent.\parent.External[] \as TargetProduct;
\import Domain.External[] \as SourceProduct;
\import Smash.External[] \as TargetSmashProduct;
\import \root.Relative[].Pullback[source := Domain.model, target := model, f := map] \as Pull;
\import \root.Relative[].Pullback[source := SourceLeftQ.model, target := Left.model, f := LeftMap.quotientMap] \as FirstPull;
\import \root.Relative[].Pullback[source := SourceRightQ.model, target := Right.model, f := RightMap.quotientMap] \as SecondPull;
\import \root.Relative[].Equivalence[source := Domain.model, target := SourceSmash.result].With[e := SourceComparison.equivalence].Groups[] \as Transport;
\definition naturality: \forall (a: Left.Relative)(b: Right.Relative) -> Pull.map (TargetProduct.product a b) = SourceProduct.product (FirstPull.map a) (SecondPull.map b) :=
  \fun (a: Left.Relative)(b: Right.Relative) => trans!{{Domain.Relative}} _ _ _
    (Square.Negative[degree := N.Nat^::zero].equation (TargetSmashProduct.product a b))
    (congr!{{\root.Relative[].Reduced[model := SourceSmash.result].Carrier} {Domain.Relative}} Transport.forward _ _ (SmashMap.External[].naturality a b));
