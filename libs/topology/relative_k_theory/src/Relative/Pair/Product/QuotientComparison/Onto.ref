\definition representative[q: Smash.result.Carrier][outside: Logic.Not (q = Target.point)]:
  \exists (p: Quotient.Carrier \where forward p = q) := \block {
  \takefrom z: \Cast[Smash.model.Carrier] ({ z: Smash.model.Carrier \where Target.projection z = q }) \by Target.representative q outside \then
  \let firstOutside: Logic.Not (Pair.first Left.Carrier Right.Carrier z = Left.point) :=
    \fun (same: Pair.first Left.Carrier Right.Carrier z = Left.point) => outside
      (trans!{{Smash.result.Carrier}} _ _ _ (sym!{{Smash.result.Carrier}} _ _ (\bysub(Smash.model.Carrier, { z: Smash.model.Carrier \where Target.projection z = q }, z)))
        (Target.onSubset (\into[Smash.model.Carrier](z, Smash.wedge) \by { Logic.Or[_, _]::left same }))) \then
  \let secondOutside: Logic.Not (Pair.second Left.Carrier Right.Carrier z = Right.point) :=
    \fun (same: Pair.second Left.Carrier Right.Carrier z = Right.point) => outside
      (trans!{{Smash.result.Carrier}} _ _ _ (sym!{{Smash.result.Carrier}} _ _ (\bysub(Smash.model.Carrier, { z: Smash.model.Carrier \where Target.projection z = q }, z)))
        (Target.onSubset (\into[Smash.model.Carrier](z, Smash.wedge) \by { Logic.Or[_, _]::right same }))) \then
  \takefrom x: \Cast[X] ({ x: X \where Left.projection x = Pair.first Left.Carrier Right.Carrier z }) \by Left.representative _ firstOutside \then
  \takefrom y: \Cast[Y] ({ y: Y \where Right.projection y = Pair.second Left.Carrier Right.Carrier z }) \by Right.representative _ secondOutside \then
  \let p: Z := Pair.pair X Y x y \then
  \let images: image p = z := Pair.Prop[A := Left.Carrier, B := Right.Carrier].ext _ _
    (\bysub(X, { x: X \where Left.projection x = Pair.first Left.Carrier Right.Carrier z }, x))
    (\bysub(Y, { y: Y \where Right.projection y = Pair.second Left.Carrier Right.Carrier z }, y)) \then
  \return Logic.existsIntro[Quotient.Carrier, { p: Quotient.Carrier \where forward p = q }] (Quotient.projection p)
    (trans!{{Smash.result.Carrier}} _ _ _ (onProjection p)
      (trans!{{Smash.result.Carrier}} _ _ _ (congr!{{Smash.model.Carrier} {Smash.result.Carrier}} Target.projection _ _ images)
        (\bysub(Smash.model.Carrier, { z: Smash.model.Carrier \where Target.projection z = q }, z))))
};
\definition result: \forall (q: Smash.result.Carrier) -> \exists (p: Quotient.Carrier \where forward p = q) :=
  \fun (q: Smash.result.Carrier) => either!{{(std.Logic[].Classical[].excludedMiddle (q = Target.point))}
    {\exists (p: Quotient.Carrier \where forward p = q)}
    | inside: \fun (same: q = Target.point) => Logic.existsIntro[Quotient.Carrier, { p: Quotient.Carrier \where forward p = q }] Quotient.point
      (trans!{{Smash.result.Carrier}} _ _ _ onPoint (sym!{{Smash.result.Carrier}} _ _ same))
    | outside: representative q
  };
