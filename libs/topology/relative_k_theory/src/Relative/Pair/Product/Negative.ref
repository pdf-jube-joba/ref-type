\import \parent.QuotientComparison[] \as Comparison;
\import Smash.Graded[firstDegree := firstDegree, secondDegree := secondDegree] \as Native;
\definition degree: N.Nat^ := Native.degree;
\import \root.Relative[].Equivalence[source := model, target := Smash.result].With[e := Comparison.equivalence].Negative[degree := degree] \as Transport;
\import \root.Relative[].Negative[original := Left.model, degree := firstDegree] \as First;
\import \root.Relative[].Negative[original := Right.model, degree := secondDegree] \as Second;
\import \root.Relative[].Negative[original := model, degree := degree] \as Result;
\definition product[a: First.Carrier][b: Second.Carrier]: Result.Carrier := Transport.forward (Native.product a b);
\definition additiveLeft: \forall (a, c: First.Carrier)(b: Second.Carrier) -> product (First.group.base.op a c) b = Result.group.base.op (product a b) (product c b) :=
  \fun (a, c: First.Carrier)(b: Second.Carrier) => trans!{{Result.Carrier}} _ _ _
    (congr!{{\root.Relative[].Negative[original := Smash.result, degree := degree].Carrier} {Result.Carrier}} Transport.forward _ _ (Native.additiveLeft a c b))
    (Transport.additive (Native.product a b) (Native.product c b));
\definition additiveRight: \forall (a: First.Carrier)(b, c: Second.Carrier) -> product a (Second.group.base.op b c) = Result.group.base.op (product a b) (product a c) :=
  \fun (a: First.Carrier)(b, c: Second.Carrier) => trans!{{Result.Carrier}} _ _ _
    (congr!{{\root.Relative[].Negative[original := Smash.result, degree := degree].Carrier} {Result.Carrier}} Transport.forward _ _ (Native.additiveRight a b c))
    (Transport.additive (Native.product a b) (Native.product a c));
\definition zeroLeft: \forall (b: Second.Carrier) -> product First.group.base.unit b = Result.group.base.unit :=
  \fun (b: Second.Carrier) => trans!{{Result.Carrier}} _ _ _
    (congr!{{\root.Relative[].Negative[original := Smash.result, degree := degree].Carrier} {Result.Carrier}} Transport.forward _ _ (Native.zeroLeft b)) Transport.forwardZero;
\definition zeroRight: \forall (a: First.Carrier) -> product a Second.group.base.unit = Result.group.base.unit :=
  \fun (a: First.Carrier) => trans!{{Result.Carrier}} _ _ _
    (congr!{{\root.Relative[].Negative[original := Smash.result, degree := degree].Carrier} {Result.Carrier}} Transport.forward _ _ (Native.zeroRight a)) Transport.forwardZero;
