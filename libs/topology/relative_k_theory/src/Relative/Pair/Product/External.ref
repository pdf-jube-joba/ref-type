\import \parent.QuotientComparison[] \as Comparison;
\import Smash.External[] \as Native;
\import \root.Relative[].Equivalence[source := model, target := Smash.result].With[e := Comparison.equivalence].Groups[] \as Transport;
\definition product[a: Left.Relative][b: Right.Relative]: Relative := Transport.forward (Native.product a b);
\definition additiveLeft: \forall (a, c: Left.Relative)(b: Right.Relative) -> product (Left.group.base.op a c) b = group.base.op (product a b) (product c b) :=
  \fun (a, c: Left.Relative)(b: Right.Relative) => trans!{Relative} _ _ _
    (congr!{{\root.Relative[].Reduced[model := Smash.result].Carrier} Relative} Transport.forward _ _ (Native.additiveLeft a c b))
    (Transport.forwardAdd (Native.product a b) (Native.product c b));
\definition additiveRight: \forall (a: Left.Relative)(b, c: Right.Relative) -> product a (Right.group.base.op b c) = group.base.op (product a b) (product a c) :=
  \fun (a: Left.Relative)(b, c: Right.Relative) => trans!{Relative} _ _ _
    (congr!{{\root.Relative[].Reduced[model := Smash.result].Carrier} Relative} Transport.forward _ _ (Native.additiveRight a b c))
    (Transport.forwardAdd (Native.product a b) (Native.product a c));
\definition zeroLeft: \forall (b: Right.Relative) -> product Left.group.base.unit b = group.base.unit :=
  \fun (b: Right.Relative) => trans!{Relative} _ _ _
    (congr!{{\root.Relative[].Reduced[model := Smash.result].Carrier} Relative} Transport.forward _ _ (Native.zeroLeft b)) Transport.forwardZero;
\definition zeroRight: \forall (a: Left.Relative) -> product a Right.group.base.unit = group.base.unit :=
  \fun (a: Left.Relative) => trans!{Relative} _ _ _
    (congr!{{\root.Relative[].Reduced[model := Smash.result].Carrier} Relative} Transport.forward _ _ (Native.zeroRight a)) Transport.forwardZero;
