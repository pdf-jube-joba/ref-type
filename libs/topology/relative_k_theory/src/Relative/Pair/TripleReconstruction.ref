\import \parent.TripleClass[t := t] \as Class;
\import \parent.Normalize[t := t] \as Normalization;
\import \parent.Diagonal[p := Class.complement] \as Added;
\import \parent.SumConstruction[t := t, u := Added.triple] \as Sums;
\import \parent.FromReduced[] \as Reverse;
\import \parent.Group[] \as RelativeGroup;
\import \parent.Quotient[] \as Quotient;
\import Complements.Projection[X := X, n := t.negative.dimension, baseSpace := space, P := t.negative.projection, regular := t.negative.regular].Complement[] \as Split;
\import Spaces.Isomorphism[V := Bundles.Vector t.negative.dimension, W := Bundles.Vector t.negative.dimension,
  source := Bundles.coordinates t.negative.dimension, target := Bundles.coordinates t.negative.dimension] \as Coordinates;
\definition coordinateIdentity: Coordinates.Isomorphism := Coordinates.Isomorphism {
  forward := Spaces.FiniteCoordinates[n := t.negative.dimension].identity, backward := Spaces.FiniteCoordinates[n := t.negative.dimension].identity,
  leftInverse := \fun (v: Bundles.Vector t.negative.dimension) => \refl(v), rightInverse := \fun (v: Bundles.Vector t.negative.dimension) => \refl(v)
};
\module With(result: Sums.Result);
\definition equation: Reverse.reduced Class.value = RelativeGroup.value t := \block {
  \takefrom result: Sums.Result \by Sums.existence \then
  \return With[result := result].equation
};
