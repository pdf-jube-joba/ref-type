\import \parent.BundleTriples[F := F, G := G, firstModel := firstModel, secondModel := secondModel] \as First;
\import \parent.BundleTriples[F := H, G := I, firstModel := thirdModel, secondModel := fourthModel] \as Second;
\import \parent.BundleTriples[F := J, G := L, firstModel := fifthModel, secondModel := sixthModel] \as Third;
\import Operations.DirectSum[X := X, F := F, G := H, left := First.first, right := Second.first] \as Positive;
\import Operations.DirectSum[X := X, F := G, G := I, left := First.second, right := Second.second] \as Negative;
\import Bundles.Isomorphisms[X := X, F := Positive.Fiber, G := J, source := Positive.bundle (\refl(space)), target := Third.first] \as PositiveMaps;
\import Bundles.Isomorphisms[X := X, F := Negative.Fiber, G := L, source := Negative.bundle (\refl(space)), target := Third.second] \as NegativeMaps;
\import std.Data[].Pair[] \as Product;
\structure Witness[alpha: First.OnSubset][beta: Second.OnSubset][gamma: Third.OnSubset]: \Set := {
  positive: PositiveMaps.Isomorphism,
  negative: NegativeMaps.Isomorphism,
  agrees: \forall (x: A)(a: F x)(b: H x) ->
    (gamma.forward.fiber x).apply ((positive.forward.fiber x).apply (Product.pair (F x) (H x) a b)) =
    (negative.forward.fiber x).apply (Product.pair (G x) (I x) ((alpha.forward.fiber x).apply a) ((beta.forward.fiber x).apply b))
};
\module With(alpha: First.OnSubset, beta: Second.OnSubset, gamma: Third.OnSubset, witness: Witness[alpha,beta,gamma]);
