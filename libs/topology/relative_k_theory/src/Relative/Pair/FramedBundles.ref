\import \parent.BundleModel[F := F] \as SourceModel;
\import \parent.BundleModel[F := G] \as TargetModel;
\definition sourceBundle: Bundles.Family[X := X, F := F].Bundle := SourceModel.bundle sourceModel;
\definition targetBundle: Bundles.Family[X := X, F := G].Bundle := TargetModel.bundle targetModel;
\import \root.Relative[].Descent[X := X, F := F, bundle := sourceBundle, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed, dimension := n] \as First;
\import \root.Relative[].Descent[X := X, F := G, bundle := targetBundle, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed, dimension := m] \as Second;
\import Bundles.Morphisms[X := X, Y := X, F := F, G := G, source := sourceBundle, target := targetBundle,
  f := (\fun (x: X) => x)] \as Global;
\import Spaces.Linear[V := Bundles.Vector n, W := Bundles.Vector m, source := Bundles.coordinates n, target := Bundles.coordinates m] \as Coordinates;
\definition Compatible[alpha: First.OnSubset, beta: Second.OnSubset, h: Global.Map, c: Coordinates.Map]: \Prop :=
  \forall (x: A)(v: F x) -> (beta.forward.fiber x).apply ((h.fiber x).apply v) = c.apply ((alpha.forward.fiber x).apply v);
\module With(alpha: First.OnSubset, beta: Second.OnSubset, h: Global.Map, c: Coordinates.Map, compatible: Compatible alpha beta h c);
