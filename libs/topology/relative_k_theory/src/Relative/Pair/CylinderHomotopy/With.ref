\definition isomorphism: Isomorphisms.Isomorphism := Finish.compose (Start.compose firstBridge (Pull.isomorphism family.isomorphism)) (TargetReverse.inverse secondBridge);
\definition formula: \forall (z: Boundary.Carrier)(v: Source.Fiber z) ->
  (isomorphism.forward.fiber z).apply v = (family.isomorphism.forward.fiber (Boundary.inverse z)).apply v :=
  \fun (z: Boundary.Carrier)(v: Source.Fiber z) => \refl((family.isomorphism.forward.fiber (Boundary.inverse z)).apply v);
\definition start: \forall (z: Boundary.Carrier) -> Boundary.time z = Interval.start -> \forall (v: Source.Fiber z) ->
  (isomorphism.forward.fiber z).apply v = (first.forward.fiber (Boundary.boundary z)).apply v :=
  \fun (z: Boundary.Carrier)(same: Boundary.time z = Interval.start) =>
    \idelim Interval.start = Boundary.time z \with t: Interval.Carrier => \forall (v: Source.Fiber z) ->
      (family.isomorphism.forward.fiber (OriginalCylinder.at t (Boundary.boundary z))).apply v = (first.forward.fiber (Boundary.boundary z)).apply v \by {
        base: family.start (Boundary.boundary z), equality: sym!{Interval.Carrier} (Boundary.time z) Interval.start same
      };
\definition endpoint[x: A]: Boundary.Carrier := \into[algebraic_topology.Cylinder[A := X].Carrier](algebraic_topology.Cylinder[A := X].at Interval.end x, Boundary.subsetCylinder) \by { \bysub(X, subset, x) };
\definition end: \forall (x: A)(v: Absolute.Fiber p x) -> (isomorphism.forward.fiber (endpoint x)).apply v = (second.forward.fiber x).apply v := family.end;
