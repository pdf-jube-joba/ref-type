\import \parent.Quotient[] \as Quotient;
\import topology.Topology[Carrier := Quotient.Carrier] \as QuotientBase;
\import Bundles.Family[X := Quotient.Carrier, F := F] \as Original;
\import Original.With[data := bundle] \as OriginalCharts;
\definition regular: topology.Continuity[A := X, B := Quotient.Carrier].Continuous space bundle.baseSpace Quotient.projection :=
  \idelim Quotient.topology = bundle.baseSpace \with t: QuotientBase.Topology => topology.Continuity[A := X, B := Quotient.Carrier].Continuous space t Quotient.projection \by {
    base: Quotient.continuous, equality: sym!{{QuotientBase.Topology}} _ _ same };
\import Original.Of[bundle := bundle].Pullback[Y := X, source := space, f := Quotient.projection] \as Pull;
\definition Fiber[x: X]: \Set := F (Quotient.projection x);
\definition pulled: Bundles.Family[X := X, F := Fiber].Bundle := Pull.pulled regular;
\module In(c: OriginalCharts.Chart, contains: QuotientBase.Member c.domain Quotient.point);
\structure Witness: \Set := {
  chart: OriginalCharts.Chart,
  contains: QuotientBase.Member chart.domain Quotient.point,
  result: In[c := chart, contains := contains].Result
};
\definition existence: \exists Witness := \block {
  \takefrom c: \Cast[OriginalCharts.Chart] ({ c: OriginalCharts.Chart \where QuotientBase.Member c.domain Quotient.point }) \by Original.Of[bundle := bundle].locallyTrivial Quotient.point \then
  \let contains: QuotientBase.Member c.domain Quotient.point := \bysub(OriginalCharts.Chart, { c: OriginalCharts.Chart \where QuotientBase.Member c.domain Quotient.point }, c) \then
  \takefrom result: In[c := c, contains := contains].Result \by In[c := c, contains := contains].existence \then
  \return \exact(Witness { chart := c, contains := contains, result := result }, Witness)
};
