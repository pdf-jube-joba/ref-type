\import FirstFraming.With[trivialization := h] \as FirstData;
\import SecondFraming.With[trivialization := k] \as SecondData;
\import \parent.\parent.FramedClass[F := FirstFraming.SourceFiber, sourceModel := FirstFraming.sourceModel, n := n].With[alpha := FirstData.comparison] \as FirstClass;
\import \parent.\parent.FramedClass[F := SecondFraming.SourceFiber, sourceModel := SecondFraming.sourceModel, n := m].With[alpha := SecondData.comparison] \as SecondClass;
\import FirstClass.Stabilized[k := m] \as Source;
\import SecondClass.Stabilized[k := n] \as Target;
\import \parent.\parent.FramedClass[F := FirstFraming.SourceFiber, sourceModel := FirstFraming.sourceModel, n := n].To[
  G := SecondFraming.SourceFiber, targetModel := SecondFraming.sourceModel, m := m].Stable[alpha := FirstData.comparison, beta := SecondData.comparison].At[k := m, l := n] \as Stable;
\import Operations.DirectSumIsomorphisms[X := X, F := FirstFraming.SourceFiber, G := (\fun (x: X) => Bundles.Vector m), A := FirstFraming.SourceFiber, B := SecondFraming.NegativeFiber,
  first := FirstFraming.positiveBundle, second := SecondTrivial.bundle, newFirst := FirstFraming.positiveBundle, newSecond := SecondFraming.negativeBundle,
  sameSource := (\refl(space)), sameTarget := (\refl(space))] \as OpenTrivial;
\definition openTrivial: Bundles.Isomorphisms[X := X, F := OpenTrivial.SourceFiber, G := OpenTrivial.TargetFiber, source := OpenTrivial.sourceBundle, target := OpenTrivial.targetBundle].Isomorphism :=
  OpenTrivial.isomorphism IdentityES.isomorphism (SecondIsomorphisms.inverse k);
\import Operations.DirectSumIsomorphisms[X := X, F := EF.Fiber, G := ST.Fiber, A := EF.Fiber, B := ST.Fiber,
  first := efBundle, second := stBundle, newFirst := efBundle, newSecond := stBundle, sameSource := (\refl(space)), sameTarget := (\refl(space))] \as Exchange;
\import Operations.DirectSumIsomorphisms[X := X, F := EF.Fiber, G := ST.Fiber, A := EF.Fiber, B := TS.Fiber,
  first := efBundle, second := stBundle, newFirst := efBundle, newSecond := tsBundle, sameSource := (\refl(space)), sameTarget := (\refl(space))] \as SideOrder;
\definition sideOrder: Bundles.Isomorphisms[X := X, F := SideOrder.SourceFiber, G := SideOrder.TargetFiber, source := SideOrder.sourceBundle, target := SideOrder.targetBundle].Isomorphism :=
  SideOrder.isomorphism IdentityEF.isomorphism SideSymmetry.isomorphism;
\import Operations.DirectSumIsomorphisms[X := X, F := SecondFraming.SourceFiber, G := FirstFraming.NegativeFiber, A := SecondFraming.SourceFiber, B := (\fun (x: X) => Bundles.Vector n),
  first := SecondFraming.positiveBundle, second := FirstFraming.negativeBundle, newFirst := SecondFraming.positiveBundle, newSecond := FirstTrivial.bundle,
  sameSource := (\refl(space)), sameTarget := (\refl(space))] \as CloseTrivial;
\definition closeTrivial: Bundles.Isomorphisms[X := X, F := CloseTrivial.SourceFiber, G := CloseTrivial.TargetFiber, source := CloseTrivial.sourceBundle, target := CloseTrivial.targetBundle].Isomorphism :=
  CloseTrivial.isomorphism IdentityET.isomorphism h;
\definition secondLaws: SecondIsomorphisms.Laws[k] := \bysub(SecondIsomorphisms.Data, SecondIsomorphisms.Isomorphism, k);
\module Using(w: Switch.Result);
\definition equation: FirstData.value = SecondData.value := \block {
  \takefrom w: Switch.Result \by Switch.existence \then
  \return Using[w := w].equation
};
