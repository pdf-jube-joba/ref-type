\definition exchange: Bundles.Isomorphisms[X := X, F := Exchange.SourceFiber, G := Exchange.TargetFiber, source := Exchange.sourceBundle, target := Exchange.targetBundle].Isomorphism :=
  Exchange.isomorphism w.exchange IdentityST.isomorphism;
\import Operations.IsomorphismComposition[X := X, F := Source.Fiber, G := OpenTrivial.TargetFiber, H := StartOrder.TargetFiber, source := Source.bundle, middle := OpenTrivial.targetBundle, target := StartOrder.targetBundle] \as StartStep;
\definition start: StartStep.Isomorphism := StartStep.compose openTrivial StartOrder.isomorphism;
\import Operations.IsomorphismComposition[X := X, F := Source.Fiber, G := StartOrder.TargetFiber, H := Exchange.TargetFiber, source := Source.bundle, middle := StartOrder.targetBundle, target := Exchange.targetBundle] \as SwitchStep;
\definition switched: SwitchStep.Isomorphism := SwitchStep.compose start exchange;
\import Operations.IsomorphismComposition[X := X, F := Source.Fiber, G := Exchange.TargetFiber, H := SideOrder.TargetFiber, source := Source.bundle, middle := Exchange.targetBundle, target := SideOrder.targetBundle] \as SideStep;
\definition side: SideStep.Isomorphism := SideStep.compose switched sideOrder;
\import Operations.IsomorphismComposition[X := X, F := Source.Fiber, G := SideOrder.TargetFiber, H := FinishOrder.TargetFiber, source := Source.bundle, middle := SideOrder.targetBundle, target := FinishOrder.targetBundle] \as FinishStep;
\definition finished: FinishStep.Isomorphism := FinishStep.compose side FinishOrder.isomorphism;
\import Operations.IsomorphismComposition[X := X, F := Source.Fiber, G := FinishOrder.TargetFiber, H := Target.Fiber, source := Source.bundle, middle := FinishOrder.targetBundle, target := Target.bundle] \as CloseStep;
\definition isomorphism: CloseStep.Isomorphism := CloseStep.compose finished closeTrivial;
\module At(x: A, v: Source.Fiber x);
\definition witness: Stable.Witness := Stable.Witness {
  isomorphism := isomorphism, coordinates := CoordinateSwitch.swap,
  compatible := \fun (x: A)(v: Source.Fiber x) => At[x := x, v := v].equation
};
\definition equation: FirstData.value = SecondData.value := Stable.With[w := witness].equation;
