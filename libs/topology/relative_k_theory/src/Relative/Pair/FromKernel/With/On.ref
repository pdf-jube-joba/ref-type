\import Operations.IsomorphismComposition[X := A, F := (\fun (x: A) => GlobalPositive.Fiber x), G := StablePositive.Fiber, H := StableNegative.Fiber,
  source := Represent.restrictedSource, middle := stablePositiveBundle, target := stableNegativeBundle] \as First;
\definition start: First.Isomorphism := First.compose positiveComparison alpha;
\import Bundles.Isomorphisms[X := A, F := (\fun (x: A) => GlobalNegative.Fiber x), G := StableNegative.Fiber, source := Represent.restrictedTarget, target := stableNegativeBundle] \as NegativeIsomorphisms;
\import Operations.IsomorphismComposition[X := A, F := (\fun (x: A) => GlobalPositive.Fiber x), G := StableNegative.Fiber, H := (\fun (x: A) => GlobalNegative.Fiber x),
  source := Represent.restrictedSource, middle := stableNegativeBundle, target := Represent.restrictedTarget] \as Second;
\definition comparison: Represent.OnSubset := Second.compose start (NegativeIsomorphisms.inverse negativeComparison);
\definition existence: \exists Result := \block {
  \takefrom result: Represent.Result[comparison] \by Represent.existence comparison \then
  \return \exact(Result {
    value := result.value,
    equation := trans!{{K.Carrier}} _ _ _
      (congr!{{Absolute.Classes} {Absolute.Classes} {K.Carrier}} K.difference _ _ _ _
        (sym!{{Absolute.Classes}} _ _ (Represent.positiveClass comparison result)) (sym!{{Absolute.Classes}} _ _ (Represent.negativeClass comparison result))) stabilized
  }, Result)
};
