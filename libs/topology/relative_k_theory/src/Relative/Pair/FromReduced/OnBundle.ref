\import K.Bundle[F := F, original := bundle, same := same] \as OriginalClass;
\import \parent.\parent.QuotientClass[F := F, bundle := bundle, same := same] \as RelativeClass;
\definition equation: classes OriginalClass.value = RelativeClass.value := \block {
  \takefrom p: OriginalClass.Representative \by OriginalClass.representativeExists \then
  \return trans!{{RelativeGroup.Carrier}} _ _ _ (congr!{{K.Classes} {RelativeGroup.Carrier}} classes _ _ (OriginalClass.identified p.presentation p.isomorphism))
    (trans!{{RelativeGroup.Carrier}} _ _ _ (onClasses p.presentation)
      (sym!{{RelativeGroup.Carrier}} _ _ (RelativeClass.Isomorphic[G := (K.Fiber p.presentation), target := (K.bundle p.presentation), targetSame := (\refl(Quotient.topology)), h := p.isomorphism].equation)))
};
