\import Operations.DirectSum[X := Quotient.Carrier, F := (K.Fiber p), G := (K.Fiber q), left := (K.bundle p), right := (K.bundle q)] \as Sum;
\definition sumBundle: Bundles.Family[X := Quotient.Carrier, F := Sum.Fiber].Bundle := Sum.bundle (\refl(Quotient.topology));
\import \parent.OnBundle[F := Sum.Fiber, bundle := sumBundle, same := (\refl(Quotient.topology))] \as SumClass;
\import \parent.\parent.QuotientAdditivity[F := (K.Fiber p), G := (K.Fiber q), source := (K.bundle p), target := (K.bundle q),
  sourceSame := (\refl(Quotient.topology)), targetSame := (\refl(Quotient.topology))] \as Additivity;
\definition equation: classes (ClassesMonoid.add (K.class p) (K.class q)) = RelativeGroup.add (classes (K.class p)) (classes (K.class q)) :=
  trans!{{RelativeGroup.Carrier}} _ _ _ (congr!{{K.Classes} {RelativeGroup.Carrier}} classes _ _ (ClassesMonoid.onClasses p q))
    (trans!{{RelativeGroup.Carrier}} _ _ _ SumClass.equation
      (trans!{{RelativeGroup.Carrier}} _ _ _ (sym!{{RelativeGroup.Carrier}} _ _ Additivity.equation)
        (congr!{{RelativeGroup.Carrier} {RelativeGroup.Carrier} {RelativeGroup.Carrier}} RelativeGroup.add _ _ _ _
          (sym!{{RelativeGroup.Carrier}} _ _ (onClasses p)) (sym!{{RelativeGroup.Carrier}} _ _ (onClasses q)))));
