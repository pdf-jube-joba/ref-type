\import Bundles.Trivial[X := Quotient.Carrier, n := n, baseSpace := Quotient.topology] \as Bundle;
\import \parent.OnBundle[F := (\fun (q: Quotient.Carrier) => Bundles.Vector n), bundle := Bundle.bundle, same := (\refl(Quotient.topology))] \as Identification;
\import \parent.\parent.QuotientTrivial[n := n] \as Vanishing;
\definition equation: classes (K.Trivial[n := n].value) = RelativeGroup.zero := trans!{{RelativeGroup.Carrier}} _ _ _ Identification.equation Vanishing.equation;
