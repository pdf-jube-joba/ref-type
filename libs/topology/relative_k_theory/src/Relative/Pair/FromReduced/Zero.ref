\import Bundles.Trivial[X := Quotient.Carrier, n := N.Nat^::zero, baseSpace := Quotient.topology] \as Trivial;
\import \parent.OnBundle[F := (\fun (q: Quotient.Carrier) => Bundles.Vector N.Nat^::zero), bundle := Trivial.bundle, same := (\refl(Quotient.topology))] \as ZeroClass;
\import \parent.\parent.QuotientTrivial[n := N.Nat^::zero] \as Vanishing;
\definition equation: classes ClassesMonoid.zeroClass = RelativeGroup.zero := trans!{{RelativeGroup.Carrier}} _ _ _ ZeroClass.equation Vanishing.equation;
