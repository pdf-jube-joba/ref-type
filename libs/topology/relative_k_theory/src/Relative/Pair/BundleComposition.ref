\import \parent.BundleTriples[F := F, G := G, firstModel := firstModel, secondModel := secondModel] \as First;
\import \parent.BundleTriples[F := G, G := H, firstModel := secondModel, secondModel := thirdModel] \as Second;
\import \parent.BundleTriples[F := F, G := H, firstModel := firstModel, secondModel := thirdModel] \as Third;
\import Bundles.Family[X := X, F := F].Of[bundle := First.first].Restriction[U := subset] \as Source;
\import Bundles.Family[X := X, F := G].Of[bundle := First.second].Restriction[U := subset] \as Middle;
\import Bundles.Family[X := X, F := H].Of[bundle := Second.second].Restriction[U := subset] \as Target;
\import Operations.IsomorphismComposition[X := A, F := (\fun (x: A) => F x), G := (\fun (x: A) => G x), H := (\fun (x: A) => H x),
  source := Source.restricted, middle := Middle.restricted, target := Target.restricted] \as Composition;
\module With(alpha: First.OnSubset, beta: Second.OnSubset);
