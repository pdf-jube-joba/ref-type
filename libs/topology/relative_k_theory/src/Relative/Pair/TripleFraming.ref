\import \parent.Diagonal[p := auxiliary] \as Added;
\import \parent.SumConstruction[t := t, u := Added.triple] \as Sums;
\import Operations.DirectSum[X := X, F := (Absolute.Fiber t.positive), G := (Absolute.Fiber auxiliary), left := (Absolute.bundle t.positive), right := (Absolute.bundle auxiliary)] \as Positive;
\import Operations.DirectSum[X := X, F := (Absolute.Fiber t.negative), G := (Absolute.Fiber auxiliary), left := (Absolute.bundle t.negative), right := (Absolute.bundle auxiliary)] \as Negative;
\definition SourceFiber[x: X]: \Set := Positive.Fiber x;
\definition NegativeFiber[x: X]: \Set := Negative.Fiber x;
\definition positiveBundle: Bundles.Family[X := X, F := SourceFiber].Bundle := Sums.positiveBundle;
\definition negativeBundle: Bundles.Family[X := X, F := NegativeFiber].Bundle := Sums.negativeBundle;
\import \parent.BundleModel[F := SourceFiber].From[original := positiveBundle, same := (\refl(space))] \as Based;
\definition sourceModel: \parent.BundleModel[F := SourceFiber].Bundle := Based.model;
\import Bundles.Trivial[X := X, n := n, baseSpace := space] \as Trivial;
\definition inclusion[x: A]: X := x;
\definition regular: topology.Continuity[A := A, B := X].Continuous subspace space inclusion := topology.Continuity[A := A, B := X].Corestriction[S := subset].inclusionContinuous space;
\import Bundles.Family[X := X, F := SourceFiber].Of[bundle := positiveBundle].Restriction[U := subset] \as First;
\import Bundles.Family[X := X, F := NegativeFiber].Of[bundle := negativeBundle].Restriction[U := subset] \as Second;
\import Bundles.Family[X := X, F := (\fun (x: X) => Bundles.Vector n)].Of[bundle := Trivial.bundle].Restriction[U := subset] \as BoundaryTrivial;
\import Complements.PulledIsomorphism[X := X, Y := A, F := NegativeFiber, G := (\fun (x: X) => Bundles.Vector n), source := negativeBundle, target := Trivial.bundle,
  base := subspace, f := inclusion, sourceRegular := regular, targetRegular := regular] \as Triviality;
\import Operations.IsomorphismComposition[X := A, F := (\fun (x: A) => SourceFiber x), G := (\fun (x: A) => NegativeFiber x), H := (\fun (x: A) => Bundles.Vector n),
  source := First.restricted, middle := Second.restricted, target := BoundaryTrivial.restricted] \as Compose;
\import Bundles.Isomorphisms[X := X, F := NegativeFiber, G := (\fun (x: X) => Bundles.Vector n), source := negativeBundle, target := Trivial.bundle] \as Trivializations;
\definition Trivialization: \Set := Trivializations.Isomorphism;
\module With(trivialization: Trivialization);
