\import Source.At[q := q] \as FirstFiber;
\import Target.At[q := q] \as SecondFiber;
\import Whole.At[q := q] \as TotalFiber;
\definition firstComponent[v: BundlesSum.Fiber q]: FirstFiber.Carrier := Pair.first FirstFiber.Carrier SecondFiber.Carrier v;
\definition secondComponent[v: BundlesSum.Fiber q]: SecondFiber.Carrier := Pair.second FirstFiber.Carrier SecondFiber.Carrier v;
\definition firstEquality: \forall (v: BundlesSum.Fiber q) -> Pair.first FirstFiber.Carrier SecondFiber.Carrier ((backward.fiber q).apply ((forward.fiber q).apply v)) = firstComponent v :=
  \fun (v: BundlesSum.Fiber q) => FirstFiber.ext _ (firstComponent v) (firstPair (FirstFiber.anchor (firstComponent v)) (SecondFiber.anchor (secondComponent v)))
    (\fun (x: FirstFiber.Index) => Spaces.Laws[V := F x, space := source.space x].zeroRight (FirstFiber.section (firstComponent v) x));
\definition secondEquality: \forall (v: BundlesSum.Fiber q) -> Pair.second FirstFiber.Carrier SecondFiber.Carrier ((backward.fiber q).apply ((forward.fiber q).apply v)) = secondComponent v :=
  \fun (v: BundlesSum.Fiber q) => SecondFiber.ext _ (secondComponent v) (secondPair (FirstFiber.anchor (firstComponent v)) (SecondFiber.anchor (secondComponent v)))
    (\fun (x: SecondFiber.Index) => Spaces.Laws[V := G x, space := target.space x].zeroLeft (SecondFiber.section (secondComponent v) x));
\definition left: \forall (v: BundlesSum.Fiber q) -> (backward.fiber q).apply ((forward.fiber q).apply v) = v :=
  \fun (v: BundlesSum.Fiber q) => Pair.Prop[A := FirstFiber.Carrier, B := SecondFiber.Carrier].ext _ v (firstEquality v) (secondEquality v);
\definition right: \forall (v: TotalFiber.Carrier) -> (forward.fiber q).apply ((backward.fiber q).apply v) = v :=
  \fun (v: TotalFiber.Carrier) => TotalFiber.ext _ v (recover (TotalFiber.anchor v))
    (\fun (x: TotalFiber.Index) => Inclusions.decomposition x (TotalFiber.section v x));
