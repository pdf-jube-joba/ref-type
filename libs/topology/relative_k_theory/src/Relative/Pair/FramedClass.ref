\import \parent.BundleModel[F := F] \as Model;
\definition framedBundle: Bundles.Family[X := X, F := F].Bundle := Model.bundle sourceModel;
\import \root.Relative[].Descent[X := X, F := F, bundle := framedBundle, compact := compact, hausdorff := hausdorff, subset := subset, closed := closed, dimension := n] \as Descent;
\import \parent.Quotient[] \as Quotient;
\import KTheory.On[X := Quotient.Carrier, baseSpace := Quotient.topology, compact := Quotient.quotientCompact, hausdorff := Quotient.quotientHausdorff] \as K;
\import K.Trivial[n := n] \as TrivialClass;
\import \parent.FramedBundles[F := F, G := F, sourceModel := sourceModel, targetModel := sourceModel, n := n, m := n] \as Maps;
\import Spaces.Isomorphism[V := Bundles.Vector n, W := Bundles.Vector n, source := Bundles.coordinates n, target := Bundles.coordinates n] \as Coordinates;
\import \parent.FramedBundleIsomorphisms[F := F, G := F, sourceModel := sourceModel, targetModel := sourceModel, n := n, m := n] \as Comparing;
\import Operations.IdentityIsomorphism[X := X, F := F, bundle := framedBundle] \as Identity;
\import Spaces.Linear[V := Bundles.Vector n, W := Bundles.Vector n, source := Bundles.coordinates n, target := Bundles.coordinates n] \as Linear;
\definition identity: Linear.Map := Linear.Map {
  apply := \fun (v: Bundles.Vector n) => v,
  preservesAdd := \fun (v, w: Bundles.Vector n) => \refl((Bundles.coordinates n).add v w),
  preservesScale := \fun (a: C.Complex)(v: Bundles.Vector n) => \refl((Bundles.coordinates n).smul a v)
};
\definition coordinateIdentity: Coordinates.Isomorphism := Coordinates.Isomorphism {
  forward := identity, backward := identity,
  leftInverse := \fun (v: Bundles.Vector n) => \refl(v), rightInverse := \fun (v: Bundles.Vector n) => \refl(v)
};
\module With(alpha: Descent.OnSubset);
