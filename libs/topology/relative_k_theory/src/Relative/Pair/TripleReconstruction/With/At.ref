\definition e: Absolute.Fiber t.positive x := Pair.first (Absolute.Fiber t.positive x) (Absolute.Fiber Class.complement x) v;
\definition s: Absolute.Fiber Class.complement x := Pair.second (Absolute.Fiber t.positive x) (Absolute.Fiber Class.complement x) v;
\definition raw: NegativeSum.Fiber x := Pair.pair (Absolute.Fiber t.negative x) (Absolute.Fiber Class.complement x) ((t.comparison.forward.fiber x).apply e) s;
\definition evaluate[y: Absolute.Fiber result.value.negative x]: Bundles.Vector t.negative.dimension :=
  (Split.isomorphism.forward.fiber x).apply ((result.witness.negative.backward.fiber x).apply y);
\definition agreement: (result.value.comparison.forward.fiber x).apply ((result.witness.positive.forward.fiber x).apply v) = (result.witness.negative.forward.fiber x).apply raw :=
  trans!{{Absolute.Fiber result.value.negative x}} _ _ _
    (congr!{{Class.SourceFiber x} {Absolute.Fiber result.value.negative x}}
      (\fun (z: Class.SourceFiber x) => (result.value.comparison.forward.fiber x).apply ((result.witness.positive.forward.fiber x).apply z)) _ _
      (sym!{{Class.SourceFiber x}} _ _ (Pair.Prop[A := (Absolute.Fiber t.positive x), B := (Absolute.Fiber Class.complement x)].eta v)))
    (result.witness.agrees x e s);
\definition equation: (Boundary.comparison.forward.fiber x).apply ((result.witness.positive.forward.fiber x).apply v) = coordinateIdentity.forward.apply ((Class.comparison.forward.fiber x).apply v) :=
  trans!{{Bundles.Vector t.negative.dimension}} _ _ _
    (congr!{{Absolute.Fiber result.value.negative x} {Bundles.Vector t.negative.dimension}} evaluate _ _ agreement)
    (congr!{{NegativeSum.Fiber x} {Bundles.Vector t.negative.dimension}} (Split.isomorphism.forward.fiber x).apply _ _ (negativeLaws.leftInverse x raw));
