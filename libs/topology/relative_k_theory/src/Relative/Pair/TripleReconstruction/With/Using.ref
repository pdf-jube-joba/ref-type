\import \parent.\parent.\parent.Reconstruction[t := t].Normalized[normalized := normalized].With[extension := extension] \as Native;
\definition equation: Reverse.reduced Class.value = RelativeGroup.value t :=
  trans!{{RelativeGroup.Carrier}} _ _ _
    (congr!{{Quotient.Relative} {RelativeGroup.Carrier}} Reverse.reduced _ _
      (trans!{{Quotient.Relative}} _ _ _ Comparison.equation (TargetClass.agreement extension))) Native.equation;
