\definition normalized: Normalization.Result := Normalization.With[result := result].normalized;
\import Normalization.ToDescent[result := normalized] \as Boundary;
\definition TargetFiber[x: X]: \Set := Absolute.Fiber result.value.positive x;
\import \parent.\parent.BundleModel[F := TargetFiber].From[original := (Absolute.bundle result.value.positive), same := (\refl(space))] \as TargetModel;
\import \parent.\parent.FramedClass[F := TargetFiber, sourceModel := TargetModel.model, n := t.negative.dimension].With[alpha := Boundary.comparison] \as TargetClass;
\import Operations.DirectSum[X := X, F := (Absolute.Fiber t.negative), G := (Absolute.Fiber Class.complement), left := (Absolute.bundle t.negative), right := (Absolute.bundle Class.complement)] \as NegativeSum;
\import Bundles.Isomorphisms[X := X, F := NegativeSum.Fiber, G := (Absolute.Fiber result.value.negative),
  source := Sums.negativeBundle, target := (Absolute.bundle result.value.negative)] \as Negative;
\definition negativeLaws: Negative.Laws[result.witness.negative] := \bysub(Negative.Data, Negative.Isomorphism, result.witness.negative);
\import std.Data[].Pair[] \as Pair;
\module At(x: A, v: Class.SourceFiber x);
\definition compatible: \forall (x: A)(v: Class.SourceFiber x) ->
  (Boundary.comparison.forward.fiber x).apply ((result.witness.positive.forward.fiber x).apply v) = coordinateIdentity.forward.apply ((Class.comparison.forward.fiber x).apply v) :=
  \fun (x: A)(v: Class.SourceFiber x) => At[x := x, v := v].equation;
\import \parent.\parent.FramedClass[F := Class.SourceFiber, sourceModel := Class.sourceModel, n := t.negative.dimension].To[
  G := TargetFiber, targetModel := TargetModel.model, m := t.negative.dimension].With[
  alpha := Class.comparison, beta := Boundary.comparison, h := result.witness.positive, c := coordinateIdentity, compatible := compatible] \as Comparison;
\import \root.Relative[].Descent[X := X, F := TargetFiber, bundle := (Absolute.bundle result.value.positive),
  compact := compact, hausdorff := hausdorff, subset := subset, closed := closed, dimension := t.negative.dimension].With[comparison := Boundary.comparison] \as Descended;
\module Using(extension: Descended.Result);
\definition equation: Reverse.reduced Class.value = RelativeGroup.value t := \block {
  \takefrom witness: \root.Relative[].Descent[X := X, F := TargetFiber, bundle := (Absolute.bundle result.value.positive),
    compact := compact, hausdorff := hausdorff, subset := subset, closed := closed, dimension := t.negative.dimension].Witness[Boundary.comparison] \by Boundary.existence \then
  \return Using[extension := witness.extension].equation
};
