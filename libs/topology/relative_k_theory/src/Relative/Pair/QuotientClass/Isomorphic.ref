\import \parent.\parent.QuotientClass[F := G, bundle := target, same := targetSame] \as Changed;
\import \parent.\parent.FromQuotient[F := G, bundle := target, same := targetSame] \as TargetRaw;
\import \parent.\parent.QuotientIsomorphisms[F := F, G := G, source := bundle, target := target, sourceSame := same, targetSame := targetSame] \as Compared;
\definition equation: value = Changed.value := \block {
  \takefrom first: Raw.Witness \by Raw.existence \then
  \takefrom second: TargetRaw.Witness \by TargetRaw.existence \then
  \return trans!{{RelativeGroup.Carrier}} _ _ _ (agreement first)
    (trans!{{RelativeGroup.Carrier}} _ _ _ (Compared.On[h := h, first := first, second := second].equation)
      (sym!{{RelativeGroup.Carrier}} _ _ (Changed.agreement second)))
};
