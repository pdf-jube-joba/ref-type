\definition point: ClosedPoint := closedPoint x;
\definition vector[v: Bundles.Vector n]: Absolute.Fiber p x := (first.isomorphism.backward.fiber (leftBase point)).apply v;
\definition formula[v: Bundles.Vector n]: (originalCoefficients point).apply v = c.apply v :=
  trans!{{Bundles.Vector m}} _ _ _ (second.extends x ((h.fiber x).apply (vector v)))
    (trans!{{Bundles.Vector m}} _ _ _ (compatible x (vector v))
      (congr!{{Bundles.Vector n} {Bundles.Vector m}} c.apply _ _
        (trans!{{Bundles.Vector n}} _ _ _ (sym!{{Bundles.Vector n}} _ _ (first.extends x (vector v))) (From.localLaws.rightInverse (leftBase point) v))));
