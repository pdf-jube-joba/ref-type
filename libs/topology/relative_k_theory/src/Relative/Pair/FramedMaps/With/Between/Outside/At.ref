\import From.Alignment[q := exterior z] \as LeftAlignment;
\import To.Alignment[q := exterior z] \as RightAlignment;
\definition left: LeftAlignment.Agreement[i, leftContains z] := LeftAlignment.agreement i (leftContains z);
\definition right: RightAlignment.Agreement[j, rightContains z] := RightAlignment.agreement j (rightContains z);
\definition leftBase: \Cast[X] (From.sourceChart i).domain := \into[X](original z, (From.sourceChart i).domain) \by { left.inside };
\definition rightBase: \Cast[X] (To.sourceChart j).domain := \into[X](original z, (To.sourceChart j).domain) \by { right.inside };
\definition formula[v: Bundles.Vector (From.sourceChart i).dimension]: (coefficients z).apply v =
  ((To.sourceChart j).frame rightBase).forward.apply ((h.fiber (original z)).apply (((From.sourceChart i).frame leftBase).backward.apply v)) :=
  trans!{{Bundles.Vector (To.sourceChart j).dimension}} _ _ _
    (right.reading ((map z).apply ((Left.trivialization.frame z).backward.apply v)))
    (congr!{{Absolute.Fiber p (original z)} {Bundles.Vector (To.sourceChart j).dimension}}
      (\fun (w: Absolute.Fiber p (original z)) => ((To.sourceChart j).frame rightBase).forward.apply ((h.fiber (original z)).apply w)) _ _ (left.writing v));
