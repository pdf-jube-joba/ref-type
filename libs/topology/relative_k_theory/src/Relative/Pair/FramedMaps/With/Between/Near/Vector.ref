\definition value[x: ClosedPoint]: Absolute.Fiber p x := (first.isomorphism.backward.fiber (leftBase x)).apply v;
\definition valueContinuous: topology.Continuity[A := ClosedPoint, B := FirstFamily.Point].Continuous closedSpace (Absolute.bundle p).totalSpace
  (\fun (x: ClosedPoint) => FirstFamily.include x (value x)) :=
  From.nearRegular.writing ClosedPoint closedSpace leftBase leftContinuous (\fun (x: ClosedPoint) => v)
    (topology.Maps[A := ClosedPoint, B := Bundles.Vector n].constantContinuous closedSpace (Bundles.coordinateTopology n) v);
\definition mapped[x: ClosedPoint]: Absolute.Fiber q x := (h.fiber x).apply (value x);
\definition mappedContinuous: topology.Continuity[A := ClosedPoint, B := SecondFamily.Point].Continuous closedSpace (Absolute.bundle q).totalSpace
  (\fun (x: ClosedPoint) => SecondFamily.include x (mapped x)) :=
  topology.Composition[A := ClosedPoint, B := FirstFamily.Point, C := SecondFamily.Point].composeContinuous closedSpace (Absolute.bundle p).totalSpace (Absolute.bundle q).totalSpace
    (\fun (x: ClosedPoint) => FirstFamily.include x (value x)) (Global.total h) valueContinuous (\bysub(Global.Data, Global.Map, h));
\definition coordinate[x: ClosedPoint]: Bundles.Vector m := (second.isomorphism.forward.fiber (rightBase x)).apply (mapped x);
\definition coordinateContinuous: topology.Continuity[A := ClosedPoint, B := Bundles.Vector m].Continuous closedSpace (Bundles.coordinateTopology m) coordinate :=
  To.nearRegular.reading ClosedPoint closedSpace rightBase rightContinuous mapped mappedContinuous;
\definition continuous[i: Fin.Fin m]: topology.Continuity[A := ClosedPoint, B := C.Complex].Continuous closedSpace Scalar.scalar.topological.space
  (\fun (x: ClosedPoint) => (originalCoefficients x).apply v i) :=
  topology.Composition[A := ClosedPoint, B := Bundles.Vector m, C := C.Complex].composeContinuous closedSpace (Bundles.coordinateTopology m) Scalar.scalar.topological.space
    coordinate (\fun (v: Bundles.Vector m) => v i) coordinateContinuous
    (topological_algebra.Coordinates[K := C.Complex, I := Fin.Fin m].evaluationContinuous Scalar.scalar.topological.space i);
