\import Source.Construction[extension := first] \as From;
\import Target.Construction[extension := second] \as To;
\import Native.Between[first := first, second := second] \as NativeBetween;
\definition morphism: Bundles.Morphisms[X := Quotient.Carrier, Y := Quotient.Carrier, F := Source.Fiber, G := Target.Fiber,
  source := From.bundleOnQuotient, target := To.bundleOnQuotient, f := (\fun (z: Quotient.Carrier) => z)].Map := NativeBetween.morphism;
