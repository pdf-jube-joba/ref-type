\definition value[z: Point]: Absolute.Fiber p (original z) := ((From.sourceChart i).frame (leftBase z)).backward.apply v;
\definition valueContinuous: topology.Continuity[A := Point, B := FirstFamily.Point].Continuous topology (Absolute.bundle p).totalSpace
  (\fun (z: Point) => FirstFamily.include (original z) (value z)) :=
  (From.regularFrame i).writing Point topology leftBase leftContinuous (\fun (z: Point) => v)
    (topology.Maps[A := Point, B := Bundles.Vector (From.sourceChart i).dimension].constantContinuous topology (Bundles.coordinateTopology (From.sourceChart i).dimension) v);
\definition mapped[z: Point]: Absolute.Fiber q (original z) := (h.fiber (original z)).apply (value z);
\definition mappedContinuous: topology.Continuity[A := Point, B := SecondFamily.Point].Continuous topology (Absolute.bundle q).totalSpace
  (\fun (z: Point) => SecondFamily.include (original z) (mapped z)) :=
  topology.Composition[A := Point, B := FirstFamily.Point, C := SecondFamily.Point].composeContinuous topology (Absolute.bundle p).totalSpace (Absolute.bundle q).totalSpace
    (\fun (z: Point) => FirstFamily.include (original z) (value z)) (Global.total h) valueContinuous
    (\bysub(Global.Data, Global.Map, h));
\definition coordinate[z: Point]: Bundles.Vector (To.sourceChart j).dimension := ((To.sourceChart j).frame (rightBase z)).forward.apply (mapped z);
\definition coordinateContinuous: topology.Continuity[A := Point, B := Bundles.Vector (To.sourceChart j).dimension].Continuous topology (Bundles.coordinateTopology (To.sourceChart j).dimension) coordinate :=
  (To.regularFrame j).reading Point topology rightBase rightContinuous mapped mappedContinuous;
\definition continuous[k: Fin.Fin (To.sourceChart j).dimension]: topology.Continuity[A := Point, B := C.Complex].Continuous topology Scalar.scalar.topological.space
  (\fun (z: Point) => (coefficients z).apply v k) :=
  \idelim (\fun (z: Point) => coordinate z k) = (\fun (z: Point) => (coefficients z).apply v k) \with f: (Point -> C.Complex) =>
    topology.Continuity[A := Point, B := C.Complex].Continuous topology Scalar.scalar.topological.space f \by {
      base: topology.Composition[A := Point, B := Bundles.Vector (To.sourceChart j).dimension, C := C.Complex].composeContinuous topology (Bundles.coordinateTopology (To.sourceChart j).dimension) Scalar.scalar.topological.space
        coordinate (\fun (w: Bundles.Vector (To.sourceChart j).dimension) => w k) coordinateContinuous
        (topological_algebra.Coordinates[K := C.Complex, I := Fin.Fin (To.sourceChart j).dimension].evaluationContinuous Scalar.scalar.topological.space k),
      equality: \axiom:funext((\fun (z: Point) => coordinate z k), (\fun (z: Point) => (coefficients z).apply v k),
        \fun (z: Point) => sym!{{C.Complex}} _ _ (congr!{{Bundles.Vector (To.sourceChart j).dimension} {C.Complex}} (\fun (w: Bundles.Vector (To.sourceChart j).dimension) => w k) _ _ (\parent.At[z := z].formula v)))
    };
