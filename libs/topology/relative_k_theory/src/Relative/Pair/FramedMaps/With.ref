\import First.With[comparison := alpha] \as Source;
\import Second.With[comparison := beta] \as Target;
\import \parent.\parent.Quotient[] \as Quotient;
\module At(z: Quotient.Carrier);
\definition map[z: Quotient.Carrier]: Spaces.Linear[V := Source.Fiber z, W := Target.Fiber z, source := Source.fiberSpace z, target := Target.fiberSpace z].Map := At[z := z].map;
\module Between(first: Source.Result, second: Target.Result);
