\import First.With[comparison := alpha] \as Source;
\import Second.With[comparison := beta] \as Target;
\import \parent.\parent.Quotient[] \as Quotient;
\import General.With[alpha := alpha, beta := beta, h := h, c := c, compatible := compatible] \as Native;
\definition map[z: Quotient.Carrier]: Spaces.Linear[V := Source.Fiber z, W := Target.Fiber z, source := Source.fiberSpace z, target := Target.fiberSpace z].Map := Native.map z;
\module Between(first: Source.Result, second: Target.Result);
