\import \parent.TripleClass[t := t] \as First;
\import \parent.TripleClass[t := u] \as Second;
\import Complements.Projection[X := X, n := t.negative.dimension, baseSpace := space, P := t.negative.projection, regular := t.negative.regular].Complement[] \as FirstSplit;
\import Complements.Projection[X := X, n := u.negative.dimension, baseSpace := space, P := u.negative.projection, regular := u.negative.regular].Complement[] \as SecondSplit;
\import \parent.TripleFraming[t := t, auxiliary := First.complement, n := t.negative.dimension] \as FirstFraming;
\import \parent.TripleFraming[t := u, auxiliary := First.complement, n := t.negative.dimension] \as ChangedFraming;
\import \parent.Group[].Isomorphic[t := t, u := u] \as Isomorphic;
\definition E[x: X]: \Set := Absolute.Fiber t.positive x;
\definition F[x: X]: \Set := Absolute.Fiber t.negative x;
\definition G[x: X]: \Set := Absolute.Fiber u.positive x;
\definition H[x: X]: \Set := Absolute.Fiber u.negative x;
\definition S[x: X]: \Set := Absolute.Fiber First.complement x;
\import Operations.IdentityIsomorphism[X := X, F := S, bundle := (Absolute.bundle First.complement)] \as Identity;
\import Operations.DirectSumIsomorphisms[X := X, F := E, G := S, A := G, B := S,
  first := (Absolute.bundle t.positive), second := (Absolute.bundle First.complement), newFirst := (Absolute.bundle u.positive), newSecond := (Absolute.bundle First.complement),
  sameSource := (\refl(space)), sameTarget := (\refl(space))] \as Positive;
\import Operations.DirectSumIsomorphisms[X := X, F := H, G := S, A := F, B := S,
  first := (Absolute.bundle u.negative), second := (Absolute.bundle First.complement), newFirst := (Absolute.bundle t.negative), newSecond := (Absolute.bundle First.complement),
  sameSource := (\refl(space)), sameTarget := (\refl(space))] \as Negative;
\import Bundles.Isomorphisms[X := X, F := F, G := H, source := (Absolute.bundle t.negative), target := (Absolute.bundle u.negative)] \as NegativeMaps;
\import Bundles.Trivial[X := X, n := t.negative.dimension, baseSpace := space] \as Trivial;
\import Operations.IsomorphismComposition[X := X, F := ChangedFraming.NegativeFiber, G := FirstFraming.NegativeFiber, H := (\fun (x: X) => Bundles.Vector t.negative.dimension),
  source := ChangedFraming.negativeBundle, middle := FirstFraming.negativeBundle, target := Trivial.bundle] \as Triviality;
\import Spaces.Isomorphism[V := Bundles.Vector t.negative.dimension, W := Bundles.Vector t.negative.dimension,
  source := Bundles.coordinates t.negative.dimension, target := Bundles.coordinates t.negative.dimension] \as Coordinates;
\module With(w: Isomorphic.Witness);
