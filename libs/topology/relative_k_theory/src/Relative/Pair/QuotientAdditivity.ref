\import \parent.Quotient[] \as Quotient;
\import topology.Topology[Carrier := Quotient.Carrier] \as QuotientBase;
\import Bundles.Family[X := Quotient.Carrier, F := F].With[data := source] \as SourceCharts;
\import Bundles.Family[X := Quotient.Carrier, F := G].With[data := target] \as TargetCharts;
\import \parent.FromQuotient[F := F, bundle := source, same := sourceSame] \as First;
\import \parent.FromQuotient[F := G, bundle := target, same := targetSame] \as Second;
\import \parent.QuotientClass[F := F, bundle := source, same := sourceSame] \as FirstClass;
\import \parent.QuotientClass[F := G, bundle := target, same := targetSame] \as SecondClass;
\definition sameBase: source.baseSpace = target.baseSpace := trans!{{QuotientBase.Topology}} _ _ _ sourceSame (sym!{{QuotientBase.Topology}} _ _ targetSame);
\import Operations.DirectSum[X := Quotient.Carrier, F := F, G := G, left := source, right := target] \as Sum;
\definition sumBundle: Bundles.Family[X := Quotient.Carrier, F := Sum.Fiber].Bundle := Sum.bundle sameBase;
\import \parent.FromQuotient[F := Sum.Fiber, bundle := sumBundle, same := sourceSame] \as SumRaw;
\import \parent.QuotientClass[F := Sum.Fiber, bundle := sumBundle, same := sourceSame] \as SumClass;
\import \parent.Group[] \as RelativeGroup;
\module On(first: First.Witness, second: Second.Witness);
\definition equation: RelativeGroup.add FirstClass.value SecondClass.value = SumClass.value := \block {
  \takefrom first: First.Witness \by First.existence \then
  \takefrom second: Second.Witness \by Second.existence \then
  \return On[first := first, second := second].equation
};
