\import \parent.TripleFraming[t := t, auxiliary := first, n := n] \as FirstFraming;
\import \parent.TripleFraming[t := t, auxiliary := second, n := m] \as SecondFraming;
\definition E[x: X]: \Set := Absolute.Fiber t.positive x;
\definition F[x: X]: \Set := Absolute.Fiber t.negative x;
\definition S[x: X]: \Set := Absolute.Fiber first x;
\definition T[x: X]: \Set := Absolute.Fiber second x;
\definition eBundle: Bundles.Family[X := X, F := E].Bundle := Absolute.bundle t.positive;
\definition fBundle: Bundles.Family[X := X, F := F].Bundle := Absolute.bundle t.negative;
\definition sBundle: Bundles.Family[X := X, F := S].Bundle := Absolute.bundle first;
\definition tBundle: Bundles.Family[X := X, F := T].Bundle := Absolute.bundle second;
\import \parent.BundleModel[F := E].From[original := eBundle, same := (\refl(space))] \as EModel;
\import \parent.BundleModel[F := F].From[original := fBundle, same := (\refl(space))] \as FModel;
\import \parent.BundleSwitch[F := E, G := F, sourceModel := EModel.model, targetModel := FModel.model].With[alpha := t.comparison] \as Switch;
\import Operations.DirectSum[X := X, F := E, G := F, left := eBundle, right := fBundle] \as EF;
\import Operations.DirectSum[X := X, F := S, G := T, left := sBundle, right := tBundle] \as ST;
\definition efBundle: Bundles.Family[X := X, F := EF.Fiber].Bundle := EF.bundle (\refl(space));
\definition stBundle: Bundles.Family[X := X, F := ST.Fiber].Bundle := ST.bundle (\refl(space));
\import ST.Of[same := (\refl(space))].Symmetry[] \as SideSymmetry;
\import Operations.DirectSum[X := X, F := T, G := S, left := tBundle, right := sBundle] \as TS;
\definition tsBundle: Bundles.Family[X := X, F := TS.Fiber].Bundle := TS.bundle (\refl(space));
\import Operations.DirectSumMiddleSwap[X := X, F := E, G := S, H := F, I := T, first := eBundle, second := sBundle, third := fBundle, fourth := tBundle,
  sameSecond := (\refl(space)), sameThird := (\refl(space)), sameFourth := (\refl(space))] \as StartOrder;
\import Operations.DirectSumMiddleSwap[X := X, F := E, G := F, H := T, I := S, first := eBundle, second := fBundle, third := tBundle, fourth := sBundle,
  sameSecond := (\refl(space)), sameThird := (\refl(space)), sameFourth := (\refl(space))] \as FinishOrder;
\import Operations.IdentityIsomorphism[X := X, F := EF.Fiber, bundle := efBundle] \as IdentityEF;
\import Operations.IdentityIsomorphism[X := X, F := ST.Fiber, bundle := stBundle] \as IdentityST;
\import Operations.IdentityIsomorphism[X := X, F := FirstFraming.SourceFiber, bundle := FirstFraming.positiveBundle] \as IdentityES;
\import Operations.IdentityIsomorphism[X := X, F := SecondFraming.SourceFiber, bundle := SecondFraming.positiveBundle] \as IdentityET;
\import Bundles.Trivial[X := X, n := n, baseSpace := space] \as FirstTrivial;
\import Bundles.Trivial[X := X, n := m, baseSpace := space] \as SecondTrivial;
\import Bundles.Isomorphisms[X := X, F := FirstFraming.NegativeFiber, G := (\fun (x: X) => Bundles.Vector n), source := FirstFraming.negativeBundle, target := FirstTrivial.bundle] \as FirstIsomorphisms;
\import Bundles.Isomorphisms[X := X, F := SecondFraming.NegativeFiber, G := (\fun (x: X) => Bundles.Vector m), source := SecondFraming.negativeBundle, target := SecondTrivial.bundle] \as SecondIsomorphisms;
\import Operations.CoordinateSum[n := n, m := m] \as SourceCoordinates;
\import Operations.CoordinateSum[n := m, m := n] \as TargetCoordinates;
\import SourceCoordinates.Symmetry[] \as CoordinateSwitch;
\import Bundles.Isomorphisms[X := A, F := \parent.Restricted[p := t.positive].Fiber, G := \parent.Restricted[p := t.negative].Fiber,
  source := \parent.Restricted[p := t.positive].bundle, target := \parent.Restricted[p := t.negative].bundle] \as Boundary;
\definition boundaryLaws: Boundary.Laws[t.comparison] := \bysub(Boundary.Data, Boundary.Isomorphism, t.comparison);
\module With(h: FirstFraming.Trivialization, k: SecondFraming.Trivialization);
