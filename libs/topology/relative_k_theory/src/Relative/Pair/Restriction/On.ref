\import Pull.Of[F := Absolute.Fiber p, original := Absolute.bundle p, same := \refl(space)] \as Pulled;
\definition classes: Pull.map (Absolute.class p) = Pulled.value :=
  trans!{{Target.Classes}} _ _ _
    (congr!{{Absolute.Classes} {Target.Classes}} Pull.map _ _ (sym!{{Absolute.Classes}} _ _ (Absolute.Realized[p := p].equation))) Pulled.naturality;
