\import \root.Relative[].Descent[X := X, F := Absolute.Fiber p, bundle := Absolute.bundle p, compact := compact, hausdorff := hausdorff, subset := subset, closed := closed, dimension := n] \as FirstDescent;
\import \root.Relative[].Descent[X := X, F := Absolute.Fiber q, bundle := Absolute.bundle q, compact := compact, hausdorff := hausdorff, subset := subset, closed := closed, dimension := m] \as SecondDescent;
\import \parent.Quotient[] \as Quotient;
\import \parent.FramedMaps[p := p, q := q, n := n, m := m] \as Forward;
\import \parent.FramedMaps[p := q, q := p, n := m, m := n] \as Backward;
\import Bundles.Isomorphisms[X := X, F := Absolute.Fiber p, G := Absolute.Fiber q, source := Absolute.bundle p, target := Absolute.bundle q] \as Global;
\import Spaces.Isomorphism[V := Bundles.Vector n, W := Bundles.Vector m, source := Bundles.coordinates n, target := Bundles.coordinates m] \as Coordinates;
\module With(alpha: FirstDescent.OnSubset, beta: SecondDescent.OnSubset, h: Global.Isomorphism, c: Coordinates.Isomorphism,
  compatible: Forward.Compatible alpha beta h.forward c.forward);
