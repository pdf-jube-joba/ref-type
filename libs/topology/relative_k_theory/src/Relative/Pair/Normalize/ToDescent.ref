\definition value: Triple := result.value;
\definition inclusion[x: A]: X := x;
\definition regular: topology.Continuity[A := A, B := X].Continuous subspace space inclusion := topology.Continuity[A := A, B := X].Corestriction[S := subset].inclusionContinuous space;
\import Bundles.Trivial[X := X, n := result.dimension, baseSpace := space] \as Trivial;
\import Bundles.Family[X := X, F := (\fun (x: X) => Bundles.Vector result.dimension)].Of[bundle := Trivial.bundle].Restriction[U := subset] \as Target;
\import Complements.PulledIsomorphism[X := X, Y := A, F := Absolute.Fiber value.negative, G := (\fun (x: X) => Bundles.Vector result.dimension),
  source := Absolute.bundle value.negative, target := Trivial.bundle, base := subspace, f := inclusion, sourceRegular := regular, targetRegular := regular] \as Triviality;
\import Operations.IsomorphismComposition[X := A, F := \parent.\parent.Restricted[p := value.positive].Fiber,
  G := \parent.\parent.Restricted[p := value.negative].Fiber, H := (\fun (x: A) => Bundles.Vector result.dimension),
  source := \parent.\parent.Restricted[p := value.positive].bundle, middle := \parent.\parent.Restricted[p := value.negative].bundle, target := Target.restricted] \as Compose;
\import \root.Relative[].Descent[X := X, F := Absolute.Fiber value.positive, bundle := Absolute.bundle value.positive, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed, dimension := result.dimension] \as Descent;
\definition comparison: Descent.OnSubset := Compose.compose value.comparison (Triviality.isomorphism result.trivialization);
\definition existence: \exists Descent.Witness[comparison] := Descent.descend comparison;
