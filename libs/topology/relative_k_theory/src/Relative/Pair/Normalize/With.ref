\definition resultTriple: Triple := result.value;
\import Operations.DirectSum[X := X, F := Absolute.Fiber t.negative, G := Absolute.Fiber complement, left := Absolute.bundle t.negative, right := Absolute.bundle complement] \as NegativeSum;
\import Bundles.Isomorphisms[X := X, F := NegativeSum.Fiber, G := Absolute.Fiber resultTriple.negative,
  source := Split.sumBundle, target := Absolute.bundle resultTriple.negative] \as Negative;
\import Operations.IsomorphismComposition[X := X, F := Absolute.Fiber resultTriple.negative, G := NegativeSum.Fiber,
  H := (\fun (x: X) => Bundles.Vector t.negative.dimension), source := Absolute.bundle resultTriple.negative, middle := Split.sumBundle,
  target := Bundles.Trivial[X := X, n := t.negative.dimension, baseSpace := space].bundle] \as Trivial;
\definition trivialization: Trivial.Isomorphism := Trivial.compose (Negative.inverse result.witness.negative) Split.isomorphism;
\import algebra.Group[].Of[Carrier := Group.Carrier, group := Group.group] \as Algebra;
\definition equation: Group.value t = Group.value resultTriple :=
  trans!{{Group.Carrier}} _ _ _ (sym!{{Group.Carrier}} _ _ (Algebra.zeroRight (Group.value t)))
    (trans!{{Group.Carrier}} _ _ _ (congr!{{Group.Carrier} {Group.Carrier}} (Group.add (Group.value t)) _ _ (sym!{{Group.Carrier}} _ _ (Group.Diagonal[p := complement].equation)))
      (Group.sum t Added.triple resultTriple result.witness));
\definition normalized: Result := Result { value := resultTriple, dimension := t.negative.dimension, trivialization := trivialization, equality := equation };
