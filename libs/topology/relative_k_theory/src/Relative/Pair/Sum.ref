\import std.Data[].Pair[] \as Product;
\import Operations.DirectSum[X := X, F := Absolute.Fiber t.positive, G := Absolute.Fiber u.positive,
  left := Absolute.bundle t.positive, right := Absolute.bundle u.positive] \as Positive;
\import Operations.DirectSum[X := X, F := Absolute.Fiber t.negative, G := Absolute.Fiber u.negative,
  left := Absolute.bundle t.negative, right := Absolute.bundle u.negative] \as Negative;
\import Bundles.Isomorphisms[X := X, F := Positive.Fiber, G := Absolute.Fiber v.positive,
  source := Positive.bundle (\refl(space)), target := Absolute.bundle v.positive] \as PositiveMaps;
\import Bundles.Isomorphisms[X := X, F := Negative.Fiber, G := Absolute.Fiber v.negative,
  source := Negative.bundle (\refl(space)), target := Absolute.bundle v.negative] \as NegativeMaps;
\structure Witness: \Set := {
  positive: PositiveMaps.Isomorphism,
  negative: NegativeMaps.Isomorphism,
  agrees: \forall (x: A)(a: Absolute.Fiber t.positive x)(b: Absolute.Fiber u.positive x) ->
    (v.comparison.forward.fiber x).apply ((positive.forward.fiber x).apply (Product.pair (Absolute.Fiber t.positive x) (Absolute.Fiber u.positive x) a b)) =
    (negative.forward.fiber x).apply (Product.pair (Absolute.Fiber t.negative x) (Absolute.Fiber u.negative x)
      ((t.comparison.forward.fiber x).apply a) ((u.comparison.forward.fiber x).apply b))
};
