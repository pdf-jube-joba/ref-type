\import \root.Relative[].Suspension[original := source] \as Source;
\import \root.Relative[].Suspension[original := target] \as Target;
\import \root.Relative[].SuspendedMap[source := source, target := target, f := f] \as Lift;
\import algebraic_topology.Suspension[A := source.Carrier].Pointed[source := (details source).topology, basepoint := (details source).point] \as SourceNative;
\import algebraic_topology.Suspension[A := target.Carrier].Pointed[source := (details target).topology, basepoint := (details target).point] \as TargetNative;
\import SourceNative.Mapping[B := target.Carrier, target := pointed target, f := f] \as Mapping;
\import algebraic_topology.Cylinder[A := source.Carrier] \as SourceCylinder;
\import algebraic_topology.Cylinder[A := target.Carrier] \as TargetCylinder;
\import algebraic_topology.Collapse[A := SourceCylinder.Carrier, subset := SourceNative.Collapsed] \as SourceCollapse;
\definition equation: \forall (x: Source.result.Carrier) -> Lift.map x = (details Target.result).point :=
  SourceCollapse.induction (\fun (x: Source.result.Carrier) => Lift.map x = (details Target.result).point)
    (\fun (z: SourceCylinder.Carrier) => trans!{{Target.result.Carrier}} _ _ _ (Mapping.onClass z)
      (trans!{{Target.result.Carrier}} _ _ _
        (congr!{{target.Carrier} {Target.result.Carrier}} (\fun (x: target.Carrier) => TargetNative.class (TargetCylinder.at (SourceCylinder.time z) x)) _ _ (constant (SourceCylinder.point z)))
        (TargetNative.line (SourceCylinder.time z))));
