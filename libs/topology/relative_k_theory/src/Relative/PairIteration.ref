\definition iteratePair[n: N.Nat^][original: ClosedPointedPair]: ClosedPointedPair :=
  (\induction (n: N.Nat^) \return ClosedPointedPair \with {
    | zero: original
    | succ: \fun (n: N.Nat^)(previous: ClosedPointedPair) => PointedPair[pair := previous].suspended
  }) n;
\import \root.Relative[].PointedPair[pair := pair] \as Original;
\definition modelEquation[degree: N.Nat^]: (iteratePair degree pair).model = iterate degree pair.model :=
  (\induction (degree: N.Nat^) \return (iteratePair degree pair).model = iterate degree pair.model \with {
    | zero: \refl(pair.model)
    | succ: \fun (n: N.Nat^)(previous: (iteratePair n pair).model = iterate n pair.model) =>
      trans!{{CompactPointed}} _ _ _ (\root.Relative[].PointedPair[pair := iteratePair n pair].suspendedModel)
        (congr!{{CompactPointed} {CompactPointed}} (\fun (model: CompactPointed) => \root.Relative[].Suspension[original := model].result) _ _ previous)
  }) degree;
\import \root.Relative[].Identity[model := Original.quotientModel] \as Identity;
\definition identity: \root.Relative[].Equivalence[source := Original.quotientModel, target := Original.quotientModel].Data :=
  \root.Relative[].Equivalence[source := Original.quotientModel, target := Original.quotientModel].Data {
    forward := Identity.map, backward := Identity.map, leftInverse := \fun (x: Original.quotientModel.Carrier) => \refl(x), rightInverse := \fun (x: Original.quotientModel.Carrier) => \refl(x)
  };
\module QuotientStep(degree: N.Nat^, previous: \root.Relative[].Equivalence[source := \root.Relative[].PointedPair[pair := iteratePair degree pair].quotientModel,
  target := iterate degree Original.quotientModel].Data);
\definition quotientComparison[degree: N.Nat^]: \root.Relative[].Equivalence[source := \root.Relative[].PointedPair[pair := iteratePair degree pair].quotientModel,
  target := iterate degree Original.quotientModel].Data :=
  (\induction (degree: N.Nat^) \return \root.Relative[].Equivalence[source := \root.Relative[].PointedPair[pair := iteratePair degree pair].quotientModel,
    target := iterate degree Original.quotientModel].Data \with {
      | zero: identity
      | succ: \fun (n: N.Nat^)(previous: \root.Relative[].Equivalence[source := \root.Relative[].PointedPair[pair := iteratePair n pair].quotientModel,
        target := iterate n Original.quotientModel].Data) => QuotientStep[degree := n, previous := previous].result
    }) degree;
\module Groups(degree: N.Nat^);
\import \root.Relative[].Identity[model := Original.subsetModel] \as SubsetIdentity;
\definition subsetIdentity: \root.Relative[].Equivalence[source := Original.subsetModel, target := Original.subsetModel].Data :=
  \root.Relative[].Equivalence[source := Original.subsetModel, target := Original.subsetModel].Data {
    forward := SubsetIdentity.map, backward := SubsetIdentity.map,
    leftInverse := \fun (x: Original.subsetModel.Carrier) => \refl(x), rightInverse := \fun (x: Original.subsetModel.Carrier) => \refl(x)
  };
\import \root.Relative[].Identity[model := pair.model] \as WholeIdentity;
\definition wholeIdentity: \root.Relative[].Equivalence[source := pair.model, target := pair.model].Data :=
  \root.Relative[].Equivalence[source := pair.model, target := pair.model].Data {
    forward := WholeIdentity.map, backward := WholeIdentity.map,
    leftInverse := \fun (x: pair.model.Carrier) => \refl(x), rightInverse := \fun (x: pair.model.Carrier) => \refl(x)
  };
\module WholeStep(degree: N.Nat^, previous: \root.Relative[].Equivalence[source := (iteratePair degree pair).model, target := iterate degree pair.model].Data);
\module SubsetStep(degree: N.Nat^, previous: \root.Relative[].Equivalence[source := \root.Relative[].PointedPair[pair := iteratePair degree pair].subsetModel,
  target := iterate degree Original.subsetModel].Data);
\definition wholeComparison[degree: N.Nat^]: \root.Relative[].Equivalence[source := (iteratePair degree pair).model, target := iterate degree pair.model].Data :=
  (\induction (degree: N.Nat^) \return \root.Relative[].Equivalence[source := (iteratePair degree pair).model, target := iterate degree pair.model].Data \with {
    | zero: wholeIdentity
    | succ: \fun (n: N.Nat^)(previous: \root.Relative[].Equivalence[source := (iteratePair n pair).model, target := iterate n pair.model].Data) =>
      WholeStep[degree := n, previous := previous].result
  }) degree;
\definition subsetComparison[degree: N.Nat^]: \root.Relative[].Equivalence[source := \root.Relative[].PointedPair[pair := iteratePair degree pair].subsetModel,
  target := iterate degree Original.subsetModel].Data :=
  (\induction (degree: N.Nat^) \return \root.Relative[].Equivalence[source := \root.Relative[].PointedPair[pair := iteratePair degree pair].subsetModel,
    target := iterate degree Original.subsetModel].Data \with {
      | zero: subsetIdentity
      | succ: \fun (n: N.Nat^)(previous: \root.Relative[].Equivalence[source := \root.Relative[].PointedPair[pair := iteratePair n pair].subsetModel,
        target := iterate n Original.subsetModel].Data) => SubsetStep[degree := n, previous := previous].result
    }) degree;
\module WholeGroups(degree: N.Nat^);
\module SubsetGroups(degree: N.Nat^);
\module InclusionAt(degree: N.Nat^);
\module InclusionStep(degree: N.Nat^, previous: \parent.InclusionAt[degree := degree].Equation);
\definition inclusionNaturality[degree: N.Nat^]: InclusionAt[degree := degree].Equation :=
  (\induction (degree: N.Nat^) \return InclusionAt[degree := degree].Equation \with {
    | zero: \axiom:funext(InclusionAt[degree := N.Nat^::zero].left, InclusionAt[degree := N.Nat^::zero].right,
        (\fun (x: Original.subsetModel.Carrier) => \refl(Original.inclusion x)))
    | succ: \fun (n: N.Nat^)(previous: InclusionAt[degree := n].Equation) => InclusionStep[degree := n, previous := previous].equation
  }) degree;
\module ProjectionAt(degree: N.Nat^);
\module ProjectionStep(degree: N.Nat^, previous: \parent.ProjectionAt[degree := degree].Equation);
\definition projectionNaturality[degree: N.Nat^]: ProjectionAt[degree := degree].Equation :=
  (\induction (degree: N.Nat^) \return ProjectionAt[degree := degree].Equation \with {
    | zero: \axiom:funext(ProjectionAt[degree := N.Nat^::zero].left, ProjectionAt[degree := N.Nat^::zero].right,
        (\fun (x: pair.model.Carrier) => \refl(Original.projection x)))
    | succ: \fun (n: N.Nat^)(previous: ProjectionAt[degree := n].Equation) => ProjectionStep[degree := n, previous := previous].equation
  }) degree;
\module InclusionPullback(degree: N.Nat^);
\module ProjectionPullback(degree: N.Nat^);
\module SuspendedInclusion(degree: N.Nat^);
\module Sequence(degree: N.Nat^);
\definition restrictionLink: \forall (degree: N.Nat^)(v: \root.Relative[].Negative[original := pair.model, degree := (N.Nat^::succ degree)].Carrier) ->
  Sequence[degree := degree].restrictionNegative v = Sequence[degree := (N.Nat^::succ degree)].restriction v :=
  \fun (degree: N.Nat^)(v: \root.Relative[].Negative[original := pair.model, degree := (N.Nat^::succ degree)].Carrier) =>
    trans!{{\root.Relative[].Negative[original := Original.subsetModel, degree := (N.Nat^::succ degree)].Carrier}} _ _ _
      (Sequence[degree := degree].restrictionNegativeFormula v)
      (sym!{{\root.Relative[].Negative[original := Original.subsetModel, degree := (N.Nat^::succ degree)].Carrier}} _ _ (Sequence[degree := (N.Nat^::succ degree)].restrictionFormula v));
