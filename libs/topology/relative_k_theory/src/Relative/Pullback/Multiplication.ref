\import From.Multiplication[] \as SourceProduct;
\import To.Multiplication[] \as TargetProduct;
\definition equation: \forall (v, w: From.Carrier) -> map (SourceProduct.mul v w) = TargetProduct.mul (map v) (map w) :=
  \fun (v, w: From.Carrier) => (RingMaps.semiringLaws (std.Alg[].Ring[].ringAsSemiring SourceK.Carrier SourceK.ring)
    (std.Alg[].Ring[].ringAsSemiring TargetK.Carrier TargetK.ring) Pull.K0[].map).mul v w;
