\import \root.Relative[].PairIteration[pair := source].Sequence[degree := degree] \as SourceSequence;
\import \root.Relative[].PairIteration[pair := target].Sequence[degree := degree] \as TargetSequence;
\import \root.Relative[].NegativeMap[source := source.model, target := target.model, f := f.function, degree := degree] \as Whole;
\import \root.Relative[].NegativeMap[source := From.subsetModel, target := To.subsetModel, f := subsetMap, degree := degree] \as Subset;
\import \root.Relative[].NegativeMap[source := From.quotientModel, target := To.quotientModel, f := quotientMap, degree := degree] \as Relative;
\import \root.Relative[].NegativeMap[source := From.subsetModel, target := source.model, f := From.inclusion, degree := degree] \as SourceRestriction;
\import \root.Relative[].NegativeMap[source := To.subsetModel, target := target.model, f := To.inclusion, degree := degree] \as TargetRestriction;
\import \root.Relative[].NegativeMap[source := source.model, target := From.quotientModel, f := From.projection, degree := degree] \as SourceProjection;
\import \root.Relative[].NegativeMap[source := target.model, target := To.quotientModel, f := To.projection, degree := degree] \as TargetProjection;
\definition restriction: \forall (v: TargetSequence.Fourth) -> SourceSequence.restriction (Whole.map v) = Subset.map (TargetSequence.restriction v) :=
  \fun (v: TargetSequence.Fourth) => trans!{{SourceSequence.Fifth}} _ _ _ (SourceSequence.restrictionFormula (Whole.map v))
    (trans!{{SourceSequence.Fifth}} _ _ _ (Inclusion.Negative[degree := degree].equation v)
      (congr!{{TargetSequence.Fifth} {SourceSequence.Fifth}} Subset.map _ _ (sym!{{TargetSequence.Fifth}} _ _ (TargetSequence.restrictionFormula v))));
\definition forget: \forall (v: TargetSequence.Third) -> SourceSequence.forget (Relative.map v) = Whole.map (TargetSequence.forget v) :=
  \fun (v: TargetSequence.Third) => trans!{{SourceSequence.Fourth}} _ _ _ (SourceSequence.forgetFormula (Relative.map v))
    (trans!{{SourceSequence.Fourth}} _ _ _ (Projection.Negative[degree := degree].equation v)
      (congr!{{TargetSequence.Fourth} {SourceSequence.Fourth}} Whole.map _ _ (sym!{{TargetSequence.Fourth}} _ _ (TargetSequence.forgetFormula v))));
