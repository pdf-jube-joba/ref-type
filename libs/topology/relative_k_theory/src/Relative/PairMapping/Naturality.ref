\import SourceClosed.Pointed[a0 := From.point].Connecting[] \as SourceConnecting;
\import TargetClosed.Pointed[a0 := To.point].Connecting[] \as TargetConnecting;
\import \root.Relative[].Suspension[original := From.subsetModel] \as SourceSuspension;
\import \root.Relative[].Suspension[original := To.subsetModel] \as TargetSuspension;
\import \root.Relative[].SuspendedMap[source := From.subsetModel, target := To.subsetModel, f := subsetMap] \as Lift;
\import \root.Relative[].Pullback[source := SourceSuspension.result, target := TargetSuspension.result, f := Lift.map] \as SubsetPull;
\import \root.Relative[].Pullback[source := From.quotientModel, target := To.quotientModel, f := quotientMap] \as RelativePull;
\import \root.Relative[].Reduced[model := TargetSuspension.result] \as Source;
\definition sourceBoundary[v: \root.Relative[].Reduced[model := SourceSuspension.result].Carrier]: From.Relative := SourceConnecting.map v;
\definition targetBoundary[v: Source.Carrier]: To.Relative := TargetConnecting.map v;
\definition connecting: \forall (v: Source.Carrier) -> SourceConnecting.map (SubsetPull.map v) = RelativePull.map (TargetConnecting.map v) := Based.connectingNaturality;
\definition inclusionCommutes: \forall (x: From.subsetModel.Carrier) -> f.function (From.inclusion x) = To.inclusion (subsetMap x) :=
  \fun (x: From.subsetModel.Carrier) => \refl(f.function x);
\import \root.Relative[].Square[A := From.subsetModel, B := source.model, C := To.subsetModel, D := target.model,
  f := From.inclusion, g := f.function, h := subsetMap, k := To.inclusion, commutes := inclusionCommutes] \as Inclusion;
\import \root.Relative[].Square[A := source.model, B := From.quotientModel, C := target.model, D := To.quotientModel,
  f := From.projection, g := quotientMap, h := f.function, k := To.projection, commutes := onProjection] \as Projection;
\module Negative(degree: N.Nat^);
