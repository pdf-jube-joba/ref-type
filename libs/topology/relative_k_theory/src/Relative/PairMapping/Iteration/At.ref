\definition sourceData: ClosedPointedPair := SourceIteration.iteratePair degree source;
\definition targetData: ClosedPointedPair := TargetIteration.iteratePair degree target;
\import \root.Relative[].PointedPair[pair := sourceData] \as FromNow;
\import \root.Relative[].PointedPair[pair := targetData] \as ToNow;
\import \root.Relative[].PairMapping[source := sourceData, target := targetData, f := data degree] \as Current;
\import \root.Relative[].Composition[source := sourceData.model, middle := targetData.model, target := iterate degree target.model,
  first := (data degree).function, second := (TargetIteration.wholeComparison degree).forward] \as WholeLeft;
\import \root.Relative[].Composition[source := sourceData.model, middle := iterate degree source.model, target := iterate degree target.model,
  first := (SourceIteration.wholeComparison degree).forward, second := iterateMap degree source.model target.model f.function] \as WholeRight;
\definition wholeLeft: Map sourceData.model (iterate degree target.model) := WholeLeft.map;
\definition wholeRight: Map sourceData.model (iterate degree target.model) := WholeRight.map;
\definition WholeEquation: \Prop := wholeLeft = wholeRight;
\import \root.Relative[].Composition[source := FromNow.subsetModel, middle := ToNow.subsetModel, target := iterate degree To.subsetModel,
  first := Current.subsetMap, second := (TargetIteration.subsetComparison degree).forward] \as SubsetLeft;
\import \root.Relative[].Composition[source := FromNow.subsetModel, middle := iterate degree From.subsetModel, target := iterate degree To.subsetModel,
  first := (SourceIteration.subsetComparison degree).forward, second := iterateMap degree From.subsetModel To.subsetModel subsetMap] \as SubsetRight;
\definition subsetLeft: Map FromNow.subsetModel (iterate degree To.subsetModel) := SubsetLeft.map;
\definition subsetRight: Map FromNow.subsetModel (iterate degree To.subsetModel) := SubsetRight.map;
\definition SubsetEquation: \Prop := subsetLeft = subsetRight;
\import \root.Relative[].Composition[source := FromNow.quotientModel, middle := ToNow.quotientModel, target := iterate degree To.quotientModel,
  first := Current.quotientMap, second := (TargetIteration.quotientComparison degree).forward] \as QuotientLeft;
\import \root.Relative[].Composition[source := FromNow.quotientModel, middle := iterate degree From.quotientModel, target := iterate degree To.quotientModel,
  first := (SourceIteration.quotientComparison degree).forward, second := iterateMap degree From.quotientModel To.quotientModel quotientMap] \as QuotientRight;
\definition quotientLeft: Map FromNow.quotientModel (iterate degree To.quotientModel) := QuotientLeft.map;
\definition quotientRight: Map FromNow.quotientModel (iterate degree To.quotientModel) := QuotientRight.map;
\definition QuotientEquation: \Prop := quotientLeft = quotientRight;
