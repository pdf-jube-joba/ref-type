\import \parent.At[degree := degree] \as Now;
\import \parent.At[degree := (N.Nat^::succ degree)] \as Next;
\import \root.Relative[].PointedPair[pair := Now.sourceData] \as FromNow;
\import \root.Relative[].PointedPair[pair := Now.targetData] \as ToNow;
\import \root.Relative[].PointedPair[pair := Next.sourceData] \as FromNext;
\import \root.Relative[].PointedPair[pair := Next.targetData] \as ToNext;
\import \root.Relative[].PairMapping[source := Now.sourceData, target := Now.targetData, f := data degree] \as Current;
\import \root.Relative[].PairMapping[source := Next.sourceData, target := Next.targetData, f := data (N.Nat^::succ degree)] \as NextMap;
\definition wholePrevious: \forall (x: Now.sourceData.model.Carrier) ->
  (TargetIteration.wholeComparison degree).forward ((data degree).function x) =
  iterateMap degree source.model target.model f.function ((SourceIteration.wholeComparison degree).forward x) :=
  \fun (x: Now.sourceData.model.Carrier) => congr!{{Map Now.sourceData.model (iterate degree target.model)} {(iterate degree target.model).Carrier}}
    (\fun (m: Map Now.sourceData.model (iterate degree target.model)) => m x) Now.wholeLeft Now.wholeRight previous.whole;
\import \root.Relative[].Square[A := Now.sourceData.model, B := Now.targetData.model, C := iterate degree source.model, D := iterate degree target.model,
  f := (data degree).function, g := (TargetIteration.wholeComparison degree).forward, h := (SourceIteration.wholeComparison degree).forward,
  k := iterateMap degree source.model target.model f.function, commutes := wholePrevious] \as Whole;
\definition whole: Next.WholeEquation := \axiom:funext(Next.wholeLeft, Next.wholeRight, Whole.suspended);
\module Subsets;
\module Quotients;
\definition result: Coherence[N.Nat^::succ degree] := Coherence[N.Nat^::succ degree] {
  whole := whole, subset := Subsets[].equation, quotient := Quotients[].equation
};
