\import Bundles.Family[X := X, F := F].Of[bundle := first].PullbackComposition[
  Y := Cylinder.Carrier, Z := X, first := space, second := first.baseSpace, f := Cylinder.point, g := Cylinder.at t]
  .Of[fRegular := (Cylinder.pointContinuous first.baseSpace), gRegular := (Cylinder.atContinuous first.baseSpace t)] \as Source;
\import Bundles.Family[X := X, F := G].Of[bundle := second].PullbackComposition[
  Y := Cylinder.Carrier, Z := X, first := space, second := first.baseSpace, f := Cylinder.point, g := Cylinder.at t]
  .Of[fRegular := targetRegular, gRegular := (Cylinder.atContinuous first.baseSpace t)] \as Target;
\import Bundles.ArrowLaws[X := Cylinder.Carrier, Y := Cylinder.Carrier, F := First, G := Second,
  source := firstBundle, target := secondBundle, f := (\fun (z: Cylinder.Carrier) => z)]
  .Pullback[Z := X, space := first.baseSpace, g := Cylinder.at t].Of[a := map, regular := (Cylinder.atContinuous first.baseSpace t)] \as Pull;
\definition A[x: X]: \Set := F x;
\definition B[x: X]: \Set := G x;
\definition sourceBundle: Bundles.Family[X := X, F := A].Bundle := Source.direct;
\definition targetBundle: Bundles.Family[X := X, F := B].Bundle := Target.direct;
\import Bundles.Morphisms[X := X, Y := X, F := A, G := A, source := sourceBundle, target := Source.nested, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := B, range := Target.nested, g := (\fun (x: X) => x)] \as Start;
\definition start: Bundles.Morphisms[X := X, Y := X, F := A, G := B, source := sourceBundle, target := Target.nested, f := (\fun (x: X) => x)].Map :=
  Start.compose Source.isomorphism.forward Pull.map;
\import Bundles.Morphisms[X := X, Y := X, F := A, G := B, source := sourceBundle, target := Target.nested, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := B, range := targetBundle, g := (\fun (x: X) => x)] \as Finish;
\definition value: Bundles.Morphisms[X := X, Y := X, F := A, G := B, source := sourceBundle, target := targetBundle, f := (\fun (x: X) => x)].Map :=
  Finish.compose start Target.isomorphism.backward;
\definition formula: \forall (x: X)(v: F x) -> (value.fiber x).apply v = (map.fiber (Cylinder.at t x)).apply v :=
  \fun (x: X)(v: F x) => \refl((map.fiber (Cylinder.at t x)).apply v);
