\import algebra.Groups[].On[G := Y, group := (Alg.asGroup Y target)] \as Target;
\definition inverse: \forall (x: X) -> f (negate x) = target.base.inv (f x) :=
  \fun (x: X) => Target.inverseUnique (f x) (f (negate x))
    (trans!{Y} _ _ _ (sym!{Y} _ _ (additive x (negate x)))
      (trans!{Y} _ _ _ (congr!{X Y} f _ _ (Native.invRight x)) preservesZero));
\definition difference: \forall (x, y: X) -> f (sub x y) = target.base.op (f x) (target.base.inv (f y)) :=
  \fun (x, y: X) => trans!{Y} _ _ _ (additive x (negate y))
    (congr!{Y Y} (target.base.op (f x)) _ _ (inverse y));
