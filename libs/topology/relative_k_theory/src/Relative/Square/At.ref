\definition first: Map (iterate degree A) (iterate degree B) := \root.Relative[].iterateMap degree A B f;
\definition second: Map (iterate degree B) (iterate degree D) := \root.Relative[].iterateMap degree B D g;
\definition third: Map (iterate degree A) (iterate degree C) := \root.Relative[].iterateMap degree A C h;
\definition fourth: Map (iterate degree C) (iterate degree D) := \root.Relative[].iterateMap degree C D k;
\definition Equation: \Prop := \forall (x: (iterate degree A).Carrier) -> second (first x) = fourth (third x);
