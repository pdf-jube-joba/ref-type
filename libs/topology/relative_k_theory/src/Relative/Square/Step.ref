\import \parent.At[degree := degree] \as Before;
\import \parent.At[degree := (N.Nat^::succ degree)] \as After;
\import \root.Relative[].Square[A := iterate degree A, B := iterate degree B, C := iterate degree C, D := iterate degree D,
  f := Before.first, g := Before.second, h := Before.third, k := Before.fourth, commutes := previous] \as Square;
\definition equation: After.Equation := Square.suspended;
