\import Bundles.Family[X := X, F := F].Of[bundle := bundle].Pullback[Y := Y, source := source, f := k] \as Target;
\import Bundles.Isomorphisms[X := Y, F := (\fun (y: Y) => F (g y)), G := (\fun (y: Y) => F (k y)),
  source := First.pulled gRegular, target := Target.pulled regular] \as Maps;
\definition at[y: Y]: g y = k y := congr!{{Y -> X} X} (\fun (m: Y -> X) => m y) _ _ same;
\definition Matches[iso: Maps.Isomorphism]: \Prop := \forall (y: Y)(v: F (g y)) ->
  (iso.forward.fiber y).apply v = Transport.cast (g y) (k y) (at y) v;
\definition Values: \Set := \Cast[Maps.Isomorphism] ({ iso: Maps.Isomorphism \where Matches iso });
\import Operations.IsomorphismEquality[X := Y, F := (\fun (y: Y) => F (g y)), G := (\fun (y: Y) => F (k y)),
  source := First.pulled gRegular, target := Target.pulled regular] \as Equality;
\definition unique: \forall (a, b: Values) -> a = b := \fun (a, b: Values) => Equality.ext a b
  (\fun (y: Y)(v: F (g y)) => trans!{{F (k y)}} _ _ _ ((\bysub(Maps.Isomorphism, Values, a)) y v)
    (sym!{{F (k y)}} _ _ ((\bysub(Maps.Isomorphism, Values, b)) y v)));
