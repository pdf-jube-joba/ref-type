\structure Data: \Set := {
  forward: Map source target,
  backward: Map target source,
  leftInverse: \forall (x: source.Carrier) -> backward (forward x) = x,
  rightInverse: \forall (x: target.Carrier) -> forward (backward x) = x
};
\module With(e: Data);
\module FromMap(f: Map source target, injective: \forall (x, y: source.Carrier) -> f x = f y -> x = y,
  onto: \forall (y: target.Carrier) -> \exists (x: source.Carrier \where f x = y));
