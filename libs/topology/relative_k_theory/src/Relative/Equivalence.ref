\structure Data: \Set := {
  forward: Map source target,
  backward: Map target source,
  leftInverse: \forall (x: source.Carrier) -> backward (forward x) = x,
  rightInverse: \forall (x: target.Carrier) -> forward (backward x) = x
};
\module With(e: Data);
\definition inverse[e: Data]: \root.Relative[].Equivalence[source := target, target := source].Data :=
  \root.Relative[].Equivalence[source := target, target := source].Data {
    forward := e.backward, backward := e.forward, leftInverse := e.rightInverse, rightInverse := e.leftInverse
  };
\module FromMap(f: Map source target, injective: \forall (x, y: source.Carrier) -> f x = f y -> x = y,
  onto: \forall (y: target.Carrier) -> \exists (x: source.Carrier \where f x = y));
\module Compose(middle: CompactPointed,
  first: \root.Relative[].Equivalence[source := source, target := middle].Data,
  second: \root.Relative[].Equivalence[source := middle, target := target].Data);
