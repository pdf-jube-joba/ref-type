\import KTheory.On[X := model.Carrier, baseSpace := (details model).topology, compact := (details model).compact, hausdorff := (details model).hausdorff] \as Absolute;
\import Absolute.Ranks[].Reduced[point := (details model).point] \as Native;
\definition Carrier: \Set := Native.Carrier;
\definition group: std.Alg[].Alg[].CommutativeGroup[Carrier] := Native.group;
