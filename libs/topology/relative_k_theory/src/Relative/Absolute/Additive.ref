\import algebra.Group[].Of[Carrier := Reduced.Carrier, group := Reduced.group] \as Target;
\import algebra.Group[].Of[Carrier := Ordinary.Carrier, group := Ordinary.group] \as Source;
\definition forwardAdd: \forall (x, y: Ordinary.Carrier) -> forward (Ordinary.add x y) = Target.add (forward x) (forward y) :=
  \fun (x, y: Ordinary.Carrier) => trans!{{Reduced.Carrier}} _ _ _
    (congr!{{Triples.Carrier} {Reduced.Carrier}} (\fun (v: Triples.Carrier) => Groups.forward (Compare.isomorphism.forward v)) _ _ (Inverse.inverseAdd x y))
    (trans!{{Reduced.Carrier}} _ _ _
      (congr!{{Q.Relative} {Reduced.Carrier}} Groups.forward _ _ (Compare.isomorphism.forwardAdd (Inverse.inverse x) (Inverse.inverse y)))
      (Groups.forwardAdd (Compare.isomorphism.forward (Inverse.inverse x)) (Compare.isomorphism.forward (Inverse.inverse y))));
\definition backwardAdd: \forall (v, w: Reduced.Carrier) -> backward (Target.add v w) = Ordinary.add (backward v) (backward w) :=
  \fun (v, w: Reduced.Carrier) => trans!{{Ordinary.Carrier}} _ _ _
    (congr!{{Q.Relative} {Ordinary.Carrier}} (\fun (z: Q.Relative) => Forget.map (Compare.isomorphism.backward z)) _ _ (Groups.backwardAdd v w))
    (trans!{{Ordinary.Carrier}} _ _ _
      (congr!{{Triples.Carrier} {Ordinary.Carrier}} Forget.map _ _ (Compare.isomorphism.backwardAdd (Groups.backward v) (Groups.backward w)))
      (Forget.additive (Compare.isomorphism.backward (Groups.backward v)) (Compare.isomorphism.backward (Groups.backward w))));
\definition forwardZero: forward Ordinary.zero = Target.zero := Target.cancelRight (forward Ordinary.zero) _ _
  (trans!{{Reduced.Carrier}} _ _ _ (sym!{{Reduced.Carrier}} _ _ (forwardAdd Ordinary.zero Ordinary.zero))
    (trans!{{Reduced.Carrier}} _ _ _ (congr!{{Ordinary.Carrier} {Reduced.Carrier}} forward _ _ (Source.zeroLeft Ordinary.zero))
      (sym!{{Reduced.Carrier}} _ _ (Target.zeroLeft (forward Ordinary.zero)))));
\definition backwardZero: backward Target.zero = Ordinary.zero := Source.cancelRight (backward Target.zero) _ _
  (trans!{{Ordinary.Carrier}} _ _ _ (sym!{{Ordinary.Carrier}} _ _ (backwardAdd Target.zero Target.zero))
    (trans!{{Ordinary.Carrier}} _ _ _ (congr!{{Reduced.Carrier} {Ordinary.Carrier}} backward _ _ (Target.zeroLeft Target.zero))
      (sym!{{Ordinary.Carrier}} _ _ (Source.zeroLeft (backward Target.zero)))));
