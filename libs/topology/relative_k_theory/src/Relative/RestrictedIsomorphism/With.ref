\import Complements.PulledIsomorphism[X := A, Y := B, F := (\fun (x: A) => F x), G := (\fun (x: A) => G x), source := FirstRestriction.restricted, target := SecondRestriction.restricted,
  base := secondSpace, f := into, sourceRegular := intoRegular, targetRegular := targetIntoRegular] \as Pull;
\import Bundles.Isomorphisms[X := B, F := (\fun (x: B) => G x), G := (\fun (x: B) => G x), source := Negative.direct, target := Negative.nested] \as Reverse;
\import Operations.IsomorphismComposition[X := B, F := (\fun (x: B) => F x), G := (\fun (x: B) => F x), H := (\fun (x: B) => G x),
  source := Positive.direct, middle := Positive.nested, target := Negative.nested] \as Start;
\definition start: Start.Isomorphism := Start.compose Positive.isomorphism (Pull.isomorphism isomorphism);
\import Operations.IsomorphismComposition[X := B, F := (\fun (x: B) => F x), G := (\fun (x: B) => G x), H := (\fun (x: B) => G x),
  source := Positive.direct, middle := Negative.nested, target := Negative.direct] \as Finish;
\definition value: Bundles.Isomorphisms[X := B, F := (\fun (x: B) => F x), G := (\fun (x: B) => G x), source := firstBundle, target := secondBundle].Isomorphism :=
  Finish.compose start (Reverse.inverse Negative.isomorphism);
\definition formula: \forall (x: B)(v: F x) -> (value.forward.fiber x).apply v = (isomorphism.forward.fiber (into x)).apply v :=
  \fun (x: B)(v: F x) => \refl((isomorphism.forward.fiber (into x)).apply v);

\definition sourcePoint[x: B]: A := into x;
\definition backwardFormula: \forall (x: B)(v: G x) -> (value.backward.fiber x).apply v = (isomorphism.backward.fiber (into x)).apply v :=
  \fun (x: B)(v: G x) => \refl((isomorphism.backward.fiber (into x)).apply v);
