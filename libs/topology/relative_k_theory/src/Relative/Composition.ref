\definition map: Map source target := algebraic_topology.Pointed[A := source.Carrier].Maps[B := middle.Carrier].Composition[C := target.Carrier].compose
  (pointed source) (pointed middle) (pointed target) first second;
\module Suspended;
\definition iteratedMap[degree: N.Nat^]: Map (\root.Relative[].iterate degree source) (\root.Relative[].iterate degree target) :=
  \parent.Composition[source := \root.Relative[].iterate degree source, middle := \root.Relative[].iterate degree middle, target := \root.Relative[].iterate degree target,
    first := \root.Relative[].iterateMap degree source middle first, second := \root.Relative[].iterateMap degree middle target second].map;
\definition Iteration[degree: N.Nat^]: \Prop := \root.Relative[].iterateMap degree source target map = iteratedMap degree;
\module Iterating(degree: N.Nat^);
\definition iterateEquation[degree: N.Nat^]: Iteration degree :=
  (\induction (degree: N.Nat^) \return Iteration degree \with {
    | zero: \refl(map)
    | succ: \fun (n: N.Nat^)(previous: Iteration n) => Iterating[degree := n].step previous
  }) degree;
\module Negative(degree: N.Nat^);
