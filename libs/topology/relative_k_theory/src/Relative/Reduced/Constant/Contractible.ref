\import \parent.\parent.\parent.PullbackIdentity[model := model] \as Identical;
\import \parent.\parent.\parent.HomotopyInvariance[source := model, target := model, first := Identity.map, second := map, homotopy := homotopy] \as Homotopy;
\definition equation: \forall (v: Carrier) -> v = Group.zero := \fun (v: Carrier) => trans!{{Carrier}} _ _ _ (sym!{{Carrier}} _ _ (Identical.equation v))
  (trans!{{Carrier}} _ _ _ (Homotopy.equation v) (zero v));
