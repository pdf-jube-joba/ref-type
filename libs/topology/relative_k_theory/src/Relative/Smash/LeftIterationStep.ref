\import \root.Relative[].Smash[left := iterate degree left, right := right] \as Before;
\import \root.Relative[].Smash[left := iterate (N.Nat^::succ degree) left, right := right] \as After;
\import \root.Relative[].Suspension[original := Before.result] \as Middle;
\definition lifted: \root.Relative[].Equivalence[source := iterate (N.Nat^::succ degree) \parent.result, target := Middle.result].Data :=
  \root.Relative[].Equivalence[source := iterate degree \parent.result, target := Before.result].With[e := previous].Suspended[].result;
\definition result: \root.Relative[].Equivalence[source := iterate (N.Nat^::succ degree) \parent.result, target := After.result].Data :=
  \root.Relative[].Equivalence[source := iterate (N.Nat^::succ degree) \parent.result, target := After.result].Compose[
    middle := Middle.result, first := lifted, second := Before.Suspension[].equivalence].result;
