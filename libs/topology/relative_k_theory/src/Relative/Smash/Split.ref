\import topology.Topology[Carrier := wedgeModel.Carrier] \as WedgeSpace;
\definition subset: \Pow wedgeModel.Carrier := { w: wedgeModel.Carrier \where wedgeSecond w = (details right).point };
\definition closed: WedgeSpace.IsClosedIn (details wedgeModel).topology subset :=
  topology.Continuity[A := wedgeModel.Carrier, B := right.Carrier].closedPreimage (details wedgeModel).topology (details right).topology wedgeSecond
    (algebraic_topology.Pointed[A := wedgeModel.Carrier].Maps[B := right.Carrier].laws (pointed wedgeModel) (pointed right) wedgeSecond).continuous
    (RightSpace.Singleton (details right).point) (RightSpace.Compactness[].hausdorffT1 (details right).topology (details right).hausdorff (details right).point);
\definition data: ClosedPairDetails[wedgeModel] := ClosedPairDetails[wedgeModel] { subset := subset, closed := closed, containsPoint := \refl((details right).point) };
\definition pair: ClosedPointedPair := packPair wedgeModel data;
\import \root.Relative[].PointedPair[pair := pair] \as Native;
\import \root.Relative[].Pair[X := wedgeModel.Carrier, space := (details wedgeModel).topology, compact := (details wedgeModel).compact, hausdorff := (details wedgeModel).hausdorff,
  subset := subset, closed := closed] \as Whole;
\import Whole.Quotient[] \as Q;
\definition quotientModel: CompactPointed := Native.quotientModel;
\definition subsetModel: CompactPointed := Native.subsetModel;
\definition inclusion: Map subsetModel wedgeModel := Native.inclusion;
\definition projection: Map wedgeModel quotientModel := Native.projection;
\module QuotientEquivalence;
\module Theory(degree: N.Nat^);
