\definition source: \forall (q: Source.result.Carrier) -> \exists (r: R \where f r = q) := \block {
  \fun (q: Source.result.Carrier) \then
  \takefrom z: \Cast[SourceCylinder.Carrier] ({ z: SourceCylinder.Carrier \where Source.class z = q }) \by Source.onto q \then
  \takefrom p: \Cast[model.Carrier] ({ p: model.Carrier \where projection p = SourceCylinder.point z }) \by projectionOnto (SourceCylinder.point z) \then
  \let r: R := Domain.at (SourceCylinder.time z) p \then
  \let same: sourceRaw r = z := Pair.Prop[A := I.Carrier, B := result.Carrier].ext (sourceRaw r) z (\refl(SourceCylinder.time z))
    (\bysub(model.Carrier, { p: model.Carrier \where projection p = SourceCylinder.point z }, p)) \then
  \return Logic.existsIntro[R, { r: R \where f r = q }] r
    (trans!{{Source.result.Carrier}} _ _ _ (congr!{{SourceCylinder.Carrier} {Source.result.Carrier}} Source.class _ _ same)
      (\bysub(SourceCylinder.Carrier, { z: SourceCylinder.Carrier \where Source.class z = q }, z)))
};
\definition target: \forall (q: Target.result.Carrier) -> \exists (r: R \where g r = q) := \block {
  \fun (q: Target.result.Carrier) \then
  \takefrom p: \Cast[Target.model.Carrier] ({ p: Target.model.Carrier \where Target.projection p = q }) \by Target.projectionOnto q \then
  \takefrom z: \Cast[LeftCylinder.Carrier] ({ z: LeftCylinder.Carrier \where LeftSuspension.class z = Target.first p }) \by LeftSuspension.onto (Target.first p) \then
  \let r: R := Domain.at (LeftCylinder.time z) (Pair.pair left.Carrier right.Carrier (LeftCylinder.point z) (Target.second p)) \then
  \let leftEta: LeftCylinder.at (LeftCylinder.time z) (LeftCylinder.point z) = z := Pair.Prop[A := I.Carrier, B := left.Carrier].eta z \then
  \let same: targetRaw r = p := Pair.Prop[A := LeftSuspension.result.Carrier, B := right.Carrier].ext (targetRaw r) p
    (trans!{{LeftSuspension.result.Carrier}} _ _ _ (congr!{{LeftCylinder.Carrier} {LeftSuspension.result.Carrier}} LeftSuspension.class _ _ leftEta)
      (\bysub(LeftCylinder.Carrier, { z: LeftCylinder.Carrier \where LeftSuspension.class z = Target.first p }, z))) (\refl(Target.second p)) \then
  \return Logic.existsIntro[R, { r: R \where g r = q }] r
    (trans!{{Target.result.Carrier}} _ _ _ (congr!{{Target.model.Carrier} {Target.result.Carrier}} Target.projection _ _ same)
      (\bysub(Target.model.Carrier, { p: Target.model.Carrier \where Target.projection p = q }, p)))
};
