\definition timeRegular: topology.Continuity[A := R, B := I.Carrier].Continuous rSpace I.topology time := Domain.timeContinuous (details model).topology;
\definition baseRegular: topology.Continuity[A := R, B := model.Carrier].Continuous rSpace (details model).topology base := Domain.pointContinuous (details model).topology;
\definition aRegular: topology.Continuity[A := R, B := left.Carrier].Continuous rSpace (details left).topology a :=
  topology.Composition[A := R, B := model.Carrier, C := left.Carrier].composeContinuous rSpace (details model).topology (details left).topology
    base first baseRegular (Projections.firstContinuous (details left).topology (details right).topology);
\definition bRegular: topology.Continuity[A := R, B := right.Carrier].Continuous rSpace (details right).topology b :=
  topology.Composition[A := R, B := model.Carrier, C := right.Carrier].composeContinuous rSpace (details model).topology (details right).topology
    base second baseRegular (Projections.secondContinuous (details left).topology (details right).topology);
\definition projectionRegular: topology.Continuity[A := R, B := result.Carrier].Continuous rSpace (details result).topology (\fun (r: R) => projection (base r)) :=
  topology.Composition[A := R, B := model.Carrier, C := result.Carrier].composeContinuous rSpace (details model).topology (details result).topology
    base projection baseRegular OriginalQuotient.continuous;
\definition sourceRawRegular: topology.Continuity[A := R, B := SourceCylinder.Carrier].Continuous rSpace
  (SourceCylinder.topology (details result).topology) sourceRaw :=
  topological_constructions.Product[A := I.Carrier, B := result.Carrier].Universal[X := R].pairContinuous rSpace I.topology (details result).topology
    time (\fun (r: R) => projection (base r)) timeRegular projectionRegular;
\definition source: topology.Continuity[A := R, B := Source.result.Carrier].Continuous rSpace (details Source.result).topology f :=
  topology.Composition[A := R, B := SourceCylinder.Carrier, C := Source.result.Carrier].composeContinuous rSpace
    (SourceCylinder.topology (details result).topology) (details Source.result).topology sourceRaw Source.class sourceRawRegular Source.classContinuous;
\definition leftRaw[r: R]: LeftCylinder.Carrier := LeftCylinder.at (time r) (a r);
\definition leftRawRegular: topology.Continuity[A := R, B := LeftCylinder.Carrier].Continuous rSpace (LeftCylinder.topology (details left).topology) leftRaw :=
  topological_constructions.Product[A := I.Carrier, B := left.Carrier].Universal[X := R].pairContinuous rSpace I.topology (details left).topology time a timeRegular aRegular;
\definition leftRegular: topology.Continuity[A := R, B := LeftSuspension.result.Carrier].Continuous rSpace (details LeftSuspension.result).topology
  (\fun (r: R) => LeftSuspension.class (leftRaw r)) :=
  topology.Composition[A := R, B := LeftCylinder.Carrier, C := LeftSuspension.result.Carrier].composeContinuous rSpace
    (LeftCylinder.topology (details left).topology) (details LeftSuspension.result).topology leftRaw LeftSuspension.class leftRawRegular LeftSuspension.classContinuous;
\definition targetRawRegular: topology.Continuity[A := R, B := Target.model.Carrier].Continuous rSpace (details Target.model).topology targetRaw :=
  topological_constructions.Product[A := LeftSuspension.result.Carrier, B := right.Carrier].Universal[X := R].pairContinuous rSpace
    (details LeftSuspension.result).topology (details right).topology (\fun (r: R) => LeftSuspension.class (leftRaw r)) b leftRegular bRegular;
\definition target: topology.Continuity[A := R, B := Target.result.Carrier].Continuous rSpace (details Target.result).topology g :=
  topology.Composition[A := R, B := Target.model.Carrier, C := Target.result.Carrier].composeContinuous rSpace (details Target.model).topology
    (details Target.result).topology targetRaw Target.projection targetRawRegular TargetQuotient.continuous;
