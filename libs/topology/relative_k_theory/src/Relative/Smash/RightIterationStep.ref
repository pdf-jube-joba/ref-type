\import \root.Relative[].Smash[left := left, right := iterate degree right] \as Before;
\import \root.Relative[].Smash[left := left, right := iterate (N.Nat^::succ degree) right] \as After;
\import \root.Relative[].Suspension[original := Before.result] \as Middle;
\definition lifted: \root.Relative[].Equivalence[source := iterate (N.Nat^::succ degree) \root.Relative[].Smash[left := left, right := right].result, target := Middle.result].Data :=
  \root.Relative[].Equivalence[source := iterate degree \root.Relative[].Smash[left := left, right := right].result, target := Before.result].With[e := previous].Suspended[].result;
\definition result: \root.Relative[].Equivalence[source := iterate (N.Nat^::succ degree) \root.Relative[].Smash[left := left, right := right].result, target := After.result].Data :=
  \root.Relative[].Equivalence[source := iterate (N.Nat^::succ degree) \root.Relative[].Smash[left := left, right := right].result, target := After.result].Compose[
    middle := Middle.result, first := lifted, second := Before.RightSuspension[].equivalence].result;
