\import \root.Relative[].Suspension[original := result] \as Source;
\import \root.Relative[].Suspension[original := right] \as SuspendedRight;
\import \root.Relative[].Smash[left := right, right := left] \as Reverse;
\import \root.Relative[].Suspension[original := Reverse.result] \as SuspendedReverse;
\import \root.Relative[].Smash[left := SuspendedRight.result, right := left] \as Middle;
\import \root.Relative[].Smash[left := left, right := SuspendedRight.result] \as Target;
\definition first: \root.Relative[].Equivalence[source := Source.result, target := SuspendedReverse.result].Data :=
  \root.Relative[].Equivalence[source := result, target := Reverse.result].With[e := \parent.Symmetry[].equivalence].Suspended[].result;
\definition second: \root.Relative[].Equivalence[source := Source.result, target := Middle.result].Data :=
  \root.Relative[].Equivalence[source := Source.result, target := Middle.result].Compose[middle := SuspendedReverse.result,
    first := first, second := Reverse.Suspension[].equivalence].result;
\definition equivalence: \root.Relative[].Equivalence[source := Source.result, target := Target.result].Data :=
  \root.Relative[].Equivalence[source := Source.result, target := Target.result].Compose[middle := Middle.result,
    first := second, second := Middle.Symmetry[].equivalence].result;
