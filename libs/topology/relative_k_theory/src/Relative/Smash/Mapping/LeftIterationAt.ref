\import \root.Relative[].Smash[left := iterate degree left, right := right] \as Before;
\import \root.Relative[].Smash[left := iterate degree targetLeft, right := targetRight] \as TargetBefore;
\import Before.Mapping[targetLeft := iterate degree targetLeft, targetRight := targetRight, f := \root.Relative[].iterateMap degree left targetLeft f, g := g] \as Shifted;
\definition sourceComparison: \root.Relative[].Equivalence[source := iterate degree result, target := Before.result].Data := \parent.\parent.leftIteration degree;
\definition targetComparison: \root.Relative[].Equivalence[source := iterate degree Target.result, target := TargetBefore.result].Data := Target.leftIteration degree;
\definition function: Map (iterate degree result) (iterate degree Target.result) := \root.Relative[].iterateMap degree result Target.result map;
\definition Equation: \Prop := \forall (x: (iterate degree result).Carrier) -> targetComparison.forward (function x) = Shifted.map (sourceComparison.forward x);
