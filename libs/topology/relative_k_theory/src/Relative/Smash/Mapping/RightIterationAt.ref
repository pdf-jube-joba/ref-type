\import \root.Relative[].Smash[left := left, right := iterate degree right] \as Before;
\import \root.Relative[].Smash[left := targetLeft, right := iterate degree targetRight] \as TargetBefore;
\import Before.Mapping[targetLeft := targetLeft, targetRight := iterate degree targetRight, f := f, g := \root.Relative[].iterateMap degree right targetRight g] \as Shifted;
\definition sourceComparison: \root.Relative[].Equivalence[source := iterate degree result, target := Before.result].Data := \parent.\parent.rightIteration degree;
\definition targetComparison: \root.Relative[].Equivalence[source := iterate degree Target.result, target := TargetBefore.result].Data := Target.rightIteration degree;
\definition function: Map (iterate degree result) (iterate degree Target.result) := \root.Relative[].iterateMap degree result Target.result map;
\definition Equation: \Prop := \forall (x: (iterate degree result).Carrier) -> targetComparison.forward (function x) = Shifted.map (sourceComparison.forward x);
