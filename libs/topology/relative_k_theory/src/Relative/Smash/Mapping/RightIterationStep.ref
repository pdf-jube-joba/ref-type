\import \parent.RightIterationAt[degree := degree] \as Before;
\import \parent.RightIterationAt[degree := (N.Nat^::succ degree)] \as After;
\import \root.Relative[].Smash[left := left, right := iterate degree right] \as SourceBefore;
\import \root.Relative[].Smash[left := targetLeft, right := iterate degree targetRight] \as TargetBefore;
\import SourceBefore.Mapping[targetLeft := targetLeft, targetRight := iterate degree targetRight, f := f, g := \root.Relative[].iterateMap degree right targetRight g] \as Shifted;
\import \root.Relative[].Square[A := iterate degree result, B := iterate degree Target.result,
  C := SourceBefore.result, D := TargetBefore.result, f := Before.function, g := Before.targetComparison.forward,
  h := Before.sourceComparison.forward, k := Shifted.map, commutes := previous] \as Square;
\import \root.Relative[].SuspendedMap[source := iterate degree result, target := SourceBefore.result, f := Before.sourceComparison.forward] \as SourceLift;
\import TargetBefore.RightSuspension[] \as TargetComparison;
\import \root.Relative[].Suspension[original := TargetBefore.result] \as TargetSuspension;
\import \root.Relative[].Smash[left := targetLeft, right := iterate (N.Nat^::succ degree) targetRight] \as TargetAfter;
\definition equation: After.Equation := \fun (x: (iterate (N.Nat^::succ degree) result).Carrier) =>
  trans!{{TargetAfter.result.Carrier}} _ _ _
    (congr!{{TargetSuspension.result.Carrier} {TargetAfter.result.Carrier}} TargetComparison.equivalence.forward _ _ (Square.suspended x))
    (Shifted.RightSuspensionNaturality[].equation (SourceLift.map x));
