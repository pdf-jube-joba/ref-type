\import \root.Relative[].Reduced[model := Split.subsetModel] \as Subset;
\import \root.Relative[].Pullback[source := Split.subsetModel, target := wedgeModel, f := Split.inclusion] \as RestrictS;
\import \root.Relative[].Pullback[source := right, target := wedgeModel, f := rightInclusion] \as RestrictB;
\import Subset.Multiplication[] \as SubsetMultiplication;
\import Second.Multiplication[] \as RightMultiplication;
\import RestrictS.Multiplication[] \as SubsetProduct;
\import RestrictB.Multiplication[] \as RightProduct;
\definition onSubset: Separation.restriction (wedgeRaw a b) = Separation.subsetGroup.base.unit :=
  trans!{{Separation.SubsetCarrier}} _ _ _ (Separation.restrictionFormula (wedgeRaw a b))
    (trans!{{Separation.SubsetCarrier}} _ _ _ (SubsetProduct.equation (FirstExtend.map a) (SecondExtend.map b))
      (trans!{{Separation.SubsetCarrier}} _ _ _ (congr!{{Subset.Carrier} {Subset.Carrier}} (SubsetMultiplication.mul (RestrictS.map (FirstExtend.map a))) _ _ (Decomposition.secondOnSubset b))
        (SubsetMultiplication.zeroRight (RestrictS.map (FirstExtend.map a)))));
\definition onRight: RestrictB.map (wedgeRaw a b) = Second.group.base.unit :=
  trans!{{Second.Carrier}} _ _ _ (RightProduct.equation (FirstExtend.map a) (SecondExtend.map b))
    (trans!{{Second.Carrier}} _ _ _ (congr!{{Second.Carrier} {Second.Carrier}} (\fun (v: Second.Carrier) => RightMultiplication.mul v (RestrictB.map (SecondExtend.map b))) _ _ (Decomposition.firstOnB a))
      (RightMultiplication.zeroLeft (RestrictB.map (SecondExtend.map b))));
\definition wedgeZero: wedgeRaw a b = WedgeGroup.group.base.unit := Separation.separate (wedgeRaw a b) onSubset onRight;
\definition zero: Term.restriction (raw a b) = Term.fifthGroup.base.unit :=
  trans!{{WedgeGroup.Carrier}} _ _ _ (Term.restrictionFormula (raw a b))
    (trans!{{WedgeGroup.Carrier}} _ _ _ (wedgeFormula a b) wedgeZero);
