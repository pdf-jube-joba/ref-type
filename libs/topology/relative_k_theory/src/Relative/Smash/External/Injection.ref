\import \parent.\parent.WedgeDecomposition[degree := KTheory.one] \as Onto;
\definition kernel: \forall (q: Result.Carrier) -> forget q = ProductGroup.group.base.unit -> q = Result.group.base.unit := \block {
  \fun (q: Result.Carrier)(zero: forget q = ProductGroup.group.base.unit) \then
  \takefrom w: \Cast[Term.Second] ({ w: Term.Second \where Term.boundary w = q }) \by (Term.exactThird q).ltr zero \then
  \takefrom p: \Cast[Term.First] ({ p: Term.First \where \root.Relative[].NegativeMap[source := wedgeModel, target := model, f := wedgeInclusion, degree := KTheory.one].map p = w }) \by Onto.surjective w \then
  \let wZero: Term.boundary w = Term.thirdGroup.base.unit := (Term.exactSecond w).rtl
    (Logic.existsIntro[Term.First, { p: Term.First \where Term.restrictionNegative p = w }] p
      (trans!{{Term.Second}} _ _ _ (Term.restrictionNegativeFormula p)
        (\bysub(Term.First, { p: Term.First \where \root.Relative[].NegativeMap[source := wedgeModel, target := model, f := wedgeInclusion, degree := KTheory.one].map p = w }, p)))) \then
  \return trans!{{Result.Carrier}} _ _ _ (sym!{{Result.Carrier}} _ _ (\bysub(Term.Second, { w: Term.Second \where Term.boundary w = q }, w))) wZero
};
\import \root.Relative[].GroupCalculus[X := Result.Carrier, group := Result.group] \as Domain;
\import \root.Relative[].GroupCalculus[X := ProductGroup.Carrier, group := ProductGroup.group] \as Range;
\import Domain.Mapping[Y := ProductGroup.Carrier, target := ProductGroup.group, f := forget, additive := Term.forgetAdd, preservesZero := Term.forgetZero] \as ForgetLaws;
\definition injective: \forall (q, r: Result.Carrier) -> forget q = forget r -> q = r :=
  \fun (q, r: Result.Carrier)(same: forget q = forget r) => Domain.subEqual q r
    (kernel (Domain.sub q r) (trans!{{ProductGroup.Carrier}} _ _ _ (ForgetLaws.difference q r)
      (trans!{{ProductGroup.Carrier}} _ _ _ (congr!{{ProductGroup.Carrier} {ProductGroup.Carrier}} (\fun (v: ProductGroup.Carrier) => Range.sub v (forget r)) _ _ same)
        (Range.subSelf (forget r)))));
