\import \parent.Identity[model := model] \as Identity;
\import \parent.Pullback[source := model, target := model, f := Identity.map] \as Pull;
\import \parent.Reduced[model := model] \as Reduced;
\import KTheory.On[X := model.Carrier, baseSpace := (details model).topology, compact := (details model).compact, hausdorff := (details model).hausdorff].IdentityPullback[] \as Native;
\definition equation: \forall (x: Reduced.Carrier) -> Pull.map x = x := \fun (x: Reduced.Carrier) => Native.onK0 x;
