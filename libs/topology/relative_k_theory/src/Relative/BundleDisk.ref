\import KTheory.On[X := X, baseSpace := bundle.baseSpace, compact := compact, hausdorff := hausdorff] \as Absolute;
\import Absolute.Bundle[F := F, original := bundle, same := (\refl(bundle.baseSpace))] \as Class;
\definition Representation: \Set := Class.Representative;
\definition existence: \exists Representation := Class.representativeExists;
\module With(r: Representation);
