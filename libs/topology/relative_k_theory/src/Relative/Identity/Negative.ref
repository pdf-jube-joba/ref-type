\import \parent.\parent.NegativeMap[source := model, target := model, f := map, degree := degree] \as Pull;
\import \parent.\parent.Negative[original := model, degree := degree] \as Group;
\import \parent.\parent.PullbackIdentity[model := \root.Relative[].iterate degree model] \as Native;
\definition equation: \forall (v: Group.Carrier) -> Pull.map v = v :=
  \fun (v: Group.Carrier) => \idelim iteratedMap degree = \root.Relative[].iterateMap degree model model map
    \with f: Map (\root.Relative[].iterate degree model) (\root.Relative[].iterate degree model) =>
      \parent.\parent.Pullback[source := \root.Relative[].iterate degree model, target := \root.Relative[].iterate degree model, f := f].map v = v
    \by { base: Native.equation v, equality: sym!{{Map (\root.Relative[].iterate degree model) (\root.Relative[].iterate degree model)}} _ _ (iterateEquation degree) };
