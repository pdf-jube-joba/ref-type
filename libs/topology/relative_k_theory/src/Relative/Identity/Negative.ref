\import \parent.\parent.NegativeMap[source := model, target := model, f := map, degree := degree] \as Pull;
\import \parent.\parent.Negative[original := model, degree := degree] \as Group;
\import \parent.\parent.PullbackIdentity[model := iterate degree model] \as Native;
\definition equation: \forall (v: Group.Carrier) -> Pull.map v = v :=
  \fun (v: Group.Carrier) => \idelim iteratedMap degree = iterateMap degree model model map
    \with f: Map (iterate degree model) (iterate degree model) =>
      \parent.\parent.Pullback[source := iterate degree model, target := iterate degree model, f := f].map v = v
    \by { base: Native.equation v, equality: sym!{{Map (iterate degree model) (iterate degree model)}} _ _ (iterateEquation degree) };
