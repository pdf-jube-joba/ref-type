\import algebraic_topology.Suspension[A := model.Carrier].Pointed[source := (details model).topology, basepoint := (details model).point] \as Domain;
\import Domain.Mapping[B := model.Carrier, target := (pointed model), f := map] \as Direct;
\import algebraic_topology.Cylinder[A := model.Carrier] \as Cylinder;
\import algebraic_topology.Collapse[A := Cylinder.Carrier, subset := Domain.Collapsed] \as Quotient;
\import \parent.\parent.Suspension[original := model] \as SuspensionModel;
\import \parent.\parent.Identity[model := SuspensionModel.result] \as Identity;
\import algebraic_topology.Interval[] \as Interval;
\definition equation: \parent.\parent.SuspendedMap[source := model, target := model, f := map].map = Identity.map :=
  \axiom:funext(Direct.map, Identity.map,
    Quotient.induction (\fun (q: Domain.Carrier) => Direct.map q = q)
      (\fun (p: Cylinder.Carrier) => trans!{{Domain.Carrier}} _ _ _ (Direct.onClass p)
        (congr!{{Cylinder.Carrier} {Domain.Carrier}} Domain.class _ _ (std.Data[].Pair[].Prop[A := Interval.Carrier, B := model.Carrier].eta p))));
