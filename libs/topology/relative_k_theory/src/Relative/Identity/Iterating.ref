\definition lift[f: Map (\root.Relative[].iterate degree model) (\root.Relative[].iterate degree model)]: Map (\root.Relative[].iterate (N.Nat^::succ degree) model) (\root.Relative[].iterate (N.Nat^::succ degree) model) :=
  \parent.\parent.SuspendedMap[source := \root.Relative[].iterate degree model, target := \root.Relative[].iterate degree model, f := f].map;
\import \parent.\parent.Identity[model := \root.Relative[].iterate degree model].Suspended[] \as Compatibility;
\definition step: Iteration degree -> Iteration (N.Nat^::succ degree) := \fun (previous: Iteration degree) =>
  trans!{{Map (\root.Relative[].iterate (N.Nat^::succ degree) model) (\root.Relative[].iterate (N.Nat^::succ degree) model)}} _ _ _
    (congr!{{Map (\root.Relative[].iterate degree model) (\root.Relative[].iterate degree model)} {Map (\root.Relative[].iterate (N.Nat^::succ degree) model) (\root.Relative[].iterate (N.Nat^::succ degree) model)}} lift _ _ previous)
    Compatibility.equation;
