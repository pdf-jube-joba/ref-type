\definition lift[f: Map (iterate degree model) (iterate degree model)]: Map (iterate (N.Nat^::succ degree) model) (iterate (N.Nat^::succ degree) model) :=
  \parent.\parent.SuspendedMap[source := iterate degree model, target := iterate degree model, f := f].map;
\import \parent.\parent.Identity[model := iterate degree model].Suspended[] \as Compatibility;
\definition step: Iteration degree -> Iteration (N.Nat^::succ degree) := \fun (previous: Iteration degree) =>
  trans!{{Map (iterate (N.Nat^::succ degree) model) (iterate (N.Nat^::succ degree) model)}} _ _ _
    (congr!{{Map (iterate degree model) (iterate degree model)} {Map (iterate (N.Nat^::succ degree) model) (iterate (N.Nat^::succ degree) model)}} lift _ _ previous)
    Compatibility.equation;
