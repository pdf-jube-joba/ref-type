\import topology.Topology[Carrier := X] \as Base;
\import Base.Subspace[S := subset] \as Subspace;
\import \parent.Pair[X := X, space := bundle.baseSpace, compact := compact, hausdorff := hausdorff, subset := subset, closed := closed].Quotient[] \as Quotient;
\definition Vector: \Set := Bundles.Vector dimension;
\definition coordinates: Spaces.VectorSpace Vector := Bundles.coordinates dimension;
\import Bundles.Trivial[X := X, n := dimension, baseSpace := bundle.baseSpace] \as Trivial;
\import bundle_extension.Extension[].ComplexIsomorphisms[X := X, subset := subset, F := F, G := (\fun (x: X) => Vector), source := bundle,
  target := Trivial.bundle, same := \refl(bundle.baseSpace)] \as Extension;
\definition OnSubset: \Set := Extension.OnSubset;
\module With(comparison: OnSubset);
