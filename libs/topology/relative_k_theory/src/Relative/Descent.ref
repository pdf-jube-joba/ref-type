\import topology.Topology[Carrier := X] \as Base;
\import Base.Subspace[S := subset] \as Subspace;
\import \parent.Pair[X := X, space := bundle.baseSpace, compact := compact, hausdorff := hausdorff, subset := subset, closed := closed].Quotient[] \as Quotient;
\definition Vector: \Set := Bundles.Vector dimension;
\definition coordinates: Spaces.VectorSpace Vector := Bundles.coordinates dimension;
\import Bundles.Trivial[X := X, n := dimension, baseSpace := bundle.baseSpace] \as Trivial;
\import bundle_extension.Extension[].ComplexIsomorphisms[X := X, subset := subset, F := F, G := (\fun (x: X) => Vector), source := bundle,
  target := Trivial.bundle, same := \refl(bundle.baseSpace)] \as Extension;
\definition OnSubset: \Set := Extension.OnSubset;
\import Bundles.Family[X := X, F := F].Of[bundle := bundle].Restriction[U := subset] \as OriginalRestriction;
\import Bundles.Family[X := X, F := (\fun (x: X) => Vector)].Of[bundle := Trivial.bundle].Restriction[U := subset] \as TrivialRestriction;
\import Bundles.Isomorphisms[X := Subspace.CarrierSet, F := (\fun (x: Subspace.CarrierSet) => F x), G := (\fun (x: Subspace.CarrierSet) => Vector),
  source := OriginalRestriction.restricted, target := TrivialRestriction.restricted] \as BoundaryIsomorphism;
\module With(comparison: OnSubset);
\structure Witness[comparison: OnSubset]: \Set := {
  extension: With[comparison := comparison].Result,
  facts: With[comparison := comparison].Facts[extension]
};
\definition descend: \forall (comparison: OnSubset) -> \exists Witness[comparison] := \block {
  \fun (comparison: OnSubset) \then
  \takefrom result: With[comparison := comparison].Result \by Extension.extend comparison compact hausdorff closed \then
  \return \exact(Witness[comparison] { extension := result, facts := With[comparison := comparison].facts result }, Witness[comparison])
};
