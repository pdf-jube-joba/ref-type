\import \parent.Composition[source := source, middle := middle, target := target, first := first, second := second] \as Composite;
\import \parent.Pullback[source := source, target := target, f := Composite.map] \as Direct;
\import \parent.Pullback[source := source, target := middle, f := first] \as First;
\import \parent.Pullback[source := middle, target := target, f := second] \as Second;
\import \parent.Reduced[model := target] \as Reduced;
\import algebraic_topology.Pointed[A := source.Carrier].Maps[B := middle.Carrier] \as FirstMaps;
\import algebraic_topology.Pointed[A := middle.Carrier].Maps[B := target.Carrier] \as SecondMaps;
\import KTheory.On[X := target.Carrier, baseSpace := (details target).topology, compact := (details target).compact, hausdorff := (details target).hausdorff].Pullback[
  Y := middle.Carrier, space := (details middle).topology, sourceCompact := (details middle).compact, sourceHausdorff := (details middle).hausdorff,
  f := second, regular := (SecondMaps.laws (pointed middle) (pointed target) second).continuous].Composition[
  Z := source.Carrier, nextSpace := (details source).topology, nextCompact := (details source).compact, nextHausdorff := (details source).hausdorff,
  g := first, nextRegular := (FirstMaps.laws (pointed source) (pointed middle) first).continuous] \as Native;
\definition equation: \forall (x: Reduced.Carrier) -> Direct.map x = First.map (Second.map x) := \fun (x: Reduced.Carrier) => Native.onK0 x;
