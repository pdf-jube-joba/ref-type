\import N.Basic[].Def[] \as Nat;
\definition comparison[outer: N.Nat^]: \root.Relative[].Equivalence[source := iterate (Nat.add inner outer) original, target := iterate outer (iterate inner original)].Data :=
  (\induction (outer: N.Nat^) \return \root.Relative[].Equivalence[source := iterate (Nat.add inner outer) original, target := iterate outer (iterate inner original)].Data \with {
    | zero: \root.Relative[].Identity[model := iterate inner original].equivalence
    | succ: \fun (n: N.Nat^)(previous: \root.Relative[].Equivalence[source := iterate (Nat.add inner n) original, target := iterate n (iterate inner original)].Data) =>
      \root.Relative[].Equivalence[source := iterate (Nat.add inner n) original, target := iterate n (iterate inner original)].With[e := previous].Suspended[].result
  }) outer;
\module Mapping(target: CompactPointed, f: Map original target);
