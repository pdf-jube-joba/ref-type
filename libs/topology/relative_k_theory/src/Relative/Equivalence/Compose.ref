\import \root.Relative[].Composition[source := source, middle := middle, target := target, first := first.forward, second := second.forward] \as Forward;
\import \root.Relative[].Composition[source := target, middle := middle, target := source, first := second.backward, second := first.backward] \as Backward;
\definition leftInverse: \forall (x: source.Carrier) -> Backward.map (Forward.map x) = x :=
  \fun (x: source.Carrier) => trans!{{source.Carrier}} _ _ _
    (congr!{{middle.Carrier} {source.Carrier}} first.backward _ _ (second.leftInverse (first.forward x))) (first.leftInverse x);
\definition rightInverse: \forall (x: target.Carrier) -> Forward.map (Backward.map x) = x :=
  \fun (x: target.Carrier) => trans!{{target.Carrier}} _ _ _
    (congr!{{middle.Carrier} {target.Carrier}} second.forward _ _ (first.rightInverse (second.backward x))) (second.rightInverse x);
\definition result: Data := Data { forward := Forward.map, backward := Backward.map, leftInverse := leftInverse, rightInverse := rightInverse };
