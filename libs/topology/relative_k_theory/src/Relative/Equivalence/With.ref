\module Groups;
\module Suspended;
\definition iterate[degree: N.Nat^]: \root.Relative[].Equivalence[source := \root.Relative[].iterate degree source, target := \root.Relative[].iterate degree target].Data :=
  (\induction (degree: N.Nat^) \return \root.Relative[].Equivalence[source := \root.Relative[].iterate degree source, target := \root.Relative[].iterate degree target].Data \with {
    | zero: e
    | succ: \fun (n: N.Nat^)(previous: \root.Relative[].Equivalence[source := \root.Relative[].iterate n source, target := \root.Relative[].iterate n target].Data) =>
      \root.Relative[].Equivalence[source := \root.Relative[].iterate n source, target := \root.Relative[].iterate n target].With[e := previous].Suspended[].result
  }) degree;
\definition forwardAt[degree: N.Nat^]: (iterate degree).forward = \root.Relative[].iterateMap degree source target e.forward :=
  (\induction (degree: N.Nat^) \return (iterate degree).forward = \root.Relative[].iterateMap degree source target e.forward \with {
    | zero: \refl(e.forward)
    | succ: \fun (n: N.Nat^)(previous: (iterate n).forward = \root.Relative[].iterateMap n source target e.forward) =>
      \idelim (iterate n).forward = \root.Relative[].iterateMap n source target e.forward
        \with f: Map (\root.Relative[].iterate n source) (\root.Relative[].iterate n target) =>
          \root.Relative[].SuspendedMap[source := \root.Relative[].iterate n source, target := \root.Relative[].iterate n target, f := (iterate n).forward].map =
          \root.Relative[].SuspendedMap[source := \root.Relative[].iterate n source, target := \root.Relative[].iterate n target, f := f].map \by {
            base: \refl(\root.Relative[].SuspendedMap[source := \root.Relative[].iterate n source, target := \root.Relative[].iterate n target, f := (iterate n).forward].map),
            equality: previous }
  }) degree;

\definition backwardAt[degree: N.Nat^]: (iterate degree).backward = \root.Relative[].iterateMap degree target source e.backward :=
  (\induction (degree: N.Nat^) \return (iterate degree).backward = \root.Relative[].iterateMap degree target source e.backward \with {
    | zero: \refl(e.backward)
    | succ: \fun (n: N.Nat^)(previous: (iterate n).backward = \root.Relative[].iterateMap n target source e.backward) =>
      \idelim (iterate n).backward = \root.Relative[].iterateMap n target source e.backward
        \with f: Map (\root.Relative[].iterate n target) (\root.Relative[].iterate n source) =>
          \root.Relative[].SuspendedMap[source := \root.Relative[].iterate n target, target := \root.Relative[].iterate n source, f := (iterate n).backward].map =
          \root.Relative[].SuspendedMap[source := \root.Relative[].iterate n target, target := \root.Relative[].iterate n source, f := f].map \by {
            base: \refl(\root.Relative[].SuspendedMap[source := \root.Relative[].iterate n target, target := \root.Relative[].iterate n source, f := (iterate n).backward].map),
            equality: previous }
  }) degree;
\module Negative(degree: N.Nat^);
