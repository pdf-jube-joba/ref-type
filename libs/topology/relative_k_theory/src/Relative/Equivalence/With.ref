\module Groups;
\module Suspended;
\definition iterate[degree: N.Nat^]: \root.Relative[].Equivalence[source := \root.Relative[].iterate degree source, target := \root.Relative[].iterate degree target].Data :=
  (\induction (degree: N.Nat^) \return \root.Relative[].Equivalence[source := \root.Relative[].iterate degree source, target := \root.Relative[].iterate degree target].Data \with {
    | zero: e
    | succ: \fun (n: N.Nat^)(previous: \root.Relative[].Equivalence[source := \root.Relative[].iterate n source, target := \root.Relative[].iterate n target].Data) =>
      \root.Relative[].Equivalence[source := \root.Relative[].iterate n source, target := \root.Relative[].iterate n target].With[e := previous].Suspended[].result
  }) degree;
\module Negative(degree: N.Nat^);
