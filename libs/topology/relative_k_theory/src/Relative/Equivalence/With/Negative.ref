\import \root.Relative[].Equivalence[source := \root.Relative[].iterate degree source, target := \root.Relative[].iterate degree target].With[e := iterate degree].Groups[] \as Groups;
\definition forward: \root.Relative[].Negative[original := target, degree := degree].Carrier -> \root.Relative[].Negative[original := source, degree := degree].Carrier := Groups.forward;
\definition backward: \root.Relative[].Negative[original := source, degree := degree].Carrier -> \root.Relative[].Negative[original := target, degree := degree].Carrier := Groups.backward;
\definition leftInverse: \forall (x: \root.Relative[].Negative[original := source, degree := degree].Carrier) -> forward (backward x) = x := Groups.leftInverse;
\definition rightInverse: \forall (x: \root.Relative[].Negative[original := target, degree := degree].Carrier) -> backward (forward x) = x := Groups.rightInverse;

\import \root.Relative[].Negative[original := source, degree := degree] \as Source;
\import \root.Relative[].Negative[original := target, degree := degree] \as Target;
\definition additive: \forall (x, y: Target.Carrier) -> forward (Target.group.base.op x y) = Source.group.base.op (forward x) (forward y) := Groups.additive;
\definition inverseAdditive: \forall (x, y: Source.Carrier) -> backward (Source.group.base.op x y) = Target.group.base.op (backward x) (backward y) := Groups.inverseAdditive;
