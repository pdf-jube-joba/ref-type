\definition equation: \forall (q: Source.Native.Carrier) -> Backward.map (Forward.map q) = q :=
  Source.Native.Quotient.induction (\fun (q: Source.Native.Carrier) => Backward.map (Forward.map q) = q)
    (\fun (p: Source.Cylinder.Carrier) => trans!{{Source.Native.Carrier}} _ _ _
      (congr!{{Target.Native.Carrier} {Source.Native.Carrier}} Backward.map _ _ (Forward.Native.onClass p))
      (trans!{{Source.Native.Carrier}} _ _ _ (Backward.Native.onClass (Forward.Native.raw p))
        (congr!{{Source.Cylinder.Carrier} {Source.Native.Carrier}} Source.Native.class _ _
          (trans!{{Source.Cylinder.Carrier}} _ _ _
            (congr!{{source.Carrier} {Source.Cylinder.Carrier}} (Source.Cylinder.at (Source.Cylinder.time p)) _ _ (e.leftInverse (Source.Cylinder.point p)))
            (std.Data[].Pair[].Prop[A := algebraic_topology.Interval[].Carrier, B := source.Carrier].eta p)))));
