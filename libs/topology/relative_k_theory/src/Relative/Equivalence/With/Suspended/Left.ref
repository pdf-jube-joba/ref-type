\definition equation: \forall (q: SourceModel.Carrier) -> Backward.map (Forward.map q) = q :=
  SourceQuotient.induction (\fun (q: SourceModel.Carrier) => Backward.map (Forward.map q) = q)
    (\fun (p: SourceCylinder.Carrier) => trans!{{SourceModel.Carrier}} _ _ _
      (congr!{{TargetModel.Carrier} {SourceModel.Carrier}} Backward.map _ _ (ForwardModel.onClass p))
      (trans!{{SourceModel.Carrier}} _ _ _ (BackwardModel.onClass (ForwardModel.raw p))
        (congr!{{SourceCylinder.Carrier} {SourceModel.Carrier}} SourceModel.class _ _
          (trans!{{SourceCylinder.Carrier}} _ _ _
            (congr!{{source.Carrier} {SourceCylinder.Carrier}} (SourceCylinder.at (SourceCylinder.time p)) _ _ (e.leftInverse (SourceCylinder.point p)))
            (std.Data[].Pair[].Prop[A := algebraic_topology.Interval[].Carrier, B := source.Carrier].eta p)))));
