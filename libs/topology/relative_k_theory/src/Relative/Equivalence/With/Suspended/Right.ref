\definition equation: \forall (q: Target.Native.Carrier) -> Forward.map (Backward.map q) = q :=
  Target.Native.Quotient.induction (\fun (q: Target.Native.Carrier) => Forward.map (Backward.map q) = q)
    (\fun (p: Target.Cylinder.Carrier) => trans!{{Target.Native.Carrier}} _ _ _
      (congr!{{Source.Native.Carrier} {Target.Native.Carrier}} Forward.map _ _ (Backward.Native.onClass p))
      (trans!{{Target.Native.Carrier}} _ _ _ (Forward.Native.onClass (Backward.Native.raw p))
        (congr!{{Target.Cylinder.Carrier} {Target.Native.Carrier}} Target.Native.class _ _
          (trans!{{Target.Cylinder.Carrier}} _ _ _
            (congr!{{target.Carrier} {Target.Cylinder.Carrier}} (Target.Cylinder.at (Target.Cylinder.time p)) _ _ (e.rightInverse (Target.Cylinder.point p)))
            (std.Data[].Pair[].Prop[A := algebraic_topology.Interval[].Carrier, B := target.Carrier].eta p)))));
