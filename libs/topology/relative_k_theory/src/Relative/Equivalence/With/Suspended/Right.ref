\definition equation: \forall (q: TargetModel.Carrier) -> Forward.map (Backward.map q) = q :=
  TargetQuotient.induction (\fun (q: TargetModel.Carrier) => Forward.map (Backward.map q) = q)
    (\fun (p: TargetCylinder.Carrier) => trans!{{TargetModel.Carrier}} _ _ _
      (congr!{{SourceModel.Carrier} {TargetModel.Carrier}} Forward.map _ _ (BackwardModel.onClass p))
      (trans!{{TargetModel.Carrier}} _ _ _ (ForwardModel.onClass (BackwardModel.raw p))
        (congr!{{TargetCylinder.Carrier} {TargetModel.Carrier}} TargetModel.class _ _
          (trans!{{TargetCylinder.Carrier}} _ _ _
            (congr!{{target.Carrier} {TargetCylinder.Carrier}} (TargetCylinder.at (TargetCylinder.time p)) _ _ (e.rightInverse (TargetCylinder.point p)))
            (std.Data[].Pair[].Prop[A := algebraic_topology.Interval[].Carrier, B := target.Carrier].eta p)))));
