\import \root.Relative[].Suspension[original := source] \as Source;
\import \root.Relative[].Suspension[original := target] \as Target;
\import \root.Relative[].SuspendedMap[source := source, target := target, f := e.forward] \as Forward;
\import \root.Relative[].SuspendedMap[source := target, target := source, f := e.backward] \as Backward;
\module Left;
\module Right;
\definition result: \root.Relative[].Equivalence[source := Source.result, target := Target.result].Data :=
  \root.Relative[].Equivalence[source := Source.result, target := Target.result].Data {
    forward := Forward.map, backward := Backward.map, leftInverse := Left[].equation, rightInverse := Right[].equation
  };
