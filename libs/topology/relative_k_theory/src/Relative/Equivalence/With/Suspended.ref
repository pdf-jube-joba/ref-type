\import algebraic_topology.Cylinder[A := source.Carrier] \as SourceCylinder;
\import algebraic_topology.Cylinder[A := target.Carrier] \as TargetCylinder;
\import algebraic_topology.Suspension[A := source.Carrier].Pointed[source := (details source).topology, basepoint := (details source).point] \as SourceModel;
\import algebraic_topology.Suspension[A := target.Carrier].Pointed[source := (details target).topology, basepoint := (details target).point] \as TargetModel;
\import algebraic_topology.Collapse[A := SourceCylinder.Carrier, subset := SourceModel.Collapsed] \as SourceQuotient;
\import algebraic_topology.Collapse[A := TargetCylinder.Carrier, subset := TargetModel.Collapsed] \as TargetQuotient;
\import SourceModel.Mapping[B := target.Carrier, target := pointed target, f := e.forward] \as ForwardModel;
\import TargetModel.Mapping[B := source.Carrier, target := pointed source, f := e.backward] \as BackwardModel;
\import \root.Relative[].Suspension[original := source] \as Source;
\import \root.Relative[].Suspension[original := target] \as Target;
\import \root.Relative[].SuspendedMap[source := source, target := target, f := e.forward] \as Forward;
\import \root.Relative[].SuspendedMap[source := target, target := source, f := e.backward] \as Backward;
\module Left;
\module Right;
\definition result: \root.Relative[].Equivalence[source := Source.result, target := Target.result].Data :=
  \root.Relative[].Equivalence[source := Source.result, target := Target.result].Data {
    forward := Forward.map, backward := Backward.map, leftInverse := Left[].equation, rightInverse := Right[].equation
  };
