\module At(q: Quotient.Carrier);
\definition Fiber[q: Quotient.Carrier]: \Set := At[q := q].Carrier;
\definition fiberSpace[q: Quotient.Carrier]: Spaces.VectorSpace (Fiber q) := At[q := q].space;
\definition atBase: Spaces.Isomorphism[V := Fiber Quotient.point, W := Vector, source := fiberSpace Quotient.point, target := coordinates].Isomorphism :=
  At[q := Quotient.point].Base[same := \refl(Quotient.point)].isomorphism;
\definition Result: \Set := Extension.Result[comparison];
\module Neighborhood(extension: Extension.Result[comparison]);
\module Construction(extension: Extension.Result[comparison]);
\structure Facts[result: Result]: \Prop := {
  sameBase: Construction[extension := result].bundleOnQuotient.baseSpace = Quotient.topology,
  rank: Bundles.Family[X := Quotient.Carrier, F := Fiber].Of[bundle := Construction[extension := result].bundleOnQuotient].rank Quotient.point = dimension,
  comparisonExists: \exists Construction[extension := result].Compare[].Isomorphism
};
\definition facts: \forall (result: Result) -> Facts[result] := \fun (result: Result) => Facts[result] {
  sameBase := Construction[extension := result].sameBaseSpace,
  rank := Construction[extension := result].rankAtPoint,
  comparisonExists := \exact(Construction[extension := result].Compare[].isomorphism, Construction[extension := result].Compare[].Isomorphism)
};
