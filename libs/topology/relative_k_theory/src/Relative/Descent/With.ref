\module At(q: Quotient.Carrier);
\definition Fiber[q: Quotient.Carrier]: \Set := At[q := q].Carrier;
\definition fiberSpace[q: Quotient.Carrier]: Spaces.VectorSpace (Fiber q) := At[q := q].space;
\definition atBase: Spaces.Isomorphism[V := Fiber Quotient.point, W := Vector, source := fiberSpace Quotient.point, target := coordinates].Isomorphism :=
  At[q := Quotient.point].Base[same := \refl(Quotient.point)].isomorphism;
\module Neighborhood(extension: Extension.Result[comparison]);
\module Construction(extension: Extension.Result[comparison]);
