\definition lift[y: Y]: LocalSource.Point := LocalSource.include (base y) (v y);
\definition liftContinuous: topology.Continuity[A := Y, B := LocalSource.Point].Continuous source first.totalSpace lift :=
  Source.Universal[Z := Y].continuous source lift regularBase regular;
\definition image[y: Y]: LocalTarget.Point := Forward.total extension.isomorphism.forward (lift y);
\definition imageContinuous: topology.Continuity[A := Y, B := LocalTarget.Point].Continuous source second.totalSpace image :=
  topology.Composition[A := Y, B := LocalSource.Point, C := LocalTarget.Point].composeContinuous source first.totalSpace second.totalSpace lift (Forward.total extension.isomorphism.forward)
    liftContinuous (Forward.continuous extension.isomorphism.forward);
\definition global[y: Y]: TrivialFamily.Point := Target.map (image y);
\definition globalContinuous: topology.Continuity[A := Y, B := TrivialFamily.Point].Continuous source Trivial.bundle.totalSpace global :=
  topology.Composition[A := Y, B := LocalTarget.Point, C := TrivialFamily.Point].composeContinuous source second.totalSpace Trivial.bundle.totalSpace image Target.map imageContinuous Target.mapContinuous;
\definition coordinate[y: Y]: Vector := (extension.isomorphism.forward.fiber (base y)).apply (v y);
\definition continuous: topology.Continuity[A := Y, B := Vector].Continuous source (Bundles.coordinateTopology dimension) coordinate :=
  topology.Composition[A := Y, B := TrivialFamily.Point, C := Vector].composeContinuous source Trivial.bundle.totalSpace (Bundles.coordinateTopology dimension) global
    (\fun (p: TrivialFamily.Point) => p.vector) globalContinuous Trivial.vectorContinuous;
