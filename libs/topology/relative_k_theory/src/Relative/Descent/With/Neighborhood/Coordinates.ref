\import topology.Topology[Carrier := X].Subspace[S := extension.domain] \as Subspace;
\definition U: \Set := Subspace.CarrierSet;
\definition topology: topology.Topology[Carrier := U].Topology := Subspace.topology bundle.baseSpace;
\definition inclusion[x: U]: X := x;
\definition inclusionContinuous: topology.Continuity[A := U, B := X].Continuous topology bundle.baseSpace inclusion :=
  topology.Continuity[A := U, B := X].Corestriction[S := extension.domain].inclusionContinuous bundle.baseSpace;
\import Bundles.Family[X := X, F := F] \as Original;
\import Original.Of[bundle := bundle].Pullback[Y := U, source := topology, f := inclusion] \as Source;
\import Bundles.Family[X := X, F := (\fun (x: X) => Vector)] \as TrivialFamily;
\import TrivialFamily.Of[bundle := Trivial.bundle].Pullback[Y := U, source := topology, f := inclusion] \as Target;
\import Bundles.Family[X := U, F := (\fun (x: U) => F x)] \as LocalSource;
\import Bundles.Family[X := U, F := (\fun (x: U) => Vector)] \as LocalTarget;
\definition first: LocalSource.Bundle := Source.pulled inclusionContinuous;
\definition second: LocalTarget.Bundle := Target.pulled inclusionContinuous;
\import Bundles.Morphisms[X := U, Y := U, F := (\fun (x: U) => F x), G := (\fun (x: U) => Vector), source := first, target := second, f := (\fun (x: U) => x)] \as Forward;
\import Bundles.Morphisms[X := U, Y := U, F := (\fun (x: U) => Vector), G := (\fun (x: U) => F x), source := second, target := first, f := (\fun (x: U) => x)] \as Backward;
\module Read(v: \forall (y: Y) -> F (base y), regular: topology.Continuity[A := Y, B := Original.Point].Continuous source bundle.totalSpace (\fun (y: Y) => Original.include (base y) (v y)));
\module Write(w: Y -> Vector, regular: topology.Continuity[A := Y, B := Vector].Continuous source (Bundles.coordinateTopology dimension) w);
