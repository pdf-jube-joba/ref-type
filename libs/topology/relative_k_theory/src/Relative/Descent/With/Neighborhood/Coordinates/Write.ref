\import topological_constructions.Product[A := X, B := Vector].Universal[X := Y] \as Product;
\definition originalBaseContinuous: topology.Continuity[A := Y, B := X].Continuous source bundle.baseSpace (\fun (y: Y) => base y) :=
  topology.Composition[A := Y, B := U, C := X].composeContinuous source topology bundle.baseSpace base inclusion regularBase inclusionContinuous;
\definition parameter[y: Y]: topological_constructions.Product[A := X, B := Vector].CarrierSet := std.Data[].Pair[].pair X Vector (base y) (w y);
\definition parameterContinuous: topology.Continuity[A := Y, B := topological_constructions.Product[A := X, B := Vector].CarrierSet].Continuous source
  (topological_constructions.Product[A := X, B := Vector].topology bundle.baseSpace (Bundles.coordinateTopology dimension)) parameter :=
  Product.pairContinuous source bundle.baseSpace (Bundles.coordinateTopology dimension) (\fun (y: Y) => base y) w originalBaseContinuous regular;
\definition global[y: Y]: TrivialFamily.Point := TrivialFamily.include (base y) (w y);
\definition globalContinuous: topology.Continuity[A := Y, B := TrivialFamily.Point].Continuous source Trivial.bundle.totalSpace global :=
  topology.Composition[A := Y, B := topological_constructions.Product[A := X, B := Vector].CarrierSet, C := TrivialFamily.Point].composeContinuous
    source (topological_constructions.Product[A := X, B := Vector].topology bundle.baseSpace (Bundles.coordinateTopology dimension)) Trivial.bundle.totalSpace parameter Trivial.backward
    parameterContinuous Trivial.backwardContinuous;
\definition lift[y: Y]: LocalTarget.Point := LocalTarget.include (base y) (w y);
\definition liftContinuous: topology.Continuity[A := Y, B := LocalTarget.Point].Continuous source second.totalSpace lift :=
  Target.Universal[Z := Y].continuous source lift regularBase globalContinuous;
\definition image[y: Y]: LocalSource.Point := Backward.total extension.isomorphism.backward (lift y);
\definition imageContinuous: topology.Continuity[A := Y, B := LocalSource.Point].Continuous source first.totalSpace image :=
  topology.Composition[A := Y, B := LocalTarget.Point, C := LocalSource.Point].composeContinuous source second.totalSpace first.totalSpace lift (Backward.total extension.isomorphism.backward)
    liftContinuous (Backward.continuous extension.isomorphism.backward);
\definition point[y: Y]: Original.Point := Source.map (image y);
\definition continuous: topology.Continuity[A := Y, B := Original.Point].Continuous source bundle.totalSpace point :=
  topology.Composition[A := Y, B := LocalSource.Point, C := Original.Point].composeContinuous source first.totalSpace bundle.totalSpace image Source.map imageContinuous Source.mapContinuous;
