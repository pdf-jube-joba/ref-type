\import \parent.\parent.At[x := p.base, i := i, contains := (\bysub(Source.Point, domain, p))] \as Data;
\definition sourceBase: \Cast[X] (sourceChart i).domain := Data.sourceBase;
\definition quotientBase: \Cast[Quotient.Carrier] (quotientDomain i) := Data.quotientBase;
\definition formula: ((sourceChart i).frame sourceBase).backward.apply ((frame i quotientBase).forward.apply p.vector) = (evaluation p.base).apply p.vector := Data.forwardFormula p.vector;
