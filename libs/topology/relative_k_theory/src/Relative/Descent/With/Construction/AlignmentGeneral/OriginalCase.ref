\import \parent.\parent.OriginalChart[c := c] \as Chart;
\definition covered: Chart.Point := \into[Quotient.Carrier](q, Chart.domain) \by { contains };
\definition point: Model.Index := \into[X](Chart.base covered, { x: X \where Quotient.projection x = q }) \by { Exterior.inverseProjection (Chart.exterior covered) };
\definition original: Agreement[Sum.Sum[Quotient.Point, OriginalCharts.Chart]::inr c, contains, point] :=
  Agreement[Sum.Sum[Quotient.Point, OriginalCharts.Chart]::inr c, contains, point] {
    inside := Chart.member covered,
    reading := \fun (v: Model.Carrier) => \refl((c.frame (Chart.base covered)).forward.apply (Model.section v point)),
    writing := \fun (w: Bundles.Vector c.dimension) =>
      Model.Outside[different := (\bysub(Quotient.Carrier, Base.Complement (Base.Singleton Quotient.point), Chart.exterior covered))].AtIndex[index := point].rightInverse
        ((c.frame (Chart.base covered)).backward.apply w)
  };
\definition transfer: \forall (x: Model.Index) -> Agreement[Sum.Sum[Quotient.Point, OriginalCharts.Chart]::inr c, contains, x] :=
  \fun (x: Model.Index) => \idelim point = x \with y: Model.Index => Agreement[Sum.Sum[Quotient.Point, OriginalCharts.Chart]::inr c, contains, y] \by {
    base: original,
    equality: Model.Outside[different := (\bysub(Quotient.Carrier, Base.Complement (Base.Singleton Quotient.point), Chart.exterior covered))].unique point x
  };
