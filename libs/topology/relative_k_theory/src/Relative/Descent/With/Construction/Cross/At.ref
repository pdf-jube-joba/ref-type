\import \parent.\parent.Alignment[q := exterior p] \as Alignment;
\definition left: Alignment.Agreement[i, leftContains p] := Alignment.agreement i (leftContains p);
\definition right: Alignment.Agreement[j, rightContains p] := Alignment.agreement j (rightContains p);
\definition leftBase: \Cast[X] (sourceChart i).domain := \into[X](original p, (sourceChart i).domain) \by { left.inside };
\definition rightBase: \Cast[X] (sourceChart j).domain := \into[X](original p, (sourceChart j).domain) \by { right.inside };
\definition coordinates: ((frame i (\into[Quotient.Carrier](quotientBase p, domain i) \by { leftContains p })).forward.apply
  ((frame j (\into[Quotient.Carrier](quotientBase p, domain j) \by { rightContains p })).backward.apply (Right.vector p))) =
  ((sourceChart i).frame leftBase).forward.apply (((sourceChart j).frame rightBase).backward.apply (Right.vector p)) :=
  trans!{{Bundles.Vector (sourceChart i).dimension}} _ _ _
    (left.reading ((frame j (\into[Quotient.Carrier](quotientBase p, domain j) \by { rightContains p })).backward.apply (Right.vector p)))
    (congr!{{F (original p)} {Bundles.Vector (sourceChart i).dimension}} ((sourceChart i).frame leftBase).forward.apply _ _ (right.writing (Right.vector p)));
\definition equation: Overlap.change p = std.Data[].Pair[].pair (\Cast[Quotient.Carrier] (domain i)) (Bundles.Vector (sourceChart i).dimension)
  (\into[Quotient.Carrier](quotientBase p, domain i) \by { leftContains p })
  (((sourceChart i).frame leftBase).forward.apply (((sourceChart j).frame rightBase).backward.apply (Right.vector p))) :=
  std.Data[].Pair[].Prop[A := \Cast[Quotient.Carrier] (domain i), B := Bundles.Vector (sourceChart i).dimension].ext _ _ (\refl(quotientBase p)) coordinates;
