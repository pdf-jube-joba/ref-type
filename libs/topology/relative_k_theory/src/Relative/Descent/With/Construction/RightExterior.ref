\definition right: Index := Sum.Sum[Quotient.Point, OriginalCharts.Chart]::inr c;
\import Glued.Overlap[i := i, j := right] \as Overlap;
\import Atlas.In[c := chart right] \as Right;
\definition outside: \forall (p: Overlap.Point) -> Logic.Not (Right.base p = Quotient.point) :=
  \fun (p: Overlap.Point) => \bysub(Quotient.Carrier, Base.Complement (Base.Singleton Quotient.point), \parent.OriginalChart[c := c].exterior (Right.base p));
\definition regular: Overlap.Regular := \parent.Cross[i := i, j := right, outside := outside].regular;
