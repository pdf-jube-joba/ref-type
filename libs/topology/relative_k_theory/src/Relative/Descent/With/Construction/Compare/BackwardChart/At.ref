\import \parent.\parent.At[x := p.base, i := i, contains := (\bysub(Original.Point, domain, p))] \as Data;
\definition sourceBase: \Cast[X] (sourceChart i).domain := Data.sourceBase;
\definition quotientBase: \Cast[Quotient.Carrier] (quotientDomain i) := Data.quotientBase;
\definition formula: (inverse p.base).apply p.vector = (frame i quotientBase).backward.apply (((sourceChart i).frame sourceBase).forward.apply p.vector) := Data.inverseFormula p.vector;
