\definition first: Index := Sum.Sum[Quotient.Point, OriginalCharts.Chart]::inl left;
\definition second: Index := Sum.Sum[Quotient.Point, OriginalCharts.Chart]::inl right;
\import Glued.Overlap[i := first, j := second] \as Overlap;
\import Atlas.In[c := chart first] \as Left;
\import Atlas.In[c := chart second] \as Right;
\definition identity[p: Overlap.Point]: Left.Parameter := p;
\definition continuous: topology.Continuity[A := Overlap.Point, B := Left.Parameter].Continuous
  (topology.Topology[Carrier := Right.Parameter].Subspace[S := Overlap.Domain].topology Right.topology) Left.topology identity :=
  topology.Continuity[A := Overlap.Point, B := Right.Parameter].Corestriction[S := Overlap.Domain].inclusionContinuous Right.topology;
\definition equal: Overlap.change = identity := \axiom:funext(Overlap.change, identity, \fun (p: Overlap.Point) =>
  std.Data[].Pair[].Prop[A := Near.Point, B := Vector].ext (Overlap.change p) p (\refl(Right.base p))
    (Near.At[q := Right.base p].rightInverse (Right.vector p)));
\definition regular: Overlap.Regular := \idelim identity = Overlap.change \with f: (Overlap.Point -> Left.Parameter) =>
  topology.Continuity[A := Overlap.Point, B := Left.Parameter].Continuous (topology.Topology[Carrier := Right.Parameter].Subspace[S := Overlap.Domain].topology Right.topology) Left.topology f
    \by { base: continuous, equality: sym!{{Overlap.Point -> Left.Parameter}} _ _ equal };
