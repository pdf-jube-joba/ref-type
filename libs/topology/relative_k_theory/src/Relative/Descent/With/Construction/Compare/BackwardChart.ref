\import topology.Topology[Carrier := Original.Point] \as Total;
\definition domain: \Pow Original.Point := { p: Original.Point \where Base.Member (quotientDomain i) (Quotient.projection p.base) };
\import Total.Subspace[S := domain] \as Subspace;
\definition Point: \Set := Subspace.CarrierSet;
\definition topology: topology.Topology[Carrier := Point].Topology := Subspace.topology bundle.totalSpace;
\definition base[p: Point]: X := p.base;
\definition baseContinuous: topology.Continuity[A := Point, B := X].Continuous topology bundle.baseSpace base :=
  topology.Continuity[A := Original.Point, B := X].Restriction[S := domain].restrictContinuous bundle.totalSpace bundle.baseSpace Original.projection (Original.Of[bundle := bundle].projectionContinuous);
\module At(p: Point);
\definition sourceBase[p: Point]: \Cast[X] (sourceChart i).domain := At[p := p].sourceBase;
\definition sourceBaseContinuous: topology.Continuity[A := Point, B := \Cast[X] (sourceChart i).domain].Continuous topology
  (topology.Topology[Carrier := X].Subspace[S := (sourceChart i).domain].topology bundle.baseSpace) sourceBase :=
  topology.Continuity[A := Point, B := X].Corestriction[S := (sourceChart i).domain].corestrictContinuous topology bundle.baseSpace sourceBase baseContinuous;
\definition original[p: Point]: Original.Point := p;
\definition reconstructed[p: Point]: Original.Point := Original.include (sourceBase p) p.vector;
\definition originalContinuous: topology.Continuity[A := Point, B := Original.Point].Continuous topology bundle.totalSpace reconstructed :=
  \idelim original = reconstructed \with f: (Point -> Original.Point) => topology.Continuity[A := Point, B := Original.Point].Continuous topology bundle.totalSpace f \by {
    base: topology.Continuity[A := Point, B := Original.Point].Corestriction[S := domain].inclusionContinuous bundle.totalSpace,
    equality: \axiom:funext(original, reconstructed, \fun (p: Point) => sym!{{Original.Point}} _ _ (Original.eta p))
  };
\definition coordinate[p: Point]: Bundles.Vector (sourceChart i).dimension := ((sourceChart i).frame (sourceBase p)).forward.apply p.vector;
\definition coordinateContinuous: topology.Continuity[A := Point, B := Bundles.Vector (sourceChart i).dimension].Continuous topology (Bundles.coordinateTopology (sourceChart i).dimension) coordinate :=
  (regularFrame i).reading Point topology sourceBase sourceBaseContinuous (\fun (p: Point) => p.vector) originalContinuous;
\definition quotientBase[p: Point]: \Cast[Quotient.Carrier] (quotientDomain i) := At[p := p].quotientBase;
\definition quotientContinuous: topology.Continuity[A := Point, B := Quotient.Carrier].Continuous topology Quotient.topology (\fun (p: Point) => quotientBase p) :=
  topology.Composition[A := Point, B := X, C := Quotient.Carrier].composeContinuous topology bundle.baseSpace Quotient.topology base Quotient.projection baseContinuous Quotient.continuous;
\definition quotientBaseContinuous: topology.Continuity[A := Point, B := \Cast[Quotient.Carrier] (quotientDomain i)].Continuous topology
  (Base.Subspace[S := quotientDomain i].topology Quotient.topology) quotientBase :=
  topology.Continuity[A := Point, B := Quotient.Carrier].Corestriction[S := quotientDomain i].corestrictContinuous topology Quotient.topology quotientBase quotientContinuous;
\definition candidate[p: Point]: Source.Point := Source.include p.base ((frame i (quotientBase p)).backward.apply (coordinate p));
\definition globalContinuous: topology.Continuity[A := Point, B := Descended.Point].Continuous topology bundleOnQuotient.totalSpace (\fun (p: Point) => Pull.map (candidate p)) :=
  Operations.Chart[X := Quotient.Carrier, F := Fiber, bundle := bundleOnQuotient, chart := trivialization i].Maps[Y := Point, source := topology].pointContinuous quotientBase coordinate quotientBaseContinuous coordinateContinuous;
\definition candidateContinuous: topology.Continuity[A := Point, B := Source.Point].Continuous topology pulled.totalSpace candidate := Pull.Universal[Z := Point].continuous topology candidate baseContinuous globalContinuous;
\definition result[p: Point]: Source.Point := Backward.total backwardData p;
\definition equal: candidate = result := \axiom:funext(candidate, result, \fun (p: Point) =>
  congr!{{Fiber (Quotient.projection p.base)} Source.Point} (Source.include p.base) _ _ (sym!{{Fiber (Quotient.projection p.base)}} _ _ (At[p := p].formula)));
\definition continuous: topology.Continuity[A := Point, B := Source.Point].Continuous topology pulled.totalSpace result :=
  \idelim candidate = result \with f: (Point -> Source.Point) => topology.Continuity[A := Point, B := Source.Point].Continuous topology pulled.totalSpace f \by { base: candidateContinuous, equality: equal };
