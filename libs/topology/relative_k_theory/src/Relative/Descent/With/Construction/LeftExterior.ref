\definition first: Index := Sum.Sum[Quotient.Point, OriginalCharts.Chart]::inr c;
\definition second: Index := Sum.Sum[Quotient.Point, OriginalCharts.Chart]::inl right;
\import Glued.Overlap[i := first, j := second] \as Overlap;
\import Atlas.In[c := chart second] \as Right;
\definition outside: \forall (p: Overlap.Point) -> Logic.Not (Right.base p = Quotient.point) :=
  \fun (p: Overlap.Point) => \bysub(Quotient.Carrier, Base.Complement (Base.Singleton Quotient.point), OriginalChart[c := c].exterior
    (\into[Quotient.Carrier](Right.base p, OriginalChart[c := c].domain) \by { \bysub(Right.Parameter, Overlap.Domain, p) }));
\definition regular: Overlap.Regular := \parent.Cross[i := first, j := second, outside := outside].regular;
