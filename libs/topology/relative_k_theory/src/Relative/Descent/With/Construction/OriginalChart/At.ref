\import \parent.\parent.\parent.At[q := q] \as Model;
\definition point: Model.Index := \into[X](base q, { x: X \where Quotient.projection x = q }) \by { Exterior.inverseProjection (exterior q) };
\import Model.Outside[different := (\bysub(Quotient.Carrier, Base.Complement (Base.Singleton Quotient.point), exterior q))].AtIndex[index := point] \as Evaluation;
\definition isomorphism: Spaces.Isomorphism[V := Model.Carrier, W := Bundles.Vector c.dimension, source := Model.space, target := Bundles.coordinates c.dimension].Isomorphism :=
  Spaces.Isomorphism[V := F (base q), W := Bundles.Vector c.dimension, source := bundle.space (base q), target := Bundles.coordinates c.dimension].Composition[
    U := Model.Carrier, domain := Model.space].compose (c.frame (base q)) Evaluation.isomorphism;
