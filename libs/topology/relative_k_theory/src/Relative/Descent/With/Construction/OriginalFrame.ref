\import Operations.Chart[X := X, F := F, bundle := bundle, chart := c] \as Maps;
\definition regular: RegularFrame[c] := RegularFrame[c] {
  reading := \fun (Y: \Set)(source: topology.Topology[Carrier := Y].Topology)(base: Y -> \Cast[X] c.domain)(baseRegular: _)
    (v: \forall (y: Y) -> F (base y))(regular: _) => Maps.Maps[Y := Y, source := source].vectorContinuous
      (\fun (y: Y) => \into[Original.Point](Original.include (base y) (v y), { p: Original.Point \where topology.Topology[Carrier := X].Member c.domain p.base })
        \by { \bysub(X, c.domain, base y) }) regular,
  writing := \fun (Y: \Set)(source: topology.Topology[Carrier := Y].Topology)(base: Y -> \Cast[X] c.domain)(baseRegular: _)
    (w: Y -> Bundles.Vector c.dimension)(regular: _) => Maps.Maps[Y := Y, source := source].pointContinuous base w baseRegular regular
};
