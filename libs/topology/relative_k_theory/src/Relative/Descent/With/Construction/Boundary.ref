\definition index: Index := Sum.Sum[Quotient.Point, OriginalCharts.Chart]::inl Quotient.distinguished;
\definition projected: Near.Point := \into[Quotient.Carrier](Quotient.projection x, Near.domain) \by {
  Near.fromOriginal (\into[X](x, extension.domain) \by { extension.contains x (\bysub(X, subset, x)) })
};
\import \parent.Compare[].At[x := x, i := index, contains := (\bysub(Quotient.Carrier, Near.domain, projected))] \as Data;
\definition alignment: \forall (v: Fiber (Quotient.projection x)) ->
  (comparison.forward.fiber x).apply ((\parent.Compare[].isomorphism.forward.fiber x).apply v) = ((trivialization index).frame projected).forward.apply v :=
  \fun (v: Fiber (Quotient.projection x)) => sym!{Vector} _ _
    (trans!{Vector} _ _ _ (Data.agreement.reading v) (extension.extends x ((\parent.Compare[].isomorphism.forward.fiber x).apply v)));
