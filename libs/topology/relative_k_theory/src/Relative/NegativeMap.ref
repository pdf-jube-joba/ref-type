\import \parent.Pullback[source := iterate degree source, target := iterate degree target, f := iterateMap degree source target f] \as Native;
\import \parent.Negative[original := target, degree := degree] \as From;
\import \parent.Negative[original := source, degree := degree] \as To;
\definition map: From.Carrier -> To.Carrier := Native.map;
\definition additive: \forall (x, y: From.Carrier) -> map (From.group.base.op x y) = To.group.base.op (map x) (map y) := Native.additive;
\definition preservesZero: map From.group.base.unit = To.group.base.unit := Native.preservesZero;
