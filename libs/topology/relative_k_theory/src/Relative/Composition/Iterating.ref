\definition lift[f: Map (iterate degree source) (iterate degree target)]:
  Map (iterate (N.Nat^::succ degree) source) (iterate (N.Nat^::succ degree) target) :=
  \parent.\parent.SuspendedMap[source := iterate degree source, target := iterate degree target, f := f].map;
\import \parent.\parent.Composition[source := iterate degree source, middle := iterate degree middle, target := iterate degree target,
  first := iterateMap degree source middle first, second := iterateMap degree middle target second].Suspended[] \as Compatibility;
\definition step: Iteration degree -> Iteration (N.Nat^::succ degree) := \fun (previous: Iteration degree) =>
  trans!{{Map (iterate (N.Nat^::succ degree) source) (iterate (N.Nat^::succ degree) target)}} _ _ _
    (congr!{{Map (iterate degree source) (iterate degree target)} {Map (iterate (N.Nat^::succ degree) source) (iterate (N.Nat^::succ degree) target)}} lift _ _ previous)
    Compatibility.equation;
