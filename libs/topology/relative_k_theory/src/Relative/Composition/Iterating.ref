\definition lift[f: Map (\root.Relative[].iterate degree source) (\root.Relative[].iterate degree target)]:
  Map (\root.Relative[].iterate (N.Nat^::succ degree) source) (\root.Relative[].iterate (N.Nat^::succ degree) target) :=
  \parent.\parent.SuspendedMap[source := \root.Relative[].iterate degree source, target := \root.Relative[].iterate degree target, f := f].map;
\import \parent.\parent.Composition[source := \root.Relative[].iterate degree source, middle := \root.Relative[].iterate degree middle, target := \root.Relative[].iterate degree target,
  first := \root.Relative[].iterateMap degree source middle first, second := \root.Relative[].iterateMap degree middle target second].Suspended[] \as Compatibility;
\definition step: Iteration degree -> Iteration (N.Nat^::succ degree) := \fun (previous: Iteration degree) =>
  trans!{{Map (\root.Relative[].iterate (N.Nat^::succ degree) source) (\root.Relative[].iterate (N.Nat^::succ degree) target)}} _ _ _
    (congr!{{Map (\root.Relative[].iterate degree source) (\root.Relative[].iterate degree target)} {Map (\root.Relative[].iterate (N.Nat^::succ degree) source) (\root.Relative[].iterate (N.Nat^::succ degree) target)}} lift _ _ previous)
    Compatibility.equation;
