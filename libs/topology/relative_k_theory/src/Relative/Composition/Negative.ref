\import \parent.\parent.NegativeMap[source := source, target := target, f := map, degree := degree] \as Direct;
\import \parent.\parent.NegativeMap[source := source, target := middle, f := first, degree := degree] \as First;
\import \parent.\parent.NegativeMap[source := middle, target := target, f := second, degree := degree] \as Second;
\import \parent.\parent.Negative[original := target, degree := degree] \as From;
\import \parent.\parent.Negative[original := source, degree := degree] \as To;
\import \parent.\parent.PullbackComposition[source := iterate degree source, middle := iterate degree middle, target := iterate degree target,
  first := iterateMap degree source middle first, second := iterateMap degree middle target second] \as Native;
\definition equation: \forall (v: From.Carrier) -> Direct.map v = First.map (Second.map v) :=
  \fun (v: From.Carrier) => \idelim iteratedMap degree = iterateMap degree source target map
    \with f: Map (iterate degree source) (iterate degree target) =>
      \parent.\parent.Pullback[source := iterate degree source, target := iterate degree target, f := f].map v = First.map (Second.map v)
    \by { base: Native.equation v, equality: sym!{{Map (iterate degree source) (iterate degree target)}} _ _ (iterateEquation degree) };
