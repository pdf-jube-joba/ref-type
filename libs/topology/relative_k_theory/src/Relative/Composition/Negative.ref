\import \parent.\parent.NegativeMap[source := source, target := target, f := map, degree := degree] \as Direct;
\import \parent.\parent.NegativeMap[source := source, target := middle, f := first, degree := degree] \as First;
\import \parent.\parent.NegativeMap[source := middle, target := target, f := second, degree := degree] \as Second;
\import \parent.\parent.Negative[original := target, degree := degree] \as From;
\import \parent.\parent.Negative[original := source, degree := degree] \as To;
\import \parent.\parent.PullbackComposition[source := \root.Relative[].iterate degree source, middle := \root.Relative[].iterate degree middle, target := \root.Relative[].iterate degree target,
  first := \root.Relative[].iterateMap degree source middle first, second := \root.Relative[].iterateMap degree middle target second] \as Native;
\definition equation: \forall (v: From.Carrier) -> Direct.map v = First.map (Second.map v) :=
  \fun (v: From.Carrier) => \idelim iteratedMap degree = \root.Relative[].iterateMap degree source target map
    \with f: Map (\root.Relative[].iterate degree source) (\root.Relative[].iterate degree target) =>
      \parent.\parent.Pullback[source := \root.Relative[].iterate degree source, target := \root.Relative[].iterate degree target, f := f].map v = First.map (Second.map v)
    \by { base: Native.equation v, equality: sym!{{Map (\root.Relative[].iterate degree source) (\root.Relative[].iterate degree target)}} _ _ (iterateEquation degree) };
