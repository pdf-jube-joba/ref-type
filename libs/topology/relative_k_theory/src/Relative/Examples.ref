\import KTheory.FiniteDiscrete[n := KTheory.one] \as PointProperties;
\definition Point: \Set := Fin.Fin KTheory.one;
\definition pointTopology: topology.Topology[Carrier := Point].Topology := topology.Topology[Carrier := Point].Discrete;
\module TrivialDisk(n: N.Nat^);
\import TrivialDisk[n := N.Nat^::zero] \as Zero;
\import TrivialDisk[n := KTheory.one] \as Line;
\definition ZeroDisk: \Set := Zero.Disk;
\definition LineDisk: \Set := Line.Disk;
\definition ZeroRelative: \Set := Zero.Relative;
\definition LineRelative: \Set := Line.Relative;
\definition zeroBoundaryEmpty: \forall (z: Zero.Disk) -> \In[Zero.Disk] Zero.boundary z -> Logic.False :=
  \fun (z: Zero.Disk)(member: \In[Zero.Disk] Zero.boundary z) => dedekind_reals.DedekindReal[].Arithmetic[].Prop[].zeroNeOne member;
