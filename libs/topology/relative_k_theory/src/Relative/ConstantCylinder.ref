\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := X] \as Cylinder;
\definition space: topology.Topology[Carrier := Cylinder.Carrier].Topology := Cylinder.topology first.baseSpace;
\definition targetRegular: topology.Continuity[A := Cylinder.Carrier, B := X].Continuous space second.baseSpace Cylinder.point :=
  \idelim first.baseSpace = second.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Continuity[A := Cylinder.Carrier, B := X].Continuous space t Cylinder.point \by {
    base: Cylinder.pointContinuous first.baseSpace, equality: same
  };
\import Bundles.Family[X := X, F := F].Of[bundle := first].Pullback[Y := Cylinder.Carrier, source := space, f := Cylinder.point] \as P;
\import Bundles.Family[X := X, F := G].Of[bundle := second].Pullback[Y := Cylinder.Carrier, source := space, f := Cylinder.point] \as Q;
\definition First[z: Cylinder.Carrier]: \Set := F (Cylinder.point z);
\definition Second[z: Cylinder.Carrier]: \Set := G (Cylinder.point z);
\definition firstBundle: Bundles.Family[X := Cylinder.Carrier, F := First].Bundle := P.pulled (Cylinder.pointContinuous first.baseSpace);
\definition secondBundle: Bundles.Family[X := Cylinder.Carrier, F := Second].Bundle := Q.pulled targetRegular;
\import Bundles.Isomorphisms[X := Cylinder.Carrier, F := First, G := Second, source := firstBundle, target := secondBundle] \as Maps;
\module With(isomorphism: Maps.Isomorphism);

\module Mapping(map: Bundles.Morphisms[X := Cylinder.Carrier, Y := Cylinder.Carrier, F := First, G := Second,
  source := firstBundle, target := secondBundle, f := (\fun (z: Cylinder.Carrier) => z)].Map);
