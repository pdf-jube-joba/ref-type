\import Bundles.Family[X := X, F := F].Of[bundle := bundle].PullbackComposition[Y := Y, Z := Z,
  first := first, second := second, f := f, g := g].Of[fRegular := fRegular, gRegular := gRegular] \as Middle;
\definition MiddleFiber[z: Z]: \Set := F (f (g z));
\definition middle: Bundles.Family[X := Z, F := MiddleFiber].Bundle := Middle.nested;
\definition composite[z: Z]: X := f (g z);
\definition compositeRegular: topology.Continuity[A := Z, B := X].Continuous second bundle.baseSpace composite :=
  topology.Composition[A := Z, B := Y, C := X].composeContinuous second first bundle.baseSpace g f gRegular fRegular;
\import Bundles.Family[X := X, F := F].Of[bundle := bundle].PullbackComposition[Y := Z, Z := T,
  first := second, second := third, f := composite, g := h].Of[fRegular := compositeRegular, gRegular := hRegular] \as Outer;
\import Complements.PulledIsomorphism[X := Z, Y := T, F := MiddleFiber, G := MiddleFiber, source := Middle.direct, target := Middle.nested,
  base := third, f := h, sourceRegular := hRegular, targetRegular := hRegular] \as Pull;
\import Bundles.Family[X := Z, F := MiddleFiber].Of[bundle := middle].Pullback[Y := T, source := third, f := h] \as Final;
\definition Fiber[t: T]: \Set := F (f (g (h t)));
\definition direct: Bundles.Family[X := T, F := Fiber].Bundle := Outer.direct;
\definition nested: Bundles.Family[X := T, F := Fiber].Bundle := Final.pulled hRegular;
\import Operations.IsomorphismComposition[X := T, F := Fiber, G := Fiber, H := Fiber,
  source := direct, middle := Outer.nested, target := nested] \as Composition;
\definition isomorphism: Bundles.Isomorphisms[X := T, F := Fiber, G := Fiber, source := direct, target := nested].Isomorphism :=
  Composition.compose Outer.isomorphism (Pull.isomorphism Middle.isomorphism);
\definition formula: \forall (t: T)(v: Fiber t) -> (isomorphism.forward.fiber t).apply v = v := \fun (t: T)(v: Fiber t) => \refl(v);
