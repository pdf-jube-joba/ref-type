\import \root.Relative[].IterationAddition[original := target, inner := inner] \as Target;
\module At(outer: N.Nat^);
\module Step(outer: N.Nat^, previous: \parent.At[outer := outer].Equation);
\definition naturality[outer: N.Nat^]: At[outer := outer].Equation :=
  (\induction (outer: N.Nat^) \return At[outer := outer].Equation \with {
    | zero: \fun (x: (iterate inner original).Carrier) => \refl(\root.Relative[].iterateMap inner original target f x)
    | succ: \fun (n: N.Nat^)(previous: At[outer := n].Equation) => Step[outer := n, previous := previous].equation
  }) outer;
