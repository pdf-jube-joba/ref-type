\definition A: CompactPointed := iterate (Nat.add inner outer) original;
\definition B: CompactPointed := iterate (Nat.add inner outer) target;
\definition C: CompactPointed := iterate outer (iterate inner original);
\definition D: CompactPointed := iterate outer (iterate inner target);
\definition sourceComparison: \root.Relative[].Equivalence[source := A, target := C].Data := \parent.\parent.comparison outer;
\definition targetComparison: \root.Relative[].Equivalence[source := B, target := D].Data := Target.comparison outer;
\definition wholeMap: Map A B := \root.Relative[].iterateMap (Nat.add inner outer) original target f;
\definition nestedMap: Map C D := \root.Relative[].iterateMap outer (iterate inner original) (iterate inner target) (\root.Relative[].iterateMap inner original target f);
\definition Equation: \Prop := \forall (x: A.Carrier) -> targetComparison.forward (wholeMap x) = nestedMap (sourceComparison.forward x);
