\import \root.Relative[].PointedPair[pair := iteratePair degree pair] \as Current;
\import \root.Relative[].Composition[source := (iteratePair degree pair).model, middle := Current.quotientModel, target := iterate degree Original.quotientModel,
  first := Current.projection, second := (quotientComparison degree).forward] \as Left;
\import \root.Relative[].Composition[source := (iteratePair degree pair).model, middle := iterate degree pair.model, target := iterate degree Original.quotientModel,
  first := (wholeComparison degree).forward, second := iterateMap degree pair.model Original.quotientModel Original.projection] \as Right;
\definition left: Map (iteratePair degree pair).model (iterate degree Original.quotientModel) := Left.map;
\definition right: Map (iteratePair degree pair).model (iterate degree Original.quotientModel) := Right.map;
\definition Equation: \Prop := left = right;
