\import \root.Relative[].PointedPair[pair := iteratePair degree pair] \as Current;
\import \root.Relative[].PointedPair[pair := iteratePair (N.Nat^::succ degree) pair] \as Next;
\import \root.Relative[].Equivalence[source := Current.subsetModel, target := iterate degree Original.subsetModel].With[e := previous].Suspended[] \as Suspended;
\definition imageInverse: \root.Relative[].Equivalence[source := Next.subsetModel, target := \root.Relative[].Suspension[original := Current.subsetModel].result].Data :=
  \root.Relative[].Equivalence[source := Next.subsetModel, target := \root.Relative[].Suspension[original := Current.subsetModel].result].Data {
    forward := Current.suspendedSubsetEquivalence.backward, backward := Current.suspendedSubsetEquivalence.forward,
    leftInverse := Current.suspendedSubsetEquivalence.rightInverse, rightInverse := Current.suspendedSubsetEquivalence.leftInverse
  };
\import \root.Relative[].Equivalence[source := Next.subsetModel, target := iterate (N.Nat^::succ degree) Original.subsetModel].Compose[
  middle := \root.Relative[].Suspension[original := Current.subsetModel].result, first := imageInverse, second := Suspended.result] \as Composite;
\definition result: \root.Relative[].Equivalence[source := Next.subsetModel, target := iterate (N.Nat^::succ degree) Original.subsetModel].Data := Composite.result;
