\use Equality.eq_reason_in;
\import \root.Relative[].PointedPair[pair := iteratePair degree pair] \as Current;
\import \root.Relative[].PointedPair[pair := iteratePair (N.Nat^::succ degree) pair] \as Next;
\import \parent.InclusionAt[degree := degree] \as Before;
\import \parent.InclusionAt[degree := (N.Nat^::succ degree)] \as After;
\import \root.Relative[].Suspension[original := Current.subsetModel] \as CurrentA;
\import \root.Relative[].Suspension[original := (iteratePair degree pair).model] \as CurrentX;
\import \root.Relative[].Suspension[original := iterate degree pair.model] \as TargetX;
\import \root.Relative[].SuspendedMap[source := Current.subsetModel, target := (iteratePair degree pair).model, f := Current.inclusion] \as Inclusion;
\import \root.Relative[].SuspendedMap[source := (iteratePair degree pair).model, target := iterate degree pair.model, f := (wholeComparison degree).forward] \as Whole;
\import \root.Relative[].SuspendedMap[source := Current.subsetModel, target := iterate degree Original.subsetModel, f := (subsetComparison degree).forward] \as Subset;
\import \root.Relative[].SuspendedMap[source := iterate degree Original.subsetModel, target := iterate degree pair.model,
  f := iterateMap degree Original.subsetModel pair.model Original.inclusion] \as Iterated;
\import \root.Relative[].SuspendedMap[source := Current.subsetModel, target := iterate degree pair.model, f := Before.left] \as SuspendedLeft;
\import \root.Relative[].SuspendedMap[source := Current.subsetModel, target := iterate degree pair.model, f := Before.right] \as SuspendedRight;
\import \root.Relative[].Composition[source := Current.subsetModel, middle := (iteratePair degree pair).model, target := iterate degree pair.model,
  first := Current.inclusion, second := (wholeComparison degree).forward].Suspended[] \as LeftComposite;
\import \root.Relative[].Composition[source := Current.subsetModel, middle := iterate degree Original.subsetModel, target := iterate degree pair.model,
  first := (subsetComparison degree).forward, second := iterateMap degree Original.subsetModel pair.model Original.inclusion].Suspended[] \as RightComposite;
\definition changed: SuspendedLeft.map = SuspendedRight.map :=
  congr!{{Map Current.subsetModel (iterate degree pair.model)} {Map CurrentA.result TargetX.result}}
    (\fun (f: Map Current.subsetModel (iterate degree pair.model)) => \root.Relative[].SuspendedMap[source := Current.subsetModel, target := iterate degree pair.model, f := f].map) _ _ previous;
\definition imageEquation: \forall (x: Next.subsetModel.Carrier) -> Inclusion.map (Current.suspendedSubsetEquivalence.backward x) = Next.inclusion x :=
  \fun (x: Next.subsetModel.Carrier) => Current.suspendedSubsetEquivalence.rightInverse x;
\definition pointwise: \forall (x: Next.subsetModel.Carrier) -> After.left x = After.right x := \block {
  \fun (x: Next.subsetModel.Carrier) \then
  \let preimage: CurrentA.result.Carrier := Current.suspendedSubsetEquivalence.backward x \then
  \return eq_reason_in!{{TargetX.result.Carrier} _
    "=" { Whole.map (Inclusion.map preimage) } "by" {
      congr!{{CurrentX.result.Carrier} {TargetX.result.Carrier}} Whole.map _ _ (sym!{{CurrentX.result.Carrier}} _ _ (imageEquation x)) }
    "=" { SuspendedLeft.map preimage } "by" {
      sym!{{TargetX.result.Carrier}} _ _ (congr!{{Map CurrentA.result TargetX.result} {TargetX.result.Carrier}} (\fun (f: Map CurrentA.result TargetX.result) => f preimage) _ _ LeftComposite.equation) }
    "=" { SuspendedRight.map preimage } "by" {
      congr!{{Map CurrentA.result TargetX.result} {TargetX.result.Carrier}} (\fun (f: Map CurrentA.result TargetX.result) => f preimage) _ _ changed }
    "=" { Iterated.map (Subset.map preimage) } "by" {
      congr!{{Map CurrentA.result TargetX.result} {TargetX.result.Carrier}} (\fun (f: Map CurrentA.result TargetX.result) => f preimage) _ _ RightComposite.equation }
  }
};
\definition equation: After.Equation := \axiom:funext(After.left, After.right, pointwise);
