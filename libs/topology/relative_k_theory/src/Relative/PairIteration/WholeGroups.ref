\import \root.Relative[].PointedPair[pair := iteratePair degree pair] \as Current;
\import \root.Relative[].Reduced[model := (iteratePair degree pair).model] \as Reduced;
\import \root.Relative[].Negative[original := pair.model, degree := degree] \as Negative;
\import \root.Relative[].Equivalence[source := (iteratePair degree pair).model, target := iterate degree pair.model].With[e := wholeComparison degree].Groups[] \as Native;
\definition forward: Negative.Carrier -> Reduced.Carrier := Native.forward;
\definition backward: Reduced.Carrier -> Negative.Carrier := Native.backward;
\definition leftInverse: \forall (v: Reduced.Carrier) -> forward (backward v) = v := Native.leftInverse;
\definition rightInverse: \forall (v: Negative.Carrier) -> backward (forward v) = v := Native.rightInverse;
\definition forwardAdd: \forall (v, w: Negative.Carrier) -> forward (Negative.group.base.op v w) = Reduced.group.base.op (forward v) (forward w) := Native.additive;
\definition backwardAdd: \forall (v, w: Reduced.Carrier) -> backward (Reduced.group.base.op v w) = Negative.group.base.op (backward v) (backward w) := Native.inverseAdditive;
\definition forwardZero: forward Negative.group.base.unit = Reduced.group.base.unit :=
  \root.Relative[].Pullback[source := (iteratePair degree pair).model, target := iterate degree pair.model, f := (wholeComparison degree).forward].preservesZero;
\definition backwardZero: backward Reduced.group.base.unit = Negative.group.base.unit :=
  \root.Relative[].Pullback[source := iterate degree pair.model, target := (iteratePair degree pair).model, f := (wholeComparison degree).backward].preservesZero;
