\import \parent.\parent.SuspendedInclusion[degree := degree] \as Before;
\import \parent.\parent.InclusionPullback[degree := degree] \as After;
\import \parent.\parent.ProjectionPullback[degree := degree] \as Projection;
\definition before: \forall (v: First) -> restrictionNegative v = NativeBefore.map v :=
  \fun (v: First) => trans!{{Second}} _ _ _ (congr!{{Term.Second} {Second}} A1.backward _ _ (Before.equation v)) (A1.rightInverse (NativeBefore.map v));
\definition forgetEquation: \forall (v: Third) -> forget v = NativeForget.map v :=
  \fun (v: Third) => trans!{{Fourth}} _ _ _ (congr!{{Term.Fourth} {Fourth}} X0.backward _ _ (Projection.equation v)) (X0.rightInverse (NativeForget.map v));
\definition restrictionEquation: \forall (v: Fourth) -> restriction v = NativeAfter.map v :=
  \fun (v: Fourth) => trans!{{Fifth}} _ _ _ (congr!{{Term.Fifth} {Fifth}} A0.backward _ _ (After.equation v)) (A0.rightInverse (NativeAfter.map v));
