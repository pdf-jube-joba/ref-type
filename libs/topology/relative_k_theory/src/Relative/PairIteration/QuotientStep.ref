\import \root.Relative[].PointedPair[pair := iteratePair degree pair] \as Current;
\import \root.Relative[].PointedPair[pair := iteratePair (N.Nat^::succ degree) pair] \as Next;
\import \root.Relative[].Equivalence[source := Current.quotientModel, target := iterate degree Original.quotientModel].With[e := previous].Suspended[] \as Suspended;
\import \root.Relative[].Equivalence[source := Next.quotientModel, target := iterate (N.Nat^::succ degree) Original.quotientModel].Compose[
  middle := \root.Relative[].Suspension[original := Current.quotientModel].result, first := Current.suspendedQuotientEquivalence, second := Suspended.result] \as Composite;
\definition result: \root.Relative[].Equivalence[source := Next.quotientModel, target := iterate (N.Nat^::succ degree) Original.quotientModel].Data := Composite.result;
