\import \root.Relative[].PointedPair[pair := iteratePair degree pair] \as Current;
\import \parent.InclusionAt[degree := degree] \as Before;
\import \root.Relative[].Suspension[original := Current.subsetModel] \as CurrentA;
\import \root.Relative[].Suspension[original := (iteratePair degree pair).model] \as CurrentX;
\import \root.Relative[].Suspension[original := iterate degree Original.subsetModel] \as TargetA;
\import \root.Relative[].Suspension[original := iterate degree pair.model] \as TargetX;
\import \root.Relative[].Equivalence[source := Current.subsetModel, target := iterate degree Original.subsetModel].With[e := subsetComparison degree].Suspended[] \as Subset;
\import \root.Relative[].Equivalence[source := (iteratePair degree pair).model, target := iterate degree pair.model].With[e := wholeComparison degree].Suspended[] \as Whole;
\import \root.Relative[].Equivalence[source := CurrentA.result, target := TargetA.result].With[e := Subset.result].Groups[] \as SubsetGroups;
\import \root.Relative[].Equivalence[source := CurrentX.result, target := TargetX.result].With[e := Whole.result].Groups[] \as WholeGroups;
\import \root.Relative[].SuspendedMap[source := Current.subsetModel, target := (iteratePair degree pair).model, f := Current.inclusion] \as Inclusion;
\import \root.Relative[].SuspendedMap[source := iterate degree Original.subsetModel, target := iterate degree pair.model,
  f := iterateMap degree Original.subsetModel pair.model Original.inclusion] \as Iterated;
\import \root.Relative[].Composition[source := CurrentA.result, middle := CurrentX.result, target := TargetX.result,
  first := Inclusion.map, second := Whole.result.forward] \as Left;
\import \root.Relative[].Composition[source := CurrentA.result, middle := TargetA.result, target := TargetX.result,
  first := Subset.result.forward, second := Iterated.map] \as Right;
\import \root.Relative[].Composition[source := Current.subsetModel, middle := (iteratePair degree pair).model, target := iterate degree pair.model,
  first := Current.inclusion, second := (wholeComparison degree).forward].Suspended[] \as LeftComposite;
\import \root.Relative[].Composition[source := Current.subsetModel, middle := iterate degree Original.subsetModel, target := iterate degree pair.model,
  first := (subsetComparison degree).forward, second := iterateMap degree Original.subsetModel pair.model Original.inclusion].Suspended[] \as RightComposite;
\import \root.Relative[].SuspendedMap[source := Current.subsetModel, target := iterate degree pair.model, f := Before.left] \as SuspendedLeft;
\import \root.Relative[].SuspendedMap[source := Current.subsetModel, target := iterate degree pair.model, f := Before.right] \as SuspendedRight;
\definition changed: SuspendedLeft.map = SuspendedRight.map :=
  congr!{{Map Current.subsetModel (iterate degree pair.model)} {Map CurrentA.result TargetX.result}}
    (\fun (f: Map Current.subsetModel (iterate degree pair.model)) => \root.Relative[].SuspendedMap[source := Current.subsetModel, target := iterate degree pair.model, f := f].map)
    _ _ (inclusionNaturality degree);
\definition square: Left.map = Right.map := trans!{{Map CurrentA.result TargetX.result}} _ _ _
  (sym!{{Map CurrentA.result TargetX.result}} _ _ LeftComposite.equation)
  (trans!{{Map CurrentA.result TargetX.result}} _ _ _ changed RightComposite.equation);
\import \root.Relative[].Pullback[source := CurrentA.result, target := TargetX.result, f := Left.map] \as LeftPull;
\import \root.Relative[].Pullback[source := CurrentA.result, target := TargetX.result, f := Right.map] \as RightPull;
\import \root.Relative[].Pullback[source := CurrentA.result, target := CurrentX.result, f := Inclusion.map] \as CurrentRestriction;
\import \root.Relative[].Reduced[model := CurrentA.result] \as Result;
\import \root.Relative[].Negative[original := pair.model, degree := (N.Nat^::succ degree)] \as Negative;
\import \root.Relative[].NegativeMap[source := Original.subsetModel, target := pair.model, f := Original.inclusion, degree := (N.Nat^::succ degree)] \as Restriction;
\definition pullbackChanged: \forall (v: Negative.Carrier) -> LeftPull.map v = RightPull.map v :=
  \fun (v: Negative.Carrier) => congr!{{Map CurrentA.result TargetX.result} {Result.Carrier}}
    (\fun (f: Map CurrentA.result TargetX.result) => \root.Relative[].Pullback[source := CurrentA.result, target := TargetX.result, f := f].map v) _ _ square;
\definition equation: \forall (v: Negative.Carrier) -> CurrentRestriction.map (WholeGroups.forward v) = SubsetGroups.forward (Restriction.map v) :=
  \fun (v: Negative.Carrier) => trans!{{Result.Carrier}} _ _ _
    (sym!{{Result.Carrier}} _ _ (\root.Relative[].PullbackComposition[source := CurrentA.result, middle := CurrentX.result, target := TargetX.result,
      first := Inclusion.map, second := Whole.result.forward].equation v))
    (trans!{{Result.Carrier}} _ _ _ (pullbackChanged v)
      (\root.Relative[].PullbackComposition[source := CurrentA.result, middle := TargetA.result, target := TargetX.result,
        first := Subset.result.forward, second := Iterated.map].equation v));
