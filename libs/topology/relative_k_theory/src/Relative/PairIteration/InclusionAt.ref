\import \root.Relative[].PointedPair[pair := iteratePair degree pair] \as Current;
\import \root.Relative[].Composition[source := Current.subsetModel, middle := (iteratePair degree pair).model, target := iterate degree pair.model,
  first := Current.inclusion, second := (wholeComparison degree).forward] \as Left;
\import \root.Relative[].Composition[source := Current.subsetModel, middle := iterate degree Original.subsetModel, target := iterate degree pair.model,
  first := (subsetComparison degree).forward, second := iterateMap degree Original.subsetModel pair.model Original.inclusion] \as Right;
\definition left: Map Current.subsetModel (iterate degree pair.model) := Left.map;
\definition right: Map Current.subsetModel (iterate degree pair.model) := Right.map;
\definition Equation: \Prop := left = right;
