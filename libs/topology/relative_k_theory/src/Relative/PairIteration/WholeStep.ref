\import \root.Relative[].PointedPair[pair := iteratePair degree pair] \as Current;
\import \root.Relative[].Equivalence[source := (iteratePair degree pair).model, target := iterate degree pair.model].With[e := previous].Suspended[] \as Suspended;
\definition result: \root.Relative[].Equivalence[source := (iteratePair (N.Nat^::succ degree) pair).model, target := iterate (N.Nat^::succ degree) pair.model].Data := Suspended.result;
