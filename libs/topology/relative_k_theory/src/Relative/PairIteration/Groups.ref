\import \root.Relative[].PointedPair[pair := iteratePair degree pair] \as Current;
\import \root.Relative[].Equivalence[source := Current.quotientModel, target := iterate degree Original.quotientModel].With[e := quotientComparison degree].Groups[] \as Native;
\import \root.Relative[].Negative[original := Original.quotientModel, degree := degree] \as Negative;
\definition forward: Negative.Carrier -> Current.Relative := Native.forward;
\definition backward: Current.Relative -> Negative.Carrier := Native.backward;
\definition leftInverse: \forall (v: Current.Relative) -> forward (backward v) = v := Native.leftInverse;
\definition rightInverse: \forall (v: Negative.Carrier) -> backward (forward v) = v := Native.rightInverse;
\definition forwardAdd: \forall (v, w: Negative.Carrier) -> forward (Negative.group.base.op v w) = Current.group.base.op (forward v) (forward w) := Native.additive;
\definition backwardAdd: \forall (v, w: Current.Relative) -> backward (Current.group.base.op v w) = Negative.group.base.op (backward v) (backward w) := Native.inverseAdditive;
