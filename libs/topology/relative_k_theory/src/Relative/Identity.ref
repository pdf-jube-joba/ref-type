\import algebraic_topology.Pointed[A := model.Carrier].Maps[B := model.Carrier] \as Maps;
\definition map: Map model model := \into[model.Carrier -> model.Carrier]((\fun (x: model.Carrier) => x), Map model model) \by {
  Maps.Laws[pointed model, pointed model, (\fun (x: model.Carrier) => x)] {
    continuous := topology.Maps[A := model.Carrier, B := model.Carrier].Identity[].continuous (details model).topology,
    pointed := \refl((details model).point)
  }
};
\module Suspended;
\definition iteratedMap[degree: N.Nat^]: Map (\root.Relative[].iterate degree model) (\root.Relative[].iterate degree model) := \parent.Identity[model := \root.Relative[].iterate degree model].map;
\definition Iteration[degree: N.Nat^]: \Prop := \root.Relative[].iterateMap degree model model map = iteratedMap degree;
\module Iterating(degree: N.Nat^);
\definition iterateEquation[degree: N.Nat^]: Iteration degree :=
  (\induction (degree: N.Nat^) \return Iteration degree \with {
    | zero: \refl(map)
    | succ: \fun (n: N.Nat^)(previous: Iteration n) => Iterating[degree := n].step previous
  }) degree;
\module Negative(degree: N.Nat^);
\definition equivalence: \root.Relative[].Equivalence[source := model, target := model].Data :=
  \root.Relative[].Equivalence[source := model, target := model].Data {
    forward := map, backward := map,
    leftInverse := \fun (x: model.Carrier) => \refl(x),
    rightInverse := \fun (x: model.Carrier) => \refl(x)
  };
