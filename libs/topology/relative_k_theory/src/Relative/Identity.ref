\import algebraic_topology.Pointed[A := model.Carrier].Maps[B := model.Carrier] \as Maps;
\definition map: Map model model := \into[model.Carrier -> model.Carrier]((\fun (x: model.Carrier) => x), Map model model) \by {
  Maps.Laws[pointed model, pointed model, (\fun (x: model.Carrier) => x)] {
    continuous := topology.Maps[A := model.Carrier, B := model.Carrier].Identity[].continuous (details model).topology,
    pointed := \refl((details model).point)
  }
};
