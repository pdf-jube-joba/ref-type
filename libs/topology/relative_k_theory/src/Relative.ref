\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import topological_k_theory.KTheory[] \as KTheory;
\import complex.Complex[] \as C;
\import C.Algebra[] \as Algebra;
\import linear_algebra.Hermitian[].Complex[] \as Hermitian;
\import vector_bundles.Bundles[].Complex[] \as Scalar;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := Algebra.field, conjugation := Hermitian.scalar, scalar := Scalar.scalar] \as Bundles;
\import bundle_operations.Operations[].Over[K := C.Complex, field := Algebra.field, conjugation := Hermitian.scalar, scalar := Scalar.scalar] \as Operations;
\structure CompactPointed: \Set := {
  Carrier: \Set,
  topology: topology.Topology[Carrier := Carrier].Topology,
  compact: topology.Topology[Carrier := Carrier].IsCompact topology,
  hausdorff: topology.Topology[Carrier := Carrier].IsT2 topology,
  point: Carrier
};
\module Reduced(model: CompactPointed);
\module Suspension(original: CompactPointed);
\definition iterate[n: N.Nat^][original: CompactPointed]: CompactPointed :=
  (\induction (n: N.Nat^) \return CompactPointed \with {
    | zero: original
    | succ: \fun (n: N.Nat^)(previous: CompactPointed) => Suspension[original := previous].result
  }) n;
\module Negative(original: CompactPointed, degree: N.Nat^);
\module Pair(X: \Set, space: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact space,
  hausdorff: topology.Topology[Carrier := X].IsT2 space,
  subset: \Pow X, closed: topology.Topology[Carrier := X].IsClosedIn space subset);
