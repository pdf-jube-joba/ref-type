/* Continuity of concatenation in finite Euclidean coordinates. */
\import linear_algebra.Commutative[K := Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Real (real.Analysis[].Algebra[].field)] \as Spaces;
\import Spaces.CoordinateSum[n := n, m := m] \as Blocks;
\import Fin.Sum[m := n, n := m] \as Indices;
\import Indices.Tuples[A := Real] \as Tuples;
\import \parent.Dimension[n := n].Topology[] \as Left;
\import \parent.Dimension[n := m].Topology[] \as Right;
\import \parent.Dimension[n := Blocks.dimension].Topology[] \as Total;
\definition LeftPoint: \Set := Fin.Fin n -> Real;
\definition RightPoint: \Set := Fin.Fin m -> Real;
\definition Point: \Set := Fin.Fin Blocks.dimension -> Real;
\module Joining(X: \Set);
