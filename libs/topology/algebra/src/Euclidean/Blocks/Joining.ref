\import topology.Topology[Carrier := X] \as Source;
\import topology.Continuity[A := X, B := LeftPoint] \as First;
\import topology.Continuity[A := X, B := RightPoint] \as Second;
\import topology.Continuity[A := X, B := Point] \as Result;
\import topology.Continuity[A := X, B := Real] \as Scalar;
\import metric_spaces.RealLine[] \as Line;
\import \root.Coordinates[K := Real, I := Fin.Fin Blocks.dimension].Universal[A := X] \as Coordinates;
\import topology.Composition[A := X, B := LeftPoint, C := Real] \as LeftCompose;
\import topology.Composition[A := X, B := RightPoint, C := Real] \as RightCompose;
\module On(source: Source.Topology, f: X -> LeftPoint, g: X -> RightPoint,
  left: First.Continuous source Left.topology f, right: Second.Continuous source Right.topology g);
\definition continuous: \forall (source: Source.Topology)(f: X -> LeftPoint)(g: X -> RightPoint) -> First.Continuous source Left.topology f -> Second.Continuous source Right.topology g ->
  Result.Continuous source Total.topology (\fun (x: X) => Blocks.join (f x) (g x)) :=
  \fun (source: Source.Topology)(f: X -> LeftPoint)(g: X -> RightPoint)(left: _)(right: _) => On[source := source, f := f, g := g, left := left, right := right].continuous;
