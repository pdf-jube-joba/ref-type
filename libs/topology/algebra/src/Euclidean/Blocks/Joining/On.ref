\definition cases: \forall (i: Indices.Index) -> Scalar.Continuous source Line.topology (\fun (x: X) => Tuples.evaluate (f x) (g x) i) :=
  \induction (i: Indices.Index) \return Scalar.Continuous source Line.topology (\fun (x: X) => Tuples.evaluate (f x) (g x) i) \with {
    | inl: \fun (i: Fin.Fin n) => LeftCompose.composeContinuous source Left.topology Line.topology f (\fun (v: LeftPoint) => v i) left (Left.coordinateContinuous i)
    | inr: \fun (i: Fin.Fin m) => RightCompose.composeContinuous source Right.topology Line.topology g (\fun (v: RightPoint) => v i) right (Right.coordinateContinuous i)
  };
\definition coordinates: Result.Continuous source Total.coordinateTopology (\fun (x: X) => Blocks.join (f x) (g x)) :=
  Coordinates.continuous source Line.topology (\fun (x: X) => Blocks.join (f x) (g x)) (\fun (i: Fin.Fin Blocks.dimension) => cases (Indices.split i));
\definition continuous: Result.Continuous source Total.topology (\fun (x: X) => Blocks.join (f x) (g x)) :=
  \fun (W: \Pow Point)(open: _) => coordinates W (Total.metricOpen W open);
