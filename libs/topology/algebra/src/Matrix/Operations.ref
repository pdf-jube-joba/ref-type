\import std.Alg[].Ring[] \as Ring;
\definition plus[ring: Ring.CommutativeRing[K]] [a, b: Carrier]: Carrier :=
  \fun (i: I) (j: J) => (ring.base).add (a i j) (b i j);
\definition negative[ring: Ring.CommutativeRing[K]] [a: Carrier]: Carrier :=
  \fun (i: I) (j: J) => (ring.base).neg (a i j);
\definition scale[ring: Ring.CommutativeRing[K]] [c: K] [a: Carrier]: Carrier :=
  \fun (i: I) (j: J) => (ring.base).mul c (a i j);
\definition transpose[a: Carrier]: J -> I -> K := \fun (j: J) (i: I) => a i j;
\module Functions(A: \Set);
\module Composition(H: \Set);
