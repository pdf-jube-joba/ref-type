\import topology.Topology[Carrier := A] \as Source;
\import topology.Continuity[A := A, B := Carrier] \as Maps;
\import topology.Continuity[A := A, B := K] \as Entries;
\import Rows.Universal[A := A] \as RowMaps;
\import Matrices.Universal[A := A] \as MatrixMaps;
\definition continuous: \forall (source: Source.Topology) (scalar: Scalars.Topology) (f: A -> Carrier) ->
  (\forall (i: I) (j: J) -> Entries.Continuous source scalar (\fun (x: A) => f x i j)) ->
  Maps.Continuous source (topology scalar) f :=
  \fun (source: _) (scalar: _) (f: _) (entries: _) => MatrixMaps.continuous source (Rows.topology scalar) f
    (\fun (i: I) => RowMaps.continuous source scalar (\fun (x: A) => f x i) (entries i));
