\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.eq_reason_in;
\import std.Logic[].Proposition[] \as Logic;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import \root.StandardClosedProduct[n := n, m := m, K := K, ring := ring] \as Closed;
\import \root.StandardProduct[n := n, m := m, K := K, ring := ring] \as Actual;
\import \root.StandardProductShell[n := n, m := m] \as Bridge;
\import Bridge.Families[] \as Families;
\import Bridge.Pair[] \as PairGeometry;
\import \root.StandardShell[n := n] \as LeftShell;
\import \root.StandardShell[n := m] \as RightShell;
\import \root.LocalDisk[].Point[K := K, ring := ring].Rank[n := n] \as LeftPoint;
\import \root.LocalDisk[].Point[K := K, ring := ring].Rank[n := m] \as RightPoint;
\import algebraic_topology.Euclidean[].Dimension[n := n] \as Left;
\import algebraic_topology.Euclidean[].Dimension[n := m] \as Right;
\import algebraic_topology.Euclidean[].Dimension[n := Closed.degree] \as Total;
\import singular_products.Cochains[A := Closed.Carrier, source := Closed.topology, R := K, ring := ring] \as Coefficients;
\import Families.With[coefficients := Coefficients.integerCoefficients].At[z := I.Int^::ofNat Closed.degree] \as FamilyComparison;
\definition familyIsomorphism: _ := FamilyComparison.isomorphism;
\import \root.FamilyProduct[A := Closed.Carrier, source := Closed.topology, first := Bridge.shellFirst, second := Bridge.shellSecond, family := Bridge.shellFamily,
  firstMember := Logic.Or[Bridge.shellFirst = Bridge.shellFirst, Bridge.shellFirst = Bridge.shellSecond]::left (\refl(Bridge.shellFirst)), secondMember := Logic.Or[Bridge.shellSecond = Bridge.shellFirst, Bridge.shellSecond = Bridge.shellSecond]::right (\refl(Bridge.shellSecond)),
  classify := (\fun (U: \Pow Closed.Carrier)(member: \In[\Pow Closed.Carrier] Bridge.shellFamily U) => member), K := K, ring := ring] \as ShellProduct;
\import ShellProduct.Degree[p := n, q := m].Cohomology[] \as ShellCup;
\import ShellProduct.From[Y := Closed.Carrier, target := Closed.topology, firstPart := Closed.firstPart, secondPart := Closed.secondPart, newFamily := Closed.family,
  newFirstMember := Closed.firstMember, newSecondMember := Closed.secondMember, newClassify := Closed.classify,
  f := Bridge.identity, regular := Bridge.identityContinuous, firstContained := Families.intoFirst, secondContained := Families.intoSecond] \as Natural;
\import \root.RelativePullback[].On[A := Closed.Carrier, source := Closed.topology, subset := Bridge.shellFirst, R := K, ring := ring].To[B := Left.Disk, target := Left.diskTopology, part := LeftShell.shell].Along[f := Actual.leftMap] \as LeftPull;
\import \root.RelativePullback[].On[A := Closed.Carrier, source := Closed.topology, subset := Bridge.shellSecond, R := K, ring := ring].To[B := Right.Disk, target := Right.diskTopology, part := RightShell.shell].Along[f := Actual.rightMap] \as RightPull;
\definition firstClass[a: LeftPoint.Class]: _ := LeftPull.Degree[n := n].map.apply (LeftShell.Ring[K := K, ring := ring].lift a);
\definition secondClass[b: RightPoint.Class]: _ := RightPull.Degree[n := m].map.apply (RightShell.Ring[K := K, ring := ring].lift b);
\definition shellProduct[a: LeftPoint.Class][b: RightPoint.Class]: _ := ShellCup.product (firstClass a) (secondClass b);
\module First;
\module Second;
\module Product;
