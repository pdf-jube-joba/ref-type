\import \parent.PointModel[] \as PointCoordinates;
\import thom_spaces.Thom[].DiskSuspension[X := Point.Carrier, space := Point.topology, n := n] \as DiskPoint;
\import \root.LocalDisk[].Point[K := K, ring := ring].Rank[n := n] \as PointClass;
\import singular_products.Cochains[A := Point.Carrier, source := Point.topology, R := K, ring := ring] \as Product;
\import \root.RelativePullback[].On[A := Euclidean.Disk, source := Euclidean.diskTopology, subset := boundary, R := K, ring := ring].To[B := DiskPoint.DiskCarrier, target := DiskPoint.diskTopology, part := DiskPoint.boundary].Homeomorphism[data := PointCoordinates.pair] \as Comparison;
\import \parent.With[coefficients := Product.integerCoefficients, z := I.Int^::ofNat n] \as ShellComparison;
\import singular_cohomology.Relative[A := Euclidean.Disk, source := Euclidean.diskTopology, subset := boundary].With[coefficients := Product.integerCoefficients].At[z := I.Int^::ofNat n] \as Boundary;
\import singular_cohomology.Relative[A := Euclidean.Disk, source := Euclidean.diskTopology, subset := shell].With[coefficients := Product.integerCoefficients].At[z := I.Int^::ofNat n] \as Neighborhood;
\definition map[u: PointClass.Class]: Boundary.Carrier := Comparison.Degree[n := n].isomorphism.forward.apply u;
\definition lift[u: PointClass.Class]: Neighborhood.Carrier := ShellComparison.lift (map u);
\definition normalized: \forall (u: PointClass.Class) -> ShellComparison.map.apply (lift u) = map u := \fun (u: PointClass.Class) => ShellComparison.normalized (map u);
\definition generator: Boundary.Carrier := map PointClass.generator;
\definition shellGenerator: Neighborhood.Carrier := lift PointClass.generator;
\definition generatorLaw: ShellComparison.map.apply shellGenerator = generator := normalized PointClass.generator;

\module Linear;
