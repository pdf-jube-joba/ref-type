\import singular_cohomology.Relative[A := DiskPoint.DiskCarrier, source := DiskPoint.diskTopology, subset := DiskPoint.boundary].With[coefficients := Product.integerCoefficients].At[z := I.Int^::ofNat n] \as Input;
\import singular_cohomology.Relative[A := Euclidean.Disk, source := Euclidean.diskTopology, subset := boundary].Homeomorphism[B := DiskPoint.DiskCarrier].Over[target := DiskPoint.diskTopology, targetSubset := DiskPoint.boundary] \as Pairs;
\import \root.RelativePullback[].On[A := Euclidean.Disk, source := Euclidean.diskTopology, subset := boundary, R := K, ring := ring].To[B := DiskPoint.DiskCarrier, target := DiskPoint.diskTopology, part := DiskPoint.boundary].Along[f := Pairs.forwardMap PointCoordinates.pair] \as Native;
\import Modules.Hom[V := Boundary.Carrier, W := Neighborhood.Carrier, source := Boundary.space, target := Neighborhood.space].Composition[U := Input.Carrier, domain := Input.space] \as Composition;
\definition linear: Modules.Hom[V := Input.Carrier, W := Neighborhood.Carrier, source := Input.space, target := Neighborhood.space].Map := Composition.compose ShellComparison.isomorphism.backward Native.Degree[n := n].map;
\definition law: \forall (a: PointClass.Class) -> linear.apply a = lift a := \fun (a: PointClass.Class) => \refl(lift a);
