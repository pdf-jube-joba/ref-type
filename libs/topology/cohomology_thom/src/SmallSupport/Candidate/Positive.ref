\import Boundary.At[n := N.Nat^::succ k] \as Current;
\definition native: \forall (x: Whole.Carrier (N.Nat^::succ k)) -> Current.Image x -> Current.Image ((Cover.candidateMap (N.Nat^::succ k)).apply x) :=
  \fun (x: Whole.Carrier (N.Nat^::succ k))(member: Current.Image x) => Current.submodule.addition x _ member
    (Current.submodule.addition _ _
      (\parent.\parent.BoundaryMap[n := N.Nat^::succ k].law ((Cover.homotopyMap (N.Nat^::succ k)).apply x) (homotopyPreserves (N.Nat^::succ k) x member))
      (homotopyPreserves k ((Whole.boundary k).apply x) (\parent.\parent.BoundaryMap[n := k].law x member)));
\definition law: Preserves := \idelim (N.Nat^::succ k) = n \with j: N.Nat^ =>
  \forall (x: Whole.Carrier j) -> Boundary.At[n := j].Image x -> Boundary.At[n := j].Image ((Cover.candidateMap j).apply x) \by {
    base: native, equality: sym!{N.Nat^} _ _ same
  };
