\import Boundary.At[n := N.Nat^::zero] \as Current;
\definition law: \forall (x: Whole.Carrier N.Nat^::zero) -> Current.Image x -> Current.Image ((Cover.candidateMap N.Nat^::zero).apply x) :=
  \fun (x: Whole.Carrier N.Nat^::zero)(member: Current.Image x) => Current.submodule.addition x _ member
    (\parent.\parent.BoundaryMap[n := N.Nat^::zero].law ((Cover.homotopyMap N.Nat^::zero).apply x) (homotopyPreserves N.Nat^::zero x member));
