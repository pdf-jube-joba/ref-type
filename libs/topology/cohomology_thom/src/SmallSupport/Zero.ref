\import Boundary.At[n := N.Nat^::zero] \as Lower;
\import Boundary.At[n := N.Nat^::succ N.Nat^::zero] \as Higher;
\definition onGenerator: \forall (sigma: BoundarySimplices.Carrier N.Nat^::zero) -> Higher.Image ((Cover.homotopyMap N.Nat^::zero).apply (Whole.generator N.Nat^::zero sigma)) :=
  \fun (sigma: BoundarySimplices.Carrier N.Nat^::zero) => transport!{{Whole.Carrier (N.Nat^::succ N.Nat^::zero)}} Higher.Image _ _
    (sym!{{Whole.Carrier (N.Nat^::succ N.Nat^::zero)}} _ _ (Cover.Zero[].onGenerator sigma))
    (Boundary.HomotopyPersistence[n := N.Nat^::zero].law (Cover.Selection[n := N.Nat^::zero].minimum (Whole.generator N.Nat^::zero sigma))
      (Whole.generator N.Nat^::zero sigma) (Lower.generatorImage sigma));
\definition law: Property N.Nat^::zero := \parent.Degree[n := N.Nat^::zero].On[f := Cover.homotopyMap N.Nat^::zero, generators := onGenerator].law;
