\import Boundary.At[n := n] \as Lower;
\import Boundary.At[n := N.Nat^::succ n] \as Higher;
\import Modules.Hom[V := Whole.Carrier n, W := Whole.Carrier (N.Nat^::succ n), source := Whole.space n, target := Whole.space (N.Nat^::succ n)] \as Maps;
\definition Preserves[f: Maps.Map]: \Prop := \forall (x: Whole.Carrier n) -> Lower.Image x -> Higher.Image (f.apply x);
\module On(f: Maps.Map, generators: \forall (sigma: BoundarySimplices.Carrier n) -> Higher.Image (f.apply (Whole.generator n sigma)));
