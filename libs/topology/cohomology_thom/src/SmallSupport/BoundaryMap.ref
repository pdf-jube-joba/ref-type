\import Boundary.At[n := n] \as Lower;
\import Boundary.At[n := N.Nat^::succ n] \as Higher;
\definition law: \forall (x: Whole.Carrier (N.Nat^::succ n)) -> Higher.Image x -> Lower.Image ((Whole.boundary n).apply x) := \block {
  \fun (x: Whole.Carrier (N.Nat^::succ n))(member: Higher.Image x) \then
  \takefrom y: \Cast[Boundary.Carrier (N.Nat^::succ n)] ({ y: Boundary.Carrier (N.Nat^::succ n) \where Higher.inclusion.apply y = x }) \by member \then
  \let same: Higher.inclusion.apply y = x := \bysub(Boundary.Carrier (N.Nat^::succ n), { y: Boundary.Carrier (N.Nat^::succ n) \where Higher.inclusion.apply y = x }, y) \then
  \return Logic.existsIntro[Boundary.Carrier n, { v: Boundary.Carrier n \where Lower.inclusion.apply v = (Whole.boundary n).apply x }]
    (Boundary.complex.differential.apply n y)
    (trans!{{Whole.Carrier n}} _ _ _ (sym!{{Whole.Carrier n}} _ _ (Boundary.inclusion.commutes n y))
      (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier n}} ((Whole.boundary n).apply) _ _ same))
};
