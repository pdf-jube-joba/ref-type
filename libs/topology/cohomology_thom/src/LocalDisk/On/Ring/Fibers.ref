\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Top[n := n] \as Coordinates;
\import \parent.Standard[n := n] \as Target;
\definition isomorphism: _ := Coordinates.isomorphism;
\definition evaluation: Target.Class -> X -> RingCarrier := Coordinates.evaluation;
\definition detected: _ := Coordinates.detected;
\module Fiber(x: X);
\definition detectedOnFibers: \forall (u, v: Target.Class) -> (\forall (x: X) -> Fiber[x := x].restriction.apply u = Fiber[x := x].restriction.apply v) -> u = v :=
  \fun (u, v: Target.Class)(same: \forall (x: X) -> Fiber[x := x].restriction.apply u = Fiber[x := x].restriction.apply v) => detected u v
    (\fun (x: X) => trans!{RingCarrier} _ _ _ (sym!{RingCarrier} _ _ (Fiber[x := x].value u))
      (trans!{RingCarrier} _ _ _
        (congr!{{\root.LocalDisk[].Point[K := RingCarrier, ring := ring].Rank[n := n].Class} RingCarrier} \root.LocalDisk[].Point[K := RingCarrier, ring := ring].Rank[n := n].isomorphism.backward.apply _ _ (same x))
        (Fiber[x := x].value v)));
\definition uniqueNormalized: \forall (u: Target.Class) ->
  (\forall (x: X) -> Fiber[x := x].restriction.apply u = \root.LocalDisk[].Point[K := RingCarrier, ring := ring].Rank[n := n].generator) -> u = canonical n :=
  \fun (u: Target.Class)(normalized: \forall (x: X) -> Fiber[x := x].restriction.apply u = \root.LocalDisk[].Point[K := RingCarrier, ring := ring].Rank[n := n].generator) =>
    detectedOnFibers u (canonical n) (\fun (x: X) => trans!{{\root.LocalDisk[].Point[K := RingCarrier, ring := ring].Rank[n := n].Class}} _ _ _ (normalized x)
      (sym!{{\root.LocalDisk[].Point[K := RingCarrier, ring := ring].Rank[n := n].Class}} _ _ Fiber[x := x].canonical));
