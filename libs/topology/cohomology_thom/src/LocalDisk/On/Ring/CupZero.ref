\import \parent.Cup[n := N.Nat^::zero, p := p] \as Cup;
\import \root.LocalDisk[].On[X := X, source := source].Zero[].Ring[K := RingCarrier, ring := ring].Degree[p := p] \as Zero;
\definition injective: \forall (a, b: Base.Cohomology[].Group p) -> Cup.apply a = Cup.apply b -> a = b :=
  \fun (a, b: Base.Cohomology[].Group p)(same: Cup.apply a = Cup.apply b) => trans!{{Base.Cohomology[].Group p}} _ _ _
    (sym!{{Base.Cohomology[].Group p}} _ _ (Zero.leftInverse a))
    (trans!{{Base.Cohomology[].Group p}} _ _ _ (congr!{Cup.Class {Base.Cohomology[].Group p}} Zero.backward _ _ same) (Zero.leftInverse b));
\definition bijective: Cup.Bijective := Cup.Bijective {
  injective := injective,
  onto := \fun (y: Cup.Class) => Logic.existsIntro[Base.Cohomology[].Group p, { a: Base.Cohomology[].Group p \where Cup.apply a = y }] (Zero.backward y) (Zero.rightInverse y)
};
