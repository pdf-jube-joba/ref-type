\use std.Logic[].Equality[].eq_reason_in;
\import thom_spaces.Thom[].CWType[].Point[] \as Point;
\definition constant[p: Point.Carrier]: X := x;
\definition regular: topology.Continuity[A := Point.Carrier, B := X].Continuous Point.topology source constant := topology.Maps[A := Point.Carrier, B := X].constantContinuous Point.topology source x;
\import \root.LocalDisk[].Point[K := RingCarrier, ring := ring] \as PointTheory;
\import PointTheory.Rank[n := n] \as PointClass;
\import singular_products.Cochains[A := Point.Carrier, source := Point.topology, R := RingCarrier, ring := ring] \as PointProduct;
\import \root.LocalDisk[].On[X := X, source := source].From[B := Point.Carrier, target := Point.topology, f := constant, regular := regular] \as Maps;
\import Maps.Ring[K := RingCarrier, ring := ring].Top[n := n] \as Natural;
\import \root.LocalDisk[].On[X := Point.Carrier, source := Point.topology].Ring[RingCarrier := RingCarrier, ring := ring].Top[n := n] \as PointTop;
\definition restriction: _ := Maps.Rank[n := n].With[coefficients := Base.integerCoefficients, z := I.Int^::ofNat n].pullback;
\definition coordinate[u: Target.Class]: RingCarrier := PointClass.isomorphism.backward.apply (restriction.apply u);
\import \root.ZeroEvaluation[A := X, source := source, K := RingCarrier, ring := ring].Along[B := Point.Carrier, target := Point.topology, f := constant, regular := regular] \as Values;
\import singular_products.Cochains[A := Point.Carrier, source := Point.topology, R := RingCarrier, ring := ring].Cohomology[].Pullback[B := X, target := source] \as BasePull;
\definition value: \forall (u: Target.Class) -> coordinate u = evaluation u x :=
  \fun (u: Target.Class) => eq_reason_in!{RingCarrier _
    "=" _ "by" { congr!{{PointProduct.Cohomology[].Group N.Nat^::zero} RingCarrier} PointTheory.isomorphism.backward.apply _ _ (Natural.inverse u) }
    "=" _ "by" { PointTheory.value (BasePull.apply N.Nat^::zero constant regular (isomorphism.backward.apply u)) }
    "=" _ "by" { Values.law (isomorphism.backward.apply u) Point.point }
  };
\definition canonical: restriction.apply (\root.LocalDisk[].On[X := X, source := source].Ring[RingCarrier := RingCarrier, ring := ring].canonical n) = PointClass.generator := Maps.Ring[K := RingCarrier, ring := ring].canonical n;
