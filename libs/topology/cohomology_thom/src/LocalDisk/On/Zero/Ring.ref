\import singular_products.Cochains[A := X, source := source, R := K, ring := ring] \as BaseProduct;
\import singular_products.Cochains[A := Disk.Carrier, source := Disk.topology, R := K, ring := ring] \as DiskProduct;
\import singular_cap.CochainPair[A := Disk.Carrier, source := Disk.topology, subset := Disk.boundary, R := K, ring := ring] \as Cup;
\import \root.RelativeMayerVietoris[].Pair[A := Disk.Carrier, source := Disk.topology, subset := Disk.boundary]
  .Empty[empty := (\fun (p: \Cast[Disk.Carrier] Disk.boundary) => Geometry.forwardPreserves p (\bysub(Disk.Carrier, Disk.boundary, p)))].Ring[R := K, ring := ring] \as EmptyDisk;
\import singular_cohomology.Relative[A := Disk.Carrier, source := Disk.topology, subset := Disk.boundary].OverRing[R := K, ring := ring].With[coefficients := DiskProduct.coefficients] \as Relative;
\import chain_complexes.Integer[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as RingCochains;
\import RingCochains.At[C := Relative.complex, z := I.Int^::ofNat N.Nat^::zero] \as Top;
\import Cup.Comparison[n := N.Nat^::zero].Cohomology[] \as TopForget;
\definition class: Top.Cohomology := EmptyDisk.Degree[n := N.Nat^::zero].isomorphism.backward.apply DiskProduct.Cohomology[].Unit[].class;
\definition forgetClass: TopForget.map.apply class = DiskProduct.Cohomology[].Unit[].class := EmptyDisk.Degree[n := N.Nat^::zero].isomorphism.rightInverse DiskProduct.Cohomology[].Unit[].class;
\import DiskProduct.Cohomology[].Pullback[B := X, target := source] \as Pull;
\import BaseProduct.Cohomology[].Pullback[B := Disk.Carrier, target := Disk.topology] \as Push;
\import algebraic_topology.HomotopyEquivalence[A := Disk.Carrier, B := X] \as Homotopy;
\definition equivalence: Homotopy.Equivalence[Disk.topology, source] := Homotopy.fromHomeomorphism Disk.topology source Geometry.diskHomeomorphism;
\import singular_cohomology.Equivalence[A := Disk.Carrier, B := X, source := Disk.topology, target := source].With[coefficients := DiskProduct.integerCoefficients] \as Equivalence;
\module Degree(p: N.Nat^);
