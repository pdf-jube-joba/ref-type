\definition z: I.Int^ := I.Int^::negSucc k;
\import singular_cohomology.Chains[A := X, source := source] \as Chains;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].ZeroExtension[P := Chains.complex, N := coefficients].Negative[n := k] \as Negative;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring].At[C := Base.complex, z := z] \as H;
\import Modules.Hom[V := H.Closed, W := H.Cohomology, source := H.cycleSpace, target := H.cohomologySpace] \as Classes;
\definition baseZero: \forall (q: H.Cohomology) -> q = H.cohomologySpace.zero :=
  H.classInduction (\fun (q: H.Cohomology) => q = H.cohomologySpace.zero)
    (\fun (h: H.Closed) => trans!{H.Cohomology} _ _ _
      (congr!{H.Closed H.Cohomology} H.classOf h H.cycleSpace.zero (Negative.zero h)) (Classes.zeroPreserved H.classLinear));
\import \parent.\parent.Dimension[n := n].With[coefficients := coefficients, z := shift n z] \as Target;
\definition zero: \forall (q: Target.Group) -> q = Target.space.zero :=
  Modules.Isomorphism[V := H.Cohomology, W := Target.Group, source := H.cohomologySpace, target := Target.space].Vanishing[].targetZero (isomorphism n z) baseZero;
