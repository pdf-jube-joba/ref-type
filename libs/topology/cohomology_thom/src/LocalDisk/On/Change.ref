\import singular_products.Cochains[A := X, source := source, R := K, ring := ring] \as SourceProduct;
\import singular_products.Cochains[A := X, source := source, R := L, ring := targetRing] \as TargetProduct;
\import \parent.Ring[RingCarrier := K, ring := ring] \as SourceTheory;
\import \parent.Ring[RingCarrier := L, ring := targetRing] \as TargetTheory;
\module Rank(n: N.Nat^);
\module Zero;
\definition canonical: \forall (n: N.Nat^) -> Rank[n := n].map.apply (SourceTheory.canonical n) = TargetTheory.canonical n :=
  \induction (n: N.Nat^) \return Rank[n := n].map.apply (SourceTheory.canonical n) = TargetTheory.canonical n \with {
    | zero: Zero[].law
    | succ: \fun (n: N.Nat^)(previous: Rank[n := n].map.apply (SourceTheory.canonical n) = TargetTheory.canonical n) =>
      trans!{{TargetTheory.Standard[n := N.Nat^::succ n].Class}} _ _ _
        (\parent.Step[n := n].ChangeCoefficients[M := SourceProduct.integerCoefficients, N := TargetProduct.integerCoefficients, u := morphism.linear, z := I.Int^::ofNat n].law (SourceTheory.canonical n))
        (congr!{{TargetTheory.Standard[n := n].Class} {TargetTheory.Standard[n := N.Nat^::succ n].Class}}
          \parent.Step[n := n].With[coefficients := TargetProduct.integerCoefficients, z := I.Int^::ofNat n].isomorphism.forward.apply _ _ previous)
  };
