\import singular_products.Cochains[A := X, source := source, R := RingCarrier, ring := ring] \as Base;
\import \parent.With[coefficients := Base.integerCoefficients] \as Additive;
\import singular_cohomology.Cochains[A := X, source := source].With[coefficients := Base.integerCoefficients].Integer[] \as IntegerBase;
\definition zero: I.Int^ := I.Int^::ofNat N.Nat^::zero;
\definition integerUnit: IntegerBase.cohomology zero := IntegerBase.At[n := N.Nat^::zero].isomorphism.backward.apply Base.Cohomology[].Unit[].class;
\module Rank(n: N.Nat^) {
  \import \parent.\parent.Dimension[n := n].With[coefficients := Base.integerCoefficients, z := shift n zero] \as Relative;
  \definition Class: \Set := Relative.Group;
  \definition localClass: Class := (Additive.isomorphism n zero).forward.apply integerUnit;
  \definition coordinate[q: Class]: IntegerBase.cohomology zero := (Additive.isomorphism n zero).backward.apply q;
  \definition coordinateOfClass: coordinate localClass = integerUnit := (Additive.isomorphism n zero).leftInverse integerUnit;
  \definition unique: \forall (q: Class) -> coordinate q = integerUnit -> q = localClass :=
    \fun (q: Class)(same: coordinate q = integerUnit) => trans!{Class} _ _ _
      (sym!{Class} _ _ ((Additive.isomorphism n zero).rightInverse q))
      (congr!{{IntegerBase.cohomology zero} Class} (Additive.isomorphism n zero).forward.apply _ _ same);
}
