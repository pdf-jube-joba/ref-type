\import thom_spaces.Thom[].DiskSuspension[X := X, space := source, n := n] \as Disk;
\import algebraic_topology.Euclidean[].Dimension[n := n] \as Coordinates;
\definition projection[p: Disk.DiskCarrier]: X := std.Data[].Pair[].first X Coordinates.Coordinate p;
\definition continuous: topology.Continuity[A := Disk.DiskCarrier, B := X].Continuous Disk.diskTopology source projection :=
  topology.Continuity[A := Disk.Point, B := X].Restriction[S := Disk.disk].restrictContinuous Disk.totalTopology source (std.Data[].Pair[].first X Coordinates.Coordinate)
    (topological_constructions.Product[A := X, B := Coordinates.Coordinate].Maps[].firstContinuous source Coordinates.topology);
