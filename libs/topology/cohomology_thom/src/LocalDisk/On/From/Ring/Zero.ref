\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Rank[n := N.Nat^::zero] \as Rank;
\import thom_spaces.Thom[].DiskSuspension[X := X, space := source, n := N.Nat^::zero] \as SourceDisk;
\import thom_spaces.Thom[].DiskSuspension[X := B, space := target, n := N.Nat^::zero] \as TargetDisk;
\import thom_spaces.Thom[].ZeroDiskSuspension[X := B, source := target] \as Geometry;
\import \root.LocalDisk[].On[X := X, source := source].Zero[].Ring[K := K, ring := ring] \as SourceZero;
\import \root.LocalDisk[].On[X := B, source := target].Zero[].Ring[K := K, ring := ring] \as TargetZero;
\import \root.RelativeMayerVietoris[].Pair[A := TargetDisk.DiskCarrier, source := TargetDisk.diskTopology, subset := TargetDisk.boundary]
  .Empty[empty := (\fun (p: \Cast[TargetDisk.DiskCarrier] TargetDisk.boundary) => Geometry.forwardPreserves p (\bysub(TargetDisk.DiskCarrier, TargetDisk.boundary, p)))].Ring[R := K, ring := ring].Degree[n := N.Nat^::zero] \as Injective;
\import \root.RelativePullback[].On[A := TargetDisk.DiskCarrier, source := TargetDisk.diskTopology, subset := TargetDisk.boundary, R := K, ring := ring].To[B := SourceDisk.DiskCarrier, target := SourceDisk.diskTopology, part := SourceDisk.boundary].Along[f := Rank.pair] \as Pull;
\import singular_products.Cochains[A := SourceDisk.DiskCarrier, source := SourceDisk.diskTopology, R := K, ring := ring] \as Input;
\import singular_products.Cochains[A := TargetDisk.DiskCarrier, source := TargetDisk.diskTopology, R := K, ring := ring] \as Output;
\import Output.Cohomology[].Pullback[B := SourceDisk.DiskCarrier, target := SourceDisk.diskTopology] \as Absolute;
\definition law: Rank.With[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat N.Nat^::zero].pullback.apply SourceZero.class = TargetZero.class := Injective.injective _ _
  (eq_reason_in!{{Output.Cohomology[].Group N.Nat^::zero} _
    "=" _ "by" { Pull.Degree[n := N.Nat^::zero].Forget[].law SourceZero.class }
    "=" _ "by" { congr!{{Input.Cohomology[].Group N.Nat^::zero} {Output.Cohomology[].Group N.Nat^::zero}} (Absolute.apply N.Nat^::zero Rank.map Rank.continuous) _ _ SourceZero.forgetClass }
    "=" _ "by" { Absolute.Unit[].law Rank.map Rank.continuous }
    "=" _ "by" { sym!{{Output.Cohomology[].Group N.Nat^::zero}} _ _ TargetZero.forgetClass }
  });
