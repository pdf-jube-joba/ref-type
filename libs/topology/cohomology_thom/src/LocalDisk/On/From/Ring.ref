\import singular_products.Cochains[A := X, source := source, R := K, ring := ring] \as BaseProduct;
\import \root.LocalDisk[].On[X := X, source := source].Ring[RingCarrier := K, ring := ring] \as SourceTheory;
\import \root.LocalDisk[].On[X := B, source := target].Ring[RingCarrier := K, ring := ring] \as TargetTheory;
\module Zero;
\definition canonical: \forall (n: N.Nat^) -> \parent.Rank[n := n].With[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].pullback.apply (SourceTheory.canonical n) = TargetTheory.canonical n :=
  \induction (n: N.Nat^) \return \parent.Rank[n := n].With[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].pullback.apply (SourceTheory.canonical n) = TargetTheory.canonical n \with {
    | zero: Zero[].law
    | succ: \fun (n: N.Nat^)(previous: \parent.Rank[n := n].With[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].pullback.apply (SourceTheory.canonical n) = TargetTheory.canonical n) =>
      trans!{{TargetTheory.Standard[n := N.Nat^::succ n].Class}} _ _ _
        (\parent.Step[n := n].With[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].law (SourceTheory.canonical n))
        (congr!{{TargetTheory.Standard[n := n].Class} {TargetTheory.Standard[n := N.Nat^::succ n].Class}}
          \root.LocalDisk[].On[X := B, source := target].Step[n := n].With[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].isomorphism.forward.apply _ _ previous)
  };

\module Degree(n, p: N.Nat^);
