\import \parent.Rank[n := n] \as Lower;
\import \parent.Rank[n := N.Nat^::succ n] \as Higher;
\import \root.LocalDisk[].On[X := X, source := source].Step[n := n] \as SourceStep;
\import \root.LocalDisk[].On[X := B, source := target].Step[n := n] \as TargetStep;
\import thom_spaces.Thom[].DiskSuspension[X := X, space := source, n := n] \as SourceDisk;
\import thom_spaces.Thom[].DiskSuspension[X := X, space := source, n := N.Nat^::succ n] \as SourceHigher;
\import SourceDisk.Step[] \as SourceGeometry;
\import algebraic_topology.Cylinder[A := SourceDisk.DiskCarrier] \as SourceCylinder;
\import \root.RelativeSuspension[].On[A := SourceDisk.DiskCarrier, source := SourceDisk.diskTopology, subset := SourceDisk.boundary] \as SourceSuspension;
\import singular_cohomology.Relative[A := SourceHigher.DiskCarrier, source := SourceHigher.diskTopology, subset := SourceHigher.boundary] \as SourcePair;
\import SourcePair.Homeomorphism[B := SourceGeometry.BoxCarrier].Over[target := SourceGeometry.boxTopology, targetSubset := SourceGeometry.BoxBoundary] \as SourceRound;
\import singular_cohomology.Relative[A := SourceGeometry.BoxCarrier, source := SourceGeometry.boxTopology, subset := SourceGeometry.BoxBoundary].Homeomorphism[B := SourceCylinder.Carrier].Over[target := SourceSuspension.topology, targetSubset := SourceSuspension.boundary] \as SourceBox;
\import SourcePair.Maps[B := SourceGeometry.BoxCarrier].Over[target := SourceGeometry.boxTopology, targetSubset := SourceGeometry.BoxBoundary].Composition[C := SourceCylinder.Carrier].Over[final := SourceSuspension.topology, finalSubset := SourceSuspension.boundary] \as SourceCompose;
\definition sourceTotal: _ := SourceCompose.compose (SourceRound.forwardMap SourceStep.round) (SourceBox.forwardMap SourceStep.cylinder);
\import thom_spaces.Thom[].DiskSuspension[X := B, space := target, n := n] \as TargetDisk;
\import thom_spaces.Thom[].DiskSuspension[X := B, space := target, n := N.Nat^::succ n] \as TargetHigher;
\import TargetDisk.Step[] \as TargetGeometry;
\import algebraic_topology.Cylinder[A := TargetDisk.DiskCarrier] \as TargetCylinder;
\import \root.RelativeSuspension[].On[A := TargetDisk.DiskCarrier, source := TargetDisk.diskTopology, subset := TargetDisk.boundary] \as TargetSuspension;
\import singular_cohomology.Relative[A := TargetHigher.DiskCarrier, source := TargetHigher.diskTopology, subset := TargetHigher.boundary] \as TargetPair;
\import TargetPair.Homeomorphism[B := TargetGeometry.BoxCarrier].Over[target := TargetGeometry.boxTopology, targetSubset := TargetGeometry.BoxBoundary] \as TargetRound;
\import singular_cohomology.Relative[A := TargetGeometry.BoxCarrier, source := TargetGeometry.boxTopology, subset := TargetGeometry.BoxBoundary].Homeomorphism[B := TargetCylinder.Carrier].Over[target := TargetSuspension.topology, targetSubset := TargetSuspension.boundary] \as TargetBox;
\import TargetPair.Maps[B := TargetGeometry.BoxCarrier].Over[target := TargetGeometry.boxTopology, targetSubset := TargetGeometry.BoxBoundary].Composition[C := TargetCylinder.Carrier].Over[final := TargetSuspension.topology, finalSubset := TargetSuspension.boundary] \as TargetCompose;
\definition targetTotal: _ := TargetCompose.compose (TargetRound.forwardMap TargetStep.round) (TargetBox.forwardMap TargetStep.cylinder);
\import SourceSuspension.From[B := TargetDisk.DiskCarrier, target := TargetDisk.diskTopology, part := TargetDisk.boundary, f := Lower.pair] \as SuspensionNatural;
\import TargetPair.Maps[B := SourceHigher.DiskCarrier].Over[target := SourceHigher.diskTopology, targetSubset := SourceHigher.boundary].Composition[C := SourceCylinder.Carrier].Over[final := SourceSuspension.topology, finalSubset := SourceSuspension.boundary].On[f := Higher.pair, g := sourceTotal] \as SourcePath;
\import TargetPair.Maps[B := TargetCylinder.Carrier].Over[target := TargetSuspension.topology, targetSubset := TargetSuspension.boundary].Composition[C := SourceCylinder.Carrier].Over[final := SourceSuspension.topology, finalSubset := SourceSuspension.boundary].On[f := targetTotal, g := SuspensionNatural.cylinderPair] \as TargetPath;
\module With(coefficients: Modules.Bundle, z: I.Int^);
