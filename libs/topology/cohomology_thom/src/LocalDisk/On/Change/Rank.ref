\import thom_spaces.Thom[].DiskSuspension[X := X, space := source, n := n] \as Disk;
\import \root.CoefficientChange[].OnSpace[A := Disk.DiskCarrier, source := Disk.diskTopology, R := K, S := L, ring := ring, targetRing := targetRing] \as DiskChange;
\definition diskMorphism: DiskChange.Morphism := DiskChange.Morphism { linear := morphism.linear, multiply := morphism.multiply, unit := morphism.unit };
\import DiskChange.With[morphism := diskMorphism].Relative[subset := Disk.boundary] \as RelativeChange;
\definition map: _ := RelativeChange.Degree[n := n].map;
