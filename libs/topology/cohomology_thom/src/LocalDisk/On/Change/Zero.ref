\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Rank[n := N.Nat^::zero] \as Rank;
\import thom_spaces.Thom[].DiskSuspension[X := X, space := source, n := N.Nat^::zero] \as Disk;
\import thom_spaces.Thom[].ZeroDiskSuspension[X := X, source := source] \as Geometry;
\import \root.LocalDisk[].On[X := X, source := source].Zero[].Ring[K := K, ring := ring] \as SourceZero;
\import \root.LocalDisk[].On[X := X, source := source].Zero[].Ring[K := L, ring := targetRing] \as TargetZero;
\import \root.CoefficientChange[].OnSpace[A := Disk.DiskCarrier, source := Disk.diskTopology, R := K, S := L, ring := ring, targetRing := targetRing].With[morphism := Rank.diskMorphism] \as Change;
\import \root.RelativeMayerVietoris[].Pair[A := Disk.DiskCarrier, source := Disk.diskTopology, subset := Disk.boundary]
  .Empty[empty := (\fun (p: \Cast[Disk.DiskCarrier] Disk.boundary) => Geometry.forwardPreserves p (\bysub(Disk.DiskCarrier, Disk.boundary, p)))].Ring[R := L, ring := targetRing].Degree[n := N.Nat^::zero] \as Injective;
\import singular_products.Cochains[A := Disk.DiskCarrier, source := Disk.diskTopology, R := L, ring := targetRing] \as Output;
\import singular_products.Cochains[A := Disk.DiskCarrier, source := Disk.diskTopology, R := K, ring := ring] \as Input;
\definition law: Rank.map.apply SourceZero.class = TargetZero.class := Injective.injective _ _
  (eq_reason_in!{{Output.Cohomology[].Group N.Nat^::zero} _
    "=" _ "by" { Change.Relative[subset := Disk.boundary].Degree[n := N.Nat^::zero].Forget[].law SourceZero.class }
    "=" _ "by" { congr!{{Input.Cohomology[].Group N.Nat^::zero} {Output.Cohomology[].Group N.Nat^::zero}} Change.Degree[n := N.Nat^::zero].map.apply _ _ SourceZero.forgetClass }
    "=" _ "by" { Change.Unit[].law }
    "=" _ "by" { sym!{{Output.Cohomology[].Group N.Nat^::zero}} _ _ TargetZero.forgetClass }
  });
