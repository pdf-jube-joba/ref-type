\import thom_spaces.Thom[].DiskSuspension[X := X, space := source, n := n] \as Disk;
\import Disk.Step[] \as Geometry;
\import Geometry.Cylinder[] \as CylinderGeometry;
\import thom_spaces.Thom[].DiskSuspension[X := X, space := source, n := N.Nat^::succ n] \as Higher;
\import vector_bundles.Bundles[].Over[K := R.Real, field := R.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Bundles;
\import Bundles.Trivial[X := X, n := N.Nat^::succ n, baseSpace := source] \as Bundle;
\import Bundles.Family[X := X, F := (\fun (x: X) => Bundles.Vector (N.Nat^::succ n))] \as Family;
\import thom_spaces.Thom[].Levels[A := Higher.Point, B := Family.Point, source := Higher.totalTopology, target := Bundle.topology,
  q := Higher.squared, r := Geometry.squared, h := Geometry.totalHomeomorphism, forwardSquared := Geometry.forwardSquared, backwardSquared := Geometry.backwardSquared] \as Levels;
\import singular_cohomology.Relative[A := Higher.DiskCarrier, source := Higher.diskTopology, subset := Higher.boundary]
  .Homeomorphism[B := Geometry.BoxCarrier].Over[target := Geometry.boxTopology, targetSubset := Geometry.BoxBoundary] \as RoundComparison;
\definition round: RoundComparison.Data := RoundComparison.Data {
  homeomorphism := Levels.diskHomeomorphism,
  forwardPreserves := \fun (p: \Cast[Higher.DiskCarrier] Higher.boundary) => Levels.preserves p (\bysub(Higher.DiskCarrier, Higher.boundary, p)),
  backwardPreserves := \fun (p: \Cast[Geometry.BoxCarrier] Geometry.BoxBoundary) => Levels.reversePreserves p (\bysub(Geometry.BoxCarrier, Geometry.BoxBoundary, p))
};
\import algebraic_topology.Cylinder[A := Disk.DiskCarrier] \as Cylinder;
\import \root.RelativeSuspension[].On[A := Disk.DiskCarrier, source := Disk.diskTopology, subset := Disk.boundary] \as Suspension;
\import singular_cohomology.Relative[A := Geometry.BoxCarrier, source := Geometry.boxTopology, subset := Geometry.BoxBoundary]
  .Homeomorphism[B := Cylinder.Carrier].Over[target := Cylinder.topology Disk.diskTopology, targetSubset := Suspension.boundary] \as CylinderComparison;
\definition cylinder: CylinderComparison.Data := CylinderComparison.Data {
  homeomorphism := CylinderGeometry.homeomorphism,
  forwardPreserves := \fun (p: \Cast[Geometry.BoxCarrier] Geometry.BoxBoundary) => CylinderGeometry.forwardPreserves p (\bysub(Geometry.BoxCarrier, Geometry.BoxBoundary, p)),
  backwardPreserves := \fun (p: \Cast[Cylinder.Carrier] Suspension.boundary) => CylinderGeometry.backwardPreserves p (\bysub(Cylinder.Carrier, Suspension.boundary, p))
};
\module With(coefficients: Modules.Bundle, z: I.Int^);

\module Product(K: \Set, ring: std.Alg[].Ring[].CommutativeRing[K], p, q: N.Nat^);

\module ChangeCoefficients(M, N: Modules.Bundle, u: Modules.Hom[V := M.Carrier, W := N.Carrier, source := M.space, target := N.space].Map, z: I.Int^);
