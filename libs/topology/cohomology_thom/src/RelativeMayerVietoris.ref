\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Logic.either;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\module FreeCover(L, R, O, W: \Set,
  cover: Modules.FreePullback[Left := L, Right := R, Overlap := O, Whole := W].Union, boundary: \Pow W);
\module Pair(A: \Set, source: topology.Topology[Carrier := A].Topology, subset: \Pow A);
\module SmallPair(A: \Set, source: topology.Topology[Carrier := A].Topology,
  cover: topology.Topology[Carrier := A].OpenCovers[topology := source].Cover, subset: \Pow A);
\module IntoSmall(A, B: \Set, target: topology.Topology[Carrier := A].Topology, source: topology.Topology[Carrier := B].Topology,
  family: \Pow (\Pow A), f: B -> A, continuous: topology.Continuity[A := B, B := A].Continuous source target f,
  U: \Cast[\Pow A] family, contained: \forall (b: B) -> \In[A] U (f b));
\import chain_complexes.Chain[] \as Degrees;
\import Degrees.Over[R := I.Int^, ring := Integers.ring] \as Chains;
\module ChainSum(C, D: Chains.Complex);
\module ChainNegative(C, D: Chains.Complex, f: Chains.Map[C := C, D := D].Map);
\module OpenCover(A: \Set, source: topology.Topology[Carrier := A].Topology, subset: \Pow A);
