\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.eq_reason_in;
\import Equality.Transport[A := N.Nat^] \as Transport;
\import singular_products.Cochains[A := A, source := source, R := K, ring := ring] \as Ordinary;
\import singular_cap.CochainPair[A := A, source := source, subset := subset, R := K, ring := ring] \as Pair;
\import singular_cohomology.Relative[A := A, source := source, subset := subset].OverRing[R := K, ring := ring].With[coefficients := Ordinary.coefficients] \as Relative;
\import chain_complexes.Integer[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as Cochains;
\definition Raw[n: N.Nat^]: \Set := Relative.Carrier (I.Int^::ofNat n);
\definition Closed[n: N.Nat^]: \Set := Cochains.At[C := Relative.complex, z := I.Int^::ofNat n].Closed;
\definition Class[n: N.Nat^]: \Set := Cochains.At[C := Relative.complex, z := I.Int^::ofNat n].Cohomology;
\definition inclusion[n: N.Nat^][h: Closed n]: Raw n := h;
\definition classOf[n: N.Nat^]: Closed n -> Class n := Cochains.At[C := Relative.complex, z := I.Int^::ofNat n].classOf;
\definition forget[n: N.Nat^]: Raw n -> Ordinary.Carrier n := Pair.Comparison[n := n].from;
\module Degree(n: N.Nat^);

\import module_theory.Module[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as Modules;
\definition space[n: N.Nat^]: Modules.Space (Class n) := Cochains.At[C := Relative.complex, z := I.Int^::ofNat n].cohomologySpace;
\module TransportBetween(m, n: N.Nat^, same: m = n);
