\import Integer.At[C := LeftHom.complex, z := z] \as LeftH;
\import Integer.At[C := RightHom.complex, z := z] \as RightH;
\import Integer.At[C := SumHom.complex, z := z] \as SumH;
\import Modules.Biproduct[V := LeftH.Cohomology, W := RightH.Cohomology, left := LeftH.cohomologySpace, right := RightH.cohomologySpace] \as Pair;
\definition pairZero: \forall (q: Pair.Carrier) -> q = Pair.space.zero :=
  \fun (q: Pair.Carrier) => std.Data[].Pair[].Prop[A := LeftH.Cohomology, B := RightH.Cohomology].ext q Pair.space.zero
    (\parent.\parent.Left[].With[coefficients := coefficients].At[z := z].zero (Pair.first q))
    (\parent.\parent.Right[].With[coefficients := coefficients].At[z := z].zero (Pair.second q));
\definition sumZero: \forall (q: SumH.Cohomology) -> q = SumH.cohomologySpace.zero :=
  Modules.Isomorphism[V := SumH.Cohomology, W := Pair.Carrier, source := SumH.cohomologySpace, target := Pair.space].Vanishing[].sourceZero
    Coordinates.At[z := z].isomorphism pairZero;
