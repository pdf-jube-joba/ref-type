\import \parent.Slice[d := Halves.left] \as Native;
\definition sectionContained: \forall (x: A) -> \In[Cylinder.Carrier] secondPart (Cylinder.at Halves.start x) :=
  \fun (x: A) => Logic.Or[_, _]::left (\refl(J.start));
\import Native.Vanishing[sectionContained := sectionContained] \as Vanishing;
\module With(coefficients: Modules.Bundle) {
  \module At(z: I.Int^) { \definition zero: _ := Vanishing.With[coefficients := coefficients].At[z := z].zero; }
}
