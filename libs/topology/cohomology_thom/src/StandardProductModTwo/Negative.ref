\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Integer[P := Pair.complex, N := Coefficients.integerCoefficients] \as Hom;
\definition cycles: \forall (h: H.Closed) -> H.cycleSpace.neg h = h :=
  \fun (h: H.Closed) => Hom.At[z := I.Int^::ofNat degree].ext (H.cycleSpace.neg h) h
    (\fun (x: Pair.Carrier (I.Int^::ofNat degree)) => \refl(h.apply x));
\import Modules.Hom[V := H.Closed, W := H.Cohomology, source := H.cycleSpace, target := H.cohomologySpace] \as ClassMaps;
\definition onClass: \forall (h: H.Closed) -> H.cohomologySpace.neg (H.classOf h) = H.classOf h :=
  \fun (h: H.Closed) => trans!{H.Cohomology} _ _ _ (sym!{H.Cohomology} _ _ (ClassMaps.negativePreserved H.classLinear h))
    (congr!{H.Closed H.Cohomology} H.classOf (H.cycleSpace.neg h) h (cycles h));
\definition law: \forall (a: H.Cohomology) -> H.cohomologySpace.neg a = a := H.classInduction (\fun (a: H.Cohomology) => H.cohomologySpace.neg a = a) onClass;
