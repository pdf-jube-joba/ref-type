\import \parent.Negative[] \as Negative;
\import Modules.Hom[V := Integral.Class, W := H.Cohomology, source := Integral.space, target := H.cohomologySpace] \as Maps;
\definition signed: \forall (s: B.Bool^) -> OutputChange.boundaryMap.apply (IntegralSigns.signedOutput s Integral.canonical) = canonical :=
  \induction (s: B.Bool^) \return OutputChange.boundaryMap.apply (IntegralSigns.signedOutput s Integral.canonical) = canonical \with {
    | false: OutputChange.boundaryGenerator
    | true: trans!{H.Cohomology} _ _ _ (Maps.negativePreserved OutputChange.boundaryMap Integral.canonical)
      (trans!{H.Cohomology} _ _ _ (congr!{H.Cohomology H.Cohomology} H.cohomologySpace.neg _ _ OutputChange.boundaryGenerator) (Negative.law canonical))
  };
\definition law: product = canonical := eq_reason_in!{H.Cohomology _
  "=" _ "by" { sym!{H.Cohomology} _ _ Change.Product[].generators }
  "=" _ "by" { congr!{Integral.Class H.Cohomology} OutputChange.boundaryMap.apply _ _ Integral.signedLaw }
  "=" _ "by" { signed Integral.reverse }
};
