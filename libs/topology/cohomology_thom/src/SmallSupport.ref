\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.transport;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import singular_cohomology.Chains[A := A, source := source] \as Whole;
\import singular_cohomology.Simplices[A := A, source := source] \as Simplices;
\import singular_subdivision.Small[A := A, source := source, family := family] \as Boundary;
\import Boundary.Simplices[] \as BoundarySimplices;
\import singular_subdivision.OpenCover[A := A, source := source].On[cover := cover] \as Cover;
\module Degree(n: N.Nat^);
\module BoundaryMap(n: N.Nat^);
\definition Property[n: N.Nat^]: \Prop := \forall (x: Whole.Carrier n) -> Boundary.At[n := n].Image x ->
  Boundary.At[n := N.Nat^::succ n].Image ((Cover.homotopyMap n).apply x);
\module Zero;
\module Step(n: N.Nat^, previous: Property n);
\definition homotopyPreserves: \forall (n: N.Nat^) -> Property n :=
  \induction (n: N.Nat^) \return Property n \with {
    | zero: Zero[].law
    | succ: \fun (n: N.Nat^)(previous: Property n) => Step[n := n, previous := previous].law
  };
\module Candidate(n: N.Nat^);
