\import Modules.Hom[V := family.Carrier m, W := family.Carrier n, source := family.space m, target := family.space n] \as Forward;
\import Modules.Hom[V := family.Carrier n, W := family.Carrier m, source := family.space n, target := family.space m] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := Casting.cast family.Carrier m n same,
  addition := Casting.binaryNatural family.Carrier family.Carrier family.Carrier (\fun (k: Index) => (family.space k).add) m n same,
  scalar := \fun (a: I.Int^)(x: family.Carrier m) => Casting.natural family.Carrier family.Carrier (\fun (k: Index)(v: family.Carrier k) => (family.space k).smul a v) m n same x
};
\definition backward: Backward.Map := Backward.Map {
  apply := Casting.cast family.Carrier n m (sym!{Index} m n same),
  addition := Casting.binaryNatural family.Carrier family.Carrier family.Carrier (\fun (k: Index) => (family.space k).add) n m (sym!{Index} m n same),
  scalar := \fun (a: I.Int^)(x: family.Carrier n) => Casting.natural family.Carrier family.Carrier (\fun (k: Index)(v: family.Carrier k) => (family.space k).smul a v) n m (sym!{Index} m n same) x
};
\import Modules.Isomorphism[V := family.Carrier m, W := family.Carrier n, source := family.space m, target := family.space n] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := Casting.castInverse family.Carrier m n same,
  rightInverse := Casting.castInverse family.Carrier n m (sym!{Index} m n same)
};
