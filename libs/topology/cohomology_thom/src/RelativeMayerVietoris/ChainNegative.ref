\module At(z: I.Int^) {
  \import Modules.Hom[V := C.family.Carrier z, W := D.family.Carrier z, source := C.family.space z, target := D.family.space z] \as Maps;
  \import Chains.Map[C := C, D := D].At[k := z] \as Original;
  \definition linear: Maps.Map := Maps.negative (Original.linear f);
}
\definition map: Chains.Map[C := C, D := D].Map := Chains.Map[C := C, D := D].Map {
  apply := \fun (z: I.Int^) => At[z := z].linear.apply,
  addition := \fun (z: I.Int^) => At[z := z].linear.addition,
  scalar := \fun (z: I.Int^) => At[z := z].linear.scalar,
  commutes := \fun (z: I.Int^)(x: C.family.Carrier z) => trans!{{D.family.Carrier (Degrees.previous z)}} _ _ _
    (Modules.Hom[V := D.family.Carrier z, W := D.family.Carrier (Degrees.previous z), source := D.family.space z, target := D.family.space (Degrees.previous z)]
      .negativePreserved Chains.At[C := D, z := z].differential (f.apply z x))
    (congr!{{D.family.Carrier (Degrees.previous z)} {D.family.Carrier (Degrees.previous z)}} (D.family.space (Degrees.previous z)).neg _ _ (f.commutes z x))
};
