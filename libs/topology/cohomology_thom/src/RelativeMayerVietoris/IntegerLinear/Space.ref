\import Modules.Laws[V := A.Carrier, space := A.space] \as Laws;
\import module_theory.Module[].IntegerGroup[Carrier := A.Carrier, group := Laws.additive] \as Canonical;
\import algebra.Hom[A := I.Int^, B := A.Carrier] \as ScalarMaps;
\definition scalars[x: A.Carrier]: Canonical.IntegerMap := \into[I.Int^ -> A.Carrier]((\fun (a: I.Int^) => A.space.smul a x), Canonical.IntegerMap) \by {
  ScalarMaps.MonoidLaws[Canonical.integerDomain, Canonical.target, \fun (a: I.Int^) => A.space.smul a x] {
    unit := Laws.zeroScale x, operation := \fun (a, b: I.Int^) => A.space.scalarAdd a b x
  }
};
\definition agrees[x: A.Carrier]: scalars x = Canonical.integerMap x := Canonical.generatorExt (scalars x) (Canonical.integerMap x)
  (trans!{A.Carrier} _ _ _ (A.space.scalarOne x) (sym!{A.Carrier} _ _ (Canonical.scalarOne x)));
\definition law: \forall (a: I.Int^)(x: A.Carrier) -> A.space.smul a x = Canonical.action a x :=
  \fun (a: I.Int^)(x: A.Carrier) => congr!{{I.Int^ -> A.Carrier} A.Carrier} (\fun (g: I.Int^ -> A.Carrier) => g a) _ _ (agrees x);
