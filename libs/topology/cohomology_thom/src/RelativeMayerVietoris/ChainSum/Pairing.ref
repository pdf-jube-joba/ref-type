\definition map: Chains.Map[C := E, D := complex].Map := Chains.Map[C := E, D := complex].Map {
  apply := \fun (z: I.Int^)(x: E.family.Carrier z) => \parent.At[z := z].make (f.apply z x) (g.apply z x),
  addition := \fun (z: I.Int^)(x, y: E.family.Carrier z) => \parent.At[z := z].ext _ _ (f.addition z x y) (g.addition z x y),
  scalar := \fun (z: I.Int^)(a: I.Int^)(x: E.family.Carrier z) => \parent.At[z := z].ext _ _ (f.scalar z a x) (g.scalar z a x),
  commutes := \fun (z: I.Int^)(x: E.family.Carrier z) => \parent.At[z := Degrees.previous z].ext _ _ (f.commutes z x) (g.commutes z x)
};
