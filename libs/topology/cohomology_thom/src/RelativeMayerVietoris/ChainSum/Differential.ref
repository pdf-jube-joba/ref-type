\import \parent.At[z := z] \as Source;
\import \parent.At[z := Degrees.previous z] \as Target;
\import Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space] \as Maps;
\definition map: Maps.Map := Maps.Map {
  apply := \fun (x: Source.Carrier) => Target.make (C.differential.apply z (Source.first x)) (D.differential.apply z (Source.second x)),
  addition := \fun (x, y: Source.Carrier) => Target.ext _ _ (C.laws.addition z (Source.first x) (Source.first y)) (D.laws.addition z (Source.second x) (Source.second y)),
  scalar := \fun (a: I.Int^)(x: Source.Carrier) => Target.ext _ _ (C.laws.scalar z a (Source.first x)) (D.laws.scalar z a (Source.second x))
};
