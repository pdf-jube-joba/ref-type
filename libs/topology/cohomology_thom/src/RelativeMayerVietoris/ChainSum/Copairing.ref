\module At(z: I.Int^) {
  \import Modules.Biproduct[V := C.family.Carrier z, W := D.family.Carrier z, left := C.family.space z, right := D.family.space z] \as Pair;
  \import Chains.Map[C := C, D := E].At[k := z] \as First;
  \import Chains.Map[C := D, D := E].At[k := z] \as Second;
  \definition linear: _ := Pair.Copair[U := E.family.Carrier z, target := E.family.space z].copair (First.linear f) (Second.linear g);
}
\definition map: Chains.Map[C := complex, D := E].Map := Chains.Map[C := complex, D := E].Map {
  apply := \fun (z: I.Int^) => At[z := z].linear.apply,
  addition := \fun (z: I.Int^) => At[z := z].linear.addition,
  scalar := \fun (z: I.Int^) => At[z := z].linear.scalar,
  commutes := \fun (z: I.Int^)(x: Carrier z) => trans!{{E.family.Carrier (Degrees.previous z)}} _ _ _
    (E.laws.addition z (f.apply z (\parent.At[z := z].first x)) (g.apply z (\parent.At[z := z].second x)))
    (congr!{{E.family.Carrier (Degrees.previous z)} {E.family.Carrier (Degrees.previous z)} {E.family.Carrier (Degrees.previous z)}} (E.family.space (Degrees.previous z)).add _ _ _ _
      (f.commutes z (\parent.At[z := z].first x)) (g.commutes z (\parent.At[z := z].second x)))
};
