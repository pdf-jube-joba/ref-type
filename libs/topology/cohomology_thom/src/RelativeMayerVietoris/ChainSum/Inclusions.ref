\definition firstInjection: Chains.Map[C := C, D := complex].Map := Chains.Map[C := C, D := complex].Map {
  apply := \fun (z: I.Int^) => \parent.At[z := z].firstInjection.apply,
  addition := \fun (z: I.Int^) => \parent.At[z := z].firstInjection.addition,
  scalar := \fun (z: I.Int^) => \parent.At[z := z].firstInjection.scalar,
  commutes := \fun (z: I.Int^)(x: C.family.Carrier z) => \parent.At[z := Degrees.previous z].ext _ _ (\refl(C.differential.apply z x))
    (Modules.Hom[V := D.family.Carrier z, W := D.family.Carrier (Degrees.previous z), source := D.family.space z, target := D.family.space (Degrees.previous z)].zeroPreserved Chains.At[C := D, z := z].differential)
};
\definition secondInjection: Chains.Map[C := D, D := complex].Map := Chains.Map[C := D, D := complex].Map {
  apply := \fun (z: I.Int^) => \parent.At[z := z].secondInjection.apply,
  addition := \fun (z: I.Int^) => \parent.At[z := z].secondInjection.addition,
  scalar := \fun (z: I.Int^) => \parent.At[z := z].secondInjection.scalar,
  commutes := \fun (z: I.Int^)(x: D.family.Carrier z) => \parent.At[z := Degrees.previous z].ext _ _
    (Modules.Hom[V := C.family.Carrier z, W := C.family.Carrier (Degrees.previous z), source := C.family.space z, target := C.family.space (Degrees.previous z)].zeroPreserved Chains.At[C := C, z := z].differential)
    (\refl(D.differential.apply z x))
};
\definition firstProjection: Chains.Map[C := complex, D := C].Map := Chains.Map[C := complex, D := C].Map {
  apply := \fun (z: I.Int^) => \parent.At[z := z].firstProjection.apply,
  addition := \fun (z: I.Int^) => \parent.At[z := z].firstProjection.addition,
  scalar := \fun (z: I.Int^) => \parent.At[z := z].firstProjection.scalar,
  commutes := \fun (z: I.Int^)(x: Carrier z) => \refl(C.differential.apply z (\parent.At[z := z].first x))
};
\definition secondProjection: Chains.Map[C := complex, D := D].Map := Chains.Map[C := complex, D := D].Map {
  apply := \fun (z: I.Int^) => \parent.At[z := z].secondProjection.apply,
  addition := \fun (z: I.Int^) => \parent.At[z := z].secondProjection.addition,
  scalar := \fun (z: I.Int^) => \parent.At[z := z].secondProjection.scalar,
  commutes := \fun (z: I.Int^)(x: Carrier z) => \refl(D.differential.apply z (\parent.At[z := z].second x))
};
\definition firstRoundtrip: \forall (z: I.Int^)(x: C.family.Carrier z) -> firstProjection.apply z (firstInjection.apply z x) = x := \fun (z: I.Int^)(x: C.family.Carrier z) => \refl(x);
\definition secondRoundtrip: \forall (z: I.Int^)(x: D.family.Carrier z) -> secondProjection.apply z (secondInjection.apply z x) = x := \fun (z: I.Int^)(x: D.family.Carrier z) => \refl(x);
\definition firstCross: \forall (z: I.Int^)(x: D.family.Carrier z) -> firstProjection.apply z (secondInjection.apply z x) = (C.family.space z).zero := \fun (z: I.Int^)(x: D.family.Carrier z) => \refl((C.family.space z).zero);
\definition secondCross: \forall (z: I.Int^)(x: C.family.Carrier z) -> secondProjection.apply z (firstInjection.apply z x) = (D.family.space z).zero := \fun (z: I.Int^)(x: C.family.Carrier z) => \refl((D.family.space z).zero);
\definition reconstruction: \forall (z: I.Int^)(x: Carrier z) -> (space z).add (firstInjection.apply z (firstProjection.apply z x)) (secondInjection.apply z (secondProjection.apply z x)) = x :=
  \fun (z: I.Int^)(x: Carrier z) => \parent.At[z := z].reconstruction x;
