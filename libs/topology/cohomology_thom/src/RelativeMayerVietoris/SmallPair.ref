\import topology.Topology[Carrier := A].OpenCovers[topology := source] \as Covers;
\import topology.Topology[Carrier := A].Subspace[S := subset] \as Subspace;
\import singular_subdivision.OpenCover[A := A, source := source].On[cover := cover].Subspace[subset := subset] \as Included;
\import singular_subdivision.Small[A := A, source := source, family := Covers.family cover] \as Whole;
\import topology.Topology[Carrier := Subspace.CarrierSet].OpenCovers[topology := Subspace.topology source] \as SubCovers;
\import singular_subdivision.Small[A := Subspace.CarrierSet, source := Subspace.topology source, family := SubCovers.family Included.restrictedCover] \as Sub;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import Nonnegative.SplitInjection[C := Sub.complex, D := Whole.complex] \as Split;
\import Nonnegative.ZeroExtension[C := Sub.complex] \as SubExtension;
\import Nonnegative.ZeroExtension[C := Whole.complex] \as WholeExtension;
\import Nonnegative.Map[C := Sub.complex, D := Whole.complex].ZeroExtension[f := Included.map] \as Inclusion;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import Chains.Quotient[C := SubExtension.complex, D := WholeExtension.complex].On[f := Inclusion.map] \as Quotient;
\definition complex: Chains.Complex := Quotient.complex;
\module Degree(n: N.Nat^);
\module With(coefficients: Modules.Bundle) {
  \module At(z: I.Int^) {
    \definition comparison: _ := Included.Relative[].With[coefficients := coefficients].At[z := z].isomorphism;
  }
}
\module From(B: \Set, domain: topology.Topology[Carrier := B].Topology, part: \Pow B);
\module Negative(n: N.Nat^);
