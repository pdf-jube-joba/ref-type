\import \root.RelativeMayerVietoris[].Pair[A := A, source := source, subset := subset].Negative[n := n] \as Chain;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Integer[P := Relative.complex, N := coefficients] \as Hom;
\definition cochainZero: \forall (h: Hom.Carrier index) -> h = (Hom.space index).zero :=
  \fun (h: Hom.Carrier index) => Hom.At[z := index].ext h (Hom.space index).zero
    (\fun (x: Relative.Carrier index) => trans!{coefficients.Carrier} _ _ _
      (congr!{{Relative.Carrier index} coefficients.Carrier} h.apply _ _ (Chain.zero x)) (Hom.At[z := index].zeroPreserved h));
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring].At[C := Hom.complex, z := index] \as Cohomology;
\import Modules.Hom[V := Cohomology.Closed, W := Cohomology.Cohomology, source := Cohomology.cycleSpace, target := Cohomology.cohomologySpace] \as Classes;
\definition zero: \forall (q: Cohomology.Cohomology) -> q = Cohomology.cohomologySpace.zero :=
  Cohomology.classInduction (\fun (q: Cohomology.Cohomology) => q = Cohomology.cohomologySpace.zero)
    (\fun (h: Cohomology.Closed) => trans!{Cohomology.Cohomology} _ _ _
      (congr!{Cohomology.Closed Cohomology.Cohomology} Cohomology.classOf h Cohomology.cycleSpace.zero (cochainZero h))
      (Classes.zeroPreserved Cohomology.classLinear));
