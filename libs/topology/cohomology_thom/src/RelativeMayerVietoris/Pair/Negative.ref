\definition index: I.Int^ := I.Int^::negSucc n;
\import Nonnegative.ZeroExtension[C := Whole.complex] \as WholeExtension;
\import Chains.Quotient[C := SubExtension.complex, D := WholeExtension.complex].On[f := Relative.inclusionMap].At[k := index] \as Q;
\definition zero: \forall (x: Relative.Carrier index) -> x = (Relative.space index).zero :=
  Q.induction (\fun (x: Relative.Carrier index) => x = (Relative.space index).zero)
    (\fun (x: WholeExtension.Carrier index) => trans!{{Relative.Carrier index}} _ _ _
      (congr!{{WholeExtension.Carrier index} {Relative.Carrier index}} Q.class _ _ (WholeExtension.Negative[n := n].zero x))
      (Modules.Hom[V := WholeExtension.Carrier index, W := Relative.Carrier index, source := WholeExtension.space index, target := Relative.space index].zeroPreserved Q.projection));
