\definition leftComparison: _ := LeftPairs.With[coefficients := coefficients].At[z := z].isomorphism leftPair;
\definition rightComparison: _ := RightPairs.With[coefficients := coefficients].At[z := z].isomorphism rightPair;
\definition overlapComparison: _ := OverlapPairs.With[coefficients := coefficients].At[z := z].isomorphism overlapPair;
\import singular_cohomology.Relative[A := Native.Left, source := Native.leftTopology, subset := Native.leftPart].Maps[B := Carrier].Over[target := topology, targetSubset := boundary] \as NativeLeftMaps;
\definition nativeLeft: _ := NativeLeftMaps.On[f := Native.leftPairMap].Integer[].With[coefficients := coefficients].At[z := z].induced;
\definition left: _ := LeftMaps.On[f := leftMap].Integer[].With[coefficients := coefficients].At[z := z].induced;
\import singular_cohomology.Relative[A := Left, source := leftTopology, subset := leftBoundary].Maps[B := Native.Left].Over[target := Native.leftTopology, targetSubset := Native.leftPart] \as IntoLeft;
\import IntoLeft.Composition[C := Carrier].Over[final := topology, finalSubset := boundary] \as LeftComposite;
\definition leftSquare: LeftComposite.compose (LeftPairs.forwardMap leftPair) Native.leftPairMap = leftMap :=
  \axiom:funext((LeftComposite.compose (LeftPairs.forwardMap leftPair) Native.leftPairMap), leftMap, (\fun (p: Left) => \refl(leftMap p)));
\definition leftAction[f: LeftMaps.Map]: _ := LeftMaps.On[f := f].Integer[].With[coefficients := coefficients].At[z := z].induced;
\definition leftLaw: \forall (u: WholeTheory.At[z := z].Carrier) -> left.apply u = leftComparison.forward.apply (nativeLeft.apply u) :=
  \fun (u: WholeTheory.At[z := z].Carrier) => trans!{{LeftTheory.At[z := z].Carrier}} _ _ _
    (congr!{LeftMaps.Map {LeftTheory.At[z := z].Carrier}} (\fun (f: LeftMaps.Map) => (leftAction f).apply u) leftMap (LeftComposite.compose (LeftPairs.forwardMap leftPair) Native.leftPairMap) (sym!{LeftMaps.Map} _ _ leftSquare))
    (LeftComposite.On[f := LeftPairs.forwardMap leftPair, g := Native.leftPairMap].With[coefficients := coefficients].law z u);
\import singular_cohomology.Relative[A := Native.Overlap, source := Native.overlapTopology, subset := Native.overlapPart].Maps[B := Native.Left].Over[target := Native.leftTopology, targetSubset := Native.leftPart] \as NativeOverlapLeft;
\definition nativeOverlapLeft: _ := NativeOverlapLeft.On[f := Native.toLeft].Integer[].With[coefficients := coefficients].At[z := z].induced;
\definition overlapLeft: _ := OverlapToLeft.On[f := overlapLeftMap].Integer[].With[coefficients := coefficients].At[z := z].induced;
\import singular_cohomology.Relative[A := Overlap, source := overlapTopology, subset := overlapBoundary].Maps[B := Native.Overlap].Over[target := Native.overlapTopology, targetSubset := Native.overlapPart] \as IntoOverlapLeft;
\import IntoOverlapLeft.Composition[C := Native.Left].Over[final := Native.leftTopology, finalSubset := Native.leftPart] \as NativeOverlapCompositeLeft;
\import OverlapToLeft.Composition[C := Native.Left].Over[final := Native.leftTopology, finalSubset := Native.leftPart] \as FlatOverlapCompositeLeft;
\import singular_cohomology.Relative[A := Overlap, source := overlapTopology, subset := overlapBoundary].Maps[B := Native.Left].Over[target := Native.leftTopology, targetSubset := Native.leftPart] \as OverlapIntoLeft;
\definition overlapLeftSquare: NativeOverlapCompositeLeft.compose (OverlapPairs.forwardMap overlapPair) Native.toLeft = FlatOverlapCompositeLeft.compose overlapLeftMap (LeftPairs.forwardMap leftPair) :=
  \axiom:funext((NativeOverlapCompositeLeft.compose (OverlapPairs.forwardMap overlapPair) Native.toLeft), (FlatOverlapCompositeLeft.compose overlapLeftMap (LeftPairs.forwardMap leftPair)), (\fun (p: Overlap) => \refl(Native.toLeft (OverlapPairs.forwardMap overlapPair p))));
\definition overlapLeftAction[f: OverlapIntoLeft.Map]: _ := OverlapIntoLeft.On[f := f].Integer[].With[coefficients := coefficients].At[z := z].induced;
\definition overlapLeftLaw: \forall (u: singular_cohomology.Relative[A := Native.Left, source := Native.leftTopology, subset := Native.leftPart].With[coefficients := coefficients].At[z := z].Carrier) ->
  overlapComparison.forward.apply (nativeOverlapLeft.apply u) = overlapLeft.apply (leftComparison.forward.apply u) :=
  \fun (u: singular_cohomology.Relative[A := Native.Left, source := Native.leftTopology, subset := Native.leftPart].With[coefficients := coefficients].At[z := z].Carrier) => trans!{{OverlapTheory.At[z := z].Carrier}} _ _ _
    (sym!{{OverlapTheory.At[z := z].Carrier}} _ _ (NativeOverlapCompositeLeft.On[f := OverlapPairs.forwardMap overlapPair, g := Native.toLeft].With[coefficients := coefficients].law z u))
    (trans!{{OverlapTheory.At[z := z].Carrier}} _ _ _
      (congr!{OverlapIntoLeft.Map {OverlapTheory.At[z := z].Carrier}} (\fun (f: OverlapIntoLeft.Map) => (overlapLeftAction f).apply u) _ _ overlapLeftSquare)
      (FlatOverlapCompositeLeft.On[f := overlapLeftMap, g := LeftPairs.forwardMap leftPair].With[coefficients := coefficients].law z u));
\import singular_cohomology.Relative[A := Native.Right, source := Native.rightTopology, subset := Native.rightPart].Maps[B := Carrier].Over[target := topology, targetSubset := boundary] \as NativeRightMaps;
\definition nativeRight: _ := NativeRightMaps.On[f := Native.rightPairMap].Integer[].With[coefficients := coefficients].At[z := z].induced;
\definition right: _ := RightMaps.On[f := rightMap].Integer[].With[coefficients := coefficients].At[z := z].induced;
\import singular_cohomology.Relative[A := Right, source := rightTopology, subset := rightBoundary].Maps[B := Native.Right].Over[target := Native.rightTopology, targetSubset := Native.rightPart] \as IntoRight;
\import IntoRight.Composition[C := Carrier].Over[final := topology, finalSubset := boundary] \as RightComposite;
\definition rightSquare: RightComposite.compose (RightPairs.forwardMap rightPair) Native.rightPairMap = rightMap :=
  \axiom:funext((RightComposite.compose (RightPairs.forwardMap rightPair) Native.rightPairMap), rightMap, (\fun (p: Right) => \refl(rightMap p)));
\definition rightAction[f: RightMaps.Map]: _ := RightMaps.On[f := f].Integer[].With[coefficients := coefficients].At[z := z].induced;
\definition rightLaw: \forall (u: WholeTheory.At[z := z].Carrier) -> right.apply u = rightComparison.forward.apply (nativeRight.apply u) :=
  \fun (u: WholeTheory.At[z := z].Carrier) => trans!{{RightTheory.At[z := z].Carrier}} _ _ _
    (congr!{RightMaps.Map {RightTheory.At[z := z].Carrier}} (\fun (f: RightMaps.Map) => (rightAction f).apply u) rightMap (RightComposite.compose (RightPairs.forwardMap rightPair) Native.rightPairMap) (sym!{RightMaps.Map} _ _ rightSquare))
    (RightComposite.On[f := RightPairs.forwardMap rightPair, g := Native.rightPairMap].With[coefficients := coefficients].law z u);
\import singular_cohomology.Relative[A := Native.Overlap, source := Native.overlapTopology, subset := Native.overlapPart].Maps[B := Native.Right].Over[target := Native.rightTopology, targetSubset := Native.rightPart] \as NativeOverlapRight;
\definition nativeOverlapRight: _ := NativeOverlapRight.On[f := Native.toRight].Integer[].With[coefficients := coefficients].At[z := z].induced;
\definition overlapRight: _ := OverlapToRight.On[f := overlapRightMap].Integer[].With[coefficients := coefficients].At[z := z].induced;
\import singular_cohomology.Relative[A := Overlap, source := overlapTopology, subset := overlapBoundary].Maps[B := Native.Overlap].Over[target := Native.overlapTopology, targetSubset := Native.overlapPart] \as IntoOverlapRight;
\import IntoOverlapRight.Composition[C := Native.Right].Over[final := Native.rightTopology, finalSubset := Native.rightPart] \as NativeOverlapCompositeRight;
\import OverlapToRight.Composition[C := Native.Right].Over[final := Native.rightTopology, finalSubset := Native.rightPart] \as FlatOverlapCompositeRight;
\import singular_cohomology.Relative[A := Overlap, source := overlapTopology, subset := overlapBoundary].Maps[B := Native.Right].Over[target := Native.rightTopology, targetSubset := Native.rightPart] \as OverlapIntoRight;
\definition overlapRightSquare: NativeOverlapCompositeRight.compose (OverlapPairs.forwardMap overlapPair) Native.toRight = FlatOverlapCompositeRight.compose overlapRightMap (RightPairs.forwardMap rightPair) :=
  \axiom:funext((NativeOverlapCompositeRight.compose (OverlapPairs.forwardMap overlapPair) Native.toRight), (FlatOverlapCompositeRight.compose overlapRightMap (RightPairs.forwardMap rightPair)), (\fun (p: Overlap) => \refl(Native.toRight (OverlapPairs.forwardMap overlapPair p))));
\definition overlapRightAction[f: OverlapIntoRight.Map]: _ := OverlapIntoRight.On[f := f].Integer[].With[coefficients := coefficients].At[z := z].induced;
\definition overlapRightLaw: \forall (u: singular_cohomology.Relative[A := Native.Right, source := Native.rightTopology, subset := Native.rightPart].With[coefficients := coefficients].At[z := z].Carrier) ->
  overlapComparison.forward.apply (nativeOverlapRight.apply u) = overlapRight.apply (rightComparison.forward.apply u) :=
  \fun (u: singular_cohomology.Relative[A := Native.Right, source := Native.rightTopology, subset := Native.rightPart].With[coefficients := coefficients].At[z := z].Carrier) => trans!{{OverlapTheory.At[z := z].Carrier}} _ _ _
    (sym!{{OverlapTheory.At[z := z].Carrier}} _ _ (NativeOverlapCompositeRight.On[f := OverlapPairs.forwardMap overlapPair, g := Native.toRight].With[coefficients := coefficients].law z u))
    (trans!{{OverlapTheory.At[z := z].Carrier}} _ _ _
      (congr!{OverlapIntoRight.Map {OverlapTheory.At[z := z].Carrier}} (\fun (f: OverlapIntoRight.Map) => (overlapRightAction f).apply u) _ _ overlapRightSquare)
      (FlatOverlapCompositeRight.On[f := overlapRightMap, g := RightPairs.forwardMap rightPair].With[coefficients := coefficients].law z u));
\definition leftZero[zero: \forall (a: LeftTheory.At[z := z].Carrier) -> a = LeftTheory.At[z := z].space.zero]: \forall (a: NativeLeftTheory.At[z := z].Carrier) -> a = NativeLeftTheory.At[z := z].space.zero :=
  Modules.Isomorphism[V := NativeLeftTheory.At[z := z].Carrier, W := LeftTheory.At[z := z].Carrier, source := NativeLeftTheory.At[z := z].space, target := LeftTheory.At[z := z].space].Vanishing[].sourceZero leftComparison zero;
\definition leftInjective: \forall (a, b: NativeLeftTheory.At[z := z].Carrier) -> leftComparison.forward.apply a = leftComparison.forward.apply b -> a = b :=
  \fun (a, b: NativeLeftTheory.At[z := z].Carrier)(same: _) => trans!{{NativeLeftTheory.At[z := z].Carrier}} _ _ _ (sym!{{NativeLeftTheory.At[z := z].Carrier}} _ _ (leftComparison.leftInverse a))
    (trans!{{NativeLeftTheory.At[z := z].Carrier}} _ _ _ (congr!{{LeftTheory.At[z := z].Carrier} {NativeLeftTheory.At[z := z].Carrier}} leftComparison.backward.apply _ _ same) (leftComparison.leftInverse b));
\definition rightZero[zero: \forall (a: RightTheory.At[z := z].Carrier) -> a = RightTheory.At[z := z].space.zero]: \forall (a: NativeRightTheory.At[z := z].Carrier) -> a = NativeRightTheory.At[z := z].space.zero :=
  Modules.Isomorphism[V := NativeRightTheory.At[z := z].Carrier, W := RightTheory.At[z := z].Carrier, source := NativeRightTheory.At[z := z].space, target := RightTheory.At[z := z].space].Vanishing[].sourceZero rightComparison zero;
\definition rightInjective: \forall (a, b: NativeRightTheory.At[z := z].Carrier) -> rightComparison.forward.apply a = rightComparison.forward.apply b -> a = b :=
  \fun (a, b: NativeRightTheory.At[z := z].Carrier)(same: _) => trans!{{NativeRightTheory.At[z := z].Carrier}} _ _ _ (sym!{{NativeRightTheory.At[z := z].Carrier}} _ _ (rightComparison.leftInverse a))
    (trans!{{NativeRightTheory.At[z := z].Carrier}} _ _ _ (congr!{{RightTheory.At[z := z].Carrier} {NativeRightTheory.At[z := z].Carrier}} rightComparison.backward.apply _ _ same) (rightComparison.leftInverse b));
\definition overlapZero[zero: \forall (a: OverlapTheory.At[z := z].Carrier) -> a = OverlapTheory.At[z := z].space.zero]: \forall (a: NativeOverlapTheory.At[z := z].Carrier) -> a = NativeOverlapTheory.At[z := z].space.zero :=
  Modules.Isomorphism[V := NativeOverlapTheory.At[z := z].Carrier, W := OverlapTheory.At[z := z].Carrier, source := NativeOverlapTheory.At[z := z].space, target := OverlapTheory.At[z := z].space].Vanishing[].sourceZero overlapComparison zero;
\definition overlapInjective: \forall (a, b: NativeOverlapTheory.At[z := z].Carrier) -> overlapComparison.forward.apply a = overlapComparison.forward.apply b -> a = b :=
  \fun (a, b: NativeOverlapTheory.At[z := z].Carrier)(same: _) => trans!{{NativeOverlapTheory.At[z := z].Carrier}} _ _ _ (sym!{{NativeOverlapTheory.At[z := z].Carrier}} _ _ (overlapComparison.leftInverse a))
    (trans!{{NativeOverlapTheory.At[z := z].Carrier}} _ _ _ (congr!{{OverlapTheory.At[z := z].Carrier} {NativeOverlapTheory.At[z := z].Carrier}} overlapComparison.backward.apply _ _ same) (overlapComparison.leftInverse b));
