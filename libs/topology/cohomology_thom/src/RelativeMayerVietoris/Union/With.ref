\import singular_cohomology.Relative[A := Native.Right, source := Native.rightTopology, subset := Native.rightPart].With[coefficients := coefficients] \as NativeRightTheory;
\import singular_cohomology.Relative[A := Native.Overlap, source := Native.overlapTopology, subset := Native.overlapPart].With[coefficients := coefficients] \as NativeOverlapTheory;
\import Native.Cohomology[coefficients := coefficients] \as Sequence;
\import singular_cohomology.Relative[A := Carrier, source := topology, subset := boundary].With[coefficients := coefficients] \as WholeTheory;
\import singular_cohomology.Relative[A := Left, source := leftTopology, subset := leftBoundary].With[coefficients := coefficients] \as LeftTheory;
\import singular_cohomology.Relative[A := Right, source := rightTopology, subset := rightBoundary].With[coefficients := coefficients] \as RightTheory;
\import singular_cohomology.Relative[A := Overlap, source := overlapTopology, subset := overlapBoundary].With[coefficients := coefficients] \as OverlapTheory;
