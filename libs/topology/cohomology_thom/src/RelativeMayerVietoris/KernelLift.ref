\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\module For(A, B, C, A1, B1, C1: Cochains.Complex) {
  \import Cochains.ShortExact[A := A, B := B, C := C] \as Source;
  \import Cochains.ShortExact[A := A1, B := B1, C := C1] \as Target;
  \import Cochains.Map[C := B, D := B1] \as Middle;
  \import Cochains.Map[C := C, D := C1] \as Right;
  \module Along(s: Source.Sequence, t: Target.Sequence, b: Middle.Map, c: Right.Map,
    square: \forall (z: I.Int^)(x: B.family.Carrier z) -> t.projection.apply z (b.apply z x) = c.apply z (s.projection.apply z x));
}
