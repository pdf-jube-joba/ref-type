\import singular_cohomology.Relative[A := B, source := domain, subset := part] \as SourcePair;
\import topology.Topology[Carrier := B].Subspace[S := part] \as SourceSubspace;
\import singular_cohomology.Chains[A := B, source := domain] \as SourceWhole;
\import singular_cohomology.Chains[A := SourceSubspace.CarrierSet, source := SourceSubspace.topology domain] \as SourceSub;
\import singular_cohomology.Chains[A := A, source := source] \as TargetWhole;
\import SourcePair.Maps[B := A].Over[target := source, targetSubset := subset] \as PairMaps;
\module Along(f: PairMaps.Map, U: \Cast[\Pow A] (Covers.family cover), contained: \forall (b: B) -> \In[A] U (f b));
