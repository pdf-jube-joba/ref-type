\definition index: I.Int^ := I.Int^::negSucc n;
\import Quotient.At[k := index] \as Q;
\definition zero: \forall (x: complex.family.Carrier index) -> x = (complex.family.space index).zero :=
  Q.induction (\fun (x: complex.family.Carrier index) => x = (complex.family.space index).zero)
    (\fun (x: WholeExtension.Carrier index) => trans!{{complex.family.Carrier index}} _ _ _
      (congr!{{WholeExtension.Carrier index} {complex.family.Carrier index}} Q.class _ _ (WholeExtension.Negative[n := n].zero x))
      (Modules.Hom[V := WholeExtension.Carrier index, W := complex.family.Carrier index, source := WholeExtension.space index, target := complex.family.space index].zeroPreserved Q.projection));
