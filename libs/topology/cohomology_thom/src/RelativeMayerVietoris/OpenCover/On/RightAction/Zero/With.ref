\import Diagram.Short[c := Native.comparison u] \as Comparison;
\import Multiplication.On[u := Native.factor u] \as Cup;
\import Native.Isomorphisms[u := u] \as Local;
\definition isomorphism[local: Local.Local][below: TargetDetection.Vanishes]: _ :=
  Cup.isomorphism (Cup.Bijective {
    injective := Comparison.injective sourceDetection (Local.laws local),
    onto := Comparison.surjective (TargetDetection.injective below) (Local.laws local)
  });
