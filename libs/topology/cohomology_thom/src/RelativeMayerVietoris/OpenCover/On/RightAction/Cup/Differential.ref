\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\import \parent.SumAction[].Differential[] \as SumDifferential;
\import \parent.\parent.Cup[p := N.Nat^::succ p, q := q] \as Upper;
\definition upperTotal: N.Nat^ := N.Basic[].Def[].add (N.Nat^::succ p) q;
\definition higher: N.Nat^ := N.Nat^::succ total;
\definition same: upperTotal = higher := N.Basic[].Prop[].addSuccLeft p q;
\definition higherZ: I.Int^ := I.Int^::ofNat higher;
\definition upperZ: I.Int^ := I.Int^::ofNat upperTotal;
\definition SmallRaw[k: N.Nat^]: \Set := SmallHom.Carrier (I.Int^::ofNat k);
\definition inclusionDegree[k: N.Nat^]: SmallRaw k -> SumDifferential.SumRaw k := MV.sequence.inclusion.apply (I.Int^::ofNat k);
\definition cast[u: Factor][h: SourceSmallHom.Carrier (I.Int^::ofNat (N.Nat^::succ p))]: SmallHom.Carrier higherZ := Transport.cast SmallRaw upperTotal higher same (Upper.apply u h);
\definition law: \forall (u: Restriction.Cycle)(h: SourceSmallHom.Carrier inputDegree) -> SmallHom.complex.differential.apply outputDegree (apply u h) = cast u (SourceSmallHom.complex.differential.apply inputDegree h) :=
  \fun (u: Restriction.Cycle)(h: SourceSmallHom.Carrier inputDegree) => MV.sequence.injective higherZ _ _
    (eq_reason_in!{{SumHom.Carrier higherZ} _
      "=" _ "by" { sym!{{SumHom.Carrier higherZ}} _ _ (MV.sequence.inclusion.commutes outputDegree (apply u h)) }
      "=" _ "by" { congr!{{SumHom.Carrier outputDegree} {SumHom.Carrier higherZ}} (SumHom.complex.differential.apply outputDegree) _ _ (inclusion u h) }
      "=" _ "by" { SumDifferential.law u (SourceSequence.sequence.inclusion.apply inputDegree h) }
      "=" _ "by" { congr!{{SourceSumHom.Carrier (I.Int^::ofNat (N.Nat^::succ p))} {SumHom.Carrier higherZ}} (SumDifferential.cast u) _ _ (SourceSequence.sequence.inclusion.commutes inputDegree h) }
      "=" _ "by" { congr!{{SumHom.Carrier upperZ} {SumHom.Carrier higherZ}} (Transport.cast SumDifferential.SumRaw upperTotal higher same) _ _ (sym!{{SumHom.Carrier upperZ}} _ _ (Upper.inclusion u (SourceSmallHom.complex.differential.apply inputDegree h))) }
      "=" _ "by" { Transport.natural SmallRaw SumDifferential.SumRaw inclusionDegree upperTotal higher same (Upper.apply u (SourceSmallHom.complex.differential.apply inputDegree h)) }
    });
