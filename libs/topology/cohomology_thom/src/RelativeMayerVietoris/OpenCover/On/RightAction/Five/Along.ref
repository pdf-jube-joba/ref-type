\import Modules.FiveLemma[A := S.directSum, B := S.intersection, C := S1.whole, D := S1.directSum, E := S1.intersection,
  A1 := T.directSum, B1 := T.intersection, C1 := T1.whole, D1 := T1.directSum, E1 := T1.intersection].Diagram[
  s := sourceFive, t := targetFive, a := lower.pair, b := lower.overlap, c := upper.whole, d := upper.pair, e := upper.overlap] \as FiveLemma;
\definition commutative[connecting: \forall (a: S.intersection.Carrier) -> upper.whole.apply (SM.connecting.apply a) = TM.connecting.apply (lower.overlap.apply a)]: FiveLemma.Commutative := FiveLemma.Commutative {
  first := (Lower.laws lower).difference, second := connecting,
  third := (Upper.laws upper).restriction, last := (Upper.laws upper).difference
};
\definition isomorphism[localLower: Lower.LocalIsomorphisms[lower]][localUpper: Upper.LocalIsomorphisms[upper]]
  [connecting: \forall (a: S.intersection.Carrier) -> upper.whole.apply (SM.connecting.apply a) = TM.connecting.apply (lower.overlap.apply a)]: _ :=
  FiveLemma.isomorphism (commutative connecting) localLower.pairSurjective localLower.overlapInjective localLower.overlapSurjective localUpper.pairInjective localUpper.pairSurjective localUpper.overlapInjective;
