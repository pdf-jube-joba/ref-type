\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition upperTotal: N.Nat^ := N.Basic[].Def[].add (N.Nat^::succ p) q;
\definition higher: N.Nat^ := N.Nat^::succ total;
\definition same: upperTotal = higher := N.Basic[].Prop[].addSuccLeft p q;
\definition higherZ: I.Int^ := I.Int^::ofNat higher;
\definition upperZ: I.Int^ := I.Int^::ofNat upperTotal;
\import \parent.\parent.\parent.Cup[p := N.Nat^::succ p, q := q] \as Upper;
\import \parent.\parent.SumAction[] \as Components;
\definition SumRaw[k: N.Nat^]: \Set := SumHom.Carrier (I.Int^::ofNat k);
\definition LeftRaw[k: N.Nat^]: \Set := LeftHom.Carrier (I.Int^::ofNat k);
\definition RightRaw[k: N.Nat^]: \Set := RightHom.Carrier (I.Int^::ofNat k);
\definition first[k: N.Nat^]: SumRaw k -> LeftRaw k := Coordinates.firstProjection.apply (I.Int^::ofNat k);
\definition second[k: N.Nat^]: SumRaw k -> RightRaw k := Coordinates.secondProjection.apply (I.Int^::ofNat k);
\definition cast[u: Factor][h: SourceSumHom.Carrier (I.Int^::ofNat (N.Nat^::succ p))]: SumHom.Carrier higherZ := Transport.cast SumRaw upperTotal higher same (Upper.sumAction u h);
\import SourceLeftCup.Comparison[n := N.Nat^::succ p] \as LeftHigherForget;
\import IntegerCochains.At[C := LeftHom.complex, z := I.Int^::ofNat q] \as LeftFixed;
\definition left: \forall (u: Restriction.Cycle)(h: SourceSumHom.Carrier inputDegree) ->
  Coordinates.firstProjection.apply higherZ (SumHom.complex.differential.apply outputDegree (sumAction u h)) = Coordinates.firstProjection.apply higherZ (cast u (SourceSumHom.complex.differential.apply inputDegree h)) :=
  \fun (u: Restriction.Cycle)(h: SourceSumHom.Carrier inputDegree) => eq_reason_in!{{LeftHom.Carrier higherZ} _
    "=" _ "by" { sym!{{LeftHom.Carrier higherZ}} _ _ (Coordinates.firstProjection.commutes outputDegree (sumAction u h)) }
    "=" _ "by" { congr!{{LeftHom.Carrier outputDegree} {LeftHom.Carrier higherZ}} (LeftHom.complex.differential.apply outputDegree) _ _ (Components.left u h) }
    "=" _ "by" { LP.Closed[].rightRightClosed (LeftForget.from (SourceCoordinates.firstProjection.apply inputDegree h)) (Restriction.left u) (\bysub(LeftHom.Carrier (I.Int^::ofNat q), (LeftFixed.cycles).carrier, Restriction.leftCycle u)) }
    "=" _ "by" { congr!{{LeftProduct.Carrier (N.Nat^::succ p)} {LeftHom.Carrier higherZ}} (\fun (a: LeftProduct.Carrier (N.Nat^::succ p)) => LeftCup.Degree[].apply upperTotal higher same (LeftCup.RelativeCup[p := N.Nat^::succ p, q := q].right a (Restriction.left u))) _ _
      (sym!{{LeftProduct.Carrier (N.Nat^::succ p)}} _ _ (LeftForget.Commutes[].law (SourceCoordinates.firstProjection.apply inputDegree h))) }
    "=" _ "by" { congr!{{SourceLeftHom.Carrier (I.Int^::ofNat (N.Nat^::succ p))} {LeftHom.Carrier higherZ}} (\fun (a: SourceLeftHom.Carrier (I.Int^::ofNat (N.Nat^::succ p))) => LeftCup.Degree[].apply upperTotal higher same (LeftCup.RelativeCup[p := N.Nat^::succ p, q := q].right (LeftHigherForget.from a) (Restriction.left u))) _ _ (SourceCoordinates.firstProjection.commutes inputDegree h) }
    "=" _ "by" { congr!{{LeftHom.Carrier upperZ} {LeftHom.Carrier higherZ}} (Transport.cast LeftRaw upperTotal higher same) _ _ (sym!{{LeftHom.Carrier upperZ}} _ _ (Upper.SumAction[].left u (SourceSumHom.complex.differential.apply inputDegree h))) }
    "=" _ "by" { Transport.natural SumRaw LeftRaw first upperTotal higher same (Upper.sumAction u (SourceSumHom.complex.differential.apply inputDegree h)) }
  };
\import SourceRightCup.Comparison[n := N.Nat^::succ p] \as RightHigherForget;
\import IntegerCochains.At[C := RightHom.complex, z := I.Int^::ofNat q] \as RightFixed;
\definition right: \forall (u: Restriction.Cycle)(h: SourceSumHom.Carrier inputDegree) ->
  Coordinates.secondProjection.apply higherZ (SumHom.complex.differential.apply outputDegree (sumAction u h)) = Coordinates.secondProjection.apply higherZ (cast u (SourceSumHom.complex.differential.apply inputDegree h)) :=
  \fun (u: Restriction.Cycle)(h: SourceSumHom.Carrier inputDegree) => eq_reason_in!{{RightHom.Carrier higherZ} _
    "=" _ "by" { sym!{{RightHom.Carrier higherZ}} _ _ (Coordinates.secondProjection.commutes outputDegree (sumAction u h)) }
    "=" _ "by" { congr!{{RightHom.Carrier outputDegree} {RightHom.Carrier higherZ}} (RightHom.complex.differential.apply outputDegree) _ _ (Components.right u h) }
    "=" _ "by" { RP.Closed[].rightRightClosed (RightForget.from (SourceCoordinates.secondProjection.apply inputDegree h)) (Restriction.right u) (\bysub(RightHom.Carrier (I.Int^::ofNat q), (RightFixed.cycles).carrier, Restriction.rightCycle u)) }
    "=" _ "by" { congr!{{RightProduct.Carrier (N.Nat^::succ p)} {RightHom.Carrier higherZ}} (\fun (a: RightProduct.Carrier (N.Nat^::succ p)) => RightCup.Degree[].apply upperTotal higher same (RightCup.RelativeCup[p := N.Nat^::succ p, q := q].right a (Restriction.right u))) _ _
      (sym!{{RightProduct.Carrier (N.Nat^::succ p)}} _ _ (RightForget.Commutes[].law (SourceCoordinates.secondProjection.apply inputDegree h))) }
    "=" _ "by" { congr!{{SourceRightHom.Carrier (I.Int^::ofNat (N.Nat^::succ p))} {RightHom.Carrier higherZ}} (\fun (a: SourceRightHom.Carrier (I.Int^::ofNat (N.Nat^::succ p))) => RightCup.Degree[].apply upperTotal higher same (RightCup.RelativeCup[p := N.Nat^::succ p, q := q].right (RightHigherForget.from a) (Restriction.right u))) _ _ (SourceCoordinates.secondProjection.commutes inputDegree h) }
    "=" _ "by" { congr!{{RightHom.Carrier upperZ} {RightHom.Carrier higherZ}} (Transport.cast RightRaw upperTotal higher same) _ _ (sym!{{RightHom.Carrier upperZ}} _ _ (Upper.SumAction[].right u (SourceSumHom.complex.differential.apply inputDegree h))) }
    "=" _ "by" { Transport.natural SumRaw RightRaw second upperTotal higher same (Upper.sumAction u (SourceSumHom.complex.differential.apply inputDegree h)) }
  };
\definition law: \forall (u: Restriction.Cycle)(h: SourceSumHom.Carrier inputDegree) -> SumHom.complex.differential.apply outputDegree (sumAction u h) = cast u (SourceSumHom.complex.differential.apply inputDegree h) :=
  \fun (u: Restriction.Cycle)(h: SourceSumHom.Carrier inputDegree) => Coordinates.ext higherZ _ _ (left u h) (right u h);
