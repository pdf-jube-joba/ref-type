\use std.Logic[].Equality[].eq_reason_in;
\import singular_cohomology.Relative[A := A, source := source, subset := WholeSpace.Empty].With[coefficients := WholeProduct.integerCoefficients] \as SourceWhole;
\import singular_cap.CochainPair[A := A, source := source, subset := WholeSpace.Empty, R := K, ring := ring] \as SourceWholeCup;
\import SourceWholeCup.Comparison[n := p] \as WholeForget;
\import WholeCup.RelativeCup[p := p, q := q] \as WholeMultiplication;
\import singular_subdivision.OpenCover[A := A, source := source].On[cover := Cover.openCover].Subspace[subset := WholeSpace.Empty].Relative[].With[coefficients := WholeProduct.integerCoefficients] \as SourceComparison;
\import SourceSequence.Coordinates[].At[z := inputDegree] \as SourceCompare;
\import MV.Coordinates[].At[z := outputDegree] \as TargetCompare;
\import \parent.SumAction[] \as Components;
\import \root.RelativePullback[].On[A := Left, source := leftTopology, subset := leftPart, R := K, ring := ring].To[B := A, target := source, part := subset].Along[f := leftPairMap] \as LeftGlobal;
\import \root.RelativePullback[].On[A := Left, source := leftTopology, subset := SourceCover.leftPart, R := K, ring := ring].To[B := A, target := source, part := WholeSpace.Empty].Along[f := SourceCover.leftPairMap] \as LeftSourceGlobal;
\definition left: \forall (u: Factor)(h: SourceWhole.Carrier inputDegree) ->
  Coordinates.firstProjection.apply outputDegree (MV.sequence.inclusion.apply outputDegree (apply u (SourceComparison.restriction.apply inputDegree h))) =
  Coordinates.firstProjection.apply outputDegree (MV.sequence.inclusion.apply outputDegree (WholeComparison.restriction.apply outputDegree (WholeMultiplication.right (WholeForget.from h) u))) :=
  \fun (u: Factor)(h: SourceWhole.Carrier inputDegree) => eq_reason_in!{{LeftHom.Carrier outputDegree} _
    "=" _ "by" { congr!{{SumHom.Carrier outputDegree} {LeftHom.Carrier outputDegree}} (Coordinates.firstProjection.apply outputDegree) _ _ (inclusion u (SourceComparison.restriction.apply inputDegree h)) }
    "=" _ "by" { Components.left u (SourceSequence.sequence.inclusion.apply inputDegree (SourceComparison.restriction.apply inputDegree h)) }
    "=" _ "by" { congr!{{SourceLeftHom.Carrier inputDegree} {LeftHom.Carrier outputDegree}} (\fun (a: SourceLeftHom.Carrier inputDegree) => LP.right (LeftForget.from a) (Restriction.left u)) _ _ (SourceCompare.left h) }
    "=" _ "by" { congr!{{LeftProduct.Carrier p} {LeftHom.Carrier outputDegree}} (\fun (a: LeftProduct.Carrier p) => LP.right a (Restriction.left u)) _ _ (LeftSourceGlobal.Compare[n := p].law h) }
    "=" _ "by" { sym!{{LeftHom.Carrier outputDegree}} _ _ (LeftGlobal.Cup[p := p, q := q].law (WholeForget.from h) u) }
    "=" _ "by" { sym!{{LeftHom.Carrier outputDegree}} _ _ (TargetCompare.left (WholeMultiplication.right (WholeForget.from h) u)) }
  };
\import \root.RelativePullback[].On[A := Right, source := rightTopology, subset := rightPart, R := K, ring := ring].To[B := A, target := source, part := subset].Along[f := rightPairMap] \as RightGlobal;
\import \root.RelativePullback[].On[A := Right, source := rightTopology, subset := SourceCover.rightPart, R := K, ring := ring].To[B := A, target := source, part := WholeSpace.Empty].Along[f := SourceCover.rightPairMap] \as RightSourceGlobal;
\definition right: \forall (u: Factor)(h: SourceWhole.Carrier inputDegree) ->
  Coordinates.secondProjection.apply outputDegree (MV.sequence.inclusion.apply outputDegree (apply u (SourceComparison.restriction.apply inputDegree h))) =
  Coordinates.secondProjection.apply outputDegree (MV.sequence.inclusion.apply outputDegree (WholeComparison.restriction.apply outputDegree (WholeMultiplication.right (WholeForget.from h) u))) :=
  \fun (u: Factor)(h: SourceWhole.Carrier inputDegree) => eq_reason_in!{{RightHom.Carrier outputDegree} _
    "=" _ "by" { congr!{{SumHom.Carrier outputDegree} {RightHom.Carrier outputDegree}} (Coordinates.secondProjection.apply outputDegree) _ _ (inclusion u (SourceComparison.restriction.apply inputDegree h)) }
    "=" _ "by" { Components.right u (SourceSequence.sequence.inclusion.apply inputDegree (SourceComparison.restriction.apply inputDegree h)) }
    "=" _ "by" { congr!{{SourceRightHom.Carrier inputDegree} {RightHom.Carrier outputDegree}} (\fun (a: SourceRightHom.Carrier inputDegree) => RP.right (RightForget.from a) (Restriction.right u)) _ _ (SourceCompare.right h) }
    "=" _ "by" { congr!{{RightProduct.Carrier p} {RightHom.Carrier outputDegree}} (\fun (a: RightProduct.Carrier p) => RP.right a (Restriction.right u)) _ _ (RightSourceGlobal.Compare[n := p].law h) }
    "=" _ "by" { sym!{{RightHom.Carrier outputDegree}} _ _ (RightGlobal.Cup[p := p, q := q].law (WholeForget.from h) u) }
    "=" _ "by" { sym!{{RightHom.Carrier outputDegree}} _ _ (TargetCompare.right (WholeMultiplication.right (WholeForget.from h) u)) }
  };
\definition law: \forall (u: Factor)(h: SourceWhole.Carrier inputDegree) -> apply u (SourceComparison.restriction.apply inputDegree h) = WholeComparison.restriction.apply outputDegree (WholeMultiplication.right (WholeForget.from h) u) :=
  \fun (u: Factor)(h: SourceWhole.Carrier inputDegree) => MV.sequence.injective outputDegree _ _ (Coordinates.ext outputDegree _ _ (left u h) (right u h));

\module Cohomology;
