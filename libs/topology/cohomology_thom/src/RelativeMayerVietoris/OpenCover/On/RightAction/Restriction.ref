\definition z: I.Int^ := I.Int^::ofNat q;
\definition left[u: WholeRelative.Carrier z]: LeftHom.Carrier z := LeftRestriction.pullback.apply z u;
\definition right[u: WholeRelative.Carrier z]: RightHom.Carrier z := RightRestriction.pullback.apply z u;
\import MV.Coordinates[].At[z := z] \as Compare;
\import MV.Coordinates[].Difference[z := z] \as Difference;
\definition agree: \forall (u: WholeRelative.Carrier z) -> LeftPull.pullback.apply z (left u) = RightPull.pullback.apply z (right u) :=
  \fun (u: WholeRelative.Carrier z) => eq_reason_in!{{OverlapHom.Carrier z} _
    "=" _ "by" { congr!{{LeftHom.Carrier z} {OverlapHom.Carrier z}} (LeftPull.pullback.apply z) _ _ (sym!{{LeftHom.Carrier z}} _ _ (Compare.left u)) }
    "=" _ "by" { Difference.inclusionAgreement (WholeComparison.restriction.apply z u) }
    "=" _ "by" { congr!{{RightHom.Carrier z} {OverlapHom.Carrier z}} (RightPull.pullback.apply z) _ _ (Compare.right u) }
  };
\import IntegerCochains.At[C := WholeRelative.complex, z := z] \as WholeH;
\definition Cycle: \Set := WholeH.Closed;
\import IntegerCochains.Map[C := WholeRelative.complex, D := LeftHom.complex].At[k := z] \as LeftAction;
\import IntegerCochains.Map[C := WholeRelative.complex, D := RightHom.complex].At[k := z] \as RightAction;
\definition leftCycle[u: Cycle]: IntegerCochains.At[C := LeftHom.complex, z := z].Closed := (LeftAction.cyclesMap LeftRestriction.pullback).apply u;
\definition rightCycle[u: Cycle]: IntegerCochains.At[C := RightHom.complex, z := z].Closed := (RightAction.cyclesMap RightRestriction.pullback).apply u;
