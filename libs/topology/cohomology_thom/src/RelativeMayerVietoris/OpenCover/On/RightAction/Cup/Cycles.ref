\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\import \parent.Differential[] \as Differential;
\import \parent.\parent.Cup[p := N.Nat^::succ p, q := q] \as Upper;
\import IntegerCochains.At[C := SourceSmallHom.complex, z := inputDegree] \as Input;
\import IntegerCochains.At[C := SmallHom.complex, z := outputDegree] \as Output;
\definition zero[k: N.Nat^]: Differential.SmallRaw k := (SmallHom.space (I.Int^::ofNat k)).zero;
\definition closed: \forall (u: Restriction.Cycle)(h: Input.Closed) -> SmallHom.complex.differential.apply outputDegree (apply u h) = (SmallHom.space Differential.higherZ).zero :=
  \fun (u: Restriction.Cycle)(h: Input.Closed) => eq_reason_in!{{SmallHom.Carrier Differential.higherZ} _
    "=" _ "by" { Differential.law u h }
    "=" _ "by" { congr!{{SourceSmallHom.Carrier (I.Int^::ofNat (N.Nat^::succ p))} {SmallHom.Carrier Differential.higherZ}} (Differential.cast u) _ _ (\bysub(SourceSmallHom.Carrier inputDegree, (Input.cycles).carrier, h)) }
    "=" _ "by" { congr!{{SmallHom.Carrier Differential.upperZ} {SmallHom.Carrier Differential.higherZ}} (Transport.cast Differential.SmallRaw Differential.upperTotal Differential.higher Differential.same) _ _ (Upper.Addition[].zero u) }
    "=" _ "by" { Transport.pointNatural Differential.SmallRaw zero Differential.upperTotal Differential.higher Differential.same }
  };
\definition cycle[u: Restriction.Cycle][h: Input.Closed]: Output.Closed := Output.cycle (apply u h) (closed u h);
