\import SourceCover.Cohomology[coefficients := WholeProduct.integerCoefficients] \as SourceMV;
\import \root.RelativeMayerVietoris[].OpenCover[A := A, source := source, subset := subset].On[cover := cover].Cohomology[coefficients := WholeProduct.integerCoefficients] \as TargetMV;
\import SourceMV.Degree[z := d] \as S;
\import SourceMV.Degree[z := chain_complexes.Integer[].next d] \as S1;
\import TargetMV.Degree[z := k] \as T;
\import TargetMV.Degree[z := chain_complexes.Integer[].next k] \as T1;
\import SourceMV.At[z := d] \as SM;
\import SourceMV.At[z := chain_complexes.Integer[].next d] \as SM1;
\import TargetMV.At[z := k] \as TM;
\import TargetMV.At[z := chain_complexes.Integer[].next k] \as TM1;
\import Modules.ExactFive[A := S.directSum, B := S.intersection, C := S1.whole, D := S1.directSum, E := S1.intersection] \as SourceFive;
\import Modules.ExactFive[A := T.directSum, B := T.intersection, C := T1.whole, D := T1.directSum, E := T1.intersection] \as TargetFive;
\definition sourceFive: SourceFive.Sequence := SourceFive.Sequence {
  first := SM.difference, second := SM.connecting, third := SM1.restriction, last := SM1.difference,
  zeroB := SM.exactAtIntersection.zero, zeroC := SM.exactAtWhole.zero, zeroD := SM1.exactAtSum.zero,
  kernelB := SM.exactAtIntersection.kernelImage, kernelC := SM.exactAtWhole.kernelImage, kernelD := SM1.exactAtSum.kernelImage
};
\definition targetFive: TargetFive.Sequence := TargetFive.Sequence {
  first := TM.difference, second := TM.connecting, third := TM1.restriction, last := TM1.difference,
  zeroB := TM.exactAtIntersection.zero, zeroC := TM.exactAtWhole.zero, zeroD := TM1.exactAtSum.zero,
  kernelB := TM.exactAtIntersection.kernelImage, kernelC := TM.exactAtWhole.kernelImage, kernelD := TM1.exactAtSum.kernelImage
};
\import \parent.Diagram[d := d, k := k] \as Lower;
\import \parent.Diagram[d := chain_complexes.Integer[].next d, k := chain_complexes.Integer[].next k] \as Upper;
\module Along(lower: Lower.Comparison, upper: Upper.Comparison);
