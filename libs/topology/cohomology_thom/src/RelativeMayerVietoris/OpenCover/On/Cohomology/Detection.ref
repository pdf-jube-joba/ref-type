\definition previous: I.Int^ := Degrees.previous z;
\definition next: I.Int^ := Degrees.next previous;
\import \parent.Gluing[z := previous] \as Previous;
\definition Vanishes: \Prop := \forall (a: \parent.Degree[z := previous].intersection.Carrier) -> a = \parent.Degree[z := previous].intersection.space.zero;
\definition injective: Vanishes -> \forall (a, b: \parent.Degree[z := z].whole.Carrier) -> \parent.At[z := z].restriction.apply a = \parent.At[z := z].restriction.apply b -> a = b :=
  \idelim next = z \with k: I.Int^ => Vanishes -> \forall (a, b: \parent.Degree[z := k].whole.Carrier) -> \parent.At[z := k].restriction.apply a = \parent.At[z := k].restriction.apply b -> a = b
  \by { base: Previous.injective, equality: Degrees.nextPrevious z };
