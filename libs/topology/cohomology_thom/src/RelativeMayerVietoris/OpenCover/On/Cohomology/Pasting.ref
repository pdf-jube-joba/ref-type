\import \parent.Degree[z := z] \as Current;
\import \parent.At[z := z] \as Maps;
\import \parent.Detection[z := z] \as Detection;
\definition Vanishes: \Prop := Detection.Vanishes;
\definition Compatible: \Pow Current.directSum.Carrier := { x: Current.directSum.Carrier \where Maps.difference.apply x = Current.intersection.space.zero };
\definition Local: \Set := \Cast[Current.directSum.Carrier] Compatible;
\definition Values[x: Local]: \Pow Current.whole.Carrier := { u: Current.whole.Carrier \where Maps.restriction.apply u = x };
\definition Lift[x: Local]: \Set := \Cast[Current.whole.Carrier] (Values x);
\definition existence: \forall (x: Local) -> \exists Lift x := \fun (x: Local) => Maps.exactAtSum.kernelImage x (\bysub(Current.directSum.Carrier, Compatible, x));
\definition unique: Vanishes -> \forall (x: Local)(u, v: Lift x) -> u = v :=
  \fun (vanishes: Vanishes)(x: Local)(u, v: Lift x) => Detection.injective vanishes u v
    (trans!{Current.directSum.Carrier} _ _ _ (\bysub(Current.whole.Carrier, Values x, u)) (sym!{Current.directSum.Carrier} _ _ (\bysub(Current.whole.Carrier, Values x, v))));
\definition glue[vanishes: Vanishes][x: Local]: Lift x := \choice Lift x \by { existence: existence x, uniqueness: unique vanishes x };
\definition restriction: \forall (vanishes: Vanishes)(x: Local) -> Maps.restriction.apply (glue vanishes x) = x :=
  \fun (vanishes: Vanishes)(x: Local) => \bysub(Current.whole.Carrier, Values x, glue vanishes x);
