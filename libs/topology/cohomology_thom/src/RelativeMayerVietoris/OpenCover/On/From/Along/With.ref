\use std.Logic[].Equality[].eq_reason_in;
\import \root.RelativeMayerVietoris[].OpenCover[A := A, source := source, subset := subset].On[cover := cover].With[coefficients := coefficients] \as SourceSequence;
\import Other.With[coefficients := coefficients] \as TargetSequence;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficients;
\import Hom.Integer[P := SmallPair.complex, N := coefficients] \as SourceSmall;
\import Hom.Integer[P := Sum.complex, N := coefficients] \as SourceSum;
\import Hom.Integer[P := O.complex, N := coefficients] \as SourceOverlap;
\import \root.RelativeMayerVietoris[].SmallPair[A := B, source := target, cover := OtherCover.openCover, subset := part] \as OtherSmall;
\import Hom.Integer[P := OtherSmall.complex, N := coefficients] \as TargetSmall;
\import Hom.Integer[P := OtherSum.complex, N := coefficients] \as TargetSum;
\import Hom.Integer[P := OtherO.complex, N := coefficients] \as TargetOverlap;
\import Hom.IntegerMapping[P := OtherSum.complex, Q := Sum.complex, N := coefficients, L := coefficients].On[f := sumMap, u := Coefficients.identity] \as SumPull;
\import Hom.IntegerMapping[P := OtherO.complex, Q := O.complex, N := coefficients, L := coefficients].On[f := OverlapChain.map, u := Coefficients.identity] \as OverlapPull;
\definition square: \forall (z: I.Int^)(h: SourceSum.Carrier z) -> TargetSequence.sequence.projection.apply z (SumPull.map.apply z h) = OverlapPull.map.apply z (SourceSequence.sequence.projection.apply z h) :=
  \fun (z: I.Int^)(h: SourceSum.Carrier z) => TargetOverlap.At[z := z].ext
    (TargetSequence.sequence.projection.apply z (SumPull.map.apply z h))
    (OverlapPull.map.apply z (SourceSequence.sequence.projection.apply z h))
    (\fun (x: OtherO.Carrier z) => congr!{{Sum.Carrier z} coefficients.Carrier} h.apply _ _ (inclusionSquare z x));
\import \root.RelativeMayerVietoris[].KernelLift[].For[A := SourceSmall.complex, B := SourceSum.complex, C := SourceOverlap.complex, A1 := TargetSmall.complex, B1 := TargetSum.complex, C1 := TargetOverlap.complex]
  .Along[s := SourceSequence.sequence, t := TargetSequence.sequence, b := SumPull.map, c := OverlapPull.map, square := square] \as Lift;
\definition smallMap: _ := Lift.map;
\module At(z: I.Int^) {
  \definition naturality: _ := Lift.Connecting[z := z].naturality;
}

\module Comparison;

\module Ordinary(z: I.Int^);
