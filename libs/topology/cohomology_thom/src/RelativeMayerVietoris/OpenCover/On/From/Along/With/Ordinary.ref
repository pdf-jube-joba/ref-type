\use std.Logic[].Equality[].eq_reason_in;
\definition next: I.Int^ := chain_complexes.Integer[].next z;
\import \root.RelativeMayerVietoris[].OpenCover[A := A, source := source, subset := subset].On[cover := cover].Cohomology[coefficients := coefficients].At[z := z] \as SourceMV;
\import Other.Cohomology[coefficients := coefficients].At[z := z] \as TargetMV;
\import Cochains.At[C := SourceOverlap.complex, z := z] \as Input;
\import Cochains.Map[C := SourceOverlap.complex, D := TargetOverlap.complex].At[k := z] \as OverlapAction;
\import \parent.Comparison[].Cohomology[z := next] \as Compare;
\import Cochains.At[C := TargetSmall.complex, z := next] \as TargetSmallH;
\import singular_cohomology.Relative[A := B, source := target, subset := part].With[coefficients := coefficients].At[z := next] \as Output;
\definition law: \forall (x: Input.Cohomology) -> TargetMV.connecting.apply ((OverlapAction.induced OverlapPull.map).apply x) = Compare.whole.apply (SourceMV.connecting.apply x) :=
  \fun (x: Input.Cohomology) => trans!{Output.Carrier} _ _ _
    (congr!{TargetSmallH.Cohomology Output.Carrier} Compare.targetIso.backward.apply _ _ (Lift.Connecting[z := z].naturality x))
    (Compare.inverse (SourceSequence.At[z := z].connecting.apply x));
