\import Modules.Laws[V := LeftHom.Carrier outputDegree, space := LeftHom.space outputDegree] \as LeftLaws;
\import algebra.Group[].Of[Carrier := LeftHom.Carrier outputDegree, group := LeftLaws.additive] \as LeftGroup;
\import Modules.Laws[V := RightHom.Carrier outputDegree, space := RightHom.space outputDegree] \as RightLaws;
\import algebra.Group[].Of[Carrier := RightHom.Carrier outputDegree, group := RightLaws.additive] \as RightGroup;
\definition left: \forall (a: WholeProduct.Carrier p)(h: SmallHom.Carrier inputDegree) ->
  Coordinates.firstProjection.apply outputDegree (sumProduct a h) = leftProduct a h :=
  \fun (a: WholeProduct.Carrier p)(h: SmallHom.Carrier inputDegree) => trans!{{LeftHom.Carrier outputDegree}} _ _ _
    (Coordinates.firstProjection.addition outputDegree (Coordinates.firstInjection.apply outputDegree (leftProduct a h)) (Coordinates.secondInjection.apply outputDegree (rightProduct a h)))
    (trans!{{LeftHom.Carrier outputDegree}} _ _ _
      (congr!{{LeftHom.Carrier outputDegree} {LeftHom.Carrier outputDegree} {LeftHom.Carrier outputDegree}} LeftGroup.add _ _ _ _ (Coordinates.firstRoundtrip outputDegree (leftProduct a h)) (Coordinates.firstCross outputDegree (rightProduct a h)))
      (LeftGroup.zeroRight (leftProduct a h)));
\definition right: \forall (a: WholeProduct.Carrier p)(h: SmallHom.Carrier inputDegree) ->
  Coordinates.secondProjection.apply outputDegree (sumProduct a h) = rightProduct a h :=
  \fun (a: WholeProduct.Carrier p)(h: SmallHom.Carrier inputDegree) => trans!{{RightHom.Carrier outputDegree}} _ _ _
    (Coordinates.secondProjection.addition outputDegree (Coordinates.firstInjection.apply outputDegree (leftProduct a h)) (Coordinates.secondInjection.apply outputDegree (rightProduct a h)))
    (trans!{{RightHom.Carrier outputDegree}} _ _ _
      (congr!{{RightHom.Carrier outputDegree} {RightHom.Carrier outputDegree} {RightHom.Carrier outputDegree}} RightGroup.add _ _ _ _ (Coordinates.secondCross outputDegree (leftProduct a h)) (Coordinates.secondRoundtrip outputDegree (rightProduct a h)))
      (RightGroup.zeroLeft (rightProduct a h)));
