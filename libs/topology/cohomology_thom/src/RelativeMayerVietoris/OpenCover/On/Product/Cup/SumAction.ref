\import Modules.Laws[V := LeftHom.Carrier outputDegree, space := LeftHom.space outputDegree] \as LeftLaws;
\import algebra.Group[].Of[Carrier := LeftHom.Carrier outputDegree, group := LeftLaws.additive] \as LeftGroup;
\import Modules.Laws[V := RightHom.Carrier outputDegree, space := RightHom.space outputDegree] \as RightLaws;
\import algebra.Group[].Of[Carrier := RightHom.Carrier outputDegree, group := RightLaws.additive] \as RightGroup;
\definition left: \forall (a: WholeProduct.Carrier p)(h: SumHom.Carrier inputDegree) ->
  Coordinates.firstProjection.apply outputDegree (sumAction a h) = sumLeft a h :=
  \fun (a: WholeProduct.Carrier p)(h: SumHom.Carrier inputDegree) => trans!{{LeftHom.Carrier outputDegree}} _ _ _
    (Coordinates.firstProjection.addition outputDegree (Coordinates.firstInjection.apply outputDegree (sumLeft a h)) (Coordinates.secondInjection.apply outputDegree (sumRight a h)))
    (trans!{{LeftHom.Carrier outputDegree}} _ _ _
      (congr!{{LeftHom.Carrier outputDegree} {LeftHom.Carrier outputDegree} {LeftHom.Carrier outputDegree}} LeftGroup.add _ _ _ _
        (Coordinates.firstRoundtrip outputDegree (sumLeft a h)) (Coordinates.firstCross outputDegree (sumRight a h)))
      (LeftGroup.zeroRight (sumLeft a h)));
\definition right: \forall (a: WholeProduct.Carrier p)(h: SumHom.Carrier inputDegree) ->
  Coordinates.secondProjection.apply outputDegree (sumAction a h) = sumRight a h :=
  \fun (a: WholeProduct.Carrier p)(h: SumHom.Carrier inputDegree) => trans!{{RightHom.Carrier outputDegree}} _ _ _
    (Coordinates.secondProjection.addition outputDegree (Coordinates.firstInjection.apply outputDegree (sumLeft a h)) (Coordinates.secondInjection.apply outputDegree (sumRight a h)))
    (trans!{{RightHom.Carrier outputDegree}} _ _ _
      (congr!{{RightHom.Carrier outputDegree} {RightHom.Carrier outputDegree} {RightHom.Carrier outputDegree}} RightGroup.add _ _ _ _
        (Coordinates.secondCross outputDegree (sumLeft a h)) (Coordinates.secondRoundtrip outputDegree (sumRight a h)))
      (RightGroup.zeroLeft (sumRight a h)));
\import module_theory.Module[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as RingModules;
\import OverlapCup.Degree[] \as OverlapDegree;
\import RingModules.Hom[V := OverlapHom.Carrier inputDegree, W := OverlapHom.Carrier outputDegree, source := OverlapDegree.space q, target := OverlapDegree.space total] \as CupMaps;
\definition rightLinear[a: OverlapProduct.Carrier p]: CupMaps.Map := CupMaps.Map {
  apply := OP.right a, addition := OP.Bilinear[].rightRightAdd a, scalar := \fun (r: K)(h: OverlapHom.Carrier inputDegree) => OP.Bilinear[].rightRightScale r a h,
};
\definition projection: \forall (a: WholeProduct.Carrier p)(h: SumHom.Carrier inputDegree) ->
  MV.sequence.projection.apply outputDegree (sumAction a h) = OP.right (Restriction.overlap a) (MV.sequence.projection.apply inputDegree h) :=
  \fun (a: WholeProduct.Carrier p)(h: SumHom.Carrier inputDegree) => eq_reason_in!{{OverlapHom.Carrier outputDegree} _
    "=" _ "by" { MV.sequence.projection.addition outputDegree (Coordinates.firstInjection.apply outputDegree (sumLeft a h)) (Coordinates.secondInjection.apply outputDegree (sumRight a h)) }
    "=" _ "by" { congr!{{OverlapHom.Carrier outputDegree} {OverlapHom.Carrier outputDegree} {OverlapHom.Carrier outputDegree}} OutputGroup.add _ _ _ _ (OutputDifference.left (sumLeft a h)) (OutputDifference.right (sumRight a h)) }
    "=" _ "by" { congr!{{OverlapHom.Carrier outputDegree} {OverlapHom.Carrier outputDegree} {OverlapHom.Carrier outputDegree}} OutputGroup.difference _ _ _ _
      (LeftPull.Cup[p := p, q := q].law (Restriction.left a) (Coordinates.firstProjection.apply inputDegree h))
      (trans!{{OverlapHom.Carrier outputDegree}} _ _ _ (RightPull.Cup[p := p, q := q].law (Restriction.right a) (Coordinates.secondProjection.apply inputDegree h))
        (congr!{{OverlapProduct.Carrier p} {OverlapHom.Carrier outputDegree}} (\fun (b: OverlapProduct.Carrier p) => OP.right b (RightPull.pullback.apply inputDegree (Coordinates.secondProjection.apply inputDegree h))) _ _ (sym!{{OverlapProduct.Carrier p}} _ _ (Restriction.agree a)))) }
    "=" _ "by" { sym!{{OverlapHom.Carrier outputDegree}} _ _ (CupMaps.differencePreserved (rightLinear (Restriction.overlap a)) (InputDifference.leftValue h) (InputDifference.rightValue h)) }
    "=" _ "by" { congr!{{OverlapHom.Carrier inputDegree} {OverlapHom.Carrier outputDegree}} (OP.right (Restriction.overlap a)) _ _ (sym!{{OverlapHom.Carrier inputDegree}} _ _ (InputDifference.cochains h)) }
  };

\module Differential;

\module Difference;
