\import Modules.Laws[V := SumHom.Carrier inputDegree, space := SumHom.space inputDegree] \as InputLaws;
\import algebra.Group[].Of[Carrier := SumHom.Carrier inputDegree, group := InputLaws.additive] \as InputGroup;
\import Modules.Laws[V := SumHom.Carrier outputDegree, space := SumHom.space outputDegree] \as OutputLaws;
\import algebra.Group[].Of[Carrier := SumHom.Carrier outputDegree, group := OutputLaws.additive] \as ResultGroup;
\import LeftCup.Degree[] \as LeftDegree;
\import RingModules.Hom[V := LeftHom.Carrier inputDegree, W := LeftHom.Carrier outputDegree, source := LeftDegree.space q, target := LeftDegree.space total] \as LeftCupMaps;
\definition leftLinear[a: LeftProduct.Carrier p]: LeftCupMaps.Map := LeftCupMaps.Map {
  apply := LP.right a, addition := LP.Bilinear[].rightRightAdd a,
  scalar := \fun (r: K)(h: LeftHom.Carrier inputDegree) => LP.Bilinear[].rightRightScale r a h,
};
\import IntegerCochains.Map[C := SumHom.complex, D := LeftHom.complex].At[k := inputDegree] \as LeftBefore;
\import IntegerCochains.Map[C := SumHom.complex, D := LeftHom.complex].At[k := outputDegree] \as LeftAfter;
\import Modules.Hom[V := SumHom.Carrier inputDegree, W := LeftHom.Carrier inputDegree, source := SumHom.space inputDegree, target := LeftHom.space inputDegree] \as LeftInputMaps;
\import Modules.Hom[V := SumHom.Carrier outputDegree, W := LeftHom.Carrier outputDegree, source := SumHom.space outputDegree, target := LeftHom.space outputDegree] \as LeftOutputMaps;
\definition leftLaw: \forall (a: WholeProduct.Carrier p)(h, j: SumHom.Carrier inputDegree) ->
  Coordinates.firstProjection.apply outputDegree (sumAction a (InputGroup.difference h j)) =
  Coordinates.firstProjection.apply outputDegree (ResultGroup.difference (sumAction a h) (sumAction a j)) :=
  \fun (a: WholeProduct.Carrier p)(h, j: SumHom.Carrier inputDegree) => eq_reason_in!{{LeftHom.Carrier outputDegree} _
    "=" _ "by" { left a (InputGroup.difference h j) }
    "=" _ "by" { congr!{{LeftHom.Carrier inputDegree} {LeftHom.Carrier outputDegree}} (LP.right (Restriction.left a)) _ _ (LeftInputMaps.differencePreserved (LeftBefore.linear Coordinates.firstProjection) h j) }
    "=" _ "by" { LeftCupMaps.differencePreserved (leftLinear (Restriction.left a)) (Coordinates.firstProjection.apply inputDegree h) (Coordinates.firstProjection.apply inputDegree j) }
    "=" _ "by" { congr!{{LeftHom.Carrier outputDegree} {LeftHom.Carrier outputDegree} {LeftHom.Carrier outputDegree}} LeftGroup.difference _ _ _ _ (sym!{{LeftHom.Carrier outputDegree}} _ _ (left a h)) (sym!{{LeftHom.Carrier outputDegree}} _ _ (left a j)) }
    "=" _ "by" { sym!{{LeftHom.Carrier outputDegree}} _ _ (LeftOutputMaps.differencePreserved (LeftAfter.linear Coordinates.firstProjection) (sumAction a h) (sumAction a j)) }
  };
\import RightCup.Degree[] \as RightDegree;
\import RingModules.Hom[V := RightHom.Carrier inputDegree, W := RightHom.Carrier outputDegree, source := RightDegree.space q, target := RightDegree.space total] \as RightCupMaps;
\definition rightLinear[a: RightProduct.Carrier p]: RightCupMaps.Map := RightCupMaps.Map {
  apply := RP.right a, addition := RP.Bilinear[].rightRightAdd a,
  scalar := \fun (r: K)(h: RightHom.Carrier inputDegree) => RP.Bilinear[].rightRightScale r a h,
};
\import IntegerCochains.Map[C := SumHom.complex, D := RightHom.complex].At[k := inputDegree] \as RightBefore;
\import IntegerCochains.Map[C := SumHom.complex, D := RightHom.complex].At[k := outputDegree] \as RightAfter;
\import Modules.Hom[V := SumHom.Carrier inputDegree, W := RightHom.Carrier inputDegree, source := SumHom.space inputDegree, target := RightHom.space inputDegree] \as RightInputMaps;
\import Modules.Hom[V := SumHom.Carrier outputDegree, W := RightHom.Carrier outputDegree, source := SumHom.space outputDegree, target := RightHom.space outputDegree] \as RightOutputMaps;
\definition rightLaw: \forall (a: WholeProduct.Carrier p)(h, j: SumHom.Carrier inputDegree) ->
  Coordinates.secondProjection.apply outputDegree (sumAction a (InputGroup.difference h j)) =
  Coordinates.secondProjection.apply outputDegree (ResultGroup.difference (sumAction a h) (sumAction a j)) :=
  \fun (a: WholeProduct.Carrier p)(h, j: SumHom.Carrier inputDegree) => eq_reason_in!{{RightHom.Carrier outputDegree} _
    "=" _ "by" { right a (InputGroup.difference h j) }
    "=" _ "by" { congr!{{RightHom.Carrier inputDegree} {RightHom.Carrier outputDegree}} (RP.right (Restriction.right a)) _ _ (RightInputMaps.differencePreserved (RightBefore.linear Coordinates.secondProjection) h j) }
    "=" _ "by" { RightCupMaps.differencePreserved (rightLinear (Restriction.right a)) (Coordinates.secondProjection.apply inputDegree h) (Coordinates.secondProjection.apply inputDegree j) }
    "=" _ "by" { congr!{{RightHom.Carrier outputDegree} {RightHom.Carrier outputDegree} {RightHom.Carrier outputDegree}} RightGroup.difference _ _ _ _ (sym!{{RightHom.Carrier outputDegree}} _ _ (right a h)) (sym!{{RightHom.Carrier outputDegree}} _ _ (right a j)) }
    "=" _ "by" { sym!{{RightHom.Carrier outputDegree}} _ _ (RightOutputMaps.differencePreserved (RightAfter.linear Coordinates.secondProjection) (sumAction a h) (sumAction a j)) }
  };
\definition law: \forall (a: WholeProduct.Carrier p)(h, j: SumHom.Carrier inputDegree) ->
  sumAction a (InputGroup.difference h j) = ResultGroup.difference (sumAction a h) (sumAction a j) :=
  \fun (a: WholeProduct.Carrier p)(h, j: SumHom.Carrier inputDegree) => Coordinates.ext outputDegree _ _ (leftLaw a h j) (rightLaw a h j);
