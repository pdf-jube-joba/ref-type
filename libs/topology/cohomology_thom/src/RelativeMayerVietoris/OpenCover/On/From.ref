\import \root.RelativeMayerVietoris[].OpenCover[A := B, source := target, subset := part].On[cover := otherCover] \as Other;
\import singular_excision.MayerVietoris[A := B].Over[source := target].On[cover := otherCover] \as OtherCover;
\import singular_cohomology.Relative[A := B, source := target, subset := part] \as Domain;
\import Domain.Maps[B := A].Over[target := source, targetSubset := subset] \as Maps;
\module Along(f: Maps.Map,
  leftContains: \forall (x: Other.Left) -> \In[A] Cover.left (f x),
  rightContains: \forall (x: Other.Right) -> \In[A] Cover.right (f x));
