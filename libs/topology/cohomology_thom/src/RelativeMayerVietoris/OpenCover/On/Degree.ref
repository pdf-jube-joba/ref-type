\definition index: I.Int^ := I.Int^::ofNat n;
\import singular_cohomology.Simplices[A := Left, source := leftTopology] \as LeftSimplices;
\import singular_cohomology.Simplices[A := Right, source := rightTopology] \as RightSimplices;
\import singular_cohomology.Simplices[A := Overlap, source := overlapTopology] \as OverlapSimplices;
\import singular_subdivision.Small[A := A, source := source, family := Cover.family].Simplices[] \as SmallSimplices;
\import algebraic_topology.Simplex[] \as Simplex;
\definition boundary: \Pow (SmallSimplices.Carrier n) := { sigma: SmallSimplices.Carrier n \where \forall (x: Simplex.Carrier n) -> \In[A] subset (sigma x) };
\import \root.RelativeMayerVietoris[].FreeCover[L := LeftSimplices.Carrier n, R := RightSimplices.Carrier n, O := OverlapSimplices.Carrier n,
  W := SmallSimplices.Carrier n, cover := Absolute.Degree[n := n].union, boundary := boundary] \as Generators;
\import LeftBasis.Degree[n := n] \as LB;
\import RightBasis.Degree[n := n] \as RB;
\import OverlapBasis.Degree[n := n] \as OB;
\import SmallPair.Degree[n := n] \as WB;
\import Modules.Free[Generators := Generators.Left] \as LF;
\import Modules.Free[Generators := Generators.Right] \as RF;
\import Modules.Free[Generators := Generators.Overlap] \as OF;
\import Modules.Free[Generators := Generators.Whole] \as WF;
\definition leftIsomorphism: Modules.Isomorphism[V := LF.Carrier, W := L.Carrier index, source := LF.space, target := L.space index].Isomorphism := LB.isomorphism;
\definition rightIsomorphism: Modules.Isomorphism[V := RF.Carrier, W := R.Carrier index, source := RF.space, target := R.space index].Isomorphism := RB.isomorphism;
\definition overlapIsomorphism: Modules.Isomorphism[V := OF.Carrier, W := O.Carrier index, source := OF.space, target := O.space index].Isomorphism := OB.isomorphism;
\definition wholeIsomorphism: Modules.Isomorphism[V := WF.Carrier, W := SmallPair.complex.family.Carrier index, source := WF.space, target := SmallPair.complex.family.space index].Isomorphism := WB.isomorphism;
\import Modules.Biproduct[V := LF.Carrier, W := RF.Carrier, left := LF.space, right := RF.space] \as FreeSum;
\import Modules.FreePullback[Left := Generators.Left, Right := Generators.Right, Overlap := Generators.Overlap, Whole := Generators.Whole]
  .Covering[square := Generators.union] \as Free;
\module SumComparison;
\module Naturality;
\module Exactness;
