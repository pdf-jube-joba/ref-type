\import Chains.ShortExact[A := O.complex, B := Sum.complex, C := SmallPair.complex] \as Exact;
\definition sequence: Exact.Sequence := Exact.Sequence {
  inclusion := inclusion, projection := projection,
  injective := \induction (z: I.Int^) \return \forall (x, y: O.Carrier z) -> inclusion.apply z x = inclusion.apply z y -> x = y \with {
    | ofNat: \fun (n: N.Nat^) => \parent.Degree[n := n].Exactness[].injective
    | negSucc: \fun (n: N.Nat^) => \parent.Negative[n := n].injective
  },
  onto := \induction (z: I.Int^) \return \forall (x: SmallPair.complex.family.Carrier z) -> \exists ( y: Sum.Carrier z \where projection.apply z y = x ) \with {
    | ofNat: \fun (n: N.Nat^) => \parent.Degree[n := n].Exactness[].onto
    | negSucc: \fun (n: N.Nat^) => \parent.Negative[n := n].onto
  },
  zero := \induction (z: I.Int^) \return \forall (x: O.Carrier z) -> projection.apply z (inclusion.apply z x) = (SmallPair.complex.family.space z).zero \with {
    | ofNat: \fun (n: N.Nat^) => \parent.Degree[n := n].Exactness[].zero
    | negSucc: \fun (n: N.Nat^) => \parent.Negative[n := n].zero
  },
  kernelImage := \induction (z: I.Int^) \return \forall (y: Sum.Carrier z) -> projection.apply z y = (SmallPair.complex.family.space z).zero ->
    \exists ( x: O.Carrier z \where inclusion.apply z x = y ) \with {
      | ofNat: \fun (n: N.Nat^) => \parent.Degree[n := n].Exactness[].kernelImage
      | negSucc: \fun (n: N.Nat^) => \parent.Negative[n := n].kernelImage
    }
};
\definition retraction: \forall (z: I.Int^) -> Modules.Hom[V := Sum.Carrier z, W := O.Carrier z, source := Sum.space z, target := O.space z].Map :=
  \induction (z: I.Int^) \return Modules.Hom[V := Sum.Carrier z, W := O.Carrier z, source := Sum.space z, target := O.space z].Map \with {
    | ofNat: \fun (n: N.Nat^) => \parent.Degree[n := n].Exactness[].retraction
    | negSucc: \fun (n: N.Nat^) => \parent.Negative[n := n].retraction
  };
\definition leftInverse: \forall (z: I.Int^)(x: O.Carrier z) -> (retraction z).apply (inclusion.apply z x) = x :=
  \induction (z: I.Int^) \return \forall (x: O.Carrier z) -> (retraction z).apply (inclusion.apply z x) = x \with {
    | ofNat: \fun (n: N.Nat^) => \parent.Degree[n := n].Exactness[].leftInverse
    | negSucc: \fun (n: N.Nat^) => \parent.Negative[n := n].leftInverse
  };
\definition quotientIsomorphism: _ := Exact.Cokernel[s := sequence].isomorphism;
