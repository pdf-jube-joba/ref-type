\import LeftProduct.Pullback[B := A, target := source] \as WholeToLeft;
\import RightProduct.Pullback[B := A, target := source] \as WholeToRight;
\definition leftContinuous: _ := (LeftIntoWhole.laws leftPairMap).continuous;
\definition rightContinuous: _ := (RightIntoWhole.laws rightPairMap).continuous;
\definition overlapLeftContinuous: _ := (IntoLeft.laws toLeft).continuous;
\definition overlapRightContinuous: _ := (IntoRight.laws toRight).continuous;
\import OverlapProduct.Pullback[B := Left, target := leftTopology] \as LeftToOverlap;
\import OverlapProduct.Pullback[B := Right, target := rightTopology] \as RightToOverlap;
\import \root.RelativePullback[].On[A := Overlap, source := overlapTopology, subset := overlapPart, R := K, ring := ring].To[B := Left, target := leftTopology, part := leftPart].Along[f := toLeft] \as LeftPull;
\import \root.RelativePullback[].On[A := Overlap, source := overlapTopology, subset := overlapPart, R := K, ring := ring].To[B := Right, target := rightTopology, part := rightPart].Along[f := toRight] \as RightPull;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as IntegerCochains;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as OrdinaryCochains;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := WholeProduct.integerCoefficients] \as WholeOrdinary;
