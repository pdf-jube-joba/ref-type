\import singular_cohomology.Cochains[A := Right, source := rightTopology].With[coefficients := WholeProduct.integerCoefficients] \as RightOrdinary;
\import singular_cohomology.Maps[A := Left, B := A, source := leftTopology, target := source].Coefficients[M := WholeProduct.integerCoefficients, L := WholeProduct.integerCoefficients] \as LeftOrdinaryMaps;
\import singular_cohomology.Maps[A := Right, B := A, source := rightTopology, target := source].Coefficients[M := WholeProduct.integerCoefficients, L := WholeProduct.integerCoefficients] \as RightOrdinaryMaps;
