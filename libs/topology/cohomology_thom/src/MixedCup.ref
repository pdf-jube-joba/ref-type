\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import singular_products.Cochains[A := A, source := source, R := K, ring := ring] \as Cochains;
\import singular_cohomology.Relative[A := A, source := source, subset := first] \as First;
\import singular_cohomology.Relative[A := A, source := source, subset := second] \as Second;
\import First.With[coefficients := Cochains.integerCoefficients] \as FirstCochains;
\import Second.With[coefficients := Cochains.integerCoefficients] \as SecondCochains;
\import singular_cap.CochainPair[A := A, source := source, subset := first, R := K, ring := ring] \as FirstPair;
\import singular_cap.CochainPair[A := A, source := source, subset := second, R := K, ring := ring] \as SecondPair;
\import singular_cohomology.Chains[A := A, source := source] \as Chains;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients] \as Plain;
\module Cup(p, q: N.Nat^);

\module Common(n: N.Nat^);
\module CommonComplex;
\module LeftPrimitive(k, q: N.Nat^);
\module RightPrimitive(p, r: N.Nat^);
\module Boundaries;
\module Union;
\module From(Y: \Set, target: topology.Topology[Carrier := Y].Topology, firstPart, secondPart: \Pow Y,
  f: Y -> A, regular: topology.Continuity[A := Y, B := A].Continuous target source f,
  firstContained: \forall (y: Y) -> \In[Y] firstPart y -> \In[A] first (f y),
  secondContained: \forall (y: Y) -> \In[Y] secondPart y -> \In[A] second (f y));
\module Change(L: \Set, targetRing: std.Alg[].Ring[].CommutativeRing[L],
  morphism: \root.CoefficientChange[].OnSpace[A := A, source := source, R := K, S := L, ring := ring, targetRing := targetRing].Morphism);
