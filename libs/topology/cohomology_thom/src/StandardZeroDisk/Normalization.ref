\import singular_cap.CochainPair[A := Euclidean.Disk, source := Euclidean.diskTopology, subset := boundary, R := I.Int^, ring := Integers.commutativeRing].Comparison[n := N.Nat^::zero].Cohomology[] \as Forget;
\import singular_cohomology.Cochains[A := Euclidean.Disk, source := Euclidean.diskTopology].With[coefficients := Cochains.integerCoefficients] \as Ordinary;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring].At[C := Ordinary.complex, k := N.Nat^::zero] \as Absolute;
\definition unitImage: Empty.isomorphism.forward.apply unit = (Calculation.isomorphism unique).forward.apply Integers.ring.one :=
  trans!{Absolute.Cohomology} _ _ _ (Forget.onClass Unit.cycle)
    (congr!{Absolute.CycleCarrier Absolute.Cohomology} Absolute.classOf _ _ Unit.underlying);
\definition law: isomorphism.forward.apply Integers.ring.one = unit :=
  trans!{Class} _ _ _
    (congr!{Absolute.Cohomology Class} Empty.isomorphism.backward.apply _ _ (sym!{Absolute.Cohomology} _ _ unitImage))
    (Empty.isomorphism.leftInverse unit);
