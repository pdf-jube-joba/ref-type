\import real.Analysis[] \as R;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\definition shift: N.Nat^ -> I.Int^ -> I.Int^ := \induction (n: N.Nat^) \return I.Int^ -> I.Int^ \with {
  | zero: \fun (z: I.Int^) => z
  | succ: \fun (n: N.Nat^)(previous: I.Int^ -> I.Int^)(z: I.Int^) => chain_complexes.Integer[].next (previous z)
};
