\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Logic.either;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.eq_reason_in;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import algebraic_topology.Cylinder[A := A] \as Cylinder;
\import algebraic_topology.Interval[] \as J;
\import \root.RelativeSuspension[].On[A := A, source := source, subset := second] \as Suspension;
\definition firstPart: \Pow Cylinder.Carrier := { p: Cylinder.Carrier \where \In[A] first (Cylinder.point p) };
\definition secondPart: \Pow Cylinder.Carrier := Suspension.boundary;
\definition baseFamily: \Pow (\Pow A) := { U: \Pow A \where Logic.Or[U = first, U = second] };
\definition family: \Pow (\Pow Cylinder.Carrier) := { U: \Pow Cylinder.Carrier \where Logic.Or[U = firstPart, U = secondPart] };
\import \root.FamilyPair[A := A, source := source, family := baseFamily] \as Base;
\import \root.FamilyPair[A := Cylinder.Carrier, source := Suspension.topology, family := family] \as Total;
\import \root.FamilyMayerVietoris[A := Cylinder.Carrier, source := Suspension.topology, family := family, cover := Suspension.cover] \as MV;
\import Suspension.Halves[] \as Halves;
\module Slice(d: Suspension.SliceData);
\module Left;
\module Right;
\module Middle;
\module With(coefficients: Modules.Bundle);
\module Product(K: \Set, ring: std.Alg[].Ring[].CommutativeRing[K]);
