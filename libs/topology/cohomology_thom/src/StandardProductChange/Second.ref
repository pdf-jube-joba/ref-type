\import singular_cohomology.Relative[A := Right.Disk, source := Right.diskTopology, subset := RightShell.shell] \as DiskPair;
\import singular_cohomology.Relative[A := Old.Carrier, source := Old.topology, subset := Old.secondShell] \as SourcePair;
\import SourcePair.Maps[B := Right.Disk].Over[target := Right.diskTopology, targetSubset := RightShell.shell].On[f := Old.rightMap].Integer[] \as Projection;
\import \root.CoefficientChange[].On[C := DiskPair.complex, M := Source.integerCoefficients, N := Target.integerCoefficients, u := morphism.linear].Along[D := SourcePair.complex, f := Projection.map].At[z := I.Int^::ofNat m] \as Natural;
\import \root.RelativePullback[].On[A := Old.Carrier, source := Old.topology, subset := Old.secondShell, R := K, ring := ring].To[B := Right.Disk, target := Right.diskTopology, part := RightShell.shell].Along[f := Old.rightMap] \as OldPull;
\import \root.RelativePullback[].On[A := New.Carrier, source := New.topology, subset := New.secondShell, R := L, ring := targetRing].To[B := Right.Disk, target := Right.diskTopology, part := RightShell.shell].Along[f := New.rightMap] \as NewPull;
\import SourcePair.With[coefficients := Target.integerCoefficients].At[z := I.Int^::ofNat m] \as Output;
\import DiskPair.With[coefficients := Target.integerCoefficients].At[z := I.Int^::ofNat m] \as DiskOutput;
\definition old[a: RightPoint.Class]: _ := OldPull.Degree[n := m].map.apply (RightShell.Ring[K := K, ring := ring].lift a);
\definition changed[a: RightPoint.Class]: _ := NewPull.Degree[n := m].map.apply (RightShell.Ring[K := L, ring := targetRing].lift (RightChange.pointMap.apply a));
\definition law: \forall (a: RightPoint.Class) -> SecondChange.Degree[n := m].map.apply (old a) = changed a :=
  \fun (a: RightPoint.Class) => trans!{Output.Carrier} _ _ _ (Natural.law (RightShell.Ring[K := K, ring := ring].lift a))
    (congr!{DiskOutput.Carrier Output.Carrier} NewPull.Degree[n := m].map.apply _ _ (RightChange.liftLaw a));
