\import SourceSmall.At[n := n] \as SourceDegree;
\import TargetSmall.At[n := n] \as TargetDegree;
\import SmallMaps.At[n := n] \as SmallDegree;
\import Maps.At[n := n] \as WholeDegree;
\import Modules.Hom[V := SourceSmall.Carrier n, W := TargetWhole.Carrier n, source := SourceSmall.space n, target := TargetWhole.space n] \as Output;
\import Modules.Hom[V := SourceWhole.Carrier n, W := TargetWhole.Carrier n, source := SourceWhole.space n, target := TargetWhole.space n].Composition[U := SourceSmall.Carrier n, domain := SourceSmall.space n] \as Before;
\import Modules.Hom[V := TargetSmall.Carrier n, W := TargetWhole.Carrier n, source := TargetSmall.space n, target := TargetWhole.space n].Composition[U := SourceSmall.Carrier n, domain := SourceSmall.space n] \as After;
\import Modules.Free[Generators := SourceSimplices.Carrier n].To[W := TargetWhole.Carrier n, target := TargetWhole.space n] \as Free;
\definition equation: Before.compose (WholeDegree.push f regular) SourceDegree.inclusion = After.compose TargetDegree.inclusion (SmallDegree.push small) := Free.ext _ _
  (\fun (sigma: SourceSimplices.Carrier n) => trans!{{TargetWhole.Carrier n}} _ _ _
    (congr!{{SourceWhole.Carrier n} {TargetWhole.Carrier n}} (WholeDegree.push f regular).apply _ _ (SourceDegree.onGenerator sigma))
    (trans!{{TargetWhole.Carrier n}} _ _ _ (WholeDegree.onGenerator f regular sigma)
      (trans!{{TargetWhole.Carrier n}} _ _ _ (sym!{{TargetWhole.Carrier n}} _ _ (TargetDegree.onGenerator (small.apply n sigma)))
        (congr!{{TargetSmall.Carrier n} {TargetWhole.Carrier n}} TargetDegree.inclusion.apply _ _ (sym!{{TargetSmall.Carrier n}} _ _ (SmallDegree.onGenerator small sigma))))));
