\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Integer[P := SourcePair.complex, N := coefficients] \as Source;
\import Hom.Integer[P := FinalPair.complex, N := coefficients] \as Target;
\import Hom.IntegerComposition[P := SourcePair.complex, Q := TargetPair.complex, T := FinalPair.complex, N := coefficients] \as Product;
\import Hom.IntegerMapping[P := SourcePair.complex, Q := FinalPair.complex, N := coefficients, L := coefficients] \as Action;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Scalars;
\import \parent.\parent.With[coefficients := coefficients] \as First;
\definition law: \forall (z: I.Int^)(q: Target.Cohomology[z := z].Cohomology) ->
  (Composite.With[coefficients := coefficients].At[z := z].induced).apply q = (First.At[z := z].induced).apply ((Next.With[coefficients := coefficients].At[z := z].induced).apply q) :=
  \fun (z: I.Int^)(q: Target.Cohomology[z := z].Cohomology) => trans!{{Source.Cohomology[z := z].Cohomology}} _ _ _
    (congr!{Result.Map {Source.Cohomology[z := z].Cohomology}} (\fun (m: Result.Map) => (Action.On[f := m, u := Scalars.identity].At[z := z].map).apply q) _ _ (sym!{Result.Map} _ _ chainLaw))
    (Product.At[k := z].onCohomology firstMap Next.map q);
