\import std.Logic[].Proposition[] \as Logic;
\import algebraic_topology.Simplex[] \as Simplex;
\import Chains.Quotient[C := SourceBoundary.complex, D := SourceSpace.complex].On[f := SourceInclusion.map] \as SourceQ;
\import Chains.Quotient[C := TargetBoundary.complex, D := TargetSpace.complex].On[f := TargetInclusion.map] \as TargetQ;
\module Degree(n: N.Nat^);
\definition zero: \forall (z: I.Int^)(x: SourcePair.Carrier z) -> map.apply z x = (TargetPair.space z).zero :=
  \induction (z: I.Int^) \return \forall (x: SourcePair.Carrier z) -> map.apply z x = (TargetPair.space z).zero \with {
    | ofNat: \fun (n: N.Nat^) => SourceQ.At[k := I.Int^::ofNat n].induction
      (\fun (x: SourcePair.Carrier (I.Int^::ofNat n)) => map.apply (I.Int^::ofNat n) x = (TargetPair.space (I.Int^::ofNat n)).zero)
      (\fun (x: SourceSpace.Carrier (I.Int^::ofNat n)) => trans!{{TargetPair.Carrier (I.Int^::ofNat n)}} _ _ _ (\parent.At[z := I.Int^::ofNat n].onClass x) (Degree[n := n].zero x))
    | negSucc: \fun (n: N.Nat^)(x: SourcePair.Carrier (I.Int^::negSucc n)) => TargetPair.Negative[n := n].zero (map.apply (I.Int^::negSucc n) x)
  };
\module With(coefficients: Modules.Bundle);
