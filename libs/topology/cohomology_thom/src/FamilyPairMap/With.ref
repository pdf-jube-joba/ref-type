\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Integer[P := SourcePair.complex, N := coefficients] \as Source;
\import Hom.Integer[P := TargetPair.complex, N := coefficients] \as Target;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Scalars;
\import Hom.IntegerMapping[P := SourcePair.complex, Q := TargetPair.complex, N := coefficients, L := coefficients].On[f := map, u := Scalars.identity] \as Action;
\definition pullback: _ := Action.map;
\module At(z: I.Int^) {
  \import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring].Map[C := Target.complex, D := Source.complex].At[k := z] \as Degree;
  \definition induced: _ := Degree.induced pullback;
  \definition cycles: _ := Degree.cyclesMap pullback;
  \definition onClass: _ := Degree.onClass pullback;
}
