\use std.Logic[].Equality[].eq_reason_in;
\definition firstMap: Chains.Map[C := SourcePair.complex, D := TargetPair.complex].Map := map;
\import \root.FamilyPairMap[A := B, B := C, source := target, target := final, sourceFamily := targetFamily, targetFamily := finalFamily, f := g, regular := regularG, preserves := preservesG] \as Next;
\import singular_cohomology.Maps[A := A, B := C, source := source, target := final] \as FinalMaps;
\import singular_subdivision.Small[A := C, source := final, family := finalFamily].Simplices[] \as FinalSimplices;
\definition composed[x: A]: C := g (f x);
\definition regularComposed: topology.Continuity[A := A, B := C].Continuous source final composed := topology.Composition[A := A, B := B, C := C].composeContinuous source target final f g regular regularG;
\definition preservesComposed: \forall (n: N.Nat^)(sigma: SourceSimplices.Carrier n) ->
  \In[singular_cohomology.Simplices[A := C, source := final].Carrier n] (FinalSimplices.Small n) (FinalMaps.postcompose n composed regularComposed sigma) :=
  \fun (n: N.Nat^)(sigma: SourceSimplices.Carrier n) => preservesG n (small.apply n sigma);
\import \root.FamilyPairMap[A := A, B := C, source := source, target := final, sourceFamily := sourceFamily, targetFamily := finalFamily, f := composed, regular := regularComposed, preserves := preservesComposed] \as Composite;
\import \root.FamilyPair[A := C, source := final, family := finalFamily] \as FinalPair;
\import Chains.Map[C := TargetPair.complex, D := FinalPair.complex].Composition[B := SourcePair.complex] \as ChainComposition;
\import Chains.Map[C := SourcePair.complex, D := FinalPair.complex] \as Result;
\import singular_cohomology.Chains[A := C, source := final] \as FinalWhole;
\import Nonnegative.ZeroExtension[C := FinalWhole.complex] \as FinalSpace;
\import Chains.Map[C := SourceSpace.complex, D := FinalSpace.complex] \as WholeResult;
\import Maps.Composition[C := C, final := final].Integer[] \as WholeComposition;
\import Chains.Quotient[C := SourceBoundary.complex, D := SourceSpace.complex].On[f := SourceInclusion.map] \as SourceQ;
\definition map: Result.Map := Composite.map;
\definition onClass: \forall (z: I.Int^)(x: SourceSpace.Carrier z) -> Next.map.apply z (firstMap.apply z (SourcePair.class z x)) = map.apply z (SourcePair.class z x) :=
  \fun (z: I.Int^)(x: SourceSpace.Carrier z) => eq_reason_in!{{FinalPair.Carrier z} _
    "=" _ "by" { congr!{{TargetPair.Carrier z} {FinalPair.Carrier z}} (Next.map.apply z) _ _ (\parent.At[z := z].onClass x) }
    "=" _ "by" { Next.At[z := z].onClass (WholeExtension.map.apply z x) }
    "=" _ "by" { congr!{{FinalSpace.Carrier z} {FinalPair.Carrier z}} (FinalPair.class z) _ _
      (congr!{WholeResult.Map {FinalSpace.Carrier z}} (\fun (m: WholeResult.Map) => m.apply z x) _ _ (WholeComposition.law f regular g regularG)) }
    "=" _ "by" { sym!{{FinalPair.Carrier z}} _ _ (Composite.At[z := z].onClass x) }
  };
\definition chainLaw: ChainComposition.compose Next.map firstMap = map := Result.ext (ChainComposition.compose Next.map firstMap) map
  (\fun (z: I.Int^) => SourceQ.At[k := z].induction (\fun (q: SourcePair.Carrier z) => Next.map.apply z (firstMap.apply z q) = map.apply z q) (onClass z));
\module With(coefficients: Modules.Bundle);
