\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Integer[P := TargetPair.complex, N := coefficients] \as TargetCochains;
\import Hom.Integer[P := SourcePair.complex, N := coefficients] \as SourceCochains;
\import Hom.IntegerMapping[P := SourcePair.complex, Q := TargetPair.complex, N := coefficients, L := coefficients] \as Action;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Scalars;
\import Chains.Map[C := SourcePair.complex, D := TargetPair.complex] \as ChainMaps;
\import \parent.\parent.With[coefficients := coefficients] \as Original;
\definition law: \forall (z: I.Int^)(q: TargetCochains.Cohomology[z := z].Cohomology) ->
  (Original.At[z := z].induced).apply q = (Other.With[coefficients := coefficients].At[z := z].induced).apply q :=
  \fun (z: I.Int^)(q: TargetCochains.Cohomology[z := z].Cohomology) =>
    congr!{ChainMaps.Map {SourceCochains.Cohomology[z := z].Cohomology}}
      (\fun (f: ChainMaps.Map) => (Action.On[f := f, u := Scalars.identity].At[z := z].map).apply q) _ _ chainLaw;
