\import \root.FamilyPairMap[A := A, B := B, source := source, target := target, sourceFamily := sourceFamily, targetFamily := targetFamily, f := g, regular := regularG, preserves := preservesG] \as Other;
\definition chainLaw: map = Other.map :=
  (\idelim f = g \with h: (A -> B) =>
    \forall (hc: topology.Continuity[A := A, B := B].Continuous source target h)
      (hp: \forall (n: N.Nat^)(sigma: SourceSimplices.Carrier n) ->
        \In[singular_cohomology.Simplices[A := B, source := target].Carrier n] (TargetSimplices.Small n)
          (Maps.postcompose n h hc sigma)) ->
      map = \root.FamilyPairMap[A := A, B := B, source := source, target := target, sourceFamily := sourceFamily, targetFamily := targetFamily, f := h, regular := hc, preserves := hp].map
    \by {
      base: \fun (hc: topology.Continuity[A := A, B := B].Continuous source target f)
        (hp: \forall (n: N.Nat^)(sigma: SourceSimplices.Carrier n) ->
          \In[singular_cohomology.Simplices[A := B, source := target].Carrier n] (TargetSimplices.Small n)
            (Maps.postcompose n f hc sigma)) => \refl(map),
      equality: \axiom:funext(f, g, same)
    }) regularG preservesG;
\module With(coefficients: Modules.Bundle);
