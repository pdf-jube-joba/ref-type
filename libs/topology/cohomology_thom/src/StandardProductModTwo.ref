\import std.Data[].Nat[] \as N;
\import std.Data[].Bool[] \as B;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.eq_reason_in;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import algebra.Two[] \as Two;
\import thom_spaces.Thom[].CWType[].Point[] \as Point;
\import \root.CoefficientChange[].FromIntegers[K := Two.Carrier, ring := Two.commutativeRing].OnSpace[A := Point.Carrier, source := Point.topology] \as Canonical;
\import \root.StandardProductChange[n := n, m := m, K := I.Int^, L := Two.Carrier, ring := Integers.commutativeRing, targetRing := Two.commutativeRing, morphism := Canonical.morphism] \as Change;
\import \root.StandardProductIntegral[n := n, m := m] \as Integral;
\import \root.StandardProduct[n := n, m := m, K := I.Int^, ring := Integers.commutativeRing].Signs[] \as IntegralSigns;
\import \root.StandardProduct[n := n, m := m, K := Two.Carrier, ring := Two.commutativeRing] \as Actual;
\import \root.LocalDisk[].Point[K := Two.Carrier, ring := Two.commutativeRing].Rank[n := n] \as LeftPoint;
\import \root.LocalDisk[].Point[K := Two.Carrier, ring := Two.commutativeRing].Rank[n := m] \as RightPoint;
\definition degree: N.Nat^ := N.Basic[].Def[].add n m;
\import \root.StandardShell[n := degree] \as Shell;
\import \root.StandardShellChange[n := degree, K := I.Int^, L := Two.Carrier, ring := Integers.commutativeRing, targetRing := Two.commutativeRing, morphism := Canonical.morphism] \as OutputChange;
\import algebraic_topology.Euclidean[].Dimension[n := degree] \as Euclidean;
\import singular_products.Cochains[A := Euclidean.Disk, source := Euclidean.diskTopology, R := Two.Carrier, ring := Two.commutativeRing] \as Coefficients;
\import singular_cohomology.Relative[A := Euclidean.Disk, source := Euclidean.diskTopology, subset := Shell.boundary] \as Pair;
\import Pair.With[coefficients := Coefficients.integerCoefficients] \as Theory;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring].At[C := Theory.complex, z := I.Int^::ofNat degree] \as H;
\definition product: H.Cohomology := Actual.apply LeftPoint.generator RightPoint.generator;
\definition canonical: H.Cohomology := Shell.Ring[K := Two.Carrier, ring := Two.commutativeRing].generator;
\module Negative;
\module Comparison;
\definition law: product = canonical := Comparison[].law;
