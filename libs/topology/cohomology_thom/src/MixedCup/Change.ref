\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import \root.MixedCup[A := A, source := source, first := first, second := second, K := K, ring := ring] \as Old;
\import \root.MixedCup[A := A, source := source, first := first, second := second, K := L, ring := targetRing] \as New;
\import singular_products.Cochains[A := A, source := source, R := L, ring := targetRing] \as NewCochains;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := NewCochains.integerCoefficients] \as NewPlain;
\import \root.CoefficientChange[].OnSpace[A := A, source := source, R := K, S := L, ring := ring, targetRing := targetRing].With[morphism := morphism] \as Operations;
\import Operations.Relative[subset := first] \as FirstChange;
\import Operations.Relative[subset := second] \as SecondChange;
\import Operations.Relative[subset := Old.Union[].subset] \as UnionChange;
\import singular_cap.CochainPair[A := A, source := source, subset := first, R := L, ring := targetRing] \as NewFirstPair;
\import singular_cap.CochainPair[A := A, source := source, subset := second, R := L, ring := targetRing] \as NewSecondPair;
\import Old.CommonComplex[] \as OldCommon;
\import New.CommonComplex[] \as NewCommon;
\definition absolute: _ := Operations.cochainMap;
\module Common(n: N.Nat^);
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\definition commonMap: Nonnegative.Map[C := OldCommon.complex, D := NewCommon.complex].Map := Nonnegative.Map[C := OldCommon.complex, D := NewCommon.complex].Map {
  apply := \fun (n: N.Nat^)(h: OldCommon.family.Carrier n) => Common[n := n].apply h,
  addition := \fun (n: N.Nat^)(h, k: OldCommon.family.Carrier n) => absolute.addition n h k,
  scalar := \fun (n: N.Nat^)(a: I.Int^)(h: OldCommon.family.Carrier n) => absolute.scalar n a h,
  commutes := \fun (n: N.Nat^)(h: OldCommon.family.Carrier n) => absolute.commutes n h
};
\module Degree(n: N.Nat^);
\module Product(p, q: N.Nat^);
\module Covers(conditions: Old.Union[].Cover[].Conditions);
