\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import \root.MixedCup[A := A, source := source, first := first, second := second, K := K, ring := ring].CommonComplex[] \as CommonComplex;
\import CommonComplex.Forget[n := Product.total] \as CommonForget;
\import Product.Both[].Forget[] \as ProductForget;
\import \root.MixedCup[A := A, source := source, first := first, second := second, K := K, ring := ring].Union[].Comparison[n := Product.total] \as Canonical;
\import Canonical.Forget[] \as UnionForget;
\import Comparison.Canonical[] \as CompareCanonical;
\import Cochains.Cohomology[].Cup[p := p, q := q] \as Ordinary;
\import Cochains.Cohomology[] \as Absolute;
\import FirstPair.Comparison[n := p].Cohomology[] \as FirstForget;
\import SecondPair.Comparison[n := q].Cohomology[] \as SecondForget;
\import Pair.Comparison[n := Product.total].Cohomology[] \as Forget;
\definition law: \forall (x: Left.Cohomology)(y: Right.Cohomology) ->
  Forget.map.apply (apply x y) = Ordinary.apply (FirstForget.map.apply x) (SecondForget.map.apply y) :=
  \fun (x: Left.Cohomology)(y: Right.Cohomology) => trans!{{Absolute.Group Product.total}} _ _ _
    (sym!{{Absolute.Group Product.total}} _ _ (UnionForget.law (apply x y)))
    (trans!{{Absolute.Group Product.total}} _ _ _
      (congr!{{CommonComplex.At[n := Product.total].cohomology} {Absolute.Group Product.total}} CommonForget.map.apply _ _
        (sym!{{CommonComplex.At[n := Product.total].cohomology}} _ _ (CompareCanonical.law (apply x y))))
      (trans!{{Absolute.Group Product.total}} _ _ _
        (congr!{{CommonComplex.At[n := Product.total].cohomology} {Absolute.Group Product.total}} CommonForget.map.apply _ _ (comparison x y))
        (ProductForget.law x y)));
