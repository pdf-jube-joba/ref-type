\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import \parent.Cohomology[] \as Comparison;
\import \root.MixedCup[A := A, source := source, first := first, second := second, K := K, ring := ring].CommonComplex[].Forget[n := n] \as CommonForget;
\import Pair.Comparison[n := n].Cohomology[] \as Ordinary;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring].At[C := RelativeCochains.complex, z := I.Int^::ofNat n] \as Input;
\import Cochains.Cohomology[] \as Absolute;
\definition onClass: \forall (u: Input.Closed) -> CommonForget.map.apply (Comparison.map.apply (Input.classOf u)) = Ordinary.map.apply (Input.classOf u) :=
  \fun (u: Input.Closed) => trans!{{Absolute.Group n}} _ _ _
    (congr!{{\root.MixedCup[A := A, source := source, first := first, second := second, K := K, ring := ring].CommonComplex[].At[n := n].cohomology} {Absolute.Group n}} CommonForget.map.apply _ _ (Comparison.onClass u))
    (trans!{{Absolute.Group n}} _ _ _ (CommonForget.onClass (Comparison.cycle u)) (sym!{{Absolute.Group n}} _ _ (Ordinary.onClass u)));
\definition law: \forall (u: Input.Cohomology) -> CommonForget.map.apply (Comparison.map.apply u) = Ordinary.map.apply u :=
  Input.classInduction (\fun (u: Input.Cohomology) => CommonForget.map.apply (Comparison.map.apply u) = Ordinary.map.apply u) onClass;
