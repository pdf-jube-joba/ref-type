\import Nonnegative.Map[C := OldCommon.complex, D := NewCommon.complex].At[k := n] \as Action;
\definition common: _ := Action.induced commonMap;
\definition commonOnClass: _ := Action.onClass commonMap;
\import Old.Union[].Comparison[n := n].Cohomology[] \as OldComparison;
\import New.Union[].Comparison[n := n].Cohomology[] \as NewComparison;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Integer;
\import singular_cohomology.Relative[A := A, source := source, subset := Old.Union[].subset].With[coefficients := Cochains.integerCoefficients] \as Relative;
\import Integer.At[C := Relative.complex, z := I.Int^::ofNat n] \as Input;
\import Nonnegative.At[C := NewCommon.complex, k := n] \as Output;
\definition onClass: \forall (h: Input.Closed) -> common.apply (OldComparison.map.apply (Input.classOf h)) = NewComparison.map.apply (UnionChange.Degree[n := n].map.apply (Input.classOf h)) :=
  \fun (h: Input.Closed) => eq_reason_in!{Output.Cohomology _
    "=" _ "by" { congr!{{OldCommon.At[n := n].cohomology} Output.Cohomology} common.apply _ _ (OldComparison.onClass h) }
    "=" _ "by" { commonOnClass (OldComparison.cycle h) }
    "=" _ "by" { Output.equalClass ((Action.cyclesMap commonMap).apply (OldComparison.cycle h)) (NewComparison.cycle (UnionChange.Degree[n := n].cycles.apply h)) (sym!{{NewCochains.Carrier n}} _ _ (UnionChange.Compare[n := n].law h)) }
    "=" _ "by" { sym!{Output.Cohomology} _ _ (NewComparison.onClass (UnionChange.Degree[n := n].cycles.apply h)) }
    "=" _ "by" { congr!{{singular_cohomology.Relative[A := A, source := source, subset := New.Union[].subset].With[coefficients := NewCochains.integerCoefficients].At[z := I.Int^::ofNat n].Carrier} Output.Cohomology} NewComparison.map.apply _ _ (sym!{{singular_cohomology.Relative[A := A, source := source, subset := New.Union[].subset].With[coefficients := NewCochains.integerCoefficients].At[z := I.Int^::ofNat n].Carrier}} _ _ (UnionChange.Degree[n := n].onClass h)) }
  };
\definition law: \forall (h: Input.Cohomology) -> common.apply (OldComparison.map.apply h) = NewComparison.map.apply (UnionChange.Degree[n := n].map.apply h) :=
  Input.classInduction (\fun (h: Input.Cohomology) => common.apply (OldComparison.map.apply h) = NewComparison.map.apply (UnionChange.Degree[n := n].map.apply h)) onClass;
