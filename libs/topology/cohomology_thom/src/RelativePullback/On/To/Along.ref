\definition continuous: topology.Continuity[A := A, B := B].Continuous source target f := (Pairs.laws f).continuous;
\import Pairs.On[f := f].Integer[] \as ChainMap;
\import ChainMap.With[coefficients := Source.integerCoefficients] \as Native;
\import Source.Pullback[B := B, target := target] \as Ordinary;
\import SourcePair.With[coefficients := Source.integerCoefficients] \as RelativeSource;
\import TargetPair.With[coefficients := Source.integerCoefficients] \as RelativeTarget;
\definition pullback: _ := Native.pullback;
\module Compare(n: N.Nat^);
\module Cup(p, q: N.Nat^);

\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as IntegerCochains;
\import IntegerCochains.Map[C := RelativeTarget.complex, D := RelativeSource.complex] \as RelativeMaps;
\module Degree(n: N.Nat^) {
  \import RelativeMaps.At[k := I.Int^::ofNat n] \as Actions;
  \definition map: _ := Actions.induced pullback;
  \definition cycles: _ := Actions.cyclesMap pullback;
  \definition onClass: _ := Actions.onClass pullback;
  \module Forget;
}
