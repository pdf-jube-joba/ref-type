\import SourcePair.Homeomorphism[B := B].Over[target := target, targetSubset := part] \as Pairs;
\import \parent.Along[f := Pairs.forwardMap data] \as Pull;
\import module_theory.Module[].Over[R := R, ring := std.Alg[].Ring[].commutativeRingAsRing R ring] \as RingModules;
\import chain_complexes.Integer[].Over[R := R, ring := std.Alg[].Ring[].commutativeRingAsRing R ring] \as RingCochains;
\import SourcePair.OverRing[R := R, ring := ring].With[coefficients := Source.coefficients] \as Target;
\import singular_cohomology.Relative[A := B, source := target, subset := part].OverRing[R := R, ring := ring].With[coefficients := Source.coefficients] \as Domain;
\import SourcePair.Maps[B := B].Over[target := target, targetSubset := part].On[f := Pairs.forwardMap data].Integer[] \as Chain;
\import RingModules.End[V := R, space := Source.coefficients.space] \as Scalars;
\import resolutions.HomComplex[].Over[R := R, ring := ring].Abelian[N := Source.coefficients].Mapping[P := SourcePair.complex, Q := TargetPair.complex, L := Source.coefficients].On[f := Chain.map, u := Scalars.identity] \as Native;
\module Degree(n: N.Nat^);

\module Ordinary(n: N.Nat^);
\import singular_cohomology.Relative[A := B, source := target, subset := part].Homeomorphism[B := A].Over[target := source, targetSubset := subset] \as ReversePairs;
\definition inverseData: ReversePairs.Data := ReversePairs.Data {
  homeomorphism := topology.Homeomorphism[A := A, B := B].Inverse[].inverse source target data.homeomorphism,
  forwardPreserves := data.backwardPreserves, backwardPreserves := data.forwardPreserves
};
