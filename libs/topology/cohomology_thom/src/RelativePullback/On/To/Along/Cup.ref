\definition total: N.Nat^ := N.Basic[].Def[].add p q;
\import SourceCup.RelativeCup[p := p, q := q] \as Left;
\import TargetCup.RelativeCup[p := p, q := q] \as Right;
\import SourceCup.Comparison[n := total] \as LeftResult;
\import TargetCup.Comparison[n := total] \as RightResult;
\import SourceCup.Comparison[n := q] \as LeftInput;
\import TargetCup.Comparison[n := q] \as RightInput;
\import Source.Cup[p := p, q := q] \as Product;
\definition law: \forall (a: Target.Carrier p)(b: RelativeTarget.Carrier (I.Int^::ofNat q)) ->
  pullback.apply (I.Int^::ofNat total) (Right.right a b) = Left.right (Ordinary.apply p f continuous a) (pullback.apply (I.Int^::ofNat q) b) :=
  \fun (a: Target.Carrier p)(b: RelativeTarget.Carrier (I.Int^::ofNat q)) => LeftResult.injective _ _
    (eq_reason_in!{{Source.Carrier total} _
      "=" _ "by" { \parent.Compare[n := total].law (Right.right a b) }
      "=" _ "by" { congr!{{Target.Carrier total} {Source.Carrier total}} (Ordinary.apply total f continuous) _ _ (Right.rightRestriction a b) }
      "=" _ "by" { Ordinary.Cup[p := p, q := q].law f continuous a (RightInput.from b) }
      "=" _ "by" { congr!{{Source.Carrier q} {Source.Carrier total}} (Product.apply (Ordinary.apply p f continuous a)) _ _ (sym!{{Source.Carrier q}} _ _ (\parent.Compare[n := q].law b)) }
      "=" _ "by" { sym!{{Source.Carrier total}} _ _ (Left.rightRestriction (Ordinary.apply p f continuous a) (pullback.apply (I.Int^::ofNat q) b)) }
    });
\module Cohomology;
