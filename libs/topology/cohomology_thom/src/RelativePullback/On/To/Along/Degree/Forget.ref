\import IntegerCochains.At[C := RelativeTarget.complex, z := I.Int^::ofNat n] \as Domain;
\import SourceCup.Comparison[n := n].Cohomology[] \as Left;
\import TargetCup.Comparison[n := n].Cohomology[] \as Right;
\import Source.Cohomology[].Pullback[B := B, target := target] \as Pull;
\import singular_cohomology.Cochains[A := A, source := source].OverRing[R := R, ring := ring].With[coefficients := Source.coefficients] \as RingCochains;
\import chain_complexes.Cochain[].Over[R := R, ring := std.Alg[].Ring[].commutativeRingAsRing R ring].At[C := RingCochains.complex, k := n] \as Output;
\definition onClasses: \forall (h: Domain.Closed) -> Left.map.apply (map.apply (Domain.classOf h)) = Pull.apply n f continuous (Right.map.apply (Domain.classOf h)) :=
  \fun (h: Domain.Closed) => eq_reason_in!{Output.Cohomology _
    "=" _ "by" { congr!{{RelativeSource.cohomology n} Output.Cohomology} Left.map.apply _ _ (onClass h) }
    "=" _ "by" { Left.onClass (cycles.apply h) }
    "=" _ "by" { Output.equalClass (Left.cycle (cycles.apply h)) (Pull.At[n := n].cycle f continuous (Right.cycle h)) (\parent.\parent.Compare[n := n].law h) }
    "=" _ "by" { sym!{Output.Cohomology} _ _ (Pull.At[n := n].onClass f continuous (Right.cycle h)) }
    "=" _ "by" { congr!{{Target.Cohomology[].Group n} Output.Cohomology} (Pull.apply n f continuous) _ _ (sym!{{Target.Cohomology[].Group n}} _ _ (Right.onClass h)) }
  };
\definition law: \forall (q: Domain.Cohomology) -> Left.map.apply (map.apply q) = Pull.apply n f continuous (Right.map.apply q) :=
  Domain.classInduction (\fun (q: Domain.Cohomology) => Left.map.apply (map.apply q) = Pull.apply n f continuous (Right.map.apply q)) onClasses;
