\import SourceCup.Comparison[n := n] \as Left;
\import TargetCup.Comparison[n := n] \as Right;
\import singular_cohomology.Chains[A := A, source := source] \as Chains;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := Chains.complex].Positive[n := n] \as Positive;
\import Modules.Hom[V := Chains.Carrier n, W := R, source := Chains.space n, target := Source.integerCoefficients.space] \as Maps;
\definition law: \forall (h: RelativeTarget.Carrier (I.Int^::ofNat n)) ->
  Left.from (pullback.apply (I.Int^::ofNat n) h) = Ordinary.apply n f continuous (Right.from h) :=
  \fun (h: RelativeTarget.Carrier (I.Int^::ofNat n)) => Maps.ext
    (Left.from (pullback.apply (I.Int^::ofNat n) h)) (Ordinary.apply n f continuous (Right.from h))
    (\fun (x: Chains.Carrier n) => congr!{{TargetPair.Carrier (I.Int^::ofNat n)} R} h.apply _ _
      (ChainMap.At[z := I.Int^::ofNat n].quotientOnClass (Positive.intro x)));
