\import singular_products.Cochains[A := B, source := target, R := R, ring := ring] \as OtherProduct;
\import Source.Cohomology[].Pullback[B := B, target := target] \as Forward;
\import OtherProduct.Cohomology[].Pullback[B := A, target := source] \as Backward;
\import algebraic_topology.HomotopyEquivalence[A := A, B := B] \as Homotopy;
\definition equivalence: Homotopy.Equivalence[source, target] := Homotopy.fromHomeomorphism source target data.homeomorphism;
\import singular_cohomology.Equivalence[A := A, B := B, source := source, target := target].With[coefficients := Source.integerCoefficients] \as Equivalence;
\definition laws: topology.Homeomorphism[A := A, B := B].Laws[source, target, data.homeomorphism] := topology.Homeomorphism[A := A, B := B].laws source target data.homeomorphism;
\definition isomorphism: RingModules.Isomorphism[V := OtherProduct.Cohomology[].Group n, W := Source.Cohomology[].Group n, source := OtherProduct.Cohomology[].moduleSpace n, target := Source.Cohomology[].moduleSpace n].Isomorphism :=
  RingModules.Isomorphism[V := OtherProduct.Cohomology[].Group n, W := Source.Cohomology[].Group n, source := OtherProduct.Cohomology[].moduleSpace n, target := Source.Cohomology[].moduleSpace n].Isomorphism {
    forward := Forward.At[n := n].linear data.homeomorphism.forward laws.forwardContinuous,
    backward := Backward.At[n := n].linear data.homeomorphism.backward laws.backwardContinuous,
    leftInverse := Equivalence.rightInverse equivalence n,
    rightInverse := Equivalence.leftInverse equivalence n
  };
