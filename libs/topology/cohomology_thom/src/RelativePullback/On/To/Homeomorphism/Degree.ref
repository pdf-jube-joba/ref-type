\import RingCochains.At[C := Domain.complex, z := I.Int^::ofNat n] \as Input;
\import RingCochains.At[C := Target.complex, z := I.Int^::ofNat n] \as Output;
\definition native: _ := Pairs.With[coefficients := Source.integerCoefficients].At[z := I.Int^::ofNat n].isomorphism data;
\import RingCochains.Map[C := Domain.complex, D := Target.complex].At[k := I.Int^::ofNat n] \as Action;
\definition linear: _ := Action.induced Native.map;
\import RingModules.Isomorphism[V := Input.Cohomology, W := Output.Cohomology, source := Input.cohomologySpace, target := Output.cohomologySpace].OfBijective[f := linear] \as Inverse;
\definition injective: Inverse.Injective := \fun (u, v: Input.Cohomology)(same: linear.apply u = linear.apply v) => trans!{Input.Cohomology} _ _ _
  (sym!{Input.Cohomology} _ _ (native.leftInverse u))
  (trans!{Input.Cohomology} _ _ _ (congr!{Output.Cohomology Input.Cohomology} native.backward.apply _ _ same) (native.leftInverse v));
\definition onto: Inverse.Onto := \fun (v: Output.Cohomology) => std.Logic[].Proposition[].existsIntro[Input.Cohomology, { u: Input.Cohomology \where linear.apply u = v }]
  (native.backward.apply v) (native.rightInverse v);
\definition isomorphism: _ := Inverse.isomorphism injective onto;
