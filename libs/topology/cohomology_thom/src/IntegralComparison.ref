\import std.Arithmetic[].Int[] \as C03PrimitiveInteger;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as C03PrimitiveRing;
\import module_theory.Module[].Over[R := C03PrimitiveInteger.Int^, ring := C03PrimitiveRing.ring] \as C03PrimitiveModules;
\module CyclicMap(A, B: C03PrimitiveModules.Bundle, f: C03PrimitiveModules.MapBetween A B, u: A.Carrier,
  eA: C03PrimitiveModules.Isomorphism[V := C03PrimitiveInteger.Int^, W := A.Carrier, source := C03PrimitiveModules.scalarModule, target := A.space].Isomorphism,
  eB: C03PrimitiveModules.Isomorphism[V := C03PrimitiveInteger.Int^, W := B.Carrier, source := C03PrimitiveModules.scalarModule, target := B.space].Isomorphism,
  sourceUnit: eA.forward.apply C03PrimitiveRing.ring.one = u,
  targetUnit: eB.forward.apply C03PrimitiveRing.ring.one = f.apply u);
\module SignedConjugation(A, B, C, D: C03PrimitiveModules.Bundle, p: std.Data[].Nat[].Nat^,
  sourceIso: C03PrimitiveModules.Isomorphism[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space].Isomorphism,
  targetIso: C03PrimitiveModules.Isomorphism[V := C.Carrier, W := D.Carrier, source := C.space, target := D.space].Isomorphism,
  lowerIso: C03PrimitiveModules.Isomorphism[V := A.Carrier, W := C.Carrier, source := A.space, target := C.space].Isomorphism,
  upper: C03PrimitiveModules.MapBetween B D,
  comparison: \forall (x: A.Carrier) -> targetIso.forward.apply (lowerIso.forward.apply x) =
    C03PrimitiveModules.Alternating[V := D.Carrier, space := D.space].Concatenation[].twist p (upper.apply (sourceIso.forward.apply x)));

\module Point(n: std.Data[].Nat[].Nat^);
