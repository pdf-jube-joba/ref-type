\import real.Analysis[] \as Reals;
\import vector_bundles.Bundles[].Over[K := Reals.Real, field := Reals.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Bundles;
\module For(X: \Set, F: X -> \Set, bundle: Bundles.Family[X := X, F := F].Bundle);
\module DirectSum(X: \Set, F, G: X -> \Set,
  left: Bundles.Family[X := X, F := F].Bundle, right: Bundles.Family[X := X, F := G].Bundle,
  same: left.baseSpace = right.baseSpace,
  leftMetric: thom_spaces.Thom[].Real[].For[X := X, F := F, bundle := left].Metric,
  rightMetric: thom_spaces.Thom[].Real[].For[X := X, F := G, bundle := right].Metric);
