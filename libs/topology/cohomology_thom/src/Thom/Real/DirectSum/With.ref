\import SumGeometry.CompareGauges[left := Theory.For[X := X, F := Fiber, bundle := bundle].MetricGauge[metric := metric].data, right := Box.gauge] \as Radial;
\import Theory.For[X := X, F := Fiber, bundle := bundle].With[metric := metric] \as Disk;
\import \root.Thom[].Real[].For[X := X, F := Fiber, bundle := bundle].With[metric := metric] \as Geometry;
\import thom_spaces.Thom[].Levels[A := Family.Point, B := Family.Point, source := bundle.totalSpace, target := bundle.totalSpace,
  q := Disk.squared, r := Box.squared, h := Radial.totalHomeomorphism, forwardSquared := Radial.forwardSquared, backwardSquared := Radial.backwardSquared] \as Levels;
\import singular_cohomology.Relative[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary].Homeomorphism[B := Carrier].Over[target := topology, targetSubset := Box.Boundary] \as Pairs;
\definition pair: Pairs.Data := Pairs.Data {
  homeomorphism := Levels.diskHomeomorphism,
  forwardPreserves := \fun (p: \Cast[Disk.DiskBundle] Disk.Boundary) => Levels.preserves p (\bysub(Disk.DiskBundle, Disk.Boundary, p)),
  backwardPreserves := \fun (p: \Cast[Carrier] Box.Boundary) => Levels.reversePreserves p (\bysub(Carrier, Box.Boundary, p))
};
\import thom_spaces.Thom[].Real[].DirectSum[X := X, F := F, G := G, left := left, right := right, same := same, leftMetric := leftMetric, rightMetric := rightMetric].Compare[metric := metric] \as Iteration;
\definition thomHomeomorphism: _ := Iteration.homeomorphism;
\module Additive(coefficients: IntegerModules.Bundle, z: I.Int^) {
  \definition isomorphism: _ := Pairs.With[coefficients := coefficients].At[z := z].isomorphism pair;
}
\module Ring(K: \Set, ring: Rings.CommutativeRing[K]);
\module ZeroSection;
\module Fiber(x: X);
