\import Bundles.Family[X := X, F := F] \as LeftFamily;
\import Bundles.Family[X := X, F := G] \as RightFamily;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Equality[].Transport[A := X] \as Transport;
\definition base: p.base = q.base := congr!{LeftFamily.Point X} LeftFamily.projection _ _ firstSame;
\definition leftVector: Pair.first (F q.base) (G q.base) (Transport.cast Fiber p.base q.base base p.vector) = Pair.first (F q.base) (G q.base) q.vector :=
  trans!{{F q.base}} _ _ _
    (sym!{{F q.base}} _ _ (Transport.natural Fiber F (\fun (x: X)(v: Fiber x) => Pair.first (F x) (G x) v) p.base q.base base p.vector))
    (LeftFamily.vectorEquality (Sum.first p) (Sum.first q) firstSame);
\definition rightVector: Pair.second (F q.base) (G q.base) (Transport.cast Fiber p.base q.base base p.vector) = Pair.second (F q.base) (G q.base) q.vector :=
  trans!{{G q.base}} _ _ _
    (sym!{{G q.base}} _ _ (Transport.natural Fiber G (\fun (x: X)(v: Fiber x) => Pair.second (F x) (G x) v) p.base q.base base p.vector))
    (RightFamily.vectorEquality (Sum.second p) (Sum.second q) secondSame);
\definition equation: p = q := Family.ext p q base
  (Pair.Prop[A := F q.base, B := G q.base].ext (Transport.cast Fiber p.base q.base base p.vector) q.vector leftVector rightVector);
