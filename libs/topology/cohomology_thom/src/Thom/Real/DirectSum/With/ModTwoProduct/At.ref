\import \root.Thom[].Real[].DirectSum[X := X, F := F, G := G, left := left, right := right, same := same, leftMetric := leftMetric, rightMetric := rightMetric].With[metric := metric].Local[c := leftLocal.chart, d := rightLocal.chart] \as Coordinates;
\definition domain: \Pow X := Coordinates.U;
\definition open: Base.IsOpenIn bundle.baseSpace domain := Coordinates.open;
\definition contains: Base.Member domain x := Logic.And[Base.Member leftLocal.chart.domain x, Base.Member rightLocal.chart.domain x]::# leftLocal.contains rightLocal.contains;
\definition chart: _ := Coordinates.chart;
\definition rank: SumBundle.rank x = degree := trans!{N.Nat^} _ _ _
  (SumBundle.rankFrame x chart.dimension (chart.frame (\into[X](x, domain) \by { contains })))
  (congr!{N.Nat^ N.Nat^ N.Nat^} N.Basic[].Def[].add _ _ _ _ leftLocal.rank rightLocal.rank);
\module Refine(V: \Pow X, openV: Base.IsOpenIn bundle.baseSpace V, included: Base.Subset V domain);
\import \parent.At[x := x, leftLocal := leftLocal, rightLocal := rightLocal].Refine[V := domain, openV := open, included := (\fun (x: X)(inside: Base.Member domain x) => inside)] \as Whole;
\definition patch: Models.Patch[domain, fiber] := Models.Patch[domain, fiber] {
  open := open,
  refine := \fun (V: Models.Subdomain domain) => \parent.At[x := x, leftLocal := leftLocal, rightLocal := rightLocal].Refine[V := V, openV := Models.subdomainOpen domain V, included := Models.subdomainIncluded domain V].data,
  generates := \fun (y: \Cast[X] domain) => Whole.generates y
};
\definition local: Models.LocalOrientation[x, fiber] := Models.LocalOrientation[x, fiber] { domain := domain, patch := patch, contains := contains };
