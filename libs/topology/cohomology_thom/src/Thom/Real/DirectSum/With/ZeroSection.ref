\use std.Logic[].Equality[].eq_reason_in;
\definition zero[x: X]: Carrier := \into[Family.Point](Family.include x (bundle.space x).zero, Box.DiskSubset) \by {
  D.leReplaceLeft Reals.zero (Box.squared (Family.include x (bundle.space x).zero)) Reals.one (sym!{Reals.Real} _ _ (Box.zero x)) D.Arithmetic[].Prop[].oneNonnegative
};
\definition section[x: X]: Carrier := Levels.diskHomeomorphism.forward (Disk.zeroSection x);
\definition continuous: topology.Continuity[A := X, B := Carrier].Continuous bundle.baseSpace topology section :=
  topology.Composition[A := X, B := Disk.DiskBundle, C := Carrier].composeContinuous bundle.baseSpace Disk.diskTopology topology Disk.zeroSection Levels.diskHomeomorphism.forward Disk.zeroSectionContinuous
    (topology.Homeomorphism[A := Disk.DiskBundle, B := Carrier].laws Disk.diskTopology topology Levels.diskHomeomorphism).forwardContinuous;
\definition law: \forall (x: X) -> section x = zero x :=
  \fun (x: X) => trans!{Family.Point} _ _ _ (sym!{Family.Point} _ _ (Family.eta (section x)))
    (congr!{{Fiber x} Family.Point} (Family.include x) _ _
      (Box.definite (section x) (trans!{Reals.Real} _ _ _ (Radial.forwardSquared (Disk.zeroSection x)) (Disk.zeroSquared x))));
\definition firstLaw: \forall (x: X) -> first (section x) = LeftDisk.zeroSection x :=
  \fun (x: X) => congr!{Carrier {LeftDisk.DiskBundle}} first _ _ (law x);
\definition secondLaw: \forall (x: X) -> second (section x) = RightDisk.zeroSection x :=
  \fun (x: X) => congr!{Carrier {RightDisk.DiskBundle}} second _ _ (law x);
\definition clippedFirst: \forall (x: X) -> LeftGeometry.Shell[].clip (first (section x)) = LeftDisk.zeroSection x :=
  \fun (x: X) => trans!{{LeftDisk.DiskBundle}} _ _ _
    (congr!{{LeftDisk.DiskBundle} {LeftDisk.DiskBundle}} LeftGeometry.Shell[].clip _ _ (firstLaw x)) (LeftGeometry.Shell[].clipZero x);
\definition clippedSecond: \forall (x: X) -> RightGeometry.Shell[].clip (second (section x)) = RightDisk.zeroSection x :=
  \fun (x: X) => trans!{{RightDisk.DiskBundle}} _ _ _
    (congr!{{RightDisk.DiskBundle} {RightDisk.DiskBundle}} RightGeometry.Shell[].clip _ _ (secondLaw x)) (RightGeometry.Shell[].clipZero x);
\definition identity: topology.Continuity[A := X, B := X].Continuous bundle.baseSpace right.baseSpace (\fun (x: X) => x) :=
  \idelim left.baseSpace = right.baseSpace \with target: topology.Topology[Carrier := X].Topology => topology.Continuity[A := X, B := X].Continuous bundle.baseSpace target (\fun (x: X) => x) \by {
    base: topology.Maps[A := X, B := X].Identity[].continuous left.baseSpace, equality: same
  };
