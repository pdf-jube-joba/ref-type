\import Geometry.Local[K := Two.Carrier, ring := Two.commutativeRing].Rank[n := chart.dimension] \as Rank;
\import Rank.On[U := U] \as On;
\import Rank.Fiber[x := x] \as Fiber;
\import \parent.\parent.StandardModel[].Fiber[x := x].Ring[K := Two.Carrier, ring := Two.commutativeRing] \as Positive;
\definition generates: \forall (s: B.Bool^) -> Fiber.Generator ((On.restriction x).apply (model s).thomClass) :=
  \induction (s: B.Bool^) \return Fiber.Generator ((On.restriction x).apply (model s).thomClass) \with {
    | false: Positive.modelGenerates
    | true: \idelim Fiber.space.neg ((On.restriction x).apply LocalModel.data.thomClass) = (On.restriction x).apply (model B.Bool^::true).thomClass \with u: Fiber.Class => Fiber.Generator u \by {
        base: Fiber.negativeGenerator ((On.restriction x).apply LocalModel.data.thomClass) Positive.modelGenerates,
        equality: sym!{Fiber.Class} _ _ (On.negativeLaw x LocalModel.data.thomClass)
      }
  };
