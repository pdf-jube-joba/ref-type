\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.sym;
\import Geometry.Coefficients[R := K, ring := ring].Degree[n := n] \as OldClass;
\import Geometry.Coefficients[R := L, ring := targetRing].Degree[n := n] \as NewClass;
\import singular_products.Cochains[A := X, source := bundle.baseSpace, R := L, ring := targetRing] \as NewBase;
\import singular_products.Cochains[A := Disk.DiskBundle, source := Disk.diskTopology, R := L, ring := targetRing] \as NewTotal;
\import singular_cap.CochainPair[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary, R := K, ring := ring].Comparison[n := n].Cohomology[] \as OldForget;
\import BaseChange.Along[B := Disk.DiskBundle, target := Disk.diskTopology, f := Disk.zeroSection, regular := Disk.zeroSectionContinuous].Degree[n := n] \as SectionNatural;
\import NewBase.Cohomology[].Pullback[B := Disk.DiskBundle, target := Disk.diskTopology] \as Section;
\definition law: \forall (u: OldClass.Class) -> (baseMap n).apply (OldClass.euler u) = NewClass.euler ((map n).apply u) :=
  \fun (u: OldClass.Class) => eq_reason_in!{{NewBase.Cohomology[].Group n} _
    "=" _ "by" { SectionNatural.law (OldForget.map.apply u) }
    "=" _ "by" { congr!{{NewTotal.Cohomology[].Group n} {NewBase.Cohomology[].Group n}} (Section.apply n Disk.zeroSection Disk.zeroSectionContinuous) _ _ (sym!{{NewTotal.Cohomology[].Group n}} _ _ (SumChange.Degree[n := n].Forget[].law u)) }
  };
