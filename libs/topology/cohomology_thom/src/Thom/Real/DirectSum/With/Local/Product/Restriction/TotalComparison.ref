\import singular_cohomology.Relative[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary].Maps[B := Disk.DiskBundle].Over[target := Disk.diskTopology, targetSubset := Disk.Boundary].Composition[C := Carrier].Over[final := topology, finalSubset := OldUnion.subset] \as First;
\import singular_cohomology.Relative[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary].Maps[B := Domain.BoxCarrier].Over[target := Domain.boxTopology, targetSubset := Union.subset].Composition[C := Carrier].Over[final := topology, finalSubset := OldUnion.subset] \as Second;
\import singular_cohomology.Relative[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary].Maps[B := Carrier].Over[target := topology, targetSubset := OldUnion.subset] \as Direct;
\definition square: First.compose Actual.pairInclusion globalFullMap = Second.compose fullMap Along.unionMap := \refl(First.compose Actual.pairInclusion globalFullMap);
\definition direct[f: Direct.Map]: _ := Direct.On[f := f].Integer[].With[coefficients := BaseProduct.integerCoefficients].At[z := I.Int^::ofNat chart.dimension].induced;
\import singular_cohomology.Relative[A := Carrier, source := topology, subset := OldUnion.subset].With[coefficients := BaseProduct.integerCoefficients].At[z := I.Int^::ofNat chart.dimension] \as Input;
\definition law: \forall (w: Input.Carrier) -> restrictSum (GlobalFullPull.Degree[n := chart.dimension].map.apply w) = FullPull.Degree[n := chart.dimension].map.apply (UnionRestriction.Degree[n := chart.dimension].map.apply w) :=
  \fun (w: Input.Carrier) => trans!{Class} _ _ _
    (sym!{Class} _ _ (First.On[f := Actual.pairInclusion, g := globalFullMap].With[coefficients := BaseProduct.integerCoefficients].law (I.Int^::ofNat chart.dimension) w))
    (trans!{Class} _ _ _
      (congr!{Direct.Map Class} (\fun (f: Direct.Map) => (direct f).apply w) _ _ square)
      (Second.On[f := fullMap, g := Along.unionMap].With[coefficients := BaseProduct.integerCoefficients].law (I.Int^::ofNat chart.dimension) w));
