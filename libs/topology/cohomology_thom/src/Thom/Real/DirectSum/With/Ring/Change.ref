\import \root.Thom[].Real[].DirectSum[X := X, F := F, G := G, left := left, right := right, same := same, leftMetric := leftMetric, rightMetric := rightMetric].With[metric := metric].Ring[K := K, ring := ring] \as Old;
\import \root.Thom[].Real[].DirectSum[X := X, F := F, G := G, left := left, right := right, same := same, leftMetric := leftMetric, rightMetric := rightMetric].With[metric := metric].Ring[K := L, ring := targetRing] \as New;
\import singular_products.Cochains[A := Carrier, source := topology, R := K, ring := ring] \as Source;
\import singular_products.Cochains[A := Carrier, source := topology, R := L, ring := targetRing] \as Target;
\import \root.CoefficientChange[].OnSpace[A := Carrier, source := topology, R := K, S := L, ring := ring, targetRing := targetRing] \as BoxOperations;
\definition boxMorphism: BoxOperations.Morphism := BoxOperations.Morphism { linear := morphism.linear, multiply := morphism.multiply, unit := morphism.unit };
\import BoxOperations.With[morphism := boxMorphism] \as BoxChange;
\import BoxChange.Relative[subset := Old.firstShell] \as FirstChange;
\import BoxChange.Relative[subset := Old.secondShell] \as SecondChange;
\import \root.MixedCup[A := Carrier, source := topology, first := Old.firstShell, second := Old.secondShell, K := K, ring := ring] \as Mixed;
\import Mixed.Change[L := L, targetRing := targetRing, morphism := boxMorphism] \as MixedChange;
\import Mixed.Union[] \as Union;
\import BoxChange.Relative[subset := Union.subset] \as UnionChange;
\import \root.CoefficientChange[].OnSpace[A := LeftDisk.DiskBundle, source := LeftDisk.diskTopology, R := K, S := L, ring := ring, targetRing := targetRing] \as LeftOperations;
\definition leftMorphism: LeftOperations.Morphism := LeftOperations.Morphism { linear := morphism.linear, multiply := morphism.multiply, unit := morphism.unit };
\import LeftOperations.With[morphism := leftMorphism].Relative[subset := LeftDisk.Boundary] \as LeftChange;
\import \root.CoefficientChange[].OnSpace[A := RightDisk.DiskBundle, source := RightDisk.diskTopology, R := K, S := L, ring := ring, targetRing := targetRing] \as RightOperations;
\definition rightMorphism: RightOperations.Morphism := RightOperations.Morphism { linear := morphism.linear, multiply := morphism.multiply, unit := morphism.unit };
\import RightOperations.With[morphism := rightMorphism].Relative[subset := RightDisk.Boundary] \as RightChange;
\import \root.CoefficientChange[].OnSpace[A := Disk.DiskBundle, source := Disk.diskTopology, R := K, S := L, ring := ring, targetRing := targetRing] \as SumOperations;
\definition sumMorphism: SumOperations.Morphism := SumOperations.Morphism { linear := morphism.linear, multiply := morphism.multiply, unit := morphism.unit };
\import SumOperations.With[morphism := sumMorphism].Relative[subset := Disk.Boundary] \as SumChange;
\definition leftMap[k: N.Nat^]: _ := LeftChange.Degree[n := k].map;
\definition rightMap[k: N.Nat^]: _ := RightChange.Degree[n := k].map;
\definition map[k: N.Nat^]: _ := SumChange.Degree[n := k].map;
\module Product(n, m: N.Nat^);
\import \root.CoefficientChange[].OnSpace[A := X, source := bundle.baseSpace, R := K, S := L, ring := ring, targetRing := targetRing].With[morphism := morphism] \as BaseChange;
\definition baseMap[k: N.Nat^]: _ := BaseChange.Degree[n := k].map;
\module Euler(n: N.Nat^);
