\import singular_cohomology.Relative[A := LeftDisk.DiskBundle, source := LeftDisk.diskTopology, subset := LeftDisk.Boundary] \as DiskPair;
\import singular_cohomology.Relative[A := Carrier, source := topology, subset := Old.firstShell] \as BoxPair;
\import BoxPair.Maps[B := LeftDisk.DiskBundle].Over[target := LeftDisk.diskTopology, targetSubset := LeftDisk.Boundary].On[f := Old.leftMap].Integer[] \as Projection;
\import \root.CoefficientChange[].On[C := DiskPair.complex, M := Source.integerCoefficients, N := Target.integerCoefficients, u := morphism.linear].Along[D := BoxPair.complex, f := Projection.map].At[z := I.Int^::ofNat n] \as Natural;
\import \root.RelativePullback[].On[A := Carrier, source := topology, subset := Old.firstShell, R := K, ring := ring].To[B := LeftDisk.DiskBundle, target := LeftDisk.diskTopology, part := LeftDisk.Boundary].Along[f := Old.leftMap] \as OldPull;
\import \root.RelativePullback[].On[A := Carrier, source := topology, subset := New.firstShell, R := L, ring := targetRing].To[B := LeftDisk.DiskBundle, target := LeftDisk.diskTopology, part := LeftDisk.Boundary].Along[f := New.leftMap] \as NewPull;
\definition old[u: LeftInput.Class]: _ := OldPull.Degree[n := n].map.apply u;
\definition changed[u: LeftInput.Class]: _ := NewPull.Degree[n := n].map.apply ((leftMap n).apply u);
\definition law: \forall (u: LeftInput.Class) -> FirstChange.Degree[n := n].map.apply (old u) = changed u := Natural.law;
