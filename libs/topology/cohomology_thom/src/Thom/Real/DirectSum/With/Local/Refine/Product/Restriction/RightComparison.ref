\import singular_cohomology.Relative[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := secondShell].Maps[B := Carrier].Over[target := topology, targetSubset := Global.secondShell].Composition[C := RightDisk.DiskBundle].Over[final := RightDisk.diskTopology, finalSubset := RightDisk.Boundary] \as First;
\import singular_cohomology.Relative[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := secondShell].Maps[B := RightActual.Carrier].Over[target := RightActual.topology, targetSubset := RightActual.boundary].Composition[C := RightDisk.DiskBundle].Over[final := RightDisk.diskTopology, finalSubset := RightDisk.Boundary] \as Second;
\import singular_cohomology.Relative[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := secondShell].Maps[B := RightDisk.DiskBundle].Over[target := RightDisk.diskTopology, targetSubset := RightDisk.Boundary] \as Direct;
\definition square: First.compose Along.secondMap Global.rightMap = Second.compose rightMap RightActual.pairInclusion := \refl(First.compose Along.secondMap Global.rightMap);
\definition direct[f: Direct.Map]: _ := Direct.On[f := f].Integer[].With[coefficients := BaseProduct.integerCoefficients].At[z := I.Int^::ofNat d.dimension].induced;
\import singular_cohomology.Relative[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := secondShell].With[coefficients := BaseProduct.integerCoefficients].At[z := I.Int^::ofNat d.dimension] \as Output;
\definition law: \forall (u: OriginalRight.Degree[n := d.dimension].Class) -> SecondRestriction.Degree[n := d.dimension].map.apply (OldRightPull.Degree[n := d.dimension].map.apply u) = RightPull.Degree[n := d.dimension].map.apply (restrictRight u) :=
  \fun (u: OriginalRight.Degree[n := d.dimension].Class) => trans!{Output.Carrier} _ _ _
    (sym!{Output.Carrier} _ _ (First.On[f := Along.secondMap, g := Global.rightMap].With[coefficients := BaseProduct.integerCoefficients].law (I.Int^::ofNat d.dimension) u))
    (trans!{Output.Carrier} _ _ _
      (congr!{Direct.Map Output.Carrier} (\fun (f: Direct.Map) => (direct f).apply u) _ _ square)
      (Second.On[f := rightMap, g := RightActual.pairInclusion].With[coefficients := BaseProduct.integerCoefficients].law (I.Int^::ofNat d.dimension) u));
