\import Geometry.Local[K := I.Int^, ring := Integers.commutativeRing].Rank[n := chart.dimension] \as Rank;
\import Rank.On[U := U] \as On;
\import Rank.Fiber[x := x] \as RankedFiber;
\import \parent.\parent.StandardModel[].Fiber[x := x].Ring[K := I.Int^, ring := Integers.commutativeRing] \as Positive;
\definition generates: \forall (s: B.Bool^) -> RankedFiber.Generator ((On.restriction x).apply (model s).thomClass) :=
  \induction (s: B.Bool^) \return RankedFiber.Generator ((On.restriction x).apply (model s).thomClass) \with {
    | false: Positive.modelGenerates
    | true: \idelim RankedFiber.space.neg ((On.restriction x).apply LocalModel.data.thomClass) = (On.restriction x).apply (model B.Bool^::true).thomClass \with u: RankedFiber.Class => RankedFiber.Generator u \by {
        base: RankedFiber.negativeGenerator ((On.restriction x).apply LocalModel.data.thomClass) Positive.modelGenerates,
        equality: sym!{RankedFiber.Class} _ _ (On.negativeLaw x LocalModel.data.thomClass)
      }
  };
