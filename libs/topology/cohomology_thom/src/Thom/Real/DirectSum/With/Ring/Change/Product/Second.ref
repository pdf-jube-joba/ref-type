\import singular_cohomology.Relative[A := RightDisk.DiskBundle, source := RightDisk.diskTopology, subset := RightDisk.Boundary] \as DiskPair;
\import singular_cohomology.Relative[A := Carrier, source := topology, subset := Old.secondShell] \as BoxPair;
\import BoxPair.Maps[B := RightDisk.DiskBundle].Over[target := RightDisk.diskTopology, targetSubset := RightDisk.Boundary].On[f := Old.rightMap].Integer[] \as Projection;
\import \root.CoefficientChange[].On[C := DiskPair.complex, M := Source.integerCoefficients, N := Target.integerCoefficients, u := morphism.linear].Along[D := BoxPair.complex, f := Projection.map].At[z := I.Int^::ofNat m] \as Natural;
\import \root.RelativePullback[].On[A := Carrier, source := topology, subset := Old.secondShell, R := K, ring := ring].To[B := RightDisk.DiskBundle, target := RightDisk.diskTopology, part := RightDisk.Boundary].Along[f := Old.rightMap] \as OldPull;
\import \root.RelativePullback[].On[A := Carrier, source := topology, subset := New.secondShell, R := L, ring := targetRing].To[B := RightDisk.DiskBundle, target := RightDisk.diskTopology, part := RightDisk.Boundary].Along[f := New.rightMap] \as NewPull;
\definition old[u: RightInput.Class]: _ := OldPull.Degree[n := m].map.apply u;
\definition changed[u: RightInput.Class]: _ := NewPull.Degree[n := m].map.apply ((rightMap m).apply u);
\definition law: \forall (u: RightInput.Class) -> SecondChange.Degree[n := m].map.apply (old u) = changed u := Natural.law;
