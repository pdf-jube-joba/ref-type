\import BaseProduct.Cohomology[] \as Groups;
\import Groups.Cup[p := n, q := m] \as Cup;
\import Groups.Pullback[B := X, target := right.baseSpace] \as RightPull;
\import \parent.\parent.ZeroSection[] \as Zero;
\definition law: euler = Cup.apply LeftClass.euler (RightPull.apply m (\fun (x: X) => x) Zero.identity RightClass.euler) :=
  trans!{{Groups.Group degree}} _ _ _
    (congr!{{Theory.Degree[n := degree].Class} {Groups.Group degree}} Theory.Degree[n := degree].euler _ _ (sym!{{Theory.Degree[n := degree].Class}} _ _ classLaw))
    (Product.Product[n := n, m := m].Euler[].law LeftClass.class RightClass.class);
