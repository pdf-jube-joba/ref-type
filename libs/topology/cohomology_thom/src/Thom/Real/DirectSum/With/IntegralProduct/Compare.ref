\import Geometry.Oriented[K := I.Int^, ring := Integers.commutativeRing, n := degree, orientation := given, complex := complex] \as Signed;
\definition classLaw: Signed.class = class := Global.uniqueNormalized Signed.class
  (\fun (x: X) => trans!{{Rank.FiberClass x}} _ _ _ (Signed.normalized x) (fiberLaw x));
\definition eulerLaw: Signed.euler = euler := congr!{{Theory.Degree[n := degree].Class} {BaseProduct.Cohomology[].Group degree}} Theory.Degree[n := degree].euler _ _ classLaw;
\module Degree(p: N.Nat^) {
  \definition total: N.Nat^ := N.Basic[].Def[].add p degree;
  \definition law: \forall (a: BaseProduct.Cohomology[].Group p) -> Signed.Degree[p := p].isomorphism.forward.apply a = Global.Degree[p := p].isomorphism.forward.apply a :=
    \fun (a: BaseProduct.Cohomology[].Group p) => congr!{{Theory.Degree[n := degree].Class} {Theory.Degree[n := total].Class}} (\fun (u: Theory.Degree[n := degree].Class) => Theory.Product[p := p, n := degree].apply a u) _ _ classLaw;
}
