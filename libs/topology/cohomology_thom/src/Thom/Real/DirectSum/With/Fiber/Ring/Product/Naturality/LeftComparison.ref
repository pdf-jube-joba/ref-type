\import singular_cohomology.Relative[A := BoxCarrier, source := boxTopology, subset := firstShell].Maps[B := Carrier].Over[target := topology, targetSubset := Global.firstShell].Composition[C := LeftDisk.DiskBundle].Over[final := LeftDisk.diskTopology, finalSubset := LeftDisk.Boundary] \as First;
\import singular_cohomology.Relative[A := BoxCarrier, source := boxTopology, subset := firstShell].Maps[B := LeftActual.Carrier].Over[target := LeftActual.topology, targetSubset := LeftActual.boundary].Composition[C := LeftDisk.DiskBundle].Over[final := LeftDisk.diskTopology, finalSubset := LeftDisk.Boundary] \as Second;
\import singular_cohomology.Relative[A := BoxCarrier, source := boxTopology, subset := firstShell].Maps[B := LeftDisk.DiskBundle].Over[target := LeftDisk.diskTopology, targetSubset := LeftDisk.Boundary] \as Direct;
\definition square: First.compose Along.firstMap Global.leftMap = Second.compose leftMap LeftActual.pairInclusion := \refl(First.compose Along.firstMap Global.leftMap);
\definition direct[f: Direct.Map]: _ := Direct.On[f := f].Integer[].With[coefficients := Base.integerCoefficients].At[z := I.Int^::ofNat n].induced;
\import singular_cohomology.Relative[A := BoxCarrier, source := boxTopology, subset := firstShell].With[coefficients := Base.integerCoefficients].At[z := I.Int^::ofNat n] \as Output;
\definition law: \forall (u: OriginalLeft.Degree[n := n].Class) -> FirstRestriction.Degree[n := n].map.apply (OldLeftPull.Degree[n := n].map.apply u) = LeftPull.Degree[n := n].map.apply (restrictLeft u) :=
  \fun (u: OriginalLeft.Degree[n := n].Class) => trans!{Output.Carrier} _ _ _
    (sym!{Output.Carrier} _ _ (First.On[f := Along.firstMap, g := Global.leftMap].With[coefficients := Base.integerCoefficients].law (I.Int^::ofNat n) u))
    (trans!{Output.Carrier} _ _ _
      (congr!{Direct.Map Output.Carrier} (\fun (f: Direct.Map) => (direct f).apply u) _ _ square)
      (Second.On[f := leftMap, g := LeftActual.pairInclusion].With[coefficients := Base.integerCoefficients].law (I.Int^::ofNat n) u));
