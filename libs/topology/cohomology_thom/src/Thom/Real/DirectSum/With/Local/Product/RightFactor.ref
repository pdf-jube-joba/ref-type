\import singular_cohomology.Relative[A := Right.Carrier, source := Right.topology, subset := RightNorm.targetShell].Maps[B := Second.Disk].Over[target := Second.diskTopology, targetSubset := RightStandard.shell] \as ProjectionMaps;
\definition projection: ProjectionMaps.Map := \into[Right.Carrier -> Second.Disk]((Pair.second BasePoint Second.Disk), ProjectionMaps.Map) \by {
  ProjectionMaps.Laws[Pair.second BasePoint Second.Disk] { continuous := topological_constructions.Product[A := BasePoint, B := Second.Disk].Maps[].secondContinuous RightChart.baseTopology Second.diskTopology, contained := \fun (p: \Cast[Right.Carrier] RightNorm.targetShell) => \bysub(Right.Carrier, RightNorm.targetShell, p) }
};
\import \root.RelativePullback[].On[A := Right.Carrier, source := Right.topology, subset := RightNorm.targetShell, R := K, ring := ring].To[B := Second.Disk, target := Second.diskTopology, part := RightStandard.shell].Along[f := projection] \as ProjectionPull;
\import \root.RelativePullback[].On[A := Right.Carrier, source := Right.topology, subset := Right.boundary, R := K, ring := ring].To[B := Right.Carrier, target := Right.topology, part := RightNorm.targetShell].Along[f := RightNormRing.targetInclude] \as IncludePull;
\import singular_cohomology.Relative[A := RightOpen.Carrier, source := RightOpen.topology, subset := RightOpen.boundary].Homeomorphism[B := Right.Carrier].Over[target := Right.topology, targetSubset := Right.boundary] \as BoundaryPairs;
\import \root.RelativePullback[].On[A := RightOpen.Carrier, source := RightOpen.topology, subset := RightOpen.boundary, R := K, ring := ring].To[B := Right.Carrier, target := Right.topology, part := Right.boundary].Along[f := BoundaryPairs.forwardMap Right.pair] \as BoundaryPull;
\definition class[a: RightPoint.Class]: RightInput.Carrier := BoundaryPull.Degree[n := d.dimension].map.apply (IncludePull.Degree[n := d.dimension].map.apply (ProjectionPull.Degree[n := d.dimension].map.apply (RightStandardClass.lift a)));
\import singular_cohomology.Relative[A := RightOpen.Carrier, source := RightOpen.topology, subset := RightNorm.sourceShell].Homeomorphism[B := Right.Carrier].Over[target := Right.topology, targetSubset := RightNorm.targetShell] \as ShellPairs;
\import \root.RelativePullback[].On[A := RightOpen.Carrier, source := RightOpen.topology, subset := RightNorm.sourceShell, R := K, ring := ring].To[B := Right.Carrier, target := Right.topology, part := RightNorm.targetShell].Along[f := ShellPairs.forwardMap RightNorm.pair] \as CoordinatePull;
\import \root.RelativePullback[].On[A := RightOpen.Carrier, source := RightOpen.topology, subset := RightNorm.sourceShell, R := K, ring := ring].To[B := RightOpen.Carrier, target := RightOpen.topology, part := RightOpen.boundary].Along[f := RightDirect.backward] \as ClipPull;
\import \root.RelativePullback[].On[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := secondShell, R := K, ring := ring].To[B := RightOpen.Carrier, target := RightOpen.topology, part := RightNorm.sourceShell].Along[f := rightPartMap] \as PartPull;
\import RightPartMaps.Composition[C := Right.Carrier].Over[final := Right.topology, finalSubset := RightNorm.targetShell] \as CoordinateComposition;
\definition coordinates: _ := CoordinateComposition.compose rightPartMap (ShellPairs.forwardMap RightNorm.pair);
\import \root.RelativePullback[].On[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := secondShell, R := K, ring := ring].To[B := Right.Carrier, target := Right.topology, part := RightNorm.targetShell].Along[f := coordinates] \as CombinedPull;
\import singular_cohomology.Relative[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := secondShell].Maps[B := Right.Carrier].Over[target := Right.topology, targetSubset := RightNorm.targetShell].Composition[C := Second.Disk].Over[final := Second.diskTopology, finalSubset := RightStandard.shell] \as ProjectedComposition;
\import singular_cohomology.Relative[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := secondShell].Maps[B := StandardProduct.Carrier].Over[target := StandardProduct.topology, targetSubset := StandardProduct.secondShell].Composition[C := Second.Disk].Over[final := Second.diskTopology, finalSubset := RightStandard.shell] \as StandardComposition;
\import singular_cohomology.Relative[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := secondShell].Maps[B := Second.Disk].Over[target := Second.diskTopology, targetSubset := RightStandard.shell] \as Maps;
\definition square: ProjectedComposition.compose coordinates projection = StandardComposition.compose Along.secondMap StandardProduct.rightMap := \refl(ProjectedComposition.compose coordinates projection);
\import \root.RelativePullback[].On[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := secondShell, R := K, ring := ring].To[B := StandardProduct.Carrier, target := StandardProduct.topology, part := StandardProduct.secondShell].Along[f := Along.secondMap] \as AlongPull;
\import \root.RelativePullback[].On[A := StandardProduct.Carrier, source := StandardProduct.topology, subset := StandardProduct.secondShell, R := K, ring := ring].To[B := Second.Disk, target := Second.diskTopology, part := RightStandard.shell].Along[f := StandardProduct.rightMap] \as StandardPull;
\import singular_cohomology.Relative[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := secondShell].With[coefficients := BaseProduct.integerCoefficients].At[z := I.Int^::ofNat d.dimension] \as Output;
\definition action[f: Maps.Map]: _ := Maps.On[f := f].Integer[].With[coefficients := BaseProduct.integerCoefficients].At[z := I.Int^::ofNat d.dimension].induced;
\definition law: \forall (a: RightPoint.Class) -> RightPull.Degree[n := d.dimension].map.apply (class a) = AlongPull.Degree[n := d.dimension].map.apply (StandardPull.Degree[n := d.dimension].map.apply (RightStandardClass.lift a)) :=
  \fun (a: RightPoint.Class) => eq_reason_in!{Output.Carrier _
    "=" _ "by" { RightComposition.On[f := rightPartMap, g := RightDirect.backward].With[coefficients := BaseProduct.integerCoefficients].law (I.Int^::ofNat d.dimension) (class a) }
    "=" _ "by" { congr!{{singular_cohomology.Relative[A := RightOpen.Carrier, source := RightOpen.topology, subset := RightNorm.sourceShell].With[coefficients := BaseProduct.integerCoefficients].At[z := I.Int^::ofNat d.dimension].Carrier} Output.Carrier} PartPull.Degree[n := d.dimension].map.apply _ _ (RightNormRing.Degree[n := d.dimension].clipLaw (ProjectionPull.Degree[n := d.dimension].map.apply (RightStandardClass.lift a))) }
    "=" _ "by" { sym!{Output.Carrier} _ _ (CoordinateComposition.On[f := rightPartMap, g := ShellPairs.forwardMap RightNorm.pair].With[coefficients := BaseProduct.integerCoefficients].law (I.Int^::ofNat d.dimension) (ProjectionPull.Degree[n := d.dimension].map.apply (RightStandardClass.lift a))) }
    "=" _ "by" { sym!{Output.Carrier} _ _ (ProjectedComposition.On[f := coordinates, g := projection].With[coefficients := BaseProduct.integerCoefficients].law (I.Int^::ofNat d.dimension) (RightStandardClass.lift a)) }
    "=" _ "by" { congr!{Maps.Map Output.Carrier} (\fun (f: Maps.Map) => (action f).apply (RightStandardClass.lift a)) _ _ square }
    "=" _ "by" { StandardComposition.On[f := Along.secondMap, g := StandardProduct.rightMap].With[coefficients := BaseProduct.integerCoefficients].law (I.Int^::ofNat d.dimension) (RightStandardClass.lift a) }
  };

\module Canonical;
