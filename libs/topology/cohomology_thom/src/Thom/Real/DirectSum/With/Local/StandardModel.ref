\import thom_spaces.Thom[].DiskSuspension[X := BasePoint, space := baseTopology, n := chart.dimension] \as StandardDisk;
\definition homeomorphism: topology.Homeomorphism[A := Actual.Carrier, B := StandardDisk.DiskCarrier].Homeomorphism[Actual.topology, StandardDisk.diskTopology] :=
  topology.Homeomorphism[A := Actual.Carrier, B := Standard.Carrier].Composition[C := StandardDisk.DiskCarrier].compose Actual.topology Standard.topology StandardDisk.diskTopology productHomeomorphism
    (topology.Homeomorphism[A := StandardDisk.DiskCarrier, B := Standard.Carrier].Inverse[].inverse StandardDisk.diskTopology Standard.topology Standard.standardHomeomorphism);
\import singular_cohomology.Relative[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary].Homeomorphism[B := StandardDisk.DiskCarrier].Over[target := StandardDisk.diskTopology, targetSubset := StandardDisk.boundary] \as Pairs;
\definition pair: Pairs.Data := Pairs.Data {
  homeomorphism := homeomorphism,
  forwardPreserves := \fun (p: \Cast[Actual.Carrier] Actual.boundary) => Standard.standardPair.backwardPreserves
    (\into[Standard.Carrier](productHomeomorphism.forward p, Standard.boundary) \by { productPair.forwardPreserves p }),
  backwardPreserves := \fun (p: \Cast[StandardDisk.DiskCarrier] StandardDisk.boundary) => productPair.backwardPreserves
    (\into[Standard.Carrier](Standard.fromStandard p, Standard.boundary) \by { Standard.standardPair.forwardPreserves p })
};
\module Ring(K: \Set, ring: Rings.CommutativeRing[K]);
\module Fiber(x: BasePoint);
