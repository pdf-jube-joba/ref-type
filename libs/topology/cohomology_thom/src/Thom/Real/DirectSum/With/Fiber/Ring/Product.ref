\definition degree: N.Nat^ := N.Basic[].Def[].add n m;
\definition LeftClass: \Set := LeftActual.Additive[coefficients := Base.integerCoefficients, z := I.Int^::ofNat n].Class;
\definition RightClass: \Set := RightActual.Additive[coefficients := Base.integerCoefficients, z := I.Int^::ofNat m].Class;
\definition Class: \Set := Actual.Additive[coefficients := Base.integerCoefficients, z := I.Int^::ofNat degree].Class;
\definition apply[u: LeftClass][v: RightClass]: Class :=
  FullPull.Degree[n := degree].map.apply (Products.Cup[p := n, q := m].apply (LeftPull.Degree[n := n].map.apply u) (RightPull.Degree[n := m].map.apply v));
\module Naturality;
