\import singular_cohomology.Relative[A := Left.Carrier, source := Left.topology, subset := LeftNorm.targetShell].Maps[B := First.Disk].Over[target := First.diskTopology, targetSubset := LeftStandard.shell] \as ProjectionMaps;
\definition projection: ProjectionMaps.Map := \into[Left.Carrier -> First.Disk]((Pair.second BasePoint First.Disk), ProjectionMaps.Map) \by {
  ProjectionMaps.Laws[Pair.second BasePoint First.Disk] { continuous := topological_constructions.Product[A := BasePoint, B := First.Disk].Maps[].secondContinuous baseTopology First.diskTopology, contained := \fun (p: \Cast[Left.Carrier] LeftNorm.targetShell) => \bysub(Left.Carrier, LeftNorm.targetShell, p) }
};
\import \root.RelativePullback[].On[A := Left.Carrier, source := Left.topology, subset := LeftNorm.targetShell, R := K, ring := ring].To[B := First.Disk, target := First.diskTopology, part := LeftStandard.shell].Along[f := projection] \as ProjectionPull;
\import \root.RelativePullback[].On[A := Left.Carrier, source := Left.topology, subset := Left.boundary, R := K, ring := ring].To[B := Left.Carrier, target := Left.topology, part := LeftNorm.targetShell].Along[f := LeftNormRing.targetInclude] \as IncludePull;
\import singular_cohomology.Relative[A := LeftOpen.Carrier, source := LeftOpen.topology, subset := LeftOpen.boundary].Homeomorphism[B := Left.Carrier].Over[target := Left.topology, targetSubset := Left.boundary] \as BoundaryPairs;
\import \root.RelativePullback[].On[A := LeftOpen.Carrier, source := LeftOpen.topology, subset := LeftOpen.boundary, R := K, ring := ring].To[B := Left.Carrier, target := Left.topology, part := Left.boundary].Along[f := BoundaryPairs.forwardMap Left.pair] \as BoundaryPull;
\definition class[a: LeftPoint.Class]: LeftInput.Carrier := BoundaryPull.Degree[n := c.dimension].map.apply (IncludePull.Degree[n := c.dimension].map.apply (ProjectionPull.Degree[n := c.dimension].map.apply (LeftStandardClass.lift a)));
\import singular_cohomology.Relative[A := LeftOpen.Carrier, source := LeftOpen.topology, subset := LeftNorm.sourceShell].Homeomorphism[B := Left.Carrier].Over[target := Left.topology, targetSubset := LeftNorm.targetShell] \as ShellPairs;
\import \root.RelativePullback[].On[A := LeftOpen.Carrier, source := LeftOpen.topology, subset := LeftNorm.sourceShell, R := K, ring := ring].To[B := Left.Carrier, target := Left.topology, part := LeftNorm.targetShell].Along[f := ShellPairs.forwardMap LeftNorm.pair] \as CoordinatePull;
\import \root.RelativePullback[].On[A := LeftOpen.Carrier, source := LeftOpen.topology, subset := LeftNorm.sourceShell, R := K, ring := ring].To[B := LeftOpen.Carrier, target := LeftOpen.topology, part := LeftOpen.boundary].Along[f := LeftDirect.backward] \as ClipPull;
\import \root.RelativePullback[].On[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := firstShell, R := K, ring := ring].To[B := LeftOpen.Carrier, target := LeftOpen.topology, part := LeftNorm.sourceShell].Along[f := leftPartMap] \as PartPull;
\import LeftPartMaps.Composition[C := Left.Carrier].Over[final := Left.topology, finalSubset := LeftNorm.targetShell] \as CoordinateComposition;
\definition coordinates: _ := CoordinateComposition.compose leftPartMap (ShellPairs.forwardMap LeftNorm.pair);
\import \root.RelativePullback[].On[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := firstShell, R := K, ring := ring].To[B := Left.Carrier, target := Left.topology, part := LeftNorm.targetShell].Along[f := coordinates] \as CombinedPull;
\import singular_cohomology.Relative[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := firstShell].Maps[B := Left.Carrier].Over[target := Left.topology, targetSubset := LeftNorm.targetShell].Composition[C := First.Disk].Over[final := First.diskTopology, finalSubset := LeftStandard.shell] \as ProjectedComposition;
\import singular_cohomology.Relative[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := firstShell].Maps[B := StandardProduct.Carrier].Over[target := StandardProduct.topology, targetSubset := StandardProduct.firstShell].Composition[C := First.Disk].Over[final := First.diskTopology, finalSubset := LeftStandard.shell] \as StandardComposition;
\import singular_cohomology.Relative[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := firstShell].Maps[B := First.Disk].Over[target := First.diskTopology, targetSubset := LeftStandard.shell] \as Maps;
\definition square: ProjectedComposition.compose coordinates projection = StandardComposition.compose Along.firstMap StandardProduct.leftMap := \refl(ProjectedComposition.compose coordinates projection);
\import \root.RelativePullback[].On[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := firstShell, R := K, ring := ring].To[B := StandardProduct.Carrier, target := StandardProduct.topology, part := StandardProduct.firstShell].Along[f := Along.firstMap] \as AlongPull;
\import \root.RelativePullback[].On[A := StandardProduct.Carrier, source := StandardProduct.topology, subset := StandardProduct.firstShell, R := K, ring := ring].To[B := First.Disk, target := First.diskTopology, part := LeftStandard.shell].Along[f := StandardProduct.leftMap] \as StandardPull;
\import singular_cohomology.Relative[A := Domain.BoxCarrier, source := Domain.boxTopology, subset := firstShell].With[coefficients := BaseProduct.integerCoefficients].At[z := I.Int^::ofNat c.dimension] \as Output;
\definition action[f: Maps.Map]: _ := Maps.On[f := f].Integer[].With[coefficients := BaseProduct.integerCoefficients].At[z := I.Int^::ofNat c.dimension].induced;
\definition law: \forall (a: LeftPoint.Class) -> LeftPull.Degree[n := c.dimension].map.apply (class a) = AlongPull.Degree[n := c.dimension].map.apply (StandardPull.Degree[n := c.dimension].map.apply (LeftStandardClass.lift a)) :=
  \fun (a: LeftPoint.Class) => eq_reason_in!{Output.Carrier _
    "=" _ "by" { LeftComposition.On[f := leftPartMap, g := LeftDirect.backward].With[coefficients := BaseProduct.integerCoefficients].law (I.Int^::ofNat c.dimension) (class a) }
    "=" _ "by" { congr!{{singular_cohomology.Relative[A := LeftOpen.Carrier, source := LeftOpen.topology, subset := LeftNorm.sourceShell].With[coefficients := BaseProduct.integerCoefficients].At[z := I.Int^::ofNat c.dimension].Carrier} Output.Carrier} PartPull.Degree[n := c.dimension].map.apply _ _ (LeftNormRing.Degree[n := c.dimension].clipLaw (ProjectionPull.Degree[n := c.dimension].map.apply (LeftStandardClass.lift a))) }
    "=" _ "by" { sym!{Output.Carrier} _ _ (CoordinateComposition.On[f := leftPartMap, g := ShellPairs.forwardMap LeftNorm.pair].With[coefficients := BaseProduct.integerCoefficients].law (I.Int^::ofNat c.dimension) (ProjectionPull.Degree[n := c.dimension].map.apply (LeftStandardClass.lift a))) }
    "=" _ "by" { sym!{Output.Carrier} _ _ (ProjectedComposition.On[f := coordinates, g := projection].With[coefficients := BaseProduct.integerCoefficients].law (I.Int^::ofNat c.dimension) (LeftStandardClass.lift a)) }
    "=" _ "by" { congr!{Maps.Map Output.Carrier} (\fun (f: Maps.Map) => (action f).apply (LeftStandardClass.lift a)) _ _ square }
    "=" _ "by" { StandardComposition.On[f := Along.firstMap, g := StandardProduct.leftMap].With[coefficients := BaseProduct.integerCoefficients].law (I.Int^::ofNat c.dimension) (LeftStandardClass.lift a) }
  };

\module Canonical;
