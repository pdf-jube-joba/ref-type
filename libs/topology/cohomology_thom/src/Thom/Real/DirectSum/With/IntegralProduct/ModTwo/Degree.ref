\use std.Logic[].Equality[].eq_reason_in;
\definition total: N.Nat^ := N.Basic[].Def[].add p degree;
\import singular_products.Cochains[A := Disk.DiskBundle, source := Disk.diskTopology, R := I.Int^, ring := Integers.commutativeRing] \as SourceTotal;
\import singular_products.Cochains[A := Disk.DiskBundle, source := Disk.diskTopology, R := Two.Carrier, ring := Two.commutativeRing] \as TargetTotal;
\import \root.CoefficientChange[].FromIntegers[K := Two.Carrier, ring := Two.commutativeRing].OnSpace[A := Disk.DiskBundle, source := Disk.diskTopology] \as DiskReduction;
\import \root.CoefficientChange[].OnSpace[A := Disk.DiskBundle, source := Disk.diskTopology, R := I.Int^, S := Two.Carrier, ring := Integers.commutativeRing, targetRing := Two.commutativeRing].With[morphism := DiskReduction.morphism] \as DiskChange;
\import DiskChange.Relative[subset := Disk.Boundary] \as RelativeChange;
\import DiskChange.Along[B := X, target := bundle.baseSpace, f := Disk.diskProjection, regular := Disk.diskProjectionContinuous].Degree[n := p] \as ProjectionNatural;
\import SourceTotal.Cohomology[].Pullback[B := X, target := bundle.baseSpace] \as SourceProjection;
\import singular_cap.CochainPair[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary, R := Two.Carrier, ring := Two.commutativeRing].Cohomology[p := p, q := degree].Right[] \as Cup;
\definition baseMap: _ := Change.baseMap p;
\definition relativeMap: _ := Change.map total;
\definition law: \forall (a: BaseProduct.Cohomology[].Group p) -> relativeMap.apply (Global.Degree[p := p].isomorphism.forward.apply a) = Canonical.Degree[p := p].isomorphism.forward.apply (baseMap.apply a) :=
  \fun (a: BaseProduct.Cohomology[].Group p) => trans!{{TargetTheory.Degree[n := total].Class}} _ _ _
    (RelativeChange.Cup[p := p, q := degree].Cohomology[].law (SourceProjection.apply p Disk.diskProjection Disk.diskProjectionContinuous a) class)
    (congr!{{TargetTotal.Cohomology[].Group p} {TargetTheory.Degree[n := degree].Class} {TargetTheory.Degree[n := total].Class}} Cup.apply _ _ _ _ (ProjectionNatural.law a) classLaw);
\definition inverseLaw: \forall (u: Theory.Degree[n := total].Class) -> baseMap.apply (Global.Degree[p := p].isomorphism.backward.apply u) = Canonical.Degree[p := p].isomorphism.backward.apply (relativeMap.apply u) :=
  \fun (u: Theory.Degree[n := total].Class) => eq_reason_in!{{TargetBase.Cohomology[].Group p} _
    "=" _ "by" { sym!{{TargetBase.Cohomology[].Group p}} _ _ (Canonical.Degree[p := p].isomorphism.leftInverse (baseMap.apply (Global.Degree[p := p].isomorphism.backward.apply u))) }
    "=" _ "by" { congr!{{TargetTheory.Degree[n := total].Class} {TargetBase.Cohomology[].Group p}} Canonical.Degree[p := p].isomorphism.backward.apply _ _ (sym!{{TargetTheory.Degree[n := total].Class}} _ _ (law (Global.Degree[p := p].isomorphism.backward.apply u))) }
    "=" _ "by" { congr!{{Theory.Degree[n := total].Class} {TargetBase.Cohomology[].Group p}} (\fun (v: Theory.Degree[n := total].Class) => Canonical.Degree[p := p].isomorphism.backward.apply (relativeMap.apply v)) _ _ (Global.Degree[p := p].isomorphism.rightInverse u) }
  };
