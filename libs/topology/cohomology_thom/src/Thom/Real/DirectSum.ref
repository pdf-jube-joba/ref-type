\import thom_spaces.Thom[].Over[K := Reals.Real, field := Reals.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar]
  .Box[X := X, F := F, G := G, left := left, right := right, same := same, leftMetric := leftMetric, rightMetric := rightMetric] \as Box;
\definition Fiber[x: X]: \Set := Box.Fiber x;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Box.bundle;
\import Bundles.Family[X := X, F := Fiber] \as Family;
\import thom_spaces.Thom[].Real[].For[X := X, F := Fiber, bundle := bundle] \as SumGeometry;
\definition Metric: \Set := SumGeometry.Metric;
\import \root.Thom[].Real[].For[X := X, F := F, bundle := left].With[metric := leftMetric] \as LeftGeometry;
\import \root.Thom[].Real[].For[X := X, F := G, bundle := right].With[metric := rightMetric] \as RightGeometry;
\definition Carrier: \Set := \Cast[Family.Point] Box.DiskSubset;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Box.diskTopology;
\import thom_spaces.Thom[].Over[K := Reals.Real, field := Reals.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar] \as Theory;
\import Theory.For[X := X, F := F, bundle := left].With[metric := leftMetric] \as LeftDisk;
\import Theory.For[X := X, F := G, bundle := right].With[metric := rightMetric] \as RightDisk;
\import bundle_operations.Operations[].Over[K := Reals.Real, field := Reals.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].DirectSum[X := X, F := F, G := G, left := left, right := right] \as Sum;
\import dedekind_reals.DedekindReal[] \as D;
\definition first[p: Carrier]: LeftDisk.DiskBundle :=
  \into[Bundles.Family[X := X, F := F].Point](Sum.first p, LeftDisk.ClosedBall) \by { D.leTrans (Box.first p) (Box.squared p) Reals.one (Reals.Distance[].maxLeft (Box.first p) (Box.second p)) (\bysub(Family.Point, Box.DiskSubset, p)) };
\definition second[p: Carrier]: RightDisk.DiskBundle :=
  \into[Bundles.Family[X := X, F := G].Point](Sum.second p, RightDisk.ClosedBall) \by { D.leTrans (Box.second p) (Box.squared p) Reals.one (Reals.Distance[].maxRight (Box.first p) (Box.second p)) (\bysub(Family.Point, Box.DiskSubset, p)) };
\definition firstContinuous: topology.Continuity[A := Carrier, B := LeftDisk.DiskBundle].Continuous topology LeftDisk.diskTopology first :=
  topology.Continuity[A := Carrier, B := Bundles.Family[X := X, F := F].Point].Corestriction[S := LeftDisk.ClosedBall].corestrictContinuous topology left.totalSpace first
    (topology.Continuity[A := Family.Point, B := Bundles.Family[X := X, F := F].Point].Restriction[S := Box.DiskSubset].restrictContinuous bundle.totalSpace left.totalSpace Sum.first Sum.firstContinuous);
\definition secondContinuous: topology.Continuity[A := Carrier, B := RightDisk.DiskBundle].Continuous topology RightDisk.diskTopology second :=
  topology.Continuity[A := Carrier, B := Bundles.Family[X := X, F := G].Point].Corestriction[S := RightDisk.ClosedBall].corestrictContinuous topology right.totalSpace second
    (topology.Continuity[A := Family.Point, B := Bundles.Family[X := X, F := G].Point].Restriction[S := Box.DiskSubset].restrictContinuous bundle.totalSpace right.totalSpace Sum.second Sum.secondContinuous);
\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import module_theory.Module[].Over[R := I.Int^, ring := IntegerRing.ring] \as IntegerModules;
\module With(metric: Metric);
