\use std.Logic[].Equality[].eq_reason_in;
\definition total: N.Nat^ := N.Basic[].Def[].add p n;
\import SourceTotal.Cohomology[].Pullback[B := X, target := bundle.baseSpace] \as SourceProjection;
\import TargetTotal.Cohomology[].Pullback[B := X, target := bundle.baseSpace] \as TargetProjection;
\import DiskChange.Along[B := X, target := bundle.baseSpace, f := Disk.diskProjection, regular := Disk.diskProjectionContinuous].Degree[n := p] \as ProjectionNatural;
\import singular_cap.CochainPair[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary, R := L, ring := targetRing].Cohomology[p := p, q := n].Right[] \as Product;
\definition baseMap: _ := BaseChange.Degree[n := p].map;
\definition relativeMap: _ := Change.Degree[z := I.Int^::ofNat total].map;
\definition law: \forall (a: BaseProduct.Cohomology[].Group p) -> relativeMap.apply (Source.Degree[p := p].isomorphism.forward.apply a) = Target.Degree[p := p].isomorphism.forward.apply (baseMap.apply a) :=
  \fun (a: BaseProduct.Cohomology[].Group p) => trans!{{TargetTheory.Degree[n := total].Class}} _ _ _
    (RelativeChange.Cup[p := p, q := n].Cohomology[].law (SourceProjection.apply p Disk.diskProjection Disk.diskProjectionContinuous a) Source.class)
    (congr!{{TargetTotal.Cohomology[].Group p} {TargetTheory.Degree[n := n].Class} {TargetTheory.Degree[n := total].Class}} Product.apply _ _ _ _ (ProjectionNatural.law a) classLaw);
\definition inverseLaw: \forall (u: SourceTheory.Degree[n := total].Class) -> baseMap.apply (Source.Degree[p := p].isomorphism.backward.apply u) = Target.Degree[p := p].isomorphism.backward.apply (relativeMap.apply u) :=
  \fun (u: SourceTheory.Degree[n := total].Class) => eq_reason_in!{{TargetProduct.Cohomology[].Group p} _
    "=" _ "by" { sym!{{TargetProduct.Cohomology[].Group p}} _ _ (Target.Degree[p := p].isomorphism.leftInverse (baseMap.apply (Source.Degree[p := p].isomorphism.backward.apply u))) }
    "=" _ "by" { congr!{{TargetTheory.Degree[n := total].Class} {TargetProduct.Cohomology[].Group p}} Target.Degree[p := p].isomorphism.backward.apply _ _ (sym!{{TargetTheory.Degree[n := total].Class}} _ _ (law (Source.Degree[p := p].isomorphism.backward.apply u))) }
    "=" _ "by" { congr!{{SourceTheory.Degree[n := total].Class} {TargetProduct.Cohomology[].Group p}} (\fun (v: SourceTheory.Degree[n := total].Class) => Target.Degree[p := p].isomorphism.backward.apply (relativeMap.apply v)) _ _ (Source.Degree[p := p].isomorphism.rightInverse u) }
  };
