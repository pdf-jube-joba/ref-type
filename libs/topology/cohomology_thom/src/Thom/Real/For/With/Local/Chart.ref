\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Chart[c := c] \as Geometry;
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Local[K := K, ring := ring] \as Local;
\import Local.Model[n := c.dimension, U := c.domain] \as Model;
\import Geometry.Open[].Ring[K := K, ring := ring] \as Calculation;
\definition data: Model.Data := Model.Data {
  thomClass := Calculation.class,
  isomorphism := \fun (p: N.Nat^) => Calculation.Degree[p := p].relativeIsomorphism,
  formula := \fun (p: N.Nat^)(a: \root.RelativeAction[A := Geometry.Open[].Carrier, source := Geometry.Open[].topology, subset := Geometry.Open[].boundary, K := K, ring := ring].Degree[p := p, q := c.dimension].Domain) => \refl((Calculation.Degree[p := p].relativeIsomorphism).forward.apply a),
  below := \fun (k: N.Nat^) => Geometry.Open[].Additive[coefficients := BaseProduct.integerCoefficients].Negative[k := k].zero
};
\definition Family[n: N.Nat^]: \Set := Local.Model[n := n, U := c.domain].Data;
\definition atRank[n: N.Nat^][same: c.dimension = n]: Local.Model[n := n, U := c.domain].Data := Transport.cast Family c.dimension n same data;

\module Rank(n: N.Nat^, same: c.dimension = n);

\module Refine(U: \Pow X, open: topology.Topology[Carrier := X].IsOpenIn bundle.baseSpace U, contained: topology.Topology[Carrier := X].Subset U c.domain);
