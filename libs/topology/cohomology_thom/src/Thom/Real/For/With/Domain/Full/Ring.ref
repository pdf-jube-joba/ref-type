\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Domain[U := U].Ring[K := K, ring := ring] \as DomainTheory;
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Coefficients[R := K, ring := ring] \as Original;
\import \root.RelativePullback[].On[A := Carrier, source := topology, subset := boundary, R := K, ring := ring].To[B := Disk.DiskBundle, target := Disk.diskTopology, part := Disk.Boundary].Homeomorphism[data := pair] \as Comparison;
\import \root.RelativeAction[A := Carrier, source := topology, subset := boundary, K := K, ring := ring].Homeomorphism[B := Disk.DiskBundle, target := Disk.diskTopology, part := Disk.Boundary, data := Comparison.inverseData] \as Transport;
\import \root.RelativePullback[].On[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary, R := K, ring := ring].To[B := Carrier, target := topology, part := boundary].Homeomorphism[data := Comparison.inverseData] \as Reverse;
\module Degree(n: N.Nat^) {
  \definition from[u: DomainTheory.Degree[n := n].Class]: Original.Degree[n := n].Class := Transport.Degree[p := N.Nat^::zero, q := n].factor u;
  \definition isomorphism: _ := Reverse.Degree[n := n].isomorphism;
  \definition formula: \forall (u: DomainTheory.Degree[n := n].Class) -> isomorphism.forward.apply u = from u := \fun (u: DomainTheory.Degree[n := n].Class) => \refl(from u);
}
\module Product(p, n: N.Nat^) {
  \definition isomorphism[u: DomainTheory.Degree[n := n].Class][e: DomainTheory.Cup[p := p, n := n].With[u := u].Iso]
    [formula: \forall (a: DomainTheory.Cup[p := p, n := n].Domain) -> e.forward.apply a = (DomainTheory.Cup[p := p, n := n].map u).apply a]: _ := Transport.Degree[p := p, q := n].isomorphism u e formula;
}
