\import Integral.Gysin[] \as Native;

\module Degree(z: I.Int^) {
  \definition sequence: _ := Native.Degree[z := z].sequence;
  \definition cupEuler: _ := Native.Degree[z := z].cupEuler;
  \definition pullback: _ := Native.Degree[z := z].pullback;
  \definition pullbackLaw: _ := Native.Degree[z := z].Pullback[].law;
  \definition integration: _ := Native.Degree[z := z].integration;
  \definition higherCupEuler: _ := Native.Degree[z := z].higherCupEuler;
  \definition higherLaw: _ := Native.Degree[z := z].higherLaw;
}
\module Positive(p: N.Nat^) { \definition law: _ := Native.Positive[p := p].law; }
\module Negative(k: N.Nat^) { \definition law: _ := Native.Negative[k := k].law; }
