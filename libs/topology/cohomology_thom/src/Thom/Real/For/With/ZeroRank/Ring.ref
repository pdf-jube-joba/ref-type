\import \parent.\parent.Coefficients[R := R, ring := ring] \as Theory;
\import singular_products.Cochains[A := X, source := bundle.baseSpace, R := R, ring := ring] \as Base;
\import singular_products.Cochains[A := Disk.DiskBundle, source := Disk.diskTopology, R := R, ring := ring] \as Total;
\import singular_cap.CochainPair[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary, R := R, ring := ring] \as Pair;
\import EmptyPair.Ring[R := R, ring := ring] \as EmptyRing;
\import Theory.Degree[n := N.Nat^::zero] \as Top;
\import Pair.Comparison[n := N.Nat^::zero].Cohomology[] \as TopForget;
\import Base.Cohomology[].Pullback[B := Disk.DiskBundle, target := Disk.diskTopology] \as Section;
\definition class: Top.Class := EmptyRing.Degree[n := N.Nat^::zero].isomorphism.backward.apply Total.Cohomology[].Unit[].class;
\definition forgetClass: TopForget.map.apply class = Total.Cohomology[].Unit[].class :=
  EmptyRing.Degree[n := N.Nat^::zero].isomorphism.rightInverse Total.Cohomology[].Unit[].class;
\definition euler: Top.euler class = Base.Cohomology[].Unit[].class :=
  trans!{{Base.Cohomology[].Group N.Nat^::zero}} _ _ _
    (congr!{{Total.Cohomology[].Group N.Nat^::zero} {Base.Cohomology[].Group N.Nat^::zero}}
      (Section.apply N.Nat^::zero Disk.zeroSection Disk.zeroSectionContinuous) _ _ forgetClass)
    (Section.Unit[].law Disk.zeroSection Disk.zeroSectionContinuous);
\module Degree(p: N.Nat^);
