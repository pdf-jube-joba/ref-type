\definition z: I.Int^ := I.Int^::negSucc k;
\definition d: I.Int^ := \root.LocalDisk[].shift n z;
\definition sourceZero: \forall (u: Base.cohomology z) -> u = (Base.cohomologySpace z).zero := \root.LocalDisk[].On[X := X, source := bundle.baseSpace].With[coefficients := BaseProduct.integerCoefficients].Negative[n := n, k := k].baseZero;
\definition targetZero: \forall (u: Relative d) -> u = (relativeSpace d).zero := Global.Below[k := k].zero;
\definition isomorphism: \parent.At[z := z].Iso := IntegerModules.Isomorphism[V := Base.cohomology z, W := Relative d, source := Base.cohomologySpace z, target := relativeSpace d].Isomorphism {
  forward := IntegerModules.Hom[V := Base.cohomology z, W := Relative d, source := Base.cohomologySpace z, target := relativeSpace d].zeroMap,
  backward := IntegerModules.Hom[V := Relative d, W := Base.cohomology z, source := relativeSpace d, target := Base.cohomologySpace z].zeroMap,
  leftInverse := \fun (u: Base.cohomology z) => sym!{{Base.cohomology z}} _ _ (sourceZero u),
  rightInverse := \fun (u: Relative d) => sym!{{Relative d}} _ _ (targetZero u)
};
