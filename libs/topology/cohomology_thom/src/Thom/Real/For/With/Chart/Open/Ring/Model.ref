\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Chart[c := c] \as ChartGeometry;
\import module_theory.Module[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as Modules;
\import singular_products.Cochains[A := BasePoint, source := baseTopology, R := K, ring := ring] \as Product;
\import singular_cohomology.Relative[A := Standard.DiskCarrier, source := Standard.diskTopology, subset := Standard.boundary].OverRing[R := K, ring := ring].With[coefficients := Product.coefficients] \as StandardRelative;
\import Cochains.At[C := StandardRelative.complex, z := I.Int^::ofNat n] \as Input;
\import \root.Thom[].Real[].For[X := BasePoint, F := (\fun (x: BasePoint) => F x), bundle := Pull.pulledBundle].With[metric := Pull.pulledMetric].Coefficients[R := K, ring := ring] \as MetricTheory;
\import \root.RelativePullback[].On[A := NewDisk.DiskBundle, source := NewDisk.diskTopology, subset := NewDisk.Boundary, R := K, ring := ring].To[B := Standard.DiskCarrier, target := Standard.diskTopology, part := Standard.boundary].Homeomorphism[data := ChartGeometry.pair] \as MetricComparison;
\definition Domain: \Set := Input.Cohomology;
\definition domainSpace: Modules.Space Domain := Input.cohomologySpace;
\definition isomorphism: Modules.Isomorphism[V := Domain, W := \parent.At[n := n].Class, source := domainSpace, target := \parent.At[n := n].space].Isomorphism :=
  Modules.Isomorphism[V := Domain, W := MetricTheory.Degree[n := n].Class, source := domainSpace, target := MetricTheory.Degree[n := n].space].Composition[U := \parent.At[n := n].Class, final := \parent.At[n := n].space].compose
    (Modules.Isomorphism[V := \parent.At[n := n].Class, W := MetricTheory.Degree[n := n].Class, source := \parent.At[n := n].space, target := MetricTheory.Degree[n := n].space].Inverse[].inverse Comparison.Degree[n := n].isomorphism)
    MetricComparison.Degree[n := n].isomorphism;
