\import OriginalGeometry.Local[K := R, ring := ring] \as SourceLocal;
\import PulledGeometry.Local[K := R, ring := ring] \as TargetLocal;
\import SourceLocal.Chart[c := c].Rank[n := n, same := same] \as Source;
\import TargetLocal.Chart[c := chart].Rank[n := n, same := same] \as Target;
\import SourceLocal.Rank[n := n].On[U := c.domain] \as SourceDomain;
\import TargetLocal.Rank[n := n].On[U := chart.domain] \as TargetDomain;
\module Fiber(y: \Cast[Y] chart.domain);
