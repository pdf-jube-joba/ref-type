\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Domain[U := U] \as Original;
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Domain[U := U].Along[V := V, contained := contained] \as Restrict;
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Fiber[x := x] \as Actual;
\definition originalPoint: Original.BasePoint := \into[X](x, U) \by { contained x (\bysub(X, V, x)) };
\import Other.Fiber[x := x] \as Before;
\import Original.Fiber[x := originalPoint] \as After;
\import singular_cohomology.Relative[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary].Maps[B := Other.Carrier].Over[target := Other.topology, targetSubset := Other.boundary] \as BeforeMaps;
\import BeforeMaps.Composition[C := Original.Carrier].Over[final := Original.topology, finalSubset := Original.boundary] \as Composite;
\definition composite: _ := Composite.compose Before.pairMap Restrict.pairMap;
\definition square: composite = After.pairMap := \axiom:funext(composite, After.pairMap, (\fun (p: Actual.Carrier) => \refl(After.map p)));
\module Ring(K: \Set, ring: std.Alg[].Ring[].CommutativeRing[K]);
