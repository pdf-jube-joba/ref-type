\import Geometry.Domain[U := U] \as Domain;
\import Local.Model[n := n, U := U] \as Model;
\import Domain.Ring[K := K, ring := ring].Degree[n := n] \as Top;
\definition Class: \Set := Top.Class;
\definition restriction[x: Domain.BasePoint]: _ := Domain.Fiber[x := x].Ring[K := K, ring := ring].Degree[n := n].restriction;
\definition Detects: \Prop := \forall (a, b: Class) -> (\forall (x: Domain.BasePoint) -> (restriction x).apply a = (restriction x).apply b) -> a = b;
\module Given(g: Fibers);
\definition negativeLaw: \forall (x: Domain.BasePoint)(u: Class) -> (restriction x).apply (Top.space.neg u) = Geometry.Fiber[x := x].Additive[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].space.neg ((restriction x).apply u) :=
  \fun (x: Domain.BasePoint)(u: Class) => IntegerModules.Hom[V := Class, W := FiberClass x,
    source := Domain.Additive[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].space,
    target := Geometry.Fiber[x := x].Additive[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].space].negativePreserved (restriction x) u;
