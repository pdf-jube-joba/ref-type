\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Local[K := K, ring := ring].Rank[n := n].Orientation[].With[orientation := orientation].FiniteCW[complex := complex] \as Global;
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Coefficients[R := K, ring := ring] \as Theory;
\definition class: Theory.Degree[n := n].Class := Global.class;
\definition euler: singular_products.Cochains[A := X, source := bundle.baseSpace, R := K, ring := ring].Cohomology[].Group n := Global.euler;
\definition normalized: _ := Global.normalized;
\definition uniqueNormalized: _ := Global.uniqueNormalized;
\module Degree(p: N.Nat^) {
  \definition isomorphism: _ := Global.Degree[p := p].isomorphism;
  \definition zeroSection: _ := Global.Degree[p := p].zeroSection;
}
\module Below(k: N.Nat^) { \definition zero: _ := Global.Below[k := k].zero; }

\module Change(L: \Set, targetRing: Rings.CommutativeRing[L],
  morphism: \root.CoefficientChange[].OnSpace[A := X, source := bundle.baseSpace, R := K, S := L, ring := ring, targetRing := targetRing].Morphism);
\module Integer;
\module Reverse;
\module Gysin;
