\import OldChart.Rank[n := n, same := same] \as Old;
\import NewChart.Rank[n := n, same := same] \as New;
\import Local.Rank[n := n].On[U := c.domain] \as OldDomain;
\import Local.Rank[n := n].On[U := U] \as NewDomain;
\module Fiber(x: \Cast[X] U);
\definition given[g: Local.Rank[n := n].Fibers][reverse: std.Data[].Bool[].Bool^]
  [normal: OldDomain.Given[g := g].Normalized (Old.signed reverse).thomClass]: NewDomain.Given[g := g].Data :=
  New.given g reverse (\fun (x: \Cast[X] U) => trans!{{Local.Rank[n := n].FiberClass x}} _ _ _
    (sym!{{Local.Rank[n := n].FiberClass x}} _ _ (Fiber[x := x].signed reverse)) (normal (originalPoint x)));
