\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Domain[U := U] \as LocalDomain;
\import Actual.Additive[coefficients := coefficients, z := z] \as Fiber;
\import LocalDomain.Additive[coefficients := coefficients, z := z] \as Local;
\import Maps.Composition[C := Disk.DiskBundle].Over[final := Disk.diskTopology, finalSubset := Disk.Boundary] \as Composition;
\import singular_cohomology.Relative[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary].Maps[B := Disk.DiskBundle].Over[target := Disk.diskTopology, targetSubset := Disk.Boundary] \as Direct;
\definition composed: Direct.Map := Composition.compose pairMap LocalDomain.pairInclusion;
\definition same: composed = Actual.pairInclusion := \refl(Actual.pairInclusion);
\definition restriction: _ := Maps.On[f := pairMap].Integer[].With[coefficients := coefficients].At[z := z].induced;
\definition action[m: Direct.Map]: _ := Direct.On[f := m].Integer[].With[coefficients := coefficients].At[z := z].induced;
\import singular_cohomology.Relative[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary].With[coefficients := coefficients].At[z := z] \as Whole;
\definition law: \forall (u: Whole.Carrier) -> restriction.apply (Local.restriction.apply u) = Fiber.restriction.apply u :=
  \fun (u: Whole.Carrier) => trans!{Fiber.Class} _ _ _
    (sym!{Fiber.Class} _ _ (Composition.On[f := pairMap, g := LocalDomain.pairInclusion].With[coefficients := coefficients].law z u))
    (congr!{Direct.Map Fiber.Class} (\fun (m: Direct.Map) => (action m).apply u) _ _ same);
