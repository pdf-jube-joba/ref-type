\use std.Logic[].Equality[].eq_reason_in;
\import MV.RightAction[K := K, ring := ring].Native[p := N.Nat^::zero, q := n] \as Action;
\definition left: Action.leftFactor u = leftClass := eq_reason_in!{{NativeLeft.At[z := I.Int^::ofNat n].Carrier} _
  "=" _ "by" { sym!{{NativeLeft.At[z := I.Int^::ofNat n].Carrier}} _ _ (Action.leftValue u) }
  "=" _ "by" { congr!{H.Cohomology {NativeLeft.At[z := I.Int^::ofNat n].Carrier}} Comparison.Degree[z := I.Int^::ofNat n].nativeLeft.apply _ _ same }
  "=" _ "by" { Glued.nativeLeftRestriction }
};
\definition right: Action.rightFactor u = rightClass := eq_reason_in!{{NativeRight.At[z := I.Int^::ofNat n].Carrier} _
  "=" _ "by" { sym!{{NativeRight.At[z := I.Int^::ofNat n].Carrier}} _ _ (Action.rightValue u) }
  "=" _ "by" { congr!{H.Cohomology {NativeRight.At[z := I.Int^::ofNat n].Carrier}} Comparison.Degree[z := I.Int^::ofNat n].nativeRight.apply _ _ same }
  "=" _ "by" { Glued.nativeRightRestriction }
};
\definition overlap: Action.overlapFactor u = overlapClass := eq_reason_in!{{NativeOverlap.At[z := I.Int^::ofNat n].Carrier} _
  "=" _ "by" { sym!{{NativeOverlap.At[z := I.Int^::ofNat n].Carrier}} _ _ (Action.overlapLeftValue u) }
  "=" _ "by" { congr!{{NativeLeft.At[z := I.Int^::ofNat n].Carrier} {NativeOverlap.At[z := I.Int^::ofNat n].Carrier}} Comparison.Degree[z := I.Int^::ofNat n].nativeOverlapLeft.apply _ _ left }
  "=" _ "by" { Matching.nativeLeft }
};
