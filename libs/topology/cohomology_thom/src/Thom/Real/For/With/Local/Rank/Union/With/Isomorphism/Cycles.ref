\import MV.RightAction[K := K, ring := ring].Zero[q := n] \as Zero;
\import \parent.LocalDiagram[p := N.Nat^::zero] \as ZeroDiagram;
\definition zeroBelow: \forall (a: Sequence.Degree[z := chain_complexes.Integer[].previous (I.Int^::ofNat (N.Basic[].Def[].add N.Nat^::zero n))].intersection.Carrier) -> a = Sequence.Degree[z := chain_complexes.Integer[].previous (I.Int^::ofNat (N.Basic[].Def[].add N.Nat^::zero n))].intersection.space.zero :=
  \idelim n = N.Basic[].Def[].add N.Nat^::zero n \with k: N.Nat^ =>
    \forall (a: Sequence.Degree[z := chain_complexes.Integer[].previous (I.Int^::ofNat k)].intersection.Carrier) -> a = Sequence.Degree[z := chain_complexes.Integer[].previous (I.Int^::ofNat k)].intersection.space.zero
  \by { base: overlapPrevious, equality: sym!{N.Nat^} _ _ (N.Basic[].Prop[].addZeroLeft n) };
\definition zeroIsomorphism[u: H.Closed][same: H.classOf u = Glued.class]: _ := Zero.With[u := u].isomorphism (ZeroDiagram.local u same) zeroBelow;
\definition zero[u: H.Closed][same: H.classOf u = Glued.class]: Multiplication.Degree[p := N.Nat^::zero, q := n].On[u := H.classOf u].Bijective :=
  Multiplication.Degree[p := N.Nat^::zero, q := n].On[u := H.classOf u].witnessed (zeroIsomorphism u same)
    (\fun (a: Multiplication.Degree[p := N.Nat^::zero, q := n].Domain) => \refl((zeroIsomorphism u same).forward.apply a));
\definition successorIsomorphism[p: N.Nat^][u: H.Closed][same: H.classOf u = Glued.class]: _ :=
  MV.RightAction[K := K, ring := ring].Gluing[p := p, q := n].With[u := u].isomorphism (\parent.LocalDiagram[p := p].laws u same) (\parent.LocalDiagram[p := N.Nat^::succ p].laws u same);
\definition successor[p: N.Nat^][u: H.Closed][same: H.classOf u = Glued.class]: Multiplication.Degree[p := N.Nat^::succ p, q := n].On[u := H.classOf u].Bijective :=
  Multiplication.Degree[p := N.Nat^::succ p, q := n].On[u := H.classOf u].witnessed (successorIsomorphism p u same)
    (\fun (a: Multiplication.Degree[p := N.Nat^::succ p, q := n].Domain) => \refl((successorIsomorphism p u same).forward.apply a));
\definition bijective: \forall (p: N.Nat^)(u: H.Closed) -> H.classOf u = Glued.class -> Multiplication.Degree[p := p, q := n].On[u := H.classOf u].Bijective :=
  \induction (p: N.Nat^) \return \forall (u: H.Closed) -> H.classOf u = Glued.class -> Multiplication.Degree[p := p, q := n].On[u := H.classOf u].Bijective \with {
    | zero: zero
    | succ: \fun (p: N.Nat^)(previous: \forall (u: H.Closed) -> H.classOf u = Glued.class -> Multiplication.Degree[p := p, q := n].On[u := H.classOf u].Bijective) => successor p
  };
