  \definition space: _ := Cochains.At[C := Relative.complex, z := I.Int^::ofNat n].cohomologySpace;
}
\definition class: At[n := c.dimension].Class := Comparison.Degree[n := c.dimension].isomorphism.backward.apply Metric.class;
