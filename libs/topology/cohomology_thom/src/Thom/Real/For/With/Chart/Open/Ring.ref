\import singular_cohomology.Relative[A := Carrier, source := topology, subset := boundary].OverRing[R := K, ring := ring].With[coefficients := singular_products.Cochains[A := BasePoint, source := baseTopology, R := K, ring := ring].coefficients] \as Relative;
\import chain_complexes.Integer[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as Cochains;
