\definition degree: I.Int^ := \root.LocalDisk[].shift c.dimension (I.Int^::negSucc k);
\import singular_cohomology.Relative[A := NewDisk.DiskBundle, source := NewDisk.diskTopology, subset := NewDisk.Boundary].With[coefficients := coefficients].At[z := degree] \as Native;
\import StandardRelative.At[z := degree] \as Source;
\definition zero: \forall (u: Native.Carrier) -> u = Native.space.zero :=
  IntegerModules.Isomorphism[V := Source.Carrier, W := Native.Carrier, source := Source.space, target := Native.space].Vanishing[].targetZero
    (Pairs.With[coefficients := coefficients].At[z := degree].isomorphism pair) StandardTheory.Negative[n := c.dimension, k := k].zero;
