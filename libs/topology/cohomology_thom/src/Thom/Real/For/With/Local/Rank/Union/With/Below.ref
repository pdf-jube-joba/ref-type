\definition z: I.Int^ := \root.LocalDisk[].shift n (I.Int^::negSucc k);
\definition previous: I.Int^ := chain_complexes.Integer[].previous z;
\definition overlapBefore: \forall (a: OverlapDomain.Additive[coefficients := BaseProduct.integerCoefficients, z := previous].Class) -> a = OverlapDomain.Additive[coefficients := BaseProduct.integerCoefficients, z := previous].space.zero :=
  \idelim \root.LocalDisk[].shift n (I.Int^::negSucc (N.Nat^::succ k)) = previous \with w: I.Int^ =>
    \forall (a: OverlapDomain.Additive[coefficients := BaseProduct.integerCoefficients, z := w].Class) -> a = OverlapDomain.Additive[coefficients := BaseProduct.integerCoefficients, z := w].space.zero
  \by { base: overlap.model.below (N.Nat^::succ k), equality: sym!{I.Int^} _ _ (\root.LocalDisk[].previousShiftNegative n k) };
\definition leftZero: _ := Comparison.Degree[z := z].leftZero (left.model.below k);
\definition rightZero: _ := Comparison.Degree[z := z].rightZero (right.model.below k);
\definition overlapZero: _ := Comparison.Degree[z := previous].overlapZero overlapBefore;
\definition whole: \forall (a: WholeDomain.Additive[coefficients := BaseProduct.integerCoefficients, z := z].Class) -> a = WholeDomain.Additive[coefficients := BaseProduct.integerCoefficients, z := z].space.zero :=
  Sequence.Vanishing[z := z].whole leftZero rightZero overlapZero;
