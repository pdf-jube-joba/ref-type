\import BundleGeometry.Fiber[x := x] \as Actual;
\import Geometry.Fiber[x := x] \as FiberGeometry;
\import FiberGeometry.Ring[K := K, ring := ring] \as Source;
\import FiberGeometry.Ring[K := L, ring := targetRing] \as Target;
\import thom_spaces.Thom[].CWType[].Point[] \as Point;
\import thom_spaces.Thom[].DiskSuspension[X := Point.Carrier, space := Point.topology, n := c.dimension] \as PointDisk;
\import \root.LocalDisk[].Point[K := K, ring := ring].Rank[n := c.dimension] \as SourcePoint;
\import \root.LocalDisk[].Point[K := L, ring := targetRing].Rank[n := c.dimension] \as TargetPoint;
\import \root.CoefficientChange[].OnSpace[A := Point.Carrier, source := Point.topology, R := K, S := L, ring := ring, targetRing := targetRing] \as PointCoefficients;
\definition pointMorphism: PointCoefficients.Morphism := PointCoefficients.Morphism { linear := morphism.linear, multiply := morphism.multiply, unit := morphism.unit };
\import \root.LocalDisk[].On[X := Point.Carrier, source := Point.topology].Change[K := K, L := L, ring := ring, targetRing := targetRing, morphism := pointMorphism] \as PointClasses;
\import singular_cohomology.Relative[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary] \as ActualPair;
\import singular_cohomology.Relative[A := PointDisk.DiskCarrier, source := PointDisk.diskTopology, subset := PointDisk.boundary] \as PointPair;
\import ActualPair.Homeomorphism[B := PointDisk.DiskCarrier].Over[target := PointDisk.diskTopology, targetSubset := PointDisk.boundary] \as Pairs;
\import ActualPair.Maps[B := PointDisk.DiskCarrier].Over[target := PointDisk.diskTopology, targetSubset := PointDisk.boundary].On[f := Pairs.forwardMap FiberGeometry.fiberPair].Integer[] \as Inclusion;
\import \root.CoefficientChange[].On[C := PointPair.complex, M := BaseProduct.integerCoefficients, N := TargetProduct.integerCoefficients, u := morphism.linear].Along[D := ActualPair.complex, f := Inclusion.map].At[z := I.Int^::ofNat c.dimension] \as Natural;
\definition map: _ := Change.Fiber[x := x, z := I.Int^::ofNat c.dimension].map;
\definition generator: map.apply Source.generator = Target.generator := trans!{Target.Class} _ _ _
  (Natural.law SourcePoint.generator)
  (congr!{TargetPoint.Class Target.Class} Target.pointComparison.forward.apply _ _ (PointClasses.canonical c.dimension));
