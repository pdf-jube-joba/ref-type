\import MV.RightAction[K := K, ring := ring].Native[p := p, q := n] \as Action;
\import NativeLeftAction.Degree[p := p, q := n] \as LeftProduct;
\definition leftFormulaCycle[u: H.Closed][same: H.classOf u = Glued.class]: \forall (a: LeftProduct.Domain) -> (leftIsomorphism p).forward.apply a = LeftProduct.apply (Action.leftFactor u) a :=
  \fun (a: LeftProduct.Domain) => trans!{LeftProduct.Range} _ _ _ (leftFormula p a)
    (congr!{LeftProduct.Factor LeftProduct.Range} (\fun (v: LeftProduct.Factor) => LeftProduct.apply v a) _ _ (sym!{LeftProduct.Factor} _ _ (\parent.Factors[u := u, same := same].left)));
\definition leftBijective[u: H.Closed][same: H.classOf u = Glued.class]: LeftProduct.On[u := Action.leftFactor u].Bijective :=
  LeftProduct.On[u := Action.leftFactor u].witnessed (leftIsomorphism p) (leftFormulaCycle u same);
\import NativeRightAction.Degree[p := p, q := n] \as RightProduct;
\definition rightFormulaCycle[u: H.Closed][same: H.classOf u = Glued.class]: \forall (a: RightProduct.Domain) -> (rightIsomorphism p).forward.apply a = RightProduct.apply (Action.rightFactor u) a :=
  \fun (a: RightProduct.Domain) => trans!{RightProduct.Range} _ _ _ (rightFormula p a)
    (congr!{RightProduct.Factor RightProduct.Range} (\fun (v: RightProduct.Factor) => RightProduct.apply v a) _ _ (sym!{RightProduct.Factor} _ _ (\parent.Factors[u := u, same := same].right)));
\definition rightBijective[u: H.Closed][same: H.classOf u = Glued.class]: RightProduct.On[u := Action.rightFactor u].Bijective :=
  RightProduct.On[u := Action.rightFactor u].witnessed (rightIsomorphism p) (rightFormulaCycle u same);
\import NativeOverlapAction.Degree[p := p, q := n] \as OverlapProduct;
\definition overlapFormulaCycle[u: H.Closed][same: H.classOf u = Glued.class]: \forall (a: OverlapProduct.Domain) -> (overlapIsomorphism p).forward.apply a = OverlapProduct.apply (Action.overlapFactor u) a :=
  \fun (a: OverlapProduct.Domain) => trans!{OverlapProduct.Range} _ _ _ (overlapFormula p a)
    (congr!{OverlapProduct.Factor OverlapProduct.Range} (\fun (v: OverlapProduct.Factor) => OverlapProduct.apply v a) _ _ (sym!{OverlapProduct.Factor} _ _ (\parent.Factors[u := u, same := same].overlap)));
\definition overlapBijective[u: H.Closed][same: H.classOf u = Glued.class]: OverlapProduct.On[u := Action.overlapFactor u].Bijective :=
  OverlapProduct.On[u := Action.overlapFactor u].witnessed (overlapIsomorphism p) (overlapFormulaCycle u same);
\definition local[u: H.Closed][same: H.classOf u = Glued.class]: Action.Isomorphisms[u := u].Local := Action.Isomorphisms[u := u].Local {
  leftInjective := (leftBijective u same).injective, leftSurjective := (leftBijective u same).onto,
  rightInjective := (rightBijective u same).injective, rightSurjective := (rightBijective u same).onto,
  overlapInjective := (overlapBijective u same).injective, overlapSurjective := (overlapBijective u same).onto
};
\definition laws[u: H.Closed][same: H.classOf u = Glued.class]: _ := Action.Isomorphisms[u := u].laws (local u same);
