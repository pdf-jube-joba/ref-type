\definition subset: \Pow Disk.DiskBundle := { v: Disk.DiskBundle \where Disk.diskProjection v = x };
\import topology.Topology[Carrier := Disk.DiskBundle].Subspace[S := subset] \as Subspace;
\definition Carrier: \Set := Subspace.CarrierSet;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Subspace.topology Disk.diskTopology;
\definition boundary: \Pow Carrier := { v: Carrier \where \In[Disk.DiskBundle] Disk.Boundary v };
\definition inclusion[v: Carrier]: Disk.DiskBundle := v;
\definition continuous: topology.Continuity[A := Carrier, B := Disk.DiskBundle].Continuous topology Disk.diskTopology inclusion :=
  topology.Continuity[A := Carrier, B := Disk.DiskBundle].Corestriction[S := subset].inclusionContinuous Disk.diskTopology;
\import singular_cohomology.Relative[A := Carrier, source := topology, subset := boundary] \as Relative;
\import Relative.Maps[B := Disk.DiskBundle].Over[target := Disk.diskTopology, targetSubset := Disk.Boundary] \as Maps;
\definition pairInclusion: Maps.Map := \into[Carrier -> Disk.DiskBundle](inclusion, { f: Carrier -> Disk.DiskBundle \where Maps.Laws[f] }) \by {
  Maps.Laws[inclusion] {
    continuous := continuous,
    contained := \fun (v: Relative.SubspaceCarrier) => \bysub(Carrier, boundary, v)
  }
};
\module Additive(coefficients: IntegerModules.Bundle, z: I.Int^);
