\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Local[K := K, ring := ring].Change[L := L, targetRing := targetRing, morphism := morphism].Rank[n := n, orientation := orientation] \as Changed;
\import Changed.FiniteCW[complex := complex] \as Comparison;
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Oriented[K := L, ring := targetRing, n := n, orientation := Changed.targetOrientation, complex := complex] \as Target;
\definition targetOrientation: _ := Changed.targetOrientation;
\definition class: _ := Comparison.class;
\definition classLaw: _ := Comparison.classLaw;
\definition eulerLaw: _ := Comparison.Euler[].law;
\module Degree(p: N.Nat^) {
  \definition isomorphism: _ := Target.Degree[p := p].isomorphism;
  \definition law: _ := Comparison.Degree[p := p].law;
  \definition inverseLaw: _ := Comparison.Degree[p := p].inverseLaw;
}
