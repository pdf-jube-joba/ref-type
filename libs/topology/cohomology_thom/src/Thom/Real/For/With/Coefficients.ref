\import module_theory.Module[].Over[R := R, ring := Rings.commutativeRingAsRing R ring] \as Modules;
\import singular_products.Cochains[A := X, source := bundle.baseSpace, R := R, ring := ring] \as Base;
\import singular_products.Cochains[A := Disk.DiskBundle, source := Disk.diskTopology, R := R, ring := ring] \as Total;
\import singular_cap.CochainPair[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary, R := R, ring := ring] \as Pair;
\import singular_cohomology.Relative[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary].OverRing[R := R, ring := ring].With[coefficients := Base.coefficients] \as Relative;
\import chain_complexes.Integer[].Over[R := R, ring := Rings.commutativeRingAsRing R ring] \as Complexes;
\import Total.Cohomology[].Pullback[B := X, target := bundle.baseSpace] \as Projection;
\import Base.Cohomology[].Pullback[B := Disk.DiskBundle, target := Disk.diskTopology] \as Section;
\module Degree(n: N.Nat^);
\module Product(p, n: N.Nat^);
\import singular_cohomology.Equivalence[A := Disk.DiskBundle, B := X, source := Disk.diskTopology, target := bundle.baseSpace].With[coefficients := Base.integerCoefficients] \as DiskEquivalence;
\definition sectionProjection: \forall (p: N.Nat^)(a: Base.Cohomology[].Group p) ->
  Section.apply p Disk.zeroSection Disk.zeroSectionContinuous (Projection.apply p Disk.diskProjection Disk.diskProjectionContinuous a) = a :=
  \fun (p: N.Nat^)(a: Base.Cohomology[].Group p) => DiskEquivalence.rightInverse Disk.Contraction[].equivalence p a;
