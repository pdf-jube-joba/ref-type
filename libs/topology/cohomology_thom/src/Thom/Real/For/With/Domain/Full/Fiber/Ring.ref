\import singular_products.Cochains[A := X, source := bundle.baseSpace, R := K, ring := ring] \as Product;
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Domain[U := U].Full[everywhere := everywhere].Ring[K := K, ring := ring] \as Full;
\import Composite.On[f := Actual.pairInclusion, g := Pairs.backwardMap pair].With[coefficients := Product.integerCoefficients] \as Comparison;
\import singular_cohomology.Relative[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary].Maps[B := Carrier].Over[target := topology, targetSubset := boundary] \as Maps;
\module Degree(n: N.Nat^) {
  \definition action[f: Maps.Map]: _ := Maps.On[f := f].Integer[].With[coefficients := Product.integerCoefficients].At[z := I.Int^::ofNat n].induced;
  \definition law: \forall (u: \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Domain[U := U].Ring[K := K, ring := ring].Degree[n := n].Class) ->
    Actual.Additive[coefficients := Product.integerCoefficients, z := I.Int^::ofNat n].restriction.apply (Full.Degree[n := n].from u) = Local.Ring[K := K, ring := ring].Degree[n := n].restriction.apply u :=
    \fun (u: \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Domain[U := U].Ring[K := K, ring := ring].Degree[n := n].Class) => trans!{{Actual.Additive[coefficients := Product.integerCoefficients, z := I.Int^::ofNat n].Class}} _ _ _
      (sym!{{Actual.Additive[coefficients := Product.integerCoefficients, z := I.Int^::ofNat n].Class}} _ _ (Comparison.law (I.Int^::ofNat n) u))
      (congr!{Maps.Map {Actual.Additive[coefficients := Product.integerCoefficients, z := I.Int^::ofNat n].Class}} (\fun (f: Maps.Map) => (action f).apply u) composite Local.pairMap square);
}
