\definition degree: I.Int^ := \root.LocalDisk[].shift n (I.Int^::negSucc k);
\import Domain.Additive[coefficients := BaseProduct.integerCoefficients, z := degree] \as Group;
\import singular_cohomology.Relative[A := Domain.Carrier, source := Domain.topology, subset := Domain.boundary].Homeomorphism[B := Domain.Carrier].Over[target := Domain.topology, targetSubset := Domain.boundary] \as Pairs;
\definition zero: \forall (u: Group.Class) -> u = Group.space.zero :=
  IntegerModules.Isomorphism[V := Group.Class, W := Group.Class, source := Group.space, target := Group.space].Vanishing[].targetZero
    (Pairs.With[coefficients := BaseProduct.integerCoefficients].At[z := degree].isomorphism homeomorphism) (model.below k);
