\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric] \as Geometry;
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Local[K := K, ring := ring] \as Local;
\definition FiberClass[x: X]: \Set := Geometry.Fiber[x := x].Additive[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].Class;
\definition Fibers: \Set := \forall (x: X) -> FiberClass x;
\module On(U: \Pow X);

\module Orientation;

\module Empty;

\module Union(U, V: \Pow X, openU: topology.Topology[Carrier := X].IsOpenIn bundle.baseSpace U, openV: topology.Topology[Carrier := X].IsOpenIn bundle.baseSpace V);

\module Fiber(x: X);
\module Models;
