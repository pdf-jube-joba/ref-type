\import singular_cohomology.Relative[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary] \as Relative;
\import \root.CoefficientChange[].On[C := Relative.complex, M := M, N := N, u := u] \as Change;
\definition cochainMap: _ := Change.cochainMap;
\module Degree(z: I.Int^) {
  \import \parent.\parent.Additive[coefficients := M].Degree[z := z] \as Source;
  \import \parent.\parent.Additive[coefficients := N].Degree[z := z] \as Target;
  \definition map: IntegerModules.Hom[V := Source.Class, W := Target.Class, source := Source.space, target := Target.space].Map := Change.At[z := z].map;
  \definition onClass: _ := Change.At[z := z].onClass;
}
\module Fiber(x: X, z: I.Int^);
