\import NewBase.Cohomology[].Pullback[B := NewDisk.DiskBundle, target := NewDisk.diskTopology] \as NewSection;
\import OldBase.Cohomology[].Pullback[B := Disk.DiskBundle, target := Disk.diskTopology] \as OldSection;
\import singular_cap.CochainPair[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary, R := R, ring := ring].Comparison[n := n].Cohomology[] \as Forget;
\import singular_cohomology.Maps[A := Y, B := NewDisk.DiskBundle, source := source, target := NewDisk.diskTopology]
  .Composition[C := Disk.DiskBundle, final := Disk.diskTopology].Coefficients[M := OldBase.integerCoefficients] \as First;
\import singular_cohomology.Maps[A := Y, B := X, source := source, target := bundle.baseSpace]
  .Composition[C := Disk.DiskBundle, final := Disk.diskTopology].Coefficients[M := OldBase.integerCoefficients] \as Second;
\definition law: \forall (u: Original.Degree[n := n].Class) -> Pulled.Degree[n := n].euler (pull u) = BasePull.apply n f regular (Original.Degree[n := n].euler u) :=
  \fun (u: Original.Degree[n := n].Class) => trans!{{NewBase.Cohomology[].Group n}} _ _ _
    (congr!{{NewTotal.Cohomology[].Group n} {NewBase.Cohomology[].Group n}} (NewSection.apply n NewDisk.zeroSection NewDisk.zeroSectionContinuous) _ _ (Relative.Degree[n := n].Forget[].law u))
    (trans!{{NewBase.Cohomology[].Group n}} _ _ _
      (sym!{{NewBase.Cohomology[].Group n}} _ _ (First.onCohomology NewDisk.zeroSection NewDisk.zeroSectionContinuous map continuous n (Forget.map.apply u)))
      (Second.onCohomology f regular Disk.zeroSection Disk.zeroSectionContinuous n (Forget.map.apply u)));
