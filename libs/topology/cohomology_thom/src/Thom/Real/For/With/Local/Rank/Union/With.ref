\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Proposition[] \as Logic;
\import Sequence.Degree[z := I.Int^::ofNat n] \as Top;
\import Sequence.At[z := I.Int^::ofNat n] \as TopMaps;
\import MV.With[coefficients := BaseProduct.integerCoefficients].Coordinates[].Cohomology[z := I.Int^::ofNat n] \as TopRestrictions;
\import MV.With[coefficients := BaseProduct.integerCoefficients].Coordinates[].Difference[z := I.Int^::ofNat n] \as TopDifference;
\import singular_cohomology.Relative[A := MV.Left, source := MV.leftTopology, subset := MV.leftPart].With[coefficients := BaseProduct.integerCoefficients] \as NativeLeft;
\import \root.RelativeAction[A := MV.Left, source := MV.leftTopology, subset := MV.leftPart, K := K, ring := ring] \as NativeLeftAction;
\definition leftClass: NativeLeft.At[z := I.Int^::ofNat n].Carrier := LeftAction.Degree[p := N.Nat^::zero, q := n].factor left.model.thomClass;
\definition leftFlat: Comparison.Degree[z := I.Int^::ofNat n].leftComparison.forward.apply leftClass = left.model.thomClass :=
  trans!{Left.Class} _ _ _
    (congr!{{NativeLeft.At[z := I.Int^::ofNat n].Carrier} Left.Class} LeftComparison.Degree[n := n].isomorphism.forward.apply leftClass (LeftComparison.Degree[n := n].isomorphism.backward.apply left.model.thomClass)
      (sym!{{NativeLeft.At[z := I.Int^::ofNat n].Carrier}} _ _ (LeftComparison.Degree[n := n].backwardFormula left.model.thomClass)))
    (LeftComparison.Degree[n := n].isomorphism.rightInverse left.model.thomClass);
\definition leftIsomorphism[p: N.Nat^]: _ := LeftAction.Degree[p := p, q := n].isomorphism left.model.thomClass (left.model.isomorphism p) (left.model.formula p);
\definition leftFormula: \forall (p: N.Nat^)(a: NativeLeftAction.Degree[p := p, q := n].Domain) -> (leftIsomorphism p).forward.apply a = NativeLeftAction.Degree[p := p, q := n].apply leftClass a :=
  \fun (p: N.Nat^)(a: NativeLeftAction.Degree[p := p, q := n].Domain) => \refl((leftIsomorphism p).forward.apply a);
\import singular_cohomology.Relative[A := MV.Right, source := MV.rightTopology, subset := MV.rightPart].With[coefficients := BaseProduct.integerCoefficients] \as NativeRight;
\import \root.RelativeAction[A := MV.Right, source := MV.rightTopology, subset := MV.rightPart, K := K, ring := ring] \as NativeRightAction;
\definition rightClass: NativeRight.At[z := I.Int^::ofNat n].Carrier := RightAction.Degree[p := N.Nat^::zero, q := n].factor right.model.thomClass;
\definition rightFlat: Comparison.Degree[z := I.Int^::ofNat n].rightComparison.forward.apply rightClass = right.model.thomClass :=
  trans!{Right.Class} _ _ _
    (congr!{{NativeRight.At[z := I.Int^::ofNat n].Carrier} Right.Class} RightComparison.Degree[n := n].isomorphism.forward.apply rightClass (RightComparison.Degree[n := n].isomorphism.backward.apply right.model.thomClass)
      (sym!{{NativeRight.At[z := I.Int^::ofNat n].Carrier}} _ _ (RightComparison.Degree[n := n].backwardFormula right.model.thomClass)))
    (RightComparison.Degree[n := n].isomorphism.rightInverse right.model.thomClass);
\definition rightIsomorphism[p: N.Nat^]: _ := RightAction.Degree[p := p, q := n].isomorphism right.model.thomClass (right.model.isomorphism p) (right.model.formula p);
\definition rightFormula: \forall (p: N.Nat^)(a: NativeRightAction.Degree[p := p, q := n].Domain) -> (rightIsomorphism p).forward.apply a = NativeRightAction.Degree[p := p, q := n].apply rightClass a :=
  \fun (p: N.Nat^)(a: NativeRightAction.Degree[p := p, q := n].Domain) => \refl((rightIsomorphism p).forward.apply a);
\import singular_cohomology.Relative[A := MV.Overlap, source := MV.overlapTopology, subset := MV.overlapPart].With[coefficients := BaseProduct.integerCoefficients] \as NativeOverlap;
\import \root.RelativeAction[A := MV.Overlap, source := MV.overlapTopology, subset := MV.overlapPart, K := K, ring := ring] \as NativeOverlapAction;
\definition overlapClass: NativeOverlap.At[z := I.Int^::ofNat n].Carrier := OverlapAction.Degree[p := N.Nat^::zero, q := n].factor overlap.model.thomClass;
\definition overlapFlat: Comparison.Degree[z := I.Int^::ofNat n].overlapComparison.forward.apply overlapClass = overlap.model.thomClass :=
  trans!{Overlap.Class} _ _ _
    (congr!{{NativeOverlap.At[z := I.Int^::ofNat n].Carrier} Overlap.Class} OverlapComparison.Degree[n := n].isomorphism.forward.apply overlapClass (OverlapComparison.Degree[n := n].isomorphism.backward.apply overlap.model.thomClass)
      (sym!{{NativeOverlap.At[z := I.Int^::ofNat n].Carrier}} _ _ (OverlapComparison.Degree[n := n].backwardFormula overlap.model.thomClass)))
    (OverlapComparison.Degree[n := n].isomorphism.rightInverse overlap.model.thomClass);
\definition overlapIsomorphism[p: N.Nat^]: _ := OverlapAction.Degree[p := p, q := n].isomorphism overlap.model.thomClass (overlap.model.isomorphism p) (overlap.model.formula p);
\definition overlapFormula: \forall (p: N.Nat^)(a: NativeOverlapAction.Degree[p := p, q := n].Domain) -> (overlapIsomorphism p).forward.apply a = NativeOverlapAction.Degree[p := p, q := n].apply overlapClass a :=
  \fun (p: N.Nat^)(a: NativeOverlapAction.Degree[p := p, q := n].Domain) => \refl((overlapIsomorphism p).forward.apply a);
\definition previousRank: I.Int^ := chain_complexes.Integer[].previous (I.Int^::ofNat n);
\definition flatPrevious: \forall (a: OverlapDomain.Additive[coefficients := BaseProduct.integerCoefficients, z := previousRank].Class) -> a = OverlapDomain.Additive[coefficients := BaseProduct.integerCoefficients, z := previousRank].space.zero :=
  \idelim \root.LocalDisk[].shift n (I.Int^::negSucc N.Nat^::zero) = previousRank \with z: I.Int^ =>
    \forall (a: OverlapDomain.Additive[coefficients := BaseProduct.integerCoefficients, z := z].Class) -> a = OverlapDomain.Additive[coefficients := BaseProduct.integerCoefficients, z := z].space.zero
  \by { base: overlap.model.below N.Nat^::zero, equality: \root.LocalDisk[].shiftPrevious n };
\definition overlapPrevious: \forall (a: Sequence.Degree[z := previousRank].intersection.Carrier) -> a = Sequence.Degree[z := previousRank].intersection.space.zero :=
  Comparison.Degree[z := previousRank].overlapZero flatPrevious;
\module Below(k: N.Nat^);

\module Match;
\module Class;

\module Detection;

\module Isomorphism;
\module Result;
