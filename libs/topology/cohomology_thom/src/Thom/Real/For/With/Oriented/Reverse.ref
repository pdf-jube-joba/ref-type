\import singular_products.Cochains[A := X, source := bundle.baseSpace, R := K, ring := ring] \as BaseProduct;
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric] \as Geometry;
\import Geometry.Local[K := K, ring := ring].Rank[n := n] \as Rank;
\import Rank.Orientation[].Reverse[orientation := orientation] \as Reversal;
\definition reversed: _ := Reversal.reversed;
\import Geometry.Oriented[K := K, ring := ring, n := n, orientation := reversed, complex := complex] \as Target;
\import Geometry.Coefficients[R := K, ring := ring].Degree[n := n] \as Top;
\import module_theory.Module[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as RingModules;
\definition classLaw: Target.class = Top.space.neg class := sym!{{Top.Class}} _ _
  (Target.uniqueNormalized (Top.space.neg class) (\fun (x: X) => trans!{{Rank.FiberClass x}} _ _ _
    (IntegerModules.Hom[V := Top.Class, W := Rank.FiberClass x,
      source := Geometry.Additive[coefficients := BaseProduct.integerCoefficients].Degree[z := I.Int^::ofNat n].space,
      target := Geometry.Fiber[x := x].Additive[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].space].negativePreserved
      Geometry.Fiber[x := x].Additive[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].restriction class)
    (congr!{{Rank.FiberClass x} {Rank.FiberClass x}} Rank.Fiber[x := x].space.neg _ _ (normalized x))));
\definition eulerLaw: Target.euler = (BaseProduct.Cohomology[].moduleSpace n).neg euler := trans!{{BaseProduct.Cohomology[].Group n}} _ _ _
  (congr!{{Top.Class} {BaseProduct.Cohomology[].Group n}} Top.zeroSection.apply _ _ classLaw)
  (RingModules.Hom[V := Top.Class, W := BaseProduct.Cohomology[].Group n, source := Top.space, target := BaseProduct.Cohomology[].moduleSpace n].negativePreserved Top.zeroSection class);
\module Degree(p: N.Nat^);
