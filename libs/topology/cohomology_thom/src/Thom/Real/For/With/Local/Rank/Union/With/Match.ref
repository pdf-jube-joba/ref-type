\use std.Logic[].Equality[].eq_reason_in;
\definition fromLeft: OverlapLeft.Ring[K := K, ring := ring].Degree[n := n].restriction.apply left.model.thomClass = overlap.model.thomClass :=
  overlap.detected (OverlapLeft.Ring[K := K, ring := ring].Degree[n := n].restriction.apply left.model.thomClass) overlap.model.thomClass
    (\fun (x: OverlapDomain.BasePoint) => trans!{{FiberClass x}} _ _ _
      (OverlapLeft.Fiber[x := x].Ring[K := K, ring := ring].Degree[n := n].law left.model.thomClass)
      (trans!{{FiberClass x}} _ _ _ (left.normalized OverlapLeft.Fiber[x := x].originalPoint) (sym!{{FiberClass x}} _ _ (overlap.normalized x))));
\definition nativeLeft: Comparison.Degree[z := I.Int^::ofNat n].nativeOverlapLeft.apply leftClass = overlapClass :=
  Comparison.Degree[z := I.Int^::ofNat n].overlapInjective _ _
    (eq_reason_in!{Overlap.Class _
      "=" _ "by" { Comparison.Degree[z := I.Int^::ofNat n].overlapLeftLaw leftClass }
      "=" _ "by" { congr!{Left.Class Overlap.Class} Comparison.Degree[z := I.Int^::ofNat n].overlapLeft.apply _ _ leftFlat }
      "=" _ "by" { fromLeft }
      "=" _ "by" { sym!{Overlap.Class} _ _ overlapFlat }
    });
\definition fromRight: OverlapRight.Ring[K := K, ring := ring].Degree[n := n].restriction.apply right.model.thomClass = overlap.model.thomClass :=
  overlap.detected (OverlapRight.Ring[K := K, ring := ring].Degree[n := n].restriction.apply right.model.thomClass) overlap.model.thomClass
    (\fun (x: OverlapDomain.BasePoint) => trans!{{FiberClass x}} _ _ _
      (OverlapRight.Fiber[x := x].Ring[K := K, ring := ring].Degree[n := n].law right.model.thomClass)
      (trans!{{FiberClass x}} _ _ _ (right.normalized OverlapRight.Fiber[x := x].originalPoint) (sym!{{FiberClass x}} _ _ (overlap.normalized x))));
\definition nativeRight: Comparison.Degree[z := I.Int^::ofNat n].nativeOverlapRight.apply rightClass = overlapClass :=
  Comparison.Degree[z := I.Int^::ofNat n].overlapInjective _ _
    (eq_reason_in!{Overlap.Class _
      "=" _ "by" { Comparison.Degree[z := I.Int^::ofNat n].overlapRightLaw rightClass }
      "=" _ "by" { congr!{Right.Class Overlap.Class} Comparison.Degree[z := I.Int^::ofNat n].overlapRight.apply _ _ rightFlat }
      "=" _ "by" { fromRight }
      "=" _ "by" { sym!{Overlap.Class} _ _ overlapFlat }
    });
\definition agreement: Comparison.Degree[z := I.Int^::ofNat n].nativeOverlapLeft.apply leftClass = Comparison.Degree[z := I.Int^::ofNat n].nativeOverlapRight.apply rightClass :=
  trans!{Top.intersection.Carrier} _ _ _ nativeLeft (sym!{Top.intersection.Carrier} _ _ nativeRight);
