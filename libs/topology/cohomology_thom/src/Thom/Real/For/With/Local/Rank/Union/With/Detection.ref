\use std.Logic[].Equality[].eq_reason_in;
\definition Matches[a, b: Whole.Class]: \Prop := \forall (x: WholeDomain.BasePoint) -> (Whole.restriction x).apply a = (Whole.restriction x).apply b;
\definition leftRestriction[a, b: Whole.Class][same: Matches a b]: RestrictLeft.Ring[K := K, ring := ring].Degree[n := n].restriction.apply a = RestrictLeft.Ring[K := K, ring := ring].Degree[n := n].restriction.apply b :=
  left.detected (RestrictLeft.Ring[K := K, ring := ring].Degree[n := n].restriction.apply a) (RestrictLeft.Ring[K := K, ring := ring].Degree[n := n].restriction.apply b)
    (\fun (x: LeftDomain.BasePoint) => trans!{{FiberClass x}} _ _ _ (RestrictLeft.Fiber[x := x].Ring[K := K, ring := ring].Degree[n := n].law a)
      (trans!{{FiberClass x}} _ _ _ (same RestrictLeft.Fiber[x := x].originalPoint) (sym!{{FiberClass x}} _ _ (RestrictLeft.Fiber[x := x].Ring[K := K, ring := ring].Degree[n := n].law b))));
\definition nativeLeft[a, b: Whole.Class][same: Matches a b]: Comparison.Degree[z := I.Int^::ofNat n].nativeLeft.apply a = Comparison.Degree[z := I.Int^::ofNat n].nativeLeft.apply b :=
  Comparison.Degree[z := I.Int^::ofNat n].leftInjective _ _ (eq_reason_in!{Left.Class _
    "=" _ "by" { sym!{Left.Class} _ _ (Comparison.Degree[z := I.Int^::ofNat n].leftLaw a) }
    "=" _ "by" { leftRestriction a b same }
    "=" _ "by" { Comparison.Degree[z := I.Int^::ofNat n].leftLaw b }
  });
\definition rightRestriction[a, b: Whole.Class][same: Matches a b]: RestrictRight.Ring[K := K, ring := ring].Degree[n := n].restriction.apply a = RestrictRight.Ring[K := K, ring := ring].Degree[n := n].restriction.apply b :=
  right.detected (RestrictRight.Ring[K := K, ring := ring].Degree[n := n].restriction.apply a) (RestrictRight.Ring[K := K, ring := ring].Degree[n := n].restriction.apply b)
    (\fun (x: RightDomain.BasePoint) => trans!{{FiberClass x}} _ _ _ (RestrictRight.Fiber[x := x].Ring[K := K, ring := ring].Degree[n := n].law a)
      (trans!{{FiberClass x}} _ _ _ (same RestrictRight.Fiber[x := x].originalPoint) (sym!{{FiberClass x}} _ _ (RestrictRight.Fiber[x := x].Ring[K := K, ring := ring].Degree[n := n].law b))));
\definition nativeRight[a, b: Whole.Class][same: Matches a b]: Comparison.Degree[z := I.Int^::ofNat n].nativeRight.apply a = Comparison.Degree[z := I.Int^::ofNat n].nativeRight.apply b :=
  Comparison.Degree[z := I.Int^::ofNat n].rightInjective _ _ (eq_reason_in!{Right.Class _
    "=" _ "by" { sym!{Right.Class} _ _ (Comparison.Degree[z := I.Int^::ofNat n].rightLaw a) }
    "=" _ "by" { rightRestriction a b same }
    "=" _ "by" { Comparison.Degree[z := I.Int^::ofNat n].rightLaw b }
  });
\import IntegerModules.Biproduct[V := NativeLeft.At[z := I.Int^::ofNat n].Carrier, W := NativeRight.At[z := I.Int^::ofNat n].Carrier,
  left := NativeLeft.At[z := I.Int^::ofNat n].space, right := NativeRight.At[z := I.Int^::ofNat n].space] \as Pair;
\import std.Data[].Pair[].Prop[A := NativeLeft.At[z := I.Int^::ofNat n].Carrier, B := NativeRight.At[z := I.Int^::ofNat n].Carrier] \as Pairs;
\definition detected: Whole.Detects := \fun (a, b: Whole.Class)(same: Matches a b) => Sequence.Detection[z := I.Int^::ofNat n].injective overlapPrevious a b
  (eq_reason_in!{Pair.Carrier _
    "=" _ "by" { TopRestrictions.law a }
    "=" _ "by" { Pairs.ext _ _ (nativeLeft a b same) (nativeRight a b same) }
    "=" _ "by" { sym!{Pair.Carrier} _ _ (TopRestrictions.law b) }
  });
