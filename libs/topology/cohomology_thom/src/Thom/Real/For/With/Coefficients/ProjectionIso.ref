\definition isomorphism: Modules.Isomorphism[V := Base.Cohomology[].Group p, W := Total.Cohomology[].Group p, source := Base.Cohomology[].moduleSpace p, target := Total.Cohomology[].moduleSpace p].Isomorphism :=
  Modules.Isomorphism[V := Base.Cohomology[].Group p, W := Total.Cohomology[].Group p, source := Base.Cohomology[].moduleSpace p, target := Total.Cohomology[].moduleSpace p].Isomorphism {
    forward := Projection.At[n := p].linear Disk.diskProjection Disk.diskProjectionContinuous,
    backward := Section.At[n := p].linear Disk.zeroSection Disk.zeroSectionContinuous,
    leftInverse := sectionProjection p,
    rightInverse := DiskEquivalence.leftInverse Disk.Contraction[].equivalence p
  };
