\import Geometry.Oriented[K := K, ring := ring, n := n, orientation := given, complex := complex] \as Source;
\import Geometry.Modeled[K := K, ring := ring, n := n, orientation := orientation, complex := complex] \as Target;
\import Geometry.Coefficients[R := K, ring := ring] \as Theory;
\definition classLaw: Source.class = Target.class := Target.uniqueNormalized Source.class Source.normalized;
\definition eulerLaw: Source.euler = Target.euler := congr!{{Theory.Degree[n := n].Class} {BaseProduct.Cohomology[].Group n}} Theory.Degree[n := n].zeroSection.apply _ _ classLaw;
\module Degree(p: N.Nat^) {
  \definition total: N.Nat^ := N.Basic[].Def[].add p n;
  \definition law: \forall (a: BaseProduct.Cohomology[].Group p) -> Source.Degree[p := p].isomorphism.forward.apply a = Target.Degree[p := p].isomorphism.forward.apply a :=
    \fun (a: BaseProduct.Cohomology[].Group p) => congr!{{Theory.Degree[n := n].Class} {Theory.Degree[n := total].Class}} (\fun (u: Theory.Degree[n := n].Class) => Theory.Product[p := p, n := n].apply a u) _ _ classLaw;
}
