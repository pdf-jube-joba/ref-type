\import \root.Thom[].Real[].For[X := Y, F := (\fun (y: Y) => F (f y)), bundle := pulledBundle].With[metric := pulledMetric].Coefficients[R := R, ring := ring] \as Pulled;
\import \parent.\parent.Coefficients[R := R, ring := ring] \as Original;
\import \root.RelativePullback[].On[A := NewDisk.DiskBundle, source := NewDisk.diskTopology, subset := NewDisk.Boundary, R := R, ring := ring]
  .To[B := Disk.DiskBundle, target := Disk.diskTopology, part := Disk.Boundary].Along[f := pairMap] \as Relative;
\import singular_products.Cochains[A := Y, source := source, R := R, ring := ring] \as NewBase;
\import singular_products.Cochains[A := X, source := bundle.baseSpace, R := R, ring := ring] \as OldBase;
\import singular_products.Cochains[A := NewDisk.DiskBundle, source := NewDisk.diskTopology, R := R, ring := ring] \as NewTotal;
\import singular_products.Cochains[A := Disk.DiskBundle, source := Disk.diskTopology, R := R, ring := ring] \as OldTotal;
\import NewBase.Cohomology[].Pullback[B := X, target := bundle.baseSpace] \as BasePull;
\import NewTotal.Cohomology[].Pullback[B := Disk.DiskBundle, target := Disk.diskTopology] \as TotalPull;
\import NewTotal.Cohomology[].Pullback[B := Y, target := source] \as NewProjection;
\import OldTotal.Cohomology[].Pullback[B := X, target := bundle.baseSpace] \as OldProjection;
\module Degree(n: N.Nat^) {
  \definition pull: Original.Degree[n := n].Class -> Pulled.Degree[n := n].Class := Relative.Degree[n := n].map.apply;
  \module Euler;
}
\module Product(p, n: N.Nat^);

\module Chart(c: Bundles.Family[X := X, F := F].With[data := bundle].Chart);
\module Oriented(n: N.Nat^,
  orientation: \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Local[K := R, ring := ring].Rank[n := n].Orientation[].SignedOrientation,
  complex: algebraic_topology.CW[A := X].FiniteComplex[bundle.baseSpace],
  sourceComplex: algebraic_topology.CW[A := Y].FiniteComplex[source]);
