\import singular_products.Cochains[A := X, source := bundle.baseSpace, R := K, ring := ring] \as Product;
\import Composite.On[f := Before.pairMap, g := Restrict.pairMap].With[coefficients := Product.integerCoefficients] \as Comparison;
\import singular_cohomology.Relative[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary].Maps[B := Original.Carrier].Over[target := Original.topology, targetSubset := Original.boundary] \as Maps;
\module Degree(n: N.Nat^) {
  \definition action[f: Maps.Map]: _ := Maps.On[f := f].Integer[].With[coefficients := Product.integerCoefficients].At[z := I.Int^::ofNat n].induced;
  \definition law: \forall (u: Original.Ring[K := K, ring := ring].Degree[n := n].Class) ->
    Before.Ring[K := K, ring := ring].Degree[n := n].restriction.apply (Restrict.Ring[K := K, ring := ring].Degree[n := n].restriction.apply u) = After.Ring[K := K, ring := ring].Degree[n := n].restriction.apply u :=
    \fun (u: Original.Ring[K := K, ring := ring].Degree[n := n].Class) => trans!{{Actual.Additive[coefficients := Product.integerCoefficients, z := I.Int^::ofNat n].Class}} _ _ _
      (sym!{{Actual.Additive[coefficients := Product.integerCoefficients, z := I.Int^::ofNat n].Class}} _ _ (Comparison.law (I.Int^::ofNat n) u))
      (congr!{Maps.Map {Actual.Additive[coefficients := Product.integerCoefficients, z := I.Int^::ofNat n].Class}} (\fun (f: Maps.Map) => (action f).apply u) composite After.pairMap square);
}
