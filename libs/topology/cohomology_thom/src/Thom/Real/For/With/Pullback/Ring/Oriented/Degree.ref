\definition sum: N.Nat^ := N.Basic[].Def[].add p n;
\definition baseMap: _ := BasePull.At[n := p].linear f regular;
\definition relativeMap: _ := Operations.Degree[n := sum].pull;
\definition isomorphism: _ := Target.Degree[p := p].isomorphism;
\definition law: \forall (a: OldBase.Cohomology[].Group p) -> relativeMap (Source.Degree[p := p].isomorphism.forward.apply a) = isomorphism.forward.apply (baseMap.apply a) :=
  \fun (a: OldBase.Cohomology[].Group p) => trans!{{Pulled.Degree[n := sum].Class}} _ _ _ (Operations.Product[p := p, n := n].law a Source.class)
    (congr!{{Pulled.Degree[n := n].Class} {Pulled.Degree[n := sum].Class}} (\fun (u: Pulled.Degree[n := n].Class) => Pulled.Product[p := p, n := n].apply (baseMap.apply a) u) _ _ classLaw);
\definition inverseLaw: \forall (u: Original.Degree[n := sum].Class) -> baseMap.apply (Source.Degree[p := p].isomorphism.backward.apply u) = isomorphism.backward.apply (relativeMap u) :=
  \fun (u: Original.Degree[n := sum].Class) => trans!{{NewBase.Cohomology[].Group p}} _ _ _
    (sym!{{NewBase.Cohomology[].Group p}} _ _ (isomorphism.leftInverse (baseMap.apply (Source.Degree[p := p].isomorphism.backward.apply u))))
    (trans!{{NewBase.Cohomology[].Group p}} _ _ _
      (congr!{{Pulled.Degree[n := sum].Class} {NewBase.Cohomology[].Group p}} isomorphism.backward.apply _ _ (sym!{{Pulled.Degree[n := sum].Class}} _ _ (law (Source.Degree[p := p].isomorphism.backward.apply u))))
      (congr!{{Original.Degree[n := sum].Class} {NewBase.Cohomology[].Group p}} (\fun (v: Original.Degree[n := sum].Class) => isomorphism.backward.apply (relativeMap v)) _ _ (Source.Degree[p := p].isomorphism.rightInverse u)));
