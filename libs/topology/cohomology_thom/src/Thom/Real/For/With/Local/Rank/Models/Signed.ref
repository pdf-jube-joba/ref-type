\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Local[K := K, ring := ring].Rank[n := n].Orientation[] \as Original;
\definition orientation: Orientation := Orientation {
  fiber := given.fiber,
  locally := \block {
    \fun (x: X) \then
    \takefrom local: Original.LocalOrientation[x, given.fiber] \by given.locally x \then
    \let original: Original.Patch[local.chart.domain, given.fiber] := Original.Patch[local.chart.domain, given.fiber] {
      chart := local.chart, domain := \refl(local.chart.domain), rank := local.rank, reverse := local.reverse, normalized := local.normalized
    } \then
    \return \exact(LocalOrientation[x, given.fiber] {
      domain := local.chart.domain,
      contains := local.contains,
      patch := Patch[local.chart.domain, given.fiber] {
        open := Original.patchOpen local.chart.domain given.fiber original,
        refine := \fun (V: Subdomain local.chart.domain) => Original.refine local.chart.domain given.fiber original V (subdomainOpen local.chart.domain V) (subdomainIncluded local.chart.domain V),
        generates := \fun (y: \Cast[X] local.chart.domain) => Original.generates given y
      }
    }, LocalOrientation[x, given.fiber])
  }
};
\module Compare(complex: algebraic_topology.CW[A := X].FiniteComplex[bundle.baseSpace]);
