\definition z: I.Int^ := \root.LocalDisk[].shift n (I.Int^::negSucc k);
\import Geometry.Additive[coefficients := BaseProduct.integerCoefficients].Degree[z := z] \as Output;
\import WholeDomain.Additive[coefficients := BaseProduct.integerCoefficients, z := z] \as Input;
\import singular_cohomology.Relative[A := WholeDomain.Carrier, source := WholeDomain.topology, subset := WholeDomain.boundary].Homeomorphism[B := Disk.DiskBundle].Over[target := Disk.diskTopology, targetSubset := Disk.Boundary] \as Pairs;
\definition isomorphism: _ := Pairs.With[coefficients := BaseProduct.integerCoefficients].At[z := z].isomorphism Comparison.pair;
\definition zero: \forall (u: Output.Class) -> u = Output.space.zero :=
  IntegerModules.Isomorphism[V := Output.Class, W := Input.Class, source := Output.space, target := Input.space].Vanishing[].sourceZero isomorphism (Canonical.below dataExists k);
