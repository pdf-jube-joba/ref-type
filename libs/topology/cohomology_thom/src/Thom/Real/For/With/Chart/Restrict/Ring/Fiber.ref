\definition originalPoint: BasePoint := \into[X](x, c.domain) \by { contained x (\bysub(X, U, x)) };
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Chart[c := c].Fiber[x := originalPoint].Ring[K := K, ring := ring] \as Original;
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Chart[c := chart].Fiber[x := x].Ring[K := K, ring := ring] \as Restricted;
\definition generator: Original.generator = Restricted.generator := \refl(Original.generator);
