\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Fiber[x := x] \as Actual;
\definition point: BasePoint := \into[X](x, U) \by { everywhere x };
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Domain[U := U].Fiber[x := point] \as Local;
\import singular_cohomology.Relative[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary].Maps[B := Disk.DiskBundle].Over[target := Disk.diskTopology, targetSubset := Disk.Boundary] \as Inclusions;
\import Inclusions.Composition[C := Carrier].Over[final := topology, finalSubset := boundary] \as Composite;
\definition composite: _ := Composite.compose Actual.pairInclusion (Pairs.backwardMap pair);
\definition square: composite = Local.pairMap := \axiom:funext(composite, Local.pairMap, (\fun (p: Actual.Carrier) => \refl(Local.map p)));
\module Ring(K: \Set, ring: std.Alg[].Ring[].CommutativeRing[K]);
