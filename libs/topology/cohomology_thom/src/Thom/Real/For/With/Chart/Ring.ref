\import \root.LocalDisk[].On[X := BasePoint, source := baseTopology].Ring[RingCarrier := K, ring := ring] \as StandardTheory;
\import \root.Thom[].Real[].For[X := BasePoint, F := (\fun (x: BasePoint) => F x), bundle := Pull.pulledBundle].With[metric := Pull.pulledMetric].Coefficients[R := K, ring := ring] \as LocalTheory;
\import \root.RelativePullback[].On[A := NewDisk.DiskBundle, source := NewDisk.diskTopology, subset := NewDisk.Boundary, R := K, ring := ring].To[B := Standard.DiskCarrier, target := Standard.diskTopology, part := Standard.boundary].Homeomorphism[data := pair] \as Comparison;
\definition class: LocalTheory.Degree[n := c.dimension].Class := Comparison.Degree[n := c.dimension].isomorphism.forward.apply (StandardTheory.canonical c.dimension);
\module Degree(p: N.Nat^);
