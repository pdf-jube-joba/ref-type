\import \parent.Forget[] \as Forget;
\import Base.Cohomology[].Cup[p := p, q := n] \as BaseCup;
\import Total.Cohomology[] \as TotalTheory;
\definition law: \forall (a: BaseTheory.Group p)(u: Input.Class) ->
  Output.euler (apply a u) = BaseCup.apply a (Input.euler u) :=
  \fun (a: BaseTheory.Group p)(u: Input.Class) => trans!{{BaseTheory.Group (N.Basic[].Def[].add p n)}} _ _ _
    (congr!{{TotalTheory.Group (N.Basic[].Def[].add p n)} {BaseTheory.Group (N.Basic[].Def[].add p n)}}
      (Section.apply (N.Basic[].Def[].add p n) Disk.zeroSection Disk.zeroSectionContinuous) _ _
      (Forget.law (Projection.apply p Disk.diskProjection Disk.diskProjectionContinuous a) u))
    (trans!{{BaseTheory.Group (N.Basic[].Def[].add p n)}} _ _ _
      (Section.Cup[p := p, q := n].law Disk.zeroSection Disk.zeroSectionContinuous
        (Projection.apply p Disk.diskProjection Disk.diskProjectionContinuous a)
        (Pair.Comparison[n := n].Cohomology[].map.apply u))
      (congr!{{BaseTheory.Group p} {BaseTheory.Group (N.Basic[].Def[].add p n)}}
        (\fun (b: BaseTheory.Group p) => BaseCup.apply b (Input.euler u)) _ _ (sectionProjection p a)));
