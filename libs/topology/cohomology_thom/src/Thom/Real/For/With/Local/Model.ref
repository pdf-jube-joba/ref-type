\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Domain[U := U] \as Domain;
\import Domain.Ring[K := K, ring := ring] \as Theory;
\import Theory.Degree[n := n] \as Top;
\structure Data: \Set := {
  thomClass: Top.Class,
  isomorphism: \forall (p: N.Nat^) -> Theory.Cup[p := p, n := n].With[u := thomClass].Iso,
  formula: \forall (p: N.Nat^)(a: Theory.Cup[p := p, n := n].Domain) -> (isomorphism p).forward.apply a = (Theory.Cup[p := p, n := n].map thomClass).apply a,
  below: \forall (k: N.Nat^)(a: Domain.Additive[coefficients := BaseProduct.integerCoefficients, z := \root.LocalDisk[].shift n (I.Int^::negSucc k)].Class) ->
    a = Domain.Additive[coefficients := BaseProduct.integerCoefficients, z := \root.LocalDisk[].shift n (I.Int^::negSucc k)].space.zero
};
\module Reverse(model: Data);
\module Transport(model: Data,
  homeomorphism: singular_cohomology.Relative[A := Domain.Carrier, source := Domain.topology, subset := Domain.boundary].Homeomorphism[B := Domain.Carrier].Over[target := Domain.topology, targetSubset := Domain.boundary].Data);
