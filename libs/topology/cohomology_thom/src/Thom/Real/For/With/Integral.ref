\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Oriented[K := I.Int^, ring := IntegerRing.commutativeRing, n := n, orientation := orientation, complex := complex] \as Integral;
\definition class: _ := Integral.class;
\definition euler: _ := Integral.euler;
\definition normalized: _ := Integral.normalized;
\definition uniqueNormalized: _ := Integral.uniqueNormalized;
\module Degree(p: N.Nat^) {
  \definition isomorphism: _ := Integral.Degree[p := p].isomorphism;
  \definition zeroSection: _ := Integral.Degree[p := p].zeroSection;
}
\module Below(k: N.Nat^) { \definition zero: _ := Integral.Below[k := k].zero; }
\module Coefficients(K: \Set, ring: Rings.CommutativeRing[K]);
