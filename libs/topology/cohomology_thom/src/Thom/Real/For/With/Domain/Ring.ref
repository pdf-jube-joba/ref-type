\import singular_products.Cochains[A := Carrier, source := topology, R := K, ring := ring] \as Product;
\import module_theory.Module[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as Modules;
\import Pair.OverRing[R := K, ring := ring].With[coefficients := Product.coefficients] \as Theory;
\import chain_complexes.Integer[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as Cochains;
\module Degree(n: N.Nat^) {
  \import Cochains.At[C := Theory.complex, z := I.Int^::ofNat n] \as H;
  \definition Class: \Set := H.Cohomology;
  \definition space: Modules.Space Class := H.cohomologySpace;
}
\module Cup(p, n: N.Nat^) {
  \import \root.RelativeAction[A := Carrier, source := topology, subset := boundary, K := K, ring := ring].Degree[p := p, q := n] \as Action;
  \definition Domain: \Set := Action.Domain;
  \definition Range: \Set := Action.Range;
  \definition Factor: \Set := Action.Factor;
  \definition sourceSpace: Modules.Space Domain := Action.ringDomainSpace;
  \definition targetSpace: Modules.Space Range := Action.ringRangeSpace;
  \definition map[u: Factor]: _ := Action.ringMap u;
  \module With(u: Factor) {
    \definition Iso: \Set := Modules.Isomorphism[V := Domain, W := Range, source := sourceSpace, target := targetSpace].Isomorphism;
    \definition Bijective: \Prop := Action.On[u := u].Bijective;
    \definition isomorphism[b: Bijective]: Iso := Action.On[u := u].isomorphism b;
  }
}
