\import \root.RelativeAction[A := Domain.Carrier, source := Domain.topology, subset := Domain.boundary, K := K, ring := ring].Degree[p := p, q := n] \as Action;
\import Action.On[u := thomClass] \as Cup;
\import Modules.Hom[V := Action.Domain, W := Action.Range, source := Action.ringDomainSpace, target := Action.ringRangeSpace] \as Maps;
\definition sourceZero: \forall (a: Action.Domain) -> a = Action.ringDomainSpace.zero := SourceFull.With[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat p].cohomologyZero;
\definition targetZero: \forall (a: Action.Range) -> a = Action.ringRangeSpace.zero := TargetFull.With[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat Action.total].cohomologyZero;
\definition bijective: Cup.Bijective := Cup.Bijective {
  injective := \fun (a, b: Action.Domain)(same: _) => trans!{Action.Domain} _ _ _ (sourceZero a) (sym!{Action.Domain} _ _ (sourceZero b)),
  onto := \fun (b: Action.Range) => std.Logic[].Proposition[].existsIntro[Action.Domain, { a: Action.Domain \where Action.apply thomClass a = b }] Action.ringDomainSpace.zero
    (trans!{Action.Range} _ _ _ (Maps.zeroPreserved (Action.ringMap thomClass)) (sym!{Action.Range} _ _ (targetZero b)))
};
\definition isomorphism: Domain.Ring[K := K, ring := ring].Cup[p := p, n := n].With[u := thomClass].Iso := Cup.isomorphism bijective;
