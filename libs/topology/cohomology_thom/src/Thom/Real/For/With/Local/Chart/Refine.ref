\import Geometry.Restrict[U := U, open := open, contained := contained] \as Restriction;
\import Local.Chart[c := c] \as OldChart;
\import Local.Chart[c := Restriction.chart] \as NewChart;
\definition originalPoint[x: \Cast[X] U]: Geometry.BasePoint := \into[X](x, c.domain) \by { contained x (\bysub(X, U, x)) };
\module Rank(n: N.Nat^, same: c.dimension = n);
