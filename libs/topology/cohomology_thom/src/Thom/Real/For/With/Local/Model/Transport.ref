\import \root.RelativePullback[].On[A := Domain.Carrier, source := Domain.topology, subset := Domain.boundary, R := K, ring := ring].To[B := Domain.Carrier, target := Domain.topology, part := Domain.boundary].Homeomorphism[data := homeomorphism] \as Pull;
\import \root.RelativeAction[A := Domain.Carrier, source := Domain.topology, subset := Domain.boundary, K := K, ring := ring].Homeomorphism[B := Domain.Carrier, target := Domain.topology, part := Domain.boundary, data := homeomorphism] \as Action;
\definition thomClass: Top.Class := Pull.Degree[n := n].isomorphism.forward.apply model.thomClass;
\definition isomorphism[p: N.Nat^]: Theory.Cup[p := p, n := n].With[u := thomClass].Iso := Action.Degree[p := p, q := n].isomorphism model.thomClass (model.isomorphism p) (model.formula p);
\module Negative(k: N.Nat^);
\definition data: Data := Data {
  thomClass := thomClass, isomorphism := isomorphism,
  formula := \fun (p: N.Nat^)(a: Theory.Cup[p := p, n := n].Domain) => \refl((Theory.Cup[p := p, n := n].map thomClass).apply a),
  below := \fun (k: N.Nat^) => Negative[k := k].zero
};
