\import singular_cohomology.Maps[A := NewDisk.DiskBundle, B := Disk.DiskBundle, source := NewDisk.diskTopology, target := Disk.diskTopology]
  .Composition[C := X, final := bundle.baseSpace].Coefficients[M := OldBase.integerCoefficients] \as First;
\import singular_cohomology.Maps[A := NewDisk.DiskBundle, B := Y, source := NewDisk.diskTopology, target := source]
  .Composition[C := X, final := bundle.baseSpace].Coefficients[M := OldBase.integerCoefficients] \as Second;
\definition projection: \forall (a: OldBase.Cohomology[].Group p) ->
  TotalPull.apply p map continuous (OldProjection.apply p Disk.diskProjection Disk.diskProjectionContinuous a) =
  NewProjection.apply p NewDisk.diskProjection NewDisk.diskProjectionContinuous (BasePull.apply p f regular a) :=
  \fun (a: OldBase.Cohomology[].Group p) => trans!{{NewTotal.Cohomology[].Group p}} _ _ _
    (sym!{{NewTotal.Cohomology[].Group p}} _ _ (First.onCohomology map continuous Disk.diskProjection Disk.diskProjectionContinuous p a))
    (Second.onCohomology NewDisk.diskProjection NewDisk.diskProjectionContinuous f regular p a);
\definition law: \forall (a: OldBase.Cohomology[].Group p)(u: Original.Degree[n := n].Class) ->
  \parent.Degree[n := N.Basic[].Def[].add p n].pull (Original.Product[p := p, n := n].apply a u) =
  Pulled.Product[p := p, n := n].apply (BasePull.apply p f regular a) (\parent.Degree[n := n].pull u) :=
  \fun (a: OldBase.Cohomology[].Group p)(u: Original.Degree[n := n].Class) => trans!{{Pulled.Degree[n := N.Basic[].Def[].add p n].Class}} _ _ _
    (Relative.Cup[p := p, q := n].Cohomology[].naturality (OldProjection.apply p Disk.diskProjection Disk.diskProjectionContinuous a) u)
    (congr!{{NewTotal.Cohomology[].Group p} {Pulled.Degree[n := N.Basic[].Def[].add p n].Class}}
      (\fun (b: NewTotal.Cohomology[].Group p) => singular_cap.CochainPair[A := NewDisk.DiskBundle, source := NewDisk.diskTopology, subset := NewDisk.Boundary, R := R, ring := ring].Cohomology[p := p, q := n].Right[].apply b (\parent.Degree[n := n].pull u)) _ _ (projection a));
