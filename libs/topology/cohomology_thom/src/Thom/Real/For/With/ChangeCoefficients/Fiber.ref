\import \parent.\parent.Fiber[x := x] \as Fiber;
\import singular_cohomology.Relative[A := Fiber.Carrier, source := Fiber.topology, subset := Fiber.boundary] \as FiberPair;
\import FiberPair.Maps[B := Disk.DiskBundle].Over[target := Disk.diskTopology, targetSubset := Disk.Boundary].On[f := Fiber.pairInclusion].Integer[] \as Inclusion;
\import \root.CoefficientChange[].On[C := FiberPair.complex, M := M, N := N, u := u] \as FiberChange;
\import Change.Along[D := FiberPair.complex, f := Inclusion.map].At[z := z] \as Natural;
\import Fiber.Additive[coefficients := M, z := z] \as Source;
\import Fiber.Additive[coefficients := N, z := z] \as Target;
\import \parent.Degree[z := z] \as Whole;
\definition map: IntegerModules.Hom[V := Source.Class, W := Target.Class, source := Source.space, target := Target.space].Map := FiberChange.At[z := z].map;
\import \parent.\parent.Additive[coefficients := M].Degree[z := z] \as TotalSource;
\definition law: \forall (q: TotalSource.Class) -> map.apply (Source.restriction.apply q) = Target.restriction.apply (Whole.map.apply q) := Natural.law;
