\import Bundles.Family[X := X, F := F] \as Family;
\import topology.Topology[Carrier := Family.Point].Subspace[S := Disk.UnitSphere].Inside[U := Disk.ClosedBall] \as Nested;
\definition included: topology.Topology[Carrier := Family.Point].Subset Disk.UnitSphere Disk.ClosedBall :=
  \fun (p: Family.Point)(inside: topology.Topology[Carrier := Family.Point].Member Disk.UnitSphere p) =>
    \bysub(Family.Point, Disk.ClosedBall, Disk.sphereInclusion (\into[Family.Point](p, Disk.UnitSphere) \by { inside }));
\definition homeomorphism: _ := Nested.homeomorphism bundle.totalSpace included;
\definition equivalence: _ := algebraic_topology.HomotopyEquivalence[A := Disk.SphereBundle, B := Boundary.CarrierSet].fromHomeomorphism Disk.sphereTopology (Boundary.topology Disk.diskTopology) homeomorphism;
\import singular_cohomology.Equivalence[A := Disk.SphereBundle, B := Boundary.CarrierSet, source := Disk.sphereTopology, target := Boundary.topology Disk.diskTopology].Integer[e := equivalence].With[coefficients := BaseProduct.integerCoefficients] \as Comparison;
\import singular_cohomology.Cochains[A := Disk.SphereBundle, source := Disk.sphereTopology].With[coefficients := BaseProduct.integerCoefficients].Integer[] \as Groups;
\definition group[z: I.Int^]: IntegerModules.Bundle := IntegerModules.Bundle { Carrier := Groups.cohomology z, space := Groups.cohomologySpace z };
\definition isomorphism[z: I.Int^]: IntegerModules.Isomorphism[V := (boundary z).Carrier, W := (group z).Carrier, source := (boundary z).space, target := (group z).space].Isomorphism :=
  IntegerModules.Isomorphism[V := (group z).Carrier, W := (boundary z).Carrier, source := (group z).space, target := (boundary z).space].Inverse[].inverse Comparison.At[z := z].isomorphism;
