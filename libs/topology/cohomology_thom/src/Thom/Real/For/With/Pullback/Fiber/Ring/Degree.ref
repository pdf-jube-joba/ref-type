\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Pullback[Y := Y, source := source, f := f, regular := regular].Ring[R := K, ring := ring] \as Whole;
\import singular_products.Cochains[A := X, source := bundle.baseSpace, R := K, ring := ring] \as Coefficients;
\definition map: _ := Pull.Degree[n := n].map;
\import singular_cohomology.Relative[A := New.Carrier, source := New.topology, subset := New.boundary].Maps[B := NewDisk.DiskBundle].Over[target := NewDisk.diskTopology, targetSubset := NewDisk.Boundary].Composition[C := Disk.DiskBundle].Over[final := Disk.diskTopology, finalSubset := Disk.Boundary] \as First;
\import Maps.Composition[C := Disk.DiskBundle].Over[final := Disk.diskTopology, finalSubset := Disk.Boundary] \as Second;
\import singular_cohomology.Relative[A := New.Carrier, source := New.topology, subset := New.boundary].Maps[B := Disk.DiskBundle].Over[target := Disk.diskTopology, targetSubset := Disk.Boundary] \as Direct;
\definition same: First.compose New.pairInclusion BundleMap.pairMap = Second.compose pairMap Old.pairInclusion := \refl(First.compose New.pairInclusion BundleMap.pairMap);
\definition direct[m: Direct.Map]: _ := Direct.On[f := m].Integer[].With[coefficients := Coefficients.integerCoefficients].At[z := I.Int^::ofNat n].induced;
\definition law: \forall (u: \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Coefficients[R := K, ring := ring].Degree[n := n].Class) ->
  New.Additive[coefficients := Coefficients.integerCoefficients, z := I.Int^::ofNat n].restriction.apply (Whole.Degree[n := n].pull u) = map.apply (Old.Additive[coefficients := Coefficients.integerCoefficients, z := I.Int^::ofNat n].restriction.apply u) :=
  \fun (u: \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Coefficients[R := K, ring := ring].Degree[n := n].Class) => trans!{{New.Additive[coefficients := Coefficients.integerCoefficients, z := I.Int^::ofNat n].Class}} _ _ _
    (sym!{{New.Additive[coefficients := Coefficients.integerCoefficients, z := I.Int^::ofNat n].Class}} _ _ (First.On[f := New.pairInclusion, g := BundleMap.pairMap].With[coefficients := Coefficients.integerCoefficients].law (I.Int^::ofNat n) u))
    (trans!{{New.Additive[coefficients := Coefficients.integerCoefficients, z := I.Int^::ofNat n].Class}} _ _ _
      (congr!{Direct.Map {New.Additive[coefficients := Coefficients.integerCoefficients, z := I.Int^::ofNat n].Class}} (\fun (m: Direct.Map) => (direct m).apply u) _ _ same)
      (Second.On[f := pairMap, g := Old.pairInclusion].With[coefficients := Coefficients.integerCoefficients].law (I.Int^::ofNat n) u));
