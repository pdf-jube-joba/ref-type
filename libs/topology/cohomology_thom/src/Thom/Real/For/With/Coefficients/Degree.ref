\import Complexes.At[C := Relative.complex, z := I.Int^::ofNat n] \as Theory;
\definition Class: \Set := Theory.Cohomology;
\definition space: Modules.Space Class := Theory.cohomologySpace;
\import Pair.Comparison[n := n].Cohomology[] \as Forget;
\import Base.Cohomology[] \as BaseTheory;
\definition zeroSection: Modules.Hom[V := Class, W := BaseTheory.Group n, source := space, target := BaseTheory.moduleSpace n].Map :=
  Modules.Hom[V := Total.Cohomology[].Group n, W := BaseTheory.Group n,
    source := Total.Cohomology[].moduleSpace n, target := BaseTheory.moduleSpace n].Composition[U := Class, domain := space].compose
    (Section.At[n := n].linear Disk.zeroSection Disk.zeroSectionContinuous) Forget.map;
\definition euler[u: Class]: BaseTheory.Group n := zeroSection.apply u;
\definition eulerAdd: \forall (u, v: Class) -> euler (space.add u v) = (BaseTheory.moduleSpace n).add (euler u) (euler v) := zeroSection.addition;
\definition eulerScale: \forall (a: R)(u: Class) -> euler (space.smul a u) = (BaseTheory.moduleSpace n).smul a (euler u) := zeroSection.scalar;
