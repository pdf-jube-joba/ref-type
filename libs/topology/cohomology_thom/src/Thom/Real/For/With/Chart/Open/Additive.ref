\import \parent.\parent.Additive[coefficients := coefficients] \as Metric;
\definition preceding: I.Int^ := chain_complexes.Integer[].previous (I.Int^::ofNat c.dimension);
\import singular_cohomology.Relative[A := Carrier, source := topology, subset := boundary].With[coefficients := coefficients].At[z := preceding] \as Domain;
\import singular_cohomology.Relative[A := NewDisk.DiskBundle, source := NewDisk.diskTopology, subset := NewDisk.Boundary].With[coefficients := coefficients].At[z := preceding] \as Target;
\definition below: \forall (u: Domain.Carrier) -> u = Domain.space.zero :=
  IntegerModules.Isomorphism[V := Domain.Carrier, W := Target.Carrier, source := Domain.space, target := Target.space].Vanishing[].sourceZero
    (Pairs.With[coefficients := coefficients].At[z := preceding].isomorphism pair) Metric.below;

