\import \root.LocalDisk[].On[X := BasePoint, source := baseTopology].With[coefficients := coefficients] \as StandardTheory;
\module At(z: I.Int^) {
  \definition isomorphism: _ := Pairs.With[coefficients := coefficients].At[z := z].isomorphism pair;
}
\definition preceding: I.Int^ := chain_complexes.Integer[].previous (I.Int^::ofNat c.dimension);
\import singular_cohomology.Relative[A := Standard.DiskCarrier, source := Standard.diskTopology, subset := Standard.boundary].With[coefficients := coefficients] \as StandardRelative;
\import singular_cohomology.Relative[A := NewDisk.DiskBundle, source := NewDisk.diskTopology, subset := NewDisk.Boundary].With[coefficients := coefficients].At[z := preceding] \as LocalRelative;
\definition standardZero: \forall (u: StandardRelative.At[z := preceding].Carrier) -> u = StandardRelative.At[z := preceding].space.zero :=
  \idelim \root.LocalDisk[].shift c.dimension (I.Int^::negSucc N.Nat^::zero) = preceding
    \with z: I.Int^ => \forall (u: StandardRelative.At[z := z].Carrier) -> u = StandardRelative.At[z := z].space.zero
    \by { base: StandardTheory.Negative[n := c.dimension, k := N.Nat^::zero].zero, equality: \root.LocalDisk[].shiftPrevious c.dimension };
\definition below: \forall (u: LocalRelative.Carrier) -> u = LocalRelative.space.zero :=
  IntegerModules.Isomorphism[V := StandardRelative.At[z := preceding].Carrier, W := LocalRelative.Carrier, source := StandardRelative.At[z := preceding].space, target := LocalRelative.space].Vanishing[].targetZero At[z := preceding].isomorphism standardZero;
