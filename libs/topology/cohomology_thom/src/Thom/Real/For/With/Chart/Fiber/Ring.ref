\import module_theory.Module[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as RingModules;
\import \root.LocalDisk[].Point[K := K, ring := ring].Rank[n := c.dimension] \as PointClass;
\import \root.RelativePullback[].On[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary, R := K, ring := ring].To[B := PointDisk.DiskCarrier, target := PointDisk.diskTopology, part := PointDisk.boundary].Homeomorphism[data := fiberPair] \as Comparison;
\import singular_cohomology.Relative[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary].OverRing[R := K, ring := ring].With[coefficients := singular_products.Cochains[A := Point.Carrier, source := Point.topology, R := K, ring := ring].coefficients] \as Relative;
\import chain_complexes.Integer[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring].At[C := Relative.complex, z := I.Int^::ofNat c.dimension] \as H;
\definition Class: \Set := H.Cohomology;
\definition space: RingModules.Space Class := H.cohomologySpace;
\definition isomorphism: RingModules.Isomorphism[V := K, W := Class, source := RingModules.scalarModule, target := space].Isomorphism :=
  RingModules.Isomorphism[V := K, W := PointClass.Class, source := RingModules.scalarModule, target := PointClass.space].Composition[U := Class, final := space].compose Comparison.Degree[n := c.dimension].isomorphism PointClass.isomorphism;
\definition generator: Class := Comparison.Degree[n := c.dimension].isomorphism.forward.apply PointClass.generator;
\definition normalized: isomorphism.forward.apply ring.base.one = generator :=
  congr!{PointClass.Class Class} Comparison.Degree[n := c.dimension].isomorphism.forward.apply _ _ PointClass.normalized;
\definition Generator[u: Class]: \Prop := \exists ( e: RingModules.Isomorphism[V := K, W := Class, source := RingModules.scalarModule, target := space].Isomorphism \where e.forward.apply ring.base.one = u );
\definition canonicalGenerator: Generator generator := std.Logic[].Proposition[].existsIntro[
  RingModules.Isomorphism[V := K, W := Class, source := RingModules.scalarModule, target := space].Isomorphism,
  { e: RingModules.Isomorphism[V := K, W := Class, source := RingModules.scalarModule, target := space].Isomorphism \where e.forward.apply ring.base.one = generator }] isomorphism normalized;

\module Normalization;

\definition pointComparison: _ := Comparison.Degree[n := c.dimension].isomorphism;
