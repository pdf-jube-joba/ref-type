\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Domain[U := V] \as Other;
\definition map[p: Other.Carrier]: Carrier := \into[Disk.DiskBundle](p, domain) \by { contained (Disk.diskProjection p) (\bysub(Disk.DiskBundle, Other.domain, p)) };
\definition continuous: topology.Continuity[A := Other.Carrier, B := Carrier].Continuous Other.topology topology map :=
  topology.Continuity[A := Other.Carrier, B := Disk.DiskBundle].Corestriction[S := domain].corestrictContinuous Other.topology Disk.diskTopology map Other.continuous;
\import singular_cohomology.Relative[A := Other.Carrier, source := Other.topology, subset := Other.boundary].Maps[B := Carrier].Over[target := topology, targetSubset := boundary] \as Maps;
\definition pairMap: Maps.Map := \into[Other.Carrier -> Carrier](map, Maps.Map) \by {
  Maps.Laws[map] { continuous := continuous, contained := \fun (p: \Cast[Other.Carrier] Other.boundary) => \bysub(Other.Carrier, Other.boundary, p) }
};
\module Ring(K: \Set, ring: std.Alg[].Ring[].CommutativeRing[K]) {
  \import \root.RelativePullback[].On[A := Other.Carrier, source := Other.topology, subset := Other.boundary, R := K, ring := ring].To[B := Carrier, target := topology, part := boundary].Along[f := pairMap] \as Pull;
  \module Degree(n: N.Nat^) { \definition restriction: _ := Pull.Degree[n := n].map; }
  \module Product(p, n: N.Nat^) {
    \definition law: _ := Pull.Cup[p := p, q := n].Cohomology[].naturality;
  }
}

\module Fiber(x: Other.BasePoint);
