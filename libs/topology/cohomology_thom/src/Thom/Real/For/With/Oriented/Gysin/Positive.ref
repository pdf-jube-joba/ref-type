\use std.Logic[].Equality[].eq_reason_in;
\definition z: I.Int^ := I.Int^::ofNat p;
\definition sum: N.Nat^ := N.Basic[].Def[].add p n;
\definition d: I.Int^ := \root.LocalDisk[].shift n z;
\definition naturalDegree: I.Int^ := I.Int^::ofNat sum;
\definition same: naturalDegree = d := sym!{I.Int^} _ _ (\root.LocalDisk[].shiftNatural n p);
\import \parent.Degree[z := z] \as Row;
\import Raw.Natural[t := sum] \as Compare;
\import \parent.\parent.Degree[p := p] \as OrdinaryThom;
\import Thom.Positive[p := p] \as IntegerThom;
\import std.Logic[].Equality[].Transport[A := I.Int^] \as Cast;
\definition ordinary[a: (base z).Carrier]: BaseProduct.Cohomology[].Group p := Base.At[n := p].isomorphism.forward.apply a;
\definition product[a: (base z).Carrier]: BaseProduct.Cohomology[].Group sum := BaseProduct.Cohomology[].Cup[p := p, q := n].apply (ordinary a) euler;
\definition value[a: (base z).Carrier]: (base naturalDegree).Carrier := Base.At[n := sum].isomorphism.backward.apply (product a);
\definition naturalLaw: \forall (a: (base z).Carrier) -> (zeroSectionAt naturalDegree).apply (IntegerThom.natural.forward.apply (ordinary a)) = value a :=
  \fun (a: (base z).Carrier) => eq_reason_in!{{(base naturalDegree).Carrier} _
    "=" _ "by" { sym!{{(base naturalDegree).Carrier}} _ _ (Base.At[n := sum].isomorphism.leftInverse ((zeroSectionAt naturalDegree).apply (IntegerThom.natural.forward.apply (ordinary a)))) }
    "=" _ "by" { congr!{{BaseProduct.Cohomology[].Group sum} {(base naturalDegree).Carrier}} Base.At[n := sum].isomorphism.backward.apply _ _ (Compare.law (IntegerThom.natural.forward.apply (ordinary a))) }
    "=" _ "by" { congr!{{BaseProduct.Cohomology[].Group sum} {(base naturalDegree).Carrier}} Base.At[n := sum].isomorphism.backward.apply _ _ (OrdinaryThom.zeroSection (ordinary a)) }
  };
\definition law: \forall (a: (base z).Carrier) -> Row.cupEuler.apply a = Cast.cast Base.cohomology naturalDegree d same (value a) :=
  \fun (a: (base z).Carrier) => eq_reason_in!{{(base d).Carrier} _
    "=" _ "by" { sym!{{(base d).Carrier}} _ _ (Cast.natural (\fun (k: I.Int^) => (relative k).Carrier) Base.cohomology (\fun (k: I.Int^) => (zeroSectionAt k).apply) naturalDegree d same (IntegerThom.natural.forward.apply (ordinary a))) }
    "=" _ "by" { congr!{{(base naturalDegree).Carrier} {(base d).Carrier}} (Cast.cast Base.cohomology naturalDegree d same) _ _ (naturalLaw a) }
  };
