\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Oriented[K := Two.Carrier, ring := Two.commutativeRing, n := n, orientation := given, complex := complex] \as Oriented;
\definition fiberLaw: \forall (x: X) -> given.fiber x = fiber x :=
  \fun (x: X) => \parent.Fiber[x := x].unique
    (\into[Rank.FiberClass x](given.fiber x, Generators x) \by { Orientations.generates given x }) (generator x);
\definition classLaw: Oriented.class = class := uniqueNormalized Oriented.class
  (\fun (x: X) => trans!{{Rank.FiberClass x}} _ _ _ (Oriented.normalized x) (fiberLaw x));
\definition eulerLaw: Oriented.euler = euler :=
  congr!{{\root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Coefficients[R := Two.Carrier, ring := Two.commutativeRing].Degree[n := n].Class}
    {singular_products.Cochains[A := X, source := bundle.baseSpace, R := Two.Carrier, ring := Two.commutativeRing].Cohomology[].Group n}}
    \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Coefficients[R := Two.Carrier, ring := Two.commutativeRing].Degree[n := n].zeroSection.apply _ _ classLaw;
