\definition z: I.Int^ := I.Int^::negSucc k;
\definition d: I.Int^ := \root.LocalDisk[].shift n z;
\import \parent.Degree[z := z] \as Row;
\definition law: \forall (a: (base z).Carrier) -> Row.cupEuler.apply a = (base d).space.zero :=
  \fun (a: (base z).Carrier) => trans!{{(base d).Carrier}} _ _ _
    (congr!{{(base z).Carrier} {(base d).Carrier}} Row.cupEuler.apply _ _ (Thom.Negative[k := k].sourceZero a))
    (IntegerModules.Hom[V := (base z).Carrier, W := (base d).Carrier, source := (base z).space, target := (base d).space].zeroPreserved Row.cupEuler);
