\import topology.Topology[Carrier := X] \as Base;
\definition join: \Pow X := Base.Finite[].Join U V;
\definition meet: \Pow X := Base.Intersection U V;
\definition openJoin: Base.IsOpenIn bundle.baseSpace join := Base.Finite[].joinOpen bundle.baseSpace U V openU openV;
\definition openMeet: Base.IsOpenIn bundle.baseSpace meet := (Base.topologyLaws bundle.baseSpace).intersectionOpen U V openU openV;
\definition leftInJoin: Base.Subset U join := \fun (x: X)(member: Base.Member U x) => std.Logic[].Proposition[].Or[_, _]::left member;
\definition rightInJoin: Base.Subset V join := \fun (x: X)(member: Base.Member V x) => std.Logic[].Proposition[].Or[_, _]::right member;
\definition meetInLeft: Base.Subset meet U := \fun (x: X)(member: Base.Member meet x) => member.left;
\definition meetInRight: Base.Subset meet V := \fun (x: X)(member: Base.Member meet x) => member.right;
\import Geometry.Domain[U := U] \as LeftDomain;
\import Geometry.Domain[U := V] \as RightDomain;
\import Geometry.Domain[U := join] \as WholeDomain;
\import Geometry.Domain[U := meet] \as OverlapDomain;
\import WholeDomain.Along[V := U, contained := leftInJoin] \as RestrictLeft;
\import WholeDomain.Along[V := V, contained := rightInJoin] \as RestrictRight;
\import LeftDomain.Along[V := meet, contained := meetInLeft] \as OverlapLeft;
\import RightDomain.Along[V := meet, contained := meetInRight] \as OverlapRight;
\import Local.Rank[n := n].On[U := U] \as Left;
\import Local.Rank[n := n].On[U := V] \as Right;
\import Local.Rank[n := n].On[U := join] \as Whole;
\import Local.Rank[n := n].On[U := meet] \as Overlap;
\import \root.RelativeMayerVietoris[].Union[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary,
  U := LeftDomain.domain, V := RightDomain.domain, openU := LeftDomain.open openU, openV := RightDomain.open openV] \as Cover;
\import \root.RelativeMayerVietoris[].OpenCover[A := WholeDomain.Carrier, source := WholeDomain.topology, subset := WholeDomain.boundary].On[cover := Cover.cover] \as MV;
\import MV.Cohomology[coefficients := BaseProduct.integerCoefficients] \as Sequence;
\import Cover.With[coefficients := BaseProduct.integerCoefficients] \as Comparison;
\import \root.RelativePullback[].On[A := LeftDomain.Carrier, source := LeftDomain.topology, subset := LeftDomain.boundary, R := K, ring := ring].To[B := MV.Left, target := MV.leftTopology, part := MV.leftPart].Homeomorphism[data := Cover.leftPair] \as LeftComparison;
\import \root.RelativePullback[].On[A := RightDomain.Carrier, source := RightDomain.topology, subset := RightDomain.boundary, R := K, ring := ring].To[B := MV.Right, target := MV.rightTopology, part := MV.rightPart].Homeomorphism[data := Cover.rightPair] \as RightComparison;
\import \root.RelativePullback[].On[A := OverlapDomain.Carrier, source := OverlapDomain.topology, subset := OverlapDomain.boundary, R := K, ring := ring].To[B := MV.Overlap, target := MV.overlapTopology, part := MV.overlapPart].Homeomorphism[data := Cover.overlapPair] \as OverlapComparison;
\import \root.RelativeAction[A := LeftDomain.Carrier, source := LeftDomain.topology, subset := LeftDomain.boundary, K := K, ring := ring].Homeomorphism[B := MV.Left, target := MV.leftTopology, part := MV.leftPart, data := LeftComparison.inverseData] \as LeftAction;
\import \root.RelativeAction[A := RightDomain.Carrier, source := RightDomain.topology, subset := RightDomain.boundary, K := K, ring := ring].Homeomorphism[B := MV.Right, target := MV.rightTopology, part := MV.rightPart, data := RightComparison.inverseData] \as RightAction;
\import \root.RelativeAction[A := OverlapDomain.Carrier, source := OverlapDomain.topology, subset := OverlapDomain.boundary, K := K, ring := ring].Homeomorphism[B := MV.Overlap, target := MV.overlapTopology, part := MV.overlapPart, data := OverlapComparison.inverseData] \as OverlapAction;
\module With(g: Fibers, left: Left.Given[g := g].Data, right: Right.Given[g := g].Data, overlap: Overlap.Given[g := g].Data);
