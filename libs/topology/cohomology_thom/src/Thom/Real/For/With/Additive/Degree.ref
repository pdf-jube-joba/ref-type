\import Relative.With[coefficients := coefficients].At[z := z] \as RelativeTheory;
\definition Class: \Set := RelativeTheory.Carrier;
\definition space: IntegerModules.Space Class := RelativeTheory.space;
\import Disk.ThomPair[].Collar[].Cohomology[coefficients := coefficients, z := z] \as Quotient;
\definition thomComparison: _ := Quotient.ordinaryIsomorphism;
\import singular_cohomology.Equivalence[A := Disk.DiskBundle, B := X, source := Disk.diskTopology, target := bundle.baseSpace]
  .Integer[e := Disk.Contraction[].equivalence].With[coefficients := coefficients].At[z := z] \as DiskComparison;
\definition diskComparison: _ := DiskComparison.isomorphism;
\import Relative.With[coefficients := coefficients].PairSequence[].LongExact[z := z] \as Sequence;
\definition connecting: _ := Sequence.connecting;
\definition exactAtSphere: _ := Sequence.exactAtSubspace;
\definition exactAtDisk: _ := Sequence.exactAtSpace;
\definition exactAtRelative: _ := Sequence.exactAtRelative;
\import Relative.With[coefficients := coefficients] \as PairGroups;
\import PairGroups.PairSequence[] \as PairSequence;
\import singular_cohomology.Cochains[A := Disk.DiskBundle, source := Disk.diskTopology].With[coefficients := coefficients].Integer[] \as Whole;
\import topology.Topology[Carrier := Disk.DiskBundle].Subspace[S := Disk.Boundary] \as Boundary;
\import singular_cohomology.Cochains[A := Boundary.CarrierSet, source := Boundary.topology Disk.diskTopology].With[coefficients := coefficients].Integer[] \as SphereGroups;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := IntegerRing.ring] \as Complexes;
\import Complexes.Map[C := PairGroups.complex, D := Whole.complex].At[k := z] \as Forget;
\import Complexes.Map[C := Whole.complex, D := SphereGroups.complex].At[k := z] \as Restrict;
\definition forget: _ := Forget.induced PairSequence.inclusion;
\definition forgetCycles: _ := Forget.cyclesMap PairSequence.inclusion;
\definition forgetOnClass: _ := Forget.onClass PairSequence.inclusion;
\definition sphereRestriction: _ := Restrict.induced PairSequence.restriction;
