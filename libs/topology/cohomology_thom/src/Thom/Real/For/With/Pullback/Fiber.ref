\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Pullback[Y := Y, source := source, f := f, regular := regular] \as BundleMap;
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Fiber[x := f y] \as Old;
\import \root.Thom[].Real[].For[X := Y, F := (\fun (y: Y) => F (f y)), bundle := pulledBundle].With[metric := pulledMetric].Fiber[x := y] \as New;
\definition map[p: New.Carrier]: Old.Carrier := \into[Disk.DiskBundle](BundleMap.map p, Old.subset) \by {
  congr!{Y X} f _ _ (\bysub(NewDisk.DiskBundle, New.subset, p))
};
\definition continuous: topology.Continuity[A := New.Carrier, B := Old.Carrier].Continuous New.topology Old.topology map :=
  topology.Continuity[A := New.Carrier, B := Disk.DiskBundle].Corestriction[S := Old.subset].corestrictContinuous New.topology Disk.diskTopology map
    (topology.Composition[A := New.Carrier, B := NewDisk.DiskBundle, C := Disk.DiskBundle].composeContinuous New.topology NewDisk.diskTopology Disk.diskTopology New.inclusion BundleMap.map New.continuous BundleMap.continuous);
\import singular_cohomology.Relative[A := New.Carrier, source := New.topology, subset := New.boundary].Maps[B := Old.Carrier].Over[target := Old.topology, targetSubset := Old.boundary] \as Maps;
\definition pairMap: Maps.Map := \into[New.Carrier -> Old.Carrier](map, Maps.Map) \by {
  Maps.Laws[map] {
    continuous := continuous,
    contained := \fun (p: \Cast[New.Carrier] New.boundary) => \bysub(New.Carrier, New.boundary, p)
  }
};
\module Ring(K: \Set, ring: Rings.CommutativeRing[K]);
