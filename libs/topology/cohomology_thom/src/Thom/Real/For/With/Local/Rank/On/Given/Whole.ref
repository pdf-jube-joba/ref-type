\import Geometry.Coefficients[R := K, ring := ring].Degree[n := n] \as Original;
\import Domain.Additive[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n] \as Restricted;
\definition restriction[u: Original.Class]: Class := Restricted.restriction.apply u;
\definition normalized: \forall (u: Original.Class) ->
  (\forall (x: X) -> Geometry.Fiber[x := x].Additive[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].restriction.apply u = g x) -> Normalized (restriction u) :=
  \fun (u: Original.Class)(normal: _)(x: Domain.BasePoint) => trans!{{FiberClass x}} _ _ _
    (Domain.Fiber[x := x].With[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].law u) (normal x);
\definition law: \forall (data: Data)(u: Original.Class) ->
  (\forall (x: X) -> Geometry.Fiber[x := x].Additive[coefficients := BaseProduct.integerCoefficients, z := I.Int^::ofNat n].restriction.apply u = g x) -> restriction u = data.model.thomClass :=
  \fun (data: Data)(u: Original.Class)(normal: _) => data.detected (restriction u) data.model.thomClass
    (\fun (x: Domain.BasePoint) => trans!{{FiberClass x}} _ _ _ (normalized u normal x) (sym!{{FiberClass x}} _ _ (data.normalized x)));
