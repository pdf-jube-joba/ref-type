\definition degree: I.Int^ := \root.LocalDisk[].shift c.dimension (I.Int^::negSucc k);
\import singular_cohomology.Relative[A := Carrier, source := topology, subset := boundary].With[coefficients := coefficients].At[z := degree] \as Input;
\import singular_cohomology.Relative[A := NewDisk.DiskBundle, source := NewDisk.diskTopology, subset := NewDisk.Boundary].With[coefficients := coefficients].At[z := degree] \as Output;
\definition zero: \forall (u: Input.Carrier) -> u = Input.space.zero :=
  IntegerModules.Isomorphism[V := Input.Carrier, W := Output.Carrier, source := Input.space, target := Output.space].Vanishing[].sourceZero
    (Pairs.With[coefficients := coefficients].At[z := degree].isomorphism pair) Metric.Negative[k := k].zero;
