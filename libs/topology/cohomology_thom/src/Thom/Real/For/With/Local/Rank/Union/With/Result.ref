\import \parent.Class[] \as Glued;
\import \parent.Detection[] \as Detection;
\import \parent.Isomorphism[] \as Cup;
\import Local.Model[n := n, U := join] \as Model;
\definition model: Model.Data := Model.Data {
  thomClass := Glued.class,
  isomorphism := \fun (p: N.Nat^) => Cup.Degree[p := p].isomorphism,
  formula := \fun (p: N.Nat^)(a: WholeDomain.Ring[K := K, ring := ring].Cup[p := p, n := n].Domain) => \refl((WholeDomain.Ring[K := K, ring := ring].Cup[p := p, n := n].map Glued.class).apply a),
  below := \fun (k: N.Nat^) => \parent.Below[k := k].whole
};
\definition data: Whole.Given[g := g].Data := Whole.Given[g := g].Data { model := model, normalized := Glued.normalized, detected := Detection.detected };
