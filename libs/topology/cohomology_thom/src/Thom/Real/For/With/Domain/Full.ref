\definition backward[p: Disk.DiskBundle]: Carrier := \into[Disk.DiskBundle](p, domain) \by { everywhere (Disk.diskProjection p) };
\definition backwardContinuous: topology.Continuity[A := Disk.DiskBundle, B := Carrier].Continuous Disk.diskTopology topology backward :=
  topology.Continuity[A := Disk.DiskBundle, B := Disk.DiskBundle].Corestriction[S := domain].corestrictContinuous Disk.diskTopology Disk.diskTopology backward
    (topology.Maps[A := Disk.DiskBundle, B := Disk.DiskBundle].Identity[].continuous Disk.diskTopology);
\definition homeomorphism: topology.Homeomorphism[A := Carrier, B := Disk.DiskBundle].Homeomorphism[topology, Disk.diskTopology] :=
  topology.Homeomorphism[A := Carrier, B := Disk.DiskBundle].Homeomorphism[topology, Disk.diskTopology] {
    forward := inclusion, backward := backward,
    forwardContinuous := continuous, backwardContinuous := backwardContinuous,
    leftInverse := \fun (p: Carrier) => \refl(p), rightInverse := \fun (p: Disk.DiskBundle) => \refl(p)
  };
\import Pair.Homeomorphism[B := Disk.DiskBundle].Over[target := Disk.diskTopology, targetSubset := Disk.Boundary] \as Pairs;
\definition pair: Pairs.Data := Pairs.Data {
  homeomorphism := homeomorphism,
  forwardPreserves := \fun (p: \Cast[Carrier] boundary) => \bysub(Carrier, boundary, p),
  backwardPreserves := \fun (p: \Cast[Disk.DiskBundle] Disk.Boundary) => \bysub(Disk.DiskBundle, Disk.Boundary, p)
};
\module Ring(K: \Set, ring: std.Alg[].Ring[].CommutativeRing[K]);
\module Fiber(x: X);
