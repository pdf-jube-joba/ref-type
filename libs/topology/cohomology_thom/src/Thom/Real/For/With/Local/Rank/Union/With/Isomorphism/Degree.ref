\import \parent.Cycles[] \as Cycles;
\import Multiplication.Degree[p := p, q := n] \as Product;
\definition bijective: Product.On[u := Glued.class].Bijective :=
  H.classInduction (\fun (u: H.Cohomology) => u = Glued.class -> Product.On[u := u].Bijective)
    (\fun (u: H.Closed) => Cycles.bijective p u) Glued.class (\refl(Glued.class));
\definition isomorphism: WholeDomain.Ring[K := K, ring := ring].Cup[p := p, n := n].With[u := Glued.class].Iso := Product.On[u := Glued.class].isomorphism bijective;
