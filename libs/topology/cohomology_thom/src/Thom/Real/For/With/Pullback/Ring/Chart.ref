\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric] \as OriginalGeometry;
\import \root.Thom[].Real[].For[X := Y, F := (\fun (y: Y) => F (f y)), bundle := pulledBundle].With[metric := pulledMetric] \as PulledGeometry;
\definition chart: _ := Pull.In[c := c].trivialization regular;
\import OriginalGeometry.Chart[c := c] \as OldChart;
\import PulledGeometry.Chart[c := chart] \as NewChart;
\module Fiber(y: \Cast[Y] chart.domain);
\module Rank(n: N.Nat^, same: c.dimension = n);
