\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Fiber[x := x] \as Actual;
\definition map[p: Actual.Carrier]: Carrier := \into[Disk.DiskBundle](p, domain) \by {
  \idelim x = Disk.diskProjection p \with y: X => \In[X] U y \by {
    base: \bysub(X, U, x), equality: sym!{X} _ _ (\bysub(Disk.DiskBundle, Actual.subset, p))
  }
};
\definition continuous: topology.Continuity[A := Actual.Carrier, B := Carrier].Continuous Actual.topology topology map :=
  topology.Continuity[A := Actual.Carrier, B := Disk.DiskBundle].Corestriction[S := domain].corestrictContinuous Actual.topology Disk.diskTopology map Actual.continuous;
\import singular_cohomology.Relative[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary].Maps[B := Carrier].Over[target := topology, targetSubset := boundary] \as Maps;
\definition pairMap: Maps.Map := \into[Actual.Carrier -> Carrier](map, Maps.Map) \by {
  Maps.Laws[map] { continuous := continuous, contained := \fun (p: \Cast[Actual.Carrier] Actual.boundary) => \bysub(Actual.Carrier, Actual.boundary, p) }
};
\module Ring(K: \Set, ring: std.Alg[].Ring[].CommutativeRing[K]) {
  \import \root.RelativePullback[].On[A := Actual.Carrier, source := Actual.topology, subset := Actual.boundary, R := K, ring := ring].To[B := Carrier, target := topology, part := boundary].Along[f := pairMap] \as Pull;
  \module Degree(n: N.Nat^) { \definition restriction: _ := Pull.Degree[n := n].map; }
}
