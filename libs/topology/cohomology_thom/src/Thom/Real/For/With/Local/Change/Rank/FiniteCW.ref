\import SourceOrientation.With[orientation := orientation].FiniteCW[complex := complex] \as Source;
\import TargetOrientation.With[orientation := targetOrientation].FiniteCW[complex := complex] \as Target;
\definition class: _ := Target.class;
\definition classLaw: Change.Degree[z := I.Int^::ofNat n].map.apply Source.class = Target.class :=
  Target.uniqueNormalized (Change.Degree[z := I.Int^::ofNat n].map.apply Source.class) (\fun (x: X) => trans!{{TargetRank.FiberClass x}} _ _ _
    (sym!{{TargetRank.FiberClass x}} _ _ (Change.Fiber[x := x, z := I.Int^::ofNat n].law Source.class))
    (congr!{{SourceRank.FiberClass x} {TargetRank.FiberClass x}} Change.Fiber[x := x, z := I.Int^::ofNat n].map.apply _ _ (Source.normalized x)));
\import BundleGeometry.Coefficients[R := K, ring := ring] \as SourceTheory;
\import BundleGeometry.Coefficients[R := L, ring := targetRing] \as TargetTheory;
\import \root.CoefficientChange[].OnSpace[A := X, source := bundle.baseSpace, R := K, S := L, ring := ring, targetRing := targetRing].With[morphism := morphism] \as BaseChange;
\import \root.CoefficientChange[].OnSpace[A := Disk.DiskBundle, source := Disk.diskTopology, R := K, S := L, ring := ring, targetRing := targetRing] \as DiskMaps;
\definition diskMorphism: DiskMaps.Morphism := DiskMaps.Morphism { linear := morphism.linear, multiply := morphism.multiply, unit := morphism.unit };
\import DiskMaps.With[morphism := diskMorphism] \as DiskChange;
\import DiskChange.Relative[subset := Disk.Boundary] \as RelativeChange;
\import singular_products.Cochains[A := Disk.DiskBundle, source := Disk.diskTopology, R := K, ring := ring] \as SourceTotal;
\import singular_products.Cochains[A := Disk.DiskBundle, source := Disk.diskTopology, R := L, ring := targetRing] \as TargetTotal;
\module Degree(p: N.Nat^);
\module Euler;
