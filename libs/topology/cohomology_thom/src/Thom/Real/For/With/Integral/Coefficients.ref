\import \root.CoefficientChange[].FromIntegers[K := K, ring := ring].OnSpace[A := X, source := bundle.baseSpace] \as Canonical;
\import Integral.Change[L := K, targetRing := ring, morphism := Canonical.morphism] \as Changed;
\definition targetOrientation: _ := Changed.targetOrientation;
\definition class: _ := Changed.class;
\definition classLaw: _ := Changed.classLaw;
\definition eulerLaw: _ := Changed.eulerLaw;
\module Degree(p: N.Nat^) {
  \definition isomorphism: _ := Changed.Degree[p := p].isomorphism;
  \definition law: _ := Changed.Degree[p := p].law;
  \definition inverseLaw: _ := Changed.Degree[p := p].inverseLaw;
}
