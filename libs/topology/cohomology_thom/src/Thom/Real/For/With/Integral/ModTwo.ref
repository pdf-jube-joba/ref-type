\import algebra.Two[] \as Two;
\import \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric] \as Geometry;
\import Geometry.Local[K := I.Int^, ring := IntegerRing.commutativeRing].Rank[n := n].Orientation[] \as Orientations;
\definition constantRank: \forall (x: X) -> Bundle.rank x = n := Orientations.rank orientation;
\import \parent.Coefficients[K := Two.Carrier, ring := Two.commutativeRing] \as Changed;
\import Geometry.ModTwo[n := n, constantRank := constantRank, complex := complex] \as Canonical;
\import Canonical.Compare[given := Changed.targetOrientation] \as Comparison;
\definition classLaw: _ := trans!{{Geometry.Coefficients[R := Two.Carrier, ring := Two.commutativeRing].Degree[n := n].Class}} _ _ _ Changed.classLaw Comparison.classLaw;
\definition eulerLaw: _ := trans!{{singular_products.Cochains[A := X, source := bundle.baseSpace, R := Two.Carrier, ring := Two.commutativeRing].Cohomology[].Group n}} _ _ _ Changed.eulerLaw Comparison.eulerLaw;
