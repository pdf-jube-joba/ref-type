\use std.Logic[].Equality[].eq_reason_in;
\import singular_cap.CochainPair[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary, R := K, ring := ring].Comparison[n := n].Cohomology[] \as SourceForget;
\import singular_cap.CochainPair[A := Disk.DiskBundle, source := Disk.diskTopology, subset := Disk.Boundary, R := L, ring := targetRing].Comparison[n := n].Cohomology[] \as TargetForget;
\import BaseChange.Along[B := Disk.DiskBundle, target := Disk.diskTopology, f := Disk.zeroSection, regular := Disk.zeroSectionContinuous].Degree[n := n] \as SectionNatural;
\import TargetProduct.Cohomology[].Pullback[B := Disk.DiskBundle, target := Disk.diskTopology] \as Section;
\definition law: BaseChange.Degree[n := n].map.apply Source.euler = Target.euler := eq_reason_in!{{TargetProduct.Cohomology[].Group n} _
  "=" _ "by" { SectionNatural.law (SourceForget.map.apply Source.class) }
  "=" _ "by" { congr!{{TargetTotal.Cohomology[].Group n} {TargetProduct.Cohomology[].Group n}} (Section.apply n Disk.zeroSection Disk.zeroSectionContinuous) _ _ (sym!{{TargetTotal.Cohomology[].Group n}} _ _ (RelativeChange.Degree[n := n].Forget[].law Source.class)) }
  "=" _ "by" { congr!{{TargetTheory.Degree[n := n].Class} {TargetProduct.Cohomology[].Group n}} (\fun (u: TargetTheory.Degree[n := n].Class) => Section.apply n Disk.zeroSection Disk.zeroSectionContinuous (TargetForget.map.apply u)) _ _ classLaw }
};
