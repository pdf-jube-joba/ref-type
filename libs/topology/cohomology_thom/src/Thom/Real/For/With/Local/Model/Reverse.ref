\definition thomClass: Top.Class := Top.space.neg model.thomClass;
\definition isomorphism[p: N.Nat^]: Theory.Cup[p := p, n := n].With[u := thomClass].Iso :=
  \root.RelativeAction[A := Domain.Carrier, source := Domain.topology, subset := Domain.boundary, K := K, ring := ring].Degree[p := p, q := n].Reverse[u := model.thomClass].isomorphism (model.isomorphism p) (model.formula p);
\definition data: Data := Data {
  thomClass := thomClass, isomorphism := isomorphism,
  formula := \fun (p: N.Nat^)(a: Theory.Cup[p := p, n := n].Domain) => \refl((Theory.Cup[p := p, n := n].map thomClass).apply a),
  below := model.below
};
