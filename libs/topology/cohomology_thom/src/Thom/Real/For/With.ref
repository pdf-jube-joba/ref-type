\import thom_spaces.Thom[].Over[K := Reals.Real, field := Reals.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].For[X := X, F := F, bundle := bundle].With[metric := metric] \as Disk;
\module Coefficients(R: \Set, ring: Rings.CommutativeRing[R]);

\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import module_theory.Module[].Over[R := I.Int^, ring := IntegerRing.ring] \as IntegerModules;
\module Additive(coefficients: IntegerModules.Bundle);
\module Fiber(x: X);
\module ChangeCoefficients(M, N: IntegerModules.Bundle, u: IntegerModules.MapBetween M N);

\import Bundles.Family[X := X, F := F].Of[bundle := bundle] \as Bundle;
\module ZeroRank(rankZero: \forall (x: X) -> Bundle.rank x = N.Nat^::zero);
\module Pullback(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X, regular: topology.Continuity[A := Y, B := X].Continuous source bundle.baseSpace f);

\module Chart(c: Bundles.Family[X := X, F := F].With[data := bundle].Chart);

\module Atlas;

\module Domain(U: \Pow X);

\module Local(K: \Set, ring: std.Alg[].Ring[].CommutativeRing[K]);

\module Oriented(K: \Set, ring: std.Alg[].Ring[].CommutativeRing[K], n: N.Nat^,
  orientation: \root.Thom[].Real[].For[X := X, F := F, bundle := bundle].With[metric := metric].Local[K := K, ring := ring].Rank[n := n].Orientation[].SignedOrientation,
  complex: algebraic_topology.CW[A := X].FiniteComplex[bundle.baseSpace]);
