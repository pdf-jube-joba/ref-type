\import thom_spaces.Thom[].Over[K := Reals.Real, field := Reals.Algebra[].field, conjugation := linear_algebra.Hermitian[].Real[].scalar, scalar := vector_bundles.Bundles[].Real[].scalar].For[X := X, F := F, bundle := bundle] \as Original;
\import Original.With[metric := left] \as Left;
\import Original.With[metric := right] \as Right;
\import Geometry.Change[left := left, right := right] \as Comparison;
\import Geometry.Gauge[metric := left] \as LeftGauge;
\import Geometry.Gauge[metric := right] \as RightGauge;
\import thom_spaces.Thom[].Quadratic[].Over[X := X, F := F, bundle := bundle].Change[left := LeftGauge.gauge, right := RightGauge.gauge] \as Gauges;
\import singular_cohomology.Relative[A := Left.DiskBundle, source := Left.diskTopology, subset := Left.Boundary] \as LeftPair;
\import singular_cohomology.Relative[A := Right.DiskBundle, source := Right.diskTopology, subset := Right.Boundary] \as RightPair;
\import LeftPair.Homeomorphism[B := Right.DiskBundle].Over[target := Right.diskTopology, targetSubset := Right.Boundary] \as Pairs;
\definition pair: Pairs.Data := Pairs.Data {
  homeomorphism := Comparison.diskHomeomorphism,
  forwardPreserves := \fun (v: LeftPair.SubspaceCarrier) => trans!{Reals.Real} _ _ _
    (Gauges.forwardSquared v) (\bysub(Left.DiskBundle, Left.Boundary, v)),
  backwardPreserves := \fun (v: RightPair.SubspaceCarrier) => trans!{Reals.Real} _ _ _
    (Gauges.backwardSquared v) (\bysub(Right.DiskBundle, Right.Boundary, v))
};
\module Additive(coefficients: IntegerModules.Bundle, z: I.Int^) {
  \definition isomorphism: _ := Pairs.With[coefficients := coefficients].At[z := z].isomorphism pair;
}
