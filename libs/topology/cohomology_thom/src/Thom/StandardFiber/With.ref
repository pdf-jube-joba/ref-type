\import Disk.With[coefficients := coefficients] \as Theory;
\definition Class: \Set := Theory.Carrier;
\definition space: IntegerModules.Space Class := Theory.space;
\definition orientation: IntegerModules.Isomorphism[V := coefficients.Carrier, W := Class, source := coefficients.space, target := space].Isomorphism := Theory.isomorphism;
\definition lift: IntegerModules.Hom[V := coefficients.Carrier, W := Class, source := coefficients.space, target := space].Map := orientation.forward;
\definition coordinate: IntegerModules.Hom[V := Class, W := coefficients.Carrier, source := space, target := coefficients.space].Map := orientation.backward;
\import IntegerModules.Isomorphism[V := coefficients.Carrier, W := Class, source := coefficients.space, target := space] \as Isomorphisms;
\definition liftCoordinate: \forall (u: Class) -> lift.apply (coordinate.apply u) = u :=
  (\bysub(Isomorphisms.Data, { e: Isomorphisms.Data \where Isomorphisms.Laws[e] }, orientation)).rightInverse;
\definition coordinateLift: \forall (a: coefficients.Carrier) -> coordinate.apply (lift.apply a) = a :=
  (\bysub(Isomorphisms.Data, { e: Isomorphisms.Data \where Isomorphisms.Laws[e] }, orientation)).leftInverse;
\definition unique: \forall (a: coefficients.Carrier)(u: Class) -> coordinate.apply u = a -> u = lift.apply a :=
  \fun (a: coefficients.Carrier)(u: Class)(normalized: _) => trans!{Class} _ _ _
    (sym!{Class} _ _ (liftCoordinate u))
    (congr!{coefficients.Carrier Class} lift.apply _ _ normalized);
