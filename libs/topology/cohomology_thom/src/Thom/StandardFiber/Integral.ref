\definition coefficients: IntegerModules.Bundle := IntegerModules.Bundle { Carrier := I.Int^, space := IntegerModules.scalarModule };
\import \parent.With[coefficients := coefficients] \as Theory;
\definition Class: \Set := Theory.Class;
\definition generator: Class := Theory.lift.apply I.One.specification;
\definition normalized: Theory.coordinate.apply generator = I.One.specification := Theory.coordinateLift I.One.specification;
\definition unique: \forall (u: Class) -> Theory.coordinate.apply u = I.One.specification -> u = generator := Theory.unique I.One.specification;
\definition reversed: Class := Theory.space.neg generator;
\definition reverseCoordinate: Theory.coordinate.apply reversed = coefficients.space.neg I.One.specification :=
  trans!{I.Int^} _ _ _
    (IntegerModules.Hom[V := Class, W := I.Int^, source := Theory.space, target := coefficients.space].negativePreserved Theory.coordinate generator)
    (congr!{I.Int^ I.Int^} coefficients.space.neg _ _ normalized);
