\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import singular_products.Cochains[A := A, source := source, R := K, ring := ring] \as Cochains;
\import singular_cohomology.Relative[A := A, source := source, subset := first] \as First;
\import singular_cohomology.Relative[A := A, source := source, subset := second] \as Second;
\import First.With[coefficients := Cochains.integerCoefficients] \as FirstCochains;
\import Second.With[coefficients := Cochains.integerCoefficients] \as SecondCochains;
\import singular_cap.CochainPair[A := A, source := source, subset := first, R := K, ring := ring] \as FirstPair;
\import singular_cap.CochainPair[A := A, source := source, subset := second, R := K, ring := ring] \as SecondPair;
\import singular_cohomology.Chains[A := A, source := source] \as Chains;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Cochains.integerCoefficients] \as Plain;
\definition subset: \Pow A := { x: A \where Logic.Or[\In[A] first x, \In[A] second x] };
\import singular_cohomology.Simplices[A := A, source := source] \as WholeSimplices;
\import \root.FamilyPair[A := A, source := source, family := family] \as Family;
\import singular_subdivision.Small[A := A, source := source, family := family] \as Small;
\definition pair: _ := Family.pair;
\definition inclusion: _ := Small.inclusion;
\module ToSmall(n: N.Nat^);
\module FromSmall(n: N.Nat^);
\module CommonIso;
