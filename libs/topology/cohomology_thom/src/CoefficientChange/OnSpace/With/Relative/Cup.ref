\import SourcePair.RelativeCup[p := p, q := q] \as Left;
\import TargetPair.RelativeCup[p := p, q := q] \as Right;
\import SourcePair.Comparison[n := q] \as LeftInput;
\import TargetPair.Comparison[n := q] \as RightInput;
\definition total: N.Nat^ := N.Basic[].Def[].add p q;
\import TargetPair.Comparison[n := total] \as Result;
\import Target.Cup[p := p, q := q] \as Product;
\import \root.CoefficientChange[].OnSpace[A := A, source := source, R := R, S := S, ring := ring, targetRing := targetRing].With[morphism := morphism].Cup[p := p, q := q] \as OrdinaryProduct;
\definition law: \forall (a: Source.Carrier p)(b: SourceRelative.Carrier (I.Int^::ofNat q)) ->
  cochainMap.apply (I.Int^::ofNat total) (Left.right a b) = Right.right (apply p a) (cochainMap.apply (I.Int^::ofNat q) b) :=
  \fun (a: Source.Carrier p)(b: SourceRelative.Carrier (I.Int^::ofNat q)) => Result.injective _ _
    (eq_reason_in!{{Target.Carrier total} _
      "=" _ "by" { \parent.Compare[n := total].law (Left.right a b) }
      "=" _ "by" { congr!{{Source.Carrier total} {Target.Carrier total}} (apply total) _ _ (Left.rightRestriction a b) }
      "=" _ "by" { OrdinaryProduct.law a (LeftInput.from b) }
      "=" _ "by" { congr!{{Target.Carrier q} {Target.Carrier total}} (Product.apply (apply p a)) _ _ (sym!{{Target.Carrier q}} _ _ (\parent.Compare[n := q].law b)) }
      "=" _ "by" { sym!{{Target.Carrier total}} _ _ (Right.rightRestriction (apply p a) (cochainMap.apply (I.Int^::ofNat q) b)) }
    });

\module Cohomology;
