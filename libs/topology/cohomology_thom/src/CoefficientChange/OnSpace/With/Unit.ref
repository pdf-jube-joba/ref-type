\import \parent.Degree[n := N.Nat^::zero] \as Change;
\import Nonnegative.At[C := TargetOrdinary.complex, k := N.Nat^::zero] \as Output;
\import Source.Cohomology[].Unit[] \as Left;
\import Target.Cohomology[].Unit[] \as Right;
\definition law: Change.map.apply Left.class = Right.class := trans!{Output.Cohomology} _ _ _
  (Change.onClass Left.cycle) (Output.equalClass (Change.cycles.apply Left.cycle) Right.cycle unit);
