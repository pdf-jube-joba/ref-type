\import Source.Cup[p := p, q := q] \as SourceCup;
\import Target.Cup[p := p, q := q] \as TargetCup;
\import Simplices.Cut[p := p, q := q] \as Cut;
\import Modules.Free[Generators := Simplices.Carrier SourceCup.total].To[W := S, target := Target.integerCoefficients.space] \as Free;
\definition law: \forall (a: Source.Carrier p)(b: Source.Carrier q) -> apply SourceCup.total (SourceCup.apply a b) = TargetCup.apply (apply p a) (apply q b) :=
  \fun (a: Source.Carrier p)(b: Source.Carrier q) => Free.ext _ _
    (\fun (sigma: Simplices.Carrier SourceCup.total) => trans!{S} _ _ _
      (congr!{R S} morphism.linear.apply _ _ (SourceCup.onSimplex a b sigma))
      (trans!{S} _ _ _
        (morphism.multiply (a.apply (OrdinaryChains.generator p (Cut.front sigma))) (b.apply (OrdinaryChains.generator q (Cut.back sigma))))
        (sym!{S} _ _ (TargetCup.onSimplex (apply p a) (apply q b) sigma))));

\module Cohomology;
