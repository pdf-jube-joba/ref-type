\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].End[C := OrdinaryChains.complex] \as End;
\import Hom.Mapping[P := OrdinaryChains.complex, Q := OrdinaryChains.complex, N := Source.integerCoefficients, L := Target.integerCoefficients].On[f := End.identity, u := morphism.linear] \as Native;
\definition cochainMap: _ := Native.map;
\definition apply: \forall (n: N.Nat^) -> Source.Carrier n -> Target.Carrier n := Native.apply;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\module Degree(n: N.Nat^) {
  \import Nonnegative.Map[C := SourceOrdinary.complex, D := TargetOrdinary.complex].At[k := n] \as Actions;
  \definition map: _ := Actions.induced cochainMap;
  \definition cycles: _ := Actions.cyclesMap cochainMap;
  \definition onClass: _ := Actions.onClass cochainMap;
}
\module Cup(p, q: N.Nat^);
\module Relative(subset: \Pow A);
\definition unit: apply N.Nat^::zero Source.Unit[].cochain = Target.Unit[].cochain :=
  Modules.Free[Generators := Simplices.Carrier N.Nat^::zero].To[W := S, target := Target.integerCoefficients.space].ext _ _
    (\fun (sigma: Simplices.Carrier N.Nat^::zero) => trans!{S} _ _ _
      (congr!{R S} morphism.linear.apply _ _ (Source.Unit[].onSimplex sigma))
      (trans!{S} _ _ _ morphism.unit (sym!{S} _ _ (Target.Unit[].onSimplex sigma))));

\module Unit;
\module Along(B: \Set, target: topology.Topology[Carrier := B].Topology, f: A -> B, regular: topology.Continuity[A := A, B := B].Continuous source target f);
