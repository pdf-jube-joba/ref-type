\import std.Data[].Nat[] \as N;
\import singular_products.Cochains[A := A, source := source, R := R, ring := ring] \as Source;
\import singular_products.Cochains[A := A, source := source, R := S, ring := targetRing] \as Target;
\import singular_cohomology.Chains[A := A, source := source] \as OrdinaryChains;
\import singular_cohomology.Simplices[A := A, source := source] \as Simplices;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Source.integerCoefficients] \as SourceOrdinary;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := Target.integerCoefficients] \as TargetOrdinary;
\structure Morphism: \Set := {
  linear: Modules.MapBetween Source.integerCoefficients Target.integerCoefficients,
  multiply: \forall (a, b: R) -> linear.apply (Source.baseRing.mul a b) = Target.baseRing.mul (linear.apply a) (linear.apply b),
  unit: linear.apply Source.baseRing.one = Target.baseRing.one,
};
\module With(morphism: Morphism);
