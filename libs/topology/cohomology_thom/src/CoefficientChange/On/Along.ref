\import \root.CoefficientChange[].On[C := D, M := M, N := N, u := u] \as After;
\import Hom.Integer[P := D, N := M] \as LowerSource;
\import Hom.Integer[P := D, N := N] \as LowerTarget;
\import Modules.End[V := M.Carrier, space := M.space] \as MEnd;
\import Modules.End[V := N.Carrier, space := N.space] \as NEnd;
\import Hom.IntegerMapping[P := D, Q := C, N := M, L := M].On[f := f, u := MEnd.identity] \as PullSource;
\import Hom.IntegerMapping[P := D, Q := C, N := N, L := N].On[f := f, u := NEnd.identity] \as PullTarget;
\definition square: \forall (z: I.Int^)(h: Source.Carrier z) -> After.cochainMap.apply z (PullSource.map.apply z h) = PullTarget.map.apply z (cochainMap.apply z h) :=
  \fun (z: I.Int^)(h: Source.Carrier z) => LowerTarget.At[z := z].ext
    (After.cochainMap.apply z (PullSource.map.apply z h)) (PullTarget.map.apply z (cochainMap.apply z h))
    (\fun (x: D.family.Carrier z) => \refl(u.apply (h.apply (f.apply z x))));
\module At(z: I.Int^);
