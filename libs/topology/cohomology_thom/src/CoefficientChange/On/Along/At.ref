\import Source.Cohomology[z := z] \as S;
\import Target.Cohomology[z := z] \as T;
\import LowerSource.Cohomology[z := z] \as LS;
\import LowerTarget.Cohomology[z := z] \as LT;
\import Native.At[z := z] \as Change;
\import Cochains.Map[C := LowerSource.complex, D := LowerTarget.complex].At[k := z] \as Other;
\import PullSource.At[z := z] \as PS;
\import PullTarget.At[z := z] \as PT;
\definition law: \forall (q: S.Cohomology) -> (Other.induced After.cochainMap).apply (PS.map.apply q) = PT.map.apply (Change.map.apply q) :=
  S.classInduction (\fun (q: S.Cohomology) => (Other.induced After.cochainMap).apply (PS.map.apply q) = PT.map.apply (Change.map.apply q))
    (\fun (h: S.Closed) => eq_reason_in!{LT.Cohomology _
      "=" _ "by" { congr!{LS.Cohomology LT.Cohomology} (Other.induced After.cochainMap).apply _ _ (PS.onClass h) }
      "=" _ "by" { Other.onClass After.cochainMap (PS.cycles.apply h) }
      "=" _ "by" { congr!{LT.Closed LT.Cohomology} LT.classOf ((Other.cyclesMap After.cochainMap).apply (PS.cycles.apply h)) (PT.cycles.apply (Change.cycles.apply h)) (square z h) }
      "=" _ "by" { sym!{LT.Cohomology} _ _ (PT.onClass (Change.cycles.apply h)) }
      "=" _ "by" { congr!{T.Cohomology LT.Cohomology} PT.map.apply _ _ (sym!{T.Cohomology} _ _ (Change.onClass h)) }
    });
