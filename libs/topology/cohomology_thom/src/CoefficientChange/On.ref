\import Hom.Integer[P := C, N := M] \as Source;
\import Hom.Integer[P := C, N := N] \as Target;
\import Chains.End[C := C] \as End;
\import Hom.IntegerMapping[P := C, Q := C, N := M, L := N].On[f := End.identity, u := u] \as Native;
\definition cochainMap: Cochains.Map[C := Source.complex, D := Target.complex].Map := Native.map;
\module At(z: I.Int^) {
  \definition map: _ := Native.At[z := z].map;
  \definition onClass: _ := Native.At[z := z].onClass;
}
\module Along(D: Chains.Complex, f: Chains.Map[C := D, D := C].Map);
