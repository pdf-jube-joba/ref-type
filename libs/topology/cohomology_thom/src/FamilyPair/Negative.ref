\definition index: I.Int^ := I.Int^::negSucc n;
\definition zero: \forall (x: Carrier index) -> x = (space index).zero := Quotient.At[k := index].induction
  (\fun (x: Carrier index) => x = (space index).zero)
  (\fun (x: WholeExtension.Carrier index) => trans!{{Carrier index}} _ _ _
    (congr!{{WholeExtension.Carrier index} {Carrier index}} (class index) _ _ (WholeExtension.Negative[n := n].zero x))
    (Modules.Hom[V := WholeExtension.Carrier index, W := Carrier index, source := WholeExtension.space index, target := space index].zeroPreserved Quotient.At[k := index].projection));
