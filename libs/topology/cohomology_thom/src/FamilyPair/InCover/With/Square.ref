\definition inclusion: \forall (h: WholeRelative.Carrier z) ->
  WholePull.map.apply z (SourceSequence.inclusion.apply z h) = TargetSequence.inclusion.apply z (RelativePull.map.apply z h) :=
  \fun (h: WholeRelative.Carrier z) => SmallWhole.At[z := z].ext (WholePull.map.apply z (SourceSequence.inclusion.apply z h)) (TargetSequence.inclusion.apply z (RelativePull.map.apply z h))
    (\fun (x: AmbientExtension.Carrier z) => congr!{{WholePair.Carrier z} coefficients.Carrier} h.apply _ _
      (sym!{{WholePair.Carrier z}} _ _ (\parent.\parent.At[z := z].onClass x)));
\definition restriction: \forall (h: WholeWhole.Carrier z) ->
  BoundaryPull.map.apply z (SourceSequence.restriction.apply z h) = TargetSequence.restriction.apply z (WholePull.map.apply z h) :=
  \fun (h: WholeWhole.Carrier z) => SmallSub.At[z := z].ext (BoundaryPull.map.apply z (SourceSequence.restriction.apply z h)) (TargetSequence.restriction.apply z (WholePull.map.apply z h))
    (\fun (x: JointExtension.Carrier z) => congr!{{WholeExtension.Carrier z} coefficients.Carrier} h.apply _ _ (sym!{{WholeExtension.Carrier z}} _ _ (compatible z x)));
