\import Ambient.Simplices[] \as AmbientSimplices;
\import Joint.Simplices[] \as JointSimplices;
\import Modules.Free[Generators := AmbientSimplices.Carrier n].Subset[S := JointSimplices.selected n].QuotientBasis[] \as Basis;
\import SmallPair.Positive[n := n] \as Raw;
\definition outside: \Pow (AmbientSimplices.Carrier n) := Basis.Complement;
\definition Generator: \Set := \Cast[AmbientSimplices.Carrier n] outside;
\import Modules.Free[Generators := Generator] \as Free;
\definition index: I.Int^ := I.Int^::ofNat n;
\definition isomorphism: Modules.Isomorphism[V := Free.Carrier, W := Carrier index, source := Free.space, target := space index].Isomorphism :=
  Modules.Isomorphism[V := Free.Carrier, W := Raw.Carrier, source := Free.space, target := Raw.space].Composition[U := Carrier index, final := space index].compose Raw.isomorphism Basis.isomorphism;
\definition onGenerator: \forall (sigma: Generator) -> isomorphism.forward.apply (Free.generator sigma) = SmallQuotient.At[k := index].class (AmbientExtension.Positive[n := n].intro (Ambient.generator n sigma)) :=
  \fun (sigma: Generator) => trans!{{Carrier index}} _ _ _
    (congr!{Raw.Carrier {Carrier index}} Raw.isomorphism.forward.apply _ _ (Basis.forwardOnGenerator sigma)) (Raw.onClass (Ambient.generator n sigma));
