\definition index: I.Int^ := I.Int^::negSucc n;
\definition zero: \forall (x: Carrier index) -> x = (space index).zero := SmallQuotient.At[k := index].induction
  (\fun (x: Carrier index) => x = (space index).zero)
  (\fun (x: AmbientExtension.Carrier index) => trans!{{Carrier index}} _ _ _
    (congr!{{AmbientExtension.Carrier index} {Carrier index}} (class index) _ _ (AmbientExtension.Negative[n := n].zero x))
    (Modules.Hom[V := AmbientExtension.Carrier index, W := Carrier index, source := AmbientExtension.space index, target := space index].zeroPreserved SmallQuotient.At[k := index].projection));
