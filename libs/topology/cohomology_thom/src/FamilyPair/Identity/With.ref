\import Hom.Integer[P := complex, N := coefficients] \as Cochains;
\import Hom.IntegerEnd[P := complex, N := coefficients] \as Native;
\import Hom.IntegerMapping[P := complex, Q := complex, N := coefficients, L := coefficients] \as Action;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Scalars;
\definition law: \forall (z: I.Int^)(q: Cochains.Cohomology[z := z].Cohomology) -> (Mapping.With[coefficients := coefficients].At[z := z].induced).apply q = q :=
  \fun (z: I.Int^)(q: Cochains.Cohomology[z := z].Cohomology) => trans!{{Cochains.Cohomology[z := z].Cohomology}} _ _ _
    (congr!{RelativeMaps.Map {Cochains.Cohomology[z := z].Cohomology}} (\fun (m: RelativeMaps.Map) => (Action.On[f := m, u := Scalars.identity].At[z := z].map).apply q) _ _ chainLaw)
    (Native.At[k := z].onCohomology q);
