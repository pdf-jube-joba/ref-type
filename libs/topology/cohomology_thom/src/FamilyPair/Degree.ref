\import Boundary.Simplices[] \as BoundarySimplices;
\import Modules.Free[Generators := Simplices.Carrier n].Subset[S := BoundarySimplices.Small n].QuotientBasis[] \as Basis;
\import Pair.Positive[n := n] \as Raw;
\definition outside: \Pow (Simplices.Carrier n) := Basis.Complement;
\definition Generator: \Set := \Cast[Simplices.Carrier n] outside;
\import Modules.Free[Generators := Generator] \as Free;
\definition index: I.Int^ := I.Int^::ofNat n;
\definition isomorphism: Modules.Isomorphism[V := Free.Carrier, W := Carrier index, source := Free.space, target := space index].Isomorphism :=
  Modules.Isomorphism[V := Free.Carrier, W := Raw.Carrier, source := Free.space, target := Raw.space].Composition[U := Carrier index, final := space index].compose Raw.isomorphism Basis.isomorphism;
\definition onGenerator: \forall (sigma: Generator) -> isomorphism.forward.apply (Free.generator sigma) = class index (WholeExtension.Positive[n := n].intro (Whole.generator n sigma)) :=
  \fun (sigma: Generator) => trans!{{Carrier index}} _ _ _
    (congr!{Raw.Carrier {Carrier index}} Raw.isomorphism.forward.apply _ _ (Basis.forwardOnGenerator sigma)) (Raw.onClass (Whole.generator n sigma));
