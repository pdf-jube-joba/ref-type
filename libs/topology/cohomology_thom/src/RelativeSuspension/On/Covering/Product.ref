\use std.Logic[].Equality[].eq_reason_in;
\import singular_products.Cochains[A := A, source := source, R := K, ring := ring] \as BaseProduct;
\import singular_products.Cochains[A := Cylinder.Carrier, source := topology, R := K, ring := ring] \as CylinderProduct;
\import singular_products.Cochains[A := Middle.Carrier, source := Middle.space, R := K, ring := ring] \as MiddleProduct;
\import singular_products.Cochains[A := Native.Overlap, source := Native.overlapTopology, R := K, ring := ring] \as OverlapProduct;
\import singular_products.Cochains[A := Native.Left, source := Native.leftTopology, R := K, ring := ring] \as LeftProduct;
\import \root.RelativePullback[].On[A := Middle.Carrier, source := Middle.space, subset := Middle.part, R := K, ring := ring].To[B := A, target := source, part := subset].Along[f := Middle.forward] \as MiddlePull;
\import \root.RelativePullback[].On[A := Native.Overlap, source := Native.overlapTopology, subset := Native.overlapPart, R := K, ring := ring].To[B := Middle.Carrier, target := Middle.space, part := Middle.part].Along[f := Pairs.forwardMap pair] \as OverlapPull;
\import singular_cap.CochainPair[A := A, source := source, subset := subset, R := K, ring := ring] \as BaseCup;
\import singular_cap.CochainPair[A := Cylinder.Carrier, source := topology, subset := boundary, R := K, ring := ring] \as CylinderCup;
\import singular_cap.CochainPair[A := Middle.Carrier, source := Middle.space, subset := Middle.part, R := K, ring := ring] \as MiddleCup;
\import singular_cap.CochainPair[A := Native.Overlap, source := Native.overlapTopology, subset := Native.overlapPart, R := K, ring := ring] \as OverlapCup;
\import \parent.With[coefficients := BaseProduct.integerCoefficients] \as Suspension;
\import Native.Product[K := K, ring := ring] \as MVProduct;
\import singular_cohomology.Maps[A := Cylinder.Carrier, B := A, source := topology, target := source] \as Projection;
\import Projection.Coefficients[M := BaseProduct.integerCoefficients, L := BaseProduct.integerCoefficients] \as ProjectionMaps;
\import Modules.End[V := K, space := BaseProduct.integerCoefficients.space] \as Coefficients;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import singular_cohomology.Cochains[A := A, source := source].With[coefficients := BaseProduct.integerCoefficients] \as BaseOrdinary;
\import singular_cohomology.Cochains[A := Cylinder.Carrier, source := topology].With[coefficients := BaseProduct.integerCoefficients] \as CylinderOrdinary;
\import singular_cohomology.Cochains[A := Middle.Carrier, source := Middle.space].With[coefficients := BaseProduct.integerCoefficients] \as MiddleOrdinary;
\import singular_cohomology.Cochains[A := Native.Overlap, source := Native.overlapTopology].With[coefficients := BaseProduct.integerCoefficients] \as OverlapOrdinary;
\import CylinderProduct.Pullback[B := A, target := source] \as ProjectionPull;
\import MiddleProduct.Pullback[B := A, target := source] \as MiddleAbsolute;
\import OverlapProduct.Pullback[B := Middle.Carrier, target := Middle.space] \as OverlapAbsolute;
\definition overlapContinuous: _ := (topology.Homeomorphism[A := Native.Overlap, B := Middle.Carrier].laws Native.overlapTopology Middle.space homeomorphism).forwardContinuous;
\module Absolute(p: N.Nat^);
\module Cup(p, q: N.Nat^);
