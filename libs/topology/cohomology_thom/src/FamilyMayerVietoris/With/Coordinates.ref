\import \root.RelativeMayerVietoris[].HomSum[C := L.complex, D := R.complex, coefficients := coefficients] \as SumCoordinates;
\import Sum.Inclusions[] \as Arrows;
\import Hom.Integer[P := L.complex, N := coefficients] \as LeftHom;
\import Hom.Integer[P := R.complex, N := coefficients] \as RightHom;
\import \root.FamilyPair[A := A, source := source, family := family] \as Whole;
\import Hom.Integer[P := Whole.complex, N := coefficients] \as WholeHom;
\import SmallPair.With[coefficients := coefficients] \as FamilyComparison;
\import Boundary.Pullback[B := Left].Over[topology := leftTopology, f := leftInclusion] \as LeftBoundaryPull;
\import Boundary.Pullback[B := Right].Over[topology := rightTopology, f := rightInclusion] \as RightBoundaryPull;
\import singular_subdivision.Small[A := Left, source := leftTopology, family := LeftBoundaryPull.pullbackFamily].Simplices[] \as LeftBoundarySimplices;
\import singular_subdivision.Small[A := Right, source := rightTopology, family := RightBoundaryPull.pullbackFamily].Simplices[] \as RightBoundarySimplices;
\definition leftPreserves: \forall (n: N.Nat^)(sigma: LeftBoundarySimplices.Carrier n) ->
  \In[singular_cohomology.Simplices[A := A, source := source].Carrier n] (Boundary.Simplices[].Small n) (singular_cohomology.Maps[A := Left, B := A, source := leftTopology, target := source].postcompose n leftInclusion leftContinuous sigma) :=
  \fun (n: N.Nat^)(sigma: LeftBoundarySimplices.Carrier n) => LeftBoundaryPull.At[n := n].small leftContinuous sigma;
\definition rightPreserves: \forall (n: N.Nat^)(sigma: RightBoundarySimplices.Carrier n) ->
  \In[singular_cohomology.Simplices[A := A, source := source].Carrier n] (Boundary.Simplices[].Small n) (singular_cohomology.Maps[A := Right, B := A, source := rightTopology, target := source].postcompose n rightInclusion rightContinuous sigma) :=
  \fun (n: N.Nat^)(sigma: RightBoundarySimplices.Carrier n) => RightBoundaryPull.At[n := n].small rightContinuous sigma;
\import \root.FamilyPairMap[A := Left, B := A, source := leftTopology, target := source, sourceFamily := LeftBoundaryPull.pullbackFamily, targetFamily := family, f := leftInclusion, regular := leftContinuous, preserves := leftPreserves] \as LeftGlobal;
\import \root.FamilyPairMap[A := Right, B := A, source := rightTopology, target := source, sourceFamily := RightBoundaryPull.pullbackFamily, targetFamily := family, f := rightInclusion, regular := rightContinuous, preserves := rightPreserves] \as RightGlobal;
\import Chains.ShortExact[A := O.complex, B := Sum.complex, C := SmallPair.complex].Cokernel[s := ChainSequence.sequence] \as QuotientComparison;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Scalars;
\import Hom.IntegerMapping[P := O.complex, Q := L.complex, N := coefficients, L := coefficients].On[f := LeftMap.map, u := Scalars.identity] \as LeftPull;
\import Hom.IntegerMapping[P := O.complex, Q := R.complex, N := coefficients, L := coefficients].On[f := RightMap.map, u := Scalars.identity] \as RightPull;
\module At(z: I.Int^) {
  \import Modules.Laws[V := SmallPair.complex.family.Carrier z, space := SmallPair.complex.family.space z] \as SmallLaws;
  \import algebra.Group[].Of[Carrier := SmallPair.complex.family.Carrier z, group := SmallLaws.additive] \as SmallGroup;
  \import Modules.Hom[V := L.Carrier z, W := SmallPair.complex.family.Carrier z, source := L.space z, target := SmallPair.complex.family.space z] \as LeftMaps;
  \import Modules.Hom[V := R.Carrier z, W := SmallPair.complex.family.Carrier z, source := R.space z, target := SmallPair.complex.family.space z] \as RightMaps;
  \definition inclusionOnChain: \forall (h: SmallHom.Carrier z)(x: Sum.Carrier z) ->
    ((sequence.inclusion.apply z h).apply x) = h.apply (projection.apply z x) :=
    \fun (h: SmallHom.Carrier z)(x: Sum.Carrier z) => congr!{{SmallPair.complex.family.Carrier z} coefficients.Carrier} h.apply _ _ (QuotientComparison.At[k := z].onClass x);
  \definition leftChain: \forall (x: L.Carrier z) -> projection.apply z (Arrows.firstInjection.apply z x) = LeftSmall.map.apply z x :=
    \fun (x: L.Carrier z) => trans!{{SmallPair.complex.family.Carrier z}} _ _ _
      (congr!{{SmallPair.complex.family.Carrier z} {SmallPair.complex.family.Carrier z}}
        (\fun (y: SmallPair.complex.family.Carrier z) => SmallGroup.add (LeftSmall.map.apply z x) y) _ _
        (RightMaps.zeroPreserved (Chains.Map[C := R.complex, D := SmallPair.complex].At[k := z].linear RightSmall.map)))
      (SmallGroup.zeroRight (LeftSmall.map.apply z x));
  \definition rightChain: \forall (x: R.Carrier z) -> projection.apply z (Arrows.secondInjection.apply z x) = RightSmall.map.apply z x :=
    \fun (x: R.Carrier z) => trans!{{SmallPair.complex.family.Carrier z}} _ _ _
      (congr!{{SmallPair.complex.family.Carrier z} {SmallPair.complex.family.Carrier z}}
        (\fun (y: SmallPair.complex.family.Carrier z) => SmallGroup.add y (RightSmall.map.apply z x)) _ _
        (LeftMaps.zeroPreserved (Chains.Map[C := L.complex, D := SmallPair.complex].At[k := z].linear LeftSmall.map)))
      (SmallGroup.zeroLeft (RightSmall.map.apply z x));
  \definition leftLaw: \forall (h: WholeHom.Carrier z) ->
    SumCoordinates.firstProjection.apply z (sequence.inclusion.apply z (FamilyComparison.restriction.apply z h)) = LeftGlobal.With[coefficients := coefficients].pullback.apply z h :=
    \fun (h: WholeHom.Carrier z) => LeftHom.At[z := z].ext
      (SumCoordinates.firstProjection.apply z (sequence.inclusion.apply z (FamilyComparison.restriction.apply z h))) (LeftGlobal.With[coefficients := coefficients].pullback.apply z h)
      (\fun (x: L.Carrier z) => trans!{coefficients.Carrier} _ _ _
        (inclusionOnChain (FamilyComparison.restriction.apply z h) (Arrows.firstInjection.apply z x))
        (trans!{coefficients.Carrier} _ _ _
          (congr!{{SmallPair.complex.family.Carrier z} coefficients.Carrier} (FamilyComparison.restriction.apply z h).apply _ _ (leftChain x))
          (congr!{{Whole.Carrier z} coefficients.Carrier} h.apply _ _ (LeftSmall.Comparison[].law z x))));
  \definition rightLaw: \forall (h: WholeHom.Carrier z) ->
    SumCoordinates.secondProjection.apply z (sequence.inclusion.apply z (FamilyComparison.restriction.apply z h)) = RightGlobal.With[coefficients := coefficients].pullback.apply z h :=
    \fun (h: WholeHom.Carrier z) => RightHom.At[z := z].ext
      (SumCoordinates.secondProjection.apply z (sequence.inclusion.apply z (FamilyComparison.restriction.apply z h))) (RightGlobal.With[coefficients := coefficients].pullback.apply z h)
      (\fun (x: R.Carrier z) => trans!{coefficients.Carrier} _ _ _
        (inclusionOnChain (FamilyComparison.restriction.apply z h) (Arrows.secondInjection.apply z x))
        (trans!{coefficients.Carrier} _ _ _
          (congr!{{SmallPair.complex.family.Carrier z} coefficients.Carrier} (FamilyComparison.restriction.apply z h).apply _ _ (rightChain x))
          (congr!{{Whole.Carrier z} coefficients.Carrier} h.apply _ _ (RightSmall.Comparison[].law z x))));
}

\module Difference(z: I.Int^);
