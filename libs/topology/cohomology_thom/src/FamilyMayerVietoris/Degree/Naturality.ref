\import \parent.SumComparison[] \as SumComparison;
\module LeftNatural;
\module RightNatural;
\module LeftSmallNatural;
\module RightSmallNatural;
\import Modules.Free[Generators := Generators.Overlap].Reindex[TargetGenerators := Generators.Right] \as RightPush;
\definition inclusionSquare: \forall (x: OF.Carrier) -> inclusion.apply index (overlapIsomorphism.forward.apply x) = SumComparison.forward.apply (Free.inclusion.apply x) :=
  \fun (x: OF.Carrier) => Sum.At[z := index].ext _ _ (LeftNatural[].law x)
    (trans!{{R.Carrier index}} _ _ _
      (congr!{{R.Carrier index} {R.Carrier index}} (R.space index).neg _ _ (RightNatural[].law x))
      (sym!{{R.Carrier index}} _ _
        (Modules.Hom[V := RF.Carrier, W := R.Carrier index, source := RF.space, target := R.space index].negativePreserved rightIsomorphism.forward
          ((RightPush.push Generators.overRight).apply x))));
\definition projectionSquare: \forall (x: FreeSum.Carrier) -> projection.apply index (SumComparison.forward.apply x) = wholeIsomorphism.forward.apply (Free.projection.apply x) :=
  \fun (x: FreeSum.Carrier) => trans!{{SmallPair.complex.family.Carrier index}} _ _ _
    (congr!{{SmallPair.complex.family.Carrier index} {SmallPair.complex.family.Carrier index} {SmallPair.complex.family.Carrier index}}
      (SmallPair.complex.family.space index).add _ _ _ _ (LeftSmallNatural[].law (FreeSum.first x)) (RightSmallNatural[].law (FreeSum.second x)))
    (sym!{{SmallPair.complex.family.Carrier index}} _ _ (wholeIsomorphism.forward.addition _ _));
