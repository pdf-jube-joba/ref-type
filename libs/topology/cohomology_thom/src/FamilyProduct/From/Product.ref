\definition total: N.Nat^ := N.Basic[].Def[].add p q;
\import Old.Degree[p := p, q := q] \as OldProduct;
\import New.Degree[p := p, q := q] \as NewProduct;
\import Model.FromSmall[n := total].Apply[] \as OldFrom;
\import NewModel.FromSmall[n := total].Apply[] \as NewFrom;
\import \parent.Degree[n := total] \as Comparison;
\import singular_cohomology.Relative[A := Y, source := target, subset := firstPart].With[coefficients := Whole.integerCoefficients] \as NewFirst;
\import singular_cohomology.Relative[A := Y, source := target, subset := secondPart].With[coefficients := Whole.integerCoefficients] \as NewSecond;
\import \root.MixedCup[A := Y, source := target, first := firstPart, second := secondPart, K := K, ring := ring].Common[n := total] \as Common;
\definition law: \forall (a: First.Carrier (I.Int^::ofNat p))(b: Second.Carrier (I.Int^::ofNat q)) ->
  Pull.map.apply (I.Int^::ofNat total) (OldProduct.apply a b) =
  NewProduct.apply (FirstPull.pullback.apply (I.Int^::ofNat p) a) (SecondPull.pullback.apply (I.Int^::ofNat q) b) :=
  \fun (a: First.Carrier (I.Int^::ofNat p))(b: Second.Carrier (I.Int^::ofNat q)) => NewFrom.injective _ _ (eq_reason_in!{Common.Carrier _
    "=" _ "by" { Comparison.law (OldProduct.apply a b) }
    "=" _ "by" { congr!{{Mixed.Common[n := total].Carrier} Common.Carrier} (Natural.commonMap.apply total) _ _ (OldProduct.formula a b) }
    "=" _ "by" { Natural.Product[p := p, q := q].cochainLaw a b }
    "=" _ "by" { sym!{Common.Carrier} _ _ (NewProduct.formula (FirstPull.pullback.apply (I.Int^::ofNat p) a) (SecondPull.pullback.apply (I.Int^::ofNat q) b)) }
  });
\module Cohomology;
