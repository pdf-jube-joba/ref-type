\import Model.FromSmall[n := n].Apply[] \as OldFrom;
\import NewModel.FromSmall[n := n].Apply[] \as NewFrom;
\import singular_cohomology.Chains[A := Y, source := target] \as NewChains;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := NewChains.complex] \as Extension;
\import Modules.Hom[V := NewChains.Carrier n, W := K, source := NewChains.space n, target := Whole.integerCoefficients.space] \as CochainMaps;
\definition law: \forall (u: OldPair.With[coefficients := Whole.integerCoefficients].Carrier (I.Int^::ofNat n)) ->
  NewFrom.apply (Pull.map.apply (I.Int^::ofNat n) u) = Natural.commonMap.apply n (OldFrom.apply u) :=
  \fun (u: OldPair.With[coefficients := Whole.integerCoefficients].Carrier (I.Int^::ofNat n)) => CochainMaps.ext (NewFrom.apply (Pull.map.apply (I.Int^::ofNat n) u)) (Natural.commonMap.apply n (OldFrom.apply u))
    (\fun (x: NewChains.Carrier n) => congr!{{OldPair.Carrier (I.Int^::ofNat n)} K} u.apply _ _
      (PairMap.At[z := I.Int^::ofNat n].onClass (Extension.Positive[n := n].intro x)));
