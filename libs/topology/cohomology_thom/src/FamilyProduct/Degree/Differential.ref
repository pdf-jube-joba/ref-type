\import Mixed.CommonComplex[] \as CommonComplex;
\import Mixed.Common[n := N.Nat^::succ total] \as HigherCommon;
\import Model.ToSmall[n := N.Nat^::succ total].Descent[] \as HigherInto;
\import HigherInto.Linear[] \as HigherLinear;
\import Into.Commutes[] \as Commutes;
\import \parent.\parent.Degree[p := p, q := N.Nat^::succ q] \as Upper;
\import Mixed.RightPrimitive[p := p, r := q] \as Leibniz;
\import Modules.Alternating[V := HigherCommon.Carrier, space := HigherCommon.space].Concatenation[] \as CommonSigns;
\import Modules.Alternating[V := Target.Carrier (I.Int^::ofNat (N.Nat^::succ total)), space := Target.space (I.Int^::ofNat (N.Nat^::succ total))].Concatenation[] \as Signs;
\import CommonSigns.Mapping[W := Target.Carrier (I.Int^::ofNat (N.Nat^::succ total)), target := Target.space (I.Int^::ofNat (N.Nat^::succ total))] \as SignMap;
\definition law: \forall (a: First.Carrier (I.Int^::ofNat p))(b: Second.Carrier inputDegree) ->
  First.complex.differential.apply (I.Int^::ofNat p) a = (First.space (I.Int^::ofNat (N.Nat^::succ p))).zero ->
  Target.complex.differential.apply outputDegree (apply a b) = Signs.twist p (Upper.apply a (Second.complex.differential.apply inputDegree b)) :=
  \fun (a: First.Carrier (I.Int^::ofNat p))(b: Second.Carrier inputDegree)(closed: _) => eq_reason_in!{{Target.Carrier (I.Int^::ofNat (N.Nat^::succ total))} _
    "=" _ "by" { sym!{{Target.Carrier (I.Int^::ofNat (N.Nat^::succ total))}} _ _ (Commutes.law (Product.product a b)) }
    "=" _ "by" { congr!{HigherCommon.Carrier {Target.Carrier (I.Int^::ofNat (N.Nat^::succ total))}} HigherInto.apply _ _ (Leibniz.signed a b closed) }
    "=" _ "by" { SignMap.law HigherLinear.map p (Mixed.Cup[p := p, q := N.Nat^::succ q].Both[].product a (Second.complex.differential.apply inputDegree b)) }
  };
