\import \parent.Unit[] \as Unit;
\definition z: I.Int^ := I.Int^::ofNat p;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Integer;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import Integer.At[C := First.complex, z := z] \as Input;
\import Integer.At[C := Target.complex, z := z] \as Output;
\import UnionRelative.With[coefficients := Whole.integerCoefficients] \as UnionCochains;
\import Integer.At[C := UnionCochains.complex, z := z] \as UnionH;
\import Mixed.CommonComplex[] \as CommonComplex;
\import Nonnegative.At[C := CommonComplex.complex, k := p] \as CommonH;
\import Nonnegative.ZeroExtension[C := CommonComplex.complex] \as Extension;
\import Integer.At[C := Extension.complex, z := z] \as ExtendedH;
\import Model.CommonIso[].Maps[] \as ModelMaps;
\import Integer.Isomorphism[C := Target.complex, D := Extension.complex].On[e := ModelMaps.isomorphism].At[z := z] \as ModelIso;
\import Extension.PositiveCohomology[n := p] \as Positive;
\import Modules.Isomorphism[V := Output.Cohomology, W := ExtendedH.Cohomology, source := Output.cohomologySpace, target := ExtendedH.cohomologySpace].Composition[U := CommonH.Cohomology, final := CommonH.cohomologySpace] \as ModelComposition;
\definition commonIsomorphism: Modules.Isomorphism[V := Output.Cohomology, W := CommonH.Cohomology, source := Output.cohomologySpace, target := CommonH.cohomologySpace].Isomorphism :=
  ModelComposition.compose Positive.isomorphism ModelIso.isomorphism;
\import Covered.CommonIso[].Cohomology[n := p] \as UnionComparison;
\import Modules.Isomorphism[V := Input.Cohomology, W := UnionH.Cohomology, source := Input.cohomologySpace, target := UnionH.cohomologySpace].Composition[U := CommonH.Cohomology, final := CommonH.cohomologySpace] \as UnionComposition;
\definition intoCommon: Modules.Isomorphism[V := Input.Cohomology, W := CommonH.Cohomology, source := Input.cohomologySpace, target := CommonH.cohomologySpace].Isomorphism :=
  UnionComposition.compose UnionComparison.isomorphism (Pairs.With[coefficients := Whole.integerCoefficients].At[z := z].isomorphism pair);
\import Modules.Isomorphism[V := Input.Cohomology, W := CommonH.Cohomology, source := Input.cohomologySpace, target := CommonH.cohomologySpace].Composition[U := Output.Cohomology, final := Output.cohomologySpace] \as LastComposition;
\definition isomorphism: Modules.Isomorphism[V := Input.Cohomology, W := Output.Cohomology, source := Input.cohomologySpace, target := Output.cohomologySpace].Isomorphism :=
  LastComposition.compose (Modules.Isomorphism[V := Output.Cohomology, W := CommonH.Cohomology, source := Output.cohomologySpace, target := CommonH.cohomologySpace].Inverse[].inverse commonIsomorphism) intoCommon;
\module Product;
