\import Complexes.Homotopy[C := Boundary.complex, D := Boundary.complex] \as Native;
\import Complexes.Map[C := Joint.complex, D := Boundary.complex].Composition[B := Boundary.complex] \as Composition;
\import Complexes.End[C := Boundary.complex] \as Identity;
\definition data: Native.Data := Native.Data { apply := \fun (n: N.Nat^) => \parent.Degree[n := n].homotopy.apply };
\module At(n: N.Nat^);
\module Zero;
\module Positive(n: N.Nat^);
\definition laws: Native.Laws[Composition.compose forward backward, Identity.identity, data] := Native.Laws[Composition.compose forward backward, Identity.identity, data] {
  addition := \fun (n: N.Nat^) => \parent.Degree[n := n].homotopy.addition,
  scalar := \fun (n: N.Nat^) => \parent.Degree[n := n].homotopy.scalar,
  zeroEquation := Zero[].law,
  successorEquation := \fun (n: N.Nat^) => Positive[n := n].law
};
