\import \parent.Degree[n := n] \as Lower;
\import \parent.Degree[n := N.Nat^::succ n] \as Higher;
\definition candidateCommutes[z: Whole.Carrier (N.Nat^::succ n)]: (Whole.boundary n).apply ((Cover.candidateMap (N.Nat^::succ n)).apply z) = (Cover.candidateMap n).apply ((Whole.boundary n).apply z) :=
  eq_reason_in!{{Whole.Carrier n} _
    "=" _ "by" { congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier n}} (Whole.boundary n).apply _ _ (sym!{{Whole.Carrier (N.Nat^::succ n)}} _ _ (Cover.Compared[n := N.Nat^::succ n].included z)) }
    "=" _ "by" { Ambient.inclusion.commutes n (Cover.retraction.apply (N.Nat^::succ n) z) }
    "=" _ "by" { congr!{{Ambient.Carrier n} {Whole.Carrier n}} (Ambient.inclusion.apply n) _ _ (Cover.retraction.commutes n z) }
    "=" _ "by" { Cover.Compared[n := n].included ((Whole.boundary n).apply z) }
  };
\definition law: \forall (x: Boundary.Carrier (N.Nat^::succ n)) -> Joint.complex.differential.apply n (Higher.backward.apply x) = Lower.backward.apply (Boundary.complex.differential.apply n x) :=
  \fun (x: Boundary.Carrier (N.Nat^::succ n)) => Joint.Degree[n := n].injective _ _ (eq_reason_in!{{Whole.Carrier n} _
    "=" _ "by" { sym!{{Whole.Carrier n}} _ _ (Joint.inclusion.commutes n (Higher.backward.apply x)) }
    "=" _ "by" { congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier n}} ((Whole.boundary n).apply) _ _ (Higher.included x) }
    "=" _ "by" { candidateCommutes (Boundary.inclusion.apply (N.Nat^::succ n) x) }
    "=" _ "by" { congr!{{Whole.Carrier n} {Whole.Carrier n}} (Cover.candidateMap n).apply _ _ (Boundary.inclusion.commutes n x) }
    "=" _ "by" { sym!{{Whole.Carrier n}} _ _ (Lower.included (Boundary.complex.differential.apply n x)) }
  });
