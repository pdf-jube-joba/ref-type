\import Boundary.At[n := N.Nat^::succ n] \as Degree;
\import \parent.At[n := n] \as LowerComparison;
\import \parent.At[n := N.Nat^::succ n] \as Comparison;
\import Modules.Hom[V := Boundary.Carrier (N.Nat^::succ n), W := Whole.Carrier (N.Nat^::succ n), source := Boundary.space (N.Nat^::succ n), target := Whole.space (N.Nat^::succ n)] \as Maps;
\import Modules.Laws[V := Whole.Carrier (N.Nat^::succ n), space := Whole.space (N.Nat^::succ n)] \as WholeValues;
\import algebra.Group[].Of[Carrier := Whole.Carrier (N.Nat^::succ n), group := WholeValues.additive] \as Group;
\definition law: \forall (x: Boundary.Carrier (N.Nat^::succ n)) ->
  (Boundary.space (N.Nat^::succ n)).add (forward.apply (N.Nat^::succ n) (backward.apply (N.Nat^::succ n) x)) ((Boundary.space (N.Nat^::succ n)).neg x) =
  (Boundary.space (N.Nat^::succ n)).add (Boundary.complex.differential.apply (N.Nat^::succ n) (data.apply (N.Nat^::succ n) x)) (data.apply n (Boundary.complex.differential.apply n x)) :=
  \fun (x: Boundary.Carrier (N.Nat^::succ n)) => Degree.injective _ _ (eq_reason_in!{{Whole.Carrier (N.Nat^::succ n)} _
    "=" _ "by" { Maps.differencePreserved Degree.inclusion (forward.apply (N.Nat^::succ n) (backward.apply (N.Nat^::succ n) x)) x }
    "=" _ "by" { congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)}} (\fun (v: Whole.Carrier (N.Nat^::succ n)) => Group.difference v (Boundary.inclusion.apply (N.Nat^::succ n) x)) _ _ (Comparison.composite x) }
    "=" _ "by" { Cover.Right[].Arithmetic[n := N.Nat^::succ n].differenceSum (Boundary.inclusion.apply (N.Nat^::succ n) x)
      (WholeValues.add ((Whole.boundary (N.Nat^::succ n)).apply ((Cover.homotopyMap (N.Nat^::succ n)).apply (Boundary.inclusion.apply (N.Nat^::succ n) x)))
        ((Cover.homotopyMap n).apply ((Whole.boundary n).apply (Boundary.inclusion.apply (N.Nat^::succ n) x)))) }
    "=" _ "by" { congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier (N.Nat^::succ n)}} WholeValues.add _ _ _ _
      (sym!{{Whole.Carrier (N.Nat^::succ n)}} _ _ (Comparison.differential x)) (sym!{{Whole.Carrier (N.Nat^::succ n)}} _ _ (LowerComparison.prior x)) }
    "=" _ "by" { sym!{{Whole.Carrier (N.Nat^::succ n)}} _ _ (Degree.inclusion.addition (Boundary.complex.differential.apply (N.Nat^::succ n) (data.apply (N.Nat^::succ n) x)) (data.apply n (Boundary.complex.differential.apply n x))) }
  });
