\import Boundary.At[n := N.Nat^::zero] \as Degree;
\import \parent.At[n := N.Nat^::zero] \as Comparison;
\import Modules.Hom[V := Boundary.Carrier N.Nat^::zero, W := Whole.Carrier N.Nat^::zero, source := Boundary.space N.Nat^::zero, target := Whole.space N.Nat^::zero] \as Maps;
\import Modules.Laws[V := Whole.Carrier N.Nat^::zero, space := Whole.space N.Nat^::zero] \as WholeValues;
\import algebra.Group[].Of[Carrier := Whole.Carrier N.Nat^::zero, group := WholeValues.additive] \as Group;
\definition law: \forall (x: Boundary.Carrier N.Nat^::zero) ->
  (Boundary.space N.Nat^::zero).add (forward.apply N.Nat^::zero (backward.apply N.Nat^::zero x)) ((Boundary.space N.Nat^::zero).neg x) =
  Boundary.complex.differential.apply N.Nat^::zero (data.apply N.Nat^::zero x) :=
  \fun (x: Boundary.Carrier N.Nat^::zero) => Degree.injective _ _ (eq_reason_in!{{Whole.Carrier N.Nat^::zero} _
    "=" _ "by" { Maps.differencePreserved Degree.inclusion (forward.apply N.Nat^::zero (backward.apply N.Nat^::zero x)) x }
    "=" _ "by" { congr!{{Whole.Carrier N.Nat^::zero} {Whole.Carrier N.Nat^::zero}} (\fun (v: Whole.Carrier N.Nat^::zero) => Group.difference v (Boundary.inclusion.apply N.Nat^::zero x)) _ _ (Comparison.composite x) }
    "=" _ "by" { Cover.Right[].Arithmetic[n := N.Nat^::zero].differenceSum (Boundary.inclusion.apply N.Nat^::zero x)
      ((Whole.boundary N.Nat^::zero).apply ((Cover.homotopyMap N.Nat^::zero).apply (Boundary.inclusion.apply N.Nat^::zero x))) }
    "=" _ "by" { sym!{{Whole.Carrier N.Nat^::zero}} _ _ (Comparison.differential x) }
  });
