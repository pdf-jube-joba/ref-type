\import \parent.\parent.Degree[n := n] \as Current;
\import \parent.\parent.Degree[n := N.Nat^::succ n] \as Higher;
\definition composite: \forall (x: Boundary.Carrier n) -> Boundary.inclusion.apply n (forward.apply n (backward.apply n x)) = (Cover.candidateMap n).apply (Boundary.inclusion.apply n x) :=
  \fun (x: Boundary.Carrier n) => trans!{{Whole.Carrier n}} _ _ _ (Joint.Degree[n := n].leftLaw (backward.apply n x)) (Current.included x);
\definition differential: \forall (x: Boundary.Carrier n) -> Boundary.inclusion.apply n (Boundary.complex.differential.apply n (data.apply n x)) =
  (Whole.boundary n).apply ((Cover.homotopyMap n).apply (Boundary.inclusion.apply n x)) :=
  \fun (x: Boundary.Carrier n) => trans!{{Whole.Carrier n}} _ _ _
    (sym!{{Whole.Carrier n}} _ _ (Boundary.inclusion.commutes n (data.apply n x)))
    (congr!{{Whole.Carrier (N.Nat^::succ n)} {Whole.Carrier n}} ((Whole.boundary n).apply) _ _ (Current.homotopyIncluded x));
\definition prior: \forall (x: Boundary.Carrier (N.Nat^::succ n)) -> Boundary.inclusion.apply (N.Nat^::succ n) (data.apply n (Boundary.complex.differential.apply n x)) =
  (Cover.homotopyMap n).apply ((Whole.boundary n).apply (Boundary.inclusion.apply (N.Nat^::succ n) x)) :=
  \fun (x: Boundary.Carrier (N.Nat^::succ n)) => trans!{{Whole.Carrier (N.Nat^::succ n)}} _ _ _
    (Current.homotopyIncluded (Boundary.complex.differential.apply n x))
    (congr!{{Whole.Carrier n} {Whole.Carrier (N.Nat^::succ n)}} (Cover.homotopyMap n).apply _ _ (sym!{{Whole.Carrier n}} _ _ (Boundary.inclusion.commutes n x)));
