\import Lower.At[a := a] \as Before;
\import Higher.At[a := a] \as After;
\definition source: Modules.Bundle := Modules.Bundle { Carrier := Lower.RightClass, space := Lower.rightSpace };
\definition target: Modules.Bundle := Modules.Bundle { Carrier := Higher.RightClass, space := Higher.rightSpace };
\definition lower: Modules.Bundle := Modules.Bundle { Carrier := Lower.Class, space := Lower.space };
\definition higher: Modules.Bundle := Modules.Bundle { Carrier := Higher.Class, space := Higher.space };
\definition isomorphism[previous: Before.Bijective]: Modules.Isomorphism[V := Higher.RightClass, W := Higher.Class, source := Higher.rightSpace, target := Higher.space].Isomorphism :=
  \root.IntegralComparison[].SignedConjugation[A := source, B := target, C := lower, D := higher, p := n,
    sourceIso := sourceIsomorphism, targetIso := targetIsomorphism, lowerIso := Before.isomorphism previous,
    upper := Higher.rightLinear a, comparison := Comparison[].law a].isomorphism;
\definition injective[previous: Before.Bijective]: \forall (x, y: Higher.RightClass) -> Higher.raw a x = Higher.raw a y -> x = y :=
  \fun (x, y: Higher.RightClass)(same: _) => trans!{Higher.RightClass} _ _ _
    (sym!{Higher.RightClass} _ _ ((isomorphism previous).leftInverse x))
    (trans!{Higher.RightClass} _ _ _ (congr!{Higher.Class Higher.RightClass} (isomorphism previous).backward.apply _ _ same) ((isomorphism previous).leftInverse y));
\definition bijective[previous: Before.Bijective]: After.Bijective := After.Bijective {
  injective := injective previous,
  onto := \fun (y: Higher.Class) => std.Logic[].Proposition[].existsIntro[Higher.RightClass, { x: Higher.RightClass \where Higher.raw a x = y }]
    ((isomorphism previous).backward.apply y) ((isomorphism previous).rightInverse y)
};
