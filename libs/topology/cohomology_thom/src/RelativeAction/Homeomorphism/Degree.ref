\import Here.Degree[p := p, q := q] \as Original;
\import There.Degree[p := p, q := q] \as Changed;
\definition factor[u: Original.Factor]: Changed.Factor := Comparison.Degree[n := q].isomorphism.forward.apply u;
\definition a: RingModules.Bundle := RingModules.Bundle { Carrier := Original.Domain, space := Original.ringDomainSpace };
\definition b: RingModules.Bundle := RingModules.Bundle { Carrier := Original.Range, space := Original.ringRangeSpace };
\definition c: RingModules.Bundle := RingModules.Bundle { Carrier := Changed.Domain, space := Changed.ringDomainSpace };
\definition d: RingModules.Bundle := RingModules.Bundle { Carrier := Changed.Range, space := Changed.ringRangeSpace };
\definition square: \forall (u: Original.Factor)(a: Original.Domain) -> (Changed.ringMap (factor u)).apply (EmptyComparison.Degree[n := p].isomorphism.forward.apply a) = Comparison.Degree[n := Original.total].isomorphism.forward.apply (Original.apply u a) :=
  \fun (u: Original.Factor)(a: Original.Domain) => sym!{Changed.Range} _ _ (Natural.Degree[p := p, q := q].law u a);
\definition isomorphism[u: Original.Factor][e: RingModules.Isomorphism[V := Original.Domain, W := Original.Range, source := Original.ringDomainSpace, target := Original.ringRangeSpace].Isomorphism]
  [formula: \forall (a: Original.Domain) -> e.forward.apply a = Original.apply u a]: RingModules.Isomorphism[V := Changed.Domain, W := Changed.Range, source := Changed.ringDomainSpace, target := Changed.ringRangeSpace].Isomorphism :=
  RingModules.IsomorphismSquare[A := a, B := b, C := c, D := d].transport EmptyComparison.Degree[n := p].isomorphism Comparison.Degree[n := Original.total].isomorphism e (Changed.ringMap (factor u))
    (\fun (a: Original.Domain) => trans!{Changed.Range} _ _ _ (square u a)
      (congr!{Original.Range Changed.Range} Comparison.Degree[n := Original.total].isomorphism.forward.apply _ _ (sym!{Original.Range} _ _ (formula a))));
