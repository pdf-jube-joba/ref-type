\import singular_cohomology.Relative[A := B, source := target, subset := part].Homeomorphism[B := A].Over[target := source, targetSubset := subset] \as Geometry;
\import \root.RelativeAction[A := A, source := source, subset := subset, K := K, ring := ring] \as Here;
\import \root.RelativeAction[A := B, source := target, subset := part, K := K, ring := ring] \as There;
\import Here.Along[B := B, target := target, part := part, f := Geometry.forwardMap data] \as Natural;
\import topology.Topology[Carrier := B] \as OtherSpace;
\import singular_cohomology.Relative[A := B, source := target, subset := OtherSpace.Empty].Homeomorphism[B := A].Over[target := source, targetSubset := Space.Empty] \as EmptyGeometry;
\definition empty: EmptyGeometry.Data := EmptyGeometry.Data {
  homeomorphism := data.homeomorphism,
  forwardPreserves := \fun (b: \Cast[B] OtherSpace.Empty) => \bysub(B, OtherSpace.Empty, b),
  backwardPreserves := \fun (a: \Cast[A] Space.Empty) => \bysub(A, Space.Empty, a)
};
\import \root.RelativePullback[].On[A := B, source := target, subset := part, R := K, ring := ring].To[B := A, target := source, part := subset].Homeomorphism[data := data] \as Comparison;
\import \root.RelativePullback[].On[A := B, source := target, subset := OtherSpace.Empty, R := K, ring := ring].To[B := A, target := source, part := Space.Empty].Homeomorphism[data := empty] \as EmptyComparison;
\module Degree(p, q: N.Nat^);
