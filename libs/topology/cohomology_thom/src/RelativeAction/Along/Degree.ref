\import \root.RelativeAction[A := A, source := source, subset := subset, K := K, ring := ring].Degree[p := p, q := q] \as Here;
\import Other.Degree[p := p, q := q] \as There;
\import singular_cap.CochainPair[A := B, source := target, subset := part, R := K, ring := ring].Cohomology[p := p, q := q].Right[] \as Cup;
\import singular_products.Cochains[A := B, source := target, R := K, ring := ring] \as OtherProduct;
\definition law: \forall (u: Here.Factor)(a: Here.Domain) -> Pull.Degree[n := Here.total].map.apply (Here.apply u a) = There.apply (Pull.Degree[n := q].map.apply u) (EmptyPull.Degree[n := p].map.apply a) :=
  \fun (u: Here.Factor)(a: Here.Domain) => trans!{There.Range} _ _ _
    (Pull.Cup[p := p, q := q].Cohomology[].naturality (EmptyCup.Comparison[n := p].Cohomology[].map.apply a) u)
    (congr!{{OtherProduct.Cohomology[].Group p} There.Range} (\fun (b: OtherProduct.Cohomology[].Group p) => Cup.apply b (Pull.Degree[n := q].map.apply u)) _ _ (sym!{{OtherProduct.Cohomology[].Group p}} _ _ (EmptyPull.Degree[n := p].Forget[].law a)));
