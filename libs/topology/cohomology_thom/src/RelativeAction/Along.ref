\import \root.RelativeAction[A := B, source := target, subset := part, K := K, ring := ring] \as Other;
\import singular_cohomology.Relative[A := B, source := target, subset := part].Maps[B := A].Over[target := source, targetSubset := subset] \as Pairs;
\import topology.Topology[Carrier := B] \as OtherSpace;
\import singular_cohomology.Relative[A := B, source := target, subset := OtherSpace.Empty] \as OtherEmpty;
\import OtherEmpty.Maps[B := A].Over[target := source, targetSubset := Space.Empty] \as EmptyMaps;
\definition regular: topology.Continuity[A := B, B := A].Continuous target source f := (Pairs.laws f).continuous;
\definition emptyMap: EmptyMaps.Map := \into[B -> A](f, EmptyMaps.Map) \by {
  EmptyMaps.Laws[f] { continuous := regular, contained := \fun (b: OtherEmpty.SubspaceCarrier) => \bysub(B, OtherSpace.Empty, b) }
};
\import \root.RelativePullback[].On[A := B, source := target, subset := part, R := K, ring := ring].To[B := A, target := source, part := subset].Along[f := f] \as Pull;
\import \root.RelativePullback[].On[A := B, source := target, subset := OtherSpace.Empty, R := K, ring := ring].To[B := A, target := source, part := Space.Empty].Along[f := emptyMap] \as EmptyPull;
\module Degree(p, q: N.Nat^);
