\import Modules.Isomorphism[V := RightClass, W := Class, source := rightSpace, target := space].OfBijective[f := rightLinear a] \as Inverse;
\structure Bijective: \Prop := {
  injective: Inverse.Injective,
  onto: Inverse.Onto
};
\definition isomorphism[good: Bijective]: Modules.Isomorphism[V := RightClass, W := Class, source := rightSpace, target := space].Isomorphism :=
  Inverse.isomorphism good.injective good.onto;
