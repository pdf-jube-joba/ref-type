\import Chains.Quotient[C := BoundaryExtension.complex, D := WholeExtension.complex].On[f := Inclusion.map] \as Quotient;
\definition included: \forall (z: I.Int^)(x: BoundaryExtension.Carrier z) -> \In[WholeExtension.Carrier (chain_complexes.Chain[].next z)] (Quotient.At[k := chain_complexes.Chain[].next z].image.carrier)
  (IntegerHomotopy.integerHomotopy.apply z (Inclusion.map.apply z x)) :=
  \induction (z: I.Int^) \return \forall (x: BoundaryExtension.Carrier z) -> \In[WholeExtension.Carrier (chain_complexes.Chain[].next z)] (Quotient.At[k := chain_complexes.Chain[].next z].image.carrier)
    (IntegerHomotopy.integerHomotopy.apply z (Inclusion.map.apply z x)) \with {
      | ofNat: \fun (n: N.Nat^) => \parent.Degree[n := n].integerImage
      | negSucc: \fun (n: N.Nat^)(x: BoundaryExtension.Carrier (I.Int^::negSucc n)) =>
        (Quotient.At[k := chain_complexes.Chain[].next (I.Int^::negSucc n)].image).zero
    };
\module At(z: I.Int^);
\definition law: \forall (z: I.Int^)(x: WholeExtension.Carrier z) -> \In[WholeExtension.Carrier z] (Quotient.At[k := z].image.carrier) x ->
  \In[WholeExtension.Carrier (chain_complexes.Chain[].next z)] (Quotient.At[k := chain_complexes.Chain[].next z].image.carrier) (IntegerHomotopy.integerHomotopy.apply z x) :=
  \fun (z: I.Int^) => At[z := z].law;
