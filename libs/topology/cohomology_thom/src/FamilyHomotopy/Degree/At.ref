\definition U: \Cast[\Pow A] family := \into[\Pow A](witness.element, family) \by { witness.member };
\definition contained: \forall (p: Geometry.Points) -> \In[A] U (Prism.family f g h sigma p) :=
  \fun (p: Geometry.Points) => preserves witness.element witness.member (algebraic_topology.Cylinder[A := Simplex.Carrier n].time p)
    (sigma (algebraic_topology.Cylinder[A := Simplex.Carrier n].point p)) (witness.contained (algebraic_topology.Cylinder[A := Simplex.Carrier n].point p));
\import \root.RelativeMayerVietoris[].IntoSmall[A := A, B := Geometry.Points, target := source, source := GeometrySpace.topology, family := family,
  f := Prism.family f g h sigma, continuous := Prism.continuous f g h sigma, U := U, contained := contained] \as Into;
\definition law: Higher.Image (Prism.onSimplex f g h sigma) := Logic.existsIntro[Boundary.Carrier (N.Nat^::succ n),
  { x: Boundary.Carrier (N.Nat^::succ n) \where Higher.inclusion.apply x = Prism.onSimplex f g h sigma }]
  (Into.map.apply (N.Nat^::succ n) Geometry.Prism[].chain) (Into.Comparison[].At[n := N.Nat^::succ n].law Geometry.Prism[].chain);
