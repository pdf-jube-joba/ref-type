\import singular_cohomology.Simplices[A := A, source := source] \as Simplices;
\import algebraic_topology.Simplex[] \as Simplex;
\definition first: \forall (n: N.Nat^)(sigma: BoundarySimplices.Carrier n) -> \In[Simplices.Carrier n] (BoundarySimplices.Small n) (Maps.postcompose n f firstRegular sigma) := \block {
  \fun (n: N.Nat^)(sigma: BoundarySimplices.Carrier n) \then
  \takefrom witness: BoundarySimplices.Witness[n, sigma] \by BoundarySimplices.witness n sigma \then
  \return \exact(BoundarySimplices.Witness[n, Maps.postcompose n f firstRegular sigma] {
    element := witness.element, member := witness.member,
    contained := \fun (x: Simplex.Carrier n) => \idelim h (Cylinder.at J.start (sigma x)) = f (sigma x) \with value: A => \In[A] witness.element value \by {
      base: preserves witness.element witness.member J.start (sigma x) (witness.contained x),
      equality: (Topological.laws source source f g h).start (sigma x)
    }
  }, BoundarySimplices.Witness[n, Maps.postcompose n f firstRegular sigma])
};
\definition last: \forall (n: N.Nat^)(sigma: BoundarySimplices.Carrier n) -> \In[Simplices.Carrier n] (BoundarySimplices.Small n) (Maps.postcompose n g lastRegular sigma) := \block {
  \fun (n: N.Nat^)(sigma: BoundarySimplices.Carrier n) \then
  \takefrom witness: BoundarySimplices.Witness[n, sigma] \by BoundarySimplices.witness n sigma \then
  \return \exact(BoundarySimplices.Witness[n, Maps.postcompose n g lastRegular sigma] {
    element := witness.element, member := witness.member,
    contained := \fun (x: Simplex.Carrier n) => \idelim h (Cylinder.at J.end (sigma x)) = g (sigma x) \with value: A => \In[A] witness.element value \by {
      base: preserves witness.element witness.member J.end (sigma x) (witness.contained x),
      equality: (Topological.laws source source f g h).end (sigma x)
    }
  }, BoundarySimplices.Witness[n, Maps.postcompose n g lastRegular sigma])
};
