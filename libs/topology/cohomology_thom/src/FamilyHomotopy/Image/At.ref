\import Chains.Map[C := BoundaryExtension.complex, D := WholeExtension.complex].At[k := z] \as InclusionAt;
\import Modules.Of[V := WholeExtension.Carrier z, space := WholeExtension.space z].Submodule[] \as Submodules;
\import Submodules.Image[U := BoundaryExtension.Carrier z, source := BoundaryExtension.space z] \as Images;
\definition law: \forall (x: WholeExtension.Carrier z) -> Submodules.Member Quotient.At[k := z].image x ->
  \In[WholeExtension.Carrier (chain_complexes.Chain[].next z)] (Quotient.At[k := chain_complexes.Chain[].next z].image.carrier) (IntegerHomotopy.integerHomotopy.apply z x) :=
  \fun (x: WholeExtension.Carrier z)(member: Submodules.Member Quotient.At[k := z].image x) => Images.eliminate (InclusionAt.linear Inclusion.map) x
    (\In[WholeExtension.Carrier (chain_complexes.Chain[].next z)] (Quotient.At[k := chain_complexes.Chain[].next z].image.carrier) (IntegerHomotopy.integerHomotopy.apply z x))
    (\fun (y: BoundaryExtension.Carrier z)(same: Inclusion.map.apply z y = x) => \idelim Inclusion.map.apply z y = x
      \with value: WholeExtension.Carrier z => \In[WholeExtension.Carrier (chain_complexes.Chain[].next z)] (Quotient.At[k := chain_complexes.Chain[].next z].image.carrier) (IntegerHomotopy.integerHomotopy.apply z value)
      \by { base: included z y, equality: same }) member;
