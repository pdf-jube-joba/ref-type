\import Pair.With[coefficients := coefficients] \as Theory;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Integer[P := Pair.complex, N := coefficients] \as Cohomology;
\import Hom.IntegerHomotopy[P := Pair.complex, Q := Pair.complex, N := coefficients] \as Invariance;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Scalars;
\import Hom.IntegerMapping[P := Pair.complex, Q := Pair.complex, N := coefficients, L := coefficients].On[f := Start.map, u := Scalars.identity] \as StartPull;
\import Hom.IntegerMapping[P := Pair.complex, Q := Pair.complex, N := coefficients, L := coefficients].On[f := End.map, u := Scalars.identity] \as EndPull;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring].Map[C := Cohomology.complex, D := Cohomology.complex] \as Maps;
\module At(z: I.Int^) {
  \definition first: _ := Maps.At[k := z].induced StartPull.map;
  \definition last: _ := Maps.At[k := z].induced EndPull.map;
  \definition law: \forall (q: chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring].At[C := Cohomology.complex, z := z].Cohomology) -> first.apply q = last.apply q :=
    \fun (q: chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring].At[C := Cohomology.complex, z := z].Cohomology) => sym!{{chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring].At[C := Cohomology.complex, z := z].Cohomology}} _ _ (Invariance.onCohomology End.map Start.map homotopy z q);
}
