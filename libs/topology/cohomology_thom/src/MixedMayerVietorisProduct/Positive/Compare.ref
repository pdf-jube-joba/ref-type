\import singular_cohomology.Relative[A := A, source := source, subset := second].With[coefficients := WholeProduct.integerCoefficients] \as WholeSource;
\import singular_cohomology.Relative[A := A, source := source, subset := first].With[coefficients := WholeProduct.integerCoefficients] \as WholeFirst;
\import \root.FamilyPair[A := A, source := source, family := family].With[coefficients := WholeProduct.integerCoefficients] \as WholeTarget;
\import singular_subdivision.OpenCover[A := A, source := source].On[cover := Cover.openCover].Subspace[subset := second].Relative[].With[coefficients := WholeProduct.integerCoefficients] \as SourceComparison;
\import TargetSmallPair.With[coefficients := WholeProduct.integerCoefficients] \as TargetComparison;
\import IntegerCochains.At[C := WholeSource.complex, z := inputDegree] \as WholeInput;
\import IntegerCochains.At[C := WholeTarget.complex, z := outputDegree] \as WholeOutput;
\import IntegerCochains.At[C := WholeFirst.complex, z := I.Int^::ofNat p] \as FirstH;
\import IntegerCochains.Map[C := WholeSource.complex, D := SourceSmallHom.complex].At[k := inputDegree] \as InputMap;
\import IntegerCochains.Map[C := WholeTarget.complex, D := SmallHom.complex].At[k := outputDegree] \as OutputMap;
\import WholeFamilyProduct.Degree[p := p, q := N.Nat^::succ q].Cohomology[] \as Product;
\definition onClass: \forall (a: Restriction.Cycle)(h: WholeInput.Closed) ->
  apply a ((InputMap.induced SourceComparison.restriction).apply (WholeInput.classOf h)) =
  (OutputMap.induced TargetComparison.restriction).apply (Product.product (FirstH.classOf a) (WholeInput.classOf h)) :=
  \fun (a: Restriction.Cycle)(h: WholeInput.Closed) => eq_reason_in!{Output.Cohomology _
    "=" _ "by" { congr!{Input.Cohomology Output.Cohomology} (apply a) _ _ (InputMap.onClass SourceComparison.restriction h) }
    "=" _ "by" { \root.MixedMayerVietorisProduct[A := A, source := source, first := first, second := second, K := K, ring := ring, cover := cover].Positive[p := p, q := q].onClass a ((InputMap.cyclesMap SourceComparison.restriction).apply h) }
    "=" _ "by" { congr!{Output.Closed Output.Cohomology} Output.classOf
      (Upper.Cycles[].cycle a ((InputMap.cyclesMap SourceComparison.restriction).apply h)) ((OutputMap.cyclesMap TargetComparison.restriction).apply (Product.cycle a h)) (Upper.Compare[].law a h) }
    "=" _ "by" { sym!{Output.Cohomology} _ _ (OutputMap.onClass TargetComparison.restriction (Product.cycle a h)) }
    "=" _ "by" { congr!{WholeOutput.Cohomology Output.Cohomology} (OutputMap.induced TargetComparison.restriction).apply _ _ (sym!{WholeOutput.Cohomology} _ _ (Product.onClasses a h)) }
  };
\definition law: \forall (a: Restriction.Cycle)(h: WholeInput.Cohomology) ->
  apply a ((InputMap.induced SourceComparison.restriction).apply h) =
  (OutputMap.induced TargetComparison.restriction).apply (Product.product (FirstH.classOf a) h) :=
  \fun (a: Restriction.Cycle) => WholeInput.classInduction (\fun (h: WholeInput.Cohomology) => apply a ((InputMap.induced SourceComparison.restriction).apply h) = (OutputMap.induced TargetComparison.restriction).apply (Product.product (FirstH.classOf a) h)) (onClass a);
