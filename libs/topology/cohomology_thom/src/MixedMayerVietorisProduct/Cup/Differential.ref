\definition higher: I.Int^ := I.Int^::ofNat (N.Nat^::succ total);
\import \parent.\parent.Cup[p := p, q := N.Nat^::succ q] \as Upper;
\import \parent.SumAction[].Differential[] \as SumDifferential;
\import Modules.Alternating[V := SmallHom.Carrier higher, space := SmallHom.space higher].Concatenation[] \as Signs;
\import Modules.Alternating[V := SumHom.Carrier higher, space := SumHom.space higher].Concatenation[] \as SumSigns;
\import Signs.Mapping[W := SumHom.Carrier higher, target := SumHom.space higher] \as SignMap;
\import IntegerCochains.Map[C := SmallHom.complex, D := SumHom.complex].At[k := higher] \as Inclusion;
\definition law: \forall (a: Restriction.Cycle)(h: SourceSmallHom.Carrier inputDegree) ->
  SmallHom.complex.differential.apply outputDegree (apply a h) = Signs.twist p (Upper.apply a (SourceSmallHom.complex.differential.apply inputDegree h)) :=
  \fun (a: Restriction.Cycle)(h: SourceSmallHom.Carrier inputDegree) => MV.sequence.injective higher _ _
    (eq_reason_in!{{SumHom.Carrier higher} _
      "=" _ "by" { sym!{{SumHom.Carrier higher}} _ _ (MV.sequence.inclusion.commutes outputDegree (apply a h)) }
      "=" _ "by" { congr!{{SumHom.Carrier outputDegree} {SumHom.Carrier higher}} (SumHom.complex.differential.apply outputDegree) _ _ (inclusion a h) }
      "=" _ "by" { SumDifferential.law a (SourceSequence.sequence.inclusion.apply inputDegree h) }
      "=" _ "by" { congr!{{SourceSumHom.Carrier (I.Int^::ofNat (N.Nat^::succ q))} {SumHom.Carrier higher}}
        (\fun (v: SourceSumHom.Carrier (I.Int^::ofNat (N.Nat^::succ q))) => SumSigns.twist p (Upper.sumAction a v)) _ _ (SourceSequence.sequence.inclusion.commutes inputDegree h) }
      "=" _ "by" { congr!{{SumHom.Carrier higher} {SumHom.Carrier higher}} (SumSigns.twist p) _ _ (sym!{{SumHom.Carrier higher}} _ _ (Upper.inclusion a (SourceSmallHom.complex.differential.apply inputDegree h))) }
      "=" _ "by" { sym!{{SumHom.Carrier higher}} _ _ (SignMap.law (Inclusion.linear MV.sequence.inclusion) p (Upper.apply a (SourceSmallHom.complex.differential.apply inputDegree h))) }
    });
