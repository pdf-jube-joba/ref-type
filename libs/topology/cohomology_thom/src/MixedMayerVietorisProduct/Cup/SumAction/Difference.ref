\import Modules.Laws[V := SourceSumHom.Carrier inputDegree, space := SourceSumHom.space inputDegree] \as InputLaws;
\import algebra.Group[].Of[Carrier := SourceSumHom.Carrier inputDegree, group := InputLaws.additive] \as InputGroup;
\import Modules.Laws[V := SumHom.Carrier outputDegree, space := SumHom.space outputDegree] \as ResultLaws;
\import algebra.Group[].Of[Carrier := SumHom.Carrier outputDegree, group := ResultLaws.additive] \as ResultGroup;
\definition law: \forall (a: Restriction.Raw)(h, j: SourceSumHom.Carrier inputDegree) ->
  sumAction a (InputGroup.difference h j) = ResultGroup.difference (sumAction a h) (sumAction a j) :=
  \fun (a: Restriction.Raw) => SumMaps.differencePreserved (linear a);
