\import IntegerCochains.At[C := SourceSmallHom.complex, z := inputDegree] \as Input;
\import IntegerCochains.At[C := SmallHom.complex, z := outputDegree] \as Output;
\import \parent.Differential[] \as Differential;
\import \parent.\parent.Cup[p := p, q := N.Nat^::succ q] \as Upper;
\import Modules.Alternating[V := SmallHom.Carrier (I.Int^::ofNat (N.Nat^::succ total)), space := SmallHom.space (I.Int^::ofNat (N.Nat^::succ total))].Concatenation[] \as Signs;
\definition closed: \forall (a: Restriction.Cycle)(h: Input.Closed) -> SmallHom.complex.differential.apply outputDegree (apply a h) = (SmallHom.space (I.Int^::ofNat (N.Nat^::succ total))).zero :=
  \fun (a: Restriction.Cycle)(h: Input.Closed) => trans!{{SmallHom.Carrier (I.Int^::ofNat (N.Nat^::succ total))}} _ _ _ (Differential.law a h)
    (trans!{{SmallHom.Carrier (I.Int^::ofNat (N.Nat^::succ total))}} _ _ _
      (congr!{{SourceSmallHom.Carrier (I.Int^::ofNat (N.Nat^::succ q))} {SmallHom.Carrier (I.Int^::ofNat (N.Nat^::succ total))}}
        (\fun (v: SourceSmallHom.Carrier (I.Int^::ofNat (N.Nat^::succ q))) => Signs.twist p (Upper.apply a v)) _ _ (\bysub(SourceSmallHom.Carrier inputDegree, Input.cycles.carrier, h)))
      (trans!{{SmallHom.Carrier (I.Int^::ofNat (N.Nat^::succ total))}} _ _ _
        (congr!{{SmallHom.Carrier (I.Int^::ofNat (N.Nat^::succ total))} {SmallHom.Carrier (I.Int^::ofNat (N.Nat^::succ total))}} (Signs.twist p) _ _ (Upper.Difference[].zero a))
        (Signs.twistZero p)));
\definition cycle[a: Restriction.Cycle][h: Input.Closed]: Output.Closed := Output.cycle (apply a h) (closed a h);
