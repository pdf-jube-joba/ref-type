\import singular_cohomology.Relative[A := A, source := source, subset := second].With[coefficients := WholeProduct.integerCoefficients] \as WholeSource;
\import \root.FamilyPair[A := A, source := source, family := family].With[coefficients := WholeProduct.integerCoefficients] \as WholeTarget;
\import singular_subdivision.OpenCover[A := A, source := source].On[cover := Cover.openCover].Subspace[subset := second].Relative[].With[coefficients := WholeProduct.integerCoefficients] \as SourceComparison;
\import TargetSmallPair.With[coefficients := WholeProduct.integerCoefficients] \as TargetComparison;
\import WholeFamilyProduct.Degree[p := p, q := q] \as WholeMultiplication;
\import \parent.Components[] \as Components;
\definition left: \forall (a: Restriction.Raw)(h: WholeSource.Carrier inputDegree) ->
  Coordinates.firstProjection.apply outputDegree (MV.sequence.inclusion.apply outputDegree (apply a (SourceComparison.restriction.apply inputDegree h))) =
  Coordinates.firstProjection.apply outputDegree (MV.sequence.inclusion.apply outputDegree (TargetComparison.restriction.apply outputDegree (WholeMultiplication.apply a h))) :=
  \fun (a: Restriction.Raw)(h: WholeSource.Carrier inputDegree) => eq_reason_in!{{LeftHom.Carrier outputDegree} _
    "=" _ "by" { congr!{{SumHom.Carrier outputDegree} {LeftHom.Carrier outputDegree}} (Coordinates.firstProjection.apply outputDegree) _ _ (inclusion a (SourceComparison.restriction.apply inputDegree h)) }
    "=" _ "by" { Components.left a (SourceComparison.restriction.apply inputDegree h) }
    "=" _ "by" { congr!{{SourceLeftHom.Carrier inputDegree} {LeftHom.Carrier outputDegree}} (LP.apply (Restriction.left a)) _ _ (SourceSequence.Coordinates[].At[z := inputDegree].left h) }
    "=" _ "by" { sym!{{LeftHom.Carrier outputDegree}} _ _ (LeftWholeNatural.Product[p := p, q := q].law a h) }
    "=" _ "by" { sym!{{LeftHom.Carrier outputDegree}} _ _ (MV.Coordinates[].At[z := outputDegree].leftLaw (WholeMultiplication.apply a h)) }
  };
\definition right: \forall (a: Restriction.Raw)(h: WholeSource.Carrier inputDegree) ->
  Coordinates.secondProjection.apply outputDegree (MV.sequence.inclusion.apply outputDegree (apply a (SourceComparison.restriction.apply inputDegree h))) =
  Coordinates.secondProjection.apply outputDegree (MV.sequence.inclusion.apply outputDegree (TargetComparison.restriction.apply outputDegree (WholeMultiplication.apply a h))) :=
  \fun (a: Restriction.Raw)(h: WholeSource.Carrier inputDegree) => eq_reason_in!{{RightHom.Carrier outputDegree} _
    "=" _ "by" { congr!{{SumHom.Carrier outputDegree} {RightHom.Carrier outputDegree}} (Coordinates.secondProjection.apply outputDegree) _ _ (inclusion a (SourceComparison.restriction.apply inputDegree h)) }
    "=" _ "by" { Components.right a (SourceComparison.restriction.apply inputDegree h) }
    "=" _ "by" { congr!{{SourceRightHom.Carrier inputDegree} {RightHom.Carrier outputDegree}} (RP.apply (Restriction.right a)) _ _ (SourceSequence.Coordinates[].At[z := inputDegree].right h) }
    "=" _ "by" { sym!{{RightHom.Carrier outputDegree}} _ _ (RightWholeNatural.Product[p := p, q := q].law a h) }
    "=" _ "by" { sym!{{RightHom.Carrier outputDegree}} _ _ (MV.Coordinates[].At[z := outputDegree].rightLaw (WholeMultiplication.apply a h)) }
  };
\definition law: \forall (a: Restriction.Raw)(h: WholeSource.Carrier inputDegree) ->
  apply a (SourceComparison.restriction.apply inputDegree h) = TargetComparison.restriction.apply outputDegree (WholeMultiplication.apply a h) :=
  \fun (a: Restriction.Raw)(h: WholeSource.Carrier inputDegree) => MV.sequence.injective outputDegree _ _ (Coordinates.ext outputDegree _ _ (left a h) (right a h));
