\import Modules.Laws[V := SourceSmallHom.Carrier inputDegree, space := SourceSmallHom.space inputDegree] \as InputLaws;
\import algebra.Group[].Of[Carrier := SourceSmallHom.Carrier inputDegree, group := InputLaws.additive] \as InputGroup;
\import Modules.Laws[V := SmallHom.Carrier outputDegree, space := SmallHom.space outputDegree] \as ResultLaws;
\import algebra.Group[].Of[Carrier := SmallHom.Carrier outputDegree, group := ResultLaws.additive] \as ResultGroup;
\import \parent.Linear[] \as Linear;
\import Modules.Hom[V := SourceSmallHom.Carrier inputDegree, W := SmallHom.Carrier outputDegree, source := SourceSmallHom.space inputDegree, target := SmallHom.space outputDegree] \as Maps;
\definition law: \forall (a: Restriction.Raw)(h, j: SourceSmallHom.Carrier inputDegree) -> apply a (InputGroup.difference h j) = ResultGroup.difference (apply a h) (apply a j) :=
  \fun (a: Restriction.Raw) => Maps.differencePreserved (Linear.map a);
\definition zero: \forall (a: Restriction.Raw) -> apply a (SourceSmallHom.space inputDegree).zero = (SmallHom.space outputDegree).zero :=
  \fun (a: Restriction.Raw) => Maps.zeroPreserved (Linear.map a);
