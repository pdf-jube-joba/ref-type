\import FirstMV.RightAction[K := K, ring := ring].Restriction[q := p] \as Native;
\import singular_cohomology.Relative[A := A, source := source, subset := first].With[coefficients := WholeProduct.integerCoefficients] \as First;
\definition Raw: \Set := First.Carrier (I.Int^::ofNat p);
\definition Cycle: \Set := Native.Cycle;
\definition left: Raw -> singular_cohomology.Relative[A := Left, source := leftTopology, subset := LeftFamily.firstPart].With[coefficients := WholeProduct.integerCoefficients].Carrier (I.Int^::ofNat p) := Native.left;
\definition right: Raw -> singular_cohomology.Relative[A := Right, source := rightTopology, subset := RightFamily.firstPart].With[coefficients := WholeProduct.integerCoefficients].Carrier (I.Int^::ofNat p) := Native.right;
\definition overlap[a: Raw]: singular_cohomology.Relative[A := Overlap, source := overlapTopology, subset := OverlapFamily.firstPart].With[coefficients := WholeProduct.integerCoefficients].Carrier (I.Int^::ofNat p) := LeftNatural.firstPullback.apply (I.Int^::ofNat p) (left a);
\definition agree: _ := Native.agree;
\definition leftCycle: _ := Native.leftCycle;
\definition rightCycle: _ := Native.rightCycle;
\import singular_cohomology.Relative[A := Left, source := leftTopology, subset := LeftFamily.firstPart].With[coefficients := WholeProduct.integerCoefficients] \as FirstLeft;
\import singular_cohomology.Relative[A := Right, source := rightTopology, subset := RightFamily.firstPart].With[coefficients := WholeProduct.integerCoefficients] \as FirstRight;
\import IntegerCochains.At[C := FirstLeft.complex, z := I.Int^::ofNat p] \as LeftH;
\import IntegerCochains.At[C := FirstRight.complex, z := I.Int^::ofNat p] \as RightH;
\definition leftClosed: \forall (a: Cycle) -> FirstLeft.complex.differential.apply (I.Int^::ofNat p) (left a) = (FirstLeft.space (I.Int^::ofNat (N.Nat^::succ p))).zero :=
  \fun (a: Cycle) => \bysub(FirstLeft.Carrier (I.Int^::ofNat p), LeftH.cycles.carrier, Native.leftCycle a);
\definition rightClosed: \forall (a: Cycle) -> FirstRight.complex.differential.apply (I.Int^::ofNat p) (right a) = (FirstRight.space (I.Int^::ofNat (N.Nat^::succ p))).zero :=
  \fun (a: Cycle) => \bysub(FirstRight.Carrier (I.Int^::ofNat p), RightH.cycles.carrier, Native.rightCycle a);
\import singular_cohomology.Relative[A := Overlap, source := overlapTopology, subset := OverlapFamily.firstPart].With[coefficients := WholeProduct.integerCoefficients] \as FirstOverlap;
\import IntegerCochains.At[C := FirstOverlap.complex, z := I.Int^::ofNat p] \as OverlapH;
\import IntegerCochains.Map[C := FirstLeft.complex, D := FirstOverlap.complex].At[k := I.Int^::ofNat p] \as OverlapAction;
\definition overlapCycle[a: Cycle]: OverlapH.Closed := (OverlapAction.cyclesMap LeftNatural.firstPullback).apply (leftCycle a);
