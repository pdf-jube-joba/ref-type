\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Integer[P := Source.complex, N := coefficients] \as SourceCochains;
\import Hom.Integer[P := Target.complex, N := coefficients] \as TargetCochains;
\import Hom.IntegerIsomorphism[P := Source.complex, Q := Target.complex, N := coefficients].On[e := isomorphism] \as Comparison;
\import Forward.With[coefficients := coefficients] \as ForwardPull;
\import Backward.With[coefficients := coefficients] \as BackwardPull;
\module At(z: I.Int^) {
  \import SourceCochains.Cohomology[z := z] \as SourceDegree;
  \import TargetCochains.Cohomology[z := z] \as TargetDegree;
  \definition isomorphism: Modules.Isomorphism[V := TargetDegree.Cohomology, W := SourceDegree.Cohomology, source := TargetDegree.cohomologySpace, target := SourceDegree.cohomologySpace].Isomorphism := Comparison.At[z := z].isomorphism;
  \definition forwardLaw: \forall (q: TargetDegree.Cohomology) -> isomorphism.forward.apply q = (ForwardPull.At[z := z].induced).apply q := \fun (q: TargetDegree.Cohomology) => \refl((ForwardPull.At[z := z].induced).apply q);
  \definition backwardLaw: \forall (q: SourceDegree.Cohomology) -> isomorphism.backward.apply q = (BackwardPull.At[z := z].induced).apply q := \fun (q: SourceDegree.Cohomology) => \refl((BackwardPull.At[z := z].induced).apply q);
}
