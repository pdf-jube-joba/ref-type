\module Dimension(n: N.Nat^) {
  \import thom_spaces.Thom[].DiskSuspension[X := X, space := source, n := n] \as Disk;
  \import algebraic_topology.Euclidean[].Dimension[n := n] \as Euclidean;
  \definition Carrier: \Set := Disk.DiskCarrier;
  \definition topology: topology.Topology[Carrier := Carrier].Topology := Disk.diskTopology;
  \definition projection[p: Carrier]: X := Pair.first X Euclidean.Coordinate p;
  \definition boundary: \Pow Carrier := { p: Carrier \where Logic.Or[\In[Carrier] Disk.boundary p, \In[X] subset (projection p)] };
  \module With(coefficients: Modules.Bundle, z: I.Int^) {
    \import singular_cohomology.Relative[A := Carrier, source := topology, subset := boundary].With[coefficients := coefficients].At[z := z] \as Theory;
    \definition Group: \Set := Theory.Carrier;
    \definition space: Modules.Space Group := Theory.space;
  }
}
\module Zero;
\module Step(n: N.Nat^);
\module With(coefficients: Modules.Bundle);
\module From(B: \Set, target: topology.Topology[Carrier := B].Topology, part: \Pow B,
  f: singular_cohomology.Relative[A := B, source := target, subset := part].Maps[B := X].Over[target := source, targetSubset := subset].Map);
