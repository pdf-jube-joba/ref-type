\definition next: I.Int^ := chain_complexes.Integer[].next z;
\import \parent.\parent.Dimension[n := n].With[coefficients := coefficients, z := z] \as Lower;
\import \parent.\parent.Dimension[n := N.Nat^::succ n].With[coefficients := coefficients, z := next] \as Upper;
\import singular_cohomology.Relative[A := Geometry.BoxCarrier, source := Geometry.boxTopology, subset := boxBoundary].With[coefficients := coefficients].At[z := next] \as Box;
\import singular_cohomology.Relative[A := Cylinder.Carrier, source := Cylinder.topology Disk.diskTopology, subset := Suspension.boundary].With[coefficients := coefficients].At[z := next] \as CylinderH;
\definition suspended: _ := Suspension.Covering[].With[coefficients := coefficients].At[z := z].isomorphism;
\definition toBox: Modules.Isomorphism[V := Lower.Group, W := Box.Carrier, source := Lower.space, target := Box.space].Isomorphism :=
  Modules.Isomorphism[V := Lower.Group, W := CylinderH.Carrier, source := Lower.space, target := CylinderH.space].Composition[U := Box.Carrier, final := Box.space]
    .compose (CylinderComparison.With[coefficients := coefficients].At[z := next].isomorphism cylinder) suspended;
\definition isomorphism: Modules.Isomorphism[V := Lower.Group, W := Upper.Group, source := Lower.space, target := Upper.space].Isomorphism :=
  Modules.Isomorphism[V := Lower.Group, W := Box.Carrier, source := Lower.space, target := Box.space].Composition[U := Upper.Group, final := Upper.space]
    .compose (RoundComparison.With[coefficients := coefficients].At[z := next].isomorphism round) toBox;
