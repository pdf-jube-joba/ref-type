\import singular_cohomology.Relative[A := X, source := source, subset := subset].With[coefficients := coefficients] \as Base;
\module At(n: N.Nat^, z: I.Int^) {
  \import \parent.\parent.Dimension[n := n].With[coefficients := coefficients, z := shift n z] \as Target;
  \definition Iso: \Set := Modules.Isomorphism[V := Base.At[z := z].Carrier, W := Target.Group, source := Base.At[z := z].space, target := Target.space].Isomorphism;
}
\definition isomorphism: \forall (n: N.Nat^)(z: I.Int^) -> At[n := n, z := z].Iso :=
  \induction (n: N.Nat^) \return \forall (z: I.Int^) -> At[n := n, z := z].Iso \with {
    | zero: \fun (z: I.Int^) => \parent.Zero[].With[coefficients := coefficients, z := z].isomorphism
    | succ: \fun (n: N.Nat^)(previous: \forall (z: I.Int^) -> At[n := n, z := z].Iso)(z: I.Int^) =>
      Modules.Isomorphism[V := Base.At[z := z].Carrier, W := \parent.Dimension[n := n].With[coefficients := coefficients, z := shift n z].Group,
        source := Base.At[z := z].space, target := \parent.Dimension[n := n].With[coefficients := coefficients, z := shift n z].space]
        .Composition[U := \parent.Dimension[n := N.Nat^::succ n].With[coefficients := coefficients, z := shift (N.Nat^::succ n) z].Group,
          final := \parent.Dimension[n := N.Nat^::succ n].With[coefficients := coefficients, z := shift (N.Nat^::succ n) z].space]
        .compose \parent.Step[n := n].With[coefficients := coefficients, z := shift n z].isomorphism (previous z)
  };
