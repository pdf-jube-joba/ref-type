\import \root.RelativePullback[].On[A := Closed.Carrier, source := Closed.topology, subset := Closed.secondPart, R := I.Int^, ring := Integers.commutativeRing].To[B := Right.Disk, target := Right.diskTopology, part := Zero.boundary].Along[f := Closed.secondMap] \as Pull;
\import singular_cap.CochainPair[A := Closed.Carrier, source := Closed.topology, subset := Closed.secondPart, R := I.Int^, ring := Integers.commutativeRing].Comparison[n := N.Nat^::zero] \as Comparison;
\import Coefficients.Pullback[B := Right.Disk, target := Right.diskTopology] \as WholePull;
\import Empty.Unit[] \as Target;
\definition cochains: Pull.pullback.apply (I.Int^::ofNat N.Nat^::zero) Zero.unitCochain = Target.cochain := Comparison.injective _ _ (eq_reason_in!{{Coefficients.Carrier N.Nat^::zero} _
  "=" _ "by" { Pull.Compare[n := N.Nat^::zero].law Zero.unitCochain }
  "=" _ "by" { congr!{{singular_products.Cochains[A := Right.Disk, source := Right.diskTopology, R := I.Int^, ring := Integers.commutativeRing].Carrier N.Nat^::zero} {Coefficients.Carrier N.Nat^::zero}}
    (WholePull.apply N.Nat^::zero Closed.secondMap Pull.continuous) _ _ Zero.unitUnderlying }
  "=" _ "by" { WholePull.Unit[].law Closed.secondMap Pull.continuous }
  "=" _ "by" { sym!{{Coefficients.Carrier N.Nat^::zero}} _ _ Target.underlying }
});
\import singular_cohomology.Relative[A := Closed.Carrier, source := Closed.topology, subset := Closed.secondPart].With[coefficients := Coefficients.integerCoefficients] \as Theory;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring].At[C := Theory.complex, z := I.Int^::ofNat N.Nat^::zero] \as H;
\definition law: Closed.secondPull.apply Zero.unit = Target.class :=
  trans!{H.Cohomology} _ _ _ (Pull.Degree[n := N.Nat^::zero].onClass Zero.unitCycle)
    (congr!{H.Closed H.Cohomology} H.classOf (Pull.Degree[n := N.Nat^::zero].cycles.apply Zero.unitCycle) Target.cycle cochains);
