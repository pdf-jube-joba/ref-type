\import \root.StandardClosedProduct[n := n, m := m, K := I.Int^, ring := Integers.commutativeRing] \as Closed;
\import \root.StandardShell[n := m] \as RightShell;
\import RightShell.PointModel[] \as RightCoordinates;
\import thom_spaces.Thom[].DiskSuspension[X := Point.Carrier, space := Point.topology, n := m] \as RightPointDisk;
\import algebraic_topology.Euclidean[].Dimension[n := m] \as RightDisk;
\import \root.LocalDisk[].Point[K := I.Int^, ring := Integers.commutativeRing].Rank[n := m] \as RightPoint;
\import \root.RelativePullback[].On[A := RightDisk.Disk, source := RightDisk.diskTopology, subset := RightShell.boundary, R := I.Int^, ring := Integers.commutativeRing].To[B := RightPointDisk.DiskCarrier, target := RightPointDisk.diskTopology, part := RightPointDisk.boundary].Homeomorphism[data := RightCoordinates.pair] \as RightComparison;
\import Modules.Isomorphism[V := I.Int^, W := RightPoint.Class, source := Modules.scalarModule, target := RightPoint.space].Composition[U := Closed.RightClass, final := Closed.rightSpace] \as RightComposition;
\definition rightIsomorphism: Modules.Isomorphism[V := I.Int^, W := Closed.RightClass, source := Modules.scalarModule, target := Closed.rightSpace].Isomorphism :=
  RightComposition.compose RightComparison.Degree[n := m].isomorphism RightPoint.isomorphism;
\definition rightNormalized: rightIsomorphism.forward.apply Integers.ring.one = RightShell.Ring[K := I.Int^, ring := Integers.commutativeRing].generator :=
  congr!{RightPoint.Class Closed.RightClass} RightComparison.Degree[n := m].isomorphism.forward.apply _ _ RightPoint.normalized;
\import Modules.Isomorphism[V := I.Int^, W := Closed.RightClass, source := Modules.scalarModule, target := Closed.rightSpace].Composition[U := Closed.Class, final := Closed.space] \as FinalComposition;
\definition isomorphism: Modules.Isomorphism[V := I.Int^, W := Closed.Class, source := Modules.scalarModule, target := Closed.space].Isomorphism :=
  FinalComposition.compose (Closed.At[a := left].isomorphism (bijective m)) rightIsomorphism;
\definition generator: Closed.Class := Closed.generator;
\definition law: isomorphism.forward.apply Integers.ring.one = generator :=
  trans!{Closed.Class} _ _ _
    (congr!{Closed.RightClass Closed.Class} (Closed.raw left) _ _ rightNormalized)
    (congr!{Closed.LeftClass Closed.Class} (\fun (a: Closed.LeftClass) => Closed.raw a (RightShell.Ring[K := I.Int^, ring := Integers.commutativeRing].generator)) _ _ normalized);
