\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.eq_reason_in;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import module_theory.Module[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as RingModules;
\import singular_products.Cochains[A := A, source := source, R := K, ring := ring] \as Product;
\import topology.Topology[Carrier := A] \as Space;
\import singular_cohomology.Relative[A := A, source := source, subset := subset] \as Pair;
\import singular_cohomology.Relative[A := A, source := source, subset := Space.Empty] \as EmptyPair;
\import Pair.With[coefficients := Product.integerCoefficients] \as Relative;
\import EmptyPair.With[coefficients := Product.integerCoefficients] \as EmptyRelative;
\import Pair.OverRing[R := K, ring := ring].With[coefficients := Product.coefficients] \as RelativeRing;
\import EmptyPair.OverRing[R := K, ring := ring].With[coefficients := Product.coefficients] \as EmptyRing;
\import singular_cap.CochainPair[A := A, source := source, subset := Space.Empty, R := K, ring := ring] \as EmptyCup;
\import singular_cap.CochainPair[A := A, source := source, subset := subset, R := K, ring := ring] \as PairCup;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import chain_complexes.Integer[].Over[R := K, ring := std.Alg[].Ring[].commutativeRingAsRing K ring] \as RingCochains;
\module Degree(p, q: N.Nat^);
\module Along(B: \Set, target: topology.Topology[Carrier := B].Topology, part: \Pow B,
  f: singular_cohomology.Relative[A := B, source := target, subset := part].Maps[B := A].Over[target := source, targetSubset := subset].Map);
