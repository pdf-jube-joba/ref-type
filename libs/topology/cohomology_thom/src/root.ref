\module Examples;
\module SmallSupport(A: \Set, source: topology.Topology[Carrier := A].Topology,
  cover: topology.Topology[Carrier := A].OpenCovers[topology := source].Cover,
  family: \Pow (\Pow A));
\module CandidateSupport(A: \Set, source: topology.Topology[Carrier := A].Topology,
  cover: topology.Topology[Carrier := A].OpenCovers[topology := source].Cover,
  family: \Pow (\Pow A));
\module SmallIntersection(A: \Set, source: topology.Topology[Carrier := A].Topology, leftFamily, rightFamily: \Pow (\Pow A));
\module SmallRefinement(A: \Set, source: topology.Topology[Carrier := A].Topology, cover: topology.Topology[Carrier := A].OpenCovers[topology := source].Cover, family: \Pow (\Pow A));
\module FamilyPair(A: \Set, source: topology.Topology[Carrier := A].Topology, family: \Pow (\Pow A));
\module FamilyPullback(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology, family: \Pow (\Pow B), f: A -> B, regular: topology.Continuity[A := A, B := B].Continuous source target f);
\module FamilyPairMap(A, B: \Set, source: topology.Topology[Carrier := A].Topology, target: topology.Topology[Carrier := B].Topology, sourceFamily: \Pow (\Pow A), targetFamily: \Pow (\Pow B), f: A -> B,
  regular: topology.Continuity[A := A, B := B].Continuous source target f,
  preserves: \forall (n: std.Data[].Nat[].Nat^)(sigma: singular_subdivision.Small[A := A, source := source, family := sourceFamily].Simplices[].Carrier n) ->
    \In[singular_cohomology.Simplices[A := B, source := target].Carrier n] (singular_subdivision.Small[A := B, source := target, family := targetFamily].Simplices[].Small n)
      (singular_cohomology.Maps[A := A, B := B, source := source, target := target].postcompose n f regular sigma));
\module FamilyIntoSmall(A, B: \Set, target: topology.Topology[Carrier := A].Topology, source: topology.Topology[Carrier := B].Topology, family: \Pow (\Pow A),
  cover: topology.Topology[Carrier := A].OpenCovers[topology := target].Cover, f: B -> A, regular: topology.Continuity[A := B, B := A].Continuous source target f,
  U: \Cast[\Pow A] (topology.Topology[Carrier := A].OpenCovers[topology := target].family cover),
  contained: \forall (b: B) -> \In[A] U (f b));
\module FreeSubsetTransport(G: \Set, S, T: \Pow G,
  toTarget: \forall (x: G) -> \In[G] S x -> \In[G] T x,
  toSource: \forall (x: G) -> \In[G] T x -> \In[G] S x);
\module FamilyMayerVietoris(A: \Set, source: topology.Topology[Carrier := A].Topology, family: \Pow (\Pow A), cover: singular_excision.MayerVietoris[A := A].Over[source := source].Cover);
\module FamilyHomotopy(A: \Set, source: topology.Topology[Carrier := A].Topology, family: \Pow (\Pow A), f, g: A -> A,
  h: algebraic_topology.Homotopy[A := A, B := A].Homotopy[source, source, f, g],
  preserves: \forall (U: \Pow A) -> \In[\Pow A] family U -> \forall (t: algebraic_topology.Interval[].Carrier)(x: A) -> \In[A] U x ->
    \In[A] U (h (algebraic_topology.Cylinder[A := A].at t x)));
\module FamilyCommonModel(A: \Set, source: topology.Topology[Carrier := A].Topology, first, second: \Pow A,
  family: \Pow (\Pow A), firstMember: \In[\Pow A] family first, secondMember: \In[\Pow A] family second,
  classify: \forall (U: \Pow A) -> \In[\Pow A] family U -> std.Logic[].Proposition[].Or[U = first, U = second],
  K: \Set, ring: std.Alg[].Ring[].CommutativeRing[K]);
\module BinaryFamilyPullback(A, B: \Set, first, second: \Pow B, f: A -> B);
\module StandardSum(X: \Set, space: topology.Topology[Carrier := X].Topology, n, m: std.Data[].Nat[].Nat^);
\module FamilyProduct(A: \Set, source: topology.Topology[Carrier := A].Topology, first, second: \Pow A, family: \Pow (\Pow A),
  firstMember: \In[\Pow A] family first, secondMember: \In[\Pow A] family second,
  classify: \forall (U: \Pow A) -> \In[\Pow A] family U -> std.Logic[].Proposition[].Or[U = first, U = second], K: \Set, ring: std.Alg[].Ring[].CommutativeRing[K]);
