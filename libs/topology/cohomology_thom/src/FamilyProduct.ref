\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.eq_reason_in;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import singular_products.Cochains[A := A, source := source, R := K, ring := ring] \as Whole;
\import singular_cohomology.Relative[A := A, source := source, subset := first].With[coefficients := Whole.integerCoefficients] \as First;
\import singular_cohomology.Relative[A := A, source := source, subset := second].With[coefficients := Whole.integerCoefficients] \as Second;
\import \root.FamilyPair[A := A, source := source, family := family].With[coefficients := Whole.integerCoefficients] \as Target;
\import \root.FamilyCommonModel[A := A, source := source, first := first, second := second, family := family, firstMember := firstMember, secondMember := secondMember, classify := classify, K := K, ring := ring] \as Model;
\import \root.MixedCup[A := A, source := source, first := first, second := second, K := K, ring := ring] \as Mixed;
\import singular_cap.CochainPair[A := A, source := source, subset := first, R := K, ring := ring] \as FirstPair;
\import singular_cap.CochainPair[A := A, source := source, subset := second, R := K, ring := ring] \as SecondPair;
\import \root.RelativeMayerVietoris[].IntegerLinear[] \as IntegerLinear;
\module Degree(p, q: N.Nat^);
\module From(Y: \Set, target: topology.Topology[Carrier := Y].Topology, firstPart, secondPart: \Pow Y, newFamily: \Pow (\Pow Y),
  newFirstMember: \In[\Pow Y] newFamily firstPart, newSecondMember: \In[\Pow Y] newFamily secondPart,
  newClassify: \forall (U: \Pow Y) -> \In[\Pow Y] newFamily U -> std.Logic[].Proposition[].Or[U = firstPart, U = secondPart],
  f: Y -> A, regular: topology.Continuity[A := Y, B := A].Continuous target source f,
  firstContained: \forall (y: Y) -> \In[Y] firstPart y -> \In[A] first (f y),
  secondContained: \forall (y: Y) -> \In[Y] secondPart y -> \In[A] second (f y));
\module EmptySecond(empty: \forall (x: A) -> \In[A] second x -> std.Logic[].Proposition[].False);
