\definition reflects: \forall (sigma: SourceSimplices.Carrier n) -> \In[singular_cohomology.Simplices[A := B, source := target].Carrier n] (TargetSimplices.Small n) (Maps.postcompose n f regular sigma) ->
  \In[SourceSimplices.Carrier n] (DomainSimplices.Small n) sigma := \block {
    \fun (sigma: SourceSimplices.Carrier n)(small: \In[singular_cohomology.Simplices[A := B, source := target].Carrier n] (TargetSimplices.Small n) (Maps.postcompose n f regular sigma)) \then
    \takefrom witness: TargetSimplices.Witness[n, Maps.postcompose n f regular sigma] \by small \then
    \return \exact(DomainSimplices.Witness[n, sigma] {
      element := Sets.Preimage f witness.element,
      member := Sets.pullbackMember f family witness.element witness.member,
      contained := \fun (x: Simplex.Carrier n) => witness.contained x
    }, DomainSimplices.Witness[n, sigma])
};
\definition lift[sigma: SourceSimplices.Carrier n][small: \In[singular_cohomology.Simplices[A := B, source := target].Carrier n] (TargetSimplices.Small n) (Maps.postcompose n f regular sigma)]: DomainSimplices.Carrier n :=
  \into[SourceSimplices.Carrier n](sigma, DomainSimplices.Small n) \by { reflects sigma small };
