\import singular_finite_algebra.Integer[].Units[] \as Units;
\import Modules.Hom[V := I.Int^, W := Class, source := Modules.scalarModule, target := space] \as Maps;
\definition positive: coefficient = Integers.ring.one -> product = Signs.signedOutput reverse canonical :=
  \fun (same: coefficient = Integers.ring.one) => eq_reason_in!{Class _
    "=" _ "by" { coordinate }
    "=" _ "by" { congr!{I.Int^ Class} canonicalIsomorphism.forward.apply _ _ same }
    "=" _ "by" { canonicalNormalized }
    "=" _ "by" { congr!{B.Bool^ Class} (\fun (b: B.Bool^) => Signs.signedOutput b canonical) _ _ (sym!{B.Bool^} _ _ (congr!{I.Int^ B.Bool^} negative _ _ same)) }
  };
\definition negativeCase: coefficient = Integers.ring.neg Integers.ring.one -> product = Signs.signedOutput reverse canonical :=
  \fun (same: coefficient = Integers.ring.neg Integers.ring.one) => eq_reason_in!{Class _
    "=" _ "by" { coordinate }
    "=" _ "by" { congr!{I.Int^ Class} canonicalIsomorphism.forward.apply _ _ same }
    "=" _ "by" { Maps.negativePreserved canonicalIsomorphism.forward Integers.ring.one }
    "=" _ "by" { congr!{Class Class} space.neg _ _ canonicalNormalized }
    "=" _ "by" { congr!{B.Bool^ Class} (\fun (b: B.Bool^) => Signs.signedOutput b canonical) _ _ (sym!{B.Bool^} _ _ (congr!{I.Int^ B.Bool^} negative _ _ same)) }
  };
\definition law: product = Signs.signedOutput reverse canonical := either!{{Units.automorphism automorphism} {product = Signs.signedOutput reverse canonical} positive negativeCase};
