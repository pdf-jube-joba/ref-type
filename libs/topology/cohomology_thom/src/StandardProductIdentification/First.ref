\definition z: I.Int^ := I.Int^::ofNat n;
\import singular_cohomology.Relative[A := Closed.Carrier, source := Closed.topology, subset := Closed.firstPart] \as Source;
\import Source.Maps[B := Closed.Carrier].Over[target := Closed.topology, targetSubset := Bridge.shellFirst].Composition[C := Left.Disk].Over[final := Left.diskTopology, finalSubset := LeftShell.shell] \as Before;
\import Source.Maps[B := Left.Disk].Over[target := Left.diskTopology, targetSubset := LeftShell.boundary].Composition[C := Left.Disk].Over[final := Left.diskTopology, finalSubset := LeftShell.shell] \as After;
\import Before.On[f := Natural.firstPairMap, g := Actual.leftMap].With[coefficients := Coefficients.integerCoefficients] \as BeforeLaw;
\import After.On[f := Closed.firstMap, g := LeftShell.include].With[coefficients := Coefficients.integerCoefficients] \as AfterLaw;
\import \root.RelativePullback[].On[A := Closed.Carrier, source := Closed.topology, subset := Closed.firstPart, R := K, ring := ring].To[B := Closed.Carrier, target := Closed.topology, part := Bridge.shellFirst].Along[f := Natural.firstPairMap] \as Pull;
\import \root.RelativePullback[].On[A := Closed.Carrier, source := Closed.topology, subset := Closed.firstPart, R := K, ring := ring].To[B := Left.Disk, target := Left.diskTopology, part := LeftShell.boundary].Along[f := Closed.firstMap] \as Projection;
\import Source.With[coefficients := Coefficients.integerCoefficients].At[z := z] \as H;
\import singular_cohomology.Relative[A := Left.Disk, source := Left.diskTopology, subset := LeftShell.boundary].With[coefficients := Coefficients.integerCoefficients].At[z := z] \as DiskH;
\definition law: \forall (a: LeftPoint.Class) -> Pull.Degree[n := n].map.apply (firstClass a) = Projection.Degree[n := n].map.apply (LeftShell.Ring[K := K, ring := ring].map a) :=
  \fun (a: LeftPoint.Class) => eq_reason_in!{H.Carrier _
    "=" _ "by" { sym!{H.Carrier} _ _ (BeforeLaw.law z (LeftShell.Ring[K := K, ring := ring].lift a)) }
    "=" _ "by" { AfterLaw.law z (LeftShell.Ring[K := K, ring := ring].lift a) }
    "=" _ "by" { congr!{DiskH.Carrier H.Carrier} Projection.Degree[n := n].map.apply _ _ (LeftShell.Ring[K := K, ring := ring].normalized a) }
  };
