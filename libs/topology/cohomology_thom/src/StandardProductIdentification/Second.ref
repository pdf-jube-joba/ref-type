\definition z: I.Int^ := I.Int^::ofNat m;
\import singular_cohomology.Relative[A := Closed.Carrier, source := Closed.topology, subset := Closed.secondPart] \as Source;
\import Source.Maps[B := Closed.Carrier].Over[target := Closed.topology, targetSubset := Bridge.shellSecond].Composition[C := Right.Disk].Over[final := Right.diskTopology, finalSubset := RightShell.shell] \as Before;
\import Source.Maps[B := Right.Disk].Over[target := Right.diskTopology, targetSubset := RightShell.boundary].Composition[C := Right.Disk].Over[final := Right.diskTopology, finalSubset := RightShell.shell] \as After;
\import Before.On[f := Natural.secondPairMap, g := Actual.rightMap].With[coefficients := Coefficients.integerCoefficients] \as BeforeLaw;
\import After.On[f := Closed.secondMap, g := RightShell.include].With[coefficients := Coefficients.integerCoefficients] \as AfterLaw;
\import \root.RelativePullback[].On[A := Closed.Carrier, source := Closed.topology, subset := Closed.secondPart, R := K, ring := ring].To[B := Closed.Carrier, target := Closed.topology, part := Bridge.shellSecond].Along[f := Natural.secondPairMap] \as Pull;
\import \root.RelativePullback[].On[A := Closed.Carrier, source := Closed.topology, subset := Closed.secondPart, R := K, ring := ring].To[B := Right.Disk, target := Right.diskTopology, part := RightShell.boundary].Along[f := Closed.secondMap] \as Projection;
\import Source.With[coefficients := Coefficients.integerCoefficients].At[z := z] \as H;
\import singular_cohomology.Relative[A := Right.Disk, source := Right.diskTopology, subset := RightShell.boundary].With[coefficients := Coefficients.integerCoefficients].At[z := z] \as DiskH;
\definition law: \forall (a: RightPoint.Class) -> Pull.Degree[n := m].map.apply (secondClass a) = Projection.Degree[n := m].map.apply (RightShell.Ring[K := K, ring := ring].map a) :=
  \fun (a: RightPoint.Class) => eq_reason_in!{H.Carrier _
    "=" _ "by" { sym!{H.Carrier} _ _ (BeforeLaw.law z (RightShell.Ring[K := K, ring := ring].lift a)) }
    "=" _ "by" { AfterLaw.law z (RightShell.Ring[K := K, ring := ring].lift a) }
    "=" _ "by" { congr!{DiskH.Carrier H.Carrier} Projection.Degree[n := m].map.apply _ _ (RightShell.Ring[K := K, ring := ring].normalized a) }
  };
