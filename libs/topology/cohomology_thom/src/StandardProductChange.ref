\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.eq_reason_in;
\import \root.StandardProduct[n := n, m := m, K := K, ring := ring] \as Old;
\import \root.StandardProduct[n := n, m := m, K := L, ring := targetRing] \as New;
\import \root.StandardShellChange[n := n, K := K, L := L, ring := ring, targetRing := targetRing, morphism := morphism] \as LeftChange;
\import \root.StandardShellChange[n := m, K := K, L := L, ring := ring, targetRing := targetRing, morphism := morphism] \as RightChange;
\import \root.StandardShellChange[n := N.Basic[].Def[].add n m, K := K, L := L, ring := ring, targetRing := targetRing, morphism := morphism] \as OutputChange;
\definition degree: N.Nat^ := N.Basic[].Def[].add n m;
\import algebraic_topology.Euclidean[].Dimension[n := n] \as Left;
\import algebraic_topology.Euclidean[].Dimension[n := m] \as Right;
\import algebraic_topology.Euclidean[].Dimension[n := degree] \as Total;
\import \root.StandardShell[n := n] \as LeftShell;
\import \root.StandardShell[n := m] \as RightShell;
\import \root.StandardShell[n := degree] \as TotalShell;
\import \root.LocalDisk[].Point[K := K, ring := ring].Rank[n := n] \as LeftPoint;
\import \root.LocalDisk[].Point[K := K, ring := ring].Rank[n := m] \as RightPoint;
\import \root.LocalDisk[].Point[K := L, ring := targetRing].Rank[n := n] \as NewLeftPoint;
\import \root.LocalDisk[].Point[K := L, ring := targetRing].Rank[n := m] \as NewRightPoint;
\import singular_products.Cochains[A := Old.Carrier, source := Old.topology, R := K, ring := ring] \as Source;
\import singular_products.Cochains[A := Old.Carrier, source := Old.topology, R := L, ring := targetRing] \as Target;
\import \root.CoefficientChange[].OnSpace[A := Old.Carrier, source := Old.topology, R := K, S := L, ring := ring, targetRing := targetRing] \as Operations;
\definition diskMorphism: Operations.Morphism := Operations.Morphism { linear := morphism.linear, multiply := morphism.multiply, unit := morphism.unit };
\import Operations.With[morphism := diskMorphism] \as Change;
\import Change.Relative[subset := Old.firstShell] \as FirstChange;
\import Change.Relative[subset := Old.secondShell] \as SecondChange;
\import \root.MixedCup[A := Old.Carrier, source := Old.topology, first := Old.firstShell, second := Old.secondShell, K := K, ring := ring] \as Mixed;
\import Mixed.Change[L := L, targetRing := targetRing, morphism := diskMorphism] \as MixedChange;
\import Mixed.Union[] \as Union;
\import Change.Relative[subset := Union.subset] \as UnionChange;
\definition map: _ := OutputChange.boundaryMap;
\module First;
\module Second;
\module Product;
