\definition total: N.Nat^ := N.Basic[].Def[].add N.Nat^::zero n;
\definition same: n = total := sym!{N.Nat^} _ _ (N.Basic[].Prop[].addZeroLeft n);
\import Pair.RelativeCup[p := N.Nat^::zero, q := n] \as Product;
\import Pair.Comparison[n := total] \as Compare;
\import Pair.Cohomology[p := N.Nat^::zero, q := n].Right[] \as Cup;
\import Cochains.At[C := Relative.complex, z := I.Int^::ofNat n] \as Input;
\import Cochains.At[C := Relative.complex, z := I.Int^::ofNat total] \as Output;
\definition cochains: \forall (h: Raw n) -> Product.right Ordinary.Unit[].cochain h = Transport.cast Raw n total same h :=
  \fun (h: Raw n) => Compare.injective _ _ (eq_reason_in!{{Ordinary.Carrier total} _
    "=" _ "by" { Product.rightRestriction Ordinary.Unit[].cochain h }
    "=" _ "by" { Ordinary.Unit[].Left[p := n].law (forget n h) }
    "=" _ "by" { Transport.natural Raw Ordinary.Carrier forget n total same h }
  });
\definition onClasses: \forall (h: Input.Closed) -> Cup.apply Ordinary.Cohomology[].Unit[].class (Input.classOf h) = Transport.cast Class n total same (Input.classOf h) :=
  \fun (h: Input.Closed) => eq_reason_in!{Output.Cohomology _
    "=" _ "by" { Cup.onClasses Ordinary.Cohomology[].Unit[].cycle h }
    "=" _ "by" { congr!{Output.Closed Output.Cohomology} Output.classOf (Cup.cycle Ordinary.Cohomology[].Unit[].cycle h) (Transport.cast Closed n total same h)
      (trans!{{Raw total}} _ _ _ (cochains h) (Transport.natural Closed Raw inclusion n total same h)) }
    "=" _ "by" { sym!{Output.Cohomology} _ _ (Transport.natural Closed Class classOf n total same h) }
  };
\definition law: \forall (u: Class n) -> Cup.apply Ordinary.Cohomology[].Unit[].class u = Transport.cast Class n total same u :=
  Input.classInduction (\fun (u: Class n) => Cup.apply Ordinary.Cohomology[].Unit[].class u = Transport.cast Class n total same u) onClasses;
