\import Modules.Hom[V := Class m, W := Class n, source := space m, target := space n] \as Forward;
\import Modules.Hom[V := Class n, W := Class m, source := space n, target := space m] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := Transport.cast Class m n same,
  addition := Transport.binaryNatural Class Class Class (\fun (k: N.Nat^) => (space k).add) m n same,
  scalar := \fun (r: K)(x: Class m) => Transport.natural Class Class (\fun (k: N.Nat^)(v: Class k) => (space k).smul r v) m n same x
};
\definition backward: Backward.Map := Backward.Map {
  apply := Transport.cast Class n m (sym!{N.Nat^} m n same),
  addition := Transport.binaryNatural Class Class Class (\fun (k: N.Nat^) => (space k).add) n m (sym!{N.Nat^} m n same),
  scalar := \fun (r: K)(x: Class n) => Transport.natural Class Class (\fun (k: N.Nat^)(v: Class k) => (space k).smul r v) n m (sym!{N.Nat^} m n same) x
};
\import Modules.Isomorphism[V := Class m, W := Class n, source := space m, target := space n] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism {
  forward := forward, backward := backward,
  leftInverse := Transport.castInverse Class m n same,
  rightInverse := Transport.castInverse Class n m (sym!{N.Nat^} m n same)
};
