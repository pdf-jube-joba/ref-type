\import Source.Subspace[S := Maps.Preimage q U] \as Domain;
\import Target.Subspace[S := U] \as Range;
\import Domain.Open[] \as DomainOpen;
\import Range.Open[] \as RangeOpen;
\import topology.Topology[Carrier := Domain.CarrierSet] \as DomainSpace;
\import topology.Topology[Carrier := Range.CarrierSet] \as RangeSpace;
\import topology.Continuity[A := Domain.CarrierSet, B := Range.CarrierSet] \as Restricted;
\import Continuous.Restriction[S := Maps.Preimage q U] \as Restrict;
\import topology.Continuity[A := Domain.CarrierSet, B := B].Corestriction[S := U] \as Corestrict;
\import topological_constructions.Quotient[A := Domain.CarrierSet, B := Range.CarrierSet] \as Cut;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\definition map(x: Domain.CarrierSet): Range.CarrierSet := \into[B](q x, U) \by { \bysub(A, Maps.Preimage q U, x) };
\definition onto: Surjective q -> Cut.Surjective map := \block {
  \fun (surjective: Surjective q)(y: Range.CarrierSet) \then
  \takefrom x: \Cast[A] ({ x: A \where q x = y }) \by surjective y \then
  \let equal: q x = y := \bysub(A, { x: A \where q x = y }, x) \then
  \let member: Target.Member U (q x) := \idelim y = q x \with z: B => Target.Member U z
    \by { base: \bysub(B, U, y), equality: sym!{B} _ _ equal } \then
  \let point: Domain.CarrierSet := \into[A](x, Maps.Preimage q U) \by { member } \then
  \return Logic.existsIntro[Domain.CarrierSet, { x: Domain.CarrierSet \where map x = y }] point equal
};
\definition continuous: \forall (source: Source.Topology)(target: Target.Topology) ->
  Continuous.Continuous source target q -> Restricted.Continuous (Domain.topology source) (Range.topology target) map :=
  \fun (source: _)(target: _)(continuous: _) => Corestrict.corestrictContinuous (Domain.topology source) target map
    (Restrict.restrictContinuous source target q continuous);
\definition preimageImage(W: \Pow Range.CarrierSet): DomainOpen.image (Restricted.Preimage map W) = Maps.Preimage q (RangeOpen.image W) :=
  \axiom:setext(DomainOpen.image (Restricted.Preimage map W), Maps.Preimage q (RangeOpen.image W),
    \fun (x: A)(member: Source.Member (DomainOpen.image (Restricted.Preimage map W)) x) =>
      DomainOpen.imageElim (Restricted.Preimage map W) x (Target.Member (RangeOpen.image W) (q x))
        (\fun (y: Domain.CarrierSet)(inside: RangeSpace.Member W (map y))(equal: y = x) =>
          \idelim y = x \with z: A => Target.Member (RangeOpen.image W) (q z)
            \by { base: RangeOpen.imageMember W (map y) inside, equality: equal }) member,
    \fun (x: A)(member: Target.Member (RangeOpen.image W) (q x)) =>
      RangeOpen.imageElim W (q x) (Source.Member (DomainOpen.image (Restricted.Preimage map W)) x)
        (\block {
          \fun (y: Range.CarrierSet)(inside: RangeSpace.Member W y)(equal: y = q x) \then
          \let inU: Target.Member U (q x) := \idelim y = q x \with z: B => Target.Member U z
            \by { base: \bysub(B, U, y), equality: equal } \then
          \let point: Domain.CarrierSet := \into[A](x, Maps.Preimage q U) \by { inU } \then
          \return DomainOpen.imageMember (Restricted.Preimage map W) point
            (\idelim y = map point \with z: Range.CarrierSet => RangeSpace.Member W z
              \by { base: inside, equality: equal })
        }) member);
\definition traceImage(W: \Pow Range.CarrierSet): Range.Trace (RangeOpen.image W) = W :=
  \axiom:setext(Range.Trace (RangeOpen.image W), W,
    \fun (y: Range.CarrierSet)(member: Target.Member (RangeOpen.image W) y) =>
      RangeOpen.imageElim W y (RangeSpace.Member W y)
        (\fun (z: Range.CarrierSet)(inside: RangeSpace.Member W z)(equal: z = y) =>
          \idelim z = y \with w: Range.CarrierSet => RangeSpace.Member W w \by { base: inside, equality: equal }) member,
    \fun (y: Range.CarrierSet)(member: RangeSpace.Member W y) => RangeOpen.imageMember W y member);
\definition reflectsOpen: \forall (source: Source.Topology)(target: Target.Topology) -> IsQuotientMap[source, target, q] ->
  Target.IsOpenIn target U -> \forall (W: \Pow Range.CarrierSet) ->
  DomainSpace.IsOpenIn (Domain.topology source) (Restricted.Preimage map W) -> RangeSpace.IsOpenIn (Range.topology target) W :=
  \fun (source: _)(target: _)(laws: _)(openU: _)(W: _)(openW: _) =>
    \idelim Range.Trace (RangeOpen.image W) = W \with V: \Pow Range.CarrierSet => RangeSpace.IsOpenIn (Range.topology target) V
      \by {
        base: Range.traceOpen target (RangeOpen.image W) (#reflectsOpen{laws} (RangeOpen.image W)
          (\idelim DomainOpen.image (Restricted.Preimage map W) = Maps.Preimage q (RangeOpen.image W)
            \with V: \Pow A => Source.IsOpenIn source V \by {
              base: DomainOpen.imageOpen source (#continuous{laws} U openU) (Restricted.Preimage map W) openW,
              equality: preimageImage W
            })),
        equality: traceImage W
      };
\definition quotientMap: \forall (source: Source.Topology)(target: Target.Topology) -> IsQuotientMap[source, target, q] -> Target.IsOpenIn target U ->
  Cut.IsQuotientMap[Domain.topology source, Range.topology target, map] :=
  \fun (source: _)(target: _)(laws: _)(open: _) => Cut.IsQuotientMap[_, _, map] {
    onto := onto #onto{laws}, continuous := continuous source target #continuous{laws},
    reflectsOpen := reflectsOpen source target laws open,
  };

\module From(S: \Pow A);
