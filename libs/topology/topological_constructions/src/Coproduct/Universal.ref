\import topology.Topology[Carrier := C] \as Target;
\import topology.Continuity[A := A, B := C] \as LeftContinuous;
\import topology.Continuity[A := B, B := C] \as RightContinuous;
\import topology.Continuity[A := Carrier, B := C] \as Maps;
\definition copair(f: A -> C) (g: B -> C): Carrier -> C :=
  \induction (p: Carrier) \return C \with { | inl: f | inr: g };
\definition continuous: \forall (left: Left.Topology) (right: Right.Topology) (target: Target.Topology)
  (f: A -> C) (g: B -> C) -> LeftContinuous.Continuous left target f -> RightContinuous.Continuous right target g ->
  Maps.Continuous (topology left right) target (copair f g) :=
  \fun (left: _) (right: _) (target: _) (f: _) (g: _) (fc: _) (gc: _) (U: _) (open: _) => Logic.And[_, _]::# (fc U open) (gc U open);
