/* The numerical distance packaged as a metric space. */
\import real.Analysis[] \as Real;
\import Real.Distance[] \as Distance;
\import metric_spaces.MetricSpace[Carrier := Real.Real] \as M;

\definition metric: M.Metric := M.Metric {
  distance := Distance.distance,
  nonnegative := Distance.distanceNonnegative,
  self := Distance.distanceSelf,
  separated := Distance.distanceSeparated,
  symmetric := Distance.distanceSymmetric,
  triangle := Distance.distanceTriangle,
};
\import Real.Sequence[] \as Sequence;
\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\definition complete: M.CompleteMetric := \into[M.Metric](metric, { metric: M.Metric \where M.Completeness[metric] }) \by {
  M.Completeness[metric] {
    converges := \fun (s: N.Nat^ -> Real.Real)(cauchy: M.Sequences[metric := metric].Cauchy s) => \block {
      \let sequence: Sequence.CauchySequence := \into[N.Nat^ -> Real.Real](s, { s: N.Nat^ -> Real.Real \where Sequence.Cauchy s }) \by { cauchy } \then
      \return Logic.existsIntro[Real.Real, { x: Real.Real \where M.Sequences[metric := metric].Converges s x }]
        (Sequence.limit sequence) (Sequence.limitLaw sequence)
    },
  }
};
