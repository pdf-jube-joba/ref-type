\import \root.MetricSpace[Carrier := A] \as Base;
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as Real;
\import Real.Order[] \as Order;
\import Real.Arithmetic[].Prop[] \as Arithmetic;
\import Real.Completeness[] \as Supremum;
\import R.Estimates[] \as Estimates;
\import R.Distance[] \as Distance;
\import R.Algebra[] \as Algebra;
\import topology.Topology[Carrier := I] \as Source;
\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Nat;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\definition Radius: \Set := \Cast[R.Real] ({ r: R.Real \where Real.Le R.zero r });
\module On(base: Base.CompleteMetric, anchor: I, center: I -> A, radius: Radius);
