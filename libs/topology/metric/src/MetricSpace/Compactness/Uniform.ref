\import \root.MetricSpace[Carrier := B] \as Other;
\import Other.Topology[] \as OtherTopology;
\import topology.Topology[Carrier := B] \as Target;
\import topology.Continuity[A := Carrier, B := B] \as Maps;
\structure Radius[metric: Metric, other: Other.Metric, f: Carrier -> B, epsilon, delta: R.Real]: \Prop := {
  positive: R.Lt Real.zero delta,
  close: \forall (x, y: Carrier) -> R.Lt ((metric).distance x y) delta -> R.Lt ((other).distance (f x) (f y)) epsilon,
};
\definition UniformlyContinuous[metric: Metric][other: Other.Metric][f: Carrier -> B]: \Prop :=
  \forall (epsilon: R.Real) -> R.Lt Real.zero epsilon -> \exists ( delta: R.Real \where Radius[metric, other, f, epsilon, delta] );
\module At(metric: Metric, other: Other.Metric, f: Carrier -> B, epsilon: R.Real);
\definition compactUniformlyContinuous: \forall (metric: Metric)(other: Other.Metric) -> T.IsCompact (Topology.topology metric) ->
  \forall (f: Carrier -> B) -> Maps.Continuous (Topology.topology metric) (OtherTopology.topology other) f -> UniformlyContinuous metric other f :=
  \fun (metric: Metric)(other: Other.Metric)(compact: T.IsCompact (Topology.topology metric))(f: Carrier -> B)
    (continuous: Maps.Continuous (Topology.topology metric) (OtherTopology.topology other) f)(epsilon: R.Real) =>
    At[metric := metric, other := other, f := f, epsilon := epsilon].existsRadius compact continuous;
