\import topology.Topology[Carrier := Carrier].Closure[] \as Closure;
\import topology.Topology[Carrier := Carrier].Compactness[] \as Compact;
\import \parent.TotalBounded[metric := metric] \as Total;
\definition RelativelyCompact[S: \Pow Carrier]: \Prop :=
  T.IsCompactIn (Topology.topology metric) (Closure.closure (Topology.topology metric) S);
\definition subset: \forall (S, U: \Pow Carrier) -> T.Subset S U -> RelativelyCompact U -> RelativelyCompact S :=
  \fun (S, U: \Pow Carrier)(included: T.Subset S U)(compact: RelativelyCompact U) =>
    Compact.closedSubset (Topology.topology metric) (Closure.closure (Topology.topology metric) U)
      (Closure.closure (Topology.topology metric) S) compact (Closure.closed (Topology.topology metric) S)
      (Closure.monotone (Topology.topology metric) S U included);
\definition totallyBounded: \forall (S: \Pow Carrier) -> RelativelyCompact S -> Total.TotallyBounded S :=
  \fun (S: \Pow Carrier)(compact: RelativelyCompact S) => Total.subset S (Closure.closure (Topology.topology metric) S)
    (Closure.contains (Topology.topology metric) S) (Total.compact (Closure.closure (Topology.topology metric) S) compact);
\import \parent.\parent.Topology[].Hausdorff[] \as Hausdorff;
\definition containedInCompact: \forall (S, K: \Pow Carrier) -> T.Subset S K -> T.IsCompactIn (Topology.topology metric) K -> RelativelyCompact S :=
  \fun (S, K: \Pow Carrier)(included: T.Subset S K)(compact: T.IsCompactIn (Topology.topology metric) K) =>
    Compact.closedSubset (Topology.topology metric) K (Closure.closure (Topology.topology metric) S) compact
      (Closure.closed (Topology.topology metric) S)
      (Closure.least (Topology.topology metric) S K (Compact.compactClosed (Topology.topology metric) (Hausdorff.topologyT2 metric) K compact) included);
\module ContinuousImage(B: \Set, other: \root.MetricSpace[Carrier := B].Metric);
