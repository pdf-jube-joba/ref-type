\structure FunctionLaws[source: Source.Topology, f: A -> Real.Real]: \Prop := {
  continuous: Continuous source f,
  nonnegative: \forall (x: A) -> R.Le Real.zero (f x),
  bounded: \forall (x: A) -> R.Le (f x) Real.one,
};
\definition Function[source: Source.Topology]: \Set :=
  \Cast[A -> Real.Real] ({ f: A -> Real.Real \where FunctionLaws[source, f] });
\definition laws[source: Source.Topology] [f: Function[source]]: FunctionLaws[source, f] :=
  \bysub(A -> Real.Real, Function[source], f);
\definition multiplyBound[a, d: Real.Real]: R.Le a Real.one -> R.Le Real.zero d -> R.Le (Real.mul a d) d :=
  \fun (bound: _) (nonnegative: _) => R.leReplaceLeft (Real.mul d a) (Real.mul a d) d (Laws.fieldMulComm d a)
    (R.leReplaceRight (Real.mul d a) (Real.mul d Real.one) d (Algebra.mulOneRight d)
      (Estimates.mulMonotone d a Real.one nonnegative bound));
\definition productDistance[a, b, c, d: Real.Real]:
  R.Le Real.zero a -> R.Le a Real.one -> R.Le Real.zero d -> R.Le d Real.one ->
  R.Le (Real.distance (Real.mul a b) (Real.mul c d)) (Real.add (Real.distance b d) (Real.distance a c)) :=
  \fun (an: _) (ab: _) (dn: _) (db: _) => R.leTrans _ _ _
    (Distance.distanceTriangle (Real.mul a b) (Real.mul a d) (Real.mul c d))
    (Estimates.addLe _ _ (Real.distance b d) (Real.distance a c)
      (R.leTrans _ _ _ (Estimates.distanceMul a b d an) (multiplyBound a (Real.distance b d) ab (Distance.distanceNonnegative b d)))
      (R.leReplaceLeft (Real.distance (Real.mul d a) (Real.mul d c)) (Real.distance (Real.mul a d) (Real.mul c d)) (Real.distance a c)
        (congr!{Real.Real Real.Real Real.Real} Real.distance _ _ _ _ (Laws.fieldMulComm d a) (Laws.fieldMulComm d c))
        (R.leTrans _ _ _ (Estimates.distanceMul d a c dn) (multiplyBound d (Real.distance a c) db (Distance.distanceNonnegative a c)))));
\definition productContinuous: \forall (source: Source.Topology) (f, g: Function[source]) ->
  Continuous source (\fun (x: A) => Real.mul (f x) (g x)) :=
  \fun (source: _) (f, g: Function[source]) => continuousOfLocal source (\fun (x: A) => Real.mul (f x) (g x)) (\block {
    \fun (x: A) (r: Real.Real) (positive: R.Lt Real.zero r) \then
    \let h: Real.Real := Real.mul Real.half r \then
    \takefrom U: \Cast[\Pow A] ({ U: \Pow A \where Source.OpenNeighborhood[source, x, Small f x h, U] })
      \by localOfContinuous source f ((laws source f).continuous) x h (Estimates.halfOfPositive r positive) \then
    \takefrom V: \Cast[\Pow A] ({ V: \Pow A \where Source.OpenNeighborhood[source, x, Small g x h, V] })
      \by localOfContinuous source g ((laws source g).continuous) x h (Estimates.halfOfPositive r positive) \then
    \let ud: Source.OpenNeighborhood[source, x, Small f x h, U] := \bysub(\Pow A,
      { U: \Pow A \where Source.OpenNeighborhood[source, x, Small f x h, U] }, U) \then
    \let vd: Source.OpenNeighborhood[source, x, Small g x h, V] := \bysub(\Pow A,
      { V: \Pow A \where Source.OpenNeighborhood[source, x, Small g x h, V] }, V) \then
    \let W: \Pow A := Source.Intersection U V \then
    \return Logic.existsIntro[\Pow A, { W: \Pow A \where Source.OpenNeighborhood[source, x, Small (\fun (x: A) => Real.mul (f x) (g x)) x r, W] }] W
      (Source.OpenNeighborhood[source, x, Small (\fun (x: A) => Real.mul (f x) (g x)) x r, W] {
        open := (Source.topologyLaws source).intersectionOpen U V (ud.open) (vd.open),
        contains := Logic.And[_, _]::# (ud.contains) (vd.contains),
        within := \fun (y: A) (member: Source.Member W y) => R.leLtTrans _ _ r
          (productDistance (f x) (g x) (f y) (g y) ((laws source f).nonnegative x) ((laws source f).bounded x)
            ((laws source g).nonnegative y) ((laws source g).bounded y))
          (R.ltReplaceRight _ (Real.add h h) r (Estimates.halfTwice r)
            (Estimates.addLt (Real.distance (g x) (g y)) (Real.distance (f x) (f y)) h h
              (vd.within y (member.right)) (ud.within y (member.left)))),
      })
  });
\definition product[source: Source.Topology] [f, g: Function[source]]: Function[source] :=
  \into[A -> Real.Real](\fun (x: A) => Real.mul (f x) (g x), Function[source]) \by {
    FunctionLaws[source, (\fun (x: A) => Real.mul (f x) (g x))] {
      continuous := productContinuous source f g,
      nonnegative := \fun (x: A) => Laws.fieldMulNonnegative (f x) (g x) ((laws source f).nonnegative x) ((laws source g).nonnegative x),
      bounded := \fun (x: A) => R.leTrans _ _ _ (multiplyBound (f x) (g x) ((laws source f).bounded x) ((laws source g).nonnegative x))
        ((laws source g).bounded x),
    }
  };
\definition complement[source: Source.Topology] [f: Function[source]]: Function[source] :=
  \into[A -> Real.Real](\fun (x: A) => Real.sub Real.one (f x), Function[source]) \by {
    FunctionLaws[source, (\fun (x: A) => Real.sub Real.one (f x))] {
      continuous := subContinuous source (\fun (_: A) => Real.one) f (constantContinuous source Real.one) ((laws source f).continuous),
      nonnegative := \fun (x: A) => Distance.subNonnegative Real.one (f x) ((laws source f).bounded x),
      bounded := \fun (x: A) => Laws.leAddCancelRight _ _ (f x)
        (R.leReplaceLeft Real.one (Real.add (Real.sub Real.one (f x)) (f x)) (Real.add Real.one (f x))
          (sym!{Real.Real} _ _ (Distance.subAddCancel Real.one (f x)))
          (Algebra.leAddRight Real.one (f x) ((laws source f).nonnegative x))),
    }
  };
\definition constant[source: Source.Topology] [value: Real.Real]
  [nonnegative: R.Le Real.zero value] [bounded: R.Le value Real.one]: Function[source] :=
  \into[A -> Real.Real](\fun (_: A) => value, Function[source]) \by {
    FunctionLaws[source, (\fun (_: A) => value)] {
      continuous := constantContinuous source value, nonnegative := \fun (_: A) => nonnegative, bounded := \fun (_: A) => bounded,
    }
  };
