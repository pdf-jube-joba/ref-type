\definition leOfDifference[x, y: Real.Real]: R.Le Real.zero (Real.sub y x) -> R.Le x y :=
  \fun (nonnegative: _) => Laws.leAddCancelRight x y (Real.neg x)
    (R.leReplaceLeft Real.zero (Real.sub x x) (Real.sub y x) (sym!{Real.Real} _ _ (Laws.subSelf x)) nonnegative);
\definition leClosed: \forall (source: Source.Topology)(f, g: A -> Real.Real) -> Continuous source f -> Continuous source g ->
  Source.IsClosedIn source ({ x: A \where R.Le (f x) (g x) }) := \fun (source: _)(f, g: _)(fc: _)(gc: _) =>
  \idelim { x: A \where R.Le Real.zero (Real.sub (g x) (f x)) } = { x: A \where R.Le (f x) (g x) }
    \with S: \Pow A => Source.IsClosedIn source S \by {
      base: Maps.closedPreimage source Line.topology (\fun (x: A) => Real.sub (g x) (f x))
        (subContinuous source g f gc fc) ({ r: Real.Real \where R.Le Real.zero r }) (Line.Rays[].atLeastClosed Real.zero),
      equality: \axiom:setext({ x: A \where R.Le Real.zero (Real.sub (g x) (f x)) }, { x: A \where R.Le (f x) (g x) },
        \fun (x: A)(nonnegative: _) => leOfDifference (f x) (g x) nonnegative,
        \fun (x: A)(ordered: _) => Distance.subNonnegative (g x) (f x) ordered)
    };
