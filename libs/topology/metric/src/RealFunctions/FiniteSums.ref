\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import Real.FiniteSums[] \as Sums;
\definition continuous: \forall (source: Source.Topology)(n: N.Nat^)(f: Fin.Fin n -> A -> Real.Real) ->
  (\forall (i: Fin.Fin n) -> Continuous source (f i)) ->
  Continuous source (\fun (x: A) => Sums.sum n (\fun (i: Fin.Fin n) => f i x)) :=
  \fun (source: Source.Topology) => \induction (n: N.Nat^) \return \forall (f: Fin.Fin n -> A -> Real.Real) ->
    (\forall (i: Fin.Fin n) -> Continuous source (f i)) ->
    Continuous source (\fun (x: A) => Sums.sum n (\fun (i: Fin.Fin n) => f i x)) \with {
      | zero: \fun (f: _)(fc: _) => constantContinuous source Real.zero
      | succ: \fun (n: N.Nat^)(previous: _)(f: _)(fc: _) =>
          sumContinuous source (f (Fin.zero n)) (\fun (x: A) => Sums.sum n (\fun (i: Fin.Fin n) => f (Fin.succ n i) x))
            (fc (Fin.zero n)) (previous (\fun (i: Fin.Fin n) => f (Fin.succ n i)) (\fun (i: Fin.Fin n) => fc (Fin.succ n i)))
    };
