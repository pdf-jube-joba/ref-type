\import \root.Homotopy[A := A, B := B] \as Original;
\import \root.Homotopy[A := Carrier, B := Target.Carrier] \as DescendedHomotopy;
\import \root.Cylinder[A := A] \as Cylinder;
\import \root.Cylinder[A := Carrier] \as QuotientCylinder;
\import \root.Interval[] \as Interval;
\import topological_constructions.ProductQuotient[X := Interval.Carrier, A := A, B := Carrier] \as Product;
\import std.Data[].Pair[].Prop[A := Interval.Carrier, B := A] \as Pairs;
\import topology.Topology[Carrier := QuotientCylinder.Carrier] \as CylinderSpace;
\import topology.Composition[A := Cylinder.Carrier, B := B, C := Target.Carrier] \as Projection;
\module Over(source: Source.Topology, target: TargetSpace.Topology, f, g: A -> B) {
  \structure Data: \Set {
    homotopy: Original.Homotopy[source, target, f, g],
    preserves: \forall (t: Interval.Carrier)(x: A) -> \In[A] subset x -> \In[B] targetSubset (homotopy (Cylinder.at t x)),
  }
  \module On(h: Data);
}
