\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\import \root.Contraction[A := B, source := target] \as Result;
\import \root.Homotopy[A := A, B := A] \as Original;
\import \root.Homotopy[A := B, B := A] \as Middle;
\import Original.Composition[C := B] \as Before;
\import \root.Homotopy[A := B, B := A].Composition[C := B] \as After;
\import \root.Homotopy[A := B, B := B] \as TargetHomotopies;
\definition forward: A -> B := (homeomorphism).forward;
\definition backward: B -> A := (homeomorphism).backward;
\definition homeomorphismLaws: Homeomorphisms.Laws[source, target, homeomorphism] := Homeomorphisms.laws source target homeomorphism;
\module On(contraction: Data) {
  \definition original: Original.Homotopy[source, source, (\fun (x: A) => x), (\fun (_: A) => (contraction).centre)] := (contraction).homotopy;
  \definition precomposed: Middle.Homotopy[target, source, (\fun (x: B) => backward x), (\fun (_: B) => (contraction).centre)] :=
    Before.precompose target source source (\fun (x: A) => x) (\fun (_: A) => (contraction).centre) original backward (homeomorphismLaws).backwardContinuous;
  \definition postcomposed: TargetHomotopies.Homotopy[target, target, (\fun (x: B) => forward (backward x)), (\fun (_: B) => forward (contraction).centre)] :=
    After.postcompose target source target (\fun (x: B) => backward x) (\fun (_: B) => (contraction).centre) precomposed forward (homeomorphismLaws).forwardContinuous;
  \definition result: Result.Data := Result.Data {
    centre := forward (contraction).centre,
    homotopy := \into[TargetHomotopies.Family](postcomposed, TargetHomotopies.Homotopy[target, target, (\fun (x: B) => x), (\fun (_: B) => forward (contraction).centre)]) \by {
      TargetHomotopies.Laws[_, _, _, _, postcomposed] {
        continuous := (TargetHomotopies.laws target target (\fun (x: B) => forward (backward x)) (\fun (_: B) => forward (contraction).centre) postcomposed).continuous,
        start := \fun (x: B) => trans!{B} _ _ _
          ((TargetHomotopies.laws target target (\fun (x: B) => forward (backward x)) (\fun (_: B) => forward (contraction).centre) postcomposed).start x)
          ((homeomorphismLaws).rightInverse x),
        end := (TargetHomotopies.laws target target (\fun (x: B) => forward (backward x)) (\fun (_: B) => forward (contraction).centre) postcomposed).end,
      }
    },
  };
}
\definition apply[contraction: Data]: Result.Data := On[contraction := contraction].result;
