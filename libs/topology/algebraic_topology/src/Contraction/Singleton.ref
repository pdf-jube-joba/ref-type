\import \root.Cylinder[A := A] \as Cylinder;
\import topology.Maps[A := Cylinder.Carrier, B := A] \as Maps;
\definition family: Homotopy.Family := \fun (_: Cylinder.Carrier) => a;
\definition contraction(unique: \forall (x: A) -> x = a): Data := Data {
  centre := a,
  homotopy := \into[Homotopy.Family](family, Homotopy.Homotopy[source, source, (\fun (x: A) => x), (\fun (_: A) => a)]) \by {
    Homotopy.Laws[source, source, (\fun (x: A) => x), (\fun (_: A) => a), family] {
      continuous := Maps.constantContinuous (Cylinder.topology source) source a,
      start := \fun (x: A) => sym!{A} _ _ (unique x),
      end := \fun (_: A) => \refl(a),
    }
  },
};
