\definition retraction: A -> Subspace.CarrierSet := (retract).retraction;
\definition homotopy: Homotopies.Homotopy[source, source, (\fun (x: A) => x), (\fun (x: A) => retraction x)] :=
  Homotopies.forgetRelative source source subset (\fun (x: A) => x) (\fun (x: A) => retraction x) (retract).homotopy;
\definition left: SubspaceHomotopies.Homotopy[Subspace.topology source, Subspace.topology source, (\fun (x: Subspace.CarrierSet) => retraction x), (\fun (x: Subspace.CarrierSet) => x)] :=
  \into[SubspaceHomotopies.Family](Cylinder.point, SubspaceHomotopies.Homotopy[Subspace.topology source, Subspace.topology source, (\fun (x: Subspace.CarrierSet) => retraction x), (\fun (x: Subspace.CarrierSet) => x)]) \by {
    SubspaceHomotopies.Laws[Subspace.topology source, Subspace.topology source, (\fun (x: Subspace.CarrierSet) => retraction x), (\fun (x: Subspace.CarrierSet) => x), Cylinder.point] {
      continuous := Cylinder.pointContinuous (Subspace.topology source),
      start := \fun (x: Subspace.CarrierSet) => sym!{Subspace.CarrierSet} _ _ ((retract).retracts x),
      end := \fun (x: Subspace.CarrierSet) => \refl(x),
    }
  };
\definition equivalence: Equivalences.Equivalence[Subspace.topology source, source] := Equivalences.Equivalence[_, _] {
  forward := inclusion, backward := retraction,
  forwardContinuous := Inclusions.inclusionContinuous source, backwardContinuous := (retract).continuous,
  leftInverse := \exact(left, SubspaceHomotopies.Homotopy[Subspace.topology source, Subspace.topology source, (\fun (x: Subspace.CarrierSet) => retraction x), (\fun (x: Subspace.CarrierSet) => x)]),
  rightInverse := \exact(Homotopies.reverse source source (\fun (x: A) => x) (\fun (x: A) => retraction x) homotopy,
    Homotopies.Homotopy[_, _, (\fun (x: A) => retraction x), (\fun (x: A) => x)]),
};
\module Collapse(point: Subspace.CarrierSet);
