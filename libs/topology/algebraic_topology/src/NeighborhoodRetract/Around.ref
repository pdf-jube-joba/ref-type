\definition region: \Pow A := #region{neighborhood};
\import Space.Subspace[S := region] \as Domain;
\definition Carrier: \Set := Domain.CarrierSet;
\import topology.Topology[Carrier := Carrier] \as DomainSpace;
\definition topology: DomainSpace.Topology := Domain.topology source;
\definition collapsedPart: \Pow Carrier := { x: Carrier \where Space.Member subset x };
\import \root.DeformationRetract[A := Carrier, source := topology, subset := collapsedPart] \as Deformations;
\definition Retraction: \Set := Deformations.Data;
