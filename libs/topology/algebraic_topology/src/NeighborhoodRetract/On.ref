\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\definition neighborhood: Neighborhoods.Neighborhood := #neighborhood{pair};
\definition region: \Pow A := #region{neighborhood};
\import \parent.Around[neighborhood := neighborhood] \as Neighborhood;
\import Space.Subspace[S := region] \as Domain;
\definition collapsedPart: \Pow Domain.CarrierSet := { x: Domain.CarrierSet \where Space.Member subset x };
\import \root.DeformationRetract[A := Domain.CarrierSet, source := Domain.topology source, subset := collapsedPart] \as Deformations;
\definition deformation: Deformations.Data := #deformation{pair};
\import Deformations.On[retract := deformation] \as Retraction;
\definition point: Subspace.CarrierSet := #point{pair};
\definition neighborhoodPoint: Domain.CarrierSet := \into[A](point, region) \by { #contains{neighborhood} point (\bysub(A, subset, point)) };
\definition localPoint: \Cast[Domain.CarrierSet] collapsedPart := \into[Domain.CarrierSet](neighborhoodPoint, collapsedPart) \by { \bysub(A, subset, point) };
\import Subspace.Inside[U := region] \as Nested;
\import topology.Topology[Carrier := Domain.CarrierSet].Subspace[S := collapsedPart] \as LocalSubspace;
\import \root.HomotopyEquivalence[A := Subspace.CarrierSet, B := LocalSubspace.CarrierSet] \as Refinement;
\import Refinement.Composition[C := Domain.CarrierSet] \as Composition;
\import \root.HomotopyEquivalence[A := Subspace.CarrierSet, B := Domain.CarrierSet] \as Equivalences;
\definition equivalence: Equivalences.Equivalence[Subspace.topology source, Domain.topology source] :=
  Composition.compose (Subspace.topology source) (LocalSubspace.topology (Domain.topology source)) (Domain.topology source)
    (Refinement.fromHomeomorphism (Subspace.topology source) (LocalSubspace.topology (Domain.topology source)) (Nested.homeomorphism source #contains{neighborhood})) Retraction.equivalence;
\import Quotient.Open[source := source].On[neighborhood := neighborhood] \as QuotientNeighborhood;
\import \root.Collapse[A := Domain.CarrierSet, subset := collapsedPart] \as LocalQuotient;
\import \root.Contraction[A := LocalQuotient.Carrier, source := LocalQuotient.topology (Domain.topology source)] \as LocalContractions;
\import topology.Topology[Carrier := Quotient.Carrier].Subspace[S := QuotientNeighborhood.image] \as Image;
\import LocalContractions.Transport[B := Image.CarrierSet].Over[target := Image.topology (Quotient.topology source)].Along[homeomorphism := QuotientNeighborhood.homeomorphism] \as Transport;
\import \root.Contraction[A := Image.CarrierSet, source := Image.topology (Quotient.topology source)] \as ImageContractions;
\definition imageContraction: ImageContractions.Data := Transport.apply Retraction.Collapse[point := localPoint].contraction;
\definition imagePoint: Image.CarrierSet := QuotientNeighborhood.projection neighborhoodPoint;
\definition centre: #centre{imageContraction} = imagePoint := QuotientNeighborhood.onClass localPoint;
