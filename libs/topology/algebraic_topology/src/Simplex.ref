\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Option[] \as Option;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\import real.Analysis[] \as Real;
\import Real.FiniteSums[] \as Sums;
\import Fin.Tuples[A := Real.Real] \as Tuples;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import metric_spaces.RealLine[] \as Line;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;

\definition Coordinate(n: N.Nat^): \Set := Fin.Fin n -> Real.Real;
\structure Barycentric[n: N.Nat^, x: Coordinate n]: \Prop {
  nonnegative: \forall (i: Fin.Fin n) -> R.Le Real.zero (x i),
  total: Sums.sum n x = Real.one,
}
\definition Points(n: N.Nat^): \Pow (Coordinate (N.Nat^::succ n)) :=
  { x: Coordinate (N.Nat^::succ n) \where Barycentric[N.Nat^::succ n, x] };
\definition Carrier(n: N.Nat^): \Set := \Cast[Coordinate (N.Nat^::succ n)] (Points n);
\definition barycentric(n: N.Nat^)(x: Carrier n): Barycentric[N.Nat^::succ n, x] :=
  \bysub(Coordinate (N.Nat^::succ n), Points n, x);
\module At(n: N.Nat^);

\definition extendSum: \forall (n: N.Nat^)(head: Real.Real)(tail: Coordinate n) ->
  Sums.sum (N.Nat^::succ n) (Tuples.extend n head tail) = Real.add head (Sums.sum n tail) :=
  \fun (n: N.Nat^)(head: Real.Real)(tail: Coordinate n) =>
    congr2!{Real.Real Real.Real Real.Real} Real.add _ _ _ _
      (Tuples.atZero n head tail)
      (Sums.congruent n (\fun (i: Fin.Fin n) => Tuples.extend n head tail (Fin.succ n i)) tail
        (Tuples.atSuccessor n head tail));
\definition extendNonnegative: \forall (n: N.Nat^)(head: Real.Real)(tail: Coordinate n) ->
  R.Le Real.zero head -> (\forall (i: Fin.Fin n) -> R.Le Real.zero (tail i)) ->
  \forall (i: Fin.Fin (N.Nat^::succ n)) -> R.Le Real.zero (Tuples.extend n head tail i) :=
  \fun (n: N.Nat^)(head: Real.Real)(tail: Coordinate n)(headPositive: _)(tailPositive: _)(i: _) =>
    (\induction (o: Option.Option[Fin.Fin n]) \return R.Le Real.zero (Tuples.evaluate n head tail o) \with {
      | none: headPositive
      | some: tailPositive
    }) (Fin.split n i);

\definition insertStep(n: N.Nat^)(previous: Fin.Fin (N.Nat^::succ n) -> Coordinate n -> Coordinate (N.Nat^::succ n))
  (x: Coordinate (N.Nat^::succ n)): Option.Option[Fin.Fin (N.Nat^::succ n)] -> Coordinate (N.Nat^::succ (N.Nat^::succ n)) :=
  \induction (o: Option.Option[Fin.Fin (N.Nat^::succ n)]) \return Coordinate (N.Nat^::succ (N.Nat^::succ n)) \with {
    | none: Tuples.extend (N.Nat^::succ n) Real.zero x
    | some: \fun (j: Fin.Fin (N.Nat^::succ n)) => Tuples.extend (N.Nat^::succ n) (x (Fin.zero n))
      (previous j (\fun (k: Fin.Fin n) => x (Fin.succ n k)))
  };
\definition insertZero: \forall (n: N.Nat^) -> Fin.Fin (N.Nat^::succ n) -> Coordinate n -> Coordinate (N.Nat^::succ n) :=
  \induction (n: N.Nat^) \return Fin.Fin (N.Nat^::succ n) -> Coordinate n -> Coordinate (N.Nat^::succ n) \with {
    | zero: \fun (i: Fin.Fin (N.Nat^::succ N.Nat^::zero))(x: Coordinate N.Nat^::zero) => \fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => Real.zero
    | succ: \fun (n: N.Nat^)(previous: _)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(x: Coordinate (N.Nat^::succ n)) =>
      insertStep n previous x (Fin.split (N.Nat^::succ n) i)
  };
\module Insertion(n: N.Nat^);
\definition insertSum: \forall (n: N.Nat^)(i: Fin.Fin (N.Nat^::succ n))(x: Coordinate n) ->
  Sums.sum (N.Nat^::succ n) (insertZero n i x) = Sums.sum n x :=
  \induction (n: N.Nat^) \return \forall (i: Fin.Fin (N.Nat^::succ n))(x: Coordinate n) ->
    Sums.sum (N.Nat^::succ n) (insertZero n i x) = Sums.sum n x \with {
      | zero: \fun (i: _)(x: _) => Laws.addZeroLeft Real.zero
      | succ: \fun (n: N.Nat^)(previous: _) => Insertion[n := n].sum previous
  };
\definition insertNonnegative: \forall (n: N.Nat^)(i: Fin.Fin (N.Nat^::succ n))(x: Coordinate n) ->
  (\forall (j: Fin.Fin n) -> R.Le Real.zero (x j)) ->
  \forall (j: Fin.Fin (N.Nat^::succ n)) -> R.Le Real.zero (insertZero n i x j) :=
  \induction (n: N.Nat^) \return \forall (i: Fin.Fin (N.Nat^::succ n))(x: Coordinate n) ->
    (\forall (j: Fin.Fin n) -> R.Le Real.zero (x j)) ->
    \forall (j: Fin.Fin (N.Nat^::succ n)) -> R.Le Real.zero (insertZero n i x j) \with {
      | zero: \fun (i: _)(x: _)(positive: _)(j: _) => R.leRefl Real.zero
      | succ: \fun (n: N.Nat^)(previous: _) => Insertion[n := n].nonnegative previous
  };
\definition insertHead: \forall (n: N.Nat^)(x: Coordinate (N.Nat^::succ n)) ->
  insertZero (N.Nat^::succ n) (Fin.zero (N.Nat^::succ n)) x = Tuples.extend (N.Nat^::succ n) Real.zero x :=
  \fun (n: N.Nat^)(x: Coordinate (N.Nat^::succ n)) =>
    congr!{{Option.Option[Fin.Fin (N.Nat^::succ n)]} {Coordinate (N.Nat^::succ (N.Nat^::succ n))}}
      (insertStep n (insertZero n) x) _ _ (Fin.splitInflate (N.Nat^::succ n) Option.Option[Fin.Fin (N.Nat^::succ n)]::none);
\definition face(n: N.Nat^)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(x: Carrier n): Carrier (N.Nat^::succ n) :=
  \into[Coordinate (N.Nat^::succ (N.Nat^::succ n))](insertZero (N.Nat^::succ n) i x, Points (N.Nat^::succ n)) \by {
    Barycentric[N.Nat^::succ (N.Nat^::succ n), insertZero (N.Nat^::succ n) i x] {
      nonnegative := insertNonnegative (N.Nat^::succ n) i x #nonnegative{(barycentric n x)},
      total := trans!{Real.Real} _ _ _ (insertSum (N.Nat^::succ n) i x) #total{(barycentric n x)},
    }
  };
\definition faceFirst(n: N.Nat^)(x: Carrier n): Carrier (N.Nat^::succ n) := face n (Fin.zero (N.Nat^::succ n)) x;
\definition faceFirstZero: \forall (n: N.Nat^)(x: Carrier n) -> faceFirst n x (Fin.zero (N.Nat^::succ n)) = Real.zero :=
  \fun (n: N.Nat^)(x: Carrier n) => trans!{Real.Real} _ _ _
    (congr!{{Coordinate (N.Nat^::succ (N.Nat^::succ n))} Real.Real}
      (\fun (v: Coordinate (N.Nat^::succ (N.Nat^::succ n))) => v (Fin.zero (N.Nat^::succ n))) _ _ (insertHead n x))
    (Tuples.atZero (N.Nat^::succ n) Real.zero x);
\definition faceFirstSuccessor: \forall (n: N.Nat^)(x: Carrier n)(i: Fin.Fin (N.Nat^::succ n)) ->
  faceFirst n x (Fin.succ (N.Nat^::succ n) i) = x i :=
  \fun (n: N.Nat^)(x: Carrier n)(i: Fin.Fin (N.Nat^::succ n)) => trans!{Real.Real} _ _ _
    (congr!{{Coordinate (N.Nat^::succ (N.Nat^::succ n))} Real.Real}
      (\fun (v: Coordinate (N.Nat^::succ (N.Nat^::succ n))) => v (Fin.succ (N.Nat^::succ n) i)) _ _ (insertHead n x))
    (Tuples.atSuccessor (N.Nat^::succ n) Real.zero x i);
\definition zeroPoint: Carrier N.Nat^::zero :=
  \into[Coordinate (N.Nat^::succ N.Nat^::zero)]((\fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => Real.one), Points N.Nat^::zero) \by {
    Barycentric[N.Nat^::succ N.Nat^::zero, \fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => Real.one] {
      nonnegative := \fun (_: _) => Laws.oneNonnegative,
      total := Laws.addZeroRight Real.one,
    }
  };
\definition zeroUnique: \forall (x: Carrier N.Nat^::zero) -> x = zeroPoint :=
  \fun (x: Carrier N.Nat^::zero) => \axiom:funext(x, zeroPoint, \fun (i: Fin.Fin (N.Nat^::succ N.Nat^::zero)) =>
    trans!{Real.Real} _ _ _ (congr!{{Fin.Fin (N.Nat^::succ N.Nat^::zero)} Real.Real} x _ _ (Fin.singletonValue i))
      (trans!{Real.Real} _ _ _ (sym!{Real.Real} _ _ (Laws.addZeroRight (x (Fin.zero N.Nat^::zero)))) #total{(barycentric N.Nat^::zero x)}));
\definition lastVertex: \forall (n: N.Nat^) -> Carrier n :=
  \induction (n: N.Nat^) \return Carrier n \with {
    | zero: zeroPoint
    | succ: \fun (n: N.Nat^)(previous: Carrier n) => faceFirst n previous
  };
\module Continuity(A: \Set, source: topology.Topology[Carrier := A].Topology);
\module Faces(n: N.Nat^);
\module Identities;
\module Vertices;
\module Affine(m, n: N.Nat^);
\module Pairing;
\module AffineFaces(m, n: N.Nat^);
\module AffineIdentity(n: N.Nat^);
\module Interval;
\module AffineFace(n: N.Nat^);
\module AffineVertex(m, n: N.Nat^);
\module Cylinder(n: N.Nat^);
\module Compactness(n: N.Nat^);
\module Barycentre(n: N.Nat^);
\module Convex(n: N.Nat^);
\module Contraction(n: N.Nat^);
\module Metric(n: N.Nat^);
