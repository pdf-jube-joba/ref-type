\inductive Point: \Set := | point: Point;
\import topology.Topology[Carrier := Point] \as PointSpace;
\import topology.Maps[A := Point, B := A] \as Constants;
\import \root.Homotopy[A := Point, B := A] \as Homotopy;
\import Homotopy.Concatenation[] \as Concatenation;
\import std.Logic[].Relation[] \as Relation;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\definition constant(x: A): Point -> A := \fun (_: Point) => x;
\definition Path(x, y: A): \Set := Homotopy.Homotopy[PointSpace.Discrete, source, constant x, constant y];
\definition Related(x, y: A): \Prop := \exists Path x y;
\definition reflexive: \forall (x: A) -> Related x x :=
  \fun (x: A) => Homotopy.reflexive PointSpace.Discrete source (constant x)
    (Constants.constantContinuous PointSpace.Discrete source x);
\definition symmetric: \forall (x, y: A) -> Related x y -> Related y x :=
  \fun (x, y: A) => Homotopy.symmetric PointSpace.Discrete source (constant x) (constant y);
\definition transitive: \forall (x, y, z: A) -> Related x y -> Related y z -> Related x z :=
  \fun (x, y, z: A) => Concatenation.transitive PointSpace.Discrete source (constant x) (constant y) (constant z);
\definition equivalence: Relation.Equivalence[A, Related] := Relation.Equivalence[A, Related] {
  refl := reflexive, sym := symmetric, trans := transitive,
};
\import std.Set[].Quotient[A := A, Equivalent := Related] \as Quotient;
\definition Carrier: \Set := Quotient.Carrier;
\definition class: A -> Carrier := Quotient.class;
\definition sameClass: \forall (x, y: A) -> Related x y -> class x = class y := Quotient.classOfEq equivalence;
\definition relatedOfSameClass: \forall (x, y: A) -> class x = class y -> Related x y := Quotient.equivalentOfClassEq equivalence;
\definition induction(predicate: Carrier -> \Prop): (\forall (x: A) -> predicate (class x)) -> \forall (q: Carrier) -> predicate q := Quotient.induction predicate;
\definition PathConnected: \Prop := \forall (x, y: A) -> Related x y;
\module IntervalPaths;
\module Functions(B: \Set) {
  \import Quotient.Maps[B := B] \as Native;
  \definition ConstantOnPaths(f: A -> B): \Prop := Native.Respects f;
  \definition descend(f: A -> B)(constant: ConstantOnPaths f): Carrier -> B := Native.value equivalence f constant;
  \definition onClass: \forall (f: A -> B)(constant: ConstantOnPaths f)(x: A) -> descend f constant (class x) = f x := Native.onClass equivalence;
  \definition unique: \forall (f: A -> B)(constant: ConstantOnPaths f)(g: Carrier -> B) ->
    (\forall (x: A) -> g (class x) = f x) -> \forall (q: Carrier) -> g q = descend f constant q := Native.uniqueness equivalence;
}
