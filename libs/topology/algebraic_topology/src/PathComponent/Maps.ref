\import \parent.IntervalPaths[] \as Paths;
\import \root.PathComponent[A := B, source := target] \as Target;
\import Target.IntervalPaths[] \as TargetPaths;
\import \root.Interval[] \as Interval;
\import topology.Continuity[A := A, B := B] \as Continuity;
\import topology.Composition[A := Interval.Carrier, B := A, C := B] \as Composition;
\definition path[f: A -> B][continuous: Continuity.Continuous source target f][x, y: A][h: Path x y]: Target.Path (f x) (f y) :=
  TargetPaths.ofFunction (f x) (f y) (\fun (t: Interval.Carrier) => f (Paths.evaluate x y h t))
    (Composition.composeContinuous Interval.topology source target (Paths.evaluate x y h) f (Paths.continuous x y h) continuous)
    (congr!{A B} f _ _ (Paths.start x y h)) (congr!{A B} f _ _ (Paths.end x y h));
\definition preserves: \forall (f: A -> B) -> Continuity.Continuous source target f -> \forall (x, y: A) -> Related x y -> Target.Related (f x) (f y) := \block {
  \fun (f: A -> B)(continuous: Continuity.Continuous source target f)(x, y: A)(related: Related x y) \then
  \takefrom h: Path x y \by related \then
  \return \exact(path f continuous x y h, Target.Path (f x) (f y))
};
