\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import \root.Euclidean[] \as Euclidean;
\definition Carrier(n: N.Nat^): \Set := Euclidean.Dimension[n := N.Nat^::succ n].Sphere;
\definition topology(n: N.Nat^): topology.Topology[Carrier := Carrier n].Topology := Euclidean.Dimension[n := N.Nat^::succ n].sphereTopology;
\module Zero;
