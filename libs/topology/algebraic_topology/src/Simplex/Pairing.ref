\use Equality.eq_reason;
\import Tuples.Omission[] \as Omission;
\import \parent.Identities[] \as Insertion;
\definition pair[n: N.Nat^][x, y: Coordinate n]: Real.Real :=
  Sums.sum n (\fun (i: Fin.Fin n) => Real.mul (x i) (y i));
\definition leftExtended: \forall (n: N.Nat^)(a: Real.Real)(x: Coordinate n)(y: Coordinate (N.Nat^::succ n)) ->
  pair (N.Nat^::succ n) (Tuples.extend n a x) y = Real.add (Real.mul a (y (Fin.zero n)))
    (pair n x (\fun (i: Fin.Fin n) => y (Fin.succ n i))) :=
  \fun (n: N.Nat^)(a: Real.Real)(x: _)(y: _) => congr2!{Real.Real Real.Real Real.Real} Real.add _ _ _ _
    (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r (y (Fin.zero n))) _ _ (Tuples.atZero n a x))
    (Sums.congruent n _ _ (\fun (i: Fin.Fin n) => congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r (y (Fin.succ n i))) _ _ (Tuples.atSuccessor n a x i)));
\definition rightExtended: \forall (n: N.Nat^)(x: Coordinate (N.Nat^::succ n))(a: Real.Real)(y: Coordinate n) ->
  pair (N.Nat^::succ n) x (Tuples.extend n a y) = Real.add (Real.mul (x (Fin.zero n)) a)
    (pair n (\fun (i: Fin.Fin n) => x (Fin.succ n i)) y) :=
  \fun (n: N.Nat^)(x: _)(a: Real.Real)(y: _) => congr2!{Real.Real Real.Real Real.Real} Real.add _ _ _ _
    (congr!{Real.Real Real.Real} (Real.mul (x (Fin.zero n))) _ _ (Tuples.atZero n a y))
    (Sums.congruent n _ _ (\fun (i: Fin.Fin n) => congr!{Real.Real Real.Real} (Real.mul (x (Fin.succ n i))) _ _ (Tuples.atSuccessor n a y i)));
\module Step(n: N.Nat^);
\definition insertion: \forall (n: N.Nat^)(i: Fin.Fin (N.Nat^::succ n))(x: Coordinate n)(y: Coordinate (N.Nat^::succ n)) ->
  pair (N.Nat^::succ n) (insertZero n i x) y = pair n x (Omission.omit n i y) :=
  \induction (n: N.Nat^) \return \forall (i: Fin.Fin (N.Nat^::succ n))(x: Coordinate n)(y: Coordinate (N.Nat^::succ n)) ->
    pair (N.Nat^::succ n) (insertZero n i x) y = pair n x (Omission.omit n i y) \with {
      | zero: \fun (i: _)(x: _)(y: _) => trans!{Real.Real} _ _ _
          (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.add r Real.zero) _ _ (Laws.fieldMulZeroLeft (y (Fin.zero N.Nat^::zero))))
          (Laws.addZeroLeft Real.zero)
      | succ: \fun (n: N.Nat^)(previous: _) => Step[n := n].law previous
    };
