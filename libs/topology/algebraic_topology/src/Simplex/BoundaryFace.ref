\import \parent.At[n := n] \as Domain;
\import \parent.At[n := N.Nat^::succ n] \as Target;
\import \parent.Boundary[n := N.Nat^::succ n] \as Boundary;
\import \parent.InsertionZero[] \as Insertion;
\import \parent.Faces[n := n] \as Faces;
\definition member: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(x: Carrier n) -> \In[Carrier (N.Nat^::succ n)] Boundary.Points (face n i x) :=
  \fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(x: Carrier n) =>
    Logic.existsIntro[Fin.Fin (N.Nat^::succ (N.Nat^::succ n)), { j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)) \where face n i x j = Real.zero }] i (Insertion.law (N.Nat^::succ n) i x);
\definition apply(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(x: Carrier n): Boundary.Carrier :=
  \into[Carrier (N.Nat^::succ n)](face n i x, Boundary.Points) \by { member i x };
\import topology.Continuity[A := Carrier n, B := Carrier (N.Nat^::succ n)].Corestriction[S := Boundary.Points] \as Into;
\definition continuous: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) ->
  topology.Continuity[A := Carrier n, B := Boundary.Carrier].Continuous Domain.topology Boundary.topology (apply i) :=
  \fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => Into.corestrictContinuous Domain.topology Target.topology (apply i) (Faces.continuous i);
\module Cover;
