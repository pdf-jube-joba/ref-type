\definition Closed(S: \Pow (Carrier n)): \Prop := \forall (r: N.Nat^)(v: Fin.Fin (N.Nat^::succ r) -> Carrier n) ->
  (\forall (i: Fin.Fin (N.Nat^::succ r)) -> \In[Carrier n] S (v i)) -> \forall (x: Carrier r) ->
  \In[Carrier n] S (\parent.Affine[m := r, n := n].apply v x);
\definition intersection(S, T: \Pow (Carrier n)): \Pow (Carrier n) := { x: Carrier n \where Logic.And[\In[Carrier n] S x, \In[Carrier n] T x] };
\definition intersectClosed: \forall (S, T: \Pow (Carrier n)) -> Closed S -> Closed T -> Closed (intersection S T) :=
  \fun (S, T: \Pow (Carrier n))(left: Closed S)(right: Closed T)(r: N.Nat^)(v: Fin.Fin (N.Nat^::succ r) -> Carrier n)
    (contained: \forall (i: Fin.Fin (N.Nat^::succ r)) -> \In[Carrier n] (intersection S T) (v i))(x: Carrier r) => Logic.And[_, _]::#
      (left r v (\fun (i: Fin.Fin (N.Nat^::succ r)) => #left{(contained i)}) x)
      (right r v (\fun (i: Fin.Fin (N.Nat^::succ r)) => #right{(contained i)}) x);
