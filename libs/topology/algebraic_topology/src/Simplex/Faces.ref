\import \parent.At[n := n] \as Source;
\import \parent.At[n := N.Nat^::succ n] \as Target;
\import \parent.Continuity[A := Carrier n, source := Source.topology] \as Components;
\import topological_algebra.Coordinates[K := Real.Real, I := Fin.Fin (N.Nat^::succ (N.Nat^::succ n))].Universal[A := Carrier n] \as Ambient;
\import topology.Continuity[A := Carrier n, B := Coordinate (N.Nat^::succ (N.Nat^::succ n))].Corestriction[S := Points (N.Nat^::succ n)] \as Into;
\import topology.Continuity[A := Carrier n, B := Carrier (N.Nat^::succ n)] \as Maps;
\definition continuous: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) ->
  Maps.Continuous Source.topology Target.topology (face n i) :=
  \fun (i: _) => Into.corestrictContinuous Source.topology Target.ambientTopology (face n i)
    (Ambient.continuous Source.topology Line.topology (\fun (x: Carrier n) => face n i x)
      (Components.insertionContinuous (N.Nat^::succ n) i (\fun (x: Carrier n) => x) Source.coordinateContinuous));
