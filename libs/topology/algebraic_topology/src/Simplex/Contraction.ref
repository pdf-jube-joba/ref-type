\import \parent.At[n := n] \as Space;
\import \parent.Convex[n := n] \as Convex;
\import \root.Contraction[A := Carrier n, source := Space.topology] \as General;
\import \root.Homotopy[A := Carrier n, B := Carrier n] \as Homotopy;
\definition homotopy[y: Carrier n]: Homotopy.Homotopy[Space.topology, Space.topology, (\fun (x: Carrier n) => x), (\fun (_: Carrier n) => y)] :=
  \into[Homotopy.Family](Convex.family y, Homotopy.Homotopy[Space.topology, Space.topology, (\fun (x: Carrier n) => x), (\fun (_: Carrier n) => y)]) \by {
    Homotopy.Laws[Space.topology, Space.topology, (\fun (x: Carrier n) => x), (\fun (_: Carrier n) => y), Convex.family y] {
      continuous := Convex.continuous y,
      start := \fun (x: Carrier n) => Convex.atStart x y,
      end := \fun (x: Carrier n) => Convex.atEnd x y,
    }
  };
\definition contraction[y: Carrier n]: General.Data := General.Data { centre := y, homotopy := homotopy y };
