\import \parent.\parent.Reindex[m := n, n := k] \as Next;
\import \parent.\parent.Reindex[m := m, n := k] \as Composite;
\import \parent.\parent.Affine[m := m, n := k] \as AffineComposite;
\import Affine.Composition[k := k] \as Composition;
\definition law: \forall (f: Function)(g: Next.Function)(x: Carrier m) -> Next.apply g (apply f x) = Composite.apply (\fun (i: Fin.Fin (N.Nat^::succ m)) => g (f i)) x :=
  \fun (f: Function)(g: Next.Function)(x: Carrier m) => trans!{{Carrier k}} _ _ _
    (Composition.law (vertices f) (Next.vertices g) x)
    (congr!{AffineComposite.Vertices {Carrier k}} (\fun (v: AffineComposite.Vertices) => AffineComposite.apply v x) _ _
      (\axiom:funext((\fun (i: Fin.Fin (N.Nat^::succ m)) => Next.apply g (Vertices.vertex n (f i))), Composite.vertices (\fun (i: Fin.Fin (N.Nat^::succ m)) => g (f i)),
        \fun (i: Fin.Fin (N.Nat^::succ m)) => Next.onVertex g (f i))));
