\import Fin.Tuples[A := Fin.Fin (N.Nat^::succ n)].Repetition[] \as Repetition;
\import \parent.Reindex[m := N.Nat^::succ n, n := n] \as Reindex;
\import \parent.Vertices[] \as Vertices;
\definition collapse(i: Fin.Fin (N.Nat^::succ n)): Reindex.Function := Repetition.repeat n i (\fun (j: Fin.Fin (N.Nat^::succ n)) => j);
\definition apply(i: Fin.Fin (N.Nat^::succ n)): Carrier (N.Nat^::succ n) -> Carrier n := Reindex.apply (collapse i);
\definition continuous: \forall (i: Fin.Fin (N.Nat^::succ n)) -> topology.Continuity[A := Carrier (N.Nat^::succ n), B := Carrier n].Continuous
  (\parent.At[n := N.Nat^::succ n].topology) (\parent.At[n := n].topology) (apply i) :=
  \fun (i: Fin.Fin (N.Nat^::succ n)) => Reindex.continuous (collapse i);
\definition onVertex: \forall (i: Fin.Fin (N.Nat^::succ n))(j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) ->
  apply i (Vertices.vertex (N.Nat^::succ n) j) = Vertices.vertex n (collapse i j) :=
  \fun (i: Fin.Fin (N.Nat^::succ n))(j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => Reindex.onVertex (collapse i) j;
\module Sections;
