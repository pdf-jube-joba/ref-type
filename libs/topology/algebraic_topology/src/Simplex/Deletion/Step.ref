\definition Head[x: Coordinate (N.Nat^::succ (N.Nat^::succ n))]: \Prop := x (Fin.zero (N.Nat^::succ n)) = Real.zero ->
  insertZero (N.Nat^::succ n) (Fin.zero (N.Nat^::succ n)) (Omission.omit (N.Nat^::succ n) (Fin.zero (N.Nat^::succ n)) x) = x;
\definition head: \forall (x: Coordinate (N.Nat^::succ (N.Nat^::succ n))) -> Head x :=
  \fun (x: Coordinate (N.Nat^::succ (N.Nat^::succ n)))(zero: x (Fin.zero (N.Nat^::succ n)) = Real.zero) => trans!{{Coordinate (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
    (Identities.insertionHead (N.Nat^::succ n) (Omission.omit (N.Nat^::succ n) (Fin.zero (N.Nat^::succ n)) x))
    (trans!{{Coordinate (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
      (congr2!{Real.Real {Coordinate (N.Nat^::succ n)} {Coordinate (N.Nat^::succ (N.Nat^::succ n))}} (Tuples.extend (N.Nat^::succ n)) _ _ _ _ (sym!{Real.Real} _ _ zero) (Omission.first n x))
      (Tuples.recover (N.Nat^::succ n) x));
\definition tail:
  (\forall (i: Fin.Fin (N.Nat^::succ n))(x: Coordinate (N.Nat^::succ n)) -> x i = Real.zero -> insertZero n i (Omission.omit n i x) = x) ->
  \forall (i: Fin.Fin (N.Nat^::succ n))(x: Coordinate (N.Nat^::succ (N.Nat^::succ n))) -> x (Fin.succ (N.Nat^::succ n) i) = Real.zero ->
    insertZero (N.Nat^::succ n) (Fin.succ (N.Nat^::succ n) i) (Omission.omit (N.Nat^::succ n) (Fin.succ (N.Nat^::succ n) i) x) = x :=
  \fun (previous: _)(i: Fin.Fin (N.Nat^::succ n))(x: Coordinate (N.Nat^::succ (N.Nat^::succ n)))(zero: _) => trans!{{Coordinate (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
    (congr!{{Coordinate (N.Nat^::succ n)} {Coordinate (N.Nat^::succ (N.Nat^::succ n))}} (insertZero (N.Nat^::succ n) (Fin.succ (N.Nat^::succ n) i)) _ _ (Omission.successor n i x))
    (trans!{{Coordinate (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
      (Identities.insertionExtended n i (x (Fin.zero (N.Nat^::succ n))) (Omission.omit n i (\fun (j: Fin.Fin (N.Nat^::succ n)) => x (Fin.succ (N.Nat^::succ n) j))))
      (trans!{{Coordinate (N.Nat^::succ (N.Nat^::succ n))}} _ _ _
        (congr!{{Coordinate (N.Nat^::succ n)} {Coordinate (N.Nat^::succ (N.Nat^::succ n))}} (Tuples.extend (N.Nat^::succ n) (x (Fin.zero (N.Nat^::succ n)))) _ _ (previous i (\fun (j: Fin.Fin (N.Nat^::succ n)) => x (Fin.succ (N.Nat^::succ n) j)) zero))
        (Tuples.recover (N.Nat^::succ n) x)));
\definition law:
  (\forall (i: Fin.Fin (N.Nat^::succ n))(x: Coordinate (N.Nat^::succ n)) -> x i = Real.zero -> insertZero n i (Omission.omit n i x) = x) ->
  \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(x: Coordinate (N.Nat^::succ (N.Nat^::succ n))) -> x i = Real.zero ->
    insertZero (N.Nat^::succ n) i (Omission.omit (N.Nat^::succ n) i x) = x :=
  \fun (previous: _) => Fin.cases (N.Nat^::succ n)
    (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => \forall (x: Coordinate (N.Nat^::succ (N.Nat^::succ n))) -> x i = Real.zero -> insertZero (N.Nat^::succ n) i (Omission.omit (N.Nat^::succ n) i x) = x)
    head (tail previous);
