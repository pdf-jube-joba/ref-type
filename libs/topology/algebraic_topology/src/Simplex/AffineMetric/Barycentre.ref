\import \parent.\parent.Barycentre[n := m] \as Centre;
\import \parent.\parent.Compactness[n := m] \as Compact;
\import Sums.Exclusion[] \as Exclusion;
\import Real.Algebra[] \as Algebra;
\import Real.Estimates[] \as Estimates;
\import Real.Distance[] \as Distance;
\definition factor: Real.Real := Real.sub Real.one Centre.weight;
\definition nonnegative: R.Le Real.zero factor := Distance.subNonnegative Real.one Centre.weight (Compact.coordinateBound Centre.point (Fin.zero m));
\definition belowOne: R.Lt factor Real.one := R.ltReplaceRight factor (Real.sub Real.one Real.zero) Real.one
  (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (Real.add Real.one) _ _ Laws.negZero) (Laws.addZeroRight Real.one))
  (Laws.ltAddLeft Real.one (Real.neg Centre.weight) (Real.neg Real.zero) (Laws.negStrictAntitone Real.zero Centre.weight Centre.positive));
\definition radiusNonnegative: \forall (r: Real.Real) -> R.Le Real.zero r -> R.Le Real.zero (Real.mul factor r) :=
  \fun (r: Real.Real)(positive: R.Le Real.zero r) => Laws.fieldMulNonnegative factor r nonnegative positive;
\definition remainder: \forall (r: Real.Real) -> Real.sub (Sums.sum (N.Nat^::succ m) (\fun (i: Fin.Fin (N.Nat^::succ m)) => Real.mul Centre.weight r)) (Real.mul Centre.weight r) = Real.mul factor r :=
  \fun (r: Real.Real) => trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real} (\fun (s: Real.Real) => Real.sub s (Real.mul Centre.weight r)) _ _ (Convex.constant (N.Nat^::succ m) Centre.point r Centre.total))
    (trans!{Real.Real} _ _ _
      (congr!{Real.Real Real.Real} (\fun (s: Real.Real) => Real.sub s (Real.mul Centre.weight r)) _ _ (sym!{Real.Real} _ _ (Laws.fieldMulOneLeft r)))
      (sym!{Real.Real} _ _ (Algebra.subMul Real.one Centre.weight r)));
\definition vertexRadius: \forall (v: Affine.Vertices)(r: Real.Real) -> R.Le Real.zero r ->
  (\forall (i, k: Fin.Fin (N.Nat^::succ m)) -> R.Le (#distance{Metric.metric} (v i) (v k)) r) ->
  \forall (i: Fin.Fin (N.Nat^::succ m)) -> R.Le (#distance{Metric.metric} (Affine.apply v Centre.point) (v i)) (Real.mul factor r) :=
  \fun (v: Affine.Vertices)(r: Real.Real)(positive: R.Le Real.zero r)(bounds: \forall (i, k: Fin.Fin (N.Nat^::succ m)) -> R.Le (#distance{Metric.metric} (v i) (v k)) r)(i: Fin.Fin (N.Nat^::succ m)) =>
    Metric.distanceUpper (Affine.apply v Centre.point) (v i) (Real.mul factor r) (radiusNonnegative r positive)
      (\fun (j: Fin.Fin (N.Nat^::succ n)) => \block {
        \let f: Fin.Fin (N.Nat^::succ m) -> Real.Real := \fun (k: Fin.Fin (N.Nat^::succ m)) => Real.mul Centre.weight (Real.distance (v k j) (v i j)) \then
        \let g: Fin.Fin (N.Nat^::succ m) -> Real.Real := \fun (_: Fin.Fin (N.Nat^::succ m)) => Real.mul Centre.weight r \then
        \let vanishes: f i = Real.zero := trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (Real.mul Centre.weight) _ _ (Distance.distanceSelf (v i j))) (Laws.fieldMulZeroRight Centre.weight) \then
        \let comparison: \forall (k: Fin.Fin (N.Nat^::succ m)) -> R.Le (f k) (g k) := \fun (k: Fin.Fin (N.Nat^::succ m)) => Estimates.mulMonotone Centre.weight _ _
          (R.Order[].leOfLt Real.zero Centre.weight Centre.positive) (R.leTrans _ _ _ (Metric.coordinateDistance (v k) (v i) j) (bounds k i)) \then
        \let first: R.Le (Real.distance (Affine.apply v Centre.point j) (v i j)) (Sums.sum (N.Nat^::succ m) f) :=
          R.leReplaceLeft _ _ _
            (congr!{Real.Real Real.Real} (Real.distance (Affine.apply v Centre.point j)) _ _ (Convex.constant (N.Nat^::succ m) Centre.point (v i j) Centre.total))
            (Convex.weightedDistance (N.Nat^::succ m) Centre.point (\fun (k: Fin.Fin (N.Nat^::succ m)) => v k j) (\fun (_: Fin.Fin (N.Nat^::succ m)) => v i j) #nonnegative{(barycentric m Centre.point)}) \then
        \return R.leTrans _ _ _ first (R.leReplaceRight _ _ _ (remainder r) (Exclusion.bound (N.Nat^::succ m) f g i vanishes comparison))
      });
\definition allPoints: \forall (v: Affine.Vertices)(r: Real.Real) -> R.Le Real.zero r ->
  (\forall (i, k: Fin.Fin (N.Nat^::succ m)) -> R.Le (#distance{Metric.metric} (v i) (v k)) r) ->
  \forall (x: Carrier m) -> R.Le (#distance{Metric.metric} (Affine.apply v Centre.point) (Affine.apply v x)) (Real.mul factor r) :=
  \fun (v: Affine.Vertices)(r: Real.Real)(positive: R.Le Real.zero r)(bounds: \forall (i, k: Fin.Fin (N.Nat^::succ m)) -> R.Le (#distance{Metric.metric} (v i) (v k)) r)(x: Carrier m) =>
    R.leReplaceLeft _ _ _ (#symmetric{Metric.metric} (Affine.apply v x) (Affine.apply v Centre.point))
      (radius v x (Affine.apply v Centre.point) (Real.mul factor r) (radiusNonnegative r positive)
        (\fun (i: Fin.Fin (N.Nat^::succ m)) => R.leReplaceLeft _ _ _ (#symmetric{Metric.metric} (Affine.apply v Centre.point) (v i)) (vertexRadius v r positive bounds i)));
