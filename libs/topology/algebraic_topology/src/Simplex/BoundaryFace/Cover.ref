\import \parent.\parent.Deletion[] \as Deletion;
\definition preimage(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(x: Carrier (N.Nat^::succ n))(zero: x i = Real.zero): Carrier n :=
  \into[Coordinate (N.Nat^::succ n)](Deletion.apply (N.Nat^::succ n) i x, Points n) \by {
    Barycentric[N.Nat^::succ n, Deletion.apply (N.Nat^::succ n) i x] {
      nonnegative := Deletion.Positive[n := N.Nat^::succ n].law i x #nonnegative{(barycentric (N.Nat^::succ n) x)},
      total := trans!{Real.Real} _ _ _ (Deletion.total (N.Nat^::succ n) i x zero) #total{(barycentric (N.Nat^::succ n) x)},
    }
  };
\definition recover: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(x: Carrier (N.Nat^::succ n))(zero: x i = Real.zero) -> face n i (preimage i x zero) = x :=
  \fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(x: Carrier (N.Nat^::succ n))(zero: x i = Real.zero) =>
    \axiom:funext(face n i (preimage i x zero), x, \fun (j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) =>
      congr!{{Coordinate (N.Nat^::succ (N.Nat^::succ n))} Real.Real} (\fun (v: Coordinate (N.Nat^::succ (N.Nat^::succ n))) => v j) _ _
        (Deletion.recover (N.Nat^::succ n) i x zero));
\structure Lift[x: Boundary.Carrier]: \Set {
  index: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)),
  point: Carrier n,
  equation: face n index point = x,
}
\definition covers: \forall (x: Boundary.Carrier) -> \exists Lift[x] := \block {
  \fun (x: Boundary.Carrier) \then
  \takefrom i: Boundary.ZeroCoordinate x \by \bysub(Carrier (N.Nat^::succ n), Boundary.Points, x) \then
  \let zero: x i = Real.zero := \bysub(Fin.Fin (N.Nat^::succ (N.Nat^::succ n)), Boundary.ZeroCoordinate x, i) \then
  \return \exact(Lift[x] { index := i, point := preimage i x zero, equation := recover i x zero }, Lift[x])
};
