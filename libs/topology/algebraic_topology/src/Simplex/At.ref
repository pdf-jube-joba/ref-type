\definition Index: \Set := Fin.Fin (N.Nat^::succ n);
\definition CoordinateCarrier: \Set := Coordinate (N.Nat^::succ n);
\definition CarrierSet: \Set := Carrier n;
\import topological_algebra.Coordinates[K := Real.Real, I := Index] \as Coordinates;
\import topology.Topology[Carrier := CoordinateCarrier] \as Ambient;
\import Ambient.Subspace[S := Points n] \as Subspace;
\import topology.Topology[Carrier := CarrierSet] \as Space;
\definition ambientTopology: Ambient.Topology := Coordinates.topology Line.topology;
\definition topology: Space.Topology := Subspace.topology ambientTopology;
\import topology.Continuity[A := CarrierSet, B := CoordinateCarrier].Corestriction[S := Points n] \as Into;
\definition inclusionContinuous: \forall (U: \Pow CoordinateCarrier) -> Ambient.IsOpenIn ambientTopology U ->
  Space.IsOpenIn topology (Subspace.Trace U) := Into.inclusionContinuous ambientTopology;
\import topology.Continuity[A := CarrierSet, B := Real.Real] \as ScalarMaps;
\import topology.Composition[A := CarrierSet, B := CoordinateCarrier, C := Real.Real] \as Composition;
\definition coordinateContinuous: \forall (i: Index) -> ScalarMaps.Continuous topology Line.topology (\fun (x: CarrierSet) => x i) :=
  \fun (i: Index) => Composition.composeContinuous topology ambientTopology Line.topology (\fun (x: CarrierSet) => x)
    (\fun (x: CoordinateCarrier) => x i) inclusionContinuous (Coordinates.evaluationContinuous Line.topology i);
