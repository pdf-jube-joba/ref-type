\import \parent.At[n := N.Nat^::zero, k := k] \as Degree;
\import \parent.\parent.\parent.Affine[m := N.Nat^::zero, n := k] \as Affine;
\import \parent.\parent.\parent.Metric[n := k] \as Metric;
\import \parent.\parent.\parent.AffineMetric[m := N.Nat^::zero, n := k].Barycentre[] \as Centre;
\definition law: Degree.Statement := \fun (v: Affine.Vertices)(c: Cell N.Nat^::zero)(r: Real.Real)(positive: R.Le Real.zero r)(bounds: Degree.Diameter v r)(i, j: Fin.Fin (N.Nat^::succ N.Nat^::zero)) =>
  R.leReplaceLeft Real.zero (#distance{Metric.metric} (Affine.apply v zeroPoint) (Affine.apply v zeroPoint)) (Real.mul Centre.factor r)
    (sym!{Real.Real} _ _ (#self{Metric.metric} (Affine.apply v zeroPoint))) (Centre.radiusNonnegative r positive);
