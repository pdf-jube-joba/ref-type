\import \parent.Face[v := v, i := Cells.faceIndex c] \as Face;
\import \parent.\parent.\parent.\parent.AffineMetric[m := n, n := k].Barycentre[] \as LowerCentre;
\definition head: Higher.image v c (Fin.zero (N.Nat^::succ n)) = Affine.apply v Point.point :=
  congr!{{Carrier (N.Nat^::succ n)} {Carrier k}} (Affine.apply v) _ _ (Cells.head (vertices n) c);
\definition rawTail: \forall (j: Fin.Fin (N.Nat^::succ n)) -> Higher.image v c (Fin.succ (N.Nat^::succ n) j) =
  Affine.apply v (face n (Cells.faceIndex c) (vertices n (Cells.lower c) j)) :=
  \fun (j: Fin.Fin (N.Nat^::succ n)) => congr!{{Carrier (N.Nat^::succ n)} {Carrier k}} (Affine.apply v) _ _ (Cells.successor (vertices n) c j);
\definition tail: \forall (j: Fin.Fin (N.Nat^::succ n)) -> Higher.image v c (Fin.succ (N.Nat^::succ n) j) = Lower.image Face.values (Cells.lower c) j :=
  \fun (j: Fin.Fin (N.Nat^::succ n)) => trans!{{Carrier k}} _ _ _ (rawTail j) (Face.equation (vertices n (Cells.lower c) j));
\definition radiusLe: R.Le Real.zero r -> R.Le (Real.mul LowerCentre.factor r) (Real.mul Centre.factor r) :=
  \fun (positive: R.Le Real.zero r) => R.leReplace _ _ _ _ (Laws.fieldMulComm r LowerCentre.factor) (Laws.fieldMulComm r Centre.factor)
    (Estimates.mulMonotone r LowerCentre.factor Centre.factor positive Growth.factorLe);
\definition headTail: R.Le Real.zero r -> Higher.Diameter v r -> \forall (j: Fin.Fin (N.Nat^::succ n)) ->
  R.Le (#distance{Metric.metric} (Higher.image v c (Fin.zero (N.Nat^::succ n))) (Higher.image v c (Fin.succ (N.Nat^::succ n) j))) (Real.mul Centre.factor r) :=
  \fun (positive: R.Le Real.zero r)(original: Higher.Diameter v r)(j: Fin.Fin (N.Nat^::succ n)) => R.leReplaceLeft _ _ _
    (congr2!{{Carrier k} {Carrier k} Real.Real} (#distance{Metric.metric}) _ _ _ _ (sym!{{Carrier k}} _ _ head) (sym!{{Carrier k}} _ _ (rawTail j)))
    (Centre.allPoints v r positive original (face n (Cells.faceIndex c) (vertices n (Cells.lower c) j)));
\definition tailTail: Property n -> R.Le Real.zero r -> Higher.Diameter v r -> \forall (i, j: Fin.Fin (N.Nat^::succ n)) ->
  R.Le (#distance{Metric.metric} (Higher.image v c (Fin.succ (N.Nat^::succ n) i)) (Higher.image v c (Fin.succ (N.Nat^::succ n) j))) (Real.mul Centre.factor r) :=
  \fun (previous: Property n)(positive: R.Le Real.zero r)(original: Higher.Diameter v r)(i, j: Fin.Fin (N.Nat^::succ n)) => R.leReplaceLeft _ _ _
    (congr2!{{Carrier k} {Carrier k} Real.Real} (#distance{Metric.metric}) _ _ _ _ (sym!{{Carrier k}} _ _ (tail i)) (sym!{{Carrier k}} _ _ (tail j)))
    (R.leTrans _ _ _ (previous k Face.values (Cells.lower c) r positive (Face.bounds r positive original) i j) (radiusLe positive));
\definition self: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) -> R.Le Real.zero r -> R.Le (#distance{Metric.metric} (Higher.image v c i) (Higher.image v c i)) (Real.mul Centre.factor r) :=
  \fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(positive: R.Le Real.zero r) => R.leReplaceLeft Real.zero _ _ (sym!{Real.Real} _ _ (#self{Metric.metric} (Higher.image v c i))) (Centre.radiusNonnegative r positive);
\definition law: Property n -> R.Le Real.zero r -> Higher.Diameter v r -> Higher.Bound v c r :=
  \fun (previous: Property n)(positive: R.Le Real.zero r)(original: Higher.Diameter v r) => Fin.cases (N.Nat^::succ n)
    (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => \forall (j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) -> R.Le (#distance{Metric.metric} (Higher.image v c i) (Higher.image v c j)) (Real.mul Centre.factor r))
    (Fin.cases (N.Nat^::succ n) (\fun (j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => R.Le (#distance{Metric.metric} (Higher.image v c (Fin.zero (N.Nat^::succ n))) (Higher.image v c j)) (Real.mul Centre.factor r))
      (self (Fin.zero (N.Nat^::succ n)) positive) (headTail positive original))
    (\fun (i: Fin.Fin (N.Nat^::succ n)) => Fin.cases (N.Nat^::succ n) (\fun (j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => R.Le (#distance{Metric.metric} (Higher.image v c (Fin.succ (N.Nat^::succ n) i)) (Higher.image v c j)) (Real.mul Centre.factor r))
      (R.leReplaceLeft _ _ _ (#symmetric{Metric.metric} (Higher.image v c (Fin.zero (N.Nat^::succ n))) (Higher.image v c (Fin.succ (N.Nat^::succ n) i))) (headTail positive original i))
      (tailTail previous positive original i));
