\import \parent.\parent.Affine[m := n, n := n] \as Affine;
\definition map(c: Cell n): Carrier n -> Carrier n := Affine.apply (vertices n c);
\definition continuous: \forall (c: Cell n) -> topology.Continuity[A := Carrier n, B := Carrier n].Continuous
  (\parent.\parent.At[n := n].topology) (\parent.\parent.At[n := n].topology) (map c) := \fun (c: Cell n) => Affine.continuous (vertices n c);
