\definition law:
  (\forall (i: Fin.Fin (N.Nat^::succ n))(x: Coordinate n)(y: Coordinate (N.Nat^::succ n)) ->
    pair (N.Nat^::succ n) (insertZero n i x) y = pair n x (Omission.omit n i y)) ->
  \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(x: Coordinate (N.Nat^::succ n))(y: Coordinate (N.Nat^::succ (N.Nat^::succ n))) ->
    pair (N.Nat^::succ (N.Nat^::succ n)) (insertZero (N.Nat^::succ n) i x) y = pair (N.Nat^::succ n) x (Omission.omit (N.Nat^::succ n) i y) :=
  \fun (previous: _) => Fin.cases (N.Nat^::succ n) (\fun (i: _) => \forall (x: Coordinate (N.Nat^::succ n))(y: Coordinate (N.Nat^::succ (N.Nat^::succ n))) ->
    pair (N.Nat^::succ (N.Nat^::succ n)) (insertZero (N.Nat^::succ n) i x) y = pair (N.Nat^::succ n) x (Omission.omit (N.Nat^::succ n) i y))
    (\fun (x: _)(y: _) => eq_reason!{
      {pair (N.Nat^::succ (N.Nat^::succ n)) (insertZero (N.Nat^::succ n) (Fin.zero (N.Nat^::succ n)) x) y}
      "=" {pair (N.Nat^::succ (N.Nat^::succ n)) (Tuples.extend (N.Nat^::succ n) Real.zero x) y} "by" {
        congr!{{Coordinate (N.Nat^::succ (N.Nat^::succ n))} Real.Real} (\fun (v: _) => pair (N.Nat^::succ (N.Nat^::succ n)) v y) _ _ (Insertion.insertionHead (N.Nat^::succ n) x)}
      "=" {Real.add (Real.mul Real.zero (y (Fin.zero (N.Nat^::succ n)))) (pair (N.Nat^::succ n) x (\fun (j: _) => y (Fin.succ (N.Nat^::succ n) j)))} "by" {leftExtended (N.Nat^::succ n) Real.zero x y}
      "=" {pair (N.Nat^::succ n) x (\fun (j: _) => y (Fin.succ (N.Nat^::succ n) j))} "by" {
        trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.add r (pair (N.Nat^::succ n) x (\fun (j: Fin.Fin (N.Nat^::succ n)) => y (Fin.succ (N.Nat^::succ n) j)))) _ _ (Laws.fieldMulZeroLeft (y (Fin.zero (N.Nat^::succ n))))) (Laws.addZeroLeft (pair (N.Nat^::succ n) x (\fun (j: Fin.Fin (N.Nat^::succ n)) => y (Fin.succ (N.Nat^::succ n) j))))}
      "=" {pair (N.Nat^::succ n) x (Omission.omit (N.Nat^::succ n) (Fin.zero (N.Nat^::succ n)) y)} "by" {
        congr!{{Coordinate (N.Nat^::succ n)} Real.Real} (pair (N.Nat^::succ n) x) _ _ (sym!{{Coordinate (N.Nat^::succ n)}} _ _ (Omission.first n y))}
    })
    (\fun (i: _)(x: _)(y: _) => eq_reason!{
      {pair (N.Nat^::succ (N.Nat^::succ n)) (insertZero (N.Nat^::succ n) (Fin.succ (N.Nat^::succ n) i) x) y}
      "=" {pair (N.Nat^::succ (N.Nat^::succ n)) (Tuples.extend (N.Nat^::succ n) (x (Fin.zero n)) (insertZero n i (\fun (j: _) => x (Fin.succ n j)))) y} "by" {
        congr!{{Coordinate (N.Nat^::succ (N.Nat^::succ n))} Real.Real} (\fun (v: _) => pair (N.Nat^::succ (N.Nat^::succ n)) v y) _ _ (Insertion.insertionTail n i x)}
      "=" {Real.add (Real.mul (x (Fin.zero n)) (y (Fin.zero (N.Nat^::succ n))))
        (pair (N.Nat^::succ n) (insertZero n i (\fun (j: _) => x (Fin.succ n j))) (\fun (j: _) => y (Fin.succ (N.Nat^::succ n) j)))} "by" {leftExtended (N.Nat^::succ n) (x (Fin.zero n)) _ y}
      "=" {Real.add (Real.mul (x (Fin.zero n)) (y (Fin.zero (N.Nat^::succ n))))
        (pair n (\fun (j: _) => x (Fin.succ n j)) (Omission.omit n i (\fun (j: _) => y (Fin.succ (N.Nat^::succ n) j))))} "by" {
        congr!{Real.Real Real.Real} (Real.add (Real.mul (x (Fin.zero n)) (y (Fin.zero (N.Nat^::succ n))))) _ _ (previous i _ _)}
      "=" {pair (N.Nat^::succ n) x (Tuples.extend n (y (Fin.zero (N.Nat^::succ n))) (Omission.omit n i (\fun (j: _) => y (Fin.succ (N.Nat^::succ n) j))))} "by" {
        sym!{Real.Real} _ _ (rightExtended n x (y (Fin.zero (N.Nat^::succ n))) _)}
      "=" {pair (N.Nat^::succ n) x (Omission.omit (N.Nat^::succ n) (Fin.succ (N.Nat^::succ n) i) y)} "by" {
        congr!{{Coordinate (N.Nat^::succ n)} Real.Real} (pair (N.Nat^::succ n) x) _ _ (sym!{{Coordinate (N.Nat^::succ n)}} _ _ (Omission.successor n i y))}
    });
