\import Sums.Linear[] \as Linear;
\import \parent.Vertices[] \as Vertices;
\import \parent.Affine[m := n, n := n] \as Affine;
\definition coordinate(j: Fin.Fin (N.Nat^::succ n)): Linear.Map (N.Nat^::succ n) := Linear.Data[N.Nat^::succ n] {
  apply := \fun (x: Coordinate (N.Nat^::succ n)) => x j,
  additive := \fun (x, y: Coordinate (N.Nat^::succ n)) => \refl(Real.add (x j) (y j)),
  homogeneous := \fun (c: Real.Real)(x: Coordinate (N.Nat^::succ n)) => \refl(Real.mul c (x j)),
};
\definition law: \forall (x: Carrier n) -> Affine.apply (Vertices.vertex n) x = x :=
  \fun (x: Carrier n) => \axiom:funext(Affine.apply (Vertices.vertex n) x, x,
    \fun (j: Fin.Fin (N.Nat^::succ n)) => sym!{Real.Real} _ _ (Linear.expansion (N.Nat^::succ n) (coordinate j) x));
