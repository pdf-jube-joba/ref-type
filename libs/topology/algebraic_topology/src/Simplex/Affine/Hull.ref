\import \parent.\parent.AffineVertex[m := m, n := n] \as Evaluation;
\definition Points: \Pow (Carrier n) := { y: Carrier n \where \exists { x: Carrier m \where apply vertices x = y } };
\definition member(x: Carrier m): \In[Carrier n] Points (apply vertices x) :=
  Logic.existsIntro[Carrier m, { z: Carrier m \where apply vertices z = apply vertices x }] x (\refl(apply vertices x));
\definition vertexMember(i: Fin.Fin (N.Nat^::succ m)): \In[Carrier n] Points (vertices i) :=
  Logic.existsIntro[Carrier m, { x: Carrier m \where apply vertices x = vertices i }] (\parent.\parent.Vertices[].vertex m i) (Evaluation.law vertices i);
\module In(r: N.Nat^);
\definition closed: \forall (r: N.Nat^)(w: Fin.Fin (N.Nat^::succ r) -> Carrier n) ->
  (\forall (i: Fin.Fin (N.Nat^::succ r)) -> \In[Carrier n] Points (w i)) -> \forall (x: Carrier r) ->
  \In[Carrier n] Points (\parent.\parent.Affine[m := r, n := n].apply w x) := \fun (r: N.Nat^) => In[r := r].law;
