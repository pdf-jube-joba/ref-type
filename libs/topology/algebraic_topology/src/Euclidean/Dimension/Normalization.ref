\import \parent.Geometry[] \as Geometry;
\import \parent.Contraction[] \as Scaling;
\import Real.Algebra[] \as Algebra;
\import Real.SquareRoot[] \as Root;
\import Real.Inverse[] \as Inverse;
\import R.Arithmetic[].Prop[] \as Laws;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\definition Nonzero: \Set := \Cast[Coordinate] ({ x: Coordinate \where Logic.Not (normSquared x = Real.zero) });
\definition normNonzero: \forall (x: Nonzero) -> Logic.Not (Geometry.norm x = Real.zero) :=
  \fun (x: Nonzero)(equal: _) => (\bysub(Coordinate, Nonzero, x))
    (trans!{Real.Real} _ _ _ (sym!{Real.Real} _ _ (Geometry.normSquaredOfNorm x))
      (trans!{Real.Real} _ _ _ (congr2!{Real.Real Real.Real Real.Real} Real.mul _ _ _ _ equal equal) (Laws.fieldMulZeroLeft Real.zero)));
\definition normalizedSquared: \forall (x: Nonzero) -> normSquared (Scaling.scale (Laws.fieldInv (Geometry.norm x)) x) = Real.one :=
  \fun (x: Nonzero) => trans!{Real.Real} _ _ _ (Scaling.normScale (Laws.fieldInv (Geometry.norm x)) x)
    (trans!{Real.Real} _ _ _
      (congr!{Real.Real Real.Real} (Real.mul (Real.mul (Laws.fieldInv (Geometry.norm x)) (Laws.fieldInv (Geometry.norm x)))) _ _
        (sym!{Real.Real} _ _ (Geometry.normSquaredOfNorm x)))
      (trans!{Real.Real} _ _ _ (Algebra.mulFour (Laws.fieldInv (Geometry.norm x)) (Laws.fieldInv (Geometry.norm x)) (Geometry.norm x) (Geometry.norm x))
        (trans!{Real.Real} _ _ _
          (congr2!{Real.Real Real.Real Real.Real} Real.mul _ _ _ _
            (Laws.fieldInverseNonzero (Geometry.norm x) (normNonzero x)) (Laws.fieldInverseNonzero (Geometry.norm x) (normNonzero x)))
          (Laws.fieldMulOneLeft Real.one))));
\definition normalize[x: Nonzero]: Sphere := \into[Coordinate](Scaling.scale (Laws.fieldInv (Geometry.norm x)) x, Boundary) \by { normalizedSquared x };
\definition ofSphere[x: Sphere]: Nonzero := \into[Coordinate](x, Nonzero) \by {
  \fun (equal: normSquared x = Real.zero) => Laws.zeroNeOne
    (trans!{Real.Real} _ _ _ (sym!{Real.Real} _ _ equal) (\bysub(Coordinate, Boundary, x)))
};
\definition normOnSphere: \forall (x: Sphere) -> Geometry.norm x = Real.one :=
  \fun (x: Sphere) => trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real} Root.sqrt _ _ (\bysub(Coordinate, Boundary, x))) Root.sqrtOne;
\definition inverseOne: Laws.fieldInv Real.one = Real.one :=
  sym!{Real.Real} _ _ (Inverse.inverseUnique Real.one Real.one (\fun (equal: Real.one = Real.zero) => Laws.zeroNeOne (sym!{Real.Real} _ _ equal))
    (Laws.fieldMulOneLeft Real.one));
\definition normalizesUnit: \forall (x: Sphere) -> normalize (ofSphere x) = x :=
  \fun (x: Sphere) => \axiom:funext(normalize (ofSphere x), x, \fun (i: Index) => trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real} (\fun (a: Real.Real) => Real.mul a (x i)) _ _
      (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} Laws.fieldInv _ _ (normOnSphere x)) inverseOne))
    (Laws.fieldMulOneLeft (x i)));
\module Continuity(A: \Set);
