\import topological_algebra.Coordinates[K := Real.Real, I := Index] \as LowerCoordinates;
\import topology.Continuity[A := Coordinate, B := Coordinate].Corestriction[S := Boundary] \as Inclusion;
\import topology.Composition[A := Sphere, B := Coordinate, C := Real.Real] \as Evaluation;
\import metric_spaces.RealFunctions[A := Sphere] \as Functions;
\import \parent.Continuity[A := Sphere] \as Join;
\import topology.Continuity[A := Sphere, B := Higher.Coordinate].Corestriction[S := Higher.Boundary] \as Into;
\definition coordinateContinuous: \forall (i: Index) -> Functions.Continuous sphereTopology (\fun (x: Sphere) => x i) :=
  \fun (i: Index) => Evaluation.composeContinuous sphereTopology topology Line.topology
    (\fun (x: Sphere) => x) (\fun (x: Coordinate) => x i) (Inclusion.inclusionContinuous topology)
    (LowerCoordinates.evaluationContinuous Line.topology i);
\definition continuous: topology.Continuity[A := Sphere, B := Higher.Sphere].Continuous sphereTopology Higher.sphereTopology equator :=
  Into.corestrictContinuous sphereTopology Higher.topology equator
    (Join.joinContinuous sphereTopology (\fun (_: Sphere) => Real.zero) (\fun (x: Sphere) => x)
      (Functions.constantContinuous sphereTopology Real.zero) coordinateContinuous);
