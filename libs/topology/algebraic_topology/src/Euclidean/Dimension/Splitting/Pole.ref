\definition tailSquared: \forall (x: Higher.Sphere) -> Real.mul (head x) (head x) = Real.one -> normSquared (tail x) = Real.zero :=
  \fun (x: Higher.Sphere)(unit: _) => Laws.addCancelLeft Real.one (normSquared (tail x)) Real.zero
    (trans!{Real.Real} _ _ _
      (congr!{Real.Real Real.Real} (\fun (a: Real.Real) => Real.add a (normSquared (tail x))) _ _ (sym!{Real.Real} _ _ unit))
      (trans!{Real.Real} _ _ _ (sym!{Real.Real} _ _ (normSplit x))
        (trans!{Real.Real} _ _ _ (\bysub(Higher.Coordinate, Higher.Boundary, x)) (sym!{Real.Real} _ _ (Laws.addZeroRight Real.one)))));
\definition determined: \forall (x: Higher.Sphere)(a: Real.Real)(unit: Real.mul a a = Real.one) -> head x = a -> x = pole a unit :=
  \fun (x: Higher.Sphere)(a: Real.Real)(unit: _)(equal: _) => ext x (pole a unit)
    (trans!{Real.Real} _ _ _ equal (sym!{Real.Real} _ _ (headJoin a Contraction.zero)))
    (trans!{Coordinate} _ _ _
      (Geometry.normSquaredZero (tail x) (tailSquared x (trans!{Real.Real} _ _ _ (congr2!{Real.Real Real.Real Real.Real} Real.mul _ _ _ _ equal equal) unit)))
      (sym!{Coordinate} _ _ (tailJoin a Contraction.zero)));
