\definition Index: \Set := Fin.Fin n;
\definition Coordinate: \Set := Index -> Real.Real;
\import topological_algebra.Coordinates[K := Real.Real, I := Index] \as Coordinates;
\import topology.Topology[Carrier := Coordinate] \as Space;
\definition topology: Space.Topology := Coordinates.topology Line.topology;
\definition normSquared: Coordinate -> Real.Real := normSquaredAt n;
\definition ClosedBall: \Pow Coordinate := closedBallAt n;
\definition Boundary: \Pow Coordinate := boundaryAt n;
\definition Interior: \Pow Coordinate := interiorAt n;
\import Space.Subspace[S := ClosedBall] \as Ball;
\import Space.Subspace[S := Boundary] \as SphereSubspace;
\import Space.Subspace[S := Interior] \as OpenBall;
\import topology.Topology[Carrier := Ball.CarrierSet] \as BallSpace;
\import topology.Topology[Carrier := SphereSubspace.CarrierSet] \as SphereSpace;
\definition Disk: \Set := Ball.CarrierSet;
\definition Sphere: \Set := SphereSubspace.CarrierSet;
\definition diskTopology: BallSpace.Topology := Ball.topology topology;
\definition sphereTopology: SphereSpace.Topology := SphereSubspace.topology topology;
\module Geometry;
