\import topology.Topology[Carrier := B] \as Target;
\import topology.Continuity[A := A, B := B] \as Maps;
\import topology.Continuity[A := SubCylinder.Carrier, B := B] \as SubMaps;
\import topology.Continuity[A := Cylinder.Carrier, B := B] \as CylinderMaps;
\import algebraic_topology.Homotopy[A := A, B := B] \as Homotopy;
\import Wedge.Universal[D := B] \as Glued;
\import topology.Composition[A := Cylinder.Carrier, B := Wedge.Carrier, C := B] \as Compose;
\structure ProblemData: \Set {
  initial: A -> B,
  family: SubCylinder.Carrier -> B,
}
\structure ProblemLaws[source: Space.Topology, target: Target.Topology, data: ProblemData]: \Prop {
  initialContinuous: Maps.Continuous source target data.initial,
  familyContinuous: SubMaps.Continuous (SubCylinder.topology (Subspace.topology source)) target data.family,
  agrees: \forall (x: Subspace.CarrierSet) -> data.family (SubCylinder.at Interval.start x) = data.initial x,
}
\definition Problem[source: Space.Topology, target: Target.Topology]: \Set :=
  \Cast[ProblemData] ({ data: ProblemData \where ProblemLaws[source, target, data] });
\structure ExtensionLaws[source: Space.Topology, target: Target.Topology, problem: ProblemData, family: Homotopy.Family]: \Prop {
  continuous: CylinderMaps.Continuous (Cylinder.topology source) target family,
  initial: \forall (x: A) -> family (Cylinder.at Interval.start x) = problem.initial x,
  extends: \forall (t: Interval.Carrier) (x: Subspace.CarrierSet) -> family (Cylinder.at t x) = problem.family (SubCylinder.at t x),
}
\definition Extension[source: Space.Topology, target: Target.Topology, problem: ProblemData]: \Set :=
  \Cast[Homotopy.Family] ({ family: Homotopy.Family \where ExtensionLaws[source, target, problem, family] });
\definition HomotopyExtensionProperty(source: Space.Topology) (target: Target.Topology): \Prop :=
  \forall (problem: Problem[source, target]) -> \exists Extension[source, target, problem];
\definition problemLaws(source: Space.Topology) (target: Target.Topology) (problem: Problem[source, target]): ProblemLaws[source, target, problem] :=
  \bysub(ProblemData, Problem[source, target], problem);
\definition compatible(source: Space.Topology) (target: Target.Topology) (problem: Problem[source, target]):
  Glued.Compatible (#initial{problem}) (#family{problem}) :=
  \fun (x: Subspace.CarrierSet) => sym!{B} _ _ (#agrees{(problemLaws source target problem)} x);
\definition joined(source: Space.Topology) (target: Target.Topology) (problem: Problem[source, target]): Wedge.Carrier -> B :=
  Glued.apply (#initial{problem}) (#family{problem}) (compatible source target problem);
\definition retractLaws(source: Space.Topology) (r: Retraction[source]): RetractionLaws[source, r] := \bysub(RetractionData, Retraction[source], r);
\definition extend(source: Space.Topology) (target: Target.Topology) (r: Retraction[source]) (problem: Problem[source, target]):
  Extension[source, target, problem] := \into[Homotopy.Family](\fun (p: Cylinder.Carrier) => joined source target problem (#apply{r} p),
    Extension[source, target, problem]) \by {
      ExtensionLaws[source, target, problem, (\fun (p: Cylinder.Carrier) => joined source target problem (#apply{r} p))] {
        continuous := Compose.composeContinuous (Cylinder.topology source) (wedgeTopology source) target (#apply{r}) (joined source target problem)
          (#continuous{(retractLaws source r)})
          (Glued.continuous source (SubCylinder.topology (Subspace.topology source)) target
            (#initial{problem}) (#family{problem}) (compatible source target problem)
            (#initialContinuous{(problemLaws source target problem)}) (#familyContinuous{(problemLaws source target problem)})),
        initial := \fun (x: A) => trans!{B} _ _ _
          (congr!{Wedge.Carrier B} (joined source target problem) _ _
            (trans!{Wedge.Carrier} _ _ _ (congr!{Cylinder.Carrier Wedge.Carrier} (#apply{r}) _ _
              (sym!{Cylinder.Carrier} _ _ (Embed.onLeft (Cylinder.at Interval.start) include embeddingCompatible x)))
              (#fixes{(retractLaws source r)} (Wedge.inl x))))
          (Glued.onLeft (#initial{problem}) (#family{problem}) (compatible source target problem) x),
        extends := \fun (t: Interval.Carrier) (x: Subspace.CarrierSet) => trans!{B} _ _ _
          (congr!{Wedge.Carrier B} (joined source target problem) _ _
            (trans!{Wedge.Carrier} _ _ _ (congr!{Cylinder.Carrier Wedge.Carrier} (#apply{r}) _ _
              (sym!{Cylinder.Carrier} _ _ (Embed.onRight (Cylinder.at Interval.start) include embeddingCompatible (SubCylinder.at t x))))
              (#fixes{(retractLaws source r)} (Wedge.inr (SubCylinder.at t x)))))
          (Glued.onRight (#initial{problem}) (#family{problem}) (compatible source target problem) (SubCylinder.at t x)),
      }
    };
\definition homotopyExtension: \forall (source: Space.Topology) (target: Target.Topology) ->
  IsCofibration source -> HomotopyExtensionProperty source target := \block {
  \fun (source: _) (target: _) (cofibration: IsCofibration source) \then
  \takefrom r: Retraction[source] \by cofibration \then
  \return \fun (problem: Problem[source, target]) => \exact(extend source target r problem, Extension[source, target, problem])
};
