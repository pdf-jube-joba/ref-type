\import \root.Contraction[A := Carrier, source := topology] \as Contraction;
\import \root.Cylinder[A := Carrier] \as Cylinder;
\import \root.Homotopy[A := Carrier, B := Carrier] \as Homotopy;
\import \parent.Arithmetic[] \as Times;
\import \root.IntervalFunctions[A := Cylinder.Carrier] \as Functions;
\definition family(p: Cylinder.Carrier): Carrier := Times.advance (Cylinder.time p) (Cylinder.point p);
\definition homotopy: Homotopy.Homotopy[topology, topology, (\fun (x: Carrier) => x), (\fun (_: Carrier) => end)] :=
  \into[Homotopy.Family](family, Homotopy.Homotopy[topology, topology, (\fun (x: Carrier) => x), (\fun (_: Carrier) => end)]) \by {
    Homotopy.Laws[topology, topology, (\fun (x: Carrier) => x), (\fun (_: Carrier) => end), family] {
      continuous := Functions.advanceContinuous (Cylinder.topology topology) Cylinder.time Cylinder.point (Cylinder.timeContinuous topology) (Cylinder.pointContinuous topology),
      start := Times.advanceStart,
      end := Times.advanceEnd,
    }
  };
\definition contraction: Contraction.Data := Contraction.Data { centre := end, homotopy := homotopy };
