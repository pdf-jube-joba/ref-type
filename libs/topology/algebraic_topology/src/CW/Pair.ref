\structure SubcomplexData: \Set {
  cells: Cells,
}
\structure SubcomplexLaws[data: SubcomplexData]: \Prop {
  included: \forall (cell: CellData) -> CellMember data.cells cell -> CellMember (complex.cells) cell,
  boundary: \forall (cell: CellData) -> CellMember data.cells cell -> \forall (p: Euclidean.Disk (cell.dimension)) ->
    \In[Euclidean.coordinateCarrier (cell.dimension)] (Euclidean.boundaryAt (cell.dimension)) p ->
    \exists BoundaryWitness[data.cells, cell, (cell.characteristic p)],
}
\definition Subcomplex: \Set := \Cast[SubcomplexData] ({ data: SubcomplexData \where SubcomplexLaws[data] });
\module Of(subcomplex: Subcomplex) {
  \definition Subset: \Pow A := { x: A \where \exists { cell: CellData \where
    Logic.And[CellMember (subcomplex.cells) cell, \In[A] (ClosedImage cell) x] } };
  \import Space.Subspace[S := Subset] \as Subspace;
  \import algebraic_topology.Collapse[A := A, subset := Subset] \as Collapsed;
  \import topology.Topology[Carrier := Collapsed.Carrier] \as QuotientSpace;
  \definition Carrier: \Set := Subspace.CarrierSet;
  \definition quotientCarrier: \Set := Collapsed.Carrier;
  \definition quotientTopology: QuotientSpace.Topology := Collapsed.topology source;
  \definition quotient: A -> quotientCarrier := Collapsed.class;
}
\definition whole: Subcomplex := Subcomplex {
  cells := complex.cells,
  included := \fun (cell: CellData) (member: CellMember (complex.cells) cell) => member,
  boundary := (laws source complex).boundary,
};
\definition empty: Subcomplex := Subcomplex {
  cells := Lists.List[CellData]::nil,
  included := \fun (cell: CellData) (member: Logic.False) => Logic.falseElim (CellMember (complex.cells) cell) member,
  boundary := \fun (cell: CellData) (member: Logic.False) (p: Euclidean.Disk (cell.dimension)) (onBoundary: _) =>
    Logic.falseElim (\exists BoundaryWitness[Lists.List[CellData]::nil, cell, (cell.characteristic p)]) member,
};
