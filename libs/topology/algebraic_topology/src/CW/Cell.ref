\import topology.Maps[A := Euclidean.Disk (cell.dimension), B := A] \as Images;
\definition Closure: \Pow A := Images.Image (cell.characteristic) ({ p: Euclidean.Disk (cell.dimension) \where p = p });
\definition Interior: \Pow A := { x: A \where \exists { p: Euclidean.Disk (cell.dimension) \where
  Logic.And[\In[Euclidean.coordinateCarrier (cell.dimension)] (Euclidean.interiorAt (cell.dimension)) p, cell.characteristic p = x] } };
