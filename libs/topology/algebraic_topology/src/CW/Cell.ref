\import topology.Maps[A := Euclidean.Disk (#dimension{cell}), B := A] \as Images;
\definition Closure: \Pow A := Images.Image (#characteristic{cell}) ({ p: Euclidean.Disk (#dimension{cell}) \where p = p });
\definition Interior: \Pow A := { x: A \where \exists { p: Euclidean.Disk (#dimension{cell}) \where
  Logic.And[\In[Euclidean.coordinateCarrier (#dimension{cell})] (Euclidean.interiorAt (#dimension{cell})) p, #characteristic{cell} p = x] } };
