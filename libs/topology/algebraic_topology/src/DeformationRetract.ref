\import topology.Topology[Carrier := A] \as Space;
\import Space.Subspace[S := subset] \as Subspace;
\import topology.Continuity[A := A, B := Subspace.CarrierSet] \as Retractions;
\import topology.Continuity[A := Subspace.CarrierSet, B := A].Corestriction[S := subset] \as Inclusions;
\import \root.Homotopy[A := A, B := A] \as Homotopies;
\import \root.Homotopy[A := Subspace.CarrierSet, B := Subspace.CarrierSet] \as SubspaceHomotopies;
\import \root.Cylinder[A := Subspace.CarrierSet] \as Cylinder;
\import \root.Cylinder[A := A] \as WholeCylinder;
\import \root.Interval[] \as Interval;
\import \root.HomotopyEquivalence[A := Subspace.CarrierSet, B := A] \as Equivalences;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\definition inclusion(x: Subspace.CarrierSet): A := x;
\structure Data: \Set {
  retraction: A -> Subspace.CarrierSet,
  continuous: Retractions.Continuous source (Subspace.topology source) retraction,
  retracts: \forall (x: Subspace.CarrierSet) -> retraction x = x,
  homotopy: Homotopies.RelativeHomotopy[source, source, subset, (\fun (x: A) => x), (\fun (x: A) => retraction x)],
}
\module On(retract: Data);
