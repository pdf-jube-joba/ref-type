\import topology.Topology[Carrier := A] \as Space;
\import Space.Subspace[S := subset] \as Subspace;
\import \root.Collapse[A := A, subset := subset] \as Quotient;
\import Quotient.Open[source := source] \as Neighborhoods;
\module Around(neighborhood: Neighborhoods.Neighborhood);
\structure Data: \Set {
  point: Subspace.CarrierSet,
  closed: Space.IsClosedIn source subset,
  neighborhood: Neighborhoods.Neighborhood,
  deformation: Around[neighborhood := neighborhood].Retraction,
}
\module On(pair: Data);
