\import Simplex.Affine[m := n, n := k] \as Next;
\import \root.Cylinder[A := Simplex.Carrier k] \as FinalCylinder;
\import \root.CylinderAffine[m := m, n := k] \as Final;
\import Affine.Composition[k := k] \as Composition;
\import std.Data[].Pair[].Prop[A := Interval.Carrier, B := Simplex.Carrier k] \as Pairs;
\definition transform(w: Next.Vertices)(p: Cylinder.Carrier): FinalCylinder.Carrier := FinalCylinder.at (Cylinder.time p) (Next.apply w (Cylinder.point p));
\definition vertices(w: Next.Vertices)(v: Vertices): Final.Vertices := \fun (i: Fin.Fin (N.Nat^::succ m)) => transform w (v i);
\definition law: \forall (w: Next.Vertices)(v: Vertices)(x: Simplex.Carrier m) -> Final.apply (vertices w v) x = transform w (apply v x) :=
  \fun (w: Next.Vertices)(v: Vertices)(x: Simplex.Carrier m) => Pairs.ext (Final.apply (vertices w v) x) (transform w (apply v x))
    (\refl(time v x)) (sym!{{Simplex.Carrier k}} _ _ (Composition.law (pointVertices v) w x));
\import Simplex.At[n := k] \as FinalSpace;
\import topological_constructions.Product[A := Interval.Carrier, B := Simplex.Carrier k].Universal[X := Cylinder.Carrier] \as Pair;
\import topology.Composition[A := Cylinder.Carrier, B := Simplex.Carrier n, C := Simplex.Carrier k] \as Compose;
\definition continuous: \forall (w: Next.Vertices) -> topology.Continuity[A := Cylinder.Carrier, B := FinalCylinder.Carrier]
  .Continuous (Cylinder.topology Target.topology) (FinalCylinder.topology FinalSpace.topology) (transform w) :=
  \fun (w: Next.Vertices) => Pair.pairContinuous (Cylinder.topology Target.topology) Interval.topology FinalSpace.topology Cylinder.time
    (\fun (p: Cylinder.Carrier) => Next.apply w (Cylinder.point p)) (Cylinder.timeContinuous Target.topology)
    (Compose.composeContinuous (Cylinder.topology Target.topology) Target.topology FinalSpace.topology Cylinder.point (Next.apply w)
      (Cylinder.pointContinuous Target.topology) (Next.continuous w));
