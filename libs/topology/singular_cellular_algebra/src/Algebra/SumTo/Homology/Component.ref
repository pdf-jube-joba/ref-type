\import Complexes.At[C := terms i, z := z] \as Source;
\import Complexes.Map[C := terms i, D := target] \as Direct;
\import Complexes.Map[C := Sum.complex, D := target].Composition[B := terms i] \as Composition;
\definition equation: Composition.compose map Sum.Injection[i := i].map = maps i :=
  Direct.ext _ _ (\fun (degree: I.Int^) => \parent.\parent.At[z := degree].onInjection i);
\definition onInjection: \forall (q: Source.Homology) ->
  #apply{(Action.induced map)} (#apply{SumHomology.forward} (#apply{Modules.DirectSum[Index := Index, family := Sum.At[z := z].homologyFamily].Injection[i := i].map} q)) =
  #apply{(Direct.At[k := z].induced (maps i))} q :=
  \fun (q: Source.Homology) => trans!{Target.Homology} _ _ _
    (congr!{{Complexes.At[C := Sum.complex, z := z].Homology} Target.Homology} (#apply{(Action.induced map)}) _ _
      (Universal.onInjection SumHomology.components i q))
    (trans!{Target.Homology} _ _ _
      (sym!{Target.Homology} _ _ (Composition.At[k := z].compositionOnHomology map Sum.Injection[i := i].map q))
      (congr!{Direct.Map Target.Homology} (\fun (f: Direct.Map) => #apply{(Direct.At[k := z].induced f)} q) _ _ equation));
