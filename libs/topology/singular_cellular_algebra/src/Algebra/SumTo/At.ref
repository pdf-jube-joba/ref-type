\import Modules.DirectSum[Index := Index, family := Sum.Term[z := z].family].To[W := target.family.Carrier z, target := target.family.space z] \as Universal;
\module Component(i: Index);
\definition components: Universal.Components := \fun (i: Index) => Component[i := i].map;
\definition map: Modules.Hom[V := Sum.Term[z := z].Carrier, W := target.family.Carrier z, source := Sum.Term[z := z].space, target := target.family.space z].Map :=
  Universal.extension components;
\definition onInjection: \forall (i: Index)(x: (terms i).family.Carrier z) ->
  #apply{map} (#apply{Sum.Term[z := z].Component[i := i].injection} x) = #apply{(maps i)} z x := Universal.onInjection components;
\module Boundary;
\definition commutes: \forall (x: Sum.Term[z := z].Carrier) ->
  #apply{target.differential} z (#apply{map} x) = #apply{\parent.At[z := Degrees.previous z].map} (#apply{Sum.complex.differential} z x) :=
  Boundary[].commutes;
