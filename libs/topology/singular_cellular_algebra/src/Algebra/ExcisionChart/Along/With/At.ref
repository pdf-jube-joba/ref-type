\definition upperLeft: Modules.Bundle := Modules.Bundle { Carrier := TargetSmall.With[coefficients := coefficients].At[z := z].Carrier, space := TargetSmall.With[coefficients := coefficients].At[z := z].space };
\definition upperRight: Modules.Bundle := Modules.Bundle { Carrier := SourceSmall.With[coefficients := coefficients].At[z := z].Carrier, space := SourceSmall.With[coefficients := coefficients].At[z := z].space };
\definition lowerLeft: Modules.Bundle := Modules.Bundle { Carrier := Target.With[coefficients := coefficients].At[z := z].Carrier, space := Target.With[coefficients := coefficients].At[z := z].space };
\definition lowerRight: Modules.Bundle := Modules.Bundle { Carrier := Source.With[coefficients := coefficients].At[z := z].Carrier, space := Source.With[coefficients := coefficients].At[z := z].space };
\import Modules.IsomorphismSquare[A := upperLeft, B := upperRight, C := lowerLeft, D := lowerRight] \as Transport;
\definition isomorphism(agrees: Agrees): Modules.Isomorphism[V := lowerLeft.Carrier, W := lowerRight.Carrier, source := lowerLeft.space, target := lowerRight.space].Isomorphism :=
  Transport.incoming (TargetExcision.With[coefficients := coefficients].At[z := z].isomorphism targetPair)
    (SourceExcision.With[coefficients := coefficients].At[z := z].isomorphism sourcePair)
    (Charts.With[coefficients := coefficients].At[z := z].isomorphism chart) Action.With[coefficients := coefficients].At[z := z].induced
    (\fun (q: lowerLeft.Carrier) => sym!{upperRight.Carrier} _ _ (Square.With[coefficients := coefficients].At[z := z].law agrees q));
