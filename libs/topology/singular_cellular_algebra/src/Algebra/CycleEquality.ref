\import Complexes.At[C := C, z := z] \as H;
\definition law(x, y: H.Cycle)(same: (\exact(x, C.family.Carrier z)) = (\exact(y, C.family.Carrier z))): x = y :=
  H.cycleExt x y same;
\definition onClass(x, y: H.Cycle)(same: (\exact(x, C.family.Carrier z)) = (\exact(y, C.family.Carrier z))): H.classOf x = H.classOf y :=
  H.cycleClassExt x y same;
\definition forget(x, y: H.Cycle)(same: x = y): (\exact(x, C.family.Carrier z)) = (\exact(y, C.family.Carrier z)) :=
  congr!{H.Cycle {C.family.Carrier z}} H.forget x y same;
