\import std.Logic[].Proposition[] \as Logic;
\import Complexes.At[C := P, z := z] \as H;
\import Modules.Of[V := P.family.Carrier z, space := P.family.space z].Submodule[] \as Submodules;
\import Modules.Hom[V := H.Cycle, W := target.Carrier, source := H.cycleSpace, target := target.space] \as Maps;
\structure Data: \Set := {
  map: Maps.Map,
  vanishes: \forall (x: H.Cycle) -> Submodules.Member H.boundaries x -> (map).apply x = (target.space).zero,
  onto: \forall (y: target.Carrier) -> \exists ( x: H.Cycle \where (map).apply x = y ),
  kernel: \forall (x: H.Cycle) -> (map).apply x = (target.space).zero -> Submodules.Member H.boundaries x,
};
\module On(data: Data);
