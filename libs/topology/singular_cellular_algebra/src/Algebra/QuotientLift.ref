\import std.Logic[].Relation[] \as Relations;
\import topological_constructions.Quotient[A := A, B := B] \as Quotients;
\import topology.Continuity[A := A, B := C] \as Maps;
\definition Related(x, y: A): \Prop := q x = q y;
\import topological_constructions.RelationQuotient[A := A, relation := Related] \as Classes;
\definition equivalence: Classes.Laws := Relations.Equivalence[A, Related] {
  refl := \fun (x: A) => \refl(q x),
  sym := \fun (x, y: A)(same: _) => sym!{B} _ _ same,
  trans := \fun (x, y, z: A)(xy: _)(yz: _) => trans!{B} _ _ _ xy yz,
};
\structure Data: \Set {
  quotient: Quotients.IsQuotientMap[source, target, q],
  apply: A -> C,
  compatible: \forall (x, y: A) -> q x = q y -> apply x = apply y,
  continuous: Maps.Continuous source final apply,
}
\module On(data: Data);
