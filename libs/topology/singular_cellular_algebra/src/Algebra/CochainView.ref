\import chain_complexes.Chain[] \as Degrees;
\definition Carrier(z: I.Int^): \Set := C.family.Carrier z;
\definition space(z: I.Int^): Modules.Space (Carrier z) := C.family.space z;
\definition apply(z: I.Int^): Carrier z -> Carrier (Degrees.next z) := #apply{C.differential} z;
\definition addition(z: I.Int^)(x, y: Carrier z): apply z (#add{(space z)} x y) = #add{(space (Degrees.next z))} (apply z x) (apply z y) := #addition{C.laws} z x y;
\definition scalar(z: I.Int^)(a: I.Int^)(x: Carrier z): apply z (#smul{(space z)} a x) = #smul{(space (Degrees.next z))} a (apply z x) := #scalar{C.laws} z a x;
\definition squareZero(z: I.Int^)(x: Carrier z): apply (Degrees.next z) (apply z x) = #zero{(space (Degrees.next (Degrees.next z)))} := #squareZero{C.laws} z x;
