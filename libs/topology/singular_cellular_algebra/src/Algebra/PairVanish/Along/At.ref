\definition onWhole[contained: Contained][x: SourceWholeExtension.Carrier z]:
  Target.class z ((WholeMaps.integerPush f ((Maps.laws f).continuous)).apply z x) = (Target.space z).zero := \block {
  \takefrom y: \Cast[TargetSubExtension.Carrier z]
    ({ y: TargetSubExtension.Carrier z \where (Target.inclusionMap).apply z y = (WholeMaps.integerPush f ((Maps.laws f).continuous)).apply z x })
    \by Support.all z f ((Maps.laws f).continuous) contained x \then
  \return trans!{{Target.Carrier z}} _ _ _
    (congr!{{TargetWholeExtension.Carrier z} {Target.Carrier z}} (Target.class z) _ _
      (sym!{{TargetWholeExtension.Carrier z}} _ _ (\bysub(TargetSubExtension.Carrier z,
        { y: TargetSubExtension.Carrier z \where (Target.inclusionMap).apply z y = (WholeMaps.integerPush f ((Maps.laws f).continuous)).apply z x }, y))))
    (TargetQuotient.At[k := z].onImage y)
};
\definition zero[contained: Contained]: \forall (q: Source.Carrier z) -> (Action.map).apply z q = (Target.space z).zero :=
  SourceQuotient.At[k := z].induction (\fun (q: Source.Carrier z) => (Action.map).apply z q = (Target.space z).zero)
    (\fun (x: SourceWholeExtension.Carrier z) => trans!{{Target.Carrier z}} _ _ _ (Action.At[z := z].quotientOnClass x) (onWhole contained x));
\import Complexes.At[C := Source.complex, z := z] \as SourceH;
\import Complexes.At[C := Target.complex, z := z] \as TargetH;
\import Complexes.Map[C := Source.complex, D := Target.complex].At[k := z] \as Induced;
\import Modules.Hom[V := TargetH.Cycle, W := TargetH.Homology, source := TargetH.cycleSpace, target := TargetH.homologySpace] \as Classes;
\import Modules.Of[V := Target.Carrier z, space := Target.space z].Submodule[] \as Submodules;
\definition boundaryZero[contained: Contained][x: SourceH.Cycle]:
  Submodules.Member TargetH.boundaries ((Action.map).apply z x) :=
  \idelim (Target.space z).zero = (Action.map).apply z x \with y: Target.Carrier z =>
    Submodules.Member TargetH.boundaries y \by {
      base: (TargetH.boundaries).zero,
      equality: sym!{{Target.Carrier z}} _ _ (zero contained x)
    };
\definition homology[contained: Contained]: \forall (q: SourceH.Homology) -> (Action.At[z := z].induced).apply q = (TargetH.homologySpace).zero :=
  SourceH.classInduction (\fun (q: SourceH.Homology) => (Action.At[z := z].induced).apply q = (TargetH.homologySpace).zero)
    (\fun (x: SourceH.Cycle) => trans!{TargetH.Homology} _ _ _ (Induced.onClass Action.map x)
      (TargetH.boundaryClassZero ((Induced.cyclesMap Action.map).apply x) (boundaryZero contained x)));
