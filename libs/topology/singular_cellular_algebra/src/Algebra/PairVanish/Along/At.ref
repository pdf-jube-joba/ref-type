\definition onWhole(contained: Contained)(x: SourceWholeExtension.Carrier z):
  Target.class z (#apply{WholeMaps.integerPush f (#continuous{(Maps.laws f)})} z x) = #zero{(Target.space z)} := \block {
  \takefrom y: \Cast[TargetSubExtension.Carrier z]
    ({ y: TargetSubExtension.Carrier z \where #apply{Target.inclusionMap} z y = #apply{WholeMaps.integerPush f (#continuous{(Maps.laws f)})} z x })
    \by Support.all z f (#continuous{(Maps.laws f)}) contained x \then
  \return trans!{{Target.Carrier z}} _ _ _
    (congr!{{TargetWholeExtension.Carrier z} {Target.Carrier z}} (Target.class z) _ _
      (sym!{{TargetWholeExtension.Carrier z}} _ _ (\bysub(TargetSubExtension.Carrier z,
        { y: TargetSubExtension.Carrier z \where #apply{Target.inclusionMap} z y = #apply{WholeMaps.integerPush f (#continuous{(Maps.laws f)})} z x }, y))))
    (TargetQuotient.At[k := z].onImage y)
};
\definition zero(contained: Contained): \forall (q: Source.Carrier z) -> #apply{Action.map} z q = #zero{(Target.space z)} :=
  SourceQuotient.At[k := z].induction (\fun (q: Source.Carrier z) => #apply{Action.map} z q = #zero{(Target.space z)})
    (\fun (x: SourceWholeExtension.Carrier z) => trans!{{Target.Carrier z}} _ _ _ (Action.At[z := z].quotientOnClass x) (onWhole contained x));
\import Complexes.At[C := Source.complex, z := z] \as SourceH;
\import Complexes.At[C := Target.complex, z := z] \as TargetH;
\import Complexes.Map[C := Source.complex, D := Target.complex].At[k := z] \as Induced;
\import Modules.Hom[V := TargetH.Cycle, W := TargetH.Homology, source := TargetH.cycleSpace, target := TargetH.homologySpace] \as Classes;
\import Modules.Of[V := Target.Carrier z, space := Target.space z].Submodule[] \as Submodules;
\definition boundaryZero(contained: Contained)(x: SourceH.Cycle):
  Submodules.Member TargetH.boundaries (#apply{Action.map} z x) :=
  \idelim #zero{(Target.space z)} = #apply{Action.map} z x \with y: Target.Carrier z =>
    Submodules.Member TargetH.boundaries y \by {
      base: #zero{TargetH.boundaries},
      equality: sym!{{Target.Carrier z}} _ _ (zero contained x)
    };
\definition homology(contained: Contained): \forall (q: SourceH.Homology) -> #apply{Action.At[z := z].induced} q = #zero{TargetH.homologySpace} :=
  SourceH.classInduction (\fun (q: SourceH.Homology) => #apply{Action.At[z := z].induced} q = #zero{TargetH.homologySpace})
    (\fun (x: SourceH.Cycle) => trans!{TargetH.Homology} _ _ _ (Induced.onClass Action.map x)
      (TargetH.boundaryClassZero (#apply{(Induced.cyclesMap Action.map)} x) (boundaryZero contained x)));
