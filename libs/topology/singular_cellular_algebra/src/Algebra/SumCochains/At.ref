\import Cochains.At[C := Source.complex, z := z] \as SourceH;
\import Cochains.At[C := Target.complex, z := z] \as MiddleH;
\import Cochains.Isomorphism[C := Source.complex, D := Target.complex].On[e := isomorphism].At[z := z] \as Left;
\definition componentFamily: Modules.Family[Index] := Target.At[z := z].homologyFamily;
\import Modules.Product[Index := Index, family := componentFamily] \as Result;
\import Modules.Isomorphism[V := SourceH.Cohomology, W := MiddleH.Cohomology,
  source := SourceH.cohomologySpace, target := MiddleH.cohomologySpace]
  .Composition[U := Result.Carrier, final := Result.space] \as Compose;
\definition isomorphism: Modules.Isomorphism[V := SourceH.Cohomology, W := Result.Carrier,
  source := SourceH.cohomologySpace, target := Result.space].Isomorphism :=
  Compose.compose Target.At[z := z].isomorphism Left.isomorphism;
