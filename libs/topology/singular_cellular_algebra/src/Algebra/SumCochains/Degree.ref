\import Modules.DirectSum[Index := Index, family := Sum.Term[z := z].family].To[W := coefficients.Carrier, target := coefficients.space] \as Universal;

\module Component(i: Index);
\import Modules.Hom[V := Source.Carrier z, W := Target.Term[z := z].Carrier,
  source := Source.space z, target := Target.Term[z := z].space] \as Maps;
\definition forward: Maps.Map := Maps.Map {
  apply := \fun (f: Source.Carrier z)(i: Index) => #apply{Component[i := i].map} f,
  addition := \fun (f, g: Source.Carrier z) =>
    \axiom:funext((\fun (i: Index) => #apply{Component[i := i].map} (#add{(Source.space z)} f g)),
      #add{Target.Term[z := z].space} (\fun (i: Index) => #apply{Component[i := i].map} f) (\fun (i: Index) => #apply{Component[i := i].map} g),
      \fun (i: Index) => #addition{Component[i := i].map} f g),
  scalar := \fun (a: I.Int^)(f: Source.Carrier z) =>
    \axiom:funext((\fun (i: Index) => #apply{Component[i := i].map} (#smul{(Source.space z)} a f)),
      #smul{Target.Term[z := z].space} a (\fun (i: Index) => #apply{Component[i := i].map} f),
      \fun (i: Index) => #scalar{Component[i := i].map} a f),
};
\definition injective: \forall (f, g: Source.Carrier z) -> #apply{forward} f = #apply{forward} g -> f = g :=
  \fun (f, g: Source.Carrier z)(same: _) => Universal.ext f g (\fun (i: Index)(x: (terms i).family.Carrier z) =>
    congr!{Hom.Integer[P := terms i, N := coefficients].Carrier z coefficients.Carrier}
      (\fun (h: Hom.Integer[P := terms i, N := coefficients].Carrier z) => #apply{h} x) _ _
      (congr!{Target.Term[z := z].Carrier {Hom.Integer[P := terms i, N := coefficients].Carrier z}}
        (\fun (h: Target.Term[z := z].Carrier) => h i) _ _ same));
\definition onto: \forall (f: Target.Term[z := z].Carrier) -> \exists { g: Source.Carrier z \where #apply{forward} g = f } :=
  \fun (f: Target.Term[z := z].Carrier) => Logic.existsIntro[Source.Carrier z, { g: Source.Carrier z \where #apply{forward} g = f }]
    (Universal.extension f)
    (\axiom:funext(#apply{forward} (Universal.extension f), f, \fun (i: Index) =>
      Hom.Integer[P := terms i, N := coefficients].At[z := z].ext _ _ (Universal.onInjection f i)));
\import Modules.Isomorphism[V := Source.Carrier z, W := Target.Term[z := z].Carrier,
  source := Source.space z, target := Target.Term[z := z].space].OfBijective[f := forward] \as Inverse;
\definition isomorphism: Modules.Isomorphism[V := Source.Carrier z, W := Target.Term[z := z].Carrier,
  source := Source.space z, target := Target.Term[z := z].space].Isomorphism := Inverse.isomorphism injective onto;
