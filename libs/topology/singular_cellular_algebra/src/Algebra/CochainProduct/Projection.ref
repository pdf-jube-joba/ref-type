\definition map: Cochains.Map[C := complex, D := terms i].Map := Cochains.Map[C := complex, D := terms i].Map {
  apply := \fun (z: I.Int^)(x: \parent.Term[z := z].Carrier) => x i,
  addition := \fun (z: I.Int^)(x, y: \parent.Term[z := z].Carrier) => \refl(#add{pointSpace i z} (x i) (y i)),
  scalar := \fun (z: I.Int^)(a: I.Int^)(x: \parent.Term[z := z].Carrier) => \refl(#smul{pointSpace i z} a (x i)),
  commutes := \fun (z: I.Int^)(x: \parent.Term[z := z].Carrier) => \refl(pointApply i z (x i)),
};
