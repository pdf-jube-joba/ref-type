\import Cochains.Prior[C := complex] \as Prior;

\module Component(i: Index);
\definition onClass: \forall (x: Source.Closed) -> (forward).apply (Source.classOf x) = (Product.space).zero -> Source.classOf x = Source.zeroClass := \block {
  \fun (x: Source.Closed)(killed: _) \then
  \let Fibers: Index -> \Set := \fun (i: Index) => Component[i := i].Fiber x \then
  \takefrom selected: \forall (i: Index) -> Fibers i \by
    \axiom:classicalIndefiniteChoice(Index, Fibers, (\fun (i: Index) => Component[i := i].inhabited x killed)) \then
  \let g: \parent.\parent.Term[z := Degrees.previous z].Carrier := \fun (i: Index) => selected i \then
  \let bounds: (Source.prior).apply g = x := \axiom:funext((Source.prior).apply g, x, \fun (i: Index) =>
    trans!{{pointCarrier i z}} _ _ _ (Component[i := i].coordinate g)
      (\bysub(pointCarrier i (Degrees.previous z),
        { y: pointCarrier i (Degrees.previous z) \where
          (Cochains.At[C := terms i, z := z].prior).apply y = x i }, selected i))) \then
  \return Source.boundaryClassZero x
    (Logic.existsIntro[\parent.\parent.Term[z := Degrees.previous z].Carrier, { y: \parent.\parent.Term[z := Degrees.previous z].Carrier \where (Source.prior).apply y = x }] g bounds)
};
\definition zero: \forall (q: Source.Cohomology) -> (forward).apply q = (Product.space).zero -> q = Source.zeroClass :=
  Source.classInduction (\fun (q: Source.Cohomology) => (forward).apply q = (Product.space).zero -> q = Source.zeroClass) onClass;
