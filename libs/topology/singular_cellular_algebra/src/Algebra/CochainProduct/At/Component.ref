\import Cochains.At[C := terms i, z := z] \as Native;
\definition Carrier: \Set := Native.Cohomology;
\definition space: Modules.Space Carrier := Native.cohomologySpace;
\definition Closed: \Set := Native.Closed;
\definition classOf: Closed -> Carrier := Native.classOf;
\definition representative: \forall (q: Carrier) -> \exists ( x: Closed \where classOf x = q ) :=
  Native.classInduction (\fun (q: Carrier) => \exists ( x: Closed \where classOf x = q ))
    (\fun (x: Closed) => Logic.existsIntro[Closed, { y: Closed \where classOf y = classOf x }] x (\refl(classOf x)));
\import Cochains.Map[C := complex, D := terms i].At[k := z] \as Action;
\definition map: Modules.Hom[V := Source.Cohomology, W := Carrier, source := Source.cohomologySpace, target := space].Map :=
  Action.induced \parent.\parent.Projection[i := i].map;
\definition onClass: \forall (x: Source.Closed) -> (map).apply (Source.classOf x) = classOf ((Action.cyclesMap \parent.\parent.Projection[i := i].map).apply x) :=
  Action.onClass \parent.\parent.Projection[i := i].map;
