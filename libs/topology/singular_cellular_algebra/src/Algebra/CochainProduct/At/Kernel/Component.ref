\import Cochains.At[C := terms i, z := z] \as H;
\import Cochains.Map[C := complex, D := terms i].At[k := z] \as Action;
\definition Fiber(x: Source.Closed): \Set := \Cast[(terms i).family.Carrier (Degrees.previous z)]
  ({ y: (terms i).family.Carrier (Degrees.previous z) \where #apply{H.prior} y = x i });
\definition inhabited: \forall (x: Source.Closed) -> #apply{forward} (Source.classOf x) = #zero{Product.space} -> \exists Fiber x :=
  \fun (x: Source.Closed)(killed: _) => H.zeroClassBoundary (#apply{(Action.cyclesMap \parent.\parent.\parent.Projection[i := i].map)} x)
    (trans!{H.Cohomology} _ _ _ (sym!{H.Cohomology} _ _ (Action.onClass \parent.\parent.\parent.Projection[i := i].map x))
      (congr!{Product.Carrier H.Cohomology} (\fun (v: Product.Carrier) => v i) _ _ killed));
\definition coordinate: \forall (g: \parent.\parent.\parent.Term[z := Degrees.previous z].Carrier) -> (Prior.value z g) i = #apply{H.prior} (g i) :=
  \fun (g: \parent.\parent.\parent.Term[z := Degrees.previous z].Carrier) => sym!{(terms i).family.Carrier z} _ _
    (Cochains.Map[C := complex, D := terms i].priorCommutes z \parent.\parent.\parent.Projection[i := i].map g);
