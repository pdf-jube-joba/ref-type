\definition Fiber(q: Product.Carrier)(i: Index): \Set :=
  \Cast[\parent.Component[i := i].Closed] ({ x: \parent.Component[i := i].Closed \where \parent.Component[i := i].classOf x = q i });

\module Component(i: Index);
\definition onto: \forall (q: Product.Carrier) -> \exists { p: Source.Cohomology \where #apply{forward} p = q } := \block {
  \fun (q: Product.Carrier) \then
  \takefrom selected: \forall (i: Index) -> Fiber q i \by
    \axiom:classicalIndefiniteChoice(Index, Fiber q, (\fun (i: Index) => \parent.Component[i := i].representative (q i))) \then
  \let value: \parent.\parent.Term[z := z].Carrier := \fun (i: Index) => selected i \then
  \let x: Source.Closed := Source.cycle value
    (\axiom:funext(apply z value, #zero{\parent.\parent.Term[z := Degrees.next z].space}, \fun (i: Index) => Component[i := i].closed (selected i))) \then
  \return Logic.existsIntro[Source.Cohomology, { p: Source.Cohomology \where #apply{forward} p = q }] (Source.classOf x)
    (\axiom:funext(#apply{forward} (Source.classOf x), q, \fun (i: Index) => trans!{{\parent.Component[i := i].Carrier}} _ _ _
      (\parent.Component[i := i].onClass x)
      (\bysub(\parent.Component[i := i].Closed,
        { y: \parent.Component[i := i].Closed \where \parent.Component[i := i].classOf y = q i }, selected i))))
};
