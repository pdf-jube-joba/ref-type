\definition degree: I.Int^ := I.Int^::negSucc n;
\import Modules.Hom[V := Whole.Carrier degree, W := Sub.Carrier degree, source := Whole.space degree, target := Sub.space degree] \as Maps;
\definition retraction: Maps.Map := Maps.zeroMap;
\definition retracts: \forall (x: Sub.Carrier degree) -> #apply{retraction} (#apply{Pair.inclusionMap} degree x) = x :=
  \fun (x: Sub.Carrier degree) => sym!{Sub.Carrier degree} _ _ (Sub.Negative[n := n].zero x);
\definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Whole.Carrier degree, space := Whole.space degree };
\definition projective: Modules.Projective bundle := Modules.ProjectiveLaws[].Trivial[P := bundle].projective (Whole.Negative[n := n].zero);
\import Complexes.Quotient[C := Sub.complex, D := Whole.complex].On[f := Pair.inclusionMap] \as Quotient;
\import Modules.Hom[V := Whole.Carrier degree, W := Pair.Carrier degree, source := Whole.space degree, target := Pair.space degree] \as Projection;
\definition zero: \forall (q: Pair.Carrier degree) -> q = #zero{(Pair.space degree)} :=
  Quotient.At[k := degree].induction (\fun (q: Pair.Carrier degree) => q = #zero{(Pair.space degree)})
    (\fun (x: Whole.Carrier degree) => trans!{Pair.Carrier degree} _ _ _
      (congr!{Whole.Carrier degree {Pair.Carrier degree}} (Pair.class degree) _ _ (Whole.Negative[n := n].zero x))
      (Projection.zeroPreserved Quotient.At[k := degree].projection));
