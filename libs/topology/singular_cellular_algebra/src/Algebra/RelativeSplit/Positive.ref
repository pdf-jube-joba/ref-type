\import Pair.Split[n := n] \as Split;
\import Sub.Positive[n := n] \as IntoSub;
\import Whole.Positive[n := n] \as IntoWhole;
\import Modules.Hom[V := Whole.Carrier (I.Int^::ofNat n), W := Sub.Carrier (I.Int^::ofNat n),
  source := Whole.space (I.Int^::ofNat n), target := Sub.space (I.Int^::ofNat n)] \as Maps;
\definition retraction: Maps.Map := Maps.Map {
  apply := \fun (x: Whole.Carrier (I.Int^::ofNat n)) => IntoSub.intro (#apply{Split.retraction} x),
  addition := \fun (x, y: Whole.Carrier (I.Int^::ofNat n)) => #addition{Split.retraction} x y,
  scalar := \fun (a: I.Int^)(x: Whole.Carrier (I.Int^::ofNat n)) => #scalar{Split.retraction} a x,
};
\definition retracts: \forall (x: Sub.Carrier (I.Int^::ofNat n)) -> #apply{retraction} (#apply{Pair.inclusionMap} (I.Int^::ofNat n) x) = x :=
  \fun (x: Sub.Carrier (I.Int^::ofNat n)) => Split.leftInverse x;
\import singular_cohomology.Simplices[A := A, source := source] \as Simplices;
\import Modules.Free[Generators := Simplices.Carrier n] \as Free;
\definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Whole.Carrier (I.Int^::ofNat n), space := Whole.space (I.Int^::ofNat n) };
\import Modules.ProjectiveLaws[].Retract[P := bundle, Q := Free.bundle, inclusion := IntoWhole.backward, retraction := IntoWhole.forward] \as Retract;
\definition projective: Modules.Projective bundle := Retract.projective (\fun (x: Whole.Carrier (I.Int^::ofNat n)) => \refl(x)) Free.projective;
