\definition left: Modules.Bundle := Modules.Bundle { Carrier := Sub.Carrier z, space := Sub.space z };
\definition middle: Modules.Bundle := Modules.Bundle { Carrier := Whole.Carrier z, space := Whole.space z };
\definition right: Modules.Bundle := Modules.Bundle { Carrier := Pair.Carrier z, space := Pair.space z };
\import Complexes.Map[C := Sub.complex, D := Whole.complex].At[k := z] \as Inclusion;
\import Complexes.Quotient[C := Sub.complex, D := Whole.complex].On[f := Pair.inclusionMap] \as Quotient;
\import Modules.ShortExact[A := left, B := middle, C := right] \as Exact;
\definition sequence: Exact.Sequence := Exact.Sequence {
  inclusion := Inclusion.linear Pair.inclusionMap, projection := Quotient.At[k := z].projection,
  injective := Pair.injective z, onto := Quotient.At[k := z].onto,
  zero := Quotient.At[k := z].onImage, kernelImage := Quotient.At[k := z].zeroClassImage,
};
\import Exact.Splitting[sequence := sequence].FromRetraction[r := retraction z] \as Split;
\definition section: Modules.MapBetween right middle := Split.section (retracts z);
\definition sectionLaw: \forall (q: Pair.Carrier z) -> (Quotient.At[k := z].projection).apply ((section).apply q) = q := Split.rightInverse (retracts z);
\import Modules.ProjectiveLaws[].Retract[P := right, Q := middle, inclusion := section, retraction := Quotient.At[k := z].projection] \as Projective;
\definition projective: Modules.Projective right := Projective.projective sectionLaw (wholeProjective z);
