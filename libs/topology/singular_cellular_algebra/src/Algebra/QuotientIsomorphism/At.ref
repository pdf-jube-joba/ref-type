\import Source.At[k := z] \as SourceAt;
\import Target.At[k := z] \as TargetAt;
\import Forward.At[k := z] \as ForwardAt;
\import Backward.At[k := z] \as BackwardAt;
\definition forward: Modules.Hom[V := SourceAt.Carrier, W := TargetAt.Carrier, source := SourceAt.space, target := TargetAt.space].Map := ForwardAt.map commutes;
\definition backward: Modules.Hom[V := TargetAt.Carrier, W := SourceAt.Carrier, source := TargetAt.space, target := SourceAt.space].Map := BackwardAt.map (reverseCompatible commutes);
\definition leftInverse: \forall (q: SourceAt.Carrier) -> #apply{backward} (#apply{forward} q) = q :=
  SourceAt.induction (\fun (q: SourceAt.Carrier) => #apply{backward} (#apply{forward} q) = q)
    (\fun (x: D.family.Carrier z) => trans!{SourceAt.Carrier} _ _ _
      (congr!{TargetAt.Carrier SourceAt.Carrier} (#apply{backward}) _ _ (ForwardAt.onClass commutes x))
      (trans!{SourceAt.Carrier} _ _ _ (BackwardAt.onClass (reverseCompatible commutes) (#apply{(#forward{right})} z x))
        (congr!{{D.family.Carrier z} SourceAt.Carrier} SourceAt.class _ _ (#leftInverse{right} z x))));
\definition rightInverse: \forall (q: TargetAt.Carrier) -> #apply{forward} (#apply{backward} q) = q :=
  TargetAt.induction (\fun (q: TargetAt.Carrier) => #apply{forward} (#apply{backward} q) = q)
    (\fun (x: D1.family.Carrier z) => trans!{TargetAt.Carrier} _ _ _
      (congr!{SourceAt.Carrier TargetAt.Carrier} (#apply{forward}) _ _ (BackwardAt.onClass (reverseCompatible commutes) x))
      (trans!{TargetAt.Carrier} _ _ _ (ForwardAt.onClass commutes (#apply{(#backward{right})} z x))
        (congr!{{D1.family.Carrier z} TargetAt.Carrier} TargetAt.class _ _ (#rightInverse{right} z x))));
