\definition sourceNeighborhood: Modules.Isomorphism[V := Source.Homology[z := z].Carrier, W := SourceExpanded.Homology[z := z].Carrier,
  source := Source.Homology[z := z].space, target := SourceExpanded.Homology[z := z].space].Isomorphism := SourceNeighborhood.Homology[z := z].isomorphism;
\definition targetNeighborhood: Modules.Isomorphism[V := Target.Homology[z := z].Carrier, W := TargetExpanded.Homology[z := z].Carrier,
  source := Target.Homology[z := z].space, target := TargetExpanded.Homology[z := z].space].Isomorphism := TargetNeighborhood.Homology[z := z].isomorphism;
\definition sourceExcisionIsomorphism: Modules.Isomorphism[V := SourceSmall.Homology[z := z].Carrier, W := SourceExpanded.Homology[z := z].Carrier,
  source := SourceSmall.Homology[z := z].space, target := SourceExpanded.Homology[z := z].space].Isomorphism := SourceExcision.Homology[z := z].isomorphism sourceExcision;
\definition targetExcisionIsomorphism: Modules.Isomorphism[V := TargetSmall.Homology[z := z].Carrier, W := TargetExpanded.Homology[z := z].Carrier,
  source := TargetSmall.Homology[z := z].space, target := TargetExpanded.Homology[z := z].space].Isomorphism := TargetExcision.Homology[z := z].isomorphism targetExcision;
\import Modules.Isomorphism[V := SourceSmall.Homology[z := z].Carrier, W := SourceExpanded.Homology[z := z].Carrier,
  source := SourceSmall.Homology[z := z].space, target := SourceExpanded.Homology[z := z].space].Inverse[] \as SourceInverse;
\import Modules.Isomorphism[V := TargetSmall.Homology[z := z].Carrier, W := TargetExpanded.Homology[z := z].Carrier,
  source := TargetSmall.Homology[z := z].space, target := TargetExpanded.Homology[z := z].space].Inverse[] \as TargetInverse;
\definition source: Modules.Isomorphism[V := Source.Homology[z := z].Carrier, W := SourceSmall.Homology[z := z].Carrier,
  source := Source.Homology[z := z].space, target := SourceSmall.Homology[z := z].space].Isomorphism :=
  Modules.Isomorphism[V := Source.Homology[z := z].Carrier, W := SourceExpanded.Homology[z := z].Carrier,
    source := Source.Homology[z := z].space, target := SourceExpanded.Homology[z := z].space]
    .Composition[U := SourceSmall.Homology[z := z].Carrier, final := SourceSmall.Homology[z := z].space]
    .compose (SourceInverse.inverse sourceExcisionIsomorphism) sourceNeighborhood;
\definition target: Modules.Isomorphism[V := Target.Homology[z := z].Carrier, W := TargetSmall.Homology[z := z].Carrier,
  source := Target.Homology[z := z].space, target := TargetSmall.Homology[z := z].space].Isomorphism :=
  Modules.Isomorphism[V := Target.Homology[z := z].Carrier, W := TargetExpanded.Homology[z := z].Carrier,
    source := Target.Homology[z := z].space, target := TargetExpanded.Homology[z := z].space]
    .Composition[U := TargetSmall.Homology[z := z].Carrier, final := TargetSmall.Homology[z := z].space]
    .compose (TargetInverse.inverse targetExcisionIsomorphism) targetNeighborhood;
