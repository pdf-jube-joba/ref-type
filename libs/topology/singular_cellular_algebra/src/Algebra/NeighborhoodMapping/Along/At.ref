\import \parent.\parent.Homology[z := z] \as Comparison;
\import Modules.Isomorphism[V := TargetSmall.Homology[z := z].Carrier, W := TargetExpanded.Homology[z := z].Carrier,
  source := TargetSmall.Homology[z := z].space, target := TargetExpanded.Homology[z := z].space] \as Invert;
\definition cancel(x, y: TargetSmall.Homology[z := z].Carrier)
  (same: #apply{#forward{Comparison.targetExcisionIsomorphism}} x = #apply{#forward{Comparison.targetExcisionIsomorphism}} y): x = y :=
  trans!{{TargetSmall.Homology[z := z].Carrier}} _ _ _ (sym!{{TargetSmall.Homology[z := z].Carrier}} _ _ (#leftInverse{Comparison.targetExcisionIsomorphism} x))
    (trans!{{TargetSmall.Homology[z := z].Carrier}} _ _ _
      (congr!{{TargetExpanded.Homology[z := z].Carrier} {TargetSmall.Homology[z := z].Carrier}} (#apply{#backward{Comparison.targetExcisionIsomorphism}}) _ _ same)
      (#leftInverse{Comparison.targetExcisionIsomorphism} y));
\definition law: \forall (q: Source.Homology[z := z].Carrier) ->
  #apply{SmallAction.At[z := z].induced} (#apply{#forward{Comparison.source}} q) =
  #apply{#forward{Comparison.target}} (#apply{OriginalAction.At[z := z].induced} q) :=
  \fun (q: Source.Homology[z := z].Carrier) => cancel _ _
    (trans!{{TargetExpanded.Homology[z := z].Carrier}} _ _ _
      (ExcisionSquare.Homology[z := z].law (\fun (x: sourceSmall.Carrier) => \refl(data.map x)) (#apply{#forward{Comparison.source}} q))
      (trans!{{TargetExpanded.Homology[z := z].Carrier}} _ _ _
        (congr!{{SourceExpanded.Homology[z := z].Carrier} {TargetExpanded.Homology[z := z].Carrier}} (#apply{ExpandedAction.At[z := z].induced}) _ _
          (#rightInverse{Comparison.sourceExcisionIsomorphism} (#apply{#forward{Comparison.sourceNeighborhood}} q)))
        (trans!{{TargetExpanded.Homology[z := z].Carrier}} _ _ _
          (sym!{{TargetExpanded.Homology[z := z].Carrier}} _ _ (NeighborhoodSquare.Homology[z := z].law (\fun (x: a.base.Carrier) => \refl(data.map x)) q))
          (sym!{{TargetExpanded.Homology[z := z].Carrier}} _ _
            (#rightInverse{Comparison.targetExcisionIsomorphism} (#apply{#forward{Comparison.targetNeighborhood}} (#apply{OriginalAction.At[z := z].induced} q)))))));
