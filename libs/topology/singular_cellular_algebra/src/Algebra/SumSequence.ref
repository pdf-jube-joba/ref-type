\import homological_algebra.Kunneth[].Integer[].ChainSum[Index := Index, terms := leftTerms] \as Left;
\import homological_algebra.Kunneth[].Integer[].ChainSum[Index := Index, terms := middleTerms] \as Middle;
\import homological_algebra.Kunneth[].Integer[].ChainSum[Index := Index, terms := rightTerms] \as Right;
\definition inclusions: \forall (i: Index) -> Complexes.Map[C := leftTerms i, D := middleTerms i].Map :=
  \fun (i: Index) => (sequences i).inclusion;
\definition projections: \forall (i: Index) -> Complexes.Map[C := middleTerms i, D := rightTerms i].Map :=
  \fun (i: Index) => (sequences i).projection;
\import \parent.ChainSumMapping[Index := Index, sourceTerms := leftTerms, targetTerms := middleTerms, maps := inclusions] \as Inclusion;
\import \parent.ChainSumMapping[Index := Index, sourceTerms := middleTerms, targetTerms := rightTerms, maps := projections] \as Projection;
\structure Splitting[i: Index, z: I.Int^]: \Set {
  retraction: Modules.Hom[V := Middle.termCarrier i z, W := Left.termCarrier i z,
    source := Middle.termSpace i z, target := Left.termSpace i z].Map,
  section: Modules.Hom[V := Right.termCarrier i z, W := Middle.termCarrier i z,
    source := Right.termSpace i z, target := Middle.termSpace i z].Map,
  retracts: \forall (x: Left.termCarrier i z) -> #apply{retraction} (#apply{(sequences i).inclusion} z x) = x,
  sectionLaw: \forall (x: Right.termCarrier i z) -> #apply{(sequences i).projection} z (#apply{section} x) = x,
}
\module With(splitting: \forall (i: Index)(z: I.Int^) -> Splitting[i, z]);
