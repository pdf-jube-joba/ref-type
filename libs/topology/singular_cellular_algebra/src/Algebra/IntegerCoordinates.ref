\import \parent.IntegerLine[W := B.Carrier, target := B.space] \as Line;
\import Modules.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space]
  .Composition[U := I.Int^, domain := Modules.scalarModule] \as Compose;
\definition Positive: \Prop := #apply{f} (#apply{#forward{sourceOrientation}} I.One.specification) = #apply{#forward{targetOrientation}} I.One.specification;
\definition equation(positive: Positive): Compose.compose f #forward{sourceOrientation} = #forward{targetOrientation} := Line.ext _ _ positive;
\import Modules.Hom[V := I.Int^, W := B.Carrier, source := Modules.scalarModule, target := B.space] \as Linear;
\definition onScalar(positive: Positive)(a: I.Int^): #apply{f} (#apply{#forward{sourceOrientation}} a) = #apply{#forward{targetOrientation}} a :=
  congr!{Linear.Map B.Carrier} (\fun (g: Linear.Map) => #apply{g} a) _ _ (equation positive);
\definition coordinate(positive: Positive)(q: A.Carrier): #apply{#backward{sourceOrientation}} q = #apply{#backward{targetOrientation}} (#apply{f} q) :=
  trans!{I.Int^} _ _ _ (sym!{I.Int^} _ _ (#leftInverse{targetOrientation} (#apply{#backward{sourceOrientation}} q)))
    (trans!{I.Int^} _ _ _
      (congr!{B.Carrier I.Int^} (#apply{#backward{targetOrientation}}) _ _ (sym!{B.Carrier} _ _ (onScalar positive (#apply{#backward{sourceOrientation}} q))))
      (congr!{A.Carrier I.Int^} (\fun (x: A.Carrier) => #apply{#backward{targetOrientation}} (#apply{f} x)) _ _ (#rightInverse{sourceOrientation} q)));
