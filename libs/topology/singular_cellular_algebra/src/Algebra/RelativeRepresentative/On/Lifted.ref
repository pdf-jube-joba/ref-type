\import \parent.\parent.\parent.CycleEquality[C := C, z := z] \as CyclesEqual;
\definition liftLaw: \forall (q: H.Homology) -> #apply{sequence.projection} z (#apply{f} q) = #apply{section} q :=
  \bysub(Modules.MapBetween homology whole,
    { f: Modules.MapBetween homology whole \where \forall (q: H.Homology) -> #apply{sequence.projection} z (#apply{f} q) = #apply{selected} q }, f);
\definition closed: \forall (q: H.Homology) -> #apply{C.differential} z (#apply{sequence.projection} z (#apply{f} q)) = #zero{(C.family.space (Degrees.previous z))} :=
  \fun (q: H.Homology) => trans!{{C.family.Carrier (Degrees.previous z)}} _ _ _
    (congr!{{C.family.Carrier z} {C.family.Carrier (Degrees.previous z)}} (#apply{C.differential} z) _ _ (liftLaw q))
    (\bysub(C.family.Carrier z, #carrier{H.cycles}, #apply{section} q));
\definition sectionLaw: \forall (q: H.Homology) -> H.classOf (H.cycle (#apply{sequence.projection} z (#apply{f} q)) (closed q)) = q :=
  \fun (q: H.Homology) => trans!{H.Homology} _ _ _
    (CyclesEqual.onClass (H.cycle (#apply{sequence.projection} z (#apply{f} q)) (closed q)) (#apply{section} q) (liftLaw q))
    ((\bysub(Modules.MapBetween homology cycles,
      { s: Modules.MapBetween homology cycles \where \forall (q: H.Homology) -> H.classOf (#apply{s} q) = q }, section)) q);
\definition data: Data := Data { map := f, closed := closed, section := sectionLaw };
