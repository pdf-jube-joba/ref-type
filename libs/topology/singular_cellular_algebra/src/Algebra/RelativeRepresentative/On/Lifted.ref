\import \parent.\parent.\parent.CycleEquality[C := C, z := z] \as CyclesEqual;
\definition liftLaw: \forall (q: H.Homology) -> (sequence.projection).apply z ((f).apply q) = (section).apply q :=
  \bysub(Modules.MapBetween homology whole,
    { f: Modules.MapBetween homology whole \where \forall (q: H.Homology) -> (sequence.projection).apply z ((f).apply q) = (selected).apply q }, f);
\definition closed: \forall (q: H.Homology) -> (C.differential).apply z ((sequence.projection).apply z ((f).apply q)) = (C.family.space (Degrees.previous z)).zero :=
  \fun (q: H.Homology) => trans!{{C.family.Carrier (Degrees.previous z)}} _ _ _
    (congr!{{C.family.Carrier z} {C.family.Carrier (Degrees.previous z)}} ((C.differential).apply z) _ _ (liftLaw q))
    (\bysub(C.family.Carrier z, (H.cycles).carrier, (section).apply q));
\definition sectionLaw: \forall (q: H.Homology) -> H.classOf (H.cycle ((sequence.projection).apply z ((f).apply q)) (closed q)) = q :=
  \fun (q: H.Homology) => trans!{H.Homology} _ _ _
    (CyclesEqual.onClass (H.cycle ((sequence.projection).apply z ((f).apply q)) (closed q)) ((section).apply q) (liftLaw q))
    ((\bysub(Modules.MapBetween homology cycles,
      { s: Modules.MapBetween homology cycles \where \forall (q: H.Homology) -> H.classOf ((s).apply q) = q }, section)) q);
\definition data: Data := Data { map := f, closed := closed, section := sectionLaw };
