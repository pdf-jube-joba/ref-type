\import Modules.Hom[V := H.Cycle, W := C.family.Carrier z, source := H.cycleSpace, target := C.family.space z]
  .Composition[U := H.Homology, domain := H.homologySpace] \as Compose;
\definition selected: Modules.MapBetween homology relative := Compose.compose inclusion section;
\definition Lift: \Set := \Cast[Modules.MapBetween homology whole]
  ({ f: Modules.MapBetween homology whole \where \forall (q: H.Homology) -> #apply{sequence.projection} z (#apply{f} q) = #apply{selected} q });
\definition liftExists: Modules.Projective homology -> \exists Lift :=
  \fun (projective: Modules.Projective homology) => projective whole.Carrier whole.space relative.Carrier relative.space
    (Projection.linear sequence.projection) (#onto{sequence} z) selected;
\module Lifted(f: Lift);
\definition existence: Modules.Projective homology -> \exists Data := \block {
  \fun (projective: Modules.Projective homology) \then
  \takefrom f: Lift \by liftExists projective \then
  \return \exact(Lifted[f := f].data, Data)
};
