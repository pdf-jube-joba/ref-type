\definition Retracts: \Prop := \forall (a: A.family.Carrier previous) -> (r).apply ((sequence.inclusion).apply previous a) = a;
\import Modules.Hom[V := B.family.Carrier z, W := B.family.Carrier previous, source := B.family.space z, target := B.family.space previous] \as Differential;
\definition differential: Differential.Map := Differential.Map {
  apply := (B.differential).apply z, addition := (B.laws).addition z, scalar := (B.laws).scalar z,
};
\import Differential.Composition[U := H.Homology, domain := H.homologySpace] \as First;
\definition wholeBoundary: Modules.Hom[V := H.Homology, W := B.family.Carrier previous, source := H.homologySpace, target := B.family.space previous].Map := First.compose differential data.map;
\import Modules.Hom[V := B.family.Carrier previous, W := A.family.Carrier previous, source := B.family.space previous, target := A.family.space previous]
  .Composition[U := H.Homology, domain := H.homologySpace] \as Second;
\definition boundary: Modules.Hom[V := H.Homology, W := A.family.Carrier previous, source := H.homologySpace, target := A.family.space previous].Map := Second.compose r wholeBoundary;
\module On(retracts: Retracts);
