\definition sectionLaw: \forall (q: Right.Term[z := z].Carrier) ->
  RightCoordinates.coordinates ((Projection.map).apply z ((Section.map).apply q)) i = RightCoordinates.coordinates q i :=
  \fun (q: Right.Term[z := z].Carrier) => trans!{{Right.termCarrier i z}} _ _ _
    (Projected.coordinates ((Section.map).apply q) i)
    (trans!{{Right.termCarrier i z}} _ _ _
      (congr!{{Middle.termCarrier i z} {Right.termCarrier i z}} (((sequences i).projection).apply z) _ _ (Section.coordinatesNatural q i))
      ((splitting i z).sectionLaw (RightCoordinates.coordinates q i)));
\definition zero: \forall (x: Left.Term[z := z].Carrier) ->
  RightCoordinates.coordinates ((Projection.map).apply z ((Inclusion.map).apply z x)) i = RightProduct.zero i :=
  \fun (x: Left.Term[z := z].Carrier) => trans!{{Right.termCarrier i z}} _ _ _
    (Projected.coordinates ((Inclusion.map).apply z x) i)
    (trans!{{Right.termCarrier i z}} _ _ _
      (congr!{{Middle.termCarrier i z} {Right.termCarrier i z}} (((sequences i).projection).apply z) _ _ (Included.coordinates x i))
      ((sequences i).zero z (LeftCoordinates.coordinates x i)));
\definition closed: \forall (y: Middle.Term[z := z].Carrier) -> (Projection.map).apply z y = (Right.Term[z := z].space).zero ->
  ((sequences i).projection).apply z (MiddleCoordinates.coordinates y i) = (Right.termSpace i z).zero :=
  \fun (y: Middle.Term[z := z].Carrier)(zero: _) => trans!{{Right.termCarrier i z}} _ _ _
    (sym!{{Right.termCarrier i z}} _ _ (Projected.coordinates y i))
    (trans!{{Right.termCarrier i z}} _ _ _
      (congr!{Right.Term[z := z].Carrier {Right.termCarrier i z}} (\fun (q: Right.Term[z := z].Carrier) => RightCoordinates.coordinates q i) _ _ zero)
      (congr!{RightProduct.Carrier {Right.termCarrier i z}} (\fun (v: RightProduct.Carrier) => v i) _ _ RightCoordinates.coordinatesZero));
\definition kernel: \forall (y: Middle.Term[z := z].Carrier) -> (Projection.map).apply z y = (Right.Term[z := z].space).zero ->
  MiddleCoordinates.coordinates ((Inclusion.map).apply z ((Retraction.map).apply y)) i = MiddleCoordinates.coordinates y i := \block {
  \fun (y: Middle.Term[z := z].Carrier)(zero: _) \then
  \takefrom x: \Cast[Left.termCarrier i z] ({ x: Left.termCarrier i z \where
    ((sequences i).inclusion).apply z x = MiddleCoordinates.coordinates y i })
    \by (sequences i).kernelImage z (MiddleCoordinates.coordinates y i) (closed y zero) \then
  \let image: ((sequences i).inclusion).apply z x = MiddleCoordinates.coordinates y i :=
    \bysub(Left.termCarrier i z, { x: Left.termCarrier i z \where
      ((sequences i).inclusion).apply z x = MiddleCoordinates.coordinates y i }, x) \then
  \return trans!{{Middle.termCarrier i z}} _ _ _
    (Included.coordinates ((Retraction.map).apply y) i)
    (trans!{{Middle.termCarrier i z}} _ _ _
      (congr!{{Left.termCarrier i z} {Middle.termCarrier i z}} (((sequences i).inclusion).apply z) _ _ (Retraction.coordinatesNatural y i))
      (trans!{{Middle.termCarrier i z}} _ _ _
        (congr!{{Middle.termCarrier i z} {Middle.termCarrier i z}}
          (\fun (b: Middle.termCarrier i z) => ((sequences i).inclusion).apply z (((splitting i z).retraction).apply b)) _ _
          (sym!{{Middle.termCarrier i z}} _ _ image))
        (trans!{{Middle.termCarrier i z}} _ _ _
          (congr!{{Left.termCarrier i z} {Middle.termCarrier i z}} (((sequences i).inclusion).apply z) _ _ ((splitting i z).retracts x)) image)))
};
