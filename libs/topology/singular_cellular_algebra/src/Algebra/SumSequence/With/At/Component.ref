\definition sectionLaw: \forall (q: Right.Term[z := z].Carrier) ->
  RightCoordinates.coordinates (#apply{Projection.map} z (#apply{Section.map} q)) i = RightCoordinates.coordinates q i :=
  \fun (q: Right.Term[z := z].Carrier) => trans!{{Right.termCarrier i z}} _ _ _
    (Projected.coordinates (#apply{Section.map} q) i)
    (trans!{{Right.termCarrier i z}} _ _ _
      (congr!{{Middle.termCarrier i z} {Right.termCarrier i z}} (#apply{(sequences i).projection} z) _ _ (Section.coordinatesNatural q i))
      (#sectionLaw{(splitting i z)} (RightCoordinates.coordinates q i)));
\definition zero: \forall (x: Left.Term[z := z].Carrier) ->
  RightCoordinates.coordinates (#apply{Projection.map} z (#apply{Inclusion.map} z x)) i = RightProduct.zero i :=
  \fun (x: Left.Term[z := z].Carrier) => trans!{{Right.termCarrier i z}} _ _ _
    (Projected.coordinates (#apply{Inclusion.map} z x) i)
    (trans!{{Right.termCarrier i z}} _ _ _
      (congr!{{Middle.termCarrier i z} {Right.termCarrier i z}} (#apply{(sequences i).projection} z) _ _ (Included.coordinates x i))
      (#zero{(sequences i)} z (LeftCoordinates.coordinates x i)));
\definition closed: \forall (y: Middle.Term[z := z].Carrier) -> #apply{Projection.map} z y = #zero{(Right.Term[z := z].space)} ->
  #apply{(sequences i).projection} z (MiddleCoordinates.coordinates y i) = #zero{(Right.termSpace i z)} :=
  \fun (y: Middle.Term[z := z].Carrier)(zero: _) => trans!{{Right.termCarrier i z}} _ _ _
    (sym!{{Right.termCarrier i z}} _ _ (Projected.coordinates y i))
    (trans!{{Right.termCarrier i z}} _ _ _
      (congr!{Right.Term[z := z].Carrier {Right.termCarrier i z}} (\fun (q: Right.Term[z := z].Carrier) => RightCoordinates.coordinates q i) _ _ zero)
      (congr!{RightProduct.Carrier {Right.termCarrier i z}} (\fun (v: RightProduct.Carrier) => v i) _ _ RightCoordinates.coordinatesZero));
\definition kernel: \forall (y: Middle.Term[z := z].Carrier) -> #apply{Projection.map} z y = #zero{(Right.Term[z := z].space)} ->
  MiddleCoordinates.coordinates (#apply{Inclusion.map} z (#apply{Retraction.map} y)) i = MiddleCoordinates.coordinates y i := \block {
  \fun (y: Middle.Term[z := z].Carrier)(zero: _) \then
  \takefrom x: \Cast[Left.termCarrier i z] ({ x: Left.termCarrier i z \where
    #apply{(sequences i).inclusion} z x = MiddleCoordinates.coordinates y i })
    \by #kernelImage{(sequences i)} z (MiddleCoordinates.coordinates y i) (closed y zero) \then
  \let image: #apply{(sequences i).inclusion} z x = MiddleCoordinates.coordinates y i :=
    \bysub(Left.termCarrier i z, { x: Left.termCarrier i z \where
      #apply{(sequences i).inclusion} z x = MiddleCoordinates.coordinates y i }, x) \then
  \return trans!{{Middle.termCarrier i z}} _ _ _
    (Included.coordinates (#apply{Retraction.map} y) i)
    (trans!{{Middle.termCarrier i z}} _ _ _
      (congr!{{Left.termCarrier i z} {Middle.termCarrier i z}} (#apply{(sequences i).inclusion} z) _ _ (Retraction.coordinatesNatural y i))
      (trans!{{Middle.termCarrier i z}} _ _ _
        (congr!{{Middle.termCarrier i z} {Middle.termCarrier i z}}
          (\fun (b: Middle.termCarrier i z) => #apply{(sequences i).inclusion} z (#apply{#retraction{(splitting i z)}} b)) _ _
          (sym!{{Middle.termCarrier i z}} _ _ image))
        (trans!{{Middle.termCarrier i z}} _ _ _
          (congr!{{Left.termCarrier i z} {Middle.termCarrier i z}} (#apply{(sequences i).inclusion} z) _ _ (#retracts{(splitting i z)} x)) image)))
};
