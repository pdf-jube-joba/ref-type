\import Modules.DirectSum[Index := Index, family := Left.Term[z := z].family].FiniteSupport[] \as LeftCoordinates;
\import Modules.DirectSum[Index := Index, family := Middle.Term[z := z].family].FiniteSupport[] \as MiddleCoordinates;
\import Modules.DirectSum[Index := Index, family := Right.Term[z := z].family].FiniteSupport[] \as RightCoordinates;
\import Modules.Product[Index := Index, family := Left.Term[z := z].family] \as LeftProduct;
\import Modules.Product[Index := Index, family := Middle.Term[z := z].family] \as MiddleProduct;
\import Modules.Product[Index := Index, family := Right.Term[z := z].family] \as RightProduct;
\import Modules.DirectSumMapping[Index := Index, sourceFamily := Right.Term[z := z].family, targetFamily := Middle.Term[z := z].family] \as SectionMapping;
\definition sections: SectionMapping.Components := \fun (i: Index) => (splitting i z).section;
\import SectionMapping.On[f := sections] \as Section;
\import Modules.DirectSumMapping[Index := Index, sourceFamily := Middle.Term[z := z].family, targetFamily := Left.Term[z := z].family] \as RetractionMapping;
\definition retractions: RetractionMapping.Components := \fun (i: Index) => (splitting i z).retraction;
\import RetractionMapping.On[f := retractions] \as Retraction;
\import Inclusion.At[z := z] \as Included;
\import Projection.At[z := z] \as Projected;
\definition injective: \forall (x, y: Left.Term[z := z].Carrier) ->
  (Inclusion.map).apply z x = (Inclusion.map).apply z y -> x = y :=
  Included.injective (\fun (i: Index) => (sequences i).injective z);

\module Component(i: Index);
\definition sectionLaw: \forall (q: Right.Term[z := z].Carrier) -> (Projection.map).apply z ((Section.map).apply q) = q :=
  \fun (q: Right.Term[z := z].Carrier) => RightCoordinates.injective _ _
    (\axiom:funext(RightCoordinates.coordinates ((Projection.map).apply z ((Section.map).apply q)), RightCoordinates.coordinates q,
      \fun (i: Index) => Component[i := i].sectionLaw q));
\definition onto: \forall (q: Right.Term[z := z].Carrier) -> \exists ( y: Middle.Term[z := z].Carrier \where (Projection.map).apply z y = q ) :=
  \fun (q: Right.Term[z := z].Carrier) => std.Logic[].Proposition[].existsIntro[Middle.Term[z := z].Carrier,
    { y: Middle.Term[z := z].Carrier \where (Projection.map).apply z y = q }] ((Section.map).apply q) (sectionLaw q);
\definition zero: \forall (x: Left.Term[z := z].Carrier) -> (Projection.map).apply z ((Inclusion.map).apply z x) = (Right.Term[z := z].space).zero :=
  \fun (x: Left.Term[z := z].Carrier) => RightCoordinates.injective _ _
    (trans!{RightProduct.Carrier} _ _ _
      (\axiom:funext(RightCoordinates.coordinates ((Projection.map).apply z ((Inclusion.map).apply z x)), RightProduct.zero,
        \fun (i: Index) => Component[i := i].zero x)) (sym!{RightProduct.Carrier} _ _ RightCoordinates.coordinatesZero));
\definition kernelImage: \forall (y: Middle.Term[z := z].Carrier) -> (Projection.map).apply z y = (Right.Term[z := z].space).zero ->
  \exists ( x: Left.Term[z := z].Carrier \where (Inclusion.map).apply z x = y ) :=
  \fun (y: Middle.Term[z := z].Carrier)(zero: _) => std.Logic[].Proposition[].existsIntro[Left.Term[z := z].Carrier,
    { x: Left.Term[z := z].Carrier \where (Inclusion.map).apply z x = y }] ((Retraction.map).apply y)
      (MiddleCoordinates.injective _ _
        (\axiom:funext(MiddleCoordinates.coordinates ((Inclusion.map).apply z ((Retraction.map).apply y)), MiddleCoordinates.coordinates y,
          \fun (i: Index) => Component[i := i].kernel y zero)));
