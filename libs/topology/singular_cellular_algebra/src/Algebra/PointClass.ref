\import std.Data[].Nat[] \as N;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import singular_cohomology.Chains[A := A, source := source] \as Chains;
\import singular_cohomology.Simplices[A := A, source := source] \as Simplices;
\import Native.ZeroExtension[C := Chains.complex] \as Extension;
\definition degree: I.Int^ := I.Int^::ofNat N.Nat^::zero;
\definition complex: Complexes.Complex := Complexes.Complex { family := Extension.complex.family, differential := Extension.complex.differential, laws := Extension.complex.laws };
\import Complexes.At[C := complex, z := degree] \as H;
\definition Carrier: \Set := H.Homology;
\definition space: Modules.Space Carrier := H.homologySpace;
\definition cycle[point: A]: H.Cycle := H.cycle
  (Extension.Positive[n := N.Nat^::zero].intro (Chains.generator N.Nat^::zero (Simplices.At[n := N.Nat^::zero].constant point))) (\refl((Extension.space (I.Int^::negSucc N.Nat^::zero)).zero));
\definition class[point: A]: Carrier := H.classOf (cycle point);
\module Mapping(B: \Set, target: topology.Topology[Carrier := B].Topology, f: A -> B,
  continuous: topology.Continuity[A := A, B := B].Continuous source target f);
