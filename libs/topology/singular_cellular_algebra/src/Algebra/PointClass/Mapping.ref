\import \parent.\parent.PointClass[A := B, source := target] \as Target;
\import singular_cohomology.Chains[A := B, source := target] \as TargetChains;
\import Native.ZeroExtension[C := TargetChains.complex] \as TargetExtension;
\import singular_cohomology.Maps[A := A, B := B, source := source, target := target] \as Maps;
\definition map: Complexes.Map[C := complex, D := Target.complex].Map := Maps.integerPush f continuous;
\import Complexes.Map[C := complex, D := Target.complex].At[k := degree] \as Induced;
\definition action: Modules.Hom[V := Carrier, W := Target.Carrier, source := space, target := Target.space].Map := Induced.induced map;
\import Complexes.At[C := Target.complex, z := degree] \as TargetH;
\definition law(point: A): #apply{action} (class point) = Target.class (f point) :=
  trans!{Target.Carrier} _ _ _ (Induced.onClass map (cycle point))
    (congr!{TargetH.Cycle Target.Carrier} TargetH.classOf _ _
      (congr!{{TargetChains.Carrier N.Nat^::zero} {TargetExtension.Carrier degree}} (TargetExtension.Positive[n := N.Nat^::zero].intro) _ _
        (Maps.At[n := N.Nat^::zero].onGenerator f continuous (Simplices.At[n := N.Nat^::zero].constant point))));
