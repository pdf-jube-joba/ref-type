\import Modules.Hom[V := I.Int^, W := W, source := Modules.scalarModule, target := target] \as Maps;
\definition onScalar: \forall (f: Maps.Map)(a: I.Int^) -> #apply{f} a = #smul{target} a (#apply{f} I.One.specification) :=
  \fun (f: Maps.Map)(a: I.Int^) => trans!{W} _ _ _
    (congr!{I.Int^ W} (#apply{f}) _ _ (sym!{I.Int^} _ _ (#rightIdentity{(#multiplicative{(#semiring{Integers.ring})})} a)))
    (#scalar{f} a I.One.specification);
\definition ext(f, g: Maps.Map)(same: #apply{f} I.One.specification = #apply{g} I.One.specification): f = g :=
  Maps.ext f g (\fun (a: I.Int^) => trans!{W} _ _ _ (onScalar f a)
    (trans!{W} _ _ _ (congr!{W W} (#smul{target} a) _ _ same) (sym!{W} _ _ (onScalar g a))));
