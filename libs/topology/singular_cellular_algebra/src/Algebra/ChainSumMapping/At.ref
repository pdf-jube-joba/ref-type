\import Modules.DirectSumMapping[Index := Index, sourceFamily := Source.Term[z := z].family, targetFamily := Target.Term[z := z].family] \as Native;

\module Component(i: Index);
\definition components: Native.Components := \fun (i: Index) => Component[i := i].map;
\import Native.On[f := components] \as Mapping;
\definition map: Modules.Hom[V := Source.Term[z := z].Carrier, W := Target.Term[z := z].Carrier,
  source := Source.Term[z := z].space, target := Target.Term[z := z].space].Map := Mapping.map;
\definition onInjection: \forall (i: Index)(x: Source.termCarrier i z) ->
  (map).apply ((Source.Term[z := z].Component[i := i].injection).apply x) =
  (Target.Term[z := z].Component[i := i].injection).apply ((maps i).apply z x) := Mapping.onInjection;
\import Modules.DirectSum[Index := Index, family := Source.Term[z := z].family].FiniteSupport[] \as SourceCoordinates;
\import Modules.DirectSum[Index := Index, family := Target.Term[z := z].family].FiniteSupport[] \as TargetCoordinates;
\definition coordinates: \forall (x: Source.Term[z := z].Carrier)(i: Index) ->
  TargetCoordinates.coordinates ((map).apply x) i = (maps i).apply z (SourceCoordinates.coordinates x i) := Mapping.coordinatesNatural;
\import Modules.DirectSum[Index := Index, family := Source.Term[z := Degrees.previous z].family].FiniteSupport[] \as LowerSource;
\import Modules.DirectSum[Index := Index, family := Target.Term[z := Degrees.previous z].family].FiniteSupport[] \as LowerTarget;
\module Boundary;
\definition commutes: \forall (x: Source.Term[z := z].Carrier) ->
  (Target.complex.differential).apply z ((map).apply x) =
  (\parent.At[z := Degrees.previous z].map).apply ((Source.complex.differential).apply z x) := Boundary[].law;

\definition injective: (\forall (i: Index)(x, y: Source.termCarrier i z) -> (maps i).apply z x = (maps i).apply z y -> x = y) ->
  \forall (x, y: Source.Term[z := z].Carrier) -> (map).apply x = (map).apply y -> x = y := Mapping.injective;
