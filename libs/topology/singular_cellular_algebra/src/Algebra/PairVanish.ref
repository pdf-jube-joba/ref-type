\import std.Logic[].Proposition[] \as Logic;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import singular_cohomology.Relative[A := a.Carrier, source := a.topology, subset := a.subset] \as Source;
\import singular_cohomology.Relative[A := b.Carrier, source := b.topology, subset := b.subset] \as Target;
\import Source.Maps[B := b.Carrier].Over[target := b.topology, targetSubset := b.subset] \as Maps;
\import singular_cohomology.Chains[A := a.Carrier, source := a.topology] \as SourceWhole;
\import singular_cohomology.Chains[A := Source.SubspaceCarrier, source := topology.Topology[Carrier := a.Carrier].Subspace[S := a.subset].topology a.topology] \as SourceSub;
\import singular_cohomology.Chains[A := b.Carrier, source := b.topology] \as TargetWhole;
\import singular_cohomology.Chains[A := Target.SubspaceCarrier, source := topology.Topology[Carrier := b.Carrier].Subspace[S := b.subset].topology b.topology] \as TargetSub;
\import Native.ZeroExtension[C := SourceWhole.complex] \as SourceWholeExtension;
\import Native.ZeroExtension[C := SourceSub.complex] \as SourceSubExtension;
\import Native.ZeroExtension[C := TargetWhole.complex] \as TargetWholeExtension;
\import Native.ZeroExtension[C := TargetSub.complex] \as TargetSubExtension;
\import Complexes.Quotient[C := SourceSubExtension.complex, D := SourceWholeExtension.complex].On[f := Source.inclusionMap] \as SourceQuotient;
\import Complexes.Quotient[C := TargetSubExtension.complex, D := TargetWholeExtension.complex].On[f := Target.inclusionMap] \as TargetQuotient;
\module Along(f: Maps.Map);
