\import homological_algebra.Kunneth[].Integer[].ChainSum[Index := Index, terms := terms] \as Sum;
\import chain_complexes.Chain[] \as Degrees;
\module At(z: I.Int^);
\definition map: Complexes.Map[C := Sum.complex, D := target].Map := Complexes.Map[C := Sum.complex, D := target].Map {
  apply := \fun (z: I.Int^) => (At[z := z].map).apply,
  addition := \fun (z: I.Int^) => (At[z := z].map).addition,
  scalar := \fun (z: I.Int^) => (At[z := z].map).scalar,
  commutes := \fun (z: I.Int^) => At[z := z].commutes,
};

\module Homology(z: I.Int^);
