\import std.Logic[].Proposition[] \as Logic;
\import homological_algebra.Kunneth[].Integer[].ChainSum[Index := Index, terms := terms] \as Sum;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.Integer[P := Sum.complex, N := coefficients] \as Source;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficients;

\module Component(i: Index);
\definition complexes: Index -> Cochains.Complex := \fun (i: Index) => Component[i := i].complex;
\import \parent.CochainProduct[Index := Index, terms := complexes] \as Target;
\module Degree(z: I.Int^);
\definition components: \forall (z: I.Int^) -> Modules.Isomorphism[V := Source.Carrier z, W := Target.Term[z := z].Carrier,
  source := Source.space z, target := Target.Term[z := z].space].Isomorphism := \fun (z: I.Int^) => Degree[z := z].isomorphism;
\import Source.Into[D := Target.complex].From[components := components] \as Comparison;
\definition compatible: Comparison.Commutes := \fun (z: I.Int^)(f: Source.Carrier z) =>
  \axiom:funext(Target.apply z (#apply{#forward{(components z)}} f), #apply{#forward{(components (chain_complexes.Chain[].next z))}} (Source.apply z f),
    \fun (i: Index) => #commutes{Component[i := i].map} z f);
\definition isomorphism: Cochains.Isomorphism[C := Source.complex, D := Target.complex].Isomorphism := Comparison.isomorphism compatible;

\module At(z: I.Int^);
