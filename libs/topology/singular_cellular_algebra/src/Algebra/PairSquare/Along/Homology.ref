\definition action(m: AD.Map): Modules.Hom[V := A.Homology[z := z].Carrier, W := D.Homology[z := z].Carrier,
  source := A.Homology[z := z].space, target := D.Homology[z := z].space].Map := AD.On[f := m].Integer[].At[z := z].induced;
\definition law: \forall (compatible: Commutes)(q: A.Homology[z := z].Carrier) ->
  #apply{H.At[z := z].induced} (#apply{F.At[z := z].induced} q) = #apply{K.At[z := z].induced} (#apply{G.At[z := z].induced} q) :=
  \fun (compatible: Commutes)(q: A.Homology[z := z].Carrier) => trans!{{D.Homology[z := z].Carrier}} _ _ _
    (sym!{{D.Homology[z := z].Carrier}} _ _ (FirstComposition.Homology[z := z].law q))
    (trans!{{D.Homology[z := z].Carrier}} _ _ _
      (congr!{AD.Map {D.Homology[z := z].Carrier}} (\fun (m: AD.Map) => #apply{(action m)} q) _ _ (equality compatible))
      (SecondComposition.Homology[z := z].law q));
