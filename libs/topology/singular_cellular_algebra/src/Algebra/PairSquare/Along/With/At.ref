\definition action(m: AD.Map): Modules.Hom[V := D.With[coefficients := coefficients].At[z := z].Carrier,
  W := A.With[coefficients := coefficients].At[z := z].Carrier, source := D.With[coefficients := coefficients].At[z := z].space,
  target := A.With[coefficients := coefficients].At[z := z].space].Map := AD.On[f := m].Integer[].With[coefficients := coefficients].At[z := z].induced;
\definition law: \forall (compatible: Commutes)(q: D.With[coefficients := coefficients].At[z := z].Carrier) ->
  #apply{F.With[coefficients := coefficients].At[z := z].induced} (#apply{H.With[coefficients := coefficients].At[z := z].induced} q) =
    #apply{G.With[coefficients := coefficients].At[z := z].induced} (#apply{K.With[coefficients := coefficients].At[z := z].induced} q) :=
  \fun (compatible: Commutes)(q: D.With[coefficients := coefficients].At[z := z].Carrier) => trans!{{A.With[coefficients := coefficients].At[z := z].Carrier}} _ _ _
    (sym!{{A.With[coefficients := coefficients].At[z := z].Carrier}} _ _ (FirstComposition.With[coefficients := coefficients].law z q))
    (trans!{{A.With[coefficients := coefficients].At[z := z].Carrier}} _ _ _
      (congr!{AD.Map {A.With[coefficients := coefficients].At[z := z].Carrier}} (\fun (m: AD.Map) => #apply{(action m)} q) _ _ (equality compatible))
      (SecondComposition.With[coefficients := coefficients].law z q));
