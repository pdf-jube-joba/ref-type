\definition Commutes: \Prop := \forall (x: a.Carrier) -> h (f x) = k (g x);
\import AB.Composition[C := d.Carrier].Over[final := d.topology, finalSubset := d.subset] \as First;
\import AC.Composition[C := d.Carrier].Over[final := d.topology, finalSubset := d.subset] \as Second;
\definition equality(compatible: Commutes): First.compose f h = Second.compose g k :=
  \axiom:funext(First.compose f h, Second.compose g k, compatible);
\import AB.On[f := f].Integer[] \as F;
\import AC.On[f := g].Integer[] \as G;
\import BD.On[f := h].Integer[] \as H;
\import CD.On[f := k].Integer[] \as K;
\import First.On[f := f, g := h] \as FirstComposition;
\import Second.On[f := g, g := k] \as SecondComposition;
\module Homology(z: I.Int^);
\module With(coefficients: Modules.Bundle);
