\definition map: Modules.MapBetween M boundary := Modules.Hom[V := M.Carrier, W := boundary.Carrier, source := M.space, target := boundary.space].Map {
  apply := \fun (m: M.Carrier) => \into[P.family.Carrier z]((data.map).apply m, (H.boundaries).carrier) \by { H.zeroClassBoundary ((data.map).apply m) (data.killed m) },
  addition := (data.map).addition, scalar := (data.map).scalar,
};
\definition existence: Modules.Projective M -> \exists ( f: Modules.MapBetween M upper \where
  \forall (m: M.Carrier) -> (H.prior).apply ((f).apply m) = (data.map).apply m ) :=
  \fun (projective: Modules.Projective M) => projective upper.Carrier upper.space boundary.Carrier boundary.space projection onto map;
