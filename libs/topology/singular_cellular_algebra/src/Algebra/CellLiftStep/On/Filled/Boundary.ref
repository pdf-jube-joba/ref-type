\import Modules.Laws[V := A.family.Carrier previous, space := A.family.space previous] \as LowerSpace;
\import algebra.Group[].Of[Carrier := A.family.Carrier previous, group := LowerSpace.additive] \as LowerGroup;
\import Modules.Laws[V := B.family.Carrier previous, space := B.family.space previous] \as UpperSpace;
\import algebra.Group[].Of[Carrier := B.family.Carrier previous, group := UpperSpace.additive] \as UpperGroup;
\import Modules.Hom[V := B.family.Carrier z, W := B.family.Carrier previous, source := B.family.space z, target := B.family.space previous] \as Differentials;
\import Complexes.At[C := B, z := z] \as Upper;
\import Modules.Hom[V := A.family.Carrier previous, W := B.family.Carrier previous, source := A.family.space previous, target := B.family.space previous] \as Inclusions;
\import Complexes.Map[C := A, D := B].At[k := previous] \as Included;
\definition law: \forall (q: H.Homology) -> #apply{B.differential} z (#apply{map} q) = #apply{sequence.inclusion} previous (#apply{desired.map} q) :=
  \fun (q: H.Homology) => trans!{{B.family.Carrier previous}} _ _ _
    (Differentials.differencePreserved Upper.differential (#apply{data.map} q) (#apply{correction} q))
    (trans!{{B.family.Carrier previous}} _ _ _
      (congr2!{{B.family.Carrier previous} {B.family.Carrier previous} {B.family.Carrier previous}} UpperGroup.difference _ _ _ _
        (sym!{{B.family.Carrier previous}} _ _ (Derivative.onInclusion q))
        (trans!{{B.family.Carrier previous}} _ _ _ (#commutes{sequence.inclusion} z (#apply{f} q))
          (congr!{{A.family.Carrier previous} {B.family.Carrier previous}} (#apply{sequence.inclusion} previous) _ _ (filled q))))
      (trans!{{B.family.Carrier previous}} _ _ _
        (sym!{{B.family.Carrier previous}} _ _ (Inclusions.differencePreserved (Included.linear sequence.inclusion) (#apply{Derivative.boundary} q) (#apply{difference} q)))
        (congr!{{A.family.Carrier previous} {B.family.Carrier previous}} (#apply{sequence.inclusion} previous) _ _
          (LowerGroup.subtractDifference (#apply{Derivative.boundary} q) (#apply{desired.map} q)))));
