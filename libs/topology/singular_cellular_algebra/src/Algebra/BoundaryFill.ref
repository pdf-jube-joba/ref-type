\import chain_complexes.Chain[] \as Degrees;
\import std.Logic[].Proposition[] \as Logic;
\import Complexes.At[C := P, z := z] \as H;
\import Modules.Of[V := P.family.Carrier z, space := P.family.space z].Submodule[] \as Submodules;
\import Submodules.Of[S := H.boundaries] \as Boundaries;
\import Submodules.Image[U := P.family.Carrier (Degrees.next z), source := P.family.space (Degrees.next z)] \as Images;
\definition upper: Modules.Bundle := Modules.Bundle { Carrier := P.family.Carrier (Degrees.next z), space := P.family.space (Degrees.next z) };
\definition boundary: Modules.Bundle := Modules.Bundle { Carrier := Boundaries.Carrier, space := Boundaries.moduleSpace };
\definition projection: Modules.MapBetween upper boundary := Modules.Hom[V := upper.Carrier, W := boundary.Carrier, source := upper.space, target := boundary.space].Map {
  apply := \fun (x: upper.Carrier) => \into[P.family.Carrier z](#apply{H.prior} x, #carrier{H.boundaries}) \by { Images.member H.prior x },
  addition := #addition{H.prior}, scalar := #scalar{H.prior},
};
\definition onto: Modules.Surjective upper boundary projection := \block {
  \fun (b: boundary.Carrier) \then
  \takefrom x: \Cast[upper.Carrier] ({ x: upper.Carrier \where #apply{H.prior} x = b })
    \by \bysub(P.family.Carrier z, #carrier{H.boundaries}, b) \then
  \return Logic.existsIntro[upper.Carrier, { x: upper.Carrier \where #apply{projection} x = b }] x
    (\bysub(upper.Carrier, { x: upper.Carrier \where #apply{H.prior} x = b }, x))
};
\structure Data: \Set {
  map: Modules.Hom[V := M.Carrier, W := H.Cycle, source := M.space, target := H.cycleSpace].Map,
  killed: \forall (m: M.Carrier) -> H.classOf (#apply{map} m) = H.zeroClass,
}
\module On(data: Data);
