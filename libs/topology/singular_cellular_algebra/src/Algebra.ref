\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\use Equality.congr2;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\module QuotientIsomorphism(C, D, C1, D1: Complexes.Complex,
  f: Complexes.Map[C := C, D := D].Map, g: Complexes.Map[C := C1, D := D1].Map,
  left: Complexes.Isomorphism[C := C, D := C1].Isomorphism,
  right: Complexes.Isomorphism[C := D, D := D1].Isomorphism);
\module AbsoluteHomeomorphism(A, B: \Set,
  source: topology.Topology[Carrier := A].Topology,
  target: topology.Topology[Carrier := B].Topology,
  homeomorphism: topology.Homeomorphism[A := A, B := B].Homeomorphism[source, target]);


\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\module CochainProduct(Index: \Set, terms: Index -> Cochains.Complex);

\module SumCochains(Index: \Set, terms: Index -> Complexes.Complex, coefficients: Modules.Bundle);

\module RelativeSplit(A: \Set, source: topology.Topology[Carrier := A].Topology, subset: \Pow A);

\module SumTo(Index: \Set, terms: Index -> Complexes.Complex, target: Complexes.Complex,
  maps: \forall (i: Index) -> Complexes.Map[C := terms i, D := target].Map);

\structure SpacePair {
  Carrier: \Set,
  topology: topology.Topology[Carrier := Carrier].Topology,
  subset: \Pow Carrier,
}
\module PairSquare(a, b, c, d: SpacePair);

\structure ExcisivePair {
  base: SpacePair,
  removed: \Pow base.Carrier,
  valid: topology.Topology[Carrier := base.Carrier].Subset
    (topology.Topology[Carrier := base.Carrier].Closure[].closure base.topology removed)
    (topology.Topology[Carrier := base.Carrier].Interior[].interior base.topology base.subset),
}
\module ExcisionChart(a, b: ExcisivePair);

\module ChainSumMapping(Index: \Set, sourceTerms, targetTerms: Index -> Complexes.Complex,
  maps: \forall (i: Index) -> Complexes.Map[C := sourceTerms i, D := targetTerms i].Map);

\module SumSequence(Index: \Set, leftTerms, middleTerms, rightTerms: Index -> Complexes.Complex,
  sequences: \forall (i: Index) -> Complexes.ShortExact[A := leftTerms i, B := middleTerms i, C := rightTerms i].Sequence);

\module SumIsomorphism(Index: \Set, sourceFamily, targetFamily: Modules.Family[Index],
  isomorphisms: \forall (i: Index) -> Modules.Isomorphism[V := sourceFamily.Carrier i, W := targetFamily.Carrier i,
    source := sourceFamily.space i, target := targetFamily.space i].Isomorphism);

\module FreeSum(Index: \Set);

\structure NeighborhoodPair {
  base: SpacePair,
  region: \Pow base.Carrier,
  closed: topology.Topology[Carrier := base.Carrier].IsClosedIn base.topology base.subset,
  open: topology.Topology[Carrier := base.Carrier].IsOpenIn base.topology region,
  included: topology.Topology[Carrier := base.Carrier].Subset base.subset region,
  deformation: algebraic_topology.DeformationRetract[
    A := topology.Topology[Carrier := base.Carrier].Subspace[S := region].CarrierSet,
    source := topology.Topology[Carrier := base.Carrier].Subspace[S := region].topology base.topology,
    subset := { x: topology.Topology[Carrier := base.Carrier].Subspace[S := region].CarrierSet \where \In[base.Carrier] base.subset x }].Data,
}
\module Neighborhood(pair: NeighborhoodPair);

\module RelativeRepresentative(A, B, C: Complexes.Complex, sequence: Complexes.ShortExact[A := A, B := B, C := C].Sequence, z: I.Int^);

\module BoundaryFill(P: Complexes.Complex, z: I.Int^, M: Modules.Bundle);

\module CellLiftStep(A, B, C: Complexes.Complex, sequence: Complexes.ShortExact[A := A, B := B, C := C].Sequence, n: std.Data[].Nat[].Nat^);

\module HomologyPresentation(P: Complexes.Complex, z: I.Int^, target: Modules.Bundle);

\module QuotientLift(A, B, C: \Set,
  source: topology.Topology[Carrier := A].Topology,
  target: topology.Topology[Carrier := B].Topology,
  final: topology.Topology[Carrier := C].Topology, q: A -> B);

\module NeighborhoodMapping(a, b: NeighborhoodPair);

\module PointRelative(A: \Set, source: topology.Topology[Carrier := A].Topology, point: A);

\module PairVanish(a, b: SpacePair);

\module IntegerLine(W: \Set, target: Modules.Space W);
\module IntegerCoordinates(A, B: Modules.Bundle, f: Modules.MapBetween A B,
  sourceOrientation: Modules.Isomorphism[V := I.Int^, W := A.Carrier, source := Modules.scalarModule, target := A.space].Isomorphism,
  targetOrientation: Modules.Isomorphism[V := I.Int^, W := B.Carrier, source := Modules.scalarModule, target := B.space].Isomorphism);

\module PointClass(A: \Set, source: topology.Topology[Carrier := A].Topology);

\module CycleEquality(C: Complexes.Complex, z: I.Int^);
