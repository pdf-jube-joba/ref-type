\import algebraic_topology.Simplex[] \as Simplex;
\import Simplex.Vertices[] \as Vertices;
\import Simplex.Affine[m := one, n := one] \as IdentityAffine;
\import Simplex.AffineIdentity[n := one] \as AffineIdentity;
\import singular_products.ProductChains[p := one, q := zero] \as Model;
\import Model.Into[A := A, B := B, source := left, target := right] \as Evaluation;
\import Model.At[m := one] \as Affine;
\import singular_products.OrderedShuffle[V := Simplex.Carrier one, W := Simplex.Carrier zero] \as Raw;
\import singular_cohomology.OrderedTuples[V := Raw.Pair] \as Tuples;
\import singular_cohomology.OrderedTuples[V := Simplex.Carrier one].Mapping[W := Raw.Pair] \as Pointwise;
\import singular_cohomology.Simplices[A := A, source := left] \as LeftSimplices;
\import singular_cohomology.Simplices[A := B, source := right] \as RightSimplices;
\import singular_cohomology.Simplices[A := Geometry.CarrierSet, source := productTopology] \as ProductSimplices;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\import Shuffle.At[p := one, q := zero] \as Cross;
\definition constant: RightSimplices.Carrier zero := RightSimplices.At[n := zero].constant rightPoint;
\definition pointChain: Right.Carrier zero := Right.generator zero constant;
\definition vertex(v: Simplex.Carrier one): Raw.Pair := Raw.Pair { left := v, right := Vertices.vertex zero (Fin.zero zero) };
\definition vertices: Tuples.Tuple two := \fun (i: Fin.Fin two) => vertex (Vertices.vertex one i);
\import Raw.RightBase[].At[p := one, y := Vertices.vertex zero] \as Base;
\definition fundamental: Model.fundamental = Tuples.generator two vertices :=
  trans!{{Tuples.Carrier two}} _ _ _ (Raw.RightBase[].law one (Vertices.vertex one) (Vertices.vertex zero))
    (trans!{{Tuples.Carrier two}} _ _ _
      (Transport.castRefl Tuples.Carrier two (#apply{(Pointwise.push two vertex)}
        (singular_cohomology.OrderedTuples[V := Simplex.Carrier one].generator two (Vertices.vertex one))))
      (Pointwise.At[n := two].onGenerator vertex (Vertices.vertex one)));
\definition leftVertices: Affine.leftVertices vertices = Vertices.vertex one :=
  \axiom:funext(Affine.leftVertices vertices, Vertices.vertex one, \fun (i: Fin.Fin two) => \refl(Vertices.vertex one i));
\definition leftIdentity(x: Simplex.Carrier one): IdentityAffine.apply (Affine.leftVertices vertices) x = x :=
  trans!{{Simplex.Carrier one}} _ _ _
    (congr!{IdentityAffine.Vertices {Simplex.Carrier one}} (\fun (v: IdentityAffine.Vertices) => IdentityAffine.apply v x) _ _ leftVertices)
    (AffineIdentity.law x);
\import singular_cohomology.Maps[A := Model.Carrier, B := Geometry.CarrierSet,
  source := Model.topology, target := productTopology] \as Evaluate;
\definition same(sigma: LeftSimplices.Carrier one):
  Evaluate.postcompose one (Evaluation.function sigma constant) (Evaluation.continuous sigma constant) (Affine.onTuple vertices) =
    LeftAxis.postcompose one first firstContinuous sigma :=
  ProductSimplices.ext one
    (Evaluate.postcompose one (Evaluation.function sigma constant) (Evaluation.continuous sigma constant) (Affine.onTuple vertices))
    (LeftAxis.postcompose one first firstContinuous sigma) (\fun (x: Simplex.Carrier one) =>
    congr2!{A B Geometry.CarrierSet} (Pairs.pair A B)
      (sigma (IdentityAffine.apply (Affine.leftVertices vertices) x)) (sigma x) rightPoint rightPoint
      (congr!{{Simplex.Carrier one} A} sigma _ _ (leftIdentity x)) (\refl(rightPoint)));
\definition onGenerators(sigma: LeftSimplices.Carrier one): Cross.apply (Left.generator one sigma) pointChain =
  #apply{(LeftAxis.At[n := one].push first firstContinuous)} (Left.generator one sigma) :=
  trans!{{ProductChains.Carrier one}} _ _ _ (Cross.onGenerators sigma constant)
    (trans!{{ProductChains.Carrier one}} _ _ _
      (congr!{{Tuples.Carrier two} {ProductChains.Carrier one}} (#apply{(Evaluation.evaluation sigma constant)} one) _ _ fundamental)
      (trans!{{ProductChains.Carrier one}} _ _ _ (Evaluation.onGenerator one sigma constant vertices)
        (trans!{{ProductChains.Carrier one}} _ _ _
          (congr!{{ProductSimplices.Carrier one} {ProductChains.Carrier one}} (ProductChains.generator one) _ _ (same sigma))
          (sym!{{ProductChains.Carrier one}} _ _ (LeftAxis.At[n := one].onGenerator first firstContinuous sigma)))));
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing].Bilinear[
  A := Cross.leftBundle, B := Cross.rightBundle, C := Cross.targetBundle] \as Bilinear;
\import Modules.Free[Generators := LeftSimplices.Carrier one].To[W := ProductChains.Carrier one, target := ProductChains.space one] \as Free;
\definition equality: Bilinear.leftAt Cross.bilinear pointChain = LeftAxis.At[n := one].push first firstContinuous :=
  Free.ext (Bilinear.leftAt Cross.bilinear pointChain) (LeftAxis.At[n := one].push first firstContinuous) onGenerators;
\definition law(x: Left.Carrier one): Cross.apply x pointChain = #apply{(LeftAxis.At[n := one].push first firstContinuous)} x :=
  congr!{{Modules.Hom[V := Left.Carrier one, W := ProductChains.Carrier one, source := Left.space one, target := ProductChains.space one].Map}
    {ProductChains.Carrier one}} (\fun (f: Modules.Hom[V := Left.Carrier one, W := ProductChains.Carrier one, source := Left.space one, target := ProductChains.space one].Map) => #apply{f} x) _ _ equality;
