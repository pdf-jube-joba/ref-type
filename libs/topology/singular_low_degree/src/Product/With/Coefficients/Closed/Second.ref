\import \root.Product[A := A, B := B, left := left, right := right, leftPoint := leftPoint, rightPoint := rightPoint].AxisRight[] \as AxisRight;
\definition onCycle: SecondPrimitive b -> \forall (y: Right.Carrier one) ->
  #apply{phi} (#apply{(RightAxis.At[n := one].push second secondContinuous)} (#apply{R.map} one y)) = #zero{coefficients.space} :=
  \fun (boundary: SecondPrimitive b)(y: Right.Carrier one) => trans!{coefficients.Carrier} _ _ _
    (congr!{{RightTheory.Carrier one} coefficients.Carrier}
      (\fun (f: RightTheory.Carrier one) => #apply{f} (#apply{R.map} one y)) _ _ boundary)
    (trans!{coefficients.Carrier} _ _ _
      (congr!{{Right.Carrier zero} coefficients.Carrier} (#apply{b}) _ _ (R.oneClosed y))
      (RightValues.zeroPreserved b));
\definition law: SecondPrimitive b -> \forall (x: Left.Carrier zero)(y: Right.Carrier one) ->
  #apply{(normalized phi)} (#apply{Current.Component[i := secondIndex].injection} (SecondTerm.tensor x y)) = #zero{coefficients.space} :=
  \fun (boundary: SecondPrimitive b)(x: Left.Carrier zero)(y: Right.Carrier one) => trans!{coefficients.Carrier} _ _ _ (secondFormula x y)
    (trans!{coefficients.Carrier} _ _ _
      (congr!{{Left.Carrier zero} coefficients.Carrier} (\fun (v: Left.Carrier zero) => #apply{phi} (SecondCross.apply v (#apply{R.map} one y))) _ _ (L.zeroValue x))
      (trans!{coefficients.Carrier} _ _ _
        (congr!{{ProductChains.Carrier one} coefficients.Carrier} (#apply{phi}) _ _ (#scaleLeft{SecondCross.bilinear} (#apply{Left.Augmentation[].map} x) AxisRight.pointChain (#apply{R.map} one y)))
        (trans!{coefficients.Carrier} _ _ _ (#scalar{phi} (#apply{Left.Augmentation[].map} x) (SecondCross.apply AxisRight.pointChain (#apply{R.map} one y)))
          (trans!{coefficients.Carrier} _ _ _
            (congr!{coefficients.Carrier coefficients.Carrier} (#smul{coefficients.space} (#apply{Left.Augmentation[].map} x)) _ _
              (trans!{coefficients.Carrier} _ _ _
                (congr!{{ProductChains.Carrier one} coefficients.Carrier} (#apply{phi}) _ _ (AxisRight.law (#apply{R.map} one y)))
                (onCycle boundary y)))
            (Values.scaleZero (#apply{Left.Augmentation[].map} x))))));
