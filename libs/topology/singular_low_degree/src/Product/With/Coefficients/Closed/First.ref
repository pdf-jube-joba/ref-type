\import \root.Product[A := A, B := B, left := left, right := right, leftPoint := leftPoint, rightPoint := rightPoint].AxisLeft[] \as AxisLeft;
\definition onCycle: FirstPrimitive a -> \forall (x: Left.Carrier one) ->
  #apply{phi} (#apply{(LeftAxis.At[n := one].push first firstContinuous)} (#apply{L.map} one x)) = #zero{coefficients.space} :=
  \fun (boundary: FirstPrimitive a)(x: Left.Carrier one) => trans!{coefficients.Carrier} _ _ _
    (congr!{{LeftTheory.Carrier one} coefficients.Carrier}
      (\fun (f: LeftTheory.Carrier one) => #apply{f} (#apply{L.map} one x)) _ _ boundary)
    (trans!{coefficients.Carrier} _ _ _
      (congr!{{Left.Carrier zero} coefficients.Carrier} (#apply{a}) _ _ (L.oneClosed x))
      (LeftValues.zeroPreserved a));
\definition law: FirstPrimitive a -> \forall (x: Left.Carrier one)(y: Right.Carrier zero) ->
  #apply{(normalized phi)} (#apply{Current.Component[i := firstIndex].injection} (FirstTerm.tensor x y)) = #zero{coefficients.space} :=
  \fun (boundary: FirstPrimitive a)(x: Left.Carrier one)(y: Right.Carrier zero) => trans!{coefficients.Carrier} _ _ _ (firstFormula x y)
    (trans!{coefficients.Carrier} _ _ _
      (congr!{{Right.Carrier zero} coefficients.Carrier} (\fun (v: Right.Carrier zero) => #apply{phi} (FirstCross.apply (#apply{L.map} one x) v)) _ _ (R.zeroValue y))
      (trans!{coefficients.Carrier} _ _ _
        (congr!{{ProductChains.Carrier one} coefficients.Carrier} (#apply{phi}) _ _ (#scaleRight{FirstCross.bilinear} (#apply{Right.Augmentation[].map} y) (#apply{L.map} one x) AxisLeft.pointChain))
        (trans!{coefficients.Carrier} _ _ _ (#scalar{phi} (#apply{Right.Augmentation[].map} y) (FirstCross.apply (#apply{L.map} one x) AxisLeft.pointChain))
          (trans!{coefficients.Carrier} _ _ _
            (congr!{coefficients.Carrier coefficients.Carrier} (#smul{coefficients.space} (#apply{Right.Augmentation[].map} y)) _ _
              (trans!{coefficients.Carrier} _ _ _
                (congr!{{ProductChains.Carrier one} coefficients.Carrier} (#apply{phi}) _ _ (AxisLeft.law (#apply{L.map} one x)))
                (onCycle boundary x)))
            (Values.scaleZero (#apply{Right.Augmentation[].map} y))))));
