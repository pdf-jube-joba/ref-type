\import \root.Product[A := A, B := B, left := left, right := right, leftPoint := leftPoint, rightPoint := rightPoint].AxisLeft[] \as AxisLeft;
\definition onCycle: FirstPrimitive a -> \forall (x: Left.Carrier one) ->
  (phi).apply ((LeftAxis.At[n := one].push first firstContinuous).apply ((L.map).apply one x)) = (coefficients.space).zero :=
  \fun (boundary: FirstPrimitive a)(x: Left.Carrier one) => trans!{coefficients.Carrier} _ _ _
    (congr!{{LeftTheory.Carrier one} coefficients.Carrier}
      (\fun (f: LeftTheory.Carrier one) => (f).apply ((L.map).apply one x)) _ _ boundary)
    (trans!{coefficients.Carrier} _ _ _
      (congr!{{Left.Carrier zero} coefficients.Carrier} ((a).apply) _ _ (L.oneClosed x))
      (LeftValues.zeroPreserved a));
\definition law: FirstPrimitive a -> \forall (x: Left.Carrier one)(y: Right.Carrier zero) ->
  (normalized phi).apply ((Current.Component[i := firstIndex].injection).apply (FirstTerm.tensor x y)) = (coefficients.space).zero :=
  \fun (boundary: FirstPrimitive a)(x: Left.Carrier one)(y: Right.Carrier zero) => trans!{coefficients.Carrier} _ _ _ (firstFormula x y)
    (trans!{coefficients.Carrier} _ _ _
      (congr!{{Right.Carrier zero} coefficients.Carrier} (\fun (v: Right.Carrier zero) => (phi).apply (FirstCross.apply ((L.map).apply one x) v)) _ _ (R.zeroValue y))
      (trans!{coefficients.Carrier} _ _ _
        (congr!{{ProductChains.Carrier one} coefficients.Carrier} ((phi).apply) _ _ ((FirstCross.bilinear).scaleRight ((Right.Augmentation[].map).apply y) ((L.map).apply one x) AxisLeft.pointChain))
        (trans!{coefficients.Carrier} _ _ _ ((phi).scalar ((Right.Augmentation[].map).apply y) (FirstCross.apply ((L.map).apply one x) AxisLeft.pointChain))
          (trans!{coefficients.Carrier} _ _ _
            (congr!{coefficients.Carrier coefficients.Carrier} ((coefficients.space).smul ((Right.Augmentation[].map).apply y)) _ _
              (trans!{coefficients.Carrier} _ _ _
                (congr!{{ProductChains.Carrier one} coefficients.Carrier} ((phi).apply) _ _ (AxisLeft.law ((L.map).apply one x)))
                (onCycle boundary x)))
            (Values.scaleZero ((Right.Augmentation[].map).apply y))))));
