\import \root.CoverAction[A := A, source := source].On[cover := cover] \as Actions;
\definition action: Actions.Mapping := \into[Actions.Data](Actions.Data {
  intersection := signedIntersectionMap, middle := middleMap, small := smallMap,
}, Actions.Mapping) \by {
  Actions.Laws[Actions.Data { intersection := signedIntersectionMap, middle := middleMap, small := smallMap }] {
    left := \fun (n: N.Nat^) => \parent.Degree[n := n].inclusionSquare,
    right := \fun (n: N.Nat^) => \parent.Degree[n := n].projectionSquare,
  }
};
