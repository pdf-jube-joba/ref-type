\use std.Logic[].Equality[].eq_reason_in;
\import Native.Map[C := RightChains.complex, D := LeftChains.complex].At[n := n] \as FromRight;
\import Native.Map[C := IntersectionChains.complex, D := LeftChains.complex].At[n := n] \as IntoLeft;
\import Native.Map[C := IntersectionChains.complex, D := RightChains.complex].At[n := n] \as IntoRight;
\import Modules.Hom[V := RightChains.Carrier n, W := LeftChains.Carrier n, source := RightChains.space n, target := LeftChains.space n] \as RightLinear;
\import Modules.Hom[V := IntersectionChains.Carrier n, W := LeftChains.Carrier n, source := IntersectionChains.space n, target := LeftChains.space n] \as LeftInclusion;
\import Modules.Hom[V := IntersectionChains.Carrier n, W := RightChains.Carrier n, source := IntersectionChains.space n, target := RightChains.space n] \as RightInclusion;
\import Modules.Laws[V := RightChains.Carrier n, space := RightChains.space n] \as RightLaws;
\import algebra.Group[].Of[Carrier := RightChains.Carrier n, group := RightLaws.additive] \as RightGroup;
\definition leftRoute: \forall (x: IntersectionChains.Carrier n) ->
  (rightMap).apply n ((Chains.rightMap).apply n x) = (Chains.leftMap).apply n ((intersectionMap).apply n x) :=
  \fun (x: IntersectionChains.Carrier n) => congr!{{Native.Map[C := IntersectionChains.complex, D := LeftChains.complex].Map} {LeftChains.Carrier n}}
    (\fun (f: Native.Map[C := IntersectionChains.complex, D := LeftChains.complex].Map) => (f).apply n x) _ _ leftRoutes;
\definition rightRoute: \forall (x: IntersectionChains.Carrier n) ->
  (leftMap).apply n ((Chains.leftMap).apply n x) = (Chains.rightMap).apply n ((intersectionMap).apply n x) :=
  \fun (x: IntersectionChains.Carrier n) => congr!{{Native.Map[C := IntersectionChains.complex, D := RightChains.complex].Map} {RightChains.Carrier n}}
    (\fun (f: Native.Map[C := IntersectionChains.complex, D := RightChains.complex].Map) => (f).apply n x) _ _ rightRoutes;
\definition inclusionSquare: \forall (x: IntersectionChains.Carrier n) ->
  (middleMap).apply n ((Chains.inclusion).apply n x) = (Chains.inclusion).apply n ((signedIntersectionMap).apply n x) :=
  \fun (x: IntersectionChains.Carrier n) => Sum.At[n := n].ext _ _
    (eq_reason_in!{{LeftChains.Carrier n} _
      "=" _ "by" { RightLinear.negativePreserved (FromRight.linear rightMap) ((Chains.rightMap).apply n x) }
      "=" _ "by" { congr!{{LeftChains.Carrier n} {LeftChains.Carrier n}} ((LeftChains.space n).neg) _ _ (leftRoute x) }
      "=" _ "by" { sym!{{LeftChains.Carrier n}} _ _ (LeftInclusion.negativePreserved (IntoLeft.linear Chains.leftMap) ((intersectionMap).apply n x)) }
    })
    (trans!{{RightChains.Carrier n}} _ _ _ (rightRoute x)
      (sym!{{RightChains.Carrier n}} _ _
        (trans!{{RightChains.Carrier n}} _ _ _
          (congr!{{RightChains.Carrier n} {RightChains.Carrier n}} ((RightChains.space n).neg) _ _
            (RightInclusion.negativePreserved (IntoRight.linear Chains.rightMap) ((intersectionMap).apply n x)))
          (RightGroup.negNeg ((Chains.rightMap).apply n ((intersectionMap).apply n x))))));
\import singular_cohomology.Simplices[A := Left, source := leftTopology] \as LeftSimplices;
\import singular_cohomology.Simplices[A := Right, source := rightTopology] \as RightSimplices;
\import Native.Map[C := Small.complex, D := Small.complex].At[n := n] \as SmallDegree;
\import Native.Map[C := LeftChains.complex, D := RightChains.complex].At[n := n] \as LeftDegree;
\import Native.Map[C := RightChains.complex, D := LeftChains.complex].At[n := n] \as RightDegree;
\import Modules.Hom[V := Small.Carrier n, W := Small.Carrier n, source := Small.space n, target := Small.space n].Composition[U := LeftChains.Carrier n, domain := LeftChains.space n] \as SmallAfterLeft;
\import Modules.Hom[V := RightChains.Carrier n, W := Small.Carrier n, source := RightChains.space n, target := Small.space n].Composition[U := LeftChains.Carrier n, domain := LeftChains.space n] \as RightAfterLeft;
\import Modules.Free[Generators := LeftSimplices.Carrier n].To[W := Small.Carrier n, target := Small.space n] \as FreeLeft;
\definition leftSmallEquation:
  SmallAfterLeft.compose (SmallDegree.linear smallMap) LeftSmall.At[n := n].map =
    RightAfterLeft.compose RightSmall.At[n := n].map (LeftDegree.linear leftMap) :=
  FreeLeft.ext _ _
    (\fun (sigma: LeftSimplices.Carrier n) => eq_reason_in!{{Small.Carrier n} _
      "=" _ "by" { congr!{{Small.Carrier n} {Small.Carrier n}} ((smallMap).apply n) _ _ (LeftSmall.At[n := n].onGenerator sigma) }
      "=" _ "by" { SmallMapping.At[n := n].onGenerator smallSimplicialMap (LeftSmall.At[n := n].simplex sigma) }
      "=" _ "by" { congr!{{SmallSimplices.Carrier n} {Small.Carrier n}} (Small.generator n) _ _
            (\axiom:funext(smallSimplex n (LeftSmall.At[n := n].simplex sigma), RightSmall.At[n := n].simplex (LeftMaps.postcompose n leftFunction leftContinuous sigma),
              \fun (x: Simplex.Carrier n) => \refl(function (sigma x)))) }
      "=" _ "by" { sym!{{Small.Carrier n}} _ _
            (trans!{{Small.Carrier n}} _ _ _
              (congr!{{RightChains.Carrier n} {Small.Carrier n}} ((RightSmall.At[n := n].map).apply) _ _
                (LeftMaps.At[n := n].onGenerator leftFunction leftContinuous sigma))
              (RightSmall.At[n := n].onGenerator (LeftMaps.postcompose n leftFunction leftContinuous sigma))) }
    });
\import Modules.Hom[V := Small.Carrier n, W := Small.Carrier n, source := Small.space n, target := Small.space n].Composition[U := RightChains.Carrier n, domain := RightChains.space n] \as SmallAfterRight;
\import Modules.Hom[V := LeftChains.Carrier n, W := Small.Carrier n, source := LeftChains.space n, target := Small.space n].Composition[U := RightChains.Carrier n, domain := RightChains.space n] \as LeftAfterRight;
\import Modules.Free[Generators := RightSimplices.Carrier n].To[W := Small.Carrier n, target := Small.space n] \as FreeRight;
\definition rightSmallEquation:
  SmallAfterRight.compose (SmallDegree.linear smallMap) RightSmall.At[n := n].map =
    LeftAfterRight.compose LeftSmall.At[n := n].map (RightDegree.linear rightMap) :=
  FreeRight.ext _ _
    (\fun (sigma: RightSimplices.Carrier n) => eq_reason_in!{{Small.Carrier n} _
      "=" _ "by" { congr!{{Small.Carrier n} {Small.Carrier n}} ((smallMap).apply n) _ _ (RightSmall.At[n := n].onGenerator sigma) }
      "=" _ "by" { SmallMapping.At[n := n].onGenerator smallSimplicialMap (RightSmall.At[n := n].simplex sigma) }
      "=" _ "by" { congr!{{SmallSimplices.Carrier n} {Small.Carrier n}} (Small.generator n) _ _
            (\axiom:funext(smallSimplex n (RightSmall.At[n := n].simplex sigma), LeftSmall.At[n := n].simplex (RightMaps.postcompose n rightFunction rightContinuous sigma),
              \fun (x: Simplex.Carrier n) => \refl(function (sigma x)))) }
      "=" _ "by" { sym!{{Small.Carrier n}} _ _
            (trans!{{Small.Carrier n}} _ _ _
              (congr!{{LeftChains.Carrier n} {Small.Carrier n}} ((LeftSmall.At[n := n].map).apply) _ _
                (RightMaps.At[n := n].onGenerator rightFunction rightContinuous sigma))
              (LeftSmall.At[n := n].onGenerator (RightMaps.postcompose n rightFunction rightContinuous sigma))) }
    });
\definition leftSmall: \forall (x: LeftChains.Carrier n) ->
  (smallMap).apply n ((LeftSmall.map).apply n x) = (RightSmall.map).apply n ((leftMap).apply n x) :=
  \fun (x: LeftChains.Carrier n) => congr!{{Modules.Hom[V := LeftChains.Carrier n, W := Small.Carrier n, source := LeftChains.space n, target := Small.space n].Map} {Small.Carrier n}}
    (\fun (f: Modules.Hom[V := LeftChains.Carrier n, W := Small.Carrier n, source := LeftChains.space n, target := Small.space n].Map) => (f).apply x) _ _ leftSmallEquation;
\definition rightSmall: \forall (x: RightChains.Carrier n) ->
  (smallMap).apply n ((RightSmall.map).apply n x) = (LeftSmall.map).apply n ((rightMap).apply n x) :=
  \fun (x: RightChains.Carrier n) => congr!{{Modules.Hom[V := RightChains.Carrier n, W := Small.Carrier n, source := RightChains.space n, target := Small.space n].Map} {Small.Carrier n}}
    (\fun (f: Modules.Hom[V := RightChains.Carrier n, W := Small.Carrier n, source := RightChains.space n, target := Small.space n].Map) => (f).apply x) _ _ rightSmallEquation;
\import Modules.Laws[V := Small.Carrier n, space := Small.space n] \as SmallLaws;
\import algebra.Group[].Of[Carrier := Small.Carrier n, group := SmallLaws.additive] \as SmallGroup;
\definition projectionSquare: \forall (x: Sum.Carrier n) ->
  (Chains.projection).apply n ((middleMap).apply n x) = (smallMap).apply n ((Chains.projection).apply n x) :=
  \fun (x: Sum.Carrier n) => eq_reason_in!{{Small.Carrier n} _
    "=" _ "by" { SmallGroup.comm ((LeftSmall.map).apply n ((rightMap).apply n (Sum.At[n := n].second x))) ((RightSmall.map).apply n ((leftMap).apply n (Sum.At[n := n].first x))) }
    "=" _ "by" { congr!{{Small.Carrier n} {Small.Carrier n} {Small.Carrier n}} ((Small.space n).add) _ _ _ _
        (sym!{{Small.Carrier n}} _ _ (leftSmall (Sum.At[n := n].first x)))
        (sym!{{Small.Carrier n}} _ _ (rightSmall (Sum.At[n := n].second x))) }
    "=" _ "by" { sym!{{Small.Carrier n}} _ _ ((smallMap).addition n ((LeftSmall.map).apply n (Sum.At[n := n].first x)) ((RightSmall.map).apply n (Sum.At[n := n].second x))) }
  };
