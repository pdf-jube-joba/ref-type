\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import std.Logic[].Proposition[] \as Logic;
\use Logic.either;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import algebraic_topology.Spheres[] \as Spheres;
\import Spheres.Zero[] \as Model;
\import Spheres.Antipodal[n := N.Nat^::zero] \as Antipodal;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\definition Sphere: \Set := Spheres.Carrier N.Nat^::zero;
\definition topology: topology.Topology[Carrier := Sphere].Topology := Spheres.topology N.Nat^::zero;
\definition north: Antipodal.apply Model.north = Model.south := Model.ext _ _
  (trans!{Real.Real} _ _ _ (Laws.fieldMulNegLeft Real.one Real.one)
    (congr!{Real.Real Real.Real} Real.neg _ _ (Laws.fieldMulOneLeft Real.one)));
\definition south: Antipodal.apply Model.south = Model.north := Model.ext _ _
  (trans!{Real.Real} _ _ _ (Laws.fieldMulNegBoth Real.one Real.one) (Laws.fieldMulOneLeft Real.one));
\module With(coefficients: Modules.Bundle);
