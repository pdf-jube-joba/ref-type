\module Cyclic(V: \Set, space: Modules.Space V, orientation: Modules.Isomorphism[V := I.Int^, W := V, source := Modules.scalarModule, target := space].Isomorphism,
  point: V, functional: Modules.Hom[V := V, W := I.Int^, source := space, target := Modules.scalarModule].Map);
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\module Functional(C: Chains.Complex, z: I.Int^, functional: Modules.Hom[V := C.family.Carrier z, W := I.Int^, source := C.family.space z, target := Modules.scalarModule].Map);
