\definition degree: I.Int^ := I.Int^::ofNat n;
\import Naturals.At[C := Source.complex, k := n] \as SourceH;
\import Naturals.At[C := Target.complex, k := n] \as TargetH;
\import Signed.At[C := IntegerSource.complex, z := degree] \as IntegerSourceH;
\import Signed.At[C := IntegerTarget.complex, z := degree] \as IntegerTargetH;
\import Naturals.Map[C := Source.complex, D := Target.complex].At[k := n] \as NaturalMap;
\import Signed.Map[C := IntegerSource.complex, D := IntegerTarget.complex].At[k := degree] \as IntegerMap;
\definition sourceComparison: _ := SourceComparison.Cohomology[n := n].isomorphism;
\definition targetComparison: _ := TargetComparison.Cohomology[n := n].isomorphism;
\definition leftCycle[h: IntegerSourceH.Closed]: TargetH.CycleCarrier :=
  TargetComparison.Cohomology[n := n].restrict ((IntegerMap.cyclesMap IntegerAction.map).apply h);
\definition rightCycle[h: IntegerSourceH.Closed]: TargetH.CycleCarrier :=
  (NaturalMap.cyclesMap NaturalAction.map).apply (SourceComparison.Cohomology[n := n].restrict h);
\definition cycles: \forall (h: IntegerSourceH.Closed) -> TargetH.ambient (leftCycle h) = TargetH.ambient (rightCycle h) :=
  \fun (h: IntegerSourceH.Closed) => Target.At[n := n].ext (TargetH.ambient (leftCycle h)) (TargetH.ambient (rightCycle h))
    (\fun (chain: C.family.Carrier n) => \refl((h).apply (Codomain.Positive[n := n].intro ((f).apply n chain))));
\definition onClass: \forall (h: IntegerSourceH.Closed) ->
  ((targetComparison).forward).apply ((IntegerMap.induced IntegerAction.map).apply (IntegerSourceH.classOf h)) =
    (NaturalMap.induced NaturalAction.map).apply (((sourceComparison).forward).apply (IntegerSourceH.classOf h)) :=
  \fun (h: IntegerSourceH.Closed) => trans!{TargetH.Cohomology} _ _ _
    (congr!{IntegerTargetH.Cohomology TargetH.Cohomology} (((targetComparison).forward).apply) _ _ (IntegerMap.onClass IntegerAction.map h))
    (trans!{TargetH.Cohomology} _ _ _
      (TargetComparison.Cohomology[n := n].onClass ((IntegerMap.cyclesMap IntegerAction.map).apply h))
      (trans!{TargetH.Cohomology} _ _ _
        (TargetH.equalClass (leftCycle h) (rightCycle h) (cycles h))
        (trans!{TargetH.Cohomology} _ _ _
          (sym!{TargetH.Cohomology} _ _ (NaturalMap.onClass NaturalAction.map (SourceComparison.Cohomology[n := n].restrict h)))
          (congr!{SourceH.Cohomology TargetH.Cohomology} ((NaturalMap.induced NaturalAction.map).apply) _ _
            (sym!{SourceH.Cohomology} _ _ (SourceComparison.Cohomology[n := n].onClass h))))));
\definition law: \forall (q: IntegerSourceH.Cohomology) ->
  ((targetComparison).forward).apply ((IntegerMap.induced IntegerAction.map).apply q) =
    (NaturalMap.induced NaturalAction.map).apply (((sourceComparison).forward).apply q) :=
  IntegerSourceH.classInduction (\fun (q: IntegerSourceH.Cohomology) =>
    ((targetComparison).forward).apply ((IntegerMap.induced IntegerAction.map).apply q) =
      (NaturalMap.induced NaturalAction.map).apply (((sourceComparison).forward).apply q)) onClass;
