\definition small: Modules.Bundle := Modules.Bundle { Carrier := Target.Carrier z, space := Target.space z };
\definition middle: Modules.Bundle := Modules.Bundle { Carrier := Middle.Carrier z, space := Middle.space z };
\import Modules.Hom[V := Middle.Carrier z, W := Target.Carrier z, source := Middle.space z, target := Target.space z] \as ProjectionMaps;
\definition projection: ProjectionMaps.Map := ProjectionMaps.Map {
  apply := (Projection.map).apply z, addition := (Projection.map).addition z, scalar := (Projection.map).scalar z,
};
\import Modules.SurjectiveDescent[A := middle, B := small, U := coefficients] \as Descent;
\definition injective: \forall (phi, psi: SmallHom.Carrier z) -> (inclusion).apply z phi = (inclusion).apply z psi -> phi = psi :=
  \fun (phi, psi: SmallHom.Carrier z)(equal: _) => SmallHom.At[z := z].ext phi psi \block {
    \fun (x: Target.Carrier z) \then
    \takefrom y: \Cast[Middle.Carrier z] ({ y: Middle.Carrier z \where (Projection.map).apply z y = x }) \by Sequence.sequence.onto z x \then
    \let lifted: (Projection.map).apply z y = x := \bysub(Middle.Carrier z, { y: Middle.Carrier z \where (Projection.map).apply z y = x }, y) \then
    \return trans!{coefficients.Carrier} _ _ _
      (sym!{coefficients.Carrier} _ _ (congr!{{Target.Carrier z} coefficients.Carrier} ((phi).apply) _ _ lifted))
      (trans!{coefficients.Carrier} _ _ _
        (congr!{{MiddleHom.Carrier z} coefficients.Carrier} (\fun (h: MiddleHom.Carrier z) => (h).apply y) _ _ equal)
        (congr!{{Target.Carrier z} coefficients.Carrier} ((psi).apply) _ _ lifted))
  };
\definition zero: \forall (phi: SmallHom.Carrier z) -> (restriction).apply z ((inclusion).apply z phi) = (IntersectionHom.space z).zero :=
  \fun (phi: SmallHom.Carrier z) => IntersectionHom.At[z := z].ext _ _
    (\fun (x: Intersection.Carrier z) => trans!{coefficients.Carrier} _ _ _
      (congr!{{Target.Carrier z} coefficients.Carrier} ((phi).apply) _ _ (Sequence.sequence.zero z x))
      (SmallHom.At[z := z].zeroPreserved phi));
\definition kills: \forall (phi: MiddleHom.Carrier z) -> (restriction).apply z phi = (IntersectionHom.space z).zero ->
  Descent.On[q := projection, f := phi].KillsKernel := \block {
  \fun (phi: MiddleHom.Carrier z)(vanishes: _)(x: Middle.Carrier z)(closed: (Projection.map).apply z x = (Target.space z).zero) \then
  \takefrom y: \Cast[Intersection.Carrier z] ({ y: Intersection.Carrier z \where (Inclusion.map).apply z y = x }) \by Sequence.sequence.kernelImage z x closed \then
  \return trans!{coefficients.Carrier} _ _ _
    (sym!{coefficients.Carrier} _ _ (congr!{{Middle.Carrier z} coefficients.Carrier} ((phi).apply) _ _
      (\bysub(Intersection.Carrier z, { y: Intersection.Carrier z \where (Inclusion.map).apply z y = x }, y))))
    (congr!{{IntersectionHom.Carrier z} coefficients.Carrier} (\fun (h: IntersectionHom.Carrier z) => (h).apply y) _ _ vanishes)
};
\definition kernelImage: \forall (phi: MiddleHom.Carrier z) -> (restriction).apply z phi = (IntersectionHom.space z).zero ->
  \exists ( psi: SmallHom.Carrier z \where (inclusion).apply z psi = phi ) := \block {
  \fun (phi: MiddleHom.Carrier z)(vanishes: _) \then
  \let psi: SmallHom.Carrier z := Descent.On[q := projection, f := phi].map (Sequence.sequence.onto z) (kills phi vanishes) \then
  \return Logic.existsIntro[SmallHom.Carrier z, { psi: SmallHom.Carrier z \where (inclusion).apply z psi = phi }] psi
    (MiddleHom.At[z := z].ext _ _ (Descent.On[q := projection, f := phi].onImage (Sequence.sequence.onto z) (kills phi vanishes)))
};
