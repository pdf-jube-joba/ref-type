\import Native.Map[C := IntersectionChains.complex, D := IntersectionChains.complex].ZeroExtension[f := (mapping).intersection] \as LeftAction;
\import Native.Map[C := Sum.complex, D := Sum.complex].ZeroExtension[f := (mapping).middle] \as MiddleAction;
\import Native.Map[C := Small.complex, D := Small.complex].ZeroExtension[f := (mapping).small] \as RightAction;
\import ChainSequence.Morphism[A1 := Intersection.complex, B1 := Middle.complex, C1 := Target.complex] \as Morphism;
\definition leftAction: Signed.Map[C := Intersection.complex, D := Intersection.complex].Map := LeftAction.map;
\definition middleAction: Signed.Map[C := Middle.complex, D := Middle.complex].Map := MiddleAction.map;
\definition rightAction: Signed.Map[C := Target.complex, D := Target.complex].Map := RightAction.map;
\import Morphism.Diagram[s := nativeSequence, t := nativeSequence, a := leftAction, b := middleAction, c := rightAction] \as Diagram;
\definition leftNative: \forall (n: N.Nat^)(chain: IntersectionChains.Carrier n) ->
  ((mapping).middle).apply n ((Chains.inclusion).apply n chain) = (Chains.inclusion).apply n (((mapping).intersection).apply n chain) := (mapping).left;
\definition rightNative: \forall (n: N.Nat^)(chain: Sum.Carrier n) ->
  (Chains.projection).apply n (((mapping).middle).apply n chain) = ((mapping).small).apply n ((Chains.projection).apply n chain) := (mapping).right;
\module Degree(n: N.Nat^);
\definition diagram: Diagram.Commutative := Diagram.Commutative {
  left := \induction (z: I.Int^) \return \forall (x: Intersection.Carrier z) ->
    (MiddleAction.map).apply z ((Inclusion.map).apply z x) = (Inclusion.map).apply z ((LeftAction.map).apply z x) \with {
    | ofNat: \fun (n: N.Nat^) => Degree[n := n].left
    | negSucc: \fun (n: N.Nat^)(x: Intersection.Carrier (I.Int^::negSucc n)) => \refl((Middle.space (I.Int^::negSucc n)).zero)
  },
  right := \induction (z: I.Int^) \return \forall (x: Middle.Carrier z) ->
    (Projection.map).apply z ((MiddleAction.map).apply z x) = (RightAction.map).apply z ((Projection.map).apply z x) \with {
    | ofNat: \fun (n: N.Nat^) => Degree[n := n].right
    | negSucc: \fun (n: N.Nat^)(x: Middle.Carrier (I.Int^::negSucc n)) => \refl((Target.space (I.Int^::negSucc n)).zero)
  },
};
\definition inclusionSquare: \forall (z: I.Int^)(chain: Intersection.Carrier z) ->
  (MiddleAction.map).apply z ((Inclusion.map).apply z chain) = (Inclusion.map).apply z ((LeftAction.map).apply z chain) := (diagram).left;
\definition projectionSquare: \forall (z: I.Int^)(chain: Middle.Carrier z) ->
  (Projection.map).apply z ((MiddleAction.map).apply z chain) = (RightAction.map).apply z ((Projection.map).apply z chain) := (diagram).right;
\module Coefficients(coefficients: Modules.Bundle);
