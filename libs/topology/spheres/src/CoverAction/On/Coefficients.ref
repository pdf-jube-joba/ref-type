\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import Hom.Integer[P := Target.complex, N := coefficients] \as SmallHom;
\import Hom.Integer[P := Middle.complex, N := coefficients] \as MiddleHom;
\import Hom.Integer[P := Intersection.complex, N := coefficients] \as IntersectionHom;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficient;
\import Hom.IntegerMapping[P := Middle.complex, Q := Target.complex, N := coefficients, L := coefficients].On[f := Projection.map, u := Coefficient.identity] \as Include;
\import Hom.IntegerMapping[P := Intersection.complex, Q := Middle.complex, N := coefficients, L := coefficients].On[f := Inclusion.map, u := Coefficient.identity] \as Restrict;
\definition inclusion: Cochains.Map[C := SmallHom.complex, D := MiddleHom.complex].Map := Include.map;
\definition restriction: Cochains.Map[C := MiddleHom.complex, D := IntersectionHom.complex].Map := Restrict.map;
\import Cochains.ShortExact[A := SmallHom.complex, B := MiddleHom.complex, C := IntersectionHom.complex] \as Exact;
\import Hom.Relative[subcomplex := IntersectionChains.complex, wholecomplex := Sum.complex].On[pair := Chains.pair, coefficients := coefficients] \as Relative;
\module Degree(z: I.Int^);
\definition sequence: Exact.Sequence := Exact.Sequence {
  inclusion := inclusion, projection := restriction,
  injective := \fun (z: I.Int^) => Degree[z := z].injective,
  onto := \fun (z: I.Int^) => Relative.PairSequence[].At[z := z].onto,
  zero := \fun (z: I.Int^) => Degree[z := z].zero,
  kernelImage := \fun (z: I.Int^) => Degree[z := z].kernelImage,
};
