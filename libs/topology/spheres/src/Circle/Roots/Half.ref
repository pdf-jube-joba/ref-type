\use std.Logic[].Equality[].eq_reason_in;
\definition vector: Complex.Complex := Operations.add Operations.one z;
\definition nonzero: Operations.NonZero vector :=
  \fun (same: vector = Operations.zero) => different
    (Group.cancelLeft Operations.one z (Operations.neg Operations.one)
      (trans!{Complex.Complex} _ _ _ same (sym!{Complex.Complex} _ _ (ComplexLaws.addNegRight Operations.one))));
\import \parent.Normalize[v := vector, nonzero := nonzero] \as Normalization;
\definition value: Carrier := Normalization.value;
\definition conjugateProduct: Operations.mul z (Operations.conj vector) = vector :=
  eq_reason_in!{Complex.Complex _
    "=" _ "by" { congr!{Complex.Complex Complex.Complex} (Operations.mul z) _ _
      (trans!{Complex.Complex} _ _ _ (ComplexLaws.conjAdd Operations.one z)
        (congr!{Complex.Complex Complex.Complex} (\fun (a: Complex.Complex) => Operations.add a (Operations.conj z)) _ _ (ComplexLaws.conjOfReal Real.one))) }
    "=" _ "by" { ComplexLaws.mulAddLeft z Operations.one (Operations.conj z) }
    "=" _ "by" { congr!{Complex.Complex Complex.Complex Complex.Complex} Operations.add _ _ _ _ (ComplexLaws.mulOneRight z)
          (trans!{Complex.Complex} _ _ _ (ComplexLaws.mulConjSelf z) (congr!{Real.Real Complex.Complex} Operations.ofReal _ _ (norm z))) }
    "=" _ "by" { ComplexLaws.addComm z Operations.one }
  };
\definition vectorSquare: Operations.mul vector vector = Operations.scale (Operations.normSq vector) z :=
  eq_reason_in!{Complex.Complex _
    "=" _ "by" { congr!{Complex.Complex Complex.Complex} (\fun (a: Complex.Complex) => Operations.mul a vector) _ _ (sym!{Complex.Complex} _ _ conjugateProduct) }
    "=" _ "by" { ComplexLaws.mulAssoc z (Operations.conj vector) vector }
    "=" _ "by" { congr!{Complex.Complex Complex.Complex} (Operations.mul z) _ _ (ComplexLaws.conjMulSelf vector) }
    "=" _ "by" { ComplexLaws.mulComm z (Operations.ofReal (Operations.normSq vector)) }
    "=" _ "by" { realTimes (Operations.normSq vector) z }
  };
\definition square: Operations.mul value value = z := Normalization.square z vectorSquare;
