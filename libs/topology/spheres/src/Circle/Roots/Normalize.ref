\use std.Logic[].Equality[].eq_reason_in;
\definition radius: Real.Real := Absolute.abs v;
\definition factor: Real.Real := Laws.fieldInv radius;
\definition radiusNonzero: Logic.Not (radius = Real.zero) :=
  \fun (same: radius = Real.zero) => nonzero (Absolute.zeroOfAbsZero v same);
\definition factorNorm: Real.mul (Real.mul factor factor) (Operations.normSq v) = Real.one :=
  eq_reason_in!{Real.Real _
    "=" _ "by" { congr!{Real.Real Real.Real} (Real.mul (Real.mul factor factor)) _ _ (sym!{Real.Real} _ _ (Absolute.square v)) }
    "=" _ "by" { RealAlgebra.mulFour factor factor radius radius }
    "=" _ "by" { congr!{Real.Real Real.Real Real.Real} Real.mul _ _ _ _ (Laws.fieldInverseNonzero radius radiusNonzero) (Laws.fieldInverseNonzero radius radiusNonzero) }
    "=" _ "by" { Laws.fieldMulOneLeft Real.one }
  };
\definition value: Carrier := \into[Complex.Complex](Operations.scale factor v, unit) \by {
  trans!{Real.Real} _ _ _ (normScale factor v) factorNorm
};
\definition square[w: Complex.Complex][equation: Operations.mul v v = Operations.scale (Operations.normSq v) w]: Operations.mul value value = w :=
  eq_reason_in!{Complex.Complex _
    "=" _ "by" { productScale factor v }
    "=" _ "by" { congr!{Complex.Complex Complex.Complex} (Operations.scale (Real.mul factor factor)) _ _ equation }
    "=" _ "by" { sym!{Complex.Complex} _ _ (scaleAssoc (Real.mul factor factor) (Operations.normSq v) w) }
    "=" _ "by" { congr!{Real.Real Complex.Complex} (\fun (a: Real.Real) => Operations.scale a w) _ _ factorNorm }
    "=" _ "by" { scaleOne w }
  };
