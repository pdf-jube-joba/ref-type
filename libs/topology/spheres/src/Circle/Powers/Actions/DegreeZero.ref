\use std.Logic[].Equality[].eq_reason_in;
\import singular_cohomology.Chains[A := Coordinates.Sphere, source := Coordinates.sphereTopology] \as Chains;
\import singular_cohomology.Simplices[A := Coordinates.Sphere, source := Coordinates.sphereTopology] \as Simplices;
\import singular_cohomology.Cochains[A := Coordinates.Sphere, source := Coordinates.sphereTopology].With[coefficients := coefficients] \as Cochains;
\import singular_cohomology.Zero[A := Coordinates.Sphere, source := Coordinates.sphereTopology].With[coefficients := coefficients] \as Zero;
\import Zero.Edges[] \as Edges;
\import algebraic_topology.Spheres[].Positive[n := N.Nat^::zero].Connected[] \as Connected;
\import singular_cohomology.Maps[A := Coordinates.Sphere, B := Coordinates.Sphere, source := Coordinates.sphereTopology, target := Coordinates.sphereTopology] \as Maps;
\import Maps.Coefficients[M := coefficients, L := coefficients] \as Pull;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficient;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := IntegerRing.ring] \as Complexes;
\import Complexes.At[C := Cochains.complex, k := N.Nat^::zero] \as H;
\import Complexes.Map[C := Cochains.complex, D := Cochains.complex].At[k := N.Nat^::zero] \as CohomologyMaps;
\definition pull[k: I.Int^]: Complexes.Map[C := Cochains.complex, D := Cochains.complex].Map := Pull.map (map k) (continuous k) Coefficient.identity;
\import Modules.Free[Generators := Simplices.Carrier N.Nat^::zero].To[W := coefficients.Carrier, target := coefficients.space] \as Free;
\definition cochain: \forall (k: I.Int^)(h: H.CycleCarrier) -> (pull k).apply N.Nat^::zero h = h :=
  \fun (k: I.Int^)(h: H.CycleCarrier) => Free.ext _ _
    (\fun (sigma: Simplices.Carrier N.Nat^::zero) => eq_reason_in!{coefficients.Carrier _
      "=" _ "by" { Pull.At[n := N.Nat^::zero].onCochain (map k) (continuous k) Coefficient.identity h sigma }
      "=" _ "by" { Zero.valueOnSimplex h (Maps.postcompose N.Nat^::zero (map k) (continuous k) sigma) }
      "=" _ "by" { Edges.constantOnPaths h (map k (Zero.point sigma)) (Zero.point sigma) (Connected.connected (map k (Zero.point sigma)) (Zero.point sigma)) }
      "=" _ "by" { sym!{coefficients.Carrier} _ _ (Zero.valueOnSimplex h sigma) }
    });
\definition law: \forall (k: I.Int^)(q: Cochains.cohomology N.Nat^::zero) ->
  (Pull.At[n := N.Nat^::zero].induced (map k) (continuous k) Coefficient.identity).apply q = q :=
  \fun (k: I.Int^) => H.classInduction (\fun (q: H.Cohomology) => (CohomologyMaps.induced (pull k)).apply q = q)
    (\fun (h: H.CycleCarrier) => trans!{H.Cohomology} _ _ _ (CohomologyMaps.onClass (pull k) h)
      (H.equalClass ((CohomologyMaps.cyclesMap (pull k)).apply h) h (cochain k h)));
