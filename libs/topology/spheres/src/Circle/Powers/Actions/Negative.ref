\use std.Logic[].Equality[].eq_reason_in;
\definition magnitude: N.Nat^ := N.Nat^::succ n;
\import Inversion.With[f := map (I.Int^::ofNat magnitude), fc := continuous (I.Int^::ofNat magnitude)] \as Inverse;
\definition functions: \forall (x: Coordinates.Sphere) -> Inverse.function x = map (I.Int^::negSucc n) x :=
  \fun (x: Coordinates.Sphere) => congr!{Circle.Carrier {Coordinates.Sphere}} Coordinates.backward _ _
    (congr!{Circle.Carrier Circle.Carrier} inverse _ _ (Coordinates.rightInverse (Powers.natural magnitude (Coordinates.forward x))));
\definition negativeInteger: (IntegerRing.ring).neg (I.Int^::ofNat magnitude) = I.Int^::negSucc n :=
  trans!{I.Int^} _ _ _
    (congr!{I.Int^ I.Int^} ((IntegerRing.ring).neg) _ _ (I.ofNatAsInteger magnitude))
    (sym!{I.Int^} _ _ (I.negSuccAsNegNatural n));
\definition law: \forall (q: Carrier) -> (action (I.Int^::negSucc n)).apply q = (space).smul (I.Int^::negSucc n) q :=
  \fun (q: Carrier) => eq_reason_in!{Carrier _
    "=" _ "by" { sym!{Carrier} _ _ (Groups.functionEquality Inverse.function (map (I.Int^::negSucc n)) Inverse.functionContinuous (continuous (I.Int^::negSucc n)) functions q) }
    "=" _ "by" { Inverse.action q }
    "=" _ "by" { congr!{Carrier Carrier} ((space).neg) _ _ (natural magnitude q) }
    "=" _ "by" { sym!{Carrier} _ _ (Values.negScalar (I.Int^::ofNat magnitude) q) }
    "=" _ "by" { congr!{I.Int^ Carrier} (\fun (a: I.Int^) => (space).smul a q) _ _ negativeInteger }
  };
