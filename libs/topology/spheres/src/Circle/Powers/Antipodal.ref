\import \parent.\parent.Antipodal[] \as Negative;
\import algebraic_topology.Spheres[].Antipodal[n := one] \as Antipodal;
\definition negatedSquare: \forall (z: Complex.Complex) -> Operations.mul (Operations.neg z) (Operations.neg z) = Operations.mul z z :=
  \fun (z: Complex.Complex) => ComplexLaws.ext _ _
    (congr2!{Real.Real Real.Real Real.Real} Real.sub _ _ _ _ (Laws.fieldMulNegBoth (Complex.re z) (Complex.re z)) (Laws.fieldMulNegBoth (Complex.im z) (Complex.im z)))
    (congr2!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ (Laws.fieldMulNegBoth (Complex.re z) (Complex.im z)) (Laws.fieldMulNegBoth (Complex.im z) (Complex.re z)));
\definition invariant: \forall (x: Coordinates.Sphere) -> square (Antipodal.apply x) = square x :=
  \fun (x: Coordinates.Sphere) => congr!{Carrier {Coordinates.Sphere}} Coordinates.backward _ _
    (trans!{Complex.Complex} _ _ _ (squareInCircle (Coordinates.forward (Antipodal.apply x)))
      (trans!{Complex.Complex} _ _ _
        (congr2!{Complex.Complex Complex.Complex Complex.Complex} Operations.mul _ _ _ _ (Negative.coordinates x) (Negative.coordinates x))
        (trans!{Complex.Complex} _ _ _ (negatedSquare (Coordinates.forward x)) (sym!{Complex.Complex} _ _ (squareInCircle (Coordinates.forward x))))));
\module Fibers;
