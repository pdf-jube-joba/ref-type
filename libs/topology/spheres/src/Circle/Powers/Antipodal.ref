\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Antipodal[] \as Negative;
\import algebraic_topology.Spheres[].Antipodal[n := one] \as Antipodal;
\definition negatedSquare: \forall (z: Complex.Complex) -> Operations.mul (Operations.neg z) (Operations.neg z) = Operations.mul z z :=
  \fun (z: Complex.Complex) => ComplexLaws.ext _ _
    (congr!{Real.Real Real.Real Real.Real} Real.sub _ _ _ _ (Laws.fieldMulNegBoth (Complex.re z) (Complex.re z)) (Laws.fieldMulNegBoth (Complex.im z) (Complex.im z)))
    (congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ (Laws.fieldMulNegBoth (Complex.re z) (Complex.im z)) (Laws.fieldMulNegBoth (Complex.im z) (Complex.re z)));
\definition invariant: \forall (x: Coordinates.Sphere) -> square (Antipodal.apply x) = square x :=
  \fun (x: Coordinates.Sphere) => congr!{Carrier {Coordinates.Sphere}} Coordinates.backward _ _
    (eq_reason_in!{Complex.Complex _
      "=" _ "by" { squareInCircle (Coordinates.forward (Antipodal.apply x)) }
      "=" _ "by" { congr!{Complex.Complex Complex.Complex Complex.Complex} Operations.mul _ _ _ _ (Negative.coordinates x) (Negative.coordinates x) }
      "=" _ "by" { negatedSquare (Coordinates.forward x) }
      "=" _ "by" { sym!{Complex.Complex} _ _ (squareInCircle (Coordinates.forward x)) }
    });
\module Fibers;
