\use std.Logic[].Equality[].eq_reason_in;
\import Complex.Algebra[] \as Algebra;
\import algebra.Group[].Of[Carrier := Complex.Complex, group := Algebra.additiveGroup] \as Group;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\definition negMul: \forall (z, w: Complex.Complex) -> Operations.mul (Operations.neg z) w = Operations.neg (Operations.mul z w) :=
  \fun (z, w: Complex.Complex) => Group.inverseUnique (Operations.mul z w) (Operations.mul (Operations.neg z) w)
    (eq_reason_in!{Complex.Complex _
      "=" _ "by" { sym!{Complex.Complex} _ _ (ComplexLaws.mulAddRight (Operations.neg z) z w) }
      "=" _ "by" { congr!{Complex.Complex Complex.Complex} (\fun (a: Complex.Complex) => Operations.mul a w) _ _ (ComplexLaws.addNegLeft z) }
      "=" _ "by" { ComplexLaws.mulZeroLeft w }
    });
\definition factor: \forall (z, w: Complex.Complex) ->
  Operations.mul (Operations.sub z w) (Operations.add z w) = Operations.sub (Operations.mul z z) (Operations.mul w w) :=
  \fun (z, w: Complex.Complex) => eq_reason_in!{Complex.Complex _
    "=" _ "by" { ComplexLaws.mulAddRight z (Operations.neg w) (Operations.add z w) }
    "=" _ "by" { congr!{Complex.Complex Complex.Complex Complex.Complex} Operations.add _ _ _ _
        (ComplexLaws.mulAddLeft z z w)
        (trans!{Complex.Complex} _ _ _ (ComplexLaws.mulAddLeft (Operations.neg w) z w)
          (congr!{Complex.Complex Complex.Complex Complex.Complex} Operations.add _ _ _ _ (negMul w z) (negMul w w))) }
    "=" _ "by" { congr!{Complex.Complex Complex.Complex} (Operations.add (Operations.add (Operations.mul z z) (Operations.mul z w))) _ _
          (ComplexLaws.addComm (Operations.neg (Operations.mul w z)) (Operations.neg (Operations.mul w w))) }
    "=" _ "by" { Group.four (Operations.mul z z) (Operations.mul z w) (Operations.neg (Operations.mul w w)) (Operations.neg (Operations.mul w z)) }
    "=" _ "by" { congr!{Complex.Complex Complex.Complex} (Operations.add (Operations.sub (Operations.mul z z) (Operations.mul w w))) _ _
              (trans!{Complex.Complex} _ _ _
                (congr!{Complex.Complex Complex.Complex} (\fun (a: Complex.Complex) => Operations.add (Operations.mul z w) (Operations.neg a)) _ _ (ComplexLaws.mulComm w z))
                (ComplexLaws.addNegRight (Operations.mul z w))) }
    "=" _ "by" { ComplexLaws.addZeroRight (Operations.sub (Operations.mul z z) (Operations.mul w w)) }
  };
\definition rightZero: \forall (z, w: Complex.Complex) -> Operations.NonZero z -> Operations.mul z w = Operations.zero -> w = Operations.zero :=
  \fun (z, w: Complex.Complex)(nonzero: _)(equal: _) => eq_reason_in!{Complex.Complex _
    "=" _ "by" { sym!{Complex.Complex} _ _ (ComplexLaws.mulOneLeft w) }
    "=" _ "by" { congr!{Complex.Complex Complex.Complex} (\fun (a: Complex.Complex) => Operations.mul a w) _ _ (sym!{Complex.Complex} _ _ (ComplexLaws.inverseNonzero z nonzero)) }
    "=" _ "by" { ComplexLaws.mulAssoc (Operations.inv z) z w }
    "=" _ "by" { congr!{Complex.Complex Complex.Complex} (Operations.mul (Operations.inv z)) _ _ equal }
    "=" _ "by" { ComplexLaws.mulZeroRight (Operations.inv z) }
  };
\definition sameSquare: \forall (z, w: Complex.Complex) -> Operations.mul z z = Operations.mul w w -> Logic.Or[z = w, z = Operations.neg w] :=
  \fun (z, w: Complex.Complex)(equal: _) => (Logic.orElim _ _ (Logic.Or[z = w, z = Operations.neg w]) ((Classical.excludedMiddle (Operations.sub z w = Operations.zero))) (\fun (same: _) => Logic.Or[_, _]::left (eq_reason_in!{Complex.Complex _
    "=" _ "by" { sym!{Complex.Complex} _ _ (Group.addDifference z w) }
    "=" _ "by" { congr!{Complex.Complex Complex.Complex} (\fun (a: Complex.Complex) => Operations.add a w) _ _ same }
    "=" _ "by" { ComplexLaws.addZeroLeft w }
  })) (\fun (different: _) => Logic.Or[_, _]::right (Group.inverseUnique w z
      (rightZero (Operations.sub z w) (Operations.add z w) different
        (eq_reason_in!{Complex.Complex _
          "=" _ "by" { factor z w }
          "=" _ "by" { congr!{Complex.Complex Complex.Complex} (\fun (a: Complex.Complex) => Operations.sub a (Operations.mul w w)) _ _ equal }
          "=" _ "by" { ComplexLaws.subSelf (Operations.mul w w) }
        })))));
\definition injective: \forall (x, y: Coordinates.Sphere) -> Coordinates.forward x = Coordinates.forward y -> x = y :=
  \fun (x, y: Coordinates.Sphere)(same: _) => eq_reason_in!{Coordinates.Sphere _
    "=" _ "by" { sym!{Coordinates.Sphere} _ _ (Coordinates.leftInverse x) }
    "=" _ "by" { congr!{Carrier {Coordinates.Sphere}} Coordinates.backward _ _ same }
    "=" _ "by" { Coordinates.leftInverse y }
  };
\definition law: \forall (x, y: Coordinates.Sphere) -> square x = square y -> Logic.Or[x = y, x = Antipodal.apply y] := \block {
  \fun (x, y: Coordinates.Sphere)(same: _) \then
  \let unitSquare: natural two (Coordinates.forward x) = natural two (Coordinates.forward y) :=
    eq_reason_in!{Carrier _
      "=" _ "by" { sym!{Carrier} _ _ (Coordinates.rightInverse (natural two (Coordinates.forward x))) }
      "=" _ "by" { congr!{{Coordinates.Sphere} Carrier} Coordinates.forward _ _ same }
      "=" _ "by" { Coordinates.rightInverse (natural two (Coordinates.forward y)) }
    } \then
  \let polynomial: Operations.mul (Coordinates.forward x) (Coordinates.forward x) = Operations.mul (Coordinates.forward y) (Coordinates.forward y) :=
    eq_reason_in!{Complex.Complex _
      "=" _ "by" { sym!{Complex.Complex} _ _ (squareInCircle (Coordinates.forward x)) }
      "=" _ "by" unitSquare
      "=" _ "by" { squareInCircle (Coordinates.forward y) }
    } \then
  \return (Logic.orElim _ _ (Logic.Or[x = y, x = Antipodal.apply y]) ((sameSquare (Coordinates.forward x) (Coordinates.forward y) polynomial)) (\fun (equal: _) => Logic.Or[_, _]::left (injective x y equal)) (\fun (equal: _) => Logic.Or[_, _]::right (injective x (Antipodal.apply y)
      (trans!{Complex.Complex} _ _ _ equal (sym!{Complex.Complex} _ _ (Negative.coordinates y))))))
};
