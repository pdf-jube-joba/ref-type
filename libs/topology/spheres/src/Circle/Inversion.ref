\import \parent.Coordinates[] \as Coordinates;
\import \parent.Product[] \as Product;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\definition Sphere: \Set := Coordinates.Sphere;
\definition sphereTopology: topology.Topology[Carrier := Sphere].Topology := Coordinates.sphereTopology;
\definition apply[x: Sphere]: Sphere := Coordinates.backward (inverse (Coordinates.forward x));
\import \parent.Functions[A := Sphere] \as Functions;
\import topology.Composition[A := Sphere, B := Carrier, C := Sphere] \as Composition;
\definition continuous: topology.Continuity[A := Sphere, B := Sphere].Continuous sphereTopology sphereTopology apply :=
  Composition.composeContinuous sphereTopology topology sphereTopology
    (\fun (x: Sphere) => inverse (Coordinates.forward x)) Coordinates.backward
    (Functions.inverseContinuous sphereTopology Coordinates.forward Coordinates.forwardContinuous) Coordinates.backwardContinuous;
\import singular_cohomology.Maps[A := Sphere, B := Sphere, source := sphereTopology, target := sphereTopology] \as Maps;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\module Coefficients(coefficients: Modules.Bundle);
