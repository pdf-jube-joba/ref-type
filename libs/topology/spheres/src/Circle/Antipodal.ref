\import \parent.Coordinates[] \as Coordinates;
\import algebraic_topology.Spheres[].Antipodal[n := one] \as Antipodal;
\definition minusOne: Carrier := \into[Complex.Complex](Operations.neg Operations.one, unit) \by {
  trans!{Real.Real} _ _ _
    (congr2!{Real.Real Real.Real Real.Real} Real.add _ _ _ _
      (trans!{Real.Real} _ _ _ (Laws.fieldMulNegBoth Real.one Real.one) (Laws.fieldMulOneLeft Real.one))
      (trans!{Real.Real} _ _ _ (Laws.fieldMulNegBoth Real.zero Real.zero) (Laws.fieldMulZeroLeft Real.zero)))
    (Laws.addZeroRight Real.one)
};
\definition multiplication: \forall (z: Complex.Complex) -> Operations.mul minusOne z = Operations.neg z :=
  \fun (z: Complex.Complex) => ComplexLaws.ext _ _
    (trans!{Real.Real} _ _ _
      (congr2!{Real.Real Real.Real Real.Real} Real.sub _ _ _ _
        (trans!{Real.Real} _ _ _ (Laws.fieldMulNegLeft Real.one (Complex.re z))
          (congr!{Real.Real Real.Real} Real.neg _ _ (Laws.fieldMulOneLeft (Complex.re z))))
        (trans!{Real.Real} _ _ _
          (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r (Complex.im z)) _ _ Laws.negZero)
          (Laws.fieldMulZeroLeft (Complex.im z))))
      (Laws.subZeroRight (Real.neg (Complex.re z))))
    (trans!{Real.Real} _ _ _
      (congr2!{Real.Real Real.Real Real.Real} Real.add _ _ _ _
        (trans!{Real.Real} _ _ _ (Laws.fieldMulNegLeft Real.one (Complex.im z))
          (congr!{Real.Real Real.Real} Real.neg _ _ (Laws.fieldMulOneLeft (Complex.im z))))
        (trans!{Real.Real} _ _ _
          (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r (Complex.re z)) _ _ Laws.negZero)
          (Laws.fieldMulZeroLeft (Complex.re z))))
      (Laws.addZeroRight (Real.neg (Complex.im z))));
\definition coordinates: \forall (x: Coordinates.Sphere) -> Coordinates.forward (Antipodal.apply x) = Operations.neg (Coordinates.forward x) :=
  \fun (x: Coordinates.Sphere) => ComplexLaws.ext _ _
    (trans!{Real.Real} _ _ _ (Laws.fieldMulNegLeft Real.one (x Coordinates.first))
      (congr!{Real.Real Real.Real} Real.neg _ _ (Laws.fieldMulOneLeft (x Coordinates.first))))
    (trans!{Real.Real} _ _ _ (Laws.fieldMulNegLeft Real.one (x Coordinates.second))
      (congr!{Real.Real Real.Real} Real.neg _ _ (Laws.fieldMulOneLeft (x Coordinates.second))));
\module Degree;
