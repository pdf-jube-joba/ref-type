\import Axes.With[leftPaths := paths, rightPaths := paths].Coefficients[coefficients := coefficients] \as Detection;
\definition law: \forall (q: SphereCohomology) -> (multiplication).apply q = (space).add ((firstPull).apply q) ((secondPull).apply q) :=
  \fun (q: SphereCohomology) => Detection.detectsEqual
    ((multiplication).apply q) ((space).add ((firstPull).apply q) ((secondPull).apply q))
    (trans!{SphereCohomology} _ _ _ (firstMultiplication q)
      (sym!{SphereCohomology} _ _
        (trans!{SphereCohomology} _ _ _ ((firstRestriction).addition ((firstPull).apply q) ((secondPull).apply q))
          (trans!{SphereCohomology} _ _ _
            (congr2!{SphereCohomology SphereCohomology SphereCohomology} ((sphereSpace).add) _ _ _ _ (firstFirst q) (firstSecond q))
            (SphereGroup.zeroRight q)))))
    (trans!{SphereCohomology} _ _ _ (secondMultiplication q)
      (sym!{SphereCohomology} _ _
        (trans!{SphereCohomology} _ _ _ ((secondRestriction).addition ((firstPull).apply q) ((secondPull).apply q))
          (trans!{SphereCohomology} _ _ _
            (congr2!{SphereCohomology SphereCohomology SphereCohomology} ((sphereSpace).add) _ _ _ _ (secondFirst q) (secondSecond q))
            (SphereGroup.zeroLeft q)))));
