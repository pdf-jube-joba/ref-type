\use std.Logic[].Equality[].eq_reason_in;
\import Axes.With[leftPaths := paths, rightPaths := paths].Coefficients[coefficients := coefficients] \as Detection;
\definition law: \forall (q: SphereCohomology) -> (multiplication).apply q = (space).add ((firstPull).apply q) ((secondPull).apply q) :=
  \fun (q: SphereCohomology) => Detection.detectsEqual
    ((multiplication).apply q) ((space).add ((firstPull).apply q) ((secondPull).apply q))
    (trans!{SphereCohomology} _ _ _ (firstMultiplication q)
      (sym!{SphereCohomology} _ _
        (eq_reason_in!{SphereCohomology _
          "=" _ "by" { (firstRestriction).addition ((firstPull).apply q) ((secondPull).apply q) }
          "=" _ "by" { congr!{SphereCohomology SphereCohomology SphereCohomology} ((sphereSpace).add) _ _ _ _ (firstFirst q) (firstSecond q) }
          "=" _ "by" { SphereGroup.zeroRight q }
        })))
    (trans!{SphereCohomology} _ _ _ (secondMultiplication q)
      (sym!{SphereCohomology} _ _
        (eq_reason_in!{SphereCohomology _
          "=" _ "by" { (secondRestriction).addition ((firstPull).apply q) ((secondPull).apply q) }
          "=" _ "by" { congr!{SphereCohomology SphereCohomology SphereCohomology} ((sphereSpace).add) _ _ _ _ (secondFirst q) (secondSecond q) }
          "=" _ "by" { SphereGroup.zeroLeft q }
        })));
