\use std.Logic[].Equality[].eq_reason_in;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import singular_cohomology.Chains[A := Spheres.Carrier n, source := Spheres.topology n] \as LowerChains;
\import singular_cohomology.Chains[A := Geometry.Intersection, source := Geometry.intersectionTopology] \as IntersectionChains;
\import Native.ZeroExtension[C := LowerChains.complex] \as Lower;
\import Native.ZeroExtension[C := IntersectionChains.complex] \as Intersection;
\import Hom.Integer[P := Lower.complex, N := coefficients] \as LowerHom;
\import Hom.Integer[P := Intersection.complex, N := coefficients] \as IntersectionHom;
\import singular_cohomology.Maps[A := Spheres.Carrier n, B := Geometry.Intersection, source := Spheres.topology n, target := Geometry.intersectionTopology] \as Inclusion;
\import singular_cohomology.Maps[A := Geometry.Intersection, B := Geometry.Intersection, source := Geometry.intersectionTopology, target := Geometry.intersectionTopology] \as IntersectionMaps;
\import singular_cohomology.Maps[A := Spheres.Carrier n, B := Spheres.Carrier n, source := Spheres.topology n, target := Spheres.topology n] \as LowerMaps;
\definition inclusion: Chains.Map[C := Lower.complex, D := Intersection.complex].Map := Inclusion.integerPush Equator.inclusion Equator.Topology[].inclusionContinuous;
\definition reflection: Chains.Map[C := Intersection.complex, D := Intersection.complex].Map := IntersectionMaps.integerPush Action.intersectionFunction Action.intersectionContinuous;
\definition antipodal: Chains.Map[C := Lower.complex, D := Lower.complex].Map := LowerMaps.integerPush LowerAntipodal.apply LowerAntipodal.continuous;
\import Chains.Map[C := Intersection.complex, D := Intersection.complex].Composition[B := Lower.complex] \as LeftComposition;
\import Chains.Map[C := Lower.complex, D := Intersection.complex].Composition[B := Lower.complex] \as RightComposition;
\import Inclusion.Composition[C := Geometry.Intersection, final := Geometry.intersectionTopology].Integer[] \as LeftFunctions;
\import LowerMaps.Composition[C := Geometry.Intersection, final := Geometry.intersectionTopology].Integer[] \as RightFunctions;
\import Inclusion.FunctionEquality[] \as EqualityOfFunctions;
\import topology.Composition[A := Spheres.Carrier n, B := Geometry.Intersection, C := Geometry.Intersection] \as LeftTopology;
\import topology.Composition[A := Spheres.Carrier n, B := Spheres.Carrier n, C := Geometry.Intersection] \as RightTopology;
\import Native.Map[C := LowerChains.complex, D := IntersectionChains.complex] \as NativeMaps;
\definition lift[f: NativeMaps.Map]: Chains.Map[C := Lower.complex, D := Intersection.complex].Map := NativeMaps.ZeroExtension[f := f].map;
\definition naturality: LeftComposition.compose reflection inclusion = RightComposition.compose inclusion antipodal :=
  eq_reason_in!{{Chains.Map[C := Lower.complex, D := Intersection.complex].Map} _
    "=" _ "by" { LeftFunctions.law Equator.inclusion Equator.Topology[].inclusionContinuous Action.intersectionFunction Action.intersectionContinuous }
    "=" _ "by" { congr!{NativeMaps.Map {Chains.Map[C := Lower.complex, D := Intersection.complex].Map}} lift _ _
        (EqualityOfFunctions.law (\fun (x: Spheres.Carrier n) => Action.intersectionFunction (Equator.inclusion x))
          (LeftTopology.composeContinuous (Spheres.topology n) Geometry.intersectionTopology Geometry.intersectionTopology Equator.inclusion Action.intersectionFunction Equator.Topology[].inclusionContinuous Action.intersectionContinuous)
          (\fun (x: Spheres.Carrier n) => Equator.inclusion (LowerAntipodal.apply x))
          (RightTopology.composeContinuous (Spheres.topology n) (Spheres.topology n) Geometry.intersectionTopology LowerAntipodal.apply Equator.inclusion LowerAntipodal.continuous Equator.Topology[].inclusionContinuous) equatorNatural) }
    "=" _ "by" { sym!{{Chains.Map[C := Lower.complex, D := Intersection.complex].Map}} _ _
        (RightFunctions.law LowerAntipodal.apply LowerAntipodal.continuous Equator.inclusion Equator.Topology[].inclusionContinuous) }
  };
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficient;
\import Hom.IntegerMapping[P := Lower.complex, Q := Intersection.complex, N := coefficients, L := coefficients] \as InclusionPull;
\import Hom.IntegerMapping[P := Intersection.complex, Q := Intersection.complex, N := coefficients, L := coefficients].On[f := reflection, u := Coefficient.identity] \as ReflectionPull;
\import Hom.IntegerMapping[P := Lower.complex, Q := Lower.complex, N := coefficients, L := coefficients].On[f := antipodal, u := Coefficient.identity] \as AntipodalPull;
\definition inclusionPull: Cochains.Map[C := IntersectionHom.complex, D := LowerHom.complex].Map := InclusionPull.On[f := inclusion, u := Coefficient.identity].map;
\module At(z: I.Int^);
\module Positive;
