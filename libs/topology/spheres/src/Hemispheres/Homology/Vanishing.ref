\use std.Logic[].Equality[].eq_reason_in;
\import singular_cohomology.Chains[A := Geometry.Left, source := Geometry.leftTopology].Reduced[] \as LeftReduced;
\import singular_cohomology.Chains[A := Geometry.Right, source := Geometry.rightTopology].Reduced[] \as RightReduced;
\import Native.ZeroExtension[C := LeftChains.complex] \as LeftExtension;
\import Native.ZeroExtension[C := RightChains.complex] \as RightExtension;
\import SignedChains.At[C := LeftExtension.complex, z := upperDegree] \as LeftH;
\import SignedChains.At[C := RightExtension.complex, z := upperDegree] \as RightH;
\import singular_cohomology.Calculations[A := Geometry.Left, source := Geometry.leftTopology].ReducedContractible[].Homology[z := upperDegree] \as LeftCalculation;
\import singular_cohomology.Calculations[A := Geometry.Right, source := Geometry.rightTopology].ReducedContractible[].Homology[z := upperDegree] \as RightCalculation;
\import Modules.Isomorphism[V := LeftReduced.At[z := upperDegree].Carrier, W := LeftH.Homology,
  source := LeftReduced.At[z := upperDegree].space, target := LeftH.homologySpace].Vanishing[] \as LeftVanishing;
\import Modules.Isomorphism[V := RightReduced.At[z := upperDegree].Carrier, W := RightH.Homology,
  source := RightReduced.At[z := upperDegree].space, target := RightH.homologySpace].Vanishing[] \as RightVanishing;
\definition leftZero: \forall (q: LeftH.Homology) -> q = (LeftH.homologySpace).zero :=
  LeftVanishing.targetZero LeftReduced.Positive[n := n].isomorphism (LeftCalculation.zero Cover.leftContraction);
\definition rightZero: \forall (q: RightH.Homology) -> q = (RightH.homologySpace).zero :=
  RightVanishing.targetZero RightReduced.Positive[n := n].isomorphism (RightCalculation.zero Cover.rightContraction);
\import Sum.Integer[].Homology[z := upperDegree] \as Split;
\import Modules.Biproduct[V := LeftH.Homology, W := RightH.Homology, left := LeftH.homologySpace, right := RightH.homologySpace] \as Pair;
\import std.Data[].Pair[].Prop[A := LeftH.Homology, B := RightH.Homology] \as Pairs;
\import Modules.Hom[V := Pair.Carrier, W := MiddleH.Homology, source := Pair.space, target := MiddleH.homologySpace] \as Backward;
\definition zero: \forall (q: MiddleH.Homology) -> q = (MiddleH.homologySpace).zero :=
  \fun (q: MiddleH.Homology) => eq_reason_in!{MiddleH.Homology _
    "=" _ "by" { sym!{MiddleH.Homology} _ _ (Split.leftInverse q) }
    "=" _ "by" { congr!{Pair.Carrier MiddleH.Homology} ((Split.backward).apply) _ _
        (Pairs.ext _ _ (leftZero (Pair.first ((Split.forward).apply q))) (rightZero (Pair.second ((Split.forward).apply q)))) }
    "=" _ "by" { Backward.zeroPreserved Split.backward }
  };
