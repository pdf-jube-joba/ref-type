\import FiniteTotal.Degree[n := n] \as Source;
\import HomTotal.Degree[n := n] \as Target;
\module Component(i: FiniteTotal.Index n) {
  \import Modules.Isomorphism[V := LeftHom.Carrier (i).first, W := Finite.Carrier (First.ranks (i).first),
    source := LeftHom.space (i).first, target := Finite.space (First.ranks (i).first)].Inverse[] \as ReverseLeft;
  \import Modules.Isomorphism[V := RightHom.Carrier (i).second, W := Finite.Carrier (Second.ranks (i).second),
    source := RightHom.space (i).second, target := Finite.space (Second.ranks (i).second)].Inverse[] \as ReverseRight;
  \import Modules.Tensor[V := Finite.Carrier (First.ranks (i).first), W := Finite.Carrier (Second.ranks (i).second),
    left := Finite.space (First.ranks (i).first), right := Finite.space (Second.ranks (i).second)].Mapping[
    U := LeftHom.Carrier (i).first, Z := RightHom.Carrier (i).second, targetLeft := LeftHom.space (i).first, targetRight := RightHom.space (i).second].Isomorphism[
    leftIso := ReverseLeft.inverse First.At[n := (i).first].isomorphism, rightIso := ReverseRight.inverse Second.At[n := (i).second].isomorphism] \as TensorIso;
  \definition isomorphism: Modules.Isomorphism[V := Source.family.Carrier i, W := Target.family.Carrier i,
    source := Source.family.space i, target := Target.family.space i].Isomorphism := TensorIso.isomorphism;
}
\import Dual.SumIsomorphism[Index := FiniteTotal.Index n, first := Source.family, second := Target.family,
  components := \fun (i: FiniteTotal.Index n) => Component[i := i].isomorphism] \as Sum;
\definition left[x: Source.Carrier]: (Backward.total).apply n ((Forward.total).apply n x) = x := (Sum.isomorphism).leftInverse x;
\definition right[x: Target.Carrier]: (Forward.total).apply n ((Backward.total).apply n x) = x := (Sum.isomorphism).rightInverse x;
