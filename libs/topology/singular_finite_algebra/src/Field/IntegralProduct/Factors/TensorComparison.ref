\import Tensor.TensorMapping[C := First.complex, D := LeftHom.complex, E := Second.complex, F := RightHom.complex].With[f := First.forward, g := Second.forward] \as Forward;
\import Tensor.TensorMapping[C := LeftHom.complex, D := First.complex, E := RightHom.complex, F := Second.complex].With[f := First.backward, g := Second.backward] \as Backward;
\module Degree(n: N.Nat^);
\import Dual.CochainIsomorphism[C := FiniteTotal.complex, D := HomTotal.complex, forward := Forward.total, backward := Backward.total,
  left := \fun (n: N.Nat^) => Degree[n := n].left, right := \fun (n: N.Nat^) => Degree[n := n].right] \as Comparison;
\module At(n: N.Nat^) {
  \import Cochains.At[C := FiniteTotal.complex, k := n] \as Source;
  \import Cochains.At[C := HomTotal.complex, k := n] \as Target;
  \definition isomorphism: Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology,
    source := Source.cohomologySpace, target := Target.cohomologySpace].Isomorphism := Comparison.At[n := n].isomorphism;
}
