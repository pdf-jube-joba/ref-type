\import HomologyTotal.Degree[n := n] \as FiniteDiagonal;
\module Component(i: HomologyTotal.Index n) {
  \import Cochains.At[C := Left.complex, k := (i).first] \as FiniteLeft;
  \import Cochains.At[C := Right.complex, k := (i).second] \as FiniteRight;
  \import Cochains.At[C := ActualLeft.complex, k := (i).first] \as Left;
  \import Cochains.At[C := ActualRight.complex, k := (i).second] \as Right;
  \import Modules.Tensor[V := Left.Cohomology, W := Right.Cohomology, left := Left.cohomologySpace, right := Right.cohomologySpace] \as ActualTensor;
  \definition Carrier: \Set := ActualTensor.Carrier;
  \definition space: Modules.Space Carrier := ActualTensor.space;
  \import Modules.Tensor[V := FiniteLeft.Cohomology, W := FiniteRight.Cohomology, left := FiniteLeft.cohomologySpace, right := FiniteRight.cohomologySpace].Mapping[
    U := Left.Cohomology, Z := Right.Cohomology, targetLeft := Left.cohomologySpace, targetRight := Right.cohomologySpace].Isomorphism[
    leftIso := LeftComparisons.With[e := firstComparison].At[n := (i).first].isomorphism,
    rightIso := RightComparisons.With[e := secondComparison].At[n := (i).second].isomorphism] \as Transport;
  \definition isomorphism: Modules.Isomorphism[V := FiniteDiagonal.family.Carrier i, W := Carrier,
    source := FiniteDiagonal.family.space i, target := space].Isomorphism := Transport.isomorphism;
}
\definition tensorFamily: Modules.Family[HomologyTotal.Index n] := Modules.Family[HomologyTotal.Index n] {
  Carrier := \fun (i: HomologyTotal.Index n) => Component[i := i].Carrier,
  space := \fun (i: HomologyTotal.Index n) => Component[i := i].space,
};
\import Modules.DirectSum[Index := HomologyTotal.Index n, family := tensorFamily] \as ActualDiagonal;
\definition tensorBundle: Modules.Bundle := ActualDiagonal.bundle;
\import singular_tensor_dual.Over[R := K, ring := commutativeRing].SumIsomorphism[
  Index := HomologyTotal.Index n, first := FiniteDiagonal.family, second := tensorFamily,
  components := \fun (i: HomologyTotal.Index n) => Component[i := i].isomorphism] \as Transport;
\import \parent.\parent.At[n := n] \as Finite;
\import Cochains.At[C := Singular.complex, k := n] \as Actual;
\import Modules.Isomorphism[V := ActualDiagonal.Carrier, W := FiniteDiagonal.Carrier,
  source := ActualDiagonal.space, target := FiniteDiagonal.space].Composition[
  U := Actual.Cohomology, final := Actual.cohomologySpace] \as Compose;
\import Modules.Isomorphism[V := FiniteDiagonal.Carrier, W := ActualDiagonal.Carrier,
  source := FiniteDiagonal.space, target := ActualDiagonal.space].Inverse[] \as Reverse;
\definition kunneth: Modules.Isomorphism[V := tensorBundle.Carrier, W := Actual.Cohomology,
  source := tensorBundle.space, target := Actual.cohomologySpace].Isomorphism :=
  Compose.compose Finite.kunneth (Reverse.inverse Transport.isomorphism);
