\import Cochains.At[C := Total.complex, k := n] \as Model;
\import Cochains.At[C := Singular.complex, k := n] \as Actual;
\import Comparisons.With[e := comparison].At[n := n] \as Compared;
\import Formula.Canonical[n := n] \as Finite;
\import HomologyTotal.Degree[n := n] \as Diagonal;
\import Modules.Isomorphism[V := Diagonal.Carrier, W := Model.Cohomology,
  source := Diagonal.space, target := Model.cohomologySpace].Composition[
  U := Actual.Cohomology, final := Actual.cohomologySpace] \as Compose;
\definition kunneth: Modules.Isomorphism[V := Diagonal.Carrier, W := Actual.Cohomology,
  source := Diagonal.space, target := Actual.cohomologySpace].Isomorphism :=
  Compose.compose Compared.isomorphism Finite.isomorphism;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\definition exteriorOnInjection: \forall (i: HomologyTotal.Index n)(x: Diagonal.family.Carrier i) ->
  #apply{#forward{kunneth}} (#apply{Diagonal.Component[i := i].injection} x) =
    #apply{#forward{Compared.isomorphism}} (#apply{Finite.components i} x) :=
  \fun (i: HomologyTotal.Index n)(x: Diagonal.family.Carrier i) =>
    congr!{Model.Cohomology Actual.Cohomology} (#apply{#forward{Compared.isomorphism}}) _ _ (Finite.onInjection i x);
