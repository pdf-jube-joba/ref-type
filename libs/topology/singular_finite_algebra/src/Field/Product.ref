\import topological_constructions.Product[A := X, B := Y] \as Geometry;
\definition coefficients: Modules.Bundle := Modules.Bundle { Carrier := K, space := Modules.scalarModule };
\import singular_cohomology.Cochains[A := Geometry.CarrierSet, source := Geometry.topology left right].OverRing[
  R := K, ring := commutativeRing].With[coefficients := coefficients] \as Singular;
\import Finite.Of[C := first] \as Left;
\import Finite.Of[C := second] \as Right;
\import Tensor.Tensor[C := Left.complex, D := Right.complex] \as Product;
\import Tensor.Total[C := Product.complex] \as Total;
\import Kunneth.Of[C := first, D := second] \as Formula;
\import Cochains.ZeroDifferential[family := Left.homologyFamily] \as LeftHomology;
\import Cochains.ZeroDifferential[family := Right.homologyFamily] \as RightHomology;
\import Tensor.Tensor[C := LeftHomology.complex, D := RightHomology.complex] \as HomologyTensor;
\import Tensor.Total[C := HomologyTensor.complex] \as HomologyTotal;
\import chain_complexes.CochainEquivalence[].Over[R := K, ring := ring].Of[C := Total.complex, D := Singular.complex] \as Comparisons;
\definition Comparison: \Set := Comparisons.Equivalence;
\module Compared(comparison: Comparison);
