\import Modules.Of[V := coefficients.Carrier, space := coefficients.space].Submodule[] \as Submodules;
\import Submodules.Kernel[W := coefficients.Carrier, target := coefficients.space] \as Kernels;
\definition kernel: Submodules.Submodule := Kernels.kernel double;
\import Submodules.Of[S := kernel] \as KernelSpace;
\definition KernelCarrier: \Set := KernelSpace.Carrier;
\definition kernelSpace: Modules.Space KernelCarrier := KernelSpace.moduleSpace;
\import Submodules.Image[U := coefficients.Carrier, source := coefficients.space] \as Images;
\definition image: Submodules.Submodule := Images.image double;
\import Submodules.Quotient[S := image] \as Quotient;
\definition CokernelCarrier: \Set := Quotient.Carrier;
\definition cokernelSpace: Modules.Space CokernelCarrier := Quotient.moduleSpace;
\definition relativeClass(x: coefficients.Carrier): CokernelCarrier := Quotient.class x;
\module Kernel;
\module Cokernel;
