\import Modules.RightExact[A := coefficients, B := coefficients, C := second] \as RightExact;
\definition sequence: RightExact.Sequence := RightExact.Sequence {
  inclusion := double, projection := data.relative, onto := #onto{data},
  zero := \fun (x: coefficients.Carrier) => trans!{second.Carrier} _ _ _
    (congr!{coefficients.Carrier second.Carrier} (#apply{data.relative}) _ _ (sym!{coefficients.Carrier} _ _ (#doubling{data} x)))
    (#zero{#exactAtSecond{data}} x),
  kernelImage := \block {
    \fun (y: coefficients.Carrier)(killed: _) \then
    \takefrom x: \Cast[coefficients.Carrier] ({ x: coefficients.Carrier \where #apply{data.connecting} x = y }) \by
      #kernelImage{#exactAtSecond{data}} y killed \then
    \return Logic.existsIntro[coefficients.Carrier, { x: coefficients.Carrier \where #apply{double} x = y }] x
      (trans!{coefficients.Carrier} _ _ _ (sym!{coefficients.Carrier} _ _ (#doubling{data} x))
        (\bysub(coefficients.Carrier, { x: coefficients.Carrier \where #apply{data.connecting} x = y }, x)))
  },
};
\import RightExact.Cokernel[sequence := sequence] \as Comparison;
\definition isomorphism: Modules.Isomorphism[V := CokernelCarrier, W := second.Carrier, source := cokernelSpace, target := second.space].Isomorphism :=
  Comparison.isomorphism;
\definition onRelativeClass: \forall (x: coefficients.Carrier) ->
  #apply{#forward{isomorphism}} (relativeClass x) = #apply{data.relative} x := Comparison.onClass;
