\import Modules.Hom[V := V.Carrier, W := coefficients.Carrier,
  source := V.space, target := coefficients.space].Composition[U := W.Carrier, domain := W.space] \as ForwardComposition;
\import Modules.Hom[V := W.Carrier, W := coefficients.Carrier,
  source := W.space, target := coefficients.space].Composition[U := V.Carrier, domain := V.space] \as BackwardComposition;
\definition apply[phi: Source.Carrier]: Target.Carrier := ForwardComposition.compose phi (e).backward;
\definition unapply[phi: Target.Carrier]: Source.Carrier := BackwardComposition.compose phi (e).forward;
\import Modules.Hom[V := Source.Carrier, W := Target.Carrier,
  source := Source.space, target := Target.space] \as Forward;
\definition forward: Forward.Map := Forward.Map {
  apply := apply,
  addition := \fun (phi, psi: Source.Carrier) => TargetMaps.ext
    (apply ((Source.space).add phi psi)) ((Target.space).add (apply phi) (apply psi))
    (\fun (x: W.Carrier) => \refl((coefficients.space).add ((phi).apply (((e).backward).apply x)) ((psi).apply (((e).backward).apply x)))),
  scalar := \fun (a: I.Int^)(phi: Source.Carrier) => TargetMaps.ext
    (apply ((Source.space).smul a phi)) ((Target.space).smul a (apply phi))
    (\fun (x: W.Carrier) => \refl((coefficients.space).smul a ((phi).apply (((e).backward).apply x)))),
};
\import Modules.Hom[V := Target.Carrier, W := Source.Carrier,
  source := Target.space, target := Source.space] \as Backward;
\definition backward: Backward.Map := Backward.Map {
  apply := unapply,
  addition := \fun (phi, psi: Target.Carrier) => SourceMaps.ext
    (unapply ((Target.space).add phi psi)) ((Source.space).add (unapply phi) (unapply psi))
    (\fun (x: V.Carrier) => \refl((coefficients.space).add ((phi).apply (((e).forward).apply x)) ((psi).apply (((e).forward).apply x)))),
  scalar := \fun (a: I.Int^)(phi: Target.Carrier) => SourceMaps.ext
    (unapply ((Target.space).smul a phi)) ((Source.space).smul a (unapply phi))
    (\fun (x: V.Carrier) => \refl((coefficients.space).smul a ((phi).apply (((e).forward).apply x)))),
};
\definition leftInverse[phi: Source.Carrier]: (backward).apply ((forward).apply phi) = phi :=
  SourceMaps.ext ((backward).apply ((forward).apply phi)) phi
    (\fun (x: V.Carrier) => congr!{V.Carrier coefficients.Carrier} ((phi).apply)
      (((e).backward).apply (((e).forward).apply x)) x ((e).leftInverse x));
\definition rightInverse[phi: Target.Carrier]: (forward).apply ((backward).apply phi) = phi :=
  TargetMaps.ext ((forward).apply ((backward).apply phi)) phi
    (\fun (x: W.Carrier) => congr!{W.Carrier coefficients.Carrier} ((phi).apply)
      (((e).forward).apply (((e).backward).apply x)) x ((e).rightInverse x));
\import Modules.Isomorphism[V := Source.Carrier, W := Target.Carrier,
  source := Source.space, target := Target.space] \as Comparison;
\definition isomorphism: Comparison.Isomorphism := Comparison.Isomorphism {
  forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
};
\definition evaluation[phi: Source.Carrier][x: W.Carrier]:
  (((isomorphism).forward).apply phi).apply x = (phi).apply (((e).backward).apply x) :=
  \refl((phi).apply (((e).backward).apply x));
\definition inverseEvaluation[phi: Target.Carrier][x: V.Carrier]:
  (((isomorphism).backward).apply phi).apply x = (phi).apply (((e).forward).apply x) :=
  \refl((phi).apply (((e).forward).apply x));
