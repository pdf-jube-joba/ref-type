\import singular_cellular_algebra.Algebra[].AbsoluteHomeomorphism[A := A, B := B,
  source := source, target := target, homeomorphism := homeomorphism] \as Actual;
\import SignedChains.Isomorphism[C := SourceExtension.complex, D := TargetExtension.complex].At[z := z] \as ActualHomology;
\definition actual: Modules.Isomorphism[V := SourceCarrier, W := TargetCarrier, source := sourceSpace, target := targetSpace].Isomorphism :=
  ActualHomology.isomorphism Actual.isomorphism;
\import SourceOrientations.Composition[U := TargetCarrier, final := targetSpace] \as ForwardCoordinates;
\import Modules.Isomorphism[V := I.Int^, W := TargetCarrier, source := Modules.scalarModule, target := targetSpace]
  .Composition[U := I.Int^, final := Modules.scalarModule] \as BackCoordinates;
\definition coordinates: Modules.Isomorphism[V := I.Int^, W := I.Int^, source := Modules.scalarModule, target := Modules.scalarModule].Isomorphism :=
  BackCoordinates.compose (TargetOrientations.Inverse[].inverse targetOrientation)
    (ForwardCoordinates.compose actual sourceOrientation);
\definition sourceGenerator: SourceCarrier := #apply{#forward{sourceOrientation}} I.One.specification;
\definition targetGenerator: TargetCarrier := #apply{#forward{targetOrientation}} I.One.specification;
\definition Positive(h: Homeomorphisms.Homeomorphism[source, target]): \Prop :=
  #apply{(action h)} sourceGenerator = targetGenerator;
\definition Result: \Set := \Cast[Homeomorphisms.Homeomorphism[source, target]] Positive;
\import Modules.Hom[V := I.Int^, W := TargetCarrier, source := Modules.scalarModule, target := targetSpace] \as TargetLinear;
\import Modules.Laws[V := TargetCarrier, space := targetSpace] \as TargetLaws;
\import algebra.Group[].Of[Carrier := TargetCarrier, group := TargetLaws.additive] \as TargetGroup;
\definition reconstruct: #apply{(action homeomorphism)} sourceGenerator =
  #apply{#forward{targetOrientation}} (#apply{#forward{coordinates}} I.One.specification) :=
  sym!{TargetCarrier} _ _ (#rightInverse{targetOrientation} (#apply{(action homeomorphism)} sourceGenerator));
\definition positive(same: #apply{#forward{coordinates}} I.One.specification = I.One.specification): Positive homeomorphism :=
  trans!{TargetCarrier} _ _ _ reconstruct
    (congr!{I.Int^ TargetCarrier} (#apply{#forward{targetOrientation}}) _ _ same);
\definition negative(same: #apply{#forward{coordinates}} I.One.specification = std.Arithmetic[].IntAlgebra[].Calculation[].neg I.One.specification):
  #apply{(action homeomorphism)} sourceGenerator = TargetLaws.neg targetGenerator :=
  trans!{TargetCarrier} _ _ _ reconstruct
    (trans!{TargetCarrier} _ _ _
      (congr!{I.Int^ TargetCarrier} (#apply{#forward{targetOrientation}}) _ _ same)
      (TargetLinear.negativePreserved #forward{targetOrientation} I.One.specification));
\import Homeomorphisms.Composition[C := B] \as ComposeHomeomorphisms;
\definition corrected: Homeomorphisms.Homeomorphism[source, target] :=
  ComposeHomeomorphisms.compose source target target homeomorphism reflection;
\import Maps.Composition[C := B, final := target] \as ComposeMaps;
\import SignedChains.Map[C := TargetExtension.complex, D := TargetExtension.complex].Composition[B := SourceExtension.complex] \as ComposeChains;
\definition composition(q: SourceCarrier): #apply{(action corrected)} q =
  #apply{(endAction reflection)} (#apply{(action homeomorphism)} q) :=
  trans!{TargetCarrier} _ _ _
    (congr!{{SignedChains.Map[C := SourceExtension.complex, D := TargetExtension.complex].Map} TargetCarrier}
      (\fun (f: SignedChains.Map[C := SourceExtension.complex, D := TargetExtension.complex].Map) => #apply{(Induced.induced f)} q) _ _
      (sym!{{SignedChains.Map[C := SourceExtension.complex, D := TargetExtension.complex].Map}} _ _
        (ComposeMaps.Integer[].law (#forward{homeomorphism}) (#forwardContinuous{(Homeomorphisms.laws source target homeomorphism)})
          (#forward{reflection}) (#forwardContinuous{(Reflections.laws target target reflection)}))))
    (ComposeChains.At[k := z].compositionOnHomology
      (EndMaps.integerPush (#forward{reflection}) (#forwardContinuous{(Reflections.laws target target reflection)}))
      (Maps.integerPush (#forward{homeomorphism}) (#forwardContinuous{(Homeomorphisms.laws source target homeomorphism)})) q);
\definition correctedPositive:
  (\forall (q: TargetCarrier) -> #apply{(endAction reflection)} q = TargetLaws.neg q) ->
  #apply{#forward{coordinates}} I.One.specification = std.Arithmetic[].IntAlgebra[].Calculation[].neg I.One.specification -> Positive corrected :=
  \fun (negativeAction: _)(same: _) => trans!{TargetCarrier} _ _ _ (composition sourceGenerator)
    (trans!{TargetCarrier} _ _ _ (negativeAction (#apply{(action homeomorphism)} sourceGenerator))
      (trans!{TargetCarrier} _ _ _ (congr!{TargetCarrier TargetCarrier} TargetLaws.neg _ _ (negative same))
        (TargetGroup.negNeg targetGenerator)));
\definition existence:
  (\forall (q: TargetCarrier) -> #apply{(endAction reflection)} q = TargetLaws.neg q) ->
  \exists Result :=
  \fun (negativeAction: _) => Logic.orElim
    (#apply{#forward{coordinates}} I.One.specification = I.One.specification)
    (#apply{#forward{coordinates}} I.One.specification = std.Arithmetic[].IntAlgebra[].Calculation[].neg I.One.specification)
    (\exists Result)
    (\parent.\parent.Units[].automorphism coordinates)
    (\fun (same: _) => \exact(\into[Homeomorphisms.Homeomorphism[source, target]](homeomorphism, Positive) \by { positive same }, Result))
    (\fun (same: _) => \exact(\into[Homeomorphisms.Homeomorphism[source, target]](corrected, Positive) \by { correctedPositive negativeAction same }, Result));
