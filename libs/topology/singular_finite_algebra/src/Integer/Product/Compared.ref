\module At(z: I.Int^);

\import homological_algebra.Finite[].Bounded[].Of[C := first] \as FirstModel;
\import homological_algebra.Finite[].Bounded[].Of[C := second] \as SecondModel;
\import singular_cohomology.Chains[A := X, source := left] \as ActualFirst;
\import singular_cohomology.Chains[A := Y, source := right] \as ActualSecond;
\import Chains.Equivalence[C := FirstModel.chain, D := ActualFirst.integerComplex] \as FirstComparisons;
\import Chains.Equivalence[C := SecondModel.chain, D := ActualSecond.integerComplex] \as SecondComparisons;
\module Factors(firstComparison: FirstComparisons.Equivalence, secondComparison: SecondComparisons.Equivalence);
