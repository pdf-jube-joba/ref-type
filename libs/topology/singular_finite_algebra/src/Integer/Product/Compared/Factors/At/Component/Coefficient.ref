\import derived_functors.Tor[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Tor;
\import Tor.Of[M := finiteFirst, N := finiteSecond, P := Presentation.complex] \as Source;
\import Tor.Of[M := finiteFirst, N := actualSecond, P := Presentation.complex] \as Target;
\import Tor.Second[M := finiteFirst, N := finiteSecond, L := actualSecond, P := Presentation.complex].Positive[n := N.Nat^::zero] \as Forward;
\import Tor.Second[M := finiteFirst, N := actualSecond, L := finiteSecond, P := Presentation.complex].Positive[n := N.Nat^::zero] \as Backward;
\import Tor.Second[M := finiteFirst, N := finiteSecond, L := finiteSecond, P := Presentation.complex].Positive[n := N.Nat^::zero] \as SourceAction;
\import Tor.Second[M := finiteFirst, N := actualSecond, L := actualSecond, P := Presentation.complex].Positive[n := N.Nat^::zero] \as TargetAction;
\import Tor.SecondComposition[M := finiteFirst, N := finiteSecond, L := actualSecond, T := finiteSecond, P := Presentation.complex].Positive[n := N.Nat^::zero] \as Left;
\import Tor.SecondComposition[M := finiteFirst, N := actualSecond, L := finiteSecond, T := actualSecond, P := Presentation.complex].Positive[n := N.Nat^::zero] \as Right;
\import Tor.SecondIdentity[M := finiteFirst, N := finiteSecond, P := Presentation.complex].Positive[n := N.Nat^::zero] \as SourceIdentity;
\import Tor.SecondIdentity[M := finiteFirst, N := actualSecond, P := Presentation.complex].Positive[n := N.Nat^::zero] \as TargetIdentity;
\import Modules.Hom[V := actualSecond.Carrier, W := finiteSecond.Carrier, source := actualSecond.space, target := finiteSecond.space].Composition[U := finiteSecond.Carrier, domain := finiteSecond.space] \as LeftCompose;
\import Modules.Hom[V := finiteSecond.Carrier, W := actualSecond.Carrier, source := finiteSecond.space, target := actualSecond.space].Composition[U := actualSecond.Carrier, domain := actualSecond.space] \as RightCompose;
\import Modules.Hom[V := finiteSecond.Carrier, W := finiteSecond.Carrier, source := finiteSecond.space, target := finiteSecond.space] \as SourceMaps;
\import Modules.Hom[V := actualSecond.Carrier, W := actualSecond.Carrier, source := actualSecond.space, target := actualSecond.space] \as TargetMaps;
\import Modules.End[V := finiteSecond.Carrier, space := finiteSecond.space] \as SourceEnd;
\import Modules.End[V := actualSecond.Carrier, space := actualSecond.space] \as TargetEnd;
\definition leftEquality: LeftCompose.compose #backward{secondIsomorphism} #forward{secondIsomorphism} = SourceEnd.identity :=
  SourceMaps.ext _ _ #leftInverse{secondIsomorphism};
\definition rightEquality: RightCompose.compose #forward{secondIsomorphism} #backward{secondIsomorphism} = TargetEnd.identity :=
  TargetMaps.ext _ _ #rightInverse{secondIsomorphism};
\definition left(x: Source.Positive[n := N.Nat^::zero].Carrier):
  #apply{(Backward.map #backward{secondIsomorphism})} (#apply{(Forward.map #forward{secondIsomorphism})} x) = x :=
  trans!{{Source.Positive[n := N.Nat^::zero].Carrier}} _ _ _
    (sym!{{Source.Positive[n := N.Nat^::zero].Carrier}} _ _ (Left.composition #forward{secondIsomorphism} #backward{secondIsomorphism} x))
    (trans!{{Source.Positive[n := N.Nat^::zero].Carrier}} _ _ _
      (congr!{SourceMaps.Map {Source.Positive[n := N.Nat^::zero].Carrier}} (\fun (u: SourceMaps.Map) => #apply{(SourceAction.map u)} x) _ _ leftEquality)
      (SourceIdentity.identity x));
\definition right(x: Target.Positive[n := N.Nat^::zero].Carrier):
  #apply{(Forward.map #forward{secondIsomorphism})} (#apply{(Backward.map #backward{secondIsomorphism})} x) = x :=
  trans!{{Target.Positive[n := N.Nat^::zero].Carrier}} _ _ _
    (sym!{{Target.Positive[n := N.Nat^::zero].Carrier}} _ _ (Right.composition #backward{secondIsomorphism} #forward{secondIsomorphism} x))
    (trans!{{Target.Positive[n := N.Nat^::zero].Carrier}} _ _ _
      (congr!{TargetMaps.Map {Target.Positive[n := N.Nat^::zero].Carrier}} (\fun (u: TargetMaps.Map) => #apply{(TargetAction.map u)} x) _ _ rightEquality)
      (TargetIdentity.identity x));
\definition isomorphism: Modules.Isomorphism[V := Source.Positive[n := N.Nat^::zero].Carrier, W := ActualTor.Positive[n := N.Nat^::zero].Carrier,
  source := Source.Positive[n := N.Nat^::zero].space, target := ActualTor.Positive[n := N.Nat^::zero].space].Isomorphism :=
  Modules.Isomorphism[V := Source.Positive[n := N.Nat^::zero].Carrier, W := ActualTor.Positive[n := N.Nat^::zero].Carrier,
    source := Source.Positive[n := N.Nat^::zero].space, target := ActualTor.Positive[n := N.Nat^::zero].space].Isomorphism {
    forward := Forward.map #forward{secondIsomorphism}, backward := Backward.map #backward{secondIsomorphism},
    leftInverse := left, rightInverse := right,
  };
