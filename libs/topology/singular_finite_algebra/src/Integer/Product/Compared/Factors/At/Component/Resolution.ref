\import resolutions.Resolution[].Over[R := I.Int^, ring := Integers.ring].Of[M := finiteFirst, P := Presentation.complex] \as Source;
\import resolutions.Resolution[].Over[R := I.Int^, ring := Integers.ring].Of[M := actualFirst, P := Presentation.complex] \as Target;
\import Modules.Hom[V := finiteFirst.Carrier, W := actualFirst.Carrier, source := finiteFirst.space, target := actualFirst.space] \as Forward;
\import Modules.Hom[V := actualFirst.Carrier, W := finiteFirst.Carrier, source := actualFirst.space, target := finiteFirst.space] \as Backward;
\import Forward.Composition[U := Presentation.complex.family.Carrier N.Nat^::zero, domain := Presentation.complex.family.space N.Nat^::zero] \as Compose;
\definition original: Source.Resolution := Presentation.resolution;
\definition augmentation: Modules.Hom[V := Presentation.complex.family.Carrier N.Nat^::zero, W := actualFirst.Carrier,
  source := Presentation.complex.family.space N.Nat^::zero, target := actualFirst.space].Map := Compose.compose #forward{firstIsomorphism} #augmentation{original};
\import std.Logic[].Proposition[] \as Logic;
\definition onto: Modules.Surjective (Target.term N.Nat^::zero) actualFirst augmentation := \block {
  \fun (h: actualFirst.Carrier) \then
  \takefrom x: \Cast[Presentation.complex.family.Carrier N.Nat^::zero] ({ x: Presentation.complex.family.Carrier N.Nat^::zero \where #apply{#augmentation{original}} x = #apply{#backward{firstIsomorphism}} h })
    \by #onto{original} (#apply{#backward{firstIsomorphism}} h) \then
  \return Logic.existsIntro[Presentation.complex.family.Carrier N.Nat^::zero, { x: Presentation.complex.family.Carrier N.Nat^::zero \where #apply{augmentation} x = h }] x
    (trans!{actualFirst.Carrier} _ _ _
      (congr!{finiteFirst.Carrier actualFirst.Carrier} (#apply{#forward{firstIsomorphism}}) _ _
        (\bysub(Presentation.complex.family.Carrier N.Nat^::zero, { x: Presentation.complex.family.Carrier N.Nat^::zero \where #apply{#augmentation{original}} x = #apply{#backward{firstIsomorphism}} h }, x)))
      (#rightInverse{firstIsomorphism} h))
};
\definition killed(x: Presentation.complex.family.Carrier (N.Nat^::succ N.Nat^::zero)):
  #apply{augmentation} (#apply{Presentation.complex.differential} N.Nat^::zero x) = #zero{actualFirst.space} :=
  trans!{actualFirst.Carrier} _ _ _
    (congr!{finiteFirst.Carrier actualFirst.Carrier} (#apply{#forward{firstIsomorphism}}) _ _ (#killed{original} x))
    (Forward.zeroPreserved #forward{firstIsomorphism});
\definition augmentationExact: \forall (x: Presentation.complex.family.Carrier N.Nat^::zero) -> #apply{augmentation} x = #zero{actualFirst.space} ->
  \exists { y: Presentation.complex.family.Carrier (N.Nat^::succ N.Nat^::zero) \where #apply{Presentation.complex.differential} N.Nat^::zero y = x } :=
  \fun (x: Presentation.complex.family.Carrier N.Nat^::zero)(closed: _) => #augmentationExact{original} x
    (trans!{finiteFirst.Carrier} _ _ _ (sym!{finiteFirst.Carrier} _ _ (#leftInverse{firstIsomorphism} (#apply{#augmentation{original}} x)))
      (trans!{finiteFirst.Carrier} _ _ _ (congr!{actualFirst.Carrier finiteFirst.Carrier} (#apply{#backward{firstIsomorphism}}) _ _ closed)
        (Backward.zeroPreserved #backward{firstIsomorphism})));
\definition data: Target.Data := Target.Data { augmentation := augmentation };
\definition resolution: Target.Resolution := \into[Target.Data](data, Target.Resolution) \by {
  Target.Laws[data] { projective := #projective{original}, onto := onto, killed := killed,
    augmentationExact := augmentationExact, exact := #exact{original} }
};
