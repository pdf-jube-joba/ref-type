\import Kunneth.CoreTerms[C := first, D := second].At[n := z] \as Terms;
\import \parent.\parent.At[z := z] \as Finite;
\import Chains.At[C := Singular.integerComplex, z := z] \as Actual;
\import homological_algebra.Finite[].Bounded[] \as Bounded;
\module Component(p: I.Int^);
\definition tensorFamily: Modules.Family[I.Int^] := Modules.Family[I.Int^] {
  Carrier := \fun (p: I.Int^) => Component[p := p].tensorCarrier,
  space := \fun (p: I.Int^) => Component[p := p].tensorSpace,
};
\definition torFamily: Modules.Family[I.Int^] := Modules.Family[I.Int^] {
  Carrier := \fun (p: I.Int^) => Component[p := p].torCarrier,
  space := \fun (p: I.Int^) => Component[p := p].torSpace,
};
\import Modules.DirectSum[Index := I.Int^, family := tensorFamily] \as Tensors;
\import Modules.DirectSum[Index := I.Int^, family := torFamily] \as Tors;
\definition tensorBundle: Modules.Bundle := Tensors.bundle;
\definition torBundle: Modules.Bundle := Tors.bundle;
\import singular_tensor_dual.Over[R := I.Int^, ring := Integers.commutativeRing] \as Dual;
\import Dual.SumIsomorphism[Index := I.Int^, first := Terms.tensorFamily, second := tensorFamily,
  components := \fun (p: I.Int^) => Component[p := p].tensorIsomorphism] \as TensorEndpoints;
\import Dual.SumIsomorphism[Index := I.Int^, first := Terms.torFamily, second := torFamily,
  components := \fun (p: I.Int^) => Component[p := p].torIsomorphism] \as TorEndpoints;
\definition homologyBundle: Modules.Bundle := Modules.Bundle { Carrier := Actual.Homology, space := Actual.homologySpace };
\import \root.Integer[].Endpoints[A := Terms.tensorBundle, B := homologyBundle, C := Terms.torBundle,
  U := tensorBundle, V := torBundle, sequence := Finite.kunneth,
  left := TensorEndpoints.isomorphism, right := TorEndpoints.isomorphism] \as Transport;
\definition kunneth: Modules.ShortExact[A := tensorBundle, B := homologyBundle, C := torBundle].Sequence := Transport.exact;

\module Splitting;

\definition exterior(p: I.Int^)(x: Component[p := p].tensorCarrier): Actual.Homology :=
  Finite.exterior p (#apply{#backward{Component[p := p].tensorIsomorphism}} x);
\definition exteriorOnInjection(p: I.Int^)(x: Component[p := p].tensorCarrier):
  #apply{kunneth.inclusion} (#apply{Tensors.Injection[i := p].map} x) = exterior p x :=
  trans!{Actual.Homology} _ _ _
    (congr!{Terms.tensorBundle.Carrier Actual.Homology} (#apply{Finite.kunneth.inclusion}) _ _ (TensorEndpoints.onBackwardInjection p x))
    (Finite.exteriorOnInjection p (#apply{#backward{Component[p := p].tensorIsomorphism}} x));
