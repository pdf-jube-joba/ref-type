\import Compared.At[z := z] \as Formula;
\definition tensorBundle: Modules.Bundle := Formula.tensorBundle;
\definition torBundle: Modules.Bundle := Formula.torBundle;
\import Chains.At[C := SingularExtension.complex, z := z] \as Actual;
\definition homologyBundle: Modules.Bundle := Modules.Bundle { Carrier := Actual.Homology, space := Actual.homologySpace };
\definition kunneth: Modules.ShortExact[A := tensorBundle, B := homologyBundle, C := torBundle].Sequence := Formula.kunneth;
\import Modules.Biproduct[V := tensorBundle.Carrier, W := torBundle.Carrier, left := tensorBundle.space, right := torBundle.space] \as Sum;
\definition splitting: Modules.Isomorphism[V := Sum.Carrier, W := Actual.Homology, source := Sum.space, target := Actual.homologySpace].Isomorphism := Formula.Splitting[].isomorphism;
