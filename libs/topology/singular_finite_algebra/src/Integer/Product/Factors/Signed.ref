\import singular_tensor_bridge.Integer[] \as Bridge;
\import Bridge.Tensor[C := FirstModel.chain, D := SecondModel.chain].With[leftNegative := firstNegative, rightNegative := secondNegative] \as TensorBridge;
\import NativeChains.ZeroExtension[C := FiniteTotal.complex] \as FiniteExtension;
\import NativeChains.Equivalence[C := FiniteTotal.complex, D := ProductChains.complex].ZeroExtension[e := nativeEquivalence] \as ProductExtension;
\import Chains.Equivalence[C := Model.tensorComplex, D := FiniteExtension.complex].Composition[E := SingularExtension.complex] \as Compose;
\definition comparison: Comparison := Compose.compose TensorBridge.equivalence ProductExtension.equivalence;
\import Bridge.Factor[C := FirstModel.chain].With[negative := firstNegative] \as FirstBridge;
\import Bridge.Factor[C := SecondModel.chain].With[negative := secondNegative] \as SecondBridge;
\import NativeChains.ZeroExtension[C := FirstNative.complex] \as FirstExtension;
\import NativeChains.ZeroExtension[C := SecondNative.complex] \as SecondExtension;
\import NativeChains.ZeroExtension[C := ActualFirst.complex] \as FirstTargetExtension;
\import NativeChains.ZeroExtension[C := ActualSecond.complex] \as SecondTargetExtension;
\import NativeChains.Equivalence[C := FirstNative.complex, D := ActualFirst.complex].ZeroExtension[e := firstComparison] \as FirstComparisonExtension;
\import NativeChains.Equivalence[C := SecondNative.complex, D := ActualSecond.complex].ZeroExtension[e := secondComparison] \as SecondComparisonExtension;
\import Chains.Equivalence[C := FirstModel.chain, D := FirstExtension.complex].Composition[E := FirstTargetExtension.complex] \as FirstCompose;
\import Chains.Equivalence[C := SecondModel.chain, D := SecondExtension.complex].Composition[E := SecondTargetExtension.complex] \as SecondCompose;
\definition signedFirstComparison: Chains.Equivalence[C := FirstModel.chain, D := FirstTargetExtension.complex].Equivalence :=
  FirstCompose.compose FirstBridge.equivalence FirstComparisonExtension.equivalence;
\definition signedSecondComparison: Chains.Equivalence[C := SecondModel.chain, D := SecondTargetExtension.complex].Equivalence :=
  SecondCompose.compose SecondBridge.equivalence SecondComparisonExtension.equivalence;
\import \parent.\parent.Compared[comparison := comparison].Factors[firstComparison := signedFirstComparison, secondComparison := signedSecondComparison] \as Compared;
\module At(z: I.Int^);
