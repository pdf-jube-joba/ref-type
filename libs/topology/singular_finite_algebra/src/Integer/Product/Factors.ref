\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\import Double.Tensor[C := FirstNative.complex, D := SecondNative.complex] \as FiniteTensor;
\import Double.Total[C := FiniteTensor.complex] \as FiniteTotal;
\import NativeAlgebra.TensorEquivalence[C := FirstNative.complex, D := ActualFirst.complex,
  E := SecondNative.complex, F := ActualSecond.complex, left := firstComparison, right := secondComparison] \as TensorComparison;
\import singular_eilenberg_zilber.Equivalence[A := X, B := Y, left := left, right := right] \as EilenbergZilber;
\import Double.Tensor[C := ActualFirst.complex, D := ActualSecond.complex] \as ActualTensor;
\import Double.Total[C := ActualTensor.complex] \as ActualTotal;
\import NativeChains.Equivalence[C := Singular.complex, D := ActualTotal.complex].Reverse[] \as Reverse;
\import NativeChains.Equivalence[C := FiniteTotal.complex, D := ActualTotal.complex].Composition[E := Singular.complex] \as Compose;
\definition nativeEquivalence: NativeChains.Equivalence[C := FiniteTotal.complex, D := Singular.complex].Equivalence :=
  Compose.compose TensorComparison.value (Reverse.apply EilenbergZilber.equivalence);
