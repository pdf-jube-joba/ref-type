\import chain_complexes.Chain[] \as Degrees;
\import Degrees.Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import resolutions.TensorComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Tensor;
\import Tensor.Integer[P := P, N := coefficients] \as Source;
\import Tensor.Integer[P := Q, N := coefficients] \as Target;
\import Chains.Map[C := P, D := Q] \as Original;
\import Chains.Map[C := Source.complex, D := Target.complex] \as Maps;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Identity;
\module On(f: Original.Map);
\module Homotopy;
