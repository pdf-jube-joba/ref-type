\import Modules.Tensor[V := P.family.Carrier z, W := coefficients.Carrier,
  left := P.family.space z, right := coefficients.space] \as Before;
\import Target.At[z := z] \as After;
\import Before.Mapping[U := Q.family.Carrier z, Z := coefficients.Carrier,
  targetLeft := Q.family.space z, targetRight := coefficients.space] \as Mapping;
\definition map: Modules.Hom[V := Before.Carrier, W := After.Carrier, source := Before.space, target := After.space].Map :=
  Mapping.map (Original.At[k := z].linear f) Identity.identity;
\definition onTensor: \forall (x: P.family.Carrier z)(a: coefficients.Carrier) ->
  (map).apply (Before.tensor x a) = After.tensor ((f).apply z x) a :=
  Mapping.onTensor (Original.At[k := z].linear f) Identity.identity;
