\import Modules.Tensor[V := P.family.Carrier z, W := coefficients.Carrier,
  left := P.family.space z, right := coefficients.space] \as Domain;
\import Target.At[z := z] \as Codomain;
\import Modules.Hom[V := Domain.Carrier, W := Codomain.Carrier, source := Domain.space, target := Codomain.space] \as Linear;
\import Domain.Universal[U := Codomain.Carrier, target := Codomain.space] \as Universal;
\import Modules.Hom[V := Target.Carrier (Degrees.next z), W := Codomain.Carrier,
  source := Target.space (Degrees.next z), target := Codomain.space] \as PriorMaps;
\definition prior: PriorMaps.Map := PriorMaps.Map {
  apply := TargetPrior.value z, addition := TargetPrior.addition z, scalar := TargetPrior.scalar z,
};
\import PriorMaps.Composition[U := Domain.Carrier, domain := Domain.space] \as FirstTerm;
\definition first: Linear.Map := FirstTerm.compose prior \parent.At[z := z].map;
\import Modules.Hom[V := Source.Carrier (Degrees.previous z), W := Target.Carrier (Degrees.next (Degrees.previous z)),
  source := Source.space (Degrees.previous z), target := Target.space (Degrees.next (Degrees.previous z))] \as BeforeShift;
\import Modules.Hom[V := Source.Carrier (Degrees.previous z), W := Codomain.Carrier,
  source := Source.space (Degrees.previous z), target := Codomain.space] \as ShiftMaps;
\definition shift: ShiftMaps.Map := ShiftMaps.Map {
  apply := TargetHomotopy.shifted data z,
  addition := \fun (x, y: Source.Carrier (Degrees.previous z)) => trans!{Codomain.Carrier} _ _ _
    (congr!{{Target.Carrier (Degrees.next (Degrees.previous z))} Codomain.Carrier}
      (Transport.cast Target.Carrier (Degrees.next (Degrees.previous z)) z (Degrees.nextPrevious z)) _ _
      ((\parent.At[z := Degrees.previous z].map).addition x y))
    (Transport.binaryNatural Target.Carrier Target.Carrier Target.Carrier
      (\fun (k: Degrees.Degree) => (Target.space k).add)
      (Degrees.next (Degrees.previous z)) z (Degrees.nextPrevious z)
      ((\parent.At[z := Degrees.previous z].map).apply x) ((\parent.At[z := Degrees.previous z].map).apply y)),
  scalar := \fun (a: I.Int^)(x: Source.Carrier (Degrees.previous z)) => trans!{Codomain.Carrier} _ _ _
    (congr!{{Target.Carrier (Degrees.next (Degrees.previous z))} Codomain.Carrier}
      (Transport.cast Target.Carrier (Degrees.next (Degrees.previous z)) z (Degrees.nextPrevious z)) _ _
      ((\parent.At[z := Degrees.previous z].map).scalar a x))
    (Transport.natural Target.Carrier Target.Carrier (\fun (k: Degrees.Degree) => (Target.space k).smul a)
      (Degrees.next (Degrees.previous z)) z (Degrees.nextPrevious z) ((\parent.At[z := Degrees.previous z].map).apply x)),
};
\import ShiftMaps.Composition[U := Domain.Carrier, domain := Domain.space] \as SecondTerm;
\definition second: Linear.Map := SecondTerm.compose shift Source.Step[z := z].differential;
\definition forward: Linear.Map := First.At[z := z].map;
\definition backward: Linear.Map := Second.At[z := z].map;
\definition difference: Linear.Map := Linear.plus forward (Linear.negative backward);
\definition sum: Linear.Map := Linear.plus first second;
\definition firstPure: \forall (x: P.family.Carrier z)(a: coefficients.Carrier) ->
  (first).apply (Domain.tensor x a) = Codomain.tensor (OriginalPrior.value z ((h).apply z x)) a :=
  \fun (x: P.family.Carrier z)(a: coefficients.Carrier) => trans!{Codomain.Carrier} _ _ _
    (congr!{{Target.Carrier (Degrees.next z)} Codomain.Carrier} (TargetPrior.value z) _ _ (\parent.At[z := z].onTensor x a))
    (Target.priorOnTensor z ((h).apply z x) a);
\definition shiftedPure: \forall (x: P.family.Carrier (Degrees.previous z))(a: coefficients.Carrier) ->
  (shift).apply (Source.At[z := Degrees.previous z].tensor x a) = Codomain.tensor (OriginalHomotopy.shifted h z x) a :=
  \fun (x: P.family.Carrier (Degrees.previous z))(a: coefficients.Carrier) => trans!{Codomain.Carrier} _ _ _
    (congr!{{Target.Carrier (Degrees.next (Degrees.previous z))} Codomain.Carrier}
      (Transport.cast Target.Carrier (Degrees.next (Degrees.previous z)) z (Degrees.nextPrevious z)) _ _
      (\parent.At[z := Degrees.previous z].onTensor x a))
    (Transport.natural Q.family.Carrier Target.Carrier (\fun (k: Degrees.Degree)(v: Q.family.Carrier k) => Target.At[z := k].tensor v a)
      (Degrees.next (Degrees.previous z)) z (Degrees.nextPrevious z) ((h).apply (Degrees.previous z) x));
\definition secondPure: \forall (x: P.family.Carrier z)(a: coefficients.Carrier) ->
  (second).apply (Domain.tensor x a) = Codomain.tensor (OriginalHomotopy.shifted h z ((P.differential).apply z x)) a :=
  \fun (x: P.family.Carrier z)(a: coefficients.Carrier) => trans!{Codomain.Carrier} _ _ _
    (congr!{{Source.Carrier (Degrees.previous z)} Codomain.Carrier} ((shift).apply) _ _ (Source.Step[z := z].onTensor x a))
    (shiftedPure ((P.differential).apply z x) a);
\import Modules.Tensor[V := Q.family.Carrier z, W := coefficients.Carrier,
  left := Q.family.space z, right := coefficients.space] \as Result;
\definition pure: \forall (x: P.family.Carrier z)(a: coefficients.Carrier) ->
  (difference).apply (Domain.tensor x a) = (sum).apply (Domain.tensor x a) :=
  \fun (x: P.family.Carrier z)(a: coefficients.Carrier) => eq_reason!{
    {(difference).apply (Domain.tensor x a)}
    "=" {(Codomain.space).add (Result.tensor ((f).apply z x) a) ((Codomain.space).neg (Result.tensor ((g).apply z x) a))}
    "by" {congr2!{Codomain.Carrier Codomain.Carrier Codomain.Carrier} ((Codomain.space).add) _ _ _ _
      (First.At[z := z].onTensor x a)
      (congr!{Codomain.Carrier Codomain.Carrier} ((Codomain.space).neg) _ _ (Second.At[z := z].onTensor x a))}
    "=" {Result.tensor ((Q.family.space z).add ((f).apply z x) ((Q.family.space z).neg ((g).apply z x))) a}
    "by" {sym!{Codomain.Carrier} _ _ (Result.tensorDifferenceLeft ((f).apply z x) ((g).apply z x) a)}
    "=" {Result.tensor ((Q.family.space z).add (OriginalPrior.value z ((h).apply z x)) (OriginalHomotopy.shifted h z ((P.differential).apply z x))) a}
    "by" {congr!{{Q.family.Carrier z} Codomain.Carrier} (\fun (y: Q.family.Carrier z) => Result.tensor y a) _ _ ((h).equation z x)}
    "=" {(Codomain.space).add (Result.tensor (OriginalPrior.value z ((h).apply z x)) a) (Result.tensor (OriginalHomotopy.shifted h z ((P.differential).apply z x)) a)}
    "by" {(Result.bilinear).addLeft (OriginalPrior.value z ((h).apply z x)) (OriginalHomotopy.shifted h z ((P.differential).apply z x)) a}
    "=" {(sum).apply (Domain.tensor x a)}
    "by" {congr2!{Codomain.Carrier Codomain.Carrier Codomain.Carrier} ((Codomain.space).add) _ _ _ _
      (sym!{Codomain.Carrier} _ _ (firstPure x a)) (sym!{Codomain.Carrier} _ _ (secondPure x a))}
  };
\definition equal: difference = sum := Universal.ext difference sum pure;
\definition law[x: Domain.Carrier]: (Codomain.space).add ((First.map).apply z x) ((Codomain.space).neg ((Second.map).apply z x)) =
  (Codomain.space).add (TargetPrior.value z ((data).apply z x)) (TargetHomotopy.shifted data z ((Source.differential).apply z x)) :=
  congr!{Linear.Map Codomain.Carrier} (\fun (m: Linear.Map) => (m).apply x) difference sum equal;
