\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import topological_constructions.Product[A := X, B := Y] \as Product;
\import singular_cohomology.Chains[A := Product.CarrierSet, source := Product.topology left right] \as Singular;
\import homological_algebra.Kunneth[].Integer[] \as Kunneth;
\import Kunneth.Theorem[C := first, D := second] \as Theorem;
\import Kunneth.Of[C := first, D := second] \as Model;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import Chains.Equivalence[C := Model.tensorComplex, D := Singular.integerComplex] \as Comparisons;
\definition Comparison: \Set := Comparisons.Equivalence;
\module Compared(comparison: Comparison);
\module Groups(z: I.Int^);

\import homological_algebra.Finite[].Bounded[].Of[C := first] \as FirstModel;
\import homological_algebra.Finite[].Bounded[].Of[C := second] \as SecondModel;
\import singular_cohomology.Chains[A := X, source := left] \as ActualFirst;
\import singular_cohomology.Chains[A := Y, source := right] \as ActualSecond;
\import singular_cech.Algebra[R := I.Int^, ring := Integers.ring] \as NativeAlgebra;
\import NativeAlgebra.Restriction[C := FirstModel.chain] \as FirstNative;
\import NativeAlgebra.Restriction[C := SecondModel.chain] \as SecondNative;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as NativeChains;
\definition FirstComparison: \Set := NativeChains.Equivalence[C := FirstNative.complex, D := ActualFirst.complex].Equivalence;
\definition SecondComparison: \Set := NativeChains.Equivalence[C := SecondNative.complex, D := ActualSecond.complex].Equivalence;
\module Factors(firstComparison: FirstComparison, secondComparison: SecondComparison);
