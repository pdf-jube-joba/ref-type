\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import topological_constructions.Product[A := X, B := Y] \as Product;
\import singular_cohomology.Chains[A := Product.CarrierSet, source := Product.topology left right] \as Singular;
\import homological_algebra.Kunneth[].Integer[] \as Kunneth;
\import Kunneth.Theorem[C := first, D := second] \as Theorem;
\import Kunneth.Of[C := first, D := second] \as Model;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import Chains.Equivalence[C := Model.tensorComplex, D := Singular.integerComplex] \as Comparisons;
\definition Comparison: \Set := Comparisons.Equivalence;
\module Compared(comparison: Comparison);
\module Groups(z: I.Int^);
