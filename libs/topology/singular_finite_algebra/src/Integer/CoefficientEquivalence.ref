\import chain_complexes.Chain[] \as Degrees;
\import Degrees.Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import resolutions.TensorComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Integer[P := P, N := coefficients] \as Source;
\import resolutions.TensorComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Integer[P := Q, N := coefficients] \as Target;
\import Chains.Equivalence[C := P, D := Q] \as Original;
\import Chains.Equivalence[C := Source.complex, D := Target.complex] \as Result;
\import Chains.End[C := P] \as SourceIdentity;
\import Chains.End[C := Q] \as TargetIdentity;
\import Chains.Map[C := Q, D := P].Composition[B := P] \as LeftComposition;
\import Chains.Map[C := P, D := Q].Composition[B := Q] \as RightComposition;
\import \root.Integer[].CoefficientComposition[P := P, Q := Q, T := P, coefficients := coefficients] \as Left;
\import \root.Integer[].CoefficientComposition[P := Q, Q := P, T := Q, coefficients := coefficients] \as Right;
\import \root.Integer[].CoefficientIdentity[P := P, coefficients := coefficients] \as SourceEnd;
\import \root.Integer[].CoefficientIdentity[P := Q, coefficients := coefficients] \as TargetEnd;
\import \root.Integer[].CoefficientTensor[P := P, Q := P, coefficients := coefficients].Homotopy[] \as LeftHomotopy;
\import \root.Integer[].CoefficientTensor[P := Q, Q := Q, coefficients := coefficients].Homotopy[] \as RightHomotopy;
\import \root.Integer[].CoefficientTensor[P := P, Q := Q, coefficients := coefficients] \as Forward;
\import \root.Integer[].CoefficientTensor[P := Q, Q := P, coefficients := coefficients] \as Backward;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficients;
\module With(e: Original.Equivalence) {
  \import LeftHomotopy.With[f := LeftComposition.compose e.backward e.forward, g := SourceIdentity.identity, h := Original.leftHomotopy e] \as L;
  \import RightHomotopy.With[f := RightComposition.compose e.forward e.backward, g := TargetIdentity.identity, h := Original.rightHomotopy e] \as H;
  \import Chains.Homotopy[C := Source.complex, D := Source.complex] \as LH;
  \import Chains.Homotopy[C := Target.complex, D := Target.complex] \as RH;
  \definition data: Result.Data := Result.Data {
    forward := Forward.On[f := e.forward].map,
    backward := Backward.On[f := e.backward].map,
    left := L.data, right := H.data,
  };
  \definition laws: Result.Laws[data] := Result.Laws[data] {
    left := LH.replacementLaws _ _ _ _ L.data (Left.law e.forward e.backward) SourceEnd.law L.laws,
    right := RH.replacementLaws _ _ _ _ H.data (Right.law e.backward e.forward) TargetEnd.law H.laws,
  };
  \definition equivalence: Result.Equivalence := \into[Result.Data](data, { data: Result.Data \where Result.Laws[data] }) \by { laws };
}
\definition existence: \forall (e: Original.Equivalence) -> \exists Result.Equivalence :=
  \fun (e: Original.Equivalence) => \exact(With[e := e].equivalence, Result.Equivalence);
