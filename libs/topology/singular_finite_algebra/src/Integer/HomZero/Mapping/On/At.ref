\import Cochains.At[C := Source.complex, k := n] \as SourceH;
\import Cochains.At[C := Theory.complex, k := n] \as TargetH;
\import Cochains.Map[C := Source.complex, D := Theory.complex].At[k := n] \as Maps;
\import SourceZero.At[n := n] \as SourceCoordinates;
\import \root.Integer[].HomZero[P := P, coefficients := coefficients].At[n := n] \as TargetCoordinates;
\definition law(sourceZero: SourceZero.DifferentialZero)(targetZero: DifferentialZero):
  \forall (h: SourceH.Cohomology) ->
    #apply{#forward{(TargetCoordinates.isomorphism targetZero)}} (#apply{(Maps.induced Pull.map)} h) =
      #apply{Pull.map} n (#apply{#forward{(SourceCoordinates.isomorphism sourceZero)}} h) :=
  SourceH.classInduction
    (\fun (h: SourceH.Cohomology) =>
      #apply{#forward{(TargetCoordinates.isomorphism targetZero)}} (#apply{(Maps.induced Pull.map)} h) =
        #apply{Pull.map} n (#apply{#forward{(SourceCoordinates.isomorphism sourceZero)}} h))
    (\fun (phi: SourceH.CycleCarrier) => trans!{{Theory.Carrier n}} _ _ _
      (congr!{TargetH.Cohomology {Theory.Carrier n}} (#apply{#forward{(TargetCoordinates.isomorphism targetZero)}})
        (#apply{(Maps.induced Pull.map)} (SourceH.classOf phi))
        (TargetH.classOf (#apply{(Maps.cyclesMap Pull.map)} phi)) (Maps.onClass Pull.map phi))
      (trans!{{Theory.Carrier n}} _ _ _
        (TargetCoordinates.onClass targetZero (#apply{(Maps.cyclesMap Pull.map)} phi))
        (congr!{{Source.Carrier n} {Theory.Carrier n}} (#apply{Pull.map} n)
          (SourceH.ambient phi) (#apply{#forward{(SourceCoordinates.isomorphism sourceZero)}} (SourceH.classOf phi))
          (sym!{{Source.Carrier n}} _ _ (SourceCoordinates.onClass sourceZero phi)))));
