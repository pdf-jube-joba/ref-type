\import std.Data[].Nat[] \as N;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing] \as Hom;
\import Hom.On[P := P, N := coefficients] \as Theory;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Cochains;
\import Cochains.ZeroCriterion[C := Theory.complex] \as Criterion;
\definition DifferentialZero: \Prop := \forall (n: N.Nat^)(x: P.family.Carrier (N.Nat^::succ n)) ->
  #apply{P.differential} n x = #zero{(P.family.space n)};
\definition cochainDifferentialZero(zero: DifferentialZero): Criterion.DifferentialZero :=
  \fun (n: N.Nat^)(phi: Theory.Carrier n) => Theory.At[n := N.Nat^::succ n].ext
    (Theory.apply n phi) (#zero{(Theory.space (N.Nat^::succ n))})
    (\fun (x: P.family.Carrier (N.Nat^::succ n)) => trans!{coefficients.Carrier} _ _ _
      (congr!{{P.family.Carrier n} coefficients.Carrier} (#apply{phi})
        (#apply{P.differential} n x) (#zero{(P.family.space n)}) (zero n x))
      (Theory.At[n := n].zeroPreserved phi));
\module At(n: N.Nat^);
