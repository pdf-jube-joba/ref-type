\definition degree: I.Int^ := I.Int^::ofNat N.Nat^::zero;
\import \parent.\parent.Zero[] \as Model;
\import std.Logic[].Equality[].Transport[A := I.Int^] \as Transport;
\use Equality.congr2;
\definition sourcePrior(x: P.family.Carrier degree):
  SourcePrior.value degree (sourceOperator degree x) = #apply{P.differential} (Degrees.next degree) (sourceOperator degree x) :=
  Transport.castRefl P.family.Carrier degree (#apply{P.differential} (Degrees.next degree) (sourceOperator degree x));
\definition sourceShifted(x: P.family.Carrier degree):
  SourceHomotopies.shifted sourceData degree (#apply{P.differential} degree x) = #zero{(P.family.space degree)} :=
  Transport.castRefl P.family.Carrier degree #zero{(P.family.space degree)};
\definition left: LeftEquation degree := \fun (x: P.family.Carrier degree) =>
  trans!{{P.family.Carrier degree}} _ _ _ (Model.sourceEquation sourceNegative x)
    (congr2!{{P.family.Carrier degree} {P.family.Carrier degree} {P.family.Carrier degree}}
      (#add{(P.family.space degree)}) _ _ _ _
      (sym!{{P.family.Carrier degree}} _ _ (sourcePrior x))
      (sym!{{P.family.Carrier degree}} _ _ (sourceShifted x)));
\definition targetPrior(x: Q.family.Carrier degree):
  TargetPrior.value degree (targetOperator degree x) = #apply{Q.differential} (Degrees.next degree) (targetOperator degree x) :=
  Transport.castRefl Q.family.Carrier degree (#apply{Q.differential} (Degrees.next degree) (targetOperator degree x));
\definition targetShifted(x: Q.family.Carrier degree):
  TargetHomotopies.shifted targetData degree (#apply{Q.differential} degree x) = #zero{(Q.family.space degree)} :=
  Transport.castRefl Q.family.Carrier degree #zero{(Q.family.space degree)};
\definition right: RightEquation degree := \fun (x: Q.family.Carrier degree) =>
  trans!{{Q.family.Carrier degree}} _ _ _ (Model.targetZeroEquation x)
    (congr2!{{Q.family.Carrier degree} {Q.family.Carrier degree} {Q.family.Carrier degree}}
      (#add{(Q.family.space degree)}) _ _ _ _
      (sym!{{Q.family.Carrier degree}} _ _ (targetPrior x))
      (sym!{{Q.family.Carrier degree}} _ _ (targetShifted x)));
