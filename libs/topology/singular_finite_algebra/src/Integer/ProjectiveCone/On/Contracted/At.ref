\definition z: I.Int^ := I.Int^::ofNat n;
\definition next: I.Int^ := Degrees.next z;
\definition twice: I.Int^ := Degrees.next next;
\import Modules.Biproduct[V := Q.family.Carrier z, W := P.family.Carrier (Degrees.previous z),
  left := Q.family.space z, right := P.family.space (Degrees.previous z)] \as Here;
\import Modules.Biproduct[V := Q.family.Carrier next, W := P.family.Carrier z,
  left := Q.family.space next, right := P.family.space z] \as After;
\import Modules.Biproduct[V := Q.family.Carrier twice, W := P.family.Carrier next,
  left := Q.family.space twice, right := P.family.space next] \as Last;
\import Modules.Hom[V := Here.Carrier, W := After.Carrier, source := Here.space, target := After.space] \as ConeMaps;
\definition map: ConeMaps.Map := ConeMaps.Map {
  apply := #apply{h} n, addition := #addition{h} n, scalar := #scalar{h} n,
};
\import ConeMaps.Composition[U := Q.family.Carrier z, domain := Q.family.space z] \as InjectFirst;
\definition onFirst: Modules.Hom[V := Q.family.Carrier z, W := After.Carrier,
  source := Q.family.space z, target := After.space].Map := InjectFirst.compose map Here.firstInjection;
\import Modules.Hom[V := After.Carrier, W := P.family.Carrier z,
  source := After.space, target := P.family.space z].Composition[
  U := Q.family.Carrier z, domain := Q.family.space z] \as ToSource;
\definition backward: Modules.Hom[V := Q.family.Carrier z, W := P.family.Carrier z,
  source := Q.family.space z, target := P.family.space z].Map := ToSource.compose After.secondProjection onFirst;
\import Modules.Hom[V := After.Carrier, W := Q.family.Carrier next,
  source := After.space, target := Q.family.space next].Composition[
  U := Q.family.Carrier z, domain := Q.family.space z] \as ToTarget;
\definition firstBlock: Modules.Hom[V := Q.family.Carrier z, W := Q.family.Carrier next,
  source := Q.family.space z, target := Q.family.space next].Map := ToTarget.compose After.firstProjection onFirst;
\import Modules.Hom[V := Q.family.Carrier z, W := Q.family.Carrier next,
  source := Q.family.space z, target := Q.family.space next] \as TargetMaps;
\definition targetHomotopy: TargetMaps.Map := TargetMaps.negative firstBlock;
\import Modules.Hom[V := After.Carrier, W := Last.Carrier, source := After.space, target := Last.space] \as NextConeMaps;
\definition nextMap: NextConeMaps.Map := NextConeMaps.Map {
  apply := #apply{h} (N.Nat^::succ n), addition := #addition{h} (N.Nat^::succ n), scalar := #scalar{h} (N.Nat^::succ n),
};
\import NextConeMaps.Composition[U := P.family.Carrier z, domain := P.family.space z] \as InjectSecond;
\definition onSecond: Modules.Hom[V := P.family.Carrier z, W := Last.Carrier,
  source := P.family.space z, target := Last.space].Map := InjectSecond.compose nextMap After.secondInjection;
\import Modules.Hom[V := Last.Carrier, W := P.family.Carrier next,
  source := Last.space, target := P.family.space next].Composition[
  U := P.family.Carrier z, domain := P.family.space z] \as ToUpperSource;
\definition sourceHomotopy: Modules.Hom[V := P.family.Carrier z, W := P.family.Carrier next,
  source := P.family.space z, target := P.family.space next].Map := ToUpperSource.compose Last.secondProjection onSecond;

\import Modules.Hom[V := After.Carrier, W := P.family.Carrier z, source := After.space, target := P.family.space z].Composition[
  U := Here.Carrier, domain := Here.space] \as SourceOutput;
\definition secondOutput: Modules.Hom[V := Here.Carrier, W := P.family.Carrier z,
  source := Here.space, target := P.family.space z].Map := SourceOutput.compose After.secondProjection map;
\import Modules.Hom[V := After.Carrier, W := Q.family.Carrier next, source := After.space, target := Q.family.space next].Composition[
  U := Here.Carrier, domain := Here.space] \as TargetOutput;
\definition firstOutput: Modules.Hom[V := Here.Carrier, W := Q.family.Carrier next,
  source := Here.space, target := Q.family.space next].Map := TargetOutput.compose After.firstProjection map;
\import Modules.Hom[V := Here.Carrier, W := P.family.Carrier z, source := Here.space, target := P.family.space z].Composition[
  U := P.family.Carrier (Degrees.previous z), domain := P.family.space (Degrees.previous z)] \as LowerOutput;
\definition lowerBlock: Modules.Hom[V := P.family.Carrier (Degrees.previous z), W := P.family.Carrier z,
  source := P.family.space (Degrees.previous z), target := P.family.space z].Map := LowerOutput.compose secondOutput Here.secondInjection;
\definition onPair(a: Q.family.Carrier z)(b: P.family.Carrier (Degrees.previous z)):
  #apply{secondOutput} (Here.make a b) = #add{(P.family.space z)} (#apply{backward} a) (#apply{lowerBlock} b) :=
  trans!{{P.family.Carrier z}} _ _ _
    (congr!{Here.Carrier {P.family.Carrier z}} (#apply{secondOutput}) _ _ (sym!{Here.Carrier} _ _ (Here.reconstruction (Here.make a b))))
    (#addition{secondOutput} (#apply{Here.firstInjection} a) (#apply{Here.secondInjection} b));
\import Modules.Laws[V := After.Carrier, space := After.space] \as CurrentLaws;
\import algebra.Group[].Of[Carrier := After.Carrier, group := CurrentLaws.additive] \as CurrentGroup;
\definition upperEquation(x: After.Carrier): x = #add{After.space}
  (#apply{differential} (N.Nat^::succ n) (#apply{h} (N.Nat^::succ n) x))
  (#apply{h} n (#apply{differential} n x)) :=
  trans!{After.Carrier} _ _ _
    (sym!{After.Carrier} _ _ (trans!{After.Carrier} _ _ _
      (congr!{After.Carrier After.Carrier} (#add{After.space} x) _ _ CurrentGroup.negZero)
      (CurrentGroup.zeroRight x)))
    (#successorEquation{h} n x);
\import Cone.At[k := next] \as Differential;
\import Cone.At[k := twice] \as HigherDifferential;
\import std.Data[].Pair[].Prop[A := Q.family.Carrier z, B := P.family.Carrier (Degrees.previous z)] \as HerePairs;
\import SignedChains.At[C := Q, z := next] \as QBoundary;
\import Modules.Hom[V := Q.family.Carrier next, W := Q.family.Carrier z, source := Q.family.space next, target := Q.family.space z] \as QBoundaryMaps;
\import Modules.Laws[V := Q.family.Carrier z, space := Q.family.space z] \as QLaws;
\import algebra.Group[].Of[Carrier := Q.family.Carrier z, group := QLaws.additive] \as QGroup;
\definition secondBoundary(x: P.family.Carrier z):
  #apply{differential} n (#apply{After.secondInjection} x) =
    Here.make (#apply{f} z x) (#neg{(P.family.space (Degrees.previous z))} (#apply{P.differential} z x)) :=
  HerePairs.ext _ _
    (trans!{{Q.family.Carrier z}} _ _ _
      (congr!{{Q.family.Carrier z} {Q.family.Carrier z}} (\fun (v: Q.family.Carrier z) => #add{(Q.family.space z)} v (#apply{f} z x)) _ _
        (QBoundaryMaps.zeroPreserved QBoundary.differential))
      (QGroup.zeroLeft (#apply{f} z x)))
    (\refl(#neg{(P.family.space (Degrees.previous z))} (#apply{P.differential} z x)));
\definition sourceRaw(x: P.family.Carrier z): x =
  #add{(P.family.space z)}
    (#neg{(P.family.space z)} (#apply{P.differential} next (#apply{sourceHomotopy} x)))
    (#apply{secondOutput} (Here.make (#apply{f} z x) (#neg{(P.family.space (Degrees.previous z))} (#apply{P.differential} z x)))) :=
  trans!{{P.family.Carrier z}} _ _ _
    (congr!{After.Carrier {P.family.Carrier z}} After.second _ _ (upperEquation (#apply{After.secondInjection} x)))
    (congr!{Here.Carrier {P.family.Carrier z}}
      (\fun (v: Here.Carrier) => #add{(P.family.space z)}
        (#neg{(P.family.space z)} (#apply{P.differential} next (#apply{sourceHomotopy} x))) (#apply{secondOutput} v)) _ _
      (secondBoundary x));
\import Modules.Hom[V := P.family.Carrier (Degrees.previous z), W := P.family.Carrier z,
  source := P.family.space (Degrees.previous z), target := P.family.space z] \as LowerMaps;
\definition sourceExpanded(x: P.family.Carrier z): x =
  #add{(P.family.space z)}
    (#neg{(P.family.space z)} (#apply{P.differential} next (#apply{sourceHomotopy} x)))
    (#add{(P.family.space z)} (#apply{backward} (#apply{f} z x))
      (#neg{(P.family.space z)} (#apply{lowerBlock} (#apply{P.differential} z x)))) :=
  trans!{{P.family.Carrier z}} _ _ _ (sourceRaw x)
    (congr!{{P.family.Carrier z} {P.family.Carrier z}}
      (#add{(P.family.space z)} (#neg{(P.family.space z)} (#apply{P.differential} next (#apply{sourceHomotopy} x)))) _ _
      (trans!{{P.family.Carrier z}} _ _ _
        (onPair (#apply{f} z x) (#neg{(P.family.space (Degrees.previous z))} (#apply{P.differential} z x)))
        (congr!{{P.family.Carrier z} {P.family.Carrier z}} (#add{(P.family.space z)} (#apply{backward} (#apply{f} z x))) _ _
          (LowerMaps.negativePreserved lowerBlock (#apply{P.differential} z x)))));

\import Modules.Laws[V := P.family.Carrier z, space := P.family.space z] \as PLaws;
\import algebra.Group[].Of[Carrier := P.family.Carrier z, group := PLaws.additive] \as PGroup;
\definition sourceBalance(a, b, c: P.family.Carrier z):
  PGroup.add (PGroup.neg a) (PGroup.add b (PGroup.neg c)) = PGroup.difference b (PGroup.add a c) :=
  trans!{{P.family.Carrier z}} _ _ _ (sym!{{P.family.Carrier z}} _ _ (PGroup.assoc (PGroup.neg a) b (PGroup.neg c)))
    (trans!{{P.family.Carrier z}} _ _ _
      (congr!{{P.family.Carrier z} {P.family.Carrier z}} (\fun (v: P.family.Carrier z) => PGroup.add v (PGroup.neg c)) _ _ (PGroup.comm (PGroup.neg a) b))
      (trans!{{P.family.Carrier z}} _ _ _ (PGroup.assoc b (PGroup.neg a) (PGroup.neg c))
        (congr!{{P.family.Carrier z} {P.family.Carrier z}} (PGroup.add b) _ _ (sym!{{P.family.Carrier z}} _ _ (PGroup.negAdd a c)))));
\definition sourceEquation(x: P.family.Carrier z):
  PGroup.difference (#apply{backward} (#apply{f} z x)) x =
    PGroup.add (#apply{P.differential} next (#apply{sourceHomotopy} x)) (#apply{lowerBlock} (#apply{P.differential} z x)) :=
  trans!{{P.family.Carrier z}} _ _ _
    (congr!{{P.family.Carrier z} {P.family.Carrier z}} (PGroup.difference (#apply{backward} (#apply{f} z x))) _ _
      (trans!{{P.family.Carrier z}} _ _ _ (sourceExpanded x)
        (sourceBalance (#apply{P.differential} next (#apply{sourceHomotopy} x)) (#apply{backward} (#apply{f} z x)) (#apply{lowerBlock} (#apply{P.differential} z x)))))
    (PGroup.subtractDifference (#apply{backward} (#apply{f} z x))
      (PGroup.add (#apply{P.differential} next (#apply{sourceHomotopy} x)) (#apply{lowerBlock} (#apply{P.differential} z x))));

\definition upperBackward(y: Q.family.Carrier next): P.family.Carrier next := Last.second (#apply{nextMap} (#apply{After.firstInjection} y));
\definition upperFirst(y: Q.family.Carrier next): Q.family.Carrier twice := Last.first (#apply{nextMap} (#apply{After.firstInjection} y));
\definition firstBoundary(y: Q.family.Carrier next):
  #apply{differential} n (#apply{After.firstInjection} y) = #apply{Here.firstInjection} (#apply{Q.differential} next y) :=
  #commutes{Cone.inclusion} next y;
\definition secondEquation(y: Q.family.Carrier next): #zero{(P.family.space z)} =
  PGroup.add (PGroup.neg (#apply{P.differential} next (upperBackward y))) (#apply{backward} (#apply{Q.differential} next y)) :=
  trans!{{P.family.Carrier z}} _ _ _
    (congr!{After.Carrier {P.family.Carrier z}} After.second _ _ (upperEquation (#apply{After.firstInjection} y)))
    (congr!{Here.Carrier {P.family.Carrier z}}
      (\fun (v: Here.Carrier) => PGroup.add (PGroup.neg (#apply{P.differential} next (upperBackward y))) (#apply{secondOutput} v)) _ _
      (firstBoundary y));
\definition commutes(y: Q.family.Carrier next):
  #apply{P.differential} next (upperBackward y) = #apply{backward} (#apply{Q.differential} next y) :=
  PGroup.cancelLeft (PGroup.neg (#apply{P.differential} next (upperBackward y)))
    (#apply{P.differential} next (upperBackward y)) (#apply{backward} (#apply{Q.differential} next y))
    (trans!{{P.family.Carrier z}} _ _ _ (PGroup.inverseLeft (#apply{P.differential} next (upperBackward y))) (secondEquation y));
\import Modules.Laws[V := Q.family.Carrier next, space := Q.family.space next] \as QNextLaws;
\import algebra.Group[].Of[Carrier := Q.family.Carrier next, group := QNextLaws.additive] \as QNextGroup;
\definition targetRaw(y: Q.family.Carrier next): y =
  QNextGroup.add
    (QNextGroup.add (#apply{Q.differential} twice (upperFirst y)) (#apply{f} next (upperBackward y)))
    (#apply{firstBlock} (#apply{Q.differential} next y)) :=
  trans!{{Q.family.Carrier next}} _ _ _
    (congr!{After.Carrier {Q.family.Carrier next}} After.first _ _ (upperEquation (#apply{After.firstInjection} y)))
    (congr!{Here.Carrier {Q.family.Carrier next}}
      (\fun (v: Here.Carrier) => QNextGroup.add
        (QNextGroup.add (#apply{Q.differential} twice (upperFirst y)) (#apply{f} next (upperBackward y))) (#apply{firstOutput} v)) _ _
      (firstBoundary y));
\definition targetBalance(a, b, c, x: Q.family.Carrier next):
  x = QNextGroup.add (QNextGroup.add a b) c ->
  QNextGroup.difference b x = QNextGroup.add (QNextGroup.neg a) (QNextGroup.neg c) :=
  \fun (equation: _) => trans!{{Q.family.Carrier next}} _ _ _
    (QNextGroup.balancedDifference b x QNextGroup.zero (QNextGroup.add a c)
      (trans!{{Q.family.Carrier next}} _ _ _
        (sym!{{Q.family.Carrier next}} _ _ (trans!{{Q.family.Carrier next}} _ _ _ equation
          (trans!{{Q.family.Carrier next}} _ _ _
            (congr!{{Q.family.Carrier next} {Q.family.Carrier next}} (\fun (v: Q.family.Carrier next) => QNextGroup.add v c) _ _ (QNextGroup.comm a b))
            (QNextGroup.assoc b a c))))
        (sym!{{Q.family.Carrier next}} _ _ (QNextGroup.zeroLeft x))))
    (trans!{{Q.family.Carrier next}} _ _ _ (QNextGroup.zeroLeft (QNextGroup.neg (QNextGroup.add a c))) (QNextGroup.negAdd a c));
\definition targetEquation(y: Q.family.Carrier next):
  QNextGroup.difference (#apply{f} next (upperBackward y)) y =
    QNextGroup.add (QNextGroup.neg (#apply{Q.differential} twice (upperFirst y)))
      (QNextGroup.neg (#apply{firstBlock} (#apply{Q.differential} next y))) :=
  targetBalance (#apply{Q.differential} twice (upperFirst y)) (#apply{f} next (upperBackward y))
    (#apply{firstBlock} (#apply{Q.differential} next y)) y (targetRaw y);

\import SignedChains.At[C := Q, z := twice] \as UpperQBoundary;
\import Modules.Hom[V := Q.family.Carrier twice, W := Q.family.Carrier next,
  source := Q.family.space twice, target := Q.family.space next] \as UpperQBoundaryMaps;
\definition targetHomotopyEquation(y: Q.family.Carrier next):
  QNextGroup.difference (#apply{f} next (upperBackward y)) y =
    QNextGroup.add (#apply{Q.differential} twice (#neg{(Q.family.space twice)} (upperFirst y)))
      (#apply{targetHomotopy} (#apply{Q.differential} next y)) :=
  trans!{{Q.family.Carrier next}} _ _ _ (targetEquation y)
    (congr!{{Q.family.Carrier next} {Q.family.Carrier next}}
      (\fun (v: Q.family.Carrier next) => QNextGroup.add v (#apply{targetHomotopy} (#apply{Q.differential} next y))) _ _
      (sym!{{Q.family.Carrier next}} _ _ (UpperQBoundaryMaps.negativePreserved UpperQBoundary.differential (upperFirst y))));
