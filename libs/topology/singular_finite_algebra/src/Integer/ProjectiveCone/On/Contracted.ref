\module At(n: N.Nat^);
\definition backward: \forall (z: I.Int^) -> Q.family.Carrier z -> P.family.Carrier z :=
  \induction (z: I.Int^) \return Q.family.Carrier z -> P.family.Carrier z \with {
    | ofNat: \fun (n: N.Nat^) => (At[n := n].backward).apply
    | negSucc: \fun (n: N.Nat^)(x: Q.family.Carrier (I.Int^::negSucc n)) => (P.family.space (I.Int^::negSucc n)).zero
  };
\definition sourceOperator: \forall (z: I.Int^) -> P.family.Carrier z -> P.family.Carrier (Degrees.next z) :=
  \induction (z: I.Int^) \return P.family.Carrier z -> P.family.Carrier (Degrees.next z) \with {
    | ofNat: \fun (n: N.Nat^) => (At[n := n].sourceHomotopy).apply
    | negSucc: \fun (n: N.Nat^)(x: P.family.Carrier (I.Int^::negSucc n)) => (P.family.space (Degrees.next (I.Int^::negSucc n))).zero
  };
\definition targetOperator: \forall (z: I.Int^) -> Q.family.Carrier z -> Q.family.Carrier (Degrees.next z) :=
  \induction (z: I.Int^) \return Q.family.Carrier z -> Q.family.Carrier (Degrees.next z) \with {
    | ofNat: \fun (n: N.Nat^) => (At[n := n].targetHomotopy).apply
    | negSucc: \fun (n: N.Nat^)(x: Q.family.Carrier (I.Int^::negSucc n)) => (Q.family.space (Degrees.next (I.Int^::negSucc n))).zero
  };
\module Zero;
\module Negative(n: N.Nat^);
\definition backwardAddition: \forall (z: I.Int^) (x, y: Q.family.Carrier z) -> backward z ((Q.family.space z).add x y) = (P.family.space z).add (backward z x) (backward z y) :=
  \induction (z: I.Int^) \return \forall (x, y: Q.family.Carrier z) -> backward z ((Q.family.space z).add x y) = (P.family.space z).add (backward z x) (backward z y) \with {
    | ofNat: \fun (n: N.Nat^) => (At[n := n].backward).addition
    | negSucc: \fun (n: N.Nat^) => (Negative[n := n].backwardMap).addition
  };
\definition backwardScalar: \forall (z: I.Int^) (a: I.Int^)(x: Q.family.Carrier z) -> backward z ((Q.family.space z).smul a x) = (P.family.space z).smul a (backward z x) :=
  \induction (z: I.Int^) \return \forall (a: I.Int^)(x: Q.family.Carrier z) -> backward z ((Q.family.space z).smul a x) = (P.family.space z).smul a (backward z x) \with {
    | ofNat: \fun (n: N.Nat^) => (At[n := n].backward).scalar
    | negSucc: \fun (n: N.Nat^) => (Negative[n := n].backwardMap).scalar
  };
\definition sourceOperatorAddition: \forall (z: I.Int^) (x, y: P.family.Carrier z) -> sourceOperator z ((P.family.space z).add x y) = (P.family.space (Degrees.next z)).add (sourceOperator z x) (sourceOperator z y) :=
  \induction (z: I.Int^) \return \forall (x, y: P.family.Carrier z) -> sourceOperator z ((P.family.space z).add x y) = (P.family.space (Degrees.next z)).add (sourceOperator z x) (sourceOperator z y) \with {
    | ofNat: \fun (n: N.Nat^) => (At[n := n].sourceHomotopy).addition
    | negSucc: \fun (n: N.Nat^) => (Negative[n := n].sourceMap).addition
  };
\definition sourceOperatorScalar: \forall (z: I.Int^) (a: I.Int^)(x: P.family.Carrier z) -> sourceOperator z ((P.family.space z).smul a x) = (P.family.space (Degrees.next z)).smul a (sourceOperator z x) :=
  \induction (z: I.Int^) \return \forall (a: I.Int^)(x: P.family.Carrier z) -> sourceOperator z ((P.family.space z).smul a x) = (P.family.space (Degrees.next z)).smul a (sourceOperator z x) \with {
    | ofNat: \fun (n: N.Nat^) => (At[n := n].sourceHomotopy).scalar
    | negSucc: \fun (n: N.Nat^) => (Negative[n := n].sourceMap).scalar
  };
\definition targetOperatorAddition: \forall (z: I.Int^) (x, y: Q.family.Carrier z) -> targetOperator z ((Q.family.space z).add x y) = (Q.family.space (Degrees.next z)).add (targetOperator z x) (targetOperator z y) :=
  \induction (z: I.Int^) \return \forall (x, y: Q.family.Carrier z) -> targetOperator z ((Q.family.space z).add x y) = (Q.family.space (Degrees.next z)).add (targetOperator z x) (targetOperator z y) \with {
    | ofNat: \fun (n: N.Nat^) => (At[n := n].targetHomotopy).addition
    | negSucc: \fun (n: N.Nat^) => (Negative[n := n].targetMap).addition
  };
\definition targetOperatorScalar: \forall (z: I.Int^) (a: I.Int^)(x: Q.family.Carrier z) -> targetOperator z ((Q.family.space z).smul a x) = (Q.family.space (Degrees.next z)).smul a (targetOperator z x) :=
  \induction (z: I.Int^) \return \forall (a: I.Int^)(x: Q.family.Carrier z) -> targetOperator z ((Q.family.space z).smul a x) = (Q.family.space (Degrees.next z)).smul a (targetOperator z x) \with {
    | ofNat: \fun (n: N.Nat^) => (At[n := n].targetHomotopy).scalar
    | negSucc: \fun (n: N.Nat^) => (Negative[n := n].targetMap).scalar
  };
\import SignedChains.Homotopy[C := P, D := P] \as SourceHomotopies;
\import SignedChains.Homotopy[C := Q, D := Q] \as TargetHomotopies;
\definition sourceData: SourceHomotopies.Data := SourceHomotopies.Data { apply := sourceOperator };
\definition targetData: TargetHomotopies.Data := TargetHomotopies.Data { apply := targetOperator };
\module Proved(sourceNegative: SourceNegative, targetNegative: TargetNegative);
