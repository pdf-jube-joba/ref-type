\module At(n: N.Nat^);
\definition backward: \forall (z: I.Int^) -> Q.family.Carrier z -> P.family.Carrier z :=
  \induction (z: I.Int^) \return Q.family.Carrier z -> P.family.Carrier z \with {
    | ofNat: \fun (n: N.Nat^) => #apply{At[n := n].backward}
    | negSucc: \fun (n: N.Nat^)(x: Q.family.Carrier (I.Int^::negSucc n)) => #zero{(P.family.space (I.Int^::negSucc n))}
  };
\definition sourceOperator: \forall (z: I.Int^) -> P.family.Carrier z -> P.family.Carrier (Degrees.next z) :=
  \induction (z: I.Int^) \return P.family.Carrier z -> P.family.Carrier (Degrees.next z) \with {
    | ofNat: \fun (n: N.Nat^) => #apply{At[n := n].sourceHomotopy}
    | negSucc: \fun (n: N.Nat^)(x: P.family.Carrier (I.Int^::negSucc n)) => #zero{(P.family.space (Degrees.next (I.Int^::negSucc n)))}
  };
\definition targetOperator: \forall (z: I.Int^) -> Q.family.Carrier z -> Q.family.Carrier (Degrees.next z) :=
  \induction (z: I.Int^) \return Q.family.Carrier z -> Q.family.Carrier (Degrees.next z) \with {
    | ofNat: \fun (n: N.Nat^) => #apply{At[n := n].targetHomotopy}
    | negSucc: \fun (n: N.Nat^)(x: Q.family.Carrier (I.Int^::negSucc n)) => #zero{(Q.family.space (Degrees.next (I.Int^::negSucc n)))}
  };
\module Zero;
\module Negative(n: N.Nat^);
\definition backwardAddition: \forall (z: I.Int^) (x, y: Q.family.Carrier z) -> backward z (#add{(Q.family.space z)} x y) = #add{(P.family.space z)} (backward z x) (backward z y) :=
  \induction (z: I.Int^) \return \forall (x, y: Q.family.Carrier z) -> backward z (#add{(Q.family.space z)} x y) = #add{(P.family.space z)} (backward z x) (backward z y) \with {
    | ofNat: \fun (n: N.Nat^) => #addition{At[n := n].backward}
    | negSucc: \fun (n: N.Nat^) => #addition{Negative[n := n].backwardMap}
  };
\definition backwardScalar: \forall (z: I.Int^) (a: I.Int^)(x: Q.family.Carrier z) -> backward z (#smul{(Q.family.space z)} a x) = #smul{(P.family.space z)} a (backward z x) :=
  \induction (z: I.Int^) \return \forall (a: I.Int^)(x: Q.family.Carrier z) -> backward z (#smul{(Q.family.space z)} a x) = #smul{(P.family.space z)} a (backward z x) \with {
    | ofNat: \fun (n: N.Nat^) => #scalar{At[n := n].backward}
    | negSucc: \fun (n: N.Nat^) => #scalar{Negative[n := n].backwardMap}
  };
\definition sourceOperatorAddition: \forall (z: I.Int^) (x, y: P.family.Carrier z) -> sourceOperator z (#add{(P.family.space z)} x y) = #add{(P.family.space (Degrees.next z))} (sourceOperator z x) (sourceOperator z y) :=
  \induction (z: I.Int^) \return \forall (x, y: P.family.Carrier z) -> sourceOperator z (#add{(P.family.space z)} x y) = #add{(P.family.space (Degrees.next z))} (sourceOperator z x) (sourceOperator z y) \with {
    | ofNat: \fun (n: N.Nat^) => #addition{At[n := n].sourceHomotopy}
    | negSucc: \fun (n: N.Nat^) => #addition{Negative[n := n].sourceMap}
  };
\definition sourceOperatorScalar: \forall (z: I.Int^) (a: I.Int^)(x: P.family.Carrier z) -> sourceOperator z (#smul{(P.family.space z)} a x) = #smul{(P.family.space (Degrees.next z))} a (sourceOperator z x) :=
  \induction (z: I.Int^) \return \forall (a: I.Int^)(x: P.family.Carrier z) -> sourceOperator z (#smul{(P.family.space z)} a x) = #smul{(P.family.space (Degrees.next z))} a (sourceOperator z x) \with {
    | ofNat: \fun (n: N.Nat^) => #scalar{At[n := n].sourceHomotopy}
    | negSucc: \fun (n: N.Nat^) => #scalar{Negative[n := n].sourceMap}
  };
\definition targetOperatorAddition: \forall (z: I.Int^) (x, y: Q.family.Carrier z) -> targetOperator z (#add{(Q.family.space z)} x y) = #add{(Q.family.space (Degrees.next z))} (targetOperator z x) (targetOperator z y) :=
  \induction (z: I.Int^) \return \forall (x, y: Q.family.Carrier z) -> targetOperator z (#add{(Q.family.space z)} x y) = #add{(Q.family.space (Degrees.next z))} (targetOperator z x) (targetOperator z y) \with {
    | ofNat: \fun (n: N.Nat^) => #addition{At[n := n].targetHomotopy}
    | negSucc: \fun (n: N.Nat^) => #addition{Negative[n := n].targetMap}
  };
\definition targetOperatorScalar: \forall (z: I.Int^) (a: I.Int^)(x: Q.family.Carrier z) -> targetOperator z (#smul{(Q.family.space z)} a x) = #smul{(Q.family.space (Degrees.next z))} a (targetOperator z x) :=
  \induction (z: I.Int^) \return \forall (a: I.Int^)(x: Q.family.Carrier z) -> targetOperator z (#smul{(Q.family.space z)} a x) = #smul{(Q.family.space (Degrees.next z))} a (targetOperator z x) \with {
    | ofNat: \fun (n: N.Nat^) => #scalar{At[n := n].targetHomotopy}
    | negSucc: \fun (n: N.Nat^) => #scalar{Negative[n := n].targetMap}
  };
\import SignedChains.Homotopy[C := P, D := P] \as SourceHomotopies;
\import SignedChains.Homotopy[C := Q, D := Q] \as TargetHomotopies;
\definition sourceData: SourceHomotopies.Data := SourceHomotopies.Data { apply := sourceOperator };
\definition targetData: TargetHomotopies.Data := TargetHomotopies.Data { apply := targetOperator };
\module Proved(sourceNegative: SourceNegative, targetNegative: TargetNegative);
