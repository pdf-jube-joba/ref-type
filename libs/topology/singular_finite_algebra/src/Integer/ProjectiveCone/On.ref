\import SignedChains.Cone[C := P, D := Q].On[f := f] \as Cone;
\import chain_complexes.Chain[] \as Degrees;
\definition family: Native.Family := Native.Family {
  Carrier := \fun (n: N.Nat^) => Cone.Carrier (I.Int^::ofNat n),
  space := \fun (n: N.Nat^) => Cone.space (I.Int^::ofNat n),
};
\definition differential: Native.DifferentialData[family] := Native.DifferentialData[family] {
  apply := \fun (n: N.Nat^) => #apply{Cone.differential} (I.Int^::ofNat (N.Nat^::succ n)),
};
\definition complex: Native.Complex := Native.Complex {
  family := family, differential := differential,
  laws := Native.DifferentialLaws[family, differential] {
    addition := \fun (n: N.Nat^) => #addition{Cone.complex.laws} (I.Int^::ofNat (N.Nat^::succ n)),
    scalar := \fun (n: N.Nat^) => #scalar{Cone.complex.laws} (I.Int^::ofNat (N.Nat^::succ n)),
    squareZero := \fun (n: N.Nat^) => #squareZero{Cone.complex.laws} (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n))),
  },
};
\import resolutions.Resolution[].Over[R := I.Int^, ring := Integers.ring].AcyclicProjective[P := complex] \as Acyclic;
\module Degree(n: N.Nat^) {
  \definition z: I.Int^ := I.Int^::ofNat n;
  \definition previous: I.Int^ := Degrees.previous z;
  \definition first: Modules.Bundle := Modules.Bundle { Carrier := Q.family.Carrier z, space := Q.family.space z };
  \definition second: Modules.Bundle := Modules.Bundle { Carrier := P.family.Carrier previous, space := P.family.space previous };
  \import ProjectiveLaws.Biproduct[P := first, Q := second] \as Sum;
  \definition projective(left: Modules.Projective first)(right: Modules.Projective second):
    Modules.Projective (Modules.Bundle { Carrier := family.Carrier n, space := family.space n }) := Sum.projective left right;
}
\definition firstNegative: Modules.Bundle := Modules.Bundle {
  Carrier := P.family.Carrier (I.Int^::negSucc N.Nat^::zero), space := P.family.space (I.Int^::negSucc N.Nat^::zero),
};
\import ProjectiveLaws.Trivial[P := firstNegative] \as Negative;
\definition previousProjective: SourceProjective -> SourceNegative -> \forall (n: N.Nat^) -> Modules.Projective (Modules.Bundle { Carrier := P.family.Carrier (Degrees.previous (I.Int^::ofNat n)), space := P.family.space (Degrees.previous (I.Int^::ofNat n)) }) :=
  \fun (projective: SourceProjective)(negative: SourceNegative) =>
  \induction (n: N.Nat^) \return Modules.Projective (Modules.Bundle { Carrier := P.family.Carrier (Degrees.previous (I.Int^::ofNat n)), space := P.family.space (Degrees.previous (I.Int^::ofNat n)) }) \with {
    | zero: Negative.projective (negative N.Nat^::zero)
    | succ: \fun (n: N.Nat^)(before: Modules.Projective (Modules.Bundle { Carrier := P.family.Carrier (Degrees.previous (I.Int^::ofNat n)), space := P.family.space (Degrees.previous (I.Int^::ofNat n)) })) => projective n
  };
\definition projective(source: SourceProjective)(target: TargetProjective)(negative: SourceNegative): Acyclic.Projective :=
  \fun (n: N.Nat^) => Degree[n := n].projective (target n) (previousProjective source negative n);
\import std.Data[].Pair[].Prop[A := Q.family.Carrier (I.Int^::negSucc N.Nat^::zero), B := P.family.Carrier (I.Int^::negSucc (N.Nat^::succ N.Nat^::zero))] \as NegativePairs;
\import Cone.At[k := I.Int^::negSucc N.Nat^::zero] \as Below;
\definition zeroClosed(source: SourceNegative)(target: TargetNegative)(x: family.Carrier N.Nat^::zero):
  #apply{Cone.complex.differential} (I.Int^::ofNat N.Nat^::zero) x = #zero{(Cone.space (I.Int^::negSucc N.Nat^::zero))} :=
  NegativePairs.ext _ _
    (target N.Nat^::zero (Below.first (#apply{Cone.complex.differential} (I.Int^::ofNat N.Nat^::zero) x)))
    (source (N.Nat^::succ N.Nat^::zero) (Below.second (#apply{Cone.complex.differential} (I.Int^::ofNat N.Nat^::zero) x)));
\module Boundary(n: N.Nat^) {
  \definition z: I.Int^ := I.Int^::ofNat n;
  \import SignedChains.At[C := Cone.complex, z := z] \as H;
  \import Modules.Of[V := Cone.Carrier z, space := Cone.space z].Submodule[].Image[
    U := Cone.Carrier (Degrees.next z), source := Cone.space (Degrees.next z)] \as Images;
  \import std.Logic[].Equality[].Transport[A := I.Int^] \as Transport;
  \definition priorEquation(y: family.Carrier (N.Nat^::succ n)):
    #apply{H.prior} y = #apply{differential} n y :=
    Transport.castRefl Cone.complex.family.Carrier z (#apply{differential} n y);
  \definition exists(quasi: Maps.QuasiIsomorphism f)(x: family.Carrier n)
    (closed: #apply{Cone.complex.differential} z x = #zero{(Cone.space (Degrees.previous z))}):
    \exists { y: family.Carrier (N.Nat^::succ n) \where #apply{differential} n y = x } :=
    Images.eliminate H.prior x
      (\exists { y: family.Carrier (N.Nat^::succ n) \where #apply{differential} n y = x })
      (\fun (y: Cone.Carrier (Degrees.next z))(equation: #apply{H.prior} y = x) =>
        Logic.existsIntro[family.Carrier (N.Nat^::succ n), { y: family.Carrier (N.Nat^::succ n) \where #apply{differential} n y = x }] y
          (trans!{{family.Carrier n}} _ _ _ (sym!{{family.Carrier n}} _ _ (priorEquation y)) equation))
      (H.zeroClassBoundary (H.cycle x closed) (Cone.Criterion[].acyclic quasi z (H.classOf (H.cycle x closed))));
}
\definition exact(source: SourceNegative)(target: TargetNegative)(quasi: Maps.QuasiIsomorphism f): Acyclic.Exact := Acyclic.Exact {
  zero := \fun (x: family.Carrier N.Nat^::zero) => Boundary[n := N.Nat^::zero].exists quasi x (zeroClosed source target x),
  positive := \fun (n: N.Nat^)(x: family.Carrier (N.Nat^::succ n))(closed: _) => Boundary[n := N.Nat^::succ n].exists quasi x closed,
};
\import Native.End[C := complex] \as End;
\import Native.Map[C := complex, D := complex].Additive[] \as Additive;
\import Native.Homotopy[C := complex, D := complex] \as Homotopies;
\definition contractible(sourceProjective: SourceProjective)(targetProjective: TargetProjective)
  (sourceNegative: SourceNegative)(targetNegative: TargetNegative)(quasi: Maps.QuasiIsomorphism f):
  \exists Homotopies.Homotopy End.identity Additive.zero :=
  Acyclic.contractible (projective sourceProjective targetProjective sourceNegative) (exact sourceNegative targetNegative quasi);
\module Contracted(h: Homotopies.Homotopy End.identity Additive.zero);

\import SignedChains.Equivalence[C := P, D := Q] \as Equivalences;
\definition equivalenceExists(sourceProjective: SourceProjective)(targetProjective: TargetProjective)
  (sourceNegative: SourceNegative)(targetNegative: TargetNegative)(quasi: Maps.QuasiIsomorphism f):
  \exists { e: Equivalences.Equivalence \where #forward{e} = f } := \block {
  \takefrom h: Homotopies.Homotopy End.identity Additive.zero
    \by contractible sourceProjective targetProjective sourceNegative targetNegative quasi \then
  \return Logic.existsIntro[Equivalences.Equivalence, { e: Equivalences.Equivalence \where #forward{e} = f }]
    (Contracted[h := h].Proved[sourceNegative := sourceNegative, targetNegative := targetNegative].equivalence) (\refl(f))
};
