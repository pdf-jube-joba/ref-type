\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import chain_complexes.Chain[] \as Degrees;
\import Degrees.Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import resolutions.TensorComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Integer[P := P, N := coefficients] \as Source;
\import resolutions.TensorComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Integer[P := Q, N := coefficients] \as Middle;
\import resolutions.TensorComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].Integer[P := T, N := coefficients] \as Target;
\import Chains.Map[C := P, D := Q] \as Before;
\import Chains.Map[C := Q, D := T] \as After;
\import After.Composition[B := P] \as Original;
\import Modules.End[V := coefficients.Carrier, space := coefficients.space] \as Coefficients;
\import \root.Integer[].CoefficientTensor[P := P, Q := Q, coefficients := coefficients] \as First;
\import \root.Integer[].CoefficientTensor[P := Q, Q := T, coefficients := coefficients] \as Second;
\import \root.Integer[].CoefficientTensor[P := P, Q := T, coefficients := coefficients] \as Direct;
\import Chains.Map[C := Middle.complex, D := Target.complex].Composition[B := Source.complex] \as Composition;
\import Chains.Map[C := Source.complex, D := Target.complex] \as Maps;
\module At(n: Degrees.Degree) {
  \import Modules.Tensor[V := P.family.Carrier n, W := coefficients.Carrier, left := P.family.space n, right := coefficients.space] \as S;
  \import Modules.Tensor[V := T.family.Carrier n, W := coefficients.Carrier, left := T.family.space n, right := coefficients.space] \as D;
  \import S.Universal[U := D.Carrier, target := D.space] \as Universal;
  \import Modules.Hom[V := S.Carrier, W := D.Carrier, source := S.space, target := D.space] \as Native;
  \definition direct(f: Before.Map)(g: After.Map): Native.Map := Direct.On[f := Original.compose g f].At[z := n].map;
  \definition composed(f: Before.Map)(g: After.Map): Native.Map := Native.Map {
    apply := #apply{(Composition.compose (Second.On[f := g].map) (First.On[f := f].map))} n,
    addition := #addition{(Composition.compose (Second.On[f := g].map) (First.On[f := f].map))} n,
    scalar := #scalar{(Composition.compose (Second.On[f := g].map) (First.On[f := f].map))} n,
  };
  \definition law: \forall (f: Before.Map)(g: After.Map) -> direct f g = composed f g :=
    \fun (f: Before.Map)(g: After.Map) => Universal.ext (direct f g) (composed f g)
      (\fun (x: P.family.Carrier n)(y: coefficients.Carrier) => trans!{D.Carrier} _ _ _
        (Direct.On[f := Original.compose g f].At[z := n].onTensor x y)
        (sym!{D.Carrier} _ _ (trans!{D.Carrier} _ _ _
          (congr!{{Middle.Carrier n} D.Carrier} (#apply{(Second.On[f := g].At[z := n].map)}) _ _
            (First.On[f := f].At[z := n].onTensor x y))
          (Second.On[f := g].At[z := n].onTensor (#apply{f} n x) y))));
  \definition pointwise: \forall (f: Before.Map)(g: After.Map)(x: S.Carrier) -> #apply{(direct f g)} x = #apply{(composed f g)} x :=
    \fun (f: Before.Map)(g: After.Map)(x: S.Carrier) => congr!{Native.Map D.Carrier} (\fun (h: Native.Map) => #apply{h} x) _ _ (law f g);
}
\definition law: \forall (f: Before.Map)(g: After.Map) -> Direct.On[f := Original.compose g f].map =
  Composition.compose (Second.On[f := g].map) (First.On[f := f].map) :=
  \fun (f: Before.Map)(g: After.Map) => Maps.ext _ _ (\fun (n: Degrees.Degree) => At[n := n].pointwise f g);
