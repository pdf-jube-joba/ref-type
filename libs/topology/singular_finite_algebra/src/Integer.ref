\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\module Middle(A, B, C, D: Modules.Bundle, sequence: Modules.ShortExact[A := A, B := B, C := C].Sequence,
  isomorphism: Modules.Isomorphism[V := B.Carrier, W := D.Carrier, source := B.space, target := D.space].Isomorphism);
\module Finite(X: \Set, topology: topology.Topology[Carrier := X].Topology, model: homological_algebra.Finite[].Bounded[].Complex);
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as SignedChains;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\module HomZero(P: Native.Complex, coefficients: Modules.Bundle);
\module HomTransport(V, W: Modules.Bundle, coefficients: Modules.Bundle);
\module ProjectiveCone(P, Q: SignedChains.Complex);
\module Attachment(coefficients, first, second: Modules.Bundle);
\module Units;
\module CoefficientTensor(P, Q: SignedChains.Complex,
  coefficients: Modules.Bundle);
\module CoefficientComposition(P, Q, T: SignedChains.Complex,
  coefficients: Modules.Bundle);
\module CoefficientIdentity(P: SignedChains.Complex,
  coefficients: Modules.Bundle);
\module CoefficientEquivalence(P, Q: SignedChains.Complex,
  coefficients: Modules.Bundle);
\module Product(X, Y: \Set, left: topology.Topology[Carrier := X].Topology,
  right: topology.Topology[Carrier := Y].Topology,
  first, second: homological_algebra.Finite[].Bounded[].Complex);
