\import std.Data[].List[] \as Lists;
\definition sum(ring: Ring.CommutativeRing[K]) (indices: Lists.List[J]) (f: J -> K): K :=
  Lists.foldr J K (\fun (j: J) (tail: K) => #add{(#base{ring})} (f j) tail) (#zero{(#base{ring})}) indices;
\definition multiply(ring: Ring.CommutativeRing[K]) (indices: Lists.List[J]) (a: Carrier) (b: J -> H -> K): I -> H -> K :=
  \fun (i: I) (h: H) => sum ring indices (\fun (j: J) => #mul{(#base{ring})} (a i j) (b j h));
\module Functions(A: \Set);
