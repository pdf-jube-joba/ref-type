\import std.Alg[].Field[] \as Fields;
\import std.Data[].List[] \as Lists;
\import Algebra.Sums[I := I] \as Sums;
\import topological_algebra.Topology[K := K] \as Structures;
\import Structures.Functions[A := A] \as Operations;
\import topology.Topology[Carrier := A] \as Source;
\import topology.Topology[Carrier := K] \as Scalars;
\import topology.Continuity[A := A, B := K] \as Maps;
\import topology.Maps[A := A, B := K] \as Constants;
\definition scalarRing: _ := Fields.fieldAsCommutativeRing K field;
\definition sum(indices: Lists.List[I]) (f: I -> A -> K): A -> K :=
  \fun (x: A) => Sums.sum indices (\fun (i: I) => f i x);
\definition sumContinuous: \forall (source: Source.Topology) (scalar: Scalars.Topology) -> Structures.RingLaws[scalar, scalarRing] ->
  \forall (indices: Lists.List[I]) (f: I -> A -> K) -> (\forall (i: I) -> Maps.Continuous source scalar (f i)) ->
  Maps.Continuous source scalar (sum indices f) :=
  \fun (source: _) (scalar: _) (laws: _) =>
  \induction (indices: Lists.List[I]) \return \forall (f: I -> A -> K) ->
    (\forall (i: I) -> Maps.Continuous source scalar (f i)) -> Maps.Continuous source scalar (sum indices f) \with {
      | nil: \fun (f: _) (fc: _) => Constants.constantContinuous source scalar Algebra.zero
      | cons: \fun (i: I) (tail: Lists.List[I]) (ih: _) (f: _) (fc: _) =>
        Operations.ringAdditionContinuous source scalar scalarRing laws (f i) (sum tail f) (fc i) (ih f fc)
    };
