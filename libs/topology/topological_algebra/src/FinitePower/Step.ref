\import \parent.At[n := n] \as Lower;
\import \parent.At[n := N.Nat^::succ n] \as Higher;
\import Fin.Tuples[A := K] \as Tuples;
\import std.Data[].Pair[] \as Pair;
\import topological_constructions.Product[A := K, B := Carrier n] \as Product;
\import Product.Maps[] \as Projections;
\import Product.Compactness[] \as ProductCompact;
\import \root.Coordinates[K := K, I := Fin.Fin n] \as LowerCoordinates;
\import \root.Coordinates[K := K, I := Fin.Fin (N.Nat^::succ n)].Universal[A := Product.CarrierSet] \as Universal;
\import topology.Topology[Carrier := Product.CarrierSet] \as ProductSpace;
\import topology.Topology[Carrier := Carrier n] \as LowerSpace;
\import topology.Topology[Carrier := Carrier (N.Nat^::succ n)] \as HigherSpace;
\import topology.Continuity[A := Product.CarrierSet, B := K] \as Maps;
\import topology.Composition[A := Product.CarrierSet, B := Carrier n, C := K] \as Compose;
\import topology.Compactness[A := Product.CarrierSet, B := Carrier (N.Nat^::succ n)] \as Image;
\definition assemble[p: Product.CarrierSet]: Carrier (N.Nat^::succ n) := Tuples.extend n (Pair.first K (Carrier n) p) (Pair.second K (Carrier n) p);
\definition headContinuous: \forall (scalar: Scalars.Topology) -> Maps.Continuous (Product.topology scalar (Lower.topology scalar)) scalar (\fun (p: Product.CarrierSet) => assemble p (Fin.zero n)) :=
  \fun (scalar: Scalars.Topology) => \idelim (Pair.first K (Carrier n)) = (\fun (p: Product.CarrierSet) => assemble p (Fin.zero n))
    \with f: (Product.CarrierSet -> K) => Maps.Continuous (Product.topology scalar (Lower.topology scalar)) scalar f \by {
      base: Projections.firstContinuous scalar (Lower.topology scalar),
      equality: \axiom:funext((Pair.first K (Carrier n)), (\fun (p: Product.CarrierSet) => assemble p (Fin.zero n)),
        \fun (p: Product.CarrierSet) => sym!{K} _ _ (Tuples.atZero n (Pair.first K (Carrier n) p) (Pair.second K (Carrier n) p)))
    };
\definition tailContinuous: \forall (scalar: Scalars.Topology)(i: Fin.Fin n) -> Maps.Continuous (Product.topology scalar (Lower.topology scalar)) scalar (\fun (p: Product.CarrierSet) => assemble p (Fin.succ n i)) :=
  \fun (scalar: Scalars.Topology)(i: Fin.Fin n) => \idelim (\fun (p: Product.CarrierSet) => Pair.second K (Carrier n) p i) = (\fun (p: Product.CarrierSet) => assemble p (Fin.succ n i))
    \with f: (Product.CarrierSet -> K) => Maps.Continuous (Product.topology scalar (Lower.topology scalar)) scalar f \by {
      base: Compose.composeContinuous (Product.topology scalar (Lower.topology scalar)) (Lower.topology scalar) scalar (Pair.second K (Carrier n)) (LowerCoordinates.evaluate i)
        (Projections.secondContinuous scalar (Lower.topology scalar)) (LowerCoordinates.evaluationContinuous scalar i),
      equality: \axiom:funext((\fun (p: Product.CarrierSet) => Pair.second K (Carrier n) p i), (\fun (p: Product.CarrierSet) => assemble p (Fin.succ n i)),
        \fun (p: Product.CarrierSet) => sym!{K} _ _ (Tuples.atSuccessor n (Pair.first K (Carrier n) p) (Pair.second K (Carrier n) p) i))
    };
\definition continuous: \forall (scalar: Scalars.Topology) -> topology.Continuity[A := Product.CarrierSet, B := Carrier (N.Nat^::succ n)].Continuous (Product.topology scalar (Lower.topology scalar)) (Higher.topology scalar) assemble :=
  \fun (scalar: Scalars.Topology) => Universal.continuous (Product.topology scalar (Lower.topology scalar)) scalar assemble
    (Fin.cases n (\fun (i: Fin.Fin (N.Nat^::succ n)) => Maps.Continuous (Product.topology scalar (Lower.topology scalar)) scalar (\fun (p: Product.CarrierSet) => assemble p i)) (headContinuous scalar) (tailContinuous scalar));
\definition onto: \forall (x: Carrier (N.Nat^::succ n)) -> \exists ( p: Product.CarrierSet \where assemble p = x ) :=
  \fun (x: Carrier (N.Nat^::succ n)) => Logic.existsIntro[Product.CarrierSet, { p: Product.CarrierSet \where assemble p = x }]
    (Pair.pair K (Carrier n) (x (Fin.zero n)) (\fun (i: Fin.Fin n) => x (Fin.succ n i))) (Tuples.recover n x);
\definition compact: \forall (scalar: Scalars.Topology) -> Scalars.IsCompact scalar -> LowerSpace.IsCompact (Lower.topology scalar) -> HigherSpace.IsCompact (Higher.topology scalar) :=
  \fun (scalar: Scalars.Topology)(factor: Scalars.IsCompact scalar)(previous: LowerSpace.IsCompact (Lower.topology scalar)) =>
    Image.surjectiveImage (Product.topology scalar (Lower.topology scalar)) (Higher.topology scalar) assemble (continuous scalar) onto
      (ProductCompact.productCompact scalar (Lower.topology scalar) factor previous);
