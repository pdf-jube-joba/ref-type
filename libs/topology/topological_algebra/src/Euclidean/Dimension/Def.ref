\definition origin: Point := \fun (i: _) => zero;
\definition addPoint(x, y: Point): Point := \fun (i: _) => add (x i) (y i);
\definition subPoint(x, y: Point): Point := \fun (i: _) => sub (x i) (y i);
\definition scale(c: Real) (x: Point): Point := \fun (i: _) => mul c (x i);

\definition replace(x: Point) (i: Coordinate) (t: Real): Point :=
  \fun (j: _) => Bool.ite Real (NatOp.eqb (Fin.value n j) (Fin.value n i)) t (x j);

\definition basis(i: Coordinate): Point := replace origin i one;
\definition constantFunction(c: Real): Function := \fun (x: _) => c;
\definition projection(i: Coordinate): Function := \fun (x: _) => x i;

\definition finiteMax: \forall (m: N.Nat^) -> (Fin.Fin m -> Real) -> Real :=
  \induction (m: N.Nat^) \return (Fin.Fin m -> Real) -> Real \with {
    | zero: \fun (x: Fin.Fin N.Nat^::zero -> Real) => zero
    | succ: \fun (m: N.Nat^) (previous: (Fin.Fin m -> Real) -> Real) (x: Fin.Fin (N.Nat^::succ m) -> Real) =>
      Metric.max (distance (x (Fin.zero m)) zero)
        (previous (\fun (i: Fin.Fin m) => x (Fin.succ m i)))
  };

\definition norm(x: Point): Real := finiteMax n x;
\definition pointDistance(x, y: Point): Real := norm (subPoint x y);
