\import \parent.RelativeConcatenation[] \as Composition;
\definition reflexive: \forall (source: Source.Topology) (target: Target.Topology) (S: \Pow A) (f: A -> B) ->
  Maps.Continuous source target f -> RelativeHomotopic source target S f f :=
  \fun (source: _) (target: _) (S: _) (f: _) (fc: _) =>
    \exact(constantRelative source target S f fc, RelativeHomotopy[source, target, S, f, f]);
\definition symmetric: \forall (source: Source.Topology) (target: Target.Topology) (S: \Pow A) (f, g: A -> B) ->
  RelativeHomotopic source target S f g -> RelativeHomotopic source target S g f := \block {
  \fun (source: _) (target: _) (S: _) (f, g: _) (related: _) \then
  \takefrom h: RelativeHomotopy[source, target, S, f, g] \by related \then
  \return \exact(reverseRelative source target S f g h, RelativeHomotopy[source, target, S, g, f])
};
\definition transitive: \forall (source: Source.Topology) (target: Target.Topology) (S: \Pow A) (f, g, k: A -> B) ->
  RelativeHomotopic source target S f g -> RelativeHomotopic source target S g k -> RelativeHomotopic source target S f k := \block {
  \fun (source: _) (target: _) (S: _) (f, g, k: _) (first: _) (second: _) \then
  \takefrom h: RelativeHomotopy[source, target, S, f, g] \by first \then
  \takefrom j: RelativeHomotopy[source, target, S, g, k] \by second \then
  \return \exact(Composition.concatenate source target S f g k h j, RelativeHomotopy[source, target, S, f, k])
};
