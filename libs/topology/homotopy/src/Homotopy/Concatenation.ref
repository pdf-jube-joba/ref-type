\use std.Logic[].Equality[].eq_reason_in;
\import algebraic_topology.TimeSubdivision[A := A] \as Subdivision;
\import topological_constructions.Gluing[A := Cylinder.Carrier, B := B].Pasting[F := Subdivision.LeftSet, G := Subdivision.RightSet] \as Pasting;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as ScalarLaws;
\import Real.Estimates[] \as Estimates;
\import std.Logic[].Proposition[] \as Logic;
\use Equality.congr;
\use Logic.either;
\definition leftBoundary: \forall (p: Subdivision.Left) -> Cylinder.time p = Interval.middle -> Subdivision.leftTime p = Interval.end :=
  \fun (p: _) (equal: _) => trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ equal equal) Estimates.halfDouble;
\definition rightBoundary: \forall (p: Subdivision.Right) -> Cylinder.time p = Interval.middle -> Subdivision.rightTime p = Interval.start :=
  \fun (p: _) (equal: _) => trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real} (\fun (t: Real.Real) => Real.sub t Real.one) _ _
      (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ equal equal) Estimates.halfDouble))
    (ScalarLaws.subSelf Real.one);
\definition compatible[source: Source.Topology] [target: Target.Topology] [f, g, k: A -> B]
  [h: Homotopy[source, target, f, g]] [j: Homotopy[source, target, g, k]]:
  Pasting.Compatible (\fun (p: Subdivision.Left) => h (Subdivision.leftMap p))
    (\fun (p: Subdivision.Right) => j (Subdivision.rightMap p)) := \block {
  \fun (p: Subdivision.Left) (q: Subdivision.Right) (equal: p = q) \then
  \let timeEqual: Cylinder.time p = Cylinder.time q := congr!{Cylinder.Carrier Interval.Carrier} Cylinder.time _ _ equal \then
  \let boundary: Cylinder.time p = Interval.middle := R.leAntisym _ _
    (\bysub(Cylinder.Carrier, Subdivision.LeftSet, p))
    (R.leReplaceRight Real.half (Cylinder.time q) (Cylinder.time p) (sym!{Real.Real} _ _ timeEqual)
      (\bysub(Cylinder.Carrier, Subdivision.RightSet, q))) \then
  \let rightMiddle: Cylinder.time q = Interval.middle := trans!{Real.Real} _ _ _ (sym!{Real.Real} _ _ timeEqual) boundary \then
  \return eq_reason_in!{B _
    "=" _ "by" { congr!{Interval.Carrier B} (\fun (t: Interval.Carrier) => h (Cylinder.at t (Cylinder.point p))) _ _ (leftBoundary p boundary) }
    "=" _ "by" { (laws source target f g h).end (Cylinder.point p) }
    "=" _ "by" { congr!{A B} g _ _ (congr!{Cylinder.Carrier A} Cylinder.point _ _ equal) }
    "=" _ "by" { sym!{B} _ _ (trans!{B} _ _ _
        (congr!{Interval.Carrier B} (\fun (t: Interval.Carrier) => j (Cylinder.at t (Cylinder.point q))) _ _ (rightBoundary q rightMiddle))
        ((laws source target g k j).start (Cylinder.point q))) }
  }
};
\definition family[source: Source.Topology] [target: Target.Topology] [f, g, k: A -> B]
  [h: Homotopy[source, target, f, g]] [j: Homotopy[source, target, g, k]]: Family :=
  Pasting.apply (\fun (p: Subdivision.Left) => h (Subdivision.leftMap p))
    (\fun (p: Subdivision.Right) => j (Subdivision.rightMap p)) Subdivision.covered (compatible source target f g k h j);
\definition startPoint[x: A]: Subdivision.Left :=
  \into[Cylinder.Carrier](Cylinder.at Interval.start x, Subdivision.LeftSet) \by { Estimates.halfNonnegative };
\definition endPoint[x: A]: Subdivision.Right :=
  \into[Cylinder.Carrier](Cylinder.at Interval.end x, Subdivision.RightSet) \by { (Interval.bounds Interval.middle).right };
\definition leftStartTime[x: A]: Subdivision.leftTime (startPoint x) = Interval.start := ScalarLaws.addZeroLeft Real.zero;
\definition rightEndTime[x: A]: Subdivision.rightTime (endPoint x) = Interval.end := ScalarLaws.addNegCancelRight Real.one Real.one;
\definition familyStart: \forall (source: Source.Topology) (target: Target.Topology) (f, g, k: A -> B)
  (h: Homotopy[source, target, f, g]) (j: Homotopy[source, target, g, k]) (x: A) ->
  family source target f g k h j (Cylinder.at Interval.start x) = f x :=
  \fun (source: _) (target: _) (f, g, k: _) (h: _) (j: _) (x: A) => eq_reason_in!{B _
    "=" _ "by" { Pasting.onLeft (\fun (p: Subdivision.Left) => h (Subdivision.leftMap p))
      (\fun (p: Subdivision.Right) => j (Subdivision.rightMap p)) Subdivision.covered (compatible source target f g k h j) (startPoint x) }
    "=" _ "by" { congr!{Interval.Carrier B} (\fun (t: Interval.Carrier) => h (Cylinder.at t x)) _ _ (leftStartTime x) }
    "=" _ "by" { (laws source target f g h).start x }
  };
\definition familyEnd: \forall (source: Source.Topology) (target: Target.Topology) (f, g, k: A -> B)
  (h: Homotopy[source, target, f, g]) (j: Homotopy[source, target, g, k]) (x: A) ->
  family source target f g k h j (Cylinder.at Interval.end x) = k x :=
  \fun (source: _) (target: _) (f, g, k: _) (h: _) (j: _) (x: A) => eq_reason_in!{B _
    "=" _ "by" { Pasting.onRight (\fun (p: Subdivision.Left) => h (Subdivision.leftMap p))
      (\fun (p: Subdivision.Right) => j (Subdivision.rightMap p)) Subdivision.covered (compatible source target f g k h j) (endPoint x) }
    "=" _ "by" { congr!{Interval.Carrier B} (\fun (t: Interval.Carrier) => j (Cylinder.at t x)) _ _ (rightEndTime x) }
    "=" _ "by" { (laws source target g k j).end x }
  };
\definition concatenate[source: Source.Topology] [target: Target.Topology] [f, g, k: A -> B]
  [h: Homotopy[source, target, f, g]] [j: Homotopy[source, target, g, k]]: Homotopy[source, target, f, k] :=
  \into[Family](family source target f g k h j, Homotopy[source, target, f, k]) \by {
    Laws[source, target, f, k, family source target f g k h j] {
      continuous := Pasting.continuous (Cylinder.topology source) target
        (\fun (p: Subdivision.Left) => h (Subdivision.leftMap p))
        (\fun (p: Subdivision.Right) => j (Subdivision.rightMap p)) Subdivision.covered (compatible source target f g k h j)
        (Subdivision.leftClosed source) (Subdivision.rightClosed source)
        (\fun (U: \Pow B) (open: Target.IsOpenIn target U) => Subdivision.leftContinuous source
          (CylinderMaps.Preimage h U) ((laws source target f g h).continuous U open))
        (\fun (U: \Pow B) (open: Target.IsOpenIn target U) => Subdivision.rightContinuous source
          (CylinderMaps.Preimage j U) ((laws source target g k j).continuous U open)),
      start := familyStart source target f g k h j,
      end := familyEnd source target f g k h j,
    }
  };
\definition transitive: \forall (source: Source.Topology) (target: Target.Topology) (f, g, k: A -> B) ->
  Homotopic source target f g -> Homotopic source target g k -> Homotopic source target f k := \block {
  \fun (source: _) (target: _) (f, g, k: _) (first: _) (second: _) \then
  \takefrom h: Homotopy[source, target, f, g] \by first \then
  \takefrom j: Homotopy[source, target, g, k] \by second \then
  \return \exact(concatenate source target f g k h j, Homotopy[source, target, f, k])
};
