\use std.Logic[].Equality[].eq_reason_in;
\import Euclidean.Dimension[n := N.Nat^::succ n] \as Ambient;
\import Ambient.Contraction[] \as Scaling;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\import Real.Algebra[] \as Algebra;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\definition minusOneSquared: Real.mul (Real.neg Real.one) (Real.neg Real.one) = Real.one :=
  trans!{Real.Real} _ _ _ (Laws.fieldMulNegBoth Real.one Real.one) (Laws.fieldMulOneLeft Real.one);
\definition apply[x: Carrier n]: Carrier n :=
  \into[Ambient.Coordinate](Scaling.scale (Real.neg Real.one) x, Ambient.Boundary) \by {
    eq_reason_in!{Real.Real _
      "=" _ "by" { Scaling.normScale (Real.neg Real.one) x }
      "=" _ "by" { congr!{Real.Real Real.Real Real.Real} Real.mul _ _ _ _ minusOneSquared (\bysub(Ambient.Coordinate, Ambient.Boundary, x)) }
      "=" _ "by" { Laws.fieldMulOneLeft Real.one }
    }
  };
\definition involution: \forall (x: Carrier n) -> apply (apply x) = x :=
  \fun (x: Carrier n) => \axiom:funext(apply (apply x), x, \fun (i: Ambient.Index) => eq_reason_in!{Real.Real _
    "=" _ "by" { sym!{Real.Real} _ _ (Laws.fieldMulAssoc (Real.neg Real.one) (Real.neg Real.one) (x i)) }
    "=" _ "by" { congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r (x i)) _ _ minusOneSquared }
    "=" _ "by" { Laws.fieldMulOneLeft (x i) }
  });
\import metric_spaces.RealLine[] \as Line;
\import topological_algebra.Coordinates[K := Real.Real, I := Ambient.Index] \as Coordinates;
\import Coordinates.Universal[A := Carrier n] \as Universal;
\import topology.Continuity[A := Ambient.Coordinate, B := Ambient.Coordinate].Corestriction[S := Ambient.Boundary] \as Inclusion;
\import topology.Composition[A := Carrier n, B := Ambient.Coordinate, C := Real.Real] \as Evaluation;
\import metric_spaces.RealFunctions[A := Carrier n] \as Functions;
\import Functions.Product[] \as Product;
\import topology.Continuity[A := Carrier n, B := Ambient.Coordinate].Corestriction[S := Ambient.Boundary] \as Into;
\definition continuous: topology.Continuity[A := Carrier n, B := Carrier n].Continuous (topology n) (topology n) apply :=
  Into.corestrictContinuous (topology n) Ambient.topology apply
    (Universal.continuous (topology n) Line.topology (\fun (x: Carrier n) => apply x)
      (\fun (i: Ambient.Index) => Product.continuous (topology n) (\fun (_: Carrier n) => Real.neg Real.one) (\fun (x: Carrier n) => x i)
        (Functions.constantContinuous (topology n) (Real.neg Real.one))
        (Evaluation.composeContinuous (topology n) Ambient.topology Line.topology (\fun (x: Carrier n) => x) (\fun (x: Ambient.Coordinate) => x i)
          (Inclusion.inclusionContinuous Ambient.topology) (Coordinates.evaluationContinuous Line.topology i))));
\import topology.Homeomorphism[A := Carrier n, B := Carrier n] \as Homeomorphisms;
\definition homeomorphism: Homeomorphisms.Homeomorphism[topology n, topology n] := Homeomorphisms.Homeomorphism[topology n, topology n] {
  forward := apply, backward := apply, leftInverse := involution, rightInverse := involution,
  forwardContinuous := continuous, backwardContinuous := continuous,
};
