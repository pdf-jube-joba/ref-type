\import Simplex.Vertices[] \as SimplexVertices;
\import Simplex.AffineVertex[m := m, n := n] \as Evaluation;
\import std.Data[].Pair[].Prop[A := Interval.Carrier, B := Simplex.Carrier n] \as Pairs;
\definition scalarTimes[v: Vertices]: Simplex.Coordinate (N.Nat^::succ m) :=
  \fun (i: Fin.Fin (N.Nat^::succ m)) => Cylinder.time (v i);
\definition timeLaw: \forall (v: Vertices)(i: Fin.Fin (N.Nat^::succ m)) -> time v (SimplexVertices.vertex m i) = Cylinder.time (v i) :=
  \fun (v: Vertices)(i: Fin.Fin (N.Nat^::succ m)) => SimplexVertices.pairing m i (scalarTimes v);
\definition law: \forall (v: Vertices)(i: Fin.Fin (N.Nat^::succ m)) -> apply v (SimplexVertices.vertex m i) = v i :=
  \fun (v: Vertices)(i: Fin.Fin (N.Nat^::succ m)) => Pairs.ext (apply v (SimplexVertices.vertex m i)) (v i)
    (timeLaw v i) (Evaluation.law (pointVertices v) i);
