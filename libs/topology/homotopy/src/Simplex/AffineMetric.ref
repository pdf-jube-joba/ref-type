\import \parent.Affine[m := m, n := n] \as Affine;
\import \parent.Metric[n := n] \as Metric;
\import Sums.Convex[] \as Convex;
\definition radius: \forall (v: Affine.Vertices)(x: Carrier m)(y: Carrier n)(r: Real.Real) -> R.Le Real.zero r ->
  (\forall (i: Fin.Fin (N.Nat^::succ m)) -> R.Le ((Metric.metric).distance (v i) y) r) -> R.Le ((Metric.metric).distance (Affine.apply v x) y) r :=
  \fun (v: Affine.Vertices)(x: Carrier m)(y: Carrier n)(r: Real.Real)(positive: R.Le Real.zero r)(bounds: \forall (i: Fin.Fin (N.Nat^::succ m)) -> R.Le ((Metric.metric).distance (v i) y) r) =>
    Metric.distanceUpper (Affine.apply v x) y r positive (\fun (j: Fin.Fin (N.Nat^::succ n)) =>
      Convex.radius (N.Nat^::succ m) x (\fun (i: Fin.Fin (N.Nat^::succ m)) => v i j) (y j) r (barycentric m x).nonnegative (barycentric m x).total
        (\fun (i: Fin.Fin (N.Nat^::succ m)) => R.leTrans _ _ _ (Metric.coordinateDistance (v i) y j) (bounds i)));
\definition diameter: \forall (v: Affine.Vertices)(x, y: Carrier m)(r: Real.Real) -> R.Le Real.zero r ->
  (\forall (i, j: Fin.Fin (N.Nat^::succ m)) -> R.Le ((Metric.metric).distance (v i) (v j)) r) ->
  R.Le ((Metric.metric).distance (Affine.apply v x) (Affine.apply v y)) r :=
  \fun (v: Affine.Vertices)(x, y: Carrier m)(r: Real.Real)(positive: R.Le Real.zero r)(bounds: \forall (i, j: Fin.Fin (N.Nat^::succ m)) -> R.Le ((Metric.metric).distance (v i) (v j)) r) =>
    radius v x (Affine.apply v y) r positive (\fun (i: Fin.Fin (N.Nat^::succ m)) =>
      R.leReplaceLeft _ _ _ ((Metric.metric).symmetric (Affine.apply v y) (v i))
        (radius v y (v i) r positive (\fun (j: Fin.Fin (N.Nat^::succ m)) => bounds j i)));
\module Barycentre;
