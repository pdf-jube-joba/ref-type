\import \parent.Affine[m := m, n := n] \as Affine;
\import \parent.Vertices[] \as Vertices;
\definition law: \forall (v: Affine.Vertices)(i: Fin.Fin (N.Nat^::succ m)) -> Affine.apply v (Vertices.vertex m i) = v i :=
  \fun (v: Affine.Vertices)(i: Fin.Fin (N.Nat^::succ m)) => \axiom:funext(Affine.apply v (Vertices.vertex m i), v i,
    \fun (j: Fin.Fin (N.Nat^::succ n)) => Vertices.pairing m i (\fun (a: Fin.Fin (N.Nat^::succ m)) => v a j));
