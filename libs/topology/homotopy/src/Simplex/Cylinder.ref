\use std.Logic[].Equality[].eq_reason_in;
\import \root.Cylinder[A := Carrier n] \as Geometric;
\import \root.Interval[] \as Interval;
\import \root.CylinderAffine[m := n, n := n] \as Affine;
\import \parent.At[n := n] \as Space;
\import \parent.Vertices[] \as Vertices;
\import \parent.AffineIdentity[n := n] \as Identity;
\import Real.Algebra[] \as Algebra;
\import std.Data[].Pair[].Prop[A := Interval.Carrier, B := Carrier n] \as Pairs;
\definition CarrierSet: \Set := Geometric.Carrier;
\import topology.Topology[Carrier := CarrierSet] \as CylinderSpace;
\definition topology: CylinderSpace.Topology := Geometric.topology Space.topology;
\definition vertices[t: Interval.Carrier]: Affine.Vertices :=
  \fun (i: Fin.Fin (N.Nat^::succ n)) => Geometric.at t (Vertices.vertex n i);
\definition timeCoordinate: \forall (t: Interval.Carrier)(x: Carrier n) -> Affine.timeCoordinate (vertices t) x = t :=
  \fun (t: Interval.Carrier)(x: Carrier n) => eq_reason_in!{Real.Real _
    "=" _ "by" { Sums.congruent (N.Nat^::succ n)
      (\fun (i: Fin.Fin (N.Nat^::succ n)) => Real.mul (x i) t)
      (\fun (i: Fin.Fin (N.Nat^::succ n)) => Real.mul t (x i))
      (\fun (i: Fin.Fin (N.Nat^::succ n)) => Laws.fieldMulComm (x i) t) }
    "=" _ "by" { Sums.scalar (N.Nat^::succ n) t x }
    "=" _ "by" { congr!{Real.Real Real.Real} (Real.mul t) _ _ ((barycentric n x).total) }
    "=" _ "by" { Algebra.mulOneRight t }
  };
\definition law: \forall (t: Interval.Carrier)(x: Carrier n) -> Affine.apply (vertices t) x = Geometric.at t x :=
  \fun (t: Interval.Carrier)(x: Carrier n) => Pairs.ext (Affine.apply (vertices t) x) (Geometric.at t x) (timeCoordinate t x) (Identity.law x);
