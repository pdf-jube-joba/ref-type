\module Step(n: N.Nat^);
\definition law: \forall (n: N.Nat^)(i: Fin.Fin (N.Nat^::succ n))(x: Coordinate n) -> insertZero n i x i = Real.zero :=
  \induction (n: N.Nat^) \return \forall (i: Fin.Fin (N.Nat^::succ n))(x: Coordinate n) -> insertZero n i x i = Real.zero \with {
    | zero: \fun (i: Fin.Fin (N.Nat^::succ N.Nat^::zero))(x: Coordinate N.Nat^::zero) => \refl(Real.zero)
    | succ: \fun (n: N.Nat^)(previous: _) => Step[n := n].law previous
  };
