\import \parent.\parent.Affine[m := n, n := k] \as Next;
\import \parent.\parent.Affine[m := m, n := k] \as Composite;
\definition scalarRight: \forall (s: N.Nat^)(f: Fin.Fin s -> Real.Real)(c: Real.Real) ->
  Real.mul (Sums.sum s f) c = Sums.sum s (\fun (i: Fin.Fin s) => Real.mul (f i) c) :=
  \fun (s: N.Nat^)(f: _)(c: Real.Real) => trans!{Real.Real} _ _ _ (Laws.fieldMulComm (Sums.sum s f) c)
    (trans!{Real.Real} _ _ _ (sym!{Real.Real} _ _ (Sums.scalar s c f))
      (Sums.congruent s _ _ (\fun (i: Fin.Fin s) => Laws.fieldMulComm c (f i))));
\definition law: \forall (v: Vertices)(w: Next.Vertices)(x: Carrier m) ->
  Next.apply w (apply v x) = Composite.apply (\fun (i: Fin.Fin (N.Nat^::succ m)) => Next.apply w (v i)) x :=
  \fun (v: Vertices)(w: Next.Vertices)(x: Carrier m) =>
    \axiom:funext(Next.apply w (apply v x), Composite.apply (\fun (i: Fin.Fin (N.Nat^::succ m)) => Next.apply w (v i)) x,
      \fun (j: Fin.Fin (N.Nat^::succ k)) => \block {
        \let f: Fin.Fin (N.Nat^::succ n) -> Fin.Fin (N.Nat^::succ m) -> Real.Real :=
          \fun (b: Fin.Fin (N.Nat^::succ n))(a: Fin.Fin (N.Nat^::succ m)) => Real.mul (Real.mul (x a) (v a b)) (w b j) \then
        \let first: Next.apply w (apply v x) j = Sums.sum (N.Nat^::succ n) (\fun (b: Fin.Fin (N.Nat^::succ n)) => Sums.sum (N.Nat^::succ m) (f b)) :=
          Sums.congruent (N.Nat^::succ n)
            (\fun (b: Fin.Fin (N.Nat^::succ n)) => Real.mul (coordinates v x b) (w b j))
            (\fun (b: Fin.Fin (N.Nat^::succ n)) => Sums.sum (N.Nat^::succ m) (f b))
            (\fun (b: Fin.Fin (N.Nat^::succ n)) => scalarRight (N.Nat^::succ m) (\fun (a: Fin.Fin (N.Nat^::succ m)) => Real.mul (x a) (v a b)) (w b j)) \then
        \let swap: Sums.sum (N.Nat^::succ n) (\fun (b: Fin.Fin (N.Nat^::succ n)) => Sums.sum (N.Nat^::succ m) (f b)) =
          Sums.sum (N.Nat^::succ m) (\fun (a: Fin.Fin (N.Nat^::succ m)) => Sums.sum (N.Nat^::succ n) (\fun (b: Fin.Fin (N.Nat^::succ n)) => f b a)) :=
          Sums.exchange (N.Nat^::succ n) (N.Nat^::succ m) f \then
        \let last: Sums.sum (N.Nat^::succ m) (\fun (a: Fin.Fin (N.Nat^::succ m)) => Sums.sum (N.Nat^::succ n) (\fun (b: Fin.Fin (N.Nat^::succ n)) => f b a)) =
          Composite.apply (\fun (i: Fin.Fin (N.Nat^::succ m)) => Next.apply w (v i)) x j :=
          Sums.congruent (N.Nat^::succ m)
            (\fun (a: Fin.Fin (N.Nat^::succ m)) => Sums.sum (N.Nat^::succ n) (\fun (b: Fin.Fin (N.Nat^::succ n)) => f b a))
            (\fun (a: Fin.Fin (N.Nat^::succ m)) => Real.mul (x a) (Next.coordinates w (v a) j))
            (\fun (a: Fin.Fin (N.Nat^::succ m)) => trans!{Real.Real} _ _ _
              (Sums.congruent (N.Nat^::succ n)
                (\fun (b: Fin.Fin (N.Nat^::succ n)) => f b a)
                (\fun (b: Fin.Fin (N.Nat^::succ n)) => Real.mul (x a) (Real.mul (v a b) (w b j)))
                (\fun (b: Fin.Fin (N.Nat^::succ n)) => Laws.fieldMulAssoc (x a) (v a b) (w b j)))
              (Sums.scalar (N.Nat^::succ n) (x a) (\fun (b: Fin.Fin (N.Nat^::succ n)) => Real.mul (v a b) (w b j)))) \then
        \return trans!{Real.Real} _ _ _ first (trans!{Real.Real} _ _ _ swap last)
      });
