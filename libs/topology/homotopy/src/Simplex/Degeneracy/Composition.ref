\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Degeneracy[n := N.Nat^::succ n] \as Upper;
\import \parent.\parent.Reindex[m := N.Nat^::succ (N.Nat^::succ n), n := N.Nat^::succ n].Composition[k := n] \as Composition;
\import \parent.\parent.Reindex[m := N.Nat^::succ (N.Nat^::succ n), n := n] \as Direct;
\import Fin.Tuples[A := Fin.Fin (N.Nat^::succ (N.Nat^::succ n))].Mapping[B := Fin.Fin (N.Nat^::succ n)] \as Mapping;
\import N.Basic[].Prop[] \as Bounds;
\definition precompose: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(f: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)) -> Fin.Fin (N.Nat^::succ n)) ->
  (\fun (j: Fin.Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) => f (Upper.collapse i j)) = Repetition.repeat (N.Nat^::succ n) i f :=
  \fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(f: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)) -> Fin.Fin (N.Nat^::succ n)) =>
    trans!{Direct.Function} _ _ _ (Mapping.repeatMap (N.Nat^::succ n) i f (\fun (j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => j))
      (congr!{{Fin.Fin (N.Nat^::succ (N.Nat^::succ n)) -> Fin.Fin (N.Nat^::succ n)} Direct.Function}
        (Repetition.repeat (N.Nat^::succ n) i) _ _
        (\axiom:funext((\fun (j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => f j), f, \fun (j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => \refl(f j))));
\definition indices: \forall (i, j: Fin.Fin (N.Nat^::succ n)) -> Bounds.Le i j ->
  (\fun (k: Fin.Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) => collapse j (Upper.collapse (Fin.widen (N.Nat^::succ n) i) k)) =
  (\fun (k: Fin.Fin (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))) => collapse i (Upper.collapse (Fin.succ (N.Nat^::succ n) j) k)) :=
  \fun (i, j: Fin.Fin (N.Nat^::succ n))(ordered: _) => eq_reason_in!{Direct.Function _
    "=" _ "by" { precompose (Fin.widen (N.Nat^::succ n) i) (collapse j) }
    "=" _ "by" { Repetition.pairs n i j (\fun (k: Fin.Fin (N.Nat^::succ n)) => k) ordered }
    "=" _ "by" { sym!{Direct.Function} _ _ (precompose (Fin.succ (N.Nat^::succ n) j) (collapse i)) }
  };
\definition law: \forall (i, j: Fin.Fin (N.Nat^::succ n))(x: Carrier (N.Nat^::succ (N.Nat^::succ n))) -> Bounds.Le i j ->
  apply j (Upper.apply (Fin.widen (N.Nat^::succ n) i) x) = apply i (Upper.apply (Fin.succ (N.Nat^::succ n) j) x) :=
  \fun (i, j: Fin.Fin (N.Nat^::succ n))(x: Carrier (N.Nat^::succ (N.Nat^::succ n)))(ordered: _) =>
    eq_reason_in!{{Carrier n} _
      "=" _ "by" { Composition.law (Upper.collapse (Fin.widen (N.Nat^::succ n) i)) (collapse j) x }
      "=" _ "by" { congr!{Direct.Function {Carrier n}} (\fun (f: Direct.Function) => Direct.apply f x) _ _ (indices i j ordered) }
      "=" _ "by" { sym!{{Carrier n}} _ _ (Composition.law (Upper.collapse (Fin.succ (N.Nat^::succ n) j)) (collapse i) x) }
    };
