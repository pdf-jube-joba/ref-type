\import \parent.\parent.\parent.Affine[m := n, n := k] \as Affine;
\import \parent.\parent.\parent.Metric[n := k] \as Metric;
\import \parent.\parent.\parent.AffineMetric[m := n, n := k].Barycentre[] \as Centre;
\definition image[v: Affine.Vertices][c: Cell n][i: Fin.Fin (N.Nat^::succ n)]: Carrier k := Affine.apply v (vertices n c i);
\definition Diameter[v: Affine.Vertices][r: Real.Real]: \Prop := \forall (i, j: Fin.Fin (N.Nat^::succ n)) -> R.Le ((Metric.metric).distance (v i) (v j)) r;
\definition Bound[v: Affine.Vertices][c: Cell n][r: Real.Real]: \Prop := \forall (i, j: Fin.Fin (N.Nat^::succ n)) ->
  R.Le ((Metric.metric).distance (image v c i) (image v c j)) (Real.mul Centre.factor r);
\definition Statement: \Prop := \forall (v: Affine.Vertices)(c: Cell n)(r: Real.Real) -> R.Le Real.zero r -> Diameter v r -> Bound v c r;
