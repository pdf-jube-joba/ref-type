\import \parent.\parent.\parent.\parent.AffineFaces[m := n, n := k] \as Faces;
\import \parent.\parent.\parent.\parent.AffineVertex[m := n, n := k] \as Vertex;
\import \parent.\parent.\parent.\parent.Vertices[] \as Vertices;
\definition values: LowerAffine.Vertices := Omission.omit (N.Nat^::succ n) i v;
\definition equation: \forall (x: Carrier n) -> Affine.apply v (face n i x) = LowerAffine.apply values x := Faces.law v i;
\definition onVertex: \forall (j: Fin.Fin (N.Nat^::succ n)) -> Affine.apply v (face n i (Vertices.vertex n j)) = values j :=
  \fun (j: Fin.Fin (N.Nat^::succ n)) => trans!{{Carrier k}} _ _ _ (equation (Vertices.vertex n j)) (Vertex.law values j);
\definition bounds: \forall (r: Real.Real) -> R.Le Real.zero r -> Higher.Diameter v r -> Lower.Diameter values r :=
  \fun (r: Real.Real)(positive: R.Le Real.zero r)(original: Higher.Diameter v r)(j, l: Fin.Fin (N.Nat^::succ n)) => R.leReplaceLeft _ _ _
    (congr2!{{Carrier k} {Carrier k} Real.Real} ((Metric.metric).distance) _ _ _ _ (onVertex j) (onVertex l))
    (MetricAffine.diameter v (face n i (Vertices.vertex n j)) (face n i (Vertices.vertex n l)) r positive original);
