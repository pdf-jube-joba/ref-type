\import \parent.Affine[m := N.Nat^::succ m, n := n] \as Higher;
\import \parent.Affine[m := m, n := n] \as Lower;
\import \parent.Pairing[] \as Pairing;
\import Fin.Tuples[A := Carrier n] \as VertexTuples;
\import VertexTuples.Omission[] \as Omission;
\import VertexTuples.Mapping[B := Real.Real] \as Mapping;
\import Tuples.Omission[] \as CoordinateOmission;
\definition law: \forall (v: Higher.Vertices)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ m)))(x: Carrier m) ->
  Higher.apply v (face m i x) = Lower.apply (Omission.omit (N.Nat^::succ m) i v) x :=
  \fun (v: Higher.Vertices)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ m)))(x: Carrier m) =>
    \axiom:funext(Higher.apply v (face m i x), Lower.apply (Omission.omit (N.Nat^::succ m) i v) x,
      \fun (j: Fin.Fin (N.Nat^::succ n)) => trans!{Real.Real} _ _ _
        (Pairing.insertion (N.Nat^::succ m) i x (\fun (a: Fin.Fin (N.Nat^::succ (N.Nat^::succ m))) => v a j))
        (congr!{{Coordinate (N.Nat^::succ m)} Real.Real} (Pairing.pair (N.Nat^::succ m) x) _ _
          (sym!{{Coordinate (N.Nat^::succ m)}} _ _ (Mapping.omitMap (N.Nat^::succ m) i (\fun (y: Carrier n) => y j) v))));
