\import \parent.\parent.Barycentre[n := N.Nat^::succ n] \as Next;
\definition countLe: R.Le count Next.count := R.leReplaceRight count (Real.add count Real.one) Next.count (Laws.addComm count Real.one)
  (Algebra.leAddRight count Real.one Laws.oneNonnegative);
\definition weightLe: R.Le Next.weight weight := Inverse.invAntitone count Next.count countPositive Next.countPositive countLe;
\definition factorLe: R.Le (Real.sub Real.one weight) (Real.sub Real.one Next.weight) :=
  Laws.addMonotoneLeft (Real.neg weight) (Real.neg Next.weight) Real.one (Laws.negAntitone Next.weight weight weightLe);
