\import \parent.Vertices[] \as Vertices;
\import \parent.Affine[m := m, n := n] \as Affine;
\import \parent.AffineVertex[m := m, n := n] \as Evaluation;
\definition Function: \Set := Fin.Fin (N.Nat^::succ m) -> Fin.Fin (N.Nat^::succ n);
\definition vertices[f: Function]: Affine.Vertices := \fun (i: Fin.Fin (N.Nat^::succ m)) => Vertices.vertex n (f i);
\definition apply[f: Function]: Carrier m -> Carrier n := Affine.apply (vertices f);
\definition continuous: \forall (f: Function) -> topology.Continuity[A := Carrier m, B := Carrier n].Continuous
  (\parent.At[n := m].topology) (\parent.At[n := n].topology) (apply f) :=
  \fun (f: Function) => Affine.continuous (vertices f);
\definition onVertex: \forall (f: Function)(i: Fin.Fin (N.Nat^::succ m)) -> apply f (Vertices.vertex m i) = Vertices.vertex n (f i) :=
  \fun (f: Function)(i: Fin.Fin (N.Nat^::succ m)) => Evaluation.law (vertices f) i;
\module Composition(k: N.Nat^);
