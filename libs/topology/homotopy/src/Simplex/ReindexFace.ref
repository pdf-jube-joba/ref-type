\import \parent.Reindex[m := n, n := N.Nat^::succ n] \as Reindex;
\import \parent.Affine[m := n, n := N.Nat^::succ n] \as Affine;
\import \parent.AffineFace[n := n] \as Face;
\import \parent.Vertices[] \as Vertices;
\import Fin.Tuples[A := Fin.Fin (N.Nat^::succ (N.Nat^::succ n))].Mapping[B := Carrier (N.Nat^::succ n)] \as Mapping;
\definition skip: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)) -> Reindex.Function := Face.skip;
\definition law: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(x: Carrier n) -> face n i x = Reindex.apply (skip i) x :=
  \fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(x: Carrier n) => trans!{{Carrier (N.Nat^::succ n)}} _ _ _ (Face.law i x)
    (congr!{Affine.Vertices {Carrier (N.Nat^::succ n)}} (\fun (v: Affine.Vertices) => Affine.apply v x) _ _
      (sym!{Affine.Vertices} _ _ (Mapping.omitMap (N.Nat^::succ n) i (Vertices.vertex (N.Nat^::succ n)) (\fun (j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => j))));
