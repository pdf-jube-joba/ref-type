\use std.Logic[].Equality[].eq_reason_in;
\import Real.Algebra[] \as Algebra;
\import Real.Inverse[] \as Inverse;
\import Real.Estimates[].Product[] \as Positive;
\definition count: Real.Real := Sums.sum (N.Nat^::succ n) (\fun (_: Fin.Fin (N.Nat^::succ n)) => Real.one);
\definition countPositive: R.Lt Real.zero count :=
  R.ltLeTrans Real.zero Real.one count Positive.onePositive
    (Algebra.leAddRight Real.one (Sums.sum n (\fun (_: Fin.Fin n) => Real.one))
      (Sums.nonnegative n (\fun (_: Fin.Fin n) => Real.one) (\fun (_: Fin.Fin n) => Laws.oneNonnegative)));
\definition weight: Real.Real := Laws.fieldInv count;
\definition positive: R.Lt Real.zero weight := Positive.invPositive count countPositive;
\definition coordinates: Coordinate (N.Nat^::succ n) := \fun (_: Fin.Fin (N.Nat^::succ n)) => weight;
\definition total: Sums.sum (N.Nat^::succ n) coordinates = Real.one :=
  eq_reason_in!{Real.Real _
    "=" _ "by" { Sums.congruent (N.Nat^::succ n) coordinates (\fun (_: Fin.Fin (N.Nat^::succ n)) => Real.mul weight Real.one)
      (\fun (_: Fin.Fin (N.Nat^::succ n)) => sym!{Real.Real} _ _ (Algebra.mulOneRight weight)) }
    "=" _ "by" { Sums.scalar (N.Nat^::succ n) weight (\fun (_: Fin.Fin (N.Nat^::succ n)) => Real.one) }
    "=" _ "by" { Laws.fieldInverseNonzero count (Inverse.positiveNonzero count countPositive) }
  };
\definition point: Carrier n := \into[Coordinate (N.Nat^::succ n)](coordinates, Points n) \by {
  Barycentric[N.Nat^::succ n, coordinates] { nonnegative := \fun (_: Fin.Fin (N.Nat^::succ n)) => R.Order[].leOfLt Real.zero weight positive, total := total }
};
\module Growth;
