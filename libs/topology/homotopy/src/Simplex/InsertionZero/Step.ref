\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Identities[] \as Identities;
\definition law: (\forall (i: Fin.Fin (N.Nat^::succ n))(x: Coordinate n) -> insertZero n i x i = Real.zero) ->
  \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(x: Coordinate (N.Nat^::succ n)) -> insertZero (N.Nat^::succ n) i x i = Real.zero :=
  \fun (previous: _) => Fin.cases (N.Nat^::succ n)
    (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => \forall (x: Coordinate (N.Nat^::succ n)) -> insertZero (N.Nat^::succ n) i x i = Real.zero)
    (\fun (x: Coordinate (N.Nat^::succ n)) => trans!{Real.Real} _ _ _
      (congr!{{Coordinate (N.Nat^::succ (N.Nat^::succ n))} Real.Real} (\fun (v: Coordinate (N.Nat^::succ (N.Nat^::succ n))) => v (Fin.zero (N.Nat^::succ n))) _ _ (insertHead n x))
      (Tuples.atZero (N.Nat^::succ n) Real.zero x))
    (\fun (i: Fin.Fin (N.Nat^::succ n))(x: Coordinate (N.Nat^::succ n)) => eq_reason_in!{Real.Real _
      "=" _ "by" { congr!{{Coordinate (N.Nat^::succ (N.Nat^::succ n))} Real.Real} (\fun (v: Coordinate (N.Nat^::succ (N.Nat^::succ n))) => v (Fin.succ (N.Nat^::succ n) i)) _ _ (Identities.insertionTail n i x) }
      "=" _ "by" { Tuples.atSuccessor (N.Nat^::succ n) (x (Fin.zero n)) (insertZero n i (\fun (j: Fin.Fin n) => x (Fin.succ n j))) i }
      "=" _ "by" { previous i (\fun (j: Fin.Fin n) => x (Fin.succ n j)) }
    });
