\import \parent.Reindex[m := n, n := n] \as Reindex;
\import \parent.Affine[m := n, n := n] \as Affine;
\import \parent.AffineIdentity[n := n] \as Identity;
\import \parent.Vertices[] \as Vertices;
\definition identity[i: Fin.Fin (N.Nat^::succ n)]: Fin.Fin (N.Nat^::succ n) := i;
\definition law: \forall (x: Carrier n) -> Reindex.apply identity x = x :=
  \fun (x: Carrier n) => trans!{{Carrier n}} _ _ _
    (congr!{Affine.Vertices {Carrier n}} (\fun (v: Affine.Vertices) => Affine.apply v x) _ _
      (\axiom:funext(Reindex.vertices identity, Vertices.vertex n, \fun (i: Fin.Fin (N.Nat^::succ n)) => \refl(Vertices.vertex n i))))
    (Identity.law x);
