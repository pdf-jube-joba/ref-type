\import \parent.Reduced[basepoint := basepoint] \as Native;
\import algebraic_topology.Collapse[A := Cylinder.Carrier, subset := Native.Collapsed] \as Quotient;
\definition Carrier: \Set := Native.Carrier;
\definition Collapsed: \Pow Cylinder.Carrier := Native.Collapsed;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Native.topology source;
\definition class: Cylinder.Carrier -> Carrier := Quotient.class;
\definition point: Carrier := Native.basepoint;
\definition pointed: algebraic_topology.Pointed[A := Carrier].Space := algebraic_topology.Pointed[A := Carrier].Space { topology := topology, basepoint := point };
\definition collapsed: \forall (p: Cylinder.Carrier) -> \In[Cylinder.Carrier] Collapsed p -> class p = point :=
  \fun (p: Cylinder.Carrier)(inside: _) => Quotient.collapsed p (Cylinder.at Interval.start basepoint) inside (Logic.Or[_, _]::left (\refl(Interval.start)));
\definition bottom: \forall (x: A) -> class (Cylinder.at Interval.start x) = point :=
  \fun (x: A) => collapsed (Cylinder.at Interval.start x) (Logic.Or[_, _]::left (\refl(Interval.start)));
\definition top: \forall (x: A) -> class (Cylinder.at Interval.end x) = point :=
  \fun (x: A) => collapsed (Cylinder.at Interval.end x) (Logic.Or[_, _]::right (Logic.Or[_, _]::left (\refl(Interval.end))));
\definition line: \forall (t: Interval.Carrier) -> class (Cylinder.at t basepoint) = point :=
  \fun (t: Interval.Carrier) => collapsed (Cylinder.at t basepoint) (Logic.Or[_, _]::right (Logic.Or[_, _]::right (\refl(basepoint))));
\definition original: algebraic_topology.Pointed[A := A].Space := algebraic_topology.Pointed[A := A].Space { topology := source, basepoint := basepoint };
\module Mapping(B: \Set, target: algebraic_topology.Pointed[A := B].Space,
  f: algebraic_topology.Pointed[A := A].Maps[B := B].Map[original, target]);
