\use Equality.congr2;
\definition lowerBound[t: Carrier]: R.Le (Real.mul Real.half t) Real.half :=
  R.leReplaceRight _ (Real.mul Real.half Real.one) Real.half (Algebra.mulOneRight Real.half)
    (Estimates.mulMonotone Real.half t Real.one Estimates.halfNonnegative (bounds t).right);
\definition lower[t: Carrier]: Carrier := \into[Real.Real](Real.mul Real.half t, Line.ClosedInterval Real.zero Real.one) \by {
  Logic.And[_, _]::# (Laws.fieldMulNonnegative Real.half t Estimates.halfNonnegative (bounds t).left)
    (R.leTrans _ Real.half Real.one (lowerBound t) (bounds middle).right)
};
\definition upper[t: Carrier]: Carrier := \into[Real.Real](Real.add Real.half (lower t), Line.ClosedInterval Real.zero Real.one) \by {
  Logic.And[_, _]::# (Laws.addNonnegative Real.half (lower t) Estimates.halfNonnegative (bounds (lower t)).left)
    (R.leReplaceRight _ (Real.add Real.half Real.half) Real.one Estimates.halfDouble
      (Estimates.addLe _ _ _ _ (R.leRefl Real.half) (lowerBound t)))
};
\definition upperBound: \forall (t: Carrier) -> R.Le Real.half (upper t) :=
  \fun (t: Carrier) => Algebra.leAddRight Real.half (lower t) (bounds (lower t)).left;
\definition lowerStart: lower start = start := Laws.fieldMulZeroRight Real.half;
\definition lowerEnd: lower end = middle := Algebra.mulOneRight Real.half;
\definition upperStart: upper start = middle := trans!{Real.Real} _ _ _
  (congr!{Real.Real Real.Real} (Real.add Real.half) _ _ lowerStart) (Laws.addZeroRight Real.half);
\definition upperEnd: upper end = end := trans!{Real.Real} _ _ _
  (congr!{Real.Real Real.Real} (Real.add Real.half) _ _ lowerEnd) Estimates.halfDouble;
\definition lowerDouble: \forall (t: Carrier) -> Real.add (lower t) (lower t) = t := \fun (t: Carrier) => Estimates.halfTwice t;
\definition upperDouble: \forall (t: Carrier) -> Real.sub (Real.add (upper t) (upper t)) Real.one = t :=
  \fun (t: Carrier) => trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.sub r Real.one) _ _
      (trans!{Real.Real} _ _ _ (Algebra.addFour Real.half (lower t) Real.half (lower t))
        (congr2!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ Estimates.halfDouble (lowerDouble t))))
    (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.sub r Real.one) _ _ (Laws.addComm Real.one t))
      (Laws.addNegCancelRight Real.one t));
\import Functions.Product[] \as Product;
\definition lowerScalarContinuous: Functions.Continuous topology (\fun (t: Carrier) => lower t) :=
  Product.continuous topology (\fun (_: Carrier) => Real.half) (\fun (t: Carrier) => t)
    (Functions.constantContinuous topology Real.half) inclusionContinuous;
\definition lowerContinuous: Maps.Continuous topology topology lower := Into.corestrictContinuous topology Line.topology lower lowerScalarContinuous;
\definition upperContinuous: Maps.Continuous topology topology upper := Into.corestrictContinuous topology Line.topology upper
  (Functions.sumContinuous topology (\fun (_: Carrier) => Real.half) (\fun (t: Carrier) => lower t)
    (Functions.constantContinuous topology Real.half) lowerScalarContinuous);
\definition undoDouble: \forall (t, d: Carrier) -> d = Real.add t t -> lower d = t :=
  \fun (t, d: Carrier)(same: _) => trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real} (Real.mul Real.half) _ _ same)
    (trans!{Real.Real} _ _ _ (Laws.fieldMulAdd Real.half t t) (Estimates.halfTwice t));
\definition undoDoubleMinusOne: \forall (t, d: Carrier) -> d = Real.sub (Real.add t t) Real.one -> upper d = t :=
  \fun (t, d: Carrier)(same: _) => trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.add Real.half (Real.mul Real.half r)) _ _ same)
    (trans!{Real.Real} _ _ _
      (congr!{Real.Real Real.Real} (Real.add Real.half) _ _
        (trans!{Real.Real} _ _ _ (Algebra.mulSub Real.half (Real.add t t) Real.one)
          (congr2!{Real.Real Real.Real Real.Real} Real.sub _ _ _ _
            (trans!{Real.Real} _ _ _ (Laws.fieldMulAdd Real.half t t) (Estimates.halfTwice t))
            (Algebra.mulOneRight Real.half))))
      (Estimates.addSubCancel t Real.half));
