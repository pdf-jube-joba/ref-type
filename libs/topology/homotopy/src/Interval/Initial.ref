\import \parent.Convex[] \as Convex;
\import Convex.Functions[A := Carrier] \as ConvexFunctions;
\import topology.Maps[A := Carrier, B := Carrier] \as General;
\import General.Identity[] \as Identity;
\definition curve[t, s: Carrier]: Carrier := Convex.blend s start t;
\definition continuous: \forall (t: Carrier) -> Maps.Continuous topology topology (curve t) :=
  \fun (t: Carrier) => ConvexFunctions.continuous topology (\fun (s: Carrier) => s) (\fun (_: Carrier) => start) (\fun (_: Carrier) => t)
    (Identity.continuous topology) (General.constantContinuous topology topology start) (General.constantContinuous topology topology t);
\definition atStart: \forall (t: Carrier) -> curve t start = start := \fun (t: Carrier) => Convex.atStart start t;
\definition atEnd: \forall (t: Carrier) -> curve t end = t := \fun (t: Carrier) => Convex.atEnd start t;
