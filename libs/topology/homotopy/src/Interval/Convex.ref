\use std.Logic[].Equality[].eq_reason_in;
\use Equality.congr;
\definition scalar[s, t, u: Carrier]: Real.Real := Real.add (Real.mul (reverse s) t) (Real.mul s u);
\definition weight[s: Carrier]: Real.add (reverse s) s = Real.one := Distance.subAddCancel Real.one s;
\definition nonnegative: \forall (s, t, u: Carrier) -> R.Le Real.zero (scalar s t u) :=
  \fun (s, t, u: Carrier) => Laws.addNonnegative _ _
    (Laws.fieldMulNonnegative (reverse s) t (bounds (reverse s)).left (bounds t).left)
    (Laws.fieldMulNonnegative s u (bounds s).left (bounds u).left);
\definition bounded: \forall (s, t, u: Carrier) -> R.Le (scalar s t u) Real.one :=
  \fun (s, t, u: Carrier) => R.leReplaceRight _ (Real.add (reverse s) s) Real.one (weight s)
    (Estimates.addLe _ _ _ _
      (R.leReplaceRight _ (Real.mul (reverse s) Real.one) (reverse s) (Algebra.mulOneRight (reverse s))
        (Estimates.mulMonotone (reverse s) t Real.one (bounds (reverse s)).left (bounds t).right))
      (R.leReplaceRight _ (Real.mul s Real.one) s (Algebra.mulOneRight s)
        (Estimates.mulMonotone s u Real.one (bounds s).left (bounds u).right)));
\definition blend[s, t, u: Carrier]: Carrier := \into[Real.Real](scalar s t u, Line.ClosedInterval Real.zero Real.one) \by {
  Logic.And[_, _]::# (nonnegative s t u) (bounded s t u)
};
\definition atStart: \forall (t, u: Carrier) -> blend start t u = t :=
  \fun (t, u: Carrier) => trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _
      (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r t) _ _ reverseStart) (Laws.fieldMulOneLeft t))
      (Laws.fieldMulZeroLeft u)) (Laws.addZeroRight t);
\definition atEnd: \forall (t, u: Carrier) -> blend end t u = u :=
  \fun (t, u: Carrier) => trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _
      (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r t) _ _ reverseEnd) (Laws.fieldMulZeroLeft t))
      (Laws.fieldMulOneLeft u)) (Laws.addZeroLeft u);
\definition fixed: \forall (s, t: Carrier) -> blend s t t = t :=
  \fun (s, t: Carrier) => eq_reason_in!{Real.Real _
    "=" _ "by" { sym!{Real.Real} _ _ (Algebra.mulAddRight (reverse s) s t) }
    "=" _ "by" { congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r t) _ _ (weight s) }
    "=" _ "by" { Laws.fieldMulOneLeft t }
  };
\module Functions(A: \Set);
