\import topology.Topology[Carrier := B] \as Target;
\import topology.Continuity[A := Carrier, B := B] \as Continuous;
\import \parent.Subdivision[] \as Subdivision;
\import \parent.Halves[] \as Halves;
\module Along(f: Carrier -> B, continuous: Continuous.Continuous topology Target.Discrete f);
\definition endpoints: \forall (f: Carrier -> B) -> Continuous.Continuous topology Target.Discrete f -> f start = f end :=
  \fun (f: Carrier -> B)(continuous: _) => Along[f := f, continuous := continuous].endpoints;
