\definition image: \Pow B := { y: B \where \exists ( x: A \where inclusion x = y ) };
\import Target.Subspace[S := image] \as Subspace;
\definition Image: \Set := Subspace.CarrierSet;
\definition point[x: A]: Image := \into[B](inclusion x, image) \by { Logic.existsIntro[A, { y: A \where inclusion y = inclusion x }] x (\refl(inclusion x)) };
\definition inverse[y: Image]: A := retraction y;
\definition Left: \Prop := \forall (x: A) -> retraction (inclusion x) = x;
\module With(forward: Forward.Continuous source target inclusion, backward: Backward.Continuous target source retraction, left: Left);
\definition homeomorphism[forward: Forward.Continuous source target inclusion][backward: Backward.Continuous target source retraction][left: Left]:
  \root.Homeomorphism[A := A, B := Image].Homeomorphism[source, Subspace.topology target] :=
  With[forward := forward, backward := backward, left := left].homeomorphism;
