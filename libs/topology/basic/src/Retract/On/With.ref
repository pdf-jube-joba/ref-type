\definition right: \forall (y: Image) -> point (inverse y) = y := \block {
  \fun (y: Image) \then
  \takefrom x: \Cast[A] ({ x: A \where inclusion x = y }) \by \bysub(B, image, y) \then
  \return \idelim inclusion x = y \with z: B => inclusion (retraction z) = z \by {
    base: congr!{A B} inclusion _ _ (left x), equality: \bysub(A, { x: A \where inclusion x = y }, x)
  }
};
\definition homeomorphism: \root.Homeomorphism[A := A, B := Image].Homeomorphism[source, Subspace.topology target] :=
  \root.Homeomorphism[A := A, B := Image].Homeomorphism[source, Subspace.topology target] {
    forward := point, backward := inverse, leftInverse := left, rightInverse := right,
    forwardContinuous := Forward.Corestriction[S := image].corestrictContinuous source target point forward,
    backwardContinuous := Backward.Restriction[S := image].restrictContinuous target source retraction backward,
  };
