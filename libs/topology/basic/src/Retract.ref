\import \root.Topology[Carrier := A] \as Source;
\import \root.Topology[Carrier := B] \as Target;
\import \root.Continuity[A := A, B := B] \as Forward;
\import \root.Continuity[A := B, B := A] \as Backward;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.congr;
\module On(source: Source.Topology, target: Target.Topology, inclusion: A -> B, retraction: B -> A);
