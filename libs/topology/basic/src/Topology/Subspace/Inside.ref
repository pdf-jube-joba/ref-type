\import \parent.\parent.Subspace[S := U] \as Ambient;
\import topology.Topology[Carrier := Ambient.CarrierSet] \as AmbientSpace;
\definition nested: \Pow Ambient.CarrierSet := { x: Ambient.CarrierSet \where Member S x };
\import AmbientSpace.Subspace[S := nested] \as Nested;
\import topology.Continuity[A := CarrierSet, B := Carrier].Corestriction[S := S] \as SourceInclusion;
\import topology.Continuity[A := Ambient.CarrierSet, B := Carrier].Corestriction[S := U] \as AmbientInclusion;
\import topology.Continuity[A := Nested.CarrierSet, B := Ambient.CarrierSet].Corestriction[S := nested] \as NestedInclusion;
\import topology.Continuity[A := CarrierSet, B := Carrier].Corestriction[S := U] \as IntoAmbient;
\import topology.Continuity[A := CarrierSet, B := Ambient.CarrierSet].Corestriction[S := nested] \as IntoNested;
\import topology.Continuity[A := Nested.CarrierSet, B := Carrier].Corestriction[S := S] \as IntoSource;
\import topology.Composition[A := Nested.CarrierSet, B := Ambient.CarrierSet, C := Carrier] \as InclusionComposition;
\import topology.Homeomorphism[A := CarrierSet, B := Nested.CarrierSet] \as Homeomorphisms;
\definition lift(included: Subset S U)(x: CarrierSet): Ambient.CarrierSet := \into[Carrier](x, U) \by { included x (\bysub(Carrier, S, x)) };
\definition forward(included: Subset S U)(x: CarrierSet): Nested.CarrierSet :=
  \into[Ambient.CarrierSet](lift included x, nested) \by { \bysub(Carrier, S, x) };
\definition backward(x: Nested.CarrierSet): CarrierSet := \into[Carrier](x, S) \by { \bysub(Ambient.CarrierSet, nested, x) };
\definition homeomorphism(ambient: Topology)(included: Subset S U): Homeomorphisms.Homeomorphism[topology ambient, Nested.topology (Ambient.topology ambient)] :=
  Homeomorphisms.Homeomorphism[_, _] {
    forward := forward included, backward := backward,
    leftInverse := \fun (x: CarrierSet) => \refl(x), rightInverse := \fun (x: Nested.CarrierSet) => \refl(x),
    forwardContinuous := IntoNested.corestrictContinuous (topology ambient) (Ambient.topology ambient) (forward included)
      (IntoAmbient.corestrictContinuous (topology ambient) ambient (lift included) (SourceInclusion.inclusionContinuous ambient)),
    backwardContinuous := IntoSource.corestrictContinuous (Nested.topology (Ambient.topology ambient)) ambient backward
      (InclusionComposition.composeContinuous (Nested.topology (Ambient.topology ambient)) (Ambient.topology ambient) ambient
        (\fun (x: Nested.CarrierSet) => x) (\fun (x: Ambient.CarrierSet) => x)
        (NestedInclusion.inclusionContinuous (Ambient.topology ambient)) (AmbientInclusion.inclusionContinuous ambient)),
  };
