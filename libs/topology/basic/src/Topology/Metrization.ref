\use Logic.either;
/* Urysohn separation in regular second-countable spaces. */
\import \parent.Normality[] \as Normal;
\import \parent.Urysohn[] \as Urysohn;
\import std.Data[].Nat[].Pair[].Def[] \as NatPair;
\import std.Logic[].Classical[] \as Classical;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Def[] \as Real;
\import std.Arithmetic[].Rat[].Fractions[] \as Q;
\use Equality.trans;

\definition t3SecondCountableUrysohn[topology: Topology]:
  IsT3 topology ->
  IsSecondCountable topology ->
  \forall (F, G: \Pow Carrier) ->
  IsClosedIn topology F ->
  IsClosedIn topology G ->
  Disjoint F G ->
  \exists Urysohn.UrysohnFunction[topology, F, G] :=
  \fun (t3: IsT3 topology) (secondCountable: IsSecondCountable topology) (F, G: \Pow Carrier)
    (fClosed: IsClosedIn topology F) (gClosed: IsClosedIn topology G) (disjoint: Disjoint F G) =>
    Urysohn.normalUrysohn topology
      (Normal.regularSecondCountableNormal topology
        (t3.right) secondCountable)
      F G fClosed gClosed disjoint;

\definition singletonDisjoint[x, y: Carrier]:
  Logic.Not (x = y) ->
  Disjoint (Singleton x) (Singleton y) :=
  \fun (different: Logic.Not (x = y)) (z: Carrier) (isX: Member (Singleton x) z)
    (isY: Member (Singleton y) z) =>
      different
        (trans!{Carrier} x z y
          (sym!{Carrier} z x isX) isY);

\definition t3SecondCountableSeparatesPoints[topology: Topology]:
  IsT3 topology ->
  IsSecondCountable topology ->
  \forall (x, y: Carrier) ->
  Logic.Not (x = y) ->
  \exists Urysohn.UrysohnFunction[topology, Singleton x, Singleton y] :=
  \fun (t3: IsT3 topology) (secondCountable: IsSecondCountable topology) (x, y: Carrier)
    (different: Logic.Not (x = y)) =>
    t3SecondCountableUrysohn topology t3 secondCountable
      (Singleton x) (Singleton y)
      (t3.left x) (t3.left y)
      (singletonDisjoint x y different);

\structure BasisPairData[topology: Topology,
  basis: N.Nat^ -> \Pow Carrier, pair: NatPair.NatPair]: \Set := {
  envelope: \Pow Carrier,
  envelopeClosed: IsClosedIn topology envelope,
  innerWithin: Subset (basis (NatPair.natPairFirst pair)) envelope,
  envelopeWithin: Subset envelope (basis (NatPair.natPairSecond pair)),
};

\definition AdmissibleBasisPair[topology: Topology] [basis: N.Nat^ -> \Pow Carrier]
  [pair: NatPair.NatPair]: \Prop :=
  \exists BasisPairData[topology, basis, pair];

\structure LocalAdmissiblePairLaw[
  topology: Topology, basis: N.Nat^ -> \Pow Carrier,
  x: Carrier, U: \Pow Carrier, pair: NatPair.NatPair,
]: \Prop := {
  contains: Member (basis (NatPair.natPairFirst pair)) x,
  within: Subset (basis (NatPair.natPairSecond pair)) U,
  admissible: AdmissibleBasisPair topology basis pair,
};

\definition LocalAdmissiblePair[topology: Topology] [basis: N.Nat^ -> \Pow Carrier] [x: Carrier]
  [U: \Pow Carrier]: \Prop :=
  \exists ( pair : NatPair.NatPair \where
    LocalAdmissiblePairLaw[topology, basis, x, U, pair] );

\definition singletonWithin[U: \Pow Carrier] [x: Carrier]:
  Member U x ->
  Subset (Singleton x) U :=
  \fun (member: Member U x) (y: Carrier) (same: Member (Singleton x) y) =>
      \idelim x = y \with z: Carrier => Member U z
        \by { base: member,
          equality: sym!{Carrier} y x same };

\definition localAdmissiblePair[topology: Topology]:
  IsT1 topology -> IsNormal topology ->
  \forall (basis: N.Nat^ -> \Pow Carrier) -> IsCountableBasis[topology, basis] ->
  \forall (U: \Pow Carrier) -> IsOpenIn topology U -> \forall (x: Carrier) ->
  Member U x ->
  LocalAdmissiblePair topology basis x U := \block {
    \fun (t1: IsT1 topology) (normal: IsNormal topology) (basis: N.Nat^ -> \Pow Carrier)
      (isBasis: IsCountableBasis[topology, basis]) (U: \Pow Carrier) (open: IsOpenIn topology U)
      (x: Carrier) (member: Member U x) \then
    \takefrom j: \Cast[N.Nat^]
      ({ n : N.Nat^ \where
        Logic.And[Member (basis n) x, Subset (basis n) U] })
      \by isBasis.refines U open x member \then
    \let jData: Logic.And[Member (basis j) x,
      Subset (basis j) U] :=
      \bysub(N.Nat^,
        { n : N.Nat^ \where
          Logic.And[Member (basis n) x, Subset (basis n) U] }, j) \then
    \takefrom shrink: Urysohn.ShrinkData[topology,
      Singleton x, basis j]
      \by Urysohn.shrink topology normal
        (Singleton x) (basis j) (t1 x)
        (isBasis.open j)
        (singletonWithin (basis j) x (jData.left)) \then
    \let xInner: Member (shrink.inner) x :=
      shrink.contains x (\refl(x)) \then
    \takefrom i: \Cast[N.Nat^]
      ({ n : N.Nat^ \where
        Logic.And[Member (basis n) x,
          Subset (basis n) (shrink.inner)] })
      \by isBasis.refines (shrink.inner)
        (shrink.innerOpen) x xInner \then
    \let iData: Logic.And[Member (basis i) x,
      Subset (basis i) (shrink.inner)] :=
      \bysub(N.Nat^,
        { n : N.Nat^ \where
          Logic.And[Member (basis n) x,
            Subset (basis n) (shrink.inner)] }, i) \then
    \let pair: NatPair.NatPair := NatPair.natPair i j \then
    \let data: BasisPairData[topology, basis, pair] :=
      BasisPairData[topology, basis, pair] {
        envelope := shrink.envelope,

        envelopeClosed := shrink.envelopeClosed,
        innerWithin := subsetTrans (basis i)
          (shrink.inner) (shrink.envelope)
          (iData.right) (shrink.enclosed),
        envelopeWithin := shrink.within,
      } \then
    \return Logic.existsIntro[NatPair.NatPair, { p : NatPair.NatPair \where
          LocalAdmissiblePairLaw[topology, basis, x, U, p] }] pair
      (LocalAdmissiblePairLaw[topology, basis, x, U, pair]::#
          (iData.left) (jData.right)
          (\exact(data,
            BasisPairData[topology, basis, pair])))
  };

\structure PairSeparatorLaws[
  topology: Topology, basis: N.Nat^ -> \Pow Carrier,
  pair: NatPair.NatPair, E: \Pow Carrier, value: Carrier -> R.Real,
]: \Prop := {
  envelopeClosed: IsClosedIn topology E,
  innerWithin: Subset (basis (NatPair.natPairFirst pair)) E,
  envelopeWithin: Subset E (basis (NatPair.natPairSecond pair)),
  lowerOpen: \forall (q: Q.Fraction) ->
    IsOpenIn topology (Urysohn.FunctionLowerRay value q),
  upperOpen: \forall (q: Q.Fraction) ->
    IsOpenIn topology (Urysohn.FunctionUpperCut value q),
  zeroOn: \forall (x: Carrier) -> Member E x -> value x = Real.zero,
  oneOn: \forall (x: Carrier) ->
    Member (Complement (basis (NatPair.natPairSecond pair))) x ->
    value x = Real.one,
};

\structure PairSeparator[topology: Topology,
  basis: N.Nat^ -> \Pow Carrier,
  pair: NatPair.NatPair]: \Set := {
  envelope: \Pow Carrier,
  value: Carrier -> R.Real,
  lowerOpen: \forall (q: Q.Fraction) ->
    IsOpenIn topology (Urysohn.FunctionLowerRay value q),
  upperOpen: \forall (q: Q.Fraction) ->
    IsOpenIn topology (Urysohn.FunctionUpperCut value q),
  good: AdmissibleBasisPair topology basis pair ->
    PairSeparatorLaws[topology, basis, pair, envelope, value],
};

\definition uniformSetOpen[topology: Topology] [S: \Pow Carrier]:
  (\forall (x, y: Carrier) -> Member S x -> Member S y) ->
  IsOpenIn topology S :=
  \fun (uniform: \forall (x, y: Carrier) -> Member S x -> Member S y) =>
    openOfNeighborhoods topology S
      (\fun (x: Carrier) => \fun (inside: Member S x) =>
        Logic.existsIntro[\Pow Carrier, { U: \Pow Carrier \where
              OpenNeighborhood[topology, x, S, U] }] Whole
        (OpenNeighborhood[topology, x, S, Whole]::#
              ((topologyLaws topology).wholeOpen)
              (\refl(x))
              (\fun (y: Carrier) =>
                \fun (_: Member Whole y) =>
                  uniform x y inside)));

\definition pairSeparatorExists[topology: Topology]:
  IsNormal topology ->
  \forall (basis: N.Nat^ -> \Pow Carrier) ->
  IsCountableBasis[topology, basis] ->
  \forall (pair: NatPair.NatPair) ->
  \exists PairSeparator[topology, basis, pair] :=
  \fun (normal: IsNormal topology) (basis: N.Nat^ -> \Pow Carrier)
    (isBasis: IsCountableBasis[topology, basis]) (pair: NatPair.NatPair) =>
    either!{{(Classical.excludedMiddle
        (AdmissibleBasisPair topology basis pair))} {\exists PairSeparator[topology, basis, pair]}
      {\fun (admissible: AdmissibleBasisPair topology basis pair) => \block {
        \takefrom data: BasisPairData[topology, basis, pair]
          \by admissible \then
        \let j: N.Nat^ := NatPair.natPairSecond pair \then
        \takefrom f: Urysohn.UrysohnFunction[topology,
          data.envelope, Complement (basis j)]
          \by Urysohn.normalUrysohn topology normal
            (data.envelope) (Complement (basis j))
            (data.envelopeClosed)
            (Urysohn.openComplementClosed topology (basis j)
              (isBasis.open j))
            (\fun (x: Carrier) =>
              \fun (inE: Member (data.envelope) x) =>
              \fun (outside: Member (Complement (basis j)) x) =>
                outside (data.envelopeWithin x inE)) \then
        \return \exact(
          PairSeparator[topology, basis, pair] {
            envelope := data.envelope,
            value := f.value,

            lowerOpen := f.lowerOpen,
            upperOpen := f.upperOpen,
            good := \fun (_: AdmissibleBasisPair topology basis pair) =>
              PairSeparatorLaws[topology, basis, pair,
                data.envelope, f.value]::#
                (data.envelopeClosed) (data.innerWithin)
                (data.envelopeWithin) (f.lowerOpen)
                (f.upperOpen) (f.zeroOn) (f.oneOn)
          }, PairSeparator[topology, basis, pair])
      }}
      {\fun (inadmissible: Logic.Not
        (AdmissibleBasisPair topology basis pair)) =>
        \exact(
          PairSeparator[topology, basis, pair] {
            envelope := Empty,
            value := \fun (_: Carrier) => Real.zero,

            lowerOpen := \fun (q: Q.Fraction) =>
              uniformSetOpen topology
                (Urysohn.FunctionLowerRay
                  (\fun (_: Carrier) => Real.zero) q)
                (\fun (_: Carrier) => \fun (_: Carrier) =>
                  \fun (member: R.mem Real.zero q) => member),
            upperOpen := \fun (q: Q.Fraction) =>
              uniformSetOpen topology
                (Urysohn.FunctionUpperCut
                  (\fun (_: Carrier) => Real.zero) q)
                (\fun (x: Carrier) => \fun (_: Carrier) =>
                  \fun (member: Member
                    (Urysohn.FunctionUpperCut
                      (\fun (_: Carrier) => Real.zero) q) x) => member),
            good := \fun (admissible: AdmissibleBasisPair topology basis pair) =>
              Logic.falseElim
                (PairSeparatorLaws[topology, basis, pair, Empty,
                  (\fun (_: Carrier) => Real.zero)])
                (inadmissible admissible),
          }, PairSeparator[topology, basis, pair])}
    };

\definition pairSeparatorsExist[topology: Topology]:
  IsNormal topology ->
  \forall (basis: N.Nat^ -> \Pow Carrier) ->
  IsCountableBasis[topology, basis] ->
  \exists (\forall (pair: NatPair.NatPair) ->
    PairSeparator[topology, basis, pair]) :=
  \fun (normal: IsNormal topology) (basis: N.Nat^ -> \Pow Carrier)
    (isBasis: IsCountableBasis[topology, basis]) =>
    \axiom:classicalIndefiniteChoice(
      NatPair.NatPair,
      (\fun (pair: NatPair.NatPair) =>
        PairSeparator[topology, basis, pair]),
      pairSeparatorExists topology normal basis isBasis);

\definition pairInnerWithin[topology: Topology] [basis: N.Nat^ -> \Pow Carrier]
  [pair: NatPair.NatPair] [separator: PairSeparator[topology, basis, pair]]:
  AdmissibleBasisPair topology basis pair ->
  Subset (basis (NatPair.natPairFirst pair)) (separator.envelope) :=
  \fun (admissible: AdmissibleBasisPair topology basis pair) =>
    (separator.good admissible).innerWithin;

\definition pairEnvelopeWithin[topology: Topology] [basis: N.Nat^ -> \Pow Carrier]
  [pair: NatPair.NatPair] [separator: PairSeparator[topology, basis, pair]]:
  AdmissibleBasisPair topology basis pair ->
  Subset (separator.envelope)
    (basis (NatPair.natPairSecond pair)) :=
  \fun (admissible: AdmissibleBasisPair topology basis pair) =>
    (separator.good admissible).envelopeWithin;

\definition pairZeroOn[topology: Topology] [basis: N.Nat^ -> \Pow Carrier] [pair: NatPair.NatPair]
  [separator: PairSeparator[topology, basis, pair]]:
  AdmissibleBasisPair topology basis pair ->
  \forall (x: Carrier) -> Member (separator.envelope) x ->
    separator.value x = Real.zero :=
  \fun (admissible: AdmissibleBasisPair topology basis pair) =>
    (separator.good admissible).zeroOn;

\definition pairOneOn[topology: Topology] [basis: N.Nat^ -> \Pow Carrier] [pair: NatPair.NatPair]
  [separator: PairSeparator[topology, basis, pair]]:
  AdmissibleBasisPair topology basis pair ->
  \forall (x: Carrier) ->
    Member (Complement (basis (NatPair.natPairSecond pair))) x ->
    separator.value x = Real.one :=
  \fun (admissible: AdmissibleBasisPair topology basis pair) =>
    (separator.good admissible).oneOn;

\definition locallySeparatingCoordinate[topology: Topology]:
  IsT1 topology -> IsNormal topology ->
  \forall (basis: N.Nat^ -> \Pow Carrier) -> IsCountableBasis[topology, basis] ->
  \forall (select: \forall (pair: NatPair.NatPair) ->
    PairSeparator[topology, basis, pair]) ->
  \forall (U: \Pow Carrier) -> IsOpenIn topology U -> \forall (x: Carrier) ->
  Member U x ->
  \exists ( pair : NatPair.NatPair \where
    Logic.And[(select pair).value x = Real.zero,
      \forall (y: Carrier) -> Logic.Not (Member U y) ->
        (select pair).value y = Real.one] ) := \block {
    \fun (t1: IsT1 topology) (normal: IsNormal topology) (basis: N.Nat^ -> \Pow Carrier)
      (isBasis: IsCountableBasis[topology, basis])
      (select: \forall (pair: NatPair.NatPair) ->
    PairSeparator[topology, basis, pair]) (U: \Pow Carrier) (open: IsOpenIn topology U)
      (x: Carrier) (member: Member U x) \then
    \takefrom pair: \Cast[NatPair.NatPair]
      ({ pair : NatPair.NatPair \where
        LocalAdmissiblePairLaw[topology, basis, x, U, pair] })
      \by localAdmissiblePair topology t1 normal basis isBasis
        U open x member \then
    \let data: LocalAdmissiblePairLaw[
      topology, basis, x, U, pair] :=
      \bysub(NatPair.NatPair,
        { p : NatPair.NatPair \where
          LocalAdmissiblePairLaw[topology, basis, x, U, p] }, pair) \then
    \let admissible: AdmissibleBasisPair topology basis pair :=
      data.admissible \then
    \let separator: PairSeparator[topology, basis, pair] :=
      select pair \then
    \return Logic.existsIntro[NatPair.NatPair, { p : NatPair.NatPair \where
          Logic.And[(select p).value x = Real.zero,
            \forall (y: Carrier) -> Logic.Not (Member U y) ->
              (select p).value y = Real.one] }] pair
      (Logic.And[_, _]::#
          (pairZeroOn topology basis pair separator admissible x
            (pairInnerWithin topology basis pair separator admissible
              x (data.contains)))
          (\fun (y: Carrier) =>
            \fun (outsideU: Logic.Not (Member U y)) =>
              pairOneOn topology basis pair separator admissible y
                (\fun (insideBasis: Member
                  (basis (NatPair.natPairSecond pair)) y) =>
                  outsideU (data.within y insideBasis))))
  };

\structure SeparationCoordinates[topology: Topology]: \Set := {
  basis: N.Nat^ -> \Pow Carrier,
  select: \forall (pair: NatPair.NatPair) ->
    PairSeparator[topology, basis, pair],
  isBasis: IsCountableBasis[topology, basis],
};

\definition separationCoordinatesExist[topology: Topology]:
  IsT3 topology ->
  IsSecondCountable topology ->
  \exists SeparationCoordinates[topology] := \block {
    \fun (t3: IsT3 topology) (secondCountable: IsSecondCountable topology) \then
    \takefrom basis: \Cast[N.Nat^ -> \Pow Carrier]
      ({ f : N.Nat^ -> \Pow Carrier \where
        IsCountableBasis[topology, f] })
      \by secondCountable \then
    \let isBasis: IsCountableBasis[topology, basis] :=
      \bysub(N.Nat^ -> \Pow Carrier,
        { f : N.Nat^ -> \Pow Carrier \where
          IsCountableBasis[topology, f] }, basis) \then
    \takefrom select:
      \forall (pair: NatPair.NatPair) ->
        PairSeparator[topology, basis, pair]
      \by pairSeparatorsExist topology
        (Normal.regularSecondCountableNormal topology
          (t3.right) secondCountable)
        basis isBasis \then
    \return \exact(
      SeparationCoordinates[topology] {
        basis := basis,
        select := select,
 isBasis := isBasis },
      SeparationCoordinates[topology])
  };

\definition separationCoordinatesLocal[topology: Topology]:
  IsT1 topology -> IsNormal topology ->
  \forall (coordinates: SeparationCoordinates[topology]) -> \forall (U: \Pow Carrier) ->
  IsOpenIn topology U -> \forall (x: Carrier) -> Member U x ->
  \exists ( pair : NatPair.NatPair \where
    Logic.And[(coordinates.select pair).value x = Real.zero,
      \forall (y: Carrier) -> Logic.Not (Member U y) ->
        (coordinates.select pair).value y = Real.one] ) :=
  \fun (t1: IsT1 topology) (normal: IsNormal topology)
    (coordinates: SeparationCoordinates[topology]) =>
    locallySeparatingCoordinate topology t1 normal
    (coordinates.basis) (coordinates.isBasis)
    (coordinates.select);

\definition separationCoordinatesDistinguish[topology: Topology]:
  IsT1 topology -> IsNormal topology ->
  \forall (coordinates: SeparationCoordinates[topology]) -> \forall (x, y: Carrier) ->
  Logic.Not (x = y) ->
  \exists ( pair : NatPair.NatPair \where
    Logic.And[(coordinates.select pair).value x = Real.zero,
      (coordinates.select pair).value y = Real.one] ) := \block {
    \fun (t1: IsT1 topology) (normal: IsNormal topology)
      (coordinates: SeparationCoordinates[topology]) (x, y: Carrier)
      (different: Logic.Not (x = y)) \then
    \takefrom pair: \Cast[NatPair.NatPair]
      ({ p : NatPair.NatPair \where
        Logic.And[(coordinates.select p).value x = Real.zero,
          \forall (z: Carrier) ->
            Logic.Not (Member (Complement (Singleton y)) z) ->
            (coordinates.select p).value z = Real.one] })
      \by separationCoordinatesLocal topology t1 normal coordinates
        (Complement (Singleton y)) (t1 y) x
        (\fun (same: Member (Singleton y) x) =>
          different same) \then
    \let data: Logic.And[(coordinates.select pair).value x = Real.zero,
      \forall (z: Carrier) ->
        Logic.Not (Member (Complement (Singleton y)) z) ->
        (coordinates.select pair).value z = Real.one] :=
      \bysub(NatPair.NatPair,
        { p : NatPair.NatPair \where
          Logic.And[(coordinates.select p).value x = Real.zero,
            \forall (z: Carrier) ->
              Logic.Not (Member (Complement (Singleton y)) z) ->
              (coordinates.select p).value z = Real.one] }, pair) \then
    \return Logic.existsIntro[NatPair.NatPair, { p : NatPair.NatPair \where
          Logic.And[(coordinates.select p).value x = Real.zero,
            (coordinates.select p).value y = Real.one] }] pair
      (Logic.And[_, _]::# (data.left)
          (data.right y
            (\fun (outsideSingleton: Member (Complement (Singleton y)) y) =>
              outsideSingleton (\refl(y)))))
  };
