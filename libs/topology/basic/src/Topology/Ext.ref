\use Equality.congr;
\definition data: \forall (a, b: TopologyData) -> #openSets{a} = #openSets{b} -> a = b :=
  \induction (a: TopologyData) \return \forall (b: TopologyData) -> #openSets{a} = #openSets{b} -> a = b \with {
    | # : \fun (a: \Pow (\Pow Carrier)) => \induction (b: TopologyData) \return a = #openSets{b} -> TopologyData::# a = b \with {
      | # : \fun (b: \Pow (\Pow Carrier))(same: a = b) => congr!{\Pow (\Pow Carrier) TopologyData} (\fun (s: \Pow (\Pow Carrier)) => TopologyData::# s) a b same
    }
  };
\definition law: \forall (a, b: Topology) -> (\forall (U: \Pow Carrier) -> Logic.PropEquiv[IsOpenIn a U, IsOpenIn b U]) -> a = b :=
  \fun (a, b: Topology)(same: _) => data a b (\axiom:setext(#openSets{a}, #openSets{b},
    (\fun (U: \Pow Carrier) => #ltr{(same U)}), (\fun (U: \Pow Carrier) => #rtl{(same U)})));
