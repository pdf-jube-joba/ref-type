\use Equality.congr;
\definition data: \forall (a, b: TopologyData) -> (a).openSets = (b).openSets -> a = b :=
  \induction (a: TopologyData) \return \forall (b: TopologyData) -> (a).openSets = (b).openSets -> a = b \with {
    | # : \fun (a: \Pow (\Pow Carrier)) => \induction (b: TopologyData) \return a = (b).openSets -> TopologyData::# a = b \with {
      | # : \fun (b: \Pow (\Pow Carrier))(same: a = b) => congr!{\Pow (\Pow Carrier) TopologyData} (\fun (s: \Pow (\Pow Carrier)) => TopologyData::# s) a b same
    }
  };
\definition law: \forall (a, b: Topology) -> (\forall (U: \Pow Carrier) -> Logic.PropEquiv[IsOpenIn a U, IsOpenIn b U]) -> a = b :=
  \fun (a, b: Topology)(same: _) => data a b (\axiom:setext((a).openSets, (b).openSets,
    (\fun (U: \Pow Carrier) => (same U).ltr), (\fun (U: \Pow Carrier) => (same U).rtl)));
