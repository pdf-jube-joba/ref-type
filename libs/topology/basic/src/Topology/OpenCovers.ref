\definition Families: \Pow (\Pow (\Pow Carrier)) := { family: \Pow (\Pow Carrier) \where IsOpenCover[topology, family, Whole] };
\definition Cover: \Set := \Cast[\Pow (\Pow Carrier)] Families;
\definition family(cover: Cover): \Pow (\Pow Carrier) := cover;
\definition laws(cover: Cover): IsOpenCover[topology, family cover, Whole] := \bysub(\Pow (\Pow Carrier), Families, cover);
