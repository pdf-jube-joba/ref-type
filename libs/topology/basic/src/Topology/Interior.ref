\definition OpenInside(topology: Topology)(S: \Pow Carrier): \Pow (\Pow Carrier) :=
  { U: \Pow Carrier \where Logic.And[IsOpenIn topology U, Subset U S] };
\definition interior(topology: Topology)(S: \Pow Carrier): \Pow Carrier := Union (OpenInside topology S);
\definition open: \forall (topology: Topology)(S: \Pow Carrier) -> IsOpenIn topology (interior topology S) :=
  \fun (topology: Topology)(S: \Pow Carrier) => #unionOpen{(topologyLaws topology)} (OpenInside topology S)
    (\fun (U: \Pow Carrier)(member: FamilyMember (OpenInside topology S) U) => #left{member});
\definition inside: \forall (topology: Topology)(S: \Pow Carrier) -> Subset (interior topology S) S :=
  \fun (topology: Topology)(S: \Pow Carrier)(x: Carrier)(member: Member (interior topology S) x) =>
    unionMemberElim (OpenInside topology S) x (Member S x)
      (\fun (U: \Pow Carrier)(selected: FamilyMember (OpenInside topology S) U)(inU: Member U x) => #right{selected} x inU) member;
\definition greatest: \forall (topology: Topology)(S, U: \Pow Carrier) -> IsOpenIn topology U -> Subset U S -> Subset U (interior topology S) :=
  \fun (topology: Topology)(S, U: \Pow Carrier)(open: IsOpenIn topology U)(included: Subset U S)(x: Carrier)(member: Member U x) =>
    unionMemberOf (OpenInside topology S) U x (Logic.And[_, _]::# open included) member;
\definition fixed: \forall (topology: Topology)(U: \Pow Carrier) -> IsOpenIn topology U -> interior topology U = U :=
  \fun (topology: Topology)(U: \Pow Carrier)(open: IsOpenIn topology U) => \axiom:setext(interior topology U, U,
    inside topology U, greatest topology U U open (\fun (x: Carrier)(member: Member U x) => member));
