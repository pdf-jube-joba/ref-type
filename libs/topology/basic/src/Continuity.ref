/* Continuous maps between topological spaces. */
\import topology.Topology[Carrier := A] \as Source;
\import topology.Topology[Carrier := B] \as Target;
\import std.Logic[].Proposition[] \as Logic;

\definition Preimage(f: A -> B) (V: \Pow B): \Pow A :=
  { x : A \where \In[B] V (f x) };

\definition Continuous(source: Source.Topology) (target: Target.Topology) (f: A -> B):
  \Prop :=
  \forall (V: \Pow B) -> Target.IsOpenIn target V ->
    Source.IsOpenIn source (Preimage f V);

\definition compose(C: \Set) (f: A -> B) (g: B -> C): A -> C :=
  \fun (x: _) => g (f x);

\definition RestrictedCarrier(S: \Pow A): \Set := \Cast[A] S;

\definition Trace(S, U: \Pow A): \Pow (RestrictedCarrier S) :=
  { x : RestrictedCarrier S \where \In[A] U x };

\definition Restrict(S: \Pow A) (f: A -> B): RestrictedCarrier S -> B :=
  \fun (x: _) => f x;

\definition RestrictedPreimage(S: \Pow A) (f: A -> B) (V: \Pow B): \Pow (RestrictedCarrier S) :=
  { x : RestrictedCarrier S \where \In[B] V (Restrict S f x) };

\definition SubspaceBasis(source: Source.Topology) (S: \Pow A):
  \Pow (\Pow (RestrictedCarrier S)) :=
  { W : \Pow (RestrictedCarrier S) \where
    \exists { U : \Pow A \where
      Logic.And[Source.IsOpenIn source U, W = Trace S U] } };

\definition restrictBasisOpen(source: Source.Topology) (target: Target.Topology)
  (S: \Pow A) (f: A -> B):
  Continuous source target f ->
  \forall (V: \Pow B) -> Target.IsOpenIn target V ->
    \In[\Pow (RestrictedCarrier S)] (SubspaceBasis source S)
      (RestrictedPreimage S f V) :=
  \fun (continuous: Continuous source target f) (V: \Pow B) (open: Target.IsOpenIn target V) =>
      Logic.existsIntro[\Pow A, { U : \Pow A \where
            Logic.And[Source.IsOpenIn source U,
              RestrictedPreimage S f V = Trace S U] }] (Preimage f V)
      (Logic.And[_, _]::# (continuous V open)
              (\axiom:setext(RestrictedPreimage S f V, Trace S (Preimage f V),
                (\fun (x: RestrictedCarrier S) => \fun (member: \In[B] V (f x)) => member),
                (\fun (x: RestrictedCarrier S) => \fun (member: \In[B] V (f x)) => member))));

\module Restriction(S: \Pow A);
\module Corestriction(S: \Pow B);
\module Covers;
\definition closedPreimage: \forall (source: Source.Topology)(target: Target.Topology)(f: A -> B) ->
  Continuous source target f -> \forall (S: \Pow B) -> Target.IsClosedIn target S -> Source.IsClosedIn source (Preimage f S) :=
  \fun (source: Source.Topology)(target: Target.Topology)(f: A -> B)(continuous: Continuous source target f)(S: \Pow B)(closed: Target.IsClosedIn target S) =>
    continuous (Target.Complement S) closed;
