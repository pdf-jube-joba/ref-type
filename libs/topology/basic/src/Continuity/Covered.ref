\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.congr;
\definition Local[source: Source.Topology][target: Target.Topology][f: A -> B]: \Prop := \forall (i: I) ->
  topology.Continuity[A := \Cast[A] (domains i), B := B].Continuous (Source.Subspace[S := domains i].topology source) target (\fun (x: \Cast[A] (domains i)) => f x);
\module Of(source: Source.Topology, target: Target.Topology, f: A -> B,
  open: \forall (i: I) -> Source.IsOpenIn source (domains i), covers: \forall (x: A) -> \exists ( i: I \where \In[A] (domains i) x ), local: Local source target f);
\definition continuous: \forall (source: Source.Topology)(target: Target.Topology)(f: A -> B) ->
  (\forall (i: I) -> Source.IsOpenIn source (domains i)) -> (\forall (x: A) -> \exists ( i: I \where \In[A] (domains i) x )) ->
  Local source target f -> Continuous source target f := \fun (source: Source.Topology)(target: Target.Topology)(f: A -> B)(open: _)(covers: _)(local: _) =>
    Of[source := source, target := target, f := f, open := open, covers := covers, local := local].continuous;
