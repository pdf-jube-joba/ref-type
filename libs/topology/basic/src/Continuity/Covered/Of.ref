\module At(i: I);
\definition continuous: Continuous source target f := \fun (W: \Pow B)(openW: _) => Source.openOfNeighborhoods source (Preimage f W) (\block {
  \fun (x: A)(inside: _) \then
  \takefrom i: \Cast[I] ({ i: I \where \In[A] (domains i) x }) \by covers x \then
  \return Logic.existsIntro[\Pow A, { U: \Pow A \where Source.OpenNeighborhood[source, x, Preimage f W, U] }]
    (At[i := i].neighborhood W) (Source.OpenNeighborhood[source, x, Preimage f W, At[i := i].neighborhood W] {
      open := At[i := i].open W openW, contains := At[i := i].contains W x (\bysub(I, { i: I \where \In[A] (domains i) x }, i)) inside,
      within := At[i := i].within W,
    })
});
