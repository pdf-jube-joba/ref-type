\import Source.Subspace[S := domains i] \as Subspace;
\import Subspace.Open[] \as OpenSubspace;
\definition preimage[W: \Pow B]: \Pow Subspace.CarrierSet := { x: Subspace.CarrierSet \where \In[B] W (f x) };
\definition neighborhood[W: \Pow B]: \Pow A := OpenSubspace.image (preimage W);
\definition open: \forall (W: \Pow B) -> Target.IsOpenIn target W -> Source.IsOpenIn source (neighborhood W) :=
  \fun (W: \Pow B)(openW: _) => OpenSubspace.imageOpen source (open i) (preimage W) (local i W openW);
\definition contains: \forall (W: \Pow B)(x: A) -> \In[A] (domains i) x -> \In[B] W (f x) -> \In[A] (neighborhood W) x :=
  \fun (W: \Pow B)(x: A)(member: _)(inside: _) => OpenSubspace.imageMember (preimage W) (\into[A](x, domains i) \by { member }) inside;
\definition within: \forall (W: \Pow B) -> Source.Subset (neighborhood W) (Preimage f W) :=
  \fun (W: \Pow B)(x: A)(inside: _) => OpenSubspace.imageElim (preimage W) x (\In[B] W (f x))
    (\fun (y: Subspace.CarrierSet)(member: _)(same: y = x) => \idelim f y = f x \with z: B => \In[B] W z \by {
      base: member, equality: congr!{A B} f _ _ same
    }) inside;
