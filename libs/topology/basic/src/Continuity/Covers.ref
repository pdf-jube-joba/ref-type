\import topology.Maps[A := A, B := B] \as Maps;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\definition pullback: \forall (source: Source.Topology)(target: Target.Topology)(f: A -> B) -> Continuous source target f ->
  \forall (family: \Pow (\Pow B)) -> Target.IsOpenCover[target, family, Target.Whole] -> Source.IsOpenCover[source, Maps.PullbackFamily f family, Source.Whole] :=
  \fun (source: Source.Topology)(target: Target.Topology)(f: A -> B)(continuous: Continuous source target f)(family: \Pow (\Pow B))(cover: Target.IsOpenCover[target, family, Target.Whole]) =>
    Source.IsOpenCover[source, Maps.PullbackFamily f family, Source.Whole] {
      open := \fun (U: \Pow A)(member: Source.FamilyMember (Maps.PullbackFamily f family) U) => Maps.pullbackElim f family U (Source.IsOpenIn source U)
        (\fun (V: \Pow B)(inFamily: Target.FamilyMember family V)(same: U = Maps.Preimage f V) =>
          \idelim Maps.Preimage f V = U \with W: \Pow A => Source.IsOpenIn source W \by {
            base: continuous V ((cover).open V inFamily), equality: sym!{{\Pow A}} _ _ same
          }) member,
      covers := \fun (x: A)(inWhole: Source.Member Source.Whole x) => Target.unionMemberElim family (f x) (Source.Member (Source.Union (Maps.PullbackFamily f family)) x)
        (\fun (V: \Pow B)(inFamily: Target.FamilyMember family V)(inV: Target.Member V (f x)) =>
          Source.unionMemberOf (Maps.PullbackFamily f family) (Maps.Preimage f V) x (Maps.pullbackMember f family V inFamily) inV)
        ((cover).covers (f x) (\refl(f x))),
    };
