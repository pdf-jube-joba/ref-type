\import Covers.On[cover := cover].Chains[] \as Cover;
\import Cover.Disjoint[] \as Disjoint;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Signed;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Nonnegative;
\import singular_cohomology.Chains[A := Sphere.Point, source := Sphere.discrete] \as PointChains;
\import singular_cohomology.Chains[A := Left.CarrierSet, source := Left.topology Sphere.discrete] \as LeftChains;
\import singular_cohomology.Chains[A := Right.CarrierSet, source := Right.topology Sphere.discrete] \as RightChains;
\import Nonnegative.ZeroExtension[C := PointChains.complex] \as PointExtension;
\import Nonnegative.ZeroExtension[C := LeftChains.complex] \as LeftExtension;
\import Nonnegative.ZeroExtension[C := RightChains.complex] \as RightExtension;
\import Modules.Biproduct[V := I.Int^, W := I.Int^, left := Modules.scalarModule, right := Modules.scalarModule] \as CoefficientPairs;
\definition coefficientPairs: Modules.Bundle := Modules.Bundle { Carrier := CoefficientPairs.Carrier, space := CoefficientPairs.space };
\import \root.Isomorphisms[] \as Isomorphisms;
\import algebraic_topology.HomotopyEquivalence[A := Sphere.Point, B := Spheres.Carrier N.Nat^::zero] \as Equivalences;
\definition equivalence: Equivalences.Equivalence[Sphere.discrete, Spheres.topology N.Nat^::zero] :=
  Equivalences.fromHomeomorphism Sphere.discrete (Spheres.topology N.Nat^::zero) Geometry.homeomorphism;
\module Degree(n: N.Nat^);
\module OnSphere(n: N.Nat^);
\module Zero;
\module Positive(n: N.Nat^);
