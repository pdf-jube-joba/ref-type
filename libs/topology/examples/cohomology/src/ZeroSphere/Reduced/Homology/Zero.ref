\import \parent.At[z := I.Int^::ofNat N.Nat^::zero] \as Shift;
\import Modules.Isomorphism[V := I.Int^, W := Shift.target.Carrier, source := Modules.scalarModule, target := Shift.target.space]
  .Composition[U := Shift.source.Carrier, final := Shift.source.space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := I.Int^, W := Shift.source.Carrier, source := Modules.scalarModule, target := Shift.source.space].Isomorphism :=
  Composition.compose Shift.upward (Empty.NegativeOne[].isomorphism empty);
