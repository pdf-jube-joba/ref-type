\definition lower: I.Int^ := Degrees.previous z;
\import singular_cohomology.Chains[A := Sphere.Point, source := Sphere.discrete].Reduced[].At[z := z] \as Middle;
\import singular_cohomology.Chains[A := Spheres.Carrier N.Nat^::zero, source := Spheres.topology N.Nat^::zero].Reduced[].At[z := z] \as Source;
\import singular_cohomology.Chains[A := Cover.Intersection, source := IntersectionTopology.topology (Left.topology Sphere.discrete)].Reduced[].At[z := lower] \as Target;
\definition source: Modules.Bundle := Modules.Bundle { Carrier := Source.Carrier, space := Source.space };
\definition target: Modules.Bundle := Modules.Bundle { Carrier := Target.Carrier, space := Target.space };
\import singular_cohomology.Equivalence[A := Sphere.Point, B := Spheres.Carrier N.Nat^::zero, source := Sphere.discrete, target := Spheres.topology N.Nat^::zero]
  .Reduced[].Homology[z := z] \as Comparison;
\import Modules.Isomorphism[V := Middle.Carrier, W := Source.Carrier, source := Middle.space, target := Source.space].Inverse[] \as ComparisonInverse;
\import Modules.Isomorphism[V := Source.Carrier, W := Middle.Carrier, source := Source.space, target := Middle.space]
  .Composition[U := Target.Carrier, final := Target.space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := source.Carrier, W := target.Carrier, source := source.space, target := target.space].Isomorphism :=
  Composition.compose
    (Cover.Homology[z := z].isomorphism (LeftContraction.contraction leftUnique) (RightContraction.contraction rightUnique))
    (ComparisonInverse.inverse (Comparison.isomorphism equivalence));
\import Modules.Isomorphism[V := source.Carrier, W := target.Carrier, source := source.space, target := target.space].Inverse[] \as Inverse;
\definition upward: Modules.Isomorphism[V := target.Carrier, W := source.Carrier, source := target.space, target := source.space].Isomorphism := Inverse.inverse isomorphism;
