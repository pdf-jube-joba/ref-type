\import \parent.At[z := I.Int^::negSucc (N.Nat^::succ n)] \as Suspension;
\import Modules.Isomorphism[V := Suspension.source.Carrier, W := Suspension.target.Carrier, source := Suspension.source.space, target := Suspension.target.space].Vanishing[] \as Vanishing;
\definition zero: \forall (q: Suspension.target.Carrier) -> q = (Suspension.target.space).zero :=
  Vanishing.targetZero Suspension.isomorphism (Empty.Negative[n := n].zero);
