\import algebraic_topology.HomotopyEquivalence[A := Sphere.Point, B := Spheres.Carrier N.Nat^::zero] \as Equivalences;
\definition equivalence: Equivalences.Equivalence[Sphere.discrete, Spheres.topology N.Nat^::zero] :=
  Equivalences.fromHomeomorphism Sphere.discrete (Spheres.topology N.Nat^::zero) Geometry.homeomorphism;
\import singular_cohomology.Equivalence[A := Sphere.Point, B := Spheres.Carrier N.Nat^::zero, source := Sphere.discrete, target := Spheres.topology N.Nat^::zero].With[coefficients := coefficients] \as GeometricComparison;
\import singular_cohomology.Cochains[A := Spheres.Carrier N.Nat^::zero, source := Spheres.topology N.Nat^::zero].With[coefficients := coefficients] \as Cochains;
\definition point: Modules.Bundle := Modules.Bundle { Carrier := PointCochains.cohomology n, space := PointCochains.cohomologySpace n };
\definition sphere: Modules.Bundle := Modules.Bundle { Carrier := Cochains.cohomology n, space := Cochains.cohomologySpace n };
\definition isomorphism: Modules.Isomorphism[V := point.Carrier, W := sphere.Carrier, source := point.space, target := sphere.space].Isomorphism :=
  GeometricComparison.At[n := n].isomorphism equivalence;
\import Modules.Isomorphism[V := point.Carrier, W := sphere.Carrier, source := point.space, target := sphere.space].Inverse[] \as Reverse;
\definition inverse: Modules.Isomorphism[V := sphere.Carrier, W := point.Carrier, source := sphere.space, target := point.space].Isomorphism := Reverse.inverse isomorphism;
