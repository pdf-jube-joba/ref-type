\import \parent.Degree[n := N.Nat^::succ n] \as Degree;
\import \parent.OnSphere[n := N.Nat^::succ n] \as SphereComparison;
\import LeftChains.Reduced[].Positive[n := n] \as LeftComparison;
\import RightChains.Reduced[].Positive[n := n] \as RightComparison;
\import LeftChains.Reduced[].Singleton[a := leftPoint].Homology[z := Degree.degree] \as LeftReduced;
\import RightChains.Reduced[].Singleton[a := rightPoint].Homology[z := Degree.degree] \as RightReduced;
\import singular_cohomology.Chains[A := Left.CarrierSet, source := Left.topology Sphere.discrete].Reduced[].At[z := Degree.degree] \as LeftH;
\import singular_cohomology.Chains[A := Right.CarrierSet, source := Right.topology Sphere.discrete].Reduced[].At[z := Degree.degree] \as RightH;
\import Modules.Isomorphism[V := LeftH.Carrier, W := Degree.left.Carrier, source := LeftH.space, target := Degree.left.space].Vanishing[] \as LeftVanishing;
\import Modules.Isomorphism[V := RightH.Carrier, W := Degree.right.Carrier, source := RightH.space, target := Degree.right.space].Vanishing[] \as RightVanishing;
\definition leftZero: \forall (q: Degree.left.Carrier) -> q = (Degree.left.space).zero := LeftVanishing.targetZero LeftComparison.isomorphism (LeftReduced.zero leftUnique);
\definition rightZero: \forall (q: Degree.right.Carrier) -> q = (Degree.right.space).zero := RightVanishing.targetZero RightComparison.isomorphism (RightReduced.zero rightUnique);
\import Modules.Biproduct[V := Degree.left.Carrier, W := Degree.right.Carrier, left := Degree.left.space, right := Degree.right.space] \as Pair;
\import std.Data[].Pair[].Prop[A := Degree.left.Carrier, B := Degree.right.Carrier] \as Pairs;
\definition pairZero: \forall (q: Degree.pair.Carrier) -> q = (Degree.pair.space).zero :=
  \fun (q: Degree.pair.Carrier) => Pairs.ext q Pair.origin (leftZero (Pair.first q)) (rightZero (Pair.second q));
\import Isomorphisms.Vanishing[A := Degree.native, B := Degree.pair] \as PointVanishing;
\definition pointZero: \forall (q: Degree.native.Carrier) -> q = (Degree.native.space).zero := PointVanishing.zero Degree.isomorphism pairZero;
\import Isomorphisms.Vanishing[A := SphereComparison.sphere, B := Degree.native] \as Vanishing;
\definition zero: \forall (q: SphereComparison.sphere.Carrier) -> q = (SphereComparison.sphere.space).zero := Vanishing.zero SphereComparison.inverse pointZero;
