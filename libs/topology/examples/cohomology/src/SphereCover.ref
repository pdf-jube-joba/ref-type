\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\import algebraic_topology.Spheres[] \as Spheres;
\import Spheres.Positive[n := n] \as Geometry;
\import singular_excision.MayerVietoris[A := Geometry.Sphere].Over[source := Spheres.topology (N.Nat^::succ n)] \as Covers;
\definition cover: Covers.Cover := \into[Covers.Data](Covers.Data { left := Geometry.left, right := Geometry.right }, Covers.Cover) \by {
  Covers.Laws[Covers.Data { left := Geometry.left, right := Geometry.right }] {
    leftOpen := Geometry.leftOpen, rightOpen := Geometry.rightOpen, covered := Geometry.covered,
  }
};
\definition leftContraction: algebraic_topology.Contraction[A := Geometry.Left, source := Geometry.leftTopology].Data := Geometry.NorthContraction[].contraction;
\definition rightContraction: algebraic_topology.Contraction[A := Geometry.Right, source := Geometry.rightTopology].Data := Geometry.SouthContraction[].contraction;
\definition intersectionEquivalence: algebraic_topology.HomotopyEquivalence[A := Spheres.Carrier n, B := Geometry.Intersection].Equivalence[Spheres.topology n, Geometry.intersectionTopology] := Geometry.Equatorial[].equivalence;
\module With(coefficients: Modules.Bundle);
\module Homology(z: I.Int^);
