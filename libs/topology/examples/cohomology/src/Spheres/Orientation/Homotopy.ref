\import singular_cohomology.Homotopy[A := Sphere, B := Sphere, source := topology, target := topology] \as Homotopies;
\definition law: \forall (f, g: Sphere -> Sphere)(h: Homotopies.Family f g) ->
  degree f (Homotopies.startContinuous f g h) = degree g (Homotopies.endContinuous f g h) :=
  \fun (f, g: Sphere -> Sphere)(h: Homotopies.Family f g) => congr!{Carrier I.Int^} ((toCoefficient).apply)
    ((action f (Homotopies.startContinuous f g h)).apply generator)
    ((action g (Homotopies.endContinuous f g h)).apply generator)
    (sym!{Carrier}
      ((action g (Homotopies.endContinuous f g h)).apply generator)
      ((action f (Homotopies.startContinuous f g h)).apply generator)
      (Homotopies.Coefficients[M := coefficients].onCohomology f g h dimension generator));
