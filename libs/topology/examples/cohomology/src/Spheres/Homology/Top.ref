\import \parent.Reduced[] \as Reduced;
\import singular_cohomology.Chains[A := Geometry.Carrier (N.Nat^::succ n), source := Geometry.topology (N.Nat^::succ n)].Reduced[].Positive[n := n] \as Comparison;
\import Modules.Isomorphism[V := I.Int^, W := Reduced.homology (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ n)), source := Modules.scalarModule, target := Reduced.space (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ n))]
  .Composition[U := homology (N.Nat^::succ n) (N.Nat^::succ n), final := space (N.Nat^::succ n) (N.Nat^::succ n)] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := I.Int^, W := homology (N.Nat^::succ n) (N.Nat^::succ n), source := Modules.scalarModule, target := space (N.Nat^::succ n) (N.Nat^::succ n)].Isomorphism :=
  Composition.compose Comparison.isomorphism (Reduced.top (N.Nat^::succ n));
