\import chain_complexes.Chain[] \as Degrees;
\module At(n: N.Nat^, z: I.Int^) {
  \import singular_cohomology.Chains[A := Geometry.Carrier n, source := Geometry.topology n].Reduced[].At[z := z] \as Theory;
  \definition Carrier: \Set := Theory.Carrier;
  \definition space: Modules.Space Carrier := Theory.space;
}
\definition homology[n: N.Nat^][z: I.Int^]: \Set := At[n := n, z := z].Carrier;
\definition space[n: N.Nat^][z: I.Int^]: Modules.Space (homology n z) := At[n := n, z := z].space;
\definition TopIsomorphism[n: N.Nat^]: \Set := Modules.Isomorphism[V := I.Int^, W := homology n (I.Int^::ofNat n), source := Modules.scalarModule, target := space n (I.Int^::ofNat n)].Isomorphism;
\import \root.ZeroSphere[].Reduced[].Homology[] \as Base;
\module TopStep(n: N.Nat^);
\definition top: \forall (n: N.Nat^) -> TopIsomorphism n :=
  \induction (n: N.Nat^) \return TopIsomorphism n \with {
    | zero: Base.Zero[].isomorphism
    | succ: \fun (n: N.Nat^)(previous: TopIsomorphism n) => TopStep[n := n].isomorphism previous
  };
\definition aboveDegree[n, k: N.Nat^]: I.Int^ := I.Int^::ofNat (Nat.add k (N.Nat^::succ n));
\module AboveStep(n, k: N.Nat^);
\definition above: \forall (n, k: N.Nat^)(q: homology n (aboveDegree n k)) -> q = (space n (aboveDegree n k)).zero :=
  \induction (n: N.Nat^) \return \forall (k: N.Nat^)(q: homology n (aboveDegree n k)) -> q = (space n (aboveDegree n k)).zero \with {
    | zero: \fun (k: N.Nat^) => Base.Positive[n := k].zero
    | succ: \fun (n: N.Nat^)(previous: _)(k: N.Nat^) => AboveStep[n := n, k := k].zero (previous k)
  };
\module NegativeStep(n, k: N.Nat^);
\definition negative: \forall (n, k: N.Nat^)(q: homology n (I.Int^::negSucc k)) -> q = (space n (I.Int^::negSucc k)).zero :=
  \induction (n: N.Nat^) \return \forall (k: N.Nat^)(q: homology n (I.Int^::negSucc k)) -> q = (space n (I.Int^::negSucc k)).zero \with {
    | zero: \fun (k: N.Nat^) => Base.Negative[n := k].zero
    | succ: \fun (n: N.Nat^)(previous: _)(k: N.Nat^) => NegativeStep[n := n, k := k].zero (previous (N.Nat^::succ k))
  };
\module BelowStep(k, distance: N.Nat^);
\module BelowZero(distance: N.Nat^);
\definition below: \forall (k, distance: N.Nat^)(q: homology (Nat.add (N.Nat^::succ distance) k) (I.Int^::ofNat k)) ->
  q = (space (Nat.add (N.Nat^::succ distance) k) (I.Int^::ofNat k)).zero :=
  \induction (k: N.Nat^) \return \forall (distance: N.Nat^)(q: homology (Nat.add (N.Nat^::succ distance) k) (I.Int^::ofNat k)) ->
    q = (space (Nat.add (N.Nat^::succ distance) k) (I.Int^::ofNat k)).zero \with {
      | zero: \fun (distance: N.Nat^) => BelowZero[distance := distance].zero (negative distance N.Nat^::zero)
      | succ: \fun (k: N.Nat^)(previous: _)(distance: N.Nat^) => BelowStep[k := k, distance := distance].zero (previous distance)
    };
