\import \root.SphereCover[n := n].Homology[z := I.Int^::ofNat (N.Nat^::succ n)] \as Shift;
\import Modules.Isomorphism[V := I.Int^, W := homology n (I.Int^::ofNat n), source := Modules.scalarModule, target := space n (I.Int^::ofNat n)]
  .Composition[U := homology (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ n)), final := space (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ n))] \as Composition;
\definition isomorphism[previous: TopIsomorphism n]: TopIsomorphism (N.Nat^::succ n) := Composition.compose Shift.upward previous;
