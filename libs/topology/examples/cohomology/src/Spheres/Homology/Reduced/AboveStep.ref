\import \root.SphereCover[n := n].Homology[z := aboveDegree (N.Nat^::succ n) k] \as Shift;
\import Modules.Isomorphism[V := homology n (aboveDegree n k), W := homology (N.Nat^::succ n) (aboveDegree (N.Nat^::succ n) k), source := space n (aboveDegree n k), target := space (N.Nat^::succ n) (aboveDegree (N.Nat^::succ n) k)].Vanishing[] \as Vanishing;
\definition zero[previous: \forall (q: homology n (aboveDegree n k)) -> q = (space n (aboveDegree n k)).zero]:
  \forall (q: homology (N.Nat^::succ n) (aboveDegree (N.Nat^::succ n) k)) -> q = (space (N.Nat^::succ n) (aboveDegree (N.Nat^::succ n) k)).zero :=
  Vanishing.targetZero Shift.upward previous;
