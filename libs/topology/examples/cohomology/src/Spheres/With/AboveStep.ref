\import \parent.Reduced[] \as Reduced;
\import singular_cohomology.Cochains[A := Geometry.Carrier n, source := Geometry.topology n].With[coefficients := coefficients].Reduced[].Positive[n := Nat.add k n] \as Comparison;
\import Modules.Isomorphism[V := Reduced.cohomology n (Reduced.aboveDegree n k), W := cohomology n (aboveDegree n k), source := Reduced.space n (Reduced.aboveDegree n k), target := space n (aboveDegree n k)].Vanishing[] \as Vanishing;
\definition zero: \forall (q: cohomology n (aboveDegree n k)) -> q = (space n (aboveDegree n k)).zero :=
  Vanishing.targetZero Comparison.isomorphism (Reduced.above n k);
