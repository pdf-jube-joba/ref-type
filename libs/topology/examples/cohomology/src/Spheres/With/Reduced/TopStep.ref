\import \root.SphereCover[n := n].With[coefficients := coefficients].Reduced[z := I.Int^::ofNat n] \as Shift;
\import Modules.Isomorphism[V := coefficients.Carrier, W := cohomology n (I.Int^::ofNat n), source := coefficients.space, target := space n (I.Int^::ofNat n)]
  .Composition[U := cohomology (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ n)), final := space (N.Nat^::succ n) (I.Int^::ofNat (N.Nat^::succ n))] \as Composition;
\definition isomorphism[previous: TopIsomorphism n]: TopIsomorphism (N.Nat^::succ n) := Composition.compose Shift.isomorphism previous;
