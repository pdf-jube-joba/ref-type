\import \root.SphereCover[n := n].With[coefficients := coefficients].Reduced[z := I.Int^::negSucc (N.Nat^::succ k)] \as Shift;
\import Modules.Isomorphism[V := cohomology n (I.Int^::negSucc (N.Nat^::succ k)), W := cohomology (N.Nat^::succ n) (I.Int^::negSucc k), source := space n (I.Int^::negSucc (N.Nat^::succ k)), target := space (N.Nat^::succ n) (I.Int^::negSucc k)].Vanishing[] \as Vanishing;
\definition zero[previous: \forall (q: cohomology n (I.Int^::negSucc (N.Nat^::succ k))) -> q = (space n (I.Int^::negSucc (N.Nat^::succ k))).zero]:
  \forall (q: cohomology (N.Nat^::succ n) (I.Int^::negSucc k)) -> q = (space (N.Nat^::succ n) (I.Int^::negSucc k)).zero :=
  Vanishing.targetZero Shift.isomorphism previous;
