\definition value: \forall (n, k: N.Nat^)(q: cohomology n (I.Int^::negSucc k)) -> q = (space n (I.Int^::negSucc k)).zero :=
  \induction (n: N.Nat^) \return \forall (k: N.Nat^)(q: cohomology n (I.Int^::negSucc k)) -> q = (space n (I.Int^::negSucc k)).zero \with {
    | zero: \fun (k: N.Nat^) => Base.Negative[n := k].zero
    | succ: \fun (n: N.Nat^)(previous: _)(k: N.Nat^) => \parent.NegativeStep[n := n, k := k].zero (previous (N.Nat^::succ k))
  };
