\use std.Logic[].Equality[].eq_reason_in;
\import algebra.GroupCompletion[].Natural[] \as Completion;
\import std.Arithmetic[].Int[] \as Integers;
\import real.Analysis[] \as Real;
\import linear_algebra.Real[] \as R;
\import linear_algebra.Commutative[K := Real.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Real.Real (R.field)] \as Algebra;
\import Algebra.DirectSum[V := Real.Real, W := Real.Real, left := Algebra.scalarSpace, right := Algebra.scalarSpace] \as Sum;
\import Sum.Universal[U := Real.Real, domain := Algebra.scalarSpace] \as Pair;
\import Algebra.Linear[V := Real.Real, W := Real.Real, source := Algebra.scalarSpace, target := Algebra.scalarSpace] \as Maps;
\definition integerRoundTrip: \forall (z: Integers.Int^) -> Completion.toInt (Completion.fromInt z) = z := Completion.toFrom;
\definition identity: Maps.Map := Maps.Map { apply := \fun (x: Real.Real) => x,
  preservesAdd := \fun (x, y: Real.Real) => \refl(Real.add x y),
  preservesScale := \fun (a, x: Real.Real) => \refl(Real.mul a x),
};
\definition diagonal: Real.Real -> Sum.Carrier := (Pair.pair identity identity).apply;
\definition diagonalFirst: \forall (x: Real.Real) -> Sum.first (diagonal x) = x := \fun (x: _) => \refl(x);
\definition diagonalSecond: \forall (x: Real.Real) -> Sum.second (diagonal x) = x := \fun (x: _) => \refl(x);
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as ScalarLaws;
\import Real.Algebra[] \as ScalarAlgebra;
\import Algebra.Dual[V := Real.Real, source := Algebra.scalarSpace] \as Dual;
\import Dual.Precomposition[W := Real.Real, target := Algebra.scalarSpace] \as DualMaps;
\definition functional: Dual.Carrier := Dual.fromMap identity;
\definition functionalValue: \forall (x: Real.Real) -> functional x = x := \fun (x: _) => \refl(x);
\definition dualIdentityValue: \forall (f: Dual.Carrier) (x: Real.Real) -> (DualMaps.map identity).apply f x = f x :=
  \fun (f: _) (x: _) => \refl(f x);
\import Algebra.Tensor[V := Real.Real, W := Real.Real, left := Algebra.scalarSpace, right := Algebra.scalarSpace] \as Tensor;
\import Tensor.Universal[U := Real.Real, target := Algebra.scalarSpace] \as TensorMaps;
\definition multiplicationLaws: Tensor.BilinearLaws[Real.Real, Algebra.scalarSpace, Real.mul] :=
  Tensor.BilinearLaws[Real.Real, Algebra.scalarSpace, Real.mul] {
    addLeft := ScalarAlgebra.mulAddRight,
    addRight := ScalarLaws.fieldMulAdd,
    scaleLeft := ScalarLaws.fieldMulAssoc,
    scaleRight := \fun (a, x, y: Real.Real) => eq_reason_in!{Real.Real _
      "=" _ "by" { sym!{Real.Real} _ _ (ScalarLaws.fieldMulAssoc x a y) }
      "=" _ "by" { congr!{Real.Real Real.Real} (\fun (t: Real.Real) => Real.mul t y) _ _ (ScalarLaws.fieldMulComm x a) }
      "=" _ "by" { ScalarLaws.fieldMulAssoc a x y }
    },
  };
\definition tensorContraction: _ := TensorMaps.map Real.mul multiplicationLaws;
\definition tensorProductValue: \forall (x, y: Real.Real) -> tensorContraction.apply (Tensor.tensor x y) = Real.mul x y :=
  TensorMaps.onTensor Real.mul multiplicationLaws;
