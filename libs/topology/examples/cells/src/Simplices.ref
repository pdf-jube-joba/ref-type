\import algebraic_topology.Simplex[] \as Simplex;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\definition Points[n: N.Nat^]: \Set := Simplex.Carrier n;
\definition chosen: \forall (n: N.Nat^) -> Points n := Simplex.lastVertex;
\definition point: Points N.Nat^::zero := Simplex.zeroPoint;
\definition unique: \forall (x: Points N.Nat^::zero) -> x = point := Simplex.zeroUnique;
\module Degree(n: N.Nat^) {
  \import Simplex.At[n := n] \as Space;
  \import topology.Topology[Carrier := Points n] \as Topology;
  \definition topology: Topology.Topology := Space.topology;
  \definition face[i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))][x: Points n]: Points (N.Nat^::succ n) := Simplex.face n i x;
  \definition positive: \forall (x: Points n)(i: Fin.Fin (N.Nat^::succ n)) -> R.Le Real.zero (x i) :=
    \fun (x: Points n) => (Simplex.barycentric n x).nonnegative;
  \import topology.Continuity[A := Points n, B := Real.Real] \as Maps;
  \import metric_spaces.RealLine[] \as Line;
  \definition coordinateContinuous: \forall (i: Fin.Fin (N.Nat^::succ n)) ->
    Maps.Continuous topology Line.topology (\fun (x: Points n) => x i) := Space.coordinateContinuous;
  \definition firstCoordinate: \forall (x: Points n) -> Simplex.faceFirst n x (Fin.zero (N.Nat^::succ n)) = Real.zero := Simplex.faceFirstZero n;
  \definition tailCoordinates: \forall (x: Points n)(i: Fin.Fin (N.Nat^::succ n)) ->
    Simplex.faceFirst n x (Fin.succ (N.Nat^::succ n) i) = x i := Simplex.faceFirstSuccessor n;
  \import Simplex.Faces[n := n] \as Faces;
  \import Simplex.At[n := N.Nat^::succ n] \as Next;
  \import topology.Continuity[A := Points n, B := Points (N.Nat^::succ n)] \as FaceMaps;
  \definition faceContinuous: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) ->
    FaceMaps.Continuous topology Next.topology (face i) := Faces.continuous;
  \import Simplex.Vertices[] \as Vertices;
  \definition vertex[i: Fin.Fin (N.Nat^::succ n)]: Points n := Vertices.vertex n i;
  \import Simplex.Compactness[n := n] \as Compactness;
  \definition compact: Topology.IsCompact topology := Compactness.compact;
  \definition coordinateBound: \forall (x: Points n)(i: Fin.Fin (N.Nat^::succ n)) -> R.Le (x i) Real.one := Compactness.coordinateBound;
  \definition barycentre: Points n := Simplex.Barycentre[n := n].point;
  \import Simplex.Contraction[n := n] \as Contraction;
  \definition contraction: _ := Contraction.contraction barycentre;
}
\module Affine(m, n: N.Nat^) {
  \import Simplex.Affine[m := m, n := n] \as Maps;
  \definition map: Maps.Vertices -> Points m -> Points n := Maps.apply;
  \definition continuous: _ := Maps.continuous;
  \definition composition[k: N.Nat^]: _ := Maps.Composition[k := k].law;
}
\module AffineIdentity(n: N.Nat^) {
  \import Simplex.AffineIdentity[n := n] \as Identity;
  \definition law: _ := Identity.law;
}
\module AffineFaces(m, n: N.Nat^) {
  \import Simplex.AffineFaces[m := m, n := n] \as Faces;
  \definition law: _ := Faces.law;
}
