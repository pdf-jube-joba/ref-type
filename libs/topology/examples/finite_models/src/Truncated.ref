\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import std.Data[].Nat[] \as N;
\import module_theory.Module[].Over[R := I.Int^, ring := IntegerRing.ring] \as Modules;
\import Modules.Zero[] \as Zero;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := IntegerRing.ring] \as Cochains;
\definition firstDegree: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition secondDegree: N.Nat^ := N.Nat^::succ firstDegree;
\module Over(zeroth, first, second: Modules.Bundle);
