\use std.Logic[].Equality[].eq_reason_in;
\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as NaturalLaws;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition vertices: N.Nat^ := Nat.add forestEdges components;
\definition edges: N.Nat^ := Nat.add forestEdges chords;
\definition euler: Nat.add edges components = Nat.add vertices chords :=
  eq_reason_in!{N.Nat^ _
    "=" _ "by" { NaturalLaws.addAssoc forestEdges chords components }
    "=" _ "by" { congr!{N.Nat^ N.Nat^} (Nat.add forestEdges) _ _ (NaturalLaws.addComm chords components) }
    "=" _ "by" { sym!{N.Nat^} _ _ (NaturalLaws.addAssoc forestEdges components chords) }
  };
\definition cycleRank: Nat.sub (Nat.add edges components) vertices = chords :=
  eq_reason_in!{N.Nat^ _
    "=" _ "by" { congr!{N.Nat^ N.Nat^} (\fun (n: N.Nat^) => Nat.sub n vertices) _ _ euler }
    "=" _ "by" { congr!{N.Nat^ N.Nat^} (\fun (n: N.Nat^) => Nat.sub n vertices) _ _ (NaturalLaws.addComm vertices chords) }
    "=" _ "by" { NaturalLaws.subAddCancel vertices chords }
  };
