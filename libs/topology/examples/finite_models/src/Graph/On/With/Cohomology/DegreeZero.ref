\import Modules.Hom[V := H0.CycleCarrier, W := Components.Carrier, source := H0.cycleSpace, target := Components.space] \as Cycles;
\definition evaluate: Cycles.Map := Cycles.Map {
  apply := \fun (x: H0.CycleCarrier) => evaluateRoot x,
  addition := \fun (x, y: H0.CycleCarrier) => \refl(Components.add (evaluateRoot x) (evaluateRoot y)),
  scalar := \fun (a: I.Int^)(x: H0.CycleCarrier) => \refl(Components.scale a (evaluateRoot x)),
};
\import Modules.Of[V := H0.CycleCarrier, space := H0.cycleSpace].Submodule[].Quotient[S := H0.boundariesInside] \as Quotient;
\import Quotient.To[W := Components.Carrier, target := Components.space] \as Descent;
\definition kills: Descent.Vanishes evaluate := \fun (x: H0.CycleCarrier)(boundary: _) =>
  Components.ext (evaluateRoot x) Components.zero (\fun (i: Fin.Fin components) =>
    congr!{Vertices.Carrier A.Carrier} (\fun (f: Vertices.Carrier) => f (root i)) _ _ boundary);
\definition forward: Modules.Hom[V := H0.Cohomology, W := Components.Carrier, source := H0.cohomologySpace, target := Components.space].Map := Descent.descend evaluate kills;
\import Modules.Hom[V := Components.Carrier, W := H0.CycleCarrier, source := Components.space, target := H0.cycleSpace] \as Inclusion;
\definition include: Inclusion.Map := Inclusion.Map {
  apply := \fun (f: Components.Carrier) => H0.cycle (constant f) (constantClosed f),
  addition := \fun (f, g: Components.Carrier) => \refl(Vertices.add (constant f) (constant g)),
  scalar := \fun (a: I.Int^)(f: Components.Carrier) => \refl(Vertices.scale a (constant f)),
};
\import Modules.Hom[V := H0.CycleCarrier, W := H0.Cohomology, source := H0.cycleSpace, target := H0.cohomologySpace].Composition[U := Components.Carrier, domain := Components.space] \as Composition;
\definition backward: Modules.Hom[V := Components.Carrier, W := H0.Cohomology, source := Components.space, target := H0.cohomologySpace].Map := Composition.compose H0.classLinear include;
\definition leftInverse[f: Components.Carrier]: (forward).apply ((backward).apply f) = f :=
  trans!{Components.Carrier} _ _ _ (Descent.onClass evaluate kills ((include).apply f))
    (Components.ext _ _ (\fun (i: Fin.Fin components) => congr!{Walk A.Carrier} (\fun (w: Walk) => f (start w)) _ _ ((\bysub(Data, Object, graph)).root i)));
\definition closedConstant[f: H0.CycleCarrier]: constant (evaluateRoot f) = f := \block {
  \let closed: delta f = Edges.zero := \bysub(Vertices.Carrier, (H0.cycles).carrier, f) \then
  \let zero: potential (delta f) = Vertices.zero := trans!{Vertices.Carrier} _ _ _
    (congr!{Edges.Carrier Vertices.Carrier} potential _ _ closed)
    (Modules.Hom[V := Edges.Carrier, W := Vertices.Carrier, source := Edges.space, target := Vertices.space].zeroPreserved primitive) \then
  \return Vertices.ext _ _ (\fun (v: Vertex) => sym!{A.Carrier} _ _
    (Group.cancelRight (Group.neg (constant (evaluateRoot f) v)) (f v) (constant (evaluateRoot f) v)
      (trans!{A.Carrier} _ _ _
        (congr!{Vertices.Carrier A.Carrier} (\fun (x: Vertices.Carrier) => x v) _ _
          (trans!{Vertices.Carrier} _ _ _ (sym!{Vertices.Carrier} _ _ (primitiveGradient f)) zero))
        (sym!{A.Carrier} _ _ (Group.inverseRight (constant (evaluateRoot f) v))))))
};
\definition rightInverse: \forall (h: H0.Cohomology) -> (backward).apply ((forward).apply h) = h :=
  H0.classInduction (\fun (h: H0.Cohomology) => (backward).apply ((forward).apply h) = h)
    (\fun (f: H0.CycleCarrier) => trans!{H0.Cohomology} _ _ _
      (congr!{Components.Carrier H0.Cohomology} ((backward).apply) _ _ (Descent.onClass evaluate kills f))
      (H0.equalClass ((include).apply (evaluateRoot f)) f (closedConstant f)));
\definition isomorphism: Modules.Isomorphism[V := H0.Cohomology, W := Components.Carrier, source := H0.cohomologySpace, target := Components.space].Isomorphism :=
  Modules.Isomorphism[V := H0.Cohomology, W := Components.Carrier, source := H0.cohomologySpace, target := Components.space].Isomorphism {
    forward := forward, backward := backward, leftInverse := rightInverse, rightInverse := leftInverse,
  };
