\definition degree: N.Nat^ := N.Nat^::succ (N.Nat^::succ n);
\import Cochains.At[C := Native.complex, k := degree] \as Cohomology;
\definition law: \forall (h: Cohomology.Cohomology) -> h = Cohomology.zeroClass :=
  Cohomology.classInduction (\fun (h: Cohomology.Cohomology) => h = Cohomology.zeroClass)
    (\fun (f: Cohomology.CycleCarrier) => Cohomology.equalClass f (Cohomology.cycleSpace).zero (Native.Higher[n := n].vanishes f));
