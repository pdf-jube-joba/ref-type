\import std.Data[].FinSet[] \as Fin;
\import Modules.FiniteCoordinates[n := one] \as Coordinates;
\import Modules.Hom[V := Coordinates.Carrier, W := I.Int^, source := Coordinates.space, target := Modules.scalarModule] \as Evaluation;
\definition evaluate[v: Coordinates.Carrier]: I.Int^ := v (Fin.zero zero);
\definition evaluation: Evaluation.Map := Coordinates.evaluation (Fin.zero zero);
\import Modules.Hom[V := I.Int^, W := Coordinates.Carrier, source := Modules.scalarModule, target := Coordinates.space] \as Constants;
\definition constant[a: I.Int^]: Coordinates.Carrier := \fun (i: Coordinates.Index) => a;
\definition constants: Constants.Map := Constants.Map {
  apply := constant,
  addition := \fun (a, b: I.Int^) => \refl(constant ((Integers.ring).add a b)),
  scalar := \fun (a, b: I.Int^) => \refl(constant ((Integers.ring).mul a b)),
};
\definition leftInverse[v: Coordinates.Carrier]: constant (evaluate v) = v :=
  \axiom:funext(constant (evaluate v), v, \fun (i: Coordinates.Index) =>
    congr!{Coordinates.Index I.Int^} v _ _ (sym!{Coordinates.Index} _ _ (Fin.singletonValue i)));
\definition isomorphism: Modules.Isomorphism[V := Coordinates.Carrier, W := I.Int^, source := Coordinates.space, target := Modules.scalarModule].Isomorphism :=
  Modules.Isomorphism[V := Coordinates.Carrier, W := I.Int^, source := Coordinates.space, target := Modules.scalarModule].Isomorphism {
    forward := evaluation, backward := constants, leftInverse := leftInverse, rightInverse := \fun (a: I.Int^) => \refl(a),
  };

\import Modules.Coordinates[I := Coordinates.Index].Kronecker[] \as Delta;
\definition oneAsBasis: constant I.One.specification = Coordinates.basis (Fin.zero zero) :=
  \axiom:funext(constant I.One.specification, Coordinates.basis (Fin.zero zero), \fun (i: Coordinates.Index) =>
    sym!{I.Int^} _ _ (Delta.equal i (Fin.zero zero) (Fin.singletonValue i)));
\module Tensor;
