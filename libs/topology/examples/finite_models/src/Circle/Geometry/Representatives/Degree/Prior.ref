\import \root.Circle[].Geometry[].Representatives[pointCycle := pointCycle, orientationCycle := orientationCycle].Degree[z := Bounded.previous z] \as PreviousDegree;
\import Modules.Hom[V := Vector (Bounded.previous z), W := ExtendedSingular.complex.family.Carrier (Bounded.previous z),
  source := vectorSpace (Bounded.previous z), target := ExtendedSingular.complex.family.space (Bounded.previous z)] \as Maps;
\definition zero[v: Vector z]: (PreviousDegree.map).apply (differential z v) = (ExtendedSingular.complex.family.space (Bounded.previous z)).zero :=
  trans!{{ExtendedSingular.complex.family.Carrier (Bounded.previous z)}} _ _ _
    (congr!{{Vector (Bounded.previous z)} {ExtendedSingular.complex.family.Carrier (Bounded.previous z)}} ((PreviousDegree.map).apply) _ _ (zeroAction z v))
    (Maps.zeroPreserved PreviousDegree.map);
