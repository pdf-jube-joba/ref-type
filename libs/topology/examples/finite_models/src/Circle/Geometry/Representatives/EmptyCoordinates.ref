\import std.Data[].FinSet[] \as Fin;
\import Modules.FiniteCoordinates[n := zero] \as Empty;
\definition zero[v: Empty.Carrier]: v = (Empty.space).zero :=
  \axiom:funext(v, (Empty.space).zero, \fun (i: Empty.Index) => Logic.falseElim (v i = (Integers.ring).zero) (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i)));
