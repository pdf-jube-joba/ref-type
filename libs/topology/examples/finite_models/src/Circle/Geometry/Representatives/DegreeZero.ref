\use std.Logic[].Equality[].eq_reason_in;
\import std.Data[].FinSet[] \as Fin;
\definition degree: I.Int^ := I.Int^::ofNat zero;
\import SignedChains.At[C := chain, z := degree] \as Source;
\import SignedChains.At[C := ExtendedSingular.complex, z := degree] \as Target;
\import \root.Circle[].Homology[].Degree[z := degree] \as Coordinates;
\import \root.Circle[].Homology[].Unit[] \as Unit;
\import Modules.Isomorphism[V := Source.Homology, W := Vector degree, source := Source.homologySpace, target := vectorSpace degree]
  .Composition[U := I.Int^, final := Modules.scalarModule] \as ToInteger;
\definition integerCoordinates: Modules.Isomorphism[V := Source.Homology, W := I.Int^, source := Source.homologySpace, target := Modules.scalarModule].Isomorphism :=
  ToInteger.compose Unit.isomorphism Coordinates.coordinates;
\import Maps.At[k := degree] \as Actual;
\import \parent.Degree[z := degree] \as DegreeMap;
\import Modules.FiniteCoordinates[n := one] \as Vectors;
\definition finiteCycle: Source.Cycle := Source.cycle (Unit.constant I.One.specification) (zeroAction degree (Unit.constant I.One.specification));
\definition finiteClass: Source.Homology := Source.classOf finiteCycle;
\definition coordinateOne: ((integerCoordinates).forward).apply finiteClass = I.One.specification :=
  congr!{{Vector degree} I.Int^} Unit.evaluate _ _ (Coordinates.onClass finiteCycle);
\definition inverseOne: ((integerCoordinates).backward).apply I.One.specification = finiteClass :=
  trans!{Source.Homology} _ _ _
    (congr!{I.Int^ Source.Homology} (((integerCoordinates).backward).apply) _ _ (sym!{I.Int^} _ _ coordinateOne))
    ((integerCoordinates).leftInverse finiteClass);
\definition onFiniteClass: (Actual.induced comparison).apply finiteClass = pointClass :=
  eq_reason_in!{Target.Homology _
    "=" _ "by" { Actual.onClass comparison finiteCycle }
    "=" _ "by" { Target.cycleClassExt ((Actual.cyclesMap comparison).apply finiteCycle) pointCycle
        (trans!{{ExtendedSingular.complex.family.Carrier degree}} _ _ _
          (congr!{{Vector degree} {ExtendedSingular.complex.family.Carrier degree}} ((DegreeMap.map).apply) _ _ Unit.oneAsBasis)
          (DegreeMap.onBasis (Fin.zero zero))) }
    "=" _ "by" represents
  };
\import Modules.Hom[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace]
  .Composition[U := I.Int^, domain := Modules.scalarModule] \as FromInteger;
\definition actualInteger: Modules.Hom[V := I.Int^, W := Target.Homology, source := Modules.scalarModule, target := Target.homologySpace].Map :=
  FromInteger.compose (Actual.induced comparison) (integerCoordinates).backward;
\definition actualOne: (actualInteger).apply I.One.specification = pointClass :=
  trans!{Target.Homology} _ _ _ (congr!{Source.Homology Target.Homology} ((Actual.induced comparison).apply) _ _ inverseOne) onFiniteClass;
\definition targetBundle: Modules.Bundle := Modules.Bundle { Carrier := Target.Homology, space := Target.homologySpace };
\import \root.Integral[].Generator[B := targetBundle] \as Generator;
\definition integerEquality: actualInteger = (pointIsomorphism).forward := Generator.equal actualInteger (pointIsomorphism).forward actualOne;
\import Modules.Isomorphism[V := Source.Homology, W := I.Int^, source := Source.homologySpace, target := Modules.scalarModule]
  .Composition[U := Target.Homology, final := Target.homologySpace] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Source.Homology, W := Target.Homology, source := Source.homologySpace, target := Target.homologySpace].Isomorphism :=
  Composition.compose pointIsomorphism integerCoordinates;
\definition law[h: Source.Homology]: (Actual.induced comparison).apply h = ((isomorphism).forward).apply h :=
  trans!{Target.Homology} _ _ _
    (congr!{Source.Homology Target.Homology} ((Actual.induced comparison).apply) _ _ (sym!{Source.Homology} _ _ ((integerCoordinates).leftInverse h)))
    (congr!{Modules.Hom[V := I.Int^, W := Target.Homology, source := Modules.scalarModule, target := Target.homologySpace].Map Target.Homology}
      (\fun (f: Modules.Hom[V := I.Int^, W := Target.Homology, source := Modules.scalarModule, target := Target.homologySpace].Map) => (f).apply (((integerCoordinates).forward).apply h)) _ _ integerEquality);
\definition bijective: Actual.Bijective[comparison] := Actual.Bijective[comparison] {
  injective := \fun (h, k: Source.Homology)(equal: (Actual.induced comparison).apply h = (Actual.induced comparison).apply k) =>
    eq_reason_in!{Source.Homology _
      "=" _ "by" { sym!{Source.Homology} _ _ ((isomorphism).leftInverse h) }
      "=" _ "by" { congr!{Target.Homology Source.Homology} (((isomorphism).backward).apply) _ _
          (eq_reason_in!{Target.Homology _
            "=" _ "by" { sym!{Target.Homology} _ _ (law h) }
            "=" _ "by" equal
            "=" _ "by" { law k }
          }) }
      "=" _ "by" { (isomorphism).leftInverse k }
    },
  onto := \fun (h: Target.Homology) => Logic.existsIntro[Source.Homology, { k: Source.Homology \where (Actual.induced comparison).apply k = h }]
    (((isomorphism).backward).apply h)
    (trans!{Target.Homology} _ _ _ (law (((isomorphism).backward).apply h)) ((isomorphism).rightInverse h)),
};
