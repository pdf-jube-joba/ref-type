\use std.Logic[].Equality[].eq_reason_in;
\import Modules.FiniteCoordinates[n := one] \as Coordinates;
\import \root.Circle[].Homology[].Unit[] \as Unit;
\definition index: Coordinates.Index := Fin.zero zero;
\definition basis: Coordinates.Carrier := Coordinates.basis index;
\definition decomposition[v: Coordinates.Carrier]: (Coordinates.space).smul (Unit.evaluate v) basis = v :=
  eq_reason_in!{Coordinates.Carrier _
    "=" _ "by" { congr!{Coordinates.Carrier Coordinates.Carrier} ((Coordinates.space).smul (Unit.evaluate v)) _ _ (sym!{Coordinates.Carrier} _ _ Unit.oneAsBasis) }
    "=" _ "by" { \axiom:funext((Coordinates.space).smul (Unit.evaluate v) (Unit.constant I.One.specification), Unit.constant (Unit.evaluate v),
        \fun (i: Coordinates.Index) => (((Integers.ring).semiring).multiplicative).rightIdentity (Unit.evaluate v)) }
    "=" _ "by" { Unit.leftInverse v }
  };
\import Modules.Hom[V := Coordinates.Carrier, W := coefficients.Carrier, source := Coordinates.space, target := coefficients.space] \as Functionals;
\import Modules.Hom[V := FiniteCochains.Carrier one, W := coefficients.Carrier, source := FiniteCochains.space one, target := coefficients.space] \as Forward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (h: FiniteCochains.Carrier one) => (h).apply basis,
  addition := \fun (h, g: FiniteCochains.Carrier one) => \refl((coefficients.space).add ((h).apply basis) ((g).apply basis)),
  scalar := \fun (a: I.Int^)(h: FiniteCochains.Carrier one) => \refl((coefficients.space).smul a ((h).apply basis)),
};
\definition functional[m: coefficients.Carrier]: FiniteCochains.Carrier one := Functionals.Map {
  apply := \fun (v: Coordinates.Carrier) => (coefficients.space).smul (Unit.evaluate v) m,
  addition := \fun (v, w: Coordinates.Carrier) => (coefficients.space).scalarAdd (Unit.evaluate v) (Unit.evaluate w) m,
  scalar := \fun (a: I.Int^)(v: Coordinates.Carrier) => (coefficients.space).scalarAssoc a (Unit.evaluate v) m,
};
\import Modules.Hom[V := coefficients.Carrier, W := FiniteCochains.Carrier one, source := coefficients.space, target := FiniteCochains.space one] \as Backward;
\import Modules.Laws[V := coefficients.Carrier, space := coefficients.space] \as Values;
\import std.Alg[].Ring[] \as Rings;
\definition backward: Backward.Map := Backward.Map {
  apply := functional,
  addition := \fun (m, n: coefficients.Carrier) => Functionals.ext
    (functional ((coefficients.space).add m n)) ((FiniteCochains.space one).add (functional m) (functional n))
    (\fun (v: Coordinates.Carrier) => (coefficients.space).vectorAdd (Unit.evaluate v) m n),
  scalar := \fun (a: I.Int^)(m: coefficients.Carrier) => Functionals.ext
    (functional ((coefficients.space).smul a m)) ((FiniteCochains.space one).smul a (functional m))
    (\fun (v: Coordinates.Carrier) => eq_reason_in!{coefficients.Carrier _
      "=" _ "by" { sym!{coefficients.Carrier} _ _ ((coefficients.space).scalarAssoc (Unit.evaluate v) a m) }
      "=" _ "by" { congr!{I.Int^ coefficients.Carrier} (\fun (r: I.Int^) => (coefficients.space).smul r m) _ _ ((Integers.commutativeRing).mulCommutative (Unit.evaluate v) a) }
      "=" _ "by" { (coefficients.space).scalarAssoc a (Unit.evaluate v) m }
    }),
};
\definition leftInverse: \forall (h: FiniteCochains.Carrier one) -> (backward).apply ((forward).apply h) = h :=
  \fun (h: FiniteCochains.Carrier one) => Functionals.ext (functional ((h).apply basis)) h
    (\fun (v: Coordinates.Carrier) => trans!{coefficients.Carrier} _ _ _
      (sym!{coefficients.Carrier} _ _ ((h).scalar (Unit.evaluate v) basis))
      (congr!{Coordinates.Carrier coefficients.Carrier} ((h).apply) _ _ (decomposition v)));
\definition rightInverse: \forall (m: coefficients.Carrier) -> (forward).apply ((backward).apply m) = m :=
  \fun (m: coefficients.Carrier) => trans!{coefficients.Carrier} _ _ _
    (congr!{I.Int^ coefficients.Carrier} (\fun (a: I.Int^) => (coefficients.space).smul a m) _ _
      (sym!{I.Int^} _ _ (congr!{Coordinates.Carrier I.Int^} Unit.evaluate _ _ Unit.oneAsBasis)))
    ((coefficients.space).scalarOne m);
\definition isomorphism: Modules.Isomorphism[V := FiniteCochains.Carrier one, W := coefficients.Carrier,
  source := FiniteCochains.space one, target := coefficients.space].Isomorphism :=
  Modules.Isomorphism[V := FiniteCochains.Carrier one, W := coefficients.Carrier,
    source := FiniteCochains.space one, target := coefficients.space].Isomorphism {
    forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
  };
