\import sphere_maps.ZeroHomology[].Sphere[] \as Primitive;
\import algebraic_topology.Spheres[] \as Spheres;
\definition Sphere: \Set := Spheres.Carrier zero;
\definition topology: topology.Topology[Carrier := Sphere].Topology := Spheres.topology zero;
\import singular_cohomology.Chains[A := Sphere, source := topology] \as Chains;
\import Chains.Reduced[] \as Reduced;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Signed;
\import Signed.At[C := Reduced.complex, z := I.Int^::ofNat zero] \as H;
\definition difference: Chains.Carrier zero := Primitive.difference;
\definition cycle: H.Cycle := Primitive.cycle;
\definition generator: H.Homology := Primitive.generator;
\definition functional: Modules.Hom[V := H.Homology, W := I.Int^, source := H.homologySpace, target := Modules.scalarModule].Map := Primitive.functional;
\definition normalized: (functional).apply generator = I.One.specification := Primitive.normalized;
\definition isomorphism: Modules.Isomorphism[V := I.Int^, W := H.Homology, source := Modules.scalarModule, target := H.homologySpace].Isomorphism := Primitive.isomorphism;
\definition onOne: ((isomorphism).forward).apply I.One.specification = generator := Primitive.onOne;
