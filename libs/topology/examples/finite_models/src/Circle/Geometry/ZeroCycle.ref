\import SignedChains.At[C := ExtendedSingular.complex, z := z] \as H;
\import Modules.Hom[V := ExtendedSingular.complex.family.Carrier z, W := ExtendedSingular.complex.family.Carrier (Bounded.previous z),
  source := ExtendedSingular.complex.family.space z, target := ExtendedSingular.complex.family.space (Bounded.previous z)] \as Maps;
\definition value: H.Cycle := H.cycle (ExtendedSingular.complex.family.space z).zero (Maps.zeroPreserved H.differential);
