\import singular_low_degree.Product[A := Circle, B := Circle, left := circleTopology, right := circleTopology,
  leftPoint := Geometry.point, rightPoint := Geometry.point].With[leftPaths := paths, rightPaths := paths]
  .Coefficients[coefficients := Products.integerCoefficients] \as Axes;
\definition law[q: NativeCarrier]: (nativeForward).apply ((nativeBackward).apply q) = q :=
  Axes.detectsEqual _ _
    (trans!{{CircleCohomology.Group one}} _ _ _ (firstEvaluation ((nativeBackward).apply q))
      ((CircleTop.isomorphism).rightInverse ((Pullbacks.firstRestriction).apply q)))
    (trans!{{CircleCohomology.Group one}} _ _ _ (secondEvaluation ((nativeBackward).apply q))
      ((CircleTop.isomorphism).rightInverse ((Pullbacks.secondRestriction).apply q)));
