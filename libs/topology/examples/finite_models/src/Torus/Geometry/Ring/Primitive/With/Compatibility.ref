\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Factor[] \as Factor;
\import \parent.Target[] \as Target;
\import TensorDual.Selected[P := nativeFiniteCircle, Q := nativeFiniteCircle, p := one, q := one] \as FinitePairing;
\import TensorDual.Selected[P := nativeSingularCircle, Q := nativeSingularCircle, p := one, q := one] \as SingularPairing;
\import FinitePairing.Mapping[C := nativeSingularCircle, D := nativeSingularCircle].With[f := (CircleComparison.equivalence).backward, g := (CircleComparison.equivalence).backward] \as Natural;
\import Coefficients.Singular[A := Circle, source := circleTopology, p := one, q := one] \as Bridge;
\import singular_symmetry.Cochains[A := Circle, source := circleTopology, R := I.Int^, ring := Integers.commutativeRing] \as Symmetry;
\import Symmetry.ExternalCup[p := one, q := one] \as External;
\import Symmetry.Pairing[p := one, q := one] \as OrdinaryPairing;
\import singular_products.AlexanderWhitney[A := Circle, B := Circle, left := circleTopology, right := circleTopology].Total[] \as AW;
\import Doubles.Tensor[C := SingularCircle.complex, D := SingularCircle.complex] \as SingularTensor;
\import Doubles.Total[C := SingularTensor.complex] \as SingularTotal;
\definition factor[phi: Finite.CircleCochain]: Bridge.native one (Factor.cycle phi) = Natural.left phi :=
  StandardCircle.At[n := one].ext (Bridge.native one (Factor.cycle phi)) (Natural.left phi)
    (\fun (x: SingularCircle.Carrier one) => \refl((phi).apply (((CircleComparison.equivalence).backward).apply one x)));
\definition natural[alpha, beta: Finite.CircleCochain][z: SingularTotal.Carrier two]:
  (Finite.pairing alpha beta).apply ((Natural.totalMap).apply two z) = (OrdinaryPairing.total (Factor.cycle alpha) (Factor.cycle beta)).apply z :=
  eq_reason_in!{I.Int^ _
    "=" _ "by" { sym!{I.Int^} _ _ (Natural.law alpha beta z) }
    "=" _ "by" { congr!{{StandardCircle.Carrier one} {StandardCircle.Carrier one} I.Int^}
        (\fun (f, g: StandardCircle.Carrier one) => (SingularPairing.total f g).apply z) _ _ _ _
        (sym!{{StandardCircle.Carrier one}} _ _ (factor alpha)) (sym!{{StandardCircle.Carrier one}} _ _ (factor beta)) }
    "=" _ "by" { Bridge.law (Factor.cycle alpha) (Factor.cycle beta) z }
  };
\module At(alpha, beta: Finite.CircleCochain) {
  \import External.Classes[alpha := Factor.cycle alpha, beta := Factor.cycle beta] \as CupCycle;
  \definition point[x: SingularTorus.Carrier two]:
    (Target.cycle (Finite.cycle alpha beta)).apply x = (CupCycle.cycle).apply x :=
    trans!{I.Int^} _ _ _ (natural alpha beta ((AW.map).apply two x))
      (CupCycle.evaluation x);
  \definition representatives: OriginalTorusH.ambient (Target.cycle (Finite.cycle alpha beta)) = OriginalTorusH.ambient CupCycle.cycle :=
    OriginalTorus.At[n := two].ext (Target.cycle (Finite.cycle alpha beta)) CupCycle.cycle point;
  \definition cross[h, k: CircleCohomology.Group one]: Cohomology.Group two := Cup.apply
    (Projection.apply one first firstContinuous h) (Projection.apply one second secondContinuous k);
  \definition law:
    ((Target.isomorphism).forward).apply (FiniteTorusH.classOf (Finite.cycle alpha beta)) =
      cross (((Factor.isomorphism).forward).apply alpha) (((Factor.isomorphism).forward).apply beta) :=
    eq_reason_in!{{Cohomology.Group two} _
      "=" _ "by" { Target.onClass (Finite.cycle alpha beta) }
      "=" _ "by" { OriginalTorusH.equalClass (Target.cycle (Finite.cycle alpha beta)) CupCycle.cycle representatives }
      "=" _ "by" { sym!{{Cohomology.Group two}} _ _ CupCycle.onClasses }
      "=" _ "by" { congr!{{CircleCohomology.Group one} {CircleCohomology.Group one} {Cohomology.Group two}} cross _ _ _ _
            (sym!{{CircleCohomology.Group one}} _ _ (Factor.onCycle alpha))
            (sym!{{CircleCohomology.Group one}} _ _ (Factor.onCycle beta)) }
    };
}
