\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\import Modules.Zero[] \as Zero;
\import \root.Surface[V := Vertex, E := Edge, T := Triangle].On[surface := object].With[A := A] \as Raw;
\import \root.Truncated[].Over[zeroth := Raw.zeroth, first := Raw.first, second := Raw.second].On[deltaZero := Raw.differentialZero, deltaOne := Raw.differentialOne, square := Raw.squareZero] \as Complex;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := IntegerRing.ring] \as Cochains;
