\definition ambient: Modules.Bundle := zeroth;
\definition target: Modules.Bundle := first;
\definition differential: Modules.MapBetween ambient target := deltaZero;
\import Modules.Of[V := ambient.Carrier, space := ambient.space].Submodule[] \as AmbientSubmodules;
\definition boundaries: AmbientSubmodules.Submodule := AmbientSubmodules.zeroSubmodule;
\definition boundaryClosed: \forall (x: ambient.Carrier) -> AmbientSubmodules.Member boundaries x -> (differential).apply x = (target.space).zero :=
  \fun (x: ambient.Carrier)(zero: x = (ambient.space).zero) =>
    \idelim (ambient.space).zero = x \with z: ambient.Carrier => (differential).apply z = (target.space).zero \by {
      base: Modules.Hom[V := ambient.Carrier, W := target.Carrier, source := ambient.space, target := target.space].zeroPreserved differential,
      equality: sym!{ambient.Carrier} _ _ zero
    };
\import Modules.Of[V := ambient.Carrier, space := ambient.space] \as Current;
\import Current.Submodule[] \as Subspaces;
\import Modules.Hom[V := ambient.Carrier, W := target.Carrier, source := ambient.space, target := target.space] \as Maps;
\import Subspaces.Kernel[W := target.Carrier, target := target.space] \as Kernels;
\definition cycles: Subspaces.Submodule := Kernels.kernel differential;
\import Subspaces.Of[S := cycles] \as Cycles;
\import Subspaces.Inside[Z := cycles] \as Inside;
\import Modules.Submodule[V := Cycles.Carrier, space := Cycles.moduleSpace] \as CycleSubmodules;
\definition boundariesInside: CycleSubmodules.Submodule := Inside.inside boundaries boundaryClosed;
\import Modules.Of[V := Cycles.Carrier, space := Cycles.moduleSpace].Submodule[].Quotient[S := boundariesInside] \as Quotient;
\definition CycleCarrier: \Set := Cycles.Carrier;
\definition cycleSpace: Modules.Space CycleCarrier := Cycles.moduleSpace;
\definition Cohomology: \Set := Quotient.Carrier;
\definition cohomologySpace: Modules.Space Cohomology := Quotient.moduleSpace;
\definition Boundaries[n: N.Nat^]: \Pow ambient.Carrier := (boundaries).carrier;
\definition classOf[x: CycleCarrier]: Cohomology := Quotient.class x;
\definition cycle[x: ambient.Carrier][closed: (differential).apply x = (target.space).zero]: CycleCarrier :=
  \into[ambient.Carrier](x, (cycles).carrier) \by { closed };
\definition boundaryClassZero: \forall (x: CycleCarrier) -> Subspaces.Member boundaries x -> classOf x = Quotient.zeroClass := Quotient.classZero;
\definition zeroClassBoundary: \forall (x: CycleCarrier) -> classOf x = Quotient.zeroClass -> Subspaces.Member boundaries x := Quotient.zeroClassMember;
\definition zeroClass: Cohomology := Quotient.zeroClass;
\definition classEqual: \forall (x, y: CycleCarrier) -> Subspaces.Member boundaries ((ambient.space).add x ((ambient.space).neg y)) -> classOf x = classOf y := Quotient.classRelated;
\definition classInduction[P: Cohomology -> \Prop]: (\forall (x: CycleCarrier) -> P (classOf x)) -> \forall (h: Cohomology) -> P h := Quotient.induction P;
\definition classLinear: Modules.Hom[V := CycleCarrier, W := Cohomology, source := cycleSpace, target := cohomologySpace].Map := Quotient.projection;
\definition ambientValue[x: CycleCarrier]: ambient.Carrier := x;
\definition equalClass: \forall (x, y: CycleCarrier) -> ambientValue x = ambientValue y -> classOf x = classOf y :=
  \fun (x, y: CycleCarrier)(same: ambientValue x = ambientValue y) =>
    congr!{CycleCarrier Cohomology} classOf x y same;
\import Quotient.ZeroQuotient[] \as ZeroQuotient;
\definition isZero: ZeroQuotient.IsZero := \fun (x: CycleCarrier)(member: _) => member;
\import Modules.Isomorphism[V := CycleCarrier, W := Cohomology, source := cycleSpace, target := cohomologySpace] \as Iso;
\definition kernelIso: Iso.Isomorphism := Iso.Isomorphism {
  forward := classLinear, backward := ZeroQuotient.inverse isZero,
  leftInverse := ZeroQuotient.inverseClass isZero, rightInverse := ZeroQuotient.classInverse isZero,
};
