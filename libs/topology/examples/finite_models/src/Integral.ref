\use std.Logic[].Equality[].eq_reason_in;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\import module_theory.Module[].Over[R := I.Int^, ring := IntegerRing.ring] \as Modules;
\module Maps(A, B: Modules.Bundle) {
  \import Modules.Laws[V := A.Carrier, space := A.space] \as Source;
  \import Modules.Laws[V := B.Carrier, space := B.space] \as Target;
  \import algebra.Group[].Of[Carrier := A.Carrier, group := Source.additive] \as SourceGroup;
  \import algebra.Group[].Of[Carrier := B.Carrier, group := Target.additive] \as TargetGroup;
  \import algebra.Exact[A := A.Carrier, B := B.Carrier].Groups[source := Source.additive, target := Target.additive] \as Groups;
  \import algebra.Hom[A := A.Carrier, B := B.Carrier] \as GroupMaps;
  \import module_theory.Module[].IntegerGroup[Carrier := B.Carrier, group := Target.additive] \as Integers;
  \import algebra.Hom[A := I.Int^, B := B.Carrier] \as ScalarMaps;
  \import Modules.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space] \as Linear;
  \module On(f: Groups.Map) {
    \module At(x: A.Carrier) {
      \definition before: Integers.IntegerMap :=
        \into[I.Int^ -> B.Carrier](\fun (a: I.Int^) => f ((A.space).smul a x), Integers.IntegerMap) \by {
          ScalarMaps.MonoidLaws[Integers.integerDomain, Integers.target, \fun (a: I.Int^) => f ((A.space).smul a x)] {
            unit := trans!{B.Carrier} _ _ _ (congr!{A.Carrier B.Carrier} f _ _ (Source.zeroScale x))
              ((GroupMaps.monoidLaws Groups.domain Groups.codomain f).unit),
            operation := \fun (a, b: I.Int^) => trans!{B.Carrier} _ _ _
              (congr!{A.Carrier B.Carrier} f _ _ ((A.space).scalarAdd a b x))
              ((GroupMaps.monoidLaws Groups.domain Groups.codomain f).operation ((A.space).smul a x) ((A.space).smul b x)),
          }
        };
      \definition after: Integers.IntegerMap :=
        \into[I.Int^ -> B.Carrier](\fun (a: I.Int^) => (B.space).smul a (f x), Integers.IntegerMap) \by {
          ScalarMaps.MonoidLaws[Integers.integerDomain, Integers.target, \fun (a: I.Int^) => (B.space).smul a (f x)] {
            unit := Target.zeroScale (f x), operation := \fun (a, b: I.Int^) => (B.space).scalarAdd a b (f x),
          }
        };
      \definition same: before = after := Integers.generatorExt before after
        (trans!{B.Carrier} _ _ _ (congr!{A.Carrier B.Carrier} f _ _ ((A.space).scalarOne x))
          (sym!{B.Carrier} _ _ ((B.space).scalarOne (f x))));
      \definition law: \forall (a: I.Int^) -> f ((A.space).smul a x) = (B.space).smul a (f x) :=
        \fun (a: I.Int^) => congr!{{I.Int^ -> B.Carrier} B.Carrier} (\fun (g: I.Int^ -> B.Carrier) => g a) _ _ same;
    }
    \definition linear: Linear.Map := Linear.Map {
      apply := f,
      addition := (GroupMaps.monoidLaws Groups.domain Groups.codomain f).operation,
      scalar := \fun (a: I.Int^)(x: A.Carrier) => At[x := x].law a,
    };
  }
  \definition fromGroup[f: Groups.Map]: Linear.Map := On[f := f].linear;
  \definition zeroOfAdditive[f: A.Carrier -> B.Carrier]
    [addition: \forall (x, y: A.Carrier) -> f ((A.space).add x y) = (B.space).add (f x) (f y)]:
    f ((A.space).zero) = (B.space).zero :=
    TargetGroup.cancelLeft (f ((A.space).zero)) (f ((A.space).zero)) ((B.space).zero)
      (eq_reason_in!{B.Carrier _
        "=" _ "by" { sym!{B.Carrier} _ _ (addition ((A.space).zero) ((A.space).zero)) }
        "=" _ "by" { congr!{A.Carrier B.Carrier} f _ _ (SourceGroup.zeroLeft ((A.space).zero)) }
        "=" _ "by" { sym!{B.Carrier} _ _ (TargetGroup.zeroRight (f ((A.space).zero))) }
      });
  \definition fromAdditive[f: A.Carrier -> B.Carrier]
    [addition: \forall (x, y: A.Carrier) -> f ((A.space).add x y) = (B.space).add (f x) (f y)]: Linear.Map :=
    fromGroup (\into[A.Carrier -> B.Carrier](f, Groups.Map) \by {
      GroupMaps.MonoidLaws[Groups.domain, Groups.codomain, f] {
        unit := zeroOfAdditive f addition, operation := addition,
      }
    });

}

\module Generator(B: Modules.Bundle) {
  \import Modules.Hom[V := I.Int^, W := B.Carrier, source := Modules.scalarModule, target := B.space] \as Maps;
  \import I.Math[].Specification[].Prop[].Multiplication[] \as Product;
  \definition value[f: Maps.Map][a: I.Int^]: (f).apply a = (B.space).smul a ((f).apply I.One.specification) :=
    trans!{B.Carrier} _ _ _ (congr!{I.Int^ B.Carrier} ((f).apply) _ _ (sym!{I.Int^} _ _ (Product.mulOneRight a)))
      ((f).scalar a I.One.specification);
  \definition equal[f, g: Maps.Map][one: (f).apply I.One.specification = (g).apply I.One.specification]: f = g :=
    Maps.ext f g (\fun (a: I.Int^) => eq_reason_in!{B.Carrier _
      "=" _ "by" { value f a }
      "=" _ "by" { congr!{B.Carrier B.Carrier} ((B.space).smul a) _ _ one }
      "=" _ "by" { sym!{B.Carrier} _ _ (value g a) }
    });
}
