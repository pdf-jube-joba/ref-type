\use std.Logic[].Equality[].eq_reason_in;
\import RestrictedQuotient.Descent[C := Carrier] \as Forward;
\definition originalClass[x: Point]: Carrier := class x;
\definition forwardRespects: Forward.Respects originalClass :=
  \fun (x, y: Point)(related: Restricted x y) => Quotient.relatedEqual laws x y related;
\definition forward: QuotientPoint -> Carrier := Forward.apply restrictedLaws originalClass forwardRespects;
\definition forwardOnPoint[x: Point]: forward (RestrictedQuotient.class x) = class x :=
  Forward.onClass restrictedLaws originalClass forwardRespects x;
\import Quotient.Descent[C := QuotientPoint] \as Backward;
\definition backward: Carrier -> QuotientPoint := Backward.apply laws fold relatedFold;
\definition backwardOnClass[x: A]: backward (class x) = fold x := Backward.onClass laws fold relatedFold x;
\definition leftOnPoint[x: Point]: backward (forward (RestrictedQuotient.class x)) = RestrictedQuotient.class x :=
  eq_reason_in!{QuotientPoint _
    "=" _ "by" { congr!{Carrier QuotientPoint} backward _ _ (forwardOnPoint x) }
    "=" _ "by" { backwardOnClass x }
    "=" _ "by" { onPoint x }
  };
\definition leftInverse: \forall (q: QuotientPoint) -> backward (forward q) = q := RestrictedQuotient.induction
  (\fun (q: QuotientPoint) => backward (forward q) = q) leftOnPoint;
\definition foldProjects[x: A]: forward (fold x) = class x := \block {
  \takefrom y: \Cast[Point] ({ y: Point \where Logic.And[Equivalent x y, RestrictedQuotient.class y = fold x] })
    \by \bysub(QuotientPoint, Values x, selected x) \then
  \let yp: Logic.And[Equivalent x y, RestrictedQuotient.class y = fold x] :=
    \bysub(Point, { y: Point \where Logic.And[Equivalent x y, RestrictedQuotient.class y = fold x] }, y) \then
  \return eq_reason_in!{Carrier _
    "=" _ "by" { congr!{QuotientPoint Carrier} forward _ _ (sym!{QuotientPoint} _ _ ((yp).right)) }
    "=" _ "by" { forwardOnPoint y }
    "=" _ "by" { Quotient.relatedEqual laws y x (symmetric x y ((yp).left)) }
  }
};
\definition rightInverse: \forall (q: Carrier) -> forward (backward q) = q := Quotient.induction
  (\fun (q: Carrier) => forward (backward q) = q)
  (\fun (x: A) => trans!{Carrier} _ _ _ (congr!{QuotientPoint Carrier} forward _ _ (backwardOnClass x)) (foldProjects x));
\import topology.Continuity[A := A, B := A].Corestriction[S := F] \as Inclusion;
\import topology.Composition[A := Point, B := A, C := Carrier] \as ProjectionComposition;
\definition forwardContinuous: topology.Continuity[A := QuotientPoint, B := Carrier].Continuous quotientTopology topology forward :=
  Forward.continuous pointTopology topology restrictedLaws originalClass forwardRespects
    (ProjectionComposition.composeContinuous pointTopology source topology (\fun (x: Point) => x) class
      (Inclusion.inclusionContinuous source) continuous);
\definition backwardContinuous: topology.Continuity[A := Carrier, B := QuotientPoint].Continuous topology quotientTopology backward :=
  Backward.continuous source quotientTopology laws fold relatedFold \parent.Continuity[].continuous;
\import topology.Homeomorphism[A := QuotientPoint, B := Carrier] \as Homeomorphisms;
\definition homeomorphism: Homeomorphisms.Homeomorphism[quotientTopology, topology] := Homeomorphisms.Homeomorphism[quotientTopology, topology] {
  forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
  forwardContinuous := forwardContinuous, backwardContinuous := backwardContinuous,
};
