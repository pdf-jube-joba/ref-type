\definition index: N.Nat^ := N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n));
\import Cochains.At[C := Native.complex, k := index] \as Source;
\import Modules.Free[Generators := Carrier index].To[W := A.Carrier, target := A.space] \as Free;
\definition cochainZero[phi: Native.Carrier index]: phi = (Native.space index).zero :=
  Free.ext phi (Native.space index).zero (\fun (sigma: Carrier index) => Logic.falseElim
    ((phi).apply (Chains.generator index sigma) = (A.space).zero)
    (higherEmpty n sigma (\bysub(Base, { tau: Base \where degree tau = index }, sigma))));
\definition vanishes: \forall (h: Source.Cohomology) -> h = Source.zeroClass :=
  Source.classInduction (\fun (h: Source.Cohomology) => h = Source.zeroClass)
    (\fun (phi: Source.CycleCarrier) => Source.equalClass phi (Source.cycleSpace).zero (cochainZero phi));
