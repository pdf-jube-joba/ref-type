\use std.Logic[].Equality[].eq_reason_in;
\import \root.Surface[V := V, E := E, T := T].On[surface := surface].Simplicial[].Coefficients[A := A].DegreeZero[] \as From;
\import \root.Surface[V := V, E := E, T := T].On[surface := surface].Simplicial[].Coefficients[A := B].DegreeZero[] \as To;
\definition pointwise[f: From.FunctionCarrier]: To.FunctionCarrier := \fun (x: From.Labels) => (u).apply (f x);
\definition evaluate[phi: Source.Carrier N.Nat^::zero]: To.evaluate ((map).apply N.Nat^::zero phi) = pointwise (From.evaluate phi) :=
  \refl(pointwise (From.evaluate phi));
\definition extend[f: From.FunctionCarrier]: (map).apply N.Nat^::zero (From.extend f) = To.extend (pointwise f) :=
  To.injective ((map).apply N.Nat^::zero (From.extend f)) (To.extend (pointwise f))
    (eq_reason_in!{To.FunctionCarrier _
      "=" _ "by" { evaluate (From.extend f) }
      "=" _ "by" { congr!{From.FunctionCarrier To.FunctionCarrier} pointwise _ _ (From.rightInverse f) }
      "=" _ "by" { sym!{To.FunctionCarrier} _ _ (To.rightInverse (pointwise f)) }
    });
