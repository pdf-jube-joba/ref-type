\definition inclusion: Cochains.Map[C := Left.complex, D := Middle.complex].Map := Inclusion.On[f := Identity.identity, u := s.inclusion].map;
\definition projection: Cochains.Map[C := Middle.complex, D := Right.complex].Map := Projection.On[f := Identity.identity, u := s.projection].map;
\module At(n: N.Nat^);
\definition sequence: Exact.Sequence := Exact.Sequence {
  inclusion := inclusion, projection := projection,
  injective := \fun (n: N.Nat^) => At[n := n].injective,
  onto := \fun (n: N.Nat^) => At[n := n].onto,
  zero := \fun (n: N.Nat^) => At[n := n].zero,
  kernelImage := \fun (n: N.Nat^) => At[n := n].kernelImage,
};
\module Bockstein(n: N.Nat^) {
  \import Exact.With[s := sequence].At[n := n] \as Native;
  \definition connecting: _ := Native.connecting;
  \definition onLift: _ := Native.onLift;
  \definition lowerClosed: _ := Native.lowerClosed;
  \import Native.Exactness[] \as Exactness;
  \definition inclusionProjectionZero: _ := Exactness.inclusionProjectionZero;
  \definition projectionConnectingZero: _ := Exactness.projectionConnectingZero;
  \definition connectingInclusionZero: _ := Exactness.connectingInclusionZero;
  \definition exactAtRight: _ := Exactness.exactAtC;
  \definition exactAtLeft: _ := Exactness.exactAtANext;
  \definition exactAtMiddle: _ := Exactness.exactAtB;
}
