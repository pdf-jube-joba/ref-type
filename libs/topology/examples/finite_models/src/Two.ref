\import algebra.Two[] \as Core;
\use std.Logic[].Equality[].eq_reason_in;
\import std.Data[].Bool[] \as B;
\import std.Alg[].Alg[] \as Alg;
\import std.Alg[].Monoid[] \as Monoid;
\import std.Alg[].Ring[] \as Rings;
\import std.Alg[].Field[] \as Fields;
\import std.Logic[].Proposition[] \as Logic;
\definition Carrier: \Set := Core.Carrier;
\definition zero: _ := Core.zero;
\definition one: _ := Core.one;
\definition add: _ := Core.add;
\definition mul: _ := Core.mul;
\definition neg: _ := Core.neg;
\definition inverse: _ := Core.inverse;
\definition cases3: _ := Core.cases3;
\definition addZeroLeft: _ := Core.addZeroLeft;
\definition addZeroRight: _ := Core.addZeroRight;
\definition addAssociative: _ := Core.addAssociative;
\definition addCommutative: _ := Core.addCommutative;
\definition addSelf: _ := Core.addSelf;
\definition mulOneLeft: _ := Core.mulOneLeft;
\definition mulOneRight: _ := Core.mulOneRight;
\definition mulAssociative: _ := Core.mulAssociative;
\definition mulCommutative: _ := Core.mulCommutative;
\definition distributeLeft: _ := Core.distributeLeft;
\definition distributeRight: _ := Core.distributeRight;
\definition mulZeroLeft: _ := Core.mulZeroLeft;
\definition mulZeroRight: _ := Core.mulZeroRight;
\definition data: _ := Core.data;
\definition ringLaws: _ := Core.ringLaws;
\definition ring: _ := Core.ring;
\definition commutativeRing: _ := Core.commutativeRing;
\definition distinguish: _ := Core.distinguish;
\definition nontrivial: _ := Core.nontrivial;
\definition inverseLaw: _ := Core.inverseLaw;
\definition field: _ := Core.field;
\import module_theory.Module[].IntegerGroup[Carrier := Carrier, group := Rings.additiveGroup Carrier ring] \as Integral;
\definition integerSpace: _ := Integral.space;
\import std.Arithmetic[].Int[] \as I;
\import std.Data[].Nat[] \as N;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition two: I.Int^ := I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ N.Nat^::zero));
\definition doubleZero[x: Carrier]: (integerSpace).smul two x = zero :=
  eq_reason_in!{Carrier _
    "=" _ "by" { Integral.onNatural (N.Nat^::succ (N.Nat^::succ N.Nat^::zero)) x }
    "=" _ "by" { congr!{Carrier Carrier} (add x) _ _ (addZeroRight x) }
    "=" _ "by" { addSelf x }
  };
\import module_theory.Module[].Over[R := I.Int^, ring := std.Arithmetic[].IntAlgebra[].Ring[].ring].Laws[V := Carrier, space := integerSpace] \as IntegerValues;
\definition scaleMultiply[a: I.Int^]: \forall (x: Carrier) -> (integerSpace).smul a x = mul ((integerSpace).smul a one) x :=
  B.cases (\fun (x: Carrier) => (integerSpace).smul a x = mul ((integerSpace).smul a one) x)
    (trans!{Carrier} _ _ _ (IntegerValues.scaleZero a) (sym!{Carrier} _ _ (mulZeroRight ((integerSpace).smul a one))))
    (sym!{Carrier} _ _ (mulOneRight ((integerSpace).smul a one)));
\module Quotient;
