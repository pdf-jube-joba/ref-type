\use std.Logic[].Equality[].eq_reason_in;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition Equivalent[x, y: A]: \Prop := Logic.Or[x = y, x = flip y];
\import topological_constructions.RelationQuotient[A := A, relation := Equivalent] \as Quotient;
\definition reflexive[x: A]: Equivalent x x := Logic.Or[x = x, x = flip x]::left (\refl(x));
\definition symmetric[x, y: A][related: Equivalent x y]: Equivalent y x :=
  Logic.orElim (x = y) (x = flip y) (Equivalent y x) related
    (\fun (same: x = y) => Logic.Or[y = x, y = flip x]::left (sym!{A} _ _ same))
    (\fun (same: x = flip y) => Logic.Or[y = x, y = flip x]::right
      (trans!{A} _ _ _ (sym!{A} _ _ (square y)) (congr!{A A} flip _ _ (sym!{A} _ _ same))));
\definition transitive[x, y, z: A][xy: Equivalent x y][yz: Equivalent y z]: Equivalent x z :=
  Logic.orElim (x = y) (x = flip y) (Equivalent x z) xy
    (\fun (same: x = y) => Logic.orElim (y = z) (y = flip z) (Equivalent x z) yz
      (\fun (equal: y = z) => Logic.Or[x = z, x = flip z]::left (trans!{A} _ _ _ same equal))
      (\fun (equal: y = flip z) => Logic.Or[x = z, x = flip z]::right (trans!{A} _ _ _ same equal)))
    (\fun (same: x = flip y) => Logic.orElim (y = z) (y = flip z) (Equivalent x z) yz
      (\fun (equal: y = z) => Logic.Or[x = z, x = flip z]::right
        (trans!{A} _ _ _ same (congr!{A A} flip _ _ equal)))
      (\fun (equal: y = flip z) => Logic.Or[x = z, x = flip z]::left
        (eq_reason_in!{A _
          "=" _ "by" same
          "=" _ "by" { congr!{A A} flip _ _ equal }
          "=" _ "by" { square z }
        })));
\definition laws: Quotient.Laws := Quotient.Laws { refl := reflexive, sym := symmetric, trans := transitive };
\definition Carrier: \Set := Quotient.Carrier;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Quotient.topology source;
\definition class: A -> Carrier := Quotient.class;
\definition identify[x: A]: class (flip x) = class x := Quotient.relatedEqual laws (flip x) x
  (Logic.Or[flip x = x, flip x = flip x]::right (\refl(flip x)));
\definition classEqual[x, y: A]: class x = class y -> Equivalent x y := Quotient.equalRelated laws x y;
\definition continuous: topology.Continuity[A := A, B := Carrier].Continuous source topology class := Quotient.projectionContinuous source;

\import topology.Topology[Carrier := A] \as Source;
\import topology.Continuity[A := A, B := A] \as SelfMaps;
\module FundamentalDomain(F: \Pow A, closed: Source.IsClosedIn source F,
  covers: \forall (x: A) -> Logic.Or[Source.Member F x, Source.Member F (flip x)],
  flipContinuous: SelfMaps.Continuous source source flip);
\module Separation(flipContinuous: SelfMaps.Continuous source source flip);
