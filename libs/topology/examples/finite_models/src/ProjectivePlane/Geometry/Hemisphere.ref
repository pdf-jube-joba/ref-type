\use std.Logic[].Equality[].eq_reason_in;
\import algebraic_topology.Euclidean[].Dimension[n := two] \as Lower;
\import algebraic_topology.Euclidean[].Dimension[n := N.Nat^::succ two] \as Higher;
\import Lower.Splitting[] \as Split;
\import Lower.Geometry[] \as LowerGeometry;
\import Lower.Contraction[] \as LowerContraction;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import Real.Algebra[] \as Algebra;
\import Real.Distance[] \as Distance;
\import Real.SquareRoot[] \as Root;
\import metric_spaces.RealLine[] \as Line;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition northern: \Pow Sphere := { x: Sphere \where R.Le Real.zero (Split.head x) };
\import topology.Topology[Carrier := Sphere].Subspace[S := northern] \as Northern;
\definition Carrier: \Set := Northern.CarrierSet;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Northern.topology (Spheres.topology two);
\definition height[x: Lower.Disk]: Real.Real := Root.sqrt (Real.sub Real.one (Lower.normSquared x));
\definition heightNonnegative[x: Lower.Disk]: R.Le Real.zero (height x) := Root.nonnegative (Real.sub Real.one (Lower.normSquared x));
\definition heightSquared[x: Lower.Disk]: Real.mul (height x) (height x) = Real.sub Real.one (Lower.normSquared x) :=
  Root.squareOfNonnegative (Real.sub Real.one (Lower.normSquared x))
    (Distance.subNonnegative Real.one (Lower.normSquared x) (\bysub(Lower.Coordinate, Lower.ClosedBall, x)));
\definition sphereLift[x: Lower.Disk]: Sphere := \into[Higher.Coordinate](Split.join (height x) x, Higher.Boundary) \by {
  eq_reason_in!{Real.Real _
    "=" _ "by" { Split.normJoin (height x) x }
    "=" _ "by" { congr!{Real.Real Real.Real} (\fun (a: Real.Real) => Real.add a (Lower.normSquared x)) _ _ (heightSquared x) }
    "=" _ "by" { Distance.subAddCancel Real.one (Lower.normSquared x) }
  }
};
\definition lift[x: Lower.Disk]: Carrier := \into[Sphere](sphereLift x, northern) \by {
  R.leReplaceRight Real.zero (height x) (Split.head (sphereLift x)) (sym!{Real.Real} _ _ (Split.headJoin (height x) x))
    (heightNonnegative x)
};
\definition tailBound[x: Sphere]: R.Le (Lower.normSquared (Split.tail x)) Real.one :=
  R.leReplaceRight (Lower.normSquared (Split.tail x)) (Higher.normSquared x) Real.one (\bysub(Higher.Coordinate, Higher.Boundary, x))
    (R.leReplaceRight (Lower.normSquared (Split.tail x))
      (Real.add (Real.mul (Split.head x) (Split.head x)) (Lower.normSquared (Split.tail x))) (Higher.normSquared x)
      (sym!{Real.Real} _ _ (Split.normSplit x))
      (Distance.leAddRightOfNonnegative (Real.mul (Split.head x) (Split.head x)) (Lower.normSquared (Split.tail x))
        (Algebra.squareNonnegative (Split.head x))));
\definition project[x: Carrier]: Lower.Disk := \into[Lower.Coordinate](Split.tail x, Lower.ClosedBall) \by { tailBound x };
\definition leftInverse[x: Lower.Disk]: project (lift x) = x := Split.tailJoin (height x) x;
\import Spheres.Positive[n := N.Nat^::succ N.Nat^::zero].Height[] \as SphereHeight;
\definition recoveredHeight[x: Carrier]: height (project x) = Split.head x :=
  trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real} Root.sqrt _ _
      (trans!{Real.Real} _ _ _
        (congr!{Real.Real Real.Real} (Real.sub Real.one) _ _ (SphereHeight.tailSquared x))
        (Algebra.subSub Real.one (Real.mul (Split.head x) (Split.head x)))))
    (Root.sqrtSquared (Split.head x) (\bysub(Sphere, northern, x)));
\definition rightInverse[x: Carrier]: lift (project x) = x := Split.ext (lift (project x)) x
  (trans!{Real.Real} _ _ _ (Split.headJoin (height (project x)) (project x)) (recoveredHeight x))
  (Split.tailJoin (height (project x)) (project x));
\module Continuity;

\module Fundamental;
\module DiskQuotient;
