\import \parent.Attachment[] \as Attachment;
\import Attachment.Inverse[] \as AttachmentInverse;
\import Attachment.Coefficients[coefficients := coefficients] \as Attached;
\import Attached.Groups[] \as Groups;
\import singular_cohomology.Cochains[A := Carrier, source := topology].With[coefficients := coefficients] \as Actual;
\import singular_cohomology.Cochains[A := Attachment.Point, source := Attachment.pointTopology].With[coefficients := coefficients] \as AttachedNatural;
\import AttachedNatural.Integer[] \as AttachedSigned;
\import chain_complexes.Integer[].Over[R := I.Int^, ring := IntegerRing.ring] \as Signed;
\import algebraic_topology.HomotopyEquivalence[A := Attachment.Point, B := Carrier] \as Equivalences;
\definition equivalence: Equivalences.Equivalence[Attachment.pointTopology, topology] :=
  Equivalences.fromHomeomorphism Attachment.pointTopology topology AttachmentInverse.projectiveHomeomorphism;
\import singular_cohomology.Equivalence[A := Attachment.Point, B := Carrier, source := Attachment.pointTopology, target := topology].With[coefficients := coefficients] \as Comparison;
\module Degree(n: N.Nat^);
\module DegreeZero;
\module DegreeOne;
\module DegreeTwo;
\module Higher(n: N.Nat^);
