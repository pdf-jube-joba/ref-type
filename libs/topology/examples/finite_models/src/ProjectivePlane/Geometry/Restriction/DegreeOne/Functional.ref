\import \parent.Topology[] \as Topological;
\import \parent.\parent.At[n := one] \as RestrictedClass;
\import Cochains.At[C := Model.complex, k := one] \as Target;
\import Cochains.At[C := Actual.complex, k := one] \as Source;
\import Modules.Laws[V := coefficients.Carrier, space := coefficients.space] \as Values;
\import algebra.Group[].Of[Carrier := coefficients.Carrier, group := Values.additive] \as Group;
\import Modules.Hom[V := Target.CycleCarrier, W := coefficients.Carrier, source := Target.cycleSpace, target := coefficients.space] \as Evaluation;
\definition evaluate: Evaluation.Map := Evaluation.Map {
  apply := \fun (h: Target.CycleCarrier) => Coordinates.evaluate h Edge::loop,
  addition := \fun (h, j: Target.CycleCarrier) => \refl(Values.add (Coordinates.evaluate h Edge::loop) (Coordinates.evaluate j Edge::loop)),
  scalar := \fun (a: I.Int^)(h: Target.CycleCarrier) => \refl(Values.scale a (Coordinates.evaluate h Edge::loop)),
};
\import Modules.Of[V := Target.CycleCarrier, space := Target.cycleSpace].Submodule[].Quotient[S := Target.boundariesInside] \as Quotient;
\import Quotient.To[W := coefficients.Carrier, target := coefficients.space] \as Descent;
\import Finite.Coefficients[A := coefficients].Differentials[] \as Differential;
\import Finite.Coefficients[A := coefficients].DegreeZero[] \as ZeroCoordinates;
\definition kills: Descent.Vanishes evaluate := \block {
  \fun (h: Target.CycleCarrier)(boundary: _) \then
  \takefrom f: \Cast[Model.Carrier N.Nat^::zero] ({ f: Model.Carrier N.Nat^::zero \where Model.apply N.Nat^::zero f = h }) \by boundary \then
  \return trans!{coefficients.Carrier} _ _ _
    (congr!{{Model.Carrier one} coefficients.Carrier} (\fun (x: Model.Carrier one) => Coordinates.evaluate x Edge::loop) _ _
      (sym!{{Model.Carrier one}} _ _ (\bysub(Model.Carrier N.Nat^::zero, { f: Model.Carrier N.Nat^::zero \where Model.apply N.Nat^::zero f = h }, f))))
    (trans!{coefficients.Carrier} _ _ _
      (congr!{Coordinates.FunctionCarrier coefficients.Carrier} (\fun (g: Coordinates.FunctionCarrier) => g Edge::loop) _ _ (Differential.zeroth f))
      (Group.inverseRight (ZeroCoordinates.evaluate f Vertex::rim)))
};
\definition functional: Modules.Hom[V := Target.Cohomology, W := coefficients.Carrier, source := Target.cohomologySpace, target := coefficients.space].Map := Descent.descend evaluate kills;
\definition onClass[h: Target.CycleCarrier]: (functional).apply (Target.classOf h) = Coordinates.evaluate h Edge::loop := Descent.onClass evaluate kills h;
\import \root.Circle[].Geometry[].Evaluation[coefficients := coefficients] \as CircleEvaluation;
\import Cochains.At[C := Circle.complex, k := one] \as CircleH;
\import Cochains.Map[C := Actual.complex, D := Circle.complex].At[k := one] \as CircleMap;
\module With(e: CircleEvaluation.Result) {
  \definition onCycle[h: Source.CycleCarrier]:
    ((e).forward).apply ((Topological.pull).apply (Source.classOf h)) = (functional).apply ((RestrictedClass.induced).apply (Source.classOf h)) :=
    trans!{coefficients.Carrier} _ _ _
      (congr!{CircleH.Cohomology coefficients.Carrier} (((e).forward).apply) _ _ (CircleMap.onClass (CirclePull.map Loop.inclusion Loop.continuous Identity.identity) h))
      (trans!{coefficients.Carrier} _ _ _ (CircleEvaluation.onClass e ((CircleMap.cyclesMap (CirclePull.map Loop.inclusion Loop.continuous Identity.identity)).apply h))
        (trans!{coefficients.Carrier} _ _ _ (onLoop h)
          (trans!{coefficients.Carrier} _ _ _ (sym!{coefficients.Carrier} _ _ (onClass (RestrictedClass.cycle h)))
            (congr!{Target.Cohomology coefficients.Carrier} ((functional).apply) _ _ (sym!{Target.Cohomology} _ _ (RestrictedClass.onClass h))))));
  \definition law: \forall (q: Source.Cohomology) ->
    ((e).forward).apply ((Topological.pull).apply q) = (functional).apply ((RestrictedClass.induced).apply q) :=
    Source.classInduction (\fun (q: Source.Cohomology) => ((e).forward).apply ((Topological.pull).apply q) = (functional).apply ((RestrictedClass.induced).apply q)) onCycle;
  \definition injective[x, y: Source.Cohomology][equal: (RestrictedClass.induced).apply x = (RestrictedClass.induced).apply y]: x = y :=
    Topological.injective x y
      (trans!{CircleH.Cohomology} _ _ _ (sym!{CircleH.Cohomology} _ _ ((e).leftInverse ((Topological.pull).apply x)))
        (trans!{CircleH.Cohomology} _ _ _
          (congr!{coefficients.Carrier CircleH.Cohomology} (((e).backward).apply) _ _
            (trans!{coefficients.Carrier} _ _ _ (law x)
              (trans!{coefficients.Carrier} _ _ _ (congr!{Target.Cohomology coefficients.Carrier} ((functional).apply) _ _ equal) (sym!{coefficients.Carrier} _ _ (law y)))))
          ((e).leftInverse ((Topological.pull).apply y))));
}
\definition injective[x, y: Source.Cohomology][equal: (RestrictedClass.induced).apply x = (RestrictedClass.induced).apply y]: x = y := \block {
  \takefrom e: CircleEvaluation.Result \by CircleEvaluation.existence \then
  \return With[e := e].injective x y equal
};
