\use std.Logic[].Equality[].eq_reason_in;
\import \root.Two[] \as Binary;
\import \root.ProjectivePlane[].ModTwo[] \as FiniteBinary;
\import \root.ProjectivePlane[].Bockstein[].Finite[] \as FiniteBockstein;
\import \root.ProjectivePlane[].Geometry[] \as Geometry;
\import Geometry.Restriction[coefficients := FiniteBinary.coefficients] \as Restriction;
\import Restriction.Cup[R := Binary.Carrier, ring := Binary.commutativeRing] \as CupRestriction;
\import singular_products.Cochains[A := Carrier, source := topology, R := Binary.Carrier, ring := Binary.commutativeRing].Cohomology[].Cup[p := one, q := one] \as Cup;
\import \root.Surface[V := Vertex, E := Edge, T := Triangle].On[surface := object].Simplicial[] \as Model;
\import Model.Coefficients[A := FiniteBinary.coefficients] \as Coordinates;
\import Coordinates.DegreeOne[] \as Edges;
\import Coordinates.DegreeTwo[] \as Triangles;
\import Coordinates.Cohomology[].DegreeOne[] \as FirstComparison;
\import Coordinates.Cohomology[].DegreeTwo[] \as SecondComparison;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].On[P := Model.chainComplex, N := FiniteBinary.coefficients] \as Native;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := IntegerRing.ring] \as Cochains;
\import Cochains.At[C := Theory.complex, k := one] \as ActualOne;
\import Cochains.At[C := Native.complex, k := one] \as FiniteOne;
\import Cochains.At[C := Native.complex, k := two] \as FiniteTwo;
\import \root.ProjectivePlane[].With[A := FiniteBinary.coefficients] \as Matrix;
\import \root.Surface[V := Vertex, E := Edge, T := Triangle].On[surface := object].With[A := FiniteBinary.coefficients] \as Surface;
\import \root.Truncated[].Over[zeroth := Surface.zeroth, first := Surface.first, second := Surface.second].On[deltaZero := Surface.differentialZero, deltaOne := Surface.differentialOne, square := Surface.squareZero] \as Truncated;
\import Truncated.DegreeOne[] \as MatrixOne;
\import Truncated.DegreeTwo[] \as MatrixTwo;
\import FiniteBinary.DegreeOne[] \as FirstCoordinate;
\import FiniteBinary.Top[] \as TopCoordinate;
\import Modules.Of[V := MatrixOne.CycleCarrier, space := MatrixOne.cycleSpace].Submodule[].Quotient[S := MatrixOne.boundariesInside].To[W := Binary.Carrier, target := Binary.integerSpace] \as FirstDescent;
\import Modules.Of[V := MatrixTwo.CycleCarrier, space := MatrixTwo.cycleSpace].Submodule[].Quotient[S := MatrixTwo.boundariesInside].To[W := Binary.Carrier, target := Binary.integerSpace] \as TopDescent;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition total[phi: MatrixOne.CycleCarrier]: Binary.Carrier := Matrix.total (FiniteBinary.cup phi phi);
\definition cancel[x: Binary.Carrier]: Binary.add x (Binary.add Binary.one x) = Binary.one :=
  eq_reason_in!{Binary.Carrier _
    "=" _ "by" { congr!{Binary.Carrier Binary.Carrier} (Binary.add x) _ _ (Binary.addCommutative Binary.one x) }
    "=" _ "by" { sym!{Binary.Carrier} _ _ (Binary.addAssociative x x Binary.one) }
    "=" _ "by" { congr!{Binary.Carrier Binary.Carrier} (\fun (a: Binary.Carrier) => Binary.add a Binary.one) _ _ (Binary.addSelf x) }
    "=" _ "by" { Binary.addZeroLeft Binary.one }
  };
\definition squareTotal[phi: MatrixOne.CycleCarrier][loop: phi Edge::loop = Binary.one]: total phi = Binary.one :=
  eq_reason_in!{Binary.Carrier _
    "=" _ "by" { congr!{Binary.Carrier Binary.Carrier Binary.Carrier} Binary.add _ _ _ _
      (trans!{Binary.Carrier} _ _ _ (congr!{Binary.Carrier Binary.Carrier} (Binary.mul (phi Edge::first)) _ _ loop) (Binary.mulOneRight (phi Edge::first)))
      (trans!{Binary.Carrier} _ _ _ (congr!{Binary.Carrier Binary.Carrier} (Binary.mul (phi Edge::second)) _ _ loop) (Binary.mulOneRight (phi Edge::second))) }
    "=" _ "by" { congr!{Binary.Carrier Binary.Carrier} (Binary.add (phi Edge::first)) _ _
        (trans!{Binary.Carrier} _ _ _ (Matrix.closedSecond phi (Matrix.closedCoordinates phi (\bysub(Matrix.Edges, (MatrixOne.cycles).carrier, phi))))
          (congr!{Binary.Carrier Binary.Carrier} (\fun (a: Binary.Carrier) => Binary.add a (phi Edge::first)) _ _ loop)) }
    "=" _ "by" { cancel (phi Edge::first) }
  };
\module At(alpha: ActualOne.CycleCarrier);
\definition squareNonzero: Cup.apply u u = (Theory.cohomologySpace two).zero -> Logic.False :=
  ActualOne.classInduction
    (\fun (h: ActualOne.Cohomology) => h = u -> Cup.apply h h = (Theory.cohomologySpace two).zero -> Logic.False)
    (\fun (alpha: ActualOne.CycleCarrier) => At[alpha := alpha].nonzero) u (\refl(u));
\import Geometry.BinaryClassification[V := Theory.cohomology two, space := Theory.cohomologySpace two] \as Classification;
\definition square: Cup.apply u u = v := Classification.unique degreeTwo (Cup.apply u u) v squareNonzero vNonzero;
\import singular_products.Cochains[A := Carrier, source := topology, R := Binary.Carrier, ring := Binary.commutativeRing].Cohomology[] \as ProductRing;
\definition unit: Theory.cohomology N.Nat^::zero := ProductRing.Unit[].class;
\definition unitRightU: _ := ProductRing.Unit[].Right[p := one].law u;
\definition unitRightV: _ := ProductRing.Unit[].Right[p := two].law v;
\import ProductRing.Cup[p := two, q := one] \as TopProduct;
\definition cubeZero: TopProduct.apply v u = (Theory.cohomologySpace (N.Nat^::succ two)).zero := \parent.Higher[n := N.Nat^::zero].law (TopProduct.apply v u);
\definition uCubed: TopProduct.apply (Cup.apply u u) u = (Theory.cohomologySpace (N.Nat^::succ two)).zero :=
  trans!{{Theory.cohomology (N.Nat^::succ two)}} _ _ _
    (congr!{{Theory.cohomology two} {Theory.cohomology (N.Nat^::succ two)}} (\fun (x: Theory.cohomology two) => TopProduct.apply x u) _ _ square)
    cubeZero;
\import ProductRing.Cup[p := one, q := N.Nat^::zero] \as RightProduct;
\import commutative_algebra.Modules[R := Binary.Carrier, ring := Binary.commutativeRing].Bilinear[A := ProductRing.bundle one, B := ProductRing.bundle N.Nat^::zero, C := ProductRing.bundle one].Properties[] \as UnitLaws;
\definition unitNonzero[equal: unit = (Theory.cohomologySpace N.Nat^::zero).zero]: Logic.False :=
  uNonzero (eq_reason_in!{{Theory.cohomology one} _
    "=" _ "by" { sym!{{Theory.cohomology one}} _ _ unitRightU }
    "=" _ "by" { congr!{{Theory.cohomology N.Nat^::zero} {Theory.cohomology one}} (RightProduct.apply u) _ _ equal }
    "=" _ "by" { UnitLaws.rightZero RightProduct.bilinear u }
  });
\import Geometry.BinaryClassification[V := Theory.cohomology N.Nat^::zero, space := Theory.cohomologySpace N.Nat^::zero] \as ConstantClassification;
\definition unitCoordinate: ((degreeZero).forward).apply unit = Binary.one := ConstantClassification.coordinateOne degreeZero unit unitNonzero;
