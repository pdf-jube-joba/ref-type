\use std.Logic[].Equality[].eq_reason_in;
\import \root.ProjectivePlane[].ModTwo[] \as FiniteBinary;
\import \root.ProjectivePlane[].Bockstein[].Finite[] \as FiniteBockstein;
\import \root.Surface[V := Vertex, E := Edge, T := Triangle].On[surface := object].Simplicial[] \as Model;
\import \parent.\parent.Restriction[coefficients := FiniteBinary.coefficients] \as Restriction;
\import Restriction.DegreeOne[].Functional[] \as Injectivity;
\import Model.Coefficients[A := FiniteBinary.coefficients].Cohomology[].DegreeOne[] \as Coordinates;
\import FiniteBinary.DegreeOne[] \as Local;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := IntegerRing.commutativeRing].On[P := Model.chainComplex, N := FiniteBinary.coefficients] \as Native;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := IntegerRing.ring] \as Cochains;
\import Cochains.At[C := Native.complex, k := one] \as Target;
\import \root.Surface[V := Vertex, E := Edge, T := Triangle].On[surface := object].With[A := FiniteBinary.coefficients] \as Matrix;
\import \root.Truncated[].Over[zeroth := Matrix.zeroth, first := Matrix.first, second := Matrix.second].On[deltaZero := Matrix.differentialZero, deltaOne := Matrix.differentialOne, square := Matrix.squareZero].DegreeOne[] \as LocalH;
\import Modules.Isomorphism[V := Target.Cohomology, W := LocalH.Cohomology, source := Target.cohomologySpace, target := LocalH.cohomologySpace].Composition[U := F.Carrier, final := F.integerSpace] \as Compose;
\definition coordinate: Modules.Isomorphism[V := Target.Cohomology, W := F.Carrier, source := Target.cohomologySpace, target := F.integerSpace].Isomorphism := Compose.compose Local.isomorphism Coordinates.isomorphism;
\definition finiteNonzero[equal: FiniteBockstein.binaryGenerator = Target.zeroClass]: std.Logic[].Proposition[].False :=
  Local.generatorNonzero (eq_reason_in!{LocalH.Cohomology _
    "=" _ "by" { sym!{LocalH.Cohomology} _ _ FiniteBockstein.binaryCompared }
    "=" _ "by" { congr!{Target.Cohomology LocalH.Cohomology} (((Coordinates.isomorphism).forward).apply) _ _ equal }
    "=" _ "by" { Modules.Hom[V := Target.Cohomology, W := LocalH.Cohomology, source := Target.cohomologySpace, target := LocalH.cohomologySpace].zeroPreserved (Coordinates.isomorphism).forward }
  });
\definition imageNonzero[equal: (Restriction.At[n := one].induced).apply u = Target.zeroClass]: std.Logic[].Proposition[].False :=
  uNonzero (Injectivity.injective u ((Theory.cohomologySpace one).zero)
    (trans!{Target.Cohomology} _ _ _ equal
      (sym!{Target.Cohomology} _ _ (Modules.Hom[V := Theory.cohomology one, W := Target.Cohomology, source := Theory.cohomologySpace one, target := Target.cohomologySpace].zeroPreserved Restriction.At[n := one].induced))));
\import \parent.\parent.BinaryClassification[V := Target.Cohomology, space := Target.cohomologySpace] \as Detection;
\definition onU: (Restriction.At[n := one].induced).apply u = FiniteBockstein.binaryGenerator := Detection.unique coordinate _ _ imageNonzero finiteNonzero;
