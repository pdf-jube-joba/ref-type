\import \root.ProjectivePlane[].Integral[] \as Finite;
\import \parent.Cohomology[coefficients := Finite.coefficients] \as Actual;
\import \parent.Attachment[].Coefficients[coefficients := Finite.coefficients].Groups[] \as Groups;
\import singular_cohomology.Cochains[A := Carrier, source := topology].With[coefficients := Finite.coefficients] \as Theory;
\import Modules.End[V := I.Int^, space := Modules.scalarModule] \as Identity;
\definition identity: Modules.Isomorphism[V := I.Int^, W := I.Int^, source := Modules.scalarModule, target := Modules.scalarModule].Isomorphism :=
  Modules.Isomorphism[V := I.Int^, W := I.Int^, source := Modules.scalarModule, target := Modules.scalarModule].Isomorphism {
    forward := Identity.identity, backward := Identity.identity,
    leftInverse := \fun (x: I.Int^) => \refl(x), rightInverse := \fun (x: I.Int^) => \refl(x),
  };
\import singular_finite_algebra.Integer[].Attachment[coefficients := Finite.coefficients, first := Groups.first, second := Groups.second].On[data := Groups.data].Integral[e := identity] \as Calculation;
\import finitely_generated_modules.IntegerCyclic[d := Finite.two] \as Z2;
\definition degreeZero: Modules.Isomorphism[V := Theory.cohomology N.Nat^::zero, W := I.Int^, source := Theory.cohomologySpace N.Nat^::zero, target := Modules.scalarModule].Isomorphism := Actual.DegreeZero[].isomorphism;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import Modules.Isomorphism[V := Theory.cohomology one, W := Groups.Kernel, source := Theory.cohomologySpace one, target := Groups.kernelSpace].Vanishing[] \as Vanishing;
\definition degreeOneZero: \forall (h: Theory.cohomology one) -> h = (Theory.cohomologySpace one).zero := Vanishing.sourceZero Actual.DegreeOne[].isomorphism Calculation.kernelZero;
\import Modules.Isomorphism[V := Theory.cohomology two, W := Groups.Cokernel, source := Theory.cohomologySpace two, target := Groups.cokernelSpace].Composition[U := Z2.Carrier, final := Z2.space] \as Composition;
\definition degreeTwo: Modules.Isomorphism[V := Theory.cohomology two, W := Z2.Carrier, source := Theory.cohomologySpace two, target := Z2.space].Isomorphism :=
  Composition.compose Calculation.cokernelIsomorphism Actual.DegreeTwo[].isomorphism;
\definition generator: Theory.cohomology two := ((degreeTwo).backward).apply (Z2.class I.One.specification);
\definition onGenerator: ((degreeTwo).forward).apply generator = Z2.class I.One.specification := (degreeTwo).rightInverse (Z2.class I.One.specification);
\module Higher(n: N.Nat^) {
  \definition law: _ := Actual.Higher[n := n].law;
}
