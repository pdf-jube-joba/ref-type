\import N.Basic[].Def[] \as Arithmetic;
\definition index: N.Nat^ := Arithmetic.add n (N.Nat^::succ two);
\import Signed.At[C := AttachedSigned.complex, z := I.Int^::ofNat index] \as Target;
\import Modules.Isomorphism[V := Actual.cohomology index, W := Target.Cohomology, source := Actual.cohomologySpace index, target := Target.cohomologySpace].Vanishing[] \as Vanishing;
\definition law: \forall (h: Actual.cohomology index) -> h = (Actual.cohomologySpace index).zero :=
  Vanishing.sourceZero (\parent.Degree[n := index].isomorphism) (Attached.Higher[n := n].law);
