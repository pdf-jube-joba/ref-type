\import Signed.At[C := AttachedSigned.complex, z := I.Int^::ofNat n] \as Target;
\import Modules.Isomorphism[V := Target.Cohomology, W := AttachedNatural.cohomology n, source := Target.cohomologySpace, target := AttachedNatural.cohomologySpace n].Inverse[] \as SignedInverse;
\import Modules.Isomorphism[V := AttachedNatural.cohomology n, W := Actual.cohomology n, source := AttachedNatural.cohomologySpace n, target := Actual.cohomologySpace n].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := Actual.cohomology n, W := AttachedNatural.cohomology n, source := Actual.cohomologySpace n, target := AttachedNatural.cohomologySpace n].Composition[U := Target.Cohomology, final := Target.cohomologySpace] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Actual.cohomology n, W := Target.Cohomology, source := Actual.cohomologySpace n, target := Target.cohomologySpace].Isomorphism :=
  Composition.compose (SignedInverse.inverse AttachedSigned.At[n := n].isomorphism) (Inverse.inverse (Comparison.At[n := n].isomorphism equivalence));
