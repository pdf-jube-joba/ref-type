\definition index: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import Signed.At[C := AttachedSigned.complex, z := I.Int^::ofNat index] \as Middle;
\import Modules.Isomorphism[V := Actual.cohomology index, W := Middle.Cohomology, source := Actual.cohomologySpace index, target := Middle.cohomologySpace].Composition[U := Groups.Kernel, final := Groups.kernelSpace] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Actual.cohomology index, W := Groups.Kernel, source := Actual.cohomologySpace index, target := Groups.kernelSpace].Isomorphism :=
  Composition.compose Groups.kernelIsomorphism (\parent.Degree[n := index].isomorphism);
