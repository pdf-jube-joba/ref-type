\definition index: N.Nat^ := N.Nat^::zero;
\import Signed.At[C := AttachedSigned.complex, z := I.Int^::ofNat index] \as Middle;
\import Attached.Zeroth[] \as Zeroth;
\import Modules.Isomorphism[V := coefficients.Carrier, W := Middle.Cohomology, source := coefficients.space, target := Middle.cohomologySpace].Inverse[] \as Inverse;
\import Modules.Isomorphism[V := Actual.cohomology index, W := Middle.Cohomology, source := Actual.cohomologySpace index, target := Middle.cohomologySpace].Composition[U := coefficients.Carrier, final := coefficients.space] \as Composition;
\definition isomorphism: Modules.Isomorphism[V := Actual.cohomology index, W := coefficients.Carrier, source := Actual.cohomologySpace index, target := coefficients.space].Isomorphism :=
  Composition.compose (Inverse.inverse Zeroth.isomorphism) (\parent.Degree[n := index].isomorphism);
