\import ActualSequence.On[s := s] \as Source;
\import FiniteSequence.On[s := s] \as Target;
\import Morphism.Diagram[s := Source.sequence, t := Target.sequence, a := LeftRestriction.map, b := MiddleRestriction.map, c := RightRestriction.map] \as Diagram;
\definition diagram: Diagram.Commutative := Diagram.Commutative {
  left := \fun (n: N.Nat^)(h: SourceLeft.Carrier n) => TargetMiddle.At[n := n].ext
    ((MiddleRestriction.map).apply n ((Source.inclusion).apply n h))
    ((Target.inclusion).apply n ((LeftRestriction.map).apply n h))
    (\fun (x: Finite.chainComplex.family.Carrier n) => \refl((s.inclusion).apply ((h).apply ((Geometric.comparison).apply n x)))),
  right := \fun (n: N.Nat^)(h: SourceMiddle.Carrier n) => TargetRight.At[n := n].ext
    ((Target.projection).apply n ((MiddleRestriction.map).apply n h))
    ((RightRestriction.map).apply n ((Source.projection).apply n h))
    (\fun (x: Finite.chainComplex.family.Carrier n) => \refl((s.projection).apply ((h).apply ((Geometric.comparison).apply n x)))),
};
\module At(n: N.Nat^) {
  \import Diagram.At[n := n] \as Naturality;
  \import Cochains.At[C := SourceRight.complex, k := n] \as Input;
  \definition law[q: Input.Cohomology]:
    (Target.Bockstein[n := n].connecting).apply ((RightRestriction.At[n := n].induced).apply q) =
    (LeftRestriction.At[n := N.Nat^::succ n].induced).apply ((Source.Bockstein[n := n].connecting).apply q) :=
    Naturality.naturality diagram q;
}
