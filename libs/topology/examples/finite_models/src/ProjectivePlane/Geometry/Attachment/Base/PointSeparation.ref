\use std.Logic[].Equality[].eq_reason_in;
\import \root.ProjectivePlane[].Geometry[] \as Projective;
\import Projective.Hausdorff[] \as ProjectiveSeparation;
\import topology.Topology[Carrier := Projective.Carrier] \as Target;
\import topology.Continuity[A := Point, B := Projective.Carrier] \as Maps;
\import topology.Homeomorphism[A := Point, B := Projective.Carrier] \as Compared;
\definition map: Point -> Projective.Carrier := (AttachmentInverse.projectiveHomeomorphism).forward;
\definition mappingContinuous: Maps.Continuous pointTopology Projective.topology map := (Compared.laws pointTopology Projective.topology AttachmentInverse.projectiveHomeomorphism).forwardContinuous;
\definition mappingInjective[x, y: Point][same: map x = map y]: x = y :=
  eq_reason_in!{Point _
    "=" _ "by" { sym!{Point} _ _ ((Compared.laws pointTopology Projective.topology AttachmentInverse.projectiveHomeomorphism).leftInverse x) }
    "=" _ "by" { congr!{Projective.Carrier Point} ((AttachmentInverse.projectiveHomeomorphism).backward) _ _ same }
    "=" _ "by" { (Compared.laws pointTopology Projective.topology AttachmentInverse.projectiveHomeomorphism).leftInverse y }
  };
\definition law: PointSpace.IsT2 pointTopology := \block {
  \fun (x, y: Point)(different: Logic.Not (x = y)) \then
  \takefrom U: \Cast[\Pow Projective.Carrier] ({ U: \Pow Projective.Carrier \where Target.RegularChoice[Projective.topology, Target.Singleton (map y), map x, U] })
    \by ProjectiveSeparation.law (map x) (map y) (\fun (equal: map x = map y) => different (mappingInjective x y equal)) \then
  \let data: Target.RegularChoice[Projective.topology, Target.Singleton (map y), map x, U] :=
    \bysub(\Pow Projective.Carrier, { U: \Pow Projective.Carrier \where Target.RegularChoice[Projective.topology, Target.Singleton (map y), map x, U] }, U) \then
  \takefrom V: \Cast[\Pow Projective.Carrier] ({ V: \Pow Projective.Carrier \where Target.NormalPartner[Projective.topology, Target.Singleton (map y), U, V] }) \by (data).partner \then
  \let partner: Target.NormalPartner[Projective.topology, Target.Singleton (map y), U, V] :=
    \bysub(\Pow Projective.Carrier, { V: \Pow Projective.Carrier \where Target.NormalPartner[Projective.topology, Target.Singleton (map y), U, V] }, V) \then
  \return Logic.existsIntro[\Pow Point, { W: \Pow Point \where PointSpace.RegularChoice[pointTopology, PointSpace.Singleton y, x, W] }] (Maps.Preimage map U)
    (PointSpace.RegularChoice[pointTopology, PointSpace.Singleton y, x, Maps.Preimage map U] {
      open := mappingContinuous U (data).open, contains := (data).contains,
      partner := Logic.existsIntro[\Pow Point, { W: \Pow Point \where PointSpace.NormalPartner[pointTopology, PointSpace.Singleton y, Maps.Preimage map U, W] }] (Maps.Preimage map V)
        (PointSpace.NormalPartner[pointTopology, PointSpace.Singleton y, Maps.Preimage map U, Maps.Preimage map V] {
          open := mappingContinuous V (partner).open,
          covers := \fun (z: Point)(equal: z = y) => (partner).covers (map z) (congr!{Point Projective.Carrier} map _ _ equal),
          disjoint := \fun (z: Point)(inU: PointSpace.Member (Maps.Preimage map U) z)(inV: PointSpace.Member (Maps.Preimage map V) z) => (partner).disjoint (map z) inU inV,
        }),
    })
};
