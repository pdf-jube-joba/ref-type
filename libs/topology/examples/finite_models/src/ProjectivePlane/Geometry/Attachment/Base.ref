\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Fibers[] \as Fibers;
\import \parent.Inverse[] \as AttachmentInverse;
\import topology.Topology[Carrier := Point] \as PointSpace;
\import PointSpace.Subspace[S := Fibers.BaseImage] \as Subspace;
\definition Carrier: \Set := Subspace.CarrierSet;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Subspace.topology pointTopology;
\definition inclusion[q: Circle.Carrier]: Carrier := \into[Point](Attached.inclusion q, Fibers.BaseImage) \by { Fibers.baseMember q };
\definition injective[q, r: Circle.Carrier][equal: inclusion q = inclusion r]: q = r := Fibers.baseInjective q r equal;
\definition onto[p: Carrier]: \exists ( q: Circle.Carrier \where inclusion q = p ) := \block {
  \takefrom q: \Cast[Circle.Carrier] ({ q: Circle.Carrier \where Attached.inclusion q = p }) \by \bysub(Point, Fibers.BaseImage, p) \then
  \return Logic.existsIntro[Circle.Carrier, { q: Circle.Carrier \where inclusion q = p }] q
    (\bysub(Circle.Carrier, { q: Circle.Carrier \where Attached.inclusion q = p }, q))
};
\import topology.Continuity[A := Circle.Carrier, B := Point].Corestriction[S := Fibers.BaseImage] \as Into;
\definition continuous: topology.Continuity[A := Circle.Carrier, B := Carrier].Continuous Circle.topology topology inclusion :=
  Into.corestrictContinuous Circle.topology pointTopology inclusion (Pushout.inlContinuous Circle.topology Disk.diskTopology);
\import topological_constructions.RelationQuotient[A := Circle.Sphere, relation := Circle.Equivalent] \as CircleClasses;
\import algebraic_topology.Euclidean[].Dimension[n := two].Compactness[] \as CircleCompact;
\import topology.Compactness[A := Circle.Sphere, B := Circle.Carrier] \as CompactImage;
\definition compact: topology.Topology[Carrier := Circle.Carrier].IsCompact Circle.topology :=
  CompactImage.surjectiveImage Circle.sphereTopology Circle.topology Circle.class (CircleClasses.projectionContinuous Circle.sphereTopology) CircleClasses.surjective CircleCompact.sphere;
\module PointSeparation;
\import Subspace.Properties[] \as Properties;
\definition hausdorff: topology.Topology[Carrier := Carrier].IsT2 topology := Properties.hausdorff pointTopology PointSeparation[].law;
\import topological_constructions.CompactQuotient[A := Circle.Carrier, B := Carrier, source := Circle.topology, target := topology, q := inclusion] \as QuotientMap;
\import topology.Homeomorphism[A := Circle.Carrier, B := Carrier] \as Homeomorphisms;
\import Homeomorphisms.OfQuotient[f := inclusion] \as Inverse;
\definition homeomorphism: Homeomorphisms.Homeomorphism[Circle.topology, topology] :=
  Inverse.homeomorphism Circle.topology topology injective onto continuous (QuotientMap.reflectsOpen (QuotientMap.closedMap compact hausdorff continuous) onto);
\import Homeomorphisms.Inverse[] \as Reverse;
\import topology.Homeomorphism[A := Carrier, B := Circle.Carrier].Composition[C := Circle.Sphere] \as Composition;
\definition sphereHomeomorphism: topology.Homeomorphism[A := Carrier, B := Circle.Sphere].Homeomorphism[topology, Circle.sphereTopology] :=
  Composition.compose topology Circle.topology Circle.sphereTopology (Reverse.inverse Circle.topology topology homeomorphism) Circle.homeomorphism;
\definition toSphere: Carrier -> Circle.Sphere := (sphereHomeomorphism).forward;
\definition onIncluded[q: Circle.Carrier]: toSphere (inclusion q) = Circle.forward q :=
  congr!{Circle.Carrier Circle.Sphere} Circle.forward _ _ ((Homeomorphisms.laws Circle.topology topology homeomorphism).leftInverse q);
\definition boundaryPoint[x: Circle.Sphere]: Carrier := \into[Point](Attached.characteristic (boundary x), Fibers.BaseImage) \by {
  Fibers.boundaryInBase (boundary x) (\bysub(Disk.Coordinate, Disk.Boundary, x))
};
\definition attachingEquation[x: Circle.Sphere]: toSphere (boundaryPoint x) = Powers.square x :=
  eq_reason_in!{Circle.Sphere _
    "=" _ "by" { congr!{Carrier Circle.Sphere} toSphere (boundaryPoint x) (inclusion (Circle.class x))
      (sym!{Carrier} (inclusion (Circle.class x)) (boundaryPoint x) (Attached.attached x)) }
    "=" _ "by" { onIncluded (Circle.class x) }
    "=" _ "by" { attachingSquare x }
  };
