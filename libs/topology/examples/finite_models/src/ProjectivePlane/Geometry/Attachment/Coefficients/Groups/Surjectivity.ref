\import Cochains.At[C := Sub.complex, z := degreeTwo] \as BaseH2;
\import Cochains.Map[C := Whole.complex, D := Sub.complex].At[k := degreeTwo] \as Projection;
\definition law[h: second.Carrier]: \exists ( q: coefficients.Carrier \where (inclusion).apply q = h ) := \block {
  \takefrom a: \Cast[RelativeH.Cohomology] ({ a: RelativeH.Cohomology \where (Inclusion.induced Sequence.inclusion).apply a = h })
    \by SecondExactness.exactAtB h (\parent.\parent.BaseHigher[n := zero].law ((Projection.induced Sequence.restriction).apply h)) \then
  \return Logic.existsIntro[coefficients.Carrier, { q: coefficients.Carrier \where (inclusion).apply q = h }] (((relativeOrientation).backward).apply a)
    (trans!{second.Carrier} _ _ _
      (congr!{RelativeH.Cohomology second.Carrier} ((Inclusion.induced Sequence.inclusion).apply) _ _ ((relativeOrientation).rightInverse a))
      (\bysub(RelativeH.Cohomology, { a: RelativeH.Cohomology \where (Inclusion.induced Sequence.inclusion).apply a = h }, a)))
};
