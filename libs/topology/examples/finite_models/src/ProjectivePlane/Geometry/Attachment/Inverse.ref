\import real.Analysis[] \as Real;
\definition oppositeBoundary[x, y: Disk.Disk][boundaryX: Disk.normSquared x = Real.one][opposite: x = Boundary.negative y]:
  Disk.normSquared y = Real.one := trans!{Real.Real} _ _ _ (sym!{Real.Real} _ _ (Boundary.negativeNorm y))
    (trans!{Real.Real} _ _ _ (congr!{Disk.Coordinate Real.Real} Disk.normSquared _ _ (sym!{Disk.Disk} _ _ opposite)) boundaryX);
\definition identified[x, y: Disk.Disk][boundaryX: Disk.normSquared x = Real.one][opposite: x = Boundary.negative y]:
  Attached.characteristic x = Attached.characteristic y := \block {
    \let a: Circle.Sphere := \into[Disk.Coordinate](x, Disk.Boundary) \by { boundaryX } \then
    \let b: Circle.Sphere := \into[Disk.Coordinate](y, Disk.Boundary) \by { oppositeBoundary x y boundaryX opposite } \then
    \let sameCircle: Circle.class a = Circle.class b := topological_constructions.RelationQuotient[A := Circle.Sphere, relation := Circle.Equivalent].relatedEqual Circle.laws a b
      (Logic.Or[a = b, a = CircleAntipodal.apply b]::right opposite) \then
    \return trans!{Point} _ _ _ (sym!{Point} _ _ (Attached.attached a))
      (trans!{Point} _ _ _ (congr!{Circle.Carrier Point} Attached.inclusion _ _ sameCircle) (Attached.attached b))
};
\definition respects[x, y: Disk.Disk][related: DiskQuotient.Equivalent x y]: Attached.characteristic x = Attached.characteristic y :=
  Logic.orElim (x = y) (Logic.And[Disk.normSquared x = Real.one, x = Boundary.negative y]) (Attached.characteristic x = Attached.characteristic y)
    ((Boundary.characterizes x y).ltr related)
    (congr!{Disk.Disk Point} Attached.characteristic x y)
    (\fun (boundary: Logic.And[Disk.normSquared x = Real.one, x = Boundary.negative y]) => identified x y ((boundary).left) ((boundary).right));
\import DiskClasses.Descent[C := Point] \as Descent;
\definition backward: DiskQuotient.Point -> Point := Descent.apply DiskQuotient.laws Attached.characteristic respects;
\definition onDiskClass[x: Disk.Disk]: backward (DiskQuotient.projection x) = Attached.characteristic x := Descent.onClass DiskQuotient.laws Attached.characteristic respects x;
\definition backwardContinuous: topology.Continuity[A := DiskQuotient.Point, B := Point].Continuous DiskQuotient.pointTopology pointTopology backward :=
  Descent.continuous Disk.diskTopology pointTopology DiskQuotient.laws Attached.characteristic respects (Attached.characteristicContinuous Circle.topology);
\definition rightInverse: \forall (q: DiskQuotient.Point) -> forward (backward q) = q := DiskClasses.induction
  (\fun (q: DiskQuotient.Point) => forward (backward q) = q)
  (\fun (x: Disk.Disk) => trans!{DiskQuotient.Point} _ _ _ (congr!{Point DiskQuotient.Point} forward _ _ (onDiskClass x)) (forwardOnRight x));
\import topological_constructions.RelationQuotient[A := Circle.Sphere, relation := Circle.Equivalent] \as CircleClasses;
\definition onLeft: \forall (q: Circle.Carrier) -> backward (forward (Attached.inclusion q)) = Attached.inclusion q := CircleClasses.induction
  (\fun (q: Circle.Carrier) => backward (forward (Attached.inclusion q)) = Attached.inclusion q)
  (\fun (x: Circle.Sphere) => trans!{Point} _ _ _
    (congr!{DiskQuotient.Point Point} backward _ _
      (trans!{DiskQuotient.Point} _ _ _ (forwardOnLeft (Circle.class x)) (onCircleClass x)))
    (trans!{Point} _ _ _ (onDiskClass (boundary x)) (sym!{Point} _ _ (Attached.attached x))));
\definition onRight[x: Disk.Disk]: backward (forward (Attached.characteristic x)) = Attached.characteristic x :=
  trans!{Point} _ _ _ (congr!{DiskQuotient.Point Point} backward _ _ (forwardOnRight x)) (onDiskClass x);
\import topological_constructions.Coproduct[A := Circle.Carrier, B := Disk.Disk] \as Sum;
\import topological_constructions.RelationQuotient[A := Sum.Carrier, relation := Pushout.Related] \as PushoutClasses;
\definition leftInverse: \forall (q: Point) -> backward (forward q) = q := PushoutClasses.induction
  (\fun (q: Point) => backward (forward q) = q)
  (\induction (p: Sum.Carrier) \return backward (forward (Pushout.class p)) = Pushout.class p \with {
    | inl: onLeft | inr: onRight
  });
\import topology.Homeomorphism[A := Point, B := DiskQuotient.Point] \as Homeomorphisms;
\definition homeomorphism: Homeomorphisms.Homeomorphism[pointTopology, DiskQuotient.pointTopology] := Homeomorphisms.Homeomorphism[pointTopology, DiskQuotient.pointTopology] {
  forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
  forwardContinuous := forwardContinuous, backwardContinuous := backwardContinuous,
};
\import \root.ProjectivePlane[].Geometry[] \as Projective;
\import Homeomorphisms.Composition[C := Projective.Carrier] \as Composition;
\definition projectiveHomeomorphism: topology.Homeomorphism[A := Point, B := Projective.Carrier].Homeomorphism[pointTopology, Projective.topology] :=
  Composition.compose pointTopology DiskQuotient.pointTopology Projective.topology homeomorphism DiskQuotient.homeomorphism;
