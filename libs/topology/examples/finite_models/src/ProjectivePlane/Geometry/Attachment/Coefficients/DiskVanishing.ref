\definition index: N.Nat^ := N.Nat^::succ n;
\import Cochains.At[C := DiskWhole.complex, z := I.Int^::ofNat index] \as H;
\import singular_cohomology.Cochains[A := Disk.Disk, source := Disk.diskTopology].With[coefficients := coefficients] \as Native;
\import singular_cohomology.Calculations[A := Disk.Disk, source := Disk.diskTopology].With[coefficients := coefficients].Contractible[] \as Calculation;
\import Modules.Isomorphism[V := H.Cohomology, W := Native.cohomology index, source := H.cohomologySpace, target := Native.cohomologySpace index].Vanishing[] \as Vanishing;
\definition law: \forall (h: H.Cohomology) -> h = H.zeroClass :=
  Vanishing.sourceZero (DiskWhole.At[n := index].isomorphism) (Calculation.positiveCohomology (Disk.Contraction[].contraction) n);
