\import cohomology_models.Spheres[].With[coefficients := coefficients].Reduced[] \as SphereGroups;
\import \parent.RelativeDegree[n := zero] \as Lower;
\import Cochains.At[C := Relative.complex, z := degreeOne] \as H1;
\import Modules.Isomorphism[V := SphereGroups.cohomology one (I.Int^::ofNat zero), W := H1.Cohomology,
  source := SphereGroups.space one (I.Int^::ofNat zero), target := H1.cohomologySpace].Vanishing[] \as First;
\definition first: \forall (h: H1.Cohomology) -> h = H1.zeroClass := First.targetZero Lower.isomorphism (SphereGroups.below zero zero);
\module Higher(n: N.Nat^);
\import \parent.RelativeSigned[z := I.Int^::negSucc zero] \as ZeroComparison;
\import Cochains.At[C := Relative.complex, z := I.Int^::ofNat zero] \as H0;
\import Modules.Isomorphism[V := SphereGroups.cohomology one (I.Int^::negSucc zero), W := H0.Cohomology,
  source := SphereGroups.space one (I.Int^::negSucc zero), target := H0.cohomologySpace].Vanishing[] \as Zero;
\definition zeroth: \forall (h: H0.Cohomology) -> h = H0.zeroClass := Zero.targetZero ZeroComparison.isomorphism (SphereGroups.negative one zero);
