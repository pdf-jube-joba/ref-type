\use std.Logic[].Equality[].eq_reason_in;
\import N.Basic[].Def[] \as Arithmetic;
\definition index: N.Nat^ := Arithmetic.add n three;
\definition degree: I.Int^ := I.Int^::ofNat index;
\import Cochains.At[C := Whole.complex, z := degree] \as H;
\import Cochains.At[C := Relative.complex, z := degree] \as R;
\import Cochains.Map[C := Relative.complex, D := Whole.complex].At[k := degree] \as Inclusion;
\import Cochains.Map[C := Whole.complex, D := Sub.complex].At[k := degree] \as Projection;
\import Exact.At[s := Sequence.sequence, k := degree].Exactness[] \as Exactness;
\import Modules.Hom[V := R.Cohomology, W := H.Cohomology, source := R.cohomologySpace, target := H.cohomologySpace] \as Maps;
\definition law[h: H.Cohomology]: h = H.zeroClass := \block {
  \takefrom a: \Cast[R.Cohomology] ({ a: R.Cohomology \where (Inclusion.induced Sequence.inclusion).apply a = h })
    \by Exactness.exactAtB h (\parent.BaseHigher[n := N.Nat^::succ n].law ((Projection.induced Sequence.restriction).apply h)) \then
  \return eq_reason_in!{H.Cohomology _
    "=" _ "by" { sym!{H.Cohomology} _ _ (\bysub(R.Cohomology, { a: R.Cohomology \where (Inclusion.induced Sequence.inclusion).apply a = h }, a)) }
    "=" _ "by" { congr!{R.Cohomology H.Cohomology} ((Inclusion.induced Sequence.inclusion).apply) _ _ (\parent.RelativeVanishing[].Higher[n := n].law a) }
    "=" _ "by" { Maps.zeroPreserved (Inclusion.induced Sequence.inclusion) }
  }
};
