\import \root.ProjectivePlane[].Geometry[] \as Projective;
\import \root.ProjectivePlane[].Geometry[].Hemisphere[] \as Hemisphere;
\import Hemisphere.Fundamental[] \as Fundamental;
\import \root.Involution[A := Projective.Sphere, source := Spheres.topology two, flip := Antipodal.apply, square := Antipodal.involution].FundamentalDomain[F := Hemisphere.northern, closed := Fundamental.closed, covers := Fundamental.covers, flipContinuous := Antipodal.continuous].Comparison[] \as HemisphereComparison;
\import DiskClasses.Descent[C := Fundamental.QuotientPoint] \as Northern;
\definition diskOnClass[x: Disk.Disk]: (DiskQuotient.homeomorphism).forward (DiskQuotient.projection x) = Projective.projection (Hemisphere.sphereLift x) :=
  trans!{Projective.Carrier} _ _ _
    (congr!{Fundamental.QuotientPoint Projective.Carrier} ((Fundamental.homeomorphism).forward) _ _
      (Northern.onClass DiskQuotient.laws DiskQuotient.northProjection DiskQuotient.respects x))
    (HemisphereComparison.forwardOnPoint (Hemisphere.lift x));
\import \parent.Inverse[] \as Inverse;
\definition characteristic[x: Disk.Disk]: (Inverse.projectiveHomeomorphism).forward (Attached.characteristic x) = Projective.projection (Hemisphere.sphereLift x) :=
  trans!{Projective.Carrier} _ _ _
    (congr!{DiskQuotient.Point Projective.Carrier} ((DiskQuotient.homeomorphism).forward) _ _ (forwardOnRight x))
    (diskOnClass x);
