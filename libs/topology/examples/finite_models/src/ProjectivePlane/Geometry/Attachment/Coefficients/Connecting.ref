\use std.Logic[].Equality[].eq_reason_in;
\import \parent.BoundaryAction[] \as BoundaryAction;
\import DiskPair.Maps[B := Point].Over[target := pointTopology, targetSubset := Fibers.BaseImage].On[f := CellComparison.characteristic].Integer[].With[coefficients := coefficients].Naturality[] \as CoefficientMap;
\import Exact.At[s := Sequence.sequence, k := degreeOne] \as Actual;
\import DiskExact.At[s := DiskSequence.sequence, k := degreeOne] \as Disk;
\definition onOrientation[q: coefficients.Carrier]: (Actual.connecting).apply (((baseOrientation).forward).apply q) = ((relativeOrientation).forward).apply ((coefficients.space).add q q) :=
  Modules.Hom[V := RelativeH.Cohomology, W := DiskH.Cohomology, source := RelativeH.cohomologySpace, target := DiskH.cohomologySpace].injectiveOfZeroKernel (cellRestriction).forward
    (\fun (h: RelativeH.Cohomology)(zero: ((cellRestriction).forward).apply h = (DiskH.cohomologySpace).zero) =>
      eq_reason_in!{RelativeH.Cohomology _
        "=" _ "by" { sym!{RelativeH.Cohomology} _ _ ((cellRestriction).leftInverse h) }
        "=" _ "by" { congr!{DiskH.Cohomology RelativeH.Cohomology} (((cellRestriction).backward).apply) _ _ zero }
        "=" _ "by" { Modules.Hom[V := DiskH.Cohomology, W := RelativeH.Cohomology, source := DiskH.cohomologySpace, target := RelativeH.cohomologySpace].zeroPreserved (cellRestriction).backward }
      }) _ _
    (eq_reason_in!{DiskH.Cohomology _
      "=" _ "by" { sym!{DiskH.Cohomology} _ _ (CoefficientMap.At[z := degreeOne].connectingNaturality (((baseOrientation).forward).apply q)) }
      "=" _ "by" { congr!{BoundaryH.Cohomology DiskH.Cohomology} ((Disk.connecting).apply) _ _ (BoundaryAction.onOrientation q) }
      "=" _ "by" { sym!{DiskH.Cohomology} _ _ ((cellRestriction).rightInverse (((diskOrientation).forward).apply ((coefficients.space).add q q))) }
    });
