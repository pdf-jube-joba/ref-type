\import std.Data[].Bool[].Prop[] \as Bool;
\definition positive: \forall (n: N.Nat^) -> Natural.Le three n -> positiveRanks n = zero :=
  \induction (n: N.Nat^) \return Natural.Le three n -> positiveRanks n = zero \with {
    | zero: \fun (bad: Natural.Le three zero) => Bool.absurd (positiveRanks zero = zero) bad
    | succ: \fun (n: N.Nat^)(previous: _) =>
      (\induction (n: N.Nat^) \return Natural.Le three (N.Nat^::succ n) -> positiveRanks (N.Nat^::succ n) = zero \with {
        | zero: \fun (bad: Natural.Le three one) => Bool.absurd (positiveRanks one = zero) bad
        | succ: \fun (n: N.Nat^)(previous: _) =>
          (\induction (n: N.Nat^) \return Natural.Le three (N.Nat^::succ (N.Nat^::succ n)) -> positiveRanks (N.Nat^::succ (N.Nat^::succ n)) = zero \with {
            | zero: \fun (bad: Natural.Le three two) => Bool.absurd (positiveRanks two = zero) bad
            | succ: \fun (n: N.Nat^)(previous: _)(bound: _) => \refl(zero)
          }) n
      }) n
  };
\definition law: \forall (z: I.Int^) -> Natural.Le three (Signed.absolute z) -> ranks z = zero :=
  \induction (z: I.Int^) \return Natural.Le three (Signed.absolute z) -> ranks z = zero \with {
    | ofNat: positive | negSucc: \fun (n: N.Nat^)(bound: _) => \refl(zero)
  };
