\use std.Logic[].Equality[].eq_reason_in;
\definition law: \forall (y: Target.Carrier (N.Nat^::succ n)) -> (native.differential).apply n ((backwardDegree (N.Nat^::succ n)).apply y) = (backwardDegree n).apply ((targetComplex.differential).apply n y) :=
  \fun (y: Target.Carrier (N.Nat^::succ n)) => eq_reason_in!{{native.family.Carrier n} _
    "=" _ "by" { sym!{{native.family.Carrier n}} _ _ (leftInverse n ((native.differential).apply n ((backwardDegree (N.Nat^::succ n)).apply y))) }
    "=" _ "by" { congr!{{Target.Carrier n} {native.family.Carrier n}} ((backwardDegree n).apply) _ _
        (eq_reason_in!{{ Target.Carrier n } _
          "=" _ "by" { sym!{{Target.Carrier n}} _ _ ((forward).commutes n ((backwardDegree (N.Nat^::succ n)).apply y)) }
          "=" _ "by" { congr!{{Target.Carrier (N.Nat^::succ n)} {Target.Carrier n}} ((targetComplex.differential).apply n) _ _ (projectionEquation (N.Nat^::succ n) y) }
          "=" _ "by" { (Corrected.map).commutes n y }
          "=" _ "by" { sym!{{Target.Carrier n}} _ _ (projectionEquation n ((targetComplex.differential).apply n y)) }
        }) }
    "=" _ "by" { leftInverse n ((backwardDegree n).apply ((targetComplex.differential).apply n y)) }
  };
