\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Zero[] \as Zero;
\import \parent.\parent.One[] \as Maps;
\import \parent.\parent.Degree[n := one] \as Degree;
\import \parent.\parent.Degree[n := zero] \as DegreeZero;
\import \parent.\parent.Group[W := Target.Carrier one, target := Target.space one] \as Algebra;
\import Modules.Laws[V := Target.Carrier one, space := Target.space one] \as Values;
\import algebra.Group[].Of[Carrier := Target.Carrier one, group := Values.additive] \as Group;
\import Modules.Hom[V := Target.Carrier zero, W := Target.Carrier one, source := Target.space zero, target := Target.space one] \as H0;
\import Modules.Hom[V := Target.Carrier two, W := Target.Carrier one, source := Target.space two, target := Target.space one] \as Boundaries;
\definition h0[e: Edge]: (Zero.homotopy).apply ((targetComplex.differential).apply zero (edge e)) =
  Group.difference (Zero.homotopyValues (target e)) (Zero.homotopyValues (source e)) :=
  eq_reason_in!{{Target.Carrier one} _
    "=" _ "by" { congr!{{Target.Carrier zero} {Target.Carrier one}} ((Zero.homotopy).apply) _ _ (Model.Boundaries[].edgeBoundary e) }
    "=" _ "by" { H0.differencePreserved Zero.homotopy (vertex (target e)) (vertex (source e)) }
    "=" _ "by" { congr!{{Target.Carrier one} {Target.Carrier one} {Target.Carrier one}} Group.difference _ _ _ _ (Zero.homotopyOnGenerator (target e)) (Zero.homotopyOnGenerator (source e)) }
  };
\definition h0Loop: (Zero.homotopy).apply ((targetComplex.differential).apply zero (edge Edge::loop)) = Values.zero :=
  trans!{{Target.Carrier one}} _ _ _ (h0 Edge::loop) (Group.inverseRight Values.zero);
\definition h0Arc[e: Edge][same: source e = Vertex::center]: (Zero.homotopy).apply ((targetComplex.differential).apply zero (edge e)) = edge Edge::first :=
  eq_reason_in!{{Target.Carrier one} _
    "=" _ "by" { h0 e }
    "=" _ "by" { congr!{Vertex {Target.Carrier one}} (\fun (v: Vertex) => Group.difference Values.zero (Zero.homotopyValues v)) _ _ same }
    "=" _ "by" { congr!{{Target.Carrier one} {Target.Carrier one}} (Values.add Values.zero) _ _ (Group.negNeg (edge Edge::first)) }
    "=" _ "by" { Group.zeroLeft (edge Edge::first) }
  };
\definition d0[e: Edge][zero: Maps.homotopyValues e = (Target.space two).zero]:
  (targetComplex.differential).apply one ((Maps.homotopy).apply (edge e)) = Values.zero :=
  trans!{{Target.Carrier one}} _ _ _
    (congr!{{Target.Carrier two} {Target.Carrier one}} ((targetComplex.differential).apply one) _ _ (trans!{{Target.Carrier two}} _ _ _ (Maps.homotopyOnGenerator e) zero))
    (Boundaries.zeroPreserved Degree.differential);
\definition dSecond: (targetComplex.differential).apply one ((Maps.homotopy).apply (edge Edge::second)) =
  Values.neg (Values.add (Group.difference (edge Edge::loop) (edge Edge::second)) (edge Edge::first)) :=
  eq_reason_in!{{Target.Carrier one} _
    "=" _ "by" { congr!{{Target.Carrier two} {Target.Carrier one}} ((targetComplex.differential).apply one) _ _ (Maps.homotopyOnGenerator Edge::second) }
    "=" _ "by" { Boundaries.negativePreserved Degree.differential (triangle Triangle::upper) }
    "=" _ "by" { congr!{{Target.Carrier one} {Target.Carrier one}} Values.neg _ _ (Model.Boundaries[].triangleBoundary Triangle::upper) }
  };
\definition defectLoop: (Corrected.boundary).apply one (edge Edge::loop) = Values.zero :=
  trans!{{Target.Carrier one}} _ _ _
    (congr!{{Target.Carrier one} {Target.Carrier one} {Target.Carrier one}} Values.add _ _ _ _ (d0 Edge::loop (\refl((Target.space two).zero))) h0Loop)
    (Group.zeroLeft Values.zero);
\definition defectFirst: (Corrected.boundary).apply one (edge Edge::first) = edge Edge::first :=
  trans!{{Target.Carrier one}} _ _ _
    (congr!{{Target.Carrier one} {Target.Carrier one} {Target.Carrier one}} Values.add _ _ _ _ (d0 Edge::first (\refl((Target.space two).zero))) (h0Arc Edge::first (\refl(Vertex::center))))
    (Group.zeroLeft (edge Edge::first));
\definition defectSecond: (Corrected.boundary).apply one (edge Edge::second) = Group.difference (edge Edge::second) (edge Edge::loop) :=
  trans!{{Target.Carrier one}} _ _ _
    (congr!{{Target.Carrier one} {Target.Carrier one} {Target.Carrier one}} Values.add _ _ _ _ dSecond (h0Arc Edge::second (\refl(Vertex::center))))
    (Algebra.removeLast (edge Edge::loop) (edge Edge::first) (edge Edge::second));
\definition corrected[e: Edge]: (Corrected.map).apply one (edge e) = (Maps.forward).apply (Maps.backwardValues e) :=
  (\induction (e: Edge) \return (Corrected.map).apply one (edge e) = (Maps.forward).apply (Maps.backwardValues e) \with {
    | loop: eq_reason_in!{{Target.Carrier one} _
      "=" _ "by" { congr!{{Target.Carrier one} {Target.Carrier one}} (Group.difference (edge Edge::loop)) _ _ defectLoop }
      "=" _ "by" { congr!{{Target.Carrier one} {Target.Carrier one}} (Values.add (edge Edge::loop)) _ _ Group.negZero }
      "=" _ "by" { Group.zeroRight (edge Edge::loop) }
      "=" _ "by" { sym!{{Target.Carrier one}} _ _ Maps.forwardUnit }
    }
    | first: eq_reason_in!{{Target.Carrier one} _
      "=" _ "by" { congr!{{Target.Carrier one} {Target.Carrier one}} (Group.difference (edge Edge::first)) _ _ defectFirst }
      "=" _ "by" { Group.inverseRight (edge Edge::first) }
      "=" _ "by" { sym!{{Target.Carrier one}} _ _ (Modules.Hom[V := native.family.Carrier one, W := Target.Carrier one, source := native.family.space one, target := Target.space one].zeroPreserved Maps.forward) }
    }
    | second: eq_reason_in!{{Target.Carrier one} _
      "=" _ "by" { congr!{{Target.Carrier one} {Target.Carrier one}} (Group.difference (edge Edge::second)) _ _ defectSecond }
      "=" _ "by" { Group.subtractDifference (edge Edge::second) (edge Edge::loop) }
      "=" _ "by" { sym!{{Target.Carrier one}} _ _ Maps.forwardUnit }
    }
  }) e;
\import Native.Map[C := targetComplex, D := targetComplex].At[n := one] \as CorrectedAt;
\import Model.Coefficients[A := targetBundle one].DegreeOne[] \as Ext;
\definition equation: Degree.right = CorrectedAt.linear Corrected.map := Ext.injective Degree.right (CorrectedAt.linear Corrected.map)
  (\axiom:funext((\fun (x: Edge) => (Degree.right).apply (edge x)), (\fun (x: Edge) => (Corrected.map).apply one (edge x)), \fun (e: Edge) => trans!{{Target.Carrier one}} _ _ _
    (congr!{{native.family.Carrier one} {Target.Carrier one}} ((Maps.forward).apply) _ _ (Maps.backwardOnGenerator e)) (sym!{{Target.Carrier one}} _ _ (corrected e))));
\definition law: Equation one := \fun (y: Target.Carrier one) => congr!{{Modules.Hom[V := Target.Carrier one, W := Target.Carrier one, source := Target.space one, target := Target.space one].Map} {Target.Carrier one}}
  (\fun (f: Modules.Hom[V := Target.Carrier one, W := Target.Carrier one, source := Target.space one, target := Target.space one].Map) => (f).apply y) _ _ equation;
