\use std.Logic[].Equality[].eq_reason_in;
\definition degree: N.Nat^ := N.Nat^::succ (N.Nat^::succ n);
\import \parent.Degree[n := degree] \as Degree;
\import Modules.Hom[V := native.family.Carrier (N.Nat^::succ degree), W := Target.Carrier degree, source := native.family.space (N.Nat^::succ degree), target := Target.space degree] \as Maps;
\definition forwardEquation: \forall (x: native.family.Carrier (N.Nat^::succ degree)) -> (Degree.first).apply x = (Degree.second).apply x :=
  \fun (x: native.family.Carrier (N.Nat^::succ degree)) => eq_reason_in!{{Target.Carrier degree} _
    "=" _ "by" { congr!{{native.family.Carrier (N.Nat^::succ degree)} {Target.Carrier degree}} ((Degree.first).apply) _ _ (\parent.Higher[n := n].sourceZero x) }
    "=" _ "by" { Maps.zeroPreserved Degree.first }
    "=" _ "by" { sym!{{Target.Carrier degree}} _ _ (Maps.zeroPreserved Degree.second) }
    "=" _ "by" { congr!{{native.family.Carrier (N.Nat^::succ degree)} {Target.Carrier degree}} ((Degree.second).apply) _ _ (sym!{{native.family.Carrier (N.Nat^::succ degree)}} _ _ (\parent.Higher[n := n].sourceZero x)) }
  };
