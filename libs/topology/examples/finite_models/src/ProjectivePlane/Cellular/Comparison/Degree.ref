\import Modules.Hom[V := Target.Carrier (N.Nat^::succ n), W := Target.Carrier n, source := Target.space (N.Nat^::succ n), target := Target.space n] \as Differential;
\definition differential: Differential.Map := Differential.Map { apply := (targetComplex.differential).apply n, addition := (targetComplex.laws).addition n, scalar := (targetComplex.laws).scalar n };
\import Differential.Composition[U := native.family.Carrier (N.Nat^::succ n), domain := native.family.space (N.Nat^::succ n)] \as First;
\import Modules.Hom[V := native.family.Carrier (N.Nat^::succ n), W := native.family.Carrier n, source := native.family.space (N.Nat^::succ n), target := native.family.space n] \as SourceDifferential;
\definition sourceDifferential: SourceDifferential.Map := SourceDifferential.Map { apply := (native.differential).apply n, addition := (native.laws).addition n, scalar := (native.laws).scalar n };
\import Modules.Hom[V := native.family.Carrier n, W := Target.Carrier n, source := native.family.space n, target := Target.space n].Composition[U := native.family.Carrier (N.Nat^::succ n), domain := native.family.space (N.Nat^::succ n)] \as Second;
\definition first: Modules.Hom[V := native.family.Carrier (N.Nat^::succ n), W := Target.Carrier n, source := native.family.space (N.Nat^::succ n), target := Target.space n].Map := First.compose differential (forwardDegree (N.Nat^::succ n));
\definition second: Modules.Hom[V := native.family.Carrier (N.Nat^::succ n), W := Target.Carrier n, source := native.family.space (N.Nat^::succ n), target := Target.space n].Map := Second.compose (forwardDegree n) sourceDifferential;

\import Modules.Hom[V := Target.Carrier n, W := native.family.Carrier n, source := Target.space n, target := native.family.space n].Composition[U := native.family.Carrier n, domain := native.family.space n] \as LeftComposition;
\definition left: Modules.Hom[V := native.family.Carrier n, W := native.family.Carrier n, source := native.family.space n, target := native.family.space n].Map := LeftComposition.compose (backwardDegree n) (forwardDegree n);
\import Modules.Hom[V := native.family.Carrier n, W := Target.Carrier n, source := native.family.space n, target := Target.space n].Composition[U := Target.Carrier n, domain := Target.space n] \as RightComposition;
\definition right: Modules.Hom[V := Target.Carrier n, W := Target.Carrier n, source := Target.space n, target := Target.space n].Map := RightComposition.compose (forwardDegree n) (backwardDegree n);
