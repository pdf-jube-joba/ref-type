\definition degree: N.Nat^ := one;
\definition value: Target.Carrier degree := edge Edge::loop;
\import Modules.Hom[V := native.family.Carrier degree, W := Target.Carrier degree, source := native.family.space degree, target := Target.space degree] \as ForwardLinear;
\definition forward: ForwardLinear.Map := ForwardLinear.Map {
  apply := \fun (x: native.family.Carrier degree) => (Target.space degree).smul (x (Fin.zero zero)) value,
  addition := \fun (x, y: native.family.Carrier degree) => (Target.space degree).scalarAdd (x (Fin.zero zero)) (y (Fin.zero zero)) value,
  scalar := \fun (a: I.Int^)(x: native.family.Carrier degree) => (Target.space degree).scalarAssoc a (x (Fin.zero zero)) value,
};
\import Model.Coefficients[A := sourceBundle degree] \as BackwardExtension;
\definition backwardValues: Edge -> native.family.Carrier degree := \induction (e: Edge) \return native.family.Carrier one \with {
  | loop: \fun (i: Fin.Fin one) => I.One.specification
  | first: \fun (i: Fin.Fin one) => I.Zero.specification
  | second: \fun (i: Fin.Fin one) => I.One.specification
};
\definition backward: Modules.MapBetween (targetBundle degree) (sourceBundle degree) := BackwardExtension.DegreeOne[].extend backwardValues;
\definition backwardOnGenerator: \forall (x: Edge) -> (backward).apply (edge x) = backwardValues x := BackwardExtension.DegreeOne[].onGenerator backwardValues;
\import Model.Coefficients[A := targetBundle two] \as HomotopyExtension;
\definition homotopyValues: Edge -> Target.Carrier two := \induction (e: Edge) \return Target.Carrier two \with {
  | loop: (Target.space two).zero
  | first: (Target.space two).zero
  | second: (Target.space two).neg (triangle Triangle::upper)
};
\definition homotopy: Modules.MapBetween (targetBundle degree) (targetBundle two) := HomotopyExtension.DegreeOne[].extend homotopyValues;
\definition homotopyOnGenerator: \forall (x: Edge) -> (homotopy).apply (edge x) = homotopyValues x := HomotopyExtension.DegreeOne[].onGenerator homotopyValues;

\definition unit: native.family.Carrier degree := \fun (i: Fin.Fin one) => I.One.specification;
\definition forwardUnit: (forward).apply unit = value := (Target.space degree).scalarOne value;
