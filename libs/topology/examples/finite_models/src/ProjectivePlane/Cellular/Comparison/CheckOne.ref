\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Degree[n := one] \as Degree;
\import \parent.Line[W := Target.Carrier one, target := Target.space one] \as Line;
\import \parent.Group[W := Target.Carrier one, target := Target.space one] \as Group;
\import Modules.Laws[V := Target.Carrier one, space := Target.space one] \as Values;
\definition firstUnit: (Degree.first).apply Line.unit = (Target.space one).smul (I.Int^::ofNat two) (edge Edge::loop) :=
  eq_reason_in!{{Target.Carrier one} _
    "=" _ "by" { congr!{{Target.Carrier two} {Target.Carrier one}} ((targetComplex.differential).apply one) _ _ (\parent.Two[].forwardUnit) }
    "=" _ "by" { (\parent.Degree[n := one].differential).addition (triangle Triangle::upper) (triangle Triangle::lower) }
    "=" _ "by" { congr!{{Target.Carrier one} {Target.Carrier one} {Target.Carrier one}} Values.add _ _ _ _
          (Model.Boundaries[].triangleBoundary Triangle::upper) (Model.Boundaries[].triangleBoundary Triangle::lower) }
    "=" _ "by" { Group.paired (edge Edge::loop) (edge Edge::first) (edge Edge::second) }
    "=" _ "by" { sym!{{Target.Carrier one}} _ _ (Group.twice (edge Edge::loop)) }
  };
\definition secondUnit: (Degree.second).apply Line.unit = (Target.space one).smul (I.Int^::ofNat two) (edge Edge::loop) :=
  congr!{{native.family.Carrier one} {Target.Carrier one}} ((forwardDegree one).apply) _ _ (\parent.Differentials[].doubleUnit);
\definition forwardEquation: Degree.first = Degree.second := Line.ext _ _ (trans!{{Target.Carrier one}} _ _ _ firstUnit (sym!{{Target.Carrier one}} _ _ secondUnit));
\import \parent.Degree[n := one] \as Current;
\import \parent.Line[W := native.family.Carrier one, target := native.family.space one] \as SourceLine;
\definition leftUnit: (Current.left).apply SourceLine.unit = SourceLine.unit :=
  trans!{{native.family.Carrier one}} _ _ _
    (congr!{{Target.Carrier one} {native.family.Carrier one}} ((backwardDegree one).apply) _ _ (\parent.One[].forwardUnit))
    (\parent.One[].backwardOnGenerator Edge::loop);
\definition leftEquation: Current.left = Modules.End[V := native.family.Carrier one, space := native.family.space one].identity := SourceLine.ext _ _ leftUnit;
