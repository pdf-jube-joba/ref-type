\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.One[] \as H;
\import \parent.\parent.Two[] \as Maps;
\import \parent.\parent.Degree[n := two] \as Degree;
\import Modules.Laws[V := Target.Carrier two, space := Target.space two] \as Values;
\import algebra.Group[].Of[Carrier := Target.Carrier two, group := Values.additive] \as Group;
\import Modules.Hom[V := Target.Carrier one, W := Target.Carrier two, source := Target.space one, target := Target.space two] \as H1;
\import Modules.Hom[V := Target.Carrier three, W := Target.Carrier two, source := Target.space three, target := Target.space two] \as Boundaries;
\definition image[t: Triangle]: (H.homotopy).apply ((targetComplex.differential).apply one (triangle t)) =
  Values.add (Group.difference (H.homotopyValues (back t)) (H.homotopyValues (diagonal t))) (H.homotopyValues (front t)) :=
  eq_reason_in!{{Target.Carrier two} _
    "=" _ "by" { congr!{{Target.Carrier one} {Target.Carrier two}} ((H.homotopy).apply) _ _ (Model.Boundaries[].triangleBoundary t) }
    "=" _ "by" { (H.homotopy).addition ((Target.space one).add (edge (back t)) ((Target.space one).neg (edge (diagonal t)))) (edge (front t)) }
    "=" _ "by" { congr!{{Target.Carrier two} {Target.Carrier two} {Target.Carrier two}} Values.add _ _ _ _
        (trans!{{Target.Carrier two}} _ _ _ (H1.differencePreserved H.homotopy (edge (back t)) (edge (diagonal t)))
          (congr!{{Target.Carrier two} {Target.Carrier two} {Target.Carrier two}} Group.difference _ _ _ _ (H.homotopyOnGenerator (back t)) (H.homotopyOnGenerator (diagonal t))))
        (H.homotopyOnGenerator (front t)) }
  };
\definition imageUpper: (H.homotopy).apply ((targetComplex.differential).apply one (triangle Triangle::upper)) = triangle Triangle::upper :=
  eq_reason_in!{{Target.Carrier two} _
    "=" _ "by" { image Triangle::upper }
    "=" _ "by" { congr!{{Target.Carrier two} {Target.Carrier two}} (\fun (x: Target.Carrier two) => Values.add (Values.add Values.zero x) Values.zero) _ _ (Group.negNeg (triangle Triangle::upper)) }
    "=" _ "by" { Group.zeroRight (Values.add Values.zero (triangle Triangle::upper)) }
    "=" _ "by" { Group.zeroLeft (triangle Triangle::upper) }
  };
\definition imageLower: (H.homotopy).apply ((targetComplex.differential).apply one (triangle Triangle::lower)) = Values.neg (triangle Triangle::upper) :=
  eq_reason_in!{{Target.Carrier two} _
    "=" _ "by" { image Triangle::lower }
    "=" _ "by" { congr!{{Target.Carrier two} {Target.Carrier two}} (\fun (x: Target.Carrier two) => Values.add (Values.add Values.zero x) (Values.neg (triangle Triangle::upper))) _ _ Group.negZero }
    "=" _ "by" { congr!{{Target.Carrier two} {Target.Carrier two}} (\fun (x: Target.Carrier two) => Values.add x (Values.neg (triangle Triangle::upper))) _ _ (Group.zeroLeft Values.zero) }
    "=" _ "by" { Group.zeroLeft (Values.neg (triangle Triangle::upper)) }
  };
\definition defect[t: Triangle]: (Corrected.boundary).apply two (triangle t) = (H.homotopy).apply ((targetComplex.differential).apply one (triangle t)) :=
  trans!{{Target.Carrier two}} _ _ _
    (congr!{{Target.Carrier two} {Target.Carrier two}} (\fun (x: Target.Carrier two) => Values.add x ((H.homotopy).apply ((targetComplex.differential).apply one (triangle t)))) _ _ (Boundaries.zeroPreserved Degree.differential))
    (Group.zeroLeft _);
\definition correctedUpper: (Corrected.map).apply two (triangle Triangle::upper) = Values.zero :=
  trans!{{Target.Carrier two}} _ _ _
    (congr!{{Target.Carrier two} {Target.Carrier two}} (Group.difference (triangle Triangle::upper)) _ _
      (trans!{{Target.Carrier two}} _ _ _ (defect Triangle::upper) imageUpper))
    (Group.inverseRight (triangle Triangle::upper));
\definition correctedLower: (Corrected.map).apply two (triangle Triangle::lower) = Maps.value :=
  eq_reason_in!{{Target.Carrier two} _
    "=" _ "by" { congr!{{Target.Carrier two} {Target.Carrier two}} (Group.difference (triangle Triangle::lower)) _ _
      (trans!{{Target.Carrier two}} _ _ _ (defect Triangle::lower) imageLower) }
    "=" _ "by" { congr!{{Target.Carrier two} {Target.Carrier two}} (Values.add (triangle Triangle::lower)) _ _ (Group.negNeg (triangle Triangle::upper)) }
    "=" _ "by" { Group.comm (triangle Triangle::lower) (triangle Triangle::upper) }
  };
\import Native.Map[C := targetComplex, D := targetComplex].At[n := two] \as CorrectedAt;
\import Model.Coefficients[A := targetBundle two].DegreeTwo[] \as Ext;
\import Modules.Hom[V := native.family.Carrier two, W := Target.Carrier two, source := native.family.space two, target := Target.space two] \as ForwardLinear;
\definition equation: Degree.right = CorrectedAt.linear Corrected.map := Ext.injective Degree.right (CorrectedAt.linear Corrected.map)
  (\axiom:funext((\fun (x: Triangle) => (Degree.right).apply (triangle x)), (\fun (x: Triangle) => (Corrected.map).apply two (triangle x)), \induction (t: Triangle) \return (Degree.right).apply (triangle t) = (Corrected.map).apply two (triangle t) \with {
    | upper: eq_reason_in!{{Target.Carrier two} _
      "=" _ "by" { congr!{{native.family.Carrier two} {Target.Carrier two}} ((Maps.forward).apply) _ _ (Maps.backwardOnGenerator Triangle::upper) }
      "=" _ "by" { ForwardLinear.zeroPreserved Maps.forward }
      "=" _ "by" { sym!{{Target.Carrier two}} _ _ correctedUpper }
    }
    | lower: eq_reason_in!{{Target.Carrier two} _
      "=" _ "by" { congr!{{native.family.Carrier two} {Target.Carrier two}} ((Maps.forward).apply) _ _ (Maps.backwardOnGenerator Triangle::lower) }
      "=" _ "by" Maps.forwardUnit
      "=" _ "by" { sym!{{Target.Carrier two}} _ _ correctedLower }
    }
  }));
\definition law: Equation two := \fun (y: Target.Carrier two) => congr!{{Modules.Hom[V := Target.Carrier two, W := Target.Carrier two, source := Target.space two, target := Target.space two].Map} {Target.Carrier two}}
  (\fun (f: Modules.Hom[V := Target.Carrier two, W := Target.Carrier two, source := Target.space two, target := Target.space two].Map) => (f).apply y) _ _ equation;
