\definition degree: N.Nat^ := N.Nat^::succ (N.Nat^::succ (N.Nat^::succ k));
\definition law: Equation degree := \fun (y: Target.Carrier degree) => trans!{{Target.Carrier degree}} _ _ _
  (\parent.\parent.Higher[n := k].targetZero ((forwardDegree degree).apply ((backwardDegree degree).apply y)))
  (sym!{{Target.Carrier degree}} _ _ (\parent.\parent.Higher[n := k].targetZero ((Corrected.map).apply degree y)));
