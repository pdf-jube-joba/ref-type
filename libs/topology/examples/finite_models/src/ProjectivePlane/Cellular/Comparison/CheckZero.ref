\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Degree[n := zero] \as Degree;
\import \parent.Line[W := Target.Carrier zero, target := Target.space zero] \as Line;
\import \parent.Group[W := Target.Carrier zero, target := Target.space zero] \as Group;
\import Modules.Laws[V := Target.Carrier zero, space := Target.space zero] \as Values;
\definition firstUnit: (Degree.first).apply Line.unit = (Target.space zero).zero :=
  eq_reason_in!{{Target.Carrier zero} _
    "=" _ "by" { congr!{{Target.Carrier one} {Target.Carrier zero}} ((targetComplex.differential).apply zero) _ _ (\parent.One[].forwardUnit) }
    "=" _ "by" { Model.Boundaries[].edgeBoundary Edge::loop }
    "=" _ "by" { Group.inverseRight (vertex Vertex::rim) }
  };
\definition secondUnit: (Degree.second).apply Line.unit = (Target.space zero).zero :=
  trans!{{Target.Carrier zero}} _ _ _
    (congr!{{native.family.Carrier zero} {Target.Carrier zero}} ((forwardDegree zero).apply) _ _ (\parent.Differentials[].zeroBoundary Line.unit))
    (Modules.Hom[V := native.family.Carrier zero, W := Target.Carrier zero, source := native.family.space zero, target := Target.space zero].zeroPreserved (forwardDegree zero));
\definition forwardEquation: Degree.first = Degree.second := Line.ext _ _ (trans!{{Target.Carrier zero}} _ _ _ firstUnit (sym!{{Target.Carrier zero}} _ _ secondUnit));
\import \parent.Degree[n := zero] \as Current;
\import \parent.Line[W := native.family.Carrier zero, target := native.family.space zero] \as SourceLine;
\definition leftUnit: (Current.left).apply SourceLine.unit = SourceLine.unit :=
  trans!{{native.family.Carrier zero}} _ _ _
    (congr!{{Target.Carrier zero} {native.family.Carrier zero}} ((backwardDegree zero).apply) _ _ (\parent.Zero[].forwardUnit))
    (\parent.Zero[].backwardOnGenerator Vertex::rim);
\definition leftEquation: Current.left = Modules.End[V := native.family.Carrier zero, space := native.family.space zero].identity := SourceLine.ext _ _ leftUnit;
