\use std.Logic[].Equality[].eq_reason_in;
\import Modules.FiniteCoordinates[n := one] \as Coordinates;
\import Modules.Hom[V := Coordinates.Carrier, W := W, source := Coordinates.space, target := target] \as Maps;
\definition unit: Coordinates.Carrier := \fun (i: Fin.Fin one) => I.One.specification;
\definition reconstruction[x: Coordinates.Carrier]: (Coordinates.space).smul (x (Fin.zero zero)) unit = x :=
  \axiom:funext((Coordinates.space).smul (x (Fin.zero zero)) unit, x, \fun (i: Fin.Fin one) => trans!{I.Int^} _ _ _
    ((((IntegerRing.ring).semiring).multiplicative).rightIdentity (x (Fin.zero zero)))
    (congr!{{Fin.Fin one} I.Int^} x _ _ (sym!{{Fin.Fin one}} _ _ (Fin.singletonValue i))));
\definition ext[f, g: Maps.Map][same: (f).apply unit = (g).apply unit]: f = g := Maps.ext f g
  (\fun (x: Coordinates.Carrier) => eq_reason_in!{W _
    "=" _ "by" { congr!{Coordinates.Carrier W} ((f).apply) _ _ (sym!{Coordinates.Carrier} _ _ (reconstruction x)) }
    "=" _ "by" { (f).scalar (x (Fin.zero zero)) unit }
    "=" _ "by" { congr!{W W} ((target).smul (x (Fin.zero zero))) _ _ same }
    "=" _ "by" { sym!{W} _ _ ((g).scalar (x (Fin.zero zero)) unit) }
    "=" _ "by" { congr!{Coordinates.Carrier W} ((g).apply) _ _ (reconstruction x) }
  });
