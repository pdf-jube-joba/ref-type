\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Degree[n := two] \as Degree;
\import \parent.Line[W := native.family.Carrier two, target := native.family.space two] \as Line;
\import Modules.Laws[V := native.family.Carrier two, space := native.family.space two] \as Values;
\definition leftUnit: (Degree.left).apply Line.unit = Line.unit :=
  eq_reason_in!{{native.family.Carrier two} _
    "=" _ "by" { congr!{{Target.Carrier two} {native.family.Carrier two}} ((backwardDegree two).apply) _ _ (\parent.Two[].forwardUnit) }
    "=" _ "by" { (backwardDegree two).addition (triangle Triangle::upper) (triangle Triangle::lower) }
    "=" _ "by" { congr!{{native.family.Carrier two} {native.family.Carrier two} {native.family.Carrier two}} Values.add _ _ _ _
          (\parent.Two[].backwardOnGenerator Triangle::upper) (\parent.Two[].backwardOnGenerator Triangle::lower) }
    "=" _ "by" { Values.zeroLeft Line.unit }
  };
\definition leftEquation: Degree.left = Modules.End[V := native.family.Carrier two, space := native.family.space two].identity := Line.ext _ _ leftUnit;
