\definition positive: \forall (n: N.Nat^)(v: Vector (I.Int^::ofNat n)) ->
  differential (Bounded.previous (I.Int^::ofNat n)) (differential (I.Int^::ofNat n) v) = (space (Bounded.previous (Bounded.previous (I.Int^::ofNat n)))).zero :=
  \induction (n: N.Nat^) \return \forall (v: Vector (I.Int^::ofNat n)) ->
    differential (Bounded.previous (I.Int^::ofNat n)) (differential (I.Int^::ofNat n) v) = (space (Bounded.previous (Bounded.previous (I.Int^::ofNat n)))).zero \with {
      | zero: \fun (v: Vector (I.Int^::ofNat zero)) => Commutative.Matrix[m := zero, n := zero].zeroAction (differential (I.Int^::ofNat zero) v)
      | succ: \fun (n: N.Nat^)(previous: _) =>
        (\induction (n: N.Nat^) \return \forall (v: Vector (I.Int^::ofNat (N.Nat^::succ n))) ->
          differential (Bounded.previous (I.Int^::ofNat (N.Nat^::succ n))) (differential (I.Int^::ofNat (N.Nat^::succ n)) v) = (space (Bounded.previous (Bounded.previous (I.Int^::ofNat (N.Nat^::succ n))))).zero \with {
            | zero: \fun (v: Vector (I.Int^::ofNat one)) => Commutative.Matrix[m := zero, n := one].zeroAction (differential (I.Int^::ofNat one) v)
            | succ: \fun (n: N.Nat^)(previous: _) =>
              (\induction (n: N.Nat^) \return \forall (v: Vector (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n)))) ->
                differential (Bounded.previous (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n)))) (differential (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n))) v) = (space (Bounded.previous (Bounded.previous (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ n)))))).zero \with {
                  | zero: \fun (v: Vector (I.Int^::ofNat two)) => Commutative.Matrix[m := one, n := one].zeroAction (differential (I.Int^::ofNat two) v)
                  | succ: \fun (n: N.Nat^)(previous: _)(v: Vector (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))))) =>
                    trans!{{Vector (Bounded.previous (Bounded.previous (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))))))}} _ _ _
                      (congr!{{Vector (Bounded.previous (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))))} {Vector (Bounded.previous (Bounded.previous (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))))))}}
                        (differential (Bounded.previous (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n)))))) _ _
                        (Commutative.Matrix[m := ranks (Bounded.previous (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))))), n := zero].zeroAction v))
                      (zeroInput (Bounded.previous (I.Int^::ofNat (N.Nat^::succ (N.Nat^::succ (N.Nat^::succ n))))))
                }) n
          }) n
    };
\definition law: \forall (z: I.Int^)(v: Vector z) -> differential (Bounded.previous z) (differential z v) = (space (Bounded.previous (Bounded.previous z))).zero :=
  \induction (z: I.Int^) \return \forall (v: Vector z) -> differential (Bounded.previous z) (differential z v) = (space (Bounded.previous (Bounded.previous z))).zero \with {
    | ofNat: positive
    | negSucc: \fun (n: N.Nat^)(v: Vector (I.Int^::negSucc n)) => Commutative.Matrix[m := zero, n := zero].zeroAction (differential (I.Int^::negSucc n) v)
  };
