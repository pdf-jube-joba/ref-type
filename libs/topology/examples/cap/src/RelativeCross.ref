\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import singular_cap.ExternalIntegral[A := A, B := B, left := left, right := right, leftSubset := leftSubset, rightSubset := rightSubset] \as External;
\import External.Cross[].Homology[].ZeroZero[].Descent[] \as Product;
\import singular_cohomology.Relative[A := A, source := left, subset := leftSubset] \as Left;
\import singular_cohomology.Relative[A := B, source := right, subset := rightSubset] \as Right;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import Complexes.At[C := Left.complex, z := I.Int^::ofNat N.Nat^::zero] \as L;
\import Complexes.At[C := Right.complex, z := I.Int^::ofNat N.Nat^::zero] \as R;
\definition multiply[x: L.Homology][y: R.Homology]: _ := Product.apply x y;
\definition represented[x: L.Cycle][y: R.Cycle]: _ := Product.onClasses x y;
\import singular_cohomology.Identity[A := A, source := left] \as LeftIdentity;
\import singular_cohomology.Identity[A := B, source := right] \as RightIdentity;
\import Left.Maps[B := A].Over[target := left, targetSubset := leftSubset] \as LeftMaps;
\import Right.Maps[B := B].Over[target := right, targetSubset := rightSubset] \as RightMaps;
\definition leftIdentity: LeftMaps.Map := \into[A -> A](LeftIdentity.function, { f: A -> A \where LeftMaps.Laws[f] }) \by {
  LeftMaps.Laws[LeftIdentity.function] { continuous := LeftIdentity.continuous, contained := \fun (x: Left.SubspaceCarrier) => \bysub(A, leftSubset, x) }
};
\definition rightIdentity: RightMaps.Map := \into[B -> B](RightIdentity.function, { f: B -> B \where RightMaps.Laws[f] }) \by {
  RightMaps.Laws[RightIdentity.function] { continuous := RightIdentity.continuous, contained := \fun (x: Right.SubspaceCarrier) => \bysub(B, rightSubset, x) }
};
\import External.Cross[].Natural[C := A, D := B, leftTarget := left, rightTarget := right, leftTargetSubset := leftSubset, rightTargetSubset := rightSubset].On[f := leftIdentity, g := rightIdentity].ProjectionZeroZero[] \as Projection;
\definition projectionFormula: _ := Projection.law;
\import External.Cross[].Natural[C := A, D := B, leftTarget := left, rightTarget := right, leftTargetSubset := leftSubset, rightTargetSubset := rightSubset].On[f := leftIdentity, g := rightIdentity].ProjectionClasses[p := N.Nat^::succ N.Nat^::zero, q := N.Nat^::zero].CochainZero[a := N.Nat^::zero] \as GeneralProjection;
\definition projectionDifferentDegrees: _ := GeneralProjection.law (\refl(N.Nat^::succ N.Nat^::zero));
