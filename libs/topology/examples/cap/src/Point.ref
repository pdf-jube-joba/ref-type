\inductive Point: \Set := | point: Point;
\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import topology.Topology[Carrier := Point] \as Topology;
\import singular_cohomology.Chains[A := Point, source := Topology.Discrete] \as Chains;
\import singular_products.Cochains[A := Point, source := Topology.Discrete, R := I.Int^, ring := Integers.commutativeRing] \as Cochains;
\import singular_cap.Integral[A := Point, source := Topology.Discrete] \as Cap;
\module Unit(n: N.Nat^) {
  \import Cap.At[p := n, q := N.Nat^::zero] \as At;
  \import Cap.Unit[p := n] \as Unit;
  \definition law: \forall (x: Chains.Carrier n) -> (At.map Cochains.Unit[].cochain).apply x = x := Unit.law;
}
