  h0: Bundles.Family[X := X, F := H0].Bundle, h1: Bundles.Family[X := X, F := H1].Bundle,
  sameE1: e0.baseSpace = e1.baseSpace, sameF0: e0.baseSpace = f0.baseSpace,
  sameF1: e0.baseSpace = f1.baseSpace, sameH0: e0.baseSpace = h0.baseSpace, sameH1: e0.baseSpace = h1.baseSpace);
\module ComplexProductBlocks(X: \Set, F0, F1, G0, G1: X -> \Set,
  e0: Bundles.Family[X := X, F := F0].Bundle, e1: Bundles.Family[X := X, F := F1].Bundle,
  f0: Bundles.Family[X := X, F := G0].Bundle, f1: Bundles.Family[X := X, F := G1].Bundle,
  sameE1: e0.baseSpace = e1.baseSpace, sameF0: e0.baseSpace = f0.baseSpace, sameF1: e0.baseSpace = f1.baseSpace);
\module DirectSumIsomorphism(X: \Set, F, G: X -> \Set,
  left: Bundles.Family[X := X, F := F].Bundle, right: Bundles.Family[X := X, F := G].Bundle,
  sameBase: left.baseSpace = right.baseSpace,
  compact: topology.Topology[Carrier := X].IsCompact left.baseSpace,
  hausdorff: topology.Topology[Carrier := X].IsT2 left.baseSpace);

\module GradedStabilization(X: \Set, E0, E1, H: X -> \Set,
  even: Bundles.Family[X := X, F := E0].Bundle, odd: Bundles.Family[X := X, F := E1].Bundle,
  auxiliary: Bundles.Family[X := X, F := H].Bundle,
  sameOdd: even.baseSpace = odd.baseSpace, sameAuxiliary: even.baseSpace = auxiliary.baseSpace);

\module TensorNaturality(X: \Set, F, G, A, B: X -> \Set,
  first: Bundles.Family[X := X, F := F].Bundle, second: Bundles.Family[X := X, F := G].Bundle,
  newFirst: Bundles.Family[X := X, F := A].Bundle, newSecond: Bundles.Family[X := X, F := B].Bundle,
  sameSource: first.baseSpace = second.baseSpace, sameTarget: newFirst.baseSpace = newSecond.baseSpace,
  firstIso: Bundles.Isomorphisms[X := X, F := F, G := A, source := first, target := newFirst].Isomorphism,
  secondIso: Bundles.Isomorphisms[X := X, F := G, G := B, source := second, target := newSecond].Isomorphism);

\module ParityNaturality(X: \Set, E0, E1, F0, F1, A0, A1, B0, B1: X -> \Set,
  e0: Bundles.Family[X := X, F := E0].Bundle, e1: Bundles.Family[X := X, F := E1].Bundle,
  f0: Bundles.Family[X := X, F := F0].Bundle, f1: Bundles.Family[X := X, F := F1].Bundle,
  a0: Bundles.Family[X := X, F := A0].Bundle, a1: Bundles.Family[X := X, F := A1].Bundle,
  b0: Bundles.Family[X := X, F := B0].Bundle, b1: Bundles.Family[X := X, F := B1].Bundle,
  sameE1: e0.baseSpace = e1.baseSpace, sameF0: e0.baseSpace = f0.baseSpace, sameF1: e0.baseSpace = f1.baseSpace,
  sameA1: a0.baseSpace = a1.baseSpace, sameB0: a0.baseSpace = b0.baseSpace, sameB1: a0.baseSpace = b1.baseSpace,
  alpha0: Bundles.Isomorphisms[X := X, F := E0, G := A0, source := e0, target := a0].Isomorphism,
  alpha1: Bundles.Isomorphisms[X := X, F := E1, G := A1, source := e1, target := a1].Isomorphism,
  beta0: Bundles.Isomorphisms[X := X, F := F0, G := B0, source := f0, target := b0].Isomorphism,
  beta1: Bundles.Isomorphisms[X := X, F := F1, G := B1, source := f1, target := b1].Isomorphism);
\module ComplexProductParityPullback(X: \Set, F0, F1, G0, G1: X -> \Set,
  e0: Bundles.Family[X := X, F := F0].Bundle, e1: Bundles.Family[X := X, F := F1].Bundle,
  f0: Bundles.Family[X := X, F := G0].Bundle, f1: Bundles.Family[X := X, F := G1].Bundle,
  sameE1: e0.baseSpace = e1.baseSpace, sameF0: e0.baseSpace = f0.baseSpace, sameF1: e0.baseSpace = f1.baseSpace,
  Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  regular: topology.Continuity[A := Y, B := X].Continuous source e0.baseSpace f);

\module DecompositionChange(X: \Set, F, G, E, O, A, B: X -> \Set,
  sourceFull: Bundles.Family[X := X, F := F].Bundle, targetFull: Bundles.Family[X := X, F := G].Bundle,
  sourceEven: Bundles.Family[X := X, F := E].Bundle, sourceOdd: Bundles.Family[X := X, F := O].Bundle,
  targetEven: Bundles.Family[X := X, F := A].Bundle, targetOdd: Bundles.Family[X := X, F := B].Bundle,
  sameSource: sourceEven.baseSpace = sourceOdd.baseSpace, sameTarget: targetEven.baseSpace = targetOdd.baseSpace,
  sourceDecomposition: Bundles.Isomorphisms[X := X, F := F,
    G := Operations.DirectSum[X := X, F := E, G := O, left := sourceEven, right := sourceOdd].Fiber,
    source := sourceFull, target := Operations.DirectSum[X := X, F := E, G := O, left := sourceEven, right := sourceOdd].bundle sameSource].Isomorphism,
  targetDecomposition: Bundles.Isomorphisms[X := X, F := G,
    G := Operations.DirectSum[X := X, F := A, G := B, left := targetEven, right := targetOdd].Fiber,
    source := targetFull, target := Operations.DirectSum[X := X, F := A, G := B, left := targetEven, right := targetOdd].bundle sameTarget].Isomorphism,
  fullIso: Bundles.Isomorphisms[X := X, F := F, G := G, source := sourceFull, target := targetFull].Isomorphism,
  evenIso: Bundles.Isomorphisms[X := X, F := E, G := A, source := sourceEven, target := targetEven].Isomorphism,
  oddIso: Bundles.Isomorphisms[X := X, F := O, G := B, source := sourceOdd, target := targetOdd].Isomorphism,
  coherence: \forall (x: X)(v: F x) -> (targetDecomposition.forward.fiber x).apply ((fullIso.forward.fiber x).apply v) =
    std.Data[].Pair[].pair (A x) (B x)
      ((evenIso.forward.fiber x).apply (std.Data[].Pair[].first (E x) (O x) ((sourceDecomposition.forward.fiber x).apply v)))
      ((oddIso.forward.fiber x).apply (std.Data[].Pair[].second (E x) (O x) ((sourceDecomposition.forward.fiber x).apply v))));

\module TensorStabilization(X: \Set, E0, E1, F0, F1, H: X -> \Set,
  e0: Bundles.Family[X := X, F := E0].Bundle, e1: Bundles.Family[X := X, F := E1].Bundle,
  f0: Bundles.Family[X := X, F := F0].Bundle, f1: Bundles.Family[X := X, F := F1].Bundle,
  auxiliary: Bundles.Family[X := X, F := H].Bundle,
  sameE1: e0.baseSpace = e1.baseSpace, sameF0: e0.baseSpace = f0.baseSpace,
  sameF1: e0.baseSpace = f1.baseSpace, sameAuxiliary: e0.baseSpace = auxiliary.baseSpace);
\module TensorRightStabilization(X: \Set, E0, E1, F0, F1, H: X -> \Set,
  e0: Bundles.Family[X := X, F := E0].Bundle, e1: Bundles.Family[X := X, F := E1].Bundle,
  f0: Bundles.Family[X := X, F := F0].Bundle, f1: Bundles.Family[X := X, F := F1].Bundle,
  auxiliary: Bundles.Family[X := X, F := H].Bundle,
  sameE1: e0.baseSpace = e1.baseSpace, sameF0: e0.baseSpace = f0.baseSpace,
  sameF1: e0.baseSpace = f1.baseSpace, sameAuxiliary: e0.baseSpace = auxiliary.baseSpace);

\module ExteriorParityPullback(A, B, Y: \Set, F: A -> \Set, G: B -> \Set,
  left: Bundles.Family[X := A, F := F].Bundle, right: Bundles.Family[X := B, F := G].Bundle,
  firstSelection: \forall (k: N.Nat^) -> \root.Thom[].Koszul[X := A, F := F, bundle := left].Coordinates[].Choice k,
  secondSelection: \forall (k: N.Nat^) -> \root.Thom[].Koszul[X := B, F := G, bundle := right].Coordinates[].Choice k,
  source: topology.Topology[Carrier := Y].Topology,
  f: Y -> \root.Thom[].Koszul[X := A, F := F, bundle := left].Total,
  g: Y -> \root.Thom[].Koszul[X := B, F := G, bundle := right].Total,
  firstRegular: topology.Continuity[A := Y, B := \root.Thom[].Koszul[X := A, F := F, bundle := left].Total].Continuous source left.totalSpace f,
  secondRegular: topology.Continuity[A := Y, B := \root.Thom[].Koszul[X := B, F := G, bundle := right].Total].Continuous source right.totalSpace g);
\module ScalarCliffordClass(X: \Set, space: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact space,
  hausdorff: topology.Topology[Carrier := X].IsT2 space,
  subset: \Pow X, closed: topology.Topology[Carrier := X].IsClosedIn space subset,
  complex: Operations.Models[X := X, baseSpace := space].Chains[].Complex);

\module TensorOperatorAdditivity(X: \Set, F, G: X -> \Set,
  first: Bundles.Family[X := X, F := F].Bundle, second: Bundles.Family[X := X, F := G].Bundle,
  sameBase: first.baseSpace = second.baseSpace);

\module OddPairOperator(X: \Set, F, G: X -> \Set,
  first: Bundles.Family[X := X, F := F].Bundle, second: Bundles.Family[X := X, F := G].Bundle,
  sameBase: first.baseSpace = second.baseSpace);
