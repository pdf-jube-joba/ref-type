\definition kFixed[v: V]: Normal.k.apply v = c.k.apply v :=
  trans!{W} _ _ _ (sym!{W} _ _ (OddLaws.zeroLeft (Normal.k.apply v)))
    (trans!{W} _ _ _
      (congr!{W W} (\fun (w: W) => odd.add w (Normal.k.apply v)) _ _
        (sym!{W} _ _ (trans!{W} _ _ _ (congr!{V W} c.d.apply _ _ (hk v)) c.d.preservesZero)))
      (Normal.laws.odd (c.k.apply v)));
\definition hFixed[w: W]: Normal.h.apply w = c.h.apply w :=
  trans!{V} _ _ _ (sym!{V} _ _ (EvenLaws.zeroLeft (Normal.h.apply w)))
    (trans!{V} _ _ _
      (congr!{V V} (\fun (v: V) => even.add v (Normal.h.apply w)) _ _
        (sym!{V} _ _ (trans!{V} _ _ _ (congr!{W V} c.e.apply _ _ (kh w)) c.e.preservesZero)))
      (Normal.laws.even (c.h.apply w)));
\definition forward[t: C.Complex][v: V]: (\parent.At[t := t].forward).apply v = odd.add (c.d.apply v) (odd.smul t (c.k.apply v)) :=
  congr!{W W} (odd.add (c.d.apply v)) _ _ (congr!{W W} (odd.smul t) _ _ (kFixed v));
\definition backward[t: C.Complex][w: W]: (\parent.At[t := t].backward).apply w = even.add (c.e.apply w) (even.smul t (c.h.apply w)) :=
  congr!{V V} (even.add (c.e.apply w)) _ _ (congr!{V V} (even.smul t) _ _ (hFixed w));
