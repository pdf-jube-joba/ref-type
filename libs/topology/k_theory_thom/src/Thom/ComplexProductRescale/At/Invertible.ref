\definition inverse: Backward.Map := BackwardOperations.scale (Scalar.inv t) backward;
\definition leftInverse: \forall (v: V) -> inverse.apply (forward.apply v) = v :=
  \fun (v: V) => trans!{V} _ _ _ (congr!{V V} (even.smul (Scalar.inv t)) _ _ (left v))
    (trans!{V} _ _ _ (sym!{V} _ _ (even.scalarAssoc (Scalar.inv t) t v))
      (trans!{V} _ _ _ (congr!{{C.Complex} V} (\fun (a: C.Complex) => even.smul a v) _ _ (Scalars.inverseNonzero t nonzero)) (even.scalarOne v)));
\definition rightInverse: \forall (w: W) -> forward.apply (inverse.apply w) = w :=
  \fun (w: W) => trans!{W} _ _ _ (forward.preservesScale (Scalar.inv t) (backward.apply w))
    (trans!{W} _ _ _ (congr!{W W} (odd.smul (Scalar.inv t)) _ _ (right w))
      (trans!{W} _ _ _ (sym!{W} _ _ (odd.scalarAssoc (Scalar.inv t) t w))
        (trans!{W} _ _ _ (congr!{{C.Complex} W} (\fun (a: C.Complex) => odd.smul a w) _ _ (Scalars.inverseNonzero t nonzero)) (odd.scalarOne w))));
\definition isomorphism: Spaces.Isomorphism[V := V, W := W, source := even, target := odd].Isomorphism :=
  Spaces.Isomorphism[V := V, W := W, source := even, target := odd].Isomorphism {
    forward := forward, backward := inverse, leftInverse := leftInverse, rightInverse := rightInverse
  };
