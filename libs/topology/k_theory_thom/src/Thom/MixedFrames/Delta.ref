\definition left[i, j: Fin.Fin n]: TotalDelta.delta (Indices.left i) (Indices.left j) = FirstDelta.delta i j :=
  either!{{(Classical.excludedMiddle (i = j))} {TotalDelta.delta (Indices.left i) (Indices.left j) = FirstDelta.delta i j}
    {\fun (same: _) => trans!{{C.Complex}} _ _ _
      (TotalDelta.equal _ _ (congr!{{Fin.Fin n} {Fin.Fin Indices.total}} Indices.left _ _ same))
      (sym!{{C.Complex}} _ _ (FirstDelta.equal i j same))}
    {\fun (different: _) => trans!{{C.Complex}} _ _ _
      (TotalDelta.different _ _ (\fun (same: _) => different (Indices.leftInjective i j same)))
      (sym!{{C.Complex}} _ _ (FirstDelta.different i j different))}
  };
\definition right[i, j: Fin.Fin m]: TotalDelta.delta (Indices.right i) (Indices.right j) = SecondDelta.delta i j :=
  either!{{(Classical.excludedMiddle (i = j))} {TotalDelta.delta (Indices.right i) (Indices.right j) = SecondDelta.delta i j}
    {\fun (same: _) => trans!{{C.Complex}} _ _ _
      (TotalDelta.equal _ _ (congr!{{Fin.Fin m} {Fin.Fin Indices.total}} Indices.right _ _ same))
      (sym!{{C.Complex}} _ _ (SecondDelta.equal i j same))}
    {\fun (different: _) => trans!{{C.Complex}} _ _ _
      (TotalDelta.different _ _ (\fun (same: _) => different (Indices.rightInjective i j same)))
      (sym!{{C.Complex}} _ _ (SecondDelta.different i j different))}
  };
\definition leftRight[i: Fin.Fin n][j: Fin.Fin m]: TotalDelta.delta (Indices.left i) (Indices.right j) = Op.zero :=
  TotalDelta.different _ _ (Indices.different i j);
\definition rightLeft[i: Fin.Fin m][j: Fin.Fin n]: TotalDelta.delta (Indices.right i) (Indices.left j) = Op.zero :=
  TotalDelta.different _ _ (\fun (same: _) => Indices.different j i (sym!{{Fin.Fin Indices.total}} _ _ same));
