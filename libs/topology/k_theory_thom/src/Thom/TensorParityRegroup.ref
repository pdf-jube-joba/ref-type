\import topology.Topology[Carrier := X] \as Base;
\definition h0h1: h0.baseSpace = h1.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameH0) sameH1;
\definition h0f0: h0.baseSpace = f0.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameH0) sameF0;
\definition h0f1: h0.baseSpace = f1.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameH0) sameF1;
\definition e1h1: e1.baseSpace = h1.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameE1) sameH1;
\import Operations.DirectSum[X := X, F := E0, G := H0, left := e0, right := h0] \as StableEven;
\import Operations.DirectSum[X := X, F := E1, G := H1, left := e1, right := h1] \as StableOdd;
\definition stableEven: Bundles.Family[X := X, F := StableEven.Fiber].Bundle := StableEven.bundle sameH0;
\definition stableOdd: Bundles.Family[X := X, F := StableOdd.Fiber].Bundle := StableOdd.bundle e1h1;
\import \root.Thom[].ComplexProductParity[X := X, F0 := StableEven.Fiber, F1 := StableOdd.Fiber, G0 := F0, G1 := F1,
  e0 := stableEven, e1 := stableOdd, f0 := f0, f1 := f1, sameE1 := sameE1, sameF0 := sameF0, sameF1 := sameF1] \as Source;
\import \root.Thom[].ComplexProductParity[X := X, F0 := E0, F1 := E1, G0 := F0, G1 := F1,
  e0 := e0, e1 := e1, f0 := f0, f1 := f1, sameE1 := sameE1, sameF0 := sameF0, sameF1 := sameF1] \as Original;
\import \root.Thom[].ComplexProductParity[X := X, F0 := H0, F1 := H1, G0 := F0, G1 := F1,
  e0 := h0, e1 := h1, f0 := f0, f1 := f1, sameE1 := h0h1, sameF0 := h0f0, sameF1 := h0f1] \as Auxiliary;
\import Operations.DirectSum[X := X, F := Original.Even, G := Auxiliary.Even, left := Original.evenBundle, right := Auxiliary.evenBundle] \as Even;
\import Operations.DirectSum[X := X, F := Original.Odd, G := Auxiliary.Odd, left := Original.oddBundle, right := Auxiliary.oddBundle] \as Odd;
\definition evenBundle: Bundles.Family[X := X, F := Even.Fiber].Bundle := Even.bundle sameH0;
\definition oddBundle: Bundles.Family[X := X, F := Odd.Fiber].Bundle := Odd.bundle sameH0;
\module Positive;
\module Negative;
