\import Operations.Tensor[X := X, F := Parity.LeftFiber, G := Parity.RightFiber, left := Parity.leftBundle, right := Parity.rightBundle] \as Tensor;
\import Tensor.Of[same := sameAuxiliary].Mapping[Y := X, A := Parity.LeftFiber, B := Parity.RightFiber,
  leftTarget := Parity.leftBundle, rightTarget := Parity.rightBundle, f := (\fun (x: X) => x)].Of[targetSame := sameAuxiliary] \as Mapping;
\import Bundles.Identity[X := X, F := Parity.RightFiber, bundle := Parity.rightBundle] \as Identity;
\import Bundles.Morphisms[X := X, Y := X, F := Parity.SourceFiber, G := Parity.SourceFiber,
  source := Parity.sourceBundle, target := Parity.sourceBundle, f := (\fun (x: X) => x)] \as Maps;
\definition left: Maps.Map := Mapping.map data.partner Identity.map;
\definition right: Maps.Map := Mapping.map Grading.leftGrading.forward flip;
\import Operations.DirectSum[X := X, F := Parity.Even, G := Parity.Odd, left := Parity.evenBundle, right := Parity.oddBundle] \as Total;
\import Total.Of[same := (\refl(first.baseSpace))] \as TotalMaps;
\import TotalMaps.Inclusions[] \as Inclusions;
\import Bundles.Morphisms[X := X, Y := X, F := Parity.Even, G := Total.Fiber, source := Parity.evenBundle,
  target := Parity.targetBundle, f := (\fun (x: X) => x)].Composition[Z := X, H := Parity.SourceFiber, range := Parity.sourceBundle, g := (\fun (x: X) => x)] \as EmbedEven;
\definition embedEven: Bundles.Morphisms[X := X, Y := X, F := Parity.Even, G := Parity.SourceFiber,
  source := Parity.evenBundle, target := Parity.sourceBundle, f := (\fun (x: X) => x)].Map := EmbedEven.compose Inclusions.first Parity.isomorphism.backward;
\import Bundles.Morphisms[X := X, Y := X, F := Parity.Odd, G := Total.Fiber, source := Parity.oddBundle,
  target := Parity.targetBundle, f := (\fun (x: X) => x)].Composition[Z := X, H := Parity.SourceFiber, range := Parity.sourceBundle, g := (\fun (x: X) => x)] \as EmbedOdd;
\definition embedOdd: Bundles.Morphisms[X := X, Y := X, F := Parity.Odd, G := Parity.SourceFiber,
  source := Parity.oddBundle, target := Parity.sourceBundle, f := (\fun (x: X) => x)].Map := EmbedOdd.compose Inclusions.second Parity.isomorphism.backward;
\import Bundles.Morphisms[X := X, Y := X, F := Parity.SourceFiber, G := Total.Fiber, source := Parity.sourceBundle,
  target := Parity.targetBundle, f := (\fun (x: X) => x)].Composition[Z := X, H := Parity.Even, range := Parity.evenBundle, g := (\fun (x: X) => x)] \as ProjectEven;
\definition projectEven: Bundles.Morphisms[X := X, Y := X, F := Parity.SourceFiber, G := Parity.Even,
  source := Parity.sourceBundle, target := Parity.evenBundle, f := (\fun (x: X) => x)].Map := ProjectEven.compose Parity.isomorphism.forward TotalMaps.firstMap;
\import Bundles.Morphisms[X := X, Y := X, F := Parity.SourceFiber, G := Total.Fiber, source := Parity.sourceBundle,
  target := Parity.targetBundle, f := (\fun (x: X) => x)].Composition[Z := X, H := Parity.Odd, range := Parity.oddBundle, g := (\fun (x: X) => x)] \as ProjectOdd;
\definition projectOdd: Bundles.Morphisms[X := X, Y := X, F := Parity.SourceFiber, G := Parity.Odd,
  source := Parity.sourceBundle, target := Parity.oddBundle, f := (\fun (x: X) => x)].Map := ProjectOdd.compose Parity.isomorphism.forward TotalMaps.secondMap;
\module Block(map: Maps.Map);
