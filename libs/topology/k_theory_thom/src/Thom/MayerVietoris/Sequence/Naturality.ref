\import Relative.NegativeMap[source := PartPair.subsetModel, target := WholePair.subsetModel, f := Mapping.subsetMap, degree := degree] \as Subset;
\import Relative.NegativeMap[source := PartPair.subsetModel, target := WholePair.subsetModel, f := Mapping.subsetMap, degree := N.Nat^::succ degree] \as SubsetNext;
\definition subset: XTerm.Fifth -> VTerm.Fifth := Subset.map;
\definition subsetAdd: \forall (v, w: XTerm.Fifth) -> subset (XTerm.fifthGroup.base.op v w) = VTerm.fifthGroup.base.op (subset v) (subset w) := Subset.additive;
\definition subsetZero: subset XTerm.fifthGroup.base.unit = VTerm.fifthGroup.base.unit := Subset.preservesZero;
\definition subsetNext: XTerm.Second -> VTerm.Second := SubsetNext.map;
\definition subsetNextAdd: \forall (v, w: XTerm.Second) -> subsetNext (XTerm.secondGroup.base.op v w) = VTerm.secondGroup.base.op (subsetNext v) (subsetNext w) := SubsetNext.additive;
\definition subsetNextZero: subsetNext XTerm.secondGroup.base.unit = VTerm.secondGroup.base.unit := SubsetNext.preservesZero;
\definition restriction: \forall (v: XTerm.Fourth) -> VTerm.restriction (VRestriction.map v) = subset (XTerm.restriction v) := MappingNaturality.restriction;
\definition boundary: \forall (v: XTerm.Second) -> VTerm.boundary (subsetNext v) = Relative.NegativeMap[source := PartPair.quotientModel, target := WholePair.quotientModel, f := Mapping.quotientMap, degree := degree].map (XTerm.boundary v) := ConnectingNaturality.boundary;
