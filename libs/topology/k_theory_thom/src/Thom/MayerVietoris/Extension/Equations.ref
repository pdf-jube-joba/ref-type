\import \parent.\parent.Sequence[degree := degree] \as MV;
\import Relative.Negative[original := ambient, degree := degree] \as Ambient;
\import Relative.NegativeMap[source := model, target := ambient, f := j, degree := degree] \as Whole;
\import Relative.NegativeMap[source := firstModel, target := ambient, f := First.map, degree := degree] \as FirstPull;
\import Relative.NegativeMap[source := secondModel, target := ambient, f := Second.map, degree := degree] \as SecondPull;
\import Relative.NegativeMap[source := ambient, target := firstModel, f := r, degree := degree] \as Retract;
\import Relative.NegativeMap[source := secondModel, target := intersectionModel, f := h, degree := degree] \as Lift;
\import Relative.NegativeMap[source := intersectionModel, target := firstModel, f := intersectionToFirst, degree := degree] \as ToFirst;
\import Relative.NegativeMap[source := intersectionModel, target := secondModel, f := intersectionToSecond, degree := degree] \as ToSecond;
\definition firstPull: Ambient.Carrier -> Relative.Negative[original := firstModel, degree := degree].Carrier := FirstPull.map;
\definition secondPull: Ambient.Carrier -> Relative.Negative[original := secondModel, degree := degree].Carrier := SecondPull.map;
\definition restrict: Ambient.Carrier -> MV.Whole := Whole.map;
\definition retractPull: Relative.Negative[original := firstModel, degree := degree].Carrier -> Ambient.Carrier := Retract.map;
\definition lift: Relative.Negative[original := intersectionModel, degree := degree].Carrier -> Relative.Negative[original := secondModel, degree := degree].Carrier := Lift.map;
\definition toFirst: Relative.Negative[original := firstModel, degree := degree].Carrier -> Relative.Negative[original := intersectionModel, degree := degree].Carrier := ToFirst.map;
\definition toSecond: Relative.Negative[original := secondModel, degree := degree].Carrier -> Relative.Negative[original := intersectionModel, degree := degree].Carrier := ToSecond.map;
\definition firstFormula[v: Ambient.Carrier]: (MV.restriction (restrict v)).first = firstPull v := trans!{{Relative.Negative[original := firstModel, degree := degree].Carrier}} _ _ _
  (MV.firstRestrictionFormula (restrict v)) (sym!{{Relative.Negative[original := firstModel, degree := degree].Carrier}} _ _ (First.Negative[degree := degree].equation v));
\definition secondFormula[v: Ambient.Carrier]: (MV.restriction (restrict v)).second = secondPull v := trans!{{Relative.Negative[original := secondModel, degree := degree].Carrier}} _ _ _
  (MV.secondRestrictionFormula (restrict v)) (sym!{{Relative.Negative[original := secondModel, degree := degree].Carrier}} _ _ (Second.Negative[degree := degree].equation v));
\definition retraction[v: Relative.Negative[original := firstModel, degree := degree].Carrier]: firstPull (retractPull v) = v :=
  trans!{{Relative.Negative[original := firstModel, degree := degree].Carrier}} _ _ _ (sym!{{Relative.Negative[original := firstModel, degree := degree].Carrier}} _ _ (Retraction.Negative[degree := degree].equation v))
    (trans!{{Relative.Negative[original := firstModel, degree := degree].Carrier}} _ _ _ (change degree firstModel firstModel Retraction.map FirstIdentity.map retractionEquation v) (FirstIdentity.Negative[degree := degree].equation v));
\definition preservation[v: Relative.Negative[original := firstModel, degree := degree].Carrier]: secondPull (retractPull v) = lift (toFirst v) :=
  trans!{{Relative.Negative[original := secondModel, degree := degree].Carrier}} _ _ _ (sym!{{Relative.Negative[original := secondModel, degree := degree].Carrier}} _ _ (Preservation.Negative[degree := degree].equation v))
    (trans!{{Relative.Negative[original := secondModel, degree := degree].Carrier}} _ _ _ (change degree secondModel firstModel Preservation.map Factor.map preservationEquation v) (Factor.Negative[degree := degree].equation v));
\definition sectionPullback[v: Relative.Negative[original := intersectionModel, degree := degree].Carrier]: toSecond (lift v) = v :=
  trans!{{Relative.Negative[original := intersectionModel, degree := degree].Carrier}} _ _ _ (sym!{{Relative.Negative[original := intersectionModel, degree := degree].Carrier}} _ _ (Section.Negative[degree := degree].equation v))
    (trans!{{Relative.Negative[original := intersectionModel, degree := degree].Carrier}} _ _ _ (change degree intersectionModel intersectionModel Section.map IntersectionIdentity.map sectionEquation v) (IntersectionIdentity.Negative[degree := degree].equation v));
