\import Relative.Composition[source := firstModel, middle := model, target := ambient, first := firstInclusion, second := j] \as First;
\import Relative.Composition[source := secondModel, middle := model, target := ambient, first := secondInclusion, second := j] \as Second;
\import Relative.Composition[source := firstModel, middle := ambient, target := firstModel, first := First.map, second := r] \as Retraction;
\import Relative.Composition[source := secondModel, middle := ambient, target := firstModel, first := Second.map, second := r] \as Preservation;
\import Relative.Composition[source := secondModel, middle := intersectionModel, target := firstModel, first := h, second := intersectionToFirst] \as Factor;
\import Relative.Composition[source := intersectionModel, middle := secondModel, target := intersectionModel, first := intersectionToSecond, second := h] \as Section;
\import Relative.Identity[model := firstModel] \as FirstIdentity;
\import Relative.Identity[model := intersectionModel] \as IntersectionIdentity;
\definition retractionEquation: Retraction.map = FirstIdentity.map := \axiom:funext(Retraction.map, FirstIdentity.map, retract);
\definition preservationEquation: Preservation.map = Factor.map := \axiom:funext(Preservation.map, Factor.map, preserves);
\definition sectionEquation: Section.map = IntersectionIdentity.map := \axiom:funext(Section.map, IntersectionIdentity.map, section);
\definition change[degree: N.Nat^][A, B: Relative.CompactPointed][f, g: Relative.Map A B][same: f = g][v: Relative.Negative[original := B, degree := degree].Carrier]:
  Relative.NegativeMap[source := A, target := B, f := f, degree := degree].map v = Relative.NegativeMap[source := A, target := B, f := g, degree := degree].map v :=
  congr!{{Relative.Map A B} {Relative.Negative[original := A, degree := degree].Carrier}}
    (\fun (k: Relative.Map A B) => Relative.NegativeMap[source := A, target := B, f := k, degree := degree].map v) f g same;
\module Equations(degree: N.Nat^);
\module At(degree: N.Nat^);
