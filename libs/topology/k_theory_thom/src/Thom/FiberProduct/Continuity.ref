\definition inclusionContinuous: topology.Continuity[A := ClosedCarrier, B := ProductCarrier].Continuous closedTopology productTopology (\fun (p: ClosedCarrier) => p) :=
  topology.Continuity[A := ClosedCarrier, B := ProductCarrier].Corestriction[S := closedSubset].inclusionContinuous productTopology;
\definition firstContinuous: topology.Continuity[A := ClosedCarrier, B := First.Point].Continuous closedTopology left.totalSpace (\fun (p: ClosedCarrier) => first p) :=
  topology.Composition[A := ClosedCarrier, B := ProductCarrier, C := First.Point].composeContinuous closedTopology productTopology left.totalSpace (\fun (p: ClosedCarrier) => p) first inclusionContinuous
    (Product.Maps[].firstContinuous left.totalSpace right.totalSpace);
\definition secondContinuous: topology.Continuity[A := ClosedCarrier, B := Second.Point].Continuous closedTopology right.totalSpace (\fun (p: ClosedCarrier) => second p) :=
  topology.Composition[A := ClosedCarrier, B := ProductCarrier, C := Second.Point].composeContinuous closedTopology productTopology right.totalSpace (\fun (p: ClosedCarrier) => p) second inclusionContinuous
    (Product.Maps[].secondContinuous left.totalSpace right.totalSpace);
\definition joinContinuous: topology.Continuity[A := ClosedCarrier, B := Total].Continuous closedTopology totalSum.totalSpace join :=
  Sum.Universal[Y := ClosedCarrier].continuous closedTopology join
    (\idelim (\fun (p: ClosedCarrier) => first p) = (\fun (p: ClosedCarrier) => Sum.first (join p))
      \with f: (ClosedCarrier -> First.Point) => topology.Continuity[A := ClosedCarrier, B := First.Point].Continuous closedTopology left.totalSpace f \by {
      base: firstContinuous, equality: \axiom:funext((\fun (p: ClosedCarrier) => first p), (\fun (p: ClosedCarrier) => Sum.first (join p)), \fun (p: ClosedCarrier) => sym!{First.Point} _ _ (firstFormula p))
    })
    (\idelim (\fun (p: ClosedCarrier) => second p) = (\fun (p: ClosedCarrier) => Sum.second (join p))
      \with f: (ClosedCarrier -> Second.Point) => topology.Continuity[A := ClosedCarrier, B := Second.Point].Continuous closedTopology right.totalSpace f \by {
      base: secondContinuous, equality: \axiom:funext((\fun (p: ClosedCarrier) => second p), (\fun (p: ClosedCarrier) => Sum.second (join p)), \fun (p: ClosedCarrier) => sym!{Second.Point} _ _ (secondFormula p))
    });
