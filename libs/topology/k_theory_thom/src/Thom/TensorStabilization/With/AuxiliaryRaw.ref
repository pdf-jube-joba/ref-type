\import Operations.Tensor[X := X, F := Auxiliary.LeftFiber, G := Auxiliary.RightFiber, left := Auxiliary.leftBundle, right := Auxiliary.rightBundle] \as Tensor;
\import Tensor.Of[same := auxF0].Mapping[Y := X, A := Auxiliary.LeftFiber, B := Auxiliary.RightFiber,
  leftTarget := Auxiliary.leftBundle, rightTarget := Auxiliary.rightBundle, f := (\fun (x: X) => x)].Of[targetSame := auxF0] \as Mapping;
\import Bundles.Identity[X := X, F := Auxiliary.RightFiber, bundle := Auxiliary.rightBundle] \as Identity;
\import Operations.MapOperations[X := X, F := Auxiliary.SourceFiber, G := Auxiliary.SourceFiber, source := Auxiliary.sourceBundle, target := Auxiliary.sourceBundle] \as Maps;
\definition operator: Maps.Map := Maps.add (Mapping.map Factor.auxiliaryOperator Identity.map) (Mapping.map Factor.auxiliaryGrading partner);
\import Operations.DirectSum[X := X, F := Auxiliary.Even, G := Auxiliary.Odd, left := Auxiliary.evenBundle, right := Auxiliary.oddBundle]
  .Of[same := (\refl(auxiliary.baseSpace))] \as Split;
\import Split.Inclusions[] \as Inclusions;
\import Bundles.Morphisms[X := X, Y := X, F := Auxiliary.Even, G := Auxiliary.TargetFiber,
  source := Auxiliary.evenBundle, target := Auxiliary.targetBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Auxiliary.SourceFiber, range := Auxiliary.sourceBundle, g := (\fun (x: X) => x)] \as Embedding;
\definition embed: Bundles.Morphisms[X := X, Y := X, F := Auxiliary.Even, G := Auxiliary.SourceFiber,
  source := Auxiliary.evenBundle, target := Auxiliary.sourceBundle, f := (\fun (x: X) => x)].Map := Embedding.compose Inclusions.first Auxiliary.isomorphism.backward;
\import Bundles.Morphisms[X := X, Y := X, F := Auxiliary.SourceFiber, G := Auxiliary.TargetFiber,
  source := Auxiliary.sourceBundle, target := Auxiliary.targetBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Auxiliary.Odd, range := Auxiliary.oddBundle, g := (\fun (x: X) => x)] \as Projection;
\definition project: Bundles.Morphisms[X := X, Y := X, F := Auxiliary.SourceFiber, G := Auxiliary.Odd,
  source := Auxiliary.sourceBundle, target := Auxiliary.oddBundle, f := (\fun (x: X) => x)].Map := Projection.compose Auxiliary.isomorphism.forward Split.secondMap;
\import Bundles.Morphisms[X := X, Y := X, F := Auxiliary.Even, G := Auxiliary.SourceFiber,
  source := Auxiliary.evenBundle, target := Auxiliary.sourceBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Auxiliary.SourceFiber, range := Auxiliary.sourceBundle, g := (\fun (x: X) => x)] \as Start;
\import Bundles.Morphisms[X := X, Y := X, F := Auxiliary.Even, G := Auxiliary.SourceFiber,
  source := Auxiliary.evenBundle, target := Auxiliary.sourceBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Auxiliary.Odd, range := Auxiliary.oddBundle, g := (\fun (x: X) => x)] \as End;
\definition forward: Bundles.Morphisms[X := X, Y := X, F := Auxiliary.Even, G := Auxiliary.Odd,
  source := Auxiliary.evenBundle, target := Auxiliary.oddBundle, f := (\fun (x: X) => x)].Map := End.compose (Start.compose embed operator) project;
