\import Original.Pullback[Y := Y, source := source, f := f] \as Bundle;
\import Bundles.Family[X := Y, F := (\fun (y: Y) => F (f y))] \as Pulled;
\module CompactPreimage(K: \Pow Family.Point, compactK: Total.IsCompactIn bundle.totalSpace K);
\definition proper: compact_support_k.Support[].Proper[A := Pulled.Point, B := Family.Point, source := Bundle.topology, target := bundle.totalSpace].IsProper Bundle.map :=
  \fun (K: \Pow Family.Point)(compactK: _) => CompactPreimage[K := K, compactK := compactK].compact;
\definition continuous: topology.Continuity[A := Pulled.Point, B := Family.Point].Continuous Bundle.topology bundle.totalSpace Bundle.map := Bundle.mapContinuous;
