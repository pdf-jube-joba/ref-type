\definition denominator: Real.Real := Real.add Real.one t;
\definition denominatorPositive: D.Lt Real.zero denominator := D.ltLeTrans Real.zero Real.one denominator Bounds.onePositive (Algebra.leAddRight Real.one t nonnegative);
\definition a: Real.Real := Laws.fieldInv denominator;
\definition positive: D.Lt Real.zero a := Bounds.invPositive denominator denominatorPositive;
\definition reciprocal: Real.mul a denominator = Real.one := Laws.fieldInverseNonzero denominator (Real.Inverse[].positiveNonzero denominator denominatorPositive);
\definition expanded: Real.add a (Real.mul a t) = Real.one := eq_reason_in!{Real.Real _
  "=" {Real.add (Real.mul a Real.one) (Real.mul a t)} "by" { congr!{Real.Real Real.Real} (\fun (s: Real.Real) => Real.add s (Real.mul a t)) _ _ (sym!{Real.Real} _ _ (Algebra.mulOneRight a)) }
  "=" {Real.mul a denominator} "by" { sym!{Real.Real} _ _ (Laws.fieldMulAdd a Real.one t) }
  "=" Real.one "by" reciprocal
};
\definition gap: Real.sub Real.one (Real.mul a t) = a := trans!{Real.Real} _ _ _
  (congr!{Real.Real Real.Real} (\fun (s: Real.Real) => Real.sub s (Real.mul a t)) _ _ (sym!{Real.Real} _ _ expanded))
  (Laws.addNegCancelRight (Real.mul a t) a);
\definition belowDenominator: D.Lt t denominator := D.ltReplaceLeft (Real.add Real.zero t) t denominator (Laws.addZeroLeft t)
  (Laws.ltAddRight Real.zero Real.one t Bounds.onePositive);
\definition compressedInside: D.Lt (Real.mul a t) Real.one := D.ltReplaceRight _ (Real.mul a denominator) Real.one reciprocal
  (Bounds.mulStrict a t denominator positive belowDenominator);
