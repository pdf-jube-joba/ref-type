\definition denominator: Real.Real := Real.sub Real.one t;
\definition denominatorPositive: D.Lt Real.zero denominator := Bounds.subPositive Real.one t inside;
\definition b: Real.Real := Laws.fieldInv denominator;
\definition positive: D.Lt Real.zero b := Bounds.invPositive denominator denominatorPositive;
\definition reciprocal: Real.mul b denominator = Real.one := Laws.fieldInverseNonzero denominator (Real.Inverse[].positiveNonzero denominator denominatorPositive);
\definition sum: Real.add Real.one (Real.mul b t) = b := eq_reason_in!{Real.Real _
  "=" {Real.add (Real.mul b denominator) (Real.mul b t)} "by" { congr!{Real.Real Real.Real} (\fun (s: Real.Real) => Real.add s (Real.mul b t)) _ _ (sym!{Real.Real} _ _ reciprocal) }
  "=" {Real.mul b (Real.add denominator t)} "by" { sym!{Real.Real} _ _ (Laws.fieldMulAdd b denominator t) }
  "=" {Real.mul b Real.one} "by" { congr!{Real.Real Real.Real} (Real.mul b) _ _ (Real.Distance[].subAddCancel Real.one t) }
  "=" b "by" { Algebra.mulOneRight b }
};
