\import Bundles.Morphisms[X := X, Y := X, F := F, G := F, source := first, target := first, f := (\fun (x: X) => x)] \as FirstMaps;
\import Bundles.Morphisms[X := X, Y := X, F := G, G := G, source := second, target := second, f := (\fun (x: X) => x)] \as SecondMaps;
\import Operations.Tensor[X := X, F := F, G := G, left := first, right := second] \as Tensor;
\definition bundle: Bundles.Family[X := X, F := Tensor.Fiber].Bundle := Tensor.bundle sameBase;
\module With(firstD, firstR: FirstMaps.Map, secondD, secondR: SecondMaps.Map, grading: FirstMaps.Map);
