\definition head: Ranks.rank u (Fin.zero one) = Ranks.rank unit (Fin.zero one) := trans!{{I.Int^}} _ _ _
  (\bysub(K.Carrier, Reduced.Carrier, u)) (sym!{{I.Int^}} _ _ (\bysub(K.Carrier, Reduced.Carrier, unit)));
\definition tail: \forall (i: Fin.Fin one) -> Ranks.rank u (Fin.succ one i) = Ranks.rank unit (Fin.succ one i) :=
  \fun (i: Fin.Fin one) => \idelim Fin.zero zero = i \with j: Fin.Fin one =>
    Ranks.rank u (Fin.succ one j) = Ranks.rank unit (Fin.succ one j) \by {
      base: trans!{{I.Int^}} _ _ _ live (sym!{{I.Int^}} _ _ liveRank),
      equality: sym!{{Fin.Fin one}} _ _ (Fin.singletonValue i)
    };
\definition equation: u = unit := Computation.injective u unit
  (\axiom:funext(Ranks.rank u, Ranks.rank unit,
    Fin.cases one (\fun (i: Fin.Fin two) => Ranks.rank u i = Ranks.rank unit i) head tail));
