\definition endpoint[x: Pair.A]: C.Complex := scale (Cylinder.at I.end x);
\definition endpointReciprocal[x: Pair.A]: C.Complex := reciprocal (Cylinder.at I.end x);
\definition endpointContinuous: topology.Continuity[A := Pair.A, B := C.Complex].Continuous Pair.subspace Scalars.scalar.topological.space endpoint :=
  topology.Composition[A := Pair.A, B := Cylinder.Carrier, C := C.Complex].composeContinuous Pair.subspace (Cylinder.topology Pair.subspace) Scalars.scalar.topological.space
    (Cylinder.at I.end) scale (Cylinder.atContinuous Pair.subspace I.end) scaleContinuous;
\definition endpointReciprocalContinuous: topology.Continuity[A := Pair.A, B := C.Complex].Continuous Pair.subspace Scalars.scalar.topological.space endpointReciprocal :=
  topology.Composition[A := Pair.A, B := Cylinder.Carrier, C := C.Complex].composeContinuous Pair.subspace (Cylinder.topology Pair.subspace) Scalars.scalar.topological.space
    (Cylinder.at I.end) reciprocal (Cylinder.atContinuous Pair.subspace I.end) reciprocalContinuous;
\import Rescale.With[scale := endpoint, reciprocal := endpointReciprocal, scaleContinuous := endpointContinuous,
  reciprocalContinuous := endpointReciprocalContinuous, inverseLaw := (\fun (x: Pair.A) => inverseLaw (Cylinder.at I.end x))] \as Endpoint;
\definition comparison: Triples.OnSubset := Endpoint.isomorphism;
\definition value: Pair.Quotient[].Relative := Triples.With[alpha := comparison].reduced;
\import Homotopy.Using[scale := scale, reciprocal := reciprocal, scaleContinuous := scaleContinuous, reciprocalContinuous := reciprocalContinuous, inverseLaw := inverseLaw] \as Rescaled;
\import Triples.Homotopy[alpha := Normal.isomorphism, beta := comparison] \as Comparison;
\definition family: Comparison.Family := Comparison.Family {
  isomorphism := Rescaled.isomorphism,
  start := Rescaled.start atStart,
  end := Rescaled.end endpoint (\fun (x: Pair.A) => \refl(endpoint x))
};
\definition equation[exact: Source.Exact]: Source.Supported[exact := exact].value = value :=
  trans!{{Pair.Quotient[].Relative}} _ _ _ (Source.Supported[exact := exact].agreement c)
    (Comparison.With[family := family].reducedEquation);
