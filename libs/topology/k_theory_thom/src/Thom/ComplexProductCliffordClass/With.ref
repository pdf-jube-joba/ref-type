\import Acyclic.Normalized[c := c] \as Normal;
\import \root.Thom[].ComplexProductRescaleBundle[X := Pair.A, space := Pair.subspace, compact := Source.boundaryCompact, hausdorff := Source.boundaryHausdorff]
  .At[p := P.value, q := Q.value, d := D.map Chain.parity.forward, e := E.map Chain.parity.backward, c := c] \as Rescale;
\import Rescale.Homotopy[] \as Homotopy;
\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := Pair.A] \as Cylinder;
\import Pair.BundleTriples[F := Source.Even, G := Source.Odd, firstModel := Source.firstModel, secondModel := Source.secondModel] \as Triples;
\module Using(scale, reciprocal: Cylinder.Carrier -> C.Complex,
  scaleContinuous: topology.Continuity[A := Cylinder.Carrier, B := C.Complex].Continuous (Cylinder.topology Pair.subspace) Scalars.scalar.topological.space scale,
  reciprocalContinuous: topology.Continuity[A := Cylinder.Carrier, B := C.Complex].Continuous (Cylinder.topology Pair.subspace) Scalars.scalar.topological.space reciprocal,
  inverseLaw: \forall (z: Cylinder.Carrier) -> Scalar.mul (reciprocal z) (scale z) = Scalar.one,
  atStart: \forall (x: Pair.A) -> scale (Cylinder.at I.start x) = Scalar.one);
