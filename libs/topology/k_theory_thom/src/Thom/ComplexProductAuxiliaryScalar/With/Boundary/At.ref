\definition onSubset: \In[X] subset (Cylinder.point z) := \bysub(X, subset, Cylinder.point z);
\definition positive: Order.Lt Real.zero (norm z) := Logic.orElim[r (Cylinder.point z) = Real.one, b (Cylinder.point z) = Real.one, Order.Lt Real.zero (norm z)]
  (boundary (Cylinder.point z) onSubset)
  (\fun (first: r (Cylinder.point z) = Real.one) => Order.ltReplaceRight Real.zero (Real.add Real.one (b (Cylinder.point z))) (norm z)
    (sym!{Real.Real} _ _ (trans!{Real.Real} _ _ _
      (congr!{Real.Real Real.Real} (\fun (q: Real.Real) => Real.add (Real.mul q q) (b (Cylinder.point z))) _ _
        (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (affine (Cylinder.time z)) _ _ first) (affineUnit (Cylinder.time z))))
      (congr!{Real.Real Real.Real} (\fun (q: Real.Real) => Real.add q (b (Cylinder.point z))) _ _ (Laws.fieldMulOneLeft Real.one))))
    (positiveOnePlus (b (Cylinder.point z)) (nonnegative (Cylinder.point z))))
  (\fun (second: b (Cylinder.point z) = Real.one) => Order.ltReplaceRight Real.zero
    (Real.add Real.one (Real.mul (coefficient z) (coefficient z))) (norm z)
    (trans!{Real.Real} _ _ _ (Laws.addComm Real.one (Real.mul (coefficient z) (coefficient z)))
      (congr!{Real.Real Real.Real} (Real.add (Real.mul (coefficient z) (coefficient z))) _ _ (sym!{Real.Real} _ _ second)))
    (positiveOnePlus (Real.mul (coefficient z) (coefficient z)) (Algebra.squareNonnegative (coefficient z))));
