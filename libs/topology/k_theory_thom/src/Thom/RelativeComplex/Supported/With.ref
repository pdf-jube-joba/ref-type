\import Acyclic.Normalized[c := contraction] \as Normal;
\import Pair.BundleTriples[F := Even, G := Odd, firstModel := firstModel, secondModel := secondModel] \as Triples;
\definition comparison: Triples.OnSubset := Normal.isomorphism;
\definition value: Pair.Quotient[].Relative := Triples.With[alpha := comparison].reduced;
