\import \parent.With[contraction := first] \as Left;
\import \parent.With[contraction := second] \as Right;
\import Acyclic.Between[first := first, second := second] \as Between;
\import Pair.BundleTriples[F := Even, G := Odd, firstModel := firstModel, secondModel := secondModel]
  .Homotopy[alpha := Left.comparison, beta := Right.comparison] \as Homotopy;
\definition family: Homotopy.Family := Homotopy.Family {
  isomorphism := Between.isomorphism, start := Between.start, end := Between.end
};
\definition equation: Left.value = Right.value := Homotopy.With[family := family].reducedEquation;
