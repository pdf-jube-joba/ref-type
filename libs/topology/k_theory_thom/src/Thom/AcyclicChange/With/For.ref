\definition h: Models.Map s r := Models.compose s p r (Models.compose s q p negative.backward contraction.h) positive.forward;
\definition k: Models.Map r s := Models.compose r q s (Models.compose r p q positive.backward contraction.k) negative.forward;
\module At(x: X);
\definition transported: Target.Contraction := Target.Contraction { h := h, k := k, laws := \fun (x: X) => At[x := x].laws };
\import Source.Normalized[c := contraction] \as FirstNormal;
\import Target.Normalized[c := transported] \as SecondNormal;
\definition normalizedCommutes: \forall (x: X)(v: SourceEven x) -> (SecondNormal.forward.fiber x).apply ((positive.forward.fiber x).apply v) =
  (negative.forward.fiber x).apply ((FirstNormal.forward.fiber x).apply v) := \fun (x: X) => At[x := x].normalizedCommutes;
