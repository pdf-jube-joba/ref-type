\import Spaces.DirectSum[V := F y.base, W := G y.base, left := left.space y.base, right := right.space y.base] \as Vectors;
\import Spaces.Exterior[V := G y.base, space := right.space y.base] \as Exterior;
\import Fin.FromList[A := G y.base] \as ListsOfVectors;
\definition h[i: Index]: G y.base := Vectors.second (vector y i);
\definition listEquation: Lists.map (Sum.Fiber y.base) (G y.base) Vectors.second (Lists.map Index (Sum.Fiber y.base) (vector y) xs) =
  ListsOfVectors.list q (\fun (i: Fin.Fin q) => h (selector i)) :=
  trans!{{Lists.List[G y.base]}} _ _ _
    (mapCompose Index (Sum.Fiber y.base) (G y.base) (vector y) Vectors.second xs)
    (sym!{{Lists.List[G y.base]}} _ _
      (trans!{{Lists.List[G y.base]}} _ _ _
        (IndexLists.Mapping[B := G y.base].listMap q h selector)
        (congr!{{Lists.List[Index]} {Lists.List[G y.base]}} (Lists.map Index (G y.base) h) _ _ (IndexLists.listAt q xs equal))));
\definition equation: secondValue xs y = evaluation y :=
  trans!{{C.Complex}} _ _ _
    (congr!{{Lists.List[G y.base]} {C.Complex}} (Exterior.component q (Pairs.second y).vector) _ _ listEquation)
    (Spaces.Multilinear[V := G y.base, space := right.space y.base].ListSeries[k := q].onArguments (Pairs.second y).vector (\fun (i: Fin.Fin q) => h (selector i)));
