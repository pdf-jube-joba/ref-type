\module Sized(equal: Lists.length Index xs = p);
\definition continuous: topology.Continuity[A := Point, B := C.Complex].Continuous source Scalars.scalar.topological.space (firstValue xs) :=
  either!{{(Classical.excludedMiddle (Lists.length Index xs = p))}
    {topology.Continuity[A := Point, B := C.Complex].Continuous source Scalars.scalar.topological.space (firstValue xs)}
    {\fun (equal: Lists.length Index xs = p) => Sized[equal := equal].continuous}
    {\fun (different: Logic.Not (Lists.length Index xs = p)) => ScalarFunctions.transport source (\fun (y: Point) => Op.zero) (firstValue xs)
      (\fun (y: Point) => sym!{{C.Complex}} _ _
        (Spaces.Multilinear[V := F y.base, space := left.space y.base].ListSeries[k := p].outside (Pairs.first y).vector _
          (\fun (equal: Lists.length (F y.base) (Lists.map (Sum.Fiber y.base) (F y.base) (Spaces.DirectSum[V := F y.base, W := G y.base, left := left.space y.base, right := right.space y.base].first) (Lists.map Index (Sum.Fiber y.base) (vector y) xs)) = p) =>
            different (trans!{{N.Nat^}} _ _ _
              (sym!{{N.Nat^}} _ _ (trans!{{N.Nat^}} _ _ _
                (Lists.Mapping[A := Sum.Fiber y.base, B := F y.base].Prop[].lengthMap (Spaces.DirectSum[V := F y.base, W := G y.base, left := left.space y.base, right := right.space y.base].first) (Lists.map Index (Sum.Fiber y.base) (vector y) xs))
                (Lists.Mapping[A := Index, B := Sum.Fiber y.base].Prop[].lengthMap (vector y) xs))) equal))))
      (ScalarFunctions.constant source Op.zero)}};
