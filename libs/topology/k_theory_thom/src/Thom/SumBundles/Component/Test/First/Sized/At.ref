\import Spaces.DirectSum[V := F y.base, W := G y.base, left := left.space y.base, right := right.space y.base] \as Vectors;
\import Spaces.Exterior[V := F y.base, space := left.space y.base] \as Exterior;
\import Fin.FromList[A := F y.base] \as ListsOfVectors;
\definition h[i: Index]: F y.base := Vectors.first (vector y i);
\definition listEquation: Lists.map (Sum.Fiber y.base) (F y.base) Vectors.first (Lists.map Index (Sum.Fiber y.base) (vector y) xs) =
  ListsOfVectors.list p (\fun (i: Fin.Fin p) => h (selector i)) :=
  trans!{{Lists.List[F y.base]}} _ _ _
    (mapCompose Index (Sum.Fiber y.base) (F y.base) (vector y) Vectors.first xs)
    (sym!{{Lists.List[F y.base]}} _ _
      (trans!{{Lists.List[F y.base]}} _ _ _
        (IndexLists.Mapping[B := F y.base].listMap p h selector)
        (congr!{{Lists.List[Index]} {Lists.List[F y.base]}} (Lists.map Index (F y.base) h) _ _ (IndexLists.listAt p xs equal))));
\definition equation: firstValue xs y = evaluation y :=
  trans!{{C.Complex}} _ _ _
    (congr!{{Lists.List[F y.base]} {C.Complex}} (Exterior.component p (Pairs.first y).vector) _ _ listEquation)
    (Spaces.Multilinear[V := F y.base, space := left.space y.base].ListSeries[k := p].onArguments (Pairs.first y).vector (\fun (i: Fin.Fin p) => h (selector i)));
