\module Sized(equal: Lists.length Index xs = q);
\definition continuous: topology.Continuity[A := Point, B := C.Complex].Continuous source Scalars.scalar.topological.space (secondValue xs) :=
  either!{{(Classical.excludedMiddle (Lists.length Index xs = q))}
    {topology.Continuity[A := Point, B := C.Complex].Continuous source Scalars.scalar.topological.space (secondValue xs)}
    {\fun (equal: Lists.length Index xs = q) => Sized[equal := equal].continuous}
    {\fun (different: Logic.Not (Lists.length Index xs = q)) => ScalarFunctions.transport source (\fun (y: Point) => Op.zero) (secondValue xs)
      (\fun (y: Point) => sym!{{C.Complex}} _ _
        (Spaces.Multilinear[V := G y.base, space := right.space y.base].ListSeries[k := q].outside (Pairs.second y).vector _
          (\fun (equal: Lists.length (G y.base) (Lists.map (Sum.Fiber y.base) (G y.base) (Spaces.DirectSum[V := F y.base, W := G y.base, left := left.space y.base, right := right.space y.base].second) (Lists.map Index (Sum.Fiber y.base) (vector y) xs)) = q) =>
            different (trans!{{N.Nat^}} _ _ _
              (sym!{{N.Nat^}} _ _ (trans!{{N.Nat^}} _ _ _
                (Lists.Mapping[A := Sum.Fiber y.base, B := G y.base].Prop[].lengthMap (Spaces.DirectSum[V := F y.base, W := G y.base, left := left.space y.base, right := right.space y.base].second) (Lists.map Index (Sum.Fiber y.base) (vector y) xs))
                (Lists.Mapping[A := Index, B := Sum.Fiber y.base].Prop[].lengthMap (vector y) xs))) equal))))
      (ScalarFunctions.constant source Op.zero)}};
