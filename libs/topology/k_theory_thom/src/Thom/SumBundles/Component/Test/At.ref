\import \parent.\parent.At[x := y.base] \as FiberMap;
\import \root.Thom[].Sum[V := F y.base, W := G y.base, left := left.space y.base, right := right.space y.base] \as Algebra;
\import Algebra.At[p := p, q := q] \as Product;
\import Spaces.Exterior[V := Sum.Fiber y.base, space := sum.space y.base] \as Exterior;
\import Spaces.Shuffle[I := Sum.Fiber y.base] \as VectorShuffle;
\import Shuffle.Naturality[J := Sum.Fiber y.base] \as Naturality;
\import Fin.FromList[A := Sum.Fiber y.base] \as VectorLists;
\import Exterior.Regrade[k := N.Basic[].Def[].add p q, l := k] \as Regrade;
\definition equation: value y = Sums.sum (Shuffle.partitions indices) (\fun (split: Shuffle.Split) => term split y) :=
  trans!{{C.Complex}} _ _ _
    (sym!{{C.Complex}} _ _ (Spaces.Multilinear[V := Sum.Fiber y.base, space := sum.space y.base].ListSeries[k := k].onArguments
      ((fiber y.base).apply (Tensor.pure y.base (Pairs.first y).vector (Pairs.second y).vector)) (vector y)))
    (trans!{{C.Complex}} _ _ _
      (congr!{{Exterior.Form k} {C.Complex}} (\fun (omega: Exterior.Form k) => Exterior.component k omega (VectorLists.list k (vector y))) _ _
        (FiberMap.onPure (Pairs.first y).vector (Pairs.second y).vector))
      (trans!{{C.Complex}} _ _ _
        (congr!{{VectorShuffle.Function} {C.Complex}} (\fun (f: VectorShuffle.Function) => f (VectorLists.list k (vector y))) _ _
          (trans!{{VectorShuffle.Function}} _ _ _ (Regrade.series (Product.apply (Pairs.first y).vector (Pairs.second y).vector) degree)
            (Product.series (Pairs.first y).vector (Pairs.second y).vector)))
        (trans!{{C.Complex}} _ _ _
          (congr!{{Lists.List[Sum.Fiber y.base]} {C.Complex}} (Product.product (Pairs.first y).vector (Pairs.second y).vector) _ _
            (IndexLists.Mapping[B := Sum.Fiber y.base].listMap k (vector y) (\fun (i: Index) => i)))
          (sym!{{C.Complex}} _ _ (Naturality.productMap indices (vector y)
            (Algebra.leftSeries p (Pairs.first y).vector) (Algebra.rightSeries q (Pairs.second y).vector))))));
