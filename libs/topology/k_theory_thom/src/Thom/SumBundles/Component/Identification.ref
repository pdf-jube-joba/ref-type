\import \root.Thom[].Sum[V := F x, W := G x, left := left.space x, right := right.space x].DirectSum[k := k] \as Direct;
\definition index: Direct.Bidegree := Direct.make p q degree;
\import Direct.At[d := index] \as Inclusion;
\definition equation: \forall (t: Tensor.Fiber x) -> (inclusion.fiber x).apply t = Inclusion.injection.apply t :=
  \fun (t: Tensor.Fiber x) => \root.Thom[].SumBundles[X := X, F := F, G := G, left := left, right := right, sameBase := sameBase, k := k].At[x := x].injective _ _
    (trans!{{Alternating.Fiber x}} _ _ _
      ((\bysub(Bundles.Isomorphisms[X := X, F := Fiber, G := Alternating.Fiber, source := bundle, target := Alternating.alternating].Data,
        Bundles.Isomorphisms[X := X, F := Fiber, G := Alternating.Fiber, source := bundle, target := Alternating.alternating].Isomorphism, comparison)).rightInverse x ((wedge.fiber x).apply t))
      (sym!{{Alternating.Fiber x}} _ _ (Inclusion.onInjection t)));
