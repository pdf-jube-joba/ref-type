\import \root.Thom[].Sum[V := F x, W := G x, left := left.space x, right := right.space x].DirectSum[k := k] \as Direct;
\definition index: Direct.Bidegree := Direct.make p q degree;
\definition map: Spaces.Linear[V := Fiber x, W := Tensor.Fiber x, source := fiberSpace x, target := Tensor.fiberSpace x].Map := Direct.At[d := index].projection;
\import \parent.\parent.Identification[x := x] \as Identification;
\definition onInclusion: \forall (t: Tensor.Fiber x) -> map.apply ((inclusion.fiber x).apply t) = t :=
  \fun (t: Tensor.Fiber x) => trans!{{Tensor.Fiber x}} _ _ _
    (congr!{{Fiber x} {Tensor.Fiber x}} map.apply _ _ (Identification.equation t)) (Direct.At[d := index].projectionOwn t);
