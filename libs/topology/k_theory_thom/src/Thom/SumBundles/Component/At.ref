\import \root.Thom[].Sum[V := F x, W := G x, left := left.space x, right := right.space x] \as Algebra;
\import Algebra.At[p := p, q := q] \as Product;
\import Spaces.Exterior[V := Sum.Fiber x, space := sum.space x].Regrade[k := N.Basic[].Def[].add p q, l := k] \as Regrade;
\definition fiber: Spaces.Linear[V := Tensor.Fiber x, W := Alternating.Fiber x, source := Tensor.fiberSpace x, target := Alternating.fiberSpace x].Map :=
  Spaces.Linear[V := Tensor.Fiber x, W := Alternating.Fiber x, source := Tensor.fiberSpace x, target := Alternating.fiberSpace x].Map {
    apply := \fun (t: Tensor.Fiber x) => Regrade.cast (Product.tensor.apply t) degree,
    preservesAdd := \fun (s, t: Tensor.Fiber x) => trans!{{Alternating.Fiber x}} _ _ _
      (congr!{{Spaces.Exterior[V := Sum.Fiber x, space := sum.space x].Form (N.Basic[].Def[].add p q)} {Alternating.Fiber x}}
        (\fun (omega: Spaces.Exterior[V := Sum.Fiber x, space := sum.space x].Form (N.Basic[].Def[].add p q)) => Regrade.cast omega degree) _ _ (Product.tensor.preservesAdd s t))
      (Regrade.addition (Product.tensor.apply s) (Product.tensor.apply t) degree),
    preservesScale := \fun (a: C.Complex)(t: Tensor.Fiber x) => trans!{{Alternating.Fiber x}} _ _ _
      (congr!{{Spaces.Exterior[V := Sum.Fiber x, space := sum.space x].Form (N.Basic[].Def[].add p q)} {Alternating.Fiber x}}
        (\fun (omega: Spaces.Exterior[V := Sum.Fiber x, space := sum.space x].Form (N.Basic[].Def[].add p q)) => Regrade.cast omega degree) _ _ (Product.tensor.preservesScale a t))
      (Regrade.scalar a (Product.tensor.apply t) degree)
  };
\definition onPure: \forall (omega: LeftForms.Fiber x)(eta: RightForms.Fiber x) ->
  fiber.apply (Tensor.pure x omega eta) = Regrade.cast (Product.apply omega eta) degree :=
  \fun (omega: LeftForms.Fiber x)(eta: RightForms.Fiber x) =>
    congr!{{Spaces.Exterior[V := Sum.Fiber x, space := sum.space x].Form (N.Basic[].Def[].add p q)} {Alternating.Fiber x}}
      (\fun (a: Spaces.Exterior[V := Sum.Fiber x, space := sum.space x].Form (N.Basic[].Def[].add p q)) => Regrade.cast a degree) _ _ (Product.onTensor omega eta);
