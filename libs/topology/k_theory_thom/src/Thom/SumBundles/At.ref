\import \root.Thom[].Sum[V := F x, W := G x, left := left.space x, right := right.space x] \as Algebra;
\import Algebra.DirectSum[k := k] \as Direct;
\import Spaces.Isomorphism[V := Fiber x, W := Alternating.Fiber x, source := fiberSpace x, target := Alternating.fiberSpace x] \as Isomorphisms;
\import Isomorphisms.OfBijective[f := Direct.forward] \as Inverse;
\definition injective: Inverse.Injective := \block {
  \fun (u, v: Fiber x)(same: Direct.forward.apply u = Direct.forward.apply v) \then
  \takefrom firstFrame: First.Frame (First.rank x) x \by \bysub(N.Nat^, First.RankAt x, First.rank x) \then
  \takefrom secondFrame: Second.Frame (Second.rank x) x \by \bysub(N.Nat^, Second.RankAt x, Second.rank x) \then
  \return Algebra.Decomposition[n := First.rank x, m := Second.rank x, firstFrame := firstFrame, secondFrame := secondFrame].At[k := k].injective u v same
};
\definition surjective: Inverse.Onto := \block {
  \fun (omega: Alternating.Fiber x) \then
  \takefrom firstFrame: First.Frame (First.rank x) x \by \bysub(N.Nat^, First.RankAt x, First.rank x) \then
  \takefrom secondFrame: Second.Frame (Second.rank x) x \by \bysub(N.Nat^, Second.RankAt x, Second.rank x) \then
  \return Algebra.Decomposition[n := First.rank x, m := Second.rank x, firstFrame := firstFrame, secondFrame := secondFrame].At[k := k].surjective omega
};
\definition isomorphism: Isomorphisms.Isomorphism := Inverse.isomorphism injective surjective;
\definition inverse: Spaces.Isomorphism[V := Alternating.Fiber x, W := Fiber x, source := Alternating.fiberSpace x, target := fiberSpace x].Isomorphism :=
  Isomorphisms.inverse isomorphism;
