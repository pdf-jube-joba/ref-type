\definition leftFinite: leftMap (Points.inclusion p) = Associator.left (triple p) :=
  trans!{{Left.result.Carrier}} _ _ _
    (congr!{{BC.result.Carrier} {Left.result.Carrier}} LeftMapping.map _ _ (Multiply.onFinite p))
    (trans!{{Left.result.Carrier}} _ _ _
      (LeftMapping.onProjection (Pair.pair B.model.Carrier C.model.Carrier (FirstPoints.inclusion (first p)) (SecondPoints.inclusion (second p))))
      (congr!{{AB.result.Carrier} {Left.result.Carrier}}
        (\fun (x: AB.result.Carrier) => Left.projection (Pair.pair AB.result.Carrier C.model.Carrier x (SecondPoints.inclusion (second p)))) _ _ (FirstGraph.onFinite (first p))));
\definition rightFinite: rightMap (Points.inclusion p) = Associator.right (triple p) :=
  trans!{{Right.result.Carrier}} _ _ _
    (congr!{{AS.result.Carrier} {Right.result.Carrier}} RightMapping.map _ _ (SumGraph.onFinite p))
    (trans!{{Right.result.Carrier}} _ _ _
      (RightMapping.onProjection (Pair.pair A.model.Carrier Source.model.Carrier (BasePoints.inclusion p.base) (Points.inclusion p)))
      (congr!{{BC.result.Carrier} {Right.result.Carrier}}
        (\fun (x: BC.result.Carrier) => Right.projection (Pair.pair A.model.Carrier BC.result.Carrier (BasePoints.inclusion p.base) x)) _ _ (Multiply.onFinite p)));
\definition equation: Associated.map (Points.inclusion p) = rightMap (Points.inclusion p) :=
  trans!{{Right.result.Carrier}} _ _ _ (congr!{{Left.result.Carrier} {Right.result.Carrier}} Associator.equivalence.forward _ _ leftFinite)
    (trans!{{Right.result.Carrier}} _ _ _ (Associator.onTriple (triple p)) (sym!{{Right.result.Carrier}} _ _ rightFinite));
