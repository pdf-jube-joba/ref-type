\import \root.Thom[].FiberMultiply[X := X, F := F, G := G, left := left, right := right, sameBase := sameBase, compact := compact, hausdorff := hausdorff] \as Multiplication;
\import \root.Thom[].For[X := X, F := F, bundle := left, compact := compact, hausdorff := hausdorff] \as LeftFor;
\import \root.Thom[].For[X := X, F := G, bundle := right, compact := Multiplication.rightCompact, hausdorff := Multiplication.rightHausdorff] \as RightFor;
\import Operations.DirectSum[X := X, F := F, G := G, left := left, right := right] \as Sum;
\definition sum: Bundles.Family[X := X, F := Sum.Fiber].Bundle := Sum.bundle sameBase;
\import \root.Thom[].For[X := X, F := Sum.Fiber, bundle := sum, compact := compact, hausdorff := hausdorff] \as SumFor;
\definition rightCompact: topology.Topology[Carrier := X].IsCompact right.baseSpace := Multiplication.rightCompact;
\definition rightHausdorff: topology.Topology[Carrier := X].IsT2 right.baseSpace := Multiplication.rightHausdorff;
\definition Carrier: \Set := Multiplication.Carrier;
\definition leftThom: Multiplication.First := LeftFor.thom;
\definition rightThom: Multiplication.Second := RightFor.thom;
\definition sumThom: Carrier := SumFor.thom;
\definition product: Carrier := Multiplication.multiply leftThom rightThom;

\import \root.Thom[].MetricKoszul[X := X, F := F, bundle := left, compact := compact, hausdorff := hausdorff] \as LeftMetric;
\import \root.Thom[].MetricKoszul[X := X, F := G, bundle := right, compact := rightCompact, hausdorff := rightHausdorff] \as RightMetric;
\module Geometry;
\module Using(firstData: LeftFor.Data, secondData: RightFor.Data,
  firstMetric: LeftMetric.Metric, secondMetric: RightMetric.Metric);
