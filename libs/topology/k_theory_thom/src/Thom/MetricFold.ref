\import \root.Thom[].Koszul[X := X, F := F, bundle := bundle] \as Koszul;
\import Koszul.Coordinates[].With[selection := selection] \as Coordinates;
\import Coordinates.Finite[] \as CoordinateFinite;
\import \root.Thom[].MetricRaising[X := X, F := F, bundle := bundle, compact := compact, hausdorff := hausdorff, metric := metric, selection := selection] \as MetricRaising;
\import \root.Thom[].MetricKoszul[X := X, F := F, bundle := bundle, compact := compact, hausdorff := hausdorff].With[metric := metric] \as Metric;
\import Operations.Models[X := Koszul.Total, baseSpace := bundle.totalSpace] \as Models;
\import \root.Thom[].Finite[X := Koszul.Total, baseSpace := bundle.totalSpace].Family[
  term := Coordinates.model, differential := Coordinates.differential, domain := CoordinateFinite.domain] \as Family;
\import Family.With[squareZero := CoordinateFinite.square, exact := CoordinateFinite.exact] \as Complexes;
\import Complexes.Raising[raising := MetricRaising.raising] \as Raising;
\definition square: \forall (k: N.Nat^)(p: Koszul.Total)(v: MetricRaising.Vector k p) ->
  ((MetricRaising.raising (N.Nat^::succ k)).fiber p).apply (((MetricRaising.raising k).fiber p).apply v) = ((Models.bundle (Coordinates.model (N.Nat^::succ (N.Nat^::succ k)))).space p).zero :=
  \fun (k: N.Nat^)(p: Koszul.Total) => MetricRaising.At[p := p].square k;
\definition bottom: \forall (p: Koszul.Total)(v: MetricRaising.Vector N.Nat^::zero p) -> ((Raising.cycle N.Nat^::zero).fiber p).apply v =
  ((Models.bundle (Coordinates.model N.Nat^::zero)).space p).smul (MetricRaising.coefficient p) v := \fun (p: Koszul.Total) => MetricRaising.At[p := p].bottom;
\definition cartan: \forall (k: N.Nat^)(p: Koszul.Total)(v: MetricRaising.Vector (N.Nat^::succ k) p) ->
  ((Models.bundle (Coordinates.model (N.Nat^::succ k))).space p).add (((Raising.cycle (N.Nat^::succ k)).fiber p).apply v)
    (((MetricRaising.raising k).fiber p).apply (((Coordinates.differential k).fiber p).apply v)) =
    ((Models.bundle (Coordinates.model (N.Nat^::succ k))).space p).smul (MetricRaising.coefficient p) v :=
  \fun (k: N.Nat^)(p: Koszul.Total) => MetricRaising.At[p := p].cartan k;
\import Raising.Square[raisingSquare := square] \as Squares;
\import Raising.Cartan[coefficient := MetricRaising.coefficient, bottom := bottom, cartan := cartan] \as Cartan;
\module At(n: N.Nat^, zeroAbove: \forall (p: Koszul.Total)(omega: Koszul.Term n p) -> omega = ((Koszul.term n).space p).zero);
