\import Bundles.Trivial[X := Point, n := n, baseSpace := Base.Discrete] \as Bundle;
\import \root.Thom[].For[X := Point, F := (\fun (x: Point) => Bundles.Vector n), bundle := Bundle.bundle,
  compact := Finite.compact, hausdorff := Finite.hausdorff] \as Theory;
\definition Carrier: \Set := Theory.Carrier;
\definition thom: Carrier := Theory.thom;
\import topological_k_theory.KTheory[].On[X := Point, baseSpace := Base.Discrete, compact := Finite.compact, hausdorff := Finite.hausdorff].K0[] \as K;
\definition imageOfUnit: Carrier := Theory.forward K.one;
