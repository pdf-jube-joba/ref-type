\import Spaces.Linear[V := NegativeFiber q, W := PositiveFiber q, source := descendedNegative.space q, target := descendedPositive.space q].Operations[] \as Maps;
\import algebra.Group[].Of[Carrier := PositiveFiber q,
  group := std.Alg[].Ring[].ringModuleAsCommutativeGroup C.Complex (PositiveFiber q) Spaces.ring (descendedPositive.space q)] \as PositiveGroup;
\import Spaces.Laws[V := NegativeFiber q, space := descendedNegative.space q] \as NegativeLaws;
\definition equation: \forall (v: Fiber q) -> (bundle.space q).add
  ((grading.fiber q).apply ((operator.fiber q).apply v)) ((operator.fiber q).apply ((grading.fiber q).apply v)) = (bundle.space q).zero :=
  \fun (v: Fiber q) => P.Prop[A := PositiveFiber q, B := NegativeFiber q].ext _ _
    (trans!{{PositiveFiber q}} _ _ _
      (congr!{{PositiveFiber q} {PositiveFiber q}} ((descendedPositive.space q).add ((backward.fiber q).apply (P.second (PositiveFiber q) (NegativeFiber q) v))) _ _
        (trans!{{PositiveFiber q}} _ _ _
          (congr!{{NegativeFiber q} {PositiveFiber q}} (backward.fiber q).apply _ _ (Minus.formula q (P.second (PositiveFiber q) (NegativeFiber q) v)))
          (Maps.preservesNeg (backward.fiber q) (P.second (PositiveFiber q) (NegativeFiber q) v))))
      (PositiveGroup.inverseRight ((backward.fiber q).apply (P.second (PositiveFiber q) (NegativeFiber q) v))))
    (trans!{{NegativeFiber q}} _ _ _
      (congr!{{NegativeFiber q} {NegativeFiber q}} (\fun (w: NegativeFiber q) => (descendedNegative.space q).add w ((forward.fiber q).apply (P.first (PositiveFiber q) (NegativeFiber q) v))) _ _
        (Minus.formula q ((forward.fiber q).apply (P.first (PositiveFiber q) (NegativeFiber q) v))))
      (NegativeLaws.inverseLeft ((forward.fiber q).apply (P.first (PositiveFiber q) (NegativeFiber q) v))));
