\import From.Compare[] \as Positive;
\import To.Compare[] \as Negative;
\definition PulledPositive[x: X]: \Set := PositiveFiber (Quotient.projection x);
\definition PulledNegative[x: X]: \Set := NegativeFiber (Quotient.projection x);
\definition pulledPositiveBundle: Bundles.Family[X := X, F := PulledPositive].Bundle := Positive.pulled;
\definition pulledNegativeBundle: Bundles.Family[X := X, F := PulledNegative].Bundle := Negative.pulled;
\definition positive: Bundles.Isomorphisms[X := X, F := PulledPositive, G := F, source := pulledPositiveBundle,
  target := positiveBundle].Isomorphism := Positive.isomorphism;
\definition negative: Bundles.Isomorphisms[X := X, F := PulledNegative, G := G, source := pulledNegativeBundle,
  target := negativeBundle].Isomorphism := Negative.isomorphism;
\definition forwardCommutes: \forall (x: X)(v: PulledPositive x) ->
  (negative.forward.fiber x).apply ((forward.fiber (Quotient.projection x)).apply v) =
  (c.forward.fiber x).apply ((positive.forward.fiber x).apply v) :=
  \fun (x: X)(v: PulledPositive x) => \refl((c.forward.fiber x).apply ((positive.forward.fiber x).apply v));
\definition backwardCommutes: \forall (x: X)(v: PulledNegative x) ->
  (positive.forward.fiber x).apply ((backward.fiber (Quotient.projection x)).apply v) =
  (c.backward.fiber x).apply ((negative.forward.fiber x).apply v) :=
  \fun (x: X)(v: PulledNegative x) => \refl((c.backward.fiber x).apply ((negative.forward.fiber x).apply v));
