\import Pair.Group[] \as Group;
\import Pair.FramedTriple[F := F, sourceModel := positiveModel, n := n].With[alpha := alpha, result := r] \as Comparison;
\definition equation: Native.reduced = Framed.value := trans!{{Quotient.Relative}} _ _ _
  (congr!{{Group.Carrier} {Quotient.Relative}} Group.ToReduced[].map _ _ (Native.agreement r)) Comparison.mapEquation;
