\import Relative.PairIteration[pair := pair].Sequence[degree := N.Nat^::zero] \as Term;
\import Relative.Reduced[model := Native.quotientModel] \as Result;
\import Relative.Reduced[model := model] \as ProductGroup;
\definition forget: Result.Carrier -> ProductGroup.Carrier := Term.forget;
\definition kernel: \forall (q: Result.Carrier) -> forget q = ProductGroup.group.base.unit -> q = Result.group.base.unit := \block {
  \fun (q: Result.Carrier)(zero: _) \then
  \takefrom w: \Cast[Term.Second] ({ w: Term.Second \where Term.boundary w = q }) \by (Term.exactThird q).ltr zero \then
  \takefrom p: \Cast[Term.First] ({ p: Term.First \where Relative.NegativeMap[source := subsetModel, target := model, f := inclusion, degree := N.Nat^::succ N.Nat^::zero].map p = w }) \by
    \parent.\parent.At[degree := N.Nat^::succ N.Nat^::zero].onto w \then
  \let zeroBoundary: Term.boundary w = Term.thirdGroup.base.unit := (Term.exactSecond w).rtl
    (Logic.existsIntro[Term.First, { p: Term.First \where Term.restrictionNegative p = w }] p
      (trans!{{Term.Second}} _ _ _ (Term.restrictionNegativeFormula p)
        (\bysub(Term.First, { p: Term.First \where Relative.NegativeMap[source := subsetModel, target := model, f := inclusion, degree := N.Nat^::succ N.Nat^::zero].map p = w }, p)))) \then
  \return trans!{{Result.Carrier}} _ _ _ (sym!{{Result.Carrier}} _ _ (\bysub(Term.Second, { w: Term.Second \where Term.boundary w = q }, w))) zeroBoundary
};
\import Relative.GroupCalculus[X := Result.Carrier, group := Result.group] \as Domain;
\import Relative.GroupCalculus[X := ProductGroup.Carrier, group := ProductGroup.group] \as Range;
\import Domain.Mapping[Y := ProductGroup.Carrier, target := ProductGroup.group, f := forget, additive := Term.forgetAdd, preservesZero := Term.forgetZero] \as ForgetLaws;
\definition injective: \forall (q, r: Result.Carrier) -> forget q = forget r -> q = r :=
  \fun (q, r: Result.Carrier)(same: _) => Domain.subEqual q r
    (kernel (Domain.sub q r) (trans!{{ProductGroup.Carrier}} _ _ _ (ForgetLaws.difference q r)
      (trans!{{ProductGroup.Carrier}} _ _ _ (congr!{{ProductGroup.Carrier} {ProductGroup.Carrier}} (\fun (v: ProductGroup.Carrier) => Range.sub v (forget r)) _ _ same)
        (Range.subSelf (forget r)))));
\import Relative.Reduced[model := Left.result] \as LeftK;
\import Relative.Pullback[source := model, target := Left.result, f := Triple.leftMap] \as LeftPull;
\import Relative.Equivalence[source := Native.quotientModel, target := Left.result].With[e := equivalence].Groups[] \as Change;
\import Relative.Composition[source := model, middle := Native.quotientModel, target := Left.result,
  first := Native.projection, second := equivalence.forward] \as Composite;
\definition compositionEquation: Composite.map = Triple.leftMap :=
  \axiom:funext(Composite.map, Triple.leftMap, Comparison.onSource);
\definition formula[v: LeftK.Carrier]: LeftPull.map v = forget (Change.forward v) :=
  trans!{{ProductGroup.Carrier}} _ _ _
    (congr!{{Relative.Map model Left.result} {ProductGroup.Carrier}}
      (\fun (f: Relative.Map model Left.result) => Relative.Pullback[source := model, target := Left.result, f := f].map v)
      _ _ (sym!{{Relative.Map model Left.result}} _ _ compositionEquation))
    (trans!{{ProductGroup.Carrier}} _ _ _
      (Relative.PullbackComposition[source := model, middle := Native.quotientModel, target := Left.result,
        first := Native.projection, second := equivalence.forward].equation v)
      (sym!{{ProductGroup.Carrier}} _ _ (Term.forgetFormula (Change.forward v))));
\definition leftInjective: \forall (u, v: LeftK.Carrier) -> LeftPull.map u = LeftPull.map v -> u = v :=
  \fun (u, v: LeftK.Carrier)(same: _) => trans!{{LeftK.Carrier}} _ _ _
    (sym!{{LeftK.Carrier}} _ _ (Change.rightInverse u))
    (trans!{{LeftK.Carrier}} _ _ _
      (congr!{{Result.Carrier} {LeftK.Carrier}} Change.backward _ _
        (injective (Change.forward u) (Change.forward v)
          (trans!{{ProductGroup.Carrier}} _ _ _ (sym!{{ProductGroup.Carrier}} _ _ (formula u))
            (trans!{{ProductGroup.Carrier}} _ _ _ same (formula v)))))
      (Change.rightInverse v));
