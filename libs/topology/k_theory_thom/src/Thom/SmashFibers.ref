\import relative_k_theory.Relative[] \as Relative;
\import Relative.Smash[left := left, right := right] \as Smash;
\import Relative.Pair[X := Smash.model.Carrier, space := Smash.topology, compact := Smash.compact,
  hausdorff := Smash.hausdorff, subset := Smash.wedge, closed := Smash.wedgeClosed].Quotient[] \as Quotient;
\definition collapse: \forall (z: Smash.model.Carrier) -> \In[Smash.model.Carrier] Smash.wedge z ->
  Smash.projection z = (Relative.details Smash.result).point :=
  \fun (z: Smash.model.Carrier)(member: _) => Quotient.onSubset (\into[Smash.model.Carrier](z, Smash.wedge) \by { member });
\definition reflects: \forall (z: Smash.model.Carrier) -> Smash.projection z = (Relative.details Smash.result).point -> \In[Smash.model.Carrier] Smash.wedge z :=
  \fun (z: Smash.model.Carrier)(same: _) => Logic.orElim[z = (Relative.details Smash.model).point,
    Logic.And[\In[Smash.model.Carrier] Smash.wedge z, \In[Smash.model.Carrier] Smash.wedge (Relative.details Smash.model).point],
    \In[Smash.model.Carrier] Smash.wedge z]
    (Quotient.separates z (Relative.details Smash.model).point
      (trans!{{Smash.result.Carrier}} _ _ _ same
        (sym!{{Smash.result.Carrier}} _ _ (collapse (Relative.details Smash.model).point (Logic.Or[_, _]::left (\refl((Relative.details left).point)))))))
    (\fun (equal: _) => \idelim (Relative.details Smash.model).point = z
      \with p: Smash.model.Carrier => \In[Smash.model.Carrier] Smash.wedge p \by {
      base: Logic.Or[_, _]::left (\refl((Relative.details left).point)), equality: sym!{{Smash.model.Carrier}} _ _ equal
    })
    (\fun (both: Logic.And[\In[Smash.model.Carrier] Smash.wedge z, \In[Smash.model.Carrier] Smash.wedge (Relative.details Smash.model).point]) => both.left);
\definition separates: \forall (z, w: Smash.model.Carrier) -> Smash.projection z = Smash.projection w ->
  Logic.Or[z = w, Logic.And[\In[Smash.model.Carrier] Smash.wedge z, \In[Smash.model.Carrier] Smash.wedge w]] := Quotient.separates;
