\definition contraction: Pulled.Contraction := Pulled.Contraction {
  h := Backward.map c.h, k := Forward.map c.k, laws := \fun (y: Y) => c.laws (f y)
};
\import Original.Normalized[c := c] \as OriginalNormal;
\import Pulled.Normalized[c := contraction] \as PulledNormal;
\definition forward: \forall (y: Y)(v: Models.Fiber p.ranks (f y)) ->
  (PulledNormal.forward.fiber y).apply v = ((Forward.map OriginalNormal.forward).fiber y).apply v :=
  \fun (y: Y)(v: Models.Fiber p.ranks (f y)) => \refl((PulledNormal.forward.fiber y).apply v);
\definition backward: \forall (y: Y)(v: Models.Fiber q.ranks (f y)) ->
  (PulledNormal.backward.fiber y).apply v = ((Backward.map OriginalNormal.backward).fiber y).apply v :=
  \fun (y: Y)(v: Models.Fiber q.ranks (f y)) => \refl((PulledNormal.backward.fiber y).apply v);
