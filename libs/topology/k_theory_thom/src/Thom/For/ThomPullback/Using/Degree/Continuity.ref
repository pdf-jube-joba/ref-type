\import Bundles.Family[X := PulledKoszul.Total, F := PulledKoszul.Term k] \as Forms;
\import Bundles.Family[X := PulledKoszul.Total, F := TargetModels.Fiber Model.value.ranks] \as Vectors;
\definition forwardSame: Forward.total comparison.forward = Forward.total forwardData :=
  \axiom:funext(Forward.total comparison.forward, Forward.total forwardData,
    \fun (p: Forms.Point) => congr!{{TargetModels.Fiber Model.value.ranks p.base} Vectors.Point} (Vectors.include p.base) _ _ (forwardFormula p.base p.vector));
\definition backwardSame: Backward.total comparison.backward = Backward.total backwardData :=
  \axiom:funext(Backward.total comparison.backward, Backward.total backwardData,
    \fun (p: Vectors.Point) => congr!{{PulledKoszul.Term k p.base} Forms.Point} (Forms.include p.base) _ _ (backwardFormula p.base p.vector));
\definition forward: topology.Continuity[A := Forms.Point, B := Vectors.Point].Continuous
  (PulledKoszul.term k).totalSpace (TargetModels.bundle Model.value).totalSpace (Forward.total forwardData) :=
  \idelim Forward.total comparison.forward = Forward.total forwardData \with mapping: (Forms.Point -> Vectors.Point) =>
    topology.Continuity[A := Forms.Point, B := Vectors.Point].Continuous
      (PulledKoszul.term k).totalSpace (TargetModels.bundle Model.value).totalSpace mapping \by {
    base: Forward.continuous comparison.forward, equality: forwardSame
  };
\definition backward: topology.Continuity[A := Vectors.Point, B := Forms.Point].Continuous
  (TargetModels.bundle Model.value).totalSpace (PulledKoszul.term k).totalSpace (Backward.total backwardData) :=
  \idelim Backward.total comparison.backward = Backward.total backwardData \with mapping: (Vectors.Point -> Forms.Point) =>
    topology.Continuity[A := Vectors.Point, B := Forms.Point].Continuous
      (TargetModels.bundle Model.value).totalSpace (PulledKoszul.term k).totalSpace mapping \by {
    base: Backward.continuous comparison.backward, equality: backwardSame
  };
