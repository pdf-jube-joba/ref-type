\definition firstData: Data := Data { bound := bound, selection := firstSelection, rankBound := rankBound };
\definition secondData: Data := Data { bound := bound, selection := secondSelection, rankBound := rankBound };
\import \parent.Using[data := firstData] \as First;
\import \parent.Using[data := secondData] \as Second;
\import Coordinates.Comparison[first := firstSelection, second := secondSelection] \as Terms;
\definition sameDegree: First.degree = Second.degree := \refl(First.degree);
\import Coordinates.With[selection := firstSelection] \as FirstModel;
\import Coordinates.With[selection := secondSelection] \as SecondModel;
\import FirstModel.Finite[].At[n := First.degree, zeroAbove := First.zeroAbove] \as FirstComplex;
\import SecondModel.Finite[].At[n := Second.degree, zeroAbove := Second.zeroAbove] \as SecondComplex;
\import \root.Thom[].Finite[X := Koszul.Total, baseSpace := bundle.totalSpace] \as Finite;
\import Finite.Family[term := FirstModel.model, differential := FirstModel.differential, domain := FirstModel.Finite[].domain]
  .Comparison[targetTerm := SecondModel.model, targetDifferential := SecondModel.differential,
    isomorphism := Terms.isomorphism, commutes := Terms.commutes] \as Fold;
\import Supported.FiniteComplexes[].Homotopy[first := First.complex, second := Second.complex]
  .With[positive := (Fold.value First.degree).even, negative := (Fold.value First.degree).odd]
  .Constant[commutesD := (Fold.value First.degree).forward, commutesE := (Fold.value First.degree).backward]
  .Supported[K := Koszul.ZeroSection, compact := Total.zeroCompact,
    firstExact := FirstComplex.exactOutside, secondExact := SecondComplex.exactOutside] \as Classes;
\definition equation: First.thom = Second.thom := Classes.equation;
