\definition nextValid: Valid (N.Nat^::succ b) :=
  \fun (x: X) => Naturals.leTrans (Original.rank x) b (N.Nat^::succ b) (valid x) (Naturals.leSelfSucc b);
\definition zero: \forall (p: Koszul.Total)(omega: Koszul.Term (degreeOf b) p) -> omega = ((Koszul.term (degreeOf b)).space p).zero :=
  Koszul.Compact[compact := compact].zeroAbove b valid (degreeOf b) (degreeAbove b);
\definition zeroOne: \forall (p: Koszul.Total)(omega: Koszul.Term (N.Nat^::succ (degreeOf b)) p) -> omega = ((Koszul.term (N.Nat^::succ (degreeOf b))).space p).zero :=
  Koszul.Compact[compact := compact].zeroAbove b valid (N.Nat^::succ (degreeOf b))
    (Naturals.ltLeTrans b (degreeOf b) (N.Nat^::succ (degreeOf b)) (degreeAbove b) (Naturals.leSelfSucc (degreeOf b)));
\definition zeroTwo: \forall (p: Koszul.Total)(omega: Koszul.Term (degreeOf (N.Nat^::succ b)) p) -> omega = ((Koszul.term (degreeOf (N.Nat^::succ b))).space p).zero :=
  Koszul.Compact[compact := compact].zeroAbove (N.Nat^::succ b) nextValid (degreeOf (N.Nat^::succ b)) (degreeAbove (N.Nat^::succ b));
\import Coordinates.With[selection := selection].Padding[n := degreeOf b,
  zero := zero, zeroOne := zeroOne, zeroTwo := zeroTwo, compact := compact, hausdorff := hausdorff] \as Padding;
\definition equation: value b valid = value (N.Nat^::succ b) nextValid := Padding.equation;
