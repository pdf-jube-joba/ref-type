\definition rankAt[k: N.Nat^]: Valid (Nat.add base k) :=
  \fun (x: X) => Naturals.leTrans (Original.rank x) base (Nat.add base k) (valid x) (Naturals.leAddRight base k);
\module At(k: N.Nat^);
\definition equation: \forall (k: N.Nat^) -> value base valid = value (Nat.add base k) (rankAt k) :=
  \induction (k: N.Nat^) \return value base valid = value (Nat.add base k) (rankAt k) \with {
    | zero: \refl(value base valid)
    | succ: \fun (k: N.Nat^)(previous: value base valid = value (Nat.add base k) (rankAt k)) =>
      trans!{Carrier} _ _ _ previous At[k := k].equation
  };
