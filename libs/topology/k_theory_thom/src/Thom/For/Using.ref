\import Coordinates.With[selection := data.selection] \as Model;
\definition degree: N.Nat^ := degreeOf data.bound;
\definition aboveBound: Naturals.Lt data.bound degree := degreeAbove data.bound;
\definition zeroAbove: \forall (p: Koszul.Total)(omega: Koszul.Term degree p) -> omega = ((Koszul.term degree).space p).zero :=
  Koszul.Compact[compact := compact].zeroAbove data.bound data.rankBound degree aboveBound;
\import Model.Finite[].At[n := degree, zeroAbove := zeroAbove] \as Complex;
\definition complex: Operations.Models[X := Koszul.Total, baseSpace := bundle.totalSpace].Chains[].Complex := Complex.complex;
\import Supported.FiniteComplexes[].Of[complex := complex].Supported[K := Koszul.ZeroSection,
  compactK := Total.zeroCompact, exactOutside := Complex.exactOutside] \as Class;
\definition thom: Carrier := Class.value;
\import \parent.Product[] \as Multiplication;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := bundle.baseSpace, compact := compact, hausdorff := hausdorff].K0[] \as K;
\definition forward[a: K.Carrier]: Carrier := Multiplication.multiply a thom;
\definition additive: \forall (a, b: K.Carrier) -> forward (K.add a b) = Supported.At[degree := std.Arithmetic[].Int[].Int^::ofNat N.Nat^::zero].group.base.op (forward a) (forward b) :=
  \fun (a, b: K.Carrier) => Multiplication.additiveLeft a b thom;
