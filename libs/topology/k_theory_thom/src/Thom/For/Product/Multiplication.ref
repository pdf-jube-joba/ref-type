\import Support.On[X := External.Carrier, space := External.topology,
  hausdorff := Complement.interiorHausdorff, locallyCompact := Complement.interiorLocallyCompact].At[degree := zero] \as Result;
\definition Carrier: \Set := Result.Carrier;
\definition group: std.Alg[].Alg[].CommutativeGroup[Carrier] := Result.group;
\definition external[a: Base.At[degree := zero].Carrier][u: Supported.At[degree := zero].Carrier]: Carrier :=
  Complement.At[degree := zero].toCompactSupport (Smash.External[].product a u);
\definition additiveLeft: \forall (a, b: Base.At[degree := zero].Carrier)(u: Supported.At[degree := zero].Carrier) ->
  external (Base.At[degree := zero].group.base.op a b) u = group.base.op (external a u) (external b u) :=
  \fun (a, b: Base.At[degree := zero].Carrier)(u: Supported.At[degree := zero].Carrier) => trans!{Carrier} _ _ _
    (congr!{{Relative.Reduced[model := Smash.result].Carrier} Carrier} Complement.At[degree := zero].toCompactSupport _ _
      (Smash.External[].additiveLeft a b u))
    (Complement.At[degree := zero].additive (Smash.External[].product a u) (Smash.External[].product b u));
\definition additiveRight: \forall (a: Base.At[degree := zero].Carrier)(u, v: Supported.At[degree := zero].Carrier) ->
  external a (Supported.At[degree := zero].group.base.op u v) = group.base.op (external a u) (external a v) :=
  \fun (a: Base.At[degree := zero].Carrier)(u, v: Supported.At[degree := zero].Carrier) => trans!{Carrier} _ _ _
    (congr!{{Relative.Reduced[model := Smash.result].Carrier} Carrier} Complement.At[degree := zero].toCompactSupport _ _
      (Smash.External[].additiveRight a u v))
    (Complement.At[degree := zero].additive (Smash.External[].product a u) (Smash.External[].product a v));
