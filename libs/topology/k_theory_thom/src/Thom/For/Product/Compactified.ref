\import Relative.Composition[source := Supported.model, middle := Complement.model, target := Smash.result,
  first := Pullback.mapping, second := Complement.equivalence.backward] \as Composite;
\definition map: Relative.Map Supported.model Smash.result := Composite.map;
\import Relative.Pullback[source := Supported.model, target := Smash.result, f := map] \as Native;
\definition formula: \forall (a: K.Carrier)(u: Carrier) -> multiply a u = Native.map (Smash.External[].product (Coefficient.forward a) u) :=
  \fun (a: K.Carrier)(u: Carrier) => sym!{Carrier} _ _
    (Relative.PullbackComposition[source := Supported.model, middle := Complement.model, target := Smash.result,
      first := Pullback.mapping, second := Complement.equivalence.backward].equation (Smash.External[].product (Coefficient.forward a) u));
\import Support.OnePoint[X := Koszul.Total, space := bundle.totalSpace] \as Points;
\import Support.OnePoint[X := X, space := bundle.baseSpace] \as BasePoints;
\import std.Data[].Pair[] \as Pair;
\definition onFinite: \forall (p: Koszul.Total) -> map (Points.inclusion p) =
  Smash.projection (Pair.pair BasePoints.Carrier Points.Carrier (BasePoints.inclusion p.base) (Points.inclusion p)) :=
  \fun (p: Koszul.Total) => Complement.backwardOnInterior (diagonal p);
