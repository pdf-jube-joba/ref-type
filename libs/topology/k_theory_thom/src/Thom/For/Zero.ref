\import std.Alg[].Alg[] \as Alg;
\import algebra.Groups[].On[G := K.Carrier, group := Alg.asGroup K.Carrier K.group] \as Source;
\import relative_k_theory.Relative[].Reduced[model := Supported.model] \as Target;
\import algebra.Groups[].On[G := Carrier, group := Alg.asGroup Carrier Target.group] \as Result;
\definition idempotent: forward K.zero = Target.group.base.op (forward K.zero) (forward K.zero) :=
  trans!{Carrier} _ _ _
    (congr!{{K.Carrier} Carrier} forward _ _ (sym!{{K.Carrier}} _ _ (Source.oneLeft K.zero)))
    (additive K.zero K.zero);
\definition equation: forward K.zero = Target.group.base.unit :=
  sym!{Carrier} _ _ (Result.cancelLeft (forward K.zero) Target.group.base.unit (forward K.zero)
    (trans!{Carrier} _ _ _ (Result.oneRight (forward K.zero)) idempotent));
