\use Equality.eq_reason_in;
\import relative_k_theory.Relative[] \as Relative;
\import compact_support_k.Support[] \as Support;
\import std.Arithmetic[].Int[] \as I;
\definition zero: I.Int^ := I.Int^::ofNat N.Nat^::zero;
\definition base[x: X]: X := x;
\definition baseRegular: topology.Continuity[A := X, B := X].Continuous bundle.baseSpace target.baseSpace base :=
  \idelim bundle.baseSpace = target.baseSpace \with space: topology.Topology[Carrier := X].Topology =>
    topology.Continuity[A := X, B := X].Continuous bundle.baseSpace space base \by {
    base: topology.Maps[A := X, B := X].Identity[].continuous bundle.baseSpace, equality: sameBase
  };
\import Bundles.Family[X := X, F := F] \as SourceFamily;
\import CompactPull.At[degree := zero] \as Pull;
\import TargetFor.Product[] \as TargetProduct;
\import TargetProduct.Compactified[] \as TargetCompactified;
\import OriginalFor.Product[] \as SourceProduct;
\import SourceProduct.Compactified[] \as SourceCompactified;
\import \root.Thom[].CompactCoefficient[X := X, space := target.baseSpace, compact := targetCompact, hausdorff := targetHausdorff]
  .Pullback[Y := X, source := bundle.baseSpace, sourceCompact := compact, sourceHausdorff := hausdorff, f := base, regular := baseRegular] \as CoefficientPullback;
\definition sourceLocal: topology.LocallyCompact[A := X].IsLocallyCompact bundle.baseSpace :=
  topology.LocallyCompact[A := X].compactLocallyCompact bundle.baseSpace compact;
\import Support.On[X := X, space := bundle.baseSpace, hausdorff := hausdorff, locallyCompact := sourceLocal] \as SourceBase;
\import Support.On[X := X, space := target.baseSpace, hausdorff := targetHausdorff,
  locallyCompact := topology.LocallyCompact[A := X].compactLocallyCompact target.baseSpace targetCompact] \as TargetBase;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := target.baseSpace, compact := targetCompact, hausdorff := targetHausdorff].K0[] \as TargetK;
\import Relative.Smash[left := SourceBase.model, right := Supported.model] \as SourceSmash;
\import Relative.Smash[left := TargetBase.model, right := TargetSupport.model] \as TargetSmash;
\import SourceSmash.Mapping[targetLeft := TargetBase.model, targetRight := TargetSupport.model,
  f := CoefficientPullback.mapping, g := CompactPull.mapping] \as SmashMapping;
\import Relative.Composition[source := Supported.model, middle := TargetSupport.model, target := TargetSmash.result,
  first := CompactPull.mapping, second := TargetCompactified.map] \as Left;
\import Relative.Composition[source := Supported.model, middle := SourceSmash.result, target := TargetSmash.result,
  first := SourceCompactified.map, second := SmashMapping.map] \as Right;
\import algebraic_topology.Pointed[A := Supported.model.Carrier].Maps[B := TargetSmash.result.Carrier] \as Maps;
\import Support.OnePoint[X := SourceFamily.Point, space := bundle.totalSpace] \as Points;
\import Support.OnePoint[X := X, space := bundle.baseSpace] \as BasePoints;
\import std.Data[].Pair[] \as Pair;
\definition functions: Left.map = Right.map := \axiom:funext(Left.map, Right.map,
  \induction (p: Points.Carrier) \return Left.map p = Right.map p \with {
    | none: trans!{{TargetSmash.result.Carrier}} _ _ _
      (Maps.laws (Relative.pointed Supported.model) (Relative.pointed TargetSmash.result) Left.map).pointed
      (sym!{{TargetSmash.result.Carrier}} _ _ (Maps.laws (Relative.pointed Supported.model) (Relative.pointed TargetSmash.result) Right.map).pointed)
    | some: \fun (p: SourceFamily.Point) => trans!{{TargetSmash.result.Carrier}} _ _ _
      (TargetCompactified.onFinite (Natural.total p))
      (sym!{{TargetSmash.result.Carrier}} _ _ (trans!{{TargetSmash.result.Carrier}} _ _ _
        (congr!{{SourceSmash.result.Carrier} {TargetSmash.result.Carrier}} SmashMapping.map _ _ (SourceCompactified.onFinite p))
        (SmashMapping.onProjection (Pair.pair BasePoints.Carrier Points.Carrier (BasePoints.inclusion p.base) (Points.inclusion p)))))
  });
\import Relative.Pullback[source := Supported.model, target := TargetSmash.result, f := Left.map] \as LeftPull;
\import Relative.Pullback[source := Supported.model, target := TargetSmash.result, f := Right.map] \as RightPull;
\import Relative.Pullback[source := SourceSmash.result, target := TargetSmash.result, f := SmashMapping.map] \as ExternalPull;
\import Relative.Pullback[source := Supported.model, target := SourceSmash.result, f := SourceCompactified.map] \as SourcePairing;
\import Relative.Pullback[source := TargetSupport.model, target := TargetSmash.result, f := TargetCompactified.map] \as TargetPairing;
\import Relative.Pullback[source := SourceBase.model, target := TargetBase.model, f := CoefficientPullback.mapping] \as BasePull;
\import \root.Thom[].CompactCoefficient[X := X, space := target.baseSpace, compact := targetCompact, hausdorff := targetHausdorff] \as TargetCoefficient;
\import \root.Thom[].CompactCoefficient[X := X, space := bundle.baseSpace, compact := compact, hausdorff := hausdorff] \as SourceCoefficient;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := target.baseSpace, compact := targetCompact, hausdorff := targetHausdorff]
  .Pullback[Y := X, space := bundle.baseSpace, sourceCompact := compact, sourceHausdorff := hausdorff, f := base, regular := baseRegular].K0[] \as OrdinaryPull;
\definition coefficient: TargetK.Carrier -> K.Carrier := OrdinaryPull.map;
\definition equation: \forall (a: TargetK.Carrier)(u: TargetFor.Carrier) -> pull (TargetProduct.multiply a u) = SourceProduct.multiply (OrdinaryPull.map a) (pull u) :=
  \fun (a: TargetK.Carrier)(u: TargetFor.Carrier) => eq_reason_in!{{OriginalFor.Carrier} _
    "=" { Pull.map (TargetPairing.map (TargetSmash.External[].product (TargetCoefficient.forward a) u)) } "by" {
      congr!{{TargetFor.Carrier} {OriginalFor.Carrier}} Pull.map _ _ (TargetCompactified.formula a u) }
    "=" { LeftPull.map (TargetSmash.External[].product (TargetCoefficient.forward a) u) } "by" {
      sym!{{OriginalFor.Carrier}} _ _ (Relative.PullbackComposition[source := Supported.model, middle := TargetSupport.model, target := TargetSmash.result,
        first := CompactPull.mapping, second := TargetCompactified.map].equation (TargetSmash.External[].product (TargetCoefficient.forward a) u)) }
    "=" { RightPull.map (TargetSmash.External[].product (TargetCoefficient.forward a) u) } "by" {
      congr!{{Relative.Map Supported.model TargetSmash.result} {OriginalFor.Carrier}}
        (\fun (h: Relative.Map Supported.model TargetSmash.result) => Relative.Pullback[source := Supported.model, target := TargetSmash.result, f := h].map (TargetSmash.External[].product (TargetCoefficient.forward a) u)) _ _ functions }
    "=" { SourcePairing.map (ExternalPull.map (TargetSmash.External[].product (TargetCoefficient.forward a) u)) } "by" {
      Relative.PullbackComposition[source := Supported.model, middle := SourceSmash.result, target := TargetSmash.result,
        first := SourceCompactified.map, second := SmashMapping.map].equation (TargetSmash.External[].product (TargetCoefficient.forward a) u) }
    "=" { SourcePairing.map (SourceSmash.External[].product (BasePull.map (TargetCoefficient.forward a)) (Pull.map u)) } "by" {
      congr!{{Relative.Reduced[model := SourceSmash.result].Carrier} {OriginalFor.Carrier}} SourcePairing.map _ _
        (SmashMapping.External[].naturality (TargetCoefficient.forward a) u) }
    "=" { SourcePairing.map (SourceSmash.External[].product (SourceCoefficient.forward (OrdinaryPull.map a)) (Pull.map u)) } "by" {
      congr!{{SourceBase.At[degree := zero].Carrier} {OriginalFor.Carrier}}
        (\fun (c: SourceBase.At[degree := zero].Carrier) => SourcePairing.map (SourceSmash.External[].product c (Pull.map u))) _ _ (CoefficientPullback.equation a) }
    "=" _ "by" { sym!{{OriginalFor.Carrier}} _ _ (SourceCompactified.formula (OrdinaryPull.map a) (Pull.map u)) }
  };
