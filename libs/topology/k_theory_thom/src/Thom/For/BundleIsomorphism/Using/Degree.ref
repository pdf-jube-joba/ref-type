\import \root.Thom[].KoszulIsomorphism[X := X, F := F, G := G, left := bundle, right := target, sameBase := sameBase, iso := iso].Degree[k := k] \as Raw;
\import OldModels.Pullback[b := OldModel.model k, Y := Koszul.Total, source := bundle.totalSpace, f := Natural.total, regular := Natural.continuous] \as Pull;
\definition model: Models.Bundle := Pull.value;
\import Complements.PulledIsomorphism[X := TargetKoszul.Total, Y := Koszul.Total, F := TargetKoszul.Term k,
  G := OldModels.Fiber (OldModel.model k).ranks, source := TargetKoszul.term k, target := OldModels.bundle (OldModel.model k),
  base := bundle.totalSpace, f := Natural.total, sourceRegular := Natural.continuous, targetRegular := Natural.continuous] \as CoordinatePull;
\import Bundles.Isomorphisms[X := Koszul.Total, F := Raw.Fiber, G := Koszul.Term k, source := Raw.pulled, target := Koszul.term k] \as Reverse;
\import Operations.IsomorphismComposition[X := Koszul.Total, F := Koszul.Term k, G := Raw.Fiber, H := Models.Fiber model.ranks,
  source := Koszul.term k, middle := Raw.pulled, target := Models.bundle model] \as Compose;
\definition isomorphism: Bundles.Isomorphisms[X := Koszul.Total, F := Koszul.Term k, G := Models.Fiber model.ranks,
  source := Koszul.term k, target := Models.bundle model].Isomorphism :=
  Compose.compose (Reverse.inverse Raw.isomorphism) (CoordinatePull.isomorphism (data.selection k).isomorphism);
\definition choice: Coordinates.Choice k := Models.From[F := Koszul.Term k, original := Koszul.term k].Result {
  model := model, isomorphism := isomorphism
};
