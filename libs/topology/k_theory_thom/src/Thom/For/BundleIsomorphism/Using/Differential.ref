\import \root.Thom[].KoszulIsomorphism[X := X, F := F, G := G, left := bundle, right := target, sameBase := sameBase, iso := iso].Degree[k := k] \as Raw;
\import \root.Thom[].KoszulIsomorphism[X := X, F := F, G := G, left := bundle, right := target, sameBase := sameBase, iso := iso].Differential[k := k] \as RawDifferential;
\import OldModels.PullbackMap[p := OldModel.model (N.Nat^::succ k), q := OldModel.model k,
  Y := Koszul.Total, source := bundle.totalSpace, f := Natural.total, regular := Natural.continuous] \as Pull;
\definition equation: \forall (p: Koszul.Total)(v: SourceModel.Vector (N.Nat^::succ k) p) ->
  ((SourceModel.differential k).fiber p).apply v = ((Pull.map (OldModel.differential k)).fiber p).apply v :=
  \fun (p: Koszul.Total)(v: SourceModel.Vector (N.Nat^::succ k) p) => trans!{{SourceModel.Vector k p}} _ _ _
    (congr!{{Koszul.Term k p} {SourceModel.Vector k p}}
      (\fun (omega: Koszul.Term k p) => (OldModel.encode k (Natural.total p)).apply ((Raw.isomorphism.backward.fiber p).apply omega)) _ _
      (RawDifferential.commutes p ((OldModel.decode (N.Nat^::succ k) (Natural.total p)).apply v)))
    (congr!{{Raw.Fiber p} {SourceModel.Vector k p}} (OldModel.encode k (Natural.total p)).apply _ _ (Raw.isomorphism.leftInverse p _));
