\definition fiber: Spaces.Isomorphism[V := F x, W := G x, source := bundle.space x, target := target.space x].Isomorphism :=
  Spaces.Isomorphism[V := F x, W := G x, source := bundle.space x, target := target.space x].Isomorphism {
    forward := iso.forward.fiber x, backward := iso.backward.fiber x, leftInverse := iso.leftInverse x, rightInverse := iso.rightInverse x
  };
\import Spaces.Isomorphism[V := G x, W := Bundles.Vector (TargetBundle.rank x), source := target.space x,
  target := Bundles.coordinates (TargetBundle.rank x)].Composition[U := F x, domain := bundle.space x] \as Compose;
\definition equation: Original.rank x = TargetBundle.rank x := \block {
  \takefrom frame: TargetBundle.Frame (TargetBundle.rank x) x \by \bysub(N.Nat^, TargetBundle.RankAt x, TargetBundle.rank x) \then
  \return Original.rankFrame x (TargetBundle.rank x) (Compose.compose frame fiber)
};
