\import compact_support_k.Support[].Homeomorphic[A := Koszul.Total, B := TargetKoszul.Total,
  source := bundle.totalSpace, target := target.totalSpace, h := totalHomeomorphism].Extension[] \as Extension;
\import algebraic_topology.Pointed[A := TargetSupport.model.Carrier].Maps[B := Supported.model.Carrier] \as Maps;
\definition backwardMap: Relative.Map TargetSupport.model Supported.model :=
  \into[TargetSupport.model.Carrier -> Supported.model.Carrier](Extension.homeomorphism.backward, Relative.Map TargetSupport.model Supported.model) \by {
    Maps.Laws[Relative.pointed TargetSupport.model, Relative.pointed Supported.model, Extension.homeomorphism.backward] {
      continuous := Extension.homeomorphism.backwardContinuous, pointed := \refl((Relative.details Supported.model).point)
    }
  };
\import Relative.Equivalence[source := Supported.model, target := TargetSupport.model] \as Equivalence;
\definition equivalence: Equivalence.Data := Equivalence.Data {
  forward := CompactPull.mapping, backward := backwardMap,
  leftInverse := Extension.leftInverse, rightInverse := Extension.rightInverse
};
\import Equivalence.With[e := equivalence].Groups[] \as Groups;
\definition backward: Carrier -> TargetFor.Carrier := Groups.backward;
\definition leftInverse: \forall (u: Carrier) -> pull (backward u) = u := Groups.leftInverse;
\definition rightInverse: \forall (u: TargetFor.Carrier) -> backward (pull u) = u := Groups.rightInverse;
\definition additive: \forall (u, v: Carrier) -> backward (Relative.Reduced[model := Supported.model].group.base.op u v) =
  Relative.Reduced[model := TargetSupport.model].group.base.op (backward u) (backward v) := Groups.inverseAdditive;
