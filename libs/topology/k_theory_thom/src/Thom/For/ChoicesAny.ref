\definition middle: Data := Data { bound := first.bound, selection := second.selection, rankBound := first.rankBound };
\import \parent.Using[data := first] \as First;
\import \parent.Using[data := second] \as Second;
\import \parent.Using[data := middle] \as Middle;
\import \parent.Choices[bound := first.bound, firstSelection := first.selection, secondSelection := second.selection,
  rankBound := first.rankBound] \as Selections;
\import \parent.Bounds[firstBound := first.bound, secondBound := second.bound, selection := second.selection,
  firstRankBound := first.rankBound, secondRankBound := second.rankBound] \as Caps;
\definition equation: First.thom = Second.thom := trans!{Carrier} _ _ _ Selections.equation Caps.equation;
