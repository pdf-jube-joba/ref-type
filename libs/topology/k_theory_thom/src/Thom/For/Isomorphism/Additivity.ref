\import std.Alg[].Alg[] \as Alg;
\import algebra.Groups[].On[G := K.Carrier, group := Alg.asGroup K.Carrier K.group] \as Source;
\import Relative.Reduced[model := Supported.model] \as Target;
\import algebra.Groups[].On[G := Target.Carrier, group := Alg.asGroup Target.Carrier Target.group] \as Result;
\definition forwardZero: forward K.zero = Target.group.base.unit :=
  sym!{Carrier} _ _ (Result.cancelLeft (forward K.zero) Target.group.base.unit (forward K.zero)
    (trans!{Carrier} _ _ _ (Result.oneRight (forward K.zero))
      (trans!{Carrier} _ _ _ (congr!{{K.Carrier} Carrier} forward _ _ (sym!{{K.Carrier}} _ _ (Source.oneLeft K.zero))) (additive K.zero K.zero))));
\definition backwardAdd: \forall (u, v: Carrier) -> backward (Target.group.base.op u v) = K.add (backward u) (backward v) :=
  \fun (u, v: Carrier) => injective _ _
    (trans!{Carrier} _ _ _ (rightInverse (Target.group.base.op u v))
      (sym!{Carrier} _ _ (trans!{Carrier} _ _ _ (additive (backward u) (backward v))
        (congr!{Carrier Carrier Carrier} Target.group.base.op _ _ _ _ (rightInverse u) (rightInverse v)))));
\definition backwardZero: backward Target.group.base.unit = K.zero := injective _ _
  (trans!{Carrier} _ _ _ (rightInverse Target.group.base.unit) (sym!{Carrier} _ _ forwardZero));
\definition data: Periodicity.Isomorphism[A := K.Carrier, B := Carrier, source := K.group, target := Target.group].Data :=
  Periodicity.Isomorphism[A := K.Carrier, B := Carrier, source := K.group, target := Target.group].Data {
    forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
    forwardAdd := additive, backwardAdd := backwardAdd, forwardZero := forwardZero, backwardZero := backwardZero
  };
