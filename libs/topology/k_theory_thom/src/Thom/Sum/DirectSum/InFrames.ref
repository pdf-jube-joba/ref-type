\module Extraction(d: Bidegree);
\definition injective[x, y: Carrier][same: forward.apply x = forward.apply y]: x = y :=
  extensionality x y (\fun (d: Bidegree) => trans!{{family.Carrier d}} _ _ _
    (sym!{{family.Carrier d}} _ _ (Extraction[d := d].recovery x))
    (trans!{{family.Carrier d}} _ _ _
      (congr!{{Exterior.Form k} {family.Carrier d}} (Extraction[d := d].backward).apply _ _ same)
      (Extraction[d := d].recovery y)));
