\import \parent.\parent.\parent.At[d := e] \as OtherInclusion;
\import Regraded.Other[a := e.p, b := e.q, otherDegree := degree e] \as Vanishing;
\definition equation[different: Logic.Not (e = d)][x: family.Carrier e]:
  composite.apply (OtherInclusion.injection.apply x) = Inclusion.projection.apply (OtherInclusion.injection.apply x) :=
  trans!{{Factor.Carrier}} _ _ _
    (trans!{{Factor.Carrier}} _ _ _
      (congr!{{Exterior.Form k} {Factor.Carrier}} backward.apply _ _ (OtherInclusion.onInjection x))
      (Vanishing.vanishes (differentLeft d e (\fun (same: d = e) => different (sym!{Bidegree} _ _ same))) x))
    (sym!{{Factor.Carrier}} _ _ (Inclusion.projectionOther e x different));
