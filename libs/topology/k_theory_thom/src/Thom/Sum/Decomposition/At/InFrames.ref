\import Direct.InFrames[n := n, m := m, firstFrame := firstFrame, secondFrame := secondFrame,
  firstEnumeration := firstEnumeration, secondEnumeration := secondEnumeration] \as Injection;
\import Spaces.Isomorphism[V := Direct.Carrier, W := Exterior.Form k, source := Direct.space, target := Result.vectorSpace] \as Isomorphisms;
\import Isomorphisms.OfBijective[f := Direct.forward] \as Inverse;
\definition isomorphism: Isomorphisms.Isomorphism := Inverse.isomorphism Injection.injective surjective;
