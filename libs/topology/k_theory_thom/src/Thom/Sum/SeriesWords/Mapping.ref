\import \parent.\parent.SeriesWords[I := I, A := B, covector := \fun (b: B) => covector (f b)] \as Before;
\definition law: \forall (xs: Lists.List[B]) -> value (Lists.map B A f xs) = Before.value xs :=
  \induction (xs: Lists.List[B]) \return value (Lists.map B A f xs) = Before.value xs \with {
    | nil: \refl(Series.unit)
    | cons: \fun (head: B)(tail: Lists.List[B])(previous: _) =>
      congr!{{Series.Function} {Series.Function}} (Series.product (covector (f head))) _ _ previous
  };
