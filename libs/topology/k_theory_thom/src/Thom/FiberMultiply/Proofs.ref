\import \root.Thom[].FiberMultiply[X := X, F := F, G := G, left := left, right := right, sameBase := otherSameBase,
  compact := otherCompact, hausdorff := otherHausdorff] \as Other;
\import algebraic_topology.Pointed[A := Result.model.Carrier].Maps[B := Smash.result.Carrier] \as Pointed;
\definition maps: Other.mapping = mapping := \axiom:funext(Other.mapping, mapping,
  \induction (p: Points.Carrier) \return Other.mapping p = mapping p \with {
    | none: trans!{{Smash.result.Carrier}} _ _ _
      ((Pointed.laws (Relative.pointed Result.model) (Relative.pointed Smash.result) Other.mapping).pointed)
      (sym!{{Smash.result.Carrier}} _ _ ((Pointed.laws (Relative.pointed Result.model) (Relative.pointed Smash.result) mapping).pointed))
    | some: \fun (p: SumFamily.Point) => trans!{{Smash.result.Carrier}} _ _ _ (Other.onFinite p) (sym!{{Smash.result.Carrier}} _ _ (onFinite p))
  });
\definition equation: \forall (a: First)(b: Second) -> Other.multiply a b = multiply a b :=
  \fun (a: First)(b: Second) => trans!{Carrier} _ _ _ (Other.formula a b)
    (trans!{Carrier} _ _ _
      (congr!{{Relative.Map Result.model Smash.result} Carrier}
        (\fun (f: Relative.Map Result.model Smash.result) => Relative.Pullback[source := Result.model, target := Smash.result, f := f].map (Smash.External[].product a b)) _ _ maps)
      (sym!{Carrier} _ _ (formula a b)));
