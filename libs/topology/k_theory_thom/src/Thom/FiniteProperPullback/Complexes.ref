\import Original.FiniteComplexes[].Of[complex := first] \as First;
\import Source.FiniteComplexes[].Of[complex := second] \as Second;
\import Models.Chains[].Of[complex := first] \as FirstChain;
\import TargetModels.Chains[].Of[complex := second] \as SecondChain;
\import Models.Pullback[b := First.even, Y := Y, source := target, f := f, regular := regular] \as Positive;
\import Models.Pullback[b := First.odd, Y := Y, source := target, f := f, regular := regular] \as Negative;
\import Models.PullbackMap[p := First.even, q := First.odd, Y := Y, source := target, f := f, regular := regular] \as D;
\import Models.PullbackMap[p := First.odd, q := First.even, Y := Y, source := target, f := f, regular := regular] \as E;
\import Bundles.Isomorphisms[X := Y, F := (\fun (y: Y) => First.Even (f y)), G := Second.Even,
  source := TargetModels.bundle Positive.value, target := TargetModels.bundle Second.even] \as Positives;
\import Bundles.Isomorphisms[X := Y, F := (\fun (y: Y) => First.Odd (f y)), G := Second.Odd,
  source := TargetModels.bundle Negative.value, target := TargetModels.bundle Second.odd] \as Negatives;
\module With(positive: Positives.Isomorphism, negative: Negatives.Isomorphism,
  commutesD: \forall (y: Y)(v: First.Even (f y)) -> (Second.d.fiber y).apply ((positive.forward.fiber y).apply v) =
    (negative.forward.fiber y).apply (((D.map First.d).fiber y).apply v),
  commutesE: \forall (y: Y)(v: First.Odd (f y)) -> (Second.e.fiber y).apply ((negative.forward.fiber y).apply v) =
    (positive.forward.fiber y).apply (((E.map First.e).fiber y).apply v));
