\definition pStart: PStart.Isomorphism := PStart.compose (PReverse.inverse POriginal.isomorphism) PGlobal.isomorphism;
\import Operations.IsomorphismComposition[X := TargetLocal.Carrier, F := (\fun (z: TargetLocal.Carrier) => First.Even (f z)),
  G := (\fun (z: TargetLocal.Carrier) => First.Even (f z)), H := SecondLocal.FirstFiber,
  source := TargetPair.BundleModel[F := Triples.FirstFiber].bundle Triples.firstModelOnSource, middle := PGlobal.nested, target := TargetPair.BundleModel[F := SecondLocal.FirstFiber].bundle SecondLocal.firstOnLocal] \as PFinish;
\definition positive: Bundles.Isomorphisms[X := TargetLocal.Carrier, F := (\fun (z: TargetLocal.Carrier) => First.Even (f z)), G := SecondLocal.FirstFiber,
  source := TargetPair.BundleModel[F := Triples.FirstFiber].bundle Triples.firstModelOnSource, target := TargetPair.BundleModel[F := SecondLocal.FirstFiber].bundle SecondLocal.firstOnLocal].Isomorphism := PFinish.compose pStart (PPull.isomorphism originalPositive);
