  .Of[fRegular := OriginalLocal.regular, gRegular := Localization.regular] \as POriginal;
\import Bundles.Family[X := X, F := First.Even].Of[bundle := Models.bundle First.even].PullbackComposition[
  Y := Y, Z := TargetLocal.Carrier, first := target, second := TargetLocal.topology, f := f, g := TargetLocal.inclusion]
  .Of[fRegular := regular, gRegular := TargetLocal.regular] \as PGlobal;
\import Complements.PulledIsomorphism[X := Y, Y := TargetLocal.Carrier, F := (\fun (y: Y) => First.Even (f y)), G := Second.Even,
  source := TargetModels.bundle Positive.value, target := TargetModels.bundle Second.even, base := TargetLocal.topology,
  f := TargetLocal.inclusion, sourceRegular := TargetLocal.regular, targetRegular := TargetLocal.regular] \as PPull;
\import Bundles.Isomorphisms[X := TargetLocal.Carrier, F := (\fun (z: TargetLocal.Carrier) => First.Even (f z)),
  G := (\fun (z: TargetLocal.Carrier) => First.Even (f z)), source := POriginal.direct, target := POriginal.nested] \as PReverse;
\import Operations.IsomorphismComposition[X := TargetLocal.Carrier, F := (\fun (z: TargetLocal.Carrier) => First.Even (f z)),
  G := (\fun (z: TargetLocal.Carrier) => First.Even (f z)), H := (\fun (z: TargetLocal.Carrier) => First.Even (f z)),
