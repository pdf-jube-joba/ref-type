\import topology.Maps[A := Y, B := X] \as Maps;
\definition support: \Pow Y := Maps.Preimage f K;
\definition compactSupport: topology.Topology[Carrier := Y].IsCompactIn target support := proper K compactK;
\import First.Supported[K := K, compactK := compactK, exactOutside := firstExact] \as FirstClass;
\import Second.Supported[K := support, compactK := compactSupport, exactOutside := secondExact] \as SecondClass;
\import Original.Neighborhood[K := K, compact := compactK] \as OriginalNeighbors;
\import Source.Neighborhood[K := support, compact := compactSupport] \as SourceNeighbors;
\module In(w: OriginalNeighbors.Witness);
\definition equation: SecondClass.value = Relative.Pullback[source := Source.model, target := Original.model, f := Pull.mapping].map FirstClass.value := \block {
  \takefrom w: OriginalNeighbors.Witness \by OriginalNeighbors.existence \then
  \return trans!{{Relative.Reduced[model := Source.model].Carrier}} _ _ _ (SecondClass.agreement In[w := w].witness)
    (trans!{{Relative.Reduced[model := Source.model].Carrier}} _ _ _ In[w := w].equation
      (congr!{{Relative.Reduced[model := Original.model].Carrier} {Relative.Reduced[model := Source.model].Carrier}}
        Relative.Pullback[source := Source.model, target := Original.model, f := Pull.mapping].map _ _
        (sym!{{Relative.Reduced[model := Original.model].Carrier}} _ _ (FirstClass.agreement w))))
};
