\import Bundles.Family[X := X, F := First.Even].Of[bundle := Models.bundle First.even].PullbackComposition[
  Y := OriginalPair.A, Z := TargetPair.A, first := OriginalPair.subspace, second := TargetPair.subspace, f := FirstLocal.boundaryInclusion, g := boundary]
  .Of[fRegular := FirstLocal.boundaryRegular, gRegular := boundaryRegular] \as POriginal;
\import Bundles.Family[X := X, F := First.Even].Of[bundle := Models.bundle First.even].PullbackComposition[
  Y := Y, Z := TargetPair.A, first := target, second := TargetPair.subspace, f := f, g := SecondLocal.boundaryInclusion]
  .Of[fRegular := regular, gRegular := SecondLocal.boundaryRegular] \as PGlobal;
\import Complements.PulledIsomorphism[X := Y, Y := TargetPair.A, F := (\fun (y: Y) => First.Even (f y)), G := Second.Even,
  source := TargetModels.bundle Positive.value, target := TargetModels.bundle Second.even, base := TargetPair.subspace,
  f := SecondLocal.boundaryInclusion, sourceRegular := SecondLocal.boundaryRegular, targetRegular := SecondLocal.boundaryRegular] \as PPull;
\import Bundles.Isomorphisms[X := TargetPair.A, F := (\fun (z: TargetPair.A) => First.Even (f z)),
  G := (\fun (z: TargetPair.A) => First.Even (f z)), source := POriginal.direct, target := POriginal.nested] \as PReverse;
\import Operations.IsomorphismComposition[X := TargetPair.A, F := (\fun (z: TargetPair.A) => First.Even (f z)),
  G := (\fun (z: TargetPair.A) => First.Even (f z)), H := (\fun (z: TargetPair.A) => First.Even (f z)),
  source := Operations.Models[X := TargetPair.A, baseSpace := TargetPair.subspace].bundle OldPositive.value, middle := POriginal.direct, target := PGlobal.nested] \as PStart;
\definition pStart: PStart.Isomorphism := PStart.compose (PReverse.inverse POriginal.isomorphism) PGlobal.isomorphism;
\import Operations.IsomorphismComposition[X := TargetPair.A, F := (\fun (z: TargetPair.A) => First.Even (f z)),
  G := (\fun (z: TargetPair.A) => First.Even (f z)), H := (\fun (z: TargetPair.A) => Second.Even z),
  source := Operations.Models[X := TargetPair.A, baseSpace := TargetPair.subspace].bundle OldPositive.value, middle := PGlobal.nested, target := Operations.Models[X := TargetPair.A, baseSpace := TargetPair.subspace].bundle SecondLocal.boundaryEvenModel] \as PFinish;
\definition positive: Bundles.Isomorphisms[X := TargetPair.A, F := (\fun (z: TargetPair.A) => First.Even (f z)), G := (\fun (z: TargetPair.A) => Second.Even z),
  source := Operations.Models[X := TargetPair.A, baseSpace := TargetPair.subspace].bundle OldPositive.value, target := Operations.Models[X := TargetPair.A, baseSpace := TargetPair.subspace].bundle SecondLocal.boundaryEvenModel].Isomorphism := PFinish.compose pStart (PPull.isomorphism originalPositive);
\import Bundles.Family[X := X, F := First.Odd].Of[bundle := Models.bundle First.odd].PullbackComposition[
  Y := OriginalPair.A, Z := TargetPair.A, first := OriginalPair.subspace, second := TargetPair.subspace, f := FirstLocal.boundaryInclusion, g := boundary]
  .Of[fRegular := FirstLocal.boundaryRegular, gRegular := boundaryRegular] \as QOriginal;
\import Bundles.Family[X := X, F := First.Odd].Of[bundle := Models.bundle First.odd].PullbackComposition[
  Y := Y, Z := TargetPair.A, first := target, second := TargetPair.subspace, f := f, g := SecondLocal.boundaryInclusion]
  .Of[fRegular := regular, gRegular := SecondLocal.boundaryRegular] \as QGlobal;
\import Complements.PulledIsomorphism[X := Y, Y := TargetPair.A, F := (\fun (y: Y) => First.Odd (f y)), G := Second.Odd,
  source := TargetModels.bundle Negative.value, target := TargetModels.bundle Second.odd, base := TargetPair.subspace,
  f := SecondLocal.boundaryInclusion, sourceRegular := SecondLocal.boundaryRegular, targetRegular := SecondLocal.boundaryRegular] \as QPull;
\import Bundles.Isomorphisms[X := TargetPair.A, F := (\fun (z: TargetPair.A) => First.Odd (f z)),
  G := (\fun (z: TargetPair.A) => First.Odd (f z)), source := QOriginal.direct, target := QOriginal.nested] \as QReverse;
\import Operations.IsomorphismComposition[X := TargetPair.A, F := (\fun (z: TargetPair.A) => First.Odd (f z)),
  G := (\fun (z: TargetPair.A) => First.Odd (f z)), H := (\fun (z: TargetPair.A) => First.Odd (f z)),
  source := Operations.Models[X := TargetPair.A, baseSpace := TargetPair.subspace].bundle OldNegative.value, middle := QOriginal.direct, target := QGlobal.nested] \as QStart;
\definition qStart: QStart.Isomorphism := QStart.compose (QReverse.inverse QOriginal.isomorphism) QGlobal.isomorphism;
\import Operations.IsomorphismComposition[X := TargetPair.A, F := (\fun (z: TargetPair.A) => First.Odd (f z)),
  G := (\fun (z: TargetPair.A) => First.Odd (f z)), H := (\fun (z: TargetPair.A) => Second.Odd z),
  source := Operations.Models[X := TargetPair.A, baseSpace := TargetPair.subspace].bundle OldNegative.value, middle := QGlobal.nested, target := Operations.Models[X := TargetPair.A, baseSpace := TargetPair.subspace].bundle SecondLocal.boundaryOddModel] \as QFinish;
\definition negative: Bundles.Isomorphisms[X := TargetPair.A, F := (\fun (z: TargetPair.A) => First.Odd (f z)), G := (\fun (z: TargetPair.A) => Second.Odd z),
  source := Operations.Models[X := TargetPair.A, baseSpace := TargetPair.subspace].bundle OldNegative.value, target := Operations.Models[X := TargetPair.A, baseSpace := TargetPair.subspace].bundle SecondLocal.boundaryOddModel].Isomorphism := QFinish.compose qStart (QPull.isomorphism originalNegative);
\definition commutesD: \forall (x: TargetPair.A)(v: First.Even (f x)) ->
  ((TargetD.map Second.d).fiber x).apply ((positive.forward.fiber x).apply v) =
  (negative.forward.fiber x).apply (((OldD.map (OriginalD.map First.d)).fiber x).apply v) :=
  \fun (x: TargetPair.A)(v: First.Even (f x)) => originalCommutesD x v;
\definition commutesE: \forall (x: TargetPair.A)(v: First.Odd (f x)) ->
  ((TargetE.map Second.e).fiber x).apply ((negative.forward.fiber x).apply v) =
  (positive.forward.fiber x).apply (((OldE.map (OriginalE.map First.e)).fiber x).apply v) :=
  \fun (x: TargetPair.A)(v: First.Odd (f x)) => originalCommutesE x v;
