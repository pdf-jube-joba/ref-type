\definition originalPositive: Positives.Isomorphism := positive;
\definition originalNegative: Negatives.Isomorphism := negative;
\definition originalCommutesD: \forall (y: Y)(v: First.Even (f y)) -> (Second.d.fiber y).apply ((positive.forward.fiber y).apply v) =
  (negative.forward.fiber y).apply (((D.map First.d).fiber y).apply v) := commutesD;
\definition originalCommutesE: \forall (y: Y)(v: First.Odd (f y)) -> (Second.e.fiber y).apply ((negative.forward.fiber y).apply v) =
  (positive.forward.fiber y).apply (((E.map First.e).fiber y).apply v) := commutesE;
\module Supported(K: \Pow X, compactK: topology.Topology[Carrier := X].IsCompactIn space K,
  firstExact: \forall (x: \Cast[X] (topology.Topology[Carrier := X].Complement K)) -> Models.Chains[].Of[complex := first].ExactAt x,
  secondExact: \forall (y: \Cast[Y] (topology.Topology[Carrier := Y].Complement (topology.Maps[A := Y, B := X].Preimage f K))) ->
    TargetModels.Chains[].Of[complex := second].ExactAt y);
