\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition Point: \Set := Fin.Fin one;
\import topology.Topology[Carrier := Point] \as Base;
\import topological_k_theory.KTheory[].FiniteDiscrete[n := one] \as Finite;
\module Trivial(n: N.Nat^);
\import \parent.Examples[].Trivial[n := N.Nat^::zero] \as Zero;
\import \parent.Examples[].Trivial[n := one] \as Line;
\definition zeroThom: Zero.Carrier := Zero.thom;
\definition lineThom: Line.Carrier := Line.thom;
