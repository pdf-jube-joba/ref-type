\import Operations.Models[X := X, baseSpace := space] \as Models;
\import Operations.Models[X := Y, baseSpace := target] \as TargetModels;
\import compact_support_k.Support[].CompactBundles[X := X, space := space, compact := compact, hausdorff := hausdorff].Acyclic[p := p, q := q, d := d, e := e] \as Original;
\import Models.Pullback[b := p, Y := Y, source := target, f := f, regular := regular] \as Positive;
\import Models.Pullback[b := q, Y := Y, source := target, f := f, regular := regular] \as Negative;
\import Models.PullbackMap[p := p, q := q, Y := Y, source := target, f := f, regular := regular] \as Forward;
\import Models.PullbackMap[p := q, q := p, Y := Y, source := target, f := f, regular := regular] \as Backward;
\definition pulledD: TargetModels.Map Positive.value Negative.value := Forward.map d;
\definition pulledE: TargetModels.Map Negative.value Positive.value := Backward.map e;
\import compact_support_k.Support[].CompactBundles[X := Y, space := target, compact := targetCompact, hausdorff := targetHausdorff]
  .Acyclic[p := Positive.value, q := Negative.value, d := pulledD, e := pulledE] \as Pulled;
\module With(c: Original.Contraction);
