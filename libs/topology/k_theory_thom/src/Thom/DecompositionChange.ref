\import Operations.DirectSum[X := X, F := E, G := O, left := sourceEven, right := sourceOdd] \as SourceSum;
\import Operations.DirectSum[X := X, F := A, G := B, left := targetEven, right := targetOdd] \as TargetSum;
\definition sourceSum: Bundles.Family[X := X, F := SourceSum.Fiber].Bundle := SourceSum.bundle sameSource;
\definition targetSum: Bundles.Family[X := X, F := TargetSum.Fiber].Bundle := TargetSum.bundle sameTarget;
\import Operations.DirectSumIsomorphisms[X := X, F := E, G := O, A := A, B := B,
  first := sourceEven, second := sourceOdd, newFirst := targetEven, newSecond := targetOdd,
  sameSource := sameSource, sameTarget := sameTarget] \as Total;
\definition totalIso: Bundles.Isomorphisms[X := X, F := SourceSum.Fiber, G := TargetSum.Fiber,
  source := sourceSum, target := targetSum].Isomorphism := Total.isomorphism evenIso oddIso;
\definition commutes: \forall (x: X)(v: F x) ->
  (targetDecomposition.forward.fiber x).apply ((fullIso.forward.fiber x).apply v) =
  (totalIso.forward.fiber x).apply ((sourceDecomposition.forward.fiber x).apply v) := coherence;
\import Bundles.Morphisms[X := X, Y := X, F := F, G := F, source := sourceFull, target := sourceFull, f := (\fun (x: X) => x)] \as SourceOperatorMaps;
\import Bundles.Morphisms[X := X, Y := X, F := G, G := G, source := targetFull, target := targetFull, f := (\fun (x: X) => x)] \as TargetOperatorMaps;
\module Blocks(c: SourceOperatorMaps.Map, d: TargetOperatorMaps.Map,
  operatorCommutes: \forall (x: X)(v: F x) -> (fullIso.forward.fiber x).apply ((c.fiber x).apply v) = (d.fiber x).apply ((fullIso.forward.fiber x).apply v));
