\definition different: Logic.Not (Labels.degree n s = N.Nat^::succ n) := \fun (same: Labels.degree n s = N.Nat^::succ n) =>
  Naturals.ltIrrefl n (Naturals.ltOfSuccLe n n
    (\idelim Labels.degree n s = N.Nat^::succ n \with degree: N.Nat^ => Naturals.Le degree n \by {
      base: Labels.degreeBound n s, equality: same
    }));
\definition equation: Labels.rawLookup (N.Nat^::succ n) (Labels.degree n s) = Labels.Index::tail n s :=
  trans!{{Labels.Index (N.Nat^::succ n)}} _ _ _
    (congr!{{B.Bool^} {Labels.Index (N.Nat^::succ n)}} (Labels.branch n (Labels.rawLookup n) (Labels.degree n s)) _ _
      (Naturals.eqbFalseOfNe (Labels.degree n s) (N.Nat^::succ n) different))
    (congr!{{Labels.Index n} {Labels.Index (N.Nat^::succ n)}} (Labels.Index::tail n) _ _ previous);
