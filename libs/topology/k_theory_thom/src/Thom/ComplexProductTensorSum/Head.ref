\definition equation: Property n (Labels.Index::head n) := \fun (side: B.Bool^)(tag: B.Bool^::true = side) =>
  (\idelim B.Bool^::true = side \with b: B.Bool^ => \forall (law: B.Bool^::true = b)(target: Models.Bundle)(components: Components n b target)
    (x: X)(v: Models.Fiber (term n).ranks x)(w: G x) ->
    ((assemble n b target components).fiber x).apply (pure n b x (((Summands.at n (Labels.Index::head n) b law).fiber x).apply v) w) =
    ((components (Summands.colored n (Labels.Index::head n) b law)).fiber x).apply (componentPure n x v w) \by {
      base: \fun (law: B.Bool^::true = B.Bool^::true) => headFormula n, equality: tag
    }) tag;
