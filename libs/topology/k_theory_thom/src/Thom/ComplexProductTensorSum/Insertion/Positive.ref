\definition laws: Laws[\parent.Within[bound := bound].map] := Laws[\parent.Within[bound := bound].map] {
  within := \fun (other: Bound)(x: X)(v: Models.Fiber (term p).ranks x) => \refl(((\parent.Within[bound := bound].map).fiber x).apply v),
  outside := \fun (negative: Logic.Not Bound)(x: X)(v: Models.Fiber (term p).ranks x) => Logic.falseElim[_] (negative bound)
};
\definition existence: \exists Values := Logic.existsIntro[Maps.Map, { a: Maps.Map \where Laws[a] }] (\parent.Within[bound := bound].map) laws;
