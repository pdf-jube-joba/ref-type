\definition laws: Laws[Models.zero (term p) target] := Laws[Models.zero (term p) target] {
  within := \fun (bound: Bound)(x: X)(v: Models.Fiber (term p).ranks x) => Logic.falseElim[_] (negative bound),
  outside := \fun (other: Logic.Not Bound)(x: X)(v: Models.Fiber (term p).ranks x) => \refl(((Models.bundle target).space x).zero)
};
\definition existence: \exists Values := Logic.existsIntro[Maps.Map, { a: Maps.Map \where Laws[a] }] (Models.zero (term p) target) laws;
