\definition cast[i, j: N.Nat^][same: i = j]: Models.Map (term i) (term j) :=
  \idelim i = j \with k: N.Nat^ => Models.Map (term i) (term k) \by { base: Models.identity (term i), equality: same };
\definition map: Models.Map (term p) target := Models.compose (term p) (term (Labels.degree n label)) target
  (cast p (Labels.degree n label) (sym!{N.Nat^} _ _ (Labels.lookupDegree n p bound)))
  (Summands.at n label side (\refl(side)));
