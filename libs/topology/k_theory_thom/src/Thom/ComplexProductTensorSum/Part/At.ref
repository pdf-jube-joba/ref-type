\import Operations.TensorFactors[V := A x, W := G x, left := (Models.bundle head).space x, right := bundle.space x] \as FirstFactors;
\import Operations.TensorFactors[V := B x, W := G x, left := (Models.bundle tail).space x, right := bundle.space x] \as SecondFactors;
\import Spaces.Laws[V := Models.Fiber target.ranks x, space := (Models.bundle target).space x] \as Laws;
\definition onFirst[a: A x][w: G x]:
  ((map first second).fiber x).apply (Input.pure x ((Fold.firstInclusion.fiber x).apply a) w) = (first.fiber x).apply (First.pure x a w) :=
  trans!{{Models.Fiber target.ranks x}} _ _ _ (formula first second x a ((Models.bundle tail).space x).zero w)
    (trans!{{Models.Fiber target.ranks x}} _ _ _
      (congr!{{Models.Fiber target.ranks x} {Models.Fiber target.ranks x}} (((Models.bundle target).space x).add ((first.fiber x).apply (First.pure x a w))) _ _
        (trans!{{Models.Fiber target.ranks x}} _ _ _
          (congr!{{Second.Fiber x} {Models.Fiber target.ranks x}} (second.fiber x).apply _ _ (SecondFactors.zeroLeft w)) (second.fiber x).preservesZero))
      (Laws.zeroRight ((first.fiber x).apply (First.pure x a w))));
\definition onSecond[b: B x][w: G x]:
  ((map first second).fiber x).apply (Input.pure x ((Fold.secondInclusion.fiber x).apply b) w) = (second.fiber x).apply (Second.pure x b w) :=
  trans!{{Models.Fiber target.ranks x}} _ _ _ (formula first second x ((Models.bundle head).space x).zero b w)
    (trans!{{Models.Fiber target.ranks x}} _ _ _
      (congr!{{Models.Fiber target.ranks x} {Models.Fiber target.ranks x}} (\fun (v: Models.Fiber target.ranks x) => ((Models.bundle target).space x).add v ((second.fiber x).apply (Second.pure x b w))) _ _
        (trans!{{Models.Fiber target.ranks x}} _ _ _
          (congr!{{First.Fiber x} {Models.Fiber target.ranks x}} (first.fiber x).apply _ _ (FirstFactors.zeroLeft w)) (first.fiber x).preservesZero))
      (Laws.zeroLeft ((second.fiber x).apply (Second.pure x b w))));
