\import Models.Sum[first := term N.Nat^::zero, second := Chains.empty] \as Sum;
\import \parent.Part[head := term N.Nat^::zero, tail := Chains.empty] \as Pairing;
\import Spaces.Linear[V := Left N.Nat^::zero B.Bool^::true x, W := U,
  source := (leftBundle N.Nat^::zero B.Bool^::true).space x, target := target]
  .Composition[U := Models.Fiber Chains.empty.ranks x, domain := (Models.bundle Chains.empty).space x] \as Compose;
\definition equation: Property N.Nat^::zero :=
  \induction (side: B.Bool^) \return \forall (first, second: Linear N.Nat^::zero side) -> Agreement N.Nat^::zero side first second ->
    \forall (v: Left N.Nat^::zero side x) -> first.apply v = second.apply v \with {
      | false: \fun (first, second: Linear N.Nat^::zero B.Bool^::false)(agreement: Agreement N.Nat^::zero B.Bool^::false first second) => zeroCompare first second
      | true: \fun (first, second: Linear N.Nat^::zero B.Bool^::true)(agreement: Agreement N.Nat^::zero B.Bool^::true first second) =>
        Pairing.compare first second
          (\fun (a: Models.Fiber (term N.Nat^::zero).ranks x) => agreement (Labels.Index::head N.Nat^::zero) (\refl(B.Bool^::true)) a)
          (zeroCompare (Compose.compose first (Sum.secondInclusion.fiber x)) (Compose.compose second (Sum.secondInclusion.fiber x)))
    };
