\definition equation: Property (N.Nat^::succ n) (Labels.Index::tail n s) := \fun (side: B.Bool^)(tag: Labels.flip (Labels.even n s) = side) =>
  (\idelim Labels.flip (Labels.even n s) = side \with b: B.Bool^ =>
    \forall (law: Labels.flip (Labels.even n s) = b)(target: Models.Bundle)(components: Components (N.Nat^::succ n) b target)
      (x: X)(v: Models.Fiber (term (Labels.degree n s)).ranks x)(w: G x) ->
      ((assemble (N.Nat^::succ n) b target components).fiber x).apply
        (pure (N.Nat^::succ n) b x (((Summands.at (N.Nat^::succ n) (Labels.Index::tail n s) b law).fiber x).apply v) w) =
      ((components (Summands.colored (N.Nat^::succ n) (Labels.Index::tail n s) b law)).fiber x).apply (componentPure (Labels.degree n s) x v w) \by {
      base: \fun (law: Labels.flip (Labels.even n s) = Labels.flip (Labels.even n s))(target: Models.Bundle)
        (components: Components (N.Nat^::succ n) (Labels.flip (Labels.even n s)) target)(x: X)(v: Models.Fiber (term (Labels.degree n s)).ranks x)(w: G x) =>
        trans!{{Models.Fiber target.ranks x}} _ _ _
          (congr!{{Fiber (N.Nat^::succ n) (Labels.flip (Labels.even n s)) x} {Models.Fiber target.ranks x}}
            ((assemble (N.Nat^::succ n) (Labels.flip (Labels.even n s)) target components).fiber x).apply _ _
            (congr!{{Left (N.Nat^::succ n) (Labels.flip (Labels.even n s)) x} {Fiber (N.Nat^::succ n) (Labels.flip (Labels.even n s)) x}}
              (\fun (u: Left (N.Nat^::succ n) (Labels.flip (Labels.even n s)) x) => pure (N.Nat^::succ n) (Labels.flip (Labels.even n s)) x u w) _ _
              (Summands.tailFormula n s (Labels.even n s) (\refl(Labels.even n s)) x v)))
          (trans!{{Models.Fiber target.ranks x}} _ _ _
            (tailFormula n (Labels.even n s) target components x (((Summands.at n s (Labels.even n s) (\refl(Labels.even n s))).fiber x).apply v) w)
            (previous (Labels.even n s) (\refl(Labels.even n s)) target (tailComponents n (Labels.even n s) target components) x v w)),
      equality: tag
    }) tag;
