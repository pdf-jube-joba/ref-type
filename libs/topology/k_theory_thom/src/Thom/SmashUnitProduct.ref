\use Equality.eq_reason_in;
\import relative_k_theory.Relative[] \as Relative;
\import periodic_k_theory.Periodicity[] \as Periodicity;
\import Periodicity.SuspensionSphere[] \as Sphere;
\import topological_k_theory.KTheory[] \as KTheory;
\import std.Arithmetic[].Int[] \as I;
\definition zero: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zero;
\definition two: N.Nat^ := N.Nat^::succ one;
\import KTheory.FiniteDiscrete[n := two] \as Finite;
\import Finite.Computation[] \as Computation;
\import KTheory.On[X := Sphere.zero.Carrier, baseSpace := (Relative.details Sphere.zero).topology,
  compact := (Relative.details Sphere.zero).compact, hausdorff := (Relative.details Sphere.zero).hausdorff] \as Theory;
\import Theory.K0[] \as K;
\import Theory.Ranks[] \as Ranks;
\import Relative.Reduced[model := Sphere.zero] \as Reduced;
\definition delta[i: Sphere.zero.Carrier]: I.Int^ := I.Int^::ofNat i;
\definition value: K.Carrier := Computation.backward delta;
\definition ranks: \forall (i: Sphere.zero.Carrier) -> Ranks.rank value i = delta i :=
  \fun (i: Sphere.zero.Carrier) => congr!{{Computation.IntegerFunctions} {I.Int^}}
    (\fun (f: Computation.IntegerFunctions) => f i) _ _ (Computation.rightInverse delta);
\definition unit: Reduced.Carrier := \into[K.Carrier](value, Reduced.Carrier) \by { ranks (Relative.details Sphere.zero).point };
\definition liveRank: Ranks.rank unit Sphere.live = I.One.specification := ranks Sphere.live;
\module Uniqueness(u: Reduced.Carrier, live: Ranks.rank u Sphere.live = I.One.specification);
\definition unique: \forall (u: Reduced.Carrier) -> Ranks.rank u Sphere.live = I.One.specification -> u = unit :=
  \fun (u: Reduced.Carrier)(live: _) => Uniqueness[u := u, live := live].equation;
\import KTheory.On[X := base.Carrier, baseSpace := (Relative.details base).topology,
  compact := (Relative.details base).compact, hausdorff := (Relative.details base).hausdorff] \as BaseTheory;
\import BaseTheory.K0[] \as BaseK;
\import Relative.Reduced[model := base] \as Group;
\module Constant;
\module Left;
\module Right;
