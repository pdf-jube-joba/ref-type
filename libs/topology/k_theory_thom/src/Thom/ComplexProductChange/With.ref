\definition positiveLaws: Positive.Laws[positive] := \bysub(Positive.Data, Positive.Isomorphism, positive);
\definition negativeLaws: Negative.Laws[negative] := \bysub(Negative.Data, Negative.Isomorphism, negative);
\import Operations.Models[X := Pair.A, baseSpace := Pair.subspace] \as BoundaryModels;
\import Models.PullbackMap[p := Source.even, q := Target.even, Y := Pair.A, source := Pair.subspace,
  f := Source.inclusion, regular := Source.inclusionContinuous] \as PositiveForward;
\import Models.PullbackMap[p := Target.even, q := Source.even, Y := Pair.A, source := Pair.subspace,
  f := Source.inclusion, regular := Source.inclusionContinuous] \as PositiveBackward;
\import Models.PullbackMap[p := Source.odd, q := Target.odd, Y := Pair.A, source := Pair.subspace,
  f := Source.inclusion, regular := Source.inclusionContinuous] \as NegativeForward;
\import Models.PullbackMap[p := Target.odd, q := Source.odd, Y := Pair.A, source := Pair.subspace,
  f := Source.inclusion, regular := Source.inclusionContinuous] \as NegativeBackward;
\definition positiveForward: BoundaryModels.Map FirstEven.value SecondEven.value := PositiveForward.map positive.forward;
\definition positiveBackward: BoundaryModels.Map SecondEven.value FirstEven.value := PositiveBackward.map positive.backward;
\definition negativeForward: BoundaryModels.Map FirstOdd.value SecondOdd.value := NegativeForward.map negative.forward;
\definition negativeBackward: BoundaryModels.Map SecondOdd.value FirstOdd.value := NegativeBackward.map negative.backward;
\module For(contraction: FirstAcyclic.Contraction);
\definition equation[firstExact: Source.Exact][secondExact: Target.Exact]:
  Source.Supported[exact := firstExact].value = Target.Supported[exact := secondExact].value := \block {
    \takefrom contraction: FirstAcyclic.Contraction \by Source.Supported[exact := firstExact].existence \then
    \return For[contraction := contraction].equation firstExact secondExact
  };
\definition targetExact[firstExact: Source.Exact]: Target.Exact := \block {
  \takefrom contraction: FirstAcyclic.Contraction \by Source.Supported[exact := firstExact].existence \then
  \return For[contraction := contraction].exact
};
