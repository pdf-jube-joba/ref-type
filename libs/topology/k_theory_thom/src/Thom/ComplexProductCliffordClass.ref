\import \root.Thom[].RelativeComplex[X := X, space := space, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed, complex := complex] \as Source;
\import relative_k_theory.Relative[].Pair[X := X, space := space, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed] \as Pair;
\import Operations.Models[X := X, baseSpace := space] \as Models;
\import Models.Chains[].Of[complex := complex] \as Chain;
\import Models.Pullback[b := Source.even, Y := Pair.A, source := Pair.subspace, f := Source.inclusion, regular := Source.inclusionContinuous] \as P;
\import Models.Pullback[b := Source.odd, Y := Pair.A, source := Pair.subspace, f := Source.inclusion, regular := Source.inclusionContinuous] \as Q;
\import Models.PullbackMap[p := Source.even, q := Source.odd, Y := Pair.A, source := Pair.subspace, f := Source.inclusion, regular := Source.inclusionContinuous] \as D;
\import Models.PullbackMap[p := Source.odd, q := Source.even, Y := Pair.A, source := Pair.subspace, f := Source.inclusion, regular := Source.inclusionContinuous] \as E;
\import compact_support_k.Support[].CompactBundles[X := Pair.A, space := Pair.subspace, compact := Source.boundaryCompact, hausdorff := Source.boundaryHausdorff] \as Boundary;
\import Boundary.Acyclic[p := P.value, q := Q.value, d := D.map Chain.parity.forward, e := E.map Chain.parity.backward] \as Acyclic;
\import C.Def[] \as Scalar;
\module With(c: Acyclic.Contraction);
