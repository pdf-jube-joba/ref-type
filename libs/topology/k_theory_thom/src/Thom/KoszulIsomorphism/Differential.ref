\import \parent.Degree[k := k] \as Codomain;
\import \parent.Degree[k := N.Nat^::succ k] \as Domain;
\import Bundles.ArrowLaws[X := Target.Total, Y := Target.Total, F := Target.Term (N.Nat^::succ k), G := Target.Term k,
  source := Target.term (N.Nat^::succ k), target := Target.term k, f := \fun (p: Target.Total) => p]
  .Pullback[Z := Source.Total, space := left.totalSpace, g := total]
  .Of[a := Target.Degree[k := k].differential, regular := continuous] \as Pull;
\definition differential: Bundles.Morphisms[X := Source.Total, Y := Source.Total, F := Domain.Fiber, G := Codomain.Fiber,
  source := Domain.pulled, target := Codomain.pulled, f := \fun (p: Source.Total) => p].Map := Pull.map;
\module At(p: Source.Total);
\definition commutes: \forall (p: Source.Total)(omega: Domain.Fiber p) ->
  (Source.Degree[k := k].differential.fiber p).apply ((Domain.isomorphism.forward.fiber p).apply omega) =
  (Codomain.isomorphism.forward.fiber p).apply ((differential.fiber p).apply omega) :=
  \fun (p: Source.Total) => At[p := p].commutes;
