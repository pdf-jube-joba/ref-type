\import Fin.Tuples[A := Source.Fiber p] \as SourceTuples;
\import Fin.Tuples[A := Vector p] \as TargetTuples;
\import SourceTuples.Mapping[B := Vector p] \as Tuples;
\definition firstValue[omega: Domain.Fiber p]: Source.Term k p :=
  (Source.Degree[k := k].differential.fiber p).apply ((Domain.isomorphism.forward.fiber p).apply omega);
\definition secondValue[omega: Domain.Fiber p]: Source.Term k p :=
  (Codomain.isomorphism.forward.fiber p).apply ((differential.fiber p).apply omega);
\definition commutes: \forall (omega: Domain.Fiber p) -> firstValue omega = secondValue omega :=
  \fun (omega: Domain.Fiber p) => Spaces.Multilinear[V := Source.Fiber p, space := Source.pulled.space p].Alternating[].At[k := k].ext (firstValue omega) (secondValue omega)
    (\fun (arguments: Fin.Fin k -> Source.Fiber p) => congr!{{Fin.Fin (N.Nat^::succ k) -> Vector p} {C.Complex}} omega
      (\fun (i: Fin.Fin (N.Nat^::succ k)) => (vectorIso.forward.fiber p).apply (SourceTuples.extend k p.vector arguments i))
      (TargetTuples.extend k ((vectorIso.forward.fiber p).apply p.vector) (\fun (i: Fin.Fin k) => (vectorIso.forward.fiber p).apply (arguments i)))
      (Tuples.extendMap k (vectorIso.forward.fiber p).apply p.vector arguments));
