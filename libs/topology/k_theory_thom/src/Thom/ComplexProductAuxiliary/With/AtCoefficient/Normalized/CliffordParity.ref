\import Operations.TensorEquality[V := Parity.LeftFiber x, W := Parity.RightFiber x, U := Parity.SourceFiber x,
  left := Parity.leftBundle.space x, right := Parity.rightBundle.space x, target := Parity.sourceBundle.space x] \as EqualityOnPure;
\import Operations.Tensor[X := X, F := Parity.LeftFiber, G := Parity.RightFiber, left := Parity.leftBundle, right := Parity.rightBundle] \as FullTensor;
\import FullTensor.Of[same := sameFirst].Mapping[Y := X, A := Parity.LeftFiber, B := Parity.RightFiber,
  leftTarget := Parity.leftBundle, rightTarget := Parity.rightBundle, f := (\fun (x: X) => x)].Of[targetSame := sameFirst] \as Mapping;
\definition equation: \forall (v: Parity.SourceFiber x) ->
  ((Mapping.map Grading.leftGrading.forward Grading.rightGrading.forward).fiber x).apply v = (Grading.At[x := x].parity).apply v :=
  EqualityOnPure.pointwise ((Mapping.map Grading.leftGrading.forward Grading.rightGrading.forward).fiber x) (Grading.At[x := x].parity)
    (\fun (v: Parity.LeftFiber x)(w: Parity.RightFiber x) => trans!{{Parity.SourceFiber x}} _ _ _
      (Mapping.onPure Grading.leftGrading.forward Grading.rightGrading.forward x v w)
      (sym!{{Parity.SourceFiber x}} _ _ (\root.Thom[].ComplexProductClifford[V := Parity.LeftFiber x, W := Parity.RightFiber x,
        firstSpace := Parity.leftBundle.space x, secondSpace := Parity.rightBundle.space x].Lift[first := Grading.leftGrading.forward.fiber x, second := Grading.rightGrading.forward.fiber x].onPure v w)));
