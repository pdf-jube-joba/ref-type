\import \parent.\parent.\parent.AtCoefficient[coefficient := (\fun (x: X) => Path.coefficient z),
  continuous := Functions.constantContinuous auxiliary.baseSpace (Path.coefficient z)].BlockFiber[x := Cylinder.point z] \as Point;
\definition norm: C.Complex := Scalar.add (Scalar.ofReal (Real.mul (Path.coefficient z) (Path.coefficient z))) (Scalar.ofReal (data.norm (Cylinder.point z)));
\definition reciprocal: Scalar.mul (Path.rho z) norm = Scalar.one :=
  trans!{{C.Complex}} _ _ _
    (congr!{{C.Complex} {C.Complex}} (Scalar.mul (Path.rho z)) _ _
      (sym!{{C.Complex}} _ _ (ComplexLaws.ofRealAdd (Real.mul (Path.coefficient z) (Path.coefficient z)) (data.norm (Cylinder.point z)))))
    (Path.reciprocal z);
\definition squareLeft[v: Parity.Even (Cylinder.point z)]: (backward.fiber z).apply ((forward.fiber z).apply v) = (P.space z).smul norm v := Point.squareLeft v;
\definition squareRight[v: Parity.Odd (Cylinder.point z)]: (forward.fiber z).apply ((backward.fiber z).apply v) = (Q.space z).smul norm v := Point.squareRight v;
\definition left[v: Parity.Even (Cylinder.point z)]: (inverse.fiber z).apply ((forward.fiber z).apply v) = v :=
  trans!{{Parity.Even (Cylinder.point z)}} _ _ _
    (congr!{{Parity.Even (Cylinder.point z)} {Parity.Even (Cylinder.point z)}} ((P.space z).smul (Path.rho z)) _ _ (squareLeft v))
    (trans!{{Parity.Even (Cylinder.point z)}} _ _ _
      (sym!{{Parity.Even (Cylinder.point z)}} _ _ ((P.space z).scalarAssoc (Path.rho z) norm v))
      (trans!{{Parity.Even (Cylinder.point z)}} _ _ _
        (congr!{{C.Complex} {Parity.Even (Cylinder.point z)}} (\fun (a: C.Complex) => (P.space z).smul a v) _ _ reciprocal) ((P.space z).scalarOne v)));
\definition right[v: Parity.Odd (Cylinder.point z)]: (forward.fiber z).apply ((inverse.fiber z).apply v) = v :=
  trans!{{Parity.Odd (Cylinder.point z)}} _ _ _ ((forward.fiber z).preservesScale (Path.rho z) ((backward.fiber z).apply v))
    (trans!{{Parity.Odd (Cylinder.point z)}} _ _ _
      (congr!{{Parity.Odd (Cylinder.point z)} {Parity.Odd (Cylinder.point z)}} ((Q.space z).smul (Path.rho z)) _ _ (squareRight v))
      (trans!{{Parity.Odd (Cylinder.point z)}} _ _ _
        (sym!{{Parity.Odd (Cylinder.point z)}} _ _ ((Q.space z).scalarAssoc (Path.rho z) norm v))
        (trans!{{Parity.Odd (Cylinder.point z)}} _ _ _
          (congr!{{C.Complex} {Parity.Odd (Cylinder.point z)}} (\fun (a: C.Complex) => (Q.space z).smul a v) _ _ reciprocal) ((Q.space z).scalarOne v))));
