\definition sourceRegular: topology.Continuity[A := Relative.A, B := X].Continuous Relative.subspace source.baseSpace inclusion :=
  \idelim auxiliary.baseSpace = source.baseSpace \with t: topology.Topology[Carrier := X].Topology =>
    topology.Continuity[A := Relative.A, B := X].Continuous Relative.subspace t inclusion \by {
      base: inclusionContinuous, equality: sym!{{topology.Topology[Carrier := X].Topology}} _ _ same
    };
\import Bundles.ArrowLaws[X := X, Y := X, F := F, G := G, source := source, target := target, f := (\fun (x: X) => x)]
  .Pullback[Z := Relative.A, space := Relative.subspace, g := inclusion].Of[a := map, regular := sourceRegular] \as Boundary;
\import Bundles.Family[X := X, F := F].Of[bundle := source].Pullback[Y := Relative.A, source := Relative.subspace, f := inclusion] \as P;
\import Bundles.Family[X := X, F := G].Of[bundle := target].Pullback[Y := Relative.A, source := Relative.subspace, f := inclusion] \as Q;
\definition restricted: Bundles.Morphisms[X := Relative.A, Y := Relative.A,
  F := (\fun (x: Relative.A) => F x), G := (\fun (x: Relative.A) => G x),
  source := P.pulled sourceRegular,
  target := Q.pulled Boundary.targetRegular, f := (\fun (x: Relative.A) => x)].Map := Boundary.map;
\import Bundles.ArrowLaws[X := Relative.A, Y := Relative.A, F := (\fun (x: Relative.A) => F x), G := (\fun (x: Relative.A) => G x),
  source := P.pulled sourceRegular,
  target := Q.pulled Boundary.targetRegular, f := (\fun (x: Relative.A) => x)]
  .Pullback[Z := Cylinder.Carrier, space := Cylinder.topology Relative.subspace, g := Cylinder.point]
  .Of[a := restricted, regular := (Cylinder.pointContinuous Relative.subspace)] \as CylinderMap;
\import Bundles.Family[X := Relative.A, F := (\fun (x: Relative.A) => F x)].Of[bundle := P.pulled sourceRegular]
  .Pullback[Y := Cylinder.Carrier, source := Cylinder.topology Relative.subspace, f := Cylinder.point] \as PP;
\import Bundles.Family[X := Relative.A, F := (\fun (x: Relative.A) => G x)].Of[bundle := Q.pulled Boundary.targetRegular]
  .Pullback[Y := Cylinder.Carrier, source := Cylinder.topology Relative.subspace, f := Cylinder.point] \as QQ;
\definition cylinder: Bundles.Morphisms[X := Cylinder.Carrier, Y := Cylinder.Carrier,
  F := (\fun (z: Cylinder.Carrier) => F (Cylinder.point z)), G := (\fun (z: Cylinder.Carrier) => G (Cylinder.point z)),
  source := PP.pulled (Cylinder.pointContinuous Relative.subspace),
  target := QQ.pulled CylinderMap.targetRegular, f := (\fun (z: Cylinder.Carrier) => z)].Map := CylinderMap.map;
