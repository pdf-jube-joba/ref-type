\import Triples.Homotopy[alpha := alpha, beta := endpointComparison] \as BoundaryHomotopy;
\definition path: BoundaryHomotopy.Family := BoundaryHomotopy.Family {
  isomorphism := isomorphism,
  start := \fun (x: Relative.A)(v: Parity.Even x) => trans!{{Parity.Odd x}} _ _ _ (Initial.agreement x v) (sym!{{Parity.Odd x}} _ _ (agrees x v)),
  end := family.end
};
\definition zero: Triples.With[alpha := alpha].reduced = Relative.Quotient[].group.base.unit :=
  trans!{{Relative.Quotient[].Relative}} _ _ _ (BoundaryHomotopy.With[family := path].reducedEquation) endpointZero;
