\import Bundles.Morphisms[X := X, Y := X, F := Parity.Even, G := Parity.SourceFiber, source := Parity.evenBundle,
  target := Parity.sourceBundle, f := (\fun (x: X) => x)].Composition[Z := X, H := Parity.SourceFiber, range := Parity.sourceBundle, g := (\fun (x: X) => x)] \as ForwardStart;
\import Bundles.Morphisms[X := X, Y := X, F := Parity.Even, G := Parity.SourceFiber, source := Parity.evenBundle,
  target := Parity.sourceBundle, f := (\fun (x: X) => x)].Composition[Z := X, H := Parity.Odd, range := Parity.oddBundle, g := (\fun (x: X) => x)] \as ForwardEnd;
\definition forward: Bundles.Morphisms[X := X, Y := X, F := Parity.Even, G := Parity.Odd, source := Parity.evenBundle,
  target := Parity.oddBundle, f := (\fun (x: X) => x)].Map := ForwardEnd.compose (ForwardStart.compose embedEven map) projectOdd;
\import Bundles.Morphisms[X := X, Y := X, F := Parity.Odd, G := Parity.SourceFiber, source := Parity.oddBundle,
  target := Parity.sourceBundle, f := (\fun (x: X) => x)].Composition[Z := X, H := Parity.SourceFiber, range := Parity.sourceBundle, g := (\fun (x: X) => x)] \as BackwardStart;
\import Bundles.Morphisms[X := X, Y := X, F := Parity.Odd, G := Parity.SourceFiber, source := Parity.oddBundle,
  target := Parity.sourceBundle, f := (\fun (x: X) => x)].Composition[Z := X, H := Parity.Even, range := Parity.evenBundle, g := (\fun (x: X) => x)] \as BackwardEnd;
\definition backward: Bundles.Morphisms[X := X, Y := X, F := Parity.Odd, G := Parity.Even, source := Parity.oddBundle,
  target := Parity.evenBundle, f := (\fun (x: X) => x)].Map := BackwardEnd.compose (BackwardStart.compose embedOdd map) projectEven;
