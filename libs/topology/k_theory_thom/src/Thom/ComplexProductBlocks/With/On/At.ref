\import C.Prop[] \as ScalarLaws;
\definition left: \forall (v: Even x) -> (inverse.fiber x).apply ((Forward.map.fiber x).apply v) = v :=
  \fun (v: Even x) => trans!{{Even x}} _ _ _
    (congr!{{Even x} {Even x}} ((evenBundle.space x).smul (reciprocal x)) _ _ (evenSquare x v))
    (trans!{{Even x}} _ _ _ (sym!{{Even x}} _ _ ((evenBundle.space x).scalarAssoc (reciprocal x) (coefficient x) v))
      (trans!{{Even x}} _ _ _
        (congr!{{C.Complex} {Even x}} (\fun (a: C.Complex) => (evenBundle.space x).smul a v) _ _ (ScalarLaws.inverseNonzero (coefficient x) (nonzero x)))
        ((evenBundle.space x).scalarOne v)));
\definition right: \forall (v: Odd x) -> (Forward.map.fiber x).apply ((inverse.fiber x).apply v) = v :=
  \fun (v: Odd x) => trans!{{Odd x}} _ _ _
    ((Forward.map.fiber x).preservesScale (reciprocal x) ((Backward.map.fiber x).apply v))
    (trans!{{Odd x}} _ _ _
      (congr!{{Odd x} {Odd x}} ((oddBundle.space x).smul (reciprocal x)) _ _ (oddSquare x v))
      (trans!{{Odd x}} _ _ _ (sym!{{Odd x}} _ _ ((oddBundle.space x).scalarAssoc (reciprocal x) (coefficient x) v))
        (trans!{{Odd x}} _ _ _
          (congr!{{C.Complex} {Odd x}} (\fun (a: C.Complex) => (oddBundle.space x).smul a v) _ _ (ScalarLaws.inverseNonzero (coefficient x) (nonzero x)))
          ((oddBundle.space x).scalarOne v))));
