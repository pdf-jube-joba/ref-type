\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition Base: \Set := Fin.Fin one;
\definition point: Base := Fin.zero N.Nat^::zero;
\definition topology: topology.Topology[Carrier := Base].Topology := topology.Topology[Carrier := Base].Discrete;
\import topological_k_theory.KTheory[].FiniteDiscrete[n := one] \as Finite;
\import Bundles.Trivial[X := Base, n := n, baseSpace := topology] \as Bundle;
\definition bundle: Bundles.Family[X := Base, F := (\fun (_: Base) => Bundles.Vector n)].Bundle := Bundle.bundle;
\import Bundles.Family[X := Base, F := (\fun (_: Base) => Bundles.Vector n)] \as Family;
\definition Total: \Set := Family.Point;
\definition include[v: Bundles.Vector n]: Total := Family.include point v;
\import \root.Thom[].TotalSpace[X := Base, F := (\fun (_: Base) => Bundles.Vector n), bundle := bundle,
  compact := Finite.compact, hausdorff := Finite.hausdorff] \as TotalSpace;
\import compact_support_k.Support[].On[X := Total, space := bundle.totalSpace,
  hausdorff := TotalSpace.separated, locallyCompact := TotalSpace.locallyCompact] \as Support;
\definition model: Relative.CompactPointed := Support.model;
\definition Carrier: \Set := Relative.Reduced[model := model].Carrier;
\import \root.Thom[].For[X := Base, F := (\fun (_: Base) => Bundles.Vector n), bundle := bundle,
  compact := Finite.compact, hausdorff := Finite.hausdorff] \as Canonical;
\definition thom: Carrier := Canonical.thom;
