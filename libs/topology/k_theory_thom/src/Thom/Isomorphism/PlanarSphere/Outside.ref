\import \parent.Plane[] \as Plane;
\import \parent.Stereographic[] \as Stereo;
\definition numeratorNonnegative: R.Le Real.zero (Real.sub (Plane.r2 z) (square (Plane.gap z))) :=
  R.leReplaceRight Real.zero (Real.sub (Plane.r2 z) Real.one) (Real.sub (Plane.r2 z) (square Real.one))
    (congr!{{Real.Real} {Real.Real}} (Real.sub (Plane.r2 z)) _ _ (sym!{{Real.Real}} _ _ (Laws.fieldMulOneLeft Real.one)))
    (Distance.subNonnegative (Plane.r2 z) Real.one bound);
\definition nonnegative: R.Le Real.zero (Stereo.head (\parent.Forward[].map z)) :=
  R.leReplaceRight Real.zero (Plane.height z) (Stereo.head (\parent.Forward[].map z))
    (sym!{{Real.Real}} _ _ (Stereo.headFormula z))
    (Laws.fieldMulNonnegative (Real.sub (Plane.r2 z) (square (Plane.gap z))) (Plane.inverse z) numeratorNonnegative
      (Order.leOfLt Real.zero (Plane.inverse z) (Estimates.Product[].invPositive (Plane.denominator z) \parent.Interior[z := z].denominatorPositive)));
