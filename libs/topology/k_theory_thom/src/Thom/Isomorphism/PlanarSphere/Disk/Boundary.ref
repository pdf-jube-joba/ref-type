\definition radius: Plane.r2 (input v) = Real.one := trans!{{Real.Real}} _ _ _ (normFormula v) edge;
\definition denominator: Plane.denominator (input v) = double Real.one :=
  congr!{{Real.Real} {Real.Real} {Real.Real}} Real.add _ _ _ _ radius (Laws.fieldMulOneLeft Real.one);
\definition weight: Plane.weight (input v) = Real.one := Scalar.cancelRight _ _ _ (Plane.nonzero (input v))
  (trans!{{Real.Real}} _ _ _ (Forward.weightTimes (input v))
    (sym!{{Real.Real}} _ _ (trans!{{Real.Real}} _ _ _ (Laws.fieldMulOneLeft (Plane.denominator (input v))) denominator)));
\definition originalCoordinates: Split1.join (Plane.x (input v)) (\fun (_: D1.Index) => Plane.y (input v)) = v :=
  Split1.ext _ _ (Split1.headJoin (Plane.x (input v)) (\fun (_: D1.Index) => Plane.y (input v)))
    (trans!{{D1.Coordinate}} _ _ _ (Split1.tailJoin (Plane.x (input v)) (\fun (_: D1.Index) => Plane.y (input v)))
      (\axiom:funext((\fun (_: D1.Index) => Plane.y (input v)), Split1.tail v,
        \fun (i: D1.Index) => congr!{{D1.Index} {Real.Real}} (Split1.tail v) _ _ (sym!{{D1.Index}} _ _ (Fin.singletonValue i)))));
\definition equation: reparameter v = v := trans!{{D2.Coordinate}} _ _ _
  (Split2.tailJoin (Plane.height (input v)) (Plane.tail (input v)))
  (trans!{{D2.Coordinate}} _ _ _
    (congr!{{Real.Real} {D2.Coordinate}} (\fun (a: Real.Real) => Split1.join (Real.mul a (Plane.x (input v))) (\fun (_: D1.Index) => Real.mul a (Plane.y (input v)))) _ _ weight)
    (trans!{{D2.Coordinate}} _ _ _
      (congr!{{Real.Real} {D1.Coordinate} {D2.Coordinate}} Split1.join _ _ _ _ (Laws.fieldMulOneLeft (Plane.x (input v)))
        (\axiom:funext((\fun (_: D1.Index) => Real.mul Real.one (Plane.y (input v))), (\fun (_: D1.Index) => Plane.y (input v)),
          \fun (_: D1.Index) => Laws.fieldMulOneLeft (Plane.y (input v))))) originalCoordinates));
