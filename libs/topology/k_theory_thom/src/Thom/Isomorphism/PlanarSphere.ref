\import bott_product.Bott[] \as Bott;
\import algebraic_topology.Euclidean[].Dimension[n := Bott.three] \as Sphere;
\import Sphere.Compactness[] \as Compactness;
\import Bott.Product[X := Sphere.Sphere, source := Sphere.sphereTopology,
  compact := Compactness.sphere, hausdorff := Compactness.sphereHausdorff].Hemisphere[] \as Hemisphere;
\definition sphere: Relative.CompactPointed := Relative.pack Sphere.Sphere (Relative.PointedDetails[Sphere.Sphere] {
  topology := Sphere.sphereTopology, compact := Compactness.sphere, hausdorff := Compactness.sphereHausdorff, point := Hemisphere.point
});
\use Equality.eq_reason_in;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import R.Order[] \as Order;
\import Real.Algebra[] \as Algebra;
\import Real.Distance[] \as Distance;
\import Real.Estimates[] \as Estimates;
\import algebraic_topology.Interval[] \as Time;
\import metric_spaces.RealLine[] \as Line;
\import algebraic_topology.Euclidean[].Dimension[n := Bott.one] \as D1;
\import algebraic_topology.Euclidean[].Dimension[n := Bott.two] \as D2;
\import D1.Splitting[] \as Split1;
\import D2.Splitting[] \as Split2;
\import D1.Contraction[] \as Zero1;
\definition double[a: Real.Real]: Real.Real := Real.add a a;
\definition square[a: Real.Real]: Real.Real := Real.mul a a;
\definition maximum[x, y: Real.Real]: Real.Real := Distance.max (Distance.max x (Real.neg x)) (Distance.max y (Real.neg y));
\module Scalar;
\module Plane;
\module Forward;
\module Stereographic;
\module Candidate(p: sphere.Carrier, off: Logic.Not (Bott.ProjectiveLine[].Coordinates[].SphereMap[].Matrix[].t p = Real.one));
\module Interior(z: \root.Thom[].Isomorphism[].PlanarSphere[].Plane[].Carrier);
\module Pole;
\module Chart;
\module Compactification;
\module Disk;
\module Outside(z: \root.Thom[].Isomorphism[].PlanarSphere[].Plane[].Carrier,
  bound: R.Le Real.one (\root.Thom[].Isomorphism[].PlanarSphere[].Plane[].r2 z));
