\module At(base: Relative.CompactPointed);
\definition state: State[N.Nat^::succ n] := State[N.Nat^::succ n] {
  data := \fun (base: Relative.CompactPointed) => At[base := base].data,
  product := \fun (base: Relative.CompactPointed)(a: Relative.Reduced[model := base].Carrier) => At[base := base].forwardProduct a
};
