\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := Scalars.scalar].For[
  X := Point.Base, F := (\fun (x: Point.Base) => Bundles.Vector one), bundle := Trivial.bundle] \as Complement;
\import Bundles.Identity[X := Point.Base, F := (\fun (x: Point.Base) => Bundles.Vector one), bundle := Trivial.bundle] \as Identity;
\import topological_k_theory.KTheory[].FiniteDiscrete[n := one] \as Finite;
\definition embedding: Complement.Embedding := Complement.Embedding {
  dimension := one, map := Identity.map,
  injective := \fun (x: Point.Base)(v, w: Bundles.Vector one)(same: v = w) => same
};
\import \root.Thom[].MetricKoszul[X := Point.Base, F := (\fun (x: Point.Base) => Bundles.Vector one), bundle := Trivial.bundle,
  compact := Finite.compact, hausdorff := Finite.hausdorff].Embedded[embedding := embedding] \as Embedded;
\definition metric: Complement.Metric := Embedded.metric;
\import \root.Thom[].MetricKoszul[X := Point.Base, F := (\fun (x: Point.Base) => Bundles.Vector one), bundle := Trivial.bundle,
  compact := Finite.compact, hausdorff := Finite.hausdorff].With[metric := metric] \as Model;
\import thom_spaces.Thom[].Over[K := C.Complex, field := C.Algebra[].field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := Scalars.scalar].For[
  X := Point.Base, F := (\fun (x: Point.Base) => Bundles.Vector one), bundle := Trivial.bundle].With[metric := metric] \as Geometry;
\import real.Analysis[] \as Real;
\import complex.Complex[].Def[] \as Op;
\import complex.Complex[].Prop[] \as Laws;
\definition squaredFormula: \forall (p: Point.Total) -> Model.squared p = Plane.r2 (forward p) :=
  \fun (p: Point.Total) => trans!{{Real.Real}} _ _ _
    (congr!{{C.Complex} {Real.Real}} C.re _ _ (Laws.addZeroRight (Op.mul (Op.conj (forward p)) (forward p))))
    (congr!{{C.Complex} {Real.Real}} C.re _ _ (Laws.conjMulSelf (forward p)));
\module Disk;
\module Localized;
