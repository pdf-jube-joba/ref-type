\import \root.Thom[].Isomorphism[].LinePlane[] \as TotalCoordinates;
\import \parent.Disk[] \as Round;
\import \root.Thom[].Isomorphism[].PlanarSphere[].Disk[] \as PlaneDisk;
\import algebraic_topology.Euclidean[].Dimension[n := N.Nat^::succ one] \as D2;
\import \root.Thom[].Koszul[X := Point.Base, F := (\fun (x: Point.Base) => Bundles.Vector one), bundle := Trivial.bundle] \as Native;
\import \root.Thom[].TotalSpace[X := Point.Base, F := (\fun (x: Point.Base) => Bundles.Vector one), bundle := Trivial.bundle,
  compact := Finite.compact, hausdorff := Finite.hausdorff] \as Total;
\import compact_support_k.Support[].On[X := Point.Total, space := Trivial.topology,
  hausdorff := Total.separated, locallyCompact := Total.locallyCompact] \as Support;
\import compact_support_k.Support[].OnePoint[X := Point.Total, space := Trivial.topology] \as Plus;
\import Support.Neighborhood[K := Native.ZeroSection, compact := Total.zeroCompact] \as Neighbors;
\import \root.Thom[].MetricKoszul[X := Point.Base, F := (\fun (x: Point.Base) => Bundles.Vector one), bundle := Trivial.bundle,
  compact := Finite.compact, hausdorff := Finite.hausdorff].With[metric := metric].Neighborhood[] \as MetricNeighborhood;
\definition witness: Neighbors.Witness := MetricNeighborhood.squareWitness;
\import Neighbors.With[w := witness] \as Neighbor;
\import Support.Localization[U := Neighbor.openSet, open := Neighbor.open, L := Neighbor.compactSet,
  compactL := Neighbor.compact, enclosed := Neighbor.enclosed] \as Local;
\import Relative.Pair[X := Local.Carrier, space := Local.topology, compact := Local.compact, hausdorff := Local.separated,
  subset := Local.boundary, closed := Local.boundaryClosed] \as Pair;
\import Pair.Quotient[] \as Quotient;
\definition intoDisk[p: Local.Carrier]: Geometry.DiskBundle := \into[Point.Total](p, Geometry.ClosedBall) \by {
  \idelim Neighbor.compactSet = Geometry.ClosedBall \with L: \Pow Point.Total => \In[Point.Total] L p \by {
    base: \bysub(Point.Total, Neighbor.compactSet, p), equality: MetricNeighborhood.squareCompactEquation
  }
};
\definition h[p: Local.Carrier]: D2.Disk := Round.forward (intoDisk p);
\definition g[p: Local.Carrier]: D2.Disk := PlaneDisk.reparameter (h p);
\module GeometryProof;
\module Class;
