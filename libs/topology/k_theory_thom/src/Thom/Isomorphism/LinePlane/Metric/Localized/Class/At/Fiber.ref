\import Spaces.Laws[V := Chain.Even p, space := Chain.even.space p] \as Additive;
\definition normalBackward: \forall (w: Chain.Odd p) -> (Normal.backward.fiber p).apply w = (Chain.parity.backward.fiber p).apply w :=
  \fun (w: Chain.Odd p) => trans!{{Chain.Even p}} _ _ _
    (congr!{{Chain.Even p} {Chain.Even p}} ((Chain.even.space p).add ((Chain.parity.backward.fiber p).apply w)) _ _
      (trans!{{Chain.Even p}} _ _ _
        (congr!{{Chain.Odd p} {Chain.Even p}} (c.h.fiber p).apply _ _ (Forms.evenZero p ((c.h.fiber p).apply w)))
        (c.h.fiber p).preservesZero))
    (Additive.zeroRight ((Chain.parity.backward.fiber p).apply w));
