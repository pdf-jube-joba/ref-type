\import \root.Thom[].Isomorphism[].LineForms[].Koszul[X := Point.Base, baseSpace := Point.topology] \as Forms;
\import Operations.Models[X := Point.Total, baseSpace := Trivial.topology] \as Models;
\import Models.Chains[].Of[complex := Forms.complex] \as Chain;
\import Support.FiniteComplexes[].Of[complex := Forms.complex].Supported[K := Native.ZeroSection,
  compactK := Total.zeroCompact, exactOutside := Forms.exactOutside] \as SourceClass;
\import SourceClass.In[w := witness] \as LocalClass;
\import Operations.Models[X := Pair.A, baseSpace := Pair.subspace] \as BoundaryModels;
\import Models.Pullback[b := Chain.parity.even, Y := Pair.A, source := Pair.subspace,
  f := LocalClass.boundaryInclusion, regular := LocalClass.boundaryRegular] \as BoundaryEven;
\import Models.Pullback[b := Chain.parity.odd, Y := Pair.A, source := Pair.subspace,
  f := LocalClass.boundaryInclusion, regular := LocalClass.boundaryRegular] \as BoundaryOdd;
\import Models.PullbackMap[p := Chain.parity.even, q := Chain.parity.odd, Y := Pair.A, source := Pair.subspace,
  f := LocalClass.boundaryInclusion, regular := LocalClass.boundaryRegular] \as D;
\import Models.PullbackMap[p := Chain.parity.odd, q := Chain.parity.even, Y := Pair.A, source := Pair.subspace,
  f := LocalClass.boundaryInclusion, regular := LocalClass.boundaryRegular] \as E;
\import Pair.Restriction[] \as Restriction;
\import compact_support_k.Support[].CompactBundles[X := Pair.A, space := Pair.subspace,
  compact := Restriction.compactSubset, hausdorff := Restriction.hausdorffSubset].Acyclic[
  p := BoundaryEven.value, q := BoundaryOdd.value, d := D.map Chain.parity.forward, e := E.map Chain.parity.backward] \as Acyclic;
\module At(c: Acyclic.Contraction);
\module Transport(c: Acyclic.Contraction);
\module Global;
\module Diagram(c: Acyclic.Contraction);
