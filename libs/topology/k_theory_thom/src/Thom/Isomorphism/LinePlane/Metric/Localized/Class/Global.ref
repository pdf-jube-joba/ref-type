\import Forms.Compact[compact := Finite.compact, hausdorff := Finite.hausdorff] \as Canonical;
\definition localized: \forall (c: Acyclic.Contraction) -> SourceClass.value =
  Local.extend (\parent.Transport[c := c].pull \root.Thom[].Isomorphism[].NegativeNormalization[].Disk[].diskBeta) :=
  \fun (c: Acyclic.Contraction) => trans!{{Relative.Reduced[model := Support.model].Carrier}} _ _ _ (SourceClass.agreement witness)
    (trans!{{Relative.Reduced[model := Support.model].Carrier}} _ _ _ (LocalClass.agreement c)
      (congr!{{Quotient.Relative} {Relative.Reduced[model := Support.model].Carrier}} Local.extend _ _ \parent.Transport[c := c].equation));
\module Beta(c: Acyclic.Contraction);
\definition equation: Point.thom = Relative.Pullback[source := Point.model, target := periodic_k_theory.Periodicity[].sphere,
  f := \root.Thom[].Isomorphism[].LinePlane[].Compactification[].equivalence.forward].map periodic_k_theory.Periodicity[].beta := \block {
  \takefrom c: Acyclic.Contraction \by LocalClass.contractions \then
  \return Beta[c := c].equation
};
