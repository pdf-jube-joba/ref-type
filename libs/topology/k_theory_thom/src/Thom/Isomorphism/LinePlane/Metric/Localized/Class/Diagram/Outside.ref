\definition noSmall: Logic.Not (R.Lt (Model.squared p) Real.one) :=
  \fun (small: R.Lt (Model.squared p) Real.one) => outside
    (\idelim MetricNeighborhood.squaredBall = Neighbor.openSet \with U: \Pow Point.Total => \In[Point.Total] U p \by {
      base: small, equality: sym!{{\Pow Point.Total}} _ _ MetricNeighborhood.squareOpenEquation
    });
\definition bound: R.Le Real.one (Plane.r2 (TotalCoordinates.forward p)) :=
  R.leReplaceRight Real.one (Model.squared p) (Plane.r2 (TotalCoordinates.forward p)) (squaredFormula p)
    (R.Order[].leOfNotLtReverse Real.one (Model.squared p) noSmall);
\definition collapsed: SphereQuotient.projection (SphereForward.map (TotalCoordinates.forward p)) = SphereQuotient.point :=
  SphereQuotient.onSubset (\into[Sphere.Sphere](SphereForward.map (TotalCoordinates.forward p), Cover.PositiveHalf) \by {
    SphereModel.Outside[z := TotalCoordinates.forward p, bound := bound].nonnegative
  });
\definition image: map (Plus.inclusion p) = SphereQuotient.point :=
  trans!{{SphereQuotient.Carrier}} _ _ _
    (congr!{{Quotient.Carrier} {SphereQuotient.Carrier}} (\fun (q: Quotient.Carrier) => SphereMapping.quotientMap (LocalMap.map q)) _ _ (Local.offRegion p outside))
    (trans!{{SphereQuotient.Carrier}} _ _ _
      (congr!{{LocalMap.target.Carrier} {SphereQuotient.Carrier}} SphereMapping.quotientMap _ _
        ((algebraic_topology.Pointed[A := Quotient.Carrier].Maps[B := LocalMap.target.Carrier].laws
          (Relative.pointed Quotient.model) (Relative.pointed LocalMap.target) LocalMap.map).pointed))
      ((algebraic_topology.Pointed[A := LocalMap.target.Carrier].Maps[B := SphereQuotient.Carrier].laws
        (Relative.pointed LocalMap.target) (Relative.pointed SphereQuotient.model) SphereMapping.quotientMap).pointed));
\definition equation: map (Plus.inclusion p) = SphereImage.map (Plus.inclusion p) :=
  trans!{{SphereQuotient.Carrier}} _ _ _ image
    (sym!{{SphereQuotient.Carrier}} _ _ (trans!{{SphereQuotient.Carrier}} _ _ _
      (congr!{{Sphere.Sphere} {SphereQuotient.Carrier}} SphereQuotient.projection _ _ (NativeSphere.onFinite p)) collapsed));
