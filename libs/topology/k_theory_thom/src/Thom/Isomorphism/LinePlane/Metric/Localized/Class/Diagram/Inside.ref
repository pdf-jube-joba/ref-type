\definition region: Local.Region := \into[Point.Total](p, Neighbor.openSet) \by { inside };
\definition local: Local.Carrier := Local.intoLocal region;
\definition image: map (Plus.inclusion p) = SphereQuotient.projection (SphereForward.map (TotalCoordinates.forward p)) :=
  trans!{{SphereQuotient.Carrier}} _ _ _
    (congr!{{Quotient.Carrier} {SphereQuotient.Carrier}} (\fun (q: Quotient.Carrier) => SphereMapping.quotientMap (LocalMap.map q)) _ _ (Local.onRegion region))
    (trans!{{SphereQuotient.Carrier}} _ _ _
      (congr!{{LocalMap.target.Carrier} {SphereQuotient.Carrier}} SphereMapping.quotientMap _ _ (LocalMap.onProjection local))
      (trans!{{SphereQuotient.Carrier}} _ _ _ (SphereMapping.onProjection (g local))
        (congr!{{Sphere.Sphere} {SphereQuotient.Carrier}} SphereQuotient.projection _ _
          (trans!{{Sphere.Sphere}} _ _ _ (PlaneDisk.diagram (h local))
            (congr!{{Plane.Carrier} {Sphere.Sphere}} SphereForward.map _ _ (Geometry.hCoordinates local))))));
\definition equation: map (Plus.inclusion p) = SphereImage.map (Plus.inclusion p) :=
  trans!{{SphereQuotient.Carrier}} _ _ _ image
    (sym!{{SphereQuotient.Carrier}} _ _ (congr!{{Sphere.Sphere} {SphereQuotient.Carrier}} SphereQuotient.projection _ _ (NativeSphere.onFinite p)));
