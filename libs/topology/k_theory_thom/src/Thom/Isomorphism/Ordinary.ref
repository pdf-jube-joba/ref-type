\import Relative.Absolute[X := X, space := space, compact := compact, hausdorff := hausdorff] \as Absolute;
\import Absolute.Additive[] \as Additive;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := space, compact := compact, hausdorff := hausdorff].K0[] \as K;
\import \parent.Bott[base := Absolute.model] \as Bott;
\definition model: N.Nat^ -> Relative.CompactPointed := Bott.model;
\definition Carrier[n: N.Nat^]: \Set := Bott.Carrier n;
\definition group[n: N.Nat^]: std.Alg[].Alg[].CommutativeGroup[Carrier n] := Bott.group n;
\definition initial: Periodicity.Isomorphism[A := K.Carrier, B := Bott.Carrier N.Nat^::zero,
  source := K.group, target := Bott.group N.Nat^::zero].Data :=
  Periodicity.Isomorphism[A := K.Carrier, B := Bott.Carrier N.Nat^::zero,
    source := K.group, target := Bott.group N.Nat^::zero].Data {
    forward := Absolute.forward, backward := Absolute.backward,
    leftInverse := Absolute.leftInverse, rightInverse := Absolute.rightInverse,
    forwardAdd := Additive.forwardAdd, backwardAdd := Additive.backwardAdd,
    forwardZero := Additive.forwardZero, backwardZero := Additive.backwardZero
  };
\definition isomorphism[n: N.Nat^]: Periodicity.Isomorphism[A := K.Carrier, B := Carrier n,
  source := K.group, target := group n].Data :=
  Periodicity.Isomorphism[A := K.Carrier, B := Bott.Carrier N.Nat^::zero, source := K.group,
    target := Bott.group N.Nat^::zero].Compose[
    C := Carrier n, last := group n, first := initial, second := Bott.isomorphism n].data;
\definition forward[n: N.Nat^]: K.Carrier -> Carrier n := (isomorphism n).forward;
\definition backward[n: N.Nat^]: Carrier n -> K.Carrier := (isomorphism n).backward;
\definition forwardProduct: \forall (n: N.Nat^)(a: K.Carrier) -> forward (N.Nat^::succ n) a =
  Relative.Smash[left := model n, right := Periodicity.sphere].External[].product (forward n a) Periodicity.beta :=
  \fun (n: N.Nat^)(a: K.Carrier) => Bott.forwardProduct n (Absolute.forward a);
\module Disk;
\module Trivial(n: N.Nat^);
