\definition value: Quotient.Relative := ToReduced.map (Group.value r.value);
\definition forgetFormula: Projection.projectionPull value = BottClass.generator :=
  trans!{{K.K0[].Carrier}} _ _ _ (Projection.onTriple r.value)
    (trans!{{K.K0[].Carrier}} _ _ _ (Forget.onTriple r.value)
      (trans!{{K.K0[].Carrier}} _ _ _
        (congr!{{K.Classes} {K.Classes} {K.K0[].Carrier}} K.K0[].difference _ _ _ _
          (sym!{{K.Classes}} _ _ (Represent.positiveClass comparison r))
          (sym!{{K.Classes}} _ _ (Represent.negativeClass comparison r)))
        (congr!{{K.Classes} {K.K0[].Carrier}} (K.K0[].difference Represent.positiveValue) _ _ oneClass)));
\definition forwardFormula: Contractible.forward value = beta :=
  trans!{{K.K0[].Carrier}} _ _ _ (sym!{{K.K0[].Carrier}} _ _ (Projection.equation value)) forgetFormula;
\definition normalization: value = relativeBeta := Contractible.injective value relativeBeta
  (trans!{{ReducedSphere.Carrier}} _ _ _ forwardFormula (sym!{{ReducedSphere.Carrier}} _ _ relativeBetaFormula));
