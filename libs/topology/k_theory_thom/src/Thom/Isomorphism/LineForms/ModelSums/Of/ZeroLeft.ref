\import Bundles.Isomorphisms[X := X, F := Models.Fiber second.ranks, G := Models.Fiber Sum.value.ranks,
  source := Models.bundle second, target := Models.bundle Sum.value] \as Maps;
\definition isomorphism: Maps.Isomorphism := Maps.Isomorphism {
  forward := Sum.secondInclusion,
  backward := Sum.secondProjection,
  leftInverse := \fun (x: X)(b: B x) => restJoin x ((Models.bundle first).space x).zero b,
  rightInverse := \fun (x: X)(v: V x) => trans!{{V x}} _ _ _
    (congr!{{A x} {V x}} (\fun (a: A x) => join x a (rest x v)) _ _ (sym!{{A x}} _ _ (zero x (head x v))))
    (recover x v)
};
