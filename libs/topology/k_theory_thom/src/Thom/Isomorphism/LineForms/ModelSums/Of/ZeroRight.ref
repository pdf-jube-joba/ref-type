\import Bundles.Isomorphisms[X := X, F := Models.Fiber first.ranks, G := Models.Fiber Sum.value.ranks,
  source := Models.bundle first, target := Models.bundle Sum.value] \as Maps;
\definition isomorphism: Maps.Isomorphism := Maps.Isomorphism {
  forward := Sum.firstInclusion,
  backward := Sum.firstProjection,
  leftInverse := \fun (x: X)(a: A x) => headJoin x a ((Models.bundle second).space x).zero,
  rightInverse := \fun (x: X)(v: V x) => trans!{{V x}} _ _ _
    (congr!{{B x} {V x}} (join x (head x v)) _ _ (sym!{{B x}} _ _ (zero x (rest x v))))
    (recover x v)
};
