\import linear_algebra.Commutative[K := C.Complex,
  scalarRing := std.Alg[].Field[].fieldAsCommutativeRing C.Complex C.Algebra[].field] \as Linear;
\import Linear.Laws[V := Models.Fiber Sum0.value.ranks x, space := (Models.bundle Sum0.value).space x] \as Group0;
\import Linear.Laws[V := Models.Fiber Sum1.value.ranks x, space := (Models.bundle Sum1.value).space x] \as Group1;
\definition backward0: \forall (w: Models.Fiber Chains.empty.ranks x) -> (parity0.backward.fiber x).apply w = ((Models.bundle Sum0.value).space x).zero :=
  \fun (w: Models.Fiber Chains.empty.ranks x) => trans!{{Models.Fiber Sum0.value.ranks x}} _ _ _
    (congr!{{Models.Fiber Chains.empty.ranks x} {Models.Fiber Sum0.value.ranks x}} (parity0.backward.fiber x).apply _ _ (emptyUnique x w))
    (parity0.backward.fiber x).preservesZero;
\definition backward1: \forall (v: Models.Fiber Sum0.value.ranks x) -> (parity1.backward.fiber x).apply v = ((Models.bundle Sum1.value).space x).zero :=
  \fun (v: Models.Fiber Sum0.value.ranks x) => Geometry1.ext x _ _
    (trans!{{Models.Fiber second.ranks x}} _ _ _
      (Geometry1.From[domain := Sum0.value, f := Models.zero Sum0.value second, g := parity0.forward].headFormula x v)
      (sym!{{Models.Fiber second.ranks x}} _ _ (Sum1.firstProjection.fiber x).preservesZero))
    (trans!{{Models.Fiber Chains.empty.ranks x}} _ _ _
      (Geometry1.From[domain := Sum0.value, f := Models.zero Sum0.value second, g := parity0.forward].restFormula x v)
      (trans!{{Models.Fiber Chains.empty.ranks x}} _ _ _ (emptyUnique x ((parity0.forward.fiber x).apply v))
        (sym!{{Models.Fiber Chains.empty.ranks x}} _ _ (Sum1.secondProjection.fiber x).preservesZero)));
\definition forward1: \forall (w: Models.Fiber Sum1.value.ranks x) ->
  (parity1.forward.fiber x).apply w = (Sum0.firstInclusion.fiber x).apply ((differential.fiber x).apply (Geometry1.head x w)) :=
  \fun (w: Models.Fiber Sum1.value.ranks x) => trans!{{Models.Fiber Sum0.value.ranks x}} _ _ _
    (Geometry1.To[target := Sum0.value, f := Models.compose second first Sum0.value differential parity0.inclusion,
      g := parity0.backward].formula x w)
    (trans!{{Models.Fiber Sum0.value.ranks x}} _ _ _
      (congr!{{Models.Fiber Sum0.value.ranks x} {Models.Fiber Sum0.value.ranks x}}
        (((Models.bundle Sum0.value).space x).add ((Sum0.firstInclusion.fiber x).apply ((differential.fiber x).apply (Geometry1.head x w)))) _ _
        (backward0 (Geometry1.rest x w)))
      (Group0.zeroRight ((Sum0.firstInclusion.fiber x).apply ((differential.fiber x).apply (Geometry1.head x w)))));
\definition evenZero: \forall (v: Models.Fiber parity.even.ranks x) -> (parity.forward.fiber x).apply v = ((Models.bundle parity.odd).space x).zero :=
  \fun (v: Models.Fiber parity.even.ranks x) => trans!{{Models.Fiber Sum1.value.ranks x}} _ _ _
    (Geometry2.To[target := Sum1.value, f := Models.compose Chains.empty second Sum1.value next parity1.inclusion,
      g := parity1.backward].formula x v)
    (trans!{{Models.Fiber Sum1.value.ranks x}} _ _ _
      (congr!{{Models.Fiber Sum1.value.ranks x} {Models.Fiber Sum1.value.ranks x} {Models.Fiber Sum1.value.ranks x}}
        ((Models.bundle Sum1.value).space x).add _ _ _ _
        (trans!{{Models.Fiber Sum1.value.ranks x}} _ _ _
          (congr!{{Models.Fiber Chains.empty.ranks x} {Models.Fiber Sum1.value.ranks x}}
            ((Models.compose Chains.empty second Sum1.value next parity1.inclusion).fiber x).apply _ _ (emptyUnique x (Geometry2.head x v)))
          ((Models.compose Chains.empty second Sum1.value next parity1.inclusion).fiber x).preservesZero)
        (backward1 (Geometry2.rest x v)))
      (Group1.zeroLeft ((Models.bundle Sum1.value).space x).zero));
\definition backwardFormula: \forall (w: Models.Fiber parity.odd.ranks x) ->
  (positive.forward.fiber x).apply ((parity.backward.fiber x).apply w) = (differential.fiber x).apply ((negative.forward.fiber x).apply w) :=
  \fun (w: Models.Fiber parity.odd.ranks x) => trans!{{Models.Fiber first.ranks x}} _ _ _
    (congr!{{Models.Fiber Sum0.value.ranks x} {Models.Fiber first.ranks x}} (Geometry0.head x) _ _
      (Geometry2.From[domain := Sum1.value, f := Models.zero Sum1.value Chains.empty, g := parity1.forward].restFormula x w))
    (trans!{{Models.Fiber first.ranks x}} _ _ _
      (congr!{{Models.Fiber Sum0.value.ranks x} {Models.Fiber first.ranks x}} (Geometry0.head x) _ _ (forward1 w))
      (Geometry0.headJoin x ((differential.fiber x).apply (Geometry1.head x w)) ((Models.bundle Chains.empty).space x).zero));
