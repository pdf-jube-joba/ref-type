\import \root.Thom[].For[X := X, F := (\fun (x: X) => Bundles.Vector one), bundle := Original.bundle,
  compact := compact, hausdorff := hausdorff] \as Canonical;
\import \root.Thom[].TotalSpace[X := X, F := (\fun (x: X) => Bundles.Vector one), bundle := Original.bundle,
  compact := compact, hausdorff := hausdorff] \as Topology;
\import compact_support_k.Support[].On[X := Native.Total, space := Original.bundle.totalSpace,
  hausdorff := Topology.separated, locallyCompact := Topology.locallyCompact] \as Supported;
\import compact_support_k.Support[].OnePoint[X := Native.Total, space := Original.bundle.totalSpace] \as Plus;
\import topological_k_theory.KTheory[].On[X := Supported.model.Carrier, baseSpace := (Relative.details Supported.model).topology,
  compact := (Relative.details Supported.model).compact, hausdorff := (Relative.details Supported.model).hausdorff] \as CompactTheory;
\definition rank: \forall (x: X) -> Family.rank x = one := \fun (x: X) => Family.rankFrame x one Original.identity;
\definition rankBound: \forall (x: X) -> N.Basic[].Prop[].Le (Family.rank x) one :=
  \fun (x: X) => \idelim one = Family.rank x \with n: N.Nat^ => N.Basic[].Prop[].Le n one \by {
    base: N.Basic[].Prop[].leRefl one, equality: sym!{{N.Nat^}} _ _ (rank x)
  };
\definition data: Canonical.Data := Canonical.Data { bound := one, selection := selection, rankBound := rankBound };
\import Encoded.Padding[n := N.Nat^::succ one, zero := \parent.Higher[n := N.Nat^::zero].zero,
  zeroOne := \parent.Higher[n := one].zero, zeroTwo := \parent.Higher[n := N.Nat^::succ one].zero,
  compact := compact, hausdorff := hausdorff] \as Padding;
\definition normalization: Canonical.thom = Padding.first :=
  trans!{{Canonical.Carrier}} _ _ _ (Canonical.formula data) (sym!{{Canonical.Carrier}} _ _ Padding.equation);
