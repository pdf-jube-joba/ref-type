\import Spaces.Multilinear[V := Bundles.Vector one, space := Bundles.coordinates one] \as Arguments;
\import \parent.\parent.CoordinateForms[] \as Forms;
\definition differentialFormula: \forall (w: Bundles.Vector one) ->
  ((Encoded.differential N.Nat^::zero).fiber p).apply w =
    (Bundles.coordinates one).smul (p.vector index) w :=
  \fun (w: Bundles.Vector one) => \axiom:funext(((Encoded.differential N.Nat^::zero).fiber p).apply w,
    (Bundles.coordinates one).smul (p.vector index) w,
    \fun (i: Fin.Fin one) => trans!{{C.Complex}} _ _ _
      (DegreeZero.coefficientFormula p
        ((\root.Thom[].Koszul[X := X, F := (\fun (x: X) => Bundles.Vector one), bundle := Original.bundle].Degree[k := N.Nat^::zero].differential.fiber p).apply ((Encoded.decode one p).apply w)) i)
      (trans!{{C.Complex}} _ _ _
        (congr!{{Arguments.Arguments one} {C.Complex}} ((Encoded.decode one p).apply w) _ _
          (Forms.extendZero p.vector (\fun (j: Fin.Fin N.Nat^::zero) => Forms.basis)))
        (trans!{{C.Complex}} _ _ _ (Forms.homogeneous ((Encoded.decode one p).apply w) p.vector)
          (congr!{{C.Complex} {C.Complex}} (Scalar.mul (p.vector index)) _ _
            (trans!{{C.Complex}} _ _ _
              (sym!{{C.Complex}} _ _ (DegreeOne.coefficientFormula p ((Encoded.decode one p).apply w) i))
              (congr!{{Bundles.Vector one} {C.Complex}} (\fun (v: Bundles.Vector one) => v i) _ _ (Encoded.encodeDecode one p w)))))));
