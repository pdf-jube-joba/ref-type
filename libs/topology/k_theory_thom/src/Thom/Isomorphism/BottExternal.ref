\import \parent.Point[n := n] \as Point;
\definition pointModel: Relative.CompactPointed := Point.model;
\definition pointThom: Relative.Reduced[model := pointModel].Carrier := Point.thom;
\import Relative.Smash[left := base, right := pointModel] \as Smash;
\definition target: Relative.CompactPointed := Smash.result;
\definition Carrier: \Set := Relative.Reduced[model := target].Carrier;
\definition group: std.Alg[].Alg[].CommutativeGroup[Carrier] := Relative.Reduced[model := target].group;
\definition Data: \Set := Periodicity.Isomorphism[A := Relative.Reduced[model := base].Carrier, B := Carrier,
  source := Relative.Reduced[model := base].group, target := group].Data;
\definition forward[a: Relative.Reduced[model := base].Carrier]: Carrier := Smash.External[].product a pointThom;
\import \parent.ExternalTower[] \as Tower;
\definition isomorphism: Data := (Tower.state n).data base;
\definition forwardProduct: \forall (a: Relative.Reduced[model := base].Carrier) -> isomorphism.forward a = Smash.External[].product a pointThom :=
  \fun (a: Relative.Reduced[model := base].Carrier) => (Tower.state n).product base a;
