\import Pair.BundleTriples[F := F, G := G, firstModel := firstModel, secondModel := secondModel] \as Triples;
\module With(alpha: Triples.OnSubset,
  positive: Bundles.Isomorphisms[X := X, F := F, G := (\fun (x: X) => Bundles.Vector (N.Nat^::succ N.Nat^::zero)),
    source := Triples.first, target := One.bundle].Isomorphism,
  negative: Bundles.Isomorphisms[X := X, F := G, G := (\fun (x: X) => Bundles.Vector N.Nat^::zero),
    source := Triples.second, target := Zero.bundle].Isomorphism);
