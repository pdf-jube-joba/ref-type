\definition formula: Projection.projectionPull Class.reduced = K.K0[].one := \block {
  \return trans!{{K.K0[].Carrier}} _ _ _
    (congr!{{Group.Carrier} {K.K0[].Carrier}} (\fun (v: Group.Carrier) => Projection.projectionPull (ToReduced.map v)) _ _ (Class.agreement r))
    (trans!{{K.K0[].Carrier}} _ _ _ (Projection.onTriple r.value)
      (trans!{{K.K0[].Carrier}} _ _ _ (Forget.onTriple r.value)
        (trans!{{K.K0[].Carrier}} _ _ _
          (congr!{{K.Classes} {K.Classes} {K.K0[].Carrier}} K.K0[].difference _ _ _ _
            (sym!{{K.Classes}} _ _ (Represent.positiveClass alpha r))
            (sym!{{K.Classes}} _ _ (Represent.negativeClass alpha r)))
          (trans!{{K.K0[].Carrier}} _ _ _
            (congr!{{K.Classes} {K.Classes} {K.K0[].Carrier}} K.K0[].difference _ _ _ _ positiveEquation negativeEquation) unitDifference))))
};
