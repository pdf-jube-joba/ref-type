\import K.Compare[F := F, G := (\fun (x: X) => Bundles.Vector (N.Nat^::succ N.Nat^::zero)),
  first := Triples.first, second := One.bundle, firstSame := \refl(space), secondSame := \refl(space)] \as PositiveClasses;
\import K.Compare[F := G, G := (\fun (x: X) => Bundles.Vector N.Nat^::zero),
  first := Triples.second, second := Zero.bundle, firstSame := \refl(space), secondSame := \refl(space)] \as NegativeClasses;
\import Operations.ScalarLine[X := X, baseSpace := space] \as ScalarLine;
\import K.Compare[F := (\fun (x: X) => Bundles.Vector (N.Nat^::succ N.Nat^::zero)), G := (\fun (x: X) => C.Complex),
  first := One.bundle, second := ScalarLine.bundle, firstSame := \refl(space), secondSame := \refl(space)] \as OneClasses;
\import K.Bundle[F := F, original := Triples.first, same := \refl(space)] \as EvenClass;
\import K.Bundle[F := G, original := Triples.second, same := \refl(space)] \as OddClass;
\definition positiveEquation: EvenClass.value = K.Line[].value := trans!{{K.Classes}} _ _ _
  (PositiveClasses.ofIsomorphism positive) (OneClasses.ofIsomorphism ScalarLine.coordinateIsomorphism);
\definition negativeEquation: OddClass.value = K.Trivial[n := N.Nat^::zero].value := NegativeClasses.ofIsomorphism negative;
\import algebra.Group[].Of[Carrier := K.K0[].Carrier, group := K.K0[].group] \as Additive;
\definition unitDifference: K.K0[].difference K.Line[].value K.Trivial[n := N.Nat^::zero].value = K.K0[].one :=
  trans!{{K.K0[].Carrier}} _ _ _ (congr!{{K.K0[].Carrier} {K.K0[].Carrier}} (K.K0[].add K.K0[].one) _ _ Additive.negZero)
    (Additive.zeroRight K.K0[].one);
\import Triples.With[alpha := alpha] \as Class;
\import Pair.FromBundles[F := F, G := G, source := Triples.first, target := Triples.second,
  sourceSame := \refl(space), targetSame := \refl(space)] \as Represent;
\module At(r: Represent.Result[alpha]);
\definition projectionFormula: Projection.projectionPull Class.reduced = K.K0[].one := \block {
  \takefrom r: Represent.Result[alpha] \by Represent.existence alpha \then
  \return At[r := r].formula
};
