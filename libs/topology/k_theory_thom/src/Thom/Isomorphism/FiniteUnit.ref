\import compact_support_k.Support[].On[X := X, space := space, hausdorff := hausdorff, locallyCompact := locallyCompact] \as Support;
\import Operations.Models[X := X, baseSpace := space].Chains[].Of[complex := complex] \as Chain;
\import Support.FiniteComplexes[].Of[complex := complex].Supported[K := K, compactK := compactK, exactOutside := exactOutside] \as Class;
\import Support.Neighborhood[K := K, compact := compactK] \as Neighborhood;
\import Bundles.Trivial[X := X, n := N.Nat^::succ N.Nat^::zero, baseSpace := space] \as One;
\import Bundles.Trivial[X := X, n := N.Nat^::zero, baseSpace := space] \as Zero;
\import topological_k_theory.KTheory[].On[X := Support.model.Carrier, baseSpace := (Relative.details Support.model).topology,
  compact := (Relative.details Support.model).compact, hausdorff := (Relative.details Support.model).hausdorff] \as CompactTheory;
\import compact_support_k.Support[].OnePoint[X := X, space := space] \as Plus;
\module With(
  positive: Bundles.Isomorphisms[X := X, F := Chain.Even, G := (\fun (x: X) => Bundles.Vector (N.Nat^::succ N.Nat^::zero)),
    source := Chain.even, target := One.bundle].Isomorphism,
  negative: Bundles.Isomorphisms[X := X, F := Chain.Odd, G := (\fun (x: X) => Bundles.Vector N.Nat^::zero),
    source := Chain.odd, target := Zero.bundle].Isomorphism);
