\import Supported.With[contraction := contraction] \as Chosen;
\import Pair.BundleTriples[F := Chain.Even, G := Chain.Odd, firstModel := RelativeComplex.firstModel,
  secondModel := RelativeComplex.secondModel].With[alpha := Chosen.comparison] \as Class;
\import Pair.FromBundles[F := Chain.Even, G := Chain.Odd, source := Chain.even, target := Chain.odd,
  sourceSame := \refl(space), targetSame := \refl(space)] \as Represent;
\definition formula: Projection.projectionPull Chosen.value = K.K0[].one := \block {
  \takefrom r: Represent.Result[Chosen.comparison] \by Represent.existence Chosen.comparison \then
  \return trans!{{K.K0[].Carrier}} _ _ _
    (congr!{{Group.Carrier} {K.K0[].Carrier}} (\fun (v: Group.Carrier) => Projection.projectionPull (ToReduced.map v)) _ _ (Class.agreement r))
    (trans!{{K.K0[].Carrier}} _ _ _ (Projection.onTriple r.value)
      (trans!{{K.K0[].Carrier}} _ _ _ (Forget.onTriple r.value)
        (trans!{{K.K0[].Carrier}} _ _ _
          (congr!{{K.Classes} {K.Classes} {K.K0[].Carrier}} K.K0[].difference _ _ _ _
            (sym!{{K.Classes}} _ _ (Represent.positiveClass Chosen.comparison r))
            (sym!{{K.Classes}} _ _ (Represent.negativeClass Chosen.comparison r)))
          (trans!{{K.K0[].Carrier}} _ _ _
            (congr!{{K.Classes} {K.Classes} {K.K0[].Carrier}} K.K0[].difference _ _ _ _ positiveEquation negativeEquation) unitDifference))))
};
