\import K.Compare[F := Chain.Even, G := (\fun (x: X) => Bundles.Vector (N.Nat^::succ N.Nat^::zero)),
  first := Chain.even, second := One.bundle, firstSame := \refl(space), secondSame := \refl(space)] \as PositiveClasses;
\import K.Compare[F := Chain.Odd, G := (\fun (x: X) => Bundles.Vector N.Nat^::zero),
  first := Chain.odd, second := Zero.bundle, firstSame := \refl(space), secondSame := \refl(space)] \as NegativeClasses;
\import Operations.ScalarLine[X := X, baseSpace := space] \as ScalarLine;
\import K.Compare[F := (\fun (x: X) => Bundles.Vector (N.Nat^::succ N.Nat^::zero)), G := (\fun (x: X) => C.Complex),
  first := One.bundle, second := ScalarLine.bundle, firstSame := \refl(space), secondSame := \refl(space)] \as OneClasses;
\import K.Bundle[F := Chain.Even, original := Chain.even, same := \refl(space)] \as EvenClass;
\import K.Bundle[F := Chain.Odd, original := Chain.odd, same := \refl(space)] \as OddClass;
\definition positiveEquation: EvenClass.value = K.Line[].value := trans!{{K.Classes}} _ _ _
  (PositiveClasses.ofIsomorphism positive) (OneClasses.ofIsomorphism ScalarLine.coordinateIsomorphism);
\definition negativeEquation: OddClass.value = K.Trivial[n := N.Nat^::zero].value := NegativeClasses.ofIsomorphism negative;
\import algebra.Group[].Of[Carrier := K.K0[].Carrier, group := K.K0[].group] \as Additive;
\definition unitDifference: K.K0[].difference K.Line[].value K.Trivial[n := N.Nat^::zero].value = K.K0[].one :=
  trans!{{K.K0[].Carrier}} _ _ _ (congr!{{K.K0[].Carrier} {K.K0[].Carrier}} (K.K0[].add K.K0[].one) _ _ Additive.negZero)
    (Additive.zeroRight K.K0[].one);
\module At(contraction: Acyclic.Contraction);
\definition projectionFormula: Projection.projectionPull Supported.value = K.K0[].one := \block {
  \takefrom c: Acyclic.Contraction \by Supported.existence \then
  \return trans!{{K.K0[].Carrier}} _ _ _
    (congr!{{Quotient.Relative} {K.K0[].Carrier}} Projection.projectionPull _ _ (Supported.agreement c)) (At[contraction := c].formula)
};
\definition normalization: Supported.value = unit := injective Supported.value unit
  (trans!{{K.K0[].Carrier}} _ _ _ projectionFormula (sym!{{K.K0[].Carrier}} _ _ unitFormula));
