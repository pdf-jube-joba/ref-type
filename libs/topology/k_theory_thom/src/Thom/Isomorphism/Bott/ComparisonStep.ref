\definition two: N.Nat^ := N.Nat^::succ (N.Nat^::succ N.Nat^::zero);
\definition lifted: Relative.Equivalence[source := Relative.iterate two (Suspended n), target := Relative.iterate two (model n)].Data :=
  Relative.Equivalence[source := Suspended n, target := model n].With[e := previous].iterate two;
\import Periodicity.DoubleComparison[model := model n] \as Double;
\definition equivalence: Comparison (N.Nat^::succ n) :=
  Relative.Equivalence[source := Suspended (N.Nat^::succ n), target := model (N.Nat^::succ n)].Compose[
    middle := Relative.iterate two (model n), first := lifted, second := Double.equivalence].result;
