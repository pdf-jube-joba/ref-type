\import Periodicity.Reduced[model := model n] \as Native;
\import Native.Inverse[] \as Inverse;
\definition oneStep: Periodicity.Isomorphism[A := Carrier n, B := Carrier (N.Nat^::succ n), source := group n,
  target := group (N.Nat^::succ n)].Data :=
  Periodicity.Isomorphism[A := Carrier n, B := Carrier (N.Nat^::succ n), source := group n,
    target := group (N.Nat^::succ n)].Data {
    forward := Native.forward, backward := Inverse.backward,
    leftInverse := Inverse.leftInverse, rightInverse := Inverse.rightInverse,
    forwardAdd := Inverse.forwardAdd, backwardAdd := Inverse.backwardAdd,
    forwardZero := Inverse.forwardZero, backwardZero := Inverse.backwardZero
  };
\definition data: Data (N.Nat^::succ n) := Periodicity.Isomorphism[A := Carrier N.Nat^::zero, B := Carrier n,
  source := group N.Nat^::zero, target := group n].Compose[
  C := Carrier (N.Nat^::succ n), last := group (N.Nat^::succ n), first := previous, second := oneStep].data;
