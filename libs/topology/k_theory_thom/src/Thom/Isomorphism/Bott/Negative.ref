\definition Carrier[n: N.Nat^]: \Set := Relative.Negative[original := model n, degree := degree].Carrier;
\definition group[n: N.Nat^]: std.Alg[].Alg[].CommutativeGroup[Carrier n] := Relative.Negative[original := model n, degree := degree].group;
\definition Data[n: N.Nat^]: \Set := Periodicity.Isomorphism[A := Carrier N.Nat^::zero, B := Carrier n,
  source := group N.Nat^::zero, target := group n].Data;
\definition initial: Data N.Nat^::zero := Periodicity.Isomorphism[A := Carrier N.Nat^::zero, B := Carrier N.Nat^::zero,
  source := group N.Nat^::zero, target := group N.Nat^::zero].Data {
  forward := \fun (x: Carrier N.Nat^::zero) => x, backward := \fun (x: Carrier N.Nat^::zero) => x,
  leftInverse := \fun (x: Carrier N.Nat^::zero) => \refl(x), rightInverse := \fun (x: Carrier N.Nat^::zero) => \refl(x),
  forwardAdd := \fun (x, y: Carrier N.Nat^::zero) => \refl((group N.Nat^::zero).base.op x y),
  backwardAdd := \fun (x, y: Carrier N.Nat^::zero) => \refl((group N.Nat^::zero).base.op x y),
  forwardZero := \refl((group N.Nat^::zero).base.unit), backwardZero := \refl((group N.Nat^::zero).base.unit)
};
\module Step(n: N.Nat^, previous: Data n);
\definition isomorphism: \forall (n: N.Nat^) -> Data n :=
  \induction (n: N.Nat^) \return Data n \with {
    | zero: initial
    | succ: \fun (n: N.Nat^)(previous: Data n) => Step[n := n, previous := previous].data
  };
