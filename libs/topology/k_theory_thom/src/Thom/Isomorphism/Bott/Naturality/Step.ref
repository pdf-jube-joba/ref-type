\import Periodicity.Reduced[model := model n] \as Native;
\import Native.Naturality[other := Other.model n, f := induced n] \as Natural;
\import Periodicity.Reduced[model := Other.model n] \as OtherNative;
\definition equations: Equations[N.Nat^::succ n] := Equations[N.Nat^::succ n] {
  forward := \fun (a: Other.Carrier N.Nat^::zero) => trans!{{Carrier (N.Nat^::succ n)}} _ _ _
    (Natural.forwardEquation (Other.forward n a))
    (congr!{{Carrier n} {Carrier (N.Nat^::succ n)}} Native.forward _ _ (previous.forward a)),
  backward := \fun (a: Other.Carrier (N.Nat^::succ n)) => trans!{{Carrier N.Nat^::zero}} _ _ _
    (previous.backward (OtherNative.Inverse[].backward a))
    (congr!{{Carrier n} {Carrier N.Nat^::zero}} (Source.backward n) _ _
      (sym!{{Carrier n}} _ _ (Natural.backwardEquation a)))
};
