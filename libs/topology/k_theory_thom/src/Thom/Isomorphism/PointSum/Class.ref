\import \root.Thom[].KoszulProduct[X := Left.Base, F := (\fun (x: Left.Base) => Bundles.Vector n),
  G := (\fun (x: Left.Base) => Bundles.Vector one), left := LeftBundle.bundle, right := RightBundle.bundle,
  sameBase := (\refl(Left.topology)), compact := Finite.compact, hausdorff := Finite.hausdorff] \as KoszulProduct;
\import Relative.Smash[left := Left.model, right := Right.model] \as Smash;
\definition product: Relative.Reduced[model := target].Carrier := Smash.External[].product Left.thom Right.thom;
\definition equation: Next.thom = Relative.Pullback[source := source, target := target, f := equivalence.forward].map product :=
  trans!{{Relative.Reduced[model := source].Carrier}} _ _ _
    (sym!{{Relative.Reduced[model := source].Carrier}} _ _
      (trans!{{Relative.Reduced[model := source].Carrier}} _ _ _
        (congr!{{Relative.Reduced[model := Fiber.sourceModel].Carrier} {Relative.Reduced[model := source].Carrier}} Change.unpull _ _ Change.equation)
        (Change.unpullPull Next.thom)))
    (trans!{{Relative.Reduced[model := source].Carrier}} _ _ _
      (congr!{{Relative.Reduced[model := Fiber.sourceModel].Carrier} {Relative.Reduced[model := source].Carrier}} Change.unpull _ _
        (trans!{{Relative.Reduced[model := Fiber.sourceModel].Carrier}} _ _ _ KoszulProduct.equation (Fiber.equation Left.thom)))
      (sym!{{Relative.Reduced[model := source].Carrier}} _ _
        (Relative.PullbackComposition[source := source, middle := Fiber.sourceModel, target := target,
          first := Change.Inverse[].equivalence.backward, second := Fiber.equivalence.forward].equation product)));
