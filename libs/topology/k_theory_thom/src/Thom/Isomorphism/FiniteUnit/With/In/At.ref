\import LocalClass.With[contraction := c] \as Chosen;
\import Euler.Triples[F := LocalClass.FirstFiber, G := LocalClass.SecondFiber,
  firstModel := LocalClass.firstOnLocal, secondModel := LocalClass.secondOnLocal].With[
  alpha := Chosen.comparison, positive := localPositive, negative := localNegative] \as LocalEuler;
\definition region: Local.Region := \into[X](x, Neighbor.openSet) \by { Neighbor.contains x member };
\definition point: Local.Carrier := Local.intoLocal region;
\definition formula: CompactTheory.Ranks[].rank Chosen.value (Plus.inclusion x) = std.Arithmetic[].Int[].One.specification :=
  trans!{{std.Arithmetic[].Int[].Int^}} _ _ _ (ExtensionRanks.naturality Chosen.localValue (Plus.inclusion x))
    (trans!{{std.Arithmetic[].Int[].Int^}} _ _ _
      (congr!{{Quotient.Carrier} {std.Arithmetic[].Int[].Int^}} (QuotientTheory.Ranks[].rank Chosen.localValue) _ _ (Local.onRegion region))
      (trans!{{std.Arithmetic[].Int[].Int^}} _ _ _ (sym!{{std.Arithmetic[].Int[].Int^}} _ _ (ProjectionRanks.naturality Chosen.localValue point))
        (trans!{{std.Arithmetic[].Int[].Int^}} _ _ _
          (congr!{{LocalTheory.K0[].Carrier} {std.Arithmetic[].Int[].Int^}} (\fun (a: LocalTheory.K0[].Carrier) => LocalTheory.Ranks[].rank a point) _ _ LocalEuler.projectionFormula)
          (congr!{{LocalTheory.IntegerFunctions[].Carrier} {std.Arithmetic[].Int[].Int^}}
            (\fun (f: LocalTheory.IntegerFunctions[].Carrier) => f point) _ _ LocalTheory.Ranks[].One[].virtual))));
