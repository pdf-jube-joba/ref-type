\module In(w: Neighborhood.Witness);
\definition pointRank: \forall (x: X) -> \In[X] K x ->
  CompactTheory.Ranks[].rank Class.value (Plus.inclusion x) = std.Arithmetic[].Int[].One.specification := \block {
  \fun (x: X)(member: \In[X] K x) \then
  \takefrom w: Neighborhood.Witness \by Neighborhood.existence \then
  \return trans!{{std.Arithmetic[].Int[].Int^}} _ _ _
    (congr!{{Relative.Reduced[model := Support.model].Carrier} {std.Arithmetic[].Int[].Int^}}
      (\fun (a: Relative.Reduced[model := Support.model].Carrier) => CompactTheory.Ranks[].rank a (Plus.inclusion x)) _ _ (Class.agreement w))
    (In[w := w].pointRank x member)
};
