\import Bundles.Trivial[X := X, n := N.Nat^::zero, baseSpace := originalSpace] \as Original;
\import Bundles.Family[X := X, F := (\fun (x: X) => Bundles.Vector N.Nat^::zero)].Of[bundle := Original.bundle].Pullback[Y := Y, source := baseSpace, f := f] \as Pull;
\import Bundles.Trivial[X := Y, n := N.Nat^::zero, baseSpace := baseSpace] \as Target;
\import Operations.Alternating[X := Y, F := (\fun (y: Y) => Bundles.Vector N.Nat^::zero), bundle := Pull.pulled regular, k := degree] \as FormsBundle;
\definition sourceChart: Bundles.Family[X := Y, F := (\fun (y: Y) => Bundles.Vector N.Nat^::zero)].With[data := Pull.pulled regular].Chart :=
  Pull.In[c := Original.trivialization].trivialization regular;
\import FormsBundle.In[c := sourceChart, enumeration := enumeration] \as Global;
\definition dimension: Global.dimension = N.Nat^::zero := \refl(N.Nat^::zero);
\import bundle_homotopy.Homotopy[].Over[K := C.Complex, field := C.Algebra[].field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := Scalars.scalar].ChartPullback[
  X := Y, F := FormsBundle.Fiber, bundle := FormsBundle.alternating, chart := Global.trivialization,
  Y := Y, source := baseSpace, f := (\fun (y: Y) => y),
  continuous := topology.Maps[A := Y, B := Y].Identity[].continuous baseSpace,
  inside := (\fun (y: Y) => \refl(f y))] \as Chart;
\import Bundles.Family[X := Y, F := FormsBundle.Fiber].Of[bundle := FormsBundle.alternating].PullbackIdentity[] \as Identity;
\import Operations.IsomorphismComposition[X := Y, F := FormsBundle.Fiber, G := FormsBundle.Fiber,
  H := (\fun (y: Y) => Bundles.Vector N.Nat^::zero), source := FormsBundle.alternating,
  middle := Chart.pulledBundle, target := Target.bundle] \as Composition;
\import Bundles.Isomorphisms[X := Y, F := FormsBundle.Fiber, G := (\fun (y: Y) => Bundles.Vector N.Nat^::zero),
  source := FormsBundle.alternating, target := Target.bundle] \as Maps;
\definition isomorphism: Maps.Isomorphism := Composition.compose Identity.isomorphism Chart.isomorphism;
\definition emptyUnique: \forall (v: Bundles.Vector N.Nat^::zero) -> v = (Bundles.coordinates N.Nat^::zero).zero :=
  \fun (v: Bundles.Vector N.Nat^::zero) => \axiom:funext(v, (Bundles.coordinates N.Nat^::zero).zero,
    \fun (i: Fin.Fin N.Nat^::zero) => Logic.falseElim _ (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i)));
\definition zero: \forall (y: Y)(omega: FormsBundle.Fiber y) -> omega = (FormsBundle.fiberSpace y).zero :=
  \fun (y: Y)(omega: FormsBundle.Fiber y) => trans!{{FormsBundle.Fiber y}} _ _ _
    (sym!{{FormsBundle.Fiber y}} _ _ ((\bysub(Maps.Data, Maps.Isomorphism, isomorphism)).leftInverse y omega))
    (trans!{{FormsBundle.Fiber y}} _ _ _
      (congr!{{Bundles.Vector N.Nat^::zero} {FormsBundle.Fiber y}} (isomorphism.backward.fiber y).apply _ _
        (emptyUnique ((isomorphism.forward.fiber y).apply omega))) (isomorphism.backward.fiber y).preservesZero);
