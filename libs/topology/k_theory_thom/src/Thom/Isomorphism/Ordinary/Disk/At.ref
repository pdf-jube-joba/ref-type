\import Spaces.DiskSuspension[X := X, space := space, n := Bott.dimension n] \as Disk;
\import \root.Thom[].Isomorphism[].Model[A := Disk.Carrier, source := Disk.topology,
  target := Suspended (Bott.dimension n), h := (Presentation.comparison (Bott.dimension n)).homeomorphism,
  point := Disk.pointed.basepoint, preserves := (Presentation.comparison (Bott.dimension n)).pointed] \as Model;
\definition model: Relative.CompactPointed := Model.model;
\definition equivalence: Relative.Equivalence[source := model, target := Bott.model n].Data :=
  Relative.Equivalence[source := model, target := Bott.model n].Compose[
    middle := Suspended (Bott.dimension n), first := Model.equivalence, second := Bott.comparison n].result;
\import Relative.Equivalence[source := model, target := Bott.model n].With[e := equivalence].Groups[] \as Transport;
\definition initial: Periodicity.Isomorphism[A := K.Carrier, B := Bott.Carrier n,
  source := K.group, target := Bott.group n].Data := Ordinary.isomorphism n;
\definition transport: Periodicity.Isomorphism[A := Bott.Carrier n, B := Relative.Reduced[model := model].Carrier,
  source := Bott.group n, target := Relative.Reduced[model := model].group].Data :=
  Periodicity.Isomorphism[A := Bott.Carrier n, B := Relative.Reduced[model := model].Carrier,
    source := Bott.group n, target := Relative.Reduced[model := model].group].Data {
    forward := Transport.forward, backward := Transport.backward,
    leftInverse := Transport.rightInverse, rightInverse := Transport.leftInverse,
    forwardAdd := Transport.forwardAdd, backwardAdd := Transport.backwardAdd,
    forwardZero := Transport.forwardZero, backwardZero := Transport.backwardZero
  };
\definition isomorphism: Periodicity.Isomorphism[A := K.Carrier, B := Relative.Reduced[model := model].Carrier,
  source := K.group, target := Relative.Reduced[model := model].group].Data :=
  Periodicity.Isomorphism[A := K.Carrier, B := Bott.Carrier n, source := K.group,
    target := Bott.group n].Compose[C := Relative.Reduced[model := model].Carrier, last := Relative.Reduced[model := model].group,
    first := initial, second := transport].data;
\module Negative(degree: N.Nat^);
