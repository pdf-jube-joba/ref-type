\import Bott.Negative[degree := degree] \as Native;
\import Relative.Equivalence[source := model, target := Bott.model n].With[e := equivalence].Negative[degree := degree] \as Transport;
\import Relative.Negative[original := model, degree := degree] \as Target;
\definition transport: Periodicity.Isomorphism[A := Native.Carrier n, B := Target.Carrier,
  source := Native.group n, target := Target.group].Data :=
  Periodicity.Isomorphism[A := Native.Carrier n, B := Target.Carrier,
    source := Native.group n, target := Target.group].Data {
    forward := Transport.forward, backward := Transport.backward,
    leftInverse := Transport.rightInverse, rightInverse := Transport.leftInverse,
    forwardAdd := Transport.additive, backwardAdd := Transport.inverseAdditive,
    forwardZero := Transport.forwardZero, backwardZero := Transport.backwardZero
  };
\definition isomorphism: Periodicity.Isomorphism[A := Native.Carrier N.Nat^::zero, B := Target.Carrier,
  source := Native.group N.Nat^::zero, target := Target.group].Data :=
  Periodicity.Isomorphism[A := Native.Carrier N.Nat^::zero, B := Native.Carrier n,
    source := Native.group N.Nat^::zero, target := Native.group n].Compose[
    C := Target.Carrier, last := Target.group, first := Native.isomorphism n, second := transport].data;
