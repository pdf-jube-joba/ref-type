\import thom_spaces.Thom[] \as ThomSpaces;
\import ThomSpaces.Complex[].Trivial[X := X, n := n, baseSpace := space] \as Trivial;
\import Bundles.Trivial[X := X, n := n, baseSpace := space] \as Bundle;
\import ThomSpaces.Complex[].For[X := X, F := (\fun (x: X) => Bundles.Vector n), bundle := Bundle.bundle] \as Theory;
\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as Naturals;
\definition dimension: \forall (n: N.Nat^) -> Nat.add n n = Bott.dimension n :=
  \induction (n: N.Nat^) \return Nat.add n n = Bott.dimension n \with {
    | zero: \refl(N.Nat^::zero)
    | succ: \fun (n: N.Nat^)(previous: Nat.add n n = Bott.dimension n) =>
      trans!{{N.Nat^}} _ _ _
        (congr!{{N.Nat^} {N.Nat^}} N.Nat^::succ _ _ (Naturals.addSuccLeft n n))
        (congr!{{N.Nat^} {N.Nat^}} (\fun (d: N.Nat^) => N.Nat^::succ (N.Nat^::succ d)) _ _ previous)
  };
\module With(metric: Theory.Metric);
