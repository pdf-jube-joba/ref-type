\import Relative.Negative[original := Absolute.model, degree := degree] \as Initial;
\import Relative.Negative[original := model, degree := degree] \as Target;
\import Disk.Negative[degree := degree] \as Native;
\import Relative.Equivalence[source := model, target := Disk.model].With[e := Model.equivalence].Negative[degree := degree] \as Transport;
\definition comparisonIsomorphism: Periodicity.Isomorphism[A := Relative.Negative[original := Disk.model, degree := degree].Carrier,
  B := Target.Carrier, source := Relative.Negative[original := Disk.model, degree := degree].group, target := Target.group].Data :=
  Periodicity.Isomorphism[A := Relative.Negative[original := Disk.model, degree := degree].Carrier,
    B := Target.Carrier, source := Relative.Negative[original := Disk.model, degree := degree].group, target := Target.group].Data {
    forward := Transport.forward, backward := Transport.backward,
    leftInverse := Transport.rightInverse, rightInverse := Transport.leftInverse,
    forwardAdd := Transport.additive, backwardAdd := Transport.inverseAdditive,
    forwardZero := Transport.forwardZero, backwardZero := Transport.backwardZero
  };
\definition isomorphism: Periodicity.Isomorphism[A := Initial.Carrier, B := Target.Carrier,
  source := Initial.group, target := Target.group].Data :=
  Periodicity.Isomorphism[A := Initial.Carrier, B := Relative.Negative[original := Disk.model, degree := degree].Carrier,
    source := Initial.group, target := Relative.Negative[original := Disk.model, degree := degree].group].Compose[
    C := Target.Carrier, last := Target.group, first := Native.isomorphism, second := comparisonIsomorphism].data;
