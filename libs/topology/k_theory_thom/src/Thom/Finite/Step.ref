\import \root.Thom[].Finite[X := X, baseSpace := baseSpace].SquareStep[first := first, previous := previous,
  differential := differential, consecutive := consecutive] \as Core;
\definition next: Chains.Parity[first] := Core.next;
\definition W[x: X]: \Set := Core.W x;
\definition squareZero: Chains.SquareZero Core.diagram := Core.squareZero;
\definition complex: Chains.Complex := Core.complex;
\definition forwardHead: \forall (x: X)(a: Core.A x) -> (next.forward.fiber x).apply ((next.inclusion.fiber x).apply a) =
  ((parity previous).inclusion.fiber x).apply ((differential.fiber x).apply a) := Core.forwardHead;
\module Exact;
