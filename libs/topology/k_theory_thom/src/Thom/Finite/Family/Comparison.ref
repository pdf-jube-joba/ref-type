
\import \parent.\parent.Family[term := targetTerm, differential := targetDifferential, domain := domain] \as Target;
\definition sourceParity[n: N.Nat^]: Chains.Parity[term n] := Chains.fold (term n) (data n);
\definition targetParity[n: N.Nat^]: Chains.Parity[targetTerm n] := Chains.fold (targetTerm n) (Target.data n);
\definition Result[n: N.Nat^]: \Set := \root.Thom[].Finite[X := X, baseSpace := baseSpace].Comparison[term n, targetTerm n, sourceParity n, targetParity n, isomorphism n];
\module Base;
\module Next(n: N.Nat^, previous: Result n);
\definition value: \forall (n: N.Nat^) -> Result n := \induction (n: N.Nat^) \return Result n \with {
  | zero: Base[].result
  | succ: \fun (n: N.Nat^)(previous: Result n) => Next[n := n, previous := previous].result
};
