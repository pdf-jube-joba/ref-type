
\definition result: Formula n (Labels.Index::head n) :=
  \fun (side: B.Bool^)(equation: B.Bool^::true = side) =>
    (\idelim B.Bool^::true = side \with b: B.Bool^ => \forall (law: B.Bool^::true = b)(target: Models.Bundle)(components: Components n b target)(x: X)(v: Models.Fiber (term n).ranks x) ->
      ((assemble n b target components).fiber x).apply (((at n (Labels.Index::head n) b law).fiber x).apply v) = ((components (colored n (Labels.Index::head n) b law)).fiber x).apply v \by {
      base: \fun (law: B.Bool^::true = B.Bool^::true) => headAssembly n, equality: equation
    }) equation;
