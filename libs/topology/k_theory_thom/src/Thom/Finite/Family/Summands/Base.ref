\import \root.Thom[].Finite[X := X, baseSpace := baseSpace].Empty[domain := domain] \as Empty;
\definition zeroCompare: \forall (target: Models.Bundle)(first, second: Models.Map Chains.empty target)(x: X)(v: Models.Fiber Chains.empty.ranks x) ->
  (first.fiber x).apply v = (second.fiber x).apply v :=
  \fun (target: Models.Bundle)(first, second: Models.Map Chains.empty target)(x: X)(v: Models.Fiber Chains.empty.ranks x) =>
    trans!{{Models.Fiber target.ranks x}} _ _ _
      (trans!{{Models.Fiber target.ranks x}} _ _ _ (congr!{{Models.Fiber Chains.empty.ranks x} {Models.Fiber target.ranks x}} (first.fiber x).apply _ _ (Empty.zeroUnique x v)) (first.fiber x).preservesZero)
      (sym!{{Models.Fiber target.ranks x}} _ _
        (trans!{{Models.Fiber target.ranks x}} _ _ _ (congr!{{Models.Fiber Chains.empty.ranks x} {Models.Fiber target.ranks x}} (second.fiber x).apply _ _ (Empty.zeroUnique x v)) (second.fiber x).preservesZero));
\definition result: Extensional N.Nat^::zero :=
  \induction (side: B.Bool^) \return \forall (target: Models.Bundle)(first, second: Models.Map (parity N.Nat^::zero side) target)(x: X) ->
    (\forall (s: Labels.Index N.Nat^::zero)(equation: Labels.even N.Nat^::zero s = side)(v: Models.Fiber (term (Labels.degree N.Nat^::zero s)).ranks x) ->
      (first.fiber x).apply (((at N.Nat^::zero s side equation).fiber x).apply v) = (second.fiber x).apply (((at N.Nat^::zero s side equation).fiber x).apply v)) ->
    \forall (v: Models.Fiber (parity N.Nat^::zero side).ranks x) -> (first.fiber x).apply v = (second.fiber x).apply v \with {
    | false: \fun (target: Models.Bundle)(first, second: Models.Map Chains.empty target)(x: X)(agreement: _) => zeroCompare target first second x
    | true: \fun (target: Models.Bundle)(first, second: Models.Map (folded N.Nat^::zero).even target)(x: X)(agreement: _) =>
      \parent.Initial[].compare target first second x
        (\fun (v: Models.Fiber (term N.Nat^::zero).ranks x) => agreement (Labels.Index::head N.Nat^::zero) (\refl(B.Bool^::true)) v)
        (zeroCompare target
          (Models.compose Chains.empty (folded N.Nat^::zero).even target \parent.Initial[].secondInclusion first)
          (Models.compose Chains.empty (folded N.Nat^::zero).even target \parent.Initial[].secondInclusion second) x)
  };
