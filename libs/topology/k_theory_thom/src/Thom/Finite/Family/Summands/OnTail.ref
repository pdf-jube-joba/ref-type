
\definition natural: \forall (target: Models.Bundle)(components: Components (N.Nat^::succ n) (Labels.flip (Labels.even n s)) target)(x: X)(v: Models.Fiber (term (Labels.degree n s)).ranks x) ->
  ((assemble (N.Nat^::succ n) (Labels.flip (Labels.even n s)) target components).fiber x).apply
    (((at (N.Nat^::succ n) (Labels.Index::tail n s) (Labels.flip (Labels.even n s)) (\refl(Labels.flip (Labels.even n s)))).fiber x).apply v) =
  ((components (colored (N.Nat^::succ n) (Labels.Index::tail n s) (Labels.flip (Labels.even n s)) (\refl(Labels.flip (Labels.even n s))))).fiber x).apply v :=
  \fun (target: Models.Bundle)(components: Components (N.Nat^::succ n) (Labels.flip (Labels.even n s)) target)(x: X)(v: Models.Fiber (term (Labels.degree n s)).ranks x) =>
    trans!{{Models.Fiber target.ranks x}} _ _ _
      (congr!{{Models.Fiber (parity (N.Nat^::succ n) (Labels.flip (Labels.even n s))).ranks x} {Models.Fiber target.ranks x}}
        ((assemble (N.Nat^::succ n) (Labels.flip (Labels.even n s)) target components).fiber x).apply _ _
        (tailFormula n s (Labels.even n s) (\refl(Labels.even n s)) x v))
      (trans!{{Models.Fiber target.ranks x}} _ _ _
        (tailAssembly n (Labels.even n s) target components x (((at n s (Labels.even n s) (\refl(Labels.even n s))).fiber x).apply v))
        (previous (Labels.even n s) (\refl(Labels.even n s)) target (tailComponents n (Labels.even n s) target components) x v));
\definition result: Formula (N.Nat^::succ n) (Labels.Index::tail n s) :=
  \fun (side: B.Bool^)(equation: Labels.flip (Labels.even n s) = side) =>
    (\idelim Labels.flip (Labels.even n s) = side \with b: B.Bool^ => \forall (law: Labels.flip (Labels.even n s) = b)(target: Models.Bundle)(components: Components (N.Nat^::succ n) b target)(x: X)(v: Models.Fiber (term (Labels.degree n s)).ranks x) ->
      ((assemble (N.Nat^::succ n) b target components).fiber x).apply (((at (N.Nat^::succ n) (Labels.Index::tail n s) b law).fiber x).apply v) =
      ((components (colored (N.Nat^::succ n) (Labels.Index::tail n s) b law)).fiber x).apply v \by {
      base: \fun (law: Labels.flip (Labels.even n s) = Labels.flip (Labels.even n s)) => natural, equality: equation
    }) equation;
