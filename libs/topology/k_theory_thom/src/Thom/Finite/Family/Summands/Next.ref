\import \parent.Sums[n := n] \as Sum;
\definition result: Extensional (N.Nat^::succ n) :=
  \induction (side: B.Bool^) \return \forall (target: Models.Bundle)(first, second: Models.Map (parity (N.Nat^::succ n) side) target)(x: X) ->
    (\forall (s: Labels.Index (N.Nat^::succ n))(equation: Labels.even (N.Nat^::succ n) s = side)(v: Models.Fiber (term (Labels.degree (N.Nat^::succ n) s)).ranks x) ->
      (first.fiber x).apply (((at (N.Nat^::succ n) s side equation).fiber x).apply v) = (second.fiber x).apply (((at (N.Nat^::succ n) s side equation).fiber x).apply v)) ->
    \forall (v: Models.Fiber (parity (N.Nat^::succ n) side).ranks x) -> (first.fiber x).apply v = (second.fiber x).apply v \with {
    | false: \fun (target: Models.Bundle)(first, second: Models.Map (folded n).even target)(x: X)(agreement: _) =>
      previous B.Bool^::true target first second x
        (\fun (s: Labels.Index n)(equation: Labels.even n s = B.Bool^::true)(v: Models.Fiber (term (Labels.degree n s)).ranks x) =>
          trans!{{Models.Fiber target.ranks x}} _ _ _
            (congr!{{Models.Fiber (folded n).even.ranks x} {Models.Fiber target.ranks x}} (first.fiber x).apply _ _
              (sym!{{Models.Fiber (folded n).even.ranks x}} _ _ (tailFormula n s B.Bool^::true equation x v)))
            (trans!{{Models.Fiber target.ranks x}} _ _ _
              (agreement (Labels.Index::tail n s) (congr!{{B.Bool^} {B.Bool^}} Labels.flip _ _ equation) v)
              (congr!{{Models.Fiber (folded n).even.ranks x} {Models.Fiber target.ranks x}} (second.fiber x).apply _ _ (tailFormula n s B.Bool^::true equation x v))))
    | true: \fun (target: Models.Bundle)(first, second: Models.Map (folded (N.Nat^::succ n)).even target)(x: X)(agreement: _) =>
      Sum.compare target first second x
        (\fun (v: Models.Fiber (term (N.Nat^::succ n)).ranks x) => agreement (Labels.Index::head (N.Nat^::succ n)) (\refl(B.Bool^::true)) v)
        (previous B.Bool^::false target
          (Models.compose (folded n).odd (folded (N.Nat^::succ n)).even target Sum.secondInclusion first)
          (Models.compose (folded n).odd (folded (N.Nat^::succ n)).even target Sum.secondInclusion second) x
          (\fun (s: Labels.Index n)(equation: Labels.even n s = B.Bool^::false)(v: Models.Fiber (term (Labels.degree n s)).ranks x) =>
            trans!{{Models.Fiber target.ranks x}} _ _ _
              (congr!{{Models.Fiber (folded (N.Nat^::succ n)).even.ranks x} {Models.Fiber target.ranks x}} (first.fiber x).apply _ _
                (sym!{{Models.Fiber (folded (N.Nat^::succ n)).even.ranks x}} _ _ (tailFormula n s B.Bool^::false equation x v)))
              (trans!{{Models.Fiber target.ranks x}} _ _ _
                (agreement (Labels.Index::tail n s) (congr!{{B.Bool^} {B.Bool^}} Labels.flip _ _ equation) v)
                (congr!{{Models.Fiber (folded (N.Nat^::succ n)).even.ranks x} {Models.Fiber target.ranks x}} (second.fiber x).apply _ _ (tailFormula n s B.Bool^::false equation x v)))))
  };
