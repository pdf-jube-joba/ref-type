
\definition commutes: \forall (y: Y)(v: Models.Fiber (term (N.Nat^::succ n)).ranks (f y)) ->
  ((pulledDifferential n).fiber y).apply (((headIso (N.Nat^::succ n)).forward.fiber y).apply v) =
  ((headIso n).forward.fiber y).apply (((differential n).fiber (f y)).apply v) :=
  \fun (y: Y)(v: Models.Fiber (term (N.Nat^::succ n)).ranks (f y)) => \refl(((differential n).fiber (f y)).apply v);
\import Rebase.Step[first := term (N.Nat^::succ n), second := term n,
  firstTarget := pulledTerm (N.Nat^::succ n), secondTarget := pulledTerm n,
  differential := differential n, targetDifferential := pulledDifferential n,
  source := sourceParity n, target := targetParity n, headIso := headIso (N.Nat^::succ n), secondIso := headIso n,
  tail := previous, commutes := commutes] \as Build;
\definition result: Result (N.Nat^::succ n) := Build.result;
