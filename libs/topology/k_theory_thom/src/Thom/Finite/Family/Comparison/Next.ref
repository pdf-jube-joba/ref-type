\import \root.Thom[].Finite[X := X, baseSpace := baseSpace].ComparisonStep[
  first := term (N.Nat^::succ n), second := term n,
  firstTarget := targetTerm (N.Nat^::succ n), secondTarget := targetTerm n,
  differential := differential n, targetDifferential := targetDifferential n,
  source := sourceParity n, target := targetParity n,
  headIso := isomorphism (N.Nat^::succ n), secondIso := isomorphism n,
  tail := previous, commutes := commutes n] \as Build;
\definition result: Result (N.Nat^::succ n) := Build.result;
