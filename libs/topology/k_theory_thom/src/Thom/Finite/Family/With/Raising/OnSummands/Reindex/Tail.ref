\definition atSide: \forall (side: B.Bool^)(color: Labels.even n s = side)(x: X)(v: Models.Fiber (term (N.Nat^::succ (Labels.degree n s))).ranks x) ->
  ((nextAt (N.Nat^::succ n) (Labels.Index::tail n s) (Labels.flip side) (congr!{{B.Bool^} {B.Bool^}} Labels.flip _ _ color)).fiber x).apply v =
  ((map (N.Nat^::succ n) (Labels.Index::tail n s) (Labels.flip side) (congr!{{B.Bool^} {B.Bool^}} Labels.flip _ _ color)).fiber x).apply v :=
  \fun (side: B.Bool^)(color: Labels.even n s = side)(x: X)(v: Models.Fiber (term (N.Nat^::succ (Labels.degree n s))).ranks x) =>
    trans!{{Models.Fiber (Summands.parity (N.Nat^::succ (N.Nat^::succ n)) (Labels.flip side)).ranks x}} _ _ _ (nextTail n s side color x v)
      (trans!{{Models.Fiber (Summands.parity (N.Nat^::succ (N.Nat^::succ n)) (Labels.flip side)).ranks x}} _ _ _
        (congr!{{Models.Fiber (Summands.parity (N.Nat^::succ n) side).ranks x} {Models.Fiber (Summands.parity (N.Nat^::succ (N.Nat^::succ n)) (Labels.flip side)).ranks x}}
          ((Summands.lift (N.Nat^::succ n) side).fiber x).apply _ _ (previous side color x v))
        (sym!{{Models.Fiber (Summands.parity (N.Nat^::succ (N.Nat^::succ n)) (Labels.flip side)).ranks x}} _ _ (tail n s side color x v)));
\definition result: Valid (N.Nat^::succ n) (Labels.Index::tail n s) :=
  \fun (side: B.Bool^)(color: Labels.flip (Labels.even n s) = side) =>
    (\idelim Labels.flip (Labels.even n s) = side \with b: B.Bool^ =>
      \forall (law: Labels.flip (Labels.even n s) = b)(x: X)(v: Models.Fiber (term (N.Nat^::succ (Labels.degree n s))).ranks x) ->
        ((nextAt (N.Nat^::succ n) (Labels.Index::tail n s) b law).fiber x).apply v = ((map (N.Nat^::succ n) (Labels.Index::tail n s) b law).fiber x).apply v \by {
          base: \fun (law: Labels.flip (Labels.even n s) = Labels.flip (Labels.even n s)) => atSide (Labels.even n s) (\refl(Labels.even n s)),
          equality: color
        }) color;
