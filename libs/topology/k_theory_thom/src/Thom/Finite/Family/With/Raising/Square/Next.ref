\import \parent.\parent.Step[n := n, previous := values n] \as Build;
\import Models.Sum[first := term (N.Nat^::succ n), second := (folded n).odd] \as Sum;
\definition even: \forall (x: X)(v: Models.Fiber (folded (N.Nat^::succ n)).even.ranks x) ->
  ((h (N.Nat^::succ n)).fiber x).apply (((k (N.Nat^::succ n)).fiber x).apply v) = ((Models.bundle (folded (N.Nat^::succ n)).even).space x).zero :=
  \fun (x: X)(v: Models.Fiber (folded (N.Nat^::succ n)).even.ranks x) => trans!{{Models.Fiber (folded (N.Nat^::succ n)).even.ranks x}} _ _ _
    (congr!{{Models.Fiber (term (N.Nat^::succ n)).ranks x} {Models.Fiber (folded n).odd.ranks x} {Models.Fiber (folded (N.Nat^::succ n)).even.ranks x}}
      (Build.join x) _ _ _ _ (previous.consecutive x (Build.rest x v)) (previous.odd x (Build.rest x v)))
    (Sum.isomorphism.forward.fiber x).preservesZero;
\definition odd: \forall (x: X)(v: Models.Fiber (folded (N.Nat^::succ n)).odd.ranks x) ->
  ((k (N.Nat^::succ n)).fiber x).apply (((h (N.Nat^::succ n)).fiber x).apply v) = ((Models.bundle (folded (N.Nat^::succ n)).odd).space x).zero :=
  \fun (x: X)(v: Models.Fiber (folded (N.Nat^::succ n)).odd.ranks x) => trans!{{Models.Fiber (folded n).even.ranks x}} _ _ _
    (congr!{{Models.Fiber (folded n).odd.ranks x} {Models.Fiber (folded n).even.ranks x}} ((h n).fiber x).apply _ _ (Build.restH x v))
    (previous.even x v);
\definition consecutive: \forall (x: X)(v: Models.Fiber (folded (N.Nat^::succ n)).odd.ranks x) ->
  ((raising (N.Nat^::succ n)).fiber x).apply (((projection (N.Nat^::succ n)).fiber x).apply (((h (N.Nat^::succ n)).fiber x).apply v)) = ((Models.bundle (term (N.Nat^::succ (N.Nat^::succ n)))).space x).zero :=
  \fun (x: X)(v: Models.Fiber (folded (N.Nat^::succ n)).odd.ranks x) => trans!{{Models.Fiber (term (N.Nat^::succ (N.Nat^::succ n))).ranks x}} _ _ _
    (congr!{{Models.Fiber (term (N.Nat^::succ n)).ranks x} {Models.Fiber (term (N.Nat^::succ (N.Nat^::succ n))).ranks x}}
      ((raising (N.Nat^::succ n)).fiber x).apply _ _ (Build.headH x v))
    (raisingSquare n x (((projection n).fiber x).apply v));
\definition result: Valid[N.Nat^::succ n] := Valid[N.Nat^::succ n] { even := even, odd := odd, consecutive := consecutive };
