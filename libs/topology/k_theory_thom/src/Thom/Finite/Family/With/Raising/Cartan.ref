\definition Even[n: N.Nat^][x: X][v: Models.Fiber (folded n).even.ranks x]: \Prop :=
  ((Models.bundle (folded n).even).space x).add
    (((Models.bundle (folded n).even).space x).add (((folded n).backward.fiber x).apply (((k n).fiber x).apply v)) (((h n).fiber x).apply (((folded n).forward.fiber x).apply v)))
    (((correction n).fiber x).apply v) = ((Models.bundle (folded n).even).space x).smul (coefficient x) v;
\definition Odd[n: N.Nat^][x: X][v: Models.Fiber (folded n).odd.ranks x]: \Prop :=
  ((Models.bundle (folded n).odd).space x).add (((folded n).forward.fiber x).apply (((h n).fiber x).apply v)) (((k n).fiber x).apply (((folded n).backward.fiber x).apply v)) =
    ((Models.bundle (folded n).odd).space x).smul (coefficient x) v;
\structure State[n: N.Nat^]: \Prop := { even: \forall (x: X)(v: Models.Fiber (folded n).even.ranks x) -> Even n x v, odd: \forall (x: X)(v: Models.Fiber (folded n).odd.ranks x) -> Odd n x v };
\module Base;
\module Next(n: N.Nat^, previous: State[n]);
\definition valid: \forall (n: N.Nat^) -> State[n] := \induction (n: N.Nat^) \return State[n] \with {
  | zero: Base[].result
  | succ: \fun (n: N.Nat^)(previous: State[n]) => Next[n := n, previous := previous].result
};
\module At(n: N.Nat^, zeroAbove: \forall (x: X)(v: Models.Fiber (term n).ranks x) -> v = ((Models.bundle (term n)).space x).zero);
