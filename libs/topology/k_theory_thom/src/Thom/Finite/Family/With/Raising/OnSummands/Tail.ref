\import \parent.Step[n := n] \as Lower;
\import \parent.Step[n := N.Nat^::succ n] \as Upper;
\module False(color: Labels.even n s = B.Bool^::false);
\module True(color: Labels.even n s = B.Bool^::true);
\definition atSide: \forall (side: B.Bool^)(color: Labels.even n s = side) ->
  Action (N.Nat^::succ n) (Labels.Index::tail n s) (Labels.flip side) (congr!{{B.Bool^} {B.Bool^}} Labels.flip _ _ color) :=
  \induction (side: B.Bool^) \return \forall (color: Labels.even n s = side) ->
    Action (N.Nat^::succ n) (Labels.Index::tail n s) (Labels.flip side) (congr!{{B.Bool^} {B.Bool^}} Labels.flip _ _ color) \with {
      | false: \fun (color: Labels.even n s = B.Bool^::false) => False[color := color].result
      | true: \fun (color: Labels.even n s = B.Bool^::true) => True[color := color].result
    };
\definition result: Statement (N.Nat^::succ n) (Labels.Index::tail n s) :=
  \fun (side: B.Bool^)(color: Labels.flip (Labels.even n s) = side) =>
    (\idelim Labels.flip (Labels.even n s) = side \with b: B.Bool^ =>
      \forall (law: Labels.flip (Labels.even n s) = b) -> Action (N.Nat^::succ n) (Labels.Index::tail n s) b law \by {
        base: \fun (law: Labels.flip (Labels.even n s) = Labels.flip (Labels.even n s)) => atSide (Labels.even n s) (\refl(Labels.even n s)),
        equality: color
      }) color;
