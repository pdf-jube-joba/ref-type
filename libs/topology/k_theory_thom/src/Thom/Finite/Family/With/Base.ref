\import \root.Thom[].Finite[X := X, baseSpace := baseSpace].Empty[domain := domain] \as Empty;
\definition consecutive: \forall (x: X)(a: Models.Fiber (term N.Nat^::zero).ranks x) ->
  ((parity Empty.complex).forward.fiber x).apply (((parity Empty.complex).inclusion.fiber x).apply
    (((Models.zero (term N.Nat^::zero) Chains.empty).fiber x).apply a)) = ((Models.bundle (parity Empty.complex).odd).space x).zero :=
  \fun (x: X)(a: Models.Fiber (term N.Nat^::zero).ranks x) => \refl(((Models.bundle Chains.empty).space x).zero);
\definition exactHead: \forall (x: X) -> \In[X] domain x -> \forall (a: Head Empty.complex x) ->
  ((parity Empty.complex).forward.fiber x).apply (((parity Empty.complex).inclusion.fiber x).apply a) = ((Models.bundle (parity Empty.complex).odd).space x).zero ->
  \exists (v: Models.Fiber (term N.Nat^::zero).ranks x \where ((Models.zero (term N.Nat^::zero) Chains.empty).fiber x).apply v = a) :=
  \fun (x: X)(member: \In[X] domain x)(a: Head Empty.complex x)(closed: _) =>
    Logic.existsIntro[Models.Fiber (term N.Nat^::zero).ranks x, { v: Models.Fiber (term N.Nat^::zero).ranks x \where
      ((Models.zero (term N.Nat^::zero) Chains.empty).fiber x).apply v = a }]
      ((Models.bundle (term N.Nat^::zero)).space x).zero (sym!{{Head Empty.complex x}} _ _ (Empty.zeroUnique x a));
\import \root.Thom[].Finite[X := X, baseSpace := baseSpace].Step[first := term N.Nat^::zero,
  previous := Empty.complex, domain := domain, tail := Empty.result,
  differential := Models.zero (term N.Nat^::zero) Chains.empty, consecutive := consecutive, exactHead := exactHead] \as Build;
\definition result: State[N.Nat^::zero] := State[N.Nat^::zero] {
  partial := Build.Exact[].result,
  forwardCriterion := \fun (x: X)(a: Models.Fiber (term N.Nat^::zero).ranks x)(closed: _) => Logic.True::intro,
  backwardCriterion := \fun (x: X)(a: Models.Fiber (term N.Nat^::zero).ranks x)(closed: _) => Build.forwardHead x a
};
