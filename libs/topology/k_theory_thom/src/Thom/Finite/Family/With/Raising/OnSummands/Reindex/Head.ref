\definition direct: \forall (law: B.Bool^::true = B.Bool^::true)(x: X)(v: Models.Fiber (term (N.Nat^::succ n)).ranks x) ->
  ((nextAt n (Labels.Index::head n) B.Bool^::true law).fiber x).apply v = ((map n (Labels.Index::head n) B.Bool^::true law).fiber x).apply v :=
  \fun (law: B.Bool^::true = B.Bool^::true)(x: X)(v: Models.Fiber (term (N.Nat^::succ n)).ranks x) =>
    trans!{{Models.Fiber (folded (N.Nat^::succ n)).even.ranks x}} _ _ _
      (Summands.selectSame (N.Nat^::succ n) B.Bool^::true x ((((folded (N.Nat^::succ n)).inclusion).fiber x).apply v))
      (sym!{{Models.Fiber (folded (N.Nat^::succ n)).even.ranks x}} _ _
        (trans!{{Models.Fiber (folded (N.Nat^::succ n)).even.ranks x}} _ _ _
          (Summands.selectSame (N.Nat^::succ n) B.Bool^::true x ((((folded (N.Nat^::succ n)).inclusion).fiber x).apply
            (((cast (N.Nat^::succ n) (N.Nat^::succ n) (sym!{{N.Nat^}} _ _ (degree n (Labels.Index::head n)))).fiber x).apply v)))
          (congr!{{Models.Fiber (term (N.Nat^::succ n)).ranks x} {Models.Fiber (folded (N.Nat^::succ n)).even.ranks x}}
            (((folded (N.Nat^::succ n)).inclusion).fiber x).apply _ _
            (castValue (N.Nat^::succ n) (sym!{{N.Nat^}} _ _ (degree n (Labels.Index::head n))) x v))));
\definition result: Valid n (Labels.Index::head n) := \fun (side: B.Bool^)(color: B.Bool^::true = side) =>
  (\idelim B.Bool^::true = side \with b: B.Bool^ => \forall (law: B.Bool^::true = b)(x: X)(v: Models.Fiber (term (N.Nat^::succ n)).ranks x) ->
    ((nextAt n (Labels.Index::head n) b law).fiber x).apply v = ((map n (Labels.Index::head n) b law).fiber x).apply v \by {
      base: direct, equality: color
    }) color;
