\import \root.Thom[].Finite[X := X, baseSpace := baseSpace].Empty[domain := domain] \as Empty;
\definition closed: \forall (x: X)(a: Models.Fiber (term N.Nat^::zero).ranks x) ->
  ((parity Empty.complex).forward.fiber x).apply (((parity Empty.complex).inclusion.fiber x).apply
    (((Models.zero (term N.Nat^::zero) Chains.empty).fiber x).apply a)) = ((Models.bundle (parity Empty.complex).odd).space x).zero :=
  \fun (x: X)(a: Models.Fiber (term N.Nat^::zero).ranks x) => \refl(((Models.bundle Chains.empty).space x).zero);
\import \root.Thom[].Finite[X := X, baseSpace := baseSpace].SquareStep[first := term N.Nat^::zero,
  previous := Empty.complex, differential := Models.zero (term N.Nat^::zero) Chains.empty, consecutive := closed] \as Build;
\definition result: Valid[N.Nat^::zero] := Valid[N.Nat^::zero] {
  square := Build.squareZero,
  consecutive := \fun (x: X)(a: Models.Fiber (term (N.Nat^::succ N.Nat^::zero)).ranks x) => Build.forwardHead x (((differential N.Nat^::zero).fiber x).apply a)
};
