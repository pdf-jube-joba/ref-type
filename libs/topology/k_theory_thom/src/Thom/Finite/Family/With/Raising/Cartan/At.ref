\definition defectZero: \forall (x: X)(v: Models.Fiber (folded n).even.ranks x) -> ((correction n).fiber x).apply v = ((Models.bundle (folded n).even).space x).zero :=
  \fun (x: X)(v: Models.Fiber (folded n).even.ranks x) => trans!{{Models.Fiber (folded n).even.ranks x}} _ _ _
    (congr!{{Models.Fiber (term n).ranks x} {Models.Fiber (folded n).even.ranks x}} ((correctHead n).fiber x).apply _ _
      (zeroAbove x (((projection n).fiber x).apply v)))
    ((correctHead n).fiber x).preservesZero;
\definition even: \forall (x: X)(v: Models.Fiber (folded n).even.ranks x) ->
  ((Models.bundle (folded n).even).space x).add (((folded n).backward.fiber x).apply (((k n).fiber x).apply v)) (((h n).fiber x).apply (((folded n).forward.fiber x).apply v)) =
    ((Models.bundle (folded n).even).space x).smul (coefficient x) v :=
  \fun (x: X)(v: Models.Fiber (folded n).even.ranks x) => trans!{{Models.Fiber (folded n).even.ranks x}} _ _ _
    (sym!{{Models.Fiber (folded n).even.ranks x}} _ _ (Spaces.Laws[V := Models.Fiber (folded n).even.ranks x, space := (Models.bundle (folded n).even).space x].zeroRight _))
    (trans!{{Models.Fiber (folded n).even.ranks x}} _ _ _
      (congr!{{Models.Fiber (folded n).even.ranks x} {Models.Fiber (folded n).even.ranks x}}
        (((Models.bundle (folded n).even).space x).add _) _ _ (sym!{{Models.Fiber (folded n).even.ranks x}} _ _ (defectZero x v)))
      ((valid n).even x v));
\definition odd: \forall (x: X)(v: Models.Fiber (folded n).odd.ranks x) -> Odd n x v := (valid n).odd;
