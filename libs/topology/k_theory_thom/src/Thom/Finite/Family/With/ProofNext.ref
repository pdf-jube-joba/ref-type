\definition oldComplex: Chains.Complex := asComplex n previous.square;
\import \root.Thom[].Finite[X := X, baseSpace := baseSpace].SquareStep[first := term (N.Nat^::succ n),
  previous := oldComplex, differential := differential n, consecutive := previous.consecutive] \as Build;
\definition result: Valid[N.Nat^::succ n] := Valid[N.Nat^::succ n] {
  square := Build.squareZero,
  consecutive := \fun (x: X)(a: Models.Fiber (term (N.Nat^::succ (N.Nat^::succ n))).ranks x) =>
    trans!{{Models.Fiber (parity oldComplex).even.ranks x}} _ _ _
      (Build.forwardHead x (((differential (N.Nat^::succ n)).fiber x).apply a))
      (trans!{{Models.Fiber (parity oldComplex).even.ranks x}} _ _ _
        (congr!{{Models.Fiber (term n).ranks x} {Models.Fiber (parity oldComplex).even.ranks x}} ((parity oldComplex).inclusion.fiber x).apply _ _ (squareZero n x a))
        ((parity oldComplex).inclusion.fiber x).preservesZero)
};
