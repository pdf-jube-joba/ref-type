\definition value: Chains.Complex := complex n;
\definition headExact: \forall (x: X) -> \In[X] domain x -> \forall (a: Head value x) ->
  ((parity value).forward.fiber x).apply (((parity value).inclusion.fiber x).apply a) = ((Models.bundle (parity value).odd).space x).zero ->
  a = ((Models.bundle value.head).space x).zero :=
  \fun (x: X)(member: \In[X] domain x)(a: Head value x)(closed: _) => zeroAbove x a;
\import \root.Thom[].Finite[X := X, baseSpace := baseSpace].Finish[complex := value, domain := domain,
  data := (state n).partial, headExact := headExact] \as Finish;
\definition exactAt: \forall (x: X) -> \In[X] domain x -> Chains.Of[complex := value].ExactAt x := Finish.exact;
