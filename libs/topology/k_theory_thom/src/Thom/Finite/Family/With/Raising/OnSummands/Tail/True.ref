\definition source[x: X][v: Models.Fiber (term (Labels.degree n s)).ranks x]: Models.Fiber (folded (N.Nat^::succ n)).odd.ranks x :=
  ((Summands.at (N.Nat^::succ n) (Labels.Index::tail n s) B.Bool^::false (congr!{{B.Bool^} {B.Bool^}} Labels.flip _ _ color)).fiber x).apply v;
\definition result: Action (N.Nat^::succ n) (Labels.Index::tail n s) B.Bool^::false (congr!{{B.Bool^} {B.Bool^}} Labels.flip _ _ color) :=
  \fun (x: X)(v: Models.Fiber (term (Labels.degree n s)).ranks x) =>
    trans!{{Models.Fiber (folded (N.Nat^::succ (N.Nat^::succ n))).odd.ranks x}} _ _ _
      (congr!{{Models.Fiber (folded (N.Nat^::succ (N.Nat^::succ n))).even.ranks x} {Models.Fiber (folded (N.Nat^::succ (N.Nat^::succ n))).odd.ranks x}}
        ((k (N.Nat^::succ (N.Nat^::succ n))).fiber x).apply _ _
        (Summands.tailFormula (N.Nat^::succ n) (Labels.Index::tail n s) B.Bool^::false (congr!{{B.Bool^} {B.Bool^}} Labels.flip _ _ color) x v))
      (trans!{{Models.Fiber (folded (N.Nat^::succ (N.Nat^::succ n))).odd.ranks x}} _ _ _
        (Upper.tailOdd x (source x v))
        (trans!{{Models.Fiber (folded (N.Nat^::succ (N.Nat^::succ n))).odd.ranks x}} _ _ _
          (previous B.Bool^::true color x v)
          (sym!{{Models.Fiber (folded (N.Nat^::succ (N.Nat^::succ n))).odd.ranks x}} _ _
            (nextTail n s B.Bool^::true color x (((raising (Labels.degree n s)).fiber x).apply v)))));
