\import \parent.Step[n := n] \as Step;
\definition result: Statement n (Labels.Index::head n) := \fun (side: B.Bool^)(color: B.Bool^::true = side) =>
  (\idelim B.Bool^::true = side \with b: B.Bool^ => \forall (law: B.Bool^::true = b) -> Action n (Labels.Index::head n) b law \by {
    base: \fun (law: B.Bool^::true = B.Bool^::true) => Step.headRaised,
    equality: color
  }) color;
