\import topology.Topology[Carrier := X] \as Base;
\definition f0f1: f0.baseSpace = f1.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameF0) sameF1;
\definition f0Aux: f0.baseSpace = auxiliary.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameF0) sameAuxiliary;
\definition f1Aux: f1.baseSpace = auxiliary.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameF1) sameAuxiliary;
\import Operations.DirectSum[X := X, F := F0, G := H, left := f0, right := auxiliary] \as StableEven;
\import Operations.DirectSum[X := X, F := F1, G := H, left := f1, right := auxiliary] \as StableOdd;
\definition stableEven: Bundles.Family[X := X, F := StableEven.Fiber].Bundle := StableEven.bundle f0Aux;
\definition stableOdd: Bundles.Family[X := X, F := StableOdd.Fiber].Bundle := StableOdd.bundle f1Aux;
\import \root.Thom[].ComplexProductParity[X := X, F0 := E0, F1 := E1, G0 := StableEven.Fiber, G1 := StableOdd.Fiber,
  e0 := e0, e1 := e1, f0 := stableEven, f1 := stableOdd, sameE1 := sameE1, sameF0 := sameF0, sameF1 := sameF1] \as Source;
\import Source.Grading[] \as Grading;
\import \root.Thom[].ComplexProductParity[X := X, F0 := E0, F1 := E1, G0 := F0, G1 := F1,
  e0 := e0, e1 := e1, f0 := f0, f1 := f1, sameE1 := sameE1, sameF0 := sameF0, sameF1 := sameF1] \as Original;
\import \root.Thom[].ComplexProductParity[X := X, F0 := E0, F1 := E1, G0 := H, G1 := H,
  e0 := e0, e1 := e1, f0 := auxiliary, f1 := auxiliary, sameE1 := sameE1, sameF0 := sameAuxiliary, sameF1 := sameAuxiliary] \as Auxiliary;
\import \root.Thom[].TensorParityRightRegroup[X := X, E0 := E0, E1 := E1, F0 := F0, F1 := F1, H0 := H, H1 := H,
  e0 := e0, e1 := e1, f0 := f0, f1 := f1, h0 := auxiliary, h1 := auxiliary,
  sameE1 := sameE1, sameF0 := sameF0, sameF1 := sameF1, sameH0 := sameAuxiliary, sameH1 := sameAuxiliary] \as Sectors;
\import Bundles.Morphisms[X := X, Y := X, F := F0, G := F1, source := f0, target := f1, f := (\fun (x: X) => x)] \as Forward;
\import Bundles.Morphisms[X := X, Y := X, F := F1, G := F0, source := f1, target := f0, f := (\fun (x: X) => x)] \as Backward;
\import Bundles.Morphisms[X := X, Y := X, F := Source.LeftFiber, G := Source.LeftFiber,
  source := Source.leftBundle, target := Source.leftBundle, f := (\fun (x: X) => x)] \as Partner;
\module With(d: Forward.Map, e: Backward.Map, radius: X -> C.Complex,
  continuous: topology.Continuity[A := X, B := C.Complex].Continuous e0.baseSpace Scalars.scalar.topological.space radius,
  partner: Partner.Map);
