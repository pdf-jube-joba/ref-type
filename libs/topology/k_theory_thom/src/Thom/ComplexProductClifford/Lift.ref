\definition pure[v: V][w: W]: Tensor.Carrier := Tensor.tensor (first.apply v) (second.apply w);
\definition bilinear: Tensor.BilinearLaws[Tensor.Carrier, Tensor.space, pure] := Tensor.BilinearLaws[Tensor.Carrier, Tensor.space, pure] {
  addLeft := \fun (v, u: V)(w: W) => trans!{{Tensor.Carrier}} _ _ _
    (congr!{V {Tensor.Carrier}} (\fun (z: V) => Tensor.tensor z (second.apply w)) _ _ (first.preservesAdd v u))
    (Tensor.bilinear.addLeft (first.apply v) (first.apply u) (second.apply w)),
  addRight := \fun (v: V)(w, z: W) => trans!{{Tensor.Carrier}} _ _ _
    (congr!{W {Tensor.Carrier}} (Tensor.tensor (first.apply v)) _ _ (second.preservesAdd w z))
    (Tensor.bilinear.addRight (first.apply v) (second.apply w) (second.apply z)),
  scaleLeft := \fun (a: C.Complex)(v: V)(w: W) => trans!{{Tensor.Carrier}} _ _ _
    (congr!{V {Tensor.Carrier}} (\fun (z: V) => Tensor.tensor z (second.apply w)) _ _ (first.preservesScale a v))
    (Tensor.bilinear.scaleLeft a (first.apply v) (second.apply w)),
  scaleRight := \fun (a: C.Complex)(v: V)(w: W) => trans!{{Tensor.Carrier}} _ _ _
    (congr!{W {Tensor.Carrier}} (Tensor.tensor (first.apply v)) _ _ (second.preservesScale a w))
    (Tensor.bilinear.scaleRight a (first.apply v) (second.apply w))
};
\import Tensor.Universal[U := Tensor.Carrier, target := Tensor.space] \as Universal;
\definition map: Maps.Map := Universal.map pure bilinear;
\definition onPure: \forall (v: V)(w: W) -> map.apply (Tensor.tensor v w) = pure v w := Universal.onTensor pure bilinear;
