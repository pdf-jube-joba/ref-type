\definition inverse: Maps.Map := MapOperations.scale (Scalar.inv (Scalar.add c.a c.b)) operator;
\definition leftInverse: \forall (t: Tensor.Carrier) -> inverse.apply (operator.apply t) = t :=
  \fun (t: Tensor.Carrier) => trans!{{Tensor.Carrier}} _ _ _
    (congr!{{Tensor.Carrier} {Tensor.Carrier}} (Tensor.scale (Scalar.inv (Scalar.add c.a c.b))) _ _ (square t))
    (trans!{{Tensor.Carrier}} _ _ _
      (sym!{{Tensor.Carrier}} _ _ (Tensor.space.scalarAssoc (Scalar.inv (Scalar.add c.a c.b)) (Scalar.add c.a c.b) t))
      (trans!{{Tensor.Carrier}} _ _ _
        (congr!{{C.Complex} {Tensor.Carrier}} (\fun (a: C.Complex) => Tensor.scale a t) _ _ (Scalars.inverseNonzero (Scalar.add c.a c.b) nonzero)) (Tensor.space.scalarOne t)));
\definition rightInverse: \forall (t: Tensor.Carrier) -> operator.apply (inverse.apply t) = t :=
  \fun (t: Tensor.Carrier) => trans!{{Tensor.Carrier}} _ _ _
    (operator.preservesScale (Scalar.inv (Scalar.add c.a c.b)) (operator.apply t)) (leftInverse t);
\definition isomorphism: Spaces.Isomorphism[V := Tensor.Carrier, W := Tensor.Carrier, source := Tensor.space, target := Tensor.space].Isomorphism :=
  Spaces.Isomorphism[V := Tensor.Carrier, W := Tensor.Carrier, source := Tensor.space, target := Tensor.space].Isomorphism {
    forward := operator, backward := inverse, leftInverse := leftInverse, rightInverse := rightInverse
  };
