\import \parent.\parent.\parent.Restricted[nonzero := nonzero] \as Restricted;
\import Spaces.Isomorphism[V := Positive.Carrier, W := Negative.Carrier, source := Positive.induced, target := Negative.induced].Composition[U := U, domain := even] \as FirstComposition;
\definition start: Spaces.Isomorphism[V := U, W := Negative.Carrier, source := even, target := Negative.induced].Isomorphism :=
  FirstComposition.compose Restricted.isomorphism evenIsomorphism;
\import Spaces.Isomorphism[V := T, W := Negative.Carrier, source := odd, target := Negative.induced] \as Odd;
\import Spaces.Isomorphism[V := Negative.Carrier, W := T, source := Negative.induced, target := odd].Composition[U := U, domain := even] \as LastComposition;
\definition isomorphism: Spaces.Isomorphism[V := U, W := T, source := even, target := odd].Isomorphism :=
  LastComposition.compose (Odd.inverse oddIsomorphism) start;
\definition forwardFormula[v: U]: isomorphism.forward.apply v = projectOdd.apply (operator.apply (embedEven.apply v)) := \refl(isomorphism.forward.apply v);
\definition backwardFormula[v: T]: isomorphism.backward.apply v = projectEven.apply (Tensor.scale (Scalar.inv (Scalar.add c.a c.b)) (operator.apply (embedOdd.apply v))) := \refl(isomorphism.backward.apply v);
