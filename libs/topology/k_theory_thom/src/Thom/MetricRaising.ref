\import \root.Thom[].Koszul[X := X, F := F, bundle := bundle] \as Koszul;
\import Koszul.Coordinates[].With[selection := selection] \as Coordinates;
\import \root.Thom[].MetricKoszul[X := X, F := F, bundle := bundle, compact := compact, hausdorff := hausdorff].With[metric := metric] \as Metric;
\definition Total: \Set := Koszul.Total;
\import Operations.Models[X := Total, baseSpace := bundle.totalSpace] \as Models;
\definition model[k: N.Nat^]: Models.Bundle := Coordinates.model k;
\definition Vector[k: N.Nat^][p: Total]: \Set := Coordinates.Vector k p;
\definition differential[k: N.Nat^]: Models.Map (model (N.Nat^::succ k)) (model k) := Coordinates.differential k;
\definition coefficient[p: Total]: C.Complex := Metric.diagonal p;
\module Degree(k: N.Nat^);
\definition raising[k: N.Nat^]: Models.Map (model k) (model (N.Nat^::succ k)) := Degree[k := k].map;
\module At(p: Total);
