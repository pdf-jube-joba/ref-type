\import Spaces.Multilinear[V := Operations.Vector n, space := Operations.coordinates n].Alternating[] \as CoordinateForms;
\import CoordinateForms.Precomposition[W := V, target := space] \as IntoCoordinates;
\import CoordinateForms.Dimension[n := n, b := Spaces.FiniteCoordinates[n := n].basis].Above[k := k] \as Dimension;
\import Forms.At[k := k] \as At;
\definition vanishes: \forall (omega: Forms.Form k) -> Naturals.Lt n k -> omega = At.origin :=
  \fun (omega: Forms.Form k)(large: Naturals.Lt n k) => At.ext omega At.origin
    (\fun (arguments: Fin.Fin k -> V) => trans!{{C.Complex}} _ _ _
      (congr!{{Fin.Fin k -> V} {C.Complex}} omega arguments
        (\fun (i: Fin.Fin k) => frame.backward.apply (frame.forward.apply (arguments i)))
        (\axiom:funext(arguments, (\fun (i: Fin.Fin k) => frame.backward.apply (frame.forward.apply (arguments i))),
          \fun (i: Fin.Fin k) => sym!{V} _ _ (frame.leftInverse (arguments i)))))
      (congr!{{CoordinateForms.Form k} {C.Complex}}
        (\fun (eta: CoordinateForms.Form k) => eta (\fun (i: Fin.Fin k) => frame.forward.apply (arguments i))) _ _
        (Dimension.zeroAbove (IntoCoordinates.precompose k frame.backward omega) large)));
