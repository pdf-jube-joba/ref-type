\import C.Def[] \as Scalar;
\import C.Prop[] \as Scalars;
\import Operations.ContractingPair[V := V, W := W, even := even, odd := odd] \as Pair;
\import Pair.With[c := c] \as Normal;
\import Spaces.Linear[V := V, W := W, source := even, target := odd] \as Forward;
\import Spaces.Linear[V := W, W := V, source := odd, target := even] \as Backward;
\import Forward.Operations[] \as ForwardOperations;
\import Backward.Operations[] \as BackwardOperations;
\import Spaces.Laws[V := V, space := even] \as EvenLaws;
\import Spaces.Laws[V := W, space := odd] \as OddLaws;
\module At(t: C.Complex);
\definition atOne: \forall (v: V) -> (At[t := Scalar.one].forward).apply v = Normal.forward.apply v :=
  \fun (v: V) => congr!{W W} (odd.add (c.d.apply v)) _ _ (odd.scalarOne (Normal.k.apply v));
\module Strong(hk: \forall (v: V) -> c.h.apply (c.k.apply v) = even.zero,
  kh: \forall (w: W) -> c.k.apply (c.h.apply w) = odd.zero);
