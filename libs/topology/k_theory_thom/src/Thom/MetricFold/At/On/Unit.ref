\definition hRaw: \forall (y: Y)(v: W y) -> (normalizedH.fiber y).apply v = (H.fiber y).apply v :=
  \fun (y: Y)(v: W y) => trans!{{V y}} _ _ _
    (sym!{{V y}} _ _ (((Target.bundle p).space y).scalarOne ((normalizedH.fiber y).apply v)))
    (trans!{{V y}} _ _ _
      (congr!{{C.Complex} {V y}} (\fun (a: C.Complex) => ((Target.bundle p).space y).smul a ((normalizedH.fiber y).apply v)) _ _ (sym!{{C.Complex}} _ _ (unit y)))
      (restoreH y v));
\definition kRaw: \forall (y: Y)(v: V y) -> (normalizedK.fiber y).apply v = (K.fiber y).apply v :=
  \fun (y: Y)(v: V y) => trans!{{W y}} _ _ _
    (sym!{{W y}} _ _ (((Target.bundle q).space y).scalarOne ((normalizedK.fiber y).apply v)))
    (trans!{{W y}} _ _ _
      (congr!{{C.Complex} {W y}} (\fun (a: C.Complex) => ((Target.bundle q).space y).smul a ((normalizedK.fiber y).apply v)) _ _ (sym!{{C.Complex}} _ _ (unit y)))
      (restoreK y v));
\definition isomorphism: Bundles.Isomorphisms[X := Y, F := V, G := W, source := Target.bundle p, target := Target.bundle q].Isomorphism := Normalized.isomorphism;
\definition forward: \forall (y: Y)(v: V y) -> (isomorphism.forward.fiber y).apply v = ((ForwardPull.map cliffordForward).fiber y).apply v :=
  \fun (y: Y)(v: V y) => congr!{{W y} {W y}} (((Target.bundle q).space y).add ((D.fiber y).apply v)) _ _
    (trans!{{W y}} _ _ _ (kFixed y v) (kRaw y v));
\definition backward: \forall (y: Y)(v: W y) -> (isomorphism.backward.fiber y).apply v = ((BackwardPull.map cliffordBackward).fiber y).apply v :=
  \fun (y: Y)(v: W y) => congr!{{V y} {V y}} (((Target.bundle p).space y).add ((E.fiber y).apply v)) _ _
    (trans!{{V y}} _ _ _ (hFixed y v) (hRaw y v));
