\import Spaces.Laws[V := Even p, space := (Models.bundle even).space p] \as EvenLaws;
\import Spaces.Laws[V := Odd p, space := (Models.bundle odd).space p] \as OddLaws;
\definition evenLeft[v: Even p]: ((Models.bundle even).space p).add ((e.fiber p).apply ((d.fiber p).apply v)) ((e.fiber p).apply ((k.fiber p).apply v)) = (e.fiber p).apply ((k.fiber p).apply v) :=
  trans!{{Even p}} _ _ _ (congr!{{Even p} {Even p}} (\fun (w: Even p) => ((Models.bundle even).space p).add w ((e.fiber p).apply ((k.fiber p).apply v))) _ _ (Chain.squareZero.left p v))
    (EvenLaws.zeroLeft _);
\definition evenRight[v: Even p]: ((Models.bundle even).space p).add ((h.fiber p).apply ((d.fiber p).apply v)) ((h.fiber p).apply ((k.fiber p).apply v)) = (h.fiber p).apply ((d.fiber p).apply v) :=
  trans!{{Even p}} _ _ _ (congr!{{Even p} {Even p}} (((Models.bundle even).space p).add ((h.fiber p).apply ((d.fiber p).apply v))) _ _ (hk p v))
    (EvenLaws.zeroRight _);
\definition evenSquare: \forall (v: Even p) -> (cliffordBackward.fiber p).apply ((cliffordForward.fiber p).apply v) = ((Models.bundle even).space p).smul (MetricRaising.coefficient p) v :=
  \fun (v: Even p) => trans!{{Even p}} _ _ _
    (congr!{{Even p} {Even p} {Even p}} ((Models.bundle even).space p).add _ _ _ _
      ((e.fiber p).preservesAdd ((d.fiber p).apply v) ((k.fiber p).apply v))
      ((h.fiber p).preservesAdd ((d.fiber p).apply v) ((k.fiber p).apply v)))
    (trans!{{Even p}} _ _ _ (congr!{{Even p} {Even p} {Even p}} ((Models.bundle even).space p).add _ _ _ _ (evenLeft v) (evenRight v)) (evenCartan p v));
\definition oddLeft[v: Odd p]: ((Models.bundle odd).space p).add ((d.fiber p).apply ((e.fiber p).apply v)) ((d.fiber p).apply ((h.fiber p).apply v)) = (d.fiber p).apply ((h.fiber p).apply v) :=
  trans!{{Odd p}} _ _ _ (congr!{{Odd p} {Odd p}} (\fun (w: Odd p) => ((Models.bundle odd).space p).add w ((d.fiber p).apply ((h.fiber p).apply v))) _ _ (Chain.squareZero.right p v))
    (OddLaws.zeroLeft _);
\definition oddRight[v: Odd p]: ((Models.bundle odd).space p).add ((k.fiber p).apply ((e.fiber p).apply v)) ((k.fiber p).apply ((h.fiber p).apply v)) = (k.fiber p).apply ((e.fiber p).apply v) :=
  trans!{{Odd p}} _ _ _ (congr!{{Odd p} {Odd p}} (((Models.bundle odd).space p).add ((k.fiber p).apply ((e.fiber p).apply v))) _ _ (kh p v))
    (OddLaws.zeroRight _);
\definition oddSquare: \forall (v: Odd p) -> (cliffordForward.fiber p).apply ((cliffordBackward.fiber p).apply v) = ((Models.bundle odd).space p).smul (MetricRaising.coefficient p) v :=
  \fun (v: Odd p) => trans!{{Odd p}} _ _ _
    (congr!{{Odd p} {Odd p} {Odd p}} ((Models.bundle odd).space p).add _ _ _ _
      ((d.fiber p).preservesAdd ((e.fiber p).apply v) ((h.fiber p).apply v))
      ((k.fiber p).preservesAdd ((e.fiber p).apply v) ((h.fiber p).apply v)))
    (trans!{{Odd p}} _ _ _ (congr!{{Odd p} {Odd p} {Odd p}} ((Models.bundle odd).space p).add _ _ _ _ (oddLeft v) (oddRight v)) (oddCartan p v));
