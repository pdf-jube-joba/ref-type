\import Spaces.Linear[V := Odd q, W := Even q, source := (Models.bundle odd).space q, target := (Models.bundle even).space q].Operations[] \as Maps;
\import algebra.Group[].Of[Carrier := Even q,
  group := std.Alg[].Ring[].ringModuleAsCommutativeGroup C.Complex (Even q) Spaces.ring ((Models.bundle even).space q)] \as PositiveGroup;
\import Spaces.Laws[V := Odd q, space := (Models.bundle odd).space q] \as NegativeLaws;
\definition equation: \forall (v: Fiber q) -> (bundle.space q).add
  ((grading.fiber q).apply ((operator.fiber q).apply v)) ((operator.fiber q).apply ((grading.fiber q).apply v)) = (bundle.space q).zero :=
  \fun (v: Fiber q) => P.Prop[A := Even q, B := Odd q].ext _ _
    (trans!{{Even q}} _ _ _
      (congr!{{Even q} {Even q}} (((Models.bundle even).space q).add ((cliffordBackward.fiber q).apply (P.second (Even q) (Odd q) v))) _ _
        (trans!{{Even q}} _ _ _
          (congr!{{Odd q} {Even q}} (cliffordBackward.fiber q).apply _ _ (Minus.formula q (P.second (Even q) (Odd q) v)))
          (Maps.preservesNeg (cliffordBackward.fiber q) (P.second (Even q) (Odd q) v))))
      (PositiveGroup.inverseRight ((cliffordBackward.fiber q).apply (P.second (Even q) (Odd q) v))))
    (trans!{{Odd q}} _ _ _
      (congr!{{Odd q} {Odd q}} (\fun (w: Odd q) => ((Models.bundle odd).space q).add w ((cliffordForward.fiber q).apply (P.first (Even q) (Odd q) v))) _ _
        (Minus.formula q ((cliffordForward.fiber q).apply (P.first (Even q) (Odd q) v))))
      (NegativeLaws.inverseLeft ((cliffordForward.fiber q).apply (P.first (Even q) (Odd q) v))));
