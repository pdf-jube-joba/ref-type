\definition inverse: MapOperations.Map := MapOperations.functionScale reciprocal operator continuous;
\definition leftInverse: \forall (x: X)(v: Tensor.Fiber x) -> (inverse.fiber x).apply ((operator.fiber x).apply v) = v :=
  \fun (x: X)(v: Tensor.Fiber x) => trans!{{Tensor.Fiber x}} _ _ _
    (congr!{{Tensor.Fiber x} {Tensor.Fiber x}} ((Tensor.fiberSpace x).smul (reciprocal x)) _ _ (square x v))
    (trans!{{Tensor.Fiber x}} _ _ _
      (sym!{{Tensor.Fiber x}} _ _ ((Tensor.fiberSpace x).scalarAssoc (reciprocal x) (Scalar.add (c.a x) (c.b x)) v))
      (trans!{{Tensor.Fiber x}} _ _ _
        (congr!{{C.Complex} {Tensor.Fiber x}} (\fun (a: C.Complex) => (Tensor.fiberSpace x).smul a v) _ _ (inverseLaw x)) ((Tensor.fiberSpace x).scalarOne v)));
\definition rightInverse: \forall (x: X)(v: Tensor.Fiber x) -> (operator.fiber x).apply ((inverse.fiber x).apply v) = v :=
  \fun (x: X)(v: Tensor.Fiber x) => trans!{{Tensor.Fiber x}} _ _ _
    ((operator.fiber x).preservesScale (reciprocal x) ((operator.fiber x).apply v)) (leftInverse x v);
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Tensor.Fiber, G := Tensor.Fiber, source := bundle, target := bundle].Isomorphism :=
  Bundles.Isomorphisms[X := X, F := Tensor.Fiber, G := Tensor.Fiber, source := bundle, target := bundle].Isomorphism {
    forward := operator, backward := inverse, leftInverse := leftInverse, rightInverse := rightInverse
  };
\module Graded(grading: SecondMaps.Map,
  gradingSquare: \forall (x: X)(w: G x) -> (grading.fiber x).apply ((grading.fiber x).apply w) = w,
  anticommutes: \forall (x: X)(w: G x) -> (second.space x).add
    ((grading.fiber x).apply ((c.second.fiber x).apply w)) ((c.second.fiber x).apply ((grading.fiber x).apply w)) = (second.space x).zero);
