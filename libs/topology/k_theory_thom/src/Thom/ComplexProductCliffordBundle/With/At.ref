\import \root.Thom[].ComplexProductClifford[V := F x, W := G x, firstSpace := first.space x, secondSpace := second.space x] \as Algebra;
\import Algebra.With[c := fiberData c x, laws := laws x] \as Symbol;
\import Operations.TensorEquality[V := F x, W := G x, U := Tensor.Fiber x, left := first.space x, right := second.space x, target := Tensor.fiberSpace x] \as EqualityOnPure;
\definition equation: \forall (v: Tensor.Fiber x) -> (operator.fiber x).apply v = Symbol.operator.apply v :=
  EqualityOnPure.pointwise (operator.fiber x) Symbol.operator
    (\fun (v: F x)(w: G x) => trans!{{Tensor.Fiber x}} _ _ _ (onPure x v w) (sym!{{Tensor.Fiber x}} _ _ (Symbol.onPure v w)));
\definition square[v: Tensor.Fiber x]:
  (operator.fiber x).apply ((operator.fiber x).apply v) = (Tensor.fiberSpace x).smul (Scalar.add (c.a x) (c.b x)) v :=
  trans!{{Tensor.Fiber x}} _ _ _ (equation ((operator.fiber x).apply v))
    (trans!{{Tensor.Fiber x}} _ _ _ (congr!{{Tensor.Fiber x} {Tensor.Fiber x}} Symbol.operator.apply _ _ (equation v)) (Symbol.square v));
