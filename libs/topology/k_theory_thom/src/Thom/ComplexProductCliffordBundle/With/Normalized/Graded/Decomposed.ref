\import Operations.DirectSum[X := X, F := U, G := T, left := even, right := odd] \as Split;
\import Split.Of[same := same] \as SplitMaps;
\import SplitMaps.Inclusions[] \as Inclusions;
\import std.Data[].Pair[] \as Pair;
\definition Compatible: \Prop := \forall (x: X)(v: Tensor.Fiber x) ->
  (decomposition.forward.fiber x).apply ((parity.fiber x).apply v) = Pair.pair (U x) (T x)
    (Pair.first (U x) (T x) ((decomposition.forward.fiber x).apply v))
    ((odd.space x).neg (Pair.second (U x) (T x) ((decomposition.forward.fiber x).apply v)));
\import Bundles.Morphisms[X := X, Y := X, F := U, G := Split.Fiber, source := even, target := Split.bundle same, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Tensor.Fiber, range := bundle, g := (\fun (x: X) => x)] \as EmbedEven;
\definition embedEven: Bundles.Morphisms[X := X, Y := X, F := U, G := Tensor.Fiber, source := even, target := bundle, f := (\fun (x: X) => x)].Map := EmbedEven.compose Inclusions.first decomposition.backward;
\import Bundles.Morphisms[X := X, Y := X, F := T, G := Split.Fiber, source := odd, target := Split.bundle same, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Tensor.Fiber, range := bundle, g := (\fun (x: X) => x)] \as EmbedOdd;
\definition embedOdd: Bundles.Morphisms[X := X, Y := X, F := T, G := Tensor.Fiber, source := odd, target := bundle, f := (\fun (x: X) => x)].Map := EmbedOdd.compose Inclusions.second decomposition.backward;
\import Bundles.Morphisms[X := X, Y := X, F := Tensor.Fiber, G := Split.Fiber, source := bundle, target := Split.bundle same, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := U, range := even, g := (\fun (x: X) => x)] \as ProjectEven;
\definition projectEven: Bundles.Morphisms[X := X, Y := X, F := Tensor.Fiber, G := U, source := bundle, target := even, f := (\fun (x: X) => x)].Map := ProjectEven.compose decomposition.forward SplitMaps.firstMap;
\import Bundles.Morphisms[X := X, Y := X, F := Tensor.Fiber, G := Split.Fiber, source := bundle, target := Split.bundle same, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := T, range := odd, g := (\fun (x: X) => x)] \as ProjectOdd;
\definition projectOdd: Bundles.Morphisms[X := X, Y := X, F := Tensor.Fiber, G := T, source := bundle, target := odd, f := (\fun (x: X) => x)].Map := ProjectOdd.compose decomposition.forward SplitMaps.secondMap;
\import Bundles.Morphisms[X := X, Y := X, F := U, G := Tensor.Fiber, source := even, target := bundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Tensor.Fiber, range := bundle, g := (\fun (x: X) => x)] \as ForwardStart;
\import Bundles.Morphisms[X := X, Y := X, F := U, G := Tensor.Fiber, source := even, target := bundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := T, range := odd, g := (\fun (x: X) => x)] \as ForwardEnd;
\definition forward: Bundles.Morphisms[X := X, Y := X, F := U, G := T, source := even, target := odd, f := (\fun (x: X) => x)].Map := ForwardEnd.compose (ForwardStart.compose embedEven operator) projectOdd;
\import Bundles.Morphisms[X := X, Y := X, F := T, G := Tensor.Fiber, source := odd, target := bundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Tensor.Fiber, range := bundle, g := (\fun (x: X) => x)] \as BackwardStart;
\import Bundles.Morphisms[X := X, Y := X, F := T, G := Tensor.Fiber, source := odd, target := bundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := U, range := even, g := (\fun (x: X) => x)] \as BackwardEnd;
\definition backward: Bundles.Morphisms[X := X, Y := X, F := T, G := U, source := odd, target := even, f := (\fun (x: X) => x)].Map := BackwardEnd.compose (BackwardStart.compose embedOdd inverse) projectEven;
\module With(compatible: Compatible);
