\definition parity: MapOperations.Map := Mapping.map c.grading grading;
\module Decomposed(U, T: X -> \Set,
  even: Bundles.Family[X := X, F := U].Bundle, odd: Bundles.Family[X := X, F := T].Bundle,
  same: even.baseSpace = odd.baseSpace,
  decomposition: Bundles.Isomorphisms[X := X, F := Tensor.Fiber,
    G := Operations.DirectSum[X := X, F := U, G := T, left := even, right := odd].Fiber,
    source := bundle, target := Operations.DirectSum[X := X, F := U, G := T, left := even, right := odd].bundle same].Isomorphism);
