\module At(x: X);
\definition isomorphism: Bundles.Isomorphisms[X := X, F := U, G := T, source := even, target := odd].Isomorphism :=
  Bundles.Isomorphisms[X := X, F := U, G := T, source := even, target := odd].Isomorphism {
    forward := forward, backward := backward,
    leftInverse := \fun (x: X)(v: U x) => At[x := x].left v,
    rightInverse := \fun (x: X)(w: T x) => At[x := x].right w
  };
