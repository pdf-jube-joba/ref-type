\import \root.Thom[].FiberMultiply[X := X, F := F, G := G, left := left, right := right, sameBase := sameBase, compact := compact, hausdorff := hausdorff] \as Multiply;
\import Multiply.Along[Y := PointFamily.Point, target := PointBundle.bundle.totalSpace, targetHausdorff := PointTotal.separated, targetLocallyCompact := PointTotal.locallyCompact,
  g := Trivialization.projection, regular := Trivialization.continuous, proper := Trivialization.proper] \as Along;
\import \parent.Compactification[] \as Compactification;
\import Relative.Pullback[source := sourceModel, target := targetModel, f := equivalence.forward] \as Pull;
\definition equation: \forall (a: Multiply.First) -> Multiply.multiply a Trivialization.thom = Pull.map (Smash.External[].product a Trivialization.pointThom) :=
  \fun (a: Multiply.First) => trans!{{Multiply.Carrier}} _ _ _
    (congr!{{Trivialization.Carrier} {Multiply.Carrier}} (Multiply.multiply a) _ _ Trivialization.formula)
    (trans!{{Multiply.Carrier}} _ _ _ (Along.equation a Trivialization.pointThom)
      (congr!{{Relative.Map sourceModel targetModel} {Multiply.Carrier}}
        (\fun (f: Relative.Map sourceModel targetModel) => Relative.Pullback[source := sourceModel, target := targetModel, f := f].map (Smash.External[].product a Trivialization.pointThom)) _ _
        (sym!{{Relative.Map sourceModel targetModel}} _ _ Compactification.maps)));
