
\import FirstTheory.Bundle[F := F0, original := e0, same := e0Same] \as E0;
\import FirstTheory.Bundle[F := F1, original := e1, same := e1Same] \as E1;
\import SecondTheory.Bundle[F := G0, original := f0, same := f0Same] \as F0Class;
\import SecondTheory.Bundle[F := G1, original := f1, same := f1Same] \as F1Class;
\import FirstPull.Of[F := F0, original := e0, same := e0Same] \as PE0;
\import FirstPull.Of[F := F1, original := e1, same := e1Same] \as PE1;
\import SecondPull.Of[F := G0, original := f0, same := f0Same] \as PF0;
\import SecondPull.Of[F := G1, original := f1, same := f1Same] \as PF1;
\definition firstEven: FirstTheory.Classes := E0.value;
\definition firstOdd: FirstTheory.Classes := E1.value;
\definition secondEven: SecondTheory.Classes := F0Class.value;
\definition secondOdd: SecondTheory.Classes := F1Class.value;
\import \root.Thom[].ComplexProduct[left := left, right := right].Parity[
  firstEven := firstEven, firstOdd := firstOdd, secondEven := secondEven, secondOdd := secondOdd] \as Parity;
\import ProductTheory.Product[F := (\fun (x: Smash.model.Carrier) => F0 (Smash.first x)), G := (\fun (x: Smash.model.Carrier) => G0 (Smash.second x)),
  left := PE0.pulled, right := PF0.pulled, leftSame := (\refl(Smash.topology)), rightSame := (\refl(Smash.topology))] \as EE;
\definition eeFormula: Ring.mul (FirstPull.map (E0.value)) (SecondPull.map (F0Class.value)) = EE.value :=
  trans!{{ProductTheory.Classes}} _ _ _ (congr!{{ProductTheory.Classes} {ProductTheory.Classes} {ProductTheory.Classes}} Ring.mul _ _ _ _ PE0.naturality PF0.naturality) EE.onBundles;
\import ProductTheory.Product[F := (\fun (x: Smash.model.Carrier) => F1 (Smash.first x)), G := (\fun (x: Smash.model.Carrier) => G1 (Smash.second x)),
  left := PE1.pulled, right := PF1.pulled, leftSame := (\refl(Smash.topology)), rightSame := (\refl(Smash.topology))] \as OO;
\definition ooFormula: Ring.mul (FirstPull.map (E1.value)) (SecondPull.map (F1Class.value)) = OO.value :=
  trans!{{ProductTheory.Classes}} _ _ _ (congr!{{ProductTheory.Classes} {ProductTheory.Classes} {ProductTheory.Classes}} Ring.mul _ _ _ _ PE1.naturality PF1.naturality) OO.onBundles;
\import ProductTheory.Product[F := (\fun (x: Smash.model.Carrier) => F0 (Smash.first x)), G := (\fun (x: Smash.model.Carrier) => G1 (Smash.second x)),
  left := PE0.pulled, right := PF1.pulled, leftSame := (\refl(Smash.topology)), rightSame := (\refl(Smash.topology))] \as EO;
\definition eoFormula: Ring.mul (FirstPull.map (E0.value)) (SecondPull.map (F1Class.value)) = EO.value :=
  trans!{{ProductTheory.Classes}} _ _ _ (congr!{{ProductTheory.Classes} {ProductTheory.Classes} {ProductTheory.Classes}} Ring.mul _ _ _ _ PE0.naturality PF1.naturality) EO.onBundles;
\import ProductTheory.Product[F := (\fun (x: Smash.model.Carrier) => F1 (Smash.first x)), G := (\fun (x: Smash.model.Carrier) => G0 (Smash.second x)),
  left := PE1.pulled, right := PF0.pulled, leftSame := (\refl(Smash.topology)), rightSame := (\refl(Smash.topology))] \as OE;
\definition oeFormula: Ring.mul (FirstPull.map (E1.value)) (SecondPull.map (F0Class.value)) = OE.value :=
  trans!{{ProductTheory.Classes}} _ _ _ (congr!{{ProductTheory.Classes} {ProductTheory.Classes} {ProductTheory.Classes}} Ring.mul _ _ _ _ PE1.naturality PF0.naturality) OE.onBundles;

\definition EEFiber[x: Smash.model.Carrier]: \Set := EE.FiberAt x;
\definition eeBundle: Bundles.Family[X := Smash.model.Carrier, F := EEFiber].Bundle := EE.tensorBundle;
\definition OOFiber[x: Smash.model.Carrier]: \Set := OO.FiberAt x;
\definition ooBundle: Bundles.Family[X := Smash.model.Carrier, F := OOFiber].Bundle := OO.tensorBundle;
\definition EOFiber[x: Smash.model.Carrier]: \Set := EO.FiberAt x;
\definition eoBundle: Bundles.Family[X := Smash.model.Carrier, F := EOFiber].Bundle := EO.tensorBundle;
\definition OEFiber[x: Smash.model.Carrier]: \Set := OE.FiberAt x;
\definition oeBundle: Bundles.Family[X := Smash.model.Carrier, F := OEFiber].Bundle := OE.tensorBundle;

\import ProductTheory.Sum[F := EE.FiberAt, G := OO.FiberAt, left := EE.tensorBundle, right := OO.tensorBundle,
  leftSame := (\refl(Smash.topology)), rightSame := (\refl(Smash.topology))] \as EvenSum;
\import ProductTheory.Sum[F := EO.FiberAt, G := OE.FiberAt, left := EO.tensorBundle, right := OE.tensorBundle,
  leftSame := (\refl(Smash.topology)), rightSame := (\refl(Smash.topology))] \as OddSum;
\definition Even[x: Smash.model.Carrier]: \Set := EvenSum.FiberAt x;
\definition Odd[x: Smash.model.Carrier]: \Set := OddSum.FiberAt x;
\definition evenBundle: Bundles.Family[X := Smash.model.Carrier, F := Even].Bundle := EvenSum.sumBundle;
\definition oddBundle: Bundles.Family[X := Smash.model.Carrier, F := Odd].Bundle := OddSum.sumBundle;
\definition evenFormula: Parity.even = EvenSum.value :=
  trans!{{ProductTheory.Classes}} _ _ _ (congr!{{ProductTheory.Classes} {ProductTheory.Classes} {ProductTheory.Classes}} Ring.add _ _ _ _ eeFormula ooFormula) EvenSum.onBundles;
\definition oddFormula: Parity.odd = OddSum.value :=
  trans!{{ProductTheory.Classes}} _ _ _ (congr!{{ProductTheory.Classes} {ProductTheory.Classes} {ProductTheory.Classes}} Ring.add _ _ _ _ eoFormula oeFormula) OddSum.onBundles;
\import Pair.BundleModel[F := Even].From[original := evenBundle, same := (\refl(Smash.topology))] \as EvenModel;
\import Pair.BundleModel[F := Odd].From[original := oddBundle, same := (\refl(Smash.topology))] \as OddModel;
\definition evenModel: Pair.BundleModel[F := Even].Bundle := EvenModel.model;
\definition oddModel: Pair.BundleModel[F := Odd].Bundle := OddModel.model;
\import Pair.BundleTriples[F := Even, G := Odd, firstModel := evenModel, secondModel := oddModel] \as Triples;
\definition BoundaryIsomorphism: \Set := Triples.OnSubset;
\module With(alpha: BoundaryIsomorphism);

\module Decomposition;
