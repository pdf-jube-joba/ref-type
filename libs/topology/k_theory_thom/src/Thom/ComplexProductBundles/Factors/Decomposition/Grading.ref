
\import Operations.IdentityIsomorphism[X := Smash.model.Carrier, F := (\fun (x: Smash.model.Carrier) => F0 (Smash.first x)), bundle := PE0.pulled] \as LeftIdentity;
\import Operations.Negation[X := Smash.model.Carrier, F := (\fun (x: Smash.model.Carrier) => F1 (Smash.first x)), bundle := PE1.pulled] \as LeftNegative;
\import Operations.IdentityIsomorphism[X := Smash.model.Carrier, F := (\fun (x: Smash.model.Carrier) => G0 (Smash.second x)), bundle := PF0.pulled] \as RightIdentity;
\import Operations.Negation[X := Smash.model.Carrier, F := (\fun (x: Smash.model.Carrier) => G1 (Smash.second x)), bundle := PF1.pulled] \as RightNegative;
\import Operations.DirectSumIsomorphisms[X := Smash.model.Carrier,
  F := (\fun (x: Smash.model.Carrier) => F0 (Smash.first x)), G := (\fun (x: Smash.model.Carrier) => F1 (Smash.first x)),
  A := (\fun (x: Smash.model.Carrier) => F0 (Smash.first x)), B := (\fun (x: Smash.model.Carrier) => F1 (Smash.first x)),
  first := PE0.pulled, second := PE1.pulled, newFirst := PE0.pulled, newSecond := PE1.pulled,
  sameSource := (\refl(Smash.topology)), sameTarget := (\refl(Smash.topology))] \as LeftPair;
\import Operations.DirectSumIsomorphisms[X := Smash.model.Carrier,
  F := (\fun (x: Smash.model.Carrier) => G0 (Smash.second x)), G := (\fun (x: Smash.model.Carrier) => G1 (Smash.second x)),
  A := (\fun (x: Smash.model.Carrier) => G0 (Smash.second x)), B := (\fun (x: Smash.model.Carrier) => G1 (Smash.second x)),
  first := PF0.pulled, second := PF1.pulled, newFirst := PF0.pulled, newSecond := PF1.pulled,
  sameSource := (\refl(Smash.topology)), sameTarget := (\refl(Smash.topology))] \as RightPair;
\definition leftGrading: Bundles.Isomorphisms[X := Smash.model.Carrier, F := LeftFiber, G := LeftFiber, source := leftBundle, target := leftBundle].Isomorphism :=
  LeftPair.isomorphism LeftIdentity.isomorphism LeftNegative.isomorphism;
\definition rightGrading: Bundles.Isomorphisms[X := Smash.model.Carrier, F := RightFiber, G := RightFiber, source := rightBundle, target := rightBundle].Isomorphism :=
  RightPair.isomorphism RightIdentity.isomorphism RightNegative.isomorphism;
\definition leftSquare: \forall (x: Smash.model.Carrier)(v: LeftFiber x) -> (leftGrading.forward.fiber x).apply ((leftGrading.forward.fiber x).apply v) = v := leftGrading.leftInverse;
\definition rightSquare: \forall (x: Smash.model.Carrier)(v: RightFiber x) -> (rightGrading.forward.fiber x).apply ((rightGrading.forward.fiber x).apply v) = v := rightGrading.leftInverse;
\definition leftFormula: \forall (x: Smash.model.Carrier)(v: LeftFiber x) -> (leftGrading.forward.fiber x).apply v =
  P.pair (F0 (Smash.first x)) (F1 (Smash.first x)) (P.first (F0 (Smash.first x)) (F1 (Smash.first x)) v)
    ((PE1.pulled.space x).neg (P.second (F0 (Smash.first x)) (F1 (Smash.first x)) v)) :=
  \fun (x: Smash.model.Carrier)(v: LeftFiber x) => congr!{{F1 (Smash.first x)} {LeftFiber x}}
    (P.pair (F0 (Smash.first x)) (F1 (Smash.first x)) (P.first (F0 (Smash.first x)) (F1 (Smash.first x)) v)) _ _
    (LeftNegative.formula x (P.second (F0 (Smash.first x)) (F1 (Smash.first x)) v));
\definition rightFormula: \forall (x: Smash.model.Carrier)(v: RightFiber x) -> (rightGrading.forward.fiber x).apply v =
  P.pair (G0 (Smash.second x)) (G1 (Smash.second x)) (P.first (G0 (Smash.second x)) (G1 (Smash.second x)) v)
    ((PF1.pulled.space x).neg (P.second (G0 (Smash.second x)) (G1 (Smash.second x)) v)) :=
  \fun (x: Smash.model.Carrier)(v: RightFiber x) => congr!{{G1 (Smash.second x)} {RightFiber x}}
    (P.pair (G0 (Smash.second x)) (G1 (Smash.second x)) (P.first (G0 (Smash.second x)) (G1 (Smash.second x)) v)) _ _
    (RightNegative.formula x (P.second (G0 (Smash.second x)) (G1 (Smash.second x)) v));
\import Operations.IdentityIsomorphism[X := Smash.model.Carrier, F := Even, bundle := evenBundle] \as EvenIdentity;
\import Operations.Negation[X := Smash.model.Carrier, F := Odd, bundle := oddBundle] \as OddNegative;
\import Operations.DirectSumIsomorphisms[X := Smash.model.Carrier, F := Even, G := Odd, A := Even, B := Odd,
  first := evenBundle, second := oddBundle, newFirst := evenBundle, newSecond := oddBundle,
  sameSource := (\refl(Smash.topology)), sameTarget := (\refl(Smash.topology))] \as TotalPair;
\definition targetGrading: Bundles.Isomorphisms[X := Smash.model.Carrier, F := TargetFiber, G := TargetFiber, source := targetBundle, target := targetBundle].Isomorphism :=
  TotalPair.isomorphism EvenIdentity.isomorphism OddNegative.isomorphism;
\definition targetFormula: \forall (x: Smash.model.Carrier)(v: TargetFiber x) -> (targetGrading.forward.fiber x).apply v =
  P.pair (Even x) (Odd x) (P.first (Even x) (Odd x) v) ((oddBundle.space x).neg (P.second (Even x) (Odd x) v)) :=
  \fun (x: Smash.model.Carrier)(v: TargetFiber x) => congr!{{Odd x} {TargetFiber x}}
    (P.pair (Even x) (Odd x) (P.first (Even x) (Odd x) v)) _ _ (OddNegative.formula x (P.second (Even x) (Odd x) v));
\import Tensor.Of[same := (\refl(Smash.topology))].Mapping[Y := Smash.model.Carrier, A := LeftFiber, B := RightFiber,
  leftTarget := leftBundle, rightTarget := rightBundle, f := (\fun (x: Smash.model.Carrier) => x)].Of[targetSame := (\refl(Smash.topology))] \as TensorMapping;
\definition tensorGrading: Bundles.Morphisms[X := Smash.model.Carrier, Y := Smash.model.Carrier, F := SourceFiber, G := SourceFiber,
  source := sourceBundle, target := sourceBundle, f := (\fun (x: Smash.model.Carrier) => x)].Map := TensorMapping.map leftGrading.forward rightGrading.forward;
\module At(x: Smash.model.Carrier);
\definition compatible: \forall (x: Smash.model.Carrier)(z: SourceFiber x) ->
  (isomorphism.forward.fiber x).apply (At[x := x].parity.apply z) = P.pair (Even x) (Odd x)
    (P.first (Even x) (Odd x) ((isomorphism.forward.fiber x).apply z))
    ((oddBundle.space x).neg (P.second (Even x) (Odd x) ((isomorphism.forward.fiber x).apply z))) :=
  \fun (x: Smash.model.Carrier) => At[x := x].compatible;
