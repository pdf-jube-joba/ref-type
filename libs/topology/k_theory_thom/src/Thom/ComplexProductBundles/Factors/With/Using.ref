\use Equality.eq_reason_in;
\definition positive: ProductTheory.class result.value.positive = Parity.even :=
  trans!{{ProductTheory.Classes}} _ _ _ (sym!{{ProductTheory.Classes}} _ _ (Represent.positiveClass alpha result)) (sym!{{ProductTheory.Classes}} _ _ evenFormula);
\definition negative: ProductTheory.class result.value.negative = Parity.odd :=
  trans!{{ProductTheory.Classes}} _ _ _ (sym!{{ProductTheory.Classes}} _ _ (Represent.negativeClass alpha result)) (sym!{{ProductTheory.Classes}} _ _ oddFormula);
\definition equation: \root.Thom[].ComplexProduct[left := left, right := right].ordinaryForget value = Parity.difference :=
  eq_reason_in!{{ProductK.Carrier} _
    "=" { Projection.projectionPull value } "by" { toProjection value }
    "=" { Forget.map Triple.value } "by" { Projection.onGroup Triple.value }
    "=" { Forget.map (Group.value result.value) } "by" { congr!{{Group.Carrier} {ProductK.Carrier}} Forget.map _ _ (Triple.agreement result) }
    "=" { ProductK.difference (ProductTheory.class result.value.positive) (ProductTheory.class result.value.negative) } "by" { Forget.onTriple result.value }
    "=" _ "by" { congr!{{ProductTheory.Classes} {ProductTheory.Classes} {ProductK.Carrier}} ProductK.difference _ _ _ _ positive negative }
  };
