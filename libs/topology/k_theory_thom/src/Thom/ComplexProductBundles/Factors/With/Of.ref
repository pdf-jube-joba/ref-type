
\import \root.Thom[].ComplexProduct[left := left, right := right].Parity[
  firstEven := firstEven, firstOdd := firstOdd, secondEven := secondEven, secondOdd := secondOdd]
  .Of[a := a, b := b, firstAgreement := firstAgreement, secondAgreement := secondAgreement] \as Product;
\definition equation: value = External.product a b := Product.determines value ordinary;
