
\import std.Data[].Pair[] \as P;
\import Operations.DirectSum[X := Smash.model.Carrier, F := (\fun (x: Smash.model.Carrier) => F0 (Smash.first x)), G := (\fun (x: Smash.model.Carrier) => F1 (Smash.first x)),
  left := PE0.pulled, right := PE1.pulled] \as LeftSum;
\import Operations.DirectSum[X := Smash.model.Carrier, F := (\fun (x: Smash.model.Carrier) => G0 (Smash.second x)), G := (\fun (x: Smash.model.Carrier) => G1 (Smash.second x)),
  left := PF0.pulled, right := PF1.pulled] \as RightSum;
\definition LeftFiber[x: Smash.model.Carrier]: \Set := LeftSum.Fiber x;
\definition RightFiber[x: Smash.model.Carrier]: \Set := RightSum.Fiber x;
\definition leftBundle: Bundles.Family[X := Smash.model.Carrier, F := LeftFiber].Bundle := LeftSum.bundle (\refl(Smash.topology));
\definition rightBundle: Bundles.Family[X := Smash.model.Carrier, F := RightFiber].Bundle := RightSum.bundle (\refl(Smash.topology));
\import Operations.Tensor[X := Smash.model.Carrier, F := LeftFiber, G := RightFiber, left := leftBundle, right := rightBundle] \as Tensor;
\definition SourceFiber[x: Smash.model.Carrier]: \Set := Tensor.Fiber x;
\definition sourceBundle: Bundles.Family[X := Smash.model.Carrier, F := SourceFiber].Bundle := Tensor.bundle (\refl(Smash.topology));
\import Operations.DirectSum[X := Smash.model.Carrier, F := Even, G := Odd, left := evenBundle, right := oddBundle] \as Total;
\definition TargetFiber[x: Smash.model.Carrier]: \Set := Total.Fiber x;
\definition targetBundle: Bundles.Family[X := Smash.model.Carrier, F := TargetFiber].Bundle := Total.bundle (\refl(Smash.topology));
\import \root.Thom[].ComplexProductDistribution[X := Smash.model.Carrier,
  F := (\fun (x: Smash.model.Carrier) => F0 (Smash.first x)), G := (\fun (x: Smash.model.Carrier) => F1 (Smash.first x)), H := RightFiber,
  first := PE0.pulled, second := PE1.pulled, third := rightBundle, sameSecond := (\refl(Smash.topology)), sameThird := (\refl(Smash.topology))] \as LeftDistribution;
\import Operations.TensorDistribution[X := Smash.model.Carrier,
  F := (\fun (x: Smash.model.Carrier) => F0 (Smash.first x)), G := (\fun (x: Smash.model.Carrier) => G0 (Smash.second x)), H := (\fun (x: Smash.model.Carrier) => G1 (Smash.second x)),
  left := PE0.pulled, middle := PF0.pulled, right := PF1.pulled, sameMiddle := (\refl(Smash.topology)), sameRight := (\refl(Smash.topology))] \as Upper;
\import Operations.TensorDistribution[X := Smash.model.Carrier,
  F := (\fun (x: Smash.model.Carrier) => F1 (Smash.first x)), G := (\fun (x: Smash.model.Carrier) => G0 (Smash.second x)), H := (\fun (x: Smash.model.Carrier) => G1 (Smash.second x)),
  left := PE1.pulled, middle := PF0.pulled, right := PF1.pulled, sameMiddle := (\refl(Smash.topology)), sameRight := (\refl(Smash.topology))] \as Lower;

\import Operations.DirectSumIsomorphisms[X := Smash.model.Carrier, F := Upper.SourceFiber, G := Lower.SourceFiber,
  A := Upper.TargetFiber, B := Lower.TargetFiber,
  first := Upper.sourceBundle, second := Lower.sourceBundle, newFirst := Upper.targetBundle, newSecond := Lower.targetBundle,
  sameSource := (\refl(Smash.topology)), sameTarget := (\refl(Smash.topology))] \as Rows;
\definition rowIsomorphism: Bundles.Isomorphisms[X := Smash.model.Carrier, F := Rows.SourceFiber, G := Rows.TargetFiber,
  source := Rows.sourceBundle, target := Rows.targetBundle].Isomorphism := Rows.isomorphism Upper.isomorphism Lower.isomorphism;
\import Operations.DirectSum[X := Smash.model.Carrier, F := EEFiber, G := EOFiber, left := eeBundle, right := eoBundle] \as UpperSum;
\import Operations.DirectSum[X := Smash.model.Carrier, F := OEFiber, G := OOFiber, left := oeBundle, right := ooBundle] \as LowerSum;
\import Operations.DirectSum[X := Smash.model.Carrier, F := OOFiber, G := OEFiber, left := ooBundle, right := oeBundle] \as ReverseLower;
\definition upperBundle: Bundles.Family[X := Smash.model.Carrier, F := UpperSum.Fiber].Bundle := UpperSum.bundle (\refl(Smash.topology));
\definition lowerBundle: Bundles.Family[X := Smash.model.Carrier, F := LowerSum.Fiber].Bundle := LowerSum.bundle (\refl(Smash.topology));
\definition reverseLowerBundle: Bundles.Family[X := Smash.model.Carrier, F := ReverseLower.Fiber].Bundle := ReverseLower.bundle (\refl(Smash.topology));
\import Operations.IdentityIsomorphism[X := Smash.model.Carrier, F := UpperSum.Fiber, bundle := upperBundle] \as UpperIdentity;
\import LowerSum.Of[same := (\refl(Smash.topology))].Symmetry[] \as LowerFlip;
\import Operations.DirectSumIsomorphisms[X := Smash.model.Carrier, F := UpperSum.Fiber, G := LowerSum.Fiber,
  A := UpperSum.Fiber, B := ReverseLower.Fiber,
  first := upperBundle, second := lowerBundle, newFirst := upperBundle, newSecond := reverseLowerBundle,
  sameSource := (\refl(Smash.topology)), sameTarget := (\refl(Smash.topology))] \as LastFlip;
\definition flipIsomorphism: Bundles.Isomorphisms[X := Smash.model.Carrier, F := LastFlip.SourceFiber, G := LastFlip.TargetFiber,
  source := LastFlip.sourceBundle, target := LastFlip.targetBundle].Isomorphism := LastFlip.isomorphism UpperIdentity.isomorphism LowerFlip.isomorphism;
\import Operations.DirectSumMiddleSwap[X := Smash.model.Carrier, F := EEFiber, G := EOFiber, H := OOFiber, I := OEFiber,
  first := eeBundle, second := eoBundle, third := ooBundle, fourth := oeBundle,
  sameSecond := (\refl(Smash.topology)), sameThird := (\refl(Smash.topology)), sameFourth := (\refl(Smash.topology))] \as Shuffle;
\import Operations.IsomorphismComposition[X := Smash.model.Carrier, F := SourceFiber, G := LeftDistribution.TargetFiber, H := Rows.TargetFiber,
  source := sourceBundle, middle := LeftDistribution.targetBundle, target := Rows.targetBundle] \as FirstComposition;
\definition start: FirstComposition.Isomorphism := FirstComposition.compose LeftDistribution.isomorphism rowIsomorphism;
\import Operations.IsomorphismComposition[X := Smash.model.Carrier, F := SourceFiber, G := Rows.TargetFiber, H := LastFlip.TargetFiber,
  source := sourceBundle, middle := Rows.targetBundle, target := LastFlip.targetBundle] \as SecondComposition;
\definition rearranged: SecondComposition.Isomorphism := SecondComposition.compose start flipIsomorphism;
\import Operations.IsomorphismComposition[X := Smash.model.Carrier, F := SourceFiber, G := LastFlip.TargetFiber, H := TargetFiber,
  source := sourceBundle, middle := LastFlip.targetBundle, target := targetBundle] \as LastComposition;
\definition isomorphism: LastComposition.Isomorphism := LastComposition.compose rearranged Shuffle.isomorphism;
\import Operations.Tensor[X := Smash.model.Carrier, F := (\fun (x: Smash.model.Carrier) => F0 (Smash.first x)), G := (\fun (x: Smash.model.Carrier) => G0 (Smash.second x)),
  left := PE0.pulled, right := PF0.pulled] \as EETensor;
\definition ee[x: Smash.model.Carrier][v: F0 (Smash.first x)][w: G0 (Smash.second x)]: EEFiber x := EETensor.pure x v w;
\import Operations.Tensor[X := Smash.model.Carrier, F := (\fun (x: Smash.model.Carrier) => F1 (Smash.first x)), G := (\fun (x: Smash.model.Carrier) => G1 (Smash.second x)),
  left := PE1.pulled, right := PF1.pulled] \as OOTensor;
\definition oo[x: Smash.model.Carrier][v: F1 (Smash.first x)][w: G1 (Smash.second x)]: OOFiber x := OOTensor.pure x v w;
\import Operations.Tensor[X := Smash.model.Carrier, F := (\fun (x: Smash.model.Carrier) => F0 (Smash.first x)), G := (\fun (x: Smash.model.Carrier) => G1 (Smash.second x)),
  left := PE0.pulled, right := PF1.pulled] \as EOTensor;
\definition eo[x: Smash.model.Carrier][v: F0 (Smash.first x)][w: G1 (Smash.second x)]: EOFiber x := EOTensor.pure x v w;
\import Operations.Tensor[X := Smash.model.Carrier, F := (\fun (x: Smash.model.Carrier) => F1 (Smash.first x)), G := (\fun (x: Smash.model.Carrier) => G0 (Smash.second x)),
  left := PE1.pulled, right := PF0.pulled] \as OETensor;
\definition oe[x: Smash.model.Carrier][v: F1 (Smash.first x)][w: G0 (Smash.second x)]: OEFiber x := OETensor.pure x v w;

\definition pure[x: Smash.model.Carrier][v: LeftFiber x][w: RightFiber x]: SourceFiber x := Tensor.pure x v w;
\definition onPure: \forall (x: Smash.model.Carrier)(v: LeftFiber x)(w: RightFiber x) ->
  (isomorphism.forward.fiber x).apply (pure x v w) = P.pair (Even x) (Odd x)
    (P.pair (EEFiber x) (OOFiber x)
      (ee x (P.first (F0 (Smash.first x)) (F1 (Smash.first x)) v) (P.first (G0 (Smash.second x)) (G1 (Smash.second x)) w))
      (oo x (P.second (F0 (Smash.first x)) (F1 (Smash.first x)) v) (P.second (G0 (Smash.second x)) (G1 (Smash.second x)) w)))
    (P.pair (EOFiber x) (OEFiber x)
      (eo x (P.first (F0 (Smash.first x)) (F1 (Smash.first x)) v) (P.second (G0 (Smash.second x)) (G1 (Smash.second x)) w))
      (oe x (P.second (F0 (Smash.first x)) (F1 (Smash.first x)) v) (P.first (G0 (Smash.second x)) (G1 (Smash.second x)) w))) :=
  \fun (x: Smash.model.Carrier)(v: LeftFiber x)(w: RightFiber x) =>
    trans!{{TargetFiber x}} _ _ _
      (congr!{{LeftDistribution.TargetFiber x} {TargetFiber x}}
        (\fun (z: LeftDistribution.TargetFiber x) => (Shuffle.forward.fiber x).apply (((LastFlip.forward UpperIdentity.isomorphism LowerFlip.isomorphism).fiber x).apply (((Rows.forward Upper.isomorphism Lower.isomorphism).fiber x).apply z))) _ _
        (LeftDistribution.onPure x v w))
      (congr!{{Rows.TargetFiber x} {TargetFiber x}}
        (\fun (z: Rows.TargetFiber x) => (Shuffle.forward.fiber x).apply (((LastFlip.forward UpperIdentity.isomorphism LowerFlip.isomorphism).fiber x).apply z)) _ _
        (P.Prop[A := Upper.TargetFiber x, B := Lower.TargetFiber x].pairCong _ _ _ _
          (Upper.forwardOnPure x (P.first (F0 (Smash.first x)) (F1 (Smash.first x)) v) w)
          (Lower.forwardOnPure x (P.second (F0 (Smash.first x)) (F1 (Smash.first x)) v) w)));

\module Grading;
