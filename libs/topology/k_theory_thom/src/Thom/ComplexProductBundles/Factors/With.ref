
\import Triples.With[alpha := alpha] \as Triple;
\import Pair.FromBundles[F := Even, G := Odd, source := evenBundle, target := oddBundle,
  sourceSame := (\refl(Smash.topology)), targetSame := (\refl(Smash.topology))] \as Represent;
\import Pair.Group[] \as Group;
\import Group.Forget[] \as Forget;
\import Pair.ForgetProjection[] \as Projection;
\import Relative.PairIteration[pair := Smash.pair].Sequence[degree := N.Nat^::zero] \as Term;
\definition value: Result.Carrier := Triple.reduced;
\definition toProjection: \forall (q: Result.Carrier) -> \root.Thom[].ComplexProduct[left := left, right := right].ordinaryForget q = Projection.projectionPull q := Term.forgetFormula;
\definition actualDifference: ProductK.Carrier := ProductK.difference EvenSum.value OddSum.value;
\module Using(result: Represent.Result[alpha]);
\definition ordinary: \root.Thom[].ComplexProduct[left := left, right := right].ordinaryForget value = Parity.difference := \block {
  \takefrom result: Represent.Result[alpha] \by Represent.existence alpha \then
  \return Using[result := result].equation
};
\module Of(a: First.Carrier, b: Second.Carrier,
  firstAgreement: \root.Thom[].ComplexProduct[left := left, right := right].ordinaryFirst a = FirstTheory.K0[].difference firstEven firstOdd,
  secondAgreement: \root.Thom[].ComplexProduct[left := left, right := right].ordinarySecond b = SecondTheory.K0[].difference secondEven secondOdd);
