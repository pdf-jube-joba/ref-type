\import topology.Topology[Carrier := X] \as Base;
\import \root.Thom[].ComplexProductParity[X := X, F0 := E0, F1 := E1, G0 := F0, G1 := F1,
  e0 := e0, e1 := e1, f0 := f0, f1 := f1, sameE1 := sameE1, sameF0 := sameF0, sameF1 := sameF1] \as Source;
\import \root.Thom[].ComplexProductParity[X := X, F0 := A0, F1 := A1, G0 := B0, G1 := B1,
  e0 := a0, e1 := a1, f0 := b0, f1 := b1, sameE1 := sameA1, sameF0 := sameB0, sameF1 := sameB1] \as Target;
\definition f0f1: f0.baseSpace = f1.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameF0) sameF1;
\definition b0b1: b0.baseSpace = b1.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameB0) sameB1;
\import Operations.DirectSumIsomorphisms[X := X, F := E0, G := E1, A := A0, B := A1,
  first := e0, second := e1, newFirst := a0, newSecond := a1, sameSource := sameE1, sameTarget := sameA1] \as First;
\definition firstIso: Bundles.Isomorphisms[X := X, F := Source.LeftFiber, G := Target.LeftFiber, source := Source.leftBundle, target := Target.leftBundle].Isomorphism := First.isomorphism alpha0 alpha1;
\import Operations.DirectSumIsomorphisms[X := X, F := F0, G := F1, A := B0, B := B1,
  first := f0, second := f1, newFirst := b0, newSecond := b1, sameSource := f0f1, sameTarget := b0b1] \as Second;
\definition secondIso: Bundles.Isomorphisms[X := X, F := Source.RightFiber, G := Target.RightFiber, source := Source.rightBundle, target := Target.rightBundle].Isomorphism := Second.isomorphism beta0 beta1;
\import Operations.TensorIsomorphisms[X := X, F := Source.LeftFiber, G := Source.RightFiber, A := Target.LeftFiber, B := Target.RightFiber,
  first := Source.leftBundle, second := Source.rightBundle, newFirst := Target.leftBundle, newSecond := Target.rightBundle,
  sameSource := sameF0, sameTarget := sameB0] \as Tensor;
\definition fullIso: Bundles.Isomorphisms[X := X, F := Source.SourceFiber, G := Target.SourceFiber, source := Source.sourceBundle, target := Target.sourceBundle].Isomorphism := Tensor.isomorphism firstIso secondIso;
\import Operations.TensorIsomorphisms[X := X, F := E0, G := F0, A := A0, B := B0,
  first := e0, second := f0, newFirst := a0, newSecond := b0, sameSource := sameF0, sameTarget := sameB0] \as EE;
\definition eeIso: Bundles.Isomorphisms[X := X, F := Source.EEFiber, G := Target.EEFiber, source := Source.eeBundle, target := Target.eeBundle].Isomorphism := EE.isomorphism alpha0 beta0;
\definition sourceOO: e1.baseSpace = f1.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameE1) sameF1;
\definition targetOO: a1.baseSpace = b1.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameA1) sameB1;
\import Operations.TensorIsomorphisms[X := X, F := E1, G := F1, A := A1, B := B1,
  first := e1, second := f1, newFirst := a1, newSecond := b1, sameSource := sourceOO, sameTarget := targetOO] \as OO;
\definition ooIso: Bundles.Isomorphisms[X := X, F := Source.OOFiber, G := Target.OOFiber, source := Source.ooBundle, target := Target.ooBundle].Isomorphism := OO.isomorphism alpha1 beta1;
\import Operations.TensorIsomorphisms[X := X, F := E0, G := F1, A := A0, B := B1,
  first := e0, second := f1, newFirst := a0, newSecond := b1, sameSource := sameF1, sameTarget := sameB1] \as EO;
\definition eoIso: Bundles.Isomorphisms[X := X, F := Source.EOFiber, G := Target.EOFiber, source := Source.eoBundle, target := Target.eoBundle].Isomorphism := EO.isomorphism alpha0 beta1;
\definition sourceOE: e1.baseSpace = f0.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameE1) sameF0;
\definition targetOE: a1.baseSpace = b0.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameA1) sameB0;
\import Operations.TensorIsomorphisms[X := X, F := E1, G := F0, A := A1, B := B0,
  first := e1, second := f0, newFirst := a1, newSecond := b0, sameSource := sourceOE, sameTarget := targetOE] \as OE;
\definition oeIso: Bundles.Isomorphisms[X := X, F := Source.OEFiber, G := Target.OEFiber, source := Source.oeBundle, target := Target.oeBundle].Isomorphism := OE.isomorphism alpha1 beta0;
\import Operations.DirectSumIsomorphisms[X := X, F := Source.EEFiber, G := Source.OOFiber, A := Target.EEFiber, B := Target.OOFiber,
  first := Source.eeBundle, second := Source.ooBundle, newFirst := Target.eeBundle, newSecond := Target.ooBundle,
  sameSource := sameE1, sameTarget := sameA1] \as Even;
\definition evenIso: Bundles.Isomorphisms[X := X, F := Source.Even, G := Target.Even, source := Source.evenBundle, target := Target.evenBundle].Isomorphism := Even.isomorphism eeIso ooIso;
\import Operations.DirectSumIsomorphisms[X := X, F := Source.EOFiber, G := Source.OEFiber, A := Target.EOFiber, B := Target.OEFiber,
  first := Source.eoBundle, second := Source.oeBundle, newFirst := Target.eoBundle, newSecond := Target.oeBundle,
  sameSource := sameE1, sameTarget := sameA1] \as Odd;
\definition oddIso: Bundles.Isomorphisms[X := X, F := Source.Odd, G := Target.Odd, source := Source.oddBundle, target := Target.oddBundle].Isomorphism := Odd.isomorphism eoIso oeIso;
\import Operations.DirectSumIsomorphisms[X := X, F := Source.Even, G := Source.Odd, A := Target.Even, B := Target.Odd,
  first := Source.evenBundle, second := Source.oddBundle, newFirst := Target.evenBundle, newSecond := Target.oddBundle,
  sameSource := (\refl(e0.baseSpace)), sameTarget := (\refl(a0.baseSpace))] \as Total;
\definition totalIso: Bundles.Isomorphisms[X := X, F := Source.TargetFiber, G := Target.TargetFiber, source := Source.targetBundle, target := Target.targetBundle].Isomorphism := Total.isomorphism evenIso oddIso;
\module At(x: X);
\definition commutes: \forall (x: X)(v: Source.SourceFiber x) ->
  (Target.isomorphism.forward.fiber x).apply ((fullIso.forward.fiber x).apply v) =
  (totalIso.forward.fiber x).apply ((Source.isomorphism.forward.fiber x).apply v) := \fun (x: X) => At[x := x].equation;

\import Bundles.Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Source.SourceFiber,
  source := Source.sourceBundle, target := Source.sourceBundle, f := (\fun (x: X) => x)] \as SourceOperatorMaps;
\import Bundles.Morphisms[X := X, Y := X, F := Target.SourceFiber, G := Target.SourceFiber,
  source := Target.sourceBundle, target := Target.sourceBundle, f := (\fun (x: X) => x)] \as TargetOperatorMaps;
\module Blocks(c: SourceOperatorMaps.Map, d: TargetOperatorMaps.Map,
  operatorCommutes: \forall (x: X)(v: Source.SourceFiber x) -> (fullIso.forward.fiber x).apply ((c.fiber x).apply v) =
    (d.fiber x).apply ((fullIso.forward.fiber x).apply v));

\module OddBlocks(c: SourceOperatorMaps.Map, d: TargetOperatorMaps.Map,
  operatorCommutes: \forall (x: X)(v: Source.SourceFiber x) -> (fullIso.forward.fiber x).apply ((c.fiber x).apply v) =
    (d.fiber x).apply ((fullIso.forward.fiber x).apply v));
