\import Operations.DirectSum[X := X, F := F, G := G, left := first, right := second] \as Sum;
\definition Fiber[x: X]: \Set := Sum.Fiber x;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Sum.bundle sameBase;
\import Bundles.Morphisms[X := X, Y := X, F := F, G := G, source := first, target := second, f := (\fun (x: X) => x)] \as Forward;
\import Bundles.Morphisms[X := X, Y := X, F := G, G := F, source := second, target := first, f := (\fun (x: X) => x)] \as Backward;
\module With(d: Forward.Map, e: Backward.Map);
