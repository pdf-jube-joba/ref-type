\import \root.Thom[].Algebra[V := F x, space := bundle.space x].Cartan[k := k, v := (bundle.space x).zero, ell := ell.value x] \as First;
\import \root.Thom[].Algebra[V := F x, space := bundle.space x].Cartan[k := N.Nat^::succ k, v := (bundle.space x).zero, ell := ell.value x] \as Second;
\definition equation: \forall (omega: Source.Fiber x) -> (Next.map.fiber x).apply ((map.fiber x).apply omega) =
  (Operations.Alternating[X := X, F := F, bundle := bundle, k := N.Nat^::succ (N.Nat^::succ k)].fiberSpace x).zero :=
  \fun (omega: Source.Fiber x) => trans!{{Operations.Alternating[X := X, F := F, bundle := bundle, k := N.Nat^::succ (N.Nat^::succ k)].Fiber x}} _ _ _
    (Next.At[x := x].formula ((map.fiber x).apply omega))
    (trans!{{Operations.Alternating[X := X, F := F, bundle := bundle, k := N.Nat^::succ (N.Nat^::succ k)].Fiber x}} _ _ _
      (congr!{{Target.Fiber x} {Operations.Alternating[X := X, F := F, bundle := bundle, k := N.Nat^::succ (N.Nat^::succ k)].Fiber x}} Second.wedge _ _
        (\root.Thom[].WedgeOne[X := X, F := F, bundle := bundle, ell := ell, k := k].At[x := x].formula omega))
      (First.Square[].equation omega));
