\import Operations.IsomorphismComposition[X := Y, F := Models.Fiber (pulledEven n).ranks,
  G := Models.Fiber (foldedEven n).ranks, H := Models.Fiber (targetEven n).ranks,
  source := Models.bundle (pulledEven n), middle := Models.bundle (foldedEven n), target := Models.bundle (targetEven n)] \as Even;
\import Operations.IsomorphismComposition[X := Y, F := Models.Fiber (pulledOdd n).ranks,
  G := Models.Fiber (foldedOdd n).ranks, H := Models.Fiber (targetOdd n).ranks,
  source := Models.bundle (pulledOdd n), middle := Models.bundle (foldedOdd n), target := Models.bundle (targetOdd n)] \as Odd;
\definition even: Finite.Iso (pulledEven n) (targetEven n) := Even.compose (rebase n).even (Comparison.value n).even;
\definition odd: Finite.Iso (pulledOdd n) (targetOdd n) := Odd.compose (rebase n).odd (Comparison.value n).odd;
\definition inclusion: \forall (y: Y)(v: SourceModels.Fiber (Coordinates.model n).ranks (map y)) ->
  (even.forward.fiber y).apply (((Fold.sourceParity n).inclusion.fiber (map y)).apply v) = ((Comparison.targetParity n).inclusion.fiber y).apply v :=
  \fun (y: Y)(v: SourceModels.Fiber (Coordinates.model n).ranks (map y)) => trans!{{Models.Fiber (targetEven n).ranks y}} _ _ _
    (congr!{{Models.Fiber (foldedEven n).ranks y} {Models.Fiber (targetEven n).ranks y}} ((Comparison.value n).even.forward.fiber y).apply _ _ ((rebase n).inclusion y v))
    ((Comparison.value n).inclusion y v);
\definition forward: \forall (y: Y)(v: SourceModels.Fiber (sourceEven n).ranks (map y)) ->
  ((Comparison.targetParity n).forward.fiber y).apply ((even.forward.fiber y).apply v) =
    (odd.forward.fiber y).apply (((Fold.sourceParity n).forward.fiber (map y)).apply v) :=
  \fun (y: Y)(v: SourceModels.Fiber (sourceEven n).ranks (map y)) => trans!{{Models.Fiber (targetOdd n).ranks y}} _ _ _
    ((Comparison.value n).forward y (((rebase n).even.forward.fiber y).apply v))
    (congr!{{Models.Fiber (foldedOdd n).ranks y} {Models.Fiber (targetOdd n).ranks y}} ((Comparison.value n).odd.forward.fiber y).apply _ _ ((rebase n).forward y v));
\definition backward: \forall (y: Y)(v: SourceModels.Fiber (sourceOdd n).ranks (map y)) ->
  ((Comparison.targetParity n).backward.fiber y).apply ((odd.forward.fiber y).apply v) =
    (even.forward.fiber y).apply (((Fold.sourceParity n).backward.fiber (map y)).apply v) :=
  \fun (y: Y)(v: SourceModels.Fiber (sourceOdd n).ranks (map y)) => trans!{{Models.Fiber (targetEven n).ranks y}} _ _ _
    ((Comparison.value n).backward y (((rebase n).odd.forward.fiber y).apply v))
    (congr!{{Models.Fiber (foldedEven n).ranks y} {Models.Fiber (targetEven n).ranks y}} ((Comparison.value n).even.forward.fiber y).apply _ _ ((rebase n).backward y v));
