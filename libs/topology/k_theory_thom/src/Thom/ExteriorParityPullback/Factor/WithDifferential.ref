\import \root.Thom[].Finite[X := Y, baseSpace := source] \as Finite;
\definition identity[k: N.Nat^]: Finite.Iso (term k) (term k) := Bundles.Isomorphisms[X := Y,
  F := Models.Fiber (term k).ranks, G := Models.Fiber (term k).ranks, source := Models.bundle (term k), target := Models.bundle (term k)].Isomorphism {
    forward := Models.identity (term k), backward := Models.identity (term k),
    leftInverse := \fun (y: Y)(v: Models.Fiber (term k).ranks y) => \refl(v), rightInverse := \fun (y: Y)(v: Models.Fiber (term k).ranks y) => \refl(v)
  };
\import Finite.Family[term := term, differential := differential, domain := { y: Y \where Logic.False }]
  .Comparison[targetTerm := term, targetDifferential := targetDifferential, isomorphism := identity, commutes := commutes] \as Comparison;
\definition targetEven[n: N.Nat^]: Models.Bundle := (Comparison.targetParity n).even;
\definition targetOdd[n: N.Nat^]: Models.Bundle := (Comparison.targetParity n).odd;
\definition targetForward[n: N.Nat^]: Models.Map (targetEven n) (targetOdd n) := (Comparison.targetParity n).forward;
\definition targetBackward[n: N.Nat^]: Models.Map (targetOdd n) (targetEven n) := (Comparison.targetParity n).backward;
\module At(n: N.Nat^);
