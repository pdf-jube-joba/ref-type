\definition equation: \forall (y: Y)(v: Models.Fiber (term (N.Nat^::succ k)).ranks y) ->
  ((choice k).isomorphism.forward.fiber y).apply
    ((\root.Thom[].Contraction[X := Y, F := Fiber, bundle := bundle, section := section, k := k].map.fiber y).apply
      (((choice (N.Nat^::succ k)).isomorphism.backward.fiber y).apply v)) = ((differential k).fiber y).apply v :=
  \fun (y: Y)(v: Models.Fiber (term (N.Nat^::succ k)).ranks y) => \refl(((differential k).fiber y).apply v);
