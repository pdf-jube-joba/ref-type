\import FirstComparison.At[n := n] \as FirstFold;
\import SecondComparison.At[n := m] \as SecondFold;
\import \root.Thom[].Finite[X := Y, baseSpace := source] \as Finite;
\definition firstEven: Finite.Iso (First.pulledEven n) (FirstComparison.targetEven n) := FirstFold.even;
\definition firstOdd: Finite.Iso (First.pulledOdd n) (FirstComparison.targetOdd n) := FirstFold.odd;
\definition secondEven: Finite.Iso (Second.pulledEven m) (SecondComparison.targetEven m) := SecondFold.even;
\definition secondOdd: Finite.Iso (Second.pulledOdd m) (SecondComparison.targetOdd m) := SecondFold.odd;
\definition firstForward: \forall (y: Y)(v: Models.Fiber (First.pulledEven n).ranks y) ->
  ((FirstComparison.targetForward n).fiber y).apply ((firstEven.forward.fiber y).apply v) =
  (firstOdd.forward.fiber y).apply (((First.sourceForward n).fiber (f y)).apply v) := FirstFold.forward;
\definition firstBackward: \forall (y: Y)(v: Models.Fiber (First.pulledOdd n).ranks y) ->
  ((FirstComparison.targetBackward n).fiber y).apply ((firstOdd.forward.fiber y).apply v) =
  (firstEven.forward.fiber y).apply (((First.sourceBackward n).fiber (f y)).apply v) := FirstFold.backward;
\definition secondForward: \forall (y: Y)(v: Models.Fiber (Second.pulledEven m).ranks y) ->
  ((SecondComparison.targetForward m).fiber y).apply ((secondEven.forward.fiber y).apply v) =
  (secondOdd.forward.fiber y).apply (((Second.sourceForward m).fiber (g y)).apply v) := SecondFold.forward;
\definition secondBackward: \forall (y: Y)(v: Models.Fiber (Second.pulledOdd m).ranks y) ->
  ((SecondComparison.targetBackward m).fiber y).apply ((secondOdd.forward.fiber y).apply v) =
  (secondEven.forward.fiber y).apply (((Second.sourceBackward m).fiber (g y)).apply v) := SecondFold.backward;
