\definition data: Parity.Data := Parity.Data { first := firstChoice, second := secondChoice, total := totalSelection };
\import Parity.With[data := data].Along[firstSection := First.section, secondSection := Second.section] \as Exterior;
\definition firstCommutes: \forall (k: N.Nat^)(y: Y)(v: Models.Fiber (First.term (N.Nat^::succ k)).ranks y) ->
  ((Exterior.firstDifferential k).fiber y).apply v = ((First.differential k).fiber y).apply v := First.contractionFormula;
\definition secondCommutes: \forall (k: N.Nat^)(y: Y)(v: Models.Fiber (Second.term (N.Nat^::succ k)).ranks y) ->
  ((Exterior.secondDifferential k).fiber y).apply v = ((Second.differential k).fiber y).apply v := Second.contractionFormula;
\import First.WithDifferential[targetDifferential := Exterior.firstDifferential, commutes := firstCommutes] \as FirstComparison;
\import Second.WithDifferential[targetDifferential := Exterior.secondDifferential, commutes := secondCommutes] \as SecondComparison;
\definition firstEvenModel[n: N.Nat^]: Models.Bundle := FirstComparison.targetEven n;
\definition firstOddModel[n: N.Nat^]: Models.Bundle := FirstComparison.targetOdd n;
\definition secondEvenModel[n: N.Nat^]: Models.Bundle := SecondComparison.targetEven n;
\definition secondOddModel[n: N.Nat^]: Models.Bundle := SecondComparison.targetOdd n;
\definition firstD[n: N.Nat^]: Models.Map (firstEvenModel n) (firstOddModel n) := FirstComparison.targetForward n;
\definition firstE[n: N.Nat^]: Models.Map (firstOddModel n) (firstEvenModel n) := FirstComparison.targetBackward n;
\definition secondD[n: N.Nat^]: Models.Map (secondEvenModel n) (secondOddModel n) := SecondComparison.targetForward n;
\definition secondE[n: N.Nat^]: Models.Map (secondOddModel n) (secondEvenModel n) := SecondComparison.targetBackward n;
\module At(n, m: N.Nat^);
