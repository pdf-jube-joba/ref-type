\import \root.Thom[].Finite[X := X, baseSpace := left.baseSpace].Family[term := model, differential := differential, domain := domain] \as Family;
\import Family.Comparison[targetTerm := formModel, targetDifferential := formDifferential, isomorphism := isomorphism, commutes := commutes] \as Comparison;
