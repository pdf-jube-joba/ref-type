\import Bundles.Morphisms[X := X, Y := X, F := FormVector (N.Nat^::succ k), G := Form (N.Nat^::succ k),
  source := Models.bundle (formModel (N.Nat^::succ k)), target := forms (N.Nat^::succ k), f := \fun (p: X) => p] \as First;
\import First.Composition[Z := X, H := Form k, range := forms k, g := \fun (p: X) => p] \as Middle;
\definition middle: Bundles.Morphisms[X := X, Y := X, F := FormVector (N.Nat^::succ k), G := Form k,
  source := Models.bundle (formModel (N.Nat^::succ k)), target := forms k, f := \fun (p: X) => p].Map :=
  Middle.compose (selection (N.Nat^::succ k)).second.isomorphism.backward
    (\root.Thom[].Contraction[X := X, F := Sum.Fiber, bundle := sum, section := section, k := k].map);
\import Bundles.Morphisms[X := X, Y := X, F := FormVector (N.Nat^::succ k), G := Form k,
  source := Models.bundle (formModel (N.Nat^::succ k)), target := forms k, f := \fun (p: X) => p]
  .Composition[Z := X, H := FormVector k, range := Models.bundle (formModel k), g := \fun (p: X) => p] \as Last;
\definition map: Models.Map (formModel (N.Nat^::succ k)) (formModel k) :=
  Last.compose middle (selection k).second.isomorphism.forward;
