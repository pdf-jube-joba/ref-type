\definition zero: \forall (x: X)(v: Vector n x) -> v = ((Models.bundle (model n)).space x).zero :=
  \fun (x: X)(v: Vector n x) => trans!{{Vector n x}} _ _ _
    (sym!{{Vector n x}} _ _ ((selection n).first.isomorphism.rightInverse x v))
    (trans!{{Vector n x}} _ _ _ (congr!{{Term n x} {Vector n x}} (encode n x).apply _ _ (zeroAbove x ((decode n x).apply v))) (encode n x).preservesZero);
\import Construction.At[n := n, zeroAbove := zero] \as Result;
\definition complex: Operations.Models[X := X, baseSpace := left.baseSpace].Chains[].Complex := Result.value;
\definition exactAt: \forall (x: X) -> \In[X] domain x -> Operations.Models[X := X, baseSpace := left.baseSpace].Chains[].Of[complex := complex].ExactAt x := Result.exactAt;
