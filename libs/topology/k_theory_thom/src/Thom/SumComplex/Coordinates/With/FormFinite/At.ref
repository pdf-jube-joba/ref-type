\definition zero: \forall (x: X)(v: FormVector n x) -> v = ((Models.bundle (formModel n)).space x).zero :=
  \fun (x: X)(v: FormVector n x) => trans!{{FormVector n x}} _ _ _
    (sym!{{FormVector n x}} _ _ ((selection n).second.isomorphism.rightInverse x v))
    (trans!{{FormVector n x}} _ _ _ (congr!{{Form n x} {FormVector n x}} (encodeForm n x).apply _ _ (zeroAbove x ((decodeForm n x).apply v))) (encodeForm n x).preservesZero);
\import Construction.At[n := n, zeroAbove := zero] \as Result;
\definition complex: Operations.Models[X := X, baseSpace := left.baseSpace].Chains[].Complex := Result.value;
\definition exactAt: \forall (x: X) -> \In[X] domain x -> Operations.Models[X := X, baseSpace := left.baseSpace].Chains[].Of[complex := complex].ExactAt x := Result.exactAt;
