\definition sourceZero: \forall (x: X)(omega: Term n x) -> omega = ((term n).space x).zero :=
  \fun (x: X)(omega: Term n x) => \root.Thom[].SumBundles[X := X, F := F, G := G, left := left, right := right, sameBase := sameBase, k := n].At[x := x].injective _ _
    (trans!{{Form n x}} _ _ _ (zeroAbove x (((comparison n).forward.fiber x).apply omega))
      (sym!{{Form n x}} _ _ (((comparison n).forward.fiber x).preservesZero)));
\import \parent.Finite[] \as FirstFamily;
\import FirstFamily.At[n := n, zeroAbove := sourceZero] \as First;
\import \parent.FormFinite[].At[n := n, zeroAbove := zeroAbove] \as Second;
\import \parent.Fold[domain := FirstFamily.domain] \as Fold;
\import \root.Thom[].ComplexProductChange[X := X, space := left.baseSpace, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed, first := First.complex, second := Second.complex].With[
    positive := (Fold.value n).even, negative := (Fold.value n).odd,
    forwardCommutes := (Fold.value n).forward, backwardCommutes := (Fold.value n).backward] \as Change;
\import relative_k_theory.Relative[].Pair[X := X, space := left.baseSpace, compact := compact, hausdorff := hausdorff, subset := subset, closed := closed] \as Pair;
\import \root.Thom[].RelativeComplex[X := X, space := left.baseSpace, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed, complex := First.complex] \as FirstRelative;
\import \root.Thom[].RelativeComplex[X := X, space := left.baseSpace, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed, complex := Second.complex] \as SecondRelative;
\definition firstExact: FirstRelative.Exact := \fun (x: Pair.A) => First.exactAt x (nonzero x (\bysub(X, subset, x)));
\definition secondExact: SecondRelative.Exact := \fun (x: Pair.A) => Second.exactAt x (nonzero x (\bysub(X, subset, x)));
\definition equation: FirstRelative.Supported[exact := firstExact].value = SecondRelative.Supported[exact := secondExact].value :=
  Change.equation firstExact secondExact;
