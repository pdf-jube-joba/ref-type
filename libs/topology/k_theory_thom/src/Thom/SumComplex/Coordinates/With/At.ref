\import Bundles.Isomorphisms[X := X, F := Term k, G := Vector k, source := term k, target := Models.bundle (model k)] \as Reverse;
\import Operations.IsomorphismComposition[X := X, F := Vector k, G := Term k, H := Form k,
  source := Models.bundle (model k), middle := term k, target := forms k] \as FirstComposition;
\definition middle: Bundles.Isomorphisms[X := X, F := Vector k, G := Form k,
  source := Models.bundle (model k), target := forms k].Isomorphism :=
  FirstComposition.compose (Reverse.inverse (selection k).first.isomorphism) (comparison k);
\import Operations.IsomorphismComposition[X := X, F := Vector k, G := Form k, H := FormVector k,
  source := Models.bundle (model k), middle := forms k, target := Models.bundle (formModel k)] \as SecondComposition;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Vector k, G := FormVector k,
  source := Models.bundle (model k), target := Models.bundle (formModel k)].Isomorphism :=
  SecondComposition.compose middle (selection k).second.isomorphism;
