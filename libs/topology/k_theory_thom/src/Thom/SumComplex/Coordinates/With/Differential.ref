\import Bundles.Morphisms[X := X, Y := X, F := Vector (N.Nat^::succ k), G := Term (N.Nat^::succ k),
  source := Models.bundle (model (N.Nat^::succ k)), target := term (N.Nat^::succ k), f := \fun (p: X) => p] \as First;
\import First.Composition[Z := X, H := Term k, range := term k, g := \fun (p: X) => p] \as Middle;
\definition middle: Bundles.Morphisms[X := X, Y := X, F := Vector (N.Nat^::succ k), G := Term k,
  source := Models.bundle (model (N.Nat^::succ k)), target := term k, f := \fun (p: X) => p].Map :=
  Middle.compose (selection (N.Nat^::succ k)).first.isomorphism.backward
    (\root.Thom[].SumComplex[X := X, F := F, G := G, left := left, right := right, sameBase := sameBase, firstSection := firstSection, secondSection := secondSection].Degree[k := k].differential);
\import Bundles.Morphisms[X := X, Y := X, F := Vector (N.Nat^::succ k), G := Term k,
  source := Models.bundle (model (N.Nat^::succ k)), target := term k, f := \fun (p: X) => p]
  .Composition[Z := X, H := Vector k, range := Models.bundle (model k), g := \fun (p: X) => p] \as Last;
\definition map: Models.Map (model (N.Nat^::succ k)) (model k) :=
  Last.compose middle (selection k).first.isomorphism.forward;
