\import Operations.Models[X := X, baseSpace := left.baseSpace] \as Models;
\structure Choice[k: N.Nat^]: \Set := {
  first: Models.From[F := Term k, original := term k].Result,
  second: Models.From[F := Form k, original := forms k].Result
};
\definition existence: \forall (k: N.Nat^) -> \exists Choice[k] := \block {
  \fun (k: N.Nat^) \then
  \takefrom first: Models.From[F := Term k, original := term k].Result \by Models.From[F := Term k, original := term k].existence (\refl(left.baseSpace)) \then
  \takefrom second: Models.From[F := Form k, original := forms k].Result \by Models.From[F := Form k, original := forms k].existence (\refl(left.baseSpace)) \then
  \return \exact(Choice[k] { first := first, second := second }, Choice[k])
};
\definition selections: \exists (\forall (k: N.Nat^) -> Choice[k]) := \axiom:classicalIndefiniteChoice(N.Nat^, (\fun (k: N.Nat^) => Choice[k]), existence);
\module With(selection: \forall (k: N.Nat^) -> Choice[k]);
