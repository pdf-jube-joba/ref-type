\import \root.Thom[].Sum[V := F x, W := G x, left := left.space x, right := right.space x] \as Algebra;
\import Algebra.DirectSum[k := degree] \as Direct;
\import Algebra.At[p := p, q := q] \as Product;
\import Spaces.Exterior[V := F x, space := left.space x] \as LeftForms;
\import Spaces.Exterior[V := G x, space := right.space x] \as RightForms;
\definition index: Direct.Bidegree := Direct.make p q (\refl(degree));
\import Direct.Component[d := index] \as Factor;
\import Direct.At[d := index] \as Inclusion;
\definition pure[omega: LeftForms.Form p][eta: RightForms.Form q]: Term degree x := Inclusion.injection.apply (Factor.product omega eta);
\definition equation: \forall (omega: LeftForms.Form p)(eta: RightForms.Form q) -> Direct.forward.apply (pure omega eta) = Product.apply omega eta :=
  \fun (omega: LeftForms.Form p)(eta: RightForms.Form q) => trans!{{Form degree x}} _ _ _
    (Inclusion.onInjection (Factor.product omega eta))
    (trans!{{Form degree x}} _ _ _
      (congr!{{Form degree x} {Form degree x}}
        (\fun (a: Form degree x) => Spaces.Exterior[V := Sum.Fiber x, space := sum.space x].Regrade[k := degree, l := degree].cast a (\refl(degree))) _ _
        (Product.onTensor omega eta))
      (Algebra.castSame degree (Product.apply omega eta)));
