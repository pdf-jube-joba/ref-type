\import SourcePure.At[x := x] \as Source;
\import TargetPure.At[x := x] \as Target;
\import \root.Thom[].Sum[V := F x, W := G x, left := left.space x, right := right.space x].LeibnizLeftZero[q := q] \as Law;
\import Spaces.Exterior[V := F x, space := left.space x] \as LeftForms;
\import Spaces.Exterior[V := G x, space := right.space x] \as RightForms;
\definition equation: \forall (omega: LeftForms.Form N.Nat^::zero)(eta: RightForms.Form (N.Nat^::succ q)) ->
  (Boundary.differential.fiber x).apply (Source.pure omega eta) =
    Target.pure omega (Spaces.Multilinear[V := G x, space := right.space x].Alternating[].Contraction[k := q].apply eta (secondSection.value x)) :=
  \fun (omega: LeftForms.Form N.Nat^::zero)(eta: RightForms.Form (N.Nat^::succ q)) =>
    \root.Thom[].SumBundles[X := X, F := F, G := G, left := left, right := right, sameBase := sameBase, k := outputDegree].At[x := x].injective _ _
      (trans!{{Form outputDegree x}} _ _ _ (Boundary.chain x (Source.pure omega eta))
        (trans!{{Form outputDegree x}} _ _ _
          (congr!{{Form (N.Nat^::succ outputDegree) x} {Form outputDegree x}}
            (\root.Thom[].Contraction[X := X, F := Sum.Fiber, bundle := sum, section := section, k := outputDegree].map.fiber x).apply _ _ (Source.equation omega eta))
          (trans!{{Form outputDegree x}} _ _ _ (Law.equation omega eta (firstSection.value x) (secondSection.value x))
            (sym!{{Form outputDegree x}} _ _ (Target.equation omega
              (Spaces.Multilinear[V := G x, space := right.space x].Alternating[].Contraction[k := q].apply eta (secondSection.value x)))))));
