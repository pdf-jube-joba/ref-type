\import \parent.\parent.Degree[k := k] \as Boundary;
\import Algebra.Exact[k := k, v := section.value x, ell := ell, normalized := normalized] \as Exact;
\definition primitive[omega: Term k x]: Term (N.Nat^::succ k) x :=
  ((comparison (N.Nat^::succ k)).backward.fiber x).apply (Exact.primitive (((comparison k).forward.fiber x).apply omega));
\definition equation: \forall (omega: Term k x) -> Closed k omega -> (Boundary.differential.fiber x).apply (primitive omega) = omega :=
  \fun (omega: Term k x)(closed: Closed k omega) =>
    \root.Thom[].SumBundles[X := X, F := F, G := G, left := left, right := right, sameBase := sameBase, k := k].At[x := x].injective _ _
      (trans!{{Form k x}} _ _ _ (Boundary.chain x (primitive omega))
        (trans!{{Form k x}} _ _ _
          (congr!{{Form (N.Nat^::succ k) x} {Form k x}}
            (\root.Thom[].Contraction[X := X, F := Sum.Fiber, bundle := sum, section := section, k := k].map.fiber x).apply _ _
            ((\bysub(Bundles.Isomorphisms[X := X, F := Term (N.Nat^::succ k), G := Form (N.Nat^::succ k), source := term (N.Nat^::succ k), target := forms (N.Nat^::succ k)].Data,
              Bundles.Isomorphisms[X := X, F := Term (N.Nat^::succ k), G := Form (N.Nat^::succ k), source := term (N.Nat^::succ k), target := forms (N.Nat^::succ k)].Isomorphism,
              comparison (N.Nat^::succ k))).rightInverse x (Exact.primitive (((comparison k).forward.fiber x).apply omega))))
          (Exact.equation (((comparison k).forward.fiber x).apply omega) closed)));
