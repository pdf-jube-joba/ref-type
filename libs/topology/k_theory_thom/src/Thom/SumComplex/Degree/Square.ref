\import \parent.\parent.Degree[k := N.Nat^::succ k] \as Next;
\definition equation: \forall (x: X)(omega: Term (N.Nat^::succ (N.Nat^::succ k)) x) ->
  (differential.fiber x).apply ((Next.differential.fiber x).apply omega) = ((term k).space x).zero :=
  \fun (x: X)(omega: Term (N.Nat^::succ (N.Nat^::succ k)) x) =>
    \root.Thom[].SumBundles[X := X, F := F, G := G, left := left, right := right, sameBase := sameBase, k := k].At[x := x].injective _ _
      (trans!{{Form k x}} _ _ _ (chain x ((Next.differential.fiber x).apply omega))
        (trans!{{Form k x}} _ _ _
          (congr!{{Form (N.Nat^::succ k) x} {Form k x}} (Contraction.map.fiber x).apply _ _ (Next.chain x omega))
          (trans!{{Form k x}} _ _ _
            (Contraction.squareZero x (((comparison (N.Nat^::succ (N.Nat^::succ k))).forward.fiber x).apply omega))
            (sym!{{Form k x}} _ _ (((comparison k).forward.fiber x).preservesZero)))));
