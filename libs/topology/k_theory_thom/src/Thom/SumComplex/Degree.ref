\import \root.Thom[].Contraction[X := X, F := Sum.Fiber, bundle := sum, section := section, k := k] \as Contraction;
\import Bundles.Morphisms[X := X, Y := X, F := Term (N.Nat^::succ k), G := Form (N.Nat^::succ k),
  source := term (N.Nat^::succ k), target := forms (N.Nat^::succ k), f := \fun (x: X) => x].Composition[
  Z := X, H := Form k, range := forms k, g := \fun (x: X) => x] \as FirstComposition;
\definition toForms: Bundles.Morphisms[X := X, Y := X, F := Term (N.Nat^::succ k), G := Form k,
  source := term (N.Nat^::succ k), target := forms k, f := \fun (x: X) => x].Map :=
  FirstComposition.compose (comparison (N.Nat^::succ k)).forward Contraction.map;
\import Bundles.Morphisms[X := X, Y := X, F := Term (N.Nat^::succ k), G := Form k,
  source := term (N.Nat^::succ k), target := forms k, f := \fun (x: X) => x].Composition[
  Z := X, H := Term k, range := term k, g := \fun (x: X) => x] \as SecondComposition;
\import Bundles.Morphisms[X := X, Y := X, F := Term (N.Nat^::succ k), G := Term k,
  source := term (N.Nat^::succ k), target := term k, f := \fun (x: X) => x] \as Maps;
\definition differential: Maps.Map := SecondComposition.compose toForms (comparison k).backward;
\definition chain: \forall (x: X)(omega: Term (N.Nat^::succ k) x) ->
  ((comparison k).forward.fiber x).apply ((differential.fiber x).apply omega) =
    (Contraction.map.fiber x).apply (((comparison (N.Nat^::succ k)).forward.fiber x).apply omega) :=
  \fun (x: X)(omega: Term (N.Nat^::succ k) x) =>
    (\bysub(Bundles.Isomorphisms[X := X, F := Term k, G := Form k, source := term k, target := forms k].Data,
      Bundles.Isomorphisms[X := X, F := Term k, G := Form k, source := term k, target := forms k].Isomorphism, comparison k)).rightInverse x
        ((Contraction.map.fiber x).apply (((comparison (N.Nat^::succ k)).forward.fiber x).apply omega));
\module Square;
