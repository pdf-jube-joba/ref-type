
\import relative_k_theory.Relative[] \as Relative;
\import Relative.Smash[left := left, right := right] \as Smash;
\import Smash.External[] \as External;
\import Relative.Reduced[model := left] \as First;
\import Relative.Reduced[model := right] \as Second;
\import Relative.Reduced[model := Smash.result] \as Result;
\import topological_k_theory.KTheory[].On[X := left.Carrier, baseSpace := (Relative.details left).topology,
  compact := (Relative.details left).compact, hausdorff := (Relative.details left).hausdorff] \as FirstTheory;
\import topological_k_theory.KTheory[].On[X := right.Carrier, baseSpace := (Relative.details right).topology,
  compact := (Relative.details right).compact, hausdorff := (Relative.details right).hausdorff] \as SecondTheory;
\import topological_k_theory.KTheory[].On[X := Smash.model.Carrier, baseSpace := Smash.topology,
  compact := Smash.compact, hausdorff := Smash.hausdorff] \as ProductTheory;
\import ProductTheory.K0[] \as ProductK;
\import ProductTheory.Semiring[] \as Ring;
\import topological_constructions.Product[A := left.Carrier, B := right.Carrier].Maps[] \as Projections;
\import FirstTheory.Pullback[Y := Smash.model.Carrier, space := Smash.topology, sourceCompact := Smash.compact, sourceHausdorff := Smash.hausdorff,
  f := Smash.first, regular := Projections.firstContinuous (Relative.details left).topology (Relative.details right).topology] \as FirstPull;
\import SecondTheory.Pullback[Y := Smash.model.Carrier, space := Smash.topology, sourceCompact := Smash.compact, sourceHausdorff := Smash.hausdorff,
  f := Smash.second, regular := Projections.secondContinuous (Relative.details left).topology (Relative.details right).topology] \as SecondPull;
\import Relative.Pair[X := Smash.model.Carrier, space := Smash.topology, compact := Smash.compact, hausdorff := Smash.hausdorff,
  subset := Smash.wedge, closed := Smash.wedgeClosed] \as Pair;
\module Factors(F0, F1: left.Carrier -> \Set, G0, G1: right.Carrier -> \Set,
  e0: Bundles.Family[X := left.Carrier, F := F0].Bundle, e1: Bundles.Family[X := left.Carrier, F := F1].Bundle,
  f0: Bundles.Family[X := right.Carrier, F := G0].Bundle, f1: Bundles.Family[X := right.Carrier, F := G1].Bundle,
  e0Same: e0.baseSpace = (Relative.details left).topology, e1Same: e1.baseSpace = (Relative.details left).topology,
  f0Same: f0.baseSpace = (Relative.details right).topology, f1Same: f1.baseSpace = (Relative.details right).topology);
