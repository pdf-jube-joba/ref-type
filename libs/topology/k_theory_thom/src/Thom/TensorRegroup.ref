\import \root.Thom[].ComplexProductDistribution[X := X, F := F, G := G, H := H,
  first := first, second := second, third := third, sameSecond := sameSecond, sameThird := sameThird] \as Distribution;
\definition SourceFiber[x: X]: \Set := Distribution.SourceFiber x;
\definition TargetFiber[x: X]: \Set := Distribution.TargetFiber x;
\definition sourceBundle: Bundles.Family[X := X, F := SourceFiber].Bundle := Distribution.sourceBundle;
\definition targetBundle: Bundles.Family[X := X, F := TargetFiber].Bundle := Distribution.targetBundle;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := SourceFiber, G := TargetFiber, source := sourceBundle, target := targetBundle].Isomorphism := Distribution.isomorphism;
\import Bundles.Morphisms[X := X, Y := X, F := F, G := F, source := first, target := first, f := (\fun (x: X) => x)] \as FirstMaps;
\import Bundles.Morphisms[X := X, Y := X, F := G, G := G, source := second, target := second, f := (\fun (x: X) => x)] \as SecondMaps;
\import Bundles.Morphisms[X := X, Y := X, F := H, G := H, source := third, target := third, f := (\fun (x: X) => x)] \as ThirdMaps;
\module With(a: FirstMaps.Map, b: SecondMaps.Map, c: ThirdMaps.Map);

\module Operators(a: FirstMaps.Map, b: SecondMaps.Map, firstGrading: FirstMaps.Map, secondGrading: SecondMaps.Map, partner: ThirdMaps.Map);
