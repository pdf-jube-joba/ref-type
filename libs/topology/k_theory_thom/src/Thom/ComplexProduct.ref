\import relative_k_theory.Relative[] \as Relative;
\import Relative.Smash[left := left, right := right] \as Smash;
\import Smash.External[] \as External;
\import Relative.Reduced[model := left] \as First;
\import Relative.Reduced[model := right] \as Second;
\import Relative.Reduced[model := Smash.result] \as Result;
\import topological_k_theory.KTheory[].On[X := left.Carrier, baseSpace := (Relative.details left).topology,
  compact := (Relative.details left).compact, hausdorff := (Relative.details left).hausdorff] \as FirstTheory;
\import topological_k_theory.KTheory[].On[X := right.Carrier, baseSpace := (Relative.details right).topology,
  compact := (Relative.details right).compact, hausdorff := (Relative.details right).hausdorff] \as SecondTheory;
\import topological_k_theory.KTheory[].On[X := Smash.model.Carrier, baseSpace := (Relative.details Smash.model).topology,
  compact := (Relative.details Smash.model).compact, hausdorff := (Relative.details Smash.model).hausdorff] \as ProductTheory;
\import FirstTheory.K0[] \as FirstK;
\import SecondTheory.K0[] \as SecondK;
\import ProductTheory.K0[] \as ProductK;
\import ProductTheory.Semiring[] \as BundlesRing;
\definition ordinaryFirst[a: First.Carrier]: FirstK.Carrier := a;
\definition ordinarySecond[b: Second.Carrier]: SecondK.Carrier := b;
\definition ordinaryForget[q: Result.Carrier]: ProductK.Carrier := External.forget q;
\import Relative.Pullback[source := Smash.model, target := left, f := Smash.firstMap] \as FirstPull;
\import Relative.Pullback[source := Smash.model, target := right, f := Smash.secondMap] \as SecondPull;
\import topological_constructions.Product[A := left.Carrier, B := right.Carrier].Maps[] \as Projections;
\import FirstTheory.Pullback[Y := Smash.model.Carrier, space := (Relative.details Smash.model).topology,
  sourceCompact := (Relative.details Smash.model).compact, sourceHausdorff := (Relative.details Smash.model).hausdorff,
  f := Smash.first, regular := Projections.firstContinuous (Relative.details left).topology (Relative.details right).topology] \as FirstBundles;
\import SecondTheory.Pullback[Y := Smash.model.Carrier, space := (Relative.details Smash.model).topology,
  sourceCompact := (Relative.details Smash.model).compact, sourceHausdorff := (Relative.details Smash.model).hausdorff,
  f := Smash.second, regular := Projections.secondContinuous (Relative.details left).topology (Relative.details right).topology] \as SecondBundles;
\module Arithmetic;
\module Parity(firstEven, firstOdd: FirstTheory.Classes, secondEven, secondOdd: SecondTheory.Classes);
