\import Bundles.Family[X := X, F := F] \as Family;
\import Family.Of[bundle := bundle] \as Original;
\import Original.Pullback[Y := Y, source := source, f := f] \as Pullback;
\definition Fiber[y: Y]: \Set := F (f y);
\definition pulled: Bundles.Family[X := Y, F := Fiber].Bundle := Pullback.pulled regular;
\module Degree(k: N.Nat^);
\module WithSection(section: Original.Sections[].Section);
\module Koszul;
