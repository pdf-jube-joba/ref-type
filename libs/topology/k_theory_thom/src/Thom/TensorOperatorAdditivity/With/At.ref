\import Spaces.Tensor[V := F x, W := G x, left := first.space x, right := second.space x] \as Algebra;
\import Spaces.Laws[V := Tensor.Fiber x, space := bundle.space x] \as Laws;
\import Operations.TensorEquality[V := F x, W := G x, U := Tensor.Fiber x,
  left := first.space x, right := second.space x, target := bundle.space x] \as EqualityOnPure;
\definition pureEquation: \forall (v: F x)(w: G x) -> (combined.fiber x).apply (Tensor.pure x v w) = (sum.fiber x).apply (Tensor.pure x v w) :=
  \fun (v: F x)(w: G x) => trans!{{Tensor.Fiber x}} _ _ _ (combinedOnPure x v w)
    (trans!{{Tensor.Fiber x}} _ _ _
      (congr!{{Tensor.Fiber x} {Tensor.Fiber x} {Tensor.Fiber x}} (bundle.space x).add _ _ _ _
        (Algebra.bilinear.addLeft ((firstD.fiber x).apply v) ((firstR.fiber x).apply v) w)
        (Algebra.bilinear.addRight ((grading.fiber x).apply v) ((secondD.fiber x).apply w) ((secondR.fiber x).apply w)))
      (trans!{{Tensor.Fiber x}} _ _ _
        (Laws.shuffle
          (Tensor.pure x ((firstD.fiber x).apply v) w) (Tensor.pure x ((firstR.fiber x).apply v) w)
          (Tensor.pure x ((grading.fiber x).apply v) ((secondD.fiber x).apply w)) (Tensor.pure x ((grading.fiber x).apply v) ((secondR.fiber x).apply w)))
        (congr!{{Tensor.Fiber x} {Tensor.Fiber x} {Tensor.Fiber x}} (bundle.space x).add _ _ _ _
          (sym!{{Tensor.Fiber x}} _ _ (dOnPure x v w)) (sym!{{Tensor.Fiber x}} _ _ (rOnPure x v w)))));
\definition equation: \forall (v: Tensor.Fiber x) -> (combined.fiber x).apply v = (sum.fiber x).apply v :=
  EqualityOnPure.pointwise (combined.fiber x) (sum.fiber x) pureEquation;
