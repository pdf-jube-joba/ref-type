\import C.Def[] \as Scalar;
\import Bundles.Morphisms[X := X, Y := X, F := F, G := F, source := first, target := first, f := (\fun (x: X) => x)] \as FirstMaps;
\import Bundles.Morphisms[X := X, Y := X, F := G, G := G, source := second, target := second, f := (\fun (x: X) => x)] \as SecondMaps;
\structure Data: \Set := {
  first: FirstMaps.Map, second: SecondMaps.Map, grading: FirstMaps.Map,
  a: X -> C.Complex, b: X -> C.Complex
};
\definition fiberData[c: Data][x: X]: \root.Thom[].ComplexProductClifford[V := F x, W := G x, firstSpace := first.space x, secondSpace := second.space x].Data :=
  \root.Thom[].ComplexProductClifford[V := F x, W := G x, firstSpace := first.space x, secondSpace := second.space x].Data {
    first := c.first.fiber x, second := c.second.fiber x, grading := c.grading.fiber x, a := c.a x, b := c.b x
  };
\definition Laws[c: Data]: \Prop := \forall (x: X) ->
  \root.Thom[].ComplexProductClifford[V := F x, W := G x, firstSpace := first.space x, secondSpace := second.space x].Laws[fiberData c x];
\import Operations.Tensor[X := X, F := F, G := G, left := first, right := second] \as Tensor;
\definition bundle: Bundles.Family[X := X, F := Tensor.Fiber].Bundle := Tensor.bundle sameBase;
\module With(c: Data, laws: Laws c);
