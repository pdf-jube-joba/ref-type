\definition firstTerm[k: N.Nat^]: Models.Bundle := (data.first k).model;
\definition secondTerm[k: N.Nat^]: Models.Bundle := (data.second k).model;
\definition totalTerm[k: N.Nat^]: Models.Bundle := (data.total k).model;
\definition termCast[i, j: N.Nat^][same: i = j]: Models.Map (totalTerm i) (totalTerm j) :=
  \idelim i = j \with k: N.Nat^ => Models.Map (totalTerm i) (totalTerm k) \by { base: Models.identity (totalTerm i), equality: same };
\module Along(firstSection: FirstSections.Section, secondSection: SecondSections.Section);
