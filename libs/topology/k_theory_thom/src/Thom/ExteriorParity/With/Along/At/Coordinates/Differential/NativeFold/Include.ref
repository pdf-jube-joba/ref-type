\import Spaces.Linear[V := Models.Fiber (totalTerm k).ranks x, W := Models.Fiber (target side).ranks x,
  source := (Models.bundle (totalTerm k)).space x, target := (Models.bundle (target side)).space x]
  .Composition[U := Native k x, domain := (native k).space x] \as Compose;
\definition map: Spaces.Linear[V := Native k x, W := Models.Fiber (target side).ranks x,
  source := (native k).space x, target := (Models.bundle (target side)).space x].Map :=
  Compose.compose ((TotalLower.degreeInjection degree k side).fiber x) ((data.total k).isomorphism.forward.fiber x);
