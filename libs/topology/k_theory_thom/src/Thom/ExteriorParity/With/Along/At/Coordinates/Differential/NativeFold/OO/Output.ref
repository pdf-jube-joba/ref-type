\definition Carrier: \Set := Models.Fiber (target output).ranks x;
\definition space: Spaces.VectorSpace Carrier := (Models.bundle (target output)).space x;
\import Spaces.Laws[V := Carrier, space := space] \as Laws;
\definition zeroLeft: \forall (v: Carrier) -> space.add space.zero v = v := Laws.zeroLeft;
\definition zeroRight: \forall (v: Carrier) -> space.add v space.zero = v := Laws.zeroRight;
\definition scaleZero: \forall (a: C.Complex) -> space.smul a space.zero = space.zero := Laws.scaleZero;
