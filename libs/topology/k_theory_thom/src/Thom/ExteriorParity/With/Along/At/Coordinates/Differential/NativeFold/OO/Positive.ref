\import \parent.\parent.\parent.\parent.\parent.\parent.NativeLeibniz[x := x] \as Law;
\import \parent.\parent.Lower[x := x] \as Lower;
\import \parent.\parent.Include[k := Nat.add (N.Nat^::succ p) q, side := output, x := x] \as Include;
\import \parent.Output[x := x] \as Out;
\import Law.Positive[p := p, q := q] \as NativeLaw;
\definition firstLowerColor: FirstLower.side n p = Labels.flip firstSide := trans!{{B.Bool^}} _ _ _ (Previous.side n p firstBound) (congr!{{B.Bool^} {B.Bool^}} Labels.flip _ _ firstColor);
\definition secondLowerColor: SecondLower.side m q = Labels.flip secondSide := trans!{{B.Bool^}} _ _ _ (Previous.side m q secondBound) (congr!{{B.Bool^} {B.Bool^}} Labels.flip _ _ secondColor);
\definition leftDegree: Nat.add p (N.Nat^::succ q) = NativeLaw.output := sym!{{N.Nat^}} _ _ (Naturals.addSuccLeft p q);
\definition leftPlacement[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm (N.Nat^::succ q) x]:
  included NativeLaw.output output x (NativeLaw.leftTerm omega eta) = placed p (N.Nat^::succ q) (Labels.flip firstSide) secondSide x (Law.firstLower (N.Nat^::succ p) omega) eta :=
  trans!{{Out.Carrier}} _ _ _ (includedPure NativeLaw.output p (N.Nat^::succ q) leftDegree output x (Law.firstLower (N.Nat^::succ p) omega) eta)
    (sym!{{Out.Carrier}} _ _ (Placement.result p (N.Nat^::succ q) (Previous.bound n p firstBound) secondBound (Labels.flip firstSide) secondSide firstLowerColor secondColor x (Law.firstLower (N.Nat^::succ p) omega) eta));
\definition rightPlacement[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm (N.Nat^::succ q) x]:
  included NativeLaw.output output x (NativeLaw.rightTerm omega eta) = placed (N.Nat^::succ p) q firstSide (Labels.flip secondSide) x omega (Law.secondLower (N.Nat^::succ q) eta) :=
  sym!{{Out.Carrier}} _ _ (Placement.result (N.Nat^::succ p) q firstBound (Previous.bound m q secondBound) firstSide (Labels.flip secondSide) firstColor secondLowerColor x omega (Law.secondLower (N.Nat^::succ q) eta));
\definition expanded[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm (N.Nat^::succ q) x]:
  included NativeLaw.output output x (((native NativeLaw.output).space x).add (NativeLaw.leftTerm omega eta) (((native NativeLaw.output).space x).smul (Sign.value (N.Nat^::succ p)) (NativeLaw.rightTerm omega eta))) = outcome (N.Nat^::succ p) (N.Nat^::succ q) x omega eta :=
  trans!{{Out.Carrier}} _ _ _ (Include.map.preservesAdd (NativeLaw.leftTerm omega eta) (((native NativeLaw.output).space x).smul (Sign.value (N.Nat^::succ p)) (NativeLaw.rightTerm omega eta)))
    (congr!{{Out.Carrier} {Out.Carrier} {Out.Carrier}} Out.space.add _ _ _ _ (leftPlacement omega eta)
      (trans!{{Out.Carrier}} _ _ _ (Include.map.preservesScale (Sign.value (N.Nat^::succ p)) (NativeLaw.rightTerm omega eta))
        (trans!{{Out.Carrier}} _ _ _ (congr!{{Out.Carrier} {Out.Carrier}} (Out.space.smul (Sign.value (N.Nat^::succ p))) _ _ (rightPlacement omega eta))
          (congr!{{C.Complex} {Out.Carrier}} (\fun (a: C.Complex) => Out.space.smul a (placed (N.Nat^::succ p) q firstSide (Labels.flip secondSide) x omega (Law.secondLower (N.Nat^::succ q) eta))) _ _ (Previous.firstSign (N.Nat^::succ p) firstBound firstSide firstColor)))));
\definition result: \forall (omega: FirstForm (N.Nat^::succ p) x)(eta: SecondForm (N.Nat^::succ q) x) ->
  ((totalOperator side).fiber x).apply (placed (N.Nat^::succ p) (N.Nat^::succ q) firstSide secondSide x omega eta) = outcome (N.Nat^::succ p) (N.Nat^::succ q) x omega eta :=
  \fun (omega: FirstForm (N.Nat^::succ p) x)(eta: SecondForm (N.Nat^::succ q) x) => trans!{{Out.Carrier}} _ _ _
    (congr!{{Models.Fiber (target side).ranks x} {Out.Carrier}} ((totalOperator side).fiber x).apply _ _
      (Placement.result (N.Nat^::succ p) (N.Nat^::succ q) firstBound secondBound firstSide secondSide firstColor secondColor x omega eta))
    (trans!{{Out.Carrier}} _ _ _
      (Lower.total NativeLaw.input side (Previous.totalBound (N.Nat^::succ p) (N.Nat^::succ q) firstBound secondBound) (Previous.totalColor (N.Nat^::succ p) (N.Nat^::succ q) firstBound secondBound firstSide secondSide firstColor secondColor) (NativeLaw.pure omega eta))
      (trans!{{Out.Carrier}} _ _ _ (congr!{{Native NativeLaw.output x} {Out.Carrier}} (included NativeLaw.output output x) _ _ (NativeLaw.equation omega eta)) (expanded omega eta)));
