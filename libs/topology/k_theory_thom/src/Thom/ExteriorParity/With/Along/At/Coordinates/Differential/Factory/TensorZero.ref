\import Spaces.Tensor[V := V, W := W, left := first, right := second] \as Tensor;
\import Spaces.Laws[V := V, space := first] \as FirstLaws;
\import Spaces.Laws[V := W, space := second] \as SecondLaws;
\import Spaces.Laws[V := Tensor.Carrier, space := Tensor.space] \as Laws;
\definition leftZero[v: W]: Tensor.tensor first.zero v = Tensor.space.zero :=
  trans!{{Tensor.Carrier}} _ _ _ (congr!{V {Tensor.Carrier}} (\fun (u: V) => Tensor.tensor u v) _ _ (sym!{V} _ _ (FirstLaws.zeroScale first.zero)))
    (trans!{{Tensor.Carrier}} _ _ _ (Tensor.bilinear.scaleLeft Op.zero first.zero v) (Laws.zeroScale (Tensor.tensor first.zero v)));
\definition rightZero[v: V]: Tensor.tensor v second.zero = Tensor.space.zero :=
  trans!{{Tensor.Carrier}} _ _ _ (congr!{W {Tensor.Carrier}} (Tensor.tensor v) _ _ (sym!{W} _ _ (SecondLaws.zeroScale second.zero)))
    (trans!{{Tensor.Carrier}} _ _ _ (Tensor.bilinear.scaleRight Op.zero v second.zero) (Laws.zeroScale (Tensor.tensor v second.zero)));
