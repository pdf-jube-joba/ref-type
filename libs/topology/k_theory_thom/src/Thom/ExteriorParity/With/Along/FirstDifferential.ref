\import \root.Thom[].Contraction[X := X, F := F, bundle := left, section := firstSection, k := k] \as Raw;
\import Bundles.Morphisms[X := X, Y := X, F := Models.Fiber (firstTerm (N.Nat^::succ k)).ranks, G := FirstForm (N.Nat^::succ k),
  source := Models.bundle (firstTerm (N.Nat^::succ k)), target := firstForms (N.Nat^::succ k), f := (\fun (x: X) => x)]
  .Composition[Z := X, H := FirstForm k, range := firstForms k, g := (\fun (x: X) => x)] \as Start;
\definition start: Bundles.Morphisms[X := X, Y := X, F := Models.Fiber (firstTerm (N.Nat^::succ k)).ranks, G := FirstForm k,
  source := Models.bundle (firstTerm (N.Nat^::succ k)), target := firstForms k, f := (\fun (x: X) => x)].Map :=
  Start.compose (data.first (N.Nat^::succ k)).isomorphism.backward Raw.map;
\import Bundles.Morphisms[X := X, Y := X, F := Models.Fiber (firstTerm (N.Nat^::succ k)).ranks, G := FirstForm k,
  source := Models.bundle (firstTerm (N.Nat^::succ k)), target := firstForms k, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Models.Fiber (firstTerm k).ranks, range := Models.bundle (firstTerm k), g := (\fun (x: X) => x)] \as Finish;
\definition map: Models.Map (firstTerm (N.Nat^::succ k)) (firstTerm k) := Finish.compose start (data.first k).isomorphism.forward;
