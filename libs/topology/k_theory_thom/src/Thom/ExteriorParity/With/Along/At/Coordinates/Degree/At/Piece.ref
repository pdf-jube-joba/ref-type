\import \parent.\parent.\parent.Bidegree[p := d.p, q := d.q, side := side] \as Placement;
\definition map: Modules.Hom[V := Direct.family.Carrier d, W := Models.Fiber (model side).ranks x,
  source := Direct.family.space d, target := (Models.bundle (model side)).space x].Map :=
  Modules.Hom[V := Direct.family.Carrier d, W := Models.Fiber (model side).ranks x,
    source := Direct.family.space d, target := (Models.bundle (model side)).space x].Map {
    apply := (Placement.map.fiber x).apply,
    addition := (Placement.map.fiber x).preservesAdd,
    scalar := (Placement.map.fiber x).preservesScale
  };
