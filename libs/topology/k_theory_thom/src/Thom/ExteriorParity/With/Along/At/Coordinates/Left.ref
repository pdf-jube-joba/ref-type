\import std.Data[].Pair[] \as Pair;
\import Operations.DirectSum[X := X, F := Parity.EEFiber, G := Parity.OOFiber, left := Parity.eeBundle, right := Parity.ooBundle]
  .Of[same := (\refl(left.baseSpace))].Inclusions[] \as Even;
\definition evenFirst[v: Parity.EEFiber x]: (candidateEven.fiber x).apply ((Even.first.fiber x).apply v) = (evenChoice.isomorphism.forward.fiber x).apply ((Even.first.fiber x).apply v) :=
  trans!{{Models.Fiber (model B.Bool^::true).ranks x}} _ _ _
    (congr!{{Models.Fiber (target B.Bool^::true).ranks x} {Models.Fiber (model B.Bool^::true).ranks x}} ((backwardCode B.Bool^::true).fiber x).apply _ _ (EvenCopair.onFirst EE.forward OO.forward x v))
    (\parent.Pairing[firstSide := B.Bool^::true, secondSide := B.Bool^::true].equation x v);
\definition evenSecond[v: Parity.OOFiber x]: (candidateEven.fiber x).apply ((Even.second.fiber x).apply v) = (evenChoice.isomorphism.forward.fiber x).apply ((Even.second.fiber x).apply v) :=
  trans!{{Models.Fiber (model B.Bool^::true).ranks x}} _ _ _
    (congr!{{Models.Fiber (target B.Bool^::true).ranks x} {Models.Fiber (model B.Bool^::true).ranks x}} ((backwardCode B.Bool^::true).fiber x).apply _ _ (EvenCopair.onSecond EE.forward OO.forward x v))
    (\parent.Pairing[firstSide := B.Bool^::false, secondSide := B.Bool^::false].equation x v);
\definition codedEven[v: Parity.Even x]: (candidateEven.fiber x).apply v = (evenChoice.isomorphism.forward.fiber x).apply v :=
  trans!{{Models.Fiber (model B.Bool^::true).ranks x}} _ _ _
    (congr!{{Parity.Even x} {Models.Fiber (model B.Bool^::true).ranks x}} (candidateEven.fiber x).apply _ _ (sym!{{Parity.Even x}} _ _ (Even.decomposition x v)))
    (trans!{{Models.Fiber (model B.Bool^::true).ranks x}} _ _ _
      ((candidateEven.fiber x).preservesAdd ((Even.first.fiber x).apply (Pair.first (Parity.EEFiber x) (Parity.OOFiber x) v)) ((Even.second.fiber x).apply (Pair.second (Parity.EEFiber x) (Parity.OOFiber x) v)))
      (trans!{{Models.Fiber (model B.Bool^::true).ranks x}} _ _ _
        (congr!{{Models.Fiber (model B.Bool^::true).ranks x} {Models.Fiber (model B.Bool^::true).ranks x} {Models.Fiber (model B.Bool^::true).ranks x}} ((Models.bundle (model B.Bool^::true)).space x).add _ _ _ _
          (evenFirst (Pair.first (Parity.EEFiber x) (Parity.OOFiber x) v)) (evenSecond (Pair.second (Parity.EEFiber x) (Parity.OOFiber x) v)))
        (trans!{{Models.Fiber (model B.Bool^::true).ranks x}} _ _ _
          (sym!{{Models.Fiber (model B.Bool^::true).ranks x}} _ _ ((evenChoice.isomorphism.forward.fiber x).preservesAdd ((Even.first.fiber x).apply (Pair.first (Parity.EEFiber x) (Parity.OOFiber x) v)) ((Even.second.fiber x).apply (Pair.second (Parity.EEFiber x) (Parity.OOFiber x) v))))
          (congr!{{Parity.Even x} {Models.Fiber (model B.Bool^::true).ranks x}} (evenChoice.isomorphism.forward.fiber x).apply _ _ (Even.decomposition x v)))));
\definition even[v: Parity.Even x]: (backwardEven.fiber x).apply ((forwardEven.fiber x).apply v) = v :=
  trans!{{Parity.Even x}} _ _ _ (congr!{{Models.Fiber (model B.Bool^::true).ranks x} {Parity.Even x}} (evenChoice.isomorphism.backward.fiber x).apply _ _ (codedEven v)) (evenChoice.isomorphism.leftInverse x v);
\import Operations.DirectSum[X := X, F := Parity.EOFiber, G := Parity.OEFiber, left := Parity.eoBundle, right := Parity.oeBundle]
  .Of[same := (\refl(left.baseSpace))].Inclusions[] \as Odd;
\definition oddFirst[v: Parity.EOFiber x]: (candidateOdd.fiber x).apply ((Odd.first.fiber x).apply v) = (oddChoice.isomorphism.forward.fiber x).apply ((Odd.first.fiber x).apply v) :=
  trans!{{Models.Fiber (model B.Bool^::false).ranks x}} _ _ _
    (congr!{{Models.Fiber (target B.Bool^::false).ranks x} {Models.Fiber (model B.Bool^::false).ranks x}} ((backwardCode B.Bool^::false).fiber x).apply _ _ (OddCopair.onFirst EO.forward OE.forward x v))
    (\parent.Pairing[firstSide := B.Bool^::true, secondSide := B.Bool^::false].equation x v);
\definition oddSecond[v: Parity.OEFiber x]: (candidateOdd.fiber x).apply ((Odd.second.fiber x).apply v) = (oddChoice.isomorphism.forward.fiber x).apply ((Odd.second.fiber x).apply v) :=
  trans!{{Models.Fiber (model B.Bool^::false).ranks x}} _ _ _
    (congr!{{Models.Fiber (target B.Bool^::false).ranks x} {Models.Fiber (model B.Bool^::false).ranks x}} ((backwardCode B.Bool^::false).fiber x).apply _ _ (OddCopair.onSecond EO.forward OE.forward x v))
    (\parent.Pairing[firstSide := B.Bool^::false, secondSide := B.Bool^::true].equation x v);
\definition codedOdd[v: Parity.Odd x]: (candidateOdd.fiber x).apply v = (oddChoice.isomorphism.forward.fiber x).apply v :=
  trans!{{Models.Fiber (model B.Bool^::false).ranks x}} _ _ _
    (congr!{{Parity.Odd x} {Models.Fiber (model B.Bool^::false).ranks x}} (candidateOdd.fiber x).apply _ _ (sym!{{Parity.Odd x}} _ _ (Odd.decomposition x v)))
    (trans!{{Models.Fiber (model B.Bool^::false).ranks x}} _ _ _
      ((candidateOdd.fiber x).preservesAdd ((Odd.first.fiber x).apply (Pair.first (Parity.EOFiber x) (Parity.OEFiber x) v)) ((Odd.second.fiber x).apply (Pair.second (Parity.EOFiber x) (Parity.OEFiber x) v)))
      (trans!{{Models.Fiber (model B.Bool^::false).ranks x}} _ _ _
        (congr!{{Models.Fiber (model B.Bool^::false).ranks x} {Models.Fiber (model B.Bool^::false).ranks x} {Models.Fiber (model B.Bool^::false).ranks x}} ((Models.bundle (model B.Bool^::false)).space x).add _ _ _ _
          (oddFirst (Pair.first (Parity.EOFiber x) (Parity.OEFiber x) v)) (oddSecond (Pair.second (Parity.EOFiber x) (Parity.OEFiber x) v)))
        (trans!{{Models.Fiber (model B.Bool^::false).ranks x}} _ _ _
          (sym!{{Models.Fiber (model B.Bool^::false).ranks x}} _ _ ((oddChoice.isomorphism.forward.fiber x).preservesAdd ((Odd.first.fiber x).apply (Pair.first (Parity.EOFiber x) (Parity.OEFiber x) v)) ((Odd.second.fiber x).apply (Pair.second (Parity.EOFiber x) (Parity.OEFiber x) v))))
          (congr!{{Parity.Odd x} {Models.Fiber (model B.Bool^::false).ranks x}} (oddChoice.isomorphism.forward.fiber x).apply _ _ (Odd.decomposition x v)))));
\definition odd[v: Parity.Odd x]: (backwardOdd.fiber x).apply ((forwardOdd.fiber x).apply v) = v :=
  trans!{{Parity.Odd x}} _ _ _ (congr!{{Models.Fiber (model B.Bool^::false).ranks x} {Parity.Odd x}} (oddChoice.isomorphism.backward.fiber x).apply _ _ (codedOdd v)) (oddChoice.isomorphism.leftInverse x v);
