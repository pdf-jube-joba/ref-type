\definition side: B.Bool^ := ProductLabels.evenPair firstSide secondSide;
\import Tensor.At[n := n, m := m, firstSide := firstSide, secondSide := secondSide, target := target side] \as Assembly;
\definition Fiber[x: X]: \Set := Assembly.Fiber x;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Assembly.bundle;
\module Entry(s: First.Colored n firstSide, t: Second.Colored m secondSide);
\definition components: Assembly.Components := \fun (s: First.Colored n firstSide)(t: Second.Colored m secondSide) => Entry[s := s, t := t].map;
\definition forward: Assembly.Map := Assembly.With[components := components].map;
\definition pure[x: X][v: Models.Fiber (First.parity n firstSide).ranks x][w: Models.Fiber (Second.parity m secondSide).ranks x]: Fiber x := Assembly.pure x v w;
\definition onPair[s: First.Colored n firstSide][t: Second.Colored m secondSide][x: X]
  [v: Models.Fiber (firstTerm (Labels.degree n s)).ranks x][w: Models.Fiber (secondTerm (Labels.degree m t)).ranks x]:
  (forward.fiber x).apply (pure x (((First.at n s firstSide (\bysub(Labels.Index n, First.Colored n firstSide, s))).fiber x).apply v)
    (((Second.at m t secondSide (\bysub(Labels.Index m, Second.Colored m secondSide, t))).fiber x).apply w)) =
  ((Entry[s := s, t := t].map).fiber x).apply (Tensor.componentPure (Labels.degree n s) (Labels.degree m t) x v w) :=
  Assembly.With[components := components].onPair s t x v w;
