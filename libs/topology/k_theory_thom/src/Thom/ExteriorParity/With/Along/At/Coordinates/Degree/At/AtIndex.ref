\import \parent.\parent.\parent.Bidegree[p := i, q := Nat.sub k i, side := side] \as Placement;
\import \root.Thom[].SumBundles[X := X, F := F, G := G, left := left, right := right, sameBase := sameBase, k := k]
  .Component[p := i, q := Nat.sub k i, degree := Enumeration.equation i] \as Projection;
\definition equation[v: Native k x]: ((components i).fiber x).apply (((data.total k).isomorphism.forward.fiber x).apply v) =
  (nativeComponents (Enumeration.at i)).apply (Direct.coordinates v (Enumeration.at i)) :=
  congr!{{Native k x} {Models.Fiber (model side).ranks x}}
    (\fun (z: Native k x) => (Placement.map.fiber x).apply ((Projection.projection.fiber x).apply z)) _ _
    ((data.total k).isomorphism.leftInverse x v);
