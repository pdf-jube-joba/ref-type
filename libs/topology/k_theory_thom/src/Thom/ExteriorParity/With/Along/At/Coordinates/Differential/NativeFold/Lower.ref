\import \parent.\parent.\parent.\parent.\parent.NativeLeibniz[x := x] \as Law;
\definition firstCoded[k: N.Nat^][side: B.Bool^][bound: Naturals.Le k n][color: FirstLower.side n k = side][v: Models.Fiber (firstTerm k).ranks x]:
  ((firstOperator side).fiber x).apply (((FirstLower.degreeInjection n k side).fiber x).apply v) =
  ((FirstLower.degreeInjection n (Nat.pred k) (Labels.flip side)).fiber x).apply (((FirstLower.lower k).fiber x).apply v) :=
  \idelim FirstLower.side n k = side \with b: B.Bool^ =>
    ((firstOperator b).fiber x).apply (((FirstLower.degreeInjection n k b).fiber x).apply v) =
    ((FirstLower.degreeInjection n (Nat.pred k) (Labels.flip b)).fiber x).apply (((FirstLower.lower k).fiber x).apply v) \by {
      base: FirstLower.result n k bound x v, equality: color
    };
\definition first[k: N.Nat^][side: B.Bool^][bound: Naturals.Le k n][color: FirstLower.side n k = side][v: FirstForm k x]:
  ((firstOperator side).fiber x).apply (((FirstLower.degreeInjection n k side).fiber x).apply (((data.first k).isomorphism.forward.fiber x).apply v)) =
  ((FirstLower.degreeInjection n (Nat.pred k) (Labels.flip side)).fiber x).apply (((data.first (Nat.pred k)).isomorphism.forward.fiber x).apply (Law.firstLower k v)) :=
  trans!{{Models.Fiber (First.parity n (Labels.flip side)).ranks x}} _ _ _ (firstCoded k side bound color (((data.first k).isomorphism.forward.fiber x).apply v))
    (congr!{{Models.Fiber (firstTerm (Nat.pred k)).ranks x} {Models.Fiber (First.parity n (Labels.flip side)).ranks x}}
      ((FirstLower.degreeInjection n (Nat.pred k) (Labels.flip side)).fiber x).apply _ _ (Law.encodedFirstLower k v));
\definition secondCoded[k: N.Nat^][side: B.Bool^][bound: Naturals.Le k m][color: SecondLower.side m k = side][v: Models.Fiber (secondTerm k).ranks x]:
  ((secondOperator side).fiber x).apply (((SecondLower.degreeInjection m k side).fiber x).apply v) =
  ((SecondLower.degreeInjection m (Nat.pred k) (Labels.flip side)).fiber x).apply (((SecondLower.lower k).fiber x).apply v) :=
  \idelim SecondLower.side m k = side \with b: B.Bool^ =>
    ((secondOperator b).fiber x).apply (((SecondLower.degreeInjection m k b).fiber x).apply v) =
    ((SecondLower.degreeInjection m (Nat.pred k) (Labels.flip b)).fiber x).apply (((SecondLower.lower k).fiber x).apply v) \by {
      base: SecondLower.result m k bound x v, equality: color
    };
\definition second[k: N.Nat^][side: B.Bool^][bound: Naturals.Le k m][color: SecondLower.side m k = side][v: SecondForm k x]:
  ((secondOperator side).fiber x).apply (((SecondLower.degreeInjection m k side).fiber x).apply (((data.second k).isomorphism.forward.fiber x).apply v)) =
  ((SecondLower.degreeInjection m (Nat.pred k) (Labels.flip side)).fiber x).apply (((data.second (Nat.pred k)).isomorphism.forward.fiber x).apply (Law.secondLower k v)) :=
  trans!{{Models.Fiber (Second.parity m (Labels.flip side)).ranks x}} _ _ _ (secondCoded k side bound color (((data.second k).isomorphism.forward.fiber x).apply v))
    (congr!{{Models.Fiber (secondTerm (Nat.pred k)).ranks x} {Models.Fiber (Second.parity m (Labels.flip side)).ranks x}}
      ((SecondLower.degreeInjection m (Nat.pred k) (Labels.flip side)).fiber x).apply _ _ (Law.encodedSecondLower k v));
\definition totalCoded[k: N.Nat^][side: B.Bool^][bound: Naturals.Le k degree][color: TotalLower.side degree k = side][v: Models.Fiber (totalTerm k).ranks x]:
  ((totalOperator side).fiber x).apply (((TotalLower.degreeInjection degree k side).fiber x).apply v) =
  ((TotalLower.degreeInjection degree (Nat.pred k) (Labels.flip side)).fiber x).apply (((TotalLower.lower k).fiber x).apply v) :=
  \idelim TotalLower.side degree k = side \with b: B.Bool^ =>
    ((totalOperator b).fiber x).apply (((TotalLower.degreeInjection degree k b).fiber x).apply v) =
    ((TotalLower.degreeInjection degree (Nat.pred k) (Labels.flip b)).fiber x).apply (((TotalLower.lower k).fiber x).apply v) \by {
      base: TotalLower.result degree k bound x v, equality: color
    };
\definition total[k: N.Nat^][side: B.Bool^][bound: Naturals.Le k degree][color: TotalLower.side degree k = side][v: Native k x]:
  ((totalOperator side).fiber x).apply (included k side x v) = included (Nat.pred k) (Labels.flip side) x (Law.nativeLower k v) :=
  trans!{{Models.Fiber (target (Labels.flip side)).ranks x}} _ _ _ (totalCoded k side bound color (((data.total k).isomorphism.forward.fiber x).apply v))
    (congr!{{Models.Fiber (totalTerm (Nat.pred k)).ranks x} {Models.Fiber (target (Labels.flip side)).ranks x}}
      ((TotalLower.degreeInjection degree (Nat.pred k) (Labels.flip side)).fiber x).apply _ _ (Law.encodedLower k v));
