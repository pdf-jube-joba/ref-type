\definition coded[side: B.Bool^]: Bundles.Isomorphisms[X := X,
  F := Models.Fiber (model side).ranks, G := Models.Fiber (target side).ranks,
  source := Models.bundle (model side), target := Models.bundle (target side)].Isomorphism :=
  Bundles.Isomorphisms[X := X, F := Models.Fiber (model side).ranks, G := Models.Fiber (target side).ranks,
    source := Models.bundle (model side), target := Models.bundle (target side)].Isomorphism {
      forward := forwardCode side, backward := backwardCode side,
      leftInverse := codedLeft side,
      rightInverse := \fun (x: X) => \parent.Right[firstVanishing := firstVanishing, secondVanishing := secondVanishing, x := x].result side
    };
\definition even: Bundles.Isomorphisms[X := X, F := Parity.Even, G := Models.Fiber (target B.Bool^::true).ranks,
  source := Parity.evenBundle, target := Models.bundle (target B.Bool^::true)].Isomorphism :=
  Bundles.Isomorphisms[X := X, F := Parity.Even, G := Models.Fiber (target B.Bool^::true).ranks,
    source := Parity.evenBundle, target := Models.bundle (target B.Bool^::true)].Isomorphism {
      forward := forwardEven, backward := backwardEven,
      leftInverse := \fun (x: X) => \parent.Left[x := x].even,
      rightInverse := \fun (x: X) => \parent.Right[firstVanishing := firstVanishing, secondVanishing := secondVanishing, x := x].result B.Bool^::true
    };
\definition odd: Bundles.Isomorphisms[X := X, F := Parity.Odd, G := Models.Fiber (target B.Bool^::false).ranks,
  source := Parity.oddBundle, target := Models.bundle (target B.Bool^::false)].Isomorphism :=
  Bundles.Isomorphisms[X := X, F := Parity.Odd, G := Models.Fiber (target B.Bool^::false).ranks,
    source := Parity.oddBundle, target := Models.bundle (target B.Bool^::false)].Isomorphism {
      forward := forwardOdd, backward := backwardOdd,
      leftInverse := \fun (x: X) => \parent.Left[x := x].odd,
      rightInverse := \fun (x: X) => \parent.Right[firstVanishing := firstVanishing, secondVanishing := secondVanishing, x := x].result B.Bool^::false
    };
