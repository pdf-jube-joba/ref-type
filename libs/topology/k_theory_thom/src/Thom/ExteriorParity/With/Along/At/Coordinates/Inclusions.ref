\import Operations.DirectSum[X := X, F := Parity.EEFiber, G := Parity.OOFiber, left := Parity.eeBundle, right := Parity.ooBundle]
  .Of[same := (\refl(left.baseSpace))].Inclusions[] \as Even;
\import Operations.DirectSum[X := X, F := Parity.EOFiber, G := Parity.OEFiber, left := Parity.eoBundle, right := Parity.oeBundle]
  .Of[same := (\refl(left.baseSpace))].Inclusions[] \as Odd;
\import Bundles.Morphisms[X := X, Y := X, F := Parity.EEFiber, G := Parity.Even, source := Parity.eeBundle,
  target := Parity.evenBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Models.Fiber (model B.Bool^::true).ranks, range := Models.bundle (model B.Bool^::true), g := (\fun (x: X) => x)] \as EE;
\definition ee: Bundles.Morphisms[X := X, Y := X, F := Parity.EEFiber, G := Models.Fiber (model B.Bool^::true).ranks,
  source := Parity.eeBundle, target := Models.bundle (model B.Bool^::true), f := (\fun (x: X) => x)].Map := EE.compose Even.first evenChoice.isomorphism.forward;
\import Bundles.Morphisms[X := X, Y := X, F := Parity.OOFiber, G := Parity.Even, source := Parity.ooBundle,
  target := Parity.evenBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Models.Fiber (model B.Bool^::true).ranks, range := Models.bundle (model B.Bool^::true), g := (\fun (x: X) => x)] \as OO;
\definition oo: Bundles.Morphisms[X := X, Y := X, F := Parity.OOFiber, G := Models.Fiber (model B.Bool^::true).ranks,
  source := Parity.ooBundle, target := Models.bundle (model B.Bool^::true), f := (\fun (x: X) => x)].Map := OO.compose Even.second evenChoice.isomorphism.forward;
\import Bundles.Morphisms[X := X, Y := X, F := Parity.EOFiber, G := Parity.Odd, source := Parity.eoBundle,
  target := Parity.oddBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Models.Fiber (model B.Bool^::false).ranks, range := Models.bundle (model B.Bool^::false), g := (\fun (x: X) => x)] \as EO;
\definition eo: Bundles.Morphisms[X := X, Y := X, F := Parity.EOFiber, G := Models.Fiber (model B.Bool^::false).ranks,
  source := Parity.eoBundle, target := Models.bundle (model B.Bool^::false), f := (\fun (x: X) => x)].Map := EO.compose Odd.first oddChoice.isomorphism.forward;
\import Bundles.Morphisms[X := X, Y := X, F := Parity.OEFiber, G := Parity.Odd, source := Parity.oeBundle,
  target := Parity.oddBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Models.Fiber (model B.Bool^::false).ranks, range := Models.bundle (model B.Bool^::false), g := (\fun (x: X) => x)] \as OE;
\definition oe: Bundles.Morphisms[X := X, Y := X, F := Parity.OEFiber, G := Models.Fiber (model B.Bool^::false).ranks,
  source := Parity.oeBundle, target := Models.bundle (model B.Bool^::false), f := (\fun (x: X) => x)].Map := OE.compose Odd.second oddChoice.isomorphism.forward;
