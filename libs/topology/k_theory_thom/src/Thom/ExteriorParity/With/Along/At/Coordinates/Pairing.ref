\definition side: B.Bool^ := ProductLabels.evenPair firstSide secondSide;
\import \parent.\parent.Slot[firstSide := firstSide, secondSide := secondSide] \as Source;
\import Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := Models.Fiber (target side).ranks,
  source := Source.bundle, target := Models.bundle (target side), f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Models.Fiber (model side).ranks, range := Models.bundle (model side), g := (\fun (x: X) => x)] \as Compose;
\definition candidate: Bundles.Morphisms[X := X, Y := X, F := Source.Fiber, G := Models.Fiber (model side).ranks,
  source := Source.bundle, target := Models.bundle (model side), f := (\fun (x: X) => x)].Map := Compose.compose Source.forward (backwardCode side);
\module Pure(s: First.Colored n firstSide, t: Second.Colored m secondSide, x: X);
\definition equation[x: X][v: Source.Fiber x]: (candidate.fiber x).apply v = ((block firstSide secondSide).fiber x).apply v :=
  Tensor.At[n := n, m := m, firstSide := firstSide, secondSide := secondSide, target := model side]
    .Ext[x := x, U := Models.Fiber (model side).ranks x, spaceU := (Models.bundle (model side)).space x].ext
      (candidate.fiber x) ((block firstSide secondSide).fiber x)
      (\fun (s: First.Colored n firstSide)(t: Second.Colored m secondSide)(a: Models.Fiber (firstTerm (Labels.degree n s)).ranks x)(b: Models.Fiber (secondTerm (Labels.degree m t)).ranks x) => Pure[s := s, t := t, x := x].equation a b) v;
