\import \parent.\parent.\parent.\parent.\parent.\parent.NativeLeibniz[x := x] \as Law;
\import \parent.\parent.Lower[x := x] \as Lower;
\import \parent.Output[x := x] \as Out;
\import Law.LeftZero[q := q] \as NativeLaw;
\definition secondLowerColor: SecondLower.side m q = Labels.flip secondSide := trans!{{B.Bool^}} _ _ _ (Previous.side m q secondBound) (congr!{{B.Bool^} {B.Bool^}} Labels.flip _ _ secondColor);
\definition rightValue[omega: FirstForm N.Nat^::zero x][eta: SecondForm (N.Nat^::succ q) x]: Out.Carrier :=
  placed N.Nat^::zero q firstSide (Labels.flip secondSide) x omega (Law.secondLower (N.Nat^::succ q) eta);
\definition rightPlacement[omega: FirstForm N.Nat^::zero x][eta: SecondForm (N.Nat^::succ q) x]:
  included NativeLaw.output output x (NativeLaw.target omega eta) = rightValue omega eta :=
  sym!{{Out.Carrier}} _ _ (Placement.result N.Nat^::zero q firstBound (Previous.bound m q secondBound) firstSide (Labels.flip secondSide) firstColor secondLowerColor x omega (Law.secondLower (N.Nat^::succ q) eta));
\definition outcomeEquation[omega: FirstForm N.Nat^::zero x][eta: SecondForm (N.Nat^::succ q) x]: outcome N.Nat^::zero (N.Nat^::succ q) x omega eta = rightValue omega eta :=
  trans!{{Out.Carrier}} _ _ _
    (congr!{{Out.Carrier} {Out.Carrier}} (\fun (v: Out.Carrier) => Out.space.add v (Out.space.smul (Color.color firstSide) (rightValue omega eta))) _ _
      (Zero.first N.Nat^::zero (N.Nat^::succ q) (Labels.flip firstSide) secondSide x eta))
    (trans!{{Out.Carrier}} _ _ _ (Out.zeroLeft (Out.space.smul (Color.color firstSide) (rightValue omega eta)))
      (trans!{{Out.Carrier}} _ _ _ (congr!{{C.Complex} {Out.Carrier}} (\fun (a: C.Complex) => Out.space.smul a (rightValue omega eta)) _ _ (sym!{{C.Complex}} _ _ (Previous.firstSign N.Nat^::zero firstBound firstSide firstColor)))
        (Out.space.scalarOne (rightValue omega eta))));
\definition result: \forall (omega: FirstForm N.Nat^::zero x)(eta: SecondForm (N.Nat^::succ q) x) ->
  ((totalOperator side).fiber x).apply (placed N.Nat^::zero (N.Nat^::succ q) firstSide secondSide x omega eta) = outcome N.Nat^::zero (N.Nat^::succ q) x omega eta :=
  \fun (omega: FirstForm N.Nat^::zero x)(eta: SecondForm (N.Nat^::succ q) x) => trans!{{Out.Carrier}} _ _ _
    (congr!{{Models.Fiber (target side).ranks x} {Out.Carrier}} ((totalOperator side).fiber x).apply _ _
      (Placement.result N.Nat^::zero (N.Nat^::succ q) firstBound secondBound firstSide secondSide firstColor secondColor x omega eta))
    (trans!{{Out.Carrier}} _ _ _
      (Lower.total NativeLaw.input side (Previous.totalBound N.Nat^::zero (N.Nat^::succ q) firstBound secondBound) (Previous.totalColor N.Nat^::zero (N.Nat^::succ q) firstBound secondBound firstSide secondSide firstColor secondColor) (NativeLaw.pure omega eta))
      (trans!{{Out.Carrier}} _ _ _ (congr!{{Native NativeLaw.output x} {Out.Carrier}} (included NativeLaw.output output x) _ _ (NativeLaw.equation omega eta))
        (trans!{{Out.Carrier}} _ _ _ (rightPlacement omega eta) (sym!{{Out.Carrier}} _ _ (outcomeEquation omega eta)))));
