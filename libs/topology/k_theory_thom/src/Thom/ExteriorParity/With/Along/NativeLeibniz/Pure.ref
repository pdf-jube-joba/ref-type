\import \root.Thom[].Sum[V := F x, W := G x, left := left.space x, right := right.space x].DirectSum[k := k] \as Direct;
\definition index: Direct.Bidegree := Direct.make p q degree;
\import Direct.Component[d := index] \as Component;
\import Direct.At[d := index] \as Include;
\definition value[omega: FirstForm p x][eta: SecondForm q x]: Native k x := Include.injection.apply (Component.product omega eta);
\definition encoded[omega: FirstForm p x][eta: SecondForm q x]: Models.Fiber (totalTerm k).ranks x := ((data.total k).isomorphism.forward.fiber x).apply (value omega eta);
