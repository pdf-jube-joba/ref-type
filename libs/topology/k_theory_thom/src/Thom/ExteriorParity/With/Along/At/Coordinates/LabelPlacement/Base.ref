\import \parent.With[firstSide := first, secondSide := second] \as Canonical;
\definition equation[firstColor: first = first][secondColor: second = second]: Statement first second firstColor secondColor :=
  \fun (x: X)(v: Models.Fiber (firstTerm p).ranks x)(w: Models.Fiber (secondTerm q).ranks x) =>
    trans!{{Models.Fiber (model (ProductLabels.evenPair first second)).ranks x}} _ _ _ (Canonical.canonical firstColor secondColor x v w)
      (selectSame (ProductLabels.evenPair first second) x (((block first second).fiber x).apply (\parent.\parent.\parent.Slot[firstSide := first, secondSide := second].pure x
        (((First.at n s first (\refl(first))).fiber x).apply v) (((Second.at m t second (\refl(second))).fiber x).apply w))));
