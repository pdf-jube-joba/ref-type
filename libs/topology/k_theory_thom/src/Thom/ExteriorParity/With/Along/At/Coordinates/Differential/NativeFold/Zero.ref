\module At(p, q: N.Nat^, firstSide, secondSide: B.Bool^, x: X);
\definition first[p, q: N.Nat^][firstSide, secondSide: B.Bool^][x: X][eta: SecondForm q x]:
  placed p q firstSide secondSide x ((firstForms p).space x).zero eta = ((Models.bundle (target (ProductLabels.evenPair firstSide secondSide))).space x).zero :=
  At[p := p, q := q, firstSide := firstSide, secondSide := secondSide, x := x].first eta;
\definition second[p, q: N.Nat^][firstSide, secondSide: B.Bool^][x: X][omega: FirstForm p x]:
  placed p q firstSide secondSide x omega ((secondForms q).space x).zero = ((Models.bundle (target (ProductLabels.evenPair firstSide secondSide))).space x).zero :=
  At[p := p, q := q, firstSide := firstSide, secondSide := secondSide, x := x].second omega;
