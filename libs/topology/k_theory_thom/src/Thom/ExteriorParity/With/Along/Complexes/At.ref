      ((data.first k).isomorphism.forward.fiber x).preservesZero);
\import \root.Thom[].Contraction[X := X, F := G, bundle := right, section := secondSection, k := k] \as SecondRaw;
\import \root.Thom[].Contraction[X := X, F := G, bundle := right, section := secondSection, k := N.Nat^::succ k] \as SecondNext;
\definition second[v: Models.Fiber (secondTerm (N.Nat^::succ (N.Nat^::succ k))).ranks x]:
