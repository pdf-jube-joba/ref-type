\import \root.Thom[].Contraction[X := X, F := F, bundle := left, section := firstSection, k := k] \as FirstRaw;
\import \root.Thom[].Contraction[X := X, F := F, bundle := left, section := firstSection, k := N.Nat^::succ k] \as FirstNext;
\definition first[v: Models.Fiber (firstTerm (N.Nat^::succ (N.Nat^::succ k))).ranks x]:
  ((firstDifferential k).fiber x).apply (((firstDifferential (N.Nat^::succ k)).fiber x).apply v) = ((Models.bundle (firstTerm k)).space x).zero :=
  trans!{{Models.Fiber (firstTerm k).ranks x}} _ _ _
    (congr!{{FirstForm (N.Nat^::succ k) x} {Models.Fiber (firstTerm k).ranks x}}
      (\fun (w: FirstForm (N.Nat^::succ k) x) => ((data.first k).isomorphism.forward.fiber x).apply ((FirstRaw.map.fiber x).apply w)) _ _
      ((data.first (N.Nat^::succ k)).isomorphism.leftInverse x ((FirstNext.map.fiber x).apply (((data.first (N.Nat^::succ (N.Nat^::succ k))).isomorphism.backward.fiber x).apply v))))
    (trans!{{Models.Fiber (firstTerm k).ranks x}} _ _ _
      (congr!{{FirstForm k x} {Models.Fiber (firstTerm k).ranks x}} ((data.first k).isomorphism.forward.fiber x).apply _ _
