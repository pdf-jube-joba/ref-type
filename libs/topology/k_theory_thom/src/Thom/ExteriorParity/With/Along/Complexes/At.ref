\import \root.Thom[].SumComplex[X := X, F := F, G := G, left := left, right := right, sameBase := sameBase,
  firstSection := firstSection, secondSection := secondSection] \as SumComplex;
\import SumComplex.Degree[k := k] \as TotalRaw;
\import SumComplex.Degree[k := N.Nat^::succ k] \as TotalNext;
\definition total[v: Models.Fiber (totalTerm (N.Nat^::succ (N.Nat^::succ k))).ranks x]:
  ((totalDifferential k).fiber x).apply (((totalDifferential (N.Nat^::succ k)).fiber x).apply v) = ((Models.bundle (totalTerm k)).space x).zero :=
  trans!{{Models.Fiber (totalTerm k).ranks x}} _ _ _
    (congr!{{Native (N.Nat^::succ k) x} {Models.Fiber (totalTerm k).ranks x}}
