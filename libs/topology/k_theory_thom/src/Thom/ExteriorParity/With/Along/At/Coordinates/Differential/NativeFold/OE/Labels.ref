\import \parent.\parent.\parent.\parent.\parent.Slot[firstSide := firstSide, secondSide := secondSide] \as Source;
\import \parent.\parent.\parent.\parent.\parent.Slot[firstSide := Labels.flip firstSide, secondSide := secondSide] \as LeftTarget;
\import \parent.\parent.\parent.\parent.\parent.Slot[firstSide := firstSide, secondSide := Labels.flip secondSide] \as RightTarget;
\definition Out[x: X]: \Set := Models.Fiber (target output).ranks x;
\definition nativeSpace[x: X]: Spaces.VectorSpace (Out x) := (Models.bundle (target output)).space x;
\definition firstValue[s: First.Colored n firstSide][x: X][v: Models.Fiber (firstTerm (Labels.degree n s)).ranks x]: Models.Fiber (First.parity n firstSide).ranks x :=
  ((First.at n s firstSide (\bysub(Labels.Index n, First.Colored n firstSide, s))).fiber x).apply v;
\definition secondValue[t: Second.Colored m secondSide][x: X][w: Models.Fiber (secondTerm (Labels.degree m t)).ranks x]: Models.Fiber (Second.parity m secondSide).ranks x :=
  ((Second.at m t secondSide (\bysub(Labels.Index m, Second.Colored m secondSide, t))).fiber x).apply w;
\definition Statement: \Prop := \forall (s: First.Colored n firstSide)(t: Second.Colored m secondSide)(x: X)
  (v: Models.Fiber (firstTerm (Labels.degree n s)).ranks x)(w: Models.Fiber (secondTerm (Labels.degree m t)).ranks x) ->
  ((totalOperator side).fiber x).apply ((Source.forward.fiber x).apply (Source.pure x (firstValue s x v) (secondValue t x w))) =
  (nativeSpace x).add
    ((LeftTarget.forward.fiber x).apply (LeftTarget.pure x (((firstOperator firstSide).fiber x).apply (firstValue s x v)) (secondValue t x w)))
    ((nativeSpace x).smul (Color.color firstSide) ((RightTarget.forward.fiber x).apply (RightTarget.pure x (firstValue s x v) (((secondOperator secondSide).fiber x).apply (secondValue t x w)))));
\module At(s: First.Colored n firstSide, t: Second.Colored m secondSide, x: X,
  v: Models.Fiber (firstTerm (Labels.degree n s)).ranks x, w: Models.Fiber (secondTerm (Labels.degree m t)).ranks x);
\definition equation: Statement := \fun (s: First.Colored n firstSide)(t: Second.Colored m secondSide)(x: X)
  (v: Models.Fiber (firstTerm (Labels.degree n s)).ranks x)(w: Models.Fiber (secondTerm (Labels.degree m t)).ranks x) => At[s := s, t := t, x := x, v := v, w := w].equation;
