\module At(k: N.Nat^, x: X);
\definition firstSquare: \forall (k: N.Nat^)(x: X)(v: Models.Fiber (firstTerm (N.Nat^::succ (N.Nat^::succ k))).ranks x) ->
  ((firstDifferential k).fiber x).apply (((firstDifferential (N.Nat^::succ k)).fiber x).apply v) = ((Models.bundle (firstTerm k)).space x).zero :=
  \fun (k: N.Nat^)(x: X) => At[k := k, x := x].first;
\definition secondSquare: \forall (k: N.Nat^)(x: X)(v: Models.Fiber (secondTerm (N.Nat^::succ (N.Nat^::succ k))).ranks x) ->
  ((secondDifferential k).fiber x).apply (((secondDifferential (N.Nat^::succ k)).fiber x).apply v) = ((Models.bundle (secondTerm k)).space x).zero :=
  \fun (k: N.Nat^)(x: X) => At[k := k, x := x].second;
\definition totalSquare: \forall (k: N.Nat^)(x: X)(v: Models.Fiber (totalTerm (N.Nat^::succ (N.Nat^::succ k))).ranks x) ->
  ((totalDifferential k).fiber x).apply (((totalDifferential (N.Nat^::succ k)).fiber x).apply v) = ((Models.bundle (totalTerm k)).space x).zero :=
  \fun (k: N.Nat^)(x: X) => At[k := k, x := x].total;
\import \root.Thom[].Finite[X := X, baseSpace := left.baseSpace].Family[term := firstTerm, differential := firstDifferential, domain := { y: X \where Logic.False }] \as FirstFamily;
\import \root.Thom[].Finite[X := X, baseSpace := left.baseSpace].Family[term := secondTerm, differential := secondDifferential, domain := { y: X \where Logic.False }] \as SecondFamily;
\import \root.Thom[].Finite[X := X, baseSpace := left.baseSpace].Family[term := totalTerm, differential := totalDifferential, domain := { y: X \where Logic.False }] \as TotalFamily;
\definition firstExact[n: N.Nat^][x: X][inside: Logic.False][v: Models.Fiber (firstTerm n).ranks x][closed: FirstFamily.Closed n x v]:
  \exists (w: Models.Fiber (firstTerm (N.Nat^::succ n)).ranks x \where ((firstDifferential n).fiber x).apply w = v) := Logic.falseElim[_] inside;
\definition secondExact[n: N.Nat^][x: X][inside: Logic.False][v: Models.Fiber (secondTerm n).ranks x][closed: SecondFamily.Closed n x v]:
  \exists (w: Models.Fiber (secondTerm (N.Nat^::succ n)).ranks x \where ((secondDifferential n).fiber x).apply w = v) := Logic.falseElim[_] inside;
\definition totalExact[n: N.Nat^][x: X][inside: Logic.False][v: Models.Fiber (totalTerm n).ranks x][closed: TotalFamily.Closed n x v]:
  \exists (w: Models.Fiber (totalTerm (N.Nat^::succ n)).ranks x \where ((totalDifferential n).fiber x).apply w = v) := Logic.falseElim[_] inside;
