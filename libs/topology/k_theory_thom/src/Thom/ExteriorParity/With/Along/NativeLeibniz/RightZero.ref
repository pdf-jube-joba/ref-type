\import Raw.LeibnizRightZero[p := p] \as Bidegree;
\import Bidegree.At[x := x] \as Law;
\import Raw.Pure[p := N.Nat^::succ p, q := N.Nat^::zero].At[x := x] \as Input;
\definition output: N.Nat^ := Bidegree.outputDegree;
\definition input: N.Nat^ := N.Nat^::succ output;
\definition pure[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm N.Nat^::zero x]: Native input x := Input.pure omega eta;
\definition target[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm N.Nat^::zero x]: Native output x := Raw.Pure[p := p, q := N.Nat^::zero].At[x := x].pure (firstLower (N.Nat^::succ p) omega) eta;
\definition equation[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm N.Nat^::zero x]: nativeLower input (pure omega eta) = target omega eta := Law.equation omega eta;
\definition encodedEquation[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm N.Nat^::zero x]:
  ((codedLower input).fiber x).apply (((data.total input).isomorphism.forward.fiber x).apply (pure omega eta)) =
    ((data.total output).isomorphism.forward.fiber x).apply (target omega eta) :=
  trans!{{Models.Fiber (totalTerm output).ranks x}} _ _ _ (encodedLower input (pure omega eta))
    (congr!{{Native output x} {Models.Fiber (totalTerm output).ranks x}} ((data.total output).isomorphism.forward.fiber x).apply _ _ (equation omega eta));
