\import \parent.\parent.\parent.\parent.\parent.\parent.NativeLeibniz[x := x] \as Law;
\import \parent.\parent.Lower[x := x] \as Lower;
\import \parent.Output[x := x] \as Out;
\import Law.RightZero[p := p] \as NativeLaw;
\definition firstLowerColor: FirstLower.side n p = Labels.flip firstSide := trans!{{B.Bool^}} _ _ _ (Previous.side n p firstBound) (congr!{{B.Bool^} {B.Bool^}} Labels.flip _ _ firstColor);
\definition leftValue[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm N.Nat^::zero x]: Out.Carrier :=
  placed p N.Nat^::zero (Labels.flip firstSide) secondSide x (Law.firstLower (N.Nat^::succ p) omega) eta;
\definition leftPlacement[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm N.Nat^::zero x]:
  included NativeLaw.output output x (NativeLaw.target omega eta) = leftValue omega eta :=
  sym!{{Out.Carrier}} _ _ (Placement.result p N.Nat^::zero (Previous.bound n p firstBound) secondBound (Labels.flip firstSide) secondSide firstLowerColor secondColor x (Law.firstLower (N.Nat^::succ p) omega) eta);
\definition outcomeEquation[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm N.Nat^::zero x]: outcome (N.Nat^::succ p) N.Nat^::zero x omega eta = leftValue omega eta :=
  trans!{{Out.Carrier}} _ _ _
    (congr!{{Out.Carrier} {Out.Carrier}} (Out.space.add (leftValue omega eta)) _ _
      (trans!{{Out.Carrier}} _ _ _ (congr!{{Out.Carrier} {Out.Carrier}} (Out.space.smul (Color.color firstSide)) _ _
        (Zero.second (N.Nat^::succ p) N.Nat^::zero firstSide (Labels.flip secondSide) x omega)) (Out.scaleZero (Color.color firstSide))))
    (Out.zeroRight (leftValue omega eta));
\definition result: \forall (omega: FirstForm (N.Nat^::succ p) x)(eta: SecondForm N.Nat^::zero x) ->
  ((totalOperator side).fiber x).apply (placed (N.Nat^::succ p) N.Nat^::zero firstSide secondSide x omega eta) = outcome (N.Nat^::succ p) N.Nat^::zero x omega eta :=
  \fun (omega: FirstForm (N.Nat^::succ p) x)(eta: SecondForm N.Nat^::zero x) => trans!{{Out.Carrier}} _ _ _
    (congr!{{Models.Fiber (target side).ranks x} {Out.Carrier}} ((totalOperator side).fiber x).apply _ _
      (Placement.result (N.Nat^::succ p) N.Nat^::zero firstBound secondBound firstSide secondSide firstColor secondColor x omega eta))
    (trans!{{Out.Carrier}} _ _ _
      (Lower.total NativeLaw.input side (Previous.totalBound (N.Nat^::succ p) N.Nat^::zero firstBound secondBound) (Previous.totalColor (N.Nat^::succ p) N.Nat^::zero firstBound secondBound firstSide secondSide firstColor secondColor) (NativeLaw.pure omega eta))
      (trans!{{Out.Carrier}} _ _ _ (congr!{{Native NativeLaw.output x} {Out.Carrier}} (included NativeLaw.output output x) _ _ (NativeLaw.equation omega eta))
        (trans!{{Out.Carrier}} _ _ _ (leftPlacement omega eta) (sym!{{Out.Carrier}} _ _ (outcomeEquation omega eta)))));
