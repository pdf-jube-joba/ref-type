\definition a: Labels.Index n := Labels.rawLookup n p;
\definition b: Labels.Index m := Labels.rawLookup m q;
\import \parent.Labeled[a := a, b := b] \as AtLabels;
\definition result: Statement p q :=
  \idelim Labels.degree n a = p \with i: N.Nat^ => Statement i q \by {
    base: \idelim Labels.degree m b = q \with j: N.Nat^ => Statement (Labels.degree n a) j \by {
      base: AtLabels.result, equality: Labels.lookupDegree m q secondBound
    }, equality: Labels.lookupDegree n p firstBound
  };
