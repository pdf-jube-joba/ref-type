\definition degree: N.Nat^ := Nat.add n m;
\definition target[side: B.Bool^]: Models.Bundle := Total.parity degree side;
\import \root.Thom[].ComplexProductParity[X := X,
  F0 := Models.Fiber (First.parity n B.Bool^::true).ranks, F1 := Models.Fiber (First.parity n B.Bool^::false).ranks,
  G0 := Models.Fiber (Second.parity m B.Bool^::true).ranks, G1 := Models.Fiber (Second.parity m B.Bool^::false).ranks,
  e0 := Models.bundle (First.parity n B.Bool^::true), e1 := Models.bundle (First.parity n B.Bool^::false),
  f0 := Models.bundle (Second.parity m B.Bool^::true), f1 := Models.bundle (Second.parity m B.Bool^::false),
  sameE1 := (\refl(left.baseSpace)), sameF0 := (\refl(left.baseSpace)), sameF1 := (\refl(left.baseSpace))] \as Parity;
\module Slot(firstSide, secondSide: B.Bool^);
\import Slot[firstSide := B.Bool^::true, secondSide := B.Bool^::true] \as EE;
\import Slot[firstSide := B.Bool^::false, secondSide := B.Bool^::false] \as OO;
\import Slot[firstSide := B.Bool^::true, secondSide := B.Bool^::false] \as EO;
\import Slot[firstSide := B.Bool^::false, secondSide := B.Bool^::true] \as OE;
\import Operations.DirectSum[X := X, F := Parity.EEFiber, G := Parity.OOFiber, left := Parity.eeBundle, right := Parity.ooBundle]
  .Of[same := (\refl(left.baseSpace))].To[Y := X, H := Models.Fiber (target B.Bool^::true).ranks, target := Models.bundle (target B.Bool^::true), f := (\fun (x: X) => x)] \as EvenCopair;
\definition forwardEven: Bundles.Morphisms[X := X, Y := X, F := Parity.Even, G := Models.Fiber (target B.Bool^::true).ranks,
  source := Parity.evenBundle, target := Models.bundle (target B.Bool^::true), f := (\fun (x: X) => x)].Map := EvenCopair.copair EE.forward OO.forward;
\import Operations.DirectSum[X := X, F := Parity.EOFiber, G := Parity.OEFiber, left := Parity.eoBundle, right := Parity.oeBundle]
  .Of[same := (\refl(left.baseSpace))].To[Y := X, H := Models.Fiber (target B.Bool^::false).ranks, target := Models.bundle (target B.Bool^::false), f := (\fun (x: X) => x)] \as OddCopair;
\definition forwardOdd: Bundles.Morphisms[X := X, Y := X, F := Parity.Odd, G := Models.Fiber (target B.Bool^::false).ranks,
  source := Parity.oddBundle, target := Models.bundle (target B.Bool^::false), f := (\fun (x: X) => x)].Map := OddCopair.copair EO.forward OE.forward;
\module Coordinates(evenChoice: Models.From[F := Parity.Even, original := Parity.evenBundle].Result,
  oddChoice: Models.From[F := Parity.Odd, original := Parity.oddBundle].Result);
