\import \root.Thom[].Contraction[X := X, F := G, bundle := right, section := secondSection, k := k] \as Raw;
\import Bundles.Morphisms[X := X, Y := X, F := Models.Fiber (secondTerm (N.Nat^::succ k)).ranks, G := SecondForm (N.Nat^::succ k),
  source := Models.bundle (secondTerm (N.Nat^::succ k)), target := secondForms (N.Nat^::succ k), f := (\fun (x: X) => x)]
  .Composition[Z := X, H := SecondForm k, range := secondForms k, g := (\fun (x: X) => x)] \as Start;
\definition start: Bundles.Morphisms[X := X, Y := X, F := Models.Fiber (secondTerm (N.Nat^::succ k)).ranks, G := SecondForm k,
  source := Models.bundle (secondTerm (N.Nat^::succ k)), target := secondForms k, f := (\fun (x: X) => x)].Map :=
  Start.compose (data.second (N.Nat^::succ k)).isomorphism.backward Raw.map;
\import Bundles.Morphisms[X := X, Y := X, F := Models.Fiber (secondTerm (N.Nat^::succ k)).ranks, G := SecondForm k,
  source := Models.bundle (secondTerm (N.Nat^::succ k)), target := secondForms k, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Models.Fiber (secondTerm k).ranks, range := Models.bundle (secondTerm k), g := (\fun (x: X) => x)] \as Finish;
\definition map: Models.Map (secondTerm (N.Nat^::succ k)) (secondTerm k) := Finish.compose start (data.second k).isomorphism.forward;
