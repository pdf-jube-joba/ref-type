    (trans!{{Out.Carrier}} _ _ _
      (Lower.total N.Nat^::zero side (Previous.totalBound N.Nat^::zero N.Nat^::zero firstBound secondBound) (Previous.totalColor N.Nat^::zero N.Nat^::zero firstBound secondBound firstSide secondSide firstColor secondColor)
        (nativePure N.Nat^::zero N.Nat^::zero N.Nat^::zero (\refl(N.Nat^::zero)) x omega eta))
      (trans!{{Out.Carrier}} _ _ _ Include.map.preservesZero (sym!{{Out.Carrier}} _ _ (outcomeZero omega eta))));
