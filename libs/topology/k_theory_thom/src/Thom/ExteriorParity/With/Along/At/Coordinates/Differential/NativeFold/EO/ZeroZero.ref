\definition outcomeZero[omega: FirstForm N.Nat^::zero x][eta: SecondForm N.Nat^::zero x]: outcome N.Nat^::zero N.Nat^::zero x omega eta = Out.space.zero :=
  trans!{{Out.Carrier}} _ _ _
    (congr!{{Out.Carrier} {Out.Carrier} {Out.Carrier}} Out.space.add _ _ _ _ (Zero.first N.Nat^::zero N.Nat^::zero (Labels.flip firstSide) secondSide x eta)
      (congr!{{Out.Carrier} {Out.Carrier}} (Out.space.smul (Color.color firstSide)) _ _ (Zero.second N.Nat^::zero N.Nat^::zero firstSide (Labels.flip secondSide) x omega)))
    (trans!{{Out.Carrier}} _ _ _ (congr!{{Out.Carrier} {Out.Carrier}} (Out.space.add Out.space.zero) _ _ (Out.scaleZero (Color.color firstSide))) (Out.zeroLeft Out.space.zero));
\definition result: \forall (omega: FirstForm N.Nat^::zero x)(eta: SecondForm N.Nat^::zero x) ->
  ((totalOperator side).fiber x).apply (placed N.Nat^::zero N.Nat^::zero firstSide secondSide x omega eta) = outcome N.Nat^::zero N.Nat^::zero x omega eta :=
  \fun (omega: FirstForm N.Nat^::zero x)(eta: SecondForm N.Nat^::zero x) => trans!{{Out.Carrier}} _ _ _
    (congr!{{Models.Fiber (target side).ranks x} {Out.Carrier}} ((totalOperator side).fiber x).apply _ _
