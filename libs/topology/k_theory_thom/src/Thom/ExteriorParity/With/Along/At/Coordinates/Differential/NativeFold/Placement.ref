\definition Statement[p, q: N.Nat^]: \Prop := \forall (firstSide, secondSide: B.Bool^) -> FirstLower.side n p = firstSide -> SecondLower.side m q = secondSide -> \forall (x: X)(omega: FirstForm p x)(eta: SecondForm q x) ->
  placed p q firstSide secondSide x omega eta = included (Nat.add p q) (ProductLabels.evenPair firstSide secondSide) x (nativePure (Nat.add p q) p q (\refl(Nat.add p q)) x omega eta);
\module Labeled(a: Labels.Index n, b: Labels.Index m);
\module Choose(p, q: N.Nat^, firstBound: Naturals.Le p n, secondBound: Naturals.Le q m);
\definition result[p, q: N.Nat^][firstBound: Naturals.Le p n][secondBound: Naturals.Le q m]: Statement p q := Choose[p := p, q := q, firstBound := firstBound, secondBound := secondBound].result;
