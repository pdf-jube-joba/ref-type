\import \root.Thom[].SumComplex[X := X, F := F, G := G, left := left, right := right, sameBase := sameBase,
  firstSection := firstSection, secondSection := secondSection].Degree[k := k] \as Raw;
\import Bundles.Morphisms[X := X, Y := X, F := Models.Fiber (totalTerm (N.Nat^::succ k)).ranks, G := Native (N.Nat^::succ k),
  source := Models.bundle (totalTerm (N.Nat^::succ k)), target := native (N.Nat^::succ k), f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Native k, range := native k, g := (\fun (x: X) => x)] \as Start;
\definition start: Bundles.Morphisms[X := X, Y := X, F := Models.Fiber (totalTerm (N.Nat^::succ k)).ranks, G := Native k,
  source := Models.bundle (totalTerm (N.Nat^::succ k)), target := native k, f := (\fun (x: X) => x)].Map :=
  Start.compose (data.total (N.Nat^::succ k)).isomorphism.backward Raw.differential;
\import Bundles.Morphisms[X := X, Y := X, F := Models.Fiber (totalTerm (N.Nat^::succ k)).ranks, G := Native k,
  source := Models.bundle (totalTerm (N.Nat^::succ k)), target := native k, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Models.Fiber (totalTerm k).ranks, range := Models.bundle (totalTerm k), g := (\fun (x: X) => x)] \as Finish;
\definition map: Models.Map (totalTerm (N.Nat^::succ k)) (totalTerm k) := Finish.compose start (data.total k).isomorphism.forward;
