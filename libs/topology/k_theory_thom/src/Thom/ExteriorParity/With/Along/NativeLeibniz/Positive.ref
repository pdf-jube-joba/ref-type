\import Raw.Leibniz[p := p, q := q] \as Bidegree;
\import Bidegree.At[x := x] \as Law;
\definition output: N.Nat^ := Nat.add (N.Nat^::succ p) q;
\definition input: N.Nat^ := N.Nat^::succ output;
\definition pure[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm (N.Nat^::succ q) x]: Native input x := Law.pure omega eta;
\definition leftTerm[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm (N.Nat^::succ q) x]: Native output x := Law.leftTerm omega eta;
\definition rightTerm[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm (N.Nat^::succ q) x]: Native output x := Law.rightTerm omega eta;
\definition equation[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm (N.Nat^::succ q) x]:
  nativeLower input (pure omega eta) = ((native output).space x).add (leftTerm omega eta)
    (((native output).space x).smul (Sign.value (N.Nat^::succ p)) (rightTerm omega eta)) := Law.equation omega eta;
\definition encodedEquation[omega: FirstForm (N.Nat^::succ p) x][eta: SecondForm (N.Nat^::succ q) x]:
  ((codedLower input).fiber x).apply (((data.total input).isomorphism.forward.fiber x).apply (pure omega eta)) =
    ((data.total output).isomorphism.forward.fiber x).apply (((native output).space x).add (leftTerm omega eta)
      (((native output).space x).smul (Sign.value (N.Nat^::succ p)) (rightTerm omega eta))) :=
  trans!{{Models.Fiber (totalTerm output).ranks x}} _ _ _ (encodedLower input (pure omega eta))
    (congr!{{Native output x} {Models.Fiber (totalTerm output).ranks x}} ((data.total output).isomorphism.forward.fiber x).apply _ _ (equation omega eta));
