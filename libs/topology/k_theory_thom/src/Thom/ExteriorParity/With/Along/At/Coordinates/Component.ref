\definition p: N.Nat^ := i;
\definition q: N.Nat^ := Nat.sub k p;
\definition bound: Naturals.Le p k := Naturals.leOfSuccSucc p k (Naturals.succLeOfLt (N.Nat^::succ k) p (Fin.bound (N.Nat^::succ k) i));
\definition decomposition: Nat.add p q = k := Naturals.addSubOfLe p k bound;
\import \parent.Bidegree[p := p, q := q, side := side] \as Placement;
\import \root.Thom[].SumBundles[X := X, F := F, G := G, left := left, right := right, sameBase := sameBase, k := k]
  .Component[p := p, q := q, degree := decomposition] \as NativeComponent;
\import Bundles.Morphisms[X := X, Y := X, F := Models.Fiber (totalTerm k).ranks, G := Native k,
  source := Models.bundle (totalTerm k), target := native k, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Placement.Fiber, range := Placement.bundle, g := (\fun (x: X) => x)] \as Project;
\definition projected: Bundles.Morphisms[X := X, Y := X, F := Models.Fiber (totalTerm k).ranks, G := Placement.Fiber,
  source := Models.bundle (totalTerm k), target := Placement.bundle, f := (\fun (x: X) => x)].Map := Project.compose (data.total k).isomorphism.backward NativeComponent.projection;
\import Bundles.Morphisms[X := X, Y := X, F := Models.Fiber (totalTerm k).ranks, G := Placement.Fiber,
  source := Models.bundle (totalTerm k), target := Placement.bundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Models.Fiber (model side).ranks, range := Models.bundle (model side), g := (\fun (x: X) => x)] \as Finish;
\definition map: Models.Map (totalTerm k) (model side) := Finish.compose projected Placement.map;
