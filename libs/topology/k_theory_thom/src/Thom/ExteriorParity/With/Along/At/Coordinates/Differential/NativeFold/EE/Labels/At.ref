\import \parent.\parent.\parent.Decoding[firstSide := firstSide, secondSide := secondSide, s := s, t := t, x := x, v := v, w := w] \as Decoded;
\definition equation: ((totalOperator side).fiber x).apply ((Source.forward.fiber x).apply (Source.pure x (firstValue s x v) (secondValue t x w))) =
  (nativeSpace x).add
    ((LeftTarget.forward.fiber x).apply (LeftTarget.pure x (((firstOperator firstSide).fiber x).apply (firstValue s x v)) (secondValue t x w)))
    ((nativeSpace x).smul (Color.color firstSide) ((RightTarget.forward.fiber x).apply (RightTarget.pure x (firstValue s x v) (((secondOperator secondSide).fiber x).apply (secondValue t x w))))) :=
  trans!{{Out x}} _ _ _
    (congr!{{Models.Fiber (target side).ranks x} {Out x}} ((totalOperator side).fiber x).apply _ _ (sym!{{Models.Fiber (target side).ranks x}} _ _ Decoded.input))
    (trans!{{Out x}} _ _ _
      (formsLaw (Labels.degree n s) (Labels.degree m t) (Labels.degreeBound n s) (Labels.degreeBound m t) Decoded.firstColor Decoded.secondColor x Decoded.omega Decoded.eta)
      (congr!{{Out x} {Out x} {Out x}} (nativeSpace x).add _ _ _ _ Decoded.leftTerm
        (congr!{{Out x} {Out x}} ((nativeSpace x).smul (Color.color firstSide)) _ _ Decoded.rightTerm)));
