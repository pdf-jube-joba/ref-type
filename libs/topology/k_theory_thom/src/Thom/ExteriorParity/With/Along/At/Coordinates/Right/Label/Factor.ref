\definition canonical: Direct.Bidegree := Direct.make d.p d.q (Direct.degree d);
\definition same: canonical = d := Direct.ext canonical d (\refl(d.p)) (\refl(d.q));
\import \parent.Component[p := d.p, q := d.q, decomposition := Direct.degree d] \as Canonical;
\definition equation: \forall (v: Direct.family.Carrier d) -> composite.apply (Direct.At[d := d].injection.apply v) = embedding.apply (Direct.At[d := d].injection.apply v) :=
  \idelim canonical = d \with index: Direct.Bidegree => \forall (v: Direct.family.Carrier index) ->
    composite.apply (Direct.At[d := index].injection.apply v) = embedding.apply (Direct.At[d := index].injection.apply v) \by {
      base: Canonical.equation, equality: same
    };
