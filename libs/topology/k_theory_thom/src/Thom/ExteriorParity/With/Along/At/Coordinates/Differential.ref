\import C.Def[] \as Op;
\import Spaces.Sign[] \as Sign;
\import \parent.\parent.\parent.Complexes[] \as Complexes;
\import \root.Thom[].Finite[X := X, baseSpace := left.baseSpace].Family[term := firstTerm, differential := firstDifferential, domain := { y: X \where Logic.False }]
  .With[squareZero := Complexes.firstSquare, exact := Complexes.firstExact].OnSummands[] \as FirstBoundary;
\import \root.Thom[].Finite[X := X, baseSpace := left.baseSpace].Family[term := secondTerm, differential := secondDifferential, domain := { y: X \where Logic.False }]
  .With[squareZero := Complexes.secondSquare, exact := Complexes.secondExact].OnSummands[] \as SecondBoundary;
\import \root.Thom[].Finite[X := X, baseSpace := left.baseSpace].Family[term := totalTerm, differential := totalDifferential, domain := { y: X \where Logic.False }]
  .With[squareZero := Complexes.totalSquare, exact := Complexes.totalExact].OnSummands[] \as TotalBoundary;
\definition firstOperator[side: B.Bool^]: Models.Map (First.parity n side) (First.parity n (Labels.flip side)) := FirstBoundary.boundary n side;
\definition secondOperator[side: B.Bool^]: Models.Map (Second.parity m side) (Second.parity m (Labels.flip side)) := SecondBoundary.boundary m side;
\definition totalOperator[side: B.Bool^]: Models.Map (target side) (target (Labels.flip side)) := TotalBoundary.boundary degree side;
\module Factory(firstForward: Models.Map (First.parity n B.Bool^::true) (First.parity n B.Bool^::false),
  firstBackward: Models.Map (First.parity n B.Bool^::false) (First.parity n B.Bool^::true),
  secondForward: Models.Map (Second.parity m B.Bool^::true) (Second.parity m B.Bool^::false),
  secondBackward: Models.Map (Second.parity m B.Bool^::false) (Second.parity m B.Bool^::true));
\import Factory[firstForward := firstOperator B.Bool^::true, firstBackward := firstOperator B.Bool^::false,
  secondForward := secondOperator B.Bool^::true, secondBackward := secondOperator B.Bool^::false] \as Contraction;
\definition coded[side: B.Bool^]: Models.Map (model side) (model (Labels.flip side)) := Contraction.coded side;
