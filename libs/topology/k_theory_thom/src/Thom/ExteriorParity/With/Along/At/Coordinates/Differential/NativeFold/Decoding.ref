\definition p: N.Nat^ := Labels.degree n s;
\definition q: N.Nat^ := Labels.degree m t;
\definition firstColor: FirstLower.side n p = firstSide := trans!{{B.Bool^}} _ _ _
  (congr!{{Labels.Index n} {B.Bool^}} (Labels.even n) _ _ (ProductLabels.lookupInverse n s)) (\bysub(Labels.Index n, First.Colored n firstSide, s));
\definition secondColor: SecondLower.side m q = secondSide := trans!{{B.Bool^}} _ _ _
  (congr!{{Labels.Index m} {B.Bool^}} (Labels.even m) _ _ (ProductLabels.lookupInverse m t)) (\bysub(Labels.Index m, Second.Colored m secondSide, t));
\definition omega: FirstForm p x := ((data.first p).isomorphism.backward.fiber x).apply v;
\definition eta: SecondForm q x := ((data.second q).isomorphism.backward.fiber x).apply w;
\definition firstValue: Models.Fiber (First.parity n firstSide).ranks x := ((First.at n s firstSide (\bysub(Labels.Index n, First.Colored n firstSide, s))).fiber x).apply v;
\definition secondValue: Models.Fiber (Second.parity m secondSide).ranks x := ((Second.at m t secondSide (\bysub(Labels.Index m, Second.Colored m secondSide, t))).fiber x).apply w;
\definition firstInput: ((FirstLower.degreeInjection n p firstSide).fiber x).apply (((data.first p).isomorphism.forward.fiber x).apply omega) = firstValue :=
  trans!{{Models.Fiber (First.parity n firstSide).ranks x}} _ _ _
    (congr!{{Models.Fiber (firstTerm p).ranks x} {Models.Fiber (First.parity n firstSide).ranks x}} ((FirstLower.degreeInjection n p firstSide).fiber x).apply _ _ ((data.first p).isomorphism.rightInverse x v))
    (FirstLower.atLabel n s firstSide x v);
\definition secondInput: ((SecondLower.degreeInjection m q secondSide).fiber x).apply (((data.second q).isomorphism.forward.fiber x).apply eta) = secondValue :=
  trans!{{Models.Fiber (Second.parity m secondSide).ranks x}} _ _ _
    (congr!{{Models.Fiber (secondTerm q).ranks x} {Models.Fiber (Second.parity m secondSide).ranks x}} ((SecondLower.degreeInjection m q secondSide).fiber x).apply _ _ ((data.second q).isomorphism.rightInverse x w))
    (SecondLower.atLabel m t secondSide x w);
\import \parent.\parent.\parent.\parent.\parent.NativeLeibniz[x := x] \as NativeLaw;
\import \parent.Lower[x := x] \as Lower;
\definition firstLower: ((FirstLower.degreeInjection n (Nat.pred p) (Labels.flip firstSide)).fiber x).apply (((data.first (Nat.pred p)).isomorphism.forward.fiber x).apply (NativeLaw.firstLower p omega)) =
  ((firstOperator firstSide).fiber x).apply firstValue :=
  trans!{{Models.Fiber (First.parity n (Labels.flip firstSide)).ranks x}} _ _ _
    (sym!{{Models.Fiber (First.parity n (Labels.flip firstSide)).ranks x}} _ _ (Lower.first p firstSide (Labels.degreeBound n s) firstColor omega))
    (congr!{{Models.Fiber (First.parity n firstSide).ranks x} {Models.Fiber (First.parity n (Labels.flip firstSide)).ranks x}} ((firstOperator firstSide).fiber x).apply _ _ firstInput);
\definition secondLower: ((SecondLower.degreeInjection m (Nat.pred q) (Labels.flip secondSide)).fiber x).apply (((data.second (Nat.pred q)).isomorphism.forward.fiber x).apply (NativeLaw.secondLower q eta)) =
  ((secondOperator secondSide).fiber x).apply secondValue :=
  trans!{{Models.Fiber (Second.parity m (Labels.flip secondSide)).ranks x}} _ _ _
    (sym!{{Models.Fiber (Second.parity m (Labels.flip secondSide)).ranks x}} _ _ (Lower.second q secondSide (Labels.degreeBound m t) secondColor eta))
    (congr!{{Models.Fiber (Second.parity m secondSide).ranks x} {Models.Fiber (Second.parity m (Labels.flip secondSide)).ranks x}} ((secondOperator secondSide).fiber x).apply _ _ secondInput);
\import \parent.\parent.\parent.\parent.Slot[firstSide := firstSide, secondSide := secondSide] \as Input;
\definition input: placed p q firstSide secondSide x omega eta = (Input.forward.fiber x).apply (Input.pure x firstValue secondValue) :=
  congr!{{Models.Fiber (First.parity n firstSide).ranks x} {Models.Fiber (Second.parity m secondSide).ranks x} {Models.Fiber (target (ProductLabels.evenPair firstSide secondSide)).ranks x}}
    (\fun (a: Models.Fiber (First.parity n firstSide).ranks x)(b: Models.Fiber (Second.parity m secondSide).ranks x) => (Input.forward.fiber x).apply (Input.pure x a b)) _ _ _ _ firstInput secondInput;
\import \parent.\parent.\parent.\parent.Slot[firstSide := Labels.flip firstSide, secondSide := secondSide] \as LeftTerm;
\definition leftTerm: placed (Nat.pred p) q (Labels.flip firstSide) secondSide x (NativeLaw.firstLower p omega) eta =
  (LeftTerm.forward.fiber x).apply (LeftTerm.pure x (((firstOperator firstSide).fiber x).apply firstValue) secondValue) :=
  congr!{{Models.Fiber (First.parity n (Labels.flip firstSide)).ranks x} {Models.Fiber (Second.parity m secondSide).ranks x} {Models.Fiber (target (ProductLabels.evenPair (Labels.flip firstSide) secondSide)).ranks x}}
    (\fun (a: Models.Fiber (First.parity n (Labels.flip firstSide)).ranks x)(b: Models.Fiber (Second.parity m secondSide).ranks x) => (LeftTerm.forward.fiber x).apply (LeftTerm.pure x a b)) _ _ _ _ firstLower secondInput;
\import \parent.\parent.\parent.\parent.Slot[firstSide := firstSide, secondSide := Labels.flip secondSide] \as RightTerm;
\definition rightTerm: placed p (Nat.pred q) firstSide (Labels.flip secondSide) x omega (NativeLaw.secondLower q eta) =
  (RightTerm.forward.fiber x).apply (RightTerm.pure x firstValue (((secondOperator secondSide).fiber x).apply secondValue)) :=
  congr!{{Models.Fiber (First.parity n firstSide).ranks x} {Models.Fiber (Second.parity m (Labels.flip secondSide)).ranks x} {Models.Fiber (target (ProductLabels.evenPair firstSide (Labels.flip secondSide))).ranks x}}
    (\fun (a: Models.Fiber (First.parity n firstSide).ranks x)(b: Models.Fiber (Second.parity m (Labels.flip secondSide)).ranks x) => (RightTerm.forward.fiber x).apply (RightTerm.pure x a b)) _ _ _ _ firstInput secondLower;
