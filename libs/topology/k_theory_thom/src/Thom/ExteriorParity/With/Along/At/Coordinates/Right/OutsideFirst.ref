\definition result: Generator p q := \fun (r: Labels.Index degree)(side: B.Bool^)(color: Labels.even degree r = side)
  (decomposition: Nat.add p q = Labels.degree degree r)(omega: FirstForm p x)(eta: SecondForm q x) =>
    \parent.Piece[r := r, p := p, q := q, decomposition := decomposition].firstZero side color omega eta (firstVanishing p negative x omega);
