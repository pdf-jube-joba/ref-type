\import std.Data[].List[] \as Lists;
\definition Index: \Set := Fin.Fin (N.Nat^::succ k);
\import Operations.MapOperations[X := X, F := Models.Fiber (totalTerm k).ranks, G := Models.Fiber (model side).ranks,
  source := Models.bundle (totalTerm k), target := Models.bundle (model side)] \as Maps;
\definition sum[xs: Lists.List[Index]][maps: Index -> Maps.Map]: Maps.Map :=
  Lists.foldr Index Maps.Map (\fun (i: Index)(tail: Maps.Map) => Maps.add (maps i) tail) (Models.zero (totalTerm k) (model side)) xs;
\definition components[i: Index]: Maps.Map := \parent.Component[k := k, side := side, i := i].map;
\definition map: Models.Map (totalTerm k) (model side) := sum (Fin.elements (N.Nat^::succ k)) components;
\module At(x: X);
