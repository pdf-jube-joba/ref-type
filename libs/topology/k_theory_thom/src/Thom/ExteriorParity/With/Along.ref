\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as Naturals;
\import std.Data[].Bool[] \as B;
\import \root.Thom[].FiniteLabels[] \as Labels;
\import \root.Thom[].ComplexProductLabels[] \as ProductLabels;
\module FirstDifferential(k: N.Nat^);
\module SecondDifferential(k: N.Nat^);
\module TotalDifferential(k: N.Nat^);
\definition firstDifferential[k: N.Nat^]: Models.Map (firstTerm (N.Nat^::succ k)) (firstTerm k) := FirstDifferential[k := k].map;
\definition secondDifferential[k: N.Nat^]: Models.Map (secondTerm (N.Nat^::succ k)) (secondTerm k) := SecondDifferential[k := k].map;
\definition totalDifferential[k: N.Nat^]: Models.Map (totalTerm (N.Nat^::succ k)) (totalTerm k) := TotalDifferential[k := k].map;
\import \root.Thom[].Finite[X := X, baseSpace := left.baseSpace].Family[term := firstTerm, differential := firstDifferential, domain := { x: X \where Logic.False }].Summands[] \as First;
\import \root.Thom[].Finite[X := X, baseSpace := left.baseSpace].Family[term := secondTerm, differential := secondDifferential, domain := { x: X \where Logic.False }].Summands[] \as Second;
\import \root.Thom[].Finite[X := X, baseSpace := left.baseSpace].Family[term := totalTerm, differential := totalDifferential, domain := { x: X \where Logic.False }].Summands[] \as Total;
\import \root.Thom[].ComplexProductTensorDouble[X := X, space := left.baseSpace, firstTerm := firstTerm, secondTerm := secondTerm,
  firstDifferential := firstDifferential, secondDifferential := secondDifferential] \as Tensor;
\module Complexes;
\module At(n, m: N.Nat^);

\module NativeLeibniz(x: X);
