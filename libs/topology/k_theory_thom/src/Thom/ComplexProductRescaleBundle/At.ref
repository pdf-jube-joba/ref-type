\import Compact.Acyclic[p := p, q := q, d := d, e := e] \as Acyclic;
\import Acyclic.Normalized[c := c] \as Normal;
\import Operations.MapOperations[X := X, F := Models.Fiber p.ranks, G := Models.Fiber q.ranks, source := Models.bundle p, target := Models.bundle q] \as Forward;
\import Operations.MapOperations[X := X, F := Models.Fiber q.ranks, G := Models.Fiber p.ranks, source := Models.bundle q, target := Models.bundle p] \as Backward;
\module With(scale, reciprocal: X -> C.Complex,
  scaleContinuous: topology.Continuity[A := X, B := C.Complex].Continuous space Scalars.scalar.topological.space scale,
  reciprocalContinuous: topology.Continuity[A := X, B := C.Complex].Continuous space Scalars.scalar.topological.space reciprocal,
  inverseLaw: \forall (x: X) -> Scalar.mul (reciprocal x) (scale x) = Scalar.one);
\module Homotopy;
