\definition forward: Models.Map p q := Forward.add d (Forward.functionScale scale Normal.k scaleContinuous);
\definition backward: Models.Map q p := Backward.add e (Backward.functionScale scale Normal.h scaleContinuous);
\definition inverse: Models.Map q p := Backward.functionScale reciprocal backward reciprocalContinuous;
\module Fiber(x: X);
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Models.Fiber p.ranks, G := Models.Fiber q.ranks, source := Models.bundle p, target := Models.bundle q].Isomorphism :=
  Bundles.Isomorphisms[X := X, F := Models.Fiber p.ranks, G := Models.Fiber q.ranks, source := Models.bundle p, target := Models.bundle q].Isomorphism {
    forward := forward, backward := inverse,
    leftInverse := \fun (x: X) => Fiber[x := x].left,
    rightInverse := \fun (x: X) => Fiber[x := x].right
  };
