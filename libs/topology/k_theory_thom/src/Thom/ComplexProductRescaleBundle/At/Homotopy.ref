\import algebraic_topology.Interval[] \as I;
\import algebraic_topology.Cylinder[A := X] \as Cylinder;
\import topological_constructions.Product[A := I.Carrier, B := X] \as Product;
\definition cylinderCompact: topology.Topology[Carrier := Cylinder.Carrier].IsCompact (Cylinder.topology space) := Product.Compactness[].productCompact I.topology space I.compact compact;
\definition cylinderHausdorff: topology.Topology[Carrier := Cylinder.Carrier].IsT2 (Cylinder.topology space) :=
  topological_constructions.Separation[].Product[A := I.Carrier, B := X].On[left := I.topology, right := space, leftHausdorff := I.hausdorff, rightHausdorff := hausdorff].hausdorff;
\import Operations.Models[X := Cylinder.Carrier, baseSpace := Cylinder.topology space] \as CylinderModels;
\import Models.Pullback[b := p, Y := Cylinder.Carrier, source := Cylinder.topology space, f := Cylinder.point, regular := Cylinder.pointContinuous space] \as P;
\import Models.Pullback[b := q, Y := Cylinder.Carrier, source := Cylinder.topology space, f := Cylinder.point, regular := Cylinder.pointContinuous space] \as Q;
\import Models.PullbackMap[p := p, q := q, Y := Cylinder.Carrier, source := Cylinder.topology space, f := Cylinder.point, regular := Cylinder.pointContinuous space] \as D;
\import Models.PullbackMap[p := q, q := p, Y := Cylinder.Carrier, source := Cylinder.topology space, f := Cylinder.point, regular := Cylinder.pointContinuous space] \as E;
\import compact_support_k.Support[].CompactBundles[X := Cylinder.Carrier, space := Cylinder.topology space, compact := cylinderCompact, hausdorff := cylinderHausdorff] \as CylinderCompact;
\import CylinderCompact.Acyclic[p := P.value, q := Q.value, d := D.map d, e := E.map e] \as CylinderAcyclic;
\definition contraction: CylinderAcyclic.Contraction := CylinderAcyclic.Contraction {
  h := E.map c.h, k := D.map c.k, laws := \fun (z: Cylinder.Carrier) => c.laws (Cylinder.point z)
};
\import \root.Thom[].ComplexProductRescaleBundle[X := Cylinder.Carrier, space := Cylinder.topology space,
  compact := cylinderCompact, hausdorff := cylinderHausdorff].At[p := P.value, q := Q.value, d := D.map d, e := E.map e, c := contraction] \as Family;
\module Using(scale, reciprocal: Cylinder.Carrier -> C.Complex,
  scaleContinuous: topology.Continuity[A := Cylinder.Carrier, B := C.Complex].Continuous (Cylinder.topology space) Scalars.scalar.topological.space scale,
  reciprocalContinuous: topology.Continuity[A := Cylinder.Carrier, B := C.Complex].Continuous (Cylinder.topology space) Scalars.scalar.topological.space reciprocal,
  inverseLaw: \forall (z: Cylinder.Carrier) -> Scalar.mul (reciprocal z) (scale z) = Scalar.one);
