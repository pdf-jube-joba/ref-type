\import Operations.ContractingPair[V := Models.Fiber p.ranks x, W := Models.Fiber q.ranks x,
  even := (Models.bundle p).space x, odd := (Models.bundle q).space x] \as Pair;
\definition pair: Pair.Pair := \into[Pair.Data](Pair.Data { d := d.fiber x, e := e.fiber x, h := c.h.fiber x, k := c.k.fiber x }, Pair.Pair) \by { c.laws x };
\import \root.Thom[].ComplexProductRescale[V := Models.Fiber p.ranks x, W := Models.Fiber q.ranks x,
  even := (Models.bundle p).space x, odd := (Models.bundle q).space x, c := pair].At[t := scale x] \as Rescale;
\definition left: \forall (v: Models.Fiber p.ranks x) -> (inverse.fiber x).apply ((forward.fiber x).apply v) = v :=
  \fun (v: Models.Fiber p.ranks x) => trans!{{Models.Fiber p.ranks x}} _ _ _
    (congr!{{Models.Fiber p.ranks x} {Models.Fiber p.ranks x}} (((Models.bundle p).space x).smul (reciprocal x)) _ _ (Rescale.left v))
    (trans!{{Models.Fiber p.ranks x}} _ _ _
      (sym!{{Models.Fiber p.ranks x}} _ _ (((Models.bundle p).space x).scalarAssoc (reciprocal x) (scale x) v))
      (trans!{{Models.Fiber p.ranks x}} _ _ _
        (congr!{{C.Complex} {Models.Fiber p.ranks x}} (\fun (a: C.Complex) => ((Models.bundle p).space x).smul a v) _ _ (inverseLaw x)) (((Models.bundle p).space x).scalarOne v)));
\definition right: \forall (v: Models.Fiber q.ranks x) -> (forward.fiber x).apply ((inverse.fiber x).apply v) = v :=
  \fun (v: Models.Fiber q.ranks x) => trans!{{Models.Fiber q.ranks x}} _ _ _
    ((forward.fiber x).preservesScale (reciprocal x) ((backward.fiber x).apply v))
    (trans!{{Models.Fiber q.ranks x}} _ _ _
      (congr!{{Models.Fiber q.ranks x} {Models.Fiber q.ranks x}} (((Models.bundle q).space x).smul (reciprocal x)) _ _ (Rescale.right v))
      (trans!{{Models.Fiber q.ranks x}} _ _ _
        (sym!{{Models.Fiber q.ranks x}} _ _ (((Models.bundle q).space x).scalarAssoc (reciprocal x) (scale x) v))
        (trans!{{Models.Fiber q.ranks x}} _ _ _
          (congr!{{C.Complex} {Models.Fiber q.ranks x}} (\fun (a: C.Complex) => ((Models.bundle q).space x).smul a v) _ _ (inverseLaw x)) (((Models.bundle q).space x).scalarOne v))));
