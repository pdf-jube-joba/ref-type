\import Family.With[scale := scale, reciprocal := reciprocal, scaleContinuous := scaleContinuous, reciprocalContinuous := reciprocalContinuous, inverseLaw := inverseLaw] \as Rescaled;
\definition isomorphism: Bundles.Isomorphisms[X := Cylinder.Carrier,
  F := (\fun (z: Cylinder.Carrier) => Models.Fiber p.ranks (Cylinder.point z)),
  G := (\fun (z: Cylinder.Carrier) => Models.Fiber q.ranks (Cylinder.point z)), source := CylinderModels.bundle P.value, target := CylinderModels.bundle Q.value].Isomorphism := Rescaled.isomorphism;
\definition formula[t: I.Carrier][x: X][v: Models.Fiber p.ranks x]:
  (isomorphism.forward.fiber (Cylinder.at t x)).apply v = ((Models.bundle q).space x).add
    ((d.fiber x).apply v) (((Models.bundle q).space x).smul (scale (Cylinder.at t x)) ((Normal.k.fiber x).apply v)) :=
  \refl((isomorphism.forward.fiber (Cylinder.at t x)).apply v);
\definition start[atStart: \forall (x: X) -> scale (Cylinder.at I.start x) = Scalar.one]:
  \forall (x: X)(v: Models.Fiber p.ranks x) -> (isomorphism.forward.fiber (Cylinder.at I.start x)).apply v = (Normal.forward.fiber x).apply v :=
  \fun (x: X)(v: Models.Fiber p.ranks x) => trans!{{Models.Fiber q.ranks x}} _ _ _ (formula I.start x v)
    (congr!{{Models.Fiber q.ranks x} {Models.Fiber q.ranks x}} (((Models.bundle q).space x).add ((d.fiber x).apply v)) _ _
      (trans!{{Models.Fiber q.ranks x}} _ _ _
        (congr!{{C.Complex} {Models.Fiber q.ranks x}} (\fun (a: C.Complex) => ((Models.bundle q).space x).smul a ((Normal.k.fiber x).apply v)) _ _ (atStart x))
        (((Models.bundle q).space x).scalarOne ((Normal.k.fiber x).apply v))));
\definition end[target: X -> C.Complex][atEnd: \forall (x: X) -> scale (Cylinder.at I.end x) = target x]:
  \forall (x: X)(v: Models.Fiber p.ranks x) -> (isomorphism.forward.fiber (Cylinder.at I.end x)).apply v = ((Models.bundle q).space x).add
    ((d.fiber x).apply v) (((Models.bundle q).space x).smul (target x) ((Normal.k.fiber x).apply v)) :=
  \fun (x: X)(v: Models.Fiber p.ranks x) => trans!{{Models.Fiber q.ranks x}} _ _ _ (formula I.end x v)
    (congr!{{Models.Fiber q.ranks x} {Models.Fiber q.ranks x}} (((Models.bundle q).space x).add ((d.fiber x).apply v)) _ _
      (congr!{{C.Complex} {Models.Fiber q.ranks x}} (\fun (a: C.Complex) => ((Models.bundle q).space x).smul a ((Normal.k.fiber x).apply v)) _ _ (atEnd x)));
