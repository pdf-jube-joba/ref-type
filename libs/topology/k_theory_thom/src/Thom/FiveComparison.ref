\import std.Alg[].Alg[] \as Alg;
\import std.Arithmetic[].Int[] \as I;
\import module_theory.Module[].Over[R := I.Int^, ring := std.Arithmetic[].IntAlgebra[].Ring[].ring] \as Modules;
\structure Bundle := { Carrier: \Set, group: Alg.CommutativeGroup[Carrier] };
\definition Map[A, B: Bundle]: \Set := algebra.Exact[A := A.Carrier, B := B.Carrier].Groups[source := A.group, target := B.group].Map;
\definition Injective[A, B: Bundle][f: Map A B]: \Prop := \forall (x, y: A.Carrier) -> f x = f y -> x = y;
\definition Surjective[A, B: Bundle][f: Map A B]: \Prop := \forall (y: B.Carrier) -> \exists (x: A.Carrier \where f x = y);
\structure Bijective[A, B: Bundle, f: Map A B]: \Prop := { injective: Injective A B f, onto: Surjective A B f };
\module AsModule(A: Bundle);
\module Linear(A, B: Bundle);
\module Exact(A, B, C, D, E: Bundle);
\module Diagram(A, B, C, D, E, A1, B1, C1, D1, E1: Bundle);
\module Maps(A, B: Bundle);
