\import Operations.DirectSumMiddleSwap[X := X, F := E0, G := H, H := E1, I := H,
  first := even, second := auxiliary, third := odd, fourth := auxiliary,
  sameSecond := sameAuxiliary, sameThird := sameOdd, sameFourth := sameAuxiliary] \as Shuffle;
\definition SourceFiber[x: X]: \Set := Shuffle.SourceFiber x;
\definition TargetFiber[x: X]: \Set := Shuffle.TargetFiber x;
\definition sourceBundle: Bundles.Family[X := X, F := SourceFiber].Bundle := Shuffle.sourceBundle;
\definition targetBundle: Bundles.Family[X := X, F := TargetFiber].Bundle := Shuffle.targetBundle;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := SourceFiber, G := TargetFiber, source := sourceBundle, target := targetBundle].Isomorphism := Shuffle.isomorphism;
\import Bundles.Morphisms[X := X, Y := X, F := E0, G := E1, source := even, target := odd, f := (\fun (x: X) => x)] \as Forward;
\import Bundles.Morphisms[X := X, Y := X, F := E1, G := E0, source := odd, target := even, f := (\fun (x: X) => x)] \as Backward;
\module With(d: Forward.Map, e: Backward.Map, radius: X -> C.Complex,
  continuous: topology.Continuity[A := X, B := C.Complex].Continuous even.baseSpace Scalars.scalar.topological.space radius);
