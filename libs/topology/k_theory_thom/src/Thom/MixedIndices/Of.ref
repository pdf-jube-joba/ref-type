\import Fin.FromList[A := Fin.Fin n] \as LeftTuples;
\import Fin.FromList[A := Fin.Fin m] \as RightTuples;
\definition p: N.Nat^ := Lists.length (Fin.Fin n) parts.left;
\definition q: N.Nat^ := Lists.length (Fin.Fin m) parts.right;
\definition left: Fin.Fin p -> Fin.Fin n := LeftTuples.tuple parts.left;
\definition right: Fin.Fin q -> Fin.Fin m := RightTuples.tuple parts.right;
\definition leftIncreasing: Fin.Ordering[].Increasing p n left := LeftOrder.toTuple parts.left parts.leftIncreasing;
\definition rightIncreasing: Fin.Ordering[].Increasing q m right := RightOrder.toTuple parts.right parts.rightIncreasing;
\definition totalDegree: Nat.add p q = Lists.length (Fin.Fin Indices.total) xs := degree xs parts;
\definition equation: joined (LeftTuples.list p left) (RightTuples.list q right) = xs :=
  trans!{{Lists.List[Fin.Fin Indices.total]}} _ _ _
    (congr!{{Lists.List[Fin.Fin n]} {Lists.List[Fin.Fin m]} {Lists.List[Fin.Fin Indices.total]}} joined _ _ _ _
      (LeftTuples.listTuple parts.left) (RightTuples.listTuple parts.right)) parts.equation;
