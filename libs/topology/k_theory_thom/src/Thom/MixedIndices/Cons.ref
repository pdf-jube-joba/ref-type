\definition forIndex: \forall (index: Indices.Index) ->
  All.Holds (\fun (i: Fin.Fin Indices.total) => Naturals.Lt (Indices.inflate index) i) xs ->
  \exists Split (Lists.List[Fin.Fin Indices.total]::cons (Indices.inflate index) xs) :=
  \induction (index: Indices.Index) \return
    All.Holds (\fun (i: Fin.Fin Indices.total) => Naturals.Lt (Indices.inflate index) i) xs ->
    \exists Split (Lists.List[Fin.Fin Indices.total]::cons (Indices.inflate index) xs) \with {
      | inl: \fun (a: Fin.Fin n)(above: _) => \exact(\parent.PrependLeft[a := a, xs := xs, tail := tail, above := above].result, Split (Lists.List[Fin.Fin Indices.total]::cons (Indices.left a) xs))
      | inr: \fun (b: Fin.Fin m)(above: _) => \exact(\parent.PrependRight[b := b, xs := xs, tail := tail, above := above].result, Split (Lists.List[Fin.Fin Indices.total]::cons (Indices.right b) xs))
    };
\definition result: \forall (head: Fin.Fin Indices.total) ->
  All.Holds (\fun (i: Fin.Fin Indices.total) => Naturals.Lt head i) xs ->
  \exists Split (Lists.List[Fin.Fin Indices.total]::cons head xs) :=
  \fun (head: Fin.Fin Indices.total) =>
    \idelim Indices.inflate (Indices.split head) = head \with low: Fin.Fin Indices.total =>
      All.Holds (\fun (i: Fin.Fin Indices.total) => Naturals.Lt low i) xs ->
      \exists Split (Lists.List[Fin.Fin Indices.total]::cons low xs) \by {
        base: forIndex (Indices.split head), equality: Indices.inflateSplit head
      };
