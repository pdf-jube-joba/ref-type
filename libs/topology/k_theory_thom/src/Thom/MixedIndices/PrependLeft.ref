\import \parent.AllParts[] \as Parts;
\definition all: All.Holds (\fun (i: Fin.Fin Indices.total) => Naturals.Lt (Indices.left a) i) (joined tail.left tail.right) :=
  \idelim xs = joined tail.left tail.right \with ys: Lists.List[Fin.Fin Indices.total] =>
    All.Holds (\fun (i: Fin.Fin Indices.total) => Naturals.Lt (Indices.left a) i) ys \by {
    base: above, equality: sym!{{Lists.List[Fin.Fin Indices.total]}} _ _ tail.equation
  };
\definition result: Split (Lists.List[Fin.Fin Indices.total]::cons (Indices.left a) xs) := Split[Lists.List[Fin.Fin Indices.total]::cons (Indices.left a) xs] {
  left := Lists.List[Fin.Fin n]::cons a tail.left, right := tail.right,
  equation := congr!{{Lists.List[Fin.Fin Indices.total]} {Lists.List[Fin.Fin Indices.total]}} (Lists.List[Fin.Fin Indices.total]::cons (Indices.left a)) _ _ tail.equation,
  leftIncreasing := Logic.And[_, _] { left := Parts.leftAbove (Indices.left a) tail.left tail.right all, right := tail.leftIncreasing },
  rightIncreasing := tail.rightIncreasing
};
