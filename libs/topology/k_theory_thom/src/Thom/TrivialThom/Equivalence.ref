\import topological_constructions.Product[A := X, B := PointTotalCarrier] \as Product;
\definition productTopology: topology.Topology[Carrier := Product.CarrierSet].Topology := Product.topology space pointTotalSpace;
\definition forward[p: Total]: Product.CarrierSet := Pair.pair X PointTotalCarrier p.base (projection p);
\definition backward[z: Product.CarrierSet]: Total := NativeFamily.include (Pair.first X PointTotalCarrier z) (Pair.second X PointTotalCarrier z).vector;
\module Geometry;
\definition homeomorphism: topology.Homeomorphism[A := Total, B := Product.CarrierSet].Homeomorphism[totalSpace, productTopology] := Geometry[].homeomorphism;
\import Base.Product[Y := PointTotalCarrier, otherSpace := pointTotalSpace, otherHausdorff := pointTotalHausdorff, otherLocallyCompact := pointTotalLocallyCompact] \as External;
\import External.Coordinates[] \as Coordinates;
\import Support.ClosedPair[M := PointSmash.model.Carrier, space := PointSmash.topology, compact := PointSmash.compact, hausdorff := PointSmash.hausdorff,
  subset := PointSmash.wedge, closed := PointSmash.wedgeClosed] \as Complement;
\module Compactification;
\definition value: Relative.Equivalence[source := model, target := externalModel].Data := Compactification[].value;
