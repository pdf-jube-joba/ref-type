\definition leftFinite: left (SourcePoints.inclusion p) = SmashAssociator.left (triple p) :=
  trans!{{LeftIterated.result.Carrier}} _ _ _
    (congr!{{LeftSmash.result.Carrier} {LeftIterated.result.Carrier}} LeftMapping.map _ _ (MultiplyLeft.onFinite p))
    (trans!{{LeftIterated.result.Carrier}} _ _ _
      (LeftMapping.onProjection (Pair.pair ABSupport.model.Carrier C.model.Carrier (ABPoints.inclusion (ab p)) (CPoints.inclusion (c p))))
      (congr!{{ABSmash.result.Carrier} {LeftIterated.result.Carrier}}
        (\fun (x: ABSmash.result.Carrier) => LeftIterated.projection (Pair.pair ABSmash.result.Carrier C.model.Carrier x (CPoints.inclusion (c p)))) _ _
        (MultiplyAB.onFinite (ab p))));
\definition rightFinite: right (TargetPoints.inclusion (homeomorphism.forward p)) = SmashAssociator.right (triple p) :=
  trans!{{RightIterated.result.Carrier}} _ _ _
    (congr!{{RightSmash.result.Carrier} {RightIterated.result.Carrier}} RightMapping.map _ _ (MultiplyRight.onFinite (homeomorphism.forward p)))
    (trans!{{RightIterated.result.Carrier}} _ _ _
      (RightMapping.onProjection (Pair.pair A.model.Carrier BCSupport.model.Carrier (APoints.inclusion (a p)) (BCPoints.inclusion (bc p))))
      (congr!{{BCSmash.result.Carrier} {RightIterated.result.Carrier}}
        (\fun (x: BCSmash.result.Carrier) => RightIterated.projection (Pair.pair A.model.Carrier BCSmash.result.Carrier (APoints.inclusion (a p)) x)) _ _
        (MultiplyBC.onFinite (bc p))));
\definition equation: LeftAssociated.map (SourcePoints.inclusion p) = RightAssociated.map (SourcePoints.inclusion p) :=
  trans!{{RightIterated.result.Carrier}} _ _ _
    (congr!{{LeftIterated.result.Carrier} {RightIterated.result.Carrier}} SmashAssociator.equivalence.forward _ _ leftFinite)
    (trans!{{RightIterated.result.Carrier}} _ _ _ (SmashAssociator.onTriple (triple p))
      (sym!{{RightIterated.result.Carrier}} _ _
        (trans!{{RightIterated.result.Carrier}} _ _ _
          (congr!{{Target.model.Carrier} {RightIterated.result.Carrier}} right _ _ (Extension.onFinite p)) rightFinite)));
