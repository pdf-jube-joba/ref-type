\import Homeomorphic.Extension[] \as Extension;
\import Support.OnePoint[X := SourceFamily.Point, space := Associator.sourceBundle.totalSpace] \as Domain;
\import Support.OnePoint[X := TargetFamily.Point, space := Associator.targetBundle.totalSpace] \as Range;
\import algebraic_topology.Pointed[A := Range.Carrier].Maps[B := Domain.Carrier] \as Pointed;
\definition backward: Relative.Map Target.model Source.model := \into[Range.Carrier -> Domain.Carrier](Extension.homeomorphism.backward, Relative.Map Target.model Source.model) \by {
  Pointed.Laws[Relative.pointed Target.model, Relative.pointed Source.model, Extension.homeomorphism.backward] {
    continuous := Extension.homeomorphism.backwardContinuous, pointed := \refl(Domain.point)
  }
};
\definition value: Relative.Equivalence[source := Source.model, target := Target.model].Data := Relative.Equivalence[source := Source.model, target := Target.model].Data {
  forward := association, backward := backward,
  leftInverse := Extension.leftInverse, rightInverse := Extension.rightInverse
};
