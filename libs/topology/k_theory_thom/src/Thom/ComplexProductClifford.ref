\import C.Def[] \as Scalar;
\import C.Prop[] \as Scalars;
\import Spaces.Linear[V := V, W := V, source := firstSpace, target := firstSpace] \as FirstMaps;
\import Spaces.Linear[V := W, W := W, source := secondSpace, target := secondSpace] \as SecondMaps;
\import Spaces.Tensor[V := V, W := W, left := firstSpace, right := secondSpace] \as Tensor;
\import Spaces.Linear[V := Tensor.Carrier, W := Tensor.Carrier, source := Tensor.space, target := Tensor.space] \as Maps;
\import Maps.Operations[] \as MapOperations;
\import Spaces.Laws[V := V, space := firstSpace] \as FirstLaws;
\import Spaces.Laws[V := Tensor.Carrier, space := Tensor.space] \as TensorLaws;
\import Operations.TensorFactors[V := V, W := W, left := firstSpace, right := secondSpace] \as Factors;
\import Operations.TensorEquality[V := V, W := W, U := Tensor.Carrier, left := firstSpace, right := secondSpace, target := Tensor.space] \as EqualityOnPure;
\structure Data: \Set := {
  first: FirstMaps.Map, second: SecondMaps.Map, grading: FirstMaps.Map,
  a: C.Complex, b: C.Complex
};
\structure Laws[c: Data]: \Prop := {
  firstSquare: \forall (v: V) -> c.first.apply (c.first.apply v) = firstSpace.smul c.a v,
  secondSquare: \forall (w: W) -> c.second.apply (c.second.apply w) = secondSpace.smul c.b w,
  gradingSquare: \forall (v: V) -> c.grading.apply (c.grading.apply v) = v,
  anticommutes: \forall (v: V) -> firstSpace.add (c.grading.apply (c.first.apply v)) (c.first.apply (c.grading.apply v)) = firstSpace.zero
};
\module Lift(first: FirstMaps.Map, second: SecondMaps.Map);
\module With(c: Data, laws: Laws[c]);
