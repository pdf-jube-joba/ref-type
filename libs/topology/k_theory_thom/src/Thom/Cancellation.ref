\structure FirstInverse: \Set := {
  inverse: C -> A,
  leftInverse: \forall (a: A) -> inverse (second (first a)) = a,
  rightInverse: \forall (c: C) -> second (first (inverse c)) = c
};
\structure StableInverse: \Set := {
  inverse: D -> B,
  leftInverse: \forall (b: B) -> inverse (third (second b)) = b
};
\module With(composite: FirstInverse, stable: StableInverse);
