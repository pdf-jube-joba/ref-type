\import topology.Topology[Carrier := X] \as Base;
\definition f0h0: f0.baseSpace = h0.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameF0) sameH0;
\definition f1h1: f1.baseSpace = h1.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameF1) sameH1;
\import Operations.DirectSum[X := X, F := F0, G := H0, left := f0, right := h0] \as StableEven;
\import Operations.DirectSum[X := X, F := F1, G := H1, left := f1, right := h1] \as StableOdd;
\definition stableEven: Bundles.Family[X := X, F := StableEven.Fiber].Bundle := StableEven.bundle f0h0;
\definition stableOdd: Bundles.Family[X := X, F := StableOdd.Fiber].Bundle := StableOdd.bundle f1h1;
\import \root.Thom[].ComplexProductParity[X := X, F0 := E0, F1 := E1, G0 := StableEven.Fiber, G1 := StableOdd.Fiber,
  e0 := e0, e1 := e1, f0 := stableEven, f1 := stableOdd, sameE1 := sameE1, sameF0 := sameF0, sameF1 := sameF1] \as Source;
\import \root.Thom[].ComplexProductParity[X := X, F0 := E0, F1 := E1, G0 := F0, G1 := F1,
  e0 := e0, e1 := e1, f0 := f0, f1 := f1, sameE1 := sameE1, sameF0 := sameF0, sameF1 := sameF1] \as Original;
\import \root.Thom[].ComplexProductParity[X := X, F0 := E0, F1 := E1, G0 := H0, G1 := H1,
  e0 := e0, e1 := e1, f0 := h0, f1 := h1, sameE1 := sameE1, sameF0 := sameH0, sameF1 := sameH1] \as Auxiliary;
\import Operations.DirectSum[X := X, F := Original.Even, G := Auxiliary.Even, left := Original.evenBundle, right := Auxiliary.evenBundle] \as Even;
\import Operations.DirectSum[X := X, F := Original.Odd, G := Auxiliary.Odd, left := Original.oddBundle, right := Auxiliary.oddBundle] \as Odd;
\definition evenBundle: Bundles.Family[X := X, F := Even.Fiber].Bundle := Even.bundle (\refl(e0.baseSpace));
\definition oddBundle: Bundles.Family[X := X, F := Odd.Fiber].Bundle := Odd.bundle (\refl(e0.baseSpace));
\module Positive;
\module Negative;
