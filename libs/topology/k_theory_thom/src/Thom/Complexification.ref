\import bundle_operations.Operations[].Scalars[].Complexification[X := X, F := F, source := bundle] \as Complex;
\definition Fiber[x: X]: \Set := Complex.Fiber x;
\definition complexBundle: Bundles.Family[X := X, F := Fiber].Bundle := Complex.bundle;
\import \root.Thom[].Koszul[X := X, F := Fiber, bundle := complexBundle] \as Koszul;
\definition Total: \Set := Koszul.Total;
\definition ZeroSection: \Pow Total := Koszul.ZeroSection;
\definition Term[k: N.Nat^][p: Total]: \Set := Koszul.Term k p;
\definition term[k: N.Nat^]: Bundles.Family[X := Total, F := Term k].Bundle := Koszul.term k;
\module Degree(k: N.Nat^);
\module At(p: Total);
\module Pullback(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> X,
  regular: topology.Continuity[A := Y, B := X].Continuous source bundle.baseSpace f);
\module Compact(compact: topology.Topology[Carrier := X].IsCompact bundle.baseSpace,
  hausdorff: topology.Topology[Carrier := X].IsT2 bundle.baseSpace);
