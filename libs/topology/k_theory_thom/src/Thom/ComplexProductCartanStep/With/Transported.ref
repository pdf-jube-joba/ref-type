\import Spaces.Isomorphism[V := Sum.Carrier, W := U, source := Sum.space, target := space] \as Isomorphisms;
\definition inverseLaws: Isomorphisms.Laws[isomorphism] := \bysub(Isomorphisms.Data, Isomorphisms.Isomorphism, isomorphism);
\definition Dtilde[x: U]: V := D (isomorphism.backward.apply x);
\definition Etilde[v: V]: U := isomorphism.forward.apply (E v);
\definition Htilde[v: V]: U := isomorphism.forward.apply (H v);
\definition Ktilde[x: U]: V := K (isomorphism.backward.apply x);
\definition Ttilde[x: U]: U := isomorphism.forward.apply (T (isomorphism.backward.apply x));
\definition even[x: U]: space.add (space.add (Etilde (Ktilde x)) (Htilde (Dtilde x))) (Ttilde x) = space.smul c.lambda x :=
  trans!{U} _ _ _
    (congr!{U U} (\fun (u: U) => space.add u (Ttilde x)) _ _
      (sym!{U} _ _ (isomorphism.forward.preservesAdd (E (Ktilde x)) (H (Dtilde x)))))
    (trans!{U} _ _ _
      (sym!{U} _ _ (isomorphism.forward.preservesAdd (Sum.plus (E (Ktilde x)) (H (Dtilde x))) (T (isomorphism.backward.apply x))))
      (trans!{U} _ _ _
        (congr!{{Sum.Carrier} U} isomorphism.forward.apply _ _ (cartanEven (isomorphism.backward.apply x)))
        (trans!{U} _ _ _ (isomorphism.forward.preservesScale c.lambda (isomorphism.backward.apply x))
          (congr!{U U} (space.smul c.lambda) _ _ (inverseLaws.rightInverse x)))));
\definition odd[v: V]: Vspace.add (Dtilde (Htilde v)) (Ktilde (Etilde v)) = Vspace.smul c.lambda v :=
  trans!{V} _ _ _
    (congr!{V V V} Vspace.add _ _ _ _
      (congr!{{Sum.Carrier} V} D _ _ (inverseLaws.leftInverse (H v)))
      (congr!{{Sum.Carrier} V} K _ _ (inverseLaws.leftInverse (E v))))
    (cartanOdd v);
