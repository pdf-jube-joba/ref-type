\import \parent.Normalized[] \as Normalized;
\import \parent.CancelLeft[] \as Left;
\import \parent.CancelRight[] \as Right;
\definition cancellation: Normalized.value = originalValue := trans!{{NativeQ.Relative}} _ _ _ Left.equation Right.equation;
\import \parent.\parent.Localization[] \as Localization;
\import \parent.\parent.Identification[] \as Identification;
\definition globalEquation: Localization.extension originalValue = Localization.external :=
  trans!{{Localization.Carrier}} _ _ _
    (congr!{{NativeQ.Relative} {Localization.Carrier}} Localization.extension _ _ (sym!{{NativeQ.Relative}} _ _ cancellation))
    Identification.globalNormalizedEquation;
