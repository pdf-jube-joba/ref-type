\import Spaces.Laws[V := Parity.Even z, space := Parity.evenBundle.space z] \as EvenLaws;
\import Spaces.Laws[V := Parity.Odd z, space := Parity.oddBundle.space z] \as OddLaws;
\import C.Prop[] \as ScalarLaws;
\definition hk: \forall (v: Parity.Even z) -> (hGlobal.fiber z).apply ((kGlobal.fiber z).apply v) = (Parity.evenBundle.space z).zero :=
  \fun (v: Parity.Even z) => trans!{{Parity.Even z}} _ _ _ (Raising.evenSquare z v)
    (trans!{{Parity.Even z}} _ _ _ (congr!{{C.Complex} {Parity.Even z}} (\fun (a: C.Complex) => (Parity.evenBundle.space z).smul a v) _ _ (ScalarLaws.addZeroLeft Scalar.zero)) (EvenLaws.zeroScale v));
\definition kh: \forall (v: Parity.Odd z) -> (kGlobal.fiber z).apply ((hGlobal.fiber z).apply v) = (Parity.oddBundle.space z).zero :=
  \fun (v: Parity.Odd z) => trans!{{Parity.Odd z}} _ _ _ (Raising.oddSquare z v)
    (trans!{{Parity.Odd z}} _ _ _ (congr!{{C.Complex} {Parity.Odd z}} (\fun (a: C.Complex) => (Parity.oddBundle.space z).smul a v) _ _ (ScalarLaws.addZeroLeft Scalar.zero)) (OddLaws.zeroScale v));
\definition evenSquare: \forall (v: Parity.Even z) -> (rawBackward.fiber z).apply ((rawForward.fiber z).apply v) = (Parity.evenBundle.space z).smul (Scalar.ofReal (qGlobal z)) v :=
  \fun (v: Parity.Even z) => trans!{{Parity.Even z}} _ _ _
    (congr!{{Parity.Odd z} {Parity.Even z}} (rawBackward.fiber z).apply _ _ (sym!{{Parity.Odd z}} _ _ (\parent.Additive[].forwardSum z v)))
    (trans!{{Parity.Even z}} _ _ _ (sym!{{Parity.Even z}} _ _ (\parent.Additive[].backwardSum z ((CF.forward.fiber z).apply v)))
      (trans!{{Parity.Even z}} _ _ _ (CF.evenSquare z v)
        (congr!{{C.Complex} {Parity.Even z}} (\fun (a: C.Complex) => (Parity.evenBundle.space z).smul a v) _ _ (coefficientReal z))));
\definition oddSquare: \forall (v: Parity.Odd z) -> (rawForward.fiber z).apply ((rawBackward.fiber z).apply v) = (Parity.oddBundle.space z).smul (Scalar.ofReal (qGlobal z)) v :=
  \fun (v: Parity.Odd z) => trans!{{Parity.Odd z}} _ _ _
    (congr!{{Parity.Even z} {Parity.Odd z}} (rawForward.fiber z).apply _ _ (sym!{{Parity.Even z}} _ _ (\parent.Additive[].backwardSum z v)))
    (trans!{{Parity.Odd z}} _ _ _ (sym!{{Parity.Odd z}} _ _ (\parent.Additive[].forwardSum z ((CF.backward.fiber z).apply v)))
      (trans!{{Parity.Odd z}} _ _ _ (CF.oddSquare z v)
        (congr!{{C.Complex} {Parity.Odd z}} (\fun (a: C.Complex) => (Parity.oddBundle.space z).smul a v) _ _ (coefficientReal z))));
