\definition radiusUnit[x: Pair.A]: radius x = Scalar.one :=
  trans!{{C.Complex}} _ _ _
    (congr!{{real.Analysis[].Real} {C.Complex}} Scalar.ofReal _ _
      (trans!{{real.Analysis[].Real}} _ _ _ (congr!{{real.Analysis[].Real} {real.Analysis[].Real}} real.Analysis[].SquareRoot[].sqrt _ _ (squaredUnit x)) real.Analysis[].SquareRoot[].sqrtOne))
    (\refl(Scalar.one));
\definition auxiliaryUnit: \forall (x: Pair.A)(v: H x) -> (auxiliaryOperator.fiber x).apply v = v :=
  \fun (x: Pair.A)(v: H x) => trans!{{H x}} _ _ _
    (congr!{{C.Complex} {H x}} (\fun (a: C.Complex) => (auxiliaryBundle.space x).smul a v) _ _ (radiusUnit x))
    ((auxiliaryBundle.space x).scalarOne v);
\definition agreesPair: \forall (x: Pair.A)(v: In.FirstFiber x)(w: H x) ->
  (forward.fiber x).apply (P.pair (In.FirstFiber x) (H x) v w) = (comparison.forward.fiber x).apply (P.pair (In.FirstFiber x) (H x) v w) :=
  \fun (x: Pair.A)(v: In.FirstFiber x)(w: H x) => trans!{{TrivialFiber x}} _ _ _
    (congr!{{NegativeFiber x} {TrivialFiber x}} (trivialization.forward.fiber x).apply _ _
      (P.Prop[A := In.SecondFiber x, B := H x].pairCong _ _ _ _ (sym!{{In.SecondFiber x}} _ _ (formula x v)) (auxiliaryUnit x w)))
    (sym!{{TrivialFiber x}} _ _ (Framing.formula x v w));
\definition agrees: \forall (x: Pair.A)(v: PositiveFiber x) -> (forward.fiber x).apply v = (comparison.forward.fiber x).apply v :=
  \fun (x: Pair.A)(v: PositiveFiber x) => \idelim P.pair (In.FirstFiber x) (H x) (P.first (In.FirstFiber x) (H x) v) (P.second (In.FirstFiber x) (H x) v) = v
    \with z: PositiveFiber x => (forward.fiber x).apply z = (comparison.forward.fiber x).apply z \by {
      base: agreesPair x (P.first (In.FirstFiber x) (H x) v) (P.second (In.FirstFiber x) (H x) v), equality: P.Prop[A := In.FirstFiber x, B := H x].eta v
    };
\import Symbols.With[alpha := comparison, c := data, laws := laws, agrees := agrees] \as Descend;
\import relative_k_theory.Relative[].Descent[X := Local.Carrier, F := PositiveFiber, bundle := positiveBundle,
  compact := Local.compact, hausdorff := Local.separated, subset := Local.boundary, closed := Local.boundaryClosed, dimension := n].With[comparison := comparison] \as PositiveDescent;
\import relative_k_theory.Relative[].Descent[X := Local.Carrier, F := TrivialFiber, bundle := Trivial.bundle,
  compact := Local.compact, hausdorff := Local.separated, subset := Local.boundary, closed := Local.boundaryClosed, dimension := n].With[comparison := Symbols.beta] \as NegativeDescent;
\definition PositiveResult: \Set := PositiveDescent.Result;
\definition NegativeResult: \Set := NegativeDescent.Result;
\definition positiveExists: \exists PositiveDescent.Result := PositiveDescent.existence;
\definition negativeExists: \exists NegativeDescent.Result := NegativeDescent.existence;
\module Using(first: PositiveDescent.Result, second: NegativeDescent.Result);
