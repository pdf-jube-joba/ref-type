\import AuxiliarySymbol.With[data := data].Raw[] \as Blocks;
\import Blocks.Block[map := Raw.operator] \as Projected;
\import Blocks.Block[map := Blocks.left] \as Left;
\import Blocks.Block[map := Blocks.right] \as Right;
\definition fullForward: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Even, G := Odd,
  source := evenBundle, target := oddBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := Projected.forward;
\definition formula: \forall (z: NativeProduct.Z)(v: Even z) -> (fullForward.fiber z).apply v = (forward.fiber z).apply v :=
  \fun (z: NativeProduct.Z)(v: Even z) => trans!{{Odd z}} _ _ _
    (congr!{{AuxiliaryParity.SourceFiber z} {Odd z}} (Blocks.projectOdd.fiber z).apply _ _
      (Raw.BlockFiber[x := z].fullEquation ((Blocks.embedEven.fiber z).apply v)))
    (trans!{{Odd z}} _ _ _
      ((Blocks.projectOdd.fiber z).preservesAdd
        ((AuxiliaryParity.sourceBundle.space z).smul (Raw.scalar z) ((Blocks.left.fiber z).apply ((Blocks.embedEven.fiber z).apply v)))
        ((Blocks.right.fiber z).apply ((Blocks.embedEven.fiber z).apply v)))
      (congr!{{Odd z} {Odd z}} (\fun (w: Odd z) => (oddBundle.space z).add w ((Right.forward.fiber z).apply v)) _ _
        ((Blocks.projectOdd.fiber z).preservesScale (Raw.scalar z) ((Blocks.left.fiber z).apply ((Blocks.embedEven.fiber z).apply v)))));
