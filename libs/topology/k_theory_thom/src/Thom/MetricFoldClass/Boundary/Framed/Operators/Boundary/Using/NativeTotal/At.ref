\import \parent.\parent.\parent.\parent.At[x := x] \as Stable;
\definition square: \forall (v: NativeFiber x) -> (nativeOperator.fiber x).apply ((nativeOperator.fiber x).apply v) = (nativeBundle.space x).smul (nativeCoefficient x) v :=
  \fun (v: NativeFiber x) => P.Prop[A := PositiveFiber x, B := NegativeFiber x].pairCong _ _ _ _
    (Stable.stableEven (P.first (PositiveFiber x) (NegativeFiber x) v))
    (Stable.stableOdd (P.second (PositiveFiber x) (NegativeFiber x) v));
\import Spaces.Linear[V := NegativeFiber x, W := PositiveFiber x, source := negativeBundle.space x, target := positiveBundle.space x].Operations[] \as Maps;
\import algebra.Group[].Of[Carrier := PositiveFiber x,
  group := std.Alg[].Ring[].ringModuleAsCommutativeGroup C.Complex (PositiveFiber x) Spaces.ring (positiveBundle.space x)] \as PositiveGroup;
\import Spaces.Laws[V := NegativeFiber x, space := negativeBundle.space x] \as NegativeLaws;
\definition equation: \forall (v: NativeFiber x) -> (nativeBundle.space x).add
  ((nativeGrading.forward.fiber x).apply ((nativeOperator.fiber x).apply v)) ((nativeOperator.fiber x).apply ((nativeGrading.forward.fiber x).apply v)) = (nativeBundle.space x).zero :=
  \fun (v: NativeFiber x) => P.Prop[A := PositiveFiber x, B := NegativeFiber x].ext _ _
    (trans!{{PositiveFiber x}} _ _ _
      (congr!{{PositiveFiber x} {PositiveFiber x}} ((positiveBundle.space x).add ((stableBackward.fiber x).apply (P.second (PositiveFiber x) (NegativeFiber x) v))) _ _
        (trans!{{PositiveFiber x}} _ _ _
          (congr!{{NegativeFiber x} {PositiveFiber x}} (stableBackward.fiber x).apply _ _ (NegativeSign.formula x (P.second (PositiveFiber x) (NegativeFiber x) v)))
          (Maps.preservesNeg (stableBackward.fiber x) (P.second (PositiveFiber x) (NegativeFiber x) v))))
      (PositiveGroup.inverseRight ((stableBackward.fiber x).apply (P.second (PositiveFiber x) (NegativeFiber x) v))))
    (trans!{{NegativeFiber x}} _ _ _
      (congr!{{NegativeFiber x} {NegativeFiber x}} (\fun (w: NegativeFiber x) => (negativeBundle.space x).add w ((stableForward.fiber x).apply (P.first (PositiveFiber x) (NegativeFiber x) v))) _ _
        (NegativeSign.formula x ((stableForward.fiber x).apply (P.first (PositiveFiber x) (NegativeFiber x) v))))
      (NegativeLaws.inverseLeft ((stableForward.fiber x).apply (P.first (PositiveFiber x) (NegativeFiber x) v))));
