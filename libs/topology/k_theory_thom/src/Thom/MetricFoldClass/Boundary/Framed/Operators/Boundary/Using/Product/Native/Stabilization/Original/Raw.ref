\import \parent.First[] \as FirstCF;
\import \parent.Second[] \as SecondCF;
\import \parent.Classes[] \as Classes;
\import OriginalBlocks.With[c := Classes.originalData, laws := Classes.originalLaws] \as CF;
\import \root.Thom[].ComplexProductParity[X := NativeProduct.Z,
  F0 := FirstEven, F1 := FirstOdd, G0 := SecondEven, G1 := SecondOdd,
  e0 := FirstEvenBundle, e1 := FirstOddBundle, f0 := SecondEvenBundle, f1 := SecondOddBundle,
  sameE1 := (\refl(NativeProduct.topology)), sameF0 := (\refl(NativeProduct.topology)), sameF1 := (\refl(NativeProduct.topology))] \as Parity;
\import Parity.Grading[] \as Grading;
\import Bundles.ArrowLaws[X := Disk, Y := Disk, F := LeftFrame.OriginalEven, G := LeftFrame.OriginalOdd,
  source := LeftFrame.originalEvenBundle, target := LeftFrame.originalOddBundle, f := (\fun (p: Disk) => p)]
  .Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.first].Of[a := LeftFrame.differential, regular := Sectors.firstRegular] \as FirstdPull;
\definition firstd: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := FirstEven, G := FirstOdd,
  source := FirstEvenBundle, target := FirstOddBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := FirstdPull.map;
\import Bundles.ArrowLaws[X := Disk, Y := Disk, F := LeftFrame.OriginalOdd, G := LeftFrame.OriginalEven,
  source := LeftFrame.originalOddBundle, target := LeftFrame.originalEvenBundle, f := (\fun (p: Disk) => p)]
  .Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.first].Of[a := LeftFrame.codifferential, regular := Sectors.firstRegular] \as FirstePull;
\definition firste: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := FirstOdd, G := FirstEven,
  source := FirstOddBundle, target := FirstEvenBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := FirstePull.map;
\import Bundles.ArrowLaws[X := Disk, Y := Disk, F := LeftFrame.OriginalEven, G := LeftFrame.OriginalOdd,
  source := LeftFrame.originalEvenBundle, target := LeftFrame.originalOddBundle, f := (\fun (p: Disk) => p)]
  .Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.first].Of[a := LeftFrame.raisingEven, regular := Sectors.firstRegular] \as FirstkPull;
\definition firstk: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := FirstEven, G := FirstOdd,
  source := FirstEvenBundle, target := FirstOddBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := FirstkPull.map;
\import Bundles.ArrowLaws[X := Disk, Y := Disk, F := LeftFrame.OriginalOdd, G := LeftFrame.OriginalEven,
  source := LeftFrame.originalOddBundle, target := LeftFrame.originalEvenBundle, f := (\fun (p: Disk) => p)]
  .Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.first].Of[a := LeftFrame.raisingOdd, regular := Sectors.firstRegular] \as FirsthPull;
\definition firsth: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := FirstOdd, G := FirstEven,
  source := FirstOddBundle, target := FirstEvenBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := FirsthPull.map;
\import \root.Thom[].OddPairOperator[X := NativeProduct.Z, F := FirstEven, G := FirstOdd,
  first := FirstEvenBundle, second := FirstOddBundle, sameBase := (\refl(NativeProduct.topology))] \as FirstPair;
\import FirstPair.With[d := firstd, e := firste] \as RawFirstD;
\import FirstPair.With[d := firstk, e := firsth] \as RawFirstR;
\import Bundles.ArrowLaws[X := OtherGeometry.Disk, Y := OtherGeometry.Disk, F := RightFrame.OriginalEven, G := RightFrame.OriginalOdd,
  source := RightFrame.originalEvenBundle, target := RightFrame.originalOddBundle, f := (\fun (p: OtherGeometry.Disk) => p)]
  .Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.second].Of[a := RightFrame.differential, regular := Sectors.secondRegular] \as SeconddPull;
\definition secondd: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := SecondEven, G := SecondOdd,
  source := SecondEvenBundle, target := SecondOddBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := SeconddPull.map;
\import Bundles.ArrowLaws[X := OtherGeometry.Disk, Y := OtherGeometry.Disk, F := RightFrame.OriginalOdd, G := RightFrame.OriginalEven,
  source := RightFrame.originalOddBundle, target := RightFrame.originalEvenBundle, f := (\fun (p: OtherGeometry.Disk) => p)]
  .Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.second].Of[a := RightFrame.codifferential, regular := Sectors.secondRegular] \as SecondePull;
\definition seconde: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := SecondOdd, G := SecondEven,
  source := SecondOddBundle, target := SecondEvenBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := SecondePull.map;
\import Bundles.ArrowLaws[X := OtherGeometry.Disk, Y := OtherGeometry.Disk, F := RightFrame.OriginalEven, G := RightFrame.OriginalOdd,
  source := RightFrame.originalEvenBundle, target := RightFrame.originalOddBundle, f := (\fun (p: OtherGeometry.Disk) => p)]
  .Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.second].Of[a := RightFrame.raisingEven, regular := Sectors.secondRegular] \as SecondkPull;
\definition secondk: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := SecondEven, G := SecondOdd,
  source := SecondEvenBundle, target := SecondOddBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := SecondkPull.map;
\import Bundles.ArrowLaws[X := OtherGeometry.Disk, Y := OtherGeometry.Disk, F := RightFrame.OriginalOdd, G := RightFrame.OriginalEven,
  source := RightFrame.originalOddBundle, target := RightFrame.originalEvenBundle, f := (\fun (p: OtherGeometry.Disk) => p)]
  .Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.second].Of[a := RightFrame.raisingOdd, regular := Sectors.secondRegular] \as SecondhPull;
\definition secondh: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := SecondOdd, G := SecondEven,
  source := SecondOddBundle, target := SecondEvenBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := SecondhPull.map;
\import \root.Thom[].OddPairOperator[X := NativeProduct.Z, F := SecondEven, G := SecondOdd,
  first := SecondEvenBundle, second := SecondOddBundle, sameBase := (\refl(NativeProduct.topology))] \as SecondPair;
\import SecondPair.With[d := secondd, e := seconde] \as RawSecondD;
\import SecondPair.With[d := secondk, e := secondh] \as RawSecondR;
\definition zero[z: NativeProduct.Z]: C.Complex := Scalar.zero;
\definition zeroContinuous: topology.Continuity[A := NativeProduct.Z, B := C.Complex].Continuous NativeProduct.topology Scalars.scalar.topological.space zero :=
  topology.Maps[A := NativeProduct.Z, B := C.Complex].constantContinuous NativeProduct.topology Scalars.scalar.topological.space Scalar.zero;
\definition firstDifferential: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Parity.LeftFiber, G := Parity.LeftFiber,
  source := Parity.leftBundle, target := Parity.leftBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := RawFirstD.operator;
\definition secondDifferential: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Parity.RightFiber, G := Parity.RightFiber,
  source := Parity.rightBundle, target := Parity.rightBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := RawSecondD.operator;
\definition firstDifferentialOnParts: \forall (z: NativeProduct.Z)(v: Parity.LeftFiber z) -> (firstDifferential.fiber z).apply v =
  P.pair (FirstEven z) (FirstOdd z) ((firste.fiber z).apply (P.second (FirstEven z) (FirstOdd z) v)) ((firstd.fiber z).apply (P.first (FirstEven z) (FirstOdd z) v)) := RawFirstD.onParts;
\definition secondDifferentialOnParts: \forall (z: NativeProduct.Z)(v: Parity.RightFiber z) -> (secondDifferential.fiber z).apply v =
  P.pair (SecondEven z) (SecondOdd z) ((seconde.fiber z).apply (P.second (SecondEven z) (SecondOdd z) v)) ((secondd.fiber z).apply (P.first (SecondEven z) (SecondOdd z) v)) := RawSecondD.onParts;
\module At(z: NativeProduct.Z);
\definition FirstDEvenSquare: \forall (z: NativeProduct.Z)(v: FirstEven z) ->
  (firste.fiber z).apply ((firstd.fiber z).apply v) = (FirstEvenBundle.space z).smul Scalar.zero v := \fun (z: NativeProduct.Z) => At[z := z].FirstDEven;
\definition FirstDOddSquare: \forall (z: NativeProduct.Z)(v: FirstOdd z) ->
  (firstd.fiber z).apply ((firste.fiber z).apply v) = (FirstOddBundle.space z).smul Scalar.zero v := \fun (z: NativeProduct.Z) => At[z := z].FirstDOdd;
\import RawFirstD.Square[q := zero, evenSquare := FirstDEvenSquare, oddSquare := FirstDOddSquare] \as FirstDSquare;
\definition FirstREvenSquare: \forall (z: NativeProduct.Z)(v: FirstEven z) ->
  (firsth.fiber z).apply ((firstk.fiber z).apply v) = (FirstEvenBundle.space z).smul Scalar.zero v := \fun (z: NativeProduct.Z) => At[z := z].FirstREven;
\definition FirstROddSquare: \forall (z: NativeProduct.Z)(v: FirstOdd z) ->
  (firstk.fiber z).apply ((firsth.fiber z).apply v) = (FirstOddBundle.space z).smul Scalar.zero v := \fun (z: NativeProduct.Z) => At[z := z].FirstROdd;
\import RawFirstR.Square[q := zero, evenSquare := FirstREvenSquare, oddSquare := FirstROddSquare] \as FirstRSquare;
\definition SecondDEvenSquare: \forall (z: NativeProduct.Z)(v: SecondEven z) ->
  (seconde.fiber z).apply ((secondd.fiber z).apply v) = (SecondEvenBundle.space z).smul Scalar.zero v := \fun (z: NativeProduct.Z) => At[z := z].SecondDEven;
\definition SecondDOddSquare: \forall (z: NativeProduct.Z)(v: SecondOdd z) ->
  (secondd.fiber z).apply ((seconde.fiber z).apply v) = (SecondOddBundle.space z).smul Scalar.zero v := \fun (z: NativeProduct.Z) => At[z := z].SecondDOdd;
\import RawSecondD.Square[q := zero, evenSquare := SecondDEvenSquare, oddSquare := SecondDOddSquare] \as SecondDSquare;
\definition SecondREvenSquare: \forall (z: NativeProduct.Z)(v: SecondEven z) ->
  (secondh.fiber z).apply ((secondk.fiber z).apply v) = (SecondEvenBundle.space z).smul Scalar.zero v := \fun (z: NativeProduct.Z) => At[z := z].SecondREven;
\definition SecondROddSquare: \forall (z: NativeProduct.Z)(v: SecondOdd z) ->
  (secondk.fiber z).apply ((secondh.fiber z).apply v) = (SecondOddBundle.space z).smul Scalar.zero v := \fun (z: NativeProduct.Z) => At[z := z].SecondROdd;
\import RawSecondR.Square[q := zero, evenSquare := SecondREvenSquare, oddSquare := SecondROddSquare] \as SecondRSquare;
\definition differentialData: OriginalBlocks.Data := OriginalBlocks.Data { first := RawFirstD.operator, second := RawSecondD.operator, a := zero, b := zero, aContinuous := zeroContinuous, bContinuous := zeroContinuous };
\definition differentialLaws: OriginalBlocks.Laws[differentialData] := OriginalBlocks.Laws[differentialData] {
  firstSquare := FirstDSquare.square, secondSquare := SecondDSquare.square, firstAnti := RawFirstD.anticommutes, secondAnti := RawSecondD.anticommutes
};
\definition raisingData: OriginalBlocks.Data := OriginalBlocks.Data { first := RawFirstR.operator, second := RawSecondR.operator, a := zero, b := zero, aContinuous := zeroContinuous, bContinuous := zeroContinuous };
\definition raisingLaws: OriginalBlocks.Laws[raisingData] := OriginalBlocks.Laws[raisingData] {
  firstSquare := FirstRSquare.square, secondSquare := SecondRSquare.square, firstAnti := RawFirstR.anticommutes, secondAnti := RawSecondR.anticommutes
};
\import OriginalBlocks.With[c := differentialData, laws := differentialLaws] \as Differential;
\import OriginalBlocks.With[c := raisingData, laws := raisingLaws] \as Raising;
\import \root.Thom[].ComplexProductCliffordBundle[X := NativeProduct.Z, F := Parity.LeftFiber, G := Parity.RightFiber,
  first := Parity.leftBundle, second := Parity.rightBundle, sameBase := (\refl(NativeProduct.topology))]
  .With[c := Differential.operators, laws := Differential.operatorLaws] \as DifferentialSymbol;
\definition differentialTensor: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Parity.SourceFiber, G := Parity.SourceFiber,
  source := Parity.sourceBundle, target := Parity.sourceBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := DifferentialSymbol.operator;
\definition dGlobal: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Parity.Even, G := Parity.Odd,
  source := Parity.evenBundle, target := Parity.oddBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := Differential.forward;
\definition eGlobal: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Parity.Odd, G := Parity.Even,
  source := Parity.oddBundle, target := Parity.evenBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := Differential.backward;
\definition hGlobal: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Parity.Odd, G := Parity.Even,
  source := Parity.oddBundle, target := Parity.evenBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := Raising.backward;
\definition kGlobal: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Parity.Even, G := Parity.Odd,
  source := Parity.evenBundle, target := Parity.oddBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := Raising.forward;
\module Additive;
\import Operations.MapOperations[X := NativeProduct.Z, F := Parity.Even, G := Parity.Odd, source := Parity.evenBundle, target := Parity.oddBundle] \as ForwardMaps;
\import Operations.MapOperations[X := NativeProduct.Z, F := Parity.Odd, G := Parity.Even, source := Parity.oddBundle, target := Parity.evenBundle] \as BackwardMaps;
\definition rawForward: ForwardMaps.Map := ForwardMaps.add dGlobal kGlobal;
\definition rawBackward: BackwardMaps.Map := BackwardMaps.add eGlobal hGlobal;
\definition qGlobal[z: NativeProduct.Z]: Real.Real := Real.add (firstNorm z) (secondNorm z);
\definition coefficientReal[z: NativeProduct.Z]: CF.coefficient z = Scalar.ofReal (qGlobal z) := normCoefficient z;
\definition firstNormContinuous: metric_spaces.RealFunctions[A := NativeProduct.Z].Continuous NativeProduct.topology firstNorm :=
  topology.Composition[A := NativeProduct.Z, B := Disk, C := Real.Real].composeContinuous NativeProduct.topology diskTopology metric_spaces.RealLine[].topology NativeProduct.first LeftNative.nativeNorm Sectors.firstRegular LeftNative.nativeNormContinuous;
\definition secondNormContinuous: metric_spaces.RealFunctions[A := NativeProduct.Z].Continuous NativeProduct.topology secondNorm :=
  topology.Composition[A := NativeProduct.Z, B := OtherGeometry.Disk, C := Real.Real].composeContinuous NativeProduct.topology OtherGeometry.diskTopology metric_spaces.RealLine[].topology NativeProduct.second RightNative.nativeNorm Sectors.secondRegular RightNative.nativeNormContinuous;
\definition qContinuous: metric_spaces.RealFunctions[A := NativeProduct.Z].Continuous NativeProduct.topology qGlobal :=
  metric_spaces.RealFunctions[A := NativeProduct.Z].sumContinuous NativeProduct.topology firstNorm secondNorm firstNormContinuous secondNormContinuous;
\module Squares(z: NativeProduct.Z);
\definition qPositive: \forall (x: NativePair.A) -> Order.Lt Real.zero (qGlobal x) := positive;
\module Boundary;
