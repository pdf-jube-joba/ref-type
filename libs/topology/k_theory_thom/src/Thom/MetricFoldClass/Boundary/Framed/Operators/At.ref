\definition auxiliarySquare: \forall (v: H x) -> (auxiliaryOperator.fiber x).apply ((auxiliaryOperator.fiber x).apply v) = (auxiliaryBundle.space x).smul (coefficient x) v :=
  \fun (v: H x) => trans!{{H x}} _ _ _
    (sym!{{H x}} _ _ ((auxiliaryBundle.space x).scalarAssoc (radius x) (radius x) v))
    (congr!{{C.Complex} {H x}} (\fun (a: C.Complex) => (auxiliaryBundle.space x).smul a v) _ _ (radiusSquare x));
\definition stableEven: \forall (v: PositiveFiber x) -> (stableBackward.fiber x).apply ((stableForward.fiber x).apply v) = (positiveBundle.space x).smul (coefficient x) v :=
  \fun (v: PositiveFiber x) => P.Prop[A := In.FirstFiber x, B := H x].pairCong _ _ _ _
    (Fold.evenSquare x (P.first (In.FirstFiber x) (H x) v)) (auxiliarySquare (P.second (In.FirstFiber x) (H x) v));
\definition stableOdd: \forall (v: NegativeFiber x) -> (stableForward.fiber x).apply ((stableBackward.fiber x).apply v) = (negativeBundle.space x).smul (coefficient x) v :=
  \fun (v: NegativeFiber x) => P.Prop[A := In.SecondFiber x, B := H x].pairCong _ _ _ _
    (Fold.oddSquare x (P.first (In.SecondFiber x) (H x) v)) (auxiliarySquare (P.second (In.SecondFiber x) (H x) v));
\definition even: \forall (v: PositiveFiber x) -> (backward.fiber x).apply ((forward.fiber x).apply v) = (positiveBundle.space x).smul (coefficient x) v :=
  \fun (v: PositiveFiber x) => trans!{{PositiveFiber x}} _ _ _
    (congr!{{NegativeFiber x} {PositiveFiber x}} (stableBackward.fiber x).apply _ _ (trivialization.leftInverse x ((stableForward.fiber x).apply v)))
    (stableEven v);
\definition odd: \forall (v: TrivialFiber x) -> (forward.fiber x).apply ((backward.fiber x).apply v) = (Trivial.bundle.space x).smul (coefficient x) v :=
  \fun (v: TrivialFiber x) => trans!{{TrivialFiber x}} _ _ _
    (congr!{{NegativeFiber x} {TrivialFiber x}} (trivialization.forward.fiber x).apply _ _ (stableOdd ((trivialization.backward.fiber x).apply v)))
    (trans!{{TrivialFiber x}} _ _ _
      ((trivialization.forward.fiber x).preservesScale (coefficient x) ((trivialization.backward.fiber x).apply v))
      (congr!{{TrivialFiber x} {TrivialFiber x}} ((Trivial.bundle.space x).smul (coefficient x)) _ _ (trivialization.rightInverse x v)));
