\import Spaces.Linear[V := SecondOdd z, W := SecondEven z, source := SecondOddBundle.space z, target := SecondEvenBundle.space z].Operations[] \as Maps;
\import algebra.Group[].Of[Carrier := SecondEven z,
  group := std.Alg[].Ring[].ringModuleAsCommutativeGroup C.Complex (SecondEven z) Spaces.ring (SecondEvenBundle.space z)] \as PositiveGroup;
\import Spaces.Laws[V := SecondOdd z, space := SecondOddBundle.space z] \as NegativeLaws;
\definition equation: \forall (v: Fiber z) -> (bundle.space z).add
  ((grading.forward.fiber z).apply ((operator.fiber z).apply v)) ((operator.fiber z).apply ((grading.forward.fiber z).apply v)) = (bundle.space z).zero :=
  \fun (v: Fiber z) => P.Prop[A := SecondEven z, B := SecondOdd z].ext _ _
    (trans!{{SecondEven z}} _ _ _
      (congr!{{SecondEven z} {SecondEven z}} ((SecondEvenBundle.space z).add ((SecondE.fiber z).apply (P.second (SecondEven z) (SecondOdd z) v))) _ _
        (trans!{{SecondEven z}} _ _ _
          (congr!{{SecondOdd z} {SecondEven z}} (SecondE.fiber z).apply _ _ (NegativeSign.formula z (P.second (SecondEven z) (SecondOdd z) v)))
          (Maps.preservesNeg (SecondE.fiber z) (P.second (SecondEven z) (SecondOdd z) v))))
      (PositiveGroup.inverseRight ((SecondE.fiber z).apply (P.second (SecondEven z) (SecondOdd z) v))))
    (trans!{{SecondOdd z}} _ _ _
      (congr!{{SecondOdd z} {SecondOdd z}} (\fun (w: SecondOdd z) => (SecondOddBundle.space z).add w ((SecondD.fiber z).apply (P.first (SecondEven z) (SecondOdd z) v))) _ _
        (NegativeSign.formula z ((SecondD.fiber z).apply (P.first (SecondEven z) (SecondOdd z) v))))
      (NegativeLaws.inverseLeft ((SecondD.fiber z).apply (P.first (SecondEven z) (SecondOdd z) v))));
