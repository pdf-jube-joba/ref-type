\import relative_k_theory.Relative[] \as Relative;
\import \root.Thom[].MetricFoldClass[X := Y, F := G, bundle := otherBundle, compact := otherCompact, hausdorff := otherHausdorff, metric := otherMetric, data := otherData] \as OtherGeometry;
\import OtherGeometry.Boundary[].Framed[r := otherFactor.representation].Operators[].Boundary[].Using[first := otherFactor.positive, second := otherFactor.negative] \as Other;
\import Relative.Smash[left := model, right := OtherGeometry.model] \as Smash;
\import topological_constructions.Product[A := Base, B := Other.Base].Maps[] \as Projections;
\definition firstRegular: topology.Continuity[A := Smash.model.Carrier, B := Base].Continuous Smash.topology baseTopology Smash.first := Projections.firstContinuous baseTopology Other.baseTopology;
\definition secondRegular: topology.Continuity[A := Smash.model.Carrier, B := Other.Base].Continuous Smash.topology Other.baseTopology Smash.second := Projections.secondContinuous baseTopology Other.baseTopology;
\import Bundles.Family[X := Base, F := Even].Of[bundle := evenBundle].Pullback[Y := Smash.model.Carrier, source := Smash.topology, f := Smash.first] \as FirstEven;
\import Bundles.Family[X := Base, F := Odd].Of[bundle := oddBundle].Pullback[Y := Smash.model.Carrier, source := Smash.topology, f := Smash.first] \as FirstOdd;
\import Bundles.Family[X := Other.Base, F := Other.Even].Of[bundle := Other.evenBundle].Pullback[Y := Smash.model.Carrier, source := Smash.topology, f := Smash.second] \as SecondEven;
\import Bundles.Family[X := Other.Base, F := Other.Odd].Of[bundle := Other.oddBundle].Pullback[Y := Smash.model.Carrier, source := Smash.topology, f := Smash.second] \as SecondOdd;
\definition GlobalFirstEven[z: Smash.model.Carrier]: \Set := Even (Smash.first z);
\definition GlobalFirstOdd[z: Smash.model.Carrier]: \Set := Odd (Smash.first z);
\definition GlobalSecondEven[z: Smash.model.Carrier]: \Set := Other.Even (Smash.second z);
\definition GlobalSecondOdd[z: Smash.model.Carrier]: \Set := Other.Odd (Smash.second z);
\definition globalFirstEven: Bundles.Family[X := Smash.model.Carrier, F := GlobalFirstEven].Bundle := FirstEven.pulled firstRegular;
\definition globalFirstOdd: Bundles.Family[X := Smash.model.Carrier, F := GlobalFirstOdd].Bundle := FirstOdd.pulled firstRegular;
\definition globalSecondEven: Bundles.Family[X := Smash.model.Carrier, F := GlobalSecondEven].Bundle := SecondEven.pulled secondRegular;
\definition globalSecondOdd: Bundles.Family[X := Smash.model.Carrier, F := GlobalSecondOdd].Bundle := SecondOdd.pulled secondRegular;
\definition quotientFirstRegular: topology.Continuity[A := Smash.model.Carrier, B := Base].Continuous Smash.topology baseTopology Smash.first := firstRegular;
\definition quotientSecondRegular: topology.Continuity[A := Smash.model.Carrier, B := Other.Base].Continuous Smash.topology Other.baseTopology Smash.second := secondRegular;
\import \root.Thom[].ComplexProductBlocks[X := Smash.model.Carrier,
  F0 := (\fun (z: Smash.model.Carrier) => Even (Smash.first z)), F1 := (\fun (z: Smash.model.Carrier) => Odd (Smash.first z)),
  G0 := (\fun (z: Smash.model.Carrier) => Other.Even (Smash.second z)), G1 := (\fun (z: Smash.model.Carrier) => Other.Odd (Smash.second z)),
  e0 := FirstEven.pulled firstRegular, e1 := FirstOdd.pulled firstRegular,
  f0 := SecondEven.pulled secondRegular, f1 := SecondOdd.pulled secondRegular,
  sameE1 := (\refl(Smash.topology)), sameF0 := (\refl(Smash.topology)), sameF1 := (\refl(Smash.topology))] \as Blocks;
\import Operations.DirectSum[X := Base, F := Even, G := Odd, left := evenBundle, right := oddBundle]
  .Of[same := (\refl(baseTopology))].Pullback[Y := Smash.model.Carrier, source := Smash.topology, f := Smash.first, regular := firstRegular] \as FirstFull;
\import Operations.DirectSum[X := Other.Base, F := Other.Even, G := Other.Odd, left := Other.evenBundle, right := Other.oddBundle]
  .Of[same := (\refl(Other.baseTopology))].Pullback[Y := Smash.model.Carrier, source := Smash.topology, f := Smash.second, regular := secondRegular] \as SecondFull;
\import Bundles.ArrowLaws[X := Base, Y := Base, F := Fiber, G := Fiber, source := bundle, target := bundle,
  f := (\fun (q: Base) => q)].Pullback[Z := Smash.model.Carrier, space := Smash.topology, g := Smash.first].Of[a := clifford, regular := firstRegular] \as FirstOperatorPull;
\import Bundles.Morphisms[X := Smash.model.Carrier, Y := Smash.model.Carrier, F := (\fun (z: Smash.model.Carrier) => Fiber (Smash.first z)), G := (\fun (z: Smash.model.Carrier) => Fiber (Smash.first z)),
  source := FirstFull.secondBundle, target := FirstFull.firstBundle, f := (\fun (z: Smash.model.Carrier) => z)]
  .Composition[Z := Smash.model.Carrier, H := (\fun (z: Smash.model.Carrier) => Fiber (Smash.first z)), range := FirstFull.firstBundle, g := (\fun (z: Smash.model.Carrier) => z)] \as FirstBefore;
\import Bundles.Morphisms[X := Smash.model.Carrier, Y := Smash.model.Carrier, F := (\fun (z: Smash.model.Carrier) => Fiber (Smash.first z)), G := (\fun (z: Smash.model.Carrier) => Fiber (Smash.first z)),
  source := FirstFull.secondBundle, target := FirstFull.firstBundle, f := (\fun (z: Smash.model.Carrier) => z)]
  .Composition[Z := Smash.model.Carrier, H := (\fun (z: Smash.model.Carrier) => Fiber (Smash.first z)), range := FirstFull.secondBundle, g := (\fun (z: Smash.model.Carrier) => z)] \as FirstAfter;
\definition firstOperator: Bundles.Morphisms[X := Smash.model.Carrier, Y := Smash.model.Carrier, F := Blocks.LeftFiber, G := Blocks.LeftFiber,
  source := Blocks.leftBundle, target := Blocks.leftBundle, f := (\fun (z: Smash.model.Carrier) => z)].Map :=
  FirstAfter.compose (FirstBefore.compose FirstFull.isomorphism.backward FirstOperatorPull.map) FirstFull.isomorphism.forward;
\import Bundles.ArrowLaws[X := Other.Base, Y := Other.Base, F := Other.Fiber, G := Other.Fiber, source := Other.bundle, target := Other.bundle,
  f := (\fun (q: Other.Base) => q)].Pullback[Z := Smash.model.Carrier, space := Smash.topology, g := Smash.second].Of[a := Other.clifford, regular := secondRegular] \as SecondOperatorPull;
\import Bundles.Morphisms[X := Smash.model.Carrier, Y := Smash.model.Carrier, F := (\fun (z: Smash.model.Carrier) => Other.Fiber (Smash.second z)), G := (\fun (z: Smash.model.Carrier) => Other.Fiber (Smash.second z)),
  source := SecondFull.secondBundle, target := SecondFull.firstBundle, f := (\fun (z: Smash.model.Carrier) => z)]
  .Composition[Z := Smash.model.Carrier, H := (\fun (z: Smash.model.Carrier) => Other.Fiber (Smash.second z)), range := SecondFull.firstBundle, g := (\fun (z: Smash.model.Carrier) => z)] \as SecondBefore;
\import Bundles.Morphisms[X := Smash.model.Carrier, Y := Smash.model.Carrier, F := (\fun (z: Smash.model.Carrier) => Other.Fiber (Smash.second z)), G := (\fun (z: Smash.model.Carrier) => Other.Fiber (Smash.second z)),
  source := SecondFull.secondBundle, target := SecondFull.firstBundle, f := (\fun (z: Smash.model.Carrier) => z)]
  .Composition[Z := Smash.model.Carrier, H := (\fun (z: Smash.model.Carrier) => Other.Fiber (Smash.second z)), range := SecondFull.secondBundle, g := (\fun (z: Smash.model.Carrier) => z)] \as SecondAfter;
\definition secondOperator: Bundles.Morphisms[X := Smash.model.Carrier, Y := Smash.model.Carrier, F := Blocks.RightFiber, G := Blocks.RightFiber,
  source := Blocks.rightBundle, target := Blocks.rightBundle, f := (\fun (z: Smash.model.Carrier) => z)].Map :=
  SecondAfter.compose (SecondBefore.compose SecondFull.isomorphism.backward SecondOperatorPull.map) SecondFull.isomorphism.forward;
\definition firstCoefficient[z: Smash.model.Carrier]: C.Complex := coefficient (Smash.first z);
\definition secondCoefficient[z: Smash.model.Carrier]: C.Complex := Other.coefficient (Smash.second z);
\definition firstCoefficientContinuous: topology.Continuity[A := Smash.model.Carrier, B := C.Complex].Continuous Smash.topology Scalars.scalar.topological.space firstCoefficient :=
  topology.Composition[A := Smash.model.Carrier, B := Base, C := C.Complex].composeContinuous Smash.topology baseTopology Scalars.scalar.topological.space Smash.first coefficient firstRegular coefficientContinuous;
\definition secondCoefficientContinuous: topology.Continuity[A := Smash.model.Carrier, B := C.Complex].Continuous Smash.topology Scalars.scalar.topological.space secondCoefficient :=
  topology.Composition[A := Smash.model.Carrier, B := Other.Base, C := C.Complex].composeContinuous Smash.topology Other.baseTopology Scalars.scalar.topological.space Smash.second Other.coefficient secondRegular Other.coefficientContinuous;
\definition data: Blocks.Data := Blocks.Data { first := firstOperator, second := secondOperator,
  a := firstCoefficient, b := secondCoefficient, aContinuous := firstCoefficientContinuous, bContinuous := secondCoefficientContinuous };
\definition laws: Blocks.Laws[data] := Blocks.Laws[data] {
  firstSquare := \fun (z: Smash.model.Carrier) => square (Smash.first z),
  secondSquare := \fun (z: Smash.model.Carrier) => Other.square (Smash.second z),
  firstAnti := \fun (z: Smash.model.Carrier) => anticommutes (Smash.first z),
  secondAnti := \fun (z: Smash.model.Carrier) => Other.anticommutes (Smash.second z)
};
\import Blocks.With[c := data, laws := laws] \as ProductSymbol;
\definition leftNorm: Base -> Real.Real := norm;
\definition leftNormPoint: leftNorm point = Real.one := normAtPoint;
\definition firstNorm[z: Smash.model.Carrier]: Real.Real := leftNorm (Smash.first z);
\definition secondNorm[z: Smash.model.Carrier]: Real.Real := Other.norm (Smash.second z);
\definition normCoefficient[z: Smash.model.Carrier]: ProductSymbol.coefficient z = Scalar.ofReal (Real.add (firstNorm z) (secondNorm z)) :=
  trans!{{C.Complex}} _ _ _
    (congr!{{C.Complex} {C.Complex} {C.Complex}} Scalar.add _ _ _ _ (coefficientReal (Smash.first z)) (Other.coefficientReal (Smash.second z)))
    (sym!{{C.Complex}} _ _ (C.Prop[].ofRealAdd (firstNorm z) (secondNorm z)));
\module Boundary;
\module Native;
