\import Operations.TensorEquality[V := Parity.LeftFiber z, W := Parity.RightFiber z, U := Parity.SourceFiber z,
  left := Parity.leftBundle.space z, right := Parity.rightBundle.space z, target := Parity.sourceBundle.space z] \as EqualityOnPure;
\definition pure: \forall (v: Parity.LeftFiber z)(w: Parity.RightFiber z) -> (FullCF.operator.fiber z).apply (Tensor.pure z v w) = (Additive.combined.fiber z).apply (Tensor.pure z v w) :=
  \fun (v: Parity.LeftFiber z)(w: Parity.RightFiber z) => trans!{{Parity.SourceFiber z}} _ _ _ (FullCF.onPure z v w)
    (trans!{{Parity.SourceFiber z}} _ _ _
      (congr!{{Parity.SourceFiber z} {Parity.SourceFiber z} {Parity.SourceFiber z}} (Parity.sourceBundle.space z).add _ _ _ _
        (congr!{{Parity.LeftFiber z} {Parity.SourceFiber z}} (\fun (a: Parity.LeftFiber z) => Tensor.pure z a w) _ _ (\parent.\parent.At[z := z].firstSum v))
        (congr!{{Parity.RightFiber z} {Parity.SourceFiber z}} (Tensor.pure z ((Grading.leftGrading.forward.fiber z).apply v)) _ _ (\parent.\parent.At[z := z].secondSum w)))
      (sym!{{Parity.SourceFiber z}} _ _ (Additive.combinedOnPure z v w)));
\definition equation: \forall (v: Parity.SourceFiber z) -> (FullCF.operator.fiber z).apply v = (Additive.combined.fiber z).apply v :=
  EqualityOnPure.pointwise (FullCF.operator.fiber z) (Additive.combined.fiber z) pure;
