\import \root.Thom[].TensorOperatorAdditivity[X := NativeProduct.Z, F := Parity.LeftFiber, G := Parity.RightFiber,
  first := Parity.leftBundle, second := Parity.rightBundle, sameBase := (\refl(NativeProduct.topology))]
  .With[firstD := RawFirstD.operator, firstR := RawFirstR.operator, secondD := RawSecondD.operator, secondR := RawSecondR.operator, grading := Grading.leftGrading.forward] \as Additive;
\import \root.Thom[].ComplexProductCliffordBundle[X := NativeProduct.Z, F := Parity.LeftFiber, G := Parity.RightFiber,
  first := Parity.leftBundle, second := Parity.rightBundle, sameBase := (\refl(NativeProduct.topology))]
  .With[c := CF.operators, laws := CF.operatorLaws] \as FullCF;
\import Operations.Tensor[X := NativeProduct.Z, F := Parity.LeftFiber, G := Parity.RightFiber, left := Parity.leftBundle, right := Parity.rightBundle] \as Tensor;
\module At(z: NativeProduct.Z);
\definition tensorEquation: \forall (z: NativeProduct.Z)(v: Parity.SourceFiber z) -> (FullCF.operator.fiber z).apply v = (Parity.sourceBundle.space z).add ((Additive.d.fiber z).apply v) ((Additive.r.fiber z).apply v) :=
  \fun (z: NativeProduct.Z)(v: Parity.SourceFiber z) => trans!{{Parity.SourceFiber z}} _ _ _ (At[z := z].equation v) (Additive.equation z v);
\definition forwardSum: \forall (z: NativeProduct.Z)(v: Parity.Even z) -> (CF.forward.fiber z).apply v = (Parity.oddBundle.space z).add ((Differential.forward.fiber z).apply v) ((Raising.forward.fiber z).apply v) :=
  \fun (z: NativeProduct.Z)(v: Parity.Even z) => trans!{{Parity.Odd z}} _ _ _
    (congr!{{Parity.SourceFiber z} {Parity.Odd z}} (CF.projectOdd.fiber z).apply _ _ (tensorEquation z ((CF.embedEven.fiber z).apply v)))
    ((CF.projectOdd.fiber z).preservesAdd ((Additive.d.fiber z).apply ((CF.embedEven.fiber z).apply v)) ((Additive.r.fiber z).apply ((CF.embedEven.fiber z).apply v)));
\definition backwardSum: \forall (z: NativeProduct.Z)(v: Parity.Odd z) -> (CF.backward.fiber z).apply v = (Parity.evenBundle.space z).add ((Differential.backward.fiber z).apply v) ((Raising.backward.fiber z).apply v) :=
  \fun (z: NativeProduct.Z)(v: Parity.Odd z) => trans!{{Parity.Even z}} _ _ _
    (congr!{{Parity.SourceFiber z} {Parity.Even z}} (CF.projectEven.fiber z).apply _ _ (tensorEquation z ((CF.embedOdd.fiber z).apply v)))
    ((CF.projectEven.fiber z).preservesAdd ((Additive.d.fiber z).apply ((CF.embedOdd.fiber z).apply v)) ((Additive.r.fiber z).apply ((CF.embedOdd.fiber z).apply v)));
