\import \root.Thom[].ComplexProductBlocks[X := NativeProduct.Z,
  F0 := Original.FirstEven, F1 := Original.FirstOdd, G0 := SecondEven, G1 := SecondOdd,
  e0 := Original.FirstEvenBundle, e1 := Original.FirstOddBundle, f0 := SecondEvenBundle, f1 := SecondOddBundle,
  sameE1 := (\refl(NativeProduct.topology)), sameF0 := (\refl(NativeProduct.topology)), sameF1 := (\refl(NativeProduct.topology))] \as IntermediateBlocks;
\definition intermediateData: IntermediateBlocks.Data := IntermediateBlocks.Data { first := Original.First[].operator, second := secondOperator,
  a := firstCoefficient, b := secondCoefficient, aContinuous := firstCoefficientContinuous, bContinuous := secondCoefficientContinuous };
\definition intermediateLaws: IntermediateBlocks.Laws[intermediateData] := IntermediateBlocks.Laws[intermediateData] {
  firstSquare := Original.First[].square, secondSquare := (\fun (z: NativeProduct.Z) => RightNative.nativeSquare (NativeProduct.second z)), firstAnti := Original.First[].anticommutes, secondAnti := (\fun (z: NativeProduct.Z) => RightNative.nativeAnticommutes (NativeProduct.second z))
};
\import IntermediateBlocks.With[c := intermediateData, laws := intermediateLaws] \as IntermediateSymbol;
\import IntermediateSymbol.On[subset := NativeProduct.boundary, nonzero := nonzero] \as IntermediateBoundary;
\definition IntermediateEven[z: NativeProduct.Z]: \Set := IntermediateBlocks.Even z;
\definition IntermediateOdd[z: NativeProduct.Z]: \Set := IntermediateBlocks.Odd z;
\definition intermediateEvenBundle: Bundles.Family[X := NativeProduct.Z, F := IntermediateEven].Bundle := IntermediateBlocks.evenBundle;
\definition intermediateOddBundle: Bundles.Family[X := NativeProduct.Z, F := IntermediateOdd].Bundle := IntermediateBlocks.oddBundle;
\import NativePair.BundleModel[F := IntermediateEven].From[original := intermediateEvenBundle, same := (\refl(NativeProduct.topology))] \as IntermediatePositive;
\import NativePair.BundleModel[F := IntermediateOdd].From[original := intermediateOddBundle, same := (\refl(NativeProduct.topology))] \as IntermediateNegative;
\definition intermediateEvenModel: NativePair.BundleModel[F := IntermediateEven].Bundle := IntermediatePositive.model;
\definition intermediateOddModel: NativePair.BundleModel[F := IntermediateOdd].Bundle := IntermediateNegative.model;
\import NativePair.BundleTriples[F := IntermediateEven, G := IntermediateOdd, firstModel := intermediateEvenModel, secondModel := intermediateOddModel] \as IntermediateTriple;
\definition intermediateComparison: IntermediateTriple.OnSubset := IntermediateBoundary.isomorphism;
\definition intermediateValue: NativeQ.Relative := IntermediateTriple.With[alpha := intermediateComparison].reduced;
\definition intermediateForward: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := IntermediateEven, G := IntermediateOdd,
  source := intermediateEvenBundle, target := intermediateOddBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := IntermediateSymbol.forward;
\definition intermediateFormula: \forall (z: NativePair.A)(v: IntermediateEven z) ->
  (intermediateComparison.forward.fiber z).apply v = (intermediateForward.fiber z).apply v := IntermediateBoundary.formula;
