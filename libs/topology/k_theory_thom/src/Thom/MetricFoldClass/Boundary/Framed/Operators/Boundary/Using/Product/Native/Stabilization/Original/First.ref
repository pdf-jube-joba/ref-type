\import Operations.DirectSum[X := NativeProduct.Z, F := FirstEven, G := FirstOdd, left := FirstEvenBundle, right := FirstOddBundle] \as Sum;
\definition Fiber[z: NativeProduct.Z]: \Set := Sum.Fiber z;
\definition bundle: Bundles.Family[X := NativeProduct.Z, F := Fiber].Bundle := Sum.bundle (\refl(NativeProduct.topology));
\import Sum.Of[same := (\refl(NativeProduct.topology))] \as Split;
\import Split.From[Y := NativeProduct.Z, H := Fiber, source := bundle, f := (\fun (z: NativeProduct.Z) => z)] \as Into;
\import Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Fiber, G := FirstOdd,
  source := bundle, target := FirstOddBundle, f := (\fun (z: NativeProduct.Z) => z)]
  .Composition[Z := NativeProduct.Z, H := FirstEven, range := FirstEvenBundle, g := (\fun (z: NativeProduct.Z) => z)] \as ToEven;
\import Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Fiber, G := FirstEven,
  source := bundle, target := FirstEvenBundle, f := (\fun (z: NativeProduct.Z) => z)]
  .Composition[Z := NativeProduct.Z, H := FirstOdd, range := FirstOddBundle, g := (\fun (z: NativeProduct.Z) => z)] \as ToOdd;
\definition operator: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Fiber, G := Fiber,
  source := bundle, target := bundle, f := (\fun (z: NativeProduct.Z) => z)].Map := Into.pair (ToEven.compose Split.secondMap FirstE) (ToOdd.compose Split.firstMap FirstD);
\import Operations.IdentityIsomorphism[X := NativeProduct.Z, F := FirstEven, bundle := FirstEvenBundle] \as PositiveIdentity;
\import Operations.Negation[X := NativeProduct.Z, F := FirstOdd, bundle := FirstOddBundle] \as NegativeSign;
\import Operations.DirectSumIsomorphisms[X := NativeProduct.Z, F := FirstEven, G := FirstOdd, A := FirstEven, B := FirstOdd,
  first := FirstEvenBundle, second := FirstOddBundle, newFirst := FirstEvenBundle, newSecond := FirstOddBundle,
  sameSource := (\refl(NativeProduct.topology)), sameTarget := (\refl(NativeProduct.topology))] \as PairMaps;
\definition grading: Bundles.Isomorphisms[X := NativeProduct.Z, F := Fiber, G := Fiber, source := bundle, target := bundle].Isomorphism := PairMaps.isomorphism PositiveIdentity.isomorphism NegativeSign.isomorphism;
\definition square: \forall (z: NativeProduct.Z)(v: Fiber z) -> (operator.fiber z).apply ((operator.fiber z).apply v) = (bundle.space z).smul (firstCoefficient z) v :=
  \fun (z: NativeProduct.Z)(v: Fiber z) => P.Prop[A := FirstEven z, B := FirstOdd z].pairCong _ _ _ _
    (LeftFrame.nativeSquareEven (NativeProduct.first z) (P.first (FirstEven z) (FirstOdd z) v))
    (LeftFrame.nativeSquareOdd (NativeProduct.first z) (P.second (FirstEven z) (FirstOdd z) v));
\module At(z: NativeProduct.Z);
\definition anticommutes: \forall (z: NativeProduct.Z)(v: Fiber z) -> (bundle.space z).add
  ((grading.forward.fiber z).apply ((operator.fiber z).apply v)) ((operator.fiber z).apply ((grading.forward.fiber z).apply v)) = (bundle.space z).zero :=
  \fun (z: NativeProduct.Z) => At[z := z].equation;
