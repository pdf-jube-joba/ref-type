\import Spaces.Linear[V := FirstOdd z, W := FirstEven z, source := FirstOddBundle.space z, target := FirstEvenBundle.space z].Operations[] \as Maps;
\import algebra.Group[].Of[Carrier := FirstEven z,
  group := std.Alg[].Ring[].ringModuleAsCommutativeGroup C.Complex (FirstEven z) Spaces.ring (FirstEvenBundle.space z)] \as PositiveGroup;
\import Spaces.Laws[V := FirstOdd z, space := FirstOddBundle.space z] \as NegativeLaws;
\definition equation: \forall (v: Fiber z) -> (bundle.space z).add
  ((grading.forward.fiber z).apply ((operator.fiber z).apply v)) ((operator.fiber z).apply ((grading.forward.fiber z).apply v)) = (bundle.space z).zero :=
  \fun (v: Fiber z) => P.Prop[A := FirstEven z, B := FirstOdd z].ext _ _
    (trans!{{FirstEven z}} _ _ _
      (congr!{{FirstEven z} {FirstEven z}} ((FirstEvenBundle.space z).add ((FirstE.fiber z).apply (P.second (FirstEven z) (FirstOdd z) v))) _ _
        (trans!{{FirstEven z}} _ _ _
          (congr!{{FirstOdd z} {FirstEven z}} (FirstE.fiber z).apply _ _ (NegativeSign.formula z (P.second (FirstEven z) (FirstOdd z) v)))
          (Maps.preservesNeg (FirstE.fiber z) (P.second (FirstEven z) (FirstOdd z) v))))
      (PositiveGroup.inverseRight ((FirstE.fiber z).apply (P.second (FirstEven z) (FirstOdd z) v))))
    (trans!{{FirstOdd z}} _ _ _
      (congr!{{FirstOdd z} {FirstOdd z}} (\fun (w: FirstOdd z) => (FirstOddBundle.space z).add w ((FirstD.fiber z).apply (P.first (FirstEven z) (FirstOdd z) v))) _ _
        (NegativeSign.formula z ((FirstD.fiber z).apply (P.first (FirstEven z) (FirstOdd z) v))))
      (NegativeLaws.inverseLeft ((FirstD.fiber z).apply (P.first (FirstEven z) (FirstOdd z) v))));
