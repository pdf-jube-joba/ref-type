\import Spaces.Laws[V := FirstEven z, space := FirstEvenBundle.space z] \as FirstEvenLaws;
\import Spaces.Laws[V := FirstOdd z, space := FirstOddBundle.space z] \as FirstOddLaws;
\import Spaces.Laws[V := SecondEven z, space := SecondEvenBundle.space z] \as SecondEvenLaws;
\import Spaces.Laws[V := SecondOdd z, space := SecondOddBundle.space z] \as SecondOddLaws;
\definition FirstDEven: \forall (v: FirstEven z) -> (firste.fiber z).apply ((firstd.fiber z).apply v) = (FirstEvenBundle.space z).smul Scalar.zero v :=
  \fun (v: FirstEven z) => trans!{{FirstEven z}} _ _ _ (LeftFrame.differentialSquare (NativeProduct.first z) v) (sym!{{FirstEven z}} _ _ (FirstEvenLaws.zeroScale v));
\definition FirstDOdd: \forall (v: FirstOdd z) -> (firstd.fiber z).apply ((firste.fiber z).apply v) = (FirstOddBundle.space z).smul Scalar.zero v :=
  \fun (v: FirstOdd z) => trans!{{FirstOdd z}} _ _ _ (LeftFrame.codifferentialSquare (NativeProduct.first z) v) (sym!{{FirstOdd z}} _ _ (FirstOddLaws.zeroScale v));
\definition FirstREven: \forall (v: FirstEven z) -> (firsth.fiber z).apply ((firstk.fiber z).apply v) = (FirstEvenBundle.space z).smul Scalar.zero v :=
  \fun (v: FirstEven z) => trans!{{FirstEven z}} _ _ _ (LeftFrame.raisingEvenSquare (NativeProduct.first z) v) (sym!{{FirstEven z}} _ _ (FirstEvenLaws.zeroScale v));
\definition FirstROdd: \forall (v: FirstOdd z) -> (firstk.fiber z).apply ((firsth.fiber z).apply v) = (FirstOddBundle.space z).smul Scalar.zero v :=
  \fun (v: FirstOdd z) => trans!{{FirstOdd z}} _ _ _ (LeftFrame.raisingOddSquare (NativeProduct.first z) v) (sym!{{FirstOdd z}} _ _ (FirstOddLaws.zeroScale v));
\definition SecondDEven: \forall (v: SecondEven z) -> (seconde.fiber z).apply ((secondd.fiber z).apply v) = (SecondEvenBundle.space z).smul Scalar.zero v :=
  \fun (v: SecondEven z) => trans!{{SecondEven z}} _ _ _ (RightFrame.differentialSquare (NativeProduct.second z) v) (sym!{{SecondEven z}} _ _ (SecondEvenLaws.zeroScale v));
\definition SecondDOdd: \forall (v: SecondOdd z) -> (secondd.fiber z).apply ((seconde.fiber z).apply v) = (SecondOddBundle.space z).smul Scalar.zero v :=
  \fun (v: SecondOdd z) => trans!{{SecondOdd z}} _ _ _ (RightFrame.codifferentialSquare (NativeProduct.second z) v) (sym!{{SecondOdd z}} _ _ (SecondOddLaws.zeroScale v));
\definition SecondREven: \forall (v: SecondEven z) -> (secondh.fiber z).apply ((secondk.fiber z).apply v) = (SecondEvenBundle.space z).smul Scalar.zero v :=
  \fun (v: SecondEven z) => trans!{{SecondEven z}} _ _ _ (RightFrame.raisingEvenSquare (NativeProduct.second z) v) (sym!{{SecondEven z}} _ _ (SecondEvenLaws.zeroScale v));
\definition SecondROdd: \forall (v: SecondOdd z) -> (secondk.fiber z).apply ((secondh.fiber z).apply v) = (SecondOddBundle.space z).smul Scalar.zero v :=
  \fun (v: SecondOdd z) => trans!{{SecondOdd z}} _ _ _ (RightFrame.raisingOddSquare (NativeProduct.second z) v) (sym!{{SecondOdd z}} _ _ (SecondOddLaws.zeroScale v));
\definition firstSum: \forall (v: Parity.LeftFiber z) -> (FirstCF.operator.fiber z).apply v = (Parity.leftBundle.space z).add ((RawFirstD.operator.fiber z).apply v) ((RawFirstR.operator.fiber z).apply v) :=
  \fun (v: Parity.LeftFiber z) => P.Prop[A := FirstEven z, B := FirstOdd z].pairCong _ _ _ _
    (LeftFrame.nativeBackwardSum (NativeProduct.first z) (P.second (FirstEven z) (FirstOdd z) v))
    (LeftFrame.nativeForwardSum (NativeProduct.first z) (P.first (FirstEven z) (FirstOdd z) v));
\definition secondSum: \forall (v: Parity.RightFiber z) -> (SecondCF.operator.fiber z).apply v = (Parity.rightBundle.space z).add ((RawSecondD.operator.fiber z).apply v) ((RawSecondR.operator.fiber z).apply v) :=
  \fun (v: Parity.RightFiber z) => P.Prop[A := SecondEven z, B := SecondOdd z].pairCong _ _ _ _
    (RightFrame.nativeBackwardSum (NativeProduct.second z) (P.second (SecondEven z) (SecondOdd z) v))
    (RightFrame.nativeForwardSum (NativeProduct.second z) (P.first (SecondEven z) (SecondOdd z) v));
