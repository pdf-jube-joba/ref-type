\definition first: \forall (v: Source.LeftFiber z) ->
  (Change.firstIso.forward.fiber z).apply ((sourceFirst.fiber z).apply v) = (targetFirst.fiber z).apply ((Change.firstIso.forward.fiber z).apply v) :=
  \fun (v: Source.LeftFiber z) => P.Prop[A := FirstEvenTarget z, B := FirstOddTarget z].pairCong _ _ _ _
    (nestedFirstECommutes z (P.second (FirstEvenSource z) (FirstOddSource z) v))
    (nestedFirstDCommutes z (P.first (FirstEvenSource z) (FirstOddSource z) v));
\definition second: \forall (v: Source.RightFiber z) ->
  (Change.secondIso.forward.fiber z).apply ((sourceSecond.fiber z).apply v) = (targetSecond.fiber z).apply ((Change.secondIso.forward.fiber z).apply v) :=
  \fun (v: Source.RightFiber z) => P.Prop[A := SecondEvenTarget z, B := SecondOddTarget z].pairCong _ _ _ _
    (nestedSecondECommutes z (P.second (SecondEvenSource z) (SecondOddSource z) v))
    (nestedSecondDCommutes z (P.first (SecondEvenSource z) (SecondOddSource z) v));
\definition grading: \forall (v: Source.LeftFiber z) ->
  (Change.firstIso.forward.fiber z).apply ((SourceGrading.leftGrading.forward.fiber z).apply v) =
  (TargetGrading.leftGrading.forward.fiber z).apply ((Change.firstIso.forward.fiber z).apply v) :=
  \fun (v: Source.LeftFiber z) => P.Prop[A := FirstEvenTarget z, B := FirstOddTarget z].pairCong _ _ _ _
    (\refl((FirstEvenIso.forward.fiber z).apply (P.first (FirstEvenSource z) (FirstOddSource z) v)))
    ((FirstOddIso.forward.fiber z).preservesScale (C.Algebra[].field.neg C.Algebra[].field.one) (P.second (FirstEvenSource z) (FirstOddSource z) v));
