\import Bundles.ArrowLaws[X := Disk, Y := Disk, F := LeftFrame.OriginalOdd, G := LeftFrame.OriginalEven,
  source := LeftFrame.originalOddBundle, target := LeftFrame.originalEvenBundle, f := (\fun (x: Disk) => x)]
  .Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.first].Of[a := LeftFrame.nativeBackward, regular := Sectors.firstRegular] \as FirstEPull;
\definition FirstE: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := FirstOdd, G := FirstEven,
  source := FirstOddBundle, target := FirstEvenBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := FirstEPull.map;
\definition SecondEven[z: NativeProduct.Z]: \Set := RightFrame.OriginalEven (NativeProduct.second z);
\import Bundles.Family[X := OtherGeometry.Disk, F := RightFrame.OriginalEven].Of[bundle := RightFrame.originalEvenBundle]
