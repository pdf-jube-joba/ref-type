\definition SecondEvenBundle: Bundles.Family[X := NativeProduct.Z, F := SecondEven].Bundle := SecondEvenPull.pulled Sectors.secondRegular;
\definition SecondOdd[z: NativeProduct.Z]: \Set := RightFrame.OriginalOdd (NativeProduct.second z);
