\import Bundles.ArrowLaws[X := OtherGeometry.Disk, Y := OtherGeometry.Disk, F := RightFrame.OriginalEven, G := RightFrame.OriginalOdd,
  source := RightFrame.originalEvenBundle, target := RightFrame.originalOddBundle, f := (\fun (x: OtherGeometry.Disk) => x)]
  .Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.second].Of[a := RightFrame.nativeForward, regular := Sectors.secondRegular] \as SecondDPull;
\definition SecondD: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := SecondEven, G := SecondOdd,
  source := SecondEvenBundle, target := SecondOddBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := SecondDPull.map;
\import Bundles.ArrowLaws[X := OtherGeometry.Disk, Y := OtherGeometry.Disk, F := RightFrame.OriginalOdd, G := RightFrame.OriginalEven,
  source := RightFrame.originalOddBundle, target := RightFrame.originalEvenBundle, f := (\fun (x: OtherGeometry.Disk) => x)]
  .Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.second].Of[a := RightFrame.nativeBackward, regular := Sectors.secondRegular] \as SecondEPull;
\definition SecondE: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := SecondOdd, G := SecondEven,
  source := SecondOddBundle, target := SecondEvenBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := SecondEPull.map;
\module First;
\module Second;
\import \root.Thom[].ComplexProductBlocks[X := NativeProduct.Z,
  F0 := FirstEven, F1 := FirstOdd, G0 := SecondEven, G1 := SecondOdd,
  e0 := FirstEvenBundle, e1 := FirstOddBundle, f0 := SecondEvenBundle, f1 := SecondOddBundle,
  sameE1 := (\refl(NativeProduct.topology)), sameF0 := (\refl(NativeProduct.topology)), sameF1 := (\refl(NativeProduct.topology))] \as OriginalBlocks;
