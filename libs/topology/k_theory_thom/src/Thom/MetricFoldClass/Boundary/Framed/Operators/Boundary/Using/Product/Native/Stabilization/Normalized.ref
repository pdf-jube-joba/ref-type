\import \parent.Original[] \as Original;
\import \parent.AuxiliaryBundles[] \as AuxGeometry;
\import \parent.\parent.\parent.\parent.\parent.\parent.\parent.\parent.Framed[r := r] \as LeftFrame;
\import OtherGeometry.Boundary[].Framed[r := otherFactor.representation] \as RightFrame;
\import Operations.DirectSum[X := Disk, F := LeftFrame.OriginalEven, G := LeftFrame.H,
  left := LeftFrame.originalEvenBundle, right := LeftFrame.auxiliaryBundle]
  .Of[same := (\refl(diskTopology))].Pullback[Y := NativeProduct.Z, source := NativeProduct.topology, f := NativeProduct.first, regular := Sectors.firstRegular] \as FirstEvenPull;
\definition FirstEven[z: NativeProduct.Z]: \Set := Sectors.FirstEvenTarget z;
\definition FirstEvenBundle: Bundles.Family[X := NativeProduct.Z, F := FirstEven].Bundle := FirstEvenPull.secondBundle;
\definition FirstEvenIso: Bundles.Isomorphisms[X := NativeProduct.Z, F := Sectors.FirstEvenTarget, G := FirstEven,
  source := Sectors.FirstEvenTargetBundle, target := FirstEvenBundle].Isomorphism := FirstEvenPull.isomorphism;
\import Operations.DirectSum[X := Disk, F := LeftFrame.OriginalOdd, G := LeftFrame.H,
  left := LeftFrame.originalOddBundle, right := LeftFrame.auxiliaryBundle]
  .Of[same := (\refl(diskTopology))].Pullback[Y := NativeProduct.Z, source := NativeProduct.topology, f := NativeProduct.first, regular := Sectors.firstRegular] \as FirstOddPull;
\definition FirstOdd[z: NativeProduct.Z]: \Set := Sectors.FirstOddTarget z;
\definition FirstOddBundle: Bundles.Family[X := NativeProduct.Z, F := FirstOdd].Bundle := FirstOddPull.secondBundle;
\definition FirstOddIso: Bundles.Isomorphisms[X := NativeProduct.Z, F := Sectors.FirstOddTarget, G := FirstOdd,
  source := Sectors.FirstOddTargetBundle, target := FirstOddBundle].Isomorphism := FirstOddPull.isomorphism;
\definition FirstRadius[z: NativeProduct.Z]: C.Complex := LeftFrame.radius (NativeProduct.first z);
\definition FirstRadiusContinuous: topology.Continuity[A := NativeProduct.Z, B := C.Complex].Continuous NativeProduct.topology Scalars.scalar.topological.space FirstRadius :=
  topology.Composition[A := NativeProduct.Z, B := Disk, C := C.Complex].composeContinuous NativeProduct.topology diskTopology Scalars.scalar.topological.space
    NativeProduct.first LeftFrame.radius Sectors.firstRegular LeftFrame.radiusContinuous;
\import \root.Thom[].GradedStabilization[X := NativeProduct.Z, E0 := Original.FirstEven, E1 := Original.FirstOdd, H := AuxGeometry.FirstAuxiliary,
  even := Original.FirstEvenBundle, odd := Original.FirstOddBundle, auxiliary := AuxGeometry.FirstAuxiliaryBundle,
  sameOdd := (\refl(NativeProduct.topology)), sameAuxiliary := (\refl(NativeProduct.topology))]
  .With[d := Original.FirstD, e := Original.FirstE, radius := FirstRadius, continuous := FirstRadiusContinuous] \as FirstFactor;
\import Operations.DirectSum[X := OtherGeometry.Disk, F := RightFrame.OriginalEven, G := RightFrame.H,
  left := RightFrame.originalEvenBundle, right := RightFrame.auxiliaryBundle]
  .Of[same := (\refl(OtherGeometry.diskTopology))].Pullback[Y := NativeProduct.Z, source := NativeProduct.topology, f := NativeProduct.second, regular := Sectors.secondRegular] \as SecondEvenPull;
\definition SecondEven[z: NativeProduct.Z]: \Set := Sectors.SecondEvenTarget z;
\definition SecondEvenBundle: Bundles.Family[X := NativeProduct.Z, F := SecondEven].Bundle := SecondEvenPull.secondBundle;
\definition SecondEvenIso: Bundles.Isomorphisms[X := NativeProduct.Z, F := Sectors.SecondEvenTarget, G := SecondEven,
  source := Sectors.SecondEvenTargetBundle, target := SecondEvenBundle].Isomorphism := SecondEvenPull.isomorphism;
\import Operations.DirectSum[X := OtherGeometry.Disk, F := RightFrame.OriginalOdd, G := RightFrame.H,
  left := RightFrame.originalOddBundle, right := RightFrame.auxiliaryBundle]
  .Of[same := (\refl(OtherGeometry.diskTopology))].Pullback[Y := NativeProduct.Z, source := NativeProduct.topology, f := NativeProduct.second, regular := Sectors.secondRegular] \as SecondOddPull;
\definition SecondOdd[z: NativeProduct.Z]: \Set := Sectors.SecondOddTarget z;
\definition SecondOddBundle: Bundles.Family[X := NativeProduct.Z, F := SecondOdd].Bundle := SecondOddPull.secondBundle;
\definition SecondOddIso: Bundles.Isomorphisms[X := NativeProduct.Z, F := Sectors.SecondOddTarget, G := SecondOdd,
  source := Sectors.SecondOddTargetBundle, target := SecondOddBundle].Isomorphism := SecondOddPull.isomorphism;
\definition SecondRadius[z: NativeProduct.Z]: C.Complex := RightFrame.radius (NativeProduct.second z);
\definition SecondRadiusContinuous: topology.Continuity[A := NativeProduct.Z, B := C.Complex].Continuous NativeProduct.topology Scalars.scalar.topological.space SecondRadius :=
  topology.Composition[A := NativeProduct.Z, B := OtherGeometry.Disk, C := C.Complex].composeContinuous NativeProduct.topology OtherGeometry.diskTopology Scalars.scalar.topological.space
    NativeProduct.second RightFrame.radius Sectors.secondRegular RightFrame.radiusContinuous;
\import \root.Thom[].GradedStabilization[X := NativeProduct.Z, E0 := Original.SecondEven, E1 := Original.SecondOdd, H := AuxGeometry.SecondAuxiliary,
  even := Original.SecondEvenBundle, odd := Original.SecondOddBundle, auxiliary := AuxGeometry.SecondAuxiliaryBundle,
  sameOdd := (\refl(NativeProduct.topology)), sameAuxiliary := (\refl(NativeProduct.topology))]
  .With[d := Original.SecondD, e := Original.SecondE, radius := SecondRadius, continuous := SecondRadiusContinuous] \as SecondFactor;
\import \root.Thom[].ComplexProductBlocks[X := NativeProduct.Z,
  F0 := FirstEven, F1 := FirstOdd, G0 := SecondEven, G1 := SecondOdd,
  e0 := FirstEvenBundle, e1 := FirstOddBundle, f0 := SecondEvenBundle, f1 := SecondOddBundle,
  sameE1 := (\refl(NativeProduct.topology)), sameF0 := (\refl(NativeProduct.topology)), sameF1 := (\refl(NativeProduct.topology))] \as Blocks;
\definition LeftFiber[z: NativeProduct.Z]: \Set := Blocks.LeftFiber z;
\definition RightFiber[z: NativeProduct.Z]: \Set := Blocks.RightFiber z;
\definition leftBundle: Bundles.Family[X := NativeProduct.Z, F := LeftFiber].Bundle := Blocks.leftBundle;
\definition rightBundle: Bundles.Family[X := NativeProduct.Z, F := RightFiber].Bundle := Blocks.rightBundle;
\definition data: Blocks.Data := Blocks.Data { first := FirstFactor.sourceOperator, second := SecondFactor.sourceOperator,
  a := firstCoefficient, b := secondCoefficient, aContinuous := firstCoefficientContinuous, bContinuous := secondCoefficientContinuous };
\definition laws: Blocks.Laws[data] := Blocks.Laws[data] {
  firstSquare := \fun (z: NativeProduct.Z) => LeftNative.nativeSquare (NativeProduct.first z),
  secondSquare := \fun (z: NativeProduct.Z) => RightNative.nativeSquare (NativeProduct.second z),
  firstAnti := \fun (z: NativeProduct.Z) => LeftNative.nativeAnticommutes (NativeProduct.first z),
  secondAnti := \fun (z: NativeProduct.Z) => RightNative.nativeAnticommutes (NativeProduct.second z)
};
\import Blocks.With[c := data, laws := laws] \as Symbol;
\import Symbol.On[subset := NativeProduct.boundary, nonzero := nonzero] \as Boundary;
\definition Even[z: NativeProduct.Z]: \Set := Blocks.Even z;
\definition Odd[z: NativeProduct.Z]: \Set := Blocks.Odd z;
\definition evenBundle: Bundles.Family[X := NativeProduct.Z, F := Even].Bundle := Blocks.evenBundle;
\definition oddBundle: Bundles.Family[X := NativeProduct.Z, F := Odd].Bundle := Blocks.oddBundle;
\import NativePair.BundleModel[F := Even].From[original := evenBundle, same := (\refl(NativeProduct.topology))] \as Positive;
\import NativePair.BundleModel[F := Odd].From[original := oddBundle, same := (\refl(NativeProduct.topology))] \as Negative;
\definition evenModel: NativePair.BundleModel[F := Even].Bundle := Positive.model;
\definition oddModel: NativePair.BundleModel[F := Odd].Bundle := Negative.model;
\import NativePair.BundleTriples[F := Even, G := Odd, firstModel := evenModel, secondModel := oddModel] \as Triple;
\definition comparison: Triple.OnSubset := Boundary.isomorphism;
\definition value: NativeQ.Relative := Triple.With[alpha := comparison].reduced;
\definition forward: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Even, G := Odd,
  source := evenBundle, target := oddBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := Symbol.forward;
\definition formula: \forall (z: NativePair.A)(v: Even z) -> (comparison.forward.fiber z).apply v = (forward.fiber z).apply v := Boundary.formula;
\definition firstOperator: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Blocks.LeftFiber, G := Blocks.LeftFiber,
  source := Blocks.leftBundle, target := Blocks.leftBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := FirstFactor.sourceOperator;
\definition secondOperator: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Blocks.RightFiber, G := Blocks.RightFiber,
  source := Blocks.rightBundle, target := Blocks.rightBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := SecondFactor.sourceOperator;
\module Intermediate;
