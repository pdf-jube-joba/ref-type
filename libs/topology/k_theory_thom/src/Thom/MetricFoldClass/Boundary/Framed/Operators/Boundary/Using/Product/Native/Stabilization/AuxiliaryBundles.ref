\import \parent.\parent.\parent.\parent.\parent.\parent.\parent.\parent.Framed[r := r] \as LeftFrame;
\import OtherGeometry.Boundary[].Framed[r := otherFactor.representation] \as RightFrame;
\definition FirstAuxiliary[z: NativeProduct.Z]: \Set := LeftFrame.H (NativeProduct.first z);
\import Bundles.Family[X := Disk, F := LeftFrame.H].Of[bundle := LeftFrame.auxiliaryBundle]
  .Pullback[Y := NativeProduct.Z, source := NativeProduct.topology, f := NativeProduct.first] \as FirstAuxiliaryPull;
\definition FirstAuxiliaryBundle: Bundles.Family[X := NativeProduct.Z, F := FirstAuxiliary].Bundle := FirstAuxiliaryPull.pulled Sectors.firstRegular;
\definition SecondAuxiliary[z: NativeProduct.Z]: \Set := RightFrame.H (NativeProduct.second z);
\import Bundles.Family[X := OtherGeometry.Disk, F := RightFrame.H].Of[bundle := RightFrame.auxiliaryBundle]
  .Pullback[Y := NativeProduct.Z, source := NativeProduct.topology, f := NativeProduct.second] \as SecondAuxiliaryPull;
\definition SecondAuxiliaryBundle: Bundles.Family[X := NativeProduct.Z, F := SecondAuxiliary].Bundle := SecondAuxiliaryPull.pulled Sectors.secondRegular;
