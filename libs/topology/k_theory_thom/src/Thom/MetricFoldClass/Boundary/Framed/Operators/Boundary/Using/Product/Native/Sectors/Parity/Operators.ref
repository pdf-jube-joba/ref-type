\import Operations.DirectSum[X := NativeProduct.Z, F := FirstEvenTarget, G := FirstOddTarget, left := FirstEvenTargetBundle, right := FirstOddTargetBundle]
  .Of[same := (\refl(NativeProduct.topology))] \as TargetFirstSum;
\import TargetFirstSum.From[Y := NativeProduct.Z, H := Target.LeftFiber, source := Target.leftBundle, f := (\fun (z: NativeProduct.Z) => z)] \as TargetFirstInto;
\import Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Target.LeftFiber, G := FirstOddTarget,
  source := Target.leftBundle, target := FirstOddTargetBundle, f := (\fun (z: NativeProduct.Z) => z)]
