\import Operations.DirectSum[X := NativeProduct.Z, F := FirstEvenSource, G := FirstOddSource, left := FirstEvenBundle, right := FirstOddBundle]
  .Of[same := (\refl(NativeProduct.topology))] \as SourceFirstSum;
\import SourceFirstSum.From[Y := NativeProduct.Z, H := Source.LeftFiber, source := Source.leftBundle, f := (\fun (z: NativeProduct.Z) => z)] \as SourceFirstInto;
\import Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Source.LeftFiber, G := FirstOddSource,
  source := Source.leftBundle, target := FirstOddBundle, f := (\fun (z: NativeProduct.Z) => z)]
  .Composition[Z := NativeProduct.Z, H := FirstEvenSource, range := FirstEvenBundle, g := (\fun (z: NativeProduct.Z) => z)] \as SourceFirstToEven;
\import Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Source.LeftFiber, G := FirstEvenSource,
  source := Source.leftBundle, target := FirstEvenBundle, f := (\fun (z: NativeProduct.Z) => z)]
  .Composition[Z := NativeProduct.Z, H := FirstOddSource, range := FirstOddBundle, g := (\fun (z: NativeProduct.Z) => z)] \as SourceFirstToOdd;
\definition sourceFirst: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Source.LeftFiber, G := Source.LeftFiber,
  source := Source.leftBundle, target := Source.leftBundle, f := (\fun (z: NativeProduct.Z) => z)].Map :=
  SourceFirstInto.pair (SourceFirstToEven.compose SourceFirstSum.secondMap nestedFirstE) (SourceFirstToOdd.compose SourceFirstSum.firstMap nestedFirstD);
\import Operations.DirectSum[X := NativeProduct.Z, F := SecondEvenSource, G := SecondOddSource, left := SecondEvenBundle, right := SecondOddBundle]
  .Of[same := (\refl(NativeProduct.topology))] \as SourceSecondSum;
\import SourceSecondSum.From[Y := NativeProduct.Z, H := Source.RightFiber, source := Source.rightBundle, f := (\fun (z: NativeProduct.Z) => z)] \as SourceSecondInto;
