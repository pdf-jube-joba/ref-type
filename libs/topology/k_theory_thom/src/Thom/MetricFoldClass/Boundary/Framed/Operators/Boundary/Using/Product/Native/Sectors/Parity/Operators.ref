\import Source.Grading[] \as SourceGrading;
\import Target.Grading[] \as TargetGrading;
\import \root.Thom[].TensorNaturality[X := NativeProduct.Z, F := Source.LeftFiber, G := Source.RightFiber, A := Target.LeftFiber, B := Target.RightFiber,
  first := Source.leftBundle, second := Source.rightBundle, newFirst := Target.leftBundle, newSecond := Target.rightBundle,
  sameSource := (\refl(NativeProduct.topology)), sameTarget := (\refl(NativeProduct.topology)), firstIso := Change.firstIso, secondIso := Change.secondIso] \as TensorChange;
\definition data: TensorChange.Data := TensorChange.Data {
  sourceFirst := sourceFirst, sourceSecond := sourceSecond, sourceGrading := SourceGrading.leftGrading.forward,
  targetFirst := targetFirst, targetSecond := targetSecond, targetGrading := TargetGrading.leftGrading.forward
};
\module At(z: NativeProduct.Z);
\definition laws: TensorChange.Laws[data] := TensorChange.Laws[data] {
  first := \fun (z: NativeProduct.Z) => At[z := z].first,
  second := \fun (z: NativeProduct.Z) => At[z := z].second,
  grading := \fun (z: NativeProduct.Z) => At[z := z].grading
};
\import TensorChange.With[c := data, laws := laws] \as Tensor;
\import Change.Blocks[c := Tensor.source, d := Tensor.target, operatorCommutes := Tensor.commutes] \as Blocks;
\definition sourceFormula: \forall (z: NativeProduct.Z)(v: EvenSource z) -> (Blocks.sourceBlock.fiber z).apply v = (ProductSymbol.forward.fiber (NativeProduct.image z)).apply v :=
  \fun (z: NativeProduct.Z)(v: EvenSource z) => \refl((ProductSymbol.forward.fiber (NativeProduct.image z)).apply v);
\definition targetForward: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := EvenTarget, G := OddTarget,
  source := evenTarget, target := oddTarget, f := (\fun (z: NativeProduct.Z) => z)].Map := Blocks.targetBlock;
\definition commutes: \forall (z: NativeProduct.Z)(v: EvenSource z) ->
  (odd.forward.fiber z).apply ((ProductSymbol.forward.fiber (NativeProduct.image z)).apply v) =
  (targetForward.fiber z).apply ((even.forward.fiber z).apply v) :=
  \fun (z: NativeProduct.Z)(v: EvenSource z) => trans!{{OddTarget z}} _ _ _
    (congr!{{OddSource z} {OddTarget z}} (Change.oddIso.forward.fiber z).apply _ _ (Pullback.onOdd z ((ProductSymbol.forward.fiber (NativeProduct.image z)).apply v)))
    (trans!{{OddTarget z}} _ _ _
      (congr!{{OddSource z} {OddTarget z}} (Change.oddIso.forward.fiber z).apply _ _ (sym!{{OddSource z}} _ _ (sourceFormula z v)))
      (trans!{{OddTarget z}} _ _ _ (Blocks.equation z v)
        (congr!{{EvenSource z} {OddTarget z}} (\fun (w: EvenSource z) => (targetForward.fiber z).apply ((Change.evenIso.forward.fiber z).apply w)) _ _ (sym!{{EvenSource z}} _ _ (Pullback.onEven z v)))));
