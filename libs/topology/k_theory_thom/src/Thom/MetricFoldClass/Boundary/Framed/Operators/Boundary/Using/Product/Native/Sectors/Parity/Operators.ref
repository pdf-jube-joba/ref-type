\definition targetFirst: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Target.LeftFiber, G := Target.LeftFiber,
  source := Target.leftBundle, target := Target.leftBundle, f := (\fun (z: NativeProduct.Z) => z)].Map :=
