\import Operations.DirectSum[X := NativeProduct.Z, F := SecondEvenTarget, G := SecondOddTarget, left := SecondEvenTargetBundle, right := SecondOddTargetBundle]
  .Of[same := (\refl(NativeProduct.topology))] \as TargetSecondSum;
\import TargetSecondSum.From[Y := NativeProduct.Z, H := Target.RightFiber, source := Target.rightBundle, f := (\fun (z: NativeProduct.Z) => z)] \as TargetSecondInto;
\import Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := Target.RightFiber, G := SecondOddTarget,
