\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := Scalars.scalar] \as Complements;
\import topological_constructions.Product[A := Disk, B := OtherGeometry.Disk].Maps[] \as Projections;
\definition firstRegular: topology.Continuity[A := NativeProduct.Z, B := Disk].Continuous NativeProduct.topology diskTopology NativeProduct.first :=
  Projections.firstContinuous diskTopology OtherGeometry.diskTopology;
\definition secondRegular: topology.Continuity[A := NativeProduct.Z, B := OtherGeometry.Disk].Continuous NativeProduct.topology OtherGeometry.diskTopology NativeProduct.second :=
  Projections.secondContinuous diskTopology OtherGeometry.diskTopology;
\definition FirstEvenSource[z: NativeProduct.Z]: \Set := Even (projection (NativeProduct.first z));
\definition FirstEvenTarget[z: NativeProduct.Z]: \Set := StableEven (NativeProduct.first z);
\import Bundles.Family[X := Base, F := Even].Of[bundle := evenBundle].PullbackComposition[
  Y := Disk, Z := NativeProduct.Z, first := diskTopology, second := NativeProduct.topology, f := projection, g := NativeProduct.first]
  .Of[fRegular := projectionContinuous, gRegular := firstRegular] \as FirstEvenComposition;
\import Complements.PulledIsomorphism[X := Disk, Y := NativeProduct.Z, F := (\fun (x: Disk) => Even (projection x)), G := StableEven,
  source := pulledPositive, target := stableEvenBundle, base := NativeProduct.topology, f := NativeProduct.first, sourceRegular := firstRegular, targetRegular := firstRegular] \as FirstEvenPull;
\import Bundles.Family[X := Disk, F := StableEven].Of[bundle := stableEvenBundle].Pullback[Y := NativeProduct.Z, source := NativeProduct.topology, f := NativeProduct.first] \as FirstEvenTargetPull;
\definition FirstEvenSourceBundle: Bundles.Family[X := NativeProduct.Z, F := FirstEvenSource].Bundle := FirstEvenComposition.direct;
\definition FirstEvenTargetBundle: Bundles.Family[X := NativeProduct.Z, F := FirstEvenTarget].Bundle := FirstEvenTargetPull.pulled firstRegular;
\import Operations.IsomorphismComposition[X := NativeProduct.Z, F := FirstEvenSource, G := FirstEvenSource, H := FirstEvenTarget,
  source := FirstEvenSourceBundle, middle := FirstEvenComposition.nested, target := FirstEvenTargetBundle] \as FirstEvenCompose;
\definition FirstEvenIsomorphism: Bundles.Isomorphisms[X := NativeProduct.Z, F := FirstEvenSource, G := FirstEvenTarget,
  source := FirstEvenSourceBundle, target := FirstEvenTargetBundle].Isomorphism := FirstEvenCompose.compose FirstEvenComposition.isomorphism (FirstEvenPull.isomorphism positive);
\definition FirstOddSource[z: NativeProduct.Z]: \Set := Odd (projection (NativeProduct.first z));
\definition FirstOddTarget[z: NativeProduct.Z]: \Set := StableOdd (NativeProduct.first z);
\import Bundles.Family[X := Base, F := Odd].Of[bundle := oddBundle].PullbackComposition[
  Y := Disk, Z := NativeProduct.Z, first := diskTopology, second := NativeProduct.topology, f := projection, g := NativeProduct.first]
  .Of[fRegular := projectionContinuous, gRegular := firstRegular] \as FirstOddComposition;
\import Complements.PulledIsomorphism[X := Disk, Y := NativeProduct.Z, F := (\fun (x: Disk) => Odd (projection x)), G := StableOdd,
  source := pulledNegative, target := stableOddBundle, base := NativeProduct.topology, f := NativeProduct.first, sourceRegular := firstRegular, targetRegular := firstRegular] \as FirstOddPull;
\import Bundles.Family[X := Disk, F := StableOdd].Of[bundle := stableOddBundle].Pullback[Y := NativeProduct.Z, source := NativeProduct.topology, f := NativeProduct.first] \as FirstOddTargetPull;
\definition FirstOddSourceBundle: Bundles.Family[X := NativeProduct.Z, F := FirstOddSource].Bundle := FirstOddComposition.direct;
\definition FirstOddTargetBundle: Bundles.Family[X := NativeProduct.Z, F := FirstOddTarget].Bundle := FirstOddTargetPull.pulled firstRegular;
\import Operations.IsomorphismComposition[X := NativeProduct.Z, F := FirstOddSource, G := FirstOddSource, H := FirstOddTarget,
  source := FirstOddSourceBundle, middle := FirstOddComposition.nested, target := FirstOddTargetBundle] \as FirstOddCompose;
\definition FirstOddIsomorphism: Bundles.Isomorphisms[X := NativeProduct.Z, F := FirstOddSource, G := FirstOddTarget,
  source := FirstOddSourceBundle, target := FirstOddTargetBundle].Isomorphism := FirstOddCompose.compose FirstOddComposition.isomorphism (FirstOddPull.isomorphism nativeNegative);
\definition SecondEvenSource[z: NativeProduct.Z]: \Set := Other.Even (OtherGeometry.projection (NativeProduct.second z));
\definition SecondEvenTarget[z: NativeProduct.Z]: \Set := Other.StableEven (NativeProduct.second z);
\import Bundles.Family[X := Other.Base, F := Other.Even].Of[bundle := Other.evenBundle].PullbackComposition[
  Y := OtherGeometry.Disk, Z := NativeProduct.Z, first := OtherGeometry.diskTopology, second := NativeProduct.topology, f := OtherGeometry.projection, g := NativeProduct.second]
  .Of[fRegular := OtherGeometry.projectionContinuous, gRegular := secondRegular] \as SecondEvenComposition;
\import Complements.PulledIsomorphism[X := OtherGeometry.Disk, Y := NativeProduct.Z, F := (\fun (x: OtherGeometry.Disk) => Other.Even (OtherGeometry.projection x)), G := Other.StableEven,
  source := Other.pulledPositive, target := Other.stableEvenBundle, base := NativeProduct.topology, f := NativeProduct.second, sourceRegular := secondRegular, targetRegular := secondRegular] \as SecondEvenPull;
\import Bundles.Family[X := OtherGeometry.Disk, F := Other.StableEven].Of[bundle := Other.stableEvenBundle].Pullback[Y := NativeProduct.Z, source := NativeProduct.topology, f := NativeProduct.second] \as SecondEvenTargetPull;
\definition SecondEvenSourceBundle: Bundles.Family[X := NativeProduct.Z, F := SecondEvenSource].Bundle := SecondEvenComposition.direct;
\definition SecondEvenTargetBundle: Bundles.Family[X := NativeProduct.Z, F := SecondEvenTarget].Bundle := SecondEvenTargetPull.pulled secondRegular;
\import Operations.IsomorphismComposition[X := NativeProduct.Z, F := SecondEvenSource, G := SecondEvenSource, H := SecondEvenTarget,
  source := SecondEvenSourceBundle, middle := SecondEvenComposition.nested, target := SecondEvenTargetBundle] \as SecondEvenCompose;
\definition SecondEvenIsomorphism: Bundles.Isomorphisms[X := NativeProduct.Z, F := SecondEvenSource, G := SecondEvenTarget,
  source := SecondEvenSourceBundle, target := SecondEvenTargetBundle].Isomorphism := SecondEvenCompose.compose SecondEvenComposition.isomorphism (SecondEvenPull.isomorphism Other.positive);
\definition SecondOddSource[z: NativeProduct.Z]: \Set := Other.Odd (OtherGeometry.projection (NativeProduct.second z));
\definition SecondOddTarget[z: NativeProduct.Z]: \Set := Other.StableOdd (NativeProduct.second z);
\import Bundles.Family[X := Other.Base, F := Other.Odd].Of[bundle := Other.oddBundle].PullbackComposition[
  Y := OtherGeometry.Disk, Z := NativeProduct.Z, first := OtherGeometry.diskTopology, second := NativeProduct.topology, f := OtherGeometry.projection, g := NativeProduct.second]
  .Of[fRegular := OtherGeometry.projectionContinuous, gRegular := secondRegular] \as SecondOddComposition;
\import Complements.PulledIsomorphism[X := OtherGeometry.Disk, Y := NativeProduct.Z, F := (\fun (x: OtherGeometry.Disk) => Other.Odd (OtherGeometry.projection x)), G := Other.StableOdd,
  source := Other.pulledNegative, target := Other.stableOddBundle, base := NativeProduct.topology, f := NativeProduct.second, sourceRegular := secondRegular, targetRegular := secondRegular] \as SecondOddPull;
\import Bundles.Family[X := OtherGeometry.Disk, F := Other.StableOdd].Of[bundle := Other.stableOddBundle].Pullback[Y := NativeProduct.Z, source := NativeProduct.topology, f := NativeProduct.second] \as SecondOddTargetPull;
\definition SecondOddSourceBundle: Bundles.Family[X := NativeProduct.Z, F := SecondOddSource].Bundle := SecondOddComposition.direct;
\definition SecondOddTargetBundle: Bundles.Family[X := NativeProduct.Z, F := SecondOddTarget].Bundle := SecondOddTargetPull.pulled secondRegular;
\import Operations.IsomorphismComposition[X := NativeProduct.Z, F := SecondOddSource, G := SecondOddSource, H := SecondOddTarget,
  source := SecondOddSourceBundle, middle := SecondOddComposition.nested, target := SecondOddTargetBundle] \as SecondOddCompose;
\definition SecondOddIsomorphism: Bundles.Isomorphisms[X := NativeProduct.Z, F := SecondOddSource, G := SecondOddTarget,
  source := SecondOddSourceBundle, target := SecondOddTargetBundle].Isomorphism := SecondOddCompose.compose SecondOddComposition.isomorphism (SecondOddPull.isomorphism Other.nativeNegative);
\import Bundles.ArrowLaws[X := Base, Y := Base, F := Even, G := Odd, source := evenBundle, target := oddBundle,
  f := (\fun (q: Base) => q)].Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := (\fun (z: NativeProduct.Z) => projection (NativeProduct.first z))]
  .Of[a := forward, regular := FirstEvenComposition.compositeRegular] \as FirstDSourcePull;
\import Bundles.ArrowLaws[X := Disk, Y := Disk, F := StableEven, G := StableOdd, source := stableEvenBundle, target := stableOddBundle,
  f := (\fun (x: Disk) => x)].Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.first]
  .Of[a := stableD, regular := firstRegular] \as FirstDTargetPull;
\definition FirstDSource: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := FirstEvenSource, G := FirstOddSource,
  source := FirstEvenSourceBundle, target := FirstOddSourceBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := FirstDSourcePull.map;
\definition FirstDTarget: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := FirstEvenTarget, G := FirstOddTarget,
  source := FirstEvenTargetBundle, target := FirstOddTargetBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := FirstDTargetPull.map;
\definition FirstDCommutes: \forall (z: NativeProduct.Z)(v: FirstEvenSource z) ->
  (FirstOddIsomorphism.forward.fiber z).apply ((FirstDSource.fiber z).apply v) =
  (FirstDTarget.fiber z).apply ((FirstEvenIsomorphism.forward.fiber z).apply v) :=
  \fun (z: NativeProduct.Z) => nativeForwardCommutes (NativeProduct.first z);
\import Bundles.ArrowLaws[X := Base, Y := Base, F := Odd, G := Even, source := oddBundle, target := evenBundle,
  f := (\fun (q: Base) => q)].Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := (\fun (z: NativeProduct.Z) => projection (NativeProduct.first z))]
  .Of[a := backward, regular := FirstOddComposition.compositeRegular] \as FirstESourcePull;
\import Bundles.ArrowLaws[X := Disk, Y := Disk, F := StableOdd, G := StableEven, source := stableOddBundle, target := stableEvenBundle,
  f := (\fun (x: Disk) => x)].Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.first]
  .Of[a := stableE, regular := firstRegular] \as FirstETargetPull;
\definition FirstESource: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := FirstOddSource, G := FirstEvenSource,
  source := FirstOddSourceBundle, target := FirstEvenSourceBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := FirstESourcePull.map;
\definition FirstETarget: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := FirstOddTarget, G := FirstEvenTarget,
  source := FirstOddTargetBundle, target := FirstEvenTargetBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := FirstETargetPull.map;
\definition FirstECommutes: \forall (z: NativeProduct.Z)(v: FirstOddSource z) ->
  (FirstEvenIsomorphism.forward.fiber z).apply ((FirstESource.fiber z).apply v) =
  (FirstETarget.fiber z).apply ((FirstOddIsomorphism.forward.fiber z).apply v) :=
  \fun (z: NativeProduct.Z) => nativeBackwardCommutes (NativeProduct.first z);
\import Bundles.ArrowLaws[X := Other.Base, Y := Other.Base, F := Other.Even, G := Other.Odd, source := Other.evenBundle, target := Other.oddBundle,
  f := (\fun (q: Other.Base) => q)].Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := (\fun (z: NativeProduct.Z) => OtherGeometry.projection (NativeProduct.second z))]
  .Of[a := Other.forward, regular := SecondEvenComposition.compositeRegular] \as SecondDSourcePull;
\import Bundles.ArrowLaws[X := OtherGeometry.Disk, Y := OtherGeometry.Disk, F := Other.StableEven, G := Other.StableOdd, source := Other.stableEvenBundle, target := Other.stableOddBundle,
  f := (\fun (x: OtherGeometry.Disk) => x)].Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.second]
  .Of[a := Other.stableD, regular := secondRegular] \as SecondDTargetPull;
\definition SecondDSource: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := SecondEvenSource, G := SecondOddSource,
  source := SecondEvenSourceBundle, target := SecondOddSourceBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := SecondDSourcePull.map;
\definition SecondDTarget: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := SecondEvenTarget, G := SecondOddTarget,
  source := SecondEvenTargetBundle, target := SecondOddTargetBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := SecondDTargetPull.map;
\definition SecondDCommutes: \forall (z: NativeProduct.Z)(v: SecondEvenSource z) ->
  (SecondOddIsomorphism.forward.fiber z).apply ((SecondDSource.fiber z).apply v) =
  (SecondDTarget.fiber z).apply ((SecondEvenIsomorphism.forward.fiber z).apply v) :=
  \fun (z: NativeProduct.Z) => Other.nativeForwardCommutes (NativeProduct.second z);
\import Bundles.ArrowLaws[X := Other.Base, Y := Other.Base, F := Other.Odd, G := Other.Even, source := Other.oddBundle, target := Other.evenBundle,
  f := (\fun (q: Other.Base) => q)].Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := (\fun (z: NativeProduct.Z) => OtherGeometry.projection (NativeProduct.second z))]
  .Of[a := Other.backward, regular := SecondOddComposition.compositeRegular] \as SecondESourcePull;
\import Bundles.ArrowLaws[X := OtherGeometry.Disk, Y := OtherGeometry.Disk, F := Other.StableOdd, G := Other.StableEven, source := Other.stableOddBundle, target := Other.stableEvenBundle,
  f := (\fun (x: OtherGeometry.Disk) => x)].Pullback[Z := NativeProduct.Z, space := NativeProduct.topology, g := NativeProduct.second]
  .Of[a := Other.stableE, regular := secondRegular] \as SecondETargetPull;
\definition SecondESource: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := SecondOddSource, G := SecondEvenSource,
  source := SecondOddSourceBundle, target := SecondEvenSourceBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := SecondESourcePull.map;
\definition SecondETarget: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := SecondOddTarget, G := SecondEvenTarget,
  source := SecondOddTargetBundle, target := SecondEvenTargetBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := SecondETargetPull.map;
\definition SecondECommutes: \forall (z: NativeProduct.Z)(v: SecondOddSource z) ->
  (SecondEvenIsomorphism.forward.fiber z).apply ((SecondESource.fiber z).apply v) =
  (SecondETarget.fiber z).apply ((SecondOddIsomorphism.forward.fiber z).apply v) :=
  \fun (z: NativeProduct.Z) => Other.nativeBackwardCommutes (NativeProduct.second z);

\module Parity;
