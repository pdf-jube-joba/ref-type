\import \parent.First[] \as First;
\import \parent.Second[] \as Second;
\definition originalData: OriginalBlocks.Data := OriginalBlocks.Data { first := First.operator, second := Second.operator,
  a := firstCoefficient, b := secondCoefficient, aContinuous := firstCoefficientContinuous, bContinuous := secondCoefficientContinuous };
\definition originalLaws: OriginalBlocks.Laws[originalData] := OriginalBlocks.Laws[originalData] {
  firstSquare := First.square, secondSquare := (Second.square), firstAnti := First.anticommutes, secondAnti := (Second.anticommutes)
};
\import OriginalBlocks.With[c := originalData, laws := originalLaws] \as OriginalSymbol;
\import OriginalSymbol.On[subset := NativeProduct.boundary, nonzero := nonzero] \as OriginalBoundary;
\definition OriginalEven[z: NativeProduct.Z]: \Set := OriginalBlocks.Even z;
\definition OriginalOdd[z: NativeProduct.Z]: \Set := OriginalBlocks.Odd z;
\definition originalEvenBundle: Bundles.Family[X := NativeProduct.Z, F := OriginalEven].Bundle := OriginalBlocks.evenBundle;
\definition originalOddBundle: Bundles.Family[X := NativeProduct.Z, F := OriginalOdd].Bundle := OriginalBlocks.oddBundle;
\import NativePair.BundleModel[F := OriginalEven].From[original := originalEvenBundle, same := (\refl(NativeProduct.topology))] \as OriginalPositive;
\import NativePair.BundleModel[F := OriginalOdd].From[original := originalOddBundle, same := (\refl(NativeProduct.topology))] \as OriginalNegative;
\definition originalEvenModel: NativePair.BundleModel[F := OriginalEven].Bundle := OriginalPositive.model;
\definition originalOddModel: NativePair.BundleModel[F := OriginalOdd].Bundle := OriginalNegative.model;
\import NativePair.BundleTriples[F := OriginalEven, G := OriginalOdd, firstModel := originalEvenModel, secondModel := originalOddModel] \as OriginalTriple;
\definition originalComparison: OriginalTriple.OnSubset := OriginalBoundary.isomorphism;
\definition originalValue: NativeQ.Relative := OriginalTriple.With[alpha := originalComparison].reduced;
\definition originalForward: Bundles.Morphisms[X := NativeProduct.Z, Y := NativeProduct.Z, F := OriginalEven, G := OriginalOdd,
  source := originalEvenBundle, target := originalOddBundle, f := (\fun (z: NativeProduct.Z) => z)].Map := OriginalSymbol.forward;
\definition originalFormula: \forall (z: NativePair.A)(v: OriginalEven z) ->
  (originalComparison.forward.fiber z).apply v = (originalForward.fiber z).apply v := OriginalBoundary.formula;
