\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as Order;
\import Order.Arithmetic[].Prop[] \as Laws;
\import Real.Algebra[] \as Algebra;
\import Real.Estimates[].Product[] \as Bounds;
\import metric_spaces.RealLine[] \as Line;
\import metric_spaces.RealFunctions[A := X] \as Functions;
\import C.Def[] \as Scalar;
\import C.Prop[] \as ComplexLaws;
\import linear_algebra.Hermitian[].Complex[] \as Hermitian;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := Hermitian.scalar] \as Geometry;
\module With(r, b: X -> Real.Real, rContinuous: Functions.Continuous space r, bContinuous: Functions.Continuous space b,
  nonnegative: \forall (x: X) -> Order.Le Real.zero (b x));
