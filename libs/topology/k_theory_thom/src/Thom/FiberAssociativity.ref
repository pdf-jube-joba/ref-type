\use Equality.eq_reason_in;
\import std.Data[].Pair[] \as Pair;
\import relative_k_theory.Relative[] \as Relative;
\import compact_support_k.Support[] \as Support;
\import topology.Topology[Carrier := X] \as Base;
\definition secondCompact: Base.IsCompact second.baseSpace := \idelim first.baseSpace = second.baseSpace \with t: Base.Topology => Base.IsCompact t \by { base: compact, equality: sameSecond };
\definition secondHausdorff: Base.IsT2 second.baseSpace := \idelim first.baseSpace = second.baseSpace \with t: Base.Topology => Base.IsT2 t \by { base: hausdorff, equality: sameSecond };
\definition thirdCompact: Base.IsCompact third.baseSpace := \idelim first.baseSpace = third.baseSpace \with t: Base.Topology => Base.IsCompact t \by { base: compact, equality: sameThird };
\definition thirdHausdorff: Base.IsT2 third.baseSpace := \idelim first.baseSpace = third.baseSpace \with t: Base.Topology => Base.IsT2 t \by { base: hausdorff, equality: sameThird };
\definition lastBase: second.baseSpace = third.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameSecond) sameThird;
\import Operations.DirectSum[X := X, F := F, G := G, left := first, right := second] \as AB;
\import Operations.DirectSum[X := X, F := G, G := H, left := second, right := third] \as BC;
\import Operations.DirectSumAssociator[X := X, F := F, G := G, H := H, left := first, middle := second, right := third,
  sameMiddle := sameSecond, sameRight := sameThird] \as Associator;
\import Bundles.Family[X := X, F := F] \as FirstFamily;
\import Bundles.Family[X := X, F := G] \as SecondFamily;
\import Bundles.Family[X := X, F := H] \as ThirdFamily;
\import Bundles.Family[X := X, F := AB.Fiber] \as ABFamily;
\import Bundles.Family[X := X, F := BC.Fiber] \as BCFamily;
\import Bundles.Family[X := X, F := Associator.SourceFiber] \as SourceFamily;
\import Bundles.Family[X := X, F := Associator.TargetFiber] \as TargetFamily;
\import \root.Thom[].TotalSpace[X := X, F := F, bundle := first, compact := compact, hausdorff := hausdorff] \as FirstTotal;
\import \root.Thom[].TotalSpace[X := X, F := G, bundle := second, compact := secondCompact, hausdorff := secondHausdorff] \as SecondTotal;
\import \root.Thom[].TotalSpace[X := X, F := H, bundle := third, compact := thirdCompact, hausdorff := thirdHausdorff] \as ThirdTotal;
\import \root.Thom[].TotalSpace[X := X, F := AB.Fiber, bundle := AB.bundle sameSecond, compact := compact, hausdorff := hausdorff] \as ABTotal;
\import \root.Thom[].TotalSpace[X := X, F := BC.Fiber, bundle := BC.bundle lastBase, compact := secondCompact, hausdorff := secondHausdorff] \as BCTotal;
\import \root.Thom[].TotalSpace[X := X, F := Associator.SourceFiber, bundle := Associator.sourceBundle, compact := compact, hausdorff := hausdorff] \as SourceTotal;
\import \root.Thom[].TotalSpace[X := X, F := Associator.TargetFiber, bundle := Associator.targetBundle, compact := compact, hausdorff := hausdorff] \as TargetTotal;
\import Support.On[X := FirstFamily.Point, space := first.totalSpace, hausdorff := FirstTotal.separated, locallyCompact := FirstTotal.locallyCompact] \as A;
\import Support.On[X := SecondFamily.Point, space := second.totalSpace, hausdorff := SecondTotal.separated, locallyCompact := SecondTotal.locallyCompact] \as B;
\import Support.On[X := ThirdFamily.Point, space := third.totalSpace, hausdorff := ThirdTotal.separated, locallyCompact := ThirdTotal.locallyCompact] \as C;
\import Support.On[X := ABFamily.Point, space := (AB.bundle sameSecond).totalSpace, hausdorff := ABTotal.separated, locallyCompact := ABTotal.locallyCompact] \as ABSupport;
\import Support.On[X := BCFamily.Point, space := (BC.bundle lastBase).totalSpace, hausdorff := BCTotal.separated, locallyCompact := BCTotal.locallyCompact] \as BCSupport;
\import Support.On[X := SourceFamily.Point, space := Associator.sourceBundle.totalSpace, hausdorff := SourceTotal.separated, locallyCompact := SourceTotal.locallyCompact] \as Source;
\import Support.On[X := TargetFamily.Point, space := Associator.targetBundle.totalSpace, hausdorff := TargetTotal.separated, locallyCompact := TargetTotal.locallyCompact] \as Target;
\import \root.Thom[].FiberMultiply[X := X, F := F, G := G, left := first, right := second, sameBase := sameSecond, compact := compact, hausdorff := hausdorff] \as MultiplyAB;
\import \root.Thom[].FiberMultiply[X := X, F := G, G := H, left := second, right := third, sameBase := lastBase, compact := secondCompact, hausdorff := secondHausdorff] \as MultiplyBC;
\import \root.Thom[].FiberMultiply[X := X, F := AB.Fiber, G := H, left := AB.bundle sameSecond, right := third, sameBase := sameThird, compact := compact, hausdorff := hausdorff] \as MultiplyLeft;
\import \root.Thom[].FiberMultiply[X := X, F := F, G := BC.Fiber, left := first, right := BC.bundle lastBase, sameBase := sameSecond, compact := compact, hausdorff := hausdorff] \as MultiplyRight;
\import Relative.Smash[left := A.model, right := B.model] \as ABSmash;
\import Relative.Smash[left := B.model, right := C.model] \as BCSmash;
\import Relative.Smash[left := ABSupport.model, right := C.model] \as LeftSmash;
\import Relative.Smash[left := A.model, right := BCSupport.model] \as RightSmash;
\import Relative.Smash[left := ABSmash.result, right := C.model] \as LeftIterated;
\import Relative.Smash[left := A.model, right := BCSmash.result] \as RightIterated;
\import \root.Thom[].SmashAssociator[first := A.model, second := B.model, third := C.model] \as SmashAssociator;
\import Bundles.Isomorphisms[X := X, F := Associator.SourceFiber, G := Associator.TargetFiber,
  source := Associator.sourceBundle, target := Associator.targetBundle] \as BundleIsomorphisms;
\definition homeomorphism: topology.Homeomorphism[A := SourceFamily.Point, B := TargetFamily.Point].Homeomorphism[Associator.sourceBundle.totalSpace, Associator.targetBundle.totalSpace] :=
  BundleIsomorphisms.homeomorphism Associator.isomorphism;
\import Support.Homeomorphic[A := SourceFamily.Point, B := TargetFamily.Point, source := Associator.sourceBundle.totalSpace, target := Associator.targetBundle.totalSpace, h := homeomorphism] \as Homeomorphic;
\import Source.Pullback[Y := TargetFamily.Point, target := Associator.targetBundle.totalSpace, targetHausdorff := TargetTotal.separated,
  targetLocallyCompact := TargetTotal.locallyCompact, f := homeomorphism.forward,
  continuous := (topology.Homeomorphism[A := SourceFamily.Point, B := TargetFamily.Point].laws Associator.sourceBundle.totalSpace Associator.targetBundle.totalSpace homeomorphism).forwardContinuous,
  proper := Homeomorphic.proper] \as Change;
\definition association: Relative.Map Source.model Target.model := Change.mapping;
\module Equivalence;
\definition sourceModel: Relative.CompactPointed := Source.model;
\definition targetModel: Relative.CompactPointed := Target.model;
\definition associationEquivalence: Relative.Equivalence[source := sourceModel, target := targetModel].Data := Equivalence[].value;
\module Maps;
\module Classes;
\definition associativity: \forall (a: MultiplyAB.First)(b: MultiplyAB.Second)(c: MultiplyBC.Second) ->
  MultiplyLeft.multiply (MultiplyAB.multiply a b) c =
    Relative.Pullback[source := Source.model, target := Target.model, f := association].map (MultiplyRight.multiply a (MultiplyBC.multiply b c)) := Classes[].equation;
