\import C.Prop[] \as ScalarLaws;
\definition coefficient[x: Pair.A]: C.Complex := Scalar.ofReal (c.q x);
\definition coefficientContinuous: topology.Continuity[A := Pair.A, B := C.Complex].Continuous Pair.subspace Scalars.scalar.topological.space coefficient :=
  hermitian_frames.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := linear_algebra.Hermitian[].Complex[].scalar, topological := Scalars.scalar.topological].Functions[X := Pair.A].embedding Pair.subspace c.q c.continuous;
\definition coefficientNonzero[x: Pair.A]: Scalar.NonZero (coefficient x) := \fun (zero: _) => Real.Inverse[].positiveNonzero (c.q x) (c.positive x) (ScalarLaws.ofRealInjective (c.q x) Real.zero zero);
\definition reciprocal[x: Pair.A]: C.Complex := Scalar.inv (coefficient x);
\definition reciprocalContinuous: topology.Continuity[A := Pair.A, B := C.Complex].Continuous Pair.subspace Scalars.scalar.topological.space reciprocal :=
  topological_algebra.Complex[].Functions[A := Pair.A].inverseContinuous Pair.subspace coefficient coefficientContinuous coefficientNonzero;
\definition normalizedH: Boundary.Map Q.value P.value := Backward.functionScale reciprocal c.h reciprocalContinuous;
\definition normalizedK: Boundary.Map P.value Q.value := Forward.functionScale reciprocal c.k reciprocalContinuous;
\module At(x: Pair.A);
\definition contraction: Acyclic.Contraction := Acyclic.Contraction { h := normalizedH, k := normalizedK, laws := \fun (x: Pair.A) => At[x := x].laws };
\import Acyclic.Normalized[c := contraction] \as Normalized;
\definition hFixed: \forall (x: Pair.A)(v: Odd x) -> (Normalized.h.fiber x).apply v = (normalizedH.fiber x).apply v := \fun (x: Pair.A) => At[x := x].hFixed;
\definition kFixed: \forall (x: Pair.A)(v: Even x) -> (Normalized.k.fiber x).apply v = (normalizedK.fiber x).apply v := \fun (x: Pair.A) => At[x := x].kFixed;
\definition restoreH: \forall (x: Pair.A)(v: Odd x) -> ((Boundary.bundle P.value).space x).smul (coefficient x) ((normalizedH.fiber x).apply v) = (c.h.fiber x).apply v := \fun (x: Pair.A) => At[x := x].restoreH;
\definition restoreK: \forall (x: Pair.A)(v: Even x) -> ((Boundary.bundle Q.value).space x).smul (coefficient x) ((normalizedK.fiber x).apply v) = (c.k.fiber x).apply v := \fun (x: Pair.A) => At[x := x].restoreK;
\definition exact: Source.Exact := \fun (x: Pair.A) => Logic.And[_, _]::# (At[x := x].evenPreimage) (At[x := x].oddPreimage);
\module Path;
\module Class;
