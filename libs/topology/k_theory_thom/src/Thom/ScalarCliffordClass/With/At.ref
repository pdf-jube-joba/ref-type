\import Spaces.Laws[V := Even x, space := (Boundary.bundle P.value).space x] \as EvenLaws;
\import Spaces.Laws[V := Odd x, space := (Boundary.bundle Q.value).space x] \as OddLaws;
\import Operations.ContractingPair[V := Even x, W := Odd x, even := (Boundary.bundle P.value).space x, odd := (Boundary.bundle Q.value).space x] \as Contract;
\module Expansion;
\definition evenCartan: \forall (v: Even x) -> ((Boundary.bundle P.value).space x).add ((e.fiber x).apply ((c.k.fiber x).apply v)) ((c.h.fiber x).apply ((d.fiber x).apply v)) = ((Boundary.bundle P.value).space x).smul (coefficient x) v :=
  \fun (v: Even x) => trans!{{Even x}} _ _ _ (sym!{{Even x}} _ _ (Expansion[].even v)) (laws.evenSquare x v);
\definition oddCartan: \forall (v: Odd x) -> ((Boundary.bundle Q.value).space x).add ((d.fiber x).apply ((c.h.fiber x).apply v)) ((c.k.fiber x).apply ((e.fiber x).apply v)) = ((Boundary.bundle Q.value).space x).smul (coefficient x) v :=
  \fun (v: Odd x) => trans!{{Odd x}} _ _ _ (sym!{{Odd x}} _ _ (Expansion[].odd v)) (laws.oddSquare x v);
\definition data: Contract.Data := Contract.Data { d := d.fiber x, e := e.fiber x, h := normalizedH.fiber x, k := normalizedK.fiber x };
\definition even: \forall (v: Even x) -> ((Boundary.bundle P.value).space x).add ((e.fiber x).apply ((normalizedK.fiber x).apply v)) ((normalizedH.fiber x).apply ((d.fiber x).apply v)) = v :=
  \fun (v: Even x) => trans!{{Even x}} _ _ _
    (congr!{{Even x} {Even x}} (\fun (w: Even x) => ((Boundary.bundle P.value).space x).add w ((normalizedH.fiber x).apply ((d.fiber x).apply v))) _ _
      ((e.fiber x).preservesScale (reciprocal x) ((c.k.fiber x).apply v)))
    (trans!{{Even x}} _ _ _
      (sym!{{Even x}} _ _ (((Boundary.bundle P.value).space x).vectorAdd (reciprocal x) ((e.fiber x).apply ((c.k.fiber x).apply v)) ((c.h.fiber x).apply ((d.fiber x).apply v))))
      (trans!{{Even x}} _ _ _
        (congr!{{Even x} {Even x}} (((Boundary.bundle P.value).space x).smul (reciprocal x)) _ _ (evenCartan v))
        (trans!{{Even x}} _ _ _
          (sym!{{Even x}} _ _ (((Boundary.bundle P.value).space x).scalarAssoc (reciprocal x) (coefficient x) v))
          (trans!{{Even x}} _ _ _
            (congr!{{C.Complex} {Even x}} (\fun (a: C.Complex) => ((Boundary.bundle P.value).space x).smul a v) _ _ (ScalarLaws.inverseNonzero (coefficient x) (coefficientNonzero x)))
            (((Boundary.bundle P.value).space x).scalarOne v)))));
\definition odd: \forall (v: Odd x) -> ((Boundary.bundle Q.value).space x).add ((d.fiber x).apply ((normalizedH.fiber x).apply v)) ((normalizedK.fiber x).apply ((e.fiber x).apply v)) = v :=
  \fun (v: Odd x) => trans!{{Odd x}} _ _ _
    (congr!{{Odd x} {Odd x}} (\fun (w: Odd x) => ((Boundary.bundle Q.value).space x).add w ((normalizedK.fiber x).apply ((e.fiber x).apply v))) _ _
      ((d.fiber x).preservesScale (reciprocal x) ((c.h.fiber x).apply v)))
    (trans!{{Odd x}} _ _ _
      (sym!{{Odd x}} _ _ (((Boundary.bundle Q.value).space x).vectorAdd (reciprocal x) ((d.fiber x).apply ((c.h.fiber x).apply v)) ((c.k.fiber x).apply ((e.fiber x).apply v))))
      (trans!{{Odd x}} _ _ _
        (congr!{{Odd x} {Odd x}} (((Boundary.bundle Q.value).space x).smul (reciprocal x)) _ _ (oddCartan v))
        (trans!{{Odd x}} _ _ _
          (sym!{{Odd x}} _ _ (((Boundary.bundle Q.value).space x).scalarAssoc (reciprocal x) (coefficient x) v))
          (trans!{{Odd x}} _ _ _
            (congr!{{C.Complex} {Odd x}} (\fun (a: C.Complex) => ((Boundary.bundle Q.value).space x).smul a v) _ _ (ScalarLaws.inverseNonzero (coefficient x) (coefficientNonzero x)))
            (((Boundary.bundle Q.value).space x).scalarOne v)))));
\definition contractLaws: Contract.Laws[data] := Contract.Laws[data] {
  squareEven := Chain.squareZero.left x, squareOdd := Chain.squareZero.right x, even := even, odd := odd
};
\definition hk: \forall (v: Even x) -> ((normalizedH.fiber x).apply ((normalizedK.fiber x).apply v)) = ((Boundary.bundle P.value).space x).zero :=
  \fun (v: Even x) => trans!{{Even x}} _ _ _
    (congr!{{Even x} {Even x}} (((Boundary.bundle P.value).space x).smul (reciprocal x)) _ _ ((c.h.fiber x).preservesScale (reciprocal x) ((c.k.fiber x).apply v)))
    (trans!{{Even x}} _ _ _
      (congr!{{Even x} {Even x}} (\fun (w: Even x) => ((Boundary.bundle P.value).space x).smul (reciprocal x) (((Boundary.bundle P.value).space x).smul (reciprocal x) w)) _ _ (laws.hk x v))
      (trans!{{Even x}} _ _ _
        (congr!{{Even x} {Even x}} (((Boundary.bundle P.value).space x).smul (reciprocal x)) _ _ (EvenLaws.scaleZero (reciprocal x)))
        (EvenLaws.scaleZero (reciprocal x))));
\definition kh: \forall (v: Odd x) -> ((normalizedK.fiber x).apply ((normalizedH.fiber x).apply v)) = ((Boundary.bundle Q.value).space x).zero :=
  \fun (v: Odd x) => trans!{{Odd x}} _ _ _
    (congr!{{Odd x} {Odd x}} (((Boundary.bundle Q.value).space x).smul (reciprocal x)) _ _ ((c.k.fiber x).preservesScale (reciprocal x) ((c.h.fiber x).apply v)))
    (trans!{{Odd x}} _ _ _
      (congr!{{Odd x} {Odd x}} (\fun (w: Odd x) => ((Boundary.bundle Q.value).space x).smul (reciprocal x) (((Boundary.bundle Q.value).space x).smul (reciprocal x) w)) _ _ (laws.kh x v))
      (trans!{{Odd x}} _ _ _
        (congr!{{Odd x} {Odd x}} (((Boundary.bundle Q.value).space x).smul (reciprocal x)) _ _ (OddLaws.scaleZero (reciprocal x)))
        (OddLaws.scaleZero (reciprocal x))));
\definition pair: Contract.Pair := \into[Contract.Data](data, Contract.Pair) \by { contractLaws };
\import \root.Thom[].ComplexProductRescale[V := Even x, W := Odd x, even := (Boundary.bundle P.value).space x, odd := (Boundary.bundle Q.value).space x, c := pair].Strong[hk := hk, kh := kh] \as Strong;
\definition restoreH: \forall (v: Odd x) -> ((Boundary.bundle P.value).space x).smul (coefficient x) (((Boundary.bundle P.value).space x).smul (reciprocal x) ((c.h.fiber x).apply v)) = (c.h.fiber x).apply v :=
  \fun (v: Odd x) => trans!{{Even x}} _ _ _
    (sym!{{Even x}} _ _ (((Boundary.bundle P.value).space x).scalarAssoc (coefficient x) (reciprocal x) ((c.h.fiber x).apply v)))
    (trans!{{Even x}} _ _ _
      (congr!{{C.Complex} {Even x}} (\fun (a: C.Complex) => ((Boundary.bundle P.value).space x).smul a ((c.h.fiber x).apply v)) _ _ (ScalarLaws.inverseNonzeroRight (coefficient x) (coefficientNonzero x)))
      (((Boundary.bundle P.value).space x).scalarOne ((c.h.fiber x).apply v)));
\definition restoreK: \forall (v: Even x) -> ((Boundary.bundle Q.value).space x).smul (coefficient x) (((Boundary.bundle Q.value).space x).smul (reciprocal x) ((c.k.fiber x).apply v)) = (c.k.fiber x).apply v :=
  \fun (v: Even x) => trans!{{Odd x}} _ _ _
    (sym!{{Odd x}} _ _ (((Boundary.bundle Q.value).space x).scalarAssoc (coefficient x) (reciprocal x) ((c.k.fiber x).apply v)))
    (trans!{{Odd x}} _ _ _
      (congr!{{C.Complex} {Odd x}} (\fun (a: C.Complex) => ((Boundary.bundle Q.value).space x).smul a ((c.k.fiber x).apply v)) _ _ (ScalarLaws.inverseNonzeroRight (coefficient x) (coefficientNonzero x)))
      (((Boundary.bundle Q.value).space x).scalarOne ((c.k.fiber x).apply v)));

\import Contract.With[c := pair] \as Normalized;
\definition hFixed: \forall (v: Odd x) -> Normalized.h.apply v = (normalizedH.fiber x).apply v := Strong.hFixed;
\definition kFixed: \forall (v: Even x) -> Normalized.k.apply v = (normalizedK.fiber x).apply v := Strong.kFixed;

\definition evenPreimage: \forall (v: Even x) -> (d.fiber x).apply v = ((Boundary.bundle Q.value).space x).zero -> \exists (w: Odd x \where (e.fiber x).apply w = v) :=
  \fun (v: Even x)(closed: _) => Logic.existsIntro[Odd x, { w: Odd x \where (e.fiber x).apply w = v }] ((normalizedK.fiber x).apply v)
    (trans!{{Even x}} _ _ _ (sym!{{Even x}} _ _ (EvenLaws.zeroRight ((e.fiber x).apply ((normalizedK.fiber x).apply v))))
      (trans!{{Even x}} _ _ _
        (congr!{{Even x} {Even x}} (((Boundary.bundle P.value).space x).add ((e.fiber x).apply ((normalizedK.fiber x).apply v))) _ _
          (sym!{{Even x}} _ _ (trans!{{Even x}} _ _ _ (congr!{{Odd x} {Even x}} (normalizedH.fiber x).apply _ _ closed) (normalizedH.fiber x).preservesZero)))
        (contractLaws.even v)));
\definition oddPreimage: \forall (v: Odd x) -> (e.fiber x).apply v = ((Boundary.bundle P.value).space x).zero -> \exists (w: Even x \where (d.fiber x).apply w = v) :=
  \fun (v: Odd x)(closed: _) => Logic.existsIntro[Even x, { w: Even x \where (d.fiber x).apply w = v }] ((normalizedH.fiber x).apply v)
    (trans!{{Odd x}} _ _ _ (sym!{{Odd x}} _ _ (OddLaws.zeroRight ((d.fiber x).apply ((normalizedH.fiber x).apply v))))
      (trans!{{Odd x}} _ _ _
        (congr!{{Odd x} {Odd x}} (((Boundary.bundle Q.value).space x).add ((d.fiber x).apply ((normalizedH.fiber x).apply v))) _ _
          (sym!{{Odd x}} _ _ (trans!{{Odd x}} _ _ _ (congr!{{Even x} {Odd x}} (normalizedK.fiber x).apply _ _ closed) (normalizedK.fiber x).preservesZero)))
        (contractLaws.odd v)));
\definition laws: Contract.Laws[data] := contractLaws;
