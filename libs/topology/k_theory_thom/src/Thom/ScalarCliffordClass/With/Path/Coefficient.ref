\import std.Logic[].Classical[] \as Classical;
\definition leftNonnegative: Order.Le Real.zero (Real.sub Real.one t) := Real.Distance[].subNonnegative Real.one t (I.bounds t).right;
\definition positive[positiveQ: Order.Lt Real.zero q]: Order.Lt Real.zero (affine t q) :=
  Logic.orElim[t = Real.zero, Logic.Not (t = Real.zero), Order.Lt Real.zero (affine t q)] (Classical.excludedMiddle (t = Real.zero))
    (\fun (zero: t = Real.zero) => Order.ltReplaceRight Real.zero Real.one (affine t q)
      (sym!{Real.Real} _ _ (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (\fun (s: Real.Real) => affine s q) _ _ zero) (affineZero q))) Bounds.onePositive)
    (\fun (nonzero: Logic.Not (t = Real.zero)) => Order.leLtTrans Real.zero (Real.sub Real.one t) (affine t q) leftNonnegative
      (Order.ltReplaceLeft (Real.add (Real.sub Real.one t) Real.zero) (Real.sub Real.one t) (affine t q) (RealLaws.addZeroRight (Real.sub Real.one t))
        (RealLaws.ltAddLeft (Real.sub Real.one t) Real.zero (Real.mul t q)
          (Bounds.mulPositive t q
            (Order.Order[].ltOfLeNotEq Real.zero t (I.bounds t).left (\fun (zero: Real.zero = t) => nonzero (sym!{Real.Real} _ _ zero))) positiveQ))));
