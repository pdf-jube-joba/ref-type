\definition evenLeft[v: Even x]: ((Boundary.bundle P.value).space x).add ((e.fiber x).apply ((d.fiber x).apply v)) ((e.fiber x).apply ((c.k.fiber x).apply v)) = (e.fiber x).apply ((c.k.fiber x).apply v) :=
  trans!{{Even x}} _ _ _ (congr!{{Even x} {Even x}} (\fun (w: Even x) => ((Boundary.bundle P.value).space x).add w ((e.fiber x).apply ((c.k.fiber x).apply v))) _ _ (Chain.squareZero.left x v)) (EvenLaws.zeroLeft _);
\definition evenRight[v: Even x]: ((Boundary.bundle P.value).space x).add ((c.h.fiber x).apply ((d.fiber x).apply v)) ((c.h.fiber x).apply ((c.k.fiber x).apply v)) = (c.h.fiber x).apply ((d.fiber x).apply v) :=
  trans!{{Even x}} _ _ _ (congr!{{Even x} {Even x}} (((Boundary.bundle P.value).space x).add ((c.h.fiber x).apply ((d.fiber x).apply v))) _ _ (laws.hk x v)) (EvenLaws.zeroRight _);
\definition even: \forall (v: Even x) -> ((backward c).fiber x).apply (((forward c).fiber x).apply v) =
  ((Boundary.bundle P.value).space x).add ((e.fiber x).apply ((c.k.fiber x).apply v)) ((c.h.fiber x).apply ((d.fiber x).apply v)) :=
  \fun (v: Even x) => trans!{{Even x}} _ _ _
    (congr!{{Even x} {Even x} {Even x}} ((Boundary.bundle P.value).space x).add _ _ _ _
      ((e.fiber x).preservesAdd ((d.fiber x).apply v) ((c.k.fiber x).apply v))
      ((c.h.fiber x).preservesAdd ((d.fiber x).apply v) ((c.k.fiber x).apply v)))
    (congr!{{Even x} {Even x} {Even x}} ((Boundary.bundle P.value).space x).add _ _ _ _ (evenLeft v) (evenRight v));
\definition oddLeft[v: Odd x]: ((Boundary.bundle Q.value).space x).add ((d.fiber x).apply ((e.fiber x).apply v)) ((d.fiber x).apply ((c.h.fiber x).apply v)) = (d.fiber x).apply ((c.h.fiber x).apply v) :=
  trans!{{Odd x}} _ _ _ (congr!{{Odd x} {Odd x}} (\fun (w: Odd x) => ((Boundary.bundle Q.value).space x).add w ((d.fiber x).apply ((c.h.fiber x).apply v))) _ _ (Chain.squareZero.right x v)) (OddLaws.zeroLeft _);
\definition oddRight[v: Odd x]: ((Boundary.bundle Q.value).space x).add ((c.k.fiber x).apply ((e.fiber x).apply v)) ((c.k.fiber x).apply ((c.h.fiber x).apply v)) = (c.k.fiber x).apply ((e.fiber x).apply v) :=
  trans!{{Odd x}} _ _ _ (congr!{{Odd x} {Odd x}} (((Boundary.bundle Q.value).space x).add ((c.k.fiber x).apply ((e.fiber x).apply v))) _ _ (laws.kh x v)) (OddLaws.zeroRight _);
\definition odd: \forall (v: Odd x) -> ((forward c).fiber x).apply (((backward c).fiber x).apply v) =
  ((Boundary.bundle Q.value).space x).add ((d.fiber x).apply ((c.h.fiber x).apply v)) ((c.k.fiber x).apply ((e.fiber x).apply v)) :=
  \fun (v: Odd x) => trans!{{Odd x}} _ _ _
    (congr!{{Odd x} {Odd x} {Odd x}} ((Boundary.bundle Q.value).space x).add _ _ _ _
      ((d.fiber x).preservesAdd ((e.fiber x).apply v) ((c.h.fiber x).apply v))
      ((c.k.fiber x).preservesAdd ((e.fiber x).apply v) ((c.h.fiber x).apply v)))
    (congr!{{Odd x} {Odd x} {Odd x}} ((Boundary.bundle Q.value).space x).add _ _ _ _ (oddLeft v) (oddRight v));
