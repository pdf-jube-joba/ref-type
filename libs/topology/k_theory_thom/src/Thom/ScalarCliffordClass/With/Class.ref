\import \parent.Path[] \as Path;
\import algebraic_topology.Cylinder[A := Pair.A] \as Cylinder;
\import \root.Thom[].ComplexProductCliffordClass[X := X, space := space, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed, complex := complex].With[c := contraction]
  .Using[scale := Path.scale, reciprocal := Path.rho, scaleContinuous := Path.scaleContinuous, reciprocalContinuous := Path.rhoContinuous,
    inverseLaw := Path.reciprocal, atStart := Path.start] \as Homotopy;
\import Pair.BundleTriples[F := Source.Even, G := Source.Odd, firstModel := Source.firstModel, secondModel := Source.secondModel] \as Triples;
\definition comparison: Triples.OnSubset := Homotopy.comparison;
\definition value: Pair.Quotient[].Relative := Homotopy.value;
\definition equation[exact: Source.Exact]: Source.Supported[exact := exact].value = value := Homotopy.equation exact;
\definition forwardFormula: \forall (x: Pair.A)(v: Even x) -> (comparison.forward.fiber x).apply v = ((forward c).fiber x).apply v :=
  \fun (x: Pair.A)(v: Even x) => congr!{{Odd x} {Odd x}} (((Boundary.bundle Q.value).space x).add ((d.fiber x).apply v)) _ _
    (trans!{{Odd x}} _ _ _
      (congr!{{Odd x} {Odd x}} (((Boundary.bundle Q.value).space x).smul (Path.scale (Cylinder.at algebraic_topology.Interval[].end x))) _ _ (kFixed x v))
      (trans!{{Odd x}} _ _ _
        (congr!{{C.Complex} {Odd x}} (\fun (a: C.Complex) => ((Boundary.bundle Q.value).space x).smul a ((normalizedK.fiber x).apply v)) _ _ (Path.end x))
        (restoreK x v)));
