\import Original.With[c := data, laws := targetLaws].Class[] \as Normalized;
\import Pair.BundleTriples[F := Source.Even, G := Source.Odd, firstModel := Source.firstModel, secondModel := Source.secondModel] \as Triples;
\definition comparison: Triples.OnSubset := Normalized.comparison;
\definition value: Pair.Quotient[].Relative := Normalized.value;
\definition equation[exact: Source.Exact]: Source.Supported[exact := exact].value = value := Normalized.equation exact;
\definition forwardFormula[x: Pair.A][v: U x]:
  (comparison.forward.fiber x).apply ((positive.forward.fiber x).apply v) = (negative.forward.fiber x).apply (((sourceForward c).fiber x).apply v) :=
  trans!{{Odd x}} _ _ _ (Normalized.forwardFormula x ((positive.forward.fiber x).apply v))
    (\parent.At[x := x].forwardCommutes v);
