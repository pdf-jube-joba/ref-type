\definition A: Spaces.Linear[V := U x, W := Even x, source := first.space x, target := evenBundle.space x].Map := positive.forward.fiber x;
\definition AI: Spaces.Linear[V := Even x, W := U x, source := evenBundle.space x, target := first.space x].Map := positive.backward.fiber x;
\definition Bmap: Spaces.Linear[V := T x, W := Odd x, source := second.space x, target := oddBundle.space x].Map := negative.forward.fiber x;
\definition BI: Spaces.Linear[V := Odd x, W := T x, source := oddBundle.space x, target := second.space x].Map := negative.backward.fiber x;
\definition dFormula[v: Even x]: (d.fiber x).apply v = Bmap.apply ((c.d.fiber x).apply (AI.apply v)) :=
  trans!{{Odd x}} _ _ _
    (congr!{{Even x} {Odd x}} (d.fiber x).apply _ _ (sym!{{Even x}} _ _ (positive.rightInverse x v)))
    (laws.forwardCommutes x (AI.apply v));
\definition eFormula[v: Odd x]: (e.fiber x).apply v = A.apply ((c.e.fiber x).apply (BI.apply v)) :=
  trans!{{Even x}} _ _ _
    (congr!{{Odd x} {Even x}} (e.fiber x).apply _ _ (sym!{{Odd x}} _ _ (negative.rightInverse x v)))
    (laws.backwardCommutes x (BI.apply v));
\definition forwardFormula[v: Even x]: ((Original.forward data).fiber x).apply v = Bmap.apply (((sourceForward c).fiber x).apply (AI.apply v)) :=
  trans!{{Odd x}} _ _ _
    (congr!{{Odd x} {Odd x}} (\fun (w: Odd x) => (oddBundle.space x).add w ((transportedK.fiber x).apply v)) _ _ (dFormula v))
    (sym!{{Odd x}} _ _ (Bmap.preservesAdd ((c.d.fiber x).apply (AI.apply v)) ((c.k.fiber x).apply (AI.apply v))));
\definition backwardFormula[v: Odd x]: ((Original.backward data).fiber x).apply v = A.apply (((sourceBackward c).fiber x).apply (BI.apply v)) :=
  trans!{{Even x}} _ _ _
    (congr!{{Even x} {Even x}} (\fun (w: Even x) => (evenBundle.space x).add w ((transportedH.fiber x).apply v)) _ _ (eFormula v))
    (sym!{{Even x}} _ _ (A.preservesAdd ((c.e.fiber x).apply (BI.apply v)) ((c.h.fiber x).apply (BI.apply v))));
\definition hk[v: Even x]: (transportedH.fiber x).apply ((transportedK.fiber x).apply v) = (evenBundle.space x).zero :=
  trans!{{Even x}} _ _ _
    (congr!{{T x} {Even x}} (\fun (w: T x) => A.apply ((c.h.fiber x).apply w)) _ _ (negative.leftInverse x ((c.k.fiber x).apply (AI.apply v))))
    (trans!{{Even x}} _ _ _ (congr!{{U x} {Even x}} A.apply _ _ (laws.hk x (AI.apply v))) A.preservesZero);
\definition kh[v: Odd x]: (transportedK.fiber x).apply ((transportedH.fiber x).apply v) = (oddBundle.space x).zero :=
  trans!{{Odd x}} _ _ _
    (congr!{{U x} {Odd x}} (\fun (w: U x) => Bmap.apply ((c.k.fiber x).apply w)) _ _ (positive.leftInverse x ((c.h.fiber x).apply (BI.apply v))))
    (trans!{{Odd x}} _ _ _ (congr!{{T x} {Odd x}} Bmap.apply _ _ (laws.kh x (BI.apply v))) Bmap.preservesZero);
\definition evenSquare[v: Even x]: ((Original.backward data).fiber x).apply (((Original.forward data).fiber x).apply v) =
  (evenBundle.space x).smul (Scalar.ofReal (c.q x)) v :=
  trans!{{Even x}} _ _ _ (backwardFormula (((Original.forward data).fiber x).apply v))
    (trans!{{Even x}} _ _ _
      (congr!{{Odd x} {Even x}} (\fun (w: Odd x) => A.apply (((sourceBackward c).fiber x).apply (BI.apply w))) _ _ (forwardFormula v))
      (trans!{{Even x}} _ _ _
        (congr!{{T x} {Even x}} (\fun (w: T x) => A.apply (((sourceBackward c).fiber x).apply w)) _ _ (negative.leftInverse x (((sourceForward c).fiber x).apply (AI.apply v))))
        (trans!{{Even x}} _ _ _ (congr!{{U x} {Even x}} A.apply _ _ (laws.evenSquare x (AI.apply v)))
          (trans!{{Even x}} _ _ _ (A.preservesScale (Scalar.ofReal (c.q x)) (AI.apply v))
            (congr!{{Even x} {Even x}} ((evenBundle.space x).smul (Scalar.ofReal (c.q x))) _ _ (positive.rightInverse x v))))));
\definition oddSquare[v: Odd x]: ((Original.forward data).fiber x).apply (((Original.backward data).fiber x).apply v) =
  (oddBundle.space x).smul (Scalar.ofReal (c.q x)) v :=
  trans!{{Odd x}} _ _ _ (forwardFormula (((Original.backward data).fiber x).apply v))
    (trans!{{Odd x}} _ _ _
      (congr!{{Even x} {Odd x}} (\fun (w: Even x) => Bmap.apply (((sourceForward c).fiber x).apply (AI.apply w))) _ _ (backwardFormula v))
      (trans!{{Odd x}} _ _ _
        (congr!{{U x} {Odd x}} (\fun (w: U x) => Bmap.apply (((sourceForward c).fiber x).apply w)) _ _ (positive.leftInverse x (((sourceBackward c).fiber x).apply (BI.apply v))))
        (trans!{{Odd x}} _ _ _ (congr!{{T x} {Odd x}} Bmap.apply _ _ (laws.oddSquare x (BI.apply v)))
          (trans!{{Odd x}} _ _ _ (Bmap.preservesScale (Scalar.ofReal (c.q x)) (BI.apply v))
            (congr!{{Odd x} {Odd x}} ((oddBundle.space x).smul (Scalar.ofReal (c.q x))) _ _ (negative.rightInverse x v))))));

\definition forwardCommutes[v: U x]: ((Original.forward data).fiber x).apply (A.apply v) = Bmap.apply (((sourceForward c).fiber x).apply v) :=
  trans!{{Odd x}} _ _ _ (forwardFormula (A.apply v))
    (congr!{{U x} {Odd x}} (\fun (u: U x) => Bmap.apply (((sourceForward c).fiber x).apply u)) _ _ (positive.leftInverse x v));
\definition backwardCommutes[v: T x]: ((Original.backward data).fiber x).apply (Bmap.apply v) = A.apply (((sourceBackward c).fiber x).apply v) :=
  trans!{{Even x}} _ _ _ (backwardFormula (Bmap.apply v))
    (congr!{{T x} {Even x}} (\fun (u: T x) => A.apply (((sourceBackward c).fiber x).apply u)) _ _ (negative.leftInverse x v));
