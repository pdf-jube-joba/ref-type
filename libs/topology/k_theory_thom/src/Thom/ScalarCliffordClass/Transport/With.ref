\import Bundles.Morphisms[X := Pair.A, Y := Pair.A, F := Odd, G := T, source := oddBundle, target := second, f := (\fun (x: Pair.A) => x)]
  .Composition[Z := Pair.A, H := U, range := first, g := (\fun (x: Pair.A) => x)] \as HFirst;
\import Bundles.Morphisms[X := Pair.A, Y := Pair.A, F := Odd, G := U, source := oddBundle, target := first, f := (\fun (x: Pair.A) => x)]
  .Composition[Z := Pair.A, H := Even, range := evenBundle, g := (\fun (x: Pair.A) => x)] \as HSecond;
\definition transportedH: Boundary.Map oddModel evenModel := HSecond.compose (HFirst.compose negative.backward c.h) positive.forward;
\import Bundles.Morphisms[X := Pair.A, Y := Pair.A, F := Even, G := U, source := evenBundle, target := first, f := (\fun (x: Pair.A) => x)]
  .Composition[Z := Pair.A, H := T, range := second, g := (\fun (x: Pair.A) => x)] \as KFirst;
\import Bundles.Morphisms[X := Pair.A, Y := Pair.A, F := Even, G := T, source := evenBundle, target := second, f := (\fun (x: Pair.A) => x)]
  .Composition[Z := Pair.A, H := Odd, range := oddBundle, g := (\fun (x: Pair.A) => x)] \as KSecond;
\definition transportedK: Boundary.Map evenModel oddModel := KSecond.compose (KFirst.compose positive.backward c.k) negative.forward;
\definition data: Original.Data := Original.Data {
  h := transportedH, k := transportedK, q := c.q, continuous := c.continuous, positive := c.positive
};
\module At(x: Pair.A);
\definition targetLaws: Original.Laws[data] := Original.Laws[data] {
  hk := \fun (x: Pair.A) => At[x := x].hk,
  kh := \fun (x: Pair.A) => At[x := x].kh,
  evenSquare := \fun (x: Pair.A) => At[x := x].evenSquare,
  oddSquare := \fun (x: Pair.A) => At[x := x].oddSquare
};

\module Class;
