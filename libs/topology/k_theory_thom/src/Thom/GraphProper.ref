\import std.Data[].Pair[] \as Pair;
\import topological_constructions.Product[A := B, B := A] \as Product;
\definition productTopology: topology.Topology[Carrier := Product.CarrierSet].Topology := Product.topology target source;
\definition graph[x: A]: Product.CarrierSet := Pair.pair B A (f x) x;
\definition continuous: topology.Continuity[A := A, B := Product.CarrierSet].Continuous source productTopology graph :=
  Product.Universal[X := A].pairContinuous source target source f (\fun (x: A) => x) regular (topology.Maps[A := A, B := A].Identity[].continuous source);
\module CompactPreimage(K: \Pow Product.CarrierSet, compactK: topology.Topology[Carrier := Product.CarrierSet].IsCompactIn productTopology K);
\definition proper: compact_support_k.Support[].Proper[A := A, B := Product.CarrierSet, source := source, target := productTopology].IsProper graph :=
  \fun (K: \Pow Product.CarrierSet)(compactK: _) => CompactPreimage[K := K, compactK := compactK].compact;
