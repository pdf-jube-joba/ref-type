\import topology.Topology[Carrier := X] \as Base;
\definition e1Aux: e1.baseSpace = auxiliary.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameE1) sameAuxiliary;
\definition auxF0: auxiliary.baseSpace = f0.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameAuxiliary) sameF0;
\definition auxF1: auxiliary.baseSpace = f1.baseSpace := trans!{{Base.Topology}} _ _ _ (sym!{{Base.Topology}} _ _ sameAuxiliary) sameF1;
\import Operations.DirectSum[X := X, F := E0, G := H, left := e0, right := auxiliary] \as StableEven;
\import Operations.DirectSum[X := X, F := E1, G := H, left := e1, right := auxiliary] \as StableOdd;
\definition stableEven: Bundles.Family[X := X, F := StableEven.Fiber].Bundle := StableEven.bundle sameAuxiliary;
\definition stableOdd: Bundles.Family[X := X, F := StableOdd.Fiber].Bundle := StableOdd.bundle e1Aux;
\import \root.Thom[].ComplexProductParity[X := X, F0 := StableEven.Fiber, F1 := StableOdd.Fiber, G0 := F0, G1 := F1,
  e0 := stableEven, e1 := stableOdd, f0 := f0, f1 := f1, sameE1 := sameE1, sameF0 := sameF0, sameF1 := sameF1] \as Source;
\import \root.Thom[].ComplexProductParity[X := X, F0 := E0, F1 := E1, G0 := F0, G1 := F1,
  e0 := e0, e1 := e1, f0 := f0, f1 := f1, sameE1 := sameE1, sameF0 := sameF0, sameF1 := sameF1] \as Original;
\import \root.Thom[].ComplexProductParity[X := X, F0 := H, F1 := H, G0 := F0, G1 := F1,
  e0 := auxiliary, e1 := auxiliary, f0 := f0, f1 := f1, sameE1 := (\refl(auxiliary.baseSpace)), sameF0 := auxF0, sameF1 := auxF1] \as Auxiliary;
\import \root.Thom[].TensorParityRegroup[X := X, E0 := E0, E1 := E1, H0 := H, H1 := H, F0 := F0, F1 := F1,
  e0 := e0, e1 := e1, h0 := auxiliary, h1 := auxiliary, f0 := f0, f1 := f1,
  sameE1 := sameE1, sameH0 := sameAuxiliary, sameH1 := sameAuxiliary, sameF0 := sameF0, sameF1 := sameF1] \as Sectors;
\import Bundles.Morphisms[X := X, Y := X, F := E0, G := E1, source := e0, target := e1, f := (\fun (x: X) => x)] \as Forward;
\import Bundles.Morphisms[X := X, Y := X, F := E1, G := E0, source := e1, target := e0, f := (\fun (x: X) => x)] \as Backward;
\import Bundles.Morphisms[X := X, Y := X, F := Source.RightFiber, G := Source.RightFiber,
  source := Source.rightBundle, target := Source.rightBundle, f := (\fun (x: X) => x)] \as Partner;
\module With(d: Forward.Map, e: Backward.Map, radius: X -> C.Complex,
  continuous: topology.Continuity[A := X, B := C.Complex].Continuous e0.baseSpace Scalars.scalar.topological.space radius,
  partner: Partner.Map);
