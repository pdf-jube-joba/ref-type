
\definition result: \forall (i: N.Nat^) -> Naturals.Le i (N.Nat^::succ n) -> degree (N.Nat^::succ n) (rawLookup (N.Nat^::succ n) i) = i :=
  \fun (i: N.Nat^)(bound: Naturals.Le i (N.Nat^::succ n)) =>
    B.cases (\fun (test: B.Bool^) => Nat.eqb i (N.Nat^::succ n) = test -> degree (N.Nat^::succ n) (branch n (rawLookup n) i test) = i)
      (\fun (negative: Nat.eqb i (N.Nat^::succ n) = B.Bool^::false) => \block {
        \let different: Logic.Not (i = N.Nat^::succ n) := \fun (equal: i = N.Nat^::succ n) => Booleans.trueNeFalse
          (trans!{{B.Bool^}} _ _ _ (sym!{{B.Bool^}} _ _ (Naturals.eqbTrueOfEq i (N.Nat^::succ n) equal)) negative) \then
        \let smaller: Naturals.Le i n := Naturals.leOfSuccSucc i n
          (Naturals.succLeOfLt (N.Nat^::succ n) i (Naturals.ltOfLeDifferent i (N.Nat^::succ n) bound different)) \then
        \return previous i smaller
      })
      (\fun (positive: Nat.eqb i (N.Nat^::succ n) = B.Bool^::true) => sym!{{N.Nat^}} _ _ (Naturals.eqOfEqbTrue (N.Nat^::succ n) i positive))
      (Nat.eqb i (N.Nat^::succ n)) (\refl(Nat.eqb i (N.Nat^::succ n)));
