\import topology.Topology[Carrier := Total] \as Base;
\definition reconstructed[p: Total]: Total := Family.include p.base p.vector;
\definition reconstructedContinuous: topology.Continuity[A := Total, B := Total].Continuous bundle.totalSpace bundle.totalSpace reconstructed :=
  \idelim (\fun (p: Total) => p) = reconstructed \with f: (Total -> Total) => topology.Continuity[A := Total, B := Total].Continuous bundle.totalSpace bundle.totalSpace f \by {
    base: topology.Maps[A := Total, B := Total].Identity[].continuous bundle.totalSpace,
    equality: \axiom:funext((\fun (p: Total) => p), reconstructed, \fun (p: Total) => sym!{Total} _ _ (Family.eta p))
  };
\import bundle_operations.Operations[].Evaluations[K := C.Complex, X := Total, E := FormFamily.Point, I := Alternating.TupleSection,
  scalarSpace := Scalars.scalar.topological.space, baseSpace := bundle.totalSpace,
  projection := FormFamily.projection, domains := Alternating.domains, open := (\fun (s: Alternating.TupleSection) => s.open), evaluate := Alternating.evaluate] \as Evaluations;
\module Test(s: Alternating.TupleSection);
\definition continuous: topology.Continuity[A := Total, B := FormFamily.Point].Continuous bundle.totalSpace Alternating.topology sectionTotal :=
  Evaluations.Universal[A := Total].continuous bundle.totalSpace sectionTotal
    (topology.Maps[A := Total, B := Total].Identity[].continuous bundle.totalSpace)
    (\fun (s: Alternating.TupleSection) => Test[s := s].continuous);
