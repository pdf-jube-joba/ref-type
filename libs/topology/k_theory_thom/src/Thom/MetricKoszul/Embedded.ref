\import C.Def[] \as Op;
\import C.Prop[] \as ComplexLaws;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as D;
\import metric_spaces.RealLine[] \as Line;
\import std.Data[].Pair[] \as Pair;
\import Complement.FromEmbedding[embedding := embedding] \as Construction;
\definition metric: Metric := Construction.metric;
\definition n: N.Nat^ := embedding.dimension;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := linear_algebra.Hermitian[].Complex[].scalar].Finite[n := n] \as Euclidean;
\import thom_spaces.Thom[].Over[K := C.Complex, field := C.Algebra[].field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := Scalars.scalar].For[X := X, F := F, bundle := bundle].With[metric := metric] \as Geometry;
\module Cube;
\module Bounds(p: Family.Point);
\module Disk;
\definition diskCompact: topology.Topology[Carrier := Family.Point].IsCompactIn bundle.totalSpace Geometry.ClosedBall := Disk[].result;
