\definition point: WholeLocal.Carrier := \into[Carrier](p, compactSet) \by { enclosed p inside };
\definition first: FirstLocal.Region := \into[X](Pair.first X Y p, U) \by { inside.left };
\definition second: SecondLocal.Region := \into[Y](Pair.second X Y p, V) \by { inside.right };
\definition value: LocalSmash.result.Carrier := LocalSmash.projection (Pair.pair FirstQ.Carrier SecondQ.Carrier
  (FirstQ.projection (\into[X](Pair.first X Y p, L) \by { enclosedU (Pair.first X Y p) inside.left }))
  (SecondQ.projection (\into[Y](Pair.second X Y p, M) \by { enclosedV (Pair.second X Y p) inside.right })));
\definition left: Left.map (Points.inclusion p) = value := trans!{{LocalSmash.result.Carrier}} _ _ _
  (congr!{{WholeQ.Carrier} {LocalSmash.result.Carrier}} Local.map _ _
    (WholeLocal.onRegion (\into[Carrier](p, openSet) \by { inside })))
  (Local.onProjection point);
\definition right: Right.map (Points.inclusion p) = value := trans!{{LocalSmash.result.Carrier}} _ _ _
  (congr!{{GlobalSmash.result.Carrier} {LocalSmash.result.Carrier}} Localize.map _ _ (globalOnFinite p))
  (trans!{{LocalSmash.result.Carrier}} _ _ _
    (Localize.onProjection (Pair.pair FirstPoints.Carrier SecondPoints.Carrier
      (FirstPoints.inclusion (Pair.first X Y p)) (SecondPoints.inclusion (Pair.second X Y p))))
    (congr!{{LocalSmash.model.Carrier} {LocalSmash.result.Carrier}} LocalSmash.projection _ _
      (Pair.Prop[A := FirstQ.Carrier, B := SecondQ.Carrier].ext _ _
        (FirstLocal.onRegion first) (SecondLocal.onRegion second))));
\definition equation: Left.map (Points.inclusion p) = Right.map (Points.inclusion p) := trans!{{LocalSmash.result.Carrier}} _ _ _ left (sym!{{LocalSmash.result.Carrier}} _ _ right);
