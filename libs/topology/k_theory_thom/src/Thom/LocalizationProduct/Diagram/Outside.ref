\import \root.Thom[].SmashFibers[left := FirstQ.model, right := SecondQ.model] \as Fibers;
\definition point: LocalSmash.result.Carrier := (Relative.details LocalSmash.result).point;
\definition image: LocalSmash.model.Carrier := Pair.pair FirstQ.Carrier SecondQ.Carrier
  (FirstLocal.collapse (FirstPoints.inclusion (Pair.first X Y p)))
  (SecondLocal.collapse (SecondPoints.inclusion (Pair.second X Y p)));
\definition inWedge: \In[LocalSmash.model.Carrier] LocalSmash.wedge image :=
  either!{{(Classical.excludedMiddle (\In[X] U (Pair.first X Y p)))} {\In[LocalSmash.model.Carrier] LocalSmash.wedge image}
    {\fun (inside: _) => Logic.Or[_, _]::right (SecondLocal.offRegion (Pair.second X Y p)
      (\fun (insideSecond: _) => outside (Logic.And[_, _]::# inside insideSecond)))}
    {\fun (outsideFirst: _) => Logic.Or[_, _]::left (FirstLocal.offRegion (Pair.first X Y p) outsideFirst)}};
\definition left: Left.map (Points.inclusion p) = point := trans!{{LocalSmash.result.Carrier}} _ _ _
  (congr!{{WholeQ.Carrier} {LocalSmash.result.Carrier}} Local.map _ _ (WholeLocal.offRegion p outside))
  (algebraic_topology.Pointed[A := WholeQ.Carrier].Maps[B := LocalSmash.result.Carrier].laws
    (Relative.pointed WholeQ.model) (Relative.pointed LocalSmash.result) Local.map).pointed;
\definition right: Right.map (Points.inclusion p) = point := trans!{{LocalSmash.result.Carrier}} _ _ _
  (congr!{{GlobalSmash.result.Carrier} {LocalSmash.result.Carrier}} Localize.map _ _ (globalOnFinite p))
  (trans!{{LocalSmash.result.Carrier}} _ _ _
    (Localize.onProjection (Pair.pair FirstPoints.Carrier SecondPoints.Carrier
      (FirstPoints.inclusion (Pair.first X Y p)) (SecondPoints.inclusion (Pair.second X Y p))))
    (Fibers.collapse image inWedge));
\definition equation: Left.map (Points.inclusion p) = Right.map (Points.inclusion p) := trans!{{LocalSmash.result.Carrier}} _ _ _ left (sym!{{LocalSmash.result.Carrier}} _ _ right);
