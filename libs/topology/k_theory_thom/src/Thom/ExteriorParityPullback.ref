\import Operations.Models[X := Y, baseSpace := source] \as Models;
\module Factor(Z: \Set, H: Z -> \Set, original: Bundles.Family[X := Z, F := H].Bundle,
  selection: \forall (k: N.Nat^) -> \root.Thom[].Koszul[X := Z, F := H, bundle := original].Coordinates[].Choice k,
  map: Y -> \root.Thom[].Koszul[X := Z, F := H, bundle := original].Total,
  regular: topology.Continuity[A := Y, B := \root.Thom[].Koszul[X := Z, F := H, bundle := original].Total].Continuous source original.totalSpace map);
\import Factor[Z := A, H := F, original := left, selection := firstSelection, map := f, regular := firstRegular] \as First;
\import Factor[Z := B, H := G, original := right, selection := secondSelection, map := g, regular := secondRegular] \as Second;
\definition FirstFiber[y: Y]: \Set := First.Fiber y;
\definition SecondFiber[y: Y]: \Set := Second.Fiber y;
\definition leftBundle: Bundles.Family[X := Y, F := FirstFiber].Bundle := First.bundle;
\definition rightBundle: Bundles.Family[X := Y, F := SecondFiber].Bundle := Second.bundle;
\import \root.Thom[].ExteriorParity[X := Y, F := FirstFiber, G := SecondFiber, left := leftBundle, right := rightBundle, sameBase := (\refl(source))] \as Parity;
\definition firstSection: Bundles.Family[X := Y, F := FirstFiber].Of[bundle := leftBundle].Sections[].Section := First.section;
\definition secondSection: Bundles.Family[X := Y, F := SecondFiber].Of[bundle := rightBundle].Sections[].Section := Second.section;
\definition firstChoice[k: N.Nat^]: Parity.FirstChoice k := First.choice k;
\definition secondChoice[k: N.Nat^]: Parity.SecondChoice k := Second.choice k;
\definition TotalSelection: \Set := \forall (k: N.Nat^) -> Parity.NativeChoice k;
\definition totalExistence: \exists TotalSelection := \block {
  \takefrom data: Parity.Data \by Parity.existence \then
  \return \exact(data.total, TotalSelection)
};
\definition firstOriginalEven[n: N.Nat^]: Operations.Models[X := \root.Thom[].Koszul[X := A, F := F, bundle := left].Total, baseSpace := left.totalSpace].Bundle := First.sourceEven n;
\definition firstOriginalOdd[n: N.Nat^]: Operations.Models[X := \root.Thom[].Koszul[X := A, F := F, bundle := left].Total, baseSpace := left.totalSpace].Bundle := First.sourceOdd n;
\definition secondOriginalEven[n: N.Nat^]: Operations.Models[X := \root.Thom[].Koszul[X := B, F := G, bundle := right].Total, baseSpace := right.totalSpace].Bundle := Second.sourceEven n;
\definition secondOriginalOdd[n: N.Nat^]: Operations.Models[X := \root.Thom[].Koszul[X := B, F := G, bundle := right].Total, baseSpace := right.totalSpace].Bundle := Second.sourceOdd n;
\definition firstPulledEven[n: N.Nat^]: Models.Bundle := First.pulledEven n;
\definition firstPulledOdd[n: N.Nat^]: Models.Bundle := First.pulledOdd n;
\definition secondPulledEven[n: N.Nat^]: Models.Bundle := Second.pulledEven n;
\definition secondPulledOdd[n: N.Nat^]: Models.Bundle := Second.pulledOdd n;
\module With(totalSelection: TotalSelection);
