\import \parent.\parent.AsModule[A := A] \as AModule;
\import \parent.\parent.AsModule[A := B] \as BModule;
\import \parent.\parent.AsModule[A := C] \as CModule;
\import \parent.\parent.AsModule[A := D] \as DModule;
\import \parent.\parent.AsModule[A := E] \as EModule;
\import Modules.ExactFive[A := AModule.bundle, B := BModule.bundle, C := CModule.bundle, D := DModule.bundle, E := EModule.bundle] \as Native;
\definition sequence: Native.Sequence := Native.Sequence {
  first := \parent.\parent.Linear[A := A, B := B].convert s.first,
  second := \parent.\parent.Linear[A := B, B := C].convert s.second,
  third := \parent.\parent.Linear[A := C, B := D].convert s.third,
  last := \parent.\parent.Linear[A := D, B := E].convert s.fourth,
  zeroB := \fun (x: A.Carrier) => ((laws s).exactSecond (s.first x)).rtl (Logic.existsIntro[A.Carrier, { w: A.Carrier \where s.first w = s.first x }] x (\refl(s.first x))),
  zeroC := \fun (x: B.Carrier) => ((laws s).exactThird (s.second x)).rtl (Logic.existsIntro[B.Carrier, { w: B.Carrier \where s.second w = s.second x }] x (\refl(s.second x))),
  zeroD := \fun (x: C.Carrier) => ((laws s).exactFourth (s.third x)).rtl (Logic.existsIntro[C.Carrier, { w: C.Carrier \where s.third w = s.third x }] x (\refl(s.third x))),
  kernelB := \fun (x: B.Carrier)(zero: _) => ((laws s).exactSecond x).ltr zero,
  kernelC := \fun (x: C.Carrier)(zero: _) => ((laws s).exactThird x).ltr zero,
  kernelD := \fun (x: D.Carrier)(zero: _) => ((laws s).exactFourth x).ltr zero
};
