\import \parent.AsModule[A := A] \as Source;
\import \parent.AsModule[A := B] \as Target;
\import module_theory.Module[].IntegerGroup[Carrier := A.Carrier, group := A.group].Mapping[B := B.Carrier, other := B.group] \as Bridge;
\definition convert[f: Map A B]: Modules.Hom[V := A.Carrier, W := B.Carrier, source := Source.bundle.space, target := Target.bundle.space].Map := Bridge.fromGroup f;
