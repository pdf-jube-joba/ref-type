\import algebra.Exact[A := A.Carrier, B := B.Carrier].Groups[source := A.group, target := B.group] \as Groups;
\import algebra.Hom[A := A.Carrier, B := B.Carrier] \as Hom;
\definition make[f: A.Carrier -> B.Carrier]
  [additive: \forall (x, y: A.Carrier) -> f (A.group.base.op x y) = B.group.base.op (f x) (f y)]
  [zero: f A.group.base.unit = B.group.base.unit]: Map A B :=
  \into[A.Carrier -> B.Carrier](f, Groups.Map) \by {
    Hom.MonoidLaws[Groups.domain, Groups.codomain, f] { unit := zero, operation := additive }
  };
