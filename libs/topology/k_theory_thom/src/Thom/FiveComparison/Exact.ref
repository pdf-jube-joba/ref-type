\structure Data: \Set := { first: Map A B, second: Map B C, third: Map C D, fourth: Map D E };
\structure Laws[s: Data]: \Prop := {
  exactSecond: \forall (v: B.Carrier) -> Logic.PropEquiv[s.second v = C.group.base.unit, \exists (w: A.Carrier \where s.first w = v)],
  exactThird: \forall (v: C.Carrier) -> Logic.PropEquiv[s.third v = D.group.base.unit, \exists (w: B.Carrier \where s.second w = v)],
  exactFourth: \forall (v: D.Carrier) -> Logic.PropEquiv[s.fourth v = E.group.base.unit, \exists (w: C.Carrier \where s.third w = v)]
};
\definition Sequence: \Set := \Cast[Data] ({ s: Data \where Laws[s] });
\definition laws[s: Sequence]: Laws[s] := \bysub(Data, Sequence, s);
\module Linearized(s: Sequence);
