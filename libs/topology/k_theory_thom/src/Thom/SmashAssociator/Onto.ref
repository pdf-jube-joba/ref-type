\definition leftOnto: \forall (q: Left.result.Carrier) -> \exists (z: Triple \where left z = q) := \block {
  \fun (q: Left.result.Carrier) \then
  \takefrom p: \Cast[Left.model.Carrier] ({ p: Left.model.Carrier \where Left.projection p = q }) \by Left.projectionOnto q \then
  \takefrom r: \Cast[AB.model.Carrier] ({ r: AB.model.Carrier \where AB.projection r = Left.first p }) \by AB.projectionOnto (Left.first p) \then
  \let z: Triple := Pair.pair first.Carrier BC.model.Carrier (AB.first r) (Pair.pair second.Carrier third.Carrier (AB.second r) (Left.second p)) \then
  \return Logic.existsIntro[Triple, { z: Triple \where left z = q }] z
    (trans!{{Left.result.Carrier}} _ _ _
      (congr!{{Left.model.Carrier} {Left.result.Carrier}} Left.projection _ _ (Pair.Prop[A := AB.result.Carrier, B := third.Carrier].ext (leftRaw z) p
        (trans!{{AB.result.Carrier}} _ _ _
          (congr!{{AB.model.Carrier} {AB.result.Carrier}} AB.projection _ _ (Pair.Prop[A := first.Carrier, B := second.Carrier].eta r))
          (\bysub(AB.model.Carrier, { r: AB.model.Carrier \where AB.projection r = Left.first p }, r)))
        (\refl(Left.second p))))
      (\bysub(Left.model.Carrier, { p: Left.model.Carrier \where Left.projection p = q }, p)))
};
\definition rightOnto: \forall (q: Right.result.Carrier) -> \exists (z: Triple \where right z = q) := \block {
  \fun (q: Right.result.Carrier) \then
  \takefrom p: \Cast[Right.model.Carrier] ({ p: Right.model.Carrier \where Right.projection p = q }) \by Right.projectionOnto q \then
  \takefrom r: \Cast[BC.model.Carrier] ({ r: BC.model.Carrier \where BC.projection r = Right.second p }) \by BC.projectionOnto (Right.second p) \then
  \let z: Triple := Pair.pair first.Carrier BC.model.Carrier (Right.first p) r \then
  \return Logic.existsIntro[Triple, { z: Triple \where right z = q }] z
    (trans!{{Right.result.Carrier}} _ _ _
      (congr!{{Right.model.Carrier} {Right.result.Carrier}} Right.projection _ _ (Pair.Prop[A := first.Carrier, B := BC.result.Carrier].ext (rightRaw z) p
        (\refl(Right.first p)) (\bysub(BC.model.Carrier, { r: BC.model.Carrier \where BC.projection r = Right.second p }, r))))
      (\bysub(Right.model.Carrier, { p: Right.model.Carrier \where Right.projection p = q }, p)))
};
