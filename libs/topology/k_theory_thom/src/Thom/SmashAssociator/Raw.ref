\definition First: \Set := first.Carrier;
\definition Inner: \Set := Pair.Times^[second.Carrier, third.Carrier];
\import topological_constructions.Product[A := First, B := Inner] \as Cartesian;
\definition Carrier: \Set := Cartesian.CarrierSet;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Cartesian.topology (Relative.details first).topology BC.topology;
\definition compact: topology.Topology[Carrier := Carrier].IsCompact topology := Cartesian.Compactness[].productCompact
  (Relative.details first).topology BC.topology (Relative.details first).compact BC.compact;
\definition hausdorff: topology.Topology[Carrier := Carrier].IsT2 topology :=
  topological_constructions.Separation[].Product[A := First, B := Inner].On[
    left := (Relative.details first).topology, right := BC.topology,
    leftHausdorff := (Relative.details first).hausdorff, rightHausdorff := BC.hausdorff].hausdorff;
\definition point: Carrier := Pair.pair First Inner (Relative.details first).point BC.point;
\definition model: Relative.CompactPointed := Relative.pack Carrier (Relative.PointedDetails[Carrier] {
  topology := topology, compact := compact, hausdorff := hausdorff, point := point
});
\definition first: Carrier -> First := Pair.first First Inner;
\definition second: Carrier -> Inner := Pair.second First Inner;
