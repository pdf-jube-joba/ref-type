\import topological_constructions.Product[A := first.Carrier, B := BC.model.Carrier] \as RawProduct;
\import topological_constructions.Product[A := second.Carrier, B := third.Carrier] \as BCProduct;
\import topological_constructions.Product[A := first.Carrier, B := second.Carrier] \as ABProduct;
\import topological_constructions.Product[A := AB.result.Carrier, B := third.Carrier] \as LeftProduct;
\import topological_constructions.Product[A := first.Carrier, B := BC.result.Carrier] \as RightProduct;
\definition aContinuous: topology.Continuity[A := Triple, B := first.Carrier].Continuous RawModel.topology (Relative.details first).topology a :=
  RawProduct.Maps[].firstContinuous (Relative.details first).topology BC.topology;
\definition bcContinuous: topology.Continuity[A := Triple, B := BC.model.Carrier].Continuous RawModel.topology BC.topology bc :=
  RawProduct.Maps[].secondContinuous (Relative.details first).topology BC.topology;
\definition bContinuous: topology.Continuity[A := Triple, B := second.Carrier].Continuous RawModel.topology (Relative.details second).topology b :=
  topology.Composition[A := Triple, B := BC.model.Carrier, C := second.Carrier].composeContinuous RawModel.topology BC.topology (Relative.details second).topology
    bc BC.first bcContinuous (BCProduct.Maps[].firstContinuous (Relative.details second).topology (Relative.details third).topology);
\definition cContinuous: topology.Continuity[A := Triple, B := third.Carrier].Continuous RawModel.topology (Relative.details third).topology c :=
  topology.Composition[A := Triple, B := BC.model.Carrier, C := third.Carrier].composeContinuous RawModel.topology BC.topology (Relative.details third).topology
    bc BC.second bcContinuous (BCProduct.Maps[].secondContinuous (Relative.details second).topology (Relative.details third).topology);
\definition abContinuous: topology.Continuity[A := Triple, B := AB.model.Carrier].Continuous RawModel.topology AB.topology ab :=
  ABProduct.Universal[X := Triple].pairContinuous RawModel.topology (Relative.details first).topology (Relative.details second).topology a b aContinuous bContinuous;
\definition leftRawContinuous: topology.Continuity[A := Triple, B := Left.model.Carrier].Continuous RawModel.topology Left.topology leftRaw :=
  LeftProduct.Universal[X := Triple].pairContinuous RawModel.topology (Relative.details AB.result).topology (Relative.details third).topology
    (\fun (z: Triple) => AB.projection (ab z)) c
    (topology.Composition[A := Triple, B := AB.model.Carrier, C := AB.result.Carrier].composeContinuous RawModel.topology AB.topology (Relative.details AB.result).topology
      ab AB.projection abContinuous (algebraic_topology.Pointed[A := AB.model.Carrier].Maps[B := AB.result.Carrier].laws (Relative.pointed AB.model) (Relative.pointed AB.result) AB.projection).continuous)
    cContinuous;
\definition rightRawContinuous: topology.Continuity[A := Triple, B := Right.model.Carrier].Continuous RawModel.topology Right.topology rightRaw :=
  topological_constructions.Product[A := first.Carrier, B := BC.result.Carrier].Universal[X := Triple].pairContinuous RawModel.topology (Relative.details first).topology (Relative.details BC.result).topology
    a (\fun (z: Triple) => BC.projection (bc z)) aContinuous
    (topology.Composition[A := Triple, B := BC.model.Carrier, C := BC.result.Carrier].composeContinuous RawModel.topology BC.topology (Relative.details BC.result).topology
      bc BC.projection bcContinuous (algebraic_topology.Pointed[A := BC.model.Carrier].Maps[B := BC.result.Carrier].laws (Relative.pointed BC.model) (Relative.pointed BC.result) BC.projection).continuous);
\definition leftContinuous: topology.Continuity[A := Triple, B := Left.result.Carrier].Continuous RawModel.topology (Relative.details Left.result).topology left :=
  topology.Composition[A := Triple, B := Left.model.Carrier, C := Left.result.Carrier].composeContinuous RawModel.topology Left.topology (Relative.details Left.result).topology
    leftRaw Left.projection leftRawContinuous (algebraic_topology.Pointed[A := Left.model.Carrier].Maps[B := Left.result.Carrier].laws (Relative.pointed Left.model) (Relative.pointed Left.result) Left.projection).continuous;
\definition rightContinuous: topology.Continuity[A := Triple, B := Right.result.Carrier].Continuous RawModel.topology (Relative.details Right.result).topology right :=
  topology.Composition[A := Triple, B := Right.model.Carrier, C := Right.result.Carrier].composeContinuous RawModel.topology Right.topology (Relative.details Right.result).topology
    rightRaw Right.projection rightRawContinuous (algebraic_topology.Pointed[A := Right.model.Carrier].Maps[B := Right.result.Carrier].laws (Relative.pointed Right.model) (Relative.pointed Right.result) Right.projection).continuous;
