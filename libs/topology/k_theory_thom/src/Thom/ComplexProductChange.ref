\import Operations.Models[X := X, baseSpace := space] \as Models;
\import \root.Thom[].RelativeComplex[X := X, space := space, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed, complex := first] \as Source;
\import \root.Thom[].RelativeComplex[X := X, space := space, compact := compact, hausdorff := hausdorff,
  subset := subset, closed := closed, complex := second] \as Target;
\import Models.Chains[].Of[complex := first] \as FirstChain;
\import Models.Chains[].Of[complex := second] \as SecondChain;
\import Bundles.Isomorphisms[X := X, F := Source.Even, G := Target.Even, source := Models.bundle Source.even, target := Models.bundle Target.even] \as Positive;
\import Bundles.Isomorphisms[X := X, F := Source.Odd, G := Target.Odd, source := Models.bundle Source.odd, target := Models.bundle Target.odd] \as Negative;
\import relative_k_theory.Relative[].Pair[X := X, space := space, compact := compact, hausdorff := hausdorff, subset := subset, closed := closed] \as Pair;
\import Models.Pullback[b := Source.even, Y := Pair.A, source := Pair.subspace, f := Source.inclusion, regular := Source.inclusionContinuous] \as FirstEven;
\import Models.Pullback[b := Source.odd, Y := Pair.A, source := Pair.subspace, f := Source.inclusion, regular := Source.inclusionContinuous] \as FirstOdd;
\import Models.Pullback[b := Target.even, Y := Pair.A, source := Pair.subspace, f := Source.inclusion, regular := Source.inclusionContinuous] \as SecondEven;
\import Models.Pullback[b := Target.odd, Y := Pair.A, source := Pair.subspace, f := Source.inclusion, regular := Source.inclusionContinuous] \as SecondOdd;
\import Models.PullbackMap[p := Source.even, q := Source.odd, Y := Pair.A, source := Pair.subspace, f := Source.inclusion, regular := Source.inclusionContinuous] \as FirstD;
\import Models.PullbackMap[p := Source.odd, q := Source.even, Y := Pair.A, source := Pair.subspace, f := Source.inclusion, regular := Source.inclusionContinuous] \as FirstE;
\import Models.PullbackMap[p := Target.even, q := Target.odd, Y := Pair.A, source := Pair.subspace, f := Source.inclusion, regular := Source.inclusionContinuous] \as SecondD;
\import Models.PullbackMap[p := Target.odd, q := Target.even, Y := Pair.A, source := Pair.subspace, f := Source.inclusion, regular := Source.inclusionContinuous] \as SecondE;
\import compact_support_k.Support[].CompactBundles[X := Pair.A, space := Pair.subspace,
  compact := Source.boundaryCompact, hausdorff := Source.boundaryHausdorff] \as Boundary;
\import Boundary.Acyclic[p := FirstEven.value, q := FirstOdd.value, d := FirstD.map FirstChain.parity.forward, e := FirstE.map FirstChain.parity.backward] \as FirstAcyclic;
\import Boundary.Acyclic[p := SecondEven.value, q := SecondOdd.value, d := SecondD.map SecondChain.parity.forward, e := SecondE.map SecondChain.parity.backward] \as SecondAcyclic;
\module With(positive: Positive.Isomorphism, negative: Negative.Isomorphism,
  forwardCommutes: \forall (x: X)(v: Source.Even x) ->
    (SecondChain.parity.forward.fiber x).apply ((positive.forward.fiber x).apply v) =
      (negative.forward.fiber x).apply ((FirstChain.parity.forward.fiber x).apply v),
  backwardCommutes: \forall (x: X)(v: Source.Odd x) ->
    (SecondChain.parity.backward.fiber x).apply ((negative.forward.fiber x).apply v) =
      (positive.forward.fiber x).apply ((FirstChain.parity.backward.fiber x).apply v));
