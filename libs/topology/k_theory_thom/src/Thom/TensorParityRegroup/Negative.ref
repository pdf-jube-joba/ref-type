\import \root.Thom[].ComplexProductDistribution[X := X, F := E0, G := H0, H := F1,
  first := e0, second := h0, third := f1, sameSecond := sameH0, sameThird := sameF1] \as Upper;
\definition lowerSame: e1.baseSpace = f0.baseSpace := trans!{Base.Topology} _ _ _ (sym!{Base.Topology} _ _ sameE1) sameF0;
\import \root.Thom[].ComplexProductDistribution[X := X, F := E1, G := H1, H := F0,
  first := e1, second := h1, third := f0, sameSecond := e1h1, sameThird := lowerSame] \as Lower;
\import Operations.DirectSumIsomorphisms[X := X, F := Upper.SourceFiber, G := Lower.SourceFiber, A := Upper.TargetFiber, B := Lower.TargetFiber,
  first := Upper.sourceBundle, second := Lower.sourceBundle, newFirst := Upper.targetBundle, newSecond := Lower.targetBundle,
  sameSource := sameE1, sameTarget := sameE1] \as Rows;
\definition rows: Bundles.Isomorphisms[X := X, F := Rows.SourceFiber, G := Rows.TargetFiber, source := Rows.sourceBundle, target := Rows.targetBundle].Isomorphism := Rows.isomorphism Upper.isomorphism Lower.isomorphism;
\import Operations.DirectSumMiddleSwap[X := X, F := Original.EOFiber, G := Auxiliary.EOFiber, H := Original.OEFiber, I := Auxiliary.OEFiber,
  first := Original.eoBundle, second := Auxiliary.eoBundle, third := Original.oeBundle, fourth := Auxiliary.oeBundle,
  sameSecond := sameH0, sameThird := sameE1, sameFourth := sameH1] \as Shuffle;
\import Operations.IsomorphismComposition[X := X, F := Source.Odd, G := Rows.TargetFiber, H := Odd.Fiber,
  source := Source.oddBundle, middle := Rows.targetBundle, target := oddBundle] \as Compose;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := Source.Odd, G := Odd.Fiber, source := Source.oddBundle, target := oddBundle].Isomorphism := Compose.compose rows Shuffle.isomorphism;

\import std.Data[].Pair[] \as P;
\definition onPure: \forall (x: X)(a: StableEven.Fiber x)(u: F1 x)(b: StableOdd.Fiber x)(v: F0 x) ->
  (isomorphism.forward.fiber x).apply (P.pair (Source.EOFiber x) (Source.OEFiber x) (Source.eo x a u) (Source.oe x b v)) =
  P.pair (Original.Odd x) (Auxiliary.Odd x)
    (P.pair (Original.EOFiber x) (Original.OEFiber x)
      (Original.eo x (P.first (E0 x) (H0 x) a) u) (Original.oe x (P.first (E1 x) (H1 x) b) v))
    (P.pair (Auxiliary.EOFiber x) (Auxiliary.OEFiber x)
      (Auxiliary.eo x (P.second (E0 x) (H0 x) a) u) (Auxiliary.oe x (P.second (E1 x) (H1 x) b) v)) :=
  \fun (x: X)(a: StableEven.Fiber x)(u: F1 x)(b: StableOdd.Fiber x)(v: F0 x) =>
    trans!{{Odd.Fiber x}} _ _ _
      (congr!{{Rows.TargetFiber x} {Odd.Fiber x}} (Shuffle.isomorphism.forward.fiber x).apply _ _
        (P.Prop[A := Upper.TargetFiber x, B := Lower.TargetFiber x].pairCong _ _ _ _
          (Upper.onPure x a u) (Lower.onPure x b v)))
      (Shuffle.formula x
        (Original.eo x (P.first (E0 x) (H0 x) a) u) (Auxiliary.eo x (P.second (E0 x) (H0 x) a) u)
        (Original.oe x (P.first (E1 x) (H1 x) b) v) (Auxiliary.oe x (P.second (E1 x) (H1 x) b) v));
