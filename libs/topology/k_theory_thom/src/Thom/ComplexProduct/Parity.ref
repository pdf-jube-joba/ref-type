\import \parent.Arithmetic[] \as Arithmetic;
\definition leftEven: ProductTheory.Classes := FirstBundles.map firstEven;
\definition leftOdd: ProductTheory.Classes := FirstBundles.map firstOdd;
\definition rightEven: ProductTheory.Classes := SecondBundles.map secondEven;
\definition rightOdd: ProductTheory.Classes := SecondBundles.map secondOdd;
\definition even: ProductTheory.Classes := BundlesRing.add (BundlesRing.mul leftEven rightEven) (BundlesRing.mul leftOdd rightOdd);
\definition odd: ProductTheory.Classes := BundlesRing.add (BundlesRing.mul leftEven rightOdd) (BundlesRing.mul leftOdd rightEven);
\definition difference: ProductK.Carrier := ProductK.difference even odd;
\module Of(a: First.Carrier, b: Second.Carrier,
  firstAgreement: ordinaryFirst a = FirstK.difference firstEven firstOdd,
  secondAgreement: ordinarySecond b = SecondK.difference secondEven secondOdd);
