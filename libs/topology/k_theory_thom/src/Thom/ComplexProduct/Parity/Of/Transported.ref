\import Relative.Reduced[model := model] \as Target;
\import Relative.Equivalence[source := model, target := Smash.result].With[e := equivalence].Groups[] \as Transport;
\definition product: Target.Carrier := Transport.forward (External.product a b);
\definition ordinary[q: Target.Carrier]: ProductK.Carrier := ordinaryForget (Transport.backward q);
\definition productFormula: ordinary product = difference :=
  trans!{{ProductK.Carrier}} _ _ _
    (congr!{{Result.Carrier} {ProductK.Carrier}} External.forget _ _ (Transport.rightInverse (External.product a b))) ordinaryEquation;
\definition determines[q: Target.Carrier][comparison: ordinary q = difference]: q = product :=
  trans!{{Target.Carrier}} _ _ _ (sym!{{Target.Carrier}} _ _ (Transport.leftInverse q))
    (congr!{{Result.Carrier} {Target.Carrier}} Transport.forward _ _ (External.forgetInjective (Transport.backward q) (External.product a b)
      (trans!{{ProductK.Carrier}} _ _ _ comparison (sym!{{ProductK.Carrier}} _ _ ordinaryEquation))));
