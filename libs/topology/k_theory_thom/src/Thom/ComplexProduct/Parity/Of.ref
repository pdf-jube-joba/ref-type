\definition firstFormula: FirstPull.map a = ProductK.difference leftEven leftOdd :=
  trans!{{ProductK.Carrier}} _ _ _
    (congr!{{FirstK.Carrier} {ProductK.Carrier}} FirstBundles.K0[].map _ _ firstAgreement)
    (FirstBundles.K0[].onDifferences firstEven firstOdd);
\definition secondFormula: SecondPull.map b = ProductK.difference rightEven rightOdd :=
  trans!{{ProductK.Carrier}} _ _ _
    (congr!{{SecondK.Carrier} {ProductK.Carrier}} SecondBundles.K0[].map _ _ secondAgreement)
    (SecondBundles.K0[].onDifferences secondEven secondOdd);
\definition ordinaryEquation: ordinaryForget (External.product a b) = difference :=
  trans!{{ProductK.Carrier}} _ _ _ (External.formula a b)
    (trans!{{ProductK.Carrier}} _ _ _
      (congr!{{ProductK.Carrier} {ProductK.Carrier} {ProductK.Carrier}} ProductK.mul _ _ _ _ firstFormula secondFormula)
      (Arithmetic.differences leftEven leftOdd rightEven rightOdd));
\definition determines[q: Result.Carrier][comparison: ordinaryForget q = difference]: q = External.product a b :=
  External.forgetInjective q (External.product a b)
    (trans!{{ProductK.Carrier}} _ _ _ comparison (sym!{{ProductK.Carrier}} _ _ ordinaryEquation));
\module Transported(model: Relative.CompactPointed,
  equivalence: Relative.Equivalence[source := model, target := Smash.result].Data);
