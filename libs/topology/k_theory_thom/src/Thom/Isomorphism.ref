\import relative_k_theory.Relative[] \as Relative;
\import periodic_k_theory.Periodicity[] \as Periodicity;
\module Bott(base: Relative.CompactPointed);
\module Model(A: \Set, source: topology.Topology[Carrier := A].Topology,
  target: Relative.CompactPointed,
  h: topology.Homeomorphism[A := A, B := target.Carrier].Homeomorphism[source, (Relative.details target).topology],
  point: A, preserves: h.forward point = (Relative.details target).point);
\module Ordinary(X: \Set, space: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact space,
  hausdorff: topology.Topology[Carrier := X].IsT2 space);
\module Collapse(X: \Set, space: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact space,
  hausdorff: topology.Topology[Carrier := X].IsT2 space,
  subset: \Pow X, closed: topology.Topology[Carrier := X].IsClosedIn space subset);
\module LineNormalization;
\module NegativeNormalization;
\module LineForms;
\module UnitNormalization(X: \Set, space: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact space, hausdorff: topology.Topology[Carrier := X].IsT2 space,
  subset: \Pow X, closed: topology.Topology[Carrier := X].IsClosedIn space subset,
  empty: \forall (x: \Cast[X] subset) -> Logic.False,
  complex: Operations.Models[X := X, baseSpace := space].Chains[].Complex);
\module PlanarSphere;
\module ZeroForms;
\module EmptyPair(X: \Set, space: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact space, hausdorff: topology.Topology[Carrier := X].IsT2 space,
  subset: \Pow X, closed: topology.Topology[Carrier := X].IsClosedIn space subset,
  empty: \forall (x: \Cast[X] subset) -> Logic.False);
\module TrivialEuler(X: \Set, space: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact space, hausdorff: topology.Topology[Carrier := X].IsT2 space,
  subset: \Pow X, closed: topology.Topology[Carrier := X].IsClosedIn space subset);
\module FiniteUnit(X: \Set, space: topology.Topology[Carrier := X].Topology,
  hausdorff: topology.Topology[Carrier := X].IsT2 space, locallyCompact: topology.LocallyCompact[A := X].IsLocallyCompact space,
  complex: Operations.Models[X := X, baseSpace := space].Chains[].Complex,
  K: \Pow X, compactK: topology.Topology[Carrier := X].IsCompactIn space K,
  exactOutside: \forall (x: \Cast[X] (topology.Topology[Carrier := X].Complement K)) ->
    Operations.Models[X := X, baseSpace := space].Chains[].Of[complex := complex].ExactAt x);
\module ZeroNormalization;
\module Point(n: N.Nat^);
\module BottExternal(base: Relative.CompactPointed, n: N.Nat^);
\module LinePlane;
\module SmashRight(base, firstRight, secondRight: Relative.CompactPointed,
  e: Relative.Equivalence[source := firstRight, target := secondRight].Data);
\module ExternalZero(base: Relative.CompactPointed);
\module ExternalLine(base: Relative.CompactPointed);
\module PointSum(n: N.Nat^);
\module ExternalTower;
