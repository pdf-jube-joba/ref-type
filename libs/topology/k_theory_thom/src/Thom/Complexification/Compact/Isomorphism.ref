\import Orientation.Isomorphism[] \as ComplexOrientation;
\import relative_k_theory.Relative[] \as Relative;
\import compact_support_k.Support[].On[X := Total, space := complexBundle.totalSpace,
  hausdorff := \root.Thom[].TotalSpace[X := X, F := Fiber, bundle := complexBundle, compact := compact, hausdorff := hausdorff].separated,
  locallyCompact := \root.Thom[].TotalSpace[X := X, F := Fiber, bundle := complexBundle, compact := compact, hausdorff := hausdorff].locallyCompact] \as Supported;
\definition data: periodic_k_theory.Periodicity[].Isomorphism[A := K.Carrier, B := Carrier,
  source := K.group, target := Relative.Reduced[model := Supported.model].group].Data := ComplexOrientation.data;
\definition backward: Carrier -> K.Carrier := data.backward;
\definition leftInverse: \forall (a: K.Carrier) -> backward (forward a) = a := data.leftInverse;
\definition rightInverse: \forall (u: Carrier) -> forward (backward u) = u := data.rightInverse;
