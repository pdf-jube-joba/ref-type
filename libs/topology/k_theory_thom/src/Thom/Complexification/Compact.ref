\import \root.Thom[].For[X := X, F := Fiber, bundle := complexBundle, compact := compact, hausdorff := hausdorff] \as Orientation;
\definition Carrier: \Set := Orientation.Carrier;
\definition thom: Carrier := Orientation.thom;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := bundle.baseSpace, compact := compact, hausdorff := hausdorff].K0[] \as K;
\definition forward[a: K.Carrier]: Carrier := Orientation.forward a;
\definition additive: \forall (a, b: K.Carrier) -> forward (K.add a b) =
  compact_support_k.Support[].On[X := Total, space := complexBundle.totalSpace,
    hausdorff := \root.Thom[].TotalSpace[X := X, F := Fiber, bundle := complexBundle, compact := compact, hausdorff := hausdorff].separated,
    locallyCompact := \root.Thom[].TotalSpace[X := X, F := Fiber, bundle := complexBundle, compact := compact, hausdorff := hausdorff].locallyCompact]
    .At[degree := std.Arithmetic[].Int[].Int^::ofNat N.Nat^::zero].group.base.op (forward a) (forward b) := Orientation.additive;
\module Isomorphism;
