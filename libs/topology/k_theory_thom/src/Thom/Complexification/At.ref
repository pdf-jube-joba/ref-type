\import \root.Thom[].Algebra[V := Koszul.Fiber p, space := Koszul.pulled.space p] \as Algebra;
\definition exact: \forall (k: N.Nat^)(omega: Term k p) -> Logic.Not (p.vector = (complexBundle.space p.base).zero) ->
  Algebra.Closed k p.vector omega -> \exists (eta: Term (N.Nat^::succ k) p \where
    (\parent.Degree[k := k].differential.fiber p).apply eta = omega) := Koszul.At[p := p].exact;
\definition closedAtZero: \forall (omega: Term N.Nat^::zero p) -> Algebra.Closed N.Nat^::zero p.vector omega :=
  Koszul.At[p := p].closedAtZero;
\definition closedAtSuccessor: \forall (k: N.Nat^)(omega: Term (N.Nat^::succ k) p) ->
  (\parent.Degree[k := k].differential.fiber p).apply omega = ((term k).space p).zero ->
  Algebra.Closed (N.Nat^::succ k) p.vector omega := Koszul.At[p := p].closedAtSuccessor;
