\import \root.Thom[].Naturality[X := X, F := Fiber, bundle := complexBundle, Y := Y, source := source,
  f := f, regular := regular].Koszul[].Degree[k := k] \as Natural;
\definition Source[p: Bundles.Family[X := Y, F := First].Point]: \Set := Natural.Term p;
\definition sourceBundle: Bundles.Family[X := Bundles.Family[X := Y, F := First].Point, F := Source].Bundle := Natural.sourceBundle;
\definition targetBundle: Bundles.Family[X := Bundles.Family[X := Y, F := First].Point, F := Source].Bundle := Natural.targetBundle;
\definition isomorphism: Bundles.Isomorphisms[X := Bundles.Family[X := Y, F := First].Point, F := Source, G := Source,
  source := sourceBundle, target := targetBundle].Isomorphism := Natural.isomorphism;
