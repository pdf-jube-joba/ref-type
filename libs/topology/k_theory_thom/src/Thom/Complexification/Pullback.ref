\import Complex.Pullback[Y := Y, baseSpace := source, f := f, regular := regular] \as Comparison;
\definition First[y: Y]: \Set := Fiber (f y);
\definition first: Bundles.Family[X := Y, F := First].Bundle := Comparison.firstBundle;
\definition second: Bundles.Family[X := Y, F := First].Bundle := Comparison.secondBundle;
\definition complexificationComparison: Bundles.Isomorphisms[X := Y, F := First, G := First, source := first, target := second].Isomorphism := Comparison.isomorphism;
\definition onFiber: \forall (y: Y)(v: First y) -> (complexificationComparison.forward.fiber y).apply v = v := Comparison.onFiber;
\import Bundles.Isomorphisms[X := Y, F := First, G := First, source := first, target := second] \as BundleComparison;
\import \root.Thom[].Koszul[X := Y, F := First, bundle := first] \as FirstKoszul;
\import \root.Thom[].Koszul[X := Y, F := First, bundle := second] \as SecondKoszul;
\definition totalHomeomorphism: topology.Homeomorphism[A := FirstKoszul.Total, B := SecondKoszul.Total].Homeomorphism[first.totalSpace, second.totalSpace] :=
  BundleComparison.homeomorphism complexificationComparison;
\definition zeroPreserved: \forall (p: FirstKoszul.Total) -> p.vector = (first.space p.base).zero ->
  (totalHomeomorphism.forward p).vector = (second.space (totalHomeomorphism.forward p).base).zero :=
  \fun (p: FirstKoszul.Total)(zero: _) => zero;
\definition zeroReflected: \forall (p: SecondKoszul.Total) -> p.vector = (second.space p.base).zero ->
  (totalHomeomorphism.backward p).vector = (first.space (totalHomeomorphism.backward p).base).zero :=
  \fun (p: SecondKoszul.Total)(zero: _) => zero;
\module Degree(k: N.Nat^);
