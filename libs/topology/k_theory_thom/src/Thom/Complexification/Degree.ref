\definition differential: Bundles.Morphisms[X := Total, Y := Total, F := Term (N.Nat^::succ k), G := Term k,
  source := term (N.Nat^::succ k), target := term k, f := \fun (p: Total) => p].Map := Koszul.Degree[k := k].differential;
\definition squareZero: \forall (p: Total)(omega: Term (N.Nat^::succ (N.Nat^::succ k)) p) ->
  (differential.fiber p).apply
    (Spaces.Multilinear[V := Fiber p.base, space := complexBundle.space p.base].Alternating[].Contraction[k := N.Nat^::succ k].apply omega p.vector) = ((term k).space p).zero :=
  Koszul.Degree[k := k].squareZero;
