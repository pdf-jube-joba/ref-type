\import Operations.Models[X := X, baseSpace := space] \as Models;
\import compact_support_k.Support[].CompactBundles[X := X, space := space, compact := compact, hausdorff := hausdorff] \as Boundary;
\import Boundary.Acyclic[p := p, q := q, d := d, e := e] \as Source;
\import Boundary.Acyclic[p := r, q := s, d := newD, e := newE] \as Target;
\definition SourceEven[x: X]: \Set := Models.Fiber p.ranks x;
\definition SourceOdd[x: X]: \Set := Models.Fiber q.ranks x;
\definition TargetEven[x: X]: \Set := Models.Fiber r.ranks x;
\definition TargetOdd[x: X]: \Set := Models.Fiber s.ranks x;
\import Bundles.Isomorphisms[X := X, F := SourceEven, G := TargetEven, source := Models.bundle p, target := Models.bundle r] \as Positive;
\import Bundles.Isomorphisms[X := X, F := SourceOdd, G := TargetOdd, source := Models.bundle q, target := Models.bundle s] \as Negative;
\module With(positive: Positive.Isomorphism, negative: Negative.Isomorphism,
  forwardCommutes: \forall (x: X)(v: SourceEven x) -> (newD.fiber x).apply ((positive.forward.fiber x).apply v) = (negative.forward.fiber x).apply ((d.fiber x).apply v),
  backwardCommutes: \forall (x: X)(v: SourceOdd x) -> (newE.fiber x).apply ((negative.forward.fiber x).apply v) = (positive.forward.fiber x).apply ((e.fiber x).apply v));
