\import \root.Thom[].GradedStabilization[X := X, E0 := F0, E1 := F1, H := H,
  even := f0, odd := f1, auxiliary := auxiliary, sameOdd := f0f1, sameAuxiliary := f0Aux] \as FactorGeometry;
\definition radiusContinuous: topology.Continuity[A := X, B := C.Complex].Continuous f0.baseSpace Scalars.scalar.topological.space radius :=
  \idelim e0.baseSpace = f0.baseSpace \with t: Base.Topology => topology.Continuity[A := X, B := C.Complex].Continuous t Scalars.scalar.topological.space radius \by { base: continuous, equality: sameF0 };
\import \root.Thom[].GradedStabilization[X := X, E0 := F0, E1 := F1, H := H,
  even := f0, odd := f1, auxiliary := auxiliary, sameOdd := f0f1, sameAuxiliary := f0Aux].With[d := d, e := e, radius := radius, continuous := radiusContinuous] \as Factor;
\import Operations.IdentityIsomorphism[X := X, F := Source.LeftFiber, bundle := Source.leftBundle] \as PartnerIso;
\import \root.Thom[].TensorRightRegroup[X := X, F := Source.LeftFiber, G := Original.RightFiber, H := Auxiliary.RightFiber,
  first := Source.leftBundle, second := Original.rightBundle, third := Auxiliary.rightBundle,
  sameSecond := sameF0, sameThird := sameAuxiliary] \as Distribution;
\import Distribution.Operators[partner := partner, grading := Grading.leftGrading.forward,
  firstOperator := Factor.originalOperator, secondOperator := Factor.auxiliaryOperator] \as Regroup;
\import Operations.DirectSum[X := X, F := Original.RightFiber, G := Auxiliary.RightFiber,
  left := Original.rightBundle, right := Auxiliary.rightBundle] \as Grouped;
\definition grouped: Bundles.Family[X := X, F := Grouped.Fiber].Bundle := Grouped.bundle f0Aux;
\import \root.Thom[].TensorNaturality[X := X, F := Source.LeftFiber, G := Source.RightFiber, A := Source.LeftFiber, B := Grouped.Fiber,
  first := Source.leftBundle, second := Source.rightBundle, newFirst := Source.leftBundle, newSecond := grouped,
  sameSource := sameF0, sameTarget := sameF0, firstIso := PartnerIso.isomorphism, secondIso := FactorGeometry.isomorphism] \as Naturality;
\definition data: Naturality.Data := Naturality.Data {
  sourceFirst := partner, sourceSecond := Factor.sourceOperator, sourceGrading := Grading.leftGrading.forward,
  targetFirst := partner, targetSecond := Factor.targetOperator, targetGrading := Grading.leftGrading.forward
};
\definition laws: Naturality.Laws[data] := Naturality.Laws[data] {
  first := \fun (x: X)(v: Source.LeftFiber x) => \refl((partner.fiber x).apply v), second := Factor.commutes,
  grading := \fun (x: X)(v: Source.LeftFiber x) => \refl((Grading.leftGrading.forward.fiber x).apply v)
};
\import Naturality.With[c := data, laws := laws] \as Transport;
\import Operations.IsomorphismComposition[X := X, F := Source.SourceFiber, G := Distribution.SourceFiber, H := Distribution.TargetFiber,
  source := Source.sourceBundle, middle := Distribution.sourceBundle, target := Distribution.targetBundle] \as Compose;
\definition fullIso: Bundles.Isomorphisms[X := X, F := Source.SourceFiber, G := Distribution.TargetFiber,
  source := Source.sourceBundle, target := Distribution.targetBundle].Isomorphism := Compose.compose Naturality.isomorphism Distribution.isomorphism;
\definition sourceOperator: Bundles.Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Source.SourceFiber,
  source := Source.sourceBundle, target := Source.sourceBundle, f := (\fun (x: X) => x)].Map := Transport.source;
\definition targetOperator: Bundles.Morphisms[X := X, Y := X, F := Distribution.TargetFiber, G := Distribution.TargetFiber,
  source := Distribution.targetBundle, target := Distribution.targetBundle, f := (\fun (x: X) => x)].Map := Regroup.target;
\module Agreement(x: X);
\definition operatorCommutes: \forall (x: X)(v: Source.SourceFiber x) ->
  (fullIso.forward.fiber x).apply ((sourceOperator.fiber x).apply v) = (targetOperator.fiber x).apply ((fullIso.forward.fiber x).apply v) :=
  \fun (x: X)(v: Source.SourceFiber x) => trans!{{Distribution.TargetFiber x}} _ _ _
    (congr!{{Distribution.SourceFiber x} {Distribution.TargetFiber x}} (Distribution.isomorphism.forward.fiber x).apply _ _ (Transport.commutes x v))
    (trans!{{Distribution.TargetFiber x}} _ _ _
      (congr!{{Distribution.SourceFiber x} {Distribution.TargetFiber x}} (Distribution.isomorphism.forward.fiber x).apply _ _
        (Agreement[x := x].equation ((Naturality.isomorphism.forward.fiber x).apply v)))
      (Regroup.commutes x ((Naturality.isomorphism.forward.fiber x).apply v)));
\import Operations.DirectSumIsomorphisms[X := X, F := Original.SourceFiber, G := Auxiliary.SourceFiber, A := Original.TargetFiber, B := Auxiliary.TargetFiber,
  first := Original.sourceBundle, second := Auxiliary.sourceBundle, newFirst := Original.targetBundle, newSecond := Auxiliary.targetBundle,
  sameSource := (\refl(e0.baseSpace)), sameTarget := (\refl(e0.baseSpace))] \as Parts;
\definition parts: Bundles.Isomorphisms[X := X, F := Parts.SourceFiber, G := Parts.TargetFiber, source := Parts.sourceBundle, target := Parts.targetBundle].Isomorphism := Parts.isomorphism Original.isomorphism Auxiliary.isomorphism;
\import Operations.DirectSumMiddleSwap[X := X, F := Original.Even, G := Original.Odd, H := Auxiliary.Even, I := Auxiliary.Odd,
  first := Original.evenBundle, second := Original.oddBundle, third := Auxiliary.evenBundle, fourth := Auxiliary.oddBundle,
  sameSecond := (\refl(e0.baseSpace)), sameThird := (\refl(e0.baseSpace)), sameFourth := (\refl(e0.baseSpace))] \as Shuffle;
\import Operations.IsomorphismComposition[X := X, F := Distribution.TargetFiber, G := Parts.TargetFiber, H := Shuffle.TargetFiber,
  source := Distribution.targetBundle, middle := Parts.targetBundle, target := Shuffle.targetBundle] \as TargetComposition;
\definition targetDecomposition: Bundles.Isomorphisms[X := X, F := Distribution.TargetFiber, G := Shuffle.TargetFiber,
  source := Distribution.targetBundle, target := Shuffle.targetBundle].Isomorphism := TargetComposition.compose parts Shuffle.isomorphism;
\import Operations.DirectSum[X := X, F := Original.Even, G := Auxiliary.Even, left := Original.evenBundle, right := Auxiliary.evenBundle] \as Even;
\import Operations.DirectSum[X := X, F := Original.Odd, G := Auxiliary.Odd, left := Original.oddBundle, right := Auxiliary.oddBundle] \as Odd;
\definition evenBundle: Bundles.Family[X := X, F := Even.Fiber].Bundle := Even.bundle (\refl(e0.baseSpace));
\definition oddBundle: Bundles.Family[X := X, F := Odd.Fiber].Bundle := Odd.bundle (\refl(e0.baseSpace));
\definition positive: Bundles.Isomorphisms[X := X, F := Source.Even, G := Even.Fiber, source := Source.evenBundle, target := evenBundle].Isomorphism := Sectors.Positive[].isomorphism;
\definition negative: Bundles.Isomorphisms[X := X, F := Source.Odd, G := Odd.Fiber, source := Source.oddBundle, target := oddBundle].Isomorphism := Sectors.Negative[].isomorphism;
\import Operations.DirectSumIsomorphisms[X := X, F := Source.Even, G := Source.Odd, A := Even.Fiber, B := Odd.Fiber,
  first := Source.evenBundle, second := Source.oddBundle, newFirst := evenBundle, newSecond := oddBundle,
  sameSource := (\refl(e0.baseSpace)), sameTarget := (\refl(e0.baseSpace))] \as Total;
\definition totalIso: Bundles.Isomorphisms[X := X, F := Source.TargetFiber, G := Shuffle.TargetFiber,
  source := Source.targetBundle, target := Shuffle.targetBundle].Isomorphism := Total.isomorphism positive negative;
\module Coherence(x: X);
\definition coherence: \forall (x: X)(v: Source.SourceFiber x) -> (targetDecomposition.forward.fiber x).apply ((fullIso.forward.fiber x).apply v) =
  (totalIso.forward.fiber x).apply ((Source.isomorphism.forward.fiber x).apply v) := \fun (x: X) => Coherence[x := x].equation;
\import \root.Thom[].DecompositionChange[X := X, F := Source.SourceFiber, G := Distribution.TargetFiber, E := Source.Even, O := Source.Odd, A := Even.Fiber, B := Odd.Fiber,
  sourceFull := Source.sourceBundle, targetFull := Distribution.targetBundle, sourceEven := Source.evenBundle, sourceOdd := Source.oddBundle,
  targetEven := evenBundle, targetOdd := oddBundle, sameSource := (\refl(e0.baseSpace)), sameTarget := (\refl(e0.baseSpace)),
  sourceDecomposition := Source.isomorphism, targetDecomposition := targetDecomposition, fullIso := fullIso,
  evenIso := positive, oddIso := negative, coherence := coherence].Blocks[c := sourceOperator, d := targetOperator, operatorCommutes := operatorCommutes] \as Blocks;
\definition sourceForward: Bundles.Morphisms[X := X, Y := X, F := Source.Even, G := Source.Odd,
  source := Source.evenBundle, target := Source.oddBundle, f := (\fun (x: X) => x)].Map := Blocks.sourceBlock;
\definition targetForward: Bundles.Morphisms[X := X, Y := X, F := Even.Fiber, G := Odd.Fiber,
  source := evenBundle, target := oddBundle, f := (\fun (x: X) => x)].Map := Blocks.targetBlock;
\definition forwardCommutes: \forall (x: X)(v: Source.Even x) -> (negative.forward.fiber x).apply ((sourceForward.fiber x).apply v) =
  (targetForward.fiber x).apply ((positive.forward.fiber x).apply v) := Blocks.equation;

\module OriginalRaw;
\module AuxiliaryRaw;
\import std.Data[].Pair[] \as Pair;
\definition targetOperatorOnParts: \forall (x: X)(v: Distribution.TargetFiber x) -> (targetOperator.fiber x).apply v =
  Pair.pair (Original.SourceFiber x) (Auxiliary.SourceFiber x)
    ((OriginalRaw[].operator.fiber x).apply (Pair.first (Original.SourceFiber x) (Auxiliary.SourceFiber x) v))
    ((AuxiliaryRaw[].operator.fiber x).apply (Pair.second (Original.SourceFiber x) (Auxiliary.SourceFiber x) v)) :=
  \fun (x: X)(v: Distribution.TargetFiber x) => \refl((targetOperator.fiber x).apply v);
\definition targetFormula: \forall (x: X)(v: Even.Fiber x) -> (targetForward.fiber x).apply v =
  Pair.pair (Original.Odd x) (Auxiliary.Odd x)
    ((OriginalRaw[].forward.fiber x).apply (Pair.first (Original.Even x) (Auxiliary.Even x) v))
    ((AuxiliaryRaw[].forward.fiber x).apply (Pair.second (Original.Even x) (Auxiliary.Even x) v)) :=
  \fun (x: X)(v: Even.Fiber x) => \refl((targetForward.fiber x).apply v);
