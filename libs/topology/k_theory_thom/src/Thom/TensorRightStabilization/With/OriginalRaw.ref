\import Operations.Tensor[X := X, F := Original.LeftFiber, G := Original.RightFiber, left := Original.leftBundle, right := Original.rightBundle] \as Tensor;
\import Tensor.Of[same := sameF0].Mapping[Y := X, A := Original.LeftFiber, B := Original.RightFiber,
  leftTarget := Original.leftBundle, rightTarget := Original.rightBundle, f := (\fun (x: X) => x)].Of[targetSame := sameF0] \as Mapping;
\import Bundles.Identity[X := X, F := Original.RightFiber, bundle := Original.rightBundle] \as Identity;
\import Operations.MapOperations[X := X, F := Original.SourceFiber, G := Original.SourceFiber, source := Original.sourceBundle, target := Original.sourceBundle] \as Maps;
\definition operator: Maps.Map := Maps.add (Mapping.map partner Identity.map) (Mapping.map Grading.leftGrading.forward Factor.originalOperator);
\import Operations.DirectSum[X := X, F := Original.Even, G := Original.Odd, left := Original.evenBundle, right := Original.oddBundle]
  .Of[same := (\refl(e0.baseSpace))] \as Split;
\import Split.Inclusions[] \as Inclusions;
\import Bundles.Morphisms[X := X, Y := X, F := Original.Even, G := Original.TargetFiber,
  source := Original.evenBundle, target := Original.targetBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Original.SourceFiber, range := Original.sourceBundle, g := (\fun (x: X) => x)] \as Embedding;
\definition embed: Bundles.Morphisms[X := X, Y := X, F := Original.Even, G := Original.SourceFiber,
  source := Original.evenBundle, target := Original.sourceBundle, f := (\fun (x: X) => x)].Map := Embedding.compose Inclusions.first Original.isomorphism.backward;
\import Bundles.Morphisms[X := X, Y := X, F := Original.SourceFiber, G := Original.TargetFiber,
  source := Original.sourceBundle, target := Original.targetBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Original.Odd, range := Original.oddBundle, g := (\fun (x: X) => x)] \as Projection;
\definition project: Bundles.Morphisms[X := X, Y := X, F := Original.SourceFiber, G := Original.Odd,
  source := Original.sourceBundle, target := Original.oddBundle, f := (\fun (x: X) => x)].Map := Projection.compose Original.isomorphism.forward Split.secondMap;
\import Bundles.Morphisms[X := X, Y := X, F := Original.Even, G := Original.SourceFiber,
  source := Original.evenBundle, target := Original.sourceBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Original.SourceFiber, range := Original.sourceBundle, g := (\fun (x: X) => x)] \as Start;
\import Bundles.Morphisms[X := X, Y := X, F := Original.Even, G := Original.SourceFiber,
  source := Original.evenBundle, target := Original.sourceBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Original.Odd, range := Original.oddBundle, g := (\fun (x: X) => x)] \as End;
\definition forward: Bundles.Morphisms[X := X, Y := X, F := Original.Even, G := Original.Odd,
  source := Original.evenBundle, target := Original.oddBundle, f := (\fun (x: X) => x)].Map := End.compose (Start.compose embed operator) project;
