\import Operations.Tensor[X := X, F := Source.LeftFiber, G := Grouped.Fiber, left := Source.leftBundle, right := grouped] \as Tensor;
\import Operations.TensorEquality[V := Source.LeftFiber x, W := Grouped.Fiber x, U := Distribution.SourceFiber x,
  left := Source.leftBundle.space x, right := grouped.space x, target := Distribution.sourceBundle.space x] \as EqualityOnPure;
\definition pureEquation: \forall (v: Source.LeftFiber x)(w: Grouped.Fiber x) -> (Transport.target.fiber x).apply (Tensor.pure x v w) = (Regroup.source.fiber x).apply (Tensor.pure x v w) :=
  \fun (v: Source.LeftFiber x)(w: Grouped.Fiber x) => trans!{{Distribution.SourceFiber x}} _ _ _ (Transport.targetOnPure x v w)
    (sym!{{Distribution.SourceFiber x}} _ _ (Regroup.onPure x v w));
\definition equation: \forall (v: Distribution.SourceFiber x) -> (Transport.target.fiber x).apply v = (Regroup.source.fiber x).apply v :=
  EqualityOnPure.pointwise (Transport.target.fiber x) (Regroup.source.fiber x) pureEquation;
