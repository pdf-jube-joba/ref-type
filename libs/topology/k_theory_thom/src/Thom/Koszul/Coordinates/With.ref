\definition model[k: N.Nat^]: Models.Bundle := (selection k).model;
\definition Vector[k: N.Nat^][p: Total]: \Set := Models.Fiber (model k).ranks p;
\definition encode[k: N.Nat^][p: Total]: Spaces.Linear[V := Term k p, W := Vector k p,
  source := (term k).space p, target := (Models.bundle (model k)).space p].Map :=
  ((selection k).isomorphism.forward.fiber p);
\definition decode[k: N.Nat^][p: Total]: Spaces.Linear[V := Vector k p, W := Term k p,
  source := (Models.bundle (model k)).space p, target := (term k).space p].Map :=
  ((selection k).isomorphism.backward.fiber p);
\module Differential(k: N.Nat^);
\definition differential[k: N.Nat^]: Models.Map (model (N.Nat^::succ k)) (model k) := Differential[k := k].map;
\definition encodeDecode: \forall (k: N.Nat^)(p: Total)(v: Vector k p) -> (encode k p).apply ((decode k p).apply v) = v :=
  \fun (k: N.Nat^)(p: Total) => (selection k).isomorphism.rightInverse p;
\definition decodeEncode: \forall (k: N.Nat^)(p: Total)(v: Term k p) -> (decode k p).apply ((encode k p).apply v) = v :=
  \fun (k: N.Nat^)(p: Total) => (selection k).isomorphism.leftInverse p;
\module At(p: Total);
\module Finite;
\module Padding(n: N.Nat^,
  zero: \forall (p: Total)(omega: Term n p) -> omega = ((term n).space p).zero,
  zeroOne: \forall (p: Total)(omega: Term (N.Nat^::succ n) p) -> omega = ((term (N.Nat^::succ n)).space p).zero,
  zeroTwo: \forall (p: Total)(omega: Term (N.Nat^::succ (N.Nat^::succ n)) p) -> omega = ((term (N.Nat^::succ (N.Nat^::succ n))).space p).zero,
  compact: topology.Topology[Carrier := X].IsCompact bundle.baseSpace,
  hausdorff: topology.Topology[Carrier := X].IsT2 bundle.baseSpace);
