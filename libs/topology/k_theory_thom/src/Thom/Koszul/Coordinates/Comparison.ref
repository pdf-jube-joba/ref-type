\import \parent.With[selection := first] \as First;
\import \parent.With[selection := second] \as Second;
\module At(k: N.Nat^);
\definition isomorphism[k: N.Nat^]: Bundles.Isomorphisms[X := Total, F := First.Vector k, G := Second.Vector k,
  source := Models.bundle (First.model k), target := Models.bundle (Second.model k)].Isomorphism := At[k := k].isomorphism;
\definition commutes: \forall (k: N.Nat^)(p: Total)(v: First.Vector (N.Nat^::succ k) p) ->
  ((Second.differential k).fiber p).apply (((isomorphism (N.Nat^::succ k)).forward.fiber p).apply v) =
  ((isomorphism k).forward.fiber p).apply (((First.differential k).fiber p).apply v) :=
  \fun (k: N.Nat^)(p: Total)(v: First.Vector (N.Nat^::succ k) p) => trans!{{Second.Vector k p}} _ _ _
    (congr!{{Term (N.Nat^::succ k) p} {Second.Vector k p}}
      (\fun (omega: Term (N.Nat^::succ k) p) => (Second.encode k p).apply ((\root.Thom[].Koszul[X := X, F := F, bundle := bundle].Degree[k := k].differential.fiber p).apply omega)) _ _
      (Second.decodeEncode (N.Nat^::succ k) p ((First.decode (N.Nat^::succ k) p).apply v)))
    (congr!{{Term k p} {Second.Vector k p}} (Second.encode k p).apply _ _
      (sym!{{Term k p}} _ _ (First.decodeEncode k p _)));
