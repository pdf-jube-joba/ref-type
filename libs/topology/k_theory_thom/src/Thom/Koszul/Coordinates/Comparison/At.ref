\import Bundles.Isomorphisms[X := Total, F := Term k, G := First.Vector k,
  source := term k, target := Models.bundle (First.model k)] \as Reverse;
\import Operations.IsomorphismComposition[X := Total, F := First.Vector k, G := Term k, H := Second.Vector k,
  source := Models.bundle (First.model k), middle := term k, target := Models.bundle (Second.model k)] \as Compose;
\definition isomorphism: Bundles.Isomorphisms[X := Total, F := First.Vector k, G := Second.Vector k,
  source := Models.bundle (First.model k), target := Models.bundle (Second.model k)].Isomorphism :=
  Compose.compose (Reverse.inverse (first k).isomorphism) (second k).isomorphism;
\definition formula: \forall (p: Total)(v: First.Vector k p) -> (isomorphism.forward.fiber p).apply v =
  (Second.encode k p).apply ((First.decode k p).apply v) :=
  \fun (p: Total)(v: First.Vector k p) => \refl((Second.encode k p).apply ((First.decode k p).apply v));
