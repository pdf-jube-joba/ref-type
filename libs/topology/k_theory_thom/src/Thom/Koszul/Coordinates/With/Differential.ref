\import Bundles.Morphisms[X := Total, Y := Total, F := Vector (N.Nat^::succ k), G := Term (N.Nat^::succ k),
  source := Models.bundle (model (N.Nat^::succ k)), target := term (N.Nat^::succ k), f := \fun (p: Total) => p] \as First;
\import First.Composition[Z := Total, H := Term k, range := term k, g := \fun (p: Total) => p] \as Middle;
\definition middle: Bundles.Morphisms[X := Total, Y := Total, F := Vector (N.Nat^::succ k), G := Term k,
  source := Models.bundle (model (N.Nat^::succ k)), target := term k, f := \fun (p: Total) => p].Map :=
  Middle.compose (selection (N.Nat^::succ k)).isomorphism.backward
    (\root.Thom[].Koszul[X := X, F := F, bundle := bundle].Degree[k := k].differential);
\import Bundles.Morphisms[X := Total, Y := Total, F := Vector (N.Nat^::succ k), G := Term k,
  source := Models.bundle (model (N.Nat^::succ k)), target := term k, f := \fun (p: Total) => p]
  .Composition[Z := Total, H := Vector k, range := Models.bundle (model k), g := \fun (p: Total) => p] \as Last;
\definition map: Models.Map (model (N.Nat^::succ k)) (model k) :=
  Last.compose middle (selection k).isomorphism.forward;
