\import \parent.Finite[].At[n := n, zeroAbove := zero] \as FirstComplex;
\import \parent.Finite[].At[n := N.Nat^::succ n, zeroAbove := zeroOne] \as MiddleComplex;
\import \parent.Finite[].At[n := N.Nat^::succ (N.Nat^::succ n), zeroAbove := zeroTwo] \as SecondComplex;
\import \root.Thom[].Finite[X := Total, baseSpace := bundle.totalSpace]
  .Family[term := model, differential := differential, domain := \parent.Finite[].domain]
  .Padding[n := n, zeroOne := MiddleComplex.zeroAboveCoordinates, zeroTwo := SecondComplex.zeroAboveCoordinates] \as Fold;
\import \root.Thom[].TotalSpace[X := X, F := F, bundle := bundle, compact := compact, hausdorff := hausdorff] \as Topology;
\import compact_support_k.Support[].On[X := Total, space := bundle.totalSpace,
  hausdorff := Topology.separated, locallyCompact := Topology.locallyCompact] \as Supported;
\import Supported.FiniteComplexes[].Of[complex := FirstComplex.complex].Supported[K := ZeroSection,
  compactK := Topology.zeroCompact, exactOutside := FirstComplex.exactOutside] \as FirstClass;
\import Supported.FiniteComplexes[].Of[complex := SecondComplex.complex].Supported[K := ZeroSection,
  compactK := Topology.zeroCompact, exactOutside := SecondComplex.exactOutside] \as SecondClass;
\definition first: Supported.At[degree := std.Arithmetic[].Int[].Int^::ofNat N.Nat^::zero].Carrier := FirstClass.value;
\definition second: Supported.At[degree := std.Arithmetic[].Int[].Int^::ofNat N.Nat^::zero].Carrier := SecondClass.value;
\import Supported.FiniteComplexes[].Homotopy[first := FirstComplex.complex, second := SecondComplex.complex]
  .With[positive := Fold.even, negative := Fold.odd]
  .Constant[commutesD := Fold.forward, commutesE := Fold.backward]
  .Supported[K := ZeroSection, compact := Topology.zeroCompact,
    firstExact := FirstComplex.exactOutside, secondExact := SecondComplex.exactOutside] \as Classes;
\definition equation: first = second := Classes.equation;
