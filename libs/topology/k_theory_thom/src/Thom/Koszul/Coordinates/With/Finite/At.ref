\definition zeroAboveCoordinates: \forall (p: Total)(v: Vector n p) -> v = ((Models.bundle (model n)).space p).zero :=
  \fun (p: Total)(v: Vector n p) => trans!{{Vector n p}} _ _ _ (sym!{{Vector n p}} _ _ (encodeDecode n p v))
    (trans!{{Vector n p}} _ _ _
      (congr!{{Term n p} {Vector n p}} (encode n p).apply _ _ (zeroAbove p ((decode n p).apply v)))
      (encode n p).preservesZero);
\import Construction.At[n := n, zeroAbove := zeroAboveCoordinates] \as Model;
\definition complex: Models.Chains[].Complex := Model.value;
\definition exactOutside: \forall (p: Outside) -> Models.Chains[].Of[complex := complex].ExactAt p :=
  \fun (p: Outside) => Model.exactAt p (\bysub(Total, Outside, p));
