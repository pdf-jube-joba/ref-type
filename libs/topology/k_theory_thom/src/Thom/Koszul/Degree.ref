\import \root.Thom[].Contraction[X := Total, F := Fiber, bundle := pulled, section := tautological, k := k] \as Contraction;
\definition differential: Bundles.Morphisms[X := Total, Y := Total, F := Term (N.Nat^::succ k), G := Term k,
  source := term (N.Nat^::succ k), target := term k, f := \fun (p: Total) => p].Map := Contraction.map;
\definition squareZero: \forall (p: Total)(omega: Term (N.Nat^::succ (N.Nat^::succ k)) p) ->
  (differential.fiber p).apply (Spaces.Multilinear[V := Fiber p, space := pulled.space p].Alternating[].Contraction[k := N.Nat^::succ k].apply omega p.vector) = ((term k).space p).zero := Contraction.squareZero;
