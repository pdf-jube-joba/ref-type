\import Operations.Models[X := Total, baseSpace := bundle.totalSpace] \as Models;
\definition Choice[k: N.Nat^]: \Set := Models.From[F := Term k, original := term k].Result;
\definition existence: \forall (k: N.Nat^) -> \exists Choice k :=
  \fun (k: N.Nat^) => Models.From[F := Term k, original := term k].existence (\refl(bundle.totalSpace));
\definition selections: \exists (\forall (k: N.Nat^) -> Choice k) :=
  \axiom:classicalIndefiniteChoice(N.Nat^, Choice, existence);
\module With(selection: \forall (k: N.Nat^) -> Choice k);
\module Comparison(first, second: \forall (k: N.Nat^) -> Choice k);
