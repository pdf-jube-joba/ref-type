\import \parent.\parent.Degree[k := k] \as Target;
\import \parent.\parent.Degree[k := N.Nat^::succ k] \as Domain;
\import \root.Thom[].Contraction[X := X, F := F, bundle := bundle, section := section, k := k] \as OriginalContraction;
\import \root.Thom[].Contraction[X := Y, F := Fiber, bundle := pulled, section := sectionOnPullback, k := k] \as PulledContraction;
\import Operations.Alternating[X := X, F := F, bundle := bundle, k := k] \as OriginalTarget;
\import Operations.Alternating[X := X, F := F, bundle := bundle, k := N.Nat^::succ k] \as OriginalDomain;
\import Bundles.ArrowLaws[X := X, Y := X, F := OriginalDomain.Fiber, G := OriginalTarget.Fiber,
  source := OriginalDomain.alternating, target := OriginalTarget.alternating,
  f := \fun (x: X) => x].Pullback[Z := Y, space := source, g := f].Of[a := OriginalContraction.map, regular := regular] \as Arrow;
\definition differential: Bundles.Morphisms[X := Y, Y := Y, F := Domain.First, G := Target.First,
  source := Domain.first, target := Target.first, f := \fun (y: Y) => y].Map := Arrow.map;
\definition commutes: \forall (y: Y)(omega: Domain.First y) ->
  (Target.isomorphism.forward.fiber y).apply ((differential.fiber y).apply omega) =
    (PulledContraction.map.fiber y).apply ((Domain.isomorphism.forward.fiber y).apply omega) :=
  \fun (y: Y)(omega: Domain.First y) => \refl((differential.fiber y).apply omega);
\definition inverseCommutes: \forall (y: Y)(omega: Domain.Second y) ->
  (Target.isomorphism.backward.fiber y).apply ((PulledContraction.map.fiber y).apply omega) =
    (differential.fiber y).apply ((Domain.isomorphism.backward.fiber y).apply omega) :=
  \fun (y: Y)(omega: Domain.Second y) => \refl((differential.fiber y).apply omega);
