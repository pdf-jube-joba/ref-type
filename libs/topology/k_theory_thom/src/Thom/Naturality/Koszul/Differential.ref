\import \parent.Degree[k := k] \as Target;
\import \parent.Degree[k := N.Nat^::succ k] \as Domain;
\import Bundles.ArrowLaws[X := OriginalKoszul.Total, Y := OriginalKoszul.Total,
  F := OriginalKoszul.Term (N.Nat^::succ k), G := OriginalKoszul.Term k,
  source := OriginalKoszul.term (N.Nat^::succ k), target := OriginalKoszul.term k,
  f := \fun (p: OriginalKoszul.Total) => p].Pullback[Z := Total, space := pulled.totalSpace, g := total].Of[
  a := OriginalKoszul.Degree[k := k].differential, regular := continuous] \as Arrow;
\definition differential: Bundles.Morphisms[X := Total, Y := Total, F := Domain.Term, G := Target.Term,
  source := Domain.sourceBundle, target := Target.sourceBundle, f := \fun (p: Total) => p].Map := Arrow.map;
\definition commutes: \forall (p: Total)(omega: Domain.Term p) ->
  (Target.isomorphism.forward.fiber p).apply ((differential.fiber p).apply omega) =
  (PulledKoszul.Degree[k := k].differential.fiber p).apply ((Domain.isomorphism.forward.fiber p).apply omega) :=
  \fun (p: Total)(omega: Domain.Term p) => trans!{{Target.Term p}} _ _ _ (Target.contraction p omega)
    (congr!{{Domain.Term p} {Target.Term p}} (PulledKoszul.Degree[k := k].differential.fiber p).apply _ _
      (sym!{{Domain.Term p}} _ _ (Domain.onFiber p omega)));
