\import Operations.Alternating[X := X, F := F, bundle := bundle, k := k] \as OriginalTerm;
\import OriginalTerm.Pullback[Y := Y, source := source, f := f, regular := regular] \as Comparison;
\definition First[y: Y]: \Set := OriginalTerm.Fiber (f y);
\definition Second[y: Y]: \Set := Operations.Alternating[X := Y, F := Fiber, bundle := pulled, k := k].Fiber y;
\definition first: Bundles.Family[X := Y, F := First].Bundle := Comparison.firstBundle;
\definition second: Bundles.Family[X := Y, F := Second].Bundle := Comparison.secondBundle;
\definition isomorphism: Bundles.Isomorphisms[X := Y, F := First, G := Second, source := first, target := second].Isomorphism := Comparison.isomorphism;
\definition onFiber: \forall (y: Y)(omega: First y) -> (isomorphism.forward.fiber y).apply omega = omega :=
  \fun (y: Y)(omega: First y) => \refl(omega);
\definition inverseOnFiber: \forall (y: Y)(omega: Second y) -> (isomorphism.backward.fiber y).apply omega = omega :=
  \fun (y: Y)(omega: Second y) => \refl(omega);
