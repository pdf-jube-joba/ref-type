\import Spaces.Linear[V := G x, W := F x, source := second.space x, target := first.space x].Operations[] \as Maps;
\import algebra.Group[].Of[Carrier := F x,
  group := std.Alg[].Ring[].ringModuleAsCommutativeGroup C.Complex (F x) Spaces.ring (first.space x)] \as PositiveGroup;
\import Spaces.Laws[V := G x, space := second.space x] \as NegativeLaws;
\definition equation: \forall (v: Fiber x) -> (bundle.space x).add
  ((gradingIso.forward.fiber x).apply ((operator.fiber x).apply v)) ((operator.fiber x).apply ((gradingIso.forward.fiber x).apply v)) = (bundle.space x).zero :=
  \fun (v: Fiber x) => P.Prop[A := F x, B := G x].ext _ _
    (trans!{{F x}} _ _ _
      (congr!{{F x} {F x}} ((first.space x).add ((e.fiber x).apply (P.second (F x) (G x) v))) _ _
        (trans!{{F x}} _ _ _
          (congr!{{G x} {F x}} (e.fiber x).apply _ _ (NegativeSign.formula x (P.second (F x) (G x) v)))
          (Maps.preservesNeg (e.fiber x) (P.second (F x) (G x) v))))
      (PositiveGroup.inverseRight ((e.fiber x).apply (P.second (F x) (G x) v))))
    (trans!{{G x}} _ _ _
      (congr!{{G x} {G x}} (\fun (w: G x) => (second.space x).add w ((d.fiber x).apply (P.first (F x) (G x) v))) _ _
        (NegativeSign.formula x ((d.fiber x).apply (P.first (F x) (G x) v))))
      (NegativeLaws.inverseLeft ((d.fiber x).apply (P.first (F x) (G x) v))));
