\import \parent.Geometry[] \as Geometry;
\import LeftFor.Using[data := firstData] \as First;
\import RightFor.Using[data := secondData] \as Second;
\definition firstDegree: N.Nat^ := First.degree;
\definition secondDegree: N.Nat^ := Second.degree;
\module Degree;
\import \root.Thom[].MetricFoldClass[X := X, F := F, bundle := left, compact := compact, hausdorff := hausdorff,
  metric := firstMetric, data := firstData] \as FirstFold;
\import \root.Thom[].MetricFoldClass[X := X, F := G, bundle := right, compact := rightCompact, hausdorff := rightHausdorff,
  metric := secondMetric, data := secondData] \as SecondFold;
\module Native;

\module Canonical(selection: \parent.Native[].TotalSelection);

\module Local(selection: \parent.Native[].TotalSelection,
  firstFactor: FirstFold.Boundary[].Factor, secondFactor: SecondFold.Boundary[].Factor);
