\import \parent.Native[] \as Native;
\import Native.With[selection := selection] \as Encoded;
\import \parent.Degree[] \as Cap;
\import Geometry.Primal[] \as Primal;
\import \root.Thom[].Koszul[X := X, F := Sum.Fiber, bundle := sum] \as SumKoszul;
\import SumKoszul.Coordinates[] \as SumCoordinates;
\import Operations.Models[X := Geometry.Total, baseSpace := Geometry.topology] \as SourceModels;
\import Operations.Models[X := Geometry.sumTotal, baseSpace := Geometry.sumTopology] \as Models;
\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := Scalars.scalar] \as Complements;
\module At(k: N.Nat^);
\definition selectionAt[k: N.Nat^]: SumCoordinates.Choice k := At[k := k].choice;
\definition data: SumFor.Data := SumFor.Data { bound := Cap.bound, selection := selectionAt, rankBound := Cap.rankBound };
\import SumFor.Using[data := data] \as Canonical;

\module Class;
\definition equation: SumFor.thom = Geometry.pull Encoded.value :=
  trans!{SumFor.Carrier} _ _ _ (SumFor.formula data) Class[].equation;

\module Differential;
\module Fold;
