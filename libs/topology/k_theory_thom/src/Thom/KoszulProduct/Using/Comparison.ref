\import \parent.Canonical[selection := selection] \as SumComparison;
\import \parent.Local[selection := selection, firstFactor := firstFactor, secondFactor := secondFactor] \as Local;
\definition equation: sumThom = product :=
  trans!{Carrier} _ _ _ SumComparison.equation
    (trans!{Carrier} _ _ _
      (congr!{{Geometry.Carrier} Carrier} Geometry.pull _ _ Local.equation)
      (trans!{Carrier} _ _ _ (Geometry.productFormula First.thom Second.thom)
        (congr!{{Multiplication.First} {Multiplication.Second} Carrier} Multiplication.multiply _ _ _ _
          (sym!{{Multiplication.First}} _ _ (LeftFor.formula firstData))
          (sym!{{Multiplication.Second}} _ _ (RightFor.formula secondData)))));
