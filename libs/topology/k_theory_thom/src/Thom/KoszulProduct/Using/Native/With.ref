\import Coordinates.With[selection := selection] \as Chosen;
\definition model[k: N.Nat^]: Models.Bundle := Chosen.model k;
\definition differential[k: N.Nat^]: Models.Map (model (N.Nat^::succ k)) (model k) := Chosen.differential k;
\definition Vector[k: N.Nat^][z: Geometry.Total]: \Set := Models.Fiber (model k).ranks z;
\definition encode[k: N.Nat^][z: Geometry.Total]: Spaces.Linear[V := Term k z, W := Vector k z, source := (term k).space z, target := (Models.bundle (model k)).space z].Map := Chosen.encode k z;
\definition decode[k: N.Nat^][z: Geometry.Total]: Spaces.Linear[V := Vector k z, W := Term k z, source := (Models.bundle (model k)).space z, target := (term k).space z].Map := Chosen.decode k z;
\definition decodeEncode[k: N.Nat^][z: Geometry.Total][v: Term k z]: (decode k z).apply ((encode k z).apply v) = v := Chosen.decodeEncode k z v;
\definition encodeDecode[k: N.Nat^][z: Geometry.Total][v: Vector k z]: (encode k z).apply ((decode k z).apply v) = v := (selection k).first.isomorphism.rightInverse z v;
\definition zeroAbove: \forall (z: Geometry.Total)(omega: Term degree z) -> omega = ((term degree).space z).zero := truncation;
\import Chosen.Finite[].At[n := degree, zeroAbove := zeroAbove] \as Construction;
\import Chosen.FormFinite[].At[n := degree, zeroAbove := formsZeroAbove] \as FormConstruction;
\definition complex: Models.Chains[].Complex := Construction.complex;
\definition formComplex: Models.Chains[].Complex := FormConstruction.complex;
\definition exactOutside: \forall (z: \Cast[Geometry.Total] (topology.Topology[Carrier := Geometry.Total].Complement Geometry.zeroSection)) -> Models.Chains[].Of[complex := complex].ExactAt z :=
  \fun (z: \Cast[Geometry.Total] (topology.Topology[Carrier := Geometry.Total].Complement Geometry.zeroSection)) => Construction.exactAt z
    (nonzero z (\bysub(Geometry.Total, topology.Topology[Carrier := Geometry.Total].Complement Geometry.zeroSection, z)));
\definition formExactOutside: \forall (z: \Cast[Geometry.Total] (topology.Topology[Carrier := Geometry.Total].Complement Geometry.zeroSection)) -> Models.Chains[].Of[complex := formComplex].ExactAt z :=
  \fun (z: \Cast[Geometry.Total] (topology.Topology[Carrier := Geometry.Total].Complement Geometry.zeroSection)) => FormConstruction.exactAt z
    (nonzero z (\bysub(Geometry.Total, topology.Topology[Carrier := Geometry.Total].Complement Geometry.zeroSection, z)));
\import Support.On[X := Geometry.Total, space := Geometry.topology, hausdorff := Geometry.hausdorff, locallyCompact := Geometry.locallyCompact] \as Whole;
\import Whole.FiniteComplexes[].Of[complex := complex].Supported[K := Geometry.zeroSection, compactK := Geometry.zeroCompact, exactOutside := exactOutside] \as Supported;
\import Whole.FiniteComplexes[].Of[complex := formComplex].Supported[K := Geometry.zeroSection, compactK := Geometry.zeroCompact, exactOutside := formExactOutside] \as FormSupported;
\definition value: Geometry.Carrier := Supported.value;
\definition formValue: Geometry.Carrier := FormSupported.value;
\definition totalSelection[k: N.Nat^]: Parity.NativeChoice k := (selection k).first;
\import Factors.With[totalSelection := totalSelection] \as Exterior;
\definition exteriorData: Parity.Data := Exterior.data;
\definition firstEven: Models.Bundle := Exterior.firstEvenModel firstDegree;
\definition firstOdd: Models.Bundle := Exterior.firstOddModel firstDegree;
\definition secondEven: Models.Bundle := Exterior.secondEvenModel secondDegree;
\definition secondOdd: Models.Bundle := Exterior.secondOddModel secondDegree;
\module Restriction(Y: \Set, source: topology.Topology[Carrier := Y].Topology, f: Y -> Geometry.Total,
  regular: topology.Continuity[A := Y, B := Geometry.Total].Continuous source Geometry.topology f);
