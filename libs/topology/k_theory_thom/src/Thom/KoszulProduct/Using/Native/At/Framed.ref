\import \root.Thom[].MixedFrames[V := Factors.FirstFiber z, W := Factors.SecondFiber z,
  leftSpace := Factors.leftBundle.space z, rightSpace := Factors.rightBundle.space z,
  n := firstRank, m := secondRank, first := first, second := second] \as Frame;
\definition zeroAbove: \forall (omega: Raw.Term degree z) -> omega = ((Raw.term degree).space z).zero := Raw.Exact[x := z].zeroAbove Indices.total Frame.frame degree large;
\definition formsZeroAbove: \forall (omega: Raw.Form degree z) -> omega = ((Raw.forms degree).space z).zero :=
  \fun (omega: Raw.Form degree z) => \root.Thom[].Algebra[V := Primal.Fiber z, space := Raw.sum.space z].InCoordinates[n := Indices.total, frame := Frame.frame].Above[k := degree].vanishes omega large;
