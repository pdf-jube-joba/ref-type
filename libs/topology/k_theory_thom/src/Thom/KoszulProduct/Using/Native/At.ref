\definition firstRank: N.Nat^ := LeftOriginal.rank (Geometry.first z).base;
\definition secondRank: N.Nat^ := RightOriginal.rank (Geometry.second z).base;
\import Fin.Sum[m := firstRank, n := secondRank] \as Indices;
\definition firstLarge: Naturals.Lt firstRank firstDegree := Naturals.leLtTrans firstRank firstData.bound firstDegree (firstData.rankBound (Geometry.first z).base) First.aboveBound;
\definition secondLarge: Naturals.Lt secondRank secondDegree := Naturals.leLtTrans secondRank secondData.bound secondDegree (secondData.rankBound (Geometry.second z).base) Second.aboveBound;
\definition large: Naturals.Lt Indices.total degree :=
  \idelim Nat.add secondDegree firstDegree = degree \with cap: N.Nat^ => Naturals.Lt Indices.total cap \by {
    base: Order.ltAdd secondRank secondDegree firstRank firstDegree secondLarge firstLarge,
    equality: Naturals.addComm secondDegree firstDegree
  };
\module Framed(first: LeftOriginal.Frame firstRank (Geometry.first z).base, second: RightOriginal.Frame secondRank (Geometry.second z).base);
\definition zeroAbove: \forall (omega: Raw.Term degree z) -> omega = ((Raw.term degree).space z).zero := \block {
  \takefrom first: LeftOriginal.Frame firstRank (Geometry.first z).base \by \bysub(N.Nat^, LeftOriginal.RankAt (Geometry.first z).base, LeftOriginal.rank (Geometry.first z).base) \then
  \takefrom second: RightOriginal.Frame secondRank (Geometry.second z).base \by \bysub(N.Nat^, RightOriginal.RankAt (Geometry.second z).base, RightOriginal.rank (Geometry.second z).base) \then
  \return Framed[first := first, second := second].zeroAbove
};
\definition formsZeroAbove: \forall (omega: Raw.Form degree z) -> omega = ((Raw.forms degree).space z).zero := \block {
  \takefrom first: LeftOriginal.Frame firstRank (Geometry.first z).base \by \bysub(N.Nat^, LeftOriginal.RankAt (Geometry.first z).base, LeftOriginal.rank (Geometry.first z).base) \then
  \takefrom second: RightOriginal.Frame secondRank (Geometry.second z).base \by \bysub(N.Nat^, RightOriginal.RankAt (Geometry.second z).base, RightOriginal.rank (Geometry.second z).base) \then
  \return Framed[first := first, second := second].formsZeroAbove
};
