\import Operations.IsomorphismComposition[X := Geometry.sumTotal, F := Models.Fiber (pulledEven n).ranks,
  G := Models.Fiber (foldedEven n).ranks, H := Models.Fiber (targetEven n).ranks,
  source := Models.bundle (pulledEven n), middle := Models.bundle (foldedEven n), target := Models.bundle (targetEven n)] \as Even;
\import Operations.IsomorphismComposition[X := Geometry.sumTotal, F := Models.Fiber (pulledOdd n).ranks,
  G := Models.Fiber (foldedOdd n).ranks, H := Models.Fiber (targetOdd n).ranks,
  source := Models.bundle (pulledOdd n), middle := Models.bundle (foldedOdd n), target := Models.bundle (targetOdd n)] \as Odd;
\definition even: Finite.Iso (pulledEven n) (targetEven n) := Even.compose (Rebase.value n).even (Comparison.value n).even;
\definition odd: Finite.Iso (pulledOdd n) (targetOdd n) := Odd.compose (Rebase.value n).odd (Comparison.value n).odd;
\definition forward: \forall (p: Geometry.sumTotal)(v: SourceModels.Fiber (originalEven n).ranks (Geometry.inclusion p)) ->
  ((Comparison.targetParity n).forward.fiber p).apply ((even.forward.fiber p).apply v) =
    (odd.forward.fiber p).apply (((Rebase.sourceParity n).forward.fiber (Geometry.inclusion p)).apply v) :=
  \fun (p: Geometry.sumTotal)(v: SourceModels.Fiber (originalEven n).ranks (Geometry.inclusion p)) => trans!{{Models.Fiber (targetOdd n).ranks p}} _ _ _
    ((Comparison.value n).forward p (((Rebase.value n).even.forward.fiber p).apply v))
    (congr!{{Models.Fiber (foldedOdd n).ranks p} {Models.Fiber (targetOdd n).ranks p}} ((Comparison.value n).odd.forward.fiber p).apply _ _ ((Rebase.value n).forward p v));
\definition backward: \forall (p: Geometry.sumTotal)(v: SourceModels.Fiber (originalOdd n).ranks (Geometry.inclusion p)) ->
  ((Comparison.targetParity n).backward.fiber p).apply ((odd.forward.fiber p).apply v) =
    (even.forward.fiber p).apply (((Rebase.sourceParity n).backward.fiber (Geometry.inclusion p)).apply v) :=
  \fun (p: Geometry.sumTotal)(v: SourceModels.Fiber (originalOdd n).ranks (Geometry.inclusion p)) => trans!{{Models.Fiber (targetEven n).ranks p}} _ _ _
    ((Comparison.value n).backward p (((Rebase.value n).odd.forward.fiber p).apply v))
    (congr!{{Models.Fiber (foldedEven n).ranks p} {Models.Fiber (targetEven n).ranks p}} ((Comparison.value n).even.forward.fiber p).apply _ _ ((Rebase.value n).backward p v));
