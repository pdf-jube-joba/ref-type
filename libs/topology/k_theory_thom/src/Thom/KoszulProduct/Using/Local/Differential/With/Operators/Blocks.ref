\definition forward[v: Original.OriginalEven p]:
  (Contraction.forward.fiber (g p)).apply ((toGlobalEven.forward.fiber p).apply v) =
    (toGlobalOdd.forward.fiber p).apply ((Raw.dGlobal.fiber p).apply v) :=
  trans!{{GlobalParity.Odd (g p)}} _ _ _
    (congr!{{GlobalParity.Even (g p)} {GlobalParity.Odd (g p)}} (Contraction.forward.fiber (g p)).apply _ _ (ParityPull.inverseEven p ((Change.evenIso.forward.fiber p).apply v)))
    (trans!{{GlobalParity.Odd (g p)}} _ _ _ (sym!{{GlobalParity.Odd (g p)}} _ _ (EvenBlocks.equation p v))
      (sym!{{GlobalParity.Odd (g p)}} _ _ (ParityPull.inverseOdd p ((Change.oddIso.forward.fiber p).apply ((Raw.dGlobal.fiber p).apply v)))));
\definition backward[v: Original.OriginalOdd p]:
  (Contraction.backward.fiber (g p)).apply ((toGlobalOdd.forward.fiber p).apply v) =
    (toGlobalEven.forward.fiber p).apply ((Raw.eGlobal.fiber p).apply v) :=
  trans!{{GlobalParity.Even (g p)}} _ _ _
    (congr!{{GlobalParity.Odd (g p)} {GlobalParity.Even (g p)}} (Contraction.backward.fiber (g p)).apply _ _ (ParityPull.inverseOdd p ((Change.oddIso.forward.fiber p).apply v)))
    (trans!{{GlobalParity.Even (g p)}} _ _ _ (sym!{{GlobalParity.Even (g p)}} _ _ (OddBlocks.equation p v))
      (sym!{{GlobalParity.Even (g p)}} _ _ (ParityPull.inverseEven p ((Change.evenIso.forward.fiber p).apply ((Raw.eGlobal.fiber p).apply v)))));
