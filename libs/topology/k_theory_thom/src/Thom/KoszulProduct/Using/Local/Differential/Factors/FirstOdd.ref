\definition original: FirstModels.Bundle := GlobalFrame.firstOriginalOdd firstDegree;
\import FirstBridge[b := original] \as Bridge;
\import Complements.PulledIsomorphism[X := Geometry.Total, Y := Product.Z,
  F := GlobalModels.Fiber (GlobalFrame.firstPulledOdd firstDegree).ranks, G := GlobalModels.Fiber globalFirstOdd.ranks,
  source := GlobalModels.bundle (GlobalFrame.firstPulledOdd firstDegree), target := GlobalModels.bundle globalFirstOdd,
  base := Product.topology, f := g, sourceRegular := gContinuous, targetRegular := gContinuous] \as Pull;
\import Global.At[n := firstDegree, m := secondDegree] \as Sectors;
\import Operations.IsomorphismComposition[X := Product.Z, F := OriginalBundles.FirstOdd,
  G := Bridge.Vector, H := Models.Fiber firstOddOnDisk.ranks,
  source := OriginalBundles.FirstOddBundle, middle := Bridge.targetBundle, target := Models.bundle firstOddOnDisk] \as Compose;
\definition isomorphism: Compose.Isomorphism := Compose.compose Bridge.isomorphism (Pull.isomorphism Sectors.firstOdd);
