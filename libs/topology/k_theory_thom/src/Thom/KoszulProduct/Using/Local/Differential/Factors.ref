\import Operations.Models[X := LeftKoszul.Total, baseSpace := left.totalSpace] \as FirstModels;
\import Operations.Models[X := RightKoszul.Total, baseSpace := right.totalSpace] \as SecondModels;
\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := Scalars.scalar] \as Complements;
\module FirstBridge(b: FirstModels.Bundle);
\module SecondBridge(b: SecondModels.Bundle);
\module FirstEven;
\module FirstOdd;
\module SecondEven;
\module SecondOdd;
\definition firstEven: Bundles.Isomorphisms[X := Product.Z, F := OriginalBundles.FirstEven, G := Models.Fiber firstEvenOnDisk.ranks,
  source := OriginalBundles.FirstEvenBundle, target := Models.bundle firstEvenOnDisk].Isomorphism := FirstEven[].isomorphism;
\definition firstOdd: Bundles.Isomorphisms[X := Product.Z, F := OriginalBundles.FirstOdd, G := Models.Fiber firstOddOnDisk.ranks,
  source := OriginalBundles.FirstOddBundle, target := Models.bundle firstOddOnDisk].Isomorphism := FirstOdd[].isomorphism;
\definition secondEven: Bundles.Isomorphisms[X := Product.Z, F := OriginalBundles.SecondEven, G := Models.Fiber secondEvenOnDisk.ranks,
  source := OriginalBundles.SecondEvenBundle, target := Models.bundle secondEvenOnDisk].Isomorphism := SecondEven[].isomorphism;
\definition secondOdd: Bundles.Isomorphisms[X := Product.Z, F := OriginalBundles.SecondOdd, G := Models.Fiber secondOddOnDisk.ranks,
  source := OriginalBundles.SecondOddBundle, target := Models.bundle secondOddOnDisk].Isomorphism := SecondOdd[].isomorphism;
\module Operators;
\definition firstD: Models.Map firstEvenOnDisk firstOddOnDisk := Operators[].firstD;
\definition firstE: Models.Map firstOddOnDisk firstEvenOnDisk := Operators[].firstE;
\definition secondD: Models.Map secondEvenOnDisk secondOddOnDisk := Operators[].secondD;
\definition secondE: Models.Map secondOddOnDisk secondEvenOnDisk := Operators[].secondE;
\definition firstForward: \forall (p: Product.Z)(v: OriginalBundles.FirstEven p) ->
  (firstD.fiber p).apply ((firstEven.forward.fiber p).apply v) = (firstOdd.forward.fiber p).apply ((Raw.firstd.fiber p).apply v) := Operators[].firstForward;
\definition firstBackward: \forall (p: Product.Z)(v: OriginalBundles.FirstOdd p) ->
  (firstE.fiber p).apply ((firstOdd.forward.fiber p).apply v) = (firstEven.forward.fiber p).apply ((Raw.firste.fiber p).apply v) := Operators[].firstBackward;
\definition secondForward: \forall (p: Product.Z)(v: OriginalBundles.SecondEven p) ->
  (secondD.fiber p).apply ((secondEven.forward.fiber p).apply v) = (secondOdd.forward.fiber p).apply ((Raw.secondd.fiber p).apply v) := Operators[].secondForward;
\definition secondBackward: \forall (p: Product.Z)(v: OriginalBundles.SecondOdd p) ->
  (secondE.fiber p).apply ((secondOdd.forward.fiber p).apply v) = (secondEven.forward.fiber p).apply ((Raw.seconde.fiber p).apply v) := Operators[].secondBackward;
