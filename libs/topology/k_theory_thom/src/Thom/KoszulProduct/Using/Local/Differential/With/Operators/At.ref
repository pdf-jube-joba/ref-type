\import std.Data[].Pair[] \as P;
\definition first[v: Source.LeftFiber p]:
  (Change.firstIso.forward.fiber p).apply ((c.sourceFirst.fiber p).apply v) = (c.targetFirst.fiber p).apply ((Change.firstIso.forward.fiber p).apply v) :=
  P.Prop[A := Models.Fiber firstEvenOnDisk.ranks p, B := Models.Fiber firstOddOnDisk.ranks p].pairCong _ _ _ _
    (sym!{{Models.Fiber firstEvenOnDisk.ranks p}} _ _ (Factors.firstBackward p (P.second (OriginalBundles.FirstEven p) (OriginalBundles.FirstOdd p) v)))
    (sym!{{Models.Fiber firstOddOnDisk.ranks p}} _ _ (Factors.firstForward p (P.first (OriginalBundles.FirstEven p) (OriginalBundles.FirstOdd p) v)));
\definition second[v: Source.RightFiber p]:
  (Change.secondIso.forward.fiber p).apply ((c.sourceSecond.fiber p).apply v) = (c.targetSecond.fiber p).apply ((Change.secondIso.forward.fiber p).apply v) :=
  P.Prop[A := Models.Fiber secondEvenOnDisk.ranks p, B := Models.Fiber secondOddOnDisk.ranks p].pairCong _ _ _ _
    (sym!{{Models.Fiber secondEvenOnDisk.ranks p}} _ _ (Factors.secondBackward p (P.second (OriginalBundles.SecondEven p) (OriginalBundles.SecondOdd p) v)))
    (sym!{{Models.Fiber secondOddOnDisk.ranks p}} _ _ (Factors.secondForward p (P.first (OriginalBundles.SecondEven p) (OriginalBundles.SecondOdd p) v)));
\import Spaces.Linear[V := OriginalBundles.FirstOdd p, W := Models.Fiber firstOddOnDisk.ranks p,
  source := OriginalBundles.FirstOddBundle.space p, target := (Models.bundle firstOddOnDisk).space p].Operations[] \as OddMaps;
\definition grading[v: Source.LeftFiber p]:
  (Change.firstIso.forward.fiber p).apply ((c.sourceGrading.fiber p).apply v) = (c.targetGrading.fiber p).apply ((Change.firstIso.forward.fiber p).apply v) :=
  trans!{{Target.LeftFiber p}} _ _ _
    (congr!{{Source.LeftFiber p} {Target.LeftFiber p}} (Change.firstIso.forward.fiber p).apply _ _ (SourceGrading.leftFormula p v))
    (trans!{{Target.LeftFiber p}} _ _ _
      (P.Prop[A := Models.Fiber firstEvenOnDisk.ranks p, B := Models.Fiber firstOddOnDisk.ranks p].pairCong _ _ _ _
        (\refl((Factors.firstEven.forward.fiber p).apply (P.first (OriginalBundles.FirstEven p) (OriginalBundles.FirstOdd p) v)))
        (OddMaps.preservesNeg (Factors.firstOdd.forward.fiber p) (P.second (OriginalBundles.FirstEven p) (OriginalBundles.FirstOdd p) v)))
      (sym!{{Target.LeftFiber p}} _ _ (TargetGrading.leftFormula p ((Change.firstIso.forward.fiber p).apply v))));
