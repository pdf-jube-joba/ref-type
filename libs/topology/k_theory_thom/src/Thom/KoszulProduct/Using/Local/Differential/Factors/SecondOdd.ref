\definition original: SecondModels.Bundle := GlobalFrame.secondOriginalOdd secondDegree;
\import \parent.SecondBridge[b := original] \as Bridge;
\import Complements.PulledIsomorphism[X := Geometry.Total, Y := Product.Z,
  F := GlobalModels.Fiber (GlobalFrame.secondPulledOdd secondDegree).ranks, G := GlobalModels.Fiber globalSecondOdd.ranks,
  source := GlobalModels.bundle (GlobalFrame.secondPulledOdd secondDegree), target := GlobalModels.bundle globalSecondOdd,
  base := Product.topology, f := g, sourceRegular := gContinuous, targetRegular := gContinuous] \as Pull;
\import Global.At[n := firstDegree, m := secondDegree] \as Sectors;
\import Operations.IsomorphismComposition[X := Product.Z, F := OriginalBundles.SecondOdd,
  G := Bridge.Vector, H := Models.Fiber secondOddOnDisk.ranks,
  source := OriginalBundles.SecondOddBundle, middle := Bridge.targetBundle, target := Models.bundle secondOddOnDisk] \as Compose;
\definition isomorphism: Compose.Isomorphism := Compose.compose Bridge.isomorphism (Pull.isomorphism Sectors.secondOdd);
