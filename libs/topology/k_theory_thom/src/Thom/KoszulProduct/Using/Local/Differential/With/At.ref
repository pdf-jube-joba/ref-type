\import \parent.Operators[] \as Operators;
\definition forward[v: Original.OriginalEven p]:
  (Chain.parity.forward.fiber p).apply ((positive.forward.fiber p).apply v) = (negative.forward.fiber p).apply ((Raw.dGlobal.fiber p).apply v) :=
  trans!{{Models.Fiber Restricted.odd.ranks p}} _ _ _ (Restricted.forward p ((throughEven.forward.fiber p).apply v))
    (trans!{{Models.Fiber Restricted.odd.ranks p}} _ _ _
      (congr!{{GlobalModels.Fiber globalOdd.ranks (g p)} {Models.Fiber Restricted.odd.ranks p}} (Restricted.negative.forward.fiber p).apply _ _
        (Differential.Fold[x := g p].even ((toGlobalEven.forward.fiber p).apply v)))
      (congr!{{GlobalParity.Odd (g p)} {Models.Fiber Restricted.odd.ranks p}}
        (\fun (w: GlobalParity.Odd (g p)) => (Restricted.negative.forward.fiber p).apply ((pulledOdd.forward.fiber p).apply w)) _ _ (Operators.forward p v)));
\definition backward[v: Original.OriginalOdd p]:
  (Chain.parity.backward.fiber p).apply ((negative.forward.fiber p).apply v) = (positive.forward.fiber p).apply ((Raw.eGlobal.fiber p).apply v) :=
  trans!{{Models.Fiber Restricted.even.ranks p}} _ _ _ (Restricted.backward p ((throughOdd.forward.fiber p).apply v))
    (trans!{{Models.Fiber Restricted.even.ranks p}} _ _ _
      (congr!{{GlobalModels.Fiber globalEven.ranks (g p)} {Models.Fiber Restricted.even.ranks p}} (Restricted.positive.forward.fiber p).apply _ _
        (Differential.Fold[x := g p].odd ((toGlobalOdd.forward.fiber p).apply v)))
      (congr!{{GlobalParity.Even (g p)} {Models.Fiber Restricted.even.ranks p}}
        (\fun (w: GlobalParity.Even (g p)) => (Restricted.positive.forward.fiber p).apply ((pulledEven.forward.fiber p).apply w)) _ _ (Operators.backward p v)));
