\import Complements.PulledIsomorphism[X := Geometry.Total, Y := Product.Z,
  F := GlobalModels.Fiber (GlobalFrame.secondPulledEven secondDegree).ranks, G := GlobalModels.Fiber globalSecondEven.ranks,
  source := GlobalModels.bundle (GlobalFrame.secondPulledEven secondDegree), target := GlobalModels.bundle globalSecondEven,
  base := Product.topology, f := g, sourceRegular := gContinuous, targetRegular := gContinuous] \as Pull;
\import Global.At[n := firstDegree, m := secondDegree] \as Sectors;
