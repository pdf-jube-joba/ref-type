\import Rectangle.Diagram[] \as Diagram;
\import Relative.Smash[left := LeftFor.Supported.model, right := RightFor.Supported.model] \as Smash;
\import algebraic_topology.Pointed[A := Geometry.model.Carrier].Maps[B := Geometry.externalModel.Carrier] \as Maps;
\definition atInfinity: Diagram.globalMap Geometry.Points.point = Geometry.toSmash Geometry.Points.point :=
  trans!{{Geometry.externalModel.Carrier}} _ _ _
    (Maps.laws (Relative.pointed Geometry.model) (Relative.pointed Geometry.externalModel) Diagram.globalMap).pointed
    (sym!{{Geometry.externalModel.Carrier}} _ _
      (Maps.laws (Relative.pointed Geometry.model) (Relative.pointed Geometry.externalModel) Geometry.toSmash).pointed);
\definition onFinite: \forall (p: Geometry.Total) -> Diagram.globalMap (Geometry.Points.inclusion p) = Geometry.toSmash (Geometry.Points.inclusion p) :=
  \fun (p: Geometry.Total) => trans!{{Geometry.externalModel.Carrier}} _ _ _ (Diagram.globalOnFinite p)
    (sym!{{Geometry.externalModel.Carrier}} _ _ (Geometry.onFinite p));
\definition mappingEquation: Diagram.globalMap = Geometry.toSmash :=
  \axiom:funext(Diagram.globalMap, Geometry.toSmash,
    \induction (p: Geometry.model.Carrier) \return Diagram.globalMap p = Geometry.toSmash p \with {
      | none: atInfinity
      | some: onFinite
    });
\definition equation: Localization.external = Geometry.external First.thom Second.thom :=
  congr!{{Relative.Map Geometry.model Geometry.externalModel} {Geometry.Carrier}}
    (\fun (f: Relative.Map Geometry.model Geometry.externalModel) =>
      Relative.Pullback[source := Geometry.model, target := Geometry.externalModel, f := f].map
        (Smash.External[].product First.thom Second.thom)) _ _ mappingEquation;
