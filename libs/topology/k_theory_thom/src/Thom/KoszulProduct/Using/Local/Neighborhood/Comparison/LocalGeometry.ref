\import Bundles.Family[X := Geometry.Total, F := First.Even].Of[bundle := Models.bundle First.even].PullbackComposition[
  Y := Actual.Carrier, Z := Product.Z, first := Actual.topology, second := Product.topology, f := Actual.inclusion, g := map]
  .Of[fRegular := Actual.regular, gRegular := continuous] \as POriginal;
\import Bundles.Isomorphisms[X := Product.Z, F := (\fun (p: Product.Z) => First.Even (g p)),
  G := (\fun (p: Product.Z) => First.Even (g p)), source := POriginal.direct, target := POriginal.nested] \as PReverse;
\import Operations.IsomorphismComposition[X := Product.Z, F := (\fun (p: Product.Z) => First.Even (g p)),
  G := (\fun (p: Product.Z) => First.Even (g p)), H := Second.Even,
  source := ProductPair.BundleModel[F := Triples.FirstFiber].bundle Triples.firstModelOnSource,
  middle := POriginal.direct, target := ProductPair.BundleModel[F := Second.Even].bundle RC.firstModel] \as PFinish;
\definition positive: Bundles.Isomorphisms[X := Product.Z, F := (\fun (p: Product.Z) => First.Even (g p)), G := Second.Even,
  source := ProductPair.BundleModel[F := Triples.FirstFiber].bundle Triples.firstModelOnSource,
  target := ProductPair.BundleModel[F := Second.Even].bundle RC.firstModel].Isomorphism :=
  PFinish.compose (PReverse.inverse POriginal.isomorphism) originalPositive;
\import Bundles.Family[X := Geometry.Total, F := First.Odd].Of[bundle := Models.bundle First.odd].PullbackComposition[
  Y := Actual.Carrier, Z := Product.Z, first := Actual.topology, second := Product.topology, f := Actual.inclusion, g := map]
  .Of[fRegular := Actual.regular, gRegular := continuous] \as QOriginal;
\import Bundles.Isomorphisms[X := Product.Z, F := (\fun (p: Product.Z) => First.Odd (g p)),
  G := (\fun (p: Product.Z) => First.Odd (g p)), source := QOriginal.direct, target := QOriginal.nested] \as QReverse;
\import Operations.IsomorphismComposition[X := Product.Z, F := (\fun (p: Product.Z) => First.Odd (g p)),
  G := (\fun (p: Product.Z) => First.Odd (g p)), H := Second.Odd,
  source := ProductPair.BundleModel[F := Triples.SecondFiber].bundle Triples.secondModelOnSource,
  middle := QOriginal.direct, target := ProductPair.BundleModel[F := Second.Odd].bundle RC.secondModel] \as QFinish;
\definition negative: Bundles.Isomorphisms[X := Product.Z, F := (\fun (p: Product.Z) => First.Odd (g p)), G := Second.Odd,
  source := ProductPair.BundleModel[F := Triples.SecondFiber].bundle Triples.secondModelOnSource,
  target := ProductPair.BundleModel[F := Second.Odd].bundle RC.secondModel].Isomorphism :=
  QFinish.compose (QReverse.inverse QOriginal.isomorphism) originalNegative;
