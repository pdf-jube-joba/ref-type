\import Bundles.Family[X := LeftKoszul.Total, F := FirstModels.Fiber b.ranks].Of[bundle := FirstModels.bundle b]
  .PullbackComposition[Y := FirstFold.Disk, Z := Product.Z, first := FirstFold.diskTopology, second := Product.topology, f := FirstFold.inclusion, g := Product.first]
  .Of[fRegular := FirstFold.regular, gRegular := (LocalCartesian.Maps[].firstContinuous FirstFold.diskTopology SecondFold.diskTopology)] \as Old;
\import Bundles.Family[X := LeftKoszul.Total, F := FirstModels.Fiber b.ranks].Of[bundle := FirstModels.bundle b]
  .PullbackComposition[Y := Geometry.Total, Z := Product.Z, first := Geometry.topology, second := Product.topology, f := Geometry.first, g := g]
  .Of[fRegular := Geometry.firstRegular, gRegular := gContinuous] \as New;
\definition Vector[p: Product.Z]: \Set := FirstModels.Fiber b.ranks (FirstFold.inclusion (Product.first p));
\definition sourceBundle: Bundles.Family[X := Product.Z, F := Vector].Bundle := Old.nested;
\definition targetBundle: Bundles.Family[X := Product.Z, F := Vector].Bundle := New.nested;
\import Bundles.Isomorphisms[X := Product.Z, F := Vector, G := Vector, source := Old.direct, target := Old.nested] \as Reverse;
\import Operations.IsomorphismComposition[X := Product.Z, F := Vector, G := Vector, H := Vector,
  source := sourceBundle, middle := Old.direct, target := targetBundle] \as Compose;
\definition isomorphism: Compose.Isomorphism := Compose.compose (Reverse.inverse Old.isomorphism) New.isomorphism;
\definition onFiber: \forall (p: Product.Z)(v: Vector p) -> (isomorphism.forward.fiber p).apply v = v := \fun (p: Product.Z)(v: Vector p) => \refl(v);
