\import Bundles.Family[X := Geometry.Total, F := First.Even].Of[bundle := Models.bundle First.even].PullbackComposition[
  Y := ActualPair.A, Z := ProductPair.A, first := ActualPair.subspace, second := ProductPair.subspace, f := In.boundaryInclusion, g := boundary]
  .Of[fRegular := In.boundaryRegular, gRegular := boundaryRegular] \as POriginal;
\import Bundles.Family[X := Geometry.Total, F := First.Even].Of[bundle := Models.bundle First.even].PullbackComposition[
  Y := Product.Z, Z := ProductPair.A, first := Product.topology, second := ProductPair.subspace, f := g, g := RC.inclusion]
  .Of[fRegular := gContinuous, gRegular := RC.inclusionContinuous] \as PGlobal;
\import Complements.PulledIsomorphism[X := Product.Z, Y := ProductPair.A, F := (\fun (y: Product.Z) => First.Even (g y)), G := Second.Even,
  source := TargetModels.bundle Positive.value, target := TargetModels.bundle Second.even, base := ProductPair.subspace,
  f := RC.inclusion, sourceRegular := RC.inclusionContinuous, targetRegular := RC.inclusionContinuous] \as PPull;
\import Bundles.Isomorphisms[X := ProductPair.A, F := (\fun (z: ProductPair.A) => First.Even (g z)),
  G := (\fun (z: ProductPair.A) => First.Even (g z)), source := POriginal.direct, target := POriginal.nested] \as PReverse;
\import Operations.IsomorphismComposition[X := ProductPair.A, F := (\fun (z: ProductPair.A) => First.Even (g z)),
  G := (\fun (z: ProductPair.A) => First.Even (g z)), H := (\fun (z: ProductPair.A) => First.Even (g z)),
  source := Operations.Models[X := ProductPair.A, baseSpace := ProductPair.subspace].bundle OldPositive.value, middle := POriginal.direct, target := PGlobal.nested] \as PStart;
\definition pStart: PStart.Isomorphism := PStart.compose (PReverse.inverse POriginal.isomorphism) PGlobal.isomorphism;
\import Operations.IsomorphismComposition[X := ProductPair.A, F := (\fun (z: ProductPair.A) => First.Even (g z)),
  G := (\fun (z: ProductPair.A) => First.Even (g z)), H := (\fun (z: ProductPair.A) => Second.Even z),
  source := Operations.Models[X := ProductPair.A, baseSpace := ProductPair.subspace].bundle OldPositive.value, middle := PGlobal.nested, target := Operations.Models[X := ProductPair.A, baseSpace := ProductPair.subspace].bundle BoundaryPositive.value] \as PFinish;
\definition positive: Bundles.Isomorphisms[X := ProductPair.A, F := (\fun (z: ProductPair.A) => First.Even (g z)), G := (\fun (z: ProductPair.A) => Second.Even z),
  source := Operations.Models[X := ProductPair.A, baseSpace := ProductPair.subspace].bundle OldPositive.value, target := Operations.Models[X := ProductPair.A, baseSpace := ProductPair.subspace].bundle BoundaryPositive.value].Isomorphism := PFinish.compose pStart (PPull.isomorphism originalPositive);
\import Bundles.Family[X := Geometry.Total, F := First.Odd].Of[bundle := Models.bundle First.odd].PullbackComposition[
  Y := ActualPair.A, Z := ProductPair.A, first := ActualPair.subspace, second := ProductPair.subspace, f := In.boundaryInclusion, g := boundary]
  .Of[fRegular := In.boundaryRegular, gRegular := boundaryRegular] \as QOriginal;
\import Bundles.Family[X := Geometry.Total, F := First.Odd].Of[bundle := Models.bundle First.odd].PullbackComposition[
  Y := Product.Z, Z := ProductPair.A, first := Product.topology, second := ProductPair.subspace, f := g, g := RC.inclusion]
  .Of[fRegular := gContinuous, gRegular := RC.inclusionContinuous] \as QGlobal;
\import Complements.PulledIsomorphism[X := Product.Z, Y := ProductPair.A, F := (\fun (y: Product.Z) => First.Odd (g y)), G := Second.Odd,
  source := TargetModels.bundle Negative.value, target := TargetModels.bundle Second.odd, base := ProductPair.subspace,
  f := RC.inclusion, sourceRegular := RC.inclusionContinuous, targetRegular := RC.inclusionContinuous] \as QPull;
\import Bundles.Isomorphisms[X := ProductPair.A, F := (\fun (z: ProductPair.A) => First.Odd (g z)),
  G := (\fun (z: ProductPair.A) => First.Odd (g z)), source := QOriginal.direct, target := QOriginal.nested] \as QReverse;
\import Operations.IsomorphismComposition[X := ProductPair.A, F := (\fun (z: ProductPair.A) => First.Odd (g z)),
  G := (\fun (z: ProductPair.A) => First.Odd (g z)), H := (\fun (z: ProductPair.A) => First.Odd (g z)),
  source := Operations.Models[X := ProductPair.A, baseSpace := ProductPair.subspace].bundle OldNegative.value, middle := QOriginal.direct, target := QGlobal.nested] \as QStart;
\definition qStart: QStart.Isomorphism := QStart.compose (QReverse.inverse QOriginal.isomorphism) QGlobal.isomorphism;
\import Operations.IsomorphismComposition[X := ProductPair.A, F := (\fun (z: ProductPair.A) => First.Odd (g z)),
  G := (\fun (z: ProductPair.A) => First.Odd (g z)), H := (\fun (z: ProductPair.A) => Second.Odd z),
  source := Operations.Models[X := ProductPair.A, baseSpace := ProductPair.subspace].bundle OldNegative.value, middle := QGlobal.nested, target := Operations.Models[X := ProductPair.A, baseSpace := ProductPair.subspace].bundle BoundaryNegative.value] \as QFinish;
\definition negative: Bundles.Isomorphisms[X := ProductPair.A, F := (\fun (z: ProductPair.A) => First.Odd (g z)), G := (\fun (z: ProductPair.A) => Second.Odd z),
  source := Operations.Models[X := ProductPair.A, baseSpace := ProductPair.subspace].bundle OldNegative.value, target := Operations.Models[X := ProductPair.A, baseSpace := ProductPair.subspace].bundle BoundaryNegative.value].Isomorphism := QFinish.compose qStart (QPull.isomorphism originalNegative);
\definition commutesD: \forall (x: ProductPair.A)(v: First.Even (g x)) ->
  ((TargetD.map Second.d).fiber x).apply ((positive.forward.fiber x).apply v) =
  (negative.forward.fiber x).apply (((OldD.map (OriginalD.map First.d)).fiber x).apply v) :=
  \fun (x: ProductPair.A)(v: First.Even (g x)) => originalCommutesD x v;
\definition commutesE: \forall (x: ProductPair.A)(v: First.Odd (g x)) ->
  ((TargetE.map Second.e).fiber x).apply ((negative.forward.fiber x).apply v) =
  (positive.forward.fiber x).apply (((OldE.map (OriginalE.map First.e)).fiber x).apply v) :=
  \fun (x: ProductPair.A)(v: First.Odd (g x)) => originalCommutesE x v;
