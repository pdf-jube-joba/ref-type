\definition original: FirstModels.Bundle := GlobalFrame.firstOriginalEven firstDegree;
\import \parent.FirstBridge[b := original] \as Bridge;
\import Complements.PulledIsomorphism[X := Geometry.Total, Y := Product.Z,
  F := GlobalModels.Fiber (GlobalFrame.firstPulledEven firstDegree).ranks, G := GlobalModels.Fiber globalFirstEven.ranks,
  source := GlobalModels.bundle (GlobalFrame.firstPulledEven firstDegree), target := GlobalModels.bundle globalFirstEven,
  base := Product.topology, f := g, sourceRegular := gContinuous, targetRegular := gContinuous] \as Pull;
\import Global.At[n := firstDegree, m := secondDegree] \as Sectors;
\import Operations.IsomorphismComposition[X := Product.Z, F := OriginalBundles.FirstEven,
  G := Bridge.Vector, H := Models.Fiber firstEvenOnDisk.ranks,
  source := OriginalBundles.FirstEvenBundle, middle := Bridge.targetBundle, target := Models.bundle firstEvenOnDisk] \as Compose;
\definition isomorphism: Compose.Isomorphism := Compose.compose Bridge.isomorphism (Pull.isomorphism Sectors.firstEven);
