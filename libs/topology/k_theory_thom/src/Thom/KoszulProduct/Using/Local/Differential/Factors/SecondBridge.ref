\import Bundles.Family[X := RightKoszul.Total, F := SecondModels.Fiber b.ranks].Of[bundle := SecondModels.bundle b]
  .PullbackComposition[Y := SecondFold.Disk, Z := Product.Z, first := SecondFold.diskTopology, second := Product.topology, f := SecondFold.inclusion, g := Product.second]
  .Of[fRegular := SecondFold.regular, gRegular := (LocalCartesian.Maps[].secondContinuous FirstFold.diskTopology SecondFold.diskTopology)] \as Old;
\import Bundles.Family[X := RightKoszul.Total, F := SecondModels.Fiber b.ranks].Of[bundle := SecondModels.bundle b]
  .PullbackComposition[Y := Geometry.Total, Z := Product.Z, first := Geometry.topology, second := Product.topology, f := Geometry.second, g := g]
  .Of[fRegular := Geometry.secondRegular, gRegular := gContinuous] \as New;
\definition Vector[p: Product.Z]: \Set := SecondModels.Fiber b.ranks (SecondFold.inclusion (Product.second p));
\definition sourceBundle: Bundles.Family[X := Product.Z, F := Vector].Bundle := Old.nested;
\definition targetBundle: Bundles.Family[X := Product.Z, F := Vector].Bundle := New.nested;
\import Bundles.Isomorphisms[X := Product.Z, F := Vector, G := Vector, source := Old.direct, target := Old.nested] \as Reverse;
\import Operations.IsomorphismComposition[X := Product.Z, F := Vector, G := Vector, H := Vector,
  source := sourceBundle, middle := Old.direct, target := targetBundle] \as Compose;
\definition isomorphism: Compose.Isomorphism := Compose.compose (Reverse.inverse Old.isomorphism) New.isomorphism;
\definition onFiber: \forall (p: Product.Z)(v: Vector p) -> (isomorphism.forward.fiber p).apply v = v := \fun (p: Product.Z)(v: Vector p) => \refl(v);
