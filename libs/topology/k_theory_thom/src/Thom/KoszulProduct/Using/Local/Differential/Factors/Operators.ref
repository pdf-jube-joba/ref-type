\import GlobalModels.PullbackMap[p := globalFirstEven, q := globalFirstOdd, Y := Product.Z, source := Product.topology, f := g, regular := gContinuous] \as FirstD;
\import GlobalModels.PullbackMap[p := globalFirstOdd, q := globalFirstEven, Y := Product.Z, source := Product.topology, f := g, regular := gContinuous] \as FirstE;
\import GlobalModels.PullbackMap[p := globalSecondEven, q := globalSecondOdd, Y := Product.Z, source := Product.topology, f := g, regular := gContinuous] \as SecondD;
\import GlobalModels.PullbackMap[p := globalSecondOdd, q := globalSecondEven, Y := Product.Z, source := Product.topology, f := g, regular := gContinuous] \as SecondE;
\definition firstD: Models.Map firstEvenOnDisk firstOddOnDisk := FirstD.map globalFirstD;
\definition firstE: Models.Map firstOddOnDisk firstEvenOnDisk := FirstE.map globalFirstE;
\definition secondD: Models.Map secondEvenOnDisk secondOddOnDisk := SecondD.map globalSecondD;
\definition secondE: Models.Map secondOddOnDisk secondEvenOnDisk := SecondE.map globalSecondE;
\import Global.At[n := firstDegree, m := secondDegree] \as Sectors;
\definition firstForward: \forall (p: Product.Z)(v: OriginalBundles.FirstEven p) ->
  (firstD.fiber p).apply ((firstEven.forward.fiber p).apply v) = (firstOdd.forward.fiber p).apply ((Raw.firstd.fiber p).apply v) :=
  \fun (p: Product.Z)(v: OriginalBundles.FirstEven p) => Sectors.firstForward (g p) v;
\definition firstBackward: \forall (p: Product.Z)(v: OriginalBundles.FirstOdd p) ->
  (firstE.fiber p).apply ((firstOdd.forward.fiber p).apply v) = (firstEven.forward.fiber p).apply ((Raw.firste.fiber p).apply v) :=
  \fun (p: Product.Z)(v: OriginalBundles.FirstOdd p) => Sectors.firstBackward (g p) v;
\definition secondForward: \forall (p: Product.Z)(v: OriginalBundles.SecondEven p) ->
  (secondD.fiber p).apply ((secondEven.forward.fiber p).apply v) = (secondOdd.forward.fiber p).apply ((Raw.secondd.fiber p).apply v) :=
  \fun (p: Product.Z)(v: OriginalBundles.SecondEven p) => Sectors.secondForward (g p) v;
\definition secondBackward: \forall (p: Product.Z)(v: OriginalBundles.SecondOdd p) ->
  (secondE.fiber p).apply ((secondOdd.forward.fiber p).apply v) = (secondEven.forward.fiber p).apply ((Raw.seconde.fiber p).apply v) :=
  \fun (p: Product.Z)(v: OriginalBundles.SecondOdd p) => Sectors.secondBackward (g p) v;
