\import \parent.Bounds[] \as Bounds;
\import \parent.Factors[] \as Factors;
\import Mixed.Coordinates[evenChoice := evenChoice, oddChoice := oddChoice] \as Code;
\import Code.Isomorphisms[firstVanishing := Bounds.firstVanishing, secondVanishing := Bounds.secondVanishing] \as MixedIso;
\import Code.Differential[evenCutoff := Bounds.evenCutoff] \as Differential;
\import Differential.Factory[firstForward := Differential.firstOperator B.Bool^::true, firstBackward := Differential.firstOperator B.Bool^::false,
  secondForward := Differential.secondOperator B.Bool^::true, secondBackward := Differential.secondOperator B.Bool^::false] \as Contraction;
\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := Scalars.scalar] \as Complements;
\import \root.Thom[].ComplexProductParityPullback[X := Geometry.Total,
  F0 := GlobalModels.Fiber globalFirstEven.ranks, F1 := GlobalModels.Fiber globalFirstOdd.ranks,
  G0 := GlobalModels.Fiber globalSecondEven.ranks, G1 := GlobalModels.Fiber globalSecondOdd.ranks,
  e0 := GlobalModels.bundle globalFirstEven, e1 := GlobalModels.bundle globalFirstOdd, f0 := GlobalModels.bundle globalSecondEven, f1 := GlobalModels.bundle globalSecondOdd,
  sameE1 := (\refl(Geometry.topology)), sameF0 := (\refl(Geometry.topology)), sameF1 := (\refl(Geometry.topology)),
  Y := Product.Z, source := Product.topology, f := g, regular := gContinuous] \as ParityPull;
\import \root.Thom[].ParityNaturality[X := Product.Z,
  E0 := OriginalBundles.FirstEven, E1 := OriginalBundles.FirstOdd, F0 := OriginalBundles.SecondEven, F1 := OriginalBundles.SecondOdd,
  A0 := Models.Fiber firstEvenOnDisk.ranks, A1 := Models.Fiber firstOddOnDisk.ranks,
  B0 := Models.Fiber secondEvenOnDisk.ranks, B1 := Models.Fiber secondOddOnDisk.ranks,
  e0 := OriginalBundles.FirstEvenBundle, e1 := OriginalBundles.FirstOddBundle, f0 := OriginalBundles.SecondEvenBundle, f1 := OriginalBundles.SecondOddBundle,
  a0 := Models.bundle firstEvenOnDisk, a1 := Models.bundle firstOddOnDisk, b0 := Models.bundle secondEvenOnDisk, b1 := Models.bundle secondOddOnDisk,
  sameE1 := (\refl(Product.topology)), sameF0 := (\refl(Product.topology)), sameF1 := (\refl(Product.topology)),
  sameA1 := (\refl(Product.topology)), sameB0 := (\refl(Product.topology)), sameB1 := (\refl(Product.topology)),
  alpha0 := Factors.firstEven, alpha1 := Factors.firstOdd, beta0 := Factors.secondEven, beta1 := Factors.secondOdd] \as Change;
\import Bundles.Isomorphisms[X := Product.Z, F := ParityPull.Even, G := ParityPull.Even, source := ParityPull.sourceEven, target := ParityPull.targetEven] \as EvenInverse;
\import Bundles.Isomorphisms[X := Product.Z, F := ParityPull.Odd, G := ParityPull.Odd, source := ParityPull.sourceOdd, target := ParityPull.targetOdd] \as OddInverse;
\import Operations.IsomorphismComposition[X := Product.Z, F := Original.OriginalEven, G := ParityPull.Even, H := ParityPull.Even,
  source := Original.originalEvenBundle, middle := ParityPull.targetEven, target := ParityPull.sourceEven] \as FirstEven;
\definition toGlobalEven: FirstEven.Isomorphism := FirstEven.compose Change.evenIso (EvenInverse.inverse ParityPull.even);
\import Operations.IsomorphismComposition[X := Product.Z, F := Original.OriginalOdd, G := ParityPull.Odd, H := ParityPull.Odd,
  source := Original.originalOddBundle, middle := ParityPull.targetOdd, target := ParityPull.sourceOdd] \as FirstOdd;
\definition toGlobalOdd: FirstOdd.Isomorphism := FirstOdd.compose Change.oddIso (OddInverse.inverse ParityPull.odd);
\import GlobalModels.Chains[].Of[complex := Encoded.complex] \as GlobalChain;
\definition globalEven: GlobalModels.Bundle := GlobalChain.parity.even;
\definition globalOdd: GlobalModels.Bundle := GlobalChain.parity.odd;
\import Complements.PulledIsomorphism[X := Geometry.Total, Y := Product.Z, F := GlobalParity.Even,
  G := GlobalModels.Fiber globalEven.ranks, source := GlobalParity.evenBundle, target := GlobalModels.bundle globalEven,
  base := Product.topology, f := g, sourceRegular := gContinuous, targetRegular := gContinuous] \as PullEven;
\import Complements.PulledIsomorphism[X := Geometry.Total, Y := Product.Z, F := GlobalParity.Odd,
  G := GlobalModels.Fiber globalOdd.ranks, source := GlobalParity.oddBundle, target := GlobalModels.bundle globalOdd,
  base := Product.topology, f := g, sourceRegular := gContinuous, targetRegular := gContinuous] \as PullOdd;
\definition pulledEven: Bundles.Isomorphisms[X := Product.Z, F := ParityPull.Even, G := Models.Fiber Restricted.sourceEven.ranks,
  source := ParityPull.sourceEven, target := Models.bundle Restricted.sourceEven].Isomorphism := PullEven.isomorphism MixedIso.even;
\definition pulledOdd: Bundles.Isomorphisms[X := Product.Z, F := ParityPull.Odd, G := Models.Fiber Restricted.sourceOdd.ranks,
  source := ParityPull.sourceOdd, target := Models.bundle Restricted.sourceOdd].Isomorphism := PullOdd.isomorphism MixedIso.odd;
\import Operations.IsomorphismComposition[X := Product.Z, F := Original.OriginalEven, G := ParityPull.Even, H := Models.Fiber Restricted.sourceEven.ranks,
  source := Original.originalEvenBundle, middle := ParityPull.sourceEven, target := Models.bundle Restricted.sourceEven] \as MiddleEven;
\definition throughEven: MiddleEven.Isomorphism := MiddleEven.compose toGlobalEven pulledEven;
\import Operations.IsomorphismComposition[X := Product.Z, F := Original.OriginalOdd, G := ParityPull.Odd, H := Models.Fiber Restricted.sourceOdd.ranks,
  source := Original.originalOddBundle, middle := ParityPull.sourceOdd, target := Models.bundle Restricted.sourceOdd] \as MiddleOdd;
\definition throughOdd: MiddleOdd.Isomorphism := MiddleOdd.compose toGlobalOdd pulledOdd;
\import Operations.IsomorphismComposition[X := Product.Z, F := Original.OriginalEven, G := Models.Fiber Restricted.sourceEven.ranks, H := Models.Fiber Restricted.even.ranks,
  source := Original.originalEvenBundle, middle := Models.bundle Restricted.sourceEven, target := Models.bundle Restricted.even] \as FinalEven;
\definition positive: FinalEven.Isomorphism := FinalEven.compose throughEven Restricted.positive;
\import Operations.IsomorphismComposition[X := Product.Z, F := Original.OriginalOdd, G := Models.Fiber Restricted.sourceOdd.ranks, H := Models.Fiber Restricted.odd.ranks,
  source := Original.originalOddBundle, middle := Models.bundle Restricted.sourceOdd, target := Models.bundle Restricted.odd] \as FinalOdd;
\definition negative: FinalOdd.Isomorphism := FinalOdd.compose throughOdd Restricted.negative;
\module Operators;
\module At(p: Product.Z);
\definition data: Data := Data {
  positive := positive, negative := negative,
  forward := \fun (p: Product.Z) => At[p := p].forward,
  backward := \fun (p: Product.Z) => At[p := p].backward
};
