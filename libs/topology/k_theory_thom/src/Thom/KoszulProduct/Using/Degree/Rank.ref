\definition equation: Whole.rank x = Nat.add (Left.rank x) (Right.rank x) := \block {
  \takefrom c: \Cast[LeftCharts.Chart] ({ c: LeftCharts.Chart \where Base.Member c.domain x }) \by Left.locallyTrivial x \then
  \takefrom d: \Cast[RightCharts.Chart] ({ d: RightCharts.Chart \where Base.Member d.domain x }) \by Right.locallyTrivial x \then
  \let insideLeft: Base.Member c.domain x := \bysub(LeftCharts.Chart, { c: LeftCharts.Chart \where Base.Member c.domain x }, c) \then
  \let insideRight: Base.Member d.domain x := \bysub(RightCharts.Chart, { d: RightCharts.Chart \where Base.Member d.domain x }, d) \then
  \let a: \Cast[X] c.domain := \into[X](x, c.domain) \by { insideLeft } \then
  \let b: \Cast[X] d.domain := \into[X](x, d.domain) \by { insideRight } \then
  \let point: \Cast[X] (Base.Intersection c.domain d.domain) := \into[X](x, Base.Intersection c.domain d.domain) \by {
    Logic.And[Base.Member c.domain x, Base.Member d.domain x]::# insideLeft insideRight
  } \then
  \return trans!{{N.Nat^}} _ _ _
    (Whole.rankFrame x (Fin.Sum[m := c.dimension, n := d.dimension].total) (Sum.In[c := c, d := d].chart.frame point))
    (trans!{{N.Nat^}} _ _ _ (Naturals.addComm d.dimension c.dimension)
      (congr!{{N.Nat^} {N.Nat^} {N.Nat^}} Nat.add _ _ _ _
        (sym!{{N.Nat^}} _ _ (Left.rankFrame x c.dimension (c.frame a)))
        (sym!{{N.Nat^}} _ _ (Right.rankFrame x d.dimension (d.frame b)))))
};
