\import std.Data[].Pair[] \as P;
\import Operations.DirectSum[X := X, F := Source.Even, G := Source.Odd, left := Source.evenBundle, right := Source.oddBundle]
  .Of[same := (\refl(e0.baseSpace))] \as SourceSplit;
\import SourceSplit.Inclusions[] \as SourceInclusions;
\import Bundles.Morphisms[X := X, Y := X, F := Source.Even, G := Source.TargetFiber,
  source := Source.evenBundle, target := Source.targetBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Source.SourceFiber, range := Source.sourceBundle, g := (\fun (x: X) => x)] \as SourceEmbedding;
\definition sourceEmbed: Bundles.Morphisms[X := X, Y := X, F := Source.Even, G := Source.SourceFiber,
  source := Source.evenBundle, target := Source.sourceBundle, f := (\fun (x: X) => x)].Map :=
  SourceEmbedding.compose SourceInclusions.first Source.isomorphism.backward;
\import Bundles.Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Source.TargetFiber,
  source := Source.sourceBundle, target := Source.targetBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Source.Odd, range := Source.oddBundle, g := (\fun (x: X) => x)] \as SourceProjection;
\definition sourceProject: Bundles.Morphisms[X := X, Y := X, F := Source.SourceFiber, G := Source.Odd,
  source := Source.sourceBundle, target := Source.oddBundle, f := (\fun (x: X) => x)].Map :=
  SourceProjection.compose Source.isomorphism.forward SourceSplit.secondMap;
\import Operations.DirectSum[X := X, F := Target.Even, G := Target.Odd, left := Target.evenBundle, right := Target.oddBundle]
  .Of[same := (\refl(a0.baseSpace))] \as TargetSplit;
\import TargetSplit.Inclusions[] \as TargetInclusions;
\import Bundles.Morphisms[X := X, Y := X, F := Target.Even, G := Target.TargetFiber,
  source := Target.evenBundle, target := Target.targetBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Target.SourceFiber, range := Target.sourceBundle, g := (\fun (x: X) => x)] \as TargetEmbedding;
\definition targetEmbed: Bundles.Morphisms[X := X, Y := X, F := Target.Even, G := Target.SourceFiber,
  source := Target.evenBundle, target := Target.sourceBundle, f := (\fun (x: X) => x)].Map :=
  TargetEmbedding.compose TargetInclusions.first Target.isomorphism.backward;
\import Bundles.Morphisms[X := X, Y := X, F := Target.SourceFiber, G := Target.TargetFiber,
  source := Target.sourceBundle, target := Target.targetBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Target.Odd, range := Target.oddBundle, g := (\fun (x: X) => x)] \as TargetProjection;
\definition targetProject: Bundles.Morphisms[X := X, Y := X, F := Target.SourceFiber, G := Target.Odd,
  source := Target.sourceBundle, target := Target.oddBundle, f := (\fun (x: X) => x)].Map :=
  TargetProjection.compose Target.isomorphism.forward TargetSplit.secondMap;
\definition embedEquation: \forall (x: X)(v: Source.Even x) ->
  (targetEmbed.fiber x).apply ((evenIso.forward.fiber x).apply v) =
  (fullIso.forward.fiber x).apply ((sourceEmbed.fiber x).apply v) :=
  \fun (x: X)(v: Source.Even x) => trans!{{Target.SourceFiber x}} _ _ _
    (congr!{{Target.TargetFiber x} {Target.SourceFiber x}} (Target.isomorphism.backward.fiber x).apply _ _
      (P.Prop[A := Target.Even x, B := Target.Odd x].pairCong _ _ _ _ (\refl((evenIso.forward.fiber x).apply v))
        (sym!{{Target.Odd x}} _ _ (oddIso.forward.fiber x).preservesZero)))
    (trans!{{Target.SourceFiber x}} _ _ _
      (congr!{{Source.TargetFiber x} {Target.SourceFiber x}}
        (\fun (w: Source.TargetFiber x) => (Target.isomorphism.backward.fiber x).apply ((totalIso.forward.fiber x).apply w)) _ _
        (sym!{{Source.TargetFiber x}} _ _ (Source.isomorphism.rightInverse x ((SourceInclusions.first.fiber x).apply v))))
      (trans!{{Target.SourceFiber x}} _ _ _
        (congr!{{Target.TargetFiber x} {Target.SourceFiber x}} (Target.isomorphism.backward.fiber x).apply _ _
          (sym!{{Target.TargetFiber x}} _ _ (commutes x ((sourceEmbed.fiber x).apply v))))
        (Target.isomorphism.leftInverse x ((fullIso.forward.fiber x).apply ((sourceEmbed.fiber x).apply v)))));
\definition projectEquation: \forall (x: X)(v: Source.SourceFiber x) ->
  (targetProject.fiber x).apply ((fullIso.forward.fiber x).apply v) =
  (oddIso.forward.fiber x).apply ((sourceProject.fiber x).apply v) :=
  \fun (x: X)(v: Source.SourceFiber x) => congr!{{Target.TargetFiber x} {Target.Odd x}} (TargetSplit.secondMap.fiber x).apply _ _ (commutes x v);
\import Bundles.Morphisms[X := X, Y := X, F := Source.Even, G := Source.SourceFiber,
  source := Source.evenBundle, target := Source.sourceBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Source.SourceFiber, range := Source.sourceBundle, g := (\fun (x: X) => x)] \as SourceStart;
\import Bundles.Morphisms[X := X, Y := X, F := Source.Even, G := Source.SourceFiber,
  source := Source.evenBundle, target := Source.sourceBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Source.Odd, range := Source.oddBundle, g := (\fun (x: X) => x)] \as SourceEnd;
\definition sourceBlock: Bundles.Morphisms[X := X, Y := X, F := Source.Even, G := Source.Odd,
  source := Source.evenBundle, target := Source.oddBundle, f := (\fun (x: X) => x)].Map :=
  SourceEnd.compose (SourceStart.compose sourceEmbed c) sourceProject;
\import Bundles.Morphisms[X := X, Y := X, F := Target.Even, G := Target.SourceFiber,
  source := Target.evenBundle, target := Target.sourceBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Target.SourceFiber, range := Target.sourceBundle, g := (\fun (x: X) => x)] \as TargetStart;
\import Bundles.Morphisms[X := X, Y := X, F := Target.Even, G := Target.SourceFiber,
  source := Target.evenBundle, target := Target.sourceBundle, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Target.Odd, range := Target.oddBundle, g := (\fun (x: X) => x)] \as TargetEnd;
\definition targetBlock: Bundles.Morphisms[X := X, Y := X, F := Target.Even, G := Target.Odd,
  source := Target.evenBundle, target := Target.oddBundle, f := (\fun (x: X) => x)].Map :=
  TargetEnd.compose (TargetStart.compose targetEmbed d) targetProject;
\definition equation: \forall (x: X)(v: Source.Even x) ->
  (oddIso.forward.fiber x).apply ((sourceBlock.fiber x).apply v) =
  (targetBlock.fiber x).apply ((evenIso.forward.fiber x).apply v) :=
  \fun (x: X)(v: Source.Even x) => trans!{{Target.Odd x}} _ _ _
    (sym!{{Target.Odd x}} _ _ (projectEquation x ((c.fiber x).apply ((sourceEmbed.fiber x).apply v))))
    (trans!{{Target.Odd x}} _ _ _
      (congr!{{Target.SourceFiber x} {Target.Odd x}} (targetProject.fiber x).apply _ _ (operatorCommutes x ((sourceEmbed.fiber x).apply v)))
      (congr!{{Target.SourceFiber x} {Target.Odd x}} (\fun (w: Target.SourceFiber x) => (targetProject.fiber x).apply ((d.fiber x).apply w)) _ _ (sym!{{Target.SourceFiber x}} _ _ (embedEquation x v))));
