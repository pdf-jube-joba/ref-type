\import Operations.Models[X := X, baseSpace := space] \as Models;
\import std.Data[].Bool[] \as B;
\import \root.Thom[].FiniteLabels[] \as Labels;
\import \root.Thom[].Finite[X := X, baseSpace := space].Family[term := firstTerm,
  differential := firstDifferential, domain := { x: X \where Logic.False }].Summands[] \as First;
\import \root.Thom[].Finite[X := X, baseSpace := space].Family[term := secondTerm,
  differential := secondDifferential, domain := { x: X \where Logic.False }].Summands[] \as Second;
\definition Component[p, q: N.Nat^][x: X]: \Set := Operations.Tensor[X := X,
  F := Models.Fiber (firstTerm p).ranks, G := Models.Fiber (secondTerm q).ranks,
  left := Models.bundle (firstTerm p), right := Models.bundle (secondTerm q)].Fiber x;
\definition componentBundle[p, q: N.Nat^]: Bundles.Family[X := X, F := Component p q].Bundle := Operations.Tensor[X := X,
  F := Models.Fiber (firstTerm p).ranks, G := Models.Fiber (secondTerm q).ranks,
  left := Models.bundle (firstTerm p), right := Models.bundle (secondTerm q)].bundle (\refl(space));
\definition componentPure[p, q: N.Nat^][x: X][v: Models.Fiber (firstTerm p).ranks x][w: Models.Fiber (secondTerm q).ranks x]: Component p q x :=
  Operations.Tensor[X := X, F := Models.Fiber (firstTerm p).ranks, G := Models.Fiber (secondTerm q).ranks,
    left := Models.bundle (firstTerm p), right := Models.bundle (secondTerm q)].pure x v w;
\definition ComponentMap[p, q: N.Nat^][target: Models.Bundle]: \Set := Bundles.Morphisms[X := X, Y := X,
  F := Component p q, G := Models.Fiber target.ranks, source := componentBundle p q, target := Models.bundle target, f := (\fun (x: X) => x)].Map;
\module At(n, m: N.Nat^, firstSide, secondSide: B.Bool^, target: Models.Bundle);
