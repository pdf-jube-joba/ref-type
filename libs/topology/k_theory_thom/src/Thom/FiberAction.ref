\use Equality.eq_reason_in;
\import std.Data[].Pair[] \as Pair;
\import relative_k_theory.Relative[] \as Relative;
\import compact_support_k.Support[] \as Support;
\import topology.Topology[Carrier := X] \as Base;
\definition rightCompact: Base.IsCompact right.baseSpace := \idelim left.baseSpace = right.baseSpace \with t: Base.Topology => Base.IsCompact t \by { base: compact, equality: sameBase };
\definition rightHausdorff: Base.IsT2 right.baseSpace := \idelim left.baseSpace = right.baseSpace \with t: Base.Topology => Base.IsT2 t \by { base: hausdorff, equality: sameBase };
\import Operations.DirectSum[X := X, F := F, G := G, left := left, right := right] \as Sum;
\definition sum: Bundles.Family[X := X, F := Sum.Fiber].Bundle := Sum.bundle sameBase;
\import Bundles.Family[X := X, F := F] \as FirstFamily;
\import Bundles.Family[X := X, F := G] \as SecondFamily;
\import Bundles.Family[X := X, F := Sum.Fiber] \as SumFamily;
\import \root.Thom[].TotalSpace[X := X, F := F, bundle := left, compact := compact, hausdorff := hausdorff] \as FirstTotal;
\import \root.Thom[].TotalSpace[X := X, F := G, bundle := right, compact := rightCompact, hausdorff := rightHausdorff] \as SecondTotal;
\import \root.Thom[].TotalSpace[X := X, F := Sum.Fiber, bundle := sum, compact := compact, hausdorff := hausdorff] \as SumTotal;
\definition baseLocal: topology.LocallyCompact[A := X].IsLocallyCompact left.baseSpace := topology.LocallyCompact[A := X].compactLocallyCompact left.baseSpace compact;
\import Support.On[X := X, space := left.baseSpace, hausdorff := hausdorff, locallyCompact := baseLocal] \as A;
\import Support.On[X := FirstFamily.Point, space := left.totalSpace, hausdorff := FirstTotal.separated, locallyCompact := FirstTotal.locallyCompact] \as B;
\import Support.On[X := SecondFamily.Point, space := right.totalSpace, hausdorff := SecondTotal.separated, locallyCompact := SecondTotal.locallyCompact] \as C;
\import Support.On[X := SumFamily.Point, space := sum.totalSpace, hausdorff := SumTotal.separated, locallyCompact := SumTotal.locallyCompact] \as Source;
\import \root.Thom[].FiberMultiply[X := X, F := F, G := G, left := left, right := right, sameBase := sameBase, compact := compact, hausdorff := hausdorff] \as Multiply;
\import \root.Thom[].For[X := X, F := F, bundle := left, compact := compact, hausdorff := hausdorff].Product[] \as FirstAction;
\import \root.Thom[].For[X := X, F := Sum.Fiber, bundle := sum, compact := compact, hausdorff := hausdorff].Product[] \as SumAction;
\import FirstAction.Compactified[] \as FirstGraph;
\import SumAction.Compactified[] \as SumGraph;
\import \root.Thom[].CompactCoefficient[X := X, space := left.baseSpace, compact := compact, hausdorff := hausdorff] \as Coefficient;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := left.baseSpace, compact := compact, hausdorff := hausdorff].K0[] \as K;
\import Relative.Smash[left := A.model, right := B.model] \as AB;
\import Relative.Smash[left := B.model, right := C.model] \as BC;
\import Relative.Smash[left := A.model, right := Source.model] \as AS;
\import Relative.Smash[left := AB.result, right := C.model] \as Left;
\import Relative.Smash[left := A.model, right := BC.result] \as Right;
\import \root.Thom[].SmashAssociator[first := A.model, second := B.model, third := C.model] \as Associator;
\module Maps;
\module Classes;
\definition equation: \forall (a: K.Carrier)(u: Multiply.First)(v: Multiply.Second) ->
  Multiply.multiply (FirstAction.multiply a u) v = SumAction.multiply a (Multiply.multiply u v) := Classes[].action;
