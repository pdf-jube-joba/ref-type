\import Relative.Composition[source := Supported.model, middle := Complement.model, target := Pair.Quotient[].model,
  first := Forward.mapping, second := Complement.equivalence.backward] \as First;
\import Relative.Composition[source := Supported.model, middle := Pair.Quotient[].model, target := Absolute.model,
  first := First.map, second := Absolute.equivalence.backward] \as Second;
\definition map: Relative.Map Supported.model Absolute.model := Second.map;
\import Relative.Pullback[source := Supported.model, target := Absolute.model, f := map] \as Pull;
\definition formula: \forall (a: K.Carrier) -> forward a = Pull.map (Absolute.forward a) :=
  \fun (a: K.Carrier) => trans!{{Supported.At[degree := zero].Carrier}} _ _ _
    (sym!{{Supported.At[degree := zero].Carrier}} _ _
      (Relative.PullbackComposition[source := Supported.model, middle := Complement.model, target := Pair.Quotient[].model,
        first := Forward.mapping, second := Complement.equivalence.backward].equation (AbsoluteGroups.backward (Absolute.forward a))))
    (sym!{{Supported.At[degree := zero].Carrier}} _ _
      (Relative.PullbackComposition[source := Supported.model, middle := Pair.Quotient[].model, target := Absolute.model,
        first := First.map, second := Absolute.equivalence.backward].equation (Absolute.forward a)));
\import Support.OnePoint[X := X, space := space] \as Points;
\definition onFinite: \forall (x: X) -> map (Points.inclusion x) = Absolute.inclusion x :=
  \fun (x: X) => trans!{{Absolute.model.Carrier}} _ _ _
    (congr!{{Pair.Quotient[].Carrier} {Absolute.model.Carrier}} Absolute.equivalence.backward _ _
      (Complement.backwardOnInterior (include x)))
    (Absolute.equivalence.leftInverse (Absolute.inclusion x));
