\definition inverse[b: B]: A := composite.inverse (second b);
\definition leftInverse: \forall (a: A) -> inverse (first a) = a := composite.leftInverse;
\definition secondInjective: \forall (b, c: B) -> second b = second c -> b = c :=
  \fun (b, c: B)(same: second b = second c) => trans!{B} _ _ _
    (sym!{B} _ _ (stable.leftInverse b))
    (trans!{B} _ _ _ (congr!{C B} (\fun (u: C) => stable.inverse (third u)) _ _ same) (stable.leftInverse c));
\definition rightInverse: \forall (b: B) -> first (inverse b) = b :=
  \fun (b: B) => secondInjective (first (inverse b)) b (composite.rightInverse (second b));
