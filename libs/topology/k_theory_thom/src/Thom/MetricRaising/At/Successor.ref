\import \parent.Raising[k := k] \as Raising;
\import \parent.Raising[k := N.Nat^::succ k] \as Next;
\import Algebra.Cartan[k := k, v := p.vector, ell := Metric.covector p].Successor[] \as Cartan;
\import Forms.At[k := N.Nat^::succ k] \as TargetForms;
\import \root.Thom[].Koszul[X := X, F := F, bundle := bundle].Degree[k := k] \as Contract;
\import \root.Thom[].Koszul[X := X, F := F, bundle := bundle].Degree[k := N.Nat^::succ k] \as NextContract;
\import Algebra.Cartan[k := k, v := p.vector, ell := Metric.covector p] \as Wedge;
\import Algebra.Cartan[k := N.Nat^::succ k, v := p.vector, ell := Metric.covector p] \as NextWedge;
\definition equation: \forall (v: Vector (N.Nat^::succ k) p) ->
  ((Models.bundle (model (N.Nat^::succ k))).space p).add
    (((differential (N.Nat^::succ k)).fiber p).apply (((raising (N.Nat^::succ k)).fiber p).apply v))
    (((raising k).fiber p).apply (((differential k).fiber p).apply v)) =
  ((Models.bundle (model (N.Nat^::succ k))).space p).smul (coefficient p) v :=
  \fun (v: Vector (N.Nat^::succ k) p) => trans!{{Vector (N.Nat^::succ k) p}} _ _ _
    (congr!{{Vector (N.Nat^::succ k) p} {Vector (N.Nat^::succ k) p} {Vector (N.Nat^::succ k) p}}
      ((Models.bundle (model (N.Nat^::succ k))).space p).add _ _ _ _ (Next.after v) (Raising.before v))
    (trans!{{Vector (N.Nat^::succ k) p}} _ _ _
      (sym!{{Vector (N.Nat^::succ k) p}} _ _ ((Coordinates.encode (N.Nat^::succ k) p).preservesAdd
        ((NextContract.differential.fiber p).apply (NextWedge.wedge ((Coordinates.decode (N.Nat^::succ k) p).apply v)))
        (Wedge.wedge ((Contract.differential.fiber p).apply ((Coordinates.decode (N.Nat^::succ k) p).apply v)))))
      (trans!{{Vector (N.Nat^::succ k) p}} _ _ _
        (congr!{{Koszul.Term (N.Nat^::succ k) p} {Vector (N.Nat^::succ k) p}} (Coordinates.encode (N.Nat^::succ k) p).apply _ _
          (trans!{{Koszul.Term (N.Nat^::succ k) p}} _ _ _ (Cartan.equation ((Coordinates.decode (N.Nat^::succ k) p).apply v))
            (congr!{{C.Complex} {Koszul.Term (N.Nat^::succ k) p}}
              (\fun (a: C.Complex) => TargetForms.scale a ((Coordinates.decode (N.Nat^::succ k) p).apply v)) _ _ (Metric.evaluation p))))
        (trans!{{Vector (N.Nat^::succ k) p}} _ _ _ ((Coordinates.encode (N.Nat^::succ k) p).preservesScale (coefficient p) ((Coordinates.decode (N.Nat^::succ k) p).apply v))
          (congr!{{Vector (N.Nat^::succ k) p} {Vector (N.Nat^::succ k) p}} (((Models.bundle (model (N.Nat^::succ k))).space p).smul (coefficient p)) _ _ (Coordinates.encodeDecode (N.Nat^::succ k) p v)))));
