\import \root.Thom[].WedgeOne[X := Total, F := Koszul.Fiber, bundle := Koszul.pulled, ell := Metric.ell, k := k] \as Wedge;
\import Bundles.Morphisms[X := Total, Y := Total, F := Vector k, G := Koszul.Term k,
  source := Models.bundle (model k), target := Koszul.term k, f := \fun (p: Total) => p].Composition[
  Z := Total, H := Koszul.Term (N.Nat^::succ k), range := Koszul.term (N.Nat^::succ k), g := \fun (p: Total) => p] \as FirstComposition;
\definition middle: Bundles.Morphisms[X := Total, Y := Total, F := Vector k, G := Koszul.Term (N.Nat^::succ k),
  source := Models.bundle (model k), target := Koszul.term (N.Nat^::succ k), f := \fun (p: Total) => p].Map :=
  FirstComposition.compose (selection k).isomorphism.backward Wedge.map;
\import Bundles.Morphisms[X := Total, Y := Total, F := Vector k, G := Koszul.Term (N.Nat^::succ k),
  source := Models.bundle (model k), target := Koszul.term (N.Nat^::succ k), f := \fun (p: Total) => p].Composition[
  Z := Total, H := Vector (N.Nat^::succ k), range := Models.bundle (model (N.Nat^::succ k)), g := \fun (p: Total) => p] \as LastComposition;
\definition map: Models.Map (model k) (model (N.Nat^::succ k)) := LastComposition.compose middle (selection (N.Nat^::succ k)).isomorphism.forward;
