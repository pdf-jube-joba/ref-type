\import C.Def[] \as Op;
\import C.Prop[] \as Laws;
\import Spaces.Sign[] \as Sign;
\import std.Data[].List[] \as Lists;
\import \root.Thom[].Algebra[V := F p.base, space := bundle.space p.base] \as Algebra;
\import Spaces.Multilinear[V := F p.base, space := bundle.space p.base] \as Multilinear;
\import Multilinear.Alternating[] \as Forms;
\import Spaces.Exterior[V := F p.base, space := bundle.space p.base] \as Exterior;
\import Spaces.Shuffle[I := F p.base] \as Shuffle;
\import Shuffle.Laws[] \as Products;
\module Raising(k: N.Nat^);
\module Bottom;
\module Successor(k: N.Nat^);
\definition square: \forall (k: N.Nat^)(v: Vector k p) ->
  ((raising (N.Nat^::succ k)).fiber p).apply (((raising k).fiber p).apply v) = ((Models.bundle (model (N.Nat^::succ (N.Nat^::succ k)))).space p).zero :=
  \fun (k: N.Nat^)(v: Vector k p) => Raising[k := k].square v;
\definition bottom: \forall (v: Vector N.Nat^::zero p) ->
  ((differential N.Nat^::zero).fiber p).apply (((raising N.Nat^::zero).fiber p).apply v) = ((Models.bundle (model N.Nat^::zero)).space p).smul (coefficient p) v := Bottom[].equation;
\definition cartan: \forall (k: N.Nat^)(v: Vector (N.Nat^::succ k) p) ->
  ((Models.bundle (model (N.Nat^::succ k))).space p).add
    (((differential (N.Nat^::succ k)).fiber p).apply (((raising (N.Nat^::succ k)).fiber p).apply v))
    (((raising k).fiber p).apply (((differential k).fiber p).apply v)) =
  ((Models.bundle (model (N.Nat^::succ k))).space p).smul (coefficient p) v :=
  \fun (k: N.Nat^)(v: Vector (N.Nat^::succ k) p) => Successor[k := k].equation v;
