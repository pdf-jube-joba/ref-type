\import \root.Thom[].For[X := X, F := F, bundle := bundle, compact := compact, hausdorff := hausdorff] \as Thom;
\import Thom.Using[data := data] \as Chosen;
\import \root.Thom[].Koszul[X := X, F := F, bundle := bundle] \as Koszul;
\import \root.Thom[].MetricKoszul[X := X, F := F, bundle := bundle, compact := compact, hausdorff := hausdorff].With[metric := metric] \as Metric;
\import Metric.Neighborhood[] \as Neighborhood;
\import \root.Thom[].TotalSpace[X := X, F := F, bundle := bundle, compact := compact, hausdorff := hausdorff] \as Total;
\import compact_support_k.Support[].On[X := Koszul.Total, space := bundle.totalSpace, hausdorff := Total.separated, locallyCompact := Total.locallyCompact] \as Support;
\import \root.Thom[].MetricFold[X := X, F := F, bundle := bundle, compact := compact, hausdorff := hausdorff, metric := metric, selection := data.selection]
  .At[n := Chosen.degree, zeroAbove := Chosen.zeroAbove] \as Fold;
\import Support.FiniteComplexes[].Of[complex := Chosen.complex].Supported[K := Koszul.ZeroSection, compactK := Total.zeroCompact, exactOutside := Koszul.Coordinates[].With[selection := data.selection].Finite[].At[n := Chosen.degree, zeroAbove := Chosen.zeroAbove].exactOutside] \as Supported;
\import Support.Neighborhood[K := Koszul.ZeroSection, compact := Total.zeroCompact].With[w := Neighborhood.witness] \as Neighbor;
\import Support.Localization[U := Neighbor.openSet, open := Neighbor.open, L := Neighbor.compactSet, compactL := Neighbor.compact, enclosed := Neighbor.enclosed] \as Local;
\import relative_k_theory.Relative[].Pair[X := Local.Carrier, space := Local.topology, compact := Local.compact, hausdorff := Local.separated, subset := Local.boundary, closed := Local.boundaryClosed] \as Pair;
\import Supported.In[w := Neighborhood.witness] \as In;
\import thom_spaces.Thom[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := Scalars.scalar]
  .For[X := X, F := F, bundle := bundle].With[metric := metric] \as Geometry;
\definition totalTopology: topology.Topology[Carrier := Koszul.Total].Topology := bundle.totalSpace;
\definition totalHausdorff: topology.Topology[Carrier := Koszul.Total].IsT2 totalTopology := Total.separated;
\definition totalLocallyCompact: topology.LocallyCompact[A := Koszul.Total].IsLocallyCompact totalTopology := Total.locallyCompact;
\definition openSet: \Pow Koszul.Total := Neighbor.openSet;
\definition openSetOpen: topology.Topology[Carrier := Koszul.Total].IsOpenIn totalTopology openSet := Neighbor.open;
\definition compactSet: \Pow Koszul.Total := Neighbor.compactSet;
\definition compactSetCompact: topology.Topology[Carrier := Koszul.Total].IsCompactIn totalTopology compactSet := Neighbor.compact;
\definition enclosed: topology.Topology[Carrier := Koszul.Total].Subset openSet compactSet := Neighbor.enclosed;
\definition Disk: \Set := Local.Carrier;
\definition diskTopology: topology.Topology[Carrier := Disk].Topology := Local.topology;
\definition diskCompact: topology.Topology[Carrier := Disk].IsCompact diskTopology := Local.compact;
\definition diskHausdorff: topology.Topology[Carrier := Disk].IsT2 diskTopology := Local.separated;
\definition diskBoundary: \Pow Disk := Local.boundary;
\definition diskBoundaryClosed: topology.Topology[Carrier := Disk].IsClosedIn diskTopology diskBoundary := Local.boundaryClosed;
\definition model: relative_k_theory.Relative[].CompactPointed := Pair.Quotient[].model;
\definition inclusion: Disk -> Koszul.Total := Local.inclusion;
\definition regular: topology.Continuity[A := Disk, B := Koszul.Total].Continuous diskTopology bundle.totalSpace inclusion := Local.regular;
\definition extend: relative_k_theory.Relative[].Reduced[model := model].Carrier -> Thom.Carrier := Local.extend;
\definition projection: Disk -> model.Carrier := Pair.Quotient[].projection;
\definition projectionContinuous: topology.Continuity[A := Disk, B := model.Carrier].Continuous diskTopology (relative_k_theory.Relative[].details model).topology projection := Pair.Quotient[].continuous;
\module Boundary;
