\definition Left[x: X]: \Set := Models.Fiber (First.parity n firstSide).ranks x;
\definition Right[x: X]: \Set := Models.Fiber (Second.parity m secondSide).ranks x;
\import \root.Thom[].ComplexProductTensorSum[X := X, space := space, term := firstTerm, differential := firstDifferential,
  G := Right, bundle := Models.bundle (Second.parity m secondSide), same := (\refl(space))] \as Builder;
\definition Fiber[x: X]: \Set := Builder.Fiber n firstSide x;
\definition bundle: Bundles.Family[X := X, F := Fiber].Bundle := Builder.source n firstSide;
\definition Map: \Set := Builder.Map n firstSide target;
\definition Components: \Set := \forall (s: First.Colored n firstSide)(t: Second.Colored m secondSide) ->
  ComponentMap (Labels.degree n s) (Labels.degree m t) target;
\definition pure[x: X][v: Left x][w: Right x]: Fiber x := Builder.pure n firstSide x v w;
\module With(components: Components);
\module Ext(x: X, U: \Set, spaceU: Spaces.VectorSpace U);
