\definition q: N.Nat^ := Labels.degree m t;
\definition B[x: X]: \Set := Models.Fiber (secondTerm q).ranks x;
\import Operations.Tensor[X := X, F := B, G := A, left := Models.bundle (secondTerm q), right := Models.bundle (firstTerm p)] \as Input;
\import Input.Of[same := (\refl(space))].Symmetry[] \as Flip;
\import Input.Of[same := (\refl(space))].Transpose[] \as Transpose;
\import Bundles.Morphisms[X := X, Y := X, F := Input.Fiber, G := Component p q,
  source := Input.bundle (\refl(space)), target := componentBundle p q, f := (\fun (x: X) => x)]
  .Composition[Z := X, H := Models.Fiber target.ranks, range := Models.bundle target, g := (\fun (x: X) => x)] \as Compose;
\definition map: Inner.ComponentMap q target := Compose.compose Flip.isomorphism.forward (components s t);
\definition onPure[x: X][w: B x][v: A x]: (map.fiber x).apply (Input.pure x w v) =
  ((components s t).fiber x).apply (componentPure p q x v w) :=
  congr!{{Component p q x} {Models.Fiber target.ranks x}} ((components s t).fiber x).apply _ _ (Transpose.onPure x w v);
