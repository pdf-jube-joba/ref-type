\module Row(s: First.Colored n firstSide);
\definition parts: Builder.Components n firstSide target := \fun (s: First.Colored n firstSide) => Row[s := s].map;
\definition map: Map := Builder.assemble n firstSide target parts;
\definition onPair[s: First.Colored n firstSide][t: Second.Colored m secondSide][x: X]
  [v: Models.Fiber (firstTerm (Labels.degree n s)).ranks x][w: Models.Fiber (secondTerm (Labels.degree m t)).ranks x]:
  (map.fiber x).apply (pure x (((First.at n s firstSide (\bysub(Labels.Index n, First.Colored n firstSide, s))).fiber x).apply v)
    (((Second.at m t secondSide (\bysub(Labels.Index m, Second.Colored m secondSide, t))).fiber x).apply w)) =
  ((components s t).fiber x).apply (componentPure (Labels.degree n s) (Labels.degree m t) x v w) :=
  trans!{{Models.Fiber target.ranks x}} _ _ _
    (Builder.onSummand n s firstSide (\bysub(Labels.Index n, First.Colored n firstSide, s)) target parts x v
      (((Second.at m t secondSide (\bysub(Labels.Index m, Second.Colored m secondSide, t))).fiber x).apply w))
    (Row[s := s].onSummand t x v w);
