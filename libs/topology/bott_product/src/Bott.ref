\import std.Data[].Nat[] \as N;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition two: N.Nat^ := N.Nat^::succ one;
\definition three: N.Nat^ := N.Nat^::succ two;
\import algebraic_topology.Euclidean[].Dimension[n := three] \as Sphere;
\import Sphere.Compactness[] \as Compactness;
\import bundle_homotopy.Homotopy[].Examples[].CircleLine[] \as Line;
\import topological_k_theory.KTheory[].On[X := Sphere.Sphere, baseSpace := Sphere.sphereTopology,
  compact := Compactness.sphere, hausdorff := Compactness.sphereHausdorff] \as K;
\import K.Bundle[F := Line.Fiber, original := Line.bundle, same := \refl(Sphere.sphereTopology)] \as LineClass;
\import K.K0[] \as K0;
\definition lineClass: K.Classes := LineClass.value;
\definition generator: K0.Carrier := K0.difference lineClass K.Line[].value;
\module Rank;
\module Product(X: \Set, source: topology.Topology[Carrier := X].Topology,
  compact: topology.Topology[Carrier := X].IsCompact source, hausdorff: topology.Topology[Carrier := X].IsT2 source);
\module Restriction(point: Sphere.Sphere);
\module ProjectiveLine;
