\import std.Logic[].Equality[] \as Eq;
\use Eq.trans;
\use Eq.sym;
\use Eq.congr;
\import clutching_linearization.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[n := n, a := a, regular := regular, nonzero := nonzero] \as Matrix;
\import Matrix.Inverse[] \as Inverse;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Line[].K07[] \as Line;
\definition inverseClass: Source.K0[].Carrier := Inverse.value;
\module With(parameters: Matrix.Parameters) {
  \import Matrix.Construction[parameters := parameters].Reconstruction[] \as Native;
  \import Inverse.Reconstruction[parameters := parameters] \as Recovery;
  \definition reducedClass: Target.K0[].Carrier := Native.reducedClutchingClass;
  \definition reconstruction: reducedClass = Target.K0[].mul generatorOnProduct (First.K0[].map inverseClass) :=
    trans!{{Target.K0[].Carrier}} _ _ _ Recovery.reconstruction
      (congr!{{Target.K0[].Carrier} {Target.K0[].Carrier}} (\fun (u: Target.K0[].Carrier) => Target.K0[].mul u (First.K0[].map inverseClass)) _ _ Line.lineDifference);
  \import algebra.Group[].Of[Carrier := Target.K0[].Carrier, group := Target.K0[].group] \as Group;
  \import algebra.GroupCompletion[].Semiring[M := Target.Classes, semiring := Target.Semiring[].semiring] \as Ring;
  \definition forwardFormula: reducedClass = forward Source.K0[].zero inverseClass :=
    trans!{{Target.K0[].Carrier}} _ _ _ reconstruction
      (sym!{{Target.K0[].Carrier}} _ _ (trans!{{Target.K0[].Carrier}} _ _ _
        (congr!{{Target.K0[].Carrier} {Target.K0[].Carrier}} (\fun (z: Target.K0[].Carrier) => Target.K0[].add z (Target.K0[].mul (First.K0[].map inverseClass) generatorOnProduct)) _ _ First.K0[].preservesZero)
        (trans!{{Target.K0[].Carrier}} _ _ _ (Group.zeroLeft (Target.K0[].mul (First.K0[].map inverseClass) generatorOnProduct))
          (Ring.mulComm Target.MultiplicativeMonoid[].commutative (First.K0[].map inverseClass) generatorOnProduct))));
}
