\import Target.Realized[p := p] \as Realized;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Bundle[
  F := Target.Fiber p, bundle := Target.bundle p, same := \refl(topology)].Decomposition[] \as Bundle;
\definition exists: \exists Representation[Target.K0[].include (Target.class p)] :=
  \idelim Target.K0[].include Realized.value = Target.K0[].include (Target.class p) \with v: Target.K0[].Carrier => \exists Representation[v] \by {
    base: Bundle.exists, equality: congr!{Target.Classes {Target.K0[].Carrier}} Target.K0[].include _ _ Realized.equation
  };
