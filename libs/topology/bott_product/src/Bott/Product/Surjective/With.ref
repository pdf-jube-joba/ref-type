\import Source.Trivial[n := form.dimension] \as BaseTrivial;
\import \parent.At[p := form.positive] \as Represented;
\definition exists: \exists Representation[v] := \block {
  \takefrom rep: Representation[Target.K0[].include (Target.class form.positive)] \by Represented.exists \then
  \return \exact(Representation[v] {
    constant := SourceGroup.difference rep.constant (Source.K0[].include BaseTrivial.value),
    coefficient := rep.coefficient,
    equation := trans!{{Target.K0[].Carrier}} _ _ _
      (Additive.subtractConstant rep.constant rep.coefficient (Source.K0[].include BaseTrivial.value))
      (trans!{{Target.K0[].Carrier}} _ _ _
        (congr!{{Target.K0[].Carrier} {Target.K0[].Carrier} {Target.K0[].Carrier}} TargetGroup.difference _ _ _ _ rep.equation (First.Trivial[n := form.dimension].onK0))
        form.equation)
  }, Representation[v])
};
