\definition first: Source.K0[].Carrier := Source.K0[].include (Source.class form.positive);
\definition second: Source.K0[].Carrier := Source.K0[].include (Source.class q);
\definition representation: SourceGroup.difference first second = v :=
  trans!{Source.K0[].Carrier} _ _ _
    (congr!{Source.Classes Source.K0[].Carrier} (\fun (c: Source.Classes) => Source.K0[].difference (Source.class form.positive) c) _ _
      (\bysub(Source.Presentation, { q: Source.Presentation \where Source.class q = Source.Trivial[n := form.dimension].value }, q))) form.equation;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].PresentationPair[p := form.positive, q := q] \as Pair;
\definition kernel: forward Source.K0[].zero v = Target.K0[].zero -> v = Source.K0[].zero := \block {
  \fun (zero: _) \then
  \let differenceZero: TargetGroup.difference (forward Source.K0[].zero first) (forward Source.K0[].zero second) = Target.K0[].zero :=
    trans!{Target.K0[].Carrier} _ _ _ (sym!{Target.K0[].Carrier} _ _ (Additive.reducedDifference first second))
      (trans!{Target.K0[].Carrier} _ _ _ (congr!{Source.K0[].Carrier Target.K0[].Carrier} (forward Source.K0[].zero) _ _ representation) zero) \then
  \let imagesEqual: forward Source.K0[].zero first = forward Source.K0[].zero second :=
    trans!{Target.K0[].Carrier} _ _ _ (sym!{Target.K0[].Carrier} _ _ (TargetGroup.addDifference (forward Source.K0[].zero first) (forward Source.K0[].zero second)))
      (trans!{Target.K0[].Carrier} _ _ _ (congr!{Target.K0[].Carrier Target.K0[].Carrier} (\fun (w: Target.K0[].Carrier) => Target.K0[].add w (forward Source.K0[].zero second)) _ _ differenceZero)
        (TargetGroup.zeroLeft (forward Source.K0[].zero second))) \then
  \let classesEqual: first = second := Pair.injective imagesEqual \then
  \return trans!{Source.K0[].Carrier} _ _ _ (sym!{Source.K0[].Carrier} _ _ representation)
    (trans!{Source.K0[].Carrier} _ _ _ (congr!{Source.K0[].Carrier Source.K0[].Carrier} (SourceGroup.difference first) _ _ (sym!{Source.K0[].Carrier} _ _ classesEqual))
      (SourceGroup.inverseRight first))
};
