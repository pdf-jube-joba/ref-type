\import std.Logic[].Equality[] \as Eq;
\use Eq.sym;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Bundle[F := F, bundle := bundle, same := same].Preparation[] \as Preparation;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff] \as Product;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Hemisphere[] \as Half;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Bundle[F := F, bundle := bundle, same := same].At[point := Half.point] \as At;
\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar].For[X := X, F := At.Fiber, bundle := At.restriction] \as Complements;
\definition exists: \exists Product.Representation[value] := \block {
  \takefrom embedding: Complements.Embedding \by Preparation.embeddingExists \then
  \takefrom positive: Preparation.With[embedding := embedding].Transition[].PositiveIsomorphism \by Preparation.With[embedding := embedding].trivializationExists \then
  \takefrom negative: Preparation.With[embedding := embedding].Transition[].NegativeIsomorphism \by Preparation.With[embedding := embedding].Negative[].trivializationExists \then
  \return \exact(Product.Representation[value] {
    constant := At.class,
    coefficient := Preparation.With[embedding := embedding].Transition[].With[positive := positive, negative := negative].index,
    equation := sym!{{Target.K0[].Carrier}} _ _ (Preparation.With[embedding := embedding].Transition[].With[positive := positive, negative := negative].Gluing[].Formula[].reconstruction)
  }, Product.Representation[value])
};
