\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].At[point := point] \as Section;
\definition regular: topology.Continuity[A := X, B := Carrier].Continuous source bundle.baseSpace Section.section :=
  \idelim topology = bundle.baseSpace \with t: topology.Topology[Carrier := Carrier].Topology => topology.Continuity[A := X, B := Carrier].Continuous source t Section.section \by {
    base: Section.continuous, equality: sym!{{topology.Topology[Carrier := Carrier].Topology}} _ _ same
  };
\import Bundles.Family[X := Carrier, F := F].Of[bundle := bundle].Pullback[Y := X, source := source, f := Section.section] \as Pull;
\definition Fiber[x: X]: \Set := F (Section.section x);
\definition restriction: Bundles.Family[X := X, F := Fiber].Bundle := Pull.pulled regular;
\import Source.Bundle[F := Fiber, original := restriction, same := \refl(source)] \as RestrictionClass;
\definition class: Source.K0[].Carrier := Source.K0[].include RestrictionClass.value;
\use Eq.trans;
\use Eq.congr;
\import Target.Bundle[F := F, original := bundle, same := same] \as OriginalClass;
\import Target.Pullback[Y := X, space := source, sourceCompact := compact, sourceHausdorff := hausdorff,
  f := Section.section, regular := Section.continuous] \as KPull;
\import KPull.Of[F := F, original := bundle, same := same] \as KOf;
\definition classRestriction: KPull.K0[].map value = class :=
  trans!{{Source.K0[].Carrier}} _ _ _ (KPull.K0[].onIncludes OriginalClass.value)
    (congr!{{Source.Classes} {Source.K0[].Carrier}} Source.K0[].include _ _ KOf.naturality);
\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar].For[X := X, F := Fiber, bundle := restriction] \as Complements;
\definition embeddingExists: \exists Complements.Embedding := Complements.embeddingExists compact hausdorff;
\module With(embedding: Complements.Embedding);
