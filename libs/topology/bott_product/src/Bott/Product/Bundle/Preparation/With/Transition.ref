\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Hemisphere[].Boundary[] \as Boundary;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Hemisphere[].Negative[] \as Negative;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Bundle[F := Product.Fiber, bundle := Product.stabilized, same := same].Hemisphere[].Negative[] \as NegativeBundle;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Bundle[F := F, bundle := bundle, same := same].Preparation[].With[embedding := embedding].Negative[] \as NegativePreparation;
\import uniform_approximation.Approximation[].Circle[].Coefficients[X := X, space := source, baseCompact := compact, baseHausdorff := hausdorff] \as Circle;
\import bundle_homotopy.Homotopy[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar] \as Homotopy;
\import Homotopy.For[Y := Carrier, F := Product.Fiber, bundle := Product.stabilized].Pullbacks[
  X := Boundary.Carrier, source := Boundary.topology, compact := Circle.domainCompact, hausdorff := Circle.domainHausdorff] \as BoundaryPullbacks;
\definition positiveMap: BoundaryPullbacks.Map := \into[Boundary.Carrier -> Carrier]((\fun (p: Boundary.Carrier) => Half.included (Boundary.intoDisk p)),
  { f: Boundary.Carrier -> Carrier \where topology.Continuity[A := Boundary.Carrier, B := Carrier].Continuous Boundary.topology Product.stabilized.baseSpace f }) \by {
  topology.Composition[A := Boundary.Carrier, B := Half.Carrier, C := Carrier].composeContinuous Boundary.topology Half.topology Product.stabilized.baseSpace
    Boundary.intoDisk Half.included Boundary.intoDiskContinuous Hemisphere.includedRegular
};
\definition negativeMap: BoundaryPullbacks.Map := \into[Boundary.Carrier -> Carrier]((\fun (p: Boundary.Carrier) => Negative.included (Boundary.intoDisk p)),
  { f: Boundary.Carrier -> Carrier \where topology.Continuity[A := Boundary.Carrier, B := Carrier].Continuous Boundary.topology Product.stabilized.baseSpace f }) \by {
  topology.Composition[A := Boundary.Carrier, B := Half.Carrier, C := Carrier].composeContinuous Boundary.topology Half.topology Product.stabilized.baseSpace
    Boundary.intoDisk Negative.included Boundary.intoDiskContinuous NegativeBundle.includedRegular
};
\definition mapsEqual: positiveMap = negativeMap := Boundary.mapsEqual;
\definition PositiveIsomorphism: \Set := Bundles.Isomorphisms[X := Half.Carrier, F := HalfFiber, G := TrivialFiber,
  source := Pullbacks.bundleAt Hemisphere.included, target := HalfTrivial.bundle].Isomorphism;
\definition NegativeIsomorphism: \Set := Bundles.Isomorphisms[X := Half.Carrier, F := (\fun (p: Half.Carrier) => Product.Fiber (Negative.included p)), G := TrivialFiber,
  source := Pullbacks.bundleAt NegativeBundle.included, target := HalfTrivial.bundle].Isomorphism;
\module With(positive: PositiveIsomorphism, negative: NegativeIsomorphism);
