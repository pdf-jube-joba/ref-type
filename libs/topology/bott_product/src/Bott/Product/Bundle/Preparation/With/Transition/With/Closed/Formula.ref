\import Eq.Transport[A := Carrier] \as FiberTransport;
\definition origin: Carrier := Half.included (Cover.positiveToDisk p);
\definition equality: origin = p := Cover.positiveRecovery p;
\definition backward[v: Product.Fiber p]: Product.Fiber origin := FiberTransport.cast Product.Fiber p origin (sym!{Carrier} _ _ equality) v;
\import \parent.Transport[] \as Transport;
\definition forward: \forall (v: Product.Fiber p) -> (positiveTrivialization.forward.fiber p).apply v =
  (positive.forward.fiber (Cover.positiveToDisk p)).apply (backward v) := \fun (v: Product.Fiber p) =>
  trans!{{Vectors.Vector}} _ _ _
    (congr!{{Product.Fiber p} {Vectors.Vector}} (positiveTrivialization.forward.fiber p).apply _ _
      (sym!{{Product.Fiber p}} _ _ (FiberTransport.castInverse Product.Fiber p origin (sym!{Carrier} _ _ equality) v)))
    (Transport.At[f := directMap, g := inclusionMap, iso := directPositive, p := p, v := backward v].forward sameMaps);
