\import Eq.Transport[A := Carrier] \as FiberTransport;
\definition origin: Carrier := Negative.included (Cover.negativeToDisk p);
\definition equality: origin = p := Cover.negativeRecovery p;
\definition backward[v: Product.Fiber p]: Product.Fiber origin := FiberTransport.cast Product.Fiber p origin (sym!{Carrier} _ _ equality) v;
\import \parent.Transport[] \as Transport;
\definition forward: \forall (v: Product.Fiber p) -> (negativeTrivialization.forward.fiber p).apply v =
  (negative.forward.fiber (Cover.negativeToDisk p)).apply (backward v) := \fun (v: Product.Fiber p) =>
  trans!{{Vectors.Vector}} _ _ _
    (congr!{{Product.Fiber p} {Vectors.Vector}} (negativeTrivialization.forward.fiber p).apply _ _
      (sym!{{Product.Fiber p}} _ _ (FiberTransport.castInverse Product.Fiber p origin (sym!{Carrier} _ _ equality) v)))
    (Transport.At[f := directMap, g := inclusionMap, iso := directNegative, p := p, v := backward v].forward sameMaps);
