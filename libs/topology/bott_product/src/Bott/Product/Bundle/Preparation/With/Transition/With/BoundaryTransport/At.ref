\definition reflCase: \forall (same: f = f) -> ((move f f iso same).forward.fiber p).apply (FiberTransport.cast Product.Fiber (f p) (f p)
  (congr!{BoundaryPullbacks.Map Carrier} (\fun (h: BoundaryPullbacks.Map) => h p) _ _ same) v) = (iso.forward.fiber p).apply v :=
  \fun (same: f = f) => trans!{{Vectors.Vector}} _ _ _
    (congr!{{Product.Fiber (f p)} {Vectors.Vector}} ((move f f iso same).forward.fiber p).apply _ _ (FiberTransport.castRefl Product.Fiber (f p) v))
    (congr!{{Isomorphism f} {Vectors.Vector}} (\fun (j: Isomorphism f) => (j.forward.fiber p).apply v) _ _
      (\transporteq f \with h: BoundaryPullbacks.Map => Isomorphism h \by { base: iso }));
\definition forward: \forall (equal: f = g) -> ((move f g iso equal).forward.fiber p).apply (FiberTransport.cast Product.Fiber (f p) (g p)
  (congr!{BoundaryPullbacks.Map Carrier} (\fun (h: BoundaryPullbacks.Map) => h p) _ _ equal) v) = (iso.forward.fiber p).apply v :=
  \fun (equal: f = g) => (\idelim f = g \with h: BoundaryPullbacks.Map => \forall (same: f = h) ->
    ((move f h iso same).forward.fiber p).apply (FiberTransport.cast Product.Fiber (f p) (h p)
      (congr!{BoundaryPullbacks.Map Carrier} (\fun (k: BoundaryPullbacks.Map) => k p) _ _ same) v) = (iso.forward.fiber p).apply v \by {
      base: reflCase, equality: equal
    }) equal;
