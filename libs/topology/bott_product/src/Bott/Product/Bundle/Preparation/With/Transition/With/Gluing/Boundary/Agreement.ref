\import \parent.Frame[v := v] \as Frame;
\import Clutch.Boundary[x := overlap] \as TargetFrame;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := C.Algebra[].commutativeRing] \as Spaces;
\import Spaces.Isomorphism[V := Clutched.Fiber p, W := Vectors.Vector, source := Clutched.bundle.space p, target := Vectors.space] \as FrameIso;
\definition agrees: (left.forward.fiber leftPoint).apply v = (right.forward.fiber rightPoint).apply v := FrameIso.injective
  ((Clutch.chart Bool.Bool^::true).frame TargetFrame.rightPoint) _ _ (eq_reason_in!{{Vectors.Vector} _
    "=" _ "by" { TargetFrame.transition ((Closed.positiveTrivialization.forward.fiber leftPoint).apply v) }
    "=" _ "by" { action ((Closed.positiveTrivialization.forward.fiber leftPoint).apply v) }
    "=" _ "by" { Frame.equation }
    "=" _ "by" { sym!{{Vectors.Vector}} _ _ ((FrameIso.laws ((Clutch.chart Bool.Bool^::true).frame TargetFrame.rightPoint)).rightInverse
      ((NegativeSide.negativeTrivialization.forward.fiber rightPoint).apply v)) }
  });
