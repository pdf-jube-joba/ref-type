\import std.Logic[].Equality[] \as Eq;
\use Eq.sym;
\use Eq.trans;
\use Eq.congr;
\import Eq.Transport[A := Carrier] \as FiberTransport;
\definition Isomorphism[f: NegativePullbacks.Map]: \Set := Bundles.Isomorphisms[X := Cover.NegativeCarrier, F := NegativePullbacks.Fiber f, G := NegativeVector,
  source := NegativePullbacks.bundleAt f, target := NegativeTrivial.bundle].Isomorphism;
\definition move[f, g: NegativePullbacks.Map][iso: Isomorphism f][equal: f = g]: Isomorphism g :=
  \idelim f = g \with h: NegativePullbacks.Map => Isomorphism h \by { base: iso, equality: equal };
\module At(f, g: NegativePullbacks.Map, iso: Isomorphism f, p: Cover.NegativeCarrier, v: Product.Fiber (f p));
