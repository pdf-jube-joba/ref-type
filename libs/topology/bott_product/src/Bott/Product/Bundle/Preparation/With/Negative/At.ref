\import Homotopy.PullbackIsomorphism[X := X,
  F := (\fun (x: X) => Product.Fiber (PointComparison.first x)), G := (\fun (x: X) => Product.Fiber (PointComparison.second x)),
  first := BasePullbacks.bundleAt PointComparison.firstMap, second := BasePullbacks.bundleAt PointComparison.secondMap, iso := iso,
  Y := Half.Carrier, source := Half.topology, f := Half.first, regularFirst := firstRegular, regularSecond := firstRegular] \as PointsPull;
\definition constantTrivialization: Bundles.Isomorphisms[X := Half.Carrier, F := NegativeConstantFiber, G := TrivialFiber,
  source := NegativeNested.direct, target := HalfTrivial.bundle].Isomorphism := Direct.compose NegativeNested.isomorphism
    (WithTrivial.compose (Combine.compose PointsPull.isomorphism PullTrivialization.isomorphism) TrivialPull.isomorphism);
