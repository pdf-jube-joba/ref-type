\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Hemisphere[].Negative[] \as Negative;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Bundle[F := Product.Fiber, bundle := Product.stabilized, same := same].Hemisphere[].Negative[] \as NegativeBundle;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Bundle[F := Product.Fiber, bundle := Product.stabilized, same := same].PointComparison[start := Negative.point, finish := Half.point] \as PointComparison;
\import bundle_homotopy.Homotopy[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar] \as Homotopy;
\import Homotopy.For[Y := Carrier, F := Product.Fiber, bundle := Product.stabilized].Pullbacks[X := X, source := source, compact := compact, hausdorff := hausdorff] \as BasePullbacks;
\import Bundles.Family[X := Carrier, F := Product.Fiber].Of[bundle := Product.stabilized].PullbackComposition[Y := X, Z := Half.Carrier,
  first := source, second := Half.topology, f := PointComparison.first, g := Half.first].Of[
    fRegular := PointComparison.firstRegular, gRegular := firstRegular] \as NegativeNested;
\definition NegativeConstantFiber[p: Half.Carrier]: \Set := Product.Fiber (Negative.constant p);
\definition NegativeFiber[p: Half.Carrier]: \Set := Product.Fiber (Negative.included p);
\import Operations.IsomorphismComposition[X := Half.Carrier, F := NegativeConstantFiber, G := BaseFiber, H := TrivialFiber,
  source := NegativeNested.nested, middle := Nested.nested, target := PullTrivialization.secondBundle] \as Combine;
\import Operations.IsomorphismComposition[X := Half.Carrier, F := NegativeConstantFiber, G := TrivialFiber, H := TrivialFiber,
  source := NegativeNested.nested, middle := PullTrivialization.secondBundle, target := HalfTrivial.bundle] \as WithTrivial;
\import Operations.IsomorphismComposition[X := Half.Carrier, F := NegativeConstantFiber, G := NegativeConstantFiber, H := TrivialFiber,
  source := NegativeNested.direct, middle := NegativeNested.nested, target := HalfTrivial.bundle] \as Direct;
\import Operations.IsomorphismComposition[X := Half.Carrier, F := NegativeFiber, G := NegativeConstantFiber, H := TrivialFiber,
  source := Pullbacks.bundleAt NegativeBundle.included, middle := NegativeNested.direct, target := HalfTrivial.bundle] \as Result;
\module At(iso: BasePullbacks.Isomorphism PointComparison.firstMap PointComparison.secondMap);
\definition trivializationExists: \exists Bundles.Isomorphisms[X := Half.Carrier, F := NegativeFiber, G := TrivialFiber,
  source := Pullbacks.bundleAt NegativeBundle.included, target := HalfTrivial.bundle].Isomorphism := \block {
  \takefrom iso: BasePullbacks.Isomorphism PointComparison.firstMap PointComparison.secondMap \by PointComparison.isomorphismExists \then
  \return Result.exists NegativeBundle.isomorphismExists (\exact(At[iso := iso].constantTrivialization,
    Bundles.Isomorphisms[X := Half.Carrier, F := NegativeConstantFiber, G := TrivialFiber, source := NegativeNested.direct, target := HalfTrivial.bundle].Isomorphism))
};
