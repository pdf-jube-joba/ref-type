  Final.exists Hemisphere.isomorphismExists (\exact(constantTrivialization, Bundles.Isomorphisms[X := Half.Carrier, F := BaseFiber, G := TrivialFiber, source := Nested.direct, target := HalfTrivial.bundle].Isomorphism));
