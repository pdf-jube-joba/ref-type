\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Bundle[F := F, bundle := bundle, same := same].At[point := Half.point].With[embedding := embedding] \as Stable;
\import Stable.OnProduct[] \as Product;
