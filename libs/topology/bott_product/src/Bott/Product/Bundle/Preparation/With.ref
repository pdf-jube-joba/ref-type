\definition constantTrivialization: Bundles.Isomorphisms[X := Half.Carrier, F := BaseFiber, G := TrivialFiber, source := Nested.direct, target := HalfTrivial.bundle].Isomorphism :=
  Second.compose (First.compose Nested.isomorphism PullTrivialization.isomorphism) TrivialPull.isomorphism;
\import bundle_homotopy.Homotopy[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar].For[Y := Carrier, F := Product.Fiber, bundle := Product.stabilized].Pullbacks[
  X := Half.Carrier, source := Half.topology, compact := Half.compactDisk, hausdorff := Half.hausdorffDisk] \as Pullbacks;
