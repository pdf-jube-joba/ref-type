\import Bundles.Trivial[X := X, n := embedding.dimension, baseSpace := source] \as BaseTrivial;
\import Bundles.Trivial[X := Half.Carrier, n := embedding.dimension, baseSpace := Half.topology] \as HalfTrivial;
\import Bundles.Family[X := Carrier, F := Product.Fiber].Of[bundle := Product.stabilized].Pullback[Y := X, source := source,
  f := (\fun (x: X) => Pair.pair X Sphere.Sphere x Half.point)] \as BasePull;
\definition firstRegular: topology.Continuity[A := Half.Carrier, B := X].Continuous Half.topology source Half.first := ProductDisk.Maps[].firstContinuous source Disk.diskTopology;
\import bundle_homotopy.Homotopy[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar].PullbackIsomorphism[X := X,
  F := (\fun (x: X) => Product.Fiber (Pair.pair X Sphere.Sphere x Half.point)), G := (\fun (_: X) => Vectors.Vector),
  first := BasePull.pulled At.regular, second := BaseTrivial.bundle, iso := Restriction.trivialization,
  Y := Half.Carrier, source := Half.topology, f := Half.first, regularFirst := firstRegular, regularSecond := firstRegular] \as PullTrivialization;
\import Operations.TrivialPullback[X := X, Y := Half.Carrier, n := embedding.dimension, original := source, base := Half.topology,
  f := Half.first, regular := firstRegular] \as TrivialPull;
\definition BaseFiber[p: Half.Carrier]: \Set := Product.Fiber (Half.constant p);
\definition TrivialFiber[p: Half.Carrier]: \Set := Vectors.Vector;
\import Operations.IsomorphismComposition[X := Half.Carrier, F := BaseFiber, G := BaseFiber, H := TrivialFiber,
  source := Nested.direct, middle := Nested.nested, target := PullTrivialization.secondBundle] \as First;
\import Operations.IsomorphismComposition[X := Half.Carrier, F := BaseFiber, G := TrivialFiber, H := TrivialFiber,
