\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Hemisphere[] \as Half;
\import bundle_homotopy.Homotopy[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar].For[Y := Carrier, F := F, bundle := bundle].Pullbacks[
  X := Half.Carrier, source := Half.topology, compact := Half.compactDisk, hausdorff := Half.hausdorffDisk] \as Pullbacks;
\definition includedRegular: topology.Continuity[A := Half.Carrier, B := Carrier].Continuous Half.topology bundle.baseSpace Half.included :=
  \idelim topology = bundle.baseSpace \with t: topology.Topology[Carrier := Carrier].Topology => topology.Continuity[A := Half.Carrier, B := Carrier].Continuous Half.topology t Half.included \by {
    base: Half.includedContinuous, equality: sym!{{topology.Topology[Carrier := Carrier].Topology}} _ _ same
  };
\definition constantRegular: topology.Continuity[A := Half.Carrier, B := Carrier].Continuous Half.topology bundle.baseSpace Half.constant :=
  \idelim topology = bundle.baseSpace \with t: topology.Topology[Carrier := Carrier].Topology => topology.Continuity[A := Half.Carrier, B := Carrier].Continuous Half.topology t Half.constant \by {
    base: Half.constantContinuous, equality: sym!{{topology.Topology[Carrier := Carrier].Topology}} _ _ same
  };
\definition included: Pullbacks.Map := \into[Half.Carrier -> Carrier](Half.included, { f: Half.Carrier -> Carrier \where topology.Continuity[A := Half.Carrier, B := Carrier].Continuous Half.topology bundle.baseSpace f }) \by { includedRegular };
\definition constant: Pullbacks.Map := \into[Half.Carrier -> Carrier](Half.constant, { f: Half.Carrier -> Carrier \where topology.Continuity[A := Half.Carrier, B := Carrier].Continuous Half.topology bundle.baseSpace f }) \by { constantRegular };
\import algebraic_topology.Homotopy[A := Half.Carrier, B := Carrier] \as H;
\definition homotopy: H.Homotopy[Half.topology, bundle.baseSpace, included, constant] :=
  \idelim topology = bundle.baseSpace \with t: topology.Topology[Carrier := Carrier].Topology => H.Homotopy[Half.topology, t, Half.included, Half.constant] \by {
    base: Half.homotopy, equality: sym!{{topology.Topology[Carrier := Carrier].Topology}} _ _ same
  };
\definition isomorphismExists: \exists Pullbacks.Isomorphism included constant := Pullbacks.homotopic included constant
  (\exact(homotopy, H.Homotopy[Half.topology, bundle.baseSpace, included, constant]));
\module Negative;
