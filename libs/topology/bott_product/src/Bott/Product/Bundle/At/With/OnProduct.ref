\import bundle_operations.Operations[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := linear_algebra.Hermitian[].Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar] \as Operations;
\import Bundles.Family[X := X, F := ComplementFiber].Of[bundle := complement].Pullback[Y := Carrier, source := topology, f := first] \as Pull;
\definition PulledFiber[p: Carrier]: \Set := ComplementFiber (first p);
\definition pulled: Bundles.Family[X := Carrier, F := PulledFiber].Bundle := Pull.pulled (Space.Maps[].firstContinuous source Sphere.sphereTopology);
\import Operations.DirectSum[X := Carrier, F := F, G := PulledFiber, left := bundle, right := pulled] \as Sum;
\definition Fiber: Carrier -> \Set := Sum.Fiber;
\definition stabilized: Bundles.Family[X := Carrier, F := Fiber].Bundle := Sum.bundle same;
\module Restriction;
