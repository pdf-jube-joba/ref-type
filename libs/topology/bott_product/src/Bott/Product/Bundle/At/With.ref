\import Complements.FromEmbedding[embedding := embedding].Complement[] \as Complement;
\definition ComplementFiber: X -> \Set := Complement.ComplementFiber;
\definition complement: Bundles.Family[X := X, F := ComplementFiber].Bundle := Complement.complementBundle;
\definition StabilizedFiber: X -> \Set := Complement.SourceFiber;
\definition stabilized: Bundles.Family[X := X, F := StabilizedFiber].Bundle := Complement.sumBundle;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := C.Algebra[].commutativeRing].Coordinates[I := std.Data[].FinSet[].Fin embedding.dimension] \as Vectors;
\import Bundles.Trivial[X := X, n := embedding.dimension, baseSpace := source] \as Trivial;
\definition trivialization: Bundles.Isomorphisms[X := X, F := StabilizedFiber, G := (\fun (_: X) => Vectors.Vector), source := stabilized, target := Trivial.bundle].Isomorphism := Complement.isomorphism;
\module OnProduct;
