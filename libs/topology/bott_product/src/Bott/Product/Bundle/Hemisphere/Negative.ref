\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Hemisphere[].Negative[] \as Negative;
\definition includedRegular: topology.Continuity[A := Half.Carrier, B := Carrier].Continuous Half.topology bundle.baseSpace Negative.included :=
  \idelim topology = bundle.baseSpace \with t: topology.Topology[Carrier := Carrier].Topology => topology.Continuity[A := Half.Carrier, B := Carrier].Continuous Half.topology t Negative.included \by {
    base: Negative.includedContinuous, equality: sym!{{topology.Topology[Carrier := Carrier].Topology}} _ _ same
  };
\definition constantRegular: topology.Continuity[A := Half.Carrier, B := Carrier].Continuous Half.topology bundle.baseSpace Negative.constant :=
  \idelim topology = bundle.baseSpace \with t: topology.Topology[Carrier := Carrier].Topology => topology.Continuity[A := Half.Carrier, B := Carrier].Continuous Half.topology t Negative.constant \by {
    base: Negative.constantContinuous, equality: sym!{{topology.Topology[Carrier := Carrier].Topology}} _ _ same
  };
\definition included: Pullbacks.Map := \into[Half.Carrier -> Carrier](Negative.included, { f: Half.Carrier -> Carrier \where topology.Continuity[A := Half.Carrier, B := Carrier].Continuous Half.topology bundle.baseSpace f }) \by { includedRegular };
\definition constant: Pullbacks.Map := \into[Half.Carrier -> Carrier](Negative.constant, { f: Half.Carrier -> Carrier \where topology.Continuity[A := Half.Carrier, B := Carrier].Continuous Half.topology bundle.baseSpace f }) \by { constantRegular };
\import algebraic_topology.Homotopy[A := Half.Carrier, B := Carrier] \as H;
\definition homotopy: H.Homotopy[Half.topology, bundle.baseSpace, included, constant] :=
  \idelim topology = bundle.baseSpace \with t: topology.Topology[Carrier := Carrier].Topology => H.Homotopy[Half.topology, t, Negative.included, Negative.constant] \by {
    base: Negative.homotopy, equality: sym!{{topology.Topology[Carrier := Carrier].Topology}} _ _ same
  };
\definition isomorphismExists: \exists Pullbacks.Isomorphism included constant := Pullbacks.homotopic included constant
  (\exact(homotopy, H.Homotopy[Half.topology, bundle.baseSpace, included, constant]));
