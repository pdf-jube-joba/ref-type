\import std.Logic[].Equality[] \as Eq;
\use Eq.trans;
\use Eq.congr;
\import algebra.Group[].Of[Carrier := Source.K0[].Carrier, group := Source.K0[].group] \as SourceGroup;
\import algebra.Group[].Of[Carrier := Target.K0[].Carrier, group := Target.K0[].group] \as TargetGroup;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Additive[] \as Additive;
\module At(p: Target.Presentation);
\module With(v: Target.K0[].Carrier, form: Target.K0[].NormalForm[].Result[v]);
\definition exists: \forall (v: Target.K0[].Carrier) -> \exists Representation[v] := \block {
  \fun (v: Target.K0[].Carrier) \then
  \takefrom form: Target.K0[].NormalForm[].Result[v] \by Target.K0[].NormalForm[].existence v \then
  \return With[v := v, form := form].exists
};
