\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Surjective[] \as Surjective;
\definition kernelImage: \forall (v: Target.K0[].Carrier) -> Pull.K0[].map v = Source.K0[].zero ->
  \exists (b: Source.K0[].Carrier \where forward Source.K0[].zero b = v) := \block {
  \fun (v: Target.K0[].Carrier)(zero: Pull.K0[].map v = Source.K0[].zero) \then
  \takefrom representation: Representation[v] \by Surjective.exists v \then
  \let constantZero: representation.constant = Source.K0[].zero := trans!{Source.K0[].Carrier} _ _ _
    (sym!{Source.K0[].Carrier} _ _ (restrictForward representation.constant representation.coefficient))
    (trans!{Source.K0[].Carrier} _ _ _ (congr!{Target.K0[].Carrier Source.K0[].Carrier} Pull.K0[].map _ _ representation.equation) zero) \then
  \return \exact(\into[Source.K0[].Carrier](representation.coefficient, { b: Source.K0[].Carrier \where forward Source.K0[].zero b = v }) \by {
    trans!{Target.K0[].Carrier} _ _ _ (congr!{Source.K0[].Carrier Target.K0[].Carrier} (\fun (a: Source.K0[].Carrier) => forward a representation.coefficient) _ _ (sym!{Source.K0[].Carrier} _ _ constantZero)) representation.equation
  }, \Cast[Source.K0[].Carrier] ({ b: Source.K0[].Carrier \where forward Source.K0[].zero b = v }))
};
\definition imageKernel: \forall (b: Source.K0[].Carrier) -> Pull.K0[].map (forward Source.K0[].zero b) = Source.K0[].zero :=
  \fun (b: Source.K0[].Carrier) => restrictForward Source.K0[].zero b;
