\import relative_k_theory.Relative[].Pair[X := Carrier, space := topology, compact := productCompact, hausdorff := productHausdorff,
  subset := subset, closed := closed] \as PairRelative;
\import PairRelative.Restriction[] \as Restriction;
\import PairRelative.Augmented[].OrdinaryEnd[] \as End;
\import Target.Pullback[Y := Slice, space := sliceTopology, sourceCompact := Restriction.compactSubset, sourceHausdorff := Restriction.hausdorffSubset,
  f := Restriction.inclusion, regular := Restriction.regular].Composition[Z := X, nextSpace := source, nextCompact := compact, nextHausdorff := hausdorff,
  g := into, nextRegular := intoContinuous] \as Composition;
\import topological_k_theory.KTheory[].On[X := Slice, baseSpace := sliceTopology, compact := Restriction.compactSubset, hausdorff := Restriction.hausdorffSubset].Pullback[
  Y := X, space := source, sourceCompact := compact, sourceHausdorff := hausdorff, f := into, regular := intoContinuous] \as ToX;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].At[point := point].Kernel[] \as Kernel;
\definition restrictionKernel: \forall (v: End.Third) -> Pull.K0[].map (End.forget v) = Source.K0[].zero :=
  \fun (v: End.Third) => trans!{Source.K0[].Carrier} _ _ _ (Composition.onK0 (End.forget v))
    (trans!{Source.K0[].Carrier} _ _ _ (congr!{End.Fifth Source.K0[].Carrier} ToX.K0[].map _ _ (sym!{End.Fifth} _ _ (End.restrictionFormula (End.forget v))))
      (trans!{Source.K0[].Carrier} _ _ _ (congr!{End.Fifth Source.K0[].Carrier} ToX.K0[].map _ _ (End.ordinaryKernel v)) ToX.K0[].preservesZero));
\definition imageRepresentation: \forall (v: End.Third) -> \exists (b: Source.K0[].Carrier \where forward Source.K0[].zero b = End.forget v) :=
  \fun (v: End.Third) => Kernel.kernelImage (End.forget v) (restrictionKernel v);
\module Retraction;
