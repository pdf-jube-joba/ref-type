\import std.Logic[].Equality[] \as Eq;
\use Eq.trans;
\use Eq.sym;
\use Eq.congr;
\import algebra.Group[].Of[Carrier := Source.K0[].Carrier, group := Source.K0[].group] \as Group;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Hopf[] \as ProductHopf;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].At[point := point].Slice[].Relative[].Retraction[].Comparison[] \as Original;
\definition lift[a: Source.K0[].Carrier]: End.Third := Original.lift (Source.K0[].neg a);
\definition coefficient[v: End.Third]: Source.K0[].Carrier := Source.K0[].neg (Original.coefficient v);
\definition forgetLift: \forall (a: Source.K0[].Carrier) -> End.forget (lift a) = ProductHopf.forward Source.K0[].zero a :=
  \fun (a: Source.K0[].Carrier) => trans!{End.Fourth} _ _ _ (Original.forgetLift (Source.K0[].neg a))
    (sym!{End.Fourth} _ _ (ProductHopf.formula Source.K0[].zero a));
\definition leftInverse: \forall (a: Source.K0[].Carrier) -> coefficient (lift a) = a :=
  \fun (a: Source.K0[].Carrier) => trans!{Source.K0[].Carrier} _ _ _
    (congr!{Source.K0[].Carrier Source.K0[].Carrier} Source.K0[].neg _ _ (Original.leftInverse (Source.K0[].neg a))) (Group.negNeg a);
\definition rightInverse: \forall (v: End.Third) -> lift (coefficient v) = v :=
  \fun (v: End.Third) => trans!{End.Third} _ _ _
    (congr!{Source.K0[].Carrier End.Third} Original.lift _ _ (Group.negNeg (Original.coefficient v))) (Original.rightInverse v);
\definition liftAdd: \forall (a, b: Source.K0[].Carrier) -> lift (Source.K0[].add a b) = End.thirdGroup.base.op (lift a) (lift b) :=
  \fun (a, b: Source.K0[].Carrier) => trans!{End.Third} _ _ _
    (congr!{Source.K0[].Carrier End.Third} Original.lift _ _ (Group.negAdd a b)) (Original.liftAdd (Source.K0[].neg a) (Source.K0[].neg b));
\definition coefficientAdd: \forall (v, w: End.Third) -> coefficient (End.thirdGroup.base.op v w) = Source.K0[].add (coefficient v) (coefficient w) :=
  \fun (v, w: End.Third) => trans!{Source.K0[].Carrier} _ _ _
    (congr!{Source.K0[].Carrier Source.K0[].Carrier} Source.K0[].neg _ _ (Original.coefficientAdd v w)) (Group.negAdd (Original.coefficient v) (Original.coefficient w));
