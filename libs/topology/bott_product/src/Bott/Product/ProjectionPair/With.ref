\import Left.With[parameters := first] \as LeftRecovery;
\import Right.With[parameters := second] \as RightRecovery;
\definition injective: forward Source.K0[].zero (Source.K0[].include (Source.class left)) =
  forward Source.K0[].zero (Source.K0[].include (Source.class right)) -> Source.K0[].include (Source.class left) = Source.K0[].include (Source.class right) :=
  \fun (equal: _) => \block {
    \let reducedEqual: Target.K0[].difference LeftClass.value Rank.value = Target.K0[].difference RightClass.value Rank.value :=
      trans!{Target.K0[].Carrier} _ _ _ LeftRecovery.reconstruction
        (trans!{Target.K0[].Carrier} _ _ _ equal (sym!{Target.K0[].Carrier} _ _ RightRecovery.reconstruction)) \then
    \let stableEqual: Target.K0[].include LeftClass.value = Target.K0[].include RightClass.value :=
      TargetGroup.cancelRight (Target.K0[].neg (Target.K0[].include Rank.value))
        (Target.K0[].include LeftClass.value) (Target.K0[].include RightClass.value) reducedEqual \then
    \return trans!{Source.K0[].Carrier} _ _ _ (sym!{Source.K0[].Carrier} _ _ Left.inverseClass)
      (trans!{Source.K0[].Carrier} _ _ _ (Stability.invariant stableEqual) Right.inverseClass)
  };
