\definition left: Source.Presentation := Source.Presentation { dimension := n, projection := P, regular := regularP };
\definition right: Source.Presentation := Source.Presentation { dimension := m, projection := Q, regular := regularQ };
\definition injective: n = m -> forward Source.K0[].zero (Source.K0[].include (Source.class left)) =
  forward Source.K0[].zero (Source.K0[].include (Source.class right)) -> Source.K0[].include (Source.class left) = Source.K0[].include (Source.class right) :=
  \fun (same: n = m) => (\idelim n = m \with k: N.Nat^ =>
    \forall (T: X -> Hermitian.At[n := k].Projection)(regularT: Hermitian.At[n := k].Families[X := X].Matrix[m := k].Regular source (\fun (x: X) => (T x).map)) ->
      forward Source.K0[].zero (Source.K0[].include (Source.class left)) =
      forward Source.K0[].zero (Source.K0[].include (Source.class (Source.Presentation { dimension := k, projection := T, regular := regularT }))) ->
      Source.K0[].include (Source.class left) = Source.K0[].include (Source.class (Source.Presentation { dimension := k, projection := T, regular := regularT })) \by {
      base: \fun (T: X -> Hermitian.At[n := n].Projection)(regularT: Hermitian.At[n := n].Families[X := X].Matrix[m := n].Regular source (\fun (x: X) => (T x).map)) =>
        \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].ProjectionPair[n := n, P := P, Q := T, regularP := regularP, regularQ := regularT].injectiveOnPresentations,
      equality: same
    }) Q regularQ;
