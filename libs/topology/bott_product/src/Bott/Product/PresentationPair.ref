\import std.Logic[].Equality[] \as Eq;
\use Eq.trans;
\use Eq.sym;
\use Eq.congr;
\import N.Basic[].Prop[] \as NatLaws;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Padding[p := p, m := q.dimension] \as Left;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Padding[p := q, m := p.dimension] \as Right;
\import Left.Bundle[] \as LeftBundle;
\import Right.Bundle[] \as RightBundle;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].ProjectionComparison[
  n := Left.dimension, m := Right.dimension, P := Left.projection, Q := Right.projection, regularP := Left.regular, regularQ := Right.regular] \as Comparison;
\definition sameDimension: Left.dimension = Right.dimension := NatLaws.addComm q.dimension p.dimension;
\definition injective: forward Source.K0[].zero (Source.K0[].include (Source.class p)) =
  forward Source.K0[].zero (Source.K0[].include (Source.class q)) -> Source.K0[].include (Source.class p) = Source.K0[].include (Source.class q) :=
  \fun (equal: _) => trans!{Source.K0[].Carrier} _ _ _
    (sym!{Source.K0[].Carrier} _ _ (congr!{Source.Classes Source.K0[].Carrier} Source.K0[].include _ _ LeftBundle.classEquality))
    (trans!{Source.K0[].Carrier} _ _ _ (Comparison.injective sameDimension
      (trans!{Target.K0[].Carrier} _ _ _
        (congr!{Source.Classes Target.K0[].Carrier} (\fun (c: Source.Classes) => forward Source.K0[].zero (Source.K0[].include c)) _ _ LeftBundle.classEquality)
        (trans!{Target.K0[].Carrier} _ _ _ equal
          (congr!{Source.Classes Target.K0[].Carrier} (\fun (c: Source.Classes) => forward Source.K0[].zero (Source.K0[].include c)) _ _ (sym!{Source.Classes} _ _ RightBundle.classEquality)))))
      (congr!{Source.Classes Source.K0[].Carrier} Source.K0[].include _ _ RightBundle.classEquality));
