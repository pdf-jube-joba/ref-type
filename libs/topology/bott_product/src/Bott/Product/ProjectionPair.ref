\import std.Logic[].Equality[] \as Eq;
\use Eq.trans;
\use Eq.sym;
\use Eq.congr;
\definition left: Source.Presentation := Source.Presentation { dimension := n, projection := P, regular := regularP };
\definition right: Source.Presentation := Source.Presentation { dimension := n, projection := Q, regular := regularQ };
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Projection[p := left] \as Left;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Projection[p := right] \as Right;
\import clutching_linearization.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[
  n := n, a := Left.family.matrix, regular := Left.family.regular, nonzero := Left.family.nonzero] \as LeftMatrix;
\import clutching_linearization.Linearization[].On[X := X, source := source, compact := compact, hausdorff := hausdorff].Matrices[
  n := n, a := Right.family.matrix, regular := Right.family.regular, nonzero := Right.family.nonzero] \as RightMatrix;
\import LeftMatrix.Clutched[] \as LeftBundle;
\import RightMatrix.Clutched[] \as RightBundle;
\import LeftBundle.Comparison[b := Right.family.matrix, regularB := Right.family.regular, nonzeroB := Right.family.nonzero].Stable[] \as Stability;
\import Target.Bundle[F := LeftBundle.Fiber, original := LeftBundle.bundle, same := \refl(topology)] \as LeftClass;
\import Target.Bundle[F := RightBundle.Fiber, original := RightBundle.bundle, same := \refl(topology)] \as RightClass;
\import Target.Trivial[n := n] \as Rank;
\import algebra.Group[].Of[Carrier := Target.K0[].Carrier, group := Target.K0[].group] \as TargetGroup;
\module With(first: LeftMatrix.Parameters, second: RightMatrix.Parameters);
\definition injectiveOnPresentations: forward Source.K0[].zero (Source.K0[].include (Source.class left)) =
  forward Source.K0[].zero (Source.K0[].include (Source.class right)) -> Source.K0[].include (Source.class left) = Source.K0[].include (Source.class right) := \block {
  \fun (equal: _) \then
  \takefrom first: LeftMatrix.Parameters \by LeftMatrix.parametersExist \then
  \takefrom second: RightMatrix.Parameters \by RightMatrix.parametersExist \then
  \return With[first := first, second := second].injective equal
};
