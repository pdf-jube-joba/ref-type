\import std.Logic[].Equality[] \as Eq;
\import std.Logic[].Proposition[] \as Logic;
\use Eq.trans;
\use Eq.sym;
\use Eq.congr;
\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Hopf[] \as Original;
\import \root.Bott[].Product[X := Y, source := space, compact := compactY, hausdorff := hausdorffY].Hopf[] \as Pulled;
\import \root.Bott[].Product[X := Y, source := space, compact := compactY, hausdorff := hausdorffY].Injective[] \as Injective;
\import algebra.Group[].Of[Carrier := YK.K0[].Carrier, group := YK.K0[].group] \as Group;
\definition equation: \forall (a, b: Source.K0[].Carrier) -> Pull.K0[].map (Original.forward a b) = Pulled.forward (BasePull.K0[].map a) (BasePull.K0[].map b) :=
  \fun (a, b: Source.K0[].Carrier) => trans!{OtherK.K0[].Carrier} _ _ _
    (congr!{Target.K0[].Carrier OtherK.K0[].Carrier} Pull.K0[].map _ _ (Original.formula a b))
    (trans!{OtherK.K0[].Carrier} _ _ _ (\root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Naturality[Y := Y, space := space,
      compactY := compactY, hausdorffY := hausdorffY, f := f, continuous := continuous].equation a (Source.K0[].neg b))
      (trans!{OtherK.K0[].Carrier} _ _ _ (congr!{YK.K0[].Carrier OtherK.K0[].Carrier} (Other.forward (BasePull.K0[].map a)) _ _ (BasePull.K0[].preservesNeg b))
        (sym!{OtherK.K0[].Carrier} _ _ (Pulled.formula (BasePull.K0[].map a) (BasePull.K0[].map b)))));
\definition inverse: \forall (v: Target.K0[].Carrier) -> Logic.And[
  Pulled.first (Pull.K0[].map v) = BasePull.K0[].map (Original.first v),
  Pulled.coefficient (Pull.K0[].map v) = BasePull.K0[].map (Original.coefficient v)] :=
  \fun (v: Target.K0[].Carrier) => \block {
  \let equal: Logic.And[Pulled.first (Pull.K0[].map v) = BasePull.K0[].map (Original.first v),
    YK.K0[].neg (Pulled.coefficient (Pull.K0[].map v)) = YK.K0[].neg (BasePull.K0[].map (Original.coefficient v))] :=
    Injective.injective (Pulled.first (Pull.K0[].map v)) (YK.K0[].neg (Pulled.coefficient (Pull.K0[].map v)))
    (BasePull.K0[].map (Original.first v)) (YK.K0[].neg (BasePull.K0[].map (Original.coefficient v)))
    (trans!{OtherK.K0[].Carrier} _ _ _ (sym!{OtherK.K0[].Carrier} _ _ (Pulled.formula (Pulled.first (Pull.K0[].map v)) (Pulled.coefficient (Pull.K0[].map v))))
      (trans!{OtherK.K0[].Carrier} _ _ _ (Pulled.reconstruction (Pull.K0[].map v))
        (trans!{OtherK.K0[].Carrier} _ _ _ (congr!{Target.K0[].Carrier OtherK.K0[].Carrier} Pull.K0[].map _ _ (sym!{Target.K0[].Carrier} _ _ (Original.reconstruction v)))
          (trans!{OtherK.K0[].Carrier} _ _ _ (equation (Original.first v) (Original.coefficient v))
            (Pulled.formula (BasePull.K0[].map (Original.first v)) (BasePull.K0[].map (Original.coefficient v))))))) \then
  \return Logic.And[_, _]::# equal.left (trans!{YK.K0[].Carrier} _ _ _
    (sym!{YK.K0[].Carrier} _ _ (Group.negNeg (Pulled.coefficient (Pull.K0[].map v))))
    (trans!{YK.K0[].Carrier} _ _ _ (congr!{YK.K0[].Carrier YK.K0[].Carrier} YK.K0[].neg _ _ equal.right)
      (Group.negNeg (BasePull.K0[].map (Original.coefficient v)))))
};
