\import \root.Bott[].Product[X := X, source := source, compact := compact, hausdorff := hausdorff].Inverse[] \as Original;
\import \root.Bott[].Product[X := Y, source := space, compact := compactY, hausdorff := hausdorffY].Inverse[] \as Pulled;
\import \root.Bott[].Product[X := Y, source := space, compact := compactY, hausdorff := hausdorffY].Injective[] \as Injective;
\import std.Logic[].Proposition[] \as Logic;
\definition naturality: \forall (v: Target.K0[].Carrier) -> Logic.And[
  Pulled.first (Pull.K0[].map v) = BasePull.K0[].map (Original.first v),
  Pulled.coefficient (Pull.K0[].map v) = BasePull.K0[].map (Original.coefficient v)] :=
  \fun (v: Target.K0[].Carrier) => Injective.injective (Pulled.first (Pull.K0[].map v)) (Pulled.coefficient (Pull.K0[].map v))
    (BasePull.K0[].map (Original.first v)) (BasePull.K0[].map (Original.coefficient v))
    (trans!{OtherK.K0[].Carrier} _ _ _ (Pulled.reconstruction (Pull.K0[].map v))
      (trans!{OtherK.K0[].Carrier} _ _ _ (congr!{Target.K0[].Carrier OtherK.K0[].Carrier} Pull.K0[].map _ _ (sym!{Target.K0[].Carrier} _ _ (Original.reconstruction v)))
        (equation (Original.first v) (Original.coefficient v))));
