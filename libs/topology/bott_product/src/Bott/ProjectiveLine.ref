\import grassmannians.ProjectiveComplex[n := two] \as Projective;
\definition Carrier: \Set := Projective.Space;
\definition topology: topology.Topology[Carrier := Carrier].Topology := Projective.topology;
\definition Fiber: Carrier -> \Set := Projective.Line;
\import complex.Complex[] \as C;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := C.Algebra[].field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\definition bundle: Bundles.Family[X := Carrier, F := Fiber].Bundle := Projective.lineBundle;
\import topological_k_theory.KTheory[].On[X := Carrier, baseSpace := topology,
  compact := Projective.compact, hausdorff := Projective.hausdorff] \as K;
\import K.Bundle[F := Fiber, original := bundle, same := \refl(topology)] \as Class;
\definition lineClass: K.Classes := Class.value;
\definition generator: K.K0[].Carrier := K.K0[].difference lineClass K.Line[].value;
\module Rank;
\module Trace;
\module Coordinates;
\module Homeomorphism;
\module SphereLine;
