\import std.Data[].Pair[] \as Pair;
\import topological_constructions.Product[A := X, B := Sphere.Sphere] \as Space;
\import topology.Topology[Carrier := Space.CarrierSet] \as Base;
\definition Carrier: \Set := Space.CarrierSet;
\definition topology: Base.Topology := Space.topology source Sphere.sphereTopology;
\definition first: Carrier -> X := Pair.first X Sphere.Sphere;
\definition second: Carrier -> Sphere.Sphere := Pair.second X Sphere.Sphere;
\definition productCompact: Base.IsCompact topology := Space.Compactness[].productCompact source Sphere.sphereTopology compact Compactness.sphere;
\definition productHausdorff: Base.IsT2 topology := topological_constructions.Separation[].Product[A := X, B := Sphere.Sphere].On[
  left := source, right := Sphere.sphereTopology, leftHausdorff := hausdorff, rightHausdorff := Compactness.sphereHausdorff].hausdorff;
\import topological_k_theory.KTheory[].On[X := X, baseSpace := source, compact := compact, hausdorff := hausdorff] \as Source;
\import topological_k_theory.KTheory[].On[X := Carrier, baseSpace := topology, compact := productCompact, hausdorff := productHausdorff] \as Target;
\import Source.Pullback[Y := Carrier, space := topology, sourceCompact := productCompact, sourceHausdorff := productHausdorff,
  f := first, regular := Space.Maps[].firstContinuous source Sphere.sphereTopology] \as First;
\import K.Pullback[Y := Carrier, space := topology, sourceCompact := productCompact, sourceHausdorff := productHausdorff,
  f := second, regular := Space.Maps[].secondContinuous source Sphere.sphereTopology] \as Second;
\definition generatorOnProduct: Target.K0[].Carrier := Second.K0[].map generator;
\definition forward[a, b: Source.K0[].Carrier]: Target.K0[].Carrier :=
  Target.K0[].add (First.K0[].map a) (Target.K0[].mul (First.K0[].map b) generatorOnProduct);
\module At(point: Sphere.Sphere);
\module Naturality(Y: \Set, space: topology.Topology[Carrier := Y].Topology,
  compactY: topology.Topology[Carrier := Y].IsCompact space, hausdorffY: topology.Topology[Carrier := Y].IsT2 space,
  f: Y -> X, continuous: topology.Continuity[A := Y, B := X].Continuous space source f);
\module Line;
\module Loops(n: N.Nat^,
  a: uniform_approximation.Approximation[].Circle[].Coefficients[X := X, space := source, baseCompact := compact, baseHausdorff := hausdorff].Domain -> matrix_invariants.Ring[K := complex.Complex[].Complex, scalars := complex.Complex[].Algebra[].commutativeRing].At[n := n].Matrix,
  regular: matrix_invariants.Topological[K := complex.Complex[].Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := n].Families[X := uniform_approximation.Approximation[].Circle[].Coefficients[X := X, space := source, baseCompact := compact, baseHausdorff := hausdorff].Domain].Regular uniform_approximation.Approximation[].Circle[].Coefficients[X := X, space := source, baseCompact := compact, baseHausdorff := hausdorff].source a,
  nonzero: \forall (p: uniform_approximation.Approximation[].Circle[].Coefficients[X := X, space := source, baseCompact := compact, baseHausdorff := hausdorff].Domain) -> matrix_invariants.Field[K := complex.Complex[].Complex, field := complex.Complex[].Algebra[].field].At[n := n].Nonzero (a p));
\module Bundle(F: Carrier -> \Set,
  bundle: vector_bundles.Bundles[].Over[K := complex.Complex[].Complex, field := complex.Complex[].Algebra[].field,
    conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Family[X := Carrier, F := F].Bundle,
  same: bundle.baseSpace = topology);
\module Hemisphere;
\module PointPath(start, finish: Sphere.Sphere);
\module Additive;
\structure Representation[v: Target.K0[].Carrier]: \Set := {
  constant: Source.K0[].Carrier,
  coefficient: Source.K0[].Carrier,
  equation: forward constant coefficient = v,
};
\module Surjective;
\module Projection(p: Source.Presentation);
\import hermitian_frames.Hermitian[].Over[K := complex.Complex[].Complex, field := complex.Complex[].Algebra[].field,
  scalar := linear_algebra.Hermitian[].Complex[].scalar, topological := hermitian_frames.Hermitian[].Complex[].topological] \as Hermitian;
\module ProjectionPair(n: N.Nat^, P, Q: X -> Hermitian.At[n := n].Projection,
  regularP: Hermitian.At[n := n].Families[X := X].Matrix[m := n].Regular source (\fun (x: X) => (P x).map),
  regularQ: Hermitian.At[n := n].Families[X := X].Matrix[m := n].Regular source (\fun (x: X) => (Q x).map));
\module ZeroProjection(n: N.Nat^);
