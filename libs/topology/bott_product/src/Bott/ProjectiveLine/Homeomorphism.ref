\import \root.Bott[].ProjectiveLine[].Coordinates[].SphereMap[].Matrix[].Projection[].Comparison[] \as Result;
\definition forward: Carrier -> Sphere.Sphere := Result.homeomorphism.forward;
\definition backward: Sphere.Sphere -> Carrier := Result.homeomorphism.backward;
\definition homeomorphism: topology.Homeomorphism[A := Carrier, B := Sphere.Sphere].Homeomorphism[topology, Sphere.sphereTopology] := Result.homeomorphism;
