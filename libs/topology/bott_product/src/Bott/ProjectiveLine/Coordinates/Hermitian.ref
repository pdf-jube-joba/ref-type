\import std.Logic[].Equality[] \as Eq;
\use Eq.sym;
\use Eq.trans;
\use Eq.congr;
\use Eq.eq_reason_in;
\import hermitian_frames.Hermitian[] \as H;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := H.Complex[].scalar].Finite[n := two] \as E;
\definition conjugate: \forall (p: Carrier)(i, j: Fin.Fin two) -> entry p i j = C.Def[].conj (entry p j i) :=
  \fun (p: Carrier)(i, j: Fin.Fin two) => eq_reason_in!{{C.Complex} _
    "=" _ "by" { sym!{{C.Complex}} _ _ (E.dotBasis i (p.map.apply (E.basis j))) }
    "=" _ "by" { sym!{{C.Complex}} _ _ ((Model.laws p).selfAdjoint (E.basis i) (E.basis j)) }
    "=" _ "by" { E.symmetric (p.map.apply (E.basis i)) (E.basis j) }
    "=" _ "by" { congr!{{C.Complex} {C.Complex}} C.Def[].conj _ _ (E.dotBasis j (p.map.apply (E.basis i))) }
  };
\definition diagonalReal: \forall (p: Carrier)(i: Fin.Fin two) -> entry p i i = C.Def[].ofReal (C.re (entry p i i)) :=
  \fun (p: Carrier)(i: Fin.Fin two) => H.Complex[].scalar.fixedReal (entry p i i)
    (sym!{{C.Complex}} _ _ (conjugate p i i));
