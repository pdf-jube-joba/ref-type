\import std.Logic[].Equality[] \as Eq;
\use Eq.sym;
\use Eq.trans;
\use Eq.congr;
\use Eq.eq_reason_in;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\import \parent.Algebra[] \as Algebra;
\import \parent.Idempotent[] \as Idempotent;
\definition norm: \forall (p: Carrier) -> Sphere.normSquared (coordinates p) = R.one := \fun (p: Carrier) => eq_reason_in!{R.Real _
  "=" _ "by" { Split2.normJoin (height p) (tail p) }
  "=" _ "by" { congr!{R.Real R.Real} (R.add (R.mul (height p) (height p))) _ _
    (Split1.normJoin (horizontal p) (\fun (_: D1.Index) => vertical p)) }
  "=" _ "by" { congr!{R.Real R.Real} (R.add (R.mul (height p) (height p))) _ _
    (congr!{R.Real R.Real} (R.add (R.mul (horizontal p) (horizontal p))) _ _ (Laws.addZeroRight (R.mul (vertical p) (vertical p)))) }
  "=" _ "by" { Algebra.sphereIdentity (C.re (entry p first first)) (C.re (entry p first second)) (C.im (entry p first second)) (Idempotent.realEquation p) }
};
\definition forward[p: Carrier]: Sphere.Sphere := \into[Sphere.Coordinate](coordinates p, Sphere.Boundary) \by { norm p };
\import \root.Bott[].ProjectiveLine[].Coordinates[] \as Native;
\definition continuous: topology.Continuity[A := Carrier, B := Sphere.Sphere].Continuous topology Sphere.sphereTopology forward :=
  topology.Continuity[A := Carrier, B := Sphere.Coordinate].Corestriction[S := Sphere.Boundary].corestrictContinuous topology Sphere.topology forward Native.continuous;
\module Injective;
\module Matrix;
