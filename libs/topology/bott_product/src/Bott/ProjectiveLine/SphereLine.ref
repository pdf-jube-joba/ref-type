\import \root.Bott[].ProjectiveLine[].Homeomorphism[] \as Home;
\definition LineFiber[s: Sphere.Sphere]: \Set := Fiber (Home.backward s);
\import Bundles.Family[X := Carrier, F := Fiber].Of[bundle := bundle].Pullback[Y := Sphere.Sphere, source := Sphere.sphereTopology, f := Home.backward] \as Pull;
\definition lineBundle: Bundles.Family[X := Sphere.Sphere, F := LineFiber].Bundle := Pull.pulled Home.homeomorphism.backwardContinuous;
\import topological_k_theory.KTheory[].On[X := Sphere.Sphere, baseSpace := Sphere.sphereTopology, compact := Compactness.sphere, hausdorff := Compactness.sphereHausdorff] \as SphereK;
\import SphereK.Bundle[F := LineFiber, original := lineBundle, same := \refl(Sphere.sphereTopology)] \as Class;
\definition lineClass: SphereK.Classes := Class.value;
\definition generator: SphereK.K0[].Carrier := SphereK.K0[].difference lineClass SphereK.Line[].value;
\import std.Logic[].Equality[] \as Eq;
\use Eq.trans;
\use Eq.congr;
\import K.Pullback[Y := Sphere.Sphere, space := Sphere.sphereTopology, sourceCompact := Compactness.sphere, sourceHausdorff := Compactness.sphereHausdorff,
  f := Home.backward, regular := Home.homeomorphism.backwardContinuous] \as KPull;
\import KPull.Of[F := Fiber, original := bundle, same := \refl(topology)] \as ClassPull;
\import \root.Bott[].ProjectiveLine[] \as Original;
\definition pulledGenerator: KPull.K0[].map Original.generator = generator := trans!{{SphereK.K0[].Carrier}} _ _ _
  (KPull.K0[].onDifferences Original.lineClass K.Line[].value)
  (congr!{{SphereK.Classes} {SphereK.Classes} {SphereK.K0[].Carrier}} SphereK.K0[].difference _ _ _ _ ClassPull.naturality KPull.Line[].equation);
\module Rank;
\module Projection;
\module Hemisphere;
\module Columns;
\module Equator(s: Sphere.Sphere, positive: \In[Sphere.Sphere] bundle_homotopy.Homotopy[].Over[K := C.Complex, field := C.Algebra[].field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Disks[d := two].Hemispheres[].Cover[].PositiveHalf s,
  negative: \In[Sphere.Sphere] bundle_homotopy.Homotopy[].Over[K := C.Complex, field := C.Algebra[].field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Disks[d := two].Hemispheres[].Cover[].NegativeHalf s);
