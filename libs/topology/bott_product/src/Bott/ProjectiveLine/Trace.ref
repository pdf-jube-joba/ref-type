\import std.Logic[].Equality[] \as Eq;
\use Eq.trans;
\import grassmannians.Complex[n := two, k := one].Model[] \as Model;
\import Model.Trace[] \as Trace;
\definition trace: Carrier -> C.Complex := \fun (p: Carrier) => Trace.trace (Model.projection p);
\definition traceOne: \forall (p: Carrier) -> trace p = C.Def[].one := \fun (p: Carrier) =>
  trans!{{C.Complex}} _ _ _ (Trace.On[P := Model.projection p, r := one].rankTrace (Model.rank p)) (C.Prop[].addZeroRight C.Def[].one);
\use Eq.sym;
\use Eq.congr;
\import \parent.Coordinates[] \as Coordinates;
\definition diagonalSum: \forall (p: Carrier) -> C.Def[].add (Coordinates.entry p Coordinates.first Coordinates.first) (Coordinates.entry p Coordinates.second Coordinates.second) = C.Def[].one :=
  \fun (p: Carrier) => trans!{{C.Complex}} _ _ _
    (congr!{{C.Complex} {C.Complex}} (C.Def[].add (Coordinates.entry p Coordinates.first Coordinates.first)) _ _
      (sym!{{C.Complex}} _ _ (C.Prop[].addZeroRight (Coordinates.entry p Coordinates.second Coordinates.second))))
    (traceOne p);
