\import hermitian_frames.Hermitian[] \as H;
\import \root.Bott[].ProjectiveLine[].Homeomorphism[] \as Home;
\import grassmannians.Complex[n := two, k := one].Model[] \as Model;
\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field, conjugation := H.Complex[].scalar,
  scalar := vector_bundles.Bundles[].Complex[].scalar] \as Complements;
\import Complements.Projection[X := Carrier, n := two, baseSpace := topology, P := Model.projection, regular := Model.regular] \as Original;
\import Original.Pullback[Y := Sphere.Sphere, source := Sphere.sphereTopology, f := Home.backward,
  regularBase := Home.homeomorphism.backwardContinuous] \as Pullback;
\definition Fiber[s: Sphere.Sphere]: \Set := LineFiber s;
\definition bundle: Bundles.Family[X := Sphere.Sphere, F := Fiber].Bundle := Pullback.secondBundle;
\definition isomorphism: Bundles.Isomorphisms[X := Sphere.Sphere, F := LineFiber, G := Fiber,
  source := lineBundle, target := bundle].Isomorphism := Pullback.isomorphism;
