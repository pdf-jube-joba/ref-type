\import std.Logic[].Equality[] \as Eq;
\use Eq.trans;
\use Eq.sym;
\use Eq.congr;
\import \root.Bott[].Powers[] \as Powers;
\import \root.Bott[].Sign[] \as Sign;
\import Product.Powers[z := Powers.z, continuousZ := Powers.regular, unitZ := Powers.unit].At[k := one] \as First;
\import Product.With[a := First.transition, b := Other.value, continuousA := First.regular, continuousB := Other.valueContinuous].Comparison[].KClass[] \as Additivity;
\import SphereK.Compare[F := LineFiber, G := Target.Fiber, first := lineBundle, second := Target.bundle,
  firstSame := \refl(Sphere.sphereTopology), secondSame := \refl(Sphere.sphereTopology)] \as Classes;
\import SphereK.Bundle[F := Target.Fiber, original := Target.bundle, same := \refl(Sphere.sphereTopology)] \as TargetClass;
\definition sign: generator = SphereK.K0[].neg \root.Bott[].generator :=
  trans!{SphereK.K0[].Carrier} _ _ _
    (congr!{SphereK.Classes SphereK.K0[].Carrier} (\fun (c: SphereK.Classes) => SphereK.K0[].difference c SphereK.Line[].value) _ _ (Classes.ofIsomorphism universalIsomorphism))
    (trans!{SphereK.K0[].Carrier} _ _ _
      (congr!{SphereK.Classes SphereK.K0[].Carrier} (\fun (c: SphereK.Classes) => SphereK.K0[].difference TargetClass.value c) _ _ (sym!{SphereK.Classes} _ _ Powers.rankLine))
      Sign.negative);
\import \root.Bott[].Square[] \as Square;
\import algebra.GroupCompletion[].Semiring[M := SphereK.Classes, semiring := SphereK.Semiring[].semiring] \as Ring;
\import algebra.Group[].Of[Carrier := SphereK.K0[].Carrier, group := SphereK.K0[].group] \as Group;
\definition squareZero: SphereK.K0[].mul generator generator = SphereK.K0[].zero :=
  trans!{SphereK.K0[].Carrier} _ _ _ (congr!{SphereK.K0[].Carrier SphereK.K0[].Carrier SphereK.K0[].Carrier} SphereK.K0[].mul _ _ _ _ sign sign)
    (trans!{SphereK.K0[].Carrier} _ _ _ (Ring.mulNegLeft \root.Bott[].generator (SphereK.K0[].neg \root.Bott[].generator))
      (trans!{SphereK.K0[].Carrier} _ _ _ (congr!{SphereK.K0[].Carrier SphereK.K0[].Carrier} SphereK.K0[].neg _ _
        (trans!{SphereK.K0[].Carrier} _ _ _ (Ring.mulComm SphereK.MultiplicativeMonoid[].commutative \root.Bott[].generator (SphereK.K0[].neg \root.Bott[].generator))
          (Ring.mulNegLeft \root.Bott[].generator \root.Bott[].generator)))
        (trans!{SphereK.K0[].Carrier} _ _ _ (Group.negNeg (SphereK.K0[].mul \root.Bott[].generator \root.Bott[].generator)) Square.zero)));
