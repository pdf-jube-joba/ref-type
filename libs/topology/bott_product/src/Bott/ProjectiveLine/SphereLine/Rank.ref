\import std.Logic[].Equality[] \as Eq;
\use Eq.trans;
\use Eq.sym;
\use Eq.congr;
\import std.Arithmetic[].Int[] \as I;
\import \root.Bott[].ProjectiveLine[].Homeomorphism[] \as Home;
\import \root.Bott[].ProjectiveLine[].Rank[] \as OriginalRank;
\import K.Pullback[Y := Sphere.Sphere, space := Sphere.sphereTopology, sourceCompact := Compactness.sphere, sourceHausdorff := Compactness.sphereHausdorff,
  f := Home.backward, regular := Home.homeomorphism.backwardContinuous] \as Pull;
\import Pull.Ranks[] \as Naturality;
\import SphereK.Ranks[] \as Ranks;
\definition zero: \forall (s: Sphere.Sphere) -> Ranks.rank generator s = I.Zero.specification :=
  \fun (s: Sphere.Sphere) => trans!{I.Int^} _ _ _
    (congr!{SphereK.K0[].Carrier I.Int^} (\fun (v: SphereK.K0[].Carrier) => Ranks.rank v s) _ _ (sym!{SphereK.K0[].Carrier} _ _ pulledGenerator))
    (trans!{I.Int^} _ _ _ (Naturality.naturality \root.Bott[].ProjectiveLine[].generator s) (OriginalRank.zero (Home.backward s)));
