\import std.Data[].FinSet[] \as Fin;
\import std.Arithmetic[].Int[] \as I;
\import std.Logic[].Equality[] \as Eq;
\use Eq.trans;
\import topology.Topology[Carrier := Fin.Fin one] \as PointSpace;
\import topological_k_theory.KTheory[].FiniteDiscrete[n := one] \as Finite;
\import topological_k_theory.KTheory[].Point[] \as Point;
\definition map: Fin.Fin one -> Sphere.Sphere := \fun (_: Fin.Fin one) => point;
\definition continuous: topology.Continuity[A := Fin.Fin one, B := Sphere.Sphere].Continuous PointSpace.Discrete Sphere.sphereTopology map :=
  topology.Maps[A := Fin.Fin one, B := Sphere.Sphere].constantContinuous PointSpace.Discrete Sphere.sphereTopology point;
\import K.Pullback[Y := Fin.Fin one, space := PointSpace.Discrete, sourceCompact := Finite.compact, sourceHausdorff := Finite.hausdorff,
  f := map, regular := continuous] \as Pull;
\import K.Ranks[] \as Ranks;
\import topological_k_theory.KTheory[].On[X := Fin.Fin one, baseSpace := PointSpace.Discrete, compact := Finite.compact, hausdorff := Finite.hausdorff] \as PointK;
\import PointK.Ranks[].Reduced[point := Point.point] \as Reduced;
\import Pull.Ranks[] \as Naturality;
\import \parent.Rank[] \as Rank;
\definition value: Point.Carrier := Pull.K0[].map generator;
\definition reduced: Reduced.Carrier := \into[Point.Carrier](value, Reduced.kernel) \by {
  trans!{{I.Int^}} _ _ _ (Naturality.naturality generator Point.point) (Rank.zero point)
};
\definition vanishes: value = PointK.K0[].zero := Point.reducedZero reduced;
