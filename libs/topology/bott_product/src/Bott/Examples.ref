\import \root.Bott[].ProjectiveLine[].Homeomorphism[] \as Projective;
\definition roundTrip: \forall (s: Sphere.Sphere) -> Projective.forward (Projective.backward s) = s := Projective.homeomorphism.rightInverse;
\import \root.Bott[].Rank[] \as Generator;
\definition reducedAt: \forall (s: Sphere.Sphere) -> K.Ranks[].rank generator s = std.Arithmetic[].Int[].Zero.specification := Generator.zero;
