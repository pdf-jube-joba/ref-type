\import Glued.Coordinates[i := i] \as Coordinates;
\import topology.Topology[Carrier := Coordinates.Parameter].Subspace[S := Self.Domain] \as Restrict;
\definition changeEqual: \forall (p: Self.Point) -> Self.change p = p := \fun (p: Self.Point) =>
  Pair.Prop[A := \Cast[X] (domain i), B := Vectors i].ext (Self.change p) p (\refl(Coordinates.base p))
    (Glued.laws.identity (Coordinates.base p) (\into[X](i, { i: X \where Base.Member (domain i) (Coordinates.base p) }) \by { \bysub(X, domain i, Coordinates.base p) }) (Coordinates.vector p));
\definition inclusion[p: Self.Point]: Coordinates.Parameter := p;
\definition regular: Self.Regular :=
  \idelim inclusion = Self.change \with f: (Self.Point -> Coordinates.Parameter) =>
    topology.Continuity[A := Self.Point, B := Coordinates.Parameter].Continuous (Restrict.topology Coordinates.topology) Coordinates.topology f \by {
      base: \fun (U: \Pow Coordinates.Parameter)(open: topology.Topology[Carrier := Coordinates.Parameter].IsOpenIn Coordinates.topology U) => Restrict.traceOpen Coordinates.topology U open,
      equality: \axiom:funext(inclusion, Self.change, \fun (p: Self.Point) => sym!{{Coordinates.Parameter}} _ _ (changeEqual p))
    };
