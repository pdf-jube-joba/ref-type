\import std.Arithmetic[].Int[] \as I;
\import I.Math[] \as Math;
\import I.Math[].Specification[].Prop[] \as Laws;
\import N.Basic[].Prop[] \as NatLaws;
\definition natural[n: N.Nat^]: I.Int^ := I.integer n N.Nat^::zero;
\definition equation: \forall (a, b: N.Nat^) -> I.Add.specification (natural a) (I.Neg.specification (natural b)) = I.integer a b :=
  \fun (a, b: N.Nat^) => Laws.toMathInjective _ _
    (eq_reason_in!{{Math.Grothendieck} _
      "=" { Math.addMath (Math.toMath (natural a)) (Math.toMath (I.Neg.specification (natural b))) } "by" { Math.addSetMatchesMath (natural a) (I.Neg.specification (natural b)) }
      "=" { Math.addMath (Math.class (I.pair a N.Nat^::zero)) (Math.negMath (Math.class (I.pair b N.Nat^::zero))) } "by" { congr!{{Math.Grothendieck} {Math.Grothendieck} {Math.Grothendieck}} Math.addMath _ _ _ _ (Math.toFromClass (I.pair a N.Nat^::zero))
        (trans!{{Math.Grothendieck}} _ _ _ (Math.negSetMatchesMath (natural b)) (congr!{{Math.Grothendieck} {Math.Grothendieck}} Math.negMath _ _ (Math.toFromClass (I.pair b N.Nat^::zero)))) }
      "=" { Math.class (Math.subRep (I.pair a N.Nat^::zero) (I.pair b N.Nat^::zero)) } "by" { Math.subMathClass (I.pair a N.Nat^::zero) (I.pair b N.Nat^::zero) }
      "=" { Math.class (I.pair a b) } "by" { Math.classOfEq _ _ (Math.equivalentOfFields _ _ (NatLaws.addZeroRight a) (NatLaws.addZeroLeft b)) }
      "=" { Math.toMath (I.integer a b) } "by" { sym!{{Math.Grothendieck}} _ _ (Math.toFromClass (I.pair a b)) }
    ));
