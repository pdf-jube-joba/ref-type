\import \parent.Point[] \as Point;
\import \parent.FiniteDiscrete[n := N.Nat^::succ one] \as Two;
\import Two.Computation[] \as TwoK;
\import \parent.FiniteDiscrete[n := zero].Computation[] \as Empty;
\import std.Arithmetic[].Int[] \as I;
\import Fin.Tuples[A := I.Int^] \as Tuples;
\definition signs: Fin.Fin (N.Nat^::succ one) -> I.Int^ := Tuples.extend one I.One.specification (\fun (i: Fin.Fin one) => I.Neg.specification I.One.specification);
\definition mixedVirtual: TwoK.Carrier := TwoK.backward signs;
\definition mixedRank: TwoK.forward mixedVirtual = signs := TwoK.rightInverse signs;
\definition firstRank: TwoK.forward mixedVirtual (Fin.zero one) = I.One.specification :=
  trans!{{I.Int^}} _ _ _ (congr!{{Fin.Fin (N.Nat^::succ one) -> I.Int^} {I.Int^}} (\fun (f: Fin.Fin (N.Nat^::succ one) -> I.Int^) => f (Fin.zero one)) _ _ mixedRank)
    (Tuples.atZero one I.One.specification (\fun (i: Fin.Fin one) => I.Neg.specification I.One.specification));
\definition secondRank: TwoK.forward mixedVirtual (Fin.succ one (Fin.zero zero)) = I.Neg.specification I.One.specification :=
  trans!{{I.Int^}} _ _ _ (congr!{{Fin.Fin (N.Nat^::succ one) -> I.Int^} {I.Int^}} (\fun (f: Fin.Fin (N.Nat^::succ one) -> I.Int^) => f (Fin.succ one (Fin.zero zero))) _ _ mixedRank)
    (Tuples.atSuccessor one I.One.specification (\fun (i: Fin.Fin one) => I.Neg.specification I.One.specification) (Fin.zero zero));
\definition emptyUnique: \forall (x, y: Empty.Carrier) -> x = y := \fun (x, y: Empty.Carrier) =>
  Empty.injective x y (Fin.Empty[A := I.Int^].unique (Empty.forward x) (Empty.forward y));
\definition pointInteger[z: I.Int^]: Point.Carrier := Point.backward z;
\definition pointRank: \forall (z: I.Int^) -> Point.forward (pointInteger z) = z := Point.rightInverse;
\definition pointRing: Point.Ring[].Isomorphism := Point.Ring[].isomorphism;
\definition twoPointRing: Two.RingComputation[].Isomorphism := Two.RingComputation[].isomorphism;
