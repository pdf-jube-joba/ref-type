\import Complements.Representations[X := X, baseSpace := baseSpace] \as Rep;
\import std.Set[].Quotient[A := Rep.Presentation, Equivalent := Rep.Equivalent] \as Quotient;
\definition Presentation: \Set := Rep.Presentation;
\definition Classes: \Set := Rep.Classes;
\definition class[p: Presentation]: Classes := Rep.class p;
\definition Fiber[p: Presentation][x: X]: \Set := Rep.Fiber p x;
\definition bundle[p: Presentation]: Bundles.Family[X := X, F := Fiber p].Bundle := Rep.bundle p;
\module Bundle(F: X -> \Set, original: Bundles.Family[X := X, F := F].Bundle, same: original.baseSpace = baseSpace);
\module Compare(F, G: X -> \Set, first: Bundles.Family[X := X, F := F].Bundle, second: Bundles.Family[X := X, F := G].Bundle,
  firstSame: first.baseSpace = baseSpace, secondSame: second.baseSpace = baseSpace);
\module Add(p, q: Presentation);
\module Addition;
\module Realized(p: Presentation);
\module Sum(F, G: X -> \Set, left: Bundles.Family[X := X, F := F].Bundle, right: Bundles.Family[X := X, F := G].Bundle,
  leftSame: left.baseSpace = baseSpace, rightSame: right.baseSpace = baseSpace);
\module Trivial(n: N.Nat^);
\module AdditiveMonoid;
\module Multiply(p, q: Presentation);
\module Multiplication;
\module Product(F, G: X -> \Set, left: Bundles.Family[X := X, F := F].Bundle, right: Bundles.Family[X := X, F := G].Bundle,
  leftSame: left.baseSpace = baseSpace, rightSame: right.baseSpace = baseSpace);
\module Line;
\module MultiplicativeMonoid;
