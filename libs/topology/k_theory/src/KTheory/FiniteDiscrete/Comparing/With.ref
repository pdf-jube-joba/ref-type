\import K.Discrete[discrete := \refl(Base.Discrete)] \as Discrete;
\import Discrete.Maps[F := F, G := G, source := first, target := second, sourceSame := firstSame, targetSame := secondSame,
  operators := \fun (x: X) => (fiber x).forward] \as Forward;
\import Discrete.Maps[F := G, G := F, source := second, target := first, sourceSame := secondSame, targetSame := firstSame,
  operators := \fun (x: X) => (fiber x).backward] \as Backward;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := F, G := G, source := first, target := second].Isomorphism :=
  Bundles.Isomorphisms[X := X, F := F, G := G, source := first, target := second].Isomorphism {
    forward := Forward.map, backward := Backward.map,
    leftInverse := \fun (x: X) => (fiber x).leftInverse,
    rightInverse := \fun (x: X) => (fiber x).rightInverse
  };
