\import Operations.LinearIsomorphisms[V := F x, W := Bundles.Vector (First.rank x), source := first.space x, target := Bundles.coordinates (First.rank x)].After[U := G x, space := second.space x] \as Composition;
\definition exists: First.rank x = Second.rank x -> \exists FiberIso x := \block {
  \fun (equal: _) \then
  \takefrom a: First.Frame (First.rank x) x \by \bysub(N.Nat^, First.RankAt x, First.rank x) \then
  \takefrom b: Second.Frame (Second.rank x) x \by \bysub(N.Nat^, Second.RankAt x, Second.rank x) \then
  \let frame: Second.Frame (First.rank x) x := \idelim Second.rank x = First.rank x \with m: N.Nat^ => Second.Frame m x \by { base: b, equality: sym!{{N.Nat^}} _ _ equal } \then
  \return \exact(Composition.compose a (Operations.LinearIsomorphisms[V := G x, W := Bundles.Vector (First.rank x), source := second.space x, target := Bundles.coordinates (First.rank x)].inverse frame), FiberIso x)
};
