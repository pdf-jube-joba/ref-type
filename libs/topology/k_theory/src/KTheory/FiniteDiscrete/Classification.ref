\import std.Arithmetic[].Int[] \as I;
\import K.Ranks[] \as Ranks;
\definition NatFunctions: \Set := X -> N.Nat^;
\definition rank[a: K.Classes]: NatFunctions := \fun (x: X) => I.Positive.specification (Ranks.classes a x);
\definition onClasses: \forall (p: K.Presentation)(x: X) -> rank (K.class p) x = Bundles.Family[X := X, F := K.Fiber p].Of[bundle := K.bundle p].rank x :=
  \fun (p: K.Presentation)(x: X) => congr!{{X -> I.Int^} {N.Nat^}} (\fun (f: X -> I.Int^) => I.Positive.specification (f x)) _ _ (Ranks.onClasses p);
\module Realizing(r: NatFunctions);
\definition realize[r: NatFunctions]: K.Classes := Realizing[r := r].value;
\definition rankRealize: \forall (r: NatFunctions) -> rank (realize r) = r := \fun (r: NatFunctions) => Realizing[r := r].equation;
\module Comparing(p, q: K.Presentation);
\definition injective: \forall (a, b: K.Classes) -> rank a = rank b -> a = b :=
  std.Set[].Quotient[A := K.Presentation, Equivalent := Complements.Representations[X := X, baseSpace := Base.Discrete].Equivalent].induction2
    (\fun (a, b: K.Classes) => rank a = rank b -> a = b) (\fun (p, q: K.Presentation) => Comparing[p := p, q := q].equal);
\definition realizeRank: \forall (a: K.Classes) -> realize (rank a) = a := \fun (a: K.Classes) => injective _ _ (rankRealize (rank a));
\import N.Basic[].Def[] \as Nat;
\import N.Basic[].Prop[] \as NatLaws;
\import K.AdditiveMonoid[] \as Addition;
\definition naturalIntegerRank: \forall (a: K.Classes)(x: X) -> Ranks.classes a x = Ranks.natural (rank a x) :=
  std.Set[].Quotient[A := K.Presentation, Equivalent := Complements.Representations[X := X, baseSpace := Base.Discrete].Equivalent].induction
    (\fun (a: K.Classes) => \forall (x: X) -> Ranks.classes a x = Ranks.natural (rank a x))
    (\fun (p: K.Presentation)(x: X) => trans!{{I.Int^}} _ _ _
      (congr!{{X -> I.Int^} {I.Int^}} (\fun (f: X -> I.Int^) => f x) _ _ (Ranks.onClasses p))
      (congr!{{N.Nat^} {I.Int^}} Ranks.natural _ _ (sym!{{N.Nat^}} _ _ (onClasses p x))));
\definition rankAdd: \forall (a, b: K.Classes)(x: X) -> rank (Addition.add a b) x = Nat.add (rank a x) (rank b x) := \fun (a, b: K.Classes)(x: X) =>
  eq_reason_in!{{N.Nat^} _
    "=" { I.Positive.specification (I.Add.specification (Ranks.classes a x) (Ranks.classes b x)) } "by" { congr!{{X -> I.Int^} {N.Nat^}} (\fun (f: X -> I.Int^) => I.Positive.specification (f x)) _ _ (Ranks.preservesAdd a b) }
    "=" { I.Positive.specification (I.Add.specification (Ranks.natural (rank a x)) (Ranks.natural (rank b x))) } "by" { congr!{{I.Int^} {I.Int^} {N.Nat^}} (\fun (s, t: I.Int^) => I.Positive.specification (I.Add.specification s t)) _ _ _ _ (naturalIntegerRank a x) (naturalIntegerRank b x) }
    "=" { Nat.add (rank a x) (rank b x) } "by" { congr!{{I.Int^} {N.Nat^}} I.Positive.specification _ _ (I.addIntegerNatural (rank a x) (rank b x)) }
  };
