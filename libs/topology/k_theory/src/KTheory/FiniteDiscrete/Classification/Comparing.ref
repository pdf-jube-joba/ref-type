\import \parent.\parent.Comparing[F := K.Fiber p, G := K.Fiber q, first := K.bundle p, second := K.bundle q, firstSame := \refl(Base.Discrete), secondSame := \refl(Base.Discrete)] \as BundlesEqual;
\import Complements.Representations[X := X, baseSpace := Base.Discrete] \as Rep;
\definition equal: rank (K.class p) = rank (K.class q) -> K.class p = K.class q := \fun (same: _) => Rep.relatedEqual p q
  (BundlesEqual.exists (\fun (x: X) => trans!{{N.Nat^}} _ _ _ (sym!{{N.Nat^}} _ _ (onClasses p x))
    (trans!{{N.Nat^}} _ _ _ (congr!{{NatFunctions} {N.Nat^}} (\fun (f: NatFunctions) => f x) _ _ same) (onClasses q x))));
