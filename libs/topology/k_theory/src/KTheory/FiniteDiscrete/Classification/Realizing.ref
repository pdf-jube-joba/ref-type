\import \parent.\parent.\parent.VariableRanks[X := X, dimension := r] \as Constructed;
\import K.Bundle[F := Constructed.Fiber, original := Constructed.bundle, same := \refl(Base.Discrete)] \as Class;
\import Ranks.Of[F := Constructed.Fiber, original := Constructed.bundle, same := \refl(Base.Discrete)] \as Rank;
\definition value: K.Classes := Class.value;
\definition equation: rank value = r := \axiom:funext(rank value, r, \fun (x: X) =>
  trans!{{N.Nat^}} _ _ _ (congr!{{X -> I.Int^} {N.Nat^}} (\fun (f: X -> I.Int^) => I.Positive.specification (f x)) _ _ Rank.onBundle) (Constructed.rank x));
