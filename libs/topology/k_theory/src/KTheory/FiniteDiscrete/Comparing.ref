\import Bundles.Family[X := X, F := F].Of[bundle := first] \as First;
\import Bundles.Family[X := X, F := G].Of[bundle := second] \as Second;
\definition FiberIso[x: X]: \Set := Spaces.Isomorphism[V := F x, W := G x, source := first.space x, target := second.space x].Isomorphism;
\module At(x: X);
\module With(fiber: \forall (x: X) -> FiberIso x);
\definition Isomorphism: \Set := Bundles.Isomorphisms[X := X, F := F, G := G, source := first, target := second].Isomorphism;
\definition exists: (\forall (x: X) -> First.rank x = Second.rank x) -> \exists Isomorphism := \block {
  \fun (equal: \forall (x: X) -> First.rank x = Second.rank x) \then
  \takefrom fiber: (\forall (x: X) -> FiberIso x) \by \parent.\parent.FiniteChoices[n := n, F := FiberIso].exists (\fun (x: X) => At[x := x].exists (equal x)) \then
  \return \exact(With[fiber := fiber].isomorphism, Isomorphism)
};
