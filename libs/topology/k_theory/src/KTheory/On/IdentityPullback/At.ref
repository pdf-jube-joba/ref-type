\import \parent.\parent.Realized[p := p] \as Original;
\import Pull.Of[F := Fiber p, original := bundle p, same := \refl(baseSpace)] \as Pulled;
\import Bundles.Family[X := X, F := Fiber p].Of[bundle := bundle p].PullbackIdentity[] \as Native;
\import \parent.\parent.Compare[F := Fiber p, G := Fiber p, first := bundle p, second := Pulled.pulled, firstSame := \refl(baseSpace), secondSame := \refl(baseSpace)] \as Comparison;
\definition equation: Pull.map (class p) = class p :=
  trans!{Classes} _ _ _ (congr!{Classes Classes} Pull.map _ _ (sym!{Classes} _ _ Original.equation))
    (trans!{Classes} _ _ _ Pulled.naturality
      (trans!{Classes} _ _ _ (sym!{Classes} _ _ (Comparison.ofIsomorphism Native.isomorphism)) Original.equation));
