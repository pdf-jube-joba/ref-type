\import Operations.ScalarLine[X := X, baseSpace := baseSpace] \as Constructed;
\definition FiberAt[x: X]: \Set := C.Complex;
\definition lineBundle: Bundles.Family[X := X, F := FiberAt].Bundle := Constructed.bundle;
\import \parent.Bundle[F := FiberAt, original := lineBundle, same := \refl(baseSpace)] \as Class;
\definition value: Classes := Class.value;
