\import \parent.\parent.Add[p := p, q := q] \as Constructed;
\import \parent.Of[F := Constructed.FiberAt, original := Constructed.sumBundle, same := \refl(baseSpace)] \as Result;
\import \parent.Sum[F := Fiber p, G := Fiber q, left := bundle p, right := bundle q, leftSame := \refl(baseSpace), rightSame := \refl(baseSpace)] \as Native;
\import \parent.\parent.Addition[] \as Addition;
\definition equation: classes (Addition.add (class p) (class q)) = Functions.add (classes (class p)) (classes (class q)) :=
  trans!{{Functions.Carrier}} _ _ _ (congr!{Classes {Functions.Carrier}} classes _ _ (Addition.onClasses p q))
    (trans!{{Functions.Carrier}} _ _ _ Result.onBundle
      (trans!{{Functions.Carrier}} _ _ _
        (\axiom:funext(Result.rank, Functions.add (representative p) (representative q), \fun (x: X) =>
          trans!{{I.Int^}} _ _ _ (congr!{{N.Nat^} {I.Int^}} natural _ _ (Native.rank x))
            (sym!{{I.Int^}} _ _ (I.addIntegerNatural (Bundles.Family[X := X, F := Fiber p].Of[bundle := bundle p].rank x) (Bundles.Family[X := X, F := Fiber q].Of[bundle := bundle q].rank x)))))
        (congr!{{Functions.Carrier} {Functions.Carrier} {Functions.Carrier}} Functions.add _ _ _ _ (sym!{{Functions.Carrier}} _ _ (onClasses p)) (sym!{{Functions.Carrier}} _ _ (onClasses q)))));
