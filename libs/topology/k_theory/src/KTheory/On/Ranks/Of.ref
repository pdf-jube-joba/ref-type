\import Bundles.Family[X := X, F := F].Of[bundle := original] \as Native;
\definition rank: Functions.Carrier := \fun (x: X) => natural (Native.rank x);
\definition locallyConstant: Functions.LocallyConstant rank := \block {
  \fun (x: X) \then
  \takefrom n: Native.RankNeighborhood[x] \by Native.rankLocallyConstant x \then
  \return \exact(Functions.Neighborhood[rank, x] {
    domain := n.domain,
    open := \idelim original.baseSpace = baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Topology[Carrier := X].IsOpenIn t n.domain \by { base: n.open, equality: same },
    contains := n.contains,
    constant := \fun (y: X)(member: topology.Topology[Carrier := X].Member n.domain y) => congr!{{N.Nat^} {I.Int^}} natural _ _ (n.constant y member)
  }, Functions.Neighborhood[rank, x])
};
\import \parent.\parent.Bundle[F := F, original := original, same := same] \as Class;
\module Identifying(p: Presentation, iso: Class.Isomorphism p);
\definition onBundle: classes Class.value = rank := \block {
  \takefrom p: Class.Representative \by Class.representativeExists \then
  \return Identifying[p := p.presentation, iso := p.isomorphism].equation
};
