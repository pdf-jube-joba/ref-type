\import Native.In[c := c, d := d] \as Chart;
\definition point: \Cast[X] (Base.Intersection c.domain d.domain) := \into[X](x, Base.Intersection c.domain d.domain) \by { Logic.And[_, _]::# first second };
\definition equation: Result.rank x = Naturals.add (Left.rank x) (Right.rank x) :=
  trans!{{N.Nat^}} _ _ _ (Result.rankFrame x (Naturals.add d.dimension c.dimension) (Chart.At[x := point].frame))
    (trans!{{N.Nat^}} _ _ _ (Laws.addCommutative d.dimension c.dimension)
      (congr!{{N.Nat^} {N.Nat^} {N.Nat^}} Naturals.add _ _ _ _
        (sym!{{N.Nat^}} _ _ (Left.rankFrame x c.dimension (c.frame (\into[X](x, c.domain) \by { first }))))
        (sym!{{N.Nat^}} _ _ (Right.rankFrame x d.dimension (d.frame (\into[X](x, d.domain) \by { second }))))));
