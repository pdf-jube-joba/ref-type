\import \parent.\parent.Sum[F := F, G := G, left := left, right := right, leftSame := leftSame, rightSame := rightSame] \as Constructed;
\import Operations.DirectSum[X := X, F := F, G := G, left := left, right := right] \as Native;
\import Bundles.Family[X := X, F := F].Of[bundle := left] \as Left;
\import Bundles.Family[X := X, F := G].Of[bundle := right] \as Right;
\import Bundles.Family[X := X, F := Native.Fiber].Of[bundle := Constructed.sumBundle] \as Result;
\import Bundles.Family[X := X, F := F].With[data := left] \as LeftCharts;
\import Bundles.Family[X := X, F := G].With[data := right] \as RightCharts;
\import N.Basic[].Def[] \as Naturals;
\import N.Basic[].Prop[] \as Laws;
\import topology.Topology[Carrier := X] \as Base;
\module In(c: LeftCharts.Chart, d: RightCharts.Chart, x: X, first: Base.Member c.domain x, second: Base.Member d.domain x);
\definition rank: \forall (x: X) -> Result.rank x = Naturals.add (Left.rank x) (Right.rank x) := \block {
  \fun (x: X) \then
  \takefrom c: \Cast[LeftCharts.Chart] ({ c: LeftCharts.Chart \where Base.Member c.domain x }) \by Left.locallyTrivial x \then
  \takefrom d: \Cast[RightCharts.Chart] ({ c: RightCharts.Chart \where Base.Member c.domain x }) \by Right.locallyTrivial x \then
  \return In[c := c, d := d, x := x, first := \bysub(LeftCharts.Chart, { c: LeftCharts.Chart \where Base.Member c.domain x }, c), second := \bysub(RightCharts.Chart, { c: RightCharts.Chart \where Base.Member c.domain x }, d)].equation
};
