\definition fiber: Spaces.Isomorphism[V := F x, W := G x, source := first.space x, target := second.space x].Isomorphism :=
  Spaces.Isomorphism[V := F x, W := G x, source := first.space x, target := second.space x].Isomorphism {
    forward := iso.forward.fiber x, backward := iso.backward.fiber x,
    leftInverse := iso.leftInverse x, rightInverse := iso.rightInverse x
  };
\import Operations.LinearIsomorphisms[V := F x, W := G x, source := first.space x, target := second.space x].After[U := Bundles.Vector (Second.rank x), space := Bundles.coordinates (Second.rank x)] \as Composition;
\definition equation: First.rank x = Second.rank x := \block {
  \takefrom frame: Second.Frame (Second.rank x) x \by \bysub(N.Nat^, Second.RankAt x, Second.rank x) \then
  \return First.rankFrame x (Second.rank x) (Composition.compose fiber frame)
};
