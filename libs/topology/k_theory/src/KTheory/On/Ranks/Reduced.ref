\import algebra.Group[].Of[Carrier := K.Carrier, group := K.group].Subgroups[] \as Subgroups;
\import std.Arithmetic[].IntAlgebra[] \as IA;
\definition kernel: \Pow K.Carrier := { x: K.Carrier \where rank x point = I.Zero.specification };
\definition Carrier: \Set := \Cast[K.Carrier] kernel;
\definition closed: Subgroups.Closed[kernel] := Subgroups.Closed[kernel] {
  zero := congr!{{Functions.Carrier} {I.Int^}} (\fun (f: Functions.Carrier) => f point) _ _ rankZero,
  add := \fun (x, y: K.Carrier)(first: rank x point = I.Zero.specification)(second: rank y point = I.Zero.specification) =>
    trans!{{I.Int^}} _ _ _ (congr!{{Functions.Carrier} {I.Int^}} (\fun (f: Functions.Carrier) => f point) _ _ (rankAdd x y))
      (trans!{{I.Int^}} _ _ _ (congr!{{I.Int^} {I.Int^} {I.Int^}} I.Add.specification _ _ _ _ first second) (IA.additiveGroupLaws.monoid.leftIdentity I.Zero.specification)),
  neg := \fun (x: K.Carrier)(zero: rank x point = I.Zero.specification) =>
    trans!{{I.Int^}} _ _ _ (congr!{{Functions.Carrier} {I.Int^}} (\fun (f: Functions.Carrier) => f point) _ _ (rankNeg x))
      (trans!{{I.Int^}} _ _ _ (congr!{{I.Int^} {I.Int^}} I.Neg.specification _ _ zero) (\refl(I.Zero.specification)))
};
\definition group: std.Alg[].Alg[].CommutativeGroup[Carrier] := Subgroups.subgroup kernel closed;
