\import \parent.\parent.Line[] \as Line;
\import \parent.Of[F := Line.FiberAt, original := Line.lineBundle, same := \refl(baseSpace)] \as Result;
\import Bundles.Family[X := X, F := Line.FiberAt].Of[bundle := Line.lineBundle] \as Native;
\import Operations.LineCoordinates[] \as Coordinates;
\definition equation: classes Line.value = (\fun (x: X) => I.One.specification) :=
  trans!{{Functions.Carrier}} _ _ _ Result.onBundle
    (\axiom:funext(Result.rank, (\fun (x: X) => I.One.specification), \fun (x: X) =>
      congr!{{N.Nat^} {I.Int^}} natural _ _ (Native.rankFrame x (N.Nat^::succ N.Nat^::zero) Coordinates.isomorphism)));
\definition virtual: rank K.one = (\fun (x: X) => I.One.specification) :=
  trans!{{Functions.Carrier}} _ _ _ (rankIncludes Line.value) equation;
