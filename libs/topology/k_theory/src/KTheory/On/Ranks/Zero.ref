\import \parent.\parent.Trivial[n := N.Nat^::zero] \as Trivial;
\import Bundles.Trivial[X := X, n := N.Nat^::zero, baseSpace := baseSpace] \as Native;
\import \parent.Of[F := Trivial.FiberAt, original := Trivial.trivialBundle, same := \refl(baseSpace)] \as Result;
\import Bundles.Family[X := X, F := Trivial.FiberAt].Of[bundle := Trivial.trivialBundle] \as Ranks;
\definition equation: classes Trivial.value = Functions.zero :=
  trans!{{Functions.Carrier}} _ _ _ Result.onBundle
    (\axiom:funext(Result.rank, Functions.zero, \fun (x: X) => congr!{{N.Nat^} {I.Int^}} natural _ _ (Ranks.rankFrame x N.Nat^::zero Native.identity)));
