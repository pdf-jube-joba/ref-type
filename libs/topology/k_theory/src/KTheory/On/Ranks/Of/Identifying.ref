\import \parent.\parent.Comparing[F := F, G := Fiber p, first := original, second := bundle p, iso := iso] \as Compare;
\definition equation: classes Class.value = rank :=
  trans!{{Functions.Carrier}} _ _ _ (congr!{Classes {Functions.Carrier}} classes _ _ (Class.identified p iso))
    (trans!{{Functions.Carrier}} _ _ _ (onClasses p)
      (\axiom:funext(representative p, rank, \fun (x: X) => congr!{{N.Nat^} {I.Int^}} natural _ _ (sym!{{N.Nat^}} _ _ (Compare.equation x)))));
