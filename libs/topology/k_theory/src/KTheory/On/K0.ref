\import \parent.Semiring[] \as BundlesRing;
\import \parent.MultiplicativeMonoid[] \as Multiplication;
\import algebra.GroupCompletion[].Semiring[M := Classes, semiring := BundlesRing.semiring] \as Completion;
\import algebra.GroupCompletion[].Of[M := Classes, monoid := Completion.additive] \as Additive;
\import std.Alg[].Ring[] \as Rings;
\definition Carrier: \Set := Completion.Carrier;
\definition include: Classes -> Carrier := Completion.include;
\definition zero: Carrier := Completion.zero;
\definition one: Carrier := Completion.one;
\definition add: Carrier -> Carrier -> Carrier := Completion.add;
\definition neg: Carrier -> Carrier := Completion.neg;
\definition mul: Carrier -> Carrier -> Carrier := Completion.mul;
\definition ring: Rings.Ring[Carrier] := Completion.ring;
\definition commutativeRing: Rings.CommutativeRing[Carrier] := Completion.commutativeRing Multiplication.commutative;
\definition includeAdd: \forall (a, b: Classes) -> include (BundlesRing.add a b) = add (include a) (include b) := Additive.includeAdd;
\definition includeMul: \forall (a, b: Classes) -> mul (include a) (include b) = include (BundlesRing.mul a b) :=
  \fun (a, b: Classes) => trans!{Carrier} _ _ _ (Completion.mulIncludes a (include b)) (Completion.scaleIncludes a b);
\definition difference[a, b: Classes]: Carrier := add (include a) (neg (include b));
\definition differenceClass: \forall (a, b: Classes) -> difference a b = Additive.class (Additive.pair a b) := Additive.differenceClass;
\module Stability;
\import algebra.Hom[A := Classes, B := Carrier] \as Inclusion;
\definition inclusion: Inclusion.SemiringMap BundlesRing.semiring (Rings.ringAsSemiring Carrier ring) :=
  \into[Classes -> Carrier](include, Inclusion.SemiringMap BundlesRing.semiring (Rings.ringAsSemiring Carrier ring)) \by {
    Inclusion.SemiringLaws[BundlesRing.semiring, (Rings.ringAsSemiring Carrier ring), include] {
      zero := \refl(zero), one := \refl(one), add := includeAdd,
      mul := \fun (a, b: Classes) => sym!{Carrier} _ _ (includeMul a b)
    }
  };
\definition additiveMonoid: std.Alg[].Monoid[].CommutativeMonoid[Classes] := Completion.additive;
\definition group: std.Alg[].Alg[].CommutativeGroup[Carrier] := Additive.group;
\module Maps(K: \Set, target: Rings.Ring[K]);
\module NormalForm;
