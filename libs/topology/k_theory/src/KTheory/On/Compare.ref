\import \parent.Bundle[F := F, original := first, same := firstSame] \as First;
\import \parent.Bundle[F := G, original := second, same := secondSame] \as Second;
\import Rep.Comparison[F := F, G := G, first := first, second := second, firstSame := firstSame, secondSame := secondSame] \as Comparison;
\import Bundles.Isomorphisms[X := X, F := F, G := G, source := first, target := second] \as Isos;
\definition ofIsomorphism: \forall (iso: Isos.Isomorphism) -> First.value = Second.value :=
  Comparison.isomorphicEqual First.compactBase First.hausdorffBase Second.compactBase Second.hausdorffBase;
\definition ofExists: (\exists Isos.Isomorphism) -> First.value = Second.value := \block {
  \fun (exists: \exists Isos.Isomorphism) \then
  \takefrom iso: Isos.Isomorphism \by exists \then
  \return ofIsomorphism iso
};
\definition toExists: First.value = Second.value -> \exists Isos.Isomorphism :=
  Comparison.equalIsomorphic First.compactBase First.hausdorffBase Second.compactBase Second.hausdorffBase;
\definition criterion: Logic.PropEquiv[First.value = Second.value, \exists Isos.Isomorphism] := Logic.PropEquiv[_, _] { ltr := toExists, rtl := ofExists };
