\import \parent.\parent.Add[p := r, q := s] \as Other;
\import Operations.DirectSumIsomorphisms[X := X, F := Fiber p, G := Fiber q, A := Fiber r, B := Fiber s,
  first := bundle p, second := bundle q, newFirst := bundle r, newSecond := bundle s,
  sameSource := \refl(baseSpace), sameTarget := \refl(baseSpace)] \as Comparison;
\definition isomorphism: Bundles.Isomorphisms[X := X, F := FiberAt, G := Other.FiberAt, source := sumBundle, target := Other.sumBundle].Isomorphism := Comparison.isomorphism first second;
\import \parent.\parent.Compare[F := FiberAt, G := Other.FiberAt, first := sumBundle, second := Other.sumBundle,
  firstSame := \refl(baseSpace), secondSame := \refl(baseSpace)] \as ClassesEqual;
\definition equality: value = Other.value := ClassesEqual.ofIsomorphism isomorphism;
