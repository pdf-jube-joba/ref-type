\import \parent.\parent.Multiply[p := p, q := q] \as First;
\import \parent.\parent.Multiply[p := q, q := r] \as Last;
\import \parent.\parent.Realized[p := p] \as RealizedFirst;
\import \parent.\parent.Realized[p := r] \as RealizedLast;
\import \parent.\parent.Product[F := First.FiberAt, G := Fiber r, left := First.tensorBundle, right := bundle r,
  leftSame := \refl(baseSpace), rightSame := \refl(baseSpace)] \as Left;
\import \parent.\parent.Product[F := Fiber p, G := Last.FiberAt, left := bundle p, right := Last.tensorBundle,
  leftSame := \refl(baseSpace), rightSame := \refl(baseSpace)] \as Right;
\import Operations.TensorAssociator[X := X, F := Fiber p, G := Fiber q, H := Fiber r, left := bundle p, middle := bundle q, right := bundle r,
  sameMiddle := \refl(baseSpace), sameRight := \refl(baseSpace)] \as Associator;
\import \parent.\parent.Compare[F := Left.FiberAt, G := Right.FiberAt, first := Left.tensorBundle, second := Right.tensorBundle,
  firstSame := \refl(baseSpace), secondSame := \refl(baseSpace)] \as Comparison;
\definition leftEquation: mul (mul (class p) (class q)) (class r) = Left.value :=
  trans!{Classes} _ _ _ (congr!{Classes Classes Classes} mul _ _ _ _ (onClasses p q) (sym!{Classes} _ _ RealizedLast.equation)) Left.onBundles;
\definition rightEquation: mul (class p) (mul (class q) (class r)) = Right.value :=
  trans!{Classes} _ _ _ (congr!{Classes Classes Classes} mul _ _ _ _ (sym!{Classes} _ _ RealizedFirst.equation) (onClasses q r)) Right.onBundles;
\definition equation: mul (mul (class p) (class q)) (class r) = mul (class p) (mul (class q) (class r)) :=
  trans!{Classes} _ _ _ leftEquation (trans!{Classes} _ _ _ (Comparison.ofIsomorphism Associator.isomorphism) (sym!{Classes} _ _ rightEquation));
