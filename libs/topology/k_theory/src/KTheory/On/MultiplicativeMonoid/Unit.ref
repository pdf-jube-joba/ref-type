\import \parent.\parent.Line[] \as Line;
\import \parent.\parent.Realized[p := p] \as Realized;
\import \parent.\parent.Product[F := Line.FiberAt, G := Fiber p, left := Line.lineBundle, right := bundle p,
  leftSame := \refl(baseSpace), rightSame := \refl(baseSpace)] \as Sum;
\import Operations.TensorUnit[X := X, F := Fiber p, bundle := bundle p] \as Unit;
\import \parent.\parent.Compare[F := Sum.FiberAt, G := Fiber p, first := Sum.tensorBundle, second := bundle p,
  firstSame := \refl(baseSpace), secondSame := \refl(baseSpace)] \as Comparison;
\definition equation: mul oneClass (class p) = class p :=
  trans!{Classes} _ _ _ (congr!{Classes Classes} (mul oneClass) _ _ (sym!{Classes} _ _ Realized.equation))
    (trans!{Classes} _ _ _ Sum.onBundles
      (trans!{Classes} _ _ _ (Comparison.ofIsomorphism Unit.isomorphism) Realized.equation));
