\module Between(p, q: Presentation);
\definition presentations: \forall (p, q: Presentation) -> class p = class q :=
  \fun (p, q: Presentation) => Rep.relatedEqual p q (\exact(Between[p := p, q := q].isomorphism, Rep.Isomorphism p q));
\definition classes: \forall (a, b: Classes) -> a = b := Quotient.induction2
  (\fun (a, b: Classes) => a = b) presentations;
\import \parent.K0[] \as K;
\import algebra.Group[].Of[Carrier := K.Carrier, group := K.group] \as Additive;
\definition difference: \forall (a, b: Classes) -> K.difference a b = K.zero :=
  \fun (a, b: Classes) => trans!{{K.Carrier}} _ _ _
    (congr!{Classes {K.Carrier}} (\fun (c: Classes) => K.difference c b) _ _ (classes a b))
    (Additive.inverseRight (K.include b));
\import algebra.GroupCompletion[].Of[M := Classes, monoid := K.additiveMonoid] \as Completion;
\import std.Set[].Quotient[A := Completion.Difference, Equivalent := Completion.Equivalent] \as Differences;
\definition represented[d: Completion.Difference]: K.difference (Completion.positive d) (Completion.negative d) = Completion.class d :=
  trans!{{K.Carrier}} _ _ _ (K.differenceClass (Completion.positive d) (Completion.negative d))
    (congr!{{Completion.Difference} {K.Carrier}} Completion.class _ _ (std.Data[].Pair[].Prop[A := Classes, B := Classes].eta d));
\definition equation: \forall (x: K.Carrier) -> x = K.zero := Differences.induction
  (\fun (x: K.Carrier) => x = K.zero)
  (\fun (d: Completion.Difference) => trans!{{K.Carrier}} _ _ _
    (sym!{{K.Carrier}} _ _ (represented d))
    (difference (Completion.positive d) (Completion.negative d)));
