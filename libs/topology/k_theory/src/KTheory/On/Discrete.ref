\module Maps(F, G: X -> \Set, source: Bundles.Family[X := X, F := F].Bundle, target: Bundles.Family[X := X, F := G].Bundle,
  sourceSame: source.baseSpace = baseSpace, targetSame: target.baseSpace = baseSpace,
  operators: \forall (x: X) -> Spaces.Linear[V := F x, W := G x, source := source.space x, target := target.space x].Map);
