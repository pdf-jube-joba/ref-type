\import Quotient.Binary[C := Presentation, B := Classes, OtherEquivalent := Rep.Equivalent] \as Descend;
\definition onRepresentatives[p, q: Presentation]: Classes := \parent.Add[p := p, q := q].value;
\definition respects: Descend.Respects onRepresentatives := \block {
  \fun (p, r, q, s: Presentation)(first: Rep.Equivalent p r)(second: Rep.Equivalent q s) \then
  \takefrom a: Rep.Isomorphism p r \by first \then
  \takefrom b: Rep.Isomorphism q s \by second \then
  \return \parent.Add[p := p, q := q].Comparing[r := r, s := s, first := a, second := b].equality
};
\definition add: Classes -> Classes -> Classes := Descend.value Rep.equivalence Rep.equivalence onRepresentatives respects;
\definition onClasses: \forall (p, q: Presentation) -> add (class p) (class q) = onRepresentatives p q :=
  Descend.onClass Rep.equivalence Rep.equivalence onRepresentatives respects;
