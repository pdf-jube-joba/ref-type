\import \parent.\parent.Trivial[n := zero] \as Zero;
\import \parent.\parent.Realized[p := p] \as Realized;
\import \parent.\parent.Sum[F := Zero.FiberAt, G := Fiber p, left := Zero.trivialBundle, right := bundle p,
  leftSame := \refl(baseSpace), rightSame := \refl(baseSpace)] \as Sum;
\import Operations.DirectSumUnit[X := X, F := Fiber p, bundle := bundle p] \as Unit;
\import \parent.\parent.Compare[F := Sum.FiberAt, G := Fiber p, first := Sum.sumBundle, second := bundle p,
  firstSame := \refl(baseSpace), secondSame := \refl(baseSpace)] \as Comparison;
\definition equation: add zeroClass (class p) = class p :=
  trans!{Classes} _ _ _ (congr!{Classes Classes} (add zeroClass) _ _ (sym!{Classes} _ _ Realized.equation))
    (trans!{Classes} _ _ _ Sum.onBundles
      (trans!{Classes} _ _ _ (Comparison.ofIsomorphism Unit.isomorphism) Realized.equation));
