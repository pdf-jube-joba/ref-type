\import \parent.\parent.\parent.\parent.Trivial[n := n] \as Trivial;
\import \parent.\parent.\parent.\parent.Sum[F := F, G := Trivial.FiberAt, left := first, right := Trivial.trivialBundle,
  leftSame := firstSame, rightSame := \refl(baseSpace)] \as Left;
\import \parent.\parent.\parent.\parent.Sum[F := G, G := Trivial.FiberAt, left := second, right := Trivial.trivialBundle,
  leftSame := secondSame, rightSame := \refl(baseSpace)] \as Right;
\import \parent.\parent.\parent.\parent.Compare[F := Left.FiberAt, G := Right.FiberAt, first := Left.sumBundle, second := Right.sumBundle,
  firstSame := firstSame, secondSame := secondSame] \as Comparison;
\definition Isomorphism: \Set := Bundles.Isomorphisms[X := X, F := Left.FiberAt, G := Right.FiberAt, source := Left.sumBundle, target := Right.sumBundle].Isomorphism;
\definition fromEquality: Stable First.value Second.value n -> \exists Isomorphism := \fun (equal: _) =>
  Comparison.toExists (trans!{Classes} _ _ _ (sym!{Classes} _ _ Left.onBundles) (trans!{Classes} _ _ _ equal Right.onBundles));
\definition toEquality: Isomorphism -> Stable First.value Second.value n := \fun (iso: Isomorphism) =>
  trans!{Classes} _ _ _ Left.onBundles (trans!{Classes} _ _ _ (Comparison.ofIsomorphism iso) (sym!{Classes} _ _ Right.onBundles));
