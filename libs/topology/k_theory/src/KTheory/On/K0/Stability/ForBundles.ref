\import \parent.\parent.\parent.Bundle[F := F, original := first, same := firstSame] \as First;
\import \parent.\parent.\parent.Bundle[F := G, original := second, same := secondSame] \as Second;
\module At(n: N.Nat^);
\definition StablyIsomorphic: \Prop := \exists (n: N.Nat^ \where \exists At[n := n].Isomorphism);
\definition criterion: Logic.PropEquiv[include First.value = include Second.value, StablyIsomorphic] :=
  Logic.PropEquiv[include First.value = include Second.value, StablyIsomorphic] {
    ltr := \fun (equal: _) => \block {
      \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where Stable First.value Second.value n }) \by stabilizes First.value Second.value equal \then
      \return Logic.existsIntro[N.Nat^, { n: N.Nat^ \where \exists At[n := n].Isomorphism }] n
        (At[n := n].fromEquality (\bysub(N.Nat^, { n: N.Nat^ \where Stable First.value Second.value n }, n)))
    },
    rtl := \fun (stable: StablyIsomorphic) => \block {
      \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where \exists At[n := n].Isomorphism }) \by stable \then
      \takefrom iso: At[n := n].Isomorphism \by \bysub(N.Nat^, { n: N.Nat^ \where \exists At[n := n].Isomorphism }, n) \then
      \return equalInclusion First.value Second.value (\parent.\parent.\parent.Trivial[n := n].value) (At[n := n].toEquality iso)
    }
  };
