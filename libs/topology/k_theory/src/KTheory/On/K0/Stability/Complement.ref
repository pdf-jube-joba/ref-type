\import Complements.Projection[X := X, n := p.dimension, baseSpace := baseSpace, P := p.projection, regular := p.regular].Complement[] \as Split;
\import \parent.\parent.\parent.Realized[p := p] \as Realized;
\import \parent.\parent.\parent.Bundle[F := Split.ComplementFiber, original := Split.complementBundle, same := \refl(baseSpace)] \as Other;
\import \parent.\parent.\parent.Sum[F := Fiber p, G := Split.ComplementFiber, left := bundle p, right := Split.complementBundle,
  leftSame := \refl(baseSpace), rightSame := \refl(baseSpace)] \as Sum;
\import \parent.\parent.\parent.Trivial[n := p.dimension] \as Trivial;
\import \parent.\parent.\parent.Compare[F := Sum.FiberAt, G := Trivial.FiberAt, first := Sum.sumBundle, second := Trivial.trivialBundle,
  firstSame := \refl(baseSpace), secondSame := \refl(baseSpace)] \as Comparison;
\definition witness: CompletionWitness[class p] := CompletionWitness[class p] {
  dimension := p.dimension, complement := Other.value,
  equation := trans!{Classes} _ _ _ (congr!{Classes Classes} (\fun (a: Classes) => Monoid.add a Other.value) _ _ (sym!{Classes} _ _ Realized.equation))
    (trans!{Classes} _ _ _ Sum.onBundles (Comparison.ofIsomorphism Split.isomorphism))
};
