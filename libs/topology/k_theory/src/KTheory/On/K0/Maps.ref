\import algebra.Hom[A := Carrier, B := K] \as Output;
\import Additive.Universal[K := K, target := Rings.additiveGroup K target] \as Extension;
\definition RingMap: \Set := Output.RingMap ring target;
\definition additive[h: RingMap]: Output.MonoidMap Additive.asMonoid Extension.codomain :=
  \into[Carrier -> K](h, Output.MonoidMap Additive.asMonoid Extension.codomain) \by {
    Output.MonoidLaws[Additive.asMonoid, Extension.codomain, h] {
      unit := (Output.semiringLaws (Rings.ringAsSemiring Carrier ring) (Rings.ringAsSemiring K target) h).zero,
      operation := (Output.semiringLaws (Rings.ringAsSemiring Carrier ring) (Rings.ringAsSemiring K target) h).add
    }
  };
\definition ext: \forall (h, k: RingMap) -> (\forall (a: Classes) -> h (include a) = k (include a)) -> h = k :=
  \fun (h, k: RingMap)(agrees: _) => Extension.ext (additive h) (additive k) agrees;
