\import Rep.Of[F := F, original := original, same := same] \as Representation;
\definition compactBase: topology.Topology[Carrier := X].IsCompact original.baseSpace :=
  \idelim baseSpace = original.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Topology[Carrier := X].IsCompact t \by {
    base: compact, equality: sym!{{topology.Topology[Carrier := X].Topology}} _ _ same
  };
\definition hausdorffBase: topology.Topology[Carrier := X].IsT2 original.baseSpace :=
  \idelim baseSpace = original.baseSpace \with t: topology.Topology[Carrier := X].Topology => topology.Topology[Carrier := X].IsT2 t \by {
    base: hausdorff, equality: sym!{{topology.Topology[Carrier := X].Topology}} _ _ same
  };
\definition value: Classes := Representation.class compactBase hausdorffBase;
\definition Represents[p: Presentation]: \Prop := Representation.Represents p;
\definition Isomorphism[p: Presentation]: \Set := Representation.Isomorphism p;
\definition classification: \forall (p: Presentation) -> Logic.PropEquiv[value = class p, Represents p] := Representation.classification compactBase hausdorffBase;
\import Complements.For[X := X, F := F, bundle := original] \as Original;
\import Rep.Representing[F := F, original := original] \as Representing;
\definition Representative: \Set := Representing.Representative;
\definition representativeExists: \exists Representative := \block {
  \takefrom embedding: Original.Embedding \by Original.embeddingExists compactBase hausdorffBase \then
  \return \exact(Representing.Representative {
    presentation := Representation.FromEmbedding[embedding := embedding].presentation,
    isomorphism := Representation.FromEmbedding[embedding := embedding].isomorphism
  }, Representative)
};
\definition identified: \forall (p: Presentation)(iso: Isomorphism p) -> value = class p :=
  \fun (p: Presentation)(iso: Isomorphism p) => (classification p).rtl (\exact(iso, Isomorphism p));
