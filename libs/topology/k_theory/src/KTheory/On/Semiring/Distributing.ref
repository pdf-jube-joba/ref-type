\import \parent.\parent.Add[p := q, q := r] \as Sum;
\import \parent.\parent.Multiply[p := p, q := q] \as First;
\import \parent.\parent.Multiply[p := p, q := r] \as Second;
\import \parent.\parent.Realized[p := p] \as Realized;
\import \parent.\parent.Product[F := Fiber p, G := Sum.FiberAt, left := bundle p, right := Sum.sumBundle,
  leftSame := \refl(baseSpace), rightSame := \refl(baseSpace)] \as Left;
\import \parent.\parent.Sum[F := First.FiberAt, G := Second.FiberAt, left := First.tensorBundle, right := Second.tensorBundle,
  leftSame := \refl(baseSpace), rightSame := \refl(baseSpace)] \as Right;
\import Operations.TensorDistribution[X := X, F := Fiber p, G := Fiber q, H := Fiber r, left := bundle p, middle := bundle q, right := bundle r,
  sameMiddle := \refl(baseSpace), sameRight := \refl(baseSpace)] \as Distribution;
\import \parent.\parent.Compare[F := Left.FiberAt, G := Right.FiberAt, first := Left.tensorBundle, second := Right.sumBundle,
  firstSame := \refl(baseSpace), secondSame := \refl(baseSpace)] \as Comparison;
\definition leftEquation: mul (class p) (add (class q) (class r)) = Left.value :=
  trans!{Classes} _ _ _ (congr!{Classes Classes Classes} mul _ _ _ _ (sym!{Classes} _ _ Realized.equation) (Add.onClasses q r)) Left.onBundles;
\definition rightEquation: add (mul (class p) (class q)) (mul (class p) (class r)) = Right.value :=
  trans!{Classes} _ _ _ (congr!{Classes Classes Classes} add _ _ _ _ (Multiply.onClasses p q) (Multiply.onClasses p r)) Right.onBundles;
\definition equation: mul (class p) (add (class q) (class r)) = add (mul (class p) (class q)) (mul (class p) (class r)) :=
  trans!{Classes} _ _ _ leftEquation (trans!{Classes} _ _ _ (Comparison.ofIsomorphism Distribution.isomorphism) (sym!{Classes} _ _ rightEquation));
