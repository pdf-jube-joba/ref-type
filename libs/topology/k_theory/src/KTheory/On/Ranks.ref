\import \parent.IntegerFunctions[] \as Functions;
\import std.Arithmetic[].Int[] \as I;
\definition natural[n: N.Nat^]: I.Int^ := I.integer n N.Nat^::zero;
\module Of(F: X -> \Set, original: Bundles.Family[X := X, F := F].Bundle, same: original.baseSpace = baseSpace);
\module Comparing(F, G: X -> \Set, first: Bundles.Family[X := X, F := F].Bundle, second: Bundles.Family[X := X, F := G].Bundle,
  iso: Bundles.Isomorphisms[X := X, F := F, G := G, source := first, target := second].Isomorphism);
\definition representative[p: Presentation]: Functions.Carrier := \fun (x: X) => natural (Bundles.Family[X := X, F := Fiber p].Of[bundle := bundle p].rank x);
\definition respects: \forall (p, q: Presentation) -> Rep.Equivalent p q -> representative p = representative q := \block {
  \fun (p, q: Presentation)(related: Rep.Equivalent p q) \then
  \takefrom iso: Rep.Isomorphism p q \by related \then
  \return \axiom:funext(representative p, representative q,
    \fun (x: X) => congr!{{N.Nat^} {I.Int^}} natural _ _ (Comparing[F := Fiber p, G := Fiber q, first := bundle p, second := bundle q, iso := iso].equation x))
};
\import Quotient.Maps[B := Functions.Carrier] \as Descend;
\definition classes: Classes -> Functions.Carrier := Descend.value Rep.equivalence representative respects;
\definition onClasses: \forall (p: Presentation) -> classes (class p) = representative p := Descend.onClass Rep.equivalence representative respects;
\definition locallyConstantClasses: \forall (a: Classes) -> Functions.LocallyConstant (classes a) :=
  Quotient.induction (\fun (a: Classes) => Functions.LocallyConstant (classes a))
    (\fun (p: Presentation) => \idelim representative p = classes (class p) \with f: Functions.Carrier => Functions.LocallyConstant f \by {
      base: Of[F := Fiber p, original := bundle p, same := \refl(baseSpace)].locallyConstant,
      equality: sym!{{Functions.Carrier}} _ _ (onClasses p)
    });
\module Sum(F, G: X -> \Set, left: Bundles.Family[X := X, F := F].Bundle, right: Bundles.Family[X := X, F := G].Bundle,
  leftSame: left.baseSpace = baseSpace, rightSame: right.baseSpace = baseSpace);

\module Addition(p, q: Presentation);
\module Zero;
\import \parent.K0[] \as K;
\import algebra.GroupCompletion[].Of[M := Classes, monoid := K.additiveMonoid] \as Completion;
\import Completion.Universal[K := Functions.Carrier, target := Functions.group] \as Extension;
\import algebra.Hom[A := Classes, B := Functions.Carrier] \as Hom;
\import \parent.AdditiveMonoid[] \as Add;
\definition preservesAdd: \forall (a, b: Classes) -> classes (Add.add a b) = Functions.add (classes a) (classes b) :=
  Quotient.induction2 (\fun (a, b: Classes) => classes (Add.add a b) = Functions.add (classes a) (classes b))
    (\fun (p, q: Presentation) => Addition[p := p, q := q].equation);
\definition input: Extension.Map := \into[Classes -> Functions.Carrier](classes, Extension.Map) \by {
  Hom.MonoidLaws[Extension.domain, Extension.codomain, classes] {
    unit := Zero[].equation, operation := preservesAdd
  }
};
\definition rank: K.Carrier -> Functions.Carrier := Extension.extend input;
\definition rankIncludes: \forall (a: Classes) -> rank (K.include a) = classes a := Extension.extendIncludes input;
\definition rankAdd: \forall (x, y: K.Carrier) -> rank (K.add x y) = Functions.add (rank x) (rank y) := Extension.extendAdd input;
\definition rankZero: rank K.zero = Functions.zero := (algebra.Hom[A := K.Carrier, B := Functions.Carrier].monoidLaws Completion.asMonoid Extension.codomain (Extension.extension input)).unit;
\definition rankNeg: \forall (x: K.Carrier) -> rank (K.neg x) = Functions.neg (rank x) := Extension.homInverse (Extension.extension input);
\import std.Set[].Quotient[A := Completion.Difference, Equivalent := Completion.Equivalent] \as Differences;
\definition locallyConstant: \forall (x: K.Carrier) -> Functions.LocallyConstant (rank x) :=
  Differences.induction (\fun (x: K.Carrier) => Functions.LocallyConstant (rank x))
    (\fun (d: Completion.Difference) =>
      \idelim Functions.add (classes (Completion.positive d)) (Functions.neg (classes (Completion.negative d))) = rank (Completion.class d)
        \with f: Functions.Carrier => Functions.LocallyConstant f \by {
          base: Functions.addition (classes (Completion.positive d)) (Functions.neg (classes (Completion.negative d)))
            (locallyConstantClasses (Completion.positive d)) (Functions.negative (classes (Completion.negative d)) (locallyConstantClasses (Completion.negative d))),
          equality: sym!{{Functions.Carrier}} _ _ (Extension.extendClass input d)
        });
\module Reduced(point: X);
