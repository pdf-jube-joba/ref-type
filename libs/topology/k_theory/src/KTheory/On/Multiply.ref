\import Operations.Tensor[X := X, F := Fiber p, G := Fiber q, left := bundle p, right := bundle q] \as Tensor;
\definition FiberAt[x: X]: \Set := Tensor.Fiber x;
\definition tensorBundle: Bundles.Family[X := X, F := FiberAt].Bundle := Tensor.bundle (\refl(baseSpace));
\import \parent.Bundle[F := FiberAt, original := tensorBundle, same := \refl(baseSpace)] \as Class;
\definition value: Classes := Class.value;
\module Comparing(r, s: Presentation, first: Rep.Isomorphism p r, second: Rep.Isomorphism q s);
