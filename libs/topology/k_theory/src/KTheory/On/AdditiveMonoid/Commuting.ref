\import \parent.\parent.Add[p := p, q := q] \as First;
\import \parent.\parent.Add[p := q, q := p] \as Second;
\import Operations.DirectSum[X := X, F := Fiber p, G := Fiber q, left := bundle p, right := bundle q].Of[same := \refl(baseSpace)].Symmetry[] \as Symmetry;
\import \parent.\parent.Compare[F := First.FiberAt, G := Second.FiberAt, first := First.sumBundle, second := Second.sumBundle,
  firstSame := \refl(baseSpace), secondSame := \refl(baseSpace)] \as Comparison;
\definition equation: add (class p) (class q) = add (class q) (class p) :=
  trans!{Classes} _ _ _ (onClasses p q)
    (trans!{Classes} _ _ _ (Comparison.ofIsomorphism Symmetry.isomorphism) (sym!{Classes} _ _ (onClasses q p)));
