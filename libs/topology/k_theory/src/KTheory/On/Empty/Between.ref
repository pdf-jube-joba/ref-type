\definition Iso[x: X]: \Set := Spaces.Isomorphism[V := Fiber p x, W := Fiber q x,
  source := (bundle p).space x, target := (bundle q).space x].Isomorphism;
\definition fiber[x: X]: Iso x := \choice (Iso x) \by {
  existence: Logic.falseElim (\exists (Iso x)) (empty x),
  uniqueness: \fun (f, g: Iso x) => Logic.falseElim (f = g) (empty x)
};
\import Operations.LocalIsomorphisms[X := X, F := Fiber p, G := Fiber q,
  source := bundle p, target := bundle q, fiber := fiber] \as Local;
\definition covers: Local.Covers := \fun (x: X) => Logic.falseElim
  (\exists (c: Local.Chart \where topology.Topology[Carrier := X].Member c.domain x)) (empty x);
\definition isomorphism: Rep.Isomorphism p q := Local.isomorphism (\refl(baseSpace)) covers;
