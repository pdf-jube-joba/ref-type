\definition sameBase: left.baseSpace = right.baseSpace := trans!{{topology.Topology[Carrier := X].Topology}} _ _ _ leftSame (sym!{{topology.Topology[Carrier := X].Topology}} _ _ rightSame);
\import Operations.Tensor[X := X, F := F, G := G, left := left, right := right] \as Constructed;
\definition FiberAt[x: X]: \Set := Constructed.Fiber x;
\definition tensorBundle: Bundles.Family[X := X, F := FiberAt].Bundle := Constructed.bundle sameBase;
\import \parent.Bundle[F := F, original := left, same := leftSame] \as First;
\import \parent.Bundle[F := G, original := right, same := rightSame] \as Second;
\import \parent.Bundle[F := FiberAt, original := tensorBundle, same := leftSame] \as Class;
\definition value: Classes := Class.value;
\module WithRepresentatives(p, q: Presentation, first: First.Isomorphism p, second: Second.Isomorphism q);
\definition onBundles: \parent.Multiplication[].mul First.value Second.value = value := \block {
  \takefrom a: First.Representative \by First.representativeExists \then
  \takefrom b: Second.Representative \by Second.representativeExists \then
  \return WithRepresentatives[p := a.presentation, q := b.presentation, first := a.isomorphism, second := b.isomorphism].equation
};
