\import \parent.\parent.Multiply[p := p, q := q] \as Target;
\import \parent.\parent.Multiplication[] \as Multiplication;
\import Operations.TensorIsomorphisms[X := X, F := F, G := G, A := Fiber p, B := Fiber q,
  first := left, second := right, newFirst := bundle p, newSecond := bundle q,
  sameSource := sameBase, sameTarget := \refl(baseSpace)] \as Comparison;
\import \parent.\parent.Compare[F := FiberAt, G := Target.FiberAt, first := tensorBundle, second := Target.tensorBundle,
  firstSame := leftSame, secondSame := \refl(baseSpace)] \as ClassesEqual;
\definition targetEqual: value = Target.value := ClassesEqual.ofIsomorphism (Comparison.isomorphism first second);
\definition equation: Multiplication.mul First.value Second.value = value :=
  trans!{Classes} _ _ _ (congr!{Classes Classes Classes} Multiplication.mul _ _ _ _ (First.identified p first) (Second.identified q second))
    (trans!{Classes} _ _ _ (Multiplication.onClasses p q) (sym!{Classes} _ _ targetEqual));
