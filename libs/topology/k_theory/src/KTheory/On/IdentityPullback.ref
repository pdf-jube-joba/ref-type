\definition regular: topology.Continuity[A := X, B := X].Continuous baseSpace baseSpace (\fun (x: X) => x) := topology.Maps[A := X, B := X].Identity[].continuous baseSpace;
\import \parent.Pullback[Y := X, space := baseSpace, sourceCompact := compact, sourceHausdorff := hausdorff, f := \fun (x: X) => x, regular := regular] \as Pull;
\module At(p: Presentation);
\definition onClasses: \forall (a: Classes) -> Pull.map a = a := Quotient.induction (\fun (a: Classes) => Pull.map a = a) (\fun (p: Presentation) => At[p := p].equation);
\import \parent.K0[] \as K;
\import algebra.Hom[A := K.Carrier, B := K.Carrier] \as Hom;
\definition identity: Hom.RingMap K.ring K.ring := \into[K.Carrier -> K.Carrier]((\fun (x: K.Carrier) => x), Hom.RingMap K.ring K.ring) \by {
  Hom.SemiringLaws[(std.Alg[].Ring[].ringAsSemiring K.Carrier K.ring), (std.Alg[].Ring[].ringAsSemiring K.Carrier K.ring), (\fun (x: K.Carrier) => x)] {
    zero := \refl(K.zero), one := \refl(K.one), add := \fun (a, b: K.Carrier) => \refl(K.add a b), mul := \fun (a, b: K.Carrier) => \refl(K.mul a b)
  }
};
\definition ringMap: Pull.K0[].map = identity := K.Maps[K := K.Carrier, target := K.ring].ext Pull.K0[].map identity
  (\fun (a: Classes) => trans!{{K.Carrier}} _ _ _ (Pull.K0[].onIncludes a) (congr!{Classes {K.Carrier}} K.include _ _ (onClasses a)));
\definition onK0: \forall (x: K.Carrier) -> Pull.K0[].map x = x := \fun (x: K.Carrier) => congr!{{K.Carrier -> K.Carrier} {K.Carrier}} (\fun (f: K.Carrier -> K.Carrier) => f x) _ _ ringMap;
