\import Bundles.Trivial[X := X, n := n, baseSpace := baseSpace] \as Constructed;
\definition FiberAt[x: X]: \Set := Bundles.Vector n;
\definition trivialBundle: Bundles.Family[X := X, F := FiberAt].Bundle := Constructed.bundle;
\import \parent.Bundle[F := FiberAt, original := trivialBundle, same := \refl(baseSpace)] \as Class;
\definition value: Classes := Class.value;
