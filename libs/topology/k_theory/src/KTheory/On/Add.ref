\import Operations.DirectSum[X := X, F := Fiber p, G := Fiber q, left := bundle p, right := bundle q] \as Sum;
\definition FiberAt[x: X]: \Set := Sum.Fiber x;
\definition sumBundle: Bundles.Family[X := X, F := FiberAt].Bundle := Sum.bundle (\refl(baseSpace));
\import \parent.Bundle[F := FiberAt, original := sumBundle, same := \refl(baseSpace)] \as Class;
\definition value: Classes := Class.value;
