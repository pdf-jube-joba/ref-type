\import \parent.\parent.Trivial[n := n] \as Original;
\import Target.Trivial[n := n] \as Destination;
\import \parent.Of[F := Original.FiberAt, original := Original.trivialBundle, same := (\refl(baseSpace))] \as Pulled;
\import Operations.TrivialPullback[X := X, Y := Y, n := n, original := baseSpace, base := space, f := f, regular := regular] \as Comparison;
\import Target.Compare[F := (\fun (y: Y) => Bundles.Vector n), G := Destination.FiberAt, first := Pulled.pulled, second := Destination.trivialBundle,
  firstSame := (\refl(space)), secondSame := (\refl(space))] \as ClassesComparison;
\definition equation: map Original.value = Destination.value := trans!{{Target.Classes}} _ _ _ Pulled.naturality (ClassesComparison.ofIsomorphism Comparison.isomorphism);
\import \parent.K0[] \as Pull;
\import \parent.\parent.K0[] \as SourceK;
\import Target.K0[] \as TargetK;
\definition onK0: Pull.map (SourceK.include Original.value) = TargetK.include Destination.value := trans!{{TargetK.Carrier}} _ _ _
  (Pull.onIncludes Original.value) (congr!{{Target.Classes} {TargetK.Carrier}} TargetK.include _ _ equation);
