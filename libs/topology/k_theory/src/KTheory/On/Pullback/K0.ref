\import \parent.\parent.K0[] \as Source;
\import Target.K0[] \as Destination;
\import algebra.GroupCompletion[].Semiring[M := Classes, semiring := SourceSemiring.semiring].UniversalRing[K := Destination.Carrier, target := Destination.ring] \as Extension;
\import algebra.Hom[A := Classes, B := Target.Classes].Composition[C := Destination.Carrier] \as Compose;
\definition input: Extension.InputMap := Compose.semiring SourceSemiring.semiring TargetSemiring.semiring
  (std.Alg[].Ring[].ringAsSemiring Destination.Carrier Destination.ring) semiringMap Destination.inclusion;
\definition map: algebra.Hom[A := Source.Carrier, B := Destination.Carrier].RingMap Source.ring Destination.ring := Extension.extension input;
\definition onIncludes: \forall (a: Classes) -> map (Source.include a) = Destination.include (\parent.map a) := Extension.includes input;
