\import \parent.\parent.Ranks[] \as SourceRanks;
\import Target.Ranks[] \as TargetRanks;
\import std.Arithmetic[].Int[] \as I;
\module At(p: Presentation);
\definition classes: \forall (a: Classes)(y: Y) -> TargetRanks.classes (Native.map a) y = SourceRanks.classes a (f y) :=
  Quotient.induction (\fun (a: Classes) => \forall (y: Y) -> TargetRanks.classes (Native.map a) y = SourceRanks.classes a (f y))
    (\fun (p: Presentation) => At[p := p].equation);
\import \parent.\parent.K0[] \as Source;
\import Target.K0[] \as Destination;
\import \parent.K0[] \as Pull;
\import algebra.Hom[A := Source.Carrier, B := Destination.Carrier] \as Hom;
\module Difference(a, b: Classes);
\import algebra.GroupCompletion[].Of[M := Classes, monoid := Source.additiveMonoid] \as Completion;
\import std.Set[].Quotient[A := Completion.Difference, Equivalent := Completion.Equivalent] \as Differences;
\definition naturality: \forall (x: Source.Carrier)(y: Y) -> TargetRanks.rank (Pull.map x) y = SourceRanks.rank x (f y) :=
  Differences.induction (\fun (x: Source.Carrier) => \forall (y: Y) -> TargetRanks.rank (Pull.map x) y = SourceRanks.rank x (f y))
    (\fun (d: Completion.Difference) => \idelim Source.difference (Completion.positive d) (Completion.negative d) = Completion.class d
      \with x: Source.Carrier => \forall (y: Y) -> TargetRanks.rank (Pull.map x) y = SourceRanks.rank x (f y) \by {
        base: Difference[a := Completion.positive d, b := Completion.negative d].equation,
        equality: Source.differenceClass (Completion.positive d) (Completion.negative d)
      });
