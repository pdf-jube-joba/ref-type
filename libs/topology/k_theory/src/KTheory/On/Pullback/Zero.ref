\import \parent.\parent.Trivial[n := zero] \as Original;
\import Target.Trivial[n := zero] \as Other;
\import \parent.Of[F := Original.FiberAt, original := Original.trivialBundle, same := \refl(baseSpace)] \as Pull;
\import Operations.Zero[X := Y, baseSpace := space] \as Zero;
\import Zero.From[F := \fun (y: Y) => Original.FiberAt (f y), source := Pull.pulled, sameBase := \refl(space)] \as Forward;
\import Zero.To[F := \fun (y: Y) => Original.FiberAt (f y), target := Pull.pulled, sameBase := \refl(space)] \as Backward;
\import Fin.Empty[A := C.Complex] \as Empty;
\definition isomorphism: Bundles.Isomorphisms[X := Y, F := \fun (y: Y) => Original.FiberAt (f y), G := Other.FiberAt, source := Pull.pulled, target := Other.trivialBundle].Isomorphism :=
  Bundles.Isomorphisms[X := Y, F := \fun (y: Y) => Original.FiberAt (f y), G := Other.FiberAt, source := Pull.pulled, target := Other.trivialBundle].Isomorphism {
    forward := Forward.map, backward := Backward.map,
    leftInverse := \fun (y: Y)(v: Original.FiberAt (f y)) => Empty.unique _ v,
    rightInverse := \fun (y: Y)(v: Other.FiberAt y) => Empty.unique _ v
  };
\import Target.Compare[F := \fun (y: Y) => Original.FiberAt (f y), G := Other.FiberAt, first := Pull.pulled, second := Other.trivialBundle,
  firstSame := \refl(space), secondSame := \refl(space)] \as Comparison;
\definition equation: map Original.value = Other.value := trans!{{Target.Classes}} _ _ _ Pull.naturality (Comparison.ofIsomorphism isomorphism);
