\import \parent.\parent.Of[F := Fiber p, original := bundle p, same := \refl(baseSpace)] \as Pull;
\import \parent.\parent.\parent.Realized[p := p] \as Original;
\import TargetRanks.Of[F := \fun (y: Y) => Fiber p (f y), original := Pull.pulled, same := \refl(space)] \as Rank;
\import Bundles.Family[X := X, F := Fiber p].Of[bundle := bundle p].Pullback[Y := Y, source := space, f := f] \as NativePull;
\definition classEquation: Native.map (class p) = Pull.value :=
  trans!{{Target.Classes}} _ _ _ (congr!{Classes {Target.Classes}} Native.map _ _ (sym!{Classes} _ _ Original.equation)) Pull.naturality;
\definition equation: \forall (y: Y) -> TargetRanks.classes (Native.map (class p)) y = SourceRanks.classes (class p) (f y) := \fun (y: Y) =>
  eq_reason_in!{{I.Int^} _
    "=" { TargetRanks.classes Pull.value y } "by" { congr!{{Target.Classes} {I.Int^}} (\fun (a: Target.Classes) => TargetRanks.classes a y) _ _ classEquation }
    "=" { Rank.rank y } "by" { congr!{{Y -> I.Int^} {I.Int^}} (\fun (r: Y -> I.Int^) => r y) _ _ Rank.onBundle }
    "=" { SourceRanks.representative p (f y) } "by" { congr!{{N.Nat^} {I.Int^}} SourceRanks.natural _ _ (NativePull.Of[regular := regular].rank y) }
    "=" { SourceRanks.classes (class p) (f y) } "by" { congr!{{X -> I.Int^} {I.Int^}} (\fun (r: X -> I.Int^) => r (f y)) _ _ (sym!{{X -> I.Int^}} _ _ (SourceRanks.onClasses p)) }
  };
