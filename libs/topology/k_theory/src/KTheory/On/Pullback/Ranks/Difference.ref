\definition difference: Pull.map (Source.difference a b) = Destination.difference (Native.map a) (Native.map b) :=
  trans!{{Destination.Carrier}} _ _ _ ((Hom.semiringLaws (std.Alg[].Ring[].ringAsSemiring Source.Carrier Source.ring) (std.Alg[].Ring[].ringAsSemiring Destination.Carrier Destination.ring) Pull.map).add (Source.include a) (Source.neg (Source.include b)))
    (congr!{{Destination.Carrier} {Destination.Carrier} {Destination.Carrier}} Destination.add _ _ _ _ (Pull.onIncludes a)
      (trans!{{Destination.Carrier}} _ _ _ (Source.Maps[K := Destination.Carrier, target := Destination.ring].preservesNeg Pull.map (Source.include b))
        (congr!{{Destination.Carrier} {Destination.Carrier}} Destination.neg _ _ (Pull.onIncludes b))));
\definition equation: \forall (y: Y) -> TargetRanks.rank (Pull.map (Source.difference a b)) y = SourceRanks.rank (Source.difference a b) (f y) := \fun (y: Y) =>
  eq_reason_in!{{I.Int^} _
    "=" { TargetRanks.rank (Destination.difference (Native.map a) (Native.map b)) y } "by" { congr!{{Destination.Carrier} {I.Int^}} (\fun (x: Destination.Carrier) => TargetRanks.rank x y) _ _ difference }
    "=" { I.Add.specification (TargetRanks.classes (Native.map a) y) (I.Neg.specification (TargetRanks.classes (Native.map b) y)) } "by" { congr!{{Y -> I.Int^} {I.Int^}} (\fun (r: Y -> I.Int^) => r y) _ _ (TargetRanks.rankDifference (Native.map a) (Native.map b)) }
    "=" { I.Add.specification (SourceRanks.classes a (f y)) (I.Neg.specification (SourceRanks.classes b (f y))) } "by" { congr!{{I.Int^} {I.Int^} {I.Int^}} (\fun (s, t: I.Int^) => I.Add.specification s (I.Neg.specification t)) _ _ _ _ (classes a y) (classes b y) }
    "=" { SourceRanks.rank (Source.difference a b) (f y) } "by" { congr!{{X -> I.Int^} {I.Int^}} (\fun (r: X -> I.Int^) => r (f y)) _ _ (sym!{{X -> I.Int^}} _ _ (SourceRanks.rankDifference a b)) }
  };
