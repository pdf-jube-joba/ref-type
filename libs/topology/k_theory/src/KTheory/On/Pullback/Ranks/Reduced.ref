\import SourceRanks.Reduced[point := point] \as Original;
\import TargetRanks.Reduced[point := sourcePoint] \as Result;
\definition map[x: Original.Carrier]: Result.Carrier := \into[Destination.Carrier](Pull.map x, Result.kernel) \by {
  trans!{{I.Int^}} _ _ _ (naturality x sourcePoint)
    (trans!{{I.Int^}} _ _ _ (congr!{X {I.Int^}} (SourceRanks.rank x) _ _ preserves) (\bysub(Source.Carrier, Original.kernel, x)))
};
\definition additive: \forall (x, y: Original.Carrier) -> map (Original.group.base.op x y) = Result.group.base.op (map x) (map y) :=
  \fun (x, y: Original.Carrier) =>
    (Hom.semiringLaws (std.Alg[].Ring[].ringAsSemiring Source.Carrier Source.ring) (std.Alg[].Ring[].ringAsSemiring Destination.Carrier Destination.ring) Pull.map).add x y;
