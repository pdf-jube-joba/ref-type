\import \parent.\parent.Bundle[F := F, original := original, same := same] \as Original;
\import Native.Of[F := F, original := original, same := same] \as Pull;
\definition pulled: Bundles.Family[X := Y, F := \fun (y: Y) => F (f y)].Bundle := Pull.pulled;
\import Target.Bundle[F := \fun (y: Y) => F (f y), original := pulled, same := \refl(space)] \as Class;
\definition value: Target.Classes := Class.value;
\definition naturality: map Original.value = value := Pull.naturality Original.compactBase Original.hausdorffBase sourceCompact sourceHausdorff;
