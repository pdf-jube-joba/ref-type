\import \parent.\parent.\parent.Realized[p := p] \as Original;
\import \parent.\parent.Of[F := Fiber p, original := bundle p, same := \refl(baseSpace)] \as First;
\import Next.Of[F := \fun (y: Y) => Fiber p (f y), original := First.pulled, same := \refl(space)] \as Nested;
\import Direct.Of[F := Fiber p, original := bundle p, same := \refl(baseSpace)] \as Pulled;
\import Bundles.Family[X := X, F := Fiber p].Of[bundle := bundle p].PullbackComposition[Y := Y, Z := Z, first := space, second := nextSpace, f := f, g := g].Of[fRegular := regular, gRegular := nextRegular] \as NativeComparison;
\import Result.Compare[F := \fun (z: Z) => Fiber p (f (g z)), G := \fun (z: Z) => Fiber p (f (g z)), first := Pulled.pulled, second := Nested.pulled,
  firstSame := \refl(nextSpace), secondSame := \refl(nextSpace)] \as Comparison;
\definition firstEquation: Native.map (class p) = First.value := trans!{{Target.Classes}} _ _ _
  (congr!{Classes {Target.Classes}} Native.map _ _ (sym!{Classes} _ _ Original.equation)) First.naturality;
\definition equation: Direct.map (class p) = Next.map (Native.map (class p)) :=
  eq_reason_in!{{Result.Classes} _
    "=" { Direct.map Original.value } "by" { congr!{Classes {Result.Classes}} Direct.map _ _ (sym!{Classes} _ _ Original.equation) }
    "=" { Pulled.value } "by" { Pulled.naturality }
    "=" { Nested.value } "by" { Comparison.ofIsomorphism NativeComparison.isomorphism }
    "=" { Next.map First.value } "by" { sym!{{Result.Classes}} _ _ Nested.naturality }
    "=" { Next.map (Native.map (class p)) } "by" { congr!{{Target.Classes} {Result.Classes}} Next.map _ _ (sym!{{Target.Classes}} _ _ firstEquation) }
  };
