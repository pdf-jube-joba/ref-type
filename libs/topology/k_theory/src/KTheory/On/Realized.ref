\import \parent.Bundle[F := Fiber p, original := bundle p, same := \refl(baseSpace)] \as Class;
\import Operations.IdentityIsomorphism[X := X, F := Fiber p, bundle := bundle p] \as Identity;
\definition equation: Class.value = class p := (Class.classification p).rtl (\exact(Identity.isomorphism, Class.Isomorphism p));
