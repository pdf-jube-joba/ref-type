\import \parent.FiniteDiscrete[n := one] \as Finite;
\import \parent.On[X := Fin.Fin one, baseSpace := topology.Topology[Carrier := Fin.Fin one].Discrete, compact := Finite.compact, hausdorff := Finite.hausdorff].K0[] \as Group;
\import Finite.Computation[] \as Computation;
\import std.Arithmetic[].Int[] \as I;
\definition Carrier: \Set := Computation.Carrier;
\definition point: Fin.Fin one := Fin.zero zero;
\definition forward[x: Carrier]: I.Int^ := Computation.forward x point;
\definition backward[z: I.Int^]: Carrier := Computation.backward (\fun (x: Fin.Fin one) => z);
\definition rightInverse: \forall (z: I.Int^) -> forward (backward z) = z := \fun (z: I.Int^) =>
  congr!{{Fin.Fin one -> I.Int^} {I.Int^}} (\fun (f: Fin.Fin one -> I.Int^) => f point) _ _ (Computation.rightInverse (\fun (x: Fin.Fin one) => z));
\definition leftInverse: \forall (x: Carrier) -> backward (forward x) = x := \fun (x: Carrier) =>
  trans!{Carrier} _ _ _ (congr!{{Fin.Fin one -> I.Int^} Carrier} Computation.backward _ _
    (\axiom:funext((\fun (i: Fin.Fin one) => forward x), Computation.forward x, \fun (i: Fin.Fin one) =>
      congr!{{Fin.Fin one} {I.Int^}} (Computation.forward x) _ _ (sym!{{Fin.Fin one}} _ _ (Fin.singletonValue i)))))
    (Computation.leftInverse x);
\definition additive: \forall (x, y: Carrier) -> forward (Group.add x y) = I.Add.specification (forward x) (forward y) := \fun (x, y: Carrier) =>
  congr!{{Fin.Fin one -> I.Int^} {I.Int^}} (\fun (f: Fin.Fin one -> I.Int^) => f point) _ _ (Computation.additive x y);
\import \parent.On[X := Fin.Fin one, baseSpace := topology.Topology[Carrier := Fin.Fin one].Discrete, compact := Finite.compact, hausdorff := Finite.hausdorff].Ranks[] \as Ranks;
\definition zeroRank: forward Group.zero = I.Zero.specification :=
  congr!{{Fin.Fin one -> I.Int^} {I.Int^}} (\fun (f: Fin.Fin one -> I.Int^) => f point) _ _ Ranks.rankZero;
\definition oneRank: forward Group.one = I.One.specification :=
  congr!{{Fin.Fin one -> I.Int^} {I.Int^}} (\fun (f: Fin.Fin one -> I.Int^) => f point) _ _ Ranks.One[].virtual;
\definition injective: \forall (x, y: Carrier) -> forward x = forward y -> x = y := \fun (x, y: Carrier)(equal: _) =>
  trans!{Carrier} _ _ _ (sym!{Carrier} _ _ (leftInverse x)) (trans!{Carrier} _ _ _ (congr!{{I.Int^} Carrier} backward _ _ equal) (leftInverse y));
\import Ranks.Reduced[point := point] \as Reduced;
\definition reducedZero: \forall (x: Reduced.Carrier) -> x = Group.zero := \fun (x: Reduced.Carrier) => injective x Group.zero
  (trans!{{I.Int^}} _ _ _ (\bysub(Carrier, Reduced.kernel, x)) (sym!{{I.Int^}} _ _ zeroRank));
\definition backwardZero: backward I.Zero.specification = Group.zero := injective _ _ (trans!{{I.Int^}} _ _ _ (rightInverse I.Zero.specification) (sym!{{I.Int^}} _ _ zeroRank));
\definition backwardOne: backward I.One.specification = Group.one := injective _ _ (trans!{{I.Int^}} _ _ _ (rightInverse I.One.specification) (sym!{{I.Int^}} _ _ oneRank));
\definition backwardAdd: \forall (a, b: I.Int^) -> backward (I.Add.specification a b) = Group.add (backward a) (backward b) := \fun (a, b: I.Int^) =>
  injective _ _ (trans!{{I.Int^}} _ _ _ (rightInverse (I.Add.specification a b))
    (sym!{{I.Int^}} _ _ (trans!{{I.Int^}} _ _ _ (additive (backward a) (backward b))
      (congr!{{I.Int^} {I.Int^} {I.Int^}} I.Add.specification _ _ _ _ (rightInverse a) (rightInverse b)))));
\module Multiplication(y: Carrier);
\definition multiplicative: \forall (x, y: Carrier) -> forward (Group.mul x y) = I.Mul.specification (forward x) (forward y) := \fun (x, y: Carrier) =>
  trans!{{I.Int^}} _ _ _ (congr!{Carrier {I.Int^}} (\fun (u: Carrier) => forward (Group.mul u y)) _ _ (sym!{Carrier} _ _ (leftInverse x)))
    (Multiplication[y := y].equation (forward x));
\module Ring;
