\import algebraic_topology.Simplex[] \as Simplex;
\import singular_cohomology.Simplices[A := Product.CarrierSet, source := topology] \as Simplices;
\import \root.Models[].ProductCells[] \as Models;
\module At(n: N.Nat^);
\module Zero;
\module Successor(n: N.Nat^);
\import Native.Homotopy[C := Chains.complex, D := Chains.complex] \as Homotopies;
\definition data: Homotopies.Data := Homotopies.Data { apply := \fun (n: N.Nat^) => #apply{At[n := n].map} };
\definition homotopy: Homotopies.Homotopy productComposite (Native.End[C := Chains.complex].identity) :=
  \into[Homotopies.Data](data, { h: Homotopies.Data \where Homotopies.Laws[productComposite, Native.End[C := Chains.complex].identity, h] }) \by {
    Homotopies.Laws[productComposite, Native.End[C := Chains.complex].identity, data] {
      addition := \fun (n: N.Nat^) => #addition{At[n := n].map},
      scalar := \fun (n: N.Nat^) => #scalar{At[n := n].map},
      zeroEquation := Zero[].law,
      successorEquation := \fun (n: N.Nat^) => Successor[n := n].Equation[].law,
    }
  };
