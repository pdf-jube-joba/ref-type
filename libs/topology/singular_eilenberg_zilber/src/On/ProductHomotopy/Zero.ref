\definition n: N.Nat^ := N.Nat^::zero;
\import \parent.At[n := n] \as Degree;
\import \root.Models[].At[n := n] \as Model;
\import singular_cohomology.Chains[A := Model.Points, source := Model.topology] \as ModelChains;
\import singular_cohomology.Maps[A := Model.Points, B := Product.CarrierSet, source := Model.topology, target := topology] \as Maps;
\import Modules.Hom[V := ModelChains.Carrier n, W := Chains.Carrier n, source := ModelChains.space n, target := Chains.space n] \as PushLinear;
\definition prior[sigma: Simplices.Carrier n]: Degree.Boundary[].prior sigma = (Chains.space n).zero :=
  trans!{{Chains.Carrier n}} _ _ _
    (congr!{{ModelChains.Carrier n} {Chains.Carrier n}} ((Maps.push (Degree.function sigma) (Degree.continuous sigma)).apply n) _ _ Models.priorZero)
    (PushLinear.zeroPreserved (Maps.At[n := n].push (Degree.function sigma) (Degree.continuous sigma)));
\import Modules.Laws[V := Chains.Carrier n, space := Chains.space n] \as Values;
\import algebra.Group[].Of[Carrier := Chains.Carrier n, group := Values.additive] \as Group;
\definition onSimplex[sigma: Simplices.Carrier n]: (Chains.boundary n).apply (Degree.onSimplex sigma) = (productDefect).apply n (Chains.generator n sigma) :=
  trans!{{Chains.Carrier n}} _ _ _ (Degree.Boundary[].law sigma)
    (trans!{{Chains.Carrier n}} _ _ _
      (congr!{{Chains.Carrier n} {Chains.Carrier n}} (Group.difference ((productDefect).apply n (Chains.generator n sigma))) _ _ (prior sigma))
      (trans!{{Chains.Carrier n}} _ _ _
        (congr!{{Chains.Carrier n} {Chains.Carrier n}} (Values.add ((productDefect).apply n (Chains.generator n sigma))) _ _ Group.negZero)
        (Group.zeroRight _)));
\import Modules.Hom[V := Chains.Carrier n, W := Chains.Carrier n, source := Chains.space n, target := Chains.space n] \as Linear;
\import Native.Map[C := Chains.complex, D := Chains.complex].At[n := n] \as EndDegree;
\import Modules.Hom[V := Chains.Carrier (N.Nat^::succ n), W := Chains.Carrier n, source := Chains.space (N.Nat^::succ n), target := Chains.space n].Composition[U := Chains.Carrier n, domain := Chains.space n] \as Composition;
\import Modules.Free[Generators := Simplices.Carrier n].To[W := Chains.Carrier n, target := Chains.space n] \as Free;
\definition equation: Composition.compose (Chains.boundary n) Degree.map = EndDegree.linear productDefect := Free.ext _ _ (\fun (sigma: Simplices.Carrier n) =>
  trans!{{Chains.Carrier n}} _ _ _
    (congr!{{Chains.Carrier (N.Nat^::succ n)} {Chains.Carrier n}} ((Chains.boundary n).apply) _ _ (Degree.onGenerator sigma))
    (onSimplex sigma));
\definition law[x: Chains.Carrier n]: (productDefect).apply n x = (Chains.boundary n).apply ((Degree.map).apply x) := sym!{{Chains.Carrier n}} _ _ (congr!{Linear.Map {Chains.Carrier n}} (\fun (h: Linear.Map) => (h).apply x) _ _ equation);
