\import \root.Models[].Face[n := n, i := i] \as Face;
\import Faces.Composition[C := Product.CarrierSet, final := topology] \as Functor;
\import Native.Map[C := HighChains.complex, D := Chains.complex].Composition[B := LowChains.complex] \as Composition;
\import Native.Map[C := LowChains.complex, D := Chains.complex] \as Linear;
\definition points(sigma: Simplices.Carrier (N.Nat^::succ n))(x: LowModel.Points): Higher.function sigma (Face.function x) = Lower.function (Simplices.face n i sigma) x := \refl(Higher.function sigma (Face.function x));
\definition equation(sigma: Simplices.Carrier (N.Nat^::succ n)): Composition.compose (HighMaps.push (Higher.function sigma) (Higher.continuous sigma)) (Faces.push Face.function Face.continuous) = LowMaps.push (Lower.function (Simplices.face n i sigma)) (Lower.continuous (Simplices.face n i sigma)) :=
  trans!{Linear.Map} _ _ _ (Functor.functoriality Face.function Face.continuous (Higher.function sigma) (Higher.continuous sigma))
    (LowMaps.FunctionEquality[].law _ _ _ _ (points sigma));
\definition law(sigma: Simplices.Carrier (N.Nat^::succ n))(k: N.Nat^)(x: LowChains.Carrier k): #apply{HighMaps.push (Higher.function sigma) (Higher.continuous sigma)} k (#apply{Faces.push Face.function Face.continuous} k x) = #apply{LowMaps.push (Lower.function (Simplices.face n i sigma)) (Lower.continuous (Simplices.face n i sigma))} k x :=
  congr!{Linear.Map {Chains.Carrier k}} (\fun (f: Linear.Map) => #apply{f} k x) _ _ (equation sigma);
