\import Native.Map[C := Chains.complex, D := TargetChains.complex].At[n := n] \as ProductLinear;
\import Native.Map[C := Total.complex, D := Chains.complex].At[n := n] \as SourceLinear;
\import Native.Map[C := Total.complex, D := TargetTotal.complex].At[n := n] \as TensorLinear;
\import Native.Map[C := TargetTotal.complex, D := TargetChains.complex].At[n := n] \as TargetLinear;
\import Modules.Hom[V := Chains.Carrier n, W := TargetChains.Carrier n, source := Chains.space n, target := TargetChains.space n].Composition[U := Total.Carrier n, domain := Total.space n] \as AfterProduct;
\import Modules.Hom[V := TargetTotal.Carrier n, W := TargetChains.Carrier n, source := TargetTotal.space n, target := TargetChains.space n].Composition[U := Total.Carrier n, domain := Total.space n] \as AfterTensor;
\import Modules.Hom[V := Total.Carrier n, W := TargetChains.Carrier n, source := Total.space n, target := TargetChains.space n] \as Maps;
\definition lhs: Maps.Map := AfterProduct.compose (ProductLinear.linear product) (SourceLinear.linear backward);
\definition rhs: Maps.Map := AfterTensor.compose (TargetLinear.linear Other.backward) (TensorLinear.linear tensor);
\import Total.Degree[n := n] \as SourceSum;
\import TargetTotal.Degree[n := n] \as TargetSum;
\import Double.Map[C := Tensor.complex, D := TargetTensor.complex].Total[f := TensorMapping.map].Degree[n := n] \as MappingDegree;
\import singular_products.Cross[A := C, B := D, left := leftTarget, right := rightTarget].Total[] \as TargetShuffle;
\import Modules.DirectSum[Index := Double.Index n, family := SourceSum.family].To[W := TargetChains.Carrier n, target := TargetChains.space n] \as Extension;
\module At(i: Double.Index n);
\definition equation: lhs = rhs := Extension.ext lhs rhs (\fun (i: Double.Index n) => At[i := i].law);
\definition law(x: Total.Carrier n): #apply{lhs} x = #apply{rhs} x := congr!{Maps.Map {TargetChains.Carrier n}} (\fun (h: Maps.Map) => #apply{h} x) _ _ equation;
