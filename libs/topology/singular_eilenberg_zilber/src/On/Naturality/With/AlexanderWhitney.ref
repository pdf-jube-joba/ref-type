\import Native.Map[C := Total.complex, D := TargetTotal.complex].At[n := n] \as TensorLinear;
\import Forward.At[n := n] \as SourceLinear;
\import Native.Map[C := Chains.complex, D := TargetChains.complex].At[n := n] \as ProductLinear;
\import Native.Map[C := TargetChains.complex, D := TargetTotal.complex].At[n := n] \as TargetLinear;
\import Modules.Hom[V := Total.Carrier n, W := TargetTotal.Carrier n, source := Total.space n, target := TargetTotal.space n].Composition[U := Chains.Carrier n, domain := Chains.space n] \as AfterTensor;
\import Modules.Hom[V := TargetChains.Carrier n, W := TargetTotal.Carrier n, source := TargetChains.space n, target := TargetTotal.space n].Composition[U := Chains.Carrier n, domain := Chains.space n] \as AfterProduct;
\import Modules.Hom[V := Chains.Carrier n, W := TargetTotal.Carrier n, source := Chains.space n, target := TargetTotal.space n] \as Maps;
\definition lhs: Maps.Map := AfterTensor.compose (TensorLinear.linear tensor) (SourceLinear.linear forward);
\definition rhs: Maps.Map := AfterProduct.compose (TargetLinear.linear Other.forward) (ProductLinear.linear product);
\import Double.Coordinates[C := TargetTensor.complex].Degree[n := n] \as Coordinates;
\import Double.Map[C := Tensor.complex, D := TargetTensor.complex].Total[f := TensorMapping.map].Coordinates[n := n] \as MappingCoordinates;
\import singular_products.AlexanderWhitney[A := C, B := D, left := leftTarget, right := rightTarget].Total[] \as TargetAW;
\module At(i: Double.Index n);
\definition law[x: Chains.Carrier n]: (lhs).apply x = (rhs).apply x := Coordinates.ext _ _ (\fun (i: Double.Index n) => At[i := i].law x);
\definition equation: lhs = rhs := Maps.ext lhs rhs law;
