\import \parent.AlexanderWhitney[n := n] \as AWNatural;
\import \parent.Shuffle[n := n] \as ShuffleNatural;
\definition productLaw[x: Chains.Carrier n]: (product).apply n ((productComposite).apply n x) = (Other.productComposite).apply n ((product).apply n x) :=
  trans!{{TargetChains.Carrier n}} _ _ _ (ShuffleNatural.law ((forward).apply n x))
    (congr!{{TargetTotal.Carrier n} {TargetChains.Carrier n}} ((Other.backward).apply n) _ _ (AWNatural.law x));
\definition tensorLaw[x: Total.Carrier n]: (tensor).apply n ((tensorComposite).apply n x) = (Other.tensorComposite).apply n ((tensor).apply n x) :=
  trans!{{TargetTotal.Carrier n}} _ _ _ (AWNatural.law ((backward).apply n x))
    (congr!{{TargetChains.Carrier n} {TargetTotal.Carrier n}} ((Other.forward).apply n) _ _ (ShuffleNatural.law x));
\import Modules.Hom[V := Chains.Carrier n, W := TargetChains.Carrier n, source := Chains.space n, target := TargetChains.space n] \as ProductMapsLinear;
\import Native.Map[C := Chains.complex, D := TargetChains.complex].At[n := n] \as ProductDegree;
\import Modules.Laws[V := TargetChains.Carrier n, space := TargetChains.space n] \as ProductValues;
\import algebra.Group[].Of[Carrier := TargetChains.Carrier n, group := ProductValues.additive] \as ProductGroup;
\definition productDefectLaw[x: Chains.Carrier n]: (product).apply n ((productDefect).apply n x) = (Other.productDefect).apply n ((product).apply n x) :=
  trans!{{TargetChains.Carrier n}} _ _ _ (ProductMapsLinear.differencePreserved (ProductDegree.linear product) ((productComposite).apply n x) x)
    (congr!{{TargetChains.Carrier n} {TargetChains.Carrier n}} (\fun (y: TargetChains.Carrier n) => ProductGroup.difference y ((product).apply n x)) _ _ (productLaw x));
\import Modules.Hom[V := Total.Carrier n, W := TargetTotal.Carrier n, source := Total.space n, target := TargetTotal.space n] \as TensorMapsLinear;
\import Native.Map[C := Total.complex, D := TargetTotal.complex].At[n := n] \as TensorDegree;
\import Modules.Laws[V := TargetTotal.Carrier n, space := TargetTotal.space n] \as TensorValues;
\import algebra.Group[].Of[Carrier := TargetTotal.Carrier n, group := TensorValues.additive] \as TensorGroup;
\definition tensorDefectLaw[x: Total.Carrier n]: (tensor).apply n ((tensorDefect).apply n x) = (Other.tensorDefect).apply n ((tensor).apply n x) :=
  trans!{{TargetTotal.Carrier n}} _ _ _ (TensorMapsLinear.differencePreserved (TensorDegree.linear tensor) ((tensorComposite).apply n x) x)
    (congr!{{TargetTotal.Carrier n} {TargetTotal.Carrier n}} (\fun (y: TargetTotal.Carrier n) => TensorGroup.difference y ((tensor).apply n x)) _ _ (tensorLaw x));
