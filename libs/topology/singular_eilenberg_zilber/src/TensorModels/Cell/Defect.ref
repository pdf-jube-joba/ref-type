\import \root.On[A := Simplex.Carrier p, B := Simplex.Carrier q, left := LeftDomain.topology, right := RightDomain.topology] \as Comparison;
\definition value: Model.Carrier (I.Int^::ofNat n) := Signed.Positive[n := n].intro (#apply{Comparison.tensorDefect} n nativeCell);
\module Zero;
\module Degree(k: N.Nat^) {
  \import Native.Map[C := Total.complex, D := Total.complex].At[n := k] \as Linear;
  \import Modules.Hom[V := Total.Carrier k, W := Model.Carrier (I.Int^::ofNat k), source := Total.space k, target := Model.space (I.Int^::ofNat k)].Composition[U := Total.Carrier k, domain := Total.space k] \as Compose;
  \definition map: Modules.Hom[V := Total.Carrier k, W := Model.Carrier (I.Int^::ofNat k), source := Total.space k, target := Model.space (I.Int^::ofNat k)].Map := Compose.compose (Signed.Positive[n := k].forward) (Linear.linear Comparison.tensorDefect);
  \definition zero: #apply{map} #zero{(Total.space k)} = #zero{(Model.space (I.Int^::ofNat k))} := Modules.Hom[V := Total.Carrier k, W := Model.Carrier (I.Int^::ofNat k), source := Total.space k, target := Model.space (I.Int^::ofNat k)].zeroPreserved map;
  \definition boundary(x: Total.Carrier (N.Nat^::succ k)): #apply{(Model.boundary (I.Int^::ofNat (N.Nat^::succ k)))} (Signed.Positive[n := N.Nat^::succ k].intro (#apply{Comparison.tensorDefect} (N.Nat^::succ k) x)) = #apply{map} (#apply{Total.differential} k x) :=
    congr!{{Total.Carrier k} {Model.Carrier (I.Int^::ofNat k)}} (Signed.Positive[n := k].intro) _ _ (#commutes{Comparison.tensorDefect} k x);
}
