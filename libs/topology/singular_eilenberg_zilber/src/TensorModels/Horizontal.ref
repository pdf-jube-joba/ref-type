\import \parent.At[p := p, q := q] \as Source;
\import \parent.At[p := N.Nat^::succ p, q := q] \as Target;
\import Simplex.At[n := p] \as LeftSource;
\import Simplex.At[n := q] \as RightSource;
\import Simplex.At[n := N.Nat^::succ p] \as LeftTarget;
\import Simplex.At[n := q] \as RightTarget;
\import Simplex.Faces[n := p] \as Faces;
\import topology.Maps[A := Simplex.Carrier q, B := Simplex.Carrier q].Identity[] \as Identity;
\import \parent.Mapping[p := p, q := q, r := N.Nat^::succ p, s := q] \as Mapping;
\definition factors: Mapping.Map := Mapping.Map {
  leftFunction := Simplex.face p i, rightFunction := (\fun (x: Simplex.Carrier q) => x),
  leftContinuous := Faces.continuous i, rightContinuous := Identity.continuous RightSource.topology,
};
\import Mapping.With[f := factors] \as Induced;
\module Degree(z: I.Int^) {
  \definition map: Modules.Hom[V := Source.Carrier z, W := Target.Carrier z, source := Source.space z, target := Target.space z].Map := Induced.Degree[z := z].map;
}
\definition commutes: \forall (z: I.Int^)(x: Source.Carrier z) -> #apply{(Target.boundary z)} (#apply{Degree[z := z].map} x) = #apply{Degree[z := Degrees.previous z].map} (#apply{(Source.boundary z)} x) := Induced.commutes;
