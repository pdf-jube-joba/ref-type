\import Simplex.At[n := p] \as LeftDomain;
\import Simplex.At[n := q] \as RightDomain;
\import singular_cohomology.Chains[A := Simplex.Carrier p, source := LeftDomain.topology] \as Left;
\import singular_cohomology.Chains[A := Simplex.Carrier q, source := RightDomain.topology] \as Right;
\import Double.Tensor[C := Left.complex, D := Right.complex] \as Tensor;
\import Double.Total[C := Tensor.complex] \as Total;
\import Native.ZeroExtension[C := Total.complex] \as Signed;
\definition Carrier(z: I.Int^): \Set := Signed.Carrier z;
\definition space(z: I.Int^): Modules.Space (Carrier z) := Signed.space z;
\definition boundary(z: I.Int^): Modules.Hom[V := Carrier z, W := Carrier (Degrees.previous z), source := space z, target := space (Degrees.previous z)].Map := Modules.Hom[V := Carrier z, W := Carrier (Degrees.previous z), source := space z, target := space (Degrees.previous z)].Map { apply := Signed.apply z, addition := Signed.addition z, scalar := Signed.scalar z };
\definition squareZero: \forall (z: I.Int^)(x: Carrier z) -> #apply{(boundary (Degrees.previous z))} (#apply{(boundary z)} x) = #zero{(space (Degrees.previous (Degrees.previous z)))} := Signed.squareZero;
\import singular_cohomology.Simplices[A := Simplex.Carrier p, source := LeftDomain.topology] \as LeftSimplices;
\import singular_cohomology.Simplices[A := Simplex.Carrier q, source := RightDomain.topology] \as RightSimplices;
\import topology.Maps[A := Simplex.Carrier p, B := Simplex.Carrier p].Identity[] \as LeftIdentity;
\import topology.Maps[A := Simplex.Carrier q, B := Simplex.Carrier q].Identity[] \as RightIdentity;
\definition leftSimplex: LeftSimplices.Carrier p := \into[LeftSimplices.At[n := p].Function]((\fun (x: Simplex.Carrier p) => x), LeftSimplices.Carrier p) \by { LeftIdentity.continuous LeftDomain.topology };
\definition rightSimplex: RightSimplices.Carrier q := \into[RightSimplices.At[n := q].Function]((\fun (x: Simplex.Carrier q) => x), RightSimplices.Carrier q) \by { RightIdentity.continuous RightDomain.topology };
\module Contraction;
