\import Native.Map[C := SourceTotal.complex, D := TargetTotal.complex].ZeroExtension[f := native f] \as Extended;
\import Complexes.Map[C := SourceSigned.complex, D := TargetSigned.complex] \as Maps;
\import \parent.\parent.At[p := p, q := q] \as Source;
\import \parent.\parent.At[p := r, q := s] \as Target;
\definition signed: Maps.Map := Extended.map;
\module Degree(z: I.Int^) {
  \import Maps.At[k := z] \as Linear;
  \definition map: Modules.Hom[V := Source.Carrier z, W := Target.Carrier z, source := Source.space z, target := Target.space z].Map := Linear.linear signed;
}
\definition commutes: \forall (z: I.Int^)(x: Source.Carrier z) -> #apply{(Target.boundary z)} (#apply{Degree[z := z].map} x) = #apply{Degree[z := Degrees.previous z].map} (#apply{(Source.boundary z)} x) := #commutes{signed};
\module Pure(n: N.Nat^, i: Double.Index n);
\module Defect(n: N.Nat^) {
  \import \root.On[A := Simplex.Carrier p, B := Simplex.Carrier q, left := LeftSource.topology, right := RightSource.topology] \as Initial;
  \import \root.On[A := Simplex.Carrier r, B := Simplex.Carrier s, left := LeftTarget.topology, right := RightTarget.topology] \as Final;
  \import Initial.Naturality[C := Simplex.Carrier r, D := Simplex.Carrier s, leftTarget := LeftTarget.topology, rightTarget := RightTarget.topology].With[f := factors f].Composites[n := n] \as Natural;
  \definition law(x: SourceTotal.Carrier n): #apply{(native f)} n (#apply{Initial.tensorDefect} n x) = #apply{Final.tensorDefect} n (#apply{(native f)} n x) := Natural.tensorDefectLaw x;
}
