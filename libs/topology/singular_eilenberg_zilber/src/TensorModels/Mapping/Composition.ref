\import \parent.\parent.Mapping[p := r, q := s, r := t, s := u] \as Next;
\import \parent.\parent.Mapping[p := p, q := q, r := t, s := u] \as Result;
\import Simplex.At[n := t] \as LeftFinal;
\import Simplex.At[n := u] \as RightFinal;
\import topology.Composition[A := Simplex.Carrier p, B := Simplex.Carrier r, C := Simplex.Carrier t] \as LeftTopology;
\import topology.Composition[A := Simplex.Carrier q, B := Simplex.Carrier s, C := Simplex.Carrier u] \as RightTopology;
\definition compose[f: Map][g: Next.Map]: Result.Map := Result.Map {
  leftFunction := \fun (x: Simplex.Carrier p) => g.leftFunction (f.leftFunction x),
  rightFunction := \fun (x: Simplex.Carrier q) => g.rightFunction (f.rightFunction x),
  leftContinuous := LeftTopology.composeContinuous LeftSource.topology LeftTarget.topology LeftFinal.topology f.leftFunction g.leftFunction f.leftContinuous g.leftContinuous,
  rightContinuous := RightTopology.composeContinuous RightSource.topology RightTarget.topology RightFinal.topology f.rightFunction g.rightFunction f.rightContinuous g.rightContinuous,
};
\module With(f: Map, g: Next.Map);
