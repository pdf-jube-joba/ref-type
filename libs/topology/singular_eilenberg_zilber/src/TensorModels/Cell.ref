\definition p: N.Nat^ := #first{i};
\definition q: N.Nat^ := #second{i};
\import \parent.At[p := p, q := q] \as Model;
\import Simplex.At[n := p] \as LeftDomain;
\import Simplex.At[n := q] \as RightDomain;
\import singular_cohomology.Chains[A := Simplex.Carrier p, source := LeftDomain.topology] \as Left;
\import singular_cohomology.Chains[A := Simplex.Carrier q, source := RightDomain.topology] \as Right;
\import Double.Tensor[C := Left.complex, D := Right.complex] \as Tensor;
\import Double.Total[C := Tensor.complex] \as Total;
\import Native.ZeroExtension[C := Total.complex] \as Signed;
\definition nativeCell: Total.Carrier n := #apply{Total.Degree[n := n].Component[i := i].injection} (Tensor.Term[p := p, q := q].tensor (Left.generator p Model.leftSimplex) (Right.generator q Model.rightSimplex));
\definition cell: Model.Carrier (I.Int^::ofNat n) := Signed.Positive[n := n].intro nativeCell;
\module Defect;
