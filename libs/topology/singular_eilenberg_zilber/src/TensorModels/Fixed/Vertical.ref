\import \parent.\parent.At[p := p, q := q] \as Source;
\import \parent.\parent.At[p := p, q := N.Nat^::succ q] \as Target;
\import Modules.Hom[V := Source.Carrier z, W := Target.Carrier z, source := Source.space z, target := Target.space z] \as Maps;
\import Maps.Alternating[] \as Sum;
\definition count: N.Nat^ := N.Nat^::succ (N.Nat^::succ q);
\definition faces(i: Fin.Fin count): Maps.Map := \parent.\parent.Vertical[p := p, q := q, i := i].Degree[z := z].map;
\definition map: Maps.Map := Sum.map count faces;
\import Modules.Alternating[V := Target.Carrier z, space := Target.space z] \as Values;
\definition onValues(x: Source.Carrier z): #apply{map} x = Values.sum count (\fun (i: Fin.Fin count) => #apply{(faces i)} x) := Sum.onValues count faces x;
