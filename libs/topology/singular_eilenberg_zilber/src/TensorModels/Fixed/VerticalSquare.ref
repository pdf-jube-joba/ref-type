\import \parent.\parent.At[p := p, q := q] \as Source;
\import \parent.\parent.At[p := p, q := N.Nat^::succ q] \as Middle;
\import \parent.\parent.At[p := p, q := N.Nat^::succ (N.Nat^::succ q)] \as Target;
\import \parent.Vertical[p := p, q := q] \as Low;
\import \parent.Vertical[p := p, q := N.Nat^::succ q] \as High;
\definition count: N.Nat^ := N.Nat^::succ (N.Nat^::succ q);
\definition larger: N.Nat^ := N.Nat^::succ count;
\import Modules.Alternating[V := Target.Carrier z, space := Target.space z] \as Sum;
\import Modules.Alternating[V := Middle.Carrier z, space := Middle.space z].Mapping[W := Target.Carrier z, target := Target.space z] \as Mapping;
\definition terms(x: Source.Carrier z)(i: Fin.Fin larger)(j: Fin.Fin count): Target.Carrier z := #apply{(High.faces i)} (#apply{(Low.faces j)} x);
\definition inner(x: Source.Carrier z)(i: Fin.Fin larger): #apply{(High.faces i)} (#apply{Low.map} x) = Sum.sum count (terms x i) :=
  trans!{{Target.Carrier z}} _ _ _ (congr!{{Middle.Carrier z} {Target.Carrier z}} (#apply{(High.faces i)}) _ _ (Low.onValues x))
    (Mapping.law (High.faces i) count (\fun (j: Fin.Fin count) => #apply{(Low.faces j)} x));
\definition law(x: Source.Carrier z): #apply{High.map} (#apply{Low.map} x) = #zero{(Target.space z)} :=
  trans!{{Target.Carrier z}} _ _ _ (High.onValues (#apply{Low.map} x))
    (trans!{{Target.Carrier z}} _ _ _
      (Sum.congruent larger (\fun (i: Fin.Fin larger) => #apply{(High.faces i)} (#apply{Low.map} x)) (\fun (i: Fin.Fin larger) => Sum.sum count (terms x i)) (inner x))
      (Sum.doubleZero count (terms x) (\fun (i, j: Fin.Fin count)(ordered: N.Basic[].Prop[].Le i j) => \parent.\parent.VerticalInterchange[p := p, q := q, i := i, j := j].law ordered z x)));
