\import Double.AcyclicDiagonal[] \as Acyclic;
\definition family: Acyclic.ModelFamily := Acyclic.ModelFamily {
  Carrier := \fun (n: N.Nat^)(z: I.Int^) => \parent.Level[n := n, z := z].Carrier,
  space := \fun (n: N.Nat^)(z: I.Int^) => \parent.Level[n := n, z := z].space,
};
\definition operators: Acyclic.Operators[family] := Acyclic.Operators[family] {
  boundary := \fun (n: N.Nat^)(z: I.Int^) => \parent.Differential[z := z].Degree[n := n].map,
  transition := \fun (n: N.Nat^)(z: I.Int^) => \parent.Level[n := n, z := z].transition,
};

\definition model: Acyclic.Model := Acyclic.Model {
  family := family, operators := operators,
  laws := Acyclic.ModelLaws[family, operators] {
    boundarySquare := \parent.LadderLaws[].BoundarySquare[].law,
    transitionSquare := \parent.LadderLaws[].Transitions[].transitionSquare,
    commutes := \parent.LadderLaws[].Transitions[].commutes,
  },
};
\module Fillings;
