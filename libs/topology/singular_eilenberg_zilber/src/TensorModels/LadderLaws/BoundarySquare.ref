\module At(n: N.Nat^, z: I.Int^);
\definition law: \forall (n: N.Nat^)(z: I.Int^)(x: \root.TensorModels[].Level[n := n, z := z].Carrier) ->
  #apply{\root.TensorModels[].Differential[z := Degrees.previous z].Degree[n := n].map}
    (#apply{\root.TensorModels[].Differential[z := z].Degree[n := n].map} x) =
    #zero{(\root.TensorModels[].Level[n := n, z := Degrees.previous (Degrees.previous z)].space)} :=
  \fun (n: N.Nat^)(z: I.Int^) => At[n := n, z := z].law;
