\module At(z: I.Int^) {
  \import \root.TensorModels[].Fixed[z := z] \as Fixed;
  \import Diagram.Total[C := Fixed.complex] \as Total;
  \import \root.TensorModels[].Differential[z := z] \as Boundary;
  \import Diagram.Map[C := Fixed.complex, D := \root.TensorModels[].Fixed[z := Degrees.previous z].complex].Total[f := Boundary.map] \as Action;
  \definition transitionSquare: \forall (n: N.Nat^)(x: \root.TensorModels[].Level[n := n, z := z].Carrier) -> #apply{\root.TensorModels[].Level[n := N.Nat^::succ n, z := z].transition} (#apply{\root.TensorModels[].Level[n := n, z := z].transition} x) = #zero{(\root.TensorModels[].Level[n := N.Nat^::succ (N.Nat^::succ n), z := z].space)} := #squareZero{Total.complex.laws};
  \definition commutes(n: N.Nat^)(x: \root.TensorModels[].Level[n := n, z := z].Carrier): #apply{Boundary.Degree[n := N.Nat^::succ n].map} (#apply{\root.TensorModels[].Level[n := n, z := z].transition} x) = #apply{\root.TensorModels[].Level[n := n, z := Degrees.previous z].transition} (#apply{Boundary.Degree[n := n].map} x) := sym!{{\root.TensorModels[].Level[n := N.Nat^::succ n, z := Degrees.previous z].Carrier}} _ _ (#commutes{Action.map} n x);
}
\definition transitionSquare: \forall (n: N.Nat^)(z: I.Int^)(x: \root.TensorModels[].Level[n := n, z := z].Carrier) ->
  #apply{\root.TensorModels[].Level[n := N.Nat^::succ n, z := z].transition}
    (#apply{\root.TensorModels[].Level[n := n, z := z].transition} x) =
    #zero{(\root.TensorModels[].Level[n := N.Nat^::succ (N.Nat^::succ n), z := z].space)} :=
  \fun (n: N.Nat^)(z: I.Int^) => At[z := z].transitionSquare n;
\definition commutes: \forall (n: N.Nat^)(z: I.Int^)(x: \root.TensorModels[].Level[n := n, z := z].Carrier) ->
  #apply{\root.TensorModels[].Differential[z := z].Degree[n := N.Nat^::succ n].map}
    (#apply{\root.TensorModels[].Level[n := n, z := z].transition} x) =
    #apply{\root.TensorModels[].Level[n := n, z := Degrees.previous z].transition}
      (#apply{\root.TensorModels[].Differential[z := z].Degree[n := n].map} x) :=
  \fun (n: N.Nat^)(z: I.Int^) => At[z := z].commutes n;
