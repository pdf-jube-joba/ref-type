\import Double.AcyclicDiagonal[].Of[model := model] \as Recursion;
\definition data: Recursion.PositiveFillings := Recursion.PositiveFillings {
  operator := \fun (n: N.Nat^) => \root.TensorModels[].PositiveFilling[n := n].map,
  boundary := \fun (n: N.Nat^) => \root.TensorModels[].PositiveFilling[n := n].boundary,
};
