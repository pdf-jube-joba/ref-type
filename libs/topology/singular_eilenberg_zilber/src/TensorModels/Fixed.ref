\definition family: Diagram.Family := Diagram.Family {
  Carrier := \fun (p, q: N.Nat^) => \parent.At[p := p, q := q].Carrier z,
  space := \fun (p, q: N.Nat^) => \parent.At[p := p, q := q].space z,
};
\module Horizontal(p, q: N.Nat^);
\module Vertical(p, q: N.Nat^);
\definition differential: Diagram.DifferentialData[family] := Diagram.DifferentialData[family] {
  horizontal := \fun (p, q: N.Nat^) => Horizontal[p := p, q := q].map,
  vertical := \fun (p, q: N.Nat^) => Vertical[p := p, q := q].map,
};
\module HorizontalSquare(p, q: N.Nat^);
\module VerticalSquare(p, q: N.Nat^);
\module Mixed(p, q: N.Nat^);
\definition complex: Diagram.Complex := Diagram.Complex {
  family := family, differential := differential,
  laws := Diagram.DifferentialLaws[family, differential] {
    horizontalZero := \fun (p, q: N.Nat^) => HorizontalSquare[p := p, q := q].law,
    verticalZero := \fun (p, q: N.Nat^) => VerticalSquare[p := p, q := q].law,
    commute := \fun (p, q: N.Nat^) => Mixed[p := p, q := q].law,
  },
};
