\definition z: I.Int^ := I.Int^::ofNat n;
\import \parent.\parent.Level[n := n, z := z] \as Lower;
\import \parent.\parent.Level[n := N.Nat^::succ n, z := z] \as Target;
\import \parent.\parent.Level[n := N.Nat^::succ n, z := Degrees.next z] \as Upper;
\import \parent.Degree[n := n] \as LowerCells;
\import \parent.Degree[n := N.Nat^::succ n] \as UpperCells;
\import \parent.\parent.Differential[z := Degrees.next z].Degree[n := N.Nat^::succ n] \as Differential;
\import \parent.\parent.Fixed[z := z] \as Fixed;
\import Diagram.Total[C := Fixed.complex] \as CoTotal;
\import CoTotal.Step[n := n] \as CoBoundary;
\import Diagram.Coordinates[C := Fixed.complex] \as Coordinates;
\module At(i: Double.Index (N.Nat^::succ n));
\module Horizontal;
\module Vertical;
\module Equation(i: Double.Index (N.Nat^::succ n));
\definition law: (Differential.map).apply UpperCells.value = (Lower.transition).apply LowerCells.value :=
  Target.Coordinates[].ext _ _ (\fun (i: Double.Index (N.Nat^::succ n)) => Equation[i := i].law);
