\import \parent.At[i := i] \as Current;
\import \root.TensorModels[].At[p := #first{i}, q := #second{i}] \as Model;
\definition law: Target.Coordinates[].coordinate i (#apply{Differential.map} UpperCells.value) = Target.Coordinates[].coordinate i (#apply{Lower.transition} LowerCells.value) :=
  trans!{{Model.Carrier z}} _ _ _ Current.left
    (trans!{{Model.Carrier z}} _ _ _ (congr2!{{Model.Carrier z} {Model.Carrier z} {Model.Carrier z}} (#add{(Model.space z)}) _ _ _ _ (\parent.Horizontal[].law i) (\parent.Vertical[].law i))
      (sym!{{Model.Carrier z}} _ _ Current.right));
