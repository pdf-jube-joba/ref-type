\import \root.TensorModels[].HorizontalCellBoundary[n := n, p := p, q := q] \as ModelBoundary;
\definition i: Double.Index (N.Nat^::succ n) := ModelBoundary.upperIndex;
\import \parent.\parent.At[i := i] \as Current;
\import Coordinates.Step[n := n, i := ModelBoundary.lowerIndex].Horizontal[] \as CoordinateBoundary;
\import \root.TensorModels[].Fixed[z := z].Horizontal[p := p, q := q] \as Faces;
\definition law: Point i :=
  trans!{{\root.TensorModels[].At[p := #first{i}, q := #second{i}].Carrier z}} _ _ _ ModelBoundary.boundary
    (sym!{{\root.TensorModels[].At[p := #first{i}, q := #second{i}].Carrier z}} _ _
      (trans!{{\root.TensorModels[].At[p := #first{i}, q := #second{i}].Carrier z}} _ _ _ (CoordinateBoundary.law LowerCells.value)
        (congr!{{\root.TensorModels[].At[p := p, q := q].Carrier z} {\root.TensorModels[].At[p := #first{i}, q := #second{i}].Carrier z}} (#apply{CoordinateBoundary.original}) _ _ (LowerCells.coordinate ModelBoundary.lowerIndex))));
