\definition Point[i: Double.Index (N.Nat^::succ n)]: \Prop := \parent.At[i := i].vertical = \parent.At[i := i].verticalCoordinate;
\definition Property[q: N.Nat^]: \Prop := \forall (p: Double.First (N.Nat^::succ n) q) -> Point (Double.reverseIndex (N.Nat^::succ n) q p);
\module Zero(p: Double.First (N.Nat^::succ n) N.Nat^::zero) {
  \definition i: Double.Index (N.Nat^::succ n) := Double.reverseIndex (N.Nat^::succ n) N.Nat^::zero p;
  \import \parent.\parent.At[i := i] \as Current;
  \import \root.TensorModels[].Cell[n := N.Nat^::succ n, i := i].Defect[].Degree[k := n] \as Projection;
  \import Coordinates.Axis[n := n, j := i] \as Axis;
  \definition law: Point i := trans!{{\root.TensorModels[].At[p := (i).first, q := (i).second].Carrier z}} _ _ _ Projection.zero
    (sym!{{\root.TensorModels[].At[p := (i).first, q := (i).second].Carrier z}} _ _ (Axis.verticalZero (\refl(N.Nat^::zero)) LowerCells.value));
}
\module Positive(q: N.Nat^, p: Double.First (N.Nat^::succ n) (N.Nat^::succ q));
\definition successor[q: N.Nat^]: Property (N.Nat^::succ q) := \fun (p: Double.First (N.Nat^::succ n) (N.Nat^::succ q)) => Positive[q := q, p := p].law;
\definition holds: \forall (q: N.Nat^) -> Property q := \induction (q: N.Nat^) \return Property q \with {
  | zero: \fun (p: Double.First (N.Nat^::succ n) N.Nat^::zero) => Zero[p := p].law
  | succ: \fun (q: N.Nat^)(previous: Property q) => successor q
};
\definition lower[i: Double.Index (N.Nat^::succ n)]: Double.First (N.Nat^::succ n) (i).second :=
  \into[N.Nat^]((i).first, { p: N.Nat^ \where Nat.add p (i).second = N.Nat^::succ n }) \by { Double.degree (N.Nat^::succ n) i };
\definition law[i: Double.Index (N.Nat^::succ n)]: Point i :=
  \idelim Double.reverseIndex (N.Nat^::succ n) (i).second (lower i) = i \with j: Double.Index (N.Nat^::succ n) => Point j \by {
    base: holds (i).second (lower i), equality: Double.pairRebuild i
  };
