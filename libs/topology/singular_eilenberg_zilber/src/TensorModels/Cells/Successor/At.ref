\definition p: N.Nat^ := (i).first;
\definition q: N.Nat^ := (i).second;
\import \parent.\parent.\parent.At[p := p, q := q] \as Model;
\import \parent.\parent.\parent.Cell[n := N.Nat^::succ n, i := i] \as Cell;
\import Cell.Defect[].Degree[k := n] \as Projection;
\import Simplex.At[n := p] \as LeftDomain;
\import Simplex.At[n := q] \as RightDomain;
\import singular_cohomology.Chains[A := Simplex.Carrier p, source := LeftDomain.topology] \as Left;
\import singular_cohomology.Chains[A := Simplex.Carrier q, source := RightDomain.topology] \as Right;
\import Double.Tensor[C := Left.complex, D := Right.complex] \as Tensor;
\import Double.Total[C := Tensor.complex] \as Total;
\import Total.Step[n := n] \as NativeBoundary;
\definition pure: Tensor.Term[p := p, q := q].Carrier := Tensor.Term[p := p, q := q].tensor (Left.generator p Model.leftSimplex) (Right.generator q Model.rightSimplex);
\definition horizontal: Model.Carrier z := (Projection.map).apply ((NativeBoundary.horizontal p NativeBoundary.Component[i := i].q).apply pure);
\definition vertical: Model.Carrier z := (Projection.map).apply ((NativeBoundary.vertical q NativeBoundary.Component[i := i].p).apply pure);
\definition horizontalCoordinate: Model.Carrier z := Target.Coordinates[].coordinate i ((CoBoundary.horizontal).apply LowerCells.value);
\definition verticalCoordinate: Model.Carrier z := Target.Coordinates[].coordinate i ((CoBoundary.vertical).apply LowerCells.value);
\import Differential.Coordinates[] \as BoundaryCoordinates;
\definition left: Target.Coordinates[].coordinate i ((Differential.map).apply UpperCells.value) = (Model.space z).add horizontal vertical :=
  trans!{{Model.Carrier z}} _ _ _ (BoundaryCoordinates.law i UpperCells.value)
    (trans!{{Model.Carrier z}} _ _ _ (congr!{{Model.Carrier (Degrees.next z)} {Model.Carrier z}} ((Model.boundary (Degrees.next z)).apply) _ _ (UpperCells.coordinate i))
      (trans!{{Model.Carrier z}} _ _ _ (Projection.boundary Cell.nativeCell)
        (trans!{{Model.Carrier z}} _ _ _ (congr!{{Total.Carrier n} {Model.Carrier z}} ((Projection.map).apply) _ _ (NativeBoundary.onComponent i pure))
          ((Projection.map).addition _ _))));
\definition right: Target.Coordinates[].coordinate i ((Lower.transition).apply LowerCells.value) = (Model.space z).add horizontalCoordinate verticalCoordinate :=
  (Target.Coordinates[].At[i := i].map).addition ((CoBoundary.horizontal).apply LowerCells.value) ((CoBoundary.vertical).apply LowerCells.value);
