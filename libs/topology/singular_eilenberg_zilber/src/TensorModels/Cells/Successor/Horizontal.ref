\definition Point(i: Double.Index (N.Nat^::succ n)): \Prop := \parent.At[i := i].horizontal = \parent.At[i := i].horizontalCoordinate;
\definition Property(p: N.Nat^): \Prop := \forall (q: Double.Second (N.Nat^::succ n) p) -> Point (Double.index (N.Nat^::succ n) p q);
\module Zero(q: Double.Second (N.Nat^::succ n) N.Nat^::zero) {
  \definition i: Double.Index (N.Nat^::succ n) := Double.index (N.Nat^::succ n) N.Nat^::zero q;
  \import \parent.\parent.At[i := i] \as Current;
  \import \root.TensorModels[].Cell[n := N.Nat^::succ n, i := i].Defect[].Degree[k := n] \as Projection;
  \import Coordinates.Axis[n := n, j := i] \as Axis;
  \definition law: Point i := trans!{{\root.TensorModels[].At[p := #first{i}, q := #second{i}].Carrier z}} _ _ _ Projection.zero
    (sym!{{\root.TensorModels[].At[p := #first{i}, q := #second{i}].Carrier z}} _ _ (Axis.horizontalZero (\refl(N.Nat^::zero)) LowerCells.value));
}
\module Positive(p: N.Nat^, q: Double.Second (N.Nat^::succ n) (N.Nat^::succ p));
\definition successor(p: N.Nat^): Property (N.Nat^::succ p) := \fun (q: Double.Second (N.Nat^::succ n) (N.Nat^::succ p)) => Positive[p := p, q := q].law;
\definition holds: \forall (p: N.Nat^) -> Property p := \induction (p: N.Nat^) \return Property p \with {
  | zero: \fun (q: Double.Second (N.Nat^::succ n) N.Nat^::zero) => Zero[q := q].law
  | succ: \fun (p: N.Nat^)(previous: Property p) => successor p
};
\definition lower(i: Double.Index (N.Nat^::succ n)): Double.Second (N.Nat^::succ n) #first{i} :=
  \into[N.Nat^](#second{i}, { q: N.Nat^ \where Nat.add #first{i} q = N.Nat^::succ n }) \by { Double.degree (N.Nat^::succ n) i };
\definition law(i: Double.Index (N.Nat^::succ n)): Point i :=
  \idelim Double.index (N.Nat^::succ n) #first{i} (lower i) = i \with j: Double.Index (N.Nat^::succ n) => Point j \by {
    base: holds #first{i} (lower i), equality: Double.pairRebuild i
  };
