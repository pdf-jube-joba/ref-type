\import \parent.Fixed[z := z] \as Source;
\import \parent.Fixed[z := Degrees.previous z] \as Target;
\import Diagram.Map[C := Source.complex, D := Target.complex] \as Maps;
\definition data: Maps.Data := \fun (p, q: N.Nat^) => \parent.At[p := p, q := q].boundary z;
\module Horizontal(p, q: N.Nat^);
\module Vertical(p, q: N.Nat^);
\definition map: Maps.Map := \into[Maps.Data](data, Maps.Map) \by {
  Maps.Laws[data] {
    horizontal := \fun (p, q: N.Nat^) => Horizontal[p := p, q := q].law,
    vertical := \fun (p, q: N.Nat^) => Vertical[p := p, q := q].law,
  }
};
\import Maps.Total[f := map] \as Induced;
\import Diagram.Total[C := Source.complex] \as SourceTotal;
\import Diagram.Total[C := Target.complex] \as TargetTotal;
\module Degree(n: N.Nat^) {
  \import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring].Map[C := SourceTotal.complex, D := TargetTotal.complex].At[k := n] \as Linear;
  \definition map: Modules.Hom[V := SourceTotal.Degree[n := n].Carrier, W := TargetTotal.Degree[n := n].Carrier, source := SourceTotal.Degree[n := n].space, target := TargetTotal.Degree[n := n].space].Map := Linear.linear Induced.map;
  \module Coordinates;
}
