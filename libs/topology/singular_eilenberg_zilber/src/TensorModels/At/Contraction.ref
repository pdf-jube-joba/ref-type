\import Simplex.Contraction[n := p] \as LeftGeometry;
\import Simplex.Contraction[n := q] \as RightGeometry;
\import Simplex.Vertices[] \as Vertices;
\import singular_cohomology.Calculations[A := Simplex.Carrier p, source := LeftDomain.topology].ReducedContractible[].Native[contraction := LeftGeometry.contraction (Vertices.vertex p (Fin.zero p))] \as LeftContraction;
\import singular_cohomology.Calculations[A := Simplex.Carrier q, source := RightDomain.topology].ReducedContractible[].Native[contraction := RightGeometry.contraction (Vertices.vertex q (Fin.zero q))] \as RightContraction;
\import Double.TensorContraction[C := Left.complex, D := Right.complex].With[p := LeftContraction.projection, q := RightContraction.projection, left := LeftContraction.homotopy, right := RightContraction.homotopy] \as Contract;
\import Native.Map[C := Total.complex, D := Total.complex] \as Maps;
\import Native.Homotopy[C := Total.complex, D := Total.complex] \as Homotopies;
\definition projection: Maps.Map := Contract.projection;
\definition homotopy: Homotopies.Homotopy (Native.End[C := Total.complex].identity) projection := Contract.homotopy;
\module Cases;
\module Positive(n: N.Nat^);
\module Filling(n: N.Nat^);
