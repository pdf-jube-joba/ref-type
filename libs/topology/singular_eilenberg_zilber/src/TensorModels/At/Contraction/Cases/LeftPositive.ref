\definition higher: N.Nat^ := N.Nat^::succ a;
\import Tensor.Term[p := higher, q := b] \as Current;
\import Action.Degree[p := higher, q := b] \as Mapping;
\import Modules.Tensor[V := Left.Carrier higher, W := Right.Carrier b, left := Left.space higher, right := Right.space b].Universal[U := Current.Carrier, target := Current.space] \as Universal;
\definition onTensor(x: Left.Carrier higher)(y: Right.Carrier b): #apply{Mapping.map} (Current.tensor x y) = #zero{Current.space} :=
  trans!{Current.Carrier} _ _ _ (Mapping.onTensor x y)
    (trans!{Current.Carrier} _ _ _ (congr!{{Left.Carrier higher} Current.Carrier} (\fun (z: Left.Carrier higher) => Current.tensor z (#apply{RightContraction.projection} b y)) _ _ (LeftContraction.Positive[n := a].law x))
      (Current.zeroLeft (#apply{RightContraction.projection} b y)));
\definition equality: \parent.Term[a := higher, b := b].map = \parent.Term[a := higher, b := b].zero := Universal.ext _ _ onTensor;
\import Modules.Hom[V := Current.Carrier, W := Current.Carrier, source := Current.space, target := Current.space] \as Linear;
\definition law: Pointwise higher b := \fun (x: Current.Carrier) => congr!{Linear.Map Current.Carrier} (\fun (f: Linear.Map) => #apply{f} x) _ _ equality;
