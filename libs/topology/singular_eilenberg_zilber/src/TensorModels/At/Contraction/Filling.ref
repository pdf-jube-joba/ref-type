\definition degree: N.Nat^ := N.Nat^::succ n;
\definition z: I.Int^ := I.Int^::ofNat degree;
\import Homotopies.ZeroExtension[f := Native.End[C := Total.complex].identity, g := projection, h := homotopy] \as Extended;
\import Native.Map[C := Total.complex, D := Total.complex].ZeroExtension[f := Native.End[C := Total.complex].identity] \as Identity;
\import Native.Map[C := Total.complex, D := Total.complex].ZeroExtension[f := projection] \as Projection;
\import Complexes.At[C := Signed.complex, z := z] \as Cycles;
\import Complexes.Homotopy[C := Signed.complex, D := Signed.complex].At[k := z] \as OnCycles;
\import Modules.Hom[V := Carrier z, W := Carrier (Degrees.next z), source := space z, target := space (Degrees.next z)] \as Linear;
\definition map: Linear.Map := Linear.Map { apply := Extended.apply z, addition := Extended.addition z, scalar := Extended.scalar z };
\import Modules.Laws[V := Carrier z, space := space z] \as Values;
\import algebra.Group[].Of[Carrier := Carrier z, group := Values.additive] \as Group;
\definition projectedZero(x: Carrier z): #apply{Projection.map} z x = #zero{(space z)} :=
  congr!{{Total.Carrier degree} {Carrier z}} (Signed.Positive[n := degree].intro) _ _ (\parent.Positive[n := n].law x);
\definition boundary(x: Cycles.Cycle): #apply{Cycles.prior} (#apply{map} x) = x :=
  trans!{{Carrier z}} _ _ _ (sym!{{Carrier z}} _ _ (OnCycles.onCycle Identity.map Projection.map Extended.homotopy x))
    (trans!{{Carrier z}} _ _ _ (congr!{{Carrier z} {Carrier z}} (Group.difference x) _ _ (projectedZero x))
      (trans!{{Carrier z}} _ _ _ (congr!{{Carrier z} {Carrier z}} (Values.add x) _ _ Group.negZero) (Group.zeroRight x)));
\import \root.TensorModels[].At[p := p, q := q] \as Model;
\import std.Logic[].Equality[].Transport[A := I.Int^] \as Transport;
\definition boundaryClosed(x: Carrier z)(closed: #apply{(Model.boundary z)} x = #zero{(space (Degrees.previous z))}): #apply{(Model.boundary (Degrees.next z))} (#apply{map} x) = x :=
  trans!{{Carrier z}} _ _ _
    (sym!{{Carrier z}} _ _ (Transport.castRefl Signed.Carrier z (#apply{(Model.boundary (Degrees.next z))} (#apply{map} x))))
    (boundary (Cycles.cycle x closed));
