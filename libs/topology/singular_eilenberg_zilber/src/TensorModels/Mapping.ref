\import Simplex.At[n := p] \as LeftSource;
\import Simplex.At[n := q] \as RightSource;
\import Simplex.At[n := r] \as LeftTarget;
\import Simplex.At[n := s] \as RightTarget;
\import singular_cohomology.Maps[A := Simplex.Carrier p, B := Simplex.Carrier r, source := LeftSource.topology, target := LeftTarget.topology] \as LeftMaps;
\import singular_cohomology.Maps[A := Simplex.Carrier q, B := Simplex.Carrier s, source := RightSource.topology, target := RightTarget.topology] \as RightMaps;
\structure Map: \Set := {
  leftFunction: Simplex.Carrier p -> Simplex.Carrier r,
  rightFunction: Simplex.Carrier q -> Simplex.Carrier s,
  leftContinuous: LeftMaps.Continuous leftFunction,
  rightContinuous: RightMaps.Continuous rightFunction,
};
\import singular_products.ProductMapping[A := Simplex.Carrier p, B := Simplex.Carrier q, C := Simplex.Carrier r, D := Simplex.Carrier s, leftSource := LeftSource.topology, rightSource := RightSource.topology, leftTarget := LeftTarget.topology, rightTarget := RightTarget.topology] \as ProductMaps;
\definition factors[f: Map]: ProductMaps.Map := ProductMaps.Map { leftFunction := f.leftFunction, rightFunction := f.rightFunction, leftContinuous := f.leftContinuous, rightContinuous := f.rightContinuous };
\import singular_cohomology.Chains[A := Simplex.Carrier p, source := LeftSource.topology] \as InitialLeft;
\import singular_cohomology.Chains[A := Simplex.Carrier q, source := RightSource.topology] \as InitialRight;
\import singular_cohomology.Chains[A := Simplex.Carrier r, source := LeftTarget.topology] \as FinalLeft;
\import singular_cohomology.Chains[A := Simplex.Carrier s, source := RightTarget.topology] \as FinalRight;
\import Double.Tensor[C := InitialLeft.complex, D := InitialRight.complex] \as SourceTensor;
\import Double.Tensor[C := FinalLeft.complex, D := FinalRight.complex] \as TargetTensor;
\import Double.Total[C := SourceTensor.complex] \as SourceTotal;
\import Double.Total[C := TargetTensor.complex] \as TargetTotal;
\import Native.ZeroExtension[C := SourceTotal.complex] \as SourceSigned;
\import Native.ZeroExtension[C := TargetTotal.complex] \as TargetSigned;
\import Native.Map[C := InitialLeft.complex, D := FinalLeft.complex] \as LeftLinear;
\import Native.Map[C := InitialRight.complex, D := FinalRight.complex] \as RightLinear;
\import Native.Map[C := SourceTotal.complex, D := TargetTotal.complex] \as TotalLinear;
\module Tensor(f: LeftLinear.Map, g: RightLinear.Map);
\definition tensor[f: LeftLinear.Map][g: RightLinear.Map]: TotalLinear.Map := Tensor[f := f, g := g].map;
\import Complexes.Map[C := SourceSigned.complex, D := TargetSigned.complex] \as SignedMaps;
\import \parent.At[p := p, q := q] \as SourceModel;
\import \parent.At[p := r, q := s] \as TargetModel;
\definition Arrow: \Set := SignedMaps.Map;
\module Lift(f: TotalLinear.Map);
\definition lift[f: TotalLinear.Map]: SignedMaps.Map := Lift[f := f].map;
\module Action(f: Map);
\definition leftPush[f: Map]: LeftLinear.Map := LeftMaps.push f.leftFunction f.leftContinuous;
\definition rightPush[f: Map]: RightLinear.Map := RightMaps.push f.rightFunction f.rightContinuous;
\definition native[f: Map]: TotalLinear.Map := Action[f := f].native;
\definition arrow[f: Map]: SignedMaps.Map := Action[f := f].arrow;
\definition evaluate[f: SignedMaps.Map][z: I.Int^][x: SourceModel.Carrier z]: TargetModel.Carrier z := (f).apply z x;
\module With(f: Map);
\module Equality(f, g: Map);
\module Composition(t, u: N.Nat^);
