\import \parent.\parent.At[p := p, q := q] \as Lower;
\import \parent.\parent.At[p := p, q := N.Nat^::succ q] \as Higher;
\import Source.Vertical[p := p, q := q] \as Before;
\import Target.Vertical[p := p, q := q] \as After;
\import Modules.Alternating[V := Higher.Carrier (Degrees.previous z), space := Higher.space (Degrees.previous z)] \as Sum;
\import Modules.Alternating[V := Higher.Carrier z, space := Higher.space z].Mapping[W := Higher.Carrier (Degrees.previous z), target := Higher.space (Degrees.previous z)] \as Mapping;
\definition forward[x: Lower.Carrier z]: (Higher.boundary z).apply ((Before.map).apply x) = (After.map).apply ((Lower.boundary z).apply x) :=
  trans!{{Higher.Carrier (Degrees.previous z)}} _ _ _
    (congr!{{Higher.Carrier z} {Higher.Carrier (Degrees.previous z)}} ((Higher.boundary z).apply) _ _ (Before.onValues x))
    (trans!{{Higher.Carrier (Degrees.previous z)}} _ _ _
      (Mapping.law (Higher.boundary z) Before.count (\fun (i: Fin.Fin Before.count) => (Before.faces i).apply x))
      (trans!{{Higher.Carrier (Degrees.previous z)}} _ _ _
        (Sum.congruent Before.count
          (\fun (i: Fin.Fin Before.count) => (Higher.boundary z).apply ((Before.faces i).apply x))
          (\fun (i: Fin.Fin Before.count) => (After.faces i).apply ((Lower.boundary z).apply x))
          (\fun (i: Fin.Fin Before.count) => \parent.\parent.Vertical[p := p, q := q, i := i].commutes z x))
        (sym!{{Higher.Carrier (Degrees.previous z)}} _ _ (After.onValues ((Lower.boundary z).apply x)))));
\definition law[x: Lower.Carrier z]: (After.map).apply ((Lower.boundary z).apply x) = (Higher.boundary z).apply ((Before.map).apply x) := sym!{{Higher.Carrier (Degrees.previous z)}} _ _ (forward x);
