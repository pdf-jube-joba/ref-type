\import \parent.\parent.Horizontal[p := p, q := q, i := i] \as Face;
\import \parent.\parent.Mapping[p := p, q := q, r := N.Nat^::succ p, s := q].With[f := Face.factors] \as Action;
\import Action.Pure[n := n, i := lowerIndex] \as CellAction;
\definition native: #apply{(\parent.\parent.Mapping[p := p, q := q, r := N.Nat^::succ p, s := q].native Face.factors)} n Lower.nativeCell = #apply{Total.Degree[n := n].Component[i := lowerIndex].injection} (Term.tensor (Left.generator p (LeftSimplices.face p i HighModel.leftSimplex)) rightGenerator) := CellAction.onGenerators LowModel.leftSimplex LowModel.rightSimplex;
\definition law: #apply{Face.Degree[z := z].map} Lower.Defect[].value = #apply{leftMap} (Left.generator p (LeftSimplices.face p i HighModel.leftSimplex)) :=
  trans!{{HighModel.Carrier z}} _ _ _
    (congr!{{Total.Carrier n} {HighModel.Carrier z}} (Signed.Positive[n := n].intro) _ _ (Action.Defect[n := n].law Lower.nativeCell))
    (congr!{{Total.Carrier n} {HighModel.Carrier z}} (#apply{projection}) _ _ native);
