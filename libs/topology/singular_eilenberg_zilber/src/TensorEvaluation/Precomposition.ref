\import \parent.At[p := p, q := q] \as SourceEvaluation;
\import \parent.At[p := r, q := s] \as MiddleEvaluation;
\import Simplex.At[n := p] \as SourceLeftDomain;
\import Simplex.At[n := q] \as SourceRightDomain;
\import Simplex.At[n := r] \as MiddleLeftDomain;
\import Simplex.At[n := s] \as MiddleRightDomain;
\import singular_cohomology.Chains[A := Simplex.Carrier p, source := SourceLeftDomain.topology] \as SourceLeft;
\import singular_cohomology.Chains[A := Simplex.Carrier q, source := SourceRightDomain.topology] \as SourceRight;
\import singular_cohomology.Chains[A := Simplex.Carrier r, source := MiddleLeftDomain.topology] \as MiddleLeft;
\import singular_cohomology.Chains[A := Simplex.Carrier s, source := MiddleRightDomain.topology] \as MiddleRight;
\import Double.Tensor[C := SourceLeft.complex, D := SourceRight.complex] \as SourceTensor;
\import Double.Tensor[C := MiddleLeft.complex, D := MiddleRight.complex] \as MiddleTensor;
\import Double.Total[C := SourceTensor.complex] \as SourceTotal;
\import Double.Total[C := MiddleTensor.complex] \as MiddleTotal;
\import \root.TensorModels[].Mapping[p := p, q := q, r := r, s := s] \as ModelMaps;
\import singular_cohomology.Maps[A := Simplex.Carrier p, B := Simplex.Carrier r, source := SourceLeftDomain.topology, target := MiddleLeftDomain.topology] \as LeftMaps;
\import singular_cohomology.Maps[A := Simplex.Carrier q, B := Simplex.Carrier s, source := SourceRightDomain.topology, target := MiddleRightDomain.topology] \as RightMaps;
\import LeftMaps.Composition[C := A, final := left] \as LeftComposition;
\import RightMaps.Composition[C := B, final := right] \as RightComposition;
\import topology.Composition[A := Simplex.Carrier p, B := Simplex.Carrier r, C := A] \as LeftContinuity;
\import topology.Composition[A := Simplex.Carrier q, B := Simplex.Carrier s, C := B] \as RightContinuity;
\import Native.Map[C := MiddleTotal.complex, D := Total.complex].Composition[B := SourceTotal.complex] \as Compose;
\import Native.Map[C := SourceTotal.complex, D := Total.complex] \as Linear;
\module With(f: ModelMaps.Map, sigma: LeftSimplices.Carrier r, tau: RightSimplices.Carrier s);
