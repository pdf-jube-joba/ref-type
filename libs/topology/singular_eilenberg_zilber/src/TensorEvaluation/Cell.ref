\definition p: N.Nat^ := (i).first;
\definition q: N.Nat^ := (i).second;
\import \parent.At[p := p, q := q] \as Evaluation;
\import \root.TensorModels[].At[p := p, q := q] \as Model;
\import \root.TensorModels[].Cell[n := n, i := i] \as Cell;
\import Simplex.At[n := p] \as LeftDomain;
\import Simplex.At[n := q] \as RightDomain;
\import singular_cohomology.Chains[A := Simplex.Carrier p, source := LeftDomain.topology] \as ModelLeft;
\import singular_cohomology.Chains[A := Simplex.Carrier q, source := RightDomain.topology] \as ModelRight;
\import Double.Tensor[C := ModelLeft.complex, D := ModelRight.complex] \as ModelTensor;
\import singular_cohomology.Maps[A := Simplex.Carrier p, B := A, source := LeftDomain.topology, target := left] \as LeftMaps;
\import singular_cohomology.Maps[A := Simplex.Carrier q, B := B, source := RightDomain.topology, target := right] \as RightMaps;
\import Double.Total[C := ModelTensor.complex] \as ModelTotal;
\definition generator[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Total.Carrier n := (Total.Degree[n := n].Component[i := i].injection).apply (Tensor.Term[p := p, q := q].tensor (Left.generator p sigma) (Right.generator q tau));
\module With(sigma: LeftSimplices.Carrier p, tau: RightSimplices.Carrier q);
