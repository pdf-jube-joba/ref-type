\import Simplex.At[n := p] \as LeftDomain;
\import Simplex.At[n := q] \as RightDomain;
\import singular_cohomology.Chains[A := Simplex.Carrier p, source := LeftDomain.topology] \as ModelLeft;
\import singular_cohomology.Chains[A := Simplex.Carrier q, source := RightDomain.topology] \as ModelRight;
\import Double.Tensor[C := ModelLeft.complex, D := ModelRight.complex] \as ModelTensor;
\import Double.Total[C := ModelTensor.complex] \as ModelTotal;
\import singular_cohomology.Maps[A := Simplex.Carrier p, B := A, source := LeftDomain.topology, target := left] \as LeftMaps;
\import singular_cohomology.Maps[A := Simplex.Carrier q, B := B, source := RightDomain.topology, target := right] \as RightMaps;
\import Native.Map[C := ModelLeft.complex, D := Left.complex] \as LeftLinear;
\import Native.Map[C := ModelRight.complex, D := Right.complex] \as RightLinear;
\import Native.Map[C := ModelTotal.complex, D := Total.complex] \as Linear;
\definition tensor[f: LeftLinear.Map][g: RightLinear.Map]: Linear.Map := Double.TensorMapping[C := ModelLeft.complex, D := Left.complex, E := ModelRight.complex, F := Right.complex].With[f := f, g := g].total;
\definition leftPush[sigma: LeftSimplices.Carrier p]: LeftLinear.Map := LeftMaps.push sigma (LeftSimplices.At[n := p].continuous sigma);
\definition rightPush[tau: RightSimplices.Carrier q]: RightLinear.Map := RightMaps.push tau (RightSimplices.At[n := q].continuous tau);
\definition map[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Linear.Map := tensor (leftPush sigma) (rightPush tau);
\definition mapEquality[sigma, rho: LeftSimplices.Carrier p][tau, upsilon: RightSimplices.Carrier q][leftEqual: \forall (x: Simplex.Carrier p) -> sigma x = rho x][rightEqual: \forall (x: Simplex.Carrier q) -> tau x = upsilon x]: map sigma tau = map rho upsilon :=
  congr2!{LeftLinear.Map RightLinear.Map Linear.Map} tensor _ _ _ _
    (LeftMaps.FunctionEquality[].law sigma (LeftSimplices.At[n := p].continuous sigma) rho (LeftSimplices.At[n := p].continuous rho) leftEqual)
    (RightMaps.FunctionEquality[].law tau (RightSimplices.At[n := q].continuous tau) upsilon (RightSimplices.At[n := q].continuous upsilon) rightEqual);
\definition pointwiseEquality[sigma, rho: LeftSimplices.Carrier p][tau, upsilon: RightSimplices.Carrier q][leftEqual: \forall (x: Simplex.Carrier p) -> sigma x = rho x][rightEqual: \forall (x: Simplex.Carrier q) -> tau x = upsilon x][k: N.Nat^][x: ModelTotal.Carrier k]: (map sigma tau).apply k x = (map rho upsilon).apply k x :=
  congr!{Linear.Map {Total.Carrier k}} (\fun (f: Linear.Map) => (f).apply k x) _ _ (mapEquality sigma rho tau upsilon leftEqual rightEqual);
