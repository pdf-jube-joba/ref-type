\definition p: N.Nat^ := (i).first;
\definition q: N.Nat^ := (i).second;
\import Modules.Tensor[V := Left.Carrier p, W := Right.Carrier q, left := Left.space p, right := Right.space q] \as Pure;
\import Modules.Hom[V := Pure.Carrier, W := W, source := Pure.space, target := target] \as TermMaps;
\import Modules.Hom[V := Source.Carrier, W := W, source := Source.space, target := target].Composition[U := Pure.Carrier, domain := Pure.space] \as Compose;
\definition term[f: Maps.Map]: TermMaps.Map := Compose.compose f (Source.Component[i := i].injection);
\definition leftBundle: Modules.Bundle := Modules.Bundle { Carrier := Left.Carrier p, space := Left.space p };
\definition rightBundle: Modules.Bundle := Modules.Bundle { Carrier := Right.Carrier q, space := Right.space q };
\definition pureBundle: Modules.Bundle := Modules.Bundle { Carrier := Pure.Carrier, space := Pure.space };
\definition targetBundle: Modules.Bundle := Modules.Bundle { Carrier := W, space := target };
\import Commutative.Bilinear[A := leftBundle, B := rightBundle, C := pureBundle] \as PureForms;
\import Commutative.Bilinear[A := leftBundle, B := rightBundle, C := targetBundle] \as Forms;
\import PureForms.Postcompose[D := targetBundle] \as After;
\definition pure: PureForms.Map := PureForms.Map { apply := Pure.tensor, addLeft := (Pure.bilinear).addLeft, addRight := (Pure.bilinear).addRight, scaleLeft := (Pure.bilinear).scaleLeft, scaleRight := (Pure.bilinear).scaleRight };
\definition form[f: Maps.Map]: Forms.Map := After.apply pure (term f);
\import Commutative.FreeBilinear[X := LeftSimplices.Carrier p, Y := RightSimplices.Carrier q, C := targetBundle] \as Free;
\definition BilinearAgreement[f, g: Maps.Map]: \Prop := \forall (sigma: LeftSimplices.Carrier p)(tau: RightSimplices.Carrier q) -> (f).apply (generator i sigma tau) = (g).apply (generator i sigma tau);
\definition formsEqual[f, g: Maps.Map][same: BilinearAgreement f g]: form f = form g := Free.ext (form f) (form g) same;
\definition onTensor[f, g: Maps.Map][same: BilinearAgreement f g][x: Left.Carrier p][y: Right.Carrier q]: (term f).apply (Pure.tensor x y) = (term g).apply (Pure.tensor x y) := congr!{Forms.Map W} (\fun (h: Forms.Map) => (h).apply x y) _ _ (formsEqual f g same);
\import Pure.Universal[U := W, target := target] \as Universal;
\definition equation[f, g: Maps.Map][same: BilinearAgreement f g]: term f = term g := Universal.ext (term f) (term g) (onTensor f g same);
