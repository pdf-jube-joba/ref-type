\import Total.Degree[n := n] \as Source;
\import Modules.Hom[V := Source.Carrier, W := W, source := Source.space, target := target] \as Maps;
\definition generator(i: Double.Index n)(sigma: LeftSimplices.Carrier #first{i})(tau: RightSimplices.Carrier #second{i}): Source.Carrier := #apply{Source.Component[i := i].injection} (Tensor.Term[p := #first{i}, q := #second{i}].tensor (Left.generator #first{i} sigma) (Right.generator #second{i} tau));
\definition Agreement(f, g: Maps.Map): \Prop := \forall (i: Double.Index n)(sigma: LeftSimplices.Carrier #first{i})(tau: RightSimplices.Carrier #second{i}) -> #apply{f} (generator i sigma tau) = #apply{g} (generator i sigma tau);
\module At(i: Double.Index n);
\import Modules.DirectSum[Index := Double.Index n, family := Source.family].To[W := W, target := target] \as Universal;
\definition ext(f, g: Maps.Map)(same: Agreement f g): f = g := Universal.ext f g (\fun (i: Double.Index n)(x: Tensor.Term[p := #first{i}, q := #second{i}].Carrier) =>
  congr!{{Modules.Hom[V := Tensor.Term[p := #first{i}, q := #second{i}].Carrier, W := W, source := Tensor.Term[p := #first{i}, q := #second{i}].space, target := target].Map} W} (\fun (h: Modules.Hom[V := Tensor.Term[p := #first{i}, q := #second{i}].Carrier, W := W, source := Tensor.Term[p := #first{i}, q := #second{i}].space, target := target].Map) => #apply{h} x) _ _ (At[i := i].equation f g (same i)));
