\import singular_products.ProductChains[p := n, q := n] \as Geometry;
\definition Points: \Set := Geometry.Carrier;
\definition topology: topology.Topology[Carrier := Points].Topology := Geometry.topology;
\import singular_cohomology.Chains[A := Points, source := topology] \as Chains;
\import Chains.Reduced[] \as Reduced;
\import singular_cohomology.Simplices[A := Points, source := topology] \as Simplices;
\definition Carrier(z: I.Int^): \Set := Reduced.Carrier z;
\definition space(z: I.Int^): Modules.Space (Carrier z) := Reduced.space z;
\definition boundary(z: I.Int^): Modules.Hom[V := Carrier z, W := Carrier (Degrees.previous z), source := space z, target := space (Degrees.previous z)].Map := Reduced.boundary z;
\definition contraction: algebraic_topology.Contraction[A := Points, source := topology].Data := Geometry.Contraction[].contraction;
\import Simplex.At[n := n] \as Domain;
\import topological_constructions.Product[A := Simplex.Carrier n, B := Simplex.Carrier n].Universal[X := Simplex.Carrier n] \as Universal;
\import topology.Maps[A := Simplex.Carrier n, B := Simplex.Carrier n].Identity[] \as Identity;
\import std.Data[].Pair[] \as Pair;
\definition diagonalFunction(x: Simplex.Carrier n): Points := Pair.pair (Simplex.Carrier n) (Simplex.Carrier n) x x;
\definition diagonal: Simplices.Carrier n := \into[Simplices.At[n := n].Function](diagonalFunction, Simplices.Carrier n) \by {
  Universal.pairContinuous Domain.topology Domain.topology Domain.topology (\fun (x: Simplex.Carrier n) => x) (\fun (x: Simplex.Carrier n) => x) (Identity.continuous Domain.topology) (Identity.continuous Domain.topology)
};
\definition cell: Carrier (I.Int^::ofNat n) := Chains.generator n diagonal;
\module Filling(z: I.Int^);
