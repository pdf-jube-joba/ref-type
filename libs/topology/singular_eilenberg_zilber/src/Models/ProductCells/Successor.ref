\import \parent.\parent.At[n := n] \as Lower;
\import \parent.\parent.At[n := N.Nat^::succ n] \as Higher;
\import Simplex.At[n := N.Nat^::succ n] \as Domain;
\import \root.On[A := Simplex.Carrier (N.Nat^::succ n), B := Simplex.Carrier (N.Nat^::succ n), left := Domain.topology, right := Domain.topology] \as Comparison;
\import \parent.\parent.Transition[n := n].Degree[z := I.Int^::ofNat n] \as T;
\definition law: #apply{(Higher.boundary (I.Int^::ofNat (N.Nat^::succ n)))} \parent.Degree[n := N.Nat^::succ n].value = #apply{T.map} \parent.Degree[n := n].value :=
  trans!{{Higher.Carrier (I.Int^::ofNat n)}} _ _ _ (#commutes{Comparison.productDefect} n Higher.cell)
    (trans!{{Higher.Carrier (I.Int^::ofNat n)}} _ _ _
      (congr!{{Higher.Carrier (I.Int^::ofNat n)} {Higher.Carrier (I.Int^::ofNat n)}} (#apply{Comparison.productDefect} n) _ _ (\parent.\parent.DiagonalBoundary[n := n].law))
      (\parent.Transition[n := n].law Lower.cell));
