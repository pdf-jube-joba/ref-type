\import singular_cohomology.Calculations[A := Points, source := topology].ReducedContractible[].Filling[z := z, contraction := contraction] \as Fill;
\import Complexes.At[C := Reduced.complex, z := z] \as H;
\definition map: Modules.Hom[V := Carrier z, W := Carrier (Degrees.next z), source := space z, target := space (Degrees.next z)].Map := Fill.map;
\definition boundary: \forall (x: H.Cycle) -> (H.prior).apply ((map).apply x) = x := Fill.boundary;
