\definition p: N.Nat^ := (i).first;
\definition q: N.Nat^ := (i).second;
\import \parent.At[i := i] \as Current;
\import Higher.Component[i := i].Boundary[] \as Boundary;
\import Modules.Laws[V := Total.Carrier (N.Nat^::succ n), space := Total.space (N.Nat^::succ n)] \as Values;
\import algebra.Group[].Of[Carrier := Total.Carrier (N.Nat^::succ n), group := Values.additive] \as Group;
\definition generator[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Total.Carrier (N.Nat^::succ n) := Evaluation.Cell[n := N.Nat^::succ n, i := i].generator sigma tau;
\definition past[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Total.Carrier (N.Nat^::succ n) := (Lower.map).apply ((Total.differential).apply n (generator sigma tau));
\definition prior[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: Boundary.prior sigma tau = past sigma tau :=
  trans!{{Total.Carrier (N.Nat^::succ n)}} _ _ _ (Current.prior sigma tau)
    (trans!{{Total.Carrier (N.Nat^::succ n)}} _ _ _ (congr2!{{Total.Carrier (N.Nat^::succ n)} {Total.Carrier (N.Nat^::succ n)} {Total.Carrier (N.Nat^::succ n)}} Values.add _ _ _ _
      (sym!{{Total.Carrier (N.Nat^::succ n)}} _ _ (\parent.Horizontal[].law i sigma tau))
      (sym!{{Total.Carrier (N.Nat^::succ n)}} _ _ (\parent.Vertical[].law i sigma tau)))
      (sym!{{Total.Carrier (N.Nat^::succ n)}} _ _ (Current.boundary sigma tau)));
\definition law[sigma: LeftSimplices.Carrier p][tau: RightSimplices.Carrier q]: (boundaryMap).apply (generator sigma tau) = (defectMap).apply (generator sigma tau) :=
  trans!{{Total.Carrier (N.Nat^::succ n)}} _ _ _ (congr!{{Total.Carrier (N.Nat^::succ (N.Nat^::succ n))} {Total.Carrier (N.Nat^::succ n)}} (\fun (x: Total.Carrier (N.Nat^::succ (N.Nat^::succ n))) => Values.add ((Total.differential).apply (N.Nat^::succ n) x) (past sigma tau)) _ _ (Higher.onGenerators i sigma tau))
    (trans!{{Total.Carrier (N.Nat^::succ n)}} _ _ _ (congr!{{Total.Carrier (N.Nat^::succ n)} {Total.Carrier (N.Nat^::succ n)}} (\fun (x: Total.Carrier (N.Nat^::succ n)) => Values.add x (past sigma tau)) _ _ (Boundary.law sigma tau))
      (trans!{{Total.Carrier (N.Nat^::succ n)}} _ _ _ (congr!{{Total.Carrier (N.Nat^::succ n)} {Total.Carrier (N.Nat^::succ n)}} (\fun (x: Total.Carrier (N.Nat^::succ n)) => Values.add (Group.difference ((Comparison.tensorDefect).apply (N.Nat^::succ n) (generator sigma tau)) x) (past sigma tau)) _ _ (prior sigma tau))
        (Group.addDifference ((Comparison.tensorDefect).apply (N.Nat^::succ n) (generator sigma tau)) (past sigma tau))));
