\import Total.Degree[n := n] \as Source;
\import Total.Degree[n := N.Nat^::succ n] \as Target;
\import Modules.DirectSum[Index := Double.Index n, family := Source.family].To[W := Target.Carrier, target := Target.space] \as Extension;
\module Component(i: Double.Index n);
\definition components: Extension.Components := \fun (i: Double.Index n) => Component[i := i].map;
\definition map: Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map := Extension.extension components;
\definition onInjection: \forall (i: Double.Index n)(x: Tensor.Term[p := #first{i}, q := #second{i}].Carrier) -> #apply{map} (#apply{Source.Component[i := i].injection} x) = #apply{Component[i := i].map} x := Extension.onInjection components;
\definition onGenerators(i: Double.Index n)(sigma: LeftSimplices.Carrier #first{i})(tau: RightSimplices.Carrier #second{i}): #apply{map} (Evaluation.Cell[n := n, i := i].generator sigma tau) = Component[i := i].onGenerators sigma tau :=
  trans!{Target.Carrier} _ _ _ (onInjection i (Tensor.Term[p := #first{i}, q := #second{i}].tensor (Left.generator #first{i} sigma) (Right.generator #second{i} tau))) (Component[i := i].generatorLaw sigma tau);
