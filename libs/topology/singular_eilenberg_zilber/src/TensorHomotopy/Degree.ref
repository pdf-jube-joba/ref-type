\import Total.Degree[n := n] \as Source;
\import Total.Degree[n := N.Nat^::succ n] \as Target;
\import Modules.DirectSum[Index := Double.Index n, family := Source.family].To[W := Target.Carrier, target := Target.space] \as Extension;
\module Component(i: Double.Index n);
\definition components: Extension.Components := \fun (i: Double.Index n) => Component[i := i].map;
\definition map: Modules.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map := Extension.extension components;
\definition onInjection: \forall (i: Double.Index n)(x: Tensor.Term[p := (i).first, q := (i).second].Carrier) -> (map).apply ((Source.Component[i := i].injection).apply x) = (Component[i := i].map).apply x := Extension.onInjection components;
\definition onGenerators[i: Double.Index n][sigma: LeftSimplices.Carrier (i).first][tau: RightSimplices.Carrier (i).second]: (map).apply (Evaluation.Cell[n := n, i := i].generator sigma tau) = Component[i := i].onGenerators sigma tau :=
  trans!{Target.Carrier} _ _ _ (onInjection i (Tensor.Term[p := (i).first, q := (i).second].tensor (Left.generator (i).first sigma) (Right.generator (i).second tau))) (Component[i := i].generatorLaw sigma tau);
