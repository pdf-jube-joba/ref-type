\definition n: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ n;
\import \parent.Degree[n := n] \as Current;
\import \root.TensorModels[].Level[n := n, z := I.Int^::ofNat one] \as Level;
\import Modules.Hom[V := Total.Carrier n, W := Total.Carrier one, source := Total.space n, target := Total.space one] \as Maps;
\module At(i: Double.Index n) {
  \import Current.Component[i := i] \as Component;
  \import \root.TensorModels[].At[p := #first{i}, q := #second{i}] \as Model;
  \definition modelZero: Component.modelValue = #zero{(Model.space (I.Int^::ofNat one))} :=
    trans!{{Model.Carrier (I.Int^::ofNat one)}} _ _ _ (congr!{Level.Carrier {Model.Carrier (I.Int^::ofNat one)}} (Level.Coordinates[].coordinate i) _ _ Models.homotopyZero) Level.Coordinates[].At[i := i].zero;
  \import Modules.Hom[V := Model.Carrier (I.Int^::ofNat one), W := Total.Carrier one, source := Model.space (I.Int^::ofNat one), target := Total.space one] \as EvaluationMaps;
  \definition generator(sigma: LeftSimplices.Carrier #first{i})(tau: RightSimplices.Carrier #second{i}): #apply{Current.map} (Evaluation.Cell[n := n, i := i].generator sigma tau) = #zero{(Total.space one)} :=
    trans!{{Total.Carrier one}} _ _ _ (Current.onInjection i (Tensor.Term[p := #first{i}, q := #second{i}].tensor (Left.generator #first{i} sigma) (Right.generator #second{i} tau)))
      (trans!{{Total.Carrier one}} _ _ _ (Component.generatorLaw sigma tau)
        (trans!{{Total.Carrier one}} _ _ _ (congr!{{Model.Carrier (I.Int^::ofNat one)} {Total.Carrier one}} (#apply{(Component.evaluationLinear one sigma tau)}) _ _ modelZero)
          (EvaluationMaps.zeroPreserved (Component.evaluationLinear one sigma tau))));
}
\import \root.TensorGenerators[A := A, B := B, left := left, right := right].To[n := n, W := Total.Carrier one, target := Total.space one] \as Generators;
\definition equation: Current.map = Maps.zeroMap := Generators.ext Current.map Maps.zeroMap (\fun (i: Double.Index n) => At[i := i].generator);
\definition zero(x: Total.Carrier n): #apply{Current.map} x = #zero{(Total.space one)} := congr!{Maps.Map {Total.Carrier one}} (\fun (h: Maps.Map) => #apply{h} x) _ _ equation;
\import Modules.Hom[V := Total.Carrier one, W := Total.Carrier n, source := Total.space one, target := Total.space n] \as BoundaryMaps;
\definition law(x: Total.Carrier n): #apply{Comparison.tensorDefect} n x = #apply{Total.differential} n (#apply{Current.map} x) :=
  trans!{{Total.Carrier n}} _ _ _ (Comparison.Zero[].Tensor[].defect x)
    (sym!{{Total.Carrier n}} _ _ (trans!{{Total.Carrier n}} _ _ _ (congr!{{Total.Carrier one} {Total.Carrier n}} (#apply{Total.differential} n) _ _ (zero x)) (BoundaryMaps.zeroPreserved (Total.Step[n := n].differential))));
