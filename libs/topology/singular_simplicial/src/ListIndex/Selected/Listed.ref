\import \root.ListIndex[A := A] \as Indices;
\definition rank: N.Nat^ := Lists.length A xs;
\definition laws: Enumerations.DistinctEnumerationLaws[S, xs] := \bysub(Lists.List[A], Enumerations.DistinctEnumeration[S], xs);
\definition enumerate(i: Fin.Fin rank): Carrier := \into[A](FromList.tuple xs i, S) \by {
  #included{#enumerates{laws}} (FromList.tuple xs i) (Indices.member xs i)
};
\definition injective: \forall (i, j: Fin.Fin rank) -> enumerate i = enumerate j -> i = j := Indices.injective xs #distinct{laws};
\definition Values(x: Carrier): \Set := \Cast[Fin.Fin rank] ({ i: Fin.Fin rank \where enumerate i = x });
\definition existsIndex: \forall (x: Carrier) -> \exists Values x :=
  \fun (x: Carrier) => Indices.occurrenceIndex x xs (#exhaustive{#enumerates{laws}} x (\bysub(A, S, x)));
\definition uniqueIndex: \forall (x: Carrier)(i, j: Values x) -> i = j :=
  \fun (x: Carrier)(i, j: Values x) => injective i j
    (trans!{A} _ _ _ (\bysub(Fin.Fin rank, Values x, i)) (sym!{A} _ _ (\bysub(Fin.Fin rank, Values x, j))));
\definition index(x: Carrier): Values x := \choice Values x \by { existence: existsIndex x, uniqueness: uniqueIndex x };
\definition indexEnumerate: \forall (i: Fin.Fin rank) -> index (enumerate i) = i :=
  \fun (i: Fin.Fin rank) => injective (index (enumerate i)) i (\bysub(Fin.Fin rank, Values (enumerate i), index (enumerate i)));
\definition enumerateIndex: \forall (x: Carrier) -> enumerate (index x) = x :=
  \fun (x: Carrier) => \bysub(Fin.Fin rank, Values x, index x);
