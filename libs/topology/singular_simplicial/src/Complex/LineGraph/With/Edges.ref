
\definition zero: N.Nat^ := N.Nat^::zero;
\definition degree: N.Nat^ := N.Nat^::succ zero;
\definition head: Fin.Fin (N.Nat^::succ degree) := Fin.zero degree;
\definition tail: Fin.Fin (N.Nat^::succ degree) := Fin.succ degree (Fin.zero zero);
\definition tuple(e: E): Simplicial.Tuple degree := Tuples.extend degree (label (first e)) (\fun (_: Fin.Fin degree) => label (last e));
\definition firstValue(e: E): tuple e head = label (first e) := Tuples.atZero degree (label (first e)) _;
\definition lastValue(e: E): tuple e tail = label (last e) := Tuples.atSuccessor degree (label (first e)) _ (Fin.zero zero);
\definition tupleMember(e: E): \forall (i: Fin.Fin (N.Nat^::succ degree)) -> \In[Vertex] (pair e) (tuple e i) :=
  Fin.cases degree (\fun (i: Fin.Fin (N.Nat^::succ degree)) => \In[Vertex] (pair e) (tuple e i))
    (Logic.Or[_, _]::left (sym!{{Vertex}} _ _ (firstValue e)))
    (\fun (i: Fin.Fin degree) => Logic.Or[_, _]::right (sym!{{Vertex}} _ _ (Tuples.atSuccessor degree (label (first e)) (\fun (_: Fin.Fin degree) => label (last e)) i)));
\definition simplex(e: E): Simplicial.Simplex degree := \into[Simplicial.Tuple degree](tuple e, Simplicial.Simplex degree) \by {
  Simplicial.Admissible[degree, tuple e] {
    increasing := \root.Prepending[k := degree, n := N.Nat^::succ d].With[a := label (first e), tail := \fun (_: Fin.Fin degree) => label (last e)]
      .increasing (singleIncreasing (label (last e))) (\fun (_: Fin.Fin degree) => #ordered{laws} e),
    face := Logic.Or[_, _]::right (\exact(Segment[Simplicial.Image degree (tuple e)] {
      edge := e,
      included := \block {
        \fun (a: Vertex)(member: \In[Vertex] (Simplicial.Image degree (tuple e)) a) \then
        \takefrom i: \Cast[Fin.Fin (N.Nat^::succ degree)] ({ i: Fin.Fin (N.Nat^::succ degree) \where tuple e i = a }) \by member \then
        \return \idelim tuple e i = a \with b: Vertex => \In[Vertex] (pair e) b \by {
          base: tupleMember e i, equality: \bysub(Fin.Fin (N.Nat^::succ degree), { i: Fin.Fin (N.Nat^::succ degree) \where tuple e i = a }, i)
        }
      },
    }, Segment[Simplicial.Image degree (tuple e)])),
  }
};
\definition equal: \forall (e: E)(s: Simplicial.Simplex degree) -> label (first e) = s head -> label (last e) = s tail -> simplex e = s :=
  \fun (e: E)(s: Simplicial.Simplex degree)(atHead: label (first e) = s head)(atTail: label (last e) = s tail) =>
    \axiom:funext(simplex e, s, Fin.cases degree (\fun (i: Fin.Fin (N.Nat^::succ degree)) => tuple e i = s i)
      (trans!{{Vertex}} _ _ _ (firstValue e) atHead)
      (\fun (i: Fin.Fin degree) => trans!{{Vertex}} _ _ _
        (Tuples.atSuccessor degree (label (first e)) (\fun (_: Fin.Fin degree) => label (last e)) i)
        (trans!{{Vertex}} _ _ _ atTail (sym!{{Vertex}} _ _ (congr!{{Fin.Fin degree} {Vertex}}
          (\fun (j: Fin.Fin degree) => s (Fin.succ degree j)) _ _ (Fin.singletonValue i))))));
\definition injective: \forall (e, f: E) -> simplex e = simplex f -> e = f :=
  \fun (e, f: E)(same: simplex e = simplex f) => #edges{laws} e f
    (#vertices{laws} (first e) (first f) (trans!{{Vertex}} _ _ _ (sym!{{Vertex}} _ _ (firstValue e))
      (trans!{{Vertex}} _ _ _ (congr!{{Simplicial.Tuple degree} {Vertex}} (\fun (s: Simplicial.Tuple degree) => s head) _ _ same) (firstValue f))))
    (#vertices{laws} (last e) (last f) (trans!{{Vertex}} _ _ _ (sym!{{Vertex}} _ _ (lastValue e))
      (trans!{{Vertex}} _ _ _ (congr!{{Simplicial.Tuple degree} {Vertex}} (\fun (s: Simplicial.Tuple degree) => s tail) _ _ same) (lastValue f))));
\definition Values(s: Simplicial.Simplex degree): \Set := \Cast[E] ({ e: E \where simplex e = s });
\definition ordered(s: Simplicial.Simplex degree): Bounds.Lt (s head) (s tail) := #increasing{(Simplicial.admissible degree s)} head tail (\refl(B.Bool^::true));
\definition onto: \forall (s: Simplicial.Simplex degree) -> \exists Values s := \fun (s: Simplicial.Simplex degree) =>
  either!{{(#face{(Simplicial.admissible degree s)})} {\exists Values s}
    {\block {
      \fun (found: \exists Singleton[Simplicial.Image degree s]) \then
      \takefrom w: Singleton[Simplicial.Image degree s] \by found \then
      \return Logic.falseElim _ (Bounds.ltNe (s head) (s tail) (ordered s)
        (trans!{{Vertex}} _ _ _ (sym!{{Vertex}} _ _ (#included{w} (s head) (Simplicial.imageMember degree s head)))
          (#included{w} (s tail) (Simplicial.imageMember degree s tail))))
    }}
    {\block {
      \fun (found: \exists Segment[Simplicial.Image degree s]) \then
      \takefrom w: Segment[Simplicial.Image degree s] \by found \then
      \let matched: PairMatch[label (first #edge{w}), label (last #edge{w}), s head, s tail] :=
        \parent.Pair[a := label (first #edge{w}), b := label (last #edge{w}), x := s head, y := s tail].match
          (#ordered{laws} #edge{w}) (ordered s)
          (#included{w} (s head) (Simplicial.imageMember degree s head)) (#included{w} (s tail) (Simplicial.imageMember degree s tail)) \then
      \return Logic.existsIntro[E, { e: E \where simplex e = s }] #edge{w} (equal #edge{w} s #first{matched} #last{matched})
    }}
  };
\definition unique: \forall (s: Simplicial.Simplex degree)(e, f: Values s) -> e = f :=
  \fun (s: Simplicial.Simplex degree)(e, f: Values s) => injective e f
    (trans!{{Simplicial.Tuple degree}} _ _ _ (\bysub(E, Values s, e)) (sym!{{Simplicial.Tuple degree}} _ _ (\bysub(E, Values s, f))));
\definition index(s: Simplicial.Simplex degree): Values s := \choice Values s \by { existence: onto s, uniqueness: unique s };
\definition simplexIndex: \forall (s: Simplicial.Simplex degree) -> simplex (index s) = s := \fun (s: Simplicial.Simplex degree) => \bysub(E, Values s, index s);
\definition indexSimplex: \forall (e: E) -> index (simplex e) = e := \fun (e: E) => injective (index (simplex e)) e (simplexIndex (simplex e));
