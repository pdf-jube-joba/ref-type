\import \parent.Chains[] \as Chains;
\import resolutions.HomComplex[].Over[R := I.Int^, ring := Integers.commutativeRing].On[P := Chains.complex, N := A] \as Native;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\definition Carrier: N.Nat^ -> \Set := Native.Carrier;
\definition space: \forall (n: N.Nat^) -> Modules.Space (Carrier n) := Native.space;
\definition complex: Complexes.Complex := Native.complex;
\definition differential: \forall (n: N.Nat^) -> Carrier n -> Carrier (N.Nat^::succ n) := Native.apply;
\module Degree(L: \Set, n: N.Nat^);
\module Zero;
\module One;
\module Higher(n: N.Nat^);
\module Differential;
