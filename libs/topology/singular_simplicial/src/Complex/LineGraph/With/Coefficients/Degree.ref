\import Modules.Free[Generators := L] \as Free;
\import Modules.Functions[X := L, V := A.Carrier, target := A.space] \as Functions;
\definition Coordinates: \Set := Functions.Carrier;
\definition coordinateSpace: Modules.Space Coordinates := Functions.space;
\import Modules.Isomorphism[V := Free.Carrier, W := Chains.Carrier n, source := Free.space, target := Chains.space n] \as Terms;
\definition Basis: \Set := Terms.Isomorphism;
\module With(basis: Basis);
