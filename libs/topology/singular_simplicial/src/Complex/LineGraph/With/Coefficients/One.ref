\definition degree: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import \parent.Degree[L := E, n := degree] \as Degree;
\import Degree.With[basis := Chains.One[].isomorphism] \as Compared;
\definition Coordinates: \Set := E -> A.Carrier;
\definition coordinateSpace: Modules.Space Coordinates := Degree.coordinateSpace;
\definition isomorphism: Modules.Isomorphism[V := Carrier degree, W := Coordinates, source := space degree, target := coordinateSpace].Isomorphism := Compared.isomorphism;
\definition forward: Modules.Hom[V := Carrier degree, W := Coordinates, source := space degree, target := coordinateSpace].Map := #forward{isomorphism};
\definition backward: Modules.Hom[V := Coordinates, W := Carrier degree, source := coordinateSpace, target := space degree].Map := #backward{isomorphism};
\definition onEdge: \forall (f: Carrier degree)(e: E) -> #apply{forward} f e = #apply{f} (#apply{Chains.One[].forward} (Chains.edgeGenerator e)) :=
  \fun (f: Carrier degree)(e: E) => \refl(#apply{f} (#apply{Chains.One[].forward} (Chains.edgeGenerator e)));
