\definition zero: N.Nat^ := N.Nat^::zero;
\import \parent.Zero[] \as Zero;
\import \parent.One[] \as One;
\import Modules.Laws[V := A.Carrier, space := A.space] \as Values;
\import algebra.Group[].Of[Carrier := A.Carrier, group := Values.additive] \as Group;
\import Modules.Hom[V := Chains.vertexCarrier, W := A.Carrier, source := Chains.vertexSpace, target := A.space] \as Maps;
\import Modules.Hom[V := Chains.Carrier zero, W := A.Carrier, source := Chains.space zero, target := A.space]
  .Composition[U := Chains.vertexCarrier, domain := Chains.vertexSpace] \as Compose;
\definition law: \forall (f: Carrier zero)(e: E) -> #apply{One.forward} (differential zero f) e =
  Group.difference (#apply{Zero.forward} f (last e)) (#apply{Zero.forward} f (first e)) :=
  \fun (f: Carrier zero)(e: E) => trans!{{A.Carrier}} _ _ _
    (congr!{{Chains.Carrier zero} {A.Carrier}} (#apply{f}) _ _ (Chains.Boundary[].onGenerator e))
    (trans!{{A.Carrier}} _ _ _
      (congr!{{Chains.vertexCarrier} {A.Carrier}} (\fun (x: Chains.vertexCarrier) => #apply{f} (#apply{Chains.Zero[].forward} x)) _ _ (Chains.incidenceOnGenerator e))
      (Maps.differencePreserved (Compose.compose f Chains.Zero[].forward) (Chains.vertexGenerator (last e)) (Chains.vertexGenerator (first e))));
