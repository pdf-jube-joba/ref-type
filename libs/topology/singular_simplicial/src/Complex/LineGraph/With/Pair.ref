\definition match: Bounds.Lt a b -> Bounds.Lt x y -> Logic.Or[a = x, b = x] -> Logic.Or[a = y, b = y] -> PairMatch[a, b, x, y] :=
  \fun (ab: Bounds.Lt a b)(xy: Bounds.Lt x y)(inX: Logic.Or[a = x, b = x])(inY: Logic.Or[a = y, b = y]) =>
    either!{inX {PairMatch[a, b, x, y]}
      {\fun (ax: a = x) => either!{inY {PairMatch[a, b, x, y]}
        {\fun (ay: a = y) => Logic.falseElim _ (Bounds.ltNe x y xy (trans!{{Vertex}} _ _ _ (sym!{{Vertex}} _ _ ax) ay))}
        {\fun (by: b = y) => PairMatch[a, b, x, y] { first := ax, last := by }}}}
      {\fun (bx: b = x) => either!{inY {PairMatch[a, b, x, y]}
        {\fun (ay: a = y) => Logic.falseElim _ (Bounds.ltIrrefl a (Order.ltTrans a b a ab (Indices.replaceLess b a x y bx ay xy)))}
        {\fun (by: b = y) => Logic.falseElim _ (Bounds.ltNe x y xy (trans!{{Vertex}} _ _ _ (sym!{{Vertex}} _ _ bx) by))}}}
    };
