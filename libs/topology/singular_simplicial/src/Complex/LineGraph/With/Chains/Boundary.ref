
\definition zero: N.Nat^ := N.Nat^::zero;
\definition one: N.Nat^ := N.Nat^::succ zero;
\import \parent.\parent.Vertices[] \as VertexSimplices;
\import \parent.\parent.Edges[] \as EdgeSimplices;
\import \parent.Zero[] \as Zero;
\import \parent.One[] \as One;
\import Simplicial.Faces[] \as Faces;
\import Fin.Tuples[A := Vertex].Omission[] \as Omission;
\definition firstValue(e: E): Faces.apply zero EdgeSimplices.head (EdgeSimplices.simplex e) (Fin.zero zero) = label (last e) :=
  trans!{{Vertex}} _ _ _
    (congr!{{Simplicial.Tuple zero} {Vertex}} (\fun (s: Simplicial.Tuple zero) => s (Fin.zero zero)) _ _
      (Faces.At[n := zero].omission EdgeSimplices.head (EdgeSimplices.simplex e)))
    (trans!{{Vertex}} _ _ _
      (congr!{{Simplicial.Tuple zero} {Vertex}} (\fun (s: Simplicial.Tuple zero) => s (Fin.zero zero)) _ _ (Omission.first zero (EdgeSimplices.simplex e)))
      (EdgeSimplices.lastValue e));
\definition lastValue(e: E): Faces.apply zero EdgeSimplices.tail (EdgeSimplices.simplex e) (Fin.zero zero) = label (first e) :=
  trans!{{Vertex}} _ _ _
    (congr!{{Simplicial.Tuple zero} {Vertex}} (\fun (s: Simplicial.Tuple zero) => s (Fin.zero zero)) _ _
      (Faces.At[n := zero].omission EdgeSimplices.tail (EdgeSimplices.simplex e)))
    (trans!{{Vertex}} _ _ _
      (congr!{{Simplicial.Tuple zero} {Vertex}} (\fun (s: Simplicial.Tuple zero) => s (Fin.zero zero)) _ _
        (Omission.successor zero (Fin.zero zero) (EdgeSimplices.simplex e)))
      (trans!{{Vertex}} _ _ _ (Tuples.atZero zero (EdgeSimplices.simplex e EdgeSimplices.head) _)
        (EdgeSimplices.firstValue e)));
\definition firstFace(e: E): Faces.apply zero EdgeSimplices.head (EdgeSimplices.simplex e) = VertexSimplices.simplex (last e) :=
  sym!{{Simplicial.Tuple zero}} _ _ (VertexSimplices.equal (last e) (Faces.apply zero EdgeSimplices.head (EdgeSimplices.simplex e)) (sym!{{Vertex}} _ _ (firstValue e)));
\definition lastFace(e: E): Faces.apply zero EdgeSimplices.tail (EdgeSimplices.simplex e) = VertexSimplices.simplex (first e) :=
  sym!{{Simplicial.Tuple zero}} _ _ (VertexSimplices.equal (first e) (Faces.apply zero EdgeSimplices.tail (EdgeSimplices.simplex e)) (sym!{{Vertex}} _ _ (lastValue e)));
\import Modules.Laws[V := Native.Carrier zero, space := Native.space zero] \as Values;
\import algebra.Group[].Of[Carrier := Native.Carrier zero, group := Values.additive] \as Group;
\import singular_cohomology.SimplicialChains[].On[X := Simplicial.object].Boundary[n := zero] \as Formula;
\definition differenceZero(y: Native.Carrier zero): Group.difference y #zero{(Native.space zero)} = y :=
  trans!{{Native.Carrier zero}} _ _ _ (congr!{{Native.Carrier zero} {Native.Carrier zero}} (Values.add y) _ _ Group.negZero) (Group.zeroRight y);
\definition onSimplex(e: E): #apply{(Native.boundary zero)} (Native.generator one (EdgeSimplices.simplex e)) =
  Group.difference (Native.generator zero (VertexSimplices.simplex (last e))) (Native.generator zero (VertexSimplices.simplex (first e))) :=
  trans!{{Native.Carrier zero}} _ _ _ (Formula.onGenerator (EdgeSimplices.simplex e))
    (trans!{{Native.Carrier zero}} _ _ _
      (congr!{{Native.Carrier zero} {Native.Carrier zero}}
        (Group.difference (Native.generator zero (Faces.apply zero EdgeSimplices.head (EdgeSimplices.simplex e)))) _ _
        (differenceZero (Native.generator zero (Faces.apply zero EdgeSimplices.tail (EdgeSimplices.simplex e)))))
      (congr2!{{Native.Carrier zero} {Native.Carrier zero} {Native.Carrier zero}} Group.difference _ _ _ _
        (congr!{{Simplicial.Simplex zero} {Native.Carrier zero}} (Native.generator zero) _ _ (firstFace e))
        (congr!{{Simplicial.Simplex zero} {Native.Carrier zero}} (Native.generator zero) _ _ (lastFace e))));
\import Modules.Hom[V := vertexCarrier, W := Native.Carrier zero, source := vertexSpace, target := Native.space zero] \as VertexMaps;
\definition vertexValue(e: E): #apply{Zero.forward} (incidenceValues e) =
  Group.difference (Native.generator zero (VertexSimplices.simplex (last e))) (Native.generator zero (VertexSimplices.simplex (first e))) :=
  trans!{{Native.Carrier zero}} _ _ _ (VertexMaps.differencePreserved Zero.forward (vertexGenerator (last e)) (vertexGenerator (first e)))
    (congr2!{{Native.Carrier zero} {Native.Carrier zero} {Native.Carrier zero}} Group.difference _ _ _ _ (Zero.onGenerator (last e)) (Zero.onGenerator (first e)));
\definition onGenerator(e: E): #apply{(Native.boundary zero)} (#apply{One.forward} (edgeGenerator e)) = #apply{Zero.forward} (#apply{incidence} (edgeGenerator e)) :=
  trans!{{Native.Carrier zero}} _ _ _
    (congr!{{Native.Carrier one} {Native.Carrier zero}} (#apply{(Native.boundary zero)}) _ _ (One.onGenerator e))
    (trans!{{Native.Carrier zero}} _ _ _ (onSimplex e)
      (trans!{{Native.Carrier zero}} _ _ _ (sym!{{Native.Carrier zero}} _ _ (vertexValue e))
        (congr!{{vertexCarrier} {Native.Carrier zero}} (#apply{Zero.forward}) _ _ (sym!{{vertexCarrier}} _ _ (incidenceOnGenerator e)))));
\import Modules.Hom[V := Native.Carrier one, W := Native.Carrier zero, source := Native.space one, target := Native.space zero]
  .Composition[U := edgeCarrier, domain := edgeSpace] \as First;
\import VertexMaps.Composition[U := edgeCarrier, domain := edgeSpace] \as Second;
\import EdgeFree.To[W := Native.Carrier zero, target := Native.space zero] \as Free;
\import Modules.Hom[V := edgeCarrier, W := Native.Carrier zero, source := edgeSpace, target := Native.space zero] \as Maps;
\definition equality: First.compose (Native.boundary zero) One.forward = Second.compose Zero.forward incidence := Free.ext _ _ onGenerator;
\definition law: \forall (x: edgeCarrier) -> #apply{(Native.boundary zero)} (#apply{One.forward} x) = #apply{Zero.forward} (#apply{incidence} x) :=
  \fun (x: edgeCarrier) => congr!{{Maps.Map} {Native.Carrier zero}} (\fun (f: Maps.Map) => #apply{f} x) _ _ equality;
