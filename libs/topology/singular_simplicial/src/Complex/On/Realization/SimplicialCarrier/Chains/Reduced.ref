\import Local.Reduced[] \as Source;
\import Whole.Reduced[] \as Target;
\import Inclusion.Reduced[] \as Mapping;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\definition map: Complexes.Map[C := Source.complex, D := Target.complex].Map := Mapping.map inclusion continuous;
\import Modules.Zero[] \as Zero;
\definition injective: \forall (z: I.Int^)(x, y: Source.Carrier z) -> #apply{map} z x = #apply{map} z y -> x = y :=
  \induction (z: I.Int^) \return \forall (x, y: Source.Carrier z) -> #apply{map} z x = #apply{map} z y -> x = y \with {
    | ofNat: \fun (n: N.Nat^)(x, y: Source.Carrier (I.Int^::ofNat n))
        (equal: #apply{map} (I.Int^::ofNat n) x = #apply{map} (I.Int^::ofNat n) y) => \parent.Degree[q := n].injective x y equal
    | negSucc: \induction (n: N.Nat^) \return \forall (x, y: Source.Carrier (I.Int^::negSucc n)) ->
        #apply{map} (I.Int^::negSucc n) x = #apply{map} (I.Int^::negSucc n) y -> x = y \with {
          | zero: \fun (x, y: I.Int^)(equal: x = y) => equal
          | succ: \fun (n: N.Nat^)(unused: _)(x, y: Zero.Carrier)(equal: _) => Zero.unique x y
        }
  };
