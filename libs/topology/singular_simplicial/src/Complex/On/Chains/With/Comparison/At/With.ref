\definition chainForward: #forward{e} = comparison := \bysub(NativeEquivalences.Equivalence,
  { e: NativeEquivalences.Equivalence \where #forward{e} = comparison }, e);
\definition transported: Modules.Isomorphism[V := Target.Cohomology, W := Source.Cohomology, source := Target.cohomologySpace, target := Source.cohomologySpace].Isomorphism :=
  Transport.At[k := n].isomorphism e;
\definition backwardEquality: #backward{transported} = induced :=
  congr!{{Complexes.Map[C := complex, D := Singular.complex].Map}
    {Modules.Hom[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Map}}
    (\fun (f: Complexes.Map[C := complex, D := Singular.complex].Map) => Restriction.induced (Pull.On[f := f, u := End.identity].map))
    #forward{e} comparison chainForward;
\definition backwardPoint: \forall (x: Source.Cohomology) -> #apply{#backward{transported}} x = #apply{induced} x :=
  \fun (x: Source.Cohomology) => congr!{{Modules.Hom[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Map} {Target.Cohomology}}
    (\fun (f: Modules.Hom[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Map) => #apply{f} x) _ _ backwardEquality;
\definition isomorphism: Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Isomorphism :=
  Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology, source := Source.cohomologySpace, target := Target.cohomologySpace].Isomorphism {
    forward := induced,
    backward := #forward{transported},
    leftInverse := \fun (x: Source.Cohomology) => trans!{{Source.Cohomology}} _ _ _
      (congr!{{Target.Cohomology} {Source.Cohomology}} (#apply{#forward{transported}}) _ _ (sym!{{Target.Cohomology}} _ _ (backwardPoint x)))
      (#rightInverse{transported} x),
    rightInverse := \fun (y: Target.Cohomology) => trans!{{Target.Cohomology}} _ _ _
      (sym!{{Target.Cohomology}} _ _ (backwardPoint (#apply{#forward{transported}} y))) (#leftInverse{transported} y),
  };
