\import Modules.Free[Generators := Simplex n].Reindex[TargetGenerators := SingularSimplices.Carrier n] \as Reindex;
\import Reindex.Injection[f := Realization.simplex n] \as Injection;
\import Injection.Retraction[] \as Retraction;
\definition inclusion: Modules.Hom[V := Carrier n, W := Singular.Carrier n, source := space n, target := Singular.space n].Map :=
  Mapping.At[n := n].push Realization.mapping;
\definition injective: \forall (x, y: Carrier n) -> #apply{inclusion} x = #apply{inclusion} y -> x = y :=
  Injection.injective (Realization.simplexInjective n);
\definition retraction: Modules.Hom[V := Singular.Carrier n, W := Carrier n, source := Singular.space n, target := space n].Map :=
  Retraction.retraction (Realization.simplexInjective n);
\import Modules.Hom[V := Carrier n, W := Carrier n, source := space n, target := space n] \as End;
\definition leftInverse: \forall (x: Carrier n) -> #apply{retraction} (#apply{inclusion} x) = x :=
  \fun (x: Carrier n) => congr!{End.Map {Carrier n}}
    (\fun (f: End.Map) => #apply{f} x) _ _
    (Retraction.leftInverse (Realization.simplexInjective n));
