\definition Function: \Set := Fin.Fin (N.Nat^::succ m) -> Fin.Fin (N.Nat^::succ n);
\definition vertices(f: Function)(sigma: Simplex n): Tuple m := \fun (i: Fin.Fin (N.Nat^::succ m)) => sigma (f i);
\definition included: \forall (f: Function)(sigma: Simplex n) -> Included (Image m (vertices f sigma)) (Image n sigma) := \block {
  \fun (f: Function)(sigma: Simplex n)(v: Vertex)(member: \In[Vertex] (Image m (vertices f sigma)) v) \then
  \takefrom i: \Cast[Fin.Fin (N.Nat^::succ m)] ({ i: Fin.Fin (N.Nat^::succ m) \where sigma (f i) = v }) \by member \then
  \return Logic.existsIntro[Fin.Fin (N.Nat^::succ n), { j: Fin.Fin (N.Nat^::succ n) \where sigma j = v }] (f i)
    (\bysub(Fin.Fin (N.Nat^::succ m), { i: Fin.Fin (N.Nat^::succ m) \where sigma (f i) = v }, i))
};
\definition apply(f: Function)(ordered: Ordering.Increasing (N.Nat^::succ m) (N.Nat^::succ n) f)(sigma: Simplex n): Simplex m :=
  \into[Tuple m](vertices f sigma, Simplex m) \by {
    Admissible[m, vertices f sigma] {
      increasing := \fun (i, j: Fin.Fin (N.Nat^::succ m))(less: Bounds.Lt i j) => #increasing{(admissible n sigma)} (f i) (f j) (ordered i j less),
      face := #hereditary{K} (Image n sigma) (Image m (vertices f sigma)) (#face{(admissible n sigma)}) (included f sigma),
    }
  };
