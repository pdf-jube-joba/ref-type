\import Index.Selected[S := simplices].Listed[xs := xs] \as Selected;
\definition length: N.Nat^ := Selected.rank;
\definition enumerate: Fin.Fin length -> Simplex n := Selected.enumerate;
\definition index[sigma: Simplex n]: Fin.Fin length := Selected.index sigma;
\definition data: Data[n] := Data[n] { rank := length, enumerate := enumerate, index := index };
\definition enumeration: Enumeration n := \into[Data[n]](data, Enumeration n) \by {
  Laws[n, data] {
    indexEnumerate := Selected.indexEnumerate,
    enumerateIndex := Selected.enumerateIndex,
  }
};
