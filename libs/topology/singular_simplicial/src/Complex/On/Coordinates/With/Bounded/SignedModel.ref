\import \parent.\parent.Natural[] \as Natural;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].ZeroExtension[C := Natural.complex] \as Extension;
\import Bounded.Of[C := model] \as Model;
\import chain_complexes.Chain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\module Negative(n: N.Nat^) {
  \definition index: I.Int^ := I.Int^::negSucc n;
  \import Modules.Hom[V := Bounded.Carrier model index, W := Extension.Carrier index, source := Bounded.space model index, target := Extension.space index] \as Forward;
  \import Modules.Hom[V := Extension.Carrier index, W := Bounded.Carrier model index, source := Extension.space index, target := Bounded.space model index] \as Backward;
  \definition isomorphism: Modules.Isomorphism[V := Bounded.Carrier model index, W := Extension.Carrier index, source := Bounded.space model index, target := Extension.space index].Isomorphism :=
    Modules.Isomorphism[V := Bounded.Carrier model index, W := Extension.Carrier index, source := Bounded.space model index, target := Extension.space index].Isomorphism {
      forward := Forward.zeroMap, backward := Backward.zeroMap,
      leftInverse := \fun (x: Bounded.Carrier model index) => emptyCoordinates ((Backward.zeroMap).apply ((Forward.zeroMap).apply x)) x,
      rightInverse := \fun (x: Extension.Carrier index) => sym!{{Extension.Carrier index}} _ _ (Extension.Negative[n := n].zero x),
    };
}
\definition degreeIsomorphism: \forall (z: I.Int^) -> Modules.Isomorphism[V := Bounded.Carrier model z, W := Extension.Carrier z, source := Bounded.space model z, target := Extension.space z].Isomorphism :=
  \induction (z: I.Int^) \return Modules.Isomorphism[V := Bounded.Carrier model z, W := Extension.Carrier z, source := Bounded.space model z, target := Extension.space z].Isomorphism \with {
    | ofNat: \fun (n: N.Nat^) => Extension.Positive[n := n].isomorphism
    | negSucc: \fun (n: N.Nat^) => Negative[n := n].isomorphism
  };
\definition forwardCommutes: \forall (z: I.Int^)(x: Bounded.Carrier model z) ->
  Extension.apply z (((degreeIsomorphism z).forward).apply x) = ((degreeIsomorphism (Bounded.previous z)).forward).apply (Bounded.apply model z x) :=
  \induction (z: I.Int^) \return \forall (x: Bounded.Carrier model z) ->
    Extension.apply z (((degreeIsomorphism z).forward).apply x) = ((degreeIsomorphism (Bounded.previous z)).forward).apply (Bounded.apply model z x) \with {
    | ofNat: \induction (n: N.Nat^) \return \forall (x: Bounded.Carrier model (I.Int^::ofNat n)) ->
        Extension.apply (I.Int^::ofNat n) (((degreeIsomorphism (I.Int^::ofNat n)).forward).apply x) =
          ((degreeIsomorphism (Bounded.previous (I.Int^::ofNat n))).forward).apply (Bounded.apply model (I.Int^::ofNat n) x) \with {
        | zero: \fun (x: _) => \refl((Extension.space (I.Int^::negSucc N.Nat^::zero)).zero)
        | succ: \fun (n: N.Nat^)(previous: _)(x: _) => sym!{{Natural.Carrier n}} _ _ (\parent.Positive[n := n].law x)
      }
    | negSucc: \fun (n: N.Nat^)(x: _) => \refl((Extension.space (I.Int^::negSucc (N.Nat^::succ n))).zero)
  };
\definition BackwardEquation[z: I.Int^]: \Prop := \forall (x: Extension.Carrier z) ->
  Bounded.apply model z (((degreeIsomorphism z).backward).apply x) = ((degreeIsomorphism (Bounded.previous z)).backward).apply (Extension.apply z x);
\definition backwardCommutes: \forall (z: I.Int^) -> BackwardEquation z :=
  \induction (z: I.Int^) \return BackwardEquation z \with {
    | ofNat: \induction (n: N.Nat^) \return BackwardEquation (I.Int^::ofNat n) \with {
        | zero: \fun (x: Extension.Carrier (I.Int^::ofNat N.Nat^::zero)) => emptyCoordinates
            (Bounded.apply model (I.Int^::ofNat N.Nat^::zero) (((degreeIsomorphism (I.Int^::ofNat N.Nat^::zero)).backward).apply x))
            (((degreeIsomorphism (Bounded.previous (I.Int^::ofNat N.Nat^::zero))).backward).apply (Extension.apply (I.Int^::ofNat N.Nat^::zero) x))
        | succ: \fun (n: N.Nat^)(previous: BackwardEquation (I.Int^::ofNat n))
            (x: Extension.Carrier (I.Int^::ofNat (N.Nat^::succ n))) => \parent.Positive[n := n].law x
      }
    | negSucc: \fun (n: N.Nat^)(x: Extension.Carrier (I.Int^::negSucc n)) => emptyCoordinates
        (Bounded.apply model (I.Int^::negSucc n) (((degreeIsomorphism (I.Int^::negSucc n)).backward).apply x))
        (((degreeIsomorphism (Bounded.previous (I.Int^::negSucc n))).backward).apply (Extension.apply (I.Int^::negSucc n) x))
  };
\import Complexes.Map[C := Model.chain, D := Extension.complex] \as Forward;
\import Complexes.Map[C := Extension.complex, D := Model.chain] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (z: I.Int^) => ((degreeIsomorphism z).forward).apply,
  addition := \fun (z: I.Int^) => ((degreeIsomorphism z).forward).addition,
  scalar := \fun (z: I.Int^) => ((degreeIsomorphism z).forward).scalar,
  commutes := forwardCommutes,
};
\definition backward: Backward.Map := Backward.Map {
  apply := \fun (z: I.Int^) => ((degreeIsomorphism z).backward).apply,
  addition := \fun (z: I.Int^) => ((degreeIsomorphism z).backward).addition,
  scalar := \fun (z: I.Int^) => ((degreeIsomorphism z).backward).scalar,
  commutes := backwardCommutes,
};
\definition isomorphism: Complexes.Isomorphism[C := Model.chain, D := Extension.complex].Isomorphism := Complexes.Isomorphism[C := Model.chain, D := Extension.complex].Isomorphism {
  forward := forward, backward := backward,
  leftInverse := \fun (z: I.Int^) => (degreeIsomorphism z).leftInverse,
  rightInverse := \fun (z: I.Int^) => (degreeIsomorphism z).rightInverse,
};
