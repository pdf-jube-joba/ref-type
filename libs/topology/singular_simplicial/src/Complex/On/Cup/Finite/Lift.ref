\import Chains.Degree[n := n] \as Retraction;
\import Modules.Hom[V := Chains.Carrier n, W := R, source := Chains.space n, target := Singular.integerCoefficients.space] \as Maps;
\import Maps.Composition[U := SingularChains.Carrier n, domain := SingularChains.space n] \as Composition;
\definition apply[alpha: Carrier n]: Singular.Carrier n := Composition.compose alpha Retraction.retraction;
\definition section: \forall (alpha: Carrier n) -> (restriction).apply n (apply alpha) = alpha :=
  \fun (alpha: Carrier n) => Maps.ext ((restriction).apply n (apply alpha)) alpha
    (\fun (x: Chains.Carrier n) => congr!{{Chains.Carrier n} R} ((alpha).apply) _ _ (Retraction.leftInverse x));
\definition differential: \forall (alpha: Carrier n) ->
  (restriction).apply (N.Nat^::succ n) (Whole.coboundary n (apply alpha)) = coboundary n alpha :=
  \fun (alpha: Carrier n) => trans!{{Carrier (N.Nat^::succ n)}} _ _ _
    (sym!{{Carrier (N.Nat^::succ n)}} _ _ ((restriction).commutes n (apply alpha)))
    (congr!{{Carrier n} {Carrier (N.Nat^::succ n)}} (coboundary n) _ _ (section alpha));
