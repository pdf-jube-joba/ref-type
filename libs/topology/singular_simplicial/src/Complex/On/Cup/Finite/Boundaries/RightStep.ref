\import \parent.\parent.Product[p := p, q := k] \as Lower;
\import Lower.Closed[] \as ClosedProduct;
\import \parent.\parent.Product[p := p, q := N.Nat^::succ k] \as Upper;
\import \parent.\parent.Signs[n := Upper.total] \as Signs;
\definition law: RightProperty p (N.Nat^::succ k) := \block {
  \fun (alpha: Carrier p)(beta: Carrier (N.Nat^::succ k))(closed: Closed p alpha)(member: Member (N.Nat^::succ k) beta) \then
  \takefrom primitive: \Cast[Carrier k] ({ c: Carrier k \where coboundary k c = beta }) \by member \then
  \return Signs.reflectsBoundary p (Upper.apply alpha beta)
    (Logic.existsIntro[Carrier Lower.total, { c: Carrier Lower.total \where coboundary Lower.total c = Signs.apply p (Upper.apply alpha beta) }]
      (Lower.apply alpha primitive)
      (trans!{{Carrier Upper.total}} _ _ _ (ClosedProduct.leftClosed alpha primitive closed)
        (congr!{{Carrier (N.Nat^::succ k)} {Carrier Upper.total}}
          (\fun (b: Carrier (N.Nat^::succ k)) => Signs.apply p (Upper.apply alpha b)) _ _
          (\bysub(Carrier k, { c: Carrier k \where coboundary k c = beta }, primitive)))))
};
