\import \parent.\parent.Leibniz[p := p, q := q] \as Leibniz;
\import \parent.\parent.Product[p := N.Nat^::succ p, q := q] \as Left;
\import \parent.\parent.Product[p := p, q := N.Nat^::succ q] \as Right;
\import Left.Bilinear[] \as LeftBilinear;
\import Right.Bilinear[] \as RightBilinear;
\import \parent.\parent.Signs[n := N.Nat^::succ total] \as Signs;
\import \parent.\parent.DegreeTransport[] \as Degrees;
\import Simplices.CutFaces[p := p, q := q] \as Geometry;
\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\definition higher: N.Nat^ := N.Nat^::succ total;
\import Modules.Laws[V := Carrier higher, space := space higher] \as Values;
\definition leftZero: \forall (alpha: Carrier p)(beta: Carrier q) -> coboundary p alpha = #zero{(space (N.Nat^::succ p))} -> Leibniz.leftTerm alpha beta = #zero{(space higher)} :=
  \fun (alpha: Carrier p)(beta: Carrier q)(closed: coboundary p alpha = #zero{(space (N.Nat^::succ p))}) =>
    trans!{{Carrier higher}} _ _ _
      (congr!{{Carrier Geometry.leftDegree} {Carrier higher}} (Transport.cast Carrier Geometry.leftDegree higher Geometry.same) _ _
        (trans!{{Carrier Geometry.leftDegree}} _ _ _
          (congr!{{Carrier (N.Nat^::succ p)} {Carrier Geometry.leftDegree}} (\fun (x: Carrier (N.Nat^::succ p)) => Left.apply x beta) _ _ closed)
          (LeftBilinear.leftZero beta)))
      (Degrees.zero Geometry.leftDegree higher Geometry.same);
\definition rightZero: \forall (alpha: Carrier p)(beta: Carrier q) -> coboundary q beta = #zero{(space (N.Nat^::succ q))} -> Right.apply alpha (coboundary q beta) = #zero{(space higher)} :=
  \fun (alpha: Carrier p)(beta: Carrier q)(closed: coboundary q beta = #zero{(space (N.Nat^::succ q))}) => trans!{{Carrier higher}} _ _ _
    (congr!{{Carrier (N.Nat^::succ q)} {Carrier higher}} (Right.apply alpha) _ _ closed) (RightBilinear.rightZero alpha);
\definition signedRightZero: \forall (alpha: Carrier p)(beta: Carrier q) -> coboundary q beta = #zero{(space (N.Nat^::succ q))} -> Signs.apply p (Right.apply alpha (coboundary q beta)) = #zero{(space higher)} :=
  \fun (alpha: Carrier p)(beta: Carrier q)(closed: coboundary q beta = #zero{(space (N.Nat^::succ q))}) => trans!{{Carrier higher}} _ _ _
    (congr!{{Carrier higher} {Carrier higher}} (Signs.apply p) _ _ (rightZero alpha beta closed)) (Signs.zero p);
\definition rightClosed: \forall (alpha: Carrier p)(beta: Carrier q) -> coboundary q beta = #zero{(space (N.Nat^::succ q))} ->
  coboundary total (apply alpha beta) = Leibniz.leftTerm alpha beta :=
  \fun (alpha: Carrier p)(beta: Carrier q)(closed: coboundary q beta = #zero{(space (N.Nat^::succ q))}) => trans!{{Carrier higher}} _ _ _ (Leibniz.law alpha beta)
    (trans!{{Carrier higher}} _ _ _ (congr!{{Carrier higher} {Carrier higher}} (Values.add (Leibniz.leftTerm alpha beta)) _ _ (signedRightZero alpha beta closed))
      (Values.zeroRight (Leibniz.leftTerm alpha beta)));
\definition leftClosed: \forall (alpha: Carrier p)(beta: Carrier q) -> coboundary p alpha = #zero{(space (N.Nat^::succ p))} ->
  coboundary total (apply alpha beta) = Signs.apply p (Right.apply alpha (coboundary q beta)) :=
  \fun (alpha: Carrier p)(beta: Carrier q)(closed: coboundary p alpha = #zero{(space (N.Nat^::succ p))}) => trans!{{Carrier higher}} _ _ _ (Leibniz.law alpha beta)
    (trans!{{Carrier higher}} _ _ _ (congr!{{Carrier higher} {Carrier higher}} (\fun (x: Carrier higher) => Values.add x (Signs.apply p (Right.apply alpha (coboundary q beta)))) _ _ (leftZero alpha beta closed))
      (Values.zeroLeft (Signs.apply p (Right.apply alpha (coboundary q beta)))));
\definition law: \forall (alpha: Carrier p)(beta: Carrier q) -> coboundary p alpha = #zero{(space (N.Nat^::succ p))} -> coboundary q beta = #zero{(space (N.Nat^::succ q))} ->
  coboundary total (apply alpha beta) = #zero{(space higher)} :=
  \fun (alpha: Carrier p)(beta: Carrier q)(left: coboundary p alpha = #zero{(space (N.Nat^::succ p))})(right: coboundary q beta = #zero{(space (N.Nat^::succ q))}) =>
    trans!{{Carrier higher}} _ _ _ (rightClosed alpha beta right) (leftZero alpha beta left);
