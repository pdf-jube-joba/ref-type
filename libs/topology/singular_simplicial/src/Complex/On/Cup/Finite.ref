\use Equality.congr2;
\use Equality.eq_reason;
\import singular_cohomology.Cochains[A := Realization.Carrier, source := Realization.topology].With[coefficients := Singular.integerCoefficients] \as Whole;
\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import module_theory.Module[].Over[R := R, ring := baseRing] \as RingModules;
\definition space(n: N.Nat^): Modules.Space (Carrier n) := Native.cochainComplex.family.space n;
\definition coboundary(n: N.Nat^): Carrier n -> Carrier (N.Nat^::succ n) := #apply{Native.cochainComplex.differential} n;
\definition Closed(n: N.Nat^)(alpha: Carrier n): \Prop := coboundary n alpha = #zero{(space (N.Nat^::succ n))};
\module Degree(n: N.Nat^) {
  \import Complexes.At[C := Native.cochainComplex, k := n] \as Cohomology;
  \import Modules.Laws[V := Carrier n, space := space n] \as Laws;
  \import algebra.Group[].Of[Carrier := Carrier n, group := Laws.additive] \as Group;
  \definition Member(alpha: Carrier n): \Prop := \In[Carrier n] (Cohomology.Boundaries n) alpha;
}
\definition Member(n: N.Nat^)(alpha: Carrier n): \Prop := Degree[n := n].Member alpha;
\module Restriction(n: N.Nat^) {
  \import Modules.Hom[V := Singular.Carrier n, W := Carrier n, source := Whole.space n, target := space n] \as Maps;
  \definition map: Maps.Map := Maps.Map {
    apply := #apply{restriction} n,
    addition := #addition{restriction} n,
    scalar := #scalar{restriction} n,
  };
  \definition negative: \forall (alpha: Singular.Carrier n) ->
    #apply{restriction} n (#neg{(Whole.space n)} alpha) = #neg{(space n)} (#apply{restriction} n alpha) := Maps.negativePreserved map;
}
\module Lift(n: N.Nat^);
\module DegreeTransport;
\module Signs(n: N.Nat^);
\module Product(p, q: N.Nat^);
\module Leibniz(p, q: N.Nat^);
\module Boundaries;
