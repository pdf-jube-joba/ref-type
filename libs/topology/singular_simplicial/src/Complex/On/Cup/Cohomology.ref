\use Equality.congr2;
\import Singular.Cohomology[] \as SingularCohomology;
\import singular_cohomology.Cochains[A := Realization.Carrier, source := Realization.topology].With[coefficients := Singular.integerCoefficients] \as Ordinary;
\definition Group[n: N.Nat^]: \Set := Native.At[n := n].Carrier;
\module Degree(n: N.Nat^) {
  \import Native.Comparison[].At[n := n] \as Comparison;
  \definition restriction: Modules.Hom[V := SingularCohomology.Group n, W := Group n,
    source := Ordinary.cohomologySpace n, target := Native.At[n := n].space].Map := Comparison.induced;
  \definition extension: Modules.Hom[V := Group n, W := SingularCohomology.Group n,
    source := Native.At[n := n].space, target := Ordinary.cohomologySpace n].Map := (Comparison.isomorphism).backward;
  \definition leftInverse: \forall (x: SingularCohomology.Group n) -> (extension).apply ((restriction).apply x) = x := (Comparison.isomorphism).leftInverse;
  \definition rightInverse: \forall (x: Group n) -> (restriction).apply ((extension).apply x) = x := (Comparison.isomorphism).rightInverse;
}
\module Product(p, q: N.Nat^) {
  \import SingularCohomology.Cup[p := p, q := q] \as SingularProduct;
  \definition total: N.Nat^ := SingularProduct.degree;
  \import \parent.Degree[n := p] \as Left;
  \import \parent.Degree[n := q] \as Right;
  \import \parent.Degree[n := total] \as Output;
  \definition apply[x: Group p][y: Group q]: Group total := (Output.restriction).apply
    (SingularProduct.apply ((Left.extension).apply x) ((Right.extension).apply y));
  \definition compatibility: \forall (x: SingularCohomology.Group p)(y: SingularCohomology.Group q) ->
    apply ((Left.restriction).apply x) ((Right.restriction).apply y) = (Output.restriction).apply (SingularProduct.apply x y) :=
    \fun (x: SingularCohomology.Group p)(y: SingularCohomology.Group q) =>
      congr!{{SingularCohomology.Group total} {Group total}} ((Output.restriction).apply) _ _
        (congr2!{{SingularCohomology.Group p} {SingularCohomology.Group q} {SingularCohomology.Group total}}
          SingularProduct.apply _ _ _ _ (Left.leftInverse x) (Right.leftInverse y));
  \module Representatives;
}
