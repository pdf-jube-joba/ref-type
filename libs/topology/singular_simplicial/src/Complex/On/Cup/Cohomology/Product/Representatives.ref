\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import \root.Complex[d := d].On[K := K].Cup[R := R, ring := ring].Product[p := p, q := q] \as Formula;
\import Formula.Compatibility[] \as FormulaCompatibility;
\import Singular.Cup[p := p, q := q] \as WholeFormula;
\module Degree(n: N.Nat^) {
  \import Complexes.At[C := Ordinary.complex, k := n] \as Whole;
  \import Complexes.At[C := Native.cochainComplex, k := n] \as Finite;
  \import Complexes.Map[C := Ordinary.complex, D := Native.cochainComplex].At[k := n] \as Mapping;
  \import \parent.\parent.\parent.Degree[n := n] \as Compared;
  \definition Cycle: \Set := Whole.CycleCarrier;
  \definition finiteCycle: \Set := Finite.CycleCarrier;
  \definition classOf: Cycle -> SingularCohomology.Group n := Whole.classOf;
  \definition finiteClass: finiteCycle -> Group n := Finite.classOf;
  \definition restrict(x: Cycle): finiteCycle := #apply{(Mapping.cyclesMap restriction)} x;
  \definition onClass: \forall (x: Cycle) ->
    #apply{Compared.restriction} (classOf x) = finiteClass (restrict x) := Mapping.onClass restriction;
  \definition closed: \forall (x: finiteCycle) ->
    #apply{Native.cochainComplex.differential} n x = #zero{(Native.cochainComplex.family.space (N.Nat^::succ n))} :=
    \fun (x: finiteCycle) => \bysub(Carrier n, #carrier{Finite.cycles}, x);
  \definition introduce(x: Carrier n)(closed: #apply{Native.cochainComplex.differential} n x = #zero{(Native.cochainComplex.family.space (N.Nat^::succ n))}): finiteCycle := Finite.cycle x closed;
  \definition equalClass: \forall (x, y: finiteCycle) -> Finite.ambient x = Finite.ambient y -> finiteClass x = finiteClass y := Finite.equalClass;
  \definition representatives: \forall (h: SingularCohomology.Group n) -> \exists { x: Cycle \where classOf x = h } :=
    Whole.classInduction (\fun (h: SingularCohomology.Group n) => \exists { x: Cycle \where classOf x = h })
      (\fun (x: Cycle) => Logic.existsIntro[Cycle, { y: Cycle \where classOf y = classOf x }] x (\refl(classOf x)));
  \definition existsOnClass: \forall (h: Group n) -> \exists { x: Cycle \where finiteClass (restrict x) = h } := \block {
    \fun (h: Group n) \then
    \takefrom x: \Cast[Cycle] ({ x: Cycle \where classOf x = #apply{Compared.extension} h }) \by representatives (#apply{Compared.extension} h) \then
    \return Logic.existsIntro[Cycle, { x: Cycle \where finiteClass (restrict x) = h }] x
      (trans!{{Group n}} _ _ _ (sym!{{Group n}} _ _ (onClass x))
        (trans!{{Group n}} _ _ _
          (congr!{{SingularCohomology.Group n} {Group n}} (#apply{Compared.restriction}) _ _
            (\bysub(Cycle, { x: Cycle \where classOf x = #apply{Compared.extension} h }, x)))
          (Compared.rightInverse h)))
  };
}
\import Degree[n := p] \as LeftCycles;
\import Degree[n := q] \as RightCycles;
\import Degree[n := total] \as OutputCycles;
\definition singularCycle(alpha: LeftCycles.Cycle)(beta: RightCycles.Cycle): OutputCycles.Cycle := SingularProduct.cycle alpha beta;
\definition mappedCycle(alpha: LeftCycles.Cycle)(beta: RightCycles.Cycle): OutputCycles.finiteCycle := OutputCycles.restrict (singularCycle alpha beta);
\definition mappedValue(alpha: LeftCycles.Cycle)(beta: RightCycles.Cycle): Carrier total := mappedCycle alpha beta;
\definition values(alpha: LeftCycles.Cycle)(beta: RightCycles.Cycle): Carrier total :=
  Formula.apply (#apply{restriction} p alpha) (#apply{restriction} q beta);
\definition same: \forall (alpha: LeftCycles.Cycle)(beta: RightCycles.Cycle) ->
  mappedValue alpha beta = values alpha beta :=
  \fun (alpha: LeftCycles.Cycle)(beta: RightCycles.Cycle) => FormulaCompatibility.law alpha beta;
\definition closed: \forall (alpha: LeftCycles.Cycle)(beta: RightCycles.Cycle) ->
  #apply{Native.cochainComplex.differential} total (values alpha beta) = #zero{(Native.cochainComplex.family.space (N.Nat^::succ total))} :=
  \fun (alpha: LeftCycles.Cycle)(beta: RightCycles.Cycle) =>
    \idelim mappedValue alpha beta = values alpha beta \with z: Carrier total =>
      #apply{Native.cochainComplex.differential} total z = #zero{(Native.cochainComplex.family.space (N.Nat^::succ total))} \by {
      base: OutputCycles.closed (mappedCycle alpha beta), equality: same alpha beta
    };
\definition cycle(alpha: LeftCycles.Cycle)(beta: RightCycles.Cycle): OutputCycles.finiteCycle := OutputCycles.introduce (values alpha beta) (closed alpha beta);
\use Equality.eq_reason;
\definition law: \forall (alpha: LeftCycles.Cycle)(beta: RightCycles.Cycle) ->
  apply (LeftCycles.finiteClass (LeftCycles.restrict alpha)) (RightCycles.finiteClass (RightCycles.restrict beta)) = OutputCycles.finiteClass (cycle alpha beta) :=
  \fun (alpha: LeftCycles.Cycle)(beta: RightCycles.Cycle) => eq_reason!{
    {apply (LeftCycles.finiteClass (LeftCycles.restrict alpha)) (RightCycles.finiteClass (RightCycles.restrict beta))}
    "=" {apply (#apply{Left.restriction} (LeftCycles.classOf alpha)) (#apply{Right.restriction} (RightCycles.classOf beta))}
    "by" {congr2!{{Group p} {Group q} {Group total}} apply _ _ _ _
      (sym!{{Group p}} _ _ (LeftCycles.onClass alpha)) (sym!{{Group q}} _ _ (RightCycles.onClass beta))}
    "=" {#apply{Output.restriction} (SingularProduct.apply (LeftCycles.classOf alpha) (RightCycles.classOf beta))}
    "by" {compatibility (LeftCycles.classOf alpha) (RightCycles.classOf beta)}
    "=" {#apply{Output.restriction} (OutputCycles.classOf (singularCycle alpha beta))}
    "by" {congr!{{SingularCohomology.Group total} {Group total}} (#apply{Output.restriction}) _ _ (SingularProduct.onClasses alpha beta)}
    "=" {OutputCycles.finiteClass (mappedCycle alpha beta)} "by" {OutputCycles.onClass (singularCycle alpha beta)}
    "=" {OutputCycles.finiteClass (cycle alpha beta)} "by" {OutputCycles.equalClass (mappedCycle alpha beta) (cycle alpha beta) (same alpha beta)}
  };
