\import std.Set[].FiniteSubset[A := Tuple n] \as Finite;
\import Fin.Functions[n := N.Nat^::succ d] \as Functions;
\import Fin.Pigeonhole[] \as Pigeonhole;
\definition simplices: Finite.FiniteSubset := Finite.filter (Functions.value (N.Nat^::succ n)) ({ vertices: Tuple n \where Admissible[n, vertices] });
\definition simplexSet: Finite.underlying simplices = ({ vertices: Tuple n \where Admissible[n, vertices] }) :=
  \axiom:setext(Finite.underlying simplices, ({ vertices: Tuple n \where Admissible[n, vertices] }),
    \fun (vertices: Tuple n)(member: Logic.And[vertices = vertices, Admissible[n, vertices]]) => #right{member},
    \fun (vertices: Tuple n)(member: Admissible[n, vertices]) => Logic.And[vertices = vertices, Admissible[n, vertices]]::# (\refl(vertices)) member);
\definition finite: Finite.Finite ({ vertices: Tuple n \where Admissible[n, vertices] }) :=
  \idelim Finite.underlying simplices = ({ vertices: Tuple n \where Admissible[n, vertices] }) \with S: \Pow (Tuple n) => Finite.Finite S \by {
    base: Finite.finite simplices, equality: simplexSet
  };
\definition aboveDimension: Bounds.Lt d n -> \forall (sigma: Simplex n) -> Logic.False :=
  \fun (large: Bounds.Lt d n)(sigma: Simplex n) => Pigeonhole.noInjection (N.Nat^::succ d) (N.Nat^::succ n)
    (Bounds.ltSuccSucc d n large) sigma
    (Indices.increasingInjective (N.Nat^::succ n) (N.Nat^::succ d) sigma (#increasing{(admissible n sigma)}));
