\import Chains.Map[C := TargetColumn.complex, D := TargetTotal.complex].Composition[B := Nerve.complex] \as Composition;
\definition backward: Chains.Map[C := Nerve.complex, D := TargetTotal.complex].Map := Composition.compose Concentrated.backward Identification.backward;
\definition leftInverse: \forall (n: N.Nat^)(x: TargetTotal.Carrier n) -> (backward).apply n ((projection).apply n x) = x :=
  \fun (n: N.Nat^)(x: TargetTotal.Carrier n) => trans!{{TargetTotal.Carrier n}} _ _ _
    (congr!{{Nerve.Carrier n} {TargetTotal.Carrier n}} ((Concentrated.backward).apply n) _ _
      ((Identification.isomorphism).leftInverse n ((Concentrated.forward Target.vanishes).apply n x)))
    (Concentrated.leftInverse Target.vanishes n x);
\definition rightInverse: \forall (n: N.Nat^)(x: Nerve.Carrier n) -> (projection).apply n ((backward).apply n x) = x :=
  \fun (n: N.Nat^)(x: Nerve.Carrier n) => trans!{{Nerve.Carrier n}} _ _ _
    (congr!{{Nerve.Carrier n} {Nerve.Carrier n}} ((Identification.forward).apply n) _ _
      (Concentrated.rightInverse Target.vanishes n ((Identification.backward).apply n x)))
    ((Identification.isomorphism).rightInverse n x);
\import Chains.Isomorphism[C := TargetTotal.complex, D := Nerve.complex] \as Isomorphisms;
\definition data: Isomorphisms.Data := Isomorphisms.Data { forward := projection, backward := backward };
\definition isomorphism: Isomorphisms.Isomorphism := \into[Isomorphisms.Data](data, Isomorphisms.Isomorphism) \by {
  Isomorphisms.Laws[data] { leftInverse := leftInverse, rightInverse := rightInverse }
};
\definition equivalence: Chains.Equivalence[C := TargetTotal.complex, D := Nerve.complex].Equivalence :=
  Chains.Equivalence[C := TargetTotal.complex, D := Nerve.complex].FromIsomorphism[].apply isomorphism;
