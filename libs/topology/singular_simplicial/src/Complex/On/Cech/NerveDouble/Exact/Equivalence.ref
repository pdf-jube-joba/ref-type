\import singular_cech.Algebra[R := I.Int^, ring := Integers.ring].ProjectiveQuasi[C := Total.complex, D := TargetTotal.complex, f := Induced.map] \as Bridge;
\definition sourceProjective: Bridge.SourceProjective := \fun (n: N.Nat^) => \parent.\parent.\parent.Freeness[n := n].projective;
\definition nerveProjective: \forall (n: N.Nat^) -> Modules.Projective (Modules.Bundle { Carrier := Nerve.Carrier n, space := Nerve.space n }) :=
  \fun (n: N.Nat^) => Modules.Free[Generators := Simplex n].projective;
\module Degree(n: N.Nat^) {
  \import TargetTotal.Degree[n := n] \as Degree;
  \import Modules.DirectSum[Index := Doubles.Index n, family := Degree.family] \as Sum;
  \definition projective: Modules.Projective (Modules.Bundle { Carrier := TargetTotal.Carrier n, space := TargetTotal.space n }) :=
    Sum.projective (\fun (i: Doubles.Index n) => Target.componentProjective nerveProjective (i).first (i).second);
}
\definition targetProjective: Bridge.TargetProjective := \fun (n: N.Nat^) => Degree[n := n].projective;
\definition existence: \exists ( e: Chains.Equivalence[C := Total.complex, D := TargetTotal.complex].Equivalence \where (e).forward = Induced.map ) :=
  Bridge.equivalenceExists sourceProjective targetProjective onto exact;
