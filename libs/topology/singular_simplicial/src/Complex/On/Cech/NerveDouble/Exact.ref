\import Doubles.Collapse[C := Source.complex, D := Target.complex] \as Collapse;
\definition rows: Collapse.RowsExact[mapping] := Collapse.RowsExact[mapping] {
  augmentation := \fun (p: N.Nat^)(x: Carrier p N.Nat^::zero)(killed: #apply{(mapping p N.Nat^::zero)} x = #zero{(Nerve.space p)}) =>
    Logic.existsIntro[Carrier p (N.Nat^::succ N.Nat^::zero), { y: Carrier p (N.Nat^::succ N.Nat^::zero) \where #apply{(Source.vertical p N.Nat^::zero)} y = x }]
      (#apply{(\parent.\parent.VerticalFilling[p := p].homotopy N.Nat^::zero)} x)
      (\parent.\parent.VerticalFilling[p := p].Zero[].cycle x killed),
  positive := \fun (p, q: N.Nat^)(x: Carrier p (N.Nat^::succ q))(closed: #apply{(Source.vertical p q)} x = #zero{(space p q)}) =>
    Logic.existsIntro[Carrier p (N.Nat^::succ (N.Nat^::succ q)), { y: Carrier p (N.Nat^::succ (N.Nat^::succ q)) \where #apply{(Source.vertical p (N.Nat^::succ q))} y = x }]
      (#apply{(\parent.\parent.VerticalFilling[p := p].homotopy (N.Nat^::succ q))} x)
      (\parent.\parent.VerticalFilling[p := p].Positive[q := q].cycle x closed),
};
\import Collapse.On[f := mapping] \as CollapseMap;
\import CollapseMap.Exact[] \as Exact;
\import CollapseMap.Surjection[] \as Onto;
\import Chains.Map[C := Total.complex, D := TargetTotal.complex].SurjectiveQuasi[f := Induced.map] \as Criterion;
\definition onto: Criterion.Onto := Onto.onto Target.vanishes (\fun (p: N.Nat^) => Augmentation.Degree[p := p].onto);
\definition exact: Criterion.ExactCycles := Exact.exact rows Target.vanishes;
\module Equivalence;
