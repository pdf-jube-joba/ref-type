\import Modules.Hom[V := Coproduct.Carrier n, W := Native.Carrier n, source := Coproduct.space n, target := Native.space n]
  .Composition[U := Native.Carrier n, domain := Native.space n] \as Left;
\import Modules.Hom[V := Native.Carrier n, W := Coproduct.Carrier n, source := Native.space n, target := Coproduct.space n]
  .Composition[U := Coproduct.Carrier n, domain := Coproduct.space n] \as Right;
\import Modules.End[V := Native.Carrier n, space := Native.space n] \as Source;
\import Modules.End[V := Coproduct.Carrier n, space := Coproduct.space n] \as Target;
\import Complexes.Map[C := Native.complex, D := Coproduct.complex].At[n := n] \as Forward;
\import Complexes.Map[C := Coproduct.complex, D := Native.complex].At[n := n] \as Backward;
\import Modules.Free[Generators := Generator n q].To[W := Native.Carrier n, target := Native.space n] \as SourceFree;
\import Modules.Free[Generators := Coproduct.Generator[n]].To[W := Coproduct.Carrier n, target := Coproduct.space n] \as TargetFree;
\definition left: Left.compose (Backward.linear backwardMap) (Forward.linear forwardMap) = Source.identity :=
  SourceFree.ext _ _ (\fun (s: Generator n q) => trans!{{Native.Carrier n}} _ _ _
    (congr!{{Coproduct.Carrier n} {Native.Carrier n}} (#apply{backwardMap} n) _ _ (Encode.At[n := n].onGenerator forward s))
    (trans!{{Native.Carrier n}} _ _ _ (Decode.At[n := n].onGenerator backward (encode n s))
      (congr!{{Generator n q} {Native.Carrier n}} (Native.generator n) _ _ (decodeEncode n s))));
\definition right: Right.compose (Forward.linear forwardMap) (Backward.linear backwardMap) = Target.identity :=
  TargetFree.ext _ _ (\fun (s: Coproduct.Generator[n]) => trans!{{Coproduct.Carrier n}} _ _ _
    (congr!{{Native.Carrier n} {Coproduct.Carrier n}} (#apply{forwardMap} n) _ _ (Decode.At[n := n].onGenerator backward s))
    (trans!{{Coproduct.Carrier n}} _ _ _ (Encode.At[n := n].onGenerator forward (decode n s))
      (congr!{{Coproduct.Generator[n]} {Coproduct.Carrier n}} (Coproduct.generator n) _ _ (encodeDecode n s))));
\definition leftInverse: \forall (x: Native.Carrier n) -> #apply{backwardMap} n (#apply{forwardMap} n x) = x :=
  \fun (x: Native.Carrier n) => congr!{{Modules.Hom[V := Native.Carrier n, W := Native.Carrier n, source := Native.space n, target := Native.space n].Map} {Native.Carrier n}}
    (\fun (f: Modules.Hom[V := Native.Carrier n, W := Native.Carrier n, source := Native.space n, target := Native.space n].Map) => #apply{f} x) _ _ left;
\definition rightInverse: \forall (x: Coproduct.Carrier n) -> #apply{forwardMap} n (#apply{backwardMap} n x) = x :=
  \fun (x: Coproduct.Carrier n) => congr!{{Modules.Hom[V := Coproduct.Carrier n, W := Coproduct.Carrier n, source := Coproduct.space n, target := Coproduct.space n].Map} {Coproduct.Carrier n}}
    (\fun (f: Modules.Hom[V := Coproduct.Carrier n, W := Coproduct.Carrier n, source := Coproduct.space n, target := Coproduct.space n].Map) => #apply{f} x) _ _ right;
