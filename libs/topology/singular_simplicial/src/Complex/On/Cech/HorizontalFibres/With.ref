\module At(sigma: SmallSimplices.Carrier q) {
  \import \parent.\parent.\parent.Row[q := q, sigma := sigma].With[apex := apices sigma] \as Row;
  \definition cone: singular_cech.PartialCone[].On[X := objects sigma].Cone := Row.partialCone;
}
\definition operators: Coproduct.Operators := Coproduct.Operators {
  apex := \fun (sigma: SmallSimplices.Carrier q) => #apex{At[sigma := sigma].cone},
  homotopy := \fun (sigma: SmallSimplices.Carrier q) => singular_cech.PartialCone[].On[X := objects sigma].With[cone := At[sigma := sigma].cone].homotopy,
};
\definition laws: Coproduct.Laws[operators] := Coproduct.Laws[operators] {
  zero := \fun (sigma: SmallSimplices.Carrier q) => singular_cech.PartialCone[].On[X := objects sigma].With[cone := At[sigma := sigma].cone].Zero[].onGenerator,
  positive := \fun (sigma: SmallSimplices.Carrier q)(n: N.Nat^) => singular_cech.PartialCone[].On[X := objects sigma].With[cone := At[sigma := sigma].cone].Positive[n := n].law,
};
\definition contractions: Coproduct.Contractions := \into[Coproduct.Operators](operators, Coproduct.Contractions) \by { laws };
\import Coproduct.With[contractions := contractions] \as Contracted;
\module Positive(n: N.Nat^);
\module Zero;
