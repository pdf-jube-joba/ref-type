\import \parent.\parent.Row[q := q, sigma := sigma] \as Row;
\definition Carrier: N.Nat^ -> \Set := Row.Carrier;
\definition face: \forall (n: N.Nat^)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) -> Carrier (N.Nat^::succ n) -> Carrier n := Row.face;
\definition family: Semisimplicial.Family := Semisimplicial.Family { Carrier := Carrier };
\definition faces: Semisimplicial.Faces[family] := Semisimplicial.Faces[family] { apply := face };
\definition laws: Semisimplicial.Laws[family, faces] := Semisimplicial.Laws[family, faces] {
  identity := \fun (n: N.Nat^)(i, j: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))
    (s: Carrier (N.Nat^::succ (N.Nat^::succ n)))(ordered: Bounds.Le i j) => Faces.identity n i j s ordered,
};
