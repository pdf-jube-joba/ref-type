\import Complexes.Map[C := Native.complex, D := Coproduct.complex].At[n := n] \as LowerForward;
\definition closed: \forall (x: Native.Carrier (N.Nat^::succ n)) -> #apply{(Native.boundary n)} x = #zero{(Native.space n)} ->
  #apply{(Coproduct.boundary n)} (#apply{forwardMap} (N.Nat^::succ n) x) = #zero{(Coproduct.space n)} :=
  \fun (x: Native.Carrier (N.Nat^::succ n))(cycle: #apply{(Native.boundary n)} x = #zero{(Native.space n)}) =>
    trans!{{Coproduct.Carrier n}} _ _ _ (#commutes{forwardMap} n x)
      (trans!{{Coproduct.Carrier n}} _ _ _ (congr!{{Native.Carrier n} {Coproduct.Carrier n}} (#apply{forwardMap} n) _ _ cycle)
        (LowerForward.zeroPreserved forwardMap));
\definition filler(x: Native.Carrier (N.Nat^::succ n)): Native.Carrier (N.Nat^::succ (N.Nat^::succ n)) :=
  #apply{backwardMap} (N.Nat^::succ (N.Nat^::succ n)) (#apply{(Contracted.homotopy (N.Nat^::succ n))} (#apply{forwardMap} (N.Nat^::succ n) x));
\definition boundary: \forall (x: Native.Carrier (N.Nat^::succ n)) -> #apply{(Native.boundary n)} x = #zero{(Native.space n)} ->
  #apply{(Native.boundary (N.Nat^::succ n))} (filler x) = x :=
  \fun (x: Native.Carrier (N.Nat^::succ n))(cycle: #apply{(Native.boundary n)} x = #zero{(Native.space n)}) =>
    trans!{{Native.Carrier (N.Nat^::succ n)}} _ _ _
      (#commutes{backwardMap} (N.Nat^::succ n) (#apply{(Contracted.homotopy (N.Nat^::succ n))} (#apply{forwardMap} (N.Nat^::succ n) x)))
      (trans!{{Native.Carrier (N.Nat^::succ n)}} _ _ _
        (congr!{{Coproduct.Carrier (N.Nat^::succ n)} {Native.Carrier (N.Nat^::succ n)}} (#apply{backwardMap} (N.Nat^::succ n)) _ _
          (Contracted.Positive[n := n].cycle (#apply{forwardMap} (N.Nat^::succ n) x) (closed x cycle)))
        (\parent.\parent.Degree[n := N.Nat^::succ n].leftInverse x));
