\definition degree: N.Nat^ := N.Nat^::zero;
\import \parent.\parent.\parent.SmallAugmentation[] \as Augmentation;
\import singular_cohomology.Small[A := Realization.Carrier, source := Realization.topology, family := Stars.family] \as Small;
\import Contracted.Zero[] \as Reduced;
\import Modules.Hom[V := Coproduct.Carrier degree, W := Small.Carrier q, source := Coproduct.space degree, target := Small.space q]
  .Composition[U := Native.Carrier degree, domain := Native.space degree] \as Compose;
\import Complexes.Map[C := Native.complex, D := CoproductNative.complex].At[n := degree] \as Forward;
\import Modules.Hom[V := Native.Carrier degree, W := Small.Carrier q, source := Native.space degree, target := Small.space q] \as Maps;
\definition augmentation: Maps.Map := Maps.Map {
  apply := #apply{Augmentation.map} q, addition := #addition{Augmentation.map} q, scalar := #scalar{Augmentation.map} q,
};
\import Modules.Free[Generators := Generator degree q].To[W := Small.Carrier q, target := Small.space q] \as Free;
\definition equation: Compose.compose Reduced.augmentation (Forward.linear forwardMap) = augmentation :=
  Free.ext _ _ (\fun (s: Generator degree q) => trans!{{Small.Carrier q}} _ _ _
    (congr!{{Coproduct.Carrier degree} {Small.Carrier q}} (#apply{Reduced.augmentation}) _ _ (Encode.At[n := degree].onGenerator forward s))
    (trans!{{Small.Carrier q}} _ _ _ (Reduced.augmentationOnGenerator (encode degree s))
      (sym!{{Small.Carrier q}} _ _ (Augmentation.onGenerator q s))));
\definition compatibility: \forall (x: Native.Carrier degree) -> #apply{Reduced.augmentation} (#apply{forwardMap} degree x) = #apply{augmentation} x :=
  \fun (x: Native.Carrier degree) => congr!{{Maps.Map} {Small.Carrier q}} (\fun (f: Maps.Map) => #apply{f} x) _ _ equation;
\definition filler(x: Native.Carrier degree): Native.Carrier (N.Nat^::succ degree) :=
  #apply{backwardMap} (N.Nat^::succ degree) (#apply{(Contracted.homotopy degree)} (#apply{forwardMap} degree x));
\definition boundary: \forall (x: Native.Carrier degree) -> #apply{augmentation} x = #zero{(Small.space q)} ->
  #apply{(Native.boundary degree)} (filler x) = x :=
  \fun (x: Native.Carrier degree)(reduced: #apply{augmentation} x = #zero{(Small.space q)}) =>
    trans!{{Native.Carrier degree}} _ _ _ (#commutes{backwardMap} degree (#apply{(Contracted.homotopy degree)} (#apply{forwardMap} degree x)))
      (trans!{{Native.Carrier degree}} _ _ _
        (congr!{{Coproduct.Carrier degree} {Native.Carrier degree}} (#apply{backwardMap} degree) _ _
          (Reduced.cycle (#apply{forwardMap} degree x) (trans!{{Small.Carrier q}} _ _ _ (compatibility x) reduced)))
        (\parent.\parent.Degree[n := degree].leftInverse x));
