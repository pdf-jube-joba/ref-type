\import \parent.\parent.Realization[].Stars[] \as Stars;
\import singular_cohomology.Small[A := Realization.Carrier, source := Realization.topology, family := Stars.family].Simplices[] \as SmallSimplices;
\import \parent.Horizontal[q := q] \as Horizontal;
\import singular_cohomology.SimplicialChains[].On[X := Horizontal.object] \as Native;
\definition objects(sigma: SmallSimplices.Carrier q): Semisimplicial.Object := \parent.Row[q := q, sigma := sigma].object;
\import singular_cech.Coproduct[].On[Index := SmallSimplices.Carrier q, objects := objects] \as Coproduct;
\definition label(n: N.Nat^)(s: Generator n q): SmallSimplices.Carrier q :=
  \into[Simplices.Carrier q](#singular{s}, SmallSimplices.Small q) \by {
    \exact(SmallSimplices.Witness[q, #singular{s}] {
      element := Stars.star (#vertices{s} (Fin.zero n)), member := Stars.member (#vertices{s} (Fin.zero n)),
      contained := \fun (x: Geometric.Carrier q) => common n q s x (Fin.zero n),
    }, SmallSimplices.Witness[q, #singular{s}])
  };
\definition vertices(n: N.Nat^)(s: Generator n q): \parent.Row[q := q, sigma := label n s].Carrier n :=
  \into[Simplex n](#vertices{s}, \parent.Row[q := q, sigma := label n s].Carrier n) \by {
    \fun (i: Fin.Fin (N.Nat^::succ n))(x: Geometric.Carrier q) => common n q s x i
  };
\definition encode(n: N.Nat^)(s: Generator n q): Coproduct.Generator[n] :=
  Coproduct.Generator[n] { index := label n s, simplex := vertices n s };
\definition decode(n: N.Nat^)(s: Coproduct.Generator[n]): Generator n q :=
  \parent.Row[q := q, sigma := #index{s}].encode n #simplex{s};
\definition decodeEncode: \forall (n: N.Nat^)(s: Generator n q) -> decode n (encode n s) = s :=
  \fun (n: N.Nat^)(s: Generator n q) => dataExt n q (decode n (encode n s)) s (\refl(#vertices{s})) (\refl(#singular{s}));
\definition encodeDecode: \forall (n: N.Nat^)(s: Coproduct.Generator[n]) -> encode n (decode n s) = s :=
  \fun (n: N.Nat^) => \induction (s: Coproduct.Generator[n]) \return encode n (decode n s) = s \with {
    | # : \fun (sigma: SmallSimplices.Carrier q)(s: \parent.Row[q := q, sigma := sigma].Carrier n) =>
      \refl(Coproduct.Generator[n] { index := sigma, simplex := s })
  };
\import Semisimplicial.Maps[X := Horizontal.object, Y := Coproduct.object] \as Forward;
\definition forward: Forward.Map := Forward.Map {
  apply := encode,
  faces := \fun (n: N.Nat^)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(s: Generator (N.Nat^::succ n) q) =>
    \refl(Coproduct.Generator[n] { index := label n (horizontal n q i s), simplex := vertices n (horizontal n q i s) }),
};
\import Semisimplicial.Maps[X := Coproduct.object, Y := Horizontal.object] \as Backward;
\definition backward: Backward.Map := Backward.Map {
  apply := decode,
  faces := \fun (n: N.Nat^)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)))(s: Coproduct.Generator[N.Nat^::succ n]) =>
    dataExt n q (decode n (Coproduct.face n i s)) (horizontal n q i (decode (N.Nat^::succ n) s)) (\refl(Faces.apply n i #simplex{s})) (\refl(#index{s})),
};
\import Native.Mapping[Y := Coproduct.object] \as Encode;
\import singular_cohomology.SimplicialChains[].On[X := Coproduct.object].Mapping[Y := Horizontal.object] \as Decode;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\definition forwardMap: Complexes.Map[C := Native.complex, D := Coproduct.complex].Map := Encode.map forward;
\definition backwardMap: Complexes.Map[C := Coproduct.complex, D := Native.complex].Map := Decode.map backward;
\module Degree(n: N.Nat^);
\definition isomorphism: Complexes.Isomorphism[C := Native.complex, D := Coproduct.complex].Isomorphism :=
  \into[Complexes.Isomorphism[C := Native.complex, D := Coproduct.complex].Data](
    Complexes.Isomorphism[C := Native.complex, D := Coproduct.complex].Data { forward := forwardMap, backward := backwardMap },
    Complexes.Isomorphism[C := Native.complex, D := Coproduct.complex].Isomorphism) \by {
      Complexes.Isomorphism[C := Native.complex, D := Coproduct.complex].Laws[
        Complexes.Isomorphism[C := Native.complex, D := Coproduct.complex].Data { forward := forwardMap, backward := backwardMap }] {
          leftInverse := \fun (n: N.Nat^) => Degree[n := n].leftInverse,
          rightInverse := \fun (n: N.Nat^) => Degree[n := n].rightInverse,
        }
    };
\definition Apices: \Set := \forall (sigma: SmallSimplices.Carrier q) -> \parent.Row[q := q, sigma := sigma].Apex;
\definition apicesExist: \exists Apices := \axiom:classicalIndefiniteChoice(SmallSimplices.Carrier q,
  (\fun (sigma: SmallSimplices.Carrier q) => \parent.Row[q := q, sigma := sigma].Apex),
  (\fun (sigma: SmallSimplices.Carrier q) => \parent.Row[q := q, sigma := sigma].apexExists));
\module With(apices: Apices);
