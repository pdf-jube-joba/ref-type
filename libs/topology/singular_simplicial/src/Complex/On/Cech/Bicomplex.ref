\definition family: Doubles.Family := Doubles.Family { Carrier := Carrier, space := space };
\definition horizontal(p, q: N.Nat^): Modules.Hom[V := Carrier (N.Nat^::succ p) q, W := Carrier p q, source := space (N.Nat^::succ p) q, target := space p q].Map :=
  singular_cohomology.SimplicialChains[].On[X := \parent.Horizontal[q := q].object].boundary p;
\definition vertical(p, q: N.Nat^): Modules.Hom[V := Carrier p (N.Nat^::succ q), W := Carrier p q, source := space p (N.Nat^::succ q), target := space p q].Map :=
  singular_cohomology.SimplicialChains[].On[X := \parent.Vertical[p := p].object].boundary q;
\definition differential: Doubles.DifferentialData[family] := Doubles.DifferentialData[family] { horizontal := horizontal, vertical := vertical };
\module Commutation(p, q: N.Nat^);
\definition complex: Doubles.Complex := Doubles.Complex {
  family := family, differential := differential,
  laws := Doubles.DifferentialLaws[family, differential] {
    horizontalZero := \fun (p, q: N.Nat^) => singular_cohomology.SimplicialChains[].On[X := \parent.Horizontal[q := q].object].SquareZero[n := p].all,
    verticalZero := \fun (p, q: N.Nat^) => singular_cohomology.SimplicialChains[].On[X := \parent.Vertical[p := p].object].SquareZero[n := q].all,
    commute := \fun (p, q: N.Nat^) => Commutation[p := p, q := q].all,
  },
};
