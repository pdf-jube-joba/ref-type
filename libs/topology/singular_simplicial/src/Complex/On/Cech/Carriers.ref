\import \parent.Bicomplex[] \as Bicomplex;
\import Doubles.Total[C := Bicomplex.complex] \as Total;
\import singular_cohomology.Chains[A := Realization.Carrier, source := Realization.topology].Reduced[] \as Global;
\import chain_complexes.Chain[] \as Degrees;
\import Degrees.Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\module Cell(n: N.Nat^, c: \parent.Based[n := n].Cell);
\import singular_cech.CarrierModel[].On[C := Total.complex, D := Global.complex] \as Algebra;
\module Point(n: N.Nat^, z: I.Int^);
\definition supports: Algebra.Supports := \fun (n: N.Nat^)(z: I.Int^) => Point[n := n, z := z].support;
\module Transition(n: N.Nat^, z: I.Int^);
\module Singular(q: N.Nat^, sigma: Simplices.Carrier q, z: I.Int^);
\module Sums(z: I.Int^);
\definition closed: Algebra.Closure[supports] := Algebra.Closure[supports] {
  boundary := \fun (n: N.Nat^)(z: I.Int^)(f: Algebra.HomAt[n := n, z := z].Carrier)(member: Point[n := n, z := z].Member f) =>
    Point[n := n, z := z].Boundary[f := f, member := member].law,
  transition := \fun (n: N.Nat^)(z: I.Int^)(f: Algebra.HomAt[n := n, z := z].Carrier)(member: Point[n := n, z := z].Member f) =>
    Transition[n := n, z := z].On[f := f, member := member].law,
};
\import Algebra.With[S := supports, closed := closed] \as Supported;
\module Filling(n: N.Nat^);
\module Factors(n: N.Nat^);
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import singular_cohomology.Chains[A := Realization.Carrier, source := Realization.topology] \as Whole;
\import \parent.SmallDouble[] \as SmallComparison;
\import \parent.NerveDouble[] \as NerveComparison;
\import \root.Complex[d := d].On[K := K].Chains[] \as Affine;
\definition first: Native.Map[C := Total.complex, D := Whole.complex].Map := SmallComparison.global;
\import Native.Map[C := Affine.complex, D := Whole.complex].Composition[B := Total.complex] \as Composition;
\definition second: Native.Map[C := Total.complex, D := Whole.complex].Map := Composition.compose Affine.comparison NerveComparison.comparison;
\import Native.Map[C := Total.complex, D := Whole.complex].Additive[] \as Additive;
\definition difference: Native.Map[C := Total.complex, D := Whole.complex].Map := Additive.difference first second;
\module Augmentation;
\module Delta;
\module Comparison;
