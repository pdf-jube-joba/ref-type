\import \parent.Bicomplex[] \as Bicomplex;
\import Doubles.Total[C := Bicomplex.complex] \as Total;
\import Total.Degree[n := n] \as Degree;
\import Modules.DirectSum[Index := Doubles.Index n, family := Degree.family] \as Sum;
\definition projective: Modules.Projective (Modules.Bundle { Carrier := Total.Carrier n, space := Total.space n }) :=
  Sum.projective (\fun (i: Doubles.Index n) => Modules.Free[Generators := Generator #first{i} #second{i}].projective);
