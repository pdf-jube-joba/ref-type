\definition family: Semisimplicial.Family := Semisimplicial.Family { Carrier := \fun (q: N.Nat^) => Generator p q };
\definition faces: Semisimplicial.Faces[family] := Semisimplicial.Faces[family] { apply := \fun (q: N.Nat^) => vertical p q };
\definition identity: \forall (q: N.Nat^)(i, j: Fin.Fin (N.Nat^::succ (N.Nat^::succ q)))(s: Generator p (N.Nat^::succ (N.Nat^::succ q))) -> Bounds.Le i j ->
  vertical p q j (vertical p (N.Nat^::succ q) (Fin.widen (N.Nat^::succ (N.Nat^::succ q)) i) s) =
  vertical p q i (vertical p (N.Nat^::succ q) (Fin.succ (N.Nat^::succ (N.Nat^::succ q)) j) s) :=
  \fun (q: N.Nat^)(i, j: Fin.Fin (N.Nat^::succ (N.Nat^::succ q)))(s: Generator p (N.Nat^::succ (N.Nat^::succ q)))(ordered: Bounds.Le i j) =>
    dataExt p q
      (vertical p q j (vertical p (N.Nat^::succ q) (Fin.widen (N.Nat^::succ (N.Nat^::succ q)) i) s))
      (vertical p q i (vertical p (N.Nat^::succ q) (Fin.succ (N.Nat^::succ (N.Nat^::succ q)) j) s)) (\refl((s).vertices)) (Simplices.Identities[].faceIdentity q i j (s).singular ordered);
\definition object: Semisimplicial.Object := Semisimplicial.Object {
  family := family, faces := faces, laws := Semisimplicial.Laws[family, faces] { identity := identity },
};
\import singular_cohomology.SimplicialChains[].On[X := object] \as Chains;
