\import \parent.Bicomplex[] \as Bicomplex;
\import Doubles.Total[C := Bicomplex.complex] \as Total;
\import \parent.NerveDouble[] \as NerveComparison;
\import \parent.SmallDouble[] \as SmallComparison;
\import \parent.Carriers[] \as Carriers;
\import \root.Complex[d := d].On[K := K].Chains[] \as Affine;
\import singular_cohomology.Chains[A := Realization.Carrier, source := Realization.topology] \as Singular;
\import \root.Complex[d := d].On[K := K].Realization[].Stars[] \as Stars;
\import singular_cohomology.Small[A := Realization.Carrier, source := Realization.topology, family := Stars.family] \as Small;
\import singular_cohomology.OpenCover[A := Realization.Carrier, source := Realization.topology].On[cover := Stars.cover] \as Cover;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Native;
\import Native.Equivalence[C := Total.complex, D := Affine.complex] \as Nerve;
\import Native.Equivalence[C := Total.complex, D := Small.complex] \as SmallEquivalences;
\import Native.Equivalence[C := Affine.complex, D := Singular.complex] \as Result;
\definition NerveEquivalence: \Set := \Cast[Nerve.Equivalence] ({ e: Nerve.Equivalence \where #forward{e} = NerveComparison.comparison });
\definition SmallEquivalence: \Set := \Cast[SmallEquivalences.Equivalence] ({ e: SmallEquivalences.Equivalence \where #forward{e} = SmallComparison.comparison });
\module With(nerve: NerveEquivalence, small: SmallEquivalence);
\definition equivalenceExists: \exists { e: Result.Equivalence \where #forward{e} = Affine.comparison } := \block {
  \takefrom nerve: NerveEquivalence \by NerveComparison.equivalenceExists \then
  \takefrom small: SmallEquivalence \by SmallComparison.equivalenceExists \then
  \return Logic.existsIntro[Result.Equivalence, { e: Result.Equivalence \where #forward{e} = Affine.comparison }]
    With[nerve := nerve, small := small].equivalence (\refl(Affine.comparison))
};
