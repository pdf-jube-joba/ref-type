\import Modules.Of[V := Global.Carrier z, space := Global.space z].Submodule[] \as Submodules;
\import Submodules.Image[U := Local.Carrier z, source := Local.space z] \as Images;
\import Complexes.Map[C := Local.complex, D := Global.complex].At[k := z] \as Maps;
\definition inclusion: Modules.Hom[V := Local.Carrier z, W := Global.Carrier z, source := Local.space z, target := Global.space z].Map := Maps.linear Inclusion.map;
\definition image: Submodules.Submodule := Images.image inclusion;
\definition Member[y: Global.Carrier z]: \Prop := Submodules.Member image y;
\definition zero: Member (Global.space z).zero := (image).zero;
\definition introduce: \forall (y: Global.Carrier z)(x: Local.Carrier z) -> (inclusion).apply x = y -> Member y := Images.introduce inclusion;
\definition Values[y: Global.Carrier z]: \Set := \Cast[Local.Carrier z] ({ x: Local.Carrier z \where (inclusion).apply x = y });
\definition unique: \forall (y: Global.Carrier z)(x, w: Values y) -> x = w :=
  \fun (y: Global.Carrier z)(x, w: Values y) => Inclusion.injective z x w
    (trans!{{Global.Carrier z}} _ _ _ (\bysub(Local.Carrier z, Values y, x)) (sym!{{Global.Carrier z}} _ _ (\bysub(Local.Carrier z, Values y, w))));
\definition lift[y: Global.Carrier z][member: Member y]: Values y :=
  \choice Values y \by { existence: member, uniqueness: unique y };
\definition equation: \forall (y: Global.Carrier z)(member: Member y) -> (inclusion).apply (lift y member) = y :=
  \fun (y: Global.Carrier z)(member: Member y) => \bysub(Local.Carrier z, Values y, lift y member);
\definition addition: \forall (y, w: Global.Carrier z)(left: Member y)(right: Member w)(sum: Member ((Global.space z).add y w)) ->
  lift ((Global.space z).add y w) sum = (Local.space z).add (lift y left) (lift w right) :=
  \fun (y, w: Global.Carrier z)(left: Member y)(right: Member w)(sum: Member ((Global.space z).add y w)) =>
    Inclusion.injective z _ _ (trans!{{Global.Carrier z}} _ _ _ (equation _ sum)
      (sym!{{Global.Carrier z}} _ _ (trans!{{Global.Carrier z}} _ _ _ ((inclusion).addition (lift y left) (lift w right))
        (congr2!{{Global.Carrier z} {Global.Carrier z} {Global.Carrier z}} ((Global.space z).add) _ _ _ _ (equation y left) (equation w right)))));
\definition scalar: \forall (a: I.Int^)(y: Global.Carrier z)(member: Member y)(scaled: Member ((Global.space z).smul a y)) ->
  lift ((Global.space z).smul a y) scaled = (Local.space z).smul a (lift y member) :=
  \fun (a: I.Int^)(y: Global.Carrier z)(member: Member y)(scaled: Member ((Global.space z).smul a y)) =>
    Inclusion.injective z _ _ (trans!{{Global.Carrier z}} _ _ _ (equation _ scaled)
      (sym!{{Global.Carrier z}} _ _ (trans!{{Global.Carrier z}} _ _ _ ((inclusion).scalar a (lift y member))
        (congr!{{Global.Carrier z} {Global.Carrier z}} ((Global.space z).smul a) _ _ (equation y member)))));
