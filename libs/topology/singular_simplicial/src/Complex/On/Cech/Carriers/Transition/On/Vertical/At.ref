\import \parent.\parent.\parent.\parent.Singular[q := N.Nat^::succ q, sigma := #singular{s}, z := z] \as Image;
\module Face(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ q))) {
  \import \root.Complex[d := d].On[K := K].Realization[].SimplicialCarrier[n := N.Nat^::succ q, sigma := #singular{s}]
    .Restriction[m := q, f := Geometric.face q i, continuous := Geometric.Faces[n := q].continuous i].Reduced[].Degree[z := z] \as Restriction;
  \definition contained: Image.Member (#apply{linear} (generator p q (Cech.vertical p q i s))) :=
    Restriction.included _ (member (Based.Cell { index := index, simplex := Cech.vertical p q i s }));
}
\definition unsigned: Image.Member (#apply{linear} (#apply{(Bicomplex.vertical p q)} (generator p (N.Nat^::succ q) s))) :=
  \idelim Sum.sum (N.Nat^::succ (N.Nat^::succ q)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ q))) => #apply{linear} (generator p q (Cech.vertical p q i s))) =
    #apply{linear} (#apply{(Bicomplex.vertical p q)} (generator p (N.Nat^::succ q) s)) \with y: Global.Carrier z => Image.Member y \by {
      base: \parent.\parent.\parent.\parent.Sums[z := z].alternating (N.Nat^::succ (N.Nat^::succ q)) Image.image _
        (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ q))) => Face[i := i].contained),
      equality: sym!{{Global.Carrier z}} _ _ (trans!{{Global.Carrier z}} _ _ _
        (congr!{{Carrier p q} {Global.Carrier z}} (#apply{linear}) _ _ (Boundary.onGenerator s))
        (Mapping.law linear (N.Nat^::succ (N.Nat^::succ q)) _))
    };
\definition law: Image.Member (#apply{f} (#apply{(Step.vertical (N.Nat^::succ q) p)} (generator p (N.Nat^::succ q) s))) :=
  \idelim #apply{(GlobalSign.map p)} (#apply{linear} (#apply{(Bicomplex.vertical p q)} (generator p (N.Nat^::succ q) s))) =
    #apply{f} (#apply{(Step.vertical (N.Nat^::succ q) p)} (generator p (N.Nat^::succ q) s)) \with y: Global.Carrier z => Image.Member y \by {
      base: \parent.\parent.\parent.\parent.Sums[z := z].signed p Image.image _ unsigned,
      equality: sym!{{Global.Carrier z}} _ _ (Sign.naturality linear p (#apply{(Bicomplex.vertical p q)} (generator p (N.Nat^::succ q) s)))
    };
