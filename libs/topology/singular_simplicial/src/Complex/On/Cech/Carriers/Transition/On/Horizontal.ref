\import \root.Complex[d := d].On[K := K].Cech[] \as Cech;
\definition index: Doubles.Index n := Doubles.index n p (Step.lowerSecond p q);
\import Modules.Hom[V := Total.Carrier n, W := Global.Carrier z, source := Total.space n, target := Global.space z]
  .Composition[U := Carrier p q, domain := space p q] \as Compose;
\definition linear: Modules.Hom[V := Carrier p q, W := Global.Carrier z, source := space p q, target := Global.space z].Map :=
  Compose.compose f (Total.Degree[n := n].Component[i := index].injection);
\import Cech.Horizontal[q := q] \as Horizontal;
\import singular_cohomology.SimplicialChains[].On[X := Horizontal.object].Boundary[n := p] \as Boundary;
\import Modules.Alternating[V := Carrier p q, space := space p q].Mapping[W := Global.Carrier z, target := Global.space z] \as Mapping;
\import Modules.Alternating[V := Global.Carrier z, space := Global.space z] \as Sum;
\module At(s: Generator (N.Nat^::succ p) q) {
  \import \parent.\parent.\parent.\parent.Singular[q := q, sigma := (s).singular, z := z] \as CarrierImage;
  \definition equation: (f).apply ((Step.horizontal (N.Nat^::succ p) q).apply (generator (N.Nat^::succ p) q s)) =
    Sum.sum (N.Nat^::succ (N.Nat^::succ p)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ p))) => (linear).apply (generator p q (Cech.horizontal p q i s))) :=
    trans!{{Global.Carrier z}} _ _ _
      (congr!{{Carrier p q} {Global.Carrier z}} ((linear).apply) _ _ (Boundary.onGenerator s))
      (Mapping.law linear (N.Nat^::succ (N.Nat^::succ p)) _);
  \definition law: CarrierImage.Member ((f).apply ((Step.horizontal (N.Nat^::succ p) q).apply (generator (N.Nat^::succ p) q s))) :=
    \idelim Sum.sum (N.Nat^::succ (N.Nat^::succ p)) (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ p))) => (linear).apply (generator p q (Cech.horizontal p q i s))) =
      (f).apply ((Step.horizontal (N.Nat^::succ p) q).apply (generator (N.Nat^::succ p) q s)) \with y: Global.Carrier z => CarrierImage.Member y \by {
        base: \parent.\parent.\parent.\parent.Sums[z := z].alternating (N.Nat^::succ (N.Nat^::succ p)) CarrierImage.image _
          (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ p))) => member (Based.Cell { index := index, simplex := Cech.horizontal p q i s })),
        equality: sym!{{Global.Carrier z}} _ _ equation
      };
}
\definition law: \forall (s: Generator (N.Nat^::succ p) q) ->
  \parent.\parent.\parent.Singular[q := q, sigma := (s).singular, z := z].Member
    ((f).apply ((Step.horizontal (N.Nat^::succ p) q).apply (generator (N.Nat^::succ p) q s))) := \fun (s: Generator (N.Nat^::succ p) q) => At[s := s].law;
