\import \root.Complex[d := d].On[K := K].Realization[].SimplicialCarrier[n := N.Nat^::zero, sigma := #singular{s}] \as Carrier;
\import \root.Complex[d := d].On[K := Carrier.complex].Realization[] \as LocalRealization;
\import singular_cohomology.Chains[A := LocalRealization.Carrier, source := LocalRealization.topology] \as Local;
\import singular_cohomology.Maps[A := LocalRealization.Carrier, B := Realization.Carrier, source := LocalRealization.topology, target := Realization.topology] \as Inclusion;
\import \parent.\parent.Cell[n := n, c := Based.Cell { index := NerveComparison.point n, simplex := s }] \as Cell;
\import Cell.Degree[z := degree] \as Image;
\definition common: Carrier.CommonVertices n #vertices{s} :=
  \fun (x: Geometric.Carrier N.Nat^::zero)(i: Fin.Fin (N.Nat^::succ n)) => \root.Complex[d := d].On[K := K].Cech[].common n N.Nat^::zero s x i;
\definition simplex: _ := LocalRealization.simplex n (Carrier.faceSimplex n #vertices{s} common);
\definition value: Local.Carrier n := Local.generator n simplex;
\definition simplexEquation: Inclusion.postcompose n Carrier.inclusion Carrier.continuous simplex = Realization.simplex n #vertices{s} :=
  Simplices.ext n (Inclusion.postcompose n Carrier.inclusion Carrier.continuous simplex) (Realization.simplex n #vertices{s})
    (\fun (x: Geometric.Carrier n) => Carrier.affineComparison n #vertices{s} common x);
\definition included: #apply{Cell.map} degree value = Whole.generator n (Realization.simplex n #vertices{s}) :=
  trans!{{Whole.Carrier n}} _ _ _ (Inclusion.At[n := n].onGenerator Carrier.inclusion Carrier.continuous simplex)
    (congr!{{Simplices.Carrier n} {Whole.Carrier n}} (Whole.generator n) _ _ simplexEquation);
\definition actual: #apply{Actual.second} n (#apply{(Total.Degree[n := n].Component[i := NerveComparison.point n].injection)} (generator n N.Nat^::zero s)) =
  Whole.generator n (Realization.simplex n #vertices{s}) :=
  trans!{{Whole.Carrier n}} _ _ _
    (congr!{{Affine.Carrier n} {Whole.Carrier n}} (#apply{Affine.comparison} n) _ _ (NerveComparison.Generators[n := n].atPoint s))
    (Affine.onGenerator n #vertices{s});
\definition carried: Image.Member (#apply{Actual.second} n (#apply{(Total.Degree[n := n].Component[i := NerveComparison.point n].injection)} (generator n N.Nat^::zero s))) :=
  Image.introduce _ value (trans!{{Whole.Carrier n}} _ _ _ included (sym!{{Whole.Carrier n}} _ _ actual));
