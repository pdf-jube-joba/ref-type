\import \root.Complex[d := d].On[K := K].Realization[].SimplicialCarrier[n := N.Nat^::zero, sigma := (s).singular] \as SimplexCarrier;
\import \root.Complex[d := d].On[K := SimplexCarrier.complex].Realization[] \as LocalRealization;
\import singular_cohomology.Chains[A := LocalRealization.Carrier, source := LocalRealization.topology] \as Local;
\import singular_cohomology.Maps[A := LocalRealization.Carrier, B := Realization.Carrier, source := LocalRealization.topology, target := Realization.topology] \as Inclusion;
\import \parent.\parent.Cell[n := n, c := Based.Cell { index := NerveComparison.point n, simplex := s }] \as Cell;
\import Cell.Degree[z := degree] \as CarrierImage;
\definition common: SimplexCarrier.CommonVertices n (s).vertices :=
  \fun (x: Geometric.Carrier N.Nat^::zero)(i: Fin.Fin (N.Nat^::succ n)) => \root.Complex[d := d].On[K := K].Cech[].common n N.Nat^::zero s x i;
\definition simplex: _ := LocalRealization.simplex n (SimplexCarrier.faceSimplex n (s).vertices common);
\definition value: Local.Carrier n := Local.generator n simplex;
\definition simplexEquation: Inclusion.postcompose n SimplexCarrier.inclusion SimplexCarrier.continuous simplex = Realization.simplex n (s).vertices :=
  Simplices.ext n (Inclusion.postcompose n SimplexCarrier.inclusion SimplexCarrier.continuous simplex) (Realization.simplex n (s).vertices)
    (\fun (x: Geometric.Carrier n) => SimplexCarrier.affineComparison n (s).vertices common x);
\definition included: (Cell.map).apply degree value = Whole.generator n (Realization.simplex n (s).vertices) :=
  trans!{{Whole.Carrier n}} _ _ _ (Inclusion.At[n := n].onGenerator SimplexCarrier.inclusion SimplexCarrier.continuous simplex)
    (congr!{{Simplices.Carrier n} {Whole.Carrier n}} (Whole.generator n) _ _ simplexEquation);
\definition actual: (Actual.second).apply n ((Total.Degree[n := n].Component[i := NerveComparison.point n].injection).apply (generator n N.Nat^::zero s)) =
  Whole.generator n (Realization.simplex n (s).vertices) :=
  trans!{{Whole.Carrier n}} _ _ _
    (congr!{{Affine.Carrier n} {Whole.Carrier n}} ((Affine.comparison).apply n) _ _ (NerveComparison.Generators[n := n].atPoint s))
    (Affine.onGenerator n (s).vertices);
\definition carried: CarrierImage.Member ((Actual.second).apply n ((Total.Degree[n := n].Component[i := NerveComparison.point n].injection).apply (generator n N.Nat^::zero s))) :=
  CarrierImage.introduce _ value (trans!{{Whole.Carrier n}} _ _ _ included (sym!{{Whole.Carrier n}} _ _ actual));
