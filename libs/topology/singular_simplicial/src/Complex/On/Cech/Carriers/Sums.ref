\import Modules.Of[V := Global.Carrier z, space := Global.space z].Submodule[] \as Submodules;
\import Modules.Alternating[V := Global.Carrier z, space := Global.space z] \as Sum;
\definition alternating: \forall (k: N.Nat^)(S: Submodules.Submodule)(f: Fin.Fin k -> Global.Carrier z) ->
  (\forall (i: Fin.Fin k) -> Submodules.Member S (f i)) -> Submodules.Member S (Sum.sum k f) :=
  \induction (k: N.Nat^) \return \forall (S: Submodules.Submodule)(f: Fin.Fin k -> Global.Carrier z) ->
    (\forall (i: Fin.Fin k) -> Submodules.Member S (f i)) -> Submodules.Member S (Sum.sum k f) \with {
      | zero: \fun (S: Submodules.Submodule)(f: Fin.Fin N.Nat^::zero -> Global.Carrier z)(member: _) => (S).zero
      | succ: \fun (k: N.Nat^)(previous: _)(S: Submodules.Submodule)(f: Fin.Fin (N.Nat^::succ k) -> Global.Carrier z)(member: _) =>
        Submodules.differenceClosed S (f (Fin.zero k)) (Sum.sum k (\fun (i: Fin.Fin k) => f (Fin.succ k i)))
          (member (Fin.zero k)) (previous S (\fun (i: Fin.Fin k) => f (Fin.succ k i)) (\fun (i: Fin.Fin k) => member (Fin.succ k i)))
    };
\import Doubles.Sign[V := Global.Carrier z, space := Global.space z] \as Sign;
\definition signed: \forall (p: N.Nat^)(S: Submodules.Submodule)(y: Global.Carrier z) -> Submodules.Member S y -> Submodules.Member S ((Sign.map p).apply y) :=
  \induction (p: N.Nat^) \return \forall (S: Submodules.Submodule)(y: Global.Carrier z) -> Submodules.Member S y -> Submodules.Member S ((Sign.map p).apply y) \with {
    | zero: \fun (S: Submodules.Submodule)(y: Global.Carrier z)(member: Submodules.Member S y) => member
    | succ: \fun (p: N.Nat^)(previous: _)(S: Submodules.Submodule)(y: Global.Carrier z)(member: Submodules.Member S y) =>
      Submodules.negativeClosed S ((Sign.map p).apply y) (previous S y member)
  };
