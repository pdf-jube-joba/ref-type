\import \root.Complex[d := d].On[K := K].Cech[].Carriers[] \as Actual;
\import \parent.\parent.Based[n := n] \as Based;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition degree: I.Int^ := I.Int^::ofNat n;
\module FirstPoint(s: Generator N.Nat^::zero n);
\module SecondPoint(s: Generator n N.Nat^::zero);
\import \root.Complex[d := d].On[K := K].Realization[].Stars[] \as Stars;
\import singular_cohomology.Small[A := Realization.Carrier, source := Realization.topology, family := Stars.family] \as Small;
\import Native.Map[C := Small.complex, D := Whole.complex].At[n := n] \as SmallInclusion;
\import Native.Map[C := Affine.complex, D := Whole.complex].At[n := n] \as AffineMap;
\definition first: \forall (i: Doubles.Index n)(s: Generator #first{i} #second{i}) ->
  \parent.Singular[q := #second{i}, sigma := #singular{s}, z := degree].Member
    (#apply{Actual.first} n (#apply{(Total.Degree[n := n].Component[i := i].injection)} (generator #first{i} #second{i} s))) :=
  \fun (i: Doubles.Index n) => either!{{(Classical.excludedMiddle (i = SmallComparison.point n))}
    {\forall (s: Generator #first{i} #second{i}) -> \parent.Singular[q := #second{i}, sigma := #singular{s}, z := degree].Member
      (#apply{Actual.first} n (#apply{(Total.Degree[n := n].Component[i := i].injection)} (generator #first{i} #second{i} s)))}
    {\fun (equal: i = SmallComparison.point n) => \idelim SmallComparison.point n = i \with j: Doubles.Index n =>
      \forall (s: Generator #first{j} #second{j}) -> \parent.Singular[q := #second{j}, sigma := #singular{s}, z := degree].Member
        (#apply{Actual.first} n (#apply{(Total.Degree[n := n].Component[i := j].injection)} (generator #first{j} #second{j} s))) \by {
          base: \fun (s: Generator N.Nat^::zero n) => FirstPoint[s := s].carried, equality: sym!{{Doubles.Index n}} _ _ equal
        }}
    {\fun (different: Logic.Not (i = SmallComparison.point n))(s: Generator #first{i} #second{i}) =>
      \idelim #zero{(Whole.space n)} = #apply{Actual.first} n
        (#apply{(Total.Degree[n := n].Component[i := i].injection)} (generator #first{i} #second{i} s)) \with y: Whole.Carrier n =>
          \parent.Singular[q := #second{i}, sigma := #singular{s}, z := degree].Member y \by {
            base: #zero{(\parent.Singular[q := #second{i}, sigma := #singular{s}, z := degree].image)},
            equality: sym!{{Whole.Carrier n}} _ _ (trans!{{Whole.Carrier n}} _ _ _
              (congr!{{Small.Carrier n} {Whole.Carrier n}} (#apply{Small.inclusion} n) _ _
                (SmallComparison.Generators[n := n].other i different (generator #first{i} #second{i} s)))
              (SmallInclusion.zeroPreserved Small.inclusion))
          }}
  };
\definition second: \forall (i: Doubles.Index n)(s: Generator #first{i} #second{i}) ->
  \parent.Singular[q := #second{i}, sigma := #singular{s}, z := degree].Member
    (#apply{Actual.second} n (#apply{(Total.Degree[n := n].Component[i := i].injection)} (generator #first{i} #second{i} s))) :=
  \fun (i: Doubles.Index n) => either!{{(Classical.excludedMiddle (i = NerveComparison.point n))}
    {\forall (s: Generator #first{i} #second{i}) -> \parent.Singular[q := #second{i}, sigma := #singular{s}, z := degree].Member
      (#apply{Actual.second} n (#apply{(Total.Degree[n := n].Component[i := i].injection)} (generator #first{i} #second{i} s)))}
    {\fun (equal: i = NerveComparison.point n) => \idelim NerveComparison.point n = i \with j: Doubles.Index n =>
      \forall (s: Generator #first{j} #second{j}) -> \parent.Singular[q := #second{j}, sigma := #singular{s}, z := degree].Member
        (#apply{Actual.second} n (#apply{(Total.Degree[n := n].Component[i := j].injection)} (generator #first{j} #second{j} s))) \by {
          base: \fun (s: Generator n N.Nat^::zero) => SecondPoint[s := s].carried, equality: sym!{{Doubles.Index n}} _ _ equal
        }}
    {\fun (different: Logic.Not (i = NerveComparison.point n))(s: Generator #first{i} #second{i}) =>
      \idelim #zero{(Whole.space n)} = #apply{Actual.second} n
        (#apply{(Total.Degree[n := n].Component[i := i].injection)} (generator #first{i} #second{i} s)) \with y: Whole.Carrier n =>
          \parent.Singular[q := #second{i}, sigma := #singular{s}, z := degree].Member y \by {
            base: #zero{(\parent.Singular[q := #second{i}, sigma := #singular{s}, z := degree].image)},
            equality: sym!{{Whole.Carrier n}} _ _ (trans!{{Whole.Carrier n}} _ _ _
              (congr!{{Affine.Carrier n} {Whole.Carrier n}} (#apply{Affine.comparison} n) _ _
                (NerveComparison.Generators[n := n].other i different (generator #first{i} #second{i} s)))
              (AffineMap.zeroPreserved Affine.comparison))
          }}
  };
