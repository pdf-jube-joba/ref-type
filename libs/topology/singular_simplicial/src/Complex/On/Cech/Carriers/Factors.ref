\import \root.Complex[d := d].On[K := K].Cech[].Carriers[] \as Actual;
\import \parent.\parent.Based[n := n] \as Based;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition degree: I.Int^ := I.Int^::ofNat n;
\import \root.Complex[d := d].On[K := K].Realization[].Stars[] \as Stars;
\import singular_cohomology.Small[A := Realization.Carrier, source := Realization.topology, family := Stars.family] \as Small;
\import Native.Map[C := Small.complex, D := Whole.complex].At[n := n] \as SmallInclusion;
\import Native.Map[C := Affine.complex, D := Whole.complex].At[n := n] \as AffineMap;
\module FirstPoint(s: Generator N.Nat^::zero n);
\module SecondPoint(s: Generator n N.Nat^::zero);
\definition first: \forall (i: Doubles.Index n)(s: Generator (i).first (i).second) ->
  \parent.Singular[q := (i).second, sigma := (s).singular, z := degree].Member
    ((Actual.first).apply n ((Total.Degree[n := n].Component[i := i].injection).apply (generator (i).first (i).second s))) :=
  \fun (i: Doubles.Index n) => (Logic.orElim _ _ (\forall (s: Generator (i).first (i).second) -> \parent.Singular[q := (i).second, sigma := (s).singular, z := degree].Member
      ((Actual.first).apply n ((Total.Degree[n := n].Component[i := i].injection).apply (generator (i).first (i).second s)))) ((Classical.excludedMiddle (i = SmallComparison.point n)))
      (\fun (equal: i = SmallComparison.point n) => \idelim SmallComparison.point n = i \with j: Doubles.Index n =>
      \forall (s: Generator (j).first (j).second) -> \parent.Singular[q := (j).second, sigma := (s).singular, z := degree].Member
        ((Actual.first).apply n ((Total.Degree[n := n].Component[i := j].injection).apply (generator (j).first (j).second s))) \by {
          base: \fun (s: Generator N.Nat^::zero n) => FirstPoint[s := s].carried, equality: sym!{{Doubles.Index n}} _ _ equal
        })
      (\fun (different: Logic.Not (i = SmallComparison.point n))(s: Generator (i).first (i).second) =>
      \idelim (Whole.space n).zero = (Actual.first).apply n
        ((Total.Degree[n := n].Component[i := i].injection).apply (generator (i).first (i).second s)) \with y: Whole.Carrier n =>
          \parent.Singular[q := (i).second, sigma := (s).singular, z := degree].Member y \by {
            base: (\parent.Singular[q := (i).second, sigma := (s).singular, z := degree].image).zero,
            equality: sym!{{Whole.Carrier n}} _ _ (trans!{{Whole.Carrier n}} _ _ _
              (congr!{{Small.Carrier n} {Whole.Carrier n}} ((Small.inclusion).apply n) _ _
                (SmallComparison.Generators[n := n].other i different (generator (i).first (i).second s)))
              (SmallInclusion.zeroPreserved Small.inclusion))
          }));
\definition second: \forall (i: Doubles.Index n)(s: Generator (i).first (i).second) ->
  \parent.Singular[q := (i).second, sigma := (s).singular, z := degree].Member
    ((Actual.second).apply n ((Total.Degree[n := n].Component[i := i].injection).apply (generator (i).first (i).second s))) :=
  \fun (i: Doubles.Index n) => (Logic.orElim _ _ (\forall (s: Generator (i).first (i).second) -> \parent.Singular[q := (i).second, sigma := (s).singular, z := degree].Member
      ((Actual.second).apply n ((Total.Degree[n := n].Component[i := i].injection).apply (generator (i).first (i).second s)))) ((Classical.excludedMiddle (i = NerveComparison.point n)))
      (\fun (equal: i = NerveComparison.point n) => \idelim NerveComparison.point n = i \with j: Doubles.Index n =>
      \forall (s: Generator (j).first (j).second) -> \parent.Singular[q := (j).second, sigma := (s).singular, z := degree].Member
        ((Actual.second).apply n ((Total.Degree[n := n].Component[i := j].injection).apply (generator (j).first (j).second s))) \by {
          base: \fun (s: Generator n N.Nat^::zero) => SecondPoint[s := s].carried, equality: sym!{{Doubles.Index n}} _ _ equal
        })
      (\fun (different: Logic.Not (i = NerveComparison.point n))(s: Generator (i).first (i).second) =>
      \idelim (Whole.space n).zero = (Actual.second).apply n
        ((Total.Degree[n := n].Component[i := i].injection).apply (generator (i).first (i).second s)) \with y: Whole.Carrier n =>
          \parent.Singular[q := (i).second, sigma := (s).singular, z := degree].Member y \by {
            base: (\parent.Singular[q := (i).second, sigma := (s).singular, z := degree].image).zero,
            equality: sym!{{Whole.Carrier n}} _ _ (trans!{{Whole.Carrier n}} _ _ _
              (congr!{{Affine.Carrier n} {Whole.Carrier n}} ((Affine.comparison).apply n) _ _
                (NerveComparison.Generators[n := n].other i different (generator (i).first (i).second s)))
              (AffineMap.zeroPreserved Affine.comparison))
          }));
