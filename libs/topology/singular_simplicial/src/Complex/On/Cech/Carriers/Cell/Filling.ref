\definition degree: I.Int^ := I.Int^::ofNat n;
\definition next: I.Int^ := I.Int^::ofNat (N.Nat^::succ n);
\import singular_cohomology.Calculations[A := LocalRealization.Carrier, source := LocalRealization.topology].ReducedContractible[]
  .Filling[z := degree, contraction := contraction] \as Fill;
\import Complexes.At[C := Local.complex, z := degree] \as Homology;
\definition map: Modules.Hom[V := Local.Carrier degree, W := Local.Carrier next, source := Local.space degree, target := Local.space next].Map := Fill.map;
\import std.Logic[].Equality[].Transport[A := I.Int^] \as Transport;
\definition prior: \forall (y: Local.Carrier next) -> (Homology.prior).apply y = (Local.differential).apply next y :=
  \fun (y: Local.Carrier next) => Transport.castRefl Local.Carrier degree ((Local.differential).apply next y);
\definition boundary: \forall (x: Local.Carrier degree) ->
  (Local.differential).apply degree x = (Local.space (Degrees.previous degree)).zero ->
  (Local.differential).apply next ((map).apply x) = x :=
  \fun (x: Local.Carrier degree)(closed: (Local.differential).apply degree x = (Local.space (Degrees.previous degree)).zero) =>
    trans!{{Local.Carrier degree}} _ _ _ (sym!{{Local.Carrier degree}} _ _ (prior ((map).apply x))) (Fill.boundary (Homology.cycle x closed));
