\definition horizontal: N.Nat^ := ((c).index).first;
\definition vertical: N.Nat^ := ((c).index).second;
\definition sigma: Simplices.Carrier vertical := ((c).simplex).singular;
\import \root.Complex[d := d].On[K := K].Realization[].SimplicialCarrier[n := vertical, sigma := sigma] \as SimplexCarrier;
\import \root.Complex[d := d].On[K := SimplexCarrier.complex].Realization[] \as LocalRealization;
\import singular_cohomology.Chains[A := LocalRealization.Carrier, source := LocalRealization.topology].Reduced[] \as Local;
\import SimplexCarrier.Chains[].Reduced[] \as Inclusion;
\definition localComplex: Complexes.Complex := Local.complex;
\definition localCarrier: I.Int^ -> \Set := Local.Carrier;
\definition localSpace: \forall (z: I.Int^) -> Modules.Space (localCarrier z) := Local.space;
\definition map: Complexes.Map[C := localComplex, D := Global.complex].Map := Inclusion.map;
\definition injective: \forall (z: I.Int^)(x, y: localCarrier z) -> (map).apply z x = (map).apply z y -> x = y := Inclusion.injective;
\definition contraction: algebraic_topology.Contraction[A := LocalRealization.Carrier, source := LocalRealization.topology].Data :=
  SimplexCarrier.At[a := ((c).simplex).vertices (Fin.zero horizontal)].contraction
    (\fun (x: Geometric.Carrier vertical) => common horizontal vertical (c).simplex x (Fin.zero horizontal));
\module Degree(z: I.Int^);
\module Filling;
