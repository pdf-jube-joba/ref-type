\definition degree: N.Nat^ := N.Nat^::zero;
\import \parent.\parent.Based[n := degree] \as Based;
\import Whole.Augmentation[] \as Augmentation;
\import Modules.Hom[V := Whole.Carrier degree, W := I.Int^, source := Whole.space degree, target := Modules.scalarModule]
  .Composition[U := Total.Carrier degree, domain := Total.space degree] \as Compose;
\import Native.Map[C := Total.complex, D := Whole.complex].At[n := degree] \as Degree;
\definition firstMap: _ := Compose.compose Augmentation.map (Degree.linear first);
\definition secondMap: _ := Compose.compose Augmentation.map (Degree.linear second);
\definition atPoint: \forall (s: Generator degree degree) ->
  #apply{firstMap} (#apply{(Total.Degree[n := degree].Component[i := SmallComparison.point degree].injection)} (generator degree degree s)) =
  #apply{secondMap} (#apply{(Total.Degree[n := degree].Component[i := SmallComparison.point degree].injection)} (generator degree degree s)) :=
  \fun (s: Generator degree degree) => trans!{I.Int^} _ _ _
    (congr!{{Whole.Carrier degree} {I.Int^}} (#apply{Augmentation.map}) _ _ (\parent.Factors[n := degree].FirstPoint[s := s].actual))
    (trans!{I.Int^} _ _ _ (Augmentation.onGenerator #singular{s})
      (sym!{I.Int^} _ _ (trans!{I.Int^} _ _ _
        (congr!{{Whole.Carrier degree} {I.Int^}} (#apply{Augmentation.map}) _ _ (\parent.Factors[n := degree].SecondPoint[s := s].actual))
        (Augmentation.onGenerator (Realization.simplex degree #vertices{s})))));
\definition zeroIndex(i: Doubles.Index degree): i = SmallComparison.point degree :=
  SmallComparison.zeroIndex degree i (Bounds.leZeroEq #first{i} (Doubles.firstBound degree i));
\definition onIndex: \forall (i: Doubles.Index degree)(s: Generator #first{i} #second{i}) ->
  #apply{firstMap} (#apply{(Total.Degree[n := degree].Component[i := i].injection)} (generator #first{i} #second{i} s)) =
  #apply{secondMap} (#apply{(Total.Degree[n := degree].Component[i := i].injection)} (generator #first{i} #second{i} s)) :=
  \fun (i: Doubles.Index degree) => \idelim SmallComparison.point degree = i \with j: Doubles.Index degree =>
    \forall (s: Generator #first{j} #second{j}) ->
      #apply{firstMap} (#apply{(Total.Degree[n := degree].Component[i := j].injection)} (generator #first{j} #second{j} s)) =
      #apply{secondMap} (#apply{(Total.Degree[n := degree].Component[i := j].injection)} (generator #first{j} #second{j} s)) \by {
        base: atPoint, equality: sym!{{Doubles.Index degree}} _ _ (zeroIndex i)
      };
\import Based.To[W := I.Int^, target := Modules.scalarModule] \as Free;
\definition equality: firstMap = secondMap := Free.ext firstMap secondMap (\fun (c: Based.Cell) => onIndex #index{c} #simplex{c});
\import Modules.Hom[V := Total.Carrier degree, W := I.Int^, source := Total.space degree, target := Modules.scalarModule] \as Maps;
\definition law: \forall (x: Total.Carrier degree) -> #apply{Augmentation.map} (#apply{first} degree x) = #apply{Augmentation.map} (#apply{second} degree x) :=
  \fun (x: Total.Carrier degree) => congr!{{Maps.Map} {I.Int^}} (\fun (f: Maps.Map) => #apply{f} x) firstMap secondMap equality;
\import Modules.Hom[V := Whole.Carrier degree, W := I.Int^, source := Whole.space degree, target := Modules.scalarModule] \as Augmentations;
\import algebra.Group[].Of[Carrier := I.Int^, group := Modules.scalarGroup] \as Group;
\definition differenceZero: \forall (x: Total.Carrier degree) -> #apply{Augmentation.map} (#apply{difference} degree x) = #zero{Modules.scalarModule} :=
  \fun (x: Total.Carrier degree) => trans!{I.Int^} _ _ _
    (Augmentations.differencePreserved Augmentation.map (#apply{first} degree x) (#apply{second} degree x))
    (trans!{I.Int^} _ _ _ (congr!{I.Int^ I.Int^} (\fun (y: I.Int^) => Group.difference y (#apply{Augmentation.map} (#apply{second} degree x))) _ _ (law x))
      (Group.inverseRight (#apply{Augmentation.map} (#apply{second} degree x))));
