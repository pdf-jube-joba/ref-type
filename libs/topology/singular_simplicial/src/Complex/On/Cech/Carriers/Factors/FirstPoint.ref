\import \root.Complex[d := d].On[K := K].Realization[].SimplicialCarrier[n := n, sigma := #singular{s}] \as SimplexCarrier;
\import \root.Complex[d := d].On[K := SimplexCarrier.complex].Realization[] \as LocalRealization;
\import singular_cohomology.Chains[A := LocalRealization.Carrier, source := LocalRealization.topology] \as Local;
\import singular_cohomology.Maps[A := LocalRealization.Carrier, B := Realization.Carrier, source := LocalRealization.topology, target := Realization.topology] \as Inclusion;
\import \parent.\parent.Cell[n := n, c := Based.Cell { index := SmallComparison.point n, simplex := s }] \as Cell;
\import Cell.Degree[z := degree] \as CarrierImage;
\definition value: Local.Carrier n := Local.generator n SimplexCarrier.simplex;
\definition simplexEquation: Inclusion.postcompose n SimplexCarrier.inclusion SimplexCarrier.continuous SimplexCarrier.simplex = #singular{s} :=
  Simplices.ext n (Inclusion.postcompose n SimplexCarrier.inclusion SimplexCarrier.continuous SimplexCarrier.simplex) #singular{s}
    (\fun (x: Geometric.Carrier n) => \refl(#singular{s} x));
\definition included: #apply{Cell.map} degree value = Whole.generator n #singular{s} :=
  trans!{{Whole.Carrier n}} _ _ _ (Inclusion.At[n := n].onGenerator SimplexCarrier.inclusion SimplexCarrier.continuous SimplexCarrier.simplex)
    (congr!{{Simplices.Carrier n} {Whole.Carrier n}} (Whole.generator n) _ _ simplexEquation);
\import singular_cohomology.Small[A := Realization.Carrier, source := Realization.topology, family := Stars.family].At[n := n] \as SmallDegree;
\definition actual: #apply{Actual.first} n (#apply{(Total.Degree[n := n].Component[i := SmallComparison.point n].injection)} (generator N.Nat^::zero n s)) = Whole.generator n #singular{s} :=
  trans!{{Whole.Carrier n}} _ _ _
    (congr!{{Small.Carrier n} {Whole.Carrier n}} (#apply{Small.inclusion} n) _ _ (SmallComparison.Generators[n := n].atPoint s))
    (SmallDegree.onGenerator (\root.Complex[d := d].On[K := K].Cech[].SmallAugmentation[].label n s));
\definition carried: CarrierImage.Member (#apply{Actual.first} n (#apply{(Total.Degree[n := n].Component[i := SmallComparison.point n].injection)} (generator N.Nat^::zero n s))) :=
  CarrierImage.introduce _ value (trans!{{Whole.Carrier n}} _ _ _ included (sym!{{Whole.Carrier n}} _ _ actual));
