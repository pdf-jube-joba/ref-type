\import \root.Complex[d := d].On[K := K].Cech[] \as Cech;
\definition index: Doubles.Index n := Doubles.reverseIndex n q (Step.lowerFirst q p);
\import Modules.Hom[V := Total.Carrier n, W := Global.Carrier z, source := Total.space n, target := Global.space z]
  .Composition[U := Carrier p q, domain := space p q] \as Compose;
\definition linear: Modules.Hom[V := Carrier p q, W := Global.Carrier z, source := space p q, target := Global.space z].Map :=
  Compose.compose f (Total.Degree[n := n].Component[i := index].injection);
\import Cech.Vertical[p := p] \as Vertical;
\import singular_cohomology.SimplicialChains[].On[X := Vertical.object].Boundary[n := q] \as Boundary;
\import Modules.Alternating[V := Carrier p q, space := space p q].Mapping[W := Global.Carrier z, target := Global.space z] \as Mapping;
\import Modules.Alternating[V := Global.Carrier z, space := Global.space z] \as Sum;
\import Doubles.Sign[V := Carrier p q, space := space p q].Mapping[W := Global.Carrier z, target := Global.space z] \as Sign;
\import Doubles.Sign[V := Global.Carrier z, space := Global.space z] \as GlobalSign;
\module At(s: Generator p (N.Nat^::succ q));
\definition law: \forall (s: Generator p (N.Nat^::succ q)) ->
  \parent.\parent.\parent.Singular[q := N.Nat^::succ q, sigma := #singular{s}, z := z].Member
    (#apply{f} (#apply{(Step.vertical (N.Nat^::succ q) p)} (generator p (N.Nat^::succ q) s))) := \fun (s: Generator p (N.Nat^::succ q)) => At[s := s].law;
