\module Horizontal(p: N.Nat^, q: Doubles.Second (N.Nat^::succ n) (N.Nat^::succ p));
\definition horizontal: \forall (p: N.Nat^)(q: Doubles.Second (N.Nat^::succ n) p)(s: Generator p q) ->
  \parent.\parent.Singular[q := q, sigma := #singular{s}, z := z].Member
    (#apply{f} (#apply{(Step.horizontal p q)} (generator p q s))) :=
  \induction (p: N.Nat^) \return \forall (q: Doubles.Second (N.Nat^::succ n) p)(s: Generator p q) ->
    \parent.\parent.Singular[q := q, sigma := #singular{s}, z := z].Member
      (#apply{f} (#apply{(Step.horizontal p q)} (generator p q s))) \with {
        | zero: \fun (q: Doubles.Second (N.Nat^::succ n) N.Nat^::zero)(s: Generator N.Nat^::zero q) =>
          \idelim #zero{(Global.space z)} = #apply{f} #zero{(Total.space n)} \with y: Global.Carrier z =>
            \parent.\parent.Singular[q := q, sigma := #singular{s}, z := z].Member y \by {
              base: #zero{(\parent.\parent.Singular[q := q, sigma := #singular{s}, z := z].image)},
              equality: sym!{{Global.Carrier z}} _ _ (Algebra.HomAt[n := n, z := z].zeroPreserved f)
            }
        | succ: \fun (p: N.Nat^)(previous: _)(q: Doubles.Second (N.Nat^::succ n) (N.Nat^::succ p)) => Horizontal[p := p, q := q].law
      };
\module Vertical(q: N.Nat^, p: Doubles.First (N.Nat^::succ n) (N.Nat^::succ q));
\definition vertical: \forall (q: N.Nat^)(p: Doubles.First (N.Nat^::succ n) q)(s: Generator p q) ->
  \parent.\parent.Singular[q := q, sigma := #singular{s}, z := z].Member
    (#apply{f} (#apply{(Step.vertical q p)} (generator p q s))) :=
  \induction (q: N.Nat^) \return \forall (p: Doubles.First (N.Nat^::succ n) q)(s: Generator p q) ->
    \parent.\parent.Singular[q := q, sigma := #singular{s}, z := z].Member
      (#apply{f} (#apply{(Step.vertical q p)} (generator p q s))) \with {
        | zero: \fun (p: Doubles.First (N.Nat^::succ n) N.Nat^::zero)(s: Generator p N.Nat^::zero) =>
          \idelim #zero{(Global.space z)} = #apply{f} #zero{(Total.space n)} \with y: Global.Carrier z =>
            \parent.\parent.Singular[q := N.Nat^::zero, sigma := #singular{s}, z := z].Member y \by {
              base: #zero{(\parent.\parent.Singular[q := N.Nat^::zero, sigma := #singular{s}, z := z].image)},
              equality: sym!{{Global.Carrier z}} _ _ (Algebra.HomAt[n := n, z := z].zeroPreserved f)
            }
        | succ: \fun (q: N.Nat^)(previous: _)(p: Doubles.First (N.Nat^::succ n) (N.Nat^::succ q)) => Vertical[q := q, p := p].law
      };
\module At(c: Higher.Cell) {
  \import \parent.\parent.\parent.Singular[q := #second{#index{c}}, sigma := #singular{#simplex{c}}, z := z] \as Image;
  \definition law: Image.Member (#apply{(Algebra.Transition[n := n, z := z].value f)} (Higher.generator c)) :=
    \idelim #add{(Global.space z)}
      (#apply{f} (#apply{(Step.horizontal #first{#index{c}} (Step.Component[i := #index{c}].q))} (generator #first{#index{c}} #second{#index{c}} #simplex{c})))
      (#apply{f} (#apply{(Step.vertical #second{#index{c}} (Step.Component[i := #index{c}].p))} (generator #first{#index{c}} #second{#index{c}} #simplex{c}))) =
      #apply{f} (#apply{Total.differential} n (Higher.generator c)) \with y: Global.Carrier z => Image.Member y \by {
        base: #addition{Image.image} _ _
          (horizontal #first{#index{c}} (Step.Component[i := #index{c}].q) #simplex{c})
          (vertical #second{#index{c}} (Step.Component[i := #index{c}].p) #simplex{c}),
        equality: sym!{{Global.Carrier z}} _ _ (trans!{{Global.Carrier z}} _ _ _
          (congr!{{Total.Carrier n} {Global.Carrier z}} (#apply{f}) _ _ (Step.onComponent #index{c} (generator #first{#index{c}} #second{#index{c}} #simplex{c})))
          (#addition{f} _ _))
      };
}
\definition law: Target.Member (Algebra.Transition[n := n, z := z].value f) := \fun (c: Higher.Cell) => At[c := c].law;
