\module Horizontal(p: N.Nat^, q: Doubles.Second (N.Nat^::succ n) (N.Nat^::succ p));
\definition horizontal: \forall (p: N.Nat^)(q: Doubles.Second (N.Nat^::succ n) p)(s: Generator p q) ->
  \parent.\parent.Singular[q := q, sigma := (s).singular, z := z].Member
    ((f).apply ((Step.horizontal p q).apply (generator p q s))) :=
  \induction (p: N.Nat^) \return \forall (q: Doubles.Second (N.Nat^::succ n) p)(s: Generator p q) ->
    \parent.\parent.Singular[q := q, sigma := (s).singular, z := z].Member
      ((f).apply ((Step.horizontal p q).apply (generator p q s))) \with {
        | zero: \fun (q: Doubles.Second (N.Nat^::succ n) N.Nat^::zero)(s: Generator N.Nat^::zero q) =>
          \idelim (Global.space z).zero = (f).apply (Total.space n).zero \with y: Global.Carrier z =>
            \parent.\parent.Singular[q := q, sigma := (s).singular, z := z].Member y \by {
              base: (\parent.\parent.Singular[q := q, sigma := (s).singular, z := z].image).zero,
              equality: sym!{{Global.Carrier z}} _ _ (Algebra.HomAt[n := n, z := z].zeroPreserved f)
            }
        | succ: \fun (p: N.Nat^)(previous: _)(q: Doubles.Second (N.Nat^::succ n) (N.Nat^::succ p)) => Horizontal[p := p, q := q].law
      };
\module Vertical(q: N.Nat^, p: Doubles.First (N.Nat^::succ n) (N.Nat^::succ q));
\definition vertical: \forall (q: N.Nat^)(p: Doubles.First (N.Nat^::succ n) q)(s: Generator p q) ->
  \parent.\parent.Singular[q := q, sigma := (s).singular, z := z].Member
    ((f).apply ((Step.vertical q p).apply (generator p q s))) :=
  \induction (q: N.Nat^) \return \forall (p: Doubles.First (N.Nat^::succ n) q)(s: Generator p q) ->
    \parent.\parent.Singular[q := q, sigma := (s).singular, z := z].Member
      ((f).apply ((Step.vertical q p).apply (generator p q s))) \with {
        | zero: \fun (p: Doubles.First (N.Nat^::succ n) N.Nat^::zero)(s: Generator p N.Nat^::zero) =>
          \idelim (Global.space z).zero = (f).apply (Total.space n).zero \with y: Global.Carrier z =>
            \parent.\parent.Singular[q := N.Nat^::zero, sigma := (s).singular, z := z].Member y \by {
              base: (\parent.\parent.Singular[q := N.Nat^::zero, sigma := (s).singular, z := z].image).zero,
              equality: sym!{{Global.Carrier z}} _ _ (Algebra.HomAt[n := n, z := z].zeroPreserved f)
            }
        | succ: \fun (q: N.Nat^)(previous: _)(p: Doubles.First (N.Nat^::succ n) (N.Nat^::succ q)) => Vertical[q := q, p := p].law
      };
\module At(c: Higher.Cell) {
  \import \parent.\parent.\parent.Singular[q := ((c).index).second, sigma := ((c).simplex).singular, z := z] \as CarrierImage;
  \definition law: CarrierImage.Member ((Algebra.Transition[n := n, z := z].value f).apply (Higher.generator c)) :=
    \idelim (Global.space z).add
      ((f).apply ((Step.horizontal ((c).index).first (Step.Component[i := (c).index].q)).apply (generator ((c).index).first ((c).index).second (c).simplex)))
      ((f).apply ((Step.vertical ((c).index).second (Step.Component[i := (c).index].p)).apply (generator ((c).index).first ((c).index).second (c).simplex))) =
      (f).apply ((Total.differential).apply n (Higher.generator c)) \with y: Global.Carrier z => CarrierImage.Member y \by {
        base: (CarrierImage.image).addition _ _
          (horizontal ((c).index).first (Step.Component[i := (c).index].q) (c).simplex)
          (vertical ((c).index).second (Step.Component[i := (c).index].p) (c).simplex),
        equality: sym!{{Global.Carrier z}} _ _ (trans!{{Global.Carrier z}} _ _ _
          (congr!{{Total.Carrier n} {Global.Carrier z}} ((f).apply) _ _ (Step.onComponent (c).index (generator ((c).index).first ((c).index).second (c).simplex)))
          ((f).addition _ _))
      };
}
\definition law: Target.Member (Algebra.Transition[n := n, z := z].value f) := \fun (c: Higher.Cell) => At[c := c].law;
