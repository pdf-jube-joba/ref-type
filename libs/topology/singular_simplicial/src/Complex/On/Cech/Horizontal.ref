\definition family: Semisimplicial.Family := Semisimplicial.Family { Carrier := \fun (p: N.Nat^) => Generator p q };
\definition faces: Semisimplicial.Faces[family] := Semisimplicial.Faces[family] { apply := \fun (p: N.Nat^) => horizontal p q };
\definition identity: \forall (p: N.Nat^)(i, j: Fin.Fin (N.Nat^::succ (N.Nat^::succ p)))(s: Generator (N.Nat^::succ (N.Nat^::succ p)) q) -> Bounds.Le i j ->
  horizontal p q j (horizontal (N.Nat^::succ p) q (Fin.widen (N.Nat^::succ (N.Nat^::succ p)) i) s) =
  horizontal p q i (horizontal (N.Nat^::succ p) q (Fin.succ (N.Nat^::succ (N.Nat^::succ p)) j) s) :=
  \fun (p: N.Nat^)(i, j: Fin.Fin (N.Nat^::succ (N.Nat^::succ p)))(s: Generator (N.Nat^::succ (N.Nat^::succ p)) q)(ordered: Bounds.Le i j) =>
    dataExt p q
      (horizontal p q j (horizontal (N.Nat^::succ p) q (Fin.widen (N.Nat^::succ (N.Nat^::succ p)) i) s))
      (horizontal p q i (horizontal (N.Nat^::succ p) q (Fin.succ (N.Nat^::succ (N.Nat^::succ p)) j) s)) (Faces.identity p i j #vertices{s} ordered) (\refl(#singular{s}));
\definition object: Semisimplicial.Object := Semisimplicial.Object {
  family := family, faces := faces, laws := Semisimplicial.Laws[family, faces] { identity := identity },
};
\import singular_cohomology.SimplicialChains[].On[X := object] \as Chains;
