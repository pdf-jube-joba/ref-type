\import \root.Complex[d := d].On[K := K].Cech[] \as Cech;
\import \parent.\parent.Horizontal[q := q] \as Horizontal;
\import singular_cohomology.SimplicialChains[].On[X := Horizontal.object] \as Native;
\import Native.Boundary[n := N.Nat^::zero] \as Boundary;
\import Modules.Alternating[V := Carrier N.Nat^::zero q, space := space N.Nat^::zero q].Mapping[W := Small.Carrier q, target := Small.space q] \as Mapping;
\import Modules.Alternating[V := Small.Carrier q, space := Small.space q] \as Sum;
\import Modules.Laws[V := Small.Carrier q, space := Small.space q] \as Vector;
\import algebra.Group[].Of[Carrier := Small.Carrier q, group := Vector.additive] \as Group;
\import Modules.Hom[V := Carrier N.Nat^::zero q, W := Small.Carrier q, source := space N.Nat^::zero q, target := Small.space q]
  .Composition[U := Carrier (N.Nat^::succ N.Nat^::zero) q, domain := space (N.Nat^::succ N.Nat^::zero) q] \as Compose;
\import Modules.Hom[V := Carrier (N.Nat^::succ N.Nat^::zero) q, W := Small.Carrier q, source := space (N.Nat^::succ N.Nat^::zero) q, target := Small.space q] \as Linear;
\import Modules.Free[Generators := Generator (N.Nat^::succ N.Nat^::zero) q].To[W := Small.Carrier q, target := Small.space q] \as Free;
\definition composed: Linear.Map := Compose.compose (data N.Nat^::zero q) (Source.horizontal N.Nat^::zero q);
\definition label[s: Generator (N.Nat^::succ N.Nat^::zero) q]: _ := Augmentation.label q (Cech.horizontal N.Nat^::zero q (Fin.zero (N.Nat^::succ N.Nat^::zero)) s);
\definition onGenerator: \forall (s: Generator (N.Nat^::succ N.Nat^::zero) q) ->
  (composed).apply (generator (N.Nat^::succ N.Nat^::zero) q s) = (Small.space q).zero :=
  \fun (s: Generator (N.Nat^::succ N.Nat^::zero) q) => trans!{{Small.Carrier q}} _ _ _
    (congr!{{Carrier N.Nat^::zero q} {Small.Carrier q}} ((data N.Nat^::zero q).apply) _ _ (Boundary.onGenerator s))
    (trans!{{Small.Carrier q}} _ _ _ (Mapping.law (data N.Nat^::zero q) (N.Nat^::succ (N.Nat^::succ N.Nat^::zero)) _)
      (trans!{{Small.Carrier q}} _ _ _
        (Sum.congruent (N.Nat^::succ (N.Nat^::succ N.Nat^::zero)) _ (\fun (_: Fin.Fin (N.Nat^::succ (N.Nat^::succ N.Nat^::zero))) => Small.generator q (label s))
          (\fun (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ N.Nat^::zero))) => Augmentation.onGenerator q (Cech.horizontal N.Nat^::zero q i s)))
        (Group.subtractDifference (Small.generator q (label s)) (Small.space q).zero)));
\definition equation: composed = Linear.zeroMap := Free.ext composed Linear.zeroMap onGenerator;
\definition all: \forall (x: Carrier (N.Nat^::succ N.Nat^::zero) q) ->
  (data N.Nat^::zero q).apply ((Source.horizontal N.Nat^::zero q).apply x) = (Small.space q).zero :=
  \fun (x: Carrier (N.Nat^::succ N.Nat^::zero) q) => congr!{{Linear.Map} {Small.Carrier q}} (\fun (f: Linear.Map) => (f).apply x) composed Linear.zeroMap equation;
