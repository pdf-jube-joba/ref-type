\import \parent.Horizontal[q := N.Nat^::zero] \as Horizontal;
\import singular_cohomology.SimplicialChains[].On[X := Horizontal.object] \as HorizontalChains;
\import \parent.\parent.Chains[] \as Nerve;
\import Semisimplicial.Maps[X := Horizontal.object, Y := object] \as Simplicial;
\definition simplicial: Simplicial.Map := Simplicial.Map {
  apply := \fun (p: N.Nat^)(s: Generator p N.Nat^::zero) => #vertices{s},
  faces := \fun (p: N.Nat^)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ p)))(s: Generator (N.Nat^::succ p) N.Nat^::zero) =>
    \refl(Faces.apply p i #vertices{s}),
};
\import HorizontalChains.Mapping[Y := object] \as Mapping;
\definition map: _ := Mapping.map simplicial;
\definition onGenerator: \forall (p: N.Nat^)(s: Generator p N.Nat^::zero) ->
  #apply{map} p (generator p N.Nat^::zero s) = Nerve.generator p #vertices{s} :=
  \fun (p: N.Nat^) => Mapping.At[n := p].onGenerator simplicial;
\module Degree(p: N.Nat^) {
  \module At(vertices: Simplex p) {
    \import \parent.\parent.\parent.\parent.Realization[].Stars[].Intersection[n := p, sigma := vertices] \as Intersection;
    \definition simplex: Generator p N.Nat^::zero := \into[Data[p, N.Nat^::zero]](
      Data[p, N.Nat^::zero] { vertices := vertices, singular := Simplices.At[n := N.Nat^::zero].constant Intersection.centre }, Generator p N.Nat^::zero) \by {
        \fun (_: Geometric.Carrier N.Nat^::zero) => Intersection.positive
      };
  }
  \import Modules.Free[Generators := Simplex p].To[W := Carrier p N.Nat^::zero, target := space p N.Nat^::zero] \as Extend;
  \definition section: _ := Extend.extension (\fun (vertices: Simplex p) => generator p N.Nat^::zero (At[vertices := vertices].simplex));
  \definition sectionOnGenerator: \forall (vertices: Simplex p) -> #apply{section} (Nerve.generator p vertices) =
    generator p N.Nat^::zero (At[vertices := vertices].simplex) :=
    Extend.onGenerator (\fun (vertices: Simplex p) => generator p N.Nat^::zero (At[vertices := vertices].simplex));
  \import Modules.Hom[V := Carrier p N.Nat^::zero, W := Nerve.Carrier p, source := space p N.Nat^::zero, target := Nerve.space p]
    .Composition[U := Nerve.Carrier p, domain := Nerve.space p] \as Compose;
  \import Modules.End[V := Nerve.Carrier p, space := Nerve.space p] \as End;
  \import Modules.Free[Generators := Simplex p].To[W := Nerve.Carrier p, target := Nerve.space p] \as Free;
  \definition equation: Compose.compose (Mapping.At[n := p].push simplicial) section = End.identity :=
    Free.ext _ _ (\fun (vertices: Simplex p) => trans!{{Nerve.Carrier p}} _ _ _
      (congr!{{Carrier p N.Nat^::zero} {Nerve.Carrier p}} (#apply{map} p) _ _ (Extend.onGenerator _ vertices))
      (onGenerator p (At[vertices := vertices].simplex)));
  \definition rightInverse: \forall (y: Nerve.Carrier p) -> #apply{map} p (#apply{section} y) = y :=
    \fun (y: Nerve.Carrier p) => congr!{{Modules.Hom[V := Nerve.Carrier p, W := Nerve.Carrier p, source := Nerve.space p, target := Nerve.space p].Map} {Nerve.Carrier p}}
      (\fun (f: Modules.Hom[V := Nerve.Carrier p, W := Nerve.Carrier p, source := Nerve.space p, target := Nerve.space p].Map) => #apply{f} y) _ _ equation;
  \definition onto: \forall (y: Nerve.Carrier p) -> \exists { x: Carrier p N.Nat^::zero \where #apply{map} p x = y } :=
    \fun (y: Nerve.Carrier p) => Logic.existsIntro[Carrier p N.Nat^::zero, { x: Carrier p N.Nat^::zero \where #apply{map} p x = y }]
      (#apply{section} y) (rightInverse y);
}
