\import \parent.\parent.Realization[].Stars[] \as Stars;
\import singular_cohomology.Small[A := Realization.Carrier, source := Realization.topology, family := Stars.family] \as Small;
\import singular_cohomology.Small[A := Realization.Carrier, source := Realization.topology, family := Stars.family].Simplices[] \as SmallSimplices;
\import \parent.Vertical[p := N.Nat^::zero] \as Vertical;
\import singular_cohomology.SimplicialChains[].On[X := Vertical.object] \as VerticalChains;
\definition label(q: N.Nat^)(s: Generator N.Nat^::zero q): SmallSimplices.Carrier q :=
  \into[Simplices.Carrier q](#singular{s}, SmallSimplices.Small q) \by {
    \exact(SmallSimplices.Witness[q, #singular{s}] {
      element := Stars.star (#vertices{s} (Fin.zero N.Nat^::zero)),
      member := Stars.member (#vertices{s} (Fin.zero N.Nat^::zero)),
      contained := \fun (x: Geometric.Carrier q) => common N.Nat^::zero q s x (Fin.zero N.Nat^::zero),
    }, SmallSimplices.Witness[q, #singular{s}])
  };
\import Semisimplicial.Maps[X := Vertical.object, Y := SmallSimplices.object] \as Simplicial;
\definition simplicial: Simplicial.Map := Simplicial.Map {
  apply := label,
  faces := \fun (q: N.Nat^)(i: Fin.Fin (N.Nat^::succ (N.Nat^::succ q)))(s: Generator N.Nat^::zero (N.Nat^::succ q)) =>
    \refl(Simplices.face q i #singular{s}),
};
\import VerticalChains.Mapping[Y := SmallSimplices.object] \as Mapping;
\definition map: _ := Mapping.map simplicial;
\definition onGenerator: \forall (q: N.Nat^)(s: Generator N.Nat^::zero q) ->
  #apply{map} q (generator N.Nat^::zero q s) = Small.generator q (label q s) :=
  \fun (q: N.Nat^) => Mapping.At[n := q].onGenerator simplicial;
\module Label(q: N.Nat^, sigma: SmallSimplices.Carrier q) {
  \structure Witness: \Set {
    vertex: Vertex,
    positive: \forall (x: Geometric.Carrier q) -> Reals.Lt Real.zero (sigma x vertex),
  }
  \definition existence: \exists Witness := \block {
    \takefrom w: SmallSimplices.Witness[q, sigma] \by SmallSimplices.witness q sigma \then
    \takefrom v: \Cast[Vertex] ({ v: Vertex \where Stars.star v = #element{w} }) \by #member{w} \then
    \return \exact(Witness {
      vertex := v,
      positive := \fun (x: Geometric.Carrier q) => \idelim Stars.star v = #element{w}
        \with U: \Pow Realization.Carrier => \In[Realization.Carrier] U (sigma x) -> Reals.Lt Real.zero (sigma x v) \by {
          base: \fun (positive: Reals.Lt Real.zero (sigma x v)) => positive,
          equality: \bysub(Vertex, { v: Vertex \where Stars.star v = #element{w} }, v)
        } (#contained{w} x),
    }, Witness)
  };
  \module With(w: Witness) {
    \definition tuple: Tuple N.Nat^::zero := \fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => w.vertex;
    \definition ordered: Ordering.Increasing (N.Nat^::succ N.Nat^::zero) (N.Nat^::succ d) tuple := \block {
      \fun (i, j: Fin.Fin (N.Nat^::succ N.Nat^::zero))(less: Bounds.Lt i j) \then
      \let zeroLess: Bounds.Lt (Fin.zero N.Nat^::zero) (Fin.zero N.Nat^::zero) :=
        \idelim i = Fin.zero N.Nat^::zero \with a: Fin.Fin (N.Nat^::succ N.Nat^::zero) => Bounds.Lt a (Fin.zero N.Nat^::zero) \by {
          base: \idelim j = Fin.zero N.Nat^::zero \with b: Fin.Fin (N.Nat^::succ N.Nat^::zero) => Bounds.Lt i b
            \by { base: less, equality: Fin.singletonValue j }, equality: Fin.singletonValue i
        } \then
      \return Logic.falseElim _ (Bounds.ltIrrefl (Fin.zero N.Nat^::zero) zeroLess)
    };
    \definition vertices: Simplex N.Nat^::zero := \into[Tuple N.Nat^::zero](tuple, Simplex N.Nat^::zero) \by {
      Admissible[N.Nat^::zero, tuple] {
        increasing := ordered,
        face := Stars.commonFace N.Nat^::zero tuple (sigma (Geometric.lastVertex q))
          (\fun (_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => w.positive (Geometric.lastVertex q)),
      }
    };
    \definition generator: Generator N.Nat^::zero q := \into[Data[N.Nat^::zero, q]](
      Data[N.Nat^::zero, q] { vertices := vertices, singular := sigma }, Generator N.Nat^::zero q) \by {
        \fun (x: Geometric.Carrier q)(_: Fin.Fin (N.Nat^::succ N.Nat^::zero)) => w.positive x
      };
    \definition law: label q generator = sigma := \refl(sigma);
  }
}
\definition generatorOnto: \forall (q: N.Nat^)(sigma: SmallSimplices.Carrier q) ->
  \exists { s: Generator N.Nat^::zero q \where label q s = sigma } := \block {
  \fun (q: N.Nat^)(sigma: SmallSimplices.Carrier q) \then
  \takefrom w: Label[q := q, sigma := sigma].Witness \by Label[q := q, sigma := sigma].existence \then
  \return Logic.existsIntro[Generator N.Nat^::zero q, { s: Generator N.Nat^::zero q \where label q s = sigma }]
    (Label[q := q, sigma := sigma].With[w := w].generator) (Label[q := q, sigma := sigma].With[w := w].law)
};
\module Degree(q: N.Nat^) {
  \definition Preimage(sigma: SmallSimplices.Carrier q): \Set := \Cast[Generator N.Nat^::zero q]
    ({ s: Generator N.Nat^::zero q \where label q s = sigma });
  \definition Selection: \Set := \forall (sigma: SmallSimplices.Carrier q) -> Preimage sigma;
  \module With(selected: Selection) {
    \import Modules.Free[Generators := SmallSimplices.Carrier q].To[W := Carrier N.Nat^::zero q, target := space N.Nat^::zero q] \as Extend;
    \definition section: _ := Extend.extension (\fun (sigma: SmallSimplices.Carrier q) => generator N.Nat^::zero q (selected sigma));
    \import Modules.Hom[V := Carrier N.Nat^::zero q, W := Small.Carrier q, source := space N.Nat^::zero q, target := Small.space q]
      .Composition[U := Small.Carrier q, domain := Small.space q] \as Compose;
    \import Modules.End[V := Small.Carrier q, space := Small.space q] \as End;
    \import Modules.Free[Generators := SmallSimplices.Carrier q].To[W := Small.Carrier q, target := Small.space q] \as Free;
    \definition equation: Compose.compose (Mapping.At[n := q].push simplicial) section = End.identity :=
      Free.ext _ _ (\fun (sigma: SmallSimplices.Carrier q) => trans!{{Small.Carrier q}} _ _ _
        (congr!{{Carrier N.Nat^::zero q} {Small.Carrier q}} (#apply{map} q) _ _ (Extend.onGenerator _ sigma))
        (trans!{{Small.Carrier q}} _ _ _ (onGenerator q (selected sigma))
          (congr!{{SmallSimplices.Carrier q} {Small.Carrier q}} (Small.generator q) _ _
            (\bysub(Generator N.Nat^::zero q, { s: Generator N.Nat^::zero q \where label q s = sigma }, selected sigma)))));
    \definition rightInverse: \forall (y: Small.Carrier q) -> #apply{map} q (#apply{section} y) = y :=
      \fun (y: Small.Carrier q) => congr!{{Modules.Hom[V := Small.Carrier q, W := Small.Carrier q, source := Small.space q, target := Small.space q].Map} {Small.Carrier q}}
        (\fun (f: Modules.Hom[V := Small.Carrier q, W := Small.Carrier q, source := Small.space q, target := Small.space q].Map) => #apply{f} y) _ _ equation;
  }
  \definition onto: \forall (y: Small.Carrier q) -> \exists { x: Carrier N.Nat^::zero q \where #apply{map} q x = y } := \block {
    \takefrom selected: Selection \by \axiom:classicalIndefiniteChoice(SmallSimplices.Carrier q, Preimage, generatorOnto q) \then
    \fun (y: Small.Carrier q) \then
    \return Logic.existsIntro[Carrier N.Nat^::zero q, { x: Carrier N.Nat^::zero q \where #apply{map} q x = y }]
      (#apply{With[selected := selected].section} y) (With[selected := selected].rightInverse y)
  };
}
