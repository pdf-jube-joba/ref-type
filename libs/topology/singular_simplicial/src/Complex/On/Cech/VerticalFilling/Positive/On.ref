\import \parent.\parent.\parent.Fibre[p := p, vertices := #vertices{s}] \as Fibre;
\import \root.Complex[d := d].On[K := K].Realization[].Stars[].Intersection[n := p, sigma := #vertices{s}] \as Intersection;
\import singular_cohomology.Chains[A := Intersection.Carrier, source := Intersection.topology] \as Local;
\import singular_cohomology.Calculations[A := Intersection.Carrier, source := Intersection.topology].ReducedContractible[]
  .Native[contraction := Intersection.Contraction[].contraction] \as Contraction;
\import \parent.\parent.\parent.Bicomplex[] \as Bicomplex;
\definition simplex: _ := Fibre.Lift[q := N.Nat^::succ q, sigma := #singular{s}, contained := common p (N.Nat^::succ q) s].simplex;
\definition x: Local.Carrier (N.Nat^::succ q) := Local.generator (N.Nat^::succ q) simplex;
\definition encoded: #apply{Fibre.map} (N.Nat^::succ q) x = generator p (N.Nat^::succ q) s :=
  trans!{{Carrier p (N.Nat^::succ q)}} _ _ _ (Fibre.onGenerator (N.Nat^::succ q) simplex)
    (congr!{{Generator p (N.Nat^::succ q)} {Carrier p (N.Nat^::succ q)}} (generator p (N.Nat^::succ q)) _ _
      (dataExt p (N.Nat^::succ q) (Fibre.encode (N.Nat^::succ q) simplex) s (\refl(#vertices{s})) (\refl(#singular{s}))));
\definition first: #apply{(Bicomplex.vertical p (N.Nat^::succ q))} (#apply{(homotopy (N.Nat^::succ q))} (generator p (N.Nat^::succ q) s)) =
  #apply{Fibre.map} (N.Nat^::succ q) (#apply{(Local.boundary (N.Nat^::succ q))} (#apply{Contraction.homotopy} (N.Nat^::succ q) x)) :=
  trans!{{Carrier p (N.Nat^::succ q)}} _ _ _
    (congr!{{Carrier p (N.Nat^::succ (N.Nat^::succ q))} {Carrier p (N.Nat^::succ q)}} (#apply{(Bicomplex.vertical p (N.Nat^::succ q))}) _ _
      (\parent.\parent.Degree[q := N.Nat^::succ q].onGenerator s))
    (#commutes{Fibre.map} (N.Nat^::succ q) (#apply{Contraction.homotopy} (N.Nat^::succ q) x));
\definition second: #apply{(homotopy q)} (#apply{(Bicomplex.vertical p q)} (generator p (N.Nat^::succ q) s)) =
  #apply{Fibre.map} (N.Nat^::succ q) (#apply{Contraction.homotopy} q (#apply{(Local.boundary q)} x)) :=
  trans!{{Carrier p (N.Nat^::succ q)}} _ _ _
    (congr!{{Carrier p (N.Nat^::succ q)} {Carrier p (N.Nat^::succ q)}}
      (\fun (z: Carrier p (N.Nat^::succ q)) => #apply{(homotopy q)} (#apply{(Bicomplex.vertical p q)} z)) _ _ (sym!{{Carrier p (N.Nat^::succ q)}} _ _ encoded))
    (trans!{{Carrier p (N.Nat^::succ q)}} _ _ _
      (congr!{{Carrier p q} {Carrier p (N.Nat^::succ q)}} (#apply{(homotopy q)}) _ _ (#commutes{Fibre.map} q x))
      (\parent.\parent.Degree[q := q].Fibre[vertices := #vertices{s}].law (#apply{(Local.boundary q)} x)));
\import Modules.Laws[V := Local.Carrier (N.Nat^::succ q), space := Local.space (N.Nat^::succ q)] \as LocalValues;
\import algebra.Group[].Of[Carrier := Local.Carrier (N.Nat^::succ q), group := LocalValues.additive] \as LocalGroup;
\definition localEquation:
  #add{(Local.space (N.Nat^::succ q))}
    (#apply{(Local.boundary (N.Nat^::succ q))} (#apply{Contraction.homotopy} (N.Nat^::succ q) x))
    (#apply{Contraction.homotopy} q (#apply{(Local.boundary q)} x)) = x :=
  trans!{{Local.Carrier (N.Nat^::succ q)}} _ _ _ (sym!{{Local.Carrier (N.Nat^::succ q)}} _ _ (#successorEquation{Contraction.homotopy} q x))
    (trans!{{Local.Carrier (N.Nat^::succ q)}} _ _ _
      (congr!{{Local.Carrier (N.Nat^::succ q)} {Local.Carrier (N.Nat^::succ q)}} (LocalGroup.difference x) _ _ (Contraction.Positive[n := q].law x))
      (trans!{{Local.Carrier (N.Nat^::succ q)}} _ _ _
        (congr!{{Local.Carrier (N.Nat^::succ q)} {Local.Carrier (N.Nat^::succ q)}} (LocalValues.add x) _ _ LocalGroup.negZero)
        (LocalGroup.zeroRight x)));
\use Equality.congr2;
\definition law:
  #add{(space p (N.Nat^::succ q))}
    (#apply{(Bicomplex.vertical p (N.Nat^::succ q))} (#apply{(homotopy (N.Nat^::succ q))} (generator p (N.Nat^::succ q) s)))
    (#apply{(homotopy q)} (#apply{(Bicomplex.vertical p q)} (generator p (N.Nat^::succ q) s))) = generator p (N.Nat^::succ q) s :=
  trans!{{Carrier p (N.Nat^::succ q)}} _ _ _
    (congr2!{{Carrier p (N.Nat^::succ q)} {Carrier p (N.Nat^::succ q)} {Carrier p (N.Nat^::succ q)}} (#add{(space p (N.Nat^::succ q))}) _ _ _ _ first second)
    (trans!{{Carrier p (N.Nat^::succ q)}} _ _ _
      (sym!{{Carrier p (N.Nat^::succ q)}} _ _ (#addition{Fibre.map} (N.Nat^::succ q)
        (#apply{(Local.boundary (N.Nat^::succ q))} (#apply{Contraction.homotopy} (N.Nat^::succ q) x))
        (#apply{Contraction.homotopy} q (#apply{(Local.boundary q)} x))))
      (trans!{{Carrier p (N.Nat^::succ q)}} _ _ _
        (congr!{{Local.Carrier (N.Nat^::succ q)} {Carrier p (N.Nat^::succ q)}} (#apply{Fibre.map} (N.Nat^::succ q)) _ _ localEquation) encoded));
