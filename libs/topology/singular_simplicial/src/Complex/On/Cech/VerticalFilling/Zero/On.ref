\import \parent.\parent.\parent.Fibre[p := p, vertices := #vertices{s}] \as Fibre;
\import \root.Complex[d := d].On[K := K].Realization[].Stars[].Intersection[n := p, sigma := #vertices{s}] \as Intersection;
\import singular_cohomology.Chains[A := Intersection.Carrier, source := Intersection.topology] \as Local;
\import singular_cohomology.Simplices[A := Intersection.Carrier, source := Intersection.topology] \as LocalSimplices;
\import singular_cohomology.Calculations[A := Intersection.Carrier, source := Intersection.topology].ReducedContractible[]
  .Native[contraction := Intersection.Contraction[].contraction] \as Contraction;
\definition simplex: _ := Fibre.Lift[q := degree, sigma := #singular{s}, contained := common p degree s].simplex;
\definition x: Local.Carrier degree := Local.generator degree simplex;
\definition encoded: #apply{Fibre.map} degree x = generator p degree s :=
  trans!{{Carrier p degree}} _ _ _ (Fibre.onGenerator degree simplex)
    (congr!{{Generator p degree} {Carrier p degree}} (generator p degree) _ _
      (dataExt p degree (Fibre.encode degree simplex) s (\refl(#vertices{s}))
        (Fibre.Lift[q := degree, sigma := #singular{s}, contained := common p degree s].encoded)));
\definition point: Carrier p degree := generator p degree (Section.At[vertices := #vertices{s}].simplex);
\definition encodedProjection: #apply{Fibre.map} degree (#apply{Contraction.projection} degree x) = point :=
  trans!{{Carrier p degree}} _ _ _
    (congr!{{Local.Carrier degree} {Carrier p degree}} (#apply{Fibre.map} degree) _ _ (Fibre.Zero[].onGenerator simplex))
    (Fibre.onGenerator degree (LocalSimplices.At[n := degree].constant Intersection.point));
\definition projected: #apply{projector} (generator p degree s) = point :=
  trans!{{Carrier p degree}} _ _ _
    (congr!{{Nerve.Carrier p} {Carrier p degree}} (#apply{Section.section}) _ _ (Augmentation.onGenerator p s))
    (Section.sectionOnGenerator #vertices{s});
\import Modules.Hom[V := Local.Carrier degree, W := Carrier p degree, source := Local.space degree, target := space p degree] \as Inclusion;
\import Modules.Laws[V := Carrier p degree, space := space p degree] \as Vector;
\import algebra.Group[].Of[Carrier := Carrier p degree, group := Vector.additive] \as Group;
\definition law:
  #apply{(Bicomplex.vertical p degree)} (#apply{(homotopy degree)} (generator p degree s)) = Group.difference (generator p degree s) (#apply{projector} (generator p degree s)) :=
  trans!{{Carrier p degree}} _ _ _
    (congr!{{Carrier p (N.Nat^::succ degree)} {Carrier p degree}} (#apply{(Bicomplex.vertical p degree)}) _ _ (\parent.\parent.Degree[q := degree].onGenerator s))
    (trans!{{Carrier p degree}} _ _ _ (#commutes{Fibre.map} degree (#apply{Contraction.homotopy} degree x))
      (trans!{{Carrier p degree}} _ _ _
        (congr!{{Local.Carrier degree} {Carrier p degree}} (#apply{Fibre.map} degree) _ _ (sym!{{Local.Carrier degree}} _ _ (#zeroEquation{Contraction.homotopy} x)))
        (trans!{{Carrier p degree}} _ _ _
          (Inclusion.differencePreserved
            (double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring].Map[C := Local.complex, D := Native.complex].At[n := degree].linear Fibre.map)
            x (#apply{Contraction.projection} degree x))
          (trans!{{Carrier p degree}} _ _ _
            (congr2!{{Carrier p degree} {Carrier p degree} {Carrier p degree}} Group.difference _ _ _ _ encoded encodedProjection)
            (congr!{{Carrier p degree} {Carrier p degree}} (Group.difference (generator p degree s)) _ _ (sym!{{Carrier p degree}} _ _ projected))))));
