\import Modules.Free[Generators := Generator p q].To[W := Carrier p (N.Nat^::succ q), target := space p (N.Nat^::succ q)] \as Free;
\definition value[s: Generator p q]: Carrier p (N.Nat^::succ q) :=
  \parent.\parent.Fibre[p := p, vertices := (s).vertices].Homotopy[q := q].value (s).singular (common p q s);
\definition map: Modules.Hom[V := Carrier p q, W := Carrier p (N.Nat^::succ q), source := space p q, target := space p (N.Nat^::succ q)].Map := Free.extension value;
\definition onGenerator: \forall (s: Generator p q) -> (map).apply (generator p q s) = value s := Free.onGenerator value;
\module Fibre(vertices: Simplex p);
