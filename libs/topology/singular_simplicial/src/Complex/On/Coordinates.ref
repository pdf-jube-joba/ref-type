\import \parent.Chains[] \as Chains;
\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as Modules;
\structure Data[n: N.Nat^]: \Set := {
  rank: N.Nat^,
  enumerate: Fin.Fin rank -> Simplex n,
  index: Simplex n -> Fin.Fin rank,
};
\structure Laws[n: N.Nat^, data: Data[n]]: \Prop := {
  indexEnumerate: \forall (i: Fin.Fin data.rank) -> data.index (data.enumerate i) = i,
  enumerateIndex: \forall (sigma: Simplex n) -> data.enumerate (data.index sigma) = sigma,
};
\definition Enumeration[n: N.Nat^]: \Set := \Cast[Data[n]] ({ data: Data[n] \where Laws[n, data] });
\definition Indexing: \Set := \forall (n: N.Nat^) -> Enumeration n;
\module Listed(n: N.Nat^);
\definition existence[n: N.Nat^]: \exists Enumeration n := Listed[n := n].existence;
\definition indexingExistence: \exists Indexing := \axiom:classicalIndefiniteChoice(N.Nat^, Enumeration, existence);
\module With(indexing: Indexing);
