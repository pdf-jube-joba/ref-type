\import N.Basic[].Prop[] \as Bounds;
\structure Data: \Set { label: V -> Vertex, first: E -> V, last: E -> V }
\structure Laws[data: Data]: \Prop {
  vertices: \forall (v, w: V) -> data.label v = data.label w -> v = w,
  ordered: \forall (e: E) -> Bounds.Lt (data.label (data.first e)) (data.label (data.last e)),
  edges: \forall (e, f: E) -> data.first e = data.first f -> data.last e = data.last f -> e = f,
}
\definition Graph: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module With(graph: Graph);
