\import std.Logic[].Equality[] \as Equality;
\import N.Basic[].Prop[] \as Bounds;
\import Fin.Ordering[] \as Ordering;
\import \root.OrderedIndices[] \as Indices;
\import algebraic_topology.Simplex[] \as Geometric;
\use Equality.trans;
\use Equality.sym;
\use Equality.congr;
\definition Tuple[n: N.Nat^]: \Set := Fin.Fin (N.Nat^::succ n) -> Vertex;
\definition Image[n: N.Nat^][vertices: Tuple n]: \Pow Vertex :=
  { v: Vertex \where \exists ( i: Fin.Fin (N.Nat^::succ n) \where vertices i = v ) };
\definition imageMember[n: N.Nat^][vertices: Tuple n][i: Fin.Fin (N.Nat^::succ n)]: \In[Vertex] (Image n vertices) (vertices i) :=
  Logic.existsIntro[Fin.Fin (N.Nat^::succ n), { j: Fin.Fin (N.Nat^::succ n) \where vertices j = vertices i }] i (\refl(vertices i));
\structure Admissible[n: N.Nat^, vertices: Tuple n]: \Prop := {
  increasing: Ordering.Increasing (N.Nat^::succ n) (N.Nat^::succ d) vertices,
  face: \In[\Pow Vertex] K.faces (Image n vertices),
};
\definition Simplex[n: N.Nat^]: \Set := \Cast[Tuple n] ({ vertices: Tuple n \where Admissible[n, vertices] });
\definition admissible[n: N.Nat^][sigma: Simplex n]: Admissible[n, sigma] := \bysub(Tuple n, Simplex n, sigma);
\module Restrictions(m, n: N.Nat^);
\module Faces;
\import algebraic_topology.Semisimplicial[] \as Semisimplicial;
\definition family: Semisimplicial.Family := Semisimplicial.Family { Carrier := Simplex };
\definition faces: Semisimplicial.Faces[family] := Semisimplicial.Faces[family] { apply := Faces[].apply };
\definition object: Semisimplicial.Object := Semisimplicial.Object {
  family := family, faces := faces, laws := Semisimplicial.Laws[family, faces] { identity := Faces[].identity },
};
\module Finiteness(n: N.Nat^);
\module Realization;
\module Chains;
\module Cup(R: \Set, ring: std.Alg[].Ring[].CommutativeRing[R]);
\module Coordinates;
\module Conical(a: Vertex);
\module Cech;
