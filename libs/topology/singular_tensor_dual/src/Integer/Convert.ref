\import Hom.On[P := P, N := canonical] \as Original;
\import Hom.On[P := P, N := standard] \as Standard;
\import Chains.End[C := P] \as End;
\import Hom.Mapping[P := P, Q := P, N := canonical, L := standard] \as Forward;
\import Hom.Mapping[P := P, Q := P, N := standard, L := canonical] \as Backward;
\definition map: chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring].Map[C := Original.complex, D := Standard.complex].Map := Forward.On[f := End.identity, u := toStandard].map;
\definition inverse: chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring].Map[C := Standard.complex, D := Original.complex].Map := Backward.On[f := End.identity, u := toCanonical].map;
\definition apply(n: N.Nat^)(alpha: Original.Carrier n): Standard.Carrier n := #apply{map} n alpha;
\definition value(n: N.Nat^)(alpha: Original.Carrier n)(x: P.family.Carrier n): #apply{(apply n alpha)} x = #apply{alpha} x := \refl(#apply{alpha} x);
\definition leftInverse(n: N.Nat^)(alpha: Original.Carrier n): #apply{inverse} n (#apply{map} n alpha) = alpha := Original.At[n := n].ext (#apply{inverse} n (#apply{map} n alpha)) alpha (\fun (x: P.family.Carrier n) => \refl(#apply{alpha} x));
\definition rightInverse(n: N.Nat^)(alpha: Standard.Carrier n): #apply{map} n (#apply{inverse} n alpha) = alpha := Standard.At[n := n].ext (#apply{map} n (#apply{inverse} n alpha)) alpha (\fun (x: P.family.Carrier n) => \refl(#apply{alpha} x));

\import chain_complexes.Cochain[].Over[R := I.Int^, ring := Integers.ring] \as Complexes;
\import chain_complexes.CochainEquivalence[].Over[R := I.Int^, ring := Integers.ring].Of[C := Original.complex, D := Standard.complex] \as Equivalences;
\module Equivalence;
\definition equivalence: Equivalences.Equivalence := Equivalence[].equivalence;
