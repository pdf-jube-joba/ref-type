\import Complexes.End[C := Original.complex] \as SourceEnd;
\import Complexes.End[C := Standard.complex] \as TargetEnd;
\import Complexes.Map[C := Original.complex, D := Original.complex] \as SourceMaps;
\import Complexes.Map[C := Standard.complex, D := Standard.complex] \as TargetMaps;
\import Complexes.Map[C := Standard.complex, D := Original.complex].Composition[B := Original.complex] \as LeftComposition;
\import Complexes.Map[C := Original.complex, D := Standard.complex].Composition[B := Standard.complex] \as RightComposition;
\definition leftEquality: LeftComposition.compose inverse map = SourceEnd.identity := SourceMaps.ext (LeftComposition.compose inverse map) SourceEnd.identity leftInverse;
\definition rightEquality: RightComposition.compose map inverse = TargetEnd.identity := TargetMaps.ext (RightComposition.compose map inverse) TargetEnd.identity rightInverse;
\import Complexes.Homotopy[C := Original.complex, D := Original.complex] \as LeftHomotopy;
\import Complexes.Homotopy[C := Standard.complex, D := Standard.complex] \as RightHomotopy;
\import LeftHomotopy.Reflexive[f := SourceEnd.identity] \as LeftZero;
\import RightHomotopy.Reflexive[f := TargetEnd.identity] \as RightZero;
\definition left: LeftHomotopy.Homotopy SourceEnd.identity (LeftComposition.compose inverse map) :=
  \into[LeftHomotopy.Data](LeftZero.data, LeftHomotopy.Homotopy SourceEnd.identity (LeftComposition.compose inverse map)) \by {
    LeftHomotopy.replacementLaws SourceEnd.identity SourceEnd.identity SourceEnd.identity (LeftComposition.compose inverse map)
      LeftZero.data (\refl(SourceEnd.identity)) (sym!{SourceMaps.Map} _ _ leftEquality) LeftZero.laws
  };
\definition right: RightHomotopy.Homotopy TargetEnd.identity (RightComposition.compose map inverse) :=
  \into[RightHomotopy.Data](RightZero.data, RightHomotopy.Homotopy TargetEnd.identity (RightComposition.compose map inverse)) \by {
    RightHomotopy.replacementLaws TargetEnd.identity TargetEnd.identity TargetEnd.identity (RightComposition.compose map inverse)
      RightZero.data (\refl(TargetEnd.identity)) (sym!{TargetMaps.Map} _ _ rightEquality) RightZero.laws
  };
\definition equivalence: Equivalences.Equivalence := Equivalences.Equivalence { forward := map, backward := inverse, left := left, right := right };
