\import algebra.Hom[A := I.Int^, B := I.Int^] \as GroupMaps;
\definition function(x: I.Int^)(a: I.Int^): I.Int^ := #mul{Integers.ring} a x;
\definition native(x: I.Int^): Action.IntegerMap := \into[I.Int^ -> I.Int^](function x, Action.IntegerMap) \by {
  GroupMaps.MonoidLaws[Action.integerDomain, Action.target, function x] {
    unit := #zeroAbsorbsLeft{(#semiring{Integers.ring})} x,
    operation := \fun (a, b: I.Int^) => #rightDistributive{(#semiring{Integers.ring})} a b x,
  }
};
\definition equality(x: I.Int^): Action.integerMap x = native x := Action.generatorExt (Action.integerMap x) (native x)
  (trans!{I.Int^} _ _ _ (Action.scalarOne x)
    (sym!{I.Int^} _ _ (#leftIdentity{(#multiplicative{(#semiring{Integers.ring})})} x)));
\definition law(a, x: I.Int^): #smul{canonical.space} a x = #smul{standard.space} a x :=
  congr!{{I.Int^ -> I.Int^} I.Int^} (\fun (f: I.Int^ -> I.Int^) => f a) _ _ (equality x);
