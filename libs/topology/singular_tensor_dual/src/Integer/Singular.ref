\import singular_cohomology.Chains[A := A, source := source] \as Singular;
\import singular_symmetry.Cochains[A := A, source := source, R := I.Int^, ring := Integers.commutativeRing] \as Ordinary;
\import Ordinary.Pairing[p := p, q := q] \as Original;
\import \root.Over[R := I.Int^, ring := Integers.commutativeRing] \as TensorDual;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := TensorDual.baseRing] \as Native;
\definition nativeComplex: Native.Complex := Singular.complex;
\import TensorDual.Selected[P := nativeComplex, Q := nativeComplex, p := p, q := q] \as Selected;
\import \parent.Convert[P := Singular.complex] \as Cochains;
\import Hom.On[P := Singular.complex, N := standard] \as Standard;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\import Double.Tensor[C := Singular.complex, D := Singular.complex] \as Product;
\import Double.Total[C := Product.complex] \as Total;
\import Product.Term[p := p, q := q] \as Term;
\import \parent.Convert[P := Total.complex] \as TotalCochains;
\definition native(n: N.Nat^)(alpha: Ordinary.Carrier n): Standard.Carrier n := Cochains.apply n alpha;
\import Modules.Hom[V := I.Int^, W := I.Int^, source := canonical.space, target := standard.space].Composition[U := Term.Carrier, domain := Term.space] \as Compose;
\import Modules.Tensor[V := Singular.Carrier p, W := Singular.Carrier q, left := Singular.space p, right := Singular.space q].Universal[U := I.Int^, target := standard.space] \as Universal;
\definition local(alpha: Ordinary.Carrier p)(beta: Ordinary.Carrier q): Selected.comparison (native p alpha) (native q beta) = Compose.compose toStandard (Original.map alpha beta) :=
  Universal.ext (Selected.comparison (native p alpha) (native q beta)) (Compose.compose toStandard (Original.map alpha beta))
    (\fun (x: Singular.Carrier p)(y: Singular.Carrier q) => trans!{I.Int^} _ _ _
      (Selected.onTensor (native p alpha) (native q beta) x y)
      (sym!{I.Int^} _ _ (Original.onTensor alpha beta x y)));
\import Double.Coordinates[C := Product.complex].Degree[n := Selected.n] \as Coordinates;
\import Modules.Hom[V := Term.Carrier, W := I.Int^, source := Term.space, target := standard.space] \as Maps;
\definition law(alpha: Ordinary.Carrier p)(beta: Ordinary.Carrier q)(x: Total.Carrier Selected.n):
  #apply{(Selected.total (native p alpha) (native q beta))} x = #apply{(Original.total alpha beta)} x :=
  congr!{Maps.Map I.Int^} (\fun (f: Maps.Map) => #apply{f} (Coordinates.coordinate Selected.index x)) _ _ (local alpha beta);
\definition equation(alpha: Ordinary.Carrier p)(beta: Ordinary.Carrier q):
  Selected.total (native p alpha) (native q beta) = TotalCochains.apply Selected.n (Original.total alpha beta) :=
  Modules.Hom[V := Total.Carrier Selected.n, W := I.Int^, source := Total.space Selected.n, target := standard.space].ext
    (Selected.total (native p alpha) (native q beta)) (TotalCochains.apply Selected.n (Original.total alpha beta)) (law alpha beta);
