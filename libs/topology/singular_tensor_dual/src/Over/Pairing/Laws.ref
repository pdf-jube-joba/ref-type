\definition laws: Source.BilinearLaws[Target.Carrier, Target.space, comparison] := Source.BilinearLaws[Target.Carrier, Target.space, comparison] {
  addLeft := \fun (alpha, gamma: Left.Carrier)(beta: Right.Carrier) => Extend.ext
    (comparison (#add{Left.space} alpha gamma) beta) (#add{Target.space} (comparison alpha beta) (comparison gamma beta))
    (\fun (x: V.Carrier)(y: W.Carrier) => trans!{R} _ _ _ (evaluation (#add{Left.space} alpha gamma) beta x y)
      (trans!{R} _ _ _ (distributeRight (#apply{alpha} x) (#apply{gamma} x) (#apply{beta} y))
        (sym!{R} _ _ (congr2!{R R R} add _ _ _ _ (evaluation alpha beta x y) (evaluation gamma beta x y))))),
  addRight := \fun (alpha: Left.Carrier)(beta, gamma: Right.Carrier) => Extend.ext
    (comparison alpha (#add{Right.space} beta gamma)) (#add{Target.space} (comparison alpha beta) (comparison alpha gamma))
    (\fun (x: V.Carrier)(y: W.Carrier) => trans!{R} _ _ _ (evaluation alpha (#add{Right.space} beta gamma) x y)
      (trans!{R} _ _ _ (distributeLeft (#apply{alpha} x) (#apply{beta} y) (#apply{gamma} y))
        (sym!{R} _ _ (congr2!{R R R} add _ _ _ _ (evaluation alpha beta x y) (evaluation alpha gamma x y))))),
  scaleLeft := \fun (a: R)(alpha: Left.Carrier)(beta: Right.Carrier) => Extend.ext
    (comparison (#smul{Left.space} a alpha) beta) (#smul{Target.space} a (comparison alpha beta))
    (\fun (x: V.Carrier)(y: W.Carrier) => trans!{R} _ _ _ (evaluation (#smul{Left.space} a alpha) beta x y)
      (trans!{R} _ _ _ (assoc a (#apply{alpha} x) (#apply{beta} y))
        (sym!{R} _ _ (congr!{R R} (mul a) _ _ (evaluation alpha beta x y))))),
  scaleRight := \fun (a: R)(alpha: Left.Carrier)(beta: Right.Carrier) => Extend.ext
    (comparison alpha (#smul{Right.space} a beta)) (#smul{Target.space} a (comparison alpha beta))
    (\fun (x: V.Carrier)(y: W.Carrier) => trans!{R} _ _ _ (evaluation alpha (#smul{Right.space} a beta) x y)
      (trans!{R} _ _ _ (middle (#apply{alpha} x) a (#apply{beta} y))
        (sym!{R} _ _ (congr!{R R} (mul a) _ _ (evaluation alpha beta x y))))),
};
