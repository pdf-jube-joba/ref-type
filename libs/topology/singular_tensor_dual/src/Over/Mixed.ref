\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as Integers;
\import module_theory.Module[].Over[R := I.Int^, ring := Integers.ring] \as IntegerModules;
\import commutative_algebra.Modules[R := I.Int^, ring := Integers.commutativeRing] \as IntegerAlgebra;
\import Modules.AbelianHom[N := scalars] \as Coefficients;
\import double_complexes.NonnegativeChain[].Over[R := I.Int^, ring := Integers.ring] \as Chains;
\import double_complexes.DoubleComplex[].Over[R := I.Int^, ring := Integers.ring] \as Double;
\import double_complexes.DoubleComplex[].Over[R := R, ring := Rings.commutativeRingAsRing R ring] \as ScalarDouble;
\module Dual(V: IntegerModules.Bundle) {
  \import Coefficients.From[V := V.Carrier, domain := V.space] \as Hom;
  \definition Carrier: \Set := Hom.Carrier;
  \definition space: Modules.Space Carrier := Hom.space;
  \definition bundle: Modules.Bundle := Modules.Bundle { Carrier := Carrier, space := space };
}
\module Finite(V: IntegerModules.Bundle, rank: N.Nat^);
\module Pairing(V, W: IntegerModules.Bundle);
\module Local(V, W: IntegerModules.Bundle, rank: N.Nat^, frame: \root.Over[R := R, ring := ring].Mixed[].Finite[V := V, rank := rank].Frame);
\module Diagonal(n: N.Nat^, family: IntegerModules.Family[Double.Index n]);
\module Frames(P: Chains.Complex, ranks: N.Nat^ -> N.Nat^);
\module On(P, Q: Chains.Complex, ranks: N.Nat^ -> N.Nat^, frames: \root.Over[R := R, ring := ring].Mixed[].Frames[P := P, ranks := ranks].Frames);

\module HomEquivalence(P, Q: Chains.Complex, e: Chains.Equivalence[C := P, D := Q].Equivalence);

\module Indices(n: N.Nat^);

\module Sign;
