\definition bundle: Modules.Bundle := Modules.Bundle { Carrier := family.Carrier i, space := family.space i };
\import \parent.\parent.Dual[V := bundle] \as Dual0;
\module Dual {
  \definition Carrier: \Set := Dual0.Carrier;
  \definition space: Modules.Space Carrier := Dual0.space;
}
\import Modules.Hom[V := family.Carrier i, W := R, source := family.space i, target := Modules.scalarModule] \as Maps0;
\module Maps {
  \definition ext: \forall (f, g: Dual0.Carrier) -> (\forall (x: family.Carrier i) -> #apply{f} x = #apply{g} x) -> f = g := Maps0.ext;
}
\definition coordinate: Modules.Hom[V := Primal.Carrier, W := family.Carrier i, source := Primal.space, target := family.space i].Map := PrimalCoordinates.At[i := i].evaluate;
\import Maps0.Composition[U := Primal.Carrier, domain := Primal.space] \as ForwardComposition;
\definition extend(f: Dual0.Carrier): Target.Carrier := ForwardComposition.compose f coordinate;
\import Modules.Hom[V := Primal.Carrier, W := R, source := Primal.space, target := Modules.scalarModule] \as TargetMaps;
\definition forward: Modules.Hom[V := Dual0.Carrier, W := Target.Carrier, source := Dual0.space, target := Target.space].Map := Modules.Hom[V := Dual0.Carrier, W := Target.Carrier, source := Dual0.space, target := Target.space].Map {
  apply := extend,
  addition := \fun (f, g: Dual0.Carrier) => TargetMaps.ext (extend (#add{Dual0.space} f g)) (#add{Target.space} (extend f) (extend g))
    (\fun (x: Primal.Carrier) => \refl(add (#apply{f} (#apply{coordinate} x)) (#apply{g} (#apply{coordinate} x)))),
  scalar := \fun (a: R)(f: Dual0.Carrier) => TargetMaps.ext (extend (#smul{Dual0.space} a f)) (#smul{Target.space} a (extend f))
    (\fun (x: Primal.Carrier) => \refl(mul a (#apply{f} (#apply{coordinate} x)))),
};
\import TargetMaps.Composition[U := family.Carrier i, domain := family.space i] \as Restriction;
\definition restrict(h: Target.Carrier): Dual0.Carrier := Restriction.compose h (Primal.Injection[i := i].map);
