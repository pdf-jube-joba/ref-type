\import Primal.To[W := R, target := Modules.scalarModule] \as Universal;
\definition point(h: Target.Carrier)(i: Index)(x: family.Carrier i): #apply{(#apply{forward} (#apply{backward} h))} (#apply{Primal.Injection[i := i].map} x) = #apply{h} (#apply{Primal.Injection[i := i].map} x) :=
  trans!{R} _ _ _ (\parent.Coordinate[].Evaluation[i := i, x := x].law (#apply{backward} h))
    (congr!{{dualFamily.Carrier i} R} (\fun (f: dualFamily.Carrier i) => #apply{f} x) _ _ (backwardCoordinate h i));
\definition law(h: Target.Carrier): #apply{forward} (#apply{backward} h) = h := Universal.ext (#apply{forward} (#apply{backward} h)) h (point h);
