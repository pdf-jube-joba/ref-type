\definition point(s: Source.Carrier)(i: Index): (#apply{SourceCoordinates.forward} (#apply{backward} (#apply{forward} s))) i = (#apply{SourceCoordinates.forward} s) i :=
  trans!{{dualFamily.Carrier i}} _ _ _ (backwardCoordinate (#apply{forward} s) i)
    (At[i := i].ext (At[i := i].restrict (#apply{forward} s)) ((#apply{SourceCoordinates.forward} s) i)
      (\fun (x: family.Carrier i) => Coordinate[].Evaluation[i := i, x := x].law s));
\import Modules.FinitelySupported[Index := Index, family := dualFamily] \as Supported;
\definition law(s: Source.Carrier): #apply{backward} (#apply{forward} s) = s :=
  SourceCoordinates.injective (#apply{backward} (#apply{forward} s)) s
    (\axiom:funext(#apply{SourceCoordinates.forward} (#apply{backward} (#apply{forward} s)), #apply{SourceCoordinates.forward} s, point s));
