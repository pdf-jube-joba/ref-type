\definition point[s: Source.Carrier][i: Index]: ((SourceCoordinates.forward).apply ((backward).apply ((forward).apply s))) i = ((SourceCoordinates.forward).apply s) i :=
  trans!{{dualFamily.Carrier i}} _ _ _ (backwardCoordinate ((forward).apply s) i)
    (\parent.At[i := i].ext (\parent.At[i := i].restrict ((forward).apply s)) (((SourceCoordinates.forward).apply s) i)
      (\fun (x: family.Carrier i) => \parent.Coordinate[].Evaluation[i := i, x := x].law s));
\import Modules.FinitelySupported[Index := Index, family := dualFamily] \as Supported;
\definition law[s: Source.Carrier]: (backward).apply ((forward).apply s) = s :=
  SourceCoordinates.injective ((backward).apply ((forward).apply s)) s
    (\axiom:funext((SourceCoordinates.forward).apply ((backward).apply ((forward).apply s)), (SourceCoordinates.forward).apply s, point s));
