\definition first: Modules.Bundle := Modules.Bundle { Carrier := P.family.Carrier #first{i}, space := P.family.space #first{i} };
\definition second: Modules.Bundle := Modules.Bundle { Carrier := Q.family.Carrier #second{i}, space := Q.family.space #second{i} };
\import \parent.\parent.\parent.Local[V := first, W := second, rank := ranks #first{i}, frame := frames #first{i}] \as Local;
\definition isomorphism: Modules.Isomorphism[V := SourceTerm.family.Carrier i, W := Diagonal.dualFamily.Carrier i, source := SourceTerm.family.space i, target := Diagonal.dualFamily.space i].Isomorphism := Local.isomorphism;

\import \parent.\parent.\parent.Pairing[V := first, W := second] \as Pairing;
\definition tensor: Left.Carrier #first{i} -> Right.Carrier #second{i} -> SourceTerm.family.Carrier i := SourceTensor.Term[p := #first{i}, q := #second{i}].tensor;
\definition comparison: Left.Carrier #first{i} -> Right.Carrier #second{i} -> Diagonal.dualFamily.Carrier i := Pairing.comparison;
\definition onTensor(alpha: Left.Carrier #first{i})(beta: Right.Carrier #second{i}): #apply{#forward{isomorphism}} (tensor alpha beta) = comparison alpha beta := Pairing.onTensor alpha beta;
