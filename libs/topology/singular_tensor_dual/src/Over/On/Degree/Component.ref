\definition first: Modules.Bundle := Modules.Bundle { Carrier := P.family.Carrier (i).first, space := P.family.space (i).first };
\definition second: Modules.Bundle := Modules.Bundle { Carrier := Q.family.Carrier (i).second, space := Q.family.space (i).second };
\import \parent.\parent.\parent.Local[V := first, W := second, rank := ranks (i).first, frame := frames (i).first] \as Local;
\definition isomorphism: Modules.Isomorphism[V := SourceTerm.family.Carrier i, W := Diagonal.dualFamily.Carrier i, source := SourceTerm.family.space i, target := Diagonal.dualFamily.space i].Isomorphism := Local.isomorphism;

\import \parent.\parent.\parent.Pairing[V := first, W := second] \as Pairing;
\definition tensor: Left.Carrier (i).first -> Right.Carrier (i).second -> SourceTerm.family.Carrier i := SourceTensor.Term[p := (i).first, q := (i).second].tensor;
\definition comparison: Left.Carrier (i).first -> Right.Carrier (i).second -> Diagonal.dualFamily.Carrier i := Pairing.comparison;
\definition onTensor[alpha: Left.Carrier (i).first][beta: Right.Carrier (i).second]: ((isomorphism).forward).apply (tensor alpha beta) = comparison alpha beta := Pairing.onTensor alpha beta;
