\definition higher: N.Nat^ := N.Nat^::succ n;
\import \parent.Degree[n := n] \as Current;
\import \parent.Degree[n := higher] \as Next;
\import Source.Degree[n := n] \as SourceCurrent;
\import Source.Degree[n := higher] \as SourceNext;
\import Source.Step[n := n] \as SourceStep;
\import Modules.Hom[V := SourceCarrier n, W := SourceCarrier higher, source := SourceSpace n, target := SourceSpace higher] \as SourceBoundary;
\definition sourceBoundary: SourceBoundary.Map := SourceBoundary.Map { apply := (Source.differential).apply n, addition := (Source.complex.laws).addition n, scalar := (Source.complex.laws).scalar n };
\import Modules.Hom[V := Target.Carrier n, W := Target.Carrier higher, source := Target.space n, target := Target.space higher] \as TargetBoundary;
\definition targetBoundary: TargetBoundary.Map := TargetBoundary.Map { apply := Target.apply n, addition := Target.addition n, scalar := Target.scalar n };
\import TargetBoundary.Composition[U := SourceCarrier n, domain := SourceSpace n] \as Before;
\import Modules.Hom[V := SourceCarrier higher, W := Target.Carrier higher, source := SourceSpace higher, target := Target.space higher].Composition[U := SourceCarrier n, domain := SourceSpace n] \as After;
\import Modules.Hom[V := SourceCarrier n, W := Target.Carrier higher, source := SourceSpace n, target := Target.space higher] \as Maps;
\definition before: Maps.Map := Before.compose targetBoundary Current.forward;
\definition after: Maps.Map := After.compose Next.forward sourceBoundary;
\module Component(i: Double.Index n);
\import Modules.DirectSum[Index := Double.Index n, family := SourceCurrent.family].To[W := Target.Carrier higher, target := Target.space higher] \as Universal;
\definition equality: before = after := Universal.ext before after
  (\fun (i: Double.Index n)(z: SourceCurrent.family.Carrier i) => Component[i := i].law z);
\definition law[x: SourceCarrier n]: Target.apply n ((Current.forward).apply x) = (Next.forward).apply ((Source.differential).apply n x) :=
  congr!{Maps.Map {Target.Carrier higher}} (\fun (f: Maps.Map) => (f).apply x) _ _ equality;
