\definition commutes[n: N.Nat^][y: Target.Carrier n]:
  (Source.differential).apply n ((\parent.Degree[n := n].backward).apply y) = (\parent.Degree[n := N.Nat^::succ n].backward).apply (Target.apply n y) :=
  trans!{{SourceCarrier (N.Nat^::succ n)}} _ _ _
    (sym!{{SourceCarrier (N.Nat^::succ n)}} _ _
      ((\parent.Degree[n := N.Nat^::succ n].isomorphism).leftInverse ((Source.differential).apply n ((\parent.Degree[n := n].backward).apply y))))
    (trans!{{SourceCarrier (N.Nat^::succ n)}} _ _ _
      (congr!{{Target.Carrier (N.Nat^::succ n)} {SourceCarrier (N.Nat^::succ n)}} ((\parent.Degree[n := N.Nat^::succ n].backward).apply) _ _
        (sym!{{Target.Carrier (N.Nat^::succ n)}} _ _ (\parent.Step[n := n].law ((\parent.Degree[n := n].backward).apply y))))
      (congr!{{Target.Carrier n} {SourceCarrier (N.Nat^::succ n)}}
        (\fun (z: Target.Carrier n) => (\parent.Degree[n := N.Nat^::succ n].backward).apply (Target.apply n z)) _ _
        ((\parent.Degree[n := n].isomorphism).rightInverse y)));
