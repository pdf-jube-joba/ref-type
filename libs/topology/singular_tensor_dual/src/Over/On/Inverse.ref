\definition commutes(n: N.Nat^)(y: Target.Carrier n):
  #apply{Source.differential} n (#apply{\parent.Degree[n := n].backward} y) = #apply{\parent.Degree[n := N.Nat^::succ n].backward} (Target.apply n y) :=
  trans!{{SourceCarrier (N.Nat^::succ n)}} _ _ _
    (sym!{{SourceCarrier (N.Nat^::succ n)}} _ _
      (#leftInverse{\parent.Degree[n := N.Nat^::succ n].isomorphism} (#apply{Source.differential} n (#apply{\parent.Degree[n := n].backward} y))))
    (trans!{{SourceCarrier (N.Nat^::succ n)}} _ _ _
      (congr!{{Target.Carrier (N.Nat^::succ n)} {SourceCarrier (N.Nat^::succ n)}} (#apply{\parent.Degree[n := N.Nat^::succ n].backward}) _ _
        (sym!{{Target.Carrier (N.Nat^::succ n)}} _ _ (\parent.Step[n := n].law (#apply{\parent.Degree[n := n].backward} y))))
      (congr!{{Target.Carrier n} {SourceCarrier (N.Nat^::succ n)}}
        (\fun (z: Target.Carrier n) => #apply{\parent.Degree[n := N.Nat^::succ n].backward} (Target.apply n z)) _ _
        (#rightInverse{\parent.Degree[n := n].isomorphism} y)));
