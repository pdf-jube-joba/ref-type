\definition p: N.Nat^ := (i).first;
\definition q: N.Nat^ := (i).second;
\import \parent.Degree[n := n] \as Degree;
\import Source.Degree[n := n] \as SourceTerm;
\import TargetTotal.Degree[n := n] \as ChainTerm;
\import TargetTensor.Term[p := p, q := q] \as Primal;
\import Double.Coordinates[C := TargetTensor.complex].Degree[n := n] \as Coordinates;
\definition cochain[alpha: Left.Carrier p][beta: Right.Carrier q]: SourceCarrier n :=
  (SourceTerm.Component[i := i].injection).apply (Degree.Component[i := i].tensor alpha beta);
\definition tensor[x: P.family.Carrier p][y: Q.family.Carrier q]: chainCarrier n :=
  (ChainTerm.Component[i := i].injection).apply (Primal.tensor x y);
\definition first: Modules.Bundle := Modules.Bundle { Carrier := P.family.Carrier p, space := P.family.space p };
\definition second: Modules.Bundle := Modules.Bundle { Carrier := Q.family.Carrier q, space := Q.family.space q };
\import \parent.\parent.Pairing[V := first, W := second] \as Pairing;
\definition law[alpha: Left.Carrier p][beta: Right.Carrier q][x: P.family.Carrier p][y: Q.family.Carrier q]:
  ((forward).apply n (cochain alpha beta)).apply (tensor x y) = mul ((alpha).apply x) ((beta).apply y) :=
  trans!{R} _ _ _ (Degree.pure i alpha beta (tensor x y))
    (trans!{R} _ _ _
      (congr!{Primal.Carrier R} ((Degree.Component[i := i].comparison alpha beta).apply) _ _ (Coordinates.own i (Primal.tensor x y)))
      (Pairing.evaluation alpha beta x y));
