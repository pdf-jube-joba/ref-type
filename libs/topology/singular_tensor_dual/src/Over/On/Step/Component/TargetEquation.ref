\import Double.Sign[V := Primal.Carrier, space := Primal.space].Mapping[W := R, target := Modules.scalarModule] \as SignMapping;
\definition vertical(alpha: Left.Carrier p)(beta: Right.Carrier q)(x: TargetTotal.Carrier higher):
  #apply{(Pairing.comparison alpha beta)} (#apply{Double.Sign[V := Primal.Carrier, space := Primal.space].map p}
    (#apply{PrimalBoundary.vertical} (Coordinates.Degree[n := higher].coordinate verticalIndex x))) = v alpha beta x :=
  trans!{R} _ _ _
    (SignMapping.naturality (Pairing.comparison alpha beta) p (#apply{PrimalBoundary.vertical} (Coordinates.Degree[n := higher].coordinate verticalIndex x)))
    (congr!{R R} (#apply{ScalarSign.map p}) _ _ (Naturality.vertical alpha beta (Coordinates.Degree[n := higher].coordinate verticalIndex x)));
\definition law(alpha: Left.Carrier p)(beta: Right.Carrier q)(x: TargetTotal.Carrier higher):
  #apply{(Target.apply n (#apply{Current.forward} (#apply{SourceCurrent.Component[i := i].injection} (Term.tensor alpha beta))))} x = add (h alpha beta x) (v alpha beta x) :=
  trans!{R} _ _ _ (Current.pure i alpha beta (#apply{TargetTotal.differential} n x))
    (trans!{R} _ _ _
      (congr!{Primal.Carrier R} (#apply{(Pairing.comparison alpha beta)}) _ _ (Boundary.differential x))
      (trans!{R} _ _ _
        (#addition{(Pairing.comparison alpha beta)}
          (#apply{PrimalBoundary.horizontal} (Coordinates.Degree[n := higher].coordinate horizontalIndex x))
          (#apply{Double.Sign[V := Primal.Carrier, space := Primal.space].map p} (#apply{PrimalBoundary.vertical} (Coordinates.Degree[n := higher].coordinate verticalIndex x))))
        (congr2!{R R R} add _ _ _ _ (Naturality.horizontal alpha beta (Coordinates.Degree[n := higher].coordinate horizontalIndex x)) (vertical alpha beta x))));
