\import Modules.Hom[V := Target.Carrier, W := Right.Carrier, source := Target.space, target := Right.space] \as Restriction;
\definition map: Restriction.Map := Restriction.Map {
  apply := restriction i,
  addition := \fun (h, k: Target.Carrier) => RightMaps.ext (restriction i ((Target.space).add h k)) ((Right.space).add (restriction i h) (restriction i k))
    (\fun (y: W.Carrier) => \refl(add ((h).apply (Primal.tensor (frame.basis i) y)) ((k).apply (Primal.tensor (frame.basis i) y)))),
  scalar := \fun (a: R)(h: Target.Carrier) => RightMaps.ext (restriction i ((Target.space).smul a h)) ((Right.space).smul a (restriction i h))
    (\fun (y: W.Carrier) => \refl(mul a ((h).apply (Primal.tensor (frame.basis i) y)))),
};
\import Modules.Hom[V := Right.Carrier, W := Source.Carrier, source := Right.space, target := Source.space].Composition[U := Target.Carrier, domain := Target.space] \as Compose;
\definition piece: Modules.Hom[V := Target.Carrier, W := Source.Carrier, source := Target.space, target := Source.space].Map := Compose.compose (Source.rightLinear (frame.coordinate i)) map;
