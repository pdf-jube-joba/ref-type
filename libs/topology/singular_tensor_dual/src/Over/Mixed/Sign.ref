\import Double.Sign[V := R, space := Coefficients.coefficients.space] \as Integral;
\import ScalarDouble.Sign[V := R, space := Modules.scalarModule] \as Scalar;
\definition law: \forall (n: N.Nat^)(x: R) -> #apply{Integral.map n} x = #apply{Scalar.map n} x :=
  \induction (n: N.Nat^) \return \forall (x: R) -> #apply{Integral.map n} x = #apply{Scalar.map n} x \with {
    | zero: \fun (x: R) => \refl(x)
    | succ: \fun (n: N.Nat^)(previous: \forall (x: R) -> #apply{Integral.map n} x = #apply{Scalar.map n} x)(x: R) =>
      trans!{R} _ _ _ (Integral.successor n x)
        (trans!{R} _ _ _ (congr!{R R} (#neg{Modules.scalarModule}) _ _ (previous x)) (sym!{R} _ _ (Scalar.successor n x)))
  };
