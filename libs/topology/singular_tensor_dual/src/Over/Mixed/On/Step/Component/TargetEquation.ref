\import \parent.\parent.\parent.\parent.Sign[] \as SignCompatibility;
\import Double.Sign[V := Primal.Carrier, space := Primal.space].Mapping[W := R, target := Coefficients.coefficients.space] \as SignMapping;
\definition vertical[alpha: Left.Carrier p][beta: Right.Carrier q][x: TargetTotal.Carrier higher]:
  (Pairing.comparison alpha beta).apply ((Double.Sign[V := Primal.Carrier, space := Primal.space].map p).apply
    ((PrimalBoundary.vertical).apply (Coordinates.Degree[n := higher].coordinate targetVerticalIndex x))) = v alpha beta x :=
  trans!{R} _ _ _
    (SignMapping.naturality (Pairing.comparison alpha beta) p ((PrimalBoundary.vertical).apply (Coordinates.Degree[n := higher].coordinate targetVerticalIndex x)))
    (trans!{R} _ _ _
      (SignCompatibility.law p ((Pairing.comparison alpha beta).apply ((PrimalBoundary.vertical).apply (Coordinates.Degree[n := higher].coordinate targetVerticalIndex x))))
      (congr!{R R} ((ScalarSign.map p).apply) _ _ (Naturality.vertical alpha beta (Coordinates.Degree[n := higher].coordinate targetVerticalIndex x))));
\definition law[alpha: Left.Carrier p][beta: Right.Carrier q][x: TargetTotal.Carrier higher]:
  (Target.apply n ((Current.forward).apply ((SourceCurrent.Component[i := i].injection).apply (Term.tensor alpha beta)))).apply x = add (h alpha beta x) (v alpha beta x) :=
  trans!{R} _ _ _ (Current.pure i alpha beta ((TargetTotal.differential).apply n x))
    (trans!{R} _ _ _
      (congr!{Primal.Carrier R} ((Pairing.comparison alpha beta).apply) _ _ (Boundary.differential x))
      (trans!{R} _ _ _
        ((Pairing.comparison alpha beta).addition
          ((PrimalBoundary.horizontal).apply (Coordinates.Degree[n := higher].coordinate targetHorizontalIndex x))
          ((Double.Sign[V := Primal.Carrier, space := Primal.space].map p).apply ((PrimalBoundary.vertical).apply (Coordinates.Degree[n := higher].coordinate targetVerticalIndex x))))
        (congr2!{R R R} add _ _ _ _ (Naturality.horizontal alpha beta (Coordinates.Degree[n := higher].coordinate targetHorizontalIndex x)) (vertical alpha beta x))));
