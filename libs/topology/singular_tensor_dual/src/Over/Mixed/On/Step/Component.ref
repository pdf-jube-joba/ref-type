\definition p: N.Nat^ := (i).first;
\definition q: N.Nat^ := (i).second;
\definition horizontalIndex: ScalarDouble.Index higher := Source.upHorizontal n i;
\definition verticalIndex: ScalarDouble.Index higher := Source.upVertical n i;
\import SourceTensor.Term[p := p, q := q] \as Term;
\import SourceTensor.Term[p := N.Nat^::succ p, q := q] \as HTerm;
\import SourceTensor.Term[p := p, q := N.Nat^::succ q] \as VTerm;
\import SourceTensor.At[p := p, q := q] \as Differential;
\import TargetTensor.Term[p := p, q := q] \as Primal;
\import TargetTensor.At[p := p, q := q] \as PrimalBoundary;
\import Double.Coordinates[C := TargetTensor.complex] \as Coordinates;
\import \parent.\parent.\parent.Indices[n := n] \as CurrentIndices;
\import \parent.\parent.\parent.Indices[n := higher] \as NextIndices;
\definition targetHorizontalIndex: Double.Index higher := NextIndices.toInteger horizontalIndex;
\definition targetVerticalIndex: Double.Index higher := NextIndices.toInteger verticalIndex;
\import Coordinates.StepAt[n := n, i := CurrentIndices.toInteger i] \as Boundary;
\import \parent.\parent.Naturality[p := p, q := q] \as Naturality;
\import Current.Component[i := i] \as Pairing;
\import Next.Component[i := horizontalIndex] \as HPairing;
\import Next.Component[i := verticalIndex] \as VPairing;
\import ScalarDouble.Sign[V := R, space := Modules.scalarModule] \as ScalarSign;
\definition h[alpha: Left.Carrier p][beta: Right.Carrier q][x: TargetTotal.Carrier higher]: R := (HPairing.comparison (Left.apply p alpha) beta).apply (Coordinates.Degree[n := higher].coordinate targetHorizontalIndex x);
\definition v[alpha: Left.Carrier p][beta: Right.Carrier q][x: TargetTotal.Carrier higher]: R := (ScalarSign.map p).apply ((VPairing.comparison alpha (Right.apply q beta)).apply (Coordinates.Degree[n := higher].coordinate targetVerticalIndex x));
\module TargetEquation;
\module SourceEquation;
\import Maps.Composition[U := Term.Carrier, domain := Term.space] \as Compose;
\definition first: Modules.Hom[V := Term.Carrier, W := Target.Carrier higher, source := Term.space, target := Target.space higher].Map := Compose.compose before (SourceCurrent.Component[i := i].injection);
\definition second: Modules.Hom[V := Term.Carrier, W := Target.Carrier higher, source := Term.space, target := Target.space higher].Map := Compose.compose after (SourceCurrent.Component[i := i].injection);
\definition pure[alpha: Left.Carrier p][beta: Right.Carrier q]: (first).apply (Term.tensor alpha beta) = (second).apply (Term.tensor alpha beta) :=
  Target.At[n := higher].ext ((first).apply (Term.tensor alpha beta)) ((second).apply (Term.tensor alpha beta))
    (\fun (x: TargetTotal.Carrier higher) => trans!{R} _ _ _ (TargetEquation[].law alpha beta x) (sym!{R} _ _ (SourceEquation[].law alpha beta x)));
\import Modules.Tensor[V := Left.Carrier p, W := Right.Carrier q, left := Left.space p, right := Right.space q].Universal[U := Target.Carrier higher, target := Target.space higher] \as TensorEquality;
\definition equality: first = second := TensorEquality.ext first second pure;
\definition law[z: Term.Carrier]: (before).apply ((SourceCurrent.Component[i := i].injection).apply z) = (after).apply ((SourceCurrent.Component[i := i].injection).apply z) :=
  congr!{{Modules.Hom[V := Term.Carrier, W := Target.Carrier higher, source := Term.space, target := Target.space higher].Map} {Target.Carrier higher}}
    (\fun (f: Modules.Hom[V := Term.Carrier, W := Target.Carrier higher, source := Term.space, target := Target.space higher].Map) => (f).apply z) _ _ equality;
