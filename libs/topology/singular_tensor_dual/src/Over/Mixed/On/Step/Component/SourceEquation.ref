\definition evaluation(x: TargetTotal.Carrier higher): Modules.Hom[V := SourceCarrier higher, W := R, source := SourceSpace higher, target := Modules.scalarModule].Map := Modules.Hom[V := SourceCarrier higher, W := R, source := SourceSpace higher, target := Modules.scalarModule].Map {
  apply := \fun (s: SourceCarrier higher) => #apply{(#apply{Next.forward} s)} x,
  addition := \fun (s, t: SourceCarrier higher) => congr!{{Target.Carrier higher} R} (\fun (f: Target.Carrier higher) => #apply{f} x) _ _ (#addition{Next.forward} s t),
  scalar := \fun (a: R)(s: SourceCarrier higher) => congr!{{Target.Carrier higher} R} (\fun (f: Target.Carrier higher) => #apply{f} x) _ _ (#scalar{Next.forward} a s),
};
\definition horizontal(alpha: Left.Carrier p)(beta: Right.Carrier q)(x: TargetTotal.Carrier higher):
  #apply{(evaluation x)} (#apply{SourceStep.horizontal} (#apply{SourceCurrent.Component[i := i].injection} (Term.tensor alpha beta))) = h alpha beta x :=
  trans!{R} _ _ _
    (congr!{{SourceCarrier higher} R} (#apply{(evaluation x)}) _ _ (SourceStep.horizontalOnInjection i (Term.tensor alpha beta)))
    (trans!{R} _ _ _
      (congr!{HTerm.Carrier R} (\fun (z: HTerm.Carrier) => #apply{(evaluation x)} (#apply{SourceNext.Component[i := horizontalIndex].injection} z)) _ _ (Differential.horizontalOnTensor alpha beta))
      (Next.pure horizontalIndex (Left.apply p alpha) beta x));
\import Modules.Hom[V := SourceCarrier higher, W := R, source := SourceSpace higher, target := Modules.scalarModule].Composition[U := VTerm.Carrier, domain := VTerm.space] \as Compose;
\definition verticalEvaluation(x: TargetTotal.Carrier higher): Modules.Hom[V := VTerm.Carrier, W := R, source := VTerm.space, target := Modules.scalarModule].Map := Compose.compose (evaluation x) (SourceNext.Component[i := verticalIndex].injection);
\import ScalarDouble.Sign[V := VTerm.Carrier, space := VTerm.space] \as Sign;
\import Sign.Mapping[W := R, target := Modules.scalarModule] \as SignMapping;
\definition vertical(alpha: Left.Carrier p)(beta: Right.Carrier q)(x: TargetTotal.Carrier higher):
  #apply{(evaluation x)} (#apply{SourceStep.vertical} (#apply{SourceCurrent.Component[i := i].injection} (Term.tensor alpha beta))) = v alpha beta x :=
  trans!{R} _ _ _
    (congr!{{SourceCarrier higher} R} (#apply{(evaluation x)}) _ _ (SourceStep.verticalOnInjection i (Term.tensor alpha beta)))
    (trans!{R} _ _ _
      (congr!{VTerm.Carrier R}
        (\fun (z: VTerm.Carrier) => #apply{(verticalEvaluation x)} (#apply{Sign.map p} z)) _ _ (Differential.verticalOnTensor alpha beta))
      (trans!{R} _ _ _ (SignMapping.naturality (verticalEvaluation x) p (VTerm.tensor alpha (Right.apply q beta)))
        (congr!{R R} (#apply{ScalarSign.map p}) _ _ (Next.pure verticalIndex alpha (Right.apply q beta) x))));
\definition law(alpha: Left.Carrier p)(beta: Right.Carrier q)(x: TargetTotal.Carrier higher):
  #apply{(#apply{Next.forward} (#apply{Source.differential} n (#apply{SourceCurrent.Component[i := i].injection} (Term.tensor alpha beta))))} x = add (h alpha beta x) (v alpha beta x) :=
  trans!{R} _ _ _
    (#addition{(evaluation x)}
      (#apply{SourceStep.horizontal} (#apply{SourceCurrent.Component[i := i].injection} (Term.tensor alpha beta)))
      (#apply{SourceStep.vertical} (#apply{SourceCurrent.Component[i := i].injection} (Term.tensor alpha beta))))
    (congr2!{R R R} add _ _ _ _ (horizontal alpha beta x) (vertical alpha beta x));
