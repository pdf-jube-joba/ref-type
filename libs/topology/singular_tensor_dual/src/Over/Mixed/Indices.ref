\definition toInteger(i: ScalarDouble.Index n): Double.Index n :=
  \into[Double.Pair](Double.Pair { first := #first{i}, second := #second{i} },
    { j: Double.Pair \where N.Basic[].Def[].add #first{j} #second{j} = n }) \by { ScalarDouble.degree n i };
\definition toScalar(i: Double.Index n): ScalarDouble.Index n :=
  \into[ScalarDouble.Pair](ScalarDouble.Pair { first := #first{i}, second := #second{i} },
    { j: ScalarDouble.Pair \where N.Basic[].Def[].add #first{j} #second{j} = n }) \by { Double.degree n i };
