\definition evaluation[x: V.Carrier]: Modules.Hom[V := Left.Carrier, W := R, source := Left.space, target := Modules.scalarModule].Map := Modules.Hom[V := Left.Carrier, W := R, source := Left.space, target := Modules.scalarModule].Map {
  apply := \fun (f: Left.Carrier) => (f).apply x,
  addition := \fun (f, g: Left.Carrier) => \refl(add ((f).apply x) ((g).apply x)),
  scalar := \fun (a: R)(f: Left.Carrier) => \refl(mul a ((f).apply x)),
};
\definition dual[f: Left.Carrier]: DualSum.sum Frame.indices (\fun (i: Frame.Index) => (Left.space).smul ((f).apply (Basis.basis i)) (Basis.coordinate i)) = f := Basis.dual f;
\import DualSum.Mapping[W := R, target := Modules.scalarModule] \as Evaluate;
\definition value[f: Left.Carrier][x: V.Carrier]: (f).apply x = ScalarSum.sum Frame.indices (\fun (i: Frame.Index) => mul ((Basis.coordinate i).apply x) ((f).apply (Basis.basis i))) :=
  trans!{R} _ _ _
    (sym!{R} _ _ (congr!{Left.Carrier R} (\fun (h: Left.Carrier) => (h).apply x) _ _ (dual f)))
    (trans!{R} _ _ _
      (Evaluate.law (evaluation x) Frame.indices (\fun (i: Frame.Index) => (Left.space).smul ((f).apply (Basis.basis i)) (Basis.coordinate i)))
      (ScalarSum.congruent Frame.indices
        (\fun (i: Frame.Index) => mul ((f).apply (Basis.basis i)) ((Basis.coordinate i).apply x))
        (\fun (i: Frame.Index) => mul ((Basis.coordinate i).apply x) ((f).apply (Basis.basis i)))
        (\fun (i: Frame.Index) => (ring).mulCommutative ((f).apply (Basis.basis i)) ((Basis.coordinate i).apply x))));
