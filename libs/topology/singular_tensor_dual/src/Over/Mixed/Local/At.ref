\import Modules.Hom[V := Target.Carrier, W := Right.Carrier, source := Target.space, target := Right.space] \as Restriction;
\definition map: Restriction.Map := Restriction.Map {
  apply := restriction i,
  addition := \fun (h, k: Target.Carrier) => RightMaps.ext (restriction i (#add{Target.space} h k)) (#add{Right.space} (restriction i h) (restriction i k))
    (\fun (y: W.Carrier) => \refl(add (#apply{h} (Primal.tensor (Basis.basis i) y)) (#apply{k} (Primal.tensor (Basis.basis i) y)))),
  scalar := \fun (a: R)(h: Target.Carrier) => RightMaps.ext (restriction i (#smul{Target.space} a h)) (#smul{Right.space} a (restriction i h))
    (\fun (y: W.Carrier) => \refl(mul a (#apply{h} (Primal.tensor (Basis.basis i) y)))),
};
\import Modules.Hom[V := Right.Carrier, W := Source.Carrier, source := Right.space, target := Source.space].Composition[U := Target.Carrier, domain := Target.space] \as Compose;
\definition piece: Modules.Hom[V := Target.Carrier, W := Source.Carrier, source := Target.space, target := Source.space].Map := Compose.compose (Source.rightLinear (Basis.coordinate i)) map;
