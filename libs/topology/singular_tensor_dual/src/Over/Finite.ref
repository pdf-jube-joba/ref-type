\import \parent.Dual[V := V] \as Dual;
\definition Index: \Set := Fin.Fin rank;
\definition indices: Lists.List[Index] := Fin.elements rank;
\import Modules.Sums[I := Index].Vector[V := V.Carrier, space := V.space] \as Sum;
\structure Data: \Set {
  basis: Index -> V.Carrier,
  coordinate: Index -> Dual.Carrier,
}
\structure Laws[data: Data]: \Prop {
  decomposition: \forall (x: V.Carrier) -> Sum.sum indices (\fun (i: Index) => #smul{V.space} (#apply{(data.coordinate i)} x) (data.basis i)) = x,
}
\definition Frame: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition decomposition(frame: Frame): \forall (x: V.Carrier) -> Sum.sum indices (\fun (i: Index) => #smul{V.space} (#apply{(frame.coordinate i)} x) (frame.basis i)) = x :=
  #decomposition{(\bysub(Data, { data: Data \where Laws[data] }, frame))};
\module Coordinates;

\import Modules.FiniteCoordinates[n := rank] \as NativeCoordinates;
\module FromIsomorphism(e: Modules.Isomorphism[V := V.Carrier, W := NativeCoordinates.Carrier, source := V.space, target := NativeCoordinates.space].Isomorphism);
