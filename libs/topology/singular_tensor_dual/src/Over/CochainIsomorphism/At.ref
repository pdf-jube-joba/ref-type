\import chain_complexes.CochainEquivalence[].Over[R := R, ring := Rings.commutativeRingAsRing R ring].Of[C := C, D := D].With[e := equivalence].At[n := n] \as Compared;
\import Cochains.At[C := C, k := n] \as Source;
\import Cochains.At[C := D, k := n] \as Target;
\definition isomorphism: Modules.Isomorphism[V := Source.Cohomology, W := Target.Cohomology,
  source := Source.cohomologySpace, target := Target.cohomologySpace].Isomorphism := Compared.isomorphism;
