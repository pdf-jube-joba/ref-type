\import \root.Over[R := R, ring := ring].Selected[P := C, Q := D, p := p, q := q] \as Source;
\import Chains.Map[C := C, D := P] \as LeftMaps;
\import Chains.Map[C := D, D := Q] \as RightMaps;
\import Double.Tensor[C := C, D := D] \as SourceTensor;
\import Double.Total[C := SourceTensor.complex] \as SourceTotal;
\import Double.Coordinates[C := SourceTensor.complex].Degree[n := n] \as SourceCoordinates;
\import Hom.On[P := SourceTotal.complex, N := scalars] \as SourceCochains;
\definition sourceChain: Chains.Complex := SourceTotal.complex;
\definition sourceComplex: NativeCochains.Complex := SourceCochains.complex;
\definition sourceCarrier(k: N.Nat^): \Set := Source.Carrier k;
\definition sourceSpace(k: N.Nat^): Modules.Space (sourceCarrier k) := Source.space k;
\module With(f: LeftMaps.Map, g: RightMaps.Map);
