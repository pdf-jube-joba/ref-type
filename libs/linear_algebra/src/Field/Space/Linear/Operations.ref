\import \parent.\parent.Laws[V := W, space := target] \as Laws;
\definition zeroMap: Map := Map {
  apply := \fun (x: _) => #zero{target},
  preservesAdd := \fun (x, y: _) => sym!{W} _ _ (Laws.zeroLeft (#zero{target})),
  preservesScale := \fun (a: _) (x: _) => sym!{W} _ _ (Laws.scaleZero a),
};
\definition plus(f, g: Map): Map := Map {
  apply := \fun (x: _) => #add{target} (#apply{f} x) (#apply{g} x),
  preservesAdd := \fun (x, y: _) => trans!{W} _ _ _
    (congr2!{W W W} (#add{target}) _ _ _ _ (#preservesAdd{f} x y) (#preservesAdd{g} x y))
    (Laws.shuffle (#apply{f} x) (#apply{f} y) (#apply{g} x) (#apply{g} y)),
  preservesScale := \fun (a: _) (x: _) => trans!{W} _ _ _
    (congr2!{W W W} (#add{target}) _ _ _ _ (#preservesScale{f} a x) (#preservesScale{g} a x))
    (sym!{W} _ _ (#vectorAdd{target} a (#apply{f} x) (#apply{g} x))),
};
\definition scale(a: K) (f: Map): Map := Map {
  apply := \fun (x: _) => #smul{target} a (#apply{f} x),
  preservesAdd := \fun (x, y: _) => trans!{W} _ _ _
    (congr!{W W} (#smul{target} a) _ _ (#preservesAdd{f} x y)) (#vectorAdd{target} a (#apply{f} x) (#apply{f} y)),
  preservesScale := \fun (c: _) (x: _) => trans!{W} _ _ _
    (congr!{W W} (#smul{target} a) _ _ (#preservesScale{f} c x)) (Laws.scaleComm a c (#apply{f} x)),
};
\definition negative(f: Map): Map := scale (neg one) f;
\definition preservesNeg: \forall (f: Map) (x: V) -> #apply{f} (#neg{source} x) = #neg{target} (#apply{f} x) :=
  \fun (f: Map) (x: V) => Laws.cancelLeft (#apply{f} x) _ _ (eq_reason!{
    {#add{target} (#apply{f} x) (#apply{f} (#neg{source} x))}
    "=" {#add{target} (#apply{f} (#neg{source} x)) (#apply{f} x)} "by" {Laws.comm _ _}
    "=" {#apply{f} (#add{source} (#neg{source} x) x)} "by" {sym!{W} _ _ (#preservesAdd{f} (#neg{source} x) x)}
    "=" {#apply{f} (#zero{source})} "by" {congr!{V W} (#apply{f}) _ _ (SourceLaws.inverseLeft x)}
    "=" {#zero{target}} "by" {#preservesZero{f}}
    "=" {#add{target} (#neg{target} (#apply{f} x)) (#apply{f} x)} "by" {sym!{W} _ _ (Laws.inverseLeft (#apply{f} x))}
    "=" {#add{target} (#apply{f} x) (#neg{target} (#apply{f} x))} "by" {Laws.comm _ _}
  });
