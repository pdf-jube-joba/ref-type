\definition Vector: \Set := I -> K;
\definition origin: Vector := \fun (i: _) => zero;
\definition plus(x, y: Vector): Vector := \fun (i: _) => add (x i) (y i);
\definition negative(x: Vector): Vector := \fun (i: _) => neg (x i);
\definition scale(a: K) (x: Vector): Vector := \fun (i: _) => mul a (x i);
\macro ext($f, $g, $proof) := \axiom:funext($f, $g, $proof);
\definition space: VectorSpace Vector := Ring.RingModule[K, Vector, ring] {
  zero := origin, add := plus, neg := negative, smul := scale,
  additive := Alg.CommutativeGroupLaws[Vector, Alg.CommutativeGroupData[Vector]::# (Alg.GroupData[Vector]::# origin plus negative)] {
    group := Alg.GroupLaws[Vector, Alg.GroupData[Vector]::# origin plus negative] {
      monoid := Monoid.MonoidLaws[Vector, Monoid.MonoidData[Vector]::# origin plus] {
        leftIdentity := \fun (x: _) => ext!{{plus origin x} {x} {\fun (i: _) => addZeroLeft (x i)}},
        rightIdentity := \fun (x: _) => ext!{{plus x origin} {x} {\fun (i: _) => addZeroRight (x i)}},
        associative := \fun (x, y, z: _) => ext!{{plus (plus x y) z} {plus x (plus y z)} {\fun (i: _) => addAssoc (x i) (y i) (z i)}},
      },
      leftInverse := \fun (x: _) => ext!{{plus (negative x) x} {origin} {\fun (i: _) => addNegLeft (x i)}},
      rightInverse := \fun (x: _) => ext!{{plus x (negative x)} {origin} {\fun (i: _) => addNegRight (x i)}},
    },
    commutative := \fun (x, y: _) => ext!{{plus x y} {plus y x} {\fun (i: _) => addComm (x i) (y i)}},
  },
  scalarOne := \fun (x: _) => ext!{{scale one x} {x} {\fun (i: _) => mulOneLeft (x i)}},
  scalarAssoc := \fun (a, b: _) (x: _) => ext!{{scale (mul a b) x} {scale a (scale b x)} {\fun (i: _) => mulAssoc a b (x i)}},
  scalarAdd := \fun (a, b: _) (x: _) => ext!{{scale (add a b) x} {plus (scale a x) (scale b x)} {\fun (i: _) => addMul a b (x i)}},
  vectorAdd := \fun (a: _) (x, y: _) => ext!{{scale a (plus x y)} {plus (scale a x) (scale a y)} {\fun (i: _) => mulAdd a (x i) (y i)}},
};
