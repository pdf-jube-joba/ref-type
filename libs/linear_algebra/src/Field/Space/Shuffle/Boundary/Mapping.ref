\import \parent.\parent.\parent.Shuffle[I := J] \as Target;
\import Target.Boundary[] \as Other;
\definition pulled(H: J -> Target.Function): I -> Function := \fun (i: I)(ys: Lists.List[I]) => H (map i) (Lists.map I J map ys);
\definition law: \forall (xs: Lists.List[I])(H: J -> Target.Function) -> Other.apply H (Lists.map I J map xs) = apply (pulled H) xs :=
  \induction (xs: Lists.List[I]) \return \forall (H: J -> Target.Function) -> Other.apply H (Lists.map I J map xs) = apply (pulled H) xs \with {
    | nil: \fun (H: J -> Target.Function) => \refl(zero)
    | cons: \fun (head: I)(tail: Lists.List[I])
      (previous: \forall (H: J -> Target.Function) -> Other.apply H (Lists.map I J map tail) = apply (pulled H) tail)(H: J -> Target.Function) =>
      congr!{K K} (\fun (v: K) => add (H (map head) (Lists.map I J map tail)) (neg v))
        (Other.apply (\fun (j: J) => Target.shift (map head) (H j)) (Lists.map I J map tail))
        (apply (pulled (\fun (j: J) => Target.shift (map head) (H j))) tail)
        (previous (\fun (j: J) => Target.shift (map head) (H j)))
  };
