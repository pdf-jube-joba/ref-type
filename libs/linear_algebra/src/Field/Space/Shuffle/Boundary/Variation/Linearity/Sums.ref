
\import \parent.\parent.\parent.\parent.\parent.Sums[I := T] \as Scalars;
\import Scalars.Prop[] \as ScalarLaws;
\import Scalars.Vector[V := J, space := target] \as VectorSums;
\import VectorSums.Mapping[W := K, target := scalarSpace] \as Evaluation;
\definition sumChange(indices: Lists.List[T])(weights: T -> K)(changes: T -> I -> J): I -> J :=
  \fun (v: I) => VectorSums.sum indices (\fun (t: T) => #smul{target} (weights t) (changes t v));
\definition headLaw: \forall (indices: Lists.List[T])(weights: T -> K)(changes: T -> I -> J)(f: Other.Function) -> Vectors.Linear f ->
  \forall (v: I)(tail: Lists.List[J]) -> f (Lists.List[J]::cons (sumChange indices weights changes v) tail) =
    Scalars.sum indices (\fun (t: T) => mul (weights t) (f (Lists.List[J]::cons (changes t v) tail))) :=
  \fun (indices: Lists.List[T])(weights: T -> K)(changes: T -> I -> J)(f: Other.Function)(linear: Vectors.Linear f)(v: I)(tail: Lists.List[J]) =>
    trans!{K} (f (Lists.List[J]::cons (sumChange indices weights changes v) tail))
      (Scalars.sum indices (\fun (t: T) => f (Lists.List[J]::cons (#smul{target} (weights t) (changes t v)) tail)))
      (Scalars.sum indices (\fun (t: T) => mul (weights t) (f (Lists.List[J]::cons (changes t v) tail))))
      (Evaluation.law (headMap f linear tail) indices (\fun (t: T) => #smul{target} (weights t) (changes t v)))
      (ScalarLaws.congruent indices (\fun (t: T) => f (Lists.List[J]::cons (#smul{target} (weights t) (changes t v)) tail))
        (\fun (t: T) => mul (weights t) (f (Lists.List[J]::cons (changes t v) tail)))
        (\fun (t: T) => #preservesScale{(headMap f linear tail)} (weights t) (changes t v)));
\definition Law(xs: Lists.List[I]): \Prop := \forall (indices: Lists.List[T])(weights: T -> K)(changes: T -> I -> J)(f: Other.Function) -> Vectors.Linear f ->
  insert (sumChange indices weights changes) f xs = Scalars.sum indices (\fun (t: T) => mul (weights t) (insert (changes t) f xs));
\module Step(xs: Lists.List[I]);
\definition law: \forall (xs: Lists.List[I]) -> Law xs :=
  \induction (xs: Lists.List[I]) \return Law xs \with {
    | nil: \fun (indices: Lists.List[T])(weights: T -> K)(changes: T -> I -> J)(f: Other.Function)(linear: Vectors.Linear f) =>
      trans!{K} zero (Scalars.sum indices (\fun (t: T) => zero)) (Scalars.sum indices (\fun (t: T) => mul (weights t) zero))
        (sym!{K} (Scalars.sum indices (\fun (t: T) => zero)) zero (ScalarLaws.zeroSum indices))
        (ScalarLaws.congruent indices (\fun (t: T) => zero) (\fun (t: T) => mul (weights t) zero)
          (\fun (t: T) => sym!{K} (mul (weights t) zero) zero (mulZeroRight (weights t))))
    | cons: \fun (head: I)(xs: Lists.List[I])(previous: Law xs) => Step[xs := xs].law previous head
  };
