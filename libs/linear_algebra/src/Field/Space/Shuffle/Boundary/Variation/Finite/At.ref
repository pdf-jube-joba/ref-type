\definition length: N.Nat^ := Lists.length I xs;
\import \parent.\parent.\parent.\parent.\parent.Sums[I := Fin.Fin length] \as Sums;
\import Sums.Prop[] \as Laws;
\import Laws.Mapping[J := Fin.Fin (N.Nat^::succ length)] \as Mapping;
\import \parent.\parent.\parent.\parent.\parent.Sums[I := Fin.Fin (N.Nat^::succ length)] \as Next;
\definition term(head: I)(change: I -> J)(f: Other.Function)(slot: Fin.Fin (N.Nat^::succ length)): K :=
  f (Replacement.apply (mapped (Lists.List[I]::cons head xs)) slot (change (SourceList.tuple (Lists.List[I]::cons head xs) slot)));
\definition headTerm: \forall (head: I)(change: I -> J)(f: Other.Function) -> term head change f (Fin.zero length) = f (Lists.List[J]::cons (change head) (mapped xs)) :=
  \fun (head: I)(change: I -> J)(f: Other.Function) => congr!{I K} (\fun (v: I) => f (Lists.List[J]::cons (change v) (mapped xs)))
    (SourceList.tuple (Lists.List[I]::cons head xs) (Fin.zero length)) head (Tuples.atZero length head (SourceList.tuple xs));
\definition tailTerm: \forall (head: I)(change: I -> J)(f: Other.Function)(slot: Fin.Fin length) ->
  term head change f (Fin.succ length slot) = Other.shift (map head) f (Replacement.apply (mapped xs) slot (change (SourceList.tuple xs slot))) :=
  \fun (head: I)(change: I -> J)(f: Other.Function)(slot: Fin.Fin length) => congr!{I K}
    (\fun (v: I) => f (Lists.List[J]::cons (map head) (Replacement.apply (mapped xs) slot (change v))))
    (SourceList.tuple (Lists.List[I]::cons head xs) (Fin.succ length slot)) (SourceList.tuple xs slot) (Tuples.atSuccessor length head (SourceList.tuple xs) slot);
\definition successor: \forall (head: I)(change: I -> J)(f: Other.Function) -> positional change f (Lists.List[I]::cons head xs) =
  add (f (Lists.List[J]::cons (change head) (mapped xs))) (positional change (Other.shift (map head) f) xs) :=
  \fun (head: I)(change: I -> J)(f: Other.Function) => congr2!{K K K} add
    (term head change f (Fin.zero length)) (f (Lists.List[J]::cons (change head) (mapped xs)))
    (Next.sum (Lists.map (Fin.Fin length) (Fin.Fin (N.Nat^::succ length)) (Fin.succ length) (Fin.elements length)) (term head change f))
    (positional change (Other.shift (map head) f) xs) (headTerm head change f)
    (trans!{K}
      (Next.sum (Lists.map (Fin.Fin length) (Fin.Fin (N.Nat^::succ length)) (Fin.succ length) (Fin.elements length)) (term head change f))
      (Sums.sum (Fin.elements length) (\fun (slot: Fin.Fin length) => term head change f (Fin.succ length slot)))
      (positional change (Other.shift (map head) f) xs)
      (Mapping.sumMap (Fin.elements length) (Fin.succ length) (term head change f))
      (Laws.congruent (Fin.elements length) (\fun (slot: Fin.Fin length) => term head change f (Fin.succ length slot))
        (\fun (slot: Fin.Fin length) => Other.shift (map head) f (Replacement.apply (mapped xs) slot (change (SourceList.tuple xs slot))))
        (tailTerm head change f)));
