
\definition law: Law xs -> \forall (head: I) -> Law (Lists.List[I]::cons head xs) :=
  \fun (previous: Law xs)(head: I)(indices: Lists.List[T])(weights: T -> K)(changes: T -> I -> J)(f: Other.Function)(linear: Vectors.Linear f) =>
    eq_reason!{
      {insert (sumChange indices weights changes) f (Lists.List[I]::cons head xs)}
      "=" {add (Scalars.sum indices (\fun (t: T) => mul (weights t) (f (Lists.List[J]::cons (changes t head) (mapped xs)))))
        (Scalars.sum indices (\fun (t: T) => mul (weights t) (insert (changes t) (Other.shift (map head) f) xs)))} "by" {
          congr2!{K K K} add
            (f (Lists.List[J]::cons (sumChange indices weights changes head) (mapped xs)))
            (Scalars.sum indices (\fun (t: T) => mul (weights t) (f (Lists.List[J]::cons (changes t head) (mapped xs)))))
            (insert (sumChange indices weights changes) (Other.shift (map head) f) xs)
            (Scalars.sum indices (\fun (t: T) => mul (weights t) (insert (changes t) (Other.shift (map head) f) xs)))
            (headLaw indices weights changes f linear head (mapped xs))
            (previous indices weights changes (Other.shift (map head) f) (Vectors.shiftedLinear f linear (map head)))}
      "=" {Scalars.sum indices (\fun (t: T) => add (mul (weights t) (f (Lists.List[J]::cons (changes t head) (mapped xs))))
        (mul (weights t) (insert (changes t) (Other.shift (map head) f) xs)))} "by" {
          sym!{K}
            (Scalars.sum indices (\fun (t: T) => add (mul (weights t) (f (Lists.List[J]::cons (changes t head) (mapped xs)))) (mul (weights t) (insert (changes t) (Other.shift (map head) f) xs))))
            (add (Scalars.sum indices (\fun (t: T) => mul (weights t) (f (Lists.List[J]::cons (changes t head) (mapped xs)))))
              (Scalars.sum indices (\fun (t: T) => mul (weights t) (insert (changes t) (Other.shift (map head) f) xs))))
            (ScalarLaws.additive indices (\fun (t: T) => mul (weights t) (f (Lists.List[J]::cons (changes t head) (mapped xs))))
              (\fun (t: T) => mul (weights t) (insert (changes t) (Other.shift (map head) f) xs)))}
      "=" {Scalars.sum indices (\fun (t: T) => mul (weights t) (insert (changes t) f (Lists.List[I]::cons head xs)))} "by" {
        ScalarLaws.congruent indices
          (\fun (t: T) => add (mul (weights t) (f (Lists.List[J]::cons (changes t head) (mapped xs)))) (mul (weights t) (insert (changes t) (Other.shift (map head) f) xs)))
          (\fun (t: T) => mul (weights t) (insert (changes t) f (Lists.List[I]::cons head xs)))
          (\fun (t: T) => sym!{K}
            (mul (weights t) (insert (changes t) f (Lists.List[I]::cons head xs)))
            (add (mul (weights t) (f (Lists.List[J]::cons (changes t head) (mapped xs)))) (mul (weights t) (insert (changes t) (Other.shift (map head) f) xs)))
            (mulAdd (weights t) (f (Lists.List[J]::cons (changes t head) (mapped xs))) (insert (changes t) (Other.shift (map head) f) xs)))}
    };
