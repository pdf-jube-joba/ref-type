\import \parent.\parent.Sums[I := Fin.Fin n] \as Sums;
\use Logic::either;
\definition occursToKey: \forall (xs: Lists.List[Fin.Fin n])(i: Fin.Fin n) -> Fin.Occurs n i xs -> \In[Fin.Fin n] (Sums.keys xs) i :=
  \induction (xs: Lists.List[Fin.Fin n]) \return \forall (i: Fin.Fin n) -> Fin.Occurs n i xs -> \In[Fin.Fin n] (Sums.keys xs) i \with {
    | nil: \fun (i: Fin.Fin n)(empty: Logic.False) => empty
    | cons: \fun (head: Fin.Fin n)(tail: Lists.List[Fin.Fin n])
      (previous: \forall (i: Fin.Fin n) -> Fin.Occurs n i tail -> \In[Fin.Fin n] (Sums.keys tail) i)(i: Fin.Fin n)
      (member: Logic.Or[i = head, Fin.Occurs n i tail]) => either!{member {\In[Fin.Fin n] (Sums.keys (Lists.List[Fin.Fin n]::cons head tail)) i}
        {\fun (same: i = head) => Logic.Or[_, _]::left same}
        {\fun (old: Fin.Occurs n i tail) => Logic.Or[_, _]::right (previous i old)}
      }
  };
\definition exhaustive: \forall (i: Fin.Fin n) -> \In[Fin.Fin n] (Sums.keys (Fin.elements n)) i :=
  \fun (i: Fin.Fin n) => occursToKey (Fin.elements n) i (Fin.exhaustive n i);
