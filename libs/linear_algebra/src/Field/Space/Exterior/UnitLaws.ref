\import \parent.Unit[] \as Unit;
\import \parent.Degrees[p := N.Nat^::zero, q := k] \as Left;
\import \parent.Degrees[p := k, q := N.Nat^::zero] \as Right;
\import \parent.Components[k := k] \as Components;
\import Shuffle.Laws[] \as Laws;
\definition left: \forall (f: Form k) -> component (Nat.add N.Nat^::zero k) (Left.wedge unit f) = component k f :=
  \fun (f: Form k) => eq_reason!{
    {component (Nat.add N.Nat^::zero k) (Left.wedge unit f)} "=" {Shuffle.product (component N.Nat^::zero unit) (component k f)} "by" {Left.componentWedge unit f}
    "=" {Shuffle.product Shuffle.unit (component k f)} "by" {congr!{Series Series} (\fun (h: Series) => Shuffle.product h (component k f)) _ _ Unit.componentUnit}
    "=" {component k f} "by" {\axiom:funext(Shuffle.product Shuffle.unit (component k f), component k f, \fun (xs: Lists.List[V]) => Laws.leftUnit xs (component k f))}
  };
\definition rightComponents: \forall (f: Form k) -> component k (Right.wedge f unit) = component k f :=
  \fun (f: Form k) => eq_reason!{
    {component k (Right.wedge f unit)} "=" {Shuffle.product (component k f) (component N.Nat^::zero unit)} "by" {Right.componentWedge f unit}
    "=" {Shuffle.product (component k f) Shuffle.unit} "by" {congr!{Series Series} (Shuffle.product (component k f)) _ _ Unit.componentUnit}
    "=" {component k f} "by" {\axiom:funext(Shuffle.product (component k f) Shuffle.unit, component k f, \fun (xs: Lists.List[V]) => Laws.rightUnit xs (component k f))}
  };
\definition right: \forall (f: Form k) -> Right.wedge f unit = f := \fun (f: Form k) => Components.ext (Right.wedge f unit) f (rightComponents f);
