\import \parent.Degrees[p := p, q := q] \as Forward;
\import \parent.Degrees[p := q, q := p] \as Reverse;
\import Multilinear.ListSeries[k := p] \as Left;
\import Multilinear.ListSeries[k := q] \as Right;
\import Shuffle.Graded[p := p, q := q] \as Graded;
\import \parent.\parent.Sign[] \as Sign;
\definition law: \forall (f: Form p)(g: Form q) -> component (Nat.add q p) (Reverse.wedge g f) = Shuffle.scale (Sign.value (Nat.mul p q)) (component (Nat.add p q) (Forward.wedge f g)) :=
  \fun (f: Form p)(g: Form q) => eq_reason!{
    {component (Nat.add q p) (Reverse.wedge g f)} "=" {Shuffle.product (component q g) (component p f)} "by" {Reverse.componentWedge g f}
    "=" {Shuffle.scale (Sign.value (Nat.mul p q)) (Shuffle.product (component p f) (component q g))} "by" {
      \axiom:funext(Shuffle.product (component q g) (component p f), Shuffle.scale (Sign.value (Nat.mul p q)) (Shuffle.product (component p f) (component q g)),
        Graded.commutative (component p f) (component q g) (Left.outside f) (Right.outside g))}
    "=" {Shuffle.scale (Sign.value (Nat.mul p q)) (component (Nat.add p q) (Forward.wedge f g))} "by" {
      congr!{Series Series} (Shuffle.scale (Sign.value (Nat.mul p q))) _ _ (sym!{Series} _ _ (Forward.componentWedge f g))}
  };
