\definition extendList: \forall (head: V)(tail: Arguments k) ->
  TuplesList.list (N.Nat^::succ k) (Tuples.extend k head tail) = Lists.List[V]::cons head (TuplesList.list k tail) :=
  \fun (head: V)(tail: Arguments k) => congr2!{V {Lists.List[V]} {Lists.List[V]}} Lists.List[V]::cons _ _ _ _
    (Tuples.atZero k head tail)
    (congr!{{Arguments k} {Lists.List[V]}} (TuplesList.list k) (\fun (j: Fin.Fin k) => Tuples.extend k head tail (Fin.succ k j)) tail
      (\axiom:funext((\fun (j: Fin.Fin k) => Tuples.extend k head tail (Fin.succ k j)), tail, \fun (j: Fin.Fin k) => Tuples.atSuccessor k head tail j)));
\definition extended: (\forall (arguments: Arguments k)(i: Fin.Fin k)(value: V) ->
  TuplesList.list k (update k arguments i value) = Replace.apply (TuplesList.list k arguments) i value) ->
  \forall (head: V)(tail: Arguments k)(i: Fin.Fin (N.Nat^::succ k))(value: V) ->
    TuplesList.list (N.Nat^::succ k) (update (N.Nat^::succ k) (Tuples.extend k head tail) i value) = Replace.apply (TuplesList.list (N.Nat^::succ k) (Tuples.extend k head tail)) i value :=
  \fun (previous: \forall (arguments: Arguments k)(i: Fin.Fin k)(value: V) -> TuplesList.list k (update k arguments i value) = Replace.apply (TuplesList.list k arguments) i value)
    (head: V)(tail: Arguments k)(i: Fin.Fin (N.Nat^::succ k))(value: V) =>
    either!{{i = N.Nat^::zero} "or" {\exists { j: Fin.Fin k \where i = N.Nat^::succ j }} "either" {
      TuplesList.list (N.Nat^::succ k) (update (N.Nat^::succ k) (Tuples.extend k head tail) i value) = Replace.apply (TuplesList.list (N.Nat^::succ k) (Tuples.extend k head tail)) i value}
      "lt:" {\fun (equal: i = N.Nat^::zero) =>
        \idelim Fin.zero k = i \with index: Fin.Fin (N.Nat^::succ k) =>
          TuplesList.list (N.Nat^::succ k) (update (N.Nat^::succ k) (Tuples.extend k head tail) index value) = Replace.apply (TuplesList.list (N.Nat^::succ k) (Tuples.extend k head tail)) index value
          \by { base: eq_reason!{
            {TuplesList.list (N.Nat^::succ k) (update (N.Nat^::succ k) (Tuples.extend k head tail) (Fin.zero k) value)}
            "=" {TuplesList.list (N.Nat^::succ k) (Tuples.extend k value tail)} "by" {congr!{{Arguments (N.Nat^::succ k)} {Lists.List[V]}} (TuplesList.list (N.Nat^::succ k)) _ _ (Properties.extendHead k head tail value)}
            "=" {Lists.List[V]::cons value (TuplesList.list k tail)} "by" {extendList value tail}
            "=" {Replace.apply (TuplesList.list (N.Nat^::succ k) (Tuples.extend k head tail)) N.Nat^::zero value} "by" {
              sym!{{Lists.List[V]}} _ _ (congr!{{Lists.List[V]} {Lists.List[V]}} (\fun (xs: Lists.List[V]) => Replace.apply xs N.Nat^::zero value) _ _ (extendList head tail))}
          }, equality: sym!{{Fin.Fin (N.Nat^::succ k)}} i (Fin.zero k) equal }}
      "rt:" {\block {
        \fun (exists: \exists { j: Fin.Fin k \where i = N.Nat^::succ j }) \then
        \takefrom j: \Cast[Fin.Fin k] ({ j: Fin.Fin k \where i = N.Nat^::succ j }) \by exists \then
        \let equal: i = Fin.succ k j := \bysub(Fin.Fin k, { j: Fin.Fin k \where i = N.Nat^::succ j }, j) \then
        \return \idelim Fin.succ k j = i \with index: Fin.Fin (N.Nat^::succ k) =>
          TuplesList.list (N.Nat^::succ k) (update (N.Nat^::succ k) (Tuples.extend k head tail) index value) = Replace.apply (TuplesList.list (N.Nat^::succ k) (Tuples.extend k head tail)) index value
          \by { base: eq_reason!{
            {TuplesList.list (N.Nat^::succ k) (update (N.Nat^::succ k) (Tuples.extend k head tail) (Fin.succ k j) value)}
            "=" {TuplesList.list (N.Nat^::succ k) (Tuples.extend k head (update k tail j value))} "by" {congr!{{Arguments (N.Nat^::succ k)} {Lists.List[V]}} (TuplesList.list (N.Nat^::succ k)) _ _ (Properties.extendUpdate k head tail j value)}
            "=" {Lists.List[V]::cons head (TuplesList.list k (update k tail j value))} "by" {extendList head (update k tail j value)}
            "=" {Lists.List[V]::cons head (Replace.apply (TuplesList.list k tail) j value)} "by" {congr!{{Lists.List[V]} {Lists.List[V]}} (Lists.List[V]::cons head) _ _ (previous tail j value)}
            "=" {Replace.apply (TuplesList.list (N.Nat^::succ k) (Tuples.extend k head tail)) (N.Nat^::succ j) value} "by" {
              sym!{{Lists.List[V]}} _ _ (congr!{{Lists.List[V]} {Lists.List[V]}} (\fun (xs: Lists.List[V]) => Replace.apply xs (N.Nat^::succ j) value) _ _ (extendList head tail))}
          }, equality: sym!{{Fin.Fin (N.Nat^::succ k)}} i (Fin.succ k j) equal }
      }}} (Fin.successorCases k i (Fin.bound (N.Nat^::succ k) i));
\definition law: (\forall (arguments: Arguments k)(i: Fin.Fin k)(value: V) -> TuplesList.list k (update k arguments i value) = Replace.apply (TuplesList.list k arguments) i value) ->
  \forall (arguments: Arguments (N.Nat^::succ k))(i: Fin.Fin (N.Nat^::succ k))(value: V) ->
    TuplesList.list (N.Nat^::succ k) (update (N.Nat^::succ k) arguments i value) = Replace.apply (TuplesList.list (N.Nat^::succ k) arguments) i value :=
  \fun (previous: \forall (arguments: Arguments k)(i: Fin.Fin k)(value: V) -> TuplesList.list k (update k arguments i value) = Replace.apply (TuplesList.list k arguments) i value)
    (arguments: Arguments (N.Nat^::succ k))(i: Fin.Fin (N.Nat^::succ k))(value: V) =>
    \idelim Tuples.extend k (arguments (Fin.zero k)) (\fun (j: Fin.Fin k) => arguments (Fin.succ k j)) = arguments
      \with f: Arguments (N.Nat^::succ k) => TuplesList.list (N.Nat^::succ k) (update (N.Nat^::succ k) f i value) = Replace.apply (TuplesList.list (N.Nat^::succ k) f) i value
      \by { base: extended previous (arguments (Fin.zero k)) (\fun (j: Fin.Fin k) => arguments (Fin.succ k j)) i value, equality: Tuples.recover k arguments };
