\import Fin.Transposition[n := k, a := #first{s}, b := #second{s}] \as Swap;
\import \parent.\parent.TwoSlots[k := k, i := #first{s}, j := #second{s}] \as Slots;
\definition distinct: \forall (arguments: Arguments k) -> Logic.Not (#first{s} = #second{s}) -> transpose s arguments = Slots.swap arguments :=
  \fun (arguments: Arguments k)(different: Logic.Not (#first{s} = #second{s})) => \axiom:funext(transpose s arguments, Slots.swap arguments,
    \fun (i: Fin.Fin k) => Bool.cases2
      (\fun (first, second: Bool.Bool^) => Nat.eqb i #first{s} = first -> Nat.eqb i #second{s} = second ->
        arguments (Bool.ite (Fin.Fin k) first #second{s} (Bool.ite (Fin.Fin k) second #first{s} i)) =
        Bool.ite V second (arguments #first{s}) (Bool.ite V first (arguments #second{s}) (arguments i)))
      (\fun (first: Nat.eqb i #first{s} = Bool.Bool^::false)(second: Nat.eqb i #second{s} = Bool.Bool^::false) => \refl(arguments i))
      (\fun (first: Nat.eqb i #first{s} = Bool.Bool^::false)(second: Nat.eqb i #second{s} = Bool.Bool^::true) => \refl(arguments #first{s}))
      (\fun (first: Nat.eqb i #first{s} = Bool.Bool^::true)(second: Nat.eqb i #second{s} = Bool.Bool^::false) => \refl(arguments #second{s}))
      (\fun (first: Nat.eqb i #first{s} = Bool.Bool^::true)(second: Nat.eqb i #second{s} = Bool.Bool^::true) =>
        Logic.falseElim (arguments #second{s} = arguments #first{s})
          (different (trans!{{Fin.Fin k}} #first{s} i #second{s}
            (sym!{{Fin.Fin k}} i #first{s} (NatLaws.eqOfEqbTrue #first{s} i first)) (NatLaws.eqOfEqbTrue #second{s} i second))))
      (Nat.eqb i #first{s}) (Nat.eqb i #second{s}) (\refl(Nat.eqb i #first{s})) (\refl(Nat.eqb i #second{s})));
\definition repeated: \forall (arguments: Arguments k) -> #first{s} = #second{s} -> transpose s arguments = arguments :=
  \fun (arguments: Arguments k)(same: #first{s} = #second{s}) => \axiom:funext(transpose s arguments, arguments,
    \fun (i: Fin.Fin k) => Bool.cases2
      (\fun (first, second: Bool.Bool^) => Nat.eqb i #first{s} = first -> Nat.eqb i #second{s} = second ->
        arguments (Bool.ite (Fin.Fin k) first #second{s} (Bool.ite (Fin.Fin k) second #first{s} i)) = arguments i)
      (\fun (first: _)(second: _) => \refl(arguments i))
      (\fun (first: _)(second: _) => congr!{{Fin.Fin k} V} arguments #first{s} i
        (trans!{{Fin.Fin k}} #first{s} #second{s} i same (sym!{{Fin.Fin k}} i #second{s} (NatLaws.eqOfEqbTrue #second{s} i second))))
      (\fun (first: _)(second: _) => congr!{{Fin.Fin k} V} arguments #second{s} i
        (trans!{{Fin.Fin k}} #second{s} #first{s} i (sym!{{Fin.Fin k}} #first{s} #second{s} same)
          (sym!{{Fin.Fin k}} i #first{s} (NatLaws.eqOfEqbTrue #first{s} i first))))
      (\fun (first: _)(second: _) => congr!{{Fin.Fin k} V} arguments #second{s} i (sym!{{Fin.Fin k}} i #second{s} (NatLaws.eqOfEqbTrue #second{s} i second)))
      (Nat.eqb i #first{s}) (Nat.eqb i #second{s}) (\refl(Nat.eqb i #first{s})) (\refl(Nat.eqb i #second{s})));
\definition law: \forall (f: Form k)(arguments: Arguments k) -> f (transpose s arguments) = multiplier s (f arguments) :=
  \fun (f: Form k)(arguments: Arguments k) => Bool.cases
    (\fun (test: Bool.Bool^) => Nat.eqb #first{s} #second{s} = test -> f (transpose s arguments) = Bool.ite K test (f arguments) (neg (f arguments)))
    (\fun (testFalse: Nat.eqb #first{s} #second{s} = Bool.Bool^::false) => trans!{K} (f (transpose s arguments)) (f (Slots.swap arguments)) (neg (f arguments))
      (congr!{{Arguments k} K} f (transpose s arguments) (Slots.swap arguments)
        (distinct arguments (\fun (same: #first{s} = #second{s}) => BoolLaws.falseNeTrue
          (trans!{{Bool.Bool^}} Bool.Bool^::false (Nat.eqb #first{s} #second{s}) Bool.Bool^::true
            (sym!{{Bool.Bool^}} (Nat.eqb #first{s} #second{s}) Bool.Bool^::false testFalse) (NatLaws.eqbTrueOfEq #first{s} #second{s} same)))))
      (Slots.onSwap f arguments (\fun (same: #first{s} = #second{s}) => BoolLaws.falseNeTrue
        (trans!{{Bool.Bool^}} Bool.Bool^::false (Nat.eqb #first{s} #second{s}) Bool.Bool^::true
          (sym!{{Bool.Bool^}} (Nat.eqb #first{s} #second{s}) Bool.Bool^::false testFalse) (NatLaws.eqbTrueOfEq #first{s} #second{s} same)))))
    (\fun (testTrue: Nat.eqb #first{s} #second{s} = Bool.Bool^::true) => congr!{{Arguments k} K} f (transpose s arguments) arguments
      (repeated arguments (NatLaws.eqOfEqbTrue #second{s} #first{s} testTrue)))
    (Nat.eqb #first{s} #second{s}) (\refl(Nat.eqb #first{s} #second{s}));
