\import \parent.\parent.Contraction[k := N.Nat^::succ k] \as First;
\definition law: \forall (f: Form (N.Nat^::succ (N.Nat^::succ k)))(x: V) -> apply (First.apply f x) x = Target.origin :=
  \fun (f: Form (N.Nat^::succ (N.Nat^::succ k)))(x: V) => Target.ext (apply (First.apply f x) x) Target.origin
    (\fun (arguments: Arguments k) => First.repeated f x (Tuples.extend k x arguments) (Fin.zero k) (Tuples.atZero k x arguments));
