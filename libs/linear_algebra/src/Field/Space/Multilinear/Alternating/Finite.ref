\import \parent.\parent.Finite[I := I, b := b] \as Multilinear;
\definition coefficients(k: N.Nat^)(f: Form k): (Fin.Fin k -> I) -> K := Multilinear.coefficients k (asMultilinear k f);
\definition basisExt: \forall (k: N.Nat^)(f, g: Form k) ->
  (\forall (indices: Fin.Fin k -> I) -> coefficients k f indices = coefficients k g indices) -> f = g :=
  \fun (k: N.Nat^)(f, g: Form k)(same: \forall (indices: Fin.Fin k -> I) -> coefficients k f indices = coefficients k g indices) =>
    Multilinear.basisExt k (asMultilinear k f) (asMultilinear k g) same;
\definition expansion(k: N.Nat^)(f: Form k)(arguments: Arguments k): K := Multilinear.expansion k (asMultilinear k f) arguments;
\definition expansionLaw: \forall (k: N.Nat^)(f: Form k)(arguments: Arguments k) -> expansion k f arguments = f arguments :=
  \fun (k: N.Nat^)(f: Form k)(arguments: Arguments k) => Multilinear.expansionLaw k (asMultilinear k f) arguments;
