\import \parent.Linear[V := V, W := V, source := space, target := space] \as End;
\structure BilinearData: \Set {
  form: V -> V -> K,
}
\structure BilinearLaws[data: BilinearData]: \Prop {
  zeroLeft: \forall (x: V) -> data.form (#zero{space}) x = zero,
  zeroRight: \forall (x: V) -> data.form x (#zero{space}) = zero,
  addLeft: \forall (x, y, z: V) -> data.form (#add{space} x y) z = add (data.form x z) (data.form y z),
  addRight: \forall (x, y, z: V) -> data.form x (#add{space} y z) = add (data.form x y) (data.form x z),
  scaleLeft: \forall (a: K) (x, y: V) -> data.form (#smul{space} a x) y = mul a (data.form x y),
  scaleRight: \forall (a: K) (x, y: V) -> data.form x (#smul{space} a y) = mul a (data.form x y),
}
\definition Bilinear: \Set := \Cast[BilinearData] ({ data: BilinearData \where BilinearLaws[data] });
\definition Symmetric(h: Bilinear): \Prop := \forall (x, y: V) -> #form{h} x y = #form{h} y x;
\definition Alternating(h: Bilinear): \Prop := \forall (x: V) -> #form{h} x x = zero;
\definition Nondegenerate(h: Bilinear): \Prop := \forall (x: V) -> (\forall (y: V) -> #form{h} x y = zero) -> x = #zero{space};
\definition Adjoint(h: Bilinear) (f, g: End.Map): \Prop :=
  \forall (x, y: V) -> #form{h} (#apply{f} x) y = #form{h} x (#apply{g} y);
\definition SelfAdjoint(h: Bilinear) (f: End.Map): \Prop := Adjoint h f f;
