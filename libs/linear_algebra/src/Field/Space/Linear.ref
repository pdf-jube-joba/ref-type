\import \parent.Laws[V := V, space := source] \as SourceLaws;
\import \parent.Laws[V := W, space := target] \as TargetLaws;
\structure MapData: \Set {
  apply: V -> W,
}
\structure MapLaws[data: MapData]: \Prop {
  preservesAdd: \forall (x, y: V) -> data.apply (#add{source} x y) = #add{target} (data.apply x) (data.apply y),
  preservesZero: data.apply (#zero{source}) = #zero{target} :=
    TargetLaws.idempotentZero (data.apply (#zero{source}))
      (trans!{W} _ _ _
        (sym!{W} _ _ (preservesAdd (#zero{source}) (#zero{source})))
        (congr!{V W} data.apply _ _ (SourceLaws.zeroLeft (#zero{source})))),
  preservesScale: \forall (a: K) (x: V) -> data.apply (#smul{source} a x) = #smul{target} a (data.apply x),
}
\definition Map: \Set := \Cast[MapData] ({ data: MapData \where MapLaws[data] });
\module Composition(U: \Set, domain: VectorSpace U) {
  \import \parent.\parent.Linear[V := U, W := V, source := domain, target := source] \as Before;
  \import \parent.\parent.Linear[V := U, W := W, source := domain, target := target] \as Result;
  \definition compose(f: Map) (g: Before.Map): Result.Map := Result.Map {
    apply := \fun (x: _) => #apply{f} (#apply{g} x),
    preservesAdd := \fun (x, y: _) => trans!{W} _ _ _
      (congr!{V W} (#apply{f}) _ _ (#preservesAdd{g} x y)) (#preservesAdd{f} (#apply{g} x) (#apply{g} y)),
    preservesScale := \fun (a: _) (x: _) => trans!{W} _ _ _
      (congr!{V W} (#apply{f}) _ _ (#preservesScale{g} a x)) (#preservesScale{f} a (#apply{g} x)),
  };
}
\module Operations;

\definition dataEta: \forall (data: MapData) -> MapData::# (#apply{data}) = data :=
  \induction (data: MapData) \return MapData::# (#apply{data}) = data \with {
    | # : \fun (f: V -> W) => \refl(MapData::# f)
  };
\definition ext: \forall (f, g: Map) -> #apply{f} = #apply{g} -> f = g :=
  \fun (f, g: Map)(same: #apply{f} = #apply{g}) => trans!{{MapData}} f (MapData::# (#apply{f})) g
    (sym!{{MapData}} (MapData::# (#apply{f})) f (dataEta f))
    (trans!{{MapData}} (MapData::# (#apply{f})) (MapData::# (#apply{g})) g
      (congr!{{V -> W} {MapData}} MapData::# (#apply{f}) (#apply{g}) same) (dataEta g));

\import algebra.Module[].Over[R := K, ring := Ring.commutativeRingAsRing K (Fields.fieldAsCommutativeRing K field)].Hom[V := V, W := W, source := source, target := target] \as ModuleMaps;
\definition asModuleMap(f: Map): ModuleMaps.Map := ModuleMaps.Map {
  apply := #apply{f}, addition := #preservesAdd{f}, scalar := #preservesScale{f},
};
\definition fromModuleMap(f: ModuleMaps.Map): Map := Map {
  apply := #apply{f}, preservesAdd := #addition{f}, preservesScale := #scalar{f},
};
\definition moduleRoundTrip: \forall (f: ModuleMaps.Map) -> asModuleMap (fromModuleMap f) = f :=
  \fun (f: ModuleMaps.Map) => ModuleMaps.ext (asModuleMap (fromModuleMap f)) f (\fun (x: V) => \refl(#apply{f} x));
\definition linearRoundTrip: \forall (f: Map) -> fromModuleMap (asModuleMap f) = f :=
  \fun (f: Map) => ext (fromModuleMap (asModuleMap f)) f (\refl(#apply{f}));
