\import Algebra.Finite[V := V, I := I, space := space] \as Finite;
\import Finite.Dimension[].Comparison[J := I] \as Comparison;
\definition invariant: \forall (b, c: Finite.Basis) -> Finite.dimension b = Finite.dimension c :=
  \fun (b, c: Finite.Basis) => injective (Finite.dimension b) (Finite.dimension c) (Comparison.equalScalarDimension b c);
\module Reindex(J: \Set) {
  \import Finite.Dimension[].Comparison[J := J] \as Comparison;
  \import Algebra.Finite[V := V, I := J, space := space] \as Other;
  \definition invariant: \forall (b: Finite.Basis) (c: Other.Basis) -> Finite.dimension b = Other.dimension c :=
    \fun (b: Finite.Basis) (c: Other.Basis) => injective (Finite.dimension b) (Other.dimension c) (Comparison.equalScalarDimension b c);
}
