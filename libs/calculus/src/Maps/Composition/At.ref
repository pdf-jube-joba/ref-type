\import \parent.\parent.Differential[U := U, V := V, f := f, a := a] \as Jacobian;
\import TargetSmooth.Differential[] \as Outer;
\import Source.Analysis[] \as Analysis;
\import Analysis.Properties[] \as AnalysisLaws;
\import Target.Analysis[] \as TargetAnalysis;
\import Reals.Multivariable[n := n].Differential[].Def[] \as ScalarMaps;
\import \parent.\parent.\parent.Vector[n := n, m := m] \as Vector;
\import Vector.Chain[U := U, V := V, f := apply U V f, a := a, d := Jacobian.value, g := h, e := Outer.value V h (apply U V f a)] \as Chain;
\import real.Analysis[].FiniteSums[] \as FiniteSums;
\import Reals.Multivariable[n := n].Space[].Def[] \as Coordinates;
\definition law: Analysis.HasDifferentialAt U (scalar h) a Chain.differential :=
  Chain.law Jacobian.vectorLaw (Outer.law V h (apply U V f a));
\module Coordinate(i: Fin.Fin n);
\definition partial: \forall (i: Fin.Fin n) -> Analysis.HasPartialDerivativeAt U (scalar h) i a (gradient h i a) :=
  \fun (i: Fin.Fin n) => Coordinate[i := i].law;
