\import \parent.\parent.Differential[U := U, V := W, f := g, a := a] \as Other;
\definition first: Vector.Function U := \fun (x: Source.Carrier U) => apply U V f x;
\definition second: Vector.Function U := \fun (x: Source.Carrier U) => apply U W g x;
\definition equal: first = second -> value = Other.value := \block {
  \fun (same: first = second) \then
  \let otherLaw: Vector.HasDifferentialAt U first a Other.value :=
    \idelim second = first \with h: Vector.Function U => Vector.HasDifferentialAt U h a Other.value \by {
      base: Other.vectorLaw, equality: sym!{{Vector.Function U}} first second same
    } \then
  \return Vector.Differential[U := U, f := first, a := a, d := value].uniqueness Other.value vectorLaw otherLaw
};
