\import real.DedekindReal[] \as R;
\import R.Arithmetic[].Def[] \as Arithmetic;
\import R.Arithmetic[].Prop[] \as Laws;
\import topology.RealMetric[] \as Metric;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason;

\definition Real: \Set := R.Real;
\definition zero: Real := Arithmetic.zero;
\definition one: Real := Arithmetic.one;
\definition add: Real -> Real -> Real := Arithmetic.add;
\definition sub: Real -> Real -> Real := Arithmetic.sub;
\definition mul: Real -> Real -> Real := Laws.fieldMul;
\definition inv: Real -> Real := Laws.fieldInv;
\definition distance: Real -> Real -> Real := Metric.distance;

\definition constant(c: Real): Real -> Real := \fun (x: _) => c;
\definition identity: Real -> Real := \fun (x: _) => x;
\definition affine(m, b: Real): Real -> Real := \fun (x: _) => add (mul m x) b;


\module Limit;
\module Derivative;
