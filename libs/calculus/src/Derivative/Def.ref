\definition slope(f: Scalar.Real -> Scalar.Real) (a, x: Scalar.Real): Scalar.Real :=
  Scalar.mul (Scalar.sub (f x) (f a)) (Scalar.inv (Scalar.sub x a));

\definition HasDerivativeAt(f: Scalar.Real -> Scalar.Real) (a, derivative: Scalar.Real): \Prop :=
  Limit.HasLimitAt (slope f a) a derivative;

\definition DifferentiableAt(f: Scalar.Real -> Scalar.Real) (a: Scalar.Real): \Prop :=
  \exists { derivative: Scalar.Real \where HasDerivativeAt f a derivative };

\definition HasDerivative(f, derivative: Scalar.Real -> Scalar.Real): \Prop :=
  \forall (a: Scalar.Real) -> HasDerivativeAt f a (derivative a);

\structure DifferentiableFunction: \Set {
  function: Scalar.Real -> Scalar.Real,
  derivative: Scalar.Real -> Scalar.Real,
} \where {
  differentiable: HasDerivative function derivative,
}
