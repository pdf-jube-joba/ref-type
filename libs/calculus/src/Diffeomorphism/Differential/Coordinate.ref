\import Reals.Multivariable[n := n].Differential[].Def[] \as ScalarMaps;
\import Reals.Multivariable[n := n].Space[].Linear[] \as Linear;
\import Inner.Chain[U := U, V := V, f := Forward.apply U V (#forward{f}), a := a, d := First.value,
  g := Backward.coordinateFunction V U (#backward{f}) j, e := Second.row j] \as Chain;
\definition equal: Chain.differential = Vector.row candidate j := Linear.ext Chain.differential (Vector.row candidate j)
  (\axiom:funext((#apply{Chain.differential}), (#apply{(Vector.row candidate j)}), \fun (v: Domain.Vector) => \refl(#apply{Second.value} (#apply{First.value} v) j)));
\definition law: Source.Analysis[].HasDifferentialAt U (Vector.component U function j) a (Vector.row candidate j) :=
  \idelim Chain.differential = Vector.row candidate j \with d: ScalarMaps.LinearMap =>
    Source.Analysis[].HasDifferentialAt U (Vector.component U function j) a d \by {
      base: Chain.law First.vectorLaw (Second.componentLaw j), equality: equal
    };
