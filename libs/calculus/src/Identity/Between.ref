\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\definition data(included: Open.Included U V): Maps.Data[U, V] := Maps.Data[U, V] { apply := Open.inclusion U V included };
\definition map(included: Open.Included U V): Maps.Map U V :=
  \into[Maps.Data[U, V]](data included, { f: Maps.Data[U, V] \where Maps.Laws[U, V, f] }) \by {
    Maps.Laws[U, V, data included] { smooth := \fun (i: std.Data[].FinSet[].Fin n) => Examples.projectionSmooth U i }
  };
\definition rawApply(f: Maps.Map U V)(x: Open.Carrier U): Coordinates.Vector := Maps.apply U V f x;
\definition vectorIdentity: \forall (f: Maps.Map U V)(a: Open.Carrier U) ->
  (\forall (x: Open.Carrier U) -> rawApply f x = #apply{linear} x) -> Maps.Differential[U := U, V := V, f := f, a := a].value = linear := \block {
  \fun (f: Maps.Map U V)(a: Open.Carrier U)(same: \forall (x: Open.Carrier U) -> rawApply f x = #apply{linear} x) \then
  \let identityLaw: Vector.HasDifferentialAt U (\fun (x: Open.Carrier U) => rawApply f x) a linear :=
    \idelim (\fun (x: Open.Carrier U) => #apply{linear} x) = (\fun (x: Open.Carrier U) => rawApply f x)
      \with function: Open.VectorFunction U => Vector.HasDifferentialAt U function a linear \by {
        base: Vector.linearDifferential U linear a,
        equality: \axiom:funext((\fun (x: Open.Carrier U) => #apply{linear} x), (\fun (x: Open.Carrier U) => rawApply f x),
          \fun (x: Open.Carrier U) => sym!{{Coordinates.Vector}} _ _ (same x))
      } \then
  \return Vector.Differential[U := U, f := Maps.apply U V f, a := a, d := Maps.Differential[U := U, V := V, f := f, a := a].value].uniqueness
    linear (Maps.Differential[U := U, V := V, f := f, a := a].vectorLaw) identityLaw
};
\definition differential: \forall (included: Open.Included U V)(a: Open.Carrier U) ->
  Maps.Differential[U := U, V := V, f := map included, a := a].value = linear :=
    \fun (included: Open.Included U V)(a: Open.Carrier U) => vectorIdentity (map included) a
      (\fun (x: Open.Carrier U) => \refl(x));
