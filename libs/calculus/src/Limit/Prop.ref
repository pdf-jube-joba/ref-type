\import \parent.Def[] \as Def;

\definition constantLimit: \forall (c, a: Scalar.Real) ->
  Def.HasLimitAt (Scalar.constant c) a c :=
  \fun (c, a: _) (epsilon: _) (positive: _) =>
    \exact(
      \into[Scalar.Real](epsilon, { delta: Scalar.Real \where Def.Control[Scalar.constant c, a, c, epsilon, delta] })
      \by { Def.Control[Scalar.constant c, a, c, epsilon, epsilon] {
        positive := positive,
        estimate := \fun (x: _) (different: _) (near: _) =>
          R.ltReplaceLeft Scalar.zero (Scalar.distance c c) epsilon
            (sym!{Scalar.Real} _ _ (Metric.distanceSelf c)) positive,
      } },
      \Cast[Scalar.Real] ({ delta: Scalar.Real \where Def.Control[Scalar.constant c, a, c, epsilon, delta] }));

\definition identityLimit: \forall (a: Scalar.Real) -> Def.HasLimitAt Scalar.identity a a :=
  \fun (a: _) (epsilon: _) (positive: _) =>
    \exact(
      \into[Scalar.Real](epsilon, { delta: Scalar.Real \where Def.Control[Scalar.identity, a, a, epsilon, delta] })
      \by { Def.Control[Scalar.identity, a, a, epsilon, epsilon] {
        positive := positive,
        estimate := \fun (x: _) (different: _) (near: _) => near,
      } },
      \Cast[Scalar.Real] ({ delta: Scalar.Real \where Def.Control[Scalar.identity, a, a, epsilon, delta] }));

\definition puncturedCongruentLimit: \forall (f, g: Scalar.Real -> Scalar.Real) ->
  \forall (a, l: Scalar.Real) ->
  (\forall (x: Scalar.Real) -> Logic.Not (x = a) -> f x = g x) ->
  Def.HasLimitAt f a l -> Def.HasLimitAt g a l :=
  \fun (f, g: Scalar.Real -> Scalar.Real) (a, l: Scalar.Real)
    (same: \forall (x: Scalar.Real) -> Logic.Not (x = a) -> f x = g x)
    (limit: Def.HasLimitAt f a l) (epsilon: Scalar.Real) (positive: R.Lt Scalar.zero epsilon) =>
  \block {
    \takefrom delta: \Cast[Scalar.Real] ({ d: Scalar.Real \where Def.Control[f, a, l, epsilon, d] })
      \by limit epsilon positive \then
    \let control: Def.Control[f, a, l, epsilon, delta] :=
      \bysub(Scalar.Real, { d: Scalar.Real \where Def.Control[f, a, l, epsilon, d] }, delta) \then
    \return \exact(
      \into[Scalar.Real](delta, { d: Scalar.Real \where Def.Control[g, a, l, epsilon, d] })
      \by { Def.Control[g, a, l, epsilon, delta] {
        positive := #positive{control},
        estimate := \fun (x: Scalar.Real) (different: Logic.Not (x = a))
          (near: R.Lt (Scalar.distance x a) delta) =>
          R.ltReplaceLeft (Scalar.distance (f x) l) (Scalar.distance (g x) l) epsilon
            (congr!{Scalar.Real Scalar.Real} (\fun (y: _) => Scalar.distance y l) _ _ (same x different))
            (#estimate{control} x different near),
      } },
      \Cast[Scalar.Real] ({ d: Scalar.Real \where Def.Control[g, a, l, epsilon, d] }))
  };

\definition congruentLimit: \forall (f, g: Scalar.Real -> Scalar.Real) ->
  (\forall (x: Scalar.Real) -> f x = g x) -> \forall (a, l: Scalar.Real) ->
  Def.HasLimitAt f a l -> Def.HasLimitAt g a l :=
  \fun (f, g: _) (same: _) (a, l: _) =>
    puncturedCongruentLimit f g a l (\fun (x: _) (different: _) => same x);
