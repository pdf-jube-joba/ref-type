\record Control[f: Scalar.Real -> Scalar.Real, a, l, epsilon, delta: Scalar.Real]: \Prop := {
  positive: R.Lt Scalar.zero delta,
  estimate: \forall (x: Scalar.Real) -> Logic.Not (x = a) ->
    R.Lt (Scalar.distance x a) delta -> R.Lt (Scalar.distance (f x) l) epsilon,
};

\definition HasLimitAt(f: Scalar.Real -> Scalar.Real) (a, l: Scalar.Real): \Prop :=
  \forall (epsilon: Scalar.Real) -> R.Lt Scalar.zero epsilon ->
    \exists { delta: Scalar.Real \where Control[f, a, l, epsilon, delta] };
