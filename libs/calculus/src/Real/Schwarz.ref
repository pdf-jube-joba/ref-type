\import \parent.Derivative[].Def[] \as Derivatives;
\import \parent.Derivative[].Operations[] \as DerivativeLaws;
\import real.Analysis[].Algebra[] \as Algebra;
\import R.Order[] \as Order;
\use Equality::congr2;
\definition doubleDifference: \forall (a, b, c, d: Real) -> sub (sub a b) (sub c d) = sub (sub a c) (sub b d) :=
  \fun (a, b, c, d: Real) => trans!{Real} _ _ _
    (congr!{Real Real} (add (sub a b)) _ _ (Algebra.negSub c d))
    (trans!{Real} _ _ _ (Algebra.addFour a (Arithmetic.neg b) d (Arithmetic.neg c))
      (trans!{Real} _ _ _
        (congr!{Real Real} (add (add a d)) _ _ (Laws.addComm (Arithmetic.neg b) (Arithmetic.neg c)))
        (trans!{Real} _ _ _ (sym!{Real} _ _ (Algebra.addFour a (Arithmetic.neg c) d (Arithmetic.neg b)))
          (congr!{Real Real} (add (sub a c)) _ _ (sym!{Real} _ _ (Algebra.negSub b d))))));
\import topology.RealLine[] \as Line;
\module Rectangle(left, right, bottom, top: Real);
