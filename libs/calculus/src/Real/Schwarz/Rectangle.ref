\import \parent.\parent.MeanValue[].Interval[a := left, b := right] \as Horizontal;
\import \parent.\parent.MeanValue[].Interval[a := bottom, b := top] \as Vertical;
\import Horizontal.Estimate[] \as HorizontalEstimates;
\import Vertical.Estimate[] \as VerticalEstimates;
\import \parent.\parent.Limit[].Topology[].Subset[S := Line.ClosedInterval left right] \as HorizontalContinuity;
\import \parent.\parent.Limit[].Topology[].Subset[S := Line.ClosedInterval bottom top] \as VerticalContinuity;
\definition X: \Set := \Cast[Real] (Line.ClosedInterval left right);
\definition Y: \Set := \Cast[Real] (Line.ClosedInterval bottom top);
\definition difference(f: Real -> Real -> Real): Real := sub (sub (f right top) (f left top)) (sub (f right bottom) (f left bottom));
\definition quotient(f: Real -> Real -> Real): Real := mul (mul (difference f) (inv (sub top bottom))) (inv (sub right left));
\structure Result[f, h: Real -> Real -> Real, x, y: Real]: \Prop {
  horizontal: Horizontal.Interior x,
  vertical: Vertical.Interior y,
  value: quotient f = h x y,
}
\module Functions(f, g, h: Real -> Real -> Real);
\module Transposed;
