\import \parent.Def[] \as Def;
\import \parent.\parent.Space[].Prop[] \as SpaceLaws;

\definition constantPartial: \forall (c: Real) -> \forall (i: Coordinate) ->
  Def.HasPartialDerivative (Space.constantFunction c) i (Space.constantFunction zero) :=
  \fun (c: _) (i: _) (a: _) => DerivativeLaws.constantDerivative c (a i);

\definition projectionPartial: \forall (i: Coordinate) ->
  Def.HasPartialDerivative (Space.projection i) i (Space.constantFunction one) :=
  \fun (i: _) (a: _) =>
    \idelim identity = Def.section (Space.projection i) a i
      \with f: (Real -> Real) => Derivative.HasDerivativeAt f (a i) one
      \by {
        base: DerivativeLaws.identityDerivative (a i),
        equality: \axiom:funext(identity, Def.section (Space.projection i) a i,
          \fun (t: _) => sym!{Real} _ _ (SpaceLaws.replaceSame a i t))
      };
\definition kronecker(i, j: Coordinate): Real := Bool.ite Real (NatOp.eqb (Fin.value n i) (Fin.value n j)) one zero;
\definition projectionPartialAny: \forall (i, j: Coordinate) -> Def.HasPartialDerivative (Space.projection i) j (Space.constantFunction (kronecker i j)) :=
  \fun (i, j: Coordinate)(a: Point) => Bool.cases
    (\fun (b: Bool.Bool^) => NatOp.eqb (Fin.value n i) (Fin.value n j) = b ->
      Derivative.HasDerivativeAt (Def.section (Space.projection i) a j) (a j) (Bool.ite Real b one zero))
    (\fun (equal: _) => \idelim constant (a i) = Def.section (Space.projection i) a j
      \with f: (Real -> Real) => Derivative.HasDerivativeAt f (a j) zero \by {
        base: DerivativeLaws.constantDerivative (a i) (a j),
        equality: \axiom:funext(constant (a i), Def.section (Space.projection i) a j, \fun (t: Real) =>
          \idelim Bool.Bool^::false = NatOp.eqb (Fin.value n i) (Fin.value n j)
            \with b: Bool.Bool^ => a i = Bool.ite Real b t (a i) \by {
              base: \refl(a i), equality: sym!{{Bool.Bool^}} _ _ equal
            })
      })
    (\fun (equal: _) => \idelim identity = Def.section (Space.projection i) a j
      \with f: (Real -> Real) => Derivative.HasDerivativeAt f (a j) one \by {
        base: DerivativeLaws.identityDerivative (a j),
        equality: \axiom:funext(identity, Def.section (Space.projection i) a j, \fun (t: Real) =>
          \idelim Bool.Bool^::true = NatOp.eqb (Fin.value n i) (Fin.value n j)
            \with b: Bool.Bool^ => t = Bool.ite Real b t (a i) \by {
              base: \refl(t), equality: sym!{{Bool.Bool^}} _ _ equal
            })
      })
    (NatOp.eqb (Fin.value n i) (Fin.value n j)) (\refl(NatOp.eqb (Fin.value n i) (Fin.value n j)));

\definition constantMixedPartialsCommute: \forall (c: Real) ->
  Def.MixedPartialsCommute (Space.constantFunction c) :=
  \block {
    \fun (c: _) (i: _) (j: _) (a: _) \then
    \let data: Def.MixedPartialData := Def.MixedPartialData {
      firstI := Space.constantFunction zero,
      firstJ := Space.constantFunction zero,
      mixedIJ := zero,
      mixedJI := zero,
    } \then
    \return \exact(
      \into[Def.MixedPartialData](data,
        { data: Def.MixedPartialData \where Def.MixedPartialLaws[Space.constantFunction c, i, j, a, data] })
        \by { Def.MixedPartialLaws[Space.constantFunction c, i, j, a, data] {
          firstI := constantPartial c i,
          firstJ := constantPartial c j,
          mixedIJ := constantPartial zero i a,
          mixedJI := constantPartial zero j a,
          commutes := \refl(zero),
        } },
      \Cast[Def.MixedPartialData]
        ({ data: Def.MixedPartialData \where Def.MixedPartialLaws[Space.constantFunction c, i, j, a, data] }))
  };
