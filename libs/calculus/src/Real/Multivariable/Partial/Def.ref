\definition section(f: Function) (a: Point) (i: Coordinate): Real -> Real :=
  \fun (t: _) => f (Space.replace a i t);

\definition HasPartialDerivativeAt(f: Function) (i: Coordinate) (a: Point) (value: Real): \Prop :=
  Derivative.HasDerivativeAt (section f a i) (a i) value;

\definition PartiallyDifferentiableAt(f: Function) (i: Coordinate) (a: Point): \Prop :=
  \exists { value: Real \where HasPartialDerivativeAt f i a value };

\definition HasPartialDerivative(f: Function) (i: Coordinate) (derivative: Function): \Prop :=
  \forall (a: Point) -> HasPartialDerivativeAt f i a (derivative a);

\definition HasGradient(f: Function) (gradient: Point -> Point): \Prop :=
  \forall (i: Coordinate) -> HasPartialDerivative f i (\fun (a: _) => gradient a i);

\structure MixedPartialData: \Set {
  firstI: Function,
  firstJ: Function,
  mixedIJ: Real,
  mixedJI: Real,
}

\structure MixedPartialLaws[f: Function, i, j: Coordinate, a: Point, data: MixedPartialData]: \Prop {
  firstI: HasPartialDerivative f i data.firstI,
  firstJ: HasPartialDerivative f j data.firstJ,
  mixedIJ: HasPartialDerivativeAt data.firstJ i a data.mixedIJ,
  mixedJI: HasPartialDerivativeAt data.firstI j a data.mixedJI,
  commutes: data.mixedIJ = data.mixedJI,
}

\definition MixedPartialsCommuteAt(f: Function) (i, j: Coordinate) (a: Point): \Prop :=
  \exists { data: MixedPartialData \where MixedPartialLaws[f, i, j, a, data] };

\definition MixedPartialsCommute(f: Function): \Prop :=
  \forall (i, j: Coordinate) -> \forall (a: Point) -> MixedPartialsCommuteAt f i j a;

\structure PartiallyDifferentiableFunction: \Set {
  function: Function,
  gradient: Point -> Point,
  differentiable: HasGradient function gradient,
}
