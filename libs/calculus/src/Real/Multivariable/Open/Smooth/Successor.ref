\import Lists.Last[A := Coordinate] \as Last;
\definition Choices: \Set := \forall (i: Coordinate) -> \Cast[PartialFamily U] ({ jet: PartialFamily U \where ContDiffLaws[U, g i, k, jet] });
\definition choose: (\forall (i: Coordinate) -> ContDiffOn U k (g i)) -> \exists Choices :=
  \fun (jetLaws: _) => \axiom:classicalIndefiniteChoice(Coordinate,
    (\fun (i: Coordinate) => \Cast[PartialFamily U] ({ jet: PartialFamily U \where ContDiffLaws[U, g i, k, jet] })), jetLaws);
\module Data(jets: Coordinate -> PartialFamily U);
\module Chosen(choices: Choices);
\definition contDiff: Analysis.ContinuousOn U f -> (\forall (i: Coordinate) -> Analysis.HasPartialDerivative U f i (g i)) ->
  (\forall (i: Coordinate) -> ContDiffOn U k (g i)) -> ContDiffOn U (N.Nat^::succ k) f := \block {
  \fun (functionContinuous: _)(firstPartials: _)(jetLaws: _) \then
  \takefrom choices: Choices \by choose jetLaws \then
  \return Chosen[choices := choices].contDiff functionContinuous firstPartials
};
