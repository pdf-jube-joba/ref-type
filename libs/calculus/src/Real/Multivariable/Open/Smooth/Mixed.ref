\import \parent.Derivative[] \as Partials;
\definition commute: \forall (U: OpenSet)(f: SmoothFunction U)(i, j: Coordinate) ->
  Partials.derivative U (Partials.derivative U f i) j = Partials.derivative U (Partials.derivative U f j) i :=
  \fun (U: OpenSet)(f: SmoothFunction U)(i, j: Coordinate) =>
    \axiom:funext(Partials.derivative U (Partials.derivative U f i) j, Partials.derivative U (Partials.derivative U f j) i,
      \fun (a: Carrier U) => \parent.Schwarz[U := U, f := f, a := a, i := j, j := i].Commutation[].law);
