\import Analytic.Curve[U := U, f := f, default := zero, a := Coordinates.replace a i s, i := j] \as Curve;
\import \parent.\parent.\parent.\parent.\parent.\parent.Derivative[].Def[] \as Derivatives;
\definition derivative: \forall (t: T) -> Contains -> Derivatives.HasDerivativeAt (extended s) t (extendedFirst s t) :=
  \fun (t: T)(contains: Contains) => \idelim first (point s t contains) = extendedFirst s t \with d: Real =>
    Derivatives.HasDerivativeAt (extended s) t d \by {
      base: Curve.derivativeAt t (point s t contains) (first (point s t contains)) (\refl(Grid.point s t))
        (Partials.partialLaw U f j (point s t contains)),
      equality: sym!{Real} _ _ (Extension.inside first zero (point s t contains))
    };
