\import Analytic.Curve[U := U, f := first, default := zero, a := Coordinates.replace a j t, i := i] \as Curve;
\import \parent.\parent.\parent.\parent.\parent.\parent.Derivative[].Def[] \as Derivatives;
\definition functionsEqual: Logic.Not (i = j) -> Curve.value = (\fun (s: Real) => extendedFirst s t) :=
  \fun (different: Logic.Not (i = j)) => \axiom:funext(Curve.value, (\fun (s: Real) => extendedFirst s t),
    \fun (s: Real) => congr!{Point Real} (Extension.extend first zero) _ _ (sym!{Point} _ _ (Grid.swapped different s t)));
\definition derivative: \forall (s: S) -> Logic.Not (i = j) -> Contains ->
  Derivatives.HasDerivativeAt (\fun (r: Real) => extendedFirst r t) s (extendedSecond s t) :=
  \fun (s: S)(different: Logic.Not (i = j))(contains: Contains) => \idelim Curve.value = (\fun (r: Real) => extendedFirst r t)
    \with g: (Real -> Real) => Derivatives.HasDerivativeAt g s (extendedSecond s t) \by {
      base: \idelim second (point s t contains) = extendedSecond s t \with d: Real => Derivatives.HasDerivativeAt Curve.value s d \by {
        base: Curve.derivativeAt s (point s t contains) (second (point s t contains)) (Grid.swapped different s t)
          (Partials.partialLaw U first i (point s t contains)),
        equality: sym!{Real} _ _ (secondValue s t contains)
      },
      equality: functionsEqual different
    };
