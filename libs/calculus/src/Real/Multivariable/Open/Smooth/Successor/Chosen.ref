\import \parent.Data[jets := \fun (i: Coordinate) => choices i] \as Construction;
\definition jets: Coordinate -> PartialFamily U := \fun (i: Coordinate) => choices i;
\definition jetLaws: \forall (i: Coordinate) -> ContDiffLaws[U, g i, k, jets i] := \fun (i: Coordinate) =>
  \bysub(PartialFamily U, { jet: PartialFamily U \where ContDiffLaws[U, g i, k, jet] }, choices i);
\definition contDiff: Analysis.ContinuousOn U f -> (\forall (i: Coordinate) -> Analysis.HasPartialDerivative U f i (g i)) -> ContDiffOn U (N.Nat^::succ k) f :=
  \fun (functionContinuous: Analysis.ContinuousOn U f)(firstPartials: \forall (i: Coordinate) -> Analysis.HasPartialDerivative U f i (g i)) =>
    \exact(\into[PartialFamily U](Construction.family, { jet: PartialFamily U \where ContDiffLaws[U, f, N.Nat^::succ k, jet] }) \by {
      Construction.laws functionContinuous firstPartials jetLaws
    }, \Cast[PartialFamily U] ({ jet: PartialFamily U \where ContDiffLaws[U, f, N.Nat^::succ k, jet] }));
