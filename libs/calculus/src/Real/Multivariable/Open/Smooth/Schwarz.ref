\import \parent.Derivative[] \as Partials;
\import \parent.Properties[] \as Properties;
\import \parent.\parent.\parent.Space[].Def[] \as Coordinates;
\import \parent.\parent.\parent.Space[].Prop[] \as CoordinateLaws;
\import \parent.\parent.\parent.Space[].Rectangle[a := a, i := i, j := j] \as Grid;
\import \parent.\parent.Analysis[] \as Analytic;
\import std.Set[].Extension[A := Point, B := Real, domain := #points{U}] \as Extension;
\import real.Analysis[].Estimates[] \as Estimates;
\import Estimates.Product[] \as Product;
\import R.Order[] \as Order;
\import topology.RealLine[] \as Line;
\definition first: Partials.Function U := Partials.derivative U f j;
\definition second: Partials.Function U := Partials.derivative U first i;
\definition otherFirst: Partials.Function U := Partials.derivative U f i;
\definition otherSecond: Partials.Function U := Partials.derivative U otherFirst j;
\definition extended(s, t: Real): Real := Extension.extend f zero (Grid.point s t);
\definition extendedFirst(s, t: Real): Real := Extension.extend first zero (Grid.point s t);
\definition extendedSecond(s, t: Real): Real := Extension.extend second zero (Grid.point s t);
\module Box(h: Real);
\module Commutation;
