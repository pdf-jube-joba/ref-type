\module At(z: Carrier (#domain{patch})) {
  \definition globalPoint: Carrier U := inclusion (#domain{patch}) U (#included{patch}) z;
  \definition member: Contains patch globalPoint := \bysub(Point, #points{(#domain{patch})}, z);
  \definition selected: Contains (select globalPoint) globalPoint := \bysub(Patch, Patches globalPoint, select globalPoint);
  \import \parent.\parent.Pair[left := patch, right := select globalPoint] \as Pair;
  \definition coincide: \forall (directions: Smooth.Directions) -> NatLaws.Le (Smooth.order directions) k ->
    family select directions globalPoint = #derivatives{patch} directions z :=
    \fun (directions: _)(bound: _) => sym!{Real} (#derivatives{patch} directions z) (family select directions globalPoint)
      (Pair.compatible globalPoint member selected directions bound);
}
\definition coincide: \forall (z: Carrier (#domain{patch}))(directions: Smooth.Directions) -> NatLaws.Le (Smooth.order directions) k ->
  family select directions (inclusion (#domain{patch}) U (#included{patch}) z) = #derivatives{patch} directions z :=
  \fun (z: _)(directions: _)(bound: _) => At[z := z].coincide directions bound;
