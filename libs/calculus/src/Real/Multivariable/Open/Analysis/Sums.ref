\import real.Analysis[].Sums[T := T] \as FiniteSum;
\import \parent.Operations[] \as Operations;
\import std.Data[].List[].All[A := T] \as All;
\definition sum(U: OpenSet)(xs: Lists.List[T])(f: T -> ScalarFunction U): ScalarFunction U :=
  \fun (a: Carrier U) => FiniteSum.sum xs (\fun (t: T) => f t a);
\definition continuous: \forall (U: OpenSet)(xs: Lists.List[T])(f: T -> ScalarFunction U) ->
  All.Holds (\fun (t: T) => ContinuousOn U (f t)) xs -> ContinuousOn U (sum U xs f) :=
  \fun (U: _) => \induction (xs: Lists.List[T]) \return \forall (f: T -> ScalarFunction U) ->
    All.Holds (\fun (t: T) => ContinuousOn U (f t)) xs -> ContinuousOn U (sum U xs f) \with {
      | nil: \fun (f: _)(proof: _) => Operations.constantContinuous U zero
      | cons: \fun (head: T)(tail: Lists.List[T])(previous: _)(f: _)(proof: Logic.And[ContinuousOn U (f head), All.Holds (\fun (t: T) => ContinuousOn U (f t)) tail]) =>
        Operations.addContinuous U (f head) (sum U tail f) (#left{proof}) (previous f (#right{proof}))
    };
\definition partial: \forall (U: OpenSet)(xs: Lists.List[T])(f, df: T -> ScalarFunction U)(i: Coordinate) ->
  All.Holds (\fun (t: T) => HasPartialDerivative U (f t) i (df t)) xs -> HasPartialDerivative U (sum U xs f) i (sum U xs df) :=
  \fun (U: _) => \induction (xs: Lists.List[T]) \return \forall (f, df: T -> ScalarFunction U)(i: Coordinate) ->
    All.Holds (\fun (t: T) => HasPartialDerivative U (f t) i (df t)) xs -> HasPartialDerivative U (sum U xs f) i (sum U xs df) \with {
      | nil: \fun (f, df: _)(i: _)(proof: _) => Operations.constantPartial U zero i
      | cons: \fun (head: T)(tail: Lists.List[T])(previous: _)(f, df: _)(i: _)
        (proof: Logic.And[HasPartialDerivative U (f head) i (df head), All.Holds (\fun (t: T) => HasPartialDerivative U (f t) i (df t)) tail]) =>
          Operations.addPartial U (f head) (sum U tail f) (df head) (sum U tail df) i (#left{proof}) (previous f df i (#right{proof}))
    };
\definition append: \forall (U: OpenSet)(xs, ys: Lists.List[T])(f: T -> ScalarFunction U) ->
  sum U (Lists.append T xs ys) f = Operations.plus U (sum U xs f) (sum U ys f) :=
  \fun (U: _)(xs, ys: _)(f: _) => \axiom:funext(sum U (Lists.append T xs ys) f, Operations.plus U (sum U xs f) (sum U ys f),
    \fun (a: Carrier U) => FiniteSum.append xs ys (\fun (t: T) => f t a));
\definition addition: \forall (U: OpenSet)(xs: Lists.List[T])(f, g: T -> ScalarFunction U) ->
  sum U xs (\fun (t: T) => Operations.plus U (f t) (g t)) = Operations.plus U (sum U xs f) (sum U xs g) :=
  \fun (U: _)(xs: _)(f, g: _) => \axiom:funext(sum U xs (\fun (t: T) => Operations.plus U (f t) (g t)), Operations.plus U (sum U xs f) (sum U xs g),
    \fun (a: Carrier U) => FiniteSum.addition xs (\fun (t: T) => f t a) (\fun (t: T) => g t a));
