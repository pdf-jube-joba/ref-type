\import \parent.Def[] \as Def;
\use Equality::congr2;

\definition derivativeOfSlopeLimit: \forall (f: Function) -> \forall (curve: Def.Curve) ->
  \forall (extension: Real -> Real) -> \forall (value: Real) ->
  (\forall (t: Def.Parameter (#interval{curve})) -> Logic.Not (t = zero) ->
    extension t = Def.slope f curve t) ->
  Limit.HasLimitAt extension zero value -> Def.HasDirectionalDerivativeAlong f curve value :=
  \block {
    \fun (f: Function) (curve: Def.Curve) (extension: Real -> Real) (value: Real) \then
    \fun (same: \forall (t: Def.Parameter (#interval{curve})) -> Logic.Not (t = zero) ->
      extension t = Def.slope f curve t) \then
    \fun (limit: Limit.HasLimitAt extension zero value) (epsilon: Real) (positive: R.Lt zero epsilon) \then
    \takefrom delta: \Cast[Real] ({ d: Real \where Limit.Control[extension, zero, value, epsilon, d] })
      \by limit epsilon positive \then
    \let control: Limit.Control[extension, zero, value, epsilon, delta] :=
      \bysub(Real, { d: Real \where Limit.Control[extension, zero, value, epsilon, d] }, delta) \then
    \return \exact(
      \into[Real](delta, { d: Real \where Def.Control[f, curve, value, epsilon, d] })
        \by { Def.Control[f, curve, value, epsilon, delta] {
          positive := #positive{control},
          estimate := \fun (t: Def.Parameter (#interval{curve})) (different: Logic.Not (t = zero))
            (near: R.Lt (distance t zero) delta) =>
            R.ltReplaceLeft (distance (extension t) value) (distance (Def.slope f curve t) value) epsilon
              (congr!{Real Real} (\fun (y: _) => distance y value) _ _ (same t different))
              (#estimate{control} t different near),
        } },
      \Cast[Real] ({ d: Real \where Def.Control[f, curve, value, epsilon, d] }))
  };

\definition constantSlope: \forall (c: Real) -> \forall (curve: Def.Curve) ->
  \forall (t: Def.Parameter (#interval{curve})) -> Def.slope (Space.constantFunction c) curve t = zero :=
  \fun (c: _) (curve: _) (t: _) =>
    trans!{Real} _ (mul zero (inv t)) _
      (congr!{Real Real} (\fun (y: _) => mul y (inv t)) _ _ (Laws.subSelf c))
      (Laws.fieldMulZeroLeft (inv t));

\definition constantDirectionalDerivative: \forall (c: Real) -> \forall (curve: Def.Curve) ->
  Def.HasDirectionalDerivativeAlong (Space.constantFunction c) curve zero :=
  \fun (c: _) (curve: _) => derivativeOfSlopeLimit (Space.constantFunction c) curve (constant zero) zero
    (\fun (t: _) (different: _) => sym!{Real} _ _ (constantSlope c curve t))
    (LimitLaws.constantLimit zero zero);

\definition derivativeOfScalarDerivative: \forall (f: Function) -> \forall (curve: Def.Curve) ->
  \forall (g: Real -> Real) -> \forall (value: Real) ->
  (\forall (t: Def.Parameter (#interval{curve})) -> f (#path{curve} t) = g t) ->
  Derivative.HasDerivativeAt g zero value -> Def.HasDirectionalDerivativeAlong f curve value :=
  \fun (f: Function) (curve: Def.Curve) (g: Real -> Real) (value: _)
    (same: \forall (t: Def.Parameter (#interval{curve})) -> f (#path{curve} t) = g t) (derivative: _) =>
    derivativeOfSlopeLimit f curve (Derivative.slope g zero) value
      (\fun (t: Def.Parameter (#interval{curve})) (different: _) =>
        eq_reason!{
          {Derivative.slope g zero t}
          "=" {mul (sub (g t) (g zero)) (inv t)}
          "by" {congr!{Real Real} (\fun (s: _) => mul (sub (g t) (g zero)) (inv s)) _ _ (Laws.subZeroRight t)}
          "=" {Def.slope f curve t}
          "by" {congr!{Real Real} (\fun (s: _) => mul s (inv t)) _ _
            (congr2!{Real Real Real} sub _ _ _ _
              (sym!{Real} _ _ (same t))
              (sym!{Real} _ _ (same (Def.zeroParameter (#interval{curve}))))) }
        })
      derivative;

\definition lineCenter: \forall (interval: Def.ParameterInterval) -> \forall (point, velocity: Point) ->
  Def.center (Def.line interval point velocity) = point :=
  \fun (interval: _) (point, velocity: _) =>
    \axiom:funext(Def.center (Def.line interval point velocity), point,
      \fun (i: _) => trans!{Real} _ (add (point i) zero) _
        (congr!{Real Real} (add (point i)) _ _ (Laws.fieldMulZeroLeft (velocity i)))
        (Laws.addZeroRight (point i)));

\definition lineCoordinate: \forall (interval: Def.ParameterInterval) -> \forall (point, velocity: Point) ->
  \forall (t: Def.Parameter interval) -> \forall (i: Coordinate) ->
  #path{(Def.line interval point velocity)} t i = affine (velocity i) (point i) t :=
  \fun (interval: _) (point, velocity: _) (t: _) (i: _) =>
    trans!{Real} _ (add (mul t (velocity i)) (point i)) _
      (Laws.addComm (point i) (mul t (velocity i)))
      (congr!{Real Real} (\fun (s: _) => add s (point i)) _ _ (Laws.fieldMulComm t (velocity i)));

\definition lineTangent: \forall (interval: Def.ParameterInterval) -> \forall (point, velocity: Point) ->
  Def.HasTangent (Def.line interval point velocity) velocity :=
  \fun (interval: _) (point, velocity: _) (i: _) =>
    derivativeOfScalarDerivative (Space.projection i) (Def.line interval point velocity)
      (affine (velocity i) (point i)) (velocity i)
      (\fun (t: _) => lineCoordinate interval point velocity t i)
      (DerivativeLaws.affineDerivative (velocity i) (point i) zero);

\definition constantDirectionalDerivativeAt: \forall (c: Real) -> \forall (point, velocity: Point) ->
  Def.HasDirectionalDerivativeAt (Space.constantFunction c) point velocity zero :=
  \fun (c: _) (point: _) (velocity: _) (curve: _) (direction: _) => constantDirectionalDerivative c curve;

\definition constantDerivativesAgree: \forall (c: Real) -> \forall (first, second: Def.Curve) ->
  Def.DirectionalDerivativesAgree (Space.constantFunction c) first second :=
  \fun (c: _) (first: _) (second: _) =>
    \exact(
      \into[Real](zero, { value: Real \where Def.Agreement[Space.constantFunction c, first, second, value] })
        \by { Def.Agreement[Space.constantFunction c, first, second, zero] {
          firstDerivative := constantDirectionalDerivative c first,
          secondDerivative := constantDirectionalDerivative c second,
        } },
      \Cast[Real] ({ value: Real \where Def.Agreement[Space.constantFunction c, first, second, value] }));

\definition projectionDirectionalDerivative: \forall (curve: Def.Curve) -> \forall (velocity: Point) ->
  Def.HasTangent curve velocity -> \forall (i: Coordinate) ->
  Def.HasDirectionalDerivativeAlong (Space.projection i) curve (velocity i) :=
  \fun (curve: _) (velocity: _) (tangent: _) (i: _) => tangent i;

\definition projectionDerivativesAgree: \forall (first, second: Def.Curve) -> \forall (velocity: Point) ->
  Def.SameDirection[first, second, velocity] -> \forall (i: Coordinate) ->
  Def.DirectionalDerivativesAgree (Space.projection i) first second :=
  \fun (first, second: _) (velocity: _) (direction: _) (i: _) =>
    \exact(
      \into[Real](velocity i, { value: Real \where Def.Agreement[Space.projection i, first, second, value] })
        \by { Def.Agreement[Space.projection i, first, second, velocity i] {
          firstDerivative := #firstTangent{direction} i,
          secondDerivative := #secondTangent{direction} i,
        } },
      \Cast[Real] ({ value: Real \where Def.Agreement[Space.projection i, first, second, value] }));

\definition directionallyDifferentiableOfDerivative: \forall (f: Function) -> \forall (curve: Def.Curve) ->
  \forall (value: Real) -> Def.HasDirectionalDerivativeAlong f curve value ->
  Def.DirectionallyDifferentiableAlong f curve :=
  \fun (f: _) (curve: _) (value: _) (derivative: _) =>
    \exact(
      \into[Real](value, { m: Real \where Def.HasDirectionalDerivativeAlong f curve m }) \by { derivative },
      \Cast[Real] ({ m: Real \where Def.HasDirectionalDerivativeAlong f curve m }));

\definition differentialAgreementOfSameDirection: \forall (f: Function) -> \forall (first, second: Def.Curve) ->
  \forall (velocity: Point) -> \forall (differential: Differential.LinearMap) ->
  Def.AgreementConditions[f, first, second, velocity, differential] ->
  Def.DifferentialAgreementConditions[f, first, second, velocity, velocity, differential] :=
  \fun (f: _) (first: _) (second: _) (velocity: _) (differential: _)
    (conditions: Def.AgreementConditions[f, first, second, velocity, differential]) =>
    Def.DifferentialAgreementConditions[f, first, second, velocity, velocity, differential] {
      sameCenter := #center{(#direction{conditions})},
      firstTangent := #firstTangent{(#direction{conditions})},
      secondTangent := #secondTangent{(#direction{conditions})},
      differentiable := #differentiable{conditions},
      images := \refl(#apply{differential} velocity),
    };
