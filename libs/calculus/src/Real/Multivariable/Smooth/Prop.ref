\import \parent.Def[] \as Def;
\import \parent.\parent.Space[].Prop[] \as SpaceLaws;
\import \parent.\parent.Partial[].Prop[] \as PartialLaws;
\import N.Order[].Prop[] \as NatOrder;

\definition contDiffZero: \forall (f: Function) ->
  Logic.PropEquiv[Def.ContDiff N.Nat^::zero f, Space.Continuous f] :=
  \fun (f: _) => Logic.PropEquiv[Def.ContDiff N.Nat^::zero f, Space.Continuous f] {
    ltr := \block {
      \fun (regular: _) \then
      \takefrom derivatives: \Cast[Def.PartialFamily]
        ({ derivatives: Def.PartialFamily \where Def.ContDiffLaws[f, N.Nat^::zero, derivatives] })
        \by regular \then
      \let laws: Def.ContDiffLaws[f, N.Nat^::zero, derivatives] :=
        \bysub(Def.PartialFamily,
          { derivatives: Def.PartialFamily \where Def.ContDiffLaws[f, N.Nat^::zero, derivatives] }, derivatives) \then
      \return \idelim derivatives Def.Directions::nil = f
        \with g: Function => Space.Continuous g
        \by {
          base: #continuous{laws} Def.Directions::nil (NatLaws.leRefl N.Nat^::zero),
          equality: #function{(#partials{laws})}
        }
    },
    rtl := \block {
      \fun (continuous: _) \then
      \let derivatives: Def.PartialFamily := \fun (directions: _) => f \then
      \return \exact(
        \into[Def.PartialFamily](derivatives,
          { derivatives: Def.PartialFamily \where Def.ContDiffLaws[f, N.Nat^::zero, derivatives] })
          \by { Def.ContDiffLaws[f, N.Nat^::zero, derivatives] {
            partials := Def.PartialFamilyLaws[f, N.Nat^::zero, derivatives] {
              function := \refl(f),
              derivative := \fun (directions: _) (bound: _) (i: _) =>
                Logic.falseElim (Partial.HasPartialDerivative f i f)
                  (NatOrder.ltZero (Def.order directions) bound),
            },
            continuous := \fun (directions: _) (bound: _) => continuous,
          } },
        \Cast[Def.PartialFamily]
          ({ derivatives: Def.PartialFamily \where Def.ContDiffLaws[f, N.Nat^::zero, derivatives] }))
    },
  };

\definition constantPartials(c: Real): Def.PartialFamily :=
  \fun (directions: _) =>
    \match directions \in Lists.List \return (\fun (_: _) => Function) \with {
      | nil : Space.constantFunction c
      | cons i tail : Space.constantFunction zero
    };

\definition constantPartialLaws: \forall (c: Real) -> \forall (k: N.Nat^) ->
  Def.PartialFamilyLaws[Space.constantFunction c, k, constantPartials c] :=
  \fun (c: _) (k: _) => Def.PartialFamilyLaws[Space.constantFunction c, k, constantPartials c] {
    function := \refl(Space.constantFunction c),
    derivative := \induction (directions: Def.Directions) \return
      NatLaws.Lt (Def.order directions) k -> \forall (i: Coordinate) ->
        Partial.HasPartialDerivative (constantPartials c directions) i
          (constantPartials c (Def.Directions::cons i directions)) \with {
      | nil : \fun (bound: _) (i: _) => PartialLaws.constantPartial c i
      | cons : \fun (head: _) (tail: _) (ih: _) (bound: _) (i: _) => PartialLaws.constantPartial zero i
    },
  };

\definition constantContDiff: \forall (k: N.Nat^) -> \forall (c: Real) ->
  Def.ContDiff k (Space.constantFunction c) :=
  \block {
    \fun (k: _) (c: _) \then
    \return \exact(
      \into[Def.PartialFamily](constantPartials c,
        { derivatives: Def.PartialFamily \where Def.ContDiffLaws[Space.constantFunction c, k, derivatives] })
        \by { Def.ContDiffLaws[Space.constantFunction c, k, constantPartials c] {
          partials := constantPartialLaws c k,
          continuous := \induction (directions: Def.Directions) \return
            NatLaws.Le (Def.order directions) k -> Space.Continuous (constantPartials c directions) \with {
            | nil : \fun (bound: _) => SpaceLaws.constantContinuous c
            | cons : \fun (head: _) (tail: _) (ih: _) (bound: _) => SpaceLaws.constantContinuous zero
          },
        } },
      \Cast[Def.PartialFamily]
        ({ derivatives: Def.PartialFamily \where Def.ContDiffLaws[Space.constantFunction c, k, derivatives] }))
  };

\definition constantSmooth: \forall (c: Real) -> Def.Smooth (Space.constantFunction c) :=
  \fun (c: _) (k: _) => constantContDiff k c;

\definition projectionPartials(i: Coordinate): Def.PartialFamily := \fun (directions: Def.Directions) =>
  \match directions \in Lists.List \return (\fun (_: Def.Directions) => Function) \with {
    | nil: Space.projection i
    | cons j tail: \match tail \in Lists.List \return (\fun (_: Def.Directions) => Function) \with {
      | nil: Space.constantFunction (PartialLaws.kronecker i j)
      | cons head rest: Space.constantFunction zero
    }
  };
\definition projectionPartialLaws: \forall (i: Coordinate)(k: N.Nat^) -> Def.PartialFamilyLaws[Space.projection i, k, projectionPartials i] :=
  \fun (i: _)(k: _) => Def.PartialFamilyLaws[Space.projection i, k, projectionPartials i] {
    function := \refl(Space.projection i),
    derivative := \induction (directions: Def.Directions) \return NatLaws.Lt (Def.order directions) k -> \forall (j: Coordinate) ->
      Partial.HasPartialDerivative (projectionPartials i directions) j (projectionPartials i (Def.Directions::cons j directions)) \with {
        | nil: \fun (bound: _)(j: _) => PartialLaws.projectionPartialAny i j
        | cons: \fun (head: Coordinate)(tail: Def.Directions)(previous: _) =>
          \induction (tail: Def.Directions) \return NatLaws.Lt (Def.order (Def.Directions::cons head tail)) k -> \forall (j: Coordinate) ->
            Partial.HasPartialDerivative (projectionPartials i (Def.Directions::cons head tail)) j
              (projectionPartials i (Def.Directions::cons j (Def.Directions::cons head tail))) \with {
                | nil: \fun (bound: _)(j: _) => PartialLaws.constantPartial (PartialLaws.kronecker i head) j
                | cons: \fun (h: _)(t: _)(previous: _)(bound: _)(j: _) => PartialLaws.constantPartial zero j
              } tail
      },
  };
\definition projectionContinuousFamily: \forall (i: Coordinate)(directions: Def.Directions) -> Space.Continuous (projectionPartials i directions) :=
  \fun (i: _) => \induction (directions: Def.Directions) \return Space.Continuous (projectionPartials i directions) \with {
    | nil: SpaceLaws.projectionContinuous i
    | cons: \fun (head: Coordinate)(tail: Def.Directions)(previous: _) =>
      (\induction (tail: Def.Directions) \return Space.Continuous (projectionPartials i (Def.Directions::cons head tail)) \with {
        | nil: SpaceLaws.constantContinuous (PartialLaws.kronecker i head)
        | cons: \fun (h: _)(t: _)(previous: _) => SpaceLaws.constantContinuous zero
      }) tail
  };
\definition projectionContDiff: \forall (k: N.Nat^)(i: Coordinate) -> Def.ContDiff k (Space.projection i) :=
  \fun (k: _)(i: _) => \exact(\into[Def.PartialFamily](projectionPartials i,
    { d: Def.PartialFamily \where Def.ContDiffLaws[Space.projection i, k, d] }) \by {
      Def.ContDiffLaws[Space.projection i, k, projectionPartials i] {
        partials := projectionPartialLaws i k,
        continuous := \fun (directions: Def.Directions)(bound: _) => projectionContinuousFamily i directions,
      }
    }, \Cast[Def.PartialFamily] ({ d: Def.PartialFamily \where Def.ContDiffLaws[Space.projection i, k, d] }));
\definition projectionSmooth: \forall (i: Coordinate) -> Def.Smooth (Space.projection i) := \fun (i: _)(k: _) => projectionContDiff k i;

\definition zeroPartials: Def.PartialFamily := \fun (directions: _) => Space.constantFunction zero;

\definition zeroCommutingPartials: \forall (k: N.Nat^) ->
  Def.CommutingPartials k (Space.constantFunction zero) :=
  \block {
    \fun (k: _) (a: _) \then
    \return \exact(
      \into[Def.PartialFamily](zeroPartials,
        { derivatives: Def.PartialFamily \where
          Def.CommutingPartialsLaws[Space.constantFunction zero, k, derivatives, a] })
        \by { Def.CommutingPartialsLaws[Space.constantFunction zero, k, zeroPartials, a] {
          partials := Def.PartialFamilyLaws[Space.constantFunction zero, k, zeroPartials] {
            function := \refl(Space.constantFunction zero),
            derivative := \fun (directions: _) (bound: _) (i: _) => PartialLaws.constantPartial zero i,
          },
          commutes := \fun (left: _) (right: _) (leftBound: _) (rightBound: _) (same: _) => \refl(zero),
        } },
      \Cast[Def.PartialFamily] ({ derivatives: Def.PartialFamily \where
        Def.CommutingPartialsLaws[Space.constantFunction zero, k, derivatives, a] }))
  };
