\structure Control[f: Real -> Real, a, l, epsilon, delta: Real]: \Prop := {
  positive: R.Lt zero delta,
  estimate: \forall (x: Real) -> Logic.Not (x = a) ->
    R.Lt (distance x a) delta -> R.Lt (distance (f x) l) epsilon,
};

\definition HasLimitAt(f: Real -> Real) (a, l: Real): \Prop :=
  \forall (epsilon: Real) -> R.Lt zero epsilon ->
    \exists { delta: Real \where Control[f, a, l, epsilon, delta] };

\definition ContinuousAt(f: Real -> Real)(a: Real): \Prop := HasLimitAt f a (f a);
\definition Continuous(f: Real -> Real): \Prop := \forall (a: Real) -> ContinuousAt f a;
