\definition slope(f: Real -> Real) (a, x: Real): Real :=
  mul (sub (f x) (f a)) (inv (sub x a));

\definition HasDerivativeAt(f: Real -> Real) (a, derivative: Real): \Prop :=
  Limit.HasLimitAt (slope f a) a derivative;

\definition DifferentiableAt(f: Real -> Real) (a: Real): \Prop :=
  \exists { derivative: Real \where HasDerivativeAt f a derivative };

\definition HasDerivative(f, derivative: Real -> Real): \Prop :=
  \forall (a: Real) -> HasDerivativeAt f a (derivative a);

\structure DifferentiableFunction: \Set {
  function: Real -> Real,
  derivative: Real -> Real,
} \where {
  differentiable: HasDerivative function derivative,
}
