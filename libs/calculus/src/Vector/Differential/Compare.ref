\definition rowEquality: HasDifferentialAt U f a d -> HasDifferentialAt U f a e -> \forall (j: Fin.Fin m) -> row d j = row e j :=
  \fun (left: HasDifferentialAt U f a d)(right: HasDifferentialAt U f a e)(j: Fin.Fin m) =>
    Scalars.Differential[U := U, f := component U f j, a := a, d := row d j].uniqueness (row e j) (left j) (right j);
\definition law: HasDifferentialAt U f a d -> HasDifferentialAt U f a e -> d = e :=
  \fun (left: HasDifferentialAt U f a d)(right: HasDifferentialAt U f a e) => ext d e
    (\axiom:funext((#apply{d}), (#apply{e}), \fun (v: Domain.Point) => \axiom:funext(#apply{d} v, #apply{e} v,
      \fun (j: Fin.Fin m) => congr!{ScalarMaps.LinearMap Reals.Real} (\fun (r: ScalarMaps.LinearMap) => #apply{r} v) _ _ (rowEquality left right j))));
