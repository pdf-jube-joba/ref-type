\import complex.Complex[] \as C;
\import C.Def[] \as O;
\import C.Algebra[] \as CA;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := CA.field, conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar] \as Bundles;
\import \root.Approximation[].Circle[] \as Circle;
\import \root.Approximation[].Examples[].Circle[] \as Function;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition F[x: Circle.Carrier]: \Set := Bundles.Vector one;
\import Bundles.Trivial[X := Circle.Carrier, n := one, baseSpace := Circle.topology] \as Line;
\import Bundles.Identity[X := Circle.Carrier, F := F, bundle := Line.bundle] \as Identity;
\definition retraction: \forall (x: Circle.Carrier)(v: F x) -> (Identity.map.fiber x).apply ((Identity.map.fiber x).apply v) = v := \fun (x: Circle.Carrier)(v: F x) => \refl(v);
\import \root.Approximation[].Bundles[].Over[X := Circle.Carrier, F := F, bundle := Line.bundle].Split[n := one, include := Identity.map, project := Identity.map, retraction := retraction] \as Split;
\import matrix_invariants.Ring[K := C.Complex, scalars := std.Alg[].Field[].fieldAsCommutativeRing C.Complex CA.field].At[n := one] \as M;
\import matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := one].Families[X := Circle.Carrier] \as Families;
\definition matrix[x: Circle.Carrier]: M.Matrix := \fun (i, j: M.Index) => Function.target x;
\definition regular: Families.Regular Circle.topology matrix := \fun (i, j: M.Index) => Function.regular;
\definition endomorphism: Bundles.Morphisms[X := Circle.Carrier, Y := Circle.Carrier, F := F, G := F, source := Line.bundle, target := Line.bundle, f := \fun (x: Circle.Carrier) => x].Map := Split.MatrixMap[a := matrix, regular := regular].compressed;
\import Circle.Scalar[] \as Scalars;
\import Split.Approximate[h := endomorphism].Density[A := Scalars.Subalgebra, laws := Scalars.algebraLaws, compact := Circle.compact, hausdorff := Circle.hausdorff, separates := Scalars.separation] \as Density;
\definition approximation: \forall (epsilon: R.Real) -> Real.Lt R.zero epsilon -> \exists Density.UniformCandidate[epsilon] := Density.uniformExists;
