\import complex.Complex[] \as C;
\import C.Def[] \as O;
\import C.Prop[] \as CP;
\import C.Absolute[] \as Abs;
\import matrix_invariants.Ring[K := C.Complex, scalars := C.Algebra[].commutativeRing].At[n := n] \as M;
\import M.Operations[] \as Operations;
\definition positive: Real.Lt R.zero (Abs.abs (M.determinant M.identity)) := Abs.positive (M.determinant M.identity)
  (\fun (zero: M.determinant M.identity = O.zero) => CP.zeroNeOne (trans!{{C.Complex}} _ _ _ (sym!{{C.Complex}} _ _ zero) M.atIdentity));
\definition error: Real.Lt (Abs.abs (O.sub (M.determinant M.identity) (M.determinant M.identity))) (Abs.abs (M.determinant M.identity)) :=
  Real.ltReplaceLeft R.zero _ _ (sym!{{R.Real}} _ _ (trans!{{R.Real}} _ _ _ (congr!{{C.Complex} {R.Real}} Abs.abs _ _ (CP.subSelf (M.determinant M.identity))) (\root.Approximation[].FiniteComplex[].zeroAbsolute))) positive;
\definition inverse: \exists Operations.Inverse M.identity := \root.Approximation[].Matrices[n := n].invertibleOfDeterminantError M.identity M.identity error;
