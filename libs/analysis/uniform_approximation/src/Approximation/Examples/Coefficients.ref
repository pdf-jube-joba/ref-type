\import complex.Complex[] \as C;
\import C.Def[] \as O;
\import \root.Approximation[].Circle[].Coefficients[X := X, space := space, baseCompact := compact, baseHausdorff := hausdorff] \as Product;
\import \root.Approximation[].ComplexOn[X := X, space := space].FunctionRing[] \as Coefficients;
\import algebra.LaurentPolynomial[].Over[R := Coefficients.Carrier, coefficients := Coefficients.commutativeRing] \as P;
\definition coefficient: Coefficients.Carrier := \into[(X -> C.Complex)](g, Coefficients.Carrier) \by { regular };
\definition polynomial: P.Carrier := P.mul (P.constant coefficient) P.inverseX;
\definition target[p: Product.Domain]: C.Complex := O.mul (g (Product.first p)) (O.conj (Product.unit p));
\definition formula: \forall (p: Product.Domain) -> Product.value polynomial p = target p := \fun (p: Product.Domain) =>
  trans!{{C.Complex}} _ _ _ (Product.onMul (P.constant coefficient) P.inverseX p)
    (congr!{{C.Complex} {C.Complex} {C.Complex}} O.mul _ _ _ _ (Product.onConstant coefficient p) (Product.onInverseVariable p));
