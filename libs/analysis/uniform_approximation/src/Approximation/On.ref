\import topology.Topology[Carrier := X] \as Base;
\import metric_spaces.RealFunctions[A := X] \as Functions;
\definition Continuous[f: X -> R.Real]: \Prop := Functions.Continuous space f;
\definition Error[f, g: X -> R.Real][epsilon: R.Real]: \Prop := \forall (x: X) -> Real.Lt (R.distance (f x) (g x)) epsilon;
\definition Approximates[A: \Pow (X -> R.Real)][f: X -> R.Real]: \Prop := \forall (epsilon: R.Real) -> Real.Lt R.zero epsilon -> \exists (g: X -> R.Real \where Logic.And[\In[X -> R.Real] A g, Error f g epsilon]);
\module Dini(error: N.Nat^ -> X -> R.Real,
  continuous: \forall (n: N.Nat^) -> Continuous (error n),
  antitone: \forall (n, m: N.Nat^) -> NatLaws.Le n m -> \forall (x: X) -> Real.Le (error m x) (error n x));
