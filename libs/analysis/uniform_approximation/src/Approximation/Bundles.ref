\import complex.Complex[] \as C;
\import C.Def[] \as O;
\import C.Algebra[] \as CA;
\import C.Prop[] \as CP;
\import C.Absolute[] \as Abs;
\import linear_algebra.Hermitian[].Complex[] \as Conjugation;
\import vector_bundles.Bundles[].Complex[] \as Scalar;
\import vector_bundles.Bundles[].Over[K := C.Complex, field := CA.field, conjugation := Conjugation.scalar, scalar := Scalar.scalar] \as Native;
\import bundle_complements.Complements[].Over[K := C.Complex, field := CA.field, conjugation := Conjugation.scalar, scalar := Scalar.scalar] \as Complements;
\import bundle_homotopy.Homotopy[].Over[K := C.Complex, field := CA.field, conjugation := Conjugation.scalar, scalar := Scalar.scalar] \as Homotopy;
\import linear_algebra.Commutative[K := C.Complex, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing C.Complex CA.field] \as Spaces;
\import hermitian_frames.Hermitian[].Over[K := C.Complex, field := CA.field, scalar := Conjugation.scalar, topological := Scalar.scalar.topological] \as Hermitian;
\import std.Data[].FinSet[] \as Fin;
\module Over(X: \Set, F: X -> \Set, bundle: Native.Family[X := X, F := F].Bundle);
