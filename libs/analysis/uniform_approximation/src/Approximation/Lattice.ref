\definition differenceAbsolute: \forall (a, b: R.Real) -> absolute (R.sub a b) = R.distance a b := \fun (a, b: R.Real) =>
  trans!{{R.Real}} _ _ _ (Distance.distanceSymmetric R.zero (R.sub a b)) (Estimates.distanceDifference a b);
\definition halfAddSub: \forall (a, b: R.Real) -> R.mul R.half (R.add (R.add a b) (R.sub b a)) = b := \fun (a, b: R.Real) =>
  eq_reason_in!{{R.Real} _
    "=" { R.mul R.half (R.add a (R.add b (R.sub b a))) } "by" { congr!{{R.Real} {R.Real}} (R.mul R.half) _ _ (Laws.addAssoc a b (R.sub b a)) }
    "=" { R.mul R.half (R.add b (R.add a (R.sub b a))) } "by" { congr!{{R.Real} {R.Real}} (R.mul R.half) _ _ (Algebra.addSwap a b (R.sub b a)) }
    "=" { R.mul R.half (R.add b b) } "by" { congr!{{R.Real} {R.Real}} (R.mul R.half) _ _ (congr!{{R.Real} {R.Real}} (R.add b) _ _ (Estimates.addSubCancel b a)) }
    "=" { R.add (R.mul R.half b) (R.mul R.half b) } "by" { Laws.fieldMulAdd R.half b b }
    "=" { b } "by" { Estimates.halfTwice b }
  };
\definition halfDistance: \forall (a, b: R.Real) -> Real.Le a b -> R.mul R.half (R.add (R.add a b) (R.distance a b)) = b := \fun (a, b: R.Real)(ordered: _) =>
  trans!{{R.Real}} _ _ _ (congr!{{R.Real} {R.Real}} (R.mul R.half) _ _ (congr!{{R.Real} {R.Real}} (R.add (R.add a b)) _ _ (R.SquareRoot[].distanceOrdered a b ordered))) (halfAddSub a b);
\definition maximumDistance: \forall (a, b: R.Real) -> Distance.max a b = R.mul R.half (R.add (R.add a b) (R.distance a b)) := \fun (a, b: R.Real) =>
  Logic.orElim[(Real.Le a b), (Real.Le b a), (Distance.max a b = R.mul R.half (R.add (R.add a b) (R.distance a b)))] (Order.leTotal a b)
    (\fun (ordered: Real.Le a b) => trans!{{R.Real}} _ _ _ (Distance.maxOfLe a b ordered) (sym!{{R.Real}} _ _ (halfDistance a b ordered)))
    (\fun (ordered: Real.Le b a) => trans!{{R.Real}} _ _ _ (Distance.maxOfGe a b ordered)
      (sym!{{R.Real}} _ _ (trans!{{R.Real}} _ _ _ (congr!{{R.Real} {R.Real}} (R.mul R.half) _ _ (congr!{{R.Real} {R.Real} {R.Real}} R.add _ _ _ _ (Laws.addComm a b) (Distance.distanceSymmetric a b))) (halfDistance b a ordered))));
\definition maximumFormula: \forall (a, b: R.Real) -> Distance.max a b = R.mul R.half (R.add (R.add a b) (absolute (R.sub a b))) := \fun (a, b: R.Real) =>
  trans!{{R.Real}} _ _ _ (maximumDistance a b) (congr!{{R.Real} {R.Real}} (R.mul R.half) _ _ (congr!{{R.Real} {R.Real}} (R.add (R.add a b)) _ _ (sym!{{R.Real}} _ _ (differenceAbsolute a b))));
