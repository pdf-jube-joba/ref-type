\import \root.Approximation[].ComplexOn[X := X, space := space].FiniteComponents[n := m] \as Rows;
\import Fin.Choice[A := Rows.Family] \as RowChoice;
\definition Matrices: \Set := Fin.Fin n -> Fin.Fin m -> Function;
\definition density: \forall (A: \Pow Function)(f: Matrices) -> (\forall (i: Fin.Fin n)(j: Fin.Fin m) -> Approximates A (f i j)) -> \forall (epsilon: R.Real) -> Real.Lt R.zero epsilon ->
  \exists (g: Matrices \where \forall (i: Fin.Fin n) -> Logic.And[(\forall (j: Fin.Fin m) -> \In[Function] A (g i j)), Rows.Error (f i) (g i) epsilon]) :=
  \fun (A: \Pow Function)(f: Matrices)(each: _)(epsilon: R.Real)(positive: _) =>
    RowChoice.exists n (\fun (i: Fin.Fin n)(row: Rows.Family) => Logic.And[(\forall (j: Fin.Fin m) -> \In[Function] A (row j)), Rows.Error (f i) row epsilon])
      (\fun (i: Fin.Fin n) => Rows.density A (f i) (each i) epsilon positive);
