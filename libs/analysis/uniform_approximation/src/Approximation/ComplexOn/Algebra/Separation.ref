\definition result: Reals.Separates realAlgebra := \block {
  \fun (x, y: X)(distinct: Logic.Not (x = y)) \then
  \takefrom h: \Cast[Function] ({ h: Function \where Logic.And[\In[Function] A h, Logic.Not (h x = h y)] }) \by separates x y distinct \then
  \let properties: Logic.And[\In[Function] A h, Logic.Not (h x = h y)] := \bysub(Function, { h: Function \where Logic.And[\In[Function] A h, Logic.Not (h x = h y)] }, h) \then
  \return Logic.orElim[(C.re (h x) = C.re (h y)), Logic.Not (C.re (h x) = C.re (h y)), (\exists (g: Reals.Function \where Logic.And[\In[Reals.Function] realAlgebra g, Logic.Not (g x = g y)]))]
    (Classical.excludedMiddle (C.re (h x) = C.re (h y)))
    (\fun (equal: C.re (h x) = C.re (h y)) => Logic.existsIntro[Reals.Function, { g: Reals.Function \where Logic.And[\In[Reals.Function] realAlgebra g, Logic.Not (g x = g y)] }] (imaginaryPart h)
      (Logic.And[_, _]::# (imaginaryMember h properties.left) (\fun (imaginary: C.im (h x) = C.im (h y)) => properties.right (CP.ext (h x) (h y) equal imaginary))))
    (\fun (unequal: Logic.Not (C.re (h x) = C.re (h y))) => Logic.existsIntro[Reals.Function, { g: Reals.Function \where Logic.And[\In[Reals.Function] realAlgebra g, Logic.Not (g x = g y)] }] (realPart h) (Logic.And[_, _]::# (realMember h properties.left) unequal))
};
