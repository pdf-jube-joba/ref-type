\import std.Data[].FinSet[] \as Fin;
\import Fin.Choice[A := A] \as Entries;
\import Fin.Choice[A := Fin.Fin m -> A] \as Rows;
\definition exists: \forall (relation: Fin.Fin n -> Fin.Fin m -> A -> \Prop) -> (\forall (i: Fin.Fin n)(j: Fin.Fin m) -> \exists (a: A \where relation i j a)) ->
  \exists (f: Fin.Fin n -> Fin.Fin m -> A \where \forall (i: Fin.Fin n)(j: Fin.Fin m) -> relation i j (f i j)) :=
  \fun (relation: Fin.Fin n -> Fin.Fin m -> A -> \Prop)(each: _) => Rows.exists n (\fun (i: Fin.Fin n)(row: Fin.Fin m -> A) => \forall (j: Fin.Fin m) -> relation i j (row j))
    (\fun (i: Fin.Fin n) => Entries.exists m (relation i) (each i));
