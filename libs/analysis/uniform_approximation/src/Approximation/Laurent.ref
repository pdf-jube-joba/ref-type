\import complex.Complex[] \as C;
\import C.Def[] \as O;
\import C.Prop[] \as CP;
\import C.Algebra[] \as CA;
\import \root.Approximation[].ComplexOn[X := X, space := space].FunctionRing[] \as Coefficients;
\import algebra.LaurentPolynomial[].Over[R := Coefficients.Carrier, coefficients := Coefficients.commutativeRing] \as P;
\import std.Alg[].Ring[] \as Rings;
\import P.Universal[K := C.Complex, target := CA.commutativeRing] \as Evaluation;
\import algebra.Hom[A := P.Carrier, B := C.Complex] \as Hom;
\import algebra.Group[].Of[Carrier := C.Complex, group := Rings.additiveGroup C.Complex (Rings.commutativeRingAsRing C.Complex CA.commutativeRing)] \as Additive;
\definition Carrier: \Set := P.Carrier;
\module On(Y: \Set, source: topology.Topology[Carrier := Y].Topology, base: Y -> X, baseContinuous: topology.Continuity[A := Y, B := X].Continuous source space base, unit: Y -> C.Complex, unitContinuous: topology.Continuity[A := Y, B := C.Complex].Continuous source topological_algebra.Complex[].topology unit, norm: \forall (y: Y) -> O.normSq (unit y) = R.one);
