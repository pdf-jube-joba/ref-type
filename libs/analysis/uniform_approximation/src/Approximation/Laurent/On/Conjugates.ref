\structure Conjugate[p: Carrier]: \Set := { polynomial: Carrier, formula: \forall (y: Y) -> value polynomial y = O.conj (value p y) };
\definition exists: \forall (p: Carrier) -> \exists Conjugate[p] :=
  P.induction (\fun (p: Carrier) => \exists Conjugate[p])
    (\fun (a: Coefficients.Carrier) => \exact(Conjugate[P.constant a] { polynomial := P.constant (Coefficients.conjugate a), formula := \fun (y: Y) =>
      trans!{{C.Complex}} _ _ _ (onConstant (Coefficients.conjugate a) y) (congr!{{C.Complex} {C.Complex}} O.conj _ _ (sym!{{C.Complex}} _ _ (onConstant a y)))
    }, Conjugate[P.constant a]))
    (\exact(Conjugate[P.X] { polynomial := P.inverseX, formula := \fun (y: Y) => trans!{{C.Complex}} _ _ _ (onInverseVariable y) (congr!{{C.Complex} {C.Complex}} O.conj _ _ (sym!{{C.Complex}} _ _ (onVariable y))) }, Conjugate[P.X]))
    (\exact(Conjugate[P.inverseX] { polynomial := P.X, formula := \fun (y: Y) => eq_reason_in!{{C.Complex} _
      "=" { unit y } "by" { onVariable y }
      "=" { O.conj (O.conj (unit y)) } "by" { sym!{{C.Complex}} _ _ (CP.conjConj (unit y)) }
      "=" { O.conj (value P.inverseX y) } "by" { congr!{{C.Complex} {C.Complex}} O.conj _ _ (sym!{{C.Complex}} _ _ (onInverseVariable y)) }
    } }, Conjugate[P.inverseX]))
    (\fun (p, q: Carrier)(first: \exists Conjugate[p])(second: \exists Conjugate[q]) => \block {
      \takefrom a: Conjugate[p] \by first \then
      \takefrom b: Conjugate[q] \by second \then
      \return \exact(Conjugate[P.add p q] { polynomial := P.add a.polynomial b.polynomial, formula := \fun (y: Y) => eq_reason_in!{{C.Complex} _
        "=" { O.add (value a.polynomial y) (value b.polynomial y) } "by" { onAdd a.polynomial b.polynomial y }
        "=" { O.add (O.conj (value p y)) (O.conj (value q y)) } "by" { congr!{{C.Complex} {C.Complex} {C.Complex}} O.add _ _ _ _ (a.formula y) (b.formula y) }
        "=" { O.conj (O.add (value p y) (value q y)) } "by" { sym!{{C.Complex}} _ _ (CP.conjAdd (value p y) (value q y)) }
        "=" { O.conj (value (P.add p q) y) } "by" { congr!{{C.Complex} {C.Complex}} O.conj _ _ (sym!{{C.Complex}} _ _ (onAdd p q y)) }
      } }, Conjugate[P.add p q])
    })
    (\fun (p: Carrier)(previous: \exists Conjugate[p]) => \block {
      \takefrom a: Conjugate[p] \by previous \then
      \return \exact(Conjugate[P.neg p] { polynomial := P.neg a.polynomial, formula := \fun (y: Y) => eq_reason_in!{{C.Complex} _
        "=" { O.neg (value a.polynomial y) } "by" { onNeg a.polynomial y }
        "=" { O.conj (O.neg (value p y)) } "by" { congr!{{C.Complex} {C.Complex}} O.neg _ _ (a.formula y) }
        "=" { O.conj (value (P.neg p) y) } "by" { congr!{{C.Complex} {C.Complex}} O.conj _ _ (sym!{{C.Complex}} _ _ (onNeg p y)) }
      } }, Conjugate[P.neg p])
    })
    (\fun (p, q: Carrier)(first: \exists Conjugate[p])(second: \exists Conjugate[q]) => \block {
      \takefrom a: Conjugate[p] \by first \then
      \takefrom b: Conjugate[q] \by second \then
      \return \exact(Conjugate[P.mul p q] { polynomial := P.mul a.polynomial b.polynomial, formula := \fun (y: Y) => eq_reason_in!{{C.Complex} _
        "=" { O.mul (value a.polynomial y) (value b.polynomial y) } "by" { onMul a.polynomial b.polynomial y }
        "=" { O.mul (O.conj (value p y)) (O.conj (value q y)) } "by" { congr!{{C.Complex} {C.Complex} {C.Complex}} O.mul _ _ _ _ (a.formula y) (b.formula y) }
        "=" { O.conj (O.mul (value p y) (value q y)) } "by" { sym!{{C.Complex}} _ _ (CP.conjMul (value p y) (value q y)) }
        "=" { O.conj (value (P.mul p q) y) } "by" { congr!{{C.Complex} {C.Complex}} O.conj _ _ (sym!{{C.Complex}} _ _ (onMul p q y)) }
      } }, Conjugate[P.mul p q])
    });
