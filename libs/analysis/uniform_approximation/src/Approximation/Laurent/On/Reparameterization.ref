\import topology.Composition[A := Z, B := Y, C := X] \as BaseCompose;
\import topology.Composition[A := Z, B := Y, C := C.Complex] \as UnitCompose;
\definition nextBase: Z -> X := \fun (z: Z) => base (map z);
\definition nextUnit: Z -> C.Complex := \fun (z: Z) => unit (map z);
\definition baseRegular: topology.Continuity[A := Z, B := X].Continuous targetSpace space nextBase := BaseCompose.composeContinuous targetSpace source space map base regular baseContinuous;
\definition unitRegular: topology.Continuity[A := Z, B := C.Complex].Continuous targetSpace topological_algebra.Complex[].topology nextUnit := UnitCompose.composeContinuous targetSpace source topological_algebra.Complex[].topology map unit regular unitContinuous;
\definition nextNorm: \forall (z: Z) -> O.normSq (nextUnit z) = R.one := \fun (z: Z) => norm (map z);
\import \root.Approximation[].Laurent[X := X, space := space].On[Y := Z, source := targetSpace, base := nextBase, baseContinuous := baseRegular, unit := nextUnit, unitContinuous := unitRegular, norm := nextNorm] \as Next;
\definition onValue: \forall (p: Carrier)(z: Z) -> Next.value p z = value p (map z) := \fun (p: Carrier)(z: Z) => \refl(value p (map z));
\definition error: \forall (f: Functions.Function)(p: Carrier)(epsilon: R.Real) -> Functions.Error f (value p) epsilon ->
  \root.Approximation[].ComplexOn[X := Z, space := targetSpace].Error (\fun (z: Z) => f (map z)) (Next.value p) epsilon :=
  \fun (f: Functions.Function)(p: Carrier)(epsilon: R.Real)(near: Functions.Error f (value p) epsilon)(z: Z) => near (map z);
