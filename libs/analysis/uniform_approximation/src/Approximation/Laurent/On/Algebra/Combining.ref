\definition addition: \In[Functions.Function] Subalgebra (Functions.sum f g) := \block {
  \takefrom p: \Cast[Carrier] ({ p: Carrier \where f = value p }) \by first \then
  \takefrom q: \Cast[Carrier] ({ q: Carrier \where g = value q }) \by second \then
  \return Logic.existsIntro[Carrier, { r: Carrier \where Functions.sum f g = value r }] (P.add p q)
    (trans!{{Functions.Function}} _ _ _ (congr!{{Functions.Function} {Functions.Function} {Functions.Function}} Functions.sum _ _ _ _ (\bysub(Carrier, { p: Carrier \where f = value p }, p)) (\bysub(Carrier, { q: Carrier \where g = value q }, q))) (sym!{{Functions.Function}} _ _ (addFunction p q)))
};
\definition multiplication: \In[Functions.Function] Subalgebra (Functions.product f g) := \block {
  \takefrom p: \Cast[Carrier] ({ p: Carrier \where f = value p }) \by first \then
  \takefrom q: \Cast[Carrier] ({ q: Carrier \where g = value q }) \by second \then
  \return Logic.existsIntro[Carrier, { r: Carrier \where Functions.product f g = value r }] (P.mul p q)
    (trans!{{Functions.Function}} _ _ _ (congr!{{Functions.Function} {Functions.Function} {Functions.Function}} Functions.product _ _ _ _ (\bysub(Carrier, { p: Carrier \where f = value p }, p)) (\bysub(Carrier, { q: Carrier \where g = value q }, q))) (sym!{{Functions.Function}} _ _ (mulFunction p q)))
};
