\definition negation: \In[Functions.Function] Subalgebra (Functions.negative f) := \block {
  \takefrom p: \Cast[Carrier] ({ p: Carrier \where f = value p }) \by represented \then
  \return Logic.existsIntro[Carrier, { q: Carrier \where Functions.negative f = value q }] (P.neg p)
    (trans!{{Functions.Function}} _ _ _ (congr!{{Functions.Function} {Functions.Function}} Functions.negative _ _ (\bysub(Carrier, { p: Carrier \where f = value p }, p))) (sym!{{Functions.Function}} _ _ (negFunction p)))
};
\definition conjugation: \In[Functions.Function] Subalgebra (Functions.conjugate f) := \block {
  \takefrom p: \Cast[Carrier] ({ p: Carrier \where f = value p }) \by represented \then
  \takefrom q: \parent.\parent.Conjugates[].Conjugate[p] \by \parent.\parent.Conjugates[].exists p \then
  \return Logic.existsIntro[Carrier, { q: Carrier \where Functions.conjugate f = value q }] q.polynomial
    (trans!{{Functions.Function}} _ _ _ (congr!{{Functions.Function} {Functions.Function}} Functions.conjugate _ _ (\bysub(Carrier, { p: Carrier \where f = value p }, p)))
      (sym!{{Functions.Function}} _ _ (\axiom:funext(value q.polynomial, Functions.conjugate (value p), q.formula))))
};
