\import complex.Complex[] \as C;
\import std.Data[].Pair[] \as Pair;
\import Pair.Prop[A := X, B := Carrier] \as Pairs;
\import topological_constructions.Product[A := X, B := Carrier] \as Product;
\import Product.Maps[] \as Maps;
\definition Domain: \Set := Product.CarrierSet;
\definition source: topology.Topology[Carrier := Domain].Topology := Product.topology space topology;
\definition first: Domain -> X := Pair.first X Carrier;
\definition second: Domain -> Carrier := Pair.second X Carrier;
\definition unit: Domain -> C.Complex := \fun (p: Domain) => second p;
\import topology.Composition[A := Domain, B := Carrier, C := C.Complex] \as Compose;
\definition unitContinuous: topology.Continuity[A := Domain, B := C.Complex].Continuous source topological_algebra.Complex[].topology unit :=
  Compose.composeContinuous source topology topological_algebra.Complex[].topology second (\fun (z: Carrier) => z) (Maps.secondContinuous space topology) Coordinates.inclusionContinuous;
\definition unitNorm: \forall (p: Domain) -> complex.Complex[].Def[].normSq (unit p) = R.one := \fun (p: Domain) => Native.norm (second p);
\import \root.Approximation[].Laurent[X := X, space := space] \as Polynomials;
\import Polynomials.On[Y := Domain, source := source, base := first, baseContinuous := Maps.firstContinuous space topology, unit := unit, unitContinuous := unitContinuous, norm := unitNorm] \as Evaluation;
\import \root.Approximation[].ComplexOn[X := Domain, space := source] \as Functions;
\import \root.Approximation[].ComplexOn[X := X, space := space].SeparatePoints[compact := baseCompact, hausdorff := baseHausdorff] \as Points;
\import \root.Approximation[].ComplexOn[X := X, space := space].FunctionRing[] \as CoefficientRing;
\import algebra.LaurentPolynomial[].Over[R := CoefficientRing.Carrier, coefficients := CoefficientRing.commutativeRing] \as P;
\import topology.Topology[Carrier := Domain] \as DomainSpace;
\definition domainCompact: DomainSpace.IsCompact source := Product.Compactness[].productCompact space topology baseCompact compact;
\definition domainHausdorff: DomainSpace.IsT2 source := \root.Approximation[].Separation[].Product[A := X, B := Carrier].On[left := space, right := topology, leftHausdorff := baseHausdorff, rightHausdorff := hausdorff].hausdorff;
\module Separation;
\module Approximate(f: Functions.Function, regular: Functions.Continuous f);
\import std.Data[].FinSet[] \as Fin;
\module Matrices(n, m: N.Nat^, f: Fin.Fin n -> Fin.Fin m -> Functions.Function, regular: \forall (i: Fin.Fin n)(j: Fin.Fin m) -> Functions.Continuous (f i j));
