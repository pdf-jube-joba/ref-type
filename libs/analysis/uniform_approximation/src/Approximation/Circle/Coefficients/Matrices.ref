\definition exists: \forall (epsilon: R.Real) -> Real.Lt R.zero epsilon -> \exists (p: Fin.Fin n -> Fin.Fin m -> Polynomials.Carrier \where \forall (i: Fin.Fin n)(j: Fin.Fin m) -> Functions.Error (f i j) (Evaluation.value (p i j)) epsilon) :=
  \fun (epsilon: R.Real)(positive: Real.Lt R.zero epsilon) => \root.Approximation[].FiniteChoices[A := Polynomials.Carrier, n := n, m := m].exists (\fun (i: Fin.Fin n)(j: Fin.Fin m)(p: Polynomials.Carrier) => Functions.Error (f i j) (Evaluation.value p) epsilon)
    (\fun (i: Fin.Fin n)(j: Fin.Fin m) => \parent.Approximate[f := f i j, regular := regular i j].exists epsilon positive);
