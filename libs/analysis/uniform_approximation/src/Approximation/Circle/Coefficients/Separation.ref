\definition result: Functions.Separates Evaluation.Algebra[].Subalgebra := \fun (p, q: Domain)(distinct: Logic.Not (p = q)) =>
  Logic.orElim[(second p = second q), Logic.Not (second p = second q), (\exists (h: Functions.Function \where Logic.And[\In[Functions.Function] Evaluation.Algebra[].Subalgebra h, Logic.Not (h p = h q)]))] (Classical.excludedMiddle (second p = second q))
    (\fun (equal: second p = second q) => \block {
      \let firstDistinct: Logic.Not (first p = first q) := \fun (other: first p = first q) => distinct (Pairs.ext p q other equal) \then
      \takefrom h: \Cast[(X -> C.Complex)] ({ h: (X -> C.Complex) \where Logic.And[topology.Continuity[A := X, B := C.Complex].Continuous space topological_algebra.Complex[].topology h, Logic.Not (h (first p) = h (first q))] }) \by Points.result (first p) (first q) firstDistinct \then
      \let properties: Logic.And[topology.Continuity[A := X, B := C.Complex].Continuous space topological_algebra.Complex[].topology h, Logic.Not (h (first p) = h (first q))] := \bysub((X -> C.Complex), { h: (X -> C.Complex) \where Logic.And[topology.Continuity[A := X, B := C.Complex].Continuous space topological_algebra.Complex[].topology h, Logic.Not (h (first p) = h (first q))] }, h) \then
      \let coefficient: CoefficientRing.Carrier := \into[(X -> C.Complex)](h, CoefficientRing.Carrier) \by { properties.left } \then
      \return Logic.existsIntro[Functions.Function, { g: Functions.Function \where Logic.And[\In[Functions.Function] Evaluation.Algebra[].Subalgebra g, Logic.Not (g p = g q)] }] (Evaluation.value (P.constant coefficient))
        (Logic.And[_, _]::# (Evaluation.Algebra[].member (P.constant coefficient)) (\fun (same: Evaluation.value (P.constant coefficient) p = Evaluation.value (P.constant coefficient) q) => properties.right
          (trans!{{C.Complex}} _ _ _ (sym!{{C.Complex}} _ _ (Evaluation.onConstant coefficient p)) (trans!{{C.Complex}} _ _ _ same (Evaluation.onConstant coefficient q)))))
    })
    (\fun (unequal: Logic.Not (second p = second q)) => Logic.existsIntro[Functions.Function, { g: Functions.Function \where Logic.And[\In[Functions.Function] Evaluation.Algebra[].Subalgebra g, Logic.Not (g p = g q)] }] (Evaluation.value P.X)
      (Logic.And[_, _]::# (Evaluation.Algebra[].member P.X) (\fun (same: Evaluation.value P.X p = Evaluation.value P.X q) => unequal
        (trans!{{Carrier}} _ _ _ (sym!{{C.Complex}} _ _ (Evaluation.onVariable p)) (trans!{{C.Complex}} _ _ _ same (Evaluation.onVariable q))))));
