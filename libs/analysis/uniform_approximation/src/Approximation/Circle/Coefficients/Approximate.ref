\import Functions.Algebra[A := Evaluation.Algebra[].Subalgebra, laws := Evaluation.Algebra[].laws].Compact[compact := domainCompact, hausdorff := domainHausdorff, separates := \parent.Separation[].result].StoneWeierstrass[f := f, regular := regular] \as Density;
\definition exists: \forall (epsilon: R.Real) -> Real.Lt R.zero epsilon -> \exists (p: Polynomials.Carrier \where Functions.Error f (Evaluation.value p) epsilon) := \block {
  \fun (epsilon: R.Real)(positive: Real.Lt R.zero epsilon) \then
  \takefrom g: \Cast[Functions.Function] ({ g: Functions.Function \where Logic.And[\In[Functions.Function] Evaluation.Algebra[].Subalgebra g, Functions.Error f g epsilon] }) \by Density.approximation epsilon positive \then
  \let properties: Logic.And[\In[Functions.Function] Evaluation.Algebra[].Subalgebra g, Functions.Error f g epsilon] := \bysub(Functions.Function, { g: Functions.Function \where Logic.And[\In[Functions.Function] Evaluation.Algebra[].Subalgebra g, Functions.Error f g epsilon] }, g) \then
  \takefrom p: \Cast[Polynomials.Carrier] ({ p: Polynomials.Carrier \where g = Evaluation.value p }) \by properties.left \then
  \return Logic.existsIntro[Polynomials.Carrier, { p: Polynomials.Carrier \where Functions.Error f (Evaluation.value p) epsilon }] p
    (\idelim g = Evaluation.value p \with h: Functions.Function => Functions.Error f h epsilon \by { base: properties.right, equality: \bysub(Polynomials.Carrier, { p: Polynomials.Carrier \where g = Evaluation.value p }, p) })
};
