\definition exists: \forall (epsilon: R.Real) -> Real.Lt R.zero epsilon -> \exists (p: Fin.Fin n -> Fin.Fin m -> P.Carrier \where \forall (i: Fin.Fin n)(j: Fin.Fin m) -> Functions.Error (f i j) (value (p i j)) epsilon) :=
  \fun (epsilon: R.Real)(positive: Real.Lt R.zero epsilon) => \root.Approximation[].FiniteChoices[A := P.Carrier, n := n, m := m].exists (\fun (i: Fin.Fin n)(j: Fin.Fin m)(p: P.Carrier) => Functions.Error (f i j) (value p) epsilon)
    (\fun (i: Fin.Fin n)(j: Fin.Fin m) => \parent.Approximate[f := f i j, regular := regular i j].exists epsilon positive);
