\import Functions.Algebra[A := CoefficientEvaluation.Algebra[].Subalgebra, laws := CoefficientEvaluation.Algebra[].laws].Compact[compact := compact, hausdorff := hausdorff, separates := separates].StoneWeierstrass[f := f, regular := regular] \as Density;
\definition exists: \forall (epsilon: R.Real) -> Real.Lt R.zero epsilon -> \exists (p: P.Carrier \where Functions.Error f (value p) epsilon) := \block {
  \fun (epsilon: R.Real)(positive: Real.Lt R.zero epsilon) \then
  \takefrom g: \Cast[Functions.Function] ({ g: Functions.Function \where Logic.And[\In[Functions.Function] CoefficientEvaluation.Algebra[].Subalgebra g, Functions.Error f g epsilon] }) \by Density.approximation epsilon positive \then
  \let properties: Logic.And[\In[Functions.Function] CoefficientEvaluation.Algebra[].Subalgebra g, Functions.Error f g epsilon] := \bysub(Functions.Function, { g: Functions.Function \where Logic.And[\In[Functions.Function] CoefficientEvaluation.Algebra[].Subalgebra g, Functions.Error f g epsilon] }, g) \then
  \takefrom p: \Cast[CoefficientPolynomials.Carrier] ({ p: CoefficientPolynomials.Carrier \where g = CoefficientEvaluation.value p }) \by properties.left \then
  \takefrom q: \parent.Translation[].Translated[p] \by \parent.Translation[].exists p \then
  \return Logic.existsIntro[P.Carrier, { p: P.Carrier \where Functions.Error f (value p) epsilon }] q.polynomial
    (\idelim g = value q.polynomial \with h: Functions.Function => Functions.Error f h epsilon \by {
      base: properties.right,
      equality: trans!{{Functions.Function}} _ _ _ (\bysub(CoefficientPolynomials.Carrier, { p: CoefficientPolynomials.Carrier \where g = CoefficientEvaluation.value p }, p)) (sym!{{Functions.Function}} _ _ (\axiom:funext(value q.polynomial, CoefficientEvaluation.value p, q.formula)))
    })
};
