\structure Translated[p: CoefficientPolynomials.Carrier]: \Set := { polynomial: P.Carrier, formula: \forall (z: Carrier) -> value polynomial z = CoefficientEvaluation.value p z };
\definition exists: \forall (p: CoefficientPolynomials.Carrier) -> \exists Translated[p] :=
  CoefficientP.induction (\fun (p: CoefficientPolynomials.Carrier) => \exists Translated[p])
    (\fun (a: CoefficientRing.Carrier) => \exact(Translated[CoefficientP.constant a] { polynomial := P.constant (a point), formula := \fun (z: Carrier) =>
      trans!{{C.Complex}} _ _ _ (onConstant (a point) z) (sym!{{C.Complex}} _ _ (CoefficientEvaluation.onConstant a z))
    }, Translated[CoefficientP.constant a]))
    (\exact(Translated[CoefficientP.X] { polynomial := P.X, formula := \fun (z: Carrier) => trans!{{C.Complex}} _ _ _ (onVariable z) (sym!{{C.Complex}} _ _ (CoefficientEvaluation.onVariable z)) }, Translated[CoefficientP.X]))
    (\exact(Translated[CoefficientP.inverseX] { polynomial := P.inverseX, formula := \fun (z: Carrier) => trans!{{C.Complex}} _ _ _ (onInverseVariable z) (sym!{{C.Complex}} _ _ (CoefficientEvaluation.onInverseVariable z)) }, Translated[CoefficientP.inverseX]))
    (\fun (p, q: CoefficientPolynomials.Carrier)(first: \exists Translated[p])(second: \exists Translated[q]) => \block {
      \takefrom a: Translated[p] \by first \then
      \takefrom b: Translated[q] \by second \then
      \return \exact(Translated[CoefficientP.add p q] { polynomial := P.add a.polynomial b.polynomial, formula := \fun (z: Carrier) =>
        trans!{{C.Complex}} _ _ _ (onAdd a.polynomial b.polynomial z) (trans!{{C.Complex}} _ _ _ (congr!{{C.Complex} {C.Complex} {C.Complex}} O.add _ _ _ _ (a.formula z) (b.formula z)) (sym!{{C.Complex}} _ _ (CoefficientEvaluation.onAdd p q z)))
      }, Translated[CoefficientP.add p q])
    })
    (\fun (p: CoefficientPolynomials.Carrier)(previous: \exists Translated[p]) => \block {
      \takefrom a: Translated[p] \by previous \then
      \return \exact(Translated[CoefficientP.neg p] { polynomial := P.neg a.polynomial, formula := \fun (z: Carrier) =>
        trans!{{C.Complex}} _ _ _ (onNeg a.polynomial z) (trans!{{C.Complex}} _ _ _ (congr!{{C.Complex} {C.Complex}} O.neg _ _ (a.formula z)) (sym!{{C.Complex}} _ _ (CoefficientEvaluation.onNeg p z)))
      }, Translated[CoefficientP.neg p])
    })
    (\fun (p, q: CoefficientPolynomials.Carrier)(first: \exists Translated[p])(second: \exists Translated[q]) => \block {
      \takefrom a: Translated[p] \by first \then
      \takefrom b: Translated[q] \by second \then
      \return \exact(Translated[CoefficientP.mul p q] { polynomial := P.mul a.polynomial b.polynomial, formula := \fun (z: Carrier) =>
        trans!{{C.Complex}} _ _ _ (onMul a.polynomial b.polynomial z) (trans!{{C.Complex}} _ _ _ (congr!{{C.Complex} {C.Complex} {C.Complex}} O.mul _ _ _ _ (a.formula z) (b.formula z)) (sym!{{C.Complex}} _ _ (CoefficientEvaluation.onMul p q z)))
      }, Translated[CoefficientP.mul p q])
    });
