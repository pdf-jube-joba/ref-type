\import complex.Complex[] \as C;
\import C.Def[] \as O;
\import C.Prop[] \as CP;
\import C.Absolute[] \as Abs;
\import \root.Approximation[].ComplexScalars[] \as Scalars;
\import topological_algebra.Complex[] \as Plane;
\import Plane.Functions[A := X] \as Functions;
\import topology.Topology[Carrier := X] \as Base;
\import topology.Continuity[A := X, B := C.Complex] \as Maps;
\import \root.Approximation[].On[X := X, space := space] \as Reals;
\definition Function: \Set := X -> C.Complex;
\definition Continuous[f: Function]: \Prop := Maps.Continuous space Plane.topology f;
\definition constant[a: C.Complex]: Function := \fun (x: X) => a;
\definition sum[f, g: Function]: Function := \fun (x: X) => O.add (f x) (g x);
\definition negative[f: Function]: Function := \fun (x: X) => O.neg (f x);
\definition product[f, g: Function]: Function := \fun (x: X) => O.mul (f x) (g x);
\definition conjugate[f: Function]: Function := \fun (x: X) => O.conj (f x);
\definition embed[f: Reals.Function]: Function := \fun (x: X) => O.ofReal (f x);
\definition realPart[f: Function]: Reals.Function := \fun (x: X) => C.re (f x);
\definition imaginaryPart[f: Function]: Reals.Function := \fun (x: X) => C.im (f x);
\definition Error[f, g: Function][epsilon: R.Real]: \Prop := \forall (x: X) -> Real.Lt (Abs.abs (O.sub (f x) (g x))) epsilon;
\definition Approximates[A: \Pow Function][f: Function]: \Prop := \forall (epsilon: R.Real) -> Real.Lt R.zero epsilon -> \exists (g: Function \where Logic.And[\In[Function] A g, Error f g epsilon]);
\structure SubalgebraLaws[A: \Pow Function]: \Prop := {
  continuous: \forall (f: Function) -> \In[Function] A f -> Continuous f,
  constants: \forall (a: C.Complex) -> \In[Function] A (constant a),
  addition: \forall (f, g: Function) -> \In[Function] A f -> \In[Function] A g -> \In[Function] A (sum f g),
  negation: \forall (f: Function) -> \In[Function] A f -> \In[Function] A (negative f),
  multiplication: \forall (f, g: Function) -> \In[Function] A f -> \In[Function] A g -> \In[Function] A (product f g),
  conjugation: \forall (f: Function) -> \In[Function] A f -> \In[Function] A (conjugate f)
};
\definition Separates[A: \Pow Function]: \Prop := \forall (x, y: X) -> Logic.Not (x = y) -> \exists (h: Function \where Logic.And[\In[Function] A h, Logic.Not (h x = h y)]);
\module Algebra(A: \Pow Function, laws: SubalgebraLaws[A]);
