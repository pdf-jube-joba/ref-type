\definition Pointwise: \Prop := \forall (epsilon: R.Real) -> Real.Lt R.zero epsilon -> \forall (x: X) -> \exists (n: N.Nat^ \where Real.Lt (error n x) epsilon);
\module At(epsilon: R.Real);
\definition uniform: Base.IsCompact space -> Pointwise -> \forall (epsilon: R.Real) -> Real.Lt R.zero epsilon -> \exists (n: N.Nat^ \where \forall (x: X) -> Real.Lt (error n x) epsilon) := \block {
  \fun (compact: Base.IsCompact space)(pointwise: Pointwise)(epsilon: R.Real)(positive: Real.Lt R.zero epsilon) \then
  \takefrom finite: \Cast[std.Set[].FiniteSubset[A := \Pow X].FiniteSubset] ({ finite: std.Set[].FiniteSubset[A := \Pow X].FiniteSubset \where Base.FiniteSubcover[At[epsilon := epsilon].family, Base.Whole, finite] })
    \by compact (At[epsilon := epsilon].family) (At[epsilon := epsilon].cover (pointwise epsilon positive)) \then
  \let cover: Base.FiniteSubcover[At[epsilon := epsilon].family, Base.Whole, finite] := \bysub(std.Set[].FiniteSubset[A := \Pow X].FiniteSubset, { finite: std.Set[].FiniteSubset[A := \Pow X].FiniteSubset \where Base.FiniteSubcover[At[epsilon := epsilon].family, Base.Whole, finite] }, finite) \then
  \takefrom bound: At[epsilon := epsilon].Bound[finite] \by At[epsilon := epsilon].finiteBound finite cover.included \then
  \return Logic.existsIntro[N.Nat^, { n: N.Nat^ \where \forall (x: X) -> Real.Lt (error n x) epsilon }] bound.index
    (\fun (x: X) => Base.unionMemberElim finite x (Real.Lt (error bound.index x) epsilon) (\fun (U: \Pow X)(member: std.Set[].FiniteSubset[A := \Pow X].Member finite U)(inside: Base.Member U x) => bound.bounds U member x inside) (cover.covers x (\refl(x))))
};
