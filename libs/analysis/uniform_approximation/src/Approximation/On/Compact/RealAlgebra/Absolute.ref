\module With(bound: Bound[f]);
\definition result: InClosure[absoluteValue f] := limit (absoluteValue f) (Functions.Lattice[].absoluteContinuous space f closed.continuous)
  (\fun (epsilon: R.Real)(positive: Real.Lt R.zero epsilon) => \block {
    \takefrom bound: Bound[f] \by \parent.\parent.Bounded[f := f, regular := closed.continuous].exists \then
    \return With[bound := bound].approximation epsilon positive
  });
