\module With(firstBound: Bound[f], secondBound: Bound[g]);
\definition closed: InClosure[product f g] := InClosure[product f g] {
  continuous := Functions.Product[].continuous space f g first.continuous second.continuous,
  approximation := \fun (epsilon: R.Real)(positive: Real.Lt R.zero epsilon) => \block {
    \takefrom a: Bound[f] \by \parent.\parent.Bounded[f := f, regular := first.continuous].exists \then
    \takefrom b: Bound[g] \by \parent.\parent.Bounded[f := g, regular := second.continuous].exists \then
    \return With[firstBound := a, secondBound := b].approximation epsilon positive
  }
};
