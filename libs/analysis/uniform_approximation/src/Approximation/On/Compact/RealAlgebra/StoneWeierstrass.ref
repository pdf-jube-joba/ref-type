\definition interpolation: \forall (x, y: X) -> \exists Interpolation[Closure, f, x, y] := \block {
  \fun (x, y: X) \then
  \takefrom result: Interpolation[A, f, x, y] \by \parent.Interpolating[f := f, x := x, y := y].exists separates \then
  \return \exact(Interpolation[Closure, f, x, y] {
    value := result.value, member := original result.value result.member, atFirst := result.atFirst, atSecond := result.atSecond
  }, Interpolation[Closure, f, x, y])
};
\import \root.Approximation[].On[X := X, space := space].Compact[compact := compact, hausdorff := hausdorff].LatticeDensity[B := Closure, laws := lattice].Of[f := f, regular := regular, interpolation := interpolation] \as LatticeApproximation;
\definition result: InClosure[f] := limit f regular LatticeApproximation.approximation;
\definition approximation: Approximates A f := result.approximation;
