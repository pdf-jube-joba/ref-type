\module With(h: Function, member: \In[Function] A h, distinct: Logic.Not (h x = h y));
\definition exists: Separates A -> \exists Interpolation[A, f, x, y] := \fun (separates: Separates A) =>
  Logic.orElim[(x = y), Logic.Not (x = y), (\exists Interpolation[A, f, x, y])] (Classical.excludedMiddle (x = y))
    (\fun (equal: x = y) => \exact(Interpolation[A, f, x, y] {
      value := constant (f x), member := laws.constants (f x), atFirst := \refl(f x), atSecond := congr!{{X} {R.Real}} f _ _ equal
    }, Interpolation[A, f, x, y]))
    (\fun (distinct: Logic.Not (x = y)) => \block {
      \takefrom h: \Cast[Function] ({ h: Function \where Logic.And[\In[Function] A h, Logic.Not (h x = h y)] }) \by separates x y distinct \then
      \let properties: Logic.And[\In[Function] A h, Logic.Not (h x = h y)] := \bysub(Function, { h: Function \where Logic.And[\In[Function] A h, Logic.Not (h x = h y)] }, h) \then
      \return \exact(With[h := h, member := properties.left, distinct := properties.right].result, Interpolation[A, f, x, y])
    });
