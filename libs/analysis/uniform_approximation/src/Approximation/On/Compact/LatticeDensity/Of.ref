\structure Support[x: X, epsilon: R.Real]: \Set := {
  value: Function, member: \In[Function] B value, atCenter: value x = f x,
  lower: \forall (z: X) -> Real.Lt (R.sub (f z) (value z)) epsilon
};
\module Lower(x: X, epsilon: R.Real, positive: Real.Lt R.zero epsilon);
\module Upper(epsilon: R.Real, positive: Real.Lt R.zero epsilon);
\definition approximation: Approximates B f := \block {
  \fun (epsilon: R.Real)(positive: Real.Lt R.zero epsilon) \then
  \takefrom bound: Bound[f] \by \root.Approximation[].On[X := X, space := space].Compact[compact := compact, hausdorff := hausdorff].Bounded[f := f, regular := regular].exists \then
  \return Upper[epsilon := epsilon, positive := positive].With[bound := bound].exists
};
