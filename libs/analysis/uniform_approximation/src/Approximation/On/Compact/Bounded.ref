\definition exists: \exists Bound[f] :=
  Logic.orElim[(\exists X), Logic.Not (\exists X), (\exists Bound[f])] (Classical.excludedMiddle (\exists X))
    (\fun (inhabited: \exists X) => \block {
      \let wholeInhabited: \exists \Cast[X] Base.Whole := \block {
        \takefrom x: X \by inhabited \then
        \return \exact(\into[X](x, Base.Whole) \by { \refl(x) }, \Cast[X] Base.Whole)
      } \then
      \takefrom a: \Cast[X] ({ a: X \where Functions.Extrema[].Maximum[Base.Whole, absoluteValue f, a] })
        \by Functions.Extrema[].maximum space Base.Whole (absoluteValue f) wholeInhabited compact (Functions.Lattice[].absoluteContinuous space f regular) \then
      \let maximum: Functions.Extrema[].Maximum[Base.Whole, absoluteValue f, a] := \bysub(X, { a: X \where Functions.Extrema[].Maximum[Base.Whole, absoluteValue f, a] }, a) \then
      \return \exact(Bound[f] { size := Bounds.coefficient (f a) R.zero, positive := Bounds.coefficientPositive (f a) R.zero,
        controls := \fun (x: X) => Real.leTrans _ _ _ (maximum.upper x (\refl(x))) (Bounds.coefficientFirst (f a) R.zero)
      }, Bound[f])
    })
    (\fun (empty: Logic.Not (\exists X)) => \exact(Bound[f] { size := R.one, positive := Bounds.onePositive,
      controls := \fun (x: X) => Logic.falseElim _ (empty (\exact(x, X)))
    }, Bound[f]));
