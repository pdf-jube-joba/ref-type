\import R.Estimates[].Product[] \as Bounds;
\structure Bound[f: Function]: \Set := { size: R.Real, positive: Real.Lt R.zero size, controls: \forall (x: X) -> Real.Le (absolute (f x)) size };
\module Bounded(f: Function, regular: Continuous f);
\module LatticeDensity(B: \Pow Function, laws: LatticeLaws[B]);
\module RealAlgebra(A: \Pow Function, laws: SubalgebraLaws[A]);
