\import \parent.\parent.Polynomial[f := f, regular := laws.continuous f member] \as Evaluation;
\definition contains: \forall (p: P.Carrier) -> \In[Function] A (Evaluation.value p) :=
  P.induction (\fun (p: P.Carrier) => \In[Function] A (Evaluation.value p))
    (\fun (a: R.Real) => \idelim constant a = Evaluation.value (P.constant a) \with h: Function => \In[Function] A h \by { base: laws.constants a, equality: sym!{Function} _ _ (Evaluation.constantEquation a) })
    (\idelim f = Evaluation.value P.variable \with h: Function => \In[Function] A h \by { base: member, equality: sym!{Function} _ _ Evaluation.variableEquation })
    (\fun (p, q: P.Carrier)(first: _)(second: _) => \idelim sum (Evaluation.value p) (Evaluation.value q) = Evaluation.value (P.add p q)
      \with h: Function => \In[Function] A h \by { base: laws.addition _ _ first second, equality: sym!{Function} _ _ (Evaluation.additionEquation p q) })
    (\fun (p: P.Carrier)(previous: _) => \idelim negative (Evaluation.value p) = Evaluation.value (P.neg p)
      \with h: Function => \In[Function] A h \by { base: laws.negation _ previous, equality: sym!{Function} _ _ (Evaluation.negativeEquation p) })
    (\fun (p, q: P.Carrier)(first: _)(second: _) => \idelim product (Evaluation.value p) (Evaluation.value q) = Evaluation.value (P.mul p q)
      \with h: Function => \In[Function] A h \by { base: laws.multiplication _ _ first second, equality: sym!{Function} _ _ (Evaluation.productEquation p q) });
