\definition exists: (\forall (V: \Pow X) -> \In[\Pow X] (Finite.Insert U S) V -> Base.FamilyMember family V) -> \exists Bound[Finite.Insert U S] := \block {
  \fun (included: _) \then
  \takefrom old: Bound[S] \by previous (\fun (V: \Pow X)(member: \In[\Pow X] S V) => included V (Logic.Or[_, _]::right member)) \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where U = domain n }) \by included U (Logic.Or[_, _]::left (\refl(U))) \then
  \return \exact(Bound[Finite.Insert U S] {
    index := NatOrder.commonBound old.index n,
    bounds := \fun (V: \Pow X)(member: \In[\Pow X] (Finite.Insert U S) V)(x: X)(inside: Base.Member V x) =>
      Logic.orElim[(V = U), (\In[\Pow X] S V), Real.Lt (error (NatOrder.commonBound old.index n) x) epsilon] member
        (\fun (same: V = U) => Real.leLtTrans _ _ _ (antitone n (NatOrder.commonBound old.index n) (NatOrder.rightLeCommonBound old.index n) x)
          (\idelim V = domain n \with W: \Pow X => Base.Member W x \by {
            base: inside,
            equality: trans!{{\Pow X}} _ _ _ same (\bysub(N.Nat^, { n: N.Nat^ \where U = domain n }, n))
          }))
        (\fun (oldMember: \In[\Pow X] S V) => Real.leLtTrans _ _ _ (antitone old.index (NatOrder.commonBound old.index n) (NatOrder.leftLeCommonBound old.index n) x) (old.bounds V oldMember x inside))
  }, Bound[Finite.Insert U S])
};
