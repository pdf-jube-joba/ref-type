\import Native.Morphisms[X := X, Y := X, F := F, G := F, source := bundle, target := bundle, f := \fun (x: X) => x] \as Endomorphisms;
\import Complements.For[X := X, F := F, bundle := bundle] \as Embeddings;
\module Split(n: N.Nat^,
  include: Native.Morphisms[X := X, Y := X, F := F, G := \fun (x: X) => Native.Vector n, source := bundle, target := Native.Trivial[X := X, n := n, baseSpace := bundle.baseSpace].bundle, f := \fun (x: X) => x].Map,
  project: Native.Morphisms[X := X, Y := X, F := \fun (x: X) => Native.Vector n, G := F, source := Native.Trivial[X := X, n := n, baseSpace := bundle.baseSpace].bundle, target := bundle, f := \fun (x: X) => x].Map,
  retraction: \forall (x: X)(v: F x) -> (project.fiber x).apply ((include.fiber x).apply v) = v);
\module FromEmbedding(embedding: Embeddings.Embedding);
\structure Splitting: \Set := {
  dimension: N.Nat^,
  include: Native.Morphisms[X := X, Y := X, F := F, G := \fun (x: X) => Native.Vector dimension, source := bundle, target := Native.Trivial[X := X, n := dimension, baseSpace := bundle.baseSpace].bundle, f := \fun (x: X) => x].Map,
  project: Native.Morphisms[X := X, Y := X, F := \fun (x: X) => Native.Vector dimension, G := F, source := Native.Trivial[X := X, n := dimension, baseSpace := bundle.baseSpace].bundle, target := bundle, f := \fun (x: X) => x].Map,
  retraction: \forall (x: X)(v: F x) -> (project.fiber x).apply ((include.fiber x).apply v) = v
};
\definition splittingExists: topology.Topology[Carrier := X].IsCompact bundle.baseSpace -> topology.Topology[Carrier := X].IsT2 bundle.baseSpace -> \exists Splitting := \block {
  \fun (compact: topology.Topology[Carrier := X].IsCompact bundle.baseSpace)(hausdorff: topology.Topology[Carrier := X].IsT2 bundle.baseSpace) \then
  \takefrom embedding: Embeddings.Embedding \by Embeddings.embeddingExists compact hausdorff \then
  \return \exact(Splitting { dimension := embedding.dimension, include := embedding.map, project := FromEmbedding[embedding := embedding].project, retraction := FromEmbedding[embedding := embedding].retraction }, Splitting)
};
