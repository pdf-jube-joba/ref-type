\import R.Estimates[].Product[] \as Bounds;
\definition delta: R.Real := Bounds.radius bound.value epsilon;
\definition deltaPositive: Real.Lt R.zero delta := Bounds.radiusPositive bound.value epsilon bound.positive positive;
\definition deltaNonnegative: Real.Le R.zero delta := Order.leOfLt _ _ deltaPositive;
\module With(candidate: Candidate[delta]);
\definition exists: \exists UniformCandidate[epsilon] := \block {
  \takefrom candidate: Candidate[delta] \by chooseCandidate delta deltaPositive \then
  \return \exact(With[candidate := candidate].result, UniformCandidate[epsilon])
};
