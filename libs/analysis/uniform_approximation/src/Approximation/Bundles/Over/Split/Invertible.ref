\import matrix_invariants.Field[K := C.Complex, field := CA.field].At[n := n] \as Field;
\definition inverseMatrix: X -> M.Matrix := \fun (x: X) => Field.formula (a x);
\definition inverseRegular: MatrixFamilies.Regular bundle.baseSpace inverseMatrix := matrix_invariants.Complex[].At[n := n].Families[X := X].inverseRegular bundle.baseSpace a regular nonzero;
\definition forward: Endomorphisms.Map := \parent.MatrixMap[a := a, regular := regular].compressed;
\definition backward: Endomorphisms.Map := \parent.MatrixMap[a := inverseMatrix, regular := inverseRegular].compressed;
\definition imageIntertwines: \forall (x: X)(v: F x) -> (include.fiber x).apply ((forward.fiber x).apply v) = (M.linear (a x)).apply ((include.fiber x).apply v) := \fun (x: X)(v: F x) =>
  trans!{{Native.Vector n}} _ _ _ (commutes x ((include.fiber x).apply v))
    (congr!{{Native.Vector n} {Native.Vector n}} (M.linear (a x)).apply _ _ (congr!{{F x} {Native.Vector n}} (include.fiber x).apply _ _ (retraction x v)));
\definition projectIntertwines: \forall (x: X)(v: Native.Vector n) -> (forward.fiber x).apply ((project.fiber x).apply v) = (project.fiber x).apply ((M.linear (a x)).apply v) := \fun (x: X)(v: Native.Vector n) =>
  trans!{{F x}} _ _ _ (congr!{{Native.Vector n} {F x}} (project.fiber x).apply _ _ (sym!{{Native.Vector n}} _ _ (commutes x v))) (retraction x ((project.fiber x).apply ((M.linear (a x)).apply v)));
\module At(x: X);
\definition isomorphism: Native.Isomorphisms[X := X, F := F, G := F, source := bundle, target := bundle].Isomorphism := Native.Isomorphisms[X := X, F := F, G := F, source := bundle, target := bundle].Isomorphism {
  forward := forward, backward := backward, leftInverse := \fun (x: X) => At[x := x].left, rightInverse := \fun (x: X) => At[x := x].right
};
