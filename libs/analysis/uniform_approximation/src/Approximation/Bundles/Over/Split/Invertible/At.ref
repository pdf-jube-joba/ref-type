\definition matrix: Field.Nonsingular := \into[M.Matrix](a x, Field.Nonsingular) \by { nonzero x };
\import Hermitian.At[n := n].Square[].Inverse[A := matrix] \as Inverse;
\definition left: \forall (v: F x) -> (backward.fiber x).apply ((forward.fiber x).apply v) = v := \fun (v: F x) =>
  trans!{{F x}} _ _ _ (congr!{{Native.Vector n} {F x}} (\fun (w: Native.Vector n) => (project.fiber x).apply ((M.linear (inverseMatrix x)).apply w)) _ _ (imageIntertwines x v))
    (trans!{{F x}} _ _ _ (congr!{{Native.Vector n} {F x}} (project.fiber x).apply _ _ (Inverse.left ((include.fiber x).apply v))) (retraction x v));
\definition right: \forall (v: F x) -> (forward.fiber x).apply ((backward.fiber x).apply v) = v := \fun (v: F x) =>
  trans!{{F x}} _ _ _ (projectIntertwines x ((M.linear (inverseMatrix x)).apply ((include.fiber x).apply v)))
    (trans!{{F x}} _ _ _ (congr!{{Native.Vector n} {F x}} (project.fiber x).apply _ _ (Inverse.right ((include.fiber x).apply v))) (retraction x v));
