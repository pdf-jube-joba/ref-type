\import Hermitian.At[n := n].Families[X := X].Matrix[m := n] \as Maps;
\import Hermitian.Functions[X := X] \as Functions;
\definition linearRegular: Maps.Regular bundle.baseSpace (\fun (x: X) => M.linear (a x)) := Maps.regularOfComponents bundle.baseSpace (\fun (x: X) => M.linear (a x))
  (\fun (j, i: Fin.Fin n) => Functions.transport bundle.baseSpace (\fun (x: X) => a x i j) (\fun (x: X) => (M.linear (a x)).apply (linear_algebra.Hermitian[].Over[K := C.Complex, field := CA.field, scalar := Conjugation.scalar].Finite[n := n].basis j) i)
    (\fun (x: X) => sym!{{C.Complex}} _ _ (congr!{{Native.Vector n} {C.Complex}} (\fun (v: Native.Vector n) => v i) _ _ (M.onBasis (a x) j))) (regular i j));
\definition map: Ambient.Map := Complements.CoordinateFamily[X := X, m := n, n := n, baseSpace := bundle.baseSpace, A := \fun (x: X) => M.linear (a x), regular := linearRegular].map;
