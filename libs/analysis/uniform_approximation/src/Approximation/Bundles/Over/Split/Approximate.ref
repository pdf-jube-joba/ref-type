\definition extended: Inclusion.Map := Endomorphisms.Composition[Z := X, H := \fun (x: X) => Native.Vector n, range := Trivial.bundle, g := \fun (x: X) => x].compose h include;
\definition encoded: Ambient.Map := Retraction.Composition[Z := X, H := \fun (x: X) => Native.Vector n, range := Trivial.bundle, g := \fun (x: X) => x].compose project extended;
\definition matrix[x: X]: M.Matrix := Representation.entries (encoded.fiber x);
\import Homotopy.Projections[n := n].Operators[].FromMorphism[X := X, baseSpace := bundle.baseSpace, h := encoded] \as EncodedRegular;
\definition regular: MatrixFamilies.Regular bundle.baseSpace matrix := \fun (i, j: M.Index) => EncodedRegular.regular (linear_algebra.Hermitian[].Over[K := C.Complex, field := CA.field, scalar := Conjugation.scalar].Finite[n := n].basis j) i;
\definition onImage: \forall (x: X)(v: F x) -> (M.linear (matrix x)).apply ((include.fiber x).apply v) = (include.fiber x).apply ((h.fiber x).apply v) := \fun (x: X)(v: F x) =>
  trans!{{Native.Vector n}} _ _ _ (congr!{{Spaces.Linear[V := Native.Vector n, W := Native.Vector n, source := Native.coordinates n, target := Native.coordinates n].Map} {Native.Vector n}} (\fun (f: Spaces.Linear[V := Native.Vector n, W := Native.Vector n, source := Native.coordinates n, target := Native.coordinates n].Map) => f.apply ((include.fiber x).apply v)) _ _ (Representation.linearEntries (encoded.fiber x)))
      (congr!{{F x} {Native.Vector n}} (\fun (w: F x) => (include.fiber x).apply ((h.fiber x).apply w)) _ _ (retraction x v));
\module With(a: X -> M.Matrix, regularA: MatrixFamilies.Regular bundle.baseSpace a);
\module Density(A: \Pow (X -> C.Complex), laws: \root.Approximation[].ComplexOn[X := X, space := bundle.baseSpace].SubalgebraLaws[A], compact: topology.Topology[Carrier := X].IsCompact bundle.baseSpace, hausdorff: topology.Topology[Carrier := X].IsT2 bundle.baseSpace, separates: \root.Approximation[].ComplexOn[X := X, space := bundle.baseSpace].Separates A);
