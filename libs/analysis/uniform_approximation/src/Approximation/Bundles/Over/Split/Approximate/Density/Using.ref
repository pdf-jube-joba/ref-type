\definition regularA: MatrixFamilies.Regular bundle.baseSpace candidate.value := \fun (i, j: M.Index) => laws.continuous (\fun (x: X) => candidate.value x i j) (candidate.member i j);
\import \root.Approximation[].Bundles[].Over[X := X, F := F, bundle := bundle].Split[n := n, include := include, project := project, retraction := retraction].Approximate[h := h].With[a := candidate.value, regularA := regularA] \as Compressed;
\definition map: Endomorphisms.Map := Compressed.map;
\definition error: \forall (x: X)(v: F x)(i: M.Index) -> Real.Le
  (Abs.abs (O.sub ((include.fiber x).apply ((h.fiber x).apply v) i) ((include.fiber x).apply ((map.fiber x).apply v) i)))
  (R.mul (R.mul epsilon (R.FiniteSums[].sum n (\fun (j: M.Index) => Abs.abs ((include.fiber x).apply v j)))) (R.FiniteSums[].sum n (\fun (j: M.Index) => Abs.abs (projectionMatrix x i j)))) :=
  Compressed.error epsilon (\fun (x: X)(i, j: M.Index) => Order.leOfLt _ _ (candidate.near i j x));
