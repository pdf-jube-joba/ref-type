\import Native.Trivial[X := X, n := n, baseSpace := bundle.baseSpace] \as Trivial;
\import Native.Morphisms[X := X, Y := X, F := \fun (x: X) => Native.Vector n, G := \fun (x: X) => Native.Vector n, source := Trivial.bundle, target := Trivial.bundle, f := \fun (x: X) => x] \as Ambient;
\import Native.Morphisms[X := X, Y := X, F := F, G := \fun (x: X) => Native.Vector n, source := bundle, target := Trivial.bundle, f := \fun (x: X) => x] \as Inclusion;
\import Native.Morphisms[X := X, Y := X, F := \fun (x: X) => Native.Vector n, G := F, source := Trivial.bundle, target := bundle, f := \fun (x: X) => x] \as Retraction;
\import matrix_invariants.Ring[K := C.Complex, scalars := std.Alg[].Field[].fieldAsCommutativeRing C.Complex CA.field].At[n := n] \as M;
\import M.Representation[] \as Representation;
\import matrix_invariants.Topological[K := C.Complex, ring := topological_algebra.Complex[].Ring[].topologicalRing].At[n := n].Families[X := X] \as MatrixFamilies;
\definition projection: Ambient.Map := Retraction.Composition[Z := X, H := \fun (x: X) => Native.Vector n, range := Trivial.bundle, g := \fun (x: X) => x].compose project include;
\definition projectionMatrix[x: X]: M.Matrix := Representation.entries (projection.fiber x);
\module MatrixMap(a: X -> M.Matrix, regular: MatrixFamilies.Regular bundle.baseSpace a);
\module ProjectionBound(compact: topology.Topology[Carrier := X].IsCompact bundle.baseSpace, hausdorff: topology.Topology[Carrier := X].IsT2 bundle.baseSpace);
\module Approximate(h: Endomorphisms.Map);
\module Invertible(a: X -> M.Matrix, regular: MatrixFamilies.Regular bundle.baseSpace a,
  nonzero: \forall (x: X) -> matrix_invariants.Field[K := C.Complex, field := CA.field].At[n := n].Nonzero (a x),
  commutes: \forall (x: X)(v: Native.Vector n) -> (projection.fiber x).apply ((M.linear (a x)).apply v) = (M.linear (a x)).apply ((projection.fiber x).apply v));
