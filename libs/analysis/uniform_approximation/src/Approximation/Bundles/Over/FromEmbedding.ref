\import Embeddings.FromEmbedding[embedding := embedding].Image[] \as Image;
\definition n: N.Nat^ := embedding.dimension;
\import Complements.Projection[X := X, n := n, baseSpace := bundle.baseSpace, P := Image.projection, regular := Image.regular] \as Projected;
\import Native.Morphisms[X := X, Y := X, F := \fun (x: X) => Native.Vector n, G := Image.ImageFiber, source := Native.Trivial[X := X, n := n, baseSpace := bundle.baseSpace].bundle, target := Image.imageBundle, f := \fun (x: X) => x] \as ToImage;
\definition project: Native.Morphisms[X := X, Y := X, F := \fun (x: X) => Native.Vector n, G := F, source := Native.Trivial[X := X, n := n, baseSpace := bundle.baseSpace].bundle, target := bundle, f := \fun (x: X) => x].Map :=
  ToImage.Composition[Z := X, H := F, range := bundle, g := \fun (x: X) => x].compose Projected.projectMap Image.isomorphism.backward;
\definition retraction: \forall (x: X)(v: F x) -> (project.fiber x).apply ((embedding.map.fiber x).apply v) = v := \fun (x: X)(v: F x) =>
  trans!{{F x}} _ _ _ (congr!{{Image.ImageFiber x} {F x}} (Image.isomorphism.backward.fiber x).apply ((Projected.projectMap.fiber x).apply ((embedding.map.fiber x).apply v)) ((Image.isomorphism.forward.fiber x).apply v) (Image.Comparison[].At[x := x].fixed v)) (Image.isomorphism.leftInverse x v);
