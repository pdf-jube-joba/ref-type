\import \root.Approximation[].FiniteComplex[] \as Finite;
\import complex.Complex[] \as C;
\import C.Def[] \as O;
\import C.Prop[] \as CP;
\import C.Absolute[] \as Abs;
\import std.Data[].FinSet[] \as Fin;
\import matrix_invariants.Complex[].At[n := n] \as Top;
\import matrix_invariants.Ring[K := C.Complex, scalars := C.Algebra[].commutativeRing].At[n := n] \as M;
\import matrix_invariants.Field[K := C.Complex, field := C.Algebra[].field].At[n := n] \as Field;
\import M.Operations[] \as Operations;
\definition actionFormula: \forall (a: M.Matrix)(v: M.Vector)(i: M.Index) -> (M.linear a).apply v i = Finite.action n (a i) v := \fun (a: M.Matrix)(v: M.Vector)(i: M.Index) => Finite.enumeration n (\fun (j: M.Index) => O.mul (a i j) (v j));
\definition actionError: \forall (a, b: M.Matrix)(epsilon: R.Real) -> (\forall (i, j: M.Index) -> Real.Le (Abs.abs (O.sub (a i j) (b i j))) epsilon) ->
  \forall (v: M.Vector)(i: M.Index) -> Real.Le (Abs.abs (O.sub ((M.linear a).apply v i) ((M.linear b).apply v i))) (R.mul epsilon (R.FiniteSums[].sum n (\fun (j: M.Index) => Abs.abs (v j)))) :=
  \fun (a, b: M.Matrix)(epsilon: R.Real)(near: _)(v: M.Vector)(i: M.Index) => Real.leReplaceLeft _ _ _
    (sym!{{R.Real}} _ _ (congr!{{C.Complex} {R.Real}} Abs.abs _ _ (congr!{{C.Complex} {C.Complex} {C.Complex}} O.sub _ _ _ _ (actionFormula a v i) (actionFormula b v i)))) (Finite.uniformActionBound n (a i) (b i) v epsilon (near i));
\definition determinantError: \forall (a, b: M.Matrix) -> Real.Lt (Abs.abs (O.sub (M.determinant a) (M.determinant b))) (Abs.abs (M.determinant a)) -> Field.Nonzero b := \fun (a, b: M.Matrix)(near: _)(zero: M.determinant b = O.zero) =>
  Real.ltIrrefl (Abs.abs (M.determinant a))
    (Real.ltReplaceLeft _ _ _ (trans!{{R.Real}} _ _ _ (congr!{{C.Complex} {R.Real}} Abs.abs _ _ (congr!{{C.Complex} {C.Complex}} (O.sub (M.determinant a)) _ _ zero)) (Finite.zeroSubAbsolute (M.determinant a))) near);
\definition invertibleOfDeterminantError: \forall (a, b: M.Matrix) -> Real.Lt (Abs.abs (O.sub (M.determinant a) (M.determinant b))) (Abs.abs (M.determinant a)) -> \exists Operations.Inverse b :=
  \fun (a, b: M.Matrix)(near: _) => (Field.invertibleIff b).rtl (determinantError a b near);
\definition matrixActionError: \forall (a, b: M.Matrix)(epsilon: R.Real) -> (\forall (i, j: M.Index) -> Real.Le (Abs.abs (O.sub (a i j) (b i j))) epsilon) -> \forall (v: M.Vector)(i: M.Index) -> Real.Le (Abs.abs (O.sub ((M.linear a).apply v i) ((M.linear b).apply v i))) (R.mul epsilon (R.FiniteSums[].sum n (\fun (j: M.Index) => Abs.abs (v j)))) := actionError;
\definition compressedError: \forall (a, b, p: M.Matrix)(epsilon: R.Real) -> (\forall (i, j: M.Index) -> Real.Le (Abs.abs (O.sub (a i j) (b i j))) epsilon) ->
  \forall (v: M.Vector)(i: M.Index) -> Real.Le (Abs.abs (O.sub ((M.linear p).apply ((M.linear a).apply v) i) ((M.linear p).apply ((M.linear b).apply v) i)))
    (R.mul (R.mul epsilon (R.FiniteSums[].sum n (\fun (j: M.Index) => Abs.abs (v j)))) (R.FiniteSums[].sum n (\fun (j: M.Index) => Abs.abs (p i j)))) :=
  \fun (a, b, p: M.Matrix)(epsilon: R.Real)(near: _)(v: M.Vector)(i: M.Index) => Real.leReplaceLeft _ _ _
    (sym!{{R.Real}} _ _ (congr!{{C.Complex} {R.Real}} Abs.abs _ _ (congr!{{C.Complex} {C.Complex} {C.Complex}} O.sub _ _ _ _ (actionFormula p ((M.linear a).apply v) i) (actionFormula p ((M.linear b).apply v) i))))
    (Finite.inputErrorBound n (p i) ((M.linear a).apply v) ((M.linear b).apply v) (R.mul epsilon (R.FiniteSums[].sum n (\fun (j: M.Index) => Abs.abs (v j)))) (\fun (j: M.Index) => matrixActionError a b epsilon near v j));
\module On(X: \Set, space: topology.Topology[Carrier := X].Topology);
