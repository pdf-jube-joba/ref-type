\import sphere_maps.Circle[] \as Native;
\import Native.Coordinates[] \as Coordinates;
\import algebraic_topology.Euclidean[].Dimension[n := Nat.add (N.Nat^::succ N.Nat^::zero) (N.Nat^::succ N.Nat^::zero)].Compactness[] \as SphereCompactness;
\import topology.Topology[Carrier := Native.Carrier] \as Base;
\import topology.Compactness[A := Coordinates.Sphere, B := Native.Carrier] \as Compactness;
\definition Carrier: \Set := Native.Carrier;
\definition topology: Base.Topology := Native.topology;
\definition compact: Base.IsCompact topology := Compactness.surjectiveImage Coordinates.sphereTopology topology Coordinates.forward Coordinates.forwardContinuous
  (\fun (z: Carrier) => Logic.existsIntro[Coordinates.Sphere, { x: Coordinates.Sphere \where Coordinates.forward x = z }] (Coordinates.backward z) (Coordinates.rightInverse z)) SphereCompactness.sphere;
\import \root.Approximation[].Separation[].Pullback[A := Carrier, B := Coordinates.Sphere, source := topology, target := Coordinates.sphereTopology, f := Coordinates.backward, continuous := Coordinates.backwardContinuous] \as Separation;
\definition hausdorff: Base.IsT2 topology := \fun (x, y: Carrier)(distinct: Logic.Not (x = y)) => Separation.separate SphereCompactness.sphereHausdorff x y
  (\fun (equal: Coordinates.backward x = Coordinates.backward y) => distinct (trans!{{Carrier}} _ _ _ (sym!{{Carrier}} _ _ (Coordinates.rightInverse x))
    (trans!{{Carrier}} _ _ _ (congr!{{Coordinates.Sphere} {Carrier}} Coordinates.forward _ _ equal) (Coordinates.rightInverse y))));
\module Coefficients(X: \Set, space: topology.Topology[Carrier := X].Topology, baseCompact: topology.Topology[Carrier := X].IsCompact space, baseHausdorff: topology.Topology[Carrier := X].IsT2 space);
