\import \parent.\parent.Step[t := t, p := value n, nonnegative := nonnegative, bounded := bounded, lower := state.nonnegative, upper := state.below] \as Step;
\definition after: State[N.Nat^::succ n] := State[N.Nat^::succ n] { nonnegative := Step.valueNonnegative, below := Step.below };
\definition decreasing: Real.Le (error (N.Nat^::succ n)) (error n) := Step.errorDecreasing;
\definition contraction: Real.Le (error (N.Nat^::succ n)) (R.mul (R.sub R.one (R.mul R.half t)) (error n)) := Step.contraction;
