\import complex.Complex[] \as C;
\import C.Def[] \as D;
\import C.Prop[] \as CL;
\import \root.Phase[].Global[] \as Phase;
\import smooth_partitions.Exponential[].Global[] \as RealExp;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\use Equality.eq_reason_in;
\definition value[z: C.Complex]: C.Complex := D.scale (RealExp.value (C.re z)) (Phase.value (C.im z));
\definition imaginaryAxis[t: Real.Real]: value (C.make Real.zero t) = Phase.value t :=
  trans!{C.Complex} _ _ _ (congr!{Real.Real C.Complex} (\fun (r: Real.Real) => D.scale r (Phase.value t)) _ _ RealExp.atZero) (Phase.scaleOne (Phase.value t));
\definition atZero: value D.zero = D.one := trans!{C.Complex} _ _ _ (imaginaryAxis Real.zero) Phase.atZero;
\definition scaledProduct[a, b: Real.Real][z, w: C.Complex]: D.mul (D.scale a z) (D.scale b w) = D.scale (Real.mul a b) (D.mul z w) :=
  trans!{C.Complex} _ _ _ (CL.scaleMulLeft a z (D.scale b w))
    (trans!{C.Complex} _ _ _ (congr!{C.Complex C.Complex} (D.scale a) _ _
      (trans!{C.Complex} _ _ _ (CL.mulComm z (D.scale b w))
        (trans!{C.Complex} _ _ _ (CL.scaleMulLeft b w z) (congr!{C.Complex C.Complex} (D.scale b) _ _ (CL.mulComm w z)))))
      (CL.ext _ _ (sym!{Real.Real} _ _ (Laws.fieldMulAssoc a b (C.re (D.mul z w)))) (sym!{Real.Real} _ _ (Laws.fieldMulAssoc a b (C.im (D.mul z w))))));
\definition addition[z, w: C.Complex]: value (D.add z w) = D.mul (value z) (value w) :=
  trans!{C.Complex} _ _ _ (congr!{Real.Real C.Complex C.Complex} D.scale _ _ _ _ (RealExp.addition (C.re z) (C.re w)) (Phase.addition (C.im z) (C.im w)))
    (sym!{C.Complex} _ _ (scaledProduct (RealExp.value (C.re z)) (RealExp.value (C.re w)) (Phase.value (C.im z)) (Phase.value (C.im w))));
