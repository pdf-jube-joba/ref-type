\module Segment(a, b: Scalar);
\definition zeroInside: Inside radius Real.zero := Logic.And[_, _]::#
  (Laws.negativeNegOfPositive radius (lp_spaces.Exponential[].positive radius)) (lp_spaces.Exponential[].positive radius);
\definition law: (\forall (x: Scalar) -> Inside radius x -> Derivatives.HasDerivativeAt function x Real.zero) ->
  \forall (t: Scalar) -> Inside radius t -> function t = function Real.zero :=
  \fun (derivatives: _)(t: Scalar)(inside: _) => either!{{(Order.ltTrichotomy Real.zero t)} {function t = function Real.zero}
    {\fun (positive: _) => Segment[a := Real.zero, b := t].constant derivatives positive zeroInside inside}
    {\fun (other: Logic.Or[Real.zero = t, R.Lt t Real.zero]) => either!{other {function t = function Real.zero}
      {\fun (same: Real.zero = t) => congr!{Scalar Scalar} function _ _ (sym!{Scalar} _ _ same)}
      {\fun (negative: _) => sym!{Scalar} _ _ (Segment[a := t, b := Real.zero].constant derivatives negative inside zeroInside)}
    }}
  };
