\import smooth_partitions.Exponential[].Interval[a := Real.neg patch.radius, b := patch.radius] \as Interval;
\definition derivative: Calculus.HasDerivativeAt value t (rotate (value t)) :=
  \idelim rotate (patch.value t) = rotate (value t) \with d: C.Complex => Calculus.HasDerivativeAt value t d \by {
    base: Calculus.DerivativeLaws[value, t, rotate (patch.value t)] {
      real := Interval.localDerivative (\fun (s: Scalar) => C.re (patch.value s)) (\fun (s: Scalar) => C.re (value s)) t (C.re (rotate (patch.value t))) inside
        (\fun (s: Scalar)(member: _) => congr!{C.Complex Scalar} C.re _ _ (sym!{C.Complex} _ _ (law s patch member))) (patch.derivative t inside).real,
      imaginary := Interval.localDerivative (\fun (s: Scalar) => C.im (patch.value s)) (\fun (s: Scalar) => C.im (value s)) t (C.im (rotate (patch.value t))) inside
        (\fun (s: Scalar)(member: _) => congr!{C.Complex Scalar} C.im _ _ (sym!{C.Complex} _ _ (law s patch member))) (patch.derivative t inside).imaginary,
    },
    equality: congr!{C.Complex C.Complex} rotate _ _ (sym!{C.Complex} _ _ (law t patch inside))
  };
