\definition squared[s: Scalar]: Scalar := D.normSq (patch.value s);
\definition squaredDerivative[s: Scalar]: Inside patch.radius s -> Derivatives.HasDerivativeAt squared s Real.zero :=
  \fun (member: _) => normDerivative patch.value s (patch.derivative s member);
\definition equation: D.normSq (value t) = Real.one := eq_reason_in!{Scalar _
  "=" _ "by" { congr!{C.Complex Scalar} D.normSq _ _ (law t patch inside) }
  "=" _ "by" { \parent.\parent.Constant[radius := patch.radius, function := squared].law squaredDerivative t inside }
  "=" _ "by" { congr!{C.Complex Scalar} D.normSq _ _ patch.atZero }
  "=" _ "by" { congr!{Scalar Scalar Scalar} Real.add _ _ _ _ (Laws.fieldMulOneLeft Real.one) (Laws.fieldMulZeroLeft Real.zero) }
  "=" _ "by" { Laws.addZeroRight Real.one }
};
