\import Reals.Derivative[].Reciprocal[] \as Reciprocal;
\import R.Order[] \as Order;
\definition radius: Scalar := Distance.min left.radius right.radius;
\definition radiusPositive: R.Lt Real.zero radius := Product.minPositive left.radius right.radius
  (\bysub(Scalar, { r: Scalar \where R.Lt Real.zero r }, left.radius)) (\bysub(Scalar, { r: Scalar \where R.Lt Real.zero r }, right.radius));
\definition leftInside[t: Scalar]: Inside radius t -> Inside left.radius t :=
  \fun (inside: _) => Logic.And[_, _]::#
    (R.leLtTrans _ _ _ (Laws.negAntitone radius left.radius (Distance.minLeft left.radius right.radius)) inside.left)
    (R.ltLeTrans _ _ _ inside.right (Distance.minLeft left.radius right.radius));
\definition rightInside[t: Scalar]: Inside radius t -> Inside right.radius t :=
  \fun (inside: _) => Logic.And[_, _]::#
    (R.leLtTrans _ _ _ (Laws.negAntitone radius right.radius (Distance.minRight left.radius right.radius)) inside.left)
    (R.ltLeTrans _ _ _ inside.right (Distance.minRight left.radius right.radius));
\definition difference[t: Scalar]: C.Complex := D.sub (left.value t) (right.value t);
\definition rotateDifference[z, w: C.Complex]: D.sub (rotate z) (rotate w) = rotate (D.sub z w) :=
  CL.ext _ _ (sym!{Scalar} _ _ (Laws.negAdd (C.im z) (Real.neg (C.im w)))) (\refl(Real.sub (C.re z) (C.re w)));
\definition derivative[t: Scalar]: Inside radius t -> Calculus.HasDerivativeAt difference t (rotate (difference t)) :=
  \fun (inside: _) => \idelim D.sub (rotate (left.value t)) (rotate (right.value t)) = rotate (difference t)
    \with d: C.Complex => Calculus.HasDerivativeAt difference t d \by {
      base: Calculus.sub left.value right.value t _ _ (left.derivative t (leftInside t inside)) (right.derivative t (rightInside t inside)),
      equality: rotateDifference (left.value t) (right.value t)
    };
\definition zeroDifference: difference Real.zero = D.zero :=
  trans!{C.Complex} _ _ _ (congr!{C.Complex C.Complex C.Complex} D.sub _ _ _ _ left.atZero right.atZero) (CL.subSelf D.one);
\definition normZero: D.normSq D.zero = Real.zero := trans!{Scalar} _ _ _
  (congr!{Scalar Scalar Scalar} Real.add _ _ _ _ (Laws.fieldMulZeroLeft Real.zero) (Laws.fieldMulZeroLeft Real.zero)) (Laws.addZeroLeft Real.zero);
\definition squared[t: Scalar]: Scalar := D.normSq (difference t);
\definition squaredDerivative[t: Scalar]: Inside radius t -> Derivatives.HasDerivativeAt squared t Real.zero :=
  \fun (inside: _) => normDerivative difference t (derivative t inside);
\definition positiveRadius: Positive := \into[Scalar](radius, Positive) \by { radiusPositive };
\definition differenceVanishes[t: Scalar]: Inside radius t -> difference t = D.zero := \fun (inside: _) => CL.normSqZero (difference t)
  (trans!{Scalar} _ _ _ (\parent.Constant[radius := positiveRadius, function := squared].law squaredDerivative t inside)
    (trans!{Scalar} _ _ _ (congr!{C.Complex Scalar} D.normSq _ _ zeroDifference) normZero));
\definition agrees[t: Scalar]: Inside radius t -> left.value t = right.value t := \fun (inside: _) => CL.ext _ _
  (Distance.subZeroEq _ _ (congr!{C.Complex Scalar} C.re _ _ (differenceVanishes t inside)))
  (Distance.subZeroEq _ _ (congr!{C.Complex Scalar} C.im _ _ (differenceVanishes t inside)));
\definition commonInside[t: Scalar]: Inside left.radius t -> Inside right.radius t -> Inside radius t :=
  \fun (leftBounds: _)(rightBounds: _) => either!{{(Order.leTotal left.radius right.radius)} {Inside radius t}
    {\fun (ordered: _) => \idelim left.radius = radius \with r: Scalar => Inside r t \by {
      base: leftBounds, equality: sym!{Scalar} _ _ (Distance.minOfLe left.radius right.radius ordered)
    }}
    {\fun (ordered: _) => \idelim right.radius = radius \with r: Scalar => Inside r t \by {
      base: rightBounds, equality: sym!{Scalar} _ _ (Distance.minOfGe left.radius right.radius ordered)
    }}
  };
\definition agreement[t: Scalar]: Inside left.radius t -> Inside right.radius t -> left.value t = right.value t :=
  \fun (leftBounds: _)(rightBounds: _) => agrees t (commonInside t leftBounds rightBounds);
