\import \root.Euclidean[n := N.Nat^::zero] \as E;
\import E.Gaussian[] \as Gaussian;
\import E.Integrability[] \as Integrability;
\import E.Decay[].Term[k := N.Nat^::zero] \as Term;
\import euclidean_measure.Exhaustion[n := N.Nat^::zero] \as Exhaustion;
\import euclidean_measure.Euclidean[n := N.Nat^::zero] \as Measure;
\import functional_analysis.Measure[A := E.Point].Integral[mu := Measure.MeasureConstruction[].measure] \as I;
\import lp_spaces.On[A := E.Point, mu := Measure.MeasureConstruction[].measure].One[].Norm[] \as Equal;
\import std.Data[].FinSet[] \as Fin;
\import N.Basic[].Prop[] \as Nat;
\import std.Logic[].Proposition[] \as Logic;
\definition box[x: E.Point]: topology.Topology[Carrier := E.Point].Member (Measure.points (Exhaustion.box (N.Nat^::succ N.Nat^::zero))) x :=
  Logic.And[_, _]::# (\refl(std.Data[].Bool[].Bool^::true)) (\fun (i: Fin.Fin N.Nat^::zero) => Logic.falseElim _ (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i)));
\definition gaussian[x: E.Point]: Gaussian.function x = Real.one := eq_reason_in!{Real.Real _
  "=" _ "by" { congr!{Real.Real Real.Real} smooth_partitions.Exponential[].Global[].value _ _
    (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} Real.neg _ _ (Laws.fieldMulZeroRight Real.half)) Laws.negZero) }
  "=" _ "by" { smooth_partitions.Exponential[].Global[].atZero }
};
\definition law: gaussianMass N.Nat^::zero = Real.one := trans!{Real.Real} _ _ _
  (Equal.integralPointwise (Integrability.representative Gaussian.schwartz) Term.value
    (\fun (x: E.Point) => trans!{Real.Real} _ _ _ (gaussian x) (sym!{Real.Real} _ _ (trans!{Real.Real} _ _ _ (Term.inside x (box x)) (Numeric.one (N.Nat^::succ N.Nat^::zero))))))
  (trans!{Real.Real} _ _ _ Term.integral (Laws.fieldMulOneLeft Real.one));
