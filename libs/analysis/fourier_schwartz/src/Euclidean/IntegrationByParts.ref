\import calculus.Real[].Derivative[].Chain[] \as Chain;
\module At(f: Schwartz, i: Coordinate);
\definition integralDerivative[f: Schwartz][i: Coordinate]: I.integral (Integrability.representative (Operations.partial f i)) = Real.zero := At[f := f, i := i].zero;
