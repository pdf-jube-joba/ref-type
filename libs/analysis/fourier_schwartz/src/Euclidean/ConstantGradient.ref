\import \root.Euclidean[n := n] \as Base;
\import \root.RealBounds[] \as Bounds;
\import calculus.Real[].OneDimension[] \as One;
\import calculus.Real[].Multivariable[n := One.dimension].Open[] \as Source;
\import Source.Smooth[].Operations[] \as SourceOperations;
\import Source.Examples[] \as SourceExamples;
\import One.On[U := Source.whole] \as Lift;
\import calculus.Maps[n := One.dimension, m := n] \as Maps;
\import calculus.Real[].Derivative[].Def[] \as Derivative;
\definition Vanishes[f: Function]: \Prop := \forall (i: Coordinate)(x: Point) -> Base.value (Differential.apply i f) x = Real.zero;
\module At(f: Function, vanishes: Vanishes f, x: Point);
\definition constant[f: Function]: Vanishes f -> \forall (x: Point) -> Base.value f x = Base.value f Coordinates.origin :=
  \fun (vanishes: Vanishes f)(x: Point) => At[f := f, vanishes := vanishes, x := x].law;
