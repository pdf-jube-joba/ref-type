\definition sections[xi: Point]: Integral.Input := CI.complexScalarRepresentative (D.scale (Gaussian.Scaled[].function e xi) (fixed (Fubini.pair xi x))) (Integral.section input xi);
\definition family: Fubini.Family[joint] := Fubini.Family[joint] {
  sections := sections, outer := regulated e,
  sectionValues := \fun (xi, y: Point) => eq_reason_in!{C.Complex _
    "=" _ "by" { CL.scaleMulLeft (Gaussian.Scaled[].function e xi) (Kernel.value xi (Coordinates.negPoint x)) (D.mul (input y) (Kernel.value y xi)) }
    "=" _ "by" { congr!{C.Complex C.Complex} (D.scale (Gaussian.Scaled[].function e xi)) _ _ (CL.mulComm (Kernel.value xi (Coordinates.negPoint x)) (D.mul (input y) (Kernel.value y xi))) }
    "=" _ "by" { congr!{C.Complex C.Complex} (D.scale (Gaussian.Scaled[].function e xi)) _ _ (CL.mulAssoc (input y) (Kernel.value y xi) (Kernel.value xi (Coordinates.negPoint x))) }
    "=" _ "by" { congr!{C.Complex C.Complex} (\fun (z: C.Complex) => D.scale (Gaussian.Scaled[].function e xi) (D.mul (input y) z)) _ _
      (trans!{C.Complex} _ _ _ (CL.mulComm (Kernel.value y xi) (Kernel.value xi (Coordinates.negPoint x)))
        (congr!{C.Complex C.Complex} (D.mul (Kernel.value xi (Coordinates.negPoint x))) _ _ (Kernel.symmetric y xi))) }
    "=" _ "by" { sym!{C.Complex} _ _ (CL.scaleMulLeft (Gaussian.Scaled[].function e xi) (input y) (D.mul (Kernel.value xi (Coordinates.negPoint x)) (Kernel.value xi y))) }
  },
  outerValues := \fun (xi: Point) => sym!{C.Complex} _ _ (eq_reason_in!{C.Complex _
    "=" _ "by" { CI.integralComplexScalar (D.scale (Gaussian.Scaled[].function e xi) (Kernel.value xi (Coordinates.negPoint x))) (Integral.section input xi) }
    "=" _ "by" { CL.scaleMulLeft (Gaussian.Scaled[].function e xi) (Kernel.value xi (Coordinates.negPoint x)) (transformed xi) }
    "=" _ "by" { congr!{C.Complex C.Complex} (D.scale (Gaussian.Scaled[].function e xi)) _ _ (CL.mulComm _ _) }
    "=" _ "by" { sym!{C.Complex} _ _ (CL.scaleMulLeft (Gaussian.Scaled[].function e xi) (transformed xi) (Kernel.value xi (Coordinates.negPoint x))) }
    "=" _ "by" { congr!{C.Complex C.Complex} (\fun (z: C.Complex) => D.mul z (Kernel.value xi (Coordinates.negPoint x))) _ _ (sym!{C.Complex} _ _ (Integral.realProductValue transformed (Gaussian.Scaled[].bounded e) xi)) }
  }),
};
