\import \root.Euclidean[n := n].Inversion[].Reflection[] \as Reflection;
\import Integral.Reflected[a := Coordinates.origin, f := Integral.section (Integrability.complex f) (Coordinates.negPoint xi)] \as Change;
\definition negative[x: Point]: Coordinates.subPoint Coordinates.origin x = Coordinates.negPoint x := \axiom:funext(Coordinates.subPoint Coordinates.origin x, Coordinates.negPoint x, \fun (i: Coordinate) => Laws.addZeroLeft (Real.neg (x i)));
\definition pointwise[x: Point]: Change.value x = Integral.section (Integrability.complex (Reflection.function f)) xi x := eq_reason_in!{C.Complex _
  "=" _ "by" { Change.equation x }
  "=" _ "by" { congr!{Point C.Complex} (\fun (y: Point) => D.mul (S.value f y) (Kernel.value y (Coordinates.negPoint xi))) _ _ (negative x) }
  "=" _ "by" { congr!{C.Complex C.Complex C.Complex} D.mul _ _ _ _ (sym!{C.Complex} _ _ (Reflection.value f x)) (Kernel.bothNegative x xi) }
};
\definition law: Transform.function (Reflection.function f) xi = Transform.function f (Coordinates.negPoint xi) :=
  trans!{C.Complex} _ _ _
    (Integral.Identities[].integralPointwise (Integral.section (Integrability.complex (Reflection.function f)) xi) Change.value
      (\fun (x: Point) => sym!{C.Complex} _ _ (pointwise x))) Change.integral;
