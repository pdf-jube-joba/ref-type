\import \root.Euclidean[n := n].Inversion[] \as Inversion;
\definition function[f: S.Function]: S.Function := S.realScale (Normalization.inverse n) (Transform.Preservation[].value (Transform.Preservation[].value f));
\definition negativeTwice[x: Point]: Coordinates.negPoint (Coordinates.negPoint x) = x := \axiom:funext(Coordinates.negPoint (Coordinates.negPoint x), x, \fun (i: Coordinate) => Laws.negInvolutive (x i));
\definition value[f: S.Function][x: Point]: S.value (function f) x = S.value f (Coordinates.negPoint x) := eq_reason_in!{C.Complex _
  "=" _ "by" { congr!{Point C.Complex} (\fun (y: Point) => D.scale (Normalization.inverse n) (Transform.function (Transform.Preservation[].value f) y)) _ _ (sym!{Point} _ _ (negativeTwice x)) }
  "=" _ "by" { Inversion.theorem f (Coordinates.negPoint x) }
};
\module At(f: S.Function, xi: Point);
\definition transform[f: S.Function][xi: Point]: Transform.function (function f) xi = Transform.function f (Coordinates.negPoint xi) := At[f := f, xi := xi].law;
