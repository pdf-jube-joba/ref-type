\definition value: Bound[CoordinatesProduct.product f i] := Bound[CoordinatesProduct.product f i] {
  exponent := N.Nat^::succ bound.exponent, coefficient := bound.coefficient,
  estimate := \fun (x: Point) => R.leReplaceLeft _ _ _ (sym!{Real.Real} _ _ (Product.absProduct (x i) (Base.value f x)))
    (R.leTrans _ (Real.mul (weightBase x) (Product.abs (Base.value f x))) _
      (R.leReplace _ _ _ _ (Laws.fieldMulComm _ _) (Laws.fieldMulComm _ _)
        (Estimates.mulMonotone _ _ _ (Product.absNonnegative (Base.value f x)) (CoordinatesProduct.coordinateBound x i)))
      (R.leReplaceRight _ _ _ (Algebra.mulSwap (weightBase x) bound.coefficient (weight bound.exponent x))
        (Estimates.mulMonotone _ _ _ (weightBaseNonnegative x) (bound.estimate x)))),
};
