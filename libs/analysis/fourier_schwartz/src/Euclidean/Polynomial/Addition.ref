\definition commonLeft[x: Point]: R.Le (Product.abs (Base.value f x)) (Real.mul left.coefficient (weight (NatOps.add left.exponent right.exponent) x)) :=
  R.leTrans _ _ _ (left.estimate x) (Estimates.mulMonotone _ _ _ (Scaling.nonnegative left.coefficient) (Weights.sumLeft left.exponent right.exponent x));
\definition commonRight[x: Point]: R.Le (Product.abs (Base.value g x)) (Real.mul right.coefficient (weight (NatOps.add left.exponent right.exponent) x)) :=
  R.leTrans _ _ _ (right.estimate x) (Estimates.mulMonotone _ _ _ (Scaling.nonnegative right.coefficient) (Weights.sumRight left.exponent right.exponent x));
\definition value: Bound[Functions.plus f g] := Bound[Functions.plus f g] {
  exponent := NatOps.add left.exponent right.exponent,
  coefficient := \into[Real.Real](Real.add left.coefficient right.coefficient, Scaling.NonnegativeScalar) \by {
    Laws.addNonnegative _ _ (Scaling.nonnegative left.coefficient) (Scaling.nonnegative right.coefficient)
  },
  estimate := \fun (x: Point) => R.leTrans _ _ _ (Operations.absoluteTriangle (Base.value f x) (Base.value g x))
    (R.leReplaceRight _ _ _ (sym!{Real.Real} _ _ (Algebra.mulAddRight left.coefficient right.coefficient (weight (NatOps.add left.exponent right.exponent) x)))
      (Estimates.addLe _ _ _ _ (commonLeft x) (commonRight x))),
};
