\import \root.Euclidean[n := n] \as Base;
\import \root.NaturalPowers[] \as Numeric;
\import \parent.Polynomial[] \as Polynomial;
\import \parent.Integrability[] \as Integrability;
\import smooth_partitions.Exponential[].Global[] \as Exp;
\import lp_spaces.Exponential[] \as ExpBounds;
\import lp_spaces.Powers[] \as Natural;
\import Real.Inverse[] \as Inverse;
\definition function[x: Point]: Real.Real := Exp.value (Real.neg (Real.mul Real.half (radiusSquared x)));
\module Decay(m: N.Nat^, t: Real.Real, nonnegative: R.Le Real.zero t);
\module Quadratic;
\module Smooth;

\module Hermite;
\definition coefficient[m: N.Nat^]: Real.Real := Real.mul (Powers.power (Real.mul Numeric.two (Powers.natural (N.Nat^::succ m))) m) (Exp.value Real.half);
\definition bound[m: N.Nat^][x: Point]: R.Le (Real.mul (weight m x) (function x)) (coefficient m) := Decay[m := m, t := radiusSquared x, nonnegative := radiusNonnegative x].bound;
\definition coefficientNonnegative[m: N.Nat^]: R.Le Real.zero (coefficient m) := Laws.fieldMulNonnegative _ _
  (Numeric.nonnegative _ (Laws.fieldMulNonnegative _ _ Numeric.twoNonnegative (Natural.naturalNonnegative (N.Nat^::succ m))) m)
  (Order.leOfLt _ _ (Exp.positive Real.half));
\module Rapid;
\definition schwartz: Schwartz := \into[Function](Smooth[].function, Schwartz) \by { Rapid[].law };

\module Mass;
\module Fourier;
\module Factorization;

\definition positive[x: Point]: R.Lt Real.zero (function x) := Exp.positive _;
\definition atMostOne[x: Point]: R.Le (function x) Real.one := R.leReplaceRight _ _ _ Exp.atZero
  (ExpBounds.monotone _ _ (Product.negNonnegative _ (Laws.fieldMulNonnegative _ _ (Order.leOfLt _ _ Numeric.halfPositive) (radiusNonnegative x))));
\definition absolute[x: Point]: Product.abs (function x) = function x := Product.absOfNonnegative _ (Order.leOfLt _ _ (positive x));
\definition even[x: Point]: function (Coordinates.negPoint x) = function x :=
  congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Exp.value (Real.neg (Real.mul Real.half r))) _ _
    (Sum.congruent n _ _ (\fun (i: Coordinate) => Laws.fieldMulNegBoth (x i) (x i)));
\module Approximation(f: Schwartz, x: Point);

\definition originValue: function Coordinates.origin = Real.one := trans!{Real.Real} _ _ _
  (congr!{Real.Real Real.Real} Exp.value _ _ (trans!{Real.Real} _ _ _ (sym!{Real.Real} _ _ (Quadratic[].argumentValue Coordinates.origin)) Fourier[].originArgument)) Exp.atZero;
\module Scaled;
\module Density(e: Real.Real, positive: R.Lt Real.zero e);
