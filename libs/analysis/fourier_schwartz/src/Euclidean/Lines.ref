\import Open.Analysis[] \as Analysis;
\import calculus.Real[].Derivative[].Def[] \as Derivative;
\import Analysis.Section[U := Open.whole, f := f, a := Whole.point a, i := i] \as Section;
\definition point[t: Real.Real]: Open.Carrier Open.whole := Whole.point (Coordinates.replace a i t);
\definition function[t: Real.Real]: Real.Real := f (point t);
\definition agreement[t: Real.Real]: Section.value t = function t := Section.agreement t (point t) (\refl(Coordinates.replace a i t));
\definition derivative[t: Real.Real]: Derivative.HasDerivativeAt function t (Differential.apply i f (point t)) :=
  \idelim Section.value = function \with h: (Real.Real -> Real.Real) => Derivative.HasDerivativeAt h t (Differential.apply i f (point t)) \by {
    base: Section.derivativeAt t (point t) _ (\refl(Coordinates.replace a i t)) (Partial.partialLaw Open.whole f i (point t)),
    equality: \axiom:funext(Section.value, function, agreement)
  };
