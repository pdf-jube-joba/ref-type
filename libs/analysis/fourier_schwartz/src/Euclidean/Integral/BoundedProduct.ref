\definition function[x: Point]: Real.Real := Real.mul (f x) (g.function x);
\definition dominated[x: Point]: R.Le (Product.abs (function x)) (Product.abs (f x)) :=
  R.leReplace _ _ _ _ (sym!{Real.Real} _ _ (Product.absProduct (f x) (g.function x))) (Algebra.mulOneRight (Product.abs (f x)))
    (Estimates.mulMonotone (Product.abs (f x)) _ _ (Product.absNonnegative (f x)) (g.bound x));
\definition integrable: I.Integrable function := Logic.And[_, _]::#
  (L.Products[].measurable f g.function (I.integralLaw f).integrable.left g.measurable)
  (I.finiteMono (\fun (x: Point) => Product.abs (function x)) (\fun (x: Point) => Product.abs (f x))
    (\fun (x: Point) => Product.absNonnegative (function x)) dominated (I.integralLaw f).integrable.right);
\definition value: I.Representatives := \into[Point -> Real.Real](function, I.Representatives) \by { integrable };
