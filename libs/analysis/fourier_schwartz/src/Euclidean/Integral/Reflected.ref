\import lp_spaces.Euclidean[n := n].ReflectedTranslation[a := a] \as Reflection;
\import product_integration.MeasureMap[A := Point, B := Point, source := Lebesgue.measure, target := Lebesgue.measure].On[map := Reflection.map] \as Map;
\import Map.RealFunction[f := Complex.realPart f] \as Re;
\import Map.RealFunction[f := Complex.imaginaryPart f] \as Im;
\definition value: Input := \into[Complex.Function]((\fun (x: Point) => f (Reflection.function x)), Input) \by {
  Logic.And[_, _]::# (I.integralLaw Re.representative).integrable (I.integralLaw Im.representative).integrable
};
\definition equation[x: Point]: value x = f (Coordinates.subPoint a x) := congr!{Point C.Complex} f _ _ (Reflection.pointwise x);
\definition integral: Complex.integral value = Complex.integral f := C.Prop[].ext _ _ Re.integral Im.integral;
