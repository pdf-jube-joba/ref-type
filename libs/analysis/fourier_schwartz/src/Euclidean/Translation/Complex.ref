\import \root.Euclidean[n := n].Translation[] \as Shift;
\import \parent.\parent.Complex[] \as S;
\definition translate[a: Point][f: S.Function]: S.Function := S.Function { real := Shift.translate a f.real, imaginary := Shift.translate a f.imaginary };
\definition value[a: Point][f: S.Function][x: Point]: S.value (translate a f) x = S.value f (Shift.point a x) := \refl(S.value (translate a f) x);
