\import \root.Euclidean[n := n].Lines[f := Shift.function (Coordinates.negPoint y) g, a := a, i := i] \as Line;
\import calculus.Real[].Derivative[].Operations[] \as Derivatives;
\definition coefficient[t: Real.Real]: Real.mul (Base.value f y) (Differential.apply i (Shift.function (Coordinates.negPoint y) g) (Whole.point (point t))) = derivativeFamily t y :=
  congr!{Function Real.Real} (\fun (h: Function) => Real.mul (Base.value f y) (Base.value h (point t))) _ _ (Shift.partial (Coordinates.negPoint y) g i);
\definition derivative[t: Real.Real]: Derivative.HasDerivativeAt (\fun (s: Real.Real) => family s y) t (derivativeFamily t y) :=
  \idelim _ = _ \with d: Real.Real => Derivative.HasDerivativeAt (\fun (s: Real.Real) => family s y) t d \by {
    base: Derivatives.scaleDerivative (Base.value f y) Line.function t _ (Line.derivative t),
    equality: coefficient t
  };
