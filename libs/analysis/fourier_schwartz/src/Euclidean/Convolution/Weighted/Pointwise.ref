\definition A: Real.Real := Product.abs (Base.value f y);
\definition B: Real.Real := Product.abs (Base.value g (difference x y));
\definition W: Real.Real := weight m y;
\definition Z: Real.Real := weight m (difference x y);
\definition T: Real.Real := Powers.power Numeric.two m;
\definition first: R.Le (Real.mul (weight m x) (Real.mul A B)) (Real.mul T (Real.mul (Real.mul W A) (Real.mul Z B))) :=
  R.leReplaceRight _ _ _ (trans!{Real.Real} _ _ _ (Laws.fieldMulAssoc T (Real.mul W Z) (Real.mul A B))
    (congr!{Real.Real Real.Real} (Real.mul T) _ _ (Algebra.mulFour W Z A B)))
    (R.leReplace _ _ _ _ (Laws.fieldMulComm _ _) (Laws.fieldMulComm _ _)
      (Estimates.mulMonotone _ _ _ (Laws.fieldMulNonnegative _ _ (Product.absNonnegative _) (Product.absNonnegative _)) (weightBound x y)));
\definition second: R.Le (Real.mul T (Real.mul (Real.mul W A) (Real.mul Z B))) (Real.mul coefficient (Real.mul W A)) :=
  R.leReplaceRight _ _ _ (trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real} (Real.mul T) _ _ (Laws.fieldMulComm (Real.mul W A) (seminorm g m Directions::nil)))
    (sym!{Real.Real} _ _ (Laws.fieldMulAssoc T (seminorm g m Directions::nil) (Real.mul W A))))
    (Estimates.mulMonotone _ _ _ (Numeric.nonnegative Numeric.two Numeric.twoNonnegative m)
      (Estimates.mulMonotone _ _ _ (Laws.fieldMulNonnegative _ _ (weightNonnegative m y) (Product.absNonnegative _)) (pointBound g m Directions::nil (difference x y))));
\definition bound: R.Le (Real.mul (weight m x) (Product.abs (section f g x y))) (dominator y) :=
  R.leReplace _ _ _ _ (sym!{Real.Real} _ _ (congr!{Real.Real Real.Real} (Real.mul (weight m x)) _ _ (Product.absProduct (Base.value f y) (Base.value g (difference x y)))))
    (sym!{Real.Real} _ _ (congr!{Real.Real Real.Real} (Real.mul coefficient) _ _ (Integrability.weightedAbsolute m y (Base.value f y))))
    (R.leTrans _ _ _ first second);
