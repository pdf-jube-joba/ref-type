\import lp_spaces.Euclidean[n := n].ReflectedTranslation[a := x] \as Reflection;
\definition kernel: Fourier.BoundedBy := Fourier.BoundedBy {
  function := \fun (y: Point) => Base.value g (difference x y),
  measurable := \idelim (\fun (y: Point) => Base.value g (Coordinates.subPoint x y)) = (\fun (y: Point) => Base.value g (difference x y))
    \with h: (Point -> Real.Real) => M.IsMeasurable Lebesgue.measure h \by {
      base: Reflection.measurable (Base.value g) (Integrability.integrable g).left,
      equality: \axiom:funext((\fun (y: Point) => Base.value g (Coordinates.subPoint x y)), (\fun (y: Point) => Base.value g (difference x y)),
        \fun (y: Point) => congr!{Point Real.Real} (Base.value g) _ _ (sym!{Point} _ _ (subtract x y)))
    },
  coefficient := \into[Real.Real](seminorm g N.Nat^::zero Directions::nil, Scaling.NonnegativeScalar) \by { seminormNonnegative g N.Nat^::zero Directions::nil },
  bound := \fun (y: Point) => bound g (difference x y),
};
\definition value: I.Representatives := Fourier.BoundedMultiply[f := Integrability.representative f, g := kernel].value;
\definition dominated[y: Point]: R.Le (Product.abs (value y)) (Real.mul (seminorm g N.Nat^::zero Directions::nil) (Product.abs (Base.value f y))) :=
  Fourier.BoundedMultiply[f := Integrability.representative f, g := kernel].dominated y;
