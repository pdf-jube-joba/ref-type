\definition point[t: Real.Real]: Point := Coordinates.replace a i t;
\definition family[t: Real.Real]: I.Representatives := section f g (point t);
\definition derivativeFamily[t: Real.Real]: I.Representatives := section f (Operations.partial g i) (point t);
\definition dominator: I.Representatives := Scaling.scalarRepresentative (seminorm (Operations.partial g i) N.Nat^::zero Directions::nil) (Abs.representative (Integrability.representative f));
\module Pointwise(y: Point);
\definition data: L.Differentiation[].Data := L.Differentiation[].Data {
  function := family, derivative := section f (Operations.partial g i) a, at := a i, radius := lp_spaces.Exponential[].one, bound := dominator,
  dominated := \fun (t: Real.Real)(different: _)(near: _)(y: Point) => RealBounds.slope (\fun (s: Real.Real) => family s y) (\fun (s: Real.Real) => derivativeFamily s y)
    (a i) t (dominator y) (\fun (s: Real.Real) => Pointwise[y := y].derivative s)
    (\fun (s: Real.Real) => \parent.Section[f := f, g := Operations.partial g i, x := point s].dominated y) different,
  pointwise := \fun (y: Point) => \idelim derivativeFamily (a i) y = section f (Operations.partial g i) a y
    \with d: Real.Real => Derivative.HasDerivativeAt (\fun (t: Real.Real) => family t y) (a i) d \by {
      base: Pointwise[y := y].derivative (a i),
      equality: congr!{Point Real.Real} (\fun (x: Point) => section f (Operations.partial g i) x y) _ _ (Space.replaceOriginal a i)
    },
};
\definition law: Derivative.HasDerivativeAt (\fun (t: Real.Real) => value f g (point t)) (a i) (value f (Operations.partial g i) a) := L.Differentiation[].derivative data;
