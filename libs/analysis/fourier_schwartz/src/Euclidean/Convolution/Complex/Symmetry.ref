\import \root.Euclidean[n := n].Integral[] \as Integral;
\import Integral.Reflected[a := x, f := section f g x] \as Change;
\definition recovery[y: Point]: difference x (Coordinates.subPoint x y) = y := trans!{Point} _ _ _ (subtract x (Coordinates.subPoint x y))
  (\axiom:funext(Coordinates.subPoint x (Coordinates.subPoint x y), y, \fun (i: Coordinate) => Algebra.subSub (x i) (y i)));
\definition values[y: Point]: Change.value y = section g f x y := eq_reason_in!{C.Complex _
  "=" _ "by" { Change.equation y }
  "=" _ "by" { congr!{C.Complex C.Complex C.Complex} D.mul _ _ _ _
    (congr!{Point C.Complex} (S.value f) _ _ (sym!{Point} _ _ (subtract x y)))
    (congr!{Point C.Complex} (S.value g) _ _ (recovery y)) }
  "=" _ "by" { CL.mulComm _ _ }
};
\definition law: S.value (function f g) x = S.value (function g f) x := eq_reason_in!{C.Complex _
  "=" _ "by" { sym!{C.Complex} _ _ (integral f g x) }
  "=" _ "by" { sym!{C.Complex} _ _ Change.integral }
  "=" _ "by" { Integral.Identities[].integralPointwise Change.value (section g f x) values }
  "=" _ "by" { integral g f x }
};
