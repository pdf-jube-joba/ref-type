\definition sections[y: Point]: CI.Representatives := CI.complexScalarRepresentative (S.value f y) (Integral.section (Integrability.complex (Translation.translate (Coordinates.negPoint y) g)) xi);
\definition outer: CI.Representatives := CI.complexScalarRepresentative (Transform.function g xi) (Integral.section (Integrability.complex f) xi);
\definition doubleNegative[y: Point]: Coordinates.negPoint (Coordinates.negPoint y) = y := \axiom:funext(Coordinates.negPoint (Coordinates.negPoint y), y, \fun (i: Coordinate) => Laws.negInvolutive (y i));
\definition inner[y: Point]: CI.integral (sections y) = D.mul (S.value f y) (D.mul (Kernel.value y xi) (Transform.function g xi)) := eq_reason_in!{C.Complex _
  "=" _ "by" { CI.integralComplexScalar (S.value f y) (Integral.section (Integrability.complex (Translation.translate (Coordinates.negPoint y) g)) xi) }
  "=" _ "by" { congr!{C.Complex C.Complex} (D.mul (S.value f y)) _ _ (Transform.Identities[].translation g (Coordinates.negPoint y) xi) }
  "=" _ "by" { congr!{Point C.Complex} (\fun (p: Point) => D.mul (S.value f y) (D.mul (Kernel.value p xi) (Transform.function g xi))) _ _ (doubleNegative y) }
};
\definition family: Fubini.Family[Fubini.Transpose[f := joint].value] := Fubini.Family[Fubini.Transpose[f := joint].value] {
  sections := sections, outer := outer,
  sectionValues := \fun (y, x: Point) => trans!{C.Complex} _ _ _ (sym!{C.Complex} _ _ (CL.mulAssoc _ _ _))
    (congr!{C.Complex C.Complex} (\fun (z: C.Complex) => D.mul z (Kernel.value x xi)) _ _
      (trans!{C.Complex} _ _ _ (CL.mulComm (S.value f y) (S.value g (difference x y)))
        (congr!{Point C.Complex} (\fun (p: Point) => D.mul (S.value g p) (S.value f y)) _ _ (subtract x y)))),
  outerValues := \fun (y: Point) => sym!{C.Complex} _ _ (trans!{C.Complex} _ _ _ (inner y)
    (trans!{C.Complex} _ _ _ (sym!{C.Complex} _ _ (CL.mulAssoc _ _ _)) (CL.mulComm _ _))),
};
