\definition sections[x: Point]: CI.Representatives := CI.complexScalarRepresentative (Kernel.value x xi) (Convolution.section f g x);
\definition outer: CI.Representatives := Integral.section (Integrability.complex (Convolution.function f g)) xi;
\definition family: Fubini.Family[joint] := Fubini.Family[joint] {
  sections := sections, outer := outer,
  sectionValues := \fun (x, y: Point) => eq_reason_in!{C.Complex _
    "=" _ "by" { CL.mulComm (Kernel.value x xi) (D.mul (S.value f y) (S.value g (difference x y))) }
    "=" _ "by" { congr!{C.Complex C.Complex} (\fun (z: C.Complex) => D.mul z (Kernel.value x xi)) _ _
      (trans!{C.Complex} _ _ _ (CL.mulComm (S.value f y) (S.value g (difference x y)))
        (congr!{Point C.Complex} (\fun (p: Point) => D.mul (S.value g p) (S.value f y)) _ _ (subtract x y))) }
  },
  outerValues := \fun (x: Point) => sym!{C.Complex} _ _ (eq_reason_in!{C.Complex _
    "=" _ "by" { CI.integralComplexScalar (Kernel.value x xi) (Convolution.section f g x) }
    "=" _ "by" { congr!{C.Complex C.Complex} (D.mul (Kernel.value x xi)) _ _ (Convolution.integral f g x) }
    "=" _ "by" { CL.mulComm _ _ }
  }),
};
