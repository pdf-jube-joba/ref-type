\definition real: Differential.apply i (function f g).real = (function f (S.partial g i)).real :=
  trans!{Base.Function} _ _ _ (Differential.addition i (Convolution.function f.real g.real) (Functions.scale (Real.neg Real.one) (Convolution.function f.imaginary g.imaginary)))
    (congr!{Base.Function Base.Function Base.Function} Functions.plus _ _ _ _
      (Convolution.partialFunction f.real g.real i)
      (trans!{Base.Function} _ _ _ (Differential.scalar i (Real.neg Real.one) (Convolution.function f.imaginary g.imaginary))
        (congr!{Base.Function Base.Function} (Functions.scale (Real.neg Real.one)) _ _ (Convolution.partialFunction f.imaginary g.imaginary i))));
\definition imaginary: Differential.apply i (function f g).imaginary = (function f (S.partial g i)).imaginary :=
  trans!{Base.Function} _ _ _ (Differential.addition i (Convolution.function f.real g.imaginary) (Convolution.function f.imaginary g.real))
    (congr!{Base.Function Base.Function Base.Function} Functions.plus _ _ _ _ (Convolution.partialFunction f.real g.imaginary i) (Convolution.partialFunction f.imaginary g.real i));
