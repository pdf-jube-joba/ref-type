\module With(certificate: Integrate.Complex[].Certificate[f]) {
  \definition outside[x: Point]: Logic.Not (topology.Topology[Carrier := Point].Member certificate.exception x) -> certificate.outer x = data.outer x :=
    \fun (outside: _) => trans!{C.Complex} _ _ _ (certificate.outerValues x)
      (trans!{C.Complex} _ _ _
        (Fourier.Identities[].integralPointwise (certificate.sections x) (data.sections x)
          (\fun (y: Point) => trans!{C.Complex} _ _ _ (certificate.sectionValues x outside y) (sym!{C.Complex} _ _ (data.sectionValues x y))))
        (sym!{C.Complex} _ _ (data.outerValues x)));
  \import product_integration.IntegralTools[A := Point, mu := Lebesgue.measure] \as Tools;
  \definition law: JC.integral f = CI.integral data.outer := trans!{C.Complex} _ _ _ certificate.exchange
    (CL.ext _ _
      (Tools.Outside[exception := certificate.exception, f := CI.realPart certificate.outer, g := CI.realPart data.outer].equality
        (\fun (x: Point)(absent: _) => congr!{C.Complex Real.Real} C.re _ _ (outside x absent)))
      (Tools.Outside[exception := certificate.exception, f := CI.imaginaryPart certificate.outer, g := CI.imaginaryPart data.outer].equality
        (\fun (x: Point)(absent: _) => congr!{C.Complex Real.Real} C.im _ _ (outside x absent))));
}
\definition law: JC.integral f = CI.integral data.outer := \block {
  \takefrom certificate: Integrate.Complex[].Certificate[f] \by Integrate.Complex[].fubini f \then
  \return With[certificate := certificate].law
};
