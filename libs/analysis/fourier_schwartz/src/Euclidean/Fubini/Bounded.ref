\definition real: J.Integrable (\fun (p: PairPoint) => C.re (data.function p)) := Logic.And[_, _]::# data.realMeasurable
  (J.finiteMono (\fun (p: PairPoint) => Product.abs (C.re (data.function p))) (\fun (p: PairPoint) => Product.abs (data.bound p))
    (\fun (p: PairPoint) => Product.absNonnegative (C.re (data.function p)))
    (\fun (p: PairPoint) => R.leTrans _ _ _ (data.realBound p) (R.leReplaceRight _ _ _ (sym!{Real.Real} _ _ (Product.absExpression (data.bound p))) (Distance.maxRight (Real.neg (data.bound p)) (data.bound p)))) (J.integralLaw data.bound).integrable.right);
\definition imaginary: J.Integrable (\fun (p: PairPoint) => C.im (data.function p)) := Logic.And[_, _]::# data.imaginaryMeasurable
  (J.finiteMono (\fun (p: PairPoint) => Product.abs (C.im (data.function p))) (\fun (p: PairPoint) => Product.abs (data.bound p))
    (\fun (p: PairPoint) => Product.absNonnegative (C.im (data.function p)))
    (\fun (p: PairPoint) => R.leTrans _ _ _ (data.imaginaryBound p) (R.leReplaceRight _ _ _ (sym!{Real.Real} _ _ (Product.absExpression (data.bound p))) (Distance.maxRight (Real.neg (data.bound p)) (data.bound p)))) (J.integralLaw data.bound).integrable.right);
\definition value: complexJoint := \into[JC.Function](data.function, complexJoint) \by { Logic.And[_, _]::# real imaginary };
