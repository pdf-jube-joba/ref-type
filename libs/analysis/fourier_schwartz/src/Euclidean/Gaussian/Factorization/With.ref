\definition sectionIntegral[x: Left.Point]: Logic.Not (Sets.Member certificate.exception x) -> RI.integral (certificate.sections x) = Real.mul (LG.function x) Gaussian.Mass[].value :=
  \fun (outside: _) => trans!{Real.Real} _ _ _
    (REqual.integralPointwise (certificate.sections x) (section x) (\fun (y: Point) => trans!{Real.Real} _ _ _ (certificate.sectionValues x outside y) (gaussian (Pair.pair Left.Point Point x y))))
    (RI.Scaling[].integralScalar (LG.function x) (Integrability.representative Gaussian.schwartz));
\import product_integration.IntegralTools[A := Left.Point, mu := LM.measure].Outside[exception := certificate.exception, f := certificate.outer, g := outer] \as Outside;
\definition outerIntegral: LI.integral certificate.outer = LI.integral outer := Outside.equality
  (\fun (x: Left.Point)(outside: _) => trans!{Real.Real} _ _ _ (certificate.outerValues x)
    (trans!{Real.Real} _ _ _ (sectionIntegral x outside) (Laws.fieldMulComm _ _)));
\definition law: HG.Mass[].value = Real.mul LG.Mass[].value Gaussian.Mass[].value := eq_reason_in!{Real.Real _
  "=" _ "by" { sym!{Real.Real} _ _ jointIntegral }
  "=" _ "by" { certificate.exchange }
  "=" _ "by" outerIntegral
  "=" _ "by" { LI.Scaling[].integralScalar Gaussian.Mass[].value (Left.Integrability[].representative LG.schwartz) }
  "=" _ "by" { Laws.fieldMulComm _ _ }
};
