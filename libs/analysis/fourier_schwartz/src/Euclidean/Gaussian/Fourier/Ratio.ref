\import \root.Euclidean[n := n].Gaussian[].Fourier[] \as Fourier;
\definition function: Function := Functions.product f InverseGaussian.function;
\definition vanishes: Gradient.Vanishes function := \fun (i: Coordinate)(x: Point) => eq_reason_in!{Real.Real _
  "=" _ "by" { congr!{Function Real.Real} (\fun (h: Function) => Base.value h x) _ _ (Differential.product i f InverseGaussian.function) }
  "=" _ "by" { congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _
    (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r (Base.value InverseGaussian.function x)) _ _ (derivative i x))
    (congr!{Real.Real Real.Real} (Real.mul (Base.value f x)) _ _ (inverseDerivative i x)) }
  "=" _ "by" { congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _
    (trans!{Real.Real} _ _ _ (Laws.fieldMulAssoc (Real.neg (x i)) (Base.value f x) (Base.value InverseGaussian.function x))
      (Laws.fieldMulNegLeft (x i) (Real.mul (Base.value f x) (Base.value InverseGaussian.function x))))
    (Algebra.mulSwap (Base.value f x) (x i) (Base.value InverseGaussian.function x)) }
  "=" _ "by" { Laws.addNegLeft _ }
};
\definition equality[x: Point]: Real.mul (Base.value f x) (Base.value InverseGaussian.function x) = Base.value f Coordinates.origin :=
  trans!{Real.Real} _ _ _ (Gradient.constant function vanishes x)
    (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (Real.mul (Base.value f Coordinates.origin)) _ _ Fourier.inverseOrigin) (Algebra.mulOneRight _));
\definition law[x: Point]: Base.value f x = Real.mul (Gaussian.function x) (Base.value f Coordinates.origin) := eq_reason_in!{Real.Real _
  "=" _ "by" { sym!{Real.Real} _ _ (Algebra.mulOneRight (Base.value f x)) }
  "=" _ "by" { congr!{Real.Real Real.Real} (Real.mul (Base.value f x)) _ _ (sym!{Real.Real} _ _ (Fourier.cancellation x)) }
  "=" _ "by" { sym!{Real.Real} _ _ (Laws.fieldMulAssoc _ _ _) }
  "=" _ "by" { congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r (Gaussian.function x)) _ _ (equality x) }
  "=" _ "by" { Laws.fieldMulComm _ _ }
};
