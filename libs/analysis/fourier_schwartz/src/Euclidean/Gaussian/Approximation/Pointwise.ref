\import \root.Euclidean[n := n].Gaussian[].Approximation[f := f, x := x] \as Approximation;
\import \root.Euclidean[n := n].AffineLine[f := f, b := x, v := Coordinates.negPoint y] \as Line;
\definition point[t: Real.Real]: Line.point t = Approximation.point t y := \axiom:funext(Line.point t, Approximation.point t y,
  \fun (i: Coordinate) => congr!{Real.Real Real.Real} (Real.add (x i)) _ _
    (trans!{Real.Real} _ _ _ (Laws.fieldMulNegRight t (y i)) (sym!{Real.Real} _ _ (Laws.fieldMulNegLeft t (y i)))));
\definition continuous: Limit.ContinuousAt (\fun (t: Real.Real) => family t y) Real.zero :=
  \idelim (\fun (t: Real.Real) => Real.mul (Gaussian.function y) (Line.function t)) = (\fun (t: Real.Real) => family t y)
    \with h: (Real.Real -> Real.Real) => Limit.ContinuousAt h Real.zero \by {
      base: Derivatives.continuousOfDerivative _ Real.zero (Real.mul (Gaussian.function y) (Line.differential Real.zero))
        (Derivatives.scaleDerivative (Gaussian.function y) Line.function Real.zero _ (Line.derivative Real.zero)),
      equality: \axiom:funext((\fun (t: Real.Real) => Real.mul (Gaussian.function y) (Line.function t)), (\fun (t: Real.Real) => family t y),
        \fun (t: Real.Real) => congr!{Point Real.Real} (\fun (p: Point) => Real.mul (Gaussian.function y) (Base.value f p)) _ _ (point t))
    };
