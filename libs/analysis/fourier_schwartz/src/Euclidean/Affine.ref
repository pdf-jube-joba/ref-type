\import \root.Euclidean[n := n] \as Base;
\import \parent.Integrability[] \as Integrability;
\import calculus.Maps[n := n, m := n] \as Maps;
\import Open.Smooth[].Operations[] \as Operations;
\import Open.Examples[] \as Examples;
\definition point[x: Point]: Point := Coordinates.addPoint b (Coordinates.scale a x);
\definition map: Maps.Map Open.whole Open.whole := \into[Maps.Data[Open.whole, Open.whole]](Maps.Data[Open.whole, Open.whole] { apply := \fun (x: Open.Carrier Open.whole) => Whole.point (point x) }, Maps.Map Open.whole Open.whole) \by {
  Maps.Laws[Open.whole, Open.whole, Maps.Data[Open.whole, Open.whole]::# (\fun (x: Open.Carrier Open.whole) => Whole.point (point x))] {
    smooth := \fun (i: Coordinate) => Operations.addSmooth Open.whole _ _ (Operations.constantSmooth Open.whole (b i))
      (Operations.scaleSmooth Open.whole a (\fun (x: Open.Carrier Open.whole) => x i) (Examples.projectionSmooth Open.whole i)),
  }
};
\import Maps.Composition[U := Open.whole, V := Open.whole, f := map] \as Composition;
\definition function[f: Function]: Function := Composition.function f;
\definition value[f: Function][x: Point]: Base.value (function f) x = Base.value f (point x) := \refl(Base.value (function f) x);
