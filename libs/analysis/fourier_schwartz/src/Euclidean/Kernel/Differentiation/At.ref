\import Analysis.Section[U := Open.whole, f := argument, a := a, i := i] \as Section;
\definition curve[t: Real.Real]: C.Complex := Phase.value (Section.value t);
\definition center: curve (a i) = Kernel.value a xi := congr!{Real.Real C.Complex} Phase.value _ _ Section.center;
\definition agreement[t: Real.Real][x: Open.Carrier Open.whole]: x = Coordinates.replace a i t -> curve t = Kernel.value x xi :=
  \fun (same: _) => congr!{Real.Real C.Complex} Phase.value _ _ (Section.agreement t x same);
\definition derivative: Calculus.HasDerivativeAt curve (a i) (coefficient a i) :=
  \idelim D.scale (Real.neg (xi i)) (Rotation.rotate (Phase.value (Section.value (a i)))) = coefficient a i
    \with d: C.Complex => Calculus.HasDerivativeAt curve (a i) d \by {
      base: Calculus.compose Phase.value Section.value (a i) (Real.neg (xi i)) (Rotation.rotate (Phase.value (Section.value (a i))))
        (Section.derivative (Real.neg (xi i)) (argumentPartial i a)) (Phase.derivative (Section.value (a i))),
      equality: congr!{C.Complex C.Complex} (\fun (z: C.Complex) => D.scale (Real.neg (xi i)) (Rotation.rotate z)) _ _ center
    };
\definition real: Analysis.HasPartialDerivativeAt Open.whole (\fun (x: Open.Carrier Open.whole) => C.re (Kernel.value x xi)) i a (C.re (coefficient a i)) :=
  Operations.sectionPartial Open.whole _ a i (\fun (t: Real.Real) => C.re (curve t)) (C.re (coefficient a i))
    (congr!{C.Complex Real.Real} C.re _ _ center)
    (\fun (t: Real.Real)(x: Open.Carrier Open.whole)(same: _) => congr!{C.Complex Real.Real} C.re _ _ (agreement t x same)) derivative.real;
\definition imaginary: Analysis.HasPartialDerivativeAt Open.whole (\fun (x: Open.Carrier Open.whole) => C.im (Kernel.value x xi)) i a (C.im (coefficient a i)) :=
  Operations.sectionPartial Open.whole _ a i (\fun (t: Real.Real) => C.im (curve t)) (C.im (coefficient a i))
    (congr!{C.Complex Real.Real} C.im _ _ center)
    (\fun (t: Real.Real)(x: Open.Carrier Open.whole)(same: _) => congr!{C.Complex Real.Real} C.im _ _ (agreement t x same)) derivative.imaginary;
