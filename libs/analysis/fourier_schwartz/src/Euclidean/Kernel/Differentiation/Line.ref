\import calculus.Real[].Derivative[].Def[] \as Derivative;
\import Analysis.Section[U := Open.whole, f := (\fun (x: Open.Carrier Open.whole) => C.re (Kernel.value x xi)), a := Whole.point a, i := i] \as RealSection;
\import Analysis.Section[U := Open.whole, f := (\fun (x: Open.Carrier Open.whole) => C.im (Kernel.value x xi)), a := Whole.point a, i := i] \as ImaginarySection;
\definition point[t: Real.Real]: Open.Carrier Open.whole := Whole.point (Coordinates.replace a i t);
\definition function[t: Real.Real]: C.Complex := Kernel.value (point t) xi;
\definition realAgreement[t: Real.Real]: RealSection.value t = C.re (function t) := RealSection.agreement t (point t) (\refl(Coordinates.replace a i t));
\definition imaginaryAgreement[t: Real.Real]: ImaginarySection.value t = C.im (function t) := ImaginarySection.agreement t (point t) (\refl(Coordinates.replace a i t));
\definition real[t: Real.Real]: Derivative.HasDerivativeAt (\fun (s: Real.Real) => C.re (function s)) t (C.re (coefficient (point t) i)) :=
  \idelim RealSection.value = (\fun (s: Real.Real) => C.re (function s)) \with h: (Real.Real -> Real.Real) => Derivative.HasDerivativeAt h t (C.re (coefficient (point t) i)) \by {
    base: RealSection.derivativeAt t (point t) _ (\refl(Coordinates.replace a i t)) (realPartial i (point t)),
    equality: \axiom:funext(RealSection.value, (\fun (s: Real.Real) => C.re (function s)), realAgreement)
  };
\definition imaginary[t: Real.Real]: Derivative.HasDerivativeAt (\fun (s: Real.Real) => C.im (function s)) t (C.im (coefficient (point t) i)) :=
  \idelim ImaginarySection.value = (\fun (s: Real.Real) => C.im (function s)) \with h: (Real.Real -> Real.Real) => Derivative.HasDerivativeAt h t (C.im (coefficient (point t) i)) \by {
    base: ImaginarySection.derivativeAt t (point t) _ (\refl(Coordinates.replace a i t)) (imaginaryPartial i (point t)),
    equality: \axiom:funext(ImaginarySection.value, (\fun (s: Real.Real) => C.im (function s)), imaginaryAgreement)
  };
\definition derivative[t: Real.Real]: Calculus.HasDerivativeAt function t (coefficient (point t) i) := Calculus.DerivativeLaws[function, t, coefficient (point t) i] { real := real t, imaginary := imaginary t };
