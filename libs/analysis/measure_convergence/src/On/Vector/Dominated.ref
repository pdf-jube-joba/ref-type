\module Coordinate(i: Fin.Fin n) {
  \definition data: Integral.DominatedSequence := Integral.DominatedSequence {
    sequence := \fun (k: N.Nat^) => component (d.sequence k) i,
    limit := \fun (x: A) => d.limit x i,
    bound := d.bound,
    dominated := \fun (k: N.Nat^) (x: A) => d.dominated k x i,
    converges := \fun (x: A) => d.converges x i,
  };
  \import Integral.Dominated[d := data] \as Proof;
  \definition integrable: Integral.Integrable (\fun (x: A) => d.limit x i) := Proof.limitIntegrable;
  \definition convergence: Sequence.Converges (\fun (k: N.Nat^) => Integral.integral (component (d.sequence k) i)) (Integral.integral Proof.limitRepresentative) := Proof.convergence;
}
\definition representative: Representatives := \into[Function](d.limit, { f: Function \where Integrable f }) \by {
  \fun (i: Fin.Fin n) => Coordinate[i := i].integrable
};
\definition convergence: \forall (i: Fin.Fin n) -> Sequence.Converges (\fun (k: N.Nat^) => integral (d.sequence k) i) (integral representative i) :=
  \fun (i: Fin.Fin n) => Coordinate[i := i].convergence;
