\import complex.Complex[] \as C;
\definition Function: \Set := A -> C.Complex;
\definition Integrable[f: Function]: \Prop := Logic.And[Integral.Integrable (\fun (x: A) => C.re (f x)), Integral.Integrable (\fun (x: A) => C.im (f x))];
\definition Representatives: \Set := \Cast[Function] ({ f: Function \where Integrable f });
\definition realPart[f: Representatives]: Integral.Representatives :=
  \into[A -> Real.Real](\fun (x: A) => C.re (f x), { g: A -> Real.Real \where Integral.Integrable g }) \by {
    (\bysub(Function, { f: Function \where Integrable f }, f)).left
  };
\definition imaginaryPart[f: Representatives]: Integral.Representatives :=
  \into[A -> Real.Real](\fun (x: A) => C.im (f x), { g: A -> Real.Real \where Integral.Integrable g }) \by {
    (\bysub(Function, { f: Function \where Integrable f }, f)).right
  };
\definition integral[f: Representatives]: C.Complex := C.make (Integral.integral (realPart f)) (Integral.integral (imaginaryPart f));
\definition realLaw: \forall (f: Representatives) -> Integral.HasIntegral[\fun (x: A) => C.re (f x), C.re (integral f)] :=
  \fun (f: Representatives) => Integral.integralLaw (realPart f);
\definition imaginaryLaw: \forall (f: Representatives) -> Integral.HasIntegral[\fun (x: A) => C.im (f x), C.im (integral f)] :=
  \fun (f: Representatives) => Integral.integralLaw (imaginaryPart f);
\import Measures.AlmostEverywhere[mu := mu] \as AE;
\use std.Logic[].Equality[].congr;
\definition almostEqual[f, g: Representatives]: \Prop := Measures.Null mu ({ x: A \where Logic.Not (f x = g x) });
\definition integralAlmost: \forall (f, g: Representatives) -> almostEqual f g -> integral f = integral g :=
  \fun (f, g: Representatives) (equal: almostEqual f g) => \block {
    \let realEqual: Measures.AlmostEqual mu (realPart f) (realPart g) := AE.nullSubset
      ({ x: A \where Logic.Not (C.re (f x) = C.re (g x)) }) ({ x: A \where Logic.Not (f x = g x) })
      (\fun (x: A) (different: Logic.Not (C.re (f x) = C.re (g x))) (same: f x = g x) =>
        different (congr!{C.Complex Real.Real} C.re _ _ same)) equal \then
    \let imaginaryEqual: Measures.AlmostEqual mu (imaginaryPart f) (imaginaryPart g) := AE.nullSubset
      ({ x: A \where Logic.Not (C.im (f x) = C.im (g x)) }) ({ x: A \where Logic.Not (f x = g x) })
      (\fun (x: A) (different: Logic.Not (C.im (f x) = C.im (g x))) (same: f x = g x) =>
        different (congr!{C.Complex Real.Real} C.im _ _ same)) equal \then
    \return congr!{Real.Real Real.Real C.Complex} C.make _ _ _ _
      (QuotientIntegral.integralAlmost (realPart f) (realPart g) realEqual)
      (QuotientIntegral.integralAlmost (imaginaryPart f) (imaginaryPart g) imaginaryEqual)
  };
\definition componentBounds: \forall (f: Representatives) (g: Integral.Representatives) ->
  (\forall (x: A) -> R.Le (Product.abs (C.re (f x))) (g x)) ->
  (\forall (x: A) -> R.Le (Product.abs (C.im (f x))) (g x)) ->
  Logic.And[R.Le (Product.abs (C.re (integral f))) (Integral.integral g), R.Le (Product.abs (C.im (integral f))) (Integral.integral g)] :=
  \fun (f: Representatives) (g: Integral.Representatives) (reBound: \forall (x: A) -> R.Le (Product.abs (C.re (f x))) (g x))
    (imBound: \forall (x: A) -> R.Le (Product.abs (C.im (f x))) (g x)) => Logic.And[_, _]::#
      (R.leTrans _ (Integral.integral (Absolute.representative (realPart f))) _ (Absolute.integralAbsBound (realPart f))
        (Absolute.integralMono (Absolute.representative (realPart f)) g reBound))
      (R.leTrans _ (Integral.integral (Absolute.representative (imaginaryPart f))) _ (Absolute.integralAbsBound (imaginaryPart f))
        (Absolute.integralMono (Absolute.representative (imaginaryPart f)) g imBound));
