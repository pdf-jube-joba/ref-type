\definition realData: Integral.DominatedSequence := Integral.DominatedSequence {
  sequence := \fun (k: N.Nat^) => realPart (d.sequence k), limit := \fun (x: A) => C.re (d.limit x),
  bound := d.bound, dominated := d.realBound, converges := d.realConverges,
};
\definition imaginaryData: Integral.DominatedSequence := Integral.DominatedSequence {
  sequence := \fun (k: N.Nat^) => imaginaryPart (d.sequence k), limit := \fun (x: A) => C.im (d.limit x),
  bound := d.bound, dominated := d.imaginaryBound, converges := d.imaginaryConverges,
};
\import Integral.Dominated[d := realData] \as RealProof;
\import Integral.Dominated[d := imaginaryData] \as ImaginaryProof;
\definition representative: Representatives := \into[Function] (d.limit, { f: Function \where Integrable f }) \by {
  Logic.And[_, _]::# RealProof.limitIntegrable ImaginaryProof.limitIntegrable
};
\definition realConvergence: Sequence.Converges (\fun (k: N.Nat^) => C.re (integral (d.sequence k))) (C.re (integral representative)) := RealProof.convergence;
\definition imaginaryConvergence: Sequence.Converges (\fun (k: N.Nat^) => C.im (integral (d.sequence k))) (C.im (integral representative)) := ImaginaryProof.convergence;
