\import functional_analysis.Measure[A := A] \as Measures;
\import Measures.Integral[mu := mu] \as Integral;
\import Measures.ValueLaws[] \as Values;
\import Integral.Convergence[] \as Convergence;
\import Convergence.Monotone[] \as Monotone;
\import Convergence.Fatou[] \as Fatou;
\import Integral.Null[] \as QuotientIntegral;
\import real.Analysis[] \as Real;
\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;

\definition monotone: \forall (f: Convergence.MeasurableSequence) (g: A -> Real.Real) ->
  Convergence.PointwiseSup f g -> Convergence.FunctionIncreasing f ->
  Integral.lowerIntegral g = Convergence.Sup (\fun (k: N.Nat^) => Integral.lowerIntegral (f k)) := Monotone.monotone;

\module FatouFor(f: Fatou.NonnegativeSequence) {
  \import Fatou.Of[f := f] \as Theorem;
  \import Fatou.Tail[f := f] \as Tail;
  \definition liminfIntegral: Measures.Value := Theorem.liminfLowerIntegral;
  \definition inequality: Values.Included liminfIntegral (Fatou.Liminf (\fun (k: N.Nat^) => Integral.lowerIntegral (f k))) := Theorem.fatou;
  \definition finiteLiminf: \forall (g: A -> Real.Real) -> Convergence.PointwiseSup Tail.envelope g ->
    Integral.lowerIntegral g = liminfIntegral := Theorem.finiteLiminf;
  \definition finiteInequality: \forall (g: A -> Real.Real) -> Convergence.PointwiseSup Tail.envelope g ->
    Values.Included (Integral.lowerIntegral g) (Fatou.Liminf (\fun (k: N.Nat^) => Integral.lowerIntegral (f k))) := Theorem.finiteFatou;
}
\definition IntegralClasses: \Set := QuotientIntegral.Space;
\definition integral[C: IntegralClasses]: Real.Real := QuotientIntegral.quotientIntegral C;
\definition classIntegral: \forall (f: Integral.Representatives) -> integral (QuotientIntegral.class f) = Integral.integral f :=
  QuotientIntegral.quotientIntegralOfClass;
\module Vector(n: N.Nat^);
\module Complex;
\module Examples;
