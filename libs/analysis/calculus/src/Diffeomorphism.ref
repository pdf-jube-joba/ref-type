\import calculus.Real[] \as Reals;
\import Reals.Multivariable[n := n].Open[] \as Source;
\import Reals.Multivariable[n := m].Open[] \as Target;
\import calculus.Maps[n := n, m := m] \as Forward;
\import calculus.Maps[n := m, m := n] \as Backward;
\definition SourceOpen: \Set := Source.OpenSet;
\definition TargetOpen: \Set := Target.OpenSet;
\structure Data[U: SourceOpen, V: TargetOpen]: \Set {
  forward: Forward.Map U V,
  backward: Backward.Map V U,
}
\structure Laws[U: SourceOpen, V: TargetOpen, data: Data[U, V]]: \Prop {
  leftInverse: \forall (x: Source.Carrier U) -> Backward.apply V U data.backward (Forward.apply U V data.forward x) = x,
  rightInverse: \forall (y: Target.Carrier V) -> Forward.apply U V data.forward (Backward.apply V U data.backward y) = y,
}
\definition Diffeomorphism(U: SourceOpen)(V: TargetOpen): \Set := \Cast[Data[U, V]] ({ data: Data[U, V] \where Laws[U, V, data] });
\module At(U: SourceOpen, V: TargetOpen);
\module Inverse(U: SourceOpen, V: TargetOpen, f: Diffeomorphism U V);
\module Composition(U: SourceOpen, V: TargetOpen, f: Diffeomorphism U V);
\module Differential(U: SourceOpen, V: TargetOpen, f: Diffeomorphism U V, a: Source.Carrier U);
\module Identity;
