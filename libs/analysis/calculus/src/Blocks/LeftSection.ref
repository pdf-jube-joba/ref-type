\import \parent.FixedLeft[U := RightOpen.whole, V := SourceOpen.whole, c := c] \as Full;
\definition fullIncluded: Full.Included := \fun (x: RightOpen.Carrier RightOpen.whole) => \refl(join c x);
\import \root.Maps[n := m, m := dimension].Preimage[U := RightOpen.whole, W := SourceOpen.whole, V := V, f := Full.map fullIncluded] \as Restriction;
\definition domain: RightOpen.OpenSet := Restriction.domain;
\import \parent.FixedLeft[U := domain, V := V, c := c] \as Slice;
\definition included: Slice.Included := Restriction.inTarget;
\definition map: \root.Maps[n := m, m := dimension].Map domain V := Slice.map included;
\definition apply[x: RightOpen.Carrier domain]: SourceOpen.Carrier V := Slice.apply included x;
\import RightOpen.Whole[] \as Whole;
\definition intro[x: Right.Point]: \In[Source.Point] V.points (join c x) -> \In[Right.Point] domain.points x :=
  \fun (inside: _) => Restriction.intro (Whole.point x) inside;
\module At(a: RightOpen.Carrier domain);
