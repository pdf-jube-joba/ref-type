\import Maps.Differential[U := U, V := V, f := map included, a := a] \as Jacobian;
\import RightVectors.Differential[U := U, f := (\fun (x: RightOpen.Carrier U) => join c x), a := a, d := Jacobian.value] \as Differential;
\definition law: Jacobian.value = rightLinear := Differential.uniqueness rightLinear Jacobian.vectorLaw (differential a);
