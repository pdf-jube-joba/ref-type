\definition domain: SourceOpen.OpenSet := product U V;
\definition leftPoint[x: SourceOpen.Carrier domain]: LeftOpen.Carrier U := \into[Left.Point](left x, U.points) \by {
  (\bysub(Source.Point, domain.points, x)).left
};
\definition rightPoint[x: SourceOpen.Carrier domain]: RightOpen.Carrier V := \into[Right.Point](right x, V.points) \by {
  (\bysub(Source.Point, domain.points, x)).right
};
\definition joinPoint[x: LeftOpen.Carrier U][y: RightOpen.Carrier V]: SourceOpen.Carrier domain := \into[Source.Point](join x y, domain.points) \by {
  Logic.And[_, _]::#
    (\idelim x = left (join x y) \with p: Left.Point => \In[Left.Point] U.points p \by {
      base: \bysub(Left.Point, U.points, x), equality: sym!{Left.Point} _ _ (leftJoin x y)
    })
    (\idelim y = right (join x y) \with p: Right.Point => \In[Right.Point] V.points p \by {
      base: \bysub(Right.Point, V.points, y), equality: sym!{Right.Point} _ _ (rightJoin x y)
    })
};
\import \root.Maps[n := dimension, m := n] \as LeftMaps;
\import \root.Maps[n := dimension, m := m] \as RightMaps;
\import SourceOpen.Examples[] \as Examples;
\definition leftMap: LeftMaps.Map domain U := \into[LeftMaps.Data[domain, U]](LeftMaps.Data[domain, U] { apply := leftPoint },
  { data: LeftMaps.Data[domain, U] \where LeftMaps.Laws[domain, U, data] }) \by {
    LeftMaps.Laws[domain, U, LeftMaps.Data[domain, U]::# leftPoint] {
      smooth := \fun (i: Fin.Fin n) => Examples.projectionSmooth domain (Indices.left i),
    }
  };
\definition rightMap: RightMaps.Map domain V := \into[RightMaps.Data[domain, V]](RightMaps.Data[domain, V] { apply := rightPoint },
  { data: RightMaps.Data[domain, V] \where RightMaps.Laws[domain, V, data] }) \by {
    RightMaps.Laws[domain, V, RightMaps.Data[domain, V]::# rightPoint] {
      smooth := \fun (i: Fin.Fin m) => Examples.projectionSmooth domain (Indices.right i),
    }
  };
