\import One.On[U := U] \as RealFunctions;
\definition componentEquality[i: Fin.Fin n]:
  (\fun (x: Source.Carrier U) => Maps.apply U V f x i) = RealFunctions.lift (\fun (t: Reals.Real) => g t i) :=
  \axiom:funext((\fun (x: Source.Carrier U) => Maps.apply U V f x i), RealFunctions.lift (\fun (t: Reals.Real) => g t i),
    \fun (x: Source.Carrier U) => sym!{Reals.Real} _ _ (congr!{Target.Point Reals.Real} (\fun (p: Target.Point) => p i) _ _ (agrees x)));
\definition derivativeAt: \forall (x: Source.Carrier U)(i: Fin.Fin n) ->
  Reals.Derivative[].Def[].HasDerivativeAt (\fun (t: Reals.Real) => g t i) (x One.index)
    (Maps.Differential[U := U, V := V, f := f, a := x].value.apply unit i) :=
  \fun (x: Source.Carrier U)(i: Fin.Fin n) => RealFunctions.derivativeAt (\fun (t: Reals.Real) => g t i) x _
    (\idelim (\fun (p: Source.Carrier U) => Maps.apply U V f p i) = RealFunctions.lift (\fun (t: Reals.Real) => g t i)
      \with h: Source.ScalarFunction U => Analysis.HasPartialDerivativeAt U h One.index x
        (Maps.Differential[U := U, V := V, f := f, a := x].value.apply unit i) \by {
          base: Analysis.Differential[U := U, f := (\fun (p: Source.Carrier U) => Maps.apply U V f p i), a := x,
            d := Vector.row (Maps.Differential[U := U, V := V, f := f, a := x].value) i].Partial[i := One.index].law
              (Maps.Differential[U := U, V := V, f := f, a := x].vectorLaw i),
          equality: componentEquality i
        });
