\definition function: Source.ScalarFunction U := \fun (x: Source.Carrier U) => Maps.apply U V f x i;
\import Analysis.Curve[U := U, f := function, default := Reals.zero, a := Coordinates.origin, i := One.index] \as Curve;
\definition value: Reals.Real -> Reals.Real := Curve.value;
\definition atPoint: \forall (x: Source.Carrier U) -> value (x One.index) = Maps.apply U V f x i :=
  \fun (x: Source.Carrier U) => Curve.agreement (x One.index) x (replaced x);
\import \root.Vector[n := One.dimension, m := n] \as Vector;
\definition derivativeAt: \forall (x: Source.Carrier U) -> Reals.Derivative[].Def[].HasDerivativeAt value (x One.index)
  (Maps.Differential[U := U, V := V, f := f, a := x].value.apply unit i) :=
  \fun (x: Source.Carrier U) => Curve.derivativeAt (x One.index) x _ (replaced x)
    (Analysis.Differential[U := U, f := function, a := x, d := Vector.row (Maps.Differential[U := U, V := V, f := f, a := x].value) i].Partial[i := One.index].law
      (Maps.Differential[U := U, V := V, f := f, a := x].vectorLaw i));
