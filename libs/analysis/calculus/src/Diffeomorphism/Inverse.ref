\import \root.Diffeomorphism[n := m, m := n] \as Result;
\definition data: Result.Data[V, U] := Result.Data[V, U] {
  forward := #backward{f}, backward := #forward{f},
};
\definition inverse: Result.Diffeomorphism V U := \into[Result.Data[V, U]](data,
  { value: Result.Data[V, U] \where Result.Laws[V, U, value] }) \by {
    Result.Laws[V, U, data] {
      leftInverse := #rightInverse{f}, rightInverse := #leftInverse{f},
    }
  };
