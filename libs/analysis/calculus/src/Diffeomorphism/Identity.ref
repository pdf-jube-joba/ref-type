\import \root.Identity[n := n] \as Identity;
\import \root.Diffeomorphism[n := n, m := n] \as Diffeomorphisms;
\definition value(U: Source.OpenSet): Diffeomorphisms.Diffeomorphism U U :=
  \into[Diffeomorphisms.Data[U, U]](Diffeomorphisms.Data[U, U] {
    forward := Identity.map U, backward := Identity.map U,
  }, { data: Diffeomorphisms.Data[U, U] \where Diffeomorphisms.Laws[U, U, data] }) \by {
    Diffeomorphisms.Laws[U, U, Diffeomorphisms.Data[U, U]::# (Identity.map U) (Identity.map U)] {
      leftInverse := \fun (x: Source.Carrier U) => \refl(x),
      rightInverse := \fun (x: Source.Carrier U) => \refl(x),
    }
  };
