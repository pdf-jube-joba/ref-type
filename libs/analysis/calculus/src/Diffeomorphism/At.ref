\import Source.Topology[].Of[U := U] \as SourceTopology;
\import Target.Topology[].Of[U := V] \as TargetTopology;
\import Forward.Topology[U := U, V := V] \as ForwardTopology;
\import Backward.Topology[U := V, V := U] \as BackwardTopology;
\import topology.Homeomorphism[A := Source.Carrier U, B := Target.Carrier V] \as Homeomorphisms;
\definition homeomorphism(f: Diffeomorphism U V): Homeomorphisms.Homeomorphism[SourceTopology.topology, TargetTopology.topology] :=
  Homeomorphisms.Homeomorphism[SourceTopology.topology, TargetTopology.topology] {
    forward := Forward.apply U V (#forward{f}), backward := Backward.apply V U (#backward{f}),
    leftInverse := #leftInverse{f}, rightInverse := #rightInverse{f},
    forwardContinuous := ForwardTopology.continuous (#forward{f}), backwardContinuous := BackwardTopology.continuous (#backward{f}),
  };
