\import real.Analysis[] \as R;
\import std.Data[].FinSet[] \as Fin;
\import linear_algebra.Euclidean[n := r] \as E;
\import linear_algebra.Field[].Space[K := R.Real, field := R.Algebra[].field].Linear[V := E.Vector, W := E.Vector, source := E.space, target := E.space] \as Maps;
\import \root.Real[].Multivariable[n := d].Open[] \as Open;
\import \root.MatrixFamily[d := d, p := r, q := r] \as Matrix;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\module On(U: Open.OpenSet, A, B: Open.Carrier U -> Maps.Map);
\definition regular: \forall (U: Open.OpenSet)(A, B: Open.Carrier U -> Maps.Map) ->
  (\forall (x: Open.Carrier U)(v: E.Vector) -> (B x).apply ((A x).apply v) = v) ->
  (\forall (x: Open.Carrier U)(v: E.Vector) -> (A x).apply ((B x).apply v) = v) -> Matrix.Regular U A -> Matrix.Regular U B :=
  \fun (U: Open.OpenSet)(A, B: Open.Carrier U -> Maps.Map)(left: _)(right: _)(regular: _) => On[U := U, A := A, B := B].regular left right regular;
