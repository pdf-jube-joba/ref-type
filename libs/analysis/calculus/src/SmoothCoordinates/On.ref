\definition Regular[v: Open.Carrier U -> E.Vector]: \Prop := \forall (i: Fin.Fin q) -> Smooth.SmoothOn U (\fun (x: Open.Carrier U) => v x i);
\definition dot: \forall (v, w: Open.Carrier U -> E.Vector) -> Regular v -> Regular w -> Smooth.SmoothOn U (\fun (x: Open.Carrier U) => E.dot (v x) (w x)) :=
  \fun (v, w: Open.Carrier U -> E.Vector)(left: Regular v)(right: Regular w) => Sums.smooth U q
    (\fun (i: Fin.Fin q)(x: Open.Carrier U) => R.mul (v x i) (w x i))
    (\fun (i: Fin.Fin q) => Operations.mulSmooth U (\fun (x: Open.Carrier U) => v x i) (\fun (x: Open.Carrier U) => w x i) (left i) (right i));
\definition constant: \forall (v: E.Vector) -> Regular (\fun (x: Open.Carrier U) => v) :=
  \fun (v: E.Vector)(i: Fin.Fin q) => Operations.constantSmooth U (v i);
\import E.Successor[] \as Split;
\import Fin.Tuples[A := R.Real] \as Tuples;
\module Joining(a: Open.ScalarFunction U, v: Open.Carrier U -> E.Vector, first: Smooth.SmoothOn U a, rest: Regular v);
\definition join: \forall (a: Open.ScalarFunction U)(v: Open.Carrier U -> E.Vector) -> Smooth.SmoothOn U a -> Regular v ->
  \forall (i: Fin.Fin (N.Nat^::succ q)) -> Smooth.SmoothOn U (\fun (x: Open.Carrier U) => Split.join (a x) (v x) i) :=
  \fun (a: Open.ScalarFunction U)(v: Open.Carrier U -> E.Vector)(first: Smooth.SmoothOn U a)(rest: Regular v) =>
    Joining[a := a, v := v, first := first, rest := rest].smooth;
