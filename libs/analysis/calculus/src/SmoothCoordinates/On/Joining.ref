\definition cases: \forall (option: Options.Option[Fin.Fin q]) -> Smooth.SmoothOn U (\fun (x: Open.Carrier U) => Tuples.evaluate q (a x) (v x) option) :=
  \induction (option: Options.Option[Fin.Fin q]) \return Smooth.SmoothOn U (\fun (x: Open.Carrier U) => Tuples.evaluate q (a x) (v x) option) \with {
    | none: \idelim a = (\fun (x: Open.Carrier U) => a x) \with f: Open.ScalarFunction U => Smooth.SmoothOn U f \by {
      base: first, equality: \axiom:funext(a, (\fun (x: Open.Carrier U) => a x), \fun (x: Open.Carrier U) => \refl(a x))
    }
    | some: \fun (i: Fin.Fin q) => rest i
  };
\definition smooth: \forall (i: Fin.Fin (N.Nat^::succ q)) -> Smooth.SmoothOn U (\fun (x: Open.Carrier U) => Split.join (a x) (v x) i) :=
  \fun (i: Fin.Fin (N.Nat^::succ q)) => cases (Fin.split q i);
