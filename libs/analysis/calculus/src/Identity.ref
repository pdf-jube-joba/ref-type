\import \root.Real[] \as Reals;
\import Reals.Multivariable[n := n].Open[] \as Open;
\import Open.Examples[] \as Examples;
\import \root.Maps[n := n, m := n] \as Maps;
\import \root.Vector[n := n, m := n] \as Vector;
\import real.Analysis[].Algebra[] \as Algebra;
\import linear_algebra.Field[].Space[K := Reals.Real, field := Algebra.field] \as Spaces;
\import Spaces.Coordinates[I := std.Data[].FinSet[].Fin n] \as Coordinates;
\import Spaces.Linear[V := Coordinates.Vector, W := Coordinates.Vector, source := Coordinates.space, target := Coordinates.space] \as Linear;
\definition linear: Linear.Map := Linear.Map {
  apply := \fun (x: Coordinates.Vector) => x,
  preservesAdd := \fun (x, y: Coordinates.Vector) => \refl(Coordinates.plus x y),
  preservesScale := \fun (c: Reals.Real)(x: Coordinates.Vector) => \refl(Coordinates.scale c x),
};
\definition map(U: Open.OpenSet): Maps.Map U U := \into[Maps.Data[U, U]](Maps.Data[U, U] {
  apply := \fun (x: Open.Carrier U) => x,
}, { data: Maps.Data[U, U] \where Maps.Laws[U, U, data] }) \by {
  Maps.Laws[U, U, Maps.Data[U, U]::# (\fun (x: Open.Carrier U) => x)] {
    smooth := \fun (i: std.Data[].FinSet[].Fin n) => Examples.projectionSmooth U i,
  }
};
\module At(U: Open.OpenSet, a: Open.Carrier U);
\module Between(U, V: Open.OpenSet);
