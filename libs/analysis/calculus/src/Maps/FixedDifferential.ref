/* Evaluation of the smooth Jacobian field on a fixed vector. */
\import std.Data[].FinSet[] \as Fin;
\import Source.Smooth[].Derivative[] \as Partials;
\import Source.Smooth[].Operations[] \as Operations;
\import Source.Smooth[].Sums[] \as Sums;
\definition value[j: Fin.Fin m][a: Source.Carrier U]: Reals.Real := \parent.Differential[U := U, V := V, f := f, a := a].value.apply v j;
\definition term[j: Fin.Fin m][i: Fin.Fin n][a: Source.Carrier U]: Reals.Real := Reals.mul (Partials.partial U (coordinateFunction U V f j) i a) (v i);
\definition smooth: \forall (j: Fin.Fin m) -> Source.Smooth[].SmoothOn U (value j) :=
  \fun (j: Fin.Fin m) => Sums.smooth U n (term j) (\fun (i: Fin.Fin n) => Operations.mulSmooth U
    (Partials.partial U (coordinateFunction U V f j) i) (\fun (a: Source.Carrier U) => v i)
    (Partials.partialSmooth U (coordinateFunction U V f j) i) (Operations.constantSmooth U (v i)));
