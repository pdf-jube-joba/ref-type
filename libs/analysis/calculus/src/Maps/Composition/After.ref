\import \root.Maps[n := m, m := l] \as Before;
\import \root.Maps[n := n, m := l] \as Result;
\definition data: Result.Data[U, W] := Result.Data[U, W] {
  apply := \fun (x: Source.Carrier U) => Before.apply V W g (apply U V f x),
};
\definition laws: Result.Laws[U, W, data] := Result.Laws[U, W, data] {
  smooth := \fun (j: Fin.Fin l) => smooth (Before.coordinateFunction V W g j),
};
\definition compose: Result.Map U W := \into[Result.Data[U, W]](data,
  { map: Result.Data[U, W] \where Result.Laws[U, W, map] }) \by { laws };
\module At(a: Source.Carrier U);
