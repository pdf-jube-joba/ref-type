\definition value[x: Source.Carrier U]: Target.Carrier W := \into[Reals.Multivariable[n := m].Point](apply U V f x, W.points) \by { inside x };
\definition map: Map U W := \into[Data[U, W]](Data[U, W] { apply := value }, { data: Data[U, W] \where Laws[U, W, data] }) \by {
  Laws[U, W, Data[U, W]::# value] { smooth := f.smooth }
};
\definition differential: \forall (a: Source.Carrier U) ->
  \parent.Differential[U := U, V := W, f := map, a := a].value = \parent.Differential[U := U, V := V, f := f, a := a].value := \block {
  \fun (a: Source.Carrier U) \then
  \let first: Source.Carrier U -> Reals.Multivariable[n := m].Point := \fun (x: Source.Carrier U) => apply U W map x \then
  \let second: Source.Carrier U -> Reals.Multivariable[n := m].Point := \fun (x: Source.Carrier U) => apply U V f x \then
  \return \parent.Differential[U := U, V := W, f := map, a := a].Compare[W := V, g := f].equal
    (\axiom:funext(first, second, \fun (x: Source.Carrier U) => \refl(apply U V f x)))
};
