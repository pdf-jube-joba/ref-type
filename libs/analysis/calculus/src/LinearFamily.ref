/* Smooth action of a matrix family on a product of open coordinates. */
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Nat[] \as N;
\import \root.Real[] \as Reals;
\import Reals.Multivariable[n := n].Open[] \as Source;
\import Reals.Multivariable[n := m].Open[] \as Target;
\import Reals.Multivariable[n := p].Open[] \as Input;
\import Reals.Multivariable[n := q].Open[] \as Output;
\import Source.Smooth[].Derivative[] \as Partials;
\import \root.Maps[n := n, m := m] \as Maps;
\definition Matrix[U: Source.OpenSet]: \Set := Fin.Fin q -> Fin.Fin p -> Partials.Function U;
\module On(U: Source.OpenSet, V: Target.OpenSet, f: Maps.Map U V, matrix: Matrix U);
