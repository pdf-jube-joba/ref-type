\definition x: Open.Carrier U := SourceProduct.leftPoint z;
\definition v: Source.Vector := SourceBlocks.right z;
\definition row[i: Fin.Fin q]: Finite.Map p := Finite.Data[p] {
  apply := \fun (v: Source.Vector) => (A x).apply v i,
  additive := \fun (v, w: Source.Vector) => congr!{{Target.Vector} {R.Real}} (\fun (w: Target.Vector) => w i) _ _ ((A x).preservesAdd v w),
  homogeneous := \fun (a: R.Real)(v: Source.Vector) => congr!{{Target.Vector} {R.Real}} (\fun (w: Target.Vector) => w i) _ _ ((A x).preservesScale a v),
};
\definition action: Action.action z = (A x).apply v := \axiom:funext(Action.action z, (A x).apply v, \fun (i: Fin.Fin q) => trans!{{R.Real}} _ _ _
  (R.FiniteSums[].congruent p _ _ (\fun (j: Fin.Fin p) => Spaces.mulComm ((A x).apply (Source.basis j) i) (v j)))
  (sym!{{R.Real}} _ _ (Finite.expansion p (row i) v)));
\definition formula: Result.apply SourceProduct.domain TargetProduct.domain map z = TargetProduct.joinPoint x
  (\into[Target.Vector]((A x).apply v, Output.whole.points) \by { \refl((A x).apply v) }) :=
  congr!{Target.Vector {\root.Real[].Multivariable[n := targetDimension].Point}} (TargetBlocks.join x) _ _ action;
