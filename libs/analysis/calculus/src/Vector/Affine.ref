\import Arithmetic.Algebra[] \as Algebra;
\definition remainderZero[a, x: Source.Carrier U][j: Fin.Fin m]: Scalars.remainder U (component U (affine U c d) j) a (row d j) x = Arithmetic.zero := \block {
  \let difference: Reals.sub (Reals.add (c j) (d.apply x j)) (Reals.add (c j) (d.apply a j)) = Reals.sub (d.apply x j) (d.apply a j) :=
    trans!{Reals.Real} _ _ _ (Algebra.subAdd (c j) (d.apply x j) (c j) (d.apply a j))
      (trans!{Reals.Real} _ _ _ (congr!{Reals.Real Reals.Real} (\fun (r: Reals.Real) => Reals.add r (Reals.sub (d.apply x j) (d.apply a j))) _ _ (Laws.subSelf (c j))) (Laws.addZeroLeft (Reals.sub (d.apply x j) (d.apply a j)))) \then
  \return trans!{Reals.Real} _ _ _
    (congr2!{Reals.Real Reals.Real Reals.Real} Reals.sub _ _ _ _ difference (SourceLinear.subtract (row d j) x a))
    (Laws.subSelf (Reals.sub (d.apply x j) (d.apply a j)))
};
\definition law: \forall (a: Source.Carrier U)(j: Fin.Fin m) -> Scalars.HasDifferentialAt U (component U (affine U c d) j) a (row d j) :=
  \fun (a: Source.Carrier U)(j: Fin.Fin m)(epsilon: Reals.Real)(positive: _) => Logic.existsIntro[Reals.Real,
    { delta: Reals.Real \where Scalars.DifferentialControl[U, component U (affine U c d) j, a, row d j, epsilon, delta] }] epsilon
    (Scalars.DifferentialControl[U, component U (affine U c d) j, a, row d j, epsilon, epsilon] {
      positive := positive,
      estimate := \fun (x: Source.Carrier U)(nonzero: _)(near: _) => R.ltReplaceLeft Arithmetic.zero
        (Reals.distance (Scalars.remainder U (component U (affine U c d) j) a (row d j) x) Arithmetic.zero)
        (Reals.mul epsilon (DomainCoordinates.pointDistance x a))
        (sym!{Reals.Real} _ _ (trans!{Reals.Real} _ _ _
          (congr!{Reals.Real Reals.Real} (\fun (v: Reals.Real) => Reals.distance v Arithmetic.zero) _ _ (remainderZero a x j)) (Metric.distanceSelf Arithmetic.zero)))
        (Product.mulPositive epsilon (DomainCoordinates.pointDistance x a) positive nonzero),
    });
