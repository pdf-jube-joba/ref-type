\definition injective: Rank.Injective A := \fun (x: Open.Carrier U)(v, w: E.Vector)(same: _) => trans!{{E.Vector}} _ _ _
  (sym!{{E.Vector}} _ _ (left x v)) (trans!{{E.Vector}} _ _ _ (congr!{{E.Vector} {E.Vector}} (B x).apply _ _ same) (left x w));
\module Factors(factors: Rank.Factors[A]);
\definition regular: Matrix.Regular U B := \block {
  \takefrom factors: Rank.Factors[A] \by Gram.exists r A regular injective \then
  \return Factors[factors := factors].regular
};
