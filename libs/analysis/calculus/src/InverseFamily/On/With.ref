\use std.Logic[].Equality[].eq_reason_in;
\definition injective: Rank.Injective A := \fun (x: Open.Carrier U)(v, w: E.Vector)(same: _) => eq_reason_in!{{E.Vector} _
  "=" _ "by" { sym!{{E.Vector}} _ _ (left x v) }
  "=" _ "by" { congr!{{E.Vector} {E.Vector}} (B x).apply _ _ same }
  "=" _ "by" { left x w }
};
\module Factors(factors: Rank.Factors[A]);
\definition regular: Matrix.Regular U B := \block {
  \takefrom factors: Rank.Factors[A] \by Gram.exists r A regular injective \then
  \return Factors[factors := factors].regular
};
