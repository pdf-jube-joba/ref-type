\import E.Gram[k := r].Of[A := A x, factor := factors.value x] \as Algebra;
\definition formula: \forall (v: E.Vector) -> (Projection.inverse x).apply v = (B x).apply v := \fun (v: E.Vector) => trans!{{E.Vector}} _ _ _
  (congr!{{E.Vector} {E.Vector}} (Projection.inverse x).apply _ _ (sym!{{E.Vector}} _ _ (right x v))) (Algebra.leftInverse ((B x).apply v));
