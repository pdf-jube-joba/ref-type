\import Rank.Projections[A := A, factors := factors] \as Projection;
\module At(x: Open.Carrier U);
\definition regular: Matrix.Regular U B := \fun (i, j: Fin.Fin r) => \idelim
  (\fun (x: Open.Carrier U) => (Projection.inverse x).apply (E.basis j) i) = (\fun (x: Open.Carrier U) => (B x).apply (E.basis j) i)
  \with f: Open.ScalarFunction U => Open.Smooth[].SmoothOn U f \by {
    base: Projection.inverseRegular i j,
    equality: \axiom:funext((\fun (x: Open.Carrier U) => (Projection.inverse x).apply (E.basis j) i),
      (\fun (x: Open.Carrier U) => (B x).apply (E.basis j) i), \fun (x: Open.Carrier U) => congr!{{E.Vector} {R.Real}} (\fun (v: E.Vector) => v i) _ _ (At[x := x].formula (E.basis j)))
  };
