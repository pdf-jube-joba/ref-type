\definition Left: \Prop := \forall (x: Open.Carrier U)(v: E.Vector) -> (B x).apply ((A x).apply v) = v;
\definition Right: \Prop := \forall (x: Open.Carrier U)(v: E.Vector) -> (A x).apply ((B x).apply v) = v;
\import \root.GramSchmidt[d := d, q := r].On[U := U] \as Gram;
\import Gram.Rank[p := r] \as Rank;
\module With(left: Left, right: Right, regular: Matrix.Regular U A);
\definition regular: Left -> Right -> Matrix.Regular U A -> Matrix.Regular U B := \fun (left: Left)(right: Right)(regular: Matrix.Regular U A) => With[left := left, right := right, regular := regular].regular;
