\import linear_algebra.Euclidean[n := n] \as Source;
\import linear_algebra.Euclidean[n := m] \as Target;
\import real.Analysis[] \as R;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real (R.Algebra[].field)] \as Spaces;
\import Spaces.Linear[V := Source.Vector, W := Target.Vector, source := Source.space, target := Target.space] \as Linear;
\import \root.Maps[n := n, m := m] \as Maps;
\import \root.Real[].Multivariable[n := n].Open[] \as Open;
\import \root.Real[].Multivariable[n := m].Open[] \as Output;
\import \root.MatrixFamily[d := n, p := n, q := m] \as Matrix;
\import \root.Vector[n := n, m := m] \as Vector;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.congr;
\module On(U: Open.OpenSet, L: Linear.Map);
