/* Evaluation of a finite-dimensional multilinear form is smooth. */
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.congr;
\import real.Analysis[] \as R;
\import linear_algebra.Commutative[K := R.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing R.Real (R.Algebra[].field)] \as Spaces;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\import Spaces.FiniteCoordinates[n := n] \as Coordinates;
\import Spaces.Multilinear[V := Vectors.Vector, space := Vectors.space] \as Forms;
\import Fin.Empty[A := Vectors.Vector] \as Empty;
\import \root.Real[].Multivariable[n := d].Open[] \as Open;
\import Open.Smooth[] \as Smooth;
\import Smooth.Operations[] \as Operations;
\import Smooth.Sums[].Listed[I := Fin.Fin n] \as Sums;
\module On(U: Open.OpenSet);
