\import \root.Real[] \as Reals;
\import Reals.Multivariable[n := n].Open[] \as Open;
\import Open.Whole[] \as Whole;
\import Open.Examples[] \as Examples;
\import Open.Smooth[].Operations[] \as Operations;
\import \root.Maps[n := n, m := n] \as Maps;
\import std.Data[].FinSet[] \as Fin;
\definition map[U: Open.OpenSet][c: Reals.Real]: Maps.Map U Open.whole := \into[Maps.Data[U, Open.whole]](Maps.Data[U, Open.whole] {
  apply := \fun (x: Open.Carrier U) => Whole.point (\fun (i: Fin.Fin n) => Reals.mul (x i) c),
}, { data: Maps.Data[U, Open.whole] \where Maps.Laws[U, Open.whole, data] }) \by {
  Maps.Laws[U, Open.whole, Maps.Data[U, Open.whole]::# (\fun (x: Open.Carrier U) => Whole.point (\fun (i: Fin.Fin n) => Reals.mul (x i) c))] {
    smooth := \fun (i: Fin.Fin n) => Operations.mulSmooth U (\fun (x: Open.Carrier U) => x i) (\fun (x: Open.Carrier U) => c)
      (Examples.projectionSmooth U i) (Examples.constantSmooth U c),
  }
};
