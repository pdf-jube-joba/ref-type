\import GramStep.On[A := A x, injective := injective x] \as Point;
\definition positive: Order.Lt R.zero (Target.squared ((A x).apply Split.first)) := \bysub(Target.Vector,
  { v: Target.Vector \where Order.Lt R.zero (Target.squared v) }, Point.positiveColumn);
\import Target.Normalization[v := Point.positiveColumn] \as Normalize;
\definition lengthNonzero: Logic.Not (R.SquareRoot[].sqrt (Target.squared ((A x).apply Split.first)) = R.zero) := Normalize.lengthNonzero;
\definition unit: Target.Vector := Point.unit.vector;
\definition tailMap: LowerMaps.Map := Point.tailMap;
\definition residual: LowerMaps.Map := Point.residual;
\definition residualInjective: Target.Gram[k := p].Injective residual := Point.residualInjective;
