\module At(x: Open.Carrier U);
\definition value[x: Open.Carrier U]: Target.Gram[k := N.Nat^::succ p].Factorization[A x] := At[x := x].factorization;
\definition frameRegular: HigherMatrix.Regular U (\fun (x: Open.Carrier U) => (value x).frame) :=
  \fun (i: Fin.Fin q)(j: Fin.Fin (N.Nat^::succ p)) => Operations.addSmooth U
    (\fun (x: Open.Carrier U) => R.mul (Split.head (HigherSource.basis j)) (unit x i))
    (\fun (x: Open.Carrier U) => (prior.value x).frame.apply (Split.tail (HigherSource.basis j)) i)
    (Operations.scaleSmooth U (Split.head (HigherSource.basis j)) (\fun (x: Open.Carrier U) => unit x i) (unitRegular i))
    (LowerMatrix.evaluate U (\fun (x: Open.Carrier U) => (prior.value x).frame) prior.frame (Split.tail (HigherSource.basis j)) i);
\module Coefficient(j: Fin.Fin (N.Nat^::succ p));
\definition factors: Higher.Factors[A] := Higher.Factors[A] {
  value := value, frame := frameRegular,
  change := \fun (i, j: Fin.Fin (N.Nat^::succ p)) => Coefficient[j := j].forwardSmooth i,
  inverse := \fun (i, j: Fin.Fin (N.Nat^::succ p)) => Coefficient[j := j].backwardSmooth i,
};
