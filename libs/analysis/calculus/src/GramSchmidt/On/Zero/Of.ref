\definition value[x: Open.Carrier U]: Gram.Factorization[A x] := Gram.Factorization[A x] {
  frame := frame, change := change,
  formula := \fun (v: Empty.Vector) => trans!{{Target.Vector}} _ _ _
    (congr!{{Empty.Vector} {Target.Vector}} (A x).apply _ _ (R.FiniteSums[].Linear[].emptyVector v)) (A x).preservesZero,
};
\definition factors: Rank.Factors[A] := Rank.Factors[A] {
  value := value,
  frame := \fun (i: Fin.Fin q)(j: Fin.Fin N.Nat^::zero) => Logic.falseElim _ (Fin.zeroImpossible j (Fin.bound N.Nat^::zero j)),
  change := \fun (i, j: Fin.Fin N.Nat^::zero) => Logic.falseElim _ (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i)),
  inverse := \fun (i, j: Fin.Fin N.Nat^::zero) => Logic.falseElim _ (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i)),
};
