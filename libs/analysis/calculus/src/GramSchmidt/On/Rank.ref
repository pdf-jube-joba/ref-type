\import linear_algebra.Euclidean[n := p] \as Source;
\import Target.Gram[k := p] \as Gram;
\import Spaces.Linear[V := Source.Vector, W := Target.Vector, source := Source.space, target := Target.space] \as Maps;
\import \root.MatrixFamily[d := d, p := p, q := q] \as Matrix;
\import \root.MatrixFamily[d := d, p := p, q := p] \as Square;
\definition Family: \Set := Open.Carrier U -> Maps.Map;
\definition Regular[A: Family]: \Prop := Matrix.Regular U A;
\definition Injective[A: Family]: \Prop := \forall (x: Open.Carrier U) -> Gram.Injective (A x);
\structure Factors[A: Family]: \Set := {
  value: \forall (x: Open.Carrier U) -> Gram.Factorization[A x],
  frame: Matrix.Regular U (\fun (x: Open.Carrier U) => (value x).frame),
  change: Square.Regular U (\fun (x: Open.Carrier U) => (value x).change.forward),
  inverse: Square.Regular U (\fun (x: Open.Carrier U) => (value x).change.backward),
};
\module Projections(A: Family, factors: Factors[A]);
