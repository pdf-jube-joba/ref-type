\import \parent.Rank[p := N.Nat^::zero] \as Rank;
\import linear_algebra.Euclidean[n := N.Nat^::zero] \as Empty;
\import Target.Gram[k := N.Nat^::zero] \as Gram;
\import Empty.Matrix[m := q] \as Matrix;
\import Spaces.Linear[V := Empty.Vector, W := Target.Vector, source := Empty.space, target := Target.space].Operations[] \as ZeroMaps;
\import Spaces.Eigen[V := Empty.Vector, space := Empty.space] \as End;
\import Spaces.Isomorphism[V := Empty.Vector, W := Empty.Vector, source := Empty.space, target := Empty.space] \as Isomorphisms;
\definition frame: Matrix.Isometry := \into[Spaces.Linear[V := Empty.Vector, W := Target.Vector, source := Empty.space, target := Target.space].Map](ZeroMaps.zeroMap, Matrix.Isometry) \by {
  \fun (v, w: Empty.Vector) => Target.form.zeroLeft Target.space.zero
};
\definition change: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := End.identity, backward := End.identity, leftInverse := \fun (v: Empty.Vector) => \refl(v), rightInverse := \fun (v: Empty.Vector) => \refl(v),
};
\module Of(A: Rank.Family);
\definition exists: Previous N.Nat^::zero := \fun (A: Rank.Family)(regular: Rank.Regular A)(injective: Rank.Injective A) => \exact(Of[A := A].factors, Rank.Factors[A]);
