\import \parent.Rank[p := p] \as Lower;
\import \parent.Rank[p := N.Nat^::succ p] \as Higher;
\module Of(A: Higher.Family, regular: Higher.Regular A, injective: Higher.Injective A);
\definition exists: Previous (N.Nat^::succ p) := \fun (A: Higher.Family)(regular: Higher.Regular A)(injective: Higher.Injective A) => Of[A := A, regular := regular, injective := injective].exists;
