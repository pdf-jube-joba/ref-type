\module Rank(p: N.Nat^);
\definition Previous[p: N.Nat^]: \Prop := \forall (A: Rank[p := p].Family) -> Rank[p := p].Regular A -> Rank[p := p].Injective A -> \exists Rank[p := p].Factors[A];
\module Zero;
\module Step(p: N.Nat^, previous: Previous p);
\definition exists: \forall (p: N.Nat^) -> Previous p := \induction (p: N.Nat^) \return Previous p \with {
  | zero: Zero[].exists
  | succ: \fun (p: N.Nat^)(previous: Previous p) => Step[p := p, previous := previous].exists
};
