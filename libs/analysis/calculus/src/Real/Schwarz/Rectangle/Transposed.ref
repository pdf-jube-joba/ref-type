\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Rectangle[left := bottom, right := top, bottom := left, top := right] \as Transpose;
\definition quotientTranspose: \forall (f: Real -> Real -> Real) -> quotient f = Transpose.quotient (\fun (s, t: Real) => f t s) :=
  \fun (f: Real -> Real -> Real) => eq_reason_in!{Real _
    "=" _ "by" { congr!{Real Real} (\fun (d: Real) => mul (mul d (inv (sub top bottom))) (inv (sub right left))) _ _
      (doubleDifference (f right top) (f left top) (f right bottom) (f left bottom)) }
    "=" _ "by" { Laws.fieldMulAssoc (Transpose.difference (\fun (s, t: Real) => f t s)) (inv (sub top bottom)) (inv (sub right left)) }
    "=" _ "by" { congr!{Real Real} (mul (Transpose.difference (\fun (s, t: Real) => f t s))) _ _ (Laws.fieldMulComm (inv (sub top bottom)) (inv (sub right left))) }
    "=" _ "by" { sym!{Real} _ _ (Laws.fieldMulAssoc (Transpose.difference (\fun (s, t: Real) => f t s)) (inv (sub right left)) (inv (sub top bottom))) }
  };
