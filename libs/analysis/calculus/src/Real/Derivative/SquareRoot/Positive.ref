\use std.Logic[].Equality[].eq_reason_in;
\definition square: mul (Root.sqrt x) (Root.sqrt x) = x := Root.squareOfNonnegative x (Order.leOfLt zero x positive);
\definition nonzero: Logic.Not (Root.sqrt x = zero) := \fun (same: _) => Inverse.positiveNonzero x positive
  (eq_reason_in!{Real _
    "=" _ "by" { sym!{Real} _ _ square }
    "=" _ "by" { congr!{Real Real Real} mul _ _ _ _ same same }
    "=" _ "by" { Laws.fieldMulZeroLeft zero }
  });
\definition rootPositive: R.Lt zero (Root.sqrt x) := Order.ltOfLeNotEq zero (Root.sqrt x) (Root.nonnegative x)
  (\fun (same: zero = Root.sqrt x) => nonzero (sym!{Real} _ _ same));
\definition denominator: Real := add (Root.sqrt x) (Root.sqrt x);
\definition denominatorPositive: R.Lt zero denominator := R.ltLeTrans zero (Root.sqrt x) denominator rootPositive
  (Algebra.leAddRight (Root.sqrt x) (Root.sqrt x) (Root.nonnegative x));
\definition inverseSum: inv denominator = mul (mul Analysis.half (Root.sqrt x)) (inv x) := sym!{Real} _ _
  (Inverse.inverseUnique denominator (mul (mul Analysis.half (Root.sqrt x)) (inv x)) (Inverse.positiveNonzero denominator denominatorPositive) (eq_reason!{
    {mul (mul (mul Analysis.half (Root.sqrt x)) (inv x)) denominator}
    "=" {mul (mul Analysis.half (Root.sqrt x)) (mul (inv x) denominator)} "by" {Laws.fieldMulAssoc (mul Analysis.half (Root.sqrt x)) (inv x) denominator}
    "=" {mul (mul Analysis.half (Root.sqrt x)) (mul denominator (inv x))} "by" {congr!{Real Real} (mul (mul Analysis.half (Root.sqrt x))) _ _ (Laws.fieldMulComm (inv x) denominator)}
    "=" {mul (mul (mul Analysis.half (Root.sqrt x)) denominator) (inv x)} "by" {sym!{Real} _ _ (Laws.fieldMulAssoc (mul Analysis.half (Root.sqrt x)) denominator (inv x))}
    "=" {mul (mul Analysis.half (mul (Root.sqrt x) denominator)) (inv x)} "by" {congr!{Real Real} (\fun (y: Real) => mul y (inv x)) _ _ (Laws.fieldMulAssoc Analysis.half (Root.sqrt x) denominator)}
    "=" {mul (mul Analysis.half (add x x)) (inv x)} "by" {congr!{Real Real} (\fun (y: Real) => mul (mul Analysis.half y) (inv x)) _ _
      (trans!{Real} _ _ _ (Laws.fieldMulAdd (Root.sqrt x) (Root.sqrt x) (Root.sqrt x)) (congr!{Real Real Real} add _ _ _ _ square square))}
    "=" {mul x (inv x)} "by" {congr!{Real Real} (\fun (y: Real) => mul y (inv x)) _ _ (trans!{Real} _ _ _ (Laws.fieldMulAdd Analysis.half x x) (Estimates.halfTwice x))}
    "=" one "by" {trans!{Real} _ _ _ (Laws.fieldMulComm x (inv x)) (Laws.fieldInverseNonzero x (Inverse.positiveNonzero x positive))}
  }));
