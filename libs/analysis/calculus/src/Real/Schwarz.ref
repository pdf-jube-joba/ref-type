\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Derivative[].Def[] \as Derivatives;
\import \parent.Derivative[].Operations[] \as DerivativeLaws;
\import real.Analysis[].Algebra[] \as Algebra;
\import R.Order[] \as Order;
\use Equality.congr;
\definition doubleDifference: \forall (a, b, c, d: Real) -> sub (sub a b) (sub c d) = sub (sub a c) (sub b d) :=
  \fun (a, b, c, d: Real) => eq_reason_in!{Real _
    "=" _ "by" { congr!{Real Real} (add (sub a b)) _ _ (Algebra.negSub c d) }
    "=" _ "by" { Algebra.addFour a (Arithmetic.neg b) d (Arithmetic.neg c) }
    "=" _ "by" { congr!{Real Real} (add (add a d)) _ _ (Laws.addComm (Arithmetic.neg b) (Arithmetic.neg c)) }
    "=" _ "by" { sym!{Real} _ _ (Algebra.addFour a (Arithmetic.neg c) d (Arithmetic.neg b)) }
    "=" _ "by" { congr!{Real Real} (add (sub a c)) _ _ (sym!{Real} _ _ (Algebra.negSub b d)) }
  };
\import metric_spaces.RealLine[] \as Line;
\module Rectangle(left, right, bottom, top: Real);
