\import \parent.\parent.\parent.\parent.Analysis[].Product[U := U, f := f, g := g, i := i] \as Product;
\definition law: apply i (Functions.product f g) = Functions.plus (Functions.product (apply i f) g) (Functions.product f (apply i g)) :=
  Functions.ext (apply i (Functions.product f g)) (Functions.plus (Functions.product (apply i f) g) (Functions.product f (apply i g)))
    (\fun (a: Carrier U) => Differentiation.partialUnique U (Functions.product f g) i a
      (apply i (Functions.product f g) a) (Functions.plus (Functions.product (apply i f) g) (Functions.product f (apply i g)) a)
      (partialLaw U (Functions.product f g) i a)
      (Product.partial (apply i f) (apply i g) (partialLaw U f i) (partialLaw U g i) a));
