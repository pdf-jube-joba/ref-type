\import \parent.\parent.Properties[] \as Properties;
\import \parent.\parent.\parent.C1[].At[U := U, f := f, g := \fun (i: Coordinate) => Partials.partial U f i, a := a] \as Construction;
\definition law: Analysis.HasDifferentialAt U f a (value U f a) := Construction.differentiable
  (\fun (i: Coordinate) => Partials.partialLaw U f i)
  (\fun (i: Coordinate) => Properties.continuous U (Partials.partial U f i) (Partials.partialSmooth U f i) a);
