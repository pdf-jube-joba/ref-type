\import \parent.\parent.Algebra[U := U] \as Functions;
\import \parent.\parent.\parent.Analysis[].Operations[] \as Operations;
\import \parent.\parent.\parent.Analysis[].Properties[] \as Differentiation;
\import real.Analysis[].Algebra[] \as RealAlgebra;
\import linear_algebra.Field[].Space[K := Real, field := RealAlgebra.field] \as Linear;
\import Linear.Linear[V := Functions.Function, W := Functions.Function, source := Functions.vectorSpace, target := Functions.vectorSpace] \as Maps;
\definition apply(i: Coordinate)(f: Functions.Function): Functions.Function := derivative U f i;
\definition addition: \forall (i: Coordinate)(f, g: Functions.Function) -> apply i (Functions.plus f g) = Functions.plus (apply i f) (apply i g) :=
  \fun (i: _)(f, g: _) => Functions.ext (apply i (Functions.plus f g)) (Functions.plus (apply i f) (apply i g))
    (\fun (a: Carrier U) => Differentiation.partialUnique U (Functions.plus f g) i a
      (apply i (Functions.plus f g) a) (Functions.plus (apply i f) (apply i g) a)
      (partialLaw U (Functions.plus f g) i a)
      (Operations.addPartial U f g (apply i f) (apply i g) i (partialLaw U f i) (partialLaw U g i) a));
\definition scalar: \forall (i: Coordinate)(c: Real)(f: Functions.Function) -> apply i (Functions.scale c f) = Functions.scale c (apply i f) :=
  \fun (i: _)(c: _)(f: _) => Functions.ext (apply i (Functions.scale c f)) (Functions.scale c (apply i f))
    (\fun (a: Carrier U) => Differentiation.partialUnique U (Functions.scale c f) i a
      (apply i (Functions.scale c f) a) (Functions.scale c (apply i f) a)
      (partialLaw U (Functions.scale c f) i a)
      (\parent.\parent.\parent.Analysis[].Scale[U := U, f := f, i := i].partial c (apply i f) (partialLaw U f i) a));
\definition map(i: Coordinate): Maps.Map := Maps.Map {
  apply := apply i, preservesAdd := addition i, preservesScale := scalar i,
};
\module Product(f, g: Functions.Function, i: Coordinate);
\definition product: \forall (i: Coordinate)(f, g: Functions.Function) ->
  apply i (Functions.product f g) = Functions.plus (Functions.product (apply i f) g) (Functions.product f (apply i g)) :=
  \fun (i: Coordinate)(f, g: Functions.Function) => Product[f := f, g := g, i := i].law;
\definition constant: \forall (i: Coordinate)(c: Real) -> apply i (Functions.constant c) = Functions.origin :=
  \fun (i: Coordinate)(c: Real) => Functions.ext (apply i (Functions.constant c)) Functions.origin
    (\fun (a: Carrier U) => Differentiation.partialUnique U (Functions.constant c) i a (apply i (Functions.constant c) a) zero
      (partialLaw U (Functions.constant c) i a) (Operations.constantPartial U c i a));
