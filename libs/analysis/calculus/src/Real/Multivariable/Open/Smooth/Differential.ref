\import \parent.Derivative[] \as Partials;
\import \parent.\parent.\parent.Space[].Linear[] \as Linear;
\definition coefficients(U: OpenSet)(f: Partials.Function U)(a: Carrier U): Point :=
  \fun (i: Coordinate) => Partials.partial U f i a;
\definition value(U: OpenSet)(f: Partials.Function U)(a: Carrier U): Differentials.LinearMap :=
  Linear.functional (coefficients U f a);
\module At(U: OpenSet, f: Partials.Function U, a: Carrier U);
\definition law: \forall (U: OpenSet)(f: Partials.Function U)(a: Carrier U) -> Analysis.HasDifferentialAt U f a (value U f a) :=
  \fun (U: OpenSet)(f: Partials.Function U)(a: Carrier U) => At[U := U, f := f, a := a].law;
\module Operations(U: OpenSet);
