\import \parent.\parent.Increment[U := U, f := f, g := g i, a := a, x := x, i := i] \as Increment;
\definition error: Increment.Error zero = increments i := trans!{Real} _ _ _
  (congr!{Real Real} (sub (increments i)) _ _ (Laws.fieldMulZeroLeft (sub (x i) (a i)))) (Laws.subZeroRight (increments i));
\definition estimate[rho, theta: Real]: BallInside[U.points, a, rho] -> R.Lt radius rho -> R.Le zero theta -> Analysis.HasPartialDerivative U f i (g i) ->
  (\forall (p: Carrier U) -> R.Le (Coordinates.pointDistance p a) radius -> R.Le (distance (g i p) zero) theta) ->
  R.Le (distance (increments i) zero) (mul theta radius) :=
  \fun (ball: _)(near: _)(nonnegative: _)(partial: _)(bounded: _) => R.leReplaceLeft (distance (Increment.Error zero) zero) (distance (increments i) zero) (mul theta radius)
    (congr!{Real Real} (\fun (v: Real) => distance v zero) _ _ error) (Increment.estimate rho zero theta ball near nonnegative partial bounded);
