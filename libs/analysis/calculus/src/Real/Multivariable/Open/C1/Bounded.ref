\use std.Logic[].Equality[].eq_reason_in;
\import std.Set[].Extension[A := Point, B := Real, domain := U.points] \as Extension;
\import real.Analysis[].Algebra[] \as Algebra;
\use Equality.congr;
\definition count: Real := Sums.sum n (\fun (i: Coordinate) => one);
\definition countNonnegative: R.Le zero count := Sums.nonnegative n (\fun (i: Coordinate) => one) (\fun (i: Coordinate) => Laws.oneNonnegative);
\definition extended[p: Point]: Real := Extension.extend f zero p;
\definition path[k: N.Nat^]: Real := extended (Staircase.point a x k);
\definition increments[i: Coordinate]: Real := sub (path (N.Nat^::succ (Fin.value n i))) (path (Fin.value n i));
\definition radius: Real := Coordinates.pointDistance x a;
\definition sumIncrements: Sums.sum n increments = sub (f x) (f a) := trans!{Real} _ _ _ (Sums.telescoping n path)
  (congr!{Real Real Real} sub _ _ _ _
    (trans!{Real} _ _ _ (congr!{Point Real} extended _ _ (Staircase.final a x)) (Extension.inside f zero x))
    (trans!{Real} _ _ _ (congr!{Point Real} extended _ _ (Staircase.initial a x)) (Extension.inside f zero a)));
\module Coordinate(i: Coordinate);
\definition sumConstant[c: Real]: Sums.sum n (\fun (i: Coordinate) => c) = mul count c := eq_reason_in!{Real _
  "=" _ "by" { Sums.congruent n (\fun (i: Coordinate) => c) (\fun (i: Coordinate) => mul c one) (\fun (i: Coordinate) => sym!{Real} _ _ (Algebra.mulOneRight c)) }
  "=" _ "by" { Sums.scalar n c (\fun (i: Coordinate) => one) }
  "=" _ "by" { Laws.fieldMulComm c count }
};
\definition estimate[rho, theta: Real]: BallInside[U.points, a, rho] -> R.Lt radius rho -> R.Le zero theta ->
  (\forall (i: Coordinate) -> Analysis.HasPartialDerivative U f i (g i)) ->
  (\forall (p: Carrier U)(i: Coordinate) -> R.Le (Coordinates.pointDistance p a) radius -> R.Le (distance (g i p) zero) theta) ->
  R.Le (distance (f x) (f a)) (mul (mul count theta) radius) := \block {
  \fun (ball: _)(near: _)(nonnegative: _)(partials: _)(bounded: _) \then
  \let individual: \forall (i: Coordinate) -> R.Le (distance (increments i) zero) (mul theta radius) :=
    \fun (i: Coordinate) => Coordinate[i := i].estimate rho theta ball near nonnegative (partials i) (\fun (p: Carrier U) => bounded p i) \then
  \return R.leReplace
    (distance (Sums.sum n increments) zero) (distance (f x) (f a)) (Sums.sum n (\fun (i: Coordinate) => mul theta radius)) (mul (mul count theta) radius)
    (trans!{Real} _ _ _ (congr!{Real Real} (\fun (v: Real) => distance v zero) _ _ sumIncrements) (Bounds.distanceDifference (f x) (f a)))
    (trans!{Real} _ _ _ (sumConstant (mul theta radius)) (sym!{Real} _ _ (Laws.fieldMulAssoc count theta radius)))
    (R.leTrans _ _ _ (Sums.absolute n increments)
      (Sums.comparison n (\fun (i: Coordinate) => distance (increments i) zero) (\fun (i: Coordinate) => mul theta radius) individual))
};
