\import \parent.At[U := U, f := f, g := g, a := a] \as At;
\import R.Order[] \as Order;
\definition half: Real := real.Analysis[].half;
\import topological_algebra.Euclidean[].Dimension[n := n].Norm[] \as MetricLaws;
\module Controlled(controls: At.Controls one, rho: Real);
\definition locallyLipschitz: (\forall (i: Coordinate) -> Analysis.HasPartialDerivative U f i (g i)) ->
  (\forall (i: Coordinate) -> Analysis.ContinuousAt U (g i) a) -> \exists LipschitzNeighborhood[U, f, a] := \block {
  \fun (partials: _)(continuous: _) \then
  \takefrom controls: At.Controls one \by At.chooseControls one Product.onePositive continuous \then
  \takefrom rho: \Cast[Real] ({ rho: Real \where BallInside[U.points, a, rho] }) \by U.open a (\bysub(Point, U.points, a)) \then
  \return Controlled[controls := controls, rho := rho].neighborhood (\bysub(Real, { rho: Real \where BallInside[U.points, a, rho] }, rho)) partials
};
