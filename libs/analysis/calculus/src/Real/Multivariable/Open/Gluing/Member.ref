\module At(z: Carrier (patch.domain)) {
  \definition globalPoint: Carrier U := inclusion (patch.domain) U (patch.included) z;
  \definition member: Contains patch globalPoint := \bysub(Point, (patch.domain).points, z);
  \definition selected: Contains (select globalPoint) globalPoint := \bysub(Patch, Patches globalPoint, select globalPoint);
  \import \parent.\parent.Pair[left := patch, right := select globalPoint] \as Pair;
  \definition coincide: \forall (directions: Smooth.Directions) -> NatLaws.Le (Smooth.order directions) k ->
    family select directions globalPoint = patch.derivatives directions z :=
    \fun (directions: _)(bound: _) => sym!{Real} (patch.derivatives directions z) (family select directions globalPoint)
      (Pair.compatible globalPoint member selected directions bound);
}
\definition coincide: \forall (z: Carrier (patch.domain))(directions: Smooth.Directions) -> NatLaws.Le (Smooth.order directions) k ->
  family select directions (inclusion (patch.domain) U (patch.included) z) = patch.derivatives directions z :=
  \fun (z: _)(directions: _)(bound: _) => At[z := z].coincide directions bound;
