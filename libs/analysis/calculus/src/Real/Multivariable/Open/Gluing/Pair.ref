\definition domain: OpenSet := intersection (left.domain) (right.domain);
\definition intoLeft: Included domain (left.domain) := intersectionLeft (left.domain) (right.domain);
\definition intoRight: Included domain (right.domain) := intersectionRight (left.domain) (right.domain);
\definition included: Included domain U := \fun (x: Point)(member: \In[Point] (domain.points) x) =>
  left.included x (intoLeft x member);
\definition leftFamily: Smooth.PartialFamily domain := Restriction.localFamily domain (left.domain) intoLeft (left.derivatives);
\definition rightFamily: Smooth.PartialFamily domain := Restriction.localFamily domain (right.domain) intoRight (right.derivatives);
\definition leftLaws: Smooth.ContDiffLaws[domain, restrict domain U included f, k, leftFamily] :=
  Restriction.localLaws domain (left.domain) intoLeft k (restrict (left.domain) U (left.included) f) (left.derivatives) (left.regular);
\definition rightLaws: Smooth.ContDiffLaws[domain, restrict domain U included f, k, rightFamily] :=
  Restriction.localLaws domain (right.domain) intoRight k (restrict (right.domain) U (right.included) f) (right.derivatives) (right.regular);
\definition compatible: \forall (a: Carrier U)(leftMember: Contains left a)(rightMember: Contains right a)(directions: Smooth.Directions) ->
  NatLaws.Le (Smooth.order directions) k -> jet left a leftMember directions = jet right a rightMember directions := \block {
  \fun (a: _)(leftMember: _)(rightMember: _)(directions: _)(bound: _) \then
  \let localPoint: Carrier domain := \into[Point](a, domain.points) \by { Logic.And[_, _]::# leftMember rightMember } \then
  \return Properties.partialFamilyUnique domain (restrict domain U included f) k leftFamily rightFamily
    (leftLaws.partials) (rightLaws.partials) directions bound localPoint
};
