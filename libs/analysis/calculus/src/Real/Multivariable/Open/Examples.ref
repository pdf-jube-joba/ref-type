\import \parent.Restriction[] \as Restriction;
\import \parent.Smooth[] \as Smooth;
\import \parent.\parent.Space[].Def[] \as Space;
\import \parent.\parent.Smooth[].Prop[] \as Global;
\definition constantSmooth: \forall (U: OpenSet)(c: Real) -> Smooth.SmoothOn U (\fun (x: Carrier U) => c) :=
  \fun (U: _)(c: _) => Restriction.smooth U (Space.constantFunction c) (Global.constantSmooth c);
\definition projectionSmooth: \forall (U: OpenSet)(i: Coordinate) -> Smooth.SmoothOn U (\fun (x: Carrier U) => x i) :=
  \fun (U: _)(i: _) => Restriction.smooth U (Space.projection i) (Global.projectionSmooth i);
