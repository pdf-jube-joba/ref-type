\import \parent.Analysis[] \as Analysis;
\definition Directions: \Set := Lists.List[Coordinate];
\definition PartialFamily(U: OpenSet): \Set := Directions -> ScalarFunction U;
\definition order(directions: Directions): N.Nat^ := Lists.length Coordinate directions;

\structure PartialFamilyLaws[U: OpenSet, f: ScalarFunction U, k: N.Nat^, derivatives: PartialFamily U]: \Prop {
  function: derivatives Directions::nil = f,
  derivative: \forall (directions: Directions) -> NatLaws.Lt (order directions) k ->
    \forall (i: Coordinate) -> Analysis.HasPartialDerivative U (derivatives directions) i (derivatives (Directions::cons i directions)),
}
\structure ContDiffLaws[U: OpenSet, f: ScalarFunction U, k: N.Nat^, derivatives: PartialFamily U]: \Prop {
  partials: PartialFamilyLaws[U, f, k, derivatives],
  continuous: \forall (directions: Directions) -> NatLaws.Le (order directions) k -> Analysis.ContinuousOn U (derivatives directions),
}
\definition ContDiffOn(U: OpenSet)(k: N.Nat^)(f: ScalarFunction U): \Prop :=
  \exists { derivatives: PartialFamily U \where ContDiffLaws[U, f, k, derivatives] };
\definition SmoothOn(U: OpenSet)(f: ScalarFunction U): \Prop := \forall (k: N.Nat^) -> ContDiffOn U k f;
\module Properties;
\module Derivative;
\module Operations;
\module Product(U: OpenSet, left, right: PartialFamily U);
\module Algebra(U: OpenSet);
\module Differential;
\module Successor(U: OpenSet, f: ScalarFunction U, g: Coordinate -> ScalarFunction U, k: N.Nat^);
\module Sums;
\definition SmoothFunction(U: OpenSet): \Set := \Cast[ScalarFunction U] ({ f: ScalarFunction U \where SmoothOn U f });
\module Schwarz(U: OpenSet, f: SmoothFunction U, a: Carrier U, i, j: Coordinate);
\module Mixed;
