\import \parent.Analysis[] \as Local;
\import \parent.Smooth[] \as Smooth;
\import \parent.\parent.Space[].Def[] \as Space;
\import \parent.\parent.Space[].Prop[] \as SpaceLaws;
\import \parent.\parent.Partial[].Def[] \as Partial;
\import \parent.\parent.Smooth[].Def[] \as GlobalSmooth;
\use Equality.congr2;
\definition function[U: OpenSet][f: Function]: ScalarFunction U := \fun (x: Carrier U) => f x;
\definition continuous: \forall (U: OpenSet)(f: Function) -> Space.Continuous f -> Local.ContinuousOn U (function U f) := \block {
  \fun (U: _)(f: _)(continuous: _)(a: Carrier U)(epsilon: _)(positive: _) \then
  \takefrom delta: \Cast[Real] ({ d: Real \where Space.ContinuityControl[f, a, epsilon, d] }) \by continuous a epsilon positive \then
  \let control: Space.ContinuityControl[f, a, epsilon, delta] := \bysub(Real, { d: Real \where Space.ContinuityControl[f, a, epsilon, d] }, delta) \then
  \return Logic.existsIntro[Real, { d: Real \where Local.ContinuityControl[U, function U f, a, epsilon, d] }] delta
    (Local.ContinuityControl[U, function U f, a, epsilon, delta] {
      positive := control.positive, estimate := \fun (x: Carrier U)(near: _) => control.estimate x near,
    })
};
\definition partial: \forall (U: OpenSet)(f, derivative: Function)(i: Coordinate) -> Partial.HasPartialDerivative f i derivative ->
  Local.HasPartialDerivative U (function U f) i (function U derivative) := \block {
  \fun (U: _)(f, derivative: _)(i: _)(differentiable: _)(a: Carrier U)(epsilon: _)(positive: _) \then
  \let section: Real -> Real := Partial.section f a i \then
  \takefrom delta: \Cast[Real] ({ d: Real \where \parent.\parent.\parent.Limit[].Def[].Control[Derivative.slope section (a i), a i, derivative a, epsilon, d] })
    \by differentiable a epsilon positive \then
  \let control: \parent.\parent.\parent.Limit[].Def[].Control[Derivative.slope section (a i), a i, derivative a, epsilon, delta] :=
    \bysub(Real, { d: Real \where \parent.\parent.\parent.Limit[].Def[].Control[Derivative.slope section (a i), a i, derivative a, epsilon, d] }, delta) \then
  \return Logic.existsIntro[Real, { d: Real \where Local.PartialControl[U, function U f, a, i, derivative a, epsilon, d] }] delta
    (Local.PartialControl[U, function U f, a, i, derivative a, epsilon, delta] {
      positive := control.positive,
      estimate := \fun (t: Real)(x: Carrier U)(same: x = Coordinates.replace a i t)(different: _)(near: _) =>
        R.ltReplaceLeft (distance (Derivative.slope section (a i) t) (derivative a))
          (distance (mul (sub (f x) (f a)) (inv (sub t (a i)))) (derivative a)) epsilon
          (congr!{Real Real} (\fun (s: Real) => distance (mul s (inv (sub t (a i)))) (derivative a)) _ _
            (congr2!{Real Real Real} sub _ _ _ _
              (sym!{Real} _ _ (congr!{Point Real} f x (Coordinates.replace a i t) same))
              (congr!{Point Real} f _ _ (SpaceLaws.replaceOriginal a i))))
          (control.estimate t different near),
    })
};
\definition family[U: OpenSet][derivatives: GlobalSmooth.PartialFamily]: Smooth.PartialFamily U :=
  \fun (directions: Smooth.Directions) => function U (derivatives directions);
\definition contDiff: \forall (U: OpenSet)(k: N.Nat^)(f: Function) -> GlobalSmooth.ContDiff k f -> Smooth.ContDiffOn U k (function U f) := \block {
  \fun (U: _)(k: _)(f: _)(regular: _) \then
  \takefrom derivatives: \Cast[GlobalSmooth.PartialFamily] ({ d: GlobalSmooth.PartialFamily \where GlobalSmooth.ContDiffLaws[f, k, d] }) \by regular \then
  \let laws: GlobalSmooth.ContDiffLaws[f, k, derivatives] := \bysub(GlobalSmooth.PartialFamily,
    { d: GlobalSmooth.PartialFamily \where GlobalSmooth.ContDiffLaws[f, k, d] }, derivatives) \then
  \return Logic.existsIntro[Smooth.PartialFamily U, { d: Smooth.PartialFamily U \where Smooth.ContDiffLaws[U, function U f, k, d] }] (family U derivatives)
    (Smooth.ContDiffLaws[U, function U f, k, family U derivatives] {
        partials := Smooth.PartialFamilyLaws[U, function U f, k, family U derivatives] {
          function := congr!{Function {ScalarFunction U}} (function U) _ _ ((laws.partials).function),
          derivative := \fun (directions: Smooth.Directions)(bound: _)(i: Coordinate) =>
            partial U (derivatives directions) (derivatives (Smooth.Directions::cons i directions)) i ((laws.partials).derivative directions bound i),
        },
        continuous := \fun (directions: Smooth.Directions)(bound: _) => continuous U (derivatives directions) (laws.continuous directions bound),
      })
};
\definition smooth: \forall (U: OpenSet)(f: Function) -> GlobalSmooth.Smooth f -> Smooth.SmoothOn U (function U f) :=
  \fun (U: _)(f: _)(regular: _)(k: _) => contDiff U k f (regular k);

\definition localPartial: \forall (U, V: OpenSet)(included: Included U V)(f, df: ScalarFunction V)(i: Coordinate) ->
  Local.HasPartialDerivative V f i df -> Local.HasPartialDerivative U (restrict U V included f) i (restrict U V included df) := \block {
  \fun (U, V: _)(included: _)(f, df: _)(i: _)(derivative: _)(a: Carrier U)(epsilon: Real)(positive: _) \then
  \let b: Carrier V := inclusion U V included a \then
  \takefrom delta: \Cast[Real] ({ d: Real \where Local.PartialControl[V, f, b, i, df b, epsilon, d] }) \by derivative b epsilon positive \then
  \let control: Local.PartialControl[V, f, b, i, df b, epsilon, delta] := \bysub(Real, { d: Real \where Local.PartialControl[V, f, b, i, df b, epsilon, d] }, delta) \then
  \return Logic.existsIntro[Real, { d: Real \where Local.PartialControl[U, restrict U V included f, a, i, restrict U V included df a, epsilon, d] }] delta
    (Local.PartialControl[U, restrict U V included f, a, i, restrict U V included df a, epsilon, delta] {
        positive := control.positive,
        estimate := \fun (t: Real)(x: Carrier U)(replaced: x = Coordinates.replace a i t)(different: _)(near: _) =>
          control.estimate t (inclusion U V included x) replaced different near,
      })
};
\definition localFamily[U, V: OpenSet][included: Included U V][d: Smooth.PartialFamily V]: Smooth.PartialFamily U :=
  \fun (directions: Smooth.Directions) => restrict U V included (d directions);
\definition localContDiff: \forall (U, V: OpenSet)(included: Included U V)(k: N.Nat^)(f: ScalarFunction V) ->
  Smooth.ContDiffOn V k f -> Smooth.ContDiffOn U k (restrict U V included f) := \block {
  \fun (U, V: _)(included: _)(k: _)(f: _)(regular: _) \then
  \takefrom derivatives: \Cast[Smooth.PartialFamily V] ({ d: Smooth.PartialFamily V \where Smooth.ContDiffLaws[V, f, k, d] }) \by regular \then
  \let laws: Smooth.ContDiffLaws[V, f, k, derivatives] := \bysub(Smooth.PartialFamily V,
    { d: Smooth.PartialFamily V \where Smooth.ContDiffLaws[V, f, k, d] }, derivatives) \then
  \return Logic.existsIntro[Smooth.PartialFamily U, { d: Smooth.PartialFamily U \where Smooth.ContDiffLaws[U, restrict U V included f, k, d] }] (localFamily U V included derivatives)
    (Smooth.ContDiffLaws[U, restrict U V included f, k, localFamily U V included derivatives] {
        partials := Smooth.PartialFamilyLaws[U, restrict U V included f, k, localFamily U V included derivatives] {
          function := congr!{{ScalarFunction V} {ScalarFunction U}} (restrict U V included) _ _ ((laws.partials).function),
          derivative := \fun (directions: Smooth.Directions)(bound: _)(i: Coordinate) => localPartial U V included
            (derivatives directions) (derivatives (Smooth.Directions::cons i directions)) i ((laws.partials).derivative directions bound i),
        },
        continuous := \fun (directions: Smooth.Directions)(bound: _) => Local.restrictContinuous U V included (derivatives directions) (laws.continuous directions bound),
      })
};
\definition localSmooth: \forall (U, V: OpenSet)(included: Included U V)(f: ScalarFunction V) ->
  Smooth.SmoothOn V f -> Smooth.SmoothOn U (restrict U V included f) :=
  \fun (U, V: _)(included: _)(f: _)(regular: _)(k: _) => localContDiff U V included k f (regular k);

\definition localLaws: \forall (U, V: OpenSet)(included: Included U V)(k: N.Nat^)(f: ScalarFunction V)(derivatives: Smooth.PartialFamily V) ->
  Smooth.ContDiffLaws[V, f, k, derivatives] ->
  Smooth.ContDiffLaws[U, restrict U V included f, k, localFamily U V included derivatives] :=
  \fun (U, V: _)(included: _)(k: _)(f: _)(derivatives: _)(laws: _) =>
    Smooth.ContDiffLaws[U, restrict U V included f, k, localFamily U V included derivatives] {
      partials := Smooth.PartialFamilyLaws[U, restrict U V included f, k, localFamily U V included derivatives] {
        function := congr!{{ScalarFunction V} {ScalarFunction U}} (restrict U V included) _ _ ((laws.partials).function),
        derivative := \fun (directions: Smooth.Directions)(bound: _)(i: Coordinate) => localPartial U V included
          (derivatives directions) (derivatives (Smooth.Directions::cons i directions)) i ((laws.partials).derivative directions bound i),
      },
      continuous := \fun (directions: Smooth.Directions)(bound: _) => Local.restrictContinuous U V included (derivatives directions) (laws.continuous directions bound),
    };
