\import \parent.Analysis[] \as Analysis;
\import \parent.\parent.Space[].Staircase[] \as Staircase;
\import \parent.\parent.Space[].Linear[] \as Linear;
\import real.Analysis[].FiniteSums[] \as Sums;
\import real.Analysis[].Estimates[] \as Bounds;
\import Bounds.Product[] \as Product;
\module Increment(U: OpenSet, f, g: ScalarFunction U, a, x: Carrier U, i: Coordinate);
\module At(U: OpenSet, f: ScalarFunction U, g: Coordinate -> ScalarFunction U, a: Carrier U);
\module Bounded(U: OpenSet, f: ScalarFunction U, g: Coordinate -> ScalarFunction U, a, x: Carrier U);
\structure LipschitzNeighborhood[U: OpenSet, f: ScalarFunction U, a: Carrier U]: \Set := {
  radius: Real,
  positive: R.Lt zero radius,
  coefficient: Real,
  nonnegative: R.Le zero coefficient,
  estimate: \forall (x, y: Carrier U) -> R.Lt (Coordinates.pointDistance x a) radius -> R.Lt (Coordinates.pointDistance y a) radius ->
    R.Le (distance (f y) (f x)) (mul coefficient (Coordinates.pointDistance y x)),
};
\module Local(U: OpenSet, f: ScalarFunction U, g: Coordinate -> ScalarFunction U, a: Carrier U);
