\import \parent.\parent.Section[U := U, f := f, a := a, i := i] \as Section;
\import std.Set[].Extension[A := Point, B := Real, domain := U.points] \as Extension;
\import \parent.\parent.\parent.\parent.\parent.Derivative[].SquareRoot[] \as DerivativeRoot;
\import \parent.\parent.\parent.\parent.\parent.Derivative[].Def[] \as Derivatives;
\definition sectionPositive: \forall (t: Real) -> R.Lt zero (Section.value t) := \fun (t: Real) =>
  Extension.preserves ({ y: Real \where R.Lt zero y }) f (f a) positive (positive a) (Coordinates.replace a i t);
\definition partial: \forall (df: Real) -> HasPartialDerivativeAt U f i a df -> HasPartialDerivativeAt U value i a (mul (factor a) df) :=
  \fun (df: Real)(law: _) => Operations.sectionPartial U value a i (\fun (t: Real) => Root.sqrt (Section.value t)) (mul (factor a) df)
    (congr!{Real Real} Root.sqrt _ _ Section.center)
    (\fun (t: Real)(x: Carrier U)(replaced: _) => congr!{Real Real} Root.sqrt _ _ (Section.agreement t x replaced))
    (\idelim mul (DerivativeRoot.factor Section.value (a i)) df = mul (factor a) df
      \with e: Real => Derivatives.HasDerivativeAt (\fun (t: Real) => Root.sqrt (Section.value t)) (a i) e \by {
        base: DerivativeRoot.derivative Section.value sectionPositive (a i) df (Section.derivative df law),
        equality: congr!{Real Real} (\fun (c: Real) => mul (mul (mul RealAnalysis.half (Root.sqrt c)) (inv c)) df) _ _ Section.center
      });
