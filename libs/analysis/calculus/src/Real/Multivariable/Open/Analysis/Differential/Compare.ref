\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Properties[] \as Properties;
\import \parent.\parent.Differential[U := U, f := f, a := a, d := e] \as Other;
\definition bases: HasDifferentialAt U f a d -> HasDifferentialAt U f a e -> \forall (i: Coordinate) ->
  d.apply (Coordinates.basis i) = e.apply (Coordinates.basis i) :=
  \fun (left: HasDifferentialAt U f a d)(right: HasDifferentialAt U f a e)(i: Coordinate) => Properties.partialUnique U f i a
    (d.apply (Coordinates.basis i)) (e.apply (Coordinates.basis i)) (\parent.Partial[i := i].law left) (Other.Partial[i := i].law right);
\definition law: HasDifferentialAt U f a d -> HasDifferentialAt U f a e -> d = e := \block {
  \fun (left: HasDifferentialAt U f a d)(right: HasDifferentialAt U f a e) \then
  \let coefficients: Linear.coefficients d = Linear.coefficients e := \axiom:funext(Linear.coefficients d, Linear.coefficients e, bases left right) \then
  \return Linear.ext d e (\axiom:funext((d.apply), (e.apply), \fun (x: Point) => eq_reason_in!{Real _
    "=" _ "by" { Linear.representation d x }
    "=" _ "by" { congr!{Point Real} (\fun (c: Point) => Linear.pairing c x) _ _ coefficients }
    "=" _ "by" { sym!{Real} _ _ (Linear.representation e x) }
  }))
};
