\import \parent.\parent.\parent.Space[].Prop[] \as SpaceLaws;
\import \parent.\parent.\parent.Space[].Linear[] \as Linear;
\import real.Analysis[].Algebra[] \as Algebra;
\import real.Analysis[].Estimates[] \as Bounds;
\import Bounds.Product[] \as Product;
\import Product.Quotient[] \as Quotient;
\import R.Order[] \as Order;
\definition apply(i: Coordinate): Real := #apply{d} (Coordinates.basis i);
\module Partial(i: Coordinate);
\module Compare(e: Differentials.LinearMap);
\definition uniqueness: \forall (e: Differentials.LinearMap) -> HasDifferentialAt U f a d -> HasDifferentialAt U f a e -> d = e :=
  \fun (e: Differentials.LinearMap)(left: _)(right: _) => Compare[e := e].law left right;
