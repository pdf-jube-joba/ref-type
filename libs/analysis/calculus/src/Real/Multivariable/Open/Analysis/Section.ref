\import std.Set[].Extension[A := Point, B := Real, domain := U.points] \as Extension;
\import \parent.\parent.\parent.\parent.Derivative[].Def[] \as Derivatives;
\import \parent.\parent.\parent.\parent.Limit[].Def[] \as Limits;
\import \parent.\parent.\parent.Space[].Prop[] \as SpaceLaws;
\import real.Analysis[].Estimates[].Product[] \as Product;
\use Equality.congr;
\definition value[t: Real]: Real := Extension.extend f (f a) (Coordinates.replace a i t);
\definition center: value (a i) = f a := trans!{Real} (value (a i)) (Extension.extend f (f a) a) (f a)
  (congr!{Point Real} (Extension.extend f (f a)) (Coordinates.replace a i (a i)) a (SpaceLaws.replaceOriginal a i))
  (Extension.inside f (f a) a);
\definition agreement: \forall (t: Real)(x: Carrier U) -> x = Coordinates.replace a i t -> value t = f x :=
  \fun (t: _)(x: _)(replaced: _) => trans!{Real} (value t) (Extension.extend f (f a) x) (f x)
    (congr!{Point Real} (Extension.extend f (f a)) (Coordinates.replace a i t) x (sym!{Point} x (Coordinates.replace a i t) replaced))
    (Extension.inside f (f a) x);
\definition slopeAgreement: \forall (t: Real)(x: Carrier U) -> x = Coordinates.replace a i t ->
  Derivatives.slope value (a i) t = mul (sub (f x) (f a)) (inv (sub t (a i))) :=
  \fun (t: _)(x: _)(replaced: _) => congr!{Real Real} (\fun (s: Real) => mul s (inv (sub t (a i))))
    (sub (value t) (value (a i))) (sub (f x) (f a))
    (congr!{Real Real Real} sub (value t) (f x) (value (a i)) (f a) (agreement t x replaced) center);
\definition derivative: \forall (d: Real) -> HasPartialDerivativeAt U f i a d -> Derivatives.HasDerivativeAt value (a i) d := \block {
  \fun (d: _)(partial: _)(epsilon: Real)(positive: _) \then
  \takefrom rho: \Cast[Real] ({ r: Real \where BallInside[U.points, a, r] }) \by U.open a (\bysub(Point, U.points, a)) \then
  \let ball: BallInside[U.points, a, rho] := \bysub(Real, { r: Real \where BallInside[U.points, a, r] }, rho) \then
  \takefrom delta: \Cast[Real] ({ r: Real \where PartialControl[U, f, a, i, d, epsilon, r] }) \by partial epsilon positive \then
  \let control: PartialControl[U, f, a, i, d, epsilon, delta] := \bysub(Real, { r: Real \where PartialControl[U, f, a, i, d, epsilon, r] }, delta) \then
  \return Logic.existsIntro[Real, { r: Real \where Limits.Control[Derivatives.slope value (a i), a i, d, epsilon, r] }] (Metric.min rho delta)
    (Limits.Control[Derivatives.slope value (a i), a i, d, epsilon, Metric.min rho delta] {
        positive := Product.minPositive rho delta (ball.positive) (control.positive),
        estimate := \block {
          \fun (t: Real)(different: _)(near: _) \then
          \let x: Carrier U := \into[Point](Coordinates.replace a i t, U.points) \by {
            ball.included (Coordinates.replace a i t)
              (R.ltReplaceLeft (distance t (a i)) (Coordinates.pointDistance (Coordinates.replace a i t) a) rho
                (sym!{Real} (Coordinates.pointDistance (Coordinates.replace a i t) a) (distance t (a i)) (SpaceLaws.replaceDistance a i t))
                (R.ltLeTrans _ _ _ near (Metric.minLeft rho delta)))
          } \then
          \return R.ltReplaceLeft (distance (mul (sub (f x) (f a)) (inv (sub t (a i)))) d) (distance (Derivatives.slope value (a i) t) d) epsilon
            (sym!{Real} (distance (Derivatives.slope value (a i) t) d) (distance (mul (sub (f x) (f a)) (inv (sub t (a i)))) d)
              (congr!{Real Real} (\fun (s: Real) => distance s d) (Derivatives.slope value (a i) t) (mul (sub (f x) (f a)) (inv (sub t (a i))))
                (slopeAgreement t x (\refl(Coordinates.replace a i t)))))
            (control.estimate t x (\refl(Coordinates.replace a i t)) different (R.ltLeTrans _ _ _ near (Metric.minRight rho delta)))
        },
      })
};
\definition derivativeAt: \forall (t: Real)(x: Carrier U)(d: Real) -> x = Coordinates.replace a i t ->
  HasPartialDerivativeAt U f i x d -> Derivatives.HasDerivativeAt value t d := \block {
  \fun (t: Real)(x: Carrier U)(d: Real)(replaced: x = Coordinates.replace a i t)(partial: _)(epsilon: Real)(positive: _) \then
  \let coordinate: x i = t := trans!{Real} _ _ _ (congr!{Point Real} (\fun (p: Point) => p i) _ _ replaced) (SpaceLaws.replaceSame a i t) \then
  \takefrom rho: \Cast[Real] ({ r: Real \where BallInside[U.points, x, r] }) \by U.open x (\bysub(Point, U.points, x)) \then
  \let ball: BallInside[U.points, x, rho] := \bysub(Real, { r: Real \where BallInside[U.points, x, r] }, rho) \then
  \takefrom delta: \Cast[Real] ({ r: Real \where PartialControl[U, f, x, i, d, epsilon, r] }) \by partial epsilon positive \then
  \let control: PartialControl[U, f, x, i, d, epsilon, delta] := \bysub(Real, { r: Real \where PartialControl[U, f, x, i, d, epsilon, r] }, delta) \then
  \return Logic.existsIntro[Real, { r: Real \where Limits.Control[Derivatives.slope value t, t, d, epsilon, r] }] (Metric.min rho delta)
    (Limits.Control[Derivatives.slope value t, t, d, epsilon, Metric.min rho delta] {
        positive := Product.minPositive rho delta (ball.positive) (control.positive),
        estimate := \block {
          \fun (s: Real)(different: _)(near: _) \then
          \let coordinateNear: R.Lt (distance s (x i)) (Metric.min rho delta) :=
            R.ltReplaceLeft (distance s t) (distance s (x i)) _ (sym!{Real} _ _ (congr!{Real Real} (distance s) _ _ coordinate)) near \then
          \let y: Carrier U := \into[Point](Coordinates.replace x i s, U.points) \by {
            ball.included (Coordinates.replace x i s)
              (R.ltReplaceLeft (distance s (x i)) (Coordinates.pointDistance (Coordinates.replace x i s) x) rho
                (sym!{Real} _ _ (SpaceLaws.replaceDistance x i s))
                (R.ltLeTrans _ _ _ coordinateNear (Metric.minLeft rho delta)))
          } \then
          \let onCurve: y = Coordinates.replace a i s := trans!{Point} _ _ _
            (congr!{Point Point} (\fun (p: Point) => Coordinates.replace p i s) _ _ replaced) (SpaceLaws.replaceTwice a i t s) \then
          \let sameSlope: Derivatives.slope value t s = mul (sub (f y) (f x)) (inv (sub s (x i))) :=
            congr!{Real Real Real} mul _ _ _ _
              (congr!{Real Real Real} sub _ _ _ _ (agreement s y onCurve) (agreement t x replaced))
              (congr!{Real Real} (\fun (r: Real) => inv (sub s r)) _ _ (sym!{Real} _ _ coordinate)) \then
          \return R.ltReplaceLeft (distance (mul (sub (f y) (f x)) (inv (sub s (x i)))) d) (distance (Derivatives.slope value t s) d) epsilon
            (sym!{Real} _ _ (congr!{Real Real} (\fun (r: Real) => distance r d) _ _ sameSlope))
            (control.estimate s y (\refl(Coordinates.replace x i s))
              (\fun (equal: s = x i) => different (trans!{Real} _ _ _ equal coordinate))
              (R.ltLeTrans _ _ _ coordinateNear (Metric.minRight rho delta)))
        },
      })
};
\module Interval(left, right: Real);
