\import \parent.Def[] \as Def;
\import topological_algebra.Euclidean[].Dimension[n := n] \as Euclidean;
\import Euclidean.Norm[] \as Shared;
\import real.Analysis[] \as Analysis;
\import Analysis.Estimates[] \as Estimates;
\import Estimates.Product[] \as Product;

\definition finiteNonnegative: \forall (m: N.Nat^)(x: Fin.Fin m -> Real) -> R.Le zero (Def.finiteMax m x) := Shared.finiteNonnegative;

\definition finiteUpper: \forall (m: N.Nat^)(x: Fin.Fin m -> Real)(r: Real) ->
  R.Le zero r -> (\forall (i: Fin.Fin m) -> R.Le (distance (x i) zero) r) ->
  R.Le (Def.finiteMax m x) r := Shared.finiteUpper;

\definition finiteCoordinate: \forall (m: N.Nat^)(x: Fin.Fin m -> Real)(i: Fin.Fin m) ->
  R.Le (distance (x i) zero) (Def.finiteMax m x) := Shared.finiteCoordinate;

\definition nonnegative: \forall (x: Point) -> R.Le zero (Def.norm x) := Shared.nonnegative;

\definition coordinate: \forall (x: Point)(i: Coordinate) -> R.Le (distance (x i) zero) (Def.norm x) := Shared.coordinate;

\definition normZero: Def.norm Def.origin = zero := Shared.normZero;

\definition separated: \forall (x: Point) -> Def.norm x = zero -> x = Def.origin := Shared.separated;

\definition triangle: \forall (x, y: Point) ->
  R.Le (Def.norm (Def.addPoint x y)) (add (Def.norm x) (Def.norm y)) := Shared.triangle;

\definition scalarCoordinate: \forall (c, x: Real) ->
  distance (mul c x) zero = mul (Product.abs c) (distance x zero) := Shared.scalarCoordinate;

\definition finiteScale: \forall (m: N.Nat^)(c: Real)(x: Fin.Fin m -> Real) ->
  Def.finiteMax m (\fun (i: Fin.Fin m) => mul c (x i)) = mul (Product.abs c) (Def.finiteMax m x) := Shared.finiteScale;

\definition homogeneous: \forall (c: Real)(x: Point) -> Def.norm (Def.scale c x) = mul (Product.abs c) (Def.norm x) := Shared.homogeneous;
\definition coordinateDistance: \forall (x, y: Point)(i: Coordinate) -> R.Le (distance (x i) (y i)) (Def.pointDistance x y) := Shared.coordinateDistance;
\definition distanceDifference: \forall (x, y: Real) -> distance (sub x y) zero = distance x y := Shared.distanceDifference;
