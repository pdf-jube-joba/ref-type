\definition origin: Point := \fun (i: _) => zero;
\definition addPoint(x, y: Point): Point := \fun (i: _) => add (x i) (y i);
\definition subPoint(x, y: Point): Point := \fun (i: _) => sub (x i) (y i);
\definition scale(c: Real) (x: Point): Point := \fun (i: _) => mul c (x i);

\definition replace(x: Point) (i: Coordinate) (t: Real): Point :=
  \fun (j: _) => Bool.ite Real (NatOp.eqb (Fin.value n j) (Fin.value n i)) t (x j);

\definition basis(i: Coordinate): Point := replace origin i one;
\definition constantFunction(c: Real): Function := \fun (x: _) => c;
\definition projection(i: Coordinate): Function := \fun (x: _) => x i;

\import topological_algebra.Euclidean[].Dimension[n := n] \as Euclidean;
\import Euclidean.Def[] \as Shared;
\definition finiteMax: \forall (m: N.Nat^) -> (Fin.Fin m -> Real) -> Real := Shared.finiteMax;
\definition norm(x: Point): Real := Shared.norm x;
\definition pointDistance(x, y: Point): Real := Shared.pointDistance x y;

\structure ContinuityControl[f: Function, a: Point, epsilon, delta: Real]: \Prop {
  positive: R.Lt zero delta,
  estimate: \forall (x: Point) -> R.Lt (pointDistance x a) delta ->
    R.Lt (distance (f x) (f a)) epsilon,
}

\definition ContinuousAt(f: Function) (a: Point): \Prop :=
  \forall (epsilon: Real) -> R.Lt zero epsilon ->
    \exists { delta: Real \where ContinuityControl[f, a, epsilon, delta] };

\definition Continuous(f: Function): \Prop := \forall (a: Point) -> ContinuousAt f a;
