\structure LinearData: \Set {
  apply: Point -> Real,
}
\structure LinearLaws[data: LinearData]: \Prop {
  additive: \forall (x, y: Point) -> data.apply (Space.addPoint x y) = add (data.apply x) (data.apply y),
  homogeneous: \forall (c: Real)(x: Point) -> data.apply (Space.scale c x) = mul c (data.apply x),
}
\definition LinearMap: \Set := \Cast[LinearData] ({ data: LinearData \where LinearLaws[data] });

\definition remainder(f: Function) (a: Point) (differential: LinearMap) (h: Point): Real :=
  sub (sub (f (Space.addPoint a h)) (f a)) (#apply{differential} h);

\structure DifferentialControl[f: Function, a: Point, differential: LinearMap, epsilon, delta: Real]: \Prop {
  positive: R.Lt zero delta,
  estimate: \forall (h: Point) -> R.Lt zero (Space.norm h) -> R.Lt (Space.norm h) delta ->
    R.Lt (distance (remainder f a differential h) zero) (mul epsilon (Space.norm h)),
}

\definition HasDifferentialAt(f: Function) (a: Point) (differential: LinearMap): \Prop :=
  \forall (epsilon: Real) -> R.Lt zero epsilon ->
    \exists { delta: Real \where DifferentialControl[f, a, differential, epsilon, delta] };

\definition DifferentiableAt(f: Function) (a: Point): \Prop :=
  \exists { differential: LinearMap \where HasDifferentialAt f a differential };

\definition HasDifferential(f: Function) (differential: Point -> LinearMap): \Prop :=
  \forall (a: Point) -> HasDifferentialAt f a (differential a);

\structure DifferentiableFunction: \Set {
  function: Function,
  differential: Point -> LinearMap,
  differentiable: HasDifferential function differential,
}
