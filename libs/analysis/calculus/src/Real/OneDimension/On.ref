\use std.Logic[].Equality[].eq_reason_in;
\import Open.Analysis[] \as Analysis;
\import Model.Space[].Def[] \as Coordinates;
\definition lift[f: Real -> Real]: Open.ScalarFunction U := \fun (x: Open.Carrier U) => f (x index);
\definition coordinate[a, x: Open.Carrier U][j: Index][t: Real]: x = Coordinates.replace a j t -> x index = t :=
  \fun (replaced: _) => eq_reason_in!{Real _
    "=" _ "by" { congr!{Index Real} x _ _ (sym!{Index} _ _ (Fin.singletonValue j)) }
    "=" _ "by" { congr!{Model.Point Real} (\fun (p: Model.Point) => p j) _ _ replaced }
    "=" _ "by" { SpaceLaws.replaceSame a j t }
  };
\definition partialAt[f: Real -> Real][a: Open.Carrier U][d: Real]: Derivatives.HasDerivativeAt f (a index) d ->
  \forall (j: Index) -> Analysis.HasPartialDerivativeAt U (lift f) j a d := \block {
  \fun (derivative: _)(j: Index)(epsilon: Real)(positive: _) \then
  \let same: a j = a index := congr!{Index Real} a _ _ (Fin.singletonValue j) \then
  \takefrom delta: \Cast[Real] ({ delta: Real \where Limits.Control[Derivatives.slope f (a index), a index, d, epsilon, delta] }) \by derivative epsilon positive \then
  \let control: Limits.Control[Derivatives.slope f (a index), a index, d, epsilon, delta] :=
    \bysub(Real, { delta: Real \where Limits.Control[Derivatives.slope f (a index), a index, d, epsilon, delta] }, delta) \then
  \return Logic.existsIntro[Real, { delta: Real \where Analysis.PartialControl[U, lift f, a, j, d, epsilon, delta] }] delta
    (Analysis.PartialControl[U, lift f, a, j, d, epsilon, delta] {
      positive := control.positive,
      estimate := \fun (t: Real)(x: Open.Carrier U)(replaced: _)(different: _)(near: _) => R.ltReplaceLeft
        (distance (Derivatives.slope f (a index) t) d) (distance (mul (sub (lift f x) (lift f a)) (inv (sub t (a j)))) d) epsilon
        (congr!{Real Real} (\fun (s: Real) => distance s d) _ _ (sym!{Real} _ _
          (congr!{Real Real Real} mul _ _ _ _
            (congr!{Real Real} (\fun (s: Real) => sub (f s) (f (a index))) _ _ (coordinate a x j t replaced))
            (congr!{Real Real} (\fun (s: Real) => inv (sub t s)) _ _ same))))
        (control.estimate t (\fun (equal: t = a index) => different (trans!{Real} _ _ _ equal (sym!{Real} _ _ same)))
          (R.ltReplaceLeft (distance t (a j)) (distance t (a index)) delta (congr!{Real Real} (distance t) _ _ same) near)),
    })
};
\definition continuousAt[f: Real -> Real][a: Open.Carrier U]: Limits.ContinuousAt f (a index) -> Analysis.ContinuousAt U (lift f) a := \block {
  \fun (continuous: _)(epsilon: Real)(positive: _) \then
  \takefrom delta: \Cast[Real] ({ delta: Real \where Limits.Control[f, a index, f (a index), epsilon, delta] }) \by continuous epsilon positive \then
  \let control: Limits.Control[f, a index, f (a index), epsilon, delta] :=
    \bysub(Real, { delta: Real \where Limits.Control[f, a index, f (a index), epsilon, delta] }, delta) \then
  \return Logic.existsIntro[Real, { delta: Real \where Analysis.ContinuityControl[U, lift f, a, epsilon, delta] }] delta
    (Analysis.ContinuityControl[U, lift f, a, epsilon, delta] {
      positive := control.positive,
      estimate := \fun (x: Open.Carrier U)(near: _) => LimitOperations.continuityEstimate f (a index) epsilon delta positive control (x index)
        (R.leLtTrans _ _ _ (MetricLaws.coordinateDistance x a index) near),
    })
};
\import \parent.\parent.Derivative[].Operations[] \as DerivativeOperations;
\module Partial(f: Real -> Real, a: Open.Carrier U) {
  \import Analysis.Section[U := U, f := lift f, a := a, i := index] \as Section;
  \definition derivativeAt[d: Real]: Analysis.HasPartialDerivativeAt U (lift f) index a d -> Derivatives.HasDerivativeAt f (a index) d := \block {
    \fun (partial: _) \then
    \takefrom rho: \Cast[Real] ({ r: Real \where Open.BallInside[U.points, a, r] }) \by U.open a (\bysub(Model.Point, U.points, a)) \then
    \let ball: Open.BallInside[U.points, a, rho] := \bysub(Real, { r: Real \where Open.BallInside[U.points, a, r] }, rho) \then
    \let agrees: \forall (t: Real) -> R.Lt (distance t (a index)) rho -> Section.value t = f t := \block {
      \fun (t: Real)(near: _) \then
      \let x: Open.Carrier U := \into[Model.Point](Coordinates.replace a index t, U.points) \by {
        ball.included (Coordinates.replace a index t)
          (R.ltReplaceLeft (distance t (a index)) (Coordinates.pointDistance (Coordinates.replace a index t) a) rho
            (sym!{Real} _ _ (SpaceLaws.replaceDistance a index t)) near)
      } \then
      \return trans!{Real} _ _ _ (Section.agreement t x (\refl(Coordinates.replace a index t)))
        (congr!{Real Real} f _ _ (SpaceLaws.replaceSame a index t))
    } \then
    \return DerivativeOperations.localDerivative Section.value f (a index) d rho ball.positive agrees (Section.derivative d partial)
  };
}
\definition derivativeAt[f: Real -> Real][a: Open.Carrier U][d: Real]: Analysis.HasPartialDerivativeAt U (lift f) index a d ->
  Derivatives.HasDerivativeAt f (a index) d := Partial[f := f, a := a].derivativeAt d;
