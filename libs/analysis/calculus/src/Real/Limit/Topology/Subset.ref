\import Space.Subspace[S := S] \as Subspace;
\import topology.Topology[Carrier := \Cast[Real] S] \as Sub;
\import metric_spaces.RealFunctions[A := \Cast[Real] S] \as LocalFunctions;
\definition Carrier: \Set := \Cast[Real] S;
\definition topology: Sub.Topology := Subspace.topology Line.topology;
\structure Control[f: Real -> Real, a: Carrier, epsilon, delta: Real]: \Prop := {
  positive: R.Lt zero delta,
  estimate: \forall (x: Carrier) -> R.Lt (distance x a) delta -> R.Lt (distance (f x) (f a)) epsilon,
};
\definition ContinuousAt[f: Real -> Real][a: Carrier]: \Prop := \forall (epsilon: Real) -> R.Lt zero epsilon ->
  \exists ( delta: Real \where Control[f, a, epsilon, delta] );
\definition ContinuousOn[f: Real -> Real]: \Prop := \forall (a: Carrier) -> ContinuousAt f a;
\definition restrict[f: Real -> Real]: Carrier -> Real := \fun (x: Carrier) => f x;
\definition topologicalOfContinuous: \forall (f: Real -> Real) -> ContinuousOn f -> LocalFunctions.Continuous topology (restrict f) :=
  \fun (f: _)(continuous: _) => LocalFunctions.continuousOfLocal topology (restrict f) (\block {
    \fun (a: Carrier)(epsilon: Real)(positive: _) \then
    \takefrom delta: \Cast[Real] ({ d: Real \where Control[f, a, epsilon, d] }) \by continuous a epsilon positive \then
    \let control: Control[f, a, epsilon, delta] := \bysub(Real, { d: Real \where Control[f, a, epsilon, d] }, delta) \then
    \let neighborhood: \Pow Carrier := Subspace.Trace (Metrics.Ball RealMetric.metric a delta) \then
    \return Logic.existsIntro[\Pow Carrier, { U: \Pow Carrier \where Sub.OpenNeighborhood[topology, a, LocalFunctions.Small (restrict f) a epsilon, U] }] neighborhood
      (Sub.OpenNeighborhood[topology, a, LocalFunctions.Small (restrict f) a epsilon, neighborhood] {
          open := Subspace.traceOpen Line.topology (Metrics.Ball RealMetric.metric a delta) (MetricTopology.ballOpenIn RealMetric.metric a delta),
          contains := Metrics.ballCenter RealMetric.metric a delta (control.positive),
          within := \fun (x: Carrier)(near: _) => R.ltReplaceLeft (distance (f x) (f a)) (distance (f a) (f x)) epsilon (Metric.distanceSymmetric (f x) (f a))
            (control.estimate x (R.ltReplaceLeft (distance a x) (distance x a) delta (Metric.distanceSymmetric a x) near)),
        })
  });
\definition continuousOfGlobal: \forall (f: Real -> Real) -> Def.Continuous f -> ContinuousOn f := \block {
  \fun (f: _)(continuous: _)(a: Carrier)(epsilon: Real)(positive: _) \then
  \takefrom delta: \Cast[Real] ({ d: Real \where Def.Control[f, a, f a, epsilon, d] }) \by continuous a epsilon positive \then
  \let control: Def.Control[f, a, f a, epsilon, delta] := \bysub(Real, { d: Real \where Def.Control[f, a, f a, epsilon, d] }, delta) \then
  \return Logic.existsIntro[Real, { d: Real \where Control[f, a, epsilon, d] }] delta
    (Control[f, a, epsilon, delta] {
      positive := control.positive, estimate := \fun (x: Carrier)(near: _) => Operations.continuityEstimate f a epsilon delta positive control x near,
    })
};
\definition continuousOfTopological: \forall (f: Real -> Real) -> LocalFunctions.Continuous topology (restrict f) -> ContinuousOn f := \block {
  \fun (f: Real -> Real)(continuous: _)(a: Carrier)(epsilon: Real)(positive: _) \then
  \takefrom U: \Cast[\Pow Carrier] ({ U: \Pow Carrier \where Sub.OpenNeighborhood[topology, a, LocalFunctions.Small (restrict f) a epsilon, U] })
    \by LocalFunctions.localOfContinuous topology (restrict f) continuous a epsilon positive \then
  \let neighborhood: Sub.OpenNeighborhood[topology, a, LocalFunctions.Small (restrict f) a epsilon, U] :=
    \bysub(\Pow Carrier, { U: \Pow Carrier \where Sub.OpenNeighborhood[topology, a, LocalFunctions.Small (restrict f) a epsilon, U] }, U) \then
  \takefrom V: \Cast[\Pow Real] ({ V: \Pow Real \where Logic.And[Space.IsOpenIn Line.topology V, U = Subspace.Trace V] })
    \by Subspace.openRepresentation Line.topology U neighborhood.open \then
  \let trace: Logic.And[Space.IsOpenIn Line.topology V, U = Subspace.Trace V] :=
    \bysub(\Pow Real, { V: \Pow Real \where Logic.And[Space.IsOpenIn Line.topology V, U = Subspace.Trace V] }, V) \then
  \let contains: Space.Member V a := \idelim U = Subspace.Trace V \with W: \Pow Carrier => Sub.Member W a \by {
    base: neighborhood.contains, equality: trace.right
  } \then
  \takefrom delta: \Cast[Real] (Metrics.NeighborhoodRadius RealMetric.metric V a) \by trace.left a contains \then
  \let radius: Logic.And[R.Lt zero delta, Space.Subset (Metrics.Ball RealMetric.metric a delta) V] := \bysub(Real, Metrics.NeighborhoodRadius RealMetric.metric V a, delta) \then
  \return Logic.existsIntro[Real, { delta: Real \where Control[f, a, epsilon, delta] }] delta (Control[f, a, epsilon, delta] {
    positive := radius.left,
    estimate := \fun (x: Carrier)(near: _) => R.ltReplaceLeft (distance (f a) (f x)) (distance (f x) (f a)) epsilon (Metric.distanceSymmetric (f a) (f x))
      (neighborhood.within x (\idelim Subspace.Trace V = U \with W: \Pow Carrier => Sub.Member W x \by {
        base: radius.right x (R.ltReplaceLeft (distance x a) (distance a x) delta (Metric.distanceSymmetric x a) near), equality: sym!{\Pow Carrier} _ _ trace.right
      })),
  })
};
\module Restriction(U: \Pow Real);
