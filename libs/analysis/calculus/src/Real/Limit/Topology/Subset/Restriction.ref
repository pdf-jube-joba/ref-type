\import \parent.\parent.Subset[S := U] \as Restricted;
\definition continuous[included: \forall (x: Real) -> \In[Real] U x -> \In[Real] S x][f: Real -> Real]: ContinuousOn f -> Restricted.ContinuousOn f := \block {
  \fun (continuous: ContinuousOn f)(a: Restricted.Carrier)(epsilon: Real)(positive: _) \then
  \let source: Carrier := \into[Real](a, S) \by { included a (\bysub(Real, U, a)) } \then
  \takefrom delta: \Cast[Real] ({ delta: Real \where Control[f, source, epsilon, delta] }) \by continuous source epsilon positive \then
  \let control: Control[f, source, epsilon, delta] := \bysub(Real, { delta: Real \where Control[f, source, epsilon, delta] }, delta) \then
  \return Logic.existsIntro[Real, { delta: Real \where Restricted.Control[f, a, epsilon, delta] }] delta (Restricted.Control[f, a, epsilon, delta] {
    positive := control.positive,
    estimate := \fun (x: Restricted.Carrier)(near: _) => control.estimate (\into[Real](x, S) \by { included x (\bysub(Real, U, x)) }) near,
  })
};
