\import \parent.\parent.Frames[k := N.Nat^::zero, U := U, P := \fun (x: Open.Carrier U) => P x] \as Framed;
\definition frame: Framed.Frames := Framed.Frames {
  value := \fun (x: Open.Carrier U) => E.Resolution[].Zero[P := P x, rank := rank x].frame,
  regular := \fun (i: Fin.Fin q)(j: Fin.Fin N.Nat^::zero) => Logic.falseElim _ (Fin.zeroImpossible j (Fin.bound N.Nat^::zero j)),
};
\definition local: Local[N.Nat^::zero, U, P, a] := Local[N.Nat^::zero, U, P, a] {
  neighborhood := Neighborhood[U] { domain := U, included := \fun (x: Coordinates.Point)(inside: _) => inside },
  contains := \bysub(Coordinates.Point, U.points, a), frame := frame,
};
