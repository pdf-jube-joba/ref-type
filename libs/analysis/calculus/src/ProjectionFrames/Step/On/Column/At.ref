\import E.OnProjection[P := P (input x)] \as Projector;
\definition nonzero: \Cast[E.Vector] ({ v: E.Vector \where Order.Lt R.zero (E.squared v) }) := \into[E.Vector](column (input x),
  { v: E.Vector \where Order.Lt R.zero (E.squared v) }) \by { positive x };
\import E.Normalization[v := nonzero] \as Normalize;
\definition rootNonzero: Logic.Not (R.SquareRoot[].sqrt (squared (input x)) = R.zero) := Normalize.lengthNonzero;
\definition unit: Projector.UnitIn := Projector.UnitIn {
  vector := Normalize.normalized, norm := Normalize.unitNorm,
  fixed := trans!{{E.Vector}} _ _ _ ((P (input x)).map.preservesScale Normalize.factor (column (input x)))
    (congr!{{E.Vector} {E.Vector}} (E.space.smul Normalize.factor) _ _ ((P (input x)).idempotent (E.basis c.index))),
};
\import Projector.Unit[u := unit] \as Unit;
\definition reduced: E.Projection := Unit.reduced;
\definition rank: E.trace reduced = E.naturalCount k := Unit.traceDecrease k (rank (input x));
