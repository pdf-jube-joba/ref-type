\import E.OnProjection[P := P a] \as Center;
\module Column(c: Center.NonzeroColumn);
\definition exists: \exists Local[N.Nat^::succ k, U, P, a] := \block {
  \takefrom c: Center.NonzeroColumn \by Center.nonzeroColumn
    (Order.ltReplaceRight R.zero (E.naturalCount (N.Nat^::succ k)) (E.trace (P a)) (sym!{{R.Real}} _ _ (rank a)) (linear_algebra.Real[].Dimension[].successorPositive k)) \then
  \return Column[c := c].exists
};
