\module On(U: Open.OpenSet, P: Family U, regular: Regular U P,
  rank: \forall (x: Open.Carrier U) -> E.trace (P x) = E.naturalCount (N.Nat^::succ k), a: Open.Carrier U);
\definition exists: Previous (N.Nat^::succ k) := \fun (U: Open.OpenSet)(P: Family U)(regular: Regular U P)(rank: _)(a: Open.Carrier U) => On[U := U, P := P, regular := regular, rank := rank, a := a].exists;
