\import \root.SmoothCoordinates[d := d, q := q].On[U := U] \as Vectors;
\definition formula: \forall (i: Fin.Fin k)(j: Fin.Fin q)(x: Open.Carrier U) -> (frame.value x).coordinate.apply (E.basis j) i = E.dot ((frame.value x).value.apply (Source.basis i)) (E.basis j) :=
  \fun (i: Fin.Fin k)(j: Fin.Fin q)(x: Open.Carrier U) => trans!{{R.Real}} _ _ _
    (sym!{{R.Real}} _ _ (Source.dotBasis i ((frame.value x).coordinate.apply (E.basis j))))
    (sym!{{R.Real}} _ _ ((frame.value x).adjoint (Source.basis i) (E.basis j)));
\definition regular: Backward.Regular U (\fun (x: Open.Carrier U) => (frame.value x).coordinate) :=
  \fun (i: Fin.Fin k)(j: Fin.Fin q) => \idelim
    (\fun (x: Open.Carrier U) => E.dot ((frame.value x).value.apply (Source.basis i)) (E.basis j)) =
    (\fun (x: Open.Carrier U) => (frame.value x).coordinate.apply (E.basis j) i)
    \with f: Open.ScalarFunction U => Smooth.SmoothOn U f \by {
      base: Vectors.dot (\fun (x: Open.Carrier U) => (frame.value x).value.apply (Source.basis i)) (\fun (x: Open.Carrier U) => E.basis j)
        (Forward.evaluate U (\fun (x: Open.Carrier U) => (frame.value x).value) frame.regular (Source.basis i)) (Vectors.constant (E.basis j)),
      equality: \axiom:funext((\fun (x: Open.Carrier U) => E.dot ((frame.value x).value.apply (Source.basis i)) (E.basis j)),
        (\fun (x: Open.Carrier U) => (frame.value x).coordinate.apply (E.basis j) i), \fun (x: Open.Carrier U) => sym!{{R.Real}} _ _ (formula i j x))
    };
