\import linear_algebra.Euclidean[n := k] \as Source;
\import \root.MatrixFamily[d := d, p := k, q := q] \as Forward;
\import \root.MatrixFamily[d := d, p := q, q := k] \as Backward;
\structure Frames: \Set := {
  value: \forall (x: Open.Carrier U) -> FrameAt k (P x),
  regular: Forward.Regular U (\fun (x: Open.Carrier U) => (value x).value),
};
\module Coordinates(frame: Frames);
\definition coordinates: \forall (frame: Frames) -> Backward.Regular U (\fun (x: Open.Carrier U) => (frame.value x).coordinate) :=
  \fun (frame: Frames) => Coordinates[frame := frame].regular;
