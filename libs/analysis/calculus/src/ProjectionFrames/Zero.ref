\module On(U: Open.OpenSet, P: Family U, rank: \forall (x: Open.Carrier U) -> E.trace (P x) = E.naturalCount N.Nat^::zero, a: Open.Carrier U);
\definition exists: Previous N.Nat^::zero := \fun (U: Open.OpenSet)(P: Family U)(regular: Regular U P)(rank: _)(a: Open.Carrier U) =>
  \exact(On[U := U, P := P, rank := rank, a := a].local, Local[N.Nat^::zero, U, P, a]);
