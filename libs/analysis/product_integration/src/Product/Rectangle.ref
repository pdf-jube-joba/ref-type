\import \root.Cuts[A := Sigma.Point] \as Cuts;
\import real.Analysis[] \as Real;
\use std.Logic[].Equality[].congr;
\definition leftMeasurable: L.Measurable mu.sigma U := \bysub(\Pow A, { U: \Pow A \where L.Measurable mu.sigma U }, U);
\definition rightMeasurable: R.Measurable nu.sigma V := \bysub(\Pow B, { V: \Pow B \where R.Measurable nu.sigma V }, V);
\definition value: M.Value := M.series (\fun (i: N.Nat^) => M.series (\fun (j: N.Nat^) => Cuts.cut (Real.mul
  (\root.FiniteSpaces[A := A].On[mu := leftMeasure i].mass U leftMeasurable)
  (\root.FiniteSpaces[A := B].On[mu := rightMeasure j].mass V rightMeasurable))));
\definition formula: measure.value (Sigma.rectangle U V) = value :=
  congr!{{N.Nat^ -> M.Value} M.Value} M.series _ _
    (\axiom:funext((\fun (i: N.Nat^) => (\root.Product[A := A, B := B, mu := mu, nu := nu, left := left, right := right].Row[i := i].measure).value (Sigma.rectangle U V)),
      (\fun (i: N.Nat^) => M.series (\fun (j: N.Nat^) => Cuts.cut (Real.mul
        (\root.FiniteSpaces[A := A].On[mu := leftMeasure i].mass U leftMeasurable)
        (\root.FiniteSpaces[A := B].On[mu := rightMeasure j].mass V rightMeasurable)))),
      \fun (i: N.Nat^) => congr!{{N.Nat^ -> M.Value} M.Value} M.series _ _
        (\axiom:funext((\fun (j: N.Nat^) => (\root.FiniteProduct[A := A, B := B, mu := leftMeasure i, nu := rightMeasure j].measure).value (Sigma.rectangle U V)),
          (\fun (j: N.Nat^) => Cuts.cut (Real.mul
            (\root.FiniteSpaces[A := A].On[mu := leftMeasure i].mass U leftMeasurable)
            (\root.FiniteSpaces[A := B].On[mu := rightMeasure j].mass V rightMeasurable))),
          \fun (j: N.Nat^) => \root.FiniteProduct[A := A, B := B, mu := leftMeasure i, nu := rightMeasure j].rectangle U V leftMeasurable rightMeasurable))));
