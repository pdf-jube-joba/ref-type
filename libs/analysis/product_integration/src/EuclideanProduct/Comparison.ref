\import M.Finite[mu := Push.measure] \as Finite;
\import \root.MeasureSup[A := E.Point, mu := Push.measure] \as Bounds;
\import M.ValueLaws[] \as Values;
\import E.MeasureConstruction[] \as Lebesgue;
\import \root.Finiteness[A := E.Point, mu := Push.measure] \as PF;
\import \root.Finiteness[A := E.Point, mu := Lebesgue.measure] \as LF;
\import \root.Euclidean[n := Index.total] \as Euclidean;
\import \root.Cuts[A := E.Point] \as Cuts;
\import \root.EuclideanProduct[m := m, n := n].Volumes[] \as Volumes;
\import \root.EuclideanProduct[m := m, n := n].Borel[] \as Borel;
\import euclidean_measure.EuclideanBorel[n := Index.total] \as EB;
\import euclidean_measure.Exhaustion[n := Index.total] \as Exhaustion;
\import euclidean_measure.BoxCompact[n := Index.total] \as Boxes;
\import Order.Completeness[] \as Complete;
\definition domination: \forall (S: \Pow E.Point) -> M.Measurable Push.sigma S -> Values.Included (Push.measure.value S) (E.outer S) :=
  \fun (S: \Pow E.Point) (valid: M.Measurable Push.sigma S) => E.greatestLowerBound S (Push.measure.value S) (Finite.laws.nonnegative S valid)
    (\fun (family: N.Nat^ -> E.Box) (cover: E.Covers family S) (r: Real.Real) (member: M.below (Push.measure.value S) r) =>
      \idelim M.series (\fun (k: N.Nat^) => Push.measure.value (E.points (family k))) = E.cost family
        \with v: M.Value => M.below v r \by {
          base: Bounds.unionBound (\fun (k: N.Nat^) => E.points (family k)) (\fun (k: N.Nat^) => boxMeasurable (family k)) r
            (Finite.monotone S (M.union (\fun (k: N.Nat^) => E.points (family k))) valid
              ((MS.laws Push.sigma).countableUnion (\fun (k: N.Nat^) => E.points (family k)) (\fun (k: N.Nat^) => boxMeasurable (family k))) cover r member),
          equality: congr!{{N.Nat^ -> M.Value} M.Value} M.series _ _ (\axiom:funext(
            (\fun (k: N.Nat^) => Push.measure.value (E.points (family k))),
            (\fun (k: N.Nat^) => E.volumeValue (family k)), \fun (k: N.Nat^) => Volumes.theorem (family k))) });
\definition box[b: E.Box]: PF.FiniteMeasurableSet := \into[\Pow E.Point](E.points b, PF.FiniteMeasurableSet) \by {
  PF.FiniteSet[E.points b] {
    measurable := boxMeasurable b,
    bounded := Logic.existsIntro[Real.Real, { bound: Real.Real \where \forall (r: Real.Real) -> M.below (Push.measure.value (E.points b)) r -> Order.Le r bound }] (E.volume b)
      (\fun (r: Real.Real) (member: M.below (Push.measure.value (E.points b)) r) => Order.Order[].leOfLt r (E.volume b)
        (\idelim Push.measure.value (E.points b) = E.volumeValue b \with v: M.Value => M.below v r \by { base: member, equality: Volumes.theorem b })),
  }
};
\definition lebesgueBox[b: E.Box]: LF.FiniteMeasurableSet := \into[\Pow E.Point](E.points b, LF.FiniteMeasurableSet) \by { Euclidean.boxFinite b };
\definition massDomination: \forall (S: PF.FiniteMeasurableSet) (T: LF.FiniteMeasurableSet) -> S = T -> Order.Le (PF.mass S) (LF.mass T) :=
  \fun (S: PF.FiniteMeasurableSet) (T: LF.FiniteMeasurableSet) (equal: S = T) => (PF.massLaw S).least (LF.mass T)
    (\fun (r: Real.Real) (member: M.below (Push.measure.value S) r) => (LF.massLaw T).upper r
      (\idelim S = T \with W: \Pow E.Point => M.below (E.outer W) r \by {
        base: domination S (PF.finiteLaw S).measurable r member, equality: equal }));
\module Within(b: E.Box, S: \Pow E.Point);
\definition bounded: \forall (b: E.Box) (S: \Pow E.Point) -> M.Measurable E.Borel[].sigma S -> Sets.Subset S (E.points b) -> Push.measure.value S = E.outer S :=
  \fun (b: E.Box) (S: \Pow E.Point) (valid: M.Measurable E.Borel[].sigma S) (included: Sets.Subset S (E.points b)) =>
    \idelim Sets.Intersection (E.points b) S = S \with T: \Pow E.Point => Push.measure.value T = E.outer T \by {
      base: \root.EuclideanProduct[m := m, n := n].Comparison[].Within[b := b, S := S].theorem valid,
      equality: \axiom:setext(Sets.Intersection (E.points b) S, S,
        \fun (x: E.Point) (member: Sets.Member (Sets.Intersection (E.points b) S) x) => member.right,
        \fun (x: E.Point) (member: Sets.Member S x) => Logic.And[_, _]::# (included x member) member) };
\module Exhausted(S: \Pow E.Point);
\definition theorem: \forall (S: \Pow E.Point) -> M.Measurable E.Borel[].sigma S -> Push.measure.value S = Lebesgue.measure.value S :=
  \fun (S: \Pow E.Point) => \root.EuclideanProduct[m := m, n := n].Comparison[].Exhausted[S := S].theorem;
