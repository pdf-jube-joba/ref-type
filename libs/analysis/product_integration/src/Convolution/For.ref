\definition kernel[p: Sigma.Point]: Real.Real := Real.mul (f ((translations (Pair.second A A p)).function (Pair.first A A p))) (g (Pair.second A A p));
\structure Conditions: \Set := { measurable: PM.IsMeasurable Product.measure kernel };
\structure Result: \Set := {
  exception: I.Null[].NullSet,
  sections: A -> I.Representatives,
  sectionValues: \forall (x: A) -> Logic.Not (Sets.Member exception x) -> \forall (y: A) -> sections x y = kernel (Pair.pair A A x y),
  function: I.Representatives,
  values: \forall (x: A) -> function x = I.integral (sections x),
  exchange: I.integral function = Real.mul (I.integral f) (I.integral g),
  l1Bound: R.Le (l1 function) (Real.mul (l1 f) (l1 g)),
};
\module On(conditions: Conditions);
\definition exists: PM.IsMeasurable Product.measure kernel -> \exists Result := \fun (measurable: PM.IsMeasurable Product.measure kernel) =>
  \root.Convolution[A := A, mu := mu, exhaustion := exhaustion].For[translations := translations, f := f, g := g].On[conditions := Conditions { measurable := measurable }].exists;
\definition sumSupport[S, T: \Pow A]: \Pow A := { x: A \where \exists ( y: A \where
  Logic.And[Sets.Member T y, Sets.Member S ((translations y).function x)] ) };
\module Support(result: Result, S, T: \Pow A);
