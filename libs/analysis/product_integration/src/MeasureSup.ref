\import std.Data[].Nat[] \as N;
\import functional_analysis.Measure[A := A] \as M;
\import M.Continuity[mu := mu] \as Continuity;
\import M.Finite[mu := mu] \as Finite;
\import M.Sigma[] \as Sigma;
\import std.Logic[].Proposition[] \as Logic;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Completeness[] \as Complete;
\import \root.ScalarSup[] \as ScalarSup;
\import topology.Topology[Carrier := A] \as Sets;
\use std.Logic[].Equality[].sym;
\definition supremum: \forall (sets: N.Nat^ -> \Pow A) (sequence: N.Nat^ -> Real.Real) (v: Real.Real) ->
  (\forall (k: N.Nat^) -> M.Measurable mu.sigma (sets k)) -> Continuity.Increasing sets ->
  (\forall (k: N.Nat^) -> Complete.LeastUpperBound[mu.value (sets k), sequence k]) ->
  Complete.LeastUpperBound[mu.value (M.union sets), v] -> Complete.LeastUpperBound[ScalarSup.values sequence, v] :=
  \fun (sets: N.Nat^ -> \Pow A) (sequence: N.Nat^ -> Real.Real) (v: Real.Real)
    (valid: \forall (k: N.Nat^) -> M.Measurable mu.sigma (sets k)) (increasing: Continuity.Increasing sets)
    (laws: \forall (k: N.Nat^) -> Complete.LeastUpperBound[mu.value (sets k), sequence k])
    (limit: Complete.LeastUpperBound[mu.value (M.union sets), v]) => Complete.LeastUpperBound[ScalarSup.values sequence, v] {
      upper := \fun (r: Real.Real) (member: Complete.Member (ScalarSup.values sequence) r) => \block {
        \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where r = sequence k }) \by member \then
        \return R.leReplaceLeft (sequence k) r v (sym!{Real.Real} _ _ (\bysub(N.Nat^, { k: N.Nat^ \where r = sequence k }, k)))
          ((laws k).least v (\fun (r: Real.Real) (member: M.below (mu.value (sets k)) r) => limit.upper r
            (Finite.monotone (sets k) (M.union sets) (valid k) ((Sigma.laws mu.sigma).countableUnion sets valid)
              (\fun (x: A) (inside: Sets.Member (sets k) x) => Logic.existsIntro[N.Nat^, { j: N.Nat^ \where Sets.Member (sets j) x }] k inside) r member)))
      },
      least := \fun (b: Real.Real) (upper: Complete.UpperBound (ScalarSup.values sequence) b) => limit.least b
        (\fun (r: Real.Real) (member: M.below (mu.value (M.union sets)) r) => \block {
          \let inSup: \exists ( k: N.Nat^ \where M.below (mu.value (sets k)) r ) :=
            \idelim mu.value (M.union sets) = { r: Real.Real \where \exists ( k: N.Nat^ \where M.below (mu.value (sets k)) r ) }
              \with w: M.Value => M.below w r \by { base: member, equality: Continuity.increasingSup sets valid increasing } \then
          \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where M.below (mu.value (sets k)) r }) \by inSup \then
          \return R.leTrans r (sequence k) b ((laws k).upper r
            (\bysub(N.Nat^, { k: N.Nat^ \where M.below (mu.value (sets k)) r }, k))) (upper (sequence k) (ScalarSup.member sequence k))
        }),
    };
\import M.Integral[mu := mu].Convergence[] \as C;
\import \root.SeriesValues[A := A, mu := mu] \as Series;
\use std.Logic[].Equality[].congr;
\use std.Logic[].Equality[].eq_reason_in;
\definition unionBound: \forall (sets: N.Nat^ -> \Pow A) -> (\forall (k: N.Nat^) -> M.Measurable mu.sigma (sets k)) ->
  M.ValueLaws[].Included (mu.value (M.union sets)) (M.series (\fun (k: N.Nat^) => mu.value (sets k))) :=
  \fun (sets: N.Nat^ -> \Pow A) (valid: \forall (k: N.Nat^) -> M.Measurable mu.sigma (sets k)) (r: Real.Real) (member: M.below (mu.value (M.union sets)) r) =>
    Series.seriesMonotone (\fun (k: N.Nat^) => mu.value (Sigma.increments sets k)) (\fun (k: N.Nat^) => mu.value (sets k))
      (\fun (k: N.Nat^) => Finite.monotone (Sigma.increments sets k) (sets k) (Sigma.incrementsMeasurable mu.sigma sets valid k) (valid k)
        (\fun (x: A) (inside: Sets.Member (Sigma.increments sets k) x) => inside.left)) r
      (\idelim mu.value (M.union sets) = M.series (\fun (k: N.Nat^) => mu.value (Sigma.increments sets k)) \with v: M.Value => M.below v r \by {
        base: member, equality: eq_reason_in!{M.Value _
          "=" _ "by" { congr!{{\Pow A} M.Value} mu.value _ _ (sym!{{\Pow A}} _ _ (Sigma.incrementUnion sets)) }
          "=" _ "by" { Finite.laws.countableAdditivity (Sigma.increments sets) (Sigma.incrementsMeasurable mu.sigma sets valid) (Sigma.incrementsDisjoint sets) }
        } });
\definition valuesSupremum: \forall (values: N.Nat^ -> M.Value) (sequence: N.Nat^ -> Real.Real) (v: Real.Real) ->
  (\forall (k: N.Nat^) -> Complete.LeastUpperBound[values k, sequence k]) ->
  Complete.LeastUpperBound[C.Sup values, v] -> Complete.LeastUpperBound[ScalarSup.values sequence, v] :=
  \fun (values: N.Nat^ -> M.Value) (sequence: N.Nat^ -> Real.Real) (v: Real.Real)
    (laws: \forall (k: N.Nat^) -> Complete.LeastUpperBound[values k, sequence k]) (limit: Complete.LeastUpperBound[C.Sup values, v]) =>
    Complete.LeastUpperBound[ScalarSup.values sequence, v] {
      upper := \fun (r: Real.Real) (member: Complete.Member (ScalarSup.values sequence) r) => \block {
        \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where r = sequence k }) \by member \then
        \return R.leReplaceLeft (sequence k) r v (sym!{Real.Real} _ _ (\bysub(N.Nat^, { k: N.Nat^ \where r = sequence k }, k)))
          ((laws k).least v (\fun (r: Real.Real) (member: M.below (values k) r) => limit.upper r (C.supUpper values k r member)))
      },
      least := \fun (b: Real.Real) (upper: Complete.UpperBound (ScalarSup.values sequence) b) => limit.least b
        (\fun (r: Real.Real) (member: M.below (C.Sup values) r) => \block {
          \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where M.below (values k) r }) \by member \then
          \return R.leTrans r (sequence k) b ((laws k).upper r (\bysub(N.Nat^, { k: N.Nat^ \where M.below (values k) r }, k)))
            (upper (sequence k) (ScalarSup.member sequence k))
        }),
    };
