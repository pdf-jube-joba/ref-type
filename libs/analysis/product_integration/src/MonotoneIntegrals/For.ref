\import topology.Topology[Carrier := A] \as Sets;
\import M.Sigma[] \as Sigma;
\import M.Finite[mu := mu] \as Finite;
\import M.Continuity[mu := mu] \as Continuity;
\import M.ValueLaws[] \as Values;
\import I.Absolute[] \as Absolute;
\import I.Null[] \as Null;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import R.Order[] \as Order;
\import R.Arithmetic[].Prop[] \as Laws;
\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].congr;
\use std.Logic[].Equality[].eq_reason_in;
\definition positive[c: Scaling.PositiveScalar]: R.Lt Real.zero c := \bysub(Real.Real, { c: Real.Real \where R.Lt Real.zero c }, c);
\definition level[c: Real.Real] [k: N.Nat^]: \Pow A := { x: A \where R.Lt c (data.sequence k x) };
\module Level(c: Scaling.PositiveScalar, k: N.Nat^);
\module LevelUnion(c: Scaling.PositiveScalar);
\module Divergence;
\module Limit;
