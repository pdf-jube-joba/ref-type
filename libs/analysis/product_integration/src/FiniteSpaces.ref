\import functional_analysis.Measure[A := A] \as M;
\import topology.Topology[Carrier := A] \as Sets;
\definition Measure: \Set := \Cast[M.Measure]
  ({ mu: M.Measure \where \root.Finiteness[A := A, mu := mu].FiniteSet[Sets.Whole] });
\definition whole[mu: Measure]: \root.Finiteness[A := A, mu := mu].FiniteMeasurableSet :=
  \into[\Pow A](Sets.Whole, \root.Finiteness[A := A, mu := mu].FiniteMeasurableSet) \by {
    \bysub(M.Measure, { mu: M.Measure \where \root.Finiteness[A := A, mu := mu].FiniteSet[Sets.Whole] }, mu)
  };
\module On(mu: Measure);
