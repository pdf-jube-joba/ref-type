\import Source.Integral[mu := source] \as SI;
\import Target.Integral[mu := target] \as TI;
\import topology.Topology[Carrier := A] \as SourceSets;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].congr;
\use std.Logic[].Equality[].eq_reason_in;
\definition preimage[S: \Pow B]: \Pow A := { x: A \where TargetSets.Member S (map.function x) };
\definition measurable: \forall (f: B -> Real.Real) -> Target.IsMeasurable target f -> Source.IsMeasurable source (\fun (x: A) => f (map.function x)) :=
  \fun (f: B -> Real.Real) (valid: Target.IsMeasurable target f) (r: Real.Real) => map.measurable ({ y: B \where R.Lt r (f y) }) (valid r);
\module Simple(n: N.Nat^, s: TI.CompleteSimple[n]);
\module Nonnegative(f: TI.NonnegativeMeasurable);
\module RealFunction(f: TI.Representatives);
