\module Generated(A: \Set, generators: \Pow (\Pow A));
\module ProductSigma(A, B: \Set,
  left: functional_analysis.Measure[A := A].SigmaAlgebra,
  right: functional_analysis.Measure[A := B].SigmaAlgebra);
\module Finiteness(A: \Set, mu: functional_analysis.Measure[A := A].Measure);
\module FiniteSpaces(A: \Set);
\module Euclidean(n: std.Data[].Nat[].Nat^);
\module ScalarSup;
\module FiniteKernel(A, B: \Set,
  mu: \root.FiniteSpaces[A := A].Measure,
  nu: \root.FiniteSpaces[A := B].Measure);
\module CountableSets(A: \Set);
\module MeasureSup(A: \Set, mu: functional_analysis.Measure[A := A].Measure);
\module Cuts(A: \Set);
\module FiniteProduct(A, B: \Set, mu: \root.FiniteSpaces[A := A].Measure, nu: \root.FiniteSpaces[A := B].Measure);
\module SeriesValues(A: \Set, mu: functional_analysis.Measure[A := A].Measure);
\module MeasureSeries(A: \Set);
\module Product(A, B: \Set,
  mu: functional_analysis.Measure[A := A].Measure,
  nu: functional_analysis.Measure[A := B].Measure,
  left: \root.Finiteness[A := A, mu := mu].Exhaustion,
  right: \root.Finiteness[A := B, mu := nu].Exhaustion);
\module FiniteUniqueness(A: \Set,
  mu, nu: \root.FiniteSpaces[A := A].Measure,
  generators: \Pow (\Pow A));
\module FiniteSymmetry(A, B: \Set, mu: \root.FiniteSpaces[A := A].Measure, nu: \root.FiniteSpaces[A := B].Measure);
\module MeasureMap(A, B: \Set, source: functional_analysis.Measure[A := A].Measure, target: functional_analysis.Measure[A := B].Measure);
\module IntegralTools(A: \Set, mu: functional_analysis.Measure[A := A].Measure);
\module FiniteIntegration(A, B: \Set, mu: \root.FiniteSpaces[A := A].Measure, nu: \root.FiniteSpaces[A := B].Measure);
\module MonotoneIntegrals(A: \Set, mu: functional_analysis.Measure[A := A].Measure);
\module ExtendedIntegral(A: \Set, mu: functional_analysis.Measure[A := A].Measure);
