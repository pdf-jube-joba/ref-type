\import euclidean_measure.Euclidean[n := n] \as E;
\import \root.Euclidean[n := n] \as Euclidean;
\import E.MeasureConstruction[] \as Lebesgue;
\import functional_analysis.Measure[A := E.Point] \as M;
\import M.Integral[mu := Lebesgue.measure] \as I;
\import \root.Integration[A := E.Point, B := E.Point, mu := Lebesgue.measure, nu := Lebesgue.measure, left := Euclidean.exhaustion, right := Euclidean.exhaustion] \as Fubini;
\import \root.Product[A := E.Point, B := E.Point, mu := Lebesgue.measure, nu := Lebesgue.measure, left := Euclidean.exhaustion, right := Euclidean.exhaustion] \as Product;
\import \root.ProductSigma[A := E.Point, B := E.Point, left := Lebesgue.measure.sigma, right := Lebesgue.measure.sigma] \as Sigma;
\import functional_analysis.Measure[A := Sigma.Point].Integral[mu := Product.measure] \as Joint;
\import \root.Convolution[A := E.Point, mu := Lebesgue.measure, exhaustion := Euclidean.exhaustion] \as Convolution;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\use std.Logic[].Equality[].sym;
\definition zeroFubini: \exists Fubini.AEFubini[Joint.Zero[].representative] := Fubini.fubini Joint.Zero[].representative;
\module ZeroConvolution(g: I.Representatives);
\import \root.EuclideanProduct[m := n, n := n] \as Compare;
\definition boxComparison: \forall (b: euclidean_measure.Euclidean[n := std.Data[].Nat[].Basic[].Def[].add n n].Box) ->
  euclidean_measure.Pushforward[A := Sigma.Point, B := euclidean_measure.Euclidean[n := std.Data[].Nat[].Basic[].Def[].add n n].Point, source := Product.measure, map := Compare.join].measure.value
    (euclidean_measure.Euclidean[n := std.Data[].Nat[].Basic[].Def[].add n n].points b) = euclidean_measure.Euclidean[n := std.Data[].Nat[].Basic[].Def[].add n n].volumeValue b := Compare.Volumes[].theorem;
