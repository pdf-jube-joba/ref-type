\definition summed: M.Integral[mu := Sum.measure].NonnegativeMeasurable := M.Integral[mu := Sum.measure].NonnegativeMeasurable {
  function := f.function, measurable := f.measurable, nonnegative := f.nonnegative,
};
\definition theorem: I.lowerIntegral f.function = M.series (\fun (k: N.Nat^) => M.Integral[mu := measure k].lowerIntegral f.function) := eq_reason_in!{M.Value _
  "=" _ "by" { Map.On[map := identity].Nonnegative[f := summed].lower }
  "=" _ "by" { Series.Sum[data := family].Integral[f := summed].theorem }
};
