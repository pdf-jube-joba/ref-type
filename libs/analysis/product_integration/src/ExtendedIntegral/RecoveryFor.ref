\import real.Analysis[].Sequence[] \as Sequence;
\import functional_analysis.ScalarLimits[] \as Limits;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\module At(k: N.Nat^) {
  \import \root.ExtendedIntegral[A := A, mu := mu].Approximation[n := n, s := s, c := Recovery.shrink k, f := f] \as Approximation;
  \definition scaled: M.Value := M.sum n (\fun (i: Fin.Fin n) => M.scale (Real.mul (Recovery.shrinkValue k) (s.coefficients i)) (mu.value (s.cells i)));
  \definition bound: Covers n s f -> C.FunctionIncreasing f ->
    Values.Included scaled (C.Sup (\fun (k: N.Nat^) => I.lowerIntegral (f k))) := Approximation.scaledIntegralBound;
}
\definition coefficientConverges: \forall (i: Fin.Fin n) -> Sequence.Converges
  (\fun (k: N.Nat^) => Real.mul (Recovery.shrinkValue k) (s.coefficients i)) (s.coefficients i) :=
  \fun (i: Fin.Fin n) => \idelim Real.mul Real.one (s.coefficients i) = s.coefficients i
    \with a: Real.Real => Sequence.Converges (\fun (k: N.Nat^) => Real.mul (Recovery.shrinkValue k) (s.coefficients i)) a
    \by { base: Limits.productConverges Recovery.shrinkValue (\fun (_: N.Nat^) => s.coefficients i) Real.one (s.coefficients i)
      Recovery.shrinkConverges (Sequence.constantConverges (s.coefficients i)), equality: Laws.fieldMulOneLeft (s.coefficients i) };
\definition recovered: Recovery.Approaches (\fun (k: N.Nat^) => At[k := k].scaled) (I.simpleIntegral n s) :=
  Recovery.sumApproaches n (\fun (k: N.Nat^) (i: Fin.Fin n) => M.scale (Real.mul (Recovery.shrinkValue k) (s.coefficients i)) (mu.value (s.cells i)))
    (\fun (i: Fin.Fin n) => M.scale (s.coefficients i) (mu.value (s.cells i)))
    (\fun (i: Fin.Fin n) => Recovery.scaleApproaches (\fun (k: N.Nat^) => Real.mul (Recovery.shrinkValue k) (s.coefficients i))
      (s.coefficients i) (coefficientConverges i) (mu.value (s.cells i)));
\definition bound: Covers n s f -> C.FunctionIncreasing f ->
  Values.Included (I.simpleIntegral n s) (C.Sup (\fun (k: N.Nat^) => I.lowerIntegral (f k))) :=
  \fun (covers: Covers n s f) (increasing: C.FunctionIncreasing f)
    (r: Real.Real) (member: M.below (I.simpleIntegral n s) r) => \block {
      \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where \forall (j: N.Nat^) -> Nat.Le k j -> M.below (At[k := j].scaled) r }) \by recovered r member \then
      \let atK: M.below (At[k := k].scaled) r :=
        (\bysub(N.Nat^, { k: N.Nat^ \where \forall (j: N.Nat^) -> Nat.Le k j -> M.below (At[k := j].scaled) r }, k)) k (Nat.leRefl k) \then
      \return At[k := k].bound covers increasing r atK
    };
