\import \root.FiniteProduct[A := A, B := B, mu := Left.measure N.Nat^::zero, nu := Right.measure j] \as P;
\import \root.FiniteIntegration[A := A, B := B, mu := Left.measure N.Nat^::zero, nu := Right.measure j] \as F;
\import PM.Integral[mu := P.measure] \as J;
\definition function: J.NonnegativeMeasurable := J.NonnegativeMeasurable {
  function := f.function, measurable := f.measurable, nonnegative := f.nonnegative,
};
\definition Witnesses: \Set := F.ApproximationWitnesses function;
\definition witnessesExist: \exists Witnesses := F.approximationWitnessesExist function;
\definition lower[x: A]: RM.Value := RM.Integral[mu := Right.measure j].lowerIntegral (section x).function;
\module Approx(witnesses: Witnesses);
\module Piece(i: N.Nat^);
