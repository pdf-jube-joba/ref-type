\definition function: PM.Integral[mu := Product.Row[i := i].measure].NonnegativeMeasurable :=
  PM.Integral[mu := Product.Row[i := i].measure].NonnegativeMeasurable {
    function := f.function, measurable := f.measurable, nonnegative := f.nonnegative,
  };
\definition theorem: PM.Integral[mu := Product.Row[i := i].measure].lowerIntegral f.function = PM.series (\fun (j: N.Nat^) =>
  PM.Integral[mu := \root.FiniteProduct[A := A, B := B, mu := Left.measure i, nu := Right.measure j].measure].lowerIntegral f.function) :=
  Sums.Sum[data := Product.Row[i := i].family].Integral[f := function].theorem;
