\import \root.FiniteProduct[A := A, B := B, mu := Left.measure i, nu := Right.measure j] \as ProductPiece;
\import \root.FiniteIntegration[A := A, B := B, mu := Left.measure i, nu := Right.measure j] \as Finite;
\definition pieceFunction: PM.Integral[mu := ProductPiece.measure].NonnegativeMeasurable := PM.Integral[mu := ProductPiece.measure].NonnegativeMeasurable {
  function := f.function, measurable := f.measurable, nonnegative := f.nonnegative,
};
\definition theorem: \root.ExtendedIntegral[A := A, mu := Left.measure i].lowerIntegral lower =
  PM.Integral[mu := ProductPiece.measure].lowerIntegral f.function := sym!{PM.Value} _ _ (Finite.tonelli pieceFunction);
