\import functional_analysis.Measure[A := A] \as M;
\import M.Integral[mu := mu] \as I;
\import I.Absolute[] \as Absolute;
\import I.Scaling[] \as Scaling;
\import \root.IntegralTools[A := A, mu := mu] \as Tools;
\import \root.Integration[A := A, B := A, mu := mu, nu := mu, left := exhaustion, right := exhaustion] \as Fubini;
\import \root.Product[A := A, B := A, mu := mu, nu := mu, left := exhaustion, right := exhaustion] \as Product;
\import \root.ProductSigma[A := A, B := A, left := mu.sigma, right := mu.sigma] \as Sigma;
\import functional_analysis.Measure[A := Sigma.Point] \as PM;
\import PM.Integral[mu := Product.measure] \as PI;
\import PM.Functions[mu := Product.measure] \as JointFunctions;
\import \root.MeasureMap[A := A, B := A, source := mu, target := mu] \as Maps;
\import \root.Symmetry[A := A, B := A, mu := mu, nu := mu, left := exhaustion, right := exhaustion] \as Symmetry;
\import \root.MeasureMap[A := Sigma.Point, B := Sigma.Point, source := Product.measure, target := Product.measure] \as SwapMap;
\import \root.ExtendedIntegral[A := A, mu := mu] \as E;
\import \root.Cuts[A := A] \as Cuts;
\import \root.Cuts[A := Sigma.Point] \as JointCuts;
\import \root.IntegralTools[A := Sigma.Point, mu := Product.measure] \as JointTools;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import topology.Topology[Carrier := A] \as Sets;
\import real.Analysis[] \as Real;
\import Real.Estimates[].Product[] \as Bounds;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import R.Completeness[] \as Complete;
\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].congr;
\use std.Logic[].Equality[].eq_reason_in;
\definition l1[f: I.Representatives]: Real.Real := I.integral (Absolute.representative f);
\definition l1Nonnegative: \forall (f: I.Representatives) -> R.Le Real.zero (l1 f) := \fun (f: I.Representatives) =>
  Absolute.integralNonnegative (Absolute.representative f) (l1 f) (\fun (x: A) => Bounds.absNonnegative (f x)) (I.integralLaw (Absolute.representative f));
\module For(translations: A -> Maps.Data, f, g: I.Representatives);
