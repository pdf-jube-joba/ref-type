\import euclidean_measure.Euclidean[n := n] \as E;
\import euclidean_measure.EuclideanBorel[n := n] \as B;
\import functional_analysis.Measure[A := E.Point] \as M;
\import std.Data[].FinSet[] \as Fin;
\import real.Analysis[] \as Real;
\definition above: Fin.Fin n -> Real.Real -> \Pow E.Point := B.above;
\definition below: Fin.Fin n -> Real.Real -> \Pow E.Point := B.below;
\structure Conditions: \Set := {
  above: \forall (i: Fin.Fin n) (a: Real.Real) -> M.Measurable sigma (B.above i a),
  below: \forall (i: Fin.Fin n) (a: Real.Real) -> M.Measurable sigma (B.below i a),
};
\module For(data: Conditions);
