\import functional_analysis.Measure[A := A] \as M;
\import std.Data[].Nat[] \as N;
\structure Family: \Set := {
  sigma: M.SigmaAlgebra,
  measures: N.Nat^ -> M.Measure,
  measurable: \forall (S: \Pow A) -> M.Measurable sigma S -> \forall (k: N.Nat^) -> M.Measurable (measures k).sigma S,
};
\module Sum(data: Family);
