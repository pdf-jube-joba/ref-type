\definition function: LI.Representatives := Linear.addRepresentative s.function (Negation.representative t.function);
\definition law: Sets.Subset T S -> \forall (x: A) -> Complete.LeastUpperBound[nu.value (ProductSigma.section (PS.difference S T) x), function x] :=
  \fun (included: Sets.Subset T S) (x: A) => Right.differenceSup (ProductSigma.section S x) (ProductSigma.section T x)
    (s.function x) (t.function x) (s.measurable x) (t.measurable x)
    (\fun (y: B) (member: RS.Member (ProductSigma.section T x) y) => included (Pair.pair A B x y) member) (s.law x) (t.law x);
\definition witness[included: Sets.Subset T S]: Witness[PS.difference S T] :=
  Witness[PS.difference S T] {
    measurable := \fun (x: A) => Sigma.differenceMeasurable nu.sigma (ProductSigma.section S x) (ProductSigma.section T x) (s.measurable x) (t.measurable x),
    function := function,
    law := law included,
  };
\definition integral: LI.integral function = Real.sub (LI.integral s.function) (LI.integral t.function) := eq_reason_in!{Real.Real _
  "=" _ "by" { Linear.integralAdd s.function (Negation.representative t.function) }
  "=" _ "by" { congr!{Real.Real Real.Real} (Real.add (LI.integral s.function)) _ _ (Negation.integralNeg t.function) }
};
