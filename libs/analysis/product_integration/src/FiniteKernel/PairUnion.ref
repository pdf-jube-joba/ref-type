\definition function: LI.Representatives := Linear.addRepresentative s.function t.function;
\definition law: Sets.Disjoint S T -> \forall (x: A) -> Complete.LeastUpperBound[nu.value (ProductSigma.section (PS.pairUnion S T) x), function x] :=
  \fun (disjoint: Sets.Disjoint S T) (x: A) =>
    \idelim M.add (nu.value (ProductSigma.section S x)) (nu.value (ProductSigma.section T x)) = nu.value (ProductSigma.section (PS.pairUnion S T) x)
      \with v: M.Value => Complete.LeastUpperBound[v, function x] \by {
        base: SupAdd.leastUpper (nu.value (ProductSigma.section S x)) (nu.value (ProductSigma.section T x)) (s.function x) (t.function x) (s.law x) (t.law x),
        equality: sym!{M.Value} _ _ (Finite.additivity (ProductSigma.section S x) (ProductSigma.section T x) (s.measurable x) (t.measurable x)
          (\fun (y: B) (first: RS.Member (ProductSigma.section S x) y) (second: RS.Member (ProductSigma.section T x) y) =>
            disjoint (Pair.pair A B x y) first second)) };
\definition witness[disjoint: Sets.Disjoint S T]: Witness[PS.pairUnion S T] :=
  Witness[PS.pairUnion S T] {
    measurable := \fun (x: A) => Sigma.pairMeasurable nu.sigma (ProductSigma.section S x) (ProductSigma.section T x) (s.measurable x) (t.measurable x),
    function := function,
    law := law disjoint,
  };
\definition integral: LI.integral function = Real.add (LI.integral s.function) (LI.integral t.function) := Linear.integralAdd s.function t.function;
