\import \root.Convolution[A := E.Point, mu := Construction.measure, exhaustion := exhaustion] \as C;
\import C.For[translations := translation, f := f, g := g] \as Convolution;
\definition kernel: \root.ProductSigma[A := E.Point, B := E.Point, left := Construction.measure.sigma, right := Construction.measure.sigma].Point -> Real.Real := Convolution.kernel;
\definition exists: functional_analysis.Measure[A := \root.ProductSigma[A := E.Point, B := E.Point, left := Construction.measure.sigma, right := Construction.measure.sigma].Point].IsMeasurable
  \root.Product[A := E.Point, B := E.Point, mu := Construction.measure, nu := Construction.measure, left := exhaustion, right := exhaustion].measure kernel -> \exists Convolution.Result := Convolution.exists;
