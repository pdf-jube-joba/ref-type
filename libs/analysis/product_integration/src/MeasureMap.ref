\import functional_analysis.Measure[A := A] \as Source;
\import functional_analysis.Measure[A := B] \as Target;
\import topology.Topology[Carrier := B] \as TargetSets;
\structure Data: \Set := {
  function: A -> B,
  measurable: \forall (S: \Pow B) -> Target.Measurable target.sigma S ->
    Source.Measurable source.sigma ({ x: A \where TargetSets.Member S (function x) }),
  value: \forall (S: \Pow B) -> Target.Measurable target.sigma S ->
    source.value ({ x: A \where TargetSets.Member S (function x) }) = target.value S,
};
\module On(map: Data);
