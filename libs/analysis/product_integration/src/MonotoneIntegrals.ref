\import functional_analysis.Measure[A := A] \as M;
\import M.Integral[mu := mu] \as I;
\import I.Convergence[] \as C;
\import I.Scaling[] \as Scaling;
\import std.Data[].Nat[] \as N;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\structure Conditions: \Set := {
  sequence: N.Nat^ -> I.Representatives,
  nonnegative: \forall (k: N.Nat^) (x: A) -> R.Le Real.zero (sequence k x),
  increasing: C.FunctionIncreasing (\fun (k: N.Nat^) (x: A) => sequence k x),
  bound: Scaling.NonnegativeScalar,
  integralBound: \forall (k: N.Nat^) -> R.Le (I.integral (sequence k)) bound,
};
\module For(data: Conditions);
