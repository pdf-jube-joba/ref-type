\import Convolution.For[translations := Euclidean.translation, f := I.Zero[].representative, g := g] \as For;
\definition equality: For.kernel = Joint.Zero[].function := \axiom:funext(For.kernel, Joint.Zero[].function,
  \fun (p: Sigma.Point) => Laws.fieldMulZeroLeft (g (std.Data[].Pair[].second E.Point E.Point p)));
\definition measurable: functional_analysis.Measure[A := Sigma.Point].IsMeasurable Product.measure For.kernel :=
  \idelim Joint.Zero[].function = For.kernel \with f: (Sigma.Point -> Real.Real) => functional_analysis.Measure[A := Sigma.Point].IsMeasurable Product.measure f \by {
    base: (Joint.integralLaw Joint.Zero[].representative).integrable.left, equality: sym!{{Sigma.Point -> Real.Real}} _ _ equality };
\definition theorem: \exists For.Result := For.exists measurable;
