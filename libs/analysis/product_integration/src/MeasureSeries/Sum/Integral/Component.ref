\import M.Integral[mu := data.measures j] \as Source;
\import Source.Convergence[] \as SC;
\import SC.Monotone[] \as SM;
\definition sequence: SC.MeasurableSequence := \into[N.Nat^ -> A -> Real.Real](Approx.value, SC.MeasurableSequence) \by {
  \fun (k: N.Nat^) (r: Real.Real) => data.measurable ({ x: A \where dedekind_reals.DedekindReal[].Lt r (Approx.value k x) }) (Approx.measurable k r) j
};
\definition monotone: Source.lowerIntegral f.function = C.Sup (\fun (k: N.Nat^) => Source.lowerIntegral (Approx.value k)) :=
  SM.monotone sequence f.function Approx.pointwiseSup Approx.increasing;
\module Stage(k: N.Nat^);
