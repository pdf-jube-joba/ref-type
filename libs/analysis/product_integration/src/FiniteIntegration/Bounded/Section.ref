\definition dominatedData: RI.DominatedSequence := RI.DominatedSequence {
  sequence := \fun (k: N.Nat^) => approximateSection k x,
  limit := \fun (y: B) => data.function.function (Pair.pair A B x y),
  bound := RightSpace.constant data.bound,
  dominated := \fun (k: N.Nat^) (y: B) => approximationBound k (Pair.pair A B x y),
  converges := \fun (y: B) => pointwiseConverges (Pair.pair A B x y),
};
\import RI.Dominated[d := dominatedData] \as Limit;
\definition integral: RI.integral Limit.limitRepresentative = RI.integral (section x) :=
  congr!{RI.Representatives Real.Real} RI.integral _ _ (\axiom:funext(Limit.limitRepresentative, section x,
    \fun (y: B) => \refl(data.function.function (Pair.pair A B x y))));
\definition converges: Sequence.Converges (\fun (k: N.Nat^) => RI.integral (approximateSection k x)) (outerFunction x) :=
  \idelim RI.integral Limit.limitRepresentative = RI.integral (section x) \with v: Real.Real =>
    Sequence.Converges (\fun (k: N.Nat^) => RI.integral (approximateSection k x)) v \by { base: Limit.convergence, equality: integral };
