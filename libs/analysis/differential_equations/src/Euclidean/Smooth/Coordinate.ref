\definition derivatives[j: Euclidean.Coordinate]: Open.ScalarFunction U := Partials.partial U (component i) j;
\import C1.Local[U := U, f := component i, g := derivatives, a := a] \as Local;
\definition neighborhoodExists: \exists C1.LipschitzNeighborhood[U, component i, a] := Local.locallyLipschitz
  (\fun (j: Euclidean.Coordinate) => Partials.partialLaw U (component i) j)
  (\fun (j: Euclidean.Coordinate) => Properties.continuous U (derivatives j) (Partials.partialSmooth U (component i) j) a);
