\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.Extension[neighborhood := neighborhood] \as Extension;
\import Extension.Adapt[solution := left] \as AdaptLeft;
\import Extension.Adapt[solution := right] \as AdaptRight;
\definition agreementExists: \exists LocalAgreement[left.value, right.value] := \block {
  \takefrom l: Extension.Adaptation[left] \by AdaptLeft.existsAdaptation \then
  \takefrom r: Extension.Adaptation[right] \by AdaptRight.existsAdaptation \then
  \takefrom common: LocalAgreement[l.adapted.value, r.adapted.value] \by \root.Euclidean[n := n].localUniqueness Extension.extension a l.adapted r.adapted \then
  \return \exact(LocalAgreement[left.value, right.value] {
    radius := common.radius,
    agrees := \fun (t: Real)(lower: _)(upper: _) => eq_reason_in!{Vector _
      "=" _ "by" { congr!{{Real -> Vector} Vector} (\fun (f: Real -> Vector) => f t) _ _ (sym!{{Real -> Vector}} _ _ l.same) }
      "=" _ "by" { common.agrees t lower upper }
      "=" _ "by" { congr!{{Real -> Vector} Vector} (\fun (f: Real -> Vector) => f t) _ _ r.same }
    },
  }, LocalAgreement[left.value, right.value])
};
