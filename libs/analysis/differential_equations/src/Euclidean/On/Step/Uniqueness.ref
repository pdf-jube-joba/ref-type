\import \parent.Picard[y := y] \as Picard;
\definition extended: Integrals.Function := \into[Real -> Vector](extend y, { f: Real -> Vector \where Integrals.IsContinuous f }) \by { extendedContinuous y };
\import Integrals.Of[f := Picard.asFunction] \as Integral;
\module Coordinate(i: Euclidean.Coordinate);
\definition fixedEquation: y zeroTime = initial -> Equation y -> picard y = y :=
  \fun (initialValue: _)(derivatives: _) => \axiom:funext(picard y, y, \fun (t: Time) => \axiom:funext(picard y t, y t,
    \fun (i: Euclidean.Coordinate) => Coordinate[i := i].agrees initialValue derivatives t));
\definition unique: y zeroTime = initial -> Equation y -> y = curve := \fun (initialValue: _)(derivatives: _) => Contractions.fixedUnique contraction
  (\into[Curve](y, { x: Curve \where contraction.apply x = x }) \by { fixedEquation initialValue derivatives }) fixed;
