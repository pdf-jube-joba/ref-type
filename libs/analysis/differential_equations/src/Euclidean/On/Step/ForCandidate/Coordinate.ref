\definition f[s: Real]: Real := candidate.value s i;
\definition d[s: Real]: Real := field.apply (candidate.value s) i;
\import calculus.Real[].Limit[].Topology[].Subset[S := Line.ClosedInterval left right] \as Relative;
\import calculus.Real[].MeanValue[].Interval[a := left, b := right].Estimate[] \as Estimate;
\definition continuous: Times.IsContinuous f := Relative.topologicalOfContinuous f (\fun (t: Time) => Estimate.continuousAt f d t (candidate.derivative t i));
\definition derivativeBound[s: Real]: R.Le (Scalars.distance (d s) Scalars.zero) field.bound := R.leTrans _ _ _
  (Norm.coordinateDistance (field.apply (candidate.value s)) Coordinates.origin i) (field.bounded (candidate.value s));
\module Interval(t: Time);
