\import topological_algebra.Euclidean[].Dimension[n := n] \as Euclidean;
\import functional_analysis.Measure[A := Euclidean.Point] \as Measure;
\import topology.Topology[Carrier := Euclidean.Point] \as Sets;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import real.Analysis[] \as Real;
\import real.Analysis[].Distance[] \as Distance;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Bool[] \as Bool;
\import std.Logic[].Proposition[] \as Logic;

\definition Point: \Set := Euclidean.Point;
\definition product: \forall (k: N.Nat^) -> (Fin.Fin k -> Real.Real) -> Real.Real :=
  \induction (k: N.Nat^) \return (Fin.Fin k -> Real.Real) -> Real.Real \with {
    | zero: \fun (_: Fin.Fin N.Nat^::zero -> Real.Real) => Real.one
    | succ: \fun (k: N.Nat^) (previous: (Fin.Fin k -> Real.Real) -> Real.Real) (f: Fin.Fin (N.Nat^::succ k) -> Real.Real) =>
      Real.mul (f (Fin.zero k)) (previous (\fun (i: Fin.Fin k) => f (Fin.succ k i)))
  };

\structure Box: \Set := {
  active: Bool.Bool^,
  left: Fin.Fin n -> Real.Real,
  right: Fin.Fin n -> Real.Real,
  ordered: \forall (i: Fin.Fin n) -> R.Le (left i) (right i),
};
\definition points[b: Box]: \Pow Point := { x: Point \where
  Logic.And[Bool.IsTrue b.active, \forall (i: Fin.Fin n) -> Logic.And[R.Le (b.left i) (x i), R.Le (x i) (b.right i)]] };
\definition volume[b: Box]: Real.Real :=
  \match b.active \in Bool.Bool^ \return (\fun (_: Bool.Bool^) => Real.Real) \with {
    | false: Real.zero
    | true: product n (\fun (i: Fin.Fin n) => Real.sub (b.right i) (b.left i))
  };
\definition volumeValue[b: Box]: Measure.Value := { r: Real.Real \where R.Lt r (volume b) };
\definition Covers[family: N.Nat^ -> Box, S: \Pow Point]: \Prop :=
  \forall (x: Point) -> Sets.Member S x -> \exists ( k: N.Nat^ \where Sets.Member (points (family k)) x );
\definition cost[family: N.Nat^ -> Box]: Measure.Value :=
  Measure.series (\fun (k: N.Nat^) => volumeValue (family k));
/* The rounded intersection is the infimum of the costs in lower-cut form. */
\definition outer[S: \Pow Point]: Measure.Value := { r: Real.Real \where
  \exists ( s: Real.Real \where Logic.And[R.Lt r s, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) s] ) };
\definition monotone: \forall (S, T: \Pow Point) -> Sets.Subset S T ->
  \forall (r: Real.Real) -> Measure.below (outer S) r -> Measure.below (outer T) r :=
  \fun (S, T: \Pow Point) (included: Sets.Subset S T) (r: Real.Real) (member: Measure.below (outer S) r) => \block {
    \takefrom s: \Cast[Real.Real] ({ s: Real.Real \where Logic.And[R.Lt r s, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) s] }) \by member \then
    \let law: Logic.And[R.Lt r s, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) s] :=
      \bysub(Real.Real, { s: Real.Real \where Logic.And[R.Lt r s, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) s] }, s) \then
    \return Logic.existsIntro[Real.Real, { s: Real.Real \where Logic.And[R.Lt r s, \forall (family: N.Nat^ -> Box) -> Covers family T -> Measure.below (cost family) s] }] s
      (Logic.And[_, _]::# law.left (\fun (family: N.Nat^ -> Box) (cover: Covers family T) =>
        law.right family (\fun (x: Point) (inS: Sets.Member S x) => cover x (included x inS))))
  };

\import R.Order[] \as Order;
\import Measure.ValueLaws[] \as Values;
\definition productNonnegative: \forall (k: N.Nat^) (f: Fin.Fin k -> Real.Real) ->
  (\forall (i: Fin.Fin k) -> R.Le Real.zero (f i)) -> R.Le Real.zero (product k f) :=
  \induction (k: N.Nat^) \return \forall (f: Fin.Fin k -> Real.Real) ->
    (\forall (i: Fin.Fin k) -> R.Le Real.zero (f i)) -> R.Le Real.zero (product k f) \with {
    | zero: \fun (_: _) (_: _) => Laws.oneNonnegative
    | succ: \fun (k: N.Nat^) (previous: _) (f: _) (nonnegative: _) =>
      Laws.fieldMulNonnegative (f (Fin.zero k)) (product k (\fun (i: Fin.Fin k) => f (Fin.succ k i)))
        (nonnegative (Fin.zero k)) (previous (\fun (i: Fin.Fin k) => f (Fin.succ k i)) (\fun (i: Fin.Fin k) => nonnegative (Fin.succ k i)))
  };
\definition volumeNonnegative: \forall (b: Box) -> R.Le Real.zero (volume b) :=
  \fun (b: Box) => Bool.cases (\fun (a: Bool.Bool^) => R.Le Real.zero
    (\match a \in Bool.Bool^ \return (\fun (_: Bool.Bool^) => Real.Real) \with {
      | false: Real.zero
      | true: product n (\fun (i: Fin.Fin n) => Real.sub (b.right i) (b.left i))
    })) (R.leRefl Real.zero)
    (productNonnegative n (\fun (i: Fin.Fin n) => Real.sub (b.right i) (b.left i))
      (\fun (i: Fin.Fin n) => Distance.subNonnegative (b.right i) (b.left i) (b.ordered i))) b.active;
\definition outerNonnegative: \forall (S: \Pow Point) -> Measure.NonnegativeValue[outer S] :=
  \fun (S: \Pow Point) => Measure.NonnegativeValue[outer S] {
    negative := \fun (r: Real.Real) (negative: R.Lt r Real.zero) => \block {
      \let s: Real.Real := Real.midpoint r Real.zero \then
      \return Logic.existsIntro[Real.Real, { s: Real.Real \where Logic.And[R.Lt r s, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) s] }] s
        (Logic.And[_, _]::# (Values.midpointStrictLeft r Real.zero negative)
          (\fun (family: N.Nat^ -> Box) (_: Covers family S) =>
            Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Measure.below (Measure.partialSum (\fun (j: N.Nat^) => volumeValue (family j)) k) s }] N.Nat^::zero
              (Values.midpointStrictRight r Real.zero negative)))
    },
    downward := \fun (r, s: Real.Real) (less: R.Lt r s) (member: Measure.below (outer S) s) => \block {
      \takefrom t: \Cast[Real.Real] ({ t: Real.Real \where Logic.And[R.Lt s t, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) t] }) \by member \then
      \let law: Logic.And[R.Lt s t, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) t] :=
        \bysub(Real.Real, { t: Real.Real \where Logic.And[R.Lt s t, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) t] }, t) \then
      \return Logic.existsIntro[Real.Real, { t: Real.Real \where Logic.And[R.Lt r t, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) t] }] t
        (Logic.And[_, _]::# (Order.ltTrans r s t less law.left) law.right)
    },
    rounded := \fun (r: Real.Real) (member: Measure.below (outer S) r) => \block {
      \takefrom t: \Cast[Real.Real] ({ t: Real.Real \where Logic.And[R.Lt r t, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) t] }) \by member \then
      \let law: Logic.And[R.Lt r t, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) t] :=
        \bysub(Real.Real, { t: Real.Real \where Logic.And[R.Lt r t, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) t] }, t) \then
      \let s: Real.Real := Real.midpoint r t \then
      \return Logic.existsIntro[Real.Real, { s: Real.Real \where Logic.And[R.Lt r s, Measure.below (outer S) s] }] s
        (Logic.And[_, _]::# (Values.midpointStrictLeft r t law.left)
          (Logic.existsIntro[Real.Real, { u: Real.Real \where Logic.And[R.Lt s u, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) u] }] t
            (Logic.And[_, _]::# (Values.midpointStrictRight r t law.left) law.right)))
    },
  };

\use std.Logic[].Equality[].eq_reason_in;
\use std.Logic[].Equality[].congr;
\definition emptyBox: Box := Box {
  active := Bool.Bool^::false,
  left := \fun (_: Fin.Fin n) => Real.zero,
  right := \fun (_: Fin.Fin n) => Real.zero,
  ordered := \fun (_: Fin.Fin n) => R.leRefl Real.zero,
};
\definition emptyFamily: N.Nat^ -> Box := \fun (_: N.Nat^) => emptyBox;
\definition emptyCover: Covers emptyFamily Sets.Empty :=
  \fun (_: Point) (member: Logic.False) => Logic.falseElim _ member;
\definition emptyPartial: \forall (k: N.Nat^) ->
  Measure.partialSum (\fun (_: N.Nat^) => Measure.zero) k = Measure.zero :=
  \induction (k: N.Nat^) \return Measure.partialSum (\fun (_: N.Nat^) => Measure.zero) k = Measure.zero \with {
    | zero: \refl(Measure.zero)
    | succ: \fun (k: N.Nat^) (previous: _) => eq_reason_in!{Measure.Value _
      "=" _ "by" { congr!{Measure.Value Measure.Value} (\fun (v: Measure.Value) => Measure.add v Measure.zero) _ _ previous }
      "=" _ "by" { Values.addZero Measure.zero Values.zeroNonnegative }
    }
  };
\definition emptyCost: cost emptyFamily = Measure.zero :=
  \axiom:setext(cost emptyFamily, Measure.zero,
    \fun (r: Real.Real) (member: Measure.below (cost emptyFamily) r) => \block {
      \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Measure.below (Measure.partialSum (\fun (_: N.Nat^) => Measure.zero) k) r }) \by member \then
      \return \idelim Measure.partialSum (\fun (_: N.Nat^) => Measure.zero) k = Measure.zero \with v: Measure.Value => Measure.below v r
        \by { base: \bysub(N.Nat^, { k: N.Nat^ \where Measure.below (Measure.partialSum (\fun (_: N.Nat^) => Measure.zero) k) r }, k), equality: emptyPartial k }
    },
    \fun (r: Real.Real) (member: Measure.below Measure.zero r) =>
      Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Measure.below (Measure.partialSum (\fun (_: N.Nat^) => Measure.zero) k) r }] N.Nat^::zero member);
\definition outerEmpty: outer Sets.Empty = Measure.zero :=
  \axiom:setext(outer Sets.Empty, Measure.zero,
    \fun (r: Real.Real) (member: Measure.below (outer Sets.Empty) r) => \block {
      \takefrom s: \Cast[Real.Real] ({ s: Real.Real \where Logic.And[R.Lt r s, \forall (family: N.Nat^ -> Box) -> Covers family Sets.Empty -> Measure.below (cost family) s] }) \by member \then
      \let law: Logic.And[R.Lt r s, \forall (family: N.Nat^ -> Box) -> Covers family Sets.Empty -> Measure.below (cost family) s] :=
        \bysub(Real.Real, { s: Real.Real \where Logic.And[R.Lt r s, \forall (family: N.Nat^ -> Box) -> Covers family Sets.Empty -> Measure.below (cost family) s] }, s) \then
      \let negative: R.Lt s Real.zero := \idelim cost emptyFamily = Measure.zero \with v: Measure.Value => Measure.below v s
        \by { base: law.right emptyFamily emptyCover, equality: emptyCost } \then
      \return Order.ltTrans r s Real.zero law.left negative
    },
    \fun (r: Real.Real) (negative: R.Lt r Real.zero) => (outerNonnegative Sets.Empty).negative r negative);

\definition volumeValueNonnegative: \forall (b: Box) -> Measure.NonnegativeValue[volumeValue b] :=
  \fun (b: Box) => Measure.NonnegativeValue[volumeValue b] {
    negative := \fun (r: Real.Real) (negative: R.Lt r Real.zero) => R.ltLeTrans r Real.zero (volume b) negative (volumeNonnegative b),
    downward := \fun (r, s: Real.Real) (less: R.Lt r s) (member: R.Lt s (volume b)) => Order.ltTrans r s (volume b) less member,
    rounded := \fun (r: Real.Real) (member: R.Lt r (volume b)) =>
      Logic.existsIntro[Real.Real, { s: Real.Real \where Logic.And[R.Lt r s, Measure.below (volumeValue b) s] }] (Real.midpoint r (volume b))
        (Logic.And[_, _]::# (Values.midpointStrictLeft r (volume b) member) (Values.midpointStrictRight r (volume b) member)),
  };
\definition partialNonnegative: \forall (f: N.Nat^ -> Measure.Value) ->
  (\forall (k: N.Nat^) -> Measure.NonnegativeValue[f k]) -> \forall (k: N.Nat^) -> Measure.NonnegativeValue[Measure.partialSum f k] :=
  \fun (f: N.Nat^ -> Measure.Value) (nonnegative: \forall (k: N.Nat^) -> Measure.NonnegativeValue[f k]) =>
    \induction (k: N.Nat^) \return Measure.NonnegativeValue[Measure.partialSum f k] \with {
      | zero: Values.zeroNonnegative
      | succ: \fun (k: N.Nat^) (previous: _) => Values.addNonnegative (Measure.partialSum f k) (f k) previous (nonnegative k)
    };
\definition seriesNonnegative: \forall (f: N.Nat^ -> Measure.Value) ->
  (\forall (k: N.Nat^) -> Measure.NonnegativeValue[f k]) -> Measure.NonnegativeValue[Measure.series f] :=
  \fun (f: N.Nat^ -> Measure.Value) (nonnegative: \forall (k: N.Nat^) -> Measure.NonnegativeValue[f k]) => Measure.NonnegativeValue[Measure.series f] {
    negative := \fun (r: Real.Real) (negative: R.Lt r Real.zero) =>
      Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Measure.below (Measure.partialSum f k) r }] N.Nat^::zero negative,
    downward := \fun (r, s: Real.Real) (less: R.Lt r s) (member: Measure.below (Measure.series f) s) => \block {
      \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Measure.below (Measure.partialSum f k) s }) \by member \then
      \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Measure.below (Measure.partialSum f k) r }] k
        ((partialNonnegative f nonnegative k).downward r s less (\bysub(N.Nat^, { k: N.Nat^ \where Measure.below (Measure.partialSum f k) s }, k)))
    },
    rounded := \fun (r: Real.Real) (member: Measure.below (Measure.series f) r) => \block {
      \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Measure.below (Measure.partialSum f k) r }) \by member \then
      \takefrom s: \Cast[Real.Real] ({ s: Real.Real \where Logic.And[R.Lt r s, Measure.below (Measure.partialSum f k) s] })
        \by (partialNonnegative f nonnegative k).rounded r (\bysub(N.Nat^, { k: N.Nat^ \where Measure.below (Measure.partialSum f k) r }, k)) \then
      \let law: Logic.And[R.Lt r s, Measure.below (Measure.partialSum f k) s] :=
        \bysub(Real.Real, { s: Real.Real \where Logic.And[R.Lt r s, Measure.below (Measure.partialSum f k) s] }, s) \then
      \return Logic.existsIntro[Real.Real, { s: Real.Real \where Logic.And[R.Lt r s, Measure.below (Measure.series f) s] }] s
        (Logic.And[_, _]::# law.left (Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Measure.below (Measure.partialSum f k) s }] k law.right))
    },
  };
\definition costNonnegative: \forall (family: N.Nat^ -> Box) -> Measure.NonnegativeValue[cost family] :=
  \fun (family: N.Nat^ -> Box) => seriesNonnegative (\fun (k: N.Nat^) => volumeValue (family k))
    (\fun (k: N.Nat^) => volumeValueNonnegative (family k));
\definition boundedByCover: \forall (S: \Pow Point) (family: N.Nat^ -> Box) -> Covers family S ->
  Values.Included (outer S) (cost family) :=
  \fun (S: \Pow Point) (family: N.Nat^ -> Box) (cover: Covers family S) (r: Real.Real) (member: Measure.below (outer S) r) => \block {
    \takefrom s: \Cast[Real.Real] ({ s: Real.Real \where Logic.And[R.Lt r s, \forall (other: N.Nat^ -> Box) -> Covers other S -> Measure.below (cost other) s] }) \by member \then
    \let law: Logic.And[R.Lt r s, \forall (other: N.Nat^ -> Box) -> Covers other S -> Measure.below (cost other) s] :=
      \bysub(Real.Real, { s: Real.Real \where Logic.And[R.Lt r s, \forall (other: N.Nat^ -> Box) -> Covers other S -> Measure.below (cost other) s] }, s) \then
    \return (costNonnegative family).downward r s law.left (law.right family cover)
  };

\import Measure.SeriesLaws[] \as Series;
\use std.Logic[].Equality[].sym;
\definition singleFamily[b: Box]: N.Nat^ -> Box :=
  \induction (k: N.Nat^) \return Box \with {
    | zero: b
    | succ: \fun (_: N.Nat^) (_: Box) => emptyBox
  };
\definition singleCovers: \forall (b: Box) -> Covers (singleFamily b) (points b) :=
  \fun (b: Box) (x: Point) (member: Sets.Member (points b) x) =>
    Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Sets.Member (points (singleFamily b k)) x }] N.Nat^::zero member;
\definition singleValues: \forall (b: Box) (k: N.Nat^) ->
  volumeValue (singleFamily b k) = Series.pair (volumeValue b) Measure.zero k :=
  \fun (b: Box) => \induction (k: N.Nat^) \return
    volumeValue (singleFamily b k) = Series.pair (volumeValue b) Measure.zero k \with {
      | zero: \refl(volumeValue b)
      | succ: \fun (k: N.Nat^) (_: _) => (\induction (k: N.Nat^) \return
        volumeValue (singleFamily b (N.Nat^::succ k)) = Series.pair (volumeValue b) Measure.zero (N.Nat^::succ k) \with {
          | zero: \refl(Measure.zero)
          | succ: \fun (_: N.Nat^) (_: _) => \refl(Measure.zero)
        }) k
    };
\definition singleCost: \forall (b: Box) -> cost (singleFamily b) = volumeValue b :=
  \fun (b: Box) => eq_reason_in!{Measure.Value _
    "=" _ "by" { congr!{{N.Nat^ -> Measure.Value} Measure.Value} Measure.series _ _ (\axiom:funext((\fun (k: N.Nat^) => volumeValue (singleFamily b k)), Series.pair (volumeValue b) Measure.zero, singleValues b)) }
    "=" _ "by" { Series.pairSeries (volumeValue b) Measure.zero (volumeValueNonnegative b) Values.zeroNonnegative }
    "=" _ "by" { Values.addZero (volumeValue b) (volumeValueNonnegative b) }
  };
\definition boxUpper: \forall (b: Box) -> Values.Included (outer (points b)) (volumeValue b) :=
  \fun (b: Box) (r: Real.Real) (member: Measure.below (outer (points b)) r) =>
    \idelim cost (singleFamily b) = volumeValue b \with v: Measure.Value => Measure.below v r
      \by { base: boundedByCover (points b) (singleFamily b) (singleCovers b) r member, equality: singleCost b };
\definition greatestLowerBound: \forall (S: \Pow Point) (v: Measure.Value) -> Measure.NonnegativeValue[v] ->
  (\forall (family: N.Nat^ -> Box) -> Covers family S -> Values.Included v (cost family)) -> Values.Included v (outer S) :=
  \fun (S: \Pow Point) (v: Measure.Value) (valid: Measure.NonnegativeValue[v])
    (bound: \forall (family: N.Nat^ -> Box) -> Covers family S -> Values.Included v (cost family))
    (r: Real.Real) (member: Measure.below v r) => \block {
      \takefrom s: \Cast[Real.Real] ({ s: Real.Real \where Logic.And[R.Lt r s, Measure.below v s] }) \by valid.rounded r member \then
      \let law: Logic.And[R.Lt r s, Measure.below v s] :=
        \bysub(Real.Real, { s: Real.Real \where Logic.And[R.Lt r s, Measure.below v s] }, s) \then
      \return Logic.existsIntro[Real.Real, { s: Real.Real \where Logic.And[R.Lt r s, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) s] }] s
        (Logic.And[_, _]::# law.left (\fun (family: N.Nat^ -> Box) (cover: Covers family S) => bound family cover s law.right))
    };

\import real.Analysis[].Estimates[] \as Estimates;
\definition productCongruent: \forall (k: N.Nat^) (f, g: Fin.Fin k -> Real.Real) ->
  (\forall (i: Fin.Fin k) -> f i = g i) -> product k f = product k g :=
  \induction (k: N.Nat^) \return \forall (f, g: Fin.Fin k -> Real.Real) ->
    (\forall (i: Fin.Fin k) -> f i = g i) -> product k f = product k g \with {
    | zero: \fun (_: _) (_: _) (_: _) => \refl(Real.one)
    | succ: \fun (k: N.Nat^) (previous: _) (f, g: _) (same: _) =>
      congr!{Real.Real Real.Real Real.Real} Real.mul _ _ _ _ (same (Fin.zero k))
        (previous (\fun (i: Fin.Fin k) => f (Fin.succ k i)) (\fun (i: Fin.Fin k) => g (Fin.succ k i)) (\fun (i: Fin.Fin k) => same (Fin.succ k i)))
  };
\definition translate[b: Box] [a: Point]: Box := Box {
  active := b.active,
  left := \fun (i: Fin.Fin n) => Real.add (b.left i) (a i),
  right := \fun (i: Fin.Fin n) => Real.add (b.right i) (a i),
  ordered := \fun (i: Fin.Fin n) => Laws.addMonotoneRight (b.left i) (b.right i) (a i) (b.ordered i),
};
\definition translatedWidth: \forall (x, y, a: Real.Real) ->
  Real.sub (Real.add x a) (Real.add y a) = Real.sub x y :=
  \fun (x, y, a: Real.Real) => eq_reason_in!{Real.Real _
    "=" _ "by" { Estimates.subAdd x a y a }
    "=" _ "by" { congr!{Real.Real Real.Real} (\fun (z: Real.Real) => Real.add (Real.sub x y) z) _ _ (Laws.subSelf a) }
    "=" _ "by" { Laws.addZeroRight (Real.sub x y) }
  };
\definition translateVolume: \forall (b: Box) (a: Point) -> volume (translate b a) = volume b :=
  \fun (b: Box) (a: Point) => Bool.cases (\fun (active: Bool.Bool^) =>
    (\match active \in Bool.Bool^ \return (\fun (_: Bool.Bool^) => Real.Real) \with {
      | false: Real.zero
      | true: product n (\fun (i: Fin.Fin n) => Real.sub (Real.add (b.right i) (a i)) (Real.add (b.left i) (a i)))
    }) =
    (\match active \in Bool.Bool^ \return (\fun (_: Bool.Bool^) => Real.Real) \with {
      | false: Real.zero
      | true: product n (\fun (i: Fin.Fin n) => Real.sub (b.right i) (b.left i))
    })) (\refl(Real.zero))
    (productCongruent n (\fun (i: Fin.Fin n) => Real.sub (Real.add (b.right i) (a i)) (Real.add (b.left i) (a i)))
      (\fun (i: Fin.Fin n) => Real.sub (b.right i) (b.left i)) (\fun (i: Fin.Fin n) => translatedWidth (b.right i) (b.left i) (a i))) b.active;

\definition addPoint[x, a: Point]: Point := \fun (i: Fin.Fin n) => Real.add (x i) (a i);
\definition subPoint[x, a: Point]: Point := \fun (i: Fin.Fin n) => Real.sub (x i) (a i);
\definition shifted[S: \Pow Point] [a: Point]: \Pow Point :=
  { y: Point \where Sets.Member S (subPoint y a) };
\definition translatedMember: \forall (b: Box) (a, x: Point) -> Sets.Member (points b) x ->
  Sets.Member (points (translate b a)) (addPoint x a) :=
  \fun (b: Box) (a, x: Point) (member: Sets.Member (points b) x) =>
    Logic.And[_, _]::# member.left (\fun (i: Fin.Fin n) =>
      Logic.And[_, _]::# (Laws.addMonotoneRight (b.left i) (x i) (a i) (member.right i).left)
        (Laws.addMonotoneRight (x i) (b.right i) (a i) (member.right i).right));
\definition subAddPoint: \forall (x, a: Point) -> addPoint (subPoint x a) a = x :=
  \fun (x, a: Point) => \axiom:funext(addPoint (subPoint x a) a, x,
    \fun (i: Fin.Fin n) => Distance.subAddCancel (x i) (a i));
\definition translatedCovers: \forall (family: N.Nat^ -> Box) (S: \Pow Point) (a: Point) -> Covers family S ->
  Covers (\fun (k: N.Nat^) => translate (family k) a) (shifted S a) :=
  \fun (family: N.Nat^ -> Box) (S: \Pow Point) (a: Point) (cover: Covers family S)
    (x: Point) (member: Sets.Member (shifted S a) x) => \block {
      \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Sets.Member (points (family k)) (subPoint x a) }) \by cover (subPoint x a) member \then
      \let inside: Sets.Member (points (family k)) (subPoint x a) :=
        \bysub(N.Nat^, { k: N.Nat^ \where Sets.Member (points (family k)) (subPoint x a) }, k) \then
      \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Sets.Member (points (translate (family k) a)) x }] k
        (\idelim addPoint (subPoint x a) a = x \with y: Point => Sets.Member (points (translate (family k) a)) y
          \by { base: translatedMember (family k) a (subPoint x a) inside, equality: subAddPoint x a })
    };
\definition translatedCost: \forall (family: N.Nat^ -> Box) (a: Point) ->
  cost (\fun (k: N.Nat^) => translate (family k) a) = cost family :=
  \fun (family: N.Nat^ -> Box) (a: Point) => congr!{{N.Nat^ -> Measure.Value} Measure.Value} Measure.series _ _
    (\axiom:funext((\fun (k: N.Nat^) => volumeValue (translate (family k) a)), (\fun (k: N.Nat^) => volumeValue (family k)),
      \fun (k: N.Nat^) => congr!{Real.Real Measure.Value} (\fun (v: Real.Real) => { r: Real.Real \where R.Lt r v }) _ _ (translateVolume (family k) a)));
\definition shiftedUpper: \forall (S: \Pow Point) (a: Point) -> Values.Included (outer (shifted S a)) (outer S) :=
  \fun (S: \Pow Point) (a: Point) => greatestLowerBound S (outer (shifted S a)) (outerNonnegative (shifted S a))
    (\fun (family: N.Nat^ -> Box) (cover: Covers family S) (r: Real.Real) (member: Measure.below (outer (shifted S a)) r) =>
      \idelim cost (\fun (k: N.Nat^) => translate (family k) a) = cost family \with v: Measure.Value => Measure.below v r
        \by { base: boundedByCover (shifted S a) (\fun (k: N.Nat^) => translate (family k) a) (translatedCovers family S a cover) r member,
          equality: translatedCost family a });

\import real.Analysis[].Algebra[] \as Algebra;
\definition negPoint[a: Point]: Point := \fun (i: Fin.Fin n) => Real.neg (a i);
\definition subNegSubPoint: \forall (x, a: Point) -> subPoint (subPoint x (negPoint a)) a = x :=
  \fun (x, a: Point) => \axiom:funext(subPoint (subPoint x (negPoint a)) a, x,
    \fun (i: Fin.Fin n) => eq_reason_in!{Real.Real _
      "=" _ "by" { congr!{Real.Real Real.Real} (\fun (z: Real.Real) => Real.sub z (a i)) _ _ (Algebra.subNeg (x i) (a i)) }
      "=" _ "by" { Laws.addNegCancelRight (a i) (x i) }
    });
\definition shiftedBack: \forall (S: \Pow Point) (a: Point) -> shifted (shifted S a) (negPoint a) = S :=
  \fun (S: \Pow Point) (a: Point) => \axiom:setext(shifted (shifted S a) (negPoint a), S,
    \fun (x: Point) (member: Sets.Member (shifted (shifted S a) (negPoint a)) x) =>
      \idelim subPoint (subPoint x (negPoint a)) a = x \with y: Point => Sets.Member S y
        \by { base: member, equality: subNegSubPoint x a },
    \fun (x: Point) (member: Sets.Member S x) =>
      \idelim x = subPoint (subPoint x (negPoint a)) a \with y: Point => Sets.Member S y
        \by { base: member, equality: sym!{Point} _ _ (subNegSubPoint x a) });
\definition translationInvariant: \forall (S: \Pow Point) (a: Point) -> outer (shifted S a) = outer S :=
  \fun (S: \Pow Point) (a: Point) => \axiom:setext(outer (shifted S a), outer S,
    shiftedUpper S a,
    \fun (r: Real.Real) (member: Measure.below (outer S) r) =>
      shiftedUpper (shifted S a) (negPoint a) r
        (\idelim outer S = outer (shifted (shifted S a) (negPoint a)) \with v: Measure.Value => Measure.below v r
          \by { base: member, equality: sym!{Measure.Value} _ _ (congr!{{\Pow Point} Measure.Value} outer _ _ (shiftedBack S a)) }));

\import Measure.Sigma[] \as Sigma;
\definition Caratheodory[S: \Pow Point]: \Prop := \forall (T: \Pow Point) ->
  outer T = Measure.add (outer (Sets.Intersection T S)) (outer (Sets.Intersection T (Sets.Complement S)));
\definition doubleComplementIntersection: \forall (T, S: \Pow Point) ->
  Sets.Intersection T (Sets.Complement (Sets.Complement S)) = Sets.Intersection T S :=
  \fun (T, S: \Pow Point) => \axiom:setext(Sets.Intersection T (Sets.Complement (Sets.Complement S)), Sets.Intersection T S,
    \fun (x: Point) (member: Sets.Member (Sets.Intersection T (Sets.Complement (Sets.Complement S))) x) =>
      Logic.And[_, _]::# member.left (Sigma.doubleNegative (Sets.Member S x) member.right),
    \fun (x: Point) (member: Sets.Member (Sets.Intersection T S) x) =>
      Logic.And[_, _]::# member.left (\fun (outside: Sets.Member (Sets.Complement S) x) => outside member.right));
\definition complementCaratheodory: \forall (S: \Pow Point) -> Caratheodory S -> Caratheodory (Sets.Complement S) :=
  \fun (S: \Pow Point) (measurable: Caratheodory S) (T: \Pow Point) => eq_reason_in!{Measure.Value _
    "=" _ "by" { measurable T }
    "=" _ "by" { Values.addComm (outer (Sets.Intersection T S)) (outer (Sets.Intersection T (Sets.Complement S))) }
    "=" _ "by" { congr!{Measure.Value Measure.Value} (Measure.add (outer (Sets.Intersection T (Sets.Complement S)))) _ _
      (congr!{{\Pow Point} Measure.Value} outer _ _ (sym!{{\Pow Point}} _ _ (doubleComplementIntersection T S))) }
  };
\definition intersectionEmpty: \forall (T: \Pow Point) -> Sets.Intersection T Sets.Empty = Sets.Empty :=
  \fun (T: \Pow Point) => \axiom:setext(Sets.Intersection T Sets.Empty, Sets.Empty,
    \fun (x: Point) (member: Sets.Member (Sets.Intersection T Sets.Empty) x) => member.right,
    \fun (x: Point) (member: Logic.False) => Logic.falseElim _ member);
\definition intersectionComplementEmpty: \forall (T: \Pow Point) -> Sets.Intersection T (Sets.Complement Sets.Empty) = T :=
  \fun (T: \Pow Point) => \axiom:setext(Sets.Intersection T (Sets.Complement Sets.Empty), T,
    \fun (x: Point) (member: Sets.Member (Sets.Intersection T (Sets.Complement Sets.Empty)) x) => member.left,
    \fun (x: Point) (member: Sets.Member T x) => Logic.And[_, _]::# member (\fun (impossible: Logic.False) => impossible));
\definition emptyCaratheodory: Caratheodory Sets.Empty :=
  \fun (T: \Pow Point) => sym!{Measure.Value} _ _ (eq_reason_in!{Measure.Value _
    "=" _ "by" { congr!{Measure.Value Measure.Value Measure.Value} Measure.add _ _ _ _
      (congr!{{\Pow Point} Measure.Value} outer _ _ (intersectionEmpty T))
      (congr!{{\Pow Point} Measure.Value} outer _ _ (intersectionComplementEmpty T)) }
    "=" _ "by" { congr!{Measure.Value Measure.Value} (\fun (v: Measure.Value) => Measure.add v (outer T)) _ _ outerEmpty }
    "=" _ "by" { Series.zeroAdd (outer T) (outerNonnegative T) }
  });

\definition unionIntersectLeft: \forall (S, T: \Pow Point) -> Sets.Intersection (Sigma.pairUnion S T) S = S :=
  \fun (S, T: \Pow Point) => \axiom:setext(Sets.Intersection (Sigma.pairUnion S T) S, S,
    \fun (x: Point) (member: Sets.Member (Sets.Intersection (Sigma.pairUnion S T) S) x) => member.right,
    \fun (x: Point) (member: Sets.Member S x) => Logic.And[_, _]::# (Logic.Or[_, _]::left member) member);
\definition disjointUnionDifference: \forall (S, T: \Pow Point) -> Sets.Disjoint S T ->
  Sets.Intersection (Sigma.pairUnion S T) (Sets.Complement S) = T :=
  \fun (S, T: \Pow Point) (disjoint: Sets.Disjoint S T) =>
    \axiom:setext(Sets.Intersection (Sigma.pairUnion S T) (Sets.Complement S), T,
      \fun (x: Point) (member: Sets.Member (Sets.Intersection (Sigma.pairUnion S T) (Sets.Complement S)) x) =>
        Logic.orElim _ _ (Sets.Member T x) member.left
          (\fun (inS: Sets.Member S x) => Logic.falseElim _ (member.right inS))
          (\fun (inT: Sets.Member T x) => inT),
      \fun (x: Point) (inT: Sets.Member T x) => Logic.And[_, _]::# (Logic.Or[_, _]::right inT)
        (\fun (inS: Sets.Member S x) => disjoint x inS inT));
\definition disjointAdditivity: \forall (S, T: \Pow Point) -> Caratheodory S -> Sets.Disjoint S T ->
  outer (Sigma.pairUnion S T) = Measure.add (outer S) (outer T) :=
  \fun (S, T: \Pow Point) (measurable: Caratheodory S) (disjoint: Sets.Disjoint S T) => eq_reason_in!{Measure.Value _
    "=" _ "by" { measurable (Sigma.pairUnion S T) }
    "=" _ "by" { congr!{Measure.Value Measure.Value Measure.Value} Measure.add _ _ _ _
      (congr!{{\Pow Point} Measure.Value} outer _ _ (unionIntersectLeft S T))
      (congr!{{\Pow Point} Measure.Value} outer _ _ (disjointUnionDifference S T disjoint)) }
  };

/* Every strict upper bound for the outer value admits a cover below it. */
\definition approximateCover: \forall (S: \Pow Point) (r, s: Real.Real) -> R.Lt r s ->
  Logic.Not (Measure.below (outer S) r) ->
  \exists ( family: N.Nat^ -> Box \where Logic.And[Covers family S, Logic.Not (Measure.below (cost family) s)] ) :=
  \fun (S: \Pow Point) (r, s: Real.Real) (less: R.Lt r s) (upper: Logic.Not (Measure.below (outer S) r)) =>
    Sigma.doubleNegative (\exists ( family: N.Nat^ -> Box \where Logic.And[Covers family S, Logic.Not (Measure.below (cost family) s)] ))
      (\fun (none: Logic.Not (\exists ( family: N.Nat^ -> Box \where Logic.And[Covers family S, Logic.Not (Measure.below (cost family) s)] ))) =>
        upper (Logic.existsIntro[Real.Real, { t: Real.Real \where Logic.And[R.Lt r t, \forall (family: N.Nat^ -> Box) -> Covers family S -> Measure.below (cost family) t] }] s
          (Logic.And[_, _]::# less (\fun (family: N.Nat^ -> Box) (cover: Covers family S) =>
            Sigma.doubleNegative (Measure.below (cost family) s) (\fun (notBelow: Logic.Not (Measure.below (cost family) s)) =>
              none (Logic.existsIntro[N.Nat^ -> Box, { family: N.Nat^ -> Box \where Logic.And[Covers family S, Logic.Not (Measure.below (cost family) s)] }] family
                (Logic.And[_, _]::# cover notBelow)))))));

\definition productMultiply: \forall (k: N.Nat^) (f, g: Fin.Fin k -> Real.Real) ->
  product k (\fun (i: Fin.Fin k) => Real.mul (f i) (g i)) = Real.mul (product k f) (product k g) :=
  \induction (k: N.Nat^) \return \forall (f, g: Fin.Fin k -> Real.Real) ->
    product k (\fun (i: Fin.Fin k) => Real.mul (f i) (g i)) = Real.mul (product k f) (product k g) \with {
    | zero: \fun (_: _) (_: _) => sym!{Real.Real} _ _ (Laws.fieldMulOneLeft Real.one)
    | succ: \fun (k: N.Nat^) (previous: _) (f, g: _) => eq_reason_in!{Real.Real _
      "=" _ "by" { congr!{Real.Real Real.Real} (Real.mul (Real.mul (f (Fin.zero k)) (g (Fin.zero k)))) _ _
        (previous (\fun (i: Fin.Fin k) => f (Fin.succ k i)) (\fun (i: Fin.Fin k) => g (Fin.succ k i))) }
      "=" _ "by" { Algebra.mulFour (f (Fin.zero k)) (g (Fin.zero k))
        (product k (\fun (i: Fin.Fin k) => f (Fin.succ k i))) (product k (\fun (i: Fin.Fin k) => g (Fin.succ k i))) }
    }
  };
\definition NonnegativePoint: \Set := \Cast[Point] ({ a: Point \where \forall (i: Fin.Fin n) -> R.Le Real.zero (a i) });
\definition scaledBox[b: Box] [a: NonnegativePoint]: Box := Box {
    active := b.active,
    left := \fun (i: Fin.Fin n) => Real.mul (a i) (b.left i),
    right := \fun (i: Fin.Fin n) => Real.mul (a i) (b.right i),
    ordered := \fun (i: Fin.Fin n) => Estimates.mulMonotone (a i) (b.left i) (b.right i)
      ((\bysub(Point, { a: Point \where \forall (i: Fin.Fin n) -> R.Le Real.zero (a i) }, a)) i) (b.ordered i),
  };
\definition scaledVolume: \forall (b: Box) (a: NonnegativePoint) ->
  volume (scaledBox b a) = Real.mul (product n a) (volume b) :=
  \fun (b: Box) (a: NonnegativePoint) => Bool.cases (\fun (active: Bool.Bool^) =>
    (\match active \in Bool.Bool^ \return (\fun (_: Bool.Bool^) => Real.Real) \with {
      | false: Real.zero
      | true: product n (\fun (i: Fin.Fin n) => Real.sub (Real.mul (a i) (b.right i)) (Real.mul (a i) (b.left i)))
    }) = Real.mul (product n a)
    (\match active \in Bool.Bool^ \return (\fun (_: Bool.Bool^) => Real.Real) \with {
      | false: Real.zero
      | true: product n (\fun (i: Fin.Fin n) => Real.sub (b.right i) (b.left i))
    })) (sym!{Real.Real} _ _ (Laws.fieldMulZeroRight (product n a)))
    (eq_reason_in!{Real.Real _
      "=" _ "by" { productCongruent n (\fun (i: Fin.Fin n) => Real.sub (Real.mul (a i) (b.right i)) (Real.mul (a i) (b.left i)))
        (\fun (i: Fin.Fin n) => Real.mul (a i) (Real.sub (b.right i) (b.left i)))
        (\fun (i: Fin.Fin n) => sym!{Real.Real} _ _ (Estimates.mulSub (a i) (b.right i) (b.left i))) }
      "=" _ "by" { productMultiply n a (\fun (i: Fin.Fin n) => Real.sub (b.right i) (b.left i)) }
    }) b.active;

\definition partialMonotone: \forall (f, g: N.Nat^ -> Measure.Value) ->
  (\forall (k: N.Nat^) -> Values.Included (f k) (g k)) ->
  \forall (k: N.Nat^) -> Values.Included (Measure.partialSum f k) (Measure.partialSum g k) :=
  \fun (f, g: N.Nat^ -> Measure.Value) (bound: \forall (k: N.Nat^) -> Values.Included (f k) (g k)) =>
    \induction (k: N.Nat^) \return Values.Included (Measure.partialSum f k) (Measure.partialSum g k) \with {
      | zero: \fun (_: Real.Real) (member: _) => member
      | succ: \fun (k: N.Nat^) (previous: _) =>
        Values.addMono (Measure.partialSum f k) (Measure.partialSum g k) (f k) (g k) previous (bound k)
    };
\definition seriesMonotone: \forall (f, g: N.Nat^ -> Measure.Value) ->
  (\forall (k: N.Nat^) -> Values.Included (f k) (g k)) -> Values.Included (Measure.series f) (Measure.series g) :=
  \fun (f, g: N.Nat^ -> Measure.Value) (bound: \forall (k: N.Nat^) -> Values.Included (f k) (g k))
    (r: Real.Real) (member: Measure.below (Measure.series f) r) => \block {
      \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Measure.below (Measure.partialSum f k) r }) \by member \then
      \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Measure.below (Measure.partialSum g k) r }] k
        (partialMonotone f g bound k r (\bysub(N.Nat^, { k: N.Nat^ \where Measure.below (Measure.partialSum f k) r }, k)))
    };
\definition partialStep: \forall (f: N.Nat^ -> Measure.Value) ->
  (\forall (k: N.Nat^) -> Measure.NonnegativeValue[f k]) ->
  \forall (k: N.Nat^) -> Values.Included (Measure.partialSum f k) (Measure.partialSum f (N.Nat^::succ k)) :=
  \fun (f: N.Nat^ -> Measure.Value) (nonnegative: \forall (k: N.Nat^) -> Measure.NonnegativeValue[f k]) (k: N.Nat^) =>
    Series.pairLeftIncluded (Measure.partialSum f k) (f k) (partialNonnegative f nonnegative k) (nonnegative k);

\definition unionInsideLeft: \forall (T, S, U: \Pow Point) ->
  Sets.Intersection (Sets.Intersection T (Sigma.pairUnion S U)) S = Sets.Intersection T S :=
  \fun (T, S, U: \Pow Point) => \axiom:setext(Sets.Intersection (Sets.Intersection T (Sigma.pairUnion S U)) S, Sets.Intersection T S,
    \fun (x: Point) (member: Sets.Member (Sets.Intersection (Sets.Intersection T (Sigma.pairUnion S U)) S) x) =>
      Logic.And[_, _]::# member.left.left member.right,
    \fun (x: Point) (member: Sets.Member (Sets.Intersection T S) x) =>
      Logic.And[_, _]::# (Logic.And[_, _]::# member.left (Logic.Or[_, _]::left member.right)) member.right);
\definition unionInsideRight: \forall (T, S, U: \Pow Point) ->
  Sets.Intersection (Sets.Intersection T (Sigma.pairUnion S U)) (Sets.Complement S) =
    Sets.Intersection (Sets.Intersection T (Sets.Complement S)) U :=
  \fun (T, S, U: \Pow Point) => \axiom:setext(
    Sets.Intersection (Sets.Intersection T (Sigma.pairUnion S U)) (Sets.Complement S),
    Sets.Intersection (Sets.Intersection T (Sets.Complement S)) U,
    \fun (x: Point) (member: Sets.Member (Sets.Intersection (Sets.Intersection T (Sigma.pairUnion S U)) (Sets.Complement S)) x) =>
      Logic.And[_, _]::# (Logic.And[_, _]::# member.left.left member.right)
        (Logic.orElim _ _ (Sets.Member U x) member.left.right
          (\fun (inS: Sets.Member S x) => Logic.falseElim _ (member.right inS)) (\fun (inU: Sets.Member U x) => inU)),
    \fun (x: Point) (member: Sets.Member (Sets.Intersection (Sets.Intersection T (Sets.Complement S)) U) x) =>
      Logic.And[_, _]::# (Logic.And[_, _]::# member.left.left (Logic.Or[_, _]::right member.right)) member.left.right);
\definition unionOutside: \forall (T, S, U: \Pow Point) ->
  Sets.Intersection T (Sets.Complement (Sigma.pairUnion S U)) =
    Sets.Intersection (Sets.Intersection T (Sets.Complement S)) (Sets.Complement U) :=
  \fun (T, S, U: \Pow Point) => \axiom:setext(
    Sets.Intersection T (Sets.Complement (Sigma.pairUnion S U)),
    Sets.Intersection (Sets.Intersection T (Sets.Complement S)) (Sets.Complement U),
    \fun (x: Point) (member: Sets.Member (Sets.Intersection T (Sets.Complement (Sigma.pairUnion S U))) x) =>
      Logic.And[_, _]::# (Logic.And[_, _]::# member.left (\fun (inS: Sets.Member S x) => member.right (Logic.Or[_, _]::left inS)))
        (\fun (inU: Sets.Member U x) => member.right (Logic.Or[_, _]::right inU)),
    \fun (x: Point) (member: Sets.Member (Sets.Intersection (Sets.Intersection T (Sets.Complement S)) (Sets.Complement U)) x) =>
      Logic.And[_, _]::# member.left.left (\fun (either: Sets.Member (Sigma.pairUnion S U) x) =>
        Logic.orElim _ _ Logic.False either member.left.right member.right));
\definition unionCaratheodory: \forall (S, U: \Pow Point) -> Caratheodory S -> Caratheodory U -> Caratheodory (Sigma.pairUnion S U) :=
  \fun (S, U: \Pow Point) (s: Caratheodory S) (u: Caratheodory U) (T: \Pow Point) => \block {
    \let left: Measure.Value := outer (Sets.Intersection T S) \then
    \let middle: Measure.Value := outer (Sets.Intersection (Sets.Intersection T (Sets.Complement S)) U) \then
    \let right: Measure.Value := outer (Sets.Intersection (Sets.Intersection T (Sets.Complement S)) (Sets.Complement U)) \then
    \let inside: outer (Sets.Intersection T (Sigma.pairUnion S U)) = Measure.add left middle := eq_reason_in!{Measure.Value _
      "=" _ "by" { s (Sets.Intersection T (Sigma.pairUnion S U)) }
      "=" _ "by" { congr!{Measure.Value Measure.Value Measure.Value} Measure.add _ _ _ _
        (congr!{{\Pow Point} Measure.Value} outer _ _ (unionInsideLeft T S U))
        (congr!{{\Pow Point} Measure.Value} outer _ _ (unionInsideRight T S U)) }
    } \then
    \return eq_reason_in!{Measure.Value _
      "=" _ "by" { s T }
      "=" _ "by" { congr!{Measure.Value Measure.Value} (Measure.add left) _ _ (u (Sets.Intersection T (Sets.Complement S))) }
      "=" _ "by" { sym!{Measure.Value} _ _ (Values.addAssoc left middle right) }
      "=" _ "by" { congr!{Measure.Value Measure.Value} (\fun (v: Measure.Value) => Measure.add v right) _ _ (sym!{Measure.Value} _ _ inside) }
      "=" _ "by" { congr!{Measure.Value Measure.Value} (Measure.add (outer (Sets.Intersection T (Sigma.pairUnion S U)))) _ _
        (congr!{{\Pow Point} Measure.Value} outer _ _ (sym!{{\Pow Point}} _ _ (unionOutside T S U))) }
    }
  };
\definition intersectionCaratheodory: \forall (S, U: \Pow Point) -> Caratheodory S -> Caratheodory U -> Caratheodory (Sets.Intersection S U) :=
  \fun (S, U: \Pow Point) (s: Caratheodory S) (u: Caratheodory U) =>
    \idelim Sets.Complement (Sigma.pairUnion (Sets.Complement S) (Sets.Complement U)) = Sets.Intersection S U
      \with V: \Pow Point => Caratheodory V
      \by { base: complementCaratheodory (Sigma.pairUnion (Sets.Complement S) (Sets.Complement U))
        (unionCaratheodory (Sets.Complement S) (Sets.Complement U) (complementCaratheodory S s) (complementCaratheodory U u)),
        equality: Sigma.intersectionComplement S U };
\definition differenceCaratheodory: \forall (S, U: \Pow Point) -> Caratheodory S -> Caratheodory U ->
  Caratheodory (Sigma.difference S U) :=
  \fun (S, U: \Pow Point) (s: Caratheodory S) (u: Caratheodory U) => intersectionCaratheodory S (Sets.Complement U) s (complementCaratheodory U u);
\definition prefixCaratheodory: \forall (f: N.Nat^ -> \Pow Point) -> (\forall (j: N.Nat^) -> Caratheodory (f j)) ->
  \forall (j: N.Nat^) -> Caratheodory (Sigma.prefix f j) :=
  \fun (f: N.Nat^ -> \Pow Point) (measurable: \forall (j: N.Nat^) -> Caratheodory (f j)) =>
    \induction (j: N.Nat^) \return Caratheodory (Sigma.prefix f j) \with {
      | zero: emptyCaratheodory
      | succ: \fun (j: N.Nat^) (previous: _) => unionCaratheodory (Sigma.prefix f j) (f j) previous (measurable j)
    };
\definition incrementCaratheodory: \forall (f: N.Nat^ -> \Pow Point) -> (\forall (j: N.Nat^) -> Caratheodory (f j)) ->
  \forall (j: N.Nat^) -> Caratheodory (Sigma.increments f j) :=
  \fun (f: N.Nat^ -> \Pow Point) (measurable: \forall (j: N.Nat^) -> Caratheodory (f j)) (j: N.Nat^) =>
    differenceCaratheodory (f j) (Sigma.prefix f j) (measurable j) (prefixCaratheodory f measurable j);

\import std.Logic[].Classical[] \as Classical;
\definition unionDifference: \forall (S, T: \Pow Point) -> Sigma.pairUnion S T = Sigma.pairUnion S (Sigma.difference T S) :=
  \fun (S, T: \Pow Point) => \axiom:setext(Sigma.pairUnion S T, Sigma.pairUnion S (Sigma.difference T S),
    \fun (x: Point) (member: Sets.Member (Sigma.pairUnion S T) x) =>
      Logic.orElim _ _ (Sets.Member (Sigma.pairUnion S (Sigma.difference T S)) x) member
        (\fun (inS: Sets.Member S x) => Logic.Or[_, _]::left inS)
        (\fun (inT: Sets.Member T x) => Logic.orElim _ _ (Sets.Member (Sigma.pairUnion S (Sigma.difference T S)) x)
          (Classical.excludedMiddle (Sets.Member S x))
          (\fun (inS: Sets.Member S x) => Logic.Or[_, _]::left inS)
          (\fun (notS: Logic.Not (Sets.Member S x)) => Logic.Or[_, _]::right (Logic.And[_, _]::# inT notS))),
    \fun (x: Point) (member: Sets.Member (Sigma.pairUnion S (Sigma.difference T S)) x) =>
      Logic.orElim _ _ (Sets.Member (Sigma.pairUnion S T) x) member
        (\fun (inS: Sets.Member S x) => Logic.Or[_, _]::left inS)
        (\fun (inDiff: Sets.Member (Sigma.difference T S) x) => Logic.Or[_, _]::right inDiff.left));
\definition prefixSum: \forall (f: N.Nat^ -> \Pow Point) -> (\forall (j: N.Nat^) -> Caratheodory (f j)) ->
  \forall (j: N.Nat^) -> outer (Sigma.prefix f j) = Measure.partialSum (\fun (k: N.Nat^) => outer (Sigma.increments f k)) j :=
  \fun (f: N.Nat^ -> \Pow Point) (measurable: \forall (j: N.Nat^) -> Caratheodory (f j)) =>
    \induction (j: N.Nat^) \return outer (Sigma.prefix f j) = Measure.partialSum (\fun (k: N.Nat^) => outer (Sigma.increments f k)) j \with {
      | zero: outerEmpty
      | succ: \fun (j: N.Nat^) (previous: _) => eq_reason_in!{Measure.Value _
        "=" _ "by" { congr!{{\Pow Point} Measure.Value} outer _ _ (unionDifference (Sigma.prefix f j) (f j)) }
        "=" _ "by" { disjointAdditivity (Sigma.prefix f j) (Sigma.increments f j) (prefixCaratheodory f measurable j)
          (\fun (x: Point) (inside: Sets.Member (Sigma.prefix f j) x) (increment: Sets.Member (Sigma.increments f j) x) => increment.right inside) }
        "=" _ "by" { congr!{Measure.Value Measure.Value} (\fun (v: Measure.Value) => Measure.add v (outer (Sigma.increments f j))) _ _ previous }
      }
    };
\definition prefixSeriesLower: \forall (f: N.Nat^ -> \Pow Point) -> (\forall (j: N.Nat^) -> Caratheodory (f j)) ->
  Values.Included (Measure.series (\fun (j: N.Nat^) => outer (Sigma.increments f j))) (outer (Measure.union f)) :=
  \fun (f: N.Nat^ -> \Pow Point) (measurable: \forall (j: N.Nat^) -> Caratheodory (f j))
    (r: Real.Real) (member: Measure.below (Measure.series (\fun (j: N.Nat^) => outer (Sigma.increments f j))) r) => \block {
      \takefrom j: \Cast[N.Nat^] ({ j: N.Nat^ \where Measure.below (Measure.partialSum (\fun (k: N.Nat^) => outer (Sigma.increments f k)) j) r }) \by member \then
      \let inPartial: Measure.below (Measure.partialSum (\fun (k: N.Nat^) => outer (Sigma.increments f k)) j) r :=
        \bysub(N.Nat^, { j: N.Nat^ \where Measure.below (Measure.partialSum (\fun (k: N.Nat^) => outer (Sigma.increments f k)) j) r }, j) \then
      \return monotone (Sigma.prefix f j) (Measure.union f) (Sigma.prefixContainedInUnion f j) r
        (\idelim Measure.partialSum (\fun (k: N.Nat^) => outer (Sigma.increments f k)) j = outer (Sigma.prefix f j) \with v: Measure.Value => Measure.below v r
          \by { base: inPartial, equality: sym!{Measure.Value} _ _ (prefixSum f measurable j) })
    };

\import N.Basic[].Def[] \as NatOp;
\import N.Basic[].Prop[] \as NatLaws;
\definition partialExtend: \forall (f: N.Nat^ -> Measure.Value) ->
  (\forall (k: N.Nat^) -> Measure.NonnegativeValue[f k]) -> \forall (j, k: N.Nat^) ->
  Values.Included (Measure.partialSum f j) (Measure.partialSum f (NatOp.add j k)) :=
  \fun (f: N.Nat^ -> Measure.Value) (nonnegative: \forall (k: N.Nat^) -> Measure.NonnegativeValue[f k]) (j: N.Nat^) =>
    \induction (k: N.Nat^) \return Values.Included (Measure.partialSum f j) (Measure.partialSum f (NatOp.add j k)) \with {
      | zero: \fun (_: Real.Real) (member: _) => member
      | succ: \fun (k: N.Nat^) (previous: _) (r: Real.Real) (member: _) =>
        partialStep f nonnegative (NatOp.add j k) r (previous r member)
    };
\definition partialAdd: \forall (f, g: N.Nat^ -> Measure.Value) (k: N.Nat^) ->
  Measure.partialSum (\fun (j: N.Nat^) => Measure.add (f j) (g j)) k =
    Measure.add (Measure.partialSum f k) (Measure.partialSum g k) :=
  \fun (f, g: N.Nat^ -> Measure.Value) => \induction (k: N.Nat^) \return
    Measure.partialSum (\fun (j: N.Nat^) => Measure.add (f j) (g j)) k = Measure.add (Measure.partialSum f k) (Measure.partialSum g k) \with {
      | zero: sym!{Measure.Value} _ _ (Values.addZero Measure.zero Values.zeroNonnegative)
      | succ: \fun (k: N.Nat^) (previous: _) => eq_reason_in!{Measure.Value _
        "=" _ "by" { congr!{Measure.Value Measure.Value} (\fun (v: Measure.Value) => Measure.add v (Measure.add (f k) (g k))) _ _ previous }
        "=" _ "by" { Values.addShuffle (Measure.partialSum f k) (Measure.partialSum g k) (f k) (g k) }
      }
    };
\definition seriesAdd: \forall (f, g: N.Nat^ -> Measure.Value) ->
  (\forall (j: N.Nat^) -> Measure.NonnegativeValue[f j]) -> (\forall (j: N.Nat^) -> Measure.NonnegativeValue[g j]) ->
  Measure.series (\fun (j: N.Nat^) => Measure.add (f j) (g j)) = Measure.add (Measure.series f) (Measure.series g) :=
  \fun (f, g: N.Nat^ -> Measure.Value) (fl: \forall (j: N.Nat^) -> Measure.NonnegativeValue[f j])
    (gl: \forall (j: N.Nat^) -> Measure.NonnegativeValue[g j]) =>
    \axiom:setext(Measure.series (\fun (j: N.Nat^) => Measure.add (f j) (g j)), Measure.add (Measure.series f) (Measure.series g),
      \fun (r: Real.Real) (member: Measure.below (Measure.series (\fun (j: N.Nat^) => Measure.add (f j) (g j))) r) => \block {
        \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Measure.below (Measure.partialSum (\fun (j: N.Nat^) => Measure.add (f j) (g j)) k) r }) \by member \then
        \let part: Measure.below (Measure.add (Measure.partialSum f k) (Measure.partialSum g k)) r :=
          \idelim Measure.partialSum (\fun (j: N.Nat^) => Measure.add (f j) (g j)) k = Measure.add (Measure.partialSum f k) (Measure.partialSum g k)
            \with v: Measure.Value => Measure.below v r \by {
              base: \bysub(N.Nat^, { k: N.Nat^ \where Measure.below (Measure.partialSum (\fun (j: N.Nat^) => Measure.add (f j) (g j)) k) r }, k),
              equality: partialAdd f g k } \then
        \takefrom a: \Cast[Real.Real] ({ a: Real.Real \where Logic.And[Measure.below (Measure.partialSum f k) a,
          \exists ( b: Real.Real \where Logic.And[Measure.below (Measure.partialSum g k) b, R.Lt r (Real.add a b)] )] }) \by part \then
        \let first: Logic.And[Measure.below (Measure.partialSum f k) a, \exists ( b: Real.Real \where Logic.And[Measure.below (Measure.partialSum g k) b, R.Lt r (Real.add a b)] )] :=
          \bysub(Real.Real, { a: Real.Real \where Logic.And[Measure.below (Measure.partialSum f k) a, \exists ( b: Real.Real \where Logic.And[Measure.below (Measure.partialSum g k) b, R.Lt r (Real.add a b)] )] }, a) \then
        \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where Logic.And[Measure.below (Measure.partialSum g k) b, R.Lt r (Real.add a b)] }) \by first.right \then
        \let second: Logic.And[Measure.below (Measure.partialSum g k) b, R.Lt r (Real.add a b)] :=
          \bysub(Real.Real, { b: Real.Real \where Logic.And[Measure.below (Measure.partialSum g k) b, R.Lt r (Real.add a b)] }, b) \then
        \return Logic.existsIntro[Real.Real, { a: Real.Real \where Logic.And[Measure.below (Measure.series f) a,
          \exists ( b: Real.Real \where Logic.And[Measure.below (Measure.series g) b, R.Lt r (Real.add a b)] )] }] a
          (Logic.And[_, _]::# (Logic.existsIntro[N.Nat^, { j: N.Nat^ \where Measure.below (Measure.partialSum f j) a }] k first.left)
            (Logic.existsIntro[Real.Real, { b: Real.Real \where Logic.And[Measure.below (Measure.series g) b, R.Lt r (Real.add a b)] }] b
              (Logic.And[_, _]::# (Logic.existsIntro[N.Nat^, { j: N.Nat^ \where Measure.below (Measure.partialSum g j) b }] k second.left) second.right)))
      },
      \fun (r: Real.Real) (member: Measure.below (Measure.add (Measure.series f) (Measure.series g)) r) => \block {
        \takefrom a: \Cast[Real.Real] ({ a: Real.Real \where Logic.And[Measure.below (Measure.series f) a,
          \exists ( b: Real.Real \where Logic.And[Measure.below (Measure.series g) b, R.Lt r (Real.add a b)] )] }) \by member \then
        \let first: Logic.And[Measure.below (Measure.series f) a, \exists ( b: Real.Real \where Logic.And[Measure.below (Measure.series g) b, R.Lt r (Real.add a b)] )] :=
          \bysub(Real.Real, { a: Real.Real \where Logic.And[Measure.below (Measure.series f) a, \exists ( b: Real.Real \where Logic.And[Measure.below (Measure.series g) b, R.Lt r (Real.add a b)] )] }, a) \then
        \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where Logic.And[Measure.below (Measure.series g) b, R.Lt r (Real.add a b)] }) \by first.right \then
        \let second: Logic.And[Measure.below (Measure.series g) b, R.Lt r (Real.add a b)] :=
          \bysub(Real.Real, { b: Real.Real \where Logic.And[Measure.below (Measure.series g) b, R.Lt r (Real.add a b)] }, b) \then
        \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Measure.below (Measure.partialSum f k) a }) \by first.left \then
        \takefrom l: \Cast[N.Nat^] ({ l: N.Nat^ \where Measure.below (Measure.partialSum g l) b }) \by second.left \then
        \let common: N.Nat^ := NatOp.add k l \then
        \let inF: Measure.below (Measure.partialSum f common) a := partialExtend f fl k l a
          (\bysub(N.Nat^, { k: N.Nat^ \where Measure.below (Measure.partialSum f k) a }, k)) \then
        \let inG: Measure.below (Measure.partialSum g common) b :=
          \idelim NatOp.add l k = common \with m: N.Nat^ => Measure.below (Measure.partialSum g m) b
            \by { base: partialExtend g gl l k b (\bysub(N.Nat^, { l: N.Nat^ \where Measure.below (Measure.partialSum g l) b }, l)), equality: NatLaws.addComm l k } \then
        \let part: Measure.below (Measure.add (Measure.partialSum f common) (Measure.partialSum g common)) r :=
          Logic.existsIntro[Real.Real, { a: Real.Real \where Logic.And[Measure.below (Measure.partialSum f common) a,
            \exists ( b: Real.Real \where Logic.And[Measure.below (Measure.partialSum g common) b, R.Lt r (Real.add a b)] )] }] a
            (Logic.And[_, _]::# inF (Logic.existsIntro[Real.Real, { b: Real.Real \where Logic.And[Measure.below (Measure.partialSum g common) b, R.Lt r (Real.add a b)] }] b
              (Logic.And[_, _]::# inG second.right))) \then
        \return Logic.existsIntro[N.Nat^, { j: N.Nat^ \where Measure.below (Measure.partialSum (\fun (k: N.Nat^) => Measure.add (f k) (g k)) j) r }] common
          (\idelim Measure.add (Measure.partialSum f common) (Measure.partialSum g common) = Measure.partialSum (\fun (k: N.Nat^) => Measure.add (f k) (g k)) common
            \with v: Measure.Value => Measure.below v r \by { base: part, equality: sym!{Measure.Value} _ _ (partialAdd f g common) })
      });

\definition twice: N.Nat^ -> N.Nat^ :=
  \induction (j: N.Nat^) \return N.Nat^ \with {
    | zero: N.Nat^::zero
    | succ: \fun (_: N.Nat^) (previous: N.Nat^) => N.Nat^::succ (N.Nat^::succ previous)
  };
\definition weave: \forall (j: N.Nat^) -> (N.Nat^ -> Box) -> (N.Nat^ -> Box) -> Box :=
  \induction (j: N.Nat^) \return (N.Nat^ -> Box) -> (N.Nat^ -> Box) -> Box \with {
    | zero: \fun (f, g: N.Nat^ -> Box) => f N.Nat^::zero
    | succ: \fun (j: N.Nat^) (previous: (N.Nat^ -> Box) -> (N.Nat^ -> Box) -> Box) (f, g: N.Nat^ -> Box) =>
      previous g (\fun (i: N.Nat^) => f (N.Nat^::succ i))
  };
\definition weaveEven: \forall (j: N.Nat^) (f, g: N.Nat^ -> Box) -> weave (twice j) f g = f j :=
  \induction (j: N.Nat^) \return \forall (f, g: N.Nat^ -> Box) -> weave (twice j) f g = f j \with {
    | zero: \fun (f, g: _) => \refl(f N.Nat^::zero)
    | succ: \fun (j: N.Nat^) (previous: _) (f, g: _) =>
      previous (\fun (i: N.Nat^) => f (N.Nat^::succ i)) (\fun (i: N.Nat^) => g (N.Nat^::succ i))
  };
\definition weaveOdd: \forall (j: N.Nat^) (f, g: N.Nat^ -> Box) -> weave (N.Nat^::succ (twice j)) f g = g j :=
  \induction (j: N.Nat^) \return \forall (f, g: N.Nat^ -> Box) -> weave (N.Nat^::succ (twice j)) f g = g j \with {
    | zero: \fun (f, g: _) => \refl(g N.Nat^::zero)
    | succ: \fun (j: N.Nat^) (previous: _) (f, g: _) =>
      previous (\fun (i: N.Nat^) => f (N.Nat^::succ i)) (\fun (i: N.Nat^) => g (N.Nat^::succ i))
  };
\definition weaveCovers: \forall (S, T: \Pow Point) (f, g: N.Nat^ -> Box) -> Covers f S -> Covers g T ->
  Covers (\fun (j: N.Nat^) => weave j f g) (Sigma.pairUnion S T) :=
  \fun (S, T: \Pow Point) (f, g: N.Nat^ -> Box) (sf: Covers f S) (tg: Covers g T) (x: Point)
    (member: Sets.Member (Sigma.pairUnion S T) x) =>
      Logic.orElim _ _ (\exists ( j: N.Nat^ \where Sets.Member (points (weave j f g)) x )) member
        (\fun (inS: Sets.Member S x) => \block {
          \takefrom j: \Cast[N.Nat^] ({ j: N.Nat^ \where Sets.Member (points (f j)) x }) \by sf x inS \then
          \return Logic.existsIntro[N.Nat^, { j: N.Nat^ \where Sets.Member (points (weave j f g)) x }] (twice j)
            (\idelim f j = weave (twice j) f g \with b: Box => Sets.Member (points b) x
              \by { base: \bysub(N.Nat^, { j: N.Nat^ \where Sets.Member (points (f j)) x }, j), equality: sym!{Box} _ _ (weaveEven j f g) })
        })
        (\fun (inT: Sets.Member T x) => \block {
          \takefrom j: \Cast[N.Nat^] ({ j: N.Nat^ \where Sets.Member (points (g j)) x }) \by tg x inT \then
          \return Logic.existsIntro[N.Nat^, { j: N.Nat^ \where Sets.Member (points (weave j f g)) x }] (N.Nat^::succ (twice j))
            (\idelim g j = weave (N.Nat^::succ (twice j)) f g \with b: Box => Sets.Member (points b) x
              \by { base: \bysub(N.Nat^, { j: N.Nat^ \where Sets.Member (points (g j)) x }, j), equality: sym!{Box} _ _ (weaveOdd j f g) })
        });
\definition twiceAdd: \forall (j: N.Nat^) -> twice j = NatOp.add j j :=
  \induction (j: N.Nat^) \return twice j = NatOp.add j j \with {
    | zero: \refl(N.Nat^::zero)
    | succ: \fun (j: N.Nat^) (previous: _) => eq_reason_in!{N.Nat^ _
      "=" _ "by" { congr!{N.Nat^ N.Nat^} (\fun (m: N.Nat^) => N.Nat^::succ (N.Nat^::succ m)) _ _ previous }
      "=" _ "by" { congr!{N.Nat^ N.Nat^} (\fun (m: N.Nat^) => N.Nat^::succ m) _ _ (sym!{N.Nat^} _ _ (NatLaws.addSuccLeft j j)) }
    }
  };
\definition weavePartialEven: \forall (f, g: N.Nat^ -> Box) (j: N.Nat^) ->
  Measure.partialSum (\fun (i: N.Nat^) => volumeValue (weave i f g)) (twice j) =
    Measure.add (Measure.partialSum (\fun (i: N.Nat^) => volumeValue (f i)) j) (Measure.partialSum (\fun (i: N.Nat^) => volumeValue (g i)) j) :=
  \fun (f, g: N.Nat^ -> Box) => \induction (j: N.Nat^) \return
    Measure.partialSum (\fun (i: N.Nat^) => volumeValue (weave i f g)) (twice j) =
      Measure.add (Measure.partialSum (\fun (i: N.Nat^) => volumeValue (f i)) j) (Measure.partialSum (\fun (i: N.Nat^) => volumeValue (g i)) j) \with {
    | zero: sym!{Measure.Value} _ _ (Values.addZero Measure.zero Values.zeroNonnegative)
    | succ: \fun (j: N.Nat^) (previous: _) => eq_reason_in!{Measure.Value _
      "=" _ "by" { congr!{Measure.Value Measure.Value} (\fun (v: Measure.Value) => Measure.add v (volumeValue (weave (N.Nat^::succ (twice j)) f g))) _ _
        (congr!{Measure.Value Measure.Value Measure.Value} Measure.add _ _ _ _ previous
          (congr!{Box Measure.Value} volumeValue _ _ (weaveEven j f g))) }
      "=" _ "by" { congr!{Measure.Value Measure.Value} (Measure.add (Measure.add
        (Measure.add (Measure.partialSum (\fun (i: N.Nat^) => volumeValue (f i)) j) (Measure.partialSum (\fun (i: N.Nat^) => volumeValue (g i)) j)) (volumeValue (f j)))) _ _
        (congr!{Box Measure.Value} volumeValue _ _ (weaveOdd j f g)) }
      "=" _ "by" { Values.addAssoc
        (Measure.add (Measure.partialSum (\fun (i: N.Nat^) => volumeValue (f i)) j) (Measure.partialSum (\fun (i: N.Nat^) => volumeValue (g i)) j)) (volumeValue (f j)) (volumeValue (g j)) }
      "=" _ "by" { Values.addShuffle (Measure.partialSum (\fun (i: N.Nat^) => volumeValue (f i)) j)
        (Measure.partialSum (\fun (i: N.Nat^) => volumeValue (g i)) j) (volumeValue (f j)) (volumeValue (g j)) }
    }
  };
\definition partialBelowSeries: \forall (f: N.Nat^ -> Measure.Value) (j: N.Nat^) ->
  Values.Included (Measure.partialSum f j) (Measure.series f) :=
  \fun (f: N.Nat^ -> Measure.Value) (j: N.Nat^) (r: Real.Real) (member: Measure.below (Measure.partialSum f j) r) =>
    Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Measure.below (Measure.partialSum f k) r }] j member;
\definition weaveCost: \forall (f, g: N.Nat^ -> Box) ->
  cost (\fun (i: N.Nat^) => weave i f g) = Measure.add (cost f) (cost g) :=
  \fun (f, g: N.Nat^ -> Box) => \block {
    \let wf: N.Nat^ -> Measure.Value := \fun (i: N.Nat^) => volumeValue (weave i f g) \then
    \let fv: N.Nat^ -> Measure.Value := \fun (i: N.Nat^) => volumeValue (f i) \then
    \let gv: N.Nat^ -> Measure.Value := \fun (i: N.Nat^) => volumeValue (g i) \then
    \let combined: N.Nat^ -> Measure.Value := \fun (i: N.Nat^) => Measure.add (fv i) (gv i) \then
    \return \axiom:setext(cost (\fun (i: N.Nat^) => weave i f g), Measure.add (cost f) (cost g),
      \fun (r: Real.Real) (member: Measure.below (Measure.series wf) r) => \block {
        \takefrom j: \Cast[N.Nat^] ({ j: N.Nat^ \where Measure.below (Measure.partialSum wf j) r }) \by member \then
        \let extended: Measure.below (Measure.partialSum wf (NatOp.add j j)) r :=
          partialExtend wf (\fun (i: N.Nat^) => volumeValueNonnegative (weave i f g)) j j r
            (\bysub(N.Nat^, { j: N.Nat^ \where Measure.below (Measure.partialSum wf j) r }, j)) \then
        \let even: Measure.below (Measure.partialSum wf (twice j)) r :=
          \idelim NatOp.add j j = twice j \with k: N.Nat^ => Measure.below (Measure.partialSum wf k) r
            \by { base: extended, equality: sym!{N.Nat^} _ _ (twiceAdd j) } \then
        \let parts: Measure.below (Measure.add (Measure.partialSum fv j) (Measure.partialSum gv j)) r :=
          \idelim Measure.partialSum wf (twice j) = Measure.add (Measure.partialSum fv j) (Measure.partialSum gv j) \with v: Measure.Value => Measure.below v r
            \by { base: even, equality: weavePartialEven f g j } \then
        \return Values.addMono (Measure.partialSum fv j) (Measure.series fv) (Measure.partialSum gv j) (Measure.series gv)
          (partialBelowSeries fv j) (partialBelowSeries gv j) r parts
      },
      \fun (r: Real.Real) (member: Measure.below (Measure.add (Measure.series fv) (Measure.series gv)) r) => \block {
        \let inCombined: Measure.below (Measure.series combined) r :=
          \idelim Measure.add (Measure.series fv) (Measure.series gv) = Measure.series combined \with v: Measure.Value => Measure.below v r
            \by { base: member, equality: sym!{Measure.Value} _ _ (seriesAdd fv gv (\fun (i: N.Nat^) => volumeValueNonnegative (f i)) (\fun (i: N.Nat^) => volumeValueNonnegative (g i))) } \then
        \takefrom j: \Cast[N.Nat^] ({ j: N.Nat^ \where Measure.below (Measure.partialSum combined j) r }) \by inCombined \then
        \let parts: Measure.below (Measure.add (Measure.partialSum fv j) (Measure.partialSum gv j)) r :=
          \idelim Measure.partialSum combined j = Measure.add (Measure.partialSum fv j) (Measure.partialSum gv j) \with v: Measure.Value => Measure.below v r
            \by { base: \bysub(N.Nat^, { j: N.Nat^ \where Measure.below (Measure.partialSum combined j) r }, j), equality: partialAdd fv gv j } \then
        \return Logic.existsIntro[N.Nat^, { j: N.Nat^ \where Measure.below (Measure.partialSum wf j) r }] (twice j)
          (\idelim Measure.add (Measure.partialSum fv j) (Measure.partialSum gv j) = Measure.partialSum wf (twice j) \with v: Measure.Value => Measure.below v r
            \by { base: parts, equality: sym!{Measure.Value} _ _ (weavePartialEven f g j) })
      })
  };
\definition unionBoundedByCovers: \forall (S, T: \Pow Point) (f, g: N.Nat^ -> Box) -> Covers f S -> Covers g T ->
  Values.Included (outer (Sigma.pairUnion S T)) (Measure.add (cost f) (cost g)) :=
  \fun (S, T: \Pow Point) (f, g: N.Nat^ -> Box) (sf: Covers f S) (tg: Covers g T)
    (r: Real.Real) (member: Measure.below (outer (Sigma.pairUnion S T)) r) =>
    \idelim cost (\fun (i: N.Nat^) => weave i f g) = Measure.add (cost f) (cost g) \with v: Measure.Value => Measure.below v r
      \by { base: boundedByCover (Sigma.pairUnion S T) (\fun (i: N.Nat^) => weave i f g) (weaveCovers S T f g sf tg) r member,
        equality: weaveCost f g };

\import dedekind_reals.DedekindReal[].Completeness[] \as Complete;
\import real.Analysis[].Estimates[].Product[] \as Product;
\import Measure.ValueLaws[].SupAdd[] \as SupAdd;
\definition negativeOne: R.Lt (Real.neg Real.one) Real.zero :=
  R.ltReplaceRight (Real.neg Real.one) (Real.neg Real.zero) Real.zero Laws.negZero
    (Laws.negStrictAntitone Real.zero Real.one Product.onePositive);
\definition valueUpper: \forall (v: Measure.Value) -> Measure.NonnegativeValue[v] -> \forall (b: Real.Real) ->
  Logic.Not (Measure.below v b) -> Complete.UpperBound v b :=
  \fun (v: Measure.Value) (valid: Measure.NonnegativeValue[v]) (b: Real.Real) (outside: Logic.Not (Measure.below v b))
    (x: Real.Real) (member: Measure.below v x) => Order.leOfNotLtReverse x b
      (\fun (less: R.Lt b x) => outside (valid.downward b x less member));
\definition valueSup: \forall (v: Measure.Value) -> Measure.NonnegativeValue[v] -> \forall (b: Real.Real) ->
  Logic.Not (Measure.below v b) -> \exists ( u: Real.Real \where Complete.LeastUpperBound[v, u] ) :=
  \fun (v: Measure.Value) (valid: Measure.NonnegativeValue[v]) (b: Real.Real) (outside: Logic.Not (Measure.below v b)) =>
    Complete.complete v (\exact(\into[Real.Real](Real.neg Real.one, v) \by { valid.negative (Real.neg Real.one) negativeOne }, \Cast[Real.Real] v))
      (Logic.existsIntro[Real.Real, { u: Real.Real \where Complete.UpperBound v u }] b (valueUpper v valid b outside));
\definition supBelow: \forall (v: Measure.Value) (u, b: Real.Real) ->
  Complete.LeastUpperBound[v, u] -> Measure.NonnegativeValue[v] -> R.Lt u b -> Logic.Not (Measure.below v b) :=
  \fun (v: Measure.Value) (u, b: Real.Real) (sup: Complete.LeastUpperBound[v, u]) (_: Measure.NonnegativeValue[v])
    (less: R.Lt u b) (member: Measure.below v b) => R.ltNotLeReverse u b less (sup.upper b member);
\structure SplitAbove[r, p, q, a, b: Real.Real]: \Prop := {
  left: R.Lt p a,
  right: R.Lt q b,
  total: R.Lt (Real.add a b) r,
};
\definition splitAbove: \forall (r, p, q: Real.Real) -> R.Lt (Real.add p q) r ->
  \exists ( a: Real.Real \where \exists ( b: Real.Real \where SplitAbove[r, p, q, a, b] ) ) :=
  \fun (r, p, q: Real.Real) (less: R.Lt (Real.add p q) r) => \block {
    \let negative: R.Lt (Real.neg r) (Real.add (Real.neg p) (Real.neg q)) :=
      R.ltReplaceRight (Real.neg r) (Real.neg (Real.add p q)) (Real.add (Real.neg p) (Real.neg q)) (Laws.negAdd p q)
        (Laws.negStrictAntitone (Real.add p q) r less) \then
    \takefrom x: \Cast[Real.Real] ({ x: Real.Real \where \exists ( y: Real.Real \where Values.SplitBelow[Real.neg r, Real.neg p, Real.neg q, x, y] ) })
      \by Values.splitBelow (Real.neg r) (Real.neg p) (Real.neg q) negative \then
    \takefrom y: \Cast[Real.Real] ({ y: Real.Real \where Values.SplitBelow[Real.neg r, Real.neg p, Real.neg q, x, y] })
      \by (\bysub(Real.Real, { x: Real.Real \where \exists ( y: Real.Real \where Values.SplitBelow[Real.neg r, Real.neg p, Real.neg q, x, y] ) }, x)) \then
    \let split: Values.SplitBelow[Real.neg r, Real.neg p, Real.neg q, x, y] :=
      \bysub(Real.Real, { y: Real.Real \where Values.SplitBelow[Real.neg r, Real.neg p, Real.neg q, x, y] }, y) \then
    \return Logic.existsIntro[Real.Real, { a: Real.Real \where \exists ( b: Real.Real \where SplitAbove[r, p, q, a, b] ) }] (Real.neg x)
      (Logic.existsIntro[Real.Real, { b: Real.Real \where SplitAbove[r, p, q, Real.neg x, b] }] (Real.neg y)
        (SplitAbove[r, p, q, Real.neg x, Real.neg y] {
          left := R.ltReplaceLeft (Real.neg (Real.neg p)) p (Real.neg x) (Laws.negInvolutive p) (Laws.negStrictAntitone x (Real.neg p) split.left),
          right := R.ltReplaceLeft (Real.neg (Real.neg q)) q (Real.neg y) (Laws.negInvolutive q) (Laws.negStrictAntitone y (Real.neg q) split.right),
          total := R.ltReplaceRight (Real.add (Real.neg x) (Real.neg y)) (Real.neg (Real.neg r)) r (Laws.negInvolutive r)
            (R.ltReplaceLeft (Real.neg (Real.add x y)) (Real.add (Real.neg x) (Real.neg y)) (Real.neg (Real.neg r))
              (Laws.negAdd x y) (Laws.negStrictAntitone (Real.neg r) (Real.add x y) split.total)),
        }))
  };
\definition supremumOutside: \forall (v: Measure.Value) (p: Real.Real) -> Measure.NonnegativeValue[v] ->
  Complete.LeastUpperBound[v, p] -> Logic.Not (Measure.below v p) :=
  \fun (v: Measure.Value) (p: Real.Real) (valid: Measure.NonnegativeValue[v]) (sup: Complete.LeastUpperBound[v, p])
    (member: Measure.below v p) => \block {
      \takefrom q: \Cast[Real.Real] ({ q: Real.Real \where Logic.And[R.Lt p q, Measure.below v q] }) \by valid.rounded p member \then
      \let law: Logic.And[R.Lt p q, Measure.below v q] := \bysub(Real.Real, { q: Real.Real \where Logic.And[R.Lt p q, Measure.below v q] }, q) \then
      \return R.ltNotLeReverse p q law.left (sup.upper q law.right)
    };
\definition addUpper: \forall (v, w: Measure.Value) (a, b: Real.Real) -> Complete.UpperBound v a -> Complete.UpperBound w b ->
  Complete.UpperBound (Measure.add v w) (Real.add a b) :=
  \fun (v, w: Measure.Value) (a, b: Real.Real) (va: Complete.UpperBound v a) (wb: Complete.UpperBound w b)
    (r: Real.Real) (member: Measure.below (Measure.add v w) r) => \block {
      \takefrom x: \Cast[Real.Real] ({ x: Real.Real \where Logic.And[Measure.below v x, \exists ( y: Real.Real \where Logic.And[Measure.below w y, R.Lt r (Real.add x y)] )] }) \by member \then
      \let first: Logic.And[Measure.below v x, \exists ( y: Real.Real \where Logic.And[Measure.below w y, R.Lt r (Real.add x y)] )] :=
        \bysub(Real.Real, { x: Real.Real \where Logic.And[Measure.below v x, \exists ( y: Real.Real \where Logic.And[Measure.below w y, R.Lt r (Real.add x y)] )] }, x) \then
      \takefrom y: \Cast[Real.Real] ({ y: Real.Real \where Logic.And[Measure.below w y, R.Lt r (Real.add x y)] }) \by first.right \then
      \let second: Logic.And[Measure.below w y, R.Lt r (Real.add x y)] :=
        \bysub(Real.Real, { y: Real.Real \where Logic.And[Measure.below w y, R.Lt r (Real.add x y)] }, y) \then
      \return Order.leOfLt r (Real.add a b) (R.ltLeTrans r (Real.add x y) (Real.add a b) second.right (Estimates.addLe x y a b (va x first.left) (wb y second.left)))
    };
\definition subadditivePair: \forall (S, T: \Pow Point) -> Values.Included (outer (Sigma.pairUnion S T)) (Measure.add (outer S) (outer T)) :=
  \fun (S, T: \Pow Point) (r: Real.Real) (member: Measure.below (outer (Sigma.pairUnion S T)) r) =>
    Sigma.doubleNegative (Measure.below (Measure.add (outer S) (outer T)) r)
      (\fun (outside: Logic.Not (Measure.below (Measure.add (outer S) (outer T)) r)) => \block {
        \let sOutside: Logic.Not (Measure.below (outer S) r) := \fun (inS: Measure.below (outer S) r) =>
          outside (Series.pairLeftIncluded (outer S) (outer T) (outerNonnegative S) (outerNonnegative T) r inS) \then
        \let tOutside: Logic.Not (Measure.below (outer T) r) := \fun (inT: Measure.below (outer T) r) =>
          outside (\idelim Measure.add (outer T) (outer S) = Measure.add (outer S) (outer T) \with v: Measure.Value => Measure.below v r
            \by { base: Series.pairLeftIncluded (outer T) (outer S) (outerNonnegative T) (outerNonnegative S) r inT,
              equality: Values.addComm (outer T) (outer S) }) \then
        \takefrom p: \Cast[Real.Real] ({ p: Real.Real \where Complete.LeastUpperBound[outer S, p] }) \by valueSup (outer S) (outerNonnegative S) r sOutside \then
        \takefrom q: \Cast[Real.Real] ({ q: Real.Real \where Complete.LeastUpperBound[outer T, q] }) \by valueSup (outer T) (outerNonnegative T) r tOutside \then
        \let ps: Complete.LeastUpperBound[outer S, p] := \bysub(Real.Real, { p: Real.Real \where Complete.LeastUpperBound[outer S, p] }, p) \then
        \let qs: Complete.LeastUpperBound[outer T, q] := \bysub(Real.Real, { q: Real.Real \where Complete.LeastUpperBound[outer T, q] }, q) \then
        \let sumBound: R.Le (Real.add p q) r := (SupAdd.leastUpper (outer S) (outer T) p q ps qs).least r
          (valueUpper (Measure.add (outer S) (outer T)) (Values.addNonnegative (outer S) (outer T) (outerNonnegative S) (outerNonnegative T)) r outside) \then
        \takefrom t: \Cast[Real.Real] ({ t: Real.Real \where Logic.And[R.Lt r t, \forall (family: N.Nat^ -> Box) -> Covers family (Sigma.pairUnion S T) -> Measure.below (cost family) t] }) \by member \then
        \let law: Logic.And[R.Lt r t, \forall (family: N.Nat^ -> Box) -> Covers family (Sigma.pairUnion S T) -> Measure.below (cost family) t] :=
          \bysub(Real.Real, { t: Real.Real \where Logic.And[R.Lt r t, \forall (family: N.Nat^ -> Box) -> Covers family (Sigma.pairUnion S T) -> Measure.below (cost family) t] }, t) \then
        \takefrom a: \Cast[Real.Real] ({ a: Real.Real \where \exists ( b: Real.Real \where SplitAbove[t, p, q, a, b] ) })
          \by splitAbove t p q (R.leLtTrans (Real.add p q) r t sumBound law.left) \then
        \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where SplitAbove[t, p, q, a, b] })
          \by (\bysub(Real.Real, { a: Real.Real \where \exists ( b: Real.Real \where SplitAbove[t, p, q, a, b] ) }, a)) \then
        \let split: SplitAbove[t, p, q, a, b] := \bysub(Real.Real, { b: Real.Real \where SplitAbove[t, p, q, a, b] }, b) \then
        \takefrom f: \Cast[N.Nat^ -> Box] ({ f: N.Nat^ -> Box \where Logic.And[Covers f S, Logic.Not (Measure.below (cost f) a)] })
          \by approximateCover S p a split.left (supremumOutside (outer S) p (outerNonnegative S) ps) \then
        \takefrom g: \Cast[N.Nat^ -> Box] ({ g: N.Nat^ -> Box \where Logic.And[Covers g T, Logic.Not (Measure.below (cost g) b)] })
          \by approximateCover T q b split.right (supremumOutside (outer T) q (outerNonnegative T) qs) \then
        \let fl: Logic.And[Covers f S, Logic.Not (Measure.below (cost f) a)] :=
          \bysub(N.Nat^ -> Box, { f: N.Nat^ -> Box \where Logic.And[Covers f S, Logic.Not (Measure.below (cost f) a)] }, f) \then
        \let gl: Logic.And[Covers g T, Logic.Not (Measure.below (cost g) b)] :=
          \bysub(N.Nat^ -> Box, { g: N.Nat^ -> Box \where Logic.And[Covers g T, Logic.Not (Measure.below (cost g) b)] }, g) \then
        \let inCosts: Measure.below (Measure.add (cost f) (cost g)) t :=
          \idelim cost (\fun (j: N.Nat^) => weave j f g) = Measure.add (cost f) (cost g) \with v: Measure.Value => Measure.below v t
            \by { base: law.right (\fun (j: N.Nat^) => weave j f g) (weaveCovers S T f g fl.left gl.left), equality: weaveCost f g } \then
        \return R.ltNotLeReverse (Real.add a b) t split.total
          (addUpper (cost f) (cost g) a b (valueUpper (cost f) (costNonnegative f) a fl.right) (valueUpper (cost g) (costNonnegative g) b gl.right) t inCosts)
      });
\definition outerSubsetZero: \forall (S, T: \Pow Point) -> Sets.Subset S T -> outer T = Measure.zero -> outer S = Measure.zero :=
  \fun (S, T: \Pow Point) (included: Sets.Subset S T) (null: outer T = Measure.zero) =>
    \axiom:setext(outer S, Measure.zero,
      \fun (r: Real.Real) (member: Measure.below (outer S) r) =>
        \idelim outer T = Measure.zero \with v: Measure.Value => Measure.below v r
          \by { base: monotone S T included r member, equality: null },
      \fun (r: Real.Real) (negative: R.Lt r Real.zero) => (outerNonnegative S).negative r negative);
\definition partitionUnion: \forall (T, S: \Pow Point) ->
  T = Sigma.pairUnion (Sets.Intersection T S) (Sets.Intersection T (Sets.Complement S)) :=
  \fun (T, S: \Pow Point) => \axiom:setext(T, Sigma.pairUnion (Sets.Intersection T S) (Sets.Intersection T (Sets.Complement S)),
    \fun (x: Point) (member: Sets.Member T x) => Logic.orElim _ _ (Sets.Member (Sigma.pairUnion (Sets.Intersection T S) (Sets.Intersection T (Sets.Complement S))) x)
      (Classical.excludedMiddle (Sets.Member S x))
      (\fun (inS: Sets.Member S x) => Logic.Or[_, _]::left (Logic.And[_, _]::# member inS))
      (\fun (outside: Logic.Not (Sets.Member S x)) => Logic.Or[_, _]::right (Logic.And[_, _]::# member outside)),
    \fun (x: Point) (member: Sets.Member (Sigma.pairUnion (Sets.Intersection T S) (Sets.Intersection T (Sets.Complement S))) x) =>
      Logic.orElim _ _ (Sets.Member T x) member (\fun (left: Sets.Member (Sets.Intersection T S) x) => left.left)
        (\fun (right: Sets.Member (Sets.Intersection T (Sets.Complement S)) x) => right.left));
\definition nullCaratheodory: \forall (S: \Pow Point) -> outer S = Measure.zero -> Caratheodory S :=
  \fun (S: \Pow Point) (null: outer S = Measure.zero) (T: \Pow Point) => \block {
    \let left: \Pow Point := Sets.Intersection T S \then
    \let right: \Pow Point := Sets.Intersection T (Sets.Complement S) \then
    \let leftZero: outer left = Measure.zero := outerSubsetZero left S
      (\fun (x: Point) (member: Sets.Member left x) => member.right) null \then
    \let forward: Values.Included (outer T) (outer right) := \fun (r: Real.Real) (member: Measure.below (outer T) r) => \block {
      \let inUnion: Measure.below (outer (Sigma.pairUnion left right)) r :=
        \idelim T = Sigma.pairUnion left right \with V: \Pow Point => Measure.below (outer V) r
          \by { base: member, equality: partitionUnion T S } \then
      \let inSum: Measure.below (Measure.add (outer left) (outer right)) r := subadditivePair left right r inUnion \then
      \return \idelim Measure.add (outer left) (outer right) = outer right \with v: Measure.Value => Measure.below v r
        \by { base: inSum, equality: eq_reason_in!{Measure.Value _
          "=" _ "by" { congr!{Measure.Value Measure.Value} (\fun (v: Measure.Value) => Measure.add v (outer right)) _ _ leftZero }
          "=" _ "by" { Series.zeroAdd (outer right) (outerNonnegative right) }
        } }
    } \then
    \let equalRight: outer T = outer right := \axiom:setext(outer T, outer right, forward,
      monotone right T (\fun (x: Point) (inRight: Sets.Member right x) => inRight.left)) \then
    \return eq_reason_in!{Measure.Value _
      "=" _ "by" { equalRight }
      "=" _ "by" { sym!{Measure.Value} _ _ (Series.zeroAdd (outer right) (outerNonnegative right)) }
      "=" _ "by" { congr!{Measure.Value Measure.Value} (\fun (v: Measure.Value) => Measure.add v (outer right)) _ _ (sym!{Measure.Value} _ _ leftZero) }
    }
  };
\definition seriesContains: \forall (f: N.Nat^ -> Measure.Value) -> (\forall (j: N.Nat^) -> Measure.NonnegativeValue[f j]) ->
  \forall (j: N.Nat^) -> Values.Included (f j) (Measure.series f) :=
  \fun (f: N.Nat^ -> Measure.Value) (nonnegative: \forall (j: N.Nat^) -> Measure.NonnegativeValue[f j])
    (j: N.Nat^) (r: Real.Real) (member: Measure.below (f j) r) =>
    partialBelowSeries f (N.Nat^::succ j) r
      (\idelim Measure.add (f j) (Measure.partialSum f j) = Measure.add (Measure.partialSum f j) (f j) \with v: Measure.Value => Measure.below v r
        \by { base: Series.pairLeftIncluded (f j) (Measure.partialSum f j) (nonnegative j) (partialNonnegative f nonnegative j) r member,
          equality: Values.addComm (f j) (Measure.partialSum f j) });

\import N.Pair[].Def[] \as NatPair;
\import N.Pair[].Enumeration[] \as Enumeration;
\definition flatten[families: N.Nat^ -> N.Nat^ -> Box] [j: N.Nat^]: Box :=
  families (NatPair.natPairFirst (Enumeration.enumerate j)) (NatPair.natPairSecond (Enumeration.enumerate j));
\definition flattenCovers: \forall (sets: N.Nat^ -> \Pow Point) (families: N.Nat^ -> N.Nat^ -> Box) ->
  (\forall (i: N.Nat^) -> Covers (families i) (sets i)) -> Covers (flatten families) (Measure.union sets) :=
  \fun (sets: N.Nat^ -> \Pow Point) (families: N.Nat^ -> N.Nat^ -> Box) (covers: \forall (i: N.Nat^) -> Covers (families i) (sets i))
    (x: Point) (member: Sets.Member (Measure.union sets) x) => \block {
      \takefrom i: \Cast[N.Nat^] ({ i: N.Nat^ \where Sets.Member (sets i) x }) \by member \then
      \let inSet: Sets.Member (sets i) x := \bysub(N.Nat^, { i: N.Nat^ \where Sets.Member (sets i) x }, i) \then
      \takefrom j: \Cast[N.Nat^] ({ j: N.Nat^ \where Sets.Member (points (families i j)) x }) \by covers i x inSet \then
      \let inBox: Sets.Member (points (families i j)) x := \bysub(N.Nat^, { j: N.Nat^ \where Sets.Member (points (families i j)) x }, j) \then
      \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Enumeration.enumerate k = NatPair.natPair i j }) \by Enumeration.exhaustive i j \then
      \let equality: Enumeration.enumerate k = NatPair.natPair i j :=
        \bysub(N.Nat^, { k: N.Nat^ \where Enumeration.enumerate k = NatPair.natPair i j }, k) \then
      \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Sets.Member (points (flatten families k)) x }] k
        (\idelim NatPair.natPair i j = Enumeration.enumerate k \with pair: NatPair.NatPair =>
          Sets.Member (points (families (NatPair.natPairFirst pair) (NatPair.natPairSecond pair))) x
          \by { base: inBox, equality: sym!{NatPair.NatPair} _ _ equality })
    };
\module Borel;
\definition prefixSubadditive: \forall (sets: N.Nat^ -> \Pow Point) (j: N.Nat^) ->
  Values.Included (outer (Sigma.prefix sets j)) (Measure.partialSum (\fun (k: N.Nat^) => outer (sets k)) j) :=
  \fun (sets: N.Nat^ -> \Pow Point) => \induction (j: N.Nat^) \return
    Values.Included (outer (Sigma.prefix sets j)) (Measure.partialSum (\fun (k: N.Nat^) => outer (sets k)) j) \with {
    | zero: \fun (r: Real.Real) (member: Measure.below (outer Sets.Empty) r) =>
      \idelim outer Sets.Empty = Measure.zero \with v: Measure.Value => Measure.below v r \by { base: member, equality: outerEmpty }
    | succ: \fun (j: N.Nat^) (previous: _) (r: Real.Real) (member: Measure.below (outer (Sigma.prefix sets (N.Nat^::succ j))) r) =>
      Values.addMono (outer (Sigma.prefix sets j)) (Measure.partialSum (\fun (k: N.Nat^) => outer (sets k)) j) (outer (sets j)) (outer (sets j))
        previous (\fun (v: Real.Real) (inValue: Measure.below (outer (sets j)) v) => inValue) r
        (subadditivePair (Sigma.prefix sets j) (sets j) r member)
  };
\definition nullPairUnion: \forall (S, T: \Pow Point) -> outer S = Measure.zero -> outer T = Measure.zero ->
  outer (Sigma.pairUnion S T) = Measure.zero :=
  \fun (S, T: \Pow Point) (s: outer S = Measure.zero) (t: outer T = Measure.zero) =>
    \axiom:setext(outer (Sigma.pairUnion S T), Measure.zero,
      \fun (r: Real.Real) (member: Measure.below (outer (Sigma.pairUnion S T)) r) =>
        \idelim Measure.add (outer S) (outer T) = Measure.zero \with v: Measure.Value => Measure.below v r
          \by { base: subadditivePair S T r member, equality: eq_reason_in!{Measure.Value _
            "=" _ "by" { congr!{Measure.Value Measure.Value Measure.Value} Measure.add _ _ _ _ s t }
            "=" _ "by" { Values.addZero Measure.zero Values.zeroNonnegative }
          } },
      \fun (r: Real.Real) (negative: R.Lt r Real.zero) => (outerNonnegative (Sigma.pairUnion S T)).negative r negative);
\definition nullPrefix: \forall (sets: N.Nat^ -> \Pow Point) -> (\forall (j: N.Nat^) -> outer (sets j) = Measure.zero) ->
  \forall (j: N.Nat^) -> outer (Sigma.prefix sets j) = Measure.zero :=
  \fun (sets: N.Nat^ -> \Pow Point) (null: \forall (j: N.Nat^) -> outer (sets j) = Measure.zero) =>
    \induction (j: N.Nat^) \return outer (Sigma.prefix sets j) = Measure.zero \with {
      | zero: outerEmpty
      | succ: \fun (j: N.Nat^) (previous: _) => nullPairUnion (Sigma.prefix sets j) (sets j) previous (null j)
    };
\definition negNegPoint: \forall (a: Point) -> negPoint (negPoint a) = a :=
  \fun (a: Point) => \axiom:funext(negPoint (negPoint a), a, \fun (i: Fin.Fin n) => Laws.negInvolutive (a i));
\definition shiftedAgain: \forall (S: \Pow Point) (a: Point) -> shifted (shifted S (negPoint a)) a = S :=
  \fun (S: \Pow Point) (a: Point) => eq_reason_in!{{\Pow Point} _
    "=" _ "by" { congr!{Point {\Pow Point}} (shifted (shifted S (negPoint a))) _ _ (sym!{Point} _ _ (negNegPoint a)) }
    "=" _ "by" { shiftedBack S (negPoint a) }
  };
\definition shiftedIntersection: \forall (S, T: \Pow Point) (a: Point) ->
  shifted (Sets.Intersection S T) a = Sets.Intersection (shifted S a) (shifted T a) :=
  \fun (S, T: \Pow Point) (a: Point) => \axiom:setext(shifted (Sets.Intersection S T) a, Sets.Intersection (shifted S a) (shifted T a),
    \fun (x: Point) (member: Sets.Member (shifted (Sets.Intersection S T) a) x) => member,
    \fun (x: Point) (member: Sets.Member (Sets.Intersection (shifted S a) (shifted T a)) x) => member);
\definition shiftedComplement: \forall (S: \Pow Point) (a: Point) -> shifted (Sets.Complement S) a = Sets.Complement (shifted S a) :=
  \fun (S: \Pow Point) (a: Point) => \axiom:setext(shifted (Sets.Complement S) a, Sets.Complement (shifted S a),
    \fun (x: Point) (member: Sets.Member (shifted (Sets.Complement S) a) x) => member,
    \fun (x: Point) (member: Sets.Member (Sets.Complement (shifted S a)) x) => member);
\definition shiftedCaratheodory: \forall (S: \Pow Point) (a: Point) -> Caratheodory S -> Caratheodory (shifted S a) :=
  \fun (S: \Pow Point) (a: Point) (measurable: Caratheodory S) (T: \Pow Point) => \block {
    \let W: \Pow Point := shifted T (negPoint a) \then
    \let restore: shifted W a = T := shiftedAgain T a \then
    \let inside: shifted (Sets.Intersection W S) a = Sets.Intersection T (shifted S a) := eq_reason_in!{{\Pow Point} _
      "=" _ "by" { shiftedIntersection W S a }
      "=" _ "by" { congr!{{\Pow Point} {\Pow Point}} (\fun (V: \Pow Point) => Sets.Intersection V (shifted S a)) _ _ restore }
    } \then
    \let outside: shifted (Sets.Intersection W (Sets.Complement S)) a = Sets.Intersection T (Sets.Complement (shifted S a)) := eq_reason_in!{{\Pow Point} _
      "=" _ "by" { shiftedIntersection W (Sets.Complement S) a }
      "=" _ "by" { congr!{{\Pow Point} {\Pow Point} {\Pow Point}} Sets.Intersection _ _ _ _ restore (shiftedComplement S a) }
    } \then
    \return eq_reason_in!{Measure.Value _
      "=" _ "by" { congr!{{\Pow Point} Measure.Value} outer _ _ (sym!{{\Pow Point}} _ _ restore) }
      "=" _ "by" { translationInvariant W a }
      "=" _ "by" { measurable W }
      "=" _ "by" { congr!{Measure.Value Measure.Value Measure.Value} Measure.add _ _ _ _
        (sym!{Measure.Value} _ _ (translationInvariant (Sets.Intersection W S) a))
        (sym!{Measure.Value} _ _ (translationInvariant (Sets.Intersection W (Sets.Complement S)) a)) }
      "=" _ "by" { congr!{Measure.Value Measure.Value Measure.Value} Measure.add _ _ _ _
        (congr!{{\Pow Point} Measure.Value} outer _ _ inside) (congr!{{\Pow Point} Measure.Value} outer _ _ outside) }
    }
  };
\module Flatten;
\module SeriesBounds;
\module Countable;
