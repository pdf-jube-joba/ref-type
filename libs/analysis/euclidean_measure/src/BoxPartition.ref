\import std.Data[].Nat[] \as N;
\import std.Data[].Bool[] \as Bool;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].List[] \as List;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.congr;
\use Equality.eq_reason_in;
\import \root.Euclidean[n := n] \as E;
\import List.Membership[A := E.Box] \as Membership;
\import Membership.Append[] \as Append;
\import \root.BoxCut[n := n] \as Cut;
\import \root.GeneralCut[] \as General;
\import topology.Topology[Carrier := E.Point] \as Sets;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import R.Arithmetic[].Prop[] \as Laws;
\structure Slice: \Set := { coordinate: Fin.Fin n, threshold: Real.Real };
\definition partition: \forall (cuts: List.List[Slice]) -> E.Box -> List.List[E.Box] :=
  \induction (cuts: List.List[Slice]) \return E.Box -> List.List[E.Box] \with {
    | nil: \fun (b: E.Box) => List.List[E.Box]::cons b List.List[E.Box]::nil
    | cons: \fun (head: Slice) (_: List.List[Slice]) (prior: E.Box -> List.List[E.Box]) (b: E.Box) =>
      List.append E.Box (prior (General.construct n b head.coordinate head.threshold).left)
        (prior (General.construct n b head.coordinate head.threshold).right)
  };
\definition sum: List.List[E.Box] -> Real.Real := List.foldr E.Box Real.Real (\fun (b: E.Box) (r: Real.Real) => Real.add (E.volume b) r) Real.zero;
\definition sumAppend: \forall (xs, ys: List.List[E.Box]) -> sum (List.append E.Box xs ys) = Real.add (sum xs) (sum ys) :=
  \induction (xs: List.List[E.Box]) \return \forall (ys: List.List[E.Box]) -> sum (List.append E.Box xs ys) = Real.add (sum xs) (sum ys) \with {
    | nil: \fun (ys: List.List[E.Box]) => sym!{Real.Real} _ _ (Laws.addZeroLeft (sum ys))
    | cons: \fun (head: E.Box) (tail: List.List[E.Box]) (prior: \forall (ys: List.List[E.Box]) -> sum (List.append E.Box tail ys) = Real.add (sum tail) (sum ys)) (ys: List.List[E.Box]) =>
      eq_reason_in!{Real.Real _
        "=" _ "by" { congr!{Real.Real Real.Real} (Real.add (E.volume head)) _ _ (prior ys) }
        "=" _ "by" { sym!{Real.Real} _ _ (Laws.addAssoc (E.volume head) (sum tail) (sum ys)) }
      }
  };
\definition sumPreserved: \forall (cuts: List.List[Slice]) (b: E.Box) -> sum (partition cuts b) = E.volume b :=
  \induction (cuts: List.List[Slice]) \return \forall (b: E.Box) -> sum (partition cuts b) = E.volume b \with {
    | nil: \fun (b: E.Box) => Laws.addZeroRight (E.volume b)
    | cons: \fun (head: Slice) (tail: List.List[Slice]) (prior: \forall (b: E.Box) -> sum (partition tail b) = E.volume b) (b: E.Box) => \block {
      \let split: Cut.Result b head.coordinate head.threshold := General.construct n b head.coordinate head.threshold \then
      \return eq_reason_in!{Real.Real _
        "=" _ "by" { sumAppend (partition tail split.left) (partition tail split.right) }
        "=" _ "by" { congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ (prior split.left) (prior split.right) }
        "=" _ "by" { (Cut.laws b head.coordinate head.threshold split).volumes }
      }
    }
  };
\definition contained: \forall (cuts: List.List[Slice]) (b, q: E.Box) -> Membership.Occurs q (partition cuts b) -> Sets.Subset (E.points q) (E.points b) :=
  \induction (cuts: List.List[Slice]) \return \forall (b, q: E.Box) -> Membership.Occurs q (partition cuts b) -> Sets.Subset (E.points q) (E.points b) \with {
    | nil: \fun (b, q: E.Box) (occurs: Membership.Occurs q (partition List.List[Slice]::nil b)) =>
      Logic.orElim (q = b) Logic.False (Sets.Subset (E.points q) (E.points b)) occurs
        (\fun (equal: q = b) (x: E.Point) (inside: Sets.Member (E.points q) x) =>
          \idelim q = b \with v: E.Box => Sets.Member (E.points v) x \by { base: inside, equality: equal })
        (\fun (bad: Logic.False) => Logic.falseElim _ bad)
    | cons: \fun (head: Slice) (tail: List.List[Slice]) (prior: \forall (b, q: E.Box) -> Membership.Occurs q (partition tail b) -> Sets.Subset (E.points q) (E.points b))
      (b, q: E.Box) (occurs: Membership.Occurs q (partition (List.List[Slice]::cons head tail) b)) => \block {
        \let split: Cut.Result b head.coordinate head.threshold := General.construct n b head.coordinate head.threshold \then
        \return Append.eliminate (partition tail split.left) (partition tail split.right) q (Sets.Subset (E.points q) (E.points b))
          (\fun (left: Membership.Occurs q (partition tail split.left)) (x: E.Point) (member: Sets.Member (E.points q) x) =>
            (Cut.laws b head.coordinate head.threshold split).containedLeft x (prior split.left q left x member))
          (\fun (right: Membership.Occurs q (partition tail split.right)) (x: E.Point) (member: Sets.Member (E.points q) x) =>
            (Cut.laws b head.coordinate head.threshold split).containedRight x (prior split.right q right x member)) occurs
      }
  };
\definition covered: \forall (cuts: List.List[Slice]) (b: E.Box) (x: E.Point) -> Sets.Member (E.points b) x ->
  \exists ( q: E.Box \where Logic.And[Membership.Occurs q (partition cuts b), Sets.Member (E.points q) x] ) :=
  \induction (cuts: List.List[Slice]) \return \forall (b: E.Box) (x: E.Point) -> Sets.Member (E.points b) x ->
    \exists ( q: E.Box \where Logic.And[Membership.Occurs q (partition cuts b), Sets.Member (E.points q) x] ) \with {
      | nil: \fun (b: E.Box) (x: E.Point) (inside: Sets.Member (E.points b) x) =>
        Logic.existsIntro[E.Box, { q: E.Box \where Logic.And[Membership.Occurs q (partition List.List[Slice]::nil b), Sets.Member (E.points q) x] }] b
          (Logic.And[_, _]::# (Logic.Or[_, _]::left (\refl(b))) inside)
      | cons: \fun (head: Slice) (tail: List.List[Slice]) (prior: \forall (b: E.Box) (x: E.Point) -> Sets.Member (E.points b) x ->
        \exists ( q: E.Box \where Logic.And[Membership.Occurs q (partition tail b), Sets.Member (E.points q) x] ))
        (b: E.Box) (x: E.Point) (inside: Sets.Member (E.points b) x) => \block {
          \let split: Cut.Result b head.coordinate head.threshold := General.construct n b head.coordinate head.threshold \then
          \let result: \Prop := \exists ( q: E.Box \where Logic.And[Membership.Occurs q (partition (List.List[Slice]::cons head tail) b), Sets.Member (E.points q) x] ) \then
          \return Logic.orElim (R.Le (x head.coordinate) head.threshold) (R.Le head.threshold (x head.coordinate)) result
            (Order.leTotal (x head.coordinate) head.threshold)
            (\fun (below: R.Le (x head.coordinate) head.threshold) => \block {
              \takefrom q: \Cast[E.Box] ({ q: E.Box \where Logic.And[Membership.Occurs q (partition tail split.left), Sets.Member (E.points q) x] })
                \by prior split.left x ((Cut.laws b head.coordinate head.threshold split).insideLeft x inside below) \then
              \let data: Logic.And[Membership.Occurs q (partition tail split.left), Sets.Member (E.points q) x] :=
                \bysub(E.Box, { q: E.Box \where Logic.And[Membership.Occurs q (partition tail split.left), Sets.Member (E.points q) x] }, q) \then
              \return Logic.existsIntro[E.Box, { q: E.Box \where Logic.And[Membership.Occurs q (partition (List.List[Slice]::cons head tail) b), Sets.Member (E.points q) x] }] q
                (Logic.And[_, _]::# (Append.left (partition tail split.left) (partition tail split.right) q data.left) data.right)
            })
            (\fun (above: R.Le head.threshold (x head.coordinate)) => \block {
              \takefrom q: \Cast[E.Box] ({ q: E.Box \where Logic.And[Membership.Occurs q (partition tail split.right), Sets.Member (E.points q) x] })
                \by prior split.right x ((Cut.laws b head.coordinate head.threshold split).insideRight x inside above) \then
              \let data: Logic.And[Membership.Occurs q (partition tail split.right), Sets.Member (E.points q) x] :=
                \bysub(E.Box, { q: E.Box \where Logic.And[Membership.Occurs q (partition tail split.right), Sets.Member (E.points q) x] }, q) \then
              \return Logic.existsIntro[E.Box, { q: E.Box \where Logic.And[Membership.Occurs q (partition (List.List[Slice]::cons head tail) b), Sets.Member (E.points q) x] }] q
                (Logic.And[_, _]::# (Append.right (partition tail split.left) (partition tail split.right) q data.left) data.right)
            })
        }
    };
\import \root.CutGeometry[n := n] \as Geometry;
\import \root.VolumeOrder[n := n] \as Volume;
\import List.Membership[A := Slice] \as SliceMembership;
\definition Aligned[q: E.Box] [cut: Slice]: \Prop := Logic.Or[
  \forall (x: E.Point) -> Sets.Member (E.points q) x -> R.Le (x cut.coordinate) cut.threshold,
  \forall (x: E.Point) -> Sets.Member (E.points q) x -> R.Le cut.threshold (x cut.coordinate) ];
\definition nonzeroOfContained: \forall (q, b: E.Box) -> Sets.Subset (E.points q) (E.points b) -> Logic.Not (E.volume q = Real.zero) -> Logic.Not (E.volume b = Real.zero) :=
  \fun (q, b: E.Box) (subset: Sets.Subset (E.points q) (E.points b)) (nonzero: Logic.Not (E.volume q = Real.zero)) (zero: E.volume b = Real.zero) =>
    nonzero (R.leAntisym (E.volume q) Real.zero (R.leReplaceRight (E.volume q) (E.volume b) Real.zero zero (Volume.included q b subset)) (E.volumeNonnegative q));
\definition aligned: \forall (cuts: List.List[Slice]) (b, q: E.Box) -> Membership.Occurs q (partition cuts b) -> Logic.Not (E.volume q = Real.zero) ->
  \forall (cut: Slice) -> SliceMembership.Occurs cut cuts -> Aligned q cut :=
  \induction (cuts: List.List[Slice]) \return \forall (b, q: E.Box) -> Membership.Occurs q (partition cuts b) -> Logic.Not (E.volume q = Real.zero) ->
    \forall (cut: Slice) -> SliceMembership.Occurs cut cuts -> Aligned q cut \with {
      | nil: \fun (_: E.Box) (_: E.Box) (_: _) (_: _) (cut: Slice) (absurd: Logic.False) => Logic.falseElim (Aligned _ cut) absurd
      | cons: \fun (head: Slice) (tail: List.List[Slice]) (prior: \forall (b, q: E.Box) -> Membership.Occurs q (partition tail b) -> Logic.Not (E.volume q = Real.zero) ->
        \forall (cut: Slice) -> SliceMembership.Occurs cut tail -> Aligned q cut)
        (b, q: E.Box) (occurs: Membership.Occurs q (partition (List.List[Slice]::cons head tail) b)) (nonzero: Logic.Not (E.volume q = Real.zero))
        (cut: Slice) (cutMember: SliceMembership.Occurs cut (List.List[Slice]::cons head tail)) => \block {
          \let split: Cut.Result b head.coordinate head.threshold := General.construct n b head.coordinate head.threshold \then
          \return Append.eliminate (partition tail split.left) (partition tail split.right) q (Aligned q cut)
            (\fun (left: Membership.Occurs q (partition tail split.left)) => \block {
              \let subset: Sets.Subset (E.points q) (E.points split.left) := contained tail split.left q left \then
              \return Logic.orElim (cut = head) (SliceMembership.Occurs cut tail) (Aligned q cut) cutMember
                (\fun (equal: cut = head) => \idelim head = cut \with c: Slice => Aligned q c \by {
                  base: Logic.orElim (E.volume split.left = Real.zero)
                    (\forall (x: E.Point) -> Sets.Member (E.points split.left) x -> R.Le (x head.coordinate) head.threshold) (Aligned q head)
                    (Geometry.leftAligned b head.coordinate head.threshold)
                    (\fun (zero: E.volume split.left = Real.zero) => Logic.falseElim _ (nonzeroOfContained q split.left subset nonzero zero))
                    (\fun (side: \forall (x: E.Point) -> Sets.Member (E.points split.left) x -> R.Le (x head.coordinate) head.threshold) =>
                      Logic.Or[_, _]::left (\fun (x: E.Point) (inside: Sets.Member (E.points q) x) => side x (subset x inside))),
                  equality: sym!{Slice} _ _ equal })
                (\fun (later: SliceMembership.Occurs cut tail) => prior split.left q left nonzero cut later)
            })
            (\fun (right: Membership.Occurs q (partition tail split.right)) => \block {
              \let subset: Sets.Subset (E.points q) (E.points split.right) := contained tail split.right q right \then
              \return Logic.orElim (cut = head) (SliceMembership.Occurs cut tail) (Aligned q cut) cutMember
                (\fun (equal: cut = head) => \idelim head = cut \with c: Slice => Aligned q c \by {
                  base: Logic.orElim (E.volume split.right = Real.zero)
                    (\forall (x: E.Point) -> Sets.Member (E.points split.right) x -> R.Le head.threshold (x head.coordinate)) (Aligned q head)
                    (Geometry.rightAligned b head.coordinate head.threshold)
                    (\fun (zero: E.volume split.right = Real.zero) => Logic.falseElim _ (nonzeroOfContained q split.right subset nonzero zero))
                    (\fun (side: \forall (x: E.Point) -> Sets.Member (E.points split.right) x -> R.Le head.threshold (x head.coordinate)) =>
                      Logic.Or[_, _]::right (\fun (x: E.Point) (inside: Sets.Member (E.points q) x) => side x (subset x inside))),
                  equality: sym!{Slice} _ _ equal })
                (\fun (later: SliceMembership.Occurs cut tail) => prior split.right q right nonzero cut later)
            }) occurs
        }
    };
\definition openBox[b: E.Box]: \Pow E.Point := { x: E.Point \where Logic.And[Bool.IsTrue b.active,
  \forall (i: Fin.Fin n) -> Logic.And[R.Lt (b.left i) (x i), R.Lt (x i) (b.right i)]] };
\definition lowerCut[b: E.Box] [i: Fin.Fin n]: Slice := Slice { coordinate := i, threshold := b.left i };
\definition upperCut[b: E.Box] [i: Fin.Fin n]: Slice := Slice { coordinate := i, threshold := b.right i };
\definition fitsCover: \forall (cuts: List.List[Slice]) (b, q, target: E.Box) -> Membership.Occurs q (partition cuts b) ->
  Logic.Not (E.volume q = Real.zero) ->
  (\forall (i: Fin.Fin n) -> SliceMembership.Occurs (lowerCut target i) cuts) ->
  (\forall (i: Fin.Fin n) -> SliceMembership.Occurs (upperCut target i) cuts) ->
  \forall (x: E.Point) -> Sets.Member (E.points q) x -> Sets.Member (openBox target) x -> Sets.Subset (E.points q) (E.points target) :=
  \fun (cuts: List.List[Slice]) (b, q, target: E.Box) (occurs: Membership.Occurs q (partition cuts b)) (nonzero: Logic.Not (E.volume q = Real.zero))
    (lower: \forall (i: Fin.Fin n) -> SliceMembership.Occurs (lowerCut target i) cuts)
    (upper: \forall (i: Fin.Fin n) -> SliceMembership.Occurs (upperCut target i) cuts)
    (x: E.Point) (inside: Sets.Member (E.points q) x) (inTarget: Sets.Member (openBox target) x)
    (y: E.Point) (inQ: Sets.Member (E.points q) y) => Logic.And[_, _]::# inTarget.left
      (\fun (i: Fin.Fin n) => Logic.And[_, _]::#
        (Logic.orElim (\forall (z: E.Point) -> Sets.Member (E.points q) z -> R.Le (z i) (target.left i))
          (\forall (z: E.Point) -> Sets.Member (E.points q) z -> R.Le (target.left i) (z i)) (R.Le (target.left i) (y i))
          (aligned cuts b q occurs nonzero (lowerCut target i) (lower i))
          (\fun (wrong: \forall (z: E.Point) -> Sets.Member (E.points q) z -> R.Le (z i) (target.left i)) =>
            Logic.falseElim _ (R.ltNotLeReverse (target.left i) (x i) (inTarget.right i).left (wrong x inside)))
          (\fun (good: \forall (z: E.Point) -> Sets.Member (E.points q) z -> R.Le (target.left i) (z i)) => good y inQ))
        (Logic.orElim (\forall (z: E.Point) -> Sets.Member (E.points q) z -> R.Le (z i) (target.right i))
          (\forall (z: E.Point) -> Sets.Member (E.points q) z -> R.Le (target.right i) (z i)) (R.Le (y i) (target.right i))
          (aligned cuts b q occurs nonzero (upperCut target i) (upper i))
          (\fun (good: \forall (z: E.Point) -> Sets.Member (E.points q) z -> R.Le (z i) (target.right i)) => good y inQ)
          (\fun (wrong: \forall (z: E.Point) -> Sets.Member (E.points q) z -> R.Le (target.right i) (z i)) =>
            Logic.falseElim _ (R.ltNotLeReverse (x i) (target.right i) (inTarget.right i).right (wrong x inside)))));
