\import \root.RealLine[].CompletionComparison[interval := interval] \as Comparison;
\import integration.Real[].Lebesgue[interval := interval].Def[] \as Completion;
\import real.Analysis[] \as Real;
\import Real.Geometric[q := Real.half] \as Dyadic;
\import functional_analysis.ScalarLimits[] \as Limits;
\import dedekind_reals.DedekindReal[] \as R;
\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Nat;
\import N.Order[].Prop[] \as NatOrder;
\import std.Logic[].Proposition[] \as Logic;
\definition Choice[i: N.Nat^]: \Set := \Cast[N.Nat^] ({ k: N.Nat^ \where Completion.Control s (Dyadic.value (N.Nat^::succ i)) k });
\definition choiceExists: \forall (i: N.Nat^) -> \exists Choice i :=
  \fun (i: N.Nat^) => Completion.cauchyLaw s (Dyadic.value (N.Nat^::succ i)) (Limits.dyadicPositive (N.Nat^::succ i));
\definition Good[index: N.Nat^ -> N.Nat^]: \Prop :=
  \forall (i: N.Nat^) -> Logic.And[Nat.Le i (index i),
    R.Le (Comparison.distance s s (index i) (index (N.Nat^::succ i))) (Dyadic.value (N.Nat^::succ i))];
\module For(choice: \forall (i: N.Nat^) -> Choice i);
\definition exists: \exists ( index: (N.Nat^ -> N.Nat^) \where Good index ) := \block {
  \takefrom choice: \forall (i: N.Nat^) -> Choice i \by \axiom:classicalIndefiniteChoice(N.Nat^, Choice, choiceExists) \then
  \return Logic.existsIntro[N.Nat^ -> N.Nat^, { index: N.Nat^ -> N.Nat^ \where Good index }]
    (\root.RealLine[].CompletionSubsequence[interval := interval, s := s].For[choice := choice].index)
    (\root.RealLine[].CompletionSubsequence[interval := interval, s := s].For[choice := choice].good)
};
