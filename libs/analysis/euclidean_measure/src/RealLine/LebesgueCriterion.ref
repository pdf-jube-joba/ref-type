\import \root.RealLine[] \as Line;
\import \root.RealLine[].RiemannComparison[interval := interval, f := f] \as Comparison;
\import \root.RealLine[].BadPoints[] \as Bad;
\import \root.RealLine[].BadPointNull[interval := interval] \as BadNull;
\import integration.Real[] \as Integration;
\import Integration.Riemann[interval := interval].Def[] \as Riemann;
\import real.Analysis[] \as Real;
\import Real.Geometric[q := Real.half] \as Dyadic;
\import functional_analysis.ScalarLimits[] \as Limits;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import functional_analysis.Measure[A := Real.Real] \as Measure;
\import Measure.Sigma[] \as Sigma;
\import Measure.AlmostEverywhere[mu := Line.measure] \as AE;
\import Measure.Continuity[mu := Line.measure] \as Continuity;
\import topology.Topology[Carrier := Real.Real] \as Sets;
\import Sets.Finite[] \as Finite;
\import metric_spaces.RealLine[] \as Topology;
\import Topology.Rays[] \as Rays;
\import metric_spaces.RealMetric[] \as RealMetric;
\import metric_spaces.MetricSpace[Carrier := Real.Real] \as Metric;
\import Metric.Topology[] \as MetricTopology;
\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Nat;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\definition closedInterval: Sets.IsClosedIn Topology.topology (Line.interval interval.left interval.right) :=
  Finite.intersectionClosed Topology.topology (Rays.AtLeast interval.left) (Rays.AtMost interval.right)
    (Rays.atLeastClosed interval.left) (Rays.atMostClosed interval.right);
\definition outsideContinuous: \forall (x: Real.Real) -> Logic.Not (Sets.Member (Line.interval interval.left interval.right) x) -> Comparison.ContinuousAt x :=
  \fun (x: Real.Real) (outside: Logic.Not (Sets.Member (Line.interval interval.left interval.right) x)) (epsilon: Real.Real) (_: R.Lt Real.zero epsilon) => \block {
    \takefrom delta: \Cast[Real.Real] (Metric.NeighborhoodRadius RealMetric.metric (Sets.Complement (Line.interval interval.left interval.right)) x)
      \by (MetricTopology.openIff RealMetric.metric (Sets.Complement (Line.interval interval.left interval.right))).ltr closedInterval x outside \then
    \let radius: Logic.And[R.Lt Real.zero delta, Sets.Subset (Metric.Ball RealMetric.metric x delta) (Sets.Complement (Line.interval interval.left interval.right))] :=
      \bysub(Real.Real, Metric.NeighborhoodRadius RealMetric.metric (Sets.Complement (Line.interval interval.left interval.right)) x, delta) \then
    \return Logic.existsIntro[Real.Real, { d: Real.Real \where Logic.And[R.Lt Real.zero d, \forall (z: Real.Real) -> Sets.Member (Line.interval interval.left interval.right) z ->
      R.Lt (Real.distance x z) d -> R.Lt (Real.distance (f.function z) (f.function x)) epsilon] }] delta
      (Logic.And[_, _]::# radius.left (\fun (z: Real.Real) (inside: Sets.Member (Line.interval interval.left interval.right) z) (near: R.Lt (Real.distance x z) delta) =>
        Logic.falseElim _ (radius.right z near inside)))
  };
\definition Failure[x, epsilon: Real.Real]: \Prop := Logic.And[R.Lt Real.zero epsilon, \forall (delta: Real.Real) -> R.Lt Real.zero delta ->
  \exists ( z: Real.Real \where Logic.And[Sets.Member (Line.interval interval.left interval.right) z,
    Logic.And[R.Lt (Real.distance x z) delta, R.Le epsilon (Real.distance (f.function z) (f.function x))]] )];
\definition failureExists: \forall (x: Real.Real) -> Logic.Not (Comparison.ContinuousAt x) -> \exists ( epsilon: Real.Real \where Failure x epsilon ) :=
  \fun (x: Real.Real) (notContinuous: Logic.Not (Comparison.ContinuousAt x)) => Sigma.doubleNegative (\exists ( epsilon: Real.Real \where Failure x epsilon ))
    (\fun (none: Logic.Not (\exists ( epsilon: Real.Real \where Failure x epsilon ))) => notContinuous
      (\fun (epsilon: Real.Real) (ep: R.Lt Real.zero epsilon) => Sigma.doubleNegative
        (\exists ( delta: Real.Real \where Logic.And[R.Lt Real.zero delta, \forall (z: Real.Real) -> Sets.Member (Line.interval interval.left interval.right) z ->
          R.Lt (Real.distance x z) delta -> R.Lt (Real.distance (f.function z) (f.function x)) epsilon] ))
        (\fun (noDelta: Logic.Not (\exists ( delta: Real.Real \where Logic.And[R.Lt Real.zero delta, \forall (z: Real.Real) -> Sets.Member (Line.interval interval.left interval.right) z ->
          R.Lt (Real.distance x z) delta -> R.Lt (Real.distance (f.function z) (f.function x)) epsilon] ))) =>
          none (Logic.existsIntro[Real.Real, { e: Real.Real \where Failure x e }] epsilon (Logic.And[_, _]::# ep
            (\fun (delta: Real.Real) (dp: R.Lt Real.zero delta) => Sigma.doubleNegative
              (\exists ( z: Real.Real \where Logic.And[Sets.Member (Line.interval interval.left interval.right) z,
                Logic.And[R.Lt (Real.distance x z) delta, R.Le epsilon (Real.distance (f.function z) (f.function x))]] ))
              (\fun (noZ: Logic.Not (\exists ( z: Real.Real \where Logic.And[Sets.Member (Line.interval interval.left interval.right) z,
                Logic.And[R.Lt (Real.distance x z) delta, R.Le epsilon (Real.distance (f.function z) (f.function x))]] ))) =>
                noDelta (Logic.existsIntro[Real.Real, { d: Real.Real \where Logic.And[R.Lt Real.zero d, \forall (z: Real.Real) -> Sets.Member (Line.interval interval.left interval.right) z ->
                  R.Lt (Real.distance x z) d -> R.Lt (Real.distance (f.function z) (f.function x)) epsilon] }] delta
                  (Logic.And[_, _]::# dp (\fun (z: Real.Real) (inside: Sets.Member (Line.interval interval.left interval.right) z) (near: R.Lt (Real.distance x z) delta) =>
                    Sigma.doubleNegative (R.Lt (Real.distance (f.function z) (f.function x)) epsilon)
                      (\fun (notNear: Logic.Not (R.Lt (Real.distance (f.function z) (f.function x)) epsilon)) =>
                        noZ (Logic.existsIntro[Real.Real, { z: Real.Real \where Logic.And[Sets.Member (Line.interval interval.left interval.right) z,
                          Logic.And[R.Lt (Real.distance x z) delta, R.Le epsilon (Real.distance (f.function z) (f.function x))]] }] z
                          (Logic.And[_, _]::# inside (Logic.And[_, _]::# near (Order.leOfNotLtReverse epsilon (Real.distance (f.function z) (f.function x)) notNear)))))))))))))));
\definition badSets[k: N.Nat^]: \Pow Real.Real := BadNull.BadSet f (Dyadic.value k);
\definition included: Sets.Subset Comparison.discontinuities (Measure.union badSets) :=
  \fun (x: Real.Real) (notContinuous: Sets.Member Comparison.discontinuities x) => \block {
    \let inside: Sets.Member (Line.interval interval.left interval.right) x := Sigma.doubleNegative (Sets.Member (Line.interval interval.left interval.right) x)
      (\fun (outside: Logic.Not (Sets.Member (Line.interval interval.left interval.right) x)) => notContinuous (outsideContinuous x outside)) \then
    \takefrom epsilon: \Cast[Real.Real] ({ e: Real.Real \where Failure x e }) \by failureExists x notContinuous \then
    \let fail: Failure x epsilon := \bysub(Real.Real, { e: Real.Real \where Failure x e }, epsilon) \then
    \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where \forall (i: N.Nat^) -> Nat.Le k i -> R.Lt (Dyadic.value i) epsilon })
      \by Limits.dyadicSmall epsilon fail.left \then
    \let small: R.Lt (Dyadic.value k) epsilon := (\bysub(N.Nat^, { k: N.Nat^ \where \forall (i: N.Nat^) -> Nat.Le k i -> R.Lt (Dyadic.value i) epsilon }, k)) k (Nat.leRefl k) \then
    \let bad: Bad.BadPoint f.function interval (Dyadic.value k) x := \fun (radius: Real.Real) (positive: R.Lt Real.zero radius) => \block {
      \takefrom z: \Cast[Real.Real] ({ z: Real.Real \where Logic.And[Sets.Member (Line.interval interval.left interval.right) z,
        Logic.And[R.Lt (Real.distance x z) radius, R.Le epsilon (Real.distance (f.function z) (f.function x))]] }) \by fail.right radius positive \then
      \let data: Logic.And[Sets.Member (Line.interval interval.left interval.right) z,
        Logic.And[R.Lt (Real.distance x z) radius, R.Le epsilon (Real.distance (f.function z) (f.function x))]] :=
          \bysub(Real.Real, { z: Real.Real \where Logic.And[Sets.Member (Line.interval interval.left interval.right) z,
            Logic.And[R.Lt (Real.distance x z) radius, R.Le epsilon (Real.distance (f.function z) (f.function x))]] }, z) \then
      \return Logic.existsIntro[Real.Real, { z: Real.Real \where Logic.And[Sets.Member (Line.interval interval.left interval.right) z,
        Logic.And[R.Lt (Real.distance x z) radius, R.Lt (Dyadic.value k) (Real.distance (f.function z) (f.function x))]] }] z
          (Logic.And[_, _]::# data.left (Logic.And[_, _]::# data.right.left (R.ltLeTrans _ _ _ small data.right.right)))
    } \then
    \return Logic.existsIntro[N.Nat^, { i: N.Nat^ \where Sets.Member (badSets i) x }] k (Logic.And[_, _]::# inside bad)
  };
\definition discontinuitiesNull: Measure.Null Line.measure Comparison.discontinuities :=
  AE.nullSubset Comparison.discontinuities (Measure.union badSets) included
    (Continuity.nullUnion badSets (\fun (k: N.Nat^) => BadNull.badNull f (Dyadic.value k) (Limits.dyadicPositive k)));
\import Measure.Integral[mu := Line.measure] \as Integral;
\import integration.Real[].Lebesgue[interval := interval].Prop[] \as Completion;
\definition agreement: \exists ( g: Integral.Representatives \where Logic.And[g = Comparison.limit,
  Integral.integral g = Completion.integral (Completion.ofRiemann f)] ) := Comparison.actualAgreement discontinuitiesNull;
