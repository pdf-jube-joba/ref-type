\import \root.RealLine[] \as Line;
\import integration.Real[].Lebesgue[interval := interval].Def[] \as Completion;
\import integration.Real[].Lebesgue[interval := interval].Prop[] \as CompletionProp;
\import functional_analysis.Measure[A := real.Analysis[].Real] \as Measure;
\import Measure.Integral[mu := Line.measure] \as Integral;
\import std.Logic[].Proposition[] \as Logic;
\import std.Data[].Nat[] \as N;
\definition representative: \forall (s: Completion.Representation) ->
  \exists ( g: Integral.Representatives \where Integral.integral g = CompletionProp.integral (Completion.class s) ) :=
  \fun (s: Completion.Representation) => \block {
    \takefrom index: \Cast[N.Nat^ -> N.Nat^] ({ index: N.Nat^ -> N.Nat^ \where \root.RealLine[].CompletionSubsequence[interval := interval, s := s].Good index })
      \by \root.RealLine[].CompletionSubsequence[interval := interval, s := s].exists \then
    \let good: \root.RealLine[].CompletionSubsequence[interval := interval, s := s].Good index :=
      \bysub(N.Nat^ -> N.Nat^, { index: N.Nat^ -> N.Nat^ \where \root.RealLine[].CompletionSubsequence[interval := interval, s := s].Good index }, index) \then
    \return Logic.existsIntro[Integral.Representatives, { g: Integral.Representatives \where Integral.integral g = CompletionProp.integral (Completion.class s) }]
      (\root.RealLine[].CompletionRealization[interval := interval, s := s, index := index, good := good].representative)
      (\root.RealLine[].CompletionRealization[interval := interval, s := s, index := index, good := good].integral)
  };
\definition agreement: \forall (f: Completion.Function) -> \exists ( g: Integral.Representatives \where Integral.integral g = CompletionProp.integral f ) :=
  Completion.induction (\fun (f: Completion.Function) => \exists ( g: Integral.Representatives \where Integral.integral g = CompletionProp.integral f )) representative;
\import \root.RealLine[].CompletionLink[interval := interval] \as Link;
\definition linkedRepresentative: \forall (s: Completion.Representation) ->
  \exists ( index: (N.Nat^ -> N.Nat^) \where \exists ( g: Integral.Representatives \where Logic.And[
    Logic.And[\root.RealLine[].CompletionSubsequence[interval := interval, s := s].Good index, Link.Related s index g], Integral.integral g = CompletionProp.integral (Completion.class s)] ) ) :=
  \fun (s: Completion.Representation) => \block {
    \takefrom index: \Cast[N.Nat^ -> N.Nat^] ({ index: N.Nat^ -> N.Nat^ \where \root.RealLine[].CompletionSubsequence[interval := interval, s := s].Good index })
      \by \root.RealLine[].CompletionSubsequence[interval := interval, s := s].exists \then
    \let good: \root.RealLine[].CompletionSubsequence[interval := interval, s := s].Good index :=
      \bysub(N.Nat^ -> N.Nat^, { index: N.Nat^ -> N.Nat^ \where \root.RealLine[].CompletionSubsequence[interval := interval, s := s].Good index }, index) \then
    \let g: Integral.Representatives := \root.RealLine[].CompletionRealization[interval := interval, s := s, index := index, good := good].representative \then
    \return Logic.existsIntro[N.Nat^ -> N.Nat^, { index: N.Nat^ -> N.Nat^ \where \exists ( g: Integral.Representatives \where Logic.And[
      Logic.And[\root.RealLine[].CompletionSubsequence[interval := interval, s := s].Good index, Link.Related s index g], Integral.integral g = CompletionProp.integral (Completion.class s)] ) }] index
      (Logic.existsIntro[Integral.Representatives, { g: Integral.Representatives \where Logic.And[
        Logic.And[\root.RealLine[].CompletionSubsequence[interval := interval, s := s].Good index, Link.Related s index g], Integral.integral g = CompletionProp.integral (Completion.class s)] }] g
        (Logic.And[_, _]::# (Logic.And[_, _]::# good (Link.For[s := s, index := index, good := good].related))
          (\root.RealLine[].CompletionRealization[interval := interval, s := s, index := index, good := good].integral)))
  };
\definition linkedAgreement: \forall (f: Completion.Function) -> \exists ( s: Completion.Representation \where Logic.And[
  Completion.class s = f,
  \exists ( index: (N.Nat^ -> N.Nat^) \where \exists ( g: Integral.Representatives \where Logic.And[
    Logic.And[\root.RealLine[].CompletionSubsequence[interval := interval, s := s].Good index, Link.Related s index g],
    Integral.integral g = CompletionProp.integral f] ) )] ) :=
  Completion.induction (\fun (f: Completion.Function) => \exists ( s: Completion.Representation \where Logic.And[
    Completion.class s = f,
    \exists ( index: (N.Nat^ -> N.Nat^) \where \exists ( g: Integral.Representatives \where Logic.And[
      Logic.And[\root.RealLine[].CompletionSubsequence[interval := interval, s := s].Good index, Link.Related s index g],
      Integral.integral g = CompletionProp.integral f] ) )] ))
    (\fun (s: Completion.Representation) => Logic.existsIntro[Completion.Representation, { t: Completion.Representation \where Logic.And[
      Completion.class t = Completion.class s,
      \exists ( index: (N.Nat^ -> N.Nat^) \where \exists ( g: Integral.Representatives \where Logic.And[
        Logic.And[\root.RealLine[].CompletionSubsequence[interval := interval, s := t].Good index, Link.Related t index g],
        Integral.integral g = CompletionProp.integral (Completion.class s)] ) )] }] s
      (Logic.And[_, _]::# (\refl(Completion.class s)) (linkedRepresentative s)));
