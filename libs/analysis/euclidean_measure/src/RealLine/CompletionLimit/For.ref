\definition data: Integral.AEDominatedSequence := Integral.AEDominatedSequence {
  sequence := Comparison.mapped s,
  limit := c.limit,
  bound := c.bound,
  exception := c.exception,
  dominated := c.dominated,
  converges := c.converges,
};
\import Integral.AEDominated[d := data] \as Proof;
\definition representative: Integral.Representatives := Proof.representative;
\definition almostLimit: Measure.AlmostEqual Line.measure representative c.limit := Proof.almostLimit;
\definition integral: Integral.integral representative = CompletionProp.integral (Completion.class s) :=
  Sequence.limitUnique (\fun (n: N.Nat^) => Integral.integral (Comparison.mapped s n))
    (Integral.integral representative) (CompletionProp.integral (Completion.class s)) Proof.convergence (Comparison.integralSequence s);
