\import \root.RealLine[] \as Line;
\import \root.RealLine[].CompletionComparison[interval := interval] \as Comparison;
\import \root.RealLine[].CompletionSeries[interval := interval, s := s, index := index, good := good] \as Series;
\import \root.RealLine[].CompletionDivergence[interval := interval, s := s, index := index, good := good] \as Divergence;
\import \root.RealLine[].CompletionSum[interval := interval, s := s, index := index, good := good] \as Sum;
\import functional_analysis.Measure[A := real.Analysis[].Real] \as Measure;
\import Measure.Integral[mu := Line.measure] \as Integral;
\import Integral.Series[terms := Series.terms] \as Partial;
\import Integral.Absolute[] \as Absolute;
\import Integral.Linear[] \as Linear;
\import Integral.Convergence[] \as Convergence;
\import real.Analysis[] \as Real;
\import Real.Sequence[] \as Sequence;
\import Real.Distance[] \as Distance;
\import Real.Estimates[].Product[] \as Product;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import topology.Topology[Carrier := Real.Real] \as Sets;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Nat;
\definition sequence[k: N.Nat^] [x: Real.Real]: Real.Real := Comparison.mapped s (index k) x;
\definition Candidate[x: Real.Real]: \Set := \Cast[Real.Real] ({ y: Real.Real \where Logic.And[
  Sets.Member Divergence.exception x -> y = Real.zero,
  Logic.Not (Sets.Member Divergence.exception x) -> Sequence.Converges (\fun (k: N.Nat^) => sequence k x) y] });
\definition exists: \forall (x: Real.Real) -> \exists Candidate x := \fun (x: Real.Real) =>
  Logic.orElim _ _ _ (Classical.excludedMiddle (Sets.Member Divergence.exception x))
    (\fun (inside: Sets.Member Divergence.exception x) => Logic.existsIntro[Real.Real, { y: Real.Real \where Logic.And[
      Sets.Member Divergence.exception x -> y = Real.zero, Logic.Not (Sets.Member Divergence.exception x) -> Sequence.Converges (\fun (k: N.Nat^) => sequence k x) y] }] Real.zero
      (Logic.And[_, _]::# (\fun (_: Sets.Member Divergence.exception x) => \refl(Real.zero)) (\fun (outside: Logic.Not (Sets.Member Divergence.exception x)) => Logic.falseElim _ (outside inside))))
    (\fun (outside: Logic.Not (Sets.Member Divergence.exception x)) => \block {
      \let seq: Sequence.CauchySequence := \into[N.Nat^ -> Real.Real]((\fun (k: N.Nat^) => sequence k x), { q: N.Nat^ -> Real.Real \where Sequence.Cauchy q }) \by {
        \root.RealLine[].CompletionPointwise[interval := interval, s := s, index := index, good := good, x := x].cauchy outside } \then
      \return Logic.existsIntro[Real.Real, { y: Real.Real \where Logic.And[Sets.Member Divergence.exception x -> y = Real.zero,
        Logic.Not (Sets.Member Divergence.exception x) -> Sequence.Converges (\fun (k: N.Nat^) => sequence k x) y] }] (Sequence.limit seq)
        (Logic.And[_, _]::# (\fun (inside: Sets.Member Divergence.exception x) => Logic.falseElim _ (outside inside))
          (\fun (_: Logic.Not (Sets.Member Divergence.exception x)) => Sequence.limitLaw seq))
    });
\definition unique: \forall (x: Real.Real) (u, v: Candidate x) -> u = v := \fun (x: Real.Real) (u, v: Candidate x) => \block {
  \let a: Logic.And[Sets.Member Divergence.exception x -> u = Real.zero, Logic.Not (Sets.Member Divergence.exception x) -> Sequence.Converges (\fun (k: N.Nat^) => sequence k x) u] :=
    \bysub(Real.Real, { y: Real.Real \where Logic.And[Sets.Member Divergence.exception x -> y = Real.zero, Logic.Not (Sets.Member Divergence.exception x) -> Sequence.Converges (\fun (k: N.Nat^) => sequence k x) y] }, u) \then
  \let b: Logic.And[Sets.Member Divergence.exception x -> v = Real.zero, Logic.Not (Sets.Member Divergence.exception x) -> Sequence.Converges (\fun (k: N.Nat^) => sequence k x) v] :=
    \bysub(Real.Real, { y: Real.Real \where Logic.And[Sets.Member Divergence.exception x -> y = Real.zero, Logic.Not (Sets.Member Divergence.exception x) -> Sequence.Converges (\fun (k: N.Nat^) => sequence k x) y] }, v) \then
  \return Logic.orElim _ _ _ (Classical.excludedMiddle (Sets.Member Divergence.exception x))
    (\fun (inside: Sets.Member Divergence.exception x) => trans!{Real.Real} u Real.zero v (a.left inside) (sym!{Real.Real} _ _ (b.left inside)))
    (\fun (outside: Logic.Not (Sets.Member Divergence.exception x)) => Sequence.limitUnique (\fun (k: N.Nat^) => sequence k x) u v (a.right outside) (b.right outside))
};
\definition limit[x: Real.Real]: Real.Real := \choice Candidate x \by { existence: exists x, uniqueness: unique x };
\definition limitLaw: \forall (x: Real.Real) -> Logic.And[Sets.Member Divergence.exception x -> limit x = Real.zero,
  Logic.Not (Sets.Member Divergence.exception x) -> Sequence.Converges (\fun (k: N.Nat^) => sequence k x) (limit x)] :=
  \fun (x: Real.Real) => \bysub(Real.Real, { y: Real.Real \where Logic.And[Sets.Member Divergence.exception x -> y = Real.zero,
    Logic.Not (Sets.Member Divergence.exception x) -> Sequence.Converges (\fun (k: N.Nat^) => sequence k x) y] },
    \choice Candidate x \by { existence: exists x, uniqueness: unique x });
\import Real.Estimates[] \as Estimates;
\definition bound: Integral.Representatives := Linear.addRepresentative (Absolute.representative (Comparison.mapped s (index N.Nat^::zero))) Sum.representative;
\definition dominated: \forall (k: N.Nat^) (x: Real.Real) -> Logic.Not (Sets.Member Divergence.exception x) -> R.Le (Product.abs (sequence k x)) (bound x) :=
  \fun (k: N.Nat^) (x: Real.Real) (outside: Logic.Not (Sets.Member Divergence.exception x)) => \block {
    \let tail: R.Le (Real.distance (sequence N.Nat^::zero x) (sequence k x)) (Partial.partial k x) :=
      R.leReplaceRight _ (Real.sub (Partial.partial k x) (Partial.partial N.Nat^::zero x)) (Partial.partial k x)
        (Laws.subZeroRight (Partial.partial k x))
        (\root.RealLine[].CompletionPointwise[interval := interval, s := s, index := index, good := good, x := x].tail k N.Nat^::zero (Nat.zeroLe k)) \then
    \let partBound: R.Le (Partial.partial k x) (Sum.value x) :=
      R.leReplaceLeft (Sum.sequence k x) (Partial.partial k x) (Sum.value x)
        ((\root.RealLine[].CompletionSum[interval := interval, s := s, index := index, good := good].At[k := k].law x).right outside)
        (Convergence.pointwiseUpper Sum.sequence Sum.value Sum.supremum k x) \then
    \return R.leTrans _ (Real.add (Product.abs (sequence N.Nat^::zero x)) (Real.distance (sequence N.Nat^::zero x) (sequence k x))) _
      (Distance.distanceTriangle Real.zero (sequence N.Nat^::zero x) (sequence k x))
      (Laws.addMonotoneLeft _ _ (Product.abs (sequence N.Nat^::zero x)) (R.leTrans _ _ _ tail partBound))
  };
\definition data: Integral.AEDominatedSequence := Integral.AEDominatedSequence {
  sequence := \fun (k: N.Nat^) => Comparison.mapped s (index k),
  limit := limit, bound := bound, exception := Divergence.exception,
  dominated := dominated, converges := \fun (x: Real.Real) (outside: Logic.Not (Sets.Member Divergence.exception x)) => (limitLaw x).right outside,
};
\import Integral.AEDominated[d := data] \as Proof;
\definition representative: Integral.Representatives := Proof.representative;
\definition almostLimit: Measure.AlmostEqual Line.measure representative limit := Proof.almostLimit;
\import integration.Real[].Lebesgue[interval := interval].Def[] \as Completion;
\import integration.Real[].Lebesgue[interval := interval].Prop[] \as CompletionProp;
\definition subsequenceIntegral: Sequence.Converges (\fun (k: N.Nat^) => Integral.integral (Comparison.mapped s (index k)))
  (CompletionProp.integral (Completion.class s)) :=
  \fun (epsilon: Real.Real) (positive: R.Lt Real.zero epsilon) => \block {
    \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Sequence.LimitControl (\fun (j: N.Nat^) => Integral.integral (Comparison.mapped s j)) (CompletionProp.integral (Completion.class s)) epsilon k })
      \by Comparison.integralSequence s epsilon positive \then
    \let control: Sequence.LimitControl (\fun (j: N.Nat^) => Integral.integral (Comparison.mapped s j)) (CompletionProp.integral (Completion.class s)) epsilon k :=
      \bysub(N.Nat^, { k: N.Nat^ \where Sequence.LimitControl (\fun (j: N.Nat^) => Integral.integral (Comparison.mapped s j)) (CompletionProp.integral (Completion.class s)) epsilon k }, k) \then
    \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Sequence.LimitControl (\fun (j: N.Nat^) => Integral.integral (Comparison.mapped s (index j))) (CompletionProp.integral (Completion.class s)) epsilon k }] k
      (\fun (j: N.Nat^) (later: Nat.Le k j) => control (index j) (Nat.leTrans k j (index j) later (good j).left))
  };
\definition integral: Integral.integral representative = CompletionProp.integral (Completion.class s) :=
  Sequence.limitUnique (\fun (k: N.Nat^) => Integral.integral (Comparison.mapped s (index k)))
    (Integral.integral representative) (CompletionProp.integral (Completion.class s)) Proof.convergence subsequenceIntegral;
