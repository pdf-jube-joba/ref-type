\import \root.RealLine[] \as Line;
\import \root.RealLine[].CompletionComparison[interval := interval] \as Comparison;
\import integration.Real[].Lebesgue[interval := interval].Def[] \as Completion;
\import integration.Real[].Lebesgue[interval := interval].Prop[] \as CompletionProp;
\import real.Analysis[] \as Real;
\import real.Analysis[].Sequence[] \as Sequence;
\import dedekind_reals.DedekindReal[] \as R;
\import real.Analysis[].Estimates[].Product[] \as Product;
\import functional_analysis.Measure[A := Real.Real] \as Measure;
\import Measure.Integral[mu := Line.measure] \as Integral;
\import Integral.Null[] \as Null;
\import topology.Topology[Carrier := Real.Real] \as Sets;
\import std.Logic[].Proposition[] \as Logic;
\import std.Data[].Nat[] \as N;
\structure Conditions: \Set := {
  limit: Real.Real -> Real.Real,
  bound: Integral.Representatives,
  exception: Null.NullSet,
  dominated: \forall (n: N.Nat^) (x: Real.Real) -> Logic.Not (Sets.Member exception x) -> R.Le (Product.abs (Comparison.mapped s n x)) (bound x),
  converges: \forall (x: Real.Real) -> Logic.Not (Sets.Member exception x) -> Sequence.Converges (\fun (n: N.Nat^) => Comparison.mapped s n x) (limit x),
};
\module For(c: Conditions);
