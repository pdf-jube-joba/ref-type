\import \root.RealLine[] \as Line;
\import \root.RealLine[].CompletionComparison[interval := interval] \as Comparison;
\import integration.Real[].Lebesgue[interval := interval].Def[] \as Completion;
\import functional_analysis.Measure[A := real.Analysis[].Real] \as Measure;
\import Measure.Integral[mu := Line.measure] \as Integral;
\import Integral.Null[] \as Null;
\import real.Analysis[] \as Real;
\import Real.Sequence[] \as Sequence;
\import topology.Topology[Carrier := Real.Real] \as Sets;
\import std.Logic[].Proposition[] \as Logic;
\import std.Data[].Nat[] \as N;
\definition Related[s: Completion.Representation] [index: N.Nat^ -> N.Nat^] [g: Integral.Representatives]: \Prop :=
  \exists ( limit: (Real.Real -> Real.Real) \where \exists ( exception: Null.NullSet \where Logic.And[
    \forall (x: Real.Real) -> Logic.Not (Sets.Member exception x) -> Sequence.Converges (\fun (k: N.Nat^) => Comparison.mapped s (index k) x) (limit x),
    Measure.AlmostEqual Line.measure g limit] ) );
\module For(s: Completion.Representation, index: N.Nat^ -> N.Nat^, good: \root.RealLine[].CompletionSubsequence[interval := interval, s := s].Good index);
