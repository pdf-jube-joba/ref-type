\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import functional_analysis.Measure[A := A] \as M;
\import M.ValueLaws[] \as V;
\import M.SeriesLaws[] \as Series;
\import real.Analysis[] \as Real;
\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].congr;
\use std.Logic[].Equality[].eq_reason_in;
\import Fin.Tuples[A := M.Value] \as Tuples;
\import Tuples.Omission[] \as Omission;
\definition sumExtend: \forall (n: N.Nat^) (h: M.Value) (tail: Fin.Fin n -> M.Value) ->
  M.sum (N.Nat^::succ n) (Tuples.extend n h tail) = M.add h (M.sum n tail) :=
  \fun (n: N.Nat^) (h: M.Value) (tail: Fin.Fin n -> M.Value) =>
    congr!{M.Value M.Value M.Value} M.add _ _ _ _ (Tuples.atZero n h tail)
      (congr!{{Fin.Fin n -> M.Value} M.Value} (M.sum n) _ _
        (\axiom:funext((\fun (i: Fin.Fin n) => Tuples.extend n h tail (Fin.succ n i)), tail, Tuples.atSuccessor n h tail)));
\import std.Data[].Option[] \as Option;
\definition sumOmit: \forall (n: N.Nat^) (f: Fin.Fin (N.Nat^::succ n) -> M.Value) (pivot: Fin.Fin (N.Nat^::succ n)) ->
  (\forall (i: Fin.Fin (N.Nat^::succ n)) -> M.NonnegativeValue[f i]) ->
  M.sum (N.Nat^::succ n) f = M.add (f pivot) (M.sum n (Omission.omit n pivot f)) :=
  \induction (n: N.Nat^) \return \forall (f: Fin.Fin (N.Nat^::succ n) -> M.Value) (pivot: Fin.Fin (N.Nat^::succ n)) ->
    (\forall (i: Fin.Fin (N.Nat^::succ n)) -> M.NonnegativeValue[f i]) ->
    M.sum (N.Nat^::succ n) f = M.add (f pivot) (M.sum n (Omission.omit n pivot f)) \with {
    | zero: \fun (f: Fin.Fin (N.Nat^::succ N.Nat^::zero) -> M.Value) (pivot: Fin.Fin (N.Nat^::succ N.Nat^::zero)) (_: _) => \block {
      \let cases: \forall (o: Option.Option[Fin.Fin N.Nat^::zero]) ->
        M.sum (N.Nat^::succ N.Nat^::zero) f = M.add (f (Fin.inflate N.Nat^::zero o)) (M.sum N.Nat^::zero (Omission.omit N.Nat^::zero (Fin.inflate N.Nat^::zero o) f)) :=
        \induction (o: Option.Option[Fin.Fin N.Nat^::zero]) \return
          M.sum (N.Nat^::succ N.Nat^::zero) f = M.add (f (Fin.inflate N.Nat^::zero o)) (M.sum N.Nat^::zero (Omission.omit N.Nat^::zero (Fin.inflate N.Nat^::zero o) f)) \with {
          | none: \refl(M.add (f (Fin.zero N.Nat^::zero)) M.zero)
          | some: \fun (i: Fin.Fin N.Nat^::zero) => Logic.falseElim _ (Fin.zeroImpossible i (Fin.bound N.Nat^::zero i))
        } \then
      \return \idelim Fin.inflate N.Nat^::zero (Fin.split N.Nat^::zero pivot) = pivot
        \with i: Fin.Fin (N.Nat^::succ N.Nat^::zero) => M.sum (N.Nat^::succ N.Nat^::zero) f = M.add (f i) (M.sum N.Nat^::zero (Omission.omit N.Nat^::zero i f))
        \by { base: cases (Fin.split N.Nat^::zero pivot), equality: Fin.inflateSplit N.Nat^::zero pivot }
    }
    | succ: \fun (n: N.Nat^) (prior: \forall (f: Fin.Fin (N.Nat^::succ n) -> M.Value) (pivot: Fin.Fin (N.Nat^::succ n)) -> (\forall (i: Fin.Fin (N.Nat^::succ n)) -> M.NonnegativeValue[f i]) -> M.sum (N.Nat^::succ n) f = M.add (f pivot) (M.sum n (Omission.omit n pivot f))) (f: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)) -> M.Value)
      (pivot: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) (valid: \forall (i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) -> M.NonnegativeValue[f i]) => \block {
      \let cases: \forall (o: Option.Option[Fin.Fin (N.Nat^::succ n)]) ->
        M.sum (N.Nat^::succ (N.Nat^::succ n)) f = M.add (f (Fin.inflate (N.Nat^::succ n) o))
          (M.sum (N.Nat^::succ n) (Omission.omit (N.Nat^::succ n) (Fin.inflate (N.Nat^::succ n) o) f)) :=
        \induction (o: Option.Option[Fin.Fin (N.Nat^::succ n)]) \return
          M.sum (N.Nat^::succ (N.Nat^::succ n)) f = M.add (f (Fin.inflate (N.Nat^::succ n) o))
            (M.sum (N.Nat^::succ n) (Omission.omit (N.Nat^::succ n) (Fin.inflate (N.Nat^::succ n) o) f)) \with {
          | none: congr!{M.Value M.Value} (M.add (f (Fin.zero (N.Nat^::succ n)))) _ _
            (congr!{{Fin.Fin (N.Nat^::succ n) -> M.Value} M.Value} (M.sum (N.Nat^::succ n)) _ _ (sym!{{Fin.Fin (N.Nat^::succ n) -> M.Value}} _ _ (Omission.first n f)))
          | some: \fun (i: Fin.Fin (N.Nat^::succ n)) => \block {
            \let tail: Fin.Fin (N.Nat^::succ n) -> M.Value := \fun (j: Fin.Fin (N.Nat^::succ n)) => f (Fin.succ (N.Nat^::succ n) j) \then
            \let omitted: Fin.Fin n -> M.Value := Omission.omit n i tail \then
            \return eq_reason_in!{M.Value _
              "=" _ "by" { congr!{M.Value M.Value} (M.add (f (Fin.zero (N.Nat^::succ n)))) _ _ (prior tail i (\fun (j: Fin.Fin (N.Nat^::succ n)) => valid (Fin.succ (N.Nat^::succ n) j))) }
              "=" _ "by" { sym!{M.Value} _ _ (V.addAssoc (f (Fin.zero (N.Nat^::succ n))) (tail i) (M.sum n omitted)) }
              "=" _ "by" { congr!{M.Value M.Value} (\fun (v: M.Value) => M.add v (M.sum n omitted)) _ _ (V.addComm (f (Fin.zero (N.Nat^::succ n))) (tail i)) }
              "=" _ "by" { V.addAssoc (tail i) (f (Fin.zero (N.Nat^::succ n))) (M.sum n omitted) }
              "=" _ "by" { congr!{M.Value M.Value} (M.add (tail i)) _ _ (sym!{M.Value} _ _ (sumExtend n (f (Fin.zero (N.Nat^::succ n))) omitted)) }
              "=" _ "by" { congr!{M.Value M.Value} (M.add (tail i)) _ _
                (congr!{{Fin.Fin (N.Nat^::succ n) -> M.Value} M.Value} (M.sum (N.Nat^::succ n)) _ _ (sym!{{Fin.Fin (N.Nat^::succ n) -> M.Value}} _ _ (Omission.successor n i f))) }
            }
          }
        } \then
      \return \idelim Fin.inflate (N.Nat^::succ n) (Fin.split (N.Nat^::succ n) pivot) = pivot
        \with i: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)) => M.sum (N.Nat^::succ (N.Nat^::succ n)) f = M.add (f i) (M.sum (N.Nat^::succ n) (Omission.omit (N.Nat^::succ n) i f))
        \by { base: cases (Fin.split (N.Nat^::succ n) pivot), equality: Fin.inflateSplit (N.Nat^::succ n) pivot }
    }
  };
\definition sumContains: \forall (n: N.Nat^) (f: Fin.Fin (N.Nat^::succ n) -> M.Value) (pivot: Fin.Fin (N.Nat^::succ n)) ->
  (\forall (i: Fin.Fin (N.Nat^::succ n)) -> M.NonnegativeValue[f i]) -> V.Included (f pivot) (M.sum (N.Nat^::succ n) f) :=
  \fun (n: N.Nat^) (f: Fin.Fin (N.Nat^::succ n) -> M.Value) (pivot: Fin.Fin (N.Nat^::succ n))
    (valid: \forall (i: Fin.Fin (N.Nat^::succ n)) -> M.NonnegativeValue[f i]) (r: Real.Real) (member: M.below (f pivot) r) =>
    \idelim M.add (f pivot) (M.sum n (Omission.omit n pivot f)) = M.sum (N.Nat^::succ n) f \with v: M.Value => M.below v r
      \by { base: Series.pairLeftIncluded (f pivot) (M.sum n (Omission.omit n pivot f)) (valid pivot)
        (V.sumNonnegative n (Omission.omit n pivot f) (\fun (i: Fin.Fin n) => \idelim f (Fin.Skipping[].apply n pivot i) = Omission.omit n pivot f i \with v: M.Value => M.NonnegativeValue[v]
          \by { base: valid (Fin.Skipping[].apply n pivot i), equality:
            eq_reason_in!{M.Value _
              "=" _ "by" { congr!{{Fin.Fin n -> M.Value} M.Value} (\fun (g: Fin.Fin n -> M.Value) => g i)
                (\fun (j: Fin.Fin n) => f (Fin.Skipping[].apply n pivot j)) (Omission.omit n pivot (\fun (j: Fin.Fin (N.Nat^::succ n)) => f j))
                (Fin.Tuples[A := Fin.Fin (N.Nat^::succ n)].Mapping[B := M.Value].omitMap n pivot f (\fun (j: Fin.Fin (N.Nat^::succ n)) => j)) }
              "=" _ "by" { congr!{{Fin.Fin (N.Nat^::succ n) -> M.Value} M.Value} (\fun (g: Fin.Fin (N.Nat^::succ n) -> M.Value) => Omission.omit n pivot g i) _ _
                (\axiom:funext((\fun (j: Fin.Fin (N.Nat^::succ n)) => f j), f, \fun (j: Fin.Fin (N.Nat^::succ n)) => \refl(f j))) }
            } })) r member,
        equality: sym!{M.Value} _ _ (sumOmit n f pivot valid) };
