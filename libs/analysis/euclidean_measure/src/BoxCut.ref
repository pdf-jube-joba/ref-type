\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import \root.Euclidean[n := n] \as E;
\import topology.Topology[Carrier := E.Point] \as Sets;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import real.Analysis[].Clipping[] \as Clip;
\structure Pair: \Set := { left: E.Box, right: E.Box };
\structure Laws[b: E.Box, i: Fin.Fin n, t: Real.Real, pair: Pair]: \Prop := {
  activeLeft: pair.left.active = b.active,
  activeRight: pair.right.active = b.active,
  insideLeft: \forall (x: E.Point) -> Sets.Member (E.points b) x -> R.Le (x i) t -> Sets.Member (E.points pair.left) x,
  insideRight: \forall (x: E.Point) -> Sets.Member (E.points b) x -> R.Le t (x i) -> Sets.Member (E.points pair.right) x,
  containedLeft: Sets.Subset (E.points pair.left) (E.points b),
  containedRight: Sets.Subset (E.points pair.right) (E.points b),
  leftSide: R.Le (b.left i) t -> R.Le t (b.right i) -> \forall (x: E.Point) -> Sets.Member (E.points pair.left) x -> R.Le (x i) t,
  rightSide: R.Le (b.left i) t -> R.Le t (b.right i) -> \forall (x: E.Point) -> Sets.Member (E.points pair.right) x -> R.Le t (x i),
  leftLower: pair.left.left i = b.left i,
  rightUpper: pair.right.right i = b.right i,
  leftUpper: pair.left.right i = Clip.value (b.left i) (b.right i) t,
  rightLower: pair.right.left i = Clip.value (b.left i) (b.right i) t,
  volumes: Real.add (E.volume pair.left) (E.volume pair.right) = E.volume b,
};
\definition Result[b: E.Box] [i: Fin.Fin n] [t: Real.Real]: \Set := \Cast[Pair] ({ pair: Pair \where Laws[b, i, t, pair] });
\definition laws[b: E.Box] [i: Fin.Fin n] [t: Real.Real] [result: Result b i t]: Laws[b, i, t, result] :=
  \bysub(Pair, { pair: Pair \where Laws[b, i, t, pair] }, result);
