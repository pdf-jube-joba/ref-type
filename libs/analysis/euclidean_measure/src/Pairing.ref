\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Nat;
\import N.Pair[].Def[] \as Pair;
\import N.Pair[].Enumeration[] \as E;
\import std.Logic[].Proposition[] \as Logic;
\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].congr;
\use std.Logic[].Equality[].eq_reason_in;

\definition previous[p: Pair.NatPair]: Pair.NatPair :=
  (\induction (a: N.Nat^) \return Pair.NatPair \with {
    | zero: (\induction (b: N.Nat^) \return Pair.NatPair \with {
      | zero: Pair.natPair N.Nat^::zero N.Nat^::zero
      | succ: \fun (b: N.Nat^) (_: Pair.NatPair) => Pair.natPair b N.Nat^::zero
    }) (Pair.natPairSecond p)
    | succ: \fun (a: N.Nat^) (_: Pair.NatPair) => Pair.natPair a (N.Nat^::succ (Pair.natPairSecond p))
  }) (Pair.natPairFirst p);
\definition previousStep: \forall (p: Pair.NatPair) -> previous (E.step p) = p :=
  Pair.natPairElim (\fun (p: Pair.NatPair) => previous (E.step p) = p) (\fun (a, b: N.Nat^) => (\induction (b: N.Nat^) \return previous (E.step (Pair.natPair a b)) = Pair.natPair a b \with {
    | zero: \refl(Pair.natPair a N.Nat^::zero)
    | succ: \fun (b: N.Nat^) (_: _) => \refl(Pair.natPair a (N.Nat^::succ b))
  }) b);
\definition stepNotOrigin: \forall (p: Pair.NatPair) -> Logic.Not (E.step p = Pair.natPair N.Nat^::zero N.Nat^::zero) :=
  Pair.natPairElim (\fun (p: Pair.NatPair) => Logic.Not (E.step p = Pair.natPair N.Nat^::zero N.Nat^::zero)) (\fun (a, b: N.Nat^) => (\induction (b: N.Nat^) \return Logic.Not (E.step (Pair.natPair a b) = Pair.natPair N.Nat^::zero N.Nat^::zero) \with {
    | zero: \fun (equal: _) => Nat.succNeZero a (congr!{Pair.NatPair N.Nat^} Pair.natPairSecond _ _ equal)
    | succ: \fun (b: N.Nat^) (_: _) (equal: _) => Nat.succNeZero a (congr!{Pair.NatPair N.Nat^} Pair.natPairFirst _ _ equal)
  }) b);
\definition enumerateInjective: \forall (i, j: N.Nat^) -> E.enumerate i = E.enumerate j -> i = j :=
  \induction (i: N.Nat^) \return \forall (j: N.Nat^) -> E.enumerate i = E.enumerate j -> i = j \with {
    | zero: \induction (j: N.Nat^) \return E.enumerate N.Nat^::zero = E.enumerate j -> N.Nat^::zero = j \with {
      | zero: \fun (_: _) => \refl(N.Nat^::zero)
      | succ: \fun (j: N.Nat^) (_: _) (equal: _) => Logic.falseElim _ (stepNotOrigin (E.enumerate j) (sym!{Pair.NatPair} _ _ equal))
    }
    | succ: \fun (i: N.Nat^) (prior: \forall (j: N.Nat^) -> E.enumerate i = E.enumerate j -> i = j) =>
      \induction (j: N.Nat^) \return E.enumerate (N.Nat^::succ i) = E.enumerate j -> N.Nat^::succ i = j \with {
        | zero: \fun (equal: _) => Logic.falseElim _ (stepNotOrigin (E.enumerate i) equal)
        | succ: \fun (j: N.Nat^) (_: E.enumerate (N.Nat^::succ i) = E.enumerate j -> N.Nat^::succ i = j)
          (equal: E.enumerate (N.Nat^::succ i) = E.enumerate (N.Nat^::succ j)) => \block {
          \let earlier: E.enumerate i = E.enumerate j := eq_reason_in!{Pair.NatPair _
            "=" _ "by" { sym!{Pair.NatPair} _ _ (previousStep (E.enumerate i)) }
            "=" _ "by" { congr!{Pair.NatPair Pair.NatPair} previous _ _ equal }
            "=" _ "by" { previousStep (E.enumerate j) }
          } \then
          \return congr!{N.Nat^ N.Nat^} (\fun (m: N.Nat^) => N.Nat^::succ m) _ _ (prior j earlier)
        }
      }
  };
\structure Bounds[k: N.Nat^, p: Pair.NatPair]: \Prop := {
  first: Nat.Le (Pair.natPairFirst p) k,
  second: Nat.Le (Pair.natPairSecond p) k,
};
\definition stepBounds: \forall (k: N.Nat^) (p: Pair.NatPair) -> Bounds[k, p] -> Bounds[N.Nat^::succ k, E.step p] :=
  \fun (k: N.Nat^) => Pair.natPairElim
    (\fun (p: Pair.NatPair) => Bounds[k, p] -> Bounds[N.Nat^::succ k, E.step p])
    (\fun (a, b: N.Nat^) => (\induction (b: N.Nat^) \return Bounds[k, Pair.natPair a b] -> Bounds[N.Nat^::succ k, E.step (Pair.natPair a b)] \with {
      | zero: \fun (bound: Bounds[k, Pair.natPair a N.Nat^::zero]) => Bounds[N.Nat^::succ k, E.step (Pair.natPair a N.Nat^::zero)] {
        first := Nat.zeroLe (N.Nat^::succ k),
        second := Nat.leSuccSucc a k bound.first,
      }
      | succ: \fun (b: N.Nat^) (_: _) (bound: Bounds[k, Pair.natPair a (N.Nat^::succ b)]) => Bounds[N.Nat^::succ k, E.step (Pair.natPair a (N.Nat^::succ b))] {
        first := Nat.leSuccSucc a k bound.first,
        second := Nat.leStep k b (Nat.leTrans b (N.Nat^::succ b) k (Nat.leSelfSucc b) bound.second),
      }
    }) b);
\definition enumerateBounds: \forall (k: N.Nat^) -> Bounds[k, E.enumerate k] :=
  \induction (k: N.Nat^) \return Bounds[k, E.enumerate k] \with {
    | zero: Bounds[N.Nat^::zero, E.enumerate N.Nat^::zero] { first := Nat.leRefl N.Nat^::zero, second := Nat.leRefl N.Nat^::zero }
    | succ: \fun (k: N.Nat^) (prior: Bounds[k, E.enumerate k]) => stepBounds k (E.enumerate k) prior
  };
\import std.Data[].FinSet[] \as Fin;
\definition row[n: N.Nat^] [i: Fin.Fin n]: Fin.Fin n :=
  \into[N.Nat^](Pair.natPairFirst (E.enumerate i), Fin.Fin n) \by {
    Nat.leLtTrans (Pair.natPairFirst (E.enumerate i)) i n (enumerateBounds i).first (Fin.bound n i)
  };
\definition column[n: N.Nat^] [i: Fin.Fin n]: Fin.Fin n :=
  \into[N.Nat^](Pair.natPairSecond (E.enumerate i), Fin.Fin n) \by {
    Nat.leLtTrans (Pair.natPairSecond (E.enumerate i)) i n (enumerateBounds i).second (Fin.bound n i)
  };
\definition pairEta: \forall (p: Pair.NatPair) -> Pair.natPair (Pair.natPairFirst p) (Pair.natPairSecond p) = p :=
  Pair.natPairElim (\fun (p: Pair.NatPair) => Pair.natPair (Pair.natPairFirst p) (Pair.natPairSecond p) = p)
    (\fun (a, b: N.Nat^) => \refl(Pair.natPair a b));
\definition indexInjective: \forall (n: N.Nat^) (i, j: Fin.Fin n) -> row n i = row n j -> column n i = column n j -> i = j :=
  \fun (n: N.Nat^) (i, j: Fin.Fin n) (sameRow: row n i = row n j) (sameColumn: column n i = column n j) =>
    enumerateInjective i j (eq_reason_in!{Pair.NatPair _
      "=" _ "by" { sym!{Pair.NatPair} _ _ (pairEta (E.enumerate i)) }
      "=" _ "by" { congr!{N.Nat^ N.Nat^ Pair.NatPair} Pair.natPair _ _ _ _ sameRow sameColumn }
      "=" _ "by" { pairEta (E.enumerate j) }
    });
\import std.Data[].Option[] \as Option;
\import Fin.Skipping[] \as Skip;
\definition skipSurjective: \forall (n: N.Nat^) (pivot, target: Fin.Fin (N.Nat^::succ n)) -> Logic.Not (pivot = target) ->
  \exists ( i: Fin.Fin n \where Skip.apply n pivot i = target ) :=
  \induction (n: N.Nat^) \return \forall (pivot, target: Fin.Fin (N.Nat^::succ n)) -> Logic.Not (pivot = target) ->
    \exists ( i: Fin.Fin n \where Skip.apply n pivot i = target ) \with {
    | zero: \fun (pivot, target: Fin.Fin (N.Nat^::succ N.Nat^::zero)) (different: Logic.Not (pivot = target)) =>
      Logic.falseElim _ (different (eq_reason_in!{{Fin.Fin (N.Nat^::succ N.Nat^::zero)} _
        "=" _ "by" { Fin.singletonValue pivot }
        "=" _ "by" { sym!{{Fin.Fin (N.Nat^::succ N.Nat^::zero)}} _ _ (Fin.singletonValue target) }
      }))
    | succ: \fun (n: N.Nat^) (prior: \forall (pivot, target: Fin.Fin (N.Nat^::succ n)) -> Logic.Not (pivot = target) ->
      \exists ( i: Fin.Fin n \where Skip.apply n pivot i = target )) (pivot, target: Fin.Fin (N.Nat^::succ (N.Nat^::succ n))) => \block {
      \let cases: \forall (p, t: Option.Option[Fin.Fin (N.Nat^::succ n)]) ->
        Logic.Not (Fin.inflate (N.Nat^::succ n) p = Fin.inflate (N.Nat^::succ n) t) ->
        \exists ( i: Fin.Fin (N.Nat^::succ n) \where Skip.apply (N.Nat^::succ n) (Fin.inflate (N.Nat^::succ n) p) i = Fin.inflate (N.Nat^::succ n) t ) :=
        \induction (p: Option.Option[Fin.Fin (N.Nat^::succ n)]) \return
          \forall (t: Option.Option[Fin.Fin (N.Nat^::succ n)]) -> Logic.Not (Fin.inflate (N.Nat^::succ n) p = Fin.inflate (N.Nat^::succ n) t) ->
          \exists ( i: Fin.Fin (N.Nat^::succ n) \where Skip.apply (N.Nat^::succ n) (Fin.inflate (N.Nat^::succ n) p) i = Fin.inflate (N.Nat^::succ n) t ) \with {
          | none: \induction (t: Option.Option[Fin.Fin (N.Nat^::succ n)]) \return
            Logic.Not (Fin.inflate (N.Nat^::succ n) Option.Option[Fin.Fin (N.Nat^::succ n)]::none = Fin.inflate (N.Nat^::succ n) t) ->
            \exists ( i: Fin.Fin (N.Nat^::succ n) \where Skip.apply (N.Nat^::succ n) (Fin.zero (N.Nat^::succ n)) i = Fin.inflate (N.Nat^::succ n) t ) \with {
              | none: \fun (different: _) => Logic.falseElim _ (different (\refl(Fin.zero (N.Nat^::succ n))))
              | some: \fun (t: Fin.Fin (N.Nat^::succ n)) (_: _) =>
                Logic.existsIntro[Fin.Fin (N.Nat^::succ n), { i: Fin.Fin (N.Nat^::succ n) \where Skip.apply (N.Nat^::succ n) (Fin.zero (N.Nat^::succ n)) i = Fin.succ (N.Nat^::succ n) t }] t (Skip.Step[n := n].first t)
            }
          | some: \fun (p: Fin.Fin (N.Nat^::succ n)) => \induction (t: Option.Option[Fin.Fin (N.Nat^::succ n)]) \return
            Logic.Not (Fin.succ (N.Nat^::succ n) p = Fin.inflate (N.Nat^::succ n) t) ->
            \exists ( i: Fin.Fin (N.Nat^::succ n) \where Skip.apply (N.Nat^::succ n) (Fin.succ (N.Nat^::succ n) p) i = Fin.inflate (N.Nat^::succ n) t ) \with {
              | none: \fun (_: _) => Logic.existsIntro[Fin.Fin (N.Nat^::succ n), { i: Fin.Fin (N.Nat^::succ n) \where Skip.apply (N.Nat^::succ n) (Fin.succ (N.Nat^::succ n) p) i = Fin.zero (N.Nat^::succ n) }] (Fin.zero n)
                (Skip.Step[n := n].successorZero p)
              | some: \fun (t: Fin.Fin (N.Nat^::succ n)) (different: Logic.Not (Fin.succ (N.Nat^::succ n) p = Fin.succ (N.Nat^::succ n) t)) => \block {
                \takefrom i: \Cast[Fin.Fin n] ({ i: Fin.Fin n \where Skip.apply n p i = t })
                  \by prior p t (\fun (same: p = t) => different (congr!{{Fin.Fin (N.Nat^::succ n)} {Fin.Fin (N.Nat^::succ (N.Nat^::succ n))}} (Fin.succ (N.Nat^::succ n)) _ _ same)) \then
                \let equal: Skip.apply n p i = t := \bysub(Fin.Fin n, { i: Fin.Fin n \where Skip.apply n p i = t }, i) \then
                \return Logic.existsIntro[Fin.Fin (N.Nat^::succ n), { j: Fin.Fin (N.Nat^::succ n) \where Skip.apply (N.Nat^::succ n) (Fin.succ (N.Nat^::succ n) p) j = Fin.succ (N.Nat^::succ n) t }] (Fin.succ n i)
                  (eq_reason_in!{{Fin.Fin (N.Nat^::succ (N.Nat^::succ n))} _
                    "=" _ "by" { Skip.Step[n := n].successorSuccessor p i }
                    "=" _ "by" { congr!{{Fin.Fin (N.Nat^::succ n)} {Fin.Fin (N.Nat^::succ (N.Nat^::succ n))}} (Fin.succ (N.Nat^::succ n)) _ _ equal }
                  })
              }
            }
        } \then
      \return \idelim Fin.inflate (N.Nat^::succ n) (Fin.split (N.Nat^::succ n) pivot) = pivot
        \with p: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)) => Logic.Not (p = target) ->
          \exists ( i: Fin.Fin (N.Nat^::succ n) \where Skip.apply (N.Nat^::succ n) p i = target )
        \by { base: \idelim Fin.inflate (N.Nat^::succ n) (Fin.split (N.Nat^::succ n) target) = target
          \with t: Fin.Fin (N.Nat^::succ (N.Nat^::succ n)) => Logic.Not (Fin.inflate (N.Nat^::succ n) (Fin.split (N.Nat^::succ n) pivot) = t) ->
            \exists ( i: Fin.Fin (N.Nat^::succ n) \where Skip.apply (N.Nat^::succ n) (Fin.inflate (N.Nat^::succ n) (Fin.split (N.Nat^::succ n) pivot)) i = t )
          \by { base: cases (Fin.split (N.Nat^::succ n) pivot) (Fin.split (N.Nat^::succ n) target), equality: Fin.inflateSplit (N.Nat^::succ n) target },
          equality: Fin.inflateSplit (N.Nat^::succ n) pivot }
    }
  };
