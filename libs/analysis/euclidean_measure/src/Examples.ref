\import \root.Euclidean[n := n] \as E;
\import functional_analysis.Measure[A := E.Point] \as Measure;
\import topology.Topology[Carrier := E.Point] \as Sets;

\definition empty: E.outer Sets.Empty = Measure.zero := E.outerEmpty;
\definition translation: \forall (S: \Pow E.Point) (a: E.Point) -> E.outer (E.shifted S a) = E.outer S := E.translationInvariant;
\definition complement: \forall (S: \Pow E.Point) -> E.Caratheodory S -> E.Caratheodory (Sets.Complement S) := E.complementCaratheodory;
\definition complete: \forall (S, T: \Pow E.Point) -> Sets.Subset S T -> E.MeasureConstruction[].measure.value T = Measure.zero ->
  Measure.Measurable E.MeasureConstruction[].measure.sigma S := E.MeasureConstruction[].complete;
\definition countableUnion: \forall (f: std.Data[].Nat[].Nat^ -> \Pow E.Point) ->
  (\forall (i: std.Data[].Nat[].Nat^) -> Measure.Null E.MeasureConstruction[].measure (f i)) ->
  Measure.Null E.MeasureConstruction[].measure (Measure.union f) := E.MeasureConstruction[].nullUnion;
\definition scaling: \forall (S: \Pow E.Point) (a: E.Scaling[].PositivePoint) ->
  E.MeasureConstruction[].measure.value (E.Scaling[].scaled S a) = Measure.scale (E.Scaling[].factor a) (E.MeasureConstruction[].measure.value S) := E.Scaling[].measureScale;
\definition borel: \forall (S: \Pow E.Point) -> Measure.Measurable E.Borel[].sigma S -> Measure.Measurable E.MeasureConstruction[].measure.sigma S :=
  \root.EuclideanBorel[n := n].borelMeasurable;
\definition outerRegular: \forall (S: \Pow E.Point) -> E.outer S = \root.CoverExpansion[n := n].openInfimum S :=
  \root.CoverExpansion[n := n].outerRegular;
\definition innerRegular: \forall (S: \Pow E.Point) -> E.Caratheodory S -> E.outer S = \root.InnerRegular[n := n].innerSup S :=
  \root.InnerRegular[n := n].innerRegular;
\definition compactBox: \forall (b: E.Box) -> Sets.IsCompactIn topological_algebra.Euclidean[].Dimension[n := n].Topology[].topology (E.points b) :=
  \root.BoxCompact[n := n].compact;
\definition volume: \forall (b: E.Box) -> E.outer (E.points b) = E.volumeValue b := \root.BoxVolume[n := n].boxVolume;
\definition hyperplane: \forall (i: std.Data[].FinSet[].Fin n) (a: real.Analysis[].Real) ->
  E.outer (\root.Hyperplane[n := n].Plane i a) = Measure.zero := \root.Hyperplane[n := n].null;
\definition signedScaling: \forall (sign: std.Data[].FinSet[].Fin n -> std.Data[].Bool[].Bool^) (S: \Pow E.Point)
  (a: E.Scaling[].PositivePoint) -> E.MeasureConstruction[].measure.value (E.SignedReflection[sign := sign].reflected (E.Scaling[].scaled S a)) =
  Measure.scale (E.Scaling[].factor a) (E.MeasureConstruction[].measure.value S) :=
  \fun (sign: std.Data[].FinSet[].Fin n -> std.Data[].Bool[].Bool^) => E.SignedReflection[sign := sign].signedScale;
\definition generalDiagonal: \forall (S: \Pow E.Point) (a: E.Point) ->
  std.Logic[].Proposition[].And[
    E.MeasureConstruction[].measure.value (\root.SingularScale[n := n].image S a) =
      Measure.scale (E.product n (\root.GeneralDiagonal[n := n].absPoint a)) (E.MeasureConstruction[].measure.value S),
    Measure.Measurable E.MeasureConstruction[].measure.sigma S -> Measure.Measurable E.MeasureConstruction[].measure.sigma (\root.SingularScale[n := n].image S a)] :=
  \root.GeneralDiagonal[n := n].formula;
\import integration.Real[] \as Integration;
\import \root.RealLine[] \as Line;
\import functional_analysis.Measure[A := real.Analysis[].Real] \as RealMeasure;
\import RealMeasure.Integral[mu := Line.measure] \as RealIntegral;
\definition riemannIntegral: \forall (interval: Integration.Interval) (f: Integration.Riemann[interval := interval].Def[].Function) ->
  RealIntegral.integral (Line.RiemannMap[interval := interval].representative f) = f.integral :=
  \fun (interval: Integration.Interval) => Line.RiemannMap[interval := interval].integral;
\definition completionIntegral: \forall (interval: Integration.Interval) (f: Integration.Lebesgue[interval := interval].Def[].Function) ->
  \exists ( g: RealIntegral.Representatives \where RealIntegral.integral g = Integration.Lebesgue[interval := interval].Prop[].integral f ) :=
  \fun (interval: Integration.Interval) => Line.CompletionAgreement[interval := interval].agreement;
