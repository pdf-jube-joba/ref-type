\import \root.On[A := A, mu := mu] \as On;
\import On.Finite[p := p] \as F;
\import On.Finite[p := p].Vector[] \as Vector;
\import On.Norm[p := p] \as N;
\import On.Completion[p := p] \as Complete;
\import On.SimpleApproximation[p := p] \as Simple;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import functional_analysis.Normed[V := F.Space, space := Vector.space] \as Normed;
\import functional_analysis.Measure[A := A].Integral[mu := mu] \as I;
\import std.Logic[].Proposition[] \as Logic;
\definition minkowski: \forall (f, g: F.Representatives) -> R.Le (F.normRepresentative (F.addRepresentative f g)) (Real.add (F.normRepresentative f) (F.normRepresentative g)) := N.representativeTriangle;
\definition banach: Normed.IsBanach N.norm := Complete.complete;
\definition simpleDensity: \forall (x: F.Space)(epsilon: Real.Real) -> R.Lt Real.zero epsilon -> \exists ( s: F.Representatives \where Logic.And[
  Simple.Simple s, Logic.And[I.Integrable s, R.Lt (N.metric.distance (F.ofFunction s) x) epsilon]] ) := Simple.dense;
\import \root.Powers[].Algebra[] \as PA;
\import On.Hilbert[] \as H;
\import On.Finite[p := PA.two] \as L2;
\import On.Finite[p := PA.two].Vector[] \as V2;
\import On.Norm[p := PA.two] \as N2;
\import functional_analysis.Normed[V := L2.Space, space := V2.space].Hilbert[norm := N2.norm] \as Hilbert;
\definition realL2: Hilbert.Hilbert[H.inner] := H.hilbert;
\module Holder(exponents: On.ConjugateExponents);
