\definition pointwise[x: A]: Product.abs (d.product x) = d.moment x := eq_reason_in!{Real.Real _
  "=" _ "by" { congr!{Real.Real Real.Real} Product.abs _ _ (d.productValue x) }
  "=" _ "by" { Product.absProduct (d.function x) (d.weight x) }
  "=" _ "by" { congr!{Real.Real Real.Real} (Real.mul (Product.abs (d.function x))) _ _ (Product.absOfNonnegative (d.weight x) (d.nonnegative x)) }
  "=" _ "by" { congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r (d.weight x)) _ _ (sym!{Real.Real} _ _
      (trans!{Real.Real} _ _ _ (congr!{P.Exponent Real.Real} (\fun (q: P.Exponent) => Powers.value (F.absolute d.function x) (Powers.exponent q)) _ _ equal) (Powers.identityValue (F.absolute d.function x)))) }
  "=" _ "by" { sym!{Real.Real} _ _ (d.momentValue x) }
};
\definition integral: I.integral (Absolute.representative d.product) = I.integral d.moment := Null.integralAlmost (Absolute.representative d.product) d.moment
  (AE.nullSubset _ Sets.Empty (\fun (x: A)(different: _) => different (pointwise x)) AE.nullEmpty);
\definition identity: Powers.value (\into[Real.Real](Product.abs (I.integral d.product), Powers.Nonnegative) \by { Product.absNonnegative _ }) (Powers.exponent p) = Product.abs (I.integral d.product) :=
  trans!{Real.Real} _ _ _ (congr!{P.Exponent Real.Real} (\fun (q: P.Exponent) => Powers.value (\into[Real.Real](Product.abs (I.integral d.product), Powers.Nonnegative) \by { Product.absNonnegative _ }) (Powers.exponent q)) _ _ equal)
    (Powers.identityValue _);
\definition inequality: R.Le (Powers.value (\into[Real.Real](Product.abs (I.integral d.product), Powers.Nonnegative) \by { Product.absNonnegative _ }) (Powers.exponent p)) (I.integral d.moment) :=
  R.leReplace _ _ _ _ (sym!{Real.Real} _ _ identity) integral (Absolute.integralAbsBound d.product);
