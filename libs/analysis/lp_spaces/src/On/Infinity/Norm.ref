\import \parent.Vector[] \as Vector;
\import functional_analysis.Normed[V := Space, space := Vector.space] \as Normed;
\definition triangle: \forall (x, y: Space) -> R.Le (norm (add x y)) (Real.add (norm x) (norm y)) := Q.induction2
  (\fun (x, y: Space) => R.Le (norm (add x y)) (Real.add (norm x) (norm y)))
  (\fun (f, g: Representatives) => R.leReplace _ _ _ _
    (sym!{Real.Real} _ _ (trans!{Real.Real} _ _ _ (congr!{Space Real.Real} norm _ _ (addClass f g)) (normOfFunction (addRepresentative f g))))
    (congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ (sym!{Real.Real} _ _ (normOfFunction f)) (sym!{Real.Real} _ _ (normOfFunction g))) (representativeTriangle f g));
\definition data: Normed.NormData := Normed.NormData { norm := norm };
\definition laws: Normed.NormLaws[data] := Normed.NormLaws[data] { nonnegative := nonnegative, zero := normZero, definite := definite, triangle := triangle, homogeneous := homogeneous };
\definition structure: Normed.Norm := \into[Normed.NormData](data, Normed.Norm) \by { laws };
\definition metric: metric_spaces.MetricSpace[Carrier := Space].Metric := Normed.metric structure;
