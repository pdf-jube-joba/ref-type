\import \parent.One[] \as One;
\import \parent.One[].Norm[] \as OneNorm;
\import \parent.Finite[p := Powers.one] \as F;
\import \root.Powers[].Algebra[] \as PA;
\definition inverseOne: Laws.fieldInv Real.one = Real.one := sym!{Real.Real} _ _
  (Real.Inverse[].inverseUnique Real.one Real.one (Real.Inverse[].positiveNonzero Real.one Product.onePositive) (Laws.fieldMulOneLeft Real.one));
\definition agreement[f: F.Representatives]: F.normRepresentative f = OneNorm.representative f := \block {
  \let equal: PA.inverseExponent F.positiveExponent = PA.oneBase := inverseOne \then
  \return eq_reason_in!{Real.Real _
    "=" _ "by" { congr!{Powers.Nonnegative Real.Real} (Powers.value (F.integralMoment f)) _ _ equal }
    "=" _ "by" { Powers.identityValue (F.integralMoment f) }
    "=" _ "by" { OneNorm.integralPointwise (F.momentRepresentative f) (Absolute.representative (One.toIntegral f))
      (\fun (x: A) => Powers.identityValue (F.absolute f x)) }
  }
};
\definition triangle: \forall (f, g: F.Representatives) -> R.Le (F.normRepresentative (F.addRepresentative f g)) (Real.add (F.normRepresentative f) (F.normRepresentative g)) :=
  \fun (f, g: F.Representatives) => R.leReplace _ _ _ _ (sym!{Real.Real} _ _ (agreement (F.addRepresentative f g)))
    (congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ (sym!{Real.Real} _ _ (agreement f)) (sym!{Real.Real} _ _ (agreement g)))
    (OneNorm.representativeTriangle f g);
