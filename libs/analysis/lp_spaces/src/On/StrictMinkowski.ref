\import \root.Powers[].Conjugate[p := p] \as C;
\import \root.Powers[].Algebra[] \as PA;
\import \root.Exponential[] \as Exp;
\import \parent.Finite[p := p] \as F;
\import \parent.Finite[p := C.exponent] \as G;
\definition exponents: ConjugateExponents := ConjugateExponents { left := p, right := C.exponent, identity := C.identity };
\import \parent.Holder[exponents := exponents] \as H;
\definition differenceExponent: Exp.Positive := \into[Real.Real](C.gap, Exp.Positive) \by { C.gapPositive };
\module For(f, g: F.Representatives);
