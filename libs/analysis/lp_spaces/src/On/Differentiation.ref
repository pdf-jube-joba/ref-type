\import calculus.Real[].Derivative[].Def[] \as Derivative;
\import calculus.Real[].Limit[].Def[] \as Limit;
\import metric_spaces.RealMetric[] \as Line;
\import \parent.Parametric[B := Real.Real, metric := Line.metric] \as Parameters;
\import \root.Exponential[] \as Exp;
\import topology.Topology[Carrier := Real.Real] \as Sets;
\structure Data: \Set := {
  function: Real.Real -> I.Representatives,
  derivative: I.Representatives,
  at: Real.Real,
  radius: Exp.Positive,
  bound: I.Representatives,
  dominated: \forall (t: Real.Real) -> Logic.Not (t = at) -> R.Lt (Real.distance t at) radius -> \forall (x: A) ->
    R.Le (Product.abs (Derivative.slope (\fun (s: Real.Real) => function s x) at t)) (bound x),
  pointwise: \forall (x: A) -> Derivative.HasDerivativeAt (\fun (t: Real.Real) => function t x) at (derivative x),
};
\module For(d: Data);
\definition derivative[d: Data]: Derivative.HasDerivativeAt (\fun (t: Real.Real) => I.integral (d.function t)) d.at (I.integral d.derivative) := For[d := d].derivative;
