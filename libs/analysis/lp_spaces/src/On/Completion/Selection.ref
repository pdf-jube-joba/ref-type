\definition Choice[k: N.Nat^]: \Set := \Cast[N.Nat^] ({ n: N.Nat^ \where Control[s, Dyadic.value (N.Nat^::succ k), n] });
\definition choiceExists[k: N.Nat^]: \exists Choice k :=
  (\bysub(N.Nat^ -> F.Representatives, { s: N.Nat^ -> F.Representatives \where Cauchy s }, s))
    (Dyadic.value (N.Nat^::succ k)) (Limits.dyadicPositive (N.Nat^::succ k));
\module For(choice: \forall (k: N.Nat^) -> Choice k);
\definition exists: \exists ( index: (N.Nat^ -> N.Nat^) \where Good[s, index] ) := \block {
  \takefrom choice: \forall (k: N.Nat^) -> Choice k \by \axiom:classicalIndefiniteChoice(N.Nat^, Choice, choiceExists) \then
  \return Logic.existsIntro[N.Nat^ -> N.Nat^, { index: N.Nat^ -> N.Nat^ \where Good[s, index] }]
    (For[choice := choice].index) (For[choice := choice].good)
};
