\import On.Infinity[] \as F;
\import F.Vector[] \as Vector;
\import F.Norm[] \as Norm;
\import F.Completion[] \as Complete;
\import functional_analysis.Normed[V := F.Space, space := Vector.space] \as Normed;
\import On.Endpoint[] \as Holder;
\import On.Finite[p := \root.Powers[].one] \as One;
\definition banach: Normed.IsBanach Norm.structure := Complete.complete;
\definition holder: \forall (f: One.Representatives)(g: F.Representatives) -> R.Le (Holder.absoluteIntegral f g) (Real.mul (One.normRepresentative f) (F.normRepresentative g)) := Holder.inequality;
