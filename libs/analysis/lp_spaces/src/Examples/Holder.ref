\import On.Holder[exponents := exponents] \as H;
\import On.Finite[p := exponents.left] \as Left;
\import On.Finite[p := exponents.right] \as Right;
\definition integrable: \forall (f: Left.Representatives)(g: Right.Representatives) -> I.Integrable (H.function f g) := H.integrable;
\definition bound: \forall (f: Left.Representatives)(g: Right.Representatives) -> R.Le (H.absoluteIntegral f g) (Real.mul (Left.normRepresentative f) (Right.normRepresentative g)) := H.inequality;
