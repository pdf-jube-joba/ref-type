\import On.Complex[] \as C;
\import C.Vector[] \as V;
\import C.Geometry[] \as Geometry;
\import C.Inner[] \as Inner;
\import C.Complete[] \as Complete;
\import C.Characterization[] \as Characterization;
\import complex_hilbert.Space[V := C.Space, space := V.space].Hilbert[norm := Geometry.norm, inner := Inner.inner] \as Hilbert;
\definition complexL2: Hilbert.Complete := Complete.hilbert;
\definition usualL2[f: C.Function]: Logic.And[C.HasMoment f -> Characterization.AbsoluteMoment f, Characterization.AbsoluteMoment f -> C.HasMoment f] := Characterization.equivalence f;
\definition complexMinkowski: \forall (f, g: C.Representatives) -> R.Le (C.normRepresentative (C.addRepresentative f g)) (Real.add (C.normRepresentative f) (C.normRepresentative g)) := Geometry.representativeTriangle;
