\import L.Completion[p := p].Along[s := cauchySequence, index := index, good := good] \as Construction;
\import Construction.Limit[] \as Target;
\definition targetClass: F.ofFunction Target.representative = x := Metric.limitUnique Norm.metric (\fun (k: N.Nat^) => Approximation.ofSmooth (s k)) (F.ofFunction Target.representative) x
  (Approximation.normConvergence sequence Target.representative Target.converges) converges;
\definition outsideZero: Logic.Not (M.below (E.outer Construction.exception) Real.zero) := \fun (member: _) => R.ltIrrefl Real.zero
  (\idelim E.outer Construction.exception = M.zero \with v: M.Value => M.below v Real.zero \by { base: member, equality: (Null.nullSetLaw Construction.exception).zeroMeasure });
\module MeasurableHull(opens: N.Nat^ -> \Pow Point, hull: Hull.Hull Construction.exception opens);
\definition existsRepresentative: \exists Representative[x] := \block {
  \takefrom opens: \Cast[N.Nat^ -> \Pow Point] ({ opens: N.Nat^ -> \Pow Point \where Hull.Hull Construction.exception opens }) \by Hull.finiteHull Construction.exception Real.zero outsideZero \then
  \return \exact(MeasurableHull[opens := opens, hull := \bysub(N.Nat^ -> \Pow Point, { opens: N.Nat^ -> \Pow Point \where Hull.Hull Construction.exception opens }, opens)].representative, Representative[x])
};
