\import M.Finite[mu := measure] \as Lebesgue;
\definition data: M.MeasureData := M.MeasureData { sigma := BorelSigma.sigma, value := measure.value };
\definition laws: M.MeasureLaws[data] := M.MeasureLaws[data] {
  nonnegative := \fun (S: \Pow Point)(valid: _) => Lebesgue.laws.nonnegative S (Borel.borelMeasurable S valid),
  empty := Lebesgue.laws.empty,
  countableAdditivity := \fun (sets: N.Nat^ -> \Pow Point)(valid: _)(disjoint: _) => Lebesgue.laws.countableAdditivity sets (\fun (k: N.Nat^) => Borel.borelMeasurable (sets k) (valid k)) disjoint,
};
\definition borel: M.Measure := \into[M.MeasureData](data, M.Measure) \by { laws };
