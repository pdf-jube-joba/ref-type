\import calculus.Real[].MeanValue[].Interval[a := left, b := right] \as Mean;
\import Mean.Estimate[] \as Estimate;
\definition increment[c: Nonnegative]: (\forall (x: Point) -> R.Le (Product.abs (Partial.function x)) c) -> R.Lt left right ->
  R.Le (Product.abs (Real.sub (curve right) (curve left))) (Real.mul c (Real.distance right left)) := \fun (bounded: _)(ordered: _) => R.leReplaceLeft _ _ _
    (trans!{Real.Real} _ _ _
      (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.distance r Real.zero) _ _
        (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (Real.sub (Real.sub (curve right) (curve left))) _ _ (Laws.fieldMulZeroLeft (Real.sub right left))) (Laws.subZeroRight _)))
      (Distance.distanceSymmetric _ _))
    (Estimate.increment curve coefficient Real.zero c ordered (\fun (x: \Cast[Real.Real] (Line.ClosedInterval left right)) => derivative x)
      (\fun (s: Real.Real)(interior: _) => R.leReplaceLeft _ _ _ (Distance.distanceSymmetric Real.zero (coefficient s)) (bounded (point s))));
