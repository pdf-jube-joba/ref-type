\definition exceptionNull: M.Null measure result.exception := Logic.existsIntro[\Pow Point, { S: \Pow Point \where M.NullCover[measure, result.exception, S] }] result.exception
  (M.NullCover[measure, result.exception, result.exception] { measurable := (Null.nullSetLaw result.exception).measurable, measure := (Null.nullSetLaw result.exception).zeroMeasure, included := \fun (x: Point)(member: Sets.Member result.exception x) => member });
\definition almost: M.AlmostEqual measure result.function function := AE.nullSubset _ result.exception
  (\fun (x: Point)(different: _) => Sigma.doubleNegative (Sets.Member result.exception x) (\fun (outside: _) => different (trans!{Real.Real} _ _ _ (result.values x)
    (trans!{Real.Real} _ _ _
      (Null.integralAlmost (result.sections x) (OneConvolution.standard input kernel x) (AE.nullSubset _ Sets.Empty
        (\fun (y: Point)(different: _) => different (result.sectionValues x outside y)) AE.nullEmpty))
      (OneConvolution.standardIntegral input kernel x)))))
  exceptionNull;
\definition integrable: I.Integrable function := Null.integrableAlmost result.function function almost (I.integralLaw result.function).integrable measurable;
