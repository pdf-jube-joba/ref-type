\definition half: Nonnegative := \into[Real.Real](Real.mul Real.half epsilon, Nonnegative) \by { Order.leOfLt _ _ (Estimates.halfOfPositive epsilon (\root.Exponential[].positive epsilon)) };
\definition convergence: \exists ( k: N.Nat^ \where Sequence.LimitControl (\fun (j: N.Nat^) => sequence j x) (input x) epsilon k ) := \block {
  \takefrom delta: \Cast[Real.Real] ({ delta: Real.Real \where Analysis.ContinuityControl[Open.whole, Restriction.function Open.whole f, Whole.point x, half, delta] })
    \by Properties.continuous Open.whole (Restriction.function Open.whole f) (smoothCompactLaws f).smooth (Whole.point x) half (Estimates.halfOfPositive epsilon (\root.Exponential[].positive epsilon)) \then
  \let control: Analysis.ContinuityControl[Open.whole, Restriction.function Open.whole f, Whole.point x, half, delta] := \bysub(Real.Real,
    { delta: Real.Real \where Analysis.ContinuityControl[Open.whole, Restriction.function Open.whole f, Whole.point x, half, delta] }, delta) \then
  \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where \forall (j: N.Nat^) -> Nat.Le k j -> R.Lt (identity.sequence j).radius delta }) \by identity.shrinking delta control.positive \then
  \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Sequence.LimitControl (\fun (j: N.Nat^) => sequence j x) (input x) epsilon k }] k
    (\fun (j: N.Nat^)(later: _) => R.leLtTrans _ _ _ (Convolution.Probability[rho := identity.sequence j, law := identity.normalized j].Error[f := input, x := x].estimate half
      (\fun (y: Point)(nonzero: _) => Order.leOfLt _ _ (control.estimate (Whole.point (E.subPoint x y))
        (R.leLtTrans _ _ _ (Translation.shiftDistance x y)
          (R.leLtTrans _ _ _ (R.leReplaceLeft _ _ _ (Geometry.metric.symmetric Coordinates.origin y)
            ((identity.sequence j).radiusBound y (Support.nonzeroInSupport Ambient.topology (identity.sequence j).function y nonzero)))
            ((\bysub(N.Nat^, { k: N.Nat^ \where \forall (j: N.Nat^) -> Nat.Le k j -> R.Lt (identity.sequence j).radius delta }, k)) j later))))))
      (Estimates.halfStrict epsilon (\root.Exponential[].positive epsilon)))
};
