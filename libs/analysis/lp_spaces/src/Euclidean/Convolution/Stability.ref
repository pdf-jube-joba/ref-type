\import \root.Euclidean[n := n].Convolution[p := p] \as Convolution;
\import Convolution.Difference[f := f, g := g, rho := rho] \as Difference;
\import M.Functions[mu := BorelMeasure.borel] \as BF;
\import L.Completion[p := p] \as Completion;
\definition borelDifference: M.IsMeasurable BorelMeasure.borel Difference.input := BF.addMeasurable f (\fun (x: Point) => Real.neg (g x)) borelF (BF.negMeasurable g borelG);
\import Convolution.Normalized[f := f, rho := rho, borel := borelF, nonnegative := law.nonnegative, mass := law.mass] \as Left;
\import Convolution.Normalized[f := g, rho := rho, borel := borelG, nonnegative := law.nonnegative, mass := law.mass] \as Right;
\import Convolution.Normalized[f := Difference.input, rho := rho, borel := borelDifference, nonnegative := law.nonnegative, mass := law.mass] \as Error;
\definition difference: F.Representatives := F.addRepresentative Left.representative (F.negRepresentative Right.representative);
\definition equality: F.normRepresentative difference = F.normRepresentative Error.representative := F.normRespects difference Error.representative
  (AE.nullSubset _ Sets.Empty (\fun (x: Point)(different: _) => different (sym!{Real.Real} _ _ (Difference.integral x))) AE.nullEmpty);
\definition bound: R.Le (Completion.distance Left.representative Right.representative) (Completion.distance f g) := R.leReplaceLeft _ _ _ (sym!{Real.Real} _ _ equality) Error.norm;
