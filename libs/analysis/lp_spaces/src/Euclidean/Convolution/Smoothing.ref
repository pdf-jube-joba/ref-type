\import L.Norm[p := p] \as Norm;
\import functional_analysis.Metric[Carrier := F.Space] \as Metric;
\import \root.Euclidean[n := n].Convolution[p := p] \as Convolution;
\import \root.Euclidean[n := n].BorelRepresentative[p := p] \as Borel;
\import \root.Euclidean[n := n].Approximation[p := p] \as Dense;
\definition value[k: N.Nat^][x: F.Space]: F.Space := Convolution.Operator[rho := identity.sequence k, law := identity.normalized k].value x;
\module For(x: F.Space, representative: Borel.Representative[x]);
\definition convergence[x: F.Space]: Metric.Converges Norm.metric (\fun (k: N.Nat^) => value k x) x := \block {
  \takefrom representative: Borel.Representative[x] \by Borel.existsRepresentative x \then
  \return For[x := x, representative := representative].convergence
};
\definition smoothRepresentative[x: F.Space][k: N.Nat^]: \exists ( f: F.Representatives \where Logic.And[Smooth.IsSmooth f, F.ofFunction f = value k x] ) := \block {
  \takefrom representative: Borel.Representative[x] \by Borel.existsRepresentative x \then
  \return For[x := x, representative := representative].smoothRepresentative k
};
