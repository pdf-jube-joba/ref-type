\import Convolution.Normalized[f := representative.representative, rho := rho, borel := representative.borel, nonnegative := law.nonnegative, mass := law.mass] \as Average;
\definition average: F.Representatives := Average.representative;
\definition almost: M.AlmostEqual measure f representative.representative := Q.equivalentOfClassEq F.equivalence f representative.representative (sym!{F.Space} _ _ representative.represents);
\definition values[x: Point]: function f rho x = average x := Convolution.Respects[f := f, g := representative.representative, rho := rho, a := x].equality almost;
\definition hasMoment: M.Lp[mu := measure].HasFiniteMoment[function f rho, p] := \idelim (\fun (x: Point) => average x) = function f rho \with h: Function => M.Lp[mu := measure].HasFiniteMoment[h, p] \by {
  base: F.properties average, equality: \axiom:funext((\fun (x: Point) => average x), function f rho, \fun (x: Point) => sym!{Real.Real} _ _ (values x)) };
\definition norm: R.Le (F.normRepresentative average) (F.normRepresentative f) := R.leReplaceRight _ _ _
  (F.normRespects representative.representative f (AE.symmetric f representative.representative almost)) Average.norm;
