\import I.Linear[] \as Linear;
\import I.Negation[] \as Negation;
\definition input: F.Representatives := F.addRepresentative f (F.negRepresentative g);
\definition sum[x: Point]: I.Representatives := Linear.addRepresentative (section f rho x) (Negation.representative (section g rho x));
\definition integral[x: Point]: function input rho x = Real.sub (function f rho x) (function g rho x) := trans!{Real.Real} _ _ _
  (Null.integralAlmost (section input rho x) (sum x) (AE.nullSubset _ Sets.Empty
    (\fun (y: Point)(different: _) => different (Algebra.subMul (f y) (g y) (rho.function (E.subPoint x y)))) AE.nullEmpty))
  (trans!{Real.Real} _ _ _ (Linear.integralAdd (section f rho x) (Negation.representative (section g rho x)))
    (congr!{Real.Real Real.Real} (Real.add (function f rho x)) _ _ (Negation.integralNeg (section g rho x))));
