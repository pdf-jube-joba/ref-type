\definition input: F.Representatives := Compact.representative f;
\definition function: Function := \root.Euclidean[n := n].Convolution[p := p].function input rho;
\module Bounded(radius: Nonnegative, radiusBound: \forall (x: Point) -> Sets.Member (Smooth.support f) x -> R.Le (Geometry.metric.distance Coordinates.origin x) radius);
\definition compact: Sets.IsCompactIn Ambient.topology (Smooth.support function) := \block {
  \takefrom r: \Cast[Nonnegative] ({ r: Nonnegative \where \forall (x: Point) -> Sets.Member (Smooth.support f) x -> R.Le (Geometry.metric.distance Coordinates.origin x) r })
    \by Bounds.radiusBound (Smooth.support f) (Compact.continuousLaws f).support \then
  \return Bounded[radius := r, radiusBound := \bysub(Nonnegative, { r: Nonnegative \where \forall (x: Point) -> Sets.Member (Smooth.support f) x -> R.Le (Geometry.metric.distance Coordinates.origin x) r }, r)].compact
};
\definition value: SmoothCompact := \into[Function](function, SmoothCompact) \by { SmoothCompactLaws[function] { smooth := smooth input rho, compact := compact } };
