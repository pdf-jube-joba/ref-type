\definition kernel[i: Fin.Fin n]: Kernel := choice i;
\definition matching[i: Fin.Fin n]: (kernel i).function = SmoothOperations.partial rho.function i := \bysub(Kernel, { k: Kernel \where k.function = SmoothOperations.partial rho.function i }, choice i);
\definition partial[i: Fin.Fin n]: Open.ScalarFunction Open.whole := Restriction.function Open.whole (function f (kernel i));
\definition derivative[i: Fin.Fin n]: Analysis.HasPartialDerivative Open.whole (Restriction.function Open.whole (function f rho)) i (partial i) :=
  \fun (a: Open.Carrier Open.whole) => Convolution.Derivative[f := f, rho := rho, derivativeKernel := kernel i, i := i, matching := matching i, a := a].derivative;
\import Regular.Successor[U := Open.whole, f := Restriction.function Open.whole (function f rho), g := partial, k := k] \as Proof;
\definition smooth: Regular.ContDiffOn Open.whole (N.Nat^::succ k) (Restriction.function Open.whole (function f rho)) := Proof.contDiff (continuous rho) derivative (\fun (i: Fin.Fin n) => induction (kernel i));
