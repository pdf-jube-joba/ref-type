\import \root.Euclidean[n := n].ReflectedTranslation[a := a] \as Reflected;
\import L.Pullback[p := p, map := Reflected.map] \as Pullback;
\definition almost: M.AlmostEqual measure f g -> M.AlmostEqual measure (\fun (y: Point) => f (E.subPoint a y)) (\fun (y: Point) => g (E.subPoint a y)) := \fun (same: _) =>
  AE.nullSubset _ ({ y: Point \where Logic.Not (f (Reflected.function y) = g (Reflected.function y)) })
    (\fun (y: Point)(different: _)(equal: _) => different (trans!{Real.Real} _ _ _ (sym!{Real.Real} _ _ (congr!{Point Real.Real} f _ _ (Reflected.pointwise y)))
      (trans!{Real.Real} _ _ _ equal (congr!{Point Real.Real} g _ _ (Reflected.pointwise y)))))
    (Pullback.nullPreimage ({ x: Point \where Logic.Not (f x = g x) }) same);
\definition equality: M.AlmostEqual measure f g -> function f rho a = function g rho a := \fun (same: _) => trans!{Real.Real} _ _ _ (sym!{Real.Real} _ _ (standardIntegral f rho a))
  (trans!{Real.Real} _ _ _
    (Null.integralAlmost (standard f rho a) (standard g rho a) (L.binaryAlmost Real.mul (\fun (y: Point) => f (E.subPoint a y)) (\fun (y: Point) => g (E.subPoint a y)) rho.function rho.function (almost same) (AE.reflexive rho.function)))
    (standardIntegral g rho a));
