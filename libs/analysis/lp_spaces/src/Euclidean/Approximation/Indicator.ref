\import L.Indicator[p := p, S := S] \as Target;
\import \root.Euclidean[n := n].IndicatorApproximation[p := p, S := S, box := box, bounded := bounded] \as Approximation;
\definition dense: Approximable (F.ofFunction Target.representative) := \fun (epsilon: Real.Real)(positive: _) => \block {
  \takefrom approximation: Approximation.Approximation \by Approximation.existsApproximation \then
  \let converges: Metric.Converges Norm.metric (\fun (k: N.Nat^) => ofSmooth (approximation.sequence k)) (F.ofFunction Target.representative) :=
    normConvergence (\fun (k: N.Nat^) => Compact.smoothRepresentative (approximation.sequence k)) Target.representative approximation.converges \then
  \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Metric.LimitControl Norm.metric (\fun (k: N.Nat^) => ofSmooth (approximation.sequence k)) (F.ofFunction Target.representative) epsilon k }) \by converges epsilon positive \then
  \return Logic.existsIntro[SmoothCompact, { f: SmoothCompact \where R.Lt (Norm.metric.distance (ofSmooth f) (F.ofFunction Target.representative)) epsilon }] (approximation.sequence k)
    ((\bysub(N.Nat^, { k: N.Nat^ \where Metric.LimitControl Norm.metric (\fun (k: N.Nat^) => ofSmooth (approximation.sequence k)) (F.ofFunction Target.representative) epsilon k }, k)) k (Nat.leRefl k))
};
