\import \root.Euclidean[n := n] \as E;
\import E.Approximation[p := p] \as Approximation;
\import E.Compact[p := p] \as Compact;
\import \root.On[A := E.Point, mu := E.measure].Finite[p := p] \as F;
\import \root.On[A := E.Point, mu := E.measure].Norm[p := p] \as Norm;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\definition smoothDensity: \forall (x: F.Space) -> Approximation.Approximable x := Approximation.smoothDense;
\definition continuousDensity: \forall (x: F.Space)(epsilon: Real.Real) -> R.Lt Real.zero epsilon -> \exists ( f: E.ContinuousCompact \where R.Lt (Norm.metric.distance (F.ofFunction (Compact.representative f)) x) epsilon ) := Approximation.continuousDense;
