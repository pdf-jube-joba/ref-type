\import \root.Euclidean[n := n] \as E;
\import E.Approximation[p := p] \as Approximation;
\import E.Compact[p := p] \as Compact;
\import \root.On[A := E.Point, mu := E.measure].Finite[p := p] \as F;
\import \root.On[A := E.Point, mu := E.measure].Norm[p := p] \as Norm;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\definition smoothDensity: \forall (x: F.Space) -> Approximation.Approximable x := Approximation.smoothDense;
\definition continuousDensity: \forall (x: F.Space)(epsilon: Real.Real) -> R.Lt Real.zero epsilon -> \exists ( f: E.ContinuousCompact \where R.Lt (Norm.metric.distance (F.ofFunction (Compact.representative f)) x) epsilon ) := Approximation.continuousDense;
\import E.Translation[p := p] \as Translation;
\import Translation.Group[] \as Translations;
\definition translationContinuous: \forall (x: F.Space)(epsilon: Real.Real) -> R.Lt Real.zero epsilon -> \exists ( delta: Real.Real \where Translation.Control[x, epsilon, delta] ) := Translation.continuous;
\definition translationAt: \forall (x: F.Space)(a: E.Point)(epsilon: Real.Real) -> R.Lt Real.zero epsilon -> \exists ( delta: Real.Real \where Translations.AtControl[x, a, epsilon, delta] ) := Translations.continuousAt;
\import E.BorelRepresentative[p := p] \as Borel;
\import E.Joint[] \as Joint;
\definition borelRepresentative: \forall (x: F.Space) -> \exists Borel.Representative[x] := Borel.existsRepresentative;
\definition measurableKernel[x: F.Space][representative: Borel.Representative[x]][rho: E.ContinuousCompact]: functional_analysis.Measure[A := Joint.PairPoint].IsMeasurable Joint.jointMeasure (Joint.kernel representative.representative rho) :=
  Joint.measurableKernel representative.representative rho representative.borel (Compact.continuousMeasurable rho (Compact.continuousLaws rho).continuous);
\import E.Convolution[p := p] \as Convolution;
\import functional_analysis.Metric[Carrier := F.Space] \as Metric;
\import functional_analysis.Measure[A := E.Point].Integral[mu := E.measure] \as I;
\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\definition approximateIdentity: Convolution.ApproximateIdentity := Convolution.approximateIdentity;
\import Convolution.Smoothing[identity := approximateIdentity] \as Smoothing;
\definition mollificationConverges[x: F.Space]: Metric.Converges Norm.metric (\fun (k: N.Nat^) => Smoothing.value k x) x := Smoothing.convergence x;
\definition mollificationSmooth[x: F.Space][k: N.Nat^]: \exists ( f: F.Representatives \where Logic.And[smooth_partitions.Euclidean[n := n].IsSmooth f, F.ofFunction f = Smoothing.value k x] ) := Smoothing.smoothRepresentative x k;
\definition mollificationNorm[k: N.Nat^][x: F.Space]: R.Le (F.norm (Smoothing.value k x)) (F.norm x) := Convolution.Operator[rho := approximateIdentity.sequence k, law := approximateIdentity.normalized k].norm x;
\definition integralFormula[f: F.Representatives][k: N.Nat^][x: E.Point]: Convolution.Operator[rho := approximateIdentity.sequence k, law := approximateIdentity.normalized k].representative f x =
  I.integral (Convolution.section f (approximateIdentity.sequence k) x) := \refl(I.integral (Convolution.section f (approximateIdentity.sequence k) x));
\definition compactMollification[f: E.ContinuousCompact][k: N.Nat^]: E.SmoothCompact := Convolution.CompactSupport[f := f, rho := approximateIdentity.sequence k].value;
