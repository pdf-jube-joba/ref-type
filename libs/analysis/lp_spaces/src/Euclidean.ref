\import euclidean_measure.Euclidean[n := n] \as E;
\import E.MeasureConstruction[] \as Construction;
\import topological_algebra.Euclidean[].Dimension[n := n].Def[] \as Coordinates;
\import topological_algebra.Euclidean[].Dimension[n := n].Norm[] \as Geometry;
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as Ambient;
\import euclidean_measure.EuclideanBorel[n := n] \as Borel;
\import E.Borel[] \as BorelSigma;
\import product_integration.Euclidean[n := n] \as Integration;
\import functional_analysis.Measure[A := E.Point] \as M;
\import M.Sigma[] \as Sigma;
\import M.Integral[mu := Construction.measure] \as I;
\import \root.On[A := E.Point, mu := Construction.measure] \as L;
\import product_integration.Finiteness[A := E.Point, mu := Construction.measure] \as Finite;
\import smooth_partitions.Euclidean[n := n] \as Smooth;
\import functional_analysis.Support[A := E.Point] \as Support;
\import topology.Topology[Carrier := E.Point] \as Sets;
\import topology.Maps[A := E.Point, B := real.Analysis[].Real] \as Maps;
\import metric_spaces.RealFunctions[A := E.Point] \as Functions;
\import metric_spaces.RealLine[] \as Line;
\import real.Analysis[] \as Real;
\import Real.Algebra[] \as Algebra;
\import Real.Estimates[] \as Estimates;
\import Estimates.Product[] \as Product;
\import Real.Distance[] \as Distance;
\import Real.Sequence[] \as Sequence;
\import Real.Sequence[].Operations[] \as Operations;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import R.Arithmetic[].Prop[] \as Laws;
\import R.Completeness[] \as Complete;
\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Nat;
\import std.Data[].Bool[] \as Bool;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\definition Point: \Set := E.Point;
\definition Function: \Set := Point -> Real.Real;
\definition measure: M.Measure := Construction.measure;
\definition Positive: \Set := \root.Exponential[].Positive;
\definition Nonnegative: \Set := \root.Powers[].Nonnegative;
\module CompactBounds;
\import functional_analysis.Continuous[A := Point, topology := Ambient.topology] \as Continuous;
\definition ContinuousCompact: \Set := Continuous.CompactSupport;
\structure SmoothCompactLaws[f: Function]: \Prop := {
  smooth: Smooth.IsSmooth f,
  compact: Sets.IsCompactIn Ambient.topology (Smooth.support f),
};
\definition SmoothCompact: \Set := \Cast[Function] ({ f: Function \where SmoothCompactLaws[f] });
\definition smoothCompactLaws[f: SmoothCompact]: SmoothCompactLaws[f] := \bysub(Function, { f: Function \where SmoothCompactLaws[f] }, f);
\module Compact(p: functional_analysis.Powers[].Exponent);
\module IndicatorApproximation(p: functional_analysis.Powers[].Exponent, S: Finite.FiniteMeasurableSet, box: E.Box, bounded: Sets.Subset S (E.points box));
\module SmoothOperations;
\module Approximation(p: functional_analysis.Powers[].Exponent);
\module Translation(p: functional_analysis.Powers[].Exponent);
