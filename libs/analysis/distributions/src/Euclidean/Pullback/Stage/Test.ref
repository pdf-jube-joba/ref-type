\import \parent.\parent.Test[phi := phi] \as Transformed;
\import Backward.Compact[f := phi, within := PullbackBase.testWithin U phi] \as Compact;
\import Sets.Subspace[S := Smooth.support phi] \as PhiDomain;
\import topology.Topology[Carrier := PhiDomain.CarrierSet] \as PhiSets;
\import topology.Maps[A := PhiDomain.CarrierSet, B := Point] \as PhiImages;
\definition carrierWithin: Sets.Subset Compact.carrier image := \fun (x: Point)(member: _) =>
  PhiImages.imageElim Compact.backward PhiSets.Whole x (Sets.Member image x)
    (\fun (y: PhiDomain.CarrierSet)(whole: _)(same: Compact.backward y = x) => \block {
      \let k: Domain.CarrierSet := \into[Point](y, K) \by { supported y (\bysub(Point, Smooth.support phi, y)) } \then
      \return \idelim forward k = x \with p: Point => Sets.Member image p \by {
        base: Images.imageMember forward DomainSets.Whole k (\refl(k)), equality: same
      }
    }) member;
\definition support: Sets.Subset (Smooth.support (test phi)) image :=
  Sets.subsetTrans _ _ _ Transformed.supportWithin carrierWithin;
