\import PullbackBase.Pullback[U := V, V := U, e := Inverse.inverse] \as Reverse;
\definition sourceTest[phi: SourceTest]: Reverse.test (test phi) = phi :=
  \axiom:funext(Reverse.test (test phi), phi, \fun (x: Point) => congr!{Test Real.Real} (\fun (f: Test) => f x) _ _ (inverseTest phi));
\definition targetTest[phi: TargetTest]: test (Reverse.test phi) = phi :=
  \axiom:funext(test (Reverse.test phi), phi, \fun (x: Point) => congr!{Test Real.Real} (\fun (f: Test) => f x) _ _ (Reverse.inverseTest phi));
\definition source[T: Source.Distribution]: apply (Reverse.apply T) = T :=
  Source.ext (apply (Reverse.apply T)) T (\fun (phi: SourceTest) => congr!{SourceTest Real.Real} T.eval _ _ (sourceTest phi));
\definition target[T: Target.Distribution]: Reverse.apply (apply T) = T :=
  Target.ext (Reverse.apply (apply T)) T (\fun (phi: TargetTest) => congr!{TargetTest Real.Real} T.eval _ _ (targetTest phi));
