\definition pairing[f: SourceTest]: Real.Real := T.eval (test f);
\module OnCompact(K: \Pow Point, compact: Sets.IsCompactIn Ambient.topology K, within: Sets.Subset K U.points);
\definition bounded: Source.LocallyBounded pairing := \fun (K: \Pow Point)(compact: _)(within: _) => OnCompact[K := K, compact := compact, within := within].exists;
\definition value: Source.Distribution := Source.Distribution {
  eval := pairing,
  additive := \fun (f,g: SourceTest) => trans!{Real.Real} _ _ _
    (congr!{TargetTest Real.Real} T.eval _ _ (testAdd f g)) (T.additive (test f) (test g)),
  homogeneous := \fun (c: Real.Real)(f: SourceTest) => trans!{Real.Real} _ _ _
    (congr!{TargetTest Real.Real} T.eval _ _ (testScale c f)) (T.homogeneous c (test f)),
  bound := bounded,
};
