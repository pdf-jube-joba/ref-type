\import Backward.Compact[f := phi, within := PullbackBase.testWithin U phi] \as Compact;
\definition value: TargetTest := \into[PullbackLp.SmoothCompact](Compact.value, TargetTest) \by { Compact.conditions.within };
\definition inside[y: PullbackOpen.Carrier V]:
  value y = PullbackReal.mul (InverseJacobian.absolute y) (phi (PullbackMaps.apply V U e.backward y)) := Compact.inside y;
\definition outside[y: PullbackLp.Point]:
  PullbackLogic.Not (PullbackSets.Member V.points y) -> value y = PullbackReal.zero := Compact.outside y;
\definition supportWithin: PullbackSets.Subset (PullbackSmooth.support value) Compact.carrier := Compact.supportWithin;
