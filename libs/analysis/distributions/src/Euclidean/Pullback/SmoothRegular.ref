\import PullbackOpen.Smooth[] \as ScalarSmooth;
\import PullbackMaps.Composition[U := U, V := V, f := e.forward] \as Composition;
\definition target: ScalarSmooth.SmoothFunction V := \into[PullbackOpen.ScalarFunction V](f, ScalarSmooth.SmoothFunction V) \by { smooth };
\definition function: PullbackOpen.ScalarFunction U := Composition.scalar target;
\definition regularity: ScalarSmooth.SmoothOn U function := Composition.smooth target;
\import Source.SmoothRegular[f := function, smooth := regularity] \as SourceRegular;
\import Target.SmoothRegular[f := f, smooth := smooth] \as TargetRegular;
\import change_of_variables.Euclidean[n := n].Compact[] \as Integrals;
\import functional_analysis.Measure[A := Point].Integral[mu := L.measure] \as Integral;
\module Pair(phi: SourceTest);
\definition pairing[phi: SourceTest]: TargetRegular.pair (test phi) = SourceRegular.pair phi := Pair[phi := phi].law;
\definition distribution: apply TargetRegular.distribution = SourceRegular.distribution :=
  Source.ext (apply TargetRegular.distribution) SourceRegular.distribution pairing;
