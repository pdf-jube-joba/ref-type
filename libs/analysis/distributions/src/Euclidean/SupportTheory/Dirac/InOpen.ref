\definition region: Open.OpenSet := OpenTopology.ofOpen U member.open;
\import Smooth.CompactCutoff[K := Sets.Singleton a, U := region] \as Cutoff;
\definition cutoffExists: \exists Cutoff.Data := Cutoff.existsCutoff
  (Sets.Compactness[].singletonCompact Ambient.topology a)
  (\fun (x: Point)(equal: x = a) => \idelim a = x \with y: Point => Sets.Member U y
    \by { base: contains, equality: sym!{Point} _ _ equal });
\module Chosen(cutoff: Cutoff.Data);
\definition contradiction: Logic.False := \block {
  \takefrom cutoff: Cutoff.Data \by cutoffExists \then
  \return Chosen[cutoff := cutoff].contradiction
};
