\definition test: Test := \into[L.Function](cutoff.value, Test) \by {
  L.SmoothCompactLaws[cutoff.value] { smooth := SmoothScalars.regular cutoff.value, compact := cutoff.supportCompact }
};
\definition contradiction: Logic.False := Laws.zeroNeOne (trans!{Real.Real} _ _ _
  (sym!{Real.Real} _ _ (member.vanishes test cutoff.supportWithin)) (cutoff.oneOn a (\refl(a))));
