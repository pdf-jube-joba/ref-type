\import \root.Euclidean[n := n].On[U := U] \as Local;
\definition zero: Test := Local.zero;
\definition add[f, g: Test]: Test := Local.add f g;
\definition scale[c: Real.Real][f: Test]: Test := Local.scale c f;
\definition jet[d: Directions][f: Test]: Test := Local.jet d f;
\definition ext[f, g: Test]: (\forall (x: Point) -> f x = g x) -> f = g :=
  \fun (same: _) => \axiom:funext(f, g, same);
\definition jetAdd[d: Directions][f, g: Test]: jet d (add f g) = add (jet d f) (jet d g) := GO.jetAdd d f g;
\definition jetScale[d: Directions][c: Real.Real][f: Test]: jet d (scale c f) = scale c (jet d f) := GO.jetScale d c f;
\definition jetZero[d: Directions]: jet d zero = zero := GO.jetZero d;
\definition zeroSupport: Sets.Subset (Smooth.support zero) Sets.Empty := GO.zeroSupport;
\definition scaleSupport[c: Real.Real][f: Test]: Sets.Subset (Smooth.support (scale c f)) (Smooth.support f) := GO.scaleSupport c f;
\definition addSupport[f, g: Test][K: \Pow Point]: Sets.IsClosedIn Ambient.topology K ->
  Sets.Subset (Smooth.support f) K -> Sets.Subset (Smooth.support g) K -> Sets.Subset (Smooth.support (add f g)) K := GO.addSupport f g K;
