\definition coefficient: Nonnegative := \into[Real.Real](Laws.fieldInv delta, Nonnegative) \by {
  Order.leOfLt _ _ (Absolute.invPositive delta control.positive)
};
\definition deltaNonzero: Logic.Not (delta = Real.zero) :=
  \fun (equal: _) => Order.ltNotEq Real.zero delta control.positive (sym!{Real.Real} _ _ equal);
\definition cancel[b: Real.Real]: Real.mul delta (Real.mul coefficient b) = b :=
  eq_reason_in!{Real.Real _
    "=" _ "by" { sym!{Real.Real} _ _ (Laws.fieldMulAssoc delta coefficient b) }
    "=" _ "by" { congr!{Real.Real Real.Real} (\fun (x: Real.Real) => Real.mul x b) _ _
      (trans!{Real.Real} _ _ _ (Laws.fieldMulComm delta coefficient) (Laws.fieldInverseNonzero delta deltaNonzero)) }
    "=" _ "by" { Laws.fieldMulOneLeft b }
  };
\module For(f: Test, supported: Supported K f, b: Nonnegative, jets: Global.JetBound f m b,
  contrary: R.Lt (Real.mul coefficient b) (Absolute.abs (t f)));
\definition bound: Bound t K m coefficient :=
  \fun (f: Test)(supported: _)(b: Nonnegative)(jets: _) => Order.leOfNotLtReverse _ _
    (\fun (contrary: _) => For[f := f, supported := supported, b := b, jets := jets, contrary := contrary].contradiction);
