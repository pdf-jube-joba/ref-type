\definition margin: Real.Real := Real.sub radius (p.value (difference f center));
\definition positive: R.Lt Real.zero margin := Absolute.subPositive radius (p.value (difference f center)) member;
\module Bounded(m: N.Nat^, C: Nonnegative, estimate: Bound p.value K m C);
\definition neighborhood: \exists ( m: N.Nat^ \where \exists ( r: Real.Real \where Final.Neighborhood[K, Ball p center radius, f, m, r] ) ) := \block {
  \takefrom m: \Cast[N.Nat^] ({ m: N.Nat^ \where \exists ( C: Nonnegative \where Bound p.value K m C ) }) \by bound p K compact within \then
  \takefrom C: \Cast[Nonnegative] ({ C: Nonnegative \where Bound p.value K m C })
    \by \bysub(N.Nat^, { m: N.Nat^ \where \exists ( C: Nonnegative \where Bound p.value K m C ) }, m) \then
  \return Logic.existsIntro[N.Nat^, { j: N.Nat^ \where \exists ( r: Real.Real \where Final.Neighborhood[K, Ball p center radius, f, j, r] ) }] m
    (Logic.existsIntro[Real.Real, { r: Real.Real \where Final.Neighborhood[K, Ball p center radius, f, m, r] }]
      (Bounded[m := m, C := C, estimate := \bysub(Nonnegative, { C: Nonnegative \where Bound p.value K m C }, C)].delta)
      (Bounded[m := m, C := C, estimate := \bysub(Nonnegative, { C: Nonnegative \where Bound p.value K m C }, C)].neighborhood))
};
