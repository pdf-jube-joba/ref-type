\import Regular.For[f := Regular.fromIntegral (Left.representative test)] \as LocalLeft;
\import Regular.For[f := Regular.fromIntegral (Right.representative test)] \as LocalRight;
\definition leftPair[phi: E.SmoothCompact]: LocalLeft.pair phi = Left.pair (Tests.product test phi) :=
  Left.integralsPointwise (LocalLeft.representative phi) (Left.representative (Tests.product test phi))
    (\fun (x: E.Point) => Laws.fieldMulAssoc (left x) (test x) (phi x));
\definition rightPair[phi: E.SmoothCompact]: LocalRight.pair phi = Right.pair (Tests.product test phi) :=
  Right.integralsPointwise (LocalRight.representative phi) (Right.representative (Tests.product test phi))
    (\fun (x: E.Point) => Laws.fieldMulAssoc (right x) (test x) (phi x));
\definition almost: SamePairings -> M.AlmostEqual E.measure (Left.integrand test) (Right.integrand test) := \fun (same: _) =>
  Regular.Global[left := Left.representative test, right := Right.representative test].injective
    (\fun (phi: E.SmoothCompact) => trans!{Real.Real} _ _ _ (leftPair phi)
      (trans!{Real.Real} _ _ _ (same (Tests.product test phi)) (sym!{Real.Real} _ _ (rightPair phi))));
