\import L.Finite[p := p] \as F;
\definition representative[f: F.Representatives]: Representatives := \into[E.Function](f, Representatives) \by { LocallyIntegrable[f] {
  measurable := (F.properties f).measurable,
  local := \fun (K: CompactSet) => L.Restriction[p := p, S := finiteSet K].integrable f,
} };
