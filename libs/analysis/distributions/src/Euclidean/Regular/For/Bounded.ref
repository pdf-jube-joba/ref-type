\definition local: I.Representatives := restrict (support test) f;
\definition dominator: I.Representatives := Scaling.representative c (Absolute.representative local);
\definition estimate[x: E.Point]: R.Le (Product.abs (integrand test x)) (dominator x) :=
  Logic.orElim _ _ _ (Classical.excludedMiddle (Sets.Member (Smooth.support test) x))
    (\fun (member: _) => R.leReplace _ _ _ _
      (sym!{Real.Real} _ _ (Product.absProduct (f x) (test x)))
      (trans!{Real.Real} _ _ _ (Laws.fieldMulComm (Product.abs (f x)) c)
        (congr!{Real.Real Real.Real} (Real.mul c) _ _ (sym!{Real.Real} _ _ (congr!{Real.Real Real.Real} Product.abs _ _ (inside (support test) f x member)))))
      (Estimates.mulMonotone (Product.abs (f x)) (Product.abs (test x)) c (Product.absNonnegative (f x)) (bound x)))
    (\fun (absent: _) => R.leReplaceLeft Real.zero _ _
      (sym!{Real.Real} _ _ (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} Product.abs _ _
        (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (Real.mul (f x)) _ _ (Support.zeroOutsideSupport Ambient.topology test x absent)) (Laws.fieldMulZeroRight (f x))))
        (Distance.distanceSelf Real.zero)))
      (Laws.fieldMulNonnegative c (Product.abs (local x)) (lp_spaces.Powers[].baseNonnegative c) (Product.absNonnegative (local x))));
\definition integrable: I.Integrable (integrand test) := Logic.And[_, _]::# (measurable test)
  (I.finiteMono (Absolute.abs (integrand test)) (Absolute.abs dominator) (\fun (x: E.Point) => Product.absNonnegative (integrand test x))
    (\fun (x: E.Point) => R.leReplaceRight _ _ _ (sym!{Real.Real} _ _ (Product.absOfNonnegative (dominator x)
      (Laws.fieldMulNonnegative c (Product.abs (local x)) (lp_spaces.Powers[].baseNonnegative c) (Product.absNonnegative (local x))))) (estimate x))
    (I.integralLaw dominator).integrable.right);
