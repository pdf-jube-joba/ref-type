\import Finite.Bounded[S := finiteSet K] \as Bounded;
\definition integrable: I.Integrable (restricted K function) := \block {
  \takefrom c: \Cast[Real.Real] ({ c: Real.Real \where \forall (x: E.Point) -> Sets.Member K x -> R.Le (Product.abs (function x)) c })
    \by Bounds.scalarBound K (\fun (x: E.Point) => Product.abs (function x)) (compact K)
      (Lattice.absoluteContinuous Ambient.topology function continuous) \then
  \let C: E.Nonnegative := \into[Real.Real](Distance.max Real.zero c, E.Nonnegative) \by { Distance.maxLeft Real.zero c } \then
  \return Bounded.integrable C (restricted K function) (Bounded.Conditions[restricted K function, C] {
    measurable := Products.measurable function (indicator K) measurable (I.integralLaw (indicator K)).integrable.left,
    bound := \fun (x: E.Point)(member: _) => R.leReplaceLeft _ _ _
      (sym!{Real.Real} _ _ (congr!{Real.Real Real.Real} Product.abs _ _ (inside K function x member)))
      (R.leTrans _ _ _
        ((\bysub(Real.Real, { c: Real.Real \where \forall (x: E.Point) -> Sets.Member K x -> R.Le (Product.abs (function x)) c }, c)) x member)
        (Distance.maxRight Real.zero c)),
    outside := outside K function,
  })
};
