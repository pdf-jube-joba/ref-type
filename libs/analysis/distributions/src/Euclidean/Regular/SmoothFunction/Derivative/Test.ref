\import Integrals.IntegrationByParts[f := phi, g := f, i := i] \as Parts;
\definition left: CurrentPair.pair (Operations.partial phi i) = I.integral Parts.left :=
  CurrentPair.integralsPointwise (CurrentPair.representative (Operations.partial phi i)) Parts.left
    (\fun (x: E.Point) => Laws.fieldMulComm (function x) (Operations.partial phi i x));
\definition right: NextPair.pair phi = I.integral Parts.right :=
  NextPair.integralsPointwise (NextPair.representative phi) Parts.right
    (\fun (x: E.Point) => Laws.fieldMulComm (Next.function x) (phi x));
\definition law: (Dual.partial (distribution representative) i).eval phi = (distribution Next.representative).eval phi :=
  eq_reason_in!{Real.Real _
    "=" _ "by" { Laws.fieldMulNegLeft Real.one (CurrentPair.pair (Operations.partial phi i)) }
    "=" _ "by" { congr!{Real.Real Real.Real} Real.neg _ _ (Laws.fieldMulOneLeft (CurrentPair.pair (Operations.partial phi i))) }
    "=" _ "by" { congr!{Real.Real Real.Real} Real.neg _ _ left }
    "=" _ "by" { congr!{Real.Real Real.Real} Real.neg _ _ Parts.theorem }
    "=" _ "by" { Laws.negInvolutive (I.integral Parts.right) }
    "=" _ "by" { sym!{Real.Real} _ _ right }
  };
