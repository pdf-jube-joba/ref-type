\import \root.Euclidean[n := n].Regular[].SmoothFunction[f := Differential.apply i f] \as Next;
\import \root.Euclidean[n := n].Regular[].For[f := representative] \as CurrentPair;
\import \root.Euclidean[n := n].Regular[].For[f := Next.representative] \as NextPair;
\module Test(phi: E.SmoothCompact);
\definition law: Dual.partial (distribution representative) i = distribution Next.representative :=
  Dual.ext (Dual.partial (distribution representative) i) (distribution Next.representative)
    (\fun (phi: E.SmoothCompact) => Test[phi := phi].law);
