\import \root.Euclidean[n := n].Regular[] \as CR;
\import CR.For[f := f] \as CRPair;
\import functional_analysis.Measure[A := ConvE.Point].Integral[mu := ConvL.measure] \as CRIntegral;
\definition integrand[rho: ConvL.SmoothCompact][a: ConvE.Point]: ConvL.Function :=
  \fun (y: ConvE.Point) => ConvReal.mul (f y) (rho (ConvE.subPoint a y));
\definition integral[rho: ConvL.SmoothCompact][a: ConvE.Point]:
  CRIntegral.HasIntegral[integrand rho a, function (CR.distribution f) rho a] :=
  CRPair.integralLaw (\parent.Translate[rho := rho, a := a].test);
\definition smooth[rho: ConvL.SmoothCompact]: ConvSmooth.IsSmooth (function (CR.distribution f) rho) :=
  \parent.Smoothness[T := CR.distribution f].smooth rho;
