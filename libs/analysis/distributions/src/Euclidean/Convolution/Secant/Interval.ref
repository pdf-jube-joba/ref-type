\import calculus.Real[].MeanValue[].Interval[a := a, b := b] \as CSMean;
\definition forward: ConvR.Lt a b -> ConvR.Le
  (ConvReal.distance (ConvReal.sub (ConvReal.sub (f b) (f a)) (ConvReal.mul (d a) (ConvReal.sub b a))) ConvReal.zero)
  (ConvReal.mul (ConvReal.mul c (ConvReal.distance b a)) (ConvReal.distance b a)) := \fun (ordered: _) =>
  CSMean.Estimate[].increment f d (d a) (ConvReal.mul c (ConvReal.distance b a)) ordered
    (\fun (x: \Cast[ConvReal.Real] (metric_spaces.RealLine[].ClosedInterval a b)) => derivative x)
    (\fun (s: ConvReal.Real)(interior: CSMean.Interior s) => ConvR.leTrans _ _ _ (lipschitz s a)
      (ConvEstimates.mulMonotone c _ _ (lp_spaces.Powers[].baseNonnegative c)
        (ConvEstimates.betweenDistance a b s
          (ConvR.leTrans _ _ _ (CSMetric.minLeft a b) (CSOrder.leOfLt a s (interior.left)))
          (ConvR.leTrans _ _ _ (CSOrder.leOfLt s b (interior.right)) (CSMetric.maxRight a b)))));
\definition backward: ConvR.Lt a b -> ConvR.Le
  (ConvReal.distance (ConvReal.sub (ConvReal.sub (f b) (f a)) (ConvReal.mul (d b) (ConvReal.sub b a))) ConvReal.zero)
  (ConvReal.mul (ConvReal.mul c (ConvReal.distance a b)) (ConvReal.distance b a)) := \fun (ordered: _) =>
  CSMean.Estimate[].increment f d (d b) (ConvReal.mul c (ConvReal.distance a b)) ordered
    (\fun (x: \Cast[ConvReal.Real] (metric_spaces.RealLine[].ClosedInterval a b)) => derivative x)
    (\fun (s: ConvReal.Real)(interior: CSMean.Interior s) => ConvR.leTrans _ _ _ (lipschitz s b)
      (ConvEstimates.mulMonotone c _ _ (lp_spaces.Powers[].baseNonnegative c)
        (ConvEstimates.betweenDistance b a s
          (ConvR.leTrans _ _ _ (CSMetric.minRight b a) (CSOrder.leOfLt a s (interior.left)))
          (ConvR.leTrans _ _ _ (CSOrder.leOfLt s b (interior.right)) (CSMetric.maxLeft b a)))));
