\import \root.Euclidean[n := n].Regular[] \as CLRegular;
\import CLRegular.Lp[p := p] \as CLLocal;
\import ConvL.Convolution[p := p] \as CLClassical;
\import functional_analysis.Measure[A := ConvE.Point].Integral[mu := ConvL.measure] \as CLIntegral;
\definition agreement[rho: CLClassical.Kernel][a: ConvE.Point]:
  function (CLRegular.distribution (CLLocal.representative f)) rho.function a = CLClassical.function f rho a :=
  CLIntegral.integralUnique
    (\fun (y: ConvE.Point) => ConvReal.mul (f y) (rho.function (ConvE.subPoint a y))) _ _
    (\parent.Regular[f := CLLocal.representative f].integral rho.function a)
    (CLIntegral.integralLaw (CLClassical.section f rho a));
