\import ConvOperations.Shift[f := f, a := a, y := y, i := i] \as CDShift;
\import calculus.Real[].Derivative[].Operations[] \as CDDerivatives;
\import calculus.Real[].Derivative[].Def[] \as CDDerivative;
\definition function: ConvReal.Real -> ConvReal.Real := CDShift.curve;
\definition center: function (a i) = f (ConvE.subPoint a y) := CDShift.center;
\definition derivativeCenter: CDShift.coefficient (a i) = CDTests.partial f i (ConvE.subPoint a y) :=
  ConvOperations.Shift[f := CDTests.partial f i, a := a, y := y, i := i].center;
\definition law: errorFor f y = ConvReal.sub (CDDerivative.slope function (a i) t) (CDShift.coefficient (a i)) := eq_reason_in!{ConvReal.Real _
  "=" _ "by" { congr!{ConvReal.Real ConvReal.Real ConvReal.Real} ConvReal.add _ _ _ _
    (congr!{ConvReal.Real ConvReal.Real} (ConvReal.mul inverse) _ _
      (congr!{ConvReal.Real ConvReal.Real} (ConvReal.add (function t)) _ _ (CDDerivatives.negativeScale (f (ConvE.subPoint a y)))))
    (CDDerivatives.negativeScale (CDTests.partial f i (ConvE.subPoint a y))) }
  "=" _ "by" { congr!{ConvReal.Real ConvReal.Real ConvReal.Real} ConvReal.sub _ _ _ _
    (trans!{ConvReal.Real} _ _ _
      (congr!{ConvReal.Real ConvReal.Real} (\fun (v: ConvReal.Real) => ConvReal.mul inverse (ConvReal.sub (function t) v)) _ _ (sym!{ConvReal.Real} _ _ center))
      (ConvLaws.fieldMulComm inverse (ConvReal.sub (function t) (function (a i)))))
    (sym!{ConvReal.Real} _ _ derivativeCenter) }
};
