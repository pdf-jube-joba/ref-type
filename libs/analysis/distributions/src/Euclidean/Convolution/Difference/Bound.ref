\import std.Data[].Nat[].Basic[].Prop[] \as CBNat;
\import lp_spaces.Powers[].Cuts[] \as CBCuts;
\definition rate: ConvL.Nonnegative := \into[ConvReal.Real](ConvReal.mul c (ConvReal.distance t (a i)), ConvL.Nonnegative) \by {
  ConvLaws.fieldMulNonnegative c (ConvReal.distance t (a i)) (lp_spaces.Powers[].baseNonnegative c) (ConvReal.Distance[].distanceNonnegative t (a i))
};
\definition secondBound[d: CDJets.CJDirections]: CBNat.Le (\root.Euclidean[n := n].order d) m -> \forall (x: ConvE.Point) ->
  ConvR.Le (ConvAbsolute.abs (CDTests.partial (CDTests.partial (CDTests.jet d rho) i) i x)) c := \fun (ordered: _)(x: ConvE.Point) =>
  bound (CDJets.CJDirections::cons i (CDJets.CJDirections::cons i d))
    (CBNat.leSuccSucc _ _ (CBNat.leSuccSucc _ _ ordered)) x;
\definition estimate: ConvLogic.Not (t = a i) -> \root.Euclidean[n := n].JetBound error m rate := \fun (different: _)(d: CDJets.CJDirections)(ordered: _)(y: ConvE.Point) =>
  ConvR.leReplaceLeft _ _ _ (sym!{ConvReal.Real} _ _ (\parent.Jet[d := d].absolute y))
    (ConvR.leReplaceLeft _ _ _ (sym!{ConvReal.Real} _ _
      (trans!{ConvReal.Real} _ _ _
        (congr!{ConvReal.Real ConvReal.Real} ConvAbsolute.abs _ _ (\parent.Pointwise[f := CDTests.jet d rho, y := y].law))
        (CBCuts.absDifference _ _)))
      (\parent.\parent.KernelSecant[rho := CDTests.jet d rho, a := a, y := y, i := i, c := c, bound := secondBound d ordered].estimate t different));
