\import ConvOperations.Shift[f := rho, a := a, y := y, i := i] \as CKShift;
\import ConvOperations.Shift[f := ConvOperations.partial rho i, a := a, y := y, i := i] \as CKSecond;
\import \parent.Lipschitz[f := CKShift.coefficient, d := CKSecond.coefficient, c := c,
  derivative := CKSecond.derivative, bound := \fun (t: ConvReal.Real) => bound (CKSecond.point t)] \as CKLipschitz;
\import \parent.Secant[f := CKShift.curve, d := CKShift.coefficient, c := c, derivative := CKShift.derivative,
  lipschitz := CKLipschitz.estimate] \as CKTaylor;
\definition estimate[t: ConvReal.Real]: ConvLogic.Not (t = a i) ->
  ConvR.Le (ConvReal.distance (calculus.Real[].Derivative[].Def[].slope CKShift.curve (a i) t) (CKShift.coefficient (a i)))
    (ConvReal.mul c (ConvReal.distance t (a i))) := CKTaylor.estimate (a i) t;
