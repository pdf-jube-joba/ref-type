\import calculus.Real[].Multivariable[n := n].Space[].Prop[] \as CTPoint;
\import calculus.Real[].Derivative[].Def[] \as CTDerivative;
\import calculus.Real[].Derivative[].Operations[] \as CTDerivatives;
\import calculus.Real[].Derivative[].Prop[] \as CTBasic;
\import calculus.Real[].Derivative[].Chain[] \as CTChain;
\import ConvOpen.Analysis[] \as CTAnalysis;
\import ConvOperations.Partial[f := rho, i := i] \as CTPartial;
\import std.Logic[].Classical[] \as CTClassical;
\definition target: ConvL.Function := \fun (y: ConvE.Point) => ConvReal.neg (CTPartial.function (ConvE.subPoint a y));
\module At(y: ConvE.Point);
\definition law: CTAnalysis.HasPartialDerivative ConvOpen.whole (ConvOpen.Restriction[].function ConvOpen.whole function) i
  (ConvOpen.Restriction[].function ConvOpen.whole target) := \fun (y: ConvOpen.Carrier ConvOpen.whole) => At[y := y].law;
\definition pointwise[y: ConvE.Point]: ConvOperations.partial test i y = target y :=
  CTAnalysis.Properties[].partialUnique ConvOpen.whole (ConvOpen.Restriction[].function ConvOpen.whole function) i
    (ConvOpen.Whole[].point y) (ConvOperations.partial test i y) (target y)
    (ConvOperations.Partial[f := test, i := i].law (ConvOpen.Whole[].point y)) (law (ConvOpen.Whole[].point y));
