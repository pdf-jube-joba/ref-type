\import \parent.\parent.CommonSupport[rho := rho, a := a, radius := radius, radiusBound := radiusBound] \as CS;
\definition K: \Pow ConvE.Point := ConvE.points CS.box;
\module Controlled(m: CCN.Nat^, C, b: ConvL.Nonnegative, bound: CC.Bound T.eval K m C,
  jets: CC.JetBound rho (CCN.Nat^::succ m) b);
\definition continuous: CCAnalysis.ContinuousAt ConvOpen.whole (CCRestriction.function ConvOpen.whole scalar) (CCWhole.point a) := \block {
  \takefrom m: \Cast[CCN.Nat^] ({ m: CCN.Nat^ \where \exists ( C: ConvL.Nonnegative \where CC.Bound T.eval K m C ) }) \by T.bound K (ConvBoxes.compact CS.box) \then
  \takefrom C: \Cast[ConvL.Nonnegative] ({ C: ConvL.Nonnegative \where CC.Bound T.eval K m C })
    \by \bysub(CCN.Nat^, { m: CCN.Nat^ \where \exists ( C: ConvL.Nonnegative \where CC.Bound T.eval K m C ) }, m) \then
  \takefrom b: \Cast[ConvL.Nonnegative] ({ b: ConvL.Nonnegative \where CC.JetBound rho (CCN.Nat^::succ m) b }) \by CCJets.existsBound (CCN.Nat^::succ m) rho \then
  \return Controlled[m := m, C := C, b := b, bound := \bysub(ConvL.Nonnegative, { C: ConvL.Nonnegative \where CC.Bound T.eval K m C }, C),
    jets := \bysub(ConvL.Nonnegative, { b: ConvL.Nonnegative \where CC.JetBound rho (CCN.Nat^::succ m) b }, b)].continuous
};
