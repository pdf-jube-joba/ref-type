\import calculus.Real[].MeanValue[].Interval[a := a, b := b] \as CLMean;
\definition estimate: ConvR.Lt a b -> ConvR.Le (ConvReal.distance (f b) (f a)) (ConvReal.mul c (ConvReal.distance b a)) := \fun (ordered: _) =>
  ConvR.leReplaceLeft _ _ _
    (trans!{ConvReal.Real} _ _ _
      (congr!{ConvReal.Real ConvReal.Real} (\fun (r: ConvReal.Real) => ConvReal.distance r ConvReal.zero) _ _
        (trans!{ConvReal.Real} _ _ _ (congr!{ConvReal.Real ConvReal.Real} (ConvReal.sub (ConvReal.sub (f b) (f a))) _ _ (ConvLaws.fieldMulZeroLeft (ConvReal.sub b a)))
          (ConvLaws.subZeroRight (ConvReal.sub (f b) (f a)))))
      (ConvEstimates.distanceDifference (f b) (f a)))
    (CLMean.Estimate[].increment f d ConvReal.zero c ordered
      (\fun (x: \Cast[ConvReal.Real] (metric_spaces.RealLine[].ClosedInterval a b)) => derivative x)
      (\fun (s: ConvReal.Real)(interior: CLMean.Interior s) => ConvR.leReplaceLeft _ _ _ (CLMetric.distanceSymmetric ConvReal.zero (d s)) (bound s)));
