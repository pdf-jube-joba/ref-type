\import \root.Euclidean[n := n].Pullback[U := U, V := V, e := e] \as P;
\import \root.Euclidean[n := n].On[U := U] \as Source;
\import \root.Euclidean[n := n].On[U := V] \as Target;
\import calculus.Maps[n := n, m := n] \as Maps;
\import change_of_variables.Euclidean[n := n].Jacobian[U := V, V := U, f := e.backward] \as J;
\definition diracValue[a: Open.Carrier V][phi: Source.Test]:
  (P.apply (Target.restrict (dirac a))).eval phi = Real.mul (J.absolute a) (phi (Maps.apply V U e.backward a)) :=
  P.Test[phi := phi].inside a;
\definition convergence[sequence: N.Nat^ -> Target.Distribution][T: Target.Distribution]: Target.Converges sequence T ->
  Source.Converges (\fun (k: N.Nat^) => P.apply (sequence k)) (P.apply T) :=
  \fun (converges: _)(phi: Source.Test) => converges (P.test phi);
