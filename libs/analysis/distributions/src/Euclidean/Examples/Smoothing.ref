\import \root.Euclidean[n := n].Convolution[] \as C;
\import euclidean_measure.Euclidean[n := n] \as Points;
/* A point mass produces the actual translated kernel, in every dimension. */
\definition diracValue[a, x: Point][rho: Test]: C.function (dirac a) rho x = rho (Points.subPoint x a) :=
  \refl(rho (Points.subPoint x a));
/* The two signs from distribution differentiation and reflection cancel. */
\definition diracDerivativeValue[a, x: Point][rho: Test][i: Fin.Fin n]:
  C.function (D.partial (dirac a) i) rho x = Tests.partial rho i (Points.subPoint x a) :=
  eq_reason_in!{Real.Real _
    "=" _ "by" { diracDerivative a i (C.Translate[rho := rho, a := x].test) }
    "=" _ "by" { congr!{Real.Real Real.Real} Real.neg _ _ (C.Translate[rho := rho, a := x].Partial[i := i].pointwise a) }
    "=" _ "by" { Laws.negInvolutive (Tests.partial rho i (Points.subPoint x a)) }
  };
