\import lp_spaces.Euclidean[n := n] \as ConvL;
\import ConvL.SmoothOperations[] \as ConvOperations;
\import ConvL.CompactBounds[] \as ConvBounds;
\import euclidean_measure.Euclidean[n := n] \as ConvE;
\import euclidean_measure.BoxCompact[n := n] \as ConvBoxes;
\import topological_algebra.Euclidean[].Dimension[n := n].Def[] \as ConvCoordinates;
\import topological_algebra.Euclidean[].Dimension[n := n].Norm[] \as ConvGeometry;
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as ConvAmbient;
\import topology.Topology[Carrier := ConvE.Point] \as ConvSets;
\import functional_analysis.Support[A := ConvE.Point] \as ConvSupport;
\import smooth_partitions.Euclidean[n := n] \as ConvSmooth;
\import calculus.Real[].Multivariable[n := n].Open[] \as ConvOpen;
\import ConvOpen.Smooth[].Operations[] \as ConvSmoothOperations;
\import calculus.Maps[n := n, m := n] \as ConvMaps;
\import real.Analysis[] \as ConvReal;
\import ConvReal.Algebra[] \as ConvAlgebra;
\import ConvReal.Estimates[] \as ConvEstimates;
\import ConvReal.Estimates[].Product[] \as ConvAbsolute;
\import dedekind_reals.DedekindReal[] \as ConvR;
\import ConvR.Arithmetic[].Prop[] \as ConvLaws;
\import lp_spaces.Powers[].Algebra[] \as ConvPowers;
\import std.Logic[].Proposition[] \as ConvLogic;
\import std.Logic[].Equality[] \as ConvEquality;
\use ConvEquality.congr;
\use ConvEquality.trans;
\use ConvEquality.sym;
\use ConvEquality.eq_reason_in;
\module Translate(rho: ConvL.SmoothCompact, a: ConvE.Point);
\module Secant(f, d: ConvReal.Real -> ConvReal.Real, c: ConvL.Nonnegative,
  derivative: \forall (t: ConvReal.Real) -> calculus.Real[].Derivative[].Def[].HasDerivativeAt f t (d t),
  lipschitz: \forall (s, t: ConvReal.Real) -> ConvR.Le (ConvReal.distance (d s) (d t)) (ConvReal.mul c (ConvReal.distance s t)));
\module Jets;
\module Lipschitz(f, d: ConvReal.Real -> ConvReal.Real, c: ConvL.Nonnegative,
  derivative: \forall (t: ConvReal.Real) -> calculus.Real[].Derivative[].Def[].HasDerivativeAt f t (d t),
  bound: \forall (t: ConvReal.Real) -> ConvR.Le (ConvAbsolute.abs (d t)) c);
\module KernelSecant(rho: ConvL.SmoothCompact, a, y: ConvE.Point, i: std.Data[].FinSet[].Fin n, c: ConvL.Nonnegative,
  bound: \forall (x: ConvE.Point) -> ConvR.Le (ConvAbsolute.abs (ConvOperations.partial (ConvOperations.partial rho i) i x)) c);
\module CommonSupport(rho: ConvL.SmoothCompact, a: ConvE.Point, radius: ConvL.Nonnegative,
  radiusBound: \forall (x: ConvE.Point) -> ConvSets.Member (ConvSmooth.support rho) x -> ConvR.Le (ConvGeometry.metric.distance ConvCoordinates.origin x) radius);
\module Difference(rho: ConvL.SmoothCompact, a: ConvE.Point, i: std.Data[].FinSet[].Fin n, t: ConvReal.Real);
\definition function[T: \root.Euclidean[n := n].Distribution][rho: ConvL.SmoothCompact]: ConvL.Function :=
  \fun (a: ConvE.Point) => T.eval (Translate[rho := rho, a := a].test);
\module Differentiation(T: \root.Euclidean[n := n].Distribution, rho: ConvL.SmoothCompact, a: ConvE.Point, i: std.Data[].FinSet[].Fin n);
\module Continuity(T: \root.Euclidean[n := n].Distribution, rho: ConvL.SmoothCompact, a: ConvE.Point);
\module Smoothness(T: \root.Euclidean[n := n].Distribution);
\definition smooth[T: \root.Euclidean[n := n].Distribution][rho: ConvL.SmoothCompact]: ConvSmooth.IsSmooth (function T rho) := Smoothness[T := T].smooth rho;
\module DerivativeFormula;
\module Regular(f: \root.Euclidean[n := n].Regular[].Representatives);
\module LpComparison(p: functional_analysis.Powers[].Exponent, f: lp_spaces.On[A := ConvE.Point, mu := ConvL.measure].Finite[p := p].Representatives);
