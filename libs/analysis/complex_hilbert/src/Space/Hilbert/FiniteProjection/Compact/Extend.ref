\import \parent.\parent.Extend[P := P, x := x].Nonzero[different := different] \as Nonzero;
\import Facts.Normalize[v := \parent.\parent.Extend[P := P, x := x].residual, positive := Facts.positiveNorm Geometry.positive \parent.\parent.Extend[P := P, x := x].residual (\parent.\parent.Extend[P := P, x := x].residualNonzero different)] \as Normalized;
\import \root.Space[V := V, space := space].Hilbert[norm := norm, inner := inner].RankOne[v := Normalized.value, unit := Normalized.unitNorm] \as Rank;
\import Rank.Compact[] \as RankCompact;
\definition compact: CompactMap P.map -> CompactMap Nonzero.projection.map := \block {
  \fun (previous: CompactMap P.map) \then
  \takefrom op: \Cast[End.Map] ({ g: End.Map \where Logic.And[g.apply = P.map.apply, Operators.Compact g] }) \by previous \then
  \let data: Logic.And[op.apply = P.map.apply, Operators.Compact op] := \bysub(End.Map, { g: End.Map \where Logic.And[g.apply = P.map.apply, Operators.Compact g] }, op) \then
  \let sum: End.Map := Addition.plus op (Rank.operator complete) \then
  \return Logic.existsIntro[End.Map, { g: End.Map \where Logic.And[g.apply = Nonzero.projection.map.apply, Operators.Compact g] }] sum
    (Logic.And[_, _]::# (\axiom:funext(sum.apply, Nonzero.projection.map.apply,
      \fun (y: V) => congr!{V V} (\fun (z: V) => space.add z ((Rank.operator complete).apply y)) _ _ (congr!{{V -> V} V} (\fun (f: V -> V) => f y) _ _ data.left)))
      (Addition.compact op (Rank.operator complete) data.right (RankCompact.compact complete)))
};
