\import functional_analysis.Metric[Carrier := V] \as Sequences;
\import ComplexLinear.Subspace[V := V, space := space] \as LinearSubspaces;
\import std.Data[].Nat[] \as N;
\definition Closed[S: LinearSubspaces.Subspace]: \Prop := \forall (s: N.Nat^ -> V)(x: V) ->
  (\forall (n: N.Nat^) -> LinearSubspaces.Member S (s n)) ->
  Sequences.Converges (RealNormed.metric norm.realNorm) s x -> LinearSubspaces.Member S x;
\definition ClosedSubspace: \Set := \Cast[LinearSubspaces.Subspace] ({ S: LinearSubspaces.Subspace \where Closed S });
\module In(S: ClosedSubspace);
\import Sequences.Geometry[d := RealNormed.metric norm.realNorm] \as MetricGeometry;
\import topology.Topology[Carrier := V] \as Topology;
\definition closedOfTopological: \forall (S: LinearSubspaces.Subspace) -> Topology.IsClosedIn MetricGeometry.topology S.carrier -> Closed S :=
  \fun (S: LinearSubspaces.Subspace)(closed: _)(s: N.Nat^ -> V)(x: V)(members: _)(converges: _) =>
    MetricGeometry.closedOfLimit S.carrier closed s x N.Nat^::zero (\fun (n: N.Nat^)(later: _) => members n) converges;
