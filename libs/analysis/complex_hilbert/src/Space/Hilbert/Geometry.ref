\import linear_algebra.Hermitian[].Over[K := C.Complex, field := C.Algebra[].field, scalar := linear_algebra.Hermitian[].Complex[].scalar] \as Geometry;
\import Geometry.Inner[V := V, space := space] \as Forms;
\definition form: Forms.Form := Forms.Form {
  dot := inner.inner, symmetric := inner.conjugateSymmetric, zeroRight := inner.zeroRight,
  addRight := inner.addRight, scaleRight := inner.scaleRight,
};
\definition positive: Forms.Positive[form] := Forms.Positive[form] { nonnegative := inner.nonnegative, definite := inner.definite };
\import Forms.Of[h := form] \as Facts;
\definition negativeRight: \forall (x, y: V) -> inner.inner x (space.neg y) = D.neg (inner.inner x y) := Facts.negativeRight;
\definition negativeLeft: \forall (x, y: V) -> inner.inner (space.neg x) y = D.neg (inner.inner x y) := Facts.negativeLeft;
\definition differenceRight: \forall (x, y, z: V) -> inner.inner x (RealNormed.sub y z) = D.sub (inner.inner x y) (inner.inner x z) := Facts.dotSubtractRight;
