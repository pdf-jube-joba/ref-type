\import \parent.\parent.Adjoints[inner := inner, targetInner := targetInner] \as Adjoint;
\import \parent.Approximation[targetInner := targetInner].Adjoint[sourceInner := inner] \as Approx;
\import \root.Space[V := V, space := space].Hilbert[norm := norm, inner := inner] \as SourceHilbert;
\import Target.Hilbert[norm := targetNorm, inner := targetInner] \as TargetHilbert;
\import Target.Operators[W := V, target := space, norm := targetNorm, targetNorm := norm] \as Reverse;
\import Reverse.Compact[] \as ReverseCompact;
\import ReverseCompact.FiniteRank[targetInner := inner] \as ReverseFinite;
\definition compact: \forall (sourceComplete: SourceHilbert.Complete)(targetComplete: TargetHilbert.Complete)(f: Map) ->
  Compact f -> ReverseCompact.Compact (Adjoint.adjoint sourceComplete targetComplete f) :=
  \fun (sourceComplete: SourceHilbert.Complete)(targetComplete: TargetHilbert.Complete)(f: Map)(compact: Compact f) =>
    ReverseFinite.toCompact sourceComplete (Adjoint.adjoint sourceComplete targetComplete f) (Approx.approximate sourceComplete targetComplete f compact);
