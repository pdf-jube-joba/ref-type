\import Algebraic.Coordinates[I := Fin.Fin n] \as Coordinates;
\import Algebraic.Linear[V := V, W := Coordinates.Vector, source := source, target := Coordinates.space] \as Into;
\import Algebraic.Linear[V := Coordinates.Vector, W := W, source := Coordinates.space, target := target] \as Out;
\structure Factor[f: Maps.Map]: \Set := {
  into: Into.Map,
  out: Out.Map,
  equation: \forall (x: V) -> out.apply (into.apply x) = f.apply x,
};
