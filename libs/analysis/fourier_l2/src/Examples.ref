\import \root.Euclidean[n := n] \as E;
\import lp_spaces.On[A := E.Point, mu := euclidean_measure.Euclidean[n := n].MeasureConstruction[].measure].Complex[] \as L2;
\import L2.Inner[] \as Inner;
\import E.Embedding[] \as Embedding;
\import E.Unitary[] \as Fourier;
\import E.Conjugation[] \as Conjugation;
\import fourier_schwartz.Euclidean[n := n].Complex[] \as S;
\import lp_spaces.Euclidean[n := n] \as LE;
\import complex.Complex[] \as C;
\import real.Analysis[] \as R;
\import dedekind_reals.DedekindReal[] \as Order;
\import std.Data[].Nat[] \as N;
\definition norm[x: E.Space]: L2.normValue (Fourier.forward x) = L2.normValue x := Fourier.norm x;
\definition recovery[x: E.Space]: Fourier.backward (Fourier.forward x) = x := Fourier.leftInverse x;
\definition parseval[x, y: E.Space]: Inner.value (Fourier.forward x) (Fourier.forward y) = Inner.value x y := Fourier.parseval x y;
\definition schwartz[f: S.Function]: Fourier.forward (Embedding.value f) = Embedding.value (E.Schwartz[].forward f) := Fourier.onSchwartz f;
\definition conjugate[x: E.Space]: Fourier.forward (Conjugation.value x) = Conjugation.value (Fourier.backward x) := Conjugation.fourier x;
\definition multiplier[s: E.Multiplication[].Symbol][x: E.Space]: Order.Le (L2.normValue (E.Multiplier[symbol := s].value x)) (R.mul s.coefficient (L2.normValue x)) := E.Multiplier[symbol := s].bound x;
\definition weighted[m: N.Nat^][f: S.Function]: L2.normValue (E.Integer[m := m].ofSchwartz f) = L2.normValue (Embedding.value (fourier_schwartz.Euclidean[n := n].Transform[].Preservation[].iterate f m)) := E.Integer[m := m].norm f;
\definition upper[m: N.Nat^][f: S.Function]: Order.Le (L2.normValue (E.Integer[m := m].ofSchwartz f)) (E.Expansion[].derivativeSum m f) := E.Expansion[].comparison m f;
