\import \parent.Multiplication[] \as Multiplication;
\structure Weight: \Set := {
  function: Point -> Real.Real,
  lower: \forall (x: Point) -> R.Le Real.one (function x),
  reciprocal: Multiplication.Symbol,
  reciprocalValue: \forall (x: Point) -> reciprocal.function x = D.ofReal (Laws.fieldInv (function x)),
  reciprocalBound: \forall (x: Point) -> R.Le (Absolute.abs (reciprocal.function x)) Real.one,
};
\module Integer(m: N.Nat^);
