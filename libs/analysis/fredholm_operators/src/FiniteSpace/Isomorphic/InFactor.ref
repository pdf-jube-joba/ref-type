\import Algebra.Coordinates[I := Fin.Fin n] \as Coordinates;
\import Algebra.Linear[V := V, W := Coordinates.Vector, source := space, target := Coordinates.space].Composition[U := W, domain := target] \as Into;
\import Algebra.Linear[V := V, W := W, source := space, target := target].Composition[U := Coordinates.Vector, domain := Coordinates.space] \as Out;
\definition result: OtherRank.Through[n := n].Factor Other.identity := OtherRank.Through[n := n].Factor[Other.identity] {
  into := Into.compose factor.into iso.backward,
  out := Out.compose iso.forward factor.out,
  equation := \fun (x: W) => trans!{W} _ _ _ (congr!{V W} iso.forward.apply _ _ (factor.equation (iso.backward.apply x))) (iso.rightInverse x),
};
