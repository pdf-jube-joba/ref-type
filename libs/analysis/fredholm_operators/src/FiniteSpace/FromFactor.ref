\import Algebra.Coordinates[I := Fin.Fin n] \as Coordinates;
\import Algebra.Linear[V := V, W := Coordinates.Vector, source := space, target := Coordinates.space] \as Into;
\import Into.Composition[U := Coordinates.Vector, domain := Coordinates.space] \as Compose;
\definition projection: Algebra.Linear[V := Coordinates.Vector, W := Coordinates.Vector, source := Coordinates.space, target := Coordinates.space].Map := Compose.compose factor.into factor.out;
\definition idempotent: \forall (x: Coordinates.Vector) -> projection.apply (projection.apply x) = projection.apply x :=
  \fun (x: Coordinates.Vector) => congr!{V {Coordinates.Vector}} factor.into.apply _ _ (factor.equation (factor.out.apply x));
\import bundle_complements.Complements[].Over[K := C.Complex, field := C.Algebra[].field,
  conjugation := linear_algebra.Hermitian[].Complex[].scalar, scalar := vector_bundles.Bundles[].Complex[].scalar].Idempotents[n := n].Algebra[P := projection, idempotent := idempotent] \as ImageBasis;
\module Selected(witness: ImageBasis.Witness);
\definition exists: \exists Frame := \block {
  \takefrom witness: ImageBasis.Witness \by ImageBasis.exists \then
  \return \exact(Selected[witness := witness].frame, Frame)
};
