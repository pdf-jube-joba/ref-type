\import Finite.After[U := W, codomain := codomain] \as Post;
\import complex_hilbert.FiniteRank[V := V, W := W, source := space, target := codomain] \as Output;
\import Output.Before[U := U, domain := domain] \as Pre;
\import Algebra.Linear[V := V, W := W, source := space, target := codomain].Composition[U := U, domain := domain] \as Compose;
\import complex_hilbert.FiniteRank[V := U, W := W, source := domain, target := codomain] \as Result;
\import Algebra.Linear[V := V, W := W, source := space, target := codomain] \as OutMaps;
\import OutMaps.Composition[U := V, domain := space] \as OutCompose;
\definition finite: FiniteDimensional -> Result.FiniteRank (Compose.compose out into) := \block {
  \fun (finite: FiniteDimensional) \then
  \let equal: OutCompose.compose out identity = out := OutMaps.ext (OutCompose.compose out identity) out
    (\axiom:funext((OutCompose.compose out identity).apply, out.apply, \fun (x: V) => \refl(out.apply x))) \then
  \let outFinite: Output.FiniteRank out := \idelim OutCompose.compose out identity = out \with h: OutMaps.Map => Output.FiniteRank h
    \by { base: Post.finite identity out finite, equality: equal } \then
  \return Pre.finite out into outFinite
};
