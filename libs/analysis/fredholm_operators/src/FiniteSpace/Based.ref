\import Algebra.Finite[V := V, I := Fin.Fin frame.size, space := space] \as Basis;
\import Basis.Prop[] \as BasisLaws;
\definition factor: Finite.Through[n := frame.size].Factor identity := Finite.Through[n := frame.size].Factor[identity] {
  into := frame.basis.coordinates,
  out := BasisLaws.synthesis frame.basis,
  equation := frame.basis.reconstruction,
};
\definition finite: FiniteDimensional := Logic.existsIntro[N.Nat^, { n: N.Nat^ \where \exists Finite.Through[n := n].Factor identity }] frame.size
  (\exact(factor, Finite.Through[n := frame.size].Factor identity));
