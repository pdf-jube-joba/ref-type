\import Algebra.Coordinates[I := Fin.Fin witness.rank] \as Small;
\import Algebra.Linear[V := V, W := Small.Vector, source := space, target := Small.space] \as Forward;
\import Algebra.Linear[V := Small.Vector, W := V, source := Small.space, target := space] \as Backward;
\import Algebra.Linear[V := Coordinates.Vector, W := Small.Vector, source := Coordinates.space, target := Small.space].Composition[U := V, domain := space] \as ForwardComposition;
\import Algebra.Linear[V := Coordinates.Vector, W := V, source := Coordinates.space, target := space].Composition[U := Small.Vector, domain := Small.space] \as BackwardComposition;
\definition forward: Forward.Map := ForwardComposition.compose witness.basis.coordinate factor.into;
\definition backward: Backward.Map := BackwardComposition.compose factor.out witness.basis.value;
\definition leftInverse: \forall (x: V) -> backward.apply (forward.apply x) = x :=
  \fun (x: V) => eq_reason_in!{V _
    "=" _ "by" { congr!{{Coordinates.Vector} V} factor.out.apply _ _ (witness.basis.reconstruction (factor.into.apply x)) }
    "=" _ "by" { congr!{{Coordinates.Vector} V} factor.out.apply _ _ (congr!{V {Coordinates.Vector}} factor.into.apply _ _ (factor.equation x)) }
    "=" _ "by" { factor.equation x }
  };
\definition rightInverse: \forall (x: Small.Vector) -> forward.apply (backward.apply x) = x :=
  \fun (x: Small.Vector) => trans!{{Small.Vector}} _ _ _
    (congr!{{Coordinates.Vector} {Small.Vector}} witness.basis.coordinate.apply _ _ (ImageBasis.fixed witness.rank witness.basis x)) (witness.basis.leftInverse x);
\import Algebra.Isomorphism[V := V, W := Small.Vector, source := space, target := Small.space] \as Isomorphisms;
\definition isomorphism: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse,
};
\import Algebra.CoordinateBasis[V := V, space := space, n := witness.rank].Of[iso := isomorphism] \as Basis;
\definition frame: Frame := Frame { size := witness.rank, basis := Basis.basis };
