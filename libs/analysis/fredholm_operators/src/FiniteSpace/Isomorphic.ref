\import Algebra.Isomorphism[V := V, W := W, source := space, target := target] \as Isomorphisms;
\import \root.FiniteSpace[V := W, space := target] \as Other;
\import complex_hilbert.FiniteRank[V := W, W := W, source := target, target := target] \as OtherRank;
\module InFactor(n: N.Nat^, factor: Finite.Through[n := n].Factor identity);
\definition finite: FiniteDimensional -> Other.FiniteDimensional := \block {
  \fun (finite: FiniteDimensional) \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where \exists Finite.Through[n := n].Factor identity }) \by finite \then
  \takefrom factor: Finite.Through[n := n].Factor identity \by \bysub(N.Nat^, { n: N.Nat^ \where \exists Finite.Through[n := n].Factor identity }, n) \then
  \return Logic.existsIntro[N.Nat^, { n: N.Nat^ \where \exists OtherRank.Through[n := n].Factor Other.identity }] n
    (\exact(InFactor[n := n, factor := factor].result, OtherRank.Through[n := n].Factor Other.identity))
};
