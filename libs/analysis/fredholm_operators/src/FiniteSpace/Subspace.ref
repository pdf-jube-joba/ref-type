\import Algebra.Subspace[V := V, space := space].Of[subspace := S] \as Points;
\import \root.FiniteSpace[V := Points.Carrier, space := Points.induced] \as Small;
\module Fixed(f: End.Map, fixed: \forall (x: Points.Carrier) -> f.apply x = x);
\definition finite: FiniteDimensional -> Small.FiniteDimensional :=
  \fun (finite: FiniteDimensional) => Fixed[f := identity, fixed := \fun (x: Points.Carrier) => \refl(x)].finite finite;
