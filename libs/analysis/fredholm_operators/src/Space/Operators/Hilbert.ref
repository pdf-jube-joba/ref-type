\import Source.Hilbert[norm := norm, inner := inner] \as SourceHilbert;
\import Target.Hilbert[norm := targetNorm, inner := targetInner] \as TargetHilbert;
\import \root.Space[V := W, space := target, norm := targetNorm].Operators[W := V, target := space, targetNorm := norm] \as Reverse;
\definition atkinson: \forall (f: Map)(complete: SourceHilbert.Complete)(targetComplete: TargetHilbert.Complete)(s: Reverse.Map) ->
  \parent.At[f := f].Parametrix s -> \parent.At[f := f].Hilbert[inner := inner, targetInner := targetInner].Fredholm :=
  \fun (f: Map)(complete: SourceHilbert.Complete)(targetComplete: TargetHilbert.Complete)(s: Reverse.Map)(p: \parent.At[f := f].Parametrix s) =>
    \parent.At[f := f].Hilbert[inner := inner, targetInner := targetInner].fredholmOfParametrix complete targetComplete s p;
