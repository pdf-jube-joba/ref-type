\import complex_hilbert.FiniteRank[V := V, W := W, source := space, target := target] \as Rank;
\definition equal: \forall (f, g: Linear.Map) -> (\forall (x: V) -> f.apply x = g.apply x) -> Rank.FiniteRank f -> Rank.FiniteRank g :=
  \fun (f, g: Linear.Map)(same: _)(finite: Rank.FiniteRank f) => \idelim f = g \with h: Linear.Map => Rank.FiniteRank h
    \by { base: finite, equality: Linear.ext f g (\axiom:funext(f.apply, g.apply, same)) };
\import \root.Space[V := W, space := target, norm := targetNorm].Operators[W := W, target := target, targetNorm := targetNorm] \as End;
\import End.Ideal[] \as Ideal;
\import Rank.After[U := W, codomain := target] \as After;
\import Algebra.Linear[V := W, W := W, source := target, target := target].Composition[U := V, domain := space] \as Compose;
\definition finiteNegative: \forall (f: Map) -> Rank.FiniteRank f -> Rank.FiniteRank (negative f) :=
  \fun (f: Map)(finite: Rank.FiniteRank f) => equal (Compose.compose (End.negative Ideal.identity) f) (negative f)
    (\fun (x: V) => \refl(target.neg (f.apply x))) (After.finite f (End.negative Ideal.identity) finite);
\definition finitePlus: \forall (f, g: Map) -> Rank.FiniteRank f -> Rank.FiniteRank g -> Rank.FiniteRank (plus f g) := \fun (f, g: Map) => Rank.plus f g;
\definition finiteDifference: \forall (f, g: Map) -> Rank.FiniteRank f -> Rank.FiniteRank g -> Rank.FiniteRank (difference f g) :=
  \fun (f, g: Map)(ff: Rank.FiniteRank f)(gf: Rank.FiniteRank g) => finitePlus f (negative g) ff (finiteNegative g gf);
