\import Source.Hilbert[norm := norm, inner := inner] \as Hilbert;
\import Hilbert.Subspaces[] \as ClosedSubspaces;
\definition closedKernel: ClosedSubspaces.ClosedSubspace := \into[SourceSubspaces.Subspace](kernel, ClosedSubspaces.ClosedSubspace) \by { kernelClosed };
\import \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].FixedSubspace[S := closedKernel] \as FixedKernel;
\definition Fredholm: \Prop := Logic.And[ClosedRange, Logic.And[KernelDimension.FiniteDimensional, CokernelDimension.FiniteDimensional]];

\definition parametrixFiniteKernel: \forall (complete: Hilbert.Complete)(s: Reverse.Map) -> Parametrix s -> KernelDimension.FiniteDimensional :=
  \fun (complete: Hilbert.Complete)(s: Reverse.Map)(parametrix: Parametrix s) => FixedKernel.finiteDimensional complete (leftDefect s) parametrix.left
    (\fun (x: KernelSpace) => trans!{V} _ _ _
      (congr!{V V} (SourceNormed.sub x) _ _ (trans!{V} _ _ _
        (congr!{W V} s.apply _ _ (\bysub(V, kernel.carrier, x))) s.preservesZero)) (SourceNormed.subZeroRight x));

\import \parent.Index[] \as Index;
\definition index[fredholm: Fredholm]: std.Arithmetic[].Int[].Integer := Index.value fredholm.right.left fredholm.right.right;
\definition indexFromDecomposition: \forall (fredholm: Fredholm)(d: Index.Decomposition) -> index fredholm = Index.fromDecomposition d :=
  \fun (fredholm: Fredholm) => Index.calculate fredholm.right.left fredholm.right.right;

\import Target.Hilbert[norm := targetNorm, inner := targetInner] \as TargetHilbert;
\module FromFredholm(complete: Hilbert.Complete, targetComplete: TargetHilbert.Complete, fredholm: Fredholm);

\definition parametrixExists: \forall (complete: Hilbert.Complete)(targetComplete: TargetHilbert.Complete) -> Fredholm -> HasParametrix :=
  \fun (complete: Hilbert.Complete)(targetComplete: TargetHilbert.Complete)(fredholm: Fredholm) =>
    Logic.existsIntro[Reverse.Map, { s: Reverse.Map \where Parametrix s }] (FromFredholm[complete := complete, targetComplete := targetComplete, fredholm := fredholm].parametrix)
      (FromFredholm[complete := complete, targetComplete := targetComplete, fredholm := fredholm].parametrixLaw);

\module FiniteRight(s: Reverse.Map, finite: complex_hilbert.FiniteRank[V := W, W := W, source := target, target := target].FiniteRank (rightDefect s));

\module FromParametrix(s: Reverse.Map);

\module Cokernel(s: Reverse.Map, closed: ClosedRange);
\definition fredholmOfParametrix: \forall (complete: Hilbert.Complete)(targetComplete: TargetHilbert.Complete)(s: Reverse.Map) -> Parametrix s -> Fredholm :=
  \fun (complete: Hilbert.Complete)(targetComplete: TargetHilbert.Complete)(s: Reverse.Map)(p: Parametrix s)  => Logic.And[ClosedRange, Logic.And[KernelDimension.FiniteDimensional, CokernelDimension.FiniteDimensional]]::# (FromParametrix[s := s].closedRange targetComplete p.right)
    (Logic.And[KernelDimension.FiniteDimensional, CokernelDimension.FiniteDimensional]::# (parametrixFiniteKernel complete s p)
      (Cokernel[s := s, closed := FromParametrix[s := s].closedRange targetComplete p.right].finite targetComplete p.right));
\definition atkinson: \forall (complete: Hilbert.Complete)(targetComplete: TargetHilbert.Complete) -> HasParametrix -> Fredholm := \block {
  \fun (complete: Hilbert.Complete)(targetComplete: TargetHilbert.Complete)(exists: HasParametrix) \then
  \takefrom s: \Cast[Reverse.Map] ({ s: Reverse.Map \where Parametrix s }) \by exists \then
  \return fredholmOfParametrix complete targetComplete s (\bysub(Reverse.Map, { s: Reverse.Map \where Parametrix s }, s))
};


\definition atkinsonEquivalence: \forall (complete: Hilbert.Complete)(targetComplete: TargetHilbert.Complete) -> Logic.And[HasParametrix -> Fredholm, Fredholm -> HasParametrix] :=
  \fun (complete: Hilbert.Complete)(targetComplete: TargetHilbert.Complete) => Logic.And[_, _]::#
    (atkinson complete targetComplete) (parametrixExists complete targetComplete);

\import complex_hilbert.FiniteRank[V := V, W := V, source := space, target := space] \as SourceRank;
\import complex_hilbert.FiniteRank[V := W, W := W, source := target, target := target] \as TargetRank;
\import \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].Trace[] \as SourceTrace;
\import \root.Space[V := W, space := target, norm := targetNorm].Hilbert[inner := targetInner].Trace[] \as TargetTrace;
\definition FiniteParametrix[s: Reverse.Map]: \Prop := Logic.And[SourceRank.FiniteRank (leftDefect s), TargetRank.FiniteRank (rightDefect s)];
\definition defectIndex[s: Reverse.Map][finite: FiniteParametrix s]: C.Complex :=
  C.Def[].sub (SourceTrace.trace (leftDefect s) finite.left) (TargetTrace.trace (rightDefect s) finite.right);
\definition canonicalFinite: \forall (complete: Hilbert.Complete)(targetComplete: TargetHilbert.Complete)(fredholm: Fredholm) ->
  FiniteParametrix FromFredholm[complete := complete, targetComplete := targetComplete, fredholm := fredholm].parametrix :=
  \fun (complete: Hilbert.Complete)(targetComplete: TargetHilbert.Complete)(fredholm: Fredholm) => Logic.And[_, _] {
    left := FromFredholm[complete := complete, targetComplete := targetComplete, fredholm := fredholm].leftFinite,
    right := FromFredholm[complete := complete, targetComplete := targetComplete, fredholm := fredholm].rightFinite,
  };
\module Compare(s, t: Reverse.Map);

\module Defect(s: Reverse.Map);

\module Change(g: Map);

\import Target.Operators[W := V, target := space, norm := targetNorm, targetNorm := norm] \as ReverseBounded;
\import Bounded.Compact[].Limit[] \as Limits;
\module Neighborhood(s: Reverse.Map, c: R.Real, bound: ReverseBounded.Bound[s, c]);
\definition IndexNeighborhood[original: Fredholm, radius: R.Real]: \Prop := Logic.And[Order.Lt R.zero radius,
  \forall (g: Map) -> Limits.Near[f, g, radius] -> Change[g := g].PreservesIndex original];
\definition indexLocallyConstant: \forall (complete: Hilbert.Complete)(targetComplete: TargetHilbert.Complete)(original: Fredholm) -> \exists ( radius: R.Real \where IndexNeighborhood[original, radius] ) := \block {
  \fun (complete: Hilbert.Complete)(targetComplete: TargetHilbert.Complete)(original: Fredholm) \then
  \let s: Reverse.Map := FromFredholm[complete := complete, targetComplete := targetComplete, fredholm := original].parametrix \then
  \takefrom c: \Cast[R.Real] ({ c: R.Real \where ReverseBounded.Bound[s, c] }) \by ReverseBounded.bounded s \then
  \let bound: ReverseBounded.Bound[s, c] := \bysub(R.Real, { c: R.Real \where ReverseBounded.Bound[s, c] }, c) \then
  \return Logic.existsIntro[R.Real, { radius: R.Real \where IndexNeighborhood[original, radius] }] (Neighborhood[s := s, c := c, bound := bound].radius)
    (Logic.And[_, _]::# (Neighborhood[s := s, c := c, bound := bound].positive)
      (\fun (g: Map) => Neighborhood[s := s, c := c, bound := bound].At[g := g].preservesIndex complete targetComplete original (canonicalFinite complete targetComplete original)))
};

\module CompactPerturbation(g: Map);

\module DirectSum(U, Z: \Set, domain: Algebra.VectorSpace U, codomain: Algebra.VectorSpace Z,
  domainNorm: complex_hilbert.Space[V := U, space := domain].Norm, codomainNorm: complex_hilbert.Space[V := Z, space := codomain].Norm,
  domainInner: linear_algebra.Complex[].InnerProduct[V := U, space := domain].InnerProduct, codomainInner: linear_algebra.Complex[].InnerProduct[V := Z, space := codomain].InnerProduct,
  g: complex_hilbert.Space[V := U, space := domain].Operators[W := Z, target := codomain, norm := domainNorm, targetNorm := codomainNorm].Map);
