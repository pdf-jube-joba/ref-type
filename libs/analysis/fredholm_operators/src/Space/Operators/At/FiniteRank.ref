\import complex_hilbert.FiniteRank[V := V, W := W, source := space, target := target] \as Finite;
\import Target.Hilbert[norm := targetNorm, inner := targetInner] \as Hilbert;
\import \root.FiniteSpace[V := W, space := target] \as TargetDimension;
\import \root.FiniteSpace[V := ImageSpace, space := Image.induced] \as ImageDimension;
\import \root.Space[V := W, space := target, norm := targetNorm].Hilbert[inner := targetInner].FiniteSubspace[S := image] \as ImageClosed;
\module With(complete: Hilbert.Complete, n: N.Nat^, factor: Finite.Through[n := n].Factor f);
\definition finiteImage: \forall (complete: Hilbert.Complete) -> Finite.FiniteRank f -> ImageDimension.FiniteDimensional := \block {
  \fun (complete: Hilbert.Complete)(finite: Finite.FiniteRank f) \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where \exists Finite.Through[n := n].Factor f }) \by finite \then
  \takefrom factor: Finite.Through[n := n].Factor f \by \bysub(N.Nat^, { n: N.Nat^ \where \exists Finite.Through[n := n].Factor f }, n) \then
  \return With[complete := complete, n := n, factor := factor].finiteImage
};
\definition closedRange: \forall (complete: Hilbert.Complete) -> Finite.FiniteRank f -> ClosedRange :=
  \fun (complete: Hilbert.Complete)(finite: Finite.FiniteRank f) => ImageClosed.closed complete (finiteImage complete finite);
