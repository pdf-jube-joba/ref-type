\import \parent.\parent.At[f := g] \as Other;
\import \parent.\parent.Ideal[] \as Ideal;
\definition parametrix: \forall (s: Reverse.Map) -> Parametrix s -> Ideal.Equivalent[f, g] -> Other.Parametrix s :=
  \fun (s: Reverse.Map)(p: Parametrix s)(equivalent: Ideal.Equivalent[f, g]) => Logic.And[_, _] {
    left :=  SourceIdeal.transitive SourceIdeal.identity (ComposeBack.compose f s) (ComposeBack.compose g s)
      p.left (ComposeBack.equivalentAfter f g s equivalent),
    right := TargetIdeal.transitive TargetIdeal.identity (ComposeForward.compose s f) (ComposeForward.compose s g)
      p.right (ComposeForward.equivalentBefore s f g equivalent),
  };
\definition existsParametrix: HasParametrix -> Ideal.Equivalent[f, g] -> Other.HasParametrix := \block {
  \fun (exists: HasParametrix)(equivalent: Ideal.Equivalent[f, g]) \then
  \takefrom s: \Cast[Reverse.Map] ({ s: Reverse.Map \where Parametrix s }) \by exists \then
  \return Logic.existsIntro[Reverse.Map, { s: Reverse.Map \where Other.Parametrix s }] s
    (parametrix s (\bysub(Reverse.Map, { s: Reverse.Map \where Parametrix s }, s)) equivalent)
};
