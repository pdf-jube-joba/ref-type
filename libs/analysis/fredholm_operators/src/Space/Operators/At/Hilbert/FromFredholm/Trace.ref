\import \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].Trace[] \as SourceTrace;
\import \root.Space[V := W, space := target, norm := targetNorm].Hilbert[inner := targetInner].Trace[] \as TargetTrace;
\import SourceTrace.Through[W := KernelSpace, target := Kernel.induced, frame := d.kernelFrame, into := KernelProjection.linear, out := Kernel.inclusion] \as KernelTrace;
\import TargetTrace.Through[W := CokernelSpace, target := Quotient.vectorSpace, frame := d.cokernelFrame, into := Quotient.projection, out := cokernelOut] \as CokernelTrace;
\import linear_algebra.Complex[].Dimension[] \as Counts;
\definition left: SourceTrace.trace (leftDefect parametrix) leftFinite = Counts.naturalScalar (KernelDimension.dimension d.kernelFrame) :=
  trans!{C.Complex} _ _ _
    (SourceTrace.equal (leftDefect parametrix) KernelTrace.map leftFinite KernelTrace.finite leftEquation)
    (KernelTrace.traceProjection (\fun (x: KernelSpace) => KernelProjection.fixes x));
\definition right: TargetTrace.trace (rightDefect parametrix) rightFinite = Counts.naturalScalar (CokernelDimension.dimension d.cokernelFrame) :=
  trans!{C.Complex} _ _ _
    (TargetTrace.equal (rightDefect parametrix) CokernelTrace.map rightFinite CokernelTrace.finite (\fun (y: W) => sym!{W} _ _ (rightEquation y)))
    (CokernelTrace.traceProjection (\fun (q: CokernelSpace) => TargetComplement.leftInverse q));
\definition difference: C.Def[].sub (SourceTrace.trace (leftDefect parametrix) leftFinite) (TargetTrace.trace (rightDefect parametrix) rightFinite) =
  C.Def[].sub (Counts.naturalScalar (KernelDimension.dimension d.kernelFrame)) (Counts.naturalScalar (CokernelDimension.dimension d.cokernelFrame)) :=
  congr!{C.Complex C.Complex C.Complex} C.Def[].sub _ _ _ _ left right;
