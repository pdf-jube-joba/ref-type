\import R.Estimates[] \as Estimates;
\import R.Estimates[].Product[] \as Product;
\import dedekind_reals.DedekindReal[].Order[] \as Ordered;
\definition coefficient: R.Real := R.add c R.one;
\definition coefficientPositive: Order.Lt R.zero coefficient := Order.ltLeTrans R.zero R.one coefficient Product.onePositive
  (Order.leReplaceLeft (R.add R.zero R.one) R.one coefficient (Laws.addZeroLeft R.one) (Laws.addMonotoneRight R.zero c R.one bound.nonnegative));
\definition coefficientAbove: Order.Le c coefficient := Order.leReplaceLeft (R.add c R.zero) c coefficient (Laws.addZeroRight c)
  (Laws.addMonotoneLeft R.zero R.one c Laws.oneNonnegative);
\definition halfPositive: Order.Lt R.zero R.half := Order.ltReplaceRight R.zero (R.mul R.half R.one) R.half (R.Algebra[].mulOneRight R.half)
  (Estimates.halfOfPositive R.one Product.onePositive);
\definition radius: R.Real := Product.radius coefficient R.half;
\definition positive: Order.Lt R.zero radius := Product.radiusPositive coefficient R.half coefficientPositive halfPositive;
\definition smallCoefficient: Order.Le (R.mul c radius) R.half := Order.leTrans _ _ _
  (Order.leReplace _ _ _ _ (Laws.fieldMulComm radius c) (Laws.fieldMulComm radius coefficient)
    (Estimates.mulMonotone radius c coefficient (Ordered.leOfLt _ _ positive) coefficientAbove))
  (Ordered.leOfLt _ _ (Product.radiusSmall coefficient R.half coefficientPositive halfPositive));
\module At(g: Map);
