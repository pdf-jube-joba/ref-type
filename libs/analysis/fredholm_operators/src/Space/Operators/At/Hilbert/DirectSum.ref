\import \root.Sum[V := V, W := U, source := space, target := domain, norm := norm, targetNorm := domainNorm, inner := inner, targetInner := domainInner] \as SourceSum;
\import \root.Sum[V := W, W := Z, source := target, target := codomain, norm := targetNorm, targetNorm := codomainNorm, inner := targetInner, targetInner := codomainInner] \as TargetSum;
\import \root.Space[V := U, space := domain, norm := domainNorm].Operators[W := Z, target := codomain, targetNorm := codomainNorm] \as Next;
\import Next.At[f := g] \as OtherOperator;
\import OtherOperator.Hilbert[inner := domainInner, targetInner := codomainInner] \as Other;
\import complex_hilbert.Space[V := U, space := domain].Hilbert[norm := domainNorm, inner := domainInner] \as DomainHilbert;
\import complex_hilbert.Space[V := Z, space := codomain].Hilbert[norm := codomainNorm, inner := codomainInner] \as CodomainHilbert;
\module At(complete: Hilbert.Complete, targetComplete: TargetHilbert.Complete, domainComplete: DomainHilbert.Complete, codomainComplete: CodomainHilbert.Complete);
