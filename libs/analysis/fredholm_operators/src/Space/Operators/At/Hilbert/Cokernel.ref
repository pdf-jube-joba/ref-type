\import TargetHilbert.Subspaces[] \as ClosedSubspaces;
\definition closedImage: ClosedSubspaces.ClosedSubspace := \into[TargetSubspaces.Subspace](image, ClosedSubspaces.ClosedSubspace) \by { closed };
\module At(complete: TargetHilbert.Complete);
\definition finite: \forall (complete: TargetHilbert.Complete) -> TargetEnd.Compact (rightDefect s) -> CokernelDimension.FiniteDimensional :=
  \fun (complete: TargetHilbert.Complete) => At[complete := complete].finite;
