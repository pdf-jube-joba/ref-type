\import SourceSum.At[complete := complete, targetComplete := domainComplete] \as SourceProduct;
\import TargetSum.At[complete := targetComplete, targetComplete := codomainComplete] \as TargetProduct;
\import SourceSum.MapsTo[U := W, Z := Z, domain := target, codomain := codomain, domainNorm := targetNorm, codomainNorm := codomainNorm,
  domainInner := targetInner, codomainInner := codomainInner, f := f, g := g].At[complete := complete, targetComplete := domainComplete, domainComplete := targetComplete, codomainComplete := codomainComplete] \as Diagonal;
\import \root.Space[V := SourceSum.Carrier, space := SourceSum.productSpace, norm := SourceSum.productNorm].Operators[W := TargetSum.Carrier, target := TargetSum.productSpace, targetNorm := TargetSum.productNorm] \as Operators;
\definition map: Operators.Map := Diagonal.map;
\import Operators.At[f := map] \as SumOperator;
\import SumOperator.Hilbert[inner := SourceSum.productInner, targetInner := TargetSum.productInner] \as Sum;
\import \root.Space[V := Z, space := codomain, norm := codomainNorm].Operators[W := U, target := domain, targetNorm := domainNorm] \as NextReverse;
\module InParametrices(s: Reverse.Map, t: NextReverse.Map);
\definition fredholm: Fredholm -> Other.Fredholm -> Sum.Fredholm :=
  \fun (first: Fredholm)(second: Other.Fredholm) =>
    InParametrices[s := \parent.\parent.FromFredholm[complete := complete, targetComplete := targetComplete, fredholm := first].parametrix,
      t := Other.FromFredholm[complete := domainComplete, targetComplete := codomainComplete, fredholm := second].parametrix].fredholm
      (canonicalFinite complete targetComplete first) (Other.canonicalFinite domainComplete codomainComplete second);
\import std.Arithmetic[].Int[] \as Integers;
\definition indexDirectSum: \forall (first: Fredholm)(second: Other.Fredholm) -> Sum.index (fredholm first second) = Integers.addInteger (index first) (Other.index second) :=
  \fun (first: Fredholm)(second: Other.Fredholm) =>
    InParametrices[s := \parent.\parent.FromFredholm[complete := complete, targetComplete := targetComplete, fredholm := first].parametrix,
      t := Other.FromFredholm[complete := domainComplete, targetComplete := codomainComplete, fredholm := second].parametrix].indexAdd
      (canonicalFinite complete targetComplete first) (Other.canonicalFinite domainComplete codomainComplete second) first second (fredholm first second);
