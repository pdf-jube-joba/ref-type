\import Generators.Chosen[P := P, covers := covers] \as Fixed;
\definition fixesImage: \forall (y: ImageSpace) -> P.map.apply y = y := \block {
  \fun (y: ImageSpace) \then
  \takefrom x: \Cast[V] ({ x: V \where f.apply x = y }) \by \bysub(W, image.carrier, y) \then
  \let fixed: P.map.apply (f.apply x) = f.apply x := eq_reason_in!{W _
    "=" _ "by" { congr!{W W} P.map.apply _ _ (sym!{W} _ _ (factor.equation x)) }
    "=" _ "by" { Fixed.fixed (factor.into.apply x) }
    "=" _ "by" { factor.equation x }
  } \then
  \return \idelim f.apply x = y \with z: W => P.map.apply z = z
    \by { base: fixed, equality: \bysub(V, { x: V \where f.apply x = y }, x) }
};
\import TargetDimension.Subspace[S := image].Fixed[f := P.map, fixed := fixesImage] \as Small;
\definition finiteImage: ImageDimension.FiniteDimensional := Small.finite P.finite;
