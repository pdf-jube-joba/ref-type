\import CompactOperators.FiniteRank[targetInner := targetInner].At[n := n, f := f, factor := factor, complete := complete] \as Generators;
\import Hilbert.FiniteProjection[] \as Projections;
\module Selected(P: Projections.Projection, covers: Projections.Covers[P, Generators.generators]);
\definition finiteImage: ImageDimension.FiniteDimensional := \block {
  \takefrom P: \Cast[Projections.Projection] ({ P: Projections.Projection \where Projections.Covers[P, Generators.generators] }) \by Projections.coversFinite Generators.generators \then
  \return Selected[P := P, covers := \bysub(Projections.Projection, { P: Projections.Projection \where Projections.Covers[P, Generators.generators] }, P)].finiteImage
};
