\import \root.Space[V := V, space := space, norm := norm].Operators[W := V, target := space, targetNorm := norm] \as End;
\import Source.Operators[W := V, target := space, norm := norm, targetNorm := norm] \as Bounded;
\import End.Ideal[] \as Ideal;
\definition map: End.Map := End.difference Ideal.identity e;
\import Algebra.Isomorphism[V := V, W := V, source := space, target := space].OfBijective[f := map] \as Inverse;
\definition Small: \Prop := Bounded.Bound[e, R.half];
\module At(complete: SourceNormed.IsBanach norm.realNorm, small: Small);
\definition inverse[complete: SourceNormed.IsBanach norm.realNorm][small: Small]: End.Map := At[complete := complete, small := small].inverse;
\definition leftInverse: \forall (complete: SourceNormed.IsBanach norm.realNorm)(small: Small)(x: V) -> (inverse complete small).apply (map.apply x) = x :=
  \fun (complete: SourceNormed.IsBanach norm.realNorm)(small: Small) => At[complete := complete, small := small].leftInverse;
\definition rightInverse: \forall (complete: SourceNormed.IsBanach norm.realNorm)(small: Small)(x: V) -> map.apply ((inverse complete small).apply x) = x :=
  \fun (complete: SourceNormed.IsBanach norm.realNorm)(small: Small) => At[complete := complete, small := small].rightInverse;
\definition resolvent: \forall (complete: SourceNormed.IsBanach norm.realNorm)(small: Small)(x: V) ->
  (inverse complete small).apply x = space.add x (e.apply ((inverse complete small).apply x)) :=
  \fun (complete: SourceNormed.IsBanach norm.realNorm)(small: Small) => At[complete := complete, small := small].resolvent;
