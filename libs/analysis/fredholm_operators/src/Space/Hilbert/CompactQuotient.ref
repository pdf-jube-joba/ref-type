\import Algebra.Quotient[V := V, space := space].Of[S := S] \as Quotient;
\import \root.FiniteSpace[V := Quotient.Carrier, space := Quotient.vectorSpace] \as Dimension;
\import \root.Space[V := V, space := space, norm := norm].Operators[W := V, target := space, targetNorm := norm] \as End;
\definition ClassIdentity: \Prop := \forall (x: V) -> Quotient.class (k.apply x) = Quotient.class x;
\module At(complete: Hilbert.Complete);
\definition finite: \forall (complete: Hilbert.Complete) -> End.Compact k -> ClassIdentity -> Dimension.FiniteDimensional :=
  \fun (complete: Hilbert.Complete) => At[complete := complete].finite;
