\module InFactor(n: N.Nat^, factor: Finite.Through[n := n].Factor f);
\definition finite: Finite.FiniteRank f -> Finite.FiniteRank (Operations.scale a f) := \block {
  \fun (finite: Finite.FiniteRank f) \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where \exists Finite.Through[n := n].Factor f }) \by finite \then
  \takefrom factor: Finite.Through[n := n].Factor f \by \bysub(N.Nat^, { n: N.Nat^ \where \exists Finite.Through[n := n].Factor f }, n) \then
  \return Logic.existsIntro[N.Nat^, { n: N.Nat^ \where \exists Finite.Through[n := n].Factor (Operations.scale a f) }] n
    (\exact(InFactor[n := n, factor := factor].scaled, Finite.Through[n := n].Factor (Operations.scale a f)))
};
\definition scalar: \forall (ff: Finite.FiniteRank f) -> trace (Operations.scale a f) (finite ff) = C.Def[].mul a (trace f ff) := \block {
  \fun (ff: Finite.FiniteRank f) \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where \exists Finite.Through[n := n].Factor f }) \by ff \then
  \takefrom factor: Finite.Through[n := n].Factor f \by \bysub(N.Nat^, { n: N.Nat^ \where \exists Finite.Through[n := n].Factor f }, n) \then
  \return InFactor[n := n, factor := factor].scalar ff (finite ff)
};
