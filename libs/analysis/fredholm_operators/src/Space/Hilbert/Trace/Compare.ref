\import \parent.Factor[n := n, f := f, factor := first] \as First;
\import \parent.Factor[n := m, f := f, factor := second] \as Second;
\module In(P: Projection.Projection, firstCovers: Projection.Covers[P, First.generators], secondCovers: Projection.Covers[P, Second.generators]);
\definition equal: First.trace = Second.trace := \block {
  \let generators: Points.FiniteSubset := Points.union First.generators Second.generators \then
  \takefrom P: \Cast[Projection.Projection] ({ P: Projection.Projection \where Projection.Covers[P, generators] }) \by Projection.coversFinite generators \then
  \let covers: Projection.Covers[P, generators] := \bysub(Projection.Projection, { P: Projection.Projection \where Projection.Covers[P, generators] }, P) \then
  \let firstCovers: Projection.Covers[P, First.generators] := \fun (x: V)(member: Points.Member First.generators x) => covers x (Logic.Or[_, _]::left member) \then
  \let secondCovers: Projection.Covers[P, Second.generators] := \fun (x: V)(member: Points.Member Second.generators x) => covers x (Logic.Or[_, _]::right member) \then
  \return In[P := P, firstCovers := firstCovers, secondCovers := secondCovers].equal
};
