\import complex_hilbert.FiniteRank[V := V, W := W, source := space, target := target] \as Rank;
\import Rank.After[U := V, codomain := space] \as After;
\import Rank.Before[U := W, domain := target] \as Before;
\import Algebra.Linear[V := W, W := V, source := target, target := space].Composition[U := V, domain := space] \as SourceCompose;
\import Algebra.Linear[V := V, W := W, source := space, target := target].Composition[U := W, domain := target] \as TargetCompose;
\import \root.Space[V := W, space := target, norm := targetNorm].Hilbert[inner := targetInner].Trace[] \as TargetTrace;
\module InFactor(n: N.Nat^, factor: Rank.Through[n := n].Factor f);
\definition cyclic: \forall (finite: Rank.FiniteRank f) -> trace (SourceCompose.compose g f) (After.finite f g finite) =
  TargetTrace.trace (TargetCompose.compose f g) (Before.finite f g finite) := \block {
  \fun (finite: Rank.FiniteRank f) \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where \exists Rank.Through[n := n].Factor f }) \by finite \then
  \takefrom factor: Rank.Through[n := n].Factor f \by \bysub(N.Nat^, { n: N.Nat^ \where \exists Rank.Through[n := n].Factor f }, n) \then
  \return InFactor[n := n, factor := factor].cyclic finite
};
