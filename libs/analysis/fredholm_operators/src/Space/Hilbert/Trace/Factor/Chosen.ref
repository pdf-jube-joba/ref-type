\import End.Composition[U := Coordinates.Vector, domain := Coordinates.space] \as Composition;
\definition combined: Algebra.Linear[V := Coordinates.Vector, W := V, source := Coordinates.space, target := space].Map := Composition.compose P.map factor.out;
\definition agrees: \forall (i: Fin.Fin n) -> combined.apply (Canonical.vectors i) = factor.out.apply (Canonical.vectors i) :=
  \fun (i: Fin.Fin n) => covers (generator i) (generatorMember i);
\definition sameSum: \forall (xs: std.Data[].List[].List[Fin.Fin n])(a: Coordinates.Vector) ->
  combined.apply (CoordinateBasis.vectorSum xs (\fun (i: Fin.Fin n) => Coordinates.space.smul (a i) (Canonical.vectors i))) =
    factor.out.apply (CoordinateBasis.vectorSum xs (\fun (i: Fin.Fin n) => Coordinates.space.smul (a i) (Canonical.vectors i))) :=
  \induction (xs: std.Data[].List[].List[Fin.Fin n]) \return \forall (a: Coordinates.Vector) ->
    combined.apply (CoordinateBasis.vectorSum xs (\fun (i: Fin.Fin n) => Coordinates.space.smul (a i) (Canonical.vectors i))) =
      factor.out.apply (CoordinateBasis.vectorSum xs (\fun (i: Fin.Fin n) => Coordinates.space.smul (a i) (Canonical.vectors i))) \with {
    | nil: \fun (a: Coordinates.Vector) => trans!{V} _ _ _ combined.preservesZero (sym!{V} _ _ factor.out.preservesZero)
    | cons: \fun (i: Fin.Fin n)(tail: std.Data[].List[].List[Fin.Fin n])(ih: _)(a: Coordinates.Vector) => eq_reason_in!{V _
      "=" _ "by" { combined.preservesAdd _ _ }
      "=" _ "by" { congr!{V V V} space.add _ _ _ _
        (trans!{V} _ _ _ (combined.preservesScale (a i) (Canonical.vectors i))
          (trans!{V} _ _ _ (congr!{V V} (space.smul (a i)) _ _ (agrees i)) (sym!{V} _ _ (factor.out.preservesScale (a i) (Canonical.vectors i))))) (ih a) }
      "=" _ "by" { sym!{V} _ _ (factor.out.preservesAdd _ _) }
    }
  };
\definition fixed: \forall (a: Coordinates.Vector) -> P.map.apply (factor.out.apply a) = factor.out.apply a :=
  \fun (a: Coordinates.Vector) => eq_reason_in!{V _
    "=" _ "by" { congr!{Coordinates.Vector V} combined.apply _ _ (sym!{Coordinates.Vector} _ _ (Canonical.reconstruction a)) }
    "=" _ "by" { sameSum (Fin.elements n) a }
    "=" _ "by" { congr!{Coordinates.Vector V} factor.out.apply _ _ (Canonical.reconstruction a) }
  };
