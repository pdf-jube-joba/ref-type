\import Algebra.Coordinates[I := Fin.Fin n] \as Coordinates;
\import Algebra.FiniteCoordinates[n := n] \as Canonical;
\import Algebra.Finite[V := Coordinates.Vector, I := Fin.Fin n, space := Coordinates.space] \as CoordinateBasis;
\import Algebra.Linear[V := V, W := Coordinates.Vector, source := space, target := Coordinates.space].Composition[U := Coordinates.Vector, domain := Coordinates.space] \as Compose;
\definition trace: C.Complex := CoordinateBasis.trace Canonical.basis (Compose.compose factor.into factor.out);
\import std.Data[].FinSet[].Scope[n := n] \as Scope;
\import std.Set[].FiniteSubset[A := Fin.Fin n].Image[B := V] \as Images;
\definition generator[i: Fin.Fin n]: V := factor.out.apply (Canonical.vectors i);
\definition generators: Points.FiniteSubset := Images.value generator Scope.finite;
\definition generatorMember: \forall (i: Fin.Fin n) -> Points.Member generators (generator i) := \fun (i: Fin.Fin n) => Images.member generator Scope.finite i (\refl(i));
\module Chosen(P: Projection.Projection, covers: Projection.Covers[P, generators]);
