\definition cyclic: \forall (finite: Rank.FiniteRank f) -> trace (SourceCompose.compose g f) (After.finite f g finite) =
  TargetTrace.trace (TargetCompose.compose f g) (Before.finite f g finite) := \fun (finite: Rank.FiniteRank f) => trans!{C.Complex} _ _ _
    (calculate (SourceCompose.compose g f) (After.finite f g finite) n (After.Through[n := n].compose f factor g))
    (sym!{C.Complex} _ _ (TargetTrace.calculate (TargetCompose.compose f g) (Before.finite f g finite) n (Before.Through[n := n].compose f factor g)));
