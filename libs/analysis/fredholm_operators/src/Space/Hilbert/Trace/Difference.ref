\import Algebra.Laws[V := C.Complex, space := Algebra.scalarSpace] \as ComplexLaws;
\import \parent.Scale[a := C.Def[].neg C.Def[].one, f := g] \as Negative;
\definition map: End.Map := Operations.plus f (Operations.negative g);
\definition finite: Finite.FiniteRank f -> Finite.FiniteRank g -> Finite.FiniteRank map :=
  \fun (ff: Finite.FiniteRank f)(gf: Finite.FiniteRank g) => Finite.plus f (Operations.negative g) ff (Negative.finite gf);
\definition subtractive: \forall (ff: Finite.FiniteRank f)(gf: Finite.FiniteRank g) -> trace map (finite ff gf) = C.Def[].sub (trace f ff) (trace g gf) :=
  \fun (ff: Finite.FiniteRank f)(gf: Finite.FiniteRank g) => eq_reason_in!{C.Complex _
    "=" _ "by" { \parent.Addition[f := f, g := Operations.negative g].additive ff (Negative.finite gf) }
    "=" _ "by" { congr!{C.Complex C.Complex} (C.Def[].add (trace f ff)) _ _ (Negative.scalar gf) }
    "=" _ "by" { congr!{C.Complex C.Complex} (C.Def[].add (trace f ff)) _ _ (ComplexLaws.minusOneScale (trace g gf)) }
  };
