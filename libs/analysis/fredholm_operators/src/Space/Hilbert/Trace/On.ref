\definition unique: \forall (a, b: Value f) -> a = b := \block {
  \fun (a, b: Value f) \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where \exists ( factor: Finite.Through[n := n].Factor f \where \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].Trace[].Factor[n := n, f := f, factor := factor].trace = a ) }) \by \bysub(C.Complex, { a: C.Complex \where Represents f a }, a) \then
  \takefrom m: \Cast[N.Nat^] ({ m: N.Nat^ \where \exists ( factor: Finite.Through[n := m].Factor f \where \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].Trace[].Factor[n := m, f := f, factor := factor].trace = b ) }) \by \bysub(C.Complex, { b: C.Complex \where Represents f b }, b) \then
  \takefrom first: \Cast[Finite.Through[n := n].Factor f] ({ factor: Finite.Through[n := n].Factor f \where \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].Trace[].Factor[n := n, f := f, factor := factor].trace = a })
    \by \bysub(N.Nat^, { n: N.Nat^ \where \exists ( factor: Finite.Through[n := n].Factor f \where \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].Trace[].Factor[n := n, f := f, factor := factor].trace = a ) }, n) \then
  \takefrom second: \Cast[Finite.Through[n := m].Factor f] ({ factor: Finite.Through[n := m].Factor f \where \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].Trace[].Factor[n := m, f := f, factor := factor].trace = b })
    \by \bysub(N.Nat^, { m: N.Nat^ \where \exists ( factor: Finite.Through[n := m].Factor f \where \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].Trace[].Factor[n := m, f := f, factor := factor].trace = b ) }, m) \then
  \return trans!{C.Complex} _ _ _ (sym!{C.Complex} _ _ (\bysub(Finite.Through[n := n].Factor f, { factor: Finite.Through[n := n].Factor f \where \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].Trace[].Factor[n := n, f := f, factor := factor].trace = a }, first)))
    (trans!{C.Complex} _ _ _ (\parent.Compare[n := n, m := m, f := f, first := first, second := second].equal)
      (\bysub(Finite.Through[n := m].Factor f, { factor: Finite.Through[n := m].Factor f \where \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].Trace[].Factor[n := m, f := f, factor := factor].trace = b }, second)))
};

\module AtFactor(n: N.Nat^, factor: Finite.Through[n := n].Factor f);
\definition exists: Finite.FiniteRank f -> \exists Value f := \block {
  \fun (finite: Finite.FiniteRank f) \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where \exists Finite.Through[n := n].Factor f }) \by finite \then
  \takefrom factor: Finite.Through[n := n].Factor f \by \bysub(N.Nat^, { n: N.Nat^ \where \exists Finite.Through[n := n].Factor f }, n) \then
  \return \exact(AtFactor[n := n, factor := factor].value, Value f)
};
\definition value[finite: Finite.FiniteRank f]: Value f := \choice Value f \by { existence: exists finite, uniqueness: unique };
\definition calculate: \forall (finite: Finite.FiniteRank f)(n: N.Nat^)(factor: Finite.Through[n := n].Factor f) ->
  value finite = \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].Trace[].Factor[n := n, f := f, factor := factor].trace :=
  \fun (finite: Finite.FiniteRank f)(n: N.Nat^)(factor: Finite.Through[n := n].Factor f) => unique (value finite) (AtFactor[n := n, factor := factor].value);
