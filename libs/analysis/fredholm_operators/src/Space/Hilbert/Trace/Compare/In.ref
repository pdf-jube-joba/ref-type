\import Algebra.Subspace[V := V, space := space] \as Subspaces;
\definition image: Subspaces.Subspace := Subspaces.Image[U := V, source := space].image P.map;
\import Subspaces.Of[subspace := image] \as Image;
\import \root.FiniteSpace[V := Image.Carrier, space := Image.induced] \as Dimension;
\definition fixed: \forall (x: Image.Carrier) -> P.map.apply x = x := \block {
  \fun (x: Image.Carrier) \then
  \takefrom y: \Cast[V] ({ y: V \where P.map.apply y = x }) \by \bysub(V, image.carrier, x) \then
  \return \idelim P.map.apply y = x \with z: V => P.map.apply z = z \by { base: P.idempotent y, equality: \bysub(V, { y: V \where P.map.apply y = x }, y) }
};
\import \root.FiniteSpace[V := V, space := space].Subspace[S := image].Fixed[f := P.map, fixed := fixed] \as FiniteImage;
\module InFrame(frame: Dimension.Frame);
\definition equal: First.trace = Second.trace := \block {
  \takefrom frame: Dimension.Frame \by Dimension.frameExists (FiniteImage.finite P.finite) \then
  \return InFrame[frame := frame].equal
};
