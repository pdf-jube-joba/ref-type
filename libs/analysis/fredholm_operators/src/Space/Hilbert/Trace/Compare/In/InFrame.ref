\import Algebra.Finite[V := Image.Carrier, I := Fin.Fin frame.size, space := Image.induced] \as ImageBasis;
\import First.Chosen[P := P, covers := firstCovers] \as FirstFixed;
\import Second.Chosen[P := P, covers := secondCovers] \as SecondFixed;
\module FromFactor(k: N.Nat^, factor: Finite.Through[n := k].Factor f, fixes: \forall (x: Algebra.Coordinates[I := Fin.Fin k].Vector) -> P.map.apply (factor.out.apply x) = factor.out.apply x);
\definition equal: First.trace = Second.trace := trans!{C.Complex} _ _ _
  (FromFactor[k := n, factor := first, fixes := FirstFixed.fixed].trace)
  (sym!{C.Complex} _ _ (FromFactor[k := m, factor := second, fixes := SecondFixed.fixed].trace));
