\module InFactors(n, m: N.Nat^, first: Finite.Through[n := n].Factor f, second: Finite.Through[n := m].Factor g);
\definition additive: \forall (ff: Finite.FiniteRank f)(gf: Finite.FiniteRank g) -> trace (Operations.plus f g) (Finite.plus f g ff gf) = C.Def[].add (trace f ff) (trace g gf) := \block {
  \fun (ff: Finite.FiniteRank f)(gf: Finite.FiniteRank g) \then
  \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where \exists Finite.Through[n := n].Factor f }) \by ff \then
  \takefrom m: \Cast[N.Nat^] ({ m: N.Nat^ \where \exists Finite.Through[n := m].Factor g }) \by gf \then
  \takefrom first: Finite.Through[n := n].Factor f \by \bysub(N.Nat^, { n: N.Nat^ \where \exists Finite.Through[n := n].Factor f }, n) \then
  \takefrom second: Finite.Through[n := m].Factor g \by \bysub(N.Nat^, { m: N.Nat^ \where \exists Finite.Through[n := m].Factor g }, m) \then
  \return InFactors[n := n, m := m, first := first, second := second].additive ff gf
};
