\import \parent.\parent.Factor[n := n, f := f, factor := factor] \as Factor;
\definition value: Value f := \into[C.Complex](Factor.trace, { value: C.Complex \where Represents f value }) \by {
  Logic.existsIntro[N.Nat^, { n: N.Nat^ \where \exists ( factor: Finite.Through[n := n].Factor f \where \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].Trace[].Factor[n := n, f := f, factor := factor].trace = Factor.trace ) }] n
    (Logic.existsIntro[Finite.Through[n := n].Factor f, { factor: Finite.Through[n := n].Factor f \where \root.Space[V := V, space := space, norm := norm].Hilbert[inner := inner].Trace[].Factor[n := n, f := f, factor := factor].trace = Factor.trace }] factor (\refl(Factor.trace)))
};
