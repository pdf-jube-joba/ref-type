\import LinearSubspaces.Of[subspace := S] \as Points;
\import \root.FiniteSpace[V := Points.Carrier, space := Points.induced] \as Dimension;
\module InFrame(frame: Dimension.Frame);
\definition closed: \forall (complete: Hilbert.Complete) -> Dimension.FiniteDimensional -> Subspaces.Closed S := \block {
  \fun (complete: Hilbert.Complete)(finite: Dimension.FiniteDimensional) \then
  \takefrom frame: Dimension.Frame \by Dimension.frameExists finite \then
  \return InFrame[frame := frame].closed complete
};
