\import complex_hilbert.Examples[] \as Z;
\import \root.Space[V := Z.Point, space := Z.space, norm := Z.norm].Operators[W := Z.Point, target := Z.space, targetNorm := Z.norm] \as Operators;
\import Operators.At[f := Z.identity] \as Identity;
\import Identity.Hilbert[inner := Z.inner, targetInner := Z.inner] \as Fredholm;
\import complex_hilbert.Space[V := Z.Point, space := Z.space].Operators[W := Z.Point, target := Z.space, norm := Z.norm, targetNorm := Z.norm].Compact[] \as Compact;
\import functional_analysis.Normed[V := Z.Point, space := complex_hilbert.Space[V := Z.Point, space := Z.space].realSpace] \as Normed;
\import std.Logic[].Proposition[] \as Logic;
\definition parametrix: Identity.Parametrix Z.identity := Logic.And[_, _]::#
  (Compact.zeroImage (Identity.leftDefect Z.identity) (\fun (x: Z.Point) => Normed.subSelf x))
  (Compact.zeroImage (Identity.rightDefect Z.identity) (\fun (x: Z.Point) => Normed.subSelf x));
\definition fredholm: Fredholm.Fredholm := Operators.Hilbert[inner := Z.inner, targetInner := Z.inner].atkinson Z.identity Z.complete Z.complete Z.identity parametrix;
\definition index: std.Arithmetic[].Int[].Integer := Fredholm.index fredholm;
