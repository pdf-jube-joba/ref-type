\import \root.Sum[V := U, W := Z, source := domain, target := codomain, norm := domainNorm, targetNorm := codomainNorm, inner := domainInner, targetInner := codomainInner] \as TargetSum;
\import Algebra.Linear[V := Product.Carrier, W := TargetSum.Carrier, source := Product.space, target := TargetSum.productSpace] \as Linear;
\import std.Data[].Pair[].Prop[A := U, B := Z] \as TargetPairs;
\definition linear: Linear.Map := Linear.Map {
  apply := \fun (x: Product.Carrier) => TargetSum.make (f.apply (Product.first x)) (g.apply (Product.second x)),
  preservesAdd := \fun (x, y: Product.Carrier) => TargetPairs.ext _ _ (f.preservesAdd (Product.first x) (Product.first y)) (g.preservesAdd (Product.second x) (Product.second y)),
  preservesScale := \fun (a: C.Complex)(x: Product.Carrier) => TargetPairs.ext _ _ (f.preservesScale a (Product.first x)) (g.preservesScale a (Product.second x)),
};
\import \root.Space[V := Product.Carrier, space := Product.space, norm := productNorm].Operators[W := TargetSum.Carrier, target := TargetSum.productSpace, targetNorm := TargetSum.productNorm] \as Operators;
\import complex_hilbert.Space[V := U, space := domain].Hilbert[norm := domainNorm, inner := domainInner] \as FirstTarget;
\import complex_hilbert.Space[V := Z, space := codomain].Hilbert[norm := codomainNorm, inner := codomainInner] \as SecondTarget;
\module At(complete: LeftHilbert.Complete, targetComplete: RightHilbert.Complete, domainComplete: FirstTarget.Complete, codomainComplete: SecondTarget.Complete);
