\import std.Data[].Nat[] \as N;
\import N.Basic[].Def[] \as NatOps;
\import N.Basic[].Prop[] \as Nat;
\import std.Arithmetic[].Int[] \as Z;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\use Equality.eq_reason_in;
\import std.Logic[].Proposition[] \as Logic;
\import real.Analysis[] \as Real;
\import Real.Estimates[] \as Estimates;
\import Estimates.Product[] \as Product;
\import Real.SquareRoot[] \as Root;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as RO;
\import R.Arithmetic[].Prop[] \as Laws;
\import complex.Complex[] \as C;
\import C.Def[] \as D;
\import C.Prop[] \as CL;
\import C.Absolute[] \as Abs;
\import fourier_schwartz.Euclidean[n := n] \as E;
\import E.Complex[] \as S;
\import fourier_schwartz.Scalars[] \as Scalars;
\import fourier_l2.Euclidean[n := n] \as Fourier;
\import Fourier.Unitary[] \as U;
\import Fourier.Embedding[] \as Embedding;
\import Fourier.Schwartz[] \as Transform;
\import Fourier.Multiplication[] \as Multiplication;
\import Fourier.Derivatives[] \as Derivatives;
\definition Point: \Set := E.Point;
\import lp_spaces.Euclidean[n := n] \as LE;
\import lp_spaces.Powers[].Algebra[] \as PA;
\import lp_spaces.On[A := Point, mu := LE.measure] \as L;
\import L.Complex[] \as L2;
\import L2.Geometry[] \as Geometry;
\import L2.Inner[] \as Inner;
\import functional_analysis.Measure[A := Point] \as M;
\import M.Integral[mu := LE.measure] \as I;
\import I.Scaling[] \as Scaling;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import complex_hilbert.Space[V := L2.Space, space := L2.Vector[].space] \as CS;
\import CS.Hilbert[norm := Geometry.norm, inner := Inner.inner] \as Hilbert;
\definition complete: Hilbert.Complete := L2.Complete[].hilbert;
\import measure_convergence.On[A := Point, mu := LE.measure].Complex[] \as CI;
\import E.Integral[] \as FI;
\import Open.Analysis[] \as Analysis;
\import Open.Smooth[] \as Smooth;
\import Real.Algebra[] \as Algebra;
\import fourier_schwartz.Phase[] \as Phase;
\import distributions.Euclidean[n := n] \as Dist;
\import std.Data[].FinSet[] \as Fin;
\import Real.FiniteSums[] \as Sum;
\import E.Transform[].Preservation[] \as Polynomial;
\import calculus.Maps[n := n, m := n] \as Maps;
\import calculus.Diffeomorphism[n := n, m := n] \as Diffeo;
\module Order(k: N.Nat^);
\module Signed(s: Z.Int^);
\module Weak;
\module Energy;
\module Moments;
\module FourierIntegral;
\module Decay(p: N.Nat^, range: Nat.Lt n (NatOps.add p p));
\module EmbeddingTheorem(r,p: N.Nat^, range: Nat.Lt n (NatOps.add p p));
\module Regularity;
\module Coordinates(U,V: Open.OpenSet, e: Diffeo.Diffeomorphism U V);
\module Transport(U,V: Open.OpenSet, e: Diffeo.Diffeomorphism U V, cutoff: Dist.TestOn U, k: N.Nat^);
\module MultiplicationBy(cutoff: LE.SmoothCompact, k: N.Nat^);
