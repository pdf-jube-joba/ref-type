\import topological_algebra.Euclidean[].Dimension[n := n].Norm[] \as EuclideanMetric;
\import topology.Topology[Carrier := Point] \as Sets;
\import L.Parametric[B := Point, metric := EuclideanMetric.metric] \as Parameters;
\definition realContinuous[g: CI.Representatives]: Analysis.ContinuousOn Open.whole (\fun (x: Open.Carrier Open.whole) => C.re (FI.transform g x)) :=
  \fun (a: Open.Carrier Open.whole)(epsilon: Real.Real)(positive: _) => \block {
    \takefrom delta: \Cast[Real.Real] ({ delta: Real.Real \where Parameters.Control[(\fun (b: Point) => C.re (FI.transform g b)), a, Sets.Whole, C.re (FI.transform g a), epsilon, delta] })
      \by FI.Continuity[f := g, at := a].real epsilon positive \then
    \let control: Parameters.Control[(\fun (b: Point) => C.re (FI.transform g b)), a, Sets.Whole, C.re (FI.transform g a), epsilon, delta] :=
      \bysub(Real.Real, { delta: Real.Real \where Parameters.Control[(\fun (b: Point) => C.re (FI.transform g b)), a, Sets.Whole, C.re (FI.transform g a), epsilon, delta] }, delta) \then
    \return Logic.existsIntro[Real.Real, { delta: Real.Real \where Analysis.ContinuityControl[Open.whole, (\fun (x: Open.Carrier Open.whole) => C.re (FI.transform g x)), a, epsilon, delta] }] delta
      (Analysis.ContinuityControl[Open.whole, (\fun (x: Open.Carrier Open.whole) => C.re (FI.transform g x)), a, epsilon, delta] {
        positive := control.positive, estimate := \fun (x: Open.Carrier Open.whole)(near: _) => control.estimate x (\refl(x)) near,
      })
  };
\definition imaginaryContinuous[g: CI.Representatives]: Analysis.ContinuousOn Open.whole (\fun (x: Open.Carrier Open.whole) => C.im (FI.transform g x)) :=
  \fun (a: Open.Carrier Open.whole)(epsilon: Real.Real)(positive: _) => \block {
    \takefrom delta: \Cast[Real.Real] ({ delta: Real.Real \where Parameters.Control[(\fun (b: Point) => C.im (FI.transform g b)), a, Sets.Whole, C.im (FI.transform g a), epsilon, delta] })
      \by FI.Continuity[f := g, at := a].imaginary epsilon positive \then
    \let control: Parameters.Control[(\fun (b: Point) => C.im (FI.transform g b)), a, Sets.Whole, C.im (FI.transform g a), epsilon, delta] :=
      \bysub(Real.Real, { delta: Real.Real \where Parameters.Control[(\fun (b: Point) => C.im (FI.transform g b)), a, Sets.Whole, C.im (FI.transform g a), epsilon, delta] }, delta) \then
    \return Logic.existsIntro[Real.Real, { delta: Real.Real \where Analysis.ContinuityControl[Open.whole, (\fun (x: Open.Carrier Open.whole) => C.im (FI.transform g x)), a, epsilon, delta] }] delta
      (Analysis.ContinuityControl[Open.whole, (\fun (x: Open.Carrier Open.whole) => C.im (FI.transform g x)), a, epsilon, delta] {
        positive := control.positive, estimate := \fun (x: Open.Carrier Open.whole)(near: _) => control.estimate x (\refl(x)) near,
      })
  };
