\module At(a: Point);
\definition realPartial: Analysis.HasPartialDerivative Open.whole (\fun (x: Open.Carrier Open.whole) => C.re (FI.transform source x)) i
  (\fun (x: Open.Carrier Open.whole) => C.re (FI.transform differentiated x)) :=
  \fun (a: Open.Carrier Open.whole) => Operations.sectionPartial Open.whole (\fun (x: Open.Carrier Open.whole) => C.re (FI.transform source x)) a i (\fun (t: Real.Real) => C.re (FI.transform source (Coordinates.replace a i t)))
    (C.re (FI.transform differentiated a))
    (congr!{Point Real.Real} (\fun (x: Point) => C.re (FI.transform source x)) _ _ (CoordinateLaws.replaceOriginal a i))
    (\fun (t: Real.Real)(x: Open.Carrier Open.whole)(same: _) => congr!{Point Real.Real} (\fun (p: Point) => C.re (FI.transform source p)) _ _ (sym!{Point} _ _ same))
    (At[a := a].real);
\definition imaginaryPartial: Analysis.HasPartialDerivative Open.whole (\fun (x: Open.Carrier Open.whole) => C.im (FI.transform source x)) i
  (\fun (x: Open.Carrier Open.whole) => C.im (FI.transform differentiated x)) :=
  \fun (a: Open.Carrier Open.whole) => Operations.sectionPartial Open.whole (\fun (x: Open.Carrier Open.whole) => C.im (FI.transform source x)) a i (\fun (t: Real.Real) => C.im (FI.transform source (Coordinates.replace a i t)))
    (C.im (FI.transform differentiated a))
    (congr!{Point Real.Real} (\fun (x: Point) => C.im (FI.transform source x)) _ _ (CoordinateLaws.replaceOriginal a i))
    (\fun (t: Real.Real)(x: Open.Carrier Open.whole)(same: _) => congr!{Point Real.Real} (\fun (p: Point) => C.im (FI.transform source p)) _ _ (sym!{Point} _ _ same))
    (At[a := a].imaginary);
