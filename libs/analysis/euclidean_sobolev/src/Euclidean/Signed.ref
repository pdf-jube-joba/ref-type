\definition weightAt: Z.Int^ -> Point -> Real.Real := \induction (j: Z.Int^) \return Point -> Real.Real \with {
  | ofNat: \fun (k: N.Nat^)(x: Point) => \parent.Order[k := k].Weight[].value x
  | negSucc: \fun (k: N.Nat^)(x: Point) => \parent.Order[k := N.Nat^::succ k].Weight[].inverse x
};
\definition weight: Point -> Real.Real := weightAt s;
\definition Space: \Set := L2.Space;
\definition norm: Space -> Real.Real := L2.normValue;
\definition frequency[f: S.Function]: L2.Representatives := Embedding.representative (Transform.forward f);
\definition representative: Z.Int^ -> S.Function -> L2.Representatives :=
  \induction (j: Z.Int^) \return S.Function -> L2.Representatives \with {
    | ofNat: \fun (k: N.Nat^)(f: S.Function) => \parent.Order[k := k].Schwartz[].weighted f
    | negSucc: \fun (k: N.Nat^)(f: S.Function) => Multiplication.By[symbol := \parent.Order[k := N.Nat^::succ k].Weight[].reciprocal].representative (frequency f)
  };
\definition multiplier: \forall (j: Z.Int^)(f: S.Function)(xi: Point) ->
  representative j f xi = D.scale (weightAt j xi) (frequency f xi) :=
  \induction (j: Z.Int^) \return \forall (f: S.Function)(xi: Point) -> representative j f xi = D.scale (weightAt j xi) (frequency f xi) \with {
    | ofNat: \fun (k: N.Nat^)(f: S.Function)(xi: Point) => \parent.Order[k := k].Schwartz[].law f xi
    | negSucc: \fun (k: N.Nat^)(f: S.Function)(xi: Point) => Scalars.realProduct _ _
  };
\definition ofSchwartz[f: S.Function]: Space := L2.ofFunction (representative s f);
