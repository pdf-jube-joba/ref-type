\import E.Operations[] \as Ops;
\import Open.Restriction[] \as Restriction;
\import Smooth.Derivative[] \as Partial;
\definition restrictedPartial[j: E.Coordinate]: Partial.derivative V (restrict f) j = restrict (Ops.partial f j) :=
  \axiom:funext(Partial.derivative V (restrict f) j, restrict (Ops.partial f j), \fun (y: Open.Carrier V) =>
    Analysis.Properties[].partialUnique V (restrict f) j y _ _ (Partial.partialLaw V (restrict f) j y)
      (Restriction.localPartial V Open.whole (\fun (x: Point)(member: _) => \refl(x)) f (Partial.derivative Open.whole f j) j (Partial.partialLaw Open.whole f j) y));
\definition terms[j: E.Coordinate]: Coefficient := component (coefficient a i j) (Ops.partial f j);
\definition inside[x: Open.Carrier U]: On.partial (component a f) i x =
  Real.add (component (On.partial a i) f x) (Sum.sum n (\fun (j: E.Coordinate) => terms j x)) := eq_reason_in!{Real.Real _
  "=" _ "by" { congr!{Functions.Function Real.Real} (\fun (h: Functions.Function) => h x) _ _ (sym!{Functions.Function} _ _ (Source.restrictionPartial (component a f) i)) }
  "=" _ "by" { congr!{Functions.Function Real.Real} (\fun (h: Functions.Function) => Differential.apply i h x) _ _ (\parent.LocalProduct[a := a, h := Chain.function (restrict f)].restriction) }
  "=" _ "by" { congr!{Functions.Function Real.Real} (\fun (h: Functions.Function) => h x) _ _ (Differential.product i (Source.restriction a) (Chain.function (restrict f))) }
  "=" _ "by" { congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _
    (congr!{Functions.Function Real.Real} (\fun (h: Functions.Function) => Real.mul (h x) (Chain.function (restrict f) x)) _ _ (Source.restrictionPartial a i))
    (congr!{Real.Real Real.Real} (Real.mul (a x)) _ _ (Chain.derivative (restrict f) i x)) }
  "=" _ "by" { congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _
    (sym!{Real.Real} _ _ (\parent.LocalProduct[a := On.partial a i, h := Chain.function (restrict f)].inside x))
    (sym!{Real.Real} _ _ (Sum.scalar n (a x) (\fun (j: E.Coordinate) => Chain.term (restrict f) i j x))) }
  "=" _ "by" { congr!{Real.Real Real.Real} (Real.add (component (On.partial a i) f x)) _ _ (Sum.congruent n _ _ (\fun (j: E.Coordinate) => eq_reason_in!{Real.Real _
    "=" _ "by" { congr!{{Smooth.SmoothFunction V} Real.Real} (\fun (h: Smooth.SmoothFunction V) => Real.mul (a x) (Real.mul (Chain.scalar h x) (Chain.innerPartial j i x))) _ _ (restrictedPartial j) }
    "=" _ "by" { congr!{Real.Real Real.Real} (Real.mul (a x)) _ _ (Laws.fieldMulComm _ _) }
    "=" _ "by" { sym!{Real.Real} _ _ (Laws.fieldMulAssoc _ _ _) }
    "=" _ "by" { congr!{Real.Real Real.Real} (\fun (v: Real.Real) => Real.mul v (Chain.scalar (restrict (Ops.partial f j)) x)) _ _ (sym!{Real.Real} _ _ (\parent.LocalProduct[a := a, h := Chain.innerPartial j i].inside x)) }
    "=" _ "by" { sym!{Real.Real} _ _ (\parent.LocalProduct[a := coefficient a i j, h := Chain.function (restrict (Ops.partial f j))].inside x) }
  })) }
};
\definition outside[b: Coefficient][x: Point][absent: Logic.Not (Sets.Member U.points x)]: b x = Real.zero :=
  Supports.zeroOutsideSupport Ambient.topology b x (\fun (member: _) => absent (Dist.testWithin U b x member));
\definition law[x: Point]: On.partial (component a f) i x =
  Real.add (component (On.partial a i) f x) (Sum.sum n (\fun (j: E.Coordinate) => terms j x)) :=
  Logic.orElim (Sets.Member U.points x) (Logic.Not (Sets.Member U.points x))
    (On.partial (component a f) i x = Real.add (component (On.partial a i) f x) (Sum.sum n (\fun (j: E.Coordinate) => terms j x)))
    (Classical.excludedMiddle (Sets.Member U.points x))
    (\fun (member: _) => inside (\into[Point](x, U.points) \by { member }))
    (\fun (absent: _) => eq_reason_in!{Real.Real _
      "=" _ "by" { outside (On.partial (component a f) i) x absent }
      "=" _ "by" { sym!{Real.Real} _ _ (Laws.addZeroLeft Real.zero) }
      "=" _ "by" { congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ (sym!{Real.Real} _ _ (outside (component (On.partial a i) f) x absent))
        (sym!{Real.Real} _ _ (trans!{Real.Real} _ _ _ (Sum.congruent n _ _ (\fun (j: E.Coordinate) => outside (terms j) x absent)) (Sum.zeroSum n))) }
    });
