\definition row[i: E.Coordinate]: Real.Real := Real.add (p i) (Sum.sum n (\fun (j: E.Coordinate) => c i j));
\definition bound: LE.Nonnegative := \into[Real.Real](Real.add b (Sum.sum n row), LE.Nonnegative) \by {
  Laws.addNonnegative b (Sum.sum n row) (Scaling.nonnegative b) (Sum.nonnegative n row (\fun (i: E.Coordinate) =>
    Laws.addNonnegative (p i) (Sum.sum n (\fun (j: E.Coordinate) => c i j)) (Scaling.nonnegative (p i))
      (Sum.nonnegative n (\fun (j: E.Coordinate) => c i j) (\fun (j: E.Coordinate) => Scaling.nonnegative (c i j)))))
};
\definition sumRight[m: N.Nat^][a: Fin.Fin m -> Real.Real][t: Real.Real]:
  Sum.sum m (\fun (j: Fin.Fin m) => Real.mul (a j) t) = Real.mul (Sum.sum m a) t := eq_reason_in!{Real.Real _
  "=" _ "by" { Sum.congruent m _ _ (\fun (j: Fin.Fin m) => Laws.fieldMulComm (a j) t) }
  "=" _ "by" { Sum.scalar m t a }
  "=" _ "by" { Laws.fieldMulComm _ _ }
};
\definition weaken[g: S.Function][a: Coefficient][h: Constants k a][t: Real.Real][larger: R.Le (Energy.norm k g) t]:
  R.Le (Energy.norm k (transform a g)) (Real.mul h t) :=
  R.leTrans _ _ _ ((\bysub(LE.Nonnegative, { h: LE.Nonnegative \where Bound k a h }, h)) g) (Estimates.mulMonotone _ _ _ (Scaling.nonnegative h) larger);
\definition partial[f: S.Function][i: E.Coordinate]: R.Le (Energy.norm k (S.partial (transform a f) i)) (Real.mul (row i) (Energy.norm (N.Nat^::succ k) f)) := \block {
  \let t: Real.Real := Energy.norm (N.Nat^::succ k) f \then
  \let terms: E.Coordinate -> S.Function := term a f i \then
  \let sum: R.Le (Energy.norm k (Polynomial.sum n terms)) (Real.mul (Sum.sum n (\fun (j: E.Coordinate) => c i j)) t) :=
    R.leReplaceRight _ _ _ (sumRight n (\fun (j: E.Coordinate) => c i j) t) (R.leTrans _ _ _ (Energy.sumBound k n terms)
      (Sum.comparison n _ _ (\fun (j: E.Coordinate) => weaken (S.partial f j) (coefficient a i j) (c i j) t (Energy.lowerPartial k f j)))) \then
  \return R.leReplace _ _ _ _ (sym!{Real.Real} _ _ (Energy.pointwise k _ _ (derivative a f i)))
    (sym!{Real.Real} _ _ (Algebra.mulAddRight _ _ t))
    (R.leTrans _ _ _ (Energy.triangle k (transform (On.partial a i) f) (Polynomial.sum n terms))
      (Estimates.addLe _ _ _ _ (weaken f (On.partial a i) (p i) t (Energy.lower k f)) sum))
};
\definition estimate[f: S.Function]: R.Le (Energy.norm (N.Nat^::succ k) (transform a f)) (Real.mul bound (Energy.norm (N.Nat^::succ k) f)) := \block {
  \let t: Real.Real := Energy.norm (N.Nat^::succ k) f \then
  \return R.leReplaceRight _ _ _ (sym!{Real.Real} _ _ (Algebra.mulAddRight b (Sum.sum n row) t)) (R.leTrans _ _ _
    (Energy.upper k (transform a f)) (Estimates.addLe _ _ _ _ (weaken f a b t (Energy.lower k f))
      (R.leReplaceRight _ _ _ (sumRight n row t) (Sum.comparison n _ _ (partial f)))))
};
\definition constant: Constants (N.Nat^::succ k) a := \into[LE.Nonnegative](bound, Constants (N.Nat^::succ k) a) \by { estimate };
