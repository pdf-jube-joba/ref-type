\import std.Data[].Nat[].Order[].Prop[] \as Bounds;
\definition q: Real.Real := Product.coefficient b Real.zero;
\definition qp: R.Lt Real.zero q := Product.coefficientPositive b Real.zero;
\definition lipschitz[f,g: S.Function]: R.Le (Geometry.metric.distance (applyCore f) (applyCore g)) (Real.mul b (Geometry.metric.distance (Core.value f) (Core.value g))) :=
  R.leReplace _ _ _ _ (congr!{L2.Space Real.Real} L2.normValue _ _ (imageDifference f g))
    (congr!{L2.Space Real.Real} (\fun (z: L2.Space) => Real.mul b (L2.normValue z)) _ _ (difference f g))
    ((\bysub(LE.Nonnegative, { b: LE.Nonnegative \where Bound k a b }, b)) (Transform.difference f g));
\definition small[f,g: S.Function][epsilon: Real.Real][positive: R.Lt Real.zero epsilon]:
  R.Lt (Geometry.metric.distance (Core.value f) (Core.value g)) (Product.radius q epsilon) -> R.Lt (Geometry.metric.distance (applyCore f) (applyCore g)) epsilon :=
  \fun (near: _) => R.leLtTrans _ _ _ (lipschitz f g) (R.leLtTrans _ _ _
    (R.leReplace _ _ _ _ (Laws.fieldMulComm _ _) (Laws.fieldMulComm _ _)
      (Estimates.mulMonotone _ _ _ (Geometry.metric.nonnegative _ _)
        (R.leReplaceLeft _ _ _ (Product.absOfNonnegative _ (Scaling.nonnegative b)) (Product.coefficientFirst b Real.zero))))
    (RO.ltTrans _ _ _ (Product.mulStrict q _ _ qp near) (Product.radiusSmall q epsilon qp positive)));
\definition cauchy[s: Density.Sequence]: Metric.Cauchy Geometry.metric (source s) -> Metric.Cauchy Geometry.metric (image s) := \fun (law: _)(epsilon: Real.Real)(positive: _) => \block {
  \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Metric.CauchyControl Geometry.metric (source s) (Product.radius q epsilon) k }) \by law (Product.radius q epsilon) (Product.radiusPositive q epsilon qp positive) \then
  \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Metric.CauchyControl Geometry.metric (image s) epsilon k }] k
    (\fun (i, j: N.Nat^)(ki: _)(kj: _) => small (s i) (s j) epsilon positive
      ((\bysub(N.Nat^, { k: N.Nat^ \where Metric.CauchyControl Geometry.metric (source s) (Product.radius q epsilon) k }, k)) i j ki kj))
};
\definition transfer[s, t: Density.Sequence][x, y: L2.Space]: Metric.Converges Geometry.metric (source s) x -> Metric.Converges Geometry.metric (source t) x -> Metric.Converges Geometry.metric (image t) y -> Metric.Converges Geometry.metric (image s) y :=
  \fun (sx: _)(tx: _)(ty: _)(epsilon: Real.Real)(positive: _) => \block {
    \let h: Real.Real := Real.mul Real.half epsilon \then
    \let hp: R.Lt Real.zero h := Estimates.halfOfPositive epsilon positive \then
    \let delta: Real.Real := Product.radius q h \then
    \let dp: R.Lt Real.zero delta := Product.radiusPositive q h qp hp \then
    \let halfDelta: Real.Real := Real.mul Real.half delta \then
    \let halfPositive: R.Lt Real.zero halfDelta := Estimates.halfOfPositive delta dp \then
    \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Metric.LimitControl Geometry.metric (source s) x halfDelta k }) \by sx halfDelta halfPositive \then
    \takefrom l: \Cast[N.Nat^] ({ l: N.Nat^ \where Metric.LimitControl Geometry.metric (source t) x halfDelta l }) \by tx halfDelta halfPositive \then
    \takefrom m: \Cast[N.Nat^] ({ m: N.Nat^ \where Metric.LimitControl Geometry.metric (image t) y h m }) \by ty h hp \then
    \let threshold: N.Nat^ := Bounds.commonBound (Bounds.commonBound k l) m \then
    \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Metric.LimitControl Geometry.metric (image s) y epsilon k }] threshold
      (\fun (j: N.Nat^)(later: Nat.Le threshold j) => \block {
        \let kl: Nat.Le (Bounds.commonBound k l) j := Nat.leTrans (Bounds.commonBound k l) threshold j (Bounds.leftLeCommonBound (Bounds.commonBound k l) m) later \then
        \let first: R.Lt (Geometry.metric.distance (source s j) x) halfDelta := (\bysub(N.Nat^, { k: N.Nat^ \where Metric.LimitControl Geometry.metric (source s) x halfDelta k }, k)) j (Nat.leTrans _ _ _ (Bounds.leftLeCommonBound k l) kl) \then
        \let second: R.Lt (Geometry.metric.distance x (source t j)) halfDelta := R.ltReplaceLeft _ _ _ (Geometry.metric.symmetric (source t j) x)
          ((\bysub(N.Nat^, { l: N.Nat^ \where Metric.LimitControl Geometry.metric (source t) x halfDelta l }, l)) j (Nat.leTrans _ _ _ (Bounds.rightLeCommonBound k l) kl)) \then
        \let near: R.Lt (Geometry.metric.distance (image s j) (image t j)) h := small (s j) (t j) h hp
          (R.leLtTrans _ _ _ (Geometry.metric.triangle (source s j) x (source t j)) (R.ltReplaceRight _ _ _ (Estimates.halfTwice delta) (Estimates.addLt _ _ _ _ first second))) \then
        \return R.leLtTrans _ _ _ (Geometry.metric.triangle (image s j) (image t j) y)
          (R.ltReplaceRight _ _ _ (Estimates.halfTwice epsilon) (Estimates.addLt _ _ _ _ near
            ((\bysub(N.Nat^, { m: N.Nat^ \where Metric.LimitControl Geometry.metric (image t) y h m }, m)) j (Nat.leTrans _ _ _ (Bounds.rightLeCommonBound (Bounds.commonBound k l) m) later))))
      })
  };
\definition exists[x: L2.Space]: \exists Values x := \block {
  \takefrom s: \Cast[Density.Sequence] ({ s: Density.Sequence \where Metric.Converges Geometry.metric (source s) x }) \by Density.sequenceExists x \then
  \let limit: Metric.Converges Geometry.metric (source s) x := \bysub(Density.Sequence, { s: Density.Sequence \where Metric.Converges Geometry.metric (source s) x }, s) \then
  \takefrom y: \Cast[L2.Space] ({ y: L2.Space \where Metric.Converges Geometry.metric (image s) y }) \by Completion.complete (image s) (cauchy s (Metric.convergentCauchy Geometry.metric (source s) x limit)) \then
  \return \exact(\into[L2.Space](y, Values x) \by {
    \fun (t: Density.Sequence)(tx: _) => transfer t s x y tx limit (\bysub(L2.Space, { y: L2.Space \where Metric.Converges Geometry.metric (image s) y }, y))
  }, Values x)
};
