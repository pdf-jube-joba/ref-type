\definition local: Functions.Function := Functions.product (Source.restriction a) h;
\import Support.ZeroExtension[U := U, f := local] \as Extension;
\definition away[x: Point]: Logic.Not (Sets.Member (Support.support a) x) -> Extension.value x = Real.zero :=
  \fun (absent: Logic.Not (Sets.Member (Support.support a) x)) =>
  Logic.orElim (Sets.Member U.points x) (Logic.Not (Sets.Member U.points x)) (Extension.value x = Real.zero)
    (Classical.excludedMiddle (Sets.Member U.points x)) (\fun (member: Sets.Member U.points x) => \block {
      \let p: Open.Carrier U := \into[Point](x, U.points) \by { member } \then
      \return eq_reason_in!{Real.Real {Extension.value x}
        "=" _ "by" { Extension.inside p }
        "=" _ "by" { congr!{Real.Real Real.Real} (\fun (v: Real.Real) => Real.mul v (h p)) _ _ (Supports.zeroOutsideSupport Ambient.topology a x absent) }
        "=" _ "by" { Laws.fieldMulZeroLeft _ }
      }
    }) (Extension.outside x);
\definition support: Sets.Subset (Support.support Extension.value) (Support.support a) :=
  Supports.supportWithinClosed Ambient.topology _ _ (Supports.supportClosed Ambient.topology a) away;
\definition conditions: Local.Conditions[local] := Local.Conditions[local] {
  smooth := \bysub(Open.ScalarFunction U, Functions.Function, local),
  compact := Supports.compactSupportWithin Ambient.topology _ _ (LE.smoothCompactLaws a).compact support,
  within := Sets.subsetTrans _ _ _ support (Dist.testWithin U a),
};
\definition value: Coefficient := \into[Dist.Test](Local.extend local conditions, Coefficient) \by { conditions.within };
\definition inside[x: Open.Carrier U]: value x = Real.mul (a x) (h x) := Extension.inside x;
\definition restriction: Source.restriction value = local := Functions.ext (Source.restriction value) local inside;
