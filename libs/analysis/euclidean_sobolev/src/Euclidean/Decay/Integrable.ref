\definition head[x: Point]: R.Le (Product.abs (data.function x)) Real.one :=
  R.leTrans _ _ _ (R.leReplace _ _ _ _ (Algebra.mulOneRight _) (Laws.fieldMulComm _ _)
    (Estimates.mulMonotone _ _ _ (Product.absNonnegative _) (Bounds.weightOne p x))) (data.bound x);
\definition tail[k: N.Nat^][x: Point][outside: Logic.Not (Sets.Member (Measure.points (Exhaustion.box k)) x)]:
  R.Le (Product.abs (data.function x)) (Shells.coefficient k) := \block {
  \let q: Real.Real := Powers.power (Exhaustion.radius k) Shells.degree \then
  \let a: Real.Real := Product.abs (data.function x) \then
  \return R.leReplace _ _ _ _ (eq_reason_in!{Real.Real {Real.mul (Shells.coefficient k) (Real.mul q a)}
    "=" _ "by" { sym!{Real.Real} _ _ (Laws.fieldMulAssoc _ _ _) }
    "=" _ "by" { congr!{Real.Real Real.Real} (\fun (t: Real.Real) => Real.mul t a) _ _ (Bounds.coefficientCancellation k) }
    "=" _ "by" { Laws.fieldMulOneLeft _ }
  }) (Algebra.mulOneRight _) (Estimates.mulMonotone _ _ _ (Shells.coefficientNonnegative k)
    (R.leTrans _ _ _ (R.leReplace _ _ _ _ (Laws.fieldMulComm _ _) (Laws.fieldMulComm _ _)
      (Estimates.mulMonotone _ _ _ (Product.absNonnegative _) (shellBound k x outside))) (data.bound x)))
};
\definition predicate[x: Point][k: N.Nat^]: \Prop := Sets.Member (Measure.points (Exhaustion.box k)) x;
\definition dominateAt[x: Point]: \forall (k: N.Nat^) -> Induction.LeastLaws[(predicate x), k] -> R.Le (Product.abs (data.function x)) (Envelope.value x) :=
  \induction (k: N.Nat^) \return Induction.LeastLaws[(predicate x), k] -> R.Le (Product.abs (data.function x)) (Envelope.value x) \with {
    | zero: \fun (least: Induction.LeastLaws[(predicate x), N.Nat^::zero]) => R.leTrans _ _ _ (head x) (R.leReplaceLeft _ _ _
      (trans!{Real.Real} _ _ _ (Shells.Term[k := N.Nat^::zero].inside x (Exhaustion.boxGrowing _ _ (Nat.zeroLe _) x least.member)) (Numeric.one Shells.degree))
      (Envelope.termBelow N.Nat^::zero x))
    | succ: \fun (k: N.Nat^)(previous: _)(least: Induction.LeastLaws[(predicate x), N.Nat^::succ k]) => R.leTrans _ _ _
      (tail k x (\fun (member: _) => Nat.ltIrrefl k (Nat.ltOfSuccLe k k (least.least k member))))
      (R.leReplaceLeft _ _ _ (Shells.Term[k := k].inside x least.member) (Envelope.termBelow k x))
  };
\definition dominated[x: Point]: R.Le (Product.abs (data.function x)) (Product.abs (Envelope.value x)) := \block {
  \takefrom k: Induction.LeastValue (predicate x) \by Induction.leastExists (predicate x) (Exhaustion.covers x) \then
  \return R.leReplaceRight _ _ _ (sym!{Real.Real} _ _ (Product.absOfNonnegative _ (Envelope.nonnegative x)))
    (dominateAt x k (\bysub(N.Nat^, { k: N.Nat^ \where Induction.LeastLaws[(predicate x), k] }, k)))
};
\definition value: I.Representatives := \into[Point -> Real.Real](data.function, I.Representatives) \by {
  I.Absolute[].dominatedIntegrable data.function Envelope.value data.measurable (I.integralLaw Envelope.value).integrable dominated
};
