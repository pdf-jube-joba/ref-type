\import Diffeo.Identity[] \as Identity;
\definition coefficient: Dist.TestOn Open.whole := \into[LE.SmoothCompact](cutoff, Dist.TestOn Open.whole) \by {
  \fun (x: Point)(member: _) => \refl(x)
};
\import \parent.Transport[U := Open.whole, V := Open.whole, e := Identity.value Open.whole, cutoff := coefficient, k := k] \as T;
\import \parent.Coordinates[U := Open.whole, V := Open.whole, e := Identity.value Open.whole] \as Local;
\import \parent.Order[k := k] \as H;
\import CS.Operators[W := L2.Space, target := L2.Vector[].space, norm := Geometry.norm, targetNorm := Geometry.norm] \as Operators;
\definition positive: Operators.Map := T.positive;
\definition negative: Operators.Map := T.negative;
\definition product[f: S.Function]: S.Function := Local.transform coefficient f;
\definition pointwise[f: S.Function][x: Point]: S.value (product f) x = D.scale (cutoff x) (S.value f x) :=
  Local.At[k := k, a := coefficient].inside f (Open.Whole[].point x);
\definition onSchwartz[f: S.Function]: positive.apply (H.Schwartz[].value f) = H.Schwartz[].value (product f) := T.onSchwartz f;
