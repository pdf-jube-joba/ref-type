\import M.Functions[mu := LE.measure] \as Functions;
\import L2.Characterization[] \as Characterization;
\import LE.Compact[p := PA.two] \as Compact;
\definition step[i: E.Coordinate][xi: Point][z: C.Complex]: C.Complex := D.scale (Real.neg (xi i)) (Phase.rotate z);
\definition apply[f: Point -> C.Complex]: E.Directions -> Point -> C.Complex :=
  \induction (d: E.Directions) \return Point -> C.Complex \with {
    | nil: f
    | cons: \fun (i: E.Coordinate)(tail: E.Directions)(g: Point -> C.Complex)(xi: Point) => step i xi (g xi)
  };
\definition measurable[f: Point -> C.Complex][valid: Characterization.Measurable f]: \forall (d: E.Directions) -> Characterization.Measurable (apply f d) :=
  \induction (d: E.Directions) \return Characterization.Measurable (apply f d) \with {
    | nil: valid
    | cons: \fun (i: E.Coordinate)(tail: E.Directions)(previous: Characterization.Measurable (apply f tail)) => \block {
      \let coord: M.IsMeasurable LE.measure (\fun (x: Point) => Real.neg (x i)) := Functions.negMeasurable (\fun (x: Point) => x i)
        (Compact.continuousMeasurable (\fun (x: Point) => x i) (Compact.smoothContinuous (\fun (x: Point) => x i) (Open.Examples[].projectionSmooth Open.whole i))) \then
      \return Logic.And[_, _]::#
        (L.Products[].measurable (\fun (x: Point) => Real.neg (x i)) (\fun (x: Point) => Real.neg (C.im (apply f tail x))) coord
          (Functions.negMeasurable (\fun (x: Point) => C.im (apply f tail x)) previous.right))
        (L.Products[].measurable (\fun (x: Point) => Real.neg (x i)) (\fun (x: Point) => C.re (apply f tail x)) coord previous.left)
    }
  };
\definition squared[f: Point -> C.Complex][xi: Point]: \forall (d: E.Directions) ->
  D.normSq (apply f d xi) = Real.mul (Derivatives.symbolSquared d xi) (D.normSq (f xi)) :=
  \induction (d: E.Directions) \return D.normSq (apply f d xi) = Real.mul (Derivatives.symbolSquared d xi) (D.normSq (f xi)) \with {
    | nil: sym!{Real.Real} _ _ (Laws.fieldMulOneLeft _)
    | cons: \fun (i: E.Coordinate)(tail: E.Directions)(previous: _) => eq_reason_in!{Real.Real _
      "=" _ "by" { Derivatives.scaleSquared _ _ }
      "=" _ "by" { congr!{Real.Real Real.Real Real.Real} Real.mul _ _ _ _ (Laws.fieldMulNegBoth (xi i) (xi i))
        (trans!{Real.Real} _ _ _ (Derivatives.rotationSquared _) previous) }
      "=" _ "by" { sym!{Real.Real} _ _ (Laws.fieldMulAssoc _ _ _) }
    }
  };
\definition product[f,g: Point -> C.Complex][xi: Point]: \forall (d: E.Directions) ->
  apply (\fun (x: Point) => D.mul (f x) (g x)) d xi = D.mul (f xi) (apply g d xi) :=
  \induction (d: E.Directions) \return apply (\fun (x: Point) => D.mul (f x) (g x)) d xi = D.mul (f xi) (apply g d xi) \with {
    | nil: \refl(D.mul (f xi) (g xi))
    | cons: \fun (i: E.Coordinate)(tail: E.Directions)(previous: _) => eq_reason_in!{C.Complex _
      "=" _ "by" { congr!{C.Complex C.Complex} (step i xi) _ _ previous }
      "=" _ "by" { congr!{C.Complex C.Complex} (D.scale (Real.neg (xi i))) _ _ (sym!{C.Complex} _ _ (Phase.Global[].rotateRight (f xi) (apply g tail xi))) }
      "=" _ "by" { sym!{C.Complex} _ _ (Scalars.scaleRight _ _ _) }
    }
  };
/* Truncate only to make the derivative family total above the requested order. */
\definition prefix: N.Nat^ -> E.Directions -> E.Directions := \induction (k: N.Nat^) \return E.Directions -> E.Directions \with {
  | zero: \fun (d: E.Directions) => E.Directions::nil
  | succ: \fun (k: N.Nat^)(shorten: _) => \induction (d: E.Directions) \return E.Directions \with {
    | nil: E.Directions::nil
    | cons: \fun (i: E.Coordinate)(tail: E.Directions)(unused: _) => E.Directions::cons i (shorten tail)
  }
};
\definition bounded: \forall (k: N.Nat^)(d: E.Directions) -> Nat.Le (Derivatives.order (prefix k d)) k :=
  \induction (k: N.Nat^) \return \forall (d: E.Directions) -> Nat.Le (Derivatives.order (prefix k d)) k \with {
    | zero: \fun (d: E.Directions) => Nat.zeroLe _
    | succ: \fun (k: N.Nat^)(previous: _) => \induction (d: E.Directions) \return Nat.Le (Derivatives.order (prefix (N.Nat^::succ k) d)) (N.Nat^::succ k) \with {
      | nil: Nat.zeroLe _
      | cons: \fun (i: E.Coordinate)(tail: E.Directions)(unused: _) => Nat.leSuccSucc _ _ (previous tail)
    }
  };
\definition within: \forall (k: N.Nat^)(d: E.Directions) -> Nat.Le (Derivatives.order d) k -> prefix k d = d :=
  \induction (k: N.Nat^) \return \forall (d: E.Directions) -> Nat.Le (Derivatives.order d) k -> prefix k d = d \with {
    | zero: \induction (d: E.Directions) \return Nat.Le (Derivatives.order d) N.Nat^::zero -> E.Directions::nil = d \with {
      | nil: \fun (bound: _) => \refl(E.Directions::nil)
      | cons: \fun (i: E.Coordinate)(tail: E.Directions)(unused: _)(bound: _) => Logic.falseElim (E.Directions::nil = E.Directions::cons i tail)
        (Nat.ltIrrefl N.Nat^::zero (Nat.ltOfSuccLe N.Nat^::zero N.Nat^::zero (Nat.leTrans _ _ _ (Nat.leSuccSucc _ _ (Nat.zeroLe (Derivatives.order tail))) bound)))
    }
    | succ: \fun (k: N.Nat^)(previous: _) => \induction (d: E.Directions) \return Nat.Le (Derivatives.order d) (N.Nat^::succ k) -> prefix (N.Nat^::succ k) d = d \with {
      | nil: \fun (bound: _) => \refl(E.Directions::nil)
      | cons: \fun (i: E.Coordinate)(tail: E.Directions)(unused: _)(bound: _) =>
        congr!{E.Directions E.Directions} (E.Directions::cons i) _ _ (previous tail (Nat.leOfSuccSucc _ _ bound))
    }
  };
