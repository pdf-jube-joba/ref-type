\definition base[xi: Point]: C.Complex := D.conj (data.frequency xi);
\definition cancel[xi: Point]: D.mul (D.conj (data.weighted xi)) (inverse xi) = base xi := eq_reason_in!{C.Complex _
  "=" _ "by" { CL.mulComm _ _ }
  "=" _ "by" { Scalars.realProduct _ _ }
  "=" _ "by" { congr!{C.Complex C.Complex} (D.scale (Weight.inverse xi)) _ _
    (trans!{C.Complex} _ _ _ (congr!{C.Complex C.Complex} D.conj _ _ (data.law xi)) (Fourier.Conjugation[].conjugateScale _ _)) }
  "=" _ "by" { Scalars.scaleCompose _ _ _ }
  "=" _ "by" { congr!{Real.Real C.Complex} (\fun (a: Real.Real) => D.scale a (base xi)) _ _
    (Laws.fieldInverseNonzero _ (Real.Inverse[].positiveNonzero _ (Weight.positive xi))) }
  "=" _ "by" { Scalars.scaleOne _ }
};
\definition input[d: E.Directions]: CI.Representatives :=
  Inner.product data.weighted (\parent.Kernel[d := Moments.prefix r d, degree := Moments.bounded r d].value);
\definition law[d: E.Directions][bound: Nat.Le (Derivatives.order d) r][xi: Point]: input d xi = Moments.apply base d xi := eq_reason_in!{C.Complex _
  "=" _ "by" { congr!{E.Directions C.Complex} (\fun (ds: E.Directions) => D.mul (D.conj (data.weighted xi)) (kernel ds xi)) _ _ (Moments.within r d bound) }
  "=" _ "by" { sym!{C.Complex} _ _ (Moments.product (\fun (x: Point) => D.conj (data.weighted x)) inverse xi d) }
  "=" _ "by" { congr!{{Point -> C.Complex} C.Complex} (\fun (g: Point -> C.Complex) => Moments.apply g d xi) _ _
    (\axiom:funext((\fun (x: Point) => D.mul (D.conj (data.weighted x)) (inverse x)), base, cancel)) }
};
\definition derivativeLaw[d: E.Directions][less: Nat.Lt (Derivatives.order d) r][i: E.Coordinate][xi: Point]:
  input (E.Directions::cons i d) xi = Moments.step i xi (input d xi) := trans!{C.Complex} _ _ _
  (law (E.Directions::cons i d) (Nat.succLeOfLt r (Derivatives.order d) less) xi)
  (congr!{C.Complex C.Complex} (Moments.step i xi) _ _
    (sym!{C.Complex} _ _ (law d (Nat.leTrans _ _ _ (Nat.leSelfSucc _) (Nat.succLeOfLt r _ less)) xi)));
\definition jet[d: E.Directions][x: Point]: C.Complex := FI.transform (input d) x;
\definition jetBound[d: E.Directions][x: Point]:
  R.Le (Abs.abs (jet d x)) (Real.mul (L2.normValue (L2.ofFunction data.weighted)) (kernelNorm d)) := \block {
  \let h: L2.Representatives := \parent.Kernel[d := Moments.prefix r d, degree := Moments.bounded r d].value \then
  \let z: L2.Space := Multiplication.By[symbol := phase x].value (L2.ofFunction h) \then
  \let equality: jet d x = Inner.value (L2.ofFunction data.weighted) z := eq_reason_in!{C.Complex _
    "=" _ "by" { Inner.pointwise (FI.section (input d) x) (Inner.product data.weighted (Multiplication.By[symbol := phase x].representative h))
      (\fun (xi: Point) => trans!{C.Complex} _ _ _ (CL.mulAssoc _ _ _) (congr!{C.Complex C.Complex} (D.mul (D.conj (data.weighted xi))) _ _ (CL.mulComm _ _))) }
    "=" _ "by" { sym!{C.Complex} _ _ (Inner.onClass data.weighted (Multiplication.By[symbol := phase x].representative h)) }
    "=" _ "by" { congr!{L2.Space C.Complex} (Inner.value (L2.ofFunction data.weighted)) _ _ (sym!{L2.Space} _ _ (Multiplication.By[symbol := phase x].onClass h)) }
  } \then
  \return R.leReplaceLeft _ _ _ (congr!{C.Complex Real.Real} Abs.abs _ _ (sym!{C.Complex} _ _ equality))
    (R.leTrans _ _ _ (H.Duality[].estimate (L2.ofFunction data.weighted) z)
      (Estimates.mulMonotone _ _ _ (Geometry.nonnegative (L2.ofFunction data.weighted))
        (R.leReplaceRight _ _ _ (Laws.fieldMulOneLeft _) (Multiplication.By[symbol := phase x].bound (L2.ofFunction h)))))
};
\definition realFamily[d: E.Directions]: Open.ScalarFunction Open.whole := \fun (x: Open.Carrier Open.whole) => C.re (jet d x);
\definition imaginaryFamily[d: E.Directions]: Open.ScalarFunction Open.whole := \fun (x: Open.Carrier Open.whole) => C.im (jet d x);
\definition realContDiff: Smooth.ContDiffOn Open.whole r (realFamily E.Directions::nil) :=
  Logic.existsIntro[Smooth.PartialFamily Open.whole, { family: Smooth.PartialFamily Open.whole \where Smooth.ContDiffLaws[Open.whole, realFamily E.Directions::nil, r, family] }] realFamily
    (Smooth.ContDiffLaws[Open.whole, realFamily E.Directions::nil, r, realFamily] {
      partials := Smooth.PartialFamilyLaws[Open.whole, realFamily E.Directions::nil, r, realFamily] {
        function := \refl(realFamily E.Directions::nil), derivative := \fun (d: E.Directions)(bound: _)(i: E.Coordinate) => Integral.Partial[source := input d, differentiated := input (E.Directions::cons i d), i := i, law := derivativeLaw d bound i].realPartial,
      },
      continuous := \fun (d: E.Directions)(bound: _) => Integral.Continuity[].realContinuous (input d),
    });
\definition imaginaryContDiff: Smooth.ContDiffOn Open.whole r (imaginaryFamily E.Directions::nil) :=
  Logic.existsIntro[Smooth.PartialFamily Open.whole, { family: Smooth.PartialFamily Open.whole \where Smooth.ContDiffLaws[Open.whole, imaginaryFamily E.Directions::nil, r, family] }] imaginaryFamily
    (Smooth.ContDiffLaws[Open.whole, imaginaryFamily E.Directions::nil, r, imaginaryFamily] {
      partials := Smooth.PartialFamilyLaws[Open.whole, imaginaryFamily E.Directions::nil, r, imaginaryFamily] {
        function := \refl(imaginaryFamily E.Directions::nil), derivative := \fun (d: E.Directions)(bound: _)(i: E.Coordinate) => Integral.Partial[source := input d, differentiated := input (E.Directions::cons i d), i := i, law := derivativeLaw d bound i].imaginaryPartial,
      },
      continuous := \fun (d: E.Directions)(bound: _) => Integral.Continuity[].imaginaryContinuous (input d),
    });
\definition value[x: Point]: C.Complex := D.scale Transform.coefficient (D.conj (jet E.Directions::nil x));
\definition real: Smooth.ContDiffOn Open.whole r (\fun (x: Open.Carrier Open.whole) => C.re (value x)) :=
  Smooth.Operations[].mulContDiff Open.whole r _ _ (Smooth.Operations[].constantContDiff Open.whole r Transform.coefficient) realContDiff;
\definition imaginary: Smooth.ContDiffOn Open.whole r (\fun (x: Open.Carrier Open.whole) => C.im (value x)) :=
  \idelim (\fun (x: Open.Carrier Open.whole) => Real.mul (Real.neg Transform.coefficient) (imaginaryFamily E.Directions::nil x)) =
    (\fun (x: Open.Carrier Open.whole) => C.im (value x)) \with g: Open.ScalarFunction Open.whole => Smooth.ContDiffOn Open.whole r g \by {
      base: Smooth.Operations[].mulContDiff Open.whole r _ _ (Smooth.Operations[].constantContDiff Open.whole r (Real.neg Transform.coefficient)) imaginaryContDiff,
      equality: \axiom:funext((\fun (x: Open.Carrier Open.whole) => Real.mul (Real.neg Transform.coefficient) (imaginaryFamily E.Directions::nil x)),
        (\fun (x: Open.Carrier Open.whole) => C.im (value x)), \fun (x: Open.Carrier Open.whole) => trans!{Real.Real} _ _ _
          (Laws.fieldMulNegLeft Transform.coefficient (imaginaryFamily E.Directions::nil x))
          (sym!{Real.Real} _ _ (Laws.fieldMulNegRight Transform.coefficient (imaginaryFamily E.Directions::nil x))))
    };
\definition inverseData: Integral.InverseData := Integral.InverseData {
  frequency := data.frequency, conjugate := input E.Directions::nil, law := law E.Directions::nil (Nat.zeroLe r),
};
\definition inverse: Integral.InverseOf (H.physical (Weighted.ofFunction data)) value :=
  Logic.existsIntro[Integral.InverseData, { a: Integral.InverseData \where Logic.And[
    L2.ofFunction a.frequency = U.forward (H.physical (Weighted.ofFunction data)), value = Integral.inverse a] }] inverseData
    (Logic.And[_, _]::# (eq_reason_in!{L2.Space _
      "=" _ "by" { sym!{L2.Space} _ _ (Weighted.inputFrequency data) }
      "=" _ "by" { sym!{L2.Space} _ _ (U.rightInverse _) }
    }) (\refl(value)));
