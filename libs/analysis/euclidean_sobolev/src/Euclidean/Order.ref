\module Weight;
\import Weight[] \as Bessel;
\import Fourier.Weighted[weight := Bessel.weight] \as W;
\import Multiplication.By[symbol := W.reciprocal] \as Divide;
\definition Positive: \Set := W.Vector;
\definition Negative: \Set := L2.Space;
\definition norm: L2.Space -> Real.Real := L2.normValue;
\definition physical: Positive -> L2.Space := W.physical;
\definition injective: \forall (x,y: Positive) -> physical x = physical y -> x = y := W.injective;
\definition physicalBound[x: Positive]: R.Le (norm (physical x)) (norm x) := W.controlsPhysical x;
\definition fromL2[f: L2.Space]: Negative := Divide.value (U.forward f);
\definition negativeBound[f: L2.Space]: R.Le (norm (fromL2 f)) (norm f) :=
  R.leReplaceRight _ _ _ (trans!{Real.Real} _ _ _ (Laws.fieldMulOneLeft _) (U.norm f)) (Divide.bound (U.forward f));
\definition negativeInjective[f,g: L2.Space]: fromL2 f = fromL2 g -> f = g :=
  \fun (equal: _) => U.injective f g (W.frequencyInjective (U.forward f) (U.forward g) equal);
\module Schwartz;
\module Duality;
\module Density;
