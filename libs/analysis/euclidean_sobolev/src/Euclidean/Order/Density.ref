\import Fourier.Density[] \as Core;
\import \parent.Schwartz[] \as H;
\import change_of_variables.Euclidean[n := n].Compact[] \as Compact;
\import LE.Approximation[p := PA.two] \as Approximation;
\import L.Norm[p := PA.two] \as RealNorm;
\import L.Finite[p := PA.two] \as F;
\import L2.Complete[] \as Completion;
\import std.Set[].Quotient[A := L2.Representatives, Equivalent := L2.Equivalent] \as Q;
\import functional_analysis.Metric[Carrier := L2.Space] \as Metric;
\definition divided[a,b: LE.SmoothCompact]: S.Function := Core.complex (Compact.multiply a Bessel.inverseSmooth) (Compact.multiply b Bessel.inverseSmooth);
\definition preimage[a,b: LE.SmoothCompact]: S.Function := Transform.backward (divided a b);
\definition class[a,b: LE.SmoothCompact]: H.value (preimage a b) = Embedding.value (Core.complex a b) := \block {
  \let h: L2.Representatives := Embedding.representative (Core.complex a b) \then
  \let agrees: W.frequency (L2.ofFunction h) = Embedding.value (divided a b) := trans!{L2.Space} _ _ _ (Divide.onClass h)
    (L2.classPointwise _ _ (\fun (xi: Point) => trans!{C.Complex} _ _ _ (Scalars.realProduct _ _) (CL.ext _ _ (Laws.fieldMulComm _ _) (Laws.fieldMulComm _ _)))) \then
  \return injective _ _ (eq_reason_in!{L2.Space _
    "=" _ "by" { H.recovers (preimage a b) }
    "=" _ "by" { sym!{L2.Space} _ _ (U.inverseOnSchwartz (divided a b)) }
    "=" _ "by" { congr!{L2.Space L2.Space} U.backward _ _ (sym!{L2.Space} _ _ agrees) }
  })
};
\definition Approximable[x: L2.Space]: \Prop := \forall (epsilon: Real.Real) -> R.Lt Real.zero epsilon -> \exists ( f: S.Function \where R.Lt (Geometry.metric.distance (H.value f) x) epsilon );
\definition dense: \forall (x: L2.Space) -> Approximable x := Q.induction (\fun (x: L2.Space) => Approximable x)
  (\fun (f: L2.Representatives)(epsilon: Real.Real)(positive: _) => \block {
    \let h: Real.Real := Real.mul Real.half epsilon \then
    \let hp: R.Lt Real.zero h := Estimates.halfOfPositive epsilon positive \then
    \takefrom re: \Cast[LE.SmoothCompact] ({ re: LE.SmoothCompact \where R.Lt (RealNorm.metric.distance (Approximation.ofSmooth re) (F.ofFunction (L2.realPart f))) h }) \by Approximation.smoothDense (F.ofFunction (L2.realPart f)) h hp \then
    \takefrom im: \Cast[LE.SmoothCompact] ({ im: LE.SmoothCompact \where R.Lt (RealNorm.metric.distance (Approximation.ofSmooth im) (F.ofFunction (L2.imaginaryPart f))) h }) \by Approximation.smoothDense (F.ofFunction (L2.imaginaryPart f)) h hp \then
    \let s: S.Function := Core.complex re im \then
    \return Logic.existsIntro[S.Function, { s: S.Function \where R.Lt (Geometry.metric.distance (H.value s) (L2.ofFunction f)) epsilon }] (preimage re im)
      (R.ltReplaceLeft _ _ _ (sym!{Real.Real} _ _ (congr!{L2.Space Real.Real} (\fun (z: L2.Space) => Geometry.metric.distance z (L2.ofFunction f)) _ _ (class re im))) (R.leLtTrans _ _ _ (Completion.distanceComponents (Embedding.value s) (L2.ofFunction f))
        (R.ltReplaceRight _ (Real.add h h) epsilon (Estimates.halfTwice epsilon)
          (Estimates.addLt _ _ _ _
            (R.ltReplaceLeft _ _ _ (sym!{Real.Real} _ _ (congr!{F.Space F.Space Real.Real} RealNorm.metric.distance _ _ _ _ (Core.realClass re im) (Completion.realOnClass f)))
              (\bysub(LE.SmoothCompact, { re: LE.SmoothCompact \where R.Lt (RealNorm.metric.distance (Approximation.ofSmooth re) (F.ofFunction (L2.realPart f))) h }, re)))
            (R.ltReplaceLeft _ _ _ (sym!{Real.Real} _ _ (congr!{F.Space F.Space Real.Real} RealNorm.metric.distance _ _ _ _ (Core.imaginaryClass re im) (Completion.imaginaryOnClass f)))
              (\bysub(LE.SmoothCompact, { im: LE.SmoothCompact \where R.Lt (RealNorm.metric.distance (Approximation.ofSmooth im) (F.ofFunction (L2.imaginaryPart f))) h }, im)))))))
  });
\import Real.Geometric[q := Real.half] \as Dyadic;
\import functional_analysis.ScalarLimits[] \as Limits;
\definition Sequence: \Set := N.Nat^ -> S.Function;
\definition sequenceExists[x: L2.Space]: \exists ( s: Sequence \where Metric.Converges Geometry.metric (\fun (k: N.Nat^) => H.value (s k)) x ) := \block {
  \takefrom choose: \forall (k: N.Nat^) -> \Cast[S.Function] ({ f: S.Function \where R.Lt (Geometry.metric.distance (H.value f) x) (Dyadic.value k) }) \by
    \axiom:classicalIndefiniteChoice(N.Nat^, (\fun (k: N.Nat^) => \Cast[S.Function] ({ f: S.Function \where R.Lt (Geometry.metric.distance (H.value f) x) (Dyadic.value k) })),
      (\fun (k: N.Nat^) => dense x (Dyadic.value k) (Limits.dyadicPositive k))) \then
  \let s: Sequence := \fun (k: N.Nat^) => choose k \then
  \return Logic.existsIntro[Sequence, { s: Sequence \where Metric.Converges Geometry.metric (\fun (k: N.Nat^) => H.value (s k)) x }] s
    (\fun (epsilon: Real.Real)(positive: _) => \block {
      \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where \forall (j: N.Nat^) -> Nat.Le k j -> R.Lt (Dyadic.value j) epsilon }) \by Limits.dyadicSmall epsilon positive \then
      \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Metric.LimitControl Geometry.metric (\fun (k: N.Nat^) => H.value (s k)) x epsilon k }] k
        (\fun (j: N.Nat^)(later: _) => RO.ltTrans _ _ _
          (\bysub(S.Function, { f: S.Function \where R.Lt (Geometry.metric.distance (H.value f) x) (Dyadic.value j) }, choose j))
          ((\bysub(N.Nat^, { k: N.Nat^ \where \forall (j: N.Nat^) -> Nat.Le k j -> R.Lt (Dyadic.value j) epsilon }, k)) j later))
    })
};
