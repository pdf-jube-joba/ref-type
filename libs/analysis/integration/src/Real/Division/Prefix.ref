/* Clipped lengths telescope, including across the cell containing the endpoint. */
\import real.Analysis[].Algebra[] \as Algebra;
\use Logic.either;
\definition positive[x: Real]: Real := Metric.max x zero;
\definition positiveNonnegative[x: Real]: R.Le zero (positive x) := Metric.maxRight x zero;
\definition positiveOfNonnegative[x: Real]: R.Le zero x -> positive x = x := Metric.maxOfGe x zero;
\definition positiveOfNonpositive[x: Real]: R.Le x zero -> positive x = zero := Metric.maxOfLe x zero;
\definition positiveMonotone[x, y: Real]: R.Le x y -> R.Le (positive x) (positive y) :=
  \fun (ordered: _) => Metric.maxMonotone x zero y zero ordered (R.leRefl zero);
\definition differenceNonpositive[x, y: Real]: R.Le x y -> R.Le (sub x y) zero :=
  \fun (ordered: _) => R.leReplaceRight (sub x y) (sub y y) zero (Laws.addNegRight y)
    (Laws.addMonotoneRight x y (neg y) ordered);
\definition weight[t, a, b: Real]: Real := sub (positive (sub t a)) (positive (sub t b));
\definition weightSplit[t, a, m, b: Real]: add (weight t a m) (weight t m b) = weight t a b :=
  Metric.subTriangle (positive (sub t a)) (positive (sub t m)) (positive (sub t b));
\definition weightNonnegative[t, a, b: Real]: R.Le a b -> R.Le zero (weight t a b) :=
  \fun (ordered: _) => Metric.subNonnegative _ _
    (positiveMonotone (sub t b) (sub t a) (Laws.addMonotoneLeft (neg b) (neg a) t (Laws.negAntitone a b ordered)));
\definition weightBefore[t, a, b: Real]: R.Le t a -> R.Le a b -> weight t a b = zero :=
  \fun (before: _)(ordered: _) => trans!{Real} _ _ _
    (congr2!{Real Real Real} sub _ _ _ _
      (positiveOfNonpositive (sub t a) (differenceNonpositive t a before))
      (positiveOfNonpositive (sub t b) (differenceNonpositive t b (R.leTrans t a b before ordered))))
    (Laws.addNegRight zero);
\definition weightInside[t, a, b: Real]: R.Le a t -> R.Le t b -> weight t a b = sub t a :=
  \fun (left: _)(right: _) => trans!{Real} _ _ _
    (congr2!{Real Real Real} sub _ _ _ _
      (positiveOfNonnegative (sub t a) (Metric.subNonnegative t a left))
      (positiveOfNonpositive (sub t b) (differenceNonpositive t b right)))
    (trans!{Real} _ _ _ (congr!{Real Real} (add (sub t a)) _ _ (Laws.negZero)) (Laws.addZeroRight (sub t a)));
\definition weightAfter[t, a, b: Real]: R.Le a b -> R.Le b t -> weight t a b = sub b a :=
  \fun (ordered: _)(after: _) => eq_reason!{
    {weight t a b} "=" {sub (sub t a) (sub t b)} "by" {
      congr2!{Real Real Real} sub _ _ _ _
        (positiveOfNonnegative (sub t a) (Metric.subNonnegative t a (R.leTrans a b t ordered after)))
        (positiveOfNonnegative (sub t b) (Metric.subNonnegative t b after))}
    "=" {add (sub t a) (sub b t)} "by" {congr!{Real Real} (add (sub t a)) _ _ (Algebra.negSub t b)}
    "=" {add (sub b t) (sub t a)} "by" {Laws.addComm (sub t a) (sub b t)}
    "=" {sub b a} "by" {Metric.subTriangle b t a}
  };
\definition weightBound[t, a, b: Real]: R.Le a b -> R.Le (weight t a b) (sub b a) :=
  \fun (ordered: _) => either!{{(Order.leTotal t a)} {R.Le (weight t a b) (sub b a)}
    {\fun (before: _) => R.leReplaceLeft zero (weight t a b) (sub b a)
      (sym!{Real} _ _ (weightBefore t a b before ordered)) (Metric.subNonnegative b a ordered)}
    {\fun (left: _) => either!{{(Order.leTotal t b)} {R.Le (weight t a b) (sub b a)}
      {\fun (right: _) => R.leReplaceLeft (sub t a) (weight t a b) (sub b a)
        (sym!{Real} _ _ (weightInside t a b left right)) (Laws.addMonotoneRight t b (neg a) right)}
      {\fun (after: _) => R.leReplaceLeft (sub b a) (weight t a b) (sub b a)
        (sym!{Real} _ _ (weightAfter t a b ordered after)) (R.leRefl (sub b a))}
    }}
  };
\definition weightMonotone[s, t, a, b: Real]: R.Le a b -> R.Le s t -> R.Le (weight s a b) (weight t a b) :=
  \fun (ordered: _)(st: _) => either!{{(Order.leTotal s a)} {R.Le (weight s a b) (weight t a b)}
    {\fun (before: _) => R.leReplaceLeft zero (weight s a b) (weight t a b)
      (sym!{Real} _ _ (weightBefore s a b before ordered)) (weightNonnegative t a b ordered)}
    {\fun (as: _) => either!{{(Order.leTotal b t)} {R.Le (weight s a b) (weight t a b)}
      {\fun (after: _) => R.leReplaceRight (weight s a b) (sub b a) (weight t a b)
        (sym!{Real} _ _ (weightAfter t a b ordered after)) (weightBound s a b ordered)}
      {\fun (tb: _) => R.leReplace (sub s a) (weight s a b) (sub t a) (weight t a b)
        (sym!{Real} _ _ (weightInside s a b as (R.leTrans s t b st tb)))
        (sym!{Real} _ _ (weightInside t a b (R.leTrans a s t as st) tb))
        (Laws.addMonotoneRight s t (neg a) st)}
    }}
  };
\definition value[f: Real -> Real][tags: Tags][t, a, b: Real]: Real :=
  \induction (tags: Tags) \return Real -> Real -> Real \with {
    | tag: \fun (x, a, b: Real) => mul (weight t a b) (f x)
    | split: \fun (left: Tags)(leftSum: Real -> Real -> Real)(right: Tags)(rightSum: Real -> Real -> Real)(a, b: Real) =>
      add (leftSum a (midpoint a b)) (rightSum (midpoint a b) b)
  } tags a b;
\definition constant[c: Real]: \forall (tags: Tags)(t, a, b: Real) -> value (\fun (x: Real) => c) tags t a b = mul (weight t a b) c :=
  \induction (tags: Tags) \return \forall (t, a, b: Real) -> value (\fun (x: Real) => c) tags t a b = mul (weight t a b) c \with {
    | tag: \fun (x, t, a, b: Real) => \refl(mul (weight t a b) c)
    | split: \fun (left: Tags)(hl: _)(right: Tags)(hr: _)(t, a, b: Real) => trans!{Real} _ _ _
      (congr2!{Real Real Real} add _ _ _ _ (hl t a (midpoint a b)) (hr t (midpoint a b) b))
      (trans!{Real} _ _ _ (sym!{Real} _ _ (Algebra.mulAddRight (weight t a (midpoint a b)) (weight t (midpoint a b) b) c))
        (congr!{Real Real} (\fun (w: Real) => mul w c) _ _ (weightSplit t a (midpoint a b) b)))
  };
\definition congruent[f, g: Real -> Real]:
  (\forall (x: Real) -> f x = g x) -> \forall (tags: Tags) -> \forall (t, a, b: Real) -> value f tags t a b = value g tags t a b :=
  \fun (same: _) => \induction (tags: Tags) \return \forall (t, a, b: Real) -> value f tags t a b = value g tags t a b \with {
    | tag: \fun (x, t, a, b: _) => congr!{Real Real} (mul (weight t a b)) _ _ (same x)
    | split: \fun (left: _) (ihLeft: _) (right: _) (ihRight: _) (t, a, b: _) =>
      congr2!{Real Real Real} add _ _ _ _ (ihLeft t a (midpoint a b)) (ihRight t (midpoint a b) b)
  };

\definition addition[f, g: Real -> Real]: \forall (tags: Tags) -> \forall (t, a, b: Real) ->
  value (\fun (x: Real) => add (f x) (g x)) tags t a b = add (value f tags t a b) (value g tags t a b) :=
  \induction (tags: Tags) \return \forall (t, a, b: Real) ->
    value (\fun (x: Real) => add (f x) (g x)) tags t a b = add (value f tags t a b) (value g tags t a b) \with {
    | tag: \fun (x, t, a, b: _) => Laws.fieldMulAdd (weight t a b) (f x) (g x)
    | split: \fun (left: _) (ihLeft: _) (right: _) (ihRight: _) (t, a, b: _) =>
      trans!{Real} _ _ _
        (congr2!{Real Real Real} add _ _ _ _ (ihLeft t a (midpoint a b)) (ihRight t (midpoint a b) b))
        (E.addShuffle (value f left t a (midpoint a b)) (value g left t a (midpoint a b))
          (value f right t (midpoint a b) b) (value g right t (midpoint a b) b))
  };

\definition before[f: Real -> Real]: \forall (tags: Tags)(t, a, b: Real) -> R.Le a b -> R.Le t a -> value f tags t a b = zero :=
  \induction (tags: Tags) \return \forall (t, a, b: Real) -> R.Le a b -> R.Le t a -> value f tags t a b = zero \with {
    | tag: \fun (x, t, a, b: Real)(ordered: _)(early: _) => trans!{Real} _ _ _
      (congr!{Real Real} (\fun (w: Real) => mul w (f x)) _ _ (weightBefore t a b early ordered)) (Laws.fieldMulZeroLeft (f x))
    | split: \fun (left: Tags)(hl: _)(right: Tags)(hr: _)(t, a, b: Real)(ordered: _)(early: _) => trans!{Real} _ _ _
      (congr2!{Real Real Real} add _ _ _ _ (hl t a (midpoint a b) (E.midpointLeft a b ordered) early)
        (hr t (midpoint a b) b (E.midpointRight a b ordered) (R.leTrans t a (midpoint a b) early (E.midpointLeft a b ordered))))
      (Laws.addZeroLeft zero)
  };
\definition after[f: Real -> Real]: \forall (tags: Tags)(t, a, b: Real) -> R.Le a b -> R.Le b t -> value f tags t a b = sum f tags a b :=
  \induction (tags: Tags) \return \forall (t, a, b: Real) -> R.Le a b -> R.Le b t -> value f tags t a b = sum f tags a b \with {
    | tag: \fun (x, t, a, b: Real)(ordered: _)(late: _) => congr!{Real Real} (\fun (w: Real) => mul w (f x)) _ _ (weightAfter t a b ordered late)
    | split: \fun (left: Tags)(hl: _)(right: Tags)(hr: _)(t, a, b: Real)(ordered: _)(late: _) =>
      congr2!{Real Real Real} add _ _ _ _
        (hl t a (midpoint a b) (E.midpointLeft a b ordered) (R.leTrans (midpoint a b) b t (E.midpointRight a b ordered) late))
        (hr t (midpoint a b) b (E.midpointRight a b ordered) late)
  };
\definition distanceUniform[f, g: Real -> Real]: \forall (tags: Tags)(t, a, b, bound: Real) -> R.Le a b -> Valid tags a b ->
  (\forall (x: Real) -> R.Le a x -> R.Le x b -> R.Le (distance (f x) (g x)) bound) ->
  R.Le (distance (value f tags t a b) (value g tags t a b)) (mul (weight t a b) bound) :=
  \induction (tags: Tags) \return \forall (t, a, b, bound: Real) -> R.Le a b -> Valid tags a b ->
    (\forall (x: Real) -> R.Le a x -> R.Le x b -> R.Le (distance (f x) (g x)) bound) ->
    R.Le (distance (value f tags t a b) (value g tags t a b)) (mul (weight t a b) bound) \with {
    | tag: \fun (x, t, a, b, bound: Real)(ordered: _)(valid: Logic.And[R.Le a x, R.Le x b])(pointwise: _) => R.leTrans _ _ _
      (E.distanceMul (weight t a b) (f x) (g x) (weightNonnegative t a b ordered))
      (E.mulMonotone (weight t a b) (distance (f x) (g x)) bound (weightNonnegative t a b ordered) (pointwise x valid.left valid.right))
    | split: \fun (left: Tags)(hl: _)(right: Tags)(hr: _)(t, a, b, bound: Real)(ordered: _)
        (valid: Logic.And[Valid left a (midpoint a b), Valid right (midpoint a b) b])(pointwise: _) => R.leTrans _ _ _
      (E.distanceAdd (value f left t a (midpoint a b)) (value f right t (midpoint a b) b)
        (value g left t a (midpoint a b)) (value g right t (midpoint a b) b))
      (R.leReplaceRight _ (add (mul (weight t a (midpoint a b)) bound) (mul (weight t (midpoint a b) b) bound)) (mul (weight t a b) bound)
        (trans!{Real} _ _ _ (sym!{Real} _ _ (Algebra.mulAddRight (weight t a (midpoint a b)) (weight t (midpoint a b) b) bound))
          (congr!{Real Real} (\fun (w: Real) => mul w bound) _ _ (weightSplit t a (midpoint a b) b)))
        (E.addLe _ _ _ _
          (hl t a (midpoint a b) bound (E.midpointLeft a b ordered) valid.left
            (\fun (x: Real)(ax: _)(xm: _) => pointwise x ax (R.leTrans x (midpoint a b) b xm (E.midpointRight a b ordered))))
          (hr t (midpoint a b) b bound (E.midpointRight a b ordered) valid.right
            (\fun (x: Real)(mx: _)(xb: _) => pointwise x (R.leTrans a (midpoint a b) x (E.midpointLeft a b ordered) mx) xb))))
  };
\module Refinement;
\module Increment;

