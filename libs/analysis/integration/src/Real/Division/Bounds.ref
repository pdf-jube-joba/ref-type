\import real.Analysis[].Algebra[] \as Algebra;
\definition sumScale[c: Real][f: Real -> Real]: \forall (tags: Tags)(a, b: Real) ->
  sum (\fun (x: Real) => mul c (f x)) tags a b = mul c (sum f tags a b) :=
  \induction (tags: Tags) \return \forall (a, b: Real) -> sum (\fun (x: Real) => mul c (f x)) tags a b = mul c (sum f tags a b) \with {
    | tag: \fun (x, a, b: Real) => Algebra.mulSwap (sub b a) c (f x)
    | split: \fun (left: Tags)(hl: _)(right: Tags)(hr: _)(a, b: Real) => trans!{Real} _ _ _
      (congr2!{Real Real Real} add _ _ _ _ (hl a (midpoint a b)) (hr (midpoint a b) b))
      (sym!{Real} _ _ (Laws.fieldMulAdd c (sum f left a (midpoint a b)) (sum f right (midpoint a b) b)))
  };
\definition sumDistanceUniform: \forall (f, g: Real -> Real)(tags: Tags)(a, b, bound: Real) -> R.Le a b -> Valid tags a b ->
  (\forall (x: Real) -> R.Le a x -> R.Le x b -> R.Le (distance (f x) (g x)) bound) ->
  R.Le (distance (sum f tags a b) (sum g tags a b)) (mul (sub b a) bound) :=
  \fun (f, g: Real -> Real)(tags: Tags)(a, b, bound: Real)(ordered: _)(valid: _)(pointwise: _) =>
    R.leTrans _ _ _ (sumDistance f g tags a b ordered)
      (R.leReplaceRight _ (sum (\fun (x: Real) => bound) tags a b) (mul (sub b a) bound) (sumConstant bound tags a b)
        (sumMonotone (\fun (x: Real) => distance (f x) (g x)) (\fun (x: Real) => bound) tags a b ordered valid pointwise));
\definition sumBound: \forall (f: Real -> Real)(tags: Tags)(a, b, bound: Real) -> R.Le a b -> Valid tags a b ->
  (\forall (x: Real) -> R.Le a x -> R.Le x b -> R.Le (distance (f x) zero) bound) ->
  R.Le (distance (sum f tags a b) zero) (mul (sub b a) bound) :=
  \fun (f: Real -> Real)(tags: Tags)(a, b, bound: Real)(ordered: _)(valid: _)(pointwise: _) => R.leReplaceLeft
    (distance (sum f tags a b) (sum (\fun (x: Real) => zero) tags a b)) (distance (sum f tags a b) zero) _
    (congr!{Real Real} (distance (sum f tags a b)) _ _ (sumZero tags a b))
    (sumDistanceUniform f (\fun (x: Real) => zero) tags a b bound ordered valid pointwise);
\definition intervalDistance: \forall (a, b, x, y: Real) -> R.Le a x -> R.Le x b -> R.Le a y -> R.Le y b -> R.Le (distance x y) (sub b a) :=
  \fun (a, b, x, y: Real)(ax: _)(xb: _)(ay: _)(yb: _) => Metric.maxLeast (sub x y) (sub y x) (sub b a)
    (E.addLe x (neg y) b (neg a) xb (Laws.negAntitone a y ay))
    (E.addLe y (neg x) b (neg a) yb (Laws.negAntitone a x ax));
\definition Oscillation[f: Real -> Real][a, b, delta, bound: Real]: \Prop :=
  \forall (x, y: Real) -> R.Le a x -> R.Le x b -> R.Le a y -> R.Le y b -> R.Lt (distance x y) delta -> R.Le (distance (f x) (f y)) bound;
\definition oscillationLeft: \forall (f: Real -> Real)(a, b, delta, bound: Real) -> R.Le a b -> Oscillation f a b delta bound -> Oscillation f a (midpoint a b) delta bound :=
  \fun (f: Real -> Real)(a, b, delta, bound: Real)(ordered: _)(oscillation: _)(x, y: Real)(ax: _)(xm: _)(ay: _)(ym: _) =>
    oscillation x y ax (R.leTrans x (midpoint a b) b xm (E.midpointRight a b ordered)) ay (R.leTrans y (midpoint a b) b ym (E.midpointRight a b ordered));
\definition oscillationRight: \forall (f: Real -> Real)(a, b, delta, bound: Real) -> R.Le a b -> Oscillation f a b delta bound -> Oscillation f (midpoint a b) b delta bound :=
  \fun (f: Real -> Real)(a, b, delta, bound: Real)(ordered: _)(oscillation: _)(x, y: Real)(mx: _)(xb: _)(my: _)(yb: _) =>
    oscillation x y (R.leTrans a (midpoint a b) x (E.midpointLeft a b ordered) mx) xb (R.leTrans a (midpoint a b) y (E.midpointLeft a b ordered) my) yb;
