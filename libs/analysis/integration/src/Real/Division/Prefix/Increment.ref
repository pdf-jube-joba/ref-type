\use std.Logic[].Equality[].eq_reason_in;
/* Increments of the clipped piecewise linear sums. */
\import \parent.\parent.Mesh[] \as Mesh;
\definition delta[s, t, a, b: Real]: Real := sub (weight t a b) (weight s a b);
\definition nonnegative[s, t, a, b: Real]: R.Le a b -> R.Le s t -> R.Le zero (delta s t a b) :=
  \fun (ordered: _)(st: _) => Metric.subNonnegative _ _ (weightMonotone s t a b ordered st);
\definition split[s, t, a, m, b: Real]: add (delta s t a m) (delta s t m b) = delta s t a b :=
  trans!{Real} _ _ _
    (sym!{Real} _ _ (Algebra.subAdd (weight t a m) (weight t m b) (weight s a m) (weight s m b)))
    (congr!{Real Real Real} sub _ _ _ _ (weightSplit t a m b) (weightSplit s a m b));
\definition before[s, t, a, b: Real]: R.Le a b -> R.Le s t -> R.Le t a -> delta s t a b = zero :=
  \fun (ordered: _)(st: _)(early: _) => trans!{Real} _ _ _
    (congr!{Real Real Real} sub _ _ _ _ (weightBefore t a b early ordered) (weightBefore s a b (R.leTrans s t a st early) ordered))
    (Laws.addNegRight zero);
\definition after[s, t, a, b: Real]: R.Le a b -> R.Le s t -> R.Le b s -> delta s t a b = zero :=
  \fun (ordered: _)(st: _)(late: _) => trans!{Real} _ _ _
    (congr!{Real Real Real} sub _ _ _ _ (weightAfter t a b ordered (R.leTrans b s t late st)) (weightAfter s a b ordered late))
    (Laws.addNegRight (sub b a));
\definition inside[s, t, a, b: Real]: R.Le a s -> R.Le s t -> R.Le t b -> delta s t a b = sub t s :=
  \fun (as: _)(st: _)(tb: _) => eq_reason_in!{Real _
    "=" _ "by" { congr!{Real Real Real} sub _ _ _ _ (weightInside t a b (R.leTrans a s t as st) tb)
      (weightInside s a b as (R.leTrans s t b st tb)) }
    "=" _ "by" { congr!{Real Real} (add (sub t a)) _ _ (Algebra.negSub s a) }
    "=" _ "by" { Laws.addAssoc t (neg a) (sub a s) }
    "=" _ "by" { congr!{Real Real} (add t) _ _
          (eq_reason_in!{Real _
            "=" _ "by" { sym!{Real} _ _ (Laws.addAssoc (neg a) a (neg s)) }
            "=" _ "by" { congr!{Real Real} (\fun (x: Real) => add x (neg s)) _ _ (Laws.addNegLeft a) }
            "=" _ "by" { Laws.addZeroLeft (neg s) }
          }) }
    "=" _ "by" { \refl(sub t s) }
  };
\definition sum[f: Real -> Real][tags: Tags][s, t, a, b: Real]: Real :=
  \induction (tags: Tags) \return Real -> Real -> Real \with {
    | tag: \fun (x, a, b: Real) => mul (delta s t a b) (f x)
    | split: \fun (left: Tags)(hl: Real -> Real -> Real)(right: Tags)(hr: Real -> Real -> Real)(a, b: Real) =>
      add (hl a (midpoint a b)) (hr (midpoint a b) b)
  } tags a b;
\definition difference[f: Real -> Real]: \forall (tags: Tags)(s, t, a, b: Real) -> sum f tags s t a b = sub (value f tags t a b) (value f tags s a b) :=
  \induction (tags: Tags) \return \forall (s, t, a, b: Real) -> sum f tags s t a b = sub (value f tags t a b) (value f tags s a b) \with {
    | tag: \fun (x, s, t, a, b: Real) => Algebra.subMul (weight t a b) (weight s a b) (f x)
    | split: \fun (left: Tags)(hl: _)(right: Tags)(hr: _)(s, t, a, b: Real) => trans!{Real} _ _ _
      (congr!{Real Real Real} add _ _ _ _ (hl s t a (midpoint a b)) (hr s t (midpoint a b) b))
      (sym!{Real} _ _ (Algebra.subAdd (value f left t a (midpoint a b)) (value f right t (midpoint a b) b)
        (value f left s a (midpoint a b)) (value f right s (midpoint a b) b)))
  };
\definition Slopes[f: Real -> Real][c, bound: Real][tags: Tags][s, t, a, b: Real]: \Prop :=
  \induction (tags: Tags) \return Real -> Real -> \Prop \with {
    | tag: \fun (x, a, b: Real) => R.Le a t -> R.Le s b -> R.Le (distance (f x) c) bound
    | split: \fun (left: Tags)(hl: Real -> Real -> \Prop)(right: Tags)(hr: Real -> Real -> \Prop)(a, b: Real) =>
      Logic.And[hl a (midpoint a b), hr (midpoint a b) b]
  } tags a b;
\definition overlapNear[x, z, s, t, a, b, radius: Real]: R.Le a z -> R.Le z b -> R.Le a t -> R.Le s b ->
  R.Lt (sub b a) radius -> R.Lt (distance s x) radius -> R.Lt (distance t x) radius -> R.Lt (distance z x) (add radius radius) :=
  \fun (az: _)(zb: _)(at: _)(sb: _)(width: _)(sx: _)(tx: _) => Metric.maxLt (sub z x) (sub x z) (add radius radius)
    (R.leLtTrans _ _ _
      (R.leTrans (sub z x) (sub b x) (add (sub b a) (distance t x))
        (Laws.addMonotoneRight z b (neg x) zb)
        (R.leReplaceLeft (add (sub b a) (sub a x)) (sub b x) (add (sub b a) (distance t x)) (Metric.subTriangle b a x)
          (Laws.addMonotoneLeft (sub a x) (distance t x) (sub b a)
            (R.leTrans (sub a x) (sub t x) (distance t x) (Laws.addMonotoneRight a t (neg x) at) (Metric.maxLeft (sub t x) (sub x t))))))
      (E.addLt (sub b a) (distance t x) radius radius width tx))
    (R.leLtTrans _ _ _
      (R.leTrans (sub x z) (sub x a) (add (distance s x) (sub b a))
        (Laws.addMonotoneLeft (neg z) (neg a) x (Laws.negAntitone a z az))
        (R.leReplaceLeft (add (sub x b) (sub b a)) (sub x a) (add (distance s x) (sub b a)) (Metric.subTriangle x b a)
          (Laws.addMonotoneRight (sub x b) (distance s x) (sub b a)
            (R.leTrans (sub x b) (sub x s) (distance s x)
              (Laws.addMonotoneLeft (neg b) (neg s) x (Laws.negAntitone s b sb)) (Metric.maxRight (sub s x) (sub x s))))))
      (E.addLt (distance s x) (sub b a) radius radius sx width));
\definition nearSlopes[f: Real -> Real]: \forall (tags: Tags)(x, s, t, a, b, radius, bound: Real) ->
  R.Le a b -> Valid tags a b -> Mesh.Fine tags a b radius -> R.Lt (distance s x) radius -> R.Lt (distance t x) radius ->
  (\forall (z: Real) -> R.Le a z -> R.Le z b -> R.Lt (distance z x) (add radius radius) -> R.Le (distance (f z) (f x)) bound) ->
  Slopes f (f x) bound tags s t a b :=
  \induction (tags: Tags) \return \forall (x, s, t, a, b, radius, bound: Real) ->
    R.Le a b -> Valid tags a b -> Mesh.Fine tags a b radius -> R.Lt (distance s x) radius -> R.Lt (distance t x) radius ->
    (\forall (z: Real) -> R.Le a z -> R.Le z b -> R.Lt (distance z x) (add radius radius) -> R.Le (distance (f z) (f x)) bound) ->
    Slopes f (f x) bound tags s t a b \with {
    | tag: \fun (z, x, s, t, a, b, radius, bound: Real)(ordered: _)(valid: Logic.And[R.Le a z, R.Le z b])(fine: _)(sx: _)(tx: _)(near: _)(at: _)(sb: _) =>
      near z valid.left valid.right (overlapNear x z s t a b radius valid.left valid.right at sb fine sx tx)
    | split: \fun (left: Tags)(hl: _)(right: Tags)(hr: _)(x, s, t, a, b, radius, bound: Real)(ordered: _)
        (valid: Logic.And[Valid left a (midpoint a b), Valid right (midpoint a b) b])
        (fine: Logic.And[Mesh.Fine left a (midpoint a b) radius, Mesh.Fine right (midpoint a b) b radius])(sx: _)(tx: _)(near: _) => Logic.And[_, _]::#
      (hl x s t a (midpoint a b) radius bound (E.midpointLeft a b ordered) valid.left fine.left sx tx
        (\fun (z: Real)(az: _)(zm: _)(zx: _) => near z az (R.leTrans z (midpoint a b) b zm (E.midpointRight a b ordered)) zx))
      (hr x s t (midpoint a b) b radius bound (E.midpointRight a b ordered) valid.right fine.right sx tx
        (\fun (z: Real)(mz: _)(zb: _)(zx: _) => near z (R.leTrans a (midpoint a b) z (E.midpointLeft a b ordered) mz) zb zx))
  };
\definition zeroWeightBound[w, x, c, bound: Real]: w = zero -> R.Le zero bound -> R.Le (distance (mul w x) (mul w c)) (mul w bound) :=
  \fun (isZero: _)(unused: _) => \idelim zero = w \with z: Real => R.Le (distance (mul z x) (mul z c)) (mul z bound) \by {
    base: R.leReplace zero (distance (mul zero x) (mul zero c)) zero (mul zero bound)
      (sym!{Real} _ _ (trans!{Real} _ _ _
        (congr!{Real Real Real} distance _ _ _ _ (Laws.fieldMulZeroLeft x) (Laws.fieldMulZeroLeft c)) (Metric.distanceSelf zero)))
      (sym!{Real} _ _ (Laws.fieldMulZeroLeft bound)) (R.leRefl zero),
    equality: sym!{Real} _ _ isZero
  };
\definition globalSlopes[f: Real -> Real]: \forall (tags: Tags)(s, t, a, b, c, bound: Real) -> R.Le a b -> Valid tags a b ->
  (\forall (z: Real) -> R.Le a z -> R.Le z b -> R.Le (distance (f z) c) bound) -> Slopes f c bound tags s t a b :=
  \induction (tags: Tags) \return \forall (s, t, a, b, c, bound: Real) -> R.Le a b -> Valid tags a b ->
    (\forall (z: Real) -> R.Le a z -> R.Le z b -> R.Le (distance (f z) c) bound) -> Slopes f c bound tags s t a b \with {
    | tag: \fun (z, s, t, a, b, c, bound: Real)(ordered: _)(valid: Logic.And[R.Le a z, R.Le z b])(pointwise: _)(unusedLeft: _)(unusedRight: _) =>
      pointwise z valid.left valid.right
    | split: \fun (left: Tags)(hl: _)(right: Tags)(hr: _)(s, t, a, b, c, bound: Real)(ordered: _)
        (valid: Logic.And[Valid left a (midpoint a b), Valid right (midpoint a b) b])(pointwise: _) => Logic.And[_, _]::#
      (hl s t a (midpoint a b) c bound (E.midpointLeft a b ordered) valid.left
        (\fun (z: Real)(az: _)(zm: _) => pointwise z az (R.leTrans z (midpoint a b) b zm (E.midpointRight a b ordered))))
      (hr s t (midpoint a b) b c bound (E.midpointRight a b ordered) valid.right
        (\fun (z: Real)(mz: _)(zb: _) => pointwise z (R.leTrans a (midpoint a b) z (E.midpointLeft a b ordered) mz) zb))
  };
\definition estimate[f: Real -> Real]: \forall (tags: Tags)(s, t, a, b, c, bound: Real) -> R.Le a b -> R.Le s t -> R.Le zero bound -> Slopes f c bound tags s t a b ->
  R.Le (distance (sum f tags s t a b) (mul (delta s t a b) c)) (mul (delta s t a b) bound) :=
  \induction (tags: Tags) \return \forall (s, t, a, b, c, bound: Real) -> R.Le a b -> R.Le s t -> R.Le zero bound -> Slopes f c bound tags s t a b ->
    R.Le (distance (sum f tags s t a b) (mul (delta s t a b) c)) (mul (delta s t a b) bound) \with {
    | tag: \fun (x, s, t, a, b, c, bound: Real)(ordered: _)(st: _)(positive: _)(slopes: Slopes f c bound (Tags::tag x) s t a b) =>
      either!{{(Order.leTotal t a)} {R.Le (distance (mul (delta s t a b) (f x)) (mul (delta s t a b) c)) (mul (delta s t a b) bound)}
        {\fun (early: _) => zeroWeightBound (delta s t a b) (f x) c bound (before s t a b ordered st early) positive}
        {\fun (at: _) => either!{{(Order.leTotal b s)} {R.Le (distance (mul (delta s t a b) (f x)) (mul (delta s t a b) c)) (mul (delta s t a b) bound)}
          {\fun (late: _) => zeroWeightBound (delta s t a b) (f x) c bound (after s t a b ordered st late) positive}
          {\fun (sb: _) => R.leTrans _ _ _ (E.distanceMul (delta s t a b) (f x) c (nonnegative s t a b ordered st))
            (E.mulMonotone (delta s t a b) (distance (f x) c) bound (nonnegative s t a b ordered st) (slopes at sb))}
        }}
      }
    | split: \fun (left: Tags)(hl: _)(right: Tags)(hr: _)(s, t, a, b, c, bound: Real)(ordered: _)(st: _)(positive: _)
        (slopes: Logic.And[Slopes f c bound left s t a (midpoint a b), Slopes f c bound right s t (midpoint a b) b]) => \block {
      \let cSplit: add (mul (delta s t a (midpoint a b)) c) (mul (delta s t (midpoint a b) b) c) = mul (delta s t a b) c :=
        trans!{Real} _ _ _ (sym!{Real} _ _ (Algebra.mulAddRight (delta s t a (midpoint a b)) (delta s t (midpoint a b) b) c))
          (congr!{Real Real} (\fun (w: Real) => mul w c) _ _ (split s t a (midpoint a b) b)) \then
      \let bSplit: add (mul (delta s t a (midpoint a b)) bound) (mul (delta s t (midpoint a b) b) bound) = mul (delta s t a b) bound :=
        trans!{Real} _ _ _ (sym!{Real} _ _ (Algebra.mulAddRight (delta s t a (midpoint a b)) (delta s t (midpoint a b) b) bound))
          (congr!{Real Real} (\fun (w: Real) => mul w bound) _ _ (split s t a (midpoint a b) b)) \then
      \return R.leReplace
        (distance (add (sum f left s t a (midpoint a b)) (sum f right s t (midpoint a b) b))
          (add (mul (delta s t a (midpoint a b)) c) (mul (delta s t (midpoint a b) b) c)))
        (distance (sum f (Tags::split left right) s t a b) (mul (delta s t a b) c))
        (add (mul (delta s t a (midpoint a b)) bound) (mul (delta s t (midpoint a b) b) bound)) (mul (delta s t a b) bound)
        (congr!{Real Real} (distance (sum f (Tags::split left right) s t a b)) _ _ cSplit) bSplit
        (R.leTrans _ _ _ (E.distanceAdd (sum f left s t a (midpoint a b)) (sum f right s t (midpoint a b) b)
          (mul (delta s t a (midpoint a b)) c) (mul (delta s t (midpoint a b) b) c))
          (E.addLe _ _ _ _ (hl s t a (midpoint a b) c bound (E.midpointLeft a b ordered) st positive slopes.left)
            (hr s t (midpoint a b) b c bound (E.midpointRight a b ordered) st positive slopes.right)))
    }
  };
