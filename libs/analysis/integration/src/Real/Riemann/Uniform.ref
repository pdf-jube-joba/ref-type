\import \parent.Def[] \as Integral;
\import D.Bounds[] \as Bounds;
\import D.Mesh[] \as Mesh;
\import D.Refinement[] \as Refinement;
\import real.Analysis[].Estimates[].Product[] \as Product;
\import real.Analysis[].Sequence[] \as Sequence;
\structure Radius[f: Real -> Real, epsilon, delta: Real]: \Prop := {
  positive: R.Lt zero delta,
  oscillation: Bounds.Oscillation f a b delta epsilon,
};
\structure Function: \Set := {
  function: Real -> Real,
  bounded: Integral.Bounded function,
  uniform: \forall (epsilon: Real) -> R.Lt zero epsilon -> \exists ( delta: Real \where Radius[function, epsilon, delta] ),
};
\module Of(f: Function);
