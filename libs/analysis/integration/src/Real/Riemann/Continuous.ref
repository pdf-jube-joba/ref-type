\import \parent.Def[] \as Integral;
\import \parent.Uniform[] \as UniformIntegrals;
\import metric_spaces.RealLine[] \as Line;
\import metric_spaces.RealMetric[] \as NumericMetric;
\import metric_spaces.MetricSpace[Carrier := Real] \as Base;
\import Base.Subspace[S := Line.ClosedInterval a b] \as Submetric;
\import topology.Topology[Carrier := Real] \as Ambient;
\import Ambient.Subspace[S := Line.ClosedInterval a b] \as Subspace;
\import Subspace.Properties[] \as Properties;
\definition Point: \Set := \Cast[Real] (Line.ClosedInterval a b);
\import topology.Topology[Carrier := Point] \as Local;
\import metric_spaces.MetricSpace[Carrier := Point] \as Metrics;
\import Metrics.Topology[] \as MetricTopology;
\definition topology: Local.Topology := Subspace.topology Line.topology;
\definition metric: Metrics.Metric := Submetric.restrict NumericMetric.metric;
\definition compact: Local.IsCompact topology := Properties.compact Line.topology (Line.CompactIntervals[].intervalCompact a b);
\definition metricCompact: Local.IsCompact (MetricTopology.topology metric) :=
  \idelim topology = MetricTopology.topology metric \with t: Local.Topology => Local.IsCompact t \by {
    base: compact, equality: sym!{Local.Topology} _ _ (Submetric.topology NumericMetric.metric)
  };
\import topology.Continuity[A := Point, B := Real] \as Maps;
\definition restrict[f: Real -> Real]: Point -> Real := \fun (x: Point) => f x;
\definition IsContinuous[f: Real -> Real]: \Prop := Maps.Continuous topology Line.topology (restrict f);
\definition Function: \Set := \Cast[Real -> Real] ({ f: Real -> Real \where IsContinuous f });
\import metric_spaces.RealFunctions[A := Point] \as Functions;
\import Functions.Lattice[] \as Lattice;
\import Functions.Extrema[] \as Extrema;
\import Metrics.Compactness[].Uniform[B := Real] \as Uniform;
\module Of(f: Function);
