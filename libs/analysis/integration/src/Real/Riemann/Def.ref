\definition Bounded(f: Real -> Real): \Prop :=
  \exists { bound: Real \where \forall (x: Real) -> R.Le a x -> R.Le x b -> R.Le (distance (f x) zero) bound };

\definition Control(f: Real -> Real) (value, epsilon: Real) (threshold: N.Nat^): \Prop :=
  \forall (n: N.Nat^) -> Nat.Le threshold n -> \forall (tags: D.Tags) -> D.Level tags n -> D.Valid tags a b ->
    R.Lt (distance (D.sum f tags a b) value) epsilon;

\definition Approximates(f: Real -> Real) (value: Real): \Prop :=
  \forall (epsilon: Real) -> R.Lt zero epsilon -> \exists { threshold: N.Nat^ \where Control f value epsilon threshold };

\structure HasIntegral[f: Real -> Real, value: Real]: \Prop {
  bounded: Bounded f,
  approximation: Approximates f value,
}

\definition Integrable(f: Real -> Real): \Prop := \exists { value: Real \where HasIntegral[f, value] };

\structure Function: \Set {
  function: Real -> Real,
  integral: Real,
  hasIntegral: HasIntegral[function, integral],
}

\definition NormControl(f, g: Real -> Real) (epsilon: Real) (threshold: N.Nat^): \Prop :=
  \forall (n: N.Nat^) -> Nat.Le threshold n -> \forall (tags: D.Tags) -> D.Level tags n -> D.Valid tags a b ->
    R.Lt (D.normSum f g tags a b) epsilon;

\definition SmallL1(f, g: Real -> Real) (epsilon: Real): \Prop :=
  \exists { threshold: N.Nat^ \where NormControl f g epsilon threshold };
