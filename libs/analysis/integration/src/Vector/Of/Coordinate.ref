\import ScalarFunctions.Of[f := component i] \as Scalar;
\definition primitive: Real -> Real := Scalar.primitive;
\definition primitiveLeft: primitive a = Scalars.zero := Scalar.primitiveLeft;
\definition primitiveRight: primitive b = Scalar.value := Scalar.primitiveRight;
\definition primitiveContinuous: ScalarFunctions.IsContinuous primitive := Scalar.primitiveContinuous;
\definition uniform: UniformScalars.Function := Scalar.asUniform;
\import calculus.Real[].Derivative[].Def[] \as Derivatives;
\definition fundamentalTheorem: \forall (t: Real) -> R.Lt a t -> R.Lt t b -> Derivatives.HasDerivativeAt primitive t (f t i) := Scalar.fundamentalTheorem;
\import UniformScalars.Of[f := uniform] \as UniformIntegral;
\import UniformIntegral.Fundamental[] \as Fundamental;
\import Scalars.Division[].Prefix[] \as Prefix;
\definition bound[t, bound: Real]:
  (\forall (s: Real) -> R.Le a s -> R.Le s b -> R.Le (Scalars.distance (f s i) Scalars.zero) bound) ->
  R.Le (Scalars.distance (primitive t) Scalars.zero) (Scalars.mul (Prefix.weight t a b) bound) := UniformIntegral.Primitive[t := t].bound bound;
\definition lipschitz[s, t, bound: Real]: R.Le a s -> R.Le s b -> R.Le a t -> R.Le t b -> R.Le Scalars.zero bound ->
  (\forall (u: Real) -> R.Le a u -> R.Le u b -> R.Le (Scalars.distance (f u i) Scalars.zero) bound) ->
  R.Le (Scalars.distance (primitive t) (primitive s)) (Scalars.mul (Scalars.distance t s) bound) := Fundamental.lipschitz s t bound;
