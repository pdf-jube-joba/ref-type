\import Left.Coordinate[i := i] \as LeftCoordinate;
\import Right.Coordinate[i := i] \as RightCoordinate;
\import UniformScalars.Comparison[f := LeftCoordinate.uniform, g := RightCoordinate.uniform] \as Comparison;
\import Scalars.Division[].Prefix[] \as Prefix;
\definition primitiveBound[t, bound: Real]:
  (\forall (s: Real) -> R.Le a s -> R.Le s b -> R.Le (Scalars.distance (f s i) (g s i)) bound) ->
  R.Le (Scalars.distance (Left.primitive t i) (Right.primitive t i)) (Scalars.mul (Prefix.weight t a b) bound) := Comparison.primitiveBound t bound;
