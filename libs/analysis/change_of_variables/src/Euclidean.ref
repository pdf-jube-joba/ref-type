\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\use Equality.eq_reason_in;
\import real.Analysis[] \as Real;
\import Real.Algebra[] \as Algebra;
\import Real.Estimates[].Product[] \as Absolute;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import calculus.Maps[n := n, m := n] \as Maps;
\import calculus.Diffeomorphism[n := n, m := n] \as Diffeomorphisms;
\import euclidean_forms.Euclidean[n := n] \as Forms;
\import linear_algebra.Commutative[K := Real.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Real.Real Algebra.field] \as Spaces;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\import Spaces.FiniteCoordinates[n := n].Top[] \as Top;
\import Spaces.Linear[V := Vectors.Vector, W := Vectors.Vector, source := Vectors.space, target := Vectors.space] \as Linear;
\import matrix_invariants.Ring[K := Real.Real, scalars := std.Alg[].Field[].fieldAsCommutativeRing Real.Real Algebra.field].At[n := n] \as Matrix;
\import Matrix.Representation[] \as Representation;
\import Matrix.Operations[] \as MatrixOperations;
\import matrix_invariants.Field[K := Real.Real, field := Algebra.field].At[n := n] \as Inversion;
\import euclidean_measure.Euclidean[n := n] \as E;
\import E.MeasureConstruction[] \as Lebesgue;
\import functional_analysis.Measure[A := E.Point] \as M;
\import M.Integral[mu := Lebesgue.measure] \as I;
\definition Point: \Set := E.Point;
\module Jacobian(U, V: Open.OpenSet, f: Maps.Map U V);
\module TopForm(U, V: Open.OpenSet, f: Maps.Map U V);
\module Parameters;
\module Density(U, V: Open.OpenSet, f: Maps.Map U V);
\module Localization(U: Open.OpenSet);
\module Compact;
\module Diffeomorphism(U, V: Open.OpenSet, e: Diffeomorphisms.Diffeomorphism U V);
\module TopCoordinates(U: Open.OpenSet);
\module Decomposition(family: \Pow (\Pow Point), f: lp_spaces.Euclidean[n := n].SmoothCompact);
\module FiniteIntegral(family: N.Nat^ -> I.Representatives);
\module BorelCompact(f: lp_spaces.Euclidean[n := n].SmoothCompact);
