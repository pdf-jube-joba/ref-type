\definition sourceRepresentative: PI.Representatives := \into[Sigma.Point -> Real.Real](sourceFunction, PI.Representatives) \by { sourceIntegrable };
\definition targetRepresentative: PI.Representatives := \into[Sigma.Point -> Real.Real](targetFunction, PI.Representatives) \by { targetIntegrable };
\definition theorem: PI.integral sourceRepresentative = PI.integral targetRepresentative :=
  \parent.Integrate[f := sourceRepresentative, g := targetRepresentative,
    sourceValues := \fun (x: A) (t: Real.Real) => \refl(source x t),
    targetValues := \fun (x: A) (t: Real.Real) => \refl(target x t)].theorem;
