\definition theorem: PI.integral f = PI.integral g := \block {
  \takefrom gg: Fubini.AEFubini[g] \by Fubini.fubini g \then
  \let pulled: A -> RI.Representatives := \fun (x: A) => LineFinite.Translate[a := a x, f := gg.sections x].representative \then
  \let pulledValues: \forall (x: A) -> Logic.Not (Sets.Member gg.exception x) -> \forall (t: Real.Real) -> pulled x t = f (Pair.pair A Real.Real x t) :=
    \fun (x: A) (outside: Logic.Not (Sets.Member gg.exception x)) (t: Real.Real) =>
      trans!{Real.Real} _ _ _ (gg.sectionValues x outside (Real.sub t (a x))) (sym!{Real.Real} _ _ (values x t)) \then
  \return \parent.Exchange[f := f, g := g, source := pulled,
    target := gg.sections, exception := gg.exception, sourceValues := pulledValues,
    targetValues := gg.sectionValues,
    sections := \fun (x: A) => LineFinite.Translate[a := a x, f := gg.sections x].integral].theorem
};
