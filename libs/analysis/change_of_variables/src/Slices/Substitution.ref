\definition input[x: A]: Integration.Riemann[interval := data.sourceInterval x].Continuous[].Function :=
  \root.Interval[interval := data.sourceInterval x].Substitution[target := data.targetInterval x, h := data.integrand x, g := data.map x, dg := data.derivative x].For[conditions := data.conditions x].input;
\definition source[x: A]: RI.Representatives := \root.Interval[interval := data.sourceInterval x].Lebesgue[f := input x].representative;
\definition target[x: A]: RI.Representatives := \root.Interval[interval := data.targetInterval x].Lebesgue[f := data.integrand x].representative;
\definition sections[x: A]: RI.integral (source x) = RI.integral (target x) :=
  \root.Interval[interval := data.sourceInterval x].Substitution[target := data.targetInterval x, h := data.integrand x, g := data.map x, dg := data.derivative x].For[conditions := data.conditions x].lebesgue;
\module Integrate(f, g: PI.Representatives,
  sourceValues: \forall (x: A) (y: Real.Real) -> source x y = f (Pair.pair A Real.Real x y),
  targetValues: \forall (x: A) (y: Real.Real) -> target x y = g (Pair.pair A Real.Real x y));
\definition sourceFunction[p: Sigma.Point]: Real.Real := source (Pair.first A Real.Real p) (Pair.second A Real.Real p);
\definition targetFunction[p: Sigma.Point]: Real.Real := target (Pair.first A Real.Real p) (Pair.second A Real.Real p);
\module Joint(sourceIntegrable: PI.Integrable sourceFunction, targetIntegrable: PI.Integrable targetFunction);
