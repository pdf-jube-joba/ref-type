\definition theorem: PI.integral f = PI.integral g :=
  \root.Slices[A := A, mu := mu, exhaustion := exhaustion].Exchange[f := f, g := g, source := source, target := target, exception := FiniteNull.empty,
    sourceValues := \fun (x: A) (_: Logic.Not (Sets.Member FiniteNull.empty x)) => sourceValues x,
    targetValues := \fun (x: A) (_: Logic.Not (Sets.Member FiniteNull.empty x)) => targetValues x,
    sections := sections].theorem;
