\definition section[x: A]: RI.NonnegativeMeasurable := RI.NonnegativeMeasurable {
  function := \fun (t: Real.Real) => g.function (Pair.pair A Real.Real x t),
  measurable := \fun (r: Real.Real) => Sigma.sectionMeasurable ({ p: Sigma.Point \where dedekind_reals.DedekindReal[].Lt r (g.function p) }) (g.measurable r) x,
  nonnegative := \fun (t: Real.Real) => g.nonnegative (Pair.pair A Real.Real x t),
};
\definition lower[x: A]: Fubini.sectionLower f x = Fubini.sectionLower g x := eq_reason_in!{LM.Value _
  "=" _ "by" { congr!{{Real.Real -> Real.Real} LM.Value} RI.lowerIntegral _ _ (\axiom:funext(
    (\fun (t: Real.Real) => f.function (Pair.pair A Real.Real x t)),
    (\fun (t: Real.Real) => g.function (Pair.pair A Real.Real x (Real.sub t (a x)))), values x)) }
  "=" _ "by" { LineMaps.On[map := LineFinite.translation (a x)].Nonnegative[f := section x].lower }
};
\definition theorem: PI.lowerIntegral f.function = PI.lowerIntegral g.function := eq_reason_in!{LM.Value _
  "=" _ "by" { Fubini.tonelli f }
  "=" _ "by" { congr!{{A -> LM.Value} LM.Value} Outer.lowerIntegral _ _ (\axiom:funext(Fubini.sectionLower f, Fubini.sectionLower g, lower)) }
  "=" _ "by" { sym!{LM.Value} _ _ (Fubini.tonelli g) }
};
