\definition theorem: R.Lt Real.zero c -> OpenLaw -> Values.Included (E.outer (forward S)) (M.scale c (E.outer S)) :=
  \fun (positive: _)(openLaw: _) => \block {
    \let w: M.Value := E.outer (forward S) \then
    \let reduced: M.Value := M.scale (Laws.fieldInv c) w \then
    \let lower: Values.Included reduced (E.outer S) := openLower S reduced
      (Values.scaleNonnegative (Laws.fieldInv c) w (Order.leOfLt _ _ (Absolute.invPositive c positive)) (E.outerNonnegative (forward S)))
      (\fun (U: \Pow Point)(opened: _)(contains: _)(r: Real.Real)(member: M.below reduced r) =>
        \idelim M.scale (Laws.fieldInv c) (M.scale c (E.outer U)) = E.outer U \with v: M.Value => M.below v r \by {
          base: Values.scaleMono (Laws.fieldInv c) w (M.scale c (E.outer U))
            (\fun (s: Real.Real)(inside: M.below w s) => \idelim E.outer (forward U) = M.scale c (E.outer U) \with v: M.Value => M.below v s \by {
              base: E.monotone (forward S) (forward U) (\fun (x: Point)(inS: _) => contains (h.backward x) inS) s inside,
              equality: openLaw U opened
            }) r member,
          equality: Scaling.scaleInverseLeft c (E.outer U) positive (E.outerNonnegative U)
        }) \then
    \return \fun (r: Real.Real)(member: M.below w r) => Values.scaleMono c reduced (E.outer S) lower r
      (\idelim w = M.scale c reduced \with v: M.Value => M.below v r \by {
        base: member, equality: sym!{M.Value} _ _ (Scaling.scaleInverseRight c w positive (E.outerNonnegative (forward S)))
      })
  };
