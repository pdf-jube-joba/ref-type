\import \parent.Inverse[] \as Inverse;
\import \parent.\parent.Permutation[p := inverse] \as Back;
\import Back.Measure[] \as BackMeasure;
\import product_integration.MeasureMap[A := Point, B := Point, source := Lebesgue.measure, target := Lebesgue.measure] \as MeasureMaps;
\definition preimageEqual[S: \Pow Point]: { x: Point \where Sets.Member S (point x) } = image Back.map S :=
  sym!{{\Pow Point}} _ _ (BackMeasure.imageEqual S);
\definition map: MeasureMaps.Data := MeasureMaps.Data {
  function := point,
  measurable := \fun (S: \Pow Point)(valid: _) => \idelim image Back.map S = { x: Point \where Sets.Member S (point x) } \with T: \Pow Point => M.Measurable Lebesgue.measure.sigma T \by {
    base: Back.measurable S valid, equality: sym!{{\Pow Point}} _ _ (preimageEqual S)
  },
  value := \fun (S: \Pow Point)(valid: _) => trans!{M.Value} _ _ _
    (congr!{{\Pow Point} M.Value} Lebesgue.measure.value _ _ (preimageEqual S)) (Back.measure S),
};
