\import topological_algebra.Coordinates[K := Real.Real, I := Fin.Fin n].Universal[A := Point] \as Components;
\import metric_spaces.RealLine[] \as Line;
\import topology.Continuity[A := Point, B := Point] \as Continuous;
\definition forwardContinuous: Continuous.Continuous Ambient.topology Ambient.topology point :=
  \fun (U: \Pow Point)(opened: _) => Components.continuous Ambient.topology Line.topology point
    (\fun (i: Fin.Fin n) => Ambient.coordinateContinuous (p.forward i)) U (Ambient.metricOpen U opened);
\definition backwardContinuous: Continuous.Continuous Ambient.topology Ambient.topology backpoint :=
  \fun (U: \Pow Point)(opened: _) => Components.continuous Ambient.topology Line.topology backpoint
    (\fun (i: Fin.Fin n) => Ambient.coordinateContinuous (p.backward i)) U (Ambient.metricOpen U opened);
\definition homeomorphism: Homeomorphisms.Homeomorphism[Ambient.topology, Ambient.topology] := Homeomorphisms.Homeomorphism[Ambient.topology, Ambient.topology] {
  forward := point, backward := backpoint,
  leftInverse := left, rightInverse := right,
  forwardContinuous := forwardContinuous, backwardContinuous := backwardContinuous,
};
