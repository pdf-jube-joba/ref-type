\import \parent.\parent.Permutation[p := inverse] \as Back;
\definition restores[S: \Pow Point]: Back.forward (forward S) = S := \axiom:setext(Back.forward (forward S), S,
  \fun (x: Point)(inside: Sets.Member (Back.forward (forward S)) x) => \idelim backpoint (point x) = x \with y: Point => Sets.Member S y \by {
    base: inside, equality: left x },
  \fun (x: Point)(inside: Sets.Member S x) => \idelim x = backpoint (point x) \with y: Point => Sets.Member S y \by {
    base: inside, equality: sym!{Point} _ _ (left x) });
\definition lower[S: \Pow Point]: Values.Included (E.outer S) (E.outer (forward S)) := \fun (r: Real.Real)(inside: M.below (E.outer S) r) => Back.upper (forward S) r
  (\idelim E.outer S = E.outer (Back.forward (forward S)) \with v: M.Value => M.below v r \by {
    base: inside, equality: sym!{M.Value} _ _ (congr!{{\Pow Point} M.Value} E.outer _ _ (restores S))
  });
