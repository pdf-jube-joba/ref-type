\import Euclidean.Compact[] \as Compact;
\import Euclidean.Diffeomorphism[U := Open.whole, V := Open.whole, e := equivalence] \as Change;
\import smooth_partitions.Euclidean[n := n] \as Supports;
\definition within: Sets.Subset (Supports.support f) Open.whole.points := \fun (x: Point)(member: Sets.Member (Supports.support f) x) => \refl(x);
\import Change.Compact[f := f, within := within] \as Pullback;
\import M.Integral[mu := Lebesgue.measure] \as Integral;
\import lp_spaces.On[A := Point, mu := Lebesgue.measure].One[].Norm[] \as Equality;
\import P.Integration[] \as Measure;
\import product_integration.MeasureMap[A := Point, B := Point, source := Lebesgue.measure, target := Lebesgue.measure].On[map := Measure.map].RealFunction[f := Compact.representative f] \as IntegralPullback;
\definition value: Functions.SmoothCompact := Pullback.value;
\definition representative: Integral.Representatives := Compact.representative value;
\definition at[x: Point]: value x = f (P.point x) := eq_reason_in!{Real.Real _
  "=" _ "by" { Pullback.inside (Whole.point x) }
  "=" _ "by" { congr!{Real.Real Real.Real} (\fun (c: Real.Real) => Real.mul c (f (P.point x))) _ _ (absolute (Whole.point x)) }
  "=" _ "by" { Laws.fieldMulOneLeft (f (P.point x)) }
};
\definition integral: Integral.integral representative = Integral.integral (Compact.representative f) := trans!{Real.Real} _ _ _
  (Equality.integralPointwise representative IntegralPullback.representative at) IntegralPullback.integral;
\definition weightedIntegral: Integral.integral (Compact.representative Pullback.value) = Integral.integral (Compact.representative f) := integral;
