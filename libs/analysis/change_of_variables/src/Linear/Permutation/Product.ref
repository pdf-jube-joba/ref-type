\definition theorem: E.product n (point a) = E.product n a := \block {
  \takefrom word: \Cast[Permutations.Word] ({ word: Permutations.Word \where Permutations.Represents p word }) \by Signs.decomposition p \then
  \let represents: Permutations.Represents p word := \bysub(Permutations.Word, { word: Permutations.Word \where Permutations.Represents p word }, word) \then
  \let reordered: Top.Arguments := \fun (i: Fin.Fin n) => Top.basisArguments (p.forward i) \then
  \let normalize: Top.volume reordered = Signs.sign word := trans!{Real.Real} _ _ _
    (Signs.transformation p word Top.volume Top.basisArguments represents)
    (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (Real.mul (Signs.sign word)) _ _ Top.normalized) (Algebra.mulOneRight (Signs.sign word))) \then
  \return Signs.signedInjective word (E.product n (point a)) (E.product n a) (eq_reason_in!{Real.Real _
    "=" _ "by" { Signs.signValue word (E.product n (point a)) }
    "=" _ "by" { Laws.fieldMulComm (Signs.sign word) (E.product n (point a)) }
    "=" _ "by" { congr!{Real.Real Real.Real} (Real.mul (E.product n (point a))) _ _ (sym!{Real.Real} _ _ normalize) }
    "=" _ "by" { sym!{Real.Real} _ _ (AllScalars.theorem n (Alternating.asMultilinear n Top.volume) (point a) reordered) }
    "=" _ "by" { Signs.transformation p word Top.volume (AllScalars.scaled n a Top.basisArguments) represents }
    "=" _ "by" { congr!{Real.Real Real.Real} (Real.mul (Signs.sign word)) _ _
      (trans!{Real.Real} _ _ _ (AllScalars.theorem n (Alternating.asMultilinear n Top.volume) a Top.basisArguments)
        (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (Real.mul (E.product n a)) _ _ Top.normalized) (Algebra.mulOneRight (E.product n a)))) }
    "=" _ "by" { sym!{Real.Real} _ _ (Signs.signValue word (E.product n a)) }
  })
};
