\import \root.LocalBox[n := n].At[U := D, a := a] \as Box;
\module With(h: Box.Radius);
\definition exists: \exists (p: Patch \where Sets.Member (image p) (Maps.apply U V e.forward (Open.inclusion D U included a))) := \block {
  \takefrom h: Box.Radius \by Box.exists \then
  \return \root.OneCoordinate[n := n].At[U := U, V := V, e := e].Global[fixed := fixed].Around[D := D, included := included, a := a, sign := sign].With[h := h].exists
};
