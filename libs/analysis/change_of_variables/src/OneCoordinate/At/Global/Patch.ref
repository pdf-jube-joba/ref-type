\import \root.OneCoordinate[n := n].At[U := U, V := V, e := e].Rectangle[base := p.base.points, interval := p.interval, contains := (laws p).contains, fixed := fixed] \as Rectangle;
\import Rectangle.Topology[openBase := BaseOpen.Topology[].open p.base] \as Topology;
\definition open: Sets.IsOpenIn Ambient.topology (image p) := Topology.imageOpen;
\definition included: Sets.Subset (image p) V.points := Rectangle.withinTarget;
\definition local: LocalFormula p := \fun (f: L.SmoothCompact)(supported: Sets.Subset (Functions.support f) (image p))(within: Sets.Subset (Functions.support f) V.points) =>
  Logic.orElim (Positive p (laws p).contains) (Negative p (laws p).contains)
    (I.integral (Euclidean.Diffeomorphism[U := U, V := V, e := e].Compact[f := f, within := within].representative) = I.integral (TargetIntegral.representative f))
    (laws p).sign
    (\fun (positive: Positive p (laws p).contains) => Rectangle.Compact[f := f, supported := supported].Positive[sign := positive].theorem)
    (\fun (negative: Negative p (laws p).contains) => Rectangle.Compact[f := f, supported := supported].Negative[sign := negative].theorem);
