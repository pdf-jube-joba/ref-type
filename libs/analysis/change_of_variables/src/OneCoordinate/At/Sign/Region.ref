\definition preimage: \Pow (Open.Carrier U) := { x: Open.Carrier U \where RealSets.Member values (partial x) };
\definition preimageOpen: LocalSets.IsOpenIn Domain.topology preimage := continuous values open;
\definition points: \Pow E.Point := Subspace.image preimage;
\definition pointsOpen: Sets.IsOpenIn Ambient.topology points := Subspace.imageOpen Ambient.topology (Topology.open U) preimage preimageOpen;
\definition domain: Open.OpenSet := Topology.ofOpen points pointsOpen;
\definition included: Open.Included domain U := Subspace.imageIncluded preimage;
\definition input[x: Open.Carrier domain]: Open.Carrier U := Open.inclusion domain U included x;
\definition inTarget[x: Open.Carrier domain]: RealSets.Member values (partial (input x)) :=
  Subspace.imageElim preimage x (RealSets.Member values (partial (input x)))
    (\fun (y: Open.Carrier U)(member: LocalSets.Member preimage y)(same: y = x) =>
      \idelim y = input x \with p: Open.Carrier U => RealSets.Member values (partial p) \by {
        base: member, equality: same
      }) (\bysub(E.Point, points, x));
\definition intro[a: Open.Carrier U]: RealSets.Member values (partial a) -> Sets.Member domain.points a := Subspace.imageMember preimage a;
