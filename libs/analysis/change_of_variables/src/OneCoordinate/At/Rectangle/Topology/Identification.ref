\definition theorem: liftedImage = image := \axiom:setext(liftedImage, image,
  \fun (y: E.Point)(inside: Sets.Member liftedImage y) => TargetOpen.imageElim localImage y (Sets.Member image y)
    (\fun (v: Open.Carrier V)(member: TargetSets.Member localImage v)(equal: v = y) =>
      Logic.existsIntro[Open.Carrier U, { x: Open.Carrier U \where Logic.And[Sets.Member region x, Maps.apply U V e.forward x = y] }] (Maps.apply V U e.backward v)
        (Logic.And[Sets.Member region (Maps.apply V U e.backward v), Maps.apply U V e.forward (Maps.apply V U e.backward v) = y]::# member
          (trans!{E.Point} _ _ _ (e.rightInverse v) equal))) inside,
  \fun (y: E.Point)(inside: Sets.Member image y) => \block {
    \takefrom x: \Cast[Open.Carrier U] ({ x: Open.Carrier U \where Logic.And[Sets.Member region x, Maps.apply U V e.forward x = y] }) \by inside \then
    \let data: Logic.And[Sets.Member region x, Maps.apply U V e.forward x = y] := \bysub(Open.Carrier U, { x: Open.Carrier U \where Logic.And[Sets.Member region x, Maps.apply U V e.forward x = y] }, x) \then
    \let member: TargetSets.Member localImage (Maps.apply U V e.forward x) :=
      \idelim x = Maps.apply V U e.backward (Maps.apply U V e.forward x) \with z: E.Point => Sets.Member region z \by {
        base: data.left, equality: sym!{E.Point} _ _ (e.leftInverse x)
      } \then
    \return \idelim Maps.apply U V e.forward x = y \with z: E.Point => Sets.Member liftedImage z \by {
      base: TargetOpen.imageMember localImage (Maps.apply U V e.forward x) member, equality: data.right
    }
  });
