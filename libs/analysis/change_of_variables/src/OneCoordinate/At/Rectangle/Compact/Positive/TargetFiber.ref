\definition intervalImage: Integration.Interval := Slices.imageInterval \parent.Parameters[].data x;
\import Integration.Riemann[interval := intervalImage].Continuous[] \as TargetContinuous;
\import \root.CurveRestriction[n := Index.total].On[U := Open.whole, h := global, a := join x intervalImage.left, i := pivot, interval := intervalImage] \as Curve;
\definition included: Curve.Contains := \fun (t: TargetContinuous.Point) => \refl(Points.replace (join x intervalImage.left) pivot t);
\import Curve.With[contains := included] \as Restricted;
\import Open.Analysis[].Curve[U := Open.whole, f := global, default := Real.zero, a := join x intervalImage.left, i := pivot] \as FullCurve;
\definition function: Real.Real -> Real.Real := Restricted.value;
\definition agrees: function = (\fun (t: Real.Real) => target (Pair.pair Base.Point Real.Real x t)) :=
  \axiom:funext(function, (\fun (t: Real.Real) => target (Pair.pair Base.Point Real.Real x t)), \fun (t: Real.Real) =>
    FullCurve.agreement t (\into[E.Point](join x t, Open.whole.points) \by { \refl(join x t) }) (sym!{E.Point} _ _ (replaceJoin x intervalImage.left t)));
\definition continuous: TargetContinuous.IsContinuous (\fun (t: Real.Real) => target (Pair.pair Base.Point Real.Real x t)) :=
  \idelim function = (\fun (t: Real.Real) => target (Pair.pair Base.Point Real.Real x t)) \with f: (Real.Real -> Real.Real) => TargetContinuous.IsContinuous f \by {
    base: \bysub(Real.Real -> Real.Real, TargetContinuous.Function, Restricted.value), equality: agrees };
