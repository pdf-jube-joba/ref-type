/* Open regions on which the distinguished partial derivative has a fixed sign. */
\import Open.Topology[] \as Topology;
\import Topology.Of[U := U] \as Domain;
\import Domain.Continuity[] \as Continuity;
\import Sets.Subspace[S := U.points].Open[] \as Subspace;
\import topology.Topology[Carrier := Open.Carrier U] \as LocalSets;
\import metric_spaces.RealLine[] \as RealTopology;
\import RealTopology.Rays[] \as Rays;
\definition continuous: metric_spaces.RealFunctions[A := Open.Carrier U].Continuous Domain.topology partial :=
  Continuity.topological partial (Smooth.Properties[].continuous U partial (Partial.partialSmooth U scalar pivot));
\module Region(values: \Pow Real.Real, open: RealSets.IsOpenIn RealTopology.topology values);
\import Region[values := Rays.Above Real.zero, open := Rays.aboveOpen Real.zero] \as Positive;
\import Region[values := Rays.Below Real.zero, open := Rays.belowOpen Real.zero] \as Negative;
\definition positive: Open.OpenSet := Positive.domain;
\definition negative: Open.OpenSet := Negative.domain;
\definition positiveIncluded: Open.Included positive U := Positive.included;
\definition negativeIncluded: Open.Included negative U := Negative.included;
\definition positivePoint[x: Open.Carrier positive]: Open.Carrier U := Positive.input x;
\definition negativePoint[x: Open.Carrier negative]: Open.Carrier U := Negative.input x;
\definition positiveSign[x: Open.Carrier positive]: R.Lt Real.zero (partial (positivePoint x)) := Positive.inTarget x;
\definition negativeSign[x: Open.Carrier negative]: R.Lt (partial (negativePoint x)) Real.zero := Negative.inTarget x;
\definition positiveIntro[a: Open.Carrier U]: R.Lt Real.zero (partial a) -> Sets.Member positive.points a := Positive.intro a;
\definition negativeIntro[a: Open.Carrier U]: R.Lt (partial a) Real.zero -> Sets.Member negative.points a := Negative.intro a;
