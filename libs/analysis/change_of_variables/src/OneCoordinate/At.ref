\definition Fixed: \Prop := \forall (x: Open.Carrier U) -> Coordinates.base (Maps.apply U V e.forward x) = Coordinates.base x;
\definition scalar: Smooth.SmoothFunction U := Maps.coordinateFunction U V e.forward pivot;
\definition partial: Open.ScalarFunction U := Partial.partial U scalar pivot;

\module Differential(fixed: Fixed);
\definition signed[fixed: Fixed][x: Open.Carrier U]: \root.Euclidean[n := Index.total].Jacobian[U := U, V := V, f := e.forward].signed x = partial x := Differential[fixed := fixed].signed x;
\definition nonzero[fixed: Fixed][x: Open.Carrier U]: Logic.Not (partial x = Real.zero) := Differential[fixed := fixed].nonzero x;
\module Sign;
\module Rectangle(base: \Pow Base.Point, interval: Integration.Interval,
  contains: \forall (x: Base.Point) (t: Real.Real) -> BaseSets.Member base x -> R.Le interval.left t -> R.Le t interval.right -> Sets.Member U.points (join x t), fixed: Fixed);
\module Global(fixed: Fixed);
\definition theorem[fixed: Fixed][f: L.SmoothCompact][within: Sets.Subset (Functions.support f) V.points]:
  I.integral (\root.Euclidean[n := Index.total].Diffeomorphism[U := U, V := V, e := e].Compact[f := f, within := within].representative) =
  I.integral (\root.Euclidean[n := Index.total].Compact[].representative f) := Global[fixed := fixed].theorem f within;
