/* A smooth scalar function on an open set restricted to a closed coordinate segment. */
\import calculus.Real[].Multivariable[n := n] \as Model;
\import Model.Open[] \as Open;
\import Open.Analysis[] \as Analysis;
\import Open.Smooth[].Derivative[] \as Partial;
\import Model.Space[].Def[] \as Coordinates;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\module On(U: Open.OpenSet, h: Partial.Function U, a: Model.Point, i: Fin.Fin n, interval: integration.Real[].Interval);
