\import \root.Boundary[n := n].Strip[interval := interval, primitive := primitive, integrand := integrand] \as S;
\import \root.Boundary[n := n].Strip[interval := interval, primitive := primitive, integrand := integrand].HalfSpace[] \as H;
\import lp_spaces.Euclidean[n := Index.total].BorelMeasure[] \as BorelMeasure;
\import E.MeasureConstruction[] \as Lebesgue;
\import M.Integral[mu := Lebesgue.measure] \as I;
\import functional_analysis.Measure[A := L.Point].Integral[mu := L.MeasureConstruction[].measure] \as Base;
\definition function[x: E.Point]: Real.Real := S.joint (split x);
\module For(valid: S.Conditions, borel: M.IsMeasurable BorelMeasure.borel function);
\definition halfFunction[x: E.Point]: Real.Real := H.function (split x);
\module HalfSpace(valid: S.Conditions, tail: H.TailZero, upper: H.UpperZero, borel: M.IsMeasurable BorelMeasure.borel halfFunction);
