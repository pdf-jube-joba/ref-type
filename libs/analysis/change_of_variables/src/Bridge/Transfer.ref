\import lp_spaces.Euclidean[n := Index.total].BorelMeasure[] \as BorelMeasure;
\import E.MeasureConstruction[] \as Lebesgue;
\import euclidean_measure.EuclideanBorel[n := Index.total] \as EB;
\import functional_analysis.Measure[A := Sigma.Point].Integral[mu := Product.measure] \as J;
\import M.Integral[mu := BorelMeasure.borel] \as BI;
\import M.Integral[mu := Lebesgue.measure] \as I;
\import product_integration.MeasureMap[A := Sigma.Point, B := E.Point, source := Product.measure, target := BorelMeasure.borel] \as Maps;
\import product_integration.MeasureMap[A := E.Point, B := E.Point, source := Lebesgue.measure, target := BorelMeasure.borel] \as Completion;
\import \root.Bridge[n := n].Borel[] \as Borel;
\import \root.Bridge[n := n].Comparison[] \as Comparison;
\definition data: Maps.Data := Maps.Data { function := join, measurable := Borel.measurable, value := Comparison.theorem };
\definition completion: Completion.Data := Completion.Data {
  function := \fun (x: E.Point) => x,
  measurable := EB.borelMeasurable,
  value := \fun (S: \Pow E.Point)(valid: M.Measurable BorelMeasure.borel.sigma S) => \refl(Lebesgue.measure.value S),
};
\module For(f: BI.Representatives);
\module FromProduct(f: J.Representatives, borel: M.IsMeasurable BorelMeasure.borel (\fun (x: E.Point) => f (split x)));
