\import E.MeasureConstruction[] \as Lebesgue;
\import M.Integral[mu := Lebesgue.measure] \as I;
\import \root.Linear[n := Index.total].Permutation[p := p] \as P;
\import \root.Linear[n := Index.total].Permutation[p := p].Integration[] \as Integration;
\import product_integration.MeasureMap[A := E.Point, B := E.Point, source := Lebesgue.measure, target := Lebesgue.measure].On[map := Integration.map].RealFunction[f := f] \as Pullback;
\definition function[x: E.Point]: Real.Real := f (P.point x);
\definition representative: I.Representatives := Pullback.representative;
\definition theorem: I.integral representative = I.integral f := Pullback.integral;
