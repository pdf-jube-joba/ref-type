\import Maps.On[map := data].RealFunction[f := f] \as Pullback;
\import Completion.On[map := completion].RealFunction[f := f] \as Complete;
\definition product: J.Representatives := Pullback.representative;
\definition euclidean: I.Representatives := Complete.representative;
\definition theorem: I.integral euclidean = J.integral product := eq_reason_in!{Real.Real _
  "=" _ "by" { Complete.integral }
  "=" _ "by" { sym!{Real.Real} _ _ Pullback.integral }
};
