\import \root.Bridge[n := n].Transfer[].FromProduct[f := Parts.left valid, borel := leftBorel] \as Left;
\import \root.Bridge[n := n].Transfer[].FromProduct[f := Parts.right valid, borel := rightBorel] \as Right;
\definition left: I.Representatives := Left.representative;
\definition right: I.Representatives := Right.representative;
\definition trace: Base.Representatives := Parts.boundary valid;
\definition theorem: I.integral left = Real.sub (Base.integral trace) (I.integral right) := eq_reason_in!{Real.Real _
  "=" _ "by" { Left.theorem }
  "=" _ "by" { Parts.theorem valid }
  "=" _ "by" { congr!{Real.Real Real.Real} (Real.sub (Base.integral trace)) _ _ (sym!{Real.Real} _ _ Right.theorem) }
};
\definition leftOriginal: I.Representatives := left;
\definition rightOriginal: I.Representatives := right;
\definition boundaryFormula: I.integral leftOriginal = Real.sub (Base.integral trace) (I.integral rightOriginal) := theorem;
\module Permuted(p: Fin.Permutations[n := Index.total].Permutation) {
  \import \root.Bridge[n := n].Permuted[p := p, f := leftOriginal] \as LeftTransport;
  \import \root.Bridge[n := n].Permuted[p := p, f := rightOriginal] \as RightTransport;
  \definition left: I.Representatives := LeftTransport.representative;
  \definition right: I.Representatives := RightTransport.representative;
  \definition theorem: I.integral left = Real.sub (Base.integral trace) (I.integral right) := eq_reason_in!{Real.Real _
    "=" _ "by" { LeftTransport.theorem }
    "=" _ "by" { boundaryFormula }
    "=" _ "by" { congr!{Real.Real Real.Real} (Real.sub (Base.integral trace)) _ _ (sym!{Real.Real} _ _ RightTransport.theorem) }
  };
}
