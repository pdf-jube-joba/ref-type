\import \root.Boundary[n := n].IntegrationByParts[interval := interval, f := f, g := g, df := df, dg := dg] \as Parts;
\import lp_spaces.Euclidean[n := Index.total].BorelMeasure[] \as BorelMeasure;
\import M.Integral[mu := E.MeasureConstruction[].measure] \as I;
\import functional_analysis.Measure[A := L.Point].Integral[mu := L.MeasureConstruction[].measure] \as Base;
\definition leftFunction[x: E.Point]: Real.Real := Parts.leftFunction (split x);
\definition rightFunction[x: E.Point]: Real.Real := Parts.rightFunction (split x);
\module For(valid: Parts.Conditions, leftBorel: M.IsMeasurable BorelMeasure.borel leftFunction, rightBorel: M.IsMeasurable BorelMeasure.borel rightFunction);
