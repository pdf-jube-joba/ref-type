\import \root.Boundary[n := n].Rectangle[box := box, interval := interval, primitive := primitive, integrand := integrand] \as Rct;
\import \root.Boundary[n := n].Strip[interval := interval, primitive := Rct.primitiveOn, integrand := Rct.derivativeOn] \as S;
\import lp_spaces.Euclidean[n := Index.total].BorelMeasure[] \as BorelMeasure;
\import E.MeasureConstruction[] \as Lebesgue;
\import M.Integral[mu := Lebesgue.measure] \as I;
\import functional_analysis.Measure[A := L.Point].Integral[mu := L.MeasureConstruction[].measure] \as Base;
\definition function[x: E.Point]: Real.Real := S.joint (split x);
\module For(valid: Rct.Conditions, borel: M.IsMeasurable BorelMeasure.borel function);
