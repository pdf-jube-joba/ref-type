\import \root.Bridge[n := n].Transfer[].FromProduct[f := S.representative valid, borel := borel] \as Transfer;
\definition representative: I.Representatives := Transfer.representative;
\definition trace: Base.Representatives := S.boundaryRepresentative valid;
\definition theorem: I.integral representative = Base.integral trace := eq_reason_in!{Real.Real _
  "=" _ "by" { Transfer.theorem }
  "=" _ "by" { S.theorem valid }
};

\definition boundaryFormula: I.integral representative = Base.integral trace := theorem;
\module Permuted(p: Fin.Permutations[n := Index.total].Permutation) {
  \import \root.Bridge[n := n].Permuted[p := p, f := representative] \as Transport;
  \definition representative: I.Representatives := Transport.representative;
  \definition theorem: I.integral representative = Base.integral trace := eq_reason_in!{Real.Real _
    "=" _ "by" { Transport.theorem }
    "=" _ "by" { boundaryFormula }
  };
}
