\import \root.Bridge[n := n].Transfer[].FromProduct[f := H.representative valid tail, borel := borel] \as Transfer;
\definition representative: I.Representatives := Transfer.representative;
\definition trace: Base.Representatives := H.lower valid upper;
\definition theorem: I.integral representative = Real.neg (Base.integral trace) := eq_reason_in!{Real.Real _
  "=" _ "by" { Transfer.theorem }
  "=" _ "by" { H.theorem valid tail upper }
};

\definition boundaryFormula: I.integral representative = Real.neg (Base.integral trace) := theorem;
\module Permuted(p: Fin.Permutations[n := Index.total].Permutation) {
  \import \root.Bridge[n := n].Permuted[p := p, f := representative] \as Transport;
  \definition representative: I.Representatives := Transport.representative;
  \definition theorem: I.integral representative = Real.neg (Base.integral trace) := eq_reason_in!{Real.Real _
    "=" _ "by" { Transport.theorem }
    "=" _ "by" { boundaryFormula }
  };
}
