\definition theorem: SingleProperty := \fun (U, V: Open.OpenSet)(e: Diffeomorphisms.Diffeomorphism U V)(pivot: Fin.Fin n)(single: Single U V e pivot) =>
  \root.Change[].In[n := n].Conjugate[first := pivot, second := last, U := U, V := V, e := e].theorem
    (known _ _ _ (\root.Change[].In[n := n].Conjugate[first := pivot, second := last, U := U, V := V, e := e].fixed single));
