\import \root.Triangular[n := n].Swap[first := first, second := second].Conjugate[U := U, V := V, f := e] \as T;
\import Diffeomorphisms.Composition[U := T.domain, V := T.target, f := T.normalized].After[l := n, W := V, g := T.targetEquivalence] \as Other;
\import \root.Euclidean[n := n].Diffeomorphism[U := T.domain, V := V, e := T.composite].Restriction[D := T.domain, E := V, r := Other.compose] \as Compare;
\definition conditions: Compare.Conditions := Compare.Conditions {
  sourceIncluded := \fun (x: E.Point)(inside: Sets.Member T.domain.points x) => inside,
  targetIncluded := \fun (x: E.Point)(inside: Sets.Member V.points x) => inside,
  forward := T.commutes,
};
\definition fixed: Single U V e first -> Single T.domain T.target T.normalized second := \fun (single: _)(x: Open.Carrier T.domain)(j: Fin.Fin n)(different: _) =>
  T.preservesOthers (\fun (i: Fin.Fin n)(notFirst: _)(y: Open.Carrier U) => single y i notFirst) j different x;
\module Compact(known: Property T.domain T.target T.normalized, f: L.SmoothCompact, within: Sets.Subset (Functions.support f) V.points);
\definition theorem: Property T.domain T.target T.normalized -> Property U V e := \fun (known: _)(f: L.SmoothCompact)(within: Sets.Subset (Functions.support f) V.points) => Compact[known := known, f := f, within := within].theorem;
