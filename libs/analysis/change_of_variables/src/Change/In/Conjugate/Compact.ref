\import \root.Euclidean[n := n].Diffeomorphism[U := T.domain, V := U, e := T.sourceEquivalence].Composition[W := V, d := e].Compact[f := f, within := within] \as First;
\import \root.Euclidean[n := n].Diffeomorphism[U := T.domain, V := T.target, e := T.normalized].Composition[W := V, d := T.targetEquivalence].Compact[f := f, within := within] \as Second;
\import Compare.With[conditions := conditions].Compact[f := f, within := within] \as Equality;
\import \root.PermutationChange[n := n].Swap[first := first, second := second, U := U] \as Source;
\import \root.PermutationChange[n := n].Swap[first := first, second := second, U := V] \as Target;
\definition theorem: Statement U V e f within := eq_reason_in!{Real.Real _
  "=" _ "by" { sym!{Real.Real} _ _ First.middleIntegral }
  "=" _ "by" { sym!{Real.Real} _ _ (Source.Compact[f := First.middle, within := First.middleWithin].theorem) }
  "=" _ "by" { sym!{Real.Real} _ _ First.integral }
  "=" _ "by" { Equality.integral }
  "=" _ "by" { Second.integral }
  "=" _ "by" { known Second.middle Second.middleWithin }
  "=" _ "by" { Second.middleIntegral }
  "=" _ "by" { Target.Compact[f := f, within := within].theorem }
};
