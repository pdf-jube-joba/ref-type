\definition inTarget: Sets.Subset (Functions.support f) V.points := \fun (x: E.Point)(supported: _) => included x (within x supported);
\import \root.Euclidean[n := N.Nat^::succ n].Diffeomorphism[U := F.domain, V := F.middle, e := F.simple].Composition[W := F.target, d := F.residual].Compact[f := f, within := within] \as ComposeChange;
\import Restrict.With[conditions := conditions].Compact[f := f, within := within] \as Restricted;
\definition normalized: C.Statement Normal.domain V Normal.normalized f inTarget := eq_reason_in!{Real.Real _
  "=" _ "by" { Restricted.integral }
  "=" _ "by" { ComposeChange.integral }
  "=" _ "by" { single F.domain F.middle F.simple (Fin.zero n) F.simpleOthers ComposeChange.middle ComposeChange.middleWithin }
  "=" _ "by" { ComposeChange.middleIntegral }
  "=" _ "by" { \root.FiberChange[n := n].At[U := F.middle, V := F.target, e := F.residual, f := f, within := within, fixed := F.fixed, induction := induction].theorem }
};
\import \root.Euclidean[n := N.Nat^::succ n].Diffeomorphism[U := Normal.domain, V := U, e := Normal.reindexing].Composition[W := V, d := e].Compact[f := f, within := inTarget] \as Coordinates;
\import \root.PermutationChange[n := N.Nat^::succ n].Swap[first := Fin.zero n, second := pivot, U := U] \as Permutation;
\definition theorem: C.Statement U V e f inTarget := eq_reason_in!{Real.Real _
  "=" _ "by" { sym!{Real.Real} _ _ Coordinates.middleIntegral }
  "=" _ "by" { sym!{Real.Real} _ _ (Permutation.Compact[f := Coordinates.middle, within := Coordinates.middleWithin].theorem) }
  "=" _ "by" { sym!{Real.Real} _ _ Coordinates.integral }
  "=" _ "by" { normalized }
};
