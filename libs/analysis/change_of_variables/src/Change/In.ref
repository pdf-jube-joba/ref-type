\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\use std.Logic[].Equality[].congr;
\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].trans;
\use std.Logic[].Equality[].eq_reason_in;
\import real.Analysis[] \as Real;
\import euclidean_measure.Euclidean[n := n] \as E;
\import E.MeasureConstruction[] \as Lebesgue;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import calculus.Maps[n := n, m := n] \as Maps;
\import calculus.Diffeomorphism[n := n, m := n] \as Diffeomorphisms;
\import functional_analysis.Measure[A := E.Point].Integral[mu := Lebesgue.measure] \as I;
\import lp_spaces.Euclidean[n := n] \as L;
\import smooth_partitions.Euclidean[n := n] \as Functions;
\import topology.Topology[Carrier := E.Point] \as Sets;
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as Ambient;
\import \root.Euclidean[n := n].Compact[] \as Compact;
\definition Single[U, V: Open.OpenSet][e: Diffeomorphisms.Diffeomorphism U V][pivot: Fin.Fin n]: \Prop :=
  \forall (x: Open.Carrier U)(i: Fin.Fin n) -> Logic.Not (pivot = i) -> Maps.apply U V e.forward x i = x i;
\definition Statement[U, V: Open.OpenSet][e: Diffeomorphisms.Diffeomorphism U V][f: L.SmoothCompact][within: Sets.Subset (Functions.support f) V.points]: \Prop :=
  I.integral (\root.Euclidean[n := n].Diffeomorphism[U := U, V := V, e := e].Compact[f := f, within := within].representative) = I.integral (Compact.representative f);
\definition Property[U, V: Open.OpenSet][e: Diffeomorphisms.Diffeomorphism U V]: \Prop :=
  \forall (f: L.SmoothCompact)(within: Sets.Subset (Functions.support f) V.points) -> Statement U V e f within;
\definition SingleProperty: \Prop := \forall (U, V: Open.OpenSet)(e: Diffeomorphisms.Diffeomorphism U V)(pivot: Fin.Fin n) -> Single U V e pivot -> Property U V e;
\definition CoordinateProperty[pivot: Fin.Fin n]: \Prop := \forall (U, V: Open.OpenSet)(e: Diffeomorphisms.Diffeomorphism U V) -> Single U V e pivot -> Property U V e;
\module Conjugate(first, second: Fin.Fin n, U, V: Open.OpenSet, e: Diffeomorphisms.Diffeomorphism U V);
\module AllCoordinates(last: Fin.Fin n, known: CoordinateProperty last);
