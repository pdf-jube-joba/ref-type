\definition included: Open.Included U Open.whole := \fun (x: Point)(inside: _) => \refl(x);
\import Local.RestrictDiffeomorphism[U := Open.whole, V := Open.whole, f := equivalence, W := U, included := included] \as Restriction;
\import SmoothMaps.Preimage[U := Open.whole, W := Open.whole, V := U, f := Smooth.forward] \as Preimage;
\definition domain: Open.OpenSet := Restriction.domain;
\definition equivalence: Diffeomorphisms.Diffeomorphism domain U := Restriction.equivalence;
\definition forward: Open.Carrier domain -> Open.Carrier U := SmoothMaps.apply domain U equivalence.forward;
\definition backward: Open.Carrier U -> Open.Carrier domain := SmoothMaps.apply U domain equivalence.backward;
\definition point[a: Open.Carrier U]: Open.Carrier domain := backward a;
\definition image[a: Open.Carrier U]: forward (point a) = a := equivalence.rightInverse a;
\definition differential[x: Open.Carrier domain]: SmoothMaps.Differential[U := domain, V := U, f := equivalence.forward, a := x].value = linear :=
  trans!{{calculus.Vector[n := n, m := n].LinearMap}} _ _ _ (Preimage.differential x) (Smooth.differential (Preimage.input x));
