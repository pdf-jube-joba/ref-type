\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import \root.Triangular[n := one].Slicing[m := n] \as Slicing;
\import calculus.Blocks[n := one, m := n] \as Split;
\import calculus.Real[].Multivariable[n := N.Nat^::succ n].Open[] \as Ambient;
\import calculus.Real[].Multivariable[n := n].Open[] \as Fiber;
\import calculus.Maps[n := N.Nat^::succ n, m := N.Nat^::succ n] \as AmbientMaps;
\import calculus.Maps[n := n, m := n] \as FiberMaps;
\import calculus.Diffeomorphism[n := N.Nat^::succ n, m := N.Nat^::succ n] \as Diffeomorphisms;
\import \parent.Block[] \as Block;
\import matrix_invariants.Ring[K := Real.Real, scalars := std.Alg[].Field[].fieldAsCommutativeRing Real.Real Algebra.field].At[n := N.Nat^::succ n] \as Big;
\import Spaces.FiniteCoordinates[n := N.Nat^::succ n] \as BigBasis;
\import Spaces.Coordinates[I := Fin.Fin (N.Nat^::succ n)].Kronecker[] \as BigKronecker;
\definition LeftPoint: \Set := Fin.Fin one -> Real.Real;
\module At(U, V: Ambient.OpenSet, f: Diffeomorphisms.Diffeomorphism U V);
\module Pivoted(U, V: Ambient.OpenSet, f: Diffeomorphisms.Diffeomorphism U V, pivot: Fin.Fin (N.Nat^::succ n), a: Ambient.Carrier U);
