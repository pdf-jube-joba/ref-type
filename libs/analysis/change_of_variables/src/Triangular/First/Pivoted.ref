\import \root.Triangular[n := N.Nat^::succ n].Pivoted[U := U, V := V, f := f, row := Fin.zero n, pivot := pivot] \as Normal;
\import \root.Triangular[n := N.Nat^::succ n].Factor[U := Normal.domain, V := V, f := Normal.normalized, pivot := Fin.zero n] \as Factor;
\definition point: Ambient.Carrier Normal.domain := Normal.At[a := a].point;
\definition Local: \Set := Factor.Local point;
\definition Nonzero: \Prop := Logic.Not (Normal.matrix a (Fin.zero n) pivot = Real.zero);
\definition localExistence: Nonzero -> \exists Local := Normal.At[a := a].localExistence;
\module With(local: Local);
