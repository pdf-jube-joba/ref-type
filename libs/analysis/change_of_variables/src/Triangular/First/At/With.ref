\import Split.LeftSection[V := U, c := c] \as Source;
\import Split.LeftSection[V := V, c := c] \as Target;
\import Slicing.At[U := U, V := V, f := f].With[fixed := fixed, c := c] \as Data;
\definition domain: Fiber.OpenSet := Source.domain;
\definition target: Fiber.OpenSet := Target.domain;
\definition section[x: Fiber.Carrier domain]: Ambient.Carrier U := Source.apply x;
\definition slice: calculus.Diffeomorphism[n := n, m := n].Diffeomorphism Source.domain Target.domain := Data.diffeomorphism;
\import Fin.Sum[m := one, n := n].Tuples[A := Real.Real] \as Joined;
\import Fin.Tuples[A := Real.Real] \as Tuples;
\definition sectionBasis[i: Index]: Split.rightLinear.apply (Basis.vectors i) = BigBasis.vectors (Fin.succ n i) :=
  trans!{Block.BigPoint} _ _ _
    (Tuples.extensionality n _ _ (trans!{Real.Real} _ _ _ (Joined.atLeft (\fun (i: Fin.Fin one) => Real.zero) (Basis.vectors i) (Fin.zero N.Nat^::zero))
      (sym!{Real.Real} _ _ (Tuples.atZero n Real.zero (Basis.vectors i))))
      (\fun (j: Index) => trans!{Real.Real} _ _ _ (Joined.atRight (\fun (i: Fin.Fin one) => Real.zero) (Basis.vectors i) j)
        (sym!{Real.Real} _ _ (Tuples.atSuccessor n Real.zero (Basis.vectors i) j))))
    (trans!{Block.BigPoint} _ _ _ (Block.basisTail i)
      (\root.Triangular[n := N.Nat^::succ n].Row[pivot := Fin.zero n].identityRow (Fin.succ n i)));
\module Differential(x: Fiber.Carrier Source.domain);
