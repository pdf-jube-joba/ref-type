\import calculus.Vector[n := n, m := N.Nat^::succ n].Chain[U := Source.domain, V := U, f := Source.apply, a := x,
  d := Split.rightLinear, g := AmbientMaps.coordinateFunction U V f.forward (Fin.succ n j), e := Original.row (Fin.succ n j)] \as Chain;
\definition chainLaw: Fiber.Analysis[].HasDifferentialAt Source.domain
  (FiberMaps.coordinateFunction Source.domain Target.domain Data.forwardMap j) x Chain.differential :=
  Chain.law (Split.FixedLeft[U := Source.domain, V := U, c := c].differential x) (Original.componentLaw (Fin.succ n j));
\definition row: Slice.row j = Chain.differential :=
  Fiber.Analysis[].Differential[U := Source.domain,
    f := FiberMaps.coordinateFunction Source.domain Target.domain Data.forwardMap j, a := x, d := Slice.row j].uniqueness
    Chain.differential (Slice.componentLaw j) chainLaw;
\definition value: sliceMatrix j i = Block.minor originalMatrix j i :=
  trans!{Real.Real} _ _ _
    (congr!{{calculus.Real[].Multivariable[n := n].Differential[].Def[].LinearMap} Real.Real}
      (\fun (d: calculus.Real[].Multivariable[n := n].Differential[].Def[].LinearMap) => d.apply (Basis.vectors i)) _ _ row)
    (congr!{Block.BigPoint Real.Real} (Original.row (Fin.succ n j)).apply _ _ (sectionBasis i));
