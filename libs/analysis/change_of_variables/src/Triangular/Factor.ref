\import calculus.Maps[n := n, m := n] \as Maps;
\import inverse_implicit.Euclidean[n := n] \as InverseFunction;
\definition coordinate: Open.Smooth[].SmoothFunction U := Maps.coordinateFunction U V f.forward pivot;
\import \parent.Replace[U := U, h := coordinate, pivot := pivot] \as Replacement;
\definition Local[a: Open.Carrier U]: \Set := InverseFunction.LocalInverse[U, Replacement.map, a];
\definition gradient[a: Open.Carrier U]: Real.Real := Replacement.gradient a pivot;
\definition Regular[a: Open.Carrier U]: \Prop := Logic.Not (gradient a = Real.zero);
\definition localExistence[a: Open.Carrier U]: Regular a -> \exists Local a := Replacement.localExistence a;
\module With(a: Open.Carrier U, local: Local a);
