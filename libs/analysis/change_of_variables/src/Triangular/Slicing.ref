/* Restricting a diffeomorphism that fixes its left block to a fiber. */
\import calculus.Blocks[n := n, m := m] \as Split;
\import Fin.Sum[m := n, n := m] \as Indices;
\import calculus.Real[].Multivariable[n := Split.dimension].Open[] \as Ambient;
\import calculus.Real[].Multivariable[n := m].Open[] \as Fiber;
\import calculus.Maps[n := Split.dimension, m := Split.dimension] \as AmbientMaps;
\import calculus.Maps[n := m, m := Split.dimension] \as Sections;
\import calculus.Maps[n := m, m := m] \as FiberMaps;
\import calculus.Diffeomorphism[n := Split.dimension, m := Split.dimension] \as AmbientDiffeomorphisms;
\import calculus.Diffeomorphism[n := m, m := m] \as FiberDiffeomorphisms;
\definition AmbientPoint: \Set := topological_algebra.Euclidean[].Dimension[n := Split.dimension].Point;
\definition FiberPoint: \Set := topological_algebra.Euclidean[].Dimension[n := m].Point;
\module At(U, V: Ambient.OpenSet, f: AmbientDiffeomorphisms.Diffeomorphism U V);
