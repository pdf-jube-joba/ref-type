\import calculus.Maps[n := n, m := n] \as Maps;
\import \parent.Swap[first := row, second := pivot].On[U := U] \as Coordinates;
\import \parent.Swap[first := row, second := pivot] \as Swap;
\definition domain: Open.OpenSet := Coordinates.domain;
\definition reindexing: Diffeomorphisms.Diffeomorphism domain U := Coordinates.equivalence;
\definition normalized: Diffeomorphisms.Diffeomorphism domain V :=
  Diffeomorphisms.Composition[U := domain, V := U, f := reindexing].After[l := n, W := V, g := f].compose;
\import \parent.Factor[U := domain, V := V, f := normalized, pivot := row] \as Factor;
\import Matrix.Representation[] \as Representation;
\definition matrix[a: Open.Carrier U]: Matrix.Matrix := Representation.entries (Maps.Differential[U := U, V := V, f := f.forward, a := a].value);
\module At(a: Open.Carrier U);
