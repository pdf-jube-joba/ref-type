\import inverse_implicit.Euclidean[n := n].DiffeomorphismDerivative[U := U, V := V, f := f, x := a] \as Derivatives;
\definition inverse: MatrixOperations.Inverse (matrix a) :=
  \into[Matrix.Matrix](Representation.entries Derivatives.backward, MatrixOperations.Inverse (matrix a)) \by {
    Representation.inverseCertificate Derivatives.forward Derivatives.backward Derivatives.left Derivatives.right
  };
\definition nonzero: Logic.Not (Matrix.determinant (matrix a) = Real.zero) := Inversion.nonzeroOfInverse (matrix a) inverse;
