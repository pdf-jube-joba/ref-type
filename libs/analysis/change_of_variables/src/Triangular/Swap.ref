\import Fin.Permutations[n := n] \as Permutations;
\import Permutations.Operations[] \as PermutationOperations;
\import Fin.Transposition[n := n, a := first, b := second] \as Indices;
\import calculus.Maps[n := n, m := n] \as SmoothMaps;
\import inverse_implicit.Euclidean[n := n] \as Local;
\definition permutation: Permutations.Permutation := PermutationOperations.transposition (Permutations.Swap { first := first, second := second });
\import \root.Linear[n := n].Permutation[p := permutation] \as Linear;
\import Linear.Smooth[] \as Smooth;
\definition linear: calculus.Vector[n := n, m := n].LinearMap := Linear.map;
\definition equivalence: Diffeomorphisms.Diffeomorphism Open.whole Open.whole := Smooth.equivalence;
\definition basis: linear.apply (Basis.vectors first) = Basis.vectors second :=
  trans!{Point} _ _ _ (Linear.Determinant[].basis first) (congr!{Index Point} Basis.vectors _ _ Indices.onFirst);
\module On(U: Open.OpenSet);
\module Conjugate(U, V: Open.OpenSet, f: Diffeomorphisms.Diffeomorphism U V);
