\definition Condition: \Prop := \forall (x: Ambient.Carrier U) -> Split.left (AmbientMaps.apply U V f.forward x) = Split.left x;
\module With(fixed: Condition, c: Point);
\definition slice[fixed: Condition][c: Point]: FiberDiffeomorphisms.Diffeomorphism
  Split.LeftSection[V := U, c := c].domain Split.LeftSection[V := V, c := c].domain := With[fixed := fixed, c := c].diffeomorphism;
