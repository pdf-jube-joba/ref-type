\definition rows[zeros: \forall (i: Index) -> A (Fin.succ n i) (Fin.zero n) = Real.zero]:
  RowTuples.extend n (A (Fin.zero n)) (\fun (i: Index) => embed (minor A i)) = A :=
  RowTuples.extensionality n _ _ (RowTuples.atZero n (A (Fin.zero n)) _)
    (\fun (i: Index) => trans!{BigPoint} _ _ _ (RowTuples.atSuccessor n (A (Fin.zero n)) _ i)
      (Tuples.extensionality n _ _ (trans!{Real.Real} _ _ _ (Tuples.atZero n Real.zero (minor A i)) (sym!{Real.Real} _ _ (zeros i)))
        (\fun (j: Index) => Tuples.atSuccessor n Real.zero (minor A i) j)));
\definition firstColumn: (\forall (i: Index) -> A (Fin.succ n i) (Fin.zero n) = Real.zero) ->
  Big.determinant A = Real.mul (A (Fin.zero n) (Fin.zero n)) (Matrix.determinant (minor A)) :=
  \fun (zeros: _) => trans!{Real.Real} _ _ _
    (congr!{Big.Matrix Real.Real} Big.determinant _ _ (sym!{Big.Matrix} _ _ (rows zeros)))
    (evaluation (A (Fin.zero n)) (minor A));
