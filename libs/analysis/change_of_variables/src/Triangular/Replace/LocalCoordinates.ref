\import calculus.Diffeomorphism[n := n, m := n] \as Diffeomorphisms;
\definition source[x: Open.Carrier local.domain]: Open.Carrier U := Open.inclusion local.domain U local.included x;
\definition forward: Open.Carrier local.domain -> Open.Carrier local.target := Maps.apply local.domain local.target local.equivalence.forward;
\definition backward: Open.Carrier local.target -> Open.Carrier local.domain := Maps.apply local.target local.domain local.equivalence.backward;
\definition laws: Diffeomorphisms.Laws[local.domain, local.target, local.equivalence] :=
  \bysub(Diffeomorphisms.Data[local.domain, local.target], Diffeomorphisms.Diffeomorphism local.domain local.target, local.equivalence);
\definition forwardPivot[x: Open.Carrier local.domain]: forward x pivot = h (source x) :=
  trans!{Real.Real} _ _ _ (congr!{Point Real.Real} (\fun (p: Point) => p pivot) _ _ (local.forward x)) (atPivot (source x));
\definition forwardOther[j: Index]: Logic.Not (pivot = j) -> \forall (x: Open.Carrier local.domain) -> forward x j = x j :=
  \fun (different: _)(x: Open.Carrier local.domain) => trans!{Real.Real} _ _ _
    (congr!{Point Real.Real} (\fun (p: Point) => p j) _ _ (local.forward x)) (atOther j different (source x));
\definition backwardOther[j: Index]: Logic.Not (pivot = j) -> \forall (y: Open.Carrier local.target) -> backward y j = y j :=
  \fun (different: _)(y: Open.Carrier local.target) => trans!{Real.Real} _ _ _
    (sym!{Real.Real} _ _ (forwardOther j different (backward y)))
    (congr!{Point Real.Real} (\fun (p: Point) => p j) _ _ (laws.rightInverse y));
\definition backwardPivot[y: Open.Carrier local.target]: h (source (backward y)) = y pivot :=
  trans!{Real.Real} _ _ _ (sym!{Real.Real} _ _ (forwardPivot (backward y)))
    (congr!{Point Real.Real} (\fun (p: Point) => p pivot) _ _ (laws.rightInverse y));
