\import calculus.Maps[n := n, m := n] \as Maps;
\import Matrix.Representation[] \as Representation;
\import matrix_invariants.Field[K := Real.Real, field := Algebra.field].At[n := n] \as Inversion;
\definition matrix[a: Open.Carrier U]: Matrix.Matrix := Representation.entries (Maps.Differential[U := U, V := V, f := f.forward, a := a].value);
\module At(a: Open.Carrier U);
\definition nonzero[a: Open.Carrier U]: Logic.Not (Matrix.determinant (matrix a) = Real.zero) := At[a := a].nonzero;
\definition row[a: Open.Carrier U][i: Index]: \exists (j: Index \where Logic.Not (matrix a i j = Real.zero)) :=
  \parent.Pivot[].existsInRow (matrix a) i (nonzero a);
