\import integration.Real[] \as Integration;
\import Integration.Riemann[interval := interval].Continuous[] \as Continuous;
\import calculus.Real[].Derivative[].Def[] \as Derivative;
\import calculus.Real[].Derivative[].Operations[] \as Derivatives;
\import calculus.Real[].Derivative[].Product[] \as Product;
\import calculus.Real[].Derivative[].Chain[] \as Chain;
\import metric_spaces.RealLine[] \as Line;
\import metric_spaces.RealFunctions[A := Continuous.Point] \as Functions;
\import real.Analysis[] \as Scalars;
\import Scalars.Algebra[] \as Algebra;
\import Scalars.Distance[] \as Distance;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\use Equality.eq_reason_in;
\definition Real: \Set := Scalars.Real;
\definition a: Real := interval.left;
\definition b: Real := interval.right;
\import functional_analysis.Measure[A := Real].Integral[mu := euclidean_measure.RealLine[].measure] \as LineIntegral;
\module Fundamental(f: Continuous.Function, g: Real -> Real);
\module IntegrationByParts(f, g, df, dg: Continuous.Function);
\module Substitution(target: Integration.Interval, h: Integration.Riemann[interval := target].Continuous[].Function, g, dg: Continuous.Function);
\module ReverseSubstitution(target: Integration.Interval, h: Integration.Riemann[interval := target].Continuous[].Function, g, dg: Continuous.Function);
\module Lebesgue(f: Continuous.Function);
