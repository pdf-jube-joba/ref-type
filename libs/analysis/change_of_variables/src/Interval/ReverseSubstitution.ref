\import Integration.Riemann[interval := target].Continuous[] \as Target;
\import Target.Of[f := h] \as Primitive;
\import topology.Continuity[A := Continuous.Point, B := Real].Corestriction[S := Line.ClosedInterval target.left target.right] \as Into;
\import topology.Composition[A := Continuous.Point, B := Target.Point, C := Real] \as Compose;
\import Functions.Product[] \as Multiplication;
\structure Conditions: \Prop := {
  inside: \forall (x: Continuous.Point) -> \In[Real] (Line.ClosedInterval target.left target.right) (g x),
  interior: \forall (x: Real) -> R.Lt a x -> R.Lt x b -> Logic.And[R.Lt target.left (g x), R.Lt (g x) target.right],
  left: g a = target.right,
  right: g b = target.left,
  derivative: \forall (x: Real) -> R.Lt a x -> R.Lt x b -> Derivative.HasDerivativeAt g x (dg x),
};
\module For(conditions: Conditions);
