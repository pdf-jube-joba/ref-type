\import Functions.Lattice[] \as Lattice;
\import real.Analysis[].Estimates[].Product[] \as Absolute;
\definition absoluteInput: Continuous.Function := \into[Real -> Real]((\fun (t: Real) => Scalars.mul (h (g t)) (Absolute.abs (dg t))), Continuous.Function) \by {
  Multiplication.continuous Continuous.topology _ _
    (Compose.composeContinuous Continuous.topology Target.topology Line.topology point (Target.restrict h) continuousPoint Primitive.continuous)
    (Lattice.absoluteContinuous Continuous.topology (Continuous.restrict dg) (\bysub(Real -> Real, Continuous.Function, dg)))
};
\import \root.Interval[interval := interval].Lebesgue[f := absoluteInput] \as AbsoluteIntegral;
\definition Nonnegative: \Prop := \forall (t: Real) -> R.Le a t -> R.Le t b -> R.Le Scalars.zero (dg t);
\definition theorem: Nonnegative -> LineIntegral.integral AbsoluteIntegral.representative = LineIntegral.integral TargetIntegral.representative :=
  \fun (positive: _) => trans!{Real} _ _ _
    (AbsoluteIntegral.Equality[g := input].theorem (\fun (t: Real)(at: _)(tb: _) =>
      congr!{Real Real} (Scalars.mul (h (g t))) _ _ (Absolute.absOfNonnegative (dg t) (positive t at tb))))
    lebesgue;
