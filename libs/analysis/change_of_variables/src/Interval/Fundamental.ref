\import Continuous.Of[f := f] \as Integral;
\definition DerivativeLaw: \Prop := \forall (x: Real) -> R.Lt a x -> R.Lt x b -> Derivative.HasDerivativeAt g x (f x);
\definition theorem: Continuous.IsContinuous g -> DerivativeLaw -> Integral.value = Scalars.sub (g b) (g a) :=
  \fun (continuous: _)(derivative: _) => eq_reason_in!{Real _
    "=" _ "by" { sym!{Real} _ _ (trans!{Real} _ _ _ (congr!{Real Real} (\fun (v: Real) => Scalars.sub v (g a)) _ _ (Laws.addComm (g a) Integral.value)) (Laws.addNegCancelRight (g a) Integral.value)) }
    "=" _ "by" { congr!{Real Real} (\fun (v: Real) => Scalars.sub v (g a)) _ _
      (sym!{Real} _ _ (trans!{Real} _ _ _
        (Integral.Uniqueness[g := g].agrees continuous derivative b interval.ordered (R.leRefl b))
        (congr!{Real Real} (Scalars.add (g a)) _ _ Integral.primitiveRight))) }
  };
