\import euclidean_measure.RealLine[] \as LineMeasure;
\import euclidean_measure.RealLine[].RiemannMap[interval := interval] \as Comparison;
\import functional_analysis.Measure[A := Real].Integral[mu := LineMeasure.measure] \as I;
\import Continuous.Of[f := f] \as ContinuousIntegral;
\definition representative: I.Representatives := Comparison.representative ContinuousIntegral.integral;
\definition values[x: Real]: representative x = Scalars.mul (LineMeasure.IntervalIntegral[interval := interval].representative x) (f x) := \refl(representative x);
\definition integral: I.integral representative = ContinuousIntegral.value := Comparison.integral ContinuousIntegral.integral;
\definition fundamental[g: Real -> Real]: Continuous.IsContinuous g ->
  (\forall (x: Real) -> R.Lt a x -> R.Lt x b -> Derivative.HasDerivativeAt g x (f x)) ->
  I.integral representative = Scalars.sub (g b) (g a) :=
  \fun (continuous: _)(derivative: _) => trans!{Real} _ _ _ integral (\parent.Fundamental[f := f, g := g].theorem continuous derivative);
\module Equality(g: Continuous.Function);
