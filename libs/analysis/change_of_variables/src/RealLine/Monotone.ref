\import integration.Real[] \as Integration;
\import Integration.Riemann[interval := interval].Continuous[] \as Continuous;
\import calculus.Real[].Derivative[].Def[] \as Derivative;
\import calculus.Real[].Derivative[].Operations[] \as Derivatives;
\import calculus.Real[].MeanValue[] \as MVT;
\import calculus.Real[].Limit[].Topology[].Subset[S := metric_spaces.RealLine[].ClosedInterval interval.left interval.right] \as Local;
\import metric_spaces.RealLine[] \as Topology;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import R.Arithmetic[].Prop[] \as Laws;
\import Real.Estimates[] \as Estimates;
\import Estimates.Product[] \as Product;
\import std.Logic[].Classical[] \as Classical;
\use std.Logic[].Equality[].trans;
\use std.Logic[].Equality[].eq_reason_in;
\definition a: Real.Real := interval.left;
\definition b: Real.Real := interval.right;
\definition DerivativeLaw: \Prop := \forall (t: Real.Real) -> R.Lt a t -> R.Lt t b -> Derivative.HasDerivativeAt g t (dg t);
\definition Positive: \Prop := \forall (t: Real.Real) -> R.Lt a t -> R.Lt t b -> R.Lt Real.zero (dg t);
\module For(derivative: DerivativeLaw, positive: Positive);
\definition Negative: \Prop := \forall (t: Real.Real) -> R.Lt a t -> R.Lt t b -> R.Lt (dg t) Real.zero;
\module Decreasing(derivative: DerivativeLaw, negative: Negative);
