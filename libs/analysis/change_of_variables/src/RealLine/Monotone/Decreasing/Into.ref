\definition conditions: \root.Interval[interval := interval].ReverseSubstitution[target := target, h := h, g := g, dg := dg].Conditions :=
  \root.Interval[interval := interval].ReverseSubstitution[target := target, h := h, g := g, dg := dg].Conditions {
    inside := \fun (t: Continuous.Point) => \block {
      \let inside: Logic.And[R.Le a t, R.Le t b] := \bysub(Real.Real, Topology.ClosedInterval a b, t) \then
      \return Logic.And[_, _]::# (weak t b inside.left (R.leRefl b) inside.right) (weak a t (R.leRefl a) inside.right inside.left)
    },
    interior := \fun (t: Real.Real) (at: R.Lt a t) (tb: R.Lt t b) => Logic.And[_, _]::#
      (strict t b (Order.leOfLt a t at) (R.leRefl b) tb) (strict a t (R.leRefl a) (Order.leOfLt t b tb) at),
    left := \refl(g a), right := \refl(g b), derivative := derivative,
  };
\import \root.Interval[interval := interval].ReverseSubstitution[target := target, h := h, g := g, dg := dg].For[conditions := conditions] \as Substitution;
\import Substitution.Absolute[] \as AbsoluteSubstitution;
\import \root.Interval[interval := interval].Lebesgue[f := AbsoluteSubstitution.absoluteInput] \as AbsoluteIntegral;
\import \root.Interval[interval := target].Lebesgue[f := h] \as TargetIntegral;
\definition absolute: AbsoluteSubstitution.Nonpositive -> I.integral AbsoluteIntegral.representative = I.integral TargetIntegral.representative := AbsoluteSubstitution.theorem;
