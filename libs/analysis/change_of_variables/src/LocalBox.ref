/* Local closed rectangles with an open base and a distinguished last coordinate. */
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\use Equality.eq_reason_in;
\import real.Analysis[] \as Real;
\import Real.Estimates[] \as Estimates;
\import Real.Estimates[].Product[] \as Product;
\import Real.SquareRoot[] \as Root;
\import Real.Distance[] \as Distance;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import R.Order[] \as Order;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import Fin.Sum[m := n, n := one] \as Index;
\import Index.Tuples[A := Real.Real] \as Tuples;
\import euclidean_measure.Euclidean[n := Index.total] \as E;
\import euclidean_measure.Euclidean[n := n] \as Base;
\import calculus.Real[].Multivariable[n := Index.total].Open[] \as Open;
\import calculus.Real[].Multivariable[n := n].Open[] \as BaseOpen;
\import topological_algebra.Euclidean[].Dimension[n := Index.total].Def[] \as Def;
\import topological_algebra.Euclidean[].Dimension[n := Index.total].Norm[] \as Norm;
\import topological_algebra.Euclidean[].Dimension[n := n].Def[] \as BaseDef;
\import topological_algebra.Euclidean[].Dimension[n := n].Norm[] \as BaseNorm;
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as BaseTopology;
\import metric_spaces.MetricSpace[Carrier := Base.Point] \as BaseMetric;
\import BaseMetric.Topology[] \as BaseMetricTopology;
\import topology.Topology[Carrier := E.Point] \as Sets;
\import topology.Topology[Carrier := Base.Point] \as BaseSets;
\import integration.Real[] \as Integration;
\import \root.Bridge[n := n] \as Coordinates;
\import \root.LinearShear[n := n] \as Indices;
\definition Bounds[a, x: E.Point][h: Real.Real]: \Prop := \forall (i: Fin.Fin Index.total) ->
  Logic.And[R.Le (Real.sub (a i) h) (x i), R.Le (x i) (Real.add (a i) h)];
\module At(U: Open.OpenSet, a: Open.Carrier U);
\import Fin.Permutations[n := Index.total] \as Permutations;
\module Along(p: Permutations.Permutation, U: Open.OpenSet, a: Open.Carrier U);
