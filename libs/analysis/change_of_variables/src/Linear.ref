\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\use Equality.eq_reason_in;
\import real.Analysis[] \as Real;
\import Real.Algebra[] \as Algebra;
\import Real.Estimates[].Product[] \as Absolute;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import linear_algebra.Commutative[K := Real.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Real.Real Algebra.field] \as Spaces;
\import Spaces.Coordinates[I := Fin.Fin n] \as Coordinates;
\import Spaces.FiniteCoordinates[n := n] \as Basis;
\import Basis.Top[] \as Top;
\import Coordinates.Kronecker[] \as Kronecker;
\import Spaces.Multilinear[V := Coordinates.Vector, space := Coordinates.space] \as Multilinear;
\import Multilinear.Alternating[] \as Alternating;
\import Spaces.Linear[V := Coordinates.Vector, W := Coordinates.Vector, source := Coordinates.space, target := Coordinates.space] \as Maps;
\import euclidean_measure.Euclidean[n := n] \as E;
\import E.MeasureConstruction[] \as Lebesgue;
\import functional_analysis.Measure[A := E.Point] \as M;
\import M.ValueLaws[] \as Values;
\import topology.Topology[Carrier := E.Point] \as Sets;
\definition Point: \Set := E.Point;
\definition image[L: Maps.Map][S: \Pow Point]: \Pow Point := { y: Point \where \exists ( x: Point \where Logic.And[Sets.Member S x, L.apply x = y] ) };
\module Multiscalar;
\module Diagonal(a: Point);
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as Ambient;
\import topology.Homeomorphism[A := Point, B := Point] \as Homeomorphisms;
\module OpenTransport(h: Homeomorphisms.Homeomorphism[Ambient.topology, Ambient.topology], c: Real.Real);
\import Fin.Permutations[n := n] \as Permutations;
\module Permutation(p: Permutations.Permutation);
\module Rules;
\module Geometry;
\module Generated;
