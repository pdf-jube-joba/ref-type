\import \root.Euclidean[n := total].BorelCompact[f := f] \as Borel;
\import lp_spaces.Euclidean[n := total].BorelMeasure[] \as BorelMeasure;
\import EP.Borel[] \as Join;
\import EP.Comparison[] \as Comparison;
\import product_integration.MeasureMap[A := Sigma.Point, B := Big.Point, source := Product.measure, target := BorelMeasure.borel] \as Maps;
\definition map: Maps.Data := Maps.Data { function := EP.join, measurable := Join.measurable, value := Comparison.theorem };
\import Maps.On[map := map].RealFunction[f := Borel.representative] \as Pullback;
\definition joint: PI.Representatives := Pullback.representative;
\definition integral: PI.integral joint = BI.integral (BigCompact.representative f) := trans!{Real.Real} _ _ _ Pullback.integral Borel.integral;
