\import \root.Triangular[n := n].First[].At[U := U, V := V, f := e] \as First;
\import \root.Euclidean[n := total].Diffeomorphism[U := U, V := V, e := e].Compact[f := f, within := within] \as Pullback;
\import \root.CompactSlices[n := one, m := n] \as Slices;
\import calculus.Blocks[n := one, m := n] \as Split;
\import calculus.Maps[n := n, m := n] \as FiberMaps;
\import calculus.Maps[n := total, m := total] \as BigMaps;
\import \root.Euclidean[n := total].Jacobian[U := U, V := V, f := e.forward] \as BigJ;
\import Real.Estimates[].Product[] \as Absolute;
\import lp_spaces.On[A := Fiber.Point, mu := Fiber.MeasureConstruction[].measure].One[].Norm[] \as FiberEquality;
\import lp_spaces.On[A := Big.Point, mu := Big.MeasureConstruction[].measure].One[].Norm[] \as BigEquality;
\module Slice(c: Left.Point);
\definition sections[c: Left.Point]: FI.integral (FiberCompact.representative (Slices.slice Pullback.value c)) = FI.integral (FiberCompact.representative (Slices.slice f c)) := Slice[c := c].theorem;
\import \root.FiberChange[n := n].Exchange[f := Pullback.value, g := f, sections := sections] \as Exchange;
\definition theorem: BI.integral Pullback.representative = BI.integral (BigCompact.representative f) :=
  trans!{Real.Real} _ _ _ (BigEquality.integralPointwise Pullback.representative (BigCompact.representative Pullback.value) (\fun (x: Big.Point) => \refl(Pullback.value x))) Exchange.theorem;
