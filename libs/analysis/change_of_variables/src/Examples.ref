\import \root.Euclidean[n := n] \as E;
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import calculus.Identity[n := n] \as Identity;
\import real.Analysis[] \as Real;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\import std.Logic[].Equality[] \as Equality;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\import std.Data[].FinSet[] \as Fin;
\import Real.Algebra[] \as Algebra;
\import Real.Estimates[].Product[] \as Absolute;
\import linear_algebra.Commutative[K := Real.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Real.Real Algebra.field] \as Spaces;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\import Spaces.Linear[V := Vectors.Vector, W := Vectors.Vector, source := Vectors.space, target := Vectors.space] \as Linear;
\import Spaces.FiniteCoordinates[n := n].Top[] \as Top;
\module IdentityOn(U: Open.OpenSet) {
  \import E.Jacobian[U := U, V := U, f := Identity.map U] \as J;
  \definition signed[x: Open.Carrier U]: J.signed x = Real.one :=
    trans!{Real.Real} _ _ _ (congr!{{Linear.Map} Real.Real} Top.determinant _ _ (Identity.At[U := U, a := x].differential)) Top.atIdentity;
  \definition absolute[x: Open.Carrier U]: J.absolute x = Real.one := trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real} Absolute.abs _ _ (signed x)) (Absolute.absOfNonnegative Real.one Laws.oneNonnegative);
  \definition density[h: Open.ScalarFunction U][x: Open.Carrier U]: E.Density[U := U, V := U, f := Identity.map U].pullback h x = h x :=
    trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r (h x)) _ _ (absolute x)) (Laws.fieldMulOneLeft (h x));
}
