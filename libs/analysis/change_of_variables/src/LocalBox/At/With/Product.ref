\definition inside[x: Base.Point][t: Real.Real][baseInside: BaseSets.Member (Base.points baseBox) x][normalInside: Logic.And[R.Le interval.left t, R.Le t interval.right]]:
  Sets.Member (E.points cube) (Coordinates.join (Pair.pair Base.Point Real.Real x t)) :=
  Logic.And[_, _]::# (\refl(std.Data[].Bool[].Bool^::true)) (\fun (i: Fin.Fin Index.total) =>
    \idelim Index.inflate (Index.split i) = i \with k: Fin.Fin Index.total => Logic.And[R.Le (cube.left k) (Coordinates.join (Pair.pair Base.Point Real.Real x t) k), R.Le (Coordinates.join (Pair.pair Base.Point Real.Real x t) k) (cube.right k)] \by {
      base: (\induction (index: Index.Index) \return Logic.And[R.Le (cube.left (Index.inflate index)) (Coordinates.join (Pair.pair Base.Point Real.Real x t) (Index.inflate index)), R.Le (Coordinates.join (Pair.pair Base.Point Real.Real x t) (Index.inflate index)) (cube.right (Index.inflate index))] \with {
        | inl: \fun (j: Fin.Fin n) => \idelim x j = Coordinates.join (Pair.pair Base.Point Real.Real x t) (Index.left j) \with c: Real.Real => Logic.And[R.Le (cube.left (Index.left j)) c, R.Le c (cube.right (Index.left j))] \by {
          base: baseInside.right j, equality: sym!{Real.Real} _ _ (Tuples.atLeft x (\fun (_: Fin.Fin one) => t) j)
        }
        | inr: \fun (j: Fin.Fin one) => \idelim Fin.zero N.Nat^::zero = j \with l: Fin.Fin one => Logic.And[R.Le (cube.left (Index.right l)) (Coordinates.join (Pair.pair Base.Point Real.Real x t) (Index.right l)), R.Le (Coordinates.join (Pair.pair Base.Point Real.Real x t) (Index.right l)) (cube.right (Index.right l))] \by {
          base: \idelim t = Coordinates.join (Pair.pair Base.Point Real.Real x t) (Index.right (Fin.zero N.Nat^::zero)) \with c: Real.Real => Logic.And[R.Le interval.left c, R.Le c interval.right] \by {
            base: normalInside, equality: sym!{Real.Real} _ _ (Tuples.atRight x (\fun (_: Fin.Fin one) => t) (Fin.zero N.Nat^::zero))
          }, equality: Indices.oneEqual j
        }
      }) (Index.split i), equality: Index.inflateSplit i
    });
