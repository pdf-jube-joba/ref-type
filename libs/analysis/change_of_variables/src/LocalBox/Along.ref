/* A coordinate permutation chooses any coordinate as the interval direction. */
\import \root.Linear[n := Index.total].Permutation[p := p] \as P;
\import P.Smooth[] \as Smooth;
\import calculus.Maps[n := Index.total, m := Index.total] \as Maps;
\import Maps.Preimage[U := Open.whole, W := Open.whole, V := U, f := Smooth.forward] \as Preimage;
\import Open.Whole[] \as Whole;
\definition domain: Open.OpenSet := Preimage.domain;
\definition centerPoint: E.Point := P.backpoint a;
\definition centerInside: Sets.Member U.points (P.point centerPoint) := \idelim a = P.point centerPoint \with x: E.Point => Sets.Member U.points x \by {
  base: \bysub(E.Point, U.points, a), equality: sym!{E.Point} _ _ (P.right a)
};
\definition center: Open.Carrier domain := \into[E.Point](centerPoint, domain.points) \by { Preimage.intro (Whole.point centerPoint) centerInside };
\import \parent.At[U := domain, a := center] \as Box;
\definition Radius: \Set := Box.Radius;
\definition exists: \exists Radius := Box.exists;
\module With(h: Radius);
