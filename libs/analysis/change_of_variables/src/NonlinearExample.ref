\import std.Data[].Nat[] \as N;
\import std.Logic[].Proposition[] \as Logic;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\definition two: N.Nat^ := N.Nat^::succ one;
\import inverse_implicit.Examples[] \as Existing;
\import calculus.Real[].Multivariable[n := one].Open[] \as Line;
\import calculus.Blocks[n := one, m := one] \as Blocks;
\import inverse_implicit.Product[n := one, m := one].GraphChange[U := Line.whole, h := Existing.square] \as Shear;
\import \root.Euclidean[n := two].Diffeomorphism[U := Shear.domain, V := Shear.domain, e := Shear.equivalence] \as Change;
\import \root.Euclidean[n := two].Compact[] \as Integrals;
\import lp_spaces.Euclidean[n := two] \as L;
\import smooth_partitions.Euclidean[n := two] \as Functions;
\import topology.Topology[Carrier := L.Point] \as Sets;
\import functional_analysis.Measure[A := L.Point].Integral[mu := euclidean_measure.Euclidean[n := two].MeasureConstruction[].measure] \as I;
\definition within[f: L.SmoothCompact]: Sets.Subset (Functions.support f) Shear.domain.points :=
  \fun (x: L.Point)(supported: Sets.Member (Functions.support f) x) => Logic.And[_, _]::# (\refl(Blocks.left x)) (\refl(Blocks.right x));
\definition integral[f: L.SmoothCompact]:
  I.integral (Change.Compact[f := f, within := within f].representative) = I.integral (Integrals.representative f) :=
  \root.Change[].theorem two Shear.domain Shear.domain Shear.equivalence f (within f);
