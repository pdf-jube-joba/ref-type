\definition at[x: E.Point]: Translation.map x = Back.map.apply x := \axiom:funext(Translation.map x, Back.map.apply x,
  \fun (i: Fin.Fin Index.total) => \idelim Index.inflate (Index.split i) = i \with k: Fin.Fin Index.total => Translation.map x k = Back.map.apply x k \by {
    base: (\induction (index: Index.Index) \return Translation.map x (Index.inflate index) = Back.map.apply x (Index.inflate index) \with {
      | inl: \fun (k: Fin.Fin n) => trans!{Real.Real} _ _ _ (atLeft x k)
        (sym!{Real.Real} _ _ (Back.other (Index.left k) x (\fun (same: _) => Index.different k (Fin.zero N.Nat^::zero) (sym!{{Fin.Fin Index.total}} _ _ same))))
      | inr: \fun (k: Fin.Fin one) => \idelim Fin.zero N.Nat^::zero = k \with l: Fin.Fin one => Translation.map x (Index.right l) = Back.map.apply x (Index.right l) \by {
        base: trans!{Real.Real} _ _ _ (atLast x)
          (trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (Real.add (x last)) _ _ (sym!{Real.Real} _ _ (Laws.fieldMulNegLeft t (x (Index.left j)))))
            (sym!{Real.Real} _ _ (Back.atTarget x))),
        equality: oneEqual k
      }
    }) (Index.split i), equality: Index.inflateSplit i
  });
\definition theorem: Translation.map = Back.map.apply := \axiom:funext(Translation.map, Back.map.apply, at);
