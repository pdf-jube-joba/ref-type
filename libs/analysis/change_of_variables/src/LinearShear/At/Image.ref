\definition theorem[S: \Pow E.Point]: Linear.image Shear.map S = Transport.forward S := \axiom:setext(Linear.image Shear.map S, Transport.forward S,
  \fun (y: E.Point)(inside: Sets.Member (Linear.image Shear.map S) y) => \block {
    \takefrom x: \Cast[E.Point] ({ x: E.Point \where Logic.And[Sets.Member S x, Shear.map.apply x = y] }) \by inside \then
    \let data: Logic.And[Sets.Member S x, Shear.map.apply x = y] := \bysub(E.Point, { x: E.Point \where Logic.And[Sets.Member S x, Shear.map.apply x = y] }, x) \then
    \return \idelim x = Back.map.apply y \with z: E.Point => Sets.Member S z \by {
      base: data.left, equality: trans!{E.Point} _ _ _ (sym!{E.Point} _ _ (left x)) (congr!{E.Point E.Point} Back.map.apply _ _ data.right)
    }
  },
  \fun (y: E.Point)(inside: Sets.Member (Transport.forward S) y) => Logic.existsIntro[E.Point, { x: E.Point \where Logic.And[Sets.Member S x, Shear.map.apply x = y] }] (Back.map.apply y)
    (Logic.And[Sets.Member S (Back.map.apply y), Shear.map.apply (Back.map.apply y) = y]::# inside (right y)));
