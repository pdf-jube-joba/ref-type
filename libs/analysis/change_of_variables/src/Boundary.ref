\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.sym;
\use Equality.trans;
\use Equality.eq_reason_in;
\import real.Analysis[] \as Real;
\import Real.Algebra[] \as Algebra;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Order[] \as Order;
\import R.Arithmetic[].Prop[] \as Laws;
\import euclidean_measure.Euclidean[n := n] \as E;
\import E.MeasureConstruction[] \as Lebesgue;
\import euclidean_measure.RealLine[] \as Line;
\import product_integration.Euclidean[n := n] \as Base;
\import functional_analysis.Measure[A := E.Point] \as M;
\import functional_analysis.Measure[A := Real.Real] \as RM;
\import product_integration.Finiteness[A := Real.Real, mu := Line.measure] \as RF;
\import topology.Topology[Carrier := E.Point] \as Sets;
\definition Point: \Set := E.Point;
\definition lineExhaustion: RF.Exhaustion := \root.RealLine[].exhaustion;
\import product_integration.ProductSigma[A := Point, B := Real.Real, left := Lebesgue.measure.sigma, right := Line.measure.sigma] \as Sigma;
\import product_integration.Product[A := Point, B := Real.Real, mu := Lebesgue.measure, nu := Line.measure, left := Base.exhaustion, right := lineExhaustion] \as Product;
\import functional_analysis.Measure[A := Sigma.Point].Integral[mu := Product.measure] \as J;
\import M.Integral[mu := Lebesgue.measure] \as I;
\import RM.Integral[mu := Line.measure] \as RI;
\import product_integration.Integration[A := Point, B := Real.Real, mu := Lebesgue.measure, nu := Line.measure, left := Base.exhaustion, right := lineExhaustion] \as Fubini;
\import integration.Real[] \as Intervals;
\module Strip(interval: Intervals.Interval, primitive: Point -> Real.Real -> Real.Real,
  integrand: Point -> Intervals.Riemann[interval := interval].Continuous[].Function);
\module Rectangle(box: E.Box, interval: Intervals.Interval, primitive: Point -> Real.Real -> Real.Real,
  integrand: Point -> Intervals.Riemann[interval := interval].Continuous[].Function);
\module IntegrationByParts(interval: Intervals.Interval,
  f, g, df, dg: Point -> Intervals.Riemann[interval := interval].Continuous[].Function);
