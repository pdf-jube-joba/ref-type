\import metric_spaces.RealLine[] \as Line;
\import integration.Real[].Riemann[interval := interval].Continuous[] \as Continuous;
\import calculus.Real[].Derivative[].Def[] \as Derivatives;
\import calculus.Real[].MeanValue[].Interval[a := interval.left, b := interval.right].Estimate[] \as Estimates;
\import calculus.Real[].Limit[].Topology[].Subset[S := Line.ClosedInterval interval.left interval.right] \as Local;
\import Analysis.Curve[U := U, f := h, default := Real.zero, a := a, i := i] \as Value;
\import Analysis.Curve[U := U, f := Partial.partial U h i, default := Real.zero, a := a, i := i] \as First;
\import Analysis.Curve[U := U, f := Partial.partial U (Partial.derivative U h i) i, default := Real.zero, a := a, i := i] \as Second;
\definition Closed: \Set := Continuous.Point;
\definition Contains: \Prop := \forall (t: Closed) -> \In[Model.Point] U.points (Coordinates.replace a i t);
\module With(contains: Contains);
