\definition section[t: Real.Real]: L.SmoothCompact := function (Coordinates.replace a i t);
\definition sectionPartial[t: Real.Real]: L.SmoothCompact := partial (Coordinates.replace a i t);
\import Parameters.Compact[function := section, partial := sectionPartial] \as Section;
\definition theorem[conditions: Section.Conditions]: conditions.at = a i ->
  Partial.HasPartialDerivativeAt (\fun (p: Model.Point) => I.integral (Integrals.representative (function p))) i a
    (I.integral (Integrals.representative (partial a))) :=
  \fun (center: _) => \idelim conditions.at = a i \with t: Real.Real =>
    Derivative.HasDerivativeAt (\fun (s: Real.Real) => I.integral (Integrals.representative (section s))) t
      (I.integral (Integrals.representative (partial a))) \by {
      base: \idelim I.integral (Integrals.representative (sectionPartial conditions.at)) = I.integral (Integrals.representative (partial a))
        \with d: Real.Real => Derivative.HasDerivativeAt (\fun (s: Real.Real) => I.integral (Integrals.representative (section s))) conditions.at d \by {
          base: Section.For[conditions := conditions].theorem,
          equality: congr!{Model.Point Real.Real} (\fun (p: Model.Point) => I.integral (Integrals.representative (partial p))) _ _
            (trans!{Model.Point} _ _ _ (congr!{Real.Real Model.Point} (Coordinates.replace a i) _ _ center) (CoordinateLaws.replaceOriginal a i))
        },
      equality: center
    };
