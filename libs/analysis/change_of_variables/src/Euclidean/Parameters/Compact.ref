\import \root.Euclidean[n := n].Compact[] \as Integrals;
\structure Conditions: \Set := {
  at: Real.Real,
  radius: lp_spaces.Exponential[].Positive,
  region: Finite.FiniteMeasurableSet,
  coefficient: I.Scaling[].NonnegativeScalar,
  derivative: \forall (t: Real.Real)(x: Point) -> Derivative.HasDerivativeAt (\fun (s: Real.Real) => function s x) t (partial t x),
  bound: \forall (t: Real.Real) -> R.Lt (Real.distance t at) radius -> \forall (x: Point) -> \In[Point] region x -> R.Le (Absolute.abs (partial t x)) coefficient,
  outside: \forall (t: Real.Real) -> R.Lt (Real.distance t at) radius -> \forall (x: Point) -> Logic.Not (\In[Point] region x) -> partial t x = Real.zero,
};
\module For(conditions: Conditions);
