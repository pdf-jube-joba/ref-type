\import \root.Euclidean[n := n].Jacobian[U := U, V := V, f := f] \as Base;
\import Diffeomorphisms.Inverse[U := U, V := V, f := e] \as Inverse;
\import \parent.\parent.Jacobian[U := V, V := U, f := e.backward] \as Backward;
\module At(x: Open.Carrier U);
\definition nonzero[x: Open.Carrier U]: Logic.Not (Base.signed x = Real.zero) := At[x := x].nonzero;
\definition positive[x: Open.Carrier U]: R.Lt Real.zero (Base.absolute x) :=
  euclidean_measure.GeneralDiagonal[n := n].absPositive (Base.signed x) (nonzero x);
\definition signed[x: Open.Carrier U]: Backward.signed (Maps.apply U V f x) = Algebra.field.inv (Base.signed x) := At[x := x].signed;
\definition cancellation[x: Open.Carrier U]: Real.mul (Backward.absolute (Maps.apply U V f x)) (Base.absolute x) = Real.one := At[x := x].cancellation;
