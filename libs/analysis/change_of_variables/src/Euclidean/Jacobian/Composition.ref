\import \root.Euclidean[n := n].Jacobian[U := U, V := V, f := f] \as Base;
\import Maps.Composition[U := U, V := V, f := f].After[l := n, W := W, g := g] \as Composite;
\import \parent.\parent.Jacobian[U := V, V := W, f := g] \as Outer;
\import \parent.\parent.Jacobian[U := U, V := W, f := Composite.compose] \as Result;
\definition signed[x: Open.Carrier U]: Result.signed x = Real.mul (Outer.signed (Maps.apply U V f x)) (Base.signed x) :=
  trans!{Real.Real} _ _ _ (congr!{{Linear.Map} Real.Real} Top.determinant _ _ (Composite.At[a := x].jacobian))
    (Top.multiplicative (Outer.differential (Maps.apply U V f x)) (differential x));
\definition absolute[x: Open.Carrier U]: Result.absolute x = Real.mul (Outer.absolute (Maps.apply U V f x)) (Base.absolute x) :=
  trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} Absolute.abs _ _ (signed x))
    (Absolute.absProduct (Outer.signed (Maps.apply U V f x)) (Base.signed x));
