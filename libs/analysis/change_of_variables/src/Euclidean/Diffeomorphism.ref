\import \root.Euclidean[n := n] \as Euclidean;
\import Euclidean.Jacobian[U := U, V := V, f := e.forward] \as J;
\import Open.Smooth[] \as Smooth;
\import Smooth.Operations[] \as Operations;
\import Smooth.Properties[] \as SmoothProperties;
\import Maps.Composition[U := U, V := V, f := e.forward] \as Composition;
\import smooth_partitions.Euclidean[n := n] \as Functions;
\import lp_spaces.Euclidean[n := n] \as L;
\import functional_analysis.Support[A := Point] \as Support;
\import topology.Topology[Carrier := Point] \as Sets;
\import topological_algebra.Euclidean[].Dimension[n := n].Topology[] \as Ambient;
\module Regularity;
\module Compact(f: L.SmoothCompact, within: Sets.Subset (Functions.support f) V.points);
\module Gluing(f: L.SmoothCompact, within: Sets.Subset (Functions.support f) V.points, family: \Pow (\Pow Point));
\module Composition(W: Open.OpenSet, d: Diffeomorphisms.Diffeomorphism V W);
\module Restriction(D, E: Open.OpenSet, r: Diffeomorphisms.Diffeomorphism D E);
