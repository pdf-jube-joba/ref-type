\import lp_spaces.On[A := Point, mu := Lebesgue.measure].Differentiation[] \as Dominated;
\import calculus.Real[].Derivative[].Def[] \as Derivative;
\definition Data: \Set := Dominated.Data;
\definition derivative[data: Data]: Derivative.HasDerivativeAt (\fun (t: Real.Real) => I.integral (data.function t)) data.at (I.integral data.derivative) := Dominated.derivative data;
\import lp_spaces.Euclidean[n := n] \as L;
\import product_integration.Finiteness[A := Point, mu := Lebesgue.measure] \as Finite;
\import fourier_schwartz.RealBounds[] \as Bounds;
\module Compact(function, partial: Real.Real -> L.SmoothCompact);
\module Multivariable(m: N.Nat^, function, partial: (std.Data[].FinSet[].Fin m -> Real.Real) -> L.SmoothCompact);
