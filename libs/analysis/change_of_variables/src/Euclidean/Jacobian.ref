\definition differential[x: Open.Carrier U]: Linear.Map := Maps.Differential[U := U, V := V, f := f, a := x].value;
\definition signed[x: Open.Carrier U]: Real.Real := Top.determinant (differential x);
\definition absolute[x: Open.Carrier U]: Real.Real := Absolute.abs (signed x);
\definition nonnegative[x: Open.Carrier U]: R.Le Real.zero (absolute x) := Absolute.absNonnegative (signed x);
\definition matrix[x: Open.Carrier U]: Matrix.Matrix := Representation.entries (differential x);
\definition determinant[x: Open.Carrier U]: Matrix.determinant (matrix x) = signed x := Representation.determinantComparison (differential x);
\module Composition(W: Open.OpenSet, g: Maps.Map V W);
\module Inverse(e: Diffeomorphisms.Diffeomorphism U V, agrees: e.forward = f);
\import Forms.On[U := U] \as SourceForms;
\import Forms.On[U := V] \as TargetForms;
\import Forms.Pullback[m := n, U := U, V := V, f := f] \as Pullback;
\definition signedFunction: Open.Smooth[].SmoothFunction U := SourceForms.evaluate n
  (Pullback.apply n (TargetForms.At[k := n].constant Top.volume)) Top.basisArguments;
\definition signedSmooth: Open.Smooth[].SmoothOn U signed :=
  \bysub(Open.ScalarFunction U, Open.Smooth[].SmoothFunction U, signedFunction);
