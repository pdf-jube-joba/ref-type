\import \parent.Jacobian[U := U, V := V, f := f] \as J;
\definition pullback[h: Open.ScalarFunction V][x: Open.Carrier U]: Real.Real := Real.mul (J.absolute x) (h (Maps.apply U V f x));
\definition nonnegative[h: Open.ScalarFunction V]: (\forall (y: Open.Carrier V) -> R.Le Real.zero (h y)) ->
  \forall (x: Open.Carrier U) -> R.Le Real.zero (pullback h x) :=
  \fun (positive: _)(x: Open.Carrier U) => Laws.fieldMulNonnegative _ _ (J.nonnegative x) (positive (Maps.apply U V f x));
\module Composition(W: Open.OpenSet, g: Maps.Map V W);
\module Inverse(e: Diffeomorphisms.Diffeomorphism U V, agrees: e.forward = f);
