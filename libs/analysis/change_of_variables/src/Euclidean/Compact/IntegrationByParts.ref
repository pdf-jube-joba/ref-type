\import I.Linear[] \as Linear;
\definition left: I.Representatives := representative (multiply (partial f i) g);
\definition right: I.Representatives := representative (multiply f (Partial.apply i g));
\definition productDerivative[x: Point]: partial (multiply f g) i x = Real.add (left x) (right x) :=
  congr!{{Functions.Function} Real.Real} (\fun (h: Functions.Function) => h (Whole.point x)) _ _ (Partial.product i (function f) g);
\definition sumZero: Real.add (I.integral left) (I.integral right) = Real.zero := eq_reason_in!{Real.Real _
  "=" _ "by" { sym!{Real.Real} _ _ (Linear.integralAdd left right) }
  "=" _ "by" { IntegralEquality.integralPointwise (Linear.addRepresentative left right) (representative (partial (multiply f g) i))
    (\fun (x: Point) => sym!{Real.Real} _ _ (productDerivative x)) }
  "=" _ "by" { integralDerivative (multiply f g) i }
};
\definition theorem: I.integral left = Real.neg (I.integral right) :=
  Laws.addCancelRight _ _ (I.integral right) (trans!{Real.Real} _ _ _ sumZero
    (sym!{Real.Real} _ _ (Laws.addNegLeft (I.integral right))));
