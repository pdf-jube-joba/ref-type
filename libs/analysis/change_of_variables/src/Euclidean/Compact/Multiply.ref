\definition function[x: Point]: Real.Real := Real.mul (f x) (g (Whole.point x));
\definition compact: Sets.IsCompactIn Ambient.topology (Smooth.support function) :=
  Support.compactSupportWithin Ambient.topology function (Smooth.support f) (L.smoothCompactLaws f).compact
    (Support.supportWithinClosed Ambient.topology function (Smooth.support f) (Support.supportClosed Ambient.topology f)
      (\fun (x: Point)(outside: _) => trans!{Real.Real} _ _ _
        (congr!{Real.Real Real.Real} (\fun (a: Real.Real) => Real.mul a (g (Whole.point x))) _ _ (Support.zeroOutsideSupport Ambient.topology f x outside))
        (Laws.fieldMulZeroLeft _)));
\definition value: L.SmoothCompact := \into[L.Function](function, L.SmoothCompact) \by {
  L.SmoothCompactLaws[function] {
    smooth := Open.Smooth[].Operations[].mulSmooth Open.whole _ _ (L.smoothCompactLaws f).smooth
      (\bysub(Open.ScalarFunction Open.whole, Functions.Function, g)),
    compact := compact,
  }
};
