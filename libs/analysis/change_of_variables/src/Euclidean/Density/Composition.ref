\import \root.Euclidean[n := n].Density[U := U, V := V, f := f] \as Base;
\import Maps.Composition[U := U, V := V, f := f].After[l := n, W := W, g := g] \as Composite;
\import \parent.\parent.Density[U := V, V := W, f := g] \as Outer;
\import \parent.\parent.Density[U := U, V := W, f := Composite.compose] \as Result;
\definition law[h: Open.ScalarFunction W][x: Open.Carrier U]: Result.pullback h x = Base.pullback (Outer.pullback h) x :=
  trans!{Real.Real} _ _ _
    (congr!{Real.Real Real.Real} (\fun (a: Real.Real) => Real.mul a (h (Maps.apply U W Composite.compose x))) _ _
      (J.Composition[W := W, g := g].absolute x))
    (trans!{Real.Real} _ _ _
      (congr!{Real.Real Real.Real} (\fun (a: Real.Real) => Real.mul a (h (Maps.apply U W Composite.compose x))) _ _
        (Laws.fieldMulComm (\parent.\parent.Jacobian[U := V, V := W, f := g].absolute (Maps.apply U V f x)) (J.absolute x)))
      (Laws.fieldMulAssoc (J.absolute x) (\parent.\parent.Jacobian[U := V, V := W, f := g].absolute (Maps.apply U V f x)) (h (Maps.apply U W Composite.compose x))));
