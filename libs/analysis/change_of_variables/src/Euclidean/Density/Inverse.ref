\import \root.Euclidean[n := n].Density[U := U, V := V, f := f] \as Base;
\import \parent.\parent.Density[U := V, V := U, f := e.backward] \as Backward;
\definition law[h: Open.ScalarFunction U][x: Open.Carrier U]: Base.pullback (Backward.pullback h) x = h x := eq_reason_in!{Real.Real _
  "=" _ "by" { sym!{Real.Real} _ _ (Laws.fieldMulAssoc (J.absolute x)
    (\parent.\parent.Jacobian[U := V, V := U, f := e.backward].absolute (Maps.apply U V f x))
    (h (Maps.apply V U e.backward (Maps.apply U V f x)))) }
  "=" _ "by" { congr!{Real.Real Real.Real Real.Real} Real.mul _ _ _ _
    (trans!{Real.Real} _ _ _ (Laws.fieldMulComm _ _) (J.Inverse[e := e, agrees := agrees].cancellation x))
    (congr!{{Open.Carrier U} Real.Real} h _ _ (trans!{{Open.Carrier U}} _ _ _
      (congr!{{Open.Carrier V} {Open.Carrier U}} (Maps.apply V U e.backward) _ _
        (sym!{{Open.Carrier V}} _ _ (congr!{{Maps.Map U V} {Open.Carrier V}} (\fun (g: Maps.Map U V) => Maps.apply U V g x) _ _ agrees)))
      (e.leftInverse x))) }
  "=" _ "by" { Laws.fieldMulOneLeft (h x) }
};
