\import Forms.On[U := U] \as Source;
\import Forms.On[U := V] \as Target;
\import Forms.Pullback[m := n, U := U, V := V, f := f] \as Pullback;
\import \parent.Jacobian[U := U, V := V, f := f] \as J;
\definition coefficient[omega: Target.Form n]: Open.Smooth[].SmoothFunction V := Target.evaluate n omega Top.basisArguments;
\definition formula[omega: Target.Form n][x: Open.Carrier U][arguments: Top.Arguments]:
  Pullback.apply n omega x arguments = Real.mul (J.signed x) (omega (Maps.apply U V f x) arguments) :=
  Top.action (J.differential x) (omega (Maps.apply U V f x)) arguments;
\definition coordinate[omega: Target.Form n][x: Open.Carrier U]:
  Source.evaluate n (Pullback.apply n omega) Top.basisArguments x = Real.mul (J.signed x) (coefficient omega (Maps.apply U V f x)) :=
  formula omega x Top.basisArguments;
