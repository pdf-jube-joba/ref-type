\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\use Equality.eq_reason_in;
\import real.Analysis[] \as Real;
\import Real.Algebra[] \as Algebra;
\import linear_algebra.Commutative[K := Real.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Real.Real Algebra.field] \as Spaces;
\import Spaces.Coordinates[I := Fin.Fin n] \as Vectors;
\import Spaces.FiniteCoordinates[n := n] \as Basis;
\import Vectors.Kronecker[] \as Kronecker;
\import Spaces.Multilinear[V := Vectors.Vector, space := Vectors.space] \as Multilinear;
\import Multilinear.Properties[] \as Updates;
\import matrix_invariants.Ring[K := Real.Real, scalars := std.Alg[].Field[].fieldAsCommutativeRing Real.Real Algebra.field].At[n := n] \as Matrix;
\import Matrix.Rows[] \as Rows;
\import Matrix.Operations[] \as MatrixOperations;
\import Spaces.Linear[V := Vectors.Vector, W := Real.Real, source := Vectors.space, target := Spaces.scalarSpace] \as Dual;
\import Spaces.Finite[V := Vectors.Vector, I := Fin.Fin n, space := Vectors.space].Prop[] \as Expansion;
\import Spaces.Sums[I := Fin.Fin n].Prop[] \as Sums;
\definition Index: \Set := Fin.Fin n;
\definition Point: \Set := Vectors.Vector;
\definition replaceRow[pivot: Index][row: Point]: Matrix.Matrix := Multilinear.update n Matrix.identity pivot row;
\module Row(pivot: Index);
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\module Replace(U: Open.OpenSet, h: Open.Smooth[].SmoothFunction U, pivot: Index);
\module Pivot;
\module Slicing(m: N.Nat^);
\module Block;
\module First;
\import calculus.Diffeomorphism[n := n, m := n] \as Diffeomorphisms;
\module Factor(U, V: Open.OpenSet, f: Diffeomorphisms.Diffeomorphism U V, pivot: Index);
\module Swap(first, second: Index);
\module Pivoted(U, V: Open.OpenSet, f: Diffeomorphisms.Diffeomorphism U V, row, pivot: Index);
\module Nonsingular(U, V: Open.OpenSet, f: Diffeomorphisms.Diffeomorphism U V);
