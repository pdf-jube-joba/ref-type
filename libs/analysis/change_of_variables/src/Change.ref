\import std.Data[].Nat[] \as N;
\module In(n: N.Nat^);
\module Step(n: N.Nat^, induction: \root.FiberChange[n := n].Hypothesis,
  single: \root.Change[].In[n := N.Nat^::succ n].SingleProperty);
\module Last(n: N.Nat^);
\definition zero: \root.FiberChange[n := N.Nat^::zero].Hypothesis :=
  \fun (U, V: calculus.Real[].Multivariable[n := N.Nat^::zero].Open[].OpenSet)
    (e: calculus.Diffeomorphism[n := N.Nat^::zero, m := N.Nat^::zero].Diffeomorphism U V)
    (f: lp_spaces.Euclidean[n := N.Nat^::zero].SmoothCompact)
    (within: topology.Topology[Carrier := euclidean_measure.Euclidean[n := N.Nat^::zero].Point].Subset
      (smooth_partitions.Euclidean[n := N.Nat^::zero].support f) V.points) =>
    \root.ZeroDimension[].Of[U := U, V := V, e := e, f := f, within := within].theorem;
\definition theorem: \forall (n: N.Nat^) -> \root.FiberChange[n := n].Hypothesis :=
  \induction (n: N.Nat^) \return \root.FiberChange[n := n].Hypothesis \with {
    | zero: zero
    | succ: \fun (n: N.Nat^)(previous: \root.FiberChange[n := n].Hypothesis) =>
      \root.Change[].Step[n := n, induction := previous, single := \root.Change[].Last[n := n].successor].theorem
  };
