/* Reduce an elementary shear to the one-dimensional Tonelli translation. */
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Data[].Sum[] \as Sum;
\import std.Data[].Pair[] \as Pair;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Classical[] \as Classical;
\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.trans;
\use Equality.sym;
\use Equality.eq_reason_in;
\definition one: N.Nat^ := N.Nat^::succ N.Nat^::zero;
\import Fin.Sum[m := n, n := one] \as Index;
\import Index.Tuples[A := real.Analysis[].Real] \as Tuples;
\import \root.Linear[n := Index.total] \as Linear;
\import \root.Elementary[n := Index.total] \as Elementary;
\import \root.Shear[n := n] \as Slices;
\import Linear.Rules[] \as Rules;
\import Linear.Geometry[] \as Geometry;
\import real.Analysis[] \as Real;
\import Real.Algebra[] \as Algebra;
\import Real.Estimates[].Product[] \as Absolute;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import linear_algebra.Commutative[K := Real.Real, scalarRing := std.Alg[].Field[].fieldAsCommutativeRing Real.Real Algebra.field] \as Spaces;
\import Spaces.Coordinates[I := Fin.Fin Index.total] \as Coordinates;
\import Spaces.Linear[V := Linear.Point, W := Linear.Point, source := Coordinates.space, target := Coordinates.space] \as Maps;
\import Maps.Composition[U := Linear.Point, domain := Coordinates.space] \as Composition;
\import euclidean_measure.Euclidean[n := Index.total] \as E;
\import E.Borel[] \as Borel;
\import topological_algebra.Euclidean[].Dimension[n := Index.total].Topology[] \as Ambient;
\import functional_analysis.Measure[A := E.Point] \as M;
\import M.ValueLaws[] \as Values;
\import topology.Topology[Carrier := E.Point] \as Sets;
\import euclidean_measure.Euclidean[n := n] \as Tail;
\import euclidean_measure.Euclidean[n := one] \as Head;
\import N.Basic[].Prop[] \as Nat;
\definition oneNat: \forall (k: N.Nat^) -> Nat.Lt k one -> N.Nat^::zero = k :=
  \induction (k: N.Nat^) \return Nat.Lt k one -> N.Nat^::zero = k \with {
    | zero: \fun (bound: _) => \refl(N.Nat^::zero)
    | succ: \fun (k: N.Nat^)(previous: _)(bound: _) => Logic.falseElim (N.Nat^::zero = N.Nat^::succ k) (Fin.zeroImpossible k bound)
  };
\definition oneEqual[k: Fin.Fin one]: Fin.zero N.Nat^::zero = k := oneNat k (Fin.bound one k);
\definition last: Fin.Fin Index.total := Index.right (Fin.zero N.Nat^::zero);
\module At(j: Fin.Fin n, t: Real.Real);
\module Arbitrary(i, j: Fin.Fin Index.total, t: Real.Real);
