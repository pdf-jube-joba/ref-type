\import real.Analysis[].Algebra[] \as Algebra;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;

\definition Included[v, w: Value]: \Prop := \forall (r: Real.Real) -> below v r -> below w r;

\definition addMono: \forall (v, v2, w, w2: Value) -> Included v v2 -> Included w w2 ->
  Included (add v w) (add v2 w2) :=
  \fun (v, v2, w, w2: Value) (left: Included v v2) (right: Included w w2) (r: Real.Real) (member: below (add v w) r) => \block {
    \takefrom a: \Cast[Real.Real] ({ a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] )] }) \by member \then
    \let first: Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] )] :=
      \bysub(Real.Real, { a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] )] }, a) \then
    \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] }) \by first.right \then
    \let second: Logic.And[below w b, R.Lt r (Real.add a b)] :=
      \bysub(Real.Real, { b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] }, b) \then
    \return Logic.existsIntro[Real.Real, { a: Real.Real \where Logic.And[below v2 a, \exists ( b: Real.Real \where Logic.And[below w2 b, R.Lt r (Real.add a b)] )] }] a
      (Logic.And[_, _]::# (left a first.left)
        (Logic.existsIntro[Real.Real, { b: Real.Real \where Logic.And[below w2 b, R.Lt r (Real.add a b)] }] b
          (Logic.And[_, _]::# (right b second.left) second.right)))
  };

\definition addSwap: \forall (v, w: Value) -> Included (add v w) (add w v) :=
  \fun (v, w: Value) (r: Real.Real) (member: below (add v w) r) => \block {
    \takefrom a: \Cast[Real.Real] ({ a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] )] }) \by member \then
    \let first: Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] )] :=
      \bysub(Real.Real, { a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] )] }, a) \then
    \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] }) \by first.right \then
    \let second: Logic.And[below w b, R.Lt r (Real.add a b)] :=
      \bysub(Real.Real, { b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] }, b) \then
    \return Logic.existsIntro[Real.Real, { b: Real.Real \where Logic.And[below w b, \exists ( a: Real.Real \where Logic.And[below v a, R.Lt r (Real.add b a)] )] }] b
      (Logic.And[_, _]::# second.left
        (Logic.existsIntro[Real.Real, { a: Real.Real \where Logic.And[below v a, R.Lt r (Real.add b a)] }] a
          (Logic.And[_, _]::# first.left (R.ltReplaceRight r (Real.add a b) (Real.add b a) (Laws.addComm a b) second.right))))
  };
\definition addComm: \forall (v, w: Value) -> add v w = add w v :=
  \fun (v, w: Value) => \axiom:setext(add v w, add w v, addSwap v w, addSwap w v);

\import real.Analysis[].Estimates[] \as E;
\import dedekind_reals.DedekindReal[].Order[] \as Order;
\definition addZeroContained: \forall (v: Value) -> NonnegativeValue[v] -> Included (add v zero) v :=
  \fun (v: Value) (law: NonnegativeValue[v]) (r: Real.Real) (member: below (add v zero) r) => \block {
    \takefrom a: \Cast[Real.Real] ({ a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below zero b, R.Lt r (Real.add a b)] )] }) \by member \then
    \let first: Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below zero b, R.Lt r (Real.add a b)] )] :=
      \bysub(Real.Real, { a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below zero b, R.Lt r (Real.add a b)] )] }, a) \then
    \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where Logic.And[below zero b, R.Lt r (Real.add a b)] }) \by first.right \then
    \let second: Logic.And[below zero b, R.Lt r (Real.add a b)] :=
      \bysub(Real.Real, { b: Real.Real \where Logic.And[below zero b, R.Lt r (Real.add a b)] }, b) \then
    \return law.downward r a (Order.ltTrans r (Real.add a b) a second.right
      (R.ltReplaceRight (Real.add a b) (Real.add a Real.zero) a (Laws.addZeroRight a)
        (Laws.ltAddLeft a b Real.zero second.left))) first.left
  };
\definition containedAddZero: \forall (v: Value) -> NonnegativeValue[v] -> Included v (add v zero) :=
  \fun (v: Value) (law: NonnegativeValue[v]) (r: Real.Real) (member: below v r) => \block {
    \takefrom s: \Cast[Real.Real] ({ s: Real.Real \where Logic.And[R.Lt r s, below v s] }) \by law.rounded r member \then
    \let first: Logic.And[R.Lt r s, below v s] := \bysub(Real.Real, { s: Real.Real \where Logic.And[R.Lt r s, below v s] }, s) \then
    \takefrom a: \Cast[Real.Real] ({ a: Real.Real \where Logic.And[R.Lt s a, below v a] }) \by law.rounded s first.right \then
    \let second: Logic.And[R.Lt s a, below v a] := \bysub(Real.Real, { a: Real.Real \where Logic.And[R.Lt s a, below v a] }, a) \then
    \let negative: R.Lt (Real.sub s a) Real.zero :=
      R.ltReplaceRight (Real.sub s a) (Real.sub a a) Real.zero (Laws.subSelf a)
        (Laws.ltAddRight s a (Real.neg a) second.left) \then
    \return Logic.existsIntro[Real.Real, { a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below zero b, R.Lt r (Real.add a b)] )] }] a
      (Logic.And[_, _]::# second.right
        (Logic.existsIntro[Real.Real, { b: Real.Real \where Logic.And[below zero b, R.Lt r (Real.add a b)] }] (Real.sub s a)
          (Logic.And[_, _]::# negative (R.ltReplaceRight r s (Real.add a (Real.sub s a))
            (\idelim Real.add a (Real.sub s a) = s \with x: Real.Real => x = Real.add a (Real.sub s a) \by { base: \refl(Real.add a (Real.sub s a)), equality: E.addSubCancel s a }) first.left))))
  };
\definition addZero: \forall (v: Value) -> NonnegativeValue[v] -> add v zero = v :=
  \fun (v: Value) (law: NonnegativeValue[v]) => \axiom:setext(add v zero, v, addZeroContained v law, containedAddZero v law);

\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].eq_reason_in;
\use std.Logic[].Equality[].congr;
\definition reassociateWitness: \forall (a, b, c, d: Real.Real) ->
  R.Lt d (Real.add a b) -> R.Lt (Real.add (Real.sub d a) c) (Real.add b c) :=
  \fun (a, b, c, d: Real.Real) (less: R.Lt d (Real.add a b)) =>
    Laws.ltAddRight (Real.sub d a) b c
      (Laws.ltAddCancelLeft a (Real.sub d a) b
        (R.ltReplaceLeft d (Real.add a (Real.sub d a)) (Real.add a b)
          (sym!{Real.Real} _ _ (E.addSubCancel d a)) less));
\definition reassociateValue: \forall (a, c, d: Real.Real) ->
  Real.add a (Real.add (Real.sub d a) c) = Real.add d c :=
  \fun (a, c, d: Real.Real) => eq_reason_in!{Real.Real _
    "=" _ "by" { sym!{Real.Real} _ _ (Laws.addAssoc a (Real.sub d a) c) }
    "=" _ "by" { congr!{Real.Real Real.Real} (\fun (x: Real.Real) => Real.add x c) _ _ (E.addSubCancel d a) }
  };
\definition addAssocForward: \forall (u, v, w: Value) -> Included (add (add u v) w) (add u (add v w)) :=
  \fun (u, v, w: Value) (r: Real.Real) (member: below (add (add u v) w) r) => \block {
    \takefrom d: \Cast[Real.Real] ({ d: Real.Real \where Logic.And[below (add u v) d, \exists ( c: Real.Real \where Logic.And[below w c, R.Lt r (Real.add d c)] )] }) \by member \then
    \let outer: Logic.And[below (add u v) d, \exists ( c: Real.Real \where Logic.And[below w c, R.Lt r (Real.add d c)] )] :=
      \bysub(Real.Real, { d: Real.Real \where Logic.And[below (add u v) d, \exists ( c: Real.Real \where Logic.And[below w c, R.Lt r (Real.add d c)] )] }, d) \then
    \takefrom c: \Cast[Real.Real] ({ c: Real.Real \where Logic.And[below w c, R.Lt r (Real.add d c)] }) \by outer.right \then
    \let last: Logic.And[below w c, R.Lt r (Real.add d c)] :=
      \bysub(Real.Real, { c: Real.Real \where Logic.And[below w c, R.Lt r (Real.add d c)] }, c) \then
    \takefrom a: \Cast[Real.Real] ({ a: Real.Real \where Logic.And[below u a, \exists ( b: Real.Real \where Logic.And[below v b, R.Lt d (Real.add a b)] )] }) \by outer.left \then
    \let first: Logic.And[below u a, \exists ( b: Real.Real \where Logic.And[below v b, R.Lt d (Real.add a b)] )] :=
      \bysub(Real.Real, { a: Real.Real \where Logic.And[below u a, \exists ( b: Real.Real \where Logic.And[below v b, R.Lt d (Real.add a b)] )] }, a) \then
    \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where Logic.And[below v b, R.Lt d (Real.add a b)] }) \by first.right \then
    \let second: Logic.And[below v b, R.Lt d (Real.add a b)] :=
      \bysub(Real.Real, { b: Real.Real \where Logic.And[below v b, R.Lt d (Real.add a b)] }, b) \then
    \let q: Real.Real := Real.add (Real.sub d a) c \then
    \let inTail: below (add v w) q :=
      Logic.existsIntro[Real.Real, { b: Real.Real \where Logic.And[below v b, \exists ( c: Real.Real \where Logic.And[below w c, R.Lt q (Real.add b c)] )] }] b
        (Logic.And[_, _]::# second.left (Logic.existsIntro[Real.Real, { c: Real.Real \where Logic.And[below w c, R.Lt q (Real.add b c)] }] c
          (Logic.And[_, _]::# last.left (reassociateWitness a b c d second.right)))) \then
    \return Logic.existsIntro[Real.Real, { a: Real.Real \where Logic.And[below u a, \exists ( q: Real.Real \where Logic.And[below (add v w) q, R.Lt r (Real.add a q)] )] }] a
      (Logic.And[_, _]::# first.left (Logic.existsIntro[Real.Real, { q: Real.Real \where Logic.And[below (add v w) q, R.Lt r (Real.add a q)] }] q
        (Logic.And[_, _]::# inTail (R.ltReplaceRight r (Real.add d c) (Real.add a q) (sym!{Real.Real} _ _ (reassociateValue a c d)) last.right))))
  };

\definition addAssocReverse: \forall (u, v, w: Value) -> Included (add u (add v w)) (add (add u v) w) :=
  \fun (u, v, w: Value) (r: Real.Real) (member: below (add u (add v w)) r) => \block {
    \let first: below (add (add v w) u) r := addSwap u (add v w) r member \then
    \let second: below (add (add w v) u) r :=
      \idelim add v w = add w v \with x: Value => below (add x u) r \by { base: first, equality: addComm v w } \then
    \let third: below (add w (add v u)) r := addAssocForward w v u r second \then
    \let fourth: below (add (add v u) w) r := addSwap w (add v u) r third \then
    \return \idelim add v u = add u v \with x: Value => below (add x w) r \by { base: fourth, equality: addComm v u }
  };
\definition addAssoc: \forall (u, v, w: Value) -> add (add u v) w = add u (add v w) :=
  \fun (u, v, w: Value) => \axiom:setext(add (add u v) w, add u (add v w), addAssocForward u v w, addAssocReverse u v w);

\import real.Analysis[].SquareRoot[] \as SquareRoot;
\import real.Analysis[].Estimates[].Product[] \as ProductLaws;
\definition midpointStrictLeft: \forall (a, b: Real.Real) -> R.Lt a b -> R.Lt a (Real.midpoint a b) :=
  \fun (a, b: _) (less: _) => SquareRoot.addPositive a (Real.mul Real.half (Real.sub b a))
    (E.halfOfPositive (Real.sub b a) (SquareRoot.subPositive b a less));
\definition midpointStrictRight: \forall (a, b: Real.Real) -> R.Lt a b -> R.Lt (Real.midpoint a b) b :=
  \fun (a, b: _) (less: _) => R.ltReplaceRight _ (Real.add a (Real.sub b a)) b (E.addSubCancel b a)
    (Laws.ltAddLeft a (Real.mul Real.half (Real.sub b a)) (Real.sub b a)
      (E.halfStrict (Real.sub b a) (SquareRoot.subPositive b a less)));
\definition halfNegative: \forall (x: Real.Real) -> R.Lt x Real.zero -> R.Lt (Real.mul Real.half x) Real.zero :=
  \fun (x: _) (negative: _) => R.ltReplaceRight (Real.mul Real.half x) (Real.mul Real.half Real.zero) Real.zero
    (Laws.fieldMulZeroRight Real.half)
    (ProductLaws.mulStrict Real.half x Real.zero (Laws.ltOfRat (std.Arithmetic[].Rat[].Estimates[].zeroRat) (std.Arithmetic[].Rat[].Estimates[].halfRat) (std.Arithmetic[].Rat[].Estimates[].halfPositive)) negative);

\definition addNonnegative: \forall (v, w: Value) -> NonnegativeValue[v] -> NonnegativeValue[w] -> NonnegativeValue[add v w] :=
  \fun (v, w: Value) (vl: NonnegativeValue[v]) (wl: NonnegativeValue[w]) => NonnegativeValue[add v w] {
    negative := \fun (r: Real.Real) (negative: R.Lt r Real.zero) => \block {
      \let q: Real.Real := Real.midpoint r Real.zero \then
      \let qNegative: R.Lt q Real.zero := midpointStrictRight r Real.zero negative \then
      \let h: Real.Real := Real.mul Real.half q \then
      \let hNegative: R.Lt h Real.zero := halfNegative q qNegative \then
      \return Logic.existsIntro[Real.Real, { a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] )] }] h
        (Logic.And[_, _]::# (vl.negative h hNegative)
          (Logic.existsIntro[Real.Real, { b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add h b)] }] h
            (Logic.And[_, _]::# (wl.negative h hNegative)
              (R.ltReplaceRight r q (Real.add h h) (sym!{Real.Real} _ _ (E.halfTwice q)) (midpointStrictLeft r Real.zero negative)))))
    },
    downward := \fun (r, s: Real.Real) (less: R.Lt r s) (member: below (add v w) s) => \block {
      \takefrom a: \Cast[Real.Real] ({ a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt s (Real.add a b)] )] }) \by member \then
      \let first: Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt s (Real.add a b)] )] :=
        \bysub(Real.Real, { a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt s (Real.add a b)] )] }, a) \then
      \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where Logic.And[below w b, R.Lt s (Real.add a b)] }) \by first.right \then
      \let second: Logic.And[below w b, R.Lt s (Real.add a b)] := \bysub(Real.Real, { b: Real.Real \where Logic.And[below w b, R.Lt s (Real.add a b)] }, b) \then
      \return Logic.existsIntro[Real.Real, { a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] )] }] a
        (Logic.And[_, _]::# first.left (Logic.existsIntro[Real.Real, { b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] }] b
          (Logic.And[_, _]::# second.left (Order.ltTrans r s (Real.add a b) less second.right))))
    },
    rounded := \fun (r: Real.Real) (member: below (add v w) r) => \block {
      \takefrom a: \Cast[Real.Real] ({ a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] )] }) \by member \then
      \let first: Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] )] :=
        \bysub(Real.Real, { a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] )] }, a) \then
      \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] }) \by first.right \then
      \let second: Logic.And[below w b, R.Lt r (Real.add a b)] := \bysub(Real.Real, { b: Real.Real \where Logic.And[below w b, R.Lt r (Real.add a b)] }, b) \then
      \let s: Real.Real := Real.midpoint r (Real.add a b) \then
      \return Logic.existsIntro[Real.Real, { s: Real.Real \where Logic.And[R.Lt r s, below (add v w) s] }] s
        (Logic.And[_, _]::# (midpointStrictLeft r (Real.add a b) second.right)
          (Logic.existsIntro[Real.Real, { a: Real.Real \where Logic.And[below v a, \exists ( b: Real.Real \where Logic.And[below w b, R.Lt s (Real.add a b)] )] }] a
            (Logic.And[_, _]::# first.left (Logic.existsIntro[Real.Real, { b: Real.Real \where Logic.And[below w b, R.Lt s (Real.add a b)] }] b
              (Logic.And[_, _]::# second.left (midpointStrictRight r (Real.add a b) second.right))))))
    },
  };
