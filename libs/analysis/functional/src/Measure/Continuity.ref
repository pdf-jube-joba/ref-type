\import \root.Measure[A := A].Sigma[] \as Sigma;
\import \root.Measure[A := A].Finite[mu := mu] \as Finite;
\import \root.Measure[A := A].AlmostEverywhere[mu := mu] \as AE;
\use std.Logic[].Equality[].eq_reason_in;
\use std.Logic[].Equality[].congr;
\use std.Logic[].Equality[].sym;
\definition prefixIncrementDisjoint: \forall (f: N.Nat^ -> \Pow A) (n: N.Nat^) -> Sets.Disjoint (Sigma.prefix f n) (Sigma.increments f n) :=
  \fun (f: N.Nat^ -> \Pow A) (n: N.Nat^) (x: A) (previous: Sets.Member (Sigma.prefix f n) x)
    (increment: Sets.Member (Sigma.increments f n) x) => increment.right previous;
\definition prefixSum: \forall (f: N.Nat^ -> \Pow A) -> (\forall (n: N.Nat^) -> Measurable mu.sigma (f n)) ->
  \forall (n: N.Nat^) -> mu.value (Sigma.prefix f n) = partialSum (\fun (k: N.Nat^) => mu.value (Sigma.increments f k)) n :=
  \fun (f: N.Nat^ -> \Pow A) (measurable: \forall (n: N.Nat^) -> Measurable mu.sigma (f n)) =>
    \induction (n: N.Nat^) \return mu.value (Sigma.prefix f n) = partialSum (\fun (k: N.Nat^) => mu.value (Sigma.increments f k)) n \with {
      | zero: Finite.laws.empty
      | succ: \fun (n: N.Nat^) (previous: _) => eq_reason_in!{Value _
        "=" _ "by" { congr!{{\Pow A} Value} mu.value _ _ (AE.unionDifference (Sigma.prefix f n) (f n)) }
        "=" _ "by" { Finite.additivity (Sigma.prefix f n) (Sigma.increments f n)
          (Sigma.prefixMeasurable mu.sigma f measurable n) (Sigma.incrementsMeasurable mu.sigma f measurable n) (prefixIncrementDisjoint f n) }
        "=" _ "by" { congr!{Value Value} (\fun (v: Value) => add v (mu.value (Sigma.increments f n))) _ _ previous }
      }
    };
\definition prefixSeries: \forall (f: N.Nat^ -> \Pow A) -> (\forall (n: N.Nat^) -> Measurable mu.sigma (f n)) ->
  series (\fun (n: N.Nat^) => mu.value (Sigma.increments f n)) = { r: Real.Real \where \exists ( n: N.Nat^ \where below (mu.value (Sigma.prefix f n)) r ) } :=
  \fun (f: N.Nat^ -> \Pow A) (measurable: \forall (n: N.Nat^) -> Measurable mu.sigma (f n)) =>
    \axiom:setext(series (\fun (n: N.Nat^) => mu.value (Sigma.increments f n)), { r: Real.Real \where \exists ( n: N.Nat^ \where below (mu.value (Sigma.prefix f n)) r ) },
      \fun (r: Real.Real) (member: below (series (\fun (n: N.Nat^) => mu.value (Sigma.increments f n))) r) => \block {
        \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where below (partialSum (\fun (k: N.Nat^) => mu.value (Sigma.increments f k)) n) r }) \by member \then
        \return Logic.existsIntro[N.Nat^, { n: N.Nat^ \where below (mu.value (Sigma.prefix f n)) r }] n
          (\idelim partialSum (\fun (k: N.Nat^) => mu.value (Sigma.increments f k)) n = mu.value (Sigma.prefix f n) \with v: Value => below v r
            \by { base: \bysub(N.Nat^, { n: N.Nat^ \where below (partialSum (\fun (k: N.Nat^) => mu.value (Sigma.increments f k)) n) r }, n), equality: sym!{Value} _ _ (prefixSum f measurable n) })
      },
      \fun (r: Real.Real) (member: \exists ( n: N.Nat^ \where below (mu.value (Sigma.prefix f n)) r )) => \block {
        \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where below (mu.value (Sigma.prefix f n)) r }) \by member \then
        \return Logic.existsIntro[N.Nat^, { n: N.Nat^ \where below (partialSum (\fun (k: N.Nat^) => mu.value (Sigma.increments f k)) n) r }] n
          (\idelim mu.value (Sigma.prefix f n) = partialSum (\fun (k: N.Nat^) => mu.value (Sigma.increments f k)) n \with v: Value => below v r
            \by { base: \bysub(N.Nat^, { n: N.Nat^ \where below (mu.value (Sigma.prefix f n)) r }, n), equality: prefixSum f measurable n })
      });
\definition unionAsPrefixSup: \forall (f: N.Nat^ -> \Pow A) -> (\forall (n: N.Nat^) -> Measurable mu.sigma (f n)) ->
  mu.value (union f) = { r: Real.Real \where \exists ( n: N.Nat^ \where below (mu.value (Sigma.prefix f n)) r ) } :=
  \fun (f: N.Nat^ -> \Pow A) (measurable: \forall (n: N.Nat^) -> Measurable mu.sigma (f n)) => eq_reason_in!{Value _
    "=" _ "by" { congr!{{\Pow A} Value} mu.value _ _ (sym!{{\Pow A}} _ _ (Sigma.incrementUnion f)) }
    "=" _ "by" { Finite.laws.countableAdditivity (Sigma.increments f) (Sigma.incrementsMeasurable mu.sigma f measurable) (Sigma.incrementsDisjoint f) }
    "=" _ "by" { prefixSeries f measurable }
  };

\definition Increasing[f: N.Nat^ -> \Pow A]: \Prop :=
  \forall (n: N.Nat^) -> Sets.Subset (f n) (f (N.Nat^::succ n));
\definition prefixBelow: \forall (f: N.Nat^ -> \Pow A) -> Increasing f -> \forall (n: N.Nat^) -> Sets.Subset (Sigma.prefix f n) (f n) :=
  \fun (f: N.Nat^ -> \Pow A) (increasing: Increasing f) => \induction (n: N.Nat^) \return Sets.Subset (Sigma.prefix f n) (f n) \with {
    | zero: \fun (x: A) (empty: Logic.False) => Logic.falseElim _ empty
    | succ: \fun (n: N.Nat^) (previous: _) (x: A) (member: Sets.Member (Sigma.prefix f (N.Nat^::succ n)) x) =>
      Logic.orElim _ _ (Sets.Member (f (N.Nat^::succ n)) x) member
        (\fun (before: Sets.Member (Sigma.prefix f n) x) => increasing n x (previous x before))
        (\fun (current: Sets.Member (f n) x) => increasing n x current)
  };
\definition increasingSup: \forall (f: N.Nat^ -> \Pow A) -> (\forall (n: N.Nat^) -> Measurable mu.sigma (f n)) -> Increasing f ->
  mu.value (union f) = { r: Real.Real \where \exists ( n: N.Nat^ \where below (mu.value (f n)) r ) } :=
  \fun (f: N.Nat^ -> \Pow A) (measurable: \forall (n: N.Nat^) -> Measurable mu.sigma (f n)) (increasing: Increasing f) => eq_reason_in!{Value _
    "=" _ "by" { unionAsPrefixSup f measurable }
    "=" _ "by" { \axiom:setext({ r: Real.Real \where \exists ( n: N.Nat^ \where below (mu.value (Sigma.prefix f n)) r ) },
      { r: Real.Real \where \exists ( n: N.Nat^ \where below (mu.value (f n)) r ) },
      \fun (r: Real.Real) (member: \exists ( n: N.Nat^ \where below (mu.value (Sigma.prefix f n)) r )) => \block {
        \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where below (mu.value (Sigma.prefix f n)) r }) \by member \then
        \return Logic.existsIntro[N.Nat^, { n: N.Nat^ \where below (mu.value (f n)) r }] n
          (Finite.monotone (Sigma.prefix f n) (f n) (Sigma.prefixMeasurable mu.sigma f measurable n) (measurable n) (prefixBelow f increasing n) r
            (\bysub(N.Nat^, { n: N.Nat^ \where below (mu.value (Sigma.prefix f n)) r }, n)))
      },
      \fun (r: Real.Real) (member: \exists ( n: N.Nat^ \where below (mu.value (f n)) r )) => \block {
        \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where below (mu.value (f n)) r }) \by member \then
        \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where below (mu.value (Sigma.prefix f k)) r }] (N.Nat^::succ n)
          (Finite.monotone (f n) (Sigma.prefix f (N.Nat^::succ n)) (measurable n) (Sigma.prefixMeasurable mu.sigma f measurable (N.Nat^::succ n))
            (Sigma.prefixContainsCurrent f n) r (\bysub(N.Nat^, { n: N.Nat^ \where below (mu.value (f n)) r }, n)))
      }) }
  };
