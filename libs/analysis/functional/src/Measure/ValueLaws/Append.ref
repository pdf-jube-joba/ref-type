\import Fin.Sum[m := m, n := n] \as Indices;
\import Indices.Tuples[A := Value] \as Tuples;
\definition total: N.Nat^ := Indices.total;
\definition join[f: Fin.Fin m -> Value] [g: Fin.Fin n -> Value]: Fin.Fin total -> Value := Tuples.join f g;
\definition atLeft: \forall (f: Fin.Fin m -> Value) (g: Fin.Fin n -> Value) (i: Fin.Fin m) -> join f g (Indices.left i) = f i := Tuples.atLeft;
\definition atRight: \forall (f: Fin.Fin m -> Value) (g: Fin.Fin n -> Value) (i: Fin.Fin n) -> join f g (Indices.right i) = g i := Tuples.atRight;
