\use std.Logic[].Equality[].eq_reason_in;
\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].congr;
\definition joinedSum: \forall (m: N.Nat^) (f: Fin.Fin m -> Value) (g: Fin.Fin n -> Value) ->
  (\forall (i: Fin.Fin m) -> NonnegativeValue[f i]) -> (\forall (j: Fin.Fin n) -> NonnegativeValue[g j]) ->
  sum (Append[m := m, n := n].total) (Append[m := m, n := n].join f g) = add (sum m f) (sum n g) :=
  \induction (m: N.Nat^) \return \forall (f: Fin.Fin m -> Value) (g: Fin.Fin n -> Value) ->
    (\forall (i: Fin.Fin m) -> NonnegativeValue[f i]) -> (\forall (j: Fin.Fin n) -> NonnegativeValue[g j]) ->
    sum (Append[m := m, n := n].total) (Append[m := m, n := n].join f g) = add (sum m f) (sum n g) \with {
      | zero: \fun (f: Fin.Fin N.Nat^::zero -> Value) (g: Fin.Fin n -> Value) (_: _) (gl: _) => eq_reason_in!{Value _
        "=" _ "by" { congr!{{Fin.Fin n -> Value} Value} (sum n) _ _
          (\axiom:funext(Append[m := N.Nat^::zero, n := n].join f g, g,
            \fun (i: Fin.Fin n) => Append[m := N.Nat^::zero, n := n].atRight f g i)) }
        "=" _ "by" { sym!{Value} _ _ (addZero (sum n g) (sumNonnegative n g gl)) }
        "=" _ "by" { addComm (sum n g) zero }
      }
      | succ: \fun (m: N.Nat^) (previous: _) (f: Fin.Fin (N.Nat^::succ m) -> Value) (g: Fin.Fin n -> Value) (fl: _) (gl: _) => eq_reason_in!{Value _
        "=" _ "by" { congr!{Value Value Value} add _ _ _ _ (AppendStep[m := m, n := n].head f g)
          (congr!{{Fin.Fin (Append[m := m, n := n].total) -> Value} Value} (sum (Append[m := m, n := n].total)) _ _ (AppendStep[m := m, n := n].tail f g)) }
        "=" _ "by" { congr!{Value Value} (add (f (Fin.zero m))) _ _
          (previous (\fun (i: Fin.Fin m) => f (Fin.succ m i)) g (\fun (i: Fin.Fin m) => fl (Fin.succ m i)) gl) }
        "=" _ "by" { sym!{Value} _ _ (addAssoc (f (Fin.zero m)) (sum m (\fun (i: Fin.Fin m) => f (Fin.succ m i))) (sum n g)) }
      }
    };
