\import \root.Measure[A := A].Integral[mu := mu].Null[] \as QuotientIntegral;

/* The quotient integral agrees with the value computed on any representative. */
\definition classValue: \forall (f: Representatives) -> QuotientIntegral.quotientIntegral (QuotientIntegral.class f) = integral f :=
  QuotientIntegral.quotientIntegralOfClass;

/* Almost-everywhere equal representatives produce the same integral. */
\definition equalValues: \forall (f, g: Representatives) -> AlmostEqual mu f g -> integral f = integral g :=
  QuotientIntegral.integralAlmost;
