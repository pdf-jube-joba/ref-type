\import \root.Measure[A := A].ValueLaws[] \as Values;
\import \root.Measure[A := A].Finite[mu := mu] \as FiniteMeasure;
\import std.Logic[].Classical[] \as Classical;
\use std.Logic[].Equality[].eq_reason_in;
\use std.Logic[].Equality[].congr;
\definition function: A -> Real.Real := \fun (_: A) => Real.zero;
\definition termZero: \forall (n: N.Nat^) (s: Simple[n]) -> Dominated n s function -> \forall (i: Fin.Fin n) ->
  scale (s.coefficients i) (mu.value (s.cells i)) = zero :=
  \fun (n: N.Nat^) (s: Simple[n]) (dominated: Dominated n s function) (i: Fin.Fin n) =>
    Logic.orElim _ _ (scale (s.coefficients i) (mu.value (s.cells i)) = zero) (Classical.excludedMiddle (\exists \Cast[A] (s.cells i)))
      (\fun (inhabited: \exists \Cast[A] (s.cells i)) => \block {
        \takefrom x: \Cast[A] (s.cells i) \by inhabited \then
        \let coefficientZero: s.coefficients i = Real.zero := R.leAntisym (s.coefficients i) Real.zero
          (dominated i x (\bysub(A, s.cells i, x))) (s.nonnegative i) \then
        \return eq_reason_in!{Value _
          "=" _ "by" { congr!{Real.Real Value} (\fun (c: Real.Real) => scale c (mu.value (s.cells i))) _ _ coefficientZero }
          "=" _ "by" { Values.zeroScale (mu.value (s.cells i)) (FiniteMeasure.laws.nonnegative (s.cells i) (s.measurable i)) }
        }
      })
      (\fun (empty: Logic.Not (\exists \Cast[A] (s.cells i))) => \block {
        \let equal: s.cells i = Sets.Empty := \axiom:setext(s.cells i, Sets.Empty,
          \fun (x: A) (member: Sets.Member (s.cells i) x) => empty (\exact(\into[A](x, s.cells i) \by { member }, \Cast[A] (s.cells i))),
          \fun (x: A) (impossible: Logic.False) => Logic.falseElim _ impossible) \then
        \return eq_reason_in!{Value _
          "=" _ "by" { congr!{{\Pow A} Value} (\fun (S: \Pow A) => scale (s.coefficients i) (mu.value S)) _ _ equal }
          "=" _ "by" { congr!{Value Value} (scale (s.coefficients i)) _ _ FiniteMeasure.laws.empty }
          "=" _ "by" { Values.scaleZeroValue (s.coefficients i) (s.nonnegative i) }
        }
      });
\definition simpleZero: \forall (n: N.Nat^) (s: Simple[n]) -> Dominated n s function -> simpleIntegral n s = zero :=
  \fun (n: N.Nat^) (s: Simple[n]) (dominated: Dominated n s function) => eq_reason_in!{Value _
    "=" _ "by" { congr!{{Fin.Fin n -> Value} Value} (sum n) _ _
      (\axiom:funext((\fun (i: Fin.Fin n) => scale (s.coefficients i) (mu.value (s.cells i))), (\fun (_: Fin.Fin n) => zero), termZero n s dominated)) }
    "=" _ "by" { Values.sumZero n }
  };
\definition lowerZero: lowerIntegral function = zero := \axiom:setext(lowerIntegral function, zero,
  \fun (r: Real.Real) (member: below (lowerIntegral function) r) => \block {
    \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where \exists ( s: Simple[n] \where Logic.And[Dominated n s function, below (simpleIntegral n s) r] ) }) \by member \then
    \takefrom s: \Cast[Simple[n]] ({ s: Simple[n] \where Logic.And[Dominated n s function, below (simpleIntegral n s) r] })
      \by (\bysub(N.Nat^, { n: N.Nat^ \where \exists ( s: Simple[n] \where Logic.And[Dominated n s function, below (simpleIntegral n s) r] ) }, n)) \then
    \let data: Logic.And[Dominated n s function, below (simpleIntegral n s) r] := \bysub(Simple[n], { s: Simple[n] \where Logic.And[Dominated n s function, below (simpleIntegral n s) r] }, s) \then
    \return \idelim simpleIntegral n s = zero \with v: Value => below v r \by { base: data.right, equality: simpleZero n s data.left }
  }, lowerIntegralNegative function);

\import \root.Measure[A := A].Sigma[] \as Sigma;
\import dedekind_reals.DedekindReal[].Order[] \as Order;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\import real.Analysis[].Distance[] \as Distance;
\use std.Logic[].Equality[].sym;
\definition measurable: IsMeasurable mu function := \fun (r: Real.Real) =>
  Logic.orElim _ _ (Measurable mu.sigma ({ x: A \where R.Lt r Real.zero })) (Classical.excludedMiddle (R.Lt r Real.zero))
    (\fun (less: R.Lt r Real.zero) => \idelim Sets.Whole = { x: A \where R.Lt r Real.zero } \with S: \Pow A => Measurable mu.sigma S \by {
      base: Sigma.wholeMeasurable mu.sigma,
      equality: \axiom:setext(Sets.Whole, { x: A \where R.Lt r Real.zero }, \fun (x: A) (_: x = x) => less, \fun (x: A) (_: R.Lt r Real.zero) => \refl(x))
    })
    (\fun (notLess: Logic.Not (R.Lt r Real.zero)) => \idelim Sets.Empty = { x: A \where R.Lt r Real.zero } \with S: \Pow A => Measurable mu.sigma S \by {
      base: (Sigma.laws mu.sigma).empty,
      equality: \axiom:setext(Sets.Empty, { x: A \where R.Lt r Real.zero }, \fun (x: A) (empty: Logic.False) => Logic.falseElim _ empty,
        \fun (x: A) (less: R.Lt r Real.zero) => notLess less)
    });
\definition finite: Finite function := Logic.And[_, _]::# (\fun (_: A) => R.leRefl Real.zero)
  (Logic.existsIntro[Real.Real, { b: Real.Real \where IntegralBound[function, b] }] Real.zero (IntegralBound[function, Real.zero] {
    nonnegative := R.leRefl Real.zero,
    bound := \fun (r: Real.Real) (member: below (lowerIntegral function) r) => Order.leOfLt r Real.zero
      (\idelim lowerIntegral function = zero \with v: Value => below v r \by { base: member, equality: lowerZero }),
  }));
\definition absoluteZero: (\fun (x: A) => Product.abs (function x)) = function :=
  \axiom:funext((\fun (x: A) => Product.abs (function x)), function, \fun (x: A) => Distance.distanceSelf Real.zero);
\definition integrable: Integrable function := Logic.And[_, _]::# measurable
  (\idelim function = (\fun (x: A) => Product.abs (function x)) \with f: (A -> Real.Real) => Finite f
    \by { base: finite, equality: sym!{{A -> Real.Real}} _ _ absoluteZero });
\definition zeroSup: Complete.LeastUpperBound[zero, Real.zero] := Complete.LeastUpperBound[zero, Real.zero] {
  upper := \fun (r: Real.Real) (negative: below zero r) => Order.leOfLt r Real.zero negative,
  least := \fun (b: Real.Real) (upper: Complete.UpperBound zero b) => Order.leOfNotLtReverse Real.zero b
    (\fun (negative: R.Lt b Real.zero) => R.ltNotLeReverse b (Real.midpoint b Real.zero)
      (Values.midpointStrictLeft b Real.zero negative) (upper (Real.midpoint b Real.zero) (Values.midpointStrictRight b Real.zero negative))),
};
\definition positiveZero: positivePart function = function :=
  \axiom:funext(positivePart function, function, \fun (x: A) => Distance.maxSame Real.zero);
\definition negativeZero: negativePart function = function :=
  \axiom:funext(negativePart function, function, \fun (x: A) => eq_reason_in!{Real.Real _
    "=" _ "by" { congr!{Real.Real Real.Real} (Distance.max Real.zero) _ _ Laws.negZero }
    "=" _ "by" { Distance.maxSame Real.zero }
  });
\definition hasIntegral: HasIntegral[function, Real.zero] := HasIntegral[function, Real.zero] {
  integrable := integrable,
  parts := Logic.existsIntro[Real.Real, { p: Real.Real \where \exists ( n: Real.Real \where Parts[function, Real.zero, p, n] ) }] Real.zero
    (Logic.existsIntro[Real.Real, { n: Real.Real \where Parts[function, Real.zero, Real.zero, n] }] Real.zero
      (Parts[function, Real.zero, Real.zero, Real.zero] {
        positiveLaw := \idelim zero = lowerIntegral (positivePart function) \with v: Value => Complete.LeastUpperBound[v, Real.zero]
          \by { base: zeroSup, equality: sym!{Value} _ _ (eq_reason_in!{Value _
            "=" _ "by" { congr!{{A -> Real.Real} Value} lowerIntegral _ _ positiveZero }
            "=" _ "by" { lowerZero }
          }) },
        negativeLaw := \idelim zero = lowerIntegral (negativePart function) \with v: Value => Complete.LeastUpperBound[v, Real.zero]
          \by { base: zeroSup, equality: sym!{Value} _ _ (eq_reason_in!{Value _
            "=" _ "by" { congr!{{A -> Real.Real} Value} lowerIntegral _ _ negativeZero }
            "=" _ "by" { lowerZero }
          }) },
        difference := sym!{Real.Real} _ _ (Laws.subSelf Real.zero),
      })),
};
\definition representative: Representatives := \into[A -> Real.Real](function, { f: A -> Real.Real \where Integrable f }) \by { integrable };
\definition integralZero: integral representative = Real.zero := integralUnique function (integral representative) Real.zero (integralLaw representative) hasIntegral;
