\definition data: AEDominatedSequence := AEDominatedSequence { sequence := partial, limit := c.limit, bound := c.bound,
  exception := c.exception, dominated := c.dominated, converges := c.converges };
\import \root.Measure[A := A].Integral[mu := mu].AEDominated[d := data] \as Proof;
\definition representative: Representatives := Proof.representative;
\definition almostLimit: AlmostEqual mu representative c.limit := Proof.almostLimit;
\definition exchange: Sequence.Converges scalarPartial (integral representative) :=
  \idelim (\fun (n: N.Nat^) => integral (partial n)) = scalarPartial \with s: (N.Nat^ -> Real.Real) => Sequence.Converges s (integral representative) \by {
    base: Proof.convergence, equality: \axiom:funext((\fun (n: N.Nat^) => integral (partial n)), scalarPartial, partialIntegral)
  };
