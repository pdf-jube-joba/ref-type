\definition data: DominatedSequence := DominatedSequence { sequence := partial, limit := c.limit, bound := c.bound,
  dominated := c.dominated, converges := c.converges };
\import \root.Measure[A := A].Integral[mu := mu].Dominated[d := data] \as Proof;
\definition integrable: Integrable c.limit := Proof.limitIntegrable;
\definition representative: Representatives := Proof.limitRepresentative;
\definition exchange: Sequence.Converges scalarPartial (integral representative) :=
  \idelim (\fun (n: N.Nat^) => integral (partial n)) = scalarPartial \with s: (N.Nat^ -> Real.Real) => Sequence.Converges s (integral representative) \by {
    base: Proof.convergence, equality: \axiom:funext((\fun (n: N.Nat^) => integral (partial n)), scalarPartial, partialIntegral)
  };
