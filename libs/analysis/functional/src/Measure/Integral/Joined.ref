\import \root.Measure[A := A].Integral[mu := mu].Join[m := m, n := n, s := s, t := t] \as Join;
\import Fin.Sum[m := m, n := n] \as Indices;
\import Indices.Tuples[A := Value] \as ValueTuples;
\import Indices.Tuples[A := Real.Real] \as ScalarTuples;
\import Indices.Tuples[A := \Pow A] \as SetTuples;
\import \root.Measure[A := A].ValueLaws[] \as Values;
\import Values.Append[m := m, n := n] \as Append;
\import Values.AppendLaws[n := n] \as AppendLaws;
\import \root.Measure[A := A].Finite[mu := mu] \as FiniteMeasure;
\use std.Logic[].Equality[].eq_reason_in;
\use std.Logic[].Equality[].congr;
\definition simple: \forall (cross: Join.CrossDisjoint) -> Simple[Indices.total] := \fun (cross: Join.CrossDisjoint) => Simple[Indices.total] {
  cells := Join.cells, coefficients := Join.coefficients,
  measurable := Join.cellMeasurable, nonnegative := Join.coefficientNonnegative, disjoint := Join.cellsDisjoint cross,
};
\definition integral: \forall (cross: Join.CrossDisjoint) -> simpleIntegral Indices.total (simple cross) = add (simpleIntegral m s) (simpleIntegral n t) :=
  \fun (cross: Join.CrossDisjoint) => eq_reason_in!{Value _
    "=" _ "by" { congr!{{Fin.Fin Indices.total -> Value} Value} (sum Indices.total) _ _
      (\axiom:funext((\fun (i: Fin.Fin Indices.total) => scale ((simple cross).coefficients i) (mu.value ((simple cross).cells i))),
        Append.join (\fun (i: Fin.Fin m) => scale (s.coefficients i) (mu.value (s.cells i))) (\fun (j: Fin.Fin n) => scale (t.coefficients j) (mu.value (t.cells j))),
        \fun (i: Fin.Fin Indices.total) => (\induction (u: Indices.Index) \return
          scale (ScalarTuples.evaluate s.coefficients t.coefficients u) (mu.value (SetTuples.evaluate s.cells t.cells u)) =
          ValueTuples.evaluate (\fun (i: Fin.Fin m) => scale (s.coefficients i) (mu.value (s.cells i))) (\fun (j: Fin.Fin n) => scale (t.coefficients j) (mu.value (t.cells j))) u \with {
            | inl: \fun (i: Fin.Fin m) => \refl(scale (s.coefficients i) (mu.value (s.cells i)))
            | inr: \fun (j: Fin.Fin n) => \refl(scale (t.coefficients j) (mu.value (t.cells j)))
          }) (Indices.split i))) }
    "=" _ "by" { AppendLaws.joinedSum m (\fun (i: Fin.Fin m) => scale (s.coefficients i) (mu.value (s.cells i)))
      (\fun (j: Fin.Fin n) => scale (t.coefficients j) (mu.value (t.cells j)))
      (\fun (i: Fin.Fin m) => Values.scaleNonnegative (s.coefficients i) (mu.value (s.cells i)) (s.nonnegative i) (FiniteMeasure.laws.nonnegative (s.cells i) (s.measurable i)))
      (\fun (j: Fin.Fin n) => Values.scaleNonnegative (t.coefficients j) (mu.value (t.cells j)) (t.nonnegative j) (FiniteMeasure.laws.nonnegative (t.cells j) (t.measurable j))) }
  };
\definition contained: \forall (cross: Join.CrossDisjoint) (S: \Pow A) ->
  (\forall (i: Fin.Fin m) -> Sets.Subset (s.cells i) S) -> (\forall (j: Fin.Fin n) -> Sets.Subset (t.cells j) S) ->
  \forall (i: Fin.Fin Indices.total) -> Sets.Subset ((simple cross).cells i) S :=
  \fun (cross: Join.CrossDisjoint) (S: \Pow A) (left: _) (right: _) (i: Fin.Fin Indices.total) =>
    (\induction (u: Indices.Index) \return Sets.Subset (SetTuples.evaluate s.cells t.cells u) S \with {
      | inl: \fun (j: Fin.Fin m) => left j
      | inr: \fun (j: Fin.Fin n) => right j
    }) (Indices.split i);
\definition dominated: \forall (cross: Join.CrossDisjoint) (f: A -> Real.Real) -> Dominated m s f -> Dominated n t f -> Dominated Indices.total (simple cross) f :=
  \fun (cross: Join.CrossDisjoint) (f: A -> Real.Real) (left: Dominated m s f) (right: Dominated n t f) (i: Fin.Fin Indices.total) =>
    (\induction (u: Indices.Index) \return \forall (x: A) -> Sets.Member (SetTuples.evaluate s.cells t.cells u) x -> R.Le (ScalarTuples.evaluate s.coefficients t.coefficients u) (f x) \with {
      | inl: \fun (j: Fin.Fin m) => left j
      | inr: \fun (j: Fin.Fin n) => right j
    }) (Indices.split i);
