\import \root.Measure[A := A].Integral[mu := mu].Approximation[f := p] \as P;
\import \root.Measure[A := A].Integral[mu := mu].Approximation[f := q] \as Q;
\import \root.Measure[A := A].Integral[mu := mu].Convergence[] \as Convergence;
\import Convergence.Monotone[] \as Monotone;
\import Convergence.PointwiseSum[] \as PointwiseSum;
\import \root.Measure[A := A].Functions[mu := mu] \as Functions;
\import N.Basic[].Prop[] \as Nat;
\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].congr;
\use std.Logic[].Equality[].eq_reason_in;
\definition sumValues: N.Nat^ -> A -> Real.Real := \fun (k: N.Nat^) (x: A) => Real.add (P.value k x) (Q.value k x);
\definition pSequence: Convergence.MeasurableSequence := \into[N.Nat^ -> A -> Real.Real] (P.value,
  { f: N.Nat^ -> A -> Real.Real \where \forall (k: N.Nat^) -> IsMeasurable mu (f k) }) \by { P.measurable };
\definition qSequence: Convergence.MeasurableSequence := \into[N.Nat^ -> A -> Real.Real] (Q.value,
  { f: N.Nat^ -> A -> Real.Real \where \forall (k: N.Nat^) -> IsMeasurable mu (f k) }) \by { Q.measurable };
\definition sumSequence: Convergence.MeasurableSequence := \into[N.Nat^ -> A -> Real.Real] (sumValues,
  { f: N.Nat^ -> A -> Real.Real \where \forall (k: N.Nat^) -> IsMeasurable mu (f k) }) \by {
    \fun (k: N.Nat^) => Functions.addMeasurable (P.value k) (Q.value k) (P.measurable k) (Q.measurable k)
  };
\definition pIncrease: Convergence.ValueIncreasing (\fun (k: N.Nat^) => lowerIntegral (P.value k)) :=
  \fun (i, j: N.Nat^) (order: Nat.Le i j) => lowerIntegralMono (P.value i) (P.value j)
    (\fun (x: A) => PointwiseSum.increasingAll P.value P.increasing j i order x);
\definition qIncrease: Convergence.ValueIncreasing (\fun (k: N.Nat^) => lowerIntegral (Q.value k)) :=
  \fun (i, j: N.Nat^) (order: Nat.Le i j) => lowerIntegralMono (Q.value i) (Q.value j)
    (\fun (x: A) => PointwiseSum.increasingAll Q.value Q.increasing j i order x);
\definition finiteAdd: \forall (k: N.Nat^) -> lowerIntegral (sumValues k) = add (lowerIntegral (P.value k)) (lowerIntegral (Q.value k)) :=
  \fun (k: N.Nat^) => \root.Measure[A := A].Integral[mu := mu].CompleteAdd[m := (P.stages k).size, n := (Q.stages k).size,
    s := (P.stages k).simple, t := (Q.stages k).simple].lowerIntegralAdd;
\definition lowerAdd: lowerIntegral (\fun (x: A) => Real.add (p.function x) (q.function x)) = add (lowerIntegral p.function) (lowerIntegral q.function) := eq_reason_in!{Value _
  "=" _ "by" { Monotone.monotone sumSequence (\fun (x: A) => Real.add (p.function x) (q.function x))
    (PointwiseSum.sup P.value Q.value p.function q.function P.pointwiseSup Q.pointwiseSup P.increasing Q.increasing)
    (PointwiseSum.increasing P.value Q.value P.increasing Q.increasing) }
  "=" _ "by" { congr!{{N.Nat^ -> Value} Value} Convergence.Sup _ _
    (\axiom:funext((\fun (k: N.Nat^) => lowerIntegral (sumValues k)),
      (\fun (k: N.Nat^) => add (lowerIntegral (P.value k)) (lowerIntegral (Q.value k))), finiteAdd)) }
  "=" _ "by" { sym!{Value} _ _ (Convergence.addSup (\fun (k: N.Nat^) => lowerIntegral (P.value k))
    (\fun (k: N.Nat^) => lowerIntegral (Q.value k)) pIncrease qIncrease) }
  "=" _ "by" { congr!{Value Value Value} add _ _ _ _
    (sym!{Value} _ _ (Monotone.monotone pSequence p.function P.pointwiseSup P.increasing))
    (sym!{Value} _ _ (Monotone.monotone qSequence q.function Q.pointwiseSup Q.increasing)) }
};
\import real.Analysis[].Estimates[] \as E;
\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\import dedekind_reals.DedekindReal[].Order[] \as Order;
\definition finite: Finite p.function -> Finite q.function -> Finite (\fun (x: A) => Real.add (p.function x) (q.function x)) :=
  \fun (pf: Finite p.function) (qf: Finite q.function) => \block {
    \takefrom a: \Cast[Real.Real] ({ a: Real.Real \where IntegralBound[p.function, a] }) \by pf.right \then
    \takefrom b: \Cast[Real.Real] ({ b: Real.Real \where IntegralBound[q.function, b] }) \by qf.right \then
    \let pa: IntegralBound[p.function, a] := \bysub(Real.Real, { a: Real.Real \where IntegralBound[p.function, a] }, a) \then
    \let qb: IntegralBound[q.function, b] := \bysub(Real.Real, { b: Real.Real \where IntegralBound[q.function, b] }, b) \then
    \return Logic.And[_, _]::# (\fun (x: A) => Laws.addNonnegative (p.function x) (q.function x) (p.nonnegative x) (q.nonnegative x))
      (Logic.existsIntro[Real.Real, { c: Real.Real \where IntegralBound[(\fun (x: A) => Real.add (p.function x) (q.function x)), c] }] (Real.add a b)
        (IntegralBound[(\fun (x: A) => Real.add (p.function x) (q.function x)), Real.add a b] {
          nonnegative := Laws.addNonnegative a b pa.nonnegative qb.nonnegative,
          bound := \fun (r: Real.Real) (member: below (lowerIntegral (\fun (x: A) => Real.add (p.function x) (q.function x))) r) => \block {
            \let inAdd: below (add (lowerIntegral p.function) (lowerIntegral q.function)) r :=
              \idelim lowerIntegral (\fun (x: A) => Real.add (p.function x) (q.function x)) = add (lowerIntegral p.function) (lowerIntegral q.function)
                \with v: Value => below v r \by { base: member, equality: lowerAdd } \then
            \takefrom x: \Cast[Real.Real] ({ x: Real.Real \where Logic.And[below (lowerIntegral p.function) x,
              \exists ( y: Real.Real \where Logic.And[below (lowerIntegral q.function) y, R.Lt r (Real.add x y)] )] }) \by inAdd \then
            \let first: Logic.And[below (lowerIntegral p.function) x, \exists ( y: Real.Real \where Logic.And[below (lowerIntegral q.function) y, R.Lt r (Real.add x y)] )] :=
              \bysub(Real.Real, { x: Real.Real \where Logic.And[below (lowerIntegral p.function) x, \exists ( y: Real.Real \where Logic.And[below (lowerIntegral q.function) y, R.Lt r (Real.add x y)] )] }, x) \then
            \takefrom y: \Cast[Real.Real] ({ y: Real.Real \where Logic.And[below (lowerIntegral q.function) y, R.Lt r (Real.add x y)] }) \by first.right \then
            \let second: Logic.And[below (lowerIntegral q.function) y, R.Lt r (Real.add x y)] :=
              \bysub(Real.Real, { y: Real.Real \where Logic.And[below (lowerIntegral q.function) y, R.Lt r (Real.add x y)] }, y) \then
            \return Order.leOfLt r (Real.add a b) (R.ltLeTrans r (Real.add x y) (Real.add a b) second.right (E.addLe x y a b (pa.bound x first.left) (qb.bound y second.left)))
          },
        }))
  };
