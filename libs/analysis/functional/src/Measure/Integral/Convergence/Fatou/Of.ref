\import \root.Measure[A := A].Integral[mu := mu].Convergence[].Fatou[].Tail[f := f] \as Tail;
\definition liminfLowerIntegral: Value := Sup (\fun (n: N.Nat^) => lowerIntegral (Tail.value n));
\definition fatou: Values.Included liminfLowerIntegral (Liminf (\fun (k: N.Nat^) => lowerIntegral (f k))) :=
  supLeast (\fun (n: N.Nat^) => lowerIntegral (Tail.value n)) (Liminf (\fun (k: N.Nat^) => lowerIntegral (f k)))
    (\fun (n: N.Nat^) (r: Real.Real) (member: below (lowerIntegral (Tail.value n)) r) =>
      supUpper (TailInf (\fun (k: N.Nat^) => lowerIntegral (f k))) n r
        (\fun (k: N.Nat^) (later: Nat.Le n k) => lowerIntegralMono (Tail.value n) (f k) (Tail.lower n k later) r member));
\definition finiteLiminf: \forall (g: A -> Real.Real) -> PointwiseSup Tail.envelope g -> lowerIntegral g = liminfLowerIntegral :=
  \fun (g: A -> Real.Real) (sup: PointwiseSup Tail.envelope g) => Monotone.monotone Tail.envelope g sup Tail.increasing;
\definition finiteFatou: \forall (g: A -> Real.Real) -> PointwiseSup Tail.envelope g ->
  Values.Included (lowerIntegral g) (Liminf (\fun (k: N.Nat^) => lowerIntegral (f k))) :=
  \fun (g: A -> Real.Real) (sup: PointwiseSup Tail.envelope g) (r: Real.Real) (member: below (lowerIntegral g) r) =>
    fatou r (\idelim lowerIntegral g = liminfLowerIntegral \with v: Value => below v r
      \by { base: member, equality: finiteLiminf g sup });
