\import dedekind_reals.DedekindReal[].Arithmetic[].Prop[] \as Laws;
\definition stage[k: N.Nat^]: Simple[n] := Simple[n] {
  cells := \fun (i: Fin.Fin n) => threshold f (s.cells i) (Real.mul c (s.coefficients i)) k,
  coefficients := \fun (i: Fin.Fin n) => Real.mul c (s.coefficients i),
  measurable := \fun (i: Fin.Fin n) => thresholdMeasurable f (s.cells i) (Real.mul c (s.coefficients i)) (sequenceMeasurable f) (s.measurable i) k,
  nonnegative := \fun (i: Fin.Fin n) => Laws.fieldMulNonnegative c (s.coefficients i) (shrinkLaw c).left (s.nonnegative i),
  disjoint := \fun (i, j: Fin.Fin n) (different: Logic.Not (i = j)) (x: A)
    (left: Sets.Member (threshold f (s.cells i) (Real.mul c (s.coefficients i)) k) x)
    (right: Sets.Member (threshold f (s.cells j) (Real.mul c (s.coefficients j)) k) x) =>
      s.disjoint i j different x left.left right.left,
};
\definition stageDominated: \forall (k: N.Nat^) -> Dominated n (stage k) (f k) :=
  \fun (k: N.Nat^) (i: Fin.Fin n) (x: A) (member: Sets.Member (threshold f (s.cells i) (Real.mul c (s.coefficients i)) k) x) =>
    RealOrder.leOfLt (Real.mul c (s.coefficients i)) (f k x) member.right;
\definition stageBelowIntegral: \forall (k: N.Nat^) -> Values.Included (simpleIntegral n (stage k)) (lowerIntegral (f k)) :=
  \fun (k: N.Nat^) (r: Real.Real) (member: below (simpleIntegral n (stage k)) r) =>
    Logic.existsIntro[N.Nat^, { m: N.Nat^ \where \exists ( t: Simple[m] \where Logic.And[Dominated m t (f k), below (simpleIntegral m t) r] ) }] n
      (Logic.existsIntro[Simple[n], { t: Simple[n] \where Logic.And[Dominated n t (f k), below (simpleIntegral n t) r] }] (stage k)
        (Logic.And[_, _]::# (stageDominated k) member));

\import real.Analysis[].Estimates[].Product[] \as Product;
\import std.Logic[].Classical[] \as Classical;
\import \root.Measure[A := A].Finite[mu := mu] \as MeasureFinite;
\use std.Logic[].Equality[].eq_reason_in;
\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].congr;
\definition weight[i: Fin.Fin n]: Real.Real := Real.mul c (s.coefficients i);
\definition cell[k: N.Nat^] [i: Fin.Fin n]: \Pow A := threshold f (s.cells i) (weight i) k;
\definition cellMeasureIncreasing: \forall (increasing: FunctionIncreasing f) (i: Fin.Fin n) ->
  ValueIncreasing (\fun (k: N.Nat^) => scale (weight i) (mu.value (cell k i))) :=
  \fun (increasing: FunctionIncreasing f) (i: Fin.Fin n) (m, k: N.Nat^) (order: Nat.Le m k) =>
    Values.scaleMono (weight i) (mu.value (cell m i)) (mu.value (cell k i))
      (MeasureFinite.monotone (cell m i) (cell k i)
        (thresholdMeasurable f (s.cells i) (weight i) (sequenceMeasurable f) (s.measurable i) m)
        (thresholdMeasurable f (s.cells i) (weight i) (sequenceMeasurable f) (s.measurable i) k)
        (MeasureContinuity.increasingAll (threshold f (s.cells i) (weight i)) (thresholdIncreasing f (s.cells i) (weight i) increasing) k m order));
\definition weightBelowPositive: \forall (i: Fin.Fin n) -> R.Lt Real.zero (s.coefficients i) -> R.Lt (weight i) (s.coefficients i) :=
  \fun (i: Fin.Fin n) (positive: R.Lt Real.zero (s.coefficients i)) =>
    R.ltReplaceRight (weight i) (Real.mul (s.coefficients i) Real.one) (s.coefficients i) (Real.Algebra[].mulOneRight (s.coefficients i))
      (R.ltReplaceLeft (Real.mul (s.coefficients i) c) (weight i) (Real.mul (s.coefficients i) Real.one)
        (Laws.fieldMulComm (s.coefficients i) c) (Product.mulStrict (s.coefficients i) c Real.one positive (shrinkLaw c).right));
\definition positiveCellLimit: \forall (g: A -> Real.Real) -> PointwiseSup f g -> FunctionIncreasing f -> Dominated n s g ->
  \forall (i: Fin.Fin n) -> R.Lt Real.zero (s.coefficients i) ->
  scale (weight i) (mu.value (s.cells i)) = Sup (\fun (k: N.Nat^) => scale (weight i) (mu.value (cell k i))) :=
  \fun (g: A -> Real.Real) (sup: PointwiseSup f g) (increasing: FunctionIncreasing f) (dominated: Dominated n s g)
    (i: Fin.Fin n) (positive: R.Lt Real.zero (s.coefficients i)) => eq_reason_in!{Value _
      "=" _ "by" { congr!{Value Value} (scale (weight i)) _ _
        (thresholdMeasure f g (s.cells i) (weight i) sup increasing (sequenceMeasurable f) (s.measurable i)
          (\fun (x: A) (member: Sets.Member (s.cells i) x) =>
            R.ltLeTrans (weight i) (s.coefficients i) (g x) (weightBelowPositive i positive) (dominated i x member))) }
      "=" _ "by" { scaleSup (weight i) (\fun (k: N.Nat^) => mu.value (cell k i)) }
    };

\definition zeroWeight: \forall (i: Fin.Fin n) -> s.coefficients i = Real.zero -> weight i = Real.zero :=
  \fun (i: Fin.Fin n) (eqZero: s.coefficients i = Real.zero) => eq_reason_in!{Real.Real _
    "=" _ "by" { congr!{Real.Real Real.Real} (Real.mul c) _ _ eqZero }
    "=" _ "by" { Laws.fieldMulZeroRight c }
  };
\definition zeroCellLimit: \forall (i: Fin.Fin n) -> s.coefficients i = Real.zero ->
  scale (weight i) (mu.value (s.cells i)) = Sup (\fun (k: N.Nat^) => scale (weight i) (mu.value (cell k i))) :=
  \fun (i: Fin.Fin n) (eqZero: s.coefficients i = Real.zero) => \block {
    \let wz: weight i = Real.zero := zeroWeight i eqZero \then
    \let original: scale (weight i) (mu.value (s.cells i)) = zero := eq_reason_in!{Value _
      "=" _ "by" { congr!{Real.Real Value} (\fun (a: Real.Real) => scale a (mu.value (s.cells i))) _ _ wz }
      "=" _ "by" { Values.zeroScale (mu.value (s.cells i)) (MeasureFinite.laws.nonnegative (s.cells i) (s.measurable i)) }
    } \then
    \let stages: (\fun (k: N.Nat^) => scale (weight i) (mu.value (cell k i))) = (\fun (_: N.Nat^) => zero) :=
      \axiom:funext((\fun (k: N.Nat^) => scale (weight i) (mu.value (cell k i))), (\fun (_: N.Nat^) => zero),
        \fun (k: N.Nat^) => eq_reason_in!{Value _
          "=" _ "by" { congr!{Real.Real Value} (\fun (a: Real.Real) => scale a (mu.value (cell k i))) _ _ wz }
          "=" _ "by" { Values.zeroScale (mu.value (cell k i))
            (MeasureFinite.laws.nonnegative (cell k i) (thresholdMeasurable f (s.cells i) (weight i) (sequenceMeasurable f) (s.measurable i) k)) }
        }) \then
    \return eq_reason_in!{Value _
      "=" _ "by" { original }
      "=" _ "by" { sym!{Value} _ _ (supConstant zero) }
      "=" _ "by" { congr!{{N.Nat^ -> Value} Value} Sup _ _ (sym!{{N.Nat^ -> Value}} _ _ stages) }
    }
  };
\definition cellLimit: \forall (g: A -> Real.Real) -> PointwiseSup f g -> FunctionIncreasing f -> Dominated n s g ->
  \forall (i: Fin.Fin n) -> scale (weight i) (mu.value (s.cells i)) = Sup (\fun (k: N.Nat^) => scale (weight i) (mu.value (cell k i))) :=
  \fun (g: A -> Real.Real) (sup: PointwiseSup f g) (increasing: FunctionIncreasing f) (dominated: Dominated n s g) (i: Fin.Fin n) =>
    Logic.orElim _ _ _ (Classical.excludedMiddle (s.coefficients i = Real.zero))
      (zeroCellLimit i)
      (\fun (nonzero: Logic.Not (s.coefficients i = Real.zero)) => positiveCellLimit g sup increasing dominated i
        (RealOrder.ltOfLeNotEq Real.zero (s.coefficients i) (s.nonnegative i)
          (\fun (equal: Real.zero = s.coefficients i) => nonzero (sym!{Real.Real} _ _ equal))));
\definition scaledIntegralSup: \forall (g: A -> Real.Real) -> PointwiseSup f g -> FunctionIncreasing f -> Dominated n s g ->
  sum n (\fun (i: Fin.Fin n) => scale (weight i) (mu.value (s.cells i))) = Sup (\fun (k: N.Nat^) => simpleIntegral n (stage k)) :=
  \fun (g: A -> Real.Real) (sup: PointwiseSup f g) (increasing: FunctionIncreasing f) (dominated: Dominated n s g) => eq_reason_in!{Value _
    "=" _ "by" { congr!{{Fin.Fin n -> Value} Value} (sum n) _ _
      (\axiom:funext((\fun (i: Fin.Fin n) => scale (weight i) (mu.value (s.cells i))),
        (\fun (i: Fin.Fin n) => Sup (\fun (k: N.Nat^) => scale (weight i) (mu.value (cell k i)))), cellLimit g sup increasing dominated)) }
    "=" _ "by" { sumSup n (\fun (k: N.Nat^) (i: Fin.Fin n) => scale (weight i) (mu.value (cell k i))) (cellMeasureIncreasing increasing) }
  };

\definition scaledIntegralBound: \forall (g: A -> Real.Real) -> PointwiseSup f g -> FunctionIncreasing f -> Dominated n s g ->
  Values.Included (sum n (\fun (i: Fin.Fin n) => scale (weight i) (mu.value (s.cells i))))
    (Sup (\fun (k: N.Nat^) => lowerIntegral (f k))) :=
  \fun (g: A -> Real.Real) (sup: PointwiseSup f g) (increasing: FunctionIncreasing f) (dominated: Dominated n s g) (r: Real.Real)
    (member: below (sum n (\fun (i: Fin.Fin n) => scale (weight i) (mu.value (s.cells i)))) r) =>
      supLeast (\fun (k: N.Nat^) => simpleIntegral n (stage k)) (Sup (\fun (k: N.Nat^) => lowerIntegral (f k)))
        (\fun (k: N.Nat^) (x: Real.Real) (inStage: below (simpleIntegral n (stage k)) x) =>
          supUpper (\fun (k: N.Nat^) => lowerIntegral (f k)) k x (stageBelowIntegral k x inStage)) r
        (\idelim sum n (\fun (i: Fin.Fin n) => scale (weight i) (mu.value (s.cells i))) = Sup (\fun (k: N.Nat^) => simpleIntegral n (stage k))
          \with v: Value => below v r \by { base: member, equality: scaledIntegralSup g sup increasing dominated });
