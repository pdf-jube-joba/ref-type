\import \root.Measure[A := A].Integral[mu := mu].Convergence[].Monotone[] \as Monotone;
\definition TailInf[values: N.Nat^ -> Value] [n: N.Nat^]: Value :=
  { r: Real.Real \where \forall (k: N.Nat^) -> Nat.Le n k -> below (values k) r };
\definition Liminf[values: N.Nat^ -> Value]: Value := Sup (TailInf values);
\definition lowerEnvelopeBound: \forall (f: N.Nat^ -> A -> Real.Real) (envelope: MeasurableSequence) (limit: A -> Real.Real) ->
  PointwiseSup envelope limit -> FunctionIncreasing envelope ->
  (\forall (n, k: N.Nat^) -> Nat.Le n k -> \forall (x: A) -> R.Le (envelope n x) (f k x)) ->
  Values.Included (lowerIntegral limit) (Liminf (\fun (k: N.Nat^) => lowerIntegral (f k))) :=
  \fun (f: N.Nat^ -> A -> Real.Real) (envelope: MeasurableSequence) (limit: A -> Real.Real)
    (sup: PointwiseSup envelope limit) (increasing: FunctionIncreasing envelope)
    (lower: \forall (n, k: N.Nat^) -> Nat.Le n k -> \forall (x: A) -> R.Le (envelope n x) (f k x))
    (r: Real.Real) (member: below (lowerIntegral limit) r) => \block {
      \let inSup: below (Sup (\fun (n: N.Nat^) => lowerIntegral (envelope n))) r :=
        \idelim lowerIntegral limit = Sup (\fun (n: N.Nat^) => lowerIntegral (envelope n)) \with v: Value => below v r
          \by { base: member, equality: Monotone.monotone envelope limit sup increasing } \then
      \takefrom n: \Cast[N.Nat^] ({ n: N.Nat^ \where below (lowerIntegral (envelope n)) r }) \by inSup \then
      \let inEnvelope: below (lowerIntegral (envelope n)) r := \bysub(N.Nat^, { n: N.Nat^ \where below (lowerIntegral (envelope n)) r }, n) \then
      \return supUpper (TailInf (\fun (k: N.Nat^) => lowerIntegral (f k))) n r
        (\fun (k: N.Nat^) (later: Nat.Le n k) => lowerIntegralMono (envelope n) (f k) (lower n k later) r inEnvelope)
    };
\definition NonnegativeSequence: \Set := \Cast[N.Nat^ -> A -> Real.Real]
  ({ f: N.Nat^ -> A -> Real.Real \where Logic.And[\forall (k: N.Nat^) -> IsMeasurable mu (f k), \forall (k: N.Nat^) (x: A) -> R.Le Real.zero (f k x)] });
\definition sequenceLaw[f: NonnegativeSequence]: Logic.And[\forall (k: N.Nat^) -> IsMeasurable mu (f k), \forall (k: N.Nat^) (x: A) -> R.Le Real.zero (f k x)] :=
  \bysub(N.Nat^ -> A -> Real.Real, { f: N.Nat^ -> A -> Real.Real \where Logic.And[\forall (k: N.Nat^) -> IsMeasurable mu (f k), \forall (k: N.Nat^) (x: A) -> R.Le Real.zero (f k x)] }, f);
\module Tail(f: NonnegativeSequence);

\definition liminfLowerIntegral[f: NonnegativeSequence]: Value :=
  Sup (\fun (n: N.Nat^) => lowerIntegral (Tail[f := f].value n));
\definition fatou: \forall (f: NonnegativeSequence) ->
  Values.Included (liminfLowerIntegral f) (Liminf (\fun (k: N.Nat^) => lowerIntegral (f k))) :=
  \fun (f: NonnegativeSequence) => supLeast (\fun (n: N.Nat^) => lowerIntegral (Tail[f := f].value n))
    (Liminf (\fun (k: N.Nat^) => lowerIntegral (f k)))
    (\fun (n: N.Nat^) (r: Real.Real) (member: below (lowerIntegral (Tail[f := f].value n)) r) =>
      supUpper (TailInf (\fun (k: N.Nat^) => lowerIntegral (f k))) n r
        (\fun (k: N.Nat^) (later: Nat.Le n k) =>
          lowerIntegralMono (Tail[f := f].value n) (f k) (Tail[f := f].lower n k later) r member));
\definition finiteLiminf: \forall (f: NonnegativeSequence) (g: A -> Real.Real) -> PointwiseSup (Tail[f := f].envelope) g ->
  lowerIntegral g = liminfLowerIntegral f :=
  \fun (f: NonnegativeSequence) (g: A -> Real.Real) (sup: PointwiseSup (Tail[f := f].envelope) g) =>
    Monotone.monotone (Tail[f := f].envelope) g sup (Tail[f := f].increasing);
