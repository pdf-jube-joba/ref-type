\import \root.Measure[A := A].Integral[mu := mu].Null[] \as QIntegral;
\import \root.Measure[A := A].Integral[mu := mu].Linear[] \as Linear;
\import \root.Measure[A := A].AlmostEverywhere[mu := mu] \as AE;
\import \root.Measure[A := A].Sigma[] \as Sigma;
\import std.Logic[].Classical[] \as Classical;
\import std.Set[].Quotient[A := Representatives, Equivalent := \fun (f, g: Representatives) => AlmostEqual mu f g] \as Quotient;
\import Quotient.Binary[C := Representatives, B := QIntegral.Space, OtherEquivalent := \fun (f, g: Representatives) => AlmostEqual mu f g] \as Binary;
\use std.Logic[].Equality[].congr;
\use std.Logic[].Equality[].sym;
\use std.Logic[].Equality[].eq_reason_in;
\definition addAlmost: \forall (f, f2, g, g2: Representatives) -> AlmostEqual mu f f2 -> AlmostEqual mu g g2 ->
  AlmostEqual mu (Linear.addRepresentative f g) (Linear.addRepresentative f2 g2) :=
  \fun (f, f2, g, g2: Representatives) (ff: AlmostEqual mu f f2) (gg: AlmostEqual mu g g2) =>
    AE.nullSubset ({ x: A \where Logic.Not (Real.add (f x) (g x) = Real.add (f2 x) (g2 x)) })
      (Sigma.pairUnion ({ x: A \where Logic.Not (f x = f2 x) }) ({ x: A \where Logic.Not (g x = g2 x) }))
      (\fun (x: A) (different: Logic.Not (Real.add (f x) (g x) = Real.add (f2 x) (g2 x))) =>
        Logic.orElim _ _ (Logic.Or[Logic.Not (f x = f2 x), Logic.Not (g x = g2 x)]) (Classical.excludedMiddle (f x = f2 x))
          (\fun (same: f x = f2 x) => Logic.Or[_, _]::right (\fun (other: g x = g2 x) =>
            different (congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ same other)))
          (\fun (notSame: Logic.Not (f x = f2 x)) => Logic.Or[_, _]::left notSame))
      (AE.nullUnion ({ x: A \where Logic.Not (f x = f2 x) }) ({ x: A \where Logic.Not (g x = g2 x) }) ff gg);
\definition classEqual: \forall (f, g: Representatives) -> AlmostEqual mu f g -> QIntegral.class f = QIntegral.class g :=
  \fun (f, g: Representatives) (equal: AlmostEqual mu f g) => Quotient.eqByExt (QIntegral.class f) (QIntegral.class g)
    (\fun (h: Representatives) (fh: AlmostEqual mu f h) => AE.transitive g f h (AE.symmetric f g equal) fh)
    (\fun (h: Representatives) (gh: AlmostEqual mu g h) => AE.transitive f g h equal gh);
\definition classAdd: Representatives -> Representatives -> QIntegral.Space := \fun (f, g: Representatives) => QIntegral.class (Linear.addRepresentative f g);
\definition respects: Binary.Respects classAdd := \fun (f, f2, g, g2: Representatives) (ff: AlmostEqual mu f f2) (gg: AlmostEqual mu g g2) =>
  classEqual (Linear.addRepresentative f g) (Linear.addRepresentative f2 g2) (addAlmost f f2 g g2 ff gg);
\definition add: QIntegral.Space -> QIntegral.Space -> QIntegral.Space := Binary.value QIntegral.equivalence QIntegral.equivalence classAdd respects;
\definition addClass: \forall (f, g: Representatives) -> add (QIntegral.class f) (QIntegral.class g) = QIntegral.class (Linear.addRepresentative f g) :=
  Binary.onClass QIntegral.equivalence QIntegral.equivalence classAdd respects;
\definition integralAdd: \forall (C, D: QIntegral.Space) -> QIntegral.quotientIntegral (add C D) = Real.add (QIntegral.quotientIntegral C) (QIntegral.quotientIntegral D) :=
  Quotient.induction2 (\fun (C, D: QIntegral.Space) => QIntegral.quotientIntegral (add C D) = Real.add (QIntegral.quotientIntegral C) (QIntegral.quotientIntegral D))
    (\fun (f, g: Representatives) => eq_reason_in!{Real.Real _
      "=" _ "by" { congr!{QIntegral.Space Real.Real} QIntegral.quotientIntegral _ _ (addClass f g) }
      "=" _ "by" { QIntegral.quotientIntegralOfClass (Linear.addRepresentative f g) }
      "=" _ "by" { Linear.integralAdd f g }
      "=" _ "by" { congr!{Real.Real Real.Real Real.Real} Real.add _ _ _ _
        (sym!{Real.Real} _ _ (QIntegral.quotientIntegralOfClass f)) (sym!{Real.Real} _ _ (QIntegral.quotientIntegralOfClass g)) }
    });
\import \root.Measure[A := A].Integral[mu := mu].Scaling[] \as Scaling;
\import Quotient.Maps[B := QIntegral.Space] \as ClassMaps;
\definition classScalar[c: Real.Real] [f: Representatives]: QIntegral.Space := QIntegral.class (Scaling.scalarRepresentative c f);
\definition scalarRespects: \forall (c: Real.Real) (f, g: Representatives) -> AlmostEqual mu f g -> classScalar c f = classScalar c g :=
  \fun (c: Real.Real) (f, g: Representatives) (equal: AlmostEqual mu f g) =>
    classEqual (Scaling.scalarRepresentative c f) (Scaling.scalarRepresentative c g) (QIntegral.mapAlmost (Real.mul c) f g equal);
\definition scalar[c: Real.Real] [C: QIntegral.Space]: QIntegral.Space := ClassMaps.value QIntegral.equivalence (classScalar c) (scalarRespects c) C;
\definition scalarClass: \forall (c: Real.Real) (f: Representatives) -> scalar c (QIntegral.class f) = QIntegral.class (Scaling.scalarRepresentative c f) :=
  \fun (c: Real.Real) (f: Representatives) => ClassMaps.onClass QIntegral.equivalence (classScalar c) (scalarRespects c) f;
\definition integralScalar: \forall (c: Real.Real) (C: QIntegral.Space) -> QIntegral.quotientIntegral (scalar c C) = Real.mul c (QIntegral.quotientIntegral C) :=
  \fun (c: Real.Real) => Quotient.induction (\fun (C: QIntegral.Space) => QIntegral.quotientIntegral (scalar c C) = Real.mul c (QIntegral.quotientIntegral C))
    (\fun (f: Representatives) => eq_reason_in!{Real.Real _
      "=" _ "by" { congr!{QIntegral.Space Real.Real} QIntegral.quotientIntegral _ _ (scalarClass c f) }
      "=" _ "by" { QIntegral.quotientIntegralOfClass (Scaling.scalarRepresentative c f) }
      "=" _ "by" { Scaling.integralScalar c f }
      "=" _ "by" { congr!{Real.Real Real.Real} (Real.mul c) _ _ (sym!{Real.Real} _ _ (QIntegral.quotientIntegralOfClass f)) }
    });
