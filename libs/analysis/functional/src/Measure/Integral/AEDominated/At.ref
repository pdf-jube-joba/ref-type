\import \root.Measure[A := A].Integral[mu := mu].Mask[exception := d.exception, f := d.sequence k] \as Mask;
\definition representative: Representatives := \into[A -> Real.Real] (Mask.value, { f: A -> Real.Real \where Integrable f }) \by {
  Mask.integrable (\bysub(A -> Real.Real, { f: A -> Real.Real \where Integrable f }, d.sequence k))
};
\definition laws: \forall (x: A) -> Logic.And[Sets.Member d.exception x -> representative x = Real.zero,
  Logic.Not (Sets.Member d.exception x) -> representative x = d.sequence k x] := Mask.laws;
\definition almost: AlmostEqual mu representative (d.sequence k) := Mask.almost;
