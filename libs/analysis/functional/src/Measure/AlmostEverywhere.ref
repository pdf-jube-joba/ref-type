\import \root.Measure[A := A].Sigma[] \as Sigma;
\use std.Logic[].Equality[].sym;

\definition laws: MeasureLaws[mu] := \bysub(MeasureData, Measure, mu);

\definition nullSubset: \forall (S, T: \Pow A) -> Sets.Subset S T -> Null mu T -> Null mu S :=
  \fun (S, T: \Pow A) (included: Sets.Subset S T) (null: Null mu T) => \block {
    \takefrom N: \Cast[\Pow A] ({ N: \Pow A \where NullCover[mu, T, N] }) \by null \then
    \let cover: NullCover[mu, T, N] := \bysub(\Pow A, { N: \Pow A \where NullCover[mu, T, N] }, N) \then
    \return Logic.existsIntro[\Pow A, { N: \Pow A \where NullCover[mu, S, N] }] N
      (NullCover[mu, S, N] {
        measurable := cover.measurable,
        measure := cover.measure,
        included := \fun (x: A) (member: Sets.Member S x) => cover.included x (included x member),
      })
  };

\definition nullEmpty: Null mu Sets.Empty :=
  Logic.existsIntro[\Pow A, { N: \Pow A \where NullCover[mu, Sets.Empty, N] }] Sets.Empty
    (NullCover[mu, Sets.Empty, Sets.Empty] {
      measurable := (Sigma.laws mu.sigma).empty,
      measure := laws.empty,
      included := \fun (x: A) (member: Sets.Member Sets.Empty x) => member,
    });

\definition reflexive: \forall (f: A -> Real.Real) -> AlmostEqual mu f f :=
  \fun (f: A -> Real.Real) => nullSubset ({ x: A \where Logic.Not (f x = f x) }) Sets.Empty
    (\fun (x: A) (different: Logic.Not (f x = f x)) => different (\refl(f x))) nullEmpty;

\definition symmetric: \forall (f, g: A -> Real.Real) -> AlmostEqual mu f g -> AlmostEqual mu g f :=
  \fun (f, g: A -> Real.Real) (equal: AlmostEqual mu f g) =>
    nullSubset ({ x: A \where Logic.Not (g x = f x) }) ({ x: A \where Logic.Not (f x = g x) })
      (\fun (x: A) (different: Logic.Not (g x = f x)) (same: f x = g x) => different (sym!{Real.Real} _ _ same)) equal;
