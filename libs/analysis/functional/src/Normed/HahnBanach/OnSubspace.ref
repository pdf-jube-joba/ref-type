\import Linear.Subspace[V := V, space := space].Of[subspace := subspace] \as Sub;
\import Linear.Linear[V := Sub.Carrier, W := Real.Real, source := Sub.induced, target := Linear.scalarSpace] \as Maps;
\definition Carrier: \Set := Sub.Carrier;
\definition Functional: \Set := Maps.Map;
\structure Represents[f: Functional, t: Point, y: Sub.Carrier]: \Prop := {
  vector: t.vector = y,
  value: t.value = f.apply y,
};
\definition graph[f: Functional]: Graph := { t: Point \where \exists ( y: Sub.Carrier \where Represents[f, t, y] ) };
\definition mem[f: Functional] [t: Point] [y: Sub.Carrier]: Represents[f, t, y] -> Member (graph f) t :=
  \fun (data: Represents[f, t, y]) => Logic.existsIntro[Sub.Carrier, { y: Sub.Carrier \where Represents[f, t, y] }] y data;
\definition eliminate[f: Functional] [t: Point] [P: \Prop]:
  (\forall (y: Sub.Carrier) -> Represents[f, t, y] -> P) -> Member (graph f) t -> P := \block {
  \fun (step: \forall (y: Sub.Carrier) -> Represents[f, t, y] -> P) (member: Member (graph f) t) \then
  \takefrom y: \Cast[Sub.Carrier] ({ y: Sub.Carrier \where Represents[f, t, y] }) \by member \then
  \return step y (\bysub(Sub.Carrier, { y: Sub.Carrier \where Represents[f, t, y] }, y))
};
\definition linear: \forall (f: Functional) -> (\forall (y: Sub.Carrier) -> R.Le (f.apply y) (p y)) -> LinearGraph[graph f] :=
  \fun (f: Functional) (bound: \forall (y: Sub.Carrier) -> R.Le (f.apply y) (p y)) => LinearGraph[graph f] {
    zero := mem f (Point::# (space.zero) Real.zero) Sub.origin (Represents[f, Point::# (space.zero) Real.zero, Sub.origin] {
      vector := \refl(space.zero), value := sym!{Real.Real} _ _ (f.preservesZero),
    }),
    addition := \fun (t, u: Point) (inT: Member (graph f) t) (inU: Member (graph f) u) =>
      eliminate f t (Member (graph f) (plus t u)) (\fun (y: Sub.Carrier) (left: Represents[f, t, y]) =>
        eliminate f u (Member (graph f) (plus t u)) (\fun (z: Sub.Carrier) (right: Represents[f, u, z]) =>
          mem f (plus t u) (Sub.plus y z) (Represents[f, plus t u, Sub.plus y z] {
            vector := congr2!{V V V} (space.add) _ _ _ _ (left.vector) (right.vector),
            value := trans!{Real.Real} _ _ _ (congr2!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ (left.value) (right.value))
              (sym!{Real.Real} _ _ (f.preservesAdd y z)),
          })) inU) inT,
    scalar := \fun (a: Real.Real) (t: Point) => eliminate f t (Member (graph f) (scale a t))
      (\fun (y: Sub.Carrier) (data: Represents[f, t, y]) => mem f (scale a t) (Sub.scale a y) (Represents[f, scale a t, Sub.scale a y] {
        vector := congr!{V V} (space.smul a) _ _ (data.vector),
        value := trans!{Real.Real} _ _ _ (congr!{Real.Real Real.Real} (Real.mul a) _ _ (data.value)) (sym!{Real.Real} _ _ (f.preservesScale a y)),
      })),
    functional := \fun (t, u: Point) (inT: Member (graph f) t) (inU: Member (graph f) u) (same: t.vector = u.vector) =>
      eliminate f t (t.value = u.value) (\fun (y: Sub.Carrier) (left: Represents[f, t, y]) =>
        eliminate f u (t.value = u.value) (\fun (z: Sub.Carrier) (right: Represents[f, u, z]) =>
          trans!{Real.Real} _ _ _ (left.value)
            (trans!{Real.Real} _ _ _
              (congr!{Sub.Carrier Real.Real} (f.apply) y z
                (trans!{V} _ _ _ (sym!{V} _ _ (left.vector)) (trans!{V} _ _ _ same (right.vector))))
              (sym!{Real.Real} _ _ (right.value)))) inU) inT,
    dominated := \fun (t: Point) => eliminate f t (R.Le (t.value) (p (t.vector)))
      (\fun (y: Sub.Carrier) (data: Represents[f, t, y]) => R.leReplace _ _ _ _
        (sym!{Real.Real} _ _ (data.value)) (sym!{Real.Real} _ _ (congr!{V Real.Real} p _ _ (data.vector))) (bound y)),
  };
\structure Extension[f: Functional, g: V -> Real.Real]: \Prop := {
  agrees: \forall (y: Sub.Carrier) -> g y = f.apply y,
  addition: \forall (x, y: V) -> g (space.add x y) = Real.add (g x) (g y),
  scalar: \forall (a: Real.Real) (x: V) -> g (space.smul a x) = Real.mul a (g x),
  dominated: \forall (x: V) -> R.Le (g x) (p x),
};
\definition hahnBanachOnSubspace: Sublinear -> \forall (f: Functional) ->
  (\forall (y: Sub.Carrier) -> R.Le (f.apply y) (p y)) -> \exists ( g: V -> Real.Real \where Extension[f, g] ) := \block {
  \fun (sublinear: Sublinear) (f: Functional) (bound: \forall (y: Sub.Carrier) -> R.Le (f.apply y) (p y)) \then
  \let partial: Partial := \into[Graph](graph f, { G: Graph \where LinearGraph[G] }) \by { linear f bound } \then
  \takefrom g: \Cast[V -> Real.Real] ({ g: V -> Real.Real \where GlobalExtension[partial, g] }) \by hahnBanach sublinear partial \then
  \let data: GlobalExtension[partial, g] := \bysub(V -> Real.Real, { g: V -> Real.Real \where GlobalExtension[partial, g] }, g) \then
  \return Logic.existsIntro[V -> Real.Real, { g: V -> Real.Real \where Extension[f, g] }] g (Extension[f, g] {
    agrees := \fun (y: Sub.Carrier) => data.agrees (Point::# y (f.apply y))
      (mem f (Point::# y (f.apply y)) y (Represents[f, Point::# y (f.apply y), y] { vector := \refl(y), value := \refl(f.apply y) })),
    addition := data.addition, scalar := data.scalar, dominated := data.dominated,
  })
};
