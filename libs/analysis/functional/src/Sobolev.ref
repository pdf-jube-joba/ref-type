\import calculus.Real[].Multivariable[n := n] \as Calculus;
\import Calculus.Open[] \as Open;
\import Open.Analysis[] \as Analysis;
\import std.Data[].Nat[] \as N;
\import N.Basic[].Prop[] \as Nat;
\import std.Data[].List[] \as Lists;
\import real.Analysis[] \as Real;
\import std.Logic[].Proposition[] \as Logic;
\definition Directions: \Set := Lists.List[Calculus.Coordinate];
\definition order[directions: Directions]: N.Nat^ := Lists.length Calculus.Coordinate directions;
\definition sign: N.Nat^ -> Real.Real := \induction (k: N.Nat^) \return Real.Real \with {
  | zero: Real.one
  | succ: \fun (k: N.Nat^) (previous: Real.Real) => Real.neg previous
};
\module On(U: Open.OpenSet);
