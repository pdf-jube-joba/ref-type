\import real.Analysis[] \as Real;
\import Real.Algebra[] \as Algebra;
\import Real.Estimates[].Product[] \as Product;
\import Real.Distance[] \as Distance;
\import Real.Sequence[] \as Sequence;
\import dedekind_reals.DedekindReal[] \as R;
\import R.Arithmetic[].Prop[] \as Laws;
\import R.Order[] \as Order;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\import std.Data[].Nat[] \as N;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.congr2;
\import linear_algebra.Field[].Space[K := Real.Real, field := Algebra.field] \as Linear;
\import \root.Normed[V := Real.Real, space := Linear.scalarSpace] \as Normed;
\import \root.Metric[Carrier := Real.Real] \as Metric;
\import linear_algebra.Real[].InnerProduct[V := Real.Real, space := Linear.scalarSpace] \as Inner;
\definition norm: Normed.Norm := Normed.Norm {
  norm := Product.abs,
  nonnegative := Product.absNonnegative,
  zero := Distance.distanceSelf Real.zero,
  definite := \fun (x: Real.Real) (zero: Product.abs x = Real.zero) => sym!{Real.Real} _ _ (Distance.distanceSeparated Real.zero x zero),
  triangle := \fun (a, b: Real.Real) => R.leReplace _ _ _ _
    (Distance.distanceSymmetric (Real.add a b) Real.zero)
    (congr2!{Real.Real Real.Real Real.Real} Real.add _ _ _ _ (Distance.distanceSymmetric a Real.zero) (Distance.distanceSymmetric b Real.zero))
    (Real.Estimates[].distanceAddZero a b),
  homogeneous := Product.absProduct,
};
\definition distanceLaw[a, b: Real.Real]: (Normed.metric norm).distance a b = Real.distance a b :=
  trans!{Real.Real} _ _ _ (Distance.distanceSymmetric Real.zero (Real.sub a b)) (Real.Estimates[].distanceDifference a b);
\definition inner: Inner.InnerProduct := Inner.InnerProduct {
  inner := Real.mul,
  symmetric := Laws.fieldMulComm,
  zeroRight := Laws.fieldMulZeroRight,
  addRight := Laws.fieldMulAdd,
  scaleRight := \fun (a, x, y: Real.Real) => Algebra.mulSwap x a y,
  nonnegative := Algebra.squareNonnegative,
  definite := Algebra.squareZero,
};
\import Normed.Hilbert[norm := norm] \as Hilbert;
\definition complete: Normed.IsBanach norm := \block {
  \fun (s: N.Nat^ -> Real.Real) (cauchy: Metric.Cauchy (Normed.metric norm) s) \then
  \let scalarCauchy: Sequence.Cauchy s := \block {
    \fun (epsilon: Real.Real) (positive: R.Lt Real.zero epsilon) \then
    \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Metric.CauchyControl (Normed.metric norm) s epsilon k }) \by cauchy epsilon positive \then
    \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Sequence.Control s epsilon k }] k
      (\fun (m, n: N.Nat^) (km: N.Basic[].Prop[].Le k m) (kn: N.Basic[].Prop[].Le k n) =>
        R.ltReplaceLeft _ _ epsilon (distanceLaw (s m) (s n))
          ((\bysub(N.Nat^, { k: N.Nat^ \where Metric.CauchyControl (Normed.metric norm) s epsilon k }, k)) m n km kn))
  } \then
  \let sequence: Sequence.CauchySequence := \into[N.Nat^ -> Real.Real](s, { s: N.Nat^ -> Real.Real \where Sequence.Cauchy s }) \by { scalarCauchy } \then
  \let value: Real.Real := Sequence.limit sequence \then
  \return Logic.existsIntro[Real.Real, { x: Real.Real \where Metric.Converges (Normed.metric norm) s x }] value (\block {
    \fun (epsilon: Real.Real) (positive: R.Lt Real.zero epsilon) \then
    \takefrom k: \Cast[N.Nat^] ({ k: N.Nat^ \where Sequence.LimitControl s value epsilon k }) \by Sequence.limitLaw sequence epsilon positive \then
    \return Logic.existsIntro[N.Nat^, { k: N.Nat^ \where Metric.LimitControl (Normed.metric norm) s value epsilon k }] k
      (\fun (n: N.Nat^) (later: N.Basic[].Prop[].Le k n) => R.ltReplaceLeft _ _ epsilon (sym!{Real.Real} _ _ (distanceLaw (s n) value))
        ((\bysub(N.Nat^, { k: N.Nat^ \where Sequence.LimitControl s value epsilon k }, k)) n later))
  })
};
\definition hilbert: Hilbert.Hilbert[inner] := Hilbert.Hilbert[inner] {
  normSquared := \fun (x: Real.Real) => trans!{Real.Real} _ _ _
    (sym!{Real.Real} _ _ (Product.absOfNonnegative (Real.mul x x) (Algebra.squareNonnegative x))) (Product.absProduct x x),
  complete := complete,
};
\import Hilbert.Riesz[inner := inner] \as Riesz;
\import Normed.Operators[W := Real.Real, target := Linear.scalarSpace, norm := norm, targetNorm := norm] \as Operators;
\import Linear.Linear[V := Real.Real, W := Real.Real, source := Linear.scalarSpace, target := Linear.scalarSpace] \as Maps;
\definition identityMap: Maps.Map := Maps.Map {
  apply := \fun (x: Real.Real) => x,
  preservesAdd := \fun (x, y: Real.Real) => \refl(Real.add x y),
  preservesScale := \fun (a, x: Real.Real) => \refl(Real.mul a x),
};
\definition identity: Riesz.Functional := \into[Maps.Map](identityMap, { f: Maps.Map \where Operators.Bounded f }) \by {
  Logic.existsIntro[Real.Real, { C: Real.Real \where Operators.Bound[identityMap, C] }] Real.one (Operators.Bound[identityMap, Real.one] {
    nonnegative := Laws.oneNonnegative,
    estimate := \fun (x: Real.Real) => R.leReplaceRight _ (norm.norm x) (Real.mul Real.one (norm.norm x))
      (sym!{Real.Real} _ _ (Laws.fieldMulOneLeft (norm.norm x))) (R.leRefl (norm.norm x)),
  })
};
\definition identityVector: Riesz.vector hilbert identity = Real.one :=
  Hilbert.representingVectorUnique inner (identity.apply) (Riesz.vector hilbert identity) Real.one (Riesz.vectorLaw hilbert identity)
    (\fun (x: Real.Real) => sym!{Real.Real} _ _ (Laws.fieldMulOneLeft x));

\import Normed.HahnBanach[p := Product.abs] \as HahnBanach;
\definition sublinear: HahnBanach.Sublinear := HahnBanach.Sublinear {
  zero := norm.zero, triangle := norm.triangle,
  homogeneous := \fun (a, x: Real.Real) (nonnegative: R.Le Real.zero a) =>
    trans!{Real.Real} _ _ _ (Product.absProduct a x)
      (congr!{Real.Real Real.Real} (\fun (r: Real.Real) => Real.mul r (Product.abs x)) _ _ (Product.absOfNonnegative a nonnegative)),
};
\import Linear.Subspace[V := Real.Real, space := Linear.scalarSpace] \as Subspaces;
\definition whole: Subspaces.Subspace := Subspaces.Subspace {
  carrier := { x: Real.Real \where x = x },
  containsZero := \refl(Real.zero),
  closedAdd := \fun (x, y: Real.Real) (hx: _) (hy: _) => \refl(Real.add x y),
  closedScale := \fun (a, x: Real.Real) (hx: _) => \refl(Real.mul a x),
};
\import Subspaces.Of[subspace := whole] \as Whole;
\import HahnBanach.OnSubspace[subspace := whole] \as Extension;
\definition wholeIdentity: Extension.Functional := Extension.Functional {
  apply := \fun (x: Whole.Carrier) => x,
  preservesAdd := \fun (x, y: Whole.Carrier) => \refl(Real.add x y),
  preservesScale := \fun (a: Real.Real) (x: Whole.Carrier) => \refl(Real.mul a x),
};
\definition absoluteExtensionExists: \exists ( g: Real.Real -> Real.Real \where Extension.Extension[wholeIdentity, g] ) :=
  Extension.hahnBanachOnSubspace sublinear wholeIdentity
    (\fun (x: Whole.Carrier) => R.leReplaceRight x (Distance.max (Real.neg x) x) (Product.abs x)
      (sym!{Real.Real} _ _ (Product.absExpression x)) (Distance.maxRight (Real.neg x) x));

\import Operators.OpenMapping[f := identity] \as OpenMapping;
\import topology.Topology[Carrier := Real.Real] \as RealTopology;
\import Metric.Geometry[d := Normed.metric norm] \as Geometry;
\definition identityOpen: \forall (U: \Pow Real.Real) -> RealTopology.IsOpenIn (Geometry.topology) U ->
  RealTopology.IsOpenIn (Geometry.topology) (OpenMapping.Image U) :=
  OpenMapping.openMapping complete complete (\fun (y: Real.Real) => Logic.existsIntro[Real.Real, { x: Real.Real \where x = y }] y (\refl(y)));
\module Ascoli(A: \Set, topology: topology.Topology[Carrier := A].Topology);
