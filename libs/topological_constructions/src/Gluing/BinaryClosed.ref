\import \parent.Restriction[U := F] \as Left;
\import \parent.Restriction[U := G] \as Right;
\import topology.Topology[Carrier := A].Subspace[S := F] \as LeftSubspace;
\import topology.Topology[Carrier := A].Subspace[S := G] \as RightSubspace;
\import topology.Continuity[A := \Cast[A] F, B := B] \as LeftMaps;
\import topology.Continuity[A := \Cast[A] G, B := B] \as RightMaps;
\use Logic::either;
\definition continuous: \forall (source: Source.Topology) (target: Target.Topology) (f: A -> B) ->
  Source.IsClosedIn source F -> Source.IsClosedIn source G ->
  (\forall (x: A) -> Logic.Or[Source.Member F x, Source.Member G x]) ->
  LeftMaps.Continuous (LeftSubspace.topology source) target (\fun (x: \Cast[A] F) => f x) ->
  RightMaps.Continuous (RightSubspace.topology source) target (\fun (x: \Cast[A] G) => f x) ->
  Maps.Continuous source target f := \block {
  \fun (source: _) (target: _) (f: _) (fc: _) (gc: _) (covers: _) (left: _) (right: _) \then
  \let family: Finite.FiniteSubset := Finite.unorderedPair F G \then
  \return finiteClosedCover source target f family
    (\fun (x: A) (_: Source.Member Source.Whole x) =>
      either!{{(covers x)} {Source.Member (Source.Union family) x}
        {\fun (inF: _) => Source.unionMemberOf family F x (Finite.inUnorderedPairLeft F G) inF}
        {\fun (inG: _) => Source.unionMemberOf family G x (Finite.inUnorderedPairRight F G) inG}
      })
    (\fun (U: \Pow A) (member: Finite.Member family U) =>
      either!{member {Source.IsClosedIn source U}
        {\fun (equal: _) => \idelim F = U \with W: \Pow A => Source.IsClosedIn source W
          \by { base: fc, equality: sym!{\Pow A} _ _ equal }}
        {\fun (old: _) => either!{old {Source.IsClosedIn source U}
          {\fun (equal: _) => \idelim G = U \with W: \Pow A => Source.IsClosedIn source W
            \by { base: gc, equality: sym!{\Pow A} _ _ equal }}
          {Logic.falseElim (Source.IsClosedIn source U)}
        }}
      })
    (\fun (U: \Pow A) (member: Finite.Member family U) =>
      either!{member {ClosedOn source target f U}
        {\fun (equal: _) => \idelim F = U \with W: \Pow A => ClosedOn source target f W
          \by { base: Left.closedFromRestriction source target f fc left, equality: sym!{\Pow A} _ _ equal }}
        {\fun (old: _) => either!{old {ClosedOn source target f U}
          {\fun (equal: _) => \idelim G = U \with W: \Pow A => ClosedOn source target f W
            \by { base: Right.closedFromRestriction source target f gc right, equality: sym!{\Pow A} _ _ equal }}
          {Logic.falseElim (ClosedOn source target f U)}
        }}
      })
};
