\definition f: Forward.Map := #forward{d};
\definition g: Backward.Map := #backward{d};
\definition SourceChart: \Set := \Cast[SourceCharts.Chart] (#charts{M.atlas});
\definition TargetChart: \Set := \Cast[TargetCharts.Chart] (#charts{N.atlas});
\module Local(left: SourceChart, right: TargetChart);
\import real.Analysis[] \as Reals;
\import Reals.Algebra[] \as Algebra;
\import linear_algebra.Field[].Space[K := Reals.Real, field := Algebra.field] \as Spaces;
\import \root.Tangent[n := n].On[M := M] \as SourceTangent;
\import \root.Tangent[n := m].On[M := N] \as TargetTangent;
\module At(x: M.Point);
