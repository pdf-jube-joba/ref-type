\import \root.Diffeomorphism[n := n, m := m].Between[M := M, N := N] \as Diffeomorphisms;
\import \root.SmoothMap[n := n, m := m].Between[M := M, N := N] \as Forward;
\import \root.SmoothMap[n := m, m := n].Between[M := N, N := M] \as Backward;
\import \root.Dimension[n := n].Chart[M := M.Point, space := M.space] \as SourceCharts;
\import \root.Dimension[n := m].Chart[M := N.Point, space := N.space] \as TargetCharts;
\import calculus.Real[].Multivariable[n := n].Open[] \as SourceOpen;
\import calculus.Real[].Multivariable[n := m].Open[] \as TargetOpen;
\import calculus.Maps[n := n, m := m] \as LocalForward;
\import calculus.Maps[n := m, m := n] \as LocalBackward;
\import calculus.Diffeomorphism[n := n, m := m] \as LocalDiffeomorphisms;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\module Of(d: Diffeomorphisms.Diffeomorphism);
