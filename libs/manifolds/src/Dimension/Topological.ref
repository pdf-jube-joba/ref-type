\definition ChartType(M: \Set)(space: topology.Structures[].Topology[M]): \Set := \parent.Chart[M := M, space := space].Chart;
\definition Contains(M: \Set)(space: topology.Structures[].Topology[M])(chart: ChartType M space)(x: M): \Prop :=
  \parent.Chart[M := M, space := space].Contains chart x;
\definition Space(M: \Set): \Set := topology.Structures[].Topology[M];
\definition Hausdorff(M: \Set)(space: Space M): \Prop := topology.Topology[Carrier := M].IsT2 space;
\definition SecondCountable(M: \Set)(space: Space M): \Prop := topology.Topology[Carrier := M].IsSecondCountable space;
\structure Manifold {
  Point: \Set,
  space: Space Point,
  charts: \Pow (ChartType Point space),
  covers: \forall (x: Point) -> \exists { chart: ChartType Point space \where
    Logic.And[\In[ChartType Point space] charts chart,
      Contains Point space chart x] },
  hausdorff: Hausdorff Point space,
  secondCountable: SecondCountable Point space,
}
