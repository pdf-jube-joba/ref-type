\import \parent.Topological[] \as Topological;
\definition AtlasType(M: \Set)(space: Topological.Space M): \Set := \parent.AtlasData[M := M, space := space].MaximalAtlas;
\structure Manifold {
  Point: \Set,
  space: Topological.Space Point,
  atlas: AtlasType Point space,
  hausdorff: Topological.Hausdorff Point space,
  secondCountable: Topological.SecondCountable Point space,
}
\definition SmallAtlas(M: \Set)(space: Topological.Space M): \Set := \parent.AtlasData[M := M, space := space].Atlas;
\module From(M: \Set, space: Topological.Space M, atlas: SmallAtlas M space);
