\import topology.Topology[Carrier := M] \as Source;
\definition Domain(points: \Pow M): \Set := \Cast[M] points;
\definition domainTopology(points: \Pow M): topology.Topology[Carrier := Domain points].Topology := Source.Subspace[S := points].topology space;
\definition imageTopology(U: Open.OpenSet): topology.Topology[Carrier := Open.Carrier U].Topology := OpenTopology.Of[U := U].topology;
\structure Data: \Set {
  domain: \Pow M,
  image: Open.OpenSet,
  coordinates: topology.Homeomorphism[A := Domain domain, B := Open.Carrier image].Homeomorphism[domainTopology domain, imageTopology image],
}
\structure Laws[data: Data]: \Prop {
  open: Source.IsOpenIn space data.domain,
}
\definition Chart: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition Contains(chart: Chart)(x: M): \Prop := Source.Member #domain{chart} x;
\definition LocalPoint(chart: Chart): \Set := Domain #domain{chart};
\definition coordinate(chart: Chart)(x: LocalPoint chart): Open.Carrier #image{chart} := #forward{(#coordinates{chart})} x;
\definition point(chart: Chart)(x: Open.Carrier #image{chart}): LocalPoint chart := #backward{(#coordinates{chart})} x;
