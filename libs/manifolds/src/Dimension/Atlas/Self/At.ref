\import calculus.Maps[n := n, m := n].Differential[U := Transition.domain, V := #image{chart}, f := map, a := a] \as Jacobian;
\import calculus.Vector[n := n, m := n] \as Vector;
\import calculus.Identity[n := n] \as Identity;
\definition function: Vector.Function Transition.domain := \fun (x: Point) => Transition.vector x;
\definition functionIdentity: function = Vector.linearFunction Transition.domain Identity.linear :=
  \axiom:funext(function, Vector.linearFunction Transition.domain Identity.linear, Geometry.vectorIdentity);
\definition identityLaw: Vector.HasDifferentialAt Transition.domain function a Identity.linear :=
  \idelim Vector.linearFunction Transition.domain Identity.linear = function \with f: Vector.Function Transition.domain =>
    Vector.HasDifferentialAt Transition.domain f a Identity.linear \by {
      base: Vector.linearDifferential Transition.domain Identity.linear a,
      equality: sym!{{Vector.Function Transition.domain}} function (Vector.linearFunction Transition.domain Identity.linear) functionIdentity
    };
\definition differential: Jacobian.value = Identity.linear :=
  Vector.Differential[U := Transition.domain, f := function, a := a, d := Jacobian.value].uniqueness Identity.linear Jacobian.vectorLaw identityLaw;
