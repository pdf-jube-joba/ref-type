\import \parent.\parent.Atlas[M := M, space := space] \as Atlases;
\definition manifold(hausdorff: Topological.Hausdorff M space)(secondCountable: Topological.SecondCountable M space): Manifold := Manifold {
    Point := M, space := space, atlas := Atlases.saturate atlas,
    hausdorff := hausdorff, secondCountable := secondCountable,
  };
