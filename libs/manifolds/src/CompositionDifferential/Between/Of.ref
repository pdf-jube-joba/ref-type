\import \root.Composition[n := n, m := m, l := l].Between[M := M, N := N, P := P].Of[f := f, g := g] \as Composition;
\import std.Logic[].Equality[] \as Equality;
\use Equality::sym;
\use Equality::trans;
\use Equality::congr;
\import \root.Dimension[n := n].Chart[M := M.Point, space := M.space] \as SourceCharts;
\import \root.Dimension[n := m].Chart[M := N.Point, space := N.space] \as MiddleCharts;
\import \root.Dimension[n := l].Chart[M := P.Point, space := P.space] \as TargetCharts;
\import calculus.Real[] \as Reals;
\import Reals.Multivariable[n := n].Open[] \as Open;
\import std.Data[].FinSet[] \as Fin;
\import calculus.Maps[n := n, m := m] \as FirstCalculus;
\import calculus.Maps[n := m, m := l] \as SecondCalculus;
\import calculus.Maps[n := n, m := l] \as CompositeCalculus;
\definition map: Composite.Map := Composition.map;
\definition SourceChart: \Set := Composition.SourceChart;
\definition MiddleChart: \Set := Composition.MiddleChart;
\definition TargetChart: \Set := Composition.TargetChart;
\module InCharts(left: SourceChart, middle: MiddleChart, right: TargetChart);
