\import Restricted.Of[chart := left] \as Left;
\import Restricted.Of[chart := right] \as Right;
\import Charts.Transition[left := restricted left, right := restricted right] \as Transition;
\import Original.Transition[left := left, right := right] \as OldTransition;
\definition included: Open.Included Transition.domain OldTransition.domain :=
  \fun (a: calculus.Real[].Multivariable[n := n].Point)(member: \In[calculus.Real[].Multivariable[n := n].Point] (#points{Transition.domain}) a) => \block {
    \let x: Open.Carrier Transition.domain := \into[calculus.Real[].Multivariable[n := n].Point](a, #points{Transition.domain}) \by { member } \then
    \return OldTransition.intro (Left.oldCoordinate (Transition.leftCoordinate x)) (Transition.inRightDomain x)
  };
\definition compatible: Atlases.Compatible (restricted left) (restricted right) :=
  \fun (i: std.Data[].FinSet[].Fin n) =>
    Restriction.localSmooth Transition.domain OldTransition.domain included
      (\fun (x: Open.Carrier OldTransition.domain) => OldTransition.vector x i)
      (#compatible{M.atlas} left right (\bysub(Original.Chart, #charts{M.atlas}, left))
        (\bysub(Original.Chart, #charts{M.atlas}, right)) i);
