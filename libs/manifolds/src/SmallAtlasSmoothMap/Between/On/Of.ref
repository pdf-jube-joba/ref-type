\definition InSmallAtlas: \Prop := \forall (left: SourceChart)(right: TargetChart) ->
  Maps.Coordinates[f := f, left := left, right := right].Smooth;
\module Coordinates(left: SourceCharts.Chart, right: TargetCharts.Chart);
\definition regular: InSmallAtlas -> Maps.Chartwise f :=
  \fun (condition: InSmallAtlas)(left: SourceCharts.Chart)(right: TargetCharts.Chart)
    (leftMember: SourceAtlases.Member M.atlas left)(rightMember: TargetAtlases.Member N.atlas right) =>
      Coordinates[left := left, right := right].regular condition leftMember rightMember;
\definition inSmallAtlas: Maps.Chartwise f -> InSmallAtlas :=
  \fun (condition: Maps.Chartwise f)(left: SourceChart)(right: TargetChart) => condition left right (sourceMember left) (targetMember right);
\definition value(condition: InSmallAtlas): Maps.Map := \into[Maps.ContinuousMap](f, { map: Maps.ContinuousMap \where Maps.Chartwise map }) \by { regular condition };
