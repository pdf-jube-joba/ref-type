\import \root.SmoothMap[n := n, m := m].Between[M := M, N := N] \as Maps;
\import \root.Dimension[n := n].Atlas[M := M.Point, space := M.space] \as SourceAtlases;
\import \root.Dimension[n := m].Atlas[M := N.Point, space := N.space] \as TargetAtlases;
\import \root.Dimension[n := n].Chart[M := M.Point, space := M.space] \as SourceCharts;
\import \root.Dimension[n := m].Chart[M := N.Point, space := N.space] \as TargetCharts;
\definition SourceAtlas: \Set := \Cast[SourceAtlases.Atlas] ({ atlas: SourceAtlases.Atlas \where
  \forall (c: SourceCharts.Chart) -> SourceAtlases.Member atlas c -> SourceAtlases.Member M.atlas c });
\definition TargetAtlas: \Set := \Cast[TargetAtlases.Atlas] ({ atlas: TargetAtlases.Atlas \where
  \forall (c: TargetCharts.Chart) -> TargetAtlases.Member atlas c -> TargetAtlases.Member N.atlas c });
\import calculus.Real[].Multivariable[n := n].Open[] \as Open;
\import calculus.Real[].Multivariable[n := m].Open[] \as TargetOpen;
\import Open.Smooth[] \as Smooth;
\import Open.Restriction[] \as Restriction;
\import calculus.Maps[n := n, m := n] \as Before;
\import calculus.Maps[n := n, m := m] \as Calculus;
\import calculus.Maps[n := m, m := m] \as After;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality::sym;
\use Equality::trans;
\use Equality::congr;
\import std.Data[].FinSet[] \as Fin;
\module On(source: SourceAtlas, target: TargetAtlas);
