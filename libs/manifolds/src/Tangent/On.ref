\import \root.Dimension[n := n].Chart[M := M.Point, space := M.space] \as Charts;
\import \root.Dimension[n := n].AtlasData[M := M.Point, space := M.space] \as Atlas;
\import real.Analysis[].Algebra[] \as Algebra;
\import linear_algebra.Field[].Space[K := Real.Real, field := Algebra.field] \as Spaces;
\import Spaces.Coordinates[I := Coordinates.Coordinate] \as Vectors;
\import Spaces.Linear[V := Vectors.Vector, W := Vectors.Vector, source := Vectors.space, target := Vectors.space] \as Linear;
\import Linear.Composition[U := Vectors.Vector, domain := Vectors.space] \as Composition;
\import calculus.Maps[n := n, m := n] \as Maps;
\import calculus.Identity[n := n] \as Identity;
\module At(x: M.Point);
\definition Vector(x: M.Point): \Set := At[x := x].Vector;
\definition space(x: M.Point): Spaces.VectorSpace (Vector x) := At[x := x].space;
\definition Cotangent(x: M.Point): \Set := Spaces.Dual[V := Vector x, source := space x].Carrier;
\definition cotangentSpace(x: M.Point): Spaces.VectorSpace (Cotangent x) := Spaces.Dual[V := Vector x, source := space x].space;
