\import \root.SelfMap[n := n].Identity[M := M] \as SourceIdentity;
\import \root.SelfMap[n := m].Identity[M := N] \as TargetIdentity;
\import \root.Composition[n := n, m := n, l := m].Between[M := M, N := M, P := N] \as LeftIdentity;
\import \root.Composition[n := n, m := m, l := m].Between[M := M, N := N, P := N] \as RightIdentity;
\definition leftIdentity: (LeftIdentity.compose SourceIdentity.map f) = f := Maps.ext (LeftIdentity.compose SourceIdentity.map f) f
  (\axiom:funext(Maps.apply (LeftIdentity.compose SourceIdentity.map f), Maps.apply f, \fun (x: M.Point) => \refl(Maps.apply f x)));
\definition rightIdentity: (RightIdentity.compose f TargetIdentity.map) = f := Maps.ext (RightIdentity.compose f TargetIdentity.map) f
  (\axiom:funext(Maps.apply (RightIdentity.compose f TargetIdentity.map), Maps.apply f, \fun (x: M.Point) => \refl(Maps.apply f x)));
