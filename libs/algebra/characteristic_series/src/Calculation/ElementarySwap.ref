\definition equation: add (add a (mul y b)) (mul x (add b (mul y c))) = add (add a (mul x b)) (mul y (add b (mul x c))) :=
  eq_reason_in!{R _
    "=" _ "by" { congr!{R R} (add (add a (mul y b))) _ _ (ring.ring.semiring.leftDistributive x b (mul y c)) }
    "=" _ "by" { Sum.four a (mul y b) (mul x b) (mul x (mul y c)) }
    "=" _ "by" { congr!{R R} (\fun (d: R) => add (add a (mul x b)) (add (mul y b) d)) _ _ (mulSwap x y c) }
    "=" _ "by" { congr!{R R} (add (add a (mul x b))) _ _ (sym!{R} _ _ (ring.ring.semiring.leftDistributive y b (mul x c))) }
  };
