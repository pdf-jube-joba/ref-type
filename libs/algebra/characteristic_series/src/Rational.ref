\import std.Arithmetic[].Rat[].Fractions[] \as F;
\import F.Quotient[] \as Q;
\import F.Arithmetic[].Prop[] \as FL;
\import std.Alg[].Ring[] \as Rings;
\import std.Alg[].Alg[] \as A;
\import std.Alg[].Monoid[] \as M;
\import std.Logic[].Equality[] \as E;
\use E.congr;
\use E.sym;
\use E.trans;
\use E.eq_reason_in;
\definition Carrier: \Set := Q.Rat;
\definition zero: Carrier := Q.zeroRat;
\definition one: Carrier := Q.oneRat;
\definition add: Carrier -> Carrier -> Carrier := Q.addRat;
\definition neg: Carrier -> Carrier := Q.neg;
\definition mul: Carrier -> Carrier -> Carrier := Q.mulRat;
\definition classEqual: \forall (x, y: F.Fraction) -> F.FractionEq x y -> Q.class x = Q.class y := Q.classOfEq;
\definition leftDistributive: \forall (x, y, z: Carrier) -> mul x (add y z) = add (mul x y) (mul x z) :=
  Q.quotientInduction (\fun (x: Carrier) => \forall (y, z: Carrier) -> mul x (add y z) = add (mul x y) (mul x z))
    (\fun (x: F.Fraction) => Q.quotientInduction
      (\fun (y: Carrier) => \forall (z: Carrier) -> mul (Q.class x) (add y z) = add (mul (Q.class x) y) (mul (Q.class x) z))
      (\fun (y: F.Fraction) => Q.quotientInduction
        (\fun (z: Carrier) => mul (Q.class x) (add (Q.class y) z) = add (mul (Q.class x) (Q.class y)) (mul (Q.class x) z))
        (\fun (z: F.Fraction) => eq_reason_in!{Carrier _
          "=" _ "by" { congr!{Carrier Carrier} (mul (Q.class x)) _ _ (Q.addRatClass y z) }
          "=" _ "by" { Q.mulRatClass x (Q.addFraction y z) }
          "=" _ "by" { classEqual _ _ (FL.fractionMulAddLeft x y z) }
          "=" _ "by" { sym!{Carrier} _ _ (Q.addRatClass (Q.mulFraction x y) (Q.mulFraction x z)) }
          "=" _ "by" { congr!{Carrier Carrier Carrier} add _ _ _ _ (sym!{Carrier} _ _ (Q.mulRatClass x y)) (sym!{Carrier} _ _ (Q.mulRatClass x z)) }
        })));
\definition rightDistributive: \forall (x, y, z: Carrier) -> mul (add x y) z = add (mul x z) (mul y z) :=
  \fun (x, y, z: Carrier) => eq_reason_in!{Carrier _
    "=" _ "by" { Q.mulRatComm (add x y) z }
    "=" _ "by" { leftDistributive z x y }
    "=" _ "by" { congr!{Carrier Carrier Carrier} add _ _ _ _ (Q.mulRatComm z x) (Q.mulRatComm z y) }
  };
\definition ring: Rings.CommutativeRing[Carrier] := Rings.CommutativeRing[Carrier] {
  base := Rings.RingData[Carrier]::# zero one add neg mul,
  ring := Rings.RingLaws[Carrier, Rings.RingData[Carrier]::# zero one add neg mul] {
    semiring := A.SemiringLaws[Carrier, A.SemiringData[Carrier]::# zero one add mul] {
      additive := M.CommutativeMonoidLaws[Carrier, M.CommutativeMonoidData[Carrier]::# (M.MonoidData[Carrier]::# zero add)] {
        monoid := M.MonoidLaws[Carrier, M.MonoidData[Carrier]::# zero add] {
          leftIdentity := Q.addRatZeroLeft, rightIdentity := Q.addRatZeroRight, associative := Q.addRatAssoc,
        }, commutative := Q.addRatComm,
      },
      multiplicative := M.MonoidLaws[Carrier, M.MonoidData[Carrier]::# one mul] {
        leftIdentity := Q.mulRatOneLeft, rightIdentity := Q.mulRatOneRight, associative := Q.mulRatAssoc,
      },
      leftDistributive := leftDistributive, rightDistributive := rightDistributive,
      zeroAbsorbsLeft := Q.mulRatZeroLeft, zeroAbsorbsRight := Q.mulRatZeroRight,
    }, additiveInverse := Q.addRatNegLeft,
  }, mulCommutative := Q.mulRatComm,
};
\import std.Data[].Nat[] \as N;
\import std.Arithmetic[].Int[] \as I;
\import F.Arithmetic[].Def[] \as FD;
\definition reciprocalSuccessor[k: N.Nat^]: Carrier := Q.class (F.Fraction::# I.oneInteger k);
\definition natural[k: N.Nat^]: Carrier := Q.class (F.Fraction::# (I.Int^::ofNat k) I.zeroNat);
\definition successorInverse: \forall (k: N.Nat^) -> mul (natural (N.Nat^::succ k)) (reciprocalSuccessor k) = one :=
  \fun (k: N.Nat^) => eq_reason_in!{Carrier _
    "=" _ "by" { Q.mulRatClass (F.Fraction::# (I.Int^::ofNat (N.Nat^::succ k)) I.zeroNat) (F.Fraction::# I.oneInteger k) }
    "=" _ "by" { classEqual _ _ (FL.positiveReciprocalLaw I.zeroNat k) }
  };
/* Scaling a numerator and denominator preserves its rational class. */
\definition scaleClass: \forall (x, y: F.Fraction)(k: I.Integer) ->
  y.numerator = I.mulInteger x.numerator k -> F.denominator y = I.mulInteger (F.denominator x) k -> Q.class x = Q.class y :=
  \fun (x, y: F.Fraction)(k: I.Integer)(hn: _)(hd: _) => classEqual x y (eq_reason_in!{I.Integer _
    "=" _ "by" { congr!{I.Integer I.Integer} (I.mulInteger x.numerator) _ _ hd }
    "=" _ "by" { sym!{I.Integer} _ _ (I.mulIntegerAssoc x.numerator (F.denominator x) k) }
    "=" _ "by" { congr!{I.Integer I.Integer} (\fun (a: I.Integer) => I.mulInteger a k) _ _ (I.mulIntegerComm x.numerator (F.denominator x)) }
    "=" _ "by" { I.mulIntegerAssoc (F.denominator x) x.numerator k }
    "=" _ "by" { I.mulIntegerComm (F.denominator x) (I.mulInteger x.numerator k) }
    "=" _ "by" { congr!{I.Integer I.Integer} (\fun (a: I.Integer) => I.mulInteger a (F.denominator x)) _ _ (sym!{I.Integer} _ _ hn) }
  });
\definition addSameDenominator: \forall (a, b: I.Integer)(d: N.Nat^) ->
  add (Q.class (F.Fraction::# a d)) (Q.class (F.Fraction::# b d)) = Q.class (F.Fraction::# (I.addInteger a b) d) :=
  \fun (a, b: I.Integer)(d: N.Nat^) => trans!{Carrier} _ _ _
    (Q.addRatClass (F.Fraction::# a d) (F.Fraction::# b d))
    (classEqual (Q.addFraction (F.Fraction::# a d) (F.Fraction::# b d)) (F.Fraction::# (I.addInteger a b) d) (eq_reason_in!{I.Integer _
      "=" _ "by" { congr!{I.Integer I.Integer} (\fun (n: I.Integer) => I.mulInteger n (F.denominator (F.Fraction::# a d))) _ _
        (sym!{I.Integer} _ _ (I.mulIntegerDistribRight a b (F.denominator (F.Fraction::# a d)))) }
      "=" _ "by" { I.mulIntegerAssoc (I.addInteger a b) (F.denominator (F.Fraction::# a d)) (F.denominator (F.Fraction::# a d)) }
      "=" _ "by" { congr!{I.Integer I.Integer} (I.mulInteger (I.addInteger a b)) _ _
        (sym!{I.Integer} _ _ (FL.denominatorAdd (F.Fraction::# a d) (F.Fraction::# b d))) }
    }));
\module Computed;

