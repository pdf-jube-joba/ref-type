\import \root.Rational[] \as Q;
\import Q.Computed[] \as D;
\import \root.Series[R := Q.Carrier, ring := Q.ring] \as S;
\import \root.Polynomials[n := D.n2] \as Plane;
\import \root.Polynomials[n := std.Data[].Nat[].Nat^::zero] \as Empty;
\import \root.Genus[R := Q.Carrier, ring := Q.ring, coefficient := Empty.identity] \as G;
\import \root.Characteristic[] \as Characteristic;
\definition quadratic: Plane.SymmetricPolynomial := Plane.plus
  (Plane.times (Plane.elementarySymmetric D.n1) (Plane.elementarySymmetric D.n1))
  (Plane.negative (Plane.elementarySymmetric D.n2));
\definition quadraticInvariant: Plane.Invariant quadratic := Plane.invariant quadratic;
\definition emptyElementary: Empty.elementary D.n1 = Empty.ring.base.zero := \refl(Empty.ring.base.zero);
\definition twoLines: G.Polynomial := G.todd D.n5 (S.cons Q.one (S.cons Q.one S.nil));
\definition twoLineCoefficients: G.finite D.n5 (Characteristic.todd D.n5) (S.cons Q.one (S.cons Q.one S.nil)) =
  G.DegreeEight[].toddFormula (S.cons Q.one (S.cons Q.one S.nil)) := G.DegreeEight[].toddFinite (S.cons Q.one (S.cons Q.one S.nil));
\definition geometricInverse: S.times D.n5 (S.cons Q.one (S.cons (Q.neg Q.one) S.nil))
  (S.inverseUnit D.n5 (S.cons (Q.neg Q.one) S.nil)) = S.constant D.n5 Q.one := S.Laws[].inverseUnitLaw D.n5 (S.cons (Q.neg Q.one) S.nil);
\definition smallerProduct: S.cut D.n3 (S.times (S.extend D.n3 D.n2) (S.cons Q.one (S.cons Q.one S.nil)) (S.cons Q.one (S.cons Q.one S.nil))) =
  S.times D.n3 (S.cons Q.one (S.cons Q.one S.nil)) (S.cons Q.one (S.cons Q.one S.nil)) :=
  S.cutTimes D.n3 D.n2 (S.cons Q.one (S.cons Q.one S.nil)) (S.cons Q.one (S.cons Q.one S.nil));
