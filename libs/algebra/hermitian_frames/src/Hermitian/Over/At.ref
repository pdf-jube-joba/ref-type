\import Geometry.Finite[n := n] \as E;
\import Geometry.Inner[V := E.Vector, space := E.space] \as Inner;
\import Inner.Of[h := E.form] \as InnerLaws;
\import Spaces.Laws[V := E.Vector, space := E.space] \as Laws;
\import Spaces.Linear[V := E.Vector, W := E.Vector, source := E.space, target := E.space] \as End;
\import End.Operations[] \as Operations;
\import End.Composition[U := E.Vector, domain := E.space] \as Compose;
\import Spaces.Eigen[V := E.Vector, space := E.space] \as Eigen;
\import Spaces.Isomorphism[V := E.Vector, W := E.Vector, source := E.space, target := E.space] \as Isomorphisms;
\definition Vector: \Set := E.Vector;
\definition Map: \Set := End.Map;
\definition dot: Vector -> Vector -> K := E.dot;
\definition Form: \Set := Inner.Form;
\definition Positive[h: Form]: \Prop := Inner.Positive[h];
\module Forms(h: Form);
\structure Projection: \Set := {
  map: End.Map,
  selfAdjoint: \forall (v, w: Vector) -> dot (map.apply v) w = dot v (map.apply w),
  idempotent: \forall (v: Vector) -> map.apply (map.apply v) = map.apply v,
};
\module OnProjection(P: Projection);
\module Square;
\module Families(X: \Set);
\module Unitary;
\module Blocks(m: N.Nat^);
\module Matrices;
