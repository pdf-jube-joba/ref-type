\definition f: Small.Map := ToSmall.compose basis.coordinate (forward x);
\definition g: Small.Map := SmallCompose.compose (Square.Inverse[A := nonsingular x].value) (ToSmall.compose center.coordinate basis.value);
\definition left: \forall (v: Domain.Vector) -> g.apply (f.apply v) = v := \fun (v: Domain.Vector) =>
  trans!{{Domain.Vector}} _ _ _ (congr!{Vector {Domain.Vector}}
    (\fun (w: Vector) => (Square.Inverse[A := nonsingular x].value).apply (center.coordinate.apply w)) _ _
    (trans!{Vector} _ _ _ (basis.reconstruction ((forward x).apply v)) ((P x).idempotent (center.value.apply v)))) (comparisonLeft x v);
\definition right: \forall (v: Domain.Vector) -> f.apply (g.apply v) = v := Square.leftInverseRight f g left;
\definition reconstruction: \forall (w: Vector) -> (forward x).apply ((backward x).apply w) = (P x).map.apply w := \fun (w: Vector) =>
  eq_reason_in!{Vector _
    "=" _ "by" { congr!{{Domain.Vector} Vector} (forward x).apply _ _
      (congr!{Vector {Domain.Vector}} (\fun (v: Vector) => (Square.Inverse[A := nonsingular x].value).apply (center.coordinate.apply v)) _ _ (sym!{Vector} _ _ (basis.reconstruction w))) }
    "=" _ "by" { sym!{Vector} _ _ ((P x).idempotent (center.value.apply (g.apply (basis.coordinate.apply w)))) }
    "=" _ "by" { sym!{Vector} _ _ (basis.reconstruction ((forward x).apply (g.apply (basis.coordinate.apply w)))) }
    "=" _ "by" { congr!{{Domain.Vector} Vector} basis.value.apply _ _ (right (basis.coordinate.apply w)) }
    "=" _ "by" { basis.reconstruction w }
  };
