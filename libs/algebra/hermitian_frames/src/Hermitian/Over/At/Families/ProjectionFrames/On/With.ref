\import \parent.\parent.\parent.\parent.Families[X := Carrier] \as LocalVectors;
\module Point(x: Carrier) {
  \import \parent.\parent.\parent.\parent.\parent.OnProjection[P := P x].Rank[k := k].Orthonormalize[basis := basis x, factor := factors.value x] \as Frame;
  \definition frame: FrameAt (P x) := Frame.frame;
}
\definition value[x: Carrier]: FrameAt (P x) := Point[x := x].frame;
\definition local: Local[a] := Local[a] {
  domain := domain, open := \parent.Continuous[].open, contains := \parent.Continuous[].contains,
  value := value, regular := factors.frame,
  coordinates := \fun (w: Vector)(i: Fin.Fin k) => LocalVectors.dotContinuous localTopology
    (\fun (x: Carrier) => (factors.value x).frame.apply (Domain.basis i)) (\fun (x: Carrier) => w)
    (factors.frame (Domain.basis i)) (LocalVectors.constant localTopology w),
};
