\import Inner.Of[h := h] \as Algebra;
\module Gram(k: N.Nat^) {
  \import Algebra.Gram[k := k] \as Gram;
  \definition Map: \Set := Gram.Map;
  \definition Injective[A: Map]: \Prop := Gram.Injective A;
  \definition Factorization[A: Map]: \Set := Gram.Factorization[A];
  \definition exists: \forall (A: Map) -> Injective A -> Positive h -> \exists Factorization[A] :=
    Algebra.Algorithm[].exists k;
}
\module Families(X: \Set);
