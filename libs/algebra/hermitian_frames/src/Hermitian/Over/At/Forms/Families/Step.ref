\import \parent.Rank[k := k] \as Lower;
\import \parent.Rank[k := N.Nat^::succ k] \as Higher;
\import Geometry.Finite[n := k] \as Domain;
\import Geometry.Finite[n := N.Nat^::succ k] \as Total;
\import Domain.Successor[] \as Split;
\module On(source: Source.Topology, A: Higher.Family, regular: Higher.Regular source A, injective: Higher.Injective A, positive: Positive h);
\definition exists: Previous (N.Nat^::succ k) :=
  \fun (source: Source.Topology)(A: Higher.Family)(regular: _)(injective: _)(positive: _) =>
    On[source := source, A := A, regular := regular, injective := injective, positive := positive].exists;
