\import Algebra.Gram[k := k] \as Gram;
\import Vectors.Matrix[m := k] \as Matrices;
\definition Family: \Set := X -> Gram.Map;
\definition Regular[source: Source.Topology][A: Family]: \Prop := Matrices.Regular source A;
\definition Injective[A: Family]: \Prop := \forall (x: X) -> Gram.Injective (A x);
\structure Factors[A: Family, source: Source.Topology]: \Set := {
  value: \forall (x: X) -> Gram.Factorization[A x],
  frame: Regular source (\fun (x: X) => (value x).frame),
};
