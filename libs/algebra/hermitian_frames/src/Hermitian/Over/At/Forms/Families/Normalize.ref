\import metric_spaces.RealFunctions[A := X] \as Reals;
\import Reals.SquareRoot[] \as Root;
\import Reals.Reciprocal[] \as Reciprocal;
\definition value[x: X]: Vector := Algebra.Normalize[v := v x, positive := positive x].value;
\definition squaredContinuous: Reals.Continuous source (\fun (x: X) => Algebra.squared (v x)) :=
  Functions.realPart source (\fun (x: X) => h.dot (v x) (v x)) (dotContinuous source v v continuous continuous);
\definition factorContinuous: Reals.Continuous source (\fun (x: X) => Algebra.Normalize[v := v x, positive := positive x].factor) :=
  Reciprocal.continuous source (\fun (x: X) => R.SquareRoot[].sqrt (Algebra.squared (v x)))
    (Root.continuous source (\fun (x: X) => Algebra.squared (v x)) squaredContinuous)
    (\fun (x: X) => Algebra.Normalize[v := v x, positive := positive x].lengthNonzero);
\definition regular: Continuous source value := Vectors.scale source
  (\fun (x: X) => embed (Algebra.Normalize[v := v x, positive := positive x].factor)) v
  (Functions.embedding source (\fun (x: X) => Algebra.Normalize[v := v x, positive := positive x].factor) factorContinuous) continuous;
