\definition value[x: X]: Algebra.Gram[k := N.Nat^::succ k].Factorization[A x] :=
  Algebra.Gram[k := k].Step[].On[A := A x, injective := injective x, positive := positive].With[previous := prior.value x].factorization;
\definition factors: Higher.Factors[A, source] := Higher.Factors[A, source] {
  value := value,
  frame := \fun (v: Total.Vector) => Vectors.addition source
    (\fun (x: X) => E.space.smul (Split.head v) (unit x))
    (\fun (x: X) => (prior.value x).frame.apply (Split.tail v))
    (Vectors.scale source (\fun (x: X) => Split.head v) unit (Functions.constant source (Split.head v)) unitRegular)
    (prior.frame (Split.tail v)),
};
