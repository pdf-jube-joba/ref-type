\import topological_constructions.Product[A := Carrier, B := Carrier] \as Product;
\import Product.Maps[] \as Projections;
\import std.Data[].Pair[] \as Pair;
\import \parent.Families[X := Product.CarrierSet] \as Binary;
\import \parent.Families[X := Carrier] \as Unary;
\import topology.Maps[A := Carrier, B := Carrier].Identity[] \as Identity;
\definition multiplicationContinuous: topology.Continuity[A := Product.CarrierSet, B := Carrier].Continuous
  (Product.topology topology topology) topology (\fun (p: Product.CarrierSet) => multiply (Pair.first Carrier Carrier p) (Pair.second Carrier Carrier p)) :=
  Binary.continuous (Product.topology topology topology) (\fun (p: Product.CarrierSet) => multiply (Pair.first Carrier Carrier p) (Pair.second Carrier Carrier p))
    (Binary.product (Product.topology topology topology) (Pair.first Carrier Carrier) (Pair.second Carrier Carrier)
      (Binary.regular (Product.topology topology topology) (Pair.first Carrier Carrier) (Projections.firstContinuous topology topology))
      (Binary.regular (Product.topology topology topology) (Pair.second Carrier Carrier) (Projections.secondContinuous topology topology)));
\definition inverseContinuous: topology.Continuity[A := Carrier, B := Carrier].Continuous topology topology inverse :=
  Unary.continuous topology inverse (Unary.reciprocal topology (\fun (u: Carrier) => u) (Unary.regular topology (\fun (u: Carrier) => u) (Identity.continuous topology)));
