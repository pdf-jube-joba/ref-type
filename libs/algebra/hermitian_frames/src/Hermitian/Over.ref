\import linear_algebra.Hermitian[].Over[K := K, field := field, scalar := scalar] \as Geometry;
\import linear_algebra.Commutative[K := K, scalarRing := Fields.fieldAsCommutativeRing K field] \as Spaces;
\import Geometry.Sums[] \as Sums;
\definition conjugate: K -> K := scalar.conjugate;
\definition embed: R.Real -> K := scalar.embed;
\definition topologicalRing: topological_algebra.Topology[K := K].TopologicalRing :=
  topological_algebra.Topology[K := K].TopologicalRing {
    topology := topological.space, ring := Fields.fieldAsCommutativeRing K field,
    addition := topological.ring.addition, negation := topological.ring.negation, multiplication := topological.ring.multiplication,
  };
\module Functions(X: \Set);
\module At(n: N.Nat^);
