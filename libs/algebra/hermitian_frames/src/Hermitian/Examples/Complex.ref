\import complex.Complex[] \as C;
\import C.Algebra[] \as Algebra;
\import \parent.\parent.Complex[] \as Scalars;
\import \parent.MovingLine[K := C.Complex, field := Algebra.field, scalar := Scalars.scalar, topological := Scalars.topological] \as Example;
\import \parent.\parent.Over[K := C.Complex, field := Algebra.field, scalar := Scalars.scalar, topological := Scalars.topological].At[n := Example.two] \as Model;
\import linear_algebra.Hermitian[].Over[K := C.Complex, field := Algebra.field, scalar := Scalars.scalar].Finite[n := Example.two] \as E;
\definition movingLine: \exists Model.Forms[h := E.form].Families[X := C.Complex].Rank[k := Example.one].Factors[Example.column, topological_algebra.Complex[].topology] := Example.orthonormalization;
\import \parent.\parent.Over[K := C.Complex, field := Algebra.field, scalar := Scalars.scalar, topological := Scalars.topological].At[n := N.Nat^::zero].Unitary[] \as Empty;
\definition emptyInverse: Empty.multiply (Empty.inverse Empty.identity) Empty.identity = Empty.identity := Empty.leftInverse Empty.identity;
