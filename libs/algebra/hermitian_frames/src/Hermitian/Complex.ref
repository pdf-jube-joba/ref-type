\import complex.Complex[] \as C;
\import C.Algebra[] \as A;
\import topological_algebra.Complex[] \as Top;
\import Top.Functions[A := C.Complex] \as Functions;
\import topology.Maps[A := C.Complex, B := C.Complex].Identity[] \as Identity;
\import topological_constructions.Product[A := R.Real, B := R.Real].Universal[X := R.Real] \as Into;
\import topology.Maps[A := R.Real, B := R.Real] \as RealMaps;
\definition scalar: H.Scalar[C.Complex, A.field] := linear_algebra.Hermitian[].Complex[].scalar;
\import \parent.Nonzero[K := C.Complex, field := A.field] \as Nonzero;
\import topology.Continuity[A := C.Complex, B := C.Complex].Corestriction[S := Nonzero.points] \as Inclusion;
\import matrix_invariants.Complex[].At[n := N.Nat^::zero].ScalarOpen[] \as NonzeroOpen;
\definition topological: ScalarTopology[C.Complex, A.field, scalar] := ScalarTopology[C.Complex, A.field, scalar] {
  space := Top.topology,
  ring := topological_algebra.Topology[K := C.Complex].ringLaws Top.Ring[].topologicalRing,
  nonzeroOpen := NonzeroOpen.nonzeroOpen,
  inversion := topological_algebra.Complex[].Functions[A := Nonzero.Carrier].inverseContinuous (Nonzero.topology Top.topology) (\fun (x: Nonzero.Carrier) => x) (Inclusion.inclusionContinuous Top.topology) Nonzero.nonzero,
  conjugate := Functions.conjugateContinuous Top.topology (\fun (z: C.Complex) => z) (Identity.continuous Top.topology),
  realPart := Functions.realContinuous Top.topology (\fun (z: C.Complex) => z) (Identity.continuous Top.topology),
  embed := Into.pairContinuous Line.topology Line.topology Line.topology (\fun (a: R.Real) => a) (\fun (a: R.Real) => R.zero)
    (RealMaps.Identity[].continuous Line.topology) (RealMaps.constantContinuous Line.topology Line.topology R.zero),
};
