\definition scalar: H.Scalar[R.Real, R.Algebra[].field] := linear_algebra.Hermitian[].Real[].scalar;
\import topology.Maps[A := R.Real, B := R.Real].Identity[] \as Identity;
\import \parent.Nonzero[K := R.Real, field := R.Algebra[].field] \as Nonzero;
\import topology.Continuity[A := R.Real, B := R.Real].Corestriction[S := Nonzero.points] \as Inclusion;
\import matrix_invariants.Real[].At[n := N.Nat^::zero].ScalarOpen[] \as NonzeroOpen;
\definition topological: ScalarTopology[R.Real, R.Algebra[].field, scalar] := ScalarTopology[R.Real, R.Algebra[].field, scalar] {
  space := Line.topology,
  ring := topological_algebra.Topology[K := R.Real].ringLaws topological_algebra.Real[].topologicalRing,
  nonzeroOpen := NonzeroOpen.nonzeroOpen,
  inversion := metric_spaces.RealFunctions[A := Nonzero.Carrier].Reciprocal[].continuous (Nonzero.topology Line.topology) (\fun (x: Nonzero.Carrier) => x) (Inclusion.inclusionContinuous Line.topology) Nonzero.nonzero,
  conjugate := Identity.continuous Line.topology,
  realPart := Identity.continuous Line.topology,
  embed := Identity.continuous Line.topology,
};
