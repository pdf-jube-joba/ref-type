\import topology.Topology[Carrier := K] \as Space;
\definition points: \Pow K := Space.Complement (Space.Singleton field.zero);
\definition Carrier: \Set := \Cast[K] points;
\import Space.Subspace[S := points] \as Subspace;
\definition topology[space: Space.Topology]: topology.Topology[Carrier := Carrier].Topology := Subspace.topology space;
\definition nonzero: \forall (x: Carrier) -> Logic.Not (x = field.zero) := \fun (x: Carrier) => \bysub(K, points, x);
