\import linear_algebra.Hermitian[] \as H;
\import std.Alg[].Field[] \as Fields;
\import real.Analysis[] \as R;
\import metric_spaces.RealLine[] \as Line;
\import std.Data[].Nat[] \as N;
\import std.Data[].FinSet[] \as Fin;
\import std.Logic[].Proposition[] \as Logic;
\import std.Logic[].Equality[] \as Equality;
\use Equality.sym;
\use Equality.trans;
\use Equality.congr;
\use Equality.eq_reason_in;
\module Nonzero(K: \Set, field: Fields.Field[K]);
\structure ScalarTopology[K: \Set, field: Fields.Field[K], scalar: H.Scalar[K, field]]: \Set := {
  space: topology.Topology[Carrier := K].Topology,
  ring: topological_algebra.Topology[K := K].RingLaws[space, Fields.fieldAsCommutativeRing K field],
  conjugate: topology.Continuity[A := K, B := K].Continuous space space scalar.conjugate,
  realPart: topology.Continuity[A := K, B := R.Real].Continuous space Line.topology scalar.realPart,
  nonzeroOpen: topology.Topology[Carrier := K].IsOpenIn space (Nonzero[K := K, field := field].points),
  inversion: topology.Continuity[A := Nonzero[K := K, field := field].Carrier, B := K].Continuous (Nonzero[K := K, field := field].topology space) space (\fun (x: Nonzero[K := K, field := field].Carrier) => field.inv x),
  embed: topology.Continuity[A := R.Real, B := K].Continuous Line.topology space scalar.embed,
};
\module Over(K: \Set, field: Fields.Field[K], scalar: H.Scalar[K, field], topological: ScalarTopology[K, field, scalar]);
\module Real;
\module Complex;
\module Examples;
