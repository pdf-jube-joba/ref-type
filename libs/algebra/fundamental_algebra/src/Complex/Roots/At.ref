\import \root.Complex[].Difference[p := p, a := a] \as Difference;
\module Step(term: First.Term Difference.polynomial, w: Directions.Direction term.order (Op.mul (Op.conj Difference.value) (Monic.evaluate term.coefficients Op.zero)));
\definition root: Monic.Positive p -> Minimum.Global[p, a] -> Monic.monicEvaluate p a = Op.zero := \block {
  \fun (positive: _)(minimum: Minimum.Global[p, a]) \then
  \return Order.byContradiction (Monic.monicEvaluate p a = Op.zero) (\block {
    \fun (nonzero: Op.NonZero Difference.value) \then
    \takefrom term: First.Term Difference.polynomial \by First.exists Difference.polynomial (Difference.nonzero positive) \then
    \let c: C.Complex := Op.mul (Op.conj Difference.value) (Monic.evaluate term.coefficients Op.zero) \then
    \takefrom w: Directions.Direction term.order c \by Directions.exists term.order (Difference.orderPositive term) c
      (Arithmetic.nonzeroProduct (Op.conj Difference.value) (Monic.evaluate term.coefficients Op.zero) (conjugateNonzero Difference.value nonzero) term.nonzero) \then
    \return Step[term := term, w := w].contradiction minimum
  })
};
