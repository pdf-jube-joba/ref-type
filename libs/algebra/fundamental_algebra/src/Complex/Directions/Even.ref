\definition exists: n = double m -> (\exists Direction m c) -> \exists Direction n c := \block {
  \fun (equation: n = double m)(previous: \exists Direction m c) \then
  \takefrom v: Direction m c \by previous \then
  \takefrom w: \Cast[Units.Carrier] ({ w: Units.Carrier \where Op.mul w w = v }) \by Units.exists v \then
  \let powers: Field.power w (double m) = Field.power v m := trans!{C.Complex} _ _ _ (evenPower w m)
    (congr!{C.Complex C.Complex} (\fun (z: C.Complex) => Field.power z m) _ _ (\bysub(Units.Carrier, { w: Units.Carrier \where Op.mul w w = v }, w))) \then
  \let result: \exists Direction (double m) c := \exact(\into[Units.Carrier](w, Direction (double m) c) \by {
    R.ltReplaceLeft (C.re (Op.mul c (Field.power v m))) (C.re (Op.mul c (Field.power w (double m)))) Real.zero
      (sym!{Real.Real} _ _ (congr!{C.Complex Real.Real} (\fun (z: C.Complex) => C.re (Op.mul c z)) _ _ powers))
      (\bysub(Units.Carrier, Direction m c, v))
  }, Direction (double m) c) \then
  \return \idelim double m = n \with k: N.Nat^ => \exists Direction k c \by { base: result, equality: sym!{N.Nat^} _ _ equation }
};
