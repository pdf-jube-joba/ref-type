\import Field.Automorphism[] \as Automorphisms;
\import Monic.RootProduct[] \as RootProduct;
\definition root: \forall (f: Automorphisms.Automorphism)(p: Coefficients)(z: C.Complex) -> Monic.monicEvaluate p z = Op.zero ->
  Monic.monicEvaluate (Lists.map C.Complex C.Complex f.map.apply p) (f.map.apply z) = Op.zero :=
  \fun (f: Automorphisms.Automorphism)(p: Coefficients)(z: C.Complex)(root: _) => trans!{C.Complex} _ _ _ (sym!{C.Complex} _ _ (Monic.monicEquivariant f p z))
    (trans!{C.Complex} _ _ _ (congr!{C.Complex C.Complex} f.map.apply _ _ root) f.map.preservesZero);
\definition coefficients: \forall (f: Automorphisms.Automorphism)(roots: Coefficients) ->
  Lists.map C.Complex C.Complex f.map.apply (RootProduct.coefficients roots) = RootProduct.coefficients (Lists.map C.Complex C.Complex f.map.apply roots) := RootProduct.natural;
\definition factorization: \forall (f: Automorphisms.Automorphism)(roots: Coefficients) ->
  Monic.asPolynomial (Lists.map C.Complex C.Complex f.map.apply (RootProduct.coefficients roots)) = Monic.factors (Lists.map C.Complex C.Complex f.map.apply roots) :=
  \fun (f: Automorphisms.Automorphism)(roots: Coefficients) => trans!{Polynomial.Carrier} _ _ _ (congr!{Coefficients Polynomial.Carrier} Monic.asPolynomial _ _ (coefficients f roots))
    (RootProduct.factorization (Lists.map C.Complex C.Complex f.map.apply roots));
