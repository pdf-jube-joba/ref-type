\import std.Arithmetic[].Int[] \as I;
\import std.Arithmetic[].IntAlgebra[].Ring[] \as IntegerRing;
\import \root.Module[].Over[R := I.Int^, ring := IntegerRing.ring] \as Integers;
\import \parent.Laws[V := N.Carrier, space := N.space] \as Target;
\import \root.Module[].IntegerGroup[Carrier := N.Carrier, group := Target.additive] \as TargetIntegers;
\import TargetIntegers.Mapping[B := N.Carrier, other := Target.additive] \as IntegerMaps;
\import algebra.Exact[A := N.Carrier, B := N.Carrier].Groups[source := Target.additive, target := Target.additive] \as Groups;
\import algebra.Hom[A := N.Carrier, B := N.Carrier] \as GroupMaps;
\definition coefficients: Integers.Bundle := Integers.Bundle { Carrier := N.Carrier, space := TargetIntegers.space };
\module Scalar(a: R) {
  \definition function(x: N.Carrier): N.Carrier := #smul{N.space} a x;
  \definition additive: Groups.Map := \into[N.Carrier -> N.Carrier](function, Groups.Map) \by {
    GroupMaps.MonoidLaws[Groups.domain, Groups.codomain, function] {
      unit := Target.scaleZero a, operation := #vectorAdd{N.space} a,
    }
  };
  \definition map: Integers.Hom[V := N.Carrier, W := N.Carrier, source := TargetIntegers.space, target := TargetIntegers.space].Map := IntegerMaps.fromGroup additive;
}
\module From(V: \Set, domain: Integers.Space V);
\module Mapping(L: Bundle) {
  \import \parent.\parent.Hom[V := N.Carrier, W := L.Carrier, source := N.space, target := L.space] \as Maps;
  \module On(u: Maps.Map);
}
