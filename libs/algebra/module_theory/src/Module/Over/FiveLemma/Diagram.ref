\structure Commutative: \Prop := {
  first: \forall (x: A.Carrier) -> b.apply (s.first.apply x) = t.first.apply (a.apply x),
  second: \forall (x: B.Carrier) -> c.apply (s.second.apply x) = t.second.apply (b.apply x),
  third: \forall (x: C.Carrier) -> d.apply (s.third.apply x) = t.third.apply (c.apply x),
  last: \forall (x: D.Carrier) -> e.apply (s.last.apply x) = t.last.apply (d.apply x),
};
\import \parent.\parent.Hom[V := C.Carrier, W := C1.Carrier, source := C.space, target := C1.space] \as MiddleMaps;
\import \parent.\parent.Hom[V := D.Carrier, W := D1.Carrier, source := D.space, target := D1.space] \as NextMaps;
\import \parent.\parent.Hom[V := E.Carrier, W := E1.Carrier, source := E.space, target := E1.space] \as LastMaps;
\import \parent.\parent.Hom[V := C1.Carrier, W := D1.Carrier, source := C1.space, target := D1.space] \as TargetThird;
\import \parent.\parent.Hom[V := B1.Carrier, W := C1.Carrier, source := B1.space, target := C1.space] \as TargetSecond;
\import \parent.\parent.Laws[V := C.Carrier, space := C.space] \as Middle;
\import \parent.\parent.Laws[V := C1.Carrier, space := C1.space] \as Middle1;
\import \parent.\parent.Laws[V := D1.Carrier, space := D1.space] \as Next1;
\import algebra.Group[].Of[Carrier := C.Carrier, group := Middle.additive] \as Group;
\import algebra.Group[].Of[Carrier := C1.Carrier, group := Middle1.additive] \as Group1;
\import algebra.Group[].Of[Carrier := D1.Carrier, group := Next1.additive] \as NextGroup1;
\definition kernelZero: Commutative -> Surjective A A1 a -> Injective B B1 b -> Injective D D1 d ->
  \forall (x: C.Carrier) -> c.apply x = Middle1.zero -> x = Middle.zero := \block {
  \fun (diagram: Commutative)(leftOnto: Surjective A A1 a)(beforeInjective: Injective B B1 b)(afterInjective: Injective D D1 d)(x: C.Carrier)(killed: _) \then
  \let closed: s.third.apply x = D.space.zero := afterInjective _ _
    (trans!{D1.Carrier} _ _ _ (diagram.third x)
      (trans!{D1.Carrier} _ _ _ (congr!{C1.Carrier D1.Carrier} (t.third.apply) _ _ killed)
        (trans!{D1.Carrier} _ _ _ (TargetThird.zeroPreserved t.third) (sym!{D1.Carrier} _ _ (NextMaps.zeroPreserved d))))) \then
  \takefrom u: \Cast[B.Carrier] ({ u: B.Carrier \where s.second.apply u = x }) \by s.kernelC x closed \then
  \let representation: s.second.apply u = x := \bysub(B.Carrier, { u: B.Carrier \where s.second.apply u = x }, u) \then
  \let beforeClosed: t.second.apply (b.apply u) = Middle1.zero := trans!{C1.Carrier} _ _ _ (sym!{C1.Carrier} _ _ (diagram.second u))
    (trans!{C1.Carrier} _ _ _ (congr!{C.Carrier C1.Carrier} (c.apply) _ _ representation) killed) \then
  \takefrom v1: \Cast[A1.Carrier] ({ v: A1.Carrier \where t.first.apply v = b.apply u }) \by t.kernelB (b.apply u) beforeClosed \then
  \takefrom v: \Cast[A.Carrier] ({ v: A.Carrier \where a.apply v = v1 }) \by leftOnto v1 \then
  \let firstEquals: s.first.apply v = u := beforeInjective _ _
    (trans!{B1.Carrier} _ _ _ (diagram.first v)
      (trans!{B1.Carrier} _ _ _ (congr!{A1.Carrier B1.Carrier} (t.first.apply) _ _ (\bysub(A.Carrier, { v: A.Carrier \where a.apply v = v1 }, v)))
        (\bysub(A1.Carrier, { v: A1.Carrier \where t.first.apply v = b.apply u }, v1)))) \then
  \return trans!{C.Carrier} _ _ _ (sym!{C.Carrier} _ _ representation)
    (trans!{C.Carrier} _ _ _ (congr!{B.Carrier C.Carrier} (s.second.apply) _ _ (sym!{B.Carrier} _ _ firstEquals)) (s.zeroB v))
};
\definition injective: Commutative -> Surjective A A1 a -> Injective B B1 b -> Injective D D1 d -> Injective C C1 c := \block {
  \fun (diagram: Commutative)(leftOnto: Surjective A A1 a)(beforeInjective: Injective B B1 b)(afterInjective: Injective D D1 d)(x, y: C.Carrier)(same: _) \then
  \let differenceZero: Group.difference x y = Middle.zero := kernelZero diagram leftOnto beforeInjective afterInjective (Group.difference x y)
    (trans!{C1.Carrier} _ _ _ (MiddleMaps.differencePreserved c x y)
      (trans!{C1.Carrier} _ _ _ (congr!{C1.Carrier C1.Carrier} (\fun (z: C1.Carrier) => Group1.difference z (c.apply y)) _ _ same) (Group1.inverseRight (c.apply y)))) \then
  \return Group.cancelRight (Middle.neg y) x y (trans!{C.Carrier} _ _ _ differenceZero (sym!{C.Carrier} _ _ (Group.inverseRight y)))
};
\definition remainder[y: C1.Carrier][x: C.Carrier]: C1.Carrier := Group1.difference y (c.apply x);
\definition remainderClosed: \forall (diagram: Commutative)(y: C1.Carrier)(x: C.Carrier) -> d.apply (s.third.apply x) = t.third.apply y ->
  t.third.apply (remainder y x) = Next1.zero :=
  \fun (diagram: Commutative)(y: C1.Carrier)(x: C.Carrier)(same: _) => trans!{D1.Carrier} _ _ _
    (TargetThird.differencePreserved t.third y (c.apply x))
    (trans!{D1.Carrier} _ _ _
      (congr!{D1.Carrier D1.Carrier} (\fun (z: D1.Carrier) => NextGroup1.difference (t.third.apply y) z) _ _
        (trans!{D1.Carrier} _ _ _ (sym!{D1.Carrier} _ _ (diagram.third x)) same))
      (NextGroup1.inverseRight (t.third.apply y)));
\definition surjective: Commutative -> Surjective B B1 b -> Surjective D D1 d -> Injective E E1 e -> Surjective C C1 c := \block {
  \fun (diagram: Commutative)(beforeOnto: Surjective B B1 b)(afterOnto: Surjective D D1 d)(lastInjective: Injective E E1 e)(y: C1.Carrier) \then
  \takefrom v: \Cast[D.Carrier] ({ v: D.Carrier \where d.apply v = t.third.apply y }) \by afterOnto (t.third.apply y) \then
  \let projection: d.apply v = t.third.apply y := \bysub(D.Carrier, { v: D.Carrier \where d.apply v = t.third.apply y }, v) \then
  \let closed: s.last.apply v = E.space.zero := lastInjective _ _
    (trans!{E1.Carrier} _ _ _ (diagram.last v)
      (trans!{E1.Carrier} _ _ _ (congr!{D1.Carrier E1.Carrier} (t.last.apply) _ _ projection)
        (trans!{E1.Carrier} _ _ _ (t.zeroD y) (sym!{E1.Carrier} _ _ (LastMaps.zeroPreserved e))))) \then
  \takefrom x: \Cast[C.Carrier] ({ x: C.Carrier \where s.third.apply x = v }) \by s.kernelD v closed \then
  \let reaches: d.apply (s.third.apply x) = t.third.apply y := trans!{D1.Carrier} _ _ _
    (congr!{D.Carrier D1.Carrier} (d.apply) _ _ (\bysub(C.Carrier, { x: C.Carrier \where s.third.apply x = v }, x))) projection \then
  \takefrom u1: \Cast[B1.Carrier] ({ u: B1.Carrier \where t.second.apply u = remainder y x })
    \by t.kernelC (remainder y x) (remainderClosed diagram y x reaches) \then
  \takefrom u: \Cast[B.Carrier] ({ u: B.Carrier \where b.apply u = u1 }) \by beforeOnto u1 \then
  \let correction: c.apply (s.second.apply u) = remainder y x := trans!{C1.Carrier} _ _ _ (diagram.second u)
    (trans!{C1.Carrier} _ _ _ (congr!{B1.Carrier C1.Carrier} (t.second.apply) _ _ (\bysub(B.Carrier, { u: B.Carrier \where b.apply u = u1 }, u)))
      (\bysub(B1.Carrier, { u: B1.Carrier \where t.second.apply u = remainder y x }, u1))) \then
  \return Logic.existsIntro[C.Carrier, { x: C.Carrier \where c.apply x = y }] (Middle.add x (s.second.apply u))
    (trans!{C1.Carrier} _ _ _ (c.addition x (s.second.apply u))
      (trans!{C1.Carrier} _ _ _ (congr!{C1.Carrier C1.Carrier} (Middle1.add (c.apply x)) _ _ correction)
        (trans!{C1.Carrier} _ _ _ (Group1.comm (c.apply x) (remainder y x))
          (trans!{C1.Carrier} _ _ _ (Group1.assoc y (Middle1.neg (c.apply x)) (c.apply x))
            (trans!{C1.Carrier} _ _ _ (congr!{C1.Carrier C1.Carrier} (Middle1.add y) _ _ (Group1.inverseLeft (c.apply x))) (Group1.zeroRight y))))))
};
\import \parent.\parent.Isomorphism[V := C.Carrier, W := C1.Carrier, source := C.space, target := C1.space] \as Isomorphisms;
\import Isomorphisms.OfBijective[f := c] \as Iso;
\definition isomorphism[diagram: Commutative][leftOnto: Surjective A A1 a][beforeInjective: Injective B B1 b][beforeOnto: Surjective B B1 b]
  [afterInjective: Injective D D1 d][afterOnto: Surjective D D1 d][lastInjective: Injective E E1 e]: Isomorphisms.Isomorphism :=
  Iso.isomorphism (injective diagram leftOnto beforeInjective afterInjective) (surjective diagram beforeOnto afterOnto lastInjective);
\definition existence: Commutative -> Surjective A A1 a -> Injective B B1 b -> Surjective B B1 b ->
  Injective D D1 d -> Surjective D D1 d -> Injective E E1 e -> \exists Isomorphisms.Isomorphism :=
  \fun (diagram: Commutative)(leftOnto: Surjective A A1 a)(beforeInjective: Injective B B1 b)(beforeOnto: Surjective B B1 b)
    (afterInjective: Injective D D1 d)(afterOnto: Surjective D D1 d)(lastInjective: Injective E E1 e) =>
    \exact(isomorphism diagram leftOnto beforeInjective beforeOnto afterInjective afterOnto lastInjective, Isomorphisms.Isomorphism);
