\import std.Logic[].Equality[] \as Equality;
\use Equality.congr;
\use Equality.sym;
\import \parent.\parent.Hom[V := V, W := Carrier, source := target, target := space] \as Constants;
\definition constant: Constants.Map := Constants.Map {
  apply := \fun (v: V)(_: X) => v,
  addition := \fun (u, v: V) => \refl(\fun (_: X) => (target).add u v),
  scalar := \fun (a: R)(v: V) => \refl(\fun (_: X) => (target).smul a v),
};
\import \parent.\parent.Isomorphism[V := V, W := Carrier, source := target, target := space] \as Isomorphisms;
\definition isomorphism[unique: \forall (x: X) -> x = point]: Isomorphisms.Isomorphism := Isomorphisms.Isomorphism {
  forward := constant, backward := evaluation point,
  leftInverse := \fun (v: V) => \refl(v),
  rightInverse := \fun (f: Carrier) => \axiom:funext((\fun (_: X) => f point), f,
    \fun (x: X) => congr!{X V} f point x (sym!{X} x point (unique x))),
};
