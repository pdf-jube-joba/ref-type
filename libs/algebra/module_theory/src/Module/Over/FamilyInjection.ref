\import std.Logic[].Equality[].Transport[A := Index] \as Transport;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\structure ValueLaws[i, j: Index, x: family.Carrier i, y: family.Carrier j]: \Prop {
  equal: \forall (same: i = j) -> y = Transport.cast family.Carrier i j same x,
  different: Logic.Not (i = j) -> y = (family.space j).zero,
}
\definition Value(i, j: Index)(x: family.Carrier i): \Set :=
  \Cast[family.Carrier j] ({ y: family.Carrier j \where ValueLaws[i, j, x, y] });
\definition existsValue: \forall (i, j: Index)(x: family.Carrier i) -> \exists Value i j x :=
  \fun (i, j: Index)(x: family.Carrier i) =>
    either!{{(Classical.excludedMiddle (i = j))} {\exists Value i j x}
      {\block {
        \fun (same: i = j) \then
        \let value: family.Carrier j := Transport.cast family.Carrier i j same x \then
        \return \exact(\into[family.Carrier j](value, { y: family.Carrier j \where ValueLaws[i, j, x, y] }) \by {
          ValueLaws[i, j, x, value] {
            equal := \fun (other: i = j) => \refl(value),
            different := \fun (ne: Logic.Not (i = j)) => Logic.falseElim (value = (family.space j).zero) (ne same),
          }
        }, Value i j x)
      }}
      {\fun (ne: Logic.Not (i = j)) =>
        \exact(\into[family.Carrier j]((family.space j).zero, { y: family.Carrier j \where ValueLaws[i, j, x, y] }) \by {
          ValueLaws[i, j, x, (family.space j).zero] {
            equal := \fun (same: i = j) =>
              Logic.falseElim ((family.space j).zero = Transport.cast family.Carrier i j same x) (ne same),
            different := \fun (unused: Logic.Not (i = j)) => \refl((family.space j).zero),
          }
        }, Value i j x)}
    };
\definition laws(i, j: Index)(x: family.Carrier i)(y: Value i j x): ValueLaws[i, j, x, y] :=
  \bysub(family.Carrier j, { y: family.Carrier j \where ValueLaws[i, j, x, y] }, y);
\definition uniqueValue: \forall (i, j: Index)(x: family.Carrier i)(a, b: Value i j x) -> a = b :=
  \fun (i, j: Index)(x: family.Carrier i)(a, b: Value i j x) =>
    either!{{(Classical.excludedMiddle (i = j))} {a = b}
      {\fun (same: i = j) => trans!{{family.Carrier j}} _ _ _
        ((laws i j x a).equal same)
        (sym!{{family.Carrier j}} b (Transport.cast family.Carrier i j same x) ((laws i j x b).equal same))}
      {\fun (ne: Logic.Not (i = j)) => trans!{{family.Carrier j}} a (family.space j).zero b
        ((laws i j x a).different ne)
        (sym!{{family.Carrier j}} b (family.space j).zero ((laws i j x b).different ne))}
    };
\definition selected(i: Index)(x: family.Carrier i)(j: Index): Value i j x :=
  \choice Value i j x \by { existence: existsValue i j x, uniqueness: uniqueValue i j x };
\definition point(i: Index)(x: family.Carrier i)(j: Index): family.Carrier j := selected i x j;
\definition onEqual: \forall (i, j: Index)(x: family.Carrier i)(same: i = j) ->
  point i x j = Transport.cast family.Carrier i j same x :=
  \fun (i, j: Index)(x: family.Carrier i)(same: i = j) =>
    (laws i j x (selected i x j)).equal same;
\definition onSame: \forall (i: Index)(x: family.Carrier i) -> point i x i = x :=
  \fun (i: Index)(x: family.Carrier i) => trans!{{family.Carrier i}} _ _ _
    ((laws i i x (selected i x i)).equal (\refl(i))) (Transport.castRefl family.Carrier i x);
\definition onDifferent: \forall (i, j: Index)(x: family.Carrier i) -> Logic.Not (i = j) ->
  point i x j = (family.space j).zero :=
  \fun (i, j: Index)(x: family.Carrier i)(ne: Logic.Not (i = j)) => (laws i j x (selected i x j)).different ne;
\import \parent.Product[Index := Index, family := family] \as Product;
\module At(i: Index);
