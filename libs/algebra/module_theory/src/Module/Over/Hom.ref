\import \parent.Laws[V := V, space := source] \as Source;
\import \parent.Laws[V := W, space := target] \as Target;
\import algebra.Group[].Of[Carrier := V, group := Source.additive] \as SourceGroup;
\import algebra.Group[].Of[Carrier := W, group := Target.additive] \as TargetGroup;
\structure Data: \Set := {
  apply: V -> W,
};
\structure Laws[data: Data]: \Prop := {
  addition: \forall (x, y: V) -> data.apply (Source.add x y) = Target.add (data.apply x) (data.apply y),
  scalar: \forall (a: R)(x: V) -> data.apply (Source.scale a x) = Target.scale a (data.apply x),
};
\definition Map: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition dataExt: \forall (f, g: Data) -> f.apply = g.apply -> f = g :=
  \induction (f: Data) \return \forall (g: Data) -> f.apply = g.apply -> f = g \with {
    | # : \fun (f: V -> W) =>
      \induction (g: Data) \return f = g.apply -> Data::# f = g \with {
        | # : \fun (g: V -> W)(equal: f = g) => congr!{{V -> W} Data} (\fun (h: V -> W) => Data::# h) f g equal
      }
  };
\definition ext: \forall (f, g: Map) -> (\forall (x: V) -> f.apply x = g.apply x) -> f = g :=
  \fun (f, g: Map)(same: _) => dataExt f g (\axiom:funext(f.apply, g.apply, same));
\definition zeroPreserved: \forall (f: Map) -> f.apply Source.zero = Target.zero :=
  \fun (f: _) => TargetGroup.cancelLeft (f.apply Source.zero) (f.apply Source.zero) Target.zero
    (trans!{W} _ _ _
      (trans!{W} _ _ _ (sym!{W} _ _ (f.addition Source.zero Source.zero))
        (congr!{V W} (f.apply) _ _ (SourceGroup.zeroLeft Source.zero)))
      (sym!{W} _ _ (TargetGroup.zeroRight (f.apply Source.zero))));
\definition negativePreserved: \forall (f: Map)(x: V) -> f.apply (Source.neg x) = Target.neg (f.apply x) :=
  \fun (f: _)(x: _) => TargetGroup.inverseUnique (f.apply x) (f.apply (Source.neg x))
    (trans!{W} _ _ _ (sym!{W} _ _ (f.addition (Source.neg x) x))
      (trans!{W} _ _ _ (congr!{V W} (f.apply) _ _ (SourceGroup.inverseLeft x)) (zeroPreserved f)));
\definition differencePreserved: \forall (f: Map)(x, y: V) ->
  f.apply (SourceGroup.difference x y) = TargetGroup.difference (f.apply x) (f.apply y) :=
  \fun (f: _)(x, y: _) => trans!{W} _ _ _ (f.addition x (Source.neg y))
    (congr!{W W} (Target.add (f.apply x)) _ _ (negativePreserved f y));

\definition injectiveOfZeroKernel: \forall (f: Map) ->
  (\forall (x: V) -> f.apply x = Target.zero -> x = Source.zero) ->
  \forall (x, y: V) -> f.apply x = f.apply y -> x = y :=
  \fun (f: Map)(kernel: \forall (x: V) -> f.apply x = Target.zero -> x = Source.zero)(x, y: V)(equal: f.apply x = f.apply y) =>
    trans!{V} x (Source.add (SourceGroup.difference x y) y) y
      (sym!{V} _ _ (SourceGroup.addDifference x y))
      (trans!{V} _ _ _
        (congr!{V V} (\fun (v: V) => Source.add v y) _ _
          (kernel (SourceGroup.difference x y)
            (trans!{W} _ _ _ (differencePreserved f x y)
              (trans!{W} _ _ _ (congr!{W W} (\fun (v: W) => TargetGroup.difference v (f.apply y)) _ _ equal)
                (TargetGroup.inverseRight (f.apply y))))))
        (SourceGroup.zeroLeft y));

\definition zeroMap: Map := Map {
  apply := \fun (x: V) => Target.zero,
  addition := \fun (x, y: V) => sym!{W} _ _ (TargetGroup.zeroLeft Target.zero),
  scalar := \fun (a: R)(x: V) => sym!{W} _ _ (Target.scaleZero a),
};
\definition plus[f, g: Map]: Map := Map {
  apply := \fun (x: V) => Target.add (f.apply x) (g.apply x),
  addition := \fun (x, y: V) => trans!{W} _ _ _
    (congr2!{W W W} Target.add _ _ _ _ (f.addition x y) (g.addition x y))
    (TargetGroup.four (f.apply x) (f.apply y) (g.apply x) (g.apply y)),
  scalar := \fun (a: R)(x: V) => trans!{W} _ _ _
    (congr2!{W W W} Target.add _ _ _ _ (f.scalar a x) (g.scalar a x))
    (sym!{W} _ _ (target.vectorAdd a (f.apply x) (g.apply x))),
};
\definition negative[f: Map]: Map := Map {
  apply := \fun (x: V) => Target.neg (f.apply x),
  addition := \fun (x, y: V) => trans!{W} _ _ _
    (congr!{W W} Target.neg _ _ (f.addition x y)) (TargetGroup.negAdd (f.apply x) (f.apply y)),
  scalar := \fun (a: R)(x: V) => trans!{W} _ _ _
    (congr!{W W} Target.neg _ _ (f.scalar a x)) (sym!{W} _ _ (Target.scaleNeg a (f.apply x))),
};
\import std.Alg[].Monoid[] \as Monoid;
\definition additive: Alg.CommutativeGroup[Map] := Alg.CommutativeGroup[Map] {
  base := Alg.GroupData[Map]::# zeroMap plus negative,
  group := Alg.GroupLaws[Map, Alg.GroupData[Map]::# zeroMap plus negative] {
    monoid := Monoid.MonoidLaws[Map, Monoid.MonoidData[Map]::# zeroMap plus] {
      leftIdentity := \fun (f: Map) => ext (plus zeroMap f) f (\fun (x: V) => TargetGroup.zeroLeft (f.apply x)),
      rightIdentity := \fun (f: Map) => ext (plus f zeroMap) f (\fun (x: V) => TargetGroup.zeroRight (f.apply x)),
      associative := \fun (f, g, h: Map) => ext (plus (plus f g) h) (plus f (plus g h))
        (\fun (x: V) => TargetGroup.assoc (f.apply x) (g.apply x) (h.apply x)),
    },
    leftInverse := \fun (f: Map) => ext (plus (negative f) f) zeroMap (\fun (x: V) => TargetGroup.inverseLeft (f.apply x)),
    rightInverse := \fun (f: Map) => ext (plus f (negative f)) zeroMap (\fun (x: V) => TargetGroup.inverseRight (f.apply x)),
  },
  commutative := \fun (f, g: Map) => ext (plus f g) (plus g f) (\fun (x: V) => TargetGroup.comm (f.apply x) (g.apply x)),
};
\module Composition(U: \Set, domain: Space U) {
  \import \parent.\parent.Hom[V := U, W := V, source := domain, target := source] \as Before;
  \import \parent.\parent.Hom[V := U, W := W, source := domain, target := target] \as Result;
  \definition compose[f: Map][g: Before.Map]: Result.Map := Result.Map {
    apply := \fun (x: U) => f.apply (g.apply x),
    addition := \fun (x, y: U) => trans!{W} _ _ _
      (congr!{V W} (f.apply) _ _ (g.addition x y)) (f.addition (g.apply x) (g.apply y)),
    scalar := \fun (a: R)(x: U) => trans!{W} _ _ _
      (congr!{V W} (f.apply) _ _ (g.scalar a x)) (f.scalar a (g.apply x)),
  };
}
\module Alternating;
