\import std.Data[].Pair[].Prop[A := L.Carrier, B := V.Carrier] \as Pairs;
\definition lift(y: Sum.Carrier): O.Carrier := OverlapGroup.neg (#apply{(OverlapBack.retraction Pull.bottomInjective)} (Sum.second y));
\definition retracted: \forall (y: Sum.Carrier) -> #apply{projection} y = WholeGroup.zero ->
  LeftGroup.add (Sum.first y) (#apply{(TopPush.push topFunction)} (#apply{(OverlapBack.retraction Pull.bottomInjective)} (Sum.second y))) = LeftGroup.zero :=
  \fun (y: Sum.Carrier)(closed: #apply{projection} y = WholeGroup.zero) => trans!{L.Carrier} _ _ _
    (sym!{L.Carrier} _ _ (trans!{L.Carrier} _ _ _
      (#addition{(LeftBack.retraction Pull.leftInjective)} (#apply{(LeftPush.push leftFunction)} (Sum.first y)) (#apply{(RightPush.push rightFunction)} (Sum.second y)))
      (congr2!{L.Carrier L.Carrier L.Carrier} LeftGroup.add _ _ _ _
        (congr!{LeftEnd.Map L.Carrier} (\fun (f: LeftEnd.Map) => #apply{f} (Sum.first y)) _ _ (LeftBack.leftInverse Pull.leftInjective))
        (congr!{Cross.Map L.Carrier} (\fun (f: Cross.Map) => #apply{f} (Sum.second y)) _ _ Pull.equation))))
    (trans!{L.Carrier} _ _ _ (congr!{W.Carrier L.Carrier} (#apply{(LeftBack.retraction Pull.leftInjective)}) _ _ closed)
      (RetractMaps.zeroPreserved (LeftBack.retraction Pull.leftInjective)));
\definition first: \forall (y: Sum.Carrier) -> #apply{projection} y = WholeGroup.zero ->
  #apply{(TopPush.push topFunction)} (lift y) = Sum.first y :=
  \fun (y: Sum.Carrier)(closed: #apply{projection} y = WholeGroup.zero) => trans!{L.Carrier} _ _ _
    (TopMaps.negativePreserved (TopPush.push topFunction) (#apply{(OverlapBack.retraction Pull.bottomInjective)} (Sum.second y)))
    (sym!{L.Carrier} _ _ (LeftGroup.inverseUnique
      (#apply{(TopPush.push topFunction)} (#apply{(OverlapBack.retraction Pull.bottomInjective)} (Sum.second y))) (Sum.first y) (retracted y closed)));
\definition sumZero: \forall (y: Sum.Carrier) -> #apply{projection} y = WholeGroup.zero ->
  RightGroup.add (#apply{(BottomPush.push bottomFunction)} (lift y)) (Sum.second y) = RightGroup.zero :=
  \fun (y: Sum.Carrier)(closed: #apply{projection} y = WholeGroup.zero) => RightInjection.injective (#rightInjective{unionLaws}) _ _
    (trans!{W.Carrier} _ _ _
      (trans!{W.Carrier} _ _ _ (#addition{(RightPush.push rightFunction)} (#apply{(BottomPush.push bottomFunction)} (lift y)) (Sum.second y))
        (trans!{W.Carrier} _ _ _
          (congr!{W.Carrier W.Carrier} (\fun (x: W.Carrier) => WholeGroup.add x (#apply{(RightPush.push rightFunction)} (Sum.second y))) _ _
            (trans!{W.Carrier} _ _ _ (sym!{W.Carrier} _ _ (commutesOn (lift y)))
              (congr!{L.Carrier W.Carrier} (#apply{(LeftPush.push leftFunction)}) _ _ (first y closed)))) closed))
      (sym!{W.Carrier} _ _ (RightMaps.zeroPreserved (RightPush.push rightFunction))));
\definition second: \forall (y: Sum.Carrier) -> #apply{projection} y = WholeGroup.zero ->
  RightGroup.neg (#apply{(BottomPush.push bottomFunction)} (lift y)) = Sum.second y :=
  \fun (y: Sum.Carrier)(closed: #apply{projection} y = WholeGroup.zero) => sym!{V.Carrier} _ _
    (RightGroup.inverseUnique (#apply{(BottomPush.push bottomFunction)} (lift y)) (Sum.second y)
      (trans!{V.Carrier} _ _ _ (RightGroup.comm (Sum.second y) (#apply{(BottomPush.push bottomFunction)} (lift y))) (sumZero y closed)));
\definition law: \forall (y: Sum.Carrier) -> #apply{projection} y = WholeGroup.zero -> \exists { x: O.Carrier \where #apply{inclusion} x = y } :=
  \fun (y: Sum.Carrier)(closed: #apply{projection} y = WholeGroup.zero) => Logic.existsIntro[O.Carrier, { x: O.Carrier \where #apply{inclusion} x = y }]
    (lift y) (Pairs.ext _ _ (first y closed) (second y closed));
