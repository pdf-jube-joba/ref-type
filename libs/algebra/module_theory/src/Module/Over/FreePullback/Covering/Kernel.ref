\use std.Logic[].Equality[].eq_reason_in;
\import std.Data[].Pair[].Prop[A := L.Carrier, B := V.Carrier] \as Pairs;
\definition lift[y: Sum.Carrier]: O.Carrier := OverlapGroup.neg ((OverlapBack.retraction Pull.bottomInjective).apply (Sum.second y));
\definition retracted: \forall (y: Sum.Carrier) -> (projection).apply y = WholeGroup.zero ->
  LeftGroup.add (Sum.first y) ((TopPush.push topFunction).apply ((OverlapBack.retraction Pull.bottomInjective).apply (Sum.second y))) = LeftGroup.zero :=
  \fun (y: Sum.Carrier)(closed: (projection).apply y = WholeGroup.zero) => eq_reason_in!{L.Carrier _
    "=" _ "by" { sym!{L.Carrier} _ _ (trans!{L.Carrier} _ _ _
      ((LeftBack.retraction Pull.leftInjective).addition ((LeftPush.push leftFunction).apply (Sum.first y)) ((RightPush.push rightFunction).apply (Sum.second y)))
      (congr!{L.Carrier L.Carrier L.Carrier} LeftGroup.add _ _ _ _
        (congr!{LeftEnd.Map L.Carrier} (\fun (f: LeftEnd.Map) => (f).apply (Sum.first y)) _ _ (LeftBack.leftInverse Pull.leftInjective))
        (congr!{Cross.Map L.Carrier} (\fun (f: Cross.Map) => (f).apply (Sum.second y)) _ _ Pull.equation))) }
    "=" _ "by" { congr!{W.Carrier L.Carrier} ((LeftBack.retraction Pull.leftInjective).apply) _ _ closed }
    "=" _ "by" { RetractMaps.zeroPreserved (LeftBack.retraction Pull.leftInjective) }
  };
\definition first: \forall (y: Sum.Carrier) -> (projection).apply y = WholeGroup.zero ->
  (TopPush.push topFunction).apply (lift y) = Sum.first y :=
  \fun (y: Sum.Carrier)(closed: (projection).apply y = WholeGroup.zero) => trans!{L.Carrier} _ _ _
    (TopMaps.negativePreserved (TopPush.push topFunction) ((OverlapBack.retraction Pull.bottomInjective).apply (Sum.second y)))
    (sym!{L.Carrier} _ _ (LeftGroup.inverseUnique
      ((TopPush.push topFunction).apply ((OverlapBack.retraction Pull.bottomInjective).apply (Sum.second y))) (Sum.first y) (retracted y closed)));
\definition sumZero: \forall (y: Sum.Carrier) -> (projection).apply y = WholeGroup.zero ->
  RightGroup.add ((BottomPush.push bottomFunction).apply (lift y)) (Sum.second y) = RightGroup.zero :=
  \fun (y: Sum.Carrier)(closed: (projection).apply y = WholeGroup.zero) => RightInjection.injective ((unionLaws).rightInjective) _ _
    (eq_reason_in!{W.Carrier _
      "=" _ "by" { (RightPush.push rightFunction).addition ((BottomPush.push bottomFunction).apply (lift y)) (Sum.second y) }
      "=" _ "by" { congr!{W.Carrier W.Carrier} (\fun (x: W.Carrier) => WholeGroup.add x ((RightPush.push rightFunction).apply (Sum.second y))) _ _
            (trans!{W.Carrier} _ _ _ (sym!{W.Carrier} _ _ (commutesOn (lift y)))
              (congr!{L.Carrier W.Carrier} ((LeftPush.push leftFunction).apply) _ _ (first y closed))) }
      "=" _ "by" closed
      "=" _ "by" { sym!{W.Carrier} _ _ (RightMaps.zeroPreserved (RightPush.push rightFunction)) }
    });
\definition second: \forall (y: Sum.Carrier) -> (projection).apply y = WholeGroup.zero ->
  RightGroup.neg ((BottomPush.push bottomFunction).apply (lift y)) = Sum.second y :=
  \fun (y: Sum.Carrier)(closed: (projection).apply y = WholeGroup.zero) => sym!{V.Carrier} _ _
    (RightGroup.inverseUnique ((BottomPush.push bottomFunction).apply (lift y)) (Sum.second y)
      (trans!{V.Carrier} _ _ _ (RightGroup.comm (Sum.second y) ((BottomPush.push bottomFunction).apply (lift y))) (sumZero y closed)));
\definition law: \forall (y: Sum.Carrier) -> (projection).apply y = WholeGroup.zero -> \exists ( x: O.Carrier \where (inclusion).apply x = y ) :=
  \fun (y: Sum.Carrier)(closed: (projection).apply y = WholeGroup.zero) => Logic.existsIntro[O.Carrier, { x: O.Carrier \where (inclusion).apply x = y }]
    (lift y) (Pairs.ext _ _ (first y closed) (second y closed));
