\import Modules.Hom[V := V.Carrier, W := O.Carrier, source := V.space, target := O.space] \as OverlapMaps;
\import OverlapMaps.Composition[U := Sum.Carrier, domain := Sum.space] \as Composition;
\import Modules.Hom[V := Sum.Carrier, W := O.Carrier, source := Sum.space, target := O.space] \as Back;
\definition map: Back.Map := Back.negative (Composition.compose (OverlapBack.retraction Pull.bottomInjective) Sum.secondProjection);
\import Modules.Hom[V := O.Carrier, W := O.Carrier, source := O.space, target := O.space] \as End;
\definition leftInverse: \forall (x: O.Carrier) -> #apply{map} (#apply{inclusion} x) = x :=
  \fun (x: O.Carrier) => trans!{O.Carrier} _ _ _
    (congr!{O.Carrier O.Carrier} OverlapGroup.neg _ _ (OverlapMaps.negativePreserved (OverlapBack.retraction Pull.bottomInjective) (#apply{(BottomPush.push bottomFunction)} x)))
    (trans!{O.Carrier} _ _ _
      (congr!{O.Carrier O.Carrier} (\fun (y: O.Carrier) => OverlapGroup.neg (OverlapGroup.neg y)) _ _
        (congr!{End.Map O.Carrier} (\fun (f: End.Map) => #apply{f} x) _ _ (OverlapBack.leftInverse Pull.bottomInjective)))
      (OverlapGroup.negNeg x));
