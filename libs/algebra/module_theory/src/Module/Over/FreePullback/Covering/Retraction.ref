\use std.Logic[].Equality[].eq_reason_in;
\import Modules.Hom[V := V.Carrier, W := O.Carrier, source := V.space, target := O.space] \as OverlapMaps;
\import OverlapMaps.Composition[U := Sum.Carrier, domain := Sum.space] \as Composition;
\import Modules.Hom[V := Sum.Carrier, W := O.Carrier, source := Sum.space, target := O.space] \as Back;
\definition map: Back.Map := Back.negative (Composition.compose (OverlapBack.retraction Pull.bottomInjective) Sum.secondProjection);
\import Modules.Hom[V := O.Carrier, W := O.Carrier, source := O.space, target := O.space] \as End;
\definition leftInverse: \forall (x: O.Carrier) -> (map).apply ((inclusion).apply x) = x :=
  \fun (x: O.Carrier) => eq_reason_in!{O.Carrier _
    "=" _ "by" { congr!{O.Carrier O.Carrier} OverlapGroup.neg _ _ (OverlapMaps.negativePreserved (OverlapBack.retraction Pull.bottomInjective) ((BottomPush.push bottomFunction).apply x)) }
    "=" _ "by" { congr!{O.Carrier O.Carrier} (\fun (y: O.Carrier) => OverlapGroup.neg (OverlapGroup.neg y)) _ _
        (congr!{End.Map O.Carrier} (\fun (f: End.Map) => (f).apply x) _ _ (OverlapBack.leftInverse Pull.bottomInjective)) }
    "=" _ "by" { OverlapGroup.negNeg x }
  };
