\import \root.Module[].Over[R := R, ring := ring] \as Modules;
\definition leftFunction: Left -> Whole := (square).left;
\definition rightFunction: Right -> Whole := (square).right;
\definition topFunction: Overlap -> Left := (square).overLeft;
\definition bottomFunction: Overlap -> Right := (square).overRight;
\import Modules.Free[Generators := Left] \as L;
\import Modules.Free[Generators := Right] \as V;
\import Modules.Free[Generators := Overlap] \as O;
\import Modules.Free[Generators := Whole] \as W;
\import L.Reindex[TargetGenerators := Whole].Injection[f := leftFunction].Retraction[] \as LeftBack;
\import O.Reindex[TargetGenerators := Right].Injection[f := bottomFunction].Retraction[] \as OverlapBack;
\import V.Reindex[TargetGenerators := Whole] \as RightPush;
\import O.Reindex[TargetGenerators := Left] \as TopPush;
\definition leftInjective: \forall (x, y: Left) -> leftFunction x = leftFunction y -> x = y := (laws square).leftInjective;
\definition bottomInjective: \forall (x, y: Overlap) -> bottomFunction x = bottomFunction y -> x = y := (laws square).overlapInjective;
\import Modules.Hom[V := W.Carrier, W := L.Carrier, source := W.space, target := L.space].Composition[U := V.Carrier, domain := V.space] \as LeftComposition;
\import Modules.Hom[V := O.Carrier, W := L.Carrier, source := O.space, target := L.space].Composition[U := V.Carrier, domain := V.space] \as RightComposition;
\import Modules.Hom[V := V.Carrier, W := L.Carrier, source := V.space, target := L.space] \as Maps;
\definition leftMap: Maps.Map := LeftComposition.compose (LeftBack.retraction leftInjective) (RightPush.push rightFunction);
\definition rightMap: Maps.Map := RightComposition.compose (TopPush.push topFunction) (OverlapBack.retraction bottomInjective);
\module Image;
\module Outside;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition onGenerator: \forall (y: Right) -> (leftMap).apply (V.generator y) = (rightMap).apply (V.generator y) :=
  \fun (y: Right) => either!{{(Classical.excludedMiddle (\exists OverlapBack.Fiber y))} {(leftMap).apply (V.generator y) = (rightMap).apply (V.generator y)}
    {\block {
      \fun (exists: \exists OverlapBack.Fiber y) \then
      \takefrom z: OverlapBack.Fiber y \by exists \then
      \return \idelim bottomFunction z = y \with v: Right => (leftMap).apply (V.generator v) = (rightMap).apply (V.generator v) \by {
        base: Image[].law z, equality: \bysub(Overlap, OverlapBack.Fiber y, z)
      }
    }}
    {Outside[].law y}
  };
\definition equation: leftMap = rightMap := V.To[W := L.Carrier, target := L.space].ext leftMap rightMap onGenerator;
