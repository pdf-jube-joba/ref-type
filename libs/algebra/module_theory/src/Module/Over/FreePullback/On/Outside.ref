\definition noFiber: \forall (y: Right) -> Logic.Not (\exists OverlapBack.Fiber y) -> Logic.Not (\exists LeftBack.Fiber (rightFunction y)) := \block {
  \fun (y: Right)(empty: Logic.Not (\exists OverlapBack.Fiber y))(exists: \exists LeftBack.Fiber (rightFunction y)) \then
  \takefrom x: LeftBack.Fiber (rightFunction y) \by exists \then
  \takefrom z: \Cast[Overlap] ({ z: Overlap \where Logic.And[topFunction z = x, bottomFunction z = y] })
    \by (laws square).cartesian x y (\bysub(Left, LeftBack.Fiber (rightFunction y), x)) \then
  \return empty (Logic.existsIntro[Overlap, { z: Overlap \where bottomFunction z = y }] z
    ((\bysub(Overlap, { z: Overlap \where Logic.And[topFunction z = x, bottomFunction z = y] }, z)).right))
};
\import Modules.Hom[V := O.Carrier, W := L.Carrier, source := O.space, target := L.space] \as TopMaps;
\definition law: \forall (y: Right) -> Logic.Not (\exists OverlapBack.Fiber y) -> (leftMap).apply (V.generator y) = (rightMap).apply (V.generator y) :=
  \fun (y: Right)(empty: Logic.Not (\exists OverlapBack.Fiber y)) => trans!{L.Carrier} _ _ _
    (trans!{L.Carrier} _ _ _
      (congr!{W.Carrier L.Carrier} ((LeftBack.retraction leftInjective).apply) _ _ (RightPush.onGenerator rightFunction y))
      (LeftBack.generatorOutside leftInjective (rightFunction y) (noFiber y empty)))
    (sym!{L.Carrier} _ _ (trans!{L.Carrier} _ _ _
      (congr!{O.Carrier L.Carrier} ((TopPush.push topFunction).apply) _ _ (OverlapBack.generatorOutside bottomInjective y empty))
      (TopMaps.zeroPreserved (TopPush.push topFunction))));
