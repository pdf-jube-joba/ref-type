\definition left: \forall (z: Overlap) -> #apply{leftMap} (V.generator (bottomFunction z)) = L.generator (topFunction z) :=
  \fun (z: Overlap) => trans!{L.Carrier} _ _ _
    (congr!{W.Carrier L.Carrier} (#apply{(LeftBack.retraction leftInjective)}) _ _ (RightPush.onGenerator rightFunction (bottomFunction z)))
    (trans!{L.Carrier} _ _ _
      (congr!{Whole L.Carrier} (\fun (w: Whole) => #apply{(LeftBack.retraction leftInjective)} (W.generator w)) _ _
        (sym!{Whole} _ _ (#commutes{(laws square)} z)))
      (LeftBack.generatorLaw leftInjective (topFunction z)));
\definition right: \forall (z: Overlap) -> #apply{rightMap} (V.generator (bottomFunction z)) = L.generator (topFunction z) :=
  \fun (z: Overlap) => trans!{L.Carrier} _ _ _
    (congr!{O.Carrier L.Carrier} (#apply{(TopPush.push topFunction)}) _ _ (OverlapBack.generatorLaw bottomInjective z)) (TopPush.onGenerator topFunction z);
\definition law: \forall (z: Overlap) -> #apply{leftMap} (V.generator (bottomFunction z)) = #apply{rightMap} (V.generator (bottomFunction z)) :=
  \fun (z: Overlap) => trans!{L.Carrier} _ _ _ (left z) (sym!{L.Carrier} _ _ (right z));
