\definition left: \forall (z: Overlap) -> (leftMap).apply (V.generator (bottomFunction z)) = L.generator (topFunction z) :=
  \fun (z: Overlap) => trans!{L.Carrier} _ _ _
    (congr!{W.Carrier L.Carrier} ((LeftBack.retraction leftInjective).apply) _ _ (RightPush.onGenerator rightFunction (bottomFunction z)))
    (trans!{L.Carrier} _ _ _
      (congr!{Whole L.Carrier} (\fun (w: Whole) => (LeftBack.retraction leftInjective).apply (W.generator w)) _ _
        (sym!{Whole} _ _ ((laws square).commutes z)))
      (LeftBack.generatorLaw leftInjective (topFunction z)));
\definition right: \forall (z: Overlap) -> (rightMap).apply (V.generator (bottomFunction z)) = L.generator (topFunction z) :=
  \fun (z: Overlap) => trans!{L.Carrier} _ _ _
    (congr!{O.Carrier L.Carrier} ((TopPush.push topFunction).apply) _ _ (OverlapBack.generatorLaw bottomInjective z)) (TopPush.onGenerator topFunction z);
\definition law: \forall (z: Overlap) -> (leftMap).apply (V.generator (bottomFunction z)) = (rightMap).apply (V.generator (bottomFunction z)) :=
  \fun (z: Overlap) => trans!{L.Carrier} _ _ _ (left z) (sym!{L.Carrier} _ _ (right z));
