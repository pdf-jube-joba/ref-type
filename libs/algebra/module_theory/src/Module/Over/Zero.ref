\inductive Carrier: \Set := | zero: Carrier;
\definition unique: \forall (x, y: Carrier) -> x = y :=
  \induction (x: Carrier) \return \forall (y: Carrier) -> x = y \with {
    | zero: \induction (y: Carrier) \return Carrier::zero = y \with {
      | zero: \refl(Carrier::zero)
    }
  };
\definition add(x, y: Carrier): Carrier := Carrier::zero;
\definition neg(x: Carrier): Carrier := Carrier::zero;
\definition scale(a: R)(x: Carrier): Carrier := Carrier::zero;
\import std.Alg[].Monoid[] \as Monoid;
\definition moduleSpace: Space Carrier := Ring.RingModule[R, Carrier, ring] {
  zero := Carrier::zero, add := add, neg := neg, smul := scale,
  additive := Alg.CommutativeGroupLaws[Carrier, Alg.CommutativeGroupData[Carrier]::# (Alg.GroupData[Carrier]::# Carrier::zero add neg)] {
    group := Alg.GroupLaws[Carrier, Alg.GroupData[Carrier]::# Carrier::zero add neg] {
      monoid := Monoid.MonoidLaws[Carrier, Monoid.MonoidData[Carrier]::# Carrier::zero add] {
        leftIdentity := \fun (x: Carrier) => unique Carrier::zero x,
        rightIdentity := \fun (x: Carrier) => unique Carrier::zero x,
        associative := \fun (x, y, z: Carrier) => \refl(Carrier::zero),
      },
      leftInverse := \fun (x: Carrier) => \refl(Carrier::zero),
      rightInverse := \fun (x: Carrier) => \refl(Carrier::zero),
    },
    commutative := \fun (x, y: Carrier) => \refl(Carrier::zero),
  },
  scalarOne := \fun (x: Carrier) => unique Carrier::zero x,
  scalarAssoc := \fun (a, b: R)(x: Carrier) => \refl(Carrier::zero),
  scalarAdd := \fun (a, b: R)(x: Carrier) => \refl(Carrier::zero),
  vectorAdd := \fun (a: R)(x, y: Carrier) => \refl(Carrier::zero),
};
