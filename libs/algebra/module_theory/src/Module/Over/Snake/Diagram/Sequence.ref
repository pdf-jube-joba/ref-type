\use std.Logic[].Equality[].eq_reason_in;
\import \parent.\parent.\parent.Of[V := A.Carrier, space := A.space].Submodule[] \as LeftSub;
\import LeftSub.Kernel[W := A1.Carrier, target := A1.space] \as LeftKernel;
\definition leftKernel: LeftSub.Submodule := LeftKernel.kernel f;
\import LeftSub.Of[S := leftKernel] \as KL;
\import \parent.\parent.\parent.Of[V := B.Carrier, space := B.space].Submodule[] \as MiddleSub;
\import MiddleSub.Kernel[W := B1.Carrier, target := B1.space] \as MiddleKernel;
\definition middleKernel: MiddleSub.Submodule := MiddleKernel.kernel g;
\import MiddleSub.Of[S := middleKernel] \as KM;
\import \parent.\parent.\parent.Of[V := B1.Carrier, space := B1.space].Submodule[] \as MiddleTargetSub;
\import MiddleTargetSub.Image[U := B.Carrier, source := B.space] \as MiddleImage;
\definition middleImage: MiddleTargetSub.Submodule := MiddleImage.image g;
\import MiddleTargetSub.Quotient[S := middleImage] \as CM;
\import \parent.\parent.\parent.Of[V := C1.Carrier, space := C1.space].Submodule[] \as RightTargetSub;
\import RightTargetSub.Image[U := C.Carrier, source := C.space] \as RightImage;
\definition rightImage: RightTargetSub.Submodule := RightImage.image h;
\import RightTargetSub.Quotient[S := rightImage] \as CR;
\import \parent.\parent.\parent.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space] \as SourceInclusion;
\import \parent.\parent.\parent.Hom[V := A1.Carrier, W := B1.Carrier, source := A1.space, target := B1.space] \as TargetInclusion;
\import \parent.\parent.\parent.Hom[V := B1.Carrier, W := C1.Carrier, source := B1.space, target := C1.space] \as TargetProjection;
\import \parent.\parent.\parent.Hom[V := C.Carrier, W := C1.Carrier, source := C.space, target := C1.space] \as RightMaps;
\import \parent.\parent.\parent.Laws[V := C1.Carrier, space := C1.space] \as Right1;
\import algebra.Group[].Of[Carrier := C1.Carrier, group := Right1.additive] \as RightGroup1;
\import \parent.\parent.\parent.Hom[V := KL.Carrier, W := KM.Carrier, source := KL.moduleSpace, target := KM.moduleSpace] \as KernelInclusion;
\definition inclusionClosed: Commutative -> \forall (x: KL.Carrier) -> g.apply (s.inclusion.apply x) = Middle1.zero :=
  \fun (diagram: Commutative)(x: KL.Carrier) => eq_reason_in!{B1.Carrier _
    "=" _ "by" { diagram.left x }
    "=" _ "by" { congr!{A1.Carrier B1.Carrier} (t.inclusion.apply) _ _ (\bysub(A.Carrier, leftKernel.carrier, x)) }
    "=" _ "by" { TargetInclusion.zeroPreserved t.inclusion }
  };
\definition kernelInclusion[diagram: Commutative]: KernelInclusion.Map := KernelInclusion.Map {
  apply := \fun (x: KL.Carrier) => \into[B.Carrier](s.inclusion.apply x, middleKernel.carrier) \by { inclusionClosed diagram x },
  addition := \fun (x, y: KL.Carrier) => s.inclusion.addition x y,
  scalar := \fun (a: R)(x: KL.Carrier) => s.inclusion.scalar a x,
};
\import \parent.\parent.\parent.Hom[V := KM.Carrier, W := KernelCarrier, source := KM.moduleSpace, target := kernelSpace] \as KernelProjection;
\definition projectionClosed: Commutative -> \forall (x: KM.Carrier) -> h.apply (s.projection.apply x) = Right1.zero :=
  \fun (diagram: Commutative)(x: KM.Carrier) => eq_reason_in!{C1.Carrier _
    "=" _ "by" { sym!{C1.Carrier} _ _ (diagram.right x) }
    "=" _ "by" { congr!{B1.Carrier C1.Carrier} (t.projection.apply) _ _ (\bysub(B.Carrier, middleKernel.carrier, x)) }
    "=" _ "by" { TargetProjection.zeroPreserved t.projection }
  };
\definition kernelProjection[diagram: Commutative]: KernelProjection.Map := KernelProjection.Map {
  apply := \fun (x: KM.Carrier) => \into[C.Carrier](s.projection.apply x, kernel.carrier) \by { projectionClosed diagram x },
  addition := \fun (x, y: KM.Carrier) => s.projection.addition x y,
  scalar := \fun (a: R)(x: KM.Carrier) => s.projection.scalar a x,
};
\import \parent.\parent.\parent.Hom[V := B1.Carrier, W := CM.Carrier, source := B1.space, target := CM.moduleSpace].Composition[U := A1.Carrier, domain := A1.space] \as IncludeClass;
\definition inclusionClass: MapBetween A1 (Bundle { Carrier := CM.Carrier, space := CM.moduleSpace }) := IncludeClass.compose CM.projection t.inclusion;
\import Cokernel.To[W := CM.Carrier, target := CM.moduleSpace] \as IncludeDescent;
\definition inclusionVanishes: Commutative -> IncludeDescent.Vanishes inclusionClass := \block {
  \fun (diagram: Commutative)(x: A1.Carrier)(member: _) \then
  \takefrom a: \Cast[A.Carrier] ({ a: A.Carrier \where f.apply a = x }) \by member \then
  \let equal: t.inclusion.apply x = g.apply (s.inclusion.apply a) := trans!{B1.Carrier} _ _ _
    (congr!{A1.Carrier B1.Carrier} (t.inclusion.apply) _ _ (sym!{A1.Carrier} _ _ (\bysub(A.Carrier, { a: A.Carrier \where f.apply a = x }, a))))
    (sym!{B1.Carrier} _ _ (diagram.left a)) \then
  \return CM.classZero (t.inclusion.apply x)
    (Logic.existsIntro[B.Carrier, { b: B.Carrier \where g.apply b = t.inclusion.apply x }] (s.inclusion.apply a)
      (sym!{B1.Carrier} _ _ equal))
};
\import \parent.\parent.\parent.Hom[V := CokernelCarrier, W := CM.Carrier, source := cokernelSpace, target := CM.moduleSpace] \as CokernelInclusion;
\definition cokernelInclusion[diagram: Commutative]: CokernelInclusion.Map := IncludeDescent.descend inclusionClass (inclusionVanishes diagram);
\import \parent.\parent.\parent.Hom[V := C1.Carrier, W := CR.Carrier, source := C1.space, target := CR.moduleSpace].Composition[U := B1.Carrier, domain := B1.space] \as ProjectClass;
\definition projectionClass: MapBetween B1 (Bundle { Carrier := CR.Carrier, space := CR.moduleSpace }) := ProjectClass.compose CR.projection t.projection;
\import CM.To[W := CR.Carrier, target := CR.moduleSpace] \as ProjectDescent;
\definition projectionVanishes: Commutative -> ProjectDescent.Vanishes projectionClass := \block {
  \fun (diagram: Commutative)(x: B1.Carrier)(member: _) \then
  \takefrom b: \Cast[B.Carrier] ({ b: B.Carrier \where g.apply b = x }) \by member \then
  \let equal: h.apply (s.projection.apply b) = t.projection.apply x := trans!{C1.Carrier} _ _ _
    (sym!{C1.Carrier} _ _ (diagram.right b))
    (congr!{B1.Carrier C1.Carrier} (t.projection.apply) _ _ (\bysub(B.Carrier, { b: B.Carrier \where g.apply b = x }, b))) \then
  \return CR.classZero (t.projection.apply x)
    (Logic.existsIntro[C.Carrier, { c: C.Carrier \where h.apply c = t.projection.apply x }] (s.projection.apply b)
      equal)
};
\import \parent.\parent.\parent.Hom[V := CM.Carrier, W := CR.Carrier, source := CM.moduleSpace, target := CR.moduleSpace] \as CokernelProjection;
\definition cokernelProjection[diagram: Commutative]: CokernelProjection.Map := ProjectDescent.descend projectionClass (projectionVanishes diagram);
\definition leftInjective: \forall (diagram: Commutative)(x, y: KL.Carrier) ->
  (kernelInclusion diagram).apply x = (kernelInclusion diagram).apply y -> x = y :=
  \fun (diagram: Commutative)(x, y: KL.Carrier)(equal: _) => s.injective x y equal;
\definition exactKernelMiddle: \forall (diagram: Commutative)(x: KM.Carrier) ->
  (kernelProjection diagram).apply x = kernelSpace.zero -> \exists ( a: KL.Carrier \where (kernelInclusion diagram).apply a = x ) := \block {
  \fun (diagram: Commutative)(x: KM.Carrier)(closed: _) \then
  \takefrom a: \Cast[A.Carrier] ({ a: A.Carrier \where s.inclusion.apply a = x }) \by s.kernelImage x closed \then
  \let represented: s.inclusion.apply a = x := \bysub(A.Carrier, { a: A.Carrier \where s.inclusion.apply a = x }, a) \then
  \let killed: f.apply a = Left1.zero := t.injective _ _
    (eq_reason_in!{B1.Carrier _
      "=" _ "by" { sym!{B1.Carrier} _ _ (diagram.left a) }
      "=" _ "by" { congr!{B.Carrier B1.Carrier} (g.apply) _ _ represented }
      "=" _ "by" { \bysub(B.Carrier, middleKernel.carrier, x) }
      "=" _ "by" { sym!{B1.Carrier} _ _ (TargetInclusion.zeroPreserved t.inclusion) }
    }) \then
  \let preimage: KL.Carrier := \into[A.Carrier](a, leftKernel.carrier) \by { killed } \then
  \return Logic.existsIntro[KL.Carrier, { a: KL.Carrier \where (kernelInclusion diagram).apply a = x }] preimage
    represented
};
\definition kernelCompositeZero: \forall (diagram: Commutative)(a: KL.Carrier) ->
  (kernelProjection diagram).apply ((kernelInclusion diagram).apply a) = kernelSpace.zero :=
  \fun (diagram: Commutative)(a: KL.Carrier) => s.zero a;
\definition connectingCompositeZero: \forall (diagram: Commutative)(b: KM.Carrier) ->
  delta diagram ((kernelProjection diagram).apply b) = cokernelSpace.zero :=
  \fun (diagram: Commutative)(b: KM.Carrier) => onLift diagram ((kernelProjection diagram).apply b) b Left1.zero
    (\refl(s.projection.apply b))
    (trans!{B1.Carrier} _ _ _ (TargetInclusion.zeroPreserved t.inclusion) (sym!{B1.Carrier} _ _ (\bysub(B.Carrier, middleKernel.carrier, b))));
\definition exactKernelRight: \forall (diagram: Commutative)(x: KernelCarrier) -> delta diagram x = cokernelSpace.zero ->
  \exists ( b: KM.Carrier \where (kernelProjection diagram).apply b = x ) := \block {
  \fun (diagram: Commutative)(x: KernelCarrier)(closed: _) \then
  \takefrom w: \Cast[Witness] ({ w: Witness \where WitnessLaws[x, delta diagram x, w] }) \by \bysub(CokernelCarrier, Values x, delta diagram x) \then
  \let laws: WitnessLaws[x, delta diagram x, w] := \bysub(Witness, { w: Witness \where WitnessLaws[x, delta diagram x, w] }, w) \then
  \takefrom a: \Cast[A.Carrier] ({ a: A.Carrier \where f.apply a = w.lower })
    \by Cokernel.zeroClassMember (w.lower) (trans!{CokernelCarrier} _ _ _ (laws.classValue) closed) \then
  \let represented: f.apply a = w.lower := \bysub(A.Carrier, { a: A.Carrier \where f.apply a = w.lower }, a) \then
  \let killed: g.apply (MiddleGroup.difference (w.lift) (s.inclusion.apply a)) = Middle1.zero := eq_reason_in!{B1.Carrier _
    "=" _ "by" { MiddleMaps.differencePreserved g (w.lift) (s.inclusion.apply a) }
    "=" _ "by" { congr!{B1.Carrier B1.Carrier B1.Carrier} MiddleGroup1.difference _ _ _ _
      (sym!{B1.Carrier} _ _ (laws.differential))
      (trans!{B1.Carrier} _ _ _ (diagram.left a) (congr!{A1.Carrier B1.Carrier} (t.inclusion.apply) _ _ represented)) }
    "=" _ "by" { MiddleGroup1.inverseRight (t.inclusion.apply (w.lower)) }
  } \then
  \let b: KM.Carrier := \into[B.Carrier](MiddleGroup.difference (w.lift) (s.inclusion.apply a), middleKernel.carrier) \by { killed } \then
  \return Logic.existsIntro[KM.Carrier, { b: KM.Carrier \where (kernelProjection diagram).apply b = x }] b
    (eq_reason_in!{C.Carrier _
      "=" _ "by" { Projection.differencePreserved s.projection (w.lift) (s.inclusion.apply a) }
      "=" _ "by" { congr!{C.Carrier C.Carrier C.Carrier} RightGroup.difference _ _ _ _ (laws.lifted) (s.zero a) }
      "=" _ "by" { congr!{C.Carrier C.Carrier} (Right.add x) _ _ RightGroup.negZero }
      "=" _ "by" { RightGroup.zeroRight x }
    })
};
\definition exactCokernelLeft: \forall (diagram: Commutative)(q: CokernelCarrier) ->
  (cokernelInclusion diagram).apply q = CM.moduleSpace.zero -> \exists ( x: KernelCarrier \where delta diagram x = q ) :=
  \fun (diagram: Commutative) => Cokernel.induction
    (\fun (q: CokernelCarrier) => (cokernelInclusion diagram).apply q = CM.moduleSpace.zero -> \exists ( x: KernelCarrier \where delta diagram x = q ))
    (\block {
      \fun (a: A1.Carrier)(closed: _) \then
      \takefrom b: \Cast[B.Carrier] ({ b: B.Carrier \where g.apply b = t.inclusion.apply a })
        \by CM.zeroClassMember (t.inclusion.apply a)
          (trans!{CM.Carrier} _ _ _ (sym!{CM.Carrier} _ _ (IncludeDescent.onClass inclusionClass (inclusionVanishes diagram) a)) closed) \then
      \let differential: t.inclusion.apply a = g.apply b := sym!{B1.Carrier} _ _
        (\bysub(B.Carrier, { b: B.Carrier \where g.apply b = t.inclusion.apply a }, b)) \then
      \let killed: h.apply (s.projection.apply b) = Right1.zero := eq_reason_in!{C1.Carrier _
        "=" _ "by" { sym!{C1.Carrier} _ _ (diagram.right b) }
        "=" _ "by" { congr!{B1.Carrier C1.Carrier} (t.projection.apply) _ _ (sym!{B1.Carrier} _ _ differential) }
        "=" _ "by" { t.zero a }
      } \then
      \let x: KernelCarrier := \into[C.Carrier](s.projection.apply b, kernel.carrier) \by { killed } \then
      \return Logic.existsIntro[KernelCarrier, { x: KernelCarrier \where delta diagram x = Cokernel.class a }] x
        (onLift diagram x b a (\refl(s.projection.apply b)) differential)
    });
\definition cokernelConnectingZero: \forall (diagram: Commutative)(x: KernelCarrier) ->
  (cokernelInclusion diagram).apply (delta diagram x) = CM.moduleSpace.zero := \block {
  \fun (diagram: Commutative)(x: KernelCarrier) \then
  \takefrom w: \Cast[Witness] ({ w: Witness \where WitnessLaws[x, delta diagram x, w] }) \by \bysub(CokernelCarrier, Values x, delta diagram x) \then
  \let laws: WitnessLaws[x, delta diagram x, w] := \bysub(Witness, { w: Witness \where WitnessLaws[x, delta diagram x, w] }, w) \then
  \return eq_reason_in!{CM.Carrier _
    "=" _ "by" { congr!{CokernelCarrier CM.Carrier} ((cokernelInclusion diagram).apply) _ _ (sym!{CokernelCarrier} _ _ (laws.classValue)) }
    "=" _ "by" { IncludeDescent.onClass inclusionClass (inclusionVanishes diagram) (w.lower) }
    "=" _ "by" { CM.classZero (t.inclusion.apply (w.lower))
        (Logic.existsIntro[B.Carrier, { b: B.Carrier \where g.apply b = t.inclusion.apply (w.lower) }] (w.lift)
          (sym!{B1.Carrier} _ _ (laws.differential))) }
  }
};
\definition cokernelCompositeZero: \forall (diagram: Commutative)(q: CokernelCarrier) ->
  (cokernelProjection diagram).apply ((cokernelInclusion diagram).apply q) = CR.moduleSpace.zero :=
  \fun (diagram: Commutative) => Cokernel.induction (\fun (q: CokernelCarrier) =>
    (cokernelProjection diagram).apply ((cokernelInclusion diagram).apply q) = CR.moduleSpace.zero)
    (\fun (a: A1.Carrier) => eq_reason_in!{CR.Carrier _
      "=" _ "by" { congr!{CM.Carrier CR.Carrier} ((cokernelProjection diagram).apply) _ _ (IncludeDescent.onClass inclusionClass (inclusionVanishes diagram) a) }
      "=" _ "by" { ProjectDescent.onClass projectionClass (projectionVanishes diagram) (t.inclusion.apply a) }
      "=" _ "by" { congr!{C1.Carrier CR.Carrier} CR.class _ _ (t.zero a) }
    });
\definition exactCokernelMiddle: \forall (diagram: Commutative)(q: CM.Carrier) ->
  (cokernelProjection diagram).apply q = CR.moduleSpace.zero -> \exists ( a: CokernelCarrier \where (cokernelInclusion diagram).apply a = q ) :=
  \fun (diagram: Commutative) => CM.induction (\fun (q: CM.Carrier) =>
    (cokernelProjection diagram).apply q = CR.moduleSpace.zero -> \exists ( a: CokernelCarrier \where (cokernelInclusion diagram).apply a = q ))
    (\block {
      \fun (b: B1.Carrier)(closed: _) \then
      \takefrom c: \Cast[C.Carrier] ({ c: C.Carrier \where h.apply c = t.projection.apply b }) \by
        CR.zeroClassMember (t.projection.apply b)
          (trans!{CR.Carrier} _ _ _ (sym!{CR.Carrier} _ _ (ProjectDescent.onClass projectionClass (projectionVanishes diagram) b)) closed) \then
      \takefrom u: \Cast[B.Carrier] ({ u: B.Carrier \where s.projection.apply u = c }) \by s.onto c \then
      \let equal: t.projection.apply (g.apply u) = t.projection.apply b := eq_reason_in!{C1.Carrier _
        "=" _ "by" { diagram.right u }
        "=" _ "by" { congr!{C.Carrier C1.Carrier} (h.apply) _ _ (\bysub(B.Carrier, { u: B.Carrier \where s.projection.apply u = c }, u)) }
        "=" _ "by" { \bysub(C.Carrier, { c: C.Carrier \where h.apply c = t.projection.apply b }, c) }
      } \then
      \let killed: t.projection.apply (MiddleGroup1.difference b (g.apply u)) = Right1.zero := eq_reason_in!{C1.Carrier _
        "=" _ "by" { TargetProjection.differencePreserved t.projection b (g.apply u) }
        "=" _ "by" { congr!{C1.Carrier C1.Carrier} (RightGroup1.difference (t.projection.apply b)) _ _ equal }
        "=" _ "by" { RightGroup1.inverseRight (t.projection.apply b) }
      } \then
      \takefrom a: \Cast[A1.Carrier] ({ a: A1.Carrier \where t.inclusion.apply a = MiddleGroup1.difference b (g.apply u) })
        \by t.kernelImage (MiddleGroup1.difference b (g.apply u)) killed \then
      \let represented: t.inclusion.apply a = MiddleGroup1.difference b (g.apply u) :=
        \bysub(A1.Carrier, { a: A1.Carrier \where t.inclusion.apply a = MiddleGroup1.difference b (g.apply u) }, a) \then
      \let difference: MiddleGroup1.difference (t.inclusion.apply a) b = Middle1.neg (g.apply u) := eq_reason!{
        {MiddleGroup1.difference (t.inclusion.apply a) b}
        "=" {Middle1.add (MiddleGroup1.difference b (g.apply u)) (Middle1.neg b)} "by" {
          congr!{B1.Carrier B1.Carrier} (\fun (x: B1.Carrier) => MiddleGroup1.difference x b) _ _ represented
        }
        "=" {Middle1.add (Middle1.add (Middle1.neg (g.apply u)) b) (Middle1.neg b)} "by" {
          congr!{B1.Carrier B1.Carrier} (\fun (x: B1.Carrier) => Middle1.add x (Middle1.neg b)) _ _ (MiddleGroup1.comm b (Middle1.neg (g.apply u)))
        }
        "=" {Middle1.add (Middle1.neg (g.apply u)) (Middle1.add b (Middle1.neg b))} "by" {MiddleGroup1.assoc (Middle1.neg (g.apply u)) b (Middle1.neg b)}
        "=" {Middle1.add (Middle1.neg (g.apply u)) Middle1.zero} "by" {congr!{B1.Carrier B1.Carrier} (Middle1.add (Middle1.neg (g.apply u))) _ _ (MiddleGroup1.inverseRight b)}
        "=" {Middle1.neg (g.apply u)} "by" {MiddleGroup1.zeroRight (Middle1.neg (g.apply u))}
      } \then
      \return Logic.existsIntro[CokernelCarrier, { a: CokernelCarrier \where (cokernelInclusion diagram).apply a = CM.class b }] (Cokernel.class a)
        (trans!{CM.Carrier} _ _ _ (IncludeDescent.onClass inclusionClass (inclusionVanishes diagram) a)
          (CM.classRelated (t.inclusion.apply a) b
            (Logic.existsIntro[B.Carrier, { v: B.Carrier \where g.apply v = MiddleGroup1.difference (t.inclusion.apply a) b }] (Middle.neg u)
              (trans!{B1.Carrier} _ _ _ (MiddleMaps.negativePreserved g u) (sym!{B1.Carrier} _ _ difference)))))
    });
\definition rightOnto: \forall (diagram: Commutative)(q: CR.Carrier) -> \exists ( b: CM.Carrier \where (cokernelProjection diagram).apply b = q ) :=
  \fun (diagram: Commutative) => CR.induction (\fun (q: CR.Carrier) => \exists ( b: CM.Carrier \where (cokernelProjection diagram).apply b = q ))
    (\block {
      \fun (c: C1.Carrier) \then
      \takefrom b: \Cast[B1.Carrier] ({ b: B1.Carrier \where t.projection.apply b = c }) \by t.onto c \then
      \return Logic.existsIntro[CM.Carrier, { b: CM.Carrier \where (cokernelProjection diagram).apply b = CR.class c }] (CM.class b)
        (trans!{CR.Carrier} _ _ _ (ProjectDescent.onClass projectionClass (projectionVanishes diagram) b)
          (congr!{C1.Carrier CR.Carrier} CR.class _ _ (\bysub(B1.Carrier, { b: B1.Carrier \where t.projection.apply b = c }, b))))
    });
