\import \parent.\parent.ShortExactComparison[A := A, B := B, C := C, A1 := A1, B1 := B1, C1 := C1].Diagram[s := s, t := t, a := f, b := g, c := h] \as Square;
\definition Commutative: \Prop := Square.Commutative;
\import \parent.\parent.Of[V := C.Carrier, space := C.space].Submodule[] \as SourceSubmodules;
\import SourceSubmodules.Kernel[W := C1.Carrier, target := C1.space] \as Kernels;
\definition kernel: SourceSubmodules.Submodule := Kernels.kernel h;
\import SourceSubmodules.Of[S := kernel] \as Kernel;
\definition KernelCarrier: \Set := Kernel.Carrier;
\definition kernelSpace: Space KernelCarrier := Kernel.moduleSpace;
\import \parent.\parent.Of[V := A1.Carrier, space := A1.space].Submodule[] \as TargetSubmodules;
\import TargetSubmodules.Image[U := A.Carrier, source := A.space] \as Images;
\definition image: TargetSubmodules.Submodule := Images.image f;
\import TargetSubmodules.Quotient[S := image] \as Cokernel;
\definition CokernelCarrier: \Set := Cokernel.Carrier;
\definition cokernelSpace: Space CokernelCarrier := Cokernel.moduleSpace;
\structure Witness: \Set := { lift: B.Carrier, lower: A1.Carrier };
\structure WitnessLaws[x: KernelCarrier, q: CokernelCarrier, w: Witness]: \Prop := {
  lifted: s.projection.apply w.lift = x,
  differential: t.inclusion.apply w.lower = g.apply w.lift,
  classValue: Cokernel.class w.lower = q,
};
\definition Values[x: KernelCarrier]: \Pow CokernelCarrier := { q: CokernelCarrier \where \exists ( w: Witness \where WitnessLaws[x, q, w] ) };
\definition Value[x: KernelCarrier]: \Set := \Cast[CokernelCarrier] (Values x);
\definition witness[x: KernelCarrier][lift: B.Carrier][lower: A1.Carrier]
  [lifted: s.projection.apply lift = x][differential: t.inclusion.apply lower = g.apply lift]: Value x :=
  \into[CokernelCarrier](Cokernel.class lower, Values x) \by {
    Logic.existsIntro[Witness, { w: Witness \where WitnessLaws[x, Cokernel.class lower, w] }] (Witness { lift := lift, lower := lower })
    (WitnessLaws[x, Cokernel.class lower, Witness { lift := lift, lower := lower }] {
        lifted := lifted, differential := differential, classValue := \refl(Cokernel.class lower),
      })
  };
\definition existence: Commutative -> \forall (x: KernelCarrier) -> \exists Value x := \block {
  \fun (diagram: Commutative)(x: KernelCarrier) \then
  \takefrom lift: \Cast[B.Carrier] ({ b: B.Carrier \where s.projection.apply b = x }) \by s.onto x \then
  \let lifted: s.projection.apply lift = x := \bysub(B.Carrier, { b: B.Carrier \where s.projection.apply b = x }, lift) \then
  \let closed: t.projection.apply (g.apply lift) = C1.space.zero := trans!{C1.Carrier} _ _ _ (diagram.right lift)
    (trans!{C1.Carrier} _ _ _ (congr!{C.Carrier C1.Carrier} (h.apply) _ _ lifted) (\bysub(C.Carrier, kernel.carrier, x))) \then
  \takefrom lower: \Cast[A1.Carrier] ({ a: A1.Carrier \where t.inclusion.apply a = g.apply lift }) \by t.kernelImage (g.apply lift) closed \then
  \return \exact(witness x lift lower lifted (\bysub(A1.Carrier, { a: A1.Carrier \where t.inclusion.apply a = g.apply lift }, lower)), Value x)
};
\import \parent.\parent.Laws[V := B.Carrier, space := B.space] \as Middle;
\import \parent.\parent.Laws[V := C.Carrier, space := C.space] \as Right;
\import \parent.\parent.Laws[V := A1.Carrier, space := A1.space] \as Left1;
\import \parent.\parent.Laws[V := B1.Carrier, space := B1.space] \as Middle1;
\import algebra.Group[].Of[Carrier := B.Carrier, group := Middle.additive] \as MiddleGroup;
\import algebra.Group[].Of[Carrier := C.Carrier, group := Right.additive] \as RightGroup;
\import algebra.Group[].Of[Carrier := A1.Carrier, group := Left1.additive] \as LeftGroup1;
\import algebra.Group[].Of[Carrier := B1.Carrier, group := Middle1.additive] \as MiddleGroup1;
\import \parent.\parent.Hom[V := B.Carrier, W := C.Carrier, source := B.space, target := C.space] \as Projection;
\import \parent.\parent.Hom[V := A1.Carrier, W := B1.Carrier, source := A1.space, target := B1.space] \as Inclusion1;
\import \parent.\parent.Hom[V := B.Carrier, W := B1.Carrier, source := B.space, target := B1.space] \as MiddleMaps;
\definition sameClass: Commutative -> \forall (x: KernelCarrier)(v, w: Witness) ->
  s.projection.apply v.lift = x -> s.projection.apply w.lift = x ->
  t.inclusion.apply v.lower = g.apply v.lift -> t.inclusion.apply w.lower = g.apply w.lift ->
  Cokernel.class v.lower = Cokernel.class w.lower := \block {
  \fun (diagram: Commutative)(x: KernelCarrier)(v, w: Witness)(vLifted: _)(wLifted: _)(vDifferential: _)(wDifferential: _) \then
  \let closed: s.projection.apply (MiddleGroup.difference v.lift w.lift) = Right.zero :=
    trans!{C.Carrier} _ _ _ (Projection.differencePreserved s.projection v.lift w.lift)
      (trans!{C.Carrier} _ _ _ (congr2!{C.Carrier C.Carrier C.Carrier} RightGroup.difference _ _ _ _ vLifted wLifted) (RightGroup.inverseRight x)) \then
  \takefrom a: \Cast[A.Carrier] ({ a: A.Carrier \where s.inclusion.apply a = MiddleGroup.difference v.lift w.lift })
    \by s.kernelImage (MiddleGroup.difference v.lift w.lift) closed \then
  \let representation: s.inclusion.apply a = MiddleGroup.difference v.lift w.lift :=
    \bysub(A.Carrier, { a: A.Carrier \where s.inclusion.apply a = MiddleGroup.difference v.lift w.lift }, a) \then
  \let difference: LeftGroup1.difference v.lower w.lower = f.apply a := t.injective _ _
    (trans!{B1.Carrier} _ _ _ (Inclusion1.differencePreserved t.inclusion v.lower w.lower)
      (trans!{B1.Carrier} _ _ _ (congr2!{B1.Carrier B1.Carrier B1.Carrier} MiddleGroup1.difference _ _ _ _ vDifferential wDifferential)
        (trans!{B1.Carrier} _ _ _ (sym!{B1.Carrier} _ _ (MiddleMaps.differencePreserved g v.lift w.lift))
          (trans!{B1.Carrier} _ _ _ (congr!{B.Carrier B1.Carrier} (g.apply) _ _ (sym!{B.Carrier} _ _ representation)) (diagram.left a))))) \then
  \return Cokernel.classRelated v.lower w.lower
    (Logic.existsIntro[A.Carrier, { a: A.Carrier \where f.apply a = LeftGroup1.difference v.lower w.lower }] a
      (sym!{A1.Carrier} _ _ difference))
};
\definition uniqueness: Commutative -> \forall (x: KernelCarrier)(v, w: Value x) -> v = w := \block {
  \fun (diagram: Commutative)(x: KernelCarrier)(v, w: Value x) \then
  \takefrom r: \Cast[Witness] ({ r: Witness \where WitnessLaws[x, v, r] }) \by \bysub(CokernelCarrier, Values x, v) \then
  \takefrom u: \Cast[Witness] ({ u: Witness \where WitnessLaws[x, w, u] }) \by \bysub(CokernelCarrier, Values x, w) \then
  \let rLaws: WitnessLaws[x, v, r] := \bysub(Witness, { r: Witness \where WitnessLaws[x, v, r] }, r) \then
  \let uLaws: WitnessLaws[x, w, u] := \bysub(Witness, { u: Witness \where WitnessLaws[x, w, u] }, u) \then
  \return trans!{CokernelCarrier} _ _ _ (sym!{CokernelCarrier} _ _ (rLaws.classValue))
    (trans!{CokernelCarrier} _ _ _ (sameClass diagram x r u (rLaws.lifted) (uLaws.lifted) (rLaws.differential) (uLaws.differential)) (uLaws.classValue))
};
\definition delta[diagram: Commutative][x: KernelCarrier]: Value x := \choice Value x \by { existence: existence diagram x, uniqueness: uniqueness diagram x };
\definition onLift: \forall (diagram: Commutative)(x: KernelCarrier)(lift: B.Carrier)(lower: A1.Carrier) ->
  s.projection.apply lift = x -> t.inclusion.apply lower = g.apply lift -> delta diagram x = Cokernel.class lower :=
  \fun (diagram: Commutative)(x: KernelCarrier)(lift: B.Carrier)(lower: A1.Carrier)(lifted: _)(differential: _) => sym!{CokernelCarrier} _ _
    (\choiceeq witness x lift lower lifted differential \of Value x \by { existence: existence diagram x, uniqueness: uniqueness diagram x });
\definition addition: \forall (diagram: Commutative)(x, y: KernelCarrier) ->
  delta diagram (kernelSpace.add x y) = cokernelSpace.add (delta diagram x) (delta diagram y) := \block {
  \fun (diagram: Commutative)(x, y: KernelCarrier) \then
  \takefrom r: \Cast[Witness] ({ r: Witness \where WitnessLaws[x, delta diagram x, r] }) \by \bysub(CokernelCarrier, Values x, delta diagram x) \then
  \takefrom u: \Cast[Witness] ({ u: Witness \where WitnessLaws[y, delta diagram y, u] }) \by \bysub(CokernelCarrier, Values y, delta diagram y) \then
  \let rLaws: WitnessLaws[x, delta diagram x, r] := \bysub(Witness, { r: Witness \where WitnessLaws[x, delta diagram x, r] }, r) \then
  \let uLaws: WitnessLaws[y, delta diagram y, u] := \bysub(Witness, { u: Witness \where WitnessLaws[y, delta diagram y, u] }, u) \then
  \let lifted: s.projection.apply (Middle.add r.lift u.lift) = kernelSpace.add x y := trans!{C.Carrier} _ _ _ (s.projection.addition r.lift u.lift)
    (congr2!{C.Carrier C.Carrier C.Carrier} Right.add _ _ _ _ (rLaws.lifted) (uLaws.lifted)) \then
  \let differential: t.inclusion.apply (Left1.add r.lower u.lower) = g.apply (Middle.add r.lift u.lift) := trans!{B1.Carrier} _ _ _ (t.inclusion.addition r.lower u.lower)
    (trans!{B1.Carrier} _ _ _ (congr2!{B1.Carrier B1.Carrier B1.Carrier} Middle1.add _ _ _ _ (rLaws.differential) (uLaws.differential))
      (sym!{B1.Carrier} _ _ (g.addition r.lift u.lift))) \then
  \return trans!{CokernelCarrier} _ _ _ (onLift diagram (kernelSpace.add x y) (Middle.add r.lift u.lift) (Left1.add r.lower u.lower) lifted differential)
    (trans!{CokernelCarrier} _ _ _ (Cokernel.projection.addition r.lower u.lower)
      (congr2!{CokernelCarrier CokernelCarrier CokernelCarrier} (cokernelSpace.add) _ _ _ _ (rLaws.classValue) (uLaws.classValue)))
};
\definition scalar: \forall (diagram: Commutative)(a: R)(x: KernelCarrier) ->
  delta diagram (kernelSpace.smul a x) = cokernelSpace.smul a (delta diagram x) := \block {
  \fun (diagram: Commutative)(a: R)(x: KernelCarrier) \then
  \takefrom r: \Cast[Witness] ({ r: Witness \where WitnessLaws[x, delta diagram x, r] }) \by \bysub(CokernelCarrier, Values x, delta diagram x) \then
  \let rLaws: WitnessLaws[x, delta diagram x, r] := \bysub(Witness, { r: Witness \where WitnessLaws[x, delta diagram x, r] }, r) \then
  \let lifted: s.projection.apply (Middle.scale a r.lift) = kernelSpace.smul a x := trans!{C.Carrier} _ _ _ (s.projection.scalar a r.lift)
    (congr!{C.Carrier C.Carrier} (Right.scale a) _ _ (rLaws.lifted)) \then
  \let differential: t.inclusion.apply (Left1.scale a r.lower) = g.apply (Middle.scale a r.lift) := trans!{B1.Carrier} _ _ _ (t.inclusion.scalar a r.lower)
    (trans!{B1.Carrier} _ _ _ (congr!{B1.Carrier B1.Carrier} (Middle1.scale a) _ _ (rLaws.differential)) (sym!{B1.Carrier} _ _ (g.scalar a r.lift))) \then
  \return trans!{CokernelCarrier} _ _ _ (onLift diagram (kernelSpace.smul a x) (Middle.scale a r.lift) (Left1.scale a r.lower) lifted differential)
    (trans!{CokernelCarrier} _ _ _ (Cokernel.projection.scalar a r.lower) (congr!{CokernelCarrier CokernelCarrier} (cokernelSpace.smul a) _ _ (rLaws.classValue)))
};
\import \parent.\parent.Hom[V := KernelCarrier, W := CokernelCarrier, source := kernelSpace, target := cokernelSpace] \as Connecting;
\definition connecting[diagram: Commutative]: Connecting.Map := Connecting.Map { apply := delta diagram, addition := addition diagram, scalar := scalar diagram };
\module Sequence;
