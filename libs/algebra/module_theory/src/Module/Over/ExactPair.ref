\structure Data: \Set := { first: MapBetween A B, last: MapBetween B C };
\structure Laws[data: Data]: \Prop := {
  zero: \forall (x: A.Carrier) -> data.last.apply (data.first.apply x) = C.space.zero,
  kernelImage: \forall (x: B.Carrier) -> data.last.apply x = C.space.zero -> \exists ( a: A.Carrier \where data.first.apply a = x ),
};
\definition Sequence: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module Transport(A1, B1, C1: Bundle, sequence: Sequence,
  f: MapBetween A1 B1, g: MapBetween B1 C1,
  a: \parent.\parent.Isomorphism[V := A.Carrier, W := A1.Carrier, source := A.space, target := A1.space].Isomorphism,
  b: \parent.\parent.Isomorphism[V := B.Carrier, W := B1.Carrier, source := B.space, target := B1.space].Isomorphism,
  c: \parent.\parent.Isomorphism[V := C.Carrier, W := C1.Carrier, source := C.space, target := C1.space].Isomorphism);
