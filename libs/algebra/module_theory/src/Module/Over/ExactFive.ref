\structure Data: \Set := {
  first: MapBetween A B,
  second: MapBetween B C,
  third: MapBetween C D,
  last: MapBetween D E,
};
\structure Laws[data: Data]: \Prop := {
  zeroB: \forall (x: A.Carrier) -> data.second.apply (data.first.apply x) = C.space.zero,
  zeroC: \forall (x: B.Carrier) -> data.third.apply (data.second.apply x) = D.space.zero,
  zeroD: \forall (x: C.Carrier) -> data.last.apply (data.third.apply x) = E.space.zero,
  kernelB: \forall (x: B.Carrier) -> data.second.apply x = C.space.zero -> \exists ( a: A.Carrier \where data.first.apply a = x ),
  kernelC: \forall (x: C.Carrier) -> data.third.apply x = D.space.zero -> \exists ( b: B.Carrier \where data.second.apply b = x ),
  kernelD: \forall (x: D.Carrier) -> data.last.apply x = E.space.zero -> \exists ( c: C.Carrier \where data.third.apply c = x ),
};
\definition Sequence: \Set := \Cast[Data] ({ data: Data \where Laws[data] });

\module Vanishing(sequence: Sequence);
