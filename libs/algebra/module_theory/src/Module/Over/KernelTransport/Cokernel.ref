\import \parent.\parent.Of[V := W, space := wSpace].Submodule[] \as SourceImagesSub;
\import \parent.\parent.Of[V := Y, space := ySpace].Submodule[] \as TargetImagesSub;
\import SourceImagesSub.Image[U := V, source := vSpace] \as SourceImages;
\import TargetImagesSub.Image[U := X, source := xSpace] \as TargetImages;
\definition sourceImage: SourceImagesSub.Submodule := SourceImages.image f;
\definition targetImage: TargetImagesSub.Submodule := TargetImages.image g;
\definition SourceBundle: Bundle := Bundle { Carrier := W, space := wSpace };
\definition TargetBundle: Bundle := Bundle { Carrier := Y, space := ySpace };
\import \parent.\parent.QuotientMapping[A := SourceBundle, B := TargetBundle].On[S := sourceImage, T := targetImage, f := codomainIso.forward] \as Induced;
\definition compatible: Commutes -> Induced.Compatible :=
  \fun (commutes: Commutes)(w: W)(member: _) =>
    SourceImages.eliminate f w (TargetImagesSub.Member targetImage (codomainIso.forward.apply w))
      (\fun (v: V)(equal: f.apply v = w) =>
        TargetImages.introduce g (codomainIso.forward.apply w) (domainIso.forward.apply v)
          (trans!{Y} (g.apply (domainIso.forward.apply v)) (codomainIso.forward.apply (f.apply v)) (codomainIso.forward.apply w)
            (commutes v) (congr!{W Y} (codomainIso.forward.apply) (f.apply v) w equal))) member;
\import Induced.Inverse[g := codomainIso.backward] \as Reverse;
\definition compatibleBack: Commutes -> Reverse.CompatibleBack :=
  \fun (commutes: Commutes)(y: Y)(member: _) =>
    TargetImages.eliminate g y (SourceImagesSub.Member sourceImage (codomainIso.backward.apply y))
      (\fun (x: X)(equal: g.apply x = y) =>
        SourceImages.introduce f (codomainIso.backward.apply y) (domainIso.backward.apply x)
          (trans!{W} (f.apply (domainIso.backward.apply x)) (codomainIso.backward.apply (g.apply x)) (codomainIso.backward.apply y)
            (reverseCommutes commutes x) (congr!{Y W} (codomainIso.backward.apply) (g.apply x) y equal))) member;
\import SourceImagesSub.Quotient[S := sourceImage] \as SourceQuotient;
\import TargetImagesSub.Quotient[S := targetImage] \as TargetQuotient;
\definition SourceCarrier: \Set := SourceQuotient.Carrier;
\definition TargetCarrier: \Set := TargetQuotient.Carrier;
\definition sourceSpace: Space SourceCarrier := SourceQuotient.moduleSpace;
\definition targetSpace: Space TargetCarrier := TargetQuotient.moduleSpace;
\import \parent.\parent.Isomorphism[V := SourceCarrier, W := TargetCarrier, source := sourceSpace, target := targetSpace] \as QuotientIso;
\definition isomorphism(commutes: Commutes): QuotientIso.Isomorphism :=
  Reverse.isomorphism (compatible commutes) (compatibleBack commutes) codomainIso.leftInverse codomainIso.rightInverse;
\definition onClass: \forall (commutes: Commutes)(w: W) ->
  ((isomorphism commutes).forward).apply (SourceQuotient.class w) = TargetQuotient.class (codomainIso.forward.apply w) :=
  \fun (commutes: Commutes) => Induced.onClass (compatible commutes);

\definition backOnClass: \forall (commutes: Commutes)(y: Y) ->
  ((isomorphism commutes).backward).apply (TargetQuotient.class y) = SourceQuotient.class (codomainIso.backward.apply y) :=
  \fun (commutes: Commutes) => Reverse.backOnClass (compatibleBack commutes);
