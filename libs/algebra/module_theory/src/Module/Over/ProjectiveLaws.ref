\module Scalar {
  \definition bundle: Bundle := Bundle { Carrier := R, space := scalarModule };
  \module Lift(A, B: Bundle, q: MapBetween A B, f: MapBetween bundle B) {
    \import \parent.\parent.\parent.Hom[V := R, W := A.Carrier, source := scalarModule, target := A.space] \as Lifted;
    \definition map[a: A.Carrier]: Lifted.Map := Lifted.Map {
      apply := \fun (r: R) => A.space.smul r a,
      addition := \fun (r, s: R) => A.space.scalarAdd r s a,
      scalar := \fun (r, s: R) => A.space.scalarAssoc r s a,
    };
    \definition valueAtOne: \forall (r: R) -> f.apply r = B.space.smul r (f.apply (ring.one)) :=
      \fun (r: R) => trans!{B.Carrier} (f.apply r) (f.apply (ring.mul r (ring.one))) (B.space.smul r (f.apply (ring.one)))
        (congr!{R B.Carrier} (f.apply) r (ring.mul r (ring.one))
          (sym!{R} _ _ (((ring.semiring).multiplicative).rightIdentity r)))
        (f.scalar r (ring.one));
    \definition existence: Surjective A B q -> \exists ( g: MapBetween bundle A \where \forall (r: R) -> q.apply (g.apply r) = f.apply r ) := \block {
      \fun (onto: Surjective A B q) \then
      \takefrom a: \Cast[A.Carrier] ({ a: A.Carrier \where q.apply a = f.apply (ring.one) }) \by onto (f.apply (ring.one)) \then
      \return Logic.existsIntro[MapBetween bundle A, { g: MapBetween bundle A \where \forall (r: R) -> q.apply (g.apply r) = f.apply r }] (map a)
        (\fun (r: R) => trans!{B.Carrier} _ _ _ (q.scalar r a)
          (trans!{B.Carrier} _ _ _
            (congr!{B.Carrier B.Carrier} (B.space.smul r) _ _ (\bysub(A.Carrier, { a: A.Carrier \where q.apply a = f.apply (ring.one) }, a)))
            (sym!{B.Carrier} _ _ (valueAtOne r))))
    };
  }
  \definition projective: Projective bundle := \fun (A, B: Bundle)(q: MapBetween A B)(onto: Surjective A B q)(f: MapBetween bundle B) => Lift[A := A, B := B, q := q, f := f].existence onto;
}
\module Retract(P, Q: Bundle, inclusion: MapBetween P Q, retraction: MapBetween Q P) {
  \import \parent.\parent.Hom[V := P.Carrier, W := Q.Carrier, source := P.space, target := Q.space] \as Inclusions;
  \module Lift(A, B: Bundle, q: MapBetween A B, f: MapBetween P B) {
    \import \parent.\parent.\parent.Hom[V := P.Carrier, W := B.Carrier, source := P.space, target := B.space] \as Given;
    \import Given.Composition[U := Q.Carrier, domain := Q.space] \as ComposeGiven;
    \import \parent.\parent.\parent.Hom[V := Q.Carrier, W := A.Carrier, source := Q.space, target := A.space] \as Lifted;
    \import Lifted.Composition[U := P.Carrier, domain := P.space] \as ComposeLifted;
    \definition existence:
      (\forall (x: P.Carrier) -> retraction.apply (inclusion.apply x) = x) -> Projective Q -> Surjective A B q ->
      \exists ( g: MapBetween P A \where \forall (x: P.Carrier) -> q.apply (g.apply x) = f.apply x ) := \block {
      \fun (inverse: \forall (x: P.Carrier) -> retraction.apply (inclusion.apply x) = x)(projective: Projective Q)(onto: Surjective A B q) \then
      \takefrom lifted: \Cast[MapBetween Q A] ({ g: MapBetween Q A \where \forall (x: Q.Carrier) -> q.apply (g.apply x) = (ComposeGiven.compose f retraction).apply x })
        \by projective A.Carrier A.space B.Carrier B.space q onto (ComposeGiven.compose f retraction) \then
      \let law: \forall (x: Q.Carrier) -> q.apply (lifted.apply x) = f.apply (retraction.apply x) :=
        \bysub(MapBetween Q A, { g: MapBetween Q A \where \forall (x: Q.Carrier) -> q.apply (g.apply x) = (ComposeGiven.compose f retraction).apply x }, lifted) \then
      \return Logic.existsIntro[MapBetween P A, { g: MapBetween P A \where \forall (x: P.Carrier) -> q.apply (g.apply x) = f.apply x }] (ComposeLifted.compose lifted inclusion)
        (\fun (x: P.Carrier) => trans!{B.Carrier} _ _ _ (law (inclusion.apply x)) (congr!{P.Carrier B.Carrier} (f.apply) _ _ (inverse x)))
    };
  }
  \definition projective: (\forall (x: P.Carrier) -> retraction.apply (inclusion.apply x) = x) -> Projective Q -> Projective P :=
    \fun (inverse: _)(projective: Projective Q)(A, B: Bundle)(q: MapBetween A B)(onto: Surjective A B q)(f: MapBetween P B) =>
      Lift[A := A, B := B, q := q, f := f].existence inverse projective onto;
}

\module Biproduct(P, Q: Bundle) {
  \import \parent.\parent.Biproduct[V := P.Carrier, W := Q.Carrier, left := P.space, right := Q.space] \as Sum;
  \definition bundle: Bundle := Bundle { Carrier := Sum.Carrier, space := Sum.space };
  \module Lift(A, B: Bundle, q: MapBetween A B, f: MapBetween bundle B) {
    \import \parent.\parent.\parent.Hom[V := Sum.Carrier, W := B.Carrier, source := Sum.space, target := B.space] \as Given;
    \import Given.Composition[U := P.Carrier, domain := P.space] \as LeftGiven;
    \import Given.Composition[U := Q.Carrier, domain := Q.space] \as RightGiven;
    \import Sum.Copair[U := A.Carrier, target := A.space] \as Copair;
    \import \parent.\parent.\parent.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space] \as Projection;
    \definition existence: Projective P -> Projective Q -> Surjective A B q ->
      \exists ( g: MapBetween bundle A \where \forall (x: Sum.Carrier) -> q.apply (g.apply x) = f.apply x ) := \block {
      \fun (left: Projective P)(right: Projective Q)(onto: Surjective A B q) \then
      \takefrom l: \Cast[MapBetween P A] ({ l: MapBetween P A \where \forall (x: P.Carrier) -> q.apply (l.apply x) = f.apply (Sum.firstInjection.apply x) })
        \by left A.Carrier A.space B.Carrier B.space q onto (LeftGiven.compose f Sum.firstInjection) \then
      \takefrom r: \Cast[MapBetween Q A] ({ r: MapBetween Q A \where \forall (x: Q.Carrier) -> q.apply (r.apply x) = f.apply (Sum.secondInjection.apply x) })
        \by right A.Carrier A.space B.Carrier B.space q onto (RightGiven.compose f Sum.secondInjection) \then
      \let law: \forall (x: Sum.Carrier) -> q.apply ((Copair.copair l r).apply x) = f.apply x :=
        \fun (x: Sum.Carrier) => trans!{B.Carrier} _ _ _
          (q.addition (l.apply (Sum.first x)) (r.apply (Sum.second x)))
          (trans!{B.Carrier} _ _ _
            (congr2!{B.Carrier B.Carrier B.Carrier} (B.space.add) _ _ _ _
              ((\bysub(MapBetween P A, { l: MapBetween P A \where \forall (x: P.Carrier) -> q.apply (l.apply x) = f.apply (Sum.firstInjection.apply x) }, l)) (Sum.first x))
              ((\bysub(MapBetween Q A, { r: MapBetween Q A \where \forall (x: Q.Carrier) -> q.apply (r.apply x) = f.apply (Sum.secondInjection.apply x) }, r)) (Sum.second x)))
            (trans!{B.Carrier} _ _ _ (sym!{B.Carrier} _ _ (f.addition (Sum.firstInjection.apply (Sum.first x)) (Sum.secondInjection.apply (Sum.second x))))
              (congr!{Sum.Carrier B.Carrier} (f.apply) _ _ (Sum.reconstruction x)))) \then
      \return Logic.existsIntro[MapBetween bundle A, { g: MapBetween bundle A \where \forall (x: Sum.Carrier) -> q.apply (g.apply x) = f.apply x }] (Copair.copair l r)
        law
    };
  }
  \definition projective: Projective P -> Projective Q -> Projective bundle :=
    \fun (left: Projective P)(right: Projective Q)(A, B: Bundle)(q: MapBetween A B)(onto: Surjective A B q)(f: MapBetween bundle B) =>
      Lift[A := A, B := B, q := q, f := f].existence left right onto;
}

\module Trivial(P: Bundle) {
  \definition Trivial: \Prop := \forall (x: P.Carrier) -> x = P.space.zero;
  \module Lift(A, B: Bundle, q: MapBetween A B, f: MapBetween P B) {
    \import \parent.\parent.\parent.Hom[V := P.Carrier, W := A.Carrier, source := P.space, target := A.space] \as Lifted;
    \import \parent.\parent.\parent.Hom[V := P.Carrier, W := B.Carrier, source := P.space, target := B.space] \as Given;
    \import \parent.\parent.\parent.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space] \as Projection;
    \definition law: Trivial -> \forall (x: P.Carrier) -> q.apply (Lifted.zeroMap.apply x) = f.apply x :=
      \fun (trivial: Trivial)(x: P.Carrier) => trans!{B.Carrier} _ _ _ (Projection.zeroPreserved q)
        (sym!{B.Carrier} _ _
          (trans!{B.Carrier} _ _ _ (congr!{P.Carrier B.Carrier} (f.apply) _ _ (trivial x)) (Given.zeroPreserved f)));
    \definition existence: Trivial -> \exists ( g: MapBetween P A \where \forall (x: P.Carrier) -> q.apply (g.apply x) = f.apply x ) :=
      \fun (trivial: Trivial) => Logic.existsIntro[MapBetween P A, { g: MapBetween P A \where \forall (x: P.Carrier) -> q.apply (g.apply x) = f.apply x }] Lifted.zeroMap
        (law trivial);
  }
  \definition projective: Trivial -> Projective P :=
    \fun (trivial: Trivial)(A, B: Bundle)(q: MapBetween A B)(onto: Surjective A B q)(f: MapBetween P B) =>
      Lift[A := A, B := B, q := q, f := f].existence trivial;
}
