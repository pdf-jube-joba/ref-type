\import \parent.\parent.FiniteCoordinates[n := N.Nat^::succ n] \as Larger;
\import Finite.Tuples[A := R] \as Tuples;
\definition head[v: Larger.Carrier]: R := v (Finite.zero n);
\definition tail[v: Larger.Carrier]: Carrier := \fun (i: Index) => v (Finite.succ n i);
\definition cons: R -> Carrier -> Larger.Carrier := Tuples.extend n;
\definition headCons: \forall (a: R)(v: Carrier) -> head (cons a v) = a := Tuples.atZero n;
\definition tailCons: \forall (a: R)(v: Carrier) -> tail (cons a v) = v :=
  \fun (a: R)(v: Carrier) => \axiom:funext(tail (cons a v), v, Tuples.atSuccessor n a v);
\definition recover: \forall (v: Larger.Carrier) -> cons (head v) (tail v) = v := Tuples.recover n;
\definition consAddition: \forall (a, b: R)(v, w: Carrier) -> cons (ring.add a b) (space.add v w) = Larger.space.add (cons a v) (cons b w) :=
  \fun (a, b: R)(v, w: Carrier) => Tuples.extensionality n _ _
    (trans!{R} _ _ _ (headCons (ring.add a b) (space.add v w))
      (sym!{R} _ _ (congr2!{R R R} (ring.add) _ _ _ _ (headCons a v) (headCons b w))))
    (\fun (i: Index) => trans!{R} _ _ _ (Tuples.atSuccessor n (ring.add a b) (space.add v w) i)
      (sym!{R} _ _ (congr2!{R R R} (ring.add) _ _ _ _ (Tuples.atSuccessor n a v i) (Tuples.atSuccessor n b w i))));
\definition consScalar: \forall (a, b: R)(v: Carrier) -> cons (ring.mul a b) (space.smul a v) = Larger.space.smul a (cons b v) :=
  \fun (a, b: R)(v: Carrier) => Tuples.extensionality n _ _
    (trans!{R} _ _ _ (headCons (ring.mul a b) (space.smul a v))
      (sym!{R} _ _ (congr!{R R} (ring.mul a) _ _ (headCons b v))))
    (\fun (i: Index) => trans!{R} _ _ _ (Tuples.atSuccessor n (ring.mul a b) (space.smul a v) i)
      (sym!{R} _ _ (congr!{R R} (ring.mul a) _ _ (Tuples.atSuccessor n b v i))));
\definition zeroExtend[v: Carrier]: Larger.Carrier := cons ring.zero v;
\definition zeroAddition: \forall (v, w: Carrier) -> zeroExtend (space.add v w) = Larger.space.add (zeroExtend v) (zeroExtend w) :=
  \fun (v, w: Carrier) => trans!{Larger.Carrier} _ _ _
    (congr!{R Larger.Carrier} (\fun (a: R) => cons a (space.add v w)) _ _ (sym!{R} _ _ (Scalars.zeroLeft ring.zero)))
    (consAddition ring.zero ring.zero v w);
\definition zeroScalar: \forall (a: R)(v: Carrier) -> zeroExtend (space.smul a v) = Larger.space.smul a (zeroExtend v) :=
  \fun (a: R)(v: Carrier) => trans!{Larger.Carrier} _ _ _
    (congr!{R Larger.Carrier} (\fun (b: R) => cons b (space.smul a v)) _ _
      (sym!{R} _ _ ((ring.semiring).zeroAbsorbsRight a))) (consScalar a ring.zero v);
\import \parent.\parent.Hom[V := Carrier, W := Larger.Carrier, source := space, target := Larger.space] \as Inclusions;
\definition inclusion: Inclusions.Map := Inclusions.Map { apply := zeroExtend, addition := zeroAddition, scalar := zeroScalar };
\import \parent.\parent.Hom[V := Larger.Carrier, W := Carrier, source := Larger.space, target := space] \as Tails;
\definition restriction: Tails.Map := Tails.Map {
  apply := tail,
  addition := \fun (v, w: Larger.Carrier) => \axiom:funext(tail (Larger.space.add v w), space.add (tail v) (tail w), \fun (i: Index) => \refl(ring.add (v (Finite.succ n i)) (w (Finite.succ n i)))),
  scalar := \fun (a: R)(v: Larger.Carrier) => \axiom:funext(tail (Larger.space.smul a v), space.smul a (tail v), \fun (i: Index) => \refl(ring.mul a (v (Finite.succ n i)))),
};
\definition zeroZero: zeroExtend space.zero = Larger.space.zero := Inclusions.zeroPreserved inclusion;
