\import \parent.Laws[] \as ExtensionLaws;
\import \parent.\parent.\parent.Submodule[V := Carrier, space := space] \as Submodules;
\definition data: Submodules.Data := Submodules.Data { carrier := { v: Carrier \where EarlyZero v } };
\definition laws: Submodules.Laws[data] := Submodules.Laws[data] {
  zero := \fun (i: Index)(early: _) => \refl(ring.zero),
  addition := \fun (v, w: Carrier)(left: EarlyZero v)(right: EarlyZero w)(i: Index)(early: _) =>
    trans!{R} (ring.add (v i) (w i)) (ring.add ring.zero ring.zero) ring.zero
      (congr2!{R R R} (ring.add) (v i) ring.zero (w i) ring.zero (left i early) (right i early))
      (Scalars.zeroLeft ring.zero),
  scalar := \fun (a: R)(v: Carrier)(member: EarlyZero v)(i: Index)(early: _) =>
    trans!{R} (ring.mul a (v i)) (ring.mul a ring.zero) ring.zero
      (congr!{R R} (ring.mul a) (v i) ring.zero (member i early))
      ((ring.semiring).zeroAbsorbsRight a),
};
\definition submodule: Submodules.Submodule := \into[Submodules.Data](data, { data: Submodules.Data \where Submodules.Laws[data] }) \by { laws };
\import \parent.\parent.\parent.Of[V := Carrier, space := space].Submodule[].Of[S := submodule] \as Included;
\definition ZeroCarrier: \Set := Included.Carrier;
\definition zeroSpace: Space ZeroCarrier := Included.moduleSpace;
\import \parent.\parent.\parent.Hom[V := Smaller.Carrier, W := ZeroCarrier, source := Smaller.space, target := zeroSpace] \as Extensions;
\definition inclusion(v: Smaller.Carrier): ZeroCarrier := \into[Carrier](extension v, submodule.carrier) \by {
  \fun (i: Index)(early: _) => atEarly v i early
};
\definition forward: Extensions.Map := Extensions.Map {
  apply := inclusion,
  addition := ExtensionLaws.extensionAddition,
  scalar := ExtensionLaws.extensionScalar,
};
\import \parent.\parent.\parent.Hom[V := ZeroCarrier, W := Smaller.Carrier, source := zeroSpace, target := Smaller.space] \as Restrictions;
\definition backward(within: Bounds.Le start n): Restrictions.Map := Restrictions.Map {
  apply := \fun (v: ZeroCarrier) => restriction within v,
  addition := \fun (v, w: ZeroCarrier) => \axiom:funext(restriction within (zeroSpace.add v w), Smaller.space.add (restriction within v) (restriction within w),
    \fun (i: Smaller.Index) => \refl(ring.add (v (Indices.include within i)) (w (Indices.include within i)))),
  scalar := \fun (a: R)(v: ZeroCarrier) => \axiom:funext(restriction within (zeroSpace.smul a v), Smaller.space.smul a (restriction within v),
    \fun (i: Smaller.Index) => \refl(ring.mul a (v (Indices.include within i)))),
};
\import \parent.\parent.\parent.Isomorphism[V := Smaller.Carrier, W := ZeroCarrier, source := Smaller.space, target := zeroSpace] \as Iso;
\definition isoData(within: Bounds.Le start n): Iso.Data := Iso.Data { forward := forward, backward := backward within };
\definition isoLaws: \forall (within: Bounds.Le start n) -> Iso.Laws[isoData within] :=
  \fun (within: Bounds.Le start n) => Iso.Laws[isoData within] {
    leftInverse := restrictionExtension within,
    rightInverse := \fun (v: ZeroCarrier) => recover within v (\bysub(Carrier, submodule.carrier, v)),
  };
\definition isomorphism(within: Bounds.Le start n): Iso.Isomorphism :=
  \into[Iso.Data](isoData within, { data: Iso.Data \where Iso.Laws[data] }) \by { isoLaws within };
