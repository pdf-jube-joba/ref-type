\use std.Logic[].Equality[].eq_reason_in;
\definition extensionAddition: \forall (v, w: Smaller.Carrier) -> extension (Smaller.space.add v w) = space.add (extension v) (extension w) :=
  \fun (v, w: Smaller.Carrier) => \axiom:funext(extension (Smaller.space.add v w), space.add (extension v) (extension w),
    \fun (i: Index) => trans!{R} _ _ _
      (SumLaws.congruent (Finite.elements (Nat.sub n start))
        (\fun (j: Smaller.Index) => ring.mul (NaturalDelta.delta i (Nat.add start j)) (ring.add (v j) (w j)))
        (\fun (j: Smaller.Index) => ring.add (ring.mul (NaturalDelta.delta i (Nat.add start j)) (v j)) (ring.mul (NaturalDelta.delta i (Nat.add start j)) (w j)))
        (\fun (j: Smaller.Index) => (ring.semiring).leftDistributive (NaturalDelta.delta i (Nat.add start j)) (v j) (w j)))
      (SumLaws.additive (Finite.elements (Nat.sub n start))
        (\fun (j: Smaller.Index) => ring.mul (NaturalDelta.delta i (Nat.add start j)) (v j))
        (\fun (j: Smaller.Index) => ring.mul (NaturalDelta.delta i (Nat.add start j)) (w j))));
\definition scalarTerm: \forall (a: R)(v: Smaller.Carrier)(i: Index)(j: Smaller.Index) ->
  ring.mul (NaturalDelta.delta i (Nat.add start j)) (ring.mul a (v j)) =
  ring.mul a (ring.mul (NaturalDelta.delta i (Nat.add start j)) (v j)) :=
  \fun (a: R)(v: Smaller.Carrier)(i: Index)(j: Smaller.Index) =>
    eq_reason_in!{R _
      "=" _ "by" { sym!{R} _ _ (((ring.semiring).multiplicative).associative (NaturalDelta.delta i (Nat.add start j)) a (v j)) }
      "=" _ "by" { congr!{R R} (\fun (x: R) => ring.mul x (v j)) _ _ (sym!{R} (ring.mul a (NaturalDelta.delta i (Nat.add start j))) (ring.mul (NaturalDelta.delta i (Nat.add start j)) a) (NaturalDelta.central i (Nat.add start j) a)) }
      "=" _ "by" { ((ring.semiring).multiplicative).associative a (NaturalDelta.delta i (Nat.add start j)) (v j) }
    };
\definition extensionScalar: \forall (a: R)(v: Smaller.Carrier) -> extension (Smaller.space.smul a v) = space.smul a (extension v) :=
  \fun (a: R)(v: Smaller.Carrier) => \axiom:funext(extension (Smaller.space.smul a v), space.smul a (extension v),
    \fun (i: Index) => trans!{R} _ _ _
      (SumLaws.congruent (Finite.elements (Nat.sub n start))
        (\fun (j: Smaller.Index) => ring.mul (NaturalDelta.delta i (Nat.add start j)) (ring.mul a (v j)))
        (\fun (j: Smaller.Index) => ring.mul a (ring.mul (NaturalDelta.delta i (Nat.add start j)) (v j)))
        (\fun (j: Smaller.Index) => scalarTerm a v i j))
      (SumLaws.multiplyLeft (Finite.elements (Nat.sub n start)) a (\fun (j: Smaller.Index) => ring.mul (NaturalDelta.delta i (Nat.add start j)) (v j))));
