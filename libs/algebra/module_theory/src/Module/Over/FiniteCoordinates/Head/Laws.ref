\definition extensionAddition: \forall (v, w: Smaller.Carrier) -> extension (Smaller.space.add v w) = space.add (extension v) (extension w) :=
  \fun (v, w: Smaller.Carrier) => \axiom:funext(extension (Smaller.space.add v w), space.add (extension v) (extension w),
    \fun (i: Index) => trans!{R} _ _ _
      (SumLaws.congruent (Finite.elements rank)
        (\fun (j: Smaller.Index) => ring.mul (NaturalDelta.delta i j) (ring.add (v j) (w j)))
        (\fun (j: Smaller.Index) => ring.add (ring.mul (NaturalDelta.delta i j) (v j)) (ring.mul (NaturalDelta.delta i j) (w j)))
        (\fun (j: Smaller.Index) => (ring.semiring).leftDistributive (NaturalDelta.delta i j) (v j) (w j)))
      (SumLaws.additive (Finite.elements rank)
        (\fun (j: Smaller.Index) => ring.mul (NaturalDelta.delta i j) (v j))
        (\fun (j: Smaller.Index) => ring.mul (NaturalDelta.delta i j) (w j))));
\definition scalarTerm: \forall (a: R)(v: Smaller.Carrier)(i: Index)(j: Smaller.Index) ->
  ring.mul (NaturalDelta.delta i j) (ring.mul a (v j)) =
  ring.mul a (ring.mul (NaturalDelta.delta i j) (v j)) :=
  \fun (a: R)(v: Smaller.Carrier)(i: Index)(j: Smaller.Index) =>
    trans!{R} _ _ _
      (sym!{R} _ _ (((ring.semiring).multiplicative).associative (NaturalDelta.delta i j) a (v j)))
      (trans!{R} _ _ _
        (congr!{R R} (\fun (x: R) => ring.mul x (v j)) _ _ (sym!{R} (ring.mul a (NaturalDelta.delta i j)) (ring.mul (NaturalDelta.delta i j) a) (NaturalDelta.central i j a)))
        (((ring.semiring).multiplicative).associative a (NaturalDelta.delta i j) (v j)));
\definition extensionScalar: \forall (a: R)(v: Smaller.Carrier) -> extension (Smaller.space.smul a v) = space.smul a (extension v) :=
  \fun (a: R)(v: Smaller.Carrier) => \axiom:funext(extension (Smaller.space.smul a v), space.smul a (extension v),
    \fun (i: Index) => trans!{R} _ _ _
      (SumLaws.congruent (Finite.elements rank)
        (\fun (j: Smaller.Index) => ring.mul (NaturalDelta.delta i j) (ring.mul a (v j)))
        (\fun (j: Smaller.Index) => ring.mul a (ring.mul (NaturalDelta.delta i j) (v j)))
        (\fun (j: Smaller.Index) => scalarTerm a v i j))
      (SumLaws.multiplyLeft (Finite.elements rank) a (\fun (j: Smaller.Index) => ring.mul (NaturalDelta.delta i j) (v j))));
