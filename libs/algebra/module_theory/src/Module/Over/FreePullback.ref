\structure Data: \Set := {
  left: Left -> Whole, right: Right -> Whole,
  overLeft: Overlap -> Left, overRight: Overlap -> Right,
};
\structure Laws[data: Data]: \Prop := {
  leftInjective: \forall (x, y: Left) -> data.left x = data.left y -> x = y,
  overlapInjective: \forall (x, y: Overlap) -> data.overRight x = data.overRight y -> x = y,
  commutes: \forall (x: Overlap) -> data.left (data.overLeft x) = data.right (data.overRight x),
  cartesian: \forall (x: Left)(y: Right) -> data.left x = data.right y ->
    \exists ( z: Overlap \where Logic.And[data.overLeft z = x, data.overRight z = y] ),
};
\definition Square: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\definition laws[square: Square]: Laws[square] := \bysub(Data, { data: Data \where Laws[data] }, square);
\module On(square: Square);

\structure UnionLaws[square: Square]: \Prop := {
  rightInjective: \forall (x, y: Right) -> (square).right x = (square).right y -> x = y,
  covered: \forall (w: Whole) -> Logic.Or[\exists ( x: Left \where (square).left x = w ), \exists ( x: Right \where (square).right x = w )],
};
\definition Union: \Set := \Cast[Square] ({ square: Square \where UnionLaws[square] });
\module Covering(square: Union);
