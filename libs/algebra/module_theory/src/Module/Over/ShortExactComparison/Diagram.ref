\use std.Logic[].Equality[].eq_reason_in;
\structure Commutative: \Prop := {
  left: \forall (x: A.Carrier) -> b.apply (s.inclusion.apply x) = t.inclusion.apply (a.apply x),
  right: \forall (x: B.Carrier) -> t.projection.apply (b.apply x) = c.apply (s.projection.apply x),
};
\import \parent.\parent.Laws[V := B.Carrier, space := B.space] \as Middle;
\import \parent.\parent.Laws[V := B1.Carrier, space := B1.space] \as Middle1;
\import algebra.Group[].Of[Carrier := B.Carrier, group := Middle.additive] \as Group;
\import algebra.Group[].Of[Carrier := B1.Carrier, group := Middle1.additive] \as Group1;
\import \parent.\parent.Hom[V := B.Carrier, W := C.Carrier, source := B.space, target := C.space] \as SourceProjection;
\import \parent.\parent.Hom[V := B1.Carrier, W := C1.Carrier, source := B1.space, target := C1.space] \as TargetProjection;
\import \parent.\parent.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space] \as SourceInclusion;
\import \parent.\parent.Hom[V := A1.Carrier, W := B1.Carrier, source := A1.space, target := B1.space] \as TargetInclusion;
\definition kernelZero: Commutative -> Injective A A1 a -> Injective C C1 c ->
  \forall (x: B.Carrier) -> b.apply x = Middle1.zero -> x = Middle.zero := \block {
  \fun (diagram: Commutative)(leftInjective: Injective A A1 a)(rightInjective: Injective C C1 c)(x: B.Carrier)(killed: _) \then
  \let closed: s.projection.apply x = C.space.zero := rightInjective _ _
    (eq_reason_in!{C1.Carrier _
      "=" _ "by" { sym!{C1.Carrier} _ _ (diagram.right x) }
      "=" _ "by" { congr!{B1.Carrier C1.Carrier} (t.projection.apply) _ _ killed }
      "=" _ "by" { TargetProjection.zeroPreserved t.projection }
      "=" _ "by" { sym!{C1.Carrier} _ _ (RightMaps.zeroPreserved c) }
    }) \then
  \takefrom preimage: \Cast[A.Carrier] ({ u: A.Carrier \where s.inclusion.apply u = x }) \by s.kernelImage x closed \then
  \let image: s.inclusion.apply preimage = x := \bysub(A.Carrier, { u: A.Carrier \where s.inclusion.apply u = x }, preimage) \then
  \let imageZero: a.apply preimage = A1.space.zero := t.injective _ _
    (eq_reason_in!{B1.Carrier _
      "=" _ "by" { sym!{B1.Carrier} _ _ (diagram.left preimage) }
      "=" _ "by" { congr!{B.Carrier B1.Carrier} (b.apply) _ _ image }
      "=" _ "by" killed
      "=" _ "by" { sym!{B1.Carrier} _ _ (TargetInclusion.zeroPreserved t.inclusion) }
    }) \then
  \let preimageZero: preimage = A.space.zero := leftInjective _ _
    (trans!{A1.Carrier} _ _ _ imageZero (sym!{A1.Carrier} _ _ (LeftMaps.zeroPreserved a))) \then
  \return eq_reason_in!{B.Carrier _
    "=" _ "by" { sym!{B.Carrier} _ _ image }
    "=" _ "by" { congr!{A.Carrier B.Carrier} (s.inclusion.apply) _ _ preimageZero }
    "=" _ "by" { SourceInclusion.zeroPreserved s.inclusion }
  }
};
\definition injective: Commutative -> Injective A A1 a -> Injective C C1 c -> Injective B B1 b := \block {
  \fun (diagram: Commutative)(leftInjective: Injective A A1 a)(rightInjective: Injective C C1 c)(x, y: B.Carrier)(same: _) \then
  \let differenceZero: Group.difference x y = Middle.zero := kernelZero diagram leftInjective rightInjective (Group.difference x y)
    (eq_reason_in!{B1.Carrier _
      "=" _ "by" { MiddleMaps.differencePreserved b x y }
      "=" _ "by" { congr!{B1.Carrier B1.Carrier} (\fun (u: B1.Carrier) => Group1.difference u (b.apply y)) _ _ same }
      "=" _ "by" { Group1.inverseRight (b.apply y) }
    }) \then
  \return Group.cancelRight (Middle.neg y) x y
    (trans!{B.Carrier} _ _ _ differenceZero (sym!{B.Carrier} _ _ (Group.inverseRight y)))
};
\definition remainder[y: B1.Carrier][x: B.Carrier]: B1.Carrier := Group1.difference y (b.apply x);
\definition remainderClosed: \forall (diagram: Commutative)(y: B1.Carrier)(x: B.Carrier) ->
  c.apply (s.projection.apply x) = t.projection.apply y -> t.projection.apply (remainder y x) = C1.space.zero :=
  \fun (diagram: Commutative)(y: B1.Carrier)(x: B.Carrier)(same: _) => eq_reason_in!{C1.Carrier _
    "=" _ "by" { TargetProjection.differencePreserved t.projection y (b.apply x) }
    "=" _ "by" { congr!{C1.Carrier C1.Carrier}
        (\fun (u: C1.Carrier) => C1.space.add (t.projection.apply y) (C1.space.neg u)) _ _
        (trans!{C1.Carrier} _ _ _ (diagram.right x) same) }
    "=" _ "by" { ((C1.space.additive).group).rightInverse (t.projection.apply y) }
  };
\definition surjective: Commutative -> Surjective A A1 a -> Surjective C C1 c -> Surjective B B1 b := \block {
  \fun (diagram: Commutative)(leftOnto: Surjective A A1 a)(rightOnto: Surjective C C1 c)(y: B1.Carrier) \then
  \takefrom z: \Cast[C.Carrier] ({ z: C.Carrier \where c.apply z = t.projection.apply y }) \by rightOnto (t.projection.apply y) \then
  \takefrom x: \Cast[B.Carrier] ({ x: B.Carrier \where s.projection.apply x = z }) \by s.onto z \then
  \let projection: c.apply (s.projection.apply x) = t.projection.apply y := trans!{C1.Carrier} _ _ _
    (congr!{C.Carrier C1.Carrier} (c.apply) _ _ (\bysub(B.Carrier, { x: B.Carrier \where s.projection.apply x = z }, x)))
    (\bysub(C.Carrier, { z: C.Carrier \where c.apply z = t.projection.apply y }, z)) \then
  \takefrom u: \Cast[A1.Carrier] ({ u: A1.Carrier \where t.inclusion.apply u = remainder y x })
    \by t.kernelImage (remainder y x) (remainderClosed diagram y x projection) \then
  \takefrom v: \Cast[A.Carrier] ({ v: A.Carrier \where a.apply v = u }) \by leftOnto u \then
  \let correction: b.apply (s.inclusion.apply v) = remainder y x := eq_reason_in!{B1.Carrier _
    "=" _ "by" { diagram.left v }
    "=" _ "by" { congr!{A1.Carrier B1.Carrier} (t.inclusion.apply) _ _
      (\bysub(A.Carrier, { v: A.Carrier \where a.apply v = u }, v)) }
    "=" _ "by" { \bysub(A1.Carrier, { u: A1.Carrier \where t.inclusion.apply u = remainder y x }, u) }
  } \then
  \return Logic.existsIntro[B.Carrier, { x: B.Carrier \where b.apply x = y }] (Middle.add x (s.inclusion.apply v))
    (eq_reason_in!{B1.Carrier _
      "=" _ "by" { b.addition x (s.inclusion.apply v) }
      "=" _ "by" { congr!{B1.Carrier B1.Carrier} (Middle1.add (b.apply x)) _ _ correction }
      "=" _ "by" { Group1.comm (b.apply x) (remainder y x) }
      "=" _ "by" { Group1.assoc y (Middle1.neg (b.apply x)) (b.apply x) }
      "=" _ "by" { congr!{B1.Carrier B1.Carrier} (Middle1.add y) _ _ (Group1.inverseLeft (b.apply x)) }
      "=" _ "by" { Group1.zeroRight y }
    })
};
\import \parent.\parent.Isomorphism[V := B.Carrier, W := B1.Carrier, source := B.space, target := B1.space].OfBijective[f := b] \as Iso;
\import \parent.\parent.Isomorphism[V := B.Carrier, W := B1.Carrier, source := B.space, target := B1.space] \as Isomorphisms;
\definition isomorphism[diagram: Commutative][leftInjective: Injective A A1 a][leftOnto: Surjective A A1 a][rightInjective: Injective C C1 c][rightOnto: Surjective C C1 c]: Isomorphisms.Isomorphism :=
  Iso.isomorphism (injective diagram leftInjective rightInjective) (surjective diagram leftOnto rightOnto);
\definition existence: Commutative -> Injective A A1 a -> Surjective A A1 a -> Injective C C1 c -> Surjective C C1 c ->
  \exists Isomorphisms.Isomorphism :=
  \fun (diagram: Commutative)(leftInjective: Injective A A1 a)(leftOnto: Surjective A A1 a)(rightInjective: Injective C C1 c)(rightOnto: Surjective C C1 c) =>
    \exact(isomorphism diagram leftInjective leftOnto rightInjective rightOnto, Isomorphisms.Isomorphism);
