\use std.Logic[].Equality[].eq_reason_in;
\import Source.To[W := Target.Carrier, target := Target.space] \as Universal;
\module At(i: Index) {
  \import \parent.\parent.\parent.Hom[V := targetFamily.Carrier i, W := Target.Carrier, source := targetFamily.space i, target := Target.space].Composition[U := sourceFamily.Carrier i, domain := sourceFamily.space i] \as Compose;
  \definition component: Universal.At[i := i].Map := Compose.compose (Target.Injection[i := i].map) (f i);
}
\definition components: Universal.Components := \fun (i: Index) => At[i := i].component;
\definition map: MapBetween Source.bundle Target.bundle := Universal.extension components;
\definition onInjection: \forall (i: Index)(x: sourceFamily.Carrier i) ->
  map.apply ((Source.Injection[i := i].map).apply x) = (Target.Injection[i := i].map).apply ((f i).apply x) := Universal.onInjection components;
\import \parent.\parent.Hom[V := Source.Carrier, W := TargetProduct.Carrier, source := Source.space, target := TargetProduct.space] \as CoordinateMaps;
\definition coordinateMap: CoordinateMaps.Map := CoordinateMaps.Map {
  apply := \fun (x: Source.Carrier)(i: Index) => (f i).apply (SourceCoordinates.coordinates x i),
  addition := \fun (x, y: Source.Carrier) => \axiom:funext(
    (\fun (i: Index) => (f i).apply (SourceCoordinates.coordinates (Source.space.add x y) i)),
    (\fun (i: Index) => (targetFamily.space i).add ((f i).apply (SourceCoordinates.coordinates x i)) ((f i).apply (SourceCoordinates.coordinates y i))),
    \fun (i: Index) => trans!{{targetFamily.Carrier i}}
      _ _ _
      (congr!{{sourceFamily.Carrier i} {targetFamily.Carrier i}} ((f i).apply)
        _ _
        (congr!{{\forall (j: Index) -> sourceFamily.Carrier j} {sourceFamily.Carrier i}}
          (\fun (v: \forall (j: Index) -> sourceFamily.Carrier j) => v i)
          _ _
          (SourceCoordinates.coordinatesAddition x y)))
      ((f i).addition (SourceCoordinates.coordinates x i) (SourceCoordinates.coordinates y i))),
  scalar := \fun (a: R)(x: Source.Carrier) => \axiom:funext(
    (\fun (i: Index) => (f i).apply (SourceCoordinates.coordinates (Source.space.smul a x) i)),
    (\fun (i: Index) => (targetFamily.space i).smul a ((f i).apply (SourceCoordinates.coordinates x i))),
    \fun (i: Index) => trans!{{targetFamily.Carrier i}}
      _ _ _
      (congr!{{sourceFamily.Carrier i} {targetFamily.Carrier i}} ((f i).apply)
        _ _
        (congr!{{\forall (j: Index) -> sourceFamily.Carrier j} {sourceFamily.Carrier i}}
          (\fun (v: \forall (j: Index) -> sourceFamily.Carrier j) => v i)
          _ _
          (SourceCoordinates.coordinatesScalar a x)))
      ((f i).scalar a (SourceCoordinates.coordinates x i))),
};
\definition targetCoordinates: CoordinateMaps.Map := CoordinateMaps.Map {
  apply := \fun (x: Source.Carrier) => TargetCoordinates.coordinates (map.apply x),
  addition := \fun (x, y: Source.Carrier) => trans!{TargetProduct.Carrier} _ _ _
    (congr!{Target.Carrier TargetProduct.Carrier} TargetCoordinates.coordinates _ _ (map.addition x y))
    (TargetCoordinates.coordinatesAddition (map.apply x) (map.apply y)),
  scalar := \fun (a: R)(x: Source.Carrier) => trans!{TargetProduct.Carrier} _ _ _
    (congr!{Target.Carrier TargetProduct.Carrier} TargetCoordinates.coordinates _ _ (map.scalar a x))
    (TargetCoordinates.coordinatesScalar a (map.apply x)),
};
\module Injection(i: Index, x: sourceFamily.Carrier i) {
  \definition same: TargetCoordinates.coordinates (map.apply ((Source.Injection[i := i].map).apply x)) i =
    (f i).apply (SourceCoordinates.coordinates ((Source.Injection[i := i].map).apply x) i) :=
    eq_reason_in!{{targetFamily.Carrier i} _
      "=" _ "by" { congr!{Target.Carrier {targetFamily.Carrier i}} (\fun (q: Target.Carrier) => TargetCoordinates.coordinates q i) _ _ (onInjection i x) }
      "=" _ "by" { TargetCoordinates.atOwn i ((f i).apply x) }
      "=" _ "by" { sym!{{targetFamily.Carrier i}} _ _ (congr!{{sourceFamily.Carrier i} {targetFamily.Carrier i}} ((f i).apply) _ _ (SourceCoordinates.atOwn i x)) }
    };
  \definition different: \forall (j: Index) -> Logic.Not (i = j) ->
    TargetCoordinates.coordinates (map.apply ((Source.Injection[i := i].map).apply x)) j =
      (f j).apply (SourceCoordinates.coordinates ((Source.Injection[i := i].map).apply x) j) :=
    \fun (j: Index)(ne: Logic.Not (i = j)) => eq_reason_in!{{targetFamily.Carrier j} _
      "=" _ "by" { congr!{Target.Carrier {targetFamily.Carrier j}} (\fun (q: Target.Carrier) => TargetCoordinates.coordinates q j) _ _ (onInjection i x) }
      "=" _ "by" { TargetCoordinates.atOther i j ((f i).apply x) ne }
      "=" _ "by" { sym!{{targetFamily.Carrier j}} _ _ (trans!{{targetFamily.Carrier j}} _ _ _
          (congr!{{sourceFamily.Carrier j} {targetFamily.Carrier j}} ((f j).apply) _ _ (SourceCoordinates.atOther i j x ne))
          (\parent.\parent.Component[i := j].zero (f j))) }
    };
  \import std.Logic[].Classical[] \as Classical;
  \use Logic.either;
  \definition point: \forall (j: Index) -> TargetCoordinates.coordinates (map.apply ((Source.Injection[i := i].map).apply x)) j =
    (f j).apply (SourceCoordinates.coordinates ((Source.Injection[i := i].map).apply x) j) :=
    \fun (j: Index) => either!{{(Classical.excludedMiddle (i = j))} {
      TargetCoordinates.coordinates (map.apply ((Source.Injection[i := i].map).apply x)) j =
      (f j).apply (SourceCoordinates.coordinates ((Source.Injection[i := i].map).apply x) j) }
      { \fun (equal: i = j) => \idelim i = j \with j: Index =>
          TargetCoordinates.coordinates (map.apply ((Source.Injection[i := i].map).apply x)) j =
          (f j).apply (SourceCoordinates.coordinates ((Source.Injection[i := i].map).apply x) j)
        \by { base: same, equality: equal } }
      { different j }
    };
  \definition equality: targetCoordinates.apply ((Source.Injection[i := i].map).apply x) =
    coordinateMap.apply ((Source.Injection[i := i].map).apply x) := TargetProduct.ext _ _ point;
}
\import Source.To[W := TargetProduct.Carrier, target := TargetProduct.space] \as CoordinateUniversal;
\definition coordinateComponents: CoordinateUniversal.Components := \fun (i: Index) => CoordinateUniversal.At[i := i].Map {
  apply := \fun (x: sourceFamily.Carrier i) => coordinateMap.apply ((Source.Injection[i := i].map).apply x),
  addition := \fun (x, y: sourceFamily.Carrier i) => trans!{TargetProduct.Carrier} _ _ _
    (congr!{Source.Carrier TargetProduct.Carrier} (coordinateMap.apply) _ _ ((Source.Injection[i := i].map).addition x y))
    (coordinateMap.addition ((Source.Injection[i := i].map).apply x) ((Source.Injection[i := i].map).apply y)),
  scalar := \fun (a: R)(x: sourceFamily.Carrier i) => trans!{TargetProduct.Carrier} _ _ _
    (congr!{Source.Carrier TargetProduct.Carrier} (coordinateMap.apply) _ _ ((Source.Injection[i := i].map).scalar a x))
    (coordinateMap.scalar a ((Source.Injection[i := i].map).apply x)),
};
\definition coordinateEquality: targetCoordinates = coordinateMap := trans!{CoordinateMaps.Map} _ _ _
  (CoordinateUniversal.unique coordinateComponents targetCoordinates (\fun (i: Index)(x: sourceFamily.Carrier i) => Injection[i := i, x := x].equality))
  (sym!{CoordinateMaps.Map} _ _ (CoordinateUniversal.unique coordinateComponents coordinateMap (\fun (i: Index)(x: sourceFamily.Carrier i) => \refl(coordinateMap.apply ((Source.Injection[i := i].map).apply x)))));
\definition coordinatesNatural: \forall (x: Source.Carrier)(i: Index) -> TargetCoordinates.coordinates (map.apply x) i = (f i).apply (SourceCoordinates.coordinates x i) :=
  \fun (x: Source.Carrier)(i: Index) => congr!{CoordinateMaps.Map {targetFamily.Carrier i}} (\fun (g: CoordinateMaps.Map) => g.apply x i) targetCoordinates coordinateMap coordinateEquality;
\definition injective: (\forall (i: Index)(x, y: sourceFamily.Carrier i) -> (f i).apply x = (f i).apply y -> x = y) -> \forall (x, y: Source.Carrier) -> map.apply x = map.apply y -> x = y :=
  \fun (componentsInjective: \forall (i: Index)(x, y: sourceFamily.Carrier i) -> (f i).apply x = (f i).apply y -> x = y)(x, y: Source.Carrier)(equal: map.apply x = map.apply y) =>
    SourceCoordinates.injective x y (\axiom:funext(SourceCoordinates.coordinates x, SourceCoordinates.coordinates y,
      \fun (i: Index) => componentsInjective i (SourceCoordinates.coordinates x i) (SourceCoordinates.coordinates y i)
        (eq_reason_in!{{targetFamily.Carrier i} _
          "=" _ "by" { sym!{{targetFamily.Carrier i}} _ _ (coordinatesNatural x i) }
          "=" _ "by" { congr!{Target.Carrier {targetFamily.Carrier i}} (\fun (q: Target.Carrier) => TargetCoordinates.coordinates q i) _ _ equal }
          "=" _ "by" { coordinatesNatural y i }
        })));
