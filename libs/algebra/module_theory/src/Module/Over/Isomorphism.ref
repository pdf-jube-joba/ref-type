\import \parent.Hom[V := V, W := W, source := source, target := target] \as Forward;
\import \parent.Hom[V := W, W := V, source := target, target := source] \as Backward;
\structure Data: \Set {
  forward: Forward.Map,
  backward: Backward.Map,
}
\structure Laws[data: Data]: \Prop {
  leftInverse: \forall (x: V) -> data.backward.apply (data.forward.apply x) = x,
  rightInverse: \forall (x: W) -> data.forward.apply (data.backward.apply x) = x,
}
\definition Isomorphism: \Set := \Cast[Data] ({ data: Data \where Laws[data] });
\module OfBijective(f: Forward.Map);
\module Composition(U: \Set, final: Space U);
\module Inverse;
