\import Modules.Hom[V := Carrier, W := Quotient.Carrier, source := space, target := Quotient.moduleSpace]
  .Composition[U := Ambient.Carrier, domain := Ambient.space] \as Composition;
\import Modules.Hom[V := Ambient.Carrier, W := Quotient.Carrier, source := Ambient.space, target := Quotient.moduleSpace] \as Maps;
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition onGenerator: \forall (t: TargetGenerators) -> (forward).apply ((Projection.map).apply (Ambient.generator t)) = Quotient.class (Ambient.generator t) :=
  \fun (t: TargetGenerators) => either!{{(Classical.excludedMiddle (\exists Fiber t))} {(forward).apply ((Projection.map).apply (Ambient.generator t)) = Quotient.class (Ambient.generator t)}
    {\block {
      \fun (exists: \exists Fiber t) \then
      \takefrom s: Fiber t \by exists \then
      \let same: f s = t := \bysub(Generators, Fiber t, s) \then
      \return trans!{Quotient.Carrier} _ _ _
        (congr!{Carrier Quotient.Carrier} ((forward).apply) _ _ (Projection.outside t (\fun (outside: \In[TargetGenerators] Complement t) => outside exists)))
        (trans!{Quotient.Carrier} _ _ _ (Forward.zeroPreserved forward)
          (sym!{Quotient.Carrier} _ _ (trans!{Quotient.Carrier} _ _ _
            (congr!{TargetGenerators Quotient.Carrier} (\fun (b: TargetGenerators) => Quotient.class (Ambient.generator b)) _ _ (sym!{TargetGenerators} _ _ same)) (onImage s))))
    }}
    {\fun (outside: Logic.Not (\exists Fiber t)) => \block {
      \let s: Outside.Selected := \into[TargetGenerators](t, Complement) \by { outside } \then
      \return trans!{Quotient.Carrier} _ _ _
        (congr!{Carrier Quotient.Carrier} ((forward).apply) _ _ (Projection.onSelected s)) (forwardOnGenerator s)
    }}
  };
\definition equation: Composition.compose forward Projection.map = Quotient.projection := Ambient.To[W := Quotient.Carrier, target := Quotient.moduleSpace].ext _ _ onGenerator;
\definition law: \forall (q: Quotient.Carrier) -> (forward).apply ((backward).apply q) = q :=
  Quotient.induction (\fun (q: Quotient.Carrier) => (forward).apply ((backward).apply q) = q)
    (\fun (x: Ambient.Carrier) => trans!{Quotient.Carrier} _ _ _
      (congr!{Carrier Quotient.Carrier} ((forward).apply) _ _ (backwardOnClass x))
      (congr!{Maps.Map Quotient.Carrier} (\fun (g: Maps.Map) => (g).apply x) _ _ equation));
