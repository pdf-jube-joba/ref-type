\use std.Logic[].Equality[].eq_reason_in;
\import Modules.Hom[V := Quotient.Carrier, W := Carrier, source := Quotient.moduleSpace, target := space]
  .Composition[U := Carrier, domain := space] \as Composition;
\import Modules.End[V := Carrier, space := space] \as Identity;
\import Modules.Hom[V := Carrier, W := Carrier, source := space, target := space] \as Maps;
\import Modules.Free[Generators := Outside.Selected].To[W := Carrier, target := space] \as Extend;
\definition equation: Composition.compose backward forward = Identity.identity := Extend.ext _ _
  (\fun (s: Outside.Selected) => eq_reason_in!{Carrier _
    "=" _ "by" { congr!{Quotient.Carrier Carrier} ((backward).apply) _ _ (forwardOnGenerator s) }
    "=" _ "by" { backwardOnClass (Ambient.generator s) }
    "=" _ "by" { Projection.onSelected s }
  });
\definition law: \forall (x: Carrier) -> (backward).apply ((forward).apply x) = x :=
  \fun (x: Carrier) => congr!{Maps.Map Carrier} (\fun (f: Maps.Map) => (f).apply x) _ _ equation;
