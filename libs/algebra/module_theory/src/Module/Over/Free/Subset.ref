\definition Selected: \Set := \Cast[Generators] S;
\import \parent.\parent.Free[Generators := Selected] \as Free;
\import Free.Reindex[TargetGenerators := Generators] \as Reindex;
\definition inclusionFunction(s: Selected): Generators := s;
\definition inclusion: \parent.\parent.Hom[V := Free.Carrier, W := Carrier, source := Free.space, target := space].Map := Reindex.push inclusionFunction;
\definition onGenerator: \forall (s: Selected) -> #apply{inclusion} (Free.generator s) = generator s := Reindex.onGenerator inclusionFunction;
\import \parent.\parent.Of[V := Carrier, space := space].Submodule[] \as Submodules;
\import Submodules.Image[U := Free.Carrier, source := Free.space] \as Image;
\definition submodule: Submodules.Submodule := Image.image inclusion;
\definition Member(x: Carrier): \Prop := Submodules.Member submodule x;
\definition generatorMember: \forall (s: Generators) -> \In[Generators] S s -> Member (generator s) :=
  \fun (s: Generators)(member: \In[Generators] S s) => Image.introduce inclusion (generator s)
    (Free.generator (\into[Generators](s, S) \by { member })) (onGenerator (\into[Generators](s, S) \by { member }));
\module Into(W: \Set, target: Space W);
\module Projection;
\module QuotientBasis;
