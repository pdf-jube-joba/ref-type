\import \parent.\parent.Hom[V := Carrier, W := B.Carrier, source := space, target := B.space] \as Target;
\import \parent.\parent.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space].Composition[U := Carrier, domain := space] \as Composition;
\definition existence: Surjective A B q ->
  \exists ( g: MapBetween bundle A \where \forall (x: Carrier) -> q.apply (g.apply x) = f.apply x ) := \block {
  \fun (onto: Surjective A B q) \then
  \let Fiber: Generators -> \Set := \fun (s: Generators) => \Cast[A.Carrier] ({ x: A.Carrier \where q.apply x = f.apply (generator s) }) \then
  \let inhabited: \forall (s: Generators) -> \exists Fiber s := \fun (s: Generators) => onto (f.apply (generator s)) \then
  \let sections: \Prop := \exists (\forall (s: Generators) -> Fiber s) \then
  \let choices: sections := \axiom:classicalIndefiniteChoice(Generators, Fiber, inhabited) \then
  \takefrom selected: \forall (s: Generators) -> Fiber s \by choices \then
  \let values: Generators -> A.Carrier := \fun (s: Generators) => selected s \then
  \let lift: MapBetween bundle A := \parent.To[W := A.Carrier, target := A.space].extension values \then
  \let composite: Target.Map := Composition.compose q lift \then
  \let generatorLaw: \forall (s: Generators) -> composite.apply (generator s) = f.apply (generator s) :=
    \fun (s: Generators) => trans!{B.Carrier} _ _ _
      (congr!{A.Carrier B.Carrier} (q.apply) _ _ (\parent.To[W := A.Carrier, target := A.space].onGenerator values s))
      (\bysub(A.Carrier, { x: A.Carrier \where q.apply x = f.apply (generator s) }, selected s)) \then
  \let extended: Generators -> B.Carrier := \fun (s: Generators) => f.apply (generator s) \then
  \let equal: composite.apply = f.apply := trans!{{Carrier -> B.Carrier}} _ _ _
    (\parent.To[W := B.Carrier, target := B.space].unique extended composite generatorLaw)
    (sym!{{Carrier -> B.Carrier}} _ _ (\parent.To[W := B.Carrier, target := B.space].unique extended f (\fun (s: Generators) => \refl(f.apply (generator s))))) \then
  \return Logic.existsIntro[MapBetween bundle A, { g: MapBetween bundle A \where \forall (x: Carrier) -> q.apply (g.apply x) = f.apply x }] lift
    (\fun (x: Carrier) => congr!{{Carrier -> B.Carrier} B.Carrier} (\fun (h: Carrier -> B.Carrier) => h x) _ _ equal)
};
