\definition Unique: \Prop := \forall (x: Generators) -> x = point;
\import \parent.To[W := R, target := scalarModule] \as Augmentation;
\import \parent.\parent.Hom[V := R, W := Carrier, source := scalarModule, target := space] \as Forward;
\import \parent.\parent.Hom[V := Carrier, W := R, source := space, target := scalarModule] \as Backward;
\definition forward: Forward.Map := Forward.Map {
  apply := \fun (a: R) => #smul{space} a (generator point),
  addition := \fun (a, b: R) => #scalarAdd{space} a b (generator point),
  scalar := \fun (a, b: R) => #scalarAssoc{space} a b (generator point),
};
\definition backward: Backward.Map := Augmentation.extension (\fun (x: Generators) => #one{ring});
\definition onOne: #apply{forward} #one{ring} = generator point := #scalarOne{space} (generator point);
\definition leftInverse: \forall (a: R) -> #apply{backward} (#apply{forward} a) = a :=
  \fun (a: R) => trans!{R} _ _ _ (#scalar{backward} a (generator point))
    (trans!{R} _ _ _
      (congr!{R R} (#mul{ring} a) _ _ (Augmentation.onGenerator (\fun (x: Generators) => #one{ring}) point))
      (#rightIdentity{(#multiplicative{(#semiring{ring})})} a));
\import Forward.Composition[U := Carrier, domain := space] \as Composition;
\import \parent.\parent.End[V := Carrier, space := space] \as End;
\import \parent.\parent.Hom[V := Carrier, W := Carrier, source := space, target := space] \as EndMaps;
\import \parent.To[W := Carrier, target := space] \as Linear;
\definition composite: Unique -> Composition.compose forward backward = End.identity :=
  \fun (unique: Unique) => Linear.ext (Composition.compose forward backward) End.identity
    (\fun (x: Generators) => trans!{Carrier} _ _ _
      (congr!{R Carrier} (#apply{forward}) _ _ (Augmentation.onGenerator (\fun (x: Generators) => #one{ring}) x))
      (trans!{Carrier} _ _ _ onOne (congr!{Generators Carrier} generator _ _ (sym!{Generators} _ _ (unique x)))));
\definition rightInverse: Unique -> \forall (x: Carrier) -> #apply{forward} (#apply{backward} x) = x :=
  \fun (unique: Unique)(x: Carrier) => congr!{EndMaps.Map Carrier} (\fun (f: EndMaps.Map) => #apply{f} x) _ _ (composite unique);
\import \parent.\parent.Isomorphism[V := R, W := Carrier, source := scalarModule, target := space] \as Iso;
\definition isomorphism(unique: Unique): Iso.Isomorphism := Iso.Isomorphism {
  forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse unique,
};
