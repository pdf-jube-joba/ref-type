\import \parent.\parent.\parent.Hom[V := Carrier, W := W, source := space, target := target] \as Maps;
\import \parent.\parent.\parent.Of[V := W, space := target].Submodule[] \as TargetSubmodules;
\import Free.Induction[] \as Induction;
\import \parent.\parent.\parent.Hom[V := Free.Carrier, W := Carrier, source := Free.space, target := space] \as InclusionMaps;
\use Equality.transport;
\definition law: \forall (f: Maps.Map)(T: TargetSubmodules.Submodule) ->
  (\forall (s: Selected) -> TargetSubmodules.Member T ((f).apply (generator s))) ->
  \forall (x: Carrier) -> Member x -> TargetSubmodules.Member T ((f).apply x) :=
  \fun (f: Maps.Map)(T: TargetSubmodules.Submodule)(generators: \forall (s: Selected) -> TargetSubmodules.Member T ((f).apply (generator s)))(x: Carrier)(member: Member x) =>
    Image.eliminate inclusion x (TargetSubmodules.Member T ((f).apply x))
      (\fun (y: Free.Carrier)(same: (inclusion).apply y = x) => transport!{Carrier} (\fun (z: Carrier) => TargetSubmodules.Member T ((f).apply z)) _ _ same
        (Induction.law (\fun (z: Free.Carrier) => TargetSubmodules.Member T ((f).apply ((inclusion).apply z)))
          (transport!{W} (\fun (v: W) => TargetSubmodules.Member T v) _ _
            (sym!{W} _ _ (trans!{W} _ _ _ (congr!{Carrier W} ((f).apply) _ _ (InclusionMaps.zeroPreserved inclusion)) (Maps.zeroPreserved f))) ((T).zero))
          (\fun (s: Selected) => transport!{W} (\fun (v: W) => TargetSubmodules.Member T v) _ _ (sym!{W} _ _ (congr!{Carrier W} ((f).apply) _ _ (onGenerator s))) (generators s))
          (\fun (a, b: Free.Carrier)(left: _)(right: _) => transport!{W} (\fun (v: W) => TargetSubmodules.Member T v) _ _
            (sym!{W} _ _ (trans!{W} _ _ _ (congr!{Carrier W} ((f).apply) _ _ ((inclusion).addition a b)) ((f).addition _ _))) ((T).addition _ _ left right))
          (\fun (a: Free.Carrier)(previous: _) => transport!{W} (\fun (v: W) => TargetSubmodules.Member T v) _ _
            (sym!{W} _ _ (trans!{W} _ _ _ (congr!{Carrier W} ((f).apply) _ _ (InclusionMaps.negativePreserved inclusion a)) (Maps.negativePreserved f _))) (TargetSubmodules.negativeClosed T _ previous))
          (\fun (r: R)(a: Free.Carrier)(previous: _) => transport!{W} (\fun (v: W) => TargetSubmodules.Member T v) _ _
            (sym!{W} _ _ (trans!{W} _ _ _ (congr!{Carrier W} ((f).apply) _ _ ((inclusion).scalar r a)) ((f).scalar r _))) ((T).scalar r _ previous)) y)) member;
