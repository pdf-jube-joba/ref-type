\import \parent.\parent.\parent.Free[Generators := Generators] \as Ambient;
\definition Carrier: \Set := Free.Carrier;
\definition space: Space Carrier := Free.space;
\definition generator: Selected -> Carrier := Free.generator;
\import Reindex.Injection[f := inclusionFunction] \as Injection;
\definition injective: Injection.Injective := \fun (x, y: Selected)(same: inclusionFunction x = inclusionFunction y) => same;
\import Injection.Retraction[] \as Native;
\definition map: \parent.\parent.\parent.Hom[V := Ambient.Carrier, W := Carrier, source := Ambient.space, target := space].Map := Native.retraction injective;
\definition onSelected: \forall (s: Selected) -> #apply{map} (Ambient.generator s) = generator s := Native.generatorLaw injective;
\definition emptyFiber: \forall (s: Generators) -> Logic.Not (\In[Generators] S s) -> Logic.Not (\exists Native.Fiber s) := \block {
  \fun (s: Generators)(outside: Logic.Not (\In[Generators] S s))(exists: \exists Native.Fiber s) \then
  \takefrom t: Native.Fiber s \by exists \then
  \return outside (\idelim inclusionFunction t = s \with u: Generators => \In[Generators] S u \by {
    base: \bysub(Generators, S, t), equality: \bysub(Selected, Native.Fiber s, t)
  })
};
\definition outside: \forall (s: Generators) -> Logic.Not (\In[Generators] S s) -> #apply{map} (Ambient.generator s) = #zero{space} :=
  \fun (s: Generators)(outside: Logic.Not (\In[Generators] S s)) => Native.generatorOutside injective s (emptyFiber s outside);
\import \parent.\parent.\parent.Hom[V := Carrier, W := Carrier, source := space, target := space] \as End;
\definition leftInverse: \forall (x: Carrier) -> #apply{map} (#apply{inclusion} x) = x :=
  \fun (x: Carrier) => congr!{End.Map Carrier} (\fun (f: End.Map) => #apply{f} x) _ _ (Native.leftInverse injective);
