\import \parent.\parent.Induction[] \as Induction;
\import \parent.\parent.\parent.Hom[V := Carrier, W := W, source := space, target := target] \as Maps;
\import \parent.\parent.\parent.Of[V := W, space := target].Submodule[] \as Submodules;
\use Equality.transport;
\definition law: \forall (f: Maps.Map)(T: Submodules.Submodule) ->
  (\forall (s: Generators) -> Submodules.Member T ((f).apply (generator s))) -> \forall (x: Carrier) -> Submodules.Member T ((f).apply x) :=
  \fun (f: Maps.Map)(T: Submodules.Submodule)(generators: \forall (s: Generators) -> Submodules.Member T ((f).apply (generator s))) =>
    Induction.law (\fun (x: Carrier) => Submodules.Member T ((f).apply x))
      (transport!{W} (\fun (y: W) => Submodules.Member T y) _ _ (sym!{W} _ _ (Maps.zeroPreserved f)) ((T).zero)) generators
      (\fun (x, y: Carrier)(left: _)(right: _) => transport!{W} (\fun (z: W) => Submodules.Member T z) _ _ (sym!{W} _ _ ((f).addition x y)) ((T).addition _ _ left right))
      (\fun (x: Carrier)(previous: _) => transport!{W} (\fun (y: W) => Submodules.Member T y) _ _ (sym!{W} _ _ (Maps.negativePreserved f x)) (Submodules.negativeClosed T _ previous))
      (\fun (a: R)(x: Carrier)(previous: _) => transport!{W} (\fun (y: W) => Submodules.Member T y) _ _ (sym!{W} _ _ ((f).scalar a x)) ((T).scalar a _ previous));
