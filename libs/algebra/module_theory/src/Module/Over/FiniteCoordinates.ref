\use std.Logic[].Equality[].eq_reason_in;
\import std.Data[].FinSet[] \as Finite;
\import Finite.Enumeration[] \as Enumeration;
\import std.Data[].Nat[] \as N;
\definition Index: \Set := Finite.Fin n;
\import \parent.Coordinates[I := Index] \as Coordinates;
\import Coordinates.Kronecker[] \as Kronecker;
\import \parent.Sums[I := Index] \as Sums;
\import Sums.Single[] \as Single;
\definition Carrier: \Set := Coordinates.Vector;
\definition space: Space Carrier := Coordinates.space;
\definition basis[i: Index]: Carrier := \fun (j: Index) => Kronecker.delta j i;
\import std.Data[].List[] \as Lists;
\definition indices: Lists.List[Index] := Finite.elements n;
\definition distinct: Sums.Distinct indices := Enumeration.distinct n;
\definition covers: \forall (i: Index) -> \In[Index] (Sums.keys indices) i := Finite.exhaustive n;
\import Sums.Vector[V := Carrier, space := space] \as VectorSum;
\import \parent.Hom[V := Carrier, W := R, source := space, target := scalarModule] \as Evaluation;
\definition evaluation[i: Index]: Evaluation.Map := Evaluation.Map {
  apply := \fun (v: Carrier) => v i,
  addition := \fun (v, w: Carrier) => \refl(ring.add (v i) (w i)),
  scalar := \fun (a: R)(v: Carrier) => \refl(ring.mul a (v i)),
};
\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\definition central: \forall (i, j: Index)(a: R) -> ring.mul a (Kronecker.delta i j) = ring.mul (Kronecker.delta i j) a := Kronecker.central;
\module At(i: Index) {
  \import VectorSum.Mapping[W := R, target := scalarModule] \as Mapping;
  \import Sums.Prop[] \as SumLaws;
  \definition law: \forall (v: Carrier) -> VectorSum.sum indices (\fun (j: Index) => space.smul (v j) (basis j)) i = v i :=
    \fun (v: Carrier) => eq_reason_in!{R _
      "=" _ "by" { Mapping.law (evaluation i) indices (\fun (j: Index) => space.smul (v j) (basis j)) }
      "=" _ "by" { SumLaws.congruent indices (\fun (j: Index) => ring.mul (v j) (Kronecker.delta i j))
          (\fun (j: Index) => ring.mul (Kronecker.delta i j) (v j)) (\fun (j: Index) => central i j (v j)) }
      "=" _ "by" { Single.extract indices distinct i (covers i) v }
    };
}
\definition decomposition: \forall (v: Carrier) -> VectorSum.sum indices (\fun (j: Index) => space.smul (v j) (basis j)) = v :=
  \fun (v: Carrier) => \axiom:funext(VectorSum.sum indices (\fun (j: Index) => space.smul (v j) (basis j)), v,
    \fun (i: Index) => At[i := i].law v);
\module Free;
\module Split;
\module Tail(start: N.Nat^);

\module Head(rank: N.Nat^);
