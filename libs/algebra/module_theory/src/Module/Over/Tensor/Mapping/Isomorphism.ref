\import Target.Mapping[U := V, Z := W, targetLeft := left, targetRight := right] \as Reverse;
\definition forward: Maps.Map := map (leftIso.forward) (rightIso.forward);
\import \parent.\parent.\parent.Hom[V := Target.Carrier, W := Carrier, source := Target.space, target := space] \as BackwardMaps;
\definition backward: BackwardMaps.Map := Reverse.map (leftIso.backward) (rightIso.backward);
\import \parent.\parent.\parent.Hom[V := Target.Carrier, W := Carrier, source := Target.space, target := space].Composition[U := Carrier, domain := space] \as LeftCompose;
\import \parent.\parent.\parent.Hom[V := Carrier, W := Target.Carrier, source := space, target := Target.space].Composition[U := Target.Carrier, domain := Target.space] \as RightCompose;
\import \parent.\parent.\parent.End[V := Carrier, space := space] \as SourceIdentity;
\import \parent.\parent.\parent.End[V := Target.Carrier, space := Target.space] \as TargetIdentity;
\import \parent.\parent.Universal[U := Carrier, target := space] \as LeftEquality;
\import Target.Universal[U := Target.Carrier, target := Target.space] \as RightEquality;
\definition leftLaw: LeftCompose.compose backward forward = SourceIdentity.identity :=
  LeftEquality.ext (LeftCompose.compose backward forward) SourceIdentity.identity (\fun (x: V)(y: W) => trans!{Carrier} _ _ _
    (congr!{Target.Carrier Carrier} (backward.apply) _ _ (onTensor (leftIso.forward) (rightIso.forward) x y))
    (trans!{Carrier} _ _ _ (Reverse.onTensor (leftIso.backward) (rightIso.backward) (leftIso.forward.apply x) (rightIso.forward.apply y))
      (congr2!{V W Carrier} tensor _ _ _ _ (leftIso.leftInverse x) (rightIso.leftInverse y))));
\definition rightLaw: RightCompose.compose forward backward = TargetIdentity.identity :=
  RightEquality.ext (RightCompose.compose forward backward) TargetIdentity.identity (\fun (x: U)(y: Z) => trans!{Target.Carrier} _ _ _
    (congr!{Carrier Target.Carrier} (forward.apply) _ _ (Reverse.onTensor (leftIso.backward) (rightIso.backward) x y))
    (trans!{Target.Carrier} _ _ _ (onTensor (leftIso.forward) (rightIso.forward) (leftIso.backward.apply x) (rightIso.backward.apply y))
      (congr2!{U Z Target.Carrier} Target.tensor _ _ _ _ (leftIso.rightInverse x) (rightIso.rightInverse y))));
\import \parent.\parent.\parent.Hom[V := Carrier, W := Carrier, source := space, target := space] \as SourceEnd;
\import \parent.\parent.\parent.Hom[V := Target.Carrier, W := Target.Carrier, source := Target.space, target := Target.space] \as TargetEnd;
\definition leftInverse: \forall (x: Carrier) -> backward.apply (forward.apply x) = x :=
  \fun (x: Carrier) => congr!{SourceEnd.Map Carrier} (\fun (f: SourceEnd.Map) => f.apply x) _ _ leftLaw;
\definition rightInverse: \forall (x: Target.Carrier) -> forward.apply (backward.apply x) = x :=
  \fun (x: Target.Carrier) => congr!{TargetEnd.Map Target.Carrier} (\fun (f: TargetEnd.Map) => f.apply x) _ _ rightLaw;
\import \parent.\parent.\parent.Isomorphism[V := Carrier, W := Target.Carrier, source := space, target := Target.space] \as Iso;
\definition isomorphism: Iso.Isomorphism := Iso.Isomorphism { forward := forward, backward := backward, leftInverse := leftInverse, rightInverse := rightInverse };
