\use std.Logic[].Equality[].eq_reason_in;
\definition Onto: \Prop := \forall (y: B.Carrier) -> \exists ( x: A.Carrier \where q.apply x = y );
\definition KillsKernel: \Prop := \forall (x: A.Carrier) -> q.apply x = Middle.zero -> f.apply x = Target.zero;
\definition sameFiber: KillsKernel -> \forall (x, z: A.Carrier) -> q.apply x = q.apply z -> f.apply x = f.apply z :=
  \fun (kills: KillsKernel)(x, z: A.Carrier)(equal: q.apply x = q.apply z) =>
    Group.cancelRight (Target.neg (f.apply z)) (f.apply x) (f.apply z)
      (eq_reason_in!{U.Carrier _
        "=" _ "by" { sym!{U.Carrier} _ _ (Input.differencePreserved f x z) }
        "=" _ "by" { kills (Source.add x (Source.neg z))
            (eq_reason_in!{B.Carrier _
              "=" _ "by" { Maps.differencePreserved q x z }
              "=" _ "by" { congr!{B.Carrier B.Carrier} (\fun (b: B.Carrier) => MiddleGroup.difference b (q.apply z)) _ _ equal }
              "=" _ "by" { MiddleGroup.inverseRight (q.apply z) }
            }) }
        "=" _ "by" { sym!{U.Carrier} _ _ (Group.inverseRight (f.apply z)) }
      });
\definition Values[y: B.Carrier]: \Pow U.Carrier :=
  { u: U.Carrier \where \exists ( x: A.Carrier \where Logic.And[q.apply x = y, f.apply x = u] ) };
\definition Value[y: B.Carrier]: \Set := \Cast[U.Carrier] (Values y);
\definition witness[x: A.Carrier]: Value (q.apply x) :=
  \into[U.Carrier](f.apply x, Values (q.apply x)) \by {
    Logic.existsIntro[A.Carrier, { z: A.Carrier \where Logic.And[q.apply z = q.apply x, f.apply z = f.apply x] }] x
    (Logic.And[_, _]::# (\refl(q.apply x)) (\refl(f.apply x)))
  };
\definition existence: Onto -> \forall (y: B.Carrier) -> \exists Value y := \block {
  \fun (onto: Onto)(y: B.Carrier) \then
  \takefrom x: \Cast[A.Carrier] ({ x: A.Carrier \where q.apply x = y }) \by onto y \then
  \return \idelim q.apply x = y \with b: B.Carrier => \exists Value b \by {
    base: \exact(witness x, Value (q.apply x)), equality: \bysub(A.Carrier, { x: A.Carrier \where q.apply x = y }, x)
  }
};
\definition uniqueness: KillsKernel -> \forall (y: B.Carrier)(u, v: Value y) -> u = v := \block {
  \fun (kills: KillsKernel)(y: B.Carrier)(u, v: Value y) \then
  \takefrom x: \Cast[A.Carrier] ({ x: A.Carrier \where Logic.And[q.apply x = y, f.apply x = u] }) \by \bysub(U.Carrier, Values y, u) \then
  \takefrom z: \Cast[A.Carrier] ({ z: A.Carrier \where Logic.And[q.apply z = y, f.apply z = v] }) \by \bysub(U.Carrier, Values y, v) \then
  \let first: Logic.And[q.apply x = y, f.apply x = u] := \bysub(A.Carrier, { x: A.Carrier \where Logic.And[q.apply x = y, f.apply x = u] }, x) \then
  \let second: Logic.And[q.apply z = y, f.apply z = v] := \bysub(A.Carrier, { z: A.Carrier \where Logic.And[q.apply z = y, f.apply z = v] }, z) \then
  \return eq_reason_in!{U.Carrier _
    "=" _ "by" { sym!{U.Carrier} _ _ (first.right) }
    "=" _ "by" { sameFiber kills x z (trans!{B.Carrier} _ _ _ (first.left) (sym!{B.Carrier} _ _ (second.left))) }
    "=" _ "by" second.right
  }
};
\definition value[onto: Onto][kills: KillsKernel][y: B.Carrier]: U.Carrier :=
  \choice Value y \by { existence: existence onto y, uniqueness: uniqueness kills y };
\definition onImage: \forall (onto: Onto)(kills: KillsKernel)(x: A.Carrier) -> value onto kills (q.apply x) = f.apply x :=
  \fun (onto: Onto)(kills: KillsKernel)(x: A.Carrier) => sym!{U.Carrier} _ _
    (\choiceeq witness x \of Value (q.apply x) \by { existence: existence onto (q.apply x), uniqueness: uniqueness kills (q.apply x) });
\definition addition: \forall (onto: Onto)(kills: KillsKernel)(y, z: B.Carrier) ->
  value onto kills (Middle.add y z) = Target.add (value onto kills y) (value onto kills z) := \block {
  \fun (onto: Onto)(kills: KillsKernel)(y, z: B.Carrier) \then
  \takefrom x: \Cast[A.Carrier] ({ x: A.Carrier \where q.apply x = y }) \by onto y \then
  \takefrom w: \Cast[A.Carrier] ({ w: A.Carrier \where q.apply w = z }) \by onto z \then
  \let ex: q.apply x = y := \bysub(A.Carrier, { x: A.Carrier \where q.apply x = y }, x) \then
  \let ew: q.apply w = z := \bysub(A.Carrier, { w: A.Carrier \where q.apply w = z }, w) \then
  \return eq_reason!{{value onto kills (Middle.add y z)}
    "=" {value onto kills (q.apply (Source.add x w))}
    "by" {congr!{B.Carrier U.Carrier} (value onto kills) _ _ (sym!{B.Carrier} _ _ (trans!{B.Carrier} _ _ _ (q.addition x w) (congr!{B.Carrier B.Carrier B.Carrier} Middle.add _ _ _ _ ex ew)))}
    "=" {f.apply (Source.add x w)} "by" {onImage onto kills (Source.add x w)}
    "=" {Target.add (f.apply x) (f.apply w)} "by" {f.addition x w}
    "=" {Target.add (value onto kills y) (value onto kills z)}
    "by" {congr!{U.Carrier U.Carrier U.Carrier} Target.add _ _ _ _
      (trans!{U.Carrier} _ _ _ (sym!{U.Carrier} _ _ (onImage onto kills x)) (congr!{B.Carrier U.Carrier} (value onto kills) _ _ ex))
      (trans!{U.Carrier} _ _ _ (sym!{U.Carrier} _ _ (onImage onto kills w)) (congr!{B.Carrier U.Carrier} (value onto kills) _ _ ew))}}
};
\definition scalar: \forall (onto: Onto)(kills: KillsKernel)(a: R)(y: B.Carrier) ->
  value onto kills (Middle.scale a y) = Target.scale a (value onto kills y) := \block {
  \fun (onto: Onto)(kills: KillsKernel)(a: R)(y: B.Carrier) \then
  \takefrom x: \Cast[A.Carrier] ({ x: A.Carrier \where q.apply x = y }) \by onto y \then
  \let ex: q.apply x = y := \bysub(A.Carrier, { x: A.Carrier \where q.apply x = y }, x) \then
  \return eq_reason!{{value onto kills (Middle.scale a y)}
    "=" {value onto kills (q.apply (Source.scale a x))}
    "by" {congr!{B.Carrier U.Carrier} (value onto kills) _ _ (sym!{B.Carrier} _ _ (trans!{B.Carrier} _ _ _ (q.scalar a x) (congr!{B.Carrier B.Carrier} (Middle.scale a) _ _ ex)))}
    "=" {f.apply (Source.scale a x)} "by" {onImage onto kills (Source.scale a x)}
    "=" {Target.scale a (f.apply x)} "by" {f.scalar a x}
    "=" {Target.scale a (value onto kills y)} "by" {congr!{U.Carrier U.Carrier} (Target.scale a) _ _
      (trans!{U.Carrier} _ _ _ (sym!{U.Carrier} _ _ (onImage onto kills x)) (congr!{B.Carrier U.Carrier} (value onto kills) _ _ ex))}}
};
\definition map[onto: Onto][kills: KillsKernel]: Output.Map := Output.Map {
  apply := \fun (y: B.Carrier) => value onto kills y, addition := addition onto kills, scalar := scalar onto kills,
};
\definition unique: \forall (onto: Onto)(kills: KillsKernel)(h: Output.Map) ->
  (\forall (x: A.Carrier) -> h.apply (q.apply x) = f.apply x) -> h = map onto kills :=
  \fun (onto: Onto)(kills: KillsKernel)(h: Output.Map)(agrees: \forall (x: A.Carrier) -> h.apply (q.apply x) = f.apply x) =>
    Output.ext h (map onto kills) (\block {
      \fun (y: B.Carrier) \then
      \takefrom x: \Cast[A.Carrier] ({ x: A.Carrier \where q.apply x = y }) \by onto y \then
      \let ex: q.apply x = y := \bysub(A.Carrier, { x: A.Carrier \where q.apply x = y }, x) \then
      \return eq_reason_in!{U.Carrier _
        "=" _ "by" { congr!{B.Carrier U.Carrier} (h.apply) _ _ (sym!{B.Carrier} _ _ ex) }
        "=" _ "by" { agrees x }
        "=" _ "by" { sym!{U.Carrier} _ _ (onImage onto kills x) }
        "=" _ "by" { congr!{B.Carrier U.Carrier} (value onto kills) _ _ ex }
      }
    });
