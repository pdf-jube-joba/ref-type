\import std.Alg[].Monoid[] \as Monoid;
\definition one: R := ring.one;
\definition mul: R -> R -> R := ring.mul;
\definition add: R -> R -> R := ring.add;
\import std.Data[].Pair[] \as Pair;
\import Pair.Prop[A := V, B := W] \as Pairs;
\import \parent.Laws[V := V, space := left] \as Left;
\import \parent.Laws[V := W, space := right] \as Right;
\import algebra.Group[].Of[Carrier := V, group := Left.additive] \as LeftGroup;
\import algebra.Group[].Of[Carrier := W, group := Right.additive] \as RightGroup;
\definition Carrier: \Set := Pair.Times^[V, W];
\definition make: V -> W -> Carrier := Pair.pair V W;
\definition first: Carrier -> V := Pair.first V W;
\definition second: Carrier -> W := Pair.second V W;
\definition origin: Carrier := make (left.zero) (right.zero);
\definition plus(x, y: Carrier): Carrier := make (left.add (first x) (first y)) (right.add (second x) (second y));
\definition negative(x: Carrier): Carrier := make (left.neg (first x)) (right.neg (second x));
\definition scale(a: R) (x: Carrier): Carrier := make (left.smul a (first x)) (right.smul a (second x));
\definition space: Space Carrier := Ring.RingModule[R, Carrier, ring] {
  zero := origin, add := plus, neg := negative, smul := scale,
  additive := Alg.CommutativeGroupLaws[Carrier, Alg.CommutativeGroupData[Carrier]::# (Alg.GroupData[Carrier]::# origin plus negative)] {
    group := Alg.GroupLaws[Carrier, Alg.GroupData[Carrier]::# origin plus negative] {
      monoid := Monoid.MonoidLaws[Carrier, Monoid.MonoidData[Carrier]::# origin plus] {
        leftIdentity := \fun (x: Carrier) => Pairs.ext (plus origin x) x (LeftGroup.zeroLeft (first x)) (RightGroup.zeroLeft (second x)),
        rightIdentity := \fun (x: Carrier) => Pairs.ext (plus x origin) x (LeftGroup.zeroRight (first x)) (RightGroup.zeroRight (second x)),
        associative := \fun (x, y, z: Carrier) => Pairs.ext (plus (plus x y) z) (plus x (plus y z))
          (LeftGroup.assoc (first x) (first y) (first z)) (RightGroup.assoc (second x) (second y) (second z)),
      },
      leftInverse := \fun (x: Carrier) => Pairs.ext (plus (negative x) x) origin (LeftGroup.inverseLeft (first x)) (RightGroup.inverseLeft (second x)),
      rightInverse := \fun (x: Carrier) => Pairs.ext (plus x (negative x)) origin
        (trans!{V} _ _ _ (LeftGroup.comm (first x) (Left.neg (first x))) (LeftGroup.inverseLeft (first x)))
        (trans!{W} _ _ _ (RightGroup.comm (second x) (Right.neg (second x))) (RightGroup.inverseLeft (second x))),
    },
    commutative := \fun (x, y: Carrier) => Pairs.ext (plus x y) (plus y x)
      (LeftGroup.comm (first x) (first y)) (RightGroup.comm (second x) (second y)),
  },
  scalarOne := \fun (x: Carrier) => Pairs.ext (scale one x) x (left.scalarOne (first x)) (right.scalarOne (second x)),
  scalarAssoc := \fun (a, b: R) (x: Carrier) => Pairs.ext (scale (mul a b) x) (scale a (scale b x)) (left.scalarAssoc a b (first x)) (right.scalarAssoc a b (second x)),
  scalarAdd := \fun (a, b: R) (x: Carrier) => Pairs.ext (scale (add a b) x) (plus (scale a x) (scale b x)) (left.scalarAdd a b (first x)) (right.scalarAdd a b (second x)),
  vectorAdd := \fun (a: R) (x, y: Carrier) => Pairs.ext (scale a (plus x y)) (plus (scale a x) (scale a y)) (left.vectorAdd a (first x) (first y)) (right.vectorAdd a (second x) (second y)),
};
\module Universal(U: \Set, domain: Space U);
\import \parent.Hom[V := Carrier, W := V, source := space, target := left] \as FirstProjection;
\import \parent.Hom[V := Carrier, W := W, source := space, target := right] \as SecondProjection;
\definition firstProjection: FirstProjection.Map := FirstProjection.Map {
  apply := first,
  addition := \fun (x, y: Carrier) => \refl(left.add (first x) (first y)),
  scalar := \fun (a: R)(x: Carrier) => \refl(left.smul a (first x)),
};
\definition secondProjection: SecondProjection.Map := SecondProjection.Map {
  apply := second,
  addition := \fun (x, y: Carrier) => \refl(right.add (second x) (second y)),
  scalar := \fun (a: R)(x: Carrier) => \refl(right.smul a (second x)),
};
\import \parent.Hom[V := V, W := Carrier, source := left, target := space] \as FirstInjection;
\import \parent.Hom[V := W, W := Carrier, source := right, target := space] \as SecondInjection;
\definition firstInjection: FirstInjection.Map := FirstInjection.Map {
  apply := \fun (x: V) => make x right.zero,
  addition := \fun (x, y: V) => Pairs.ext _ _ (\refl(left.add x y)) (sym!{W} _ _ (RightGroup.zeroLeft right.zero)),
  scalar := \fun (a: R)(x: V) => Pairs.ext _ _ (\refl(left.smul a x)) (sym!{W} _ _ (Right.scaleZero a)),
};
\definition secondInjection: SecondInjection.Map := SecondInjection.Map {
  apply := \fun (y: W) => make left.zero y,
  addition := \fun (x, y: W) => Pairs.ext _ _ (sym!{V} _ _ (LeftGroup.zeroLeft left.zero)) (\refl(right.add x y)),
  scalar := \fun (a: R)(x: W) => Pairs.ext _ _ (sym!{V} _ _ (Left.scaleZero a)) (\refl(right.smul a x)),
};
\definition firstRoundtrip: \forall (x: V) -> firstProjection.apply (firstInjection.apply x) = x := \fun (x: V) => \refl(x);
\definition secondRoundtrip: \forall (x: W) -> secondProjection.apply (secondInjection.apply x) = x := \fun (x: W) => \refl(x);
\definition reconstruction: \forall (x: Carrier) -> plus (firstInjection.apply (first x)) (secondInjection.apply (second x)) = x :=
  \fun (x: Carrier) => Pairs.ext _ _ (LeftGroup.zeroRight (first x)) (RightGroup.zeroLeft (second x));
\module Copair(U: \Set, target: Space U);
