\definition sourceZero[e: Isomorphism][targetZero: \forall (y: W) -> y = (target).zero]: \forall (x: V) -> x = (source).zero :=
  \fun (x: V) => trans!{V} _ _ _ (sym!{V} _ _ ((e).leftInverse x))
    (trans!{V} _ _ _ (congr!{W V} (((e).backward).apply) _ _ (targetZero (((e).forward).apply x)))
      (Backward.zeroPreserved (e).backward));
\definition targetZero[e: Isomorphism][sourceZero: \forall (x: V) -> x = (source).zero]: \forall (y: W) -> y = (target).zero :=
  \fun (y: W) => trans!{W} _ _ _ (sym!{W} _ _ ((e).rightInverse y))
    (trans!{W} _ _ _ (congr!{V W} (((e).forward).apply) _ _ (sourceZero (((e).backward).apply y)))
      (Forward.zeroPreserved (e).forward));
