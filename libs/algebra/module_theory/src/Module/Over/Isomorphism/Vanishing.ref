\definition sourceZero(e: Isomorphism)(targetZero: \forall (y: W) -> y = #zero{target}): \forall (x: V) -> x = #zero{source} :=
  \fun (x: V) => trans!{V} _ _ _ (sym!{V} _ _ (#leftInverse{e} x))
    (trans!{V} _ _ _ (congr!{W V} (#apply{#backward{e}}) _ _ (targetZero (#apply{#forward{e}} x)))
      (Backward.zeroPreserved #backward{e}));
\definition targetZero(e: Isomorphism)(sourceZero: \forall (x: V) -> x = #zero{source}): \forall (y: W) -> y = #zero{target} :=
  \fun (y: W) => trans!{W} _ _ _ (sym!{W} _ _ (#rightInverse{e} y))
    (trans!{W} _ _ _ (congr!{V W} (#apply{#forward{e}}) _ _ (sourceZero (#apply{#backward{e}} y)))
      (Forward.zeroPreserved #forward{e}));
