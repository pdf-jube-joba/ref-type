\use std.Logic[].Equality[].eq_reason_in;
\definition sourceZero[e: Isomorphism][targetZero: \forall (y: W) -> y = (target).zero]: \forall (x: V) -> x = (source).zero :=
  \fun (x: V) => eq_reason_in!{V _
    "=" _ "by" { sym!{V} _ _ ((e).leftInverse x) }
    "=" _ "by" { congr!{W V} (((e).backward).apply) _ _ (targetZero (((e).forward).apply x)) }
    "=" _ "by" { Backward.zeroPreserved (e).backward }
  };
\definition targetZero[e: Isomorphism][sourceZero: \forall (x: V) -> x = (source).zero]: \forall (y: W) -> y = (target).zero :=
  \fun (y: W) => eq_reason_in!{W _
    "=" _ "by" { sym!{W} _ _ ((e).rightInverse y) }
    "=" _ "by" { congr!{V W} (((e).forward).apply) _ _ (sourceZero (((e).backward).apply y)) }
    "=" _ "by" { Forward.zeroPreserved (e).forward }
  };
