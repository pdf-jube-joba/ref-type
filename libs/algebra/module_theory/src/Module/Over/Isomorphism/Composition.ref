\import \parent.\parent.Isomorphism[V := W, W := U, source := target, target := final] \as After;
\import \parent.\parent.Isomorphism[V := V, W := U, source := source, target := final] \as Result;
\import \parent.\parent.Hom[V := W, W := U, source := target, target := final].Composition[U := V, domain := source] \as ForwardComposition;
\import \parent.\parent.Hom[V := W, W := V, source := target, target := source].Composition[U := U, domain := final] \as BackwardComposition;
\definition compose[g: After.Isomorphism][f: Isomorphism]: Result.Isomorphism := Result.Isomorphism {
  forward := ForwardComposition.compose (g.forward) (f.forward),
  backward := BackwardComposition.compose (f.backward) (g.backward),
  leftInverse := \fun (x: V) => trans!{V} _ _ _
    (congr!{W V} (f.backward.apply) _ _ (g.leftInverse (f.forward.apply x))) (f.leftInverse x),
  rightInverse := \fun (x: U) => trans!{U} _ _ _
    (congr!{W U} (g.forward.apply) _ _ (f.rightInverse (g.backward.apply x))) (g.rightInverse x),
};
