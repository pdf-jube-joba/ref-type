\import std.Alg[].Monoid[] \as Monoid;
\definition Carrier: \Set := \forall (i: Index) -> family.Carrier i;
\definition zero: Carrier := \fun (i: Index) => (family.space i).zero;
\definition add(f, g: Carrier): Carrier := \fun (i: Index) => (family.space i).add (f i) (g i);
\definition neg(f: Carrier): Carrier := \fun (i: Index) => (family.space i).neg (f i);
\definition scale(a: R)(f: Carrier): Carrier := \fun (i: Index) => (family.space i).smul a (f i);
\definition ext: \forall (f, g: Carrier) -> (\forall (i: Index) -> f i = g i) -> f = g :=
  \fun (f, g: Carrier)(same: _) => \axiom:funext(f, g, same);
\module At(i: Index) {
  \import \parent.\parent.Laws[V := family.Carrier i, space := family.space i] \as Laws;
  \import algebra.Group[].Of[Carrier := family.Carrier i, group := Laws.additive] \as Group;
  \definition leftIdentity: \forall (x: family.Carrier i) -> (family.space i).add (family.space i).zero x = x := Group.zeroLeft;
  \definition rightIdentity: \forall (x: family.Carrier i) -> (family.space i).add x (family.space i).zero = x := Group.zeroRight;
  \definition associative: \forall (x, y, z: family.Carrier i) -> (family.space i).add ((family.space i).add x y) z = (family.space i).add x ((family.space i).add y z) := Group.assoc;
}
\definition space: Space Carrier := Ring.RingModule[R, Carrier, ring] {
  zero := zero, add := add, neg := neg, smul := scale,
  additive := Alg.CommutativeGroupLaws[Carrier, Alg.CommutativeGroupData[Carrier]::# (Alg.GroupData[Carrier]::# zero add neg)] {
    group := Alg.GroupLaws[Carrier, Alg.GroupData[Carrier]::# zero add neg] {
      monoid := Monoid.MonoidLaws[Carrier, Monoid.MonoidData[Carrier]::# zero add] {
        leftIdentity := \fun (f: Carrier) => ext (add zero f) f (\fun (i: Index) => At[i := i].leftIdentity (f i)),
        rightIdentity := \fun (f: Carrier) => ext (add f zero) f (\fun (i: Index) => At[i := i].rightIdentity (f i)),
        associative := \fun (f, g, h: Carrier) => ext (add (add f g) h) (add f (add g h)) (\fun (i: Index) => At[i := i].associative (f i) (g i) (h i)),
      },
      leftInverse := \fun (f: Carrier) => ext (add (neg f) f) zero (\fun (i: Index) => (((family.space i).additive).group).leftInverse (f i)),
      rightInverse := \fun (f: Carrier) => ext (add f (neg f)) zero (\fun (i: Index) => (((family.space i).additive).group).rightInverse (f i)),
    },
    commutative := \fun (f, g: Carrier) => ext (add f g) (add g f) (\fun (i: Index) => ((family.space i).additive).commutative (f i) (g i)),
  },
  scalarOne := \fun (f: Carrier) => ext (scale (ring.one) f) f (\fun (i: Index) => (family.space i).scalarOne (f i)),
  scalarAssoc := \fun (a, b: R)(f: Carrier) => ext (scale (ring.mul a b) f) (scale a (scale b f)) (\fun (i: Index) => (family.space i).scalarAssoc a b (f i)),
  scalarAdd := \fun (a, b: R)(f: Carrier) => ext (scale (ring.add a b) f) (add (scale a f) (scale b f)) (\fun (i: Index) => (family.space i).scalarAdd a b (f i)),
  vectorAdd := \fun (a: R)(f, g: Carrier) => ext (scale a (add f g)) (add (scale a f) (scale a g)) (\fun (i: Index) => (family.space i).vectorAdd a (f i) (g i)),
};
\module Projection(i: Index) {
  \import \parent.\parent.Hom[V := Carrier, W := family.Carrier i, source := space, target := family.space i] \as Maps;
  \definition map: Maps.Map := Maps.Map {
    apply := \fun (f: Carrier) => f i,
    addition := \fun (f, g: Carrier) => \refl((family.space i).add (f i) (g i)),
    scalar := \fun (a: R)(f: Carrier) => \refl((family.space i).smul a (f i)),
  };
}
\module Single(point: Index);
