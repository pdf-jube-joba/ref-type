\import \parent.RightExact[A := A, B := B, C := C] \as Exact;
\import \parent.Tensor[V := A.Carrier, W := N.Carrier, left := A.space, right := N.space] \as Left;
\import \parent.Tensor[V := B.Carrier, W := N.Carrier, left := B.space, right := N.space] \as Middle;
\import \parent.Tensor[V := C.Carrier, W := N.Carrier, left := C.space, right := N.space] \as Right;
\definition leftBundle: Bundle := Bundle { Carrier := Left.Carrier, space := Left.space };
\definition middleBundle: Bundle := Bundle { Carrier := Middle.Carrier, space := Middle.space };
\definition rightBundle: Bundle := Bundle { Carrier := Right.Carrier, space := Right.space };
\import \parent.RightExact[A := leftBundle, B := middleBundle, C := rightBundle] \as Result;
\import Left.Mapping[U := B.Carrier, Z := N.Carrier, targetLeft := B.space, targetRight := N.space] \as Inclusion;
\import Middle.Mapping[U := C.Carrier, Z := N.Carrier, targetLeft := C.space, targetRight := N.space] \as Projection;
\import Projection.Surjectivity[] \as Surjectivity;
\import \parent.End[V := N.Carrier, space := N.space] \as Coefficients;
\import Left.Universal[U := Right.Carrier, target := Right.space] \as Equality;
\import \parent.Hom[V := Left.Carrier, W := Right.Carrier, source := Left.space, target := Right.space] \as Composite;
\import \parent.Hom[V := Middle.Carrier, W := Right.Carrier, source := Middle.space, target := Right.space].Composition[U := Left.Carrier, domain := Left.space] \as Composition;
\module On(sequence: Exact.Sequence);
\definition existence: \forall (sequence: Exact.Sequence) -> \exists Result.Sequence :=
  \fun (sequence: Exact.Sequence) => \exact(On[sequence := sequence].sequence, Result.Sequence);
