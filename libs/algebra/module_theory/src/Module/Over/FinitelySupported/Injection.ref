\import \parent.\parent.FamilyInjection[Index := Index, family := family] \as Functions;
\import Functions.At[i := i] \as Singleton;
\definition supports: \forall (x: family.Carrier i) ->
  Supports (Lists.List[Index]::cons i Lists.List[Index]::nil) (Singleton.map.apply x) :=
  \fun (x: family.Carrier i)(j: Index)(outside: Logic.Not (\In[Index] (Enumeration.keys (Lists.List[Index]::cons i Lists.List[Index]::nil)) j)) =>
    Functions.onDifferent i j x (\fun (same: i = j) =>
      outside (Logic.Or[_, _]::left (sym!{Index} i j same)));
\definition finite: \forall (x: family.Carrier i) -> Finite (Singleton.map.apply x) :=
  \fun (x: family.Carrier i) => Logic.existsIntro[Lists.List[Index], { xs: Lists.List[Index] \where Supports xs (Singleton.map.apply x) }] (Lists.List[Index]::cons i Lists.List[Index]::nil)
    (supports x);
\import \parent.\parent.Hom[V := family.Carrier i, W := Carrier, source := family.space i, target := space] \as Maps;
\definition map: Maps.Map := Maps.Map {
  apply := \fun (x: family.Carrier i) =>
    \into[Product.Carrier](Singleton.map.apply x, submodule.carrier) \by { finite x },
  addition := \fun (x, y: family.Carrier i) => Singleton.map.addition x y,
  scalar := \fun (a: R)(x: family.Carrier i) => Singleton.map.scalar a x,
};
\definition onSame: \forall (x: family.Carrier i) -> (map.apply x) i = x := Functions.onSame i;
\definition onDifferent: \forall (x: family.Carrier i)(j: Index) -> Logic.Not (i = j) -> (map.apply x) j = (family.space j).zero :=
  \fun (x: family.Carrier i)(j: Index) => Functions.onDifferent i j x;
\definition injective: \forall (x, y: family.Carrier i) -> map.apply x = map.apply y -> x = y :=
  \fun (x, y: family.Carrier i)(same: map.apply x = map.apply y) => Singleton.injective x y same;
