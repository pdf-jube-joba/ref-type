\structure Commutative: \Prop {
  first: \forall (x: A.Carrier) -> #apply{b} (#apply{s.first} x) = #apply{t.first} (#apply{a} x),
  second: \forall (x: B.Carrier) -> #apply{c} (#apply{s.second} x) = #apply{t.second} (#apply{b} x),
  third: \forall (x: C.Carrier) -> #apply{d} (#apply{s.third} x) = #apply{t.third} (#apply{c} x),
  last: \forall (x: D.Carrier) -> #apply{e} (#apply{s.last} x) = #apply{t.last} (#apply{d} x),
}
\import \parent.\parent.Hom[V := A.Carrier, W := B.Carrier, source := A.space, target := B.space] \as SourceFirst;
\import \parent.\parent.Hom[V := B.Carrier, W := C.Carrier, source := B.space, target := C.space] \as SourceSecond;
\import \parent.\parent.Hom[V := C.Carrier, W := D.Carrier, source := C.space, target := D.space] \as SourceThird;
\import \parent.\parent.Hom[V := D.Carrier, W := E.Carrier, source := D.space, target := E.space] \as SourceLast;
\import \parent.\parent.Hom[V := A1.Carrier, W := B1.Carrier, source := A1.space, target := B1.space] \as TargetFirst;
\import \parent.\parent.Hom[V := B1.Carrier, W := C1.Carrier, source := B1.space, target := C1.space] \as TargetSecond;
\import \parent.\parent.Hom[V := C1.Carrier, W := D1.Carrier, source := C1.space, target := D1.space] \as TargetThird;
\import \parent.\parent.Hom[V := D1.Carrier, W := E1.Carrier, source := D1.space, target := E1.space] \as TargetLast;
\module Injection;
\module Surjection;
\import \parent.\parent.Isomorphism[V := C.Carrier, W := C1.Carrier, source := C.space, target := C1.space] \as Iso;
\import Iso.OfBijective[f := c] \as Inverse;
\definition isomorphism(diagram: Commutative)(aOnto: Surjective A A1 a)(bInjective: Injective B B1 b)(bOnto: Surjective B B1 b)(dInjective: Injective D D1 d)(dOnto: Surjective D D1 d)(eInjective: Injective E E1 e): Iso.Isomorphism :=
  Inverse.isomorphism (Injection[].law diagram aOnto bInjective dInjective) (Surjection[].law diagram bOnto dOnto eInjective);
