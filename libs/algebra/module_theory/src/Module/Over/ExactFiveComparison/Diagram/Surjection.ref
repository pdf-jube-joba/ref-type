\import \parent.\parent.\parent.Laws[V := C.Carrier, space := C.space] \as Middle;
\import \parent.\parent.\parent.Laws[V := C1.Carrier, space := C1.space] \as TargetMiddle;
\import \parent.\parent.\parent.Laws[V := D1.Carrier, space := D1.space] \as TargetRight;
\import algebra.Group[].Of[Carrier := C1.Carrier, group := TargetMiddle.additive] \as Group;
\import algebra.Group[].Of[Carrier := D1.Carrier, group := TargetRight.additive] \as RightGroup;
\definition remainder[z: C1.Carrier][x: C.Carrier]: C1.Carrier := Group.difference z ((c).apply x);
\definition remainderClosed: \forall (diagram: Commutative)(z: C1.Carrier)(x: C.Carrier) -> (d).apply ((s.third).apply x) = (t.third).apply z -> (t.third).apply (remainder z x) = (D1.space).zero :=
  \fun (diagram: Commutative)(z: C1.Carrier)(x: C.Carrier)(same: (d).apply ((s.third).apply x) = (t.third).apply z) => trans!{D1.Carrier} _ _ _
    (TargetThird.differencePreserved t.third z ((c).apply x))
    (trans!{D1.Carrier} _ _ _ (congr!{D1.Carrier D1.Carrier} (RightGroup.difference ((t.third).apply z)) _ _
      (trans!{D1.Carrier} _ _ _ (sym!{D1.Carrier} _ _ ((diagram).third x)) same)) (RightGroup.inverseRight ((t.third).apply z)));
\definition law: Commutative -> Surjective B B1 b -> Surjective D D1 d -> Injective E E1 e -> Surjective C C1 c := \block {
  \fun (diagram: Commutative)(bOnto: Surjective B B1 b)(dOnto: Surjective D D1 d)(eInjective: Injective E E1 e)(z: C1.Carrier) \then
  \takefrom y: \Cast[D.Carrier] ({ y: D.Carrier \where (d).apply y = (t.third).apply z }) \by dOnto ((t.third).apply z) \then
  \let dy: (d).apply y = (t.third).apply z := \bysub(D.Carrier, { y: D.Carrier \where (d).apply y = (t.third).apply z }, y) \then
  \let killed: (s.last).apply y = (E.space).zero := eInjective _ _ (trans!{E1.Carrier} _ _ _ ((diagram).last y)
    (trans!{E1.Carrier} _ _ _ (congr!{D1.Carrier E1.Carrier} ((t.last).apply) _ _ dy)
      (trans!{E1.Carrier} _ _ _ ((t).zeroD z) (sym!{E1.Carrier} _ _ (EMaps.zeroPreserved e))))) \then
  \takefrom x: \Cast[C.Carrier] ({ x: C.Carrier \where (s.third).apply x = y }) \by (s).kernelD y killed \then
  \let thirdImage: (d).apply ((s.third).apply x) = (t.third).apply z := trans!{D1.Carrier} _ _ _
    (congr!{D.Carrier D1.Carrier} ((d).apply) _ _ (\bysub(C.Carrier, { x: C.Carrier \where (s.third).apply x = y }, x))) dy \then
  \takefrom v: \Cast[B1.Carrier] ({ v: B1.Carrier \where (t.second).apply v = remainder z x }) \by (t).kernelC (remainder z x) (remainderClosed diagram z x thirdImage) \then
  \takefrom w: \Cast[B.Carrier] ({ w: B.Carrier \where (b).apply w = v }) \by bOnto v \then
  \let correction: (c).apply ((s.second).apply w) = remainder z x := trans!{C1.Carrier} _ _ _ ((diagram).second w)
    (trans!{C1.Carrier} _ _ _ (congr!{B1.Carrier C1.Carrier} ((t.second).apply) _ _ (\bysub(B.Carrier, { w: B.Carrier \where (b).apply w = v }, w)))
      (\bysub(B1.Carrier, { v: B1.Carrier \where (t.second).apply v = remainder z x }, v))) \then
  \return Logic.existsIntro[C.Carrier, { q: C.Carrier \where (c).apply q = z }] (Middle.add x ((s.second).apply w))
    (trans!{C1.Carrier} _ _ _ ((c).addition x ((s.second).apply w))
      (trans!{C1.Carrier} _ _ _ (congr!{C1.Carrier C1.Carrier} (TargetMiddle.add ((c).apply x)) _ _ correction)
        (trans!{C1.Carrier} _ _ _ (Group.comm ((c).apply x) (remainder z x)) (Group.addDifference z ((c).apply x)))))
};
