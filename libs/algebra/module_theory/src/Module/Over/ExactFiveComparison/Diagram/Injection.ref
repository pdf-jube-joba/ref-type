\definition kernelZero: Commutative -> Surjective A A1 a -> Injective B B1 b -> Injective D D1 d -> \forall (x: C.Carrier) -> #apply{c} x = #zero{C1.space} -> x = #zero{C.space} := \block {
  \fun (diagram: Commutative)(aOnto: Surjective A A1 a)(bInjective: Injective B B1 b)(dInjective: Injective D D1 d)(x: C.Carrier)(killed: #apply{c} x = #zero{C1.space}) \then
  \let dx: #apply{s.third} x = #zero{D.space} := dInjective _ _ (trans!{D1.Carrier} _ _ _ (#third{diagram} x)
    (trans!{D1.Carrier} _ _ _ (congr!{C1.Carrier D1.Carrier} (#apply{t.third}) _ _ killed)
      (trans!{D1.Carrier} _ _ _ (TargetThird.zeroPreserved t.third) (sym!{D1.Carrier} _ _ (DMaps.zeroPreserved d))))) \then
  \takefrom y: \Cast[B.Carrier] ({ y: B.Carrier \where #apply{s.second} y = x }) \by #kernelC{s} x dx \then
  \let image: #apply{s.second} y = x := \bysub(B.Carrier, { y: B.Carrier \where #apply{s.second} y = x }, y) \then
  \let byKilled: #apply{t.second} (#apply{b} y) = #zero{C1.space} := trans!{C1.Carrier} _ _ _ (sym!{C1.Carrier} _ _ (#second{diagram} y))
    (trans!{C1.Carrier} _ _ _ (congr!{C.Carrier C1.Carrier} (#apply{c}) _ _ image) killed) \then
  \takefrom z: \Cast[A1.Carrier] ({ z: A1.Carrier \where #apply{t.first} z = #apply{b} y }) \by #kernelB{t} (#apply{b} y) byKilled \then
  \takefrom w: \Cast[A.Carrier] ({ w: A.Carrier \where #apply{a} w = z }) \by aOnto z \then
  \let first: #apply{s.first} w = y := bInjective _ _ (trans!{B1.Carrier} _ _ _ (#first{diagram} w)
    (trans!{B1.Carrier} _ _ _ (congr!{A1.Carrier B1.Carrier} (#apply{t.first}) _ _ (\bysub(A.Carrier, { w: A.Carrier \where #apply{a} w = z }, w)))
      (\bysub(A1.Carrier, { z: A1.Carrier \where #apply{t.first} z = #apply{b} y }, z)))) \then
  \return trans!{C.Carrier} _ _ _ (sym!{C.Carrier} _ _ image)
    (trans!{C.Carrier} _ _ _ (congr!{B.Carrier C.Carrier} (#apply{s.second}) _ _ (sym!{B.Carrier} _ _ first)) (#zeroB{s} w))
};
\definition law: Commutative -> Surjective A A1 a -> Injective B B1 b -> Injective D D1 d -> Injective C C1 c :=
  \fun (diagram: Commutative)(aOnto: Surjective A A1 a)(bInjective: Injective B B1 b)(dInjective: Injective D D1 d) => CMaps.injectiveOfZeroKernel c (kernelZero diagram aOnto bInjective dInjective);
