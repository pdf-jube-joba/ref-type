\definition kernelZero: Commutative -> Surjective A A1 a -> Injective B B1 b -> Injective D D1 d -> \forall (x: C.Carrier) -> (c).apply x = (C1.space).zero -> x = (C.space).zero := \block {
  \fun (diagram: Commutative)(aOnto: Surjective A A1 a)(bInjective: Injective B B1 b)(dInjective: Injective D D1 d)(x: C.Carrier)(killed: (c).apply x = (C1.space).zero) \then
  \let dx: (s.third).apply x = (D.space).zero := dInjective _ _ (trans!{D1.Carrier} _ _ _ ((diagram).third x)
    (trans!{D1.Carrier} _ _ _ (congr!{C1.Carrier D1.Carrier} ((t.third).apply) _ _ killed)
      (trans!{D1.Carrier} _ _ _ (TargetThird.zeroPreserved t.third) (sym!{D1.Carrier} _ _ (DMaps.zeroPreserved d))))) \then
  \takefrom y: \Cast[B.Carrier] ({ y: B.Carrier \where (s.second).apply y = x }) \by (s).kernelC x dx \then
  \let image: (s.second).apply y = x := \bysub(B.Carrier, { y: B.Carrier \where (s.second).apply y = x }, y) \then
  \let byKilled: (t.second).apply ((b).apply y) = (C1.space).zero := trans!{C1.Carrier} _ _ _ (sym!{C1.Carrier} _ _ ((diagram).second y))
    (trans!{C1.Carrier} _ _ _ (congr!{C.Carrier C1.Carrier} ((c).apply) _ _ image) killed) \then
  \takefrom z: \Cast[A1.Carrier] ({ z: A1.Carrier \where (t.first).apply z = (b).apply y }) \by (t).kernelB ((b).apply y) byKilled \then
  \takefrom w: \Cast[A.Carrier] ({ w: A.Carrier \where (a).apply w = z }) \by aOnto z \then
  \let first: (s.first).apply w = y := bInjective _ _ (trans!{B1.Carrier} _ _ _ ((diagram).first w)
    (trans!{B1.Carrier} _ _ _ (congr!{A1.Carrier B1.Carrier} ((t.first).apply) _ _ (\bysub(A.Carrier, { w: A.Carrier \where (a).apply w = z }, w)))
      (\bysub(A1.Carrier, { z: A1.Carrier \where (t.first).apply z = (b).apply y }, z)))) \then
  \return trans!{C.Carrier} _ _ _ (sym!{C.Carrier} _ _ image)
    (trans!{C.Carrier} _ _ _ (congr!{B.Carrier C.Carrier} ((s.second).apply) _ _ (sym!{B.Carrier} _ _ first)) ((s).zeroB w))
};
\definition law: Commutative -> Surjective A A1 a -> Injective B B1 b -> Injective D D1 d -> Injective C C1 c :=
  \fun (diagram: Commutative)(aOnto: Surjective A A1 a)(bInjective: Injective B B1 b)(dInjective: Injective D D1 d) => CMaps.injectiveOfZeroKernel c (kernelZero diagram aOnto bInjective dInjective);
