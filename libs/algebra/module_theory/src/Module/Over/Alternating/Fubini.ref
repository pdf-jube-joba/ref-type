\definition law: \forall (m, n: N.Nat^)(f: Fin.Fin m -> Fin.Fin n -> V) ->
  sum m (\fun (i: Fin.Fin m) => sum n (f i)) = sum n (\fun (j: Fin.Fin n) => sum m (\fun (i: Fin.Fin m) => f i j)) :=
  \induction (m: N.Nat^) \return \forall (n: N.Nat^)(f: Fin.Fin m -> Fin.Fin n -> V) ->
    sum m (\fun (i: Fin.Fin m) => sum n (f i)) = sum n (\fun (j: Fin.Fin n) => sum m (\fun (i: Fin.Fin m) => f i j)) \with {
    | zero: \fun (n: N.Nat^)(f: Fin.Fin N.Nat^::zero -> Fin.Fin n -> V) => sym!{V} _ _ (zero n)
    | succ: \fun (m: N.Nat^)(previous: \forall (n: N.Nat^)(f: Fin.Fin m -> Fin.Fin n -> V) -> sum m (\fun (i: Fin.Fin m) => sum n (f i)) = sum n (\fun (j: Fin.Fin n) => sum m (\fun (i: Fin.Fin m) => f i j)))
        (n: N.Nat^)(f: Fin.Fin (N.Nat^::succ m) -> Fin.Fin n -> V) =>
      trans!{V} _ _ _
        (congr!{V V} (Group.difference (sum n (f (Fin.zero m)))) _ _ (previous n (\fun (i: Fin.Fin m) => f (Fin.succ m i))))
        (sym!{V} _ _ (subtraction n (f (Fin.zero m)) (\fun (j: Fin.Fin n) => sum m (\fun (i: Fin.Fin m) => f (Fin.succ m i) j))))
  };
