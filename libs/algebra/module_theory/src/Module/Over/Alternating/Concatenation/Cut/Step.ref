\import \parent.\parent.Cut[p := N.Nat^::succ p, q := q] \as Upper;
\definition tail[f: Fin.Fin Upper.total -> V][i: Fin.Fin total]: V := f (Fin.succ total i);
\definition rightTail: \forall (f: Fin.Fin Upper.total -> V) -> right (tail f) = Upper.right f :=
  \fun (f: Fin.Fin Upper.total -> V) => congruent q (\fun (i: Fin.Fin q) => tail f (back i)) (\fun (i: Fin.Fin q) => f (Upper.back i))
    (\fun (i: Fin.Fin q) => congr!{{Fin.Fin Upper.total} V} f (Fin.succ total (back i)) (Upper.back i) (sym!{N.Nat^} _ _ (Bounds.addSuccLeft p i)));
\definition law[previous: Property]: Upper.Property :=
  \fun (f: Fin.Fin Upper.total -> V) => trans!{V} _ _ _
    (congr!{V V} (Group.difference (f (Fin.zero total))) _ _ (previous (tail f)))
    (trans!{V} _ _ _ (subtractSum (f (Fin.zero total)) (left (tail f)) (twist p (right (tail f))))
      (congr!{V V} (Values.add (Group.difference (f (Fin.zero total)) (left (tail f)))) _ _
        (congr!{V V} (\fun (x: V) => Values.neg (twist p x)) _ _ (rightTail f))));
