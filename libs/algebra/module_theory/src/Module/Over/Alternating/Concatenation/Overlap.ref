\use std.Logic[].Equality[].eq_reason_in;
\import \parent.Last[n := N.Nat^::succ p] \as Last;
\definition front[a: Fin.Fin (N.Nat^::succ (N.Nat^::succ p)) -> V]: V := sum (N.Nat^::succ p) (\fun (i: Fin.Fin (N.Nat^::succ p)) => a (Fin.widen (N.Nat^::succ p) i));
\definition back[b: Fin.Fin (N.Nat^::succ (N.Nat^::succ q)) -> V]: V := sum (N.Nat^::succ q) (\fun (j: Fin.Fin (N.Nat^::succ q)) => b (Fin.succ (N.Nat^::succ q) j));
\definition law: \forall (a: Fin.Fin (N.Nat^::succ (N.Nat^::succ p)) -> V)(b: Fin.Fin (N.Nat^::succ (N.Nat^::succ q)) -> V) ->
  a Last.last = b (Fin.zero (N.Nat^::succ q)) ->
  Values.add (sum (N.Nat^::succ (N.Nat^::succ p)) a) (twist p (sum (N.Nat^::succ (N.Nat^::succ q)) b)) = Values.add (front a) (twist (N.Nat^::succ p) (back b)) :=
  \fun (a: Fin.Fin (N.Nat^::succ (N.Nat^::succ p)) -> V)(b: Fin.Fin (N.Nat^::succ (N.Nat^::succ q)) -> V)(overlap: a Last.last = b (Fin.zero (N.Nat^::succ q))) =>
    eq_reason_in!{V _
      "=" _ "by" { congr!{V V V} Values.add _ _ _ _ (Last.law a) (twistDifference p (b (Fin.zero (N.Nat^::succ q))) (back b)) }
      "=" _ "by" { congr!{V V} (\fun (x: V) => Values.add (Group.difference (front a) x) (Group.difference (twist p (b (Fin.zero (N.Nat^::succ q)))) (twist p (back b)))) _ _
          (congr!{V V} (twist p) _ _ overlap) }
      "=" _ "by" { Group.composeDifferences (front a) (twist p (b (Fin.zero (N.Nat^::succ q)))) (twist p (back b)) }
    };
