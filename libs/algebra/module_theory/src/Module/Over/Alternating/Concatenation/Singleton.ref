\definition law: \forall (f: Fin.Fin (N.Nat^::succ N.Nat^::zero) -> V) -> sum (N.Nat^::succ N.Nat^::zero) f = f (Fin.zero N.Nat^::zero) :=
  \fun (f: Fin.Fin (N.Nat^::succ N.Nat^::zero) -> V) => trans!{V} _ _ _
    (congr!{V V} (Values.add (f (Fin.zero N.Nat^::zero))) _ _ Group.negZero)
    (Group.zeroRight (f (Fin.zero N.Nat^::zero)));
