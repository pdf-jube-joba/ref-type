\import \parent.Cut[p := N.Nat^::zero, q := q] \as Cut;
\definition right: \forall (f: Fin.Fin q -> V) -> Cut.right f = sum q f :=
  \fun (f: Fin.Fin q -> V) => congruent q (\fun (i: Fin.Fin q) => f (Cut.back i)) f
    (\fun (i: Fin.Fin q) => congr!{{Fin.Fin q} V} f (Cut.back i) i (Bounds.addZeroLeft i));
\definition law: Cut.Property := \fun (f: Fin.Fin q -> V) => trans!{V} _ _ _ (sym!{V} _ _ (right f))
  (sym!{V} _ _ (Group.zeroLeft (Cut.right f)));
