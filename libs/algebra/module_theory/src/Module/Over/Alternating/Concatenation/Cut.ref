\definition total: N.Nat^ := Nat.add q p;
\definition front[i: Fin.Fin p]: Fin.Fin total := \into[N.Nat^](i, { j: N.Nat^ \where Bounds.Lt j total }) \by {
  Bounds.ltLeTrans i p total (Fin.bound p i) (Bounds.leAddLeft q p)
};
\definition back[i: Fin.Fin q]: Fin.Fin total := \into[N.Nat^](Nat.add p i, { j: N.Nat^ \where Bounds.Lt j total }) \by {
  \idelim Nat.add p q = total \with n: N.Nat^ => Bounds.Lt (Nat.add p i) n \by {
    base: Order.ltAddLeft p i q (Fin.bound q i), equality: Bounds.addComm p q
  }
};
\definition left[f: Fin.Fin total -> V]: V := sum p (\fun (i: Fin.Fin p) => f (front i));
\definition right[f: Fin.Fin total -> V]: V := sum q (\fun (i: Fin.Fin q) => f (back i));
\definition Property: \Prop := \forall (f: Fin.Fin total -> V) -> sum total f = Values.add (left f) (twist p (right f));
\module Step;
