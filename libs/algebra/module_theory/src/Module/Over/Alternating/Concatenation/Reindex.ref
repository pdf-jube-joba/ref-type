\import std.Logic[].Equality[].Transport[A := N.Nat^] \as Transport;
\import Transport.Constant[C := N.Nat^] \as Constants;
\definition indices[m, n: N.Nat^][same: m = n][i: Fin.Fin m]: Fin.Fin n := Transport.cast Fin.Fin m n same i;
\definition value: \forall (m, n: N.Nat^)(same: m = n)(i: Fin.Fin m) -> Fin.value n (indices m n same i) = Fin.value m i :=
  \fun (m, n: N.Nat^)(same: m = n)(i: Fin.Fin m) => trans!{N.Nat^} _ _ _
    (sym!{N.Nat^} _ _ (Transport.natural Fin.Fin (\fun (_: N.Nat^) => N.Nat^) (\fun (k: N.Nat^)(j: Fin.Fin k) => j) m n same i))
    (Constants.law m n i same);
\definition law: \forall (m, n: N.Nat^)(same: m = n)(f: Fin.Fin n -> V) ->
  sum m (\fun (i: Fin.Fin m) => f (indices m n same i)) = sum n f :=
  \fun (m, n: N.Nat^)(same: m = n) =>
    (\idelim m = n \with k: N.Nat^ => \forall (equal: m = k)(f: Fin.Fin k -> V) ->
      sum m (\fun (i: Fin.Fin m) => f (indices m k equal i)) = sum k f \by {
        base: \fun (equal: m = m)(f: Fin.Fin m -> V) => congruent m (\fun (i: Fin.Fin m) => f (indices m m equal i)) f
          (\fun (i: Fin.Fin m) => congr!{{Fin.Fin m} V} f _ _ (Transport.castRefl Fin.Fin m i)),
        equality: same
      }) same;
