\import \parent.Cut[p := p, q := q] \as Cut;
\import \parent.Reindex[] \as Reindex;
\definition total: N.Nat^ := Nat.add p q;
\definition same: Cut.total = total := Bounds.addComm q p;
\definition front(i: Fin.Fin p): Fin.Fin total := Reindex.indices Cut.total total same (Cut.front i);
\definition back(i: Fin.Fin q): Fin.Fin total := Reindex.indices Cut.total total same (Cut.back i);
\definition frontValue: \forall (i: Fin.Fin p) -> Fin.value total (front i) = Fin.value p i :=
  \fun (i: Fin.Fin p) => Reindex.value Cut.total total same (Cut.front i);
\definition backValue: \forall (i: Fin.Fin q) -> Fin.value total (back i) = Nat.add p (Fin.value q i) :=
  \fun (i: Fin.Fin q) => Reindex.value Cut.total total same (Cut.back i);
\definition law: \forall (f: Fin.Fin total -> V) -> sum total f =
  Values.add (sum p (\fun (i: Fin.Fin p) => f (front i))) (twist p (sum q (\fun (i: Fin.Fin q) => f (back i)))) :=
  \fun (f: Fin.Fin total -> V) => trans!{V} _ _ _ (sym!{V} _ _ (Reindex.law Cut.total total same f))
    (split p q (\fun (i: Fin.Fin Cut.total) => f (Reindex.indices Cut.total total same i)));
