\import N.Basic[].Def[] \as Nat;
\import N.Order[].Prop[] \as Order;
\definition twist: N.Nat^ -> V -> V := \induction (n: N.Nat^) \return V -> V \with {
  | zero: \fun (x: V) => x
  | succ: \fun (n: N.Nat^)(previous: V -> V)(x: V) => Values.neg (previous x)
};
\definition twistZero: \forall (n: N.Nat^) -> twist n Values.zero = Values.zero :=
  \induction (n: N.Nat^) \return twist n Values.zero = Values.zero \with {
    | zero: \refl(Values.zero)
    | succ: \fun (n: N.Nat^)(previous: twist n Values.zero = Values.zero) =>
      trans!{V} _ _ _ (congr!{V V} Values.neg _ _ previous) Group.negZero
  };
\definition twistAdd: \forall (n: N.Nat^)(x, y: V) -> twist n (Values.add x y) = Values.add (twist n x) (twist n y) :=
  \induction (n: N.Nat^) \return \forall (x, y: V) -> twist n (Values.add x y) = Values.add (twist n x) (twist n y) \with {
    | zero: \fun (x, y: V) => \refl(Values.add x y)
    | succ: \fun (n: N.Nat^)(previous: \forall (x, y: V) -> twist n (Values.add x y) = Values.add (twist n x) (twist n y))(x, y: V) =>
      trans!{V} _ _ _ (congr!{V V} Values.neg _ _ (previous x y)) (Group.negAdd (twist n x) (twist n y))
  };
\definition twistScalar: \forall (n: N.Nat^)(a: R)(x: V) -> twist n (Values.scale a x) = Values.scale a (twist n x) :=
  \induction (n: N.Nat^) \return \forall (a: R)(x: V) -> twist n (Values.scale a x) = Values.scale a (twist n x) \with {
    | zero: \fun (a: R)(x: V) => \refl(Values.scale a x)
    | succ: \fun (n: N.Nat^)(previous: \forall (a: R)(x: V) -> twist n (Values.scale a x) = Values.scale a (twist n x))(a: R)(x: V) =>
      trans!{V} _ _ _ (congr!{V V} Values.neg _ _ (previous a x)) (sym!{V} _ _ (Values.scaleNeg a (twist n x)))
  };
\definition twistDifference: \forall (n: N.Nat^)(x, y: V) -> twist n (Group.difference x y) = Group.difference (twist n x) (twist n y) :=
  \induction (n: N.Nat^) \return \forall (x, y: V) -> twist n (Group.difference x y) = Group.difference (twist n x) (twist n y) \with {
    | zero: \fun (x, y: V) => \refl(Group.difference x y)
    | succ: \fun (n: N.Nat^)(previous: _)(x, y: V) => trans!{V} _ _ _ (congr!{V V} Values.neg _ _ (previous x y))
        (Group.negAdd (twist n x) (Values.neg (twist n y)))
  };
\definition twistNeg: \forall (n: N.Nat^)(x: V) -> twist n (Values.neg x) = Values.neg (twist n x) :=
  \induction (n: N.Nat^) \return \forall (x: V) -> twist n (Values.neg x) = Values.neg (twist n x) \with {
    | zero: \fun (x: V) => \refl(Values.neg x)
    | succ: \fun (n: N.Nat^)(previous: _)(x: V) => congr!{V V} Values.neg _ _ (previous x)
  };
\definition involution: \forall (n: N.Nat^)(x: V) -> twist n (twist n x) = x :=
  \induction (n: N.Nat^) \return \forall (x: V) -> twist n (twist n x) = x \with {
    | zero: \fun (x: V) => \refl(x)
    | succ: \fun (n: N.Nat^)(previous: _)(x: V) => trans!{V} _ _ _
        (congr!{V V} Values.neg _ _ (twistNeg n (twist n x)))
        (trans!{V} _ _ _ (Group.negNeg (twist n (twist n x))) (previous x))
  };
\definition subtractSum: \forall (x, y, z: V) -> Group.difference x (Values.add y z) = Values.add (Group.difference x y) (Values.neg z) :=
  \fun (x, y, z: V) => trans!{V} _ _ _ (congr!{V V} (Values.add x) _ _ (Group.negAdd y z))
    (sym!{V} _ _ (Group.assoc x (Values.neg y) (Values.neg z)));
\module Cut(p, q: N.Nat^);
\module Zero(q: N.Nat^);
\definition split: \forall (p, q: N.Nat^) -> Cut[p := p, q := q].Property :=
  \induction (p: N.Nat^) \return \forall (q: N.Nat^) -> Cut[p := p, q := q].Property \with {
    | zero: \fun (q: N.Nat^) => Zero[q := q].law
    | succ: \fun (p: N.Nat^)(previous: _)(q: N.Nat^) => Cut[p := p, q := q].Step[].law (previous q)
  };
\module Reindex;
\module Ordered(p, q: N.Nat^);
\module Singleton;
\module Last(n: N.Nat^);
\module Overlap(p, q: N.Nat^);
\module Mapping(W: \Set, target: Space W) {
  \import \parent.\parent.\parent.Hom[V := V, W := W, source := space, target := target] \as Maps;
  \import \parent.\parent.\parent.Alternating[V := W, space := target].Concatenation[] \as Other;
  \definition law: \forall (map: Maps.Map)(n: N.Nat^)(x: V) -> (map).apply (twist n x) = Other.twist n ((map).apply x) :=
    \fun (map: Maps.Map) => \induction (n: N.Nat^) \return \forall (x: V) -> (map).apply (twist n x) = Other.twist n ((map).apply x) \with {
      | zero: \fun (x: V) => \refl((map).apply x)
      | succ: \fun (n: N.Nat^)(previous: \forall (x: V) -> (map).apply (twist n x) = Other.twist n ((map).apply x))(x: V) =>
        trans!{W} _ _ _ (Maps.negativePreserved map (twist n x)) (congr!{W W} ((target).neg) _ _ (previous x))
    };
}
\use Equality.eq_reason;
\definition cancelMiddle[n: N.Nat^][a, middle, left, right, last: V]:
  Values.add (Values.add a (twist n (Group.difference middle right)))
    (Values.add (Values.neg (twist n (Group.difference middle left))) last) =
  Values.add (Values.add a (twist n left)) (Values.add (Values.neg (twist n right)) last) :=
  eq_reason!{
    {Values.add (Values.add a (twist n (Group.difference middle right))) (Values.add (Values.neg (twist n (Group.difference middle left))) last)}
    "=" {Values.add a (Values.add (twist n (Group.difference middle right)) (Values.add (Values.neg (twist n (Group.difference middle left))) last))} "by" {
      Group.assoc a (twist n (Group.difference middle right)) (Values.add (Values.neg (twist n (Group.difference middle left))) last)}
    "=" {Values.add a (Values.add (Group.difference (twist n (Group.difference middle right)) (twist n (Group.difference middle left))) last)} "by" {
      congr!{V V} (Values.add a) _ _ (sym!{V} _ _ (Group.assoc (twist n (Group.difference middle right)) (Values.neg (twist n (Group.difference middle left))) last))}
    "=" {Values.add a (Values.add (twist n (Group.difference (Group.difference middle right) (Group.difference middle left))) last)} "by" {
      congr!{V V} (\fun (v: V) => Values.add a (Values.add v last)) _ _ (sym!{V} _ _ (twistDifference n (Group.difference middle right) (Group.difference middle left)))}
    "=" {Values.add a (Values.add (twist n (Group.difference left right)) last)} "by" {
      congr!{V V} (\fun (v: V) => Values.add a (Values.add (twist n v) last)) _ _ (Group.differenceCommonLeft middle left right)}
    "=" {Values.add a (Values.add (Group.difference (twist n left) (twist n right)) last)} "by" {
      congr!{V V} (\fun (v: V) => Values.add a (Values.add v last)) _ _ (twistDifference n left right)}
    "=" {Values.add a (Values.add (twist n left) (Values.add (Values.neg (twist n right)) last))} "by" {
      congr!{V V} (Values.add a) _ _ (Group.assoc (twist n left) (Values.neg (twist n right)) last)}
    "=" {Values.add (Values.add a (twist n left)) (Values.add (Values.neg (twist n right)) last)} "by" {
      sym!{V} _ _ (Group.assoc a (twist n left) (Values.add (Values.neg (twist n right)) last))}
  };
