\import \parent.\parent.DirectSum[Index := Index, family := family] \as Source;
\import \parent.\parent.DirectSum[Index := Index, family := targetFamily] \as Target;
\import Source.To[W := Target.Carrier, target := Target.space] \as Universal;
\definition Data: \Set := \forall (i: Index) -> \parent.\parent.Hom[V := family.Carrier i, W := targetFamily.Carrier i, source := family.space i, target := targetFamily.space i].Map;
\module Component(i: Index) {
  \import \parent.\parent.\parent.Hom[V := targetFamily.Carrier i, W := Target.Carrier, source := targetFamily.space i, target := Target.space].Composition[U := family.Carrier i, domain := family.space i] \as Compose;
  \definition map[f: Data]: Universal.At[i := i].Map := Compose.compose (Target.Injection[i := i].map) (f i);
}
\definition components[f: Data]: Universal.Components := \fun (i: Index) => Component[i := i].map f;
\definition map[f: Data]: \parent.\parent.Hom[V := Source.Carrier, W := Target.Carrier, source := Source.space, target := Target.space].Map := Universal.extension (components f);
\definition onInjection: \forall (f: Data)(i: Index)(x: family.Carrier i) -> (map f).apply ((Source.Injection[i := i].map).apply x) = (Target.Injection[i := i].map).apply ((f i).apply x) := \fun (f: Data) => Universal.onInjection (components f);
\module Coordinates(f: Data);
