\import Source.FiniteSupport[] \as SourceCoordinates;
\import Target.FiniteSupport[] \as TargetCoordinates;
\import std.Logic[].Classical[] \as Classical;
\definition sourceCoordinate[i: Index][x: Source.Carrier]: family.Carrier i := ((SourceCoordinates.forward).apply x) i;
\definition targetCoordinate[i: Index][x: Target.Carrier]: targetFamily.Carrier i := ((TargetCoordinates.forward).apply x) i;
\module At(i: Index);
\definition law: \forall (i: Index)(x: Source.Carrier) -> targetCoordinate i ((map f).apply x) = (f i).apply (sourceCoordinate i x) := \fun (i: Index) => At[i := i].law;
