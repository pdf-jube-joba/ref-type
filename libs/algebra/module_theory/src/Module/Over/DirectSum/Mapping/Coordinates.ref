\import Source.FiniteSupport[] \as SourceCoordinates;
\import Target.FiniteSupport[] \as TargetCoordinates;
\import std.Logic[].Classical[] \as Classical;
\definition sourceCoordinate(i: Index)(x: Source.Carrier): family.Carrier i := (#apply{SourceCoordinates.forward} x) i;
\definition targetCoordinate(i: Index)(x: Target.Carrier): targetFamily.Carrier i := (#apply{TargetCoordinates.forward} x) i;
\module At(i: Index);
\definition law: \forall (i: Index)(x: Source.Carrier) -> targetCoordinate i (#apply{(map f)} x) = #apply{(f i)} (sourceCoordinate i x) := \fun (i: Index) => At[i := i].law;
