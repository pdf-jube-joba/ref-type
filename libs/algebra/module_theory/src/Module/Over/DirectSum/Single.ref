\import std.Logic[].Classical[] \as Classical;
\use Logic.either;
\import \parent.FiniteSupport[] \as Coordinates;
\import Coordinates.At[i := point] \as Evaluation;
\import \parent.Injection[i := point] \as Inclusion;
\import \parent.\parent.Hom[V := Carrier, W := Carrier, source := space, target := space] \as EndMaps;
\import \parent.\parent.End[V := Carrier, space := space] \as Identity;
\import \parent.\parent.Hom[V := family.Carrier point, W := Carrier, source := family.space point, target := space].Composition[
  U := Carrier, domain := space] \as Compose;
\definition OtherTrivial: \Prop := \forall (i: Index) -> Logic.Not (i = point) ->
  \forall (x: family.Carrier i) -> x = (family.space i).zero;
\definition forward: \parent.\parent.Hom[V := Carrier, W := family.Carrier point, source := space, target := family.space point].Map := Evaluation.evaluate;
\definition backward: \parent.\parent.Hom[V := family.Carrier point, W := Carrier, source := family.space point, target := space].Map := Inclusion.map;
\definition composite: EndMaps.Map := Compose.compose backward forward;
\definition rightInverse: \forall (x: family.Carrier point) -> forward.apply (backward.apply x) = x := Coordinates.atOwn point;
\definition atPoint: \forall (x: family.Carrier point) ->
  composite.apply (backward.apply x) = backward.apply x :=
  \fun (x: family.Carrier point) => congr!{{family.Carrier point} Carrier} (backward.apply) _ _ (rightInverse x);
\module Component(i: Index) {
  \import \parent.\parent.Injection[i := i] \as Injection;
  \import \parent.\parent.\parent.Hom[V := family.Carrier i, W := Carrier, source := family.space i, target := space] \as Maps;
  \definition trivial: OtherTrivial -> Logic.Not (i = point) ->
    \forall (x: family.Carrier i) -> composite.apply (Injection.map.apply x) = Injection.map.apply x :=
    \fun (trivial: OtherTrivial)(different: Logic.Not (i = point))(x: family.Carrier i) =>
      \idelim Injection.map.apply (family.space i).zero = Injection.map.apply x
        \with y: Carrier => composite.apply y = y \by {
          base: \idelim space.zero = Injection.map.apply (family.space i).zero
            \with y: Carrier => composite.apply y = y \by {
              base: EndMaps.zeroPreserved composite,
              equality: sym!{Carrier} _ _ (Maps.zeroPreserved Injection.map)
            },
          equality: congr!{{family.Carrier i} Carrier} (Injection.map.apply) _ _
            (sym!{{family.Carrier i}} _ _ (trivial i different x))
        };
}
\definition onInjection: OtherTrivial -> \forall (i: Index)(x: family.Carrier i) ->
  composite.apply ((\parent.Injection[i := i].map).apply x) = (\parent.Injection[i := i].map).apply x :=
  \fun (trivial: OtherTrivial)(i: Index) =>
    either!{{(Classical.excludedMiddle (i = point))} {
      \forall (x: family.Carrier i) -> composite.apply ((\parent.Injection[i := i].map).apply x) = (\parent.Injection[i := i].map).apply x
    }
      {\fun (equal: i = point) => \idelim point = i \with j: Index =>
        \forall (x: family.Carrier j) -> composite.apply ((\parent.Injection[i := j].map).apply x) = (\parent.Injection[i := j].map).apply x \by {
          base: atPoint, equality: sym!{Index} _ _ equal
        }}
      {Component[i := i].trivial trivial}
    };
\import \parent.To[W := Carrier, target := space] \as Universal;
\definition equality: OtherTrivial -> composite = Identity.identity :=
  \fun (trivial: OtherTrivial) => Universal.ext composite Identity.identity (onInjection trivial);
\definition leftInverse: OtherTrivial -> \forall (x: Carrier) -> backward.apply (forward.apply x) = x :=
  \fun (trivial: OtherTrivial)(x: Carrier) => congr!{EndMaps.Map Carrier} (\fun (f: EndMaps.Map) => f.apply x) _ _ (equality trivial);
\import \parent.\parent.Isomorphism[V := Carrier, W := family.Carrier point, source := space, target := family.space point] \as Iso;
\definition isomorphism[trivial: OtherTrivial]: Iso.Isomorphism := Iso.Isomorphism {
  forward := forward, backward := backward, leftInverse := leftInverse trivial, rightInverse := rightInverse,
};
