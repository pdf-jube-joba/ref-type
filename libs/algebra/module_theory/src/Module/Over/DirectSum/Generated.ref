\import std.Set[].Quotient[A := Expressions.Expression, Equivalent := Presented.Equivalent] \as Classes;
\definition induction: \forall (P: Carrier -> \Prop) -> P space.zero ->
  (\forall (i: Index)(x: family.Carrier i) -> P ((\parent.Injection[i := i].map).apply x)) ->
  (\forall (x, y: Carrier) -> P x -> P y -> P (space.add x y)) ->
  (\forall (x: Carrier) -> P x -> P (space.neg x)) ->
  (\forall (a: R)(x: Carrier) -> P x -> P (space.smul a x)) ->
  \forall (x: Carrier) -> P x :=
  \fun (P: Carrier -> \Prop)(zero: P space.zero)
    (generator: \forall (i: Index)(x: family.Carrier i) -> P ((\parent.Injection[i := i].map).apply x))
    (addition: \forall (x, y: Carrier) -> P x -> P y -> P (space.add x y))
    (negative: \forall (x: Carrier) -> P x -> P (space.neg x))
    (scalar: \forall (a: R)(x: Carrier) -> P x -> P (space.smul a x)) =>
  Classes.induction P
    (\induction (e: Expressions.Expression) \return P (Presented.class e) \with {
      | zero: zero
      | generator: \induction (g: Generator) \return P (Presented.generator g) \with {
          | at: \fun (i: Index)(x: family.Carrier i) => generator i x
        }
      | sum: \fun (e: Expressions.Expression)(left: P (Presented.class e))
          (f: Expressions.Expression)(right: P (Presented.class f)) =>
          \idelim space.add (Presented.class e) (Presented.class f) = Presented.class (Expressions.Expression::sum e f)
            \with x: Carrier => P x \by {
              base: addition (Presented.class e) (Presented.class f) left right,
              equality: Presented.addClass e f
            }
      | negative: \fun (e: Expressions.Expression)(before: P (Presented.class e)) =>
          \idelim space.neg (Presented.class e) = Presented.class (Expressions.Expression::negative e)
            \with x: Carrier => P x \by {
              base: negative (Presented.class e) before, equality: Presented.negClass e
            }
      | scale: \fun (a: R)(e: Expressions.Expression)(before: P (Presented.class e)) =>
          \idelim space.smul a (Presented.class e) = Presented.class (Expressions.Expression::scale a e)
            \with x: Carrier => P x \by {
              base: scalar a (Presented.class e) before, equality: Presented.scaleClass a e
            }
    });
