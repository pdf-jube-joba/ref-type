\import \root.Module[].Over[R := R, ring := ring].Laws[V := L.Carrier, space := L.space] \as Recipient;
\import \root.Module[].IntegerGroup[Carrier := L.Carrier, group := Recipient.additive] \as RecipientIntegers;
\import TargetIntegers.Mapping[B := L.Carrier, other := Recipient.additive] \as Conversion;
\import algebra.Exact[A := N.Carrier, B := L.Carrier].Groups[source := Target.additive, target := Recipient.additive] \as Groups;
\import algebra.Hom[A := N.Carrier, B := L.Carrier] \as Underlying;
\definition additive: Groups.Map := \into[N.Carrier -> L.Carrier]((u).apply, Groups.Map) \by {
  Underlying.MonoidLaws[Groups.domain, Groups.codomain, (u).apply] { unit := Maps.zeroPreserved u, operation := (u).addition }
};
\definition map: Integers.Hom[V := N.Carrier, W := L.Carrier, source := TargetIntegers.space, target := RecipientIntegers.space].Map := Conversion.fromGroup additive;
