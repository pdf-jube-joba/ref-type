\import \parent.\parent.Hom[V := V, W := U, source := left, target := target] \as LeftMaps;
\import \parent.\parent.Hom[V := W, W := U, source := right, target := target] \as RightMaps;
\import \parent.\parent.Hom[V := Carrier, W := U, source := space, target := target] \as Maps;
\import \parent.\parent.Laws[V := U, space := target] \as Target;
\import algebra.Group[].Of[Carrier := U, group := Target.additive] \as Group;
\definition copair[f: LeftMaps.Map][g: RightMaps.Map]: Maps.Map := Maps.Map {
  apply := \fun (x: Carrier) => target.add (f.apply (first x)) (g.apply (second x)),
  addition := \fun (x, y: Carrier) => trans!{U} _ _ _
    (congr2!{U U U} (target.add) _ _ _ _ (f.addition (first x) (first y)) (g.addition (second x) (second y)))
    (Group.four (f.apply (first x)) (f.apply (first y)) (g.apply (second x)) (g.apply (second y))),
  scalar := \fun (a: R)(x: Carrier) => trans!{U} _ _ _
    (congr2!{U U U} (target.add) _ _ _ _ (f.scalar a (first x)) (g.scalar a (second x)))
    (sym!{U} _ _ (target.vectorAdd a (f.apply (first x)) (g.apply (second x)))),
};
\definition onLeft: \forall (f: LeftMaps.Map)(g: RightMaps.Map)(x: V) -> (copair f g).apply (firstInjection.apply x) = f.apply x :=
  \fun (f: LeftMaps.Map)(g: RightMaps.Map)(x: V) => trans!{U} _ _ _
    (congr!{U U} (target.add (f.apply x)) _ _ (RightMaps.zeroPreserved g)) (Group.zeroRight (f.apply x));
\definition onRight: \forall (f: LeftMaps.Map)(g: RightMaps.Map)(x: W) -> (copair f g).apply (secondInjection.apply x) = g.apply x :=
  \fun (f: LeftMaps.Map)(g: RightMaps.Map)(x: W) => trans!{U} _ _ _
    (congr!{U U} (\fun (a: U) => target.add a (g.apply x)) _ _ (LeftMaps.zeroPreserved f)) (Group.zeroLeft (g.apply x));
\definition unique: \forall (f: LeftMaps.Map)(g: RightMaps.Map)(h: Maps.Map) ->
  (\forall (x: V) -> h.apply (firstInjection.apply x) = f.apply x) ->
  (\forall (x: W) -> h.apply (secondInjection.apply x) = g.apply x) -> h = copair f g :=
  \fun (f: LeftMaps.Map)(g: RightMaps.Map)(h: Maps.Map)(onLeft: _)(onRight: _) => Maps.ext h (copair f g)
    (\fun (x: Carrier) => trans!{U} _ _ _
      (congr!{Carrier U} (h.apply) _ _ (sym!{Carrier} _ _ (reconstruction x)))
      (trans!{U} _ _ _ (h.addition (firstInjection.apply (first x)) (secondInjection.apply (second x)))
        (congr2!{U U U} (target.add) _ _ _ _ (onLeft (first x)) (onRight (second x)))));
